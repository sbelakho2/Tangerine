# Tangerine Compiler — Type System
# Self-hosting compiler written in Tangerine
#
# Complete type system with:
# - Type inference (Hindley-Milner style)
# - Generic types with bounds
# - Effect types

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use std::fs::{read_file}
use tg_compiler::token::{Span, span_dummy, ParsedIntegerLiteral, ParsedFloatLiteral, parsed_int_to_host, parsed_int_fits_host, parsed_int_decimal, parsed_int_is_zero, parsed_float_finite, parsed_float_f32_overflow, parsed_float_f64_overflow}
use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::resolver::{ResolvedNames, def_id_of_item, def_kind_of, module_qualified_key, lookup_module_callable}
use tg_compiler::ids::{
  DefId, DefKind, FieldId, ModuleId, TypeId, TraitId, GenericParamId, GenericParamTable,
  CallableId, InstanceId, VariantId, LocalId, AccessRoot, ClosureId, EffectId, EffectRegistry,
  IntrinsicId, FinalizerKind,
  generic_param_table_new, generic_param_id_numeric, generic_param_id_eq,
  fresh_synthetic_owner, intern_generic_param, generic_param_name_of,
  generic_param_name_from, def_id_numeric,
  effect_registry_new, intern_module_effect, effect_id_of_name,
  effect_id_eq, effect_name_of_id, effect_vec_eq,
  EFFECT_IO, EFFECT_FILE, EFFECT_ASYNC,
  intrinsic_id_numeric,
  SYNTHETIC_MODULE_ITEM_FALLBACK, SYNTHETIC_MODULE_IMPL_METHOD_FALLBACK
}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, StructDecl, EnumDecl, TraitDecl, ImplDecl,
  UseDecl, AstPath, ExternItem, NominalKind, AccessConvention,
  TypeExpr, TypeExprKind, Param, GenericParam,
  Block, Stmt, StmtKind, Expr, ExprKind, Pattern, PatternKind,
  BudgetAnnotation, BudgetConstraint, LayoutAttrs, layout_attrs_plain
}
# (ONE AnalyzedProgram): the ONE TypedCFG the pipeline builds
# (compiler_core's analyze_parsed — build_typed_cfg ONCE) is passed through
# access checking and resource checking and carried in the AnalyzedProgram
# artifact (resource_check.tg), NOT on the TypedProgram — the MIR's cleanup
# generation consumes the same instance through that artifact, and the
# analysis results (the CFG with its CleanupEdge table, the finalize plan,
# the iteration plans, the block frames, the slice-view registry, the
# access registry, the engine snapshot) live beside the typed HIR there.
use tg_compiler::resource_check::{AnalyzedProgram, TypedCFG, analysis_context_new, engine_snapshot_env}

# ———————————————————————————————————————————————————————————————
# Type Representation
# ———————————————————————————————————————————————————————————————

enum Type
  # Primitive types
  Unit
  Bool
  Int
  UInt
  Float
  Char
  # The OWNED String: the value is ONE pointer to the 32-byte String object
  # header {data,len,cap,stride} (see std/core.tg and runtime.tg "String
  # Object Runtime"). Every String-typed slot holds the object handle.
  String
 # (the typed literal/view split): the MIR-INTERNAL static
  # StaticStrPtr type — the TRUE type of a string LITERAL constant (the
  # interned static byte label behind a raw pointer; never an owned String
  # object). The checker's semantic type of a literal remains String; the
  # MIR constant carries StaticStrPtr so the raw static pointer is never
  # typed as the owned-object handle. Conversion to the owned String is
  # the explicit string_from_static coercion, emitted at every place a
  # String is promised (aggregate fields, by-value String params, String
  # destinations). StaticStrPtr is an 8-byte scalar (a raw pointer to the
  # NUL-terminated static bytes — the same value the str ABI crosses),
  # bit-copyable, owns nothing, drops nothing. It is MIR/type-universe
  # internal: the checker never produces it and it never appears in a
  # public ABI signature. (RENAMED from the former internal StrView
  # variant — the new name states the 8-byte raw-pointer representation and
  # cannot be confused with the PUBLIC std StrView, the SAFE shared/pinned
  # view: the 8-byte Arc-class handle { inner: ArcStrong[StrViewBacking] } —
  # one name, one layout.)
  StaticStrPtr
  Never
  
  # Sized integer types for FFI parity
  I8
  I16
  I32
  I64
    I128
  U8
  U16
  U32
  U64
    U128
    ISize
    USize
  F32
  F64
  
 # (integer-literal coercion, inference-only): the type an INTEGER
  # LITERAL EXPRESSION produces — the literal's VALUE (the representable
  # range of the literal is [value, value]; the value is carried so a
  # future range diagnostic can reject an out-of-range literal). It is
  # COERCIBLE to any concrete integer type (the unifier's coercion rule)
  # and is ELIMINATED after coercion: the unification binds the literal to
  # the concrete integer type, and the end-of-check resolution
  # (resolve_pending_int_literals) defaults every literal the context
  # never constrained to Type::Int — the resolved type NEVER remains
  # IntLiteral in a codegenable TypedProgram. The ordinary Type::Int is
  # EXACT — never coercible to u8/i32/etc.; only this inference-only form
  # coerces.
  IntLiteral(Int)
  
  # The nominal Adt form: the resolved TypeId of the type definition plus
  # its concrete type arguments (the FINAL Type representation — the dual
  # canonical variants are is not part of the model; the LangItems ids select the builtin
  # compound behaviors: option/result/vec/map/set/box_/rc/array/slice).
  # The named Array[T] syntax (the heap vector) is this Adt form; the
  # [T; N] annotation is the distinct FixedArray variant below.
  Adt(TypeId, Vec[Type])
  
  # Fixed inline array: the element type plus the constant count (the
  # reviewer's FixedArray[T, N]). The count is carried IN THE TYPE — the
  # [T; N] annotation constructs this variant (never the Adt); the count 0
  # is a legal zero-length fixed array, distinct from the heap-vector
  # Array[T] Adt.
  FixedArray(Type, Int)
  
 # (FnPtr/Closure split): a FUNCTION POINTER — the signature (the
  # parameter list with access conventions, the return type), the
  # EFFECT SET (Vec[EffectId]) and NO environment. Layout: a single code
  # pointer (fn_ptr_size). Bit-copyable, Transferable/Shareable per the
  # decided pointer policy. The effect set is the callable's declared/
  # computed effects — the checker's indirect-call recording reads it from
  # the callee's TYPE (a closure value, a function-pointer field, a
  # computed callee) so an indirect call is never effect-unknown/effect-
  # free; the direct-call seeds flow into the fn-item values at pass 3.
  FnPtr(Vec[ParamType], Type, Vec[EffectId])

 # (FnPtr/Closure split): a CLOSURE VALUE — the closure's identity
  # (ClosureId), its signature (params + return), the CAPTURE TUPLE
  # type (Type::Tuple of the captured locals' types, in local-id order)
  # and the EFFECT SET (Vec[EffectId] — the closure body's effectful
  # calls, accumulated at the closure's type-construction site). The
  # closure object's layout/ABI derives from the captures (the aggregate
  # of the capture tuple plus the code pointer); the closure's
  # TypeProperties (owns_state / requires_drop_glue / linearity) derive
  # from the capture tuple — a closure capturing an owning value owns it.
  # The closure dispatch through the MIR closure aggregate keys on this
  # form (the checker types closure EXPRESSIONS as this variant).
  Closure(ClosureId, Vec[ParamType], Type, Type, Vec[EffectId])
  
  # Internal reference (MIR-only: parameter re-wrap and MirRef typing)
  RefInternal(Type, Bool)
  
  # Raw pointer types (Box/Rc are Adt forms of the registered Box/Rc ids)
  Ptr(Type)     # Raw pointer *T
  PtrMut(Type)  # Mutable raw pointer *mut T
  
  # Trait object types
  Dyn(TypeId)   # Dynamic trait object dyn Trait
  
 # Effect types. (EffectId domain): the effect set is the canonical
  # ordered Vec[EffectId] — every effect name the checker's effect-type
  # expressions use is INTERNED through the registry (intern_module_effect
  # / effect_id_of_name) at construction, so the canonical type identity
  # renders the canonical ordered effect-ID set and unification compares
  # ids (identity is the id, never the name). The registry's id -> name
  # table renders the names for diagnostics and the ABI.
  Effect(Vec[EffectId], Type)  # Effect type: effect[Io, Net] T
  
  # Tuple
  Tuple(Vec[Type])
  
  # Type variables (for inference)
  Var(TypeVarId)
  
  # Generic parameter: the GenericParamId identity from the central ID
  # universe (ids.tg). The id's index IS the parameter's declaration order
  # within its owner (the interning table — the param-name table keyed by
  # GenericParamId — stores the NAME separately for diagnostics; identity
  # is the id, never the name). Substitution matches by id; equality is id
  # equality.
  Param(GenericParamId)
  
  # Error type (for error recovery)
  Error
end

struct ParamType
  ty: Type
  convention: AccessConvention
end

# The typed signature record of a function/method/extern declaration — the
# checker's resolved parameter types (ParamType — the base type plus the
# convention; the MIR applies its own Ref/Inout RefInternal wrapping) and
# the resolved return type. Recorded at the checker's signature-computation
# sites (check_function, check_impl's signature pass, pass-3 externs) under
# the fn owner key and serialized into TypedProgram.typed_fn_signatures; the
# MIR reads declaration types from this table — never from TypeExpr again.
# The record ALSO carries the DECLARED EFFECT SET (the parsed
# `effect[...]`-style annotation names interned through the EffectRegistry —
# the EffectIds, or the std effectful-function seeds) and the DECLARED
# BUDGET (the @budget annotation's limit — the typed record) so the
# effect/budget semantics survive checking into the MIR.
struct FnSignature
  params: Vec[ParamType]
  ret_type: Type
  declared_effects: Vec[EffectId] = Vec::new()
  declared_budget: Option[TypedBudget] = Option::None
end

# The TYPED budget record of a function/method declaration — the
# @budget annotation's parsed constraints (metric + limit pairs, spans
# stripped): the BudgetAnnotation's limit in the typed domain. Carried on
# the typed FnSignature for the runtime enforcement consumers.
struct TypedBudget
  constraints: Vec[TypedBudgetConstraint]
end

struct TypedBudgetConstraint
  metric: String
  limit: String
end

# Plain type name of a TypeExpr, mirroring mir.tg's impl_type_name
# computation (Array is aliased to Vec) so deinit mangling matches MIR.
def type_expr_name_of(ty: TypeExpr) -> String
  let raw = match ty.kind
  when TypeExprKind::Named(name, _) then name.clone()
  when TypeExprKind::Path(path) then path.segments.join("::")
  when _ then ""
  end
  if raw == "Array" then "Vec".to_string() else raw end
end

# Render a DefId into a canonical String key for binding/finalize maps.
# The module path (recovered from the typed program's crate — never from
# the DefId, which carries a ModuleId into Program.crate) makes the key
# unique across ALL files merged into one compilation (two functions at
# the same byte offset in different files produce different keys — unlike
# span.start-based keys). The DefKind is metadata (the resolver's
# def_kinds snapshot — see def_kind_of / def_id_kind_of), not a DefId
# field.
pub def fn_owner_key(module: String, index: UInt, kind: DefKind) -> String
  let kind_name = match kind
  when DefKind::Function then "fn"
  when DefKind::Method then "method"
  when DefKind::Static then "static"
  when DefKind::Constant then "const"
  when DefKind::EnumVariant then "variant"
  when DefKind::StructField then "field"
  when DefKind::Intrinsic then "intrinsic"
  when DefKind::TypeName then "type"
  when DefKind::Trait then "trait"
  when DefKind::Other then "other"
  end
  module + "::" + index.to_string() + "::" + kind_name
end

# (module graph consumption): the ONE shared module lookup — a direct
# table read of Program.crate.modules by the ModuleId KEY (Crate.modules is
# Map[ModuleId, Module]; the table IS the authority — no containment scan
# ever re-derives a module by scanning entries). The strict/recovery SPLIT:
#   - crate_module_of / crate_module_path_of  — STRICT (the compile path:
#     codegen, MIR, mono, the checker). A ModuleId that is not a key of
#     Crate.modules is an internal compiler error (ICE) — a codegenable
#     compilation must never silently fall back to the root module or an
#     empty path, which would corrupt owner-key identity.
#   - crate_module_of_recovery / crate_module_path_recovery — RECOVERY (the
#     IDE/LSP/analyze-only path): Option/empty-path answers for a module the
#     table never recorded.
# The root module (id 0 — the crate's fallback when no Module covers an
# item) legitimately exists as a KEY of Crate.modules and yields its own
# path (empty for the crate root); a MISSING key is the error case.
pub def crate_module_of(program: Program, mid: ModuleId) -> Module
  match program.crate.modules.get(mid.clone())
  when Option::Some(m) then m.clone()
  when Option::None then
    panic("internal error: ModuleId " + mid.id.to_string() + " is not a key of Crate.modules (module-graph identity lost — the compile path must never fall back to the root/empty module)")
  end  end  end
end

# RECOVERY variant (the IDE/LSP/analyze-only path): Option::None for a
# ModuleId the crate table never recorded — recovery fallbacks live ONLY
# here, never in the compile path.
pub def crate_module_of_recovery(program: Program, mid: ModuleId) -> Option[Module]
  match program.crate.modules.get(mid.clone())
  when Option::Some(m) then Option::Some(m.clone())
  when Option::None then Option::None
  end  end
end

# The owner module path of a ModuleId — STRICT (the compile path): the
# O(1) table read through crate_module_of; a missing module is an ICE, it
# never degenerates to the root-module empty path.
pub def crate_module_path_of(program: Program, mid: ModuleId) -> Vec[String]
  let m = crate_module_of(program, mid)
  var owner_path = Vec::new()
  for seg in m.path do
    owner_path.push(seg.clone())
  end
  owner_path
end

# RECOVERY variant of crate_module_path_of (the IDE/LSP/analyze-only path):
# the empty path for a module the crate never recorded.
pub def crate_module_path_recovery(program: Program, mid: ModuleId) -> Vec[String]
  match crate_module_of_recovery(program, mid)
  when Option::Some(m) then
    var owner_path = Vec::new()
    for seg in m.path do
      owner_path.push(seg.clone())
    end
    owner_path
  when Option::None then Vec::new()
  end  end
end

# The DefKind of a resolver-produced DefId, from the ResolvedNames def_kinds
# metadata snapshot (def_kind_of — the kind is METADATA, never a DefId
# field). STRICT (the compile path): a DefId the snapshot never recorded is
# an internal compiler error — DefKind::Other is a degradation that would
# silently re-key the owner identity. The RECOVERY variant
# (def_id_kind_of_recovery — the IDE/LSP/analyze-only path) keeps the
# DefKind::Other answer.
pub def def_id_kind_of(res: ResolvedNames, did: DefId) -> DefKind
  match def_kind_of(res, did)
  when Option::Some(k) then k
  when Option::None then
    panic("internal error: DefId " + def_id_numeric(did).to_string() + " has no def-kind metadata in the resolver snapshot (owner identity lost — the compile path never degrades to DefKind::Other)")
  end  end
end

pub def def_id_kind_of_recovery(res: ResolvedNames, did: DefId) -> DefKind
  match def_kind_of(res, did)
  when Option::Some(k) then k
  when Option::None then DefKind::Other
  end  end
end

# render a DefId as its fn_owner_key — "<module path>::<index>::
# <kind>" — with the module path from the ONE shared O(1) table lookup
# (crate_module_path_of — the Crate.modules[ModuleId] authority) and the
# kind from the resolver's def_kinds
# metadata (def_id_kind_of — STRICT: a missing kind is an internal
# error, never a DefKind::Other degradation). DefId carries neither:
# module is a ModuleId
# into Program.crate and the kind is metadata.
pub def fn_owner_key_of_def(program: Program, res: ResolvedNames, did: DefId) -> String
  let module_path = crate_module_path_of(program, &did.module)
  fn_owner_key(module_path.join("::"), did.index, def_id_kind_of(res, did))
end

# the module-path-qualified name-based owner key — the SHARED no-DefId
# fallback ("module::<full path>::<name>"), used by fn_owner_key_of_item
# below and by check_item's free-function arm, so the type checker's
# parameter-binding key and the resource checker's finalize-plan key agree
# even when no DefId was recorded. Unique per module-qualified function
# because the path is the item's FULL owner module path (threaded from
# Program.crate for top-level items and appended level-by-level for
# genuinely nested modules); a DefId-derived key can never collide with it —
# DefId keys render "<module path>::<index>::<kind>", so the "module::"
# prefix is unreachable from fn_owner_key.
def module_qualified_fn_key(module_path: Vec[String], name: String) -> String
  var mod_key = "module::"
  for seg in module_path do
    mod_key = mod_key + seg + "::"
  end
  mod_key + name
end

# ———————————————————————————————————————————————————————————————
# the declared-effect domain — the effect discipline's keying, seeds,
# and set operations (the typed effect/budget representation)
# ———————————————————————————————————————————————————————————————
# The effect-tracking identity key of a function/method declaration — the
# DefId render "def::<module id>::<index>::<kind>" (fn_owner_key's shape
# with the MODULE ID in place of the module path). Registration
# (check_function / check_impl's signature pass) and the call-site lookups
# derive the SAME key from the SAME DefId — the call sites have no Program
# access, so the module-path render (fn_owner_key_of_def) is unreachable
# there. The synthetic fallback owners (module -2/-3 bands) carry no
# def-kind metadata, so the RECOVERY kind (DefKind::Other) renders them —
# identity is the (module id, index) pair, never the kind label.
def fn_effect_def_key(env: TypeEnv, did: DefId) -> String
  let kind = match env.resolutions
  when Option::Some(res) then def_id_kind_of_recovery(res, did)
  when Option::None then DefKind::Other
  end
  fn_owner_key("def::" + did.module.id.to_string(), did.index, kind)
end

# The MODULE-QUALIFIED identity of a declaration ("std::io::println",
# "std::fs::open", "std::core::panic" — the module path joined with the
# name; a root-module declaration is the bare name). This is the SEED
# identity the std effectful-function table keys on — the semantic
# identity (the module path + the name the resolver would resolve), never
# the bare name: a user function named `print` in a user module is never
# seeded, and two same-named std functions in different std modules
# (std::io::read vs std::fs::read) seed differently.
def module_qualified_effect_name(module_path: Vec[String], name: String) -> String
  if module_path.len() > 0 then
    module_path.join("::") + "::" + name
  else
    name
  end
end

# The declared-effect seeding table for the KNOWN effectful standard
# functions — the std's declared effects, the seeds the transitive
# checking propagates. The std library's effectful operations declare
# their effects HERE — the source-text analyzer in std::effects is
# tooling; the semantic seeds live in the checker (the fixed-id builtin
# band from ids.tg: Io / File / Async). The key is the MODULE-QUALIFIED
# identity (module_qualified_effect_name — the module path + the name),
# not the bare name, so the seed fires only for the exact std identity:
#   Io   (EFFECT_IO):   std::io::print / println / eprint / eprintln /
#                       read_line / read; std::core::panic
#   File (EFFECT_FILE): std::fs::open / read / write / write_all
#   Async(EFFECT_ASYNC):std::async::spawn / sleep; std::exec::spawn / sleep
# The panic category: the current effect universe (the builtin band
# Io/Network/File/Async/Timer) has NO Exception effect, so the pragmatic
# choice keeps panic under Io (a program that can panic is not pure) —
# the semantic IDENTITY fix (the qualified key) is the core of this
# change; the category follows the language's declared effect universe.
# Gated to the std module by the caller (declared_effects_of — a user
# function named `print` is never seeded).
def std_effectful_fn_seed(reg: EffectRegistry, qualified_name: String) -> Vec[EffectId]
  var out = Vec::new()
  if qualified_name == "std::io::print" || qualified_name == "std::io::println" ||
     qualified_name == "std::io::eprint" || qualified_name == "std::io::eprintln" ||
     qualified_name == "std::io::read_line" || qualified_name == "std::io::read" ||
     qualified_name == "std::core::panic" then
    out.push(EffectId { id: EFFECT_IO })
  elsif qualified_name == "std::fs::write" || qualified_name == "std::fs::write_all" ||
        qualified_name == "std::fs::open" || qualified_name == "std::fs::read" then
    out.push(EffectId { id: EFFECT_FILE })
  elsif qualified_name == "std::async::spawn" || qualified_name == "std::async::sleep" ||
        qualified_name == "std::exec::spawn" || qualified_name == "std::exec::sleep" then
    out.push(EffectId { id: EFFECT_ASYNC })
  end
  out
end

# The declared effect set of a function/method declaration: the parsed
# `effect[...]` annotation names interned through the registry
# (module-qualified — two same-named effects in different modules are
# distinct EffectIds), falling back to the std effectful-function seeds
# when the declaration carries no annotation (the io/print/read/write/
# panic/await-effectful std functions — the transitive checking's seeds).
# The seed fallback keys on the declaration's MODULE-QUALIFIED identity
# (the module path + the name — the semantic DefId-adjacent identity the
# resolver's qualified names render), never the bare name.
# inout: the interning persists into the caller's registry (the interned
# id is the canonical identity).
def declared_effects_of(inout env: TypeEnv, f_effects: Vec[String], qualified_name: String) -> Vec[EffectId]
  var out = Vec::new()
  if f_effects.len() > 0 then
    for e_name in f_effects do
      out.push(intern_module_effect(&mut env.effects, &env.current_module_path, &e_name))
    end
  else
    let in_std = env.current_module_path.len() > 0 && env.current_module_path[0] == "std"
    if in_std then
      out = std_effectful_fn_seed(&env.effects, &qualified_name)
    end
  end
  out
end

# The typed budget record of a declaration's @budget annotation — the
# BudgetAnnotation's parsed limits (metric + bound pairs, spans stripped)
# — the typed record the runtime enforcement consumes.
def typed_budget_of(b: Option[BudgetAnnotation]) -> Option[TypedBudget]
  match b
  when Option::Some(ba) then
    var cons = Vec::new()
    for c in ba.constraints do
      cons.push(TypedBudgetConstraint { metric: c.metric.clone(), limit: c.bound.clone() })
    end
    Option::Some(TypedBudget { constraints: cons })
  when Option::None then Option::None
  end  end
end

# ———————————————————————————————————————————————————————————————
# Budget ENFORCEMENT domain (the typed budget records' consumer side)
# ———————————————————————————————————————————————————————————————
# The parser declares ARBITRARY metric identifiers (`@budget <metric>:
# "<bound>"` — see parse_budget_annotation); the std/budget.tg surface
# enumerates time / memory / iterations / calls / allocations / custom.
# The RUNTIME ENFORCEMENT covers two metrics, keyed by the canonical
# resource:
#   alloc | allocation | allocations  -> "alloc"  (the COUNT-based metric:
#                                     each intrinsic allocation in the
#                                     annotated function consumes one unit;
#                                     the counter is compared against the
#                                     declared limit at every consume)
#   time                            -> "time"   (the ELAPSED-based metric:
#                                     the entry stamp + the exit check
#                                     against the declared limit)
# Every other metric (memory, iterations, calls, custom names) parses and
# rides the typed record but emits NO checks — reported as unenforced.
def budget_metric_resource(metric: String) -> String
  if metric == "alloc" || metric == "allocation" || metric == "allocations" then
    "alloc"
  elsif metric == "time" then
    "time"
  else
    metric
  end
end

def budget_metric_enforced(metric: String) -> Bool
  let res = budget_metric_resource(metric)
  res == "alloc" || res == "time"
end

# The leading integer of a budget bound ("8" -> 8, "100ms" -> 100, "5ms"
# -> 5); a bound with no leading digits is 0 (fail closed — the first
# consume exceeds a zero limit).
def budget_bound_value(bound: String) -> Int
  var acc = 0
  var started = false
  for c in bound.chars() do
    if c.is_digit() then
      acc = acc * 10 + (c as Int - '0' as Int)
      started = true
    elsif started then break
    end
  end
  if started then acc else 0 end
end

# The time metric's limit in NANOSECONDS: the bound's numeric value scaled
# by its unit suffix ("5ms" -> 5,000,000; "500us" -> 500,000; "1s" ->
# 1,000,000,000; a bare "100" is raw nanoseconds).
def budget_time_limit_ns(bound: String) -> Int
  let value = budget_bound_value(bound)
  if bound.contains("ms") then value * 1000000
  elsif bound.contains("us") then value * 1000
  elsif bound.contains("s") then value * 1000000000
  else value
  end
end

# The declared limit of a typed budget record for an enforced resource key
# (the first matching constraint wins; the time metric scales its bound to
# nanoseconds, the allocation metric counts raw units).
def typed_budget_limit(tb: TypedBudget, resource: String) -> Int
  for c in tb.constraints do
    if budget_metric_resource(&c.metric) == resource then
      if resource == "time" then
        return budget_time_limit_ns(&c.limit)
      end
      return budget_bound_value(&c.limit)
    end
  end
  0
end

# Whether an intrinsic-classified call ALLOCATES heap storage (the
# allocation metric's consume sites): the direct allocators (mem_alloc,
# the container/news, resize/reserve) and the growth/clone ops whose
# runtime paths reach the real heap allocator (_tg_mem_alloc).
pub def intrinsic_allocates(iid: IntrinsicId) -> Bool
  match iid
  when IntrinsicId::MemAlloc then true
  when IntrinsicId::ArrayNew | IntrinsicId::ArrayWithCapacity | IntrinsicId::ArrayResize | IntrinsicId::ArrayPush | IntrinsicId::ArrayInsert | IntrinsicId::ArrayExtend | IntrinsicId::ArrayFromList | IntrinsicId::ArraySlice then true
  when IntrinsicId::MapNew | IntrinsicId::MapInsert | IntrinsicId::MapClone then true
  when IntrinsicId::SetNew | IntrinsicId::SetInsert | IntrinsicId::SetClone then true
  when IntrinsicId::StringNew | IntrinsicId::StringReserve | IntrinsicId::StringPush | IntrinsicId::StringPushStr | IntrinsicId::StringClone | IntrinsicId::StringFromStatic | IntrinsicId::StrConcat | IntrinsicId::StrCopy | IntrinsicId::Clone then true
  when _ then false
  end  end
end

# Effect-set containment (identity is the id — effect_id_eq).
def effect_set_contains(effs: Vec[EffectId], e: EffectId) -> Bool
  var i = 0
  while i < effs.len() do
    if effect_id_eq(&effs[i], &e) then return true end
    i = i + 1
  end
  false
end

# Append every effect of `extra` missing from `effs`; true when the set
# grew (the transitive closure's fixpoint signal).
def effect_set_append(inout effs: Vec[EffectId], extra: Vec[EffectId]) -> Bool
  var changed = false
  for e in extra do
    if !effect_set_contains(&effs, &e) then
      effs.push(e.clone())
      changed = true
    end
  end
  changed
end

# The effect name for diagnostics (the registry's id -> name table; the
# fallback render for an id the registry never interned).
def effect_display_name(env: TypeEnv, e: EffectId) -> String
  match effect_name_of_id(&env.effects, &e)
  when Option::Some(n) then n.clone()
  when Option::None then "e" + e.id.to_string()
  end  end
end

# The typed effect declaration of a source effect NAME — the resolution the
# perform surface and the handle/with blocks use: the name resolves through
# the current module first ("path::name"), then the bare/root key ("name"),
# then the fully-qualified key (the key domain the EffectRegistry interns).
# Option::None for a name never declared (the caller reports the unknown
# effect). The declared effect's typed op table is the authority the
# operation-call surface is checked against.
def typed_effect_of_name(env: TypeEnv, name: String) -> Option[TypedEffectDecl]
  var candidates = Vec::new()
  if !env.current_module_path.is_empty() then
    candidates.push(env.current_module_path.join("::") + "::" + name.clone())
  end
  candidates.push(name.clone())
  var ci = 0
  while ci < candidates.len() do
    match env.effect_name_index.get(candidates[ci].clone())
    when Option::Some(eid) then
      match env.typed_effects.get(eid)
      when Option::Some(decl) then return Option::Some(decl.clone())
      when Option::None then ()
      end
    when Option::None then ()
    end
    ci = ci + 1
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# The operation-call surface — std::effects::perform(EFFECT.op, ...)
# ———————————————————————————————————————————————————————————————
# The perform function is the checker-recognized operation-call surface:
# the callee path "std::effects::perform" (the std/effects.tg declaration
# is the resolution seed; its declared generic signature is never used for
# call typing). The FIRST argument is the operation REFERENCE — a
# `EFFECT.op` path whose effect resolves to the declared effect's semantic
# EffectId and whose op name resolves into the typed op table (the
# declaration-order index — the dispatch identity the MIR statement and
# the runtime handler-frame bitmap carry). The remaining arguments are the
# operation's payload, checked against the op signature's parameter types;
# the call's type is the op's return type. The performed effect accumulates
# into the enclosing function's COMPUTED effect set (the transitive
# discipline: a function that performs an effect it does not declare is a
# violation, exactly like an effectful call).
#
# The bounded row's Copy gate: an effect operation's parameters and return
# type must be Copy (is_trivially_copyable) — resource ownership never
# crosses the perform boundary (the payload is a plain value tuple moved
# through the runtime's untyped frame).

def effect_perform_callee_path(func: Expr) -> Bool
  match func.kind
  when ExprKind::ExprPath(p) then
    p.segments.len() == 3 && p.segments[0] == "std" && p.segments[1] == "effects" && p.segments[2] == "perform"
  when ExprKind::ExprEnumVariant(p, _) then
    # The 3-segment module-qualified call path parses as ExprEnumVariant
    # ("std::effects::perform(...)") — the checker recognizes the SAME
    # surface shape in both the ExprCall and ExprEnumVariant arms.
    p.segments.len() == 3 && p.segments[0] == "std" && p.segments[1] == "effects" && p.segments[2] == "perform"
  when _ then false
  end  end
end

# The operation reference of an expression: the (effect name, op name) of
# the `EFFECT.op` path form (also the `EFFECT.op` field-access spelling).
def effect_op_reference_of(expr: Expr) -> Option[(String, String)]
  match expr.kind
  when ExprKind::ExprPath(p) then
    if p.segments.len() >= 2 then
      Option::Some((p.segments[p.segments.len() - 2].clone(), p.segments[p.segments.len() - 1].clone()))
    else
      Option::None
    end
  when ExprKind::ExprFieldAccess(base, field) then
    match base.kind
    when ExprKind::ExprIdent(eff_name) then Option::Some((eff_name.clone(), field.clone()))
    when _ then Option::None
    end
  when _ then Option::None
  end  end
end

# The typed effect declaration of an operation-reference path — the
# qualified prefix (a path `mod::EFFECT.op` resolves the effect under its
# module-qualified key first), then the current-module/bare resolution.
def typed_effect_of_op_reference(env: TypeEnv, expr: Expr, eff_name: String) -> Option[TypedEffectDecl]
  match expr.kind
  when ExprKind::ExprPath(p) then
    if p.segments.len() > 2 then
      var prefix = Vec::new()
      var si = 0
      while si < p.segments.len() - 2 do
        prefix.push(p.segments[si].clone())
        si = si + 1
      end
      let qkey = prefix.join("::") + "::" + eff_name.clone()
      match env.effect_name_index.get(qkey.clone())
      when Option::Some(eid) then
        match env.typed_effects.get(eid)
        when Option::Some(decl) then return Option::Some(decl.clone())
        when Option::None then ()
        end
      when Option::None then ()
      end
    end
  when _ then ()
  end
  typed_effect_of_name(env, eff_name)  end
end

# The performed effect accumulates into the enclosing function's computed
# effect set (the transitive discipline's call-site channel). A perform
# lexically inside a handle/with block for the SAME effect is neutralized
# (the enclosing handler catches it — the enclosing function need not
# declare an effect it handles).
def record_perform_effect(inout env: TypeEnv, eid: EffectId) -> Unit
  if env.current_fn_key == "" then return end
  var hi = 0
  while hi < env.handler_stack.len() do
    if env.handler_stack[hi] == eid.id then return end
    hi = hi + 1
  end
  var effs = Vec::new()
  effs.push(eid.clone())
  match env.fn_computed_effects.get(env.current_fn_key.clone())
  when Option::Some(comp) then
    var new_comp = comp.clone()
    let _ = effect_set_append(&mut new_comp, effs)
    env.fn_computed_effects.insert(env.current_fn_key.clone(), new_comp)
  when Option::None then
    env.fn_computed_effects.insert(env.current_fn_key.clone(), effs)
  end
end

# The perform-call typing. Option::None when the call is NOT the perform
# surface (the caller falls through to the normal call checking); a
# resolved perform call returns the op's return type.
def check_effect_perform_call(inout env: TypeEnv, expr: Expr, func: Expr, args: Vec[Expr]) -> Option[Type]
  if !effect_perform_callee_path(&func) then return Option::None end
  if args.len() < 1 then
    type_add_error(env, "std::effects::perform requires an operation reference as its first argument: perform(EFFECT.op, ...)", expr.span)
    return Option::Some(Type::Error)
  end
  match effect_op_reference_of(&args[0])
  when Option::Some((eff_name, op_name)) then
    var decl: Option[TypedEffectDecl] = Option::None
    match typed_effect_of_op_reference(env, &args[0], &eff_name)
    when Option::Some(td) then decl = Option::Some(td)
    when Option::None then ()
    end
    match decl
    when Option::Some(td) then
      let op_index = typed_effect_op_index(&td, &op_name)
      if op_index < 0 then
        type_add_error(env, "effect `" + eff_name + "` has no operation `" + op_name + "`", args[0].span)
        return Option::Some(Type::Error)
      end
      let op_sig = td.ops[op_index]
      if args.len() - 1 != op_sig.params.len() then
        type_add_error(env, "wrong number of arguments for effect operation `" + eff_name + "::" + op_name + "`: expected " + op_sig.params.len().to_string() + ", found " + (args.len() - 1).to_string(), expr.span)
      end
      env.access_marker_depth = env.access_marker_depth + 1
      var pi = 0
      while pi < args.len() - 1 && pi < op_sig.params.len() do
        let arg_ty = check_expr(env, &args[pi + 1])
        unify(env, arg_ty, op_sig.params[pi].clone(), args[pi + 1].span)
        record_arg_effect(env, &args[pi + 1], AccessConvention::Let)
        pi = pi + 1
      end
      while pi < args.len() - 1 do
        check_expr(env, &args[pi + 1])
        record_arg_effect(env, &args[pi + 1], AccessConvention::Let)
        pi = pi + 1
      end
      env.access_marker_depth = env.access_marker_depth - 1
      record_perform_effect(env, &td.id)
      Option::Some(op_sig.ret.clone())
    when Option::None then
      type_add_error(env, "unknown effect `" + eff_name + "` in the operation reference (no `effect " + eff_name + "` declaration is in scope)", args[0].span)
      Option::Some(Type::Error)
    end
  when Option::None then
    type_add_error(env, "std::effects::perform requires an operation reference as its first argument: perform(EFFECT.op, ...)", args[0].span)
    Option::Some(Type::Error)
  end
end

# The typed-tree assembly of a resolved perform call (the mirror of
# typed_call_for): the EffectPerform callee identity carries the semantic
# EffectId + the op's declaration index + name; the args are the OPERATION
# PAYLOAD (the op-reference argument is never a typed child — the MIR's
# perform lowering reads the identity from the callee record).
def typed_effect_perform_call_for(env: TypeEnv, expr: Expr, args: Vec[Expr]) -> Option[TypedCall]
  var eff_id = EffectId { id: -1 }
  var op_idx = -1
  var op_name = ""
  match effect_op_reference_of(&args[0])
  when Option::Some((eff_name, op_name2)) then
    op_name = op_name2.clone()
    match typed_effect_of_op_reference(env, &args[0], &eff_name)
    when Option::Some(td) then
      eff_id = td.id.clone()
      op_idx = typed_effect_op_index(&td, &op_name2)
    when Option::None then ()
    end
  when Option::None then ()
  end
  if eff_id.id < 0 || op_idx < 0 then return Option::None end
  var typed_args = Vec::new()
  var i = 1
  while i < args.len() do
    match env.typed_access_effects.get(args[i].node_id)
    when Option::Some(eff) then
      match typed_child_of(env, &args[i])
      when Option::Some(at) then
        typed_args.push(TypedCallArg { effect: eff, value: at })
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
    i = i + 1
  end
  Option::Some(TypedCall { callee: TypedCallee::EffectPerform(eff_id, op_idx, op_name), receiver_effect: Option::None, receiver: Option::None, args: typed_args })
end

# The bounded arm-body control-flow gate: return/break/continue/defer are
# rejected inside effect-handler arms (the arm runs in the handler's
# dispatcher function — the enclosing frame's CFG edges and teardown plans
# do not exist there). Walks nested blocks/expressions recursively.
def effect_arm_body_has_control_flow(block: Block) -> Bool
  var i = 0
  while i < block.stmts.len() do
    if effect_stmt_has_control_flow(&block.stmts[i]) then return true end
    i = i + 1
  end
  false
end

def effect_stmt_has_control_flow(stmt: Stmt) -> Bool
  match stmt.kind
  when StmtKind::StmtReturn(_) | StmtKind::StmtBreak(_) | StmtKind::StmtContinue then true
  when StmtKind::StmtDefer(body) then true
  when StmtKind::StmtIf(if_stmt) then
    if effect_expr_has_control_flow(&if_stmt.cond) then return true end
    if effect_arm_body_has_control_flow(&if_stmt.then_block) then return true end
    var ei = 0
    while ei < if_stmt.elsif_branches.len() do
      if effect_expr_has_control_flow(&if_stmt.elsif_branches[ei].0) then return true end
      if effect_arm_body_has_control_flow(&if_stmt.elsif_branches[ei].1) then return true end
      ei = ei + 1
    end
    match if_stmt.else_block
    when Option::Some(eb) then effect_arm_body_has_control_flow(&eb)
    when Option::None then false
    end
  when StmtKind::StmtWhile(cond, body) then
    effect_expr_has_control_flow(&cond) || effect_arm_body_has_control_flow(&body)
  when StmtKind::StmtFor(for_stmt) then
    effect_expr_has_control_flow(&for_stmt.iter) || effect_arm_body_has_control_flow(&for_stmt.body)
  when StmtKind::StmtLoop(body) then effect_arm_body_has_control_flow(&body)
  when StmtKind::StmtMatch(m) then
    if effect_expr_has_control_flow(&m.scrutinee) then return true end
    var ai = 0
    while ai < m.arms.len() do
      match m.arms[ai].guard_expr
      when Option::Some(g) then if effect_expr_has_control_flow(&g) then return true end
      when Option::None then ()
      end
      if effect_arm_body_has_control_flow(&m.arms[ai].body) then return true end
      ai = ai + 1
    end
    false
  when StmtKind::StmtExpr(e) then effect_expr_has_control_flow(&e)
  when StmtKind::StmtUnsafe(_, body) then effect_arm_body_has_control_flow(&body)
  when _ then false
  end  end
end

def effect_expr_has_control_flow(expr: Expr) -> Bool
  match expr.kind
  when ExprKind::ExprBlock(block) then effect_arm_body_has_control_flow(&block)
  when ExprKind::ExprIf(if_stmt) then
    if effect_expr_has_control_flow(&if_stmt.cond) then return true end
    if effect_arm_body_has_control_flow(&if_stmt.then_block) then return true end
    var ei = 0
    while ei < if_stmt.elsif_branches.len() do
      if effect_expr_has_control_flow(&if_stmt.elsif_branches[ei].0) then return true end
      if effect_arm_body_has_control_flow(&if_stmt.elsif_branches[ei].1) then return true end
      ei = ei + 1
    end
    match if_stmt.else_block
    when Option::Some(eb) then effect_arm_body_has_control_flow(&eb)
    when Option::None then false
    end
  when ExprKind::ExprMatch(m) then
    if effect_expr_has_control_flow(&m.scrutinee) then return true end
    var ai = 0
    while ai < m.arms.len() do
      match m.arms[ai].guard_expr
      when Option::Some(g) then if effect_expr_has_control_flow(&g) then return true end
      when Option::None then ()
      end
      if effect_arm_body_has_control_flow(&m.arms[ai].body) then return true end
      ai = ai + 1
    end
    false
  when ExprKind::ExprUnsafe(_, block) then effect_arm_body_has_control_flow(&block)
  when ExprKind::ExprClosure(_, _, body) then effect_expr_has_control_flow(&body)
  when ExprKind::ExprAsync(block) then effect_arm_body_has_control_flow(&block)
  when ExprKind::ExprTry(inner) then effect_expr_has_control_flow(&inner)
  when _ then false
  end  end
end

# Whether the function under a def-key is a std module function — the
# trusted implementation base exempt from the compare diagnostics (its
# declared effects are the API contract for USER callers; its internal
# calls are the implementation of those declared effects).
def fn_effect_is_std(env: TypeEnv, key: String) -> Bool
  match env.fn_effect_modules.get(key)
  when Option::Some(mpath) then
    mpath.len() > 0 && mpath[0] == "std"
  when Option::None then false
  end  end
end

# the ownership-layer owner key of an item's free function — the
# per-function finalize-plan key AND the parameter-binding key. DefId-derived
# when the resolver recorded one (def_id_of_item): the deterministic render
# of the DefId's owner ModuleId + index + kind via fn_owner_key_of_def
# (crate_module_path_of + def_kind_of) — unique per module-qualified
# function, because the DefId's module is the item's FULL owner module
# (record_item_def threads the owner ModuleId from Program.crate) and the
# index is the module's symbol counter, which record_item_def guarantees
# exists for EVERY top-level function. Name-based fallback for the no-DefId
# cases: the module-path-qualified key via module_qualified_fn_key — the
# same scheme the resource checker's genuinely-nested-module items use
# (item_idx -1, which MIR never lowers), so every consumer derives
# byte-identical keys for the same semantic callable.
def fn_owner_key_of_item(program: Program, res: ResolvedNames, item_idx: Int, module_path: Vec[String], name: String) -> String
  match def_id_of_item(res, item_idx)
  when Option::Some(did) then
    fn_owner_key_of_def(program, res, &did)
  when Option::None then
    module_qualified_fn_key(module_path, name)
  end  end
end

# ———————————————————————————————————————————————————————————————
# Deinitialization plans
#
# The authoritative, recursive cleanup description for a type, computed at
# type-check time (typed.deinit_plans) and consumed by MIR lowering. A type
# without a registered deinit is Trivial (resources may be trivially
# deinitialized — absence of a deinit method is NOT an error). Containers
# recurse so Option[R], Array[R], Map[K,R], tuples etc. get real cleanup.
#
# CALLABLE IDENTITIES: the finalizer payloads are SEMANTIC identities
# — InstanceId { def: CallableId, substs } — NEVER strings. The chosen
# finalizer is attached to its type by the checker's Drop-impl / deinit
# registration (typed.deinit_targets: TypeId -> CallableId — the resolver's
# DefId, the same identity the MIR records for the mangled "Type__drop" /
# "Type__deinit" emission names). The substs carry the CONCRETE type
# arguments (Box[Int]'s plan references the Box finalizer instantiated with
# [Int]); a nominal/template plan built with empty args carries the
# CallableId with empty substs. No finalizer is ever identified by its name
# (drop/deinit/"Type__drop") anywhere downstream of this registration: the
# registration is the identity source, the emission name is derived only at
# the symbol-mangling boundary (MIR's MirDeinit payload and codegen's label
# resolution key by the DefId/InstanceId).
# ———————————————————————————————————————————————————————————————
enum DeinitPlan
  Trivial
  # The finalizer's semantic identity (InstanceId — CallableId + the
  # concrete type-argument substitutions; empty substs = the nominal
  # template form). The MIR's drop glue emits the MirDeinit carrying this
  # instance; codegen resolves the finalizer's emission label from the
  # DefId. Constructed ONLY from the registered deinit_targets entry of the
  # type being planned (verified_* below — fail-closed).
  Call(InstanceId)
  # Explicit user finalizer PLUS compiler-owned structural field cleanup
  # (exactly-once rule: user finalizer runs first, then field cleanup). The
  # finalizer payload is the same semantic InstanceId as Call.
  UserFinalizer(InstanceId, DeinitPlan)
  Aggregate(Vec[DeinitPlan])
  # variant discriminant -> (the SEMANTIC VariantId — owner TypeId +
  # declaration index, the same identity the MIR's Projection::Variant
  # carries — plus the per-field plans). The drop-glue emission projects
  # the downcast through the VariantId directly; no variant NAME is
  # carried (strings are never identities).
  Enum(Map[Int, (VariantId, Vec[DeinitPlan])])
  Array(DeinitPlan)
  Set(DeinitPlan)                  # hash-set element plan (NOT array storage)
  # Box[T]: an OWNING pointer/allocation, not an inline aggregate. Lowering
  # dereferences the box, finalizes the pointee, and releases the allocation
  # (exactly once).
  Box(DeinitPlan)
  # Fail-closed marker: the cleanup plan could not be constructed finitely
  # (recursive resource type without drop glue). The emitter reports an
  # internal error instead of silently dropping cleanup.
  PlanLimit
 # (recursive owning types — the RECURSION-BREAK marker): the plan edge
  # of a recursive owning cycle (Tree -> Vec[Tree], Json -> Map[String,
  # Json], a Box/Rc-linked list). Destruction of the position delegates to
  # the CONCRETE TYPE's own generated drop glue — the ONE memoized
  # MirFunction per concrete type (mir.tg's mir_glue_instance_for_type /
  # drop_glue_fns). The marker is the SEMANTIC plan's stand-in for the glue
  # call: the semantic table has no synthetic CallableId (the glue's
  # DefId is assigned by the MIR builder at plan-construction time), so the
  # cycle edge is recorded as SelfRecursive and the MIR's CONCRETE plan
  # construction (deinit_plan_for_type_uncached's visited arm) rewrites the
  # same edge into DeinitPlan::Call(glue-instance) — the recursion-by-
  # symbol that breaks the expansion. The marker is never emitted into a
  # walk: reaching emit_plan_deinit with a SelfRecursive edge is an
  # internal error (fail-closed, mirroring PlanLimit), and the ownership
  # containment test answers true (the edge owns — never destruction-free).
  SelfRecursive
 # FAIL-CLOSED DEFERRED marker (— the generic ownership policy): the
  # plan for an UNSUBSTITUTED generic-parameter position (Type::Param) or an
  # unresolved inference-variable position (Type::Var). The engine answers
  # is_deferred=true there — the six semantic fields are non-authoritative,
  # and a Trivial answer for the position would FAIL OPEN ("no destructor")
  # for a substituted resource instantiation. The Deferred marker carries NO
  # concrete answer: the concrete drop glue after substitution (the
  # monomorphized instance's concrete plan — deinit_plan_for_type on the
  # concrete type) is the authority. Emission of a Deferred plan is an
  # internal error (mir.tg's emit_plan_deinit panics, mirroring PlanLimit):
  # a deferred position that ever reaches the drop-glue walk means the
  # concrete substitution never happened — silently skipping would leak.
  Deferred
  Map(DeinitPlan, DeinitPlan)      # key plan, value plan
  Tuple(Vec[DeinitPlan])
  Option(DeinitPlan)
  Result(DeinitPlan, DeinitPlan)
 # The OWNED STRING destructor (— real String lifetime): the String
  # value owns the 32-byte String OBJECT and its data BUFFER, both
  # allocated from the real heap (_tg_mem_alloc-style); the drop-glue walk
  # emits the String drop (_tg_string_drop — mir.tg's DeinitPlan::String
  # arm registers the synthetic drop identity and codegen resolves it to
  # the runtime destructor), which releases the buffer AND the object.
  # This REPLACES the former Trivial plan for Type::String — the arena
  # reclaim is are not part of the model; String values have real allocation/deallocation
  # semantics at their lifetime boundary.
  String
end

pub def deinit_plan_is_trivial(plan: DeinitPlan) -> Bool
  match plan
  when DeinitPlan::Trivial then true
  when _ then false
  end  end
end

# ———————————————————————————————————————————————————————————————
# (final layer): DeinitPlan finalizer-callable construction-site
# verification (identity-based).
#
# INVARIANT: every DeinitPlan::Call / DeinitPlan::UserFinalizer payload is
# the SEMANTIC InstanceId of a VERIFIED registered finalizer — the value of
# typed.deinit_targets for the type being planned (the checker's Drop-impl /
# deinit-method registration — the resolver DefId, never a name). The
# construction sites below take the CallableId directly from that
# registration lookup; an identity that is NOT a registered finalizer
# records a TypeError and fails CLOSED with PlanLimit — an invalid finalizer
# cannot even be constructed. There is no name verification (drop/deinit/
# "Type__drop" spellings never identify a finalizer); the registration is
# the identity source.
# ———————————————————————————————————————————————————————————————

# True when `callable` is a registered deinit_targets value for some type id
# (identity comparison — the DefId, never a name).
def deinit_callable_is_registered(typed: TypedProgram, callable: CallableId) -> Bool
  for (_, dv) in typed.deinit_targets do
    if dv.def.module.id == callable.def.module.id && dv.def.index == callable.def.index then
      return true
    end
  end
  false
end

# the typed FINALIZER KIND of a callable — the
# FinalizerKind the checker assigned at registration (the per-TypeId
# finalizer_kinds record, keyed like deinit_targets). NotFinalizer for a
# callable that is not a registered finalizer. THIS is the only finalizer
# recognition any consumer performs — no source-name inspection
# (deinit/drop spellings never decide semantics).
pub def finalizer_kind_of_callable(typed: TypedProgram, callable: CallableId) -> FinalizerKind
  for (tid_id, dv) in typed.deinit_targets do
    if dv.def.module.id == callable.def.module.id && dv.def.index == callable.def.index then
      match typed.finalizer_kinds.get(tid_id)
      when Option::Some(k) then return k
      when Option::None then return FinalizerKind::NotFinalizer
      end
    end
  end
  FinalizerKind::NotFinalizer
end

# Construct DeinitPlan::Call(instance) ONLY from a registered finalizer
# identity; an unregistered identity records a TypeError and fails CLOSED
# with PlanLimit instead of an unverifiable Call. The instance's substs are
# the concrete type arguments of the planned type (empty for the nominal
# template form).
def verified_deinit_call(typed: TypedProgram, callable: CallableId, args: Vec[Type], inout errors: Vec[TypeError]) -> DeinitPlan
  if deinit_callable_is_registered(typed, callable) then
    DeinitPlan::Call(InstanceId { def: callable.clone(), substs: args.clone() })
  else
    errors.push(TypeError {
      message: "invalid finalizer identity (not a registered Drop/deinit callable)",
      span: Span { file: "", start: 0, end_pos: 0 },
      code: Option::None
    })
    DeinitPlan::PlanLimit
  end
end

# Construct DeinitPlan::UserFinalizer(instance, fields_plan) ONLY from a
# registered finalizer identity (the same invariant as Call: the instance
# is the finalizer identity that later emits as a MirDeinit); an
# unregistered identity records a TypeError and fails CLOSED with PlanLimit.
def verified_deinit_finalizer(typed: TypedProgram, callable: CallableId, args: Vec[Type], fields_plan: DeinitPlan, inout errors: Vec[TypeError]) -> DeinitPlan
  if deinit_callable_is_registered(typed, callable) then
    DeinitPlan::UserFinalizer(InstanceId { def: callable.clone(), substs: args.clone() }, fields_plan)
  else
    errors.push(TypeError {
      message: "invalid finalizer identity (not a registered Drop/deinit callable)",
      span: Span { file: "", start: 0, end_pos: 0 },
      code: Option::None
    })
    DeinitPlan::PlanLimit
  end
end

# Canonical plans for the builtin container types (Option/Result/Array/Vec/
# Map/Set), keyed by the LangItems TypeId (the typed program's canonical
# snapshot — never the registered name; a snapshot missing an id fails
# CLOSED to Trivial/structural, matching the pre-existing name fallback
# behavior for an unregistered name). The RAW view (UnsafeSlice) is
# deliberately NOT here as an owning container: the raw view is the
# {ptr,len} view (owns=false, drop=none) and its plan is Trivial. The
# SAFE shared/pinned forms (the source-spelled Slice / StrView — the
# Arc-class views) are
# std-declared structs and flow through the structural walk: the Arc
# field's registered Drop owns the destruction (the backing's deinit
# releases the pinned allocation). Returns Trivial for anything else; the
# caller falls back to the structural walk.
def nominal_container_plan(typed: TypedProgram, tid: TypeId, type_name: String, args: Vec[Type], depth: Int, inout visited: Set[Int], inout errors: Vec[TypeError]) -> DeinitPlan
  let li = typed.lang_items
  if li.option != -1 && tid.id == li.option && args.len() >= 1 then
    DeinitPlan::Option(build_deinit_plan(typed, &args[0], depth + 1, visited, errors))
  elsif li.result != -1 && tid.id == li.result && args.len() >= 2 then
    DeinitPlan::Result(build_deinit_plan(typed, &args[0], depth + 1, visited, errors), build_deinit_plan(typed, &args[1], depth + 1, visited, errors))
  elsif li.slice != -1 && tid.id == li.slice then
    # UnsafeSlice[T] — the RAW view { ptr: Ptr[T], len: UInt }:
    # owns=false, drop=none. A raw-view local needs NO destruction
    # regardless of the element type (the element's ownership lives in the
    # backing buffer the view borrows). The raw view must not outlive its
    # backing — the escape constraint is enforced by the P0-SL rules
    # (the raw view's escape channels in the type checker + the resource
    # checker's live-view registry / IterationPlan mutation scan). The
    # SAFE shared/pinned form (the source-spelled Slice — the Arc-class
    # view) is NOT
    # this arm: its Arc field's Drop owns the destruction.
    DeinitPlan::Trivial
  elsif ((li.array != -1 && tid.id == li.array) || (li.vec != -1 && tid.id == li.vec)) && args.len() >= 1 then
    DeinitPlan::Array(build_deinit_plan(typed, &args[0], depth + 1, visited, errors))
  elsif li.map != -1 && tid.id == li.map && args.len() >= 2 then
    DeinitPlan::Map(build_deinit_plan(typed, &args[0], depth + 1, visited, errors), build_deinit_plan(typed, &args[1], depth + 1, visited, errors))
  elsif li.set != -1 && tid.id == li.set && args.len() >= 1 then
    DeinitPlan::Set(build_deinit_plan(typed, &args[0], depth + 1, visited, errors))
  elsif li.box_ != -1 && tid.id == li.box_ && args.len() >= 1 then
    # The Adt Box form's plan mirrors the dropped canonical Type::Box arm —
    # the registered Drop-impl identity for the Box type is the finalizer
    # source (the checker's registration — never the "Box__drop" name).
    # Fail-closed: a Box without a registered Drop identity cannot be
    # destroyed — PlanLimit + TypeError.
    match typed.deinit_targets.get(tid.id)
    when Option::Some(box_callable) then verified_deinit_call(typed, &box_callable, args, errors)
    when Option::None then
      errors.push(TypeError {
        message: "Box type `" + type_name + "` has no registered Drop impl (cannot construct a deinit plan)",
        span: Span { file: "", start: 0, end_pos: 0 },
        code: Option::None
      })
      DeinitPlan::PlanLimit
    end
  elsif li.rc != -1 && tid.id == li.rc && args.len() >= 1 then
    # The Adt Rc form's plan mirrors the dropped canonical Type::Rc arm —
    # the registered Drop-impl identity for the Rc type (never a name).
    match typed.deinit_targets.get(tid.id)
    when Option::Some(rc_callable) then verified_deinit_call(typed, &rc_callable, args, errors)
    when Option::None then
      errors.push(TypeError {
        message: "Rc type `" + type_name + "` has no registered Drop impl (cannot construct a deinit plan)",
        span: Span { file: "", start: 0, end_pos: 0 },
        code: Option::None
      })
      DeinitPlan::PlanLimit
    end
  else
    DeinitPlan::Trivial
  end
end

# Build the deinit plan for a type from the typed program's type kinds and
# registered deinit targets. Mirrors the type checker's viral containment
# rules: containers of resource types get recursive plans; a direct resource
# type without a deinit method is Trivial (per the language rule).
pub def build_deinit_plan(typed: TypedProgram, ty: Type, depth: Int, inout visited: Set[Int], inout errors: Vec[TypeError]) -> DeinitPlan
  # Cycle-aware recursion: recursive type graphs (e.g. Box-like self
  # references) legitimately revisit a type id; the revisit edge is Trivial.
  # A depth beyond the safety bound is NOT silently Trivial — it is a
  # compiler-internal error (cleanup analysis that "got too deep" must never
  # become "nothing to clean").
  if depth > 128 then
    errors.push(TypeError {
      message: "internal error: deinit plan recursion exceeded depth 128 for type",
      span: Span { file: "", start: 0, end_pos: 0 },
      code: Option::None
    })
    return DeinitPlan::PlanLimit
  end
  match ty
  when Type::Tuple(fields) then
    var plans = Vec::new()
    for f in fields do
      plans.push(build_deinit_plan(typed, &f, depth + 1, visited, errors))
    end
    DeinitPlan::Tuple(plans)
  when Type::Adt(tid, args) then
    let type_name = match typed.type_names.get(tid.id)
    when Option::Some(n) then n.clone()
    when Option::None then ""
    end
    match typed.type_kinds.get(tid.id)
    when Option::Some(k) then
      if k == TypeKind::Resource || k == TypeKind::Capability then
        match typed.deinit_targets.get(tid.id)
        when Option::Some(callable) then
          # Explicit finalizer: the USER finalizer runs first, then the
          # compiler-owned structural field cleanup (exactly-once rule).
          # A custom finalizer alone would leak resource fields; composing
          # both guarantees each field is cleaned exactly once.
 # (final layer): the callable comes from the registered
          # deinit_targets lookup (the checker's Drop-impl / deinit-method
          # registration — the resolver DefId, never a name), but the gate
          # is explicit: an unregistered identity records a TypeError and
          # fails CLOSED with PlanLimit instead of an unverifiable Call.
          if visited.contains(&tid.id) then
            verified_deinit_call(typed, &callable, &args, errors)
          else
            visited.insert(tid.id)
            let fields_plan = nominal_containment_plan(typed, &tid, &args, depth, visited, errors)
            visited.remove(&tid.id)
            if deinit_plan_is_trivial(&fields_plan) then
              verified_deinit_call(typed, &callable, &args, errors)
            else
              verified_deinit_finalizer(typed, &callable, &args, fields_plan, errors)
            end
          end
        when Option::None then
          # No explicit deinit: VIRAL containment applies. A resource whose
          # fields/variants contain resources still needs recursive cleanup —
          # build an Aggregate/Enum plan over the nominal shape (a bare
          # Trivial would silently leak field resources).
          if visited.contains(&tid.id) then
 # (recursive owning types): the recursion edge is the
            # SelfRecursive marker — the position's destruction delegates
            # to the concrete type's own generated drop glue (the
            # memoized MirFunction). The MIR's concrete plan construction
            # rewrites the marker into a glue CALL (recursion by symbol),
            # so the plan tree stays finite — no error, no PlanLimit.
            DeinitPlan::SelfRecursive
          else
            visited.insert(tid.id)
            let result = nominal_containment_plan(typed, &tid, &args, depth, visited, errors)
            visited.remove(&tid.id)
            result
          end
        end
      else
        # Builtin container types (Option/Result/Array/Map/Set) resolve to
        # their container plans via the LangItems name + generic args (the
        # Adt form's TypeId + args; the canonical variants are is not part of the model).
        let container_plan = nominal_container_plan(typed, &tid, &type_name, &args, depth, visited, errors)
        if deinit_plan_is_trivial(&container_plan) then
          # Ordinary nominal Value types: cleanup is structural. A struct
          # Wrapper[T] { item: T } instantiated with a resource must clean
          # its fields — the semantic layer and MIR must agree, so the
          # semantic plan walks the nominal shape rather than returning
          # Trivial for anything that is not a recognized container.
          # A Value-kind type with a registered deinit (an `impl Drop for
          # T`) runs its drop: the plan references the callable so the
          # allocation/state release actually executes (a plain structural
          # walk of e.g. Box[T] { ptr } would see only a non-owning Ptr and
          # leak the pointee). Ordering matches the MIR: the registered
          # drop wins over the container/structural shape.
          let deinit_shape = match typed.deinit_targets.get(tid.id)
          when Option::Some(callable2) then
 # (final layer): construction-site verification — same
            # invariant as the resource-with-finalizer path: every payload
            # is the SEMANTIC InstanceId of a verified registered finalizer
            # (the registration is the identity source — never a name); an
            # unregistered identity fails CLOSED with PlanLimit + TypeError.
            if visited.contains(&tid.id) then
              verified_deinit_call(typed, &callable2, &args, errors)
            else
              visited.insert(tid.id)
              let inner_container_plan = nominal_container_plan(typed, &tid, &type_name, &args, depth, visited, errors)
              let struct_shape = if deinit_plan_is_trivial(&inner_container_plan) then
                nominal_containment_plan(typed, &tid, &args, depth, visited, errors)
              else
                inner_container_plan
              end
              visited.remove(&tid.id)
              if deinit_plan_is_trivial(&struct_shape) then
                verified_deinit_call(typed, &callable2, &args, errors)
              else
                verified_deinit_finalizer(typed, &callable2, &args, struct_shape, errors)
              end
            end
          when Option::None then
            if visited.contains(&tid.id) then
 # (recursive owning types): the recursion edge is the
              # SelfRecursive marker — destruction delegates to the
              # concrete type's own generated drop glue (recursion by
              # symbol; the MIR rewrites the marker into the glue call).
              DeinitPlan::SelfRecursive
            else
              visited.insert(tid.id)
              let inner_container_plan = nominal_container_plan(typed, &tid, &type_name, &args, depth, visited, errors)
              let result = if deinit_plan_is_trivial(&inner_container_plan) then
                nominal_containment_plan(typed, &tid, &args, depth, visited, errors)
              else
                inner_container_plan
              end
              visited.remove(&tid.id)
              result
            end
          end
          deinit_shape
        end
      end
    when Option::None then DeinitPlan::Trivial
    end
  when Type::FixedArray(elem, _) then
    # The fixed array stores its elements INLINE: the drop glue walks the n
    # elements (no heap backing to release).
    DeinitPlan::Array(build_deinit_plan(typed, &elem, depth + 1, visited, errors))
  when Type::String then DeinitPlan::String
  when _ then DeinitPlan::Trivial
  end
end

# Build the containment plan for a nominal resource/capability WITHOUT an
# explicit deinit: struct fields become Aggregate plans, enum variants become
# Enum plans. Fields with Param types are substituted with the concrete args.
def nominal_containment_plan(typed: TypedProgram, tid: TypeId, args: Vec[Type], depth: Int, inout visited: Set[Int], inout errors: Vec[TypeError]) -> DeinitPlan
 # FIX 2 (): fetch the type's generic-parameter names ONCE per call —
  # the per-field/per-variant refetch was a repeated lookup of the same
  # TypeDef shape in the hottest deinit-plan construction loops.
  let def_params = match typed.type_params.get(tid.id)
  when Option::Some(ps) then ps.clone()
  when Option::None then Vec::new()
  end
  match typed.type_fields.get(tid.id)
  when Option::Some(fields) then
    var plans = Vec::new()
    var fi = 0
    while fi < fields.len() do
      let fld = fields[fi]
      # Substitute generic params with the concrete args (Param("T") -> args[i]
      # positionally).
      let fld_ty = subst_type_args(&fld.1, &def_params, args)
      plans.push(build_deinit_plan(typed, &fld_ty, depth + 1, visited, errors))
      fi = fi + 1
    end
    DeinitPlan::Aggregate(plans)
  when Option::None then
    match typed.type_variants.get(tid.id)
    when Option::Some(variants) then
 # (DeinitPlan::Enum — VariantId): the per-variant payload carries
      # the SEMANTIC VariantId (owner TypeId + DECLARATION index — the
      # declaration order of the typed variant table, never the
      # discriminant and never a name).
      var vmap = Map::new()
      var variant_idx = 0
      while variant_idx < variants.len() do
        let v = variants[variant_idx]
        var vplans = Vec::new()
        var vi = 0
        while vi < v.1.len() do
          let vty = subst_type_args(&v.1[vi], &def_params, args)
          vplans.push(build_deinit_plan(typed, &vty, depth + 1, visited, errors))
          vi = vi + 1
        end
        vmap.insert(v.2, (VariantId { owner: TypeId { id: tid.id }, index: variant_idx as UInt }, vplans))
        variant_idx = variant_idx + 1
      end
      DeinitPlan::Enum(vmap)
    when Option::None then DeinitPlan::Trivial
    end
  end
end

struct TypeVarId
  id: Int
end

# ———————————————————————————————————————————————————————————————
# Type Definitions
# ———————————————————————————————————————————————————————————————

enum TypeKind
  Value
  Resource
  Capability
end

struct TypeDef
  id: TypeId
  name: String
  def_kind: TypeDefKind
 # the declaration's generic parameters as GenericParamIds in
  # declaration order (interned at registration — the id index IS the
  # declaration position). Substitution is positional and id-keyed; names
  # live in the param-name table (diagnostics only).
  generic_params: Vec[GenericParamId]
  kind: TypeKind
 # (TypeId -> DefId at registration): the DEFINING DECLARATION's
  # resolver DefId — the module_symbols DefKind::TypeName/Trait entry for
  # this (module path, name) pair, recorded by store_type_def (the type
  # registration). Option::None for builtin/compiler-synthesized types
  # (they have no resolver declaration). The public ABI's
  # type-to-declaration association is DIRECT through this identity — no
  # name/order correlation. The checker also mirrors the association into
  # ResolvedNames.type_def_ids (the serialized carrier the ABI consumer
  # reads).
  def: Option[DefId]
end

enum TypeDefKind
  Struct(Vec[FieldInfo])
  Enum(Vec[VariantInfo])
  Trait(Vec[MethodSig])
  Alias(Type)
  Primitive
  Opaque  # Built-in types with special semantics (Ptr, Box, Rc, etc.)
end

struct FieldInfo
  name: String
  ty: Type
  is_public: Bool
end

struct VariantInfo
  name: String
  fields: Vec[Type]
  discriminant: Int
end

struct MethodSig
  name: String
  params: Vec[ParamType]
  ret_type: Type
  is_method: Bool
end

# ———————————————————————————————————————————————————————————————
# Type-Property engine support 
# ———————————————————————————————————————————————————————————————
#
# The graph-algorithm visit states and the memoized property bundle for the
# type-property engine (type_properties_of, defined with the solver below).
# The declarations live here (before TypeEnv) because TypeEnv carries the
# engine's memoization cache.

# DFS visit states for the type-property graph walk. A key that is Visiting
# when the walk reaches it again is a recursion through INLINE storage —
# an infinitely sized recursive type, diagnosed by the engine instead of the
# layout engine's panic. Indirections (Ptr/Box/Rc) terminate the walk, so
# legal recursive types (e.g. Node { next: Option[Box[Node]] }) never cycle.
enum TypePropVisitState
  Unvisited
  Visiting
  Resolved
end

# The per-type property bundle computed by type_properties_of. The two
# ownership axes are SPLIT (): a type can own state without a physical
# destructor, and a type can require no destructor yet still be unsafe to
# bit-copy. Copy legality is a THIRD axis.
#   owns_state          — the value carries semantic ownership: it must be
#                         moved/consumed, never duplicated, and the
#                         resource checker tracks it. TRUE for String
#                         (owns a unique heap buffer — Clone, NOT Copy),
#                         Vec/Map/Set/
#                         Box/Rc, registered-drop types; FALSE for Int.
#   requires_drop_glue  — the value needs a physical destructor (drop
#                         glue): the buffer release (Vec/Map/Set/Box/Rc),
#                         a registered Drop impl (File), a registered
# deinit. TRUE for String since (real String
#                         lifetime): the owned String OBJECT and its data
#                         buffer are real-heap allocations
#                         (_tg_mem_alloc-style) and the String drop
#                         (_tg_string_drop — the DeinitPlan::String
#                         destructor) frees both, so String and
#                         String-containing aggregates need the glue. The
#                         DeinitPlan (drop-glue shape) is gated
#                         on THIS axis.
#   is_linear           — move-only: must be consumed, never duplicated
#   is_capability       — TypeKind::Capability (scoped, linear)
#   contains_capability — the value (or any substituted field/element/
#                         payload) is or contains a capability: capability
#                         containment through composites — an aggregate
#                         with a capability field, a container with
#                         capability elements, Option/Result containing
#                         capabilities (the checker's capability-exit
#                         machinery consumes this axis).
# is_trivially_copyable — raw bit-copy is valid, no retain/clone (—
#                         THE copy authority; the MIR Copy verifier
#                         queries THIS axis, never the DeinitPlan).
# is_transferable      — (concurrency properties) the compiler-derived
#                         Transferable property: a value may move into
#                         another execution context. Derived by the
#                         transferable walk (derive_transferable — the
#                         single authority; see the concurrency section):
#                         FALSE when the value contains an
#                         execution-context-affine native handle (the
#                         std-marked AffineHandle — the pthread thread
#                         handle / TLS key — unless the containing type
#                         explicitly opts in via UnsafeTransferable), the
#                         active lexical inout state (a closure with an
#                         inout capture), or a non-transferable captured
#                         state. TRUE for the scalars, the owned
#                         containers/strings (ownership moves), and the
#                         Arc/Box/UniquePtr pointer layer (the pointee
#                         walk); Rc and the raw pointers (gated) are
#                         FALSE. A deferred type carries NO concrete
#                         answer (false + is_deferred).
# is_shareable          — (concurrency properties) the compiler-derived
#                         Shareable property: safe simultaneous access
#                         through a shared representation. Derived by
#                         the shareable walk (derive_syncable): TRUE for
#                         the trivially-copyable value types AND the
#                         recognized synchronized representations (the
#                         Arc/WeakArc — the shared heap boundary; the
#                         atomics/Mutex/RwLock/channels reach it
#                         structurally through their Arc/scalar
#                         layers). The plain OWNED types (String/Vec/
#                         owned aggregates) are Transferable but NOT
#                         Shareable — shared mutable state must go
#                         through Arc/Mutex/RwLock/atomics/channels.
#                         Cell/RefCell/UnsafeCell (interior mutability
#                         without synchronization) and Rc are FALSE.
#   is_deferred         — the type graph contains an unsubstituted generic
#                         parameter (Type::Param) or an unresolved inference
#                         variable (Type::Var): the six semantic fields are
#                         NOT authoritative — "unknown/deferred", never a
#                         concrete semantic answer. A generic local may
#                         require CONDITIONAL drop after substitution, so a
#                         consumer must check is_deferred FIRST: while
#                         deferred, a false owns_state/requires_drop_glue/
#                         is_linear/is_capability/contains_capability/
#                         is_trivially_copyable/is_transferable/
#                         is_shareable means "not proven true",
#                         NOT "definitely false". The concrete answers
#                         appear only after substitution (the MIR/mono
#                         consumer wave substitutes the Param and re-queries
#                         the engine on the concrete instantiation).
#                         Container layers that decide a property
#                         unconditionally (Vec[T]/Map[..]/Box[T]
#                         requires_drop_glue, Slice[T] bit-copyability,...)
#                         keep those fields concrete — the flag marks the
#                         properties that depend on the unsubstituted
#                         parameter (e.g. Vec[T].is_linear = T.is_linear).
struct TypeProperties
  owns_state: Bool
  requires_drop_glue: Bool
  is_linear: Bool
  is_capability: Bool
  contains_capability: Bool
  is_trivially_copyable: Bool
  is_transferable: Bool
  is_shareable: Bool
  is_deferred: Bool
end

# ———————————————————————————————————————————————————————————————
# LangItems: the well-known intrinsic type/trait ids
# ———————————————————————————————————————————————————————————————
#
# The compiler-recognized intrinsic names and their semantic ids, so
# consumers stop string-selecting builtins (the trait lookups, the Rc
# policy, resource_check's is_non_shareable_type, the smart-pointer
# families, the string/pointer primitives). The
# type fields carry TypeId values; the trait fields carry TraitId values
# (for the transition both are Int). Populated ONCE at env initialization
# after the builtin registrations (build_lang_items — the ids from the
# type_name_index / trait_registry lookups) and REBUILT after pass 2
# (type_check_program_env) so the std-declared names (StrView, UniquePtr,
# ArcStrong, WeakRc, WeakArc, AffineHandle — registered by the std's
# pass-2 type collection) resolve their ids too; a
# rebuild never changes a builtin id
# (the std re-declarations keep the builtin TypeIds). -1 marks a name with
# NO registration at init: Transferable/Shareable are std-declared traits
# whose TraitIds arrive when the std's trait declarations register, and the
# std-declared TYPE names resolve only at the rebuild. The builtin compound
# type names (Option/Result/Vec/Map/Set/Box/Rc/Array/Slice/String/Ptr/
# PtrMut) are the Adt form's special-behavior selector.
struct LangItems
  option: Int
  result: Int
  vec: Int
  map: Int
  set: Int
  box_: Int
  rc: Int
  array: Int
  slice: Int
 # the registered owned-String object type (the property engine's
  # String identity — never a name comparison) and the StrView literal-view
  # type (std-declared; the map-key dispatch's StrView selection).
  string: Int
  str_view: Int
 # the smart-pointer families beyond Box/Rc — the UNIQUE owner
  # (UniquePtr) and the shared handles (ArcStrong/WeakRc/WeakArc), all
  # std-declared. The property engine's smart-pointer arms and the MIR's
  # clone-dispatch select by these ids.
  unique_ptr: Int
  arc_strong: Int
  weak_rc: Int
  weak_arc: Int
 # (concurrency properties — the execution-context-affine native handle): the
  # std-declared AFFINE-HANDLE MARK type ("AffineHandle" — an empty
  # marker struct in std::core that the std's native-handle types
  # (PthreadT / PthreadKeyT — the pthread thread handle and the TLS key)
  # carry as a zero-size field). The concurrency derivation (the
  # transferable/shareable walk) recognizes the mark by THIS id: a value
  # containing the mark holds an execution-context-affine native handle
  # and is NOT Transferable/Shareable unless the containing type
  # explicitly opts in (impl UnsafeTransferable / UnsafeShareable — the
  # documented gate). Resolved at the post-pass-2 rebuild like the other
  # std-declared names; -1 at init (no registration yet — no exclusions).
  affine_handle: Int
 # the raw-pointer type names (Ptr/PtrMut — registered builtins; the
  # property engine's pointer arms select by id, never by name).
  ptr: Int
  ptr_mut: Int
  drop_trait: Int
  clone_trait: Int
  copy_trait: Int
  eq_trait: Int
  hash_trait: Int
  transferable_trait: Int
  shareable_trait: Int
end

# ———————————————————————————————————————————————————————————————
# Type Environment
# ———————————————————————————————————————————————————————————————

struct TypeEnv
  type_list: Vec[TypeDef]              # Single source of truth, insertion order
  type_name_index: Map[String, Int]    # name -> index into type_list
 # (next layer — module-qualified type identity): "path::name" ->
  # type_list index for every type registered from a module path (the
  # resolver's module_symbols DefKind::TypeName entries; see
  # record_module_type_name). Bare first-wins resolution stays in
  # type_name_index; this map is the qualified complement that lets
  # path-qualified references (a::Config) and local-module shadowing
  # resolve to the right TypeId when the same bare name exists in
  # multiple modules. Purely additive for the bootstrap (no cross-module
  # same-name collisions — qualified keys map to the same indices).
  module_type_names: Map[String, Int]
 # (final layer — module-qualified CALLABLE identity): "path::name" ->
  # the Type the checker bound for that qualified function/const/static
  # definition, mirrored at pass-3 registration guarded by the resolver's
  # module_symbols DefKind entry (see record_module_callable), plus the
  # bare-name FIRST registration's Type as the recoverable first-wins
  # fallback for ambiguous bare callable references (mirrors the resolver's
  # bare-name first-wins tables). Purely additive for the bootstrap: the
  # kernel's module_symbols holds at most one qualified entry per bare
  # callable name, so the >= 2 DISTINCT definition ambiguity check never
  # fires (see resolve_bare_callable).
  module_callable_types: Map[String, Type]
  callable_first_wins: Map[String, Type]
  type_id_index: Map[Int, Int]         # TypeId.id -> index into type_list
  type_id_counter: Int
  # TypeId.id -> the declaration's LAYOUT attributes (@repr(C) / @align(N)
  # / @packed — the layout-relevant subset of the item attributes),
  # validated and recorded at collect_type_def / collect_enum_type_def.
  # The TypedProgram serializes this table (type_layout_attrs) and the MIR
  # carries it into the MirTypeDefs the layout engine reads — the typed
  # records are the attribute authority end-to-end.
  layout_attrs: Map[Int, LayoutAttrs]
  wcet_bounds: Map[String, Int]
  
  # Type variable substitution
  subst: Map[TypeVarId, Type]
  var_counter: Int
  
  # Scoped bindings
  scopes: Vec[Map[String, Type]]
  
  check_ctx: String
 # (next layer): the module path of the item currently being
  # processed (owner Module path from Program.crate, threaded per
  # item in type_check_program_env — see module_path_of_item). Consumed by
  # resolve_bare_type_name for local-module shadowing and ambiguity
  # verification; empty for the root module and for permissive recovery
  # (type_check / type_check_strict run without resolutions, in which case
  # module_type_names stays empty and behavior is unchanged).
  current_module_path: Vec[String]
 # (recovery separation): strict vs permissive resolution. Compilation —
  # any entry that produces a TypedProgram for MIR/codegen — ALWAYS forces
  # this true (type_check_typed sets it unconditionally, as do the
  # compiler_core.tg invocation sites). The permissive mode exists only for
  # editor recovery through type_check / type_check_strict, which return
  # errors alone and never produce a codegenable TypedProgram. If a real
  # compilation ever runs with strict_resolution = false, that is an
  # internal error: the compilation path forces it on, so the permissive
  # behavior is unreachable from compilation.
  strict_resolution: Bool
 # the declared return type of the function/method whose body is being
  # checked. `return` statements unify against it unconditionally (set in
  # check_function/check_impl around the body check, cleared afterwards).
  expected_return: Option[Type]
  
 # per pattern node id — the BindingPlans collected while checking the
  # pattern (each plan describes one bound identifier's action on its source
  # place). Consumed by the block/match/for checking paths.
  binding_plans: Map[Int, Vec[BindingPlan]]
 # (partial moves — place-level state): root semantic LocalId -> joined
  # field path -> the per-place move state. A path recorded Consumed means
  # the value at that projected place was MOVED OUT (extracted) while the
  # root stays live — the frame's per-field states for the projected
  # places. Recorded by record_place_moves at the pattern-binding sites
  # (let-initializers with Consume BindingPlans over projected source
  # places); serialized into TypedProgram.place_move_states and consumed by
  # the MIR's drop sites (the partial-drop chain) and by the resource
 # checker's projected-move rules (the next-wave consumer — the note
  # in check_pattern documents the projected-move rules' pending
   # consumption of the per-binding actions).
  # (snapshot-env completeness): the field carries a DEFAULT like
  # MirProgram's engine tables, so the engine-snapshot TypeEnv literals
  # (resource_check.tg's engine_env_empty — built BEFORE this table was
  # added) stay legal: an omitted field falls back to the empty map, which
  # is exactly the state the snapshot env needs (the engine reads this
  # table on the checker env only, never on the snapshot).
  place_move_states: Map[Int, Map[String, PlaceMoveState]] = Map::new()
 # (literal-range authority): per literal node id — the literal's
  # lossless form, the range TARGET (the suffix's concrete type, or Int for
  # the inferred default), and the NEGATION COUNT (each enclosing unary
  # minus the parser wraps around the literal — the folded sign decides the
  # exact signed range). The RANGE DECISION is made here, at the
  # end-of-check pass (resolve_pending_literal_ranges): only the checker
  # decides whether the literal fits its target type, the overflow is ONE
  # stable diagnostic, and a literal never silently becomes 0.
  pending_literal_ranges: Map[Int, PendingLiteralRange] = Map::new()
  # per pattern node id — the resolved variant identity (owner TypeId
  # id, variant index) for enum-variant patterns, threaded from the pattern
  # checker so downstream consumers resolve variants by identity, not name.
  pattern_variant_resolutions: Map[Int, (Int, Int)]
  
  # Trait implementations
  impls: Vec[ImplInfo]
  method_lookup: Map[Int, Map[String, Vec[Int]]]  # receiver TypeId -> method name -> impl indices
 # (impl conformance — validate-first-register-second): TraitId -> the
  # trait's declared CONTRACT (the resolved method signatures, the
  # trait-level generic parameter ids, the associated type names).
  # Populated at the trait registration sites — register_builtin_trait
  # (the builtin shapes) and collect_type_def's ItemTrait arm (the source
  # declarations, which overwrite the builtin entry when the re-declared
  # trait keeps the builtin id) — and consumed by check_impl's
  # validate_impl_conformance BEFORE an impl enters env.impls: an impl
  # that does not satisfy the declared method set is never admitted to
  # the solver's candidate set, even transiently.
  trait_contracts: Map[Int, TraitContract]

 # (module-semantic trait identity): the bare-name trait registry —
  # trait name -> TraitId — NO LONGER the semantic authority. The TraitId
  # of a trait is its DECLARATION identity: the resolver registers every
  # trait declaration with DefKind::Trait under its module-qualified
  # "path::name" key (module_symbols), the checker mirrors those entries
  # into the module-qualified map (module_type_names — traits participate
  # in record_module_type_name), and the TraitId is the trait TypeDef's id
  # (the declaration identity — the TraitId reuses the trait declaration's
  # TypeId value for the transition). trait_id_for resolves a name through
  # the module-qualified map FIRST (the current module's own declaration
  # shadows; >= 2 DISTINCT foreign declarations are ambiguous), with this
  # bare first-wins registry as the compatibility FALLBACK (builtin traits
  # register here at env initialization — they have no resolver
  # declaration — and the first source declaration of each name keeps the
  # entry; a std re-declaration of a builtin trait re-registers the
  # builtin id). Display/diagnostics only beyond that.
  trait_registry: Map[String, Int]
 # the well-known intrinsic type/trait ids —
  # built once at env initialization after the builtin registrations
  # (build_lang_items; -1 marks a name unregistered at init) and REBUILT
  # after pass 2 (type_check_program_env) so the std-declared names
  # (StrView/UniquePtr/ArcStrong/WeakRc/WeakArc) resolve their ids; the
  # rebuilt table is serialized into TypedProgram.lang_items.
  lang_items: LangItems
 # (FixedArray const sizes): module-qualified const key -> the
  # EVALUATED integer value of an Int-typed `const` declaration. Collected
  # by the pass-2.5 const-value pass (type_check_program_env) and consumed
  # by the [T; N] annotation's size evaluator (eval_const_size_expr) so a
  # const reference (and constant arithmetic over consts/literals) resolves
  # to its value before FixedArray(Type, N) identity forms.
  const_values: Map[String, Int]

 # indices into env.impls whose for_type is a Type::Param — the
  # EXTENSION impls (`impl[T, I: Iterator[T]] I`). They have no receiver
  # TypeId, so method_lookup cannot index them; method resolution searches
  # them by method name after the direct lookup misses, unifying the impl's
  # head parameter with the concrete receiver.
  param_for_type_impls: Vec[Int]
 # per generic-parameter trait bounds — param numeric GenericParamId
  # -> the bound trait's id and resolved type arguments. Registered when a
  # generic function's/impl's parameters enter scope (inline
  # generic-parameter bounds plus the enclosing where-clause); consulted by
  # resolve_method_type for bare Type::Param receivers inside generic bodies
  # (`self.inner.advance()` on inner: I with `I: Iterator[T]` resolves
  # through this bound). Keyed by the param's identity (numeric
  # GenericParamId) — two same-named parameters of different declarations
  # never collide. Entries persist for the whole check — they are only
  # consulted for Param receivers, which exist only inside the generic body
  # whose registration is current.
  param_bounds: Map[Int, Vec[ParamTraitBound]]
 # call expr node id -> (the callee's generic-parameter ids in the
  # MIR signature-walk order, the corresponding inference variables, the
  # call's span for diagnostics). A generic call whose substitution is
  # not fully solved AT the call site (e.g. a return-type-only parameter
  # solved only by the caller's annotation, which unifies AFTER the call is
  # checked) is parked here and re-resolved after the whole program is
  # checked, when the caller-context unifications have landed
  # (resolve_pending_call_instances in type_check_typed).
  # ZERO-INFERENCE: a call a context never solves is a hard error at the
  # end of checking ("cannot infer type parameter `T`: add an annotation")
  # — the monomorphizer performs no call-site inference (fail-closed).
 # the id list carries GenericParamIds (the param-name table
  # renders the diagnostics).
  pending_call_instances: Map[Int, (Vec[GenericParamId], Vec[Type], Span)]
  
 # DOCUMENTATION MIRROR of the std's concurrency exclusions
  # ("Rc" for Transferable; "Rc"/"Cell"/"RefCell"/"UnsafeCell" for
  # Shareable). The classification (is_send / is_sync) consults the
  # OBLIGATION SOLVER (the std's `trait Transferable` / `trait Shareable`
  # impls) and falls back to a structural field walk — these sets are NO
  # LONGER READ in the decision path; they exist to document the std's
  # exclusions and to keep the registration site a single source of truth
  # for the names.
  non_send_types: Set[String]
  non_sync_types: Set[String]
  
  # Diagnostics
  errors: Vec[TypeError]
  warnings: Vec[TypeError]
  typed_expr_types: Map[Int, Type]
  local_id_counter: Int
  local_ids: Vec[Map[String, Int]]
  resolutions: Option[ResolvedNames]
  typed_call_targets: Map[Int, DefId]
 # (final): call expr node id -> the type checker's SOLVED generic
  # substitution for a generic call (the callee's generic args in the
  # callee's parameter order). Populated at the generic-call sites ONLY
  # when the callee is generic and EVERY generic parameter is solved; an
  # unsolved parameter (e.g. a return-type-only parameter the caller
  # context never constrained) leaves the call unrecorded and is reported
  # by resolve_pending_call_instances. The solved substitutions from the
  # type checker are the AUTHORITY — ZERO-INFERENCE: the monomorphizer
  # performs no call-site inference (fail-closed). MIR pairs this with
  # typed_call_targets to fill the call instance's substs.
  typed_call_instances: Map[Int, Vec[Type]]
  typed_field_targets: Map[Int, FieldId]
  typed_local_bindings: Map[Int, LocalBinding]
  typed_ident_resolutions: Map[Int, Int]
  # Two SEPARATE binding-resolution maps: parameters and pattern bindings are
  # keyed in entirely different domains (owner DefId + positional index vs
  # pattern node id). Keeping them in one map allowed a parameter key to
  # numerically collide with a pattern node id, letting a later pattern
  # overwrite a parameter's mapping and corrupting resource/access analysis
  # of the wrong local. The parameter owner key is the function/method's
  # DefId rendered by fn_owner_key — NOT a span offset, which would collide
  # across files merged into one compilation.
  param_binding_resolutions: Map[String, Vec[Int]]
  pattern_binding_resolutions: Map[Int, Int]
  typed_access_effects: Map[Int, AccessEffect]
 # (, phase 2): per expression node id — the typed
  # HIR node recorded by the checker ALONGSIDE the flat maps above (the
  # maps remain the DERIVED INDEXES over the tree for the consumers that
  # have not migrated to the tree; the node and the maps are recorded in
  # lockstep and can never diverge). The node forms are RECURSIVE: every
  # kind carries its typed children (per-variant), so the MIR reads the
  # call target, the receiver/argument effects, the field identity and the
  # variant identity from the tree.
  typed_exprs: Map[Int, TypedExpr]
 # (phase 2): per statement node id — the typed statement record
  # (TypedStmt), assembled at check_stmt's tail from the recorded children
  # (the tree's composite expression kinds carry their blocks' TypedStmt
  # children). The record is the checker-side statement tree; the MIR
  # consumes the expression tree and lowers statements from the AST (the
  # per-statement record is the tree's statement spine).
  typed_stmts: Map[Int, TypedStmt]
 # (phase 2): per pattern node id — the typed pattern record
  # (TypedPattern), assembled at check_pattern's tail (the Closure /
  # Match / Let tree forms carry these records).
  typed_patterns: Map[Int, TypedPattern]
  typed_aggregate_ownership: Map[Int, Vec[Bool]]
  closure_captures: Map[Int, Map[Int, AccessEffect]]
  access_marker_depth: Int
 # the generic-parameter interning table — the declaration-order
  # authority (the GenericParamId index IS the declaration position) and
  # the param-name table (diagnostics look up names by id). Every
  # declaration interns its generic parameters in declaration order at
  # registration (pass 2 for type declarations, pass 3 for functions and
  # extern functions, check_impl for impl-level and method-level
  # parameters); body-checking passes reconstruct the same ids from the
  # owner DefId + declaration index and never re-intern.
  generic_param_table: GenericParamTable
 # fn owner key (the same key as param_binding_resolutions — the
  # function's DefId render or the positional fallback) -> the generic
  # parameter ids of that function/method in the MIR's merged declaration
  # order (impl-level params first, then method-level params — the order
  # the MIR builder pairs with the renamed declaration's merged generic
  # list). The MIR reconstruction of Type::Param ids reads this record.
  generic_param_ids: Map[String, Vec[GenericParamId]]
 # fn owner key -> the checker's RESOLVED declaration signature (the
  # parameter ParamTypes — base types plus conventions — and the resolved
  # return type). Recorded at the checker's signature-computation sites
  # (check_function under the item owner key, check_impl's signature pass
  # under the method owner key, pass-3 extern functions under the
  # module-qualified fn key) and serialized into
  # TypedProgram.typed_fn_signatures. The MIR reads every declaration type
  #   from this table — TypeExpr is never interpreted after checking.
  # (snapshot-env completeness): defaulted like place_move_states — the
  # engine-snapshot TypeEnv literals (engine_env_empty) legitimately omit
  # this table (the engine never reads it), and the default keeps the
  # snapshot env's literal legal under the struct-literal required-field
  # rule (the MirProgram defaulted-fields pattern).
  typed_fn_signatures: Map[String, FnSignature] = Map::new()
 # the declared effect sets of the function/method declarations —
  # keyed by the def-key (fn_effect_def_key — the DefId render
  # "def::<module id>::<index>::<kind>", the key BOTH the registration
  # sites and the call-site lookups derive from the SAME DefId without
  # Program access). Registered at check_function / check_impl's signature
  # pass from the parsed `effect[...]` annotation names (interned through
  # the EffectRegistry; the std effectful-function seeds fill the
  # un-annotated std functions). The computed-set table
  # (fn_computed_effects) is the per-function union of the callees'
  # declared effects, accumulated at the call-recording sites and closed
  # transitively over the recorded call graph (fn_call_graph) by
  # check_effect_sets; the end-of-check compare of computed vs declared is
  # THE transitive effect discipline (the source-text analyzer in
  # std::effects is tooling, never the semantics).
  fn_declared_effects: Map[String, Vec[EffectId]] = Map::new()
  fn_computed_effects: Map[String, Vec[EffectId]] = Map::new()
  fn_call_graph: Map[String, Vec[String]] = Map::new()
  fn_declared_effect_names: Map[String, String] = Map::new()
  fn_declared_effect_spans: Map[String, Span] = Map::new()
 # def-key -> the declaration's owner module path at registration.
  # The compare pass exempts the std module's own functions from the
  # violation/lint diagnostics: the std's DECLARED effects are its API
  # contract for user callers (the seeds the transitive checking
  # propagates), and the std implementation is the trusted base — its
  # internal calls are the implementation of those declared effects,
  # never checked against its own declarations.
  fn_effect_modules: Map[String, Vec[String]] = Map::new()
  # ———————————————————————————————————————————————
  # the algebraic-effects typed records
  # ———————————————————————————————————————————————
  # EffectId.id -> the typed effect declaration (the resolved op-signature
  # table the perform surface and the handler arms are checked against).
  # Registered at the ItemEffectDecl site: the declared effect interns its
  # module-qualified EffectId and its ops resolve through resolve_type_expr
  # (TypeExpr is never interpreted after checking).
  typed_effects: Map[Int, TypedEffectDecl] = Map::new()
  # The qualified effect-name index: module-qualified key ("path::name" —
  # the root module's effects under the bare name, the SAME key domain the
  # EffectRegistry interns) -> EffectId.id. The perform surface's op
  # reference (EFFECT.op) resolves through this index.
  effect_name_index: Map[String, Int] = Map::new()
  # handle-with statement node id -> the typed handler records (per handler
  # in source order: the resolved EffectId, the op index per arm and the
  # arm's resolved body type). Assembled at the StmtHandleWith check arm;
  # consumed by the typed-tree assembly (typed_stmt_for) and serialized for
  # the MIR's handler lowering.
  typed_effect_handlers: Map[Int, Vec[TypedHandler]] = Map::new()
  # handle-with statement node id -> per-handler capture records (handler
  # index -> captured local id -> effect): the union of the handler's arm
  # bodies' free-variable scans — the semantic capture record the MIR's
  # handler-env construction reads (the SAME capture discipline as
  # closure_captures).
  handler_captures: Map[Int, Vec[Map[Int, AccessEffect]]] = Map::new()
  # The lexically-enclosing effect-handler stack (EffectId ids, outermost
  # first) — the bounded neutralization rule: a perform lexically inside a
  # handle/with block for the same effect is HANDLED, so the performed
  # effect does not accumulate into the ENCLOSING function's computed set
  # (the handler neutralizes it; a perform in a CALLED function still
  # accumulates into the callee's own computed set — each function declares
  # its own discipline).
  handler_stack: Vec[Int] = Vec::new()
  # ———————————————————————————————————————————————
 # the def-key of the function/method whose body is being checked —
  # the call-recording sites accumulate into its computed set. "" outside
  # any function body (const/static initializers record no edges).
  current_fn_key: String = ""
 # the closure node whose body is being checked — the call-recording
  # sites ALSO accumulate into the closure's own computed effect set
  # (closure_computed_effects), the effect set the closure TYPE carries
  # (Type::Closure's 5th payload): an indirect call through a closure
  # value records the closure body's effects at the call site. 0 outside
  # a closure body; nested closures save/restore it (the innermost
  # closure's body records into its own set).
  current_closure_node: Int = 0
 # closure expression node id -> the closure body's computed effect set
  # (the union of the effectful direct calls its body performs — the
  # same callee-declared effects record_effect_call accumulates into the
  # enclosing function, recorded per closure at the same site). Read at
  # the closure's type-construction site (the ExprClosure arm) to seed
  # the Type::Closure effect payload.
  closure_computed_effects: Map[Int, Vec[EffectId]] = Map::new()
 # module-qualified key ("path::name" — module_qualified_key) -> the
  # checker's resolved declared type of a static / const / extern-static
  # declaration. Recorded in pass 3 (the same registration pass that binds
  # the names) and serialized into TypedProgram.typed_static_types; the MIR
  #   reads the declared static/const types from this table.
  # (snapshot-env completeness): defaulted like place_move_states — the
  # engine-snapshot TypeEnv literals (engine_env_empty) legitimately omit
  # this table (the engine never reads it), and the default keeps the
  # snapshot env's literal legal under the struct-literal required-field
  # rule (the MirProgram defaulted-fields pattern).
  typed_static_types: Map[String, Type] = Map::new()
 # Type-property engine memoization: canonical structural type key
  # (see type_identity_key_resolved — includes concrete generic args, so
  # Wrapper[Int] and Wrapper[File] are distinct entries) -> computed
  # properties. Populated lazily by type_properties_of.
  type_prop_cache: Map[String, TypeProperties]
 # (EffectId domain): the effect interning registry — the builtin
  # effects registered with their FIXED ids at construction, user effects
  # interned module-qualified at declaration/use. The canonical type
  # identity renders the canonical ordered effect-ID set from this
  # registry (type_identity_key_resolved's Effect arm); the public ABI
  # renders effect NAMES (the registry's id -> name table) in the same
  # canonical order.
  effects: EffectRegistry
 # (IntrinsicId at check time): call expr node id -> the semantic
  # IntrinsicId the checker attaches at call-recording time (the
  # intrinsic calls — the resolver registered their __intrinsic_* DefIds
  # with DefKind::Intrinsic, and the collection method calls classify
  # through the same semantic router). Serialized into the resolutions
  # snapshot (ResolvedNames.intrinsic_ids) at type_check_typed's tail —
  # the typed program carries the classification per call for the
  # MIR/codegen consumers.
  typed_intrinsics: Map[Int, IntrinsicId]
end

# (module-semantic trait identity): the TraitId domain — the semantic
# identity of a trait DECLARATION (the nominal identity is the declaration,
# mirroring the TypeDefId = DefId model of the type side). TraitId itself
# lives in ids.tg (the central semantic-identity domains); for the
# transition the TraitId reuses the trait declaration's TypeId value (the
# trait's TypeDef in type_list carries the same id — the declaration
# identity). The TraitId of a source trait is anchored by the resolver's
# declaration table: the DefKind::Trait module_symbols entry for the
# (module path, name) pair the checker mirrors into module_type_names at
# trait-registration time (record_module_type_name's Trait guard), so a
# distinct declaration in a DIFFERENT module gets its own module-local
# TypeId — and therefore its own TraitId — exactly like structs/enums.
# TraitId(-1) is the sentinel for "no registered trait under this name" (a
# not-yet-registered or unknown trait: obligations carrying it can never
# match a registered impl).

# A normalized generic obligation: the impl generic parameter `subject` — a
# Type::Param whose GenericParamId is the binding where the obligation
# ORIGINATES (there is no positional param_index into a separately
# reconstructed vector) — must satisfy the trait identified by `trait_id`
# for the impl to apply to a concrete instantiation. `args` carries the
# bound trait's RESOLVED type arguments (Type::Param forms of the impl's
# generic scope, e.g. the T of `I: Iterator[T]` in `impl[T, U, I:
# Iterator[T]]...`). Registered from the AST ImplDecl once; the solver
# instantiates the subject and the args with the candidate's substitution
# and solves the resulting concrete obligation — it never jumps back to
# the AST. `trait_name` is retained ONLY for diagnostics (the solver
# matches by id).
struct GenericObligation
  subject: Type         # Type::Param(GenericParamId) — the substituted subject
  trait_id: TraitId
  trait_name: String    # diagnostics only
  args: Vec[Type]       # the bound trait's resolved arguments
end

# one trait bound of a generic parameter (an inline generic-parameter
# bound or a where-clause predicate, e.g. the `Iterator[T]` of
# `impl[T, U, I: Iterator[T]] Iterator[U] for MapIter[T, U, I]`): the bound
# trait's name and its RESOLVED type arguments (the T of `I: Iterator[T]`
# resolves to Type::Param("T") of the enclosing generic scope — the
# substitution target for trait-impl head unification on a bare Param
# receiver).
struct ParamTraitBound
  trait_id: TraitId
  trait_name: String   # diagnostics only
  args: Vec[Type]
end

# The full trait reference an obligation is stated against: the trait
# identity, the self type, and the trait-level type arguments (e.g. the T
# of `Iterator[T]`). The FULL TraitRef participates in the solver's
# cycle-detection key AND in candidate matching: a candidate impl must
# unify its own trait arguments against the obligation's `args` — two
# impls with the same self type but different trait arguments (`From[A]`
# vs `From[B]`, `Into[Out]`, `Iterator[Item = X]` vs
# `Iterator[Item = Y]`) are distinguished. `trait_name` on the enclosing
# Obligation is retained ONLY for diagnostics (the solver matches by id).
struct TraitRef
  trait_id: TraitId
  self_ty: Type
  args: Vec[Type]
end

# (authoritative impl trait arguments): the impl's DECLARED trait
# reference — the trait's identity and its type arguments exactly as the
# impl declaration states them (the `Iterator[(K, V)]` of `impl[K, V]
# Iterator[(K, V)] for MapIterator[K, V]`). Captured ONCE from the AST at
# registration (check_impl) into ImplInfo.trait_ref; the solver never
# re-derives it. The args are the trait's type arguments in the impl's
# generic scope, RESOLVED to their Type::Param forms in the impl's
# DECLARATION ORDER — the parser's own derivation (the impl's generic
# parameters come from the trait's type arguments in the `impl Iterator[T]
# for Type` form; the leading-generics form declares the same parameters
# explicitly). The solver instantiates these EXACT arguments with the
# candidate's fresh variables (subst_type_args over ImplInfo.generic_params)
# and unifies them against the obligation's args: an arity mismatch between
# the impl's declaration and the obligation is a unification failure — the
# head-only degradation is are not part of the model.
struct TraitRefTemplate
  trait_id: TraitId
  args: Vec[Type]
end

# A concrete obligation to be solved: the substituted subject
# `trait_ref.self_ty` must implement the trait identified by
# `trait_ref.trait_id` with the trait-level arguments `trait_ref.args`.
struct Obligation
  trait_ref: TraitRef
  trait_name: String   # diagnostics only
end

struct ImplInfo
  trait_id: TraitId    # TraitId(-1) for inherent impls (no trait)
  trait_name: String   # diagnostics only ("" / "_" for inherent impls)
  for_type: Type
  obligations: Vec[GenericObligation]
  methods: Vec[MethodInfo]
 # the impl's FULL generic-parameter ids in declaration order —
  # including parameters that never appear in the for_type (e.g. the T of
  # `impl[T, I: Iterator[T]] I`, whose for_type mentions only I). The
  # extension-impl solver instantiates every one of them.
 # GenericParamIds (declaration order == id index); names are in
  # the param-name table (diagnostics only).
  generic_params: Vec[GenericParamId]
  # The method DefIds are NOT recorded per-impl — the
  # bare-keyed method table is are not part of the model; a call site
  # resolves a method's DefId through the SEMANTIC registration
  # (module_symbols' qualified "path::Type::method" entries — see
  # method_def_for / qualified_method_def).
 # (authoritative impl trait arguments): the impl's DECLARED trait
  # reference — the trait identity and its type arguments DIRECTLY from the
  # AST's impl declaration (check_impl) — the EXCLUSIVE authority for
  # candidate trait-argument matching. The solver instantiates these exact
  # arguments with the candidate's substitution and unifies them against
  # the obligation's args; it never approximates them from the impl's
  # generic-parameter count, and a trait-arg arity mismatch with the
  # obligation is a unification failure, never a head-only fallback.
  trait_ref: TraitRefTemplate
end

struct MethodInfo
  name: String
  ret_type: Type
  params: Vec[ParamType]
  # whether the method's first parameter is the receiver `self` (the
  # param NAME is available at registration - the AST's `p.name ==
  # "self"` check - but ParamType carries no name; the flag preserves
  # the receiver detection for the arity/alignment rules).
  has_self: Bool
 # method-level generic parameter ids in declaration order (e.g.,
  # ["U"] for cast[U] — the ids, not the names; the param-name table holds
  # the display names).
  generic_params: Vec[GenericParamId]
end

# ———————————————————————————————————————————————————————————————
# Impl conformance — the trait CONTRACT (validate-first-register-second)
# ———————————————————————————————————————————————————————————————
#
# The declared contract of ONE trait method: the resolved signature, the
# method-level generic parameter names and their bound trait names in
# declaration order, the default-body flag, and the DECLARED EFFECT SET
# (the std effectful-function seeds by the trait's module-qualified
# identity — the impl must not require effects beyond what the trait
# declares). `has_receiver` says the trait method takes `self`;
# `receiver_in_params` says the recorded `params` include that receiver
# position (TRUE for source declarations — the resolved `self: Self`
# parameter is recorded; FALSE for the builtin registration stubs, whose
# receiver-less MethodSig payloads get a synthetic wildcard receiver at
# validation).
struct TraitMethodContract
  name: String
  params: Vec[ParamType]
  ret_type: Type
  has_receiver: Bool
  receiver_in_params: Bool
  has_default: Bool
  generic_param_names: Vec[String]
  generic_param_bounds: Vec[Vec[String]]
  declared_effects: Vec[EffectId]
end

# The full declared contract of ONE trait — the trait-level generic
# parameter ids in declaration order (substituted positionally against the
# impl's declared trait arguments — the FULL TraitRef, never the head),
# the associated type names, and the method contracts. The BUILTIN
# contracts additionally record the implicit receiver parameter ids
# (named "Self" — substituted with the impl's self type) and the
# associated-type parameter ids (named "Item" — substituted with the
# impl's associated types); source contracts carry neither (their "Self"
# references resolve to inference variables and their associated-type
# references are the auto-registered "Self::<Assoc>" opaque Adts).
# Keyed in env.trait_contracts by the TraitId (the declaration identity —
# the SAME id trait_id_for resolves for the impl side, so two same-named
# traits in different modules validate against their own declarations).
struct TraitContract
  generic_params: Vec[GenericParamId]
  self_param_ids: Vec[GenericParamId]
  assoc_types: Vec[String]
  assoc_param_ids: Vec[GenericParamId]
  methods: Vec[TraitMethodContract]
end

struct TypeError
  message: String
  span: Span
  code: Option[String]
end

# The pending literal-range record: the lossless literal form, the range
# target type (the suffix's concrete type, or Int when unsuffixed), the
# literal's span, and the negation count folded from the enclosing unary
# minus chain (an ODD count flips the sign).
struct PendingLiteralRange
  lit: ParsedIntegerLiteral
  target_ty: Type
  span: Span
  neg_count: Int
end

enum AccessEffect
  Read
  Modify
  Consume
  Initialize
end

# ———————————————————————————————————————————————————————————————
# Control-Flow Result 
# ———————————————————————————————————————————————————————————————
#
# The flow summary of a checked block/statement: the type of the value it
# produces when it FALLS THROUGH normally (Never when it provably cannot
# fall through), plus which divergence edges are reachable. Threaded through
# statement/block checking so loops, value-if's and matches can distinguish
# "may terminate" from "diverges", and so unreachable tails stop
# contributing to a block's value/flow.
struct FlowResult
  normal: Type
  may_return: Bool
  may_break: Bool
  may_continue: Bool
  may_throw: Bool
end

# A construct that always falls through normally (no divergence edge).
def flow_normal(ty: Type) -> FlowResult
  FlowResult {
    normal: ty,
    may_return: false,
    may_break: false,
    may_continue: false,
    may_throw: false
  }
end

# A construct that never falls through normally (a terminator): the normal
# type is Never and the flags say which divergence edges are reachable.
def flow_terminator(may_return: Bool, may_break: Bool, may_continue: Bool, may_throw: Bool) -> FlowResult
  FlowResult {
    normal: Type::Never,
    may_return: may_return,
    may_break: may_break,
    may_continue: may_continue,
    may_throw: may_throw
  }
end

struct LocalBinding
  name: String
  ty: Type
end

# ———————————————————————————————————————————————————————————————
# Pattern Binding Plans 
# ———————————————————————————————————————————————————————————————
#
# Pattern typing is an OWNERSHIP operation: every identifier a pattern binds
# reads or moves its value out of the source place. For every pattern
# binding the checker records a BindingPlan: the bound local id, the
# SEMANTIC source place, and the binding action (Read for a plain
# binding of a copyable value, Consume for a binding that MOVES an owning
# value out of its source). check_pattern collects the entries; the
# block/match/for checking paths consume them so the resource checker's
# existing projected-move rules (whole-aggregate consumption for match
# scrutinees, projected-place rejection for let-initializers) have the
# per-binding action data.
# (defect fix): source_place is a proper TypedPlace — the semantic
# AccessRoot domain (ids.tg) + typed projections — NEVER a description
# string. The checker's call sites derive the place from the source
# expression's typed place (binding_source_place; the RawUnknown fallback
# keeps the description only as the diagnostics root_name). The resource
# checker's binding machinery (resource_check.tg — bind_pattern /
# bind_pattern_ident and the projected-move rules that will consume the
# per-binding actions) is the next-wave consumer of the semantic place.
struct BindingPlan
  local: Int             # semantic local id of the bound identifier
  source_place: TypedPlace  # the semantic source place of the binding
  action: AccessEffect   # Read (plain binding) or Consume (moving binding)
end

# (partial moves — place-level state): the per-place move state of the
# frame's projected places. Live = the place holds a valid value; Consumed
# = the value was moved out (extracted) — the root stays Live but the drop
# must skip the consumed place (the partial-drop conditioning).
enum PlaceMoveState
  Live
  Consumed
end

# (partial moves — the SEMANTIC projection identity): ONE segment of a
# place's projection chain, built from the typed place of an access (the
# checker's typed_place_of / typed_field_targets records — the FieldId/
# VariantId the typed HIR carries). The chain is the SEMANTIC key of the
# per-field move state: the frame's resource lattice (resource_check.tg —
# Map[LocalId, Map[ProjectionChain, ResourceState]]) and the recording
# sites (record_place_moves / record_projected_consume / the assign-site
# records) are keyed by these identities, NEVER by string-shaped paths.
# The string paths the MIR's partial-drop chain consumes
# (mir_emit_partial_drop_chain splits the "."-joined declaration-order
# field names) are the SERIALIZED rendering of a chain — produced at the
# recording boundary by place_move_path_of (FieldId -> the owner's
# declaration-order field name — the same authority mir_partial_field_shape
# reads) and never re-derived from source spellings.
enum ProjectionKey
  Field(FieldId)       # a field access — the strong field identity
  Variant(VariantId)   # an enum downcast projection (whole-value lattice)
  TupleIndex(Int)      # a tuple-index access (no FieldId exists)
  Index(Int)           # a CONSTANT index projection — per-index lattice
                       # (the fixed-array elements; a dynamic index stays
                       # the whole-value lattice)
end

# (partial moves): the chain as a MAP KEY — the std Map requires the
# concrete Hash/Eq instances of its key type, so the chain wraps its key
# list in a struct carrying the user-defined impls (the same dispatch
# contract the std's collections declare: the map hashes/compares through
# the CONCRETE impl instances).
struct ProjectionChain
  keys: Vec[ProjectionKey]
end

def projection_key_eq(a: ProjectionKey, b: ProjectionKey) -> Bool
  match (a, b)
  when (ProjectionKey::Field(fa), ProjectionKey::Field(fb)) then fa.owner.id == fb.owner.id && fa.index == fb.index
  when (ProjectionKey::Variant(va), ProjectionKey::Variant(vb)) then va.owner.id == vb.owner.id && va.index == vb.index
  when (ProjectionKey::TupleIndex(ta), ProjectionKey::TupleIndex(tb)) then ta == tb
  when (ProjectionKey::Index(ia), ProjectionKey::Index(ib)) then ia == ib
  when _ then false
  end  end
end

def projection_key_hash(k: ProjectionKey) -> Int
  match k
  when ProjectionKey::Field(f) then f.owner.id * 31 + f.index
  when ProjectionKey::Variant(v) then 1000000 + v.owner.id * 31 + v.index
  when ProjectionKey::TupleIndex(t) then 2000000 + t
  when ProjectionKey::Index(i) then 3000000 + i
  end  end
end

impl Eq for ProjectionChain
  def eq(self: Self, other: Self) -> Bool
    if self.keys.len() != other.keys.len() then return false end
    var i = 0
    while i < self.keys.len() do
      if !projection_key_eq(&self.keys[i], &other.keys[i]) then return false end
      i = i + 1
    end
    true
  end
end

impl Hash for ProjectionChain
  def hash(self: Self) -> Int
    var h = 0
    var i = 0
    while i < self.keys.len() do
      h = h * 31 + projection_key_hash(&self.keys[i])
      i = i + 1
    end
    h
  end
end

# (partial moves): build a ProjectionChain from a key list (the frame's
# lattice keys are the SEMANTIC chains).
def projection_chain_of(keys: Vec[ProjectionKey]) -> ProjectionChain
  ProjectionChain { keys: keys.clone() }
end

# (partial moves — the recording boundary): render a SEMANTIC chain as the
# serialized path the MIR's partial-drop chain consumes — the "."-joined
# declaration-order field names (struct field names; tuple positions as
# "t<i>"). The names resolve through the FieldId's OWNER declaration
# (get_type_by_id_ref — the same declaration-order authority
# mir_partial_field_shape reads from typed_type_fields), so the serialized
# key is derived from the semantic identity, never from a source spelling.
def place_move_path_of(env: TypeEnv, chain: Vec[ProjectionKey]) -> String
  var segs = Vec::new()
  for k in chain do
    match k
    when ProjectionKey::Field(fid) then
      var fname = ""
      match get_type_by_id_ref(env, &fid.owner)
      when Option::Some(td) then
        match td.def_kind
        when TypeDefKind::Struct(fields) then
          if fid.index >= 0 && fid.index < fields.len() then
            fname = fields[fid.index].name.clone()
          end
        when _ then ()
        end
      when Option::None then ()
      end
      if fname.len() == 0 then
        fname = "f" + fid.index.to_string()
      end
      segs.push(fname)
    when ProjectionKey::Variant(_) then ()
    when ProjectionKey::TupleIndex(ti) then segs.push("t" + ti.to_string())
    when ProjectionKey::Index(i) then segs.push(i.to_string())
    end
  end
  segs.join(".")
end

# (partial moves — the record site): mark the projected place of `expr`
# Consumed under its local root. The semantic chain is derived from the
# expression's typed place (typed_place_of — the FieldId/TupleIndex
# projections); a chain through a non-field projection (variant/index/
# deref) records the root's whole value "*" (the bounded lattice: enum
# payload and index moves are whole-value). The OWNING gate mirrors the
# resource checker's transfer_consume (expr_type_has_resource — an
# owning-typed projection is the partial-move hazard; a Copy-typed
# projection is a plain read and must never record). Called at the
# checker's transfer_consume mirror sites (call-argument effects,
# aggregate-literal children, enum-variant payloads, assignment values,
# return/break values, the function tail) — the SAME sites the resource
# checker's per-field lattice marks Consumed, so the serialized registry
# and the frame lattice agree for every program that passes resource
# checking.
def record_projected_consume(inout env: TypeEnv, expr: Expr) -> Unit
  match env.typed_expr_types.get(expr.node_id)
  when Option::Some(ety) then
    let props = type_properties_of(env, ety)
    if props.owns_state || props.is_linear then
      match typed_place_of(env, expr)
      when Option::Some(tp) then
        match tp.root
        when AccessRoot::Local(lid) then
          if tp.projections.len() > 0 then
            var keys = Vec::new()
            var whole = false
            for proj in tp.projections do
              match proj
              when TypedPlaceProj::Field(fid, _) then keys.push(ProjectionKey::Field(fid))
              when TypedPlaceProj::TupleIndex(ti) then keys.push(ProjectionKey::TupleIndex(ti))
              when _ then whole = true
              end
            end
            if whole then
              record_place_move_path(env, lid.id, "*")
            else
              record_place_move_path(env, lid.id, place_move_path_of(env, &keys))
            end
          end
        when _ then ()
        end
      when Option::None then ()
      end
    end
  when Option::None then ()
  end  end
end

# (partial moves): insert a Consumed record under a root local (the
# serialized registry the MIR's partial-drop chain consumes).
def record_place_move_path(inout env: TypeEnv, root: Int, path: String) -> Unit
  match env.place_move_states.get(root)
  when Option::Some(existing) then
    var ext = existing.clone()
    ext.insert(path.clone(), PlaceMoveState::Consumed)
    env.place_move_states.insert(root, ext)
  when Option::None then
    var fresh = Map::new()
    fresh.insert(path.clone(), PlaceMoveState::Consumed)
    env.place_move_states.insert(root, fresh)
  end  end
end

# (partial moves): the store into the projected place of `target`
# re-lives the target chain — remove the chain and every extension of it
# (a nested consumption under the target dies with the target's
# re-initialization). Called at the assignment sites (the checker's
# check_assign_target mirror).
def clear_place_move_paths(inout env: TypeEnv, root: Int, chain: Vec[ProjectionKey]) -> Unit
  let base = place_move_path_of(env, chain)
  let base_prefix = base + "."
  match env.place_move_states.get(root)
  when Option::Some(existing) then
    var kept = Map::new()
    for (dp, ds) in existing do
      if dp != base && !dp.starts_with(&base_prefix) then
        kept.insert(dp.clone(), ds)
      end
    end
    if kept.len() > 0 then
      env.place_move_states.insert(root, kept)
    else
      env.place_move_states.remove(&root)
    end
  when Option::None then ()
  end
end

# (partial moves — the projected-assign record): the store into a
# projected target re-lives the target chain (clear the chain and its
# extensions — a nested consumption under the target dies with the store).
# When the target's type is OWNING, the assignment is the drop-before-store
# case:
#   - a DEPTH-1 target chain with a FULLY live root (no recorded chains) is
#     the whole-value drop-before-store case the resource checker accepts
#     (the MIR's assign-drop chain destroys the whole root): the sibling
#     DIRECT fields die with the drop chain, so they are marked Consumed —
#     the scope-exit drop then drops only the re-stored target;
#   - a NESTED target chain (depth >= 2) is the exact-place transition the
#     resource checker accepts through the chain-effective-state prefix
#     rule (the chain's own state is dropped before the store — the
#     assign_exact_drops plan): the siblings stay live — no marking, only
#     the clear. A root with any recorded chain keeps its records for the
#     depth-1 owning case (the checker rejects the depth-1 owning-target
#     assignment there — the masked whole-root drop-before-store is not
#     representable).
def record_projected_assign(inout env: TypeEnv, target: Expr) -> Unit
  match typed_place_of(env, target)
  when Option::Some(tp) then
    match tp.root
    when AccessRoot::Local(lid) then
      if tp.projections.len() > 0 then
        var keys = Vec::new()
        var whole = false
        for proj in tp.projections do
          match proj
          when TypedPlaceProj::Field(fid, _) then keys.push(ProjectionKey::Field(fid))
          when TypedPlaceProj::TupleIndex(ti) then keys.push(ProjectionKey::TupleIndex(ti))
          when _ then whole = true
          end
        end
        if !whole then
          # The "fully-live root" precondition of the owning whole-drop
          # case is read BEFORE the clear: a root whose target chain (or
          # any other chain) was recorded Consumed is the dead-storage
          # re-live case — the siblings stay live, no marking.
          var root_had_records = false
          match env.place_move_states.get(lid.id)
          when Option::Some(st) then
            if st.len() > 0 then root_had_records = true end
          when Option::None then ()
          end
          clear_place_move_paths(env, lid.id, &keys)
          if keys.len() == 1 then
            match env.typed_expr_types.get(target.node_id)
            when Option::Some(tt) then
              let tp2 = type_properties_of(env, tt)
              if tp2.owns_state || tp2.is_linear then
                if !root_had_records then
                  mark_sibling_fields_consumed(env, lid.id, &keys)
                end
              end
            when Option::None then ()
            end
          end
        end
      end
    when _ then ()
    end
  when Option::None then ()
  end  end
end

# (partial moves): mark the root's DIRECT fields other than the target
# chain Consumed — the whole-root assign-drop chain destroys them, so the
# scope-exit drop must skip them (dropping only the re-stored target).
def mark_sibling_fields_consumed(inout env: TypeEnv, root: Int, target: Vec[ProjectionKey]) -> Unit
  match env.typed_local_bindings.get(root)
  when Option::Some(lb) then
    match lb.ty
    when Type::Adt(tid, _) then
      match get_type_by_id_ref(env, &tid)
      when Option::Some(td) then
        match td.def_kind
        when TypeDefKind::Struct(fields) then
          var fi = 0
          while fi < fields.len() do
            let sk = ProjectionKey::Field(FieldId { owner: tid, index: fi })
            if !chain_contains_key(target, &sk) then
              record_place_move_path(env, root, place_move_path_of(env, &Vec::from([sk])))
            end
            fi = fi + 1
          end
        when _ then ()
        end
      when Option::None then ()
      end
    when Type::Tuple(fields) then
      var ti = 0
      while ti < fields.len() do
        let sk = ProjectionKey::TupleIndex(ti)
        if !chain_contains_key(target, &sk) then
          record_place_move_path(env, root, place_move_path_of(env, &Vec::from([sk])))
        end
        ti = ti + 1
      end
    when _ then ()
    end
  when Option::None then ()
  end  end
end

def chain_contains_key(chain: Vec[ProjectionKey], k: ProjectionKey) -> Bool
  for ck in chain do
    if projection_key_eq(&ck, k) then return true end
  end
  false
end

# (partial moves): record the frame's per-field states for the projected
# source places of a checked pattern — every Consume binding whose source
# place is a projection of a LOCAL root marks the joined path (struct field
# names / tuple "t<i>" segments) Consumed under the root local; a binding
# through a non-field projection (variant/index/deref) marks the root's
# whole value "*" Consumed (the bounded lattice: enum payload and index
# moves are whole-value). Nested paths (object.a.b) join with "." and
# follow the same mechanism. Called at the let-initializer sites after
# check_pattern (the BindingPlans are recorded by then).
def record_place_moves(inout env: TypeEnv, pat: Pattern) -> Unit
  match env.binding_plans.get(pat.node_id)
  when Option::Some(plans) then
    for bp in plans do
      if bp.action == AccessEffect::Consume then
        match bp.source_place.root
        when AccessRoot::Local(lid) then
          if bp.source_place.projections.len() > 0 then
            var keys = Vec::new()
            var whole = false
            for proj in bp.source_place.projections do
              match proj
              when TypedPlaceProj::Field(fid, _) then keys.push(ProjectionKey::Field(fid))
              when TypedPlaceProj::TupleIndex(ti) then keys.push(ProjectionKey::TupleIndex(ti))
              when _ then whole = true
              end
            end
            if whole then
              record_place_move_path(env, lid.id, "*")
            else
              record_place_move_path(env, lid.id, place_move_path_of(env, &keys))
            end
          end
        when _ then ()
        end
      end
    end
  when Option::None then ()
  end  end
end

# ———————————————————————————————————————————————————————————————
# Typed HIR (— phase 2: the recursive forms)
# ———————————————————————————————————————————————————————————————
#
# The TypedProgram's typed HIR is now a RECURSIVELY TYPED syntax tree: one
# TypedExpr per source expression node, recorded by the type checker in
# LOCKSTEP with the flat maps (typed_expr_types / typed_call_targets /
# typed_field_targets / typed_access_effects), which remain the DERIVED
# INDEXES over the tree for the consumers that have not migrated to the
# tree (the MIR's flat fallbacks, the resource checker, the access
# checker). TRANSITIONAL (Batch-3): the typed HIR is NOT yet the exclusive
# lowering input — the MIR still reads the flat maps as its primary
# fallback channel; the exclusive-input claim lands with the batch that
# migrates the MIR's flat consumers to the tree (mir.tg). Every TypedExpr carries the expression's node id, its RESOLVED
# type, and a kind built from the recorded semantic metadata — never
# re-derived from the AST shape. The kinds carry their TYPED CHILDREN
# (per-variant):
#   - Call carries the TypedCall — the strong callee identity
#     (TypedCallee::Def(CallableId) or the closure-call marker), the
#     receiver effect, the typed receiver node (method calls), and the
#     typed argument nodes with their recorded effects;
#   - Field carries the TypedField — the strong FieldId and the typed base;
#   - Variant carries the TypedVariant — the strong VariantId and the typed
#     payload arguments;
#   - every operator / aggregate / composite kind carries its typed
#     operands; the composite statement kinds (If / Match / Block / Unsafe
#     / Async / Comptime) carry the TypedStmt children of their blocks;
#   - Closure carries the typed parameter patterns and the typed body.
# There is NO TypedExprKind::Unsupported: a source construct the checker
# accepts has a typed shape (the full enumeration below); a construct the
# compiler does not support is REJECTED at check time with a diagnostic
# (type_add_error) before MIR — never an Unsupported node.
#
# The strong identities are recorded directly (no numeric transitions):
# TypedCallee::Def(CallableId), TypedField.field (FieldId),
# TypedVariant.variant (VariantId), TypedExprKind::Local (the semantic
# LocalId — the typed_ident_resolutions value).
#
# The missing-metadata rule: every child reference the
# tree carries is a recorded TypedExpr (the checker records one per visited
# source node); a missing entry is an ICE-class TypeError — the construction
# never silently defaults.

# A call's callee identity: the resolved CallableId (ids.tg — the
# callable's DefId) or the closure-call marker — a closure VALUE invoked (a
# local or a parenthesized closure whose type is Type::Closure) with no
# DefId target. EffectPerform is the OPERATION-CALL surface identity — a
# std::effects::perform(EFFECT.op, ...) call the checker resolved against
# the declared effect's op table: the semantic EffectId, the op's index in
# the declaration (declaration order — the MIR/runtime dispatch identity)
# and the op's name (diagnostics).
enum TypedCallee
  Def(CallableId)
  Closure
  EffectPerform(EffectId, Int, String)
end

# The typed call node: the callee identity, the receiver's recorded access
# effect and typed receiver node (method calls; None for plain ExprCall),
# and the EXPLICIT arguments in source order with their recorded effects
# and typed values (the method receiver is NOT part of args).
struct TypedCall
  callee: TypedCallee
  receiver_effect: Option[AccessEffect]
  receiver: Option[TypedExpr]
  args: Vec[TypedCallArg]
end

# A call argument's typed form: the recorded access effect and the typed
# argument node (the TYPED CHILD — the MIR reads the effect from the tree).
struct TypedCallArg
  effect: AccessEffect
  value: TypedExpr
end

# A typed field access: the strong FieldId (ids.tg — the owner TypeId and
# the field index recorded in field_targets) and the typed receiver node.
struct TypedField
  field: FieldId
  base: TypedExpr
end

# A typed enum-variant construction: the strong VariantId (owner TypeId +
# variant index) and the typed payload arguments in source order.
struct TypedVariant
  variant: VariantId
  args: Vec[TypedExpr]
end

# The typed pattern record (assembled at check_pattern's tail from the
# recorded children; the tree's Closure / Match / Let forms carry these).
# The bound identifier's semantic local id (pattern_binding_resolutions)
# and the resolved variant identity (pattern_variant_resolutions) are
# recorded in the record.
struct TypedPattern
  id: Int            # NodeId — the pattern's AST node id
  kind: TypedPatternKind
end

enum TypedPatternKind
  Wildcard
  Ident { name: String, is_mut: Bool, local: Int }
  Literal(Box[TypedExpr])
  Tuple(Vec[TypedPattern])
  Array(Vec[TypedPattern])
  Struct { path: String, fields: Vec[(String, TypedPattern)] }
  Variant { variant: VariantId, args: Vec[TypedPattern] }
  Or(Vec[TypedPattern])
  Range { start: Option[Box[TypedExpr]], end_: Option[Box[TypedExpr]], inclusive: Bool }
end

# The typed statement record (assembled at check_stmt's tail from the
# recorded children; the tree's composite expression kinds carry the
# TypedStmt children of their blocks). The For record carries the for-stmt
# node id (iteration) — the join key of the resource checker's
# TypedIteration (resource_check.tg): the iteration plan is computed by
# check_for AFTER type checking, so the typed statement tree carries the
# plan identity and the MIR joins it with the resource-check channel
# (mir.tg lower_program / typed_iteration_of).
struct TypedStmt
  id: Int            # NodeId — the statement's AST node id
  kind: TypedStmtKind
end

enum TypedStmtKind
  Let { pattern: TypedPattern, value: TypedExpr, is_mut: Bool }
  Assign { target: TypedExpr, value: TypedExpr }
  CompoundAssign { op: BinOp, target: TypedExpr, value: TypedExpr }
  If { cond: TypedExpr, then_block: Vec[TypedStmt], elsif_branches: Vec[(TypedExpr, Vec[TypedStmt])], else_block: Option[Vec[TypedStmt]] }
  Match { scrutinee: TypedExpr, arms: Vec[TypedMatchArm] }
  While { cond: TypedExpr, body: Vec[TypedStmt] }
  For { iteration: Int, pattern: TypedPattern, iter: TypedExpr, body: Vec[TypedStmt] }
  Loop(Vec[TypedStmt])
  Return(Option[TypedExpr])
  Break(Option[TypedExpr])
  Continue
  Expr(TypedExpr)
  Unsafe { reason: Option[String], body: Vec[TypedStmt] }
  Defer(Vec[TypedStmt])
  Guard { cond: TypedExpr, else_action: TypedGuardElse }
  Try { body: Vec[TypedStmt], catches: Vec[TypedCatchArm], finally: Option[Vec[TypedStmt]] }
  With { expr: TypedExpr, pattern: TypedPattern, body: Vec[TypedStmt] }
  HandleWith { expr: TypedExpr, handlers: Vec[TypedHandler] }
end

struct TypedMatchArm
  pattern: TypedPattern
  guard_expr: Option[TypedExpr]
  body: Vec[TypedStmt]
end

struct TypedCatchArm
  pattern: TypedPattern
  body: Vec[TypedStmt]
end

# The typed guard-else action (the mirror of ast.tg GuardElse with typed
# value expressions).
enum TypedGuardElse
  Return(Option[TypedExpr])
  Panic(String)
  Break(Option[TypedExpr])
  Continue
end

struct TypedHandler
  effect: EffectId
  name: String
  arms: Vec[TypedHandlerArm]
end

struct TypedHandlerArm
  op_index: Int
  ret_type: Type
  params: Vec[TypedPattern]
  body: Vec[TypedStmt]
end

# ———————————————————————————————————————————————————————————————
# The typed effect representation (the algebraic-effects row)
# ———————————————————————————————————————————————————————————————
# The typed records of the `effect` declarations: the semantic EffectId
# (interned module-qualified by the declaration) keying the declaration's
# OPERATION SIGNATURES — the resolved op table the perform surface and the
# handler arms are typed against. The op index is the arm/dispatch identity
# (the position in the declaration's op list, declaration order) — the same
# index the MIR's perform statement and the runtime's handler-frame bitmap
# carry.
struct TypedEffectOp
  name: String
  params: Vec[Type]
  ret: Type
end

struct TypedEffectDecl
  id: EffectId
  name: String
  ops: Vec[TypedEffectOp]
end

def typed_effect_op_index(decl: TypedEffectDecl, op_name: String) -> Int
  var i = 0
  while i < decl.ops.len() do
    if decl.ops[i].name == op_name then return i end
    i = i + 1
  end
  -1
end

# The synthetic (negative) NodeId key of a handler arm's resource-check
# cleanup record — the checker's resource pass and the MIR's dispatcher
# lowering derive the SAME key (negative: node ids are positive, so the
# key can never collide with a real closure/expression node).
pub def effect_handler_synth_key(stmt_node_id: Int, handler_idx: Int, arm_idx: Int) -> Int
  -(1000 + stmt_node_id * 8 + handler_idx * 4 + arm_idx)
end

# The typed place record — a place path (the semantic AccessRoot (ids.tg:
# Local(LocalId)/SelfValue/Static(DefId)/RawUnknown — the SAME root domain
# the access checker's TypedPlace uses) + typed projections): the DERIVED
# INDEX form over the recursive tree (typed_place_of) — never rebuilt from
# the AST shape. The root NAME is retained for diagnostics only.
struct TypedPlace
  root: AccessRoot
  root_name: String
  projections: Vec[TypedPlaceProj]
end

enum TypedPlaceProj
  Field(FieldId, String)   # the strong field identity + the name (diagnostics)
  TupleIndex(Int)          # a tuple-index access (no FieldId exists)
  Index                    # an index projection
  Deref                    # a raw-pointer dereference
  Variant(VariantId)       # an enum downcast (match-arm projection)
end

# ———————————————————————————————————————————————————————————————
# The typed expression tree
# ———————————————————————————————————————————————————————————————

struct TypedExpr
  id: Int            # NodeId (ids.tg) — the expression's AST node id
  ty: Type           # the checker-resolved type of the expression
  kind: TypedExprKind
end

enum TypedExprKind
  # ——— leaves ———
  Local(Int)         # the semantic LocalId (the typed_ident_resolutions
                     # value): an ident that resolves to a local. No typed
                     # children.
  Global(String)     # a source ident that is NOT a local: a global
                     # callable, a static, or a bare variant name in value
                     # position (the checker types them as function values /
                     # enum values / constructors). The node's type (ty) is
                     # the resolved authority; the name is display/
                     # diagnostic only. No typed children.
  SelfRef            # ExprSelfRef — `self` in value position (its semantic
                     # place root is -1). No typed children.
  Literal(Int)       # the literal's source node id (the value is read back
                     # from the AST by node id). No typed children.
  Path(String)       # ExprPath: a qualified path VALUE — an enum variant
                     # value (Option::None) or a static/const reference.
                     # ty is the authority; the path renders diagnostics.
                     # No typed children.

  # ——— operators ———
  BinaryOp { op: BinOp, left: Box[TypedExpr], right: Box[TypedExpr] }
  UnaryOp { op: UnOp, operand: Box[TypedExpr] }
  Index { base: Box[TypedExpr], index: Box[TypedExpr] }
  Cast { value: Box[TypedExpr], target: Type }
  TypeCheck { value: Box[TypedExpr], target: Type }
  RawDeref(Box[TypedExpr])
  Access(Box[TypedExpr])
  Range { start: Option[Box[TypedExpr]], end_: Option[Box[TypedExpr]], inclusive: Bool }
  Await(Box[TypedExpr])
  Try(Box[TypedExpr])
  Pipe { lhs: Box[TypedExpr], rhs: Box[TypedExpr] }
  Assign { target: Box[TypedExpr], value: Box[TypedExpr] }

  # ——— aggregates ———
  ArrayLit(Vec[TypedExpr])
  TupleLit(Vec[TypedExpr])
  StructLit { path: String, fields: Vec[(String, TypedExpr)] }
  MapLit(Vec[(TypedExpr, TypedExpr)])

  # ——— calls / members / constructions ———
  Call(TypedCall)
  Field(TypedField)
  TupleIndex { base: Box[TypedExpr], name: String, index: Int }   # the
                     # non-FieldId access forms: tuple indices (.0,.1 —
                     # index = the parsed index) and the String/Slice/Array
                     # len/cap field reads (index = -1: no projection
                     # identity exists; the std uses the.len() methods).
                     # The typed base is the child.
  Variant(TypedVariant)
  StaticPathCall { path: String, args: Vec[TypedExpr] }   # the
                     # ExprEnumVariant-shaped STATIC-PATH call whose
                     # "variant" is not a registered enum variant
                     # (vec! / Vec::from([..]) desugarings): the MIR
                     # resolves the callee by the qualified path
                     # (resolve_static_path_callee_name) and lowers the
                     # call directly — the typed form carries the same
                     # information (the path + the typed args).
  MacroCall { name: String, args: Vec[TypedExpr] }

  # ——— composites ———
  Closure { params: Vec[TypedPattern], body: Box[TypedExpr] }
  If { cond: Box[TypedExpr], then_block: Vec[TypedStmt], elsif_branches: Vec[(TypedExpr, Vec[TypedStmt])], else_block: Option[Vec[TypedStmt]] }
  Match { scrutinee: Box[TypedExpr], arms: Vec[TypedMatchArm] }
  Block(Vec[TypedStmt])
  Unsafe { reason: Option[String], body: Vec[TypedStmt] }
  Async(Vec[TypedStmt])
  Comptime(Vec[TypedStmt])
end

# ———————————————————————————————————————————————————————————————
# Typed-HIR construction helpers
# ———————————————————————————————————————————————————————————————
#
# The tree is assembled from the recorded per-node maps: the checker
# records one TypedExpr per visited source node (check_expr's tail) and
# one TypedStmt / TypedPattern per visited statement / pattern node, so a
# child reference is a map read. Children are recorded BEFORE their
# parents (the checker's recursion checks children first), so the parent's
# record can always look its children up.

# The typed node of a child expression. Option::None only for synthesized
# nodes (node_id 0) and the missing-metadata failure class (the caller
# records the ICE — the construction never silently defaults).
def typed_child_of(env: TypeEnv, child: Expr) -> Option[TypedExpr]
  if child.node_id == 0 then return Option::None end
  match env.typed_exprs.get(child.node_id)
  when Option::Some(te) then Option::Some(te)
  when Option::None then Option::None
  end
end

# The typed nodes of a child expression vector (source order).
def typed_children_of(env: TypeEnv, elems: Vec[Expr]) -> Option[Vec[TypedExpr]]
  var out = Vec::new()
  var i = 0
  while i < elems.len() do
    match typed_child_of(env, &elems[i])
    when Option::Some(te) then out.push(te)
    when Option::None then return Option::None
    end
    i = i + 1
  end
  Option::Some(out)
end

# The typed nodes of a two-child expression (in order).
def typed_children_2(env: TypeEnv, a: Expr, b: Expr) -> Option[(TypedExpr, TypedExpr)]
  match typed_child_of(env, a)
  when Option::Some(ta) then
    match typed_child_of(env, b)
    when Option::Some(tb) then Option::Some((ta, tb))
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end  end
end

# The typed statement children of a block (each statement's record was
# assembled at its check_stmt tail — children are checked before their
# parents — so the lookup is a map read per statement; a statement without
# a record (synthesized node id 0) contributes nothing).
def typed_stmts_of(env: TypeEnv, block: Block) -> Vec[TypedStmt]
  var out = Vec::new()
  var i = 0
  while i < block.stmts.len() do
    let stmt = block.stmts[i]
    match env.typed_stmts.get(stmt.node_id)
    when Option::Some(ts) then out.push(ts)
    when Option::None then ()
    end
    i = i + 1
  end
  out
end

# The typed pattern record of a pattern node (assembled at check_pattern's
# tail; children are recorded before the parent).
def typed_pattern_of(env: TypeEnv, pat: Pattern) -> Option[TypedPattern]
  if pat.node_id == 0 then return Option::None end
  match env.typed_patterns.get(pat.node_id)
  when Option::Some(tp) then Option::Some(tp)
  when Option::None then Option::None
  end
end

# Assemble the typed pattern record of a pattern node from its shape and
# the recorded semantic metadata (the bound local id from
# pattern_binding_resolutions, the resolved variant identity from
# pattern_variant_resolutions, the recorded child patterns and literal
# expressions). Option::None when a required piece is missing — the
# checker records every binding and variant resolution, so this only fires
# for the missing-metadata failure class; the caller skips the record.
def typed_pattern_for(env: TypeEnv, pat: Pattern) -> Option[TypedPattern]
  var kind: Option[TypedPatternKind] = Option::None
  match pat.kind
  when PatternKind::Wildcard then
    kind = Option::Some(TypedPatternKind::Wildcard)
  when PatternKind::Ident(name, is_mut) then
    match env.pattern_binding_resolutions.get(pat.node_id)
    when Option::Some(lid) then kind = Option::Some(TypedPatternKind::Ident { name: name.clone(), is_mut: is_mut, local: lid })
    when Option::None then ()
    end
  when PatternKind::Literal(e) then
    match typed_child_of(env, &e)
    when Option::Some(lt) then kind = Option::Some(TypedPatternKind::Literal(Box::new(lt)))
    when Option::None then ()
    end
  when PatternKind::Tuple(pats) then
    match typed_patterns_of(env, &pats)
    when Option::Some(items) then kind = Option::Some(TypedPatternKind::Tuple(items))
    when Option::None then ()
    end
  when PatternKind::Array(pats) then
    match typed_patterns_of(env, &pats)
    when Option::Some(items) then kind = Option::Some(TypedPatternKind::Array(items))
    when Option::None then ()
    end
  when PatternKind::Struct(path, field_pats) then
    var fields_typed = Vec::new()
    var fi = 0
    var fields_ok = true
    while fi < field_pats.len() do
      match typed_pattern_of(env, &field_pats[fi].1)
      when Option::Some(tp) then
        fields_typed.push((field_pats[fi].0.clone(), tp))
        fi = fi + 1
      when Option::None then
        fields_ok = false
        fi = fi + 1
      end
    end
    if fields_ok then
      kind = Option::Some(TypedPatternKind::Struct { path: if path.segments.len() > 0 then path.segments.join("::") else "" end, fields: fields_typed })
    end
  when PatternKind::Variant(_, pats) then
    match typed_patterns_of(env, &pats)
    when Option::Some(items) then
      match env.pattern_variant_resolutions.get(pat.node_id)
      when Option::Some((tid, vidx)) then
        kind = Option::Some(TypedPatternKind::Variant { variant: VariantId { owner: TypeId { id: tid }, index: vidx as UInt }, args: items })
      when Option::None then ()
      end
    when Option::None then ()
    end
  when PatternKind::Or(alts) then
    match typed_patterns_of(env, &alts)
    when Option::Some(items) then kind = Option::Some(TypedPatternKind::Or(items))
    when Option::None then ()
    end
  when PatternKind::Range(lo, hi, inclusive) then
    let lo_typed = match lo
    when Option::Some(lo_expr) then
      match typed_child_of(env, &lo_expr)
      when Option::Some(lt) then Option::Some(Box::new(lt))
      when Option::None then return Option::None
      end
    when Option::None then Option::None
    end
    let hi_typed = match hi
    when Option::Some(hi_expr) then
      match typed_child_of(env, &hi_expr)
      when Option::Some(ht) then Option::Some(Box::new(ht))
      when Option::None then return Option::None
      end
    when Option::None then Option::None
    end
    kind = Option::Some(TypedPatternKind::Range { start: lo_typed, end_: hi_typed, inclusive: inclusive })
  end
  match kind
  when Option::Some(k) then Option::Some(TypedPattern { id: pat.node_id, kind: k })
  when Option::None then Option::None
  end
end

# The typed pattern records of a pattern vector (source order).
def typed_patterns_of(env: TypeEnv, pats: Vec[Pattern]) -> Option[Vec[TypedPattern]]
  var out = Vec::new()
  var i = 0
  while i < pats.len() do
    match typed_pattern_of(env, &pats[i])
    when Option::Some(tp) then out.push(tp)
    when Option::None then return Option::None
    end
    i = i + 1
  end
  Option::Some(out)
end

# The missing-metadata ICE: a required typed child is absent on a source
# node. The construction never silently defaults; the caller skips the
# node's record (the flat maps remain the fallback for the failure class,
# exactly like the typed-call assembly failure).
def missing_typed_hir_child(inout env: TypeEnv, expr: Expr) -> Option[TypedExprKind]
  add_error_with_code(env, "internal error: missing typed HIR child for node " + expr.node_id.to_string(), expr.span, "ICE")
  Option::None
end

# Assemble the TypedCall for a call node from the recorded semantic
# metadata — the call target (typed_call_targets DefId -> the strong
# CallableId), the receiver's access effect and typed node (method calls;
# None for plain calls), and the per-argument typed nodes with their
# recorded access effects. Returns Option::None when a required piece is
# missing (a call with no recorded target, or an argument without a
# recorded access effect or typed node) — the missing-metadata rule
# the construction never silently defaults the callee
# or an argument effect; the caller records an ICE-class TypeError.
def typed_call_for(env: TypeEnv, expr: Expr, args: Vec[Expr], receiver_node: Option[Box[Expr]]) -> Option[TypedCall]
  var callee = TypedCallee::Closure
  var has_target = false
  match env.typed_call_targets.get(expr.node_id)
  when Option::Some(did) then
    callee = TypedCallee::Def(CallableId { def: did })
    has_target = true
  when Option::None then ()
  end
  if !has_target then
    match receiver_node
    when Option::Some(_) then ()
    when Option::None then
      # A plain call with no recorded target is not a call shape at all —
      # the closure-call fallback in the recording site decides (the
      # TypedCall is assembled there, via typed_closure_call_for, only
      # when the callee is a Type::Closure value).
      return Option::None
    end
  end
  var receiver_effect: Option[AccessEffect] = Option::None
  var receiver_te: Option[TypedExpr] = Option::None
  match receiver_node
  when Option::Some(rn) then
    match env.typed_access_effects.get(rn.node_id)
    when Option::Some(eff) then receiver_effect = Option::Some(eff)
    when Option::None then return Option::None
    end
    match typed_child_of(env, &rn)
    when Option::Some(rt) then receiver_te = Option::Some(rt)
    when Option::None then return Option::None
    end
  when Option::None then ()
  end
  var typed_args = Vec::new()
  var i = 0
  while i < args.len() do
    match env.typed_access_effects.get(args[i].node_id)
    when Option::Some(eff) then
      match typed_child_of(env, &args[i])
      when Option::Some(at) then
        typed_args.push(TypedCallArg { effect: eff, value: at })
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
    i = i + 1
  end
  Option::Some(TypedCall { callee: callee, receiver_effect: receiver_effect, receiver: receiver_te, args: typed_args })
end

# The closure-call shape (the recording site's Type::Closure-callee
# fallback): a closure VALUE invoked — the callee is a local or a
# parenthesized closure (Type::Closure) with no DefId target. The TypedCall
# carries the closure-call marker (TypedCallee::Closure) and the args'
# recorded access effects and typed values (the closure call consumes the
# same per-arg effect records as a DefId call). Option::None when a
# required effect or typed child is missing — the missing-metadata rule
# the construction never silently defaults an argument
# effect; the caller records an ICE-class TypeError.
def typed_closure_call_for(env: TypeEnv, args: Vec[Expr], receiver_node: Option[Box[Expr]]) -> Option[TypedCall]
  var receiver_effect: Option[AccessEffect] = Option::None
  var receiver_te: Option[TypedExpr] = Option::None
  match receiver_node
  when Option::Some(rn) then
    match env.typed_access_effects.get(rn.node_id)
    when Option::Some(eff) then receiver_effect = Option::Some(eff)
    when Option::None then return Option::None
    end
    match typed_child_of(env, &rn)
    when Option::Some(rt) then receiver_te = Option::Some(rt)
    when Option::None then return Option::None
    end
  when Option::None then ()
  end
  var typed_args = Vec::new()
  var i = 0
  while i < args.len() do
    match env.typed_access_effects.get(args[i].node_id)
    when Option::Some(eff) then
      match typed_child_of(env, &args[i])
      when Option::Some(at) then
        typed_args.push(TypedCallArg { effect: eff, value: at })
      when Option::None then return Option::None
      end
    when Option::None then return Option::None
    end
    i = i + 1
  end
  Option::Some(TypedCall { callee: TypedCallee::Closure, receiver_effect: receiver_effect, receiver: receiver_te, args: typed_args })
end

# The closure-call shape gate: a callee (or method-call receiver) whose
# recorded type is Type::Closure — a closure VALUE — takes the
# closure-call path instead of the missing-target ICE.
def closure_call_shape(env: TypeEnv, callee: Expr, args: Vec[Expr], receiver_node: Option[Box[Expr]]) -> Option[TypedCall]
  match env.typed_expr_types.get(callee.node_id)
  when Option::Some(callee_ty) then
    match callee_ty
    when Type::FnPtr(_, _, _) | Type::Closure(_, _, _, _, _) then typed_closure_call_for(env, args, receiver_node)
    when _ then Option::None
    end
  when Option::None then Option::None
  end  end
end

# The typed statement record of a statement (assembled at check_stmt's
# tail from the recorded children). Option::None when a required child is
# missing — the checker records every visited node, so this only fires for
# the missing-metadata failure class; the caller skips the record.
def typed_stmt_for(env: TypeEnv, stmt: Stmt) -> Option[TypedStmt]
  var kind: Option[TypedStmtKind] = Option::None
  match stmt.kind
  when StmtKind::StmtLet(pattern, _, value, is_mut) then
    match typed_pattern_of(env, &pattern)
    when Option::Some(tp) then
      match typed_child_of(env, &value)
      when Option::Some(vt) then kind = Option::Some(TypedStmtKind::Let { pattern: tp, value: vt, is_mut: is_mut })
      when Option::None then ()
      end
    when Option::None then ()
    end
  when StmtKind::StmtAssign(target, value) then
    match typed_children_2(env, &target, &value)
    when Option::Some((tt, vt)) then kind = Option::Some(TypedStmtKind::Assign { target: tt, value: vt })
    when Option::None then ()
    end
  when StmtKind::StmtCompoundAssign(op, target, value) then
    match typed_children_2(env, &target, &value)
    when Option::Some((tt, vt)) then kind = Option::Some(TypedStmtKind::CompoundAssign { op: op, target: tt, value: vt })
    when Option::None then ()
    end
  when StmtKind::StmtIf(if_stmt) then
    match typed_child_of(env, &if_stmt.cond)
    when Option::Some(ct) then
      var elsif_typed = Vec::new()
      var ei = 0
      while ei < if_stmt.elsif_branches.len() do
        match typed_child_of(env, &if_stmt.elsif_branches[ei].0)
        when Option::Some(et) then
          elsif_typed.push((et, typed_stmts_of(env, &if_stmt.elsif_branches[ei].1)))
          ei = ei + 1
        when Option::None then ()
        end
      end
      let else_typed = match if_stmt.else_block
      when Option::Some(eb) then Option::Some(typed_stmts_of(env, &eb))
      when Option::None then Option::None
      end
      kind = Option::Some(TypedStmtKind::If { cond: ct, then_block: typed_stmts_of(env, &if_stmt.then_block), elsif_branches: elsif_typed, else_block: else_typed })
    when Option::None then ()
    end
  when StmtKind::StmtMatch(m) then
    match typed_child_of(env, &m.scrutinee)
    when Option::Some(st) then
      var arms_typed = Vec::new()
      var ai = 0
      while ai < m.arms.len() do
        let arm = m.arms[ai]
        let guard_typed = match arm.guard_expr
        when Option::Some(g) then typed_child_of(env, &g)
        when Option::None then Option::None
        end
        match typed_pattern_of(env, &arm.pattern)
        when Option::Some(apt) then
          arms_typed.push(TypedMatchArm { pattern: apt, guard_expr: guard_typed, body: typed_stmts_of(env, &arm.body) })
          ai = ai + 1
        when Option::None then ()
        end
      end
      kind = Option::Some(TypedStmtKind::Match { scrutinee: st, arms: arms_typed })
    when Option::None then ()
    end
  when StmtKind::StmtWhile(cond, body) then
    match typed_child_of(env, &cond)
    when Option::Some(ct) then kind = Option::Some(TypedStmtKind::While { cond: ct, body: typed_stmts_of(env, &body) })
    when Option::None then ()
    end
  when StmtKind::StmtFor(for_stmt) then
    match typed_pattern_of(env, &for_stmt.pattern)
    when Option::Some(tp) then
      match typed_child_of(env, &for_stmt.iter)
      when Option::Some(it) then kind = Option::Some(TypedStmtKind::For { iteration: stmt.node_id, pattern: tp, iter: it, body: typed_stmts_of(env, &for_stmt.body) })
      when Option::None then ()
      end
    when Option::None then ()
    end
  when StmtKind::StmtLoop(body) then
    kind = Option::Some(TypedStmtKind::Loop(typed_stmts_of(env, &body)))
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then
      match typed_child_of(env, &val)
      when Option::Some(vt) then kind = Option::Some(TypedStmtKind::Return(Option::Some(vt)))
      when Option::None then ()
      end
    when Option::None then kind = Option::Some(TypedStmtKind::Return(Option::None))
    end
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then
      match typed_child_of(env, &val)
      when Option::Some(vt) then kind = Option::Some(TypedStmtKind::Break(Option::Some(vt)))
      when Option::None then ()
      end
    when Option::None then kind = Option::Some(TypedStmtKind::Break(Option::None))
    end
  when StmtKind::StmtContinue then
    kind = Option::Some(TypedStmtKind::Continue)
  when StmtKind::StmtExpr(e) then
    match typed_child_of(env, &e)
    when Option::Some(et) then kind = Option::Some(TypedStmtKind::Expr(et))
    when Option::None then ()
    end
  when StmtKind::StmtUnsafe(reason, body) then
    kind = Option::Some(TypedStmtKind::Unsafe { reason: reason, body: typed_stmts_of(env, &body) })
  when StmtKind::StmtDefer(body) then
    kind = Option::Some(TypedStmtKind::Defer(typed_stmts_of(env, &body)))
  when StmtKind::StmtGuard(cond, else_action) then
    match typed_child_of(env, &cond)
    when Option::Some(ct) then
      let else_typed = match else_action
      when GuardElse::Return(ret_opt) then
        match ret_opt
        when Option::Some(ret_e) then
          match typed_child_of(env, &ret_e)
          when Option::Some(rt) then TypedGuardElse::Return(Option::Some(rt))
          when Option::None then return Option::None
          end
        when Option::None then TypedGuardElse::Return(Option::None)
        end
      when GuardElse::Panic(msg) then TypedGuardElse::Panic(msg)
      when GuardElse::Break(br_opt) then
        match br_opt
        when Option::Some(br_e) then
          match typed_child_of(env, &br_e)
          when Option::Some(bt) then TypedGuardElse::Break(Option::Some(bt))
          when Option::None then return Option::None
          end
        when Option::None then TypedGuardElse::Break(Option::None)
        end
      when GuardElse::Continue then TypedGuardElse::Continue
      end
      kind = Option::Some(TypedStmtKind::Guard { cond: ct, else_action: else_typed })
    when Option::None then ()
    end
  when StmtKind::StmtTry(body, catches, finally_block) then
    var catches_typed = Vec::new()
    var ci = 0
    var catches_ok = true
    while ci < catches.len() do
      match typed_pattern_of(env, &catches[ci].pattern)
      when Option::Some(cp) then
        catches_typed.push(TypedCatchArm { pattern: cp, body: typed_stmts_of(env, &catches[ci].body) })
        ci = ci + 1
      when Option::None then
        catches_ok = false
        ci = ci + 1
      end
    end
    if catches_ok then
      let finally_typed = match finally_block
      when Option::Some(fb) then Option::Some(typed_stmts_of(env, &fb))
      when Option::None then Option::None
      end
      kind = Option::Some(TypedStmtKind::Try { body: typed_stmts_of(env, &body), catches: catches_typed, finally: finally_typed })
    end
  when StmtKind::StmtWith(expr, pat, body) then
    match typed_child_of(env, &expr)
    when Option::Some(et) then
      match typed_pattern_of(env, &pat)
      when Option::Some(tp) then kind = Option::Some(TypedStmtKind::With { expr: et, pattern: tp, body: typed_stmts_of(env, &body) })
      when Option::None then ()
      end
    when Option::None then ()
    end
  when StmtKind::StmtHandleWith(expr, handlers) then
    match typed_child_of(env, &expr)
    when Option::Some(et) then
      # The typed handler records were assembled at the StmtHandleWith
      # check arm (the semantic EffectId, the arm op indices and the arm
      # result types); the tree carries the checker's record — the MIR's
      # handler lowering reads the same table.
      match env.typed_effect_handlers.get(stmt.node_id)
      when Option::Some(typed_handlers) then
        kind = Option::Some(TypedStmtKind::HandleWith { expr: et, handlers: typed_handlers })
      when Option::None then ()
      end
    when Option::None then ()
    end
  end
  match kind
  when Option::Some(k) then Option::Some(TypedStmt { id: stmt.node_id, kind: k })
  when Option::None then Option::None
  end
end

# The typed place of a place-like expression — the DERIVED INDEX form over
# the recursive tree. Option::None for non-place expressions and for nodes
# the tree does not record (the access checker falls back to its own
# shape walk for those).
def typed_place_of(env: TypeEnv, expr: Expr) -> Option[TypedPlace]
  match expr.kind
  when ExprKind::ExprIdent(name) then
    match env.typed_ident_resolutions.get(expr.node_id)
    when Option::Some(lid) then
      if lid >= 0 then
        Option::Some(TypedPlace { root: AccessRoot::Local(LocalId { id: lid }), root_name: name.clone(), projections: Vec::new() })
      else
        Option::None
      end
    when Option::None then Option::None
    end
  when ExprKind::ExprSelfRef then
    Option::Some(TypedPlace { root: AccessRoot::SelfValue, root_name: "self".to_string(), projections: Vec::new() })
  when ExprKind::ExprFieldAccess(base, field) then
    match typed_place_of(env, &base)
    when Option::Some(tp) then
      match env.typed_exprs.get(expr.node_id)
      when Option::Some(te) then
        match te.kind
        when TypedExprKind::Field(tf) then
          var projs = tp.projections.clone()
          projs.push(TypedPlaceProj::Field(tf.field, field.clone()))
          Option::Some(TypedPlace { root: tp.root, root_name: tp.root_name.clone(), projections: projs })
        when TypedExprKind::TupleIndex { base: _, name: _, index: ti } then
          var projs2 = tp.projections.clone()
          projs2.push(TypedPlaceProj::TupleIndex(ti))
          Option::Some(TypedPlace { root: tp.root, root_name: tp.root_name.clone(), projections: projs2 })
        when _ then Option::None
        end
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  when ExprKind::ExprIndex(base, _) then
    match typed_place_of(env, &base)
    when Option::Some(tp) then
      var projs3 = tp.projections.clone()
      projs3.push(TypedPlaceProj::Index)
      Option::Some(TypedPlace { root: tp.root, root_name: tp.root_name.clone(), projections: projs3 })
    when Option::None then Option::None
    end
  when ExprKind::ExprRawDeref(inner) then
    match typed_place_of(env, &inner)
    when Option::Some(tp) then
      var projs4 = tp.projections.clone()
      projs4.push(TypedPlaceProj::Deref)
      Option::Some(TypedPlace { root: tp.root, root_name: tp.root_name.clone(), projections: projs4 })
    when Option::None then Option::None
    end
  when ExprKind::ExprAccess(inner) then typed_place_of(env, &inner)
  when _ then Option::None
  end  end
end

# The recording site (check_expr's tail): after the expression's type is
# resolved, build the TypedExpr from the expression shape and the recorded
# semantic metadata, and record it into typed_exprs. The flat maps remain
# the derived indexes; this node record is the recursive Typed-HIR tree.
# There is NO Unsupported kind — every accepted construct has a typed
# shape; the unsupported constructs are rejected at check time with a
# diagnostic before MIR. The missing-metadata rule: a
# call whose TypedCall cannot be assembled (no recorded call target, or an
# argument without a recorded access effect or typed child) records an
# ICE-class TypeError and the node is NOT recorded — the construction never
# silently defaults. A REJECTED node (the checker's Type::Error result — an
# illegal access marker, a map literal, an unknown symbol,...) is not
# recorded either: the program is already rejected, and the missing-child
# ICEs must not fire for the rejected construct's children.
def record_typed_hir(inout env: TypeEnv, expr: Expr, result: Type) -> Unit
  match result
  when Type::Error then ()
  when _ then
    match typed_kind_for(env, expr)
    when Option::Some(kind) then
      env.typed_exprs.insert(expr.node_id, TypedExpr { id: expr.node_id, ty: result.clone(), kind: kind })
    when Option::None then ()
    end
  end  end
end

# Build the typed kind of an expression node from its shape and the
# recorded semantic metadata (the per-variant typed children are looked up
# from the recorded tree — children are recorded before their parents).
# Option::None = the missing-metadata failure class (the ICE was recorded)
# or a rejected construct (ExprError — the parser already diagnosed it).
def typed_kind_for(inout env: TypeEnv, expr: Expr) -> Option[TypedExprKind]
  match expr.kind
  when ExprKind::ExprIntLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprFloatLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprStringLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprCharLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprBoolLit(_) then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprNilLit then Option::Some(TypedExprKind::Literal(expr.node_id))
  when ExprKind::ExprSelfRef then Option::Some(TypedExprKind::SelfRef)
  when ExprKind::ExprIdent(_) then
    # Local only when the ident resolves to a semantic local (the
    # typed_ident_resolutions value >= 0); a global callable, a static or a
    # bare variant name in value position is the Global shape (typed via
    # the node's type — the name is display/diagnostic only).
    match env.typed_ident_resolutions.get(expr.node_id)
    when Option::Some(lid) then
      if lid >= 0 then
        Option::Some(TypedExprKind::Local(lid))
      else
        Option::Some(TypedExprKind::Global(typed_ident_name_of(expr)))
      end
    when Option::None then Option::Some(TypedExprKind::Global(typed_ident_name_of(expr)))
    end
  when ExprKind::ExprPath(path) then
    Option::Some(TypedExprKind::Path(if path.segments.len() > 0 then path.segments.join("::") else "" end))
  when ExprKind::ExprBinaryOp(op, left, right) then
    match typed_children_2(env, &left, &right)
    when Option::Some((lt, rt)) then Option::Some(TypedExprKind::BinaryOp { op: op, left: Box::new(lt), right: Box::new(rt) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprUnaryOp(op, inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::UnaryOp { op: op, operand: Box::new(it) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprIndex(base, index) then
    match typed_children_2(env, &base, &index)
    when Option::Some((bt, it)) then Option::Some(TypedExprKind::Index { base: Box::new(bt), index: Box::new(it) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprCast(inner, ty_expr) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::Cast { value: Box::new(it), target: resolve_type_expr(env, &ty_expr) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprTypeCheck(inner, ty_expr) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::TypeCheck { value: Box::new(it), target: resolve_type_expr(env, &ty_expr) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprRawDeref(inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::RawDeref(Box::new(it)))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprAccess(inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::Access(Box::new(it)))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprRange(start, end_, inclusive) then
    let start_typed = match start
    when Option::Some(s) then
      match typed_child_of(env, &s)
      when Option::Some(st) then Option::Some(Box::new(st))
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    when Option::None then Option::None
    end
    let end_typed = match end_
    when Option::Some(e) then
      match typed_child_of(env, &e)
      when Option::Some(et) then Option::Some(Box::new(et))
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    when Option::None then Option::None
    end
    Option::Some(TypedExprKind::Range { start: start_typed, end_: end_typed, inclusive: inclusive })
  when ExprKind::ExprAwait(inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::Await(Box::new(it)))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprTry(inner) then
    match typed_child_of(env, &inner)
    when Option::Some(it) then Option::Some(TypedExprKind::Try(Box::new(it)))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprPipe(lhs, rhs) then
    match typed_children_2(env, &lhs, &rhs)
    when Option::Some((lt, rt)) then Option::Some(TypedExprKind::Pipe { lhs: Box::new(lt), rhs: Box::new(rt) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprAssign(target, value) then
    match typed_children_2(env, &target, &value)
    when Option::Some((tt, vt)) then Option::Some(TypedExprKind::Assign { target: Box::new(tt), value: Box::new(vt) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprArrayLit(elems) then
    match typed_children_of(env, &elems)
    when Option::Some(items) then Option::Some(TypedExprKind::ArrayLit(items))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprTupleLit(elems) then
    match typed_children_of(env, &elems)
    when Option::Some(items) then Option::Some(TypedExprKind::TupleLit(items))
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprStructLit(path, fields) then
    var fields_typed = Vec::new()
    var fi = 0
    while fi < fields.len() do
      match typed_child_of(env, &fields[fi].1)
      when Option::Some(ft) then
        fields_typed.push((fields[fi].0.clone(), ft))
        fi = fi + 1
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    end
    Option::Some(TypedExprKind::StructLit { path: if path.segments.len() > 0 then path.segments.join("::") else "" end, fields: fields_typed })
  when ExprKind::ExprMapLit(entries) then
    var entries_typed = Vec::new()
    var mi = 0
    while mi < entries.len() do
      match typed_children_2(env, &entries[mi].0, &entries[mi].1)
      when Option::Some((kt, vt)) then
        entries_typed.push((kt, vt))
        mi = mi + 1
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    end
    Option::Some(TypedExprKind::MapLit(entries_typed))
  when ExprKind::ExprCall(func, args) then
    # The operation-call surface: a resolved std::effects::perform call
    # assembles the EffectPerform callee (the semantic EffectId + the op's
    # declaration index + name) — never the DefId form (the callee's
    # declared generic signature is a resolution seed, not the call's
    # typing).
    if effect_perform_callee_path(&func) then
      match typed_effect_perform_call_for(env, expr, &args)
      when Option::Some(tc_perform) then Option::Some(TypedExprKind::Call(tc_perform))
      when Option::None then
        add_error_with_code(env, "internal error: cannot assemble the typed effect-perform call node (node " + expr.node_id.to_string() + "): missing effect identity or argument access effect", expr.span, "ICE")
        Option::None
      end
    else
    match typed_call_for(env, expr, &args, Option::None)
    when Option::Some(tc) then Option::Some(TypedExprKind::Call(tc))
    when Option::None then
      # The closure-call shape: the callee is a closure VALUE (a local or a
      # parenthesized closure) whose type is Type::Closure — no DefId
      # target — recorded with the closure-call marker and the args'
      # effects instead of the ICE. Only a Type::Closure callee takes this
      # path; an unresolvable non-closure callee stays an ICE (the
      # missing-metadata rule: never silently default the callee).
      match closure_call_shape(env, &func, &args, Option::None)
      when Option::Some(tc2) then Option::Some(TypedExprKind::Call(tc2))
      when Option::None then
        add_error_with_code(env, "internal error: cannot assemble the typed HIR call node (node " + expr.node_id.to_string() + "): missing typed call target or argument access effect", expr.span, "ICE")
        Option::None
      end
    end
    end
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    match typed_call_for(env, expr, &args, Option::Some(recv))
    when Option::Some(tc) then Option::Some(TypedExprKind::Call(tc))
    when Option::None then
      # The closure-call shape for a method call: the target has no DefId
      # and the RECEIVER is a closure value (Type::Closure) — recorded
      # with the closure-call marker, the receiver's effect and the args'
      # effects instead of the ICE.
      match closure_call_shape(env, &recv, &args, Option::Some(recv))
      when Option::Some(tc2) then Option::Some(TypedExprKind::Call(tc2))
      when Option::None then
        add_error_with_code(env, "internal error: cannot assemble the typed HIR call node (node " + expr.node_id.to_string() + "): missing typed call target or argument access effect", expr.span, "ICE")
        Option::None
      end
    end
  when ExprKind::ExprFieldAccess(recv, field) then
    match typed_child_of(env, &recv)
    when Option::Some(rt) then
      # Field only when field_targets recorded a FieldId (a struct field);
      # the non-id access forms (tuple indices, String/Slice/Array
      # len/cap) are the TupleIndex shape (index = the parsed tuple index,
      # -1 for the named len/cap forms).
      match env.typed_field_targets.get(expr.node_id)
      when Option::Some(fid) then Option::Some(TypedExprKind::Field(TypedField { field: fid, base: rt }))
      when Option::None then
        let tidx = match field.parse_int()
        when Result::Ok(n) then n
        when Result::Err(_) then -1
        end
        Option::Some(TypedExprKind::TupleIndex { base: Box::new(rt), name: field.clone(), index: tidx })
      end
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprEnumVariant(path, args) then
    # The operation-call surface: a std::effects::perform(EFFECT.op, ...)
    # call parses as an ExprEnumVariant (the 3-segment module-qualified
    # call path — the same shape the check arm routes through
    # check_effect_perform_call). The typed assembly mirrors the ExprCall
    # arm: the resolved perform call carries the EffectPerform callee
    # identity (the semantic EffectId + the op's declaration index + name)
    # — never a variant construction or a StaticPathCall (the MIR's
    # perform lowering reads the identity from the callee record).
    if effect_perform_callee_path(&expr) then
      match typed_effect_perform_call_for(env, expr, &args)
      when Option::Some(tc_perform) then Option::Some(TypedExprKind::Call(tc_perform))
      when Option::None then
        add_error_with_code(env, "internal error: cannot assemble the typed effect-perform call node (node " + expr.node_id.to_string() + "): missing effect identity or argument access effect", expr.span, "ICE")
        Option::None
      end
    else
    match typed_children_of(env, &args)
    when Option::Some(args_typed) then
      # The resolved variant identity: find_enum_variant_indexed is the
      # checker's owner + index resolution (the same lookup the check arm
      # used). An unresolvable "variant" (the Vec::from static-path call
      # fallback) is the StaticPathCall shape — the MIR resolves the callee
      # by the qualified path.
      let variant_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
      match find_enum_variant_indexed(env, variant_name.clone())
      when Option::Some((enum_td, _, vidx)) then
        Option::Some(TypedExprKind::Variant(TypedVariant { variant: VariantId { owner: TypeId { id: enum_td.id.id }, index: vidx as UInt }, args: args_typed }))
      when Option::None then
        Option::Some(TypedExprKind::StaticPathCall { path: if path.segments.len() > 0 then path.segments.join("::") else "" end, args: args_typed })
      end
    when Option::None then missing_typed_hir_child(env, expr)
    end
    end
  when ExprKind::ExprMacroCall(name, args) then
    match typed_children_of(env, &args)
    when Option::Some(args_typed) then Option::Some(TypedExprKind::MacroCall { name: name, args: args_typed })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprClosure(params, _, body) then
    # The typed parameter patterns (recorded by check_pattern) and the
    # typed body node (recorded by the body check).
    var typed_params = Vec::new()
    var pi = 0
    while pi < params.len() do
      match typed_pattern_of(env, &params[pi].pat)
      when Option::Some(tp) then
        typed_params.push(tp)
        pi = pi + 1
      when Option::None then return missing_typed_hir_child(env, expr)
      end
    end
    match typed_child_of(env, &body)
    when Option::Some(bt) then Option::Some(TypedExprKind::Closure { params: typed_params, body: Box::new(bt) })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprIf(if_stmt) then
    match typed_child_of(env, &if_stmt.cond)
    when Option::Some(ct) then
      var elsif_typed = Vec::new()
      var ei = 0
      while ei < if_stmt.elsif_branches.len() do
        match typed_child_of(env, &if_stmt.elsif_branches[ei].0)
        when Option::Some(et) then
          elsif_typed.push((et, typed_stmts_of(env, &if_stmt.elsif_branches[ei].1)))
          ei = ei + 1
        when Option::None then return missing_typed_hir_child(env, expr)
        end
      end
      let else_typed = match if_stmt.else_block
      when Option::Some(eb) then Option::Some(typed_stmts_of(env, &eb))
      when Option::None then Option::None
      end
      Option::Some(TypedExprKind::If { cond: Box::new(ct), then_block: typed_stmts_of(env, &if_stmt.then_block), elsif_branches: elsif_typed, else_block: else_typed })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprMatch(m) then
    match typed_child_of(env, &m.scrutinee)
    when Option::Some(st) then
      var arms_typed = Vec::new()
      var ai = 0
      while ai < m.arms.len() do
        let arm = m.arms[ai]
        let guard_typed = match arm.guard_expr
        when Option::Some(g) then
          match typed_child_of(env, &g)
          when Option::Some(gt) then Option::Some(gt)
          when Option::None then return missing_typed_hir_child(env, expr)
          end
        when Option::None then Option::None
        end
        match typed_pattern_of(env, &arm.pattern)
        when Option::Some(apt) then
          arms_typed.push(TypedMatchArm { pattern: apt, guard_expr: guard_typed, body: typed_stmts_of(env, &arm.body) })
          ai = ai + 1
        when Option::None then return missing_typed_hir_child(env, expr)
        end
      end
      Option::Some(TypedExprKind::Match { scrutinee: Box::new(st), arms: arms_typed })
    when Option::None then missing_typed_hir_child(env, expr)
    end
  when ExprKind::ExprBlock(block) then
    Option::Some(TypedExprKind::Block(typed_stmts_of(env, &block)))
  when ExprKind::ExprUnsafe(reason, block) then
    Option::Some(TypedExprKind::Unsafe { reason: reason, body: typed_stmts_of(env, &block) })
  when ExprKind::ExprAsync(block) then
    Option::Some(TypedExprKind::Async(typed_stmts_of(env, &block)))
  when ExprKind::ExprComptime(block) then
    Option::Some(TypedExprKind::Comptime(typed_stmts_of(env, &block)))
  when ExprKind::ExprError(_) then Option::None
  when _ then
    # Defensive: every checker-accepted construct has an arm above; a new
    # ExprKind variant reaching this arm is a compiler gap — an explicit
    # diagnostic, never an Unsupported node.
    type_add_error(env, "internal error: unhandled expression kind in typed HIR construction (node " + expr.node_id.to_string() + ")", expr.span)
    Option::None
  end  end
end

# The display name of a non-local ident (the Global shape): the source
# name of the ExprIdent node.
def typed_ident_name_of(expr: Expr) -> String
  match expr.kind
  when ExprKind::ExprIdent(name) then name.clone()
  when _ then ""
  end  end
end

# The semantic authority: every downstream phase (resource checker, access
# checker, MIR, codegen) consumes THESE tables instead of re-deriving
# semantics. One TypeId universe: type_kinds/type_names/type_fields/
# type_variants/type_params/deinit_plans are keyed by the SAME semantic
# TypeIds the type checker assigned.
# ———————————————————————————————————————————————————————————————
# the SEMANTIC CLEANUP TABLES — the finalize_plan replacement
# ———————————————————————————————————————————————————————————————
# The finalize_plan String protocols (the defer scope-key and
# "defer_locals::<scope key>" scope registrations and the String owner-key
# function-end plan) is not part of the model: no cleanup semantics depend on parsing a
# String prefix. Three semantic id-keyed tables replace them:
#   by_callable       — CallableId -> FunctionCleanup: the function-end
#                       finalize sets the MIR consumes (deinit_candidates);
#                       drops are the Live Sink/OwnedLocal locals at the
#                       function end, defers are the function body scope's
#                       registered defers (registration order).
#   closure_cleanup   — closure expr NodeId -> FunctionCleanup: the
#                       closure-body finalize set ("closure::<node id>" key
#                       protocol is are not part of the model).
#   scope_defers      — ScopeId -> the scope's registered defer STMT ids
#                       (DeferId), registration order (the defer-key
#                       protocol).
#   scope_defer_locals — ScopeId -> the defer bodies' OWN local ids
#                       (LocalId), registration order — finalized exactly
#                       when the deferred code RUNS (the
#                       "defer_locals::<key>" protocol).
#   expr_temps        — stmt node id -> discarded full-expression temporary
#                       markers (the "expr::<stmt id>" protocol).
#   assign_drops      — stmt/expr node id -> drop-before-store local ids
#                       (the "assign::<stmt id>" / "assign::<expr id>"
#                       protocols).
struct ScopeId
  id: Int
end

struct DeferId
  id: Int
end

struct FunctionCleanup
  defers: Vec[DeferId]
  drops: Vec[LocalId]
end

# (partial moves — the nested owning projected replacement): ONE
# drop-before-store entry for a NESTED owning projected target (the
# exact-place transition). The drop destroys the CHAIN's own state — the
# exact place (x.a.b) — instead of the whole root; `paths` are the
# serialized CONSUMED EXTENSIONS under the chain (relative to it, in the
# place_move_path_of key form), whose storage the drop must skip (the
# masked exact-place drop). Empty `paths` = the chain's value is fully
# live — a plain whole-value drop of the exact place.
struct AssignExactDrop
  local: Int               # the semantic root local id
  chain: Vec[ProjectionKey] # the exact target chain (depth >= 2)
  paths: Vec[String]       # the relative consumed extension paths
end

struct FunctionCleanupTable
  by_callable: Map[CallableId, FunctionCleanup]
  closure_cleanup: Map[NodeId, FunctionCleanup]
  scope_defers: Map[ScopeId, Vec[DeferId]]
  scope_defer_locals: Map[ScopeId, Vec[LocalId]]
  expr_temps: Map[Int, Vec[Int]]
  assign_drops: Map[Int, Vec[Int]]
  assign_exact_drops: Map[Int, Vec[AssignExactDrop]]
end

pub def function_cleanup_table_new() -> FunctionCleanupTable
  FunctionCleanupTable {
    by_callable: Map::new(),
    closure_cleanup: Map::new(),
    scope_defers: Map::new(),
    scope_defer_locals: Map::new(),
    expr_temps: Map::new(),
    assign_drops: Map::new(),
    assign_exact_drops: Map::new()
  }
end

struct TypedProgram
  ast: Program
  resolutions: ResolvedNames
  expr_types: Map[Int, Type]
  call_targets: Map[Int, DefId]
 # (final): call expr node id -> the type checker's SOLVED generic
  # substitution for that call (the callee's generic args in the callee's
  # parameter order). Populated at the generic-call sites ONLY when the
  # callee is generic and EVERY generic parameter is solved; absent for
  # synthesized/unsolved calls (a call a context never solves is reported
  # by resolve_pending_call_instances). The solved substitutions from the
  # type checker are the AUTHORITY — ZERO-INFERENCE: the monomorphizer
  # performs no call-site inference (fail-closed). MIR pairs this with
  # call_targets to fill the call instance's substs.
  call_instances: Map[Int, Vec[Type]]
  field_targets: Map[Int, FieldId]
  access_effects: Map[Int, AccessEffect]
 # (, phase 2): the Typed HIR — per expression node
  # id, the typed node the checker recorded (kind + resolved type). The
  # node forms are RECURSIVE: every kind carries its typed children
  # (per-variant), so the MIR reads the call target, the receiver/argument
  # effects, the field identity and the variant identity from the tree.
  # The flat maps above remain the DERIVED INDEXES over the tree for the
  # consumers that have not migrated to the tree (the MIR's flat
  # fallbacks, the resource checker, the access checker). TRANSITIONAL
  # (Batch-3): the tree is not yet the exclusive lowering input — see the
  # Typed HIR section note.
  typed_exprs: Map[Int, TypedExpr]
  closure_captures: Map[Int, Map[Int, AccessEffect]]
  # The algebraic-effects typed records (the semantic EffectId-keyed op
  # tables, the typed handle-with handlers per statement node and the
  # per-handler capture records) — the checker's typed effect channel into
  # the MIR's perform/handler lowering.
  typed_effects: Map[Int, TypedEffectDecl] = Map::new()
  effect_name_index: Map[String, Int] = Map::new()
  typed_effect_handlers: Map[Int, Vec[TypedHandler]] = Map::new()
  handler_captures: Map[Int, Vec[Map[Int, AccessEffect]]] = Map::new()
  local_bindings: Map[Int, LocalBinding]
  ident_resolutions: Map[Int, Int]
  # Parameter bindings are keyed by owner (function/method DefId via
  # fn_owner_key) with a positional Vec; pattern bindings are keyed by
  # pattern node id. The two domains never collide.
  param_binding_resolutions: Map[String, Vec[Int]]
  pattern_binding_resolutions: Map[Int, Int]
 # (partial moves — place-level state): root semantic LocalId -> joined
  # field path -> per-place move state (Live/Consumed) — the frame's
  # per-field states for the projected places, recorded by the checker's
  # record_place_moves at the let-initializer sites and consumed by the
  # MIR's drop sites (the partial-drop chain — the memoized drop glue's
  # initialized-mask conditioning). The resource checker's projected-move
  # rules are the next-wave consumer of the same per-binding action data
 # (the check_pattern note documents the planned consumption).
  place_move_states: Map[Int, Map[String, PlaceMoveState]]
  # Authoritative deinitialization plan per type id (DeinitPlan). Computed in
  # type_check_typed; MIR consumes it for recursive cleanup emission instead
  # of guessing per-type finalization from names.
  deinit_plans: Map[Int, DeinitPlan]
  # Per aggregate-literal expression node id: whether each child value is
  # OWNED (transferred into the aggregate). Consumed by the resource checker
  # for uniform aggregate ownership transfer.
  aggregate_ownership: Map[Int, Vec[Bool]]
 # (ONE AnalyzedProgram): the analysis results moved OUT of the
  # TypedProgram into the AnalyzedProgram artifact (resource_check.tg) —
 # the authoritative per-function finalize set (CallableId ->
  # FunctionCleanup, the ScopeId-keyed defer registrations, the NodeId-keyed
  # closure sets, the expr/assign statement-local plans), the String-keyed
 # "edge::..." edge_cleanup serialization (are not part of the model — the MIR consumes
 # the CleanupEdge table, cfg.cleanup), and the ONE TypedCFG (built
  # ONCE by the pipeline, passed through both checkers, carried in the
  # artifact). The TypedProgram carries the typed HIR only.
  # Type id -> type name and type id -> registered finalizer callable, used
  # by build_deinit_plan to construct the recursive DeinitPlan per type.
 # deinit_targets is the CHECKER's FINALIZER REGISTRATION — TypeId ->
  # the Drop-impl / deinit method's resolver DefId (CallableId), never a
  # mangled name. The registration is the identity source for every
  # DeinitPlan::Call / UserFinalizer payload; the mangled emission names
  # ("Type__drop" / "Type__deinit") are derived by the MIR only at the
  # symbol-mangling boundary.
  type_names: Map[Int, String]
  deinit_targets: Map[Int, CallableId]
 # (— the typed FinalizerKind): TypeId -> the finalizer
  # KIND the checker assigned at registration (the same TypeId key as
  # deinit_targets — the Drop-impl / deinit-method registration). No
  # consumer recognizes a finalizer by source name (deinit/drop): the MIR
  # builder and the resource checker consult THIS table (via
  # finalizer_kind_of_callable — the CallableId identity) instead.
  finalizer_kinds: Map[Int, FinalizerKind] = Map::new()
  # Type id -> struct field shapes (name, type) and enum variant shapes
  # (name, field types, discriminant): the nominal information DeinitPlan
  # construction needs to walk struct fields and enum variants when a
  # resource has no explicit deinit (viral containment).
  type_fields: Map[Int, Vec[(String, Type)]]
  type_variants: Map[Int, Vec[(String, Vec[Type], Int)]]
  # Type id -> generic parameter ids (for substituting concrete args into
  # field/variant types when building containment plans). the ids in
  # declaration order; the param-name table below holds the display names.
  type_params: Map[Int, Vec[GenericParamId]]
  # Type id -> the declaration's LAYOUT attributes (@repr(C) / @align(N) /
  # @packed) — the checker's validated record (env.layout_attrs), carried
  # into the MirTypeDefs the layout engine reads; the typed records are the
  # attribute authority end-to-end.
  type_layout_attrs: Map[Int, LayoutAttrs]
  type_kinds: Map[Int, TypeKind]
 # (engine snapshot completeness): type id -> the RESOLVED inner type of
  # a type alias (TypeDefKind::Alias — the checker's registered alias
  # declaration). The engine snapshot (engine_snapshot_env, resource_check.tg)
  # reconstructs TypeDefKind from the serialized field/variant tables and
  # cannot see aliases (they land Opaque — the engine would answer
  # owns_state=false for an alias of an owning type, diverging from the
  # checker's env, which walks the Alias inner). The MIR re-applies these
  # entries onto the snapshot env so both sides of the seam answer from the
  # same authority.
  type_aliases: Map[Int, Type]
 # fn owner key -> the checker's RESOLVED declaration signature (the
  # parameter ParamTypes — base types plus conventions — and the resolved
  # return type) of every function/method/extern declaration. Recorded at
  # the checker's signature-computation sites and serialized here; the MIR
  # reads every declaration type from this table — TypeExpr is never
  # interpreted after checking (a missing entry is an ICE at the MIR read).
  typed_fn_signatures: Map[String, FnSignature]
 # module-qualified key ("path::name" — module_qualified_key) -> the
  # checker's resolved declared type of every static / const / extern-static
  # declaration. The MIR reads the declared static/const types from this
  # table (a missing entry is an ICE at the MIR read).
  typed_static_types: Map[String, Type]
 # the canonical LangItems table — the checker's env.lang_items
  # id-indexed snapshot (the builtin compound type ids and the well-known
  # trait ids, built once at env initialization by build_lang_items). The
  # MIR receives the builtin ids DIRECTLY from this table (the old
  # name-inversion is are not part of the model); the synthesized Adt constructions for the
  # builtins read the snapshot fields.
  lang_items: LangItems
 # fn owner key -> the generic parameter ids of that function/
  # method in the MIR's merged declaration order (the MIR builder's
  # Type::Param reconstruction record) and the serialized param-name table
  # (numeric GenericParamId -> name — diagnostics only; the MIR and the
  # monomorphizer render names from this snapshot).
  generic_param_ids: Map[String, Vec[GenericParamId]]
  generic_param_names: Map[Int, String]
end

struct TypeCheckResult
  errors: Vec[TypeError]
 # the checker's program snapshot is an AnalyzedProgram — the
  # artifact with an EMPTY analysis (no CFG, no finalize plan, a fresh
  # AnalysisContext, the engine snapshot of the typed tables) — the shape
  # every lowering entry consumes. The pipeline (analyze_parsed) replaces
  # it with the REAL artifact (the ONE TypedCFG, the resource analysis);
  # the editor-recovery paths (type_check_typed callers that never run the
  # analysis) lower the placeholder through the documented fallbacks.
  program: AnalyzedProgram
end


def type_env_new() -> TypeEnv
  var env = TypeEnv {
    type_list: Vec::new(),
    type_name_index: Map::new(),
    module_type_names: Map::new(),
    module_callable_types: Map::new(),
    callable_first_wins: Map::new(),
    type_id_index: Map::new(),
    type_id_counter: 100,
    layout_attrs: Map::new(),
    wcet_bounds: Map::new(),
    subst: Map::new(),
    var_counter: 0,
    scopes: Vec::new(),
    check_ctx: "",
    current_module_path: Vec::new(),
    strict_resolution: false,
    expected_return: Option::None,
    binding_plans: Map::new(),
    place_move_states: Map::new(),
    pattern_variant_resolutions: Map::new(),
    impls: Vec::new(),
    method_lookup: Map::new(),
    trait_contracts: Map::new(),
    trait_registry: Map::new(),
 # placeholder — rebuilt from the registered builtins at the end
    # of this function (build_lang_items must run AFTER every builtin
    # registration; -1 = "not registered at init").
    lang_items: LangItems {
      option: -1,
      result: -1,
      vec: -1,
      map: -1,
      set: -1,
      box_: -1,
      rc: -1,
      array: -1,
      slice: -1,
      string: -1,
      str_view: -1,
      unique_ptr: -1,
      arc_strong: -1,
      weak_rc: -1,
      weak_arc: -1,
      affine_handle: -1,
      ptr: -1,
      ptr_mut: -1,
      drop_trait: -1,
      clone_trait: -1,
      copy_trait: -1,
      eq_trait: -1,
      hash_trait: -1,
      transferable_trait: -1,
      shareable_trait: -1
    },
    const_values: Map::new(),
    param_for_type_impls: Vec::new(),
    param_bounds: Map::new(),
    pending_call_instances: Map::new(),
    non_send_types: Set::new(),
    non_sync_types: Set::new(),
    errors: Vec::new(),
    warnings: Vec::new(),
    typed_expr_types: Map::new(),
    local_id_counter: 0,
    local_ids: Vec::new(),
    resolutions: Option::None,
    typed_call_targets: Map::new(),
    typed_call_instances: Map::new(),
    typed_field_targets: Map::new(),
    typed_local_bindings: Map::new(),
    typed_ident_resolutions: Map::new(),
    param_binding_resolutions: Map::new(),
    pattern_binding_resolutions: Map::new(),
    typed_access_effects: Map::new(),
    typed_exprs: Map::new(),
    typed_stmts: Map::new(),
    typed_patterns: Map::new(),
    typed_aggregate_ownership: Map::new(),
    closure_captures: Map::new(),
    access_marker_depth: 0,
    generic_param_table: generic_param_table_new(),
    generic_param_ids: Map::new(),
    typed_fn_signatures: Map::new(),
    typed_static_types: Map::new(),
    type_prop_cache: Map::new(),
    effects: effect_registry_new(),
    typed_intrinsics: Map::new()
  }
  
 # documentation mirror of the std's concurrency exclusions —
  # kept populated as documentation; the is_send / is_sync checks consult
  # the obligation solver (trait Transferable / Shareable), not these sets.
  env.non_send_types.insert("Rc".to_string())
  env.non_sync_types.insert("Rc".to_string())
  env.non_sync_types.insert("Cell".to_string())
  env.non_sync_types.insert("RefCell".to_string())
  env.non_sync_types.insert("UnsafeCell".to_string())
  
  # Register primitive types
  register_primitive(&mut env, "Unit")
  register_primitive(&mut env, "Bool")
  register_primitive(&mut env, "Int")
  register_primitive(&mut env, "UInt")
  register_primitive(&mut env, "Float")
  register_primitive(&mut env, "Char")
  register_primitive(&mut env, "String")
  register_primitive(&mut env, "Never")
  
  # Register sized integer types
  register_primitive(&mut env, "i8")
  register_primitive(&mut env, "i16")
  register_primitive(&mut env, "i32")
  register_primitive(&mut env, "i64")
    register_primitive(&mut env, "i128")
  register_primitive(&mut env, "u8")
  register_primitive(&mut env, "u16")
  register_primitive(&mut env, "u32")
  register_primitive(&mut env, "u64")
    register_primitive(&mut env, "u128")
    register_primitive(&mut env, "isize")
    register_primitive(&mut env, "usize")
  register_primitive(&mut env, "f32")
  register_primitive(&mut env, "f64")
  
 # Register smart pointer types (explicit parameter names — the
  # arity-derived T/V/E helper is are not part of the model; every builtin declares its
 # GenericParamIds explicitly, ). each builtin
  # interns its parameters first (begin_builtin_generic — a fresh synthetic
  # owner, declaration order == id index), then the kind is constructed
  # with the interned ids.
  let ptr_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Ptr", ptr_ids, TypeDefKind::Opaque)
  let ptrmut_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "PtrMut", ptrmut_ids, TypeDefKind::Opaque)
  let box_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Box", box_ids, TypeDefKind::Opaque)
  let rc_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Rc", rc_ids, TypeDefKind::Opaque)
  
  # Register built-in generic types (Rust parity)
  let option_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Option", option_ids.clone(),
    TypeDefKind::Enum([
      VariantInfo { name: "Some", fields: [Type::Param(option_ids[0].clone())], discriminant: 0 },
      VariantInfo { name: "None", fields: Vec::new(), discriminant: 1 }
    ]))
  let result_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string(), "E".to_string()]))
  register_builtin_generic_named(&mut env, "Result", result_ids.clone(),
    TypeDefKind::Enum([
      VariantInfo { name: "Ok", fields: [Type::Param(result_ids[0].clone())], discriminant: 0 },
      VariantInfo { name: "Err", fields: [Type::Param(result_ids[1].clone())], discriminant: 1 }
    ]))
  let vec_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Vec", vec_ids.clone(),
    TypeDefKind::Struct([
      # The actual storage: ptr is a POINTER to the element buffer, not the
      # element itself (a bare T field would poison field typing, containment,
      # destruction, and generic substitution).
      FieldInfo { name: "ptr", ty: Type::Ptr(Type::Param(vec_ids[0].clone())), is_public: false },
      FieldInfo { name: "len", ty: Type::Int, is_public: true },
      FieldInfo { name: "cap", ty: Type::Int, is_public: false }
    ]))
 # Type representation collapse: Map/Set/Array ARE registered
  # as builtin Opaque generic types — the Adt form needs their TypeIds
  # (the RAW view is the "UnsafeSlice" builtin — the `slice` LangItems id).
  # Their LangItems ids (map/set/array/slice) are the special-behavior
  # selector of the Adt form (Type::Adt(tid, args)); the canonical variants
  # (Type::Map/Type::Set/Type::Array/Type::Slice) no longer exist. The std's
  # empty `struct Map[K: Hash + Eq, V]` / `struct Set[T: Hash + Eq]` stubs
  # are no-op re-registrations of these builtins (store_type_def's
  # empty-stub / builtin-Opaque paths keep the intrinsic TypeId), and the
  # Array name is special-cased before any name lookup. The SOURCE-spelled
  # "Slice" is NOT a builtin: it resolves to the std-declared SHARED struct
  # (the safe-view authority — see the UnsafeSlice registration below).
  let array_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Array", array_ids, TypeDefKind::Opaque)
  # THE ONE-REPRESENTATION AUTHORITY (P0 — the safe-view closure): the
  # SOURCE-spelled "Slice" name is NOT registered here — it resolves to
  # the std-declared SHARED/PINNED form (the `struct Slice[T] { inner:
  # ArcStrong[SliceBacking[T]] }` in std/collections.tg — the Arc-class
  # {ptr,len} handle). "UnsafeSlice" is the RAW view's builtin
  # registration — the 16-byte { ptr: Ptr[T], len: UInt } borrowed form,
  # the EXPLICIT unsafe/FFI-only spelling. The raw view is the `slice`
  # LangItems id (the escape checks / deinit plans / layout rows select
  # the raw form by that id); the shared form is an ordinary std struct
  # (its Arc field's Drop owns the destruction, its layout is computed
  # from its MirTypeDef — no name-based special case anywhere).
  let unsafe_slice_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "UnsafeSlice", unsafe_slice_ids, TypeDefKind::Opaque)
  let map_ids = begin_builtin_generic(&mut env, Vec::from(["K".to_string(), "V".to_string()]))
  register_builtin_generic_named(&mut env, "Map", map_ids, TypeDefKind::Opaque)
  let set_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_generic_named(&mut env, "Set", set_ids, TypeDefKind::Opaque)
  # Register Any as a built-in opaque type (resolved to a fresh type var in
  # type position; the registration keeps name lookups such as trait impl
  # resolution on `dyn Any` working).
  register_builtin_generic_named(&mut env, "Any", Vec::new(), TypeDefKind::Opaque)
  
 # Register built-in traits (Rust parity). each trait interns its
  # implicit parameters under its own synthetic owner, then the method
  # signatures are constructed with the interned ids.
  register_builtin_trait(&mut env, "Copy", Vec::new())
  register_builtin_trait(&mut env, "Drop", [
    MethodSig { name: "drop", params: Vec::new(), ret_type: Type::Unit, is_method: true }
  ])
  let clone_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string()]))
  register_builtin_trait(&mut env, "Clone", [
    MethodSig { name: "clone", params: Vec::new(), ret_type: Type::Param(clone_ids[0].clone()), is_method: true }
  ])
  register_builtin_trait(&mut env, "Display", [
    MethodSig { name: "to_string", params: Vec::new(), ret_type: Type::String, is_method: true }
  ])
  register_builtin_trait(&mut env, "Debug", [
    MethodSig { name: "debug_string", params: Vec::new(), ret_type: Type::String, is_method: true }
  ])
  let iterator_ids = begin_builtin_generic(&mut env, Vec::from(["Item".to_string()]))
  register_builtin_trait(&mut env, "Iterator", [
    # The builtin compound result is the Adt form (Option is a registered
    # builtin; builtin_adt resolves its LangItems TypeId).
    MethodSig { name: "next", params: Vec::new(), ret_type: builtin_adt(&env, "Option".to_string(), [Type::Param(iterator_ids[0].clone())]), is_method: true }
  ])
  register_builtin_trait(&mut env, "Send", Vec::new())
  register_builtin_trait(&mut env, "Sync", Vec::new())
  let eq_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string()]))
  register_builtin_trait(&mut env, "Eq", [
    MethodSig { name: "eq", params: [ParamType { ty: Type::Param(eq_ids[0].clone()), convention: AccessConvention::Let }], ret_type: Type::Bool, is_method: true }
  ])
  let ord_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string()]))
  register_builtin_trait(&mut env, "Ord", [
    MethodSig { name: "cmp", params: [ParamType { ty: Type::Param(ord_ids[0].clone()), convention: AccessConvention::Let }], ret_type: Type::Int, is_method: true }
  ])
  register_builtin_trait(&mut env, "Hash", [
    MethodSig { name: "hash", params: Vec::new(), ret_type: Type::Int, is_method: true }
  ])
  let default_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string()]))
  register_builtin_trait(&mut env, "Default", [
    MethodSig { name: "default", params: Vec::new(), ret_type: Type::Param(default_ids[0].clone()), is_method: false }
  ])
  let into_ids = begin_builtin_generic(&mut env, Vec::from(["T".to_string()]))
  register_builtin_trait(&mut env, "Into", [
    MethodSig { name: "into", params: Vec::new(), ret_type: Type::Param(into_ids[0].clone()), is_method: true }
  ])
  let from_ids = begin_builtin_generic(&mut env, Vec::from(["Self".to_string(), "T".to_string()]))
  register_builtin_trait(&mut env, "From", [
    MethodSig { name: "from", params: [ParamType { ty: Type::Param(from_ids[1].clone()), convention: AccessConvention::Let }], ret_type: Type::Param(from_ids[0].clone()), is_method: false }
  ])

 # the LangItems bundle is built AFTER every
  # builtin registration so the type_name_index / trait_registry lookups
  # resolve the intrinsic ids; uniqueness is asserted inside build_lang_items.
  env.lang_items = build_lang_items(&env)

  env
end

def register_primitive(inout env: TypeEnv, name: String) -> Unit
  let id_num = env.type_id_counter
  let id = TypeId { id: id_num }
  env.type_id_counter = env.type_id_counter + 1
  let td = TypeDef {
    id: id,
    name: name.clone(),
    def_kind: TypeDefKind::Primitive,
    generic_params: Vec::new(),
    kind: TypeKind::Value
    def: Option::None
  }
  env.type_name_index.insert(name, env.type_list.len())
  env.type_id_index.insert(id_num, env.type_list.len())
  env.type_list.push(td)
end

# Generic parameters are ALWAYS explicit — the old arity-derived T/V/E
# helper is not part of the model ("No arity-derived parameter names"):
# Result needs [T, E], Map needs [K, V], and the mechanical names would
# disagree with the variants' Param references. Every builtin declares its
# GenericParamIds explicitly via register_builtin_generic_named.

# begin a builtin registration's generic-parameter interning — a
# fresh synthetic owner DefId (the builtins have no resolver DefId) with
# the declared parameters interned in declaration order. Returns the ids;
# the call site constructs the registration's kind with
# Type::Param(ids[i]) — the names land in the param-name table here.
def begin_builtin_generic(inout env: TypeEnv, names: Vec[String]) -> Vec[GenericParamId]
  let owner = fresh_synthetic_owner(&mut env.generic_param_table)
  var ids = Vec::new()
  var i = 0
  while i < names.len() do
    ids.push(intern_generic_param(&mut env.generic_param_table, &owner, names[i].clone()))
    i = i + 1
  end
  ids
end

# a builtin type registration. The generic parameters were already
# interned (begin_builtin_generic — declaration order == id index); the
# kind's Param payloads already carry the ids.
def register_builtin_generic_named(inout env: TypeEnv, name: String, gen_params: Vec[GenericParamId], kind: TypeDefKind) -> Unit
  let id_num = env.type_id_counter
  let id = TypeId { id: id_num }
  env.type_id_counter = env.type_id_counter + 1
  let td = TypeDef {
    id: id,
    name: name.clone(),
    def_kind: kind,
    generic_params: gen_params,
    kind: TypeKind::Value
    def: Option::None
  }
  env.type_name_index.insert(name, env.type_list.len())
  env.type_id_index.insert(id_num, env.type_list.len())
  env.type_list.push(td)
end

# a builtin trait registration. Each builtin trait interns its
# implicit generic parameters (the trait's "Self", plus any trait-level
# parameter like Iterator's "Item" or Into/From's "T") under its OWN fresh
# synthetic owner (begin_builtin_generic), so no two traits' implicit
# parameters ever collide. The MethodSig payloads carry the ids.
def register_builtin_trait(inout env: TypeEnv, sink name: String, sink methods: Vec[MethodSig]) -> Unit
 # (impl conformance — validate-first-register-second): record the
  # builtin trait's CONTRACT under its TraitId — the MethodSig payloads as
  # registered (receiver-less signature stubs: has_receiver from is_method,
  # receiver_in_params FALSE — the impl's receiver position is a synthetic
  # wildcard at validation), with the implicit generic parameters
  # classified (Self = the implicit receiver, Item = an associated type,
  # everything else = a trait-level generic argument). A std source
  # re-declaration of the trait re-records the contract at pass-2
  # collection under the SAME TraitId when store_type_def's
  # identical-acceptance keeps the builtin id.
  let bt_contract = builtin_trait_contract(&env, &methods)
  let id_num = env.type_id_counter
  let id = TypeId { id: id_num }
  env.type_id_counter = env.type_id_counter + 1
  let td = TypeDef {
    id: id,
    name: name.clone(),
    def_kind: TypeDefKind::Trait(methods),
    generic_params: Vec::new(),
    kind: TypeKind::Value
    def: Option::None
  }
  env.type_name_index.insert(name.clone(), env.type_list.len())
  env.type_id_index.insert(id_num, env.type_list.len())
  env.type_list.push(td)
  env.trait_contracts.insert(id_num, bt_contract)
 # the builtin trait declarations register their TraitId (reusing
  # the TypeId value — the declaration is the identity) in the bare-name
  # registry. Builtins have NO resolver declaration (they are prelude
  # intrinsics registered before any module context exists), so the bare
  # entry is their identity and the module-qualified map records nothing
  # for them (no resolutions at env init); a std re-declaration of a
  # builtin trait re-registers the SAME builtin id (store_type_def's
  # identical-acceptance) under the std module's qualified key.
  env.trait_registry.insert(name, id_num)
end

# Build the CONTRACT of a builtin trait registration (register_builtin_trait).
# The MethodSig payloads are receiver-less signature stubs: has_receiver is
# derived from is_method and receiver_in_params is FALSE, so validation
# compares the impl's receiver position against a synthetic wildcard (any
# type, any convention — the builtin stub does not declare one). The
# implicit generic parameter ids referenced by the payloads are collected
# and classified by name: "Self" -> the implicit receiver (substituted
# with the impl's self type), "Item" -> an associated type (substituted
# with the impl's associated type), anything else -> a trait-level generic
# argument (substituted positionally against the impl's declared trait
# arguments).
def builtin_trait_contract(env: TypeEnv, methods: Vec[MethodSig]) -> TraitContract
  var seen = Vec::new()
  var mi = 0
  while mi < methods.len() do
    let ms = methods[mi]
    var pi = 0
    while pi < ms.params.len() do
      collect_builtin_param_ids(&ms.params[pi].ty, &mut seen)
      pi = pi + 1
    end
    collect_builtin_param_ids(&ms.ret_type, &mut seen)
    mi = mi + 1
  end
  var generic_params = Vec::new()
  var self_param_ids = Vec::new()
  var assoc_types = Vec::new()
  var assoc_param_ids = Vec::new()
  var max_idx = 0
  var di = 0
  while di < seen.len() do
    if (seen[di].index as Int) > max_idx then max_idx = seen[di].index as Int end
    di = di + 1
  end
  var oi = 0
  while oi <= max_idx do
    var found = Option::None
    var fi = 0
    while fi < seen.len() do
      if (seen[fi].index as Int) == oi then
        found = Option::Some(seen[fi])
      end
      fi = fi + 1
    end
    match found
    when Option::Some(gpid) then
      let pname = generic_param_name_of(&env.generic_param_table, &gpid)
      if pname == "Self" then
        self_param_ids.push(gpid)
      elsif pname == "Item" then
        assoc_param_ids.push(gpid)
        assoc_types.push(pname)
      else
        generic_params.push(gpid)
      end
    when Option::None then ()
    end
    oi = oi + 1
  end
  var tmethods = Vec::new()
  mi = 0
  while mi < methods.len() do
    let ms = methods[mi]
    var gnames = Vec::new()
    var gbounds = Vec::new()
    tmethods.push(TraitMethodContract {
      name: ms.name.clone(),
      params: ms.params.clone(),
      ret_type: ms.ret_type.clone(),
      has_receiver: ms.is_method,
      receiver_in_params: false,
      has_default: false,
      generic_param_names: gnames,
      generic_param_bounds: gbounds,
      declared_effects: Vec::new()
    })
    mi = mi + 1
  end
  TraitContract {
    generic_params: generic_params,
    self_param_ids: self_param_ids,
    assoc_types: assoc_types,
    assoc_param_ids: assoc_param_ids,
    methods: tmethods
  }
end

# Collect the GenericParamId references of one builtin method payload type
# into `seen` (deduplicated by id — the declaration order is recovered by
# index afterwards).
def collect_builtin_param_ids(ty: Type, inout seen: Vec[GenericParamId]) -> Unit
  match ty
  when Type::Param(gpid) then
    var i = 0
    var dup = false
    while i < seen.len() do
      if generic_param_id_eq(&seen[i], &gpid) then dup = true end
      i = i + 1
    end
    if !dup then seen.push(gpid) end
  when Type::Adt(_, args) then
    var i = 0
    while i < args.len() do
      collect_builtin_param_ids(&args[i], seen)
      i = i + 1
    end
  when Type::Tuple(fields) then
    var i = 0
    while i < fields.len() do
      collect_builtin_param_ids(&fields[i], seen)
      i = i + 1
    end
  when Type::FixedArray(elem, _) then collect_builtin_param_ids(elem, seen)
  when Type::FnPtr(params, ret, _) then
    var i = 0
    while i < params.len() do
      collect_builtin_param_ids(&params[i].ty, seen)
      i = i + 1
    end
    collect_builtin_param_ids(ret, seen)
  when Type::Closure(_, params, ret, captures, _) then
    var i = 0
    while i < params.len() do
      collect_builtin_param_ids(&params[i].ty, seen)
      i = i + 1
    end
    collect_builtin_param_ids(ret, seen)
    collect_builtin_param_ids(captures, seen)
  when Type::RefInternal(inner, _) then collect_builtin_param_ids(inner, seen)
  when Type::Ptr(inner) then collect_builtin_param_ids(inner, seen)
  when Type::PtrMut(inner) then collect_builtin_param_ids(inner, seen)
  when Type::Effect(_, inner) then collect_builtin_param_ids(inner, seen)
  when _ then ()
  end  end
end

# the LangItems build helpers. TypeId by name for
# the LangItems type fields; -1 when the name is not registered (only the
# std-declared traits at init — Transferable/Shareable; the nine type
# names are all registered builtins).
def lang_item_type_id(env: TypeEnv, name: String) -> Int
  match get_type_id_by_name(env, name)
  when Option::Some(tid) then tid.id
  when Option::None then -1
  end  end
end

# TraitId by name for the LangItems trait fields; -1 when the trait
# has no registry entry at the time of the lookup (Transferable/Shareable
# are std-declared — their TraitIds arrive via the source-trait
# registrations in pass 1/2). The LangItems bundle is built ONCE at env
# init, so this reads the BARE registry (the builtins — the only traits
# registered at init); the module-qualified map does not exist yet.
def lang_item_trait_id(env: TypeEnv, name: String) -> Int
  match env.trait_registry.get(name)
  when Option::Some(tid) then tid
  when Option::None then -1
  end  end
end

# Uniqueness invariant of the LangItems build (asserted structurally): every
# RESOLVED id must be distinct — the builtin registrations draw from one
# monotonic counter (type_id_counter), so a duplicate would be an internal
# error. A -1 sentinel (unregistered name) is skipped.
def lang_items_check_unique(inout seen: Set[Int], id: Int, what: String) -> Unit
  if id != -1 then
    if seen.contains(&id) then
      panic("ICE: LangItems builtin ids are not distinct (duplicate " + what + " = " + id.to_string() + ")")
    end
    seen.insert(id)
  end
end

# Build the LangItems bundle from the registered builtins. MUST run after
# every builtin registration (end of type_env_new) so the type_name_index /
# trait_registry lookups see the intrinsic ids.
def build_lang_items(env: TypeEnv) -> LangItems
  let items = LangItems {
    option: lang_item_type_id(env, "Option"),
    result: lang_item_type_id(env, "Result"),
    vec: lang_item_type_id(env, "Vec"),
    map: lang_item_type_id(env, "Map"),
    set: lang_item_type_id(env, "Set"),
    box_: lang_item_type_id(env, "Box"),
    rc: lang_item_type_id(env, "Rc"),
    array: lang_item_type_id(env, "Array"),
    # The `slice` LangItems id IS the RAW view — the registered builtin
    # "UnsafeSlice" (the 16-byte {ptr,len} borrowed form). The SAFE
    # source-spelled Slice is the std-declared shared struct (a distinct
    # TypeId, never a LangItems entry — it needs no special-case behavior).
    slice: lang_item_type_id(env, "UnsafeSlice"),
    string: lang_item_type_id(env, "String"),
    str_view: lang_item_type_id(env, "StrView"),
    unique_ptr: lang_item_type_id(env, "UniquePtr"),
    arc_strong: lang_item_type_id(env, "ArcStrong"),
    weak_rc: lang_item_type_id(env, "WeakRc"),
    weak_arc: lang_item_type_id(env, "WeakArc"),
    affine_handle: lang_item_type_id(env, "AffineHandle"),
    ptr: lang_item_type_id(env, "Ptr"),
    ptr_mut: lang_item_type_id(env, "PtrMut"),
    drop_trait: lang_item_trait_id(env, "Drop"),
    clone_trait: lang_item_trait_id(env, "Clone"),
    copy_trait: lang_item_trait_id(env, "Copy"),
    eq_trait: lang_item_trait_id(env, "Eq"),
    hash_trait: lang_item_trait_id(env, "Hash"),
    transferable_trait: lang_item_trait_id(env, "Transferable"),
    shareable_trait: lang_item_trait_id(env, "Shareable")
  }
  var seen: Set[Int] = Set::new()
  lang_items_check_unique(&mut seen, items.option, "option")
  lang_items_check_unique(&mut seen, items.result, "result")
  lang_items_check_unique(&mut seen, items.vec, "vec")
  lang_items_check_unique(&mut seen, items.map, "map")
  lang_items_check_unique(&mut seen, items.set, "set")
  lang_items_check_unique(&mut seen, items.box_, "box")
  lang_items_check_unique(&mut seen, items.rc, "rc")
  lang_items_check_unique(&mut seen, items.array, "array")
  lang_items_check_unique(&mut seen, items.slice, "slice")
  lang_items_check_unique(&mut seen, items.string, "string")
  lang_items_check_unique(&mut seen, items.ptr, "ptr")
  lang_items_check_unique(&mut seen, items.ptr_mut, "ptr_mut")
 # the std-declared type names resolve only at the post-pass-2 rebuild;
  # -1 at init is legal (no registration yet) — uniqueness is asserted only
  # for the resolved ids.
  if items.str_view != -1 then lang_items_check_unique(&mut seen, items.str_view, "str_view") end
  if items.unique_ptr != -1 then lang_items_check_unique(&mut seen, items.unique_ptr, "unique_ptr") end
  if items.arc_strong != -1 then lang_items_check_unique(&mut seen, items.arc_strong, "arc_strong") end
  if items.weak_rc != -1 then lang_items_check_unique(&mut seen, items.weak_rc, "weak_rc") end
  if items.weak_arc != -1 then lang_items_check_unique(&mut seen, items.weak_arc, "weak_arc") end
  if items.affine_handle != -1 then lang_items_check_unique(&mut seen, items.affine_handle, "affine_handle") end
  lang_items_check_unique(&mut seen, items.drop_trait, "drop_trait")
  lang_items_check_unique(&mut seen, items.clone_trait, "clone_trait")
  lang_items_check_unique(&mut seen, items.copy_trait, "copy_trait")
  lang_items_check_unique(&mut seen, items.eq_trait, "eq_trait")
  lang_items_check_unique(&mut seen, items.hash_trait, "hash_trait")
  if items.transferable_trait != -1 then lang_items_check_unique(&mut seen, items.transferable_trait, "transferable_trait") end
  if items.shareable_trait != -1 then lang_items_check_unique(&mut seen, items.shareable_trait, "shareable_trait") end
  items
end

# Helper to get type definition by TypeId
def get_type_by_id(env: TypeEnv, tid: TypeId) -> Option[TypeDef]
  match env.type_id_index.get(tid.id)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx])
  when Option::None then
    Option::None
  end  end
end

# FIX 2 (): reference-returning variants of the HOT lookups. The
# type-properties engine (type_named_props / is_named_trivially_copyable)
# and the concurrency classification fetch the same TypeDef repeatedly;
# returning a reference avoids the per-lookup TypeDef copy (the reviewer's
# performance finding — copying in a self-hosted compiler). The by-value
# versions above stay for the remaining callers.
#
# FIX 1 (, complete): every CONSUMER of the by-value lookups inside this
# module now goes through the reference-returning forms (get_type_by_id_ref
# / get_type_by_name_ref) — the two by-value definitions above are retained
# only as the exported copy-returning API for non-kernel modules
# (trait_resolve.tg) and must not be used for read-only lookups here.
def get_type_by_id_ref(env: TypeEnv, tid: TypeId) -> Option[TypeDef]
  match env.type_id_index.get(tid.id)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx].clone())
  when Option::None then
    Option::None
  end  end
end

def get_type_id_by_name(env: TypeEnv, name: String) -> Option[TypeId]
  match env.type_name_index.get(name)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx].id)
  when Option::None then
    Option::None
  end  end
end

def get_type_def_by_name(env: TypeEnv, name: String) -> Option[TypeDef]
  match env.type_name_index.get(name)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx])
  when Option::None then
    Option::None
  end  end
end

# FIX 2 (): reference-returning name lookup (companion of
# get_type_by_id_ref); by-name hot paths avoid the TypeDef copy.
def get_type_by_name_ref(env: TypeEnv, name: String) -> Option[TypeDef]
  match env.type_name_index.get(name)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx].clone())
  when Option::None then
    Option::None
  end  end
end

def type_kind_map(env: TypeEnv) -> Map[String, TypeKind]
  var m = Map::new()
  var i = 0
  while i < env.type_list.len() do
    m.insert(env.type_list[i].name.clone(), env.type_list[i].kind)
    i = i + 1
  end
  m
end

# Concrete ownership belongs to the TypeProperties engine
# (type_properties_of — keyed by the concrete type identity, TypeId plus
# substitutions), NOT to mutation of the nominal declaration's global
# TypeKind (the kind-propagation pass is are not part of the model; TypeDef.kind is the
# DECLARED kind only). A concrete type is resource-bearing for access
# purposes when it owns state (owns_state — the RESOURCE-CHECKING axis:
# String is owning even though it has no physical destructor), is linear,
# or is a capability. A type whose graph still contains an unsubstituted
# generic parameter (is_deferred) is treated as resource-bearing —
# FAIL-CLOSED: a generic local may require conditional drop after
# substitution, so an unknown answer must never degrade to "not owning"
# (the concrete answer appears after the MIR/mono substitution wave).
def type_has_resource_kind(inout env: TypeEnv, ty: Type) -> Bool
  let p = type_properties_of(env, ty)
  p.is_deferred || p.owns_state || p.is_linear || p.is_capability
end

pub def type_kinds_contain_resource(kinds: Map[Int, TypeKind], ty: Type) -> Bool
  match ty
  when Type::Adt(id, args) then
    match kinds.get(id.id)
    when Option::Some(k) then
      if k == TypeKind::Resource then
        true
      elsif k == TypeKind::Capability then
        true
      else
        type_args_contain_resource(kinds, &args)
      end
    when Option::None then type_args_contain_resource(kinds, &args)
    end
  when Type::Tuple(fields) then
    type_fields_contain_resource(kinds, &fields)
  when Type::FixedArray(elem, _) then type_kinds_contain_resource(kinds, &elem)
  when Type::FnPtr(_, _, _) then false
 # a closure's kind containment derives from its capture tuple.
  when Type::Closure(_, _, _, captures, _) then type_kinds_contain_resource(kinds, &captures)
  when Type::RefInternal(inner, _) then type_kinds_contain_resource(kinds, &inner)
  when _ then false
  end  end
end

def type_args_contain_resource(kinds: Map[Int, TypeKind], args: Vec[Type]) -> Bool
  mut i = 0
  while i < args.len() do
    if type_kinds_contain_resource(kinds, &args[i]) then
      return true
    end
    i = i + 1
  end
  false
end

def type_fields_contain_resource(kinds: Map[Int, TypeKind], fields: Vec[Type]) -> Bool
  mut i = 0
  while i < fields.len() do
    if type_kinds_contain_resource(kinds, &fields[i]) then
      return true
    end
    i = i + 1
  end
  false
end

# NOTE: the kind-propagation pass and its type-params helper are
# is not part of the model. Concrete ownership is computed by the TypeProperties engine
# (type_properties_of, keyed by the concrete type identity (TypeId,
# substitutions)) — never by mutating the nominal declaration's global
# TypeKind. The type_kinds map snapshot (type_kind_map / TypedProgram.
# type_kinds) carries the DECLARED kinds only; the ownership consumers
# (resource_check.tg, mir.tg) query the engine through the snapshot env
# (engine_snapshot_env), and the declared-kind table is read only for the
# declared Capability marker (resource_check.tg's capability-containment
# gap — PENDING, docs/memory_model.md §15.2).

def type_def_is_filled(td: TypeDef) -> Bool
  match td.def_kind
  when TypeDefKind::Struct(fields) then fields.len() > 0
  when TypeDefKind::Enum(variants) then variants.len() > 0
  when TypeDefKind::Trait(methods) then methods.len() > 0
  when TypeDefKind::Primitive then true
  when TypeDefKind::Alias(ty) then true
  when TypeDefKind::Opaque then true
  when _ then false
  end  end
end

# A pre-registered placeholder from pre_register_type_name (pass 1): an
# EMPTY Struct/Enum/Trait or an Alias(Unit) — the two-pass registration
# pattern, NOT a duplicate. The first real definition replaces it.
def type_def_is_forward_declaration(td: TypeDef) -> Bool
  match td.def_kind
  when TypeDefKind::Struct(fields) then fields.len() == 0
  when TypeDefKind::Enum(variants) then variants.len() == 0
  when TypeDefKind::Trait(methods) then methods.len() == 0
  when TypeDefKind::Alias(ty) then
    match ty
    when Type::Unit then true
    when _ then false
    end
  when _ then false
  end  end
end

# An EMPTY source-level declaration (e.g. `struct Vec[T]` / `struct Map[K, V]`
# stubs in std/collections.tg for compiler intrinsics). It declares no fields
# or variants of its own, so it is a no-op re-registration of the SAME type,
# never a distinct definition.
def type_def_is_empty_stub(td: TypeDef) -> Bool
  match td.def_kind
  when TypeDefKind::Struct(fields) then fields.len() == 0
  when TypeDefKind::Enum(variants) then variants.len() == 0
  when TypeDefKind::Trait(methods) then methods.len() == 0
  when _ then false
  end  end
end

# is this definition a TRAIT declaration? The trait-name resolution
# (trait_id_for) filters the module-qualified map to Trait-typed entries —
# a same-named struct in another module is a different namespace and never
# counts toward trait ambiguity.
def type_def_is_trait(td: TypeDef) -> Bool
  match td.def_kind
  when TypeDefKind::Trait(_) then true
  when _ then false
  end  end
end

# Whether two type definitions are structurally IDENTICAL — a re-registration
# of the same type (permitted), as opposed to two genuinely different types
# that happen to share a name (a duplicate — TypeError). Compared on the
# canonical identity keys so generic params and field/variant shapes decide.
def type_defs_identical(env: TypeEnv, a: TypeDef, b: TypeDef) -> Bool
  if a.generic_params.len() != b.generic_params.len() then return false end
  var gi = 0
  while gi < a.generic_params.len() do
 # generic-parameter identity is the GenericParamId (a
    # re-registration interns its own ids — the DECLARED ORDER and the
    # param-name table renderings decide the identity comparison; the ids
    # of two registrations of the same declaration need not match).
    let a_name = generic_param_name_of(&env.generic_param_table, &a.generic_params[gi])
    let b_name = generic_param_name_of(&env.generic_param_table, &b.generic_params[gi])
    if a_name != b_name then return false end
    gi = gi + 1
  end
  match a.def_kind
  when TypeDefKind::Struct(fa) then
    match b.def_kind
    when TypeDefKind::Struct(fb) then
      if fa.len() != fb.len() then return false end
      var i = 0
      while i < fa.len() do
        if fa[i].name != fb[i].name then return false end
        if type_identity_key(env, &fa[i].ty) != type_identity_key(env, &fb[i].ty) then return false end
        i = i + 1
      end
      true
    when _ then false
    end
  when TypeDefKind::Enum(va) then
    match b.def_kind
    when TypeDefKind::Enum(vb) then
      if va.len() != vb.len() then return false end
      var i = 0
      while i < va.len() do
        if va[i].name != vb[i].name then return false end
        if va[i].discriminant != vb[i].discriminant then return false end
        if va[i].fields.len() != vb[i].fields.len() then return false end
        var j = 0
        while j < va[i].fields.len() do
          if type_identity_key(env, &va[i].fields[j]) != type_identity_key(env, &vb[i].fields[j]) then return false end
          j = j + 1
        end
        i = i + 1
      end
      true
    when _ then false
    end
  when TypeDefKind::Trait(ma) then
    match b.def_kind
    when TypeDefKind::Trait(mb) then
      if ma.len() != mb.len() then return false end
      var i = 0
      while i < ma.len() do
        if ma[i].name != mb[i].name then return false end
        i = i + 1
      end
      true
    when _ then false
    end
  when TypeDefKind::Alias(ta) then
    match b.def_kind
    when TypeDefKind::Alias(tb) then type_identity_key(env, &ta) == type_identity_key(env, &tb)
    when _ then false
    end
  when TypeDefKind::Primitive then
    match b.def_kind
    when TypeDefKind::Primitive then true
    when _ then false
    end
  when TypeDefKind::Opaque then
    match b.def_kind
    when TypeDefKind::Opaque then true
    when _ then false
    end
  end
end

# (next layer): record the module-qualified type-name entry
# "path::name" -> type_list index for a type registered from module_path.
# The key is recorded only when the resolver's module_symbols snapshot
# holds a DefKind::TypeName or DefKind::Trait entry for exactly this
# (path, name) pair (structs/enums/aliases carry TypeName entries; TRAITS
# carry Trait entries — the trait's TypeDef participates in the
# module-qualified map so a DISTINCT declaration in a different module
# gets its own module-local TypeId, the declaration identity the TraitId
# mirrors). Capabilities, builtins and legitimate re-registrations record
# nothing. The bare first-wins entry in type_name_index is untouched.
# Idempotent: pass-1 placeholders and pass-2 fills record the same index.
def record_module_type_name(inout env: TypeEnv, name: String, idx: Int, module_path: Vec[String]) -> Unit
  match env.resolutions
  when Option::Some(res) then
    let key = module_qualified_key(module_path, &name)
    match res.module_symbols.get(&key)
    when Option::Some(did) then
 # the DefKind is metadata — the resolver's def_kinds snapshot.
      match def_kind_of(&res, &did)
      when Option::Some(k) then
        if k == DefKind::TypeName || k == DefKind::Trait then
          env.module_type_names.insert(key, idx)
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when Option::None then ()
  end  end
end

# (final layer): at callable registration (pass 3), mirror the
# resolver's module-qualified entry "path::name" -> Type, guarded by the
# resolver's module_symbols DefKind entry for exactly this (path, name,
# kind) triple (lookup_module_callable — so a type name and a function name
# never collide through this path), and record the bare-name FIRST
# registration's Type as the recoverable first-wins fallback for ambiguous
# bare callable references (the first registration in program order, matching
# the resolver's bare-name first-wins tables). Idempotent: one callable
# registration happens per item in pass 3.
def record_module_callable(inout env: TypeEnv, name: String, ty: Type, module_path: Vec[String], kind: DefKind) -> Unit
  env.module_callable_types.insert(module_qualified_key(module_path, &name), ty.clone())
  if !env.callable_first_wins.contains_key(&name) then
    env.callable_first_wins.insert(name, ty.clone())
  end
end

# (next layer): is the bare first-wins definition of `name` the one
# registered from `module_path`? True when the module-qualified entry for
# this (path, name) pair points at the same type_list index as the bare
# first-wins entry — i.e. this module IS the first-wins module, so a
# second registration of the same name here is a same-module duplicate.
def module_is_first_wins_owner(env: TypeEnv, name: String, module_path: Vec[String]) -> Bool
  let key = module_qualified_key(module_path, name)
  match env.type_name_index.get(name.clone())
  when Option::Some(bare_idx) then
    match env.module_type_names.get(key)
    when Option::Some(q_idx) then q_idx == bare_idx
    when Option::None then false
    end
  when Option::None then false
  end
end

# (next layer): does the type checker's module-qualified map hold any
# entry for this bare name? False for builtin first-wins entries
# (primitives, Option/Result/Vec, opaques, builtin traits), whose FIRST
# source-level re-registration (e.g. std re-declaring the builtin
# Option/Result) keeps today's intrinsic-stub/identical semantics — the
# intrinsic keeps its TypeId and the re-registration records its qualified
# entry; any FURTHER module's definition of such a name is a module-local
# type (every declaration is its own type).
def has_qualified_type_entry(env: TypeEnv, name: String) -> Bool
  for (key, _) in env.module_type_names.entries() do
    if key == name.clone() then
      return true
    end
    let suffix = "::" + name.clone()
    if key.ends_with(suffix) then
      return true
    end
  end
  false
end

# (next layer): resolve a type name to its TypeId, preferring the
# current module's own module-qualified identity over the bare first-wins
# entry. Falls back to the bare entry when no qualified entry exists
# (builtins, traits, aliases, capabilities — compatibility behavior).
def get_type_id_by_qualified_name(env: TypeEnv, name: String, module_path: Vec[String]) -> Option[TypeId]
  let key = module_qualified_key(module_path, &name)
  match env.module_type_names.get(key)
  when Option::Some(idx) then
    Option::Some(env.type_list[idx].id)
  when Option::None then
    match env.type_name_index.get(name)
    when Option::Some(idx) then
      Option::Some(env.type_list[idx].id)
    when Option::None then
      Option::None
    end
  end
end

# (next layer): resolve a bare type name to a type_list index. When
# the same bare name is registered from multiple module paths, the current
# module's own definition shadows the others (local-module preference);
# with no local definition and >= 2 DISTINCT foreign types under the name
# the reference is genuinely ambiguous — the ambiguity TypeError fires and
# the first-wins entry is returned as the recoverable fallback
# (compatibility behavior).: every declaration is
# its own type — two IDENTICAL declarations in different modules are still
# two DISTINCT types (a::Point and b::Point), so they DO count toward the
# ambiguity, never as one shared type. With no qualified entries at all
# (builtin first-wins, permissive recovery without resolutions), the
# first-wins bare entry resolves unchanged. Conservative: never errors on a
# single definition.
def resolve_bare_type_name(inout env: TypeEnv, name: String, span: Span) -> Option[Int]
  var own_idx = Option::None
  var foreign_distinct = 0
  var foreign_seen = Map::new()
  let own_key = module_qualified_key(&env.current_module_path, &name)
  let entry_vec = env.module_type_names.entries()
  for (key, idx) in entry_vec do
    var matches = false
    if key == name.clone() then
      matches = true
    else
      let suffix = "::" + name.clone()
      if key.ends_with(suffix) then
        matches = true
      end
    end
    if matches then
      if key == own_key then
        own_idx = Option::Some(idx)
      elsif !foreign_seen.contains_key(&idx) then
        foreign_seen.insert(idx, true)
        foreign_distinct = foreign_distinct + 1
      end
    end
  end
  match own_idx
  when Option::Some(idx) then
    Option::Some(idx)
  when Option::None then
    if foreign_distinct >= 2 then
      type_add_error(env, "ambiguous type name `" + name + "`: defined in multiple modules; qualify the path", span)
    end
    match env.type_name_index.get(name)
    when Option::Some(idx) then Option::Some(idx)
    when Option::None then Option::None
    end
  end
end

# (final layer): is `name` resolved from the pass-3 program-level
# callable bindings (scope 0)? Locals/parameters/loop bindings live in inner
# scopes (>= 1) and shadow program-level callables — they must bypass the
# module-qualified identity check. Scope 0 holds ONLY the pass-3
# function/const/static bindings (every pass-4 body scope is pushed and
# popped), so a name whose outermost binding is scope 0 is a callable
# reference.
def var_is_global_callable(env: TypeEnv, name: String) -> Bool
  if env.scopes.len() == 0 then return false end
  if !env.scopes[0].contains_key(name) then return false end
  var i = env.scopes.len()
  while i > 1 do
    i = i - 1
    if env.scopes[i].contains_key(name) then return false end
  end
  true
end

# (final layer): resolve a bare callable name (function/constant/static
# in expression position) to its Type. When the resolver's module_symbols
# holds >= 2 DISTINCT qualified definitions of the bare name (counted by
# DefId across the Function/Constant/Static kinds — the kind filter keeps a
# type name and a function name from colliding through this path), the
# CURRENT module's own definition shadows the others (local-module
# preference); with no own definition the reference is genuinely ambiguous —
# the TypeError fires and the FIRST-wins Type is the recoverable fallback
# (compatibility behavior, matching the resolver's bare-name first-wins
# tables). Fewer than 2 distinct qualified definitions — the bootstrap's
# module_symbols holds at most one per bare callable name — resolve
# unchanged. Conservative: never errors on a single definition.
def resolve_bare_callable(inout env: TypeEnv, name: String, span: Span, fallback: Type) -> Type
  match env.resolutions
  when Option::Some(res) then
    var own_ty = Option::None
    let own_key = module_qualified_key(&env.current_module_path, &name)
    match env.module_callable_types.get(own_key)
    when Option::Some(ty) then own_ty = Option::Some(ty.clone())
    when Option::None then ()
    end
    var foreign_distinct = 0
    var foreign_seen = Map::new()
    let suffix = "::" + name.clone()
    let entry_vec = res.module_symbols.entries()
    for (key, did) in entry_vec do
 # the DefKind is metadata — the resolver's def_kinds snapshot.
      let did_kind = match def_kind_of(&res, &did)
      when Option::Some(k) then k
      when Option::None then DefKind::Other
      end
      if did_kind == DefKind::Function || did_kind == DefKind::Constant || did_kind == DefKind::Static then
        var matches = false
        if key == name.clone() then
          matches = true
        elsif key.ends_with(suffix) then
          matches = true
        end
        if matches && key != own_key then
 # the dedup key renders the DefId's module path (recovered
          # from this entry's module-qualified key — the resolver's
          # module_path_of logic; the keys are built from Program.crate
          # module paths) + index + kind from the def_kinds snapshot.
          let did_path = match key.rfind("::")
          when Option::Some(pos) then key.slice(0, pos).split("::")
          when Option::None then Vec::new()
          end
          let dkey = fn_owner_key(did_path.join("::"), did.index, did_kind)
          if !foreign_seen.contains_key(&dkey) then
            foreign_seen.insert(dkey, true)
            foreign_distinct = foreign_distinct + 1
          end
        end
      end
    end
    match own_ty
    when Option::Some(ty) then
      ty
    when Option::None then
      if foreign_distinct >= 2 then
        type_add_error(env, "ambiguous name `" + name + "`: defined in multiple modules; qualify the path", span)
        match env.callable_first_wins.get(name.clone())
        when Option::Some(ty) then ty.clone()
        when Option::None then fallback
        end
      else
        fallback
      end
    end
  when Option::None then
    fallback
  end  end
end

# (module graph consumption): resolve the owner module path of a flat
# item index by its stamped OWNER ModuleId (Item.owner_module — assigned at
# the construction sites, see ast.tg) — the O(1) shared table read
# (program.crate.modules.get(owner), the SAME authority the resolver's
# module_path_of_item_resolver consumes). STRICT (the compile path): a
# missing module table entry is an internal compiler error — it never
# falls back to the root module (id 0, empty path). Returns the owner path
# and the owner ModuleId.id. The caller threads the returned id (the old
# pointer position is are not part of the model — the crate is a Map, so the scan is direct,
# not a pointer advance).
def module_path_of_item(program: Program, module_ptr: Int, item_idx: Int) -> (Vec[String], Int)
 # the item's OWNER ModuleId is stamped at assembly — the module table
  # read replaces the [start, end) item-range containment scan (Crate
  # modules now carry their items: Module.items: Vec[ItemId]).
  if item_idx < program.items.len() then
    let owner = program.items[item_idx].owner_module
    match program.crate.modules.get(owner)
    when Option::Some(info) then
      var owner_path = Vec::new()
      for seg in info.path do
        owner_path.push(seg.clone())
      end
      return (owner_path, owner.id)
    when Option::None then
      panic("internal error: ModuleId " + owner.id.to_string() + " (owner of item " + item_idx.to_string() + ") is not a key of Crate.modules — the compile path never falls back to the root module")
    end
  end
  panic("internal error: item index " + item_idx.to_string() + " is out of bounds for Program.items (len " + program.items.len().to_string() + ") — the compile path never fabricates a root-module owner")
end

# store a collected type definition, REJECTING
# duplicate definitions instead of merging same-named distinct types. The
# NOMINAL identity of a type is its DECLARATION: two declarations with the
# same name in DIFFERENT modules are DISTINCT types, each with its own
# TypeId — there is NO cross-module structural merging (a::Point and
# b::Point are never the same type, even when structurally identical; the
# qualified-name entries module_type_names give each module's name its own
# TypeId). Legitimate re-registrations of the SAME declaration are: a
# forward-declaration placeholder being filled (pass 1 -> pass 2), an EMPTY
# source-level stub of an already-registered type (std's intrinsic struct
# stubs), a builtin Opaque placeholder (Box/Rc/Ptr...) receiving its
# source-level shape, and a structurally IDENTICAL definition registered
# within the SAME module (re-registration of the same declaration — e.g.
# std/core.tg re-declaring the builtin Option/Result, which keeps the
# intrinsic TypeId, and std's intrinsic stub re-declarations). Anything
# else is a "duplicate type definition" TypeError — fields/variants are
# NEVER merged across distinct declarations.
#
# (module-qualified type identity): every registration also records
# the module-qualified entry "path::name" (module_type_names). A genuinely
# DISTINCT definition — or an IDENTICAL definition — registered from a
# DIFFERENT module path is a separate module-local type: it is accepted
# with its OWN fresh TypeId under its qualified key, while the bare
# first-wins entry stays untouched. Same-module redefinition remains the
# duplicate TypeError (the identical-acceptance applies ONLY within the
# same module).
#
# (TypeId -> DefId at registration): the registration RECORDS the
# declaration's resolver DefId — the module_symbols DefKind::TypeName /
# DefKind::Trait entry for exactly this (module_path, name) pair — on the
# TypeDef (TypeDef.def; the value is owned here and pushed into
# env.type_list, so the fill lands with the record). The serialized
# association (ResolvedNames.type_def_ids: TypeId.id -> DefId) is built
# from the filled TypeDefs once at type_check_typed's tail (the snapshot
# the MIR/ABI consumers read). The public ABI's type-to-declaration
# association is DIRECT through that identity (no name/order correlation);
# a type the resolver never registered (a builtin, a compiler-synthesized
# type) carries Option::None / no entry.
def store_type_def(inout env: TypeEnv, inout td: TypeDef, span: Span, module_path: Vec[String]) -> Unit
  match env.resolutions
  when Option::Some(res) then
    let key = module_qualified_key(module_path, &td.name)
    match res.module_symbols.get(&key)
    when Option::Some(did) then
      match def_kind_of(&res, &did)
      when Option::Some(k) then
        if k == DefKind::TypeName || k == DefKind::Trait then
          td.def = Option::Some(did.clone())
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
  match get_type_by_name_ref(env, td.name.clone())
  when Option::Some(existing) then
    if type_def_is_forward_declaration(existing) then
      # A pass-1 placeholder being filled (pass 2): fall through to the
      # replace path below — the ONLY path that reaches it.
      ()
    else
      # A filled existing definition: allow only legitimate re-registrations.
      if type_def_is_empty_stub(&td) then
        # Source-level stub of the same type (intrinsic struct stubs) — no-op.
        return
      end
      if type_defs_identical(env, existing, &td) then
 # re-registration of the SAME declaration —
        # the identical-acceptance applies ONLY within the same module (this
        # module IS the first-wins owner) or when the existing entry has no
        # module ownership at all (no qualified entries: a builtin/intrinsic
        # first-wins such as the std re-declaring the builtin Option/Result —
        # the intrinsic TypeId is kept — and permissive recovery without
        # resolutions, where no module identity exists). An IDENTICAL
        # declaration registered from a DIFFERENT module is a DISTINCT type:
        # nominal identity is the declaration, so it gets its OWN fresh
        # TypeId under its module-qualified key (a::Point and b::Point are
        # never the same type) — it falls through to the module-local-type
        # block below.
        if module_is_first_wins_owner(env, &td.name, module_path) || !has_qualified_type_entry(env, &td.name) then
          match env.type_name_index.get(td.name)
          when Option::Some(bare_idx) then
            record_module_type_name(env, td.name.clone(), bare_idx, module_path)
          when Option::None then ()
          end
          return
        end
      else
        match existing.def_kind
        when TypeDefKind::Opaque then
          # A builtin Opaque placeholder (Box/Rc/Ptr/PtrMut/Array/Slice/Any)
          # keeps its intrinsic semantics; the source-level shape of the SAME
          # compiler intrinsic is a re-registration, not a distinct type.
          return
        when _ then ()
        end
      end
      # A genuinely DISTINCT definition or an identical definition from a
      # DIFFERENT module: if the first-wins definition belongs to a DIFFERENT
      # module (a qualified entry exists for the name and none of them is
      # this module's own first-wins entry), this is a separate module-local
      # type — accept it under its module-qualified key with a fresh TypeId
      # (the collect path reused the bare first-wins id, which must not leak
      # into a second type). Otherwise it is a same-module duplicate.
      if has_qualified_type_entry(env, &td.name) && !module_is_first_wins_owner(env, &td.name, module_path) then
        let fresh_id = TypeId { id: env.type_id_counter }
        env.type_id_counter = env.type_id_counter + 1
        let own_td = TypeDef {
          id: fresh_id,
          name: td.name.clone(),
          def_kind: td.def_kind,
          generic_params: td.generic_params.clone(),
          kind: td.kind
          def: td.def.clone()
        }
        let new_idx = env.type_list.len()
        env.type_id_index.insert(fresh_id.id, new_idx)
        env.type_list.push(own_td)
        record_module_type_name(env, td.name.clone(), new_idx, module_path)
        return
      end
      type_add_error(env, "duplicate type definition `" + td.name + "`", span)
      return
    end
  when Option::None then ()
  end
  match env.type_name_index.get(td.name)
  when Option::Some(idx3) then
    env.type_list.set(idx3, td)
    env.type_name_index.insert(td.name.clone(), idx3)
    env.type_id_index.insert(td.id.id, idx3)
    record_module_type_name(env, td.name.clone(), idx3, module_path)
    return
  when Option::None then
    env.type_name_index.insert(td.name.clone(), env.type_list.len())
    env.type_id_index.insert(td.id.id, env.type_list.len())
    env.type_list.push(td)
    record_module_type_name(env, td.name.clone(), env.type_list.len() - 1, module_path)
  end  end
end

# ———————————————————————————————————————————————————————————————
# Scope Management
# ———————————————————————————————————————————————————————————————

def push_scope(inout env: TypeEnv) -> Unit
  let m: Map[String, Type] = Map::new()
  env.scopes.push(m)
  let lm: Map[String, Int] = Map::new()
  env.local_ids.push(lm)
end

def pop_scope(inout env: TypeEnv) -> Unit
  env.scopes.pop()
  env.local_ids.pop()
  ()
end

def bind_var(inout env: TypeEnv, name: String, ty: Type) -> Unit
  if !env.scopes.is_empty() then
    let idx = env.scopes.len() - 1
    env.scopes[idx].insert(name.clone(), ty.clone())
    env.local_ids[idx].insert(name.clone(), env.local_id_counter)
    env.typed_local_bindings.insert(env.local_id_counter, LocalBinding { name: name.clone(), ty: ty })
    env.local_id_counter = env.local_id_counter + 1
  end
end

def lookup_var(env: TypeEnv, name: String) -> Option[Type]
  var i = env.scopes.len()
  while i > 0 do
    i = i - 1
    match env.scopes[i].get(&name)
    when Option::Some(ty) then return Option::Some(ty)
    when Option::None then ()
    end
  end
  Option::None
end

# Sentinel for "no local": local ids are always >= 0, so a NEGATIVE sentinel
# can never collide with a real local (previously 0 was used — 0 is also the
# first real local id, making capture/scan checks ambiguous).
const NO_LOCAL_ID: Int = -1

def local_id_of(env: TypeEnv, name: String) -> Int
  var i = env.local_ids.len()
  while i > 0 do
    i = i - 1
    match env.local_ids[i].get(&name)
    when Option::Some(id) then return id
    when Option::None then ()
    end
  end
  NO_LOCAL_ID
end

# ———————————————————————————————————————————————————————————————
# Type Variable Operations
# ———————————————————————————————————————————————————————————————

def fresh_type_var(inout env: TypeEnv) -> Type
  let id = TypeVarId { id: env.var_counter }
  env.var_counter = env.var_counter + 1
  Type::Var(id)
end

# Create fresh type variables for each generic parameter of a type definition.
# This ensures Type::Adt is always created with the correct number of type args.
def fresh_type_args_for(inout env: TypeEnv, td: TypeDef) -> Vec[Type]
  var args = Vec::new()
  var i = 0
  while i < td.generic_params.len() do
    args.push(fresh_type_var(env))
    i = i + 1
  end
  args
end

# Convert a TypeDef to its Type representation.
# For primitives (Int, String, etc.) this returns the canonical Type variant.
# For user-defined types (structs, enums) and every builtin compound
# (Option/Slice/Array/Map/Set/Box/Rc/Vec — all registered), this returns
# the Adt form Type::Adt(<builtin TypeId>, args) with fresh type args; the
# canonical compound variants no longer exist (type representation
# collapse).
def type_def_to_canonical(inout env: TypeEnv, td: TypeDef) -> Type
  let name = td.name
  if name == "Unit" then Type::Unit
  elsif name == "Bool" then Type::Bool
  elsif name == "Int" then Type::Int
  elsif name == "UInt" then Type::UInt
  elsif name == "Float" then Type::Float
  elsif name == "Char" then Type::Char
  elsif name == "String" then Type::String
  elsif name == "Never" then Type::Never
  elsif name == "I8" then Type::I8
  elsif name == "I16" then Type::I16
  elsif name == "I32" then Type::I32
  elsif name == "I64" then Type::I64
  elsif name == "I128" then Type::I128
  elsif name == "U8" then Type::U8
  elsif name == "U16" then Type::U16
  elsif name == "U32" then Type::U32
  elsif name == "U64" then Type::U64
  elsif name == "U128" then Type::U128
  elsif name == "ISize" then Type::ISize
  elsif name == "USize" then Type::USize
  elsif name == "F32" then Type::F32
  elsif name == "F64" then Type::F64
  elsif name == "Option" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Option".to_string(), args)
    else builtin_adt(env, "Option".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Result" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 2 then builtin_adt(env, "Result".to_string(), args)
    else builtin_adt(env, "Result".to_string(), [fresh_type_var(env), fresh_type_var(env)])
    end
  elsif name == "UnsafeSlice" then
    # The RAW {ptr,len} view builtin (LangItems slice id): the explicit
    # unsafe/FFI spelling. The SOURCE-spelled "Slice" is NOT this arm —
    # it resolves to the std-declared shared struct (the fallthrough
    # below, which builds the Adt form of the std Slice).
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "UnsafeSlice".to_string(), args)
    else builtin_adt(env, "UnsafeSlice".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Array" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Array".to_string(), args)
    else builtin_adt(env, "Array".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Map" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 2 then builtin_adt(env, "Map".to_string(), args)
    else builtin_adt(env, "Map".to_string(), [fresh_type_var(env), fresh_type_var(env)])
    end
  elsif name == "Set" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Set".to_string(), args)
    else builtin_adt(env, "Set".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Ptr" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then Type::Ptr(args[0])
    else Type::Ptr(fresh_type_var(env))
    end
  elsif name == "PtrMut" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then Type::PtrMut(args[0])
    else Type::PtrMut(fresh_type_var(env))
    end
  elsif name == "Box" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Box".to_string(), args)
    else builtin_adt(env, "Box".to_string(), [fresh_type_var(env)])
    end
  elsif name == "Rc" then
    let args = fresh_type_args_for(env, td)
    if args.len() >= 1 then builtin_adt(env, "Rc".to_string(), args)
    else builtin_adt(env, "Rc".to_string(), [fresh_type_var(env)])
    end
  else
    Type::Adt(td.id, fresh_type_args_for(env, td))
  end
end

# ———————————————————————————————————————————————————————————————
# Type representation: the DUAL representation is are not part of the model.
#
# The canonical Type variants (Type::Option, Type::Result, Type::Map,
# Type::Set, Type::Box, Type::Rc, Type::Array, Type::Slice) were REMOVED
# from the Type enum. The Adt form Type::Adt(TypeId, Vec[Type]) is the ONE
# representation of every nominal type, builtin or user-defined; the
# LangItems ids (option/result/vec/map/set/box_/rc/array/slice) select the
# builtin special behaviors. builtin_adt below is the single construction
# helper (it resolves the registered LangItems TypeId by name and
# constructs Type::Adt directly — the canonical-variant fallback is are not part of the model).
# normalize_adt_for_unify retains only the NON-canonical normalizations at
# unify's entry (aliases, primitive spellings, Ref/RefMut/Ptr unwrapping,
# the Rc-of-resource policy, the id-0 placeholder guard) — the Adt forms
# pass through unchanged. NOTE: the heap-vector Array Adt carries no size
# (its identity is the element); the fixed-array size lives in the DISTINCT
# Type::FixedArray(elem, n) variant built from the [T; N] annotation.
# ———————————————————————————————————————————————————————————————

# The Adt form for a builtin compound type:
# Type::Adt(<the registered LangItems TypeId for `name`>, args).
# Registration verification is part of the contract: the id must exist via
# type_name_index. All nine names (Option/Result/Vec/Map/Set/Box/Rc/Array/
# Slice) are registered builtins (init_type_env), so the lookup succeeds;
# an unverifiable name fails CLOSED with Type::Error — a Type::Adt with an
# unverifiable id is never produced. The resolved id is exactly the
# LangItems id (build_lang_items reads the same type_name_index).
def builtin_adt(env: TypeEnv, name: String, args: Vec[Type]) -> Type
  match get_type_id_by_name(env, name.clone())
  when Option::Some(tid) then
    Type::Adt(tid, args)
  when Option::None then
    Type::Error
  end  end
end

# Normalize an Adt before unification: resolve type ALIASES to their
# underlying type, map the Named primitive spellings (c-FFI aliases,
# capitalizations) to the canonical primitive variants, unwrap the
# Ref/RefMut alias names to their payload, map Ptr/PtrMut names to the
# pointer variants, enforce the Rc-of-resource policy, and guard the
# bogus id-0 placeholder. The builtin compound names are NOT normalized
# (their Adt form IS the representation — the canonical variants no
# longer exist); they pass through unchanged.
def normalize_adt_for_unify(inout env: TypeEnv, ty: Type) -> Type
  # Check if ty is an Adt and find its TypeDef by scanning type_list
  # (inlined to avoid &mut -> & reborrow issues)
  var adt_id: Option[TypeId] = Option::None
  var adt_args: Vec[Type] = Vec::new()
  match ty
  when Type::Adt(id, args) then
    adt_id = Option::Some(id)
    # Copy args for later use (args is borrowed from ty)
    var i = 0
    while i < args.len() do
      adt_args.push(args[i].clone())
      i = i + 1
    end
  when _ then
    return ty
  end
  # Only reach here if ty is Type::Adt
  let id = match adt_id when Option::Some(i) then i when Option::None then return ty end
  # Look up the TypeDef via the O(1) id index
  match env.type_id_index.get(id.id)
  when Option::Some(idx) then
    let td = env.type_list[idx]
    let name = td.name
      # Type aliases resolve to their underlying type: typealias Signal = Int.
      match td.def_kind
      when TypeDefKind::Alias(inner) then
        return subst_type_args(&inner, &td.generic_params, &adt_args)
      when _ then ()
      end
      if name == "Unit" || name == "Nil" then return Type::Unit
      elsif name == "Bool" then return Type::Bool
      elsif name == "Int" || name == "c_int" then return Type::Int
      elsif name == "UInt" || name == "c_uint" then return Type::UInt
      elsif name == "Float" then return Type::Float
      elsif name == "Char" then return Type::Char
      elsif name == "String" || name == "str" then return Type::String
      elsif name == "Never" then return Type::Never
      elsif name == "I8" || name == "Int8" || name == "i8" then return Type::I8
      elsif name == "I16" || name == "Int16" || name == "i16" then return Type::I16
      elsif name == "I32" || name == "Int32" || name == "i32" then return Type::I32
      elsif name == "I64" || name == "Int64" || name == "i64" || name == "c_long" then return Type::I64
      elsif name == "I128" || name == "Int128" || name == "i128" then return Type::I128
      elsif name == "U8" || name == "UInt8" || name == "u8" || name == "c_char" then return Type::U8
      elsif name == "U16" || name == "UInt16" || name == "u16" then return Type::U16
      elsif name == "U32" || name == "UInt32" || name == "u32" then return Type::U32
      elsif name == "U64" || name == "UInt64" || name == "u64" || name == "c_ulong" then return Type::U64
      elsif name == "U128" || name == "UInt128" || name == "u128" then return Type::U128
      elsif name == "ISize" || name == "isize" then return Type::ISize
      elsif name == "USize" || name == "usize" then return Type::USize
      elsif name == "F32" || name == "f32" || name == "c_float" then return Type::F32
      elsif name == "F64" || name == "f64" || name == "c_double" then return Type::F64
      elsif name == "Ref" then
        if adt_args.len() >= 1 then return adt_args[0].clone()
        else return fresh_type_var(env)
        end
      elsif name == "RefMut" then
        if adt_args.len() >= 1 then return adt_args[0].clone()
        else return fresh_type_var(env)
        end
      elsif name == "Ptr" then
        if adt_args.len() >= 1 then return Type::Ptr(adt_args[0].clone())
        else return Type::Ptr(fresh_type_var(env))
        end
      elsif name == "PtrMut" then
        if adt_args.len() >= 1 then return Type::PtrMut(adt_args[0].clone())
        else return Type::PtrMut(fresh_type_var(env))
        end
      elsif env.lang_items.rc != -1 && id.id == env.lang_items.rc then
        # Rc[Resource] is an unsupported combination (documented ownership
        # policy): a linear resource cannot become shared ownership through
        # reference counting. Reject at the type annotation so the policy is
        # enforced, not just documented (the resource checker re-rejects any
 # bound Rc-of-resource at bind time).: the Rc identity is the
        # LangItems rc TypeId — never the registered name. NOTE: this
        # function has no span parameter — use a zero span for the
        # diagnostic.
        if adt_args.len() >= 1 then
          if type_has_resource_kind(env, &adt_args[0]) then
            type_add_error(env, "Rc[Resource] is unsupported: a linear resource cannot be shared through reference counting", Span { file: "", start: 0, end_pos: 0 })
          end
        end
        ty
      else
        # Check for common aliases that behave like canonical types
        if name == "c_void" then return Type::Unit
        else
          return ty  # Keep as Adt for user-defined types and builtin compounds
        end
      end
  when Option::None then
    # An Adt whose TypeId could not be resolved to a real TypeDef is a
    # bogus/placeholder type (e.g. TypeId{id:0}). Returning it as-is
    # propagates that unsound placeholder into unification and can make
    # unrelated types compare equal. Convert it to the Error type so it is
    # rejected loudly rather than silently accepted. Genuinely user-defined
    # Adt types that simply are not in type_list yet keep their identity.
    if id.id == 0 then
      Type::Error
    else
      ty
    end
  end
end

# Substitute generic type parameters with concrete type arguments in a type.
# For example, if generic_params=[id(T)] and type_args=[Type::Int],
# then Type::Param(id(T)) becomes Type::Int in the given type.
# the parameters are GenericParamIds — the substitution matches by id
# (generic_param_id_numeric), positionally aligned with the declaration
# order of the callee's parameter list.
# this is THE substituted-field computation consumed by the layout
# engine's concrete-key path — a generic definition's fields/variants are
# substituted under the ConcreteTypeKey's args (def.generic_params <->
# substs) BEFORE any offset/size is computed (see layout_engine.tg's
# substituted_type_def / substitute_mir_fields / substitute_mir_variants).
pub def subst_type_args(ty: Type, generic_params: Vec[GenericParamId], type_args: Vec[Type]) -> Type
  match ty
  when Type::Param(gpid) then
    var i = 0
    while i < generic_params.len() do
      if generic_param_id_eq(&generic_params[i], &gpid) then
        return type_args[i].clone()
      end
      i = i + 1
    end
    ty.clone()
  when Type::Adt(tid, args) then
    var new_args = Vec::new()
    var i = 0
    while i < args.len() do
      new_args.push(subst_type_args(&args[i], generic_params, type_args))
      i = i + 1
    end
    Type::Adt(tid, new_args)
  when Type::RefInternal(inner, mutable) then Type::RefInternal(subst_type_args(inner, generic_params, type_args), mutable)
  when Type::Ptr(inner) then Type::Ptr(subst_type_args(inner, generic_params, type_args))
  when Type::PtrMut(inner) then Type::PtrMut(subst_type_args(inner, generic_params, type_args))
  when Type::Tuple(fields) then
    var new_fields = Vec::new()
    var i = 0
    while i < fields.len() do
      new_fields.push(subst_type_args(&fields[i], generic_params, type_args))
      i = i + 1
    end
    Type::Tuple(new_fields)
  when Type::FixedArray(elem, n) then Type::FixedArray(subst_type_args(&elem, generic_params, type_args), n)
  when Type::FnPtr(params, ret, effects) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: subst_type_args(&pt.ty, generic_params, type_args), convention: pt.convention })
      i = i + 1
    end
    Type::FnPtr(new_params, subst_type_args(ret, generic_params, type_args), effects.clone())
  when Type::Closure(cid, params, ret, captures, effects) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: subst_type_args(&pt.ty, generic_params, type_args), convention: pt.convention })
      i = i + 1
    end
    Type::Closure(cid.clone(), new_params, subst_type_args(ret, generic_params, type_args), subst_type_args(&captures, generic_params, type_args), effects.clone())
  when Type::Effect(effects, inner) then
 # (defect fix): the substitution PRESERVES the effect set — the
    # effects pass through unchanged (a substituted effect[Io] Wrapper[T]
    # stays effect[Io] Wrapper[Int], never an effectless Wrapper[Int]).
    Type::Effect(effects.clone(), subst_type_args(inner, generic_params, type_args))
  when _ then ty.clone()
  end  end
end

def resolve_type_var(env: TypeEnv, ty: Type) -> Type
  match ty
  when Type::Var(id) then
    match env.subst.get(id)
    when Option::Some(resolved) then
      resolve_type_var(env, resolved)
    when Option::None then ty
    end
  # Recurse into compound types for full resolution
  when Type::RefInternal(inner, mutable) then Type::RefInternal(resolve_type_var(env, inner), mutable)
  when Type::Tuple(fields) then
 # the by-value array iterator (ArrayIterator /.iter()) is
    # Copy-only and explicitly unsafe; the projected for-loop is the primary
    # collection iteration. Resolve each field through the loop and collect
    # the resolved fields.
    var resolved_fields = Vec::new()
    for f in fields do
      resolved_fields.push(resolve_type_var(env, f))
    end
    Type::Tuple(resolved_fields)
  when Type::FnPtr(params, ret, effects) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: resolve_type_var(env, pt.ty), convention: pt.convention })
      i = i + 1
    end
    Type::FnPtr(new_params, resolve_type_var(env, ret), effects.clone())
  when Type::Closure(cid, params, ret, captures, effects) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: resolve_type_var(env, pt.ty), convention: pt.convention })
      i = i + 1
    end
    Type::Closure(cid.clone(), new_params, resolve_type_var(env, ret), resolve_type_var(env, captures), effects.clone())
  when Type::Adt(tid, args) then
 # the by-value array iterator is Copy-only and explicitly unsafe;
    # the projected for-loop is the primary collection iteration. Resolve
    # each type argument through the loop and collect the resolved list.
    var resolved_args = Vec::new()
    for a in args do
      resolved_args.push(resolve_type_var(env, a))
    end
    Type::Adt(tid, resolved_args)
  when Type::FixedArray(elem, n) then Type::FixedArray(resolve_type_var(env, elem), n)
  when _ then ty
  end  end
end

# Chase only the root type variable (no recursive compound reconstruction).
# Path-compresses the substitution chain so repeated lookups are O(1).
def prune_var(inout env: TypeEnv, ty: Type) -> Type
  match ty
  when Type::Var(id) then
    match env.subst.get(id)
    when Option::Some(resolved) then
      let root = prune_var(env, resolved)
      env.subst.insert(id, root.clone())
      root
    when Option::None then ty
    end
  when _ then ty
  end  end
end

# ———————————————————————————————————————————————————————————————
# Unification
# ———————————————————————————————————————————————————————————————

def type_tag(env: TypeEnv, t: Type) -> String
  match t
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Char then "Char"
  when Type::String then "String"
  when Type::StaticStrPtr then "StaticStrPtr"
  when Type::Never then "Never"
  when Type::IntLiteral(v) then "IntLiteral(" + v.to_string() + ")"
  when Type::I8 then "I8"
  when Type::I16 then "I16"
  when Type::I32 then "I32"
  when Type::I64 then "I64"
  when Type::I128 then "I128"
  when Type::U8 then "U8"
  when Type::U16 then "U16"
  when Type::U32 then "U32"
  when Type::U64 then "U64"
  when Type::U128 then "U128"
  when Type::ISize then "ISize"
  when Type::USize then "USize"
  when Type::F32 then "F32"
  when Type::F64 then "F64"
  when Type::Adt(id, args) then
    # The Adt form of a builtin compound type tags as the builtin name (the
    # LangItems TypeId selects the builtin identity); user-defined and
    # non-builtin Adt types keep the id-based tag.
    if id.id == env.lang_items.option && args.len() >= 1 then "Option"
    elsif id.id == env.lang_items.result && args.len() >= 2 then "Result"
    elsif id.id == env.lang_items.map && args.len() >= 2 then "Map"
    elsif id.id == env.lang_items.set && args.len() >= 1 then "Set"
    elsif id.id == env.lang_items.slice && args.len() >= 1 then "UnsafeSlice"
    elsif id.id == env.lang_items.array && args.len() >= 1 then "Array"
    elsif id.id == env.lang_items.box_ && args.len() >= 1 then "Box"
    elsif id.id == env.lang_items.rc && args.len() >= 1 then "Rc"
    else "Named#" + id.id.to_string()
    end
  when Type::FixedArray(elem, n) then "FixedArray[" + type_tag(env, &elem) + ";" + n.to_string() + "]"
  when Type::FnPtr(_, _, _) then "FnPtr"
  when Type::Closure(_, _, _, _, _) then "Closure"
  when Type::RefInternal(_, _) then "RefInternal"
  when Type::Ptr(_) then "Ptr"
  when Type::PtrMut(_) then "PtrMut"
  when Type::Dyn(_) then "Dyn"
  when Type::Effect(_, _) then "Effect"
  when Type::Tuple(_) then "Tuple"
  when Type::Var(_) then "Var"
  when Type::Param(gpid) then "Param(" + generic_param_name_of(&env.generic_param_table, &gpid) + ")"
  when Type::Error then "Error"
  end  end
end

# True for the INFERENCE-ONLY IntLiteral type that integer literal
# expressions produce (the literal is coercible to any concrete
# integer type and is eliminated after coercion — the resolved type never
# remains IntLiteral). The ordinary semantic Type::Int is EXACT — it is
# NOT an unconstrained integer literal and never coerces.
def is_int_literal_type(ty: Type) -> Bool
  match ty
  when Type::IntLiteral(_) then true
  when _ then false
  end  end
end

# True for any concrete integer type.
def is_integer_type(ty: Type) -> Bool
  match ty
  when Type::Int then true
  when Type::UInt then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when _ then false
  end  end
end

# True for the Box type (the Adt form of the registered Box id).
def is_box_type(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then true else false end
  when _ then false
  end  end
end

def box_inner_type(env: TypeEnv, ty: Type) -> Type
  match ty
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else ty.clone() end
  when _ then ty.clone()
  end  end
end

# True for the String type.
def is_string_type(ty: Type) -> Bool
  match ty
  when Type::String then true
  when _ then false
  end  end
end

# True for the Never (bottom) type.
def is_never_type(ty: Type) -> Bool
  match ty
  when Type::Never then true
  when _ then false
  end  end
end

# True for a generic parameter reference (e.g. T in `def f[T](x: T)`).
def is_param_type(ty: Type) -> Bool
  match ty
  when Type::Param(_) then true
  when _ then false
  end  end
end

# True for an empty tuple (the `()` type).
def is_empty_tuple(ty: Type) -> Bool
  match ty
  when Type::Tuple(fields) then fields.is_empty()
  when _ then false
  end  end
end

# True for the Unit type.
def is_unit_type(ty: Type) -> Bool
  match ty
  when Type::Unit then true
  when _ then false
  end  end
end

# True for Slice/Vec/Array (element containers interchangeable in the checker).
# The RAW view (the UnsafeSlice builtin — LangItems slice id), the heap
# vector (Array/Vec ids) are the slice-like Adt forms. The SAFE
# source-spelled Slice (the std-declared shared struct) is NOT this class:
# it is an ordinary struct whose element access is its compiled methods
# (len/get/sub — the Arc-backed std impl), never a checker-managed
# container.
def is_slice_like(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, _) then
    if tid.id == env.lang_items.vec || tid.id == env.lang_items.slice || tid.id == env.lang_items.array then true else false end
  when _ then false
  end  end
end

def slice_inner(env: TypeEnv, ty: Type) -> Type
  match ty
  when Type::Adt(tid, args) then
    # Only the slice-like builtin ids (the raw view UnsafeSlice, the heap
    # vector Array/Vec — and Vec) yield their element; the
    # Option/Result/Map/Set/Box/Rc Adt forms keep their identity. Other Adt
    # types keep the pre-existing arg-based fallback.
    if tid.id == env.lang_items.slice || tid.id == env.lang_items.array || tid.id == env.lang_items.vec then
      if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
    elsif tid.id == env.lang_items.option || tid.id == env.lang_items.result || tid.id == env.lang_items.map || tid.id == env.lang_items.set || tid.id == env.lang_items.box_ || tid.id == env.lang_items.rc then
      ty.clone()
    else
      if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
    end
  when _ then ty.clone()
  end  end
end

# True for raw pointer types.
def is_ptr_type(ty: Type) -> Bool
  match ty
  when Type::Ptr(_) then true
  when Type::PtrMut(_) then true
  when _ then false
  end  end
end

def ptr_inner(ty: Type) -> Type
  match ty
  when Type::Ptr(e) then e
  when Type::PtrMut(e) then e
  when _ then ty.clone()
  end  end
end

def is_ref_type(ty: Type) -> Bool
  match ty
  when Type::RefInternal(_, _) then true
  when _ then false
  end  end
end

def ref_inner_type(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then inner
  when _ then ty.clone()
  end  end
end

# The Named "Fn" form unified with a callable (the Function form,
# a FnPtr or a Closure — ): the Fn type's args match the callable's
# params + ret; the last type arg is the return type, so the parameter
# arity is args.len() - 1, and it must match the callable's arity exactly.
def unify_named_fn_callable(inout env: TypeEnv, id1: TypeId, args1: Vec[Type], params2: Vec[ParamType], ret2: Type, span: Span) -> Bool
  match get_type_by_id_ref(env, id1)
  when Option::Some(td) then
    if td.name == "Fn" then
      if args1.len() == 0 then true
      elsif args1.len() - 1 != params2.len() then
        type_add_error(env, "function arity mismatch: cannot unify Fn type with " +
          (args1.len() - 1).to_string() + " parameters and function type with " +
          params2.len().to_string() + " parameters", span)
        false
      else
        var ok = true
        var i = 0
        while i < params2.len() do
          if !unify(env, args1[i], params2[i].ty, span) then
            ok = false
          end
          i = i + 1
        end
        if ok then
          let ret_idx = args1.len() - 1
          unify(env, args1[ret_idx], ret2.clone(), span)
        else
          false
        end
      end
    else
      type_add_error(env, "type mismatch: " + type_tag(env, &Type::Adt(id1.clone(), args1.clone())) + " vs " + type_tag(env, &Type::FnPtr(params2.clone(), Box::new(ret2.clone()), Vec::new())), span)
      false
    end
  when Option::None then
    type_add_error(env, "type mismatch: " + type_tag(env, &Type::Adt(id1.clone(), args1.clone())) + " vs " + type_tag(env, &Type::FnPtr(params2.clone(), Box::new(ret2.clone()), Vec::new())), span)
    false
  end  end
end

# The callable-vs-callable unification — the SHARED signature comparison of
# the Function form, the FnPtr form and the Closure form,
# FnPtr/Closure split): the arity must match EXACTLY (a callable with a
# different parameter count is a different type; callable types carry
# ownership conventions per parameter, and higher-order calls bind
# arguments positionally, so unifying only the common prefix would let a
# fn(Int) -> Int unify with fn(Int, String) -> Int and produce unsound
# callable substitution), every parameter's convention and type unify, and
# the returns unify.
def unify_callable_sigs(inout env: TypeEnv, params1: Vec[ParamType], ret1: Type, params2: Vec[ParamType], ret2: Type, span: Span) -> Bool
  if params1.len() != params2.len() then
    type_add_error(env, "function arity mismatch: cannot unify " +
      params1.len().to_string() + "-parameter and " +
      params2.len().to_string() + "-parameter function types", span)
    false
  else
    var ok = true
    var i = 0
    while i < params1.len() do
      if !(params1[i].convention == params2[i].convention) then
        ok = false
      end
      if !unify(env, params1[i].ty, params2[i].ty, span) then
        ok = false
      end
      i = i + 1
    end
    if ok then unify(env, ret1.clone(), ret2.clone(), span) else false end
  end
end

def unify(inout env: TypeEnv, t1: Type, t2: Type, span: Span) -> Bool
  let a_raw = prune_var(env, t1)
  let b_raw = prune_var(env, t2)
  # Normalize Adt forms before matching (aliases, primitive spellings,
  # Ref/RefMut/Ptr unwrapping, the Rc-of-resource policy, the id-0 guard).
  # The builtin compounds pass through unchanged — the Adt form IS the
  # representation (the canonical variants no longer exist).
  let a = normalize_adt_for_unify(env, a_raw)
  let b = normalize_adt_for_unify(env, b_raw)

 # (integer-literal coercion): an IntLiteral (from an integer
  # literal expression) is compatible with any concrete integer type
  # (UInt, i8..u128, isize/usize) — the unifier's coercion rule BINDS the
  # literal to the concrete type, and the literal type is eliminated (the
  # resolved type never remains IntLiteral). The COERCION is range-checked
  # against the concrete target (int_literal_unify_range_check — a
  # host-representable literal that cannot fit the target is the ONE
  # stable overflow diagnostic; it never silently truncates). The ordinary
  # semantic Type::Int is EXACT — it falls through to the exact-match
  # arms below (Int vs u8 is a type mismatch, never a silent coercion).
  if is_int_literal_type(&a) && is_integer_type(&b) then
    int_literal_unify_range_check(env, &a, &b, span)
  elsif is_int_literal_type(&b) && is_integer_type(&a) then
    int_literal_unify_range_check(env, &b, &a, span)
  elsif is_never_type(&a) || is_never_type(&b) then
    # Never is the bottom type: it unifies with any type.
    true
  elsif (is_empty_tuple(&a) && is_unit_type(&b)) || (is_empty_tuple(&b) && is_unit_type(&a)) then
    # An empty tuple `()` is the Unit type.
    true
  else
    match a
  when Type::Var(id1) then
    match b
    when Type::Var(id2) then
      if id1.id == id2.id then
        true
      else
        # Already-bound vars must re-unify with their binding rather than be
        # overwritten: the binding carries the resolved structure.
        match env.subst.get(id1)
        when Option::Some(bound) then unify(env, bound, b, span)
        when Option::None then
          match env.subst.get(id2)
          when Option::Some(bound2) then unify(env, a, bound2, span)
          when Option::None then
            env.subst.insert(id1, b)
            true
          end
        end
      end
    when _ then
      match env.subst.get(id1)
      when Option::Some(bound) then unify(env, bound, b, span)
      when Option::None then
        if occurs_check(env, id1, b, span.clone()) then
          type_add_error(env, "infinite type", span)
          false
        else
          env.subst.insert(id1, b)
          true
        end
      end
    end
  when _ then
    match b
    when Type::Var(id2) then
      match env.subst.get(id2)
      when Option::Some(bound2) then unify(env, a, bound2, span)
      when Option::None then
        if occurs_check(env, id2, a, span.clone()) then
          type_add_error(env, "infinite type", span)
          false
        else
          env.subst.insert(id2, a)
          true
        end
      end
    when _ then
      match a
      when Type::Unit then match b when Type::Unit then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Bool then match b when Type::Bool then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Int then match b when Type::Int then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::UInt then match b when Type::UInt then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Float then match b when Type::Float then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Char then match b when Type::Char then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::String then match b when Type::String then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I8 then match b when Type::I8 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I16 then match b when Type::I16 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I32 then match b when Type::I32 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I64 then match b when Type::I64 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::I128 then match b when Type::I128 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U8 then match b when Type::U8 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U16 then match b when Type::U16 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U32 then match b when Type::U32 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U64 then match b when Type::U64 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::U128 then match b when Type::U128 then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::ISize then match b when Type::ISize then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
        when Type::USize then match b when Type::USize then true when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false end
      when Type::Never then true
      when Type::IntLiteral(_) then
 # two unconstrained integer literals unify (both are
        # coercion candidates, values never participate in unification);
        # a literal against any NON-integer concrete type is a mismatch
        # (the literal-vs-integer coercions were answered by the coercion
        # rule above).
        match b
        when Type::IntLiteral(_) then true
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Adt(id1, args1) then
        match b
        when Type::Adt(id2, args2) then
          if id1.id != id2.id then
            type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
            false
          elsif args1.len() != args2.len() then
 # (defect fix): SAME-constructor generic arity is EXACT —
            # Foo[Int] and Foo[Int, String] do NOT unify (a different
            # number of type arguments is a different type; unifying the
            # common prefix would let a one-arg Foo unify with a two-arg
            # Foo and produce unsound substitution). The mismatch is a
            # type error.
            type_add_error(env, "generic arity mismatch: cannot unify " + type_tag(env, &a) + " (" + args1.len().to_string() + " type argument(s)) with " + type_tag(env, &b) + " (" + args2.len().to_string() + " type argument(s))", span)
            false
          else
            var ok = true
            var i = 0
            while i < args1.len() do
              if !unify(env, args1[i], args2[i], span) then
                ok = false
              end
              i = i + 1
            end
            ok
          end
        # Handle Adt(tid, args) unified with primitive types (Int, U64, String, etc.)
        # Occurs when resolve_type_expr or other code creates Adt types for primitives.
        when Type::Unit then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Unit" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Bool then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Bool" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Int then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "Int" || td.name == "c_int") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::UInt then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "UInt" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Float then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Float" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Char then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Char" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::String then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "String" || td.name == "str") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::Never then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if td.name == "Never" && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::FixedArray(elem2, n2) then
          # Literal-bridge: the heap-vector Adt Array form (the array
          # literal's own type) unifies with a FixedArray annotation by
          # element; the count is enforced at the literal's MIR destination.
          if id1.id == env.lang_items.array && args1.len() >= 1 then
            unify(env, args1[0], elem2, span)
          else
            type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
            false
          end
        when Type::I8 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I8" || td.name == "Int8" || td.name == "i8") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::I16 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I16" || td.name == "Int16" || td.name == "i16") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::I32 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I32" || td.name == "Int32" || td.name == "i32") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::I64 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I64" || td.name == "Int64" || td.name == "i64" || td.name == "c_long") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::I128 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "I128" || td.name == "Int128" || td.name == "i128") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U8 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U8" || td.name == "UInt8" || td.name == "u8" || td.name == "c_char") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U16 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U16" || td.name == "UInt16" || td.name == "u16") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U32 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U32" || td.name == "UInt32" || td.name == "u32") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U64 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U64" || td.name == "UInt64" || td.name == "u64" || td.name == "c_ulong") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::U128 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "U128" || td.name == "UInt128" || td.name == "u128") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::ISize then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "ISize" || td.name == "isize") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::USize then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "USize" || td.name == "usize") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::F32 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "F32" || td.name == "f32" || td.name == "c_float") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        when Type::F64 then
          match get_type_by_id_ref(env, &id1)
          when Option::Some(td) then
            if (td.name == "F64" || td.name == "f64" || td.name == "c_double") && args1.len() == 0 then true
            else type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
            end
          when Option::None then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
          end
        # Handle Named(tid, args) unified with a callable type.
        when Type::FnPtr(params2, ret2, _) then
          unify_named_fn_callable(env, &id1, &args1, &params2, ret2, span)
        when Type::Closure(_, params2, ret2, _, _) then
          unify_named_fn_callable(env, &id1, &args1, &params2, ret2, span)
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::FnPtr(params1, ret1, _) then
 # (FnPtr/Closure split): a function POINTER unifies with the
        # callable signatures (a fn pointer, a closure value, or the
        # Function form) through the shared signature comparison.
        match b
        when Type::FnPtr(params2, ret2, _) then
          unify_callable_sigs(env, &params1, ret1, &params2, ret2, span)
        when Type::Closure(_, params2, ret2, _, _) then
          unify_callable_sigs(env, &params1, ret1, &params2, ret2, span)
        when Type::Error then true
        when Type::Param(_) then
          type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
          false
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Closure(_, params1, ret1, _, _) then
 # a closure VALUE unifies with the callable signatures through
        # the shared signature comparison (the closure's capture type does
        # not participate in signature unification).
        match b
        when Type::FnPtr(params2, ret2, _) then
          unify_callable_sigs(env, &params1, ret1, &params2, ret2, span)
        when Type::Closure(_, params2, ret2, _, _) then
          unify_callable_sigs(env, &params1, ret1, &params2, ret2, span)
        when Type::Error then true
        when Type::Param(_) then
          type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
          false
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Tuple(elems1) then
        match b
        when Type::Tuple(elems2) then
          if elems1.len() != elems2.len() then
            type_add_error(env, "tuple length mismatch", span)
            false
          else
            var ok = true
            var i = 0
            while i < elems1.len() do
              if !unify(env, elems1[i], elems2[i], span) then
                ok = false
              end
              i = i + 1
            end
            ok
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::RefInternal(t_inner1, mut1) then
        match b
        when Type::RefInternal(t_inner2, mut2) then
          if !(mut1 == mut2) then
            type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
            false
          else
            unify(env, t_inner1, t_inner2, span)
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Ptr(t_inner1) then
        match b
        when Type::Ptr(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::PtrMut(t_inner1) then
        match b
        when Type::PtrMut(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Dyn(id1) then
        match b
        when Type::Dyn(id2) then
          if id1.id == id2.id then true
          else
            type_add_error(env, "trait object type mismatch", span)
            false
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Effect(effs1, t_inner1) then
        match b
        when Type::Effect(effs2, t_inner2) then
          if effs1.len() != effs2.len() then
            type_add_error(env, "effect set mismatch", span)
            false
          else
            var effects_match = true
            var i = 0
            while i < effs1.len() do
 # (EffectId domain): effect-set identity is the INTERNED
              # id — effect_id_eq, never the name (two same-named effects
              # in different modules are distinct effects).
              if !effect_id_eq(&effs1[i], &effs2[i]) then
                effects_match = false
              end
              i = i + 1
            end
            if !effects_match then
              type_add_error(env, "effect set mismatch", span)
              false
            else
              unify(env, t_inner1, t_inner2, span)
            end
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Param(gpid1) then
        match b
        when Type::Param(gpid2) then
          if generic_param_id_eq(&gpid1, &gpid2) then
            true
          else
            let n1 = generic_param_name_of(&env.generic_param_table, &gpid1)
            let n2 = generic_param_name_of(&env.generic_param_table, &gpid2)
            type_add_error(env, "type parameter mismatch: " + n1 + " vs " + n2, span)
            false
          end
        when Type::Error then true
        when Type::Var(id2) then
          # A generic parameter unifies with an inference variable only by
          # binding the variable to the parameter (the parameter's own
          # instantiated InferVar): the two denote the same unresolved
          # entity. An already-bound variable must re-unify with its
          # binding, which under strict rules only accepts the same
          # parameter.
          match env.subst.get(id2)
          when Option::Some(bound2) then unify(env, a, bound2, span)
          when Option::None then
            if occurs_check(env, id2, a, span.clone()) then
              type_add_error(env, "infinite type", span)
              false
            else
              env.subst.insert(id2, a)
              true
            end
          end
        when _ then
          # STRICT: a generic parameter never matches an arbitrary concrete
          # type — each occurrence of T must resolve to the SAME instantiated
          # type, decided at the generic call site, never here.
          let n1 = generic_param_name_of(&env.generic_param_table, &gpid1)
          type_add_error(env, "type parameter `" + n1 + "` cannot unify with " + type_tag(env, &b), span)
          false
        end
      when Type::FixedArray(elem1, n1) then
        match b
        when Type::FixedArray(elem2, n2) then
          # The count is part of the fixed-array type identity: lengths must
          # match exactly, then the elements unify.
          if n1 != n2 then
            type_add_error(env, "fixed array length mismatch: " + n1.to_string() + " vs " + n2.to_string(), span)
            false
          else
            unify(env, elem1, elem2, span)
          end
        when Type::Adt(array_id, args) then
          # Literal-bridge: an array literal (the heap-vector Adt form) may
          # initialize a FixedArray annotation; the count is enforced at the
          # literal's MIR destination.
          if array_id.id == env.lang_items.array && args.len() >= 1 then
            unify(env, elem1, args[0], span)
          else
            type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span)
            false
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch: " + type_tag(env, &a) + " vs " + type_tag(env, &b), span); false
        end
      when Type::Error then true
      end
    end
  end
  end
end

def occurs_check(inout env: TypeEnv, id: TypeVarId, ty: Type, span: Span) -> Bool
  # Use depth limit to prevent stack overflow on deeply recursive types
  occurs_check_with_depth(env, id, ty, 0, span)
end

# Maximum recursion depth for type checking (prevents stack overflow)
def MAX_TYPE_DEPTH() -> Int = 100

def occurs_check_with_depth(inout env: TypeEnv, id: TypeVarId, ty: Type, depth: Int, span: Span) -> Bool
  # Guard against infinite recursion
  if depth > MAX_TYPE_DEPTH() then
    type_add_error(env, "type recursion depth exceeded in occurs check", span)
    return true
  end
  
  match ty
  when Type::Var(other_id) then
    if id.id == other_id.id then
      true
    else
      # Chase bound variables without reconstructing the type tree.
      match env.subst.get(other_id)
      when Option::Some(bound) then occurs_check_with_depth(env, id, bound, depth + 1, span)
      when Option::None then false
      end
    end
  when Type::Adt(_, args) then
    var found = false
    for arg in args do
      if occurs_check_with_depth(env, id, arg, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    found
  when Type::FnPtr(params, ret, _) then
    var found = false
    for p in params do
      if occurs_check_with_depth(env, id, p.ty, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    if !found then
      found = occurs_check_with_depth(env, id, ret, depth + 1, span)
    end
    found
  when Type::Closure(_, params, ret, captures, _) then
    var found = false
    for p in params do
      if occurs_check_with_depth(env, id, p.ty, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    if !found then
      found = occurs_check_with_depth(env, id, ret, depth + 1, span.clone())
    end
    if !found then
      found = occurs_check_with_depth(env, id, captures, depth + 1, span)
    end
    found
  when Type::RefInternal(inner, _) then occurs_check_with_depth(env, id, inner, depth + 1, span)
  when Type::Tuple(elems) then
    var found = false
    for e in elems do
      if occurs_check_with_depth(env, id, e, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    found
  when Type::FixedArray(elem, _) then occurs_check_with_depth(env, id, elem, depth + 1, span)
  when _ then false
  end
end


def type_add_error(inout env: TypeEnv, msg: String, span: Span) -> Unit
  env.errors.push(TypeError { message: msg, span: span, code: Option::None })












end

def add_warning(inout env: TypeEnv, msg: String, span: Span) -> Unit
  env.warnings.push(TypeError { message: msg, span: span, code: Option::None })
end

def add_error_with_code(inout env: TypeEnv, msg: String, span: Span, code: String) -> Unit
  env.errors.push(TypeError { message: msg, span: span, code: Option::Some(code) })
end

# Stable error codes for type checking:
#   E0200 — Type mismatch
#   E0201 — Cannot unify types (occurs check failed)
#   E0202 — Expected type, found expression
#   E0203 — Undefined type
#   E0204 — Undefined variable
#   E0205 — Undefined function
#   E0206 — Argument count mismatch
#   E0207 — Cannot call non-function
#   E0208 — Cannot index non-array
#   E0209 — Cannot access field on non-struct
#   E0210 — Undefined field
#   E0211 — Pattern type mismatch
#   E0212 — Cannot infer type
#   E0213 — Generic argument count mismatch
#   E0214 — Conflicting implementations
#   E0215 — Trait not implemented
#   E0216 — Ambiguous method call
#   E0217 — Return type mismatch
#   E0218 — Condition must be Bool
#   E0219 — Loop condition must be Bool
#   E0277 — Trait bound not satisfied (Send/Sync)
# (impl conformance — validate-first-register-second):
#   E0220 — Impl missing a required trait method
#   E0221 — Duplicate method in an impl
#   E0222 — Unknown member (method / associated type) in a trait impl
#   E0223 — Trait method parameter count mismatch
#   E0224 — Trait method parameter type mismatch
#   E0225 — Trait method access-convention mismatch (let/inout/sink/set)
#   E0226 — Trait method return type mismatch
#   E0227 — Trait method generic parameter count mismatch
#   E0228 — Trait method generic bound mismatch
#   E0229 — Trait argument count mismatch (the full TraitRef, not the head)
#   E0230 — Impl method obligations/effects beyond the trait contract
#   E0231 — Impl missing an associated type the trait declares

# ———————————————————————————————————————————————————————————————
# Type Checking
# ———————————————————————————————————————————————————————————————

def type_check_program_env(inout env: TypeEnv, program: Program) -> Unit
  push_scope(env)

 # (next layer): each item is processed under its owner module path
  # (Program.crate — see module_path_of_item), threaded into type
  # registration and into the current-module context used by the
  # bare-name ambiguity verification and local-module shadowing.
  env.check_ctx = "pass1-pre-register"
  var module_ptr = 0
  var i = 0
  while i < program.items.len() do
    let item = program.items[i]
    let (owner_path, next_module_ptr) = module_path_of_item(program, module_ptr, i)
    module_ptr = next_module_ptr
    env.current_module_path = owner_path.clone()
    pre_register_type_name(env, item, &owner_path)
    i = i + 1
  end
  env.check_ctx = "pass2-collect"
  module_ptr = 0
  i = 0
  while i < program.items.len() do
    let item = program.items[i]
    let (owner_path, next_module_ptr) = module_path_of_item(program, module_ptr, i)
    module_ptr = next_module_ptr
    env.current_module_path = owner_path.clone()
    collect_type_def(env, item, &owner_path)
    i = i + 1
  end
 # (LangItems rebuild): the LangItems bundle was built at env init from
  # the REGISTERED BUILTINS only; pass 2 registered the std's type
  # declarations (StrView/UniquePtr/ArcStrong/WeakRc/WeakArc — the
  # smart-pointer families the property engine selects by LangItems id).
  # Rebuild now so the std-declared ids resolve; the builtin ids never
  # change (the std re-declarations keep the builtin TypeIds), and the
  # rebuilt table is the snapshot serialized into TypedProgram.lang_items.
  env.lang_items = build_lang_items(&env)
 # (FixedArray const sizes): collect the Int-evaluable `const`
  # declaration values (module-qualified key -> value) BEFORE pass 3, so
  # the [T; N] annotation's size expression can resolve a const reference
  # (and constant arithmetic over consts/literals) into the FixedArray
  # count. Declaration-order collection with a fixpoint re-scan: a const
  # referencing a LATER const resolves on a subsequent iteration; a cyclic
  # or non-Int const records nothing (the [T; N] site reports the
  # "must be a constant" diagnostic).
  env.check_ctx = "pass2b-const-values"
  var cv_progress = true
  var cv_rounds = 0
  while cv_progress && cv_rounds < program.items.len() + 1 do
    cv_progress = false
    module_ptr = 0
    i = 0
    while i < program.items.len() do
      let item = program.items[i]
      let (owner_path, next_module_ptr) = module_path_of_item(program, module_ptr, i)
      module_ptr = next_module_ptr
      env.current_module_path = owner_path.clone()
      match item.kind
      when ItemKind::ItemConst(c) then
        let cv_key = module_qualified_key(&owner_path, &c.name)
        if !env.const_values.contains_key(&cv_key) then
          match eval_const_size_expr(env, &c.value)
          when Option::Some(n) then
            env.const_values.insert(cv_key, n)
            cv_progress = true
          when Option::None then ()
          end
        end
      when _ then ()
      end
      i = i + 1
    end
    cv_rounds = cv_rounds + 1
  end
  # Concrete ownership is NOT propagated into the nominal TypeKind: the
  # TypeProperties engine (type_properties_of, keyed by (TypeId,
  # substitutions)) computes per-instantiation owns_state/linearity on
  # demand. TypeDef.kind remains the DECLARED kind (Resource/Capability
  # markers only).

  env.check_ctx = "pass3-register"
  module_ptr = 0
  i = 0
  while i < program.items.len() do
    let item = program.items[i]
    let (owner_path, next_module_ptr) = module_path_of_item(program, module_ptr, i)
    module_ptr = next_module_ptr
    env.current_module_path = owner_path.clone()
    match item.kind
    when ItemKind::ItemFunction(f) then
      # Register generic type parameters in scope for function signature
 # resolution. the function interns its generic parameters in
      # declaration order under its item DefId (item_owner_def) — the
      # GenericParamId order IS the declaration order (the substs-order
      # contract); pass 4's check_function reconstructs the same ids from
      # (owner, index) and never re-interns.
      push_scope(env)
      let f_owner = item_owner_def(env, i)
      let f_param_ids = intern_generic_params(env, &f_owner, &f.generic_params)
      var gp_idx = 0
      while gp_idx < f.generic_params.len() do
        bind_var(env, f.generic_params[gp_idx].name.clone(), Type::Param(f_param_ids[gp_idx].clone()))
        gp_idx = gp_idx + 1
      end
      var param_types = Vec::new()
      var j = 0
      while j < f.params.len() do
        let p = f.params[j]
        let resolved_ty = match p.ty
        when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
        when Option::None then fresh_type_var(env)
        end
        param_types.push(ParamType { ty: resolved_ty, convention: p.convention })
        j = j + 1
      end
      let ret_ty = match f.ret_type
      when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
      when Option::None then Type::Unit
      end
      pop_scope(env)
 # (FnPtr/Closure split): a declared function VALUE is a function
      # POINTER (no environment) — the FnPtr form. The callable type
      # carries the function's DECLARED EFFECT SET (the parsed effect
      # names, or the std effectful-function seeds by the MODULE-QUALIFIED
      # identity — "std::io::println", never the bare name): a fn-item
      # value's type is the source of the INDIRECT-call recording (a
      # computed callee / fn-pointer field is effectful iff its type says
      # so).
      let fn_ty = Type::FnPtr(param_types, ret_ty, declared_effects_of(env, &f.effects, module_qualified_effect_name(&owner_path, &f.name)))
      bind_var(env, f.name.clone(), fn_ty.clone())
      record_module_callable(env, f.name.clone(), fn_ty, &owner_path, DefKind::Function)
    when ItemKind::ItemExternBlock(ext) then
      var j = 0
      while j < ext.items.len() do
        let ext_item = ext.items[j]
        match ext_item
        when ExternItem::Function(ef) then
          # Register generic type parameters in scope for extern function
 # signature resolution. extern functions have no resolver
          # DefId (item_owner_def's module -2 fallback — deterministic per
          # item); the interning happens ONCE here (pass 3 — externs are
          # signature-only and never pass-4 checked).
          push_scope(env)
          let ef_owner = item_owner_def(env, i)
          let ef_param_ids = intern_generic_params(env, &ef_owner, &ef.generic_params)
          var gp_idx = 0
          while gp_idx < ef.generic_params.len() do
            bind_var(env, ef.generic_params[gp_idx].name.clone(), Type::Param(ef_param_ids[gp_idx].clone()))
            gp_idx = gp_idx + 1
          end
          var param_types = Vec::new()
          var k = 0
          while k < ef.params.len() do
            let p = ef.params[k]
            let resolved_ty = match p.ty
            when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
            when Option::None then fresh_type_var(env)
            end
            param_types.push(ParamType { ty: resolved_ty, convention: p.convention })
            k = k + 1
          end
          let ret_ty = match ef.ret_type
          when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
          when Option::None then Type::Unit
          end
 # (channel a): an extern declaration whose return type is
          # (or contains) the RAW Slice view (UnsafeSlice) would let the
          # raw view escape across the FFI boundary — rejected at the
          # signature registration.
          check_no_escaping_slice(env, &ret_ty, ef.span, "returned from an extern function")
          pop_scope(env)
 # record the extern declaration's typed signature under the
          # module-qualified fn key (module_qualified_fn_key — the SAME key
          # the MIR's pre-pass derives for extern functions: extern blocks
          # record no item_defs, so the DefId render is unreachable and both
          # sides use this name fallback). Externs are signature-only (never
          # pass-4 checked), so this pass-3 record is their only entry.
          env.typed_fn_signatures.insert(module_qualified_fn_key(&owner_path, ef.name.clone()),
            FnSignature { params: param_types.clone(), ret_type: ret_ty.clone() })
          let ext_fn_ty = Type::FnPtr(param_types, ret_ty, Vec::new())
          bind_var(env, ef.name.clone(), ext_fn_ty.clone())
          record_module_callable(env, ef.name.clone(), ext_fn_ty, &owner_path, DefKind::Function)
        when ExternItem::Static(es) then
 # record the extern static's resolved declared type under the
          # module-qualified key (the SAME key the MIR's pre-pass derives for
          # extern statics) — extern statics are signature-only, so this
          # pass-3 record is their only typed entry.
          env.typed_static_types.insert(module_qualified_key(&owner_path, &es.name), resolve_type_expr(env, &es.ty))
        when _ then ()
        end
        j = j + 1
      end
    when ItemKind::ItemConst(c) then
      # Register const names as variables so they can be looked up by ExprIdent
      let const_ty = match c.ty
      when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
      when Option::None then fresh_type_var(env)
      end
      bind_var(env, c.name.clone(), const_ty.clone())
      record_module_callable(env, c.name.clone(), const_ty.clone(), &owner_path, DefKind::Constant)
 # record the const's declared type under the module-qualified key
      # (the same key the MIR's pre-pass derives); the pass-4 unification
      # chases any inference variable at serialization.
      env.typed_static_types.insert(module_qualified_key(&owner_path, &c.name), const_ty)
    when ItemKind::ItemStatic(s) then
      # Register static (and mut) variable names so they can be looked up by ExprIdent
      let static_ty = resolve_type_expr(env, &s.ty)
      bind_var(env, s.name.clone(), static_ty.clone())
      record_module_callable(env, s.name.clone(), static_ty.clone(), &owner_path, DefKind::Static)
 # record the static's declared type under the module-qualified key
      # (the same key the MIR's pre-pass derives).
      env.typed_static_types.insert(module_qualified_key(&owner_path, &s.name), static_ty)
    when _ then ()
    end
    i = i + 1
  end
  i = 0
  env.check_ctx = "pass4-check"
  module_ptr = 0
  while i < program.items.len() do
    let item = program.items[i]
    let (owner_path, next_module_ptr) = module_path_of_item(program, module_ptr, i)
    module_ptr = next_module_ptr
 # (final layer): thread the current module path into body checking
    # too (the previous layer threaded passes 1-3) so the bare-name callable
    # identity check during pass 4 resolves the CURRENT module's own
    # definition (the stale path left by pass 3 would break local-module
    # shadowing for body references).
    env.current_module_path = owner_path.clone()
    check_item(env, program, item, i)
    i = i + 1
  end
  
 # (effect discipline): after every function body is checked, close
  # the computed effect sets transitively over the recorded call graph and
  # compare them against the declared sets — the checker's transitive
  # effect/budget checking (the language semantics; the source-text
  # analyzer in std::effects is tooling).
  env.check_ctx = "effect-set-check"
  check_effect_sets(env)
  
 # (literal range authority): the end-of-check range decisions — every
  # integer literal against its target's exact bounds (the suffix type,
  # or the inferred Int), with the folded negation sign. Runs on BOTH
  # paths (permissive type_check and the typed compilation entry).
  resolve_pending_literal_ranges(env)
  
  pop_scope(env)
end

def pre_register_type_name(inout env: TypeEnv, item: Item, module_path: Vec[String]) -> Unit
  match item.kind
  when ItemKind::ItemStruct(s) then
    if !env.type_name_index.contains_key(s.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: s.name,
        def_kind: TypeDefKind::Struct(Vec::new()),
        generic_params: Vec::new(),
        kind: TypeKind::Value
        def: Option::None
      }
      env.type_name_index.insert(s.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
 # (next layer): record the module-qualified entry alongside the
      # bare first-wins placeholder so pass-1 forward references to
      # "path::name" resolve before pass 2. Second-module definitions of an
      # already-registered bare name are resolved entirely in pass 2 by
 # store_type_def (every declaration is its own type — an
      # identical re-declaration in a different module gets its own fresh
      # TypeId under its qualified key; only same-module re-registration
      # shares the first-wins TypeId).
      record_module_type_name(env, s.name.clone(), env.type_list.len() - 1, module_path)
    end
  when ItemKind::ItemEnum(e) then
    if !env.type_name_index.contains_key(e.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: e.name,
        def_kind: TypeDefKind::Enum(Vec::new()),
        generic_params: Vec::new(),
        kind: TypeKind::Value
        def: Option::None
      }
      env.type_name_index.insert(e.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
 # (next layer): module-qualified entry for the first-wins enum.
      record_module_type_name(env, e.name.clone(), env.type_list.len() - 1, module_path)
    end
  when ItemKind::ItemTrait(t) then
    if !env.type_name_index.contains_key(t.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: t.name,
        def_kind: TypeDefKind::Trait(Vec::new()),
        generic_params: Vec::new(),
        kind: TypeKind::Value
        def: Option::None
      }
      env.type_name_index.insert(t.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
 # (module-semantic trait identity): the trait declaration
      # registers its module-qualified entry alongside the bare first-wins
      # placeholder (the DefKind::Trait module_symbols entry the resolver
      # recorded for this declaration), so pass-1 forward references to
      # "path::name" traits and the pass-2 declaration identity resolve
      # module-qualified. The bare registry entry is FIRST-WINS — an
      # existing builtin/std entry is never overwritten by a later
      # declaration.
      record_module_type_name(env, t.name.clone(), env.type_list.len() - 1, module_path)
      if !env.trait_registry.contains_key(&t.name) then
        env.trait_registry.insert(t.name.clone(), id.id)
      end
    end
  when ItemKind::ItemTypeAlias(a) then
    if !env.type_name_index.contains_key(a.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: a.name,
        def_kind: TypeDefKind::Alias(Type::Unit),
        generic_params: Vec::new(),
        kind: TypeKind::Value
        def: Option::None
      }
      env.type_name_index.insert(a.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
    end
  when ItemKind::ItemCapabilityDecl(c) then
    if !env.type_name_index.contains_key(c.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: c.name,
        def_kind: TypeDefKind::Opaque,
        generic_params: Vec::new(),
        kind: TypeKind::Capability
        def: Option::None
      }
      env.type_name_index.insert(c.name.clone(), env.type_list.len())
      env.type_id_index.insert(id.id, env.type_list.len())
      env.type_list.push(td)
    end
  when ItemKind::ItemEffectDecl(e) then
    # (EffectId domain): an `effect Name` DECLARATION interns the
    # declared effect under the current module's qualified key ("path::name"
    # — the root module's effects under the bare name), so the effect has
    # a semantic EffectId (module-qualified user effects never collide
    # across modules) and the canonical type identity renders the
    # canonical ordered effect-ID set. A builtin name resolves to its
    # fixed id. The typed op-signature registration lives in check_item
    # (pass 4) where every referenced type resolves.
    let _ = intern_module_effect(&mut env.effects, &env.current_module_path, &e.name)
  when _ then ()
  end  end
end

# The supported-maximum alignment bound for @align(N) — the semantic
# alignment-overflow check. N is already a power of two when it reaches the
# checker (the parser validates the shape); this bound rejects an alignment
# whose size arithmetic or runtime placement the platform discipline cannot
# honor (the allocator contract tops out at 16, the stack slots at 16; a
# larger N would silently degrade every placement). Fail closed: an
# over-aligned declaration is an error, never a silent 1.
def layout_align_max() -> Int = 65536

# The semantic layout-attribute validation (the typed re-check): the
# parser guarantees the SHAPE (power-of-two N, the exclusivity rules); the
# checker re-validates the recorded attributes fail-closed (a program the
# parser never saw cannot bypass the rules) and adds the semantic bound —
# the ALIGNMENT-OVERFLOW check: N above layout_align_max is rejected (an
# alignment the layout arithmetic / runtime placement cannot honor would
# silently mis-place every field). Every violation records a TypeError at
# the attribute's span.
def validate_layout_attrs(inout env: TypeEnv, attrs: LayoutAttrs) -> Unit
  if attrs.is_repr_c && attrs.is_packed then
    type_add_error(env, "@repr(C) and @packed are mutually exclusive (a declaration may carry at most one layout strategy)", attrs.span)
  end
  if attrs.is_packed then
    match attrs.align
    when Option::Some(_) then
      type_add_error(env, "@packed and @align(N) are mutually exclusive (@packed fixes the alignment to 1)", attrs.span)
    when Option::None then ()
    end
  end
  match attrs.align
  when Option::Some(n) then
    if n <= 0 || !is_power_of_two_int(n) then
      type_add_error(env, "@align(N) requires N to be a power of two", attrs.span)
    elsif n > layout_align_max() then
      type_add_error(env, "@align(" + n.to_string() + ") exceeds the supported maximum alignment " + layout_align_max().to_string() + " — alignment overflow (fail closed, never a silent degrade)", attrs.span)
    end
  when Option::None then ()
  end
end

def is_power_of_two_int(n: Int) -> Bool
  n > 0 && (n & (n - 1)) == 0
end

def collect_enum_type_def(inout env: TypeEnv, e: EnumDecl, module_path: Vec[String]) -> Unit
  push_scope(env)
  # the enum interns its generic parameters in declaration order
  # under its DefKind::TypeName DefId (type_decl_owner_def); the variant
  # payload types reference the interned ids.
  let owner = type_decl_owner_def(env, &e.name, module_path)
  let param_ids = intern_generic_params(env, &owner, &e.generic_params)
  var gp_idx = 0
  while gp_idx < e.generic_params.len() do
    bind_var(env, e.generic_params[gp_idx].name.clone(), Type::Param(param_ids[gp_idx].clone()))
    gp_idx = gp_idx + 1
  end

  let id = match get_type_id_by_qualified_name(env, e.name.clone(), module_path)
  when Option::Some(existing_id) then existing_id
  when Option::None then
    let new_id = TypeId { id: env.type_id_counter }
    env.type_id_counter = env.type_id_counter + 1
    new_id
  end
  var variants = Vec::new()
  var disc = 0
  var i = 0
  while i < e.variants.len() do
    var ftypes = Vec::new()
    var j = 0
    while j < e.variants[i].fields.len() do
      let vfield_ty = resolve_type_expr(env, &e.variants[i].fields[j])
 # (channel b): an enum variant field whose type is (or
      # contains) the RAW Slice view (UnsafeSlice) is longer-lived state
      # holding a raw view — rejected.
      check_no_escaping_slice(env, &vfield_ty, e.variants[i].fields[j].span, "stored in an enum variant field")
      ftypes.push(vfield_ty)
      j = j + 1
    end
    variants.push(VariantInfo { name: e.variants[i].name, fields: ftypes, discriminant: disc })
    disc = disc + 1
    i = i + 1
  end
  var gen_params = Vec::new()
  i = 0
  while i < e.generic_params.len() do
    gen_params.push(param_ids[i].clone())
    i = i + 1
  end

  pop_scope(env)

  # The nominal TypeKind of a declaration is the DECLARED kind only: no
  # field/variant-derived mutation here (concrete ownership is computed by
  # the TypeProperties engine keyed by (TypeId, substitutions) — see
  # type_properties_of / type_named_props).

  # The layout attributes: semantically validated and recorded under the
  # semantic TypeId (the typed table — type_layout_attrs — the MIR reads).
  validate_layout_attrs(&mut env, &e.layout_attrs)
  env.layout_attrs.insert(id.id, e.layout_attrs.clone())

  let td = TypeDef {
    id: id,
    name: e.name.clone(),
    def_kind: TypeDefKind::Enum(variants),
    generic_params: gen_params,
    kind: TypeKind::Value
    def: Option::None
  }
  store_type_def(env, td, e.span, module_path)
end

def collect_type_def(inout env: TypeEnv, item: Item, module_path: Vec[String]) -> Unit
  let _scope_before_ctd = env.scopes.len()
  match item.kind
  when ItemKind::ItemStruct(s) then
    # INLINE push_scope to avoid &mut parameter passing bug
    let _m: Map[String, Type] = Map::new()
    env.scopes.push(_m)
    let _lm: Map[String, Int] = Map::new()
    env.local_ids.push(_lm)
 # the struct interns its generic parameters in declaration
    # order under its DefKind::TypeName DefId (type_decl_owner_def); the
    # field types reference the interned ids.
    let s_owner = type_decl_owner_def(env, &s.name, module_path)
    let s_param_ids = intern_generic_params(env, &s_owner, &s.generic_params)
    var gp_idx = 0
    while gp_idx < s.generic_params.len() do
      bind_var(env, s.generic_params[gp_idx].name.clone(), Type::Param(s_param_ids[gp_idx].clone()))
      gp_idx = gp_idx + 1
    end

    # Reuse pre-registered ID if available
    let id = match get_type_id_by_qualified_name(env, s.name.clone(), module_path)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    var fields = Vec::new()
    var i = 0
    while i < s.fields.len() do
      # Indexed access avoids stage0 codegen bug where copying a FieldDecl
      # out of the Vec produces a corrupted TypeExpr payload.
      let ty = resolve_type_expr(env, &s.fields[i].ty)
 # (channel b): a struct field whose type is (or contains) the
      # RAW Slice view (UnsafeSlice) is longer-lived state holding a raw
      # view — rejected.
      check_no_escaping_slice(env, &ty, s.fields[i].span, "stored in a struct field")
      fields.push(FieldInfo { name: s.fields[i].name, ty: ty, is_public: true })
      i = i + 1
    end
    var struct_kind = match s.kind
    when NominalKind::Resource then TypeKind::Resource
    when NominalKind::Value then TypeKind::Value
    end
    # NO field-derived kind mutation: the nominal TypeKind is the DECLARED
    # kind only. A struct's ownership/linearity for a concrete instantiation
    # is computed by the TypeProperties engine (type_properties_of walks the
    # fields/variants with the concrete args substituted).
    var gen_params = Vec::new()
    i = 0
    while i < s.generic_params.len() do
      gen_params.push(s_param_ids[i].clone())
      i = i + 1
    end

    # INLINE pop_scope
    env.scopes.pop()
    env.local_ids.pop()

    # The layout attributes: semantically validated and recorded under the
    # semantic TypeId (the typed table — type_layout_attrs — the MIR
    # reads; the record is the attribute authority end-to-end).
    validate_layout_attrs(&mut env, &s.layout_attrs)
    env.layout_attrs.insert(id.id, s.layout_attrs.clone())

    let td = TypeDef {
      id: id,
      name: s.name.clone(),
      def_kind: TypeDefKind::Struct(fields),
      generic_params: gen_params,
      kind: struct_kind
      def: Option::None
    }
    store_type_def(env, td, s.span, module_path)
  when ItemKind::ItemEnum(e) then
    # store_type_def rejects duplicate definitions; same-named DISTINCT types
 # across modules are no longer merged.
    collect_enum_type_def(env, e, module_path)
  when ItemKind::ItemTrait(t) then
    # Register trait-level generic type parameters in scope so resolve_type_expr
    # can find them when processing method signatures (e.g., T in Into[T]).
 # the trait interns its generic parameters in declaration order
    # under its DefKind::TypeName DefId.
    push_scope(env)
    let t_owner = type_decl_owner_def(env, &t.name, module_path)
    let t_param_ids = intern_generic_params(env, &t_owner, &t.generic_params)
    var gp_idx = 0
    while gp_idx < t.generic_params.len() do
      bind_var(env, t.generic_params[gp_idx].name.clone(), Type::Param(t_param_ids[gp_idx].clone()))
      gp_idx = gp_idx + 1
    end

    let id = match get_type_id_by_qualified_name(env, t.name.clone(), module_path)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    var methods = Vec::new()
    var i = 0
    while i < t.methods.len() do
      var param_types = Vec::new()
      var j = 0
      while j < t.methods[i].sig.params.len() do
        let p = t.methods[i].sig.params[j]
        let resolved_ty = match p.ty
        when Option::Some(ty_expr) then
          resolve_type_expr(env, &ty_expr)
        when Option::None then
          fresh_type_var(env)
        end
        param_types.push(ParamType { ty: resolved_ty, convention: p.convention })
        j = j + 1
      end
      let ret_ty = match t.methods[i].sig.ret_type
      when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
      when Option::None then Type::Unit
      end
      methods.push(MethodSig {
        name: t.methods[i].sig.name,
        params: param_types,
        ret_type: ret_ty,
        is_method: true
      })
      i = i + 1
    end

    # (impl conformance — validate-first-register-second): build the
    # trait's CONTRACT alongside the MethodSig set — the resolved method
    # signatures (in the trait's generic scope), the method-level generic
    # parameter names and their bound trait names in declaration order,
    # the default-body flag (a missing impl method is allowed ONLY for a
    # defaulted contract method), and the declared effect set (the std
    # effectful-function seeds by the trait's module-qualified identity —
    # an impl method must not require effects beyond the trait's set).
    var contract_methods = Vec::new()
    var ci = 0
    while ci < t.methods.len() do
      var cparams = Vec::new()
      var cj = 0
      while cj < t.methods[ci].sig.params.len() do
        let p = t.methods[ci].sig.params[cj]
        let resolved_ty = match p.ty
        when Option::Some(ty_expr) then
          resolve_type_expr(env, &ty_expr)
        when Option::None then
          fresh_type_var(env)
        end
        cparams.push(ParamType { ty: resolved_ty, convention: p.convention })
        cj = cj + 1
      end
      let cret_ty = match t.methods[ci].sig.ret_type
      when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
      when Option::None then Type::Unit
      end
      var mg_names = Vec::new()
      var mg_bounds = Vec::new()
      var mgi = 0
      while mgi < t.methods[ci].sig.generic_params.len() do
        let mgp = t.methods[ci].sig.generic_params[mgi]
        mg_names.push(mgp.name.clone())
        var bnames = Vec::new()
        for b in mgp.bounds do
          bnames.push(type_expr_name_of(&b))
        end
        mg_bounds.push(bnames)
        mgi = mgi + 1
      end
      let c_is_default = match t.methods[ci].default_body
      when FnBody::FnNone then false
      when _ then true
      end
      let c_effects = declared_effects_of(env, &Vec::new(), module_qualified_effect_name(&module_path, &t.methods[ci].sig.name))
      let c_has_receiver = t.methods[ci].sig.params.len() > 0 && t.methods[ci].sig.params[0].name == "self"
      contract_methods.push(TraitMethodContract {
        name: t.methods[ci].sig.name,
        params: cparams,
        ret_type: cret_ty,
        has_receiver: c_has_receiver,
        receiver_in_params: c_has_receiver,
        has_default: c_is_default,
        generic_param_names: mg_names,
        generic_param_bounds: mg_bounds,
        declared_effects: c_effects
      })
      ci = ci + 1
    end

    pop_scope(env)

    var gen_params = Vec::new()
    var gi = 0
    while gi < t.generic_params.len() do
      gen_params.push(t_param_ids[gi].clone())
      gi = gi + 1
    end

    let td = TypeDef {
      id: id,
      name: t.name.clone(),
      def_kind: TypeDefKind::Trait(methods),
      generic_params: gen_params.clone(),
      kind: TypeKind::Value
      def: Option::None
    }
    store_type_def(env, td, t.span, module_path)
 # (module-semantic trait identity): the trait's TraitId is its
    # DECLARATION identity — the TypeId the module-qualified registration
    # resolved for exactly this (module_path, name) declaration. The
    # pre-store provisional id is NEVER the registry value: store_type_def
    # may have given a DISTINCT declaration in a different module its own
    # fresh module-local TypeId (traits participate in the module-qualified
    # map — record_module_type_name's Trait guard — so the type side's
    # every-declaration-is-its-own-type rule applies to traits), and this
    # qualified re-resolve reads THAT final identity. The bare registry
    # entry is FIRST-WINS: a builtin/std re-declaration re-registers the
    # SAME id and never overwrites the first declaration's entry.
    let decl_tid = match get_type_id_by_qualified_name(env, t.name.clone(), module_path)
    when Option::Some(tid) then tid
    when Option::None then id
    end
    if !env.trait_registry.contains_key(&t.name) then
      env.trait_registry.insert(t.name.clone(), decl_tid.id)
    end
    # (impl conformance — validate-first-register-second): record the
    # trait's CONTRACT under its FINAL declaration identity (decl_tid —
    # the same TraitId the impl side resolves via trait_id_for, so two
    # same-named traits in different modules validate against their own
    # declarations and a std re-declaration of a builtin trait re-records
    # the builtin id's contract with the source shapes). The contract
    # carries the trait-level generic parameter ids in declaration order
    # (the substitution authority for the impl's declared trait
    # arguments), the associated type names, and the resolved method
    # contracts.
    var assoc_names = Vec::new()
    for at in t.assoc_types do
      assoc_names.push(at.name.clone())
    end
    env.trait_contracts.insert(decl_tid.id, TraitContract {
      generic_params: gen_params,
      self_param_ids: Vec::new(),
      assoc_types: assoc_names,
      assoc_param_ids: Vec::new(),
      methods: contract_methods
    })
  when ItemKind::ItemTypeAlias(ta) then
    # Register type alias generic params in scope so resolve_type_expr
    # can find them (e.g., T in a generic alias like type Box2[T] = Box[T]).
 # the alias interns its generic parameters in declaration order
    # under its DefKind::TypeName DefId.
    push_scope(env)
    let ta_owner = type_decl_owner_def(env, &ta.name, module_path)
    let ta_param_ids = intern_generic_params(env, &ta_owner, &ta.generic_params)
    var gp_idx = 0
    while gp_idx < ta.generic_params.len() do
      bind_var(env, ta.generic_params[gp_idx].name.clone(), Type::Param(ta_param_ids[gp_idx].clone()))
      gp_idx = gp_idx + 1
    end

    let id = match get_type_id_by_qualified_name(env, ta.name.clone(), module_path)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    let aliased_type = resolve_type_expr(env, &ta.ty)

    pop_scope(env)

    var gen_params = Vec::new()
    var gi = 0
    while gi < ta.generic_params.len() do
      gen_params.push(ta_param_ids[gi].clone())
      gi = gi + 1
    end

    let td = TypeDef {
      id: id,
      name: ta.name.clone(),
      def_kind: TypeDefKind::Alias(aliased_type),
      generic_params: gen_params,
      kind: TypeKind::Value
      def: Option::None
    }
    store_type_def(env, td, ta.span, module_path)
  when _ then ()
  end
end

def check_item(inout env: TypeEnv, program: Program, item: Item, item_idx: Int) -> Unit
  # Derive the owner keys for this item's functions/methods from the
  # resolver's item_defs (DefId-based; unique across merged files). Methods
  # without a recorded DefId (struct-inherent methods) fall back to a
  # per-item positional key "item::<item_idx>::method::<mi>" that is still
  # collision-free across files (item_idx is unique in the merged program).
  var fn_keys = Vec::new()
  match env.resolutions
  when Option::Some(res) then
    match res.item_defs.get(item_idx)
    when Option::Some(dids) then
      for did in dids do
        fn_keys.push(fn_owner_key_of_def(program, &res, &did))
      end
    when Option::None then ()
    end
  when Option::None then ()
  end
  match item.kind
  when ItemKind::ItemFunction(f) then
 # the owner key is the item's DefId rendered via fn_owner_key_of_def
    # (fn_keys[0]), or — for the no-DefId cases — the module-path-qualified
    # name fallback (module_qualified_fn_key, the SAME scheme the resource
    # checker's fn_owner_key_of_item uses, with the current module's full
    # path), so parameter-binding lookups align across the consumers.
    let owner_key = if fn_keys.len() > 0 then fn_keys[0].clone() else
      module_qualified_fn_key(&env.current_module_path, f.name.clone())
    end
 # the owner DefId the generic parameters were interned under in
    # pass 3 (item_owner_def) — check_function reconstructs the same ids
    # from (owner, declaration index).
    let f_owner = item_owner_def(env, item_idx)
    # The WCET validity (the hard rules): the @[wcet_us(N)] bound vs the
    # body's static worst-case cost — an over-bound body is rejected.
    match parse_real_time_bound(item.attrs)
    when Option::Some(bound) then
      env.wcet_bounds.insert(f.name.clone(), bound)
      match f.body
      when FnBody::FnBlock(b) then
        let estimated = wcet_cost_stmts(&env, &b.stmts)
        if estimated > bound then
          env.errors.push(TypeError {
            code: Option::Some("E0215".to_string()),
            message: "wcet bound exceeded: estimated worst-case cost " + estimated.to_string() + " exceeds the declared bound " + bound.to_string(),
            span: f.span,
          })
        end
      when _ then ()
      end
    when Option::None then ()
    end
    check_function(env, f, owner_key, &f_owner)
  when ItemKind::ItemImpl(i) then
    if fn_keys.len() == i.methods.len() then
      check_impl(env, i, &fn_keys)
    else
      var keys = Vec::new()
      var mi = 0
      while mi < i.methods.len() do
        keys.push("item::" + item_idx.to_string() + "::method::" + mi.to_string())
        mi = mi + 1
      end
      check_impl(env, i, &keys)
    end
  when ItemKind::ItemStruct(s) then
    if s.methods.len() > 0 then
      var type_args = Vec::new()
      var sgp_idx = 0
      while sgp_idx < s.generic_params.len() do
        type_args.push(TypeExpr { kind: TypeExprKind::Named(s.generic_params[sgp_idx].name.clone(), Vec::new()), span: s.span })
        sgp_idx = sgp_idx + 1
      end
      let res_for_type = TypeExpr { kind: TypeExprKind::Named(s.name.clone(), type_args), span: s.span }
      var s_keys = Vec::new()
      if fn_keys.len() == s.methods.len() then
        s_keys = fn_keys
      else
        var smi = 0
        while smi < s.methods.len() do
          s_keys.push("item::" + item_idx.to_string() + "::method::" + smi.to_string())
          smi = smi + 1
        end
      end
      check_impl(env, &ImplDecl {
        vis: s.vis,
        generic_params: s.generic_params.clone(),
        trait_name: Option::None,
        for_type: res_for_type.clone(),
        self_type: res_for_type,
        where_clause: Vec::new(),
        methods: s.methods.clone(),
        assoc_types: Vec::new(),
        span: s.span
      }, &s_keys)
    end
  when ItemKind::ItemConst(c) then
    env.check_ctx = "const:" + c.name
      push_scope(env)
    let const_ty = match c.ty
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then fresh_type_var(env)
    end
 # (channel b): a const whose type is (or contains) the RAW Slice
    # view (UnsafeSlice) is program-lifetime state holding a raw view —
    # rejected.
    check_no_escaping_slice(env, &const_ty, c.span, "stored in a const")
    let value_ty = check_expr(env, &c.value)
    unify(env, value_ty, const_ty, c.span)
    pop_scope(env)
  when ItemKind::ItemStatic(s) then
    # Check static variable initializer (already registered in pass 3)
    env.check_ctx = "static:" + s.name
    push_scope(env)
    let static_ty = resolve_type_expr(env, &s.ty)
 # (channel b): a static whose type is (or contains) the RAW Slice
    # view (UnsafeSlice) is program-lifetime state holding a raw view —
    # rejected.
    check_no_escaping_slice(env, &static_ty, s.span, "stored in a static")
    let value_ty = check_expr(env, &s.value)
    unify(env, value_ty, static_ty, s.span)
    pop_scope(env)
  when ItemKind::ItemEffectDecl(e) then
    # The algebraic-effects typed registration (pass 4 — every referenced
    # type resolves here): intern the semantic EffectId (idempotent — the
    # pre-registration pass already interned it), resolve each op's
    # parameter/return types into the typed op table, and index the
    # qualified name so the perform surface's EFFECT.op references resolve.
    # The op index is the declaration-order identity the perform/handler
    # lowering and the runtime dispatch share.
    let eid = intern_module_effect(&mut env.effects, &env.current_module_path, &e.name)
    var typed_ops = Vec::new()
    var op_i = 0
    while op_i < e.ops.len() do
      var op_params = Vec::new()
      var par_i = 0
      while par_i < e.ops[op_i].params.len() do
        let p_ty = resolve_type_expr(env, &e.ops[op_i].params[par_i].ty)
        # The bounded row's Copy gate: an operation's payload crosses the
        # perform boundary as a plain value tuple through the runtime's
        # untyped frame — resource ownership never crosses it.
        if !is_trivially_copyable(env, &p_ty) then
          type_add_error(env, "effect operation parameter `" + e.ops[op_i].params[par_i].name + "` of `" + e.name + "::" + e.ops[op_i].name + "` must be a Copy type (the bounded algebraic-effects row moves the op payload as a plain value tuple; resource ownership does not cross the perform boundary)", e.ops[op_i].span)
        end
        op_params.push(p_ty)
        par_i = par_i + 1
      end
      var op_ret = Type::Unit
      match e.ops[op_i].ret
      when Option::Some(ret_te) then op_ret = resolve_type_expr(env, &ret_te)
      when Option::None then ()
      end
      if !is_trivially_copyable(env, &op_ret) then
        type_add_error(env, "effect operation `" + e.name + "::" + e.ops[op_i].name + "` must return a Copy type (the bounded algebraic-effects row returns the op result through the runtime's untyped result slot)", e.ops[op_i].span)
      end
      typed_ops.push(TypedEffectOp {
        name: e.ops[op_i].name.clone(),
        params: op_params,
        ret: op_ret
      })
      op_i = op_i + 1
    end
    env.typed_effects.insert(eid.id, TypedEffectDecl {
      id: eid.clone(),
      name: e.name.clone(),
      ops: typed_ops
    })
    let qkey = if env.current_module_path.is_empty() then e.name.clone() else env.current_module_path.join("::") + "::" + e.name.clone() end
    env.effect_name_index.insert(qkey, eid.id)
  when _ then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Effect / budget checking — the transitive effect discipline
# ———————————————————————————————————————————————————————————————
# The end-of-check effect pass (run once after every function body is
# checked, from type_check_program_env): the per-function COMPUTED effect
# sets (the union of the callees' declared effects, accumulated at the
# call-recording sites) are closed TRANSITIVELY over the recorded call
# graph (computed[F] ends up the union of the declared effects of every
# function reachable from F), then each function's computed set is
# compared against its DECLARED set:
#   - a function calling an effectful function WITHOUT declaring the
#     effect — an effect in the computed set the declared set never
#     declared — is an ERROR: "function calls an effectful function but
#     declares no effect: <effect name>" (the transitive case fires at
#     every function on the path into the effect, exactly as the direct
#     case);
#   - a declared effect the function never uses is a LINT (a warning,
#     reported through the checker's warnings channel) — an unused
#     declaration is informational, never a rejection.
def check_effect_sets(inout env: TypeEnv) -> Unit
  # 1. transitive closure: computed[caller] += declared[callee] ∪
  #    computed[callee] over every recorded call-graph edge, to fixpoint.
  var graph_keys = env.fn_call_graph.entries()
  var changed = true
  while changed do
    changed = false
    var ki = 0
    while ki < graph_keys.len() do
      let (caller, callees) = graph_keys[ki]
      var comp = Vec::new()
      match env.fn_computed_effects.get(caller.clone())
      when Option::Some(c) then comp = c.clone()
      when Option::None then ()
      end
      for ckey in callees do
        var full = Vec::new()
        match env.fn_declared_effects.get(ckey.clone())
        when Option::Some(d) then full = d.clone()
        when Option::None then ()
        end
        match env.fn_computed_effects.get(ckey.clone())
        when Option::Some(c2) then
          let _ = effect_set_append(&mut full, c2.clone())
        when Option::None then ()
        end
        if effect_set_append(&mut comp, full) then changed = true end
      end
      env.fn_computed_effects.insert(caller.clone(), comp)
      ki = ki + 1
    end
  end
  # 2. computed vs declared — an effect the function performs without
  #    declaring it is the checker's transitive violation. The std module's
  #    own functions are exempt (the std implementation is the trusted
  #    base; its declared effects are the API contract for user callers).
  var comp_entries = env.fn_computed_effects.entries()
  var ci = 0
  while ci < comp_entries.len() do
    let (key, comp) = comp_entries[ci]
    if !fn_effect_is_std(env, &key) then
      match env.fn_declared_effects.get(key.clone())
      when Option::Some(decl) then
        for e in comp do
          if !effect_set_contains(&decl, &e) then
            let span = match env.fn_declared_effect_spans.get(key.clone())
            when Option::Some(s) then s.clone()
            when Option::None then span_dummy()
            end
            type_add_error(env, "function calls an effectful function but declares no effect: " + effect_display_name(env, &e), span)
          end
        end
      when Option::None then ()
      end
    end
    ci = ci + 1
  end
  # 3. a declared effect the function never uses — a lint (warning);
  #    the std module's own functions are exempt (their declared effects
  #    are declarations for their USER callers, not self-usage claims).
  var decl_entries = env.fn_declared_effects.entries()
  var di = 0
  while di < decl_entries.len() do
    let (key, decl) = decl_entries[di]
    if !fn_effect_is_std(env, &key) then
      var comp2 = Vec::new()
      match env.fn_computed_effects.get(key.clone())
      when Option::Some(c) then comp2 = c.clone()
      when Option::None then ()
      end
      for e in decl do
        if !effect_set_contains(&comp2, &e) then
          let span = match env.fn_declared_effect_spans.get(key.clone())
          when Option::Some(s) then s.clone()
          when Option::None then span_dummy()
          end
          let fname = match env.fn_declared_effect_names.get(key.clone())
          when Option::Some(n) then n.clone()
          when Option::None then key.clone()
          end
          add_warning(env, "declared effect " + effect_display_name(env, &e) + " is never used by function " + fname, span)
        end
      end
    end
    di = di + 1
  end
end

# ———————————————————————————————————————————————————————————————
# Generic-parameter interning 
# ———————————————————————————————————————————————————————————————
# Every declaration interns its generic parameters in declaration order at
# registration (the GenericParamId index IS the declaration position):
#   - type declarations (pass 2): under the type's DefKind::TypeName DefId
#     from the resolver's module_symbols (see type_decl_owner_def);
#   - functions / extern functions (pass 3): under the item's DefId
#     (item_owner_def — def_id_of_item, or the deterministic module -2
#     fallback);
#   - impl-level and method-level parameters (check_impl): impls under a
#     fresh synthetic owner; methods under their resolver registered method DefId
#     (or the deterministic module -3 fallback, impl_method_owner_def).
# The body-checking passes RECONSTRUCT the same ids from the owner DefId +
# declaration index (generic_param_id_at) and never re-intern.

# The owner DefId of an item's function declarations — the resolver's
# item_defs first entry (def_id_of_item) when recorded, else the
# deterministic synthetic fallback (module id -2 + the item index — the
# SAME owner every pass derives for the same item, so the pass-3 interning
# and the pass-4 id reconstruction agree).
def item_owner_def(env: TypeEnv, item_idx: Int) -> DefId
  match env.resolutions
  when Option::Some(res) then
    match def_id_of_item(res, item_idx)
    when Option::Some(did) then did
    when Option::None then DefId { module: ModuleId { id: SYNTHETIC_MODULE_ITEM_FALLBACK }, index: item_idx as UInt }
    end
  when Option::None then DefId { module: ModuleId { id: SYNTHETIC_MODULE_ITEM_FALLBACK }, index: item_idx as UInt }
  end  end
end

# The GenericParamId of the i-th declared generic parameter of `owner` —
# the reconstruction used by the body-checking passes (the interning ran
# at registration; the ids are (owner, declaration index) by construction).
def generic_param_id_at(owner: DefId, index: Int) -> GenericParamId
  GenericParamId { owner: owner.clone(), index: index as UInt }
end

# The owner DefId of a type declaration's generic parameters: the
# resolver's module_symbols DefKind::TypeName entry for exactly this
# (module path, name) pair when recorded; else a fresh synthetic owner.
def type_decl_owner_def(inout env: TypeEnv, name: String, module_path: Vec[String]) -> DefId
  match env.resolutions
  when Option::Some(res) then
    let key = module_qualified_key(module_path, name)
    match res.module_symbols.get(&key)
    when Option::Some(did) then
      match def_kind_of(&res, &did)
      when Option::Some(k) then
        if k == DefKind::TypeName then
          did
        else
          fresh_synthetic_owner(&mut env.generic_param_table)
        end
      when Option::None then fresh_synthetic_owner(&mut env.generic_param_table)
      end
    when Option::None then fresh_synthetic_owner(&mut env.generic_param_table)
    end
  when Option::None then fresh_synthetic_owner(&mut env.generic_param_table)
  end  end
end

# The owner DefId of an impl method's generic parameters: the resolver's
# module_symbols entry under the impl's for_type key, MODULE-QUALIFIED
# ("path::Type::method" — the impl's owner path, env.current_module_path
# at check_impl time) when recorded; else the deterministic synthetic
# fallback (the SYNTHETIC_MODULE_IMPL_METHOD_FALLBACK band, module id -3:
# impl index in the high bits + method index) — computed identically in
# the signature pass and the body pass of check_impl, so the interning
# and the id reconstruction agree.
def impl_method_owner_def(env: TypeEnv, for_type: TypeExpr, method: FunctionDecl, impl_idx: Int, method_idx: Int) -> DefId
  match env.resolutions
  when Option::Some(res) then
    let mkey = impl_registry_method_key(for_type, &method.name)
    let qkey = module_qualified_key(&env.current_module_path, &mkey)
    match res.module_symbols.get(&qkey)
    when Option::Some(did) then
      match def_kind_of(&res, &did)
      when Option::Some(k) then
        if k == DefKind::Method then
          did
        else
          DefId { module: ModuleId { id: SYNTHETIC_MODULE_IMPL_METHOD_FALLBACK }, index: ((impl_idx as UInt) << 16) + (method_idx as UInt) }
        end
      when Option::None then DefId { module: ModuleId { id: SYNTHETIC_MODULE_IMPL_METHOD_FALLBACK }, index: ((impl_idx as UInt) << 16) + (method_idx as UInt) }
      end
    when Option::None then DefId { module: ModuleId { id: SYNTHETIC_MODULE_IMPL_METHOD_FALLBACK }, index: ((impl_idx as UInt) << 16) + (method_idx as UInt) }
    end
  when Option::None then DefId { module: ModuleId { id: SYNTHETIC_MODULE_IMPL_METHOD_FALLBACK }, index: ((impl_idx as UInt) << 16) + (method_idx as UInt) }
  end  end
end

# Intern a declaration's generic parameters in declaration order under
# `owner`; returns the ids. The GenericParamId order IS the declaration
# order (the interning allocates indices as the owner's running count).
# (numeric packing invariant): the packed numeric key
# (generic_param_id_numeric — the owner's flattening shifted by 8 bits
# plus the parameter index) reserves the LOW 8 bits for the index, so a
# declaration with MORE THAN 255 generic parameters would corrupt the
# owner identity in the key. The invariant is ENFORCED HERE — at the
# declaration interning site — as a compilation diagnostic (compilation
# aborts; the packed key is never produced for an over-limit
# declaration).
def intern_generic_params(inout env: TypeEnv, owner: DefId, names: Vec[GenericParam]) -> Vec[GenericParamId]
  if names.len() > 255 then
    type_add_error(env, "generic parameter limit exceeded: a declaration with " + names.len().to_string() + " generic parameters (the packed GenericParamId numeric key reserves the low 8 bits for the parameter index — at most 255 parameters per declaration)", Span { file: "", start: 0, end_pos: 0 })
  end
  var ids = Vec::new()
  var i = 0
  while i < names.len() do
    ids.push(intern_generic_param(&mut env.generic_param_table, owner, names[i].name.clone()))
    i = i + 1
  end
  ids
end

# ———————————————————————————————————————————————————————————————
# Generic-parameter trait bounds 
# ———————————————————————————————————————————————————————————————
#
# A bare Type::Param receiver inside a generic body (`self.inner.advance()`
# on inner: I with `I: Iterator[T]`) resolves through the parameter's trait
# bounds. The bounds are registered HERE when the generic function's/impl's
# parameters enter scope, and consumed by resolve_method_type's
# Param-receiver section. the bounds are keyed by the parameter's
# IDENTITY (numeric GenericParamId) — two same-named parameters of
# different declarations never collide.

# Resolve one trait-argument TypeExpr in the current generic scope: a bare
# reference to an in-scope generic parameter (e.g. the T of `I: Iterator[T]`)
# resolves through the scope binding to Type::Param — resolve_type_expr alone
# would treat it as an unknown Named type.
def resolve_param_bound_arg(inout env: TypeEnv, te: TypeExpr) -> Type
  match te.kind
  when TypeExprKind::Named(name, _) then
    match lookup_var(env, name.clone())
    when Option::Some(t) then t.clone()
    when Option::None then resolve_type_expr(env, te)
    end
  when _ then resolve_type_expr(env, te)
  end  end
end

# (module-semantic trait identity): resolve a trait name to its
# TraitId through the module-qualified declaration map — the resolver's
# DefKind::Trait module_symbols entries mirrored at trait-registration time
# (record_module_type_name). The TraitId is the declaration's TypeId value
# (the declaration identity — never a bare-name authority):
#   1. the CURRENT module's OWN qualified declaration ("path::name" of
#      env.current_module_path) shadows all others;
#   2. a bare name with no own declaration falls back to the bare
#      first-wins registry entry — the compatibility fallback (builtin
#      traits and the first source declaration of each name), mirroring
#      resolve_bare_type_name's recoverable-fallback behavior when >= 2
#      DISTINCT foreign trait declarations exist (the qualified entries
#      keep those declarations apart; only Trait-typed entries count — a
#      same-named struct in another module is a different namespace);
#   3. TraitId(-1) when the name is not a registered trait (a
#      not-yet-registered or unknown trait never matches a registered
#      impl).
def trait_id_for(env: TypeEnv, name: String) -> TraitId
  let own_key = module_qualified_key(&env.current_module_path, name)
  var own_tid = Option::None
  match env.module_type_names.get(own_key.clone())
  when Option::Some(idx) then
    let td = env.type_list[idx]
    if type_def_is_trait(&td) then
      own_tid = Option::Some(TraitId { id: td.id.id })
    end
  when Option::None then ()
  end
  match own_tid
  when Option::Some(tid) then
    tid
  when Option::None then
    var foreign_distinct = 0
    var foreign_seen = Map::new()
    let suffix = "::" + name.clone()
    let entry_vec = env.module_type_names.entries()
    for (key, idx) in entry_vec do
      let ftd = env.type_list[idx]
      if type_def_is_trait(&ftd) then
        var matches = false
        if key == name.clone() then
          matches = true
        else
          if key.ends_with(suffix) then
            matches = true
          end
        end
        if matches && key != own_key then
          if !foreign_seen.contains_key(&ftd.id.id) then
            foreign_seen.insert(ftd.id.id, true)
            foreign_distinct = foreign_distinct + 1
          end
        end
      end
    end
    if foreign_distinct >= 2 then
      # Genuinely ambiguous bare trait name (>= 2 DISTINCT trait
      # declarations in other modules): the first-wins registry entry is
      # the recoverable fallback (mirrors resolve_bare_type_name).
      ()
    end
    match env.trait_registry.get(name.clone())
    when Option::Some(tid) then TraitId { id: tid }
    when Option::None then TraitId { id: -1 }
    end
  end
end

# Record one trait bound (id + resolved type arguments) for a generic
# parameter. Appends to the parameter's existing bounds. keyed by
# the parameter's numeric GenericParamId; the name is diagnostics-only.
def record_param_trait_bound(inout env: TypeEnv, gpid: GenericParamId, bound_ty: TypeExpr) -> Unit
  let trait_name = type_expr_name_of(bound_ty)
  if trait_name != "" then
    var args = Vec::new()
    match bound_ty.kind
    when TypeExprKind::Named(_, tys) then
      var i = 0
      while i < tys.len() do
        args.push(resolve_param_bound_arg(env, &tys[i]))
        i = i + 1
      end
    when _ then ()
    end
    let pkey = generic_param_id_numeric(gpid)
    var cur = match env.param_bounds.get(pkey)
    when Option::Some(v) then v.clone()
    when Option::None then Vec::new()
    end
    cur.push(ParamTraitBound {
      trait_id: trait_id_for(env, &trait_name),
      trait_name: trait_name,
      args: args
    })
    env.param_bounds.insert(pkey, cur)
  end
end

# Register the trait bounds of a generic-parameter list (the inline
# `T: Trait[Arg]` bounds). The ids pair positionally with the AST
# parameters (both are the declaration order). bounds are keyed by
# the parameter's identity — a same-named parameter of an inner
# declaration re-registers its own entry, and an unconstrained shadow
# ERASES only its own — the outer scope's bound can never leak onto a
# shadowing parameter.
def record_param_bounds(inout env: TypeEnv, generic_params: Vec[GenericParam], param_ids: Vec[GenericParamId]) -> Unit
  var i = 0
  while i < generic_params.len() do
    let gp = generic_params[i]
    if i < param_ids.len() then
      let pkey = generic_param_id_numeric(&param_ids[i])
      env.param_bounds.remove(&pkey)
      for b in gp.bounds do
        record_param_trait_bound(env, &param_ids[i], &b)
      end
    end
    i = i + 1
  end
end

# Register the trait bounds of a where-clause (`where T: Trait[Arg]`). Only
# predicates over a generic parameter are recorded (the predicate subject
# resolves through the scope to Type::Param — keyed by the parameter's
# identity); concrete subjects are ignored.
def record_where_predicate_bounds(inout env: TypeEnv, where_clause: Vec[WherePredicate]) -> Unit
  var i = 0
  while i < where_clause.len() do
    let pred = where_clause[i]
    match pred.ty.kind
    when TypeExprKind::Named(pname, _) then
      match lookup_var(env, pname.clone())
      when Option::Some(t) then
        match t
        when Type::Param(gpid) then
          let pkey = generic_param_id_numeric(&gpid)
          env.param_bounds.remove(&pkey)
          for b in pred.bounds do
            record_param_trait_bound(env, &gpid, &b)
          end
        when _ then ()
        end
      when Option::None then ()
      end
    when _ then ()
    end
    i = i + 1
  end
end

# ———————————————————————————————————————————————————————————————
# SLICE SAFETY — ONE REPRESENTATION, ONE SEMANTIC AUTHORITY (P0 — the
# safe-view closure): the SOURCE-spelled Slice/StrView ARE the shared/
# pinned forms; the raw {ptr,len} view is ONLY the explicit UnsafeSlice
# (unsafe/FFI-only).
# ———————————————————————————————————————————————————————————————
# THE ONE AUTHORITY (the reviewer's shared/pinned backing — the safe-view
# model; std contract in std/collections.tg / std/core.tg):
#   - The SOURCE-spelled Slice[T] IS the SHARED/PINNED form — the
#     std-declared `Slice[T] { inner: Arc[SliceBacking[T]] }` (the
#     Arc-class {ptr,len}: the backing = the pinned buffer + the window's
#     offset/len). The Arc keeps the pinned backing alive — the view
#     SURVIVES the original owner's drop and the owner's capacity-changing
#     mutations (the backing is the separate pinned allocation). The safe
#     StrView is the same class (StrView { inner: Arc[StrViewBacking] }).
#     The shared forms are ordinary OWNING values: the resource checker
#     tracks them like any Arc-backed value (owns_state=true,
#     requires_drop_glue via the Arc's Drop) — NO escape tracking, no
#     access-scoping, no lifetime inference, NO "eventual mechanism". They
#     can be returned, stored in fields/containers/statics, and captured.
#   - The RAW view is the "UnsafeSlice" BUILTIN (the LangItems slice id) —
#     the 16-byte borrowed { ptr: Ptr[T], len: UInt } fat value
#     (slice_view_layout). It is the UNSAFE/FFI-ONLY form: safe code cannot
#     produce it (the opaque builtin has no constructor; no safe API
#     returns it in an escaping position). The ONLY raw views safe code
#     ever sees are the compiler-scoped LOOP-CONSUMED iterable forms
#     (chars/bytes/split/iter/keys/values — builtin method results consumed
#     by the enclosing for-loop) and the compiler-manufactured literal
#     coercion behind vec!, and the checker keeps them access-scoped /
#     non-escapable at the four escape channels:
#   (a) RETURN   — a raw-view-typed value must not be returned from a
#                  function: the declared return type is checked at every
#                  callable declaration (free functions, impl/struct
#                  methods, extern functions, closure annotations);
#   (b) STORE    — a raw view must not be stored into longer-lived state:
#                  struct fields, enum variant fields, statics, consts,
#                  and the aggregate literals (array/tuple elements) that
#                  would hold the view;
#   (c) CAPTURE  — a raw view must not be captured into an escaping
#                  closure: the closure capture record is checked at the
#                  capture site;
#   (d) MUTATION — a raw-view-typed local's backing (the owner place the
#                  view was derived from) cannot be mutated/reallocated
#                  while the view local is live: enforced in the resource
# checker (there) via the IterationPlan mutation
#                  machinery (plan_stmt_mutates_place) over the live-view
#                  registry.
# The view-producing forms that MUST escape are routed through the OWNED/
# SHARED forms in the kernel: std's as_bytes/bytes/split declare the owned
# Vec results; Vec::as_slice / String::as_str_view return the SHARED
# (pinned-backing) forms; for-loop iterables are consumed by the loop.
# The containment walk is the single type_contains_slice_view predicate —
# the raw UnsafeSlice BUILTIN (LangItems id) in any stored position (Adt
# arguments, tuples, fixed arrays, references, effects). Type::Param /
# Type::Var fail OPEN (false): a generic instantiation is checked at the
# concrete use sites.
pub def is_slice_view_type_of(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, _) then tid.id == env.lang_items.slice
  when _ then false
  end  end
end

# The SAFE SHARED/PINNED view forms (the std-declared Arc-class views) —
# the resource checker's live-view registry must NEVER treat them as raw
# views: the backing owns, so they need no escape tracking. Selected by
# the std type names (Slice / StrView — the std-declared Adt names; the
# source-spelled "Slice" IS the shared form).
pub def is_shared_view_type_of(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, tid)
    when Option::Some(td) then td.name == "Slice" || td.name == "StrView"
    when Option::None then false
    end
  when _ then false
  end  end
end

def type_contains_slice_view(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.slice then
      true
    else
      var found = false
      var ai = 0
      while ai < args.len() do
        if type_contains_slice_view(env, &args[ai]) then found = true end
        ai = ai + 1
      end
      found
    end
  when Type::FixedArray(elem, _) then type_contains_slice_view(env, elem)
  when Type::Tuple(elems) then
    var found = false
    var ei = 0
    while ei < elems.len() do
      if type_contains_slice_view(env, &elems[ei]) then found = true end
      ei = ei + 1
    end
    found
  when Type::RefInternal(inner, _) then type_contains_slice_view(env, inner)
  when Type::Effect(_, inner) then type_contains_slice_view(env, inner)
  when _ then false
  end  end
end

# reject a type that holds the RAW Slice view in stored / longer-lived
# state at the channel's declaration site. `what` renders the channel in
# the diagnostic ("returned from a function", "stored in a struct field",
#...). The SAFE shared/pinned forms (Slice/StrView — the Arc-backed
# views) are ordinary owning values and never reach this rejection.
def check_no_escaping_slice(inout env: TypeEnv, ty: Type, span: Span, what: String) -> Unit
  if type_contains_slice_view(env, ty) then
    type_add_error(env, "the raw Slice view (UnsafeSlice[T]) cannot be " + what + ": the raw {ptr,len} view is unsafe/FFI-only and must not outlive its backing buffer (use the shared/pinned form: Vec::as_slice / String::as_str_view — the Arc-backed Slice/StrView)", span)
  end
end

# ———————————————————————————————————————————————————————————————
# The WCET analyzer: the @[wcet_us(N)] annotation's bound is parsed and
# validated (a positive integer), the function body's static worst-case
# cost is estimated with the operation cost model (the simple ops 1, the
# calls the callee's declared bound or the default 20, the blocks the
# sum, the ifs the max arm, the loops the body * the loop factor), and
# an over-bound body is REJECTED with the hard validity error — "actual
# analyzer and hard validity rules", never a silent pass.
# ———————————————————————————————————————————————————————————————

# The wcet_us attribute's bound, or None (no annotation).
def parse_real_time_bound(attrs: Vec[Attribute]) -> Option[Int]
  match attribute_named(attrs, "wcet_us")
  when Option::Some(attr) then
    if attr.args.len() >= 1 then
      let bound = wcet_arg_int(&attr.args[0])
      if bound > 0 then
        Option::Some(bound)
      else
        Option::None
      end
    else
      Option::None
    end
  when Option::None then Option::None
  end  end
end

def wcet_arg_int(s: String) -> Int
  var acc = 0
  for ch in s.chars() do
    if ch >= '0' && ch <= '9' then
      acc = acc * 10 + (ch as Int - '0' as Int)
    end
  end
  acc
end

# The static worst-case cost of a statement list (the bounded model).
def wcet_cost_stmts(env: TypeEnv, stmts: Vec[Stmt]) -> Int
  var total = 0
  for st in stmts do
    total = total + wcet_cost_stmt(env, &st)
  end
  total
end

def wcet_cost_stmt(env: TypeEnv, st: Stmt) -> Int
  match st.kind
  when StmtKind::StmtLet(_, _, ls, _) then
    wcet_cost_expr(env, &ls) + 1
  when StmtKind::StmtAssign(_, e) then wcet_cost_expr(env, &e) + 1
  when StmtKind::StmtExpr(e) then wcet_cost_expr(env, &e)
  when StmtKind::StmtIf(if_stmt) then
    let cond_cost = wcet_cost_expr(env, &if_stmt.cond)
    let then_cost = wcet_cost_stmts(env, &if_stmt.then_block.stmts)
    let else_cost = match if_stmt.else_block
    when Option::Some(b) then wcet_cost_stmts(env, &b.stmts)
    when Option::None then 0
    end
    cond_cost + (if then_cost > else_cost then then_cost else else_cost end) + 1
  when StmtKind::StmtMatch(m) then wcet_cost_expr(env, &m.scrutinee) + 1
  when StmtKind::StmtWhile(cond, body) then (wcet_cost_expr(env, &cond) + wcet_cost_stmts(env, &body.stmts)) * 10
  when StmtKind::StmtFor(fs) then wcet_cost_stmts(env, &fs.body.stmts) * 10 + 2
  when StmtKind::StmtLoop(b) then wcet_cost_stmts(env, &b.stmts) * 10
  when StmtKind::StmtReturn(e) then
    match e
    when Option::Some(v) then wcet_cost_expr(env, &v)
    when Option::None then 1
    end
  when StmtKind::StmtDefer(_) then 1
  when _ then 1
  end  end
end

def wcet_cost_expr(env: TypeEnv, e: Expr) -> Int
  match e.kind
  when ExprKind::ExprIntLit(_) | ExprKind::ExprFloatLit(_) | ExprKind::ExprCharLit(_) then 1
  when ExprKind::ExprStringLit(_) then 1
  when ExprKind::ExprBoolLit(_) then 1
  when ExprKind::ExprIdent(_) | ExprKind::ExprPath(_) then 1
  when ExprKind::ExprUnaryOp(_, inner) then wcet_cost_expr(env, &inner) + 1
  when ExprKind::ExprBinaryOp(_, a, b) then wcet_cost_expr(env, &a) + wcet_cost_expr(env, &b) + 1
  when ExprKind::ExprIndex(base, idx) then wcet_cost_expr(env, &base) + wcet_cost_expr(env, &idx) + 1
  when ExprKind::ExprFieldAccess(base, _) then wcet_cost_expr(env, &base) + 1
  when ExprKind::ExprCall(callee, args) then
    var total = wcet_cost_expr(env, &callee)
    for a in args do
      total = total + wcet_cost_expr(env, &a)
    end
    # the callee's declared bound when available (the transitive cost),
    # else the default 20.
    match callee.kind
    when ExprKind::ExprPath(p) then
      if p.segments.len() > 0 then
        let callee_name = p.segments[p.segments.len() - 1].clone()
        match env.wcet_bounds.get(&callee_name)
        when Option::Some(b) then total + b
        when Option::None then total + 20
        end
      else
        total + 20
      end
    when _ then total + 20
    end
  when ExprKind::ExprBlock(b) then wcet_cost_stmts(env, &b.stmts)
  when ExprKind::ExprIf(if_e) then wcet_cost_expr(env, &if_e.cond) + 1
  when _ then 2
  end  end
end

def check_function(inout env: TypeEnv, f: FunctionDecl, owner_key: String, f_owner: DefId) -> Unit
  push_scope(env)
  env.check_ctx = "fn:" + f.name
  
 # Register generic type parameters in scope. the ids were
  # interned in pass 3 under f_owner (item_owner_def — the item's DefId or
  # the deterministic module -2 fallback); this pass reconstructs the same
  # ids from (owner, declaration index) — never re-interns, so the
  # declaration-order indices stay stable.
  var gp_idx = 0
  while gp_idx < f.generic_params.len() do
    bind_var(env, f.generic_params[gp_idx].name.clone(), Type::Param(generic_param_id_at(f_owner, gp_idx)))
    gp_idx = gp_idx + 1
  end
  var fn_param_ids = Vec::new()
  gp_idx = 0
  while gp_idx < f.generic_params.len() do
    fn_param_ids.push(generic_param_id_at(f_owner, gp_idx))
    gp_idx = gp_idx + 1
  end

 # record the generic parameters' trait bounds (inline bounds +
  # where-clause) so bare Param receivers in the body resolve through them.
  record_param_bounds(env, &f.generic_params, &fn_param_ids)
  record_where_predicate_bounds(env, &f.where_clause)

  # Bind parameters
  # Parameter bindings are recorded per-owner (keyed by the function's DefId
  # via fn_owner_key — never a span offset, which would collide across merged
  # files) in declaration order, in the dedicated param_binding_resolutions
  # map. This keeps parameter keys in a domain that can never collide with
  # pattern node ids (see the TypeEnv field comment).
  var param_local_ids = Vec::new()
  var fn_param_types = Vec::new()
  var i = 0
  while i < f.params.len() do
    let p = f.params[i]
    let ty = match p.ty
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then fresh_type_var(env)
    end
    bind_var(env, p.name, ty)
    param_local_ids.push(env.local_id_counter - 1)
    fn_param_types.push(ParamType { ty: ty, convention: p.convention })
    i = i + 1
  end
  env.param_binding_resolutions.insert(owner_key, param_local_ids)
 # record the function's generic parameter ids under the SAME
  # owner key (the MIR builder reconstructs the lowered Type::Param ids
  # from this record, paired positionally with the lowered declaration's
  # generic list — the substs-order contract).
  env.generic_param_ids.insert(owner_key, fn_param_ids)
  
  # Get expected return type
  let ret_type = match f.ret_type
  when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
  when Option::None then Type::Unit
  end
 # (channel a): a RAW Slice view (UnsafeSlice) must not be RETURNED from
  # a function — the declared return type is rejected when it is (or
  # contains) the raw view (the shared/pinned source-spelled Slice — the
  # std-declared shared struct — is an
  # ordinary owning value and passes freely).
  check_no_escaping_slice(env, &ret_type, f.span, "returned from a function")
 # record the function's typed signature under the SAME owner key (the
  # MIR reads the declaration's parameter/return types from this record —
  # the typed table is the authority; TypeExpr is never interpreted after
  # checking). A pass-4 body-check unification chases any inference
  # variable at serialization (type_check_typed). The record carries the
  # DECLARED EFFECT SET (the parsed `effect[...]` names interned through
  # the registry, or the std effectful-function seeds) and the DECLARED
  # BUDGET (the @budget annotation's typed record) — the effect discipline
  # and the MIR's carry both read them from here.
  let declared_effects = declared_effects_of(env, &f.effects, module_qualified_effect_name(&env.current_module_path, &f.name))
  let decl_key = fn_effect_def_key(env, &f_owner)
  env.fn_declared_effects.insert(decl_key.clone(), declared_effects.clone())
  env.fn_declared_effect_names.insert(decl_key.clone(), f.name.clone())
  env.fn_declared_effect_spans.insert(decl_key.clone(), f.span)
  env.fn_effect_modules.insert(decl_key.clone(), env.current_module_path.clone())
  let declared_budget = typed_budget_of(&f.budget_val)
  env.typed_fn_signatures.insert(owner_key, FnSignature { params: fn_param_types, ret_type: ret_type.clone(), declared_effects: declared_effects, declared_budget: declared_budget })
  
 # every `return expr` in the body unifies immediately with the
  # declared return type (unconditional — not dependent on the last
  # statement). Cleared after the body check.
  env.expected_return = Option::Some(ret_type.clone())
  # Check body (the body's call sites record into this function's computed
  # effect set — current_fn_key is the def-key registration used above).
  env.current_fn_key = decl_key
  match f.body
  when FnBody::FnBlock(block) then
    let body_flow = check_block(env, &block, true)
    if is_unit_type(&ret_type) then
      # A Unit-returning function discards its trailing statement's value
      # (e.g. `if c then advance(p) end` where advance returns Token).
      ()
    else
      unify(env, body_flow.normal, ret_type, f.span)
    end
  when FnBody::FnExpr(expr) then
    let expr_type = check_expr(env, &expr)
    unify(env, expr_type, ret_type, expr.span)
    # (partial moves): the function tail is the implicit return — a
    # projected OWNING tail is moved out of its root (the checker's
    # transfer_consume mirror at the FnExpr body check).
    record_projected_consume(env, &expr)
  when _ then ()
  end
  env.current_fn_key = ""
  env.expected_return = Option::None
  
  pop_scope(env)
end

# ———————————————————————————————————————————————————————————————
# Impl conformance validation (validate-first-register-second)
# ———————————————————————————————————————————————————————————————
#
# check_impl registers an ImplInfo into env.impls — the solver's candidate
# set — AFTER this validation: an impl that does not satisfy its trait's
# declared CONTRACT never enters the candidate set, even transiently. The
# contract is the TraitContract recorded at the trait registration sites
# (register_builtin_trait / collect_type_def's ItemTrait arm) under the
# same TraitId the impl resolves (trait_id_for — the module-semantic
# declaration identity, so two same-named traits in different modules
# validate against their own declarations).
#
# The rules:
#   (a) every NON-DEFAULT contract method must be present in the impl;
#   (b) duplicate impl methods are rejected;
#   (c) an impl member that is not a contract method is rejected as an
#       unknown member — the language permits inherent-extension methods
#       ONLY in inherent impls (trait_name == ""); a trait impl's extra
#       members are typos/leaks and are rejected;
#   (d) the parameter count must be EXACT after the receiver-position
#       normalization (the source contract's `self` is a recorded
#       parameter; the builtin stub's synthetic receiver is a wildcard);
#   (e) the parameter TYPES must unify after the Self / trait-argument /
#       associated-type substitution;
#   (f) the access conventions must match EXACTLY (let/inout/sink/set —
#       a trait `inout x` against an impl `let x` is rejected, and the
#       inverse), except the builtin stub's synthetic receiver;
#   (g) the return type must unify after the same substitution;
#   (h) the method generic arity must be exact;
#   (i) the method generic bounds must satisfy the trait contract;
#   (j) the trait generic arguments must match the contract's trait-level
#       parameters — the FULL TraitRef, never a head-only approximation;
#   (k) the impl method must not require effects beyond the trait's
#       declared set (the std seeds by the trait's module-qualified
#       identity);
#   (l) the impl method must not add obligations the trait contract does
#       not declare (@budget annotations, required capabilities,
#       pre/post/invariant contracts);
#   (m) every contract associated type must be provided by the impl (and
#       an impl associated type the trait does not declare is rejected);
#   (n) a missing method is allowed ONLY when the contract method has a
#       default body.
# Coherence — E0214 — and the TraitId module identity ((o), (q)) are the
# existing machinery. The orphan rule ((p)) is the selected Tangerine
# rule: NO orphan restriction — impls of foreign traits for foreign types
# are permitted in any module (the std itself implements std-local
# traits for std types in arbitrary modules), so conformance is decided
# entirely by the declared-set validation above.

# Whether two declared effect sets are equal (id-based, order-insensitive).
def effect_ids_equal(a: Vec[EffectId], b: Vec[EffectId]) -> Bool
  if a.len() != b.len() then return false end
  var i = 0
  while i < a.len() do
    var found = false
    var j = 0
    while j < b.len() do
      if b[j].id == a[i].id then found = true end
      j = j + 1
    end
    if !found then return false end
    i = i + 1
  end
  true
end

# Substitute the CONTRACT side of one signature comparison: the trait-level
# generic parameters (positionally against the impl's declared trait
# arguments), the builtin contracts' implicit receiver parameters (the
# impl's self type) and the associated-type references (the impl's
# resolved associated types — the builtin contracts' `Item` parameter ids
# and the source contracts' auto-registered "Self::<Assoc>" opaque
# references).
def contract_ty_subst(env: TypeEnv, contract: TraitContract, trait_args: Vec[Type], self_type: Type, assoc_types: Vec[Type], ty: Type) -> Type
  match ty
  when Type::Param(gpid) then
    var i = 0
    while i < contract.generic_params.len() do
      if generic_param_id_eq(&contract.generic_params[i], &gpid) then
        return trait_args[i].clone()
      end
      i = i + 1
    end
    var si = 0
    while si < contract.self_param_ids.len() do
      if generic_param_id_eq(&contract.self_param_ids[si], &gpid) then
        return self_type.clone()
      end
      si = si + 1
    end
    var ai = 0
    while ai < contract.assoc_param_ids.len() do
      if generic_param_id_eq(&contract.assoc_param_ids[ai], &gpid) then
        if ai < assoc_types.len() then return assoc_types[ai].clone() end
      end
      ai = ai + 1
    end
    ty.clone()
  when Type::Adt(tid, args) then
    if args.len() == 0 then
      match get_type_by_id_ref(env, &tid)
      when Option::Some(td) then
        if td.name.starts_with("Self::") then
          let aname = td.name.slice(6, td.name.len())
          var ai = 0
          while ai < contract.assoc_types.len() do
            if contract.assoc_types[ai] == aname then
              if ai < assoc_types.len() then return assoc_types[ai].clone() end
            end
            ai = ai + 1
          end
        end
      when Option::None then ()
      end
    end
    var new_args = Vec::new()
    var i = 0
    while i < args.len() do
      new_args.push(contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &args[i]))
      i = i + 1
    end
    Type::Adt(tid, new_args)
  when Type::FixedArray(elem, n) then Type::FixedArray(contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &elem), n)
  when Type::FnPtr(params, ret, effects) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &pt.ty), convention: pt.convention })
      i = i + 1
    end
    Type::FnPtr(new_params, contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &ret), effects.clone())
  when Type::Closure(cid, params, ret, captures, effects) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &pt.ty), convention: pt.convention })
      i = i + 1
    end
    Type::Closure(cid.clone(), new_params, contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &ret), contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &captures), effects.clone())
  when Type::Tuple(fields) then
    var new_fields = Vec::new()
    var i = 0
    while i < fields.len() do
      new_fields.push(contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &fields[i]))
      i = i + 1
    end
    Type::Tuple(new_fields)
  when Type::RefInternal(inner, mutable) then Type::RefInternal(contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &inner), mutable)
  when Type::Ptr(inner) then Type::Ptr(contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &inner))
  when Type::PtrMut(inner) then Type::PtrMut(contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &inner))
  when Type::Effect(effects, inner) then Type::Effect(effects.clone(), contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &inner))
  when _ then ty.clone()
  end  end
end

# One transactional type comparison: the probe runs from a snapshot and
# restores it unconditionally — no substitution residue and no diagnostic
# residue survive a compare, whether it succeeds or fails.
def contract_unify_probe(inout env: TypeEnv, a: Type, b: Type) -> Bool
  let snap = subst_snapshot(env)
  let errs_before = env.errors.len()
  let ok = try_head_unify(env, a, b)
  subst_restore(env, &snap)
  errors_truncate(env, errs_before)
  ok
end

# (impl conformance): the per-method signature comparison — parameter
# count (d), parameter types (e), access conventions (f), return type (g),
# method generic arity (h), method generic bounds (i), effects (k) and
# declared obligations (l).
def check_impl_method_conformance(inout env: TypeEnv, contract: TraitContract, cm: TraitMethodContract, trait_name: String, self_type: Type, trait_args: Vec[Type], assoc_types: Vec[Type], im: MethodInfo, im_sig: FnSignature, m: FunctionDecl) -> Bool
  var valid = true

  # (h) method generic arity is exact.
  if im.generic_params.len() != cm.generic_param_names.len() then
    add_error_with_code(env, "generic parameter count mismatch: method `" + cm.name + "` of trait `" + trait_name + "` declares " + im.generic_params.len().to_string() + " generic parameter(s), the trait declares " + cm.generic_param_names.len().to_string(), m.span, "E0227")
    valid = false
  end

  # (i) the impl's method generic parameters must declare the contract's
  # bound trait names.
  var bpi = 0
  while bpi < cm.generic_param_bounds.len() do
    let cbounds = cm.generic_param_bounds[bpi]
    var impl_bounds = Vec::new()
    if bpi < m.generic_params.len() then
      for b in m.generic_params[bpi].bounds do
        impl_bounds.push(type_expr_name_of(&b))
      end
    end
    var bj = 0
    while bj < cbounds.len() do
      let cbname = cbounds[bj]
      var has_bound = false
      var kbi = 0
      while kbi < impl_bounds.len() do
        if impl_bounds[kbi] == cbname then has_bound = true end
        kbi = kbi + 1
      end
      if !has_bound then
        add_error_with_code(env, "generic bound mismatch: generic parameter " + bpi.to_string() + " of method `" + cm.name + "` of trait `" + trait_name + "` is missing bound `" + cbname + "`", m.span, "E0228")
        valid = false
      end
      bj = bj + 1
    end
    bpi = bpi + 1
  end

  # (d) parameter count is EXACT after the receiver-position
  # normalization: a source contract records its `self` parameter
  # (receiver_in_params); a builtin stub's receiver is synthetic (a
  # wildcard position the impl must still occupy).
  let impl_has_self = m.params.len() > 0 && m.params[0].name == "self"
  var contract_expected = cm.params.len()
  if cm.has_receiver && !cm.receiver_in_params then
    contract_expected = contract_expected + 1
  end
  if im.params.len() != contract_expected then
    add_error_with_code(env, "parameter count mismatch: method `" + cm.name + "` of trait `" + trait_name + "` declares " + im.params.len().to_string() + " parameter(s), the trait declares " + contract_expected.to_string(), m.span, "E0223")
    return false
  end
  if cm.has_receiver != impl_has_self then
    if cm.has_receiver then
      add_error_with_code(env, "parameter count mismatch: method `" + cm.name + "` of trait `" + trait_name + "` must take `self` as its first parameter", m.span, "E0223")
    else
      add_error_with_code(env, "parameter count mismatch: method `" + cm.name + "` of trait `" + trait_name + "` must not take a `self` parameter", m.span, "E0223")
    end
    return false
  end

  # (e) / (f) the non-receiver parameters: exact conventions, unifying
  # types. The builtin stub's synthetic receiver position is skipped.
  var impl_offset = 0
  if cm.has_receiver && !cm.receiver_in_params then
    impl_offset = 1
  end
  var pi = 0
  while pi < cm.params.len() do
    let cpt = cm.params[pi]
    let ipt = im.params[pi + impl_offset]
    if !(cpt.convention == ipt.convention) then
      add_error_with_code(env, "access convention mismatch: parameter " + pi.to_string() + " of method `" + cm.name + "` of trait `" + trait_name + "` has convention `" + convention_identity_tag(&ipt.convention) + "`, the trait declares `" + convention_identity_tag(&cpt.convention) + "`", m.span, "E0225")
      valid = false
    end
    let contract_ty = contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &cpt.ty)
    if !contract_unify_probe(env, ipt.ty.clone(), contract_ty) then
      add_error_with_code(env, "parameter type mismatch: parameter " + pi.to_string() + " of method `" + cm.name + "` of trait `" + trait_name + "` has type `" + type_tag(env, &ipt.ty) + "`, the trait declares `" + type_tag(env, &cpt.ty) + "`", m.span, "E0224")
      valid = false
    end
    pi = pi + 1
  end

  # (g) the return type unifies after the same substitution.
  let contract_ret = contract_ty_subst(env, contract, trait_args, self_type, assoc_types, &cm.ret_type)
  if !contract_unify_probe(env, im.ret_type.clone(), contract_ret) then
    add_error_with_code(env, "return type mismatch: method `" + cm.name + "` of trait `" + trait_name + "` returns `" + type_tag(env, &im.ret_type) + "`, the trait declares `" + type_tag(env, &cm.ret_type) + "`", m.span, "E0226")
    valid = false
  end

  # (k) the impl method must not require effects beyond the trait's set.
  if !effect_ids_equal(&im_sig.declared_effects, &cm.declared_effects) then
    add_error_with_code(env, "effect mismatch: method `" + cm.name + "` of trait `" + trait_name + "` requires effects beyond the trait contract", m.span, "E0230")
    valid = false
  end

  # (l) the impl method must not add obligations the trait contract does
  # not declare.
  match im_sig.declared_budget
  when Option::Some(_) then
    add_error_with_code(env, "budget annotation beyond the trait contract: method `" + cm.name + "` of trait `" + trait_name + "`", m.span, "E0230")
    valid = false
  when Option::None then ()
  end
  if m.required_caps.len() > 0 then
    add_error_with_code(env, "required capabilities beyond the trait contract: method `" + cm.name + "` of trait `" + trait_name + "`", m.span, "E0230")
    valid = false
  end
  if m.contracts.len() > 0 then
    add_error_with_code(env, "contract clauses beyond the trait contract: method `" + cm.name + "` of trait `" + trait_name + "`", m.span, "E0230")
    valid = false
  end

  valid
end

# (impl conformance): validate one trait impl's method set and signatures
# against the trait's CONTRACT — (a)/(b)/(c)/(j)/(m)/(n) at the impl
# level, (d)-(l) per matched method. Returns false when any check fails
# (every failure records its specific diagnostic). MUST run before the
# ImplInfo enters env.impls.
def validate_impl_conformance(inout env: TypeEnv, contract: TraitContract, trait_name: String, self_type: Type, trait_args: Vec[Type], impl_methods: Vec[MethodInfo], impl_sig_records: Vec[FnSignature], imp: ImplDecl) -> Bool
  var valid = true

  # (j) the FULL TraitRef: the trait-level generic arity is exact.
  if contract.generic_params.len() != trait_args.len() then
    add_error_with_code(env, "trait argument count mismatch: trait `" + trait_name + "` takes " + contract.generic_params.len().to_string() + " type argument(s), this impl provides " + trait_args.len().to_string(), imp.span, "E0229")
    return false
  end

  # (m) associated types: every contract assoc type must be provided; an
  # impl assoc type the trait does not declare is an unknown member.
  var impl_assoc_types = Vec::new()
  for at in imp.assoc_types do
    impl_assoc_types.push((at.name.clone(), resolve_type_expr(env, &at.ty)))
  end
  var contract_assoc_resolved = Vec::new()
  var ai = 0
  while ai < contract.assoc_types.len() do
    let aname = contract.assoc_types[ai]
    var found_ty = Option::None
    var fi = 0
    while fi < impl_assoc_types.len() do
      if impl_assoc_types[fi].0 == aname then
        found_ty = Option::Some(impl_assoc_types[fi].1)
      end
      fi = fi + 1
    end
    match found_ty
    when Option::Some(ty) then contract_assoc_resolved.push(ty)
    when Option::None then
      add_error_with_code(env, "missing associated type `" + aname + "` in impl of trait `" + trait_name + "`", imp.span, "E0231")
      valid = false
    end
    ai = ai + 1
  end
  for at in impl_assoc_types do
    var known = false
    var ci = 0
    while ci < contract.assoc_types.len() do
      if contract.assoc_types[ci] == at.0 then known = true end
      ci = ci + 1
    end
    if !known then
      add_error_with_code(env, "associated type `" + at.0 + "` is not a member of trait `" + trait_name + "`", imp.span, "E0222")
      valid = false
    end
  end

  # (b) duplicate impl methods are rejected.
  var mi = 0
  while mi < impl_methods.len() do
    var prev = 0
    while prev < mi do
      if impl_methods[prev].name == impl_methods[mi].name then
        add_error_with_code(env, "duplicate method `" + impl_methods[mi].name + "` in impl of trait `" + trait_name + "`", imp.span, "E0221")
        valid = false
      end
      prev = prev + 1
    end
    mi = mi + 1
  end

  # (a) / (n) every non-default contract method must be present; a missing
  # defaulted method is allowed. (c) an impl member that is not a contract
  # method is an unknown member (inherent-extension methods are permitted
  # ONLY in inherent impls).
  var ci = 0
  while ci < contract.methods.len() do
    let cm = contract.methods[ci]
    var impl_idx = -1
    var ii = 0
    while ii < impl_methods.len() do
      if impl_methods[ii].name == cm.name then impl_idx = ii end
      ii = ii + 1
    end
    if impl_idx == -1 then
      if !cm.has_default then
        add_error_with_code(env, "missing required method `" + cm.name + "` of trait `" + trait_name + "`", imp.span, "E0220")
        valid = false
      end
    else
      if impl_idx < impl_sig_records.len() && impl_idx < imp.methods.len() then
        if !check_impl_method_conformance(env, contract, &cm, trait_name, self_type, trait_args, contract_assoc_resolved, impl_methods[impl_idx], impl_sig_records[impl_idx], imp.methods[impl_idx]) then
          valid = false
        end
      end
    end
    ci = ci + 1
  end
  var ii2 = 0
  while ii2 < impl_methods.len() do
    let im = impl_methods[ii2]
    var known = false
    var ci2 = 0
    while ci2 < contract.methods.len() do
      if contract.methods[ci2].name == im.name then known = true end
      ci2 = ci2 + 1
    end
    if !known then
      add_error_with_code(env, "method `" + im.name + "` is not a member of trait `" + trait_name + "`", imp.span, "E0222")
      valid = false
    end
    ii2 = ii2 + 1
  end

  valid
end

def check_impl(inout env: TypeEnv, i: ImplDecl, method_keys: Vec[String]) -> Unit
  # Register impl-level generic type parameters FIRST so they are in scope
  # when resolving i.for_type (e.g., Vec[T] needs T in scope).
 # the impl interns its generic parameters in declaration order
  # under a fresh synthetic owner DefId (impls have no resolver DefId) —
  # the GenericParamId order IS the declaration order. The impl index
  # (env.impls.len() at entry) is captured ONCE: the fallback method
  # owners (impl_method_owner_def) derive from it, and both the signature
  # pass and the body pass of this function must agree on it.
  push_scope(env)
  let impl_idx = env.impls.len()
  let imp_owner = fresh_synthetic_owner(&mut env.generic_param_table)
  let impl_param_ids = intern_generic_params(env, &imp_owner, &i.generic_params)
  var gp_idx = 0
  while gp_idx < i.generic_params.len() do
    bind_var(env, i.generic_params[gp_idx].name.clone(), Type::Param(impl_param_ids[gp_idx].clone()))
    gp_idx = gp_idx + 1
  end

 # record the impl's generic-parameter trait bounds (inline bounds +
  # where-clause) so bare Param receivers in the method bodies resolve
  # through them (`self.inner.advance()` with inner: I in
  # `impl[T, U, I: Iterator[T]] Iterator[U] for MapIter[T, U, I]`).
  record_param_bounds(env, &i.generic_params, &impl_param_ids)
  record_where_predicate_bounds(env, &i.where_clause)

  let self_type = resolve_type_expr(env, &i.for_type)

  # Determine trait name (empty string for inherent impls)
  let trait_name = match i.trait_name
  when Option::Some(tn) then tn.clone()
  when Option::None then ""
  end
 # the impl's trait identity is its TraitId
  # (TraitId(-1) for inherent impls — no registered trait under the name).
  let trait_id = trait_id_for(env, &trait_name)

 # (authoritative impl trait arguments): the impl's DECLARED trait
  # reference — the trait's identity and its type arguments DIRECTLY from
  # the AST's impl declaration — is captured ONCE here into
  # ImplInfo.trait_ref and never re-derived at solve time. The identity is
  # the declaration-derived TraitId (trait_id_for). The arguments are the
  # trait's type arguments in the impl's generic scope, resolved to their
  # Type::Param forms in DECLARATION ORDER — the parser's own derivation
  # (the impl's generic parameters come from the trait's type arguments in
  # the `impl Iterator[T] for Type` form; the leading-generics form
  # declares the same parameters explicitly). The solver instantiates these
  # exact arguments with the candidate's fresh variables and unifies them
  # against the obligation's args — the impl trait arguments are the
  # authority, never an approximation from the generic-parameter count.
  var imp_trait_args = Vec::new()
  if trait_id.id != -1 then
 # the AST's trait type arguments are the authority — resolve them
    # in the impl's generic scope (the exact declared reference, e.g. the
    # (K, V) tuple of `impl[K, V] Iterator[(K, V)] for MapIterator[K, V]`).
    # The empty-vector fallback is the declaration-order derivation (an
    # inherent impl, or a declaration whose arguments were not parsed).
    if i.trait_type_args.len() > 0 then
      var ta_expr = 0
      while ta_expr < i.trait_type_args.len() do
        imp_trait_args.push(resolve_type_expr(env, &i.trait_type_args[ta_expr]))
        ta_expr = ta_expr + 1
      end
    else
      var ta_idx = 0
      while ta_idx < impl_param_ids.len() do
        imp_trait_args.push(Type::Param(impl_param_ids[ta_idx].clone()))
        ta_idx = ta_idx + 1
      end
    end
  end

  # FIRST PASS: Resolve all method signatures and register in env.impls
  # This is done before checking bodies so methods can call each other
  var impl_methods = Vec::new()
 # the typed signature records collected per method in this pass,
  # recorded into env.typed_fn_signatures in the second pass under each
  # method's owner key.
  var impl_sig_records = Vec::new()
  var method_index = 0
  while method_index < i.methods.len() do
    let m = i.methods[method_index]
    push_scope(env)

    # Register method-level generic type parameters in scope
    # (impl-level params are already visible from the outer scope).
 # each method interns its generic parameters in declaration
    # order under its own owner (impl_method_owner_def — the resolver's
    # registered method DefId or the deterministic module -3 fallback); the
    # body pass reconstructs the same ids from (owner, index).
    let m_owner = impl_method_owner_def(env, &i.for_type, &m, impl_idx, method_index)
    let method_param_ids = intern_generic_params(env, &m_owner, &m.generic_params)
    var mgp_idx = 0
    while mgp_idx < m.generic_params.len() do
      bind_var(env, m.generic_params[mgp_idx].name.clone(), Type::Param(method_param_ids[mgp_idx].clone()))
      mgp_idx = mgp_idx + 1
    end

    # Resolve parameter types
    var param_types = Vec::new()
    var param_index = 0
    while param_index < m.params.len() do
      let p = m.params[param_index]
      let ty = if p.name == "self" then
        self_type
      else
        match p.ty
        when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
        when Option::None then fresh_type_var(env)
        end
      end
      param_types.push(ParamType { ty: ty, convention: p.convention })
      param_index = param_index + 1
    end

    # Resolve return type
    let ret_type = match m.ret_type
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then Type::Unit
    end

    pop_scope(env)

 # capture the method's typed signature (declaration order — the
    # receiver `self` is the first parameter exactly as declared); recorded
    # into env.typed_fn_signatures in the second pass under the method's
    # owner key (the MIR reads declaration types from that record). The
    # record carries the method's DECLARED EFFECT SET (the parsed
    # `effect[...]` names interned through the registry, or the std
    # effectful-function seeds — registered HERE in the signature pass, so
    # every method body (this impl's and later impls') resolves the
    # declared set at its call sites) and the DECLARED BUDGET (the
    # @budget annotation's typed record).
    let m_declared_effects = declared_effects_of(env, &m.effects, module_qualified_effect_name(&env.current_module_path, &m.name))
    let m_decl_key = fn_effect_def_key(env, &m_owner)
    env.fn_declared_effects.insert(m_decl_key.clone(), m_declared_effects.clone())
    env.fn_declared_effect_names.insert(m_decl_key.clone(), m.name.clone())
    env.fn_declared_effect_spans.insert(m_decl_key.clone(), m.span)
    env.fn_effect_modules.insert(m_decl_key.clone(), env.current_module_path.clone())
    impl_sig_records.push(FnSignature { params: param_types.clone(), ret_type: ret_type.clone(), declared_effects: m_declared_effects, declared_budget: typed_budget_of(&m.budget_val) })

    # Collect method-level generic parameter ids for later substitution
 # (the ids in declaration order — the param-name table holds
    # the display names).
    var method_gp_ids = Vec::new()
    var m_gp_idx = 0
    while m_gp_idx < m.generic_params.len() do
      method_gp_ids.push(method_param_ids[m_gp_idx].clone())
      m_gp_idx = m_gp_idx + 1
    end

    # Register method info for env.impls
    impl_methods.push(MethodInfo {
      name: m.name.clone(),
      ret_type: ret_type.clone(),
      params: param_types.clone(),
      has_self: m.params.len() > 0 && m.params[0].name == "self",
      generic_params: method_gp_ids
    })

    method_index = method_index + 1
  end

  # Normalize the impl's generic bounds into obligations ONCE, from the AST
  # ImplDecl. Each obligation records its SUBSTITUTED SUBJECT — the
  # Type::Param of the impl generic parameter it bounds (the GenericParamId
  # binding is where the obligation originates; there is no positional
  # param_index) — plus the bound trait's RESOLVED type arguments
  # (Type::Param forms of the impl's generic scope, resolved through
  # resolve_param_bound_arg — e.g. the T of `I: Iterator[T]` in `impl[T, U,
  # I: Iterator[T]]...`). The solver instantiates the subject and the args
  # with the candidate's substitution and solves the resulting concrete
  # obligation; it never jumps back to the AST.
  var impl_obligations = Vec::new()
  var ob_idx = 0
  while ob_idx < i.generic_params.len() do
    let ob_gp = i.generic_params[ob_idx]
    for ob_bound in ob_gp.bounds do
      let ob_name = type_expr_name_of(&ob_bound)
      var ob_args = Vec::new()
      match ob_bound.kind
      when TypeExprKind::Named(_, tys) then
        var ob_ai = 0
        while ob_ai < tys.len() do
          ob_args.push(resolve_param_bound_arg(env, &tys[ob_ai]))
          ob_ai = ob_ai + 1
        end
      when _ then ()
      end
      impl_obligations.push(GenericObligation {
        subject: Type::Param(impl_param_ids[ob_idx].clone()),
        trait_id: trait_id_for(env, &ob_name),
        trait_name: ob_name,
        args: ob_args
      })
    end
    ob_idx = ob_idx + 1
  end

 # the impl's FULL generic-parameter ids in declaration order —
  # the extension-impl solver instantiates every one of them (including
  # parameters absent from the for_type, like the T of `impl[T, I:
 # Iterator[T]] I`). ids, not names (the param-name table holds
  # the display names).
  var imp_gp_ids = Vec::new()
  var igp = 0
  while igp < i.generic_params.len() do
    imp_gp_ids.push(impl_param_ids[igp].clone())
    igp = igp + 1
  end

  # the per-impl method DefId table is are not part of the model (the
  # bare-keyed method table). A call site resolves a method's DefId through
  # the SEMANTIC registration — module_symbols' qualified
  # "path::Type::method" entries (method_def_for / qualified_method_def /
  # scan_qualified_method_def — the module-qualified machinery below), with
  # the extension-impl key reconstructed from the impl's for_type.

  # E0214 coherence: reject a duplicate impl of the same trait for the same
  # self type. Two candidates silently break every obligation (the solver
  # treats 2+ candidates as ambiguous and returns false) and method dispatch
  # silently picks the first candidate. Structural comparison via unify on
  # the resolved for_type (Params compare by name — copy-paste duplicates,
  # the common case, are caught).
 # the trait ARGUMENTS must agree too — `impl From[A] for T` and
  # `impl From[B] for T` are NOT conflicting implementations (the impl's
  # trait arguments are its generic arguments; the parser derives the
  # impl's generic parameters from the trait's type arguments, so their
  # only surviving identity is the parameter NAME, compared pairwise in
  # declaration order through the parameter-name table).
 # the probe is TRANSACTIONAL — it runs the ordinary global
  # unifier, and a probe must leave no substitution residue and no
  # diagnostics whether it matches or not.
  if trait_id.id != -1 then
    var ci = 0
    while ci < env.impls.len() do
      let existing = env.impls[ci]
      if existing.trait_id.id == trait_id.id then
        let snap = subst_snapshot(env)
        let errs_before = env.errors.len()
        let head_dup = unify(env, existing.for_type.clone(), self_type.clone(), i.span)
        var args_agree = existing.generic_params.len() == imp_gp_ids.len()
        var tgci = 0
        while args_agree && tgci < existing.generic_params.len() do
          let ename = generic_param_name_of(&env.generic_param_table, &existing.generic_params[tgci])
          let iname = generic_param_name_of(&env.generic_param_table, &imp_gp_ids[tgci])
          if ename != iname then args_agree = false end
          tgci = tgci + 1
        end
        subst_restore(env, &snap)
        errors_truncate(env, errs_before)
        if head_dup && args_agree then
          add_error_with_code(env, "conflicting implementations of trait `" + trait_name + "` for the same type", i.span, "E0214")
          break
        end
      end
      ci = ci + 1
    end
  end

  # (validate-first-register-second — impl conformance): BEFORE the impl
  # enters env.impls (the solver's candidate set), validate the impl's
  # method set and signatures against the trait's declared CONTRACT
  # (TraitContract — recorded at the trait registration sites under the
  # same TraitId; inherent impls have no contract and are always valid).
  # An invalid impl is rejected here and NEVER becomes a candidate, even
  # transiently; its method bodies are not checked (the unregistered
  # impl's methods cannot resolve).
  var impl_valid = true
  if trait_id.id != -1 then
    match env.trait_contracts.get(trait_id.id)
    when Option::Some(tcontract) then
      impl_valid = validate_impl_conformance(env, &tcontract, &trait_name, &self_type, &imp_trait_args, &impl_methods, &impl_sig_records, i)
    when Option::None then ()
    end
  end
  if !impl_valid then
    pop_scope(env)
    return
  end

  # Register the impl in env.impls so resolve_method_type can find methods
  env.impls.push(ImplInfo {
    trait_id: trait_id,
    trait_name: trait_name,
    for_type: self_type.clone(),
    obligations: impl_obligations,
    methods: impl_methods,
    generic_params: imp_gp_ids,
    trait_ref: TraitRefTemplate {
      trait_id: trait_id,
      args: imp_trait_args
    }
  })

  # Index impl methods for O(1) resolution: receiver TypeId -> method name -> impl indices.
  # Candidates are inserted in source order so first-hit selection stays deterministic.
  let registered_idx = env.impls.len() - 1
  match self_type
  when Type::Adt(rtid, _) then
    var rm = 0
    while rm < env.impls[registered_idx].methods.len() do
      let mname = env.impls[registered_idx].methods[rm].name.clone()
      var mmap = match env.method_lookup.get(rtid.id)
      when Option::Some(mm) then mm.clone()
      when Option::None then Map::new()
      end
      var cands = match mmap.get(mname)
      when Option::Some(cv) then cv.clone()
      when Option::None then Vec::new()
      end
      cands.push(registered_idx)
      mmap.insert(mname, cands)
      env.method_lookup.insert(rtid.id, mmap)
      rm = rm + 1
    end
  when _ then ()
  end

 # an impl whose for_type is a generic PARAMETER (`impl[T, I:
  # Iterator[T]] I`) has no receiver TypeId and cannot be indexed into
  # method_lookup; it is registered here and searched by method name at
  # resolution time, when the receiver's concrete type unifies the head
  # parameter (I) and the impl's other parameters (T) are solved from the
  # method signature.
  match self_type
  when Type::Param(_) then
    env.param_for_type_impls.push(registered_idx)
  when _ then ()
  end

  # SECOND PASS: Check method bodies (with signatures already visible)
  method_index = 0
  while method_index < i.methods.len() do
    let m = i.methods[method_index]
    # The owner key for this method's parameter bindings: its DefId rendered
    # via fn_owner_key (from the resolver's item_defs), or a per-item
    # positional fallback for methods without DefIds. Never a span offset.
    let m_owner_key = if method_index < method_keys.len() then method_keys[method_index].clone() else
      "item::fallback::" + method_index.to_string()
    end
    push_scope(env)

 # Register method-level generic type parameters in scope. the
    # ids were interned in the signature pass under the same owner
    # (impl_method_owner_def — the same impl_idx captured at entry); this
    # pass reconstructs them from (owner, declaration index).
    let m_owner = impl_method_owner_def(env, &i.for_type, &m, impl_idx, method_index)
    var mgp_idx = 0
    while mgp_idx < m.generic_params.len() do
      bind_var(env, m.generic_params[mgp_idx].name.clone(), Type::Param(generic_param_id_at(&m_owner, mgp_idx)))
      mgp_idx = mgp_idx + 1
    end

    # Bind parameters — use self_type for any param named "self"
    # Recorded per-owner in declaration order in the dedicated parameter map
    # (see the TypeEnv field comment about key-domain separation).
    var method_param_ids = Vec::new()
    var param_index = 0
    while param_index < m.params.len() do
      let p = m.params[param_index]
      let ty = if p.name == "self" then
        self_type
      else
        match p.ty
        when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
        when Option::None then fresh_type_var(env)
        end
      end
      bind_var(env, p.name, ty)
      method_param_ids.push(env.local_id_counter - 1)
      param_index = param_index + 1
    end
    env.param_binding_resolutions.insert(m_owner_key, method_param_ids)
 # record the method's generic parameter ids in the MIR's
    # MERGED declaration order (impl-level params first, then the method's
    # own) under the SAME owner key — the MIR builder pairs this record
    # positionally with the renamed declaration's merged generic list
    # (the substs-order contract).
    var merged_ids = impl_param_ids.clone()
    mgp_idx = 0
    while mgp_idx < m.generic_params.len() do
      merged_ids.push(generic_param_id_at(&m_owner, mgp_idx))
      mgp_idx = mgp_idx + 1
    end
    env.generic_param_ids.insert(m_owner_key, merged_ids)
 # record the method's typed signature under the SAME owner key (the
    # MIR reads the method's parameter/return types from this record — the
    # typed table is the authority; TypeExpr is never interpreted after
    # checking). The record is the first pass's computed signature (same
    # owner-key agreement as generic_param_ids above).
    if method_index < impl_sig_records.len() then
      env.typed_fn_signatures.insert(m_owner_key, impl_sig_records[method_index].clone())
    else
      type_add_error(env, "internal error: impl signature records diverged from the method list (method `" + m.name + "`)", i.span)
    end

    # Expected return type
    let ret_type = match m.ret_type
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then Type::Unit
    end
 # (channel a): a RAW Slice view (UnsafeSlice) must not be RETURNED from
    # a method — the declared return type is rejected when it is (or
    # contains) the raw view (the shared/pinned source-spelled Slice — the
    # std-declared shared struct — is
    # an ordinary owning value and passes freely).
    check_no_escaping_slice(env, &ret_type, m.span, "returned from a function")

 # every `return expr` in the body unifies immediately with the
    # declared return type (see check_function).
    env.expected_return = Option::Some(ret_type.clone())
    # Check body (the body's call sites record into this method's computed
    # effect set — the SAME def-key the signature pass registered the
    # declared set under).
    env.current_fn_key = fn_effect_def_key(env, &m_owner)
    # Check body
    match m.body
    when FnBody::FnBlock(block) then
      env.check_ctx = "method:" + m.name
      let body_flow = check_block(env, &block, true)
      if is_unit_type(&ret_type) then
        ()
      else
        unify(env, body_flow.normal, ret_type, m.span)
      end
    when FnBody::FnExpr(expr) then
      let expr_type = check_expr(env, &expr)
      unify(env, expr_type, ret_type, expr.span)
      # (partial moves): the method tail is the implicit return (see
      # check_function's FnExpr arm).
      record_projected_consume(env, &expr)
    when _ then ()
    end
    env.current_fn_key = ""
    env.expected_return = Option::None

    pop_scope(env)
    method_index = method_index + 1
  end

  pop_scope(env)
end

# ———————————————————————————————————————————————————————————————
# Block and Statement Type Checking
# ———————————————————————————————————————————————————————————————

def check_block(inout env: TypeEnv, block: Block, is_value: Bool) -> FlowResult
  push_scope(env)
  
 # the block's flow summary. `normal` is the value the block produces
  # when it falls through; the flags say which divergence edges the block may
  # take. A statement block (is_value=false) discards its value — normal is
  # Unit when it may fall through (Never when it provably cannot).
  var normal = Type::Unit
  var may_return = false
  var may_break = false
  var may_continue = false
  var may_throw = false
 # (d): once a terminator (a statement that never falls through
  # normally — return/break/continue/panic/divergent if-match-loop) has been
  # seen, the remainder of the block is still checked for diagnostics but
  # contributes NOTHING to the block's value or flow.
  var unreachable = false
  var i = 0
  while i < block.stmts.len() do
    let stmt = block.stmts[i]
    let flow = check_stmt(env, &stmt)
    if !unreachable then
      normal = flow.normal
      if flow.may_return then may_return = true end
      if flow.may_break then may_break = true end
      if flow.may_continue then may_continue = true end
      if flow.may_throw then may_throw = true end
      if is_never_type(&flow.normal) then unreachable = true end
    end
    i = i + 1
  end
  
  pop_scope(env)
  # A statement block (if-then, while body,...) discards its value; only a
  # value block (function body, match arm, expression block) yields the last
  # contributing statement's type. Otherwise `if c then advance(p) end`
  # (advance returning Token) would leak Token into a Unit function body.
  let falls_through = !is_never_type(&normal)
  let block_normal = if is_value then normal elsif falls_through then Type::Unit else Type::Never end
  FlowResult {
    normal: block_normal,
    may_return: may_return,
    may_break: may_break,
    may_continue: may_continue,
    may_throw: may_throw
  }
end

def check_stmt(inout env: TypeEnv, stmt: Stmt) -> FlowResult
  let result = match stmt.kind
  when StmtKind::StmtLet(pattern, ty_opt, value, is_mut) then
    let value_type = check_expr(env, &value)
    let var_type = match ty_opt
    when Option::Some(ty_expr) then
      let declared = resolve_type_expr(env, &ty_expr)
      unify(env, value_type, declared, stmt.span)
      declared
    when Option::None then
      value_type
    end
 # the pattern's binding plan (per-binding Read/Move actions) is
    # collected here; the block/match/for checking paths consume the plans.
    # The pattern's variant identity is resolved ONCE by
    # resolve_pattern_variants (the checker's pattern-resolution junction —
    # the caller knows the expected type's enum identity, so the junction
    # records the (owner TypeId, variant index) resolution and check_pattern
    # reads the record instead of re-resolving from source spelling). The
    # source place of the let's bindings is the initializer's typed place.
    resolve_pattern_variants(env, &pattern, var_type)
    check_pattern(env, &pattern, var_type, binding_source_place(env, &value, "let initializer"))
    consume_binding_plans(env, &pattern)
 # (partial moves): record the per-field move states of the projected
    # source places (the Consume bindings over non-plain sources) — the
    # frame's per-field state for the drop sites.
    record_place_moves(env, &pattern)
    flow_normal(Type::Unit)
  when StmtKind::StmtAssign(target, value) then
    let target_type = check_expr(env, &target)
    let value_type = check_expr(env, &value)
    unify(env, target_type, value_type, stmt.span)
    # (partial moves): the assignment's projected records — the store into
    # a projected target re-lives the target chain (clear it; the owning
    # fully-live depth-1 case marks the sibling fields Consumed — the
    # whole-root assign-drop destroys them), and a projected OWNING value
    # is moved out (the checker's transfer_consume mirror).
    record_projected_assign(env, &target)
    record_projected_consume(env, &value)
    flow_normal(Type::Unit)
  when StmtKind::StmtIf(if_stmt) then
    check_if_stmt(env, &if_stmt, true)
  when StmtKind::StmtWhile(cond, body) then
    let cond_type = check_expr(env, &cond)
    unify(env, cond_type, Type::Bool, cond.span)
    let body_flow = check_block(env, &body, false)
 # (c): a normal while may execute zero times, so its type is Unit,
    # not Never. Only a while whose body has NO reachable break/return path
    # can never terminate — only that loop may be Never.
    let loop_type = if body_flow.may_break || body_flow.may_return then Type::Unit else Type::Never end
    FlowResult {
      normal: loop_type,
      # A return inside the loop body exits the enclosing function; breaks
      # and continues are consumed by the loop itself.
      may_return: body_flow.may_return,
      may_break: false,
      may_continue: false,
      may_throw: body_flow.may_throw
    }
  when StmtKind::StmtFor(for_stmt) then
    push_scope(env)
    let iter_type = check_expr(env, &for_stmt.iter)
    # The element type comes from the collection being iterated, so `for f in
    # program.functions` binds f to MirFunction (not a fresh var that poisons
    # every use of f with inference variables).
    # The range form is classified by the ITER SHAPE first: a range's type
    # is Int (the ExprRange arm of check_expr), and the iteration element of
    # `for i in lo..hi` is Int — a bare Int-typed ITERABLE stays rejected
    # below (iterating an integer is not a range).
    # Iterating a collection the checker cannot handle is an ERROR, not a
    # fresh inference variable: no equation remains to solve it, and the
 # loop variable would silently poison every use in the body.
    # Unconstrained Var/Param receivers are kept fresh — their element type
    # is a genuine pending equation resolved when the receiver's type lands.
    let elem_type = match for_stmt.iter.kind
    when ExprKind::ExprRange(_, _, _) then Type::Int
    when _ then
      match iter_type
      when Type::String then Type::Char
      when Type::Adt(tid, args) then
        # Vec is an Adt type (Vec[T]); its element is the first type arg.
        # Map is an Adt type (Map[K, V]); iterating it yields (K, V) pairs.
        # Slice/Array Adt forms are slice-like too (LangItems ids).
        if tid.id == env.lang_items.vec && args.len() >= 1 then args[0].clone()
        elsif tid.id == env.lang_items.map && args.len() >= 2 then Type::Tuple([args[0].clone(), args[1].clone()])
        elsif (tid.id == env.lang_items.slice || tid.id == env.lang_items.array) && args.len() >= 1 then args[0].clone()
        else
          match get_type_by_id_ref(env, tid)
          when Option::Some(td) then
            type_add_error(env, "cannot iterate `" + td.name + "`: for loops require Array, Vec, String, Map, Set or the raw-view iterable forms (UnsafeSlice)", for_stmt.span)
          when Option::None then
            type_add_error(env, "cannot iterate unresolved container type", for_stmt.span)
          end
          Type::Error
        end
      when Type::Var(_) then fresh_type_var(env)
      when Type::Param(_) then fresh_type_var(env)
      when _ then
        type_add_error(env, "cannot iterate value of type `" + type_tag(env, &iter_type) + "`", for_stmt.span)
        Type::Error
      end
    end
 # the iteration pattern's binding plan is collected and consumed
    # here (the for-loop's element source). The variant identity is
    # resolved by the junction before check_pattern reads the record.
    resolve_pattern_variants(env, &for_stmt.pattern, elem_type)
    check_pattern(env, &for_stmt.pattern, elem_type, binding_source_place(env, &for_stmt.iter, "for iterator element"))
    consume_binding_plans(env, &for_stmt.pattern)
    let body_flow = check_block(env, &for_stmt.body, false)
    pop_scope(env)
    FlowResult {
      normal: Type::Unit,
      may_return: body_flow.may_return,
      may_break: false,
      may_continue: false,
      may_throw: body_flow.may_throw
    }
  when StmtKind::StmtReturn(val_opt) then
    let val_type = match val_opt
    when Option::Some(val) then check_expr(env, &val)
    when Option::None then Type::Unit
    end
    # (partial moves): a projected OWNING return value is moved out of its
    # root (the checker's transfer_consume mirror).
    match val_opt
    when Option::Some(val) then record_projected_consume(env, &val)
    when Option::None then ()
    end
    # (b): every `return expr` unifies immediately with the declared
    # return type — unconditional, never dependent on the last statement.
    match env.expected_return
    when Option::Some(rt) then
      unify(env, val_type, rt, stmt.span)
    when Option::None then ()
    end
    flow_terminator(true, false, false, false)
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr(env, &val)
    when Option::None then Type::Unit
    end
    # (partial moves): a projected OWNING break value is moved out of its
    # root (the checker's transfer_consume mirror).
    match val_opt
    when Option::Some(val) then record_projected_consume(env, &val)
    when Option::None then ()
    end
    flow_terminator(false, true, false, false)
  when StmtKind::StmtContinue then
    flow_terminator(false, false, true, false)
  when StmtKind::StmtExpr(expr) then
    flow_normal(check_expr(env, &expr))
  when StmtKind::StmtMatch(m) then
    check_match(env, &m, true)
  when StmtKind::StmtUnsafe(_, body) then
    check_block(env, &body, true)
  when StmtKind::StmtDefer(body) then
    check_block(env, &body, false)
    flow_normal(Type::Unit)
  when StmtKind::StmtTry(_, _, _) then
 # exceptions are not supported — no exception runtime exists in
    # the backend and the resource CFG has no Throw/Unwind/Handler edges.
    # A throwing path (try body -> catch handler / finally teardown) could
    # bypass Drop/defer/access teardown, so the form is REJECTED here, at
    # the type checker, before the resource checker or MIR ever see it.
    # The parser still accepts it (the AST keeps the form); compilation
    # stops on this diagnostic (type errors gate every later phase).
    type_add_error(env, "exceptions are not supported — no throwing path may bypass teardown: try/catch/finally is rejected", stmt.span)
    flow_normal(Type::Error)
  when StmtKind::StmtLoop(body) then
    let body_flow = check_block(env, &body, false)
 # (c): a `loop` with a reachable break/return path may terminate —
    # its type is Unit; only a loop without such a path never falls through
    # and may be Never.
    let loop_type = if body_flow.may_break || body_flow.may_return then Type::Unit else Type::Never end
    FlowResult {
      normal: loop_type,
      may_return: body_flow.may_return,
      may_break: false,
      may_continue: false,
      may_throw: body_flow.may_throw
    }
  when StmtKind::StmtGuard(cond, else_action) then
    let cond_type = check_expr(env, &cond)
    unify(env, cond_type, Type::Bool, cond.span)
    var g_may_return = false
    var g_may_break = false
    var g_may_continue = false
    match else_action
    when GuardElse::Return(ret_opt) then
      g_may_return = true
      match ret_opt
      when Option::Some(ret_expr) then
        let ret_ty = check_expr(env, &ret_expr)
        # (partial moves): the guard-else return's projected OWNING value
        # is moved out on the else path (the checker's transfer_consume
        # mirror; the checker's divergence net rejects the fallthrough
        # when the lattice cannot mask the record).
        record_projected_consume(env, &ret_expr)
        match env.expected_return
        when Option::Some(er) then unify(env, ret_ty, er, stmt.span)
        when Option::None then ()
        end
      when Option::None then
        # A bare `guard... else return` returns Unit — check it against the
        # declared return type like a bare `return`.
        match env.expected_return
        when Option::Some(er) then unify(env, Type::Unit, er, stmt.span)
        when Option::None then ()
        end
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(br_opt) then
      g_may_break = true
      match br_opt
      when Option::Some(br_expr) then
        check_expr(env, &br_expr)
        # (partial moves): the guard-else break value (see the return arm).
        record_projected_consume(env, &br_expr)
      when Option::None then ()
      end
    when GuardElse::Continue then g_may_continue = true
    end
    FlowResult {
      normal: Type::Unit,
      may_return: g_may_return,
      may_break: g_may_break,
      may_continue: g_may_continue,
      may_throw: false
    }
  when StmtKind::StmtHandleWith(expr, handlers) then
    # The effect-handler block (the algebraic-effects row): `handle EXPR
    # with EFF { op(params) => body ... }` — the handler's effect resolves
    # to its semantic EffectId and the arms are typed against the declared
    # op signatures (an unknown effect or op is an error; the arm's params
    # bind the op's parameter types and the arm body's value unifies with
    # the op's return type). The handled expression is checked normally.
    # The bounded row's control-flow rule: return/break/continue/defer are
    # rejected inside arm bodies — the arms run in the handler's dispatcher
    # function, not the enclosing frame (a return/break/continue would
    # need the enclosing CFG edges; a defer would register against the
    # enclosing scope's teardown plan that never runs on the dispatcher
    # path).
    var typed_handlers = Vec::new()
    var handler_cap_records = Vec::new()
    var h_idx = 0
    var handlers_ok = true
    while h_idx < handlers.len() do
      let handler = handlers[h_idx]
      match typed_effect_of_name(env, &handler.effect_name)
      when Option::Some(td) then
        var typed_arms = Vec::new()
        var arm_caps: Vec[Map[Int, AccessEffect]] = Vec::new()
        var a_idx = 0
        var arms_ok = true
        while a_idx < handler.arms.len() do
          let arm = handler.arms[a_idx]
          let op_index = typed_effect_op_index(&td, &arm.operation)
          if op_index < 0 then
            type_add_error(env, "effect `" + handler.effect_name + "` has no operation `" + arm.operation + "`", arm.span)
            arms_ok = false
          else
            let op_sig = td.ops[op_index]
            push_scope(env)
            # The arm's parameter patterns bind the op's parameter types
            # (the binding source is the op's payload — unknown at the
            # handler definition, RawUnknown, exactly like a closure
            # parameter).
            var pi = 0
            while pi < arm.params.len() && pi < op_sig.params.len() do
              let p_ty = op_sig.params[pi].clone()
              resolve_pattern_variants(env, &arm.params[pi], p_ty.clone())
              check_pattern(env, &arm.params[pi], p_ty, TypedPlace { root: AccessRoot::RawUnknown, root_name: "effect operation parameter", projections: Vec::new() })
              pi = pi + 1
            end
            while pi < arm.params.len() do
              let p_ty = fresh_type_var(env)
              resolve_pattern_variants(env, &arm.params[pi], p_ty.clone())
              check_pattern(env, &arm.params[pi], p_ty, TypedPlace { root: AccessRoot::RawUnknown, root_name: "effect operation parameter", projections: Vec::new() })
              pi = pi + 1
            end
            # The arm body: a value block unifying with the op's return
            # type.
            if effect_arm_body_has_control_flow(&arm.body) then
              type_add_error(env, "return/break/continue/defer are not supported inside an effect-handler arm (the arm runs in the handler's dispatcher frame, not the enclosing function)", arm.span)
            end
            let arm_flow = check_block(env, &arm.body, true)
            unify(env, arm_flow.normal.clone(), op_sig.ret.clone(), arm.span)
            pop_scope(env)
            # The arm's capture scan (the semantic record the MIR's
            # handler-env construction reads): the arm's params are bound;
            # every other local the body references is a capture.
            var scan = CaptureScan { bound: Vec::new(), uses: Map::new(), nodes: Map::new() }
            var sp = 0
            while sp < arm.params.len() do
              scan_pattern_bind(env, &mut scan, &arm.params[sp])
              sp = sp + 1
            end
            scan_block(env, &mut scan, &arm.body)
            arm_caps.push(scan.uses)
            typed_arms.push(TypedHandlerArm {
              op_index: op_index,
              ret_type: op_sig.ret.clone(),
              params: typed_patterns_of(env, &arm.params).unwrap_or(Vec::new()),
              body: typed_stmts_of(env, &arm.body)
            })
          end
          a_idx = a_idx + 1
        end
        # The handler's capture record: the union of its arms' capture
        # sets (the handler env is one tuple over the union). The bounded
        # row's capture gate: owning (resource) values never cross into
        # the handler env — only non-owning captures are supported (the
        # env is a plain value tuple with no per-env finalization).
        var handler_caps: Map[Int, AccessEffect] = Map::new()
        var ci = 0
        while ci < arm_caps.len() do
          let cap_entries = arm_caps[ci].entries()
          var cei = 0
          while cei < cap_entries.len() do
            match handler_caps.get(cap_entries[cei].0)
            when Option::Some(cur) then
              if capture_effect_strength(cap_entries[cei].1) > capture_effect_strength(cur) then
                handler_caps.insert(cap_entries[cei].0, cap_entries[cei].1)
              end
            when Option::None then
              handler_caps.insert(cap_entries[cei].0, cap_entries[cei].1)
            end
            cei = cei + 1
          end
          ci = ci + 1
        end
        let cap_entries2 = handler_caps.entries()
        var cei2 = 0
        while cei2 < cap_entries2.len() do
          match env.typed_local_bindings.get(cap_entries2[cei2].0)
          when Option::Some(lb) then
            match type_properties_of(env, &lb.ty)
            when TypeProperties { owns_state: true, .. } then
              type_add_error(env, "cannot capture `" + lb.name + "` into an effect handler: the bounded handler env is a plain value tuple and resource ownership never crosses the perform boundary (capture a Copy value instead)", handler.span)
            when _ then ()
            end
          when Option::None then ()
          end
          cei2 = cei2 + 1
        end
        if arms_ok then
          typed_handlers.push(TypedHandler {
            effect: td.id.clone(),
            name: handler.effect_name.clone(),
            arms: typed_arms
          })
          handler_cap_records.push(handler_caps)
        else
          handlers_ok = false
        end
      when Option::None then
        type_add_error(env, "unknown effect `" + handler.effect_name + "` in the handle/with block (no `effect " + handler.effect_name + "` declaration is in scope)", handler.span)
        handlers_ok = false
        handler_cap_records.push(Map::new())
      end
      h_idx = h_idx + 1
    end
    # The neutralization scope: every handler's effect is neutralized for
    # the handled expression (a perform inside the block is caught by the
    # innermost matching handler — the enclosing function declares only the
    # effects it does NOT handle).
    var hsi = 0
    if handlers_ok then
      while hsi < typed_handlers.len() do
        env.handler_stack.push(typed_handlers[hsi].effect.id)
        hsi = hsi + 1
      end
    end
    let body_flow2 = check_expr(env, &expr)
    hsi = 0
    if handlers_ok then
      while hsi < typed_handlers.len() do
        env.handler_stack.pop()
        hsi = hsi + 1
      end
    end
    if handlers_ok then
      env.typed_effect_handlers.insert(stmt.node_id, typed_handlers)
      env.handler_captures.insert(stmt.node_id, handler_cap_records)
    end
    FlowResult {
      normal: body_flow2.clone(),
      may_return: false,
      may_break: false,
      may_continue: false,
      may_throw: false
    }
  when StmtKind::StmtWith(_, _, _) then
 # (g): unsupported feature — an explicit diagnostic, never a silent
    # Unit fallback (MIR has no with lowering).
 # `with` is a teardown-guarding form (context manager) whose exit
    # paths are exceptional in shape and the resource CFG models none of
    # them — rejected here, at the type checker, before the resource
    # checker or MIR ever see it.
    type_add_error(env, "exceptions are not supported — no throwing path may bypass teardown: with is rejected", stmt.span)
    flow_normal(Type::Error)
  when _ then
 # (g): every remaining statement kind is an explicit diagnostic —
    # there is no silent `Type::Unit` fallback for unhandled statements.
    type_add_error(env, "unsupported statement kind", stmt.span)
    flow_normal(Type::Error)
  end
  if stmt.node_id != 0 then
    env.typed_expr_types.insert(stmt.node_id, result.normal.clone())
 # (phase 2): the typed statement record — assembled from the
    # recorded children (the composite expression kinds of the tree carry
    # their blocks' TypedStmt children). A missing child (the
    # missing-metadata failure class) skips the record; the statement's
    # flat type entry remains.
    match typed_stmt_for(env, &stmt)
    when Option::Some(ts) then env.typed_stmts.insert(stmt.node_id, ts)
    when Option::None then ()
    end
  end
  result
end

def check_if_stmt(inout env: TypeEnv, if_stmt: IfStmt, is_stmt: Bool) -> FlowResult
  let cond_type = check_expr(env, &if_stmt.cond)
  unify(env, cond_type, Type::Bool, if_stmt.cond.span)
  
  let then_flow = check_block(env, &if_stmt.then_block, true)
  
  var result_type = then_flow.normal
  var may_return = then_flow.may_return
  var may_break = then_flow.may_break
  var may_continue = then_flow.may_continue
  var may_throw = then_flow.may_throw
  var falls_through = !is_never_type(&then_flow.normal)
  
  var i = 0
  while i < if_stmt.elsif_branches.len() do
    let (econd, ebody) = if_stmt.elsif_branches[i]
    let ec_type = check_expr(env, &econd)
    unify(env, ec_type, Type::Bool, econd.span)
    let eb_flow = check_block(env, &ebody, true)
    if !is_never_type(&eb_flow.normal) then falls_through = true end
    if eb_flow.may_return then may_return = true end
    if eb_flow.may_break then may_break = true end
    if eb_flow.may_continue then may_continue = true end
    if eb_flow.may_throw then may_throw = true end
    # Branch values are discarded for statement ifs; only value-position ifs
    # require the branches to agree.
    if !is_stmt then
      unify(env, result_type, eb_flow.normal, ebody.span)
    elsif is_never_type(&result_type) && !is_never_type(&eb_flow.normal) then
      # Statement-if completion value: keep the first completing branch's
      # type, but a branch that completes replaces an all-diverge prefix.
      result_type = eb_flow.normal
    end
    i = i + 1
  end
  
  match if_stmt.else_block
  when Option::Some(else_block) then
    let else_flow = check_block(env, &else_block, true)
    if !is_never_type(&else_flow.normal) then falls_through = true end
    if else_flow.may_return then may_return = true end
    if else_flow.may_break then may_break = true end
    if else_flow.may_continue then may_continue = true end
    if else_flow.may_throw then may_throw = true end
    if !is_stmt then
      unify(env, result_type, else_flow.normal, else_block.span)
    elsif is_never_type(&result_type) && !is_never_type(&else_flow.normal) then
      result_type = else_flow.normal
    end
  when Option::None then
    # An `if` without `else` used as a statement does not force its branch type
    # to Unit — forcing it rejects valid code like `if c then fetch_and_add() end`
    # whose branch returns a value that is discarded.
 # (e): an `if` USED AS A VALUE without an else contributes Unit on
    # the false path — every reachable branch must have compatible values.
    if !is_stmt then
      unify(env, result_type, Type::Unit, if_stmt.span)
    end
    falls_through = true
  end
  
 # an if whose every branch diverges never falls through (normal is
  # Never). A statement if WITHOUT an else completes without a value on the
  # false path, so its normal is Unit — a non-Unit function whose body ends
  # with such an if can no longer silently fall off the end.
  let normal = if falls_through then
    if !is_stmt then result_type
    elsif has_else_branch(&if_stmt) then result_type
    else Type::Unit
    end
  else
    Type::Never
  end
  FlowResult {
    normal: normal,
    may_return: may_return,
    may_break: may_break,
    may_continue: may_continue,
    may_throw: may_throw
  }
end

# Whether an if/elsif chain ends in an else (all paths produce a value).
def has_else_branch(if_stmt: IfStmt) -> Bool
  match if_stmt.else_block
  when Option::Some(_) then true
  when Option::None then false
  end  end
end

def guard_is_trivially_true(env: TypeEnv, guard: Expr) -> Bool
  match guard.kind
  when ExprKind::ExprBoolLit(v) then v
  when _ then false
  end  end
end

def check_match(inout env: TypeEnv, m: MatchExpr, is_stmt: Bool) -> FlowResult
  let scrutinee_type = check_expr(env, &m.scrutinee)
  
  var result_type = fresh_type_var(env)
  var has_wildcard = false
 # (defect fix): the covered-variant set holds VariantIds — the
  # scrutinee enum's TypeId (from the resolved scrutinee type) combined
  # with each pattern's variant-resolution record index. Coverage is
  # compared by identity; the variant NAMES survive only in the
  # missing-variants diagnostic.
  var covered_variants: Set[VariantId] = Set::new()
  var may_return = false
  var may_break = false
  var may_continue = false
  var may_throw = false
  var falls_through = false
  
  var i = 0
  while i < m.arms.len() do
    let arm = m.arms[i]
    push_scope(env)
 # the arm pattern's binding plan is collected here; its per-binding
    # actions (Read vs Move) are the ownership data the resource checker's
    # existing rules consume (a Move binding out of an owning aggregate is
    # only valid when the whole scrutinee aggregate is consumed — the
    # resource checker's check_match consumes the scrutinee root once).
    # The variant identity of every variant pattern in the arm is resolved
    # by the junction FIRST (against the scrutinee's enum identity — the
    # checker's typed resolution of the scrutinee expression), so the
    # coverage collection below reads the pattern's variant resolution
    # record — never a re-resolution from the source spelling.
    resolve_pattern_variants(env, &arm.pattern, scrutinee_type)
    check_pattern(env, &arm.pattern, scrutinee_type, binding_source_place(env, &m.scrutinee, "match scrutinee"))
    consume_binding_plans(env, &arm.pattern)

 # (defect fix): the guard is checked BEFORE the arm's coverage is
    # recorded — a guarded arm matches only when its (runtime) condition
    # holds, so it can never prove unconditional coverage of the pattern.
    # Only an unguarded arm (or one whose guard is provably trivially true)
    # contributes to the exhaustiveness set.
    var arm_has_guard = false
    match arm.guard_expr
    when Option::Some(guard_expr) then
      let guard_type = check_expr(env, &guard_expr)
      unify(env, guard_type, Type::Bool, guard_expr.span)
      if !guard_is_trivially_true(env, &guard_expr) then
        arm_has_guard = true
      end
    when Option::None then ()
    end

    if !arm_has_guard then
      match arm.pattern.kind
      when PatternKind::Wildcard then
        has_wildcard = true
      when PatternKind::Ident(_, _) then
        # An identifier pattern is a catch-all: it matches ANY value, so it
        # exhaustively covers a closed enum.
        has_wildcard = true
      when PatternKind::Variant(_, _) then
        # The covered variant is the pattern's RESOLVED identity — the
        # (owner TypeId, variant index) record — never a name comparison.
        match env.pattern_variant_resolutions.get(arm.pattern.node_id)
        when Option::Some((tid, vidx)) then
          covered_variants.insert(VariantId { owner: TypeId { id: tid }, index: vidx as UInt })
        when Option::None then ()
        end
      when PatternKind::Or(alts) then
        var j = 0
        while j < alts.len() do
          match alts[j].kind
          when PatternKind::Wildcard then
            has_wildcard = true
          when PatternKind::Ident(_, _) then
            has_wildcard = true
          when PatternKind::Variant(_, _) then
            match env.pattern_variant_resolutions.get(alts[j].node_id)
            when Option::Some((tid, vidx)) then
              covered_variants.insert(VariantId { owner: TypeId { id: tid }, index: vidx as UInt })
            when Option::None then ()
            end
          when PatternKind::Struct(_, _) then
            # A struct-style enum-variant pattern (Enum::Variant {.. })
            # carries its variant resolution record too — it covers the
            # variant by identity; a plain struct destructure has no record.
            match env.pattern_variant_resolutions.get(alts[j].node_id)
            when Option::Some((tid, vidx)) then
              covered_variants.insert(VariantId { owner: TypeId { id: tid }, index: vidx as UInt })
            when Option::None then ()
            end
          when PatternKind::Literal(_) then ()
          when PatternKind::Tuple(_) then ()
          when PatternKind::Array(_) then ()
          when PatternKind::Range(_, _, _) then ()
          end
          j = j + 1
        end
      when PatternKind::Struct(_, _) then
        # A struct-style enum-variant pattern (Enum::Variant {.. }) covers
        # its variant by identity (the resolution record); a plain struct
        # destructure contributes nothing.
        match env.pattern_variant_resolutions.get(arm.pattern.node_id)
        when Option::Some((tid, vidx)) then
          covered_variants.insert(VariantId { owner: TypeId { id: tid }, index: vidx as UInt })
        when Option::None then ()
        end
      when PatternKind::Literal(_) then ()
      when PatternKind::Tuple(_) then ()
      when PatternKind::Array(_) then ()
      when PatternKind::Range(_, _, _) then ()
      end
    end
    
    let arm_flow = check_block(env, &arm.body, true)
    if !is_never_type(&arm_flow.normal) then falls_through = true end
    if arm_flow.may_return then may_return = true end
    if arm_flow.may_break then may_break = true end
    if arm_flow.may_continue then may_continue = true end
    if arm_flow.may_throw then may_throw = true end
    # A match used as a STATEMENT discards its value, so heterogeneous arm
    # types (e.g. an arm ending in `set.insert(...)` returning Bool next to a
    # Unit arm) are not errors. Value-position matches still unify strictly.
    if !is_stmt then
      unify(env, result_type, arm_flow.normal, arm.span)
    end
    pop_scope(env)
    i = i + 1
  end
  
 # (f) + (FIX 3): a match over a closed enum must be exhaustive in
  # BOTH value and statement position.  A non-exhaustive value match has no
  # value on the uncovered path; a non-exhaustive statement match is an
  # incomplete case analysis all the same — both are semantic errors.  The
  # error applies only to closed-enum scrutinees (Type::Adt resolving to
  # an enum definition); matches over open or non-enum scrutinees are
  # unaffected (a `when _`/ident arm or a trailing `else` catch-all is the
  # explicit way to keep an intentionally partial statement match).
  # Coverage is compared BY IDENTITY: the covered set holds the VariantId
  # (owner = the scrutinee enum's TypeId from the resolved scrutinee type,
  # index = the pattern's variant resolution record) of every covered
  # variant; a scrutinee variant is uncovered exactly when its own
  # VariantId is absent from the set. A guarded arm never contributes an
  # entry (see the arm loop above).
  if !has_wildcard then
    match scrutinee_type
    when Type::Adt(tid, _) then
      match get_type_by_id_ref(env, &tid)
      when Option::Some(td) then
        match td.def_kind
        when TypeDefKind::Enum(variants) then
          let missing = Vec::new()
          var j = 0
          while j < variants.len() do
            let variant = variants[j]
            let variant_id = VariantId { owner: TypeId { id: tid.id }, index: j as UInt }
            if !covered_variants.contains(&variant_id) then
              missing.push(variant.name.clone())
            end
            j = j + 1
          end
          if !missing.is_empty() then
            type_add_error(env, "non-exhaustive match: missing variants " +
              missing.join(", ") + " (add a wildcard `_` arm or cover every variant)", m.span)
          end
        when TypeDefKind::Struct(_) then ()
        when TypeDefKind::Trait(_) then ()
        when TypeDefKind::Alias(_) then ()
        when TypeDefKind::Primitive then ()
        when TypeDefKind::Opaque then ()
        end
      when Option::None then ()
      end
    when Type::Unit then ()
    when Type::Bool then ()
    when Type::Int then ()
    when Type::UInt then ()
    when Type::Float then ()
    when Type::Char then ()
    when Type::String then ()
    when Type::Never then ()
    when Type::I8 then ()
    when Type::I16 then ()
    when Type::I32 then ()
    when Type::I64 then ()
    when Type::I128 then ()
    when Type::U8 then ()
    when Type::U16 then ()
    when Type::U32 then ()
    when Type::U64 then ()
    when Type::U128 then ()
    when Type::ISize then ()
    when Type::USize then ()
    when Type::F32 then ()
    when Type::F64 then ()
    when Type::Ptr(_) then ()
    when Type::PtrMut(_) then ()
    when Type::FnPtr(_, _, _) | Type::Closure(_, _, _, _, _) then ()
    when Type::Dyn(_) then ()
    when Type::Effect(_, _) then ()
    when Type::Tuple(_) then ()
    when Type::Var(_) then ()
    when Type::Param(_) then ()
    when Type::Error then ()
    when Type::RefInternal(_, _) then ()
    when Type::FixedArray(_, _) then ()
    end
  end
  
  let normal = if falls_through then result_type else Type::Never end
  FlowResult {
    normal: normal,
    may_return: may_return,
    may_break: may_break,
    may_continue: may_continue,
    may_throw: may_throw
  }
end

# ———————————————————————————————————————————————————————————————
# Enum Variant Resolution — scan all type defs to find which enum
# contains a variant with the given name. Used by both expression
# and pattern type checking to resolve bare variant names like
# `Some`, `None`, `Ok`, `Err` without requiring `Option::` / `Result::`.
# The INDEXED form also returns the variant's position in the owner
# enum's variant list — the resolved variant IDENTITY that pattern
# typing threads through (see check_pattern / pattern_variant_resolutions)
# so downstream consumers resolve variants by identity, not by name.
# ———————————————————————————————————————————————————————————————

def find_enum_variant(env: TypeEnv, name: String) -> Option[(TypeDef, VariantInfo)]
  match find_enum_variant_indexed(env, name)
  when Option::Some((td, v, _)) then Option::Some((td, v))
  when Option::None then Option::None
  end  end
end

def find_enum_variant_indexed(env: TypeEnv, name: String) -> Option[(TypeDef, VariantInfo, Int)]
  var i = 0
  while i < env.type_list.len() do
    let td = env.type_list[i]
    match td.def_kind
    when TypeDefKind::Enum(variants) then
      var j = 0
      while j < variants.len() do
        if variants[j].name == name then
          return Option::Some((td, variants[j], j))
        end
        j = j + 1
      end
    when _ then ()
    end
    i = i + 1
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# Pattern Type Checking 
#
# Pattern typing is an OWNERSHIP operation: besides unifying the pattern
# against the expected type, check_pattern records — per bound identifier —
# a BindingPlan { local, source_place, action } where action is Read for a
# plain binding of a copyable value and Consume for a binding that MOVES an
# owning value out of its source place. The plan is additive: binding
# behavior for existing code is unchanged. Enum-variant patterns resolve by
# variant IDENTITY (owner TypeId + variant index) and the resolved identity
# is recorded in pattern_variant_resolutions keyed by the pattern node id,
# so downstream consumers never re-scan variant names.
#
# (defect fix — the pattern-resolution junction): the variant identity
# of a variant pattern is resolved ONCE, by resolve_pattern_variants — the
# junction invoked by the match/let/for/closure checking paths BEFORE
# check_pattern — against the CHECKER's typed resolution of the scrutinee/
# initializer (the expected type's enum — the resolver-provided TypeId),
# then recorded. check_pattern READS the record (pattern_variant_
# resolutions) and never re-resolves semantic identity from the source
# spelling: the path segments survive only in diagnostics. The
# spelling-driven lookups (the within-enum name scan for the variant INDEX,
# the module-qualified owner lookup, and the global variant-name scan as
# the last-resort fallback for genuinely context-less bare variants) live
# in the junction — the single place where spelling meets identity.
# ———————————————————————————————————————————————————————————————

# The pattern-resolution junction: walk a pattern tree and record the
# resolved (owner TypeId id, variant index) identity of every
# variant-style node (PatternKind::Variant and the struct-style
# Enum::Variant {.. } form) in pattern_variant_resolutions, keyed by the
# pattern node id. The OWNER enum identity comes from the expected type
# (the checker's typed resolution of the scrutinee/initializer — Type::Adt
# carrying the resolver-provided TypeId) or, for qualified paths, from the
# checker's module-qualified identity tables; only the variant INDEX within
# that enum — and the last-resort global scan for context-less bare
# variants — consult the source spelling, and they live HERE, never in
# check_pattern.
def resolve_pattern_variants(inout env: TypeEnv, pat: Pattern, expected: Type) -> Unit
  let expected_base = match expected
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else expected.clone() end
  when _ then expected
  end
  match pat.kind
  when PatternKind::Wildcard then ()
  when PatternKind::Ident(_, _) then ()
  when PatternKind::Literal(_) then ()
  when PatternKind::Tuple(pats) then
    match expected_base
    when Type::Tuple(types) then
      if pats.len() == types.len() then
        var i = 0
        while i < pats.len() do
          resolve_pattern_variants(env, &pats[i], types[i].clone())
          i = i + 1
        end
      else
        var i = 0
        while i < pats.len() do
          resolve_pattern_variants(env, &pats[i], expected_base.clone())
          i = i + 1
        end
      end
    when _ then
      var i = 0
      while i < pats.len() do
        resolve_pattern_variants(env, &pats[i], expected_base.clone())
        i = i + 1
      end
    end
  when PatternKind::Array(pats) then
    var i = 0
    while i < pats.len() do
      resolve_pattern_variants(env, &pats[i], expected_base.clone())
      i = i + 1
    end
  when PatternKind::Struct(path, field_pats) then
    # The struct-style enum-variant form (Enum::Variant {.. }) is a
    # variant node: resolve and record its identity; the sub-patterns
    # resolve against the same context. Struct-style nodes never use the
    # global variant-name scan (a plain struct destructure whose name
    # resolves to a type must not be hijacked by an unrelated enum's
    # variant of the same name).
    resolve_pattern_variant_node(env, pat, &path, &expected_base, true)
    var i = 0
    while i < field_pats.len() do
      resolve_pattern_variants(env, &field_pats[i].1, expected_base.clone())
      i = i + 1
    end
  when PatternKind::Variant(path, pats) then
    resolve_pattern_variant_node(env, pat, &path, &expected_base, false)
    var i = 0
    while i < pats.len() do
      resolve_pattern_variants(env, &pats[i], expected_base.clone())
      i = i + 1
    end
  when PatternKind::Or(alts) then
    var i = 0
    while i < alts.len() do
      resolve_pattern_variants(env, &alts[i], expected.clone())
      i = i + 1
    end
  when PatternKind::Range(_, _, _) then ()
  end
end

# Resolve and record the (owner TypeId id, variant index) identity of ONE
# variant-style pattern node (PatternKind::Variant / the struct-style
# Enum::Variant {.. } form). Identity order:
#   1. the expected type's enum (the typed resolution of the value being
#      matched — resolver-provided TypeId) — the variant index is the
#      within-enum scan;
#   2. a qualified path's owner enum via the module-qualified identity
#      tables (get_type_id_by_qualified_name — the resolver-anchored
#      declaration identity, bare first-wins as the compatibility
#      fallback); a named owner wins over the context (the check_pattern
#      unification flags a mismatch — exactly like the pre-junction
#      behavior);
#   3. a bare PatternKind::Variant with no enum context — the global
#      variant-name scan (find_enum_variant_indexed), the compatibility
#      fallback (struct-style nodes skip it: a plain struct destructure
#      must never be hijacked by an unrelated enum's variant of the same
#      name).
# The spelling-driven lookups exist so the junction can emit the variant
# diagnostics ("unknown variant X in enum Y", "Y is not an enum"); the
# identity they produce is recorded and check_pattern reads ONLY the
# record.
def resolve_pattern_variant_node(inout env: TypeEnv, pat: Pattern, path: AstPath, expected_base: Type, struct_style: Bool) -> Unit
  match env.pattern_variant_resolutions.get(pat.node_id)
  when Option::Some(_) then return
  when Option::None then ()
  end
  let variant_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
  let enum_name = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2] else "" end
  # 1. the context enum (the expected type's identity — never a name).
  var context_owner: Option[TypeDef] = Option::None
  match expected_base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, tid)
    when Option::Some(td) then context_owner = Option::Some(td)
    when Option::None then ()
    end
  when _ then ()
  end
  # 2. the qualified path's owner (module-qualified identity tables).
  var named_owner: Option[TypeDef] = Option::None
  if enum_name != "" then
    match get_type_id_by_qualified_name(env, enum_name.clone(), &env.current_module_path)
    when Option::Some(owner_tid) then
      match get_type_by_id_ref(env, &owner_tid)
      when Option::Some(td) then named_owner = Option::Some(td)
      when Option::None then ()
      end
    when Option::None then ()
    end
  end
  var chosen: Option[TypeDef] = Option::None
  var named_chosen = false
  match named_owner
  when Option::Some(td) then
    chosen = Option::Some(td)
    named_chosen = true
  when Option::None then
    match context_owner
    when Option::Some(td) then chosen = Option::Some(td)
    when Option::None then ()
    end
  end
  var resolved: Option[(Int, Int)] = Option::None
  match chosen
  when Option::Some(td) then
    match td.def_kind
    when TypeDefKind::Enum(variants) then
      var vi = 0
      while vi < variants.len() do
        if variants[vi].name == variant_name then
          resolved = Option::Some((td.id.id, vi))
        end
        vi = vi + 1
      end
      if named_chosen then
        match resolved
        when Option::Some(_) then ()
        when Option::None then
          type_add_error(env, "unknown variant " + variant_name + " in enum " + enum_name, pat.span)
        end
      end
    when TypeDefKind::Struct(_) then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    when TypeDefKind::Trait(_) then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    when TypeDefKind::Alias(_) then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    when TypeDefKind::Primitive then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    when TypeDefKind::Opaque then
      if named_chosen then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    end
  when Option::None then ()
  end
  # 3. last resort: a bare Variant with no enum context — the global
  # variant-name scan (the compatibility fallback for genuinely
  # context-less patterns, e.g. a generic scrutinee still under
  # inference). Struct-style nodes never take this path.
  match resolved
  when Option::Some(_) then ()
  when Option::None then
    if !struct_style then
      match find_enum_variant_indexed(env, variant_name)
      when Option::Some((enum_td, _, vidx)) then
        resolved = Option::Some((enum_td.id.id, vidx))
      when Option::None then ()
      end
    end
  end
  match resolved
  when Option::Some((tid, vidx)) then
    env.pattern_variant_resolutions.insert(pat.node_id, (tid, vidx))
  when Option::None then ()
  end  end
end

# The semantic source place of a pattern's bindings: the typed place of
# the source expression (the checker's typed_place_of — the AccessRoot
# domain) when it denotes a place; the RawUnknown root with the given
# diagnostic name for value expressions and synthesized sources.
def binding_source_place(env: TypeEnv, expr: Expr, fallback_name: String) -> TypedPlace
  match typed_place_of(env, expr)
  when Option::Some(tp) then tp
  when Option::None then TypedPlace { root: AccessRoot::RawUnknown, root_name: fallback_name, projections: Vec::new() }
  end  end
end

# Consume the BindingPlans recorded for every binding under a pattern (the
# block/match/for checking paths call this after check_pattern). The plans
# are the per-binding Read/Move actions the ownership layer's existing rules
# consume; reading them here is the type layer's consumption point.
def consume_binding_plans(env: TypeEnv, pat: Pattern) -> Unit
  let _plans = match env.binding_plans.get(pat.node_id)
  when Option::Some(plans) then plans
  when Option::None then Vec::new()
  end
  match pat.kind
  when PatternKind::Ident(_, _) then ()
  when PatternKind::Wildcard then ()
  when PatternKind::Literal(_) then ()
  when PatternKind::Tuple(pats) then
    var i = 0
    while i < pats.len() do
      consume_binding_plans(env, &pats[i])
      i = i + 1
    end
  when PatternKind::Array(pats) then
    var i = 0
    while i < pats.len() do
      consume_binding_plans(env, &pats[i])
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    var i = 0
    while i < field_pats.len() do
      consume_binding_plans(env, &field_pats[i].1)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    var i = 0
    while i < pats.len() do
      consume_binding_plans(env, &pats[i])
      i = i + 1
    end
  when PatternKind::Or(alts) then
    var i = 0
    while i < alts.len() do
      consume_binding_plans(env, &alts[i])
      i = i + 1
    end
  when PatternKind::Range(_, _, _) then ()
  end
end

def check_pattern(inout env: TypeEnv, pat: Pattern, expected: Type, source_place: TypedPlace) -> Unit
  # Patterns match through references (e.g. `let (a, b) = &pair` where the
  # scrutinee is a reference to a tuple).
  let expected_base = match expected
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else expected.clone() end
  when _ then expected
  end
  match pat.kind
  when PatternKind::Wildcard then
    ()
  when PatternKind::Ident(name, is_mut) then
    let before = env.local_id_counter
    bind_var(env, name, expected_base)
    if env.local_id_counter > before then
      env.pattern_binding_resolutions.insert(pat.node_id, before)
 # record the binding action — a plain binding READS its source;
      # a binding of an owning type MOVES the value out of the source place
      # (the resource checker's projected-move rules consume this data).
      # Binding through a reference/box (`let (a, b) = &pair`) is a READ —
      # no ownership transfers out of the source.
      let bind_is_ref = match expected
      when Type::RefInternal(_, _) then true
      when Type::Adt(tid, args) then
        if tid.id == env.lang_items.box_ && args.len() >= 1 then true else false end
      when _ then false
      end
      let action = if !bind_is_ref && type_has_resource_kind(env, &expected_base) then AccessEffect::Consume else AccessEffect::Read end
      var plans = match env.binding_plans.get(pat.node_id)
      when Option::Some(p) then p.clone()
      when Option::None then Vec::new()
      end
      plans.push(BindingPlan { local: before, source_place: source_place.clone(), action: action })
      env.binding_plans.insert(pat.node_id, plans)
    end
  when PatternKind::Literal(expr) then
    let lit_type = check_expr(env, &expr)
    unify(env, lit_type, expected_base, pat.span)
    ()
  when PatternKind::Tuple(pats) then
    match expected_base
    when Type::Tuple(types) then
      if pats.len() == types.len() then
        var i = 0
        while i < pats.len() do
          check_pattern(env, &pats[i], types[i].clone(), source_place.clone())
          i = i + 1
        end
      else
        type_add_error(env, "tuple pattern length mismatch", pat.span)
      end
    when Type::Var(_) then
      var types = Vec::new()
      var i = 0
      while i < pats.len() do
        let t = fresh_type_var(env)
        check_pattern(env, &pats[i], t, source_place.clone())
        types.push(t)
        i = i + 1
      end
      unify(env, expected_base, Type::Tuple(types), pat.span)
      ()
    when Type::Param(_) then
      # Generic parameter standing in for a tuple (e.g. Option::Some's payload)
      var types = Vec::new()
      var i = 0
      while i < pats.len() do
        let t = fresh_type_var(env)
        check_pattern(env, &pats[i], t, source_place.clone())
        types.push(t)
        i = i + 1
      end
      unify(env, expected_base, Type::Tuple(types), pat.span)
      ()
    when _ then
      type_add_error(env, "expected tuple type", pat.span)
    end
  when PatternKind::Array(pats) then
    let elem_type = fresh_type_var(env)
    var i = 0
    while i < pats.len() do
      check_pattern(env, &pats[i], elem_type, source_place.clone())
      i = i + 1
    end
  when PatternKind::Variant(path, pats) then
 # (defect fix): the semantic identity (owner TypeId, variant
    # index) of this variant pattern is READ from the resolution record —
    # recorded by the pattern-resolution junction (resolve_pattern_variants
    # — invoked by the match/let/for/closure checking paths before
    # check_pattern) — never re-derived from the source spelling. The path
    # segments survive only for diagnostics.
    let variant_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
    match env.pattern_variant_resolutions.get(pat.node_id)
    when Option::Some((tid, vidx)) then
      match get_type_by_id_ref(env, &TypeId { id: tid })
      when Option::Some(td) then
        match td.def_kind
        when TypeDefKind::Enum(variants) then
          if vidx < variants.len() then
            let v = variants[vidx]
            # Check sub-pattern count doesn't exceed variant field count
            # Allow fewer sub-patterns than fields (discriminant-only matching)
            if pats.len() > v.fields.len() then
              type_add_error(env, "variant " + variant_name + " expects " + v.fields.len().to_string() + " fields, got " + pats.len().to_string(), pat.span)
            end
            # Unify expected with the enum type
            let enum_type_args = fresh_type_args_for(env, td)
            unify(env, expected, Type::Adt(td.id, enum_type_args), pat.span)
            # Check each sub-pattern against the variant's field types
            var fi = 0
            while fi < pats.len() && fi < v.fields.len() do
              let field_ty = subst_type_args(&v.fields[fi], &td.generic_params, &enum_type_args)
              check_pattern(env, &pats[fi], field_ty, source_place.clone())
              fi = fi + 1
            end
          end
        when TypeDefKind::Struct(_) then ()
        when TypeDefKind::Trait(_) then ()
        when TypeDefKind::Alias(_) then ()
        when TypeDefKind::Primitive then ()
        when TypeDefKind::Opaque then ()
        end
      when Option::None then ()
      end
    when Option::None then
      # No resolution record (permissive recovery — the junction records
      # every variant node on the compilation path): accept the pattern
      # structurally, checking the sub-patterns against fresh variables.
      var fi = 0
      while fi < pats.len() do
        check_pattern(env, &pats[fi], fresh_type_var(env), source_place.clone())
        fi = fi + 1
      end
    end
  when PatternKind::Struct(path, field_pats) then
    # A struct-style pattern is a struct destructure (Foo { x: p }) or a
    # struct-style enum-variant pattern (Enum::Variant { x: p }). The
    # enum-variant form's identity comes from the resolution record (the
    # junction records struct-style variant nodes); a plain struct
    # destructure resolves the struct through the checker's identity
    # tables (module-qualified first — the resolver-anchored TypeId — the
    # bare first-wins index as the compatibility fallback).
    match env.pattern_variant_resolutions.get(pat.node_id)
    when Option::Some((tid, vidx)) then
      match get_type_by_id_ref(env, &TypeId { id: tid })
      when Option::Some(enum_td) then
        match enum_td.def_kind
        when TypeDefKind::Enum(variants) then
          if vidx < variants.len() then
            let variant = variants[vidx]
            let enum_type_args = fresh_type_args_for(env, enum_td)
            unify(env, expected, Type::Adt(enum_td.id, enum_type_args), pat.span)
            var fi = 0
            while fi < field_pats.len() && fi < variant.fields.len() do
              let field_ty = subst_type_args(&variant.fields[fi], &enum_td.generic_params, &enum_type_args)
              check_pattern(env, &field_pats[fi].1, field_ty, source_place.clone())
              fi = fi + 1
            end
          end
        when TypeDefKind::Struct(_) then ()
        when TypeDefKind::Trait(_) then ()
        when TypeDefKind::Alias(_) then ()
        when TypeDefKind::Primitive then ()
        when TypeDefKind::Opaque then ()
        end
      when Option::None then ()
      end
    when Option::None then
      # Plain struct destructuring pattern: Foo { x, y: p }
      let struct_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
      match get_type_id_by_qualified_name(env, struct_name.clone(), &env.current_module_path)
      when Option::Some(struct_tid) then
        match get_type_by_id_ref(env, &struct_tid)
        when Option::Some(td) then
          let struct_type_args = fresh_type_args_for(env, td)
          unify(env, expected, Type::Adt(td.id, struct_type_args), pat.span)
          match td.def_kind
          when TypeDefKind::Struct(fields) then
            var i = 0
            while i < field_pats.len() do
              let field_pat = field_pats[i]
              var field_found = false
              var j = 0
              while j < fields.len() do
                let f = fields[j]
                if f.name == field_pat.0 then
                  field_found = true
                  # Substitute generic type parameters when checking pattern field types
                  let field_ty = subst_type_args(&f.ty, &td.generic_params, &struct_type_args)
                  check_pattern(env, &field_pat.1, field_ty, source_place.clone())
                end
                j = j + 1
              end
              if !field_found then
                type_add_error(env, "no field `" + field_pat.0 + "` on struct " + struct_name, pat.span)
              end
              i = i + 1
            end
          when TypeDefKind::Enum(_) then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          when TypeDefKind::Trait(_) then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          when TypeDefKind::Alias(_) then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          when TypeDefKind::Primitive then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          when TypeDefKind::Opaque then
            type_add_error(env, struct_name + " is not a struct", pat.span)
          end
        when Option::None then ()
        end
      when Option::None then
        type_add_error(env, "unknown type " + struct_name, pat.span)
      end
    end
  when PatternKind::Range(lo, hi, _) then
    # Range pattern: 1..=10,  'a'..='z'
    match lo
    when Option::Some(lo_expr) then
      let lo_ty = check_expr(env, &lo_expr)
      unify(env, lo_ty, expected, pat.span)
      ()
    when Option::None then ()
    end
    match hi
    when Option::Some(hi_expr) then
      let hi_ty = check_expr(env, &hi_expr)
      unify(env, hi_ty, expected, pat.span)
      ()
    when Option::None then ()
    end
  when PatternKind::Or(alts) then
    # Or-pattern: p1 | p2 | p3
    var i = 0
    while i < alts.len() do
      check_pattern(env, &alts[i], expected, source_place.clone())
      i = i + 1
    end
 # (defect fix): every alternative must introduce EXACTLY the same
    # bindings — same names, same types, same mutability, same ownership
    # action — because the alternatives merge into ONE binding set. The
    # equivalence is enforced AFTER the alternatives are typed (the
    # binding records — pattern_binding_resolutions, typed_local_bindings,
    # binding_plans — are recorded by then) and BEFORE the merged set is
    # consumed; a mismatch is rejected with a diagnostic.
    check_or_alternatives_bindings(env, &alts, pat.span)
  when _ then
 # (defect fix): every PatternKind is matched explicitly above — a
    # catch-all would silently omit a future pattern kind (the silent
    # semantic omission class).
    panic("internal error: unhandled pattern kind in check_pattern")
  end
 # (phase 2): the typed pattern record — assembled from the
  # recorded children (the bound local ids from
  # pattern_binding_resolutions, the resolved variant identity from
  # pattern_variant_resolutions). The tree's Closure / Match / Let forms
  # carry these records. A missing child (the missing-metadata failure
  # class) skips the record.
  if pat.node_id != 0 then
    match typed_pattern_for(env, pat)
    when Option::Some(tp) then env.typed_patterns.insert(pat.node_id, tp)
    when Option::None then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Or-pattern binding equivalence 
# ———————————————————————————————————————————————————————————————
#
# An or-pattern merges its alternatives into ONE binding set, so every
# alternative must introduce EXACTLY the same bindings: the same names
# with the same types, the same mutability and the same ownership action.
# The equivalence is checked after the alternatives are typed (the
# checker's binding records are populated by then) and before the merged
# scope is consumed; a mismatch is a semantic error (the merged set would
# be ambiguous).

# One binding of an or-pattern alternative: the bound name, its
# mutability, its semantic local id (the typed binding's type is read back
# from typed_local_bindings) and the binding's ownership action (the
# BindingPlan action — Read vs Consume).
struct OrBindingInfo
  name: String
  is_mut: Bool
  local: Int
  action: AccessEffect
end

# Collect the OrBindingInfo of every identifier bound under a pattern.
def collect_or_bindings(env: TypeEnv, pat: Pattern, inout out: Vec[OrBindingInfo]) -> Unit
  match pat.kind
  when PatternKind::Ident(name, is_mut) then
    match env.pattern_binding_resolutions.get(pat.node_id)
    when Option::Some(local) then
      let action = match env.binding_plans.get(pat.node_id)
      when Option::Some(plans) then
        if plans.len() > 0 then plans[0].action else AccessEffect::Read end
      when Option::None then AccessEffect::Read
      end
      out.push(OrBindingInfo { name: name.clone(), is_mut: is_mut, local: local, action: action })
    when Option::None then ()
    end
  when PatternKind::Tuple(pats) then
    var i = 0
    while i < pats.len() do
      collect_or_bindings(env, &pats[i], out)
      i = i + 1
    end
  when PatternKind::Array(pats) then
    var i = 0
    while i < pats.len() do
      collect_or_bindings(env, &pats[i], out)
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    var i = 0
    while i < field_pats.len() do
      collect_or_bindings(env, &field_pats[i].1, out)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    var i = 0
    while i < pats.len() do
      collect_or_bindings(env, &pats[i], out)
      i = i + 1
    end
  when PatternKind::Or(alts) then
    var i = 0
    while i < alts.len() do
      collect_or_bindings(env, &alts[i], out)
      i = i + 1
    end
  when PatternKind::Wildcard then ()
  when PatternKind::Literal(_) then ()
  when PatternKind::Range(_, _, _) then ()
  end  end
end

# Whether two alternatives' binding sets are equivalent: the same number of
# bindings and, per binding, a partner with the same name, mutability and
# ownership action whose TYPES unify (the type probe is transactional —
# substitution residue and diagnostics are rolled back).
def or_binding_sets_equivalent(inout env: TypeEnv, a: Vec[OrBindingInfo], b: Vec[OrBindingInfo]) -> Bool
  if a.len() != b.len() then return false end
  var i = 0
  while i < a.len() do
    var matched = false
    var j = 0
    while j < b.len() do
      let bj = b[j]
      if a[i].name == bj.name && a[i].is_mut == bj.is_mut && a[i].action == bj.action then
        let ty_a = match env.typed_local_bindings.get(a[i].local)
        when Option::Some(lb) then lb.ty.clone()
        when Option::None then Type::Error
        end
        let ty_b = match env.typed_local_bindings.get(bj.local)
        when Option::Some(lb) then lb.ty.clone()
        when Option::None then Type::Error
        end
        let snap = subst_snapshot(env)
        let errs_before = env.errors.len()
        let ok = unify(env, ty_a, ty_b, Span { file: "", start: 0, end_pos: 0 })
        if !ok then
          while env.errors.len() > errs_before do
            env.errors.pop()
          end
        end
        subst_restore(env, &snap)
        if ok then
          matched = true
        end
      end
      j = j + 1
    end
    if !matched then return false end
    i = i + 1
  end
  true
end

# Enforce the or-pattern binding equivalence over all alternatives of an
# or-pattern; emit a diagnostic on the first mismatch.
def check_or_alternatives_bindings(inout env: TypeEnv, alts: Vec[Pattern], span: Span) -> Unit
  if alts.len() <= 1 then return end
  var baseline: Vec[OrBindingInfo] = Vec::new()
  collect_or_bindings(env, &alts[0], &mut baseline)
  var i = 1
  while i < alts.len() do
    var cur: Vec[OrBindingInfo] = Vec::new()
    collect_or_bindings(env, &alts[i], &mut cur)
    if !or_binding_sets_equivalent(env, &baseline, &cur) then
      type_add_error(env, "or-pattern alternatives must bind the same names with the same types, mutability and ownership action", span)
      return
    end
    i = i + 1
  end
end

# ———————————————————————————————————————————————————————————————
# Expression Type Checking
# ———————————————————————————————————————————————————————————————

def convention_to_effect(c: AccessConvention) -> AccessEffect
  match c
  when AccessConvention::Let then AccessEffect::Read
  when AccessConvention::Inout then AccessEffect::Modify
  when AccessConvention::Sink then AccessEffect::Consume
  when AccessConvention::Set then AccessEffect::Initialize
  end  end
end

def record_arg_effect(inout env: TypeEnv, arg: Expr, c: AccessConvention) -> Unit
  let effect = convention_to_effect(c)
  env.typed_access_effects.insert(arg.node_id, effect)
  match arg.kind
  when ExprKind::ExprAccess(inner) then env.typed_access_effects.insert(inner.node_id, effect)
  when _ then ()
  end
  # (partial moves): a SINK argument over an owning PROJECTED place is an
  # expression-level move-out — the mirror of the resource checker's
  # apply_arg_effect Consume path. The projected chain is recorded in the
  # semantic registry (the drop sites' partial-drop conditioning) at the
  # same site the checker's frame lattice marks it Consumed.
  if effect == AccessEffect::Consume then
    record_projected_consume(env, &arg)
  end
end

def resolved_receiver_base(env: TypeEnv, recv_type: Type) -> Type
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end
  match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Alias(inner) then inner.clone()
      when _ then base.clone()
      end
    when Option::None then base.clone()
    end
  when _ then base.clone()
  end
end

def resolver_method_key(env: TypeEnv, recv_type: Type, method: String) -> String
  let base = resolved_receiver_base(env, recv_type)
  var name = "".to_string()
  var generic = false
  match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      name = td.name.clone()
      generic = td.generic_params.len() > 0
    when Option::None then ()
    end
  when Type::String then name = "String"
  when Type::Int then name = "Int"
  when Type::UInt then name = "UInt"
  when Type::Float then name = "Float"
  when Type::Bool then name = "Bool"
  when Type::Char then name = "Char"
  when Type::Ptr(_) then name = "Ptr"; generic = true
  when Type::PtrMut(_) then name = "PtrMut"; generic = true
  when _ then ()
  end
  if name == "" then return "".to_string() end
  var key = if generic then name + "[...]" else name end
  key + "::" + method
end

# ———————————————————————————————————————————————————————————————
# the SEMANTIC method-def lookup (the bare-keyed method table deletion)
# ———————————————————————————————————————————————————————————————
# The bare-keyed method table is are not part of the model. A method's
# DefId comes from the SEMANTIC registration — module_symbols' qualified
# "path::Type::method" entries (the resolver's impl-method / struct-method
# registration) — through the three helpers below:
#   type_registration_module_path — the module path a receiver TypeId was
#     registered from (the checker's module_type_names join: qualified key
#     -> type_list index; the key's module part IS the registration path);
#   qualified_method_def — the EXACT qualified lookup (path + the
#     "Type::method" key, DefKind::Method filter);
#   scan_qualified_method_def — the QUALIFIED-SCAN fallback: the entries
#     whose key IS the bare "Type::method" (root) or ends with
#     "::Type::method", filtered to DefKind::Method and deduplicated by
#     DefId — the 0/1/>1 rule (0 -> None, exactly 1 -> the DefId,
#     >= 2 -> None: ambiguous, no silent pick). Covers the builtin
#     receivers (String/Int/... and the LangItems compounds) whose method
#     impls live in a std module (std::core / std::collections).

def type_registration_module_path(env: TypeEnv, tid: TypeId) -> Vec[String]
  match env.type_id_index.get(tid.id)
  when Option::Some(idx) then
    var candidates = Vec::new()
    for (key, kidx) in env.module_type_names.entries() do
      if kidx == idx then
        candidates.push(key.clone())
      end
    end
    candidates.sort()
    if candidates.is_empty() then
      Vec::new()
    else
      # The qualified registration key ("path::name" — the bare root key
      # has no separator); the module part is everything before the last
      # "::".
      match candidates[0].rfind("::")
      when Option::Some(pos) then candidates[0].slice(0, pos).split("::")
      when Option::None then Vec::new()
      end
    end
  when Option::None then Vec::new()
  end  end
end

# The exact module-qualified method lookup: the module_symbols entry for
# "path::Type::method", filtered to DefKind::Method (a same-spelled
# non-method registration never answers through this path).
def qualified_method_def(env: TypeEnv, path: Vec[String], key: String) -> Option[DefId]
  match env.resolutions
  when Option::Some(res) then
    let qkey = module_qualified_key(path, key)
    match res.module_symbols.get(&qkey)
    when Option::Some(did) then
      match def_kind_of(&res, &did)
      when Option::Some(k) then
        if k == DefKind::Method then Option::Some(did) else Option::None end
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end  end
end

# The qualified-scan fallback: the 0/1/>1 rule over the module_symbols
# entries whose key IS the bare "Type::method" (the root module's
# registration) or ends with "::Type::method", filtered to DefKind::Method
# and deduplicated by DefId. 0 -> None, exactly 1 -> that DefId, >= 2 ->
# None (ambiguous — a silent first-wins pick is never made).
def scan_qualified_method_def(env: TypeEnv, key: String) -> Option[DefId]
  match env.resolutions
  when Option::Some(res) then
    var found: Option[DefId] = Option::None
    var count = 0
    let suffix = "::" + key.clone()
    for (ms_key, ms_did) in res.module_symbols.entries() do
      var matches = false
      if ms_key == key.clone() then
        matches = true
      elsif ms_key.ends_with(suffix) then
        matches = true
      end
      if matches then
        match def_kind_of(&res, &ms_did)
        when Option::Some(k) then
          if k == DefKind::Method then
            var dup = false
            match found
            when Option::Some(fd) then
              if fd.module.id == ms_did.module.id && fd.index == ms_did.index then dup = true end
            when Option::None then ()
            end
            if !dup then
              count = count + 1
              found = Option::Some(ms_did.clone())
            end
          end
        when Option::None then ()
        end
      end
    end
    if count == 1 then found else Option::None end
  when Option::None then Option::None
  end  end
end

# The resolver's registered key of an impl method, from the IMPL's
# CONCRETE for_type — mirroring the resolver's type_expr_to_string
# rendering ("TypeName" or "TypeName[...]" for a generic for_type, plus
# "::method"; a Param for_type keys by its parameter name — the
# extension-impl shape "I::map").
def impl_method_key_from_type(env: TypeEnv, for_type: Type, method: String) -> String
  match for_type
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, tid)
    when Option::Some(td) then
      let base = if td.generic_params.len() > 0 then td.name.clone() + "[...]" else td.name.clone() end
      base + "::" + method.clone()
    when Option::None then "".to_string()
    end
  when Type::Param(gpid) then
    generic_param_name_of(&env.generic_param_table, gpid) + "::" + method.clone()
  when _ then "".to_string()
  end  end
end

def method_def_for(env: TypeEnv, recv_type: Type, method: String) -> Option[DefId]
  let key = resolver_method_key(env, recv_type, method)
  if key != "" then
    # 1. exact: the receiver type's OWNER registration path + the
    # "Type::method" key.
    match recv_type
    when Type::Adt(tid, _) then
      let path = type_registration_module_path(env, tid)
      match qualified_method_def(env, &path, &key)
      when Option::Some(did) then return Option::Some(did)
      when Option::None then ()
      end
    when _ then ()
    end
    # 2. the qualified-scan fallback (builtin receivers whose method impls
    # live in a std module — String/Int/... and the LangItems compounds —
    # and cross-module impls): the 0/1/>1 rule, never a silent pick.
    match scan_qualified_method_def(env, &key)
    when Option::Some(did) then return Option::Some(did)
    when Option::None then ()
    end
  end
 # extension-impl methods — the receiver-based key cannot match an
  # impl whose for_type is a generic parameter (the resolver registered the
  # method under the parameter's own key, e.g. "I[...]::map"). Reconstruct
  # the key from the param-for_type impl and resolve it through the same
  # semantic registration (the impl's owner path first, then the scan).
  match find_param_for_type_method(env, method)
  when Option::Some((pimp_idx, _)) then
    let pimp = env.impls[pimp_idx]
    let pkey = impl_method_key_from_type(env, &pimp.for_type, &method)
    if pkey == "" then
      Option::None
    else
      match qualified_method_def(env, &env.current_module_path, &pkey)
      when Option::Some(did) then Option::Some(did)
      when Option::None then scan_qualified_method_def(env, &pkey)
      end
    end
  when Option::None then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# The SIMD INTRINSIC SUB-DOMAIN — the vector operations of the
# IntrinsicId domain
# ———————————————————————————————————————————————————————————————
# The SIMD intrinsics (the `__intrinsic_simd_<op>_<lane>` family —
# std/simd.tg's vector surface) are a NAME-ROUTED sub-domain of the
# semantic IntrinsicId classification: the KIND enum below names the
# machine operation the name denotes (the same role IntrinsicId plays for
# the scalar intrinsics), and the router (simd_intrinsic_kind_of) is the
# ONE name -> kind classification. The checker's call-recording and
# codegen's dispatch both read this sub-domain; the IntrinsicId carried in
# typed_intrinsics for a SIMD name is the FormatterNoOp marker (a
# classified-but-inlined-elsewhere id — the SIMD arms inline their own
# machine emission and never reach the IntrinsicId dispatch).
#
# The supported operation subset (the codegen arms — NEON + SSE/AVX):
#   add / sub / mul / and / or / xor / load / store / shuffle
# per lane width (the lane spelling in the name: f32x4, f64x2, i8x16,
# i16x8, i32x4, i64x2, f32x8, i32x8, f64x4, i64x4, i16x16, i8x32 and the
# 512-bit Vec16 forms f32x16/i32x16/f64x8/i64x8/i16x32/i8x64). An
# operation the current arms do not lower (per the documented supported
# subset — e.g. the 512-bit arithmetic, the i64 lane multiply) fails
# closed at codegen, never a silent scalar fallback.

enum SimdIntrinsicKind
  SimdAdd
  SimdSub
  SimdMul
  SimdAnd
  SimdOr
  SimdXor
  SimdLoad
  SimdStore
  SimdShuffle
end

# The SIMD lane shapes — the lane spelling parsed from the intrinsic
# name's trailing `_<lane>` segment.
enum SimdLane
  F32x4
  F64x2
  I8x16
  I16x8
  I32x4
  I64x2
  F32x8
  I32x8
  F64x4
  I64x4
  I16x16
  I8x32
  F32x16
  I32x16
  F64x8
  I64x8
  I16x32
  I8x64
end

# The vector width of a lane shape (128/256/512 bits).
def simd_lane_width(lane: SimdLane) -> Int
  match lane
  when F32x4 | F64x2 | I8x16 | I16x8 | I32x4 | I64x2 then 128
  when F32x8 | I32x8 | F64x4 | I64x4 | I16x16 | I8x32 then 256
  when F32x16 | I32x16 | F64x8 | I64x8 | I16x32 | I8x64 then 512
  end  end
end

# The lane element width in bytes (1/2/4/8).
def simd_lane_elem_size(lane: SimdLane) -> Int
  match lane
  when I8x16 | I8x32 | I8x64 then 1
  when I16x8 | I16x16 | I16x32 then 2
  when F32x4 | I32x4 | F32x8 | I32x8 | F32x16 | I32x16 then 4
  when F64x2 | I64x2 | F64x4 | I64x4 | F64x8 | I64x8 then 8
  end  end
end

# The lane count of a lane shape.
def simd_lane_count(lane: SimdLane) -> Int
  simd_lane_width(lane) / (simd_lane_elem_size(lane) * 8)
end

# Whether the lane shape is a floating-point lane.
def simd_lane_is_float(lane: SimdLane) -> Bool
  match lane
  when F32x4 | F64x2 | F32x8 | F64x4 | F32x16 | F64x8 then true
  when _ then false
  end  end
end

# Parse the `_<lane>` spelling ("f32x4", "i64x2", ...) into the lane
# shape; Option::None for an unknown spelling.
def parse_simd_lane(s: String) -> Option[SimdLane]
  if s == "f32x4" then Option::Some(SimdLane::F32x4)
  elsif s == "f64x2" then Option::Some(SimdLane::F64x2)
  elsif s == "i8x16" then Option::Some(SimdLane::I8x16)
  elsif s == "i16x8" then Option::Some(SimdLane::I16x8)
  elsif s == "i32x4" then Option::Some(SimdLane::I32x4)
  elsif s == "i64x2" then Option::Some(SimdLane::I64x2)
  elsif s == "f32x8" then Option::Some(SimdLane::F32x8)
  elsif s == "i32x8" then Option::Some(SimdLane::I32x8)
  elsif s == "f64x4" then Option::Some(SimdLane::F64x4)
  elsif s == "i64x4" then Option::Some(SimdLane::I64x4)
  elsif s == "i16x16" then Option::Some(SimdLane::I16x16)
  elsif s == "i8x32" then Option::Some(SimdLane::I8x32)
  elsif s == "f32x16" then Option::Some(SimdLane::F32x16)
  elsif s == "i32x16" then Option::Some(SimdLane::I32x16)
  elsif s == "f64x8" then Option::Some(SimdLane::F64x8)
  elsif s == "i64x8" then Option::Some(SimdLane::I64x8)
  elsif s == "i16x32" then Option::Some(SimdLane::I16x32)
  elsif s == "i8x64" then Option::Some(SimdLane::I8x64)
  else Option::None
  end
end

# The SIMD intrinsic name test: a name is a SIMD intrinsic exactly when
# its `simd_<op>_<lane>` shape classifies. The __intrinsic_ prefix is
# stripped first (the checker routes the full prefixed spelling; codegen
# routes the bare spelling).
def simd_intrinsic_kind_of(name: String) -> Option[SimdIntrinsicKind]
  var bare = name.clone()
  if bare.len() >= 12 && bare.slice(0, 12) == "__intrinsic_" then
    bare = bare.slice(12, bare.len())
  end
  if !bare.starts_with("simd_") then return Option::None end
  let rest = bare.slice(5, bare.len())
  # <op>_<lane>: split at the LAST underscore (the lane spelling has no
  # underscores).
  match rest.rfind("_")
  when Option::Some(pos) then
    let op = rest.slice(0, pos)
    let lane_s = rest.slice(pos + 1, rest.len())
    match parse_simd_lane(lane_s)
    when Option::Some(_) then ()
    when Option::None then return Option::None
    end
    match op
    when "add" then Option::Some(SimdIntrinsicKind::SimdAdd)
    when "sub" then Option::Some(SimdIntrinsicKind::SimdSub)
    when "mul" then Option::Some(SimdIntrinsicKind::SimdMul)
    when "and" then Option::Some(SimdIntrinsicKind::SimdAnd)
    when "or" then Option::Some(SimdIntrinsicKind::SimdOr)
    when "xor" then Option::Some(SimdIntrinsicKind::SimdXor)
    when "load" then Option::Some(SimdIntrinsicKind::SimdLoad)
    when "store" then Option::Some(SimdIntrinsicKind::SimdStore)
    when "shuffle" then Option::Some(SimdIntrinsicKind::SimdShuffle)
    when _ then Option::None
    end
  when Option::None then Option::None
  end
end

# The lane shape of a classified SIMD intrinsic name (None for a
# non-SIMD name — the caller must have classified it first).
def simd_intrinsic_lane_of(name: String) -> Option[SimdLane]
  var bare = name.clone()
  if bare.len() >= 12 && bare.slice(0, 12) == "__intrinsic_" then
    bare = bare.slice(12, bare.len())
  end
  if !bare.starts_with("simd_") then return Option::None end
  let rest = bare.slice(5, bare.len())
  match rest.rfind("_")
  when Option::Some(pos) then parse_simd_lane(rest.slice(pos + 1, rest.len()))
  when Option::None then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# The SEMANTIC INTRINSIC ROUTER (IntrinsicId at check time)
# ———————————————————————————————————————————————————————————————
# The ONE name -> IntrinsicId classification (moved out of codegen.tg —
# the frontend attaches the semantic IntrinsicId at call-recording time;
# the typed program carries the per-call classification, and codegen's
# dispatch reads the same router instead of holding its own name table).
# The classifier is keyed on the callee name plus the TYPED receiver and
# needle facts (the type-directed aliases — entries/drain_one/contains —
# are decided from the receiver's registered name and the string-ness of
# the receiver/needle). Option::None = the name is NOT an intrinsic name
# (a compiled callable); the checker records only the classified calls,
# and codegen's dispatch treats None as the non-intrinsic path.
# The receiver-side string test for the String-method classification: the
# checker types string literals as Type::String; the MIR/codegen operand
# facts add the static StaticStrPtr form and the borrowed &String/&str
# forms.
def router_receiver_is_string(receiver_ty: Type, receiver_is_string: Bool) -> Bool
  if receiver_is_string then return true end
  match receiver_ty
  when Type::String then true
  when Type::StaticStrPtr then true
  when Type::RefInternal(inner, _) then
    match inner
    when Type::String then true
    when Type::StaticStrPtr then true
    when _ then false
    end
  when _ then false
  end
end

# The receiver-side collection test for the collection-method
# classification: the heap-vector Adt (the registered name "Array"), the
# std Vec struct, and the RAW view (UnsafeSlice — the builtin).
def router_receiver_is_collection(receiver_named: String) -> Bool
  receiver_named == "Array" || receiver_named == "Vec" || receiver_named == "UnsafeSlice"
end

pub def intrinsic_id_of_call(
  name: String,
  receiver_ty: Type,
  receiver_named: String,
  needle_ty: Type,
  needle_named: String,
  orig_fn_name: String,
  receiver_is_string: Bool,
  needle_is_string: Bool
) -> Option[IntrinsicId]
  if name == "__intrinsic_regex_match" then return Option::Some(IntrinsicId::RegexMatch) end
  if name == "__intrinsic_type_probe" then return Option::Some(IntrinsicId::TypeProbe) end
  if name == "__intrinsic_ast_probe" then return Option::Some(IntrinsicId::AstProbe) end
  let orig_is_string_contains =
    orig_fn_name == "String__contains" ||
    orig_fn_name == "string_contains" ||
    orig_fn_name == "__intrinsic_string_contains" ||
    orig_fn_name == "str_contains"

  # THE SIMD SUB-DOMAIN: a SIMD intrinsic name (__intrinsic_simd_<op>_<lane>
  # or its bare simd_<op>_<lane> spelling) classifies through the SIMD
  # router — the vector operations of the IntrinsicId domain. The
  # classification is recorded so the call is NOT a phantom intrinsic; the
  # codegen inlines the machine emission from the SIMD kind (the
  # FormatterNoOp marker id is never dispatched to: the SIMD gate in
  # codegen_intrinsic routes the name before the IntrinsicId match).
  match simd_intrinsic_kind_of(&name)
  when Option::Some(_) then
    return Option::Some(IntrinsicId::FormatterNoOp)
  when Option::None then ()
  end

  # Type-directed aliases
  if name == "entries" then
    if receiver_named == "Set" then return Option::Some(IntrinsicId::SetEntries)
    else return Option::Some(IntrinsicId::MapEntries)
    end
  end
  if name == "drain_one" then
    if receiver_named == "Set" then return Option::Some(IntrinsicId::SetDrainOne)
    else return Option::Some(IntrinsicId::MapDrainOne)
    end
  end
  if name == "contains" then
    match receiver_ty
    when Type::String then return Option::Some(IntrinsicId::StringContains)
    when _ then ()
    end
    if receiver_named == "Map" then return Option::Some(IntrinsicId::MapContains)
    elsif receiver_named == "Set" then return Option::Some(IntrinsicId::SetContains)
    else ()
    end
    if orig_is_string_contains || receiver_is_string || needle_is_string then
      return Option::Some(IntrinsicId::StringContains)
    else
      return Option::Some(IntrinsicId::ArrayContains)
    end
  end
  if name == "array_contains" then
    if orig_is_string_contains || receiver_is_string || needle_is_string then
      return Option::Some(IntrinsicId::StringContains)
    else
      return Option::Some(IntrinsicId::ArrayContains)
    end
  end

  # Array/Vec
  if name == "array_as_ptr_address" || name == "as_ptr_address" then return Option::Some(IntrinsicId::ArrayAsPtrAddress) end
  if name == "read_file_to_string_native" then return Option::Some(IntrinsicId::ReadFileToStringNative) end
  if name == "set_is_empty" then return Option::Some(IntrinsicId::SetIsEmpty) end
  if name == "map_push" then return Option::Some(IntrinsicId::MapPush) end
  if name == "array_replace" then return Option::Some(IntrinsicId::ArrayReplace) end
  if name == "array_as_str" then return Option::Some(IntrinsicId::ArrayAsStr) end
  if name == "array_push" || name == "push" then return Option::Some(IntrinsicId::ArrayPush) end
  if name == "string_push" then return Option::Some(IntrinsicId::StringPush) end
  if name == "string_push_str" then return Option::Some(IntrinsicId::StringPushStr) end
  if name == "array_pop" || name == "pop" then return Option::Some(IntrinsicId::ArrayPop) end
  if name == "array_new" then return Option::Some(IntrinsicId::ArrayNew) end
  if name == "string_new" || name == "String__new" then return Option::Some(IntrinsicId::StringNew) end
  if name == "array_with_capacity" then return Option::Some(IntrinsicId::ArrayWithCapacity) end
  if name == "array_len" then return Option::Some(IntrinsicId::ArrayLen) end
  if name == "array_get" || name == "get" then return Option::Some(IntrinsicId::ArrayGet) end
  if name == "array_set" || name == "set" then return Option::Some(IntrinsicId::ArraySet) end
  if name == "array_cap" || name == "cap" then return Option::Some(IntrinsicId::ArrayCap) end
  if name == "array_remove" || name == "remove" then return Option::Some(IntrinsicId::ArrayRemove) end
  if name == "array_insert" || name == "insert" then return Option::Some(IntrinsicId::ArrayInsert) end
  if name == "array_clear" || name == "clear" then return Option::Some(IntrinsicId::ArrayClear) end
  if name == "array_first" || name == "first" then return Option::Some(IntrinsicId::ArrayFirst) end
  if name == "array_last" || name == "last" then return Option::Some(IntrinsicId::ArrayLast) end
  if name == "array_is_empty" || name == "is_empty" then return Option::Some(IntrinsicId::ArrayIsEmpty) end
  if name == "array_reverse" || name == "reverse" then return Option::Some(IntrinsicId::ArrayReverse) end
  if name == "array_sort" || name == "sort" then return Option::Some(IntrinsicId::ArraySort) end
  if name == "array_extend" || name == "extend" then return Option::Some(IntrinsicId::ArrayExtend) end
  if name == "array_truncate" then return Option::Some(IntrinsicId::ArrayTruncate) end
  if name == "array_resize" then return Option::Some(IntrinsicId::ArrayResize) end
  if name == "array_destroy" then return Option::Some(IntrinsicId::ArrayDestroy) end
  if name == "array_as_ptr" || name == "array_as_mut_ptr" then return Option::Some(IntrinsicId::ArrayAsPtr) end
  if name == "array_slice" then return Option::Some(IntrinsicId::ArraySlice) end
  if name == "array_from_list" then return Option::Some(IntrinsicId::ArrayFromList) end
  if name == "array_capacity" then return Option::Some(IntrinsicId::ArrayCapacity) end
  if name == "array_clone" || name == "Vec__clone" || name == "Array__clone" then return Option::Some(IntrinsicId::Clone) end
  if name == "array_starts_with" || name == "Vec__starts_with" then return Option::Some(IntrinsicId::StartsWith) end
  if name == "array_ends_with" || name == "Vec__ends_with" then return Option::Some(IntrinsicId::StrCmp) end
  if name == "array_to_string" || name == "Vec__to_string" || name == "Array__to_string" then return Option::Some(IntrinsicId::ToString) end
  if name == "array_read" || name == "Vec__read" || name == "Array__read" then return Option::Some(IntrinsicId::Clone) end
  if name == "array_join" || name == "Vec__join" || name == "Array__join" then return Option::Some(IntrinsicId::ArrayJoin) end

  # Map
  if name == "map_new" then return Option::Some(IntrinsicId::MapNew) end
  if name == "map_insert" then return Option::Some(IntrinsicId::MapInsert) end
  if name == "map_get" || name == "map_get_mut" || name == "get_mut" then return Option::Some(IntrinsicId::MapGet) end
  if name == "map_remove" then return Option::Some(IntrinsicId::MapRemove) end
  if name == "map_remove_key" then return Option::Some(IntrinsicId::MapRemoveKey) end
  if name == "option_wrap" then return Option::Some(IntrinsicId::OptionWrap) end
  if name == "map_contains" || name == "map_contains_key" || name == "contains_key" then return Option::Some(IntrinsicId::MapContains) end
  if name == "map_len" then return Option::Some(IntrinsicId::MapLen) end
  if name == "map_clone" || name == "Map__clone" then return Option::Some(IntrinsicId::MapClone) end
  if name == "map_clear" then return Option::Some(IntrinsicId::MapClear) end
  if name == "map_keys" || name == "keys" then return Option::Some(IntrinsicId::MapKeys) end
  if name == "map_values" || name == "values" then return Option::Some(IntrinsicId::MapValues) end
  if name == "map_entries" then return Option::Some(IntrinsicId::MapEntries) end
  if name == "map_drain_one" then return Option::Some(IntrinsicId::MapDrainOne) end
  if name == "map_destroy" then return Option::Some(IntrinsicId::MapDestroy) end
  if name == "map_unwrap" || name == "Map__unwrap" then return Option::Some(IntrinsicId::Unwrap) end

  # Set
  if name == "set_new" then return Option::Some(IntrinsicId::SetNew) end
  if name == "set_insert" then return Option::Some(IntrinsicId::SetInsert) end
  if name == "set_contains" then return Option::Some(IntrinsicId::SetContains) end
  if name == "set_remove" then return Option::Some(IntrinsicId::SetRemove) end
  if name == "set_remove_key" then return Option::Some(IntrinsicId::SetRemoveKey) end
  if name == "set_len" then return Option::Some(IntrinsicId::SetLen) end
  if name == "set_clone" || name == "Set__clone" then return Option::Some(IntrinsicId::SetClone) end
  if name == "set_entries" then return Option::Some(IntrinsicId::SetEntries) end
  if name == "set_drain_one" then return Option::Some(IntrinsicId::SetDrainOne) end
  if name == "set_destroy" then return Option::Some(IntrinsicId::SetDestroy) end
  if name == "set_clear" then return Option::Some(IntrinsicId::SetClear) end
  if name == "set_unwrap" || name == "Set__unwrap" then return Option::Some(IntrinsicId::Unwrap) end

  # String
  if name == "string_char_at" then return Option::Some(IntrinsicId::CharAt) end
  if name == "string_slice" then return Option::Some(IntrinsicId::StrSlice) end
  if name == "slice" then
    # The TYPE-DIRECTED slice route: a string-ish receiver is the owned
    # String slice (StrSlice); a collection receiver (Array/Vec/Slice) is
    # the owned-Vec span copy (ArraySlice). A non-container receiver is
    # NOT an intrinsic (a compiled method call).
    if router_receiver_is_string(receiver_ty, receiver_is_string) then return Option::Some(IntrinsicId::StrSlice) end
    if router_receiver_is_collection(receiver_named) then return Option::Some(IntrinsicId::ArraySlice) end
  end
  if name == "string_len" then return Option::Some(IntrinsicId::StringLen) end
  if name == "string_hash" then return Option::Some(IntrinsicId::StringHash) end
  if name == "len" || name == "IfStmt__len" then return Option::Some(IntrinsicId::Len) end
  if name == "string_parse_int" || name == "parse_int" then return Option::Some(IntrinsicId::StrToInt) end
  if name == "str_parse_float" || name == "String__parse_float" || name == "__intrinsic_string_parse_float" then return Option::Some(IntrinsicId::StrToFloat) end
  if name == "string_clone" || name == "String__clone" then return Option::Some(IntrinsicId::StringClone) end
  if name == "string_is_empty" || name == "string_chars" then return Option::Some(IntrinsicId::StringIsEmptyChars) end
  if name == "string_as_bytes" then return Option::Some(IntrinsicId::AsBytes) end
  if name == "string_as_ptr" || name == "String__as_ptr" then return Option::Some(IntrinsicId::StringAsPtr) end
  if name == "string_as_str" || name == "String__as_str" then return Option::Some(IntrinsicId::StringAsStr) end
  if name == "string_from_static" || name == "__intrinsic_string_from_static" || name == "String__from_static" then return Option::Some(IntrinsicId::StringFromStatic) end
  if name == "string_reserve" || name == "__intrinsic_string_reserve" then return Option::Some(IntrinsicId::StringReserve) end
  if name == "string_to_wide_string" || name == "string_to_string" then return Option::Some(IntrinsicId::ToString) end
  if name == "string_starts_with" then return Option::Some(IntrinsicId::StartsWith) end
  if name == "string_ends_with" then return Option::Some(IntrinsicId::EndsWith) end
  if name == "string_index_of" || name == "string_last_index_of" || name == "string_rfind" then return Option::Some(IntrinsicId::StrFind) end
  if name == "string_find" || name == "find" then return Option::Some(IntrinsicId::StrFind) end
  if name == "string_trim" || name == "string_trim_matches" then return Option::Some(IntrinsicId::StringTrim) end
  if name == "string_to_lowercase" || name == "string_to_uppercase" then return Option::Some(IntrinsicId::StringToLowercase) end
  if name == "string_contains" then return Option::Some(IntrinsicId::StringContains) end
  if name == "string_replace" then return Option::Some(IntrinsicId::StringReplace) end
  if name == "replace" then
    # Type-directed: the replace on a string-ish receiver is the owned
    # byte-pattern replacement (StringReplace); a non-string receiver is
    # NOT an intrinsic (a compiled method call).
    if router_receiver_is_string(receiver_ty, receiver_is_string) then return Option::Some(IntrinsicId::StringReplace) end
  end
  if name == "string_split" then return Option::Some(IntrinsicId::StringSplit) end
  if name == "string_lines" then return Option::Some(IntrinsicId::StringSplitLines) end
  if name == "string_split_once" then return Option::Some(IntrinsicId::SplitOnce) end
  if name == "string_bytes" then return Option::Some(IntrinsicId::Bytes) end
  if name == "string_unwrap_or" || name == "String__unwrap_or" then return Option::Some(IntrinsicId::UnwrapOr) end
  if name == "bytes" then return Option::Some(IntrinsicId::AsBytes) end

  # Option/Result and iterator methods
  if name == "is_some" || name == "is_ok" then return Option::Some(IntrinsicId::IsSome) end
  if name == "is_none" || name == "is_err" then return Option::Some(IntrinsicId::IsNone) end
  if name == "unwrap" then return Option::Some(IntrinsicId::Unwrap) end
  if name == "unwrap_or" then return Option::Some(IntrinsicId::UnwrapOr) end
  if name == "trim_matches" then
    # Type-directed: the String-object trim_matches is the implemented
    # StringTrim path (_tg_string_trim_matches); a non-string receiver is
    # NOT an intrinsic (a compiled method call).
    if router_receiver_is_string(receiver_ty, receiver_is_string) then return Option::Some(IntrinsicId::StringTrim) end
  end
  if name == "split_once" then
    # The bare `split_once` method is NOT classified: the std String::split_once
    # body implements it through find() + slice() (both implemented
    # intrinsics), so the call compiles as a normal method call. The
    # explicit `string_split_once` intrinsic spelling stays classified to
    # SplitOnce (the checker's defensive "use find + slice instead"
    # diagnostic for the intrinsic form).
    ()
  end
  if name == "to_bits" then return Option::Some(IntrinsicId::Clone) end
  if name == "to_lowercase" then
    if router_receiver_is_string(receiver_ty, receiver_is_string) then return Option::Some(IntrinsicId::StringToLowercase) end
  end
  if name == "to_uppercase" then
    if router_receiver_is_string(receiver_ty, receiver_is_string) then return Option::Some(IntrinsicId::StringToLowercase) end
  end
  if name == "arg" || name == "eval" then return Option::Some(IntrinsicId::Clone) end
  # map/join/collect are COMPILED methods with real std bodies (Option::map,
  # Result::map, Iterator::join/collect, Array::join) — never classified as
  # intrinsics (the codegen resolves them as normal method calls).
  if name == "split" then
    if router_receiver_is_string(receiver_ty, receiver_is_string) then return Option::Some(IntrinsicId::StringSplit) end
  end
  if name == "lines" then
    if router_receiver_is_string(receiver_ty, receiver_is_string) then return Option::Some(IntrinsicId::StringSplitLines) end
  end
  if name == "trim" then
    if router_receiver_is_string(receiver_ty, receiver_is_string) then return Option::Some(IntrinsicId::StringTrim) end
  end
  if name == "starts_with" then return Option::Some(IntrinsicId::StartsWith) end
  if name == "ends_with" then return Option::Some(IntrinsicId::EndsWith) end

  # Type__method variants for compiler-internal types
  if name == "PanicInfo__clone" || name == "TypeExpr__clone" || name == "Span__clone" then return Option::Some(IntrinsicId::Clone) end
  if name == "MirProgram__to_string" || name == "Type__to_string" then return Option::Some(IntrinsicId::ToString) end
  if name == "Type__clone" || name == "Type__collect" || name == "Type__unwrap" then return Option::Some(IntrinsicId::Clone) end
  if name == "InlineResult__unwrap_or" || name == "MirStatement__unwrap_or" || name == "Place__unwrap_or" then return Option::Some(IntrinsicId::UnwrapOr) end
  if name == "MirRvalue__collect" || name == "MirRvalue__unwrap_or" || name == "MirTerminator__unwrap_or" then return Option::Some(IntrinsicId::Clone) end
  if name == "PgoProfile__unwrap_or" then return Option::Some(IntrinsicId::UnwrapOr) end
  if name == "MirLocalId__clone" || name == "MirBlockId__clone" || name == "MirFunction__clone" then return Option::Some(IntrinsicId::Clone) end
  if name == "MirStatement__clone" || name == "MirRvalue__clone" || name == "AggregateKind__clone" then return Option::Some(IntrinsicId::Clone) end
  if name == "MirTerminatorKind__clone" || name == "AsmTarget__clone" then return Option::Some(IntrinsicId::Clone) end
  if name == "Budget__unwrap_or" || name == "Budget__trim" then return Option::Some(IntrinsicId::UnwrapOr) end

  # CString intrinsics (String = raw C string at ABI level)
  if name == "cstring_new" || name == "CString__new" then return Option::Some(IntrinsicId::CStringNew) end
  if name == "cstring_as_ptr" || name == "CString__as_ptr" then return Option::Some(IntrinsicId::CStringAsPtr) end

  # Canonical string ops
  if name == "str_concat" then return Option::Some(IntrinsicId::StrConcat) end
  if name == "str_len" then return Option::Some(IntrinsicId::StrLen) end
  if name == "str_cmp" then return Option::Some(IntrinsicId::StrCmp) end
  if name == "str_find" then return Option::Some(IntrinsicId::StrFind) end
  if name == "str_slice" then return Option::Some(IntrinsicId::StrSlice) end
  if name == "str_copy" then return Option::Some(IntrinsicId::StrCopy) end
  if name == "str_to_int" then return Option::Some(IntrinsicId::StrToInt) end
  if name == "str_to_float" then return Option::Some(IntrinsicId::StrToFloat) end
  if name == "int_to_str" then return Option::Some(IntrinsicId::IntToStr) end
  if name == "float_to_str" then return Option::Some(IntrinsicId::FloatToStr) end
  if name == "int_to_string" || name == "int_to_string_intrinsic" then return Option::Some(IntrinsicId::IntToString) end
  if name == "float_to_string" || name == "float_to_string_intrinsic" then return Option::Some(IntrinsicId::FloatToString) end
  if name == "bool_to_string" then return Option::Some(IntrinsicId::BoolToString) end
  if name == "char_to_string" then return Option::Some(IntrinsicId::CharToString) end
  if name == "str_to_string" then return Option::Some(IntrinsicId::StrToString) end
  if name == "string_from_bytes" then return Option::Some(IntrinsicId::StringFromBytes) end
  if name == "to_string" then return Option::Some(IntrinsicId::ToString) end
  if name == "clone" then return Option::Some(IntrinsicId::Clone) end
  if name == "as_bytes" then return Option::Some(IntrinsicId::AsBytes) end
  if name == "as_ptr" then return Option::Some(IntrinsicId::AsPtr) end
  if name == "as_str" then return Option::Some(IntrinsicId::AsStr) end
  if name == "chars" then return Option::Some(IntrinsicId::Chars) end
  if name == "char_at" then return Option::Some(IntrinsicId::CharAt) end

  # Syscalls (1-6 arguments)
  if name == "syscall1" then return Option::Some(IntrinsicId::Syscall1) end
  if name == "syscall2" then return Option::Some(IntrinsicId::Syscall2) end
  if name == "syscall3" then return Option::Some(IntrinsicId::Syscall3) end
  if name == "syscall4" then return Option::Some(IntrinsicId::Syscall4) end
  if name == "syscall5" then return Option::Some(IntrinsicId::Syscall5) end
  if name == "syscall6" then return Option::Some(IntrinsicId::Syscall6) end

  # Memory
  if name == "mem_alloc" then return Option::Some(IntrinsicId::MemAlloc) end
  if name == "mem_free" then return Option::Some(IntrinsicId::MemFree) end
  if name == "mem_copy" then return Option::Some(IntrinsicId::MemCopy) end
  if name == "mem_set" then return Option::Some(IntrinsicId::MemSet) end
  if name == "mem_zero" then return Option::Some(IntrinsicId::MemZero) end

  # Hash
  if name == "hash_int" then return Option::Some(IntrinsicId::HashInt) end
  if name == "hash_str" then return Option::Some(IntrinsicId::HashStr) end
  if name == "hash_combine" then return Option::Some(IntrinsicId::HashCombine) end

  # Typed drop glue
  if name == "drop_in_place" then return Option::Some(IntrinsicId::DropInPlace) end
  if name == "drop" then return Option::Some(IntrinsicId::Drop) end

  # Process/Environment
  if name == "status" then return Option::Some(IntrinsicId::Status) end
  if name == "output" then return Option::Some(IntrinsicId::Output) end
  if name == "stdout_string" then return Option::Some(IntrinsicId::StdoutString) end
  if name == "stderr_string" then return Option::Some(IntrinsicId::StderrString) end

  # Formatter intrinsics (compile-time constructs, no runtime code)
  if name == "emit" || name == "space" || name == "indent" || name == "dedent" then return Option::Some(IntrinsicId::FormatterNoOp) end
  if name == "emit_newline" || name == "emit_blank_line" then return Option::Some(IntrinsicId::FormatterEmitNewline) end
  if name == "would_overflow" then return Option::Some(IntrinsicId::WouldOverflow) end

  # Utility
  if name == "cmp" then return Option::Some(IntrinsicId::Cmp) end
  if name == "to_int" then return Option::Some(IntrinsicId::ToInt) end
  if name == "lint_file" then return Option::Some(IntrinsicId::LintFile) end

  # File constants
  if name == "SYS_WRITE" then return Option::Some(IntrinsicId::SysWrite) end
  if name == "SYS_READ" then return Option::Some(IntrinsicId::SysRead) end
  if name == "SYS_OPEN" then return Option::Some(IntrinsicId::SysOpen) end
  if name == "SYS_CLOSE" then return Option::Some(IntrinsicId::SysClose) end
  if name == "SYS_EXIT" then return Option::Some(IntrinsicId::SysExit) end
  if name == "O_WRONLY" then return Option::Some(IntrinsicId::OWriteOnly) end
  if name == "O_RDWR" then return Option::Some(IntrinsicId::ORdWr) end
  if name == "O_APPEND" then return Option::Some(IntrinsicId::OAppend) end
  if name == "O_CREAT" then return Option::Some(IntrinsicId::OCreate) end
  if name == "O_TRUNC" then return Option::Some(IntrinsicId::OTrunc) end
  if name == "open_windows" then return Option::Some(IntrinsicId::OpenWindows) end

  Option::None
end

# The fail-closed classification (the checker's attachment and codegen's
# final dispatch): a name the semantic router does not recognize is an
# internal error — never a silent fallback.
pub def classify_intrinsic_call(
  name: String,
  receiver_ty: Type,
  receiver_named: String,
  needle_ty: Type,
  needle_named: String,
  orig_fn_name: String,
  receiver_is_string: Bool,
  needle_is_string: Bool
) -> IntrinsicId
  match intrinsic_id_of_call(name, receiver_ty, receiver_named, needle_ty, needle_named, orig_fn_name, receiver_is_string, needle_is_string)
  when Option::Some(iid) then iid
  when Option::None then panic("internal error: unknown or unsupported intrinsic `" + name + "`")
  end
end

# The bare registered name of a receiver Adt (the type-directed alias
# decisions — Set/Map — key on the REGISTERED name, e.g. the std's "Array"
# for the heap vector).
def type_bare_name_of(env: TypeEnv, ty: Type) -> String
  match ty
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, tid)
    when Option::Some(td) then td.name.clone()
    when Option::None then "".to_string()
    end
  when _ then "".to_string()
  end  end
end

# Whether the receiver of a method call is a BUILTIN container (the
# primitive String or a LangItems compound) — the receiver gate for the
# checker's intrinsic attachment (a user method on a user type never
# classifies as an intrinsic).
def receiver_is_builtin_container(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::String then true
  when Type::Adt(tid, _) then
    tid.id == env.lang_items.array || tid.id == env.lang_items.map ||
    tid.id == env.lang_items.set || tid.id == env.lang_items.option ||
    tid.id == env.lang_items.result || tid.id == env.lang_items.slice ||
    tid.id == env.lang_items.box_ || tid.id == env.lang_items.rc
  when _ then false
  end  end
end

# The checker's call-recording attachment: classify the callee through the
# semantic router and record the IntrinsicId per call node in the typed
# program (typed_intrinsics; serialized into the resolutions snapshot at
# type_check_typed's tail). Only the intrinsic candidates attach: the
# explicit __intrinsic_* family and the builtin-container method calls.
# (unsupported surfaces): an operation the router classifies but the
# backend does not implement is REJECTED HERE with an explicit
# "unsupported: use X instead" diagnostic — never a silent backend panic
# (the recorded error aborts compilation before codegen; the codegen arms
# for these ids are the defensive last line only).
# (THE INTRINSIC-NAME GATE — the phantom closure): an explicit __intrinsic_*
# call whose name the semantic router does NOT classify is a HARD compile
# error — a phantom intrinsic name can never silently type-check (the
# resolver's synthetic DefKind::Intrinsic registration is metadata only;
# the classification is the ONE implementation authority). The
# gate_pending_intrinsic_name exemption is the enumerated set of legacy
# phantoms that predate the gate — each is flagged by
# scripts/check_intrinsic_closure.sh as a known exception and must be
# resolved; every OTHER unknown name fails compilation here, before
# MIR/codegen.
def record_intrinsic_classification(
  inout env: TypeEnv,
  call_node_id: Int,
  callee_name: String,
  receiver_ty: Type,
  needle_ty: Type,
  orig_fn_name: String,
  span: Span
) -> Unit
  if call_node_id == 0 then return end
  let receiver_is_string = match receiver_ty
  when Type::String then true
  when _ then false
  end
  let needle_is_string = match needle_ty
  when Type::String then true
  when Type::RefInternal(inner, _) then
    match inner
    when Type::String then true
    when _ then false
    end
  when _ then false
  end
  let is_explicit = callee_name.starts_with("__intrinsic")
  if is_explicit || receiver_is_builtin_container(env, receiver_ty) then
    match intrinsic_id_of_call(callee_name, receiver_ty, &type_bare_name_of(env, receiver_ty), needle_ty, &type_bare_name_of(env, needle_ty), orig_fn_name, receiver_is_string, needle_is_string)
    when Option::Some(iid) then
      env.typed_intrinsics.insert(call_node_id, iid)
      match iid
      when IntrinsicId::SplitOnce then
        type_add_error(env, "unsupported: `string_split_once` is not implemented as an intrinsic — use the std String::split_once method (find() + slice()) instead", span)
      when IntrinsicId::StringIsEmptyChars then
        type_add_error(env, "unsupported: `string_is_empty`/`string_chars` is not implemented as an intrinsic — use is_empty() / len() == 0 instead", span)
      when IntrinsicId::MapJoinCollect then
        type_add_error(env, "unsupported: the `map`/`join`/`collect` intrinsic is not implemented — use the std Option/Result/Iterator/Array methods instead", span)
      when IntrinsicId::SplitLinesTrim then
        type_add_error(env, "unsupported: the `split`/`lines`/`trim` intrinsic is not implemented — use the std String methods instead", span)
      when IntrinsicId::TrimMatches then
        type_add_error(env, "unsupported: the `trim_matches` intrinsic is not implemented — use String::trim_matches instead", span)
      when IntrinsicId::ToLowercase then
        type_add_error(env, "unsupported: the `to_lowercase` intrinsic is not implemented — use String::to_lowercase instead", span)
      when IntrinsicId::ArrayJoin then
        type_add_error(env, "unsupported: the array `join` intrinsic is not implemented — use the std Array::join method instead", span)
      when IntrinsicId::ArrayReplace then
        type_add_error(env, "unsupported: `array_replace` is not implemented as an intrinsic — use the std Array methods instead", span)
      when _ then ()
      end
    when Option::None then
      # THE INTRINSIC-NAME GATE (the phantom closure): an explicit
      # __intrinsic_* call that the semantic router does not classify is
      # the hard compile error — the unknown intrinsic never reaches
      # MIR/codegen (where it would panic as an unresolved callee).
      # The effective classification mirrors codegen's
      # bare_intrinsic_name: the __intrinsic_ prefix is stripped and the
      # bare name re-runs the router (intrinsic_bare_name + the same
      # typed facts). A name whose call target is a DECLARED callable
      # (an extern-declared intrinsic name — the runtime symbol surface
      # — or a user definition carrying the prefix) is implemented.
      # Everything else is the phantom: the hard error.
      if is_explicit then
        if !gate_pending_intrinsic_name(&callee_name) then
          let gate_ok =
            intrinsic_bare_name_classifies(&callee_name, receiver_ty, &type_bare_name_of(env, receiver_ty), needle_ty, &type_bare_name_of(env, needle_ty), orig_fn_name, receiver_is_string, needle_is_string) ||
            call_target_is_declared_callable(env, call_node_id)
          if !gate_ok then
            type_add_error(env, "unknown intrinsic `" + callee_name + "`: the name is not in the semantic intrinsic classification (intrinsic_id_of_call) and has no declared implementation — remove the call or implement the intrinsic", span)
          end
        end
      end
    end
  end
end

# The effective classification for a PREFIXED intrinsic name: the
# __intrinsic_ prefix is stripped (the same normalization codegen's
# bare_intrinsic_name applies) and the bare name runs the semantic
# router over the SAME typed facts. True when the stripped name is a
# classified intrinsic — the call is implemented by the router's
# lowering even though the prefixed spelling is not a router key.
def intrinsic_bare_name_classifies(
  callee_name: String,
  receiver_ty: Type,
  receiver_named: String,
  needle_ty: Type,
  needle_named: String,
  orig_fn_name: String,
  receiver_is_string: Bool,
  needle_is_string: Bool
) -> Bool
  if callee_name.len() < 12 then return false end
  if !callee_name.starts_with("__intrinsic_") then return false end
  let stripped = callee_name.slice(12, callee_name.len())
  match intrinsic_id_of_call(stripped, receiver_ty, &receiver_named, needle_ty, &needle_named, orig_fn_name, receiver_is_string, needle_is_string)
  when Option::Some(_) then true
  when Option::None then false
  end
end

# The declared-callable test for the intrinsic-name gate: the call
# target's DefKind. An extern-declared intrinsic name resolves to its
# extern DefId (DefKind::Function — the runtime provides the symbol); a
# user definition carrying the __intrinsic_ prefix is a Function too
# (its own body is the implementation). The SYNTHETIC runtime-intrinsic
# registration (DefKind::Intrinsic — the resolver's no-candidate
# fallback) marks the un-declared names: implemented by nothing unless
# the router classifies them.
def call_target_is_declared_callable(env: TypeEnv, call_node_id: Int) -> Bool
  match env.typed_call_targets.get(call_node_id)
  when Option::Some(did) then
    match env.resolutions
    when Option::Some(res) then
      match def_kind_of(&res, &did)
      when Option::Some(k) then
        k == DefKind::Function || k == DefKind::Constant || k == DefKind::Static
      when Option::None then false
      end
    when Option::None then false
    end
  when Option::None then false
  end  end
end

# The GATE-PENDING exemption list (the phantom closure): the legacy phantom
# intrinsic names that predate the intrinsic-name gate. Each entry is
# flagged by scripts/check_intrinsic_closure.sh as a known exception and
# MUST be resolved (implemented or removed) in a later round. The list is
# deliberately tiny — the ONLY prelude-reachable legacy phantom is
# std/taint.tg's `__intrinsic_regex_match` (its owning module is outside
# the current scope) — and must NEVER grow: a new intrinsic name
# goes through the classification (intrinsic_id_of_call), never through
# this list.
def gate_pending_intrinsic_name(name: String) -> Option[IntrinsicId]
  if name == "__intrinsic_regex_match" then return Option::Some(IntrinsicId::RegexMatch) end
  if name == "__intrinsic_type_probe" then return Option::Some(IntrinsicId::TypeProbe) end
  if name == "__intrinsic_ast_probe" then return Option::Some(IntrinsicId::AstProbe) end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# Trivial copyability 
# ———————————————————————————————————————————————————————————————
#
# THREE distinct copy/move notions, decided once here:
#   1. BIT-COPY (trivial copy): copying the value's bits is valid and
#      requires NO retain/clone. The DECIDED set: primitives (Int/UInt/
#      Float/Char/Bool and the fixed-width ints/floats), raw Ptr/PtrMut,
#      Unit/Never, and composites (tuples, structs whose fields are all
#      trivially copyable, enums whose payloads are all trivially copyable,
#      Option/Result with trivially-copyable payloads). NOT in the set:
#      String (heap-backed), Vec/Array/Map/Set (heap-backed), Box/Rc/
#      UniquePtr/WeakRc/ArcStrong/WeakArc (owning), resources, capabilities,
#      closures/functions with environments. Slice IS in the set: Slice[T] is
#      the non-owning {ptr,len} view (owns=false, drop=none) — bit-copyable
#      exactly like the std's StrView.
#   2. CLONE (explicit, may allocate): `clone()`. The `Copy` trait is the
#      source-level marker on the raw-read APIs; a Copy obligation is
#      satisfied by an explicit `impl Copy for T` in the registry OR by
#      bit-copyability — the solver checks the registry first, then falls
#      back to the structural property below (see solve_obligation_depth).
#   3. MOVE/SINK (transfer): transferring ownership does not copy; the
#      resource checker's linearity rules govern moves.
#
# The memoized type-property engine (type_properties_of) computes a
# superset of this analysis over the whole type graph.

pub def is_trivially_copyable(env: TypeEnv, ty: Type) -> Bool
  var visited = Set::new()
  is_trivially_copyable_walk(env, ty, &mut visited)
end

# Structural walk over the env's type tables (get_type_by_id + TypeDef
# fields/variants; the built-in names decide directly — canonical Type
# variants are the fast path). The visited set is keyed by the canonical
# structural identity (type_identity_key_resolved — concrete args included),
# so recursion through INLINE storage (structs, enums, ALIASES — including
# alias cycles) terminates by failing closed: a Visiting identity means the
# type is infinitely sized — never bit-copyable. There is NO depth-based
# semantic shortcut: a deep-but-finite chain is walked to its concrete
# leaves and classified by them (the memoized type-property engine
# supersedes the old defensive depth bound with this real cycle detection).
def is_trivially_copyable_walk(env: TypeEnv, ty: Type, inout visited: Set[String]) -> Bool
  match ty
  when Type::Unit then true
  when Type::Bool then true
  when Type::Int then true
  when Type::UInt then true
  when Type::Float then true
  when Type::Char then true
  when Type::Never then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::Ptr(_) then true
  when Type::PtrMut(_) then true
  when Type::Tuple(fields) then
    var i = 0
    while i < fields.len() do
      if !is_trivially_copyable_walk(env, &fields[i], visited) then
        return false
      end
      i = i + 1
    end
    true
  when Type::FixedArray(elem, _) then
    # Fixed arrays are inline element storage: bit-copyable exactly when the
    # element is (the count 0 array is trivially bit-copyable).
    is_trivially_copyable_walk(env, &elem, visited)
  when Type::Adt(tid, args) then
    is_named_trivially_copyable(env, tid, args, visited)
  # Heap-backed storage is never bit-copyable: a bit-copy would duplicate
  # the buffer/ownership state without the retain/clone it requires
  # (the Adt forms of the builtin compounds are classified in
  # is_named_trivially_copyable by their LangItems ids).
 # String: the OWNED String object — the value is a pointer to
  # the owned {data,len,cap,stride} object; bit-copying it would duplicate
  # the owned buffer. String is Clone, NOT Copy — stays false.
  when Type::String then false
 # (typed view): the static StaticStrPtr of a literal is the raw
  # pointer to the interned static bytes — a view, bit-copyable exactly
  # like a raw pointer.
  when Type::StaticStrPtr then true
  # Closures/functions with environments carry state; refs are borrows with
  # checker-managed semantics, not bit-copy values.
 # (FnPtr/Closure split): a FUNCTION POINTER has no environment — it is
  # a plain code pointer, bit-copyable; a CLOSURE's copy legality derives
  # from its CAPTURE TUPLE (a closure capturing a non-copyable value is not
  # bit-copyable).
  when Type::FnPtr(_, _, _) then true
  when Type::Closure(_, _, _, captures, _) then is_trivially_copyable_walk(env, &captures, visited)
  when Type::Dyn(_) then false
  when Type::Effect(_, _) then false
  when Type::RefInternal(_, _) then false
  when Type::Var(_) then false
  when Type::Param(_) then false
 # (inference-only): an integer literal is a scalar value — a
  # bit-copyable constant exactly like the concrete integer types.
  when Type::IntLiteral(_) then true
  when Type::Error then false
  end  end
end

def is_named_trivially_copyable(env: TypeEnv, tid: TypeId, args: Vec[Type], inout visited: Set[String]) -> Bool
  match get_type_by_id_ref(env, tid)
  when Option::Some(td) then
    # Resources and capabilities are linear: never bit-copyable.
    if td.kind == TypeKind::Resource || td.kind == TypeKind::Capability then
      return false
    end
    # A registered `impl Drop for T` requires destruction: a raw bit-copy
    # would duplicate the state the drop glue releases (e.g. File's fd —
    # the drop closes it; a bit-copy would double-close). The Drop identity
    # is the LangItems TraitId — never the name.
    if type_has_registered_drop(env, tid) then
      return false
    end
    # Named owning smart pointers are NEVER bit-copyable: a bit-copy would
    # duplicate unique ownership or reference-count state. This mirrors the
    # ResourceChecker's is_owning_smart_pointer classification. The whole
    # smart-pointer family (Box/Rc AND the std-declared UniquePtr/WeakRc/
    # ArcStrong/WeakArc) is selected by LangItems TypeId — never by name.
    if tid.id == env.lang_items.box_ || tid.id == env.lang_items.rc ||
       (env.lang_items.unique_ptr != -1 && tid.id == env.lang_items.unique_ptr) ||
       (env.lang_items.weak_rc != -1 && tid.id == env.lang_items.weak_rc) ||
       (env.lang_items.arc_strong != -1 && tid.id == env.lang_items.arc_strong) ||
       (env.lang_items.weak_arc != -1 && tid.id == env.lang_items.weak_arc) then
      return false
    end
    # Heap-backed containers (including the registered Vec shape { ptr, len,
    # cap } — the Ptr field must NOT be walked): never bit-copyable. The
    # LangItems TypeIds select the builtin containers. The SAFE
    # source-spelled Slice is NOT in this class: it is the std-declared
    # shared struct (the Arc handle is never bit-copyable — the structural
    # walk below decides through its ArcStrong field).
    if tid.id == env.lang_items.vec || tid.id == env.lang_items.array || tid.id == env.lang_items.map ||
       tid.id == env.lang_items.set then
      return false
    end
    # UnsafeSlice[T] — the RAW view (the reviewer's no-general-borrow model;
    # the SAFE Slice = the shared/pinned std-declared Slice struct — the
    # Arc-class form):
    # { ptr: Ptr[T], len: UInt }, owns=false, drop=none. Bit-copy is
    # structurally possible: the view holds a raw pointer (bit-copyable) and
    # a length; the element type's ownership lives in the owning container
    # the view borrows, never in the view. The raw view is unsafe/FFI-only
    # — its escapes are the P0-SL-rejected cases. (Mirror of the old
    # StrView shape; the safe StrView is now the Arc-backed shared form.)
    if tid.id == env.lang_items.slice then
      return true
    end
    # The OWNED String object (LangItems string id — the registered builtin
    # "String" TypeId; never a name comparison): owns a unique heap buffer,
    # is Clone, NOT Copy — never bit-copyable.
    if env.lang_items.string != -1 && tid.id == env.lang_items.string then
      return false
    end
    # Raw pointers are bit-copyable regardless of pointee (LangItems
    # ptr/ptr_mut ids — the registered builtin Ptr/PtrMut TypeIds).
    if (env.lang_items.ptr != -1 && tid.id == env.lang_items.ptr) ||
       (env.lang_items.ptr_mut != -1 && tid.id == env.lang_items.ptr_mut) then
      return true
    end
    # Primitive spellings (canonical plus c-FFI aliases) decide directly.
    if td.name == "Unit" || td.name == "Nil" || td.name == "Bool" ||
       td.name == "Int" || td.name == "c_int" || td.name == "UInt" ||
       td.name == "c_uint" || td.name == "Float" || td.name == "Char" ||
       td.name == "Never" ||
       td.name == "I8" || td.name == "Int8" || td.name == "i8" ||
       td.name == "I16" || td.name == "Int16" || td.name == "i16" ||
       td.name == "I32" || td.name == "Int32" || td.name == "i32" ||
       td.name == "I64" || td.name == "Int64" || td.name == "i64" ||
       td.name == "c_long" ||
       td.name == "I128" || td.name == "Int128" || td.name == "i128" ||
       td.name == "U8" || td.name == "UInt8" || td.name == "u8" ||
       td.name == "c_char" ||
       td.name == "U16" || td.name == "UInt16" || td.name == "u16" ||
       td.name == "U32" || td.name == "UInt32" || td.name == "u32" ||
       td.name == "U64" || td.name == "UInt64" || td.name == "u64" ||
       td.name == "c_ulong" ||
       td.name == "U128" || td.name == "UInt128" || td.name == "u128" ||
       td.name == "ISize" || td.name == "isize" ||
       td.name == "USize" || td.name == "usize" ||
       td.name == "F32" || td.name == "f32" || td.name == "c_float" ||
       td.name == "F64" || td.name == "f64" || td.name == "c_double" then
      return true
    end
    # Option/Result Adt forms recurse into their concrete args (LangItems
    # TypeIds select the builtin enums).
    if tid.id == env.lang_items.option then
      if args.len() < 1 then return false end
      return is_trivially_copyable_walk(env, &args[0], visited)
    end
    if tid.id == env.lang_items.result then
      if args.len() < 2 then return false end
      return is_trivially_copyable_walk(env, &args[0], visited) &&
        is_trivially_copyable_walk(env, &args[1], visited)
    end
    # User aggregates: structs whose fields are all trivially copyable,
    # enums whose payloads are all trivially copyable, aliases whose inner
    # type is trivially copyable. The visited set — keyed by the canonical
    # structural identity (type_identity_key_resolved, concrete args
    # included, so Wrapper[Int] and Wrapper[String] are distinct keys) —
    # makes recursion through INLINE storage fail closed (a Visiting key
    # means the type is infinitely sized — never bit-copyable). The key is
    # removed after each subtree so distinct sibling fields do not collide.
    match td.def_kind
    when TypeDefKind::Alias(inner) then
      let id_key = type_identity_key_resolved(env, &Type::Adt(tid.clone(), args.clone()))
      if visited.contains(&id_key) then return false end
      visited.insert(id_key.clone())
      let inner_ty = subst_type_args(&inner, &td.generic_params, args)
      let ok = is_trivially_copyable_walk(env, &inner_ty, visited)
      visited.remove(&id_key)
      ok
    when TypeDefKind::Struct(fields) then
      let id_key = type_identity_key_resolved(env, &Type::Adt(tid.clone(), args.clone()))
      if visited.contains(&id_key) then return false end
      visited.insert(id_key.clone())
      var i = 0
      while i < fields.len() do
        let f_ty = subst_type_args(&fields[i].ty, &td.generic_params, args)
        if !is_trivially_copyable_walk(env, &f_ty, visited) then
          visited.remove(&id_key)
          return false
        end
        i = i + 1
      end
      visited.remove(&id_key)
      true
    when TypeDefKind::Enum(variants) then
      let id_key = type_identity_key_resolved(env, &Type::Adt(tid.clone(), args.clone()))
      if visited.contains(&id_key) then return false end
      visited.insert(id_key.clone())
      var vi = 0
      while vi < variants.len() do
        var fi = 0
        while fi < variants[vi].fields.len() do
          let v_ty = subst_type_args(&variants[vi].fields[fi], &td.generic_params, args)
          if !is_trivially_copyable_walk(env, &v_ty, visited) then
            visited.remove(&id_key)
            return false
          end
          fi = fi + 1
        end
        vi = vi + 1
      end
      visited.remove(&id_key)
      true
    when _ then false
    end
  when Option::None then false
  end  end
end

# ———————————————————————————————————————————————————————————————
# Trait/Obligation Solver 
# ———————————————————————————————————————————————————————————————
#
# ONE general obligation solver drives impl applicability for every trait
# (Copy, Clone, Eq, Hash, Iterator, Display, Drop, user traits). It uses
# the same impl registry as method lookup (env.impls, populated by
# check_impl / register_builtin_trait): an obligation is stated as a FULL
# TraitRef (trait T, self S, trait args) and solved iff exactly one
# candidate impl whose for_type HEAD unifies with S — AND whose trait
# arguments unify with the obligation's args, when the obligation carries
# any — also solves all of its own where-clause obligations under the
# substitution obtained from THAT unification — never from generic-
# parameter index, never from the receiver's positional arguments. The
# impl's generic instantiation keys off ImplInfo.generic_params
# (declaration order) exclusively, and every candidate attempt is a
# TRANSACTIONAL probe (subst_snapshot / subst_restore): a rejected
# candidate leaves no substitution residue in the global inference state.
# Recursion is cycle-guarded by a visited set of full (trait, self, args)
# TraitRef keys; a solved set larger than one candidate is ambiguous and
# fails.

# Collect the GenericParamIds that occur in a type, in traversal order —
# the signature-parameter collector for the monomorphizer's
# positional-substitution record (NOT the impl-instantiation authority:
# impl fresh-variable creation, head instantiation and substitution order
# key off ImplInfo.generic_params exclusively). identity is the
# GenericParamId (dedupe by generic_param_id_numeric — two same-named
# parameters of different declarations are distinct ids and both collect).
def collect_param_names_from_type(env: TypeEnv, ty: Type, inout out: Vec[GenericParamId]) -> Unit
  match ty
  when Type::Param(gpid) then
    var found = false
    var i = 0
    while i < out.len() do
      if generic_param_id_numeric(&out[i]) == generic_param_id_numeric(&gpid) then found = true end
      i = i + 1
    end
    if !found then out.push(gpid.clone()) end
  when Type::Adt(_, args) then
    var i = 0
    while i < args.len() do
      collect_param_names_from_type(env, &args[i], out)
      i = i + 1
    end
  when Type::RefInternal(inner, _) then collect_param_names_from_type(env, inner, out)
  when Type::Ptr(inner) then collect_param_names_from_type(env, inner, out)
  when Type::PtrMut(inner) then collect_param_names_from_type(env, inner, out)
  when Type::Tuple(fields) then
    var i = 0
    while i < fields.len() do
      collect_param_names_from_type(env, &fields[i], out)
      i = i + 1
    end
  when Type::FnPtr(params, ret, _) then
    var i = 0
    while i < params.len() do
      collect_param_names_from_type(env, &params[i].ty, out)
      i = i + 1
    end
    collect_param_names_from_type(env, ret, out)
  when Type::Closure(_, params, ret, captures, _) then
    var i = 0
    while i < params.len() do
      collect_param_names_from_type(env, &params[i].ty, out)
      i = i + 1
    end
    collect_param_names_from_type(env, ret, out)
    collect_param_names_from_type(env, &captures, out)
  when Type::Effect(_, inner) then collect_param_names_from_type(env, inner, out)
  when _ then ()
  end  end
end

# (transactional candidate probing): snapshot the unifier's subst
# state before attempting a candidate impl. Candidate probing runs the
# ORDINARY global unifier (try_head_unify); on rejection the attempt rolls
# the subst map back so a failed candidate leaves NO residue in the global
# inference state, and on acceptance the candidate's substitutions commit.
# The subst map is the ONLY inference state the unifier mutates (bindings
# plus path compression); diagnostics are handled separately by truncating
# env.errors to the attempt's pre-count.
def subst_snapshot(env: TypeEnv) -> Map[TypeVarId, Type]
  env.subst.clone()
end

def subst_restore(inout env: TypeEnv, snap: Map[TypeVarId, Type]) -> Unit
  env.subst = snap.clone()
end

def errors_truncate(inout env: TypeEnv, len: Int) -> Unit
  while env.errors.len() > len do
    env.errors.pop()
  end
end

# Unify two types WITHOUT recording diagnostics: used by the obligation
# solver to test candidate impl heads. A failed head match is an ordinary
# non-match (e.g. `impl Hash for u8` vs an obligation on String), not an
# error — the mismatch diagnostics emitted by unify are discarded. The
# variable bindings made by a failed attempt are rolled back by the
# caller's transactional wrapper (subst_snapshot / subst_restore — see
# solve_obligation_depth): candidate probing never leaves residue in the
# global inference state.
def try_head_unify(inout env: TypeEnv, t1: Type, t2: Type) -> Bool
  let errors_before = env.errors.len()
  let ok = unify(env, t1, t2, Span { file: "", start: 0, end_pos: 0 })
  if !ok then
    while env.errors.len() > errors_before do
      env.errors.pop()
    end
  end
  ok
end

# A structural identity string for a (fully resolved) type, used as the
# (trait, type) key in the obligation solver's cycle set. Unlike type_tag,
# it recurses into type arguments, so `Hash` for `Vec[Int]` and `Hash` for
# `Vec[String]` are distinct obligations.
def type_identity_key(env: TypeEnv, ty: Type) -> String
  type_identity_key_resolved(env, &resolve_type_var(env, ty.clone()))
end

# The canonical identity tag of a parameter access convention. Function
# type identity must distinguish fn(let T) / fn(inout T) / fn(sink T) /
# fn(set T): the conventions are different callable types with different
# ownership contracts, so their canonical keys must differ.
def convention_identity_tag(c: AccessConvention) -> String
  match c
  when AccessConvention::Let then "let"
  when AccessConvention::Inout then "inout"
  when AccessConvention::Sink then "sink"
  when AccessConvention::Set then "set"
  end  end
end

# ———————————————————————————————————————————————————————————————
# THE ONE canonical type encoding (the consolidation)
# ———————————————————————————————————————————————————————————————
# The frontend type identity (type_identity_key_resolved — conventions +
# effects), the mono internal emission mangling (type_to_mangled), and the
# public ABI canonicalization (tangerine_abi_canon_type) are ONE canonical
# semantic type encoding — type_canon_render — parameterized ONLY by the
# EXTERNAL SYMBOL FRAMING (TypeCanonFrame):
#   CanonSemantic — the frontend type-identity frame: nominal Adts key by
#     the LangItems special forms (Option/Result/Map/Set/Slice/Array/Box/
#     Rc) or "Named#<id>"; effect sets render as the canonical ordered
#     EFFECT-ID set (the M9 EffectId domain — names -> ids through the
#     EffectRegistry); Param/Var/Error render distinctly (never fail).
#   CanonInternal — the per-compilation emission-label frame (mono's
#     type_to_mangled): nominal Adts render by the EPHEMERAL TypeId
#     ("t<id>") — legal HERE because internal labels never cross a
#     compilation boundary (ephemeral ids are forbidden only in the public
#     ABI); effect sets render as the canonical ordered NAME set;
#     Param/Var/Error render distinctly.
#   CanonExternal — the PUBLIC ABI frame (mono's tangerine_abi_canon_type):
#     nominal Adts render by their STABLE PATHS ("T[<module path>::<name>]"
#     from the type_names table — the TypeId -> declaration association is
#     DIRECT, never name/order-correlated); FAIL-CLOSED on Param/Var/Error
#     and on Closure (a Closure carries the per-compilation ClosureId — it
#     has NO stable public identity and never appears in an exported
#     signature); effect sets render as the canonical ordered NAME set.
# The framing difference is EXACTLY that: the nominal identity source and
# the unresolved-type policy. The structural walk (primitives, tuple,
# callable signatures with conventions, refs/pointers, fixed arrays,
# effects, recursion) is shared byte-for-byte across the frames.
enum TypeCanonFrame
  CanonSemantic
  CanonInternal
  CanonExternal
end

# The rendering context: the frame plus the per-frame name tables (the
# External stable paths by TypeId, the param-name table for diagnostics),
# the LangItems ids (the Semantic builtin selection), and the effect
# registry (the effect-id mapping for the identity's effect-ID set).
struct TypeCanonCtx
  frame: TypeCanonFrame
  type_names: Map[Int, String]
  param_names: Map[Int, String]
  lang_option: Int
  lang_result: Int
  lang_map: Int
  lang_set: Int
  lang_slice: Int
  lang_array: Int
  lang_box: Int
  lang_rc: Int
  effects: EffectRegistry
end

# The canonical ordered effect-set render shared by the frames. The
# canonical ORDER is the sorted element list (a set's canonical order —
# two syntactically different orders of the same effects are the same
# set). (EffectId domain): the payload IS the canonical ordered
# Vec[EffectId] — every effect in a TYPE VALUE is already interned. With
# ids=true (the CanonSemantic frame) every effect renders by its interned
# EffectId ("e<id>") — the canonical ordered effect-ID set of the type
# identity; with ids=false the registry's NAMES render in the same
# canonical order (the Internal per-compilation label and the ABI-stable
# External rendering; an id the registry never interned renders "e<id>").
def canonical_effect_set_render(ctx: TypeCanonCtx, effects: Vec[EffectId], ids: Bool) -> String
  var sorted = Vec::new()
  var i = 0
  while i < effects.len() do
    let eid = effects[i]
    let elem = if ids then
      "e" + eid.id.to_string()
    else
      match effect_name_of_id(&ctx.effects, &eid)
      when Option::Some(n) then n.clone()
      when Option::None then "e" + eid.id.to_string()
      end
    end
    var pos = 0
    while pos < sorted.len() do
      if elem < sorted[pos] then
        break
      end
      pos = pos + 1
    end
    sorted.insert(pos, elem)
    i = i + 1
  end
  var s = "{"
  var j = 0
  while j < sorted.len() do
    if j > 0 then s = s + "," end
    s = s + sorted[j]
    j = j + 1
  end
  s + "}"
end

# The canonical parameter-convention tag (shared by the frames): fn(let T)
# / fn(inout T) / fn(sink T) / fn(set T) are different callable types with
# different ownership contracts, so their canonical renderings must differ.
def canon_convention_tag(c: AccessConvention) -> String
  match c
  when AccessConvention::Let then "let"
  when AccessConvention::Inout then "inout"
  when AccessConvention::Sink then "sink"
  when AccessConvention::Set then "set"
  end  end
end

# The ONE canonical semantic type walk. Result::Err is produced ONLY by
# the CanonExternal frame (the fail-closed policy: Param/Var/Error and a
# Closure — a per-compilation identity — never appear in a public ABI
# symbol; an Adt without a stable path errors instead of collapsing); the
# CanonSemantic/CanonInternal frames never fail (every form renders
# distinctly).
pub def type_canon_render(ctx: TypeCanonCtx, ty: Type) -> Result[String, String]
  match ty
  when Type::Unit then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("Unit") else Result::Ok("unit") end
  when Type::Bool then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("Bool") else Result::Ok("bool") end
  when Type::Int then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("Int") else Result::Ok("int") end
  when Type::UInt then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("UInt") else Result::Ok("uint") end
  when Type::Float then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("Float") else Result::Ok("float") end
  when Type::Char then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("Char") else Result::Ok("char") end
  when Type::String then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("String") else Result::Ok("str") end
  when Type::StaticStrPtr then
 # (typed view): the MIR-internal static StaticStrPtr of a
    # literal. It renders distinctly in the semantic and internal frames
    # (the type-identity keys of a view and an owned String must NEVER
    # collide — and the internal name StaticStrPtr is distinct from the
    # PUBLIC std StrView, the 16-byte {ptr,len} view) and FAILS CLOSED in
    # the public ABI frame: a static pointer is MIR-internal and never
    # appears in an exported signature (exactly like Closure).
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then Result::Ok("StaticStrPtr")
    when TypeCanonFrame::CanonInternal then Result::Ok("staticstrptr")
    when TypeCanonFrame::CanonExternal then Result::Err("tangerine ABI: a static StaticStrPtr (Type::StaticStrPtr — the MIR-internal literal static pointer) cannot appear in a public ABI symbol")
    end
  when Type::Never then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("Never") else Result::Ok("never") end
  when Type::IntLiteral(v) then
 # (inference-only): the unconstrained integer literal renders
    # distinctly in the semantic and internal frames and FAILS CLOSED in
    # the public ABI frame — the literal type is eliminated before any
    # codegenable TypedProgram is built (the resolved type never remains
    # IntLiteral), so it can never legitimately reach an exported
    # signature.
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then Result::Ok("IntLiteral(" + v.to_string() + ")")
    when TypeCanonFrame::CanonInternal then Result::Ok("intlit(" + v.to_string() + ")")
    when TypeCanonFrame::CanonExternal then Result::Err("tangerine ABI: an unresolved Type::IntLiteral (the inference-only integer-literal type) cannot appear in a public ABI symbol")
    end
  when Type::I8 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("I8") else Result::Ok("i8") end
  when Type::I16 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("I16") else Result::Ok("i16") end
  when Type::I32 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("I32") else Result::Ok("i32") end
  when Type::I64 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("I64") else Result::Ok("i64") end
  when Type::I128 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("I128") else Result::Ok("i128") end
  when Type::U8 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("U8") else Result::Ok("u8") end
  when Type::U16 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("U16") else Result::Ok("u16") end
  when Type::U32 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("U32") else Result::Ok("u32") end
  when Type::U64 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("U64") else Result::Ok("u64") end
  when Type::U128 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("U128") else Result::Ok("u128") end
  when Type::ISize then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("ISize") else Result::Ok("isize") end
  when Type::USize then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("USize") else Result::Ok("usize") end
  when Type::F32 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("F32") else Result::Ok("f32") end
  when Type::F64 then
    if ctx.frame == TypeCanonFrame::CanonSemantic then Result::Ok("F64") else Result::Ok("f64") end
  when Type::Adt(tid, args) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then
      # The Adt form of a builtin compound keys by its LangItems TypeId; the
      # identity is id-selected, never name-selected (a module-local type
      # with a builtin's name must not key as the builtin).
      var s = "Named#" + tid.id.to_string()
      var i = 0
      while i < args.len() do
        s = s + "[" + canon_render_unwrap(ctx, &args[i]) + "]"
        i = i + 1
      end
      if tid.id == ctx.lang_option && args.len() >= 1 then
        Result::Ok("Option[" + canon_render_unwrap(ctx, &args[0]) + "]")
      elsif tid.id == ctx.lang_result && args.len() >= 2 then
        Result::Ok("Result[" + canon_render_unwrap(ctx, &args[0]) + "," + canon_render_unwrap(ctx, &args[1]) + "]")
      elsif tid.id == ctx.lang_map && args.len() >= 2 then
        Result::Ok("Map[" + canon_render_unwrap(ctx, &args[0]) + "," + canon_render_unwrap(ctx, &args[1]) + "]")
      elsif tid.id == ctx.lang_set && args.len() >= 1 then
        Result::Ok("Set[" + canon_render_unwrap(ctx, &args[0]) + "]")
      elsif tid.id == ctx.lang_slice && args.len() >= 1 then
        # The `slice` LangItems id IS the RAW view (UnsafeSlice) — the
        # canonical semantic key renders its spelling. The SAFE
        # source-spelled Slice (the std-declared shared struct) keys by
        # its own TypeId ("Named#...").
        Result::Ok("UnsafeSlice[" + canon_render_unwrap(ctx, &args[0]) + "]")
      elsif tid.id == ctx.lang_array && args.len() >= 1 then
        Result::Ok("Array[" + canon_render_unwrap(ctx, &args[0]) + "]")
      elsif tid.id == ctx.lang_box && args.len() >= 1 then
        Result::Ok("Box[" + canon_render_unwrap(ctx, &args[0]) + "]")
      elsif tid.id == ctx.lang_rc && args.len() >= 1 then
        Result::Ok("Rc[" + canon_render_unwrap(ctx, &args[0]) + "]")
      else
        Result::Ok(s)
      end
    when TypeCanonFrame::CanonInternal then
      if args.is_empty() then
        Result::Ok("t" + tid.id.to_string())
      else
        var s = "t" + tid.id.to_string() + "["
        var first_arg = true
        for arg in args do
          if !first_arg then
            s = s + ","
          end
          s = s + canon_render_unwrap(ctx, &arg)
          first_arg = false
        end
        Result::Ok(s + "]")
      end
    when TypeCanonFrame::CanonExternal then
      match ctx.type_names.get(tid.id)
      when Option::Some(path) then
        if args.is_empty() then
          Result::Ok("T[" + path.clone() + "]")
        else
          var parts = Vec::new()
          for a in args do
            match type_canon_render(ctx, &a)
            when Result::Ok(c) then parts.push(c)
            when Result::Err(msg) then return Result::Err(msg)
            end
          end
          Result::Ok("T[" + path.clone() + "][" + parts.join(",") + "]")
        end
      when Option::None then
        Result::Err("tangerine ABI: TypeId " + tid.id.to_string() + " has no stable path (not a registered source struct/enum/trait/alias declaration — compiler-synthesized or shadowed types never mangle) — cannot canonicalize this Adt for the public ABI")
      end
    end
  when Type::FixedArray(elem, n) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then
      Result::Ok("FixedArray[" + canon_render_unwrap(ctx, elem) + ";" + n.to_string() + "]")
    when TypeCanonFrame::CanonInternal then
      Result::Ok("fa[" + canon_render_unwrap(ctx, elem) + ";" + n.to_string() + "]")
    when TypeCanonFrame::CanonExternal then
      match type_canon_render(ctx, elem)
      when Result::Ok(ec) then Result::Ok("A[" + ec + ";" + n.to_string() + "]")
      when Result::Err(msg) then Result::Err(msg)
      end
    end
  when Type::Tuple(fields) then
    var parts = Vec::new()
    for f in fields do
      match type_canon_render(ctx, &f)
      when Result::Ok(c) then parts.push(c)
      when Result::Err(msg) then return Result::Err(msg)
      end
    end
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then Result::Ok("Tuple(" + parts.join(",") + ")")
    when TypeCanonFrame::CanonInternal then Result::Ok("tuple(" + parts.join(",") + ")")
    when TypeCanonFrame::CanonExternal then Result::Ok("(" + parts.join(",") + ")")
    end
  when Type::FnPtr(params, ret, _) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then canon_render_callable(ctx, "FnPtr", params, ret)
    when TypeCanonFrame::CanonInternal then canon_render_callable(ctx, "fnptr", params, ret)
    when TypeCanonFrame::CanonExternal then canon_render_callable(ctx, "F", params, ret)
    end
  when Type::Closure(cid, params, ret, _, _) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then
      match canon_render_callable(ctx, "Closure#" + cid.id.to_string(), params, ret)
      when Result::Ok(c) then Result::Ok("Closure(" + c + ")")
      when Result::Err(msg) then Result::Err(msg)
      end
    when TypeCanonFrame::CanonInternal then
      match canon_render_callable(ctx, "closure#" + cid.id.to_string(), params, ret)
      when Result::Ok(c) then Result::Ok("closure(" + c + ")")
      when Result::Err(msg) then Result::Err(msg)
      end
    when TypeCanonFrame::CanonExternal then
      # FAIL-CLOSED: the ClosureId is a per-compilation identity — a
      # closure value has no stable public identity and never appears in
      # an exported signature.
      Result::Err("tangerine ABI: a closure value (ClosureId " + cid.id.to_string() + ") cannot appear in a public ABI symbol")
    end
  when Type::RefInternal(inner, mutable) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then Result::Ok("Ref[" + canon_render_unwrap(ctx, inner) + "]")
    when TypeCanonFrame::CanonInternal then
      if mutable then Result::Ok("refmut(" + canon_render_unwrap(ctx, inner) + ")") else Result::Ok("ref(" + canon_render_unwrap(ctx, inner) + ")") end
    when TypeCanonFrame::CanonExternal then
      match type_canon_render(ctx, inner)
      when Result::Ok(ic) then
        let tag = if mutable then "mut" else "ref" end
        Result::Ok("R[" + tag + "|" + ic + "]")
      when Result::Err(msg) then Result::Err(msg)
      end
    end
  when Type::Ptr(inner) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then Result::Ok("Ptr[" + canon_render_unwrap(ctx, inner) + "]")
    when TypeCanonFrame::CanonInternal then Result::Ok("ptr(" + canon_render_unwrap(ctx, inner) + ")")
    when TypeCanonFrame::CanonExternal then
      match type_canon_render(ctx, inner)
      when Result::Ok(ic) then Result::Ok("P[" + ic + "]")
      when Result::Err(msg) then Result::Err(msg)
      end
    end
  when Type::PtrMut(inner) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then Result::Ok("PtrMut[" + canon_render_unwrap(ctx, inner) + "]")
    when TypeCanonFrame::CanonInternal then Result::Ok("ptrmut(" + canon_render_unwrap(ctx, inner) + ")")
    when TypeCanonFrame::CanonExternal then
      match type_canon_render(ctx, inner)
      when Result::Ok(ic) then Result::Ok("Q[" + ic + "]")
      when Result::Err(msg) then Result::Err(msg)
      end
    end
  when Type::Dyn(tid) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then Result::Ok("Dyn#" + tid.id.to_string())
    when TypeCanonFrame::CanonInternal then Result::Ok("dyn" + tid.id.to_string())
    when TypeCanonFrame::CanonExternal then
      match ctx.type_names.get(tid.id)
      when Option::Some(path) then Result::Ok("D[" + path.clone() + "]")
      when Option::None then
        Result::Err("tangerine ABI: trait object TypeId " + tid.id.to_string() + " has no stable path — cannot canonicalize this Dyn for the public ABI")
      end
    end
  when Type::Effect(effects, inner) then
 # (defect fix, carried through the consolidation): the identity
    # includes the ACTUAL effect set — never just the inner type
    # (effect[Io] T and effect[Net] T are different types). The
    # CanonSemantic frame renders the canonical ordered EFFECT-ID set
 # (: the payload IS the interned Vec[EffectId]); the Internal/
    # External frames render the registry's names in the same canonical
    # order.
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then
      Result::Ok("Effect[" + canonical_effect_set_render(ctx, &effects, true) + ";" + canon_render_unwrap(ctx, inner) + "]")
    when TypeCanonFrame::CanonInternal then
      Result::Ok("eff(" + canonical_effect_set_render(ctx, &effects, false) + "|" + canon_render_unwrap(ctx, inner) + ")")
    when TypeCanonFrame::CanonExternal then
      match type_canon_render(ctx, inner)
      when Result::Ok(ic) then Result::Ok("E[" + canonical_effect_set_render(ctx, &effects, false) + "|" + ic + "]")
      when Result::Err(msg) then Result::Err(msg)
      end
    end
  when Type::Var(id) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then Result::Ok("Var#" + id.id.to_string())
    when TypeCanonFrame::CanonInternal then Result::Ok("var" + id.id.to_string())
    when TypeCanonFrame::CanonExternal then
      Result::Err("tangerine ABI: inference variable (Type::Var) cannot appear in a public ABI symbol (resolve before mangling)")
    end
  when Type::Param(gpid) then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then
      Result::Ok("Param(" + generic_param_name_from(&ctx.param_names, &gpid) + ")")
    when TypeCanonFrame::CanonInternal then
      Result::Ok("param" + generic_param_id_numeric(&gpid).to_string())
    when TypeCanonFrame::CanonExternal then
      Result::Err("tangerine ABI: type parameter `" + generic_param_name_from(&ctx.param_names, &gpid) + "` cannot appear in a public ABI symbol (canonicalize the instance first)")
    end
  when Type::Error then
    match ctx.frame
    when TypeCanonFrame::CanonSemantic then Result::Ok("Error")
    when TypeCanonFrame::CanonInternal then Result::Ok("err")
    when TypeCanonFrame::CanonExternal then
      Result::Err("tangerine ABI: Type::Error cannot appear in a public ABI symbol")
    end
  end  end
end

# The callable-signature rendering shared by the frames: the parameter
# access conventions are part of the canonical encoding (fn(let T) /
# fn(inout T) / fn(sink T) / fn(set T) are different callable types).
# head is the frame's callable tag ("Fn" / "FnPtr" / "fnptr" / "F" /
# "Closure#<id>" / "closure#<id>"); the External frame renders the
# bracket form "F[conv:ty,...|ret]".
def canon_render_callable(ctx: TypeCanonCtx, head: String, params: Vec[ParamType], ret: Type) -> Result[String, String]
  var parts = Vec::new()
  for p in params do
    match type_canon_render(ctx, &p.ty)
    when Result::Ok(c) then parts.push(canon_convention_tag(p.convention) + ":" + c)
    when Result::Err(msg) then return Result::Err(msg)
    end
  end
  match type_canon_render(ctx, ret)
  when Result::Ok(rc) then
    if ctx.frame == TypeCanonFrame::CanonExternal then
      Result::Ok(head + "[" + parts.join(",") + "|" + rc + "]")
    else
      Result::Ok(head + "(" + parts.join(",") + ")->" + rc)
    end
  when Result::Err(msg) then Result::Err(msg)
  end
end

# Unwrap the canonical render of an inner type (the Semantic/Internal
# frames never fail — Result::Err is the External frame's fail-closed
# policy only).
def canon_render_unwrap(ctx: TypeCanonCtx, ty: Type) -> String
  match type_canon_render(ctx, ty)
  when Result::Ok(s) then s
  when Result::Err(_) then "<err>"
  end  end
end

# The Semantic frame's context, built from the checker's env (the
# LangItems ids, the param-name table, the effect registry).
def semantic_canon_ctx(env: TypeEnv) -> TypeCanonCtx
  TypeCanonCtx {
    frame: TypeCanonFrame::CanonSemantic,
    type_names: Map::new(),
    param_names: env.generic_param_table.names.clone(),
    lang_option: env.lang_items.option,
    lang_result: env.lang_items.result,
    lang_map: env.lang_items.map,
    lang_set: env.lang_items.set,
    lang_slice: env.lang_items.slice,
    lang_array: env.lang_items.array,
    lang_box: env.lang_items.box_,
    lang_rc: env.lang_items.rc,
    effects: env.effects
  }
end

# The frontend type-identity frame: a structural identity string for a
# (fully resolved) type — the canonical semantic type encoding with
# conventions and effects — used as the (trait, type) key in the
# obligation solver's cycle set, the type-property engine's memo key, and
# the resource checker's identity table. The wrapper builds the Semantic
# frame context and unwraps the render (never fails).
def type_identity_key_resolved(env: TypeEnv, ty: Type) -> String
  let ctx = semantic_canon_ctx(env)
  match type_canon_render(&ctx, ty)
  when Result::Ok(s) then s
  when Result::Err(_) then "<identity>"
  end
end

def solve_obligation(inout env: TypeEnv, obligation: Obligation) -> Bool
  var visited: Set[String] = Set::new()
 # (resource limit): the recursion-limit flag is threaded through the
  # entire solve. The depth guard sets it and fails the obligation; the
  # OUTERMOST frame turns it into an explicit compiler-resource diagnostic
  # on the error channel. Exceeding a resource limit is NEVER a semantic
  # answer ("trait not implemented") — it is a compiler-resource error.
  var resource_exceeded = false
  let result = solve_obligation_depth(env, obligation, &mut visited, 0, &mut resource_exceeded)
  if resource_exceeded && !result then
    type_add_error(env, "trait solver recursion limit exceeded (trait `" + obligation.trait_name + "`)", Span { file: "", start: 0, end_pos: 0 })
  end
  result
end

def solve_obligation_depth(inout env: TypeEnv, obligation: Obligation, inout visited: Set[String], depth: Int, inout resource_exceeded: Bool) -> Bool
 # (resource limit): the depth guard is a COMPILER RESOURCE limit,
  # not a semantic answer. Exceeding it sets the resource-exceeded flag —
  # threaded state, not a diagnostic that a candidate-probe rollback could
  # truncate — and fails the obligation; the outermost solve_obligation
  # frame reports the explicit resource diagnostic. It is NEVER a silent
  # "trait not implemented".
  if depth > MAX_TYPE_DEPTH() then
    resource_exceeded = true
    return false
  end
  let self_resolved = resolve_type_var(env, obligation.trait_ref.self_ty)
  # An obligation whose self type is still an unbound inference variable is
  # undecidable at this point: solving it would bind the variable to an
  # arbitrary candidate impl head (e.g. `let v = Vec::new(); v.hash()`
  # pinning the element type to the first Hash impl). Reject the obligation
  # instead — the impl is not applicable until the receiver is resolved.
  match self_resolved
  when Type::Var(_) then return false
  when _ then ()
  end
 # / (trait arguments): the cycle key is the
  # FULL TraitRef — (trait_id, canonical self type, canonical trait args) —
  # so `Iterator[Item = X]` and `Iterator[Item = Y]` obligations are
  # distinct, exactly like `Hash` for `Vec[Int]` and `Hash` for
  # `Vec[String]`. Trait identity is the TraitId, never the name; the name
  # survives only in Obligation.trait_name for diagnostics.
  var args_key = ""
  for a in obligation.trait_ref.args do
    args_key = args_key + type_identity_key(env, &a) + ","
  end
  # A Param subject (a generic function's T, or a generic caller's T inside
  # a container arg) is an OPAQUE instance of its DECLARED bounds in the
  # current generic context — the env.param_bounds registry, recorded when
  # the enclosing function's/impl's generic parameters entered scope
  # (record_param_bounds). The obligation holds exactly when the
  # parameter's registered bounds contain the bound trait (identity) with
  # matching type arguments: a `[T: Copy]` caller context PROVES Copy(T),
  # an unconstrained T proves nothing — so the impl-bound gate
  # (impl_bounds_satisfied) rejects the bounded impl, which is how a
  # generic caller with an unconstrained T cannot select a bounded method
  # (the generic path the RingBuffer concrete special case never covered).
  # The impl-candidate loop below can never match a Param head (Params
  # unify only with the same Param), so the bound registry is the ONLY
  # proof source for a Param subject; the args comparison is by canonical
  # identity (resolved) and leaves no substitution residue.
  match self_resolved
  when Type::Param(gpid) then
    match env.param_bounds.get(generic_param_id_numeric(&gpid))
    when Option::Some(pbounds) then
      var pbi = 0
      while pbi < pbounds.len() do
        let pb = pbounds[pbi]
        if pb.trait_id.id == obligation.trait_ref.trait_id.id then
          if pb.args.len() == obligation.trait_ref.args.len() then
            var param_args_ok = true
            var pai = 0
            while param_args_ok && pai < obligation.trait_ref.args.len() do
              if type_identity_key(env, &pb.args[pai]) != type_identity_key(env, &obligation.trait_ref.args[pai]) then
                param_args_ok = false
              end
              pai = pai + 1
            end
            if param_args_ok then
              return true
            end
          end
        end
        pbi = pbi + 1
      end
    when Option::None then ()
    end
  when _ then ()
  end
 # (concurrency properties — the auto-trait hook): Transferable/Shareable
  # obligations solve by the STRUCTURAL DERIVATION — the compiler-derived
  # authority. The user-implementable marker impls are removed from the
  # std and the candidate loop below is NEVER consulted for these traits:
  # even a leftover user impl is ignored, so the derivation is the
  # authority by construction. The hook sits after the param-bounds
  # registry (a `[T: Transferable]`-bounded parameter proves the
  # obligation from its declared bounds — the checker's bound
  # resolution) and before the candidate loop; the derivation's own
  # visited set terminates its recursion (no cycle through the solver).
  if obligation.trait_ref.trait_id.id == env.lang_items.transferable_trait then
    var dt_visited: Set[Int] = Set::new()
    return derive_transferable(env, &self_resolved, &mut dt_visited)
  end
  if obligation.trait_ref.trait_id.id == env.lang_items.shareable_trait then
    var ds_visited: Set[Int] = Set::new()
    return derive_syncable(env, &self_resolved, &mut ds_visited)
  end
  let key = obligation.trait_ref.trait_id.id.to_string() + "::" + type_identity_key(env, &self_resolved) + "::" + args_key
  if visited.contains(&key) then
    # Cycle: this (trait, type) obligation is already being solved on the
    # current path (e.g. `impl[T: Hash] Hash for Vec[T]` recursively solving
    # Hash for Vec[Vec[...]]). A cyclic obligation has no well-founded
    # solution.
    return false
  end
  visited.insert(key.clone())
 # (probe-all-then-commit-unique): the baseline is snapshotted ONCE
  # before the candidate loop. EVERY candidate probes from that SAME
  # baseline — a successful candidate SAVES its resulting substitution and
  # the baseline is restored immediately, so no candidate ever probes
  # against the mutated state of an earlier success, and an ambiguous
  # result can never leave an earlier candidate's substitution committed.
  # After the loop, exactly ONE success commits its SAVED substitution;
  # zero or two-or-more successes leave the baseline unchanged.
  let baseline = subst_snapshot(env)
  let errs_baseline = env.errors.len()
  var solved_candidates = 0
  var committed_subst: Option[Map[TypeVarId, Type]] = Option::None
  var i = 0
  while i < env.impls.len() do
    let imp = env.impls[i]
    if imp.trait_id.id == obligation.trait_ref.trait_id.id then
      # The candidate probes from the SAME baseline as every other.
      subst_restore(env, &baseline)
      errors_truncate(env, errs_baseline)
 # (impl generic instantiation): one fresh inference variable
      # per impl generic parameter, in DECLARATION ORDER — ImplInfo.
      # generic_params is the EXCLUSIVE authority (never a head-derived
      # scan, which misses legal parameters that occur only in trait
      # arguments, where clauses, associated values or phantom positions).
      # The head instantiation and the positional substitution order key
      # off the same vector.
      var vars = Vec::new()
      var j = 0
      while j < imp.generic_params.len() do
        vars.push(fresh_type_var(env))
        j = j + 1
      end
      let head_inst = subst_type_args(&imp.for_type, &imp.generic_params, &vars)
      var cand_ok = try_head_unify(env, head_inst, self_resolved.clone())
      var ob_args: Vec[Type] = Vec::new()
      for ob_arg in obligation.trait_ref.args do
        ob_args.push(resolve_type_var(env, ob_arg.clone()))
      end
      if cand_ok then
 # (authoritative trait-argument matching): the impl's trait
        # arguments are ImplInfo.trait_ref — the DECLARED trait reference
        # captured from the AST's impl declaration at registration — NEVER
        # an approximation from the impl's generic-parameter count. They
        # are instantiated with the candidate's fresh variables and unified
        # against the obligation's args, positionally: two impls with the
        # same self type but different trait arguments (From[A] vs From[B],
        # Into[Out], Iterator[Item = X] vs Iterator[Item = Y]) are
        # distinguished here. An args-less obligation (e.g. satisfies_trait
        # by bare name) imposes no argument constraint. A trait-arg ARITY
        # mismatch between the impl's declaration and the obligation is a
        # UNIFICATION FAILURE (the candidate is rejected) — the head-only
 # degradation is not part of the model.
        if ob_args.len() > 0 then
          if ob_args.len() != imp.trait_ref.args.len() then
            cand_ok = false
          else
            var ai = 0
            while cand_ok && ai < ob_args.len() do
              let imp_arg = resolve_type_var(env, subst_type_args(&imp.trait_ref.args[ai], &imp.generic_params, &vars))
              let resolved_arg = resolve_type_var(env, ob_args[ai].clone())
              if !try_head_unify(env, imp_arg, resolved_arg) then
                cand_ok = false
              end
              ai = ai + 1
            end
          end
        end
      end
      if cand_ok then
        var all_ok = true
        for wob in imp.obligations do
 # (obligation subject): the registered obligation carries
          # its SUBSTITUTED subject — the Type::Param of the impl generic
          # parameter it bounds. Substituting it with the candidate's fresh
          # variables and resolving after head + argument unification yields
          # the concrete subject; there is no param_index into a separately
          # reconstructed vector. The bound trait's arguments are
          # substituted and resolved the same way.
          let wob_self = resolve_type_var(env, subst_type_args(&wob.subject, &imp.generic_params, &vars))
          var wob_args = Vec::new()
          for wob_arg in wob.args do
            wob_args.push(resolve_type_var(env, subst_type_args(&wob_arg, &imp.generic_params, &vars)))
          end
          let wob_ob = Obligation { trait_ref: TraitRef { trait_id: wob.trait_id, self_ty: wob_self, args: wob_args }, trait_name: wob.trait_name }
          if !solve_obligation_depth(env, &wob_ob, visited, depth + 1, resource_exceeded) then
            all_ok = false
          end
        end
        if all_ok then
          # Probe succeeded: SAVE the candidate's resulting substitution
          # (the full subst state at the success moment) and restore the
          # baseline — the next candidate probes the SAME state, and the
          # commit decision below replays the saved substitution.
          solved_candidates = solved_candidates + 1
          committed_subst = Option::Some(subst_snapshot(env))
        end
      end
      # The candidate's probe state is discarded — the next iteration
      # restores the baseline, and the commit decision restores it too.
    end
    i = i + 1
  end
  visited.remove(&key)
  # Commit decision: restore the baseline, then replay the UNIQUE
  # successful candidate's SAVED substitution. An ambiguous result (0 or
  # 2+ successes) leaves the baseline unchanged — NO substitution is
  # committed, exactly as if the solve had never run.
  subst_restore(env, &baseline)
  errors_truncate(env, errs_baseline)
  if solved_candidates == 1 then
    match committed_subst
    when Option::Some(saved) then subst_restore(env, &saved)
    when Option::None then ()
    end
    # Exactly one fully-solving candidate: no candidate fails, and multiple
    # candidates would be ambiguous.
    true
  elsif solved_candidates == 0 then
    # FINAL Copy model: the `Copy` trait is the semantic guarantee that raw
    # duplication is valid. When no explicit impl candidate applies, the
    # structural property decides: a raw bit-copy is valid and requires no
    # retain/clone (is_trivially_copyable). This separates Copy (bit-copy
    # semantics) from Clone (explicit, may allocate) and from move/sink
    # (transfer). The `Copy` trait is the source-level marker for the
    # trivially-copyable property; the std's
    # `Copy` trait identity is the LangItems TraitId (the builtin Copy
    # declaration's id — captured at env init from the builtin
    # registration; never a name-keyed lookup at solve time).
    obligation.trait_ref.trait_id.id == env.lang_items.copy_trait && is_trivially_copyable(env, &self_resolved)
  else
    false
  end
end

# Gate an impl's applicability for a concrete receiver by solving its
# where-clause obligations with the real obligation solver. The self type of
# each obligation is the receiver position bound by impl-HEAD unification —
# never the receiver's positional argument at the obligation's index.
def impl_bounds_satisfied(inout env: TypeEnv, info: ImplInfo, recv_type: Type) -> Bool
  if info.obligations.is_empty() then
    return true
  end
 # (probe-all-then-commit-unique): the whole gate is ONE probe. The
  # baseline is snapshotted up front; the head unification and every
  # where-clause obligation are solved against that SAME baseline; the gate
  # commits ONLY the witness of a fully successful probe — on failure the
  # baseline is restored unchanged (no committed substitution, no
  # diagnostics). Each nested solve is itself probe-all-then-commit-unique,
  # so an ambiguous multi-candidate obligation returns false with ITS
  # baseline unchanged and no substitution can survive into the next
  # obligation.
  let baseline = subst_snapshot(env)
  let errs_baseline = env.errors.len()
 # one fresh inference variable per impl generic parameter, in
  # DECLARATION ORDER — ImplInfo.generic_params is the EXCLUSIVE authority
  # (never a head-derived scan). The self type of each obligation is the
  # receiver position bound by impl-HEAD unification — never the receiver's
  # positional argument at the obligation's index.
  var vars = Vec::new()
  var i = 0
  while i < info.generic_params.len() do
    vars.push(fresh_type_var(env))
    i = i + 1
  end
  let head_inst = subst_type_args(&info.for_type, &info.generic_params, &vars)
  var all_ok = try_head_unify(env, head_inst, recv_type.clone())
  if all_ok then
    for obligation in info.obligations do
 # the obligation's subject is its SUBSTITUTED subject (the
      # Type::Param of the impl generic parameter it bounds), substituted
      # with the candidate's fresh variables and resolved — never the Nth
      # variable of a separately reconstructed vector. The bound trait's
      # arguments are substituted and resolved the same way.
      let self_ty = resolve_type_var(env, subst_type_args(&obligation.subject, &info.generic_params, &vars))
      var ob_args = Vec::new()
      for ob_arg in obligation.args do
        ob_args.push(resolve_type_var(env, subst_type_args(&ob_arg, &info.generic_params, &vars)))
      end
      let ob = Obligation { trait_ref: TraitRef { trait_id: obligation.trait_id, self_ty: self_ty, args: ob_args }, trait_name: obligation.trait_name }
      if !solve_obligation(env, &ob) then
        # A failed obligation invalidates the whole gate: restore the
        # baseline immediately (no substitution from a partially-probed
        # gate can survive) and stop — the remaining obligations must not
        # probe against a polluted state.
        all_ok = false
        subst_restore(env, &baseline)
        errors_truncate(env, errs_baseline)
        break
      end
    end
  end
  if !all_ok then
    subst_restore(env, &baseline)
    errors_truncate(env, errs_baseline)
  end
  all_ok
end

# The FIRST unsolved bound of an inapplicable bounded impl — the specific
# diagnostic for a method whose impl bounds the receiver does not satisfy.
# Returns Some((param_name, trait_name)) — e.g. ("T", "Copy") for
# `impl[T: Copy] RingBuffer[T]` on RingBuffer[String] — or Option::None when
# every obligation solves. The probe replays impl_bounds_satisfied's gate
# shape (head unification + per-obligation solve, in the impl's declaration
# order) and stops at the FIRST obligation that fails; the whole replay is
# transactional (snapshot/restore — no substitution or diagnostic residue).
def impl_bounds_violation(inout env: TypeEnv, info: ImplInfo, recv_type: Type) -> Option[(String, String)]
  if info.obligations.is_empty() then
    return Option::None
  end
  let baseline = subst_snapshot(env)
  let errs_baseline = env.errors.len()
  var vars = Vec::new()
  var i = 0
  while i < info.generic_params.len() do
    vars.push(fresh_type_var(env))
    i = i + 1
  end
  let head_inst = subst_type_args(&info.for_type, &info.generic_params, &vars)
  var all_ok = try_head_unify(env, head_inst, recv_type.clone())
  if all_ok then
    for obligation in info.obligations do
      let self_ty = resolve_type_var(env, subst_type_args(&obligation.subject, &info.generic_params, &vars))
      var ob_args = Vec::new()
      for ob_arg in obligation.args do
        ob_args.push(resolve_type_var(env, subst_type_args(&ob_arg, &info.generic_params, &vars)))
      end
      let ob = Obligation { trait_ref: TraitRef { trait_id: obligation.trait_id, self_ty: self_ty, args: ob_args }, trait_name: obligation.trait_name }
      if !solve_obligation(env, &ob) then
        let pname = match obligation.subject
        when Type::Param(gpid) then generic_param_name_of(&env.generic_param_table, &gpid)
        when _ then "T".to_string()
        end
        subst_restore(env, &baseline)
        errors_truncate(env, errs_baseline)
        return Option::Some((pname, obligation.trait_name.clone()))
      end
    end
  end
  subst_restore(env, &baseline)
  errors_truncate(env, errs_baseline)
  Option::None
end

# ———————————————————————————————————————————————————————————————
# Type-Property Engine — the ownership/linearity AUTHORITY
# ———————————————————————————————————————————————————————————————
#
# Memoized per-type property computation over the full concrete type graph.
# type_properties_of walks a type structurally (fields/variants/args),
# memoized in env.type_prop_cache by a canonical structural string key
# (type_identity_key_resolved — it includes the concrete generic args, so
# Wrapper[Int] and Wrapper[File] are distinct cache entries). The walk uses
# the graph algorithm:
#
#   Unvisited -> mark Visiting -> compute from children -> mark Resolved
#
# A Visiting revisit is a recursion through INLINE storage — the layout
# engine panics on such types; this engine reports a TypeError diagnostic
# ("infinitely sized recursive type") instead and treats the revisit as
# NON-owning-but-unsafe: owns_state=false/requires_drop_glue=false and
# is_trivially_copyable=false.
# Indirections (Ptr/Box/Rc) terminate the walk: their properties are decided
# by the pointer layer, not the pointee.
#
# THERE IS NO DEPTH-BASED SEMANTIC SHORTCUT: the Visiting/Resolved graph
# algorithm is the complete cycle solution, so a deep-but-finite chain
# (Wrapper[Wrapper[...File...]]) is walked to its concrete leaves and
# classified by them — it can never be "too deep to know" and fall back to
# owns_state=false/requires_drop_glue=false/is_linear=false. Any compiler
# resource limit that is ever reintroduced must be a compilation diagnostic
# (an error), never a semantic answer.
#
# CONCRETE OWNERSHIP vs NOMINAL TypeKind: this engine computes ownership for
# the concrete type identity (TypeId, substitutions). The nominal
# TypeDef.kind carries the DECLARED kind only (Resource/Capability markers);
# the kind-propagation pass is are not part of the model — no ownership is ever folded
# back into the declaration.
#
# GENERIC OWNERSHIP POLYMORPHISM (the deferred contract): a Type::Param (or
# an unresolved Type::Var) in the type graph yields is_deferred=true — the
# answer is "unknown/deferred", NEVER a concrete semantic answer. A generic
# local may require CONDITIONAL drop after substitution, so while deferred
# the six semantic fields are non-authoritative (false = "not proven
# true"). The concrete answers appear only after substitution: the MIR/mono
# consumer wave substitutes the Param and re-queries this engine on the
# concrete instantiation. Container layers that decide a property
# unconditionally keep it concrete (e.g. Vec[T] requires_drop_glue=true
# regardless of T; Slice[T] is a non-owning view regardless of T).
#
# STRING CONTRACT (— the owned String object, — REAL
# LIFETIME): String owns a UNIQUE heap buffer. The String VALUE is ONE
# 8-byte pointer to the 32-byte String OBJECT header {data@0, len@8,
# cap@16, stride@24} (data points to the null-terminated UTF-8 bytes; the
# header is what mutation needs — push/push_str grow the owned buffer in
# place). owns_state=true is the ownership contract (moves transfer the
# buffer; it is never bit-copyable — String is Clone, NOT Copy). (the
# real allocation/deallocation semantics): the String OBJECT and its data
# buffer are allocated from the real heap (_tg_mem_alloc — the malloc-
# style pair with _tg_mem_free, the same allocator the Vec data buffers
# use), NEVER the raw bump arena; _tg_string_reserve releases the old
# buffer at the growth boundary; and the String drop (the _tg_string_drop
# emitter — the MIR's DeinitPlan::String destructor, emitted at the
# value's semantic lifetime boundary) frees the object AND the buffer.
# Therefore requires_drop_glue=true for String and String-containing
# aggregates, and the MIR drop plan for String is the real destructor —
# the former Trivial plan (arena reclaim as a "runtime detail") is are not part of the model.
#
# This engine is THE ownership authority: the resource checker and MIR
# consume it on the concrete type identity (engine_snapshot_env /
# deinit_plan_for_type); within this file, type_has_resource_kind routes
# through it.

# Entry point: memoized properties for a fully resolved concrete type.
pub def type_properties_of(inout env: TypeEnv, ty: Type) -> TypeProperties
  var visiting: Map[String, TypePropVisitState] = Map::new()
  let resolved = resolve_type_var(env, ty.clone())
  type_props_walk(env, &resolved, &mut visiting, false)
end

# The per-call visiting set is LOCAL (a fresh top-level call must not see a
# stale Visiting state); the memo cache is persistent in the env, and entries
# are only inserted once a key is fully Resolved — never while Visiting.
# (recursive owning types): `via_heap` is true when the current walk
# crossed a HEAP-BACKED container boundary (Vec/Array/Map/Set — the
# container's element walk). A Visiting revisit through such a boundary is
# the recursive owning shape (Tree -> Vec[Tree], Json -> Map[String, Json])
# — the recursion is BOUNDED by the heap (it terminates at runtime when the
# container is empty), so the revisit contributes NO properties (the
# container arms already claimed the ownership) and no diagnostic. A
# revisit through INLINE storage only is the infinitely-sized error below.
def type_props_walk(inout env: TypeEnv, ty: Type, inout visiting: Map[String, TypePropVisitState], via_heap: Bool) -> TypeProperties
  let key = type_identity_key_resolved(env, ty)
  match env.type_prop_cache.get(key)
  when Option::Some(cached) then
    return cached.clone()
  when Option::None then ()
  end
  match visiting.get(key)
  when Option::Some(state) then
    if state == TypePropVisitState::Visiting then
      if via_heap then
        # The recursion crossed a heap-backed container boundary: the
        # recursive owning shape — the revisit contributes nothing (the
        # container's own arm claimed owns_state/requires_drop_glue; the
        # element's linearity/capability containment was decided by the
        # boundary-crossing arm's first visit).
        return TypeProperties { owns_state: false, requires_drop_glue: false, is_linear: false, is_capability: false, contains_capability: false, is_trivially_copyable: false, is_transferable: false, is_shareable: false, is_deferred: false }
      end
      # Recursion through INLINE storage: infinitely sized recursive type.
      # The layout engine panics on such types; the property engine reports
      # the diagnostic instead. The revisit is NON-owning-but-unsafe:
      # owns_state=false/requires_drop_glue=false (no ownership claimed) and
      # is_trivially_copyable=false (an infinitely sized value can never be
      # copied). The diagnostic (an error) is the semantic answer — never a
      # silent fail-open value.
      env.errors.push(TypeError {
        message: "infinitely sized recursive type: inline storage cycle (use a pointer or Box to break the cycle)",
        span: Span { file: "", start: 0, end_pos: 0 },
        code: Option::None
      })
      return TypeProperties { owns_state: false, requires_drop_glue: false, is_linear: false, is_capability: false, contains_capability: false, is_trivially_copyable: false, is_transferable: false, is_shareable: false, is_deferred: false }
    end
  when Option::None then ()
  end
  visiting.insert(key.clone(), TypePropVisitState::Visiting)
  var props = TypeProperties { owns_state: false, requires_drop_glue: false, is_linear: false, is_capability: false, contains_capability: false, is_trivially_copyable: false, is_transferable: false, is_shareable: false, is_deferred: false }
  match ty
  # Plain data: no drop, not linear, not a capability, bit-copyable.
  when Type::Unit then ()
  when Type::Bool then ()
  when Type::Int then ()
  when Type::UInt then ()
  when Type::Float then ()
  when Type::Char then ()
  when Type::Never then ()
 # (inference-only): an integer literal is plain scalar data — no
  # drop, not linear, not a capability, bit-copyable.
  when Type::IntLiteral(_) then ()
  when Type::I8 then ()
  when Type::I16 then ()
  when Type::I32 then ()
  when Type::I64 then ()
  when Type::I128 then ()
  when Type::U8 then ()
  when Type::U16 then ()
  when Type::U32 then ()
  when Type::U64 then ()
  when Type::U128 then ()
  when Type::ISize then ()
  when Type::USize then ()
  when Type::F32 then ()
  when Type::F64 then ()
  # String owns a unique heap buffer — the OWNED String object:
  # the value is one pointer to the 32-byte {data,len,cap,stride} String
  # object; see the contract in std/core.tg and runtime.tg "String Object
 # Runtime"). (real String lifetime): the object AND its buffer are
  # real-heap allocations (_tg_mem_alloc-style) with a real destructor —
  # requires_drop_glue=true, so the MIR drop plan for String is the
  # String destructor (DeinitPlan::String — _tg_string_drop), never a
  # Trivial plan. owns_state=true stays the ownership contract (the
  # checker's resource axis — never bit-copyable: clone() is the explicit
  # allocation).
  when Type::String then
    props.owns_state = true
    props.requires_drop_glue = true
 # (typed view): the static StaticStrPtr of a literal is a
  # VIEW — a raw pointer to the interned static bytes. It owns nothing
  # (the static bytes are never freed), requires no drop glue, and is
  # bit-copyable (is_trivially_copyable_walk answers true for
  # StaticStrPtr).
  when Type::StaticStrPtr then ()
  # Raw pointers terminate the walk: no ownership, no drop, bit-copyable.
  when Type::Ptr(_) then ()
  when Type::PtrMut(_) then ()
  when Type::Tuple(fields) then
    var i = 0
    while i < fields.len() do
      let fp = type_props_walk(env, &fields[i], visiting, via_heap)
      if fp.owns_state then props.owns_state = true end
      if fp.requires_drop_glue then props.requires_drop_glue = true end
      if fp.is_linear then props.is_linear = true end
      if fp.contains_capability then props.contains_capability = true end
      if fp.is_deferred then props.is_deferred = true end
      i = i + 1
    end
  # The builtin compound Adt forms (Box/Rc/Option/Result/Slice/Array/Map/
  # Set) are classified in type_named_props by their LangItems TypeIds.
  when Type::Adt(tid, args) then
    type_named_props(env, tid, args, visiting, via_heap, &mut props)
  # Fixed arrays are inline element storage: the element's ownership
  # propagates (owns_state / requires_drop_glue / linearity / capability
  # containment walk the element).
  when Type::FixedArray(elem, _) then
    let fp = type_props_walk(env, &elem, visiting, via_heap)
    if fp.owns_state then props.owns_state = true end
    if fp.requires_drop_glue then props.requires_drop_glue = true end
    if fp.is_linear then props.is_linear = true end
    if fp.contains_capability then props.contains_capability = true end
    if fp.is_deferred then props.is_deferred = true end
  # Closures/functions with environments and dyn/effect forms carry
  # checker-managed state: nothing here owns or copies.
 # (FnPtr/Closure split): a function POINTER carries no environment;
  # a CLOSURE's properties derive from its CAPTURE TUPLE (a closure
  # capturing an owning value owns it; the capture tuple's
  # requires_drop_glue / linearity / capability containment propagate).
  when Type::FnPtr(_, _, _) then ()
  when Type::Closure(_, _, _, captures, _) then
    let cp = type_props_walk(env, &captures, visiting, via_heap)
    if cp.owns_state then props.owns_state = true end
    if cp.requires_drop_glue then props.requires_drop_glue = true end
    if cp.is_linear then props.is_linear = true end
    if cp.contains_capability then props.contains_capability = true end
    if cp.is_deferred then props.is_deferred = true end
  when Type::Dyn(_) then ()
  when Type::Effect(_, _) then ()
  # A ref to a capability contains a capability (the borrow does not
  # transfer it) — capability containment propagates through the ref,
  # mirroring the checker's containment walk; no other property crosses
  # the ref boundary.
  when Type::RefInternal(inner, _) then
    let rp = type_props_walk(env, inner, visiting, via_heap)
    if rp.contains_capability then props.contains_capability = true end
  when Type::Var(_) then
    # An unresolved inference variable is DEFERRED (fail-closed):
    # resolve_type_var resolves at the entry point; a Var that survives has
    # no decided binding, so no concrete semantic answer may be given.
    props.is_deferred = true
  when Type::Param(_) then
    # Generic ownership polymorphism: an unsubstituted generic parameter is
    # UNKNOWN/DEFERRED, never a concrete semantic answer — a generic local
    # may require conditional drop after substitution. The six semantic
    # fields stay false but are NON-authoritative (is_deferred is set);
    # concrete answers appear only after substitution (the MIR/mono wave).
    props.is_deferred = true
  when Type::Error then ()
  end
 # is_trivially_copyable comes from FIX 1: the decided bit-copy set.
  # A deferred type carries NO concrete answer here — the field stays false
  # (non-authoritative; the is_deferred flag is set) until substitution.
  # (concurrency properties): the concurrency properties are the derived
  # queries — the transferable walk and the shareable walk (the single
  # authority; the engine answers through the SAME derivation the solver
  # uses, so the two paths cannot disagree by construction). Deferred
  # types carry no concrete answer (false + is_deferred).
  if !props.is_deferred then
    props.is_trivially_copyable = is_trivially_copyable(env, ty)
    props.is_transferable = is_send(env, ty)
    props.is_shareable = is_sync(env, ty)
  end
  visiting.insert(key.clone(), TypePropVisitState::Resolved)
  env.type_prop_cache.insert(key, props.clone())
  props
end

# True when the type has a registered `impl Drop for T` in the impl registry
# — the TypeEnv-side proxy for a "registered deinit target" (the authoritative
# deinit targets/plans live in TypedProgram; this engine runs on the TypeEnv).
def type_has_registered_drop(env: TypeEnv, tid: TypeId) -> Bool
  var i = 0
  while i < env.impls.len() do
    let imp = env.impls[i]
 # the Drop identity is the LangItems TraitId — never the name.
    if imp.trait_id.id == env.lang_items.drop_trait then
      match imp.for_type
      when Type::Adt(imp_tid, _) then
        if imp_tid.id == tid.id then
          return true
        end
      when _ then ()
      end
    end
    i = i + 1
  end
  false
end

# Named-type property computation: built-in names decide directly (their
# registered shapes must NOT be walked — Vec's shape is { ptr: Ptr[T],... }
# and would look non-owning and bit-copyable); user aggregates walk their
# fields/variants with the concrete args substituted.
#
# THE CONTAINER LAYER IS THE OWNERSHIP AUTHORITY (per its real contract):
#   Vec[T] / Array[T]  — heap-vector HANDLE owning its buffer:
#                        owns_state = requires_drop_glue = true REGARDLESS
#                        of T; is_linear = the chosen move model of T
#                        (T.is_linear)
#   Map[K,V] / Set[T]  — heap map/set handle: owns_state =
#                        requires_drop_glue = true regardless of K/V;
#                        element linearity stays viral
#   Option[T]          — inline tagged storage: the T bundle propagates
#                        (owns_state/requires_drop_glue = T's)
#   Result[T,E]        — inline tagged storage: T || E propagation
#   FixedArray[T,N]    — inline element storage (the Type::FixedArray arm):
#                        element propagation only
#   String             — owns a unique buffer: owns_state = true (see the
#                        STRING CONTRACT note above — the owned String
#                        object), requires_drop_glue = false (the arena
#                        reclaims — no per-value Drop)
#   Slice[T]           — non-owning {ptr,len} view: owns nothing, drop=none
#
# SMART-POINTER LINEARITY (the shared handles are NOT linear — their clone
# is the retain/increment, the normal duplication operation; only the unique
# owners are move-only):
#   Box / UniquePtr    — owns_state = requires_drop_glue = true, is_linear = true
#   Rc / ArcStrong / WeakRc / WeakArc — owns_state = requires_drop_glue =
#                        true, is_linear = false
def type_named_props(inout env: TypeEnv, tid: TypeId, args: Vec[Type], inout visiting: Map[String, TypePropVisitState], via_heap: Bool, inout props: TypeProperties) -> Unit
  match get_type_by_id_ref(env, tid)
  when Option::Some(td) then
    if td.kind == TypeKind::Resource || td.kind == TypeKind::Capability then
      # Resources/capabilities are linear by kind; is_capability is the
      # TypeKind::Capability marker, and a capability type contains a
      # capability (itself).
      props.is_linear = true
      if td.kind == TypeKind::Capability then
        props.is_capability = true
        props.contains_capability = true
      end
    end
    if type_has_registered_drop(env, tid) then
      # A registered Drop impl (File's fd-close,...) is BOTH an ownership
      # claim and a physical destructor: the drop glue must run.
      props.owns_state = true
      props.requires_drop_glue = true
    end
    # Named owning smart pointers: owns an allocation or reference-count
    # state. The UNIQUE owners (Box, UniquePtr) are linear — a bitwise copy
    # would duplicate unique ownership. The SHARED reference-counted handles
    # (Rc, ArcStrong, WeakRc, WeakArc) are NOT linear: clone() is the
    # retain/increment. The whole family is selected by LangItems TypeId —
    # never by name (the std-declared ids resolve via the post-pass-2
    # rebuild; -1 marks an unregistered snapshot, which fails closed —
    # no name fallback).
    if tid.id == env.lang_items.box_ || tid.id == env.lang_items.rc ||
       (env.lang_items.unique_ptr != -1 && tid.id == env.lang_items.unique_ptr) ||
       (env.lang_items.weak_rc != -1 && tid.id == env.lang_items.weak_rc) ||
       (env.lang_items.arc_strong != -1 && tid.id == env.lang_items.arc_strong) ||
       (env.lang_items.weak_arc != -1 && tid.id == env.lang_items.weak_arc) then
      props.owns_state = true
      props.requires_drop_glue = true
      if tid.id == env.lang_items.box_ || (env.lang_items.unique_ptr != -1 && tid.id == env.lang_items.unique_ptr) then
        props.is_linear = true
      end
    elsif tid.id == env.lang_items.vec || tid.id == env.lang_items.array || tid.id == env.lang_items.map ||
          tid.id == env.lang_items.set then
      # Heap-backed container HANDLES OWN their allocation: owns_state =
      # requires_drop_glue = TRUE regardless of the element types (Vec[Int]
      # still frees its buffer; Map[Int,Int] still frees its bucket arena).
      # Element linearity is viral over the concrete args (the chosen move
      # model of T); element deferral propagates (Vec[T] with T
      # unsubstituted has an undecided is_linear — is_deferred); element
      # capability containment is viral (a Vec of capabilities holds
      # capabilities).
      props.owns_state = true
      props.requires_drop_glue = true
      var i = 0
      while i < args.len() do
 # the element walk crosses the HEAP boundary (via_heap=true) —
        # a recursive owning shape (Tree -> Vec[Tree]) revisits its own
        # type through this boundary and terminates without the inline-cycle
        # diagnostic.
        let ap = type_props_walk(env, &args[i], visiting, true)
        if ap.is_linear then props.is_linear = true end
        if ap.contains_capability then props.contains_capability = true end
        if ap.is_deferred then props.is_deferred = true end
        i = i + 1
      end
    elsif tid.id == env.lang_items.option then
      # Option[T] is inline tagged storage: element propagation only (a
      # None carries nothing, a Some carries T — T's bundle decides).
      if args.len() >= 1 then
        let ap = type_props_walk(env, &args[0], visiting, via_heap)
        if ap.owns_state then props.owns_state = true end
        if ap.requires_drop_glue then props.requires_drop_glue = true end
        if ap.is_linear then props.is_linear = true end
        if ap.contains_capability then props.contains_capability = true end
        if ap.is_deferred then props.is_deferred = true end
      end
    elsif tid.id == env.lang_items.result then
      # Result[T,E] is inline tagged storage: element propagation only.
      if args.len() >= 2 then
        let tp = type_props_walk(env, &args[0], visiting, via_heap)
        let ep = type_props_walk(env, &args[1], visiting, via_heap)
        if tp.owns_state || ep.owns_state then props.owns_state = true end
        if tp.requires_drop_glue || ep.requires_drop_glue then props.requires_drop_glue = true end
        if tp.is_linear || ep.is_linear then props.is_linear = true end
        if tp.contains_capability || ep.contains_capability then props.contains_capability = true end
        if tp.is_deferred || ep.is_deferred then props.is_deferred = true end
      end
    elsif tid.id == env.lang_items.slice then
      # UnsafeSlice[T] — the RAW view { ptr: Ptr[T], len: UInt }:
      # owns=false, drop=none, not linear, contains no capability (the raw
      # view holds no payload — the capability lives in the backing
      # buffer). The element type's ownership lives in the backing buffer,
      # never in the view; nothing here walks the args (mirror of the
      # Ptr/StaticStrPtr classification). The SAFE shared/pinned form
      # (the source-spelled Slice / StrView — the Arc-class views) is NOT
      # this arm: the
      # std-declared struct's Arc field owns, and the structural walk
      # applies.
      ()
    elsif (env.lang_items.ptr != -1 && tid.id == env.lang_items.ptr) ||
          (env.lang_items.ptr_mut != -1 && tid.id == env.lang_items.ptr_mut) then
      # Raw pointers: no ownership; the pointer layer decides (LangItems
      # ptr/ptr_mut ids — never a name comparison).
      ()
    elsif env.lang_items.string != -1 && tid.id == env.lang_items.string then
      # String owns a unique heap buffer — the OWNED String object
 # (the value is one pointer to the 32-byte
 # {data,len,cap,stride} object). (real String lifetime): the
      # object AND its buffer are real-heap allocations (_tg_mem_alloc-
      # style) with a real destructor (the String drop — DeinitPlan::String
      # — frees both), so requires_drop_glue=true — never the former
      # arena-reclaim Trivial split. The identity
      # is the LangItems string id — never a name comparison.
      props.owns_state = true
      props.requires_drop_glue = true
    else
      match td.def_kind
      when TypeDefKind::Struct(fields) then
        var i = 0
        while i < fields.len() do
          let f_ty = subst_type_args(&fields[i].ty, &td.generic_params, args)
          let fp = type_props_walk(env, &f_ty, visiting, via_heap)
          if fp.owns_state then props.owns_state = true end
          if fp.requires_drop_glue then props.requires_drop_glue = true end
          if fp.is_linear then props.is_linear = true end
 # (capability containment): an aggregate containing a
          # capability FIELD contains a capability (the substituted field
          # walk above is the propagation).
          if fp.contains_capability then props.contains_capability = true end
          if fp.is_deferred then props.is_deferred = true end
          i = i + 1
        end
      when TypeDefKind::Enum(variants) then
        var vi = 0
        while vi < variants.len() do
          var fi = 0
          while fi < variants[vi].fields.len() do
            let v_ty = subst_type_args(&variants[vi].fields[fi], &td.generic_params, args)
            let vp = type_props_walk(env, &v_ty, visiting, via_heap)
            if vp.owns_state then props.owns_state = true end
            if vp.requires_drop_glue then props.requires_drop_glue = true end
            if vp.is_linear then props.is_linear = true end
            if vp.contains_capability then props.contains_capability = true end
            if vp.is_deferred then props.is_deferred = true end
            fi = fi + 1
          end
          vi = vi + 1
        end
      when TypeDefKind::Alias(inner) then
        let inner_ty = subst_type_args(&inner, &td.generic_params, args)
        let ip = type_props_walk(env, &inner_ty, visiting, via_heap)
        if ip.owns_state then props.owns_state = true end
        if ip.requires_drop_glue then props.requires_drop_glue = true end
        if ip.is_linear then props.is_linear = true end
        if ip.is_capability then props.is_capability = true end
        if ip.contains_capability then props.contains_capability = true end
        if ip.is_deferred then props.is_deferred = true end
      when _ then ()
      end
    end
  when Option::None then ()
  end  end
end

def find_method_params(inout env: TypeEnv, recv_type: Type, method: String) -> Option[Vec[ParamType]]
  let resolved_base = resolved_receiver_base(env, recv_type)
  match resolved_base
  when Type::Error then return Option::None
  when _ then ()
  end
  match resolved_base
  when Type::Adt(tid, _) then
    match env.method_lookup.get(tid.id)
    when Option::Some(mmap) then
      match mmap.get(method)
      when Option::Some(cands) then
        var ci = 0
        while ci < cands.len() do
          let info = env.impls[cands[ci]]
          if impl_for_type_matches(&info.for_type, &resolved_base) then
            # Generic obligation gate: a bounded impl is only applicable when
            # the concrete receiver satisfies its where-clause obligations
            # (solved by the real obligation solver, driven by impl-HEAD
            # unification). This makes `impl[T: Copy] Array[T]` a REAL
            # constraint — a resource element cannot select methods from it,
            # and Eq/Hash gate exactly as the std's impls say.
            if impl_bounds_satisfied(env, &info, &resolved_base) then
              var mi = 0
              while mi < info.methods.len() do
                let m = info.methods[mi]
                if m.name == method then
                  return Option::Some(m.params.clone())
                end
                mi = mi + 1
              end
            end
          end
          ci = ci + 1
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end
 # extension-impl methods — the receiver has no registered method
  # of this name (or the impl's head is a generic parameter); fall back to
  # the param-for_type impls, whose method signature supplies the
  # conventions the call-site effect/arity logic consumes.
  match find_param_for_type_method(env, method)
  when Option::Some((pimp_idx, pmid_idx)) then
    let pimp2 = env.impls[pimp_idx]
    Option::Some(pimp2.methods[pmid_idx].params.clone())
  when Option::None then Option::None
  end
end

# Extract the element type of a container (Array/Vec, Map, Option-like)
# from a receiver type, in both canonical and Named forms. Used by the
# resource-extraction rule below: a shared read of a resource element would
# duplicate ownership out of a container that stays live.
def container_element_type(env: TypeEnv, ty: Type) -> Option[Type]
  match ty
  when Type::Adt(tid, args) then
    # The Adt form of the element-bearing builtin containers (LangItems
    # ids): Map yields its value, Array/Vec and the RAW view (UnsafeSlice)
    # yield their element. (The SAFE source-spelled Slice is the
    # std-declared shared struct — its element access is the compiled std
    # get method, never this rule.)
    if tid.id == env.lang_items.map && args.len() >= 2 then Option::Some(args[1].clone())
    elsif (tid.id == env.lang_items.array || tid.id == env.lang_items.vec || tid.id == env.lang_items.slice) && args.len() >= 1 then Option::Some(args[0].clone())
    else Option::None
    end
  when Type::FixedArray(elem, _) then Option::Some(elem.clone())
  when _ then Option::None
  end  end
end

# Expected explicit-argument count for a method call: the declared params
# with `self` (if present) excluded. Self-less "static-style" methods
# (e.g. Array::from, Map::new called with method syntax) have no receiver
# parameter, so the count is the full param list length.
def find_method_expected_args(inout env: TypeEnv, recv_type: Type, method: String) -> Option[Int]
  let resolved_base = resolved_receiver_base(env, recv_type)
  match resolved_base
  when Type::Error then return Option::None
  when _ then ()
  end
  match resolved_base
  when Type::Adt(tid, _) then
    match env.method_lookup.get(tid.id)
    when Option::Some(mmap) then
      match mmap.get(method)
      when Option::Some(cands) then
        var ci = 0
        while ci < cands.len() do
          let info2 = env.impls[cands[ci]]
          if impl_for_type_matches(&info2.for_type, &resolved_base) then
            if impl_bounds_satisfied(env, &info2, &resolved_base) then
              var mi = 0
              while mi < info2.methods.len() do
                let m = info2.methods[mi]
                if m.name == method then
                  if m.has_self then
                    return Option::Some(m.params.len() - 1)
                  end
                  return Option::Some(m.params.len())
                end
                mi = mi + 1
              end
            end
          end
          ci = ci + 1
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end
 # extension-impl methods — same fallback as find_method_params:
  # the param-for_type impls are not indexed by receiver TypeId.
  match find_param_for_type_method(env, method)
  when Option::Some((pimp_idx, pmid_idx)) then
    let pimp3 = env.impls[pimp_idx]
    let m3 = pimp3.methods[pmid_idx]
    if m3.has_self then
      Option::Some(m3.params.len() - 1)
    else
      Option::Some(m3.params.len())
    end
  when Option::None then Option::None
  end
end

def field_target_of(env: TypeEnv, recv_type: Type, field: String) -> Option[FieldId]
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end
  match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Struct(fields) then
        var i = 0
        while i < fields.len() do
          if fields[i].name == field then
            return Option::Some(FieldId { owner: tid, index: i })
          end
          i = i + 1
        end
        Option::None
      when TypeDefKind::Alias(inner) then field_target_of(env, &inner, field)
      when _ then Option::None
      end
    when Option::None then Option::None
    end
  when _ then Option::None
  end
end

# Resolve a struct field's TYPE from its FieldId (owner TypeId + index) —
# the ID-based counterpart of field_target_of. The FieldId is the semantic
# field identity (the same id recorded in typed_field_targets / field_targets);
# the field NAME is used only for diagnostics.
def field_type_by_id(inout env: TypeEnv, recv_type: Type, owner: TypeId, index: Int, field: String, span: Span) -> Type
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end
  match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Alias(inner) then
        # field_target_of resolved the alias chain, so the FieldId's owner is
        # the FINAL struct; recurse with the alias target so the generic
        # substitution below uses the struct's concrete instantiation args
        # (e.g. `typealias Duration = Timespec`), not the alias's own.
        return field_type_by_id(env, &inner, owner, index, field, span)
      when _ then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end
  match base
  when Type::Adt(_, type_args) then
    match get_type_by_id_ref(env, &owner)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Struct(fields) then
        if index >= 0 && index < fields.len() then
          # Substitute generic type parameters with the receiver's concrete
          # type arguments (e.g. Vec[Int].ptr is Ptr[Int], not Ptr[Param("T")]).
          subst_type_args(&fields[index].ty, &td.generic_params, &type_args)
        else
          type_add_error(env, "no field `" + field + "` on type `" + td.name + "`", span)
          Type::Error
        end
      when _ then
        type_add_error(env, "no field `" + field + "` on type `" + td.name + "`", span)
        Type::Error
      end
    when Option::None then
      type_add_error(env, "no field `" + field + "`", span)
      Type::Error
    end
  when _ then
    type_add_error(env, "no field `" + field + "`", span)
    Type::Error
  end
end

# The node the resolver keyed a call target under, given the callee
# expression: the resolver's call_targets are keyed by the CALLEE
# expression's AST node id (resolve_ident_expr / resolve_path record the
# ident/path node — the node-id keying), never by the call node. An
# ident or a path callee is its own node; an access wrapper (ExprAccess)
# and an explicit-generic `f[T](...)` callee (ExprIndex — the base ident is
# the resolved callable, e.g. `size_of[T]()`) resolve through their inner
# node — the node the resolver actually keyed. -1 for callee shapes that
# carry no resolver key (a local closure value, a function-pointer field
# access, a computed callee) — the closure-call fallback in
# record_typed_hir applies for those.
def typed_callee_target_node(callee: Expr) -> Int
  match callee.kind
  when ExprKind::ExprIdent(_) then callee.node_id
  when ExprKind::ExprPath(_) then callee.node_id
  when ExprKind::ExprAccess(inner) then typed_callee_target_node(&inner)
  when ExprKind::ExprIndex(base, _) then typed_callee_target_node(&base)
  when _ then -1
  end  end
end

# Bridge the resolver's callee-node keying into the typed call-target map's
# CALL-node keying: read the resolver's DefId under the callee's recorded
# node (typed_callee_target_node) and record it under the CALL node's id —
# the key typed_call_for and the MIR's call_def_ids consume. The DIRECT-CALL
# effect recording rides the same site: when the callee has DECLARED
# effects, the enclosing function's computed effect set accumulates them
# (record_effect_call). An UNRESOLVED callee (a closure value, a
# function-pointer field access, a computed callee) records no DefId — the
# missing-metadata rule: the construction never silently defaults the
# callee — but its EFFECTS are still recorded through the callee's TYPE
# (record_indirect_call_effects): the callable types carry the effect set
# (Type::FnPtr/Type::Closure's effect payload), so an indirect call is
# NEVER effect-unknown/effect-free — effect-unknown at the call site is
# unsound, and the callable type is the site's only sound source.
def record_typed_call_target(inout env: TypeEnv, callee: Expr, node_id: Int) -> Unit
  let target_node = typed_callee_target_node(callee)
  if target_node < 0 then return end
  var did_opt: Option[DefId] = Option::None
  match env.resolutions
  when Option::Some(res) then
 # the resolver's call_targets are keyed by AST node id — never
    # by span.
    match res.call_targets.get(target_node)
    when Option::Some(did) then did_opt = Option::Some(did)
    when Option::None then ()
    end
  when Option::None then ()
  end
  match did_opt
  when Option::Some(did) then
    env.typed_call_targets.insert(node_id, did.clone())
    record_effect_call(env, Option::Some(did))
  when Option::None then
    # Indirect call: no resolver target — record the callee TYPE's effect
    # set into the enclosing function's computed set (the FnPtr/Closure
    # effect payload; a non-callable or effectless callee records
    # nothing).
    record_indirect_call_effects(env, &callee)
  end
end

# The INDIRECT-CALL effect recording — the checker's call sites with a
# non-resolved callee (a closure value, a function-pointer field access, a
# computed callee): the callee's recorded TYPE (the FnPtr/Closure effect
# payload — the declared effects of the fn-item value, or the closure
# body's computed effects) accumulates into the enclosing function's
# computed effect set, exactly like a direct call's declared effects. This
# closes the unsoundness where effect-unknown was effect-free: an indirect
# call through a callable whose type carries effects is effectful at the
# call site. A callee with no recorded type (or a non-callable type)
# records nothing — the typed type map is the authority, never a guess.
def record_indirect_call_effects(inout env: TypeEnv, callee: Expr) -> Unit
  if env.current_fn_key == "" then return end
  let target_node = typed_callee_target_node(callee)
  if target_node < 0 then return end
  var callee_effs = Vec::new()
  match env.typed_expr_types.get(target_node)
  when Option::Some(cty) then
    match cty
    when Type::FnPtr(_, _, effects) then callee_effs = effects.clone()
    when Type::Closure(_, _, _, _, effects) then callee_effs = effects.clone()
    when _ then ()
    end
  when Option::None then ()
  end
  if callee_effs.len() > 0 then
    match env.fn_computed_effects.get(env.current_fn_key.clone())
    when Option::Some(comp) then
      var new_comp = comp.clone()
      let _ = effect_set_append(&mut new_comp, callee_effs)
      env.fn_computed_effects.insert(env.current_fn_key.clone(), new_comp)
    when Option::None then
      env.fn_computed_effects.insert(env.current_fn_key.clone(), callee_effs)
    end
  end
end

# The DIRECT-CALL effect recording — the checker's call sites: when the
# callee has DECLARED effects (the def-key table the registration sites
# filled), the caller's COMPUTED effect set accumulates them (the
# per-function computed set — the union of the callees' declared effects,
# closed transitively over the recorded call graph by check_effect_sets at
# the end of the program check). The call-graph edge is recorded for every
# resolved direct call, whether or not the callee carries effects (the
# transitive closure reads the graph). The same callee-declared effects
# accumulate into the CURRENT CLOSURE's computed set when the call sits
# inside a closure body (current_closure_node != 0) — the closure type's
# effect payload (Type::Closure's 5th field) is the indirect-call source
# for that closure value. Unresolved callees record through
# record_indirect_call_effects (the callable type's effect set) — an
# indirect call is never effect-unknown/effect-free.
def record_effect_call(inout env: TypeEnv, callee: Option[DefId]) -> Unit
  if env.current_fn_key == "" then return end
  match callee
  when Option::Some(did) then
    let callee_key = fn_effect_def_key(env, &did)
    var callee_effs = Vec::new()
    match env.fn_declared_effects.get(callee_key.clone())
    when Option::Some(effs) then callee_effs = effs.clone()
    when Option::None then ()
    end
    if callee_effs.len() > 0 then
      match env.fn_computed_effects.get(env.current_fn_key.clone())
      when Option::Some(comp) then
        var new_comp = comp.clone()
        let _ = effect_set_append(&mut new_comp, callee_effs.clone())
        env.fn_computed_effects.insert(env.current_fn_key.clone(), new_comp)
      when Option::None then
        env.fn_computed_effects.insert(env.current_fn_key.clone(), callee_effs.clone())
      end
      # The closure-body accumulation: the same effectful call inside a
      # closure body lands in the closure's own computed set (the effect
      # set its TYPE carries for indirect-call recording).
      if env.current_closure_node != 0 then
        match env.closure_computed_effects.get(env.current_closure_node)
        when Option::Some(ceffs) then
          var new_ceffs = ceffs.clone()
          let _ = effect_set_append(&mut new_ceffs, callee_effs.clone())
          env.closure_computed_effects.insert(env.current_closure_node, new_ceffs)
        when Option::None then
          env.closure_computed_effects.insert(env.current_closure_node, callee_effs.clone())
        end
      end
    end
    match env.fn_call_graph.get(env.current_fn_key.clone())
    when Option::Some(callees) then
      var new_callees = callees.clone()
      if !new_callees.contains(&callee_key) then
        new_callees.push(callee_key.clone())
        env.fn_call_graph.insert(env.current_fn_key.clone(), new_callees)
      end
    when Option::None then
      env.fn_call_graph.insert(env.current_fn_key.clone(), Vec::from([callee_key]))
    end
  when Option::None then ()
  end
end

struct CaptureScan
  bound: Vec[Int]
  uses: Map[Int, AccessEffect]
  # Per capture-NODE effects (expression node id -> effect): the same
  # capture record keyed by the referencing node instead of the captured
  # local id — the source for the closure arm's typed_access_effects
  # entries (the missing-metadata rule: after the closure is typed, every
  # capture node's effect is recorded).
  nodes: Map[Int, AccessEffect]
end

def capture_effect_strength(e: AccessEffect) -> Int
  match e
  when AccessEffect::Consume then 3
  when AccessEffect::Modify then 2
  when AccessEffect::Initialize then 2
  when _ then 1
  end  end
end

def scan_capture_record(env: TypeEnv, inout scan: CaptureScan, node_id: Int, name: String, effect: AccessEffect) -> Unit
  let lid = local_id_of(env, name.clone())
  if lid >= 0 then
    if !scan.bound.contains(&lid) then
      match scan.uses.get(&lid)
      when Option::Some(cur) then
        if capture_effect_strength(effect) > capture_effect_strength(cur) then
          scan.uses.insert(lid, effect)
        end
      when Option::None then
        scan.uses.insert(lid, effect)
      end
      # The node-level record follows the same capture gate (unbound local)
      # and the same strength rule — a node that is BOTH a consuming call
      # argument and a plain ident read (scan_operand then scan_expr visit
      # it twice) keeps the stronger effect.
      if node_id != 0 then
        match scan.nodes.get(node_id)
        when Option::Some(cur) then
          if capture_effect_strength(effect) > capture_effect_strength(cur) then
            scan.nodes.insert(node_id, effect)
          end
        when Option::None then
          scan.nodes.insert(node_id, effect)
        end
      end
    end
  end
end

def scan_root_ident(expr: Expr) -> Option[String]
  match expr.kind
  when ExprKind::ExprIdent(n) then Option::Some(n.clone())
  when ExprKind::ExprAccess(inner) then scan_root_ident(&inner)
  when ExprKind::ExprFieldAccess(base, _) then scan_root_ident(&base)
  when ExprKind::ExprIndex(base, _) then scan_root_ident(&base)
  when ExprKind::ExprRawDeref(inner) then scan_root_ident(&inner)
  when ExprKind::ExprCast(inner, _) then scan_root_ident(&inner)
  when _ then Option::None
  end  end
end

def scan_operand(env: TypeEnv, inout scan: CaptureScan, operand: Expr) -> Unit
  match env.typed_access_effects.get(operand.node_id)
  when Option::Some(eff) then
    if eff == AccessEffect::Modify || eff == AccessEffect::Consume || eff == AccessEffect::Initialize then
      match scan_root_ident(operand)
      when Option::Some(name) then scan_capture_record(env, scan, operand.node_id, name, eff)
      when Option::None then ()
      end
    end
  when Option::None then ()
  end
  scan_expr(env, scan, operand)  end
end

def scan_pattern_bind(env: TypeEnv, inout scan: CaptureScan, pat: Pattern) -> Unit
  match pat.kind
  when PatternKind::Wildcard then ()
  when PatternKind::Ident(name, _) then
    let lid = local_id_of(env, name.clone())
    if lid >= 0 then scan.bound.push(lid) end
  when PatternKind::Literal(e) then scan_expr(env, scan, &e)
  when PatternKind::Tuple(pats) then
    var i = 0
    while i < pats.len() do
      scan_pattern_bind(env, scan, &pats[i])
      i = i + 1
    end
  when PatternKind::Array(pats) then
    var i = 0
    while i < pats.len() do
      scan_pattern_bind(env, scan, &pats[i])
      i = i + 1
    end
  when PatternKind::Struct(_, field_pats) then
    var i = 0
    while i < field_pats.len() do
      scan_pattern_bind(env, scan, &field_pats[i].1)
      i = i + 1
    end
  when PatternKind::Variant(_, pats) then
    var i = 0
    while i < pats.len() do
      scan_pattern_bind(env, scan, &pats[i])
      i = i + 1
    end
  when PatternKind::Or(alts) then
    var i = 0
    while i < alts.len() do
      scan_pattern_bind(env, scan, &alts[i])
      i = i + 1
    end
  when PatternKind::Range(lo, hi, _) then
    match lo
    when Option::Some(e) then scan_expr(env, scan, &e)
    when Option::None then ()
    end
    match hi
    when Option::Some(e) then scan_expr(env, scan, &e)
    when Option::None then ()
    end
  end  end
end

def scan_block(env: TypeEnv, inout scan: CaptureScan, block: Block) -> Unit
  var i = 0
  while i < block.stmts.len() do
    scan_stmt(env, scan, &block.stmts[i])
    i = i + 1
  end
end

def scan_if_stmt(env: TypeEnv, inout scan: CaptureScan, if_stmt: IfStmt) -> Unit
  scan_expr(env, scan, &if_stmt.cond)
  scan_block(env, scan, &if_stmt.then_block)
  var i = 0
  while i < if_stmt.elsif_branches.len() do
    scan_expr(env, scan, &if_stmt.elsif_branches[i].0)
    scan_block(env, scan, &if_stmt.elsif_branches[i].1)
    i = i + 1
  end
  match if_stmt.else_block
  when Option::Some(eb) then scan_block(env, scan, &eb)
  when Option::None then ()
  end
end

def scan_match_expr(env: TypeEnv, inout scan: CaptureScan, m: MatchExpr) -> Unit
  scan_expr(env, scan, &m.scrutinee)
  var i = 0
  while i < m.arms.len() do
    scan_pattern_bind(env, scan, &m.arms[i].pattern)
    match m.arms[i].guard_expr
    when Option::Some(g) then scan_expr(env, scan, &g)
    when Option::None then ()
    end
    scan_block(env, scan, &m.arms[i].body)
    i = i + 1
  end
end

def scan_stmt(env: TypeEnv, inout scan: CaptureScan, stmt: Stmt) -> Unit
  match stmt.kind
  when StmtKind::StmtLet(pattern, _, value, _) then
    scan_expr(env, scan, &value)
    scan_pattern_bind(env, scan, &pattern)
  when StmtKind::StmtAssign(target, value) then
    match scan_root_ident(&target)
    when Option::Some(name) then scan_capture_record(env, scan, stmt.node_id, name, AccessEffect::Modify)
    when Option::None then ()
    end
    scan_expr(env, scan, &target)
    scan_expr(env, scan, &value)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    match scan_root_ident(&target)
    when Option::Some(name) then scan_capture_record(env, scan, stmt.node_id, name, AccessEffect::Modify)
    when Option::None then ()
    end
    scan_expr(env, scan, &target)
    scan_expr(env, scan, &value)
  when StmtKind::StmtIf(if_stmt) then scan_if_stmt(env, scan, &if_stmt)
  when StmtKind::StmtMatch(m) then scan_match_expr(env, scan, &m)
  when StmtKind::StmtWhile(cond, body) then
    scan_expr(env, scan, &cond)
    scan_block(env, scan, &body)
  when StmtKind::StmtFor(for_stmt) then
    scan_expr(env, scan, &for_stmt.iter)
    scan_pattern_bind(env, scan, &for_stmt.pattern)
    scan_block(env, scan, &for_stmt.body)
  when StmtKind::StmtLoop(body) then scan_block(env, scan, &body)
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then
      match scan_root_ident(&val)
      when Option::Some(name) then scan_capture_record(env, scan, val.node_id, name, AccessEffect::Consume)
      when Option::None then ()
      end
      scan_expr(env, scan, &val)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then scan_expr(env, scan, &val)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtExpr(e) then scan_expr(env, scan, &e)
  when StmtKind::StmtUnsafe(_, body) then scan_block(env, scan, &body)
  when StmtKind::StmtDefer(body) then scan_block(env, scan, &body)
  when StmtKind::StmtGuard(cond, else_action) then
    scan_expr(env, scan, &cond)
    match else_action
    when GuardElse::Return(val_opt) then
      match val_opt
      when Option::Some(val) then
        match scan_root_ident(&val)
        when Option::Some(name) then scan_capture_record(env, scan, val.node_id, name, AccessEffect::Consume)
        when Option::None then ()
        end
        scan_expr(env, scan, &val)
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(val_opt) then
      match val_opt
      when Option::Some(val) then scan_expr(env, scan, &val)
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
  when StmtKind::StmtTry(body, catches, finally_block) then
    scan_block(env, scan, &body)
    var i = 0
    while i < catches.len() do
      scan_pattern_bind(env, scan, &catches[i].pattern)
      scan_block(env, scan, &catches[i].body)
      i = i + 1
    end
    match finally_block
    when Option::Some(fb) then scan_block(env, scan, &fb)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, pat, body) then
    scan_expr(env, scan, &expr)
    scan_pattern_bind(env, scan, &pat)
    scan_block(env, scan, &body)
  when StmtKind::StmtHandleWith(expr, handlers) then
    scan_expr(env, scan, &expr)
    var i = 0
    while i < handlers.len() do
      var j = 0
      while j < handlers[i].arms.len() do
        var k = 0
        while k < handlers[i].arms[j].params.len() do
          scan_pattern_bind(env, scan, &handlers[i].arms[j].params[k])
          k = k + 1
        end
        scan_block(env, scan, &handlers[i].arms[j].body)
        j = j + 1
      end
      i = i + 1
    end
  end  end
end

def scan_expr(env: TypeEnv, inout scan: CaptureScan, expr: Expr) -> Unit
  match expr.kind
  when ExprKind::ExprIntLit(_) then ()
  when ExprKind::ExprFloatLit(_) then ()
  when ExprKind::ExprStringLit(_) then ()
  when ExprKind::ExprCharLit(_) then ()
  when ExprKind::ExprBoolLit(_) then ()
  when ExprKind::ExprNilLit then ()
  when ExprKind::ExprIdent(name) then scan_capture_record(env, scan, expr.node_id, name, AccessEffect::Read)
  when ExprKind::ExprSelfRef then scan_capture_record(env, scan, expr.node_id, "self".to_string(), AccessEffect::Read)
  when ExprKind::ExprPath(_) then ()
  when ExprKind::ExprArrayLit(elems) then
    var i = 0
    while i < elems.len() do
      scan_expr(env, scan, &elems[i])
      i = i + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    var i = 0
    while i < elems.len() do
      scan_expr(env, scan, &elems[i])
      i = i + 1
    end
  when ExprKind::ExprStructLit(_, fields) then
    var i = 0
    while i < fields.len() do
      scan_expr(env, scan, &fields[i].1)
      i = i + 1
    end
  when ExprKind::ExprMapLit(entries) then
    # Record aggregate ownership (map literal keys AND values are owned
    # transfers) so the resource checker's aggregate_child_owned lookup is
    # always satisfied for typed aggregates.
    var map_owned = Vec::new()
    var mi0 = 0
    while mi0 < entries.len() * 2 do
      map_owned.push(true)
      mi0 = mi0 + 1
    end
    if expr.node_id != 0 then
      env.typed_aggregate_ownership.insert(expr.node_id, map_owned)
    end
    var i = 0
    while i < entries.len() do
      scan_expr(env, scan, &entries[i].0)
      scan_expr(env, scan, &entries[i].1)
      i = i + 1
    end
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    scan_expr(env, scan, &lhs)
    scan_expr(env, scan, &rhs)
  when ExprKind::ExprUnaryOp(_, operand) then scan_expr(env, scan, &operand)
  when ExprKind::ExprFieldAccess(base, _) then scan_expr(env, scan, &base)
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    scan_operand(env, scan, &recv)
    var i = 0
    while i < args.len() do
      scan_operand(env, scan, &args[i])
      i = i + 1
    end
  when ExprKind::ExprIndex(base, index) then
    scan_expr(env, scan, &base)
    scan_expr(env, scan, &index)
  when ExprKind::ExprCall(func, args) then
    scan_expr(env, scan, &func)
    var i = 0
    while i < args.len() do
      scan_operand(env, scan, &args[i])
      i = i + 1
    end
  when ExprKind::ExprClosure(params, _, body) then
    var i = 0
    while i < params.len() do
      scan_pattern_bind(env, scan, &params[i].pat)
      i = i + 1
    end
    scan_expr(env, scan, &body)
  when ExprKind::ExprAccess(inner) then scan_expr(env, scan, &inner)
  when ExprKind::ExprRawDeref(inner) then scan_expr(env, scan, &inner)
  when ExprKind::ExprIf(if_stmt) then scan_if_stmt(env, scan, &if_stmt)
  when ExprKind::ExprMatch(m) then scan_match_expr(env, scan, &m)
  when ExprKind::ExprBlock(block) then scan_block(env, scan, &block)
  when ExprKind::ExprUnsafe(_, block) then scan_block(env, scan, &block)
  when ExprKind::ExprAsync(block) then scan_block(env, scan, &block)
  when ExprKind::ExprAwait(inner) then scan_expr(env, scan, &inner)
  when ExprKind::ExprTry(inner) then scan_expr(env, scan, &inner)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then scan_expr(env, scan, &s)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then scan_expr(env, scan, &e)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, _) then scan_expr(env, scan, &inner)
  when ExprKind::ExprTypeCheck(inner, _) then scan_expr(env, scan, &inner)
  when ExprKind::ExprComptime(block) then scan_block(env, scan, &block)
  when ExprKind::ExprEnumVariant(_, args) then
    var i = 0
    while i < args.len() do
      scan_expr(env, scan, &args[i])
      i = i + 1
    end
  when ExprKind::ExprAssign(target, value) then
    match scan_root_ident(&target)
    when Option::Some(name) then scan_capture_record(env, scan, expr.node_id, name, AccessEffect::Modify)
    when Option::None then ()
    end
    scan_expr(env, scan, &target)
    scan_expr(env, scan, &value)
  when ExprKind::ExprPipe(lhs, rhs) then
    scan_expr(env, scan, &lhs)
    scan_expr(env, scan, &rhs)
  when ExprKind::ExprMacroCall(_, args) then
    var i = 0
    while i < args.len() do
      scan_expr(env, scan, &args[i])
      i = i + 1
    end
  when ExprKind::ExprError(_) then ()
  end  end
end

def scan_closure_captures(env: TypeEnv, params: Vec[ClosureParam], body: Expr) -> CaptureScan
  var scan = CaptureScan { bound: Vec::new(), uses: Map::new(), nodes: Map::new() }
  var i = 0
  while i < params.len() do
    scan_pattern_bind(env, &mut scan, &params[i].pat)
    i = i + 1
  end
  scan_expr(env, &mut scan, body)
  scan
end

def captures_have_inout(caps: Map[Int, AccessEffect]) -> Bool
  let entries = caps.entries()
  var i = 0
  while i < entries.len() do
    match entries[i].1
    when AccessEffect::Modify then return true
    when _ then ()
    end
    i = i + 1
  end
  false
end

def closure_has_inout_capture(env: TypeEnv, node_id: Int) -> Bool
  match env.closure_captures.get(node_id)
  when Option::Some(caps) then captures_have_inout(&caps)
  when Option::None then false
  end  end
end

# ———————————————————————————————————————————————————————————————
# The closure-capture enforcement (closure-capture enforcement): the async/thread
# closure capture classification and the rejections
# ———————————————————————————————————————————————————————————————
# The capture CLASSIFICATION (the existing capture machinery — the
# closure_captures record): a captured local is
#   - read-only, non-escaping            -> let (AccessEffect::Read)
#   - mutated in a non-escaping closure  -> the lexical inout (Modify)
#   - escaping ownership                 -> sink (Consume)
# For an async/thread closure (a closure argument to a spawn/schedule/
# poll/async-marked call — the escaping context), the capture must be a
# SINK (the ownership moves into the task) or a SHAREABLE state (the
# synchronized representation — Arc/Mutex/RwLock/atomics/channels).
# The REJECTIONS (each with its diagnostic):
#   - the escaping inout capture   — a Modify capture: the lexical inout
#     state cannot leave its defining execution context
#   - the inout across await       — the same, at the await boundary
#   - the raw stack-pointer escape — a captured local whose type is a raw
#     Ptr/PtrMut: a stack address must not escape into a task/thread
#   - the thread closure capturing a non-Transferable value — the
#     captured type fails the transferable walk (the affine native
#     handles, the inout state, the gated raw pointers)
#   - the concurrent closure using a plain shared mutable value — a Read
#     capture of a NON-SHAREABLE USER-DEFINED aggregate (the plain
#     mutable struct shape): the state is not synchronized — share it
#     through Arc/Mutex/RwLock/atomics/channels. The builtin owned
#     values (String, the containers, the smart pointers) are the
#     language's sink-movable shapes and are NOT rejected here (the
#     Transferable walk governs them); a user aggregate with an explicit
#     opt-in (impl UnsafeTransferable) is exempt the same way.
def check_async_closure_captures(inout env: TypeEnv, node_id: Int, span: Span) -> Unit
  match env.closure_captures.get(node_id)
  when Option::Some(caps) then
    let entries = caps.entries()
    var i = 0
    while i < entries.len() do
      let cap_id = entries[i].0
      let cap_effect = entries[i].1
      let cap_ty = match env.typed_local_bindings.get(cap_id)
      when Option::Some(lb) then lb.ty.clone()
      when Option::None then Type::Unit
      end
      match cap_effect
      when AccessEffect::Modify then
        type_add_error(env, "escaping inout capture: inout capture cannot cross await (the lexical inout state cannot leave its defining execution context)", span)
      when AccessEffect::Consume then
        if !is_send(env, &cap_ty) then
          type_add_error(env, "thread closure capturing a non-Transferable value: type `" + type_display(env, &cap_ty) + "` cannot be transferred into another execution context", span)
        end
      when AccessEffect::Read then
        if type_is_raw_pointer(&cap_ty) then
          type_add_error(env, "raw stack-pointer escaping into a task/thread: a raw pointer capture may dangle in another execution context", span)
        end
        if !is_send(env, &cap_ty) then
          type_add_error(env, "thread closure capturing a non-Transferable value: type `" + type_display(env, &cap_ty) + "` cannot be transferred into another execution context", span)
        end
        if !is_sync(env, &cap_ty) && !pointer_gate_holds(env, &cap_ty, "UnsafeTransferable") && named_type_is_user_aggregate(env, &cap_ty) then
          type_add_error(env, "concurrent closure using a plain shared mutable value: type `" + type_display(env, &cap_ty) + "` is not Shareable — share the state through Arc/Mutex/RwLock/atomics/channels", span)
        end
      when _ then ()
      end
      i = i + 1
    end
  when Option::None then ()
  end  end
end

# The "plain mutable struct" shape of the concurrent-closure rejection:
# a USER-DEFINED aggregate (an Adt whose TypeId is none of the builtin/
# std-recognized LangItems forms — the scalars, String, the containers,
# the smart pointers, the raw pointers). The builtin owned values are
# the language's sink-movable shapes; the plain user struct must be
# synchronized (Arc/Mutex/RwLock/atomics/channels) to be shared.
def named_type_is_user_aggregate(env: TypeEnv, ty: Type) -> Bool
  match ty
  when Type::Adt(tid, _) then
    let id = tid.id
    !(id == env.lang_items.option || id == env.lang_items.result ||
      id == env.lang_items.vec || id == env.lang_items.map ||
      id == env.lang_items.set || id == env.lang_items.box_ ||
      id == env.lang_items.rc || id == env.lang_items.array ||
      id == env.lang_items.slice || id == env.lang_items.unique_ptr ||
      id == env.lang_items.arc_strong || id == env.lang_items.weak_rc ||
      id == env.lang_items.weak_arc || id == env.lang_items.affine_handle ||
      id == env.lang_items.ptr || id == env.lang_items.ptr_mut)
  when _ then false
  end  end
end

# A captured local whose type is a raw pointer — the stack-pointer escape
# rejection shape.
def type_is_raw_pointer(ty: Type) -> Bool
  match ty
  when Type::Ptr(_) then true
  when Type::PtrMut(_) then true
  when _ then false
  end  end
end

def callee_ident_name(expr: Expr) -> Option[String]
  match expr.kind
  when ExprKind::ExprIdent(n) then Option::Some(n.clone())
  when ExprKind::ExprPath(p) then
    if p.segments.len() > 0 then
      Option::Some(p.segments[p.segments.len() - 1].clone())
    else
      Option::None
    end
  when _ then Option::None
  end  end
end

def is_async_marker(name: String) -> Bool
  if name == "async" then return true end
  if name.starts_with("spawn") then return true end
  if name.starts_with("schedule") then return true end
  if name.starts_with("poll") then return true end
  false
end

# ———————————————————————————————————————————————————————————————
# Literal Range Authority — the checker's range decisions
# ———————————————————————————————————————————————————————————————
# ONLY the checker decides whether a literal fits its target type: the
# suffix's exact type range (u8/i8/u64/u128/...), the inferred Int range,
# the float finite/f32 gates. The overflow is ONE stable diagnostic and
# the literal is NEVER silently rewritten to 0/0.0.

# The suffix -> concrete integer type resolution (the u8/i8/... distinct
# semantics of the literal's explicit_suffix field).
def integer_literal_suffix_type(sfx: String) -> Option[Type]
  match sfx
  when "u8" then Option::Some(Type::U8)
  when "u16" then Option::Some(Type::U16)
  when "u32" then Option::Some(Type::U32)
  when "u64" then Option::Some(Type::U64)
  when "u128" then Option::Some(Type::U128)
  when "i8" then Option::Some(Type::I8)
  when "i16" then Option::Some(Type::I16)
  when "i32" then Option::Some(Type::I32)
  when "i64" then Option::Some(Type::I64)
  when "i128" then Option::Some(Type::I128)
  when "usize" then Option::Some(Type::USize)
  when "isize" then Option::Some(Type::ISize)
  when "u" then Option::Some(Type::UInt)
  when "i" then Option::Some(Type::Int)
  when _ then Option::None
  end  end
end

# The (lo, hi) bounds of an integer type as DECIMAL strings (the
# arbitrary-precision comparison bounds — Int is the 64-bit host type,
# UInt/usize/isize are 64-bit).
def integer_type_bounds(ty: Type) -> (String, String)
  match ty
  when Type::U8 then ("0", "255")
  when Type::U16 then ("0", "65535")
  when Type::U32 then ("0", "4294967295")
  when Type::U64 then ("0", "18446744073709551615")
  when Type::U128 then ("0", "340282366920938463463374607431768211455")
  when Type::I8 then ("-128", "127")
  when Type::I16 then ("-32768", "32767")
  when Type::I32 then ("-2147483648", "2147483647")
  when Type::I64 then ("-9223372036854775808", "9223372036854775807")
  when Type::I128 then ("-170141183460469231731687303715884105728", "170141183460469231731687303715884105727")
  when Type::USize then ("0", "18446744073709551615")
  when Type::ISize then ("-9223372036854775808", "9223372036854775807")
  when Type::UInt then ("0", "18446744073709551615")
  when Type::Int then ("-9223372036854775808", "9223372036854775807")
  when _ then ("0", "9223372036854775807")
  end  end
end

# The diagnostic name of an integer type (the suffix spellings).
def integer_type_name(ty: Type) -> String
  match ty
  when Type::U8 then "u8"
  when Type::U16 then "u16"
  when Type::U32 then "u32"
  when Type::U64 then "u64"
  when Type::U128 then "u128"
  when Type::I8 then "i8"
  when Type::I16 then "i16"
  when Type::I32 then "i32"
  when Type::I64 then "i64"
  when Type::I128 then "i128"
  when Type::USize then "usize"
  when Type::ISize then "isize"
  when Type::UInt then "UInt"
  when Type::Int then "Int"
  when _ then "integer"
  end  end
end

def strip_leading_zeros(s: String) -> String
  var start_idx = 0
  while start_idx < s.len() - 1 && s.char_at(start_idx) == '0' do
    start_idx = start_idx + 1
  end
  s.slice(start_idx, s.len())
end

def decimal_magnitude_cmp(a: String, b: String) -> Int
  if a.len() != b.len() then
    if a.len() > b.len() then 1 else -1 end
  else
    var i = 0
    while i < a.len() do
      let ca = a.char_at(i) as Int
      let cb = b.char_at(i) as Int
      if ca != cb then
        if ca > cb then return 1 else return -1 end
      end
      i = i + 1
    end
    0
  end
end

# Signed decimal string comparison (-1 / 0 / 1).
def signed_decimal_cmp(a: String, b: String) -> Int
  let a_neg = a.len() > 0 && a.char_at(0) == '-'
  let b_neg = b.len() > 0 && b.char_at(0) == '-'
  if a_neg != b_neg then
    if a_neg then -1 else 1 end
  else
    let a_mag = if a_neg then a.slice(1, a.len()) else a end
    let b_mag = if b_neg then b.slice(1, b.len()) else b end
    let mag_cmp = decimal_magnitude_cmp(strip_leading_zeros(a_mag), strip_leading_zeros(b_mag))
    if a_neg then 0 - mag_cmp else mag_cmp end
  end
end

# The signed decimal value of a literal with the negation folded.
def literal_signed_decimal(p: ParsedIntegerLiteral, negated: Bool) -> String
  if parsed_int_is_zero(p) then
    "0"
  else
    let neg = (p.sign < 0) != negated
    if neg then "-" + parsed_int_decimal(p) else parsed_int_decimal(p) end
  end
end

# The exact integer range decision — the magnitude (arbitrary precision)
# against the target's decimal bounds; false records the ONE stable
# overflow diagnostic.
def check_integer_literal_range(env: TypeEnv, p: ParsedIntegerLiteral, negated: Bool, ty: Type, span: Span) -> Bool
  let (lo, hi) = integer_type_bounds(ty)
  let value = literal_signed_decimal(p, negated)
  if signed_decimal_cmp(value, lo) < 0 || signed_decimal_cmp(value, hi) > 0 then
    type_add_error(env, "integer literal out of range for type `" + integer_type_name(ty) + "`", span)
    false
  else
    true
  end
end

# The float range decision: the exact decimal magnitude against the
# f64 maximum (or the non-finite materialized value — the 1e309 overflow,
# never a silent inf) and the f32 exact magnitude gate.
def check_float_literal_range(env: TypeEnv, p: ParsedFloatLiteral, is_f32: Bool, span: Span) -> Bool
  if parsed_float_f64_overflow(p) then
    type_add_error(env, "float literal out of range for type `" + (if is_f32 then "f32" else "f64") + "`", span)
    false
  elsif is_f32 && parsed_float_f32_overflow(p) then
    type_add_error(env, "float literal out of range for type `f32`", span)
    false
  else
    true
  end
end

# (literal-range resolution): the end-of-check pass that makes the
# checker's range decisions — every recorded literal is checked against
# its target's exact bounds (the folded negation flips the sign); the
# overflow is the ONE stable diagnostic; a literal NEVER silently becomes
# 0/0.0.
def resolve_pending_literal_ranges(inout env: TypeEnv) -> Unit
  let entries = env.pending_literal_ranges.entries()
  var i = 0
  while i < entries.len() do
    let rec = entries[i].1
    let negated = (rec.neg_count % 2) == 1
    let _ = check_integer_literal_range(env, rec.lit, negated, rec.target_ty, rec.span)
    i = i + 1
  end
  env.pending_literal_ranges.clear()
end

# The unify-time range check: an IntLiteral meeting a CONCRETE integer
# type through the coercion rule is range-checked against that type —
# exact for host-representable values (a negative payload is skipped: it
# is a negated literal or the wrapped pattern of a huge magnitude whose
# range the pending pass decides). The overflow is the same ONE stable
# diagnostic — a literal never silently truncates into the target type.
def int_literal_unify_range_check(inout env: TypeEnv, lit: Type, concrete: Type, span: Span) -> Bool
  match lit
  when Type::IntLiteral(v) then
    if v < 0 then
      true
    else
      let hi = match concrete
        when Type::U8 then 255
        when Type::U16 then 65535
        when Type::U32 then 4294967295
        when Type::U64 then 9223372036854775807
        when Type::U128 then 9223372036854775807
        when Type::I8 then 127
        when Type::I16 then 32767
        when Type::I32 then 2147483647
        when Type::I64 then 9223372036854775807
        when Type::I128 then 9223372036854775807
        when Type::USize then 9223372036854775807
        when Type::ISize then 9223372036854775807
        when Type::UInt then 9223372036854775807
        when Type::Int then 9223372036854775807
        when _ then 9223372036854775807
      end
      if v <= hi then
        true
      else
        type_add_error(env, "integer literal out of range for type `" + integer_type_name(concrete) + "`", span)
        false
      end
    end
  when _ then true
  end  end
end

# The bottommost integer literal of a unary-minus chain (the node id of
# the literal at the end of an arbitrary Neg wrapping).
def literal_bottom_of_neg_chain(expr: Expr) -> Option[Int]
  match expr.kind
  when ExprKind::ExprIntLit(_) then Option::Some(expr.node_id)
  when ExprKind::ExprUnaryOp(UnOp::Neg, inner) then literal_bottom_of_neg_chain(inner)
  when _ then Option::None
  end  end
end

def check_expr(inout env: TypeEnv, expr: Expr) -> Type
  let result = match expr.kind
  when ExprKind::ExprIntLit(p) then
   # (literal range authority): EVERY integer literal records its lossless
    # form and its range TARGET — the suffix's concrete type, or the
    # inferred Int — in the pending table; the end-of-check pass
    # (resolve_pending_literal_ranges) makes the exact range decision (ONE
    # stable diagnostic, never a silent 0). The produced type stays the
    # inference-only IntLiteral (coercible to any concrete integer type;
    # eliminated after coercion) carrying the host value when the
    # magnitude fits the host Int, and the WRAPPED bit pattern otherwise
    # (the unsigned-typed cases the pass accepts — the range authority is
    # the magnitude, never the host conversion).
    match p.explicit_suffix
    when Option::Some(sfx) then
      match integer_literal_suffix_type(sfx)
      when Option::Some(ty) then
        env.pending_literal_ranges.insert(expr.node_id, PendingLiteralRange { lit: p, target_ty: ty, span: expr.span, neg_count: 0 })
        Type::IntLiteral(parsed_int_to_host(&p))
      when Option::None then
        type_add_error(env, "invalid integer literal suffix `" + sfx + "`", expr.span)
        Type::Error
      end
    when Option::None then
      if parsed_int_fits_host(&p) then
        env.pending_literal_ranges.insert(expr.node_id, PendingLiteralRange { lit: p, target_ty: Type::Int, span: expr.span, neg_count: 0 })
        Type::IntLiteral(parsed_int_to_host(&p))
      else
        # the inferred-Int range decision: a magnitude beyond the host
        # range is the overflow — fail-closed, never a silent wrap.
        type_add_error(env, "integer literal out of range for type `Int`", expr.span)
        Type::Error
      end
    end
  when ExprKind::ExprFloatLit(p) then
   # (float range authority): the significand/exponent STRINGS preserved
    # by the lexer decide the range (the f64 finite gate, the f32 exact
    # magnitude gate) — 1e309 is the overflow diagnostic, never a silent
    # inf/0.0; the f32 suffix yields Type::F32, f64/unsuffixed Float.
    match p.explicit_suffix
    when Option::Some(sfx) then
      if sfx == "f32" then
        if check_float_literal_range(env, &p, true, expr.span) then Type::F32 else Type::Error end
      else
        if check_float_literal_range(env, &p, false, expr.span) then Type::Float else Type::Error end
      end
    when Option::None then
      if check_float_literal_range(env, &p, false, expr.span) then Type::Float else Type::Error end
    end
  when ExprKind::ExprStringLit(_) then Type::String
  when ExprKind::ExprCharLit(_) then Type::Char
  when ExprKind::ExprBoolLit(_) then Type::Bool
  when ExprKind::ExprNilLit then builtin_adt(env, "Option".to_string(), [fresh_type_var(env)])
  when ExprKind::ExprIdent(name) then
    match lookup_var(env, name)
    when Option::Some(ty) then
      let lid = local_id_of(env, name)
      env.typed_ident_resolutions.insert(expr.node_id, lid)
 # (final layer): a bare name resolved from the pass-3
      # program-level callable bindings (scope 0) goes through the
      # module-qualified identity check — the current module's own
      # definition wins when several modules define the name; otherwise an
      # ambiguous bare name is diagnosed and the first-wins entry is the
      # fallback (see resolve_bare_callable).
      if var_is_global_callable(env, &name) then
        resolve_bare_callable(env, name.clone(), expr.span, ty.clone())
      else
        ty
      end
    when Option::None then
      # Check if the name refers to a registered type (e.g., Vec in Vec::new(),
      # u8 in u8::MAX, etc.) — when a type name appears in expression position
      # as the receiver of a method call or path, treat it as a type reference.
      match get_type_by_name_ref(env, name)
      when Option::Some(type_def) then
        # Use canonical Type representation for primitives and compound types
        # (Int, String, Option, Slice, etc.) so unification with literal types
        # (e.g., Type::Int from ExprIntLit) works correctly instead of producing
        # "Named#XXX vs Int" errors.
        type_def_to_canonical(env, type_def)
      when Option::None then
        # Check if the name refers to an enum variant (e.g., Some, None, Ok, Err)
        # in expression position — treat bare variant names as constructor functions.
        match find_enum_variant(env, name)
        when Option::Some((enum_td, variant)) then
          # Construct a function type: (variant_field_types...) -> enum_type
          let enum_type_args = fresh_type_args_for(env, &enum_td)
          let enum_type = Type::Adt(enum_td.id, enum_type_args)
          var field_types = Vec::new()
          var fi = 0
          while fi < variant.fields.len() do
            field_types.push(subst_type_args(&variant.fields[fi], &enum_td.generic_params, &enum_type_args))
            fi = fi + 1
          end
          # A bare field-less variant in value position (e.g. `x: None`) is the
          # enum value itself; variants with fields yield constructor functions.
          if variant.fields.len() == 0 then
            enum_type
          else
            var fn_params = Vec::new()
            var fi2 = 0
            while fi2 < field_types.len() do
              fn_params.push(ParamType { ty: field_types[fi2], convention: AccessConvention::Let })
              fi2 = fi2 + 1
            end
            Type::FnPtr(fn_params, enum_type, Vec::new())
          end
        when Option::None then
          # Unknown identifier: a name that survives type-name, enum-variant
          # and scope lookup is unresolvable. A fresh type variable here has
          # no equation to solve it and would let the construct silently
 # type-check. Record a TypeError and produce Type::Error so
          # compilation aborts before codegen.
          type_add_error(env, "unknown symbol `" + name + "`", expr.span)
          Type::Error
        end
      end
    end
  when ExprKind::ExprSelfRef then
    match lookup_var(env, "self")
    when Option::Some(ty) then ty
    when Option::None then Type::Error
    end
  when ExprKind::ExprBinaryOp(op, left, right) then
    check_binary_op(env, op, &left, &right, expr.span)
  when ExprKind::ExprUnaryOp(op, inner) then
    check_unary_op(env, op, &inner, expr.span)
  when ExprKind::ExprCall(func, args) then
    # The operation-call surface: a std::effects::perform(EFFECT.op, ...)
    # call is typed against the declared effect's op table (the semantic
    # EffectId-keyed records) — the payload args unify with the op's
    # parameter types and the call's type is the op's return type.
    match check_effect_perform_call(env, expr, &func, &args)
    when Option::Some(perform_ty) then perform_ty
    when Option::None then
    var func_type = check_expr(env, &func)
 # (FnPtr/Closure split): the call-shape analysis below keys on the
    # FnPtr signature form; a Closure callee NORMALIZES to it (the
    # signature is identical — the call-shape semantics are the same for a
    # function pointer and a closure value; the conflation
    # form is are not part of the model.
    match func_type
    when Type::FnPtr(ps, rt, _) then ()
    when Type::Closure(_, ps, rt, _, effs) then func_type = Type::FnPtr(ps, rt, effs)
    when _ then ()
    end
    env.access_marker_depth = env.access_marker_depth + 1
    var arg_types = Vec::new()
    var i = 0
    while i < args.len() do
      arg_types.push(check_expr(env, &args[i]))
      i = i + 1
    end
    env.access_marker_depth = env.access_marker_depth - 1
 # (IntrinsicId at check time): attach the semantic classification of
    # an intrinsic call (the __intrinsic_* family — the resolver registered
    # their DefIds — and the builtin-container method names) per call node.
    # The call target is recorded FIRST (typed_call_targets — the
    # resolver's DefId under the callee node bridged to the call-node
    # key): the intrinsic-name gate reads the target's DefKind to
    # distinguish the DECLARED intrinsic externs (DefKind::Function — the
    # runtime symbol surface) from the synthetic runtime-intrinsic
    # registrations (DefKind::Intrinsic — the names the runtime does NOT
    # provide, the gate's target).
    record_typed_call_target(env, &func, expr.node_id)
    match callee_ident_name(&func)
    when Option::Some(cname) then
      let call_recv = if arg_types.len() > 0 then arg_types[0].clone() else Type::Unit end
      let call_needle = if arg_types.len() > 1 then arg_types[1].clone() else Type::Unit end
      record_intrinsic_classification(env, expr.node_id, &cname, &call_recv, &call_needle, &cname, expr.span)
    when Option::None then ()
    end
    let ret_type = fresh_type_var(env)
    var call_was_generic = false
    match func_type
    when Type::FnPtr(params, ret, _) then
 # FIX 1: explicit generic instantiation. Each generic parameter
      # of the callee is instantiated ONCE for the whole call to a fresh
      # inference variable (shared between parameters and return type), the
      # arguments unify against the instantiated signature, and the result
      # type is resolved through the solved substitution.
      var gvar_map: Map[Int, Type] = Map::new()
 # (final): the callee's generic parameters in callee-signature
      # order — first occurrence across the parameter signature, then the
      # return type — the SAME walk order the monomorphizer's
      # infer_type_param_names uses, so the recorded substitution lines up
 # positionally with the instance's substs. the collected
      # parameters are GenericParamIds (dedupe by id).
      var sig_param_names = Vec::new()
      var inst_params = Vec::new()
      var pi0 = 0
      while pi0 < params.len() do
        let pt = params[pi0]
        collect_param_names_from_type(env, &pt.ty, &mut sig_param_names)
        inst_params.push(ParamType { ty: instantiate_generic_type(env, &pt.ty, &mut gvar_map), convention: pt.convention })
        pi0 = pi0 + 1
      end
      # Snapshot the generic parameters that appear in the callee's argument
      # signature: only these must be solved by argument unification.
      # Parameters appearing only in the return type are solved by the
      # caller's context (`let v: Vec[Int] = Vec::new()` inference) — the
      # std's `__intrinsic_array_new[T]() -> Array[T]` calls rely on this.
      var arg_param_names = Vec::new()
      let snapshot_entries = gvar_map.entries()
      var sei = 0
      while sei < snapshot_entries.len() do
        arg_param_names.push(snapshot_entries[sei].0)
        sei = sei + 1
      end
      let inst_ret = instantiate_generic_type(env, &ret, &mut gvar_map)
      collect_param_names_from_type(env, &ret, &mut sig_param_names)
      # Enforce exact arity for non-variadic callables: every declared
      # parameter must have a supplied argument and every argument must
      # map to a declared parameter. Silently accepting extra arguments
      # (or missing ones) makes callable types unsound — a value of type
      # fn(Int) -> Int could be invoked with two arguments and vice versa.
      # (Default arguments are deprecated/unused in this codebase — no call
      # site omits a defaulted parameter — so exact equality is correct.)
      if args.len() != inst_params.len() then
        type_add_error(env, "wrong number of arguments: expected " +
          inst_params.len().to_string() + ", found " + args.len().to_string(), expr.span)
      end
      var pi = 0
      while pi < args.len() && pi < inst_params.len() do
        let pt = inst_params[pi]
        unify(env, arg_types[pi], pt.ty, args[pi].span)
        record_arg_effect(env, &args[pi], pt.convention)
        pi = pi + 1
      end
      unify(env, ret_type, inst_ret, expr.span)
      # FIX 1 verification: every generic parameter of the callee that
      # appears in the call's argument signature must be SOLVED after the
      # argument unification; an unsolved parameter (e.g. one that cannot be
      # inferred from the arguments) is a hard error.
      var gi = 0
      while gi < arg_param_names.len() do
        match gvar_map.get(arg_param_names[gi])
        when Option::Some(v) then
          match resolve_type_var(env, v)
          when Type::Var(_) then
 # the parameter name comes from the param-name table
            # (numeric GenericParamId -> name), never from an identity
            # comparison.
            let gname = match env.generic_param_table.names.get(arg_param_names[gi])
            when Option::Some(n) then n.clone()
            when Option::None then "<param#" + arg_param_names[gi].to_string() + ">"
            end
            type_add_error(env, "cannot infer type parameter `" + gname + "`", expr.span)
          when _ then ()
          end
        when Option::None then ()
        end
        gi = gi + 1
      end
      if !gvar_map.is_empty() then
        call_was_generic = true
      end
 # (final) / the SOLVED substitution is the AUTHORITY —
      # record it for this call node in the callee's generic-parameter
      # order. When EVERY generic parameter of the callee is solved at the
      # call site the instance is recorded immediately; a parameter solved
      # only by the CALLER's context (e.g. a return-type-only parameter
      # unified with the let-binding annotation AFTER the call) is parked
      # in pending_call_instances and re-resolved after the whole program
      # is checked (resolve_pending_call_instances), when the annotation
      # unifications have landed. ZERO-INFERENCE: a parameter no context
      # ever solves is reported by resolve_pending_call_instances
      # ("cannot infer type parameter `T`: add an annotation") — the
      # monomorphizer performs no call-site inference (fail-closed).
 # ORDER (substs-order contract): the recorded substitution is
      # positionally aligned with the monomorphizer's
      # function_generic_param_names — MirFunction.generic_params, which
      # lower_function populated from the checker's generic_param_ids
      # record in DECLARATION order. The signature-appearance order (the
      # infer_type_param_names walk) would swap a parameter whose
      # declaration order differs from its first-appearance order (e.g.
      # `def f[T, U](x: U)`) — the decl order is enumerated here from the
      # generic-param table's per-owner interned counts (the ids are
      # (owner, index) with index == declaration position); a parameter
      # that never appears in the signature gets a fresh variable and is
      # parked (reported unsolvable — fail-closed, never silently
      # dropped).
      if call_was_generic then
        var decl_names: Vec[GenericParamId] = Vec::new()
        var dsi = 0
        while dsi < sig_param_names.len() do
          let sp = sig_param_names[dsi]
          var owner_present = false
          var opi = 0
          while opi < decl_names.len() do
            if def_id_numeric(&decl_names[opi].owner) == def_id_numeric(&sp.owner) then owner_present = true end
            opi = opi + 1
          end
          if !owner_present then
            let owner_key = def_id_numeric(&sp.owner)
            let owner_count = match env.generic_param_table.counts.get(owner_key)
            when Option::Some(c) then c as Int
            when Option::None then 0
            end
            var oci = 0
            while oci < owner_count do
              decl_names.push(GenericParamId { owner: sp.owner.clone(), index: oci as UInt })
              oci = oci + 1
            end
          end
          dsi = dsi + 1
        end
        var all_solved = true
        var solved_args = Vec::new()
        var decl_vars = Vec::new()
        var dvi = 0
        while dvi < decl_names.len() do
          var var_found = false
          match gvar_map.get(generic_param_id_numeric(&decl_names[dvi]))
          when Option::Some(v) then
            var_found = true
            decl_vars.push(v.clone())
            let solved = resolve_type_var(env, v.clone())
            match solved
            when Type::Var(_) then all_solved = false
            when _ then solved_args.push(solved)
            end
          when Option::None then ()
          end
          if !var_found then
            # A declared parameter that never appears in the signature is
            # genuinely unconstrained: a fresh variable parks the call and
            # resolve_pending_call_instances reports it (fail-closed).
            decl_vars.push(fresh_type_var(env))
            all_solved = false
          end
          dvi = dvi + 1
        end
        if all_solved then
          env.typed_call_instances.insert(expr.node_id, solved_args)
        elsif decl_names.len() > 0 then
          env.pending_call_instances.insert(expr.node_id, (decl_names.clone(), decl_vars, expr.span))
        end
      end
      # Shared intrinsic reads (__intrinsic_array_get / __intrinsic_map_get)
      # return OWNED elements from a SHARED container — the same
      # resource-duplication hole as the get() methods. Reject them for
      # resource-containing element types (the intrinsic's first argument is
      # the container, so its element type decides).
      match callee_ident_name(&func)
      when Option::Some(cname) then
        # Copy-producing intrinsics are compiler-internal building blocks; a
        # DIRECT call on resource-containing element types is rejected here
        # (the std wrappers carry the same restriction via their `T: Copy`
        # bounds).
        # Operation-specific contracts: map_get copies V; map_entries copies
        # K AND V; map_keys would copy K; array_get/slice copy T.
        if cname == "__intrinsic_array_get" || cname == "__intrinsic_array_slice" ||
           cname == "__intrinsic_map_get" || cname == "__intrinsic_set_entries" then
          if args.len() >= 1 then
            match container_element_type(env, &arg_types[0])
            when Option::Some(elem_ty) then
              if type_has_resource_kind(env, &elem_ty) then
                type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
              end
            when Option::None then ()
            end
          end
        elsif cname == "__intrinsic_array_from_list" then
          # array_from_list copies OUT of a SHARED &[T] into a fresh
          # owning Array[T] — intrinsically copy-producing. The library
          # wrapper's `T: Copy` bound does not protect a direct user call.
          if args.len() >= 1 then
            match container_element_type(env, &arg_types[0])
            when Option::Some(elem_ty) then
              if type_has_resource_kind(env, &elem_ty) then
                type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
              end
            when Option::None then ()
            end
          end
        elsif cname == "__intrinsic_map_entries" then
          # map_entries materializes (K, V) pairs: a resource KEY is just as
          # duplicating as a resource value.
          if args.len() >= 1 then
            match arg_types[0]
            when Type::Adt(tid, args) then
              if tid.id == env.lang_items.map && args.len() >= 2 then
                if type_has_resource_kind(env, &args[0]) || type_has_resource_kind(env, &args[1]) then
                  type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
                end
              end
            when _ then ()
            end
          end
        elsif cname == "__intrinsic_array_extend" then
          # array_extend copies elements OUT of the SHARED source (args[1],
          # the second argument — the first is the inout target): the
          # duplication hole is the source's element type, exactly like
          # the slice()/clone() guards.
          if args.len() >= 2 then
            match container_element_type(env, &arg_types[1])
            when Option::Some(elem_ty) then
              if type_has_resource_kind(env, &elem_ty) then
                type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
              end
            when Option::None then ()
            end
          end
        end
      when Option::None then ()
      end
    when _ then
      var ri = 0
      while ri < args.len() do
        record_arg_effect(env, &args[ri], AccessConvention::Let)
        ri = ri + 1
      end
    end
    match callee_ident_name(&func)
    when Option::Some(cname) then
      if is_async_marker(&cname) then
        var ai = 0
        while ai < args.len() do
          check_async_closure_captures(env, args[ai].node_id, args[ai].span)
          ai = ai + 1
        end
      end
    when Option::None then ()
    end
    if call_was_generic then
      # The result type uses the solved substitution: the fresh ret variable
      # is bound to the instantiated return type, so resolving it yields the
      # concrete instantiation.
      resolve_type_var(env, ret_type)
    else
      ret_type
    end
    end
  when ExprKind::ExprMethodCall(recv, method, type_args, args) then
    env.access_marker_depth = env.access_marker_depth + 1
    let recv_type = check_expr(env, &recv)
    var arg_types = Vec::new()
    var i = 0
    while i < args.len() do
      arg_types.push(check_expr(env, &args[i]))
      i = i + 1
    end
    env.access_marker_depth = env.access_marker_depth - 1
    # Resolve explicit type arguments (e.g., cast[U] → resolve U)
    var method_type_args = Vec::new()
    var tai = 0
    while tai < type_args.len() do
      method_type_args.push(resolve_type_expr(env, &type_args[tai]))
      tai = tai + 1
    end
 # Look up method on receiver type with type args (the call's
    # node id threads the solved-substitution record into the generic
    # instantiation, see instantiate_method_type).
    let ret = resolve_method_type(env, &recv_type, method, &arg_types, &method_type_args, expr.node_id, expr.span)
 # (IntrinsicId at check time): attach the semantic classification of
    # the builtin-container method intrinsics (push/pop/get/set/len/... on
    # String/Array/Map/Set — the receiver gate keeps a user method on a
    # user type from ever classifying).
    let meth_needle = if arg_types.len() > 1 then arg_types[1].clone() else Type::Unit end
    record_intrinsic_classification(env, expr.node_id, &method, &recv_type, &meth_needle, &method, expr.span)
    let mdid = method_def_for(env, &recv_type, method)
    match mdid.clone()
    when Option::Some(did) then env.typed_call_targets.insert(expr.node_id, did)
    when Option::None then ()
    end
    # (direct-call effect recording): a method call to a callee with
    # DECLARED effects accumulates them into the enclosing function's
    # computed effect set (the checker's transitive effect discipline).
    record_effect_call(env, mdid)
    # RingBuffer's shared by-value peek accessors (peek_front) live under
    # `impl[T: Copy] RingBuffer[T]`; method resolution consults the impl's
    # bounds (resolve_method_type's inherent-impl gate), so a non-Copy
    # element is rejected AT RESOLUTION — "method `peek_front` requires
    # `T: Copy`" — for concrete AND generic receivers alike. Use
    # peek_front_cloned (T: Clone — the clone-aware projected read) or the
    # consuming inout APIs (pop_front).
    let mparams = find_method_params(env, &recv_type, method)
    match mparams
    when Option::Some(params) then
      if params.len() >= 1 then
        record_arg_effect(env, &recv, params[0].convention)
      else
        record_arg_effect(env, &recv, AccessConvention::Let)
      end
      # Enforce exact arity for method calls: the expected argument count is
      # the declared params minus the receiver (self), or the full param list
      # for self-less static-style methods. Accepting extra arguments (or
      # silently tolerating missing ones) makes method signatures unsound —
      # the same hole as plain ExprCall above.
      match find_method_expected_args(env, &recv_type, method)
      when Option::Some(expected) then
        if args.len() != expected then
          type_add_error(env, "wrong number of arguments: expected " +
            expected.to_string() + ", found " + args.len().to_string(), expr.span)
        end
      when Option::None then ()
      end
      # Shared extraction of resource elements is prohibited: methods like
      # get/iter/into_iter return owned elements (or iterators over them)
      # from a SHARED container, duplicating ownership of a linear resource
      # while the container stays live. Resource elements must be extracted
      # via inout/consuming access (pop/remove/take and inout iterators).
      if params.len() >= 1 && params[0].convention != AccessConvention::Inout then
        match container_element_type(env, &recv_type)
        when Option::Some(elem_ty) then
          if type_has_resource_kind(env, &elem_ty) &&
             (method == "get" || method == "iter" || method == "into_iter") then
            type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
          end
        when Option::None then ()
        end
      end
      var ai = 0
      while ai < args.len() && ai + 1 < params.len() do
        record_arg_effect(env, &args[ai], params[ai + 1].convention)
        ai = ai + 1
      end
    when Option::None then
      record_arg_effect(env, &recv, AccessConvention::Let)
      var ai2 = 0
      while ai2 < args.len() do
        record_arg_effect(env, &args[ai2], AccessConvention::Let)
        ai2 = ai2 + 1
      end
    end
    if is_async_marker(&method) then
      check_async_closure_captures(env, recv.node_id, recv.span)
      var mai = 0
      while mai < args.len() do
        check_async_closure_captures(env, args[mai].node_id, args[mai].span)
        mai = mai + 1
      end
    end
    ret
  when ExprKind::ExprFieldAccess(recv, field) then
    let recv_type = check_expr(env, &recv)
    let fdid = field_target_of(env, &recv_type, field)
    # The FieldId (owner TypeId + index) is the semantic field identity: it is
    # recorded in typed_field_targets (Map[Int, FieldId]) and the field's type
    # is resolved BY ID from it. The name-based resolve_field_type remains
    # only for access forms that carry no FieldId (tuple indices,
    # String/Slice/Array len/cap) and for diagnostics.
    match fdid
    when Option::Some(fid) then
      env.typed_field_targets.insert(expr.node_id, fid.clone())
      field_type_by_id(env, &recv_type, fid.owner.clone(), fid.index, field, expr.span)
    when Option::None then
      resolve_field_type(env, &recv_type, field, expr.span)
    end
  when ExprKind::ExprIndex(recv, index) then
    let recv_type = check_expr(env, &recv)
    let index_type = check_expr(env, &index)
    # Indexing is an inherently SHARED read that returns the element by
    # value; extracting a resource element this way would create a second
    # owned resource while the container remains live. Resource elements
    # must be extracted through inout/consuming access (e.g. pop/remove/
    # take).
    match recv_type
    when Type::String then
      unify(env, index_type, Type::Int, index.span)
      Type::Char
    when Type::FixedArray(elem, _) then
      # Fixed-array indexing: Int index, element result (the count lives in
      # the type; the MIR/codegen index the inline base + idx * stride).
      if type_has_resource_kind(env, &elem) then
        type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
      end
      unify(env, index_type, Type::Int, index.span)
      elem.clone()
    when Type::Adt(tid, args) then
      # Map[K, V] indexing: key type K, result V. Array and the raw view
      # (UnsafeSlice) index like their element containers (element result,
      # Int index); Set membership
      # returns Bool. The LangItems TypeIds select the builtins. The SAFE
      # source-spelled Slice — the std-declared shared struct — indexes
      # through the Arc deref into the pinned backing (the arm below).
      if tid.id == env.lang_items.map && args.len() >= 2 then
        if type_has_resource_kind(env, &args[1]) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
        end
        unify(env, index_type, args[0].clone(), index.span)
        args[1].clone()
      elsif (tid.id == env.lang_items.array || tid.id == env.lang_items.slice) && args.len() >= 1 then
        if type_has_resource_kind(env, &args[0]) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
        end
        unify(env, index_type, Type::Int, index.span)
        args[0].clone()
      elsif type_bare_name_of(env, &Type::Adt(tid, args)) == "Slice" && args.len() >= 1 then
        # The SAFE source-spelled Slice — the std-declared SHARED struct:
        # indexing reads through the Arc deref into the pinned backing
        # (the element is the struct's type argument; the MIR/codegen
        # lower the index as the backing-window read).
        if type_has_resource_kind(env, &args[0]) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", expr.span)
        end
        unify(env, index_type, Type::Int, index.span)
        args[0].clone()
      elsif tid.id == env.lang_items.set && args.len() >= 1 then
        unify(env, index_type, args[0].clone(), index.span)
        Type::Bool
      else
        unify(env, index_type, Type::Int, index.span)
        fresh_type_var(env)
      end
    when _ then
      unify(env, index_type, Type::Int, index.span)
      fresh_type_var(env)
    end
  when ExprKind::ExprAccess(inner) then
    if env.access_marker_depth == 0 then
      type_add_error(env, "access marker '&' is only valid as a call argument", expr.span)
      Type::Error
    else
      check_expr(env, &inner)
    end
  when ExprKind::ExprRawDeref(inner) then
    let inner_type = check_expr(env, &inner)
    match inner.kind
    when ExprKind::ExprIdent(_) then
      match inner_type
      when Type::Ptr(t) then t
      when Type::PtrMut(t) then t
      when Type::RefInternal(t, _) then t
      when Type::Var(_) then fresh_type_var(env)
      when Type::Adt(tid, args) then
        match get_type_by_id_ref(env, tid)
        when Option::Some(td) then
          if env.lang_items.ptr != -1 && tid.id == env.lang_items.ptr && args.len() >= 1 then
            args[0].clone()
          else
            type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
            inner_type
          end
        when Option::None then
          type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
          inner_type
        end
      when _ then
        type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
        inner_type
      end
    when ExprKind::ExprSelfRef then
      match inner_type
      when Type::Ptr(t) then t
      when Type::PtrMut(t) then t
      when Type::RefInternal(t, _) then t
      when Type::Var(_) then fresh_type_var(env)
      when Type::Adt(tid, args) then
        match get_type_by_id_ref(env, tid)
        when Option::Some(td) then
          if env.lang_items.ptr != -1 && tid.id == env.lang_items.ptr && args.len() >= 1 then
            args[0].clone()
          else
            type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
            inner_type
          end
        when Option::None then
          type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
          inner_type
        end
      when _ then
        type_add_error(env, "safe dereference removed; access through the parameter is direct", expr.span)
        inner_type
      end
    when _ then
      match inner_type
      when Type::Ptr(t) then t
      when Type::PtrMut(t) then t
      when Type::RefInternal(t, _) then t
      when Type::Var(_) then fresh_type_var(env)
      when Type::Adt(tid, args) then
        match get_type_by_id_ref(env, tid)
        when Option::Some(td) then
          if env.lang_items.ptr != -1 && tid.id == env.lang_items.ptr && args.len() >= 1 then args[0].clone() else inner_type end
        when Option::None then inner_type
        end
      when _ then inner_type
      end
    end
  when ExprKind::ExprArrayLit(elems) then
    # Record aggregate ownership: every element is an owned transfer into the
    # array (consumed by the resource checker via typed.aggregate_ownership).
    var arr_owned = Vec::new()
    var ai0 = 0
    while ai0 < elems.len() do
      arr_owned.push(true)
      ai0 = ai0 + 1
    end
    if expr.node_id != 0 then
      env.typed_aggregate_ownership.insert(expr.node_id, arr_owned)
    end
    if elems.is_empty() then
      # The empty array literal is the Adt form of the registered Array
      # builtin (LangItems id); the element is a fresh inference variable.
      Type::Adt(TypeId { id: env.lang_items.array }, [fresh_type_var(env)])
    else
      let elem_type = check_expr(env, &elems[0])
      var i = 1
      while i < elems.len() do
        let t = check_expr(env, &elems[i])
        unify(env, elem_type, t, elems[i].span)
        i = i + 1
      end
      # (partial moves): every owned child is a transfer into the array —
      # a projected OWNING child is moved out of its root (the checker's
      # transfer_consume mirror over the aggregate children).
      var ai = 0
      while ai < elems.len() do
        record_projected_consume(env, &elems[ai])
        ai = ai + 1
      end
      # (channel b): an array/vec literal whose element type is (or
      # contains) the RAW Slice view (UnsafeSlice) stores the raw view in a
      # container — rejected.
      check_no_escaping_slice(env, &elem_type, expr.span, "stored in a container (array/vec literal element)")
      # The generic array literal is the heap-vector Adt form (the named
      # Array[T]); a FixedArray-typed literal is produced when the literal
      # unifies with a [T; N] annotation (the distinct Type::FixedArray
      # variant).
      Type::Adt(TypeId { id: env.lang_items.array }, [elem_type])
    end
  when ExprKind::ExprTupleLit(elems) then
    var tup_owned = Vec::new()
    var ti0 = 0
    while ti0 < elems.len() do
      tup_owned.push(true)
      ti0 = ti0 + 1
    end
    if expr.node_id != 0 then
      env.typed_aggregate_ownership.insert(expr.node_id, tup_owned)
    end
    var types = Vec::new()
    var i = 0
    while i < elems.len() do
      let elem_ty = check_expr(env, &elems[i])
      # (channel b): a tuple literal whose element type is (or
      # contains) the RAW Slice view (UnsafeSlice) stores the raw view in a
      # container — rejected.
      check_no_escaping_slice(env, &elem_ty, elems[i].span, "stored in a container (tuple literal element)")
      types.push(elem_ty)
      i = i + 1
    end
    # (partial moves): every owned child is a transfer into the tuple (see
    # the array-literal arm).
    var ai = 0
    while ai < elems.len() do
      record_projected_consume(env, &elems[ai])
      ai = ai + 1
    end
    Type::Tuple(types)
  when ExprKind::ExprStructLit(path, fields) then
    # Record aggregate ownership: struct literal field values are owned
    # transfers into the struct (consumed by the resource checker via
    # typed.aggregate_ownership).
    var st_owned = Vec::new()
    var so0 = 0
    while so0 < fields.len() do
      st_owned.push(true)
      so0 = so0 + 1
    end
    if expr.node_id != 0 then
      env.typed_aggregate_ownership.insert(expr.node_id, st_owned)
    end
    let type_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
    let lit_result = match get_type_by_name_ref(env, type_name)
    when Option::Some(type_def) then
      # Use fresh type vars for generic params so unification works correctly
      let type_args = fresh_type_args_for(env, type_def)
      # Check struct literal field values against struct field types
      match type_def.def_kind
      when TypeDefKind::Struct(struct_fields) then
        # Track which declared fields have been initialized in the literal
        var seen = Vec::new()
        var si0 = 0
        while si0 < struct_fields.len() do
          seen.push(false)
          si0 = si0 + 1
        end
        var fi = 0
        while fi < fields.len() do
          let lit_field = fields[fi]
          var found = false
          var sj = 0
          while sj < struct_fields.len() do
            let sf = struct_fields[sj]
            if sf.name == lit_field.0 then
              if seen[sj] then
                type_add_error(env, "duplicate field `" + lit_field.0 + "` in struct literal", lit_field.1.span)
              end
              seen.set(sj, true)
              found = true
              let field_ty = subst_type_args(&sf.ty, &type_def.generic_params, &type_args)
              let field_val_ty = check_expr(env, &lit_field.1)
              unify(env, field_val_ty, field_ty, lit_field.1.span)
            end
            sj = sj + 1
          end
          if !found then
            type_add_error(env, "unknown field `" + lit_field.0 + "` on `" + type_name + "`", lit_field.1.span)
          end
          fi = fi + 1
        end
        # Every declared field must appear exactly once in the literal
        var mi = 0
        while mi < struct_fields.len() do
          if !seen[mi] then
            type_add_error(env, "missing required field `" + struct_fields[mi].name + "` on `" + type_name + "`", path.span)
          end
          mi = mi + 1
        end
      when _ then ()
      end
      Type::Adt(type_def.id, type_args)
    when Option::None then
      # Struct-style enum variant construction: Enum::Variant { field: value }.
      let enum_name = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2] else "" end
      match get_type_by_name_ref(env, enum_name)
      when Option::Some(enum_def) then
        let enum_type_args = fresh_type_args_for(env, enum_def)
        var found_variant = false
        match enum_def.def_kind
        when TypeDefKind::Enum(variants) then
          var vi = 0
          while vi < variants.len() do
            let variant = variants[vi]
            if variant.name == type_name then
              found_variant = true
              var fi2 = 0
              while fi2 < fields.len() do
                let lit_field2 = fields[fi2]
                # Variant fields are checked positionally; the checker's
                # VariantInfo does not retain struct-variant field names.
                if fi2 < variant.fields.len() then
                  let field_ty2 = subst_type_args(&variant.fields[fi2], &enum_def.generic_params, &enum_type_args)
                  let field_val_ty2 = check_expr(env, &lit_field2.1)
                  unify(env, field_val_ty2, field_ty2, lit_field2.1.span)
                else
                  type_add_error(env, "too many fields for variant `" + type_name + "`", lit_field2.1.span)
                end
                fi2 = fi2 + 1
              end
            end
            vi = vi + 1
          end
        when _ then ()
        end
        if !found_variant then
          type_add_error(env, "unknown variant `" + type_name + "` in enum `" + enum_name + "`", expr.span)
        end
        Type::Adt(enum_def.id, enum_type_args)
      when Option::None then
        type_add_error(env, "undefined type: " + type_name, expr.span)
        Type::Error
      end
    end
    # (partial moves): every owned field value is a transfer into the
    # struct — a projected OWNING value is moved out of its root (the
    # checker's transfer_consume mirror over the aggregate children).
    var fi3 = 0
    while fi3 < fields.len() do
      record_projected_consume(env, &fields[fi3].1)
      fi3 = fi3 + 1
    end
    lit_result
  when ExprKind::ExprClosure(params, ret_ty, body) then
    push_scope(env)
    var param_types = Vec::new()
    var i = 0
    while i < params.len() do
      let p = params[i]
      let ty = match p.ty
      when Option::Some(te) then resolve_type_expr(env, &te)
      when Option::None then fresh_type_var(env)
      end
 # the closure parameter pattern's variant identity is resolved
      # by the junction; the binding's source place is the call-site
      # argument (unknown at the closure definition — RawUnknown).
      resolve_pattern_variants(env, &p.pat, ty)
      check_pattern(env, &p.pat, ty, TypedPlace { root: AccessRoot::RawUnknown, root_name: "closure parameter", projections: Vec::new() })
      param_types.push(ParamType { ty: ty, convention: AccessConvention::Let })
      i = i + 1
    end
    # The closure body is checked as a FUNCTION body (the closure lowers to
    # its own MirFunction): the declared return type (ret_ty) is resolved
    # and every `return` in the body unifies against it — the same
    # expected_return discipline as check_function. Without an annotation,
    # the closure's return type is a fresh inference variable that the
    # body's returns and its tail unify against, so they must agree. The
    # enclosing function's expected_return is restored afterwards (closures
    # nest inside function bodies).
    let saved_expected_return = env.expected_return.clone()
    let decl_ret = match ret_ty
    when Option::Some(te) then Option::Some(resolve_type_expr(env, &te))
    when Option::None then Option::None
    end
    let closure_ret = match decl_ret
    when Option::Some(dr) then dr
    when Option::None then fresh_type_var(env)
    end
    env.expected_return = Option::Some(closure_ret.clone())
    # The closure body's DIRECT effectful calls accumulate into the
    # closure's OWN computed set (current_closure_node routes
    # record_effect_call's closure accumulation): the effect set the
    # closure TYPE carries (the Type::Closure effect payload) — an
    # indirect call through this closure value records these effects at
    # the call site. Nested closures save/restore the innermost node.
    let saved_closure_node = env.current_closure_node
    env.current_closure_node = expr.node_id
 # (channel a): a closure annotated with (or returning) a Slice
    # view would let the view escape with the closure value — rejected.
    check_no_escaping_slice(env, &closure_ret, body.span, "returned from a closure")
    let body_type = check_expr(env, &body)
    unify(env, body_type, closure_ret.clone(), body.span)
    env.expected_return = saved_expected_return
    env.current_closure_node = saved_closure_node
    # The capture scan runs AFTER the body check, so the body's recorded
    # call-argument effects (typed_access_effects) feed the Consume/Modify
    # capture records (scan_operand). uses = captured local id -> effect
    # (the closure_captures record); nodes = capture-node id -> effect.
    let scan = scan_closure_captures(env, &params, &body)
 # (channel c): a captured local whose type is (or contains) the
    # The RAW Slice view must not be captured into the closure — the
    # closure env would hold the raw view past its backing buffer's
    # lifetime (the capture would also escape under channel b as stored
    # state).
    let cap_entries = scan.uses.entries()
    var cei = 0
    while cei < cap_entries.len() do
      match env.typed_local_bindings.get(cap_entries[cei].0)
      when Option::Some(cap_lb) then
        if type_contains_slice_view(env, &cap_lb.ty) then
          type_add_error(env, "cannot capture a raw Slice view (UnsafeSlice[T]) into a closure: the raw {ptr,len} view is unsafe/FFI-only and must not outlive its backing buffer (capture the shared/pinned form — Vec::as_slice / String::as_str_view — or the owned clone instead)", body.span)
        end
      when Option::None then ()
      end
      cei = cei + 1
    end
    env.closure_captures.insert(expr.node_id, scan.uses)
    # Missing-metadata rule: every capture node's effect is recorded in
    # typed_access_effects (insert-only — a node that is ALSO a call
    # argument keeps its recorded argument effect).
    let node_entries = scan.nodes.entries()
    var ni = 0
    while ni < node_entries.len() do
      match env.typed_access_effects.get(node_entries[ni].0)
      when Option::Some(_) then ()
      when Option::None then env.typed_access_effects.insert(node_entries[ni].0, node_entries[ni].1)
      end
      ni = ni + 1
    end
    pop_scope(env)
 # (FnPtr/Closure split): the closure EXPRESSION types as the
    # Closure form — ClosureId (the closure node's identity — node ids are
    # globally unique within one compilation), the signature, and the
    # CAPTURE TUPLE type (Type::Tuple of the captured locals' types, in
    # local-id order). The closure object's layout/ABI derives from the
    # captures; the closure's TypeProperties derive from the capture tuple
    # (a closure capturing an owning value owns it).
    # The conflation form is no longer produced here (the Closure
    # form is).
    let cap_entries = scan.uses.entries()
    var cap_list: Vec[(Int, Type)] = Vec::new()
    var ci = 0
    while ci < cap_entries.len() do
      let cap_local_id = cap_entries[ci].0
      let cap_ty = match env.typed_local_bindings.get(cap_local_id)
      when Option::Some(lb) then lb.ty.clone()
      when Option::None then Type::Unit
      end
      cap_list.push((cap_local_id, cap_ty))
      ci = ci + 1
    end
    # Deterministic capture order: the capture tuple's element order is the
    # captured locals' id order (Map iteration order is not canonical).
    var csi = 1
    while csi < cap_list.len() do
      var csj = csi
      while csj > 0 && cap_list[csj].0 < cap_list[csj - 1].0 do
        let tmp = cap_list[csj]
        cap_list[csj] = cap_list[csj - 1]
        cap_list[csj - 1] = tmp
        csj = csj - 1
      end
      csi = csi + 1
    end
    var cap_tys = Vec::new()
    for (_, ct) in cap_list do
      cap_tys.push(ct)
    end
    # The closure's EFFECT SET: the body's direct effectful calls (the
    # closure_computed_effects accumulation from the body check above) —
    # the Type::Closure effect payload the indirect-call recording reads
    # when this closure value is invoked. A body with no effectful call
    # carries an empty set (effect-free), never a guessed one.
    var closure_effects = Vec::new()
    match env.closure_computed_effects.get(expr.node_id)
    when Option::Some(ceffs) then closure_effects = ceffs.clone()
    when Option::None then ()
    end
    Type::Closure(ClosureId { id: expr.node_id }, param_types, closure_ret, Type::Tuple(cap_tys), closure_effects)
  when ExprKind::ExprIf(if_stmt) then
 # an if used as a value contributes its flow's normal type (with
    # the Unit false-path rule for a missing else enforced inside).
    check_if_stmt(env, &if_stmt, false).normal
  when ExprKind::ExprMatch(m) then
 # a value-producing match contributes its flow's normal type.
 # (FIX 3): non-exhaustive matches over closed enums are errors in
    # statement position too (see check_match).
    check_match(env, &m, false).normal
  when ExprKind::ExprBlock(block) then
    check_block(env, &block, true).normal
  when ExprKind::ExprUnsafe(_, block) then
    check_block(env, &block, true).normal
  when ExprKind::ExprAsync(block) then
    let inner = check_block(env, &block, true).normal
    inner  # In full impl, would wrap in Future/Async
  when ExprKind::ExprAwait(inner) then
    let inner_type = check_expr(env, &inner)
    if closure_has_inout_capture(env, inner.node_id) then
      type_add_error(env, "inout capture cannot cross await", inner.span)
    else
      match inner.kind
      when ExprKind::ExprAccess(inner2) then
        if closure_has_inout_capture(env, inner2.node_id) then
          type_add_error(env, "inout capture cannot cross await", inner2.span)
        end
      when _ then ()
      end
    end
    fresh_type_var(env)
  when ExprKind::ExprTry(inner) then
 # the postfix `?` operator is NOT an exceptional construct in
    # this language: no throw/raise expression exists, no error propagation
    # is modeled at any level, and the resource CFG has no Throw/Unwind
    # edges for it. Its semantics are ERASURE — the operand's value, typed
    # here as an unconstrained fresh variable (the value's use sites
    # constrain it; MIR infers the operand type and lowers it as the
    # operand). The block exceptional forms (try/catch/finally,
    # handle/with, with) are REJECTED in check_stmt above; `?` must keep
    # type-checking because the compiler kernel itself uses it (e.g.
    # `parse_toml(s)?`).
    let inner_type = check_expr(env, &inner)
    fresh_type_var(env)
  when ExprKind::ExprCast(inner, ty) then
    check_expr(env, &inner)
    resolve_type_expr(env, &ty)
  when ExprKind::ExprTypeCheck(inner, ty) then
    check_expr(env, &inner)
    Type::Bool
  when ExprKind::ExprPipe(left, right) then
    check_expr(env, &left)
    check_expr(env, &right)
  when ExprKind::ExprRange(start, end_, _) then
    # The range expression (the `for i in lo..hi` iterable and value-range
    # positions): an Int-typed value; the bounds are checked and unified
    # with Int. The MIR lowers ranges structurally (the for-loop
    # desugaring reads the bounds directly), and the resource checker's
    # IterationPlan classifies the range form (source kind 3).
    match start
    when Option::Some(s) then
      let st = check_expr(env, &s)
      unify(env, st, Type::Int, s.span)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then
      let et = check_expr(env, &e)
      unify(env, et, Type::Int, e.span)
    when Option::None then ()
    end
    Type::Int
  when ExprKind::ExprMapLit(entries) then
    # Map literal — REJECTED at check time with an explicit diagnostic:
    # the MIR has no map-literal lowering, so an accepted literal would
    # fail only at lowering. The entries are still visited for error
    # recovery, then the construct is rejected before MIR (never an
    # Unsupported node).
    var i = 0
    while i < entries.len() do
      check_expr(env, &entries[i].0)
      check_expr(env, &entries[i].1)
      i = i + 1
    end
    type_add_error(env, "map literals are not supported: use Map::new() and insert", expr.span)
    Type::Error
  when ExprKind::ExprAssign(target, value) then
    # Assignment EXPRESSIONS share the statement-assignment semantics
    # (drop old -> store new; the MIR keys the drop chain on the
    # expression's node id); the expression's value is the stored value.
    let target_type = check_expr(env, &target)
    let value_type = check_expr(env, &value)
    unify(env, target_type, value_type, value.span)
    # (partial moves): the assignment's projected records (see the
    # StmtAssign arm — the target chain re-lives, a projected OWNING value
    # moves out of its root).
    record_projected_assign(env, &target)
    record_projected_consume(env, &value)
    value_type
  when ExprKind::ExprMacroCall(name, args) then
    if name == "vec" then
      # vec![...] — the heap-vector Adt (the same result the MIR's vec
      # lowering produces); the payload elements are consumed into the
      # vector (the Consume records mirror the ExprEnumVariant payload
      # rule, so the MIR's argument-effect lookups are always satisfied).
      if args.len() > 0 then
        let elem_ty = check_expr(env, &args[0])
        var i = 1
        while i < args.len() do
          let t = check_expr(env, &args[i])
          unify(env, elem_ty, t, args[i].span)
          i = i + 1
        end
        var ai = 0
        while ai < args.len() do
          env.typed_access_effects.insert(args[ai].node_id, AccessEffect::Consume)
          ai = ai + 1
        end
        Type::Adt(TypeId { id: env.lang_items.vec }, [elem_ty])
      else
        Type::Adt(TypeId { id: env.lang_items.vec }, [fresh_type_var(env)])
      end
    else
      type_add_error(env, "unsupported macro invocation `" + name + "`", expr.span)
      Type::Error
    end
  when ExprKind::ExprPath(path) then
    match lookup_var(env, path.segments[0])
    when Option::Some(ty) then
 # (final layer): a path whose first segment is a program-level
      # callable (scope 0) goes through the module-qualified identity check,
      # same as bare ExprIdent (see resolve_bare_callable).
      if var_is_global_callable(env, &path.segments[0]) then
        resolve_bare_callable(env, path.segments[0].clone(), expr.span, ty.clone())
      else
        ty
      end
    when Option::None then
      # Enum variant paths in value position (e.g. `Option::None`): type the
      # expression from the OWNER enum's TypeId. The variant name is only the
      # join key into the checker's tables; the semantic result is id-based
      # (Type::Adt(enum_td.id,...); the builtin Option/Result enums resolve
      # their LangItems ids via builtin_adt).
      if path.segments.len() >= 2 then
        let variant_name = path.segments[path.segments.len() - 1]
        let enum_name = path.segments[path.segments.len() - 2]
        match find_enum_variant(env, variant_name.clone())
        when Option::Some((enum_td, _)) then
          if enum_td.name == enum_name then
            let enum_type_args = fresh_type_args_for(env, &enum_td)
 # the builtin Option/Result identity is the LangItems TypeId
            # — never the declared name.
            if enum_td.id.id == env.lang_items.result then
              builtin_adt(env, "Result".to_string(), [fresh_type_var(env), fresh_type_var(env)])
            elsif enum_td.id.id == env.lang_items.option then
              builtin_adt(env, "Option".to_string(), [fresh_type_var(env)])
            else
              Type::Adt(enum_td.id, enum_type_args)
            end
          else
            fresh_type_var(env)
          end
        when Option::None then fresh_type_var(env)
        end
      else
        fresh_type_var(env)
      end
    end
  when ExprKind::ExprEnumVariant(path, args) then
    # The operation-call surface: a std::effects::perform(EFFECT.op, ...)
    # call parses as an ExprEnumVariant (the 3-segment module-qualified
    # call path) — typed against the declared effect's op table BEFORE the
    # variant/static-path fallback (an op reference is not a variant
    # payload).
    if effect_perform_callee_path(&expr) then
      var perform_callee = Expr { kind: ExprKind::ExprPath(path.clone()), span: expr.span, node_id: 0 }
      match check_effect_perform_call(env, expr, &perform_callee, &args)
      when Option::Some(perform_ty) then perform_ty
      when Option::None then check_enum_variant_construct(env, expr, &path, &args)
      end
    else
      check_enum_variant_construct(env, expr, &path, &args)
    end
  when ExprKind::ExprComptime(block) then
    # Rejected at check time with an explicit diagnostic: the MIR has no
    # comptime lowering, so an accepted block would fail only at lowering.
    # The block is still visited for error recovery, then the construct is
    # rejected before MIR (never an Unsupported node).
    check_block(env, &block, true)
    type_add_error(env, "comptime blocks are not supported", expr.span)
    Type::Error
  when _ then Type::Error
  end
  if expr.node_id != 0 then
    env.typed_expr_types.insert(expr.node_id, result.clone())
    record_typed_hir(env, expr, &result)
  end
  result
end

# The enum-variant construction / static-path call check — the
# ExprEnumVariant arm's body, extracted into a helper so the operation-
# call surface (std::effects::perform(EFFECT.op, ...) — which parses as
# an ExprEnumVariant) routes AROUND it: the perform arm short-circuits
# through check_effect_perform_call and this helper handles every other
# ExprEnumVariant form (enum variant construction, Vec::new() / Map::new()
# static-path calls).
# The enum-variant construction / static-path call check — the
# ExprEnumVariant arm's body, extracted into a helper so the operation-
# call surface (std::effects::perform(EFFECT.op, ...) — which parses as
# an ExprEnumVariant) routes AROUND it: the perform arm short-circuits
# through check_effect_perform_call and this helper handles every other
# ExprEnumVariant form (enum variant construction, Vec::new() / Map::new()
# static-path calls).
def check_enum_variant_construct(inout env: TypeEnv, expr: Expr, path: AstPath, args: Vec[Expr]) -> Type
    let variant_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
    let enum_name = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2] else "" end
    match find_enum_variant(env, variant_name.clone())
    when Option::Some((enum_td, variant)) then
      # Exact-arity rule for enum variant construction: the number of
      # supplied payload arguments must equal the variant's declared field
      # count (the same soundness requirement as function calls).
      if args.len() != variant.fields.len() then
        type_add_error(env, "wrong number of arguments: variant `" + variant_name + "` expects " +
          variant.fields.len().to_string() + " field(s), found " + args.len().to_string(), expr.span)
      end
      let enum_type_args = fresh_type_args_for(env, &enum_td)
 # (PHASE-2, item 5): every payload argument is visited and
      # typed on the standard expression path, so each arg's type is
      # recorded in typed_expr_types — the vec![..] / Vec::from([..])
      # element nodes and enum-variant payload args are the entries the MIR
      # lowering consumes. The expected arg type is the variant's field type
      # with the enum's generic parameters substituted by the construction's
      # concrete args (the same substitution the ExprIdent constructor path
      # performs), so the construction's type args are solved from the
      # payload.
      var ai = 0
      while ai < args.len() do
        let arg_ty = check_expr(env, &args[ai])
        # The payload args of a variant construction are consumed INTO the
        # variant (the construction owns them): every payload arg node
        # records AccessEffect::Consume — the record_arg_effect mirror —
        # so the MIR's call_arg_effect source-arg fallback is deletable.
        env.typed_access_effects.insert(args[ai].node_id, AccessEffect::Consume)
        # (partial moves): a projected OWNING payload is moved out of its
        # root (the checker's transfer_consume mirror).
        record_projected_consume(env, &args[ai])
        if ai < variant.fields.len() then
          let field_ty = subst_type_args(&variant.fields[ai], &enum_td.generic_params, &enum_type_args)
          unify(env, arg_ty, field_ty, args[ai].span)
        end
        ai = ai + 1
      end
 # the builtin Option/Result identity is the LangItems TypeId —
      # never the declared name (the enum's TypeDef is the registered
      # builtin; the std re-declaration keeps the builtin id).
      if enum_td.id.id == env.lang_items.result then
        builtin_adt(env, "Result".to_string(), enum_type_args)
      elsif enum_td.id.id == env.lang_items.option then
        builtin_adt(env, "Option".to_string(), enum_type_args)
      else
        Type::Adt(enum_td.id, enum_type_args)
      end
    when Option::None then
      # The variant is not registered in any checker-known enum: fall back
      # to the builtin Adt forms by name (diagnostic-grade fallback only;
      # builtin_adt resolves the LangItems ids). The arguments are still
      # visited and typed on the standard expression path so their
      # typed_expr_types entries exist — the vec! / Vec::from([..])
      # array-literal (and through it every element) node goes through this
      # fallback, since Vec is a struct and `from` is no registered variant.
      var arg_tys = Vec::new()
      var ai2 = 0
      while ai2 < args.len() do
        arg_tys.push(check_expr(env, &args[ai2]))
        # The unregistered-form fallback (vec![..] / Vec::from([..]) — the
        # array-literal payload arg) consumes the payload the same way: the
        # arg node records AccessEffect::Consume into the construction (the
        # literal's elements are consumed into the array by the
        # array-literal aggregate-ownership record).
        env.typed_access_effects.insert(args[ai2].node_id, AccessEffect::Consume)
        # (partial moves): a projected OWNING payload is moved out of its
        # root (see the registered-variant arm).
        record_projected_consume(env, &args[ai2])
        ai2 = ai2 + 1
      end
 # (static-path call shape): an ExprEnumVariant whose "variant"
      # is not a registered enum variant is an ASSOCIATED-METHOD call
      # (Vec::new() / Map::new() /...). Resolve the method through the
      # impl registry by the OWNER TYPE's TypeId (the method_lookup index —
      # the same O(1) candidate source the receiver-style method calls use;
      # "Vec" retries as the registered "Array" — the std's heap-vector
      # impl is `impl[T] Array[T]`), instantiate the signature (impl +
      # method params in the merged declaration order), unify the payload
      # args transactionally, and record the call TARGET (the method's
      # resolver DefId — the identity the MIR's method_def_ids carries) and
      # the SOLVED substitution in the merged declaration order (the
      # monomorphizer's positional contract); a parameter solved only by
      # the caller's context is parked (resolve_pending_call_instances). A
      # head mismatch (e.g. Vec::from's `&[T]` param vs a literal payload —
      # the MIR's vec-like lowering owns that shape) falls through to the
      # unregistered-form fallback below — never an error here.
      var static_ret: Option[Type] = Option::None
      if path.segments.len() >= 2 then
        let owner_type_name = path.segments[path.segments.len() - 2].clone()
        var owner_candidates = Vec::new()
        owner_candidates.push(owner_type_name.clone())
        if owner_type_name == "Vec" then
          owner_candidates.push("Array".to_string())
        end
        var oc = 0
        while oc < owner_candidates.len() && !static_ret.is_some() do
          match get_type_id_by_name(env, owner_candidates[oc].clone())
          when Option::Some(owner_tid) then
            match env.method_lookup.get(owner_tid.id)
            when Option::Some(mmap) then
              match mmap.get(variant_name.clone())
              when Option::Some(cands) then
                var cj = 0
                while cj < cands.len() && !static_ret.is_some() do
                  let imp = env.impls[cands[cj]]
                  var mj = 0
                  while mj < imp.methods.len() && !static_ret.is_some() do
                    let m = imp.methods[mj]
                    if m.name == variant_name then
                      # One fresh inference variable per declared generic
                      # parameter, in the merged declaration order (impl
                      # decl ++ method decl).
                      var sp_impl_vars = Vec::new()
                      var siv = 0
                      while siv < imp.generic_params.len() do
                        sp_impl_vars.push(fresh_type_var(env))
                        siv = siv + 1
                      end
                      var sp_met_vars = Vec::new()
                      var smv = 0
                      while smv < m.generic_params.len() do
                        sp_met_vars.push(fresh_type_var(env))
                        smv = smv + 1
                      end
                      var sp_names: Vec[GenericParamId] = Vec::new()
                      var sp_vars = Vec::new()
                      var sk = 0
                      while sk < imp.generic_params.len() do
                        sp_names.push(imp.generic_params[sk].clone())
                        sp_vars.push(sp_impl_vars[sk].clone())
                        sk = sk + 1
                      end
                      var sk2 = 0
                      while sk2 < m.generic_params.len() do
                        sp_names.push(m.generic_params[sk2].clone())
                        sp_vars.push(sp_met_vars[sk2].clone())
                        sk2 = sk2 + 1
                      end
                      var sp_inst_params = Vec::new()
                      var spi = 0
                      while spi < m.params.len() do
                        sp_inst_params.push(ParamType { ty: subst_type_args(&m.params[spi].ty, &sp_names, &sp_vars), convention: m.params[spi].convention })
                        spi = spi + 1
                      end
                      let sp_inst_ret = subst_type_args(&m.ret_type, &sp_names, &sp_vars)
                      # Transactional payload unification: a head mismatch
                      # rolls the whole attempt back and falls through.
                      var sp_arg_ok = true
                      var sai = 0
                      while sai < args.len() do
                        if sai < sp_inst_params.len() then
                          let sp_snap = subst_snapshot(env)
                          let sp_errs = env.errors.len()
                          let sp_uok = try_head_unify(env, arg_tys[sai].clone(), sp_inst_params[sai].ty.clone())
                          if sp_uok then
                            ()
                          else
                            subst_restore(env, &sp_snap)
                            errors_truncate(env, sp_errs)
                            sp_arg_ok = false
                            break
                          end
                        end
                        sai = sai + 1
                      end
                      if sp_arg_ok then
                        # The call target: the method's resolver DefId (the
                        # identity the MIR's method_def_ids / call-site
                        # instances carry) — through the SEMANTIC
                        # registration (module_symbols' qualified
                        # "path::Type::method" entries): the impl's
                        # for_type key (reconstructed from the concrete
                        # for_type) resolved at the owner type's
                        # registration path, then the qualified scan.
                        let imp_key = impl_method_key_from_type(env, &imp.for_type, &variant_name)
                        if imp_key != "" then
                          match imp.for_type
                          when Type::Adt(imp_tid, _) then
                            let imp_path = type_registration_module_path(env, &imp_tid)
                            match qualified_method_def(env, &imp_path, &imp_key)
                            when Option::Some(sp_mdid) then
                              env.typed_call_targets.insert(expr.node_id, sp_mdid.clone())
                              record_effect_call(env, Option::Some(sp_mdid))
                            when Option::None then
                              match scan_qualified_method_def(env, &imp_key)
                              when Option::Some(sp_mdid2) then
                                env.typed_call_targets.insert(expr.node_id, sp_mdid2.clone())
                                record_effect_call(env, Option::Some(sp_mdid2))
                              when Option::None then ()
                              end
                            end
                          when _ then
                            match scan_qualified_method_def(env, &imp_key)
                            when Option::Some(sp_mdid3) then
                              env.typed_call_targets.insert(expr.node_id, sp_mdid3.clone())
                              record_effect_call(env, Option::Some(sp_mdid3))
                            when Option::None then ()
                            end
                          end
                        end
                        # The solved substitution in the merged declaration
                        # order; an unsolved parameter (a return-type-only
                        # one solved by the caller's annotation context)
                        # parks the call.
                        var sp_all_solved = true
                        var sp_solved = Vec::new()
                        var sp_svi = 0
                        while sp_svi < sp_vars.len() do
                          let sp_rv = resolve_type_var(env, sp_vars[sp_svi].clone())
                          match sp_rv
                          when Type::Var(_) then sp_all_solved = false
                          when _ then sp_solved.push(sp_rv)
                          end
                          sp_svi = sp_svi + 1
                        end
                        if sp_all_solved then
                          env.typed_call_instances.insert(expr.node_id, sp_solved)
                        elsif sp_names.len() > 0 then
                          env.pending_call_instances.insert(expr.node_id, (sp_names.clone(), sp_vars, expr.span))
                        end
                        static_ret = Option::Some(resolve_type_var(env, sp_inst_ret))
                      end
                    end
                    mj = mj + 1
                  end
                  cj = cj + 1
                end
              when Option::None then ()
              end
            when Option::None then ()
            end
          when Option::None then ()
          end
          oc = oc + 1
        end
      end
      match static_ret
      when Option::Some(rt) then rt
      when Option::None then
        let v1 = fresh_type_var(env)
        if variant_name == "Ok" || variant_name == "Err" then
          builtin_adt(env, "Result".to_string(), [v1, fresh_type_var(env)])
        elsif variant_name == "Some" || variant_name == "None" then
          builtin_adt(env, "Option".to_string(), [v1])
        else
          fresh_type_var(env)
        end
      end
end
end

# ———————————————————————————————————————————————————————————————
# Field and Method Resolution
# ———————————————————————————————————————————————————————————————

def resolve_field_type(inout env: TypeEnv, recv_type: Type, field: String, span: Span) -> Type
  # Guard: if receiver is Error type, propagate silently
  match recv_type
  when Type::Error then return Type::Error
  when _ then ()
  end

  # Auto-deref through references
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end

  # Guard: if base after deref is Error, return Error
  match base
  when Type::Error then return Type::Error
  when _ then ()
  end

  match base
  when Type::Adt(tid, type_args) then
    # Direct lookup by TypeId via type_list vec
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      # The Slice/Array Adt field surface mirrors the dropped canonical
      # Type::Slice/Type::Array arms, selected by LangItems TypeId. The raw
      # view (UnsafeSlice) is the two-field VIEW { ptr: Ptr[T], len: UInt }
      # — len is its only accessor field (there is NO capacity on a view).
      # (The SAFE shared/pinned source-spelled Slice — the std-declared
      # shared struct — is an ordinary struct and takes the structural
      # field path below.)
      if tid.id == env.lang_items.slice then
        if field == "len" then Type::Int
        else fresh_type_var(env)
        end
      elsif tid.id == env.lang_items.array then
        if field == "len" then Type::Int
        else fresh_type_var(env)
        end
      else
        match td.def_kind
      when TypeDefKind::Struct(fields) then
        for f in fields do
          if f.name == field then
            # Substitute generic type parameters with concrete type arguments.
            # e.g., for Vec[T], field "ptr" has stored type Param("T"), but if
            # accessed on Vec[Int], should return Int, not Param("T").
            return subst_type_args(&f.ty, &td.generic_params, &type_args)
          end
        end
        type_add_error(env, "no field `" + field + "` on type `" + td.name + "`", span)
        Type::Error
      when TypeDefKind::Alias(inner) then
        # Resolve type alias and retry field lookup on the aliased type.
        # e.g., Duration is a typealias for Timespec (a struct with fields).
        resolve_field_type(env, &inner, field, span)
      when TypeDefKind::Trait(_) then
        # Trait types don't have fields directly - return fresh type var
        # (e.g., Iterator[T] used in for-loop desugaring)
        fresh_type_var(env)
      when TypeDefKind::Enum(_) then
        # Enum types don't have fields directly - return fresh type var
        fresh_type_var(env)
      when _ then
        # Primitive, Opaque, etc. - return fresh type var
        fresh_type_var(env)
      end
      end
    when Option::None then fresh_type_var(env)
    end
  when Type::Tuple(fields) then
    # Tuple field access by numeric index (e.g.,.0,.1); map entries also
    # support.key/.value as aliases for.0/.1.
    let field_idx = if field == "key" then "0" else field end
    let field_idx2 = if field == "value" then "1" else field_idx end
    match field_idx2.parse_int()
    when Result::Ok(idx) then
      if idx >= 0 && idx < fields.len() then
        fields[idx].clone()
      else
        type_add_error(env, "tuple index out of bounds: " + field, span)
        Type::Error
      end
    when Result::Err(_) then
      type_add_error(env, "tuple fields must be accessed by index", span)
      Type::Error
    end
  when Type::String then
    # String built-in fields
    if field == "len" then Type::Int
    else
      type_add_error(env, "no field `" + field + "` on String", span)
      Type::Error
    end
  when Type::Var(_) then fresh_type_var(env)
  when Type::FnPtr(_, _, _) | Type::Closure(_, _, _, _, _) then fresh_type_var(env)
  when Type::Bool then Type::Bool
  when Type::Int then Type::Int
  when Type::U8 then Type::U8
  when Type::U16 then Type::U16
  when Type::U32 then Type::U32
  when Type::U64 then Type::U64
  when Type::I8 then Type::I8
  when Type::I16 then Type::I16
  when Type::I32 then Type::I32
  when Type::I64 then Type::I64
  when Type::F32 then Type::F32
  when Type::F64 then Type::F64
  when Type::Char then Type::Char
  when Type::Never then Type::Never
  when Type::Error then Type::Error
  when _ then
    fresh_type_var(env)
  end
end

# Helper: check whether an impl's for_type matches a receiver type.
# Both are expected to be Type::Adt; we compare the TypeId (ignoring type args,
# since the impl's for_type may have generic params like Param("T") while the
# receiver has concrete args like Type::U8).
def impl_for_type_matches(impl_for_type: Type, recv_named: Type) -> Bool
  match impl_for_type
  when Type::Adt(tid1, _) then
    match recv_named
    when Type::Adt(tid2, _) then tid1.id == tid2.id
    when _ then false
    end
  when _ then false
  end  end
end

# the resolver's registered method-DefId key for an impl method —
# a faithful replica of resolver.tg's type_expr_to_string rendering of the
# impl's for_type plus "::" + the method name ("Array[...]::push",
# "I[...]::map" for an extension impl whose for_type is the parameter I).
def impl_registry_method_key(for_type: TypeExpr, method: String) -> String
  let type_key = match for_type.kind
  when TypeExprKind::Named(name, args) then
    if args.is_empty() then name.clone() else name.clone() + "[...]" end
  when TypeExprKind::Path(path) then path.segments.join("::")
  when TypeExprKind::Unit then "Unit".to_string()
  when TypeExprKind::Never then "Never".to_string()
  when _ then "<type>".to_string()
  end
  type_key + "::" + method
end

# search the EXTENSION impls (for_type is a Type::Param) for a
# method name. Returns (impl index, method index) of the first match, in
# source order. The impls are registered in param_for_type_impls by
# check_impl; they are NOT indexed into method_lookup because they have no
# receiver TypeId.
def find_param_for_type_method(env: TypeEnv, method: String) -> Option[(Int, Int)]
  var pi = 0
  while pi < env.param_for_type_impls.len() do
    let imp_idx = env.param_for_type_impls[pi]
    let imp = env.impls[imp_idx]
    var mi = 0
    while mi < imp.methods.len() do
      if imp.methods[mi].name == method then
        return Option::Some((imp_idx, mi))
      end
      mi = mi + 1
    end
    pi = pi + 1
  end
  Option::None
end

# instantiate a method of an EXTENSION impl — an impl whose for_type
# is a generic parameter (`impl[T, I: Iterator[T]] I`). The receiver's
# concrete type unifies the impl's head parameter (I); the impl's OTHER
# parameters (T) and the method-level parameters (U) are solved by unifying
# the instantiated method signature against the call's arguments — the same
# one-variable-per-parameter discipline as instantiate_method_type. The
# solved substitution is recorded in typed_call_instances (call node id ->
# the callee's generic args in the MIR signature-walk order — params first,
# then the return type, positionally aligned with the monomorphizer's
# infer_type_param_names); a substitution a parameter of which only the
# caller's context can solve is parked in pending_call_instances and
# re-resolved after the whole program is checked. Returns Option::None when
# the impl does not apply (head unification fails), otherwise the resolved
# return type.
def instantiate_param_for_type_method(
  inout env: TypeEnv,
  imp: ImplInfo,
  m: MethodInfo,
  recv_type: Type,
  arg_types: Vec[Type],
  method_type_args: Vec[Type],
  call_node_id: Int,
  span: Span
) -> Option[Type]
  # One fresh inference variable per impl-level generic parameter, in the
  # impl's declaration order — including parameters that never appear in
  # the for_type.
  var impl_vars = Vec::new()
  var i = 0
  while i < imp.generic_params.len() do
    impl_vars.push(fresh_type_var(env))
    i = i + 1
  end
  # Head: the for_type (a Type::Param) substituted with its variable and
  # unified with the concrete receiver — this solves the head parameter.
  let head_inst = subst_type_args(&imp.for_type, &imp.generic_params, &impl_vars)
  let head_ok = try_head_unify(env, head_inst, recv_type.clone())
  if !head_ok then
    return Option::None
  end
  # Method-level parameters: explicit type arguments or fresh variables.
  var method_vars = Vec::new()
  let explicit = method_type_args.len() > 0
  var j = 0
  while j < m.generic_params.len() do
    if explicit && j < method_type_args.len() then
      method_vars.push(method_type_args[j].clone())
    else
      method_vars.push(fresh_type_var(env))
    end
    j = j + 1
  end
  # Combined substitution: impl params first, then method-level params.
 # identity is the GenericParamId — a method param shadowing an
  # impl param is a DIFFERENT id, so both substitute independently (no
  # name-keyed collision can exist); the shadow test below is retained for
  # the record-order machinery's dedupe (two ids can only collide by
  # identity, which the interning forbids across declarations).
  var all_names = Vec::new()
  var all_vars = Vec::new()
  var method_shadowed = Vec::new()
  var k = 0
  while k < imp.generic_params.len() do
    all_names.push(imp.generic_params[k].clone())
    all_vars.push(impl_vars[k].clone())
    k = k + 1
  end
  var k2 = 0
  while k2 < m.generic_params.len() do
    var shadowed = false
    var s = 0
    while s < imp.generic_params.len() do
      if generic_param_id_eq(&imp.generic_params[s], &m.generic_params[k2]) then shadowed = true end
      s = s + 1
    end
    method_shadowed.push(shadowed)
    if !shadowed then
      all_names.push(m.generic_params[k2].clone())
      all_vars.push(method_vars[k2].clone())
    end
    k2 = k2 + 1
  end
  # Instantiate the method signature with the SAME variables — one
  # inference variable per generic parameter for the whole call.
  var inst_params = Vec::new()
  var pi = 0
  while pi < m.params.len() do
    let pt = m.params[pi]
    inst_params.push(ParamType { ty: subst_type_args(&pt.ty, &all_names, &all_vars), convention: pt.convention })
    pi = pi + 1
  end
  let inst_ret = subst_type_args(&m.ret_type, &all_names, &all_vars)
  # Unify the arguments against the instantiated signature (the receiver
  # self parameter excluded) — this solves the impl's other parameters (T)
  # and the method-level parameters (U) that appear in argument positions.
  let self_offset = if m.has_self then 1 else 0 end
  var ai = self_offset
  while ai < inst_params.len() do
    let arg_idx = ai - self_offset
    if arg_idx < arg_types.len() then
      unify(env, arg_types[arg_idx].clone(), inst_params[ai].ty.clone(), span)
    end
    ai = ai + 1
  end
 # (final, substs-order contract): the recorded substitution is
  # positionally aligned with the monomorphizer's
  # function_generic_param_names — MirFunction.generic_params, populated by
  # the MIR from the checker's generic_param_ids record in the MERGED
  # DECLARATION order (impl decl ++ method decl). The signature-appearance
  # order would scramble the common extension shape (`impl[T, I:
  # Iterator[T]] I` — the head param I appears in self BEFORE the impl's T):
  # the record is taken from all_names (the merged decl order), one entry
  # per declared parameter; a parameter that never appears in the signature
  # gets a fresh variable and is parked (reported unsolvable — fail-closed,
  # never silently dropped).
  var all_solved = true
  var solved_args = Vec::new()
  var svi = 0
  while svi < all_names.len() do
    let rv = resolve_type_var(env, all_vars[svi].clone())
    match rv
    when Type::Var(_) then all_solved = false
    when _ then solved_args.push(rv)
    end
    svi = svi + 1
  end
  if all_solved then
    env.typed_call_instances.insert(call_node_id, solved_args)
  elsif all_names.len() > 0 then
    env.pending_call_instances.insert(call_node_id, (all_names.clone(), all_vars, span))
  end
  Option::Some(resolve_type_var(env, inst_ret))
end

# instantiate a TRAIT-impl method for a bare Param receiver inside a
# generic body (see resolve_method_type section 5). The Param is an opaque
# instance of its bound trait: the impl head is accepted by the PARAM BINDING
# (strict unify rejects Param-vs-Named — the head shape matches and its
# argument variables are bound to the bound trait's type arguments
# positionally, the common shape where the trait's element argument is the
# head's corresponding argument, e.g. Iterator[T] for ArrayIterator[T]), the
# method-level parameters solve from the call arguments, and the solved
# substitution is recorded in typed_call_instances exactly like the
# impl-registry path; a substitution a parameter of which only the generic
# BODY's later unifications can solve (e.g. the trait impl's element variable
# unified through the match-arm payload) is parked in pending_call_instances
# and re-resolved after the whole program is checked
# (resolve_pending_call_instances). Returns Option::None when the receiver is
# not a Param.
def instantiate_param_bound_method(
  inout env: TypeEnv,
  imp: ImplInfo,
  m: MethodInfo,
  recv_type: Type,
  bound_args: Vec[Type],
  arg_types: Vec[Type],
  method_type_args: Vec[Type],
  call_node_id: Int,
  span: Span
) -> Option[Type]
  match recv_type
  when Type::Param(_) then ()
  when _ then return Option::None
  end
  # One fresh inference variable per impl-level generic parameter, in the
  # impl's declaration order (same discipline as the extension-impl solver).
  var impl_vars = Vec::new()
  var i = 0
  while i < imp.generic_params.len() do
    impl_vars.push(fresh_type_var(env))
    i = i + 1
  end
  let head_inst = subst_type_args(&imp.for_type, &imp.generic_params, &impl_vars)
  # The param binding: the Param is an opaque instance of the bound trait, so
  # the instantiated head matches by shape. Strict unify rejects
  # Param-vs-Named (its diagnostic is discarded); the head's argument
  # variables are then bound to the bound trait's type arguments
  # positionally, which solves the method signature at the call site for the
  # common shape.
  let errors_before = env.errors.len()
  let head_ok = unify(env, head_inst.clone(), recv_type.clone(), Span { file: "", start: 0, end_pos: 0 })
  if !head_ok then
    while env.errors.len() > errors_before do
      env.errors.pop()
    end
    match head_inst
    when Type::Adt(_, head_args) then
      var hi = 0
      while hi < head_args.len() do
        if hi < bound_args.len() then
          match head_args[hi]
          when Type::Var(_) then unify(env, head_args[hi].clone(), bound_args[hi].clone(), span)
          when _ then ()
          end
        end
        hi = hi + 1
      end
    when _ then ()
    end
  end
  # Method-level parameters: explicit type arguments or fresh variables.
  var method_vars = Vec::new()
  let explicit = method_type_args.len() > 0
  var j = 0
  while j < m.generic_params.len() do
    if explicit && j < method_type_args.len() then
      method_vars.push(method_type_args[j].clone())
    else
      method_vars.push(fresh_type_var(env))
    end
    j = j + 1
  end
  # Combined substitution: impl params first, then method-level params.
 # identity is the GenericParamId (see the extension-impl
  # solver's note — shadowing same-named parameters are distinct ids).
  var all_names = Vec::new()
  var all_vars = Vec::new()
  var method_shadowed = Vec::new()
  var k = 0
  while k < imp.generic_params.len() do
    all_names.push(imp.generic_params[k].clone())
    all_vars.push(impl_vars[k].clone())
    k = k + 1
  end
  var k2 = 0
  while k2 < m.generic_params.len() do
    var shadowed = false
    var s = 0
    while s < imp.generic_params.len() do
      if generic_param_id_eq(&imp.generic_params[s], &m.generic_params[k2]) then shadowed = true end
      s = s + 1
    end
    method_shadowed.push(shadowed)
    if !shadowed then
      all_names.push(m.generic_params[k2].clone())
      all_vars.push(method_vars[k2].clone())
    end
    k2 = k2 + 1
  end
  # Instantiate the method signature with the SAME variables.
  var inst_params = Vec::new()
  var pi = 0
  while pi < m.params.len() do
    let pt = m.params[pi]
    inst_params.push(ParamType { ty: subst_type_args(&pt.ty, &all_names, &all_vars), convention: pt.convention })
    pi = pi + 1
  end
  let inst_ret = subst_type_args(&m.ret_type, &all_names, &all_vars)
  # Unify the arguments against the instantiated signature (the receiver
  # self parameter excluded).
  let self_offset = if m.has_self then 1 else 0 end
  var ai = self_offset
  while ai < inst_params.len() do
    let arg_idx = ai - self_offset
    if arg_idx < arg_types.len() then
      unify(env, arg_types[arg_idx].clone(), inst_params[ai].ty.clone(), span)
    end
    ai = ai + 1
  end
 # (final, substs-order contract): record the substitution in the
  # MERGED DECLARATION order (all_names — impl decl ++ method decl), the
  # order the monomorphizer pairs positionally against
  # function_generic_param_names (MirFunction.generic_params, populated
  # from the checker's generic_param_ids record); the signature-appearance
  # order would swap the head param against the impl's earlier params.
  # A parameter that never appears in the signature gets a fresh variable
  # and is parked (reported unsolvable — fail-closed).
  var all_solved = true
  var solved_args = Vec::new()
  var svi = 0
  while svi < all_names.len() do
    let rv = resolve_type_var(env, all_vars[svi].clone())
    match rv
    when Type::Var(_) then all_solved = false
    when _ then solved_args.push(rv)
    end
    svi = svi + 1
  end
  if all_solved then
    env.typed_call_instances.insert(call_node_id, solved_args)
  elsif all_names.len() > 0 then
    env.pending_call_instances.insert(call_node_id, (all_names.clone(), all_vars, span))
  end
  Option::Some(resolve_type_var(env, inst_ret))
end

# FIX 1: instantiate a generic signature ONCE per call. Every
# Type::Param occurrence becomes the SAME fresh inference variable for the
# whole call (parameters and return type share it), eliminating the
# wildcard behavior where each occurrence of T could independently match
# anything. `var_map` carries param numeric GenericParamId -> inference
# variable across the parameters and the return type of one call:
# keyed by identity — two same-named parameters of different declarations
# are distinct variables).
def instantiate_generic_type(inout env: TypeEnv, ty: Type, inout var_map: Map[Int, Type]) -> Type
  match ty
  when Type::Param(gpid) then
    let pkey = generic_param_id_numeric(&gpid)
    match var_map.get(pkey)
    when Option::Some(v) then v.clone()
    when Option::None then
      let v = fresh_type_var(env)
      var_map.insert(pkey, v.clone())
      v
    end
  when Type::Adt(tid, args) then
    var new_args = Vec::new()
    var i = 0
    while i < args.len() do
      new_args.push(instantiate_generic_type(env, &args[i], var_map))
      i = i + 1
    end
    Type::Adt(tid, new_args)
  when Type::RefInternal(inner, mutable) then Type::RefInternal(instantiate_generic_type(env, inner, var_map), mutable)
  when Type::Ptr(inner) then Type::Ptr(instantiate_generic_type(env, inner, var_map))
  when Type::PtrMut(inner) then Type::PtrMut(instantiate_generic_type(env, inner, var_map))
  when Type::Tuple(fields) then
    var new_fields = Vec::new()
    var i = 0
    while i < fields.len() do
      new_fields.push(instantiate_generic_type(env, &fields[i], var_map))
      i = i + 1
    end
    Type::Tuple(new_fields)
  when Type::FnPtr(params, ret, effects) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: instantiate_generic_type(env, &pt.ty, var_map), convention: pt.convention })
      i = i + 1
    end
    Type::FnPtr(new_params, instantiate_generic_type(env, ret, var_map), effects.clone())
  when Type::Closure(cid, params, ret, captures, effects) then
    var new_params = Vec::new()
    var i = 0
    while i < params.len() do
      let pt = params[i]
      new_params.push(ParamType { ty: instantiate_generic_type(env, &pt.ty, var_map), convention: pt.convention })
      i = i + 1
    end
    Type::Closure(cid.clone(), new_params, instantiate_generic_type(env, ret, var_map), instantiate_generic_type(env, &captures, var_map), effects.clone())
  when Type::Effect(effects, inner) then
 # (defect fix): the instantiation PRESERVES the effect set — the
    # effects pass through unchanged (instantiation never drops the
    # effect set of a generic signature's effect-typed parameter).
    Type::Effect(effects.clone(), instantiate_generic_type(env, inner, var_map))
  when _ then ty.clone()
  end  end
end

# FIX 1: instantiate an impl method's generic parameters ONCE per
# call. Impl-level parameters are solved by unifying the instantiated impl
# HEAD with the concrete receiver; method-level parameters by explicit type
# arguments or by unifying the arguments against the instantiated signature.
# The substitution always comes from head unification, never from
# generic-parameter index. After solving, every generic parameter of the
# callee must be bound; an unsolved one is reported as
# "cannot infer type parameter `T`".
def instantiate_method_type(inout env: TypeEnv, imp: ImplInfo, m: MethodInfo, recv_type: Type, arg_types: Vec[Type], method_type_args: Vec[Type], call_node_id: Int, span: Span) -> Type
 # the impl's generic parameters come from ImplInfo.generic_params
  # (declaration order) EXCLUSIVELY — never a head-derived scan, so a
  # parameter that appears only in the trait arguments / method signature
  # (e.g. the A of `impl From[A] for T`'s `from(x: A)`) still gets its
  # fresh inference variable and substitutes positionally.
  let names = imp.generic_params.clone()
  var impl_vars = Vec::new()
  var i = 0
  while i < names.len() do
    impl_vars.push(fresh_type_var(env))
    i = i + 1
  end
  let head_inst = subst_type_args(&imp.for_type, &names, &impl_vars)
  let head_ok = try_head_unify(env, head_inst, recv_type.clone())
  var method_vars = Vec::new()
  let explicit = method_type_args.len() > 0
  var j = 0
  while j < m.generic_params.len() do
    if explicit && j < method_type_args.len() then
      method_vars.push(method_type_args[j].clone())
    else
      method_vars.push(fresh_type_var(env))
    end
    j = j + 1
  end
  # Combined substitution: impl params first, then method-level params.
 # identity is the GenericParamId (same-named shadowing
  # parameters are distinct ids and both substitute independently).
  var all_names = Vec::new()
  var all_vars = Vec::new()
  var method_shadowed = Vec::new()
  var k = 0
  while k < names.len() do
    all_names.push(names[k].clone())
    all_vars.push(impl_vars[k].clone())
    k = k + 1
  end
  var k2 = 0
  while k2 < m.generic_params.len() do
    var shadowed = false
    var s = 0
    while s < names.len() do
      if generic_param_id_eq(&names[s], &m.generic_params[k2]) then shadowed = true end
      s = s + 1
    end
    method_shadowed.push(shadowed)
    if !shadowed then
      all_names.push(m.generic_params[k2].clone())
      all_vars.push(method_vars[k2].clone())
    end
    k2 = k2 + 1
  end
  # Instantiate the method signature with the SAME variables used for the
  # head: one inference variable per generic parameter for the whole call.
  var inst_params = Vec::new()
  var pi = 0
  while pi < m.params.len() do
    let pt = m.params[pi]
    inst_params.push(ParamType { ty: subst_type_args(&pt.ty, &all_names, &all_vars), convention: pt.convention })
    pi = pi + 1
  end
  let inst_ret = subst_type_args(&m.ret_type, &all_names, &all_vars)
  # Unify the arguments against the instantiated signature (the receiver
  # self parameter excluded). This is what solves method-level inference
  # variables such as U in `map[U]`.
  let self_offset = if m.has_self then 1 else 0 end
  var ai = self_offset
  while ai < inst_params.len() do
    let arg_idx = ai - self_offset
    if arg_idx < arg_types.len() then
      unify(env, arg_types[arg_idx].clone(), inst_params[ai].ty.clone(), span)
    end
    ai = ai + 1
  end
  if head_ok then
    # FIX 1 verification: every generic parameter of the callee must be
    # SOLVED. Impl-level params are solved by the receiver (head)
    # unification; method-level params (when not given explicitly) by the
    # arguments. A method-level param appearing only in the return type is
    # solved by the caller's context and is not reported here (same rule as
    # plain ExprCall).
    var method_param_names: Vec[GenericParamId] = Vec::new()
    var mpi = 0
    while mpi < m.params.len() do
      collect_param_names_from_type(env, &m.params[mpi].ty, &mut method_param_names)
      mpi = mpi + 1
    end
    var vi = 0
    while vi < impl_vars.len() do
      match resolve_type_var(env, impl_vars[vi].clone())
      when Type::Var(_) then
        type_add_error(env, "cannot infer type parameter `" + generic_param_name_of(&env.generic_param_table, &names[vi]) + "`", span)
      when _ then ()
      end
      vi = vi + 1
    end
    if !explicit then
      var vj = 0
      while vj < method_vars.len() do
        if !method_shadowed[vj] then
          var in_params = false
          var mp2 = 0
          while mp2 < method_param_names.len() do
            if generic_param_id_eq(&method_param_names[mp2], &m.generic_params[vj]) then in_params = true end
            mp2 = mp2 + 1
          end
          if in_params then
            match resolve_type_var(env, method_vars[vj].clone())
            when Type::Var(_) then
              type_add_error(env, "cannot infer type parameter `" + generic_param_name_of(&env.generic_param_table, &m.generic_params[vj]) + "`", span)
            when _ then ()
            end
          end
        end
        vj = vj + 1
      end
    end
 # (final) / the SOLVED substitution is the AUTHORITY —
    # record it for this call node in the callee's generic-parameter order
    # (impl-level params first, then method-level params — positionally
    # aligned with the monomorphizer's function_generic_param_names, which
    # lower_function populated from the checker's generic_param_ids record
    # in the MERGED DECLARATION order: impl decl ++ method decl). When
    # EVERY generic parameter of the callee is solved at the call site the
    # instance is recorded immediately; a parameter solved only by the
    # CALLER's context (e.g. a return-type-only method parameter unified
    # with the let-binding annotation AFTER the call) is parked in
    # pending_call_instances and re-resolved after the whole program is
    # checked. ZERO-INFERENCE: a parameter no context ever solves is
    # reported by resolve_pending_call_instances ("cannot infer type
    # parameter `T`: add an annotation") — the monomorphizer performs no
    # call-site inference (fail-closed). A parameter that never appears in
    # the signature (a phantom) gets a fresh variable and is parked
    # (reported unsolvable — never silently dropped, which would shift the
    # positional pairing).
    var all_solved = true
    var solved_args = Vec::new()
    var rvi = 0
    while rvi < all_names.len() do
      let rv = resolve_type_var(env, all_vars[rvi].clone())
      match rv
      when Type::Var(_) then all_solved = false
      when _ then solved_args.push(rv)
      end
      rvi = rvi + 1
    end
    if all_solved then
      env.typed_call_instances.insert(call_node_id, solved_args)
    elsif all_names.len() > 0 then
      env.pending_call_instances.insert(call_node_id, (all_names.clone(), all_vars, span))
    end
    resolve_type_var(env, inst_ret)
  else
    # The impl head does not unify with this receiver instantiation (e.g. a
    # concrete-head impl selected by TypeId for a different instantiation);
    # fall back to the declared return type.
    m.ret_type
  end
end

# (residual): explicit instantiation for the builtin-method table
# (resolve_method_type's Adt arms for the builtin compounds). The
# method-level generic U is a fresh InferVar (or the explicit method type
# argument), unified with the argument that carries it —
# the fn argument's return type — exactly like the impl-registry path in
# instantiate_method_type. The SOLVED U is returned AND recorded in
# typed_call_instances (call node id -> [receiver args] ++ [U] — the
# merged declaration order of the would-be `impl[K, V] T[K, V] { fn
# m[U](...) }` callee, positionally aligned with the monomorphizer's
# function_generic_param_names) when every generic parameter solves; when
# the fn argument is unresolved (or absent) U remains an InferVar and the
# recording is skipped — a U no context ever solves is a genuinely
# unconstrained shape and is reported (the end-of-check pending
# resolution, or the monomorphizer's fail-closed error for a call that
# never parked); inference is not performed on the program's call graph.
#
# mode selects the fn-return -> U extraction:
#   "ret"  — U = the fn return type itself         (map / map_or / map_err / fold)
#   "opt"  — U = the Option inner of the fn return (and_then)
#   "rerr" — U = the Result error of the fn return (or_else)
def solve_builtin_method_u(inout env: TypeEnv, recv_args: Vec[Type], arg_types: Vec[Type], fn_idx: Int, mode: String, method_type_args: Vec[Type], call_node_id: Int, span: Span) -> Type
  let u = if method_type_args.len() > 0 then method_type_args[0].clone() else fresh_type_var(env) end
  if fn_idx < arg_types.len() then
    let arg_ty = resolve_type_var(env, arg_types[fn_idx].clone())
    match arg_ty
    when Type::FnPtr(_, ret, _) | Type::Closure(_, _, ret, _, _) then
      if mode == "opt" then
        match builtin_option_inner(env, &ret)
        when Option::Some(inner) then unify(env, u.clone(), inner, span)
        when Option::None then ()
        end
      elsif mode == "rerr" then
        match builtin_result_err(env, &ret)
        when Option::Some(ierr) then unify(env, u.clone(), ierr, span)
        when Option::None then ()
        end
      else
        unify(env, u.clone(), ret, span)
      end
    when _ then ()
    end
  end
  let solved = resolve_type_var(env, u.clone())
  match solved
  when Type::Var(_) then ()
  when _ then
    # The recorded substitution is the receiver's container args (the
    # impl's declared params, in order) followed by the solved method
    # parameter — the merged declaration order of the callee's generic
    # list. A receiver arg still unresolved (a fresh receiver shape) skips
    # the recording — the monomorphizer never sees a partial payload.
    var substs = Vec::new()
    var ok = true
    var rai = 0
    while rai < recv_args.len() do
      let ra = resolve_type_var(env, recv_args[rai].clone())
      match ra
      when Type::Var(_) then ok = false
      when _ then substs.push(ra)
      end
      rai = rai + 1
    end
    if ok then
      substs.push(solved)
      env.typed_call_instances.insert(call_node_id, substs)
    end
  end
  solved
end

# Extract the payload inner of an Option-typed Adt value (the LangItems
# option id) — the U of `and_then` is the fn argument's return Option inner.
def builtin_option_inner(env: TypeEnv, ty: Type) -> Option[Type]
  match ty
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.option && args.len() >= 1 then Option::Some(args[0].clone()) else Option::None end
  when _ then Option::None
  end  end
end

# Extract the error component of a Result-typed Adt value (the LangItems
# result id) — the F of `or_else` is the fn argument's return Result error.
def builtin_result_err(env: TypeEnv, ty: Type) -> Option[Type]
  match ty
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.result && args.len() >= 2 then Option::Some(args[1].clone()) else Option::None end
  when _ then Option::None
  end  end
end

def resolve_method_type(inout env: TypeEnv, recv_type: Type, method: String, arg_types: Vec[Type], method_type_args: Vec[Type], call_node_id: Int, span: Span) -> Type
  # A candidate method found in an inherent impl whose bounds the receiver
  # does NOT satisfy (the impl_bounds_satisfied gate in section 1 below) is
  # not applicable; when no other impl/section resolves the method, the
  # resolution reports the SPECIFIC bound diagnostic naming the impl's
  # parameter and the first unsolved bound ("method `peek_front` requires
  # `T: Copy`") instead of the generic no-method error.
  var blocked: Option[String] = Option::None
  # Auto-deref through references
  let base = match recv_type
  when Type::RefInternal(inner, _) then inner
  when Type::Adt(tid, args) then
    if tid.id == env.lang_items.box_ && args.len() >= 1 then args[0].clone() else recv_type end
  when _ then recv_type
  end

  # Guard: error type propagation
  match base
  when Type::Error then return Type::Error
  when _ then ()
  end

  # Resolve the base type, following through type aliases
  # (e.g., Duration is a typealias for Timespec)
  let resolved_base = match base
  when Type::Adt(tid, _) then
    match get_type_by_id_ref(env, &tid)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Alias(inner) then inner.clone()
      when _ then base.clone()
      end
    when Option::None then base.clone()
    end
  when _ then base.clone()
  end

  # 1. Check inherent methods on the type (filtering by for_type TypeId),
  # via the O(1) receiver -> method -> candidate index.
  match resolved_base
  when Type::Adt(tid, _) then
    match env.method_lookup.get(tid.id)
    when Option::Some(mmap) then
      match mmap.get(method)
      when Option::Some(cands) then
        var ci = 0
        while ci < cands.len() do
          let imp = env.impls[cands[ci]]
          if imp.trait_name == "" || imp.trait_name == "_" then
            # Only consider impls whose for_type matches the receiver type
            if impl_for_type_matches(&imp.for_type, &resolved_base) then
              var mi2 = 0
              while mi2 < imp.methods.len() do
                let m = imp.methods[mi2]
                if m.name == method then
                  # THE INHERENT-IMPL BOUNDS GATE: a candidate in an
                  # inherent impl whose generic parameters carry bounds is
                  # applicable ONLY IF the receiver's concrete type args
                  # satisfy the impl's obligations (impl_bounds_satisfied —
                  # head unification + the real obligation solver; the
                  # substituted args are checked in the impl's declaration
                  # order). A generic caller's T inside the receiver args is
                  # checked against the CALLER's generic context
                  # (env.param_bounds, consulted by solve_obligation on the
                  # Param subject): `[T: Copy]` proves Copy(T), an
                  # unconstrained T proves nothing — the generic path is
                  # closed exactly like the concrete one. On failure the
                  # candidate is NOT applicable: the search continues to the
                  # other impls of the same receiver type (the base
                  # no-bounds impls), and the FIRST blocked candidate is
                  # remembered for the specific bound diagnostic if no
                  # applicable method remains.
                  if impl_bounds_satisfied(env, &imp, &resolved_base) then
                    # FIX 1: explicit generic instantiation — one
                    # inference variable per generic parameter for the whole
                    # call, solved by impl-HEAD unification with the receiver
                    # and by argument unification; the return type is the
                    # solved substitution.
                    if imp.generic_params.len() > 0 || m.generic_params.len() > 0 then
                      return instantiate_method_type(env, &imp, &m, &resolved_base, arg_types, method_type_args, call_node_id, span)
                    else
                      return m.ret_type
                    end
                  else
                    match blocked
                    when Option::None then
                      match impl_bounds_violation(env, &imp, &resolved_base)
                      when Option::Some((bpname, btname)) then
                        blocked = Option::Some("method `" + method + "` requires `" + bpname + ": " + btname + "`")
                      when Option::None then ()
                      end
                    when Option::Some(_) then ()
                    end
                  end
                end
                mi2 = mi2 + 1
              end
            end
          end
          ci = ci + 1
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end

  # 2. Built-in methods on common types. These take priority over a blind
  # trait-method-by-name search so that e.g. String.clone resolves to String
  # rather than the first `clone` defined in any trait impl.
  match base
  when Type::String then
    if method == "len" then return Type::Int end
    if method == "to_string" then return Type::String end
    if method == "contains" then return Type::Bool end
    if method == "starts_with" then return Type::Bool end
    if method == "ends_with" then return Type::Bool end
    if method == "slice" then return Type::String end
    if method == "trim" then return Type::String end
    # The split/chars/bytes results are the Adt form of the registered RAW
    # view builtin (UnsafeSlice — the compiler-scoped loop-consumed
    # iterable forms; the SAFE source-spelled Slice is the shared struct).
    if method == "split" then return builtin_adt(env, "UnsafeSlice".to_string(), [Type::String]) end
    if method == "chars" then return builtin_adt(env, "UnsafeSlice".to_string(), [Type::Char]) end
    if method == "bytes" then return builtin_adt(env, "UnsafeSlice".to_string(), [Type::Int]) end
    if method == "push" then return Type::Unit end
    if method == "clone" then return Type::String end
  when Type::Int then
    if method == "to_string" then return Type::String end
    if method == "abs" then return Type::Int end
    if method == "pow" then return Type::Int end
    if method == "min" then return Type::Int end
    if method == "max" then return Type::Int end
    if method == "clamp" then return Type::Int end
  when Type::Float then
    if method == "to_string" then return Type::String end
    if method == "abs" then return Type::Float end
    if method == "sqrt" then return Type::Float end
    if method == "floor" then return Type::Int end
    if method == "ceil" then return Type::Int end
    if method == "round" then return Type::Int end
  when Type::Bool then
    if method == "to_string" then return Type::String end
  when Type::Adt(tid, args) then
    # Smart pointers and Vec are Adt types; handle their common methods by
    # the resolved builtin name so `.clone()`/`.as_ref()` don't fall into
    # the trait-by-name search. The builtin compounds' method tables are the
    # Adt twins of the dropped canonical arms (Slice/Option/Result/Map/Set/
    # Box/Rc), selected by the builtin's name (Arc/UniquePtr etc. have no
    # LangItems entries and stay name-selected). Method RESULTS are produced
    # in the Adt form via builtin_adt (the LangItems ids).
    let _nn = match get_type_by_id_ref(env, tid)
    when Option::Some(td) then td.name.clone()
    when Option::None then ""
    end
    if _nn == "Box" then
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "as_ref" then return inner end
      if method == "as_mut" then return inner end
      if method == "clone" then return builtin_adt(env, "Box".to_string(), [inner]) end
      if method == "deref" then return inner end
      if method == "is_null" then return Type::Bool end
    elsif _nn == "Rc" || _nn == "Arc" then
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "as_ref" then return inner end
      if method == "clone" then return Type::Adt(tid.clone(), args.clone()) end
      if method == "strong_count" then return Type::UInt end
    elsif _nn == "Vec" then
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "len" then return Type::Int end
      if method == "is_empty" then return Type::Bool end
      if method == "push" then return Type::Unit end
      # Option is a registered builtin — its Adt form (builtin_adt).
      if method == "pop" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "get" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "clone" then return Type::Adt(tid.clone(), args.clone()) end
      if method == "iter" then return builtin_adt(env, "UnsafeSlice".to_string(), [inner]) end
    elsif _nn == "UnsafeSlice" then
      # The RAW view's method table — the compiler-scoped loop-consumed
      # iterable forms (iter/map/filter/clone/keys/values) produce raw
      # {ptr,len} views, consumed by the enclosing for-loop (never
      # storable). The SAFE source-spelled Slice is NOT this arm: it is the
      # std-declared shared struct with its compiled methods.
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "get" || method == "iter" || method == "clone" || method == "slice" || method == "extend" then
        if type_has_resource_kind(env, &inner) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", span)
        end
      end
      if method == "len" then return Type::Int end
      if method == "is_empty" then return Type::Bool end
      if method == "push" then return Type::Unit end
      # Option is a registered builtin — its Adt form (builtin_adt).
      if method == "pop" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "get" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "contains" then return Type::Bool end
      if method == "iter" then return builtin_adt(env, "UnsafeSlice".to_string(), [inner]) end
 # (residual): Slice map/fold — U solved from the fn
      # argument's return and recorded (the iterator-adapter map); filter
      # returns the raw view with no method-level generic.
      if method == "map" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "ret", method_type_args, call_node_id, span)
        return builtin_adt(env, "UnsafeSlice".to_string(), [u])
      end
      if method == "filter" then return builtin_adt(env, "UnsafeSlice".to_string(), [inner]) end
      if method == "fold" then
        let u = solve_builtin_method_u(env, &args, arg_types, 1, "ret", method_type_args, call_node_id, span)
        return u
      end
      if method == "clone" then return builtin_adt(env, "UnsafeSlice".to_string(), [inner]) end
      if method == "sort" then return Type::Unit end
      if method == "reverse" then return Type::Unit end
      if method == "first" then return builtin_adt(env, "Option".to_string(), [inner]) end
      if method == "last" then return builtin_adt(env, "Option".to_string(), [inner]) end
    elsif _nn == "Option" then
      let inner = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "unwrap" then return inner end
      if method == "is_some" then return Type::Bool end
      if method == "is_none" then return Type::Bool end
 # (residual): Option map/and_then — U solved from the fn
      # argument's return (and_then from its Option inner) and recorded.
      if method == "map" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "ret", method_type_args, call_node_id, span)
        return builtin_adt(env, "Option".to_string(), [u])
      end
      if method == "and_then" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "opt", method_type_args, call_node_id, span)
        return builtin_adt(env, "Option".to_string(), [u])
      end
 # (residual): Option or_else — U solved from the fn
      # argument's return Option inner and recorded.
      if method == "or_else" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "opt", method_type_args, call_node_id, span)
        return builtin_adt(env, "Option".to_string(), [u])
      end
      if method == "unwrap_or" then return inner end
 # (residual): Option map_or — U solved from the fn
      # argument's return (the default argument carries the same U).
      if method == "map_or" then
        let u = solve_builtin_method_u(env, &args, arg_types, 1, "ret", method_type_args, call_node_id, span)
        return u
      end
      # The Adt form (builtin_adt — the LangItems id).
      if method == "clone" then return builtin_adt(env, "Option".to_string(), [inner]) end
    elsif _nn == "Result" then
      let ok = if args.len() >= 2 then args[0].clone() else fresh_type_var(env) end
      let err = if args.len() >= 2 then args[1].clone() else fresh_type_var(env) end
      if method == "unwrap" then return ok end
      if method == "is_ok" then return Type::Bool end
      if method == "is_err" then return Type::Bool end
 # (residual): Result map/map_err/and_then — U/F solved from
      # the fn argument's return (and_then from its Option inner) and
      # recorded.
      if method == "map" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "ret", method_type_args, call_node_id, span)
        return builtin_adt(env, "Result".to_string(), [u, err])
      end
      if method == "map_err" then
        let f = solve_builtin_method_u(env, &args, arg_types, 0, "ret", method_type_args, call_node_id, span)
        return builtin_adt(env, "Result".to_string(), [ok, f])
      end
      if method == "and_then" then
        let u = solve_builtin_method_u(env, &args, arg_types, 0, "opt", method_type_args, call_node_id, span)
        return builtin_adt(env, "Result".to_string(), [u, err])
      end
      if method == "unwrap_or" then return ok end
 # (residual): Result or_else — F solved from the fn
      # argument's return Result error component.
      if method == "or_else" then
        let f = solve_builtin_method_u(env, &args, arg_types, 0, "rerr", method_type_args, call_node_id, span)
        return builtin_adt(env, "Result".to_string(), [ok, f])
      end
      # The Adt form (builtin_adt — the LangItems id).
      if method == "ok" then return builtin_adt(env, "Option".to_string(), [ok]) end
      if method == "err" then return builtin_adt(env, "Option".to_string(), [err]) end
      if method == "clone" then return builtin_adt(env, "Result".to_string(), [ok, err]) end
    elsif _nn == "Map" then
      let k = if args.len() >= 2 then args[0].clone() else fresh_type_var(env) end
      let v = if args.len() >= 2 then args[1].clone() else fresh_type_var(env) end
      if method == "get" || method == "keys" || method == "values" || method == "entries" || method == "clone" then
        if type_has_resource_kind(env, &v) || type_has_resource_kind(env, &k) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", span)
        end
      end
      # Option is a registered builtin — its Adt form (builtin_adt).
      if method == "get" then return builtin_adt(env, "Option".to_string(), [v]) end
      if method == "insert" then return builtin_adt(env, "Option".to_string(), [v]) end
      if method == "contains_key" then return Type::Bool end
      if method == "remove" then return builtin_adt(env, "Option".to_string(), [v]) end
      if method == "len" then return Type::Int end
      if method == "is_empty" then return Type::Bool end
      if method == "keys" then return builtin_adt(env, "UnsafeSlice".to_string(), [k]) end
      if method == "values" then return builtin_adt(env, "UnsafeSlice".to_string(), [v]) end
      if method == "clone" then return builtin_adt(env, "Map".to_string(), [k, v]) end
    elsif _nn == "Set" then
      let elem = if args.len() >= 1 then args[0].clone() else fresh_type_var(env) end
      if method == "iter" || method == "clone" then
        if type_has_resource_kind(env, &elem) then
          type_add_error(env, "cannot extract resource element from shared container; use an inout/consuming access", span)
        end
      end
      if method == "contains" then return Type::Bool end
      if method == "insert" then return Type::Bool end
      if method == "remove" then return Type::Bool end
      if method == "len" then return Type::Int end
      if method == "is_empty" then return Type::Bool end
      # The Adt form (builtin_adt — the LangItems id).
      if method == "clone" then return builtin_adt(env, "Set".to_string(), [elem]) end
    end
  when Type::FixedArray(elem, n) then
    # Fixed arrays: len/is_empty are compile-time constants (the count is
    # carried in the type; codegen emits the constant, never a header read).
    if method == "len" then return Type::Int end
    if method == "is_empty" then return Type::Bool end
  when Type::Ptr(inner) then
    if method == "is_null" then return Type::Bool end
    if method == "as_ref" then return inner end
    if method == "as_mut" then return inner end
    if method == "offset" then return Type::Ptr(inner) end
    if method == "add" then return Type::Ptr(inner) end
    # Typed destruction glue: the codegen lowers drop_in_place to the
    # pointee's semantic deinit plan (never an empty library shim).
    if method == "drop_in_place" then return Type::Unit end
  when Type::PtrMut(inner) then
    if method == "is_null" then return Type::Bool end
    if method == "as_ref" then return inner end
    if method == "as_mut" then return inner end
    if method == "offset" then return Type::PtrMut(inner) end
    if method == "add" then return Type::PtrMut(inner) end
    if method == "drop_in_place" then return Type::Unit end
  when _ then ()
  end

  # 3. Check trait impls (by method name only — full trait resolution is TODO).
  # Runs after built-in methods so a built-in (e.g. String.clone) wins over an
  # unrelated trait impl that happens to define the same method name.
  # The impl's for_type must match the receiver so `TaintSource.clone()` never
  # picks up `Clone for PanicInfo`'s clone.
  match resolved_base
  when Type::Adt(tid, _) then
    match env.method_lookup.get(tid.id)
    when Option::Some(mmap) then
      match mmap.get(method)
      when Option::Some(cands) then
        var ci2 = 0
        while ci2 < cands.len() do
          let imp = env.impls[cands[ci2]]
          if imp.trait_name != "" && imp.trait_name != "_" then
            if impl_for_type_matches(&imp.for_type, &resolved_base) then
              var mi3 = 0
              while mi3 < imp.methods.len() do
                let m = imp.methods[mi3]
                if m.name == method then
 # FIX 1: explicit generic instantiation (see
                  # section 1) — same inference-variable discipline for
                  # trait-impl methods.
                  if imp.generic_params.len() > 0 || m.generic_params.len() > 0 then
                    return instantiate_method_type(env, &imp, &m, &resolved_base, arg_types, method_type_args, call_node_id, span)
                  else
                    return m.ret_type
                  end
                end
                mi3 = mi3 + 1
              end
            end
          end
          ci2 = ci2 + 1
        end
      when Option::None then ()
      end
    when Option::None then ()
    end
  when _ then ()
  end

 # 4. EXTENSION-impl methods — an impl whose for_type is a generic
  # PARAMETER (`impl[T, I: Iterator[T]] I`) is not indexed into
  # method_lookup (it has no receiver TypeId), so the direct lookup above
  # cannot find it. Search those impls by method name; the receiver's
  # concrete type unifies the head parameter (I), the impl's other
  # parameters (T) are solved from the method signature, the method is
  # instantiated, and the solved instance is recorded
  # (typed_call_instances / pending_call_instances).
  match find_param_for_type_method(env, method)
  when Option::Some((pimp_idx, pmid_idx)) then
    let pimp = env.impls[pimp_idx]
    match instantiate_param_for_type_method(env, &pimp, &pimp.methods[pmid_idx], &resolved_base, arg_types, method_type_args, call_node_id, span)
    when Option::Some(ret_ty) then return ret_ty
    when Option::None then ()
    end
  when Option::None then ()
  end

 # 5. TRAIT-BOUND method resolution on bare Param receivers. Inside a
  # generic body a method call on a receiver of type Type::Param(name) (e.g.
  # `self.inner.advance()` with inner: I inside `impl[T, U, I: Iterator[T]]
  # Iterator[U] for MapIter[T, U, I]`) resolves through the parameter's
  # where-clause bound (recorded in env.param_bounds when the generic
  # parameters entered scope): the bound trait's impls are the candidates,
  # the impl head unifies with the Param by the PARAM BINDING (the Param is
  # an opaque instance of the bound trait, so Param-vs-Named head
  # unification is a match), the method is instantiated with fresh inference
  # variables, the head's argument variables are bound to the bound trait's
  # type arguments positionally, and the solved instance is recorded exactly
  # like the impl-registry path (typed_call_instances / pending_call_instances).
  match resolved_base
  when Type::Param(gpid) then
 # the receiver's bounds are keyed by the parameter's numeric
    # GenericParamId — identity, never the name.
    match env.param_bounds.get(generic_param_id_numeric(&gpid))
    when Option::Some(pbounds) then
      var pbi = 0
      while pbi < pbounds.len() do
        let pbound = pbounds[pbi]
        var pii = 0
        while pii < env.impls.len() do
          let pimp = env.impls[pii]
 # the bound trait identity is the TraitId (the names are
          # retained only for diagnostics).
          if pimp.trait_id.id == pbound.trait_id.id then
            var pmi = 0
            while pmi < pimp.methods.len() do
              let pm = pimp.methods[pmi]
              if pm.name == method then
                match instantiate_param_bound_method(env, &pimp, &pm, &resolved_base, &pbound.args, arg_types, method_type_args, call_node_id, span)
                when Option::Some(ret_ty) then return ret_ty
                when Option::None then ()
                end
              end
              pmi = pmi + 1
            end
          end
          pii = pii + 1
        end
        pbi = pbi + 1
      end
    when Option::None then ()
    end
  when _ then ()
  end

  # Method on user-defined type or trait — permissively infer.
  # In strict resolution mode an unresolved method is a hard error. When a
  # candidate was found in an inherent impl but its bounds failed (the
  # section-1 gate), the SPECIFIC diagnostic is reported — "method
  # `peek_front` requires `T: Copy`" — instead of the generic
  # no-method error: the method EXISTS but is not applicable to this
  # receiver because the impl's bounds are unsatisfied.
  if env.strict_resolution then
    match blocked
    when Option::Some(blocked_msg) then type_add_error(env, blocked_msg, span)
    when Option::None then type_add_error(env, "no method `" + method + "` on receiver type", span)
    end
    Type::Error
  else
    fresh_type_var(env)
  end
end

# Strip a trailing borrow layer so a `&str`/`&T` operand participates as its
# pointee in binary operations (string concatenation, arithmetic on references).
def deref_borrow_type(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then deref_borrow_type(inner)
  when _ then ty
  end  end
end

def check_binary_op(inout env: TypeEnv, op: BinOp, left: Expr, right: Expr, span: Span) -> Type
  let left_type = deref_borrow_type(check_expr(env, left))
  let right_type = deref_borrow_type(check_expr(env, right))

  # Propagate errors without crashing
  match left_type
  when Type::Error then return Type::Error
  when _ then ()
  end
  match right_type
  when Type::Error then return Type::Error
  when _ then ()
  end
  
  match op
  when BinOp::Add then
    # String concatenation coerces any operand to String: "x" + 42 is valid.
    if is_string_type(&left_type) || is_string_type(&right_type) then
      Type::String
    else
      unify(env, left_type, right_type, span)
      left_type
    end
  when BinOp::Sub then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Mul then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Div then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Mod then
    unify(env, left_type, Type::Int, span)
    unify(env, right_type, Type::Int, span)
    Type::Int
  when BinOp::Pow then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Eq then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Ne then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Lt then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Le then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Gt then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Ge then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::And then
    unify(env, left_type, Type::Bool, span)
    unify(env, right_type, Type::Bool, span)
    Type::Bool
  when BinOp::Or then
    unify(env, left_type, Type::Bool, span)
    unify(env, right_type, Type::Bool, span)
    Type::Bool
  when _ then left_type
  end
end

def check_unary_op(inout env: TypeEnv, op: UnOp, inner: Expr, span: Span) -> Type
  let inner_type = check_expr(env, inner)

  match inner_type
  when Type::Error then return Type::Error
  when _ then ()
  end
  
  match op
  when UnOp::Neg then
   # (literal range authority): each enclosing unary minus folds into the
    # bottommost literal's pending negation count, so the end-of-check
    # pass decides the EXACT signed range — -128i8 is valid, -129i8 is
    # the overflow, --128i8 is the overflow (even count restores the
    # positive value). The literal form is preserved (the negated value
    # is carried); negating any other value keeps its type.
    match literal_bottom_of_neg_chain(&inner)
    when Option::Some(bottom_id) then
      match env.pending_literal_ranges.get(bottom_id)
      when Option::Some(rec) then
        env.pending_literal_ranges.insert(bottom_id, PendingLiteralRange { lit: rec.lit, target_ty: rec.target_ty, span: rec.span, neg_count: rec.neg_count + 1 })
      when Option::None then ()
      end
    when Option::None then ()
    end
    match inner_type
    when Type::IntLiteral(v) then Type::IntLiteral(0 - v)
    when _ then inner_type
    end
  when UnOp::Not then
    unify(env, inner_type, Type::Bool, span)
    Type::Bool
  when UnOp::BitNot then
    unify(env, inner_type, Type::Int, span)
    Type::Int
  end
end

# ———————————————————————————————————————————————————————————————
# Type Expression Resolution
# ———————————————————————————————————————————————————————————————

# (FixedArray const sizes): evaluate a CONSTANT INTEGER size expression —
# the [T; N] annotation's size forms: integer literals, const references
# (ExprIdent / ExprPath — resolved through the collected const-value table
# env.const_values under the CURRENT module's qualified key, so a const of
# the current module resolves by its bare name) and the integer arithmetic
# operators (Add/Sub/Mul/Div/Mod and unary Neg) over constant operands.
# This is the compiler's constant-size evaluator entry: the [T; N]
# annotation evaluates the size expression HERE, BEFORE forming
# FixedArray(Type, N) identity, so `[T; CONST]` (the const reference
# resolving to its value) and `[T; CONST * 2]` (the arithmetic evaluating)
# produce the same FixedArray identity as the literal spelling. A
# non-constant form fails CLOSED (Option::None) — the [T; N] site reports
# "fixed array size must be a constant" and the const collector records
# nothing for the declaration.
# The maximum fixed-array element count the compiler accepts: 2^26
# elements (67,108,864) — the user-input bound that keeps the layout
# engine's count * stride arithmetic far below the Int overflow domain
# (2^26 * 16 bytes = 2^30 < 2^63) and bounds inline storage to a
# non-absurd size. The bound is enforced at the [T; N] type-annotation
# site (resolve_type_expr's FixedArray arm) with a stable diagnostic.
def MAX_FIXED_ARRAY_ELEMS() -> Int = 67108864

def eval_const_size_expr(env: TypeEnv, expr: Expr) -> Option[Int]
  match expr.kind
  when ExprKind::ExprIntLit(n) then Option::Some(parsed_int_to_host(&n))
  when ExprKind::ExprIdent(name) then
    match env.const_values.get(module_qualified_key(&env.current_module_path, &name))
    when Option::Some(n) then Option::Some(n)
    when Option::None then Option::None
    end
  when ExprKind::ExprPath(path) then
    # A bare single-segment path resolves like the ident form (the current
    # module's key); a QUALIFIED path ("foo::N") resolves under the
    # path's OWN module-qualified key — the const collector keys every
    # declaration by module_qualified_key(owner_path, name), so the joined
    # segments ARE the key. The former last-segment-only lookup mis-keyed
    # a foreign-module const under the CURRENT module and could never
    # resolve it.
    if path.segments.len() > 1 then
      match env.const_values.get(path.segments.join("::"))
      when Option::Some(n) then Option::Some(n)
      when Option::None then Option::None
      end
    else
      let name = if path.segments.len() > 0 then path.segments[0] else "" end
      match env.const_values.get(module_qualified_key(&env.current_module_path, &name))
      when Option::Some(n) then Option::Some(n)
      when Option::None then Option::None
      end
    end
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    match eval_const_size_expr(env, &lhs)
    when Option::Some(a) then
      match eval_const_size_expr(env, &rhs)
      when Option::Some(b) then
        match op
        when BinOp::Add then
          # (item-12 audit): the const-size arithmetic is FAIL-CLOSED — an
          # overflowing addition/multiplication returns None (the caller
          # reports the size as not a constant) instead of wrapping into a
          # wrong FixedArray count that would silently reach the layout
          # engine.
          if a >= 0 && b >= 0 && a <= 9223372036854775807 - b then Option::Some(a + b) else Option::None end
        when BinOp::Sub then
          if a >= b then Option::Some(a - b) else Option::None end
        when BinOp::Mul then
          if a >= 0 && b >= 0 && (a == 0 || b <= 9223372036854775807 / a) then Option::Some(a * b) else Option::None end
        when BinOp::Div then if b != 0 then Option::Some(a / b) else Option::None end
        when BinOp::Mod then if b != 0 then Option::Some(a % b) else Option::None end
        when _ then Option::None
        end
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  when ExprKind::ExprUnaryOp(UnOp::Neg, operand) then
    match eval_const_size_expr(env, &operand)
    when Option::Some(n) then Option::Some(-n)
    when Option::None then Option::None
    end
  when _ then Option::None
  end  end
end

# Extract path segments from a TypeExpr in a separate function frame.
# Going through a helper appears to give stage0 cleaner codegen for single-
# struct enum payloads (Path(AstPath)) than a direct destructure in-place.
def extract_type_path_segments(te: TypeExpr) -> Vec[String]
  var out = Vec::new()
  match te.kind
  when TypeExprKind::Path(p) then
    var i = 0
    while i < p.segments.len() do
      out.push(p.segments[i].clone())
      i = i + 1
    end
  when _ then ()
  end
  out
end

def resolve_type_expr(inout env: TypeEnv, te: TypeExpr) -> Type
  match te.kind
  when TypeExprKind::Named(name, args) then
    # Use if-chains for string matching (match name.as_str() generates broken C)
    # Preserve sized integer types for FFI parity - critical for correct ABI
    if name == "Unit" then Type::Unit
    elsif name == "Nil" then Type::Unit
    elsif name == "Bool" then Type::Bool
    elsif name == "Int" then Type::Int
    elsif name == "i8" then Type::I8
    elsif name == "i16" then Type::I16
    elsif name == "i32" then Type::I32
    elsif name == "i64" then Type::I64
    elsif name == "i128" then Type::I128
    elsif name == "UInt" then Type::UInt
    elsif name == "u8" then Type::U8
    elsif name == "u16" then Type::U16
    elsif name == "u32" then Type::U32
    elsif name == "u64" then Type::U64
    elsif name == "u128" then Type::U128
    elsif name == "isize" then Type::ISize
    elsif name == "usize" then Type::USize
    elsif name == "Float" then Type::Float
    elsif name == "f32" then Type::F32
    elsif name == "f64" then Type::F64
    elsif name == "Char" then Type::Char
    elsif name == "String" then Type::String
    elsif name == "str" then Type::String
    elsif name == "Never" then Type::Never
    elsif name == "Self" then
      # Self refers to the current impl type; treat as a type variable
      fresh_type_var(env)
    elsif name == "Fn" then
      # Fn types like Fn(Args) -> Ret
      var param_types = Vec::new()
      var i = 0
      while i < args.len() do
        param_types.push(ParamType { ty: resolve_type_expr(env, &args[i]), convention: AccessConvention::Let })
        i = i + 1
      end
      Type::FnPtr(param_types, Type::Unit, Vec::new())
    elsif name == "Array" then
      # Handle Array[T] named syntax — the heap vector. The result is the
      # Adt form of the registered Array builtin (LangItems id); the fixed
      # arrays are the distinct Type::FixedArray variant built from the
      # [T; N] annotation (TypeExprKind::Array), never this named form.
      if args.len() >= 1 then
        let elem_type = resolve_type_expr(env, &args[0])
        builtin_adt(env, "Array".to_string(), [elem_type])
      else
        builtin_adt(env, "Array".to_string(), [fresh_type_var(env)])
      end
    elsif name == "Slice" then
      # The SOURCE-spelled Slice[T] — the SAFE SHARED/PINNED form: the
      # name resolves to the std-declared shared struct (Slice[T] { inner:
      # Arc[SliceBacking[T]] }) through builtin_adt. The RAW 16-byte
      # {ptr,len} view is the separate explicit UnsafeSlice builtin — this
      # named form never produces it.
      if args.len() >= 1 then
        builtin_adt(env, "Slice".to_string(), [resolve_type_expr(env, &args[0])])
      else
        builtin_adt(env, "Slice".to_string(), [fresh_type_var(env)])
      end
    elsif name == "UnsafeSlice" then
      # The RAW {ptr,len} view — the explicit unsafe/FFI spelling (the
      # builtin Opaque; LangItems slice id).
      if args.len() >= 1 then
        builtin_adt(env, "UnsafeSlice".to_string(), [resolve_type_expr(env, &args[0])])
      else
        builtin_adt(env, "UnsafeSlice".to_string(), [fresh_type_var(env)])
      end
    elsif name == "Any" then
      # Any is a top type — use a fresh type variable that unifies with everything
      fresh_type_var(env)
    # Type aliases: capitalized forms used by stdlib (Int8 → I8, UInt8 → U8, etc.)
    elsif name == "Int8" then Type::I8
    elsif name == "Int16" then Type::I16
    elsif name == "Int32" then Type::I32
    elsif name == "Int64" then Type::I64
    elsif name == "Int128" then Type::I128
    elsif name == "UInt8" then Type::U8
    elsif name == "UInt16" then Type::U16
    elsif name == "UInt32" then Type::U32
    elsif name == "UInt64" then Type::U64
    elsif name == "UInt128" then Type::U128
    elsif name == "ISize" then Type::ISize
    elsif name == "USize" then Type::USize
    elsif name == "F32" then Type::F32
    elsif name == "F64" then Type::F64
    elsif name == "Bool" then Type::Bool
    elsif name == "c_int" then Type::Int
    elsif name == "c_uint" then Type::UInt
    elsif name == "c_char" then Type::U8
    elsif name == "c_long" then Type::I64
    elsif name == "c_ulong" then Type::U64
    elsif name == "c_void" then Type::Unit
    elsif name == "c_double" then Type::F64
    elsif name == "c_float" then Type::F32
    else
      # Check if this name is a generic parameter in scope (e.g., T, E, K, V)
      match lookup_var(env, name.clone())
      when Option::Some(ty) then ty
      when Option::None then
 # (next layer): bare-name resolution — local-module shadowing
        # and cross-module ambiguity verification live here (see
        # resolve_bare_type_name); the first-wins entry is the fallback.
        match resolve_bare_type_name(env, name.clone(), te.span)
        when Option::Some(idx) then
          let type_def = env.type_list[idx]
          var resolved_args = Vec::new()
          var i = 0
          while i < args.len() do
            resolved_args.push(resolve_type_expr(env, &args[i]))
            i = i + 1
          end
          # Every builtin compound name resolves to its Adt form with the
          # LangItems id (builtin_adt); user types get Type::Adt(<their
          # TypeId>, args).
          if type_def.name == "Option" then
            if resolved_args.len() >= 1 then builtin_adt(env, "Option".to_string(), resolved_args)
            else builtin_adt(env, "Option".to_string(), [fresh_type_var(env)])
            end
          elsif type_def.name == "Result" then
            if resolved_args.len() >= 2 then builtin_adt(env, "Result".to_string(), resolved_args)
            else builtin_adt(env, "Result".to_string(), [fresh_type_var(env), fresh_type_var(env)])
            end
          elsif type_def.name == "Map" then
            if resolved_args.len() >= 2 then builtin_adt(env, "Map".to_string(), resolved_args)
            else builtin_adt(env, "Map".to_string(), [fresh_type_var(env), fresh_type_var(env)])
            end
          elsif type_def.name == "Set" then
            if resolved_args.len() >= 1 then builtin_adt(env, "Set".to_string(), resolved_args)
            else builtin_adt(env, "Set".to_string(), [fresh_type_var(env)])
            end
          else
            Type::Adt(type_def.id, resolved_args)
          end
        when Option::None then
          # Auto-register unknown types as opaque to prevent cascading errors.
          # This ensures all references to the same unknown type name resolve
          # to the same TypeId, preventing spurious "type mismatch" errors.
          # In strict resolution mode an unknown type is a hard error.
          if env.strict_resolution then
            type_add_error(env, "unknown type `" + name + "`", te.span)
            return Type::Error
          end
          let id_num = env.type_id_counter
          let opaque_id = TypeId { id: id_num }
          env.type_id_counter = env.type_id_counter + 1
          let opaque_td = TypeDef {
            id: opaque_id,
            name: name.clone(),
            def_kind: TypeDefKind::Opaque,
            generic_params: Vec::new(),
            kind: TypeKind::Value
            def: Option::None
          }
          env.type_name_index.insert(name.clone(), env.type_list.len())
          env.type_id_index.insert(id_num, env.type_list.len())
          env.type_list.push(opaque_td)
          var resolved_args = Vec::new()
          var i = 0
          while i < args.len() do
            resolved_args.push(resolve_type_expr(env, &args[i]))
            i = i + 1
          end
          Type::Adt(opaque_id, resolved_args)
        end
      end
    end
  when TypeExprKind::Unit then Type::Unit
  when TypeExprKind::Never then Type::Never
  when TypeExprKind::Tuple(elems) then
    var types = Vec::new()
    var i = 0
    while i < elems.len() do
      types.push(resolve_type_expr(env, &elems[i]))
      i = i + 1
    end
    Type::Tuple(types)
  when TypeExprKind::Array(elem, size_opt) then
    # The [T; N] annotation constructs the DISTINCT fixed-array variant
    # Type::FixedArray(elem, n) — the element type plus the constant count
    # (0 is a legal zero-length fixed array). The count is carried in the
    # TYPE; the named Array[T] syntax (the heap vector) is the Adt form.
 # (const sizes): the size expression is evaluated through the
    # compiler's constant-size evaluator (eval_const_size_expr — the
    # [T; CONST] form: the const reference resolves to its value from the
    # collected const-value table; the arithmetic const expressions
    # evaluate) BEFORE FixedArray(Type, N) identity forms, so the const
    # spelling and the literal spelling produce the SAME type identity. A
    # non-constant size is a TypeError (the fixed array size is part of the
    # type identity).
    let elem_type = resolve_type_expr(env, &elem)
    let size_n = match size_opt
    when Option::Some(size_expr) then
      match eval_const_size_expr(env, &size_expr)
      when Option::Some(n) then n
      when Option::None then
        type_add_error(env, "fixed array size must be a constant (an integer literal, a const reference, or constant arithmetic)", size_expr.span)
        0
      end
    when Option::None then
      type_add_error(env, "fixed array size must be a constant", te.span)
      0
    end
    # (item-12 audit): the fixed-array count is the ONE user-controlled
    # magnitude that flows into the layout engine's size arithmetic. It is
    # BOUNDED here with a stable diagnostic — a negative or out-of-range
    # count is a user mistake, never a layout-engine overflow (the engine's
    # own checked arithmetic remains as the internal fail-closed backstop).
    if size_n < 0 then
      type_add_error(env, "fixed array size must not be negative (got " + size_n.to_string() + ")", te.span)
    elsif size_n > MAX_FIXED_ARRAY_ELEMS() then
      type_add_error(env, "fixed array size " + size_n.to_string() + " exceeds the maximum supported length " + MAX_FIXED_ARRAY_ELEMS().to_string(), te.span)
    end
    Type::FixedArray(elem_type, size_n)
  when TypeExprKind::Slice(elem) then
    # The [T] type spelling IS the source-spelled Slice — the SAFE
    # SHARED/PINNED form: the name "Slice" resolves to the std-declared
    # shared struct (Slice[T] { inner: Arc[SliceBacking[T]] }). The RAW
    # 16-byte {ptr,len} view is the separate explicit UnsafeSlice builtin —
    # the [T] sugar never produces it.
    let elem_type = resolve_type_expr(env, &elem)
    builtin_adt(env, "Slice".to_string(), [elem_type])
  when TypeExprKind::Fn(params, ret) then
    var param_types = Vec::new()
    var i = 0
    while i < params.len() do
      param_types.push(ParamType { ty: resolve_type_expr(env, &params[i].ty), convention: params[i].convention })
      i = i + 1
    end
    let ret_type = resolve_type_expr(env, &ret)
 # (FnPtr/Closure split): the fn(Args) -> Ret TYPE EXPRESSION denotes
    # a function POINTER (no environment) — the FnPtr form.
    Type::FnPtr(param_types, ret_type, Vec::new())
  when TypeExprKind::Infer then
    fresh_type_var(env)
  when TypeExprKind::Ref(inner, mutable) then
    # The extern-boundary internal-ABI reference form: resolves to the
    # RefInternal address/reference type (never a first-class source type).
    Type::RefInternal(resolve_type_expr(env, &inner), mutable)
  when TypeExprKind::Ptr(inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::Ptr(inner_type)
  when TypeExprKind::PtrMut(inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::PtrMut(inner_type)
  when TypeExprKind::Async(inner) then
    # Async types resolve to their inner type for now
    resolve_type_expr(env, &inner)
  when TypeExprKind::Effect(name, inner) then
    let inner_type = resolve_type_expr(env, &inner)
 # (EffectId domain, canonical payload): the effect name is INTERNED
    # at use — a builtin name resolves to its fixed id, a user effect
    # interns under the CURRENT module's qualified key ("path::name") — so
    # the Type::Effect payload IS the canonical ordered Vec[EffectId] (the
    # String-set form is are not part of the model): identity is the id, and the canonical type
    # identity renders the canonical ordered effect-ID set. The registry's
    # id -> name table renders the names for diagnostics and the ABI.
    let eid = intern_module_effect(&mut env.effects, &env.current_module_path, &name)
    Type::Effect(Vec::from([eid]), inner_type)
  when TypeExprKind::Path(path) then
    # Qualified path like module::Type — resolve the last segment.
    # Extract segments via a helper to dodge a stage0 codegen quirk where
    # the AstPath payload of `TypeExprKind::Path` read in-place yields
    # corrupt `String` headers inside `segments`.
    let segs = extract_type_path_segments(te)
    if segs.len() > 0 then
      # Manual concat to bypass any potential stage0 codegen issue in Array[String].join
      var full_name = String::new()
      var jk = 0
      while jk < segs.len() do
        if jk > 0 then full_name = full_name + "::" end
        full_name = full_name + segs[jk].clone()
        jk = jk + 1
      end
 # (next layer): a path-qualified type reference resolves through
      # the module-qualified type-name map first (module_type_names — the
      # qualified identity recorded at type-registration time), then the
      # existing flat full-name fallback (auto-registered opaque full
      # names), then the bare-name fallback with ambiguity verification.
      match env.module_type_names.get(full_name.clone())
      when Option::Some(idx) then
        let type_def = env.type_list[idx]
        # Use canonical Type representation so unification works correctly
        type_def_to_canonical(env, &type_def)
      when Option::None then
        match get_type_by_name_ref(env, full_name.clone())
        when Option::Some(type_def) then
          # Use canonical Type representation so unification works correctly
          type_def_to_canonical(env, type_def)
        when Option::None then
          # Try the last segment alone
          let last = segs[segs.len() - 1].clone()
          match resolve_bare_type_name(env, last, te.span)
          when Option::Some(idx) then
            let type_def = env.type_list[idx]
            # Use canonical Type representation so unification works correctly
            type_def_to_canonical(env, &type_def)
          when Option::None then
            # Auto-register unknown qualified type paths as opaque to prevent
            # cascading errors. This mirrors the opaque fallback in the Named
            # handler above and ensures all references to the same unknown
            # qualified type resolve to the same TypeId.
            let id_num = env.type_id_counter
            let opaque_id = TypeId { id: id_num }
            env.type_id_counter = env.type_id_counter + 1
            let opaque_td = TypeDef {
              id: opaque_id,
              name: full_name.clone(),
              def_kind: TypeDefKind::Opaque,
              generic_params: Vec::new(),
              kind: TypeKind::Value,
              def: Option::None
            }
            env.type_name_index.insert(full_name.clone(), env.type_list.len())
            env.type_id_index.insert(id_num, env.type_list.len())
            env.type_list.push(opaque_td)
            Type::Adt(opaque_id, Vec::new())
          end
        end
      end
    else
      Type::Error
    end
  when _ then Type::Error
  end  end
end

# ———————————————————————————————————————————————————————————————
# Import Resolution — loads and parses referenced stdlib files
# ———————————————————————————————————————————————————————————————

# Map a use-declaration path to a filesystem path.
# e.g. ["std", "app"] -> "std/app.tg"
# e.g. ["std", "gfx_errors"] -> "std/gfx_errors.tg"
# e.g. ["tg_compiler", "ast"] -> "tg_compiler/ast.tg"
# Returns Option::None for paths that don't map to loadable files (e.g. builtins).
def use_path_to_file(segments: Vec[String]) -> Option[String]
  if segments.len() < 2 then
    return Option::None
  end
  let root = segments[0]
  if root == "std" then
    # std::X -> std/X.tg   (handles std::core, std::app, std::gfx, etc.)
    var path = "std/"
    var i = 1
    while i < segments.len() do
      if i > 1 then
        path = path + "/"
      end
      path = path + segments[i]
      i = i + 1
    end
    path = path + ".tg"
    Option::Some(path)
  elsif root == "tg_compiler" then
    # tg_compiler::X -> tg_compiler/X.tg
    var path = "tg_compiler/"
    var i = 1
    while i < segments.len() do
      if i > 1 then
        path = path + "/"
      end
      path = path + segments[i]
      i = i + 1
    end
    path = path + ".tg"
    Option::Some(path)
  else
    Option::None
  end
end

# Extract use declarations from a program's items and return the referenced file paths.
def extract_import_paths(program: Program) -> Vec[String]
  var paths = Vec::new()
  var i = 0
  while i < program.items.len() do
    let item = program.items[i]
    match item.kind
    when ItemKind::ItemUse(u) then
      match use_path_to_file(&u.path.segments)
      when Option::Some(p) then paths.push(p)
      when Option::None then ()
      end
    when _ then ()
    end
    i = i + 1
  end
  paths
end

# Recursively resolve imports: read, tokenize, parse each referenced file,
# collect type definitions from it, and recurse into its own use declarations.
# The `loaded` set prevents loading the same file twice (cycle protection).
def resolve_imports(inout env: TypeEnv, program: Program, inout loaded: Set[String]) -> Unit
  let paths = extract_import_paths(program)
  for path in paths do
    let import_path = path.clone()
    if loaded.contains(&import_path) then
      ()
    else
      loaded.insert(path.clone())
      match std::fs::read_file(path.clone())
      when Result::Ok(source) then
        let tokens = tokenize(source, import_path.clone())
        let dep_parse = parse(tokens)
        let dep_ast = dep_parse.program
        # Recurse: resolve this file's own imports first
        resolve_imports(env, &dep_ast, loaded)
        # Pass 1: Pre-register all type names (enables forward references)
        # Use indexed borrow (&items[i]) to avoid stage0 codegen bug that
        # corrupts enum payloads when an Item is copied out of a Vec.
 # (next layer): this permissive path runs without
        # resolutions (module_type_names stays empty), so the root module
        # path is passed — qualified registration is a no-op here.
        var i = 0
        let root_path: Vec[String] = Vec::new()
        while i < dep_ast.items.len() do
          pre_register_type_name(env, &dep_ast.items[i], &root_path)
          i = i + 1
        end
        # Pass 2: Collect full type definitions (field types, variant types, etc.)
        i = 0
        while i < dep_ast.items.len() do
          collect_type_def(env, &dep_ast.items[i], &root_path)
          i = i + 1
        end
      when Result::Err(_) then
        # File not found or unreadable — skip silently.
        ()
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# (integer-literal elimination): the end-of-check resolution of the
# inference-only IntLiteral type
# ———————————————————————————————————————————————————————————————
#
# An integer literal is typed IntLiteral during checking and COERCED by
# unification against any concrete integer type it meets. A literal the
# context never constrained stays IntLiteral in the recorded maps; THIS
# pass — the elimination half of the coercion contract — chases every
# recorded type through the final substitution (resolve_type_var) and
# defaults each remaining IntLiteral to Type::Int (the default integer
# type), recursively through compound types. After the pass, NO recorded
# type contains IntLiteral — the resolved type never remains the
# inference-only form in a codegenable TypedProgram (verify_codegen_readiness
# then confirms the maps carry no unresolved inference state).

# Rewrite ONE type: chase vars, then default every remaining IntLiteral to
# Int (recursively through the compound forms).
def default_int_literal_type(env: TypeEnv, ty: Type) -> Type
  let chased = resolve_type_var(env, ty.clone())
  match chased
  when Type::IntLiteral(_) then Type::Int
  when Type::Adt(tid, args) then
    var new_args = Vec::new()
    for arg in args do
      new_args.push(default_int_literal_type(env, &arg))
    end
    Type::Adt(tid, new_args)
  when Type::FixedArray(elem, n) then Type::FixedArray(default_int_literal_type(env, &elem), n)
  when Type::Tuple(elems) then
    var new_elems = Vec::new()
    for e in elems do
      new_elems.push(default_int_literal_type(env, &e))
    end
    Type::Tuple(new_elems)
  when Type::RefInternal(inner, mutable) then Type::RefInternal(default_int_literal_type(env, &inner), mutable)
  when Type::Ptr(inner) then Type::Ptr(default_int_literal_type(env, &inner))
  when Type::PtrMut(inner) then Type::PtrMut(default_int_literal_type(env, &inner))
  when Type::Effect(effects, inner) then Type::Effect(effects.clone(), default_int_literal_type(env, &inner))
  when Type::FnPtr(params, ret, effects) then
    var new_params = Vec::new()
    for p in params do
      new_params.push(ParamType { ty: default_int_literal_type(env, &p.ty), convention: p.convention })
    end
    Type::FnPtr(new_params, default_int_literal_type(env, &ret), effects.clone())
  when Type::Closure(cid, params, ret, captures, effects) then
    var new_params = Vec::new()
    for p in params do
      new_params.push(ParamType { ty: default_int_literal_type(env, &p.ty), convention: p.convention })
    end
    Type::Closure(cid.clone(), new_params, default_int_literal_type(env, &ret), default_int_literal_type(env, &captures), effects.clone())
  when _ then chased
  end
end

# The elimination walk over every recorded type channel that reaches a
# codegenable TypedProgram: the per-expression type map, the typed-HIR
# records, the local bindings, the declaration signatures, the static/
# const declared types, and the solved generic-call substitutions. Each
# entry is chased and rewritten; a new map is built per channel (the
# iteration never mutates the map under iteration).
def resolve_pending_int_literals(inout env: TypeEnv) -> Unit
  var new_expr_types = Map::new()
  for (node_id, ty) in env.typed_expr_types do
    new_expr_types.insert(node_id, default_int_literal_type(env, &ty))
  end
  env.typed_expr_types = new_expr_types
  var new_exprs = Map::new()
  for (node_id, te) in env.typed_exprs do
    new_exprs.insert(node_id, TypedExpr { id: te.id, ty: default_int_literal_type(env, &te.ty), kind: te.kind })
  end
  env.typed_exprs = new_exprs
  var new_bindings = Map::new()
  for (lid, lb) in env.typed_local_bindings do
    new_bindings.insert(lid, LocalBinding { name: lb.name.clone(), ty: default_int_literal_type(env, &lb.ty) })
  end
  env.typed_local_bindings = new_bindings
  var new_sigs = Map::new()
  for (key, sig) in env.typed_fn_signatures do
    var new_params = Vec::new()
    for p in sig.params do
      new_params.push(ParamType { ty: default_int_literal_type(env, &p.ty), convention: p.convention })
    end
    new_sigs.insert(key, FnSignature { params: new_params, ret_type: default_int_literal_type(env, &sig.ret_type), declared_effects: sig.declared_effects.clone(), declared_budget: sig.declared_budget.clone() })
  end
  env.typed_fn_signatures = new_sigs
  var new_statics = Map::new()
  for (key, ty) in env.typed_static_types do
    new_statics.insert(key, default_int_literal_type(env, &ty))
  end
  env.typed_static_types = new_statics
  var new_instances = Map::new()
  for (node_id, args) in env.typed_call_instances do
    var new_args = Vec::new()
    for a in args do
      new_args.push(default_int_literal_type(env, &a))
    end
    new_instances.insert(node_id, new_args)
  end
  env.typed_call_instances = new_instances
end

# ———————————————————————————————————————————————————————————————
# (recovery separation): post-check verification
# ———————————————————————————————————————————————————————————————
#
# The semantic pass must guarantee that a codegenable TypedProgram carries no
# unresolved semantic state. This walk runs after the type check succeeds and
# rejects:
# - Type::Error anywhere in expr_types (MIR's own verifier does NOT
#     check Type::Error, so the semantic pass is the enforcement point), and
#   - Type::Var that the final substitution cannot resolve (a var with no
#     substitution entry would reach MIR/codegen unresolved). Vars that the
#     substitution DOES solve are genuinely pending inference that became
#     concrete — acceptable.
# Type::Param is ALLOWED: it is the bound generic parameter of a generic
# template, the template's normal state which MIR lowers as a generic
# function and codegen resolves at monomorphization. The MIR verifier
# already rejects Param leaking into non-generic functions.
# THE codegen-readiness scan (the reviewer's item-8 oracle, channel
# half): a recursive scan of a type for Type::Error (always illegal in
# an accepted program), unresolved Type::Var (a lost substitution) and
# Type::Param in the channels where a CONCRETE type is required. The
# scan never mutates the env; the caller reports the findings.
def scan_codegen_type(inout env: TypeEnv, ty: Type, inout has_error: Bool, inout has_var: Bool, inout has_param: Bool, allow_param: Bool) -> Unit
  match ty
  when Type::Error then has_error = true
  when Type::Var(_) then has_var = true
  when Type::Param(_) then if !allow_param then has_param = true end
  when Type::Adt(tid, args) then
    var ai = 0
    while ai < args.len() do
      scan_codegen_type(env, args[ai], has_error, has_var, has_param, allow_param)
      ai = ai + 1
    end
  when Type::Tuple(fields) then
    var fi = 0
    while fi < fields.len() do
      scan_codegen_type(env, fields[fi], has_error, has_var, has_param, allow_param)
      fi = fi + 1
    end
  when Type::FixedArray(elem, _) then
    scan_codegen_type(env, elem, has_error, has_var, has_param, allow_param)
  when Type::FnPtr(params, ret, _) then
    var pi = 0
    while pi < params.len() do
      scan_codegen_type(env, params[pi].ty, has_error, has_var, has_param, allow_param)
      pi = pi + 1
    end
    scan_codegen_type(env, ret, has_error, has_var, has_param, allow_param)
  when _ then ()
  end
end

def verify_codegen_readiness(inout env: TypeEnv) -> Unit
  # The FULL type-channel coverage (the reviewer's item-8 oracle, channel
  # half): every recorded channel that reaches a codegenable TypedProgram
  # is scanned for Type::Error and unresolved Type::Var (ALWAYS illegal in
  # an accepted program — their presence means an error was not recorded or
  # a substitution was lost) and for Type::Param in the channels where a
  # CONCRETE type is required (the solved generic-call substitutions the
  # monomorphizer consumes with zero inference, and the static/const
  # declared types — a static is never a generic template).
  #
  # Coverage table (channel -> allow_param):
  #   typed_expr_types            -> true  (generic fn templates carry Param)
  #   typed_exprs (node ty)       -> true  (same body-expr domain)
  #   typed_local_bindings        -> true  (locals of generic templates)
  #   typed_fn_signatures         -> true  (generic declaration signatures)
  #   typed_static_types          -> FALSE (statics are never generic)
  #   typed_call_instances        -> FALSE (solved substitutions are concrete
  #                                          by the ZERO-INFERENCE contract)
  #   type_aliases (inner)        -> true  (generic aliases are legal)
  #   type_fields (struct fields) -> true  (generic struct fields carry Param)
  #   type_variants (enum fields) -> true  (generic enum payloads)
  #   deinit_plans (subst types)  -> true  (plans carry concrete identity;
  #                                          Error/Var is the flag that matters)
  var chan_i = 0
  var entries = env.typed_expr_types.entries()
  while chan_i < entries.len() do
    let node_id = entries[chan_i].0
    let ty = entries[chan_i].1
    var has_error = false
    var has_var = false
    var has_param = false
    scan_codegen_type(env, &ty, &mut has_error, &mut has_var, &mut has_param, true)
    if has_error then
      type_add_error(env, "unresolved Type::Error in the type of expression node " + node_id.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
    if has_var then
      type_add_error(env, "unresolved inference variable (Type::Var) in the type of expression node " + node_id.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
    chan_i = chan_i + 1
  end
  for (te_id, te) in env.typed_exprs do
    var he = false
    var hv = false
    var hp = false
    scan_codegen_type(env, &te.ty, &mut he, &mut hv, &mut hp, true)
    if he then
      type_add_error(env, "unresolved Type::Error in the typed-HIR record of expression node " + te_id.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
    if hv then
      type_add_error(env, "unresolved inference variable (Type::Var) in the typed-HIR record of expression node " + te_id.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
  end
  for (lid, lb) in env.typed_local_bindings do
    var he = false
    var hv = false
    var hp = false
    scan_codegen_type(env, &lb.ty, &mut he, &mut hv, &mut hp, true)
    if he then
      type_add_error(env, "unresolved Type::Error in the type of local binding " + lid.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
    if hv then
      type_add_error(env, "unresolved inference variable (Type::Var) in the type of local binding " + lid.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
  end
  for (sig_key, sig) in env.typed_fn_signatures do
    var si = 0
    while si < sig.params.len() do
      var he = false
      var hv = false
      var hp = false
      scan_codegen_type(env, &sig.params[si].ty, &mut he, &mut hv, &mut hp, true)
      if he then
        type_add_error(env, "unresolved Type::Error in the parameter type of signature `" + sig_key + "` would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
      end
      if hv then
        type_add_error(env, "unresolved inference variable (Type::Var) in the parameter type of signature `" + sig_key + "` would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
      end
      si = si + 1
    end
    var he = false
    var hv = false
    var hp = false
    scan_codegen_type(env, &sig.ret_type, &mut he, &mut hv, &mut hp, true)
    if he then
      type_add_error(env, "unresolved Type::Error in the return type of signature `" + sig_key + "` would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
    if hv then
      type_add_error(env, "unresolved inference variable (Type::Var) in the return type of signature `" + sig_key + "` would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
  end
  for (st_key, st_ty) in env.typed_static_types do
    var he = false
    var hv = false
    var hp = false
    scan_codegen_type(env, &st_ty, &mut he, &mut hv, &mut hp, false)
    if he then
      type_add_error(env, "unresolved Type::Error in the declared type of static `" + st_key + "` would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
    if hv then
      type_add_error(env, "unresolved inference variable (Type::Var) in the declared type of static `" + st_key + "` would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
    end
    if hp then
      type_add_error(env, "generic parameter (Type::Param) in the declared type of static `" + st_key + "` would reach MIR/codegen (a static is never a generic template)", Span { file: "", start: 0, end_pos: 0 })
    end
  end
  for (inst_node, inst_args) in env.typed_call_instances do
    var ai = 0
    while ai < inst_args.len() do
      var he = false
      var hv = false
      var hp = false
      scan_codegen_type(env, &inst_args[ai], &mut he, &mut hv, &mut hp, false)
      if he then
        type_add_error(env, "unresolved Type::Error in the solved generic-call substitution of node " + inst_node.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
      end
      if hv then
        type_add_error(env, "unresolved inference variable (Type::Var) in the solved generic-call substitution of node " + inst_node.to_string() + " would reach MIR/codegen", Span { file: "", start: 0, end_pos: 0 })
      end
      if hp then
        type_add_error(env, "generic parameter (Type::Param) in the solved generic-call substitution of node " + inst_node.to_string() + " would reach MIR/codegen (ZERO-INFERENCE: the substitution must be fully concrete)", Span { file: "", start: 0, end_pos: 0 })
      end
      ai = ai + 1
    end
  end
  end
end

def scan_deinit_plan_types(env: TypeEnv, plan: DeinitPlan, inout has_error: Bool, inout has_var: Bool) -> Unit
  match plan
  when DeinitPlan::Trivial then ()
  when DeinitPlan::Call(inst) then
    for t in inst.substs do scan_codegen_type(env, &t, has_error, has_var, false, true) end
  when DeinitPlan::UserFinalizer(inst, inner) then
    for t in inst.substs do scan_codegen_type(env, &t, has_error, has_var, false, true) end
    scan_deinit_plan_types(env, inner, has_error, has_var)
  when DeinitPlan::Aggregate(plans) then
    for p in plans do scan_deinit_plan_types(env, p, has_error, has_var) end
  when DeinitPlan::Enum(entries_map) then
    for (_, payload) in entries_map do
      let inner_plans = payload.1
      for p in inner_plans do scan_deinit_plan_types(env, p, has_error, has_var) end
    end
  when DeinitPlan::Array(inner) then scan_deinit_plan_types(env, inner, has_error, has_var)
  when DeinitPlan::Set(inner) then scan_deinit_plan_types(env, inner, has_error, has_var)
  when DeinitPlan::Box(inner) then scan_deinit_plan_types(env, inner, has_error, has_var)
  end  end
end

# ———————————————————————————————————————————————————————————————
# The semantic completeness oracle (the reviewer's item 8)
# ———————————————————————————————————————————————————————————————
#
# The distinction this oracle enforces:
#   - USER MISTAKES are recorded by the checker itself with the stable
#     diagnostics (the E-codes, the "cannot infer type parameter" errors,
#     the "must be a constant" errors, ...) and abort compilation through
#     TypeCheckResult.errors BEFORE any oracle runs.
#   - The IMPOSSIBLE POST-TYPECHECK STATE — an ACCEPTED program whose
#     recorded semantic channels still carry a placeholder — is an
#     INTERNAL INVARIANT FAILURE (the ICE): the checkers claim to have
#     accepted the program, so any residual placeholder proves a checker
#     channel lost a record. The oracle records ICE-class TypeErrors
#     (code "ICE") that abort compilation before MIR lowering.
#
# The oracle covers, for an accepted program:
#   1. Type::Error / unresolved Type::Var / Param-in-concrete-position —
#      verify_codegen_readiness (the channel scan above).
#   2. UNKNOWN DefId — every recorded call target and finalizer DefId must
#      be a resolver-registered symbol (module_symbols).
#   3. UNKNOWN FieldId / VariantId — every typed field/variant identity in
#      the typed-HIR tree, the typed patterns, the flat field_targets, the
#      pattern_variant_resolutions, and the deinit plans must name an
#      existing field/variant of its OWNER type.
#   4. MISSING ACCESS EFFECT — every typed call node's receiver and every
#      call argument must carry the recorded per-node access effect.
#   5. MISSING OBLIGATION SOLUTION — every registered trait impl must be
#      backed by its trait's declared contract (validate-first-register-
#      second), so no impl with an unknown trait silently skips
#      conformance validation.
#   6. UNKNOWN LAYOUT (typecheck side) — every named TypeId the channels
#      reference must be a registered nominal (type_kinds); the full layout
#      availability is the MIR oracle (run_mir_completeness_oracle) + the
#      layout engine's fail-closed layout_of_concrete at codegen.
#   7. PLACEHOLDER SYMBOL / MIR — the MIR-side mirrors (placeholder
#      terminators, unresolved callees) are the MIR verifier's checks that
#      run at the MIR boundary; the typecheck side is (2)-(6) above.

def run_semantic_completeness_oracle(inout env: TypeEnv, typed: TypedProgram) -> Unit
  var findings: Vec[String] = Vec::new()
  # (2) the DefId registry — the numeric flattening of every resolver-
  # registered symbol (module_symbols values).
  var known_defs: Set[Int] = Set::new()
  match env.resolutions
  when Option::Some(res) then
    for (_, sym_did) in res.module_symbols do
      known_defs.insert(def_id_numeric(&sym_did))
    end
  when Option::None then
    findings.push("internal error: the semantic completeness oracle cannot run without the resolved symbol table (env.resolutions is empty at the end of type checking)")
  end
  for (call_node, call_did) in typed.call_targets do
    if !known_defs.contains(def_id_numeric(&call_did)) then
      findings.push("internal error: call node " + call_node.to_string() + " records a DefId (module " + call_did.module.id.to_string() + ", index " + call_did.index.to_string() + ") the resolver never registered (unknown DefId would reach MIR/codegen)")
    end
  end
  for (finalizer_tid, finalizer_callable) in typed.deinit_targets do
    if !known_defs.contains(def_id_numeric(&finalizer_callable.def)) then
      findings.push("internal error: type#" + finalizer_tid.to_string() + " registers a finalizer DefId (module " + finalizer_callable.def.module.id.to_string() + ", index " + finalizer_callable.def.index.to_string() + ") the resolver never registered (unknown DefId would reach MIR/codegen)")
    end
  end
  # (3) the typed-HIR tree walk — field/variant identities + access effects.
  for (_, te) in env.typed_exprs do
    oracle_walk_typed_expr(env, typed, te, &mut findings)
  end
  for (_, tp) in env.typed_patterns do
    oracle_walk_typed_pattern(typed, tp, &mut findings)
  end
  # the flat field_targets index (belt over the tree).
  for (field_node, fid) in typed.field_targets do
    oracle_check_field_id(typed, &fid, "flat field_targets of node " + field_node.to_string(), &mut findings)
  end
  # the pattern_variant_resolutions index ((TypeId, variant index)).
  for (pat_node, pv) in env.pattern_variant_resolutions do
    let owner_tid = pv.0
    let variant_idx = pv.1
    match typed.type_variants.get(owner_tid)
    when Option::Some(vshape) then
      if variant_idx < 0 || variant_idx >= vshape.len() then
        findings.push("internal error: pattern node " + pat_node.to_string() + " resolves variant index " + variant_idx.to_string() + " of type#" + owner_tid.to_string() + " which has " + vshape.len().to_string() + " variants (unknown VariantId would reach MIR/codegen)")
      end
    when Option::None then
      findings.push("internal error: pattern node " + pat_node.to_string() + " resolves a variant of unknown type#" + owner_tid.to_string() + " (unknown VariantId would reach MIR/codegen)")
    end
  end
  # the deinit plans' variant identities.
  for (_, dp) in typed.deinit_plans do
    oracle_scan_deinit_plan(typed, &dp, &mut findings)
  end
  # (5) the trait-contract obligation backstop.
  var impl_i = 0
  while impl_i < env.impls.len() do
    let imp = env.impls[impl_i]
    if imp.trait_id.id != -1 then
      match env.trait_contracts.get(imp.trait_id.id)
      when Option::Some(_) then ()
      when Option::None then
        findings.push("internal error: impl of trait#" + imp.trait_id.id.to_string() + " (" + imp.trait_name + ") has no declared trait contract — its obligations would silently skip conformance validation (missing obligation solution)")
      end
    end
    impl_i = impl_i + 1
  end
  # (6) the named-TypeId registry (the unknown-layout precursor).
  for (tf_tid, _) in typed.type_fields do
    if !typed.type_kinds.contains_key(&tf_tid) then
      findings.push("internal error: struct fields are recorded for unknown type#" + tf_tid.to_string() + " (no type kind — an unknown TypeId can never have a layout)")
    end
  end
  for (tv_tid, _) in typed.type_variants do
    if !typed.type_kinds.contains_key(&tv_tid) then
      findings.push("internal error: enum variants are recorded for unknown type#" + tv_tid.to_string() + " (no type kind — an unknown TypeId can never have a layout)")
    end
  end
  for (dp_tid, _) in typed.deinit_plans do
    if !typed.type_kinds.contains_key(&dp_tid) then
      findings.push("internal error: a deinit plan is recorded for unknown type#" + dp_tid.to_string() + " (no type kind — an unknown TypeId can never have a layout)")
    end
  end
  var fi = 0
  while fi < findings.len() do
    type_add_error(env, findings[fi].clone(), Span { file: "", start: 0, end_pos: 0 })
    fi = fi + 1
  end
end

def oracle_walk_typed_expr(inout env: TypeEnv, typed: TypedProgram, te: TypedExpr, inout findings: Vec[String]) -> Unit
  match te.kind
  when TypedExprKind::Local(_) then ()
  when TypedExprKind::Global(_) then ()
  when TypedExprKind::SelfRef then ()
  when TypedExprKind::Literal(_) then ()
  when TypedExprKind::Path(_) then ()
  when TypedExprKind::BinaryOp(_, left, right) then
    oracle_walk_typed_expr(env, typed, &left, findings)
    oracle_walk_typed_expr(env, typed, &right, findings)
  when TypedExprKind::UnaryOp(_, operand) then oracle_walk_typed_expr(env, typed, &operand, findings)
  when TypedExprKind::Index(base, index) then
    oracle_walk_typed_expr(env, typed, &base, findings)
    oracle_walk_typed_expr(env, typed, &index, findings)
  when TypedExprKind::Cast(value, _) then oracle_walk_typed_expr(env, typed, &value, findings)
  when TypedExprKind::TypeCheck(value, _) then oracle_walk_typed_expr(env, typed, &value, findings)
  when TypedExprKind::RawDeref(inner) then oracle_walk_typed_expr(env, typed, &inner, findings)
  when TypedExprKind::Access(inner) then oracle_walk_typed_expr(env, typed, &inner, findings)
  when TypedExprKind::Range(start_opt, end_opt, _) then
    match start_opt
    when Option::Some(s) then oracle_walk_typed_expr(env, typed, &s, findings)
    when Option::None then ()
    end
    match end_opt
    when Option::Some(e) then oracle_walk_typed_expr(env, typed, &e, findings)
    when Option::None then ()
    end
  when TypedExprKind::Await(inner) then oracle_walk_typed_expr(env, typed, &inner, findings)
  when TypedExprKind::Try(inner) then oracle_walk_typed_expr(env, typed, &inner, findings)
  when TypedExprKind::Pipe(lhs, rhs) then
    oracle_walk_typed_expr(env, typed, &lhs, findings)
    oracle_walk_typed_expr(env, typed, &rhs, findings)
  when TypedExprKind::Assign(target, value) then
    oracle_walk_typed_expr(env, typed, &target, findings)
    oracle_walk_typed_expr(env, typed, &value, findings)
  when TypedExprKind::ArrayLit(elems) then
    for e in elems do oracle_walk_typed_expr(env, typed, &e, findings) end
  when TypedExprKind::TupleLit(elems) then
    for e in elems do oracle_walk_typed_expr(env, typed, &e, findings) end
  when TypedExprKind::StructLit(_, fields) then
    for (_, fe) in fields do oracle_walk_typed_expr(env, typed, &fe, findings) end
  when TypedExprKind::MapLit(pairs) then
    for (k, v) in pairs do
      oracle_walk_typed_expr(env, typed, &k, findings)
      oracle_walk_typed_expr(env, typed, &v, findings)
    end
  when TypedExprKind::Call(tc) then
    match tc.callee
    when TypedCallee::Def(callable) then
      match typed.call_targets.get(te.id)
      when Option::Some(_) then ()
      when Option::None then
        findings.push("internal error: call node " + te.id.to_string() + " carries a typed Def callee but no call_targets entry (missing callee identity would reach MIR/codegen)")
      end
    when TypedCallee::Closure then ()
    when TypedCallee::EffectPerform(eid, op_idx, op_name) then
      # The effect-perform identity: the semantic EffectId must be a
      # registered typed effect and the op index must resolve in its op
      # table (a stale identity would reach MIR/codegen).
      match typed.typed_effects.get(eid.id)
      when Option::Some(decl) then
        if op_idx < 0 || op_idx >= decl.ops.len() then
          findings.push("internal error: call node " + te.id.to_string() + " performs op index " + op_idx.to_string() + " of effect " + eid.id.to_string() + " which has " + decl.ops.len().to_string() + " operations (stale EffectPerform identity would reach MIR/codegen)")
        end
      when Option::None then
        findings.push("internal error: call node " + te.id.to_string() + " performs unregistered effect id " + eid.id.to_string() + " (unknown effect would reach MIR/codegen)")
      end
    end
    match tc.receiver_effect
    when Option::Some(_) then ()
    when Option::None then
      match tc.receiver
      when Option::Some(_) then
        findings.push("internal error: call node " + te.id.to_string() + " has a receiver but no recorded receiver access effect (missing access effect would reach MIR/codegen)")
      when Option::None then ()
      end
    end
    match tc.receiver
    when Option::Some(recv) then oracle_walk_typed_expr(env, typed, &recv, findings)
    when Option::None then ()
    end
    for arg in tc.args do
      match env.typed_access_effects.get(arg.value.id)
      when Option::Some(_) then ()
      when Option::None then
        findings.push("internal error: call node " + te.id.to_string() + " argument node " + arg.value.id.to_string() + " has no recorded access effect (missing access effect would reach MIR/codegen)")
      end
      oracle_walk_typed_expr(env, typed, &arg.value, findings)
    end
  when TypedExprKind::Field(tf) then
    oracle_check_field_id(typed, &tf.field, "field access of node " + te.id.to_string(), findings)
    oracle_walk_typed_expr(env, typed, &tf.base, findings)
  when TypedExprKind::TupleIndex(base, _, _) then oracle_walk_typed_expr(env, typed, &base, findings)
  when TypedExprKind::Variant(tv) then
    oracle_check_variant_id(typed, &tv.variant, "variant construction of node " + te.id.to_string(), findings)
    for a in tv.args do oracle_walk_typed_expr(env, typed, &a, findings) end
  when TypedExprKind::StaticPathCall(_, args) then
    for a in args do oracle_walk_typed_expr(env, typed, &a, findings) end
  when TypedExprKind::MacroCall(_, args) then
    for a in args do oracle_walk_typed_expr(env, typed, &a, findings) end
  when TypedExprKind::Closure(_, body) then
    oracle_walk_typed_expr(env, typed, &body, findings)
  when TypedExprKind::If(cond, then_block, elsif_branches, else_block) then
    oracle_walk_typed_expr(env, typed, &cond, findings)
    for s in then_block do oracle_walk_typed_stmt(env, typed, s, findings) end
    for (econd, eblock) in elsif_branches do
      oracle_walk_typed_expr(env, typed, &econd, findings)
      for s in eblock do oracle_walk_typed_stmt(env, typed, s, findings) end
    end
    match else_block
    when Option::Some(eb) then
      for s in eb do oracle_walk_typed_stmt(env, typed, s, findings) end
    when Option::None then ()
    end
  when TypedExprKind::Match(scrutinee, arms) then
    oracle_walk_typed_expr(env, typed, &scrutinee, findings)
    for arm in arms do
      oracle_walk_typed_pattern(typed, arm.pattern, findings)
      match arm.guard_expr
      when Option::Some(g) then oracle_walk_typed_expr(env, typed, &g, findings)
      when Option::None then ()
      end
      for s in arm.body do oracle_walk_typed_stmt(env, typed, s, findings) end
    end
  when TypedExprKind::Block(stmts) then
    for s in stmts do oracle_walk_typed_stmt(env, typed, s, findings) end
  when TypedExprKind::Unsafe(_, body) then
    for s in body do oracle_walk_typed_stmt(env, typed, s, findings) end
  when TypedExprKind::Async(stmts) then
    for s in stmts do oracle_walk_typed_stmt(env, typed, s, findings) end
  when TypedExprKind::Comptime(stmts) then
    for s in stmts do oracle_walk_typed_stmt(env, typed, s, findings) end
  end  end
end

def oracle_walk_typed_stmt(inout env: TypeEnv, typed: TypedProgram, ts: TypedStmt, inout findings: Vec[String]) -> Unit
  match ts.kind
  when TypedStmtKind::Let(pat, value, _) then
    oracle_walk_typed_pattern(typed, pat, findings)
    oracle_walk_typed_expr(env, typed, &value, findings)
  when TypedStmtKind::Assign(target, value) then
    oracle_walk_typed_expr(env, typed, &target, findings)
    oracle_walk_typed_expr(env, typed, &value, findings)
  when TypedStmtKind::CompoundAssign(_, target, value) then
    oracle_walk_typed_expr(env, typed, &target, findings)
    oracle_walk_typed_expr(env, typed, &value, findings)
  when TypedStmtKind::If(cond, then_block, elsif_branches, else_block) then
    oracle_walk_typed_expr(env, typed, &cond, findings)
    for s in then_block do oracle_walk_typed_stmt(env, typed, s, findings) end
    for (econd, eblock) in elsif_branches do
      oracle_walk_typed_expr(env, typed, &econd, findings)
      for s in eblock do oracle_walk_typed_stmt(env, typed, s, findings) end
    end
    match else_block
    when Option::Some(eb) then
      for s in eb do oracle_walk_typed_stmt(env, typed, s, findings) end
    when Option::None then ()
    end
  when TypedStmtKind::Match(scrutinee, arms) then
    oracle_walk_typed_expr(env, typed, &scrutinee, findings)
    for arm in arms do
      oracle_walk_typed_pattern(typed, arm.pattern, findings)
      match arm.guard_expr
      when Option::Some(g) then oracle_walk_typed_expr(env, typed, &g, findings)
      when Option::None then ()
      end
      for s in arm.body do oracle_walk_typed_stmt(env, typed, s, findings) end
    end
  when TypedStmtKind::While(cond, body) then
    oracle_walk_typed_expr(env, typed, &cond, findings)
    for s in body do oracle_walk_typed_stmt(env, typed, s, findings) end
  when TypedStmtKind::For(_, pat, iter, body) then
    oracle_walk_typed_pattern(typed, pat, findings)
    oracle_walk_typed_expr(env, typed, &iter, findings)
    for s in body do oracle_walk_typed_stmt(env, typed, s, findings) end
  when TypedStmtKind::Loop(body) then
    for s in body do oracle_walk_typed_stmt(env, typed, s, findings) end
  when TypedStmtKind::Return(ret_opt) then
    match ret_opt
    when Option::Some(r) then oracle_walk_typed_expr(env, typed, &r, findings)
    when Option::None then ()
    end
  when TypedStmtKind::Break(br_opt) then
    match br_opt
    when Option::Some(b) then oracle_walk_typed_expr(env, typed, &b, findings)
    when Option::None then ()
    end
  when TypedStmtKind::Continue then ()
  when TypedStmtKind::Expr(e) then oracle_walk_typed_expr(env, typed, &e, findings)
  when TypedStmtKind::Unsafe(_, body) then
    for s in body do oracle_walk_typed_stmt(env, typed, s, findings) end
  when TypedStmtKind::Defer(body) then
    for s in body do oracle_walk_typed_stmt(env, typed, s, findings) end
  when TypedStmtKind::Guard(cond, else_action) then
    oracle_walk_typed_expr(env, typed, &cond, findings)
    match else_action
    when TypedGuardElse::Return(ret_opt) then
      match ret_opt
      when Option::Some(r) then oracle_walk_typed_expr(env, typed, &r, findings)
      when Option::None then ()
      end
    when TypedGuardElse::Panic(_) then ()
    when TypedGuardElse::Break(br_opt) then
      match br_opt
      when Option::Some(b) then oracle_walk_typed_expr(env, typed, &b, findings)
      when Option::None then ()
      end
    when TypedGuardElse::Continue then ()
    end
  when TypedStmtKind::Try(body, catches, finally_opt) then
    for s in body do oracle_walk_typed_stmt(env, typed, s, findings) end
    for c in catches do
      oracle_walk_typed_pattern(typed, c.pattern, findings)
      for s in c.body do oracle_walk_typed_stmt(env, typed, s, findings) end
    end
    match finally_opt
    when Option::Some(fb) then
      for s in fb do oracle_walk_typed_stmt(env, typed, s, findings) end
    when Option::None then ()
    end
  when TypedStmtKind::With(expr, pat, body) then
    oracle_walk_typed_expr(env, typed, &expr, findings)
    oracle_walk_typed_pattern(typed, pat, findings)
    for s in body do oracle_walk_typed_stmt(env, typed, s, findings) end
  when TypedStmtKind::HandleWith(expr, handlers) then
    oracle_walk_typed_expr(env, typed, &expr, findings)
    for h in handlers do
      for ha in h.arms do
        for p in ha.params do oracle_walk_typed_pattern(typed, p, findings) end
        for s in ha.body do oracle_walk_typed_stmt(env, typed, s, findings) end
      end
    end
  end  end
end

def oracle_walk_typed_pattern(typed: TypedProgram, tp: TypedPattern, inout findings: Vec[String]) -> Unit
  match tp.kind
  when TypedPatternKind::Wildcard then ()
  when TypedPatternKind::Ident(_, _, _) then ()
  when TypedPatternKind::Literal(_) then ()
  when TypedPatternKind::Tuple(pats) then
    for p in pats do oracle_walk_typed_pattern(typed, p, findings) end
  when TypedPatternKind::Array(pats) then
    for p in pats do oracle_walk_typed_pattern(typed, p, findings) end
  when TypedPatternKind::Struct(_, fields) then
    for (_, fp) in fields do oracle_walk_typed_pattern(typed, fp, findings) end
  when TypedPatternKind::Variant(vid, args) then
    oracle_check_variant_id(typed, &vid, "variant pattern of node " + tp.id.to_string(), findings)
    for p in args do oracle_walk_typed_pattern(typed, p, findings) end
  when TypedPatternKind::Or(pats) then
    for p in pats do oracle_walk_typed_pattern(typed, p, findings) end
  when TypedPatternKind::Range(_, _, _) then ()
  end  end
end

def oracle_check_field_id(typed: TypedProgram, fid: FieldId, what: String, inout findings: Vec[String]) -> Unit
  match typed.type_fields.get(fid.owner.id)
  when Option::Some(fshape) then
    if fid.index < 0 || fid.index >= fshape.len() then
      findings.push("internal error: " + what + " records field index " + fid.index.to_string() + " of type#" + fid.owner.id.to_string() + " which has " + fshape.len().to_string() + " fields (unknown FieldId would reach MIR/codegen)")
    end
  when Option::None then
    findings.push("internal error: " + what + " records a field of unknown owner type#" + fid.owner.id.to_string() + " (unknown FieldId would reach MIR/codegen)")
  end  end
end

def oracle_check_variant_id(typed: TypedProgram, vid: VariantId, what: String, inout findings: Vec[String]) -> Unit
  match typed.type_variants.get(vid.owner.id)
  when Option::Some(vshape) then
    if (vid.index as Int) < 0 || (vid.index as Int) >= vshape.len() then
      findings.push("internal error: " + what + " records variant index " + vid.index.to_string() + " of type#" + vid.owner.id.to_string() + " which has " + vshape.len().to_string() + " variants (unknown VariantId would reach MIR/codegen)")
    end
  when Option::None then
    findings.push("internal error: " + what + " records a variant of unknown owner type#" + vid.owner.id.to_string() + " (unknown VariantId would reach MIR/codegen)")
  end  end
end

def oracle_scan_deinit_plan(typed: TypedProgram, plan: DeinitPlan, inout findings: Vec[String]) -> Unit
  match plan
  when DeinitPlan::Trivial then ()
  when DeinitPlan::Call(_) then ()
  when DeinitPlan::UserFinalizer(_, inner) then oracle_scan_deinit_plan(typed, inner, findings)
  when DeinitPlan::Aggregate(plans) then
    for p in plans do oracle_scan_deinit_plan(typed, p, findings) end
  when DeinitPlan::Enum(entries_map) then
    for (_, payload) in entries_map do
      let vid = payload.0
      oracle_check_variant_id(typed, &vid, "deinit-plan variant identity", findings)
      let inner_plans = payload.1
      for p in inner_plans do oracle_scan_deinit_plan(typed, p, findings) end
    end
  when DeinitPlan::Array(inner) then oracle_scan_deinit_plan(typed, inner, findings)
  when DeinitPlan::Set(inner) then oracle_scan_deinit_plan(typed, inner, findings)
  when DeinitPlan::Box(inner) then oracle_scan_deinit_plan(typed, inner, findings)
  end  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def type_check(program: Program) -> Vec[TypeError]
  type_check_strict(program, false)
end

def type_check_strict(program: Program, strict: Bool) -> Vec[TypeError]
  var env = type_env_new()
  env.strict_resolution = strict
  type_check_program_env(&mut env, program)
  env.errors
end

# (final): resolve the parked generic-call instances
# (pending_call_instances) after the WHOLE program is checked. A generic
# parameter that only the caller's context constrains (a return-type-only
# parameter, e.g. the T of `Vec::new()` unified with the
# `let v: Vec[String] = Vec::new()` annotation) is still an unbound
# inference variable at the call site; the caller-context unifications land
# during the rest of the check, and this pass re-resolves each parked
# call's variables.
#
# ZERO-INFERENCE (the end-of-check resolution):
#   1. each parked variable is resolved (chasing env.subst);
#   2. a call still incomplete is SOLVED FROM THE DEST — the call's
#      recorded result type (typed_expr_types; the source of the MIR
#      destination local's type for method calls) is chased to its final
#      form, and when the chased dest is fully concrete the recorded entry
#      is unified against it, binding every parked variable the call's
#      result type contains to its dest position;
#   3. a variable no context ever solves is a GENUINELY UNCONSTRAINED
#      shape: it records "cannot infer type parameter `<name>`: add an
#      annotation" — the monomorphizer performs no call-site inference
#      (fail-closed; a call a context never solves never reaches it).
def resolve_pending_call_instances(inout env: TypeEnv) -> Unit
  let entries = env.pending_call_instances.entries()
  var i = 0
  while i < entries.len() do
    let (node_id, rec_triple) = entries[i]
    let rec_names = rec_triple.0
    let rec_vars = rec_triple.1
    let rec_span = rec_triple.2
    var all_solved = true
    var solved_args = Vec::new()
    var vi = 0
    while vi < rec_vars.len() do
      let resolved = resolve_type_var(env, rec_vars[vi].clone())
      match resolved
      when Type::Var(_) then all_solved = false
      when _ then solved_args.push(resolved)
      end
      vi = vi + 1
    end
    if !all_solved then
      # ZERO-INFERENCE (dest rule): the parked variables are the call's own
      # instantiated-signature variables, so the recorded call-result type
      # SHARES them; chasing the entry and unifying it against the chased
      # (fully-resolved) dest solves every variable the call's result type
      # contains from the caller's dest context.
      match env.typed_expr_types.get(node_id)
      when Option::Some(entry_ty) then
        let chased = resolve_type_var(env, entry_ty.clone())
        var chased_has_error = false
        var chased_has_var = false
        var chased_has_param = false
        scan_codegen_type(env, &chased, &mut chased_has_error, &mut chased_has_var, &mut chased_has_param, true)
        if !chased_has_error && !chased_has_var then
          unify(env, entry_ty.clone(), chased, rec_span)
          all_solved = true
          solved_args = Vec::new()
          var vi2 = 0
          while vi2 < rec_vars.len() do
            let resolved2 = resolve_type_var(env, rec_vars[vi2].clone())
            match resolved2
            when Type::Var(_) then all_solved = false
            when _ then solved_args.push(resolved2)
            end
            vi2 = vi2 + 1
          end
        end
      when Option::None then ()
      end
    end
    if all_solved then
      env.typed_call_instances.insert(node_id, solved_args)
    else
      # Genuinely unconstrained: no context (arguments, annotation, dest)
      # ever solved the parameter — record the annotation error per
 # parameter (the name comes from the param-name table).
      var ni = 0
      while ni < rec_names.len() do
        match resolve_type_var(env, rec_vars[ni].clone())
        when Type::Var(_) then
          let pname = generic_param_name_of(&env.generic_param_table, &rec_names[ni])
          type_add_error(env, "cannot infer type parameter `" + pname + "`: add an annotation", rec_span)
        when _ then ()
        end
        ni = ni + 1
      end
    end
    i = i + 1
  end
  env.pending_call_instances.clear()
end

def type_check_typed(inout env: TypeEnv, program: Program, resolutions: ResolvedNames) -> TypeCheckResult
  env.local_id_counter = 0
  env.local_ids.clear()
  env.typed_call_targets.clear()
  env.typed_call_instances.clear()
  env.typed_field_targets.clear()
  env.typed_local_bindings.clear()
  env.typed_ident_resolutions.clear()
  env.param_binding_resolutions.clear()
  env.pattern_binding_resolutions.clear()
  env.typed_access_effects.clear()
  env.typed_exprs.clear()
  env.typed_stmts.clear()
  env.typed_patterns.clear()
  env.typed_aggregate_ownership.clear()
  env.closure_captures.clear()
  env.binding_plans.clear()
  env.pattern_variant_resolutions.clear()
  env.resolutions = Option::Some(resolutions.clone())
 # (recovery separation): type_check_typed is the only entry that
  # produces a TypedProgram — the semantic authority MIR and codegen
  # consume. Compilation semantics here are therefore ALWAYS strict. Guard:
  # a real compilation running with strict_resolution = false is an internal
  # error; the flag is forced on unconditionally so the permissive
  # (editor-recovery) mode can never reach MIR/codegen — it is served only
  # by type_check / type_check_strict, which return errors alone and never
  # produce a codegenable TypedProgram.
  env.strict_resolution = true
  type_check_program_env(env, program)
 # after the whole program is checked, re-resolve the parked
  # generic-call instances (return-type-only parameters solved by the
  # caller's context) and record the now-solved substitutions — the
  # monomorphizer consumes them with zero inference.
  resolve_pending_call_instances(env)
 # (elimination): after the whole program is checked, default every
  # remaining inference-only IntLiteral to Type::Int (the coercion
  # contract — the resolved type never remains IntLiteral), across every
  # recorded type channel that reaches the codegenable TypedProgram.
  resolve_pending_int_literals(env)
 # (recovery separation): post-check verification — the semantic pass
  # must guarantee that no Type::Error and no unresolved inference variable
  # survives in a codegenable TypedProgram. Each finding records a TypeError
  # so compilation aborts before MIR lowering.
  verify_codegen_readiness(env)
  var kinds = Map::new()
  var type_names = Map::new()
  var deinit_targets = Map::new()
  var finalizer_kinds = Map::new()
  var type_fields = Map::new()
  var type_variants = Map::new()
  var type_params = Map::new()
  var type_layout_attrs = Map::new()
  var type_aliases = Map::new()
  var ki = 0
  while ki < env.type_list.len() do
    let td = env.type_list[ki]
    kinds.insert(td.id.id, td.kind)
    type_names.insert(td.id.id, td.name.clone())
    type_params.insert(td.id.id, td.generic_params.clone())
    # The layout attributes (the checker's validated declaration record).
    match env.layout_attrs.get(td.id.id)
    when Option::Some(la) then type_layout_attrs.insert(td.id.id, la.clone())
    when Option::None then ()
    end
    # Record the nominal shapes (struct fields / enum variants) so the
    # deinit-plan builder can walk them for viral containment.
    match td.def_kind
    when TypeDefKind::Struct(fields) then
      var shape = Vec::new()
      for f in fields do
        shape.push((f.name.clone(), f.ty.clone()))
      end
      type_fields.insert(td.id.id, shape)
    when TypeDefKind::Enum(variants) then
      var vshape = Vec::new()
      for v in variants do
        vshape.push((v.name.clone(), v.fields.clone(), v.discriminant))
      end
      type_variants.insert(td.id.id, vshape)
    when TypeDefKind::Alias(inner) then
      # The resolved inner type (the checker's env walks it for the
      # ownership answers; the engine snapshot re-applies it — see
      # TypedProgram.type_aliases).
      type_aliases.insert(td.id.id, inner.clone())
    when _ then ()
    end
    ki = ki + 1
  end
 # the finalizer registration's TYPE lookup uses the SAME
  # name -> TypeId inverse the MIR builds (both iterate the same type_names
  # map), so a duplicate bare name resolves to the same TypeId on both sides
  # of the seam (first-wins over env.type_list would diverge from the MIR's
  # map-inverse).
  var tid_by_name = Map::new()
  for (tn_tid, tn_name) in type_names do
    tid_by_name.insert(tn_name.clone(), tn_tid)
  end
  # Collect registered deinit methods (type -> the finalizer's SEMANTIC
  # CallableId) so the per-type DeinitPlan can reference them; a resource
  # WITHOUT a deinit is trivially deinitialized (no entry here is fine).
 # (final layer): the registration value is the RESOLVER's DefId —
  # the module_symbols QUALIFIED entry ("path::Type::method" — the item's
 # OWNER path from Program.crate; the replacement for the
  # bare-keyed method table) — the SAME identity the MIR records for the
  # mangled emission names ("Type__drop" / "Type__deinit"). A finalizer
  # the resolver never registered a DefId for is a registration failure: a
  # TypeError is recorded and the type gets NO entry (its plans fail
  # closed at the verified_* construction sites) — a name-only finalizer
  # can never become a plan callable.
  var dmi = 0
  while dmi < program.items.len() do
    let item = program.items[dmi]
    let item_path = crate_module_path_of(program, &item.owner_module)
    match item.kind
    when ItemKind::ItemImpl(imp) then
      var mj = 0
      while mj < imp.methods.len() do
        let m = imp.methods[mj]
        # The registered cleanup callables are the impl's Drop::drop methods
        # AND resources' own deinit methods. MIR lowers impl methods as
        # TypeName__method, so the Drop impls register as "Box__drop" etc.
        # A method named "drop" is a destructor ONLY inside the Drop trait
        # impl (spelling alone must not make an inherent method the
        # compiler's automatic destructor). "deinit" is the canonical
        # Tangerine finalizer everywhere.
 # the Drop impl identity is the LangItems TraitId — never
        # the name. The AST impl carries only the trait name; the
        # checker-side trait registry maps it to the SAME TraitId
        # build_lang_items captured for drop_trait.
 # (— the typed FinalizerKind): the finalizer
        # KIND is assigned HERE, at declaration/type-checking, and recorded
        # in typed.finalizer_kinds next to the CallableId (deinit_targets).
        # The kind is the SOURCE classification (an explicit Drop impl vs an
        # inherent deinit method); no downstream consumer re-recognizes a
        # finalizer by its source name.
        let is_drop_impl = match imp.trait_name
        when Option::Some(tn) then trait_id_for(env, &tn).id == env.lang_items.drop_trait
        when Option::None then false
        end
        let m_kind = if is_drop_impl then FinalizerKind::DropTraitMethod else FinalizerKind::DeinitMethod end
        if m.name == "deinit" || (m.name == "drop" && is_drop_impl) then
 # (registration-key fix): the lookup key is the RESOLVER's
          # rendering (impl_registry_method_key — "Box[...]::drop" for a
          # generic for_type, matching resolver.tg's type_expr_to_string
          # keys), MODULE-QUALIFIED by the item's OWNER path (the semantic
          # registration — module_symbols), never a bare-name key
          # ("Box::drop" — which misses every generic Drop impl). The TYPE
          # lookup is the tid_by_name inverse above (the same inverse the
          # MIR builds).
          let type_key = type_expr_name_of(&imp.for_type)
          let method_key = impl_registry_method_key(&imp.for_type, &m.name)
          let qualified_key = module_qualified_key(&item_path, &method_key)
          match tid_by_name.get(type_key)
          when Option::Some(reg_tid) then
            match resolutions.module_symbols.get(&qualified_key)
            when Option::Some(mdid) then
              match def_kind_of(&resolutions, &mdid)
              when Option::Some(mk) then
                if mk == DefKind::Method then
                  deinit_targets.insert(reg_tid, CallableId { def: mdid.clone() })
                  finalizer_kinds.insert(reg_tid, m_kind)
                else
                  env.errors.push(TypeError {
                    message: "internal error: finalizer `" + method_key + "` has no resolver DefId (finalizer registration is the DefId identity, never the name)",
                    span: m.span,
                    code: Option::None
                  })
                end
              when Option::None then
                env.errors.push(TypeError {
                  message: "internal error: finalizer `" + method_key + "` has no resolver DefId (finalizer registration is the DefId identity, never the name)",
                  span: m.span,
                  code: Option::None
                })
              end
            when Option::None then
              env.errors.push(TypeError {
                message: "internal error: finalizer `" + method_key + "` has no resolver DefId (finalizer registration is the DefId identity, never the name)",
                span: m.span,
                code: Option::None
              })
            end
          when Option::None then ()
          end
        end
        mj = mj + 1
      end
    when ItemKind::ItemStruct(s) then
      var mj2 = 0
      while mj2 < s.methods.len() do
        let m2 = s.methods[mj2]
 # an inherent `deinit` method registers with
        # the DeinitMethod kind (the typed FinalizerKind record — the same
        # recognition the MIR and the resource checker consume; the source
        # name participates only at THIS declaration site).
        if m2.name == "deinit" then
          let method_key2 = s.name.clone() + "::" + m2.name.clone()
          let qualified_key2 = module_qualified_key(&item_path, &method_key2)
          match tid_by_name.get(s.name.clone())
          when Option::Some(reg_tid2) then
            match resolutions.module_symbols.get(&qualified_key2)
            when Option::Some(mdid2) then
              match def_kind_of(&resolutions, &mdid2)
              when Option::Some(mk2) then
                if mk2 == DefKind::Method then
                  deinit_targets.insert(reg_tid2, CallableId { def: mdid2.clone() })
                  finalizer_kinds.insert(reg_tid2, FinalizerKind::DeinitMethod)
                else
                  env.errors.push(TypeError {
                    message: "internal error: finalizer `" + method_key2 + "` has no resolver DefId (finalizer registration is the DefId identity, never the name)",
                    span: m2.span,
                    code: Option::None
                  })
                end
              when Option::None then
                env.errors.push(TypeError {
                  message: "internal error: finalizer `" + method_key2 + "` has no resolver DefId (finalizer registration is the DefId identity, never the name)",
                  span: m2.span,
                  code: Option::None
                })
              end
            when Option::None then
              env.errors.push(TypeError {
                message: "internal error: finalizer `" + method_key2 + "` has no resolver DefId (finalizer registration is the DefId identity, never the name)",
                span: m2.span,
                code: Option::None
              })
            end
          when Option::None then ()
          end
        end
        mj2 = mj2 + 1
      end
    when _ then ()
    end
    dmi = dmi + 1
  end
  # Build the recursive deinit plan for every type id (consumed by MIR).
  var deinit_plans = Map::new()
 # serialize the per-declaration typed records — the fn-signature
  # table (fn owner key -> FnSignature) and the static/const/extern-static
  # declared-type table (module-qualified key -> Type). Every recorded type
  # is CHASED through the final substitution (resolve_type_var): a
  # declaration whose annotation was an inference variable (an un-annotated
  # const/param) lands its post-checking solved form; a genuinely
  # unconstrained variable is a checker error already recorded by
  # verify_codegen_readiness, so compilation aborts before MIR lowering.
  var typed_fn_sigs = Map::new()
  for (sig_key, sig_rec) in env.typed_fn_signatures do
    var chased_params = Vec::new()
    for sp in sig_rec.params do
      chased_params.push(ParamType { ty: resolve_type_var(env, sp.ty), convention: sp.convention })
    end
    typed_fn_sigs.insert(sig_key, FnSignature { params: chased_params, ret_type: resolve_type_var(env, sig_rec.ret_type), declared_effects: sig_rec.declared_effects.clone(), declared_budget: sig_rec.declared_budget.clone() })
  end
  var typed_static_tys = Map::new()
  for (st_key, st_ty) in env.typed_static_types do
    typed_static_tys.insert(st_key, resolve_type_var(env, st_ty))
  end
 # (TypeId -> DefId at registration): serialize the DIRECT
  # type-to-declaration association — every filled TypeDef.def (the
  # resolver DefId recorded at store_type_def) into the resolutions
  # snapshot's type_def_ids (TypeId.id -> DefId). The snapshot is the
  # carrier the MIR/ABI consumers read (the public ABI's stable-path
  # derivation joins TypeId -> DefId -> module_symbols directly — no
  # name/order correlation).
  var final_resolutions = resolutions.clone()
  for td_f in env.type_list do
    match td_f.def
    when Option::Some(def_did) then final_resolutions.type_def_ids.insert(td_f.id.id, def_did)
    when Option::None then ()
    end
  end
 # (IntrinsicId at check time): serialize the per-call intrinsic
  # classification (typed_intrinsics — the checker's attachment at the
  # call-recording sites) into the snapshot — the typed program carries
  # the classification per call for the MIR/codegen consumers.
  for (intr_node, intr_id) in env.typed_intrinsics.entries() do
    final_resolutions.intrinsic_ids.insert(intr_node, intr_id)
  end
  env.resolutions = Option::Some(final_resolutions)
  # The TypedProgram snapshots carry the FINAL resolutions (the
  # type_def_ids association included), never the pre-registration input.
  let typed_resolutions = match env.resolutions
  when Option::Some(res_final) then res_final.clone()
  when Option::None then resolutions.clone()
  end
  var plan_typed = TypedProgram {
    ast: program.clone(),
    resolutions: typed_resolutions.clone(),
    expr_types: env.typed_expr_types.clone(),
    call_targets: env.typed_call_targets.clone(),
    call_instances: env.typed_call_instances.clone(),
    field_targets: env.typed_field_targets.clone(),
    access_effects: env.typed_access_effects.clone(),
    typed_exprs: env.typed_exprs.clone(),
    closure_captures: env.closure_captures.clone(),
    typed_effects: env.typed_effects.clone(),
    effect_name_index: env.effect_name_index.clone(),
    typed_effect_handlers: env.typed_effect_handlers.clone(),
    handler_captures: env.handler_captures.clone(),
    local_bindings: env.typed_local_bindings.clone(),
    ident_resolutions: env.typed_ident_resolutions.clone(),
    param_binding_resolutions: env.param_binding_resolutions.clone(),
    pattern_binding_resolutions: env.pattern_binding_resolutions.clone(),
    place_move_states: env.place_move_states.clone(),
    deinit_plans: Map::new(),
    aggregate_ownership: Map::new(),
    type_names: type_names.clone(),
    deinit_targets: deinit_targets.clone(),
    finalizer_kinds: finalizer_kinds.clone(),
    type_fields: type_fields.clone(),
    type_variants: type_variants.clone(),
    type_params: type_params.clone(),
    type_layout_attrs: type_layout_attrs.clone(),
    type_kinds: kinds.clone(),
    type_aliases: type_aliases.clone(),
    typed_fn_signatures: typed_fn_sigs.clone(),
    typed_static_types: typed_static_tys.clone(),
    lang_items: env.lang_items.clone(),
    generic_param_ids: env.generic_param_ids.clone(),
    generic_param_names: env.generic_param_table.names.clone()
  }
  var pi = 0
  while pi < env.type_list.len() do
    let td = env.type_list[pi]
    let self_ty = Type::Adt(td.id, Vec::new())
    var plan_visited = Set::new()
    let plan = build_deinit_plan(&plan_typed, &self_ty, 0, &mut plan_visited, &mut env.errors)
    deinit_plans.insert(td.id.id, plan)
    pi = pi + 1
  end
  let typed = TypedProgram {
    ast: program.clone(),
    resolutions: typed_resolutions.clone(),
    expr_types: env.typed_expr_types.clone(),
    call_targets: env.typed_call_targets.clone(),
    call_instances: env.typed_call_instances.clone(),
    field_targets: env.typed_field_targets.clone(),
    access_effects: env.typed_access_effects.clone(),
    typed_exprs: env.typed_exprs.clone(),
    closure_captures: env.closure_captures.clone(),
    typed_effects: env.typed_effects.clone(),
    effect_name_index: env.effect_name_index.clone(),
    typed_effect_handlers: env.typed_effect_handlers.clone(),
    handler_captures: env.handler_captures.clone(),
    local_bindings: env.typed_local_bindings.clone(),
    ident_resolutions: env.typed_ident_resolutions.clone(),
    param_binding_resolutions: env.param_binding_resolutions.clone(),
    pattern_binding_resolutions: env.pattern_binding_resolutions.clone(),
    place_move_states: env.place_move_states.clone(),
    deinit_plans: deinit_plans,
    aggregate_ownership: env.typed_aggregate_ownership.clone(),
    type_names: type_names,
    deinit_targets: deinit_targets,
    finalizer_kinds: finalizer_kinds,
    type_fields: type_fields,
    type_variants: type_variants,
    type_params: type_params,
    type_layout_attrs: type_layout_attrs,
    type_kinds: kinds,
    type_aliases: type_aliases,
    typed_fn_signatures: typed_fn_sigs,
    typed_static_types: typed_static_tys,
    lang_items: env.lang_items.clone(),
    generic_param_ids: env.generic_param_ids.clone(),
    generic_param_names: env.generic_param_table.names.clone()
  }
  # (item-8 oracle): after the TypedProgram is assembled, the semantic
  # completeness oracle audits the ACCEPTED program's recorded channels —
  # any residual placeholder (an unknown DefId/FieldId/VariantId, a missing
  # access effect, a missing obligation solution, an unknown TypeId) is an
  # ICE-class error recorded here so compilation aborts before MIR
  # lowering. User mistakes were already recorded by the checker with the
  # stable diagnostics; reaching this point with a placeholder is an
  # internal invariant failure by construction.
  run_semantic_completeness_oracle(&mut env, typed)
  env.resolutions = Option::None
 # the checker's result carries the EMPTY-ANALYSIS artifact (the
  # placeholder) — the TypedProgram plus a fresh AnalysisContext, an empty
  # TypedCFG, an empty finalize plan, and the engine snapshot of the typed
  # tables (so the editor-recovery lowering paths — lib.tg's REPL :mir —
  # keep the same engine answers they had before the artifact existed).
  # analyze_parsed replaces the placeholder with the REAL artifact after
  # access/resource checking; the placeholder's engine snapshot is reused
  # (copied) by the pipeline, so the snapshot is built exactly once.
  let placeholder_artifact = AnalyzedProgram {
    typed: typed,
    ast: typed.ast.clone(),
    resolutions: typed_resolutions.clone(),
    cfg: TypedCFG { edges: Vec::new(), blocks: Vec::new(), cleanup: Vec::new() },
    finalize_plan: function_cleanup_table_new(),
    context: analysis_context_new(),
    engine_snapshot: engine_snapshot_env(&typed),
    access_errors: Vec::new(),
    resource_errors: Vec::new()
  }
  TypeCheckResult {
    errors: env.errors.clone(),
    program: placeholder_artifact
  }
end

# ———————————————————————————————————————————————————————————————
# Transferable / Shareable classification — the compiler-derived
# concurrency properties (concurrency properties)
# ———————————————————————————————————————————————————————————————

# SINGLE RULE (, DECIDED — auto traits, ONE authority): Transferable and
# Shareable are AUTO TRAITS whose STRUCTURAL DERIVATION IS the canonical
# solver rule — the derivations below are THE authority. The
# user-implementable marker IMPLS ARE REMOVED FROM THE STD (the Send/Sync
# traits are deleted; the Transferable/Shareable marker impls are
# deleted): the obligation solver solves `T: Transferable` / `T:
# Shareable` obligations by the SAME structural derivation (see
# solve_obligation_depth's auto-trait hook), and a leftover user impl is
# never consulted — the derivation is the authority by construction.
#
# THE TRANSFERABLE WALK (a value is NOT Transferable when it contains):
#   1. the EXECUTION-CONTEXT-AFFINE NATIVE HANDLE (the std-marked
#      AffineHandle — the pthread thread handle PthreadT / the TLS key
#      PthreadKeyT carry the zero-size mark field) unless the CONTAINING
#      type explicitly opts in (`impl UnsafeTransferable for T` — the
#      documented gate). The raw Ptr/PtrMut of the affine types are
#      covered by the pointer gate (never inferred).
#   2. the ACTIVE LEXICAL INOUT STATE: a closure with an inout (Modify)
#      capture carries the lexical inout state — such a closure is not
#      Transferable/Shareable (the mutation is lexical to its defining
#      context; moving it would move the mutation).
#   3. the NON-TRANSFERABLE CAPTURED STATE: a closure's transferability
#      derives from its capture tuple (the walk recurses into it).
#   The plain owned types (String/Vec/Map/owned aggregates) ARE
#   Transferable (ownership moves); the smart-pointer layer (Box/
#   UniquePtr/Arc/WeakArc) transfers when its pointee does (heap-stable
#   ownership); Rc/WeakRc and the gated raw pointers are NOT.
#
# THE SHAREABLE WALK (safe simultaneous access through a shared
# representation): a type is Shareable iff
#   1. it is a TRIVIALLY-COPYABLE VALUE TYPE (the scalars and the
#      all-scalar aggregates — the atomics are exactly this shape), or
#   2. it is a RECOGNIZED SYNCHRONIZED REPRESENTATION — the Arc/WeakArc
#      (the shared heap boundary; the interior is reached through the
#      Arc's protocol, so the walk stops there — sharing an Arc shares
#      the synchronized representation), or
#   3. every field/variant/arg is itself Shareable (a Mutex/RwLock/
#      Condvar/channel — the std::sync types — reach the Arc layer
#      structurally).
#   The plain OWNED types (String/Vec/Map/owned aggregates) are
#   Transferable but NOT Shareable: shared mutable state must go through
#   Arc/Mutex/RwLock/atomics/channels. A type is rejected only when it
#   is provably non-transferable/non-shareable; undecidable leaves fail
#   OPEN (true).
#
# Raw pointers (, DECIDED): Ptr[T] / PtrMut[T] are Transferable /
# Shareable ONLY when the pointee T explicitly implements the opt-in gate
# marker (std::core UnsafeTransferable / UnsafeShareable) — pointer
# thread-safety is never inferred from T: Transferable (bit-copyability
# says nothing about whether the address stays meaningful and race-safe on
# another thread). The gate query is the ONLY user-implementable marker
# surface left in the concurrency model — the explicit opt-in the
# mandate names ("unless explicitly opted in").
#
# The old string-name exclusion sets (non_send_types / non_sync_types)
# are NOT READ in the decision path — they remain as a documentation
# mirror only. There is NO depth-based semantic shortcut: a deep-but-
# finite chain is walked to its concrete leaves (a depth limit would be a
# diagnostic, never a semantic answer).
def is_send(inout env: TypeEnv, ty: Type) -> Bool
  var visited = Set::new()
  derive_transferable(env, ty, &mut visited)
end

# The single Transferable derivation — THE rule (see the section header).
# The visited set makes recursion through legal indirections (Box/Arc/
# pointers) terminate; a revisit cannot prove non-transferability, so it
# fails open.
def derive_transferable(inout env: TypeEnv, ty: Type, inout visited: Set[Int]) -> Bool
  match ty
  when Type::Unit then true
  when Type::Bool then true
  when Type::Int then true
  when Type::UInt then true
  when Type::Float then true
  when Type::Char then true
  when Type::String then true  # owned, movable: Transferable (NOT Shareable)
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::Adt(tid, args) then
   # the EXPLICIT OPT-IN (the documented gate): a type whose safety
    # contract is asserted with `impl UnsafeTransferable for T` is
    # Transferable — the sanctioned escape for the std's own pinned
    # native handles (e.g. std::db's Transaction — a raw conn_handle
    # pinned by an Arc token for the value's whole lifetime). Without
    # the opt-in, a value CONTAINING the std-marked AffineHandle (the
    # execution-context-affine native handle) is NOT Transferable.
    if pointer_gate_holds(env, &ty, "UnsafeTransferable") then
      true
    elsif type_contains_affine_handle(env, ty) then
      false
    elsif tid.id == env.lang_items.rc || tid.id == env.lang_items.weak_rc then
      false  # the refcount is NOT synchronized
    elsif tid.id == env.lang_items.arc_strong || tid.id == env.lang_items.weak_arc ||
          tid.id == env.lang_items.box_ || tid.id == env.lang_items.unique_ptr then
      transferable_args_all(env, &args, visited)  # heap-stable ownership: the pointee walk
    else
      is_named_transferable(env, tid, args, visited)
    end
  when Type::RefInternal(inner, _) then
    derive_transferable(env, inner, visited)
  when Type::Tuple(elems) then
    for e in elems do
      if !derive_transferable(env, &e, visited) then return false end
    end
    true
  when Type::FnPtr(_, _, _) then true  # function pointers are Transferable
  when Type::Closure(cid, _, _, captures, _) then
    # (the active lexical inout state): a closure that mutates a
    # captured local carries the lexical inout state — NOT Transferable.
    if closure_has_inout_capture(env, cid.id) then
      false
    else
      derive_transferable(env, &captures, visited)
    end
  when Type::Ptr(inner) then pointer_gate_holds(env, &inner, "UnsafeTransferable")  # GATED: never inferred from T: Transferable
  when Type::PtrMut(inner) then pointer_gate_holds(env, &inner, "UnsafeTransferable")  # GATED: never inferred from T: Transferable
  when Type::FixedArray(elem, _) then derive_transferable(env, &elem, visited)
  when Type::StaticStrPtr then true  # the static string view: immutable static bytes
  when Type::Dyn(_) then true  # an OWNED trait object (Box[dyn T]): the erasure is reached only through the owning pointer — moving the owner moves the object
  when Type::Effect(_, inner) then derive_transferable(env, &inner, visited)
  when Type::Param(_) then true  # Assume generic params are Transferable (checked at instantiation)
  when Type::Var(_) then true  # Type variables: assume Transferable
 # (inference-only): an integer literal is a scalar value —
  # Transferable exactly like the concrete integer types.
  when Type::IntLiteral(_) then true
  when Type::Never then true
  when Type::Error then true
  end  end
end

# All the generic args of a pointer-layer type are Transferable (the
# Arc/Box/UniquePtr/WeakArc arm of the Adt walk).
def transferable_args_all(inout env: TypeEnv, args: Vec[Type], inout visited: Set[Int]) -> Bool
  var ok = true
  for a in args do
    if !derive_transferable(env, &a, visited) then ok = false end
  end
  ok
end

# (raw-pointer thread-safety gate): Ptr[T] / PtrMut[T] are
# Transferable / Shareable only when the POINTEE explicitly implements the
# opt-in marker trait (`impl UnsafeTransferable for T` /
# `impl UnsafeShareable for T` in std::core). The gate is a solver query on
# the marker trait — the explicit opt-in of the concurrency model — and
# never consults T's own Transferable/Shareable derivation.
def pointer_gate_holds(inout env: TypeEnv, pointee: Type, gate_trait: String) -> Bool
  let ob = Obligation { trait_ref: TraitRef { trait_id: trait_id_for(env, &gate_trait), self_ty: pointee.clone(), args: Vec::new() }, trait_name: gate_trait.clone() }
  solve_obligation(env, &ob)
end

# THE AFFINE-HANDLE CONTAINMENT WALK: does the value contain the
# std-marked execution-context-affine native handle (the LangItems
# AffineHandle id — the mark the std's pthread handle types carry as a
# zero-size field)? The walk covers the whole type graph: fields,
# variants, generic args, the pointees of the raw-pointer layer (a
# Ptr[Thread] is the raw pointer of an execution-context-affine type —
# affine), the capture tuples of closures. The visited set terminates
# recursion through legal indirections; a revisit cannot prove affine
# containment, so it fails open (false).
def type_contains_affine_handle(inout env: TypeEnv, ty: Type) -> Bool
  var visited = Set::new()
  type_contains_affine_handle_walk(env, ty, &mut visited)
end

def type_contains_affine_handle_walk(inout env: TypeEnv, ty: Type, inout visited: Set[Int]) -> Bool
  match ty
  when Type::Adt(tid, args) then
    if env.lang_items.affine_handle != -1 && tid.id == env.lang_items.affine_handle then
      return true
    end
    if visited.contains(&tid.id) then
      return false
    end
    visited.insert(tid.id)
    var ok = false
    match get_type_by_id_ref(env, tid)
    when Option::Some(td) then
      match td.def_kind
      when TypeDefKind::Struct(fields) then
        for field in fields do
          let f_ty = subst_type_args(&field.ty, &td.generic_params, args)
          if type_contains_affine_handle_walk(env, &f_ty, visited) then ok = true end
        end
      when TypeDefKind::Enum(variants) then
        for variant in variants do
          for f in variant.fields do
            let v_ty = subst_type_args(&f, &td.generic_params, args)
            if type_contains_affine_handle_walk(env, &v_ty, visited) then ok = true end
          end
        end
      when _ then ()
      end
    when Option::None then ()
    end
    for a in args do
      if type_contains_affine_handle_walk(env, &a, visited) then ok = true end
    end
    visited.remove(&tid.id)
    ok
  when Type::RefInternal(inner, _) then type_contains_affine_handle_walk(env, &inner, visited)
  when Type::Tuple(elems) then
    for e in elems do
      if type_contains_affine_handle_walk(env, &e, visited) then return true end
    end
    false
  when Type::FixedArray(elem, _) then type_contains_affine_handle_walk(env, &elem, visited)
  when Type::Closure(_, _, _, captures, _) then type_contains_affine_handle_walk(env, &captures, visited)
  when Type::Ptr(inner) then type_contains_affine_handle_walk(env, &inner, visited)
  when Type::PtrMut(inner) then type_contains_affine_handle_walk(env, &inner, visited)
  when Type::Effect(_, inner) then type_contains_affine_handle_walk(env, &inner, visited)
  when _ then false
  end  end
end

# Named-type structural derivation (Transferable): walk fields/variants with
# the concrete generic args substituted (the same walk the type-properties
# engine performs for owns_state/linearity) plus the concrete args. The Rc
# exclusion is the LangItems TypeId — never the name.
def is_named_transferable(inout env: TypeEnv, tid: TypeId, args: Vec[Type], inout visited: Set[Int]) -> Bool
  match get_type_by_id_ref(env, tid)
  when Option::Some(td) then
    if tid.id == env.lang_items.rc then
      return false
    end
    if visited.contains(&tid.id) then
      return true
    end
    visited.insert(tid.id)
    var ok = true
    match td.def_kind
    when TypeDefKind::Struct(fields) then
      for field in fields do
        let f_ty = subst_type_args(&field.ty, &td.generic_params, args)
        if !derive_transferable(env, &f_ty, visited) then ok = false end
      end
    when TypeDefKind::Enum(variants) then
      for variant in variants do
        for f in variant.fields do
          let v_ty = subst_type_args(&f, &td.generic_params, args)
          if !derive_transferable(env, &v_ty, visited) then ok = false end
        end
      end
    when _ then ()
    end
    for arg in args do
      if !derive_transferable(env, &arg, visited) then ok = false end
    end
    visited.remove(&tid.id)
    ok
  when Option::None then true
  end  end
end

# A type is Shareable (safe simultaneous access through a shared
# representation) iff the SINGLE auto-trait rule (see the section header)
# derives it: the recognized synchronized representations (Arc/WeakArc),
# the trivially-copyable value types, and the aggregates whose fields/
# variants/args are all Shareable. The plain OWNED types (String/Vec/
# owned aggregates) are Transferable but NOT Shareable — shared mutable
# state must go through Arc/Mutex/RwLock/atomics/channels.
def is_sync(inout env: TypeEnv, ty: Type) -> Bool
  var visited = Set::new()
  derive_syncable(env, ty, &mut visited)
end

# The single Shareable derivation — see derive_transferable for the rule
# structure. The visited set terminates legal-indirection recursion; there
# is NO depth-based semantic shortcut (a depth limit would be a diagnostic,
# never a semantic answer).
def derive_syncable(inout env: TypeEnv, ty: Type, inout visited: Set[Int]) -> Bool
  match ty
  when Type::Unit then true
  when Type::Bool then true
  when Type::Int then true
  when Type::UInt then true
  when Type::Float then true
  when Type::Char then true
  when Type::String then false  # owned: Transferable but NOT Shareable
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::Adt(tid, args) then
   # the EXPLICIT OPT-IN (the documented gate) — see derive_transferable.
    # Without the opt-in, a value containing the std-marked AffineHandle
    # (the execution-context-affine native handle) is NOT Shareable —
    # sharing an affine handle is sharing the execution context's
    # identity.
    if pointer_gate_holds(env, &ty, "UnsafeShareable") then
      true
    elsif type_contains_affine_handle(env, ty) then
      false
    elsif tid.id == env.lang_items.arc_strong || tid.id == env.lang_items.weak_arc then
      true  # the RECOGNIZED SYNCHRONIZED REPRESENTATION: the Arc is the sharing boundary (the walk stops — the interior is reached through the Arc's protocol)
    elsif tid.id == env.lang_items.rc || tid.id == env.lang_items.weak_rc then
      false  # the refcount is NOT synchronized
    elsif tid.id == env.lang_items.vec || tid.id == env.lang_items.map ||
          tid.id == env.lang_items.set || tid.id == env.lang_items.array then
      false  # the owned containers: Transferable but NOT Shareable (shared mutable state goes through Arc/Mutex/RwLock/atomics/channels)
    elsif tid.id == env.lang_items.box_ || tid.id == env.lang_items.unique_ptr then
      shareable_args_all(env, &args, visited)  # owned heap: shareable iff the pointee is
    else
      is_named_syncable(env, tid, args, visited)
    end
  when Type::RefInternal(inner, _) then derive_syncable(env, inner, visited)
  when Type::Tuple(elems) then
    for e in elems do
      if !derive_syncable(env, &e, visited) then return false end
    end
    true
  when Type::FnPtr(_, _, _) then true
  when Type::Closure(cid, _, _, captures, _) then
    # (the active lexical inout state): a closure with an inout capture
    # mutates lexical state — sharing it is a race — NOT Shareable.
    if closure_has_inout_capture(env, cid.id) then
      false
    else
      derive_syncable(env, &captures, visited)
    end
  when Type::Ptr(inner) then pointer_gate_holds(env, &inner, "UnsafeShareable")  # GATED: never automatic
  when Type::PtrMut(inner) then pointer_gate_holds(env, &inner, "UnsafeShareable")  # GATED: never automatic
  when Type::FixedArray(elem, _) then derive_syncable(env, &elem, visited)
  when Type::StaticStrPtr then true  # the static string view: immutable static bytes
  when Type::Dyn(_) then false  # Trait objects: conservative !Shareable
  when Type::Effect(_, inner) then derive_syncable(env, &inner, visited)
  when Type::Param(_) then true
  when Type::Var(_) then true
 # (inference-only): an integer literal is a scalar value —
  # Shareable exactly like the concrete integer types.
  when Type::IntLiteral(_) then true
  when Type::Never then true
  when Type::Error then true
  end  end
end

# All the generic args of an owned-heap type are Shareable (the
# Box/UniquePtr arm of the Adt walk).
def shareable_args_all(inout env: TypeEnv, args: Vec[Type], inout visited: Set[Int]) -> Bool
  var ok = true
  for a in args do
    if !derive_syncable(env, &a, visited) then ok = false end
  end
  ok
end

# Named-type structural derivation (Shareable): fields/variants/args walk
# (as above). The Rc exclusion is the LangItems TypeId — never the name;
# the std declares no Cell/RefCell/UnsafeCell (interior mutability without
# synchronization has no representation in this std — a future one must
# be recognized by LangItems id, never by name).
def is_named_syncable(inout env: TypeEnv, tid: TypeId, args: Vec[Type], inout visited: Set[Int]) -> Bool
  match get_type_by_id_ref(env, tid)
  when Option::Some(td) then
    if tid.id == env.lang_items.rc || tid.id == env.lang_items.weak_rc then
      return false
    end
    if visited.contains(&tid.id) then
      return true
    end
    visited.insert(tid.id)
    var ok = true
    match td.def_kind
    when TypeDefKind::Struct(fields) then
      for field in fields do
        let f_ty = subst_type_args(&field.ty, &td.generic_params, args)
        if !derive_syncable(env, &f_ty, visited) then ok = false end
      end
    when TypeDefKind::Enum(variants) then
      for variant in variants do
        for f in variant.fields do
          let v_ty = subst_type_args(&f, &td.generic_params, args)
          if !derive_syncable(env, &v_ty, visited) then ok = false end
        end
      end
    when _ then ()
    end
    for arg in args do
      if !derive_syncable(env, &arg, visited) then ok = false end
    end
    visited.remove(&tid.id)
    ok
  when Option::None then true
  end  end
end

# The checker's bound-resolution helpers (the `[T: Transferable]`-class
# bounds): check that a type satisfies the Transferable bound at a usage
# site (e.g., thread::spawn) — the compiler-derived property, never a
# marker impl.
def check_transferable_bound(inout env: TypeEnv, ty: Type, span: Span, context: String) -> Unit
  if !is_send(env, ty) then
    env.errors.push(TypeError {
      message: context + ": type `" + type_display(env, ty) + "` does not satisfy `Transferable` bound — " +
               "cannot be transferred into another execution context",
      span: span,
      code: Option::Some("E0277")
    })
  end
end

# Check that a type satisfies the Shareable bound (safe simultaneous
# access through a shared representation).
def check_shareable_bound(inout env: TypeEnv, ty: Type, span: Span, context: String) -> Unit
  if !is_sync(env, ty) then
    env.errors.push(TypeError {
      message: context + ": type `" + type_display(env, ty) + "` does not satisfy `Shareable` bound — " +
               "cannot be safely shared across execution contexts (use Arc/Mutex/RwLock/atomics/channels)",
      span: span,
      code: Option::Some("E0277")
    })
  end
end

def type_display(env: TypeEnv, ty: Type) -> String
  match ty
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Char then "Char"
  when Type::String then "String"
  when Type::I8 then "i8"
  when Type::I16 then "i16"
  when Type::I32 then "i32"
  when Type::I64 then "i64"
  when Type::I128 then "i128"
  when Type::U8 then "u8"
  when Type::U16 then "u16"
  when Type::U32 then "u32"
  when Type::U64 then "u64"
  when Type::U128 then "u128"
  when Type::ISize then "isize"
  when Type::USize then "usize"
  when Type::F32 then "f32"
  when Type::F64 then "f64"
  when Type::Never then "Never"
  when Type::IntLiteral(v) then "IntLiteral(" + v.to_string() + ")"
  when Type::Adt(tid, args) then
    # The Adt form of a builtin compound displays as its builtin name (the
    # LangItems TypeId selects the identity); user-defined Adt types display
    # the id.
    var s = "Type#" + tid.id.to_string()
    if !args.is_empty() then
      s = s + "["
      var first = true
      for a in args do
        if !first then s = s + ", " end
        s = s + type_display(env, a)
        first = false
      end
      s = s + "]"
    end
    if tid.id == env.lang_items.option && args.len() >= 1 then "Option[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.result && args.len() >= 2 then "Result[" + type_display(env, &args[0]) + ", " + type_display(env, &args[1]) + "]"
    elsif tid.id == env.lang_items.map && args.len() >= 2 then "Map[" + type_display(env, &args[0]) + ", " + type_display(env, &args[1]) + "]"
    elsif tid.id == env.lang_items.set && args.len() >= 1 then "Set[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.slice && args.len() >= 1 then "UnsafeSlice[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.array && args.len() >= 1 then
      # The heap-vector Adt form carries no count (the size lives in the
      # distinct FixedArray variant); display as the element container.
      "[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.box_ && args.len() >= 1 then "Box[" + type_display(env, &args[0]) + "]"
    elsif tid.id == env.lang_items.rc && args.len() >= 1 then "Rc[" + type_display(env, &args[0]) + "]"
    else s
    end
  when Type::FixedArray(elem, n) then "[" + type_display(env, &elem) + "; " + n.to_string() + "]"
  when Type::Ptr(inner) then "Ptr[" + type_display(env, inner) + "]"
  when Type::PtrMut(inner) then "PtrMut[" + type_display(env, inner) + "]"
  when Type::Dyn(did) then "dyn Type#" + did.id.to_string()
  when Type::Effect(effs, inner) then
 # (EffectId domain): display renders the registry's NAMES for the
    # interned effect ids (diagnostics); an id the registry never interned
    # renders as "e<id>".
    var eff_names = Vec::new()
    for eid in effs do
      match effect_name_of_id(&env.effects, &eid)
      when Option::Some(n) then eff_names.push(n.clone())
      when Option::None then eff_names.push("e" + eid.id.to_string())
      end
    end
    "Effect[" + eff_names.join(", ") + "] " + type_display(env, inner)
  when Type::FnPtr(params, ret, _) then
    var s = "fn("
    var first = true
    for p in params do
      if !first then s = s + ", " end
      s = s + type_display(env, &p.ty)
      first = false
    end
    s = s + ") -> " + type_display(env, ret)
    s
  when Type::Closure(cid, params, ret, captures, _) then
    var s = "closure#" + cid.id.to_string() + "("
    var first = true
    for p in params do
      if !first then s = s + ", " end
      s = s + type_display(env, &p.ty)
      first = false
    end
    s = s + ") -> " + type_display(env, ret)
    s = s + " captures: " + type_display(env, &captures)
    s
  when Type::RefInternal(inner, mutable) then
    if mutable then "&mut " + type_display(env, inner) else "&" + type_display(env, inner) end
  when Type::Tuple(elems) then
    var s = "("
    var first = true
    for e in elems do
      if !first then s = s + ", " end
      s = s + type_display(env, e)
      first = false
    end
    s + ")"
  when Type::Var(vid) then "?T" + vid.id.to_string()
  when Type::Param(gpid) then generic_param_name_of(&env.generic_param_table, &gpid)
  when Type::Error then "<error>"
  end  end
end
