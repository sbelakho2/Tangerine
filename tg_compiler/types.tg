# Tangerine Compiler — Type System
# Self-hosting compiler written in Tangerine
#
# Complete type system with:
# - Type inference (Hindley-Milner style)
# - Generic types with bounds
# - Ownership and borrowing types
# - Lifetime inference
# - Effect types

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use std::fs::{read_file}
use tg_compiler::token::{Span}
use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::ast::{
  Program, Item, ItemKind, FunctionDecl, StructDecl, EnumDecl, TraitDecl, ImplDecl,
  UseDecl, AstPath, ExternItem,
  TypeExpr, TypeExprKind, Param, ParamModifier, GenericParam,
  Block, Stmt, StmtKind, Expr, ExprKind, Pattern, PatternKind
}

# ———————————————————————————————————————————————————————————————
# Type Representation
# ———————————————————————————————————————————————————————————————

enum Type
  # Primitive types
  Unit
  Bool
  Int
  UInt
  Float
  Char
  String
  Never
  
  # Sized integer types for FFI parity
  I8
  I16
  I32
  I64
    I128
  U8
  U16
  U32
  U64
    U128
    ISize
    USize
  F32
  F64
  
  # Named type with resolved type arguments
  Named(TypeId, Vec[Type])
  
  # Function type
  Function(Vec[Type], Type)
  
  # Reference types (ownership model)
  Ref(Type, Lifetime)
  RefMut(Type, Lifetime)
  Owned(Type)
  
  # Smart pointer and raw pointer types
  Ptr(Type)     # Raw pointer *T
  PtrMut(Type)  # Mutable raw pointer *mut T
  Box(Type)     # Owned heap allocation
  Rc(Type)      # Reference counted
  
  # Trait object types
  Dyn(TypeId)   # Dynamic trait object dyn Trait
  
  # Effect types
  Effect(Vec[String], Type)  # Effect type: effect[Io, Net] T
  
  # Tuple and array
  Tuple(Vec[Type])
  Array(Type, Int)
  Slice(Type)
  
  # Built-in generic types (Rust parity)
  Option(Type)
  Result(Type, Type)
  Map(Type, Type)
  Set(Type)
  
  # Type variables (for inference)
  Var(TypeVarId)
  
  # Generic parameter
  Param(String)
  
  # Error type (for error recovery)
  Error
end

struct TypeId
  id: Int
end

struct TypeVarId
  id: Int
end

struct Lifetime
  id: Int
  name: String
end

def lifetime_static() -> Lifetime
  Lifetime { id: 0, name: "'static" }
end

def lifetime_anonymous() -> Lifetime
  Lifetime { id: -1, name: "'_" }
end

# ———————————————————————————————————————————————————————————————
# Type Definitions
# ———————————————————————————————————————————————————————————————

struct TypeDef
  id: TypeId
  name: String
  kind: TypeDefKind
  generic_params: Vec[String]
end

enum TypeDefKind
  Struct(Vec[FieldInfo])
  Enum(Vec[VariantInfo])
  Trait(Vec[MethodSig])
  Alias(Type)
  Primitive
  Opaque  # Built-in types with special semantics (Ptr, Box, Rc, etc.)
end

struct FieldInfo
  name: String
  ty: Type
  is_public: Bool
end

struct VariantInfo
  name: String
  fields: Vec[Type]
  discriminant: Int
end

struct MethodSig
  name: String
  params: Vec[Type]
  ret_type: Type
  is_method: Bool
  param_types: Vec[Type]
  return_type: Type
end

# ———————————————————————————————————————————————————————————————
# Type Environment
# ———————————————————————————————————————————————————————————————

struct TypeEnv
  types: Map[String, TypeDef]
  type_list: Vec[TypeDef]          # All type defs for safe iteration (Map iter is broken in codegen)
  type_id_counter: Int
  
  # Type variable substitution
  subst: Map[TypeVarId, Type]
  var_counter: Int
  
  # Scoped bindings
  scopes: Vec[Map[String, Type]]
  
  # Lifetime tracking
  lifetime_counter: Int
  current_lifetime: Lifetime
  
  # Trait implementations
  impls: Vec[ImplInfo]
  method_index: Map[String, Vec[Type]]  # method_name -> return types for O(1) lookup
  
  # Send/Sync negative impls
  non_send_types: Set[String]
  non_sync_types: Set[String]
  
  # Diagnostics
  errors: Vec[TypeError]
  warnings: Vec[TypeError]
end

struct ImplInfo
  trait_name: String
  for_type: Type
  methods: Vec[MethodInfo]
end

struct MethodInfo
  name: String
  ret_type: Type
  params: Vec[Type]
end

struct TypeError
  message: String
  span: Span
  code: Option[String]
end

def type_env_new() -> TypeEnv
  mut env = TypeEnv {
    types: Map::new(),
    type_list: Vec::new(),
    type_id_counter: 100,
    subst: Map::new(),
    var_counter: 0,
    scopes: Vec::new(),
    lifetime_counter: 1,
    current_lifetime: lifetime_static(),
    impls: Vec::new(),
    method_index: Map::new(),
    non_send_types: Set::new(),
    non_sync_types: Set::new(),
    errors: Vec::new(),
    warnings: Vec::new()
  }
  
  # Register types that are !Send / !Sync
  env.non_send_types.insert("Rc".to_string())
  env.non_sync_types.insert("Rc".to_string())
  env.non_sync_types.insert("Cell".to_string())
  env.non_sync_types.insert("RefCell".to_string())
  env.non_sync_types.insert("UnsafeCell".to_string())
  
  # Register primitive types
  register_primitive(&mut env, "Unit")
  register_primitive(&mut env, "Bool")
  register_primitive(&mut env, "Int")
  register_primitive(&mut env, "UInt")
  register_primitive(&mut env, "Float")
  register_primitive(&mut env, "Char")
  register_primitive(&mut env, "String")
  register_primitive(&mut env, "Never")
  
  # Register sized integer types
  register_primitive(&mut env, "i8")
  register_primitive(&mut env, "i16")
  register_primitive(&mut env, "i32")
  register_primitive(&mut env, "i64")
    register_primitive(&mut env, "i128")
  register_primitive(&mut env, "u8")
  register_primitive(&mut env, "u16")
  register_primitive(&mut env, "u32")
  register_primitive(&mut env, "u64")
    register_primitive(&mut env, "u128")
    register_primitive(&mut env, "isize")
    register_primitive(&mut env, "usize")
  register_primitive(&mut env, "f32")
  register_primitive(&mut env, "f64")
  
  # Register smart pointer types
  register_builtin_generic(&mut env, "Ptr", 1, TypeDefKind::Opaque)
  register_builtin_generic(&mut env, "PtrMut", 1, TypeDefKind::Opaque)
  register_builtin_generic(&mut env, "Box", 1, TypeDefKind::Opaque)
  register_builtin_generic(&mut env, "Rc", 1, TypeDefKind::Opaque)
  
  # Register built-in generic types (Rust parity)
  register_builtin_generic(&mut env, "Option", 1,
    TypeDefKind::Enum([
      VariantInfo { name: "Some", fields: [Type::Param("T")], discriminant: 0 },
      VariantInfo { name: "None", fields: Vec::new(), discriminant: 1 }
    ]))
  register_builtin_generic(&mut env, "Result", 2,
    TypeDefKind::Enum([
      VariantInfo { name: "Ok", fields: [Type::Param("T")], discriminant: 0 },
      VariantInfo { name: "Err", fields: [Type::Param("E")], discriminant: 1 }
    ]))
  register_builtin_generic(&mut env, "Vec", 1,
    TypeDefKind::Struct([
      FieldInfo { name: "ptr", ty: Type::Param("T"), is_public: false },
      FieldInfo { name: "len", ty: Type::Int, is_public: true },
      FieldInfo { name: "cap", ty: Type::Int, is_public: false }
    ]))
  register_builtin_generic(&mut env, "Map", 2,
    TypeDefKind::Struct(Vec::new()))
  register_builtin_generic(&mut env, "Set", 1,
    TypeDefKind::Struct(Vec::new()))
  
  # Register built-in traits (Rust parity)
  register_builtin_trait(&mut env, "Copy", Vec::new())
  register_builtin_trait(&mut env, "Drop", [
    MethodSig { name: "drop", params: Vec::new(), ret_type: Type::Unit, is_method: true, param_types: Vec::new(), return_type: Type::Unit }
  ])
  register_builtin_trait(&mut env, "Clone", [
    MethodSig { name: "clone", params: Vec::new(), ret_type: Type::Param("Self"), is_method: true, param_types: Vec::new(), return_type: Type::Param("Self") }
  ])
  register_builtin_trait(&mut env, "Display", [
    MethodSig { name: "to_string", params: Vec::new(), ret_type: Type::String, is_method: true, param_types: Vec::new(), return_type: Type::String }
  ])
  register_builtin_trait(&mut env, "Debug", [
    MethodSig { name: "debug_string", params: Vec::new(), ret_type: Type::String, is_method: true, param_types: Vec::new(), return_type: Type::String }
  ])
  register_builtin_trait(&mut env, "Iterator", [
    MethodSig { name: "next", params: Vec::new(), ret_type: Type::Option(Type::Param("Item")), is_method: true, param_types: Vec::new(), return_type: Type::Option(Type::Param("Item")) }
  ])
  register_builtin_trait(&mut env, "Send", Vec::new())
  register_builtin_trait(&mut env, "Sync", Vec::new())
  register_builtin_trait(&mut env, "Eq", [
    MethodSig { name: "eq", params: [Type::Param("Self")], ret_type: Type::Bool, is_method: true, param_types: [Type::Param("Self")], return_type: Type::Bool }
  ])
  register_builtin_trait(&mut env, "Ord", [
    MethodSig { name: "cmp", params: [Type::Param("Self")], ret_type: Type::Int, is_method: true, param_types: [Type::Param("Self")], return_type: Type::Int }
  ])
  register_builtin_trait(&mut env, "Hash", [
    MethodSig { name: "hash", params: Vec::new(), ret_type: Type::Int, is_method: true, param_types: Vec::new(), return_type: Type::Int }
  ])
  register_builtin_trait(&mut env, "Default", [
    MethodSig { name: "default", params: Vec::new(), ret_type: Type::Param("Self"), is_method: false, param_types: Vec::new(), return_type: Type::Param("Self") }
  ])
  register_builtin_trait(&mut env, "Into", [
    MethodSig { name: "into", params: Vec::new(), ret_type: Type::Param("T"), is_method: true, param_types: Vec::new(), return_type: Type::Param("T") }
  ])
  register_builtin_trait(&mut env, "From", [
    MethodSig { name: "from", params: [Type::Param("T")], ret_type: Type::Param("Self"), is_method: false, param_types: [Type::Param("T")], return_type: Type::Param("Self") }
  ])
  
  env
end

def register_primitive(env: &mut TypeEnv, name: String) -> Unit
  let id_num = env.type_id_counter
  let id = TypeId { id: id_num }
  env.type_id_counter = env.type_id_counter + 1
  let td = TypeDef {
    id: id,
    name: name.clone(),
    kind: TypeDefKind::Primitive,
    generic_params: Vec::new()
  }
  env.types.insert(name, td)
  env.type_list.push(td)
end

def register_builtin_generic(env: &mut TypeEnv, name: String, arity: Int, kind: TypeDefKind) -> Unit
  let id_num = env.type_id_counter
  let id = TypeId { id: id_num }
  env.type_id_counter = env.type_id_counter + 1
  mut gen_params = Vec::new()
  if arity >= 1 then gen_params.push("T") end
  if arity >= 2 then gen_params.push("V") end
  if arity >= 3 then gen_params.push("E") end
  let td = TypeDef {
    id: id,
    name: name.clone(),
    kind: kind,
    generic_params: gen_params
  }
  env.types.insert(name, td)
  env.type_list.push(td)
end

def register_builtin_trait(env: &mut TypeEnv, name: String, methods: Vec[MethodSig]) -> Unit
  let id_num = env.type_id_counter
  let id = TypeId { id: id_num }
  env.type_id_counter = env.type_id_counter + 1
  let td = TypeDef {
    id: id,
    name: name.clone(),
    kind: TypeDefKind::Trait(methods),
    generic_params: Vec::new()
  }
  env.types.insert(name, td)
  env.type_list.push(td)
end

# Helper to get type definition by TypeId
def get_type_by_id(env: &TypeEnv, tid: &TypeId) -> Option[TypeDef]
  mut i = 0
  while i < env.type_list.len() do
    let td = env.type_list[i]
    if td.id.id == tid.id then
      return Option::Some(td)
    end
    i = i + 1
  end
  Option::None
end

def get_type_id_by_name(env: &TypeEnv, name: String) -> Option[TypeId]
  mut i = 0
  while i < env.type_list.len() do
    let td = env.type_list[i]
    if td.name == name then
      return Option::Some(td.id)
    end
    i = i + 1
  end
  Option::None
end

def get_type_def_by_name(env: &TypeEnv, name: String) -> Option[TypeDef]
  mut i = 0
  while i < env.type_list.len() do
    let td = env.type_list[i]
    if td.name == name then
      return Option::Some(td)
    end
    i = i + 1
  end
  Option::None
end

def store_type_def(env: &mut TypeEnv, td: TypeDef) -> Unit
  env.types.insert(td.name, td)
  mut i = 0
  while i < env.type_list.len() do
    if env.type_list[i].id.id == td.id.id then
      env.type_list[i] = td
      return
    end
    i = i + 1
  end
  env.type_list.push(td)
end

# ———————————————————————————————————————————————————————————————
# Scope Management
# ———————————————————————————————————————————————————————————————

def push_scope(env: &mut TypeEnv) -> Unit
  env.scopes.push(Map::new())
end

def pop_scope(env: &mut TypeEnv) -> Unit
  env.scopes.pop()
  ()
end

def bind_var(env: &mut TypeEnv, name: String, ty: Type) -> Unit
  if !env.scopes.is_empty() then
    let idx = env.scopes.len() - 1
    env.scopes[idx].insert(name, ty)
  end
end

def lookup_var(env: &TypeEnv, name: String) -> Option[Type]
  mut i = env.scopes.len()
  while i > 0 do
    i = i - 1
    match env.scopes[i].get(&name)
    when Option::Some(ty) then return Option::Some(ty)
    when Option::None then ()
    end
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# Type Variable Operations
# ———————————————————————————————————————————————————————————————

def fresh_type_var(env: &mut TypeEnv) -> Type
  let id = TypeVarId { id: env.var_counter }
  env.var_counter = env.var_counter + 1
  Type::Var(id)
end

def resolve_type_var(env: &TypeEnv, ty: Type) -> Type
  match ty
  when Type::Var(id) then
    match env.subst.get(id)
    when Option::Some(resolved) then
      resolve_type_var(env, resolved)
    when Option::None then ty
    end
  # Recurse into compound types for full resolution
  when Type::Ref(inner, lt) then Type::Ref(resolve_type_var(env, inner), lt)
  when Type::RefMut(inner, lt) then Type::RefMut(resolve_type_var(env, inner), lt)
  when Type::Owned(inner) then Type::Owned(resolve_type_var(env, inner))
  when Type::Tuple(fields) then
    Type::Tuple(fields.map(|f| resolve_type_var(env, f)))
  when Type::Function(params, ret) then
    Type::Function(params.map(|p| resolve_type_var(env, p)), resolve_type_var(env, ret))
  when Type::Named(tid, args) then
    Type::Named(tid, args.map(|a| resolve_type_var(env, a)))
  when Type::Slice(inner) then Type::Slice(resolve_type_var(env, inner))
  when Type::Array(inner, n) then Type::Array(resolve_type_var(env, inner), n)
  when _ then ty
  end
end

# ———————————————————————————————————————————————————————————————
# Unification
# ———————————————————————————————————————————————————————————————

def unify(env: &mut TypeEnv, t1: Type, t2: Type, span: Span) -> Bool
  let a = resolve_type_var(env, t1)
  let b = resolve_type_var(env, t2)

  match a
  when Type::Var(id1) then
    match b
    when Type::Var(id2) then
      if id1.id == id2.id then
        true
      else
        env.subst.insert(id1, b)
        true
      end
    when _ then
      if occurs_check(env, id1, b, span.clone()) then
        type_add_error(env, "infinite type", span)
        false
      else
        env.subst.insert(id1, b)
        true
      end
    end
  when _ then
    match b
    when Type::Var(id2) then
      if occurs_check(env, id2, a, span.clone()) then
        type_add_error(env, "infinite type", span)
        false
      else
        env.subst.insert(id2, a)
        true
      end
    when _ then
      match a
      when Type::Unit then match b when Type::Unit then true when _ then type_add_error(env, "type mismatch", span); false end
      when Type::Bool then match b when Type::Bool then true when _ then type_add_error(env, "type mismatch", span); false end
      when Type::Int then match b when Type::Int then true when _ then type_add_error(env, "type mismatch", span); false end
      when Type::UInt then match b when Type::UInt then true when _ then type_add_error(env, "type mismatch", span); false end
      when Type::Float then match b when Type::Float then true when _ then type_add_error(env, "type mismatch", span); false end
      when Type::Char then match b when Type::Char then true when _ then type_add_error(env, "type mismatch", span); false end
      when Type::String then match b when Type::String then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::I8 then match b when Type::I8 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::I16 then match b when Type::I16 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::I32 then match b when Type::I32 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::I64 then match b when Type::I64 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::I128 then match b when Type::I128 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::U8 then match b when Type::U8 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::U16 then match b when Type::U16 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::U32 then match b when Type::U32 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::U64 then match b when Type::U64 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::U128 then match b when Type::U128 then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::ISize then match b when Type::ISize then true when _ then type_add_error(env, "type mismatch", span); false end
        when Type::USize then match b when Type::USize then true when _ then type_add_error(env, "type mismatch", span); false end
      when Type::Never then true
      when Type::Option(inner1) then
        match b
        when Type::Option(inner2) then unify(env, inner1, inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Result(ok1, err1) then
        match b
        when Type::Result(ok2, err2) then unify(env, ok1, ok2, span) && unify(env, err1, err2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Map(k1, v1) then
        match b
        when Type::Map(k2, v2) then unify(env, k1, k2, span) && unify(env, v1, v2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Set(inner1) then
        match b
        when Type::Set(inner2) then unify(env, inner1, inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Named(id1, args1) then
        match b
        when Type::Named(id2, args2) then
          if id1.id != id2.id then
            type_add_error(env, "type mismatch", span)
            false
          elsif args1.len() != args2.len() then
            type_add_error(env, "type argument count mismatch", span)
            false
          else
            mut ok = true
            mut i = 0
            while i < args1.len() do
              if !unify(env, args1[i], args2[i], span) then
                ok = false
              end
              i = i + 1
            end
            ok
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Function(params1, ret1) then
        match b
        when Type::Function(params2, ret2) then
          if params1.len() != params2.len() then
            type_add_error(env, "function parameter count mismatch", span)
            false
          else
            mut ok = true
            mut i = 0
            while i < params1.len() do
              if !unify(env, params1[i], params2[i], span) then
                ok = false
              end
              i = i + 1
            end
            if ok then unify(env, ret1, ret2, span) else false end
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Ref(t_inner1, l1) then
        match b
        when Type::Ref(t_inner2, l2) then
          if l1.id != l2.id && l1.id != -1 && l2.id != -1 then
            type_add_error(env, "lifetime mismatch: " + l1.name + " vs " + l2.name, span)
            false
          else
            unify(env, t_inner1, t_inner2, span)
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::RefMut(t_inner1, l1) then
        match b
        when Type::RefMut(t_inner2, l2) then
          if l1.id != l2.id && l1.id != -1 && l2.id != -1 then
            type_add_error(env, "lifetime mismatch: " + l1.name + " vs " + l2.name, span)
            false
          else
            unify(env, t_inner1, t_inner2, span)
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Tuple(elems1) then
        match b
        when Type::Tuple(elems2) then
          if elems1.len() != elems2.len() then
            type_add_error(env, "tuple length mismatch", span)
            false
          else
            mut ok = true
            mut i = 0
            while i < elems1.len() do
              if !unify(env, elems1[i], elems2[i], span) then
                ok = false
              end
              i = i + 1
            end
            ok
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Array(t_inner1, n1) then
        match b
        when Type::Array(t_inner2, n2) then
          if n1 != n2 then
            type_add_error(env, "array size mismatch", span)
            false
          else
            unify(env, t_inner1, t_inner2, span)
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Slice(t_inner1) then
        match b
        when Type::Slice(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Owned(t_inner1) then
        match b
        when Type::Owned(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Box(t_inner1) then
        match b
        when Type::Box(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Rc(t_inner1) then
        match b
        when Type::Rc(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Ptr(t_inner1) then
        match b
        when Type::Ptr(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::PtrMut(t_inner1) then
        match b
        when Type::PtrMut(t_inner2) then unify(env, t_inner1, t_inner2, span)
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Dyn(id1) then
        match b
        when Type::Dyn(id2) then
          if id1.id == id2.id then true
          else
            type_add_error(env, "trait object type mismatch", span)
            false
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Effect(effs1, t_inner1) then
        match b
        when Type::Effect(effs2, t_inner2) then
          if effs1.len() != effs2.len() then
            type_add_error(env, "effect set mismatch", span)
            false
          else
            mut effects_match = true
            mut i = 0
            while i < effs1.len() do
              if effs1[i] != effs2[i] then
                effects_match = false
              end
              i = i + 1
            end
            if !effects_match then
              type_add_error(env, "effect set mismatch", span)
              false
            else
              unify(env, t_inner1, t_inner2, span)
            end
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Param(name1) then
        match b
        when Type::Param(name2) then
          if name1 == name2 then
            true
          else
            type_add_error(env, "type parameter mismatch: " + name1 + " vs " + name2, span)
            false
          end
        when Type::Error then true
        when _ then type_add_error(env, "type mismatch", span); false
        end
      when Type::Error then true
      end
    end
  end
end

def occurs_check(env: &mut TypeEnv, id: TypeVarId, ty: Type, span: Span) -> Bool
  # Use depth limit to prevent stack overflow on deeply recursive types
  occurs_check_with_depth(env, id, ty, 0, span)
end

# Maximum recursion depth for type checking (prevents stack overflow)
def MAX_TYPE_DEPTH() -> Int = 100

def occurs_check_with_depth(env: &mut TypeEnv, id: TypeVarId, ty: Type, depth: Int, span: Span) -> Bool
  # Guard against infinite recursion
  if depth > MAX_TYPE_DEPTH() then
    type_add_error(env, "type recursion depth exceeded in occurs check", span)
    return true
  end
  
  let resolved = resolve_type_var(env, ty)
  match resolved
  when Type::Var(other_id) then id.id == other_id.id
  when Type::Named(_, args) then
    mut found = false
    for arg in args do
      if occurs_check_with_depth(env, id, arg, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    found
  when Type::Function(params, ret) then
    mut found = false
    for p in params do
      if occurs_check_with_depth(env, id, p, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    if !found then
      found = occurs_check_with_depth(env, id, ret, depth + 1, span)
    end
    found
  when Type::Ref(inner, _) then occurs_check_with_depth(env, id, inner, depth + 1, span)
  when Type::RefMut(inner, _) then occurs_check_with_depth(env, id, inner, depth + 1, span)
  when Type::Tuple(elems) then
    mut found = false
    for e in elems do
      if occurs_check_with_depth(env, id, e, depth + 1, span.clone()) then
        found = true
        break
      end
    end
    found
  when Type::Array(elem, _) then occurs_check_with_depth(env, id, elem, depth + 1, span)
  when Type::Slice(elem) then occurs_check_with_depth(env, id, elem, depth + 1, span)
  when Type::Option(inner) then occurs_check_with_depth(env, id, inner, depth + 1, span)
  when Type::Result(ok, err) then
    occurs_check_with_depth(env, id, ok, depth + 1, span.clone()) || occurs_check_with_depth(env, id, err, depth + 1, span)
  when Type::Map(key, val) then
    occurs_check_with_depth(env, id, key, depth + 1, span.clone()) || occurs_check_with_depth(env, id, val, depth + 1, span)
  when Type::Set(inner) then occurs_check_with_depth(env, id, inner, depth + 1, span)
  when Type::Owned(inner) then occurs_check_with_depth(env, id, inner, depth + 1, span)
  when _ then false
  end
end

def type_add_error(env: &mut TypeEnv, msg: String, span: Span) -> Unit
  env.errors.push(TypeError { message: msg, span: span, code: Option::None })
end

def add_warning(env: &mut TypeEnv, msg: String, span: Span) -> Unit
  env.warnings.push(TypeError { message: msg, span: span, code: Option::None })
end

def add_error_with_code(env: &mut TypeEnv, msg: String, span: Span, code: String) -> Unit
  env.errors.push(TypeError { message: msg, span: span, code: Option::Some(code) })
end

# Stable error codes for type checking:
#   E0200 — Type mismatch
#   E0201 — Cannot unify types (occurs check failed)
#   E0202 — Expected type, found expression
#   E0203 — Undefined type
#   E0204 — Undefined variable
#   E0205 — Undefined function
#   E0206 — Argument count mismatch
#   E0207 — Cannot call non-function
#   E0208 — Cannot index non-array
#   E0209 — Cannot access field on non-struct
#   E0210 — Undefined field
#   E0211 — Pattern type mismatch
#   E0212 — Cannot infer type
#   E0213 — Generic argument count mismatch
#   E0214 — Conflicting implementations
#   E0215 — Trait not implemented
#   E0216 — Ambiguous method call
#   E0217 — Return type mismatch
#   E0218 — Condition must be Bool
#   E0219 — Loop condition must be Bool
#   E0277 — Trait bound not satisfied (Send/Sync)

# ———————————————————————————————————————————————————————————————
# Type Checking
# ———————————————————————————————————————————————————————————————

def type_check_program_env(env: &mut TypeEnv, program: &Program) -> Unit
  # Push a global scope for top-level bindings
  push_scope(env)
  
  # Pre-register pass: register all type names for forward reference support
  eprint("[types] prereg\n")
  mut i = 0
  while i < program.items.len() do
    let item = &program.items[i]
    pre_register_type_name(env, item)
    i = i + 1
  end
  
  # First pass: collect type definitions (fields, variants, etc.)
  eprint("[types] collect\n")
  i = 0
  while i < program.items.len() do
    let item = &program.items[i]
    collect_type_def(env, item)
    i = i + 1
  end
  
  # Second pass: register function signatures so calls resolve
  eprint("[types] sigs\n")
  i = 0
  while i < program.items.len() do
    let item = &program.items[i]
    match item.kind.clone()
    when ItemKind::ItemFunction(f) then
      mut param_types = Vec::new()
      mut j = 0
      while j < f.params.len() do
        let p = f.params[j]
        match p.ty
        when Option::Some(ty_expr) then param_types.push(resolve_type_expr(env, &ty_expr))
        when Option::None then param_types.push(fresh_type_var(env))
        end
        j = j + 1
      end
      let ret_ty = match f.ret_type
      when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
      when Option::None then Type::Unit
      end
      bind_var(env, f.name, Type::Function(param_types, ret_ty))
    when ItemKind::ItemExternBlock(ext) then
      mut j = 0
      while j < ext.items.len() do
        let ext_item = ext.items[j]
        match ext_item
        when ExternItem::Function(ef) then
          mut param_types = Vec::new()
          mut k = 0
          while k < ef.params.len() do
            let p = ef.params[k]
            match p.ty
            when Option::Some(ty_expr) then param_types.push(resolve_type_expr(env, &ty_expr))
            when Option::None then param_types.push(fresh_type_var(env))
            end
            k = k + 1
          end
          let ret_ty = match ef.ret_type
          when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
          when Option::None then Type::Unit
          end
          bind_var(env, ef.name, Type::Function(param_types, ret_ty))
        when _ then ()
        end
        j = j + 1
      end
    when _ then ()
    end
    i = i + 1
  end
  
  # Third pass: check all items
  eprint("[types] items\n")
  i = 0
  while i < program.items.len() do
    let item = &program.items[i]
    eprint("[types] check item\n")
    check_item(env, item)
    i = i + 1
  end
  
  pop_scope(env)
end

def pre_register_type_name(env: &mut TypeEnv, item: &Item) -> Unit
  match item.kind.clone()
  when ItemKind::ItemStruct(s) then
    if !env.types.contains_key(s.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: s.name,
        kind: TypeDefKind::Struct(Vec::new()),
        generic_params: Vec::new()
      }
      env.types.insert(s.name, td)
      env.type_list.push(td)
    end
  when ItemKind::ItemEnum(e) then
    if !env.types.contains_key(e.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: e.name,
        kind: TypeDefKind::Enum(Vec::new()),
        generic_params: Vec::new()
      }
      env.types.insert(e.name, td)
      env.type_list.push(td)
    end
  when ItemKind::ItemTrait(t) then
    if !env.types.contains_key(t.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: t.name,
        kind: TypeDefKind::Trait(Vec::new()),
        generic_params: Vec::new()
      }
      env.types.insert(t.name, td)
      env.type_list.push(td)
    end
  when ItemKind::ItemTypeAlias(a) then
    if !env.types.contains_key(a.name) then
      let id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      let td = TypeDef {
        id: id,
        name: a.name,
        kind: TypeDefKind::Alias(Type::Unit),
        generic_params: Vec::new()
      }
      env.types.insert(a.name, td)
      env.type_list.push(td)
    end
  when _ then ()
  end
end

def collect_type_def(env: &mut TypeEnv, item: &Item) -> Unit
  match item.kind.clone()
  when ItemKind::ItemStruct(s) then
    # Reuse pre-registered ID if available
    let id = match get_type_id_by_name(env, s.name)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    mut fields = Vec::new()
    mut i = 0
    while i < s.fields.len() do
      let f = s.fields[i]
      let ty = resolve_type_expr(env, &f.ty)
      fields.push(FieldInfo { name: f.name, ty: ty, is_public: true })
      i = i + 1
    end
    mut gen_params = Vec::new()
    i = 0
    while i < s.generic_params.len() do
      let gp = s.generic_params[i]
      gen_params.push(gp.name)
      i = i + 1
    end
    let td = TypeDef {
      id: id,
      name: s.name,
      kind: TypeDefKind::Struct(fields),
      generic_params: gen_params
    }
    store_type_def(env, td)
  when ItemKind::ItemEnum(e) then
    let id = match get_type_id_by_name(env, e.name)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    mut variants = Vec::new()
    mut disc = 0
    mut i = 0
    while i < e.variants.len() do
      let v = e.variants[i]
      mut ftypes = Vec::new()
      mut j = 0
      while j < v.fields.len() do
        let ft = v.fields[j]
        ftypes.push(resolve_type_expr(env, &ft))
        j = j + 1
      end
      variants.push(VariantInfo { name: v.name, fields: ftypes, discriminant: disc })
      disc = disc + 1
      i = i + 1
    end
    mut gen_params = Vec::new()
    i = 0
    while i < e.generic_params.len() do
      let gp = e.generic_params[i]
      gen_params.push(gp.name)
      i = i + 1
    end
    let td = TypeDef {
      id: id,
      name: e.name,
      kind: TypeDefKind::Enum(variants),
      generic_params: gen_params
    }
    store_type_def(env, td)
  when ItemKind::ItemTrait(t) then
    let id = match get_type_id_by_name(env, t.name)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    mut methods = Vec::new()
    mut i = 0
    while i < t.methods.len() do
      let m = t.methods[i]
      mut param_types = Vec::new()
      mut j = 0
      while j < m.sig.params.len() do
        let p = m.sig.params[j]
        match p.ty
        when Option::Some(ty_expr) then
          param_types.push(resolve_type_expr(env, &ty_expr))
        when Option::None then
          param_types.push(fresh_type_var(env))
        end
        j = j + 1
      end
      let ret_ty = match m.sig.ret_type
      when Option::Some(ret_expr) then resolve_type_expr(env, &ret_expr)
      when Option::None then Type::Unit
      end
      methods.push(MethodSig {
        name: m.sig.name,
        params: param_types.clone(),
        ret_type: ret_ty.clone(),
        is_method: true,
        param_types: param_types,
        return_type: ret_ty
      })
      i = i + 1
    end
    let td = TypeDef {
      id: id,
      name: t.name,
      kind: TypeDefKind::Trait(methods),
      generic_params: Vec::new()
    }
    store_type_def(env, td)
  when ItemKind::ItemTypeAlias(ta) then
    let id = match get_type_id_by_name(env, ta.name)
    when Option::Some(existing_id) then existing_id
    when Option::None then
      let new_id = TypeId { id: env.type_id_counter }
      env.type_id_counter = env.type_id_counter + 1
      new_id
    end
    let aliased_type = resolve_type_expr(env, &ta.ty)
    let td = TypeDef {
      id: id,
      name: ta.name,
      kind: TypeDefKind::Alias(aliased_type),
      generic_params: Vec::new()
    }
    store_type_def(env, td)
  when _ then ()
  end
end

def check_item(env: &mut TypeEnv, item: &Item) -> Unit
  match item.kind.clone()
  when ItemKind::ItemFunction(f) then
    check_function(env, &f)
  when ItemKind::ItemImpl(i) then
    check_impl(env, &i)
  when _ then ()
  end
end

def check_function(env: &mut TypeEnv, f: &FunctionDecl) -> Unit
  eprint("[types] function enter\n")
  push_scope(env)
  
  # Bind parameters
  mut i = 0
  while i < f.params.len() do
    let p = f.params[i]
    let ty = match p.ty
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then fresh_type_var(env)
    end
    bind_var(env, p.name, ty)
    i = i + 1
  end
  
  # Get expected return type
  eprint("[types] function ret\n")
  let ret_type = match f.ret_type
  when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
  when Option::None then Type::Unit
  end
  
  # Check body
  match f.body
  when FnBody::FnBlock(block) then
    eprint("[types] function block\n")
    let body_type = check_block(env, &block)
    eprint("[types] function unify\n")
    unify(env, body_type, ret_type, f.span)
  when FnBody::FnExpr(expr) then
    eprint("[types] function expr\n")
    let expr_type = check_expr(env, &expr)
    eprint("[types] function unify\n")
    unify(env, expr_type, ret_type, expr.span)
  when _ then ()
  end
  
  pop_scope(env)
  eprint("[types] function exit\n")
end

def check_impl(env: &mut TypeEnv, i: &ImplDecl) -> Unit
  let self_type = resolve_type_expr(env, &i.for_type)
  mut method_index = 0
  while method_index < i.methods.len() do
    let m = i.methods[method_index]
    push_scope(env)

    # Bind parameters — use self_type for any param named "self"
    mut param_index = 0
    while param_index < m.params.len() do
      let p = m.params[param_index]
      let ty = if p.name == "self" then
        match p.modifier
        when Option::Some(ParamModifier::Ref) then Type::Ref(self_type, lifetime_anonymous())
        when Option::Some(ParamModifier::RefMut) then Type::RefMut(self_type, lifetime_anonymous())
        when _ then self_type
        end
      else
        match p.ty
        when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
        when Option::None then fresh_type_var(env)
        end
      end
      bind_var(env, p.name, ty)
      param_index = param_index + 1
    end

    # Expected return type
    let ret_type = match m.ret_type
    when Option::Some(ty_expr) then resolve_type_expr(env, &ty_expr)
    when Option::None then Type::Unit
    end

    # Check body
    match m.body
    when FnBody::FnBlock(block) then
      let body_type = check_block(env, &block)
      unify(env, body_type, ret_type, m.span)
    when FnBody::FnExpr(expr) then
      let expr_type = check_expr(env, &expr)
      unify(env, expr_type, ret_type, expr.span)
    when _ then ()
    end

    pop_scope(env)
    method_index = method_index + 1
  end
end

# ———————————————————————————————————————————————————————————————
# Block and Statement Type Checking
# ———————————————————————————————————————————————————————————————

def check_block(env: &mut TypeEnv, block: &Block) -> Type
  push_scope(env)
  
  mut result_type = Type::Unit
  mut i = 0
  while i < block.stmts.len() do
    let stmt = block.stmts[i]
    result_type = check_stmt(env, &stmt)
    i = i + 1
  end
  
  pop_scope(env)
  result_type
end

def check_stmt(env: &mut TypeEnv, stmt: &Stmt) -> Type
  match stmt.kind
  when StmtKind::StmtLet(pattern, ty_opt, value, is_mut) then
    let value_type = check_expr(env, &value)
    let var_type = match ty_opt
    when Option::Some(ty_expr) then
      let declared = resolve_type_expr(env, &ty_expr)
      unify(env, value_type, declared, stmt.span)
      declared
    when Option::None then
      value_type
    end
    check_pattern(env, &pattern, var_type)
    Type::Unit
  when StmtKind::StmtAssign(target, value) then
    let target_type = check_expr(env, &target)
    let value_type = check_expr(env, &value)
    unify(env, target_type, value_type, stmt.span)
    Type::Unit
  when StmtKind::StmtIf(if_stmt) then
    check_if_stmt(env, &if_stmt)
  when StmtKind::StmtWhile(cond, body) then
    let cond_type = check_expr(env, &cond)
    unify(env, cond_type, Type::Bool, cond.span)
    check_block(env, &body)
    Type::Unit
  when StmtKind::StmtFor(for_stmt) then
    push_scope(env)
    let iter_type = check_expr(env, &for_stmt.iter)
    let elem_type = fresh_type_var(env)
    check_pattern(env, &for_stmt.pattern, elem_type)
    check_block(env, &for_stmt.body)
    pop_scope(env)
    Type::Unit
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr(env, &val)
    when Option::None then Type::Unit
    end
    Type::Never
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(val) then check_expr(env, &val)
    when Option::None then Type::Unit
    end
    Type::Never
  when StmtKind::StmtContinue then
    Type::Never
  when StmtKind::StmtExpr(expr) then
    check_expr(env, &expr)
  when StmtKind::StmtMatch(m) then
    check_match(env, &m)
  when StmtKind::StmtUnsafe(_, body) then
    check_block(env, &body)
  when StmtKind::StmtDefer(body) then
    check_block(env, &body)
    Type::Unit
  when StmtKind::StmtTry(body, catches, finally_block) then
    let body_type = check_block(env, &body)
    mut i = 0
    while i < catches.len() do
      let c = catches[i]
      push_scope(env)
      check_pattern(env, &c.pattern, Type::Error)
      check_block(env, &c.body)
      pop_scope(env)
      i = i + 1
    end
    match finally_block
    when Option::Some(fb) then check_block(env, &fb)
    when Option::None then ()
    end
    body_type
  when StmtKind::StmtLoop(body) then
    check_block(env, &body)
    Type::Unit
  when StmtKind::StmtGuard(cond, else_action) then
    let cond_type = check_expr(env, &cond)
    unify(env, cond_type, Type::Bool, cond.span)
    match else_action
    when GuardElse::Return(ret_opt) then
      match ret_opt
      when Option::Some(ret_expr) then
        check_expr(env, &ret_expr)
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(br_opt) then
      match br_opt
      when Option::Some(br_expr) then
        check_expr(env, &br_expr)
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
    Type::Unit
  when StmtKind::StmtHandleWith(expr, handlers) then
    let _handled_ty = check_expr(env, &expr)
    mut i = 0
    while i < handlers.len() do
      let h = handlers[i]
      mut j = 0
      while j < h.arms.len() do
        let arm = h.arms[j]
        push_scope(env)
        mut k = 0
        while k < arm.params.len() do
          let param_name = arm.params[k]
          bind_var(env, param_name, fresh_type_var(env))
          k = k + 1
        end
        check_block(env, &arm.body)
        pop_scope(env)
        j = j + 1
      end
      i = i + 1
    end
    Type::Unit
  when _ then Type::Unit
  end
end

def check_if_stmt(env: &mut TypeEnv, if_stmt: &IfStmt) -> Type
  let cond_type = check_expr(env, &if_stmt.cond)
  unify(env, cond_type, Type::Bool, if_stmt.cond.span)
  
  let then_type = check_block(env, &if_stmt.then_block)
  
  mut result_type = then_type
  
  mut i = 0
  while i < if_stmt.elsif_branches.len() do
    let (econd, ebody) = if_stmt.elsif_branches[i]
    let ec_type = check_expr(env, &econd)
    unify(env, ec_type, Type::Bool, econd.span)
    let eb_type = check_block(env, &ebody)
    unify(env, result_type, eb_type, ebody.span)
    i = i + 1
  end
  
  match if_stmt.else_block
  when Option::Some(else_block) then
    let else_type = check_block(env, &else_block)
    unify(env, result_type, else_type, else_block.span)
  when Option::None then
    unify(env, result_type, Type::Unit, if_stmt.span)
  end
  
  result_type
end

def vec_contains_string(items: &Vec[String], value: String) -> Bool
  mut i = 0
  while i < items.len() do
    if items[i] == value then
      return true
    end
    i = i + 1
  end
  false
end

def check_match(env: &mut TypeEnv, m: &MatchExpr) -> Type
  let scrutinee_type = check_expr(env, &m.scrutinee)
  
  mut result_type = fresh_type_var(env)
  mut has_wildcard = false
  mut covered_variants = Vec::new()
  
  mut i = 0
  while i < m.arms.len() do
    let arm = m.arms[i]
    push_scope(env)
    check_pattern(env, &arm.pattern, scrutinee_type)

    match arm.pattern.kind
    when PatternKind::Wildcard then
      has_wildcard = true
    when PatternKind::Variant(path, _) then
      if path.segments.len() > 0 then
        let variant_name = path.segments[path.segments.len() - 1]
        if !vec_contains_string(&covered_variants, variant_name) then
          covered_variants.push(variant_name)
        end
      end
    when PatternKind::Or(alts) then
      mut j = 0
      while j < alts.len() do
        match alts[j].kind
        when PatternKind::Wildcard then
          has_wildcard = true
        when PatternKind::Variant(path, _) then
          if path.segments.len() > 0 then
            let variant_name = path.segments[path.segments.len() - 1]
            if !vec_contains_string(&covered_variants, variant_name) then
              covered_variants.push(variant_name)
            end
          end
        when _ then ()
        end
        j = j + 1
      end
    when _ then ()
    end
    
    match arm.guard_expr
        when Option::Some(guard_expr) then
          let guard_type = check_expr(env, &guard_expr)
          unify(env, guard_type, Type::Bool, guard_expr.span)
    when Option::None then ()
    end
    
    let arm_type = check_block(env, &arm.body)
    unify(env, result_type, arm_type, arm.span)
    pop_scope(env)
    i = i + 1
  end
  
  # Warn if match on an enum lacks a wildcard and may not be exhaustive
  if !has_wildcard then
    match scrutinee_type
    when Type::Named(tid, _) then
      match get_type_by_id(env, &tid)
      when Option::Some(td) then
        match td.kind
        when TypeDefKind::Enum(variants) then
          let missing = Vec::new()
          let mut j = 0
          while j < variants.len() do
            let variant = variants[j]
            if !vec_contains_string(&covered_variants, variant.name) then
              missing.push(variant.name)
            end
            j = j + 1
          end
          if !missing.is_empty() then
            add_warning(env, "match may not be exhaustive; missing variants: " +
              missing.join(", ") + " (consider adding a wildcard `_` arm)", m.span)
          end
        when _ then ()
        end
      when Option::None then ()
      end
    when _ then ()
    end
  end
  
  result_type
end

# ———————————————————————————————————————————————————————————————
# Pattern Type Checking
# ———————————————————————————————————————————————————————————————

def check_pattern(env: &mut TypeEnv, pat: &Pattern, expected: Type) -> Unit
  match pat.kind
  when PatternKind::Wildcard then
    ()
  when PatternKind::Ident(name, is_mut) then
    bind_var(env, name, expected)
  when PatternKind::Literal(expr) then
    let lit_type = check_expr(env, &expr)
    unify(env, lit_type, expected, pat.span)
    ()
  when PatternKind::Tuple(pats) then
    match expected
    when Type::Tuple(types) then
      if pats.len() == types.len() then
        mut i = 0
        while i < pats.len() do
          check_pattern(env, &pats[i], types[i])
          i = i + 1
        end
      else
        type_add_error(env, "tuple pattern length mismatch", pat.span)
      end
    when Type::Var(_) then
      mut types = Vec::new()
      mut i = 0
      while i < pats.len() do
        let t = fresh_type_var(env)
        check_pattern(env, &pats[i], t)
        types.push(t)
        i = i + 1
      end
      unify(env, expected, Type::Tuple(types), pat.span)
      ()
    when _ then
      type_add_error(env, "expected tuple type", pat.span)
    end
  when PatternKind::Array(pats) then
    let elem_type = fresh_type_var(env)
    mut i = 0
    while i < pats.len() do
      check_pattern(env, &pats[i], elem_type)
      i = i + 1
    end
  when PatternKind::Variant(path, pats) then
    # Look up variant type from the enum definition
    let variant_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
    let enum_name = if path.segments.len() >= 2 then path.segments[path.segments.len() - 2] else "" end
    # Try to find the enum definition
    match get_type_def_by_name(env, enum_name)
    when Option::Some(td) then
      match td.kind
      when TypeDefKind::Enum(variants) then
        mut found = false
        mut vi = 0
        while vi < variants.len() do
          let v = variants[vi]
          if v.name == variant_name then
            found = true
            # Check sub-pattern count matches variant field count
            if pats.len() != v.fields.len() then
              type_add_error(env, "variant " + variant_name + " expects " + v.fields.len().to_string() + " fields, got " + pats.len().to_string(), pat.span)
            end
            # Unify expected with the enum type
            unify(env, expected, Type::Named(td.id, Vec::new()), pat.span)
            # Check each sub-pattern against the variant's field types
            mut fi = 0
            while fi < pats.len() && fi < v.fields.len() do
              check_pattern(env, &pats[fi], v.fields[fi])
              fi = fi + 1
            end
          end
          vi = vi + 1
        end
        if !found then
          type_add_error(env, "unknown variant " + variant_name + " in enum " + enum_name, pat.span)
        end
      when _ then
        type_add_error(env, enum_name + " is not an enum", pat.span)
      end
    when Option::None then
      # Could be a simple variant like Option::Some — try matching expected type
      match expected
      when Type::Named(tid, _) then
        # Accept; unification already handled by the match scrutinee
        mut fi = 0
        while fi < pats.len() do
          check_pattern(env, &pats[fi], fresh_type_var(env))
          fi = fi + 1
        end
      when _ then
        # Accept generic patterns without specific enum resolution
        mut fi = 0
        while fi < pats.len() do
          check_pattern(env, &pats[fi], fresh_type_var(env))
          fi = fi + 1
        end
      end
    end
  when PatternKind::Struct(path, field_pats) then
    # Struct destructuring pattern: Foo { x, y: p }
    let struct_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
    match get_type_def_by_name(env, struct_name)
    when Option::Some(td) then
      unify(env, expected, Type::Named(td.id, Vec::new()), pat.span)
      match td.kind
      when TypeDefKind::Struct(fields) then
        mut i = 0
        while i < field_pats.len() do
          let field_pat = field_pats[i]
          mut field_found = false
          mut j = 0
          while j < fields.len() do
            let f = fields[j]
            if f.name == field_pat.0 then
              field_found = true
              check_pattern(env, &field_pat.1, f.ty)
            end
            j = j + 1
          end
          if !field_found then
            type_add_error(env, "no field `" + field_pat.0 + "` on struct " + struct_name, pat.span)
          end
          i = i + 1
        end
      when _ then
        type_add_error(env, struct_name + " is not a struct", pat.span)
      end
    when Option::None then
      type_add_error(env, "unknown type " + struct_name, pat.span)
    end
  when PatternKind::Range(lo, hi, _) then
    # Range pattern: 1..=10,  'a'..='z'
    match lo
    when Option::Some(lo_expr) then
      let lo_ty = check_expr(env, &lo_expr)
      unify(env, lo_ty, expected, pat.span)
      ()
    when Option::None then ()
    end
    match hi
    when Option::Some(hi_expr) then
      let hi_ty = check_expr(env, &hi_expr)
      unify(env, hi_ty, expected, pat.span)
      ()
    when Option::None then ()
    end
  when PatternKind::Or(alts) then
    # Or-pattern: p1 | p2 | p3
    mut i = 0
    while i < alts.len() do
      check_pattern(env, &alts[i], expected)
      i = i + 1
    end
  when _ then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Expression Type Checking
# ———————————————————————————————————————————————————————————————

def check_expr(env: &mut TypeEnv, expr: &Expr) -> Type
  match expr.kind
  when ExprKind::ExprIntLit(_) then Type::Int
  when ExprKind::ExprFloatLit(_) then Type::Float
  when ExprKind::ExprStringLit(_) then Type::String
  when ExprKind::ExprCharLit(_) then Type::Char
  when ExprKind::ExprBoolLit(_) then Type::Bool
  when ExprKind::ExprNilLit then Type::Option(fresh_type_var(env))
  when ExprKind::ExprIdent(name) then
    match lookup_var(env, name)
    when Option::Some(ty) then ty
    when Option::None then
      type_add_error(env, "undefined variable: " + name, expr.span)
      Type::Error
    end
  when ExprKind::ExprSelfRef then
    match lookup_var(env, "self")
    when Option::Some(ty) then ty
    when Option::None then Type::Error
    end
  when ExprKind::ExprBinaryOp(op, left, right) then
    check_binary_op(env, op, &left, &right, expr.span)
  when ExprKind::ExprUnaryOp(op, inner) then
    check_unary_op(env, op, &inner, expr.span)
  when ExprKind::ExprCall(func, args) then
    let func_type = check_expr(env, &func)
    mut arg_types = Vec::new()
    mut i = 0
    while i < args.len() do
      arg_types.push(check_expr(env, &args[i]))
      i = i + 1
    end
    let ret_type = fresh_type_var(env)
    let expected_func = Type::Function(arg_types, ret_type)
    unify(env, func_type, expected_func, expr.span)
    ret_type
  when ExprKind::ExprMethodCall(recv, method, type_args, args) then
    let recv_type = check_expr(env, &recv)
    mut arg_types = Vec::new()
    mut i = 0
    while i < args.len() do
      arg_types.push(check_expr(env, &args[i]))
      i = i + 1
    end
    # Look up method on receiver type
    let ret = resolve_method_type(env, &recv_type, method, &arg_types, expr.span)
    ret
  when ExprKind::ExprFieldAccess(recv, field) then
    let recv_type = check_expr(env, &recv)
    resolve_field_type(env, &recv_type, field, expr.span)
  when ExprKind::ExprIndex(recv, index) then
    let recv_type = check_expr(env, &recv)
    let index_type = check_expr(env, &index)
    unify(env, index_type, Type::Int, index.span)
    fresh_type_var(env)
  when ExprKind::ExprRef(inner) then
    let inner_type = check_expr(env, &inner)
    Type::Ref(inner_type, env.current_lifetime)
  when ExprKind::ExprRefMut(inner) then
    let inner_type = check_expr(env, &inner)
    Type::RefMut(inner_type, env.current_lifetime)
  when ExprKind::ExprDeref(inner) then
    let inner_type = check_expr(env, &inner)
    match inner_type
    when Type::Ref(t, _) then t
    when Type::RefMut(t, _) then t
    when Type::Var(_) then
      let elem = fresh_type_var(env)
      unify(env, inner_type, Type::Ref(elem, lifetime_anonymous()), expr.span)
      elem
    when _ then
      type_add_error(env, "cannot dereference non-reference type", expr.span)
      Type::Error
    end
  when ExprKind::ExprArrayLit(elems) then
    if elems.is_empty() then
      Type::Array(fresh_type_var(env), 0)
    else
      let elem_type = check_expr(env, &elems[0])
      mut i = 1
      while i < elems.len() do
        let t = check_expr(env, &elems[i])
        unify(env, elem_type, t, elems[i].span)
        i = i + 1
      end
      Type::Array(elem_type, elems.len())
    end
  when ExprKind::ExprTupleLit(elems) then
    mut types = Vec::new()
    mut i = 0
    while i < elems.len() do
      types.push(check_expr(env, &elems[i]))
      i = i + 1
    end
    Type::Tuple(types)
  when ExprKind::ExprStructLit(path, fields) then
    let type_name = if path.segments.len() > 0 then path.segments[path.segments.len() - 1] else "" end
    match get_type_def_by_name(env, type_name)
    when Option::Some(type_def) then
      Type::Named(type_def.id, Vec::new())
    when Option::None then
      type_add_error(env, "undefined type: " + type_name, expr.span)
      Type::Error
    end
  when ExprKind::ExprClosure(params, ret_ty, body) then
    push_scope(env)
    mut param_types = Vec::new()
    mut i = 0
    while i < params.len() do
      let p = params[i]
      let ty = match p.ty
      when Option::Some(te) then resolve_type_expr(env, &te)
      when Option::None then fresh_type_var(env)
      end
      check_pattern(env, &p.pat, ty)
      param_types.push(ty)
      i = i + 1
    end
    let body_type = check_expr(env, &body)
    pop_scope(env)
    Type::Function(param_types, body_type)
  when ExprKind::ExprIf(if_stmt) then
    check_if_stmt(env, &if_stmt)
  when ExprKind::ExprMatch(m) then
    check_match(env, &m)
  when ExprKind::ExprBlock(block) then
    check_block(env, &block)
  when ExprKind::ExprUnsafe(_, block) then
    check_block(env, &block)
  when ExprKind::ExprAsync(block) then
    let inner = check_block(env, &block)
    inner  # In full impl, would wrap in Future/Async
  when ExprKind::ExprAwait(inner) then
    let inner_type = check_expr(env, &inner)
    fresh_type_var(env)
  when ExprKind::ExprTry(inner) then
    let inner_type = check_expr(env, &inner)
    fresh_type_var(env)
  when ExprKind::ExprCast(inner, ty) then
    check_expr(env, &inner)
    resolve_type_expr(env, &ty)
  when ExprKind::ExprTypeCheck(inner, ty) then
    check_expr(env, &inner)
    Type::Bool
  when ExprKind::ExprPipe(left, right) then
    check_expr(env, &left)
    check_expr(env, &right)
  when ExprKind::ExprPath(path) then
    match lookup_var(env, path.segments[0])
    when Option::Some(ty) then ty
    when Option::None then fresh_type_var(env)
    end
  when ExprKind::ExprEnumVariant(path, args) then
    fresh_type_var(env)
  when ExprKind::ExprComptime(block) then
    check_block(env, &block)
  when _ then Type::Error
  end
end

# ———————————————————————————————————————————————————————————————
# Field and Method Resolution
# ———————————————————————————————————————————————————————————————

def resolve_field_type(env: &mut TypeEnv, recv_type: &Type, field: String, span: Span) -> Type
  # Guard: if receiver is Error type, propagate silently
  match recv_type
  when Type::Error then return Type::Error
  when _ then ()
  end

  # Auto-deref through references
  let base = match recv_type
  when Type::Ref(inner, _) then inner
  when Type::RefMut(inner, _) then inner
  when Type::Owned(inner) then inner
  when _ then recv_type
  end

  # Guard: if base after deref is Error, return Error
  match base
  when Type::Error then return Type::Error
  when _ then ()
  end

  match base
  when Type::Named(tid, type_args) then
    # Direct lookup by TypeId via type_list vec
    match get_type_by_id(env, &tid)
    when Option::Some(td) then
      match td.kind
      when TypeDefKind::Struct(fields) then
        for f in fields do
          if f.name == field then
            return f.ty
          end
        end
        type_add_error(env, "no field `" + field + "` on type `" + td.name + "`", span)
        Type::Error
      when _ then
        type_add_error(env, "type `" + td.name + "` does not have fields", span)
        Type::Error
      end
    when Option::None then fresh_type_var(env)
    end
  when Type::Tuple(fields) then
    # Tuple field access by numeric index (e.g., .0, .1)
    match field.parse_int()
    when Result::Ok(idx) then
      if idx >= 0 && idx < fields.len() then
        fields[idx]
      else
        type_add_error(env, "tuple index out of bounds: " + field, span)
        Type::Error
      end
    when Result::Err(_) then
      type_add_error(env, "tuple fields must be accessed by index", span)
      Type::Error
    end
  when Type::String then
    # String built-in fields
    if field == "len" then Type::Int
    else
      type_add_error(env, "no field `" + field + "` on String", span)
      Type::Error
    end
  when Type::Slice(_) then
    if field == "len" then Type::Int
    elsif field == "cap" then Type::Int
    else fresh_type_var(env)
    end
  when Type::Array(_, _) then
    if field == "len" then Type::Int
    else fresh_type_var(env)
    end
  when Type::Var(_) then fresh_type_var(env)
  when _ then
    type_add_error(env, "cannot access field on this type", span)
    Type::Error
  end
end

def resolve_method_type(env: &mut TypeEnv, recv_type: &Type, method: String, arg_types: &Vec[Type], span: Span) -> Type
  # Auto-deref through references
  let base = match recv_type
  when Type::Ref(inner, _) then inner
  when Type::RefMut(inner, _) then inner
  when Type::Owned(inner) then inner
  when _ then recv_type
  end

  # Guard: error type propagation
  match base
  when Type::Error then return Type::Error
  when _ then ()
  end

  # 1. Check inherent methods on the type
  match base
  when Type::Named(tid, _) then
    for imp in env.impls do
      if imp.trait_name == "" || imp.trait_name == "_" then
        # Inherent impl
        for m in imp.methods do
          if m.name == method then
            return m.ret_type
          end
        end
      end
    end
  when _ then ()
  end

  # 2. Check trait impls
  for imp in env.impls do
    if imp.trait_name != "" && imp.trait_name != "_" then
      for m in imp.methods do
        if m.name == method then
          return m.ret_type
        end
      end
    end
  end

  # 3. Built-in methods on common types
  match base
  when Type::String then
    if method == "len" then return Type::Int end
    if method == "to_string" then return Type::String end
    if method == "contains" then return Type::Bool end
    if method == "starts_with" then return Type::Bool end
    if method == "ends_with" then return Type::Bool end
    if method == "slice" then return Type::String end
    if method == "trim" then return Type::String end
    if method == "split" then return Type::Slice(Type::String) end
    if method == "chars" then return Type::Slice(Type::Char) end
    if method == "bytes" then return Type::Slice(Type::Int) end
    if method == "push" then return Type::Unit end
    if method == "clone" then return Type::String end
  when Type::Int then
    if method == "to_string" then return Type::String end
    if method == "abs" then return Type::Int end
    if method == "pow" then return Type::Int end
    if method == "min" then return Type::Int end
    if method == "max" then return Type::Int end
    if method == "clamp" then return Type::Int end
  when Type::Float then
    if method == "to_string" then return Type::String end
    if method == "abs" then return Type::Float end
    if method == "sqrt" then return Type::Float end
    if method == "floor" then return Type::Int end
    if method == "ceil" then return Type::Int end
    if method == "round" then return Type::Int end
  when Type::Bool then
    if method == "to_string" then return Type::String end
  when Type::Slice(elem) then
    if method == "len" then return Type::Int end
    if method == "is_empty" then return Type::Bool end
    if method == "push" then return Type::Unit end
    if method == "pop" then return Type::Option(elem) end
    if method == "get" then return Type::Option(Type::Ref(elem, lifetime_anonymous())) end
    if method == "contains" then return Type::Bool end
    if method == "iter" then return Type::Slice(elem) end
    if method == "map" then return fresh_type_var(env) end
    if method == "filter" then return Type::Slice(elem) end
    if method == "fold" then return fresh_type_var(env) end
    if method == "clone" then return Type::Slice(elem) end
    if method == "sort" then return Type::Unit end
    if method == "reverse" then return Type::Unit end
    if method == "first" then return Type::Option(Type::Ref(elem, lifetime_anonymous())) end
    if method == "last" then return Type::Option(Type::Ref(elem, lifetime_anonymous())) end
  when Type::Option(inner) then
    if method == "unwrap" then return inner end
    if method == "is_some" then return Type::Bool end
    if method == "is_none" then return Type::Bool end
    if method == "map" then return fresh_type_var(env) end
    if method == "and_then" then return fresh_type_var(env) end
    if method == "or_else" then return fresh_type_var(env) end
    if method == "unwrap_or" then return inner end
  when Type::Result(ok, err) then
    if method == "unwrap" then return ok end
    if method == "is_ok" then return Type::Bool end
    if method == "is_err" then return Type::Bool end
    if method == "map" then return fresh_type_var(env) end
    if method == "map_err" then return fresh_type_var(env) end
    if method == "and_then" then return fresh_type_var(env) end
    if method == "unwrap_or" then return ok end
    if method == "ok" then return Type::Option(ok) end
    if method == "err" then return Type::Option(err) end
  when Type::Map(k, v) then
    if method == "get" then return Type::Option(Type::Ref(v, lifetime_anonymous())) end
    if method == "insert" then return Type::Option(v) end
    if method == "contains_key" then return Type::Bool end
    if method == "remove" then return Type::Option(v) end
    if method == "len" then return Type::Int end
    if method == "is_empty" then return Type::Bool end
    if method == "keys" then return Type::Slice(k) end
    if method == "values" then return Type::Slice(v) end
  when Type::Set(elem) then
    if method == "contains" then return Type::Bool end
    if method == "insert" then return Type::Bool end
    if method == "remove" then return Type::Bool end
    if method == "len" then return Type::Int end
    if method == "is_empty" then return Type::Bool end
  when _ then ()
  end

  # Method on user-defined type or trait — permissively infer
  fresh_type_var(env)
end

def check_binary_op(env: &mut TypeEnv, op: BinOp, left: &Expr, right: &Expr, span: Span) -> Type
  let left_type = check_expr(env, left)
  let right_type = check_expr(env, right)

  # Propagate errors without crashing
  match left_type
  when Type::Error then return Type::Error
  when _ then ()
  end
  match right_type
  when Type::Error then return Type::Error
  when _ then ()
  end
  
  match op
  when BinOp::Add then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Sub then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Mul then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Div then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Mod then
    unify(env, left_type, Type::Int, span)
    unify(env, right_type, Type::Int, span)
    Type::Int
  when BinOp::Pow then
    unify(env, left_type, right_type, span)
    left_type
  when BinOp::Eq then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Ne then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Lt then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Le then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Gt then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::Ge then
    unify(env, left_type, right_type, span)
    Type::Bool
  when BinOp::And then
    unify(env, left_type, Type::Bool, span)
    unify(env, right_type, Type::Bool, span)
    Type::Bool
  when BinOp::Or then
    unify(env, left_type, Type::Bool, span)
    unify(env, right_type, Type::Bool, span)
    Type::Bool
  when _ then left_type
  end
end

def check_unary_op(env: &mut TypeEnv, op: UnOp, inner: &Expr, span: Span) -> Type
  let inner_type = check_expr(env, inner)

  match inner_type
  when Type::Error then return Type::Error
  when _ then ()
  end
  
  match op
  when UnOp::Neg then
    inner_type
  when UnOp::Not then
    unify(env, inner_type, Type::Bool, span)
    Type::Bool
  when UnOp::BitNot then
    unify(env, inner_type, Type::Int, span)
    Type::Int
  end
end

# ———————————————————————————————————————————————————————————————
# Type Expression Resolution
# ———————————————————————————————————————————————————————————————

def resolve_type_expr(env: &mut TypeEnv, te: &TypeExpr) -> Type
  match te.kind
  when TypeExprKind::Named(name, args) then
    # Use if-chains for string matching (match name.as_str() generates broken C)
    # Preserve sized integer types for FFI parity - critical for correct ABI
    if name == "Unit" then Type::Unit
    elsif name == "Nil" then Type::Unit
    elsif name == "Bool" then Type::Bool
    elsif name == "Int" then Type::Int
    elsif name == "i8" then Type::I8
    elsif name == "i16" then Type::I16
    elsif name == "i32" then Type::I32
    elsif name == "i64" then Type::I64
    elsif name == "i128" then Type::I128
    elsif name == "UInt" then Type::UInt
    elsif name == "u8" then Type::U8
    elsif name == "u16" then Type::U16
    elsif name == "u32" then Type::U32
    elsif name == "u64" then Type::U64
    elsif name == "u128" then Type::U128
    elsif name == "isize" then Type::ISize
    elsif name == "usize" then Type::USize
    elsif name == "Float" then Type::Float
    elsif name == "f32" then Type::F32
    elsif name == "f64" then Type::F64
    elsif name == "Char" then Type::Char
    elsif name == "String" then Type::String
    elsif name == "Never" then Type::Never
    elsif name == "Self" then
      # Self refers to the current impl type; treat as a type variable
      fresh_type_var(env)
    elsif name == "Fn" then
      # Fn types like Fn(Args) -> Ret
      mut param_types = Vec::new()
      mut i = 0
      while i < args.len() do
        param_types.push(resolve_type_expr(env, &args[i]))
        i = i + 1
      end
      Type::Function(param_types, Type::Unit)
    else
      match get_type_def_by_name(env, name)
      when Option::Some(type_def) then
        mut resolved_args = Vec::new()
        mut i = 0
        while i < args.len() do
          resolved_args.push(resolve_type_expr(env, &args[i]))
          i = i + 1
        end
        Type::Named(type_def.id, resolved_args)
      when Option::None then
        type_add_error(env, "undefined type: " + name, te.span)
        Type::Error
      end
    end
  when TypeExprKind::Unit then Type::Unit
  when TypeExprKind::Never then Type::Never
  when TypeExprKind::Ref(inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::Ref(inner_type, lifetime_anonymous())
  when TypeExprKind::RefMut(inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::RefMut(inner_type, lifetime_anonymous())
  when TypeExprKind::Tuple(elems) then
    mut types = Vec::new()
    mut i = 0
    while i < elems.len() do
      types.push(resolve_type_expr(env, &elems[i]))
      i = i + 1
    end
    Type::Tuple(types)
  when TypeExprKind::Array(elem, size_opt) then
    let elem_type = resolve_type_expr(env, &elem)
    let size = match size_opt
    when Option::Some(size_expr) then
      match size_expr.kind
      when ExprKind::ExprIntLit(n) then n
      when _ then 0
      end
    when Option::None then 0
    end
    Type::Array(elem_type, size)
  when TypeExprKind::Slice(elem) then
    let elem_type = resolve_type_expr(env, &elem)
    Type::Slice(elem_type)
  when TypeExprKind::Fn(params, ret) then
    mut param_types = Vec::new()
    mut i = 0
    while i < params.len() do
      param_types.push(resolve_type_expr(env, &params[i]))
      i = i + 1
    end
    let ret_type = resolve_type_expr(env, &ret)
    Type::Function(param_types, ret_type)
  when TypeExprKind::Infer then
    fresh_type_var(env)
  when TypeExprKind::Ptr(inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::Ptr(inner_type)
  when TypeExprKind::PtrMut(inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::PtrMut(inner_type)
  when TypeExprKind::Async(inner) then
    # Async types resolve to their inner type for now
    resolve_type_expr(env, &inner)
  when TypeExprKind::Effect(name, inner) then
    let inner_type = resolve_type_expr(env, &inner)
    Type::Effect(Vec::from([name.clone()]), inner_type)
  when TypeExprKind::Path(path) then
    # Qualified path like module::Type — resolve the last segment
    if path.segments.len() > 0 then
      let full_name = path.segments.join("::")
      match get_type_def_by_name(env, full_name.clone())
      when Option::Some(type_def) then Type::Named(type_def.id, Vec::new())
      when Option::None then
        # Try the last segment alone
        let last = path.segments[path.segments.len() - 1].clone()
        match get_type_def_by_name(env, last)
        when Option::Some(type_def) then Type::Named(type_def.id, Vec::new())
        when Option::None then
          type_add_error(env, "undefined type path: " + full_name, path.span)
          Type::Error
        end
      end
    else
      Type::Error
    end
  when _ then Type::Error
  end
end

# ———————————————————————————————————————————————————————————————
# Import Resolution — loads and parses referenced stdlib files
# ———————————————————————————————————————————————————————————————

# Map a use-declaration path to a filesystem path.
# e.g. ["std", "app"] -> "std/app.tg"
# e.g. ["std", "gfx_errors"] -> "std/gfx_errors.tg"
# e.g. ["tg_compiler", "ast"] -> "tg_compiler/ast.tg"
# Returns Option::None for paths that don't map to loadable files (e.g. builtins).
def use_path_to_file(segments: &Vec[String]) -> Option[String]
  if segments.len() < 2 then
    return Option::None
  end
  let root = segments[0]
  if root == "std" then
    # std::X -> std/X.tg   (handles std::core, std::app, std::gfx, etc.)
    mut path = "std/"
    mut i = 1
    while i < segments.len() do
      if i > 1 then
        path = path + "/"
      end
      path = path + segments[i]
      i = i + 1
    end
    path = path + ".tg"
    Option::Some(path)
  elsif root == "tg_compiler" then
    # tg_compiler::X -> tg_compiler/X.tg
    mut path = "tg_compiler/"
    mut i = 1
    while i < segments.len() do
      if i > 1 then
        path = path + "/"
      end
      path = path + segments[i]
      i = i + 1
    end
    path = path + ".tg"
    Option::Some(path)
  else
    Option::None
  end
end

# Extract use declarations from a program's items and return the referenced file paths.
def extract_import_paths(program: &Program) -> Vec[String]
  mut paths = Vec::new()
  mut i = 0
  while i < program.items.len() do
    let item = &program.items[i]
    match item.kind.clone()
    when ItemKind::ItemUse(u) then
      match use_path_to_file(&u.path.segments)
      when Option::Some(p) then paths.push(p)
      when Option::None then ()
      end
    when _ then ()
    end
    i = i + 1
  end
  paths
end

# Recursively resolve imports: read, tokenize, parse each referenced file,
# collect type definitions from it, and recurse into its own use declarations.
# The `loaded` set prevents loading the same file twice (cycle protection).
def resolve_imports(env: &mut TypeEnv, program: &Program, loaded: &mut Set[String]) -> Unit
  let paths = extract_import_paths(program)
  for path in paths do
    if loaded.contains(path.clone()) then
      # Already loaded — skip to prevent infinite recursion
      ()
    else
      loaded.insert(path.clone())
      match std::fs::read_file(path.clone())
      when Result::Ok(source) then
        let tokens = tokenize(source)
        let dep_parse = parse(tokens)
        let dep_ast = dep_parse.program
        # Process even if parse had non-fatal errors — collect whatever types were parsed
        # Recurse: resolve this file's own imports first
        resolve_imports(env, &dep_ast, loaded)
        # Pass 1: Pre-register all type names (enables forward references)
        mut i = 0
        while i < dep_ast.items.len() do
          let item = dep_ast.items[i]
          pre_register_type_name(env, item)
          i = i + 1
        end
        # Pass 2: Collect full type definitions (field types, variant types, etc.)
        i = 0
        while i < dep_ast.items.len() do
          let item = dep_ast.items[i]
          collect_type_def(env, item)
          i = i + 1
        end
      when Result::Err(_) then
        # File not found or unreadable — skip silently.
        # This is normal for built-in modules (std::core, std::collections)
        # whose types are already registered as builtins in type_env_new().
        ()
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def type_check(program: &Program) -> Vec[TypeError]
  mut env = type_env_new()
  
  # Resolve imports: load and parse referenced stdlib files,
  # registering their type definitions into the environment.
  mut loaded = Set::new()
  # Mark built-in modules as already loaded (their types are pre-registered)
  loaded.insert("std/core.tg")
  loaded.insert("std/collections.tg")
  eprint("[types] imports\n")
  resolve_imports(&mut env, program, &mut loaded)
  
  eprint("[types] program\n")
  type_check_program_env(&mut env, program)
  eprint("[types] done\n")
  env.errors
end

# ———————————————————————————————————————————————————————————————
# Send / Sync Auto-Trait Derivation and Enforcement
# ———————————————————————————————————————————————————————————————

# Determine whether a type is Send (safe to transfer across threads).
# A type is Send if all of its field types are Send.
# Primitive types (Int, UInt, Float, Bool, Char, String) are Send.
# Raw pointers (Ptr/PtrMut) are NOT Send.
# Ref(&T) is Send if T is Sync. RefMut(&mut T) is Send if T is Send.
def is_send(env: &TypeEnv, ty: &Type) -> Bool
  match ty
  when Type::Unit then true
  when Type::Bool then true
  when Type::Int then true
  when Type::UInt then true
  when Type::Float then true
  when Type::Char then true
  when Type::String then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::Named(tid, args) then
    # Look up the type by id
    match get_type_by_id(env, tid)
    when Option::Some(td) then
      # Check if there's an explicit !Send impl
      if env.non_send_types.contains(td.name.clone()) then return false end
      # Check all fields of the struct
      match td.kind
      when TypeDefKind::Struct(fields) then
        for field in fields do
          if !is_send(env, &field.ty) then return false end
        end
        # Also check type arguments
        for arg in args do
          if !is_send(env, arg) then return false end
        end
        true
      when TypeDefKind::Enum(variants) then
        for variant in variants do
          for field in variant.fields do
            if !is_send(env, field) then return false end
          end
        end
        for arg in args do
          if !is_send(env, arg) then return false end
        end
        true
      when TypeDefKind::Primitive then true
      when _ then true  # Conservative: assume send
      end
    when Option::None then true
    end
  when Type::Ref(inner, _lifetime) then
    # &T is Send if T is Sync
    is_sync(env, inner)
  when Type::RefMut(inner, _lifetime) then
    # &mut T is Send if T is Send
    is_send(env, inner)
  when Type::Owned(inner) then is_send(env, inner)
  when Type::Tuple(elems) then
    for e in elems do
      if !is_send(env, e) then return false end
    end
    true
  when Type::Array(elem, _) then is_send(env, elem)
  when Type::Slice(elem) then is_send(env, elem)
  when Type::Option(inner) then is_send(env, inner)
  when Type::Result(ok, err) then is_send(env, ok) && is_send(env, err)
  when Type::Map(k, v) then is_send(env, k) && is_send(env, v)
  when Type::Set(elem) then is_send(env, elem)
  when Type::Function(_, _) then true  # Function pointers are Send
  when Type::Box(inner) then is_send(env, inner)
  when Type::Rc(_) then false  # Rc is !Send (single-threaded reference counting)
  when Type::Ptr(_) then false  # Raw pointers are !Send by default
  when Type::PtrMut(_) then false  # Mutable raw pointers are !Send
  when Type::Dyn(_) then false  # Trait objects: conservative !Send (need explicit bound)
  when Type::Effect(_, inner) then is_send(env, inner)
  when Type::Param(_) then true  # Assume generic params are Send (checked at instantiation)
  when Type::Var(_) then true  # Type variables: assume Send
  when Type::Never then true
  when Type::Error then true
  end
end

# Determine whether a type is Sync (safe to share references across threads).
# A type is Sync if &T is Send, which means all fields must be Sync.
# Interior mutability types (Cell, RefCell, UnsafeCell) are NOT Sync.
def is_sync(env: &TypeEnv, ty: &Type) -> Bool
  match ty
  when Type::Unit then true
  when Type::Bool then true
  when Type::Int then true
  when Type::UInt then true
  when Type::Float then true
  when Type::Char then true
  when Type::String then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::Named(tid, args) then
    # Look up the type by id
    match get_type_by_id(env, tid)
    when Option::Some(td) then
      # Check explicit !Sync
      if env.non_sync_types.contains(td.name.clone()) then return false end
      # Interior mutability types
      if td.name == "Cell" || td.name == "RefCell" || td.name == "UnsafeCell" then return false end
      # Check all fields
      match td.kind
      when TypeDefKind::Struct(fields) then
        for field in fields do
          if !is_sync(env, &field.ty) then return false end
        end
        for arg in args do
          if !is_sync(env, arg) then return false end
        end
        true
      when TypeDefKind::Enum(variants) then
        for variant in variants do
          for field in variant.fields do
            if !is_sync(env, field) then return false end
          end
        end
        for arg in args do
          if !is_sync(env, arg) then return false end
        end
        true
      when _ then true
      end
    when Option::None then true
    end
  when Type::Ref(inner, _) then is_sync(env, inner)
  when Type::RefMut(inner, _) then is_sync(env, inner)
  when Type::Owned(inner) then is_sync(env, inner)
  when Type::Tuple(elems) then
    for e in elems do
      if !is_sync(env, e) then return false end
    end
    true
  when Type::Array(elem, _) then is_sync(env, elem)
  when Type::Slice(elem) then is_sync(env, elem)
  when Type::Option(inner) then is_sync(env, inner)
  when Type::Result(ok, err) then is_sync(env, ok) && is_sync(env, err)
  when Type::Map(k, v) then is_sync(env, k) && is_sync(env, v)
  when Type::Set(elem) then is_sync(env, elem)
  when Type::Function(_, _) then true
  when Type::Box(inner) then is_sync(env, inner)
  when Type::Rc(inner) then is_sync(env, inner)  # Rc<T> is Sync if T is Sync+Send
  when Type::Ptr(_) then false  # Raw pointers are !Sync
  when Type::PtrMut(_) then false  # Mutable raw pointers are !Sync
  when Type::Dyn(_) then false  # Trait objects: conservative !Sync
  when Type::Effect(_, inner) then is_sync(env, inner)
  when Type::Param(_) then true
  when Type::Var(_) then true
  when Type::Never then true
  when Type::Error then true
  end
end

# Check that a type satisfies Send bound at a usage site (e.g., thread::spawn)
def check_send_bound(env: &mut TypeEnv, ty: &Type, span: Span, context: String) -> Unit
  if !is_send(env, ty) then
    env.errors.push(TypeError {
      message: context + ": type `" + type_display(ty) + "` does not satisfy `Send` bound — " +
               "cannot be safely transferred across thread boundaries",
      span: span,
      code: Option::Some("E0277")
    })
  end
end

# Check that a type satisfies Sync bound (e.g., shared references across threads)
def check_sync_bound(env: &mut TypeEnv, ty: &Type, span: Span, context: String) -> Unit
  if !is_sync(env, ty) then
    env.errors.push(TypeError {
      message: context + ": type `" + type_display(ty) + "` does not satisfy `Sync` bound — " +
               "cannot be safely shared across thread boundaries",
      span: span,
      code: Option::Some("E0277")
    })
  end
end

def type_display(ty: &Type) -> String
  match ty
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Char then "Char"
  when Type::String then "String"
  when Type::I8 then "i8"
  when Type::I16 then "i16"
  when Type::I32 then "i32"
  when Type::I64 then "i64"
  when Type::I128 then "i128"
  when Type::U8 then "u8"
  when Type::U16 then "u16"
  when Type::U32 then "u32"
  when Type::U64 then "u64"
  when Type::U128 then "u128"
  when Type::ISize then "isize"
  when Type::USize then "usize"
  when Type::F32 then "f32"
  when Type::F64 then "f64"
  when Type::Never then "Never"
  when Type::Named(tid, args) then
    # We don't have access to TypeEnv here, so just display the id
    mut s = "Type#" + tid.id.to_string()
    if !args.is_empty() then
      s = s + "["
      mut first = true
      for a in args do
        if !first then s = s + ", " end
        s = s + type_display(a)
        first = false
      end
      s = s + "]"
    end
    s
  when Type::Function(params, ret) then
    mut s = "("
    mut first = true
    for p in params do
      if !first then s = s + ", " end
      s = s + type_display(p)
      first = false
    end
    s = s + ") -> " + type_display(ret)
    s
  when Type::Ref(inner, _lifetime) then "&" + type_display(inner)
  when Type::RefMut(inner, _lifetime) then "&mut " + type_display(inner)
  when Type::Owned(inner) then "own " + type_display(inner)
  when Type::Tuple(elems) then
    mut s = "("
    mut first = true
    for e in elems do
      if !first then s = s + ", " end
      s = s + type_display(e)
      first = false
    end
    s + ")"
  when Type::Array(elem, size) then "[" + type_display(elem) + "; " + size.to_string() + "]"
  when Type::Slice(elem) then "[" + type_display(elem) + "]"
  when Type::Option(inner) then "Option[" + type_display(inner) + "]"
  when Type::Result(ok, err) then "Result[" + type_display(ok) + ", " + type_display(err) + "]"
  when Type::Map(k, v) then "Map[" + type_display(k) + ", " + type_display(v) + "]"
  when Type::Set(elem) then "Set[" + type_display(elem) + "]"
  when Type::Var(vid) then "?T" + vid.id.to_string()
  when Type::Param(name) then name.clone()
  when Type::Error then "<error>"
  end
end
