# Tangerine Compiler — Documentation Generator
#
# The doc generator consumes the COMPILER's own front end: the source is
# tokenized and parsed with tg_compiler's lexer/parser, and the doc model
# is extracted from the parsed Program (the AST spans carry the item
# offsets; the doc comments are read off the source at those spans). The
# model + renderers live in std::doc_gen — the fork that re-parsed source
# text with a hand-rolled grammar is removed; this module is the only
# source-text consumer and it feeds the compiler's AST data in.

use std::core::{Option, Result, Vec, String, Bool, UInt}
use std::fs::{read_file, write_file, mkdir_p, path_join}
use std::io::{eprintln}

use std::doc_gen::{DocModule, DocItem, DocKind, DocParam}

use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::ast::{Program, Item, ItemKind, FunctionDecl, FunctionSig, FnBody, Param,
                        TypeExpr, TypeExprKind, type_expr_name, Visibility, GenericParam,
                        StructDecl, EnumDecl, TraitDecl, TraitMethod, ImplDecl, AccessConvention}

def collect_generic_param_names(params: Vec[GenericParam]) -> Vec[String]
  var names = Vec::new()
  for tp in params do
    names.push(tp.name.clone())
  end
  names
end

# ———————————————————————————————————————————————————————————————
# Configuration (the driver-facing config; rendered through
# std::doc_gen::DocConfig)
# ———————————————————————————————————————————————————————————————

enum DocFormat
  Html
  Markdown
end

struct DocConfig
  output_dir: String
  format: DocFormat
  include_private: Bool
  project_name: String
  version: String
end

pub def default_doc_config() -> DocConfig
  DocConfig {
    output_dir: "docs/api".to_string(),
    format: DocFormat::Html,
    include_private: false,
    project_name: "Tangerine Project".to_string(),
    version: "0.1.0".to_string()
  }
end

def to_std_config(config: DocConfig) -> std::doc_gen::DocConfig
  std::doc_gen::DocConfig {
    output_dir: config.output_dir.clone(),
    format: match config.format
      when DocFormat::Html then std::doc_gen::OutputFormat::HTML
      when DocFormat::Markdown then std::doc_gen::OutputFormat::Markdown
    end,
    include_private: config.include_private,
    include_examples: true,
    include_source_links: false,
    base_url: Option::None,
    theme: "light".to_string(),
    generate_index: true,
    generate_search: true
  }
end

# ———————————————————————————————————————————————————————————————
# Doc Extraction (from the compiler's parsed Program)
# ———————————————————————————————————————————————————————————————

def extract_module(file_path: String, source: String, include_private: Bool) -> Result[DocModule, String]
  let tokens = tokenize(source.clone(), file_path.clone())
  let parse_out = parse(tokens)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return Result::Err("Parse error in " + file_path + ": " + parse_diags[0].message)
  end

  let mod_name = module_name_from_path(file_path.clone())
  let mod_doc = extract_module_doc_comment(&source)
  var doc_module = DocModule::new(mod_name, if mod_doc.len() > 0 then Option::Some(mod_doc) else Option::None end)

  for item in ast.items do
    extract_item(&mut doc_module, item, &file_path, &source, include_private)
  end

  Result::Ok(doc_module)
end

def extract_item(inout doc_module: DocModule, item: Item, file_path: String, source: String, include_private: Bool) -> Unit
  let doc = extract_doc_comment_from_source(source, item.span.start)
  let line = offset_to_line(source, item.span.start)

  match item.kind
  when ItemKind::ItemFunction(func) then
    if include_private || func.vis == Visibility::Public then
      doc_module.add_item(extract_function_item(func, &doc, &file_path, line, false))
    end
  when ItemKind::ItemStruct(s) then
    if include_private || s.vis == Visibility::Public then
      var type_params = collect_generic_param_names(&s.generic_params)
      var sig = "struct " + s.name.clone()
      if !type_params.is_empty() then
        sig = sig + "[" + type_params.join(", ") + "]"
      end
      var item = DocItem::new(s.name.clone(), DocKind::Struct, sig,
        if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
        Vec::new(), Option::None, file_path.clone(), line)
      item.with_doc_flags(doc)
      doc_module.add_item(item)
    end
  when ItemKind::ItemEnum(e) then
    if include_private || e.vis == Visibility::Public then
      var type_params = collect_generic_param_names(&e.generic_params)
      var sig = "enum " + e.name.clone()
      if !type_params.is_empty() then
        sig = sig + "[" + type_params.join(", ") + "]"
      end
      var item = DocItem::new(e.name.clone(), DocKind::Enum, sig,
        if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
        Vec::new(), Option::None, file_path.clone(), line)
      item.with_doc_flags(doc)
      doc_module.add_item(item)
    end
  when ItemKind::ItemTrait(t) then
    if include_private || t.vis == Visibility::Public then
      var type_params = collect_generic_param_names(&t.generic_params)
      var sig = "trait " + t.name.clone()
      if !type_params.is_empty() then
        sig = sig + "[" + type_params.join(", ") + "]"
      end
      var item = DocItem::new(t.name.clone(), DocKind::Trait, sig,
        if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
        Vec::new(), Option::None, file_path.clone(), line)
      item.with_doc_flags(doc)
      doc_module.add_item(item)
    end
  when ItemKind::ItemImpl(imp) then
    var sig = "impl " + docgen_format_type_expr(&imp.for_type)
    match imp.trait_name
    when Option::Some(tn) then sig = sig + " for " + tn
    when Option::None => ()
    end
    var item = DocItem::new(sig.clone(), DocKind::Impl, sig,
      if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
      Vec::new(), Option::None, file_path.clone(), line)
    item.with_doc_flags(doc)
    doc_module.add_item(item)
  when ItemKind::ItemConst(c) then
    if include_private || c.vis == Visibility::Public then
      var ty_str = "?".to_string()
      match c.ty
      when Option::Some(t) then ty_str = docgen_format_type_expr(t)
      when Option::None => ()
      end
      var item = DocItem::new(c.name.clone(), DocKind::Constant, "const " + c.name.clone() + ": " + ty_str,
        if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
        Vec::new(), Option::Some(ty_str), file_path.clone(), line)
      item.with_doc_flags(doc)
      doc_module.add_item(item)
    end
  when ItemKind::ItemTypeAlias(ta) then
    if include_private || ta.vis == Visibility::Public then
      var target = docgen_format_type_expr(&ta.ty)
      var item = DocItem::new(ta.name.clone(), DocKind::TypeAlias, "type " + ta.name.clone() + " = " + target.clone(),
        if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
        Vec::new(), Option::Some(target), file_path.clone(), line)
      item.with_doc_flags(doc)
      doc_module.add_item(item)
    end
  when _ => ()
  end
end

def extract_function_item(func: FunctionDecl, doc: String, file_path: String, line: UInt, is_method: Bool) -> DocItem
  var doc_params = Vec::new()
  for p in func.params do
    if p.name == "self" then
      let is_mut_self = p.convention == AccessConvention::Inout
      doc_params.push(DocParam::new("self".to_string(),
        Option::Some(if is_mut_self then "&mut self".to_string() else "&self".to_string() end)))
    else
      var param_type_str = "?".to_string()
      match p.ty
      when Option::Some(t) then param_type_str = docgen_format_type_expr(t)
      when Option::None => ()
      end
      doc_params.push(DocParam::new(p.name.clone(), Option::Some(param_type_str)))
    end
  end

  let ret_type = match func.ret_type
  when Option::Some(rt) then Option::Some(docgen_format_type_expr(rt))
  when Option::None => Option::None
  end

  let sig = build_signature(&func.name, &func.generic_params, &func.params, &func.ret_type, func.vis == Visibility::Public)

  var item = DocItem::new(func.name.clone(), DocKind::Function, sig,
    if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
    doc_params, ret_type, file_path.clone(), line)
  item.with_doc_flags(doc)
  item
end

def build_signature(name: String, generic_params: Vec[GenericParam], params: Vec[Param], ret_type: Option[TypeExpr], is_pub: Bool) -> String
  var sig = ""
  if is_pub then sig = sig + "pub " end
  sig = sig + "def " + name

  if !generic_params.is_empty() then
    sig = sig + "["
    for i in 0..generic_params.len() do
      if i > 0 then sig = sig + ", " end
      sig = sig + generic_params[i].name
      if !generic_params[i].bounds.is_empty() then
        sig = sig + ": "
        for j in 0..generic_params[i].bounds.len() do
          if j > 0 then sig = sig + " + " end
          sig = sig + docgen_format_type_expr(&generic_params[i].bounds[j])
        end
      end
    end
    sig = sig + "]"
  end

  sig = sig + "("
  for i in 0..params.len() do
    if i > 0 then sig = sig + ", " end
    let p = params[i]
    let is_mut_param = p.convention == AccessConvention::Inout
    if p.name == "self" then
      if is_mut_param then sig = sig + "&mut self" else sig = sig + "&self" end
    else
      var ty_str = "?".to_string()
      match p.ty
      when Option::Some(t) then ty_str = docgen_format_type_expr(t)
      when Option::None => ()
      end
      if is_mut_param then sig = sig + "mut " end
      sig = sig + p.name + ": " + ty_str
    end
  end
  sig = sig + ")"

  match ret_type
  when Option::Some(rt) then sig = sig + " -> " + docgen_format_type_expr(rt)
  when Option::None => ()
  end

  sig
end

# ———————————————————————————————————————————————————————————————
# Doc Comment Extraction (read off the source at the AST spans)
# ———————————————————————————————————————————————————————————————

def offset_to_line(source: String, offset: UInt) -> UInt
  var line: UInt = 1
  var i: UInt = 0
  while i < offset && i < source.len() do
    if source.char_at(i) == '\n' then line = line + 1 end
    i = i + 1
  end
  line
end

def extract_doc_comment_from_source(source: String, offset: UInt) -> String
  # Walk backwards from offset to find consecutive # comment lines
  var lines = Vec::new()

  # Find the start of the current line
  var line_start = offset
  while line_start > 0 && source.char_at(line_start - 1) != '\n' do
    line_start = line_start - 1
  end

  # Move up to the previous line
  if line_start > 0 then
    var end_pos = line_start - 1  # skip the \n

    # Collect consecutive comment lines going upward
    while end_pos > 0 do
      # Find start of this line
      var ls = end_pos
      while ls > 0 && source.char_at(ls - 1) != '\n' do
        ls = ls - 1
      end

      let line = source.slice(ls, end_pos + 1).trim()

      if line.starts_with("#") then
        # Strip the leading # and optional space
        let content = if line.len() > 1 && line.char_at(1) == ' ' then
          line.slice(2, line.len())
        else
          line.slice(1, line.len())
        end
        lines.push(content)

        if ls == 0 then break end
        end_pos = ls - 1
      elsif line.is_empty() then
        # Allow one blank line within doc comments
        if !lines.is_empty() then break end
        if ls == 0 then break end
        end_pos = ls - 1
      else
        break
      end
    end
  end

  # Reverse since we collected bottom-up
  lines.reverse()
  lines.join("\n")
end

def extract_module_doc_comment(source: String) -> String
  # Module doc comment: first block of # comments at top of file
  var lines = Vec::new()
  var pos: UInt = 0

  while pos < source.len() do
    # Find end of current line
    var eol = pos
    while eol < source.len() && source.char_at(eol) != '\n' do
      eol = eol + 1
    end

    let line = source.slice(pos, eol).trim()

    if line.starts_with("#") then
      let content = if line.len() > 1 && line.char_at(1) == ' ' then
        line.slice(2, line.len())
      else
        line.slice(1, line.len())
      end
      lines.push(content)
    elsif line.is_empty() then
      if !lines.is_empty() then break end
    else
      break
    end

    pos = eol + 1
  end

  lines.join("\n")
end

# ———————————————————————————————————————————————————————————————
# Type Expression Formatting
# ———————————————————————————————————————————————————————————————

def docgen_format_type_expr(ty: TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Named(name, args) then
    if args.is_empty() then
      name.clone()
    else
      var s = name.clone() + "["
      for i in 0..args.len() do
        if i > 0 then s = s + ", " end
        s = s + docgen_format_type_expr(&args[i])
      end
      s + "]"
    end
  when TypeExprKind::Tuple(elems) then
    var s = "("
    for i in 0..elems.len() do
      if i > 0 then s = s + ", " end
      s = s + docgen_format_type_expr(&elems[i])
    end
    s + ")"
  when TypeExprKind::Fn(params, ret) then
    var s = "def("
    for i in 0..params.len() do
      if i > 0 then s = s + ", " end
      match params[i].convention
      when AccessConvention::Inout then s = s + "inout "
      when AccessConvention::Sink then s = s + "sink "
      when AccessConvention::Set then s = s + "set "
      when AccessConvention::Let then ()
      end
      s = s + docgen_format_type_expr(&params[i].ty)
    end
    s = s + ")"
    s + " -> " + docgen_format_type_expr(&ret)
  when TypeExprKind::Array(elem, size) then
    "[" + docgen_format_type_expr(&elem) + "; " + size.to_string() + "]"
  when TypeExprKind::Slice(inner) then
    "[" + docgen_format_type_expr(&inner) + "]"
  when TypeExprKind::Ptr(inner) then
    "*" + docgen_format_type_expr(&inner)
  when TypeExprKind::PtrMut(inner) then
    "*mut " + docgen_format_type_expr(&inner)
  when TypeExprKind::Async(inner) then
    "async " + docgen_format_type_expr(&inner)
  when TypeExprKind::Effect(name, inner) then
    name.clone() + " " + docgen_format_type_expr(&inner)
  when TypeExprKind::Path(p) then
    p.segments.join("::")
  when TypeExprKind::Unit then "()"
  when TypeExprKind::Never then "!"
  when TypeExprKind::Infer then "_"
  end  end  end
end

def module_name_from_path(path: String) -> String
  # Extract doc_module name from file path: "std/collections.tg" -> "collections"
  var name = path.clone()

  # Remove directory path
  match name.last_index_of("/")
  when Option::Some(idx) then name = name.slice(idx + 1, name.len())
  when Option::None => ()
  end

  # Remove.tg extension
  if name.ends_with(".tg") then
    name = name.slice(0, name.len() - 3)
  end

  name
end

# ———————————————————————————————————————————————————————————————
# Index Page Generation
# ———————————————————————————————————————————————————————————————

def render_index_html(modules: Vec[DocModule], config: DocConfig) -> String
  var html = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"
  html = html + "  <meta charset=\"utf-8\">\n"
  html = html + "  <title>" + config.project_name + " Documentation</title>\n"
  html = html + "  <style>body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }</style>\n"
  html = html + "</head>\n<body>\n"

  html = html + "<h1>" + config.project_name + " API Documentation</h1>\n"
  html = html + "<p>Version " + config.version + "</p>\n\n"

  html = html + "<h2>Modules</h2>\n<ul>\n"
  for m in modules do
    html = html + "<li><a href=\"" + m.name.clone() + ".html\">" + m.name.clone() + "</a>"
    match m.doc_string
    when Option::Some(d) =>
      let first_line = d.split("\n").first().unwrap_or("".to_string())
      html = html + " — " + std::doc_gen::escape_html(first_line)
    when Option::None => ()
    end
    html = html + "</li>\n"
  end
  html = html + "</ul>\n</body>\n</html>\n"
  html
end

def render_index_markdown(modules: Vec[DocModule], config: DocConfig) -> String
  var md = "# " + config.project_name + " API Documentation\n\n"
  md = md + "Version " + config.version + "\n\n"

  md = md + "## Modules\n\n"
  for m in modules do
    md = md + "- [" + m.name.clone() + "](" + m.name.clone() + ".md)"
    match m.doc_string
    when Option::Some(d) =>
      let first_line = d.split("\n").first().unwrap_or("".to_string())
      md = md + " — " + first_line
    when Option::None => ()
    end
    md = md + "\n"
  end

  md
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

pub def generate_docs(files: Vec[String], config: DocConfig) -> Result[UInt, String]
  # Create output directory
  mkdir_p(config.output_dir.clone())

  var modules = Vec::new()
  var errors = Vec::new()
  let std_config = to_std_config(config.clone())

  for file in files do
    match read_file(file.clone())
    when Result::Ok(source) then
      match extract_module(file.clone(), source, config.include_private)
      when Result::Ok(m) then modules.push(m)
      when Result::Err(e) then errors.push(e)
      end
    when Result::Err(e) then errors.push("Cannot read " + file + ": " + e)
    end
  end

  if !errors.is_empty() then
    for e in errors do eprintln("docgen warning: " + e) end
  end

  # Sort modules by name
  modules.sort_by(|a, b| a.name.cmp(&b.name))

  # Generate per-doc_module docs (the renderers are std::doc_gen's — the model
  # extracted from the compiler's AST above)
  for doc_module in modules do
    let content = std::doc_gen::generate_docs(&doc_module, &std_config)

    let ext = match config.format
    when DocFormat::Html then ".html"
    when DocFormat::Markdown then ".md"
    end

    let out_path = path_join(config.output_dir.clone(), doc_module.name.clone() + ext)
    match write_file(out_path.clone(), content)
    when Result::Ok(_) => ()
    when Result::Err(e) => return Result::Err("Write error: " + e)
    end
  end

  # Generate index
  let index_content = match config.format
  when DocFormat::Html then render_index_html(&modules, config)
  when DocFormat::Markdown then render_index_markdown(&modules, config)
  end

  let index_name = match config.format
  when DocFormat::Html then "index.html"
  when DocFormat::Markdown then "README.md"
  end

  let index_path = path_join(config.output_dir.clone(), index_name.to_string())
  match write_file(index_path, index_content)
  when Result::Ok(_) => ()
  when Result::Err(e) => return Result::Err("Write index error: " + e)
  end

  Result::Ok(modules.len())
end
