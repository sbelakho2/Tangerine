# Tangerine Compiler — Semantic Diagnostics (third-audit items 23 + 24)
# Self-hosting compiler written in Tangerine
#
# The PERSISTENT diagnostic layer over the ONE shared Diagnostic record
# (parser.tg): the STABLE diagnostic identity, the append-only store that
# survives a session revision, and the TYPED ExplainNode derivation trees
# the explain / repair-context consumers walk instead of re-parsing prose.
#
# WHY THIS MODULE IS A LEAF: it imports parser.tg (the Diagnostic record
# and the typed semantic payloads) and stable_ids.tg (the stable digest)
# only. parser.tg therefore cannot carry a typed StableDiagnosticId field
# (that would close an import cycle); Diagnostic.id is the canonical id
# TEXT render this module stamps (diagnostic_store_add_stamping) and the
# round-trip handle diagnostic.get consumes.
#
# STABLE DIAGNOSTIC ID (audit item 23; fourth-audit P1-1). A diagnostic's
# identity is TYPED and revision-stable: the diagnostic code plus a typed
# SUBJECT (what the diagnostic is about) plus a typed CAUSE (the
# obligation or the node/place the rejection was found at), digested over
# the typed fields ONLY:
#   - subject — the typed DiagnosticSubject union: Decl (a StableDeclId),
#               HIRNode (a StableHirNodeId), MIRNode (a StableMirNodeId),
#               Place (a StablePlaceId), Contract (a StableContractId),
#               TraitObligation (a TraitObligationId) or ABI (a
#               StableAbiSurfaceId), else "none". Derived from the typed
#               DiagnosticSemanticData where present (ownership place ->
#               Place with the stable place id; a MIR node key site ->
#               MIRNode; trait failure -> TraitObligation; effect
#               violation path head -> MIRNode cause + Decl subject), else
#               from the primary symbol's stable declaration (Decl), never
#               from the span.
#   - cause   — the typed DiagnosticCause: the cause subject (the place /
#               node the rejection was found at) plus the optional typed
#               obligation identity (TraitObligationId).
#   - code    — the ErrorCode render ("E0201", ...; "" when none).
# The SPAN is presentation metadata only: it rides DiagnosticRecord.span
# and the live Diagnostic.span, NEVER the identity. Duplicate occurrences
# within ONE snapshot are distinguished by the store-side collision_ordinal
# — a per-typed-identity counter starting at 0; the ordinal is the ONLY
# snapshot-scoped component and never encodes a span or text. Re-adding the
# SAME semantic content (message + the non-locator typed rows) under the
# same typed identity is IDEMPOTENT (the existing id is returned, the
# counter does not move): a comment insertion shifts spans and dense site
# locators only, so it never forks an existing error's identity, and an
# earlier UNRELATED diagnostic never consumes this identity's ordinal
# (counters are keyed by the typed identity, not by insertion order). Two
# DIFFERENT errors (different typed subject/cause) with equal text get
# different identities and different ids. digest_hi/digest_lo
# are the 128-bit stable digest of the canonical length-prefixed typed
# identity text; Eq/Hash compare the digest words only, like the
# stable_ids section-3/6 records.
#
# DIAGNOSTIC RECORD / STORE (audit item 23; fourth-audit P1-1).
# DiagnosticRecord is the PERSISTENT store form: id, message, span locator
# (presentation metadata, never identity), the typed payload's class word
# (semantic_kind) and the typed payload's RENDERED rows (related). The RICH
# typed payload stays on the live Diagnostic (parser.tg's semantic_data) —
# the record is the serializable projection, and diagnostic.get returns it
# as canonical rows. DiagnosticStore is append-only: by_id in insertion
# order + the typed-identity collision counters map; store_all re-renders
# the id-ordered view.
#
# EXPLAIN NODE (audit item 24 / item 52's typed follow-up). ExplainNode is
# the typed derivation tree:
#   kind     — the machine class word of the node ("ownership-rejection",
#              "type-mismatch", "bound-failure-chain", "reason", ...) —
#              the discriminator explain_node_find matches on.
#   subject  — the node's ONE rendered line text (sans indentation). An
#              empty subject (with empty fact/relation) makes the node a
#              pure CONTAINER: it renders no line but keeps its children.
#   relation — optional relation word; the reserved word "verbatim" marks
#              a reason row that carries its OWN embedded indentation and
#              is rendered WITHOUT the renderer's indent (the §34
#              constraint-chain rows — the byte-identity rule below).
#   fact     — optional reason text (used when subject is empty).
#   children — ordered child nodes.
# explain_node_render is the ONE renderer: line 0 = the root, two spaces
# per depth, verbatim rows emitted unchanged. It reproduces the §52
# explain_*_tree renders BYTE-IDENTICALLY (the effect evidence path is a
# NESTED chain: path[0] under "evidence path", path[i] under path[i-1],
# exactly the old 3 + i indent), so existing consumers hold.
# explain_node_find / explain_node_find_all are the machine lookups
# (pre-order, first match / all matches).
#
# DIAGNOSTIC EXPLAIN TREE. diagnostic_explain_node ports the §52
# semantic_query.tg per-diagnostic renderer onto ExplainNode: root = the
# primary symbol / semantic site / "diagnostic", children = the typed
# DiagnosticSemanticData leaves and the non-empty §34 *_trace row families
# (verbatim reason leaves). diagnostic_record_explain_node /
# diagnostic_record_repair_context render the STORE form (never message
# prose — the message travels through diagnostic.get's record rows, not
# the derivation tree).

use std::core::{Option, Result}
use std::collections::{Vec, Map}
use tg_compiler::token::{Span}
use tg_compiler::parser::{
  Diagnostic, DiagnosticSemanticData, DiagLevel, OwnershipDiagnosticData,
  TraitFailureData
}
use tg_compiler::stable_ids::{
  StableDeclId, StableHirNodeId, StableMirNodeId, StablePlaceId,
  StableContractId, StableAbiSurfaceId,
  stable_key_digest, stable_decl_of_key, stable_decl_identity_text_of,
  stable_place_of_text, stable_place_text_of,
  stable_hir_node_identity_text, stable_mir_node_key_of, stable_mir_node_of_key,
  stable_mir_node_id_of_generated
}

# ———————————————————————————————————————————————————————————————
# The typed DiagnosticSubject / DiagnosticCause union (fourth-audit P1-1)
# ———————————————————————————————————————————————————————————————
# ONE typed obligation identity: the failed obligation's
# "<trait> for <subject>" render plus the RESOLVED trait/subject stable
# declarations when the text boundary could parse them. digest words cover
# the typed fields (trait declaration identity words, subject declaration
# identity words, obligation text) length-prefixed — never a span.
pub struct TraitObligationId
  obligation: String = ""
  trait_decl: Option[StableDeclId] = Option::None
  subject_decl: Option[StableDeclId] = Option::None
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE typed diagnostic subject — the "what is this diagnostic about" union.
# kind is one of "decl" | "hir-node" | "mir-node" | "place" | "contract" |
# "trait-obligation" | "abi" | "none"; the matching P0-4/P0-7 stable id
# record rides its field. id is the typed id's canonical identity text
# (wire / collision-detection cargo) and id_hi/id_lo are its identity
# digest words — the subject digest folds kind + the typed id digest words,
# never a text field and never a span. display is presentation only.
pub struct DiagnosticSubject
  kind: String = "none"
  id: String = ""
  id_hi: UInt = 0
  id_lo: UInt = 0
  decl: Option[StableDeclId] = Option::None
  hir_node: Option[StableHirNodeId] = Option::None
  mir_node: Option[StableMirNodeId] = Option::None
  place: Option[StablePlaceId] = Option::None
  contract: Option[StableContractId] = Option::None
  trait_obligation: Option[TraitObligationId] = Option::None
  abi: Option[StableAbiSurfaceId] = Option::None
  display: String = ""
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE typed diagnostic cause: the cause subject (the place / node the
# rejection was found at) plus the optional typed obligation identity.
# kind is "subject" | "obligation" | "none".
pub struct DiagnosticCause
  kind: String = "none"
  subject: DiagnosticSubject = DiagnosticSubject {}
  obligation: Option[TraitObligationId] = Option::None
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# THE persistent diagnostic identity: the code + the typed subject + the
# typed cause + the within-snapshot collision ordinal. digest_hi/lo are the
# digest of the canonical typed identity preimage; Eq/Hash compare the
# digest words only (the pieces are collision cargo).
pub struct StableDiagnosticId
  code: String = ""
  subject: DiagnosticSubject = DiagnosticSubject {}
  cause: DiagnosticCause = DiagnosticCause {}
  collision_ordinal: Int = 0
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The dense span locator of a diagnostic ("<file>:<start>"; "" when the
# diagnostic carries no span) — PRESENTATION ONLY (DiagnosticRecord.span).
def diagnostic_span_locator(d: Diagnostic) -> String
  match d.span
  when Option::Some(sp) then sp.file.clone() + ":" + sp.start.to_string()
  when Option::None then "".to_string()
  end
end

# The length-prefixed identity segment ("<len>:<text>") — the injectivity
# convention of the composite identity texts (a helper mirror of
# stable_ids.tg's module-private stable_identity_lenpref, so this module
# stays a leaf).
def diagnostic_lenpref(piece: String) -> String
  piece.len().to_string() + ":" + piece
end

# The byte index of `needle` at or after `from` (-1 when absent) — the
# text-scan idiom of the stable_ids/semantic_delta helpers.
def diagnostic_index_of(s: String, needle: String, from: Int) -> Int
  if needle.len() == 0 then
    return -1
  end
  var i = from
  while i + needle.len() <= s.len() do
    if s.slice(i, i + needle.len()) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# ———— TraitObligationId ———

# The typed obligation id of its pieces: the digest folds the trait and
# subject declaration identity words (0/0 when unresolved) plus the
# obligation render, every piece length-prefixed.
pub def trait_obligation_id_of(
  obligation: String,
  trait_decl: Option[StableDeclId],
  subject_decl: Option[StableDeclId]
) -> TraitObligationId
  var text = diagnostic_lenpref("trait-obligation") + diagnostic_lenpref(&obligation)
  match trait_decl.clone()
  when Option::Some(d) then
    text = text + diagnostic_lenpref("trait") +
      diagnostic_lenpref(&d.digest_hi.to_string()) + diagnostic_lenpref(&d.digest_lo.to_string())
  when Option::None then
    text = text + diagnostic_lenpref("trait") + diagnostic_lenpref("0") + diagnostic_lenpref("0")
  end
  match subject_decl.clone()
  when Option::Some(d) then
    text = text + diagnostic_lenpref("subject") +
      diagnostic_lenpref(&d.digest_hi.to_string()) + diagnostic_lenpref(&d.digest_lo.to_string())
  when Option::None then
    text = text + diagnostic_lenpref("subject") + diagnostic_lenpref("0") + diagnostic_lenpref("0")
  end
  let digest = stable_key_digest(&text)
  TraitObligationId {
    obligation: obligation,
    trait_decl: trait_decl,
    subject_decl: subject_decl,
    digest_hi: digest.hi,
    digest_lo: digest.lo
  }
end

# The text-boundary obligation id: when the render carries the
# "<trait> for <subject>" separator, the resolved declarations are built
# through the total stable_decl_of_key boundary; otherwise the obligation
# render alone is the typed preimage.
pub def trait_obligation_id_of_text(obligation: String) -> TraitObligationId
  let mark = diagnostic_index_of(&obligation, " for ", 0)
  if mark > 0 then
    let trait_text = obligation.slice(0, mark)
    let subject_text = obligation.slice(mark + 5, obligation.len())
    if trait_text.len() > 0 && subject_text.len() > 0 then
      return trait_obligation_id_of(obligation.clone(),
        Option::Some(stable_decl_of_key(&trait_text)),
        Option::Some(stable_decl_of_key(&subject_text)))
    end
  end
  trait_obligation_id_of(obligation, Option::None, Option::None)
end

# The obligation's display render.
pub def trait_obligation_id_text(ob: TraitObligationId) -> String
  ob.obligation.clone()
end

# ———— DiagnosticSubject constructors ———

# The subject identity preimage: kind + the typed id's identity digest
# words, length-prefixed (the id TEXT is collision-detection cargo and
# never digested — a declaration rename or a display change leaves the
# typed digest untouched).
pub def diagnostic_subject_identity_key(subject: DiagnosticSubject) -> String
  diagnostic_lenpref("subject") + diagnostic_lenpref(&subject.kind) +
    diagnostic_lenpref(&subject.id_hi.to_string()) + diagnostic_lenpref(&subject.id_lo.to_string())
end

def diagnostic_subject_of_parts(
  kind: String, id: String, id_hi: UInt, id_lo: UInt, display: String
) -> DiagnosticSubject
  let text = diagnostic_lenpref("subject") + diagnostic_lenpref(&kind) +
    diagnostic_lenpref(&id_hi.to_string()) + diagnostic_lenpref(&id_lo.to_string())
  let digest = stable_key_digest(&text)
  DiagnosticSubject {
    kind: kind,
    id: id,
    id_hi: id_hi,
    id_lo: id_lo,
    display: display,
    digest_hi: digest.hi,
    digest_lo: digest.lo
  }
end

pub def diagnostic_subject_none() -> DiagnosticSubject
  diagnostic_subject_of_parts("none".to_string(), "".to_string(), 0, 0, "".to_string())
end

pub def diagnostic_subject_of_decl(decl: StableDeclId, display: String) -> DiagnosticSubject
  var subject = diagnostic_subject_of_parts("decl".to_string(),
    stable_decl_identity_text_of(decl.clone()), decl.digest_hi, decl.digest_lo, display)
  subject.decl = Option::Some(decl)
  subject
end

pub def diagnostic_subject_of_decl_key(key: String) -> DiagnosticSubject
  diagnostic_subject_of_decl(stable_decl_of_key(&key), key)
end

pub def diagnostic_subject_of_hir_node(node: StableHirNodeId, display: String) -> DiagnosticSubject
  var subject = diagnostic_subject_of_parts("hir-node".to_string(),
    stable_hir_node_identity_text(node.clone()), node.digest_hi, node.digest_lo, display)
  subject.hir_node = Option::Some(node)
  subject
end

pub def diagnostic_subject_of_mir_node(node: StableMirNodeId, display: String) -> DiagnosticSubject
  var subject = diagnostic_subject_of_parts("mir-node".to_string(),
    stable_mir_node_key_of(node.clone()), node.digest_hi, node.digest_lo, display)
  subject.mir_node = Option::Some(node)
  subject
end

pub def diagnostic_subject_of_place(place: StablePlaceId, display: String) -> DiagnosticSubject
  var subject = diagnostic_subject_of_parts("place".to_string(),
    stable_place_text_of(place.clone()), place.digest_hi, place.digest_lo, display)
  subject.place = Option::Some(place)
  subject
end

# The text-boundary place subject ("r", "self.field"); Option::None
# subject when the text is not a canonical place (dynamic indexes are not
# stable places — the caller falls back to the symbol declaration).
pub def diagnostic_subject_of_place_text(text: String) -> DiagnosticSubject
  match stable_place_of_text(&text)
  when Option::Some(place) then diagnostic_subject_of_place(place, text)
  when Option::None then diagnostic_subject_none()
  end
end

pub def diagnostic_subject_of_contract(contract: StableContractId) -> DiagnosticSubject
  var subject = diagnostic_subject_of_parts("contract".to_string(),
    contract.stable_key.clone(), contract.digest_hi, contract.digest_lo, contract.stable_key.clone())
  subject.contract = Option::Some(contract)
  subject
end

pub def diagnostic_subject_of_obligation(ob: TraitObligationId, display: String) -> DiagnosticSubject
  var subject = diagnostic_subject_of_parts("trait-obligation".to_string(),
    ob.obligation.clone(), ob.digest_hi, ob.digest_lo, display)
  subject.trait_obligation = Option::Some(ob)
  subject
end

pub def diagnostic_subject_of_abi(abi: StableAbiSurfaceId) -> DiagnosticSubject
  var subject = diagnostic_subject_of_parts("abi".to_string(),
    abi.stable_key.clone(), abi.digest_hi, abi.digest_lo, abi.stable_key.clone())
  subject.abi = Option::Some(abi)
  subject
end

# ———— DiagnosticCause constructors ———

def diagnostic_cause_of_parts(
  kind: String, subject: DiagnosticSubject, obligation: Option[TraitObligationId]
) -> DiagnosticCause
  var text = diagnostic_lenpref("cause") + diagnostic_lenpref(&kind) +
    diagnostic_lenpref(&diagnostic_subject_identity_key(subject.clone()))
  match obligation.clone()
  when Option::Some(ob) then
    text = text + diagnostic_lenpref(&ob.digest_hi.to_string()) +
      diagnostic_lenpref(&ob.digest_lo.to_string()) + diagnostic_lenpref(&ob.obligation)
  when Option::None then
    text = text + diagnostic_lenpref("0") + diagnostic_lenpref("0") + diagnostic_lenpref("")
  end
  let digest = stable_key_digest(&text)
  DiagnosticCause {
    kind: kind,
    subject: subject,
    obligation: obligation,
    digest_hi: digest.hi,
    digest_lo: digest.lo
  }
end

pub def diagnostic_cause_subject(subject: DiagnosticSubject) -> DiagnosticCause
  diagnostic_cause_of_parts("subject".to_string(), subject, Option::None)
end

pub def diagnostic_cause_obligation(
  subject: DiagnosticSubject, obligation: TraitObligationId
) -> DiagnosticCause
  diagnostic_cause_of_parts("obligation".to_string(), subject, Option::Some(obligation))
end

pub def diagnostic_cause_none() -> DiagnosticCause
  diagnostic_cause_of_parts("none".to_string(), diagnostic_subject_none(), Option::None)
end

# The cause identity preimage: the cause kind + the cause subject's typed
# identity + the optional obligation's TYPED DIGEST WORDS (the obligation
# render text never enters the preimage — the digest words already cover
# the resolved trait/subject declarations and the obligation render).
pub def diagnostic_cause_identity_key(cause: DiagnosticCause) -> String
  var text = diagnostic_lenpref("cause") + diagnostic_lenpref(&cause.kind) +
    diagnostic_lenpref(&diagnostic_subject_identity_key(cause.subject.clone()))
  match cause.obligation.clone()
  when Option::Some(ob) then
    text = text + diagnostic_lenpref("obligation") +
      diagnostic_lenpref(&ob.digest_hi.to_string()) + diagnostic_lenpref(&ob.digest_lo.to_string())
  when Option::None then
    text = text + diagnostic_lenpref("obligation") + diagnostic_lenpref("0") + diagnostic_lenpref("0")
  end
  text
end

pub def diagnostic_cause_obligation_text(cause: DiagnosticCause) -> String
  match cause.obligation
  when Option::Some(ob) then ob.obligation.clone()
  when Option::None then "".to_string()
  end
end

# ———— StableDiagnosticId ———

# The typed identity key WITHOUT the ordinal: the store's counter key and
# the idempotency comparison.
pub def diagnostic_identity_key(
  subject: DiagnosticSubject, cause: DiagnosticCause, code: String
) -> String
  diagnostic_lenpref("diagnostic") + diagnostic_lenpref(&code) +
    diagnostic_lenpref(&diagnostic_subject_identity_key(subject.clone())) +
    diagnostic_lenpref(&diagnostic_cause_identity_key(cause.clone()))
end

# The canonical identity preimage: the typed identity key PLUS the
# within-snapshot collision ordinal.
def stable_diagnostic_id_canonical_text(
  code: String, subject: DiagnosticSubject, cause: DiagnosticCause, collision_ordinal: Int
) -> String
  diagnostic_identity_key(subject, cause, code) +
    diagnostic_lenpref(&collision_ordinal.to_string())
end

# The typed id constructor: the 128-bit digest of the typed preimage.
pub def stable_diagnostic_id_typed(
  code: String,
  subject: DiagnosticSubject,
  cause: DiagnosticCause,
  collision_ordinal: Int
) -> StableDiagnosticId
  let text = stable_diagnostic_id_canonical_text(
    code.clone(), subject.clone(), cause.clone(), collision_ordinal)
  let digest = stable_key_digest(&text)
  StableDiagnosticId {
    code: code,
    subject: subject,
    cause: cause,
    collision_ordinal: collision_ordinal,
    digest_hi: digest.hi,
    digest_lo: digest.lo
  }
end

# The legacy TEXT-boundary constructor (API compatibility only): the typed
# subject/cause are built from the owner/cause text through the stable_ids
# boundary constructors. The persistent store path NEVER calls this builder
# — it derives the typed subject from the live Diagnostic.
pub def stable_diagnostic_id_of(
  owner: String,
  cause: String,
  code: String,
  obligation: String,
  collision_ordinal: Int
) -> StableDiagnosticId
  let subject = diagnostic_subject_of_text_boundary(owner.clone(), cause.clone())
  var cs = diagnostic_cause_subject(subject.clone())
  if obligation.len() > 0 then
    cs = diagnostic_cause_obligation(subject.clone(), trait_obligation_id_of_text(obligation))
  end
  stable_diagnostic_id_typed(code, subject, cs, collision_ordinal)
end

# The legacy text-boundary subject: the owner def key's stable declaration
# when one is known, else a parses-as-place cause subject.
def diagnostic_subject_of_text_boundary(owner: String, cause: String) -> DiagnosticSubject
  if owner.len() > 0 then
    return diagnostic_subject_of_decl_key(owner)
  end
  if cause.len() > 0 then
    let subject = diagnostic_subject_of_place_text(cause.clone())
    if subject.kind != "none" then
      return subject
    end
  end
  diagnostic_subject_none()
end

# The canonical id RENDER (diagnostics cargo / Diagnostic.id / the
# diagnostic.get key): the code, the typed subject kind + identity text +
# digest words, the typed cause kind + obligation render and the ordinal.
# This is NOT the digest preimage — the digest words are the identity; this
# text is the wire / round-trip handle.
pub def stable_diagnostic_id_text(id: StableDiagnosticId) -> String
  "diagnostic|" + id.code.clone() + "|" + id.subject.kind.clone() + "|" + id.subject.id.clone() +
    "|" + id.subject.id_hi.to_string() + "-" + id.subject.id_lo.to_string() +
    "|" + id.cause.kind.clone() + "|" + diagnostic_cause_obligation_text(id.cause.clone()) +
    "|#" + id.collision_ordinal.to_string()
end

# ———— Eq/Hash (the digest-words fold; the pieces are collision cargo) ————

impl Eq for StableDiagnosticId
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableDiagnosticId
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

# ———————————————————————————————————————————————————————————————
# The typed derivation of a live Diagnostic's subject / cause
# ———————————————————————————————————————————————————————————————

# The primary symbol's stable declaration subject (the documented fallback
# when only a symbol is known).
pub def diagnostic_subject_of_symbol(d: Diagnostic) -> DiagnosticSubject
  match d.primary_symbol
  when Option::Some(s) then
    if s.len() > 0 then diagnostic_subject_of_decl_key(s.clone()) else diagnostic_subject_none() end
  when Option::None then diagnostic_subject_none()
  end
end

# The typed subject of a diagnostic: the typed DiagnosticSemanticData's
# stable fact where present, the primary symbol's declaration otherwise.
# SPANS NEVER PARTICIPATE. Ownership: the place text -> the structured
# StablePlaceId. Type mismatch: a MIR node key site -> MIRNode (the site
# payload carries no HIR-node key grammar; HIRNode subjects are constructed
# by callers holding a StableHirNodeId), else the symbol declaration. Trait
# failure: the typed TraitObligation subject (the obligation id; the
# obligation also rides the cause). Effect violation: the symbol
# declaration (the evidence path head rides the cause as a MIRNode).
pub def diagnostic_subject_of(d: Diagnostic) -> DiagnosticSubject
  match d.semantic_data
  when Option::Some(sd) then
    match sd
    when DiagnosticSemanticData::Ownership(od) then
      if od.place.len() > 0 then
        let subject = diagnostic_subject_of_place_text(od.place.clone())
        if subject.kind == "place" then subject else diagnostic_subject_of_symbol(&d) end
      else
        diagnostic_subject_of_symbol(&d)
      end
    when DiagnosticSemanticData::TypeMismatch(tm) then
      if tm.site.len() > 0 then
        match stable_mir_node_of_key(&tm.site)
        when Option::Some(node) then diagnostic_subject_of_mir_node(node, tm.site.clone())
        when Option::None then diagnostic_subject_of_symbol(&d)
        end
      else
        diagnostic_subject_of_symbol(&d)
      end
    when DiagnosticSemanticData::TraitFailure(tf) then
      if tf.obligation.len() > 0 then
        diagnostic_subject_of_obligation(
          trait_obligation_id_of_text(tf.obligation.clone()), tf.obligation.clone())
      else
        diagnostic_subject_of_symbol(&d)
      end
    when DiagnosticSemanticData::EffectViolation(_) then
      diagnostic_subject_of_symbol(&d)
    end
  when Option::None then diagnostic_subject_of_symbol(&d)
  end
end

# The typed cause: trait failure -> the typed obligation id; effect
# violation -> the evidence path head as a MIRNode; every other class ->
# the subject itself (the cause place/node).
pub def diagnostic_cause_of(d: Diagnostic) -> DiagnosticCause
  let subject = diagnostic_subject_of(&d)
  match d.semantic_data
  when Option::Some(sd) then
    match sd
    when DiagnosticSemanticData::TraitFailure(tf) then
      if tf.obligation.len() > 0 then
        diagnostic_cause_obligation(subject, trait_obligation_id_of_text(tf.obligation.clone()))
      else
        diagnostic_cause_subject(subject)
      end
    when DiagnosticSemanticData::EffectViolation(ev) then
      if ev.path.len() > 0 then
        let head = ev.path[0].clone()
        let node = stable_mir_node_id_of_generated(head.clone(), head.clone(),
          "diagnostic", "effect-evidence-head", 0)
        diagnostic_cause_subject(diagnostic_subject_of_mir_node(node, head))
      else
        diagnostic_cause_subject(subject)
      end
    when _ then diagnostic_cause_subject(subject)
    end
  when Option::None then diagnostic_cause_subject(subject)
  end
end

# The presentation owner anchor: the subject's display render (never
# identity).
pub def stable_diagnostic_owner(d: Diagnostic) -> String
  let subject = diagnostic_subject_of(&d)
  if subject.display.len() > 0 then subject.display.clone() else subject.id.clone() end
end

# The presentation cause anchor: the cause subject's display render (never
# identity).
pub def stable_diagnostic_cause(d: Diagnostic) -> String
  let cause = diagnostic_cause_of(&d)
  if cause.subject.display.len() > 0 then cause.subject.display.clone() else cause.subject.id.clone() end
end

# The code component: the ErrorCode render ("" when none).
pub def stable_diagnostic_code(d: Diagnostic) -> String
  match d.code
  when Option::Some(c) then c.clone()
  when Option::None then "".to_string()
  end
end

# The obligation component: the typed TraitFailureData obligation render
# ("" for every other payload class and a payload-less diagnostic).
pub def stable_diagnostic_obligation(d: Diagnostic) -> String
  diagnostic_cause_obligation_text(diagnostic_cause_of(&d))
end

# The legacy text-level tuple key — the API-compatibility boundary only.
pub def stable_diagnostic_tuple_key(
  owner: String, cause: String, code: String, obligation: String
) -> String
  let subject = diagnostic_subject_of_text_boundary(owner.clone(), cause.clone())
  var cs = diagnostic_cause_subject(subject.clone())
  if obligation.len() > 0 then
    cs = diagnostic_cause_obligation(subject.clone(), trait_obligation_id_of_text(obligation))
  end
  diagnostic_identity_key(subject, cs, code)
end

# ———————————————————————————————————————————————————————————————
# DiagnosticRecord — the persistent store form
# ———————————————————————————————————————————————————————————————
# id / message / span / semantic_kind are the scalar spine; related
# carries the TYPED payload's canonical rendered rows (the repair context
# the store form can reconstruct without the live Diagnostic):
#   ownership       place:<p> state_before:<s> operation:<o>
#                   consumed_at:<site> rejected_at:<site> type:<t>
#   type_mismatch   expected:<e> actual:<a> site:<locator>
#   trait_failure   obligation:<ob> rejected_candidate:<render>...
#   effect_violation effect:<ann> evidence:<i>:<fn>...
# Rows are emitted in the payload's field order; the message NEVER enters
# the derivation rows (it is the presentation spine and travels through
# diagnostic.get's record rows).

pub struct DiagnosticRecord
  id: StableDiagnosticId
  message: String
  span: String
  semantic_kind: String
  related: Vec[String] = Vec::new()
end

pub def diagnostic_semantic_data_kind(d: Diagnostic) -> String
  match d.semantic_data
  when Option::Some(sd) then
    match sd
    when DiagnosticSemanticData::Ownership(_) then "ownership"
    when DiagnosticSemanticData::TypeMismatch(_) then "type_mismatch"
    when DiagnosticSemanticData::TraitFailure(_) then "trait_failure"
    when DiagnosticSemanticData::EffectViolation(_) then "effect_violation"
    end
  when Option::None then "none"
  end
end

pub def diagnostic_semantic_data_rows(d: Diagnostic) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  match d.semantic_data
  when Option::Some(sd) then
    match sd
    when DiagnosticSemanticData::Ownership(od) then
      if od.place.len() > 0 then rows.push("place:" + od.place.clone()) end
      if od.state_before.len() > 0 then rows.push("state_before:" + od.state_before.clone()) end
      if od.operation.len() > 0 then rows.push("operation:" + od.operation.clone()) end
      if od.consume_site.len() > 0 then rows.push("consumed_at:" + od.consume_site.clone()) end
      if od.use_site.len() > 0 then rows.push("rejected_at:" + od.use_site.clone()) end
      if od.type_id.len() > 0 then rows.push("type:" + od.type_id.clone()) end
    when DiagnosticSemanticData::TypeMismatch(tm) then
      if tm.expected.len() > 0 then rows.push("expected:" + tm.expected.clone()) end
      if tm.actual.len() > 0 then rows.push("actual:" + tm.actual.clone()) end
      if tm.site.len() > 0 then rows.push("site:" + tm.site.clone()) end
    when DiagnosticSemanticData::TraitFailure(tf) then
      if tf.obligation.len() > 0 then rows.push("obligation:" + tf.obligation.clone()) end
      for rc in tf.rejected_candidates do
        rows.push("rejected_candidate:" + rc.clone())
      end
    when DiagnosticSemanticData::EffectViolation(ev) then
      if ev.effect.len() > 0 then rows.push("effect:" + ev.effect.clone()) end
      var pi = 0
      for p in ev.path do
        rows.push("evidence:" + pi.to_string() + ":" + p.clone())
        pi = pi + 1
      end
    end
  when Option::None then ()
  end
  rows
end

def diagnostic_content_key_of_parts(
  message: String, kind: String, rows: Vec[String]
) -> String
  var text = diagnostic_lenpref(&message) + diagnostic_lenpref(&kind)
  for r in rows do
    text = text + diagnostic_lenpref(&r)
  end
  text
end

# Whether a typed row is a dense SITE locator ("consumed_at:", "rejected_at:",
# "site:") — presentation metadata that never participates in the
# idempotency content key (so a comment insertion that shifts a byte offset
# never forks an existing diagnostic's identity).
def diagnostic_content_row_is_presentation(row: String) -> Bool
  row.starts_with("consumed_at:") || row.starts_with("rejected_at:") || row.starts_with("site:")
end

# The content key of a LIVE diagnostic (message, class, the typed NON-SITE
# rows) — the idempotency comparison of diagnostic_store_add. The span and
# the dense site rows are presentation metadata and are deliberately
# EXCLUDED.
pub def diagnostic_content_key(d: Diagnostic) -> String
  var rows: Vec[String] = Vec::new()
  for r in diagnostic_semantic_data_rows(&d) do
    if !diagnostic_content_row_is_presentation(r.clone()) then
      rows.push(r.clone())
    end
  end
  diagnostic_content_key_of_parts(d.message.clone(), diagnostic_semantic_data_kind(&d), rows)
end

pub def diagnostic_record_content_key(r: DiagnosticRecord) -> String
  var rows: Vec[String] = Vec::new()
  for row in r.related do
    if !diagnostic_content_row_is_presentation(row.clone()) then
      rows.push(row.clone())
    end
  end
  diagnostic_content_key_of_parts(r.message.clone(), r.semantic_kind.clone(), rows)
end

# The persistent projection of a live diagnostic under an assigned id.
pub def diagnostic_record_of(d: Diagnostic, id: StableDiagnosticId) -> DiagnosticRecord
  DiagnosticRecord {
    id: id,
    message: d.message.clone(),
    span: diagnostic_span_locator(&d),
    semantic_kind: diagnostic_semantic_data_kind(&d),
    related: diagnostic_semantic_data_rows(&d)
  }
end

# ———————————————————————————————————————————————————————————————
# DiagnosticStore — the retained, append-only store
# ———————————————————————————————————————————————————————————————

pub struct DiagnosticStore
  by_id: Vec[DiagnosticRecord] = Vec::new()
  counters: Map[String, Int] = Map::new()
end

pub def new_diagnostic_store() -> DiagnosticStore
  DiagnosticStore { by_id: Vec::new(), counters: Map::new() }
end

# Whether a stored record's TYPED identity equals (code, subject, cause):
# the typed identity key comparison — no text field, no span, no ordinal.
def diagnostic_record_identity_matches(
  r: DiagnosticRecord, subject: DiagnosticSubject, cause: DiagnosticCause, code: String
) -> Bool
  diagnostic_identity_key(r.id.subject.clone(), r.id.cause.clone(), r.id.code.clone()) ==
    diagnostic_identity_key(subject, cause, code)
end

# Add ONE diagnostic: returns the existing id when the SAME content under
# the same typed identity is already stored (idempotent); otherwise
# assigns the typed identity's next collision ordinal and appends the
# record. The counter is keyed by the TYPED identity key (code + subject +
# cause digest words), so genuinely repeated identical causes (same typed
# identity, different non-locator content) get increasing ordinals while a
# re-run of an unchanged compile returns the same ids. The ordinal is the
# ONLY snapshot-scoped component of the id; it never encodes a span or a
# text field.
pub def diagnostic_store_add(inout store: DiagnosticStore, diagnostic: Diagnostic) -> StableDiagnosticId
  let subject = diagnostic_subject_of(&diagnostic)
  let cause = diagnostic_cause_of(&diagnostic)
  let code = stable_diagnostic_code(&diagnostic)
  let identity_key = diagnostic_identity_key(subject.clone(), cause.clone(), code.clone())
  let content = diagnostic_content_key(&diagnostic)
  var i = 0
  while i < store.by_id.len() do
    let r = store.by_id[i].clone()
    if diagnostic_record_identity_matches(
        &r, subject.clone(), cause.clone(), code.clone()) &&
       diagnostic_record_content_key(&r) == content then
      return r.id.clone()
    end
    i = i + 1
  end
  let ordinal = store.counters.get(identity_key.clone()).unwrap_or(0)
  store.counters.insert(identity_key.clone(), ordinal + 1)
  let id = stable_diagnostic_id_typed(code, subject, cause, ordinal)
  store.by_id.push(diagnostic_record_of(&diagnostic, id.clone()))
  id
end

pub def diagnostic_store_add_all(
  inout store: DiagnosticStore, diagnostics: Vec[Diagnostic]
) -> Vec[StableDiagnosticId]
  var out: Vec[StableDiagnosticId] = Vec::new()
  for d in diagnostics do
    out.push(diagnostic_store_add(store, d.clone()))
  end
  out
end

# Store a diagnostic and STAMP its Diagnostic.id field with the canonical
# id render — the round-trip handle diagnostic.get consumes.
pub def diagnostic_store_add_stamping(
  inout store: DiagnosticStore, inout diagnostic: Diagnostic
) -> StableDiagnosticId
  let id = diagnostic_store_add(store, diagnostic.clone())
  diagnostic.id = Option::Some(stable_diagnostic_id_text(id.clone()))
  id
end

pub def store_len(store: DiagnosticStore) -> Int
  store.by_id.len()
end

def store_record_lt(a: DiagnosticRecord, b: DiagnosticRecord) -> Bool
  stable_diagnostic_id_text(a.id.clone()) < stable_diagnostic_id_text(b.id.clone())
end

# The id-ordered store view (a fresh vector; insertion order never changes).
pub def store_all(store: DiagnosticStore) -> Vec[DiagnosticRecord]
  var out: Vec[DiagnosticRecord] = Vec::new()
  for r in store.by_id do
    out.push(r.clone())
  end
  out.sort_by(|a, b| store_record_lt(a, b))
  out
end

pub def store_get(store: DiagnosticStore, id_text: String) -> Option[DiagnosticRecord]
  for r in store.by_id do
    if stable_diagnostic_id_text(r.id.clone()) == id_text then
      return Option::Some(r.clone())
    end
  end
  Option::None
end

pub def store_get_by_id(store: DiagnosticStore, id: StableDiagnosticId) -> Option[DiagnosticRecord]
  for r in store.by_id do
    if r.id.digest_hi == id.digest_hi && r.id.digest_lo == id.digest_lo then
      return Option::Some(r.clone())
    end
  end
  Option::None
end

# The diagnostic-op selector: a plain integer arg selects by the
# id-ordered store_all index; any other text is an exact id render.
pub def store_match(store: DiagnosticStore, arg: String) -> Option[DiagnosticRecord]
  match arg.parse_int()
  when Result::Ok(idx) then
    let all = store_all(store.clone())
    if idx >= 0 && idx < all.len() then
      return Option::Some(all[idx].clone())
    end
  when Result::Err(_) then ()
  end
  store_get(store, arg)
end

# The diagnostic.get rows: the id first, then the record spine and every
# typed related row (sorted after the id/span/class prefix, so the answer
# is deterministic whatever the append order was).
pub def diagnostic_record_get_rows(record: DiagnosticRecord) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  rows.push("id:" + stable_diagnostic_id_text(record.id.clone()))
  rows.push("message:" + record.message.clone())
  rows.push("span:" + record.span.clone())
  rows.push("semantic_kind:" + record.semantic_kind.clone())
  for r in record.related do
    rows.push("related:" + r.clone())
  end
  rows
end

# The repair context of the STORE form: the id + the typed class + every
# typed fact row. Never message prose, never a fabricated candidate.
pub def diagnostic_record_repair_context(record: DiagnosticRecord) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  rows.push("id:" + stable_diagnostic_id_text(record.id.clone()))
  rows.push("context:" + record.semantic_kind.clone())
  for r in record.related do
    rows.push("fact:" + r.clone())
  end
  rows
end

# ———————————————————————————————————————————————————————————————
# ExplainNode — the typed derivation tree
# ———————————————————————————————————————————————————————————————

pub struct ExplainNode
  kind: String
  subject: String
  relation: String
  fact: String
  children: Vec[ExplainNode] = Vec::new()
end

pub def explain_node(kind: String, subject: String, relation: String, fact: String) -> ExplainNode
  ExplainNode {
    kind: kind,
    subject: subject,
    relation: relation,
    fact: fact,
    children: Vec::new()
  }
end

# A one-line node: subject = the exact line text (sans indentation).
pub def explain_text_node(kind: String, text: String) -> ExplainNode
  explain_node(kind, text, "".to_string(), "".to_string())
end

# A reason row rendered VERBATIM (no renderer indentation — the row
# carries its own; the §34 constraint chains).
pub def explain_verbatim_node(kind: String, row: String) -> ExplainNode
  explain_node(kind, row, "verbatim".to_string(), "".to_string())
end

# A pure container: no line of its own, children only.
pub def explain_container_node(kind: String, children: Vec[ExplainNode]) -> ExplainNode
  ExplainNode {
    kind: kind,
    subject: "".to_string(),
    relation: "".to_string(),
    fact: "".to_string(),
    children: children
  }
end

pub def explain_node_with_children(
  kind: String, subject: String, relation: String, fact: String, children: Vec[ExplainNode]
) -> ExplainNode
  ExplainNode {
    kind: kind,
    subject: subject,
    relation: relation,
    fact: fact,
    children: children
  }
end

pub def explain_node_child(node: ExplainNode, child: ExplainNode) -> ExplainNode
  var children = node.children.clone()
  children.push(child)
  ExplainNode {
    kind: node.kind.clone(),
    subject: node.subject.clone(),
    relation: node.relation.clone(),
    fact: node.fact.clone(),
    children: children
  }
end

pub def explain_node_add_child(inout node: ExplainNode, child: ExplainNode) -> Unit
  node.children.push(child)
  ()
end

def explain_node_indent(depth: Int) -> String
  var s = ""
  var i = 0
  while i < depth do
    s = s + "  "
    i = i + 1
  end
  s
end

def explain_node_line(node: ExplainNode) -> String
  if node.subject.len() > 0 then
    node.subject.clone()
  elsif node.fact.len() > 0 then
    node.fact.clone()
  elsif node.relation.len() > 0 && node.relation != "verbatim" then
    node.kind.clone() + " " + node.relation.clone()
  else
    "".to_string()
  end
end

def explain_node_render_into(node: ExplainNode, depth: Int, inout out: Vec[String]) -> Unit
  let text = explain_node_line(&node)
  if node.relation == "verbatim" then
    if text.len() > 0 then
      out.push(text)
    end
  else
    if text.len() > 0 then
      out.push(explain_node_indent(depth) + text)
    end
  end
  for c in node.children do
    explain_node_render_into(c.clone(), depth + 1, &mut out)
  end
  ()
end

# The ONE renderer: indented lines in display order (line 0 = the root,
# two spaces per depth); "verbatim" rows are emitted unchanged. The
# output is byte-identical to the §52 string trees.
pub def explain_node_render(node: ExplainNode) -> Vec[String]
  var out: Vec[String] = Vec::new()
  explain_node_render_into(node, 0, &mut out)
  out
end

# The first node of the kind in pre-order (Option::None when absent).
pub def explain_node_find(node: ExplainNode, kind: String) -> Option[ExplainNode]
  if node.kind == kind then
    return Option::Some(node.clone())
  end
  for c in node.children do
    match explain_node_find(c.clone(), kind.clone())
    when Option::Some(found) then return Option::Some(found)
    when Option::None then ()
    end
  end
  Option::None
end

def explain_node_find_all_into(node: ExplainNode, kind: String, inout out: Vec[ExplainNode]) -> Unit
  if node.kind == kind then
    out.push(node.clone())
  end
  for c in node.children do
    explain_node_find_all_into(c.clone(), kind.clone(), &mut out)
  end
  ()
end

# Every node of the kind, pre-order.
pub def explain_node_find_all(node: ExplainNode, kind: String) -> Vec[ExplainNode]
  var out: Vec[ExplainNode] = Vec::new()
  explain_node_find_all_into(node, kind, &mut out)
  out
end

pub def explain_verbatim_row_nodes(kind: String, rows: Vec[String]) -> Vec[ExplainNode]
  var out: Vec[ExplainNode] = Vec::new()
  for r in rows do
    out.push(explain_verbatim_node(kind.clone(), r.clone()))
  end
  out
end

# ———————————————————————————————————————————————————————————————
# The per-Diagnostic typed derivation tree
# ———————————————————————————————————————————————————————————————

# The effect evidence path as a NESTED chain: path[0] is the chain root
# and every later hop is its child, so the render indents each hop one
# level deeper (the old renderer's 3 + i depths). Callers guard
# path.len() > 1.
def effect_evidence_chain_node(path: Vec[String]) -> ExplainNode
  var i = path.len() - 1
  var chain = explain_text_node("effect-evidence".to_string(), path[i].clone())
  while i > 0 do
    i = i - 1
    chain = explain_node_child(
      explain_text_node("effect-evidence".to_string(), path[i].clone()), chain)
  end
  chain
end

# The typed payload of the diagnostic as ONE class node (children = the
# record's real fields, at depth 2 under the class node's depth 1). The
# rendered lines are EXACTLY the §52 explain_diagnostic typed leaves.
def diagnostic_typed_leaf_nodes(sd: DiagnosticSemanticData) -> Vec[ExplainNode]
  var out: Vec[ExplainNode] = Vec::new()
  match sd
  when DiagnosticSemanticData::Ownership(od) then
    var node = explain_text_node("ownership-rejection".to_string(), "ownership rejection".to_string())
    node = explain_node_child(node, explain_text_node("ownership-place".to_string(), "place " + od.place.clone()))
    node = explain_node_child(node, explain_text_node("ownership-state-before".to_string(), "state before " + od.state_before.clone()))
    node = explain_node_child(node, explain_text_node("ownership-operation".to_string(), "operation " + od.operation.clone()))
    if od.consume_site.len() > 0 then
      node = explain_node_child(node, explain_text_node("ownership-consume-site".to_string(), "consumed at " + od.consume_site.clone()))
    end
    if od.use_site.len() > 0 then
      node = explain_node_child(node, explain_text_node("ownership-use-site".to_string(), "rejected at " + od.use_site.clone()))
    end
    if od.type_id.len() > 0 then
      node = explain_node_child(node, explain_text_node("ownership-type".to_string(), "type " + od.type_id.clone()))
    end
    out.push(node)
  when DiagnosticSemanticData::TypeMismatch(tm) then
    var node = explain_text_node("type-mismatch".to_string(), "type mismatch".to_string())
    if tm.expected.len() > 0 then
      node = explain_node_child(node, explain_text_node("type-expected".to_string(), "expected " + tm.expected.clone()))
    end
    if tm.actual.len() > 0 then
      node = explain_node_child(node, explain_text_node("type-actual".to_string(), "actual " + tm.actual.clone()))
    end
    if tm.site.len() > 0 then
      node = explain_node_child(node, explain_text_node("type-site".to_string(), "site " + tm.site.clone()))
    end
    out.push(node)
  when DiagnosticSemanticData::TraitFailure(tf) then
    var node = explain_text_node("trait-failure".to_string(), "trait failure".to_string())
    if tf.obligation.len() > 0 then
      node = explain_node_child(node, explain_text_node("trait-obligation".to_string(), "obligation " + tf.obligation.clone()))
    end
    if tf.rejected_candidates.len() > 0 then
      var rej = explain_text_node("trait-rejected-candidates".to_string(), "rejected candidates".to_string())
      for rc in tf.rejected_candidates do
        rej = explain_node_child(rej, explain_text_node("trait-rejected-candidate".to_string(), rc.clone()))
      end
      node = explain_node_child(node, rej)
    end
    out.push(node)
  when DiagnosticSemanticData::EffectViolation(ev) then
    var node = explain_text_node("effect-violation".to_string(), "effect violation".to_string())
    node = explain_node_child(node, explain_text_node("effect-claim".to_string(), "claim " + ev.effect.clone()))
    if ev.path.len() > 1 then
      node = explain_node_child(node,
        explain_node_child(explain_text_node("effect-evidence-path".to_string(), "evidence path".to_string()),
          effect_evidence_chain_node(ev.path.clone())))
    else
      node = explain_node_child(node, explain_text_node("effect-no-evidence".to_string(), "no evidence leaf reachable".to_string()))
    end
    out.push(node)
  end
  out
end

# The non-empty §34 *_trace row families as label nodes with VERBATIM
# reason children, in the canonical family order (capability, ownership,
# effect, constraint, trait).
def diagnostic_trace_family_nodes(d: Diagnostic) -> Vec[ExplainNode]
  var out: Vec[ExplainNode] = Vec::new()
  if d.capability_trace.len() > 0 then
    out.push(explain_node_with_children("trace-capability".to_string(), "capability trace rows".to_string(),
      "".to_string(), "".to_string(),
      explain_verbatim_row_nodes("reason".to_string(), d.capability_trace.clone())))
  end
  if d.ownership_trace.len() > 0 then
    out.push(explain_node_with_children("trace-ownership".to_string(), "ownership trace rows".to_string(),
      "".to_string(), "".to_string(),
      explain_verbatim_row_nodes("reason".to_string(), d.ownership_trace.clone())))
  end
  if d.effect_trace.len() > 0 then
    out.push(explain_node_with_children("trace-effect".to_string(), "effect trace rows".to_string(),
      "".to_string(), "".to_string(),
      explain_verbatim_row_nodes("reason".to_string(), d.effect_trace.clone())))
  end
  if d.constraint_trace.len() > 0 then
    out.push(explain_node_with_children("trace-constraint".to_string(), "constraint trace rows".to_string(),
      "".to_string(), "".to_string(),
      explain_verbatim_row_nodes("reason".to_string(), d.constraint_trace.clone())))
  end
  if d.trait_trace.len() > 0 then
    out.push(explain_node_with_children("trace-trait".to_string(), "trait trace rows".to_string(),
      "".to_string(), "".to_string(),
      explain_verbatim_row_nodes("reason".to_string(), d.trait_trace.clone())))
  end
  out
end

# The typed derivation tree of ONE Diagnostic. Root = the primary_symbol
# display render, else the semantic_site, else "diagnostic". Children =
# the typed payload's class node first (when present), then the §34 trace
# families; a data-less diagnostic with an expected/actual pair answers
# the mismatch node, and a wholly data-less diagnostic the honest "no
# structured semantic data" leaf. Byte-identical to the §52
# explain_diagnostic render.
pub def diagnostic_explain_node(d: Diagnostic) -> ExplainNode
  var root_text = "diagnostic".to_string()
  match d.primary_symbol
  when Option::Some(p) then root_text = p.clone()
  when Option::None then
    match d.semantic_site
    when Option::Some(s) then root_text = s.clone()
    when Option::None then ()
    end
  end
  var root = explain_text_node("diagnostic.explain".to_string(), root_text)
  var any = false
  var structured = false
  match d.semantic_data
  when Option::Some(sd) then
    for child in diagnostic_typed_leaf_nodes(sd) do
      root = explain_node_child(root, child)
      any = true
    end
    structured = true
  when Option::None then ()
  end
  for child in diagnostic_trace_family_nodes(&d) do
    root = explain_node_child(root, child)
    any = true
  end
  if !structured then
    match d.expected_type
    when Option::Some(exp) then
      match d.actual_type
      when Option::Some(act) then
        var mismatch = explain_text_node("type-mismatch".to_string(), "type mismatch".to_string())
        mismatch = explain_node_child(mismatch, explain_text_node("type-expected".to_string(), "expected " + exp.clone()))
        mismatch = explain_node_child(mismatch, explain_text_node("type-actual".to_string(), "actual " + act.clone()))
        root = explain_node_child(root, mismatch)
        any = true
      when Option::None then ()
      end
    when Option::None then ()
    end
    if !any then
      root = explain_node_child(root, explain_text_node("diagnostic-empty".to_string(), "no structured semantic data".to_string()))
    end
  end
  root
end

# ———————————————————————————————————————————————————————————————
# The STORE-form derivation nodes (never message prose)
# ———————————————————————————————————————————————————————————————

pub def diagnostic_record_explain_node(record: DiagnosticRecord) -> ExplainNode
  var root = explain_text_node("diagnostic.record".to_string(), stable_diagnostic_id_text(record.id.clone()))
  root = explain_node_child(root, explain_text_node("record-span".to_string(), "span " + record.span.clone()))
  root = explain_node_child(root,
    explain_text_node("record-semantic-kind".to_string(), "semantic_kind " + record.semantic_kind.clone()))
  for r in record.related do
    root = explain_node_child(root, explain_text_node("record-related".to_string(), r.clone()))
  end
  root
end

# ———————————————————————————————————————————————————————————————
# The module lane (third-audit items 23/24 executable rows)
# ———————————————————————————————————————————————————————————————
# D1 id derivation + collision ordinals; D2 store add idempotency and
# ordinal assignment; D3 store get / all / match; D4 ExplainNode render
# byte-identity + typed find; D5 verbatim trace rows; D6 the
# diagnostic.get record round trip (hand-built store). Empty result = the
# lane verifies.

def diag_lane_bool(inout out: Vec[String], name: String, ok: Bool) -> Unit
  if !ok then
    out.push(name + ": expected true")
  end
  ()
end

def diag_lane_int(inout out: Vec[String], name: String, got: Int, expected: Int) -> Unit
  if got != expected then
    out.push(name + ": expected " + expected.to_string() + ", got " + got.to_string())
  end
  ()
end

def diag_lane_text(inout out: Vec[String], name: String, got: String, expected: String) -> Unit
  if got != expected then
    out.push(name + ": expected '" + expected + "', got '" + got + "'")
  end
  ()
end

def diag_lane_rows(inout out: Vec[String], name: String, got: Vec[String], expected: Vec[String]) -> Unit
  if got.len() != expected.len() then
    out.push(name + ": expected " + expected.len().to_string() + " rows, got " + got.len().to_string())
    return ()
  end
  var i = 0
  while i < got.len() do
    if got[i] != expected[i] then
      out.push(name + "[" + i.to_string() + "]: expected '" + expected[i].clone() + "', got '" + got[i].clone() + "'")
    end
    i = i + 1
  end
  ()
end

def diag_lane_span(start: Int) -> Span
  Span { file: "lane.tg", start: start, end_pos: start + 1 }
end

def diag_lane_ownership_place(message: String, place: String, start: Int) -> Diagnostic
  Diagnostic {
    level: DiagLevel::Error,
    message: message,
    span: Option::Some(diag_lane_span(start)),
    notes: Vec::new(),
    suggestions: Vec::new(),
    code: Option::Some("E0201".to_string()),
    primary_symbol: Option::Some("m::f#fn()->unit".to_string()),
    semantic_site: Option::Some("ownership analysis".to_string()),
    semantic_data: Option::Some(DiagnosticSemanticData::Ownership(OwnershipDiagnosticData {
      place: place,
      state_before: "consumed".to_string(),
      operation: "use".to_string(),
      consume_site: "lane.tg:5".to_string(),
      use_site: "lane.tg:" + start.to_string(),
      type_id: "R".to_string()
    }))
  }
end

def diag_lane_ownership(message: String, start: Int) -> Diagnostic
  diag_lane_ownership_place(message, "r".to_string(), start)
end

# ONE trait-bound failure: the typed obligation "<trait> for <subject>".
def diag_lane_trait_failure(obligation: String) -> Diagnostic
  Diagnostic {
    level: DiagLevel::Error,
    message: "trait bound not satisfied: " + obligation.clone(),
    span: Option::Some(diag_lane_span(30)),
    notes: Vec::new(),
    suggestions: Vec::new(),
    code: Option::Some("E0203".to_string()),
    primary_symbol: Option::Some("m::f#fn()->unit".to_string()),
    semantic_site: Option::Some("method call resolution".to_string()),
    semantic_data: Option::Some(DiagnosticSemanticData::TraitFailure(TraitFailureData {
      obligation: obligation,
      rejected_candidates: Vec::from(["impl Display for R".to_string()])
    }))
  }
end

pub def semantic_diagnostics_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— D1: typed derivation + identity determinism ————
  let d1 = diag_lane_ownership("use of moved value `r`".to_string(), 10)
  let d2 = diag_lane_ownership("use of moved value `r` (second site)".to_string(), 20)
  diag_lane_text(&mut out, "d1-owner", stable_diagnostic_owner(&d1), "r")
  diag_lane_text(&mut out, "d1-subject-kind", diagnostic_subject_of(&d1).kind.clone(), "place")
  diag_lane_text(&mut out, "d1-cause-place", stable_diagnostic_cause(&d1), "r")
  diag_lane_text(&mut out, "d1-code", stable_diagnostic_code(&d1), "E0201")
  diag_lane_text(&mut out, "d1-obligation-none", stable_diagnostic_obligation(&d1), "")
  let id1 = stable_diagnostic_id_of("m::f#fn()->unit".to_string(), "r".to_string(), "E0201".to_string(), "".to_string(), 0)
  let id1_again = stable_diagnostic_id_of("m::f#fn()->unit".to_string(), "r".to_string(), "E0201".to_string(), "".to_string(), 0)
  diag_lane_text(&mut out, "d1-id-deterministic",
    stable_diagnostic_id_text(id1.clone()), stable_diagnostic_id_text(id1_again.clone()))
  diag_lane_bool(&mut out, "d1-digest-words-agree",
    id1.digest_hi == id1_again.digest_hi && id1.digest_lo == id1_again.digest_lo)
  diag_lane_bool(&mut out, "d1-tuple-key-equal",
    stable_diagnostic_tuple_key("m::f#fn()->unit".to_string(), "r".to_string(), "E0201".to_string(), "".to_string()) ==
      stable_diagnostic_tuple_key("m::f#fn()->unit".to_string(), "r".to_string(), "E0201".to_string(), "".to_string()))
  diag_lane_bool(&mut out, "d1-ordinal-distinguishes",
    stable_diagnostic_id_text(id1.clone()) !=
      stable_diagnostic_id_text(stable_diagnostic_id_of("m::f#fn()->unit".to_string(), "r".to_string(), "E0201".to_string(), "".to_string(), 1)))
  # The typed constructor over the DERIVED subject/cause agrees with the
  # text-boundary constructor for the same owner/cause tuple.
  let typed_id1 = stable_diagnostic_id_typed(
    "E0201".to_string(),
    diagnostic_subject_of_decl_key("m::f#fn()->unit".to_string()),
    diagnostic_cause_subject(diagnostic_subject_of_decl_key("m::f#fn()->unit".to_string())),
    0)
  diag_lane_text(&mut out, "d1-typed-id-agrees",
    stable_diagnostic_id_text(typed_id1.clone()), stable_diagnostic_id_text(id1.clone()))

  # The trait-failure subject is the typed TraitObligation (the obligation
  # id), and the obligation identity participates in the cause key.
  let tf1 = diag_lane_trait_failure("Display for R".to_string())
  let tf2 = diag_lane_trait_failure("Debug for R".to_string())
  diag_lane_text(&mut out, "d1-trait-subject-kind", diagnostic_subject_of(&tf1).kind.clone(), "trait-obligation")
  diag_lane_text(&mut out, "d1-trait-cause-kind", diagnostic_cause_of(&tf1).kind.clone(), "obligation")
  diag_lane_bool(&mut out, "d1-trait-obligation-distinguishes",
    diagnostic_identity_key(diagnostic_subject_of(&tf1), diagnostic_cause_of(&tf1), "E0203".to_string()) !=
      diagnostic_identity_key(diagnostic_subject_of(&tf2), diagnostic_cause_of(&tf2), "E0203".to_string()))

  # ———— D2: store idempotency + collision ordinals ————
  var store = new_diagnostic_store()
  let s1 = diagnostic_store_add(&mut store, d1.clone())
  let s1_again = diagnostic_store_add(&mut store, d1.clone())
  diag_lane_text(&mut out, "d2-idempotent-id",
    stable_diagnostic_id_text(s1.clone()), stable_diagnostic_id_text(s1_again.clone()))
  diag_lane_int(&mut out, "d2-idempotent-len", store_len(store.clone()), 1)
  let s2 = diagnostic_store_add(&mut store, d2.clone())
  diag_lane_int(&mut out, "d2-repeated-ordinal", s2.collision_ordinal, 1)
  # Duplicates within one snapshot share the typed identity and are
  # distinguished by the ordinal ONLY (no span/text component).
  diag_lane_bool(&mut out, "d2-duplicate-identity-equal",
    diagnostic_identity_key(diagnostic_subject_of(&d1), diagnostic_cause_of(&d1), "E0201".to_string()) ==
      diagnostic_identity_key(diagnostic_subject_of(&d2), diagnostic_cause_of(&d2), "E0201".to_string()))
  diag_lane_bool(&mut out, "d2-duplicate-subject-equal",
    diagnostic_subject_identity_key(diagnostic_subject_of(&d1)) ==
      diagnostic_subject_identity_key(diagnostic_subject_of(&d2)))
  diag_lane_bool(&mut out, "d2-duplicate-cause-equal",
    diagnostic_cause_identity_key(diagnostic_cause_of(&d1)) ==
      diagnostic_cause_identity_key(diagnostic_cause_of(&d2)))
  diag_lane_int(&mut out, "d2-first-ordinal", s1.collision_ordinal, 0)
  diag_lane_bool(&mut out, "d2-duplicate-ids-differ",
    stable_diagnostic_id_text(s1.clone()) != stable_diagnostic_id_text(s2.clone()))
  diag_lane_int(&mut out, "d2-store-len", store_len(store.clone()), 2)
  let s1_after = diagnostic_store_add(&mut store, d1.clone())
  diag_lane_text(&mut out, "d2-idempotent-after-repeat",
    stable_diagnostic_id_text(s1.clone()), stable_diagnostic_id_text(s1_after.clone()))
  diag_lane_int(&mut out, "d2-idempotent-after-len", store_len(store.clone()), 2)

  # ———— D3: store get / all / match ————
  match store_get(store.clone(), stable_diagnostic_id_text(s1.clone()))
  when Option::Some(rec) then
    diag_lane_text(&mut out, "d3-get-message", rec.message.clone(), d1.message.clone())
    diag_lane_text(&mut out, "d3-get-span", rec.span.clone(), "lane.tg:10")
    diag_lane_text(&mut out, "d3-get-kind", rec.semantic_kind.clone(), "ownership")
    diag_lane_int(&mut out, "d3-get-related", rec.related.len(), 6)
    diag_lane_text(&mut out, "d3-get-related-place", rec.related[0].clone(), "place:r")
  when Option::None then
    out.push("d3-get: expected Some, got None")
  end
  let all = store_all(store.clone())
  diag_lane_int(&mut out, "d3-all-len", all.len(), 2)
  if all.len() == 2 then
    diag_lane_bool(&mut out, "d3-all-ordered",
      stable_diagnostic_id_text(all[0].id.clone()) < stable_diagnostic_id_text(all[1].id.clone()))
  end
  match store_get_by_id(store.clone(), s2.clone())
  when Option::Some(rec2) then
    diag_lane_int(&mut out, "d3-get-by-id-ordinal", rec2.id.collision_ordinal, 1)
  when Option::None then
    out.push("d3-get-by-id: expected Some, got None")
  end
  match store_match(store.clone(), "0".to_string())
  when Option::Some(_) then ()
  when Option::None then out.push("d3-match-index: expected Some, got None")
  end
  match store_get(store.clone(), "no-such-id".to_string())
  when Option::Some(_) then out.push("d3-get-absent: expected None, got Some")
  when Option::None then ()
  end

  # ———— D4: ExplainNode render byte-identity + typed find ————
  let tree = diagnostic_explain_node(&d1)
  diag_lane_rows(&mut out, "d4-render-identity", explain_node_render(tree.clone()),
    Vec::from([
      "m::f#fn()->unit".to_string(),
      "  ownership rejection".to_string(),
      "    place r".to_string(),
      "    state before consumed".to_string(),
      "    operation use".to_string(),
      "    consumed at lane.tg:5".to_string(),
      "    rejected at lane.tg:10".to_string(),
      "    type R".to_string()
    ]))
  match explain_node_find(tree.clone(), "ownership-rejection".to_string())
  when Option::Some(node) then
    diag_lane_text(&mut out, "d4-find-subject", node.subject.clone(), "ownership rejection")
  when Option::None then
    out.push("d4-find: expected Some, got None")
  end
  match explain_node_find(tree.clone(), "not-a-kind".to_string())
  when Option::Some(_) then out.push("d4-find-absent: expected None, got Some")
  when Option::None then ()
  end
  diag_lane_int(&mut out, "d4-find-all-place",
    explain_node_find_all(tree.clone(), "ownership-place".to_string()).len(), 1)
  diag_lane_int(&mut out, "d4-find-all-reason",
    explain_node_find_all(tree.clone(), "reason".to_string()).len(), 0)

  # ———— D5: verbatim trace rows (embedded indentation preserved) ————
  var d_traced = diag_lane_ownership("use of moved value `r`".to_string(), 10)
  d_traced.ownership_trace = Vec::from([
    "`r`: live -> consumed at lane.tg:5".to_string(),
    "  consumed by `consume(r)` at lane.tg:6".to_string()
  ])
  let traced = diagnostic_explain_node(&d_traced)
  diag_lane_rows(&mut out, "d5-verbatim-render", explain_node_render(traced.clone()),
    Vec::from([
      "m::f#fn()->unit".to_string(),
      "  ownership rejection".to_string(),
      "    place r".to_string(),
      "    state before consumed".to_string(),
      "    operation use".to_string(),
      "    consumed at lane.tg:5".to_string(),
      "    rejected at lane.tg:10".to_string(),
      "    type R".to_string(),
      "  ownership trace rows".to_string(),
      "`r`: live -> consumed at lane.tg:5".to_string(),
      "  consumed by `consume(r)` at lane.tg:6".to_string()
    ]))
  diag_lane_int(&mut out, "d5-find-all-reason",
    explain_node_find_all(traced.clone(), "reason".to_string()).len(), 2)

  # ———— D6: the diagnostic.get record round trip (hand-built store) ————
  match store_get(store.clone(), stable_diagnostic_id_text(s1.clone()))
  when Option::Some(record) then
    let rows = diagnostic_record_get_rows(record.clone())
    diag_lane_int(&mut out, "d6-get-rows-len", rows.len(), 10)
    diag_lane_text(&mut out, "d6-get-row-id", rows[0].clone(),
      "id:" + stable_diagnostic_id_text(s1.clone()))
    diag_lane_text(&mut out, "d6-get-row-message", rows[1].clone(),
      "message:" + d1.message.clone())
    diag_lane_text(&mut out, "d6-get-row-kind", rows[3].clone(), "semantic_kind:ownership")
    diag_lane_text(&mut out, "d6-get-row-related", rows[4].clone(), "related:place:r")
  when Option::None then
    out.push("d6-get: expected Some, got None")
  end

  # ———— D7: presentation insertion stability + equal-text identity ————
  # (P1-1) A comment/earlier insertion shifts the span and the dense site
  # locators but NOT the typed identity: the same error under a fresh store
  # keeps the same id (ordinal 0), and an UNRELATED earlier diagnostic does
  # not move it (the counter is keyed by the typed identity, so an earlier
  # different identity never consumes this identity's ordinal).
  let d_shifted = diag_lane_ownership_place("use of moved value `r`".to_string(), "r".to_string(), 99)
  var store_plain = new_diagnostic_store()
  let id_plain = diagnostic_store_add(&mut store_plain, d1.clone())
  var store_inserted = new_diagnostic_store()
  let _earlier = diagnostic_store_add(&mut store_inserted,
    diag_lane_ownership_place("use of moved value `s`".to_string(), "s".to_string(), 4))
  let id_inserted = diagnostic_store_add(&mut store_inserted, d_shifted.clone())
  diag_lane_text(&mut out, "d7-insertion-stable",
    stable_diagnostic_id_text(id_plain.clone()), stable_diagnostic_id_text(id_inserted.clone()))
  diag_lane_int(&mut out, "d7-insertion-ordinal", id_inserted.collision_ordinal, 0)
  diag_lane_int(&mut out, "d7-insertion-store-len", store_len(store_inserted.clone()), 2)
  # The span and the dense site rows never enter the identity preimage.
  diag_lane_bool(&mut out, "d7-span-not-in-identity",
    diagnostic_identity_key(diagnostic_subject_of(&d1), diagnostic_cause_of(&d1), "E0201".to_string()) ==
      diagnostic_identity_key(diagnostic_subject_of(&d_shifted), diagnostic_cause_of(&d_shifted), "E0201".to_string()))

  # Two DIFFERENT errors with the SAME message text get different ids: the
  # typed subject differs (a different place), so the identity differs.
  let equal_text_r = diag_lane_ownership_place("use of moved value".to_string(), "r".to_string(), 10)
  let equal_text_s = diag_lane_ownership_place("use of moved value".to_string(), "s".to_string(), 20)
  var equal_store = new_diagnostic_store()
  let id_r = diagnostic_store_add(&mut equal_store, equal_text_r.clone())
  let id_s = diagnostic_store_add(&mut equal_store, equal_text_s.clone())
  diag_lane_bool(&mut out, "d7-equal-text-different-ids",
    stable_diagnostic_id_text(id_r.clone()) != stable_diagnostic_id_text(id_s.clone()))
  diag_lane_bool(&mut out, "d7-equal-text-identity-differs",
    diagnostic_identity_key(diagnostic_subject_of(&equal_text_r), diagnostic_cause_of(&equal_text_r), "E0201".to_string()) !=
      diagnostic_identity_key(diagnostic_subject_of(&equal_text_s), diagnostic_cause_of(&equal_text_s), "E0201".to_string()))
  diag_lane_int(&mut out, "d7-equal-text-ordinals", id_r.collision_ordinal + id_s.collision_ordinal, 0)

  out
end
