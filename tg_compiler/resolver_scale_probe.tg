# tg_compiler/resolver_scale_probe.tg — resolver bare-name scaling probe.
#
# Generates a synthetic single-module program with N top-level functions and
# Q bare call references, parses it with the REAL kernel lexer + parser, and
# runs the REAL kernel resolver (resolve_names) over the result.
#
# Before the bare-name index, bare_name_resolve materialized and scanned the
# WHOLE module_symbols map per unresolved identifier: the probe's step cost
# grew with symbols x references and the seed VM trapped its step limit. With
# the index built once at the end of symbol-table construction, each lookup
# touches only the candidates registered under that bare name, so the same
# probe completes with a large margin.
#
# bootstrap/resolver_scale_mini.manifest closes this probe under the seed VM;
# the stage0_ocaml/selfcheck/tg_resolver_scale.ml lane runs it under a
# calibrated step budget (the unindexed resolver exceeds the budget, the
# indexed one does not) and asserts every generated reference resolved.
#
# kernel args: resolver-scale <symbols> <refs-per-function>
# report:      build/resolver_scale_report.txt
use std::core::{Option, Result}
use std::collections::{Vec}
use std::fs::{write_file}
use std::io::{println}
use std::args::{raw_arg_count, raw_arg_copy}
use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::ast::{assign_node_ids}
use tg_compiler::resolver::{resolve_names}

def resolver_scale_int_arg(from_end: Int, fallback: Int) -> Int
  let argc = raw_arg_count()
  let index = argc - from_end
  if index < 0 then
    return fallback
  end
  if index >= argc then
    return fallback
  end
  let raw = raw_arg_copy(index)
  match raw.parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then fallback
  end
end

def resolver_scale_write(report: String) -> Unit
  match write_file("build/resolver_scale_report.txt", report)
  when Result::Ok(_) then ()
  when Result::Err(_) then ()
  end
end

def main() -> Int
  let symbols = resolver_scale_int_arg(2, 3000)
  let refs = resolver_scale_int_arg(1, 3)
  if symbols < 2 then
    println("resolver-scale: FAIL symbols must be >= 2")
    return 1
  end
  if refs < 1 then
    println("resolver-scale: FAIL refs-per-function must be >= 1")
    return 1
  end

  # The synthetic source: scale_fn_0 is the leaf; every later function calls
  # the previous one `refs` times. Bare-name resolution therefore sees one
  # distinct module-qualified candidate per reference name.
  var parts = Vec::new()
  var i = 0
  while i < symbols do
    parts.push("def scale_fn_" + i.to_string() + "() -> Int\n")
    if i == 0 then
      parts.push("  0\n")
    else
      parts.push("  ")
      var r = 0
      while r < refs do
        if r > 0 then
          parts.push(" + ")
        end
        parts.push("scale_fn_" + (i - 1).to_string() + "()")
        r = r + 1
      end
      parts.push("\n")
    end
    parts.push("end\n")
    i = i + 1
  end
  let source = parts.join("")
  let expected = (symbols - 1) * refs
  println("resolver-scale: generated symbols=" + symbols.to_string() + " refs=" + expected.to_string() + " bytes=" + source.len().to_string())

  let parsed = parse(tokenize(source, "resolver-scale"))
  if diag_has_errors(&parsed.diagnostics) then
    let msg = "FAIL parse-diagnostics=" + parsed.diagnostics.len().to_string()
    resolver_scale_write(msg + "\n")
    println("resolver-scale: " + msg)
    return 1
  end

  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Ok(res) then
    let resolved = res.expr_resolutions.len()
    if resolved >= expected then
      let row = "OK symbols=" + symbols.to_string() + " refs=" + expected.to_string() + " resolved=" + resolved.to_string() + "\n"
      resolver_scale_write(row)
      println("resolver-scale: OK resolved=" + resolved.to_string())
      0
    else
      let msg = "FAIL resolved=" + resolved.to_string() + " expected>=" + expected.to_string()
      resolver_scale_write(msg + "\n")
      println("resolver-scale: " + msg)
      1
    end
  when Result::Err(errs) then
    let msg = "FAIL resolve-errors=" + errs.len().to_string()
    resolver_scale_write(msg + "\n")
    println("resolver-scale: " + msg)
    var ei = 0
    while ei < errs.len() do
      println("  " + errs[ei].message)
      ei = ei + 1
    end
    1
  end
end
