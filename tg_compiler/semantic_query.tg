# ———————————————————————————————————————————————————————————————
# The §38 records — QueryResults + SemanticQuerySession
# ———————————————————————————————————————————————————————————————
# QueryResults.keys holds the query's stable key texts / canonical row
# texts (sorted, no prose); kind is the envelope tag word of the
# vocabulary above — the discriminator a protocol caller needs. payload
# (audit item 23) is the TYPED semantic answer — the matching
# SemanticResponsePayload variant per operation (semantic_model.tg's
# mapping table); the ops whose rows belong to no enumerated family carry
# Option::None (kind + keys are then the whole answer). The session pairs
# a snapshot with the index built from it; neither side is ever mutated.
struct QueryResults
  kind: String
  keys: Vec[String] = Vec::new()
  payload: Option[SemanticResponsePayload] = Option::None
end

# The TYPED explain answer (audit item 52): kind = the typed op word
# ("type.explain" / "trait.resolve" / "ownership.explain" /
# "effect.explain" / "capability.explain" / "layout.explain" /
# "optimization.explain" / "diagnostic.explain"; "unknown" outside the
# dispatch set) and tree = the indented render lines of the derivation
# DAG/tree, DISPLAY ORDER (line 0 = the root; deeper lines are indented
# two spaces per depth). The lines carry typed kind words and reason
# leaves built from the derivational data only; see explain() for the
# per-op shapes. The query() dispatcher's explain arms carry the same
# lines in QueryResults.keys (the documented render-carrier exception).
struct ExplainResult
  kind: String
  tree: Vec[String] = Vec::new()
end

# (third-audit items 23/24) The session ALSO retains the persistent
# diagnostic store (empty by default) and, when the caller holds one, the
# compilation's §37 VerifiedCompilationEvidence — the state the
# diagnostic.* / build.plan / verify.plan ops answer from. The store slot
# is an Option at the constructor boundary only (an Option::None default
# keeps every existing 2-argument construction site legal); the session
# field is the retained value itself.
struct SemanticQuerySession
  snapshot: SemanticSnapshot
  index: SemanticIndex
  diagnostics_store: DiagnosticStore
  evidence: Option[VerifiedCompilationEvidence]
end

pub def new_semantic_query_session(
  snapshot: SemanticSnapshot,
  index: SemanticIndex,
  diagnostics_store: Option[DiagnosticStore] = Option::None,
  evidence: Option[VerifiedCompilationEvidence] = Option::None
) -> SemanticQuerySession
  var store = new_diagnostic_store()
  match diagnostics_store
  when Option::Some(s) then store = s
  when Option::None then ()
  end
  SemanticQuerySession {
    snapshot: snapshot,
    index: index,
    diagnostics_store: store,
    evidence: evidence
  }
end

# ———————————————————————————————————————————————————————————————
# The typed accessors — O(1) delegates to the §32 index accessors
# ———————————————————————————————————————————————————————————————
# Each returns kind = its operation name; keys = the accessor's rows for
# the arg key (callers/callees: stable keys; types/effects: 0-1 rows);
# payload = the matching SemanticResponsePayload variant carrying those
# SAME canonical rows, lifted into the variant's typed fields (None for
# the type-member probes fields/impls/properties — no payload family is
# enumerated for member-name / method-key row lists).

def query_callers(index: SemanticIndex, key: String) -> QueryResults
  let rows = index_callers_of(&index, key.clone())
  QueryResults {
    kind: "callers",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Callers(rows))
  }
end

def query_callees(index: SemanticIndex, key: String) -> QueryResults
  let rows = index_callees_of(&index, key.clone())
  QueryResults {
    kind: "callees",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Callees(rows))
  }
end

# The "types" answer row IS the nominal kind word of a type-keyed def
# ("Struct" | "Enum" | "Trait"; no row for defs that are not type
# declarations) — the payload lifts it into kind_word and repeats it in
# rows per the carrier doctrine (payload rows = the canonical rows).
def query_types(index: SemanticIndex, key: String) -> QueryResults
  let rows = index_types_of(&index, key.clone())
  let kind_word = if rows.len() == 1 then rows[0].clone() else "".to_string() end
  QueryResults {
    kind: "types",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Type(kind_word, rows))
  }
end

# Split one canonical §32 effect row ("<dirty-word>;<cap-id>;...") into its
# typed parts: bits = the dirty-class word (semantic_summary_dirty_word),
# caps = the sorted capability-id texts after the first ';'. Absent cap
# rows render a trailing ';' ("0;") — the empty segment is skipped; a
# non-numeric word fails closed to bits 0.
def query_effect_row_split(row: String) -> (Int, Vec[String])
  var bits = 0
  var caps: Vec[String] = Vec::new()
  var segment = 0
  var start = 0
  var i = 0
  while i <= row.len() do
    let is_separator = if i == row.len() then true else row.slice(i, i + 1) == ";" end
    if is_separator then
      let text = row.slice(start, i)
      if segment == 0 then
        match text.parse_int()
        when Result::Ok(n) then bits = n
        when Result::Err(_) then bits = 0
        end
      elsif text.len() > 0 then
        caps.push(text.clone())
      end
      segment = segment + 1
      start = i + 1
    end
    i = i + 1
  end
  (bits, caps)
end

# The §11 effect answer (0-1 rows): the payload carries the row SPLIT into
# its typed parts — bits = the dirty-class word, caps = the capability-id
# texts (semantic_model.tg's Effects mapping). An absent effect row (no
# def-keyed lowering / no §11 row for the key) renders the zero payload
# Effects(0, []); the empty keys list stays the distinguishing protocol
# signal.
def query_effects(index: SemanticIndex, key: String) -> QueryResults
  let rows = index_effects_of(&index, key.clone())
  var bits = 0
  var caps: Vec[String] = Vec::new()
  if rows.len() == 1 then
    let split = query_effect_row_split(&rows[0])
    bits = split.0
    caps = split.1
  end
  QueryResults {
    kind: "effects",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Effects(bits, caps))
  }
end

def query_capabilities(index: SemanticIndex, key: String) -> QueryResults
  let rows = index_capabilities_of(&index, key.clone())
  QueryResults {
    kind: "capabilities",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Capabilities(rows))
  }
end

# (third-audit item 25) purity.get — the compiler-verified PurityStatus
# projection of one function key. The carrier is the §29 snapshot's
# effect rows (the def-keyed purity projection the snapshot writer fills
# from MirProgram.purity): the answer keys are the status word
# ("ProvenPure" / "Impure" / "Unknown") first, then one "evidence: " row
# per recorded evidence row in PATH ORDER. Evidence is a sequence (the
# caller -> callee chain into the offending site), so this op is the
# documented ordered-keys exception to the sort rule — the rows preserve
# the order the MIR pass recorded. An absent projection answers with no
# keys: the function is outside every analyzed purity domain and is NEVER
# implicitly ProvenPure. No §23 payload family is enumerated for the op
# (kind + keys are the whole answer); the status classes are the
# PurityStatus vocabulary (mir.tg).
pub def query_purity(snapshot: SemanticSnapshot, key: String) -> QueryResults
  var keys: Vec[String] = Vec::new()
  for e in snapshot.effects do
    if e.function.key == key then
      if e.purity_status.len() > 0 then
        keys.push(e.purity_status.clone())
        for row in e.purity_evidence do
          keys.push("evidence: " + row.clone())
        end
      end
    end
  end
  QueryResults { kind: "purity.get", keys: keys }
end

# contracts rows are the index row form; the §31 row-key form rides
# contract_list — both are contract rows (payload Contract).
def query_contracts(index: SemanticIndex, key: String) -> QueryResults
  let rows = index_contracts_of(&index, key.clone())
  QueryResults {
    kind: "contracts",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Contract(rows))
  }
end

# The type-member probes (fields/impls/properties) answer member-name /
# method-key row lists — no §23 payload family is enumerated for them
# (documented in semantic_model.tg), so payload stays None and kind + keys
# are the whole answer.
def query_fields(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "fields", keys: index_fields_of(&index, key.clone()) }
end

def query_impls(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "impls", keys: index_impls_of(&index, key.clone()) }
end

def query_properties(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "properties", keys: index_properties_of(&index, key.clone()) }
end

# ———————————————————————————————————————————————————————————————
# Symbol ops — the DEDICATED symbol table (third-audit item 23 residual:
# the index's symbols map is populated for every snapshot.symbols row, so
# the probe is direct and a symbol with no other index row still answers;
# the search scans symbol records — canonical key text + recorded row text
# — never the union of the other maps).
# ———————————————————————————————————————————————————————————————

# The sorted, deduped symbol-record universe of the index: every declared
# symbol's canonical key text (the symbols map's renders).
def query_index_keys(index: SemanticIndex) -> Vec[String]
  var keys: Vec[String] = Vec::new()
  for entry in index.symbols.entries() do
    keys.push(entry.1.clone())
  end
  keys.sort_by(|a, b| a < b)
  var out: Vec[String] = Vec::new()
  for key in keys do
    if !out.contains(&key) then
      out.push(key.clone())
    end
  end
  out
end

# Presence probe over the symbol table: Some(canonical key text) when the
# key's typed declaration identity is a declared symbol; the probe is
# DIRECT (no union probe over the other index maps).
def symbol_get(index: SemanticIndex, key: String) -> Option[String]
  index_symbol_get(&index, key.clone())
end

# The sorted symbol records containing the needle (substring, not prefix)
# in their canonical key text or their recorded row text.
def symbol_search(index: SemanticIndex, needle: String) -> Vec[String]
  index_symbol_search(&index, needle.clone())
end

# Presence probe + search: payload Symbol lifts the ONE matched row
# ("" = absent — the probe's None); payload Symbols carries the matched
# def-key rows of a search ([] = no match — a real answer of the op).
def query_symbol_get(index: SemanticIndex, key: String) -> QueryResults
  var keys: Vec[String] = Vec::new()
  match symbol_get(&index, key.clone())
  when Option::Some(k) then keys.push(k)
  when Option::None then ()
  end
  let row_text = if keys.len() == 1 then keys[0].clone() else "".to_string() end
  QueryResults {
    kind: "symbol_get",
    keys: keys,
    payload: Option::Some(SemanticResponsePayload::Symbol(row_text))
  }
end

def query_symbol_search(index: SemanticIndex, key: String) -> QueryResults
  let rows = symbol_search(&index, key.clone())
  QueryResults {
    kind: "symbol_search",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Symbols(rows))
  }
end

# ———————————————————————————————————————————————————————————————
# Contract helpers — the RECORDED contract rows of a key (scan-based;
# the projections mirror the §31 delta row-key vocabulary — recorded
# only, no verification semantics invented).
# ———————————————————————————————————————————————————————————————

def query_contract_kind_text(k: AstContractKind) -> String
  match k
  when AstContractKind::AstPre then "Pre"
  when AstContractKind::AstPost then "Post"
  when AstContractKind::AstInvariant then "Invariant"
  end
end

# The §31 row-key texts of every contract row recorded for key (sorted).
def contract_obligations(snapshot: SemanticSnapshot, key: String) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  for c in snapshot.contracts do
    if c.function.key == key then
      rows.push(key.clone() + "|" + query_contract_kind_text(&c.kind) + "|" +
        semantic_contract_expr_text(&c.canonical_expression))
    end
  end
  rows.sort_by(|a, b| a < b)
  rows
end

def contract_has_rows(snapshot: SemanticSnapshot, key: String) -> Bool
  var found = false
  for c in snapshot.contracts do
    if c.function.key == key then
      found = true
      break
    end
  end
  found
end

# The dispatchable form (kind "contract_list" — the recorded §31 row-key
# rows; payload Contract — the same family as the index-row "contracts"
# op).
def contract_list(snapshot: SemanticSnapshot, key: String) -> QueryResults
  let rows = contract_obligations(&snapshot, key.clone())
  QueryResults {
    kind: "contract_list",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Contract(rows))
  }
end

# ———————————————————————————————————————————————————————————————
# Explain helpers — type membership + per-function ownership rows
# ———————————————————————————————————————————————————————————————

# The type key's index surface: fields + impls + properties rows for the
# key, deduped across the three index families and sorted. The rows are
# type-MEMBER probes — no §23 payload family is enumerated for them
# (documented in semantic_model.tg), so payload stays None and kind + keys
# are the whole answer.
def type_explain(index: SemanticIndex, key: String) -> QueryResults
  var rows: Vec[String] = Vec::new()
  for r in index_fields_of(&index, key.clone()) do
    if !rows.contains(&r) then rows.push(r.clone()) end
  end
  for r in index_impls_of(&index, key.clone()) do
    if !rows.contains(&r) then rows.push(r.clone()) end
  end
  for r in index_properties_of(&index, key.clone()) do
    if !rows.contains(&r) then rows.push(r.clone()) end
  end
  rows.sort_by(|a, b| a < b)
  QueryResults { kind: "type_explain", keys: rows }
end

# The ownership row-key texts ("<fn key>|place|<conv>") whose subject-field
# prefix matches key — scan-based (not an index family); conv words mirror
# the §31 delta vocabulary.
def query_ownership_conv_text(c: AccessConvention) -> String
  match c
  when AccessConvention::Let then "let"
  when AccessConvention::Inout then "inout"
  when AccessConvention::Sink then "sink"
  when AccessConvention::Set then "set"
  end
end

def ownership_explain(snapshot: SemanticSnapshot, key: String) -> QueryResults
  var keys: Vec[String] = Vec::new()
  for o in snapshot.ownership do
    let row_key = o.function.key.clone() + "|" + o.place_key.clone() + "|" +
      query_ownership_conv_text(&o.convention)
    if row_key.starts_with(key.clone() + "|") then
      keys.push(row_key)
    end
  end
  keys.sort_by(|a, b| a < b)
  QueryResults {
    kind: "ownership",
    keys: keys.clone(),
    payload: Option::Some(SemanticResponsePayload::Ownership(keys))
  }
end

# ———————————————————————————————————————————————————————————————
# MIR query helpers — the snapshot carries only the COARSE per-function
# MirSemanticSummary rows (never statements — that is the §33 slice
# domain, over a MirProgram)
# ———————————————————————————————————————————————————————————————

# One key: the def-keyed function's coarse summary render (the §32 index
# payload text — the text the index digest emits for the summary); an
# absent row falls back to the raw key text (no render exists). The
# payload MirFunction lifts that single canonical row into summary_text.
def mir_function(snapshot: SemanticSnapshot, key: String) -> QueryResults
  var keys: Vec[String] = Vec::new()
  for m in snapshot.mir_functions do
    if m.function.key == key then
      keys.push(index_mir_payload(&m))
    end
  end
  if keys.is_empty() then
    keys.push(key.clone())
  end
  let summary_text = keys[0].clone()
  QueryResults {
    kind: "mir_function",
    keys: keys,
    payload: Option::Some(SemanticResponsePayload::MirFunction(summary_text))
  }
end

# The mir_slice query slot — the §38/§39 protocol adapter over the §33
# typed entry (semantic_slice::mir_slice, audit item 22). The op payload
# is ONE request text in the module's canonical grammar:
#   "<kind word>|<function key>|<anchor>"
# with kind words "backward" / "forward" / "control" / "ownership" /
# "effects" / "failure" / "return" (the MirSliceKind vocabulary; see
# semantic_slice.tg's entry doc for the per-kind anchor grammar),
# function key = the §33 function EMISSION key the slice resolves in the
# verified program (the engine's own fn-key domain — never a digest key),
# and anchor = the per-kind anchor text ("" for the "return" kind, whose
# anchor is ignored). "|" never occurs inside an emission key or an
# anchor text, so the two separators split deterministically.
#
# A MirProgram is NOT part of the §38 session: the session-scoped query()
# arm calls this slot with the default no-program form and the engine
# answers MirProgramUnavailable — the kind stays "mir_slice_unavailable"
# with the empty MirSlice([], []) payload (the protocol's documented
# program-less answer). The §39 semantic_server dispatch passes the
# session's REAL final_mir (compiler_session_from_finalized — the
# pipeline's verified program) and surfaces the typed engine's answer:
#   Ok  — kind "mir_slice"; keys = the slice's sorted statement key texts
#         (the payload's first row list, mirroring the §23 carrier
#         doctrine); payload = MirSlice(statements, externals).
#   Err(MirProgramUnavailable) — kind "mir_slice_unavailable"; keys []
#         and payload MirSlice([], []) (the program-less answer shape).
#   Err(FunctionNotFound / AnchorNotFound / UnsupportedKind) or an
#         unparseable request text — kind "mir_slice_error"; keys [] and
#         payload None (the op's fail-closed request-error answer — no
#         rows are invented for a request the program cannot serve).
def mir_slice_kind_of_word(word: String) -> Option[MirSliceKind]
  match word
  when "backward" then Option::Some(MirSliceKind::BackwardDataflow)
  when "forward" then Option::Some(MirSliceKind::ForwardDataflow)
  when "control" then Option::Some(MirSliceKind::ControlDependence)
  when "ownership" then Option::Some(MirSliceKind::Ownership)
  when "effects" then Option::Some(MirSliceKind::Effects)
  when "failure" then Option::Some(MirSliceKind::Failure)
  when "return" then Option::Some(MirSliceKind::ReturnValue)
  # (third-audit item 20/22) the MIR-graph reasoning kinds.
  when "dominators" then Option::Some(MirSliceKind::Dominators)
  when "postdominators" then Option::Some(MirSliceKind::PostDominators)
  when "loops" then Option::Some(MirSliceKind::Loops)
  when "reaching" then Option::Some(MirSliceKind::ReachingDefs)
  when "path" then Option::Some(MirSliceKind::Path)
  when _ then Option::None
  end
end

# Parse one op payload into the typed §33 request; Option::None on any
# grammar violation (no first/second separator, an empty kind word or
# function key, an unknown kind word). The anchor may be empty ("return").
def mir_slice_request_of_text(key: String) -> Option[MirSliceRequest]
  var first = -1
  var second = -1
  var i = 0
  while i < key.len() do
    if key.slice(i, i + 1) == "|" then
      if first < 0 then
        first = i
      elsif second < 0 then
        second = i
        break
      end
    end
    i = i + 1
  end
  if first <= 0 || second < 0 then
    return Option::None
  end
  let kind_word = key.slice(0, first)
  let fn_key = key.slice(first + 1, second)
  if fn_key.len() == 0 then
    return Option::None
  end
  match mir_slice_kind_of_word(&kind_word)
  when Option::None then Option::None
  when Option::Some(kind) then
    Option::Some(MirSliceRequest {
      function_key: fn_key.clone(),
      kind: kind,
      anchor: key.slice(second + 1, key.len())
    })
  end
end

# The §33 typed answer as the §38 envelope (kind + keys + payload); see
# the slot doc above for the per-result mapping. Every Ok slice's keys are
# the engine's sorted statement keys — never re-derived here.
def mir_slice(key: String, mir_program: Option[MirProgram] = Option::None) -> QueryResults
  match mir_slice_request_of_text(&key)
  when Option::None then
    QueryResults { kind: "mir_slice_error", keys: Vec::new() }
  when Option::Some(request) then
    match engine_mir_slice(mir_program, request)
    when Result::Ok(slice) then
      QueryResults {
        kind: "mir_slice",
        keys: slice.statements.clone(),
        payload: Option::Some(SemanticResponsePayload::MirSlice(slice.statements.clone(), slice.externals.clone()))
      }
    when Result::Err(MirSliceError::MirProgramUnavailable) then
      QueryResults {
        kind: "mir_slice_unavailable",
        keys: Vec::new(),
        payload: Option::Some(SemanticResponsePayload::MirSlice(Vec::new(), Vec::new()))
      }
    when Result::Err(_) then
      QueryResults { kind: "mir_slice_error", keys: Vec::new() }
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The MIR GRAPH REASONING ops (third-audit item 20/22) — mir.dominators /
# mir.postdominators / mir.loops / mir.control / mir.path / mir.reaching /
# mir.block / mir.diff
# ———————————————————————————————————————————————————————————————
# The query-level wiring over semantic_slice.tg's graph engines. The op
# payload grammar (all function keys are the §33 EMISSION names the
# engines resolve; they never contain "|"):
#   mir.dominators     | <fn key>
#   mir.postdominators | <fn key>
#   mir.loops          | <fn key>
#   mir.control        | <fn key>
#   mir.path           | <fn key> | <node key "<fn>#B<id>#S<n>"/"#T">
#   mir.reaching       | <fn key> | <node key of the USE site>
#   mir.block          | <block key "<fn>#B<id>">
#   mir.diff           | <fn key A> | <fn key B>
# The row keys are the engines' canonical rows (see semantic_slice.tg's MIR
# GRAPH REASONING section): block rows keyed by StableMirBlockId.stable_key
# texts and statement rows by the item-16 stable statement id texts — never
# the dense §33 locators. mir.block answers one block's node ids through
# mir_node_statement_id (the translation authority). mir.diff is the thin
# normalized-MIR comparison:
# equivalence_normalized_rows of both bodies, positional, tagged per
# function and capped (mir_diff_cap).
#
# ANSWER KINDS: "<op>" on success (keys possibly empty — e.g. a function
# with no loops); "<op>_unavailable" when no MirProgram rides the caller
# (the §38 session-scoped query() answers this; the §39 semantic_server
# arm hands the session's final_mir); "<op>_error" for an unparseable arg,
# a missing function or an unresolvable anchor — fail-closed, no rows are
# invented. The mir.path answer also carries its MirSlice payload
# (statements + external parameter anchors); the graph ops carry no
# enumerated payload family (kind + keys are the whole answer).

def mir_graph_split(arg: String) -> Option[(String, String)]
  var at = -1
  var i = 0
  while i < arg.len() do
    if arg.slice(i, i + 1) == "|" then
      at = i
      break
    end
    i = i + 1
  end
  if at < 0 then
    return Option::None
  end
  Option::Some((arg.slice(0, at), arg.slice(at + 1, arg.len())))
end

def mir_graph_fn_find(mir: MirProgram, name: String) -> Option[MirFunction]
  var i = 0
  while i < mir.functions.len() do
    if mir.functions[i].name == name then
      return Option::Some(mir.functions[i].clone())
    end
    i = i + 1
  end
  Option::None
end

# ———— mir.block (third-audit item 20) ————
# The arg grammar is ONE StableMirBlockId.stable_key text
# "<fn emission key>#B<block id>" (the §1 grammar the graph rows use).
# The answer rows are the block's nodes' stable statement-id texts (the
# item-16 role-derived ids computed through semantic_slice.tg's
# mir_node_statement_id — the node-key locator domain is never re-derived
# here); sorted, deduped. Unknown function / block / unparsable arg answer
# the op's "<op>_error".

def mir_block_key_parts(key: String) -> Option[(String, Int)]
  var mark = -1
  var i = key.len() - 2
  while i >= 0 do
    if key.slice(i, i + 2) == "#B" then
      mark = i
      break
    end
    i = i - 1
  end
  if mark <= 0 then
    return Option::None
  end
  let digits = key.slice(mark + 2, key.len())
  if digits.len() == 0 then
    return Option::None
  end
  var value = 0
  var j = 0
  while j < digits.len() do
    let ch = digits.slice(j, j + 1)
    if ch < "0" || ch > "9" then
      return Option::None
    end
    value = value * 10 + (ch.bytes()[0] as Int - 48)
    j = j + 1
  end
  Option::Some((key.slice(0, mark), value))
end

def mir_block_node_text(mir: MirProgram, fn_key: String, node_key: String) -> String
  match mir_node_statement_id(mir, fn_key, node_key)
  when Option::Some(sid) then
    stable_mir_statement_role_key_text(sid.function.instance_key.clone(), sid.role.clone(), sid.role_seq, sid.hir_node_seq)
  when Option::None then ""
  end
end

def mir_block_stable_rows(mir: MirProgram, block_key: String) -> Option[Vec[String]]
  match mir_block_key_parts(&block_key)
  when Option::None then Option::None
  when Option::Some(parts) then
    let fn_key = parts.0
    let block_id = parts.1
    match mir_graph_fn_find(mir.clone(), fn_key.clone())
    when Option::None then Option::None
    when Option::Some(f) then
      var found = -1
      var bi = 0
      while bi < f.blocks.len() do
        if f.blocks[bi].id.id == block_id then
          found = bi
        end
        bi = bi + 1
      end
      if found < 0 then
        return Option::None
      end
      let block = f.blocks[found]
      var rows: Vec[String] = Vec::new()
      var si = 0
      while si < block.statements.len() do
        let node_key = fn_key.clone() + "#B" + block_id.to_string() + "#S" + si.to_string()
        let text = mir_block_node_text(mir.clone(), fn_key.clone(), node_key)
        if text.len() > 0 && !rows.contains(&text) then
          rows.push(text)
        end
        si = si + 1
      end
      let term_key = fn_key.clone() + "#B" + block_id.to_string() + "#T"
      let term_text = mir_block_node_text(mir.clone(), fn_key.clone(), term_key)
      if term_text.len() > 0 && !rows.contains(&term_text) then
        rows.push(term_text)
      end
      rows.sort_by(|a, b| a < b)
      Option::Some(rows)
    end
  end
end

def mir_diff_cap() -> Int
  256
end

def mir_graph_lists_equal(a: Vec[String], b: Vec[String]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end

# The normalized-MIR diff rows of two bodies: the equivalence module's L1
# normalized rows compared positionally, tagged "<fn key>|<row>" at the
# differences and capped at mir_diff_cap tagged rows. Equal rows answer the
# single "normalized-mir:equal" row; unequal answer "normalized-mir:differ"
# + the "rows:<a>:<b>" counts before the bounded tagged rows.
def mir_diff_rows(fa: MirFunction, fb: MirFunction, key_a: String, key_b: String) -> Vec[String]
  let ra = equivalence_normalized_rows(fa)
  let rb = equivalence_normalized_rows(fb)
  if mir_graph_lists_equal(ra.clone(), rb.clone()) then
    return Vec::from(["normalized-mir:equal"])
  end
  var rows: Vec[String] = Vec::new()
  rows.push("normalized-mir:differ")
  rows.push("rows:".to_string() + ra.len().to_string() + ":" + rb.len().to_string())
  let cap = mir_diff_cap()
  var emitted = 0
  var i = 0
  while i < ra.len() && emitted < cap do
    var b_row = ""
    if i < rb.len() then
      b_row = rb[i].clone()
    end
    if ra[i] != b_row then
      rows.push(key_a.clone() + "|" + ra[i].clone())
      rows.push(key_b.clone() + "|" + b_row)
      emitted = emitted + 1
    end
    i = i + 1
  end
  if ra.len() > rb.len() && emitted < cap then
    var j = rb.len()
    while j < ra.len() && emitted < cap do
      rows.push(key_a.clone() + "|" + ra[j].clone())
      emitted = emitted + 1
      j = j + 1
    end
  elsif rb.len() > ra.len() && emitted < cap then
    var j2 = ra.len()
    while j2 < rb.len() && emitted < cap do
      rows.push(key_b.clone() + "|" + rb[j2].clone())
      emitted = emitted + 1
      j2 = j2 + 1
    end
  end
  rows
end

def mir_graph_query_error(operation: String) -> QueryResults
  QueryResults { kind: operation + "_error", keys: Vec::new() }
end

pub def mir_graph_query(operation: String, arg: String, mir_program: Option[MirProgram] = Option::None) -> QueryResults
  match mir_program
  when Option::None then
    QueryResults { kind: operation + "_unavailable", keys: Vec::new() }
  when Option::Some(mir) then
    if operation == "mir.dominators" then
      match mir_dominator_rows(mir, arg.clone())
      when Option::Some(rows) then QueryResults { kind: operation, keys: rows }
      when Option::None then mir_graph_query_error(operation)
      end
    elsif operation == "mir.postdominators" then
      match mir_postdominator_rows(mir, arg.clone())
      when Option::Some(rows) then QueryResults { kind: operation, keys: rows }
      when Option::None then mir_graph_query_error(operation)
      end
    elsif operation == "mir.loops" then
      match mir_loop_rows(mir, arg.clone())
      when Option::Some(rows) then QueryResults { kind: operation, keys: rows }
      when Option::None then mir_graph_query_error(operation)
      end
    elsif operation == "mir.control" then
      match mir_control_dependence_rows(mir, arg.clone())
      when Option::Some(rows) then QueryResults { kind: operation, keys: rows }
      when Option::None then mir_graph_query_error(operation)
      end
    elsif operation == "mir.reaching" then
      match mir_graph_split(&arg)
      when Option::Some(parts) then
        match mir_reaching_def_rows(mir, parts.0.clone(), parts.1.clone())
        when Option::Some(rows) then QueryResults { kind: operation, keys: rows }
        when Option::None then mir_graph_query_error(operation)
        end
      when Option::None then mir_graph_query_error(operation)
      end
    elsif operation == "mir.path" then
      match mir_graph_split(&arg)
      when Option::Some(parts) then
        match mir_path_slice(mir, parts.0.clone(), parts.1.clone())
        when Option::Some(slice) then
          QueryResults {
            kind: operation,
            keys: slice.statements.clone(),
            payload: Option::Some(SemanticResponsePayload::MirSlice(slice.statements.clone(), slice.externals.clone()))
          }
        when Option::None then mir_graph_query_error(operation)
        end
      when Option::None then mir_graph_query_error(operation)
      end
    elsif operation == "mir.block" then
      match mir_block_stable_rows(mir, arg.clone())
      when Option::Some(rows) then QueryResults { kind: operation, keys: rows }
      when Option::None then mir_graph_query_error(operation)
      end
    elsif operation == "mir.diff" then
      match mir_graph_split(&arg)
      when Option::Some(parts) then
        match mir_graph_fn_find(mir.clone(), parts.0.clone())
        when Option::Some(fa) then
          match mir_graph_fn_find(mir, parts.1.clone())
          when Option::Some(fb) then
            QueryResults { kind: operation, keys: mir_diff_rows(fa, fb, parts.0.clone(), parts.1.clone()) }
          when Option::None then mir_graph_query_error(operation)
          end
        when Option::None then mir_graph_query_error(operation)
        end
      when Option::None then mir_graph_query_error(operation)
      end
    else
      mir_graph_query_error(operation)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Change helpers — typed probes over one §31 SemanticDelta
# ———————————————————————————————————————————————————————————————

# Membership in the delta's affected closure (see semantic_delta.tg).
def change_affected(delta: SemanticDelta, key: String) -> Bool
  delta.affected.contains(&key)
end

# The delta's modified-entity rows (kind "semantic_diff"). The payload
# Delta lifts the answer: changed = the modified stable ids (the same
# sorted answer rows as keys) and rows = the delta's affected closure (the
# invalidation unit — everything whose answer rows may have changed,
# semantic_delta.tg).
def change_semantic_diff(delta: SemanticDelta) -> QueryResults
  var keys: Vec[String] = Vec::new()
  for e in delta.modified do
    keys.push(e.stable_id.clone())
  end
  keys.sort_by(|a, b| a < b)
  QueryResults {
    kind: "semantic_diff",
    keys: keys.clone(),
    payload: Option::Some(SemanticResponsePayload::Delta(keys, delta.affected.clone()))
  }
end

# The delta's ABI row keys (the symmetric-difference rows of the typed
# abi surface's before/after views — the b-side pub-Function stable keys
# that changed between the two surfaces). Payload Abi carries the rows.
def abi_inspect(delta: SemanticDelta) -> QueryResults
  var keys = semantic_delta_rows_diff(&delta.abi_delta.before.rows,
    &delta.abi_delta.after.rows)
  keys.sort_by(|a, b| a < b)
  QueryResults {
    kind: "abi_inspect",
    keys: keys.clone(),
    payload: Option::Some(SemanticResponsePayload::Abi(keys))
  }
end

# ———————————————————————————————————————————————————————————————
# (audit item 52) Explain trees — derivation-DAG/tree answers built
# from the derivational data (NOT row lookup)
# ———————————————————————————————————————————————————————————————
# explain() routes the eight explain ops onto tree builders that render
# the derivation of the arg symbol as INDENTED TREE LINES (two spaces per
# depth; line 0 = the requested symbol). The builders consume ONLY
# derivational data:
#   - the session's snapshot/index rows (ownership rows of a function,
#     capability/effect rows, type membership rows, layout rows);
#   - the caller-supplied Diagnostic records (Option::None = none ride a
#     session): the §34 *_trace rows (the reason texts) and, when a class
#     has no rows, the typed DiagnosticSemanticData records of
#     parser.tg. Diagnostics record DISPLAY renders (primary_symbol of a
#     checker rejection is the type/function display text), so a
#     diagnostic joins an arg by exact text equality or by the arg's NAME
#     component against the display's HEAD (documented loose join); the
#     ownership scan additionally joins when the typed
#     OwnershipDiagnosticData.place equals the arg. The FIRST matching
#     diagnostic per class is used (deterministic).
# Per-op shapes:
#   type.explain(arg)          — root = the type; when a matching
#     diagnostic records a bound-failure constraint_trace (the §34 chain:
#     root type -> field -> field's type -> leaf reason), the chain rows
#     are the tree (the rows' own embedded indentation renders the
#     nesting); otherwise the type's fields/properties rows are the tree
#     (field/variant/property/method leaves).
#   trait.resolve(arg)         — root = the subject; a matching
#     diagnostic's trait_trace rows are the candidates tree (each
#     candidate row = candidate + why it failed; the trailing row carries
#     the remaining answer); typed TraitFailureData leaves when no rows.
#   ownership.explain(arg)     — root = the symbol/place; the snapshot's
#     ownership rows of the arg's function are children (one row-key text
#     per child); a matching diagnostic's ownership_trace state chain
#     ("place: live -> consumed at <site>", "rejected at ...") is the
#     state-chain subtree; typed OwnershipDiagnosticData leaves when the
#     diagnostic carries no rows.
#   effect.explain(arg)        — root = the function; the snapshot's
#     effect row (dirty bits -> the §11 class words, capability ids) is
#     the summary subtree; a matching diagnostic's effect_trace evidence
#     path (the f->g->h rows) is the evidence subtree under the violated
#     class; typed EffectViolationData leaves when no rows.
#   capability.explain(arg)    — root = the function; the capability rows
#     ("cap<N>|Requires|Provides") are leaves under the function.
#   layout.explain(arg)        — root + the abi_surfaces TYPE row's
#     layout render when the index holds one (third-audit item 20: the
#     §32 type_layout_map is populated from the snapshot's type surface
#     rows); otherwise the root + the HONEST leaf "not available from
#     snapshot rows" (no claim is made).
#   optimization.explain(arg)  — root + the HONEST leaf "not available
#     from snapshot rows" (no optimization row family rides a snapshot —
#     the perf/opt rows of perf_report.tg are per-MirProgram estimates,
#     not snapshot data; nothing is claimed).
#   diagnostic.explain(arg)    — arg = the diagnostic's Vec index (a
#     plain integer text) or a symbol joining the diagnostic's
#     primary_symbol; the tree is explain_diagnostic's derivation render
#     of the matched Diagnostic. explain_diagnostic(d) is the pure typed
#     entry: root = the diagnostic's primary symbol (its display render),
#     then the typed DiagnosticSemanticData leaves (when present) and the
#     §34 *_trace row families (verbatim reason leaves).
# Every tree is a pure function of its inputs; row families render in
# their recorded order (diagnostics) or the accessors' sorted order
# (session rows).



# One trace-row family as verbatim leaves (the rows carry the reason
# texts; the constraint-chain rows carry their own nesting indentation).

def explain_char_index(s: String, needle: String, from: Int) -> Int
  var i = from
  while i < s.len() do
    if s.slice(i, i + 1) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# Split a row on its FIRST separator occurrence (two parts max; the whole
# row when the separator is absent).
def explain_split_first(row: String, sep: String) -> Vec[String]
  var parts: Vec[String] = Vec::new()
  let i = explain_char_index(&row, &sep, 0)
  if i < 0 then
    parts.push(row.clone())
  else
    parts.push(row.slice(0, i))
    parts.push(row.slice(i + sep.len(), row.len()))
  end
  parts
end

# The NAME component of a stable def key: the text after the LAST "::" of
# the key's path component (everything before the first "#" signature
# marker). "a::b::f#sig" -> "f"; "f#sig" -> "f"; "f" -> "f".
def explain_key_name(key: String) -> String
  let hash_i = explain_char_index(&key, "#", 0)
  var sig_cut = if hash_i >= 0 then key.slice(0, hash_i) else key.clone() end
  var last = -1
  var i = 0
  while i + 1 < sig_cut.len() do
    if sig_cut.slice(i, i + 2) == "::" then
      last = i
    end
    i = i + 1
  end
  if last >= 0 then
    sig_cut.slice(last + 2, sig_cut.len())
  else
    sig_cut.clone()
  end
end

# The HEAD of a type-display render: everything before the first "["
# ("Wrapper[String]" -> "Wrapper"; a non-generic render is its own head).
def explain_display_head(display: String) -> String
  let bi = explain_char_index(&display, "[", 0)
  if bi >= 0 then display.slice(0, bi) else display.clone() end
end

# The diagnostic <-> arg symbol join: exact text equality, or the arg's
# NAME component against the display's HEAD (the documented loose join —
# checker diagnostics record DISPLAY renders while the session args are
# stable def keys).
def explain_symbol_matches(arg: String, display: String) -> Bool
  if arg.len() == 0 || display.len() == 0 then
    return false
  end
  if arg == display then
    return true
  end
  let name = explain_key_name(&arg)
  if name.len() == 0 then
    return false
  end
  name == explain_display_head(&display)
end

# Whether a diagnostic's §34 row family of the class is non-empty.
def explain_diag_class_rows(d: Diagnostic, class: String) -> Bool
  match class
  when "type" then d.constraint_trace.len() > 0
  when "trait" then d.trait_trace.len() > 0
  when "ownership" then d.ownership_trace.len() > 0
  when "effect" then d.effect_trace.len() > 0
  when _ then false
  end
end

# Whether a diagnostic's TYPED semantic data belongs to the class
# (TraitFailure covers the "trait" class; a TypeMismatch belongs to no
# explain-tree class — the mismatch's own op shape is diagnostic.explain).
def explain_diag_class_typed(d: Diagnostic, class: String) -> Bool
  var has = false
  match d.semantic_data
  when Option::Some(sd) then
    match sd
    when DiagnosticSemanticData::Ownership(_) then
      if class == "ownership" then has = true end
    when DiagnosticSemanticData::TypeMismatch(_) then ()
    when DiagnosticSemanticData::TraitFailure(_) then
      if class == "trait" then has = true end
    when DiagnosticSemanticData::EffectViolation(_) then
      if class == "effect" then has = true end
    end
  when Option::None then ()
  end
  has
end

# The FIRST diagnostic of one explain class whose primary symbol joins the
# arg (or whose typed OwnershipDiagnosticData.place equals place — the
# ownership place join), with rows or typed data of the class. Option::None
# when the list is absent or nothing matches.
def explain_diag_class_of(
  diagnostics: Option[Vec[Diagnostic]],
  arg: String,
  class: String,
  place: String
) -> Option[Diagnostic]
  var found: Option[Diagnostic] = Option::None
  match diagnostics
  when Option::Some(vec) then
    var i = 0
    while i < vec.len() do
      var joined = false
      match vec[i].primary_symbol
      when Option::Some(p) then
        if explain_symbol_matches(&arg, &p) then joined = true end
      when Option::None then ()
      end
      if !joined && place.len() > 0 then
        match vec[i].semantic_data
        when Option::Some(sd) then
          match sd
          when DiagnosticSemanticData::Ownership(od) then
            if od.place == place then joined = true end
          when _ then ()
          end
        when Option::None then ()
        end
      end
      if joined && (explain_diag_class_rows(&vec[i], class.clone()) ||
        explain_diag_class_typed(&vec[i], class.clone())) then
        found = Option::Some(vec[i].clone())
        break
      end
      i = i + 1
    end
  when Option::None then ()
  end
  found
end

# The FIRST diagnostic whose primary_symbol joins the arg (any class) —
# the diagnostic.explain arg join.
def explain_diag_symbol_of(diagnostics: Option[Vec[Diagnostic]], arg: String) -> Option[Diagnostic]
  var found: Option[Diagnostic] = Option::None
  match diagnostics
  when Option::Some(vec) then
    var i = 0
    while i < vec.len() do
      match vec[i].primary_symbol
      when Option::Some(p) then
        if explain_symbol_matches(&arg, &p) then
          found = Option::Some(vec[i].clone())
          break
        end
      when Option::None then ()
      end
      i = i + 1
    end
  when Option::None then ()
  end
  found
end

# The §11 class words present in an effect dirty-bits word (the
# semantic_model.tg bit order: allocate=1, block=2, io=4, spawn=8,
# sleep=16, panic=32, unsafe=64).
def explain_effect_class_words(bits: Int, inout out: Vec[String]) -> Unit
  if bits & 1 != 0 then out.push("alloc") end
  if bits & 2 != 0 then out.push("block") end
  if bits & 4 != 0 then out.push("io") end
  if bits & 8 != 0 then out.push("spawn") end
  if bits & 16 != 0 then out.push("sleep") end
  if bits & 32 != 0 then out.push("panic") end
  if bits & 64 != 0 then out.push("unsafe") end
  ()
end

# ———————————————————————————————————————————————————————————————
# The per-op tree builders
# ———————————————————————————————————————————————————————————————

# type.explain: root = the type key; a matching diagnostic's §34 bound-
# failure chain rows (root type -> field -> field's type -> leaf reason)
# are the tree; else the type's membership rows are the tree.
# Every builder below returns the TYPED ExplainNode derivation tree;
# explain_tree is the typed API, and explain()/explain_results render the
# tree through semantic_diagnostics.explain_node_render (the ONE
# renderer, byte-identical to the pre-item-23 string trees). Node kinds
# are the machine identity explain_node_find matches; "reason" leaves are
# VERBATIM rows (they carry their own embedded indentation), exactly like
# the old explain_trace_rows leaves.

# type.explain: root = the type key; a matching diagnostic's §34 bound-
# failure chain rows (root type -> field -> field's type -> leaf reason)
# are the tree; else the type's membership rows are the tree.
def explain_type_node(
  session: SemanticQuerySession,
  arg: String,
  diagnostics: Option[Vec[Diagnostic]]
) -> ExplainNode
  var root = explain_text_node("type.explain", arg.clone())
  match explain_diag_class_of(diagnostics, arg.clone(), "type", "")
  when Option::Some(d) then
    root = explain_node_child(root, explain_node_with_children("bound-failure-chain",
      "bound-failure chain".to_string(), "".to_string(), "".to_string(),
      explain_verbatim_row_nodes("reason".to_string(), d.constraint_trace.clone())))
  when Option::None then
    var kind_word = ""
    let kinds = index_types_of(&session.index, arg.clone())
    if kinds.len() == 1 then kind_word = kinds[0].clone() end
    var member_label = "member"
    if kind_word == "Struct" then
      member_label = "field"
    elsif kind_word == "Enum" then
      member_label = "variant"
    end
    var any = false
    for f in index_fields_of(&session.index, arg.clone()) do
      root = explain_node_child(root, explain_text_node("type-member", member_label.clone() + " " + f.clone()))
      any = true
    end
    for p in index_properties_of(&session.index, arg.clone()) do
      root = explain_node_child(root, explain_text_node("type-property", "property " + p.clone()))
      any = true
    end
    for m in index_impls_of(&session.index, arg.clone()) do
      root = explain_node_child(root, explain_text_node("type-method", "method " + m.clone()))
      any = true
    end
    if !any then
      root = explain_node_child(root, explain_text_node("type-members-empty", "no type membership rows"))
    end
  end
  root
end

# trait.resolve: root = the subject; a matching diagnostic's trait_trace
# rows are the candidates tree — each candidate row carries the candidate
# and why it failed, the trailing row the remaining answer; typed
# TraitFailureData leaves (obligation + rejected candidates) when the
# diagnostic carries no rows.
def explain_trait_node(
  session: SemanticQuerySession,
  arg: String,
  diagnostics: Option[Vec[Diagnostic]],
  kind_word: String
) -> ExplainNode
  var root = explain_text_node(kind_word.clone(), arg.clone())
  match explain_diag_class_of(diagnostics, arg.clone(), "trait", "")
  when Option::Some(d) then
    if d.trait_trace.len() > 0 then
      root = explain_node_child(root, explain_node_with_children("trait-trace",
        "trait trace rows".to_string(), "".to_string(), "".to_string(),
        explain_verbatim_row_nodes("reason".to_string(), d.trait_trace.clone())))
    else
      match d.semantic_data
      when Option::Some(sd) then
        match sd
        when DiagnosticSemanticData::TraitFailure(tf) then
          if tf.obligation.len() > 0 then
            root = explain_node_child(root, explain_text_node("trait-obligation", "obligation " + tf.obligation.clone()))
          end
          if tf.rejected_candidates.len() > 0 then
            var rej = explain_text_node("trait-rejected-candidates", "rejected candidates")
            for rc in tf.rejected_candidates do
              rej = explain_node_child(rej, explain_text_node("trait-rejected-candidate", rc.clone()))
            end
            root = explain_node_child(root, rej)
          end
        when _ then ()
        end
      when Option::None then ()
      end
    end
  when Option::None then
    root = explain_node_child(root, explain_text_node("trait-empty", "no trait-resolution data"))
  end
  root
end

# ownership.explain: root = the requested symbol/place; the snapshot's
# ownership rows of the arg's function are children (one canonical
# row-key text per child); a matching diagnostic's ownership_trace state
# chain is the state-chain subtree; typed OwnershipDiagnosticData leaves
# when the diagnostic carries no rows.
def explain_ownership_node(
  session: SemanticQuerySession,
  arg: String,
  diagnostics: Option[Vec[Diagnostic]]
) -> ExplainNode
  var root = explain_text_node("ownership.explain", arg.clone())
  var any = false
  for o in session.snapshot.ownership do
    let row_key = o.function.key.clone() + "|" + o.place_key.clone() + "|" +
      query_ownership_conv_text(&o.convention)
    if row_key.starts_with(arg.clone() + "|") then
      root = explain_node_child(root, explain_text_node("ownership-row", row_key.clone()))
      any = true
    end
  end
  match explain_diag_class_of(diagnostics, arg.clone(), "ownership", arg.clone())
  when Option::Some(d) then
    if d.ownership_trace.len() > 0 then
      root = explain_node_child(root, explain_node_with_children("ownership-state-chain",
        "ownership state chain".to_string(), "".to_string(), "".to_string(),
        explain_verbatim_row_nodes("reason".to_string(), d.ownership_trace.clone())))
    else
      match d.semantic_data
      when Option::Some(sd) then
        match sd
        when DiagnosticSemanticData::Ownership(od) then
          var chain = explain_text_node("ownership-state-chain", "ownership state chain")
          chain = explain_node_child(chain, explain_text_node("ownership-place", "place " + od.place.clone()))
          chain = explain_node_child(chain, explain_text_node("ownership-state-before", "state before " + od.state_before.clone()))
          chain = explain_node_child(chain, explain_text_node("ownership-operation", "operation " + od.operation.clone()))
          if od.consume_site.len() > 0 then
            chain = explain_node_child(chain, explain_text_node("ownership-consume-site", "consumed at " + od.consume_site.clone()))
          end
          if od.use_site.len() > 0 then
            chain = explain_node_child(chain, explain_text_node("ownership-use-site", "rejected at " + od.use_site.clone()))
          end
          if od.type_id.len() > 0 then
            chain = explain_node_child(chain, explain_text_node("ownership-type", "type " + od.type_id.clone()))
          end
          root = explain_node_child(root, chain)
        when _ then ()
        end
      when Option::None then ()
      end
    end
    any = true
  when Option::None then ()
  end
  if !any then
    root = explain_node_child(root, explain_text_node("ownership-empty", "no ownership rows"))
  end
  root
end

# The typed evidence path as a NESTED chain: path[0] is the chain root and
# every later hop is its child, so the render indents each hop exactly one
# level deeper — the old renderer's 3 + i depths. Callers guard
# path.len() > 1.
def explain_effect_evidence_chain(path: Vec[String]) -> ExplainNode
  var i = path.len() - 1
  var chain = explain_text_node("effect-evidence", path[i].clone())
  while i > 0 do
    i = i - 1
    chain = explain_node_child(explain_text_node("effect-evidence", path[i].clone()), chain)
  end
  chain
end

# effect.explain: root = the function; the snapshot's effect row is the
# summary subtree (the §11 class words of the dirty bits + the capability
# ids); a matching diagnostic's effect_trace evidence path rows (the
# f->g->h chain) are the evidence subtree; typed EffectViolationData
# leaves when no rows.
def explain_effect_node(
  session: SemanticQuerySession,
  arg: String,
  diagnostics: Option[Vec[Diagnostic]]
) -> ExplainNode
  var root = explain_text_node("effect.explain", arg.clone())
  var any = false
  let rows = index_effects_of(&session.index, arg.clone())
  if rows.len() == 1 then
    let split = query_effect_row_split(&rows[0])
    var summary = explain_text_node("effect-summary", "effect summary")
    if split.0 == 0 then
      summary = explain_node_child(summary, explain_text_node("effect-class", "no effect classes"))
    else
      var words: Vec[String] = Vec::new()
      explain_effect_class_words(split.0, &mut words)
      for w in words do
        summary = explain_node_child(summary, explain_text_node("effect-class", w.clone()))
      end
    end
    if split.1.len() > 0 then
      for c in split.1 do
        summary = explain_node_child(summary, explain_text_node("effect-capability", "capability cap" + c.clone()))
      end
    end
    root = explain_node_child(root, summary)
    any = true
  end
  match explain_diag_class_of(diagnostics, arg.clone(), "effect", "")
  when Option::Some(d) then
    if d.effect_trace.len() > 0 then
      root = explain_node_child(root, explain_node_with_children("effect-evidence-path",
        "effect evidence path".to_string(), "".to_string(), "".to_string(),
        explain_verbatim_row_nodes("reason".to_string(), d.effect_trace.clone())))
    else
      match d.semantic_data
      when Option::Some(sd) then
        match sd
        when DiagnosticSemanticData::EffectViolation(ev) then
          var ev_node = explain_text_node("effect-evidence-path", "effect evidence path")
          ev_node = explain_node_child(ev_node, explain_text_node("effect-claim", "claim " + ev.effect.clone()))
          # The evidence path is a NESTED chain (path[0] at depth 3,
          # path[i] at 3 + i — the old renderer's exact depths).
          if ev.path.len() > 1 then
            ev_node = explain_node_child(ev_node, explain_effect_evidence_chain(ev.path.clone()))
          else
            ev_node = explain_node_child(ev_node, explain_text_node("effect-no-evidence", "no evidence leaf reachable"))
          end
          root = explain_node_child(root, ev_node)
        when _ then ()
        end
      when Option::None then ()
      end
    end
    any = true
  when Option::None then ()
  end
  if !any then
    root = explain_node_child(root, explain_text_node("effect-empty", "no effect data"))
  end
  root
end

# capability.explain: root = the function; the capability rows of the
# function ("cap<N>|Requires|Provides") are leaves under the function
# (the cap node carries the id, the direction rides under it).
def explain_capability_node(session: SemanticQuerySession, arg: String) -> ExplainNode
  var root = explain_text_node("capability.explain", arg.clone())
  let rows = index_capabilities_of(&session.index, arg.clone())
  if rows.len() > 0 then
    for r in rows do
      let parts = explain_split_first(&r, "|")
      var cap = explain_text_node("capability", parts[0].clone())
      if parts.len() > 1 then
        cap = explain_node_child(cap, explain_text_node("capability-direction", parts[1].clone()))
      end
      root = explain_node_child(root, cap)
    end
  else
    root = explain_node_child(root, explain_text_node("capability-empty", "no capability rows"))
  end
  root
end

# layout.explain: root + the abi_surfaces TYPE row's layout render when the
# index holds one (third-audit item 20); otherwise the HONEST leaf — no
# layout claim is made.
def explain_layout_node(session: SemanticQuerySession, arg: String) -> ExplainNode
  var root = explain_text_node("layout.explain", arg.clone())
  let rows = index_type_layout_of(&session.index, arg.clone())
  if rows.len() > 0 then
    for r in rows do
      root = explain_node_child(root, explain_verbatim_node("reason", r.clone()))
    end
  else
    root = explain_node_child(root, explain_text_node("layout-empty", "not available from snapshot rows"))
  end
  root
end

# optimization.explain: root + the HONEST leaf — no optimization row
# family rides a snapshot or index (the perf/opt rows of perf_report.tg
# are per-MirProgram estimates, never snapshot data); nothing is claimed.
def explain_optimization_node(arg: String) -> ExplainNode
  var root = explain_text_node("optimization.explain", arg.clone())
  root = explain_node_child(root, explain_text_node("optimization-empty", "not available from snapshot rows"))
  root
end

# ———————————————————————————————————————————————————————————————
# diagnostic.explain — the derivation render of ONE Diagnostic
# ———————————————————————————————————————————————————————————————
# explain_diagnostic renders the diagnostic's derivational data: root =
# the diagnostic's primary symbol (its display render), then the typed
# DiagnosticSemanticData leaves of the class (when present) and every
# non-empty §34 *_trace row family as verbatim reason leaves. A
# diagnostic with no structured data (no semantic_data, no row family, no
# expected/actual pair) answers the honest leaf — never invented content.

# The pure typed entry: the derivation tree of ONE Diagnostic. Root = the
# diagnostic's primary_symbol when it records one (display render), else
# its semantic_site, else the word "diagnostic". Children = the typed
# DiagnosticSemanticData leaves (when the record carries a payload) and
# the §34 *_trace row families (verbatim reason rows). No message prose
# ever enters the tree; a data-less diagnostic answers the honest leaf.
pub def explain_diagnostic(d: Diagnostic) -> ExplainResult
  let node = diagnostic_explain_node(&d)
  ExplainResult { kind: node.kind.clone(), tree: explain_node_render(&node) }
end

# The dispatchable diagnostic.explain: arg = the diagnostic's Vec index
# (a plain integer text into the supplied list) or a symbol joining the
# diagnostic's primary_symbol (explain_symbol_matches). No match answers
# root + the honest "no diagnostic matched" leaf; an absent list answers
# "no diagnostic supplied".
def explain_diagnostic_dispatch_node(
  arg: String,
  diagnostics: Option[Vec[Diagnostic]]
) -> ExplainNode
  var chosen: Option[Diagnostic] = Option::None
  match arg.parse_int()
  when Result::Ok(idx) then
    match diagnostics
    when Option::Some(vec) then
      if idx >= 0 && idx < vec.len() then
        chosen = Option::Some(vec[idx].clone())
      end
    when Option::None then ()
    end
  when Result::Err(_) then ()
  end
  match chosen
  when Option::None then
    match diagnostics
    when Option::Some(_) then
      match explain_diag_symbol_of(diagnostics, arg.clone())
      when Option::Some(d) then
        diagnostic_explain_node(&d)
      when Option::None then
        var root = explain_text_node("diagnostic.explain", arg.clone())
        explain_node_child(root, explain_text_node("diagnostic-missing", "no diagnostic matched"))
      end
    when Option::None then
      var root = explain_text_node("diagnostic.explain", arg.clone())
      explain_node_child(root, explain_text_node("diagnostic-absent", "no diagnostic supplied"))
    end
  when Option::Some(d) then
    diagnostic_explain_node(&d)
  end
end

# ———————————————————————————————————————————————————————————————
# The explain() dispatch — one typed tree per explain op name
# ———————————————————————————————————————————————————————————————
# Routes the explain ops onto the per-op builders. The diagnostics
# argument is OPTIONAL (a session holds no Diagnostic records — the
# snapshot/index rows alone drive the trees when it is absent; see the
# section doc for the honest leaves each op then answers). Names outside
# the explain set return kind "unknown" with the empty tree.
pub def explain_tree(
  session: SemanticQuerySession,
  operation: String,
  arg: String,
  diagnostics: Option[Vec[Diagnostic]] = Option::None
) -> ExplainNode
  match operation
  when "type.explain" then explain_type_node(&session, arg.clone(), diagnostics)
  when "trait.resolve" then explain_trait_node(&session, arg.clone(), diagnostics, "trait.resolve".to_string())
  when "trait.explain" then explain_trait_node(&session, arg.clone(), diagnostics, "trait.explain".to_string())
  when "ownership.explain" then explain_ownership_node(&session, arg.clone(), diagnostics)
  when "effect.explain" then explain_effect_node(&session, arg.clone(), diagnostics)
  when "capability.explain" then explain_capability_node(&session, arg.clone())
  when "layout.explain" then explain_layout_node(&session, arg.clone())
  when "optimization.explain" then explain_optimization_node(arg.clone())
  when "diagnostic.explain" then explain_diagnostic_dispatch_node(arg.clone(), diagnostics)
  when _ then explain_text_node("unknown".to_string(), "".to_string())
  end
end

# The compatibility surface: render the typed tree through the ONE
# ExplainNode renderer (kind + display-order lines).
pub def explain(
  session: SemanticQuerySession,
  operation: String,
  arg: String,
  diagnostics: Option[Vec[Diagnostic]] = Option::None
) -> ExplainResult
  let node = explain_tree(session, operation, arg, diagnostics)
  ExplainResult { kind: node.kind.clone(), tree: explain_node_render(&node) }
end

# The explain answer in the §38 envelope: kind = the tree's typed kind
# word; keys = the tree's render lines in DISPLAY ORDER (the documented
# render-carrier exception to the sorted-keys doctrine — see the module
# doc's explain paragraph); payload stays None. The query()/server
# dispatchers route their explain arms through this adapter (diagnostics
# absent: only the snapshot/index rows drive the trees).
pub def explain_results(session: SemanticQuerySession, operation: String, arg: String) -> QueryResults
  let er = explain(session, operation, arg, Option::None)
  QueryResults { kind: er.kind.clone(), keys: er.tree.clone() }
end

# ———————————————————————————————————————————————————————————————
# The third-audit item 20/23 operation families — typed answers where the
# session data exists, "<op>_unavailable" where it does not
# ———————————————————————————————————————————————————————————————
# Every op below is a THIN projection of an existing table/accessor — no
# new analysis: type.get / type.properties / type.layout / type.use over
# the §32 index maps (layout from the snapshot's abi_surfaces type rows,
# type.use from the typed TypeUseEdge inverse); ownership.moves /
# ownership.drop_plan over the snapshot's
# ownership facts; contract.obligations / contract.verify over the
# recorded contract rows (obligations also answers the ContractReferenceEdge
# refs); symbol.references over the call/test/type/type-user
# accessors; trait.resolve over the typed TraitImplEdge rows;
# snapshot.get / snapshot.diff over the §29 snapshot and the
# §31 delta; build.plan / verify.plan over the §37 evidence gates; the
# diagnostic.* ops over the retained DiagnosticStore; the replay.* ops
# over the §42 engine (a trace-requiring adapter).

# ———— type ops ————

pub def type_get(index: SemanticIndex, key: String) -> QueryResults
  let rows = index_types_of(&index, key.clone())
  let kind_word = if rows.len() == 1 then rows[0].clone() else "".to_string() end
  QueryResults {
    kind: "type.get",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Type(kind_word, rows))
  }
end

pub def type_properties(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "type.properties", keys: index_properties_of(&index, key.clone()) }
end

# (third-audit item 20) type.layout answers the abi_surfaces TYPE row's
# layout render ("size=<n>;align=<n>;fields=...") through the typed index
# map; an absent row is the honest "unavailable" — never a fabricated
# layout: the op kind is "type.layout_unavailable".
pub def type_layout(index: SemanticIndex, key: String) -> QueryResults
  let rows = index_type_layout_of(&index, key.clone())
  if rows.len() == 0 then
    QueryResults { kind: "type.layout_unavailable", keys: Vec::new() }
  else
    QueryResults { kind: "type.layout", keys: rows }
  end
end

# (third-audit item 20) type.use — the canonical user key texts of a USED
# type key, from the typed TypeUseEdge inverse (no row-text scan). An
# unused type answers the empty list (a real answer of the op).
pub def type_use(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "type.use", keys: index_type_users_of(&index, key.clone()) }
end

# (third-audit item 20) trait.resolve — the typed impl KEYS of a trait
# key: the index's TraitImplEdge rows are "self-type|impl-key", and the
# op answers the impl-key column (the typed replacement for any
# path-convention impl reconstruction). An unknown / impl-less trait
# answers "trait.resolve_unavailable" (fail-closed; the explain() API
# keeps the trait.resolve derivation TREE — see explain_trait_node).
pub def trait_resolve(index: SemanticIndex, key: String) -> QueryResults
  let rows = index_impls_of_trait(&index, key.clone())
  if rows.len() == 0 then
    return QueryResults { kind: "trait.resolve_unavailable", keys: Vec::new() }
  end
  var keys: Vec[String] = Vec::new()
  for r in rows do
    let parts = explain_split_first(&r, "|")
    if parts.len() > 1 then
      if !keys.contains(&parts[1]) then
        keys.push(parts[1].clone())
      end
    else
      if !keys.contains(&r) then
        keys.push(r.clone())
      end
    end
  end
  keys.sort_by(|a, b| a < b)
  QueryResults { kind: "trait.resolve", keys: keys }
end

# ———— ownership ops ————
# The snapshot's OwnershipFact rows ARE the persistent ownership facts;
# there is NO separate DropPlan table in the model (documented), so
# ownership.drop_plan answers the arg's recorded per-place facts (the
# transfer/drop-site facts the model actually holds) — never an inferred
# glue plan. ownership.moves narrows to the Sink (moved) convention.

def ownership_fact_row(o: OwnershipFact) -> String
  o.function.key.clone() + "|" + o.place_key.clone() + "|" + query_ownership_conv_text(&o.convention)
end

def ownership_rows_for(snapshot: SemanticSnapshot, key: String, sink_only: Bool) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  for o in snapshot.ownership do
    if o.function.key == key then
      var take = true
      if sink_only then
        match o.convention
        when AccessConvention::Sink then take = true
        when _ then take = false
        end
      end
      if take then rows.push(ownership_fact_row(&o)) end
    end
  end
  rows.sort_by(|a, b| a < b)
  rows
end

pub def ownership_moves(snapshot: SemanticSnapshot, key: String) -> QueryResults
  let rows = ownership_rows_for(snapshot, key.clone(), true)
  QueryResults {
    kind: "ownership.moves",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Ownership(rows))
  }
end

pub def ownership_drop_plan(snapshot: SemanticSnapshot, key: String) -> QueryResults
  let rows = ownership_rows_for(snapshot, key.clone(), false)
  QueryResults {
    kind: "ownership.drop_plan",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Ownership(rows))
  }
end

# ———— contract ops ————

# (third-audit item 20) contract.obligations answers the recorded clause
# row-key texts of the arg function PLUS the clause's typed reference rows
# ("contract-ref:<referenced def key>") from the index's
# ContractReferenceEdge inverse — the contract row id (StableContractId.
# stable_key) joins the snapshot clause to its index refs.
pub def contract_obligations_results(index: SemanticIndex, snapshot: SemanticSnapshot, key: String) -> QueryResults
  var rows = contract_obligations(&snapshot, key.clone())
  for c in snapshot.contracts do
    if c.function.key == key then
      for r in index_contract_refs_of(&index, c.id.stable_key.clone()) do
        rows.push("contract-ref:" + r.clone())
      end
    end
  end
  var out: Vec[String] = Vec::new()
  for r in rows do
    if !out.contains(&r) then
      out.push(r.clone())
    end
  end
  out.sort_by(|a, b| a < b)
  QueryResults {
    kind: "contract.obligations",
    keys: out.clone(),
    payload: Option::Some(SemanticResponsePayload::Contract(out))
  }
end

# contract.verify — the reachable verification on ONE snapshot: every
# recorded clause is projected to the typed ContractSemantic form and
# checked two ways through the contract relation machinery:
#   1. contract_relation_of(Some(clause), Some(clause)) must classify the
#      projection Equivalent (the prover's canonical-equality rule — a
#      malformed/foreign projection answers Incomparable, never a
#      fabricated implication);
#   2. the clause's expression_fingerprint is RE-COMPUTED from its
#      canonical expression text and compared (the snapshot builder
#      digests exactly that text).
# The two-snapshot before/after prover needs an OLD/NEW pair a single
# session does not hold — the honest documented boundary; no implication
# claim is ever fabricated here. Rows: "verified:" / "mismatch:" plus one
# "relation:<kind>:<word>" row per recorded clause.
pub def contract_verify(snapshot: SemanticSnapshot, key: String) -> QueryResults
  var rows: Vec[String] = Vec::new()
  var any = false
  for c in snapshot.contracts do
    if c.function.key == key then
      any = true
      let kind_word = query_contract_kind_text(&c.kind)
      let text = semantic_contract_expr_text(&c.canonical_expression)
      let sem = ContractSemantic {
        kind: kind_word.clone(),
        expression_fingerprint: semantic_digest_render(&c.expression_fingerprint),
        canonical_text: text.clone(),
        message: c.message.clone()
      }
      let relation_word = contract_relation_word(
        contract_relation_of(Option::Some(sem.clone()), Option::Some(sem.clone())))
      let recomputed = stable_digest_of(&text)
      let row_key = key.clone() + "|" + kind_word.clone() + "|" + text
      if recomputed.hi == c.expression_fingerprint.hi &&
         recomputed.lo == c.expression_fingerprint.lo &&
         relation_word == "Equivalent" then
        rows.push("verified:" + row_key)
      else
        rows.push("mismatch:" + row_key)
      end
      rows.push("relation:" + kind_word.clone() + ":" + relation_word)
    end
  end
  if !any then
    QueryResults { kind: "contract.verify_unavailable", keys: Vec::new() }
  else
    rows.sort_by(|a, b| a < b)
    QueryResults {
      kind: "contract.verify",
      keys: rows.clone(),
      payload: Option::Some(SemanticResponsePayload::Contract(rows))
    }
  end
end

# ———— symbol.references ————
# The arg's recorded references: callers (the call index), tests (the
# test-relationship index), the nominal type row (the type index) and the
# typed TYPE-USERS (the TypeUseEdge inverse — third-audit item 20; the old
# documented model gap is closed). Nothing is invented: every row renders
# one typed edge / recorded index entry.
pub def symbol_references(index: SemanticIndex, key: String) -> QueryResults
  var rows: Vec[String] = Vec::new()
  for c in index_callers_of(&index, key.clone()) do
    rows.push("caller:" + c.clone())
  end
  for t in index_tests_for_symbol(&index, key.clone()) do
    rows.push("test:" + t.clone())
  end
  let kinds = index_types_of(&index, key.clone())
  if kinds.len() == 1 then
    rows.push("type:" + kinds[0].clone())
  end
  for u in index_type_users_of(&index, key.clone()) do
    rows.push("type-user:" + u.clone())
  end
  rows.sort_by(|a, b| a < b)
  var out: Vec[String] = Vec::new()
  for r in rows do
    if !out.contains(&r) then
      out.push(r.clone())
    end
  end
  QueryResults { kind: "symbol.references", keys: out }
end

# ———— coverage ops (third-audit item 34) ————
# The §40 coverage answers over the session snapshot's coverage table.
# Both ops build ONE CoverageGraph from the snapshot (the graph builder is
# the read authority) and answer REAL rows when the snapshot carries
# ingested CoverageRelationship evidence (coverage_graph_has_rows = the
# availability gate):
#   test.affected <symbol key> — the sorted test-function stable keys
#     reaching the symbol (the SymbolId -> TestId index). Empty keys with
#     kind "test.affected" is the honest "coverage rows exist, no test
#     reaches this symbol" answer.
#   coverage.affected <symbol key> — the sorted tg.cov.v1 point ids the
#     symbol's coverage rows carry (blocks/edges/contracts/effect sites).
# Without any coverage rows the ops answer "<op>_unavailable" with empty
# keys (the documented fail-closed form; no test-relationship claim is
# fabricated from the empty table). payload stays None — no
# SemanticResponsePayload family is enumerated for the coverage ops.
pub def test_affected(snapshot: SemanticSnapshot, key: String) -> QueryResults
  let graph = coverage_graph_of_snapshot(snapshot.clone())
  if !coverage_graph_has_rows(graph.clone()) then
    return QueryResults { kind: "test.affected_unavailable", keys: Vec::new() }
  end
  QueryResults { kind: "test.affected", keys: tests_covering_symbol(&graph, key.clone()) }
end

pub def coverage_affected(snapshot: SemanticSnapshot, key: String) -> QueryResults
  let graph = coverage_graph_of_snapshot(snapshot.clone())
  if !coverage_graph_has_rows(graph.clone()) then
    return QueryResults { kind: "coverage.affected_unavailable", keys: Vec::new() }
  end
  QueryResults { kind: "coverage.affected", keys: coverage_points_of_symbol(&graph, key.clone()) }
end

# ———— snapshot ops ————

def snapshot_count_row(name: String, n: Int) -> String
  "rows:" + name + ":" + n.to_string()
end

pub def snapshot_get(snapshot: SemanticSnapshot) -> QueryResults
  var rows: Vec[String] = Vec::new()
  rows.push("revision:" + semantic_digest_render(&snapshot.revision))
  rows.push("compiler_version:" + snapshot.compiler_version.clone())
  rows.push("target:" + snapshot.target.triple.clone())
  rows.push(snapshot_count_row("symbols".to_string(), snapshot.symbols.len()))
  rows.push(snapshot_count_row("types".to_string(), snapshot.types.len()))
  rows.push(snapshot_count_row("calls".to_string(), snapshot.calls.len()))
  rows.push(snapshot_count_row("indirect_calls".to_string(), snapshot.indirect_calls.len()))
  rows.push(snapshot_count_row("effects".to_string(), snapshot.effects.len()))
  rows.push(snapshot_count_row("capabilities".to_string(), snapshot.capabilities.len()))
  rows.push(snapshot_count_row("ownership".to_string(), snapshot.ownership.len()))
  rows.push(snapshot_count_row("contracts".to_string(), snapshot.contracts.len()))
  rows.push(snapshot_count_row("tests".to_string(), snapshot.tests.len()))
  # (third-audit item 34) the ingested coverage row count — a build
  # snapshot carries 0 until coverage_ingest writes the table.
  rows.push(snapshot_count_row("coverage".to_string(), snapshot.coverage.len()))
  rows.push(snapshot_count_row("mir_functions".to_string(), snapshot.mir_functions.len()))
  rows.push(snapshot_count_row("abi_surfaces".to_string(), snapshot.abi_surfaces.len()))
  rows.sort_by(|a, b| a < b)
  QueryResults { kind: "snapshot.get", keys: rows }
end

# The thin §31 delta wrapper of two snapshots (the module-scope form; the
# single-session query() arm answers "snapshot.diff_unavailable" because a
# session holds ONE snapshot — the server's session_delta/revise surface
# owns the pair).
pub def snapshot_diff(old: SemanticSnapshot, new: SemanticSnapshot) -> QueryResults
  let delta = semantic_delta_of(&old, &new)
  var changed: Vec[String] = Vec::new()
  for e in delta.modified do
    changed.push(e.stable_id.clone())
  end
  changed.sort_by(|a, b| a < b)
  var rows: Vec[String] = Vec::new()
  for k in delta.created do
    rows.push("created:" + k.clone())
  end
  for k in delta.removed do
    rows.push("removed:" + k.clone())
  end
  for k2 in changed.clone() do
    rows.push("modified:" + k2.clone())
  end
  let affected = delta.affected.clone()
  for k3 in affected.clone() do
    rows.push("affected:" + k3.clone())
  end
  rows.sort_by(|a, b| a < b)
  QueryResults {
    kind: "snapshot.diff",
    keys: rows.clone(),
    payload: Option::Some(SemanticResponsePayload::Delta(changed, affected))
  }
end

# ———— build.plan / verify.plan ————
# The stage gates of the compilation's §37 VerifiedCompilationEvidence
# (every flag is a stage the pipeline actually ran — see proof_patch.tg)
# plus the change-budget / equivalence requirements a downstream verifier
# consumes. No evidence (the offline-artifact session forms) answers
# "<op>_unavailable" — a plan is never fabricated.

def plan_gate_row(name: String, ok: Bool) -> String
  if ok then "gate:" + name + ":ok" else "gate:" + name + ":unverified" end
end

def evidence_gate_rows(e: VerifiedCompilationEvidence) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  rows.push(plan_gate_row("parse".to_string(), e.parse_ok))
  rows.push(plan_gate_row("resolution".to_string(), e.resolution_ok))
  rows.push(plan_gate_row("types".to_string(), e.type_ok))
  rows.push(plan_gate_row("access".to_string(), e.access_ok))
  rows.push(plan_gate_row("resource".to_string(), e.resource_ok))
  rows.push(plan_gate_row("mir_verify".to_string(), e.mir_verify_ok))
  rows.push(plan_gate_row("mono_verify".to_string(), e.mono_verify_ok))
  rows.push(plan_gate_row("post_opt_mir_verify".to_string(), e.post_opt_mir_verify_ok))
  rows.push(plan_gate_row("effect_verify".to_string(), e.effect_verify_ok))
  rows.push(plan_gate_row("abi_verify".to_string(), e.abi_verify_ok))
  rows
end

def plan_requirement_rows() -> Vec[String]
  Vec::from([
    "requirement:budget:ChangeBudget".to_string(),
    "requirement:equivalence:level-claimed".to_string()
  ])
end

pub def build_plan(evidence: Option[VerifiedCompilationEvidence]) -> QueryResults
  match evidence
  when Option::None then QueryResults { kind: "build.plan_unavailable", keys: Vec::new() }
  when Option::Some(e) then
    var rows = evidence_gate_rows(e)
    for r in plan_requirement_rows() do
      rows.push(r)
    end
    rows.sort_by(|a, b| a < b)
    QueryResults { kind: "build.plan", keys: rows }
  end
end

pub def verify_plan(evidence: Option[VerifiedCompilationEvidence]) -> QueryResults
  match evidence
  when Option::None then QueryResults { kind: "verify.plan_unavailable", keys: Vec::new() }
  when Option::Some(e) then
    var rows = evidence_gate_rows(e.clone())
    if evidence_all_ok(e) then
      rows.push("verify:all_ok".to_string())
    else
      rows.push("verify:incomplete".to_string())
    end
    for r in plan_requirement_rows() do
      rows.push(r)
    end
    rows.sort_by(|a, b| a < b)
    QueryResults { kind: "verify.plan", keys: rows }
  end
end

# ———— diagnostic ops (the retained store) ————

pub def diagnostic_get(store: DiagnosticStore, arg: String) -> QueryResults
  match store_match(store.clone(), arg.clone())
  when Option::Some(record) then
    QueryResults { kind: "diagnostic.get", keys: diagnostic_record_get_rows(record) }
  when Option::None then
    QueryResults { kind: "diagnostic.get_unavailable", keys: Vec::new() }
  end
end

# Store-aware diagnostic.explain: the record-form derivation tree. An
# EMPTY store keeps the pre-item-23 byte-identical answer ("no diagnostic
# supplied"); a non-empty store without a match answers "no diagnostic
# matched"; a match renders the record tree (id root, span, class, typed
# related rows — never message prose).
pub def diagnostic_explain_store(store: DiagnosticStore, arg: String) -> QueryResults
  let count = store_len(store.clone())
  if count == 0 then
    var tree: Vec[String] = Vec::new()
    tree.push(arg.clone())
    tree.push("  no diagnostic supplied")
    return QueryResults { kind: "diagnostic.explain", keys: tree }
  end
  match store_match(store.clone(), arg.clone())
  when Option::Some(record) then
    QueryResults { kind: "diagnostic.explain", keys: explain_node_render(&diagnostic_record_explain_node(record)) }
  when Option::None then
    var tree: Vec[String] = Vec::new()
    tree.push(arg.clone())
    tree.push("  no diagnostic matched")
    QueryResults { kind: "diagnostic.explain", keys: tree }
  end
end

pub def diagnostic_repair_context_store(store: DiagnosticStore, arg: String) -> QueryResults
  match store_match(store.clone(), arg.clone())
  when Option::Some(record) then
    QueryResults { kind: "diagnostic.repair_context", keys: diagnostic_record_repair_context(record) }
  when Option::None then
    QueryResults { kind: "diagnostic.repair_context_unavailable", keys: Vec::new() }
  end
end

# ———— replay ops ————
# The §42 adapter: every op delegates to replay.tg when the caller holds
# the trace(s); the session-scoped query() arms pass no trace and answer
# "<op>_unavailable" (a session holds no event trace). The arg grammar of
# the event-addressed ops is "seq:<n>" (the trace-relative sequence) with
# "|<place>" appended for value_at.

def replay_id_render(id: ReplayEventId) -> String
  "seq:" + id.sequence.to_string() + "|" + id.function_key.clone() + "|" +
    id.stmt_key.clone() + "|" + id.thread_id.to_string()
end

def replay_resolve_event(trace: EventTrace, arg: String) -> Option[ReplayEventId]
  var text = arg.clone()
  if arg.starts_with("seq:") then
    text = arg.slice(4, arg.len())
  end
  match text.parse_int()
  when Result::Err(_) then Option::None
  when Result::Ok(seq) then
    for e in trace.events do
      if e.id.sequence == seq then
        return Option::Some(e.id.clone())
      end
    end
    Option::None
  end
end

def replay_id_rows(ids: Vec[ReplayEventId]) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  for id in ids do
    rows.push(replay_id_render(&id))
  end
  rows
end

pub def replay_query(
  operation: String,
  arg: String,
  old_trace: Option[EventTrace] = Option::None,
  new_trace: Option[EventTrace] = Option::None
) -> QueryResults
  match old_trace
  when Option::None then QueryResults { kind: operation.clone() + "_unavailable", keys: Vec::new() }
  when Option::Some(old) then
    if operation == "replay.trace_rows" then
      QueryResults { kind: operation, keys: replay_trace_rows(old) }
    elsif operation == "replay.digest" then
      let d = replay_trace_digest(old)
      QueryResults { kind: operation, keys: Vec::from([semantic_digest_render(&d)]) }
    elsif operation == "replay.writes_to" then
      QueryResults { kind: operation, keys: replay_id_rows(writes_to(old, arg.clone())) }
    elsif operation == "replay.causal_predecessors" then
      match replay_resolve_event(old.clone(), arg.clone())
      when Option::Some(id) then
        QueryResults { kind: operation, keys: replay_id_rows(causal_predecessors(old, id)) }
      when Option::None then
        QueryResults { kind: operation + "_error", keys: Vec::new() }
      end
    elsif operation == "replay.value_at" then
      match mir_graph_split(&arg)
      when Option::None then QueryResults { kind: operation + "_error", keys: Vec::new() }
      when Option::Some(parts) then
        match replay_resolve_event(old.clone(), parts.0.clone())
        when Option::Some(id) then
          match value_at(old, id, parts.1.clone())
          when Option::Some(v) then QueryResults { kind: operation, keys: Vec::from(["value:" + v]) }
          when Option::None then QueryResults { kind: operation, keys: Vec::from(["value:uninitialized"]) }
          end
        when Option::None then QueryResults { kind: operation + "_error", keys: Vec::new() }
        end
      end
    elsif operation == "replay.first_divergence" || operation == "replay.minimal_causal_slice" then
      match new_trace
      when Option::None then QueryResults { kind: operation.clone() + "_unavailable", keys: Vec::new() }
      when Option::Some(new) then
        if operation == "replay.first_divergence" then
          match first_divergence(old, new)
          when Option::Some(id) then
            QueryResults { kind: operation, keys: Vec::from([replay_id_render(&id)]) }
          when Option::None then
            QueryResults { kind: operation, keys: Vec::from(["no-divergence"]) }
          end
        else
          QueryResults { kind: operation, keys: replay_id_rows(minimal_causal_slice(old, new)) }
        end
      end
    else
      QueryResults { kind: operation + "_error", keys: Vec::new() }
    end
  end
end


# The "hole.constraints" op (audit item 54)
# ———————————————————————————————————————————————————————————————
# The typed-hole constraint rows of a canonical hole key
# "<fn stable key>#hole<node id>". The §38 session (snapshot + index) has NO
# typed nodes, so query() cannot route this op — it is served HERE, by the
# module-scope adapter, when the caller holds the TypedProgram (the §39
# CompilerSession's typed slot; the same program-requirement pattern as
# mir_slice). keys = types.tg hole_constraint_rows (canonical
# "expected:..." / "in-scope:..." / ... texts, sorted); an unparsable key
# or an unknown hole answers the op kind with empty keys (fail-closed —
# never a fabricated row).
pub def hole_constraints(program: TypedProgram, key: String) -> QueryResults
  match semantic_hole_key_parts(key.clone())
  when Option::Some(parts) then
    match typed_hole_constraints_of(program, parts.1)
    when Option::Some(hc) then
      QueryResults { kind: "hole.constraints", keys: hole_constraint_rows(hc) }
    when Option::None then
      QueryResults { kind: "hole.constraints", keys: Vec::new() }
    end
  when Option::None then
    QueryResults { kind: "hole.constraints", keys: Vec::new() }
  end
end

# ———————————————————————————————————————————————————————————————
# ———————————————————————————————————————————————————————————————
# edit.apply (third-audit item 30) — the §38/§39 source-edit adapter
# ———————————————————————————————————————————————————————————————
# ONE source-in / edited-source-out operation over the semantic edit
# engine: the payload's line 0 is the edit kind, the next lines are the
# kind's fields (one per line — keys may contain '|', so '|' is not a
# separator; a statement/signature field must be single-line), and the
# remaining lines are the SOURCE text verbatim. The edit is resolved
# against the session's snapshot/index (resolve_edit — the StableSemanticId
# resolution step) and applied through apply_edit_to_source_checked
# (AST transformation -> formatter render -> re-parse/resolve/type/access/
# ownership re-validation). Answer kinds:
#   "edit.applied"     keys = [edited source]        (validated application)
#   "edit.rejected"    keys = [validation evidence]  (PreconditionFailed)
#   "edit.error"       keys = [typed error word]     (TargetNotFound / ...)
#   "edit.unsupported" keys = [kind word]            (grammar / no surface)
# change-contract routes to the snapshot apply (apply_edit — unchanged
# surface); fill-hole has no source surface (apply_fill_hole needs the
# typed program) and answers "edit.unsupported".
def edit_apply_line(lines: Vec[String], index: Int) -> String
  if index < lines.len() then
    lines[index].clone()
  else
    "".to_string()
  end
end

pub def edit_apply_query(session: SemanticQuerySession, payload: String) -> QueryResults
  let lines = payload.lines()
  if lines.len() == 0 then
    return QueryResults { kind: "edit.unsupported", keys: Vec::from(["empty-payload".to_string()]) }
  end
  let kind_word = lines[0].clone()
  var header_lines = 0
  var has_edit = false
  var edit = SemanticEdit::Rename("".to_string(), "".to_string())
  match kind_word
  when "rename" then
    header_lines = 3
    if lines.len() >= 3 then
      edit = SemanticEdit::Rename(lines[1].clone(), lines[2].clone())
      has_edit = true
    end
  when "change-signature" then
    header_lines = 3
    if lines.len() >= 3 then
      edit = SemanticEdit::ChangeSignature(lines[1].clone(), lines[2].clone())
      has_edit = true
    end
  when "replace-call" then
    header_lines = 3
    if lines.len() >= 3 then
      edit = SemanticEdit::ReplaceCall(lines[1].clone(), lines[2].clone())
      has_edit = true
    end
  when "change-contract" then
    header_lines = 3
    if lines.len() >= 3 then
      edit = SemanticEdit::ChangeContract(lines[1].clone(), lines[2].clone())
      has_edit = true
    end
  when "insert-statement" then
    header_lines = 4
    if lines.len() >= 4 then
      edit = SemanticEdit::InsertStatement(lines[1].clone(), lines[2].clone(), lines[3].clone())
      has_edit = true
    end
  when "fill-hole" then
    header_lines = 3
    if lines.len() >= 3 then
      edit = SemanticEdit::FillHole(lines[1].clone(), lines[2].clone())
      has_edit = true
    end
  when _ then ()
  end
  if !has_edit then
    return QueryResults { kind: "edit.unsupported", keys: Vec::from([kind_word.clone()]) }
  end
  if kind_word == "fill-hole" then
    return QueryResults { kind: "edit.unsupported", keys: Vec::from(["fill-hole: typed-program surface".to_string()]) }
  end
  let resolved = match resolve_edit(&session.index, &session.snapshot, edit.clone())
  when Result::Ok(r) then r
  when Result::Err(e) then
    return QueryResults { kind: "edit.error", keys: Vec::from([edit_error_word(e)]) }
  end
  if kind_word == "change-contract" then
    match apply_edit(&session.snapshot, resolved)
    when Result::Ok(app) then
      return QueryResults { kind: "edit.applied", keys: app.applied.clone() }
    when Result::Err(e) then
      return QueryResults { kind: "edit.error", keys: Vec::from([edit_error_word(e)]) }
    end
  end
  var source_parts: Vec[String] = Vec::new()
  var i = header_lines
  while i < lines.len() do
    source_parts.push(lines[i].clone())
    i = i + 1
  end
  let outcome = apply_edit_to_source_checked(source_parts.join("\n"), resolved)
  match outcome.result
  when Result::Ok(app) then
    QueryResults { kind: "edit.applied", keys: Vec::from([app.edited_source.clone()]) }
  when Result::Err(e) then
    if edit_error_word(e) == "PreconditionFailed" then
      QueryResults { kind: "edit.rejected", keys: Vec::from([outcome.evidence.clone()]) }
    else
      QueryResults { kind: "edit.error", keys: Vec::from([edit_error_word(e)]) }
    end
  end
end

# The dispatch — one session-scoped query() per operation name
# ———————————————————————————————————————————————————————————————
# Routes the session-scoped ops by name; every routed op answers with the
# payload its accessor built (the dispatcher never re-derives rows — the
# accessors are the payload authority). The EXPLAIN arms (audit item 52)
# are the ONE documented exception: they answer through explain_results —
# kind = the explain op's typed kind word and keys = the tree lines in
# DISPLAY ORDER (never sorted, never stable-key texts — the keys carrier
# of an explain arm is the human debug render of the derivation tree, and
# payload stays None; see the module doc's explain paragraph). Names
# outside the set — the delta-scoped ops included (change_* / abi_inspect
# need a delta the session does not hold) — return kind "unknown" with an
# empty payload.
pub def query(session: SemanticQuerySession, operation: String, arg: String) -> QueryResults
  match operation
  when "callers" then query_callers(&session.index, arg.clone())
  when "callees" then query_callees(&session.index, arg.clone())
  when "types" then query_types(&session.index, arg.clone())
  when "effects" then query_effects(&session.index, arg.clone())
  when "capabilities" then query_capabilities(&session.index, arg.clone())
  # (third-audit item 25) the compiler-verified purity projection op
  # (ordered evidence rows — the documented key-order exception).
  when "purity.get" then query_purity(&session.snapshot, arg.clone())
  when "contracts" then query_contracts(&session.index, arg.clone())
  when "fields" then query_fields(&session.index, arg.clone())
  when "impls" then query_impls(&session.index, arg.clone())
  when "properties" then query_properties(&session.index, arg.clone())
  when "mir_function" then mir_function(&session.snapshot, arg.clone())
  when "symbol_get" then query_symbol_get(&session.index, arg.clone())
  when "symbol_search" then query_symbol_search(&session.index, arg.clone())
  when "contract_list" then contract_list(&session.snapshot, arg.clone())
  when "type_explain" then type_explain(&session.index, arg.clone())
  when "ownership_explain" then ownership_explain(&session.snapshot, arg.clone())
  when "mir_slice" then mir_slice(arg.clone())
  # (third-audit item 20/22) the MIR-graph reasoning ops — no program rides
  # the §38 session, so these arms answer "<op>_unavailable" (the §39
  # semantic_server dispatch passes the session's final_mir).
  when "mir.dominators" then mir_graph_query("mir.dominators".to_string(), arg.clone())
  when "mir.postdominators" then mir_graph_query("mir.postdominators".to_string(), arg.clone())
  when "mir.loops" then mir_graph_query("mir.loops".to_string(), arg.clone())
  when "mir.control" then mir_graph_query("mir.control".to_string(), arg.clone())
  when "mir.path" then mir_graph_query("mir.path".to_string(), arg.clone())
  when "mir.reaching" then mir_graph_query("mir.reaching".to_string(), arg.clone())
  when "mir.block" then mir_graph_query("mir.block".to_string(), arg.clone())
  when "mir.diff" then mir_graph_query("mir.diff".to_string(), arg.clone())
  # (audit item 52) the explain arms — the tree answers; see the dispatch
  # doc above for the keys render-carrier exception. trait.resolve is the
  # ONE item-20 exception: the query op answers TYPED impl keys from the
  # index's TraitImplEdge rows (the explain() API keeps the tree).
  when "type.explain" then explain_results(&session, "type.explain".to_string(), arg.clone())
  when "trait.resolve" then trait_resolve(&session.index, arg.clone())
  # (third-audit item 23) the typed TraitFailureData explain alias.
  when "trait.explain" then explain_results(&session, "trait.explain".to_string(), arg.clone())
  when "ownership.explain" then explain_results(&session, "ownership.explain".to_string(), arg.clone())
  when "effect.explain" then explain_results(&session, "effect.explain".to_string(), arg.clone())
  when "capability.explain" then explain_results(&session, "capability.explain".to_string(), arg.clone())
  when "layout.explain" then explain_results(&session, "layout.explain".to_string(), arg.clone())
  when "optimization.explain" then explain_results(&session, "optimization.explain".to_string(), arg.clone())
  when "diagnostic.explain" then diagnostic_explain_store(&session.diagnostics_store, arg.clone())
  # (third-audit item 23) the expanded operation families — each projects
  # an existing table / the retained store / the §37 evidence.
  when "type.get" then type_get(&session.index, arg.clone())
  when "type.layout" then type_layout(&session.index, arg.clone())
  when "type.properties" then type_properties(&session.index, arg.clone())
  # (third-audit item 20) the typed use-of-type inverse.
  when "type.use" then type_use(&session.index, arg.clone())
  when "ownership.moves" then ownership_moves(&session.snapshot, arg.clone())
  when "ownership.drop_plan" then ownership_drop_plan(&session.snapshot, arg.clone())
  when "contract.obligations" then contract_obligations_results(&session.index, &session.snapshot, arg.clone())
  when "contract.verify" then contract_verify(&session.snapshot, arg.clone())
  when "symbol.references" then symbol_references(&session.index, arg.clone())
  # (third-audit item 34) the §40 coverage ops — real answers when the
  # snapshot carries ingested coverage rows, "<op>_unavailable" otherwise.
  when "test.affected" then test_affected(session.snapshot.clone(), arg.clone())
  when "coverage.affected" then coverage_affected(session.snapshot.clone(), arg.clone())
  when "snapshot.get" then snapshot_get(&session.snapshot)
  when "snapshot.diff" then QueryResults { kind: "snapshot.diff_unavailable", keys: Vec::new() }
  # (third-audit item 30) the source-edit application op — see
  # edit_apply_query for the payload grammar and answer kinds.
  when "edit.apply" then edit_apply_query(&session, arg.clone())
  when "build.plan" then build_plan(session.evidence.clone())
  when "verify.plan" then verify_plan(session.evidence.clone())
  when "diagnostic.get" then diagnostic_get(&session.diagnostics_store, arg.clone())
  when "diagnostic.repair_context" then diagnostic_repair_context_store(&session.diagnostics_store, arg.clone())
  # (third-audit item 23) the §42 replay ops — no trace rides a §38
  # session; the module-scope replay_query serves callers that hold one.
  when "replay.trace_rows" then replay_query("replay.trace_rows".to_string(), arg.clone())
  when "replay.digest" then replay_query("replay.digest".to_string(), arg.clone())
  when "replay.writes_to" then replay_query("replay.writes_to".to_string(), arg.clone())
  when "replay.value_at" then replay_query("replay.value_at".to_string(), arg.clone())
  when "replay.causal_predecessors" then replay_query("replay.causal_predecessors".to_string(), arg.clone())
  when "replay.first_divergence" then replay_query("replay.first_divergence".to_string(), arg.clone())
  when "replay.minimal_causal_slice" then replay_query("replay.minimal_causal_slice".to_string(), arg.clone())
  when _ then QueryResults { kind: "unknown", keys: Vec::new() }
  end
end

# ———————————————————————————————————————————————————————————————
# The explain/typed lane (third-audit item 23 executable rows)
# ———————————————————————————————————————————————————————————————
# E1: ExplainNode build + render byte-identity for one existing case
# (capability.explain over an empty session) + the ExplainResult wrapper;
# E2: the pure diagnostic tree's typed find. Empty result = the lane
# verifies.

def explain_lane_bool(inout out: Vec[String], name: String, ok: Bool) -> Unit
  if !ok then
    out.push(name + ": expected true")
  end
  ()
end

def explain_lane_int(inout out: Vec[String], name: String, got: Int, expected: Int) -> Unit
  if got != expected then
    out.push(name + ": expected " + expected.to_string() + ", got " + got.to_string())
  end
  ()
end

def explain_lane_rows(inout out: Vec[String], name: String, got: Vec[String], expected: Vec[String]) -> Unit
  if got.len() != expected.len() then
    out.push(name + ": expected " + expected.len().to_string() + " rows, got " + got.len().to_string())
    return ()
  end
  var i = 0
  while i < got.len() do
    if got[i] != expected[i] then
      out.push(name + "[" + i.to_string() + "]: expected '" + expected[i].clone() + "', got '" + got[i].clone() + "'")
    end
    i = i + 1
  end
  ()
end

def explain_lane_snapshot() -> SemanticSnapshot
  SemanticSnapshot {
    revision: semantic_digest_zero(),
    compiler_version: "lane".to_string(),
    target: semantic_lane_target(),
    public_api_hash: semantic_digest_zero(),
    abi_hash: semantic_digest_zero(),
    unsafe_hash: semantic_digest_zero()
  }
end

def semantic_lane_target() -> StableTargetId
  StableTargetId {
    triple: "lane-none".to_string(),
    arch: "lane".to_string(),
    cpu: "lane".to_string(),
    pointer_width: 64,
    endian: "little".to_string(),
    abi: "sysv".to_string(),
    float_abi: "hard".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def explain_lane_session() -> SemanticQuerySession
  let snapshot = explain_lane_snapshot()
  new_semantic_query_session(snapshot.clone(), build_semantic_index(&snapshot))
end

# The edit.apply lane's session: the empty explain fixture plus the ONE
# symbol row the rename resolves against ("m::f#fn()->unit" — the same key
# the explain lane reads).
def edit_apply_lane_session() -> SemanticQuerySession
  var snapshot = explain_lane_snapshot()
  let key = "m::f#fn()->unit".to_string()
  snapshot.symbols = Vec::from([SemanticSymbol {
    stable_id: stable_def_id_digested(key.clone(), "m::f".to_string()),
    kind: DefKind::Function,
    name: "f".to_string(),
    module_path: "m".to_string(),
    is_pub: false,
    is_generic: false
  }])
  new_semantic_query_session(snapshot.clone(), build_semantic_index(&snapshot))
end

def explain_lane_diagnostic() -> Diagnostic
  Diagnostic {
    level: DiagLevel::Error,
    message: "use of moved value".to_string(),
    span: Option::None,
    notes: Vec::new(),
    suggestions: Vec::new(),
    code: Option::Some("E0201".to_string()),
    primary_symbol: Option::Some("m::f#fn()->unit".to_string()),
    semantic_site: Option::Some("ownership analysis".to_string()),
    semantic_data: Option::Some(DiagnosticSemanticData::Ownership(OwnershipDiagnosticData {
      place: "r".to_string(),
      state_before: "consumed".to_string(),
      operation: "use".to_string(),
      consume_site: "lane.tg:5".to_string(),
      use_site: "lane.tg:10".to_string(),
      type_id: "R".to_string()
    }))
  }
end

pub def explain_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— E1: byte-identical capability tree + the wrapper ————
  let key = "m::f#fn()->unit".to_string()
  let node = explain_tree(explain_lane_session(), "capability.explain".to_string(), key.clone())
  explain_lane_rows(&mut out, "e1-render-identity", explain_node_render(node.clone()),
    Vec::from([key.clone(), "  no capability rows".to_string()]))
  let rendered = explain(explain_lane_session(), "capability.explain".to_string(), key.clone())
  explain_lane_rows(&mut out, "e1-wrapper-identity", rendered.tree.clone(),
    Vec::from([key.clone(), "  no capability rows".to_string()]))
  explain_lane_bool(&mut out, "e1-wrapper-kind", rendered.kind == "capability.explain")
  match explain_node_find(node.clone(), "capability.explain".to_string())
  when Option::Some(found) then
    explain_lane_bool(&mut out, "e1-find-root", found.subject == key)
  when Option::None then
    out.push("e1-find-root: expected Some, got None")
  end
  match explain_node_find(node.clone(), "missing".to_string())
  when Option::Some(_) then out.push("e1-find-missing: expected None, got Some")
  when Option::None then ()
  end
  explain_lane_int(&mut out, "e1-find-all-empty",
    explain_node_find_all(node.clone(), "capability-empty".to_string()).len(), 1)

  # ———— E2: a typed diagnostic tree's machine find ————
  let tree = diagnostic_explain_node(&explain_lane_diagnostic())
  match explain_node_find(tree.clone(), "ownership-rejection".to_string())
  when Option::Some(found) then
    explain_lane_bool(&mut out, "e2-find-subject", found.subject == "ownership rejection")
  when Option::None then
    out.push("e2-find: expected Some, got None")
  end
  explain_lane_int(&mut out, "e2-find-all-place",
    explain_node_find_all(tree.clone(), "ownership-place".to_string()).len(), 1)

  # ———— E3: edit.apply — the source rewrite engine over the §38 wire ————
  # The rename resolves against the lane snapshot (m::f#fn()->unit) and
  # applies to the source through the AST rewrite + formatter render + the
  # front-end re-validation; the answer carries the edited source in keys.
  let edit_src = "def f() -> Int\n  1\nend\n\ndef g() -> Int\n  f()\nend\n"
  let rename_payload = "rename\nm::f#fn()->unit\nrenamed\n" + edit_src
  let rename_result = edit_apply_query(edit_apply_lane_session(), rename_payload)
  explain_lane_bool(&mut out, "e3-rename-kind", rename_result.kind == "edit.applied")
  if rename_result.keys.len() == 1 then
    explain_lane_bool(&mut out, "e3-rename-decl",
      rename_result.keys[0].contains("def renamed()"))
    explain_lane_bool(&mut out, "e3-rename-reference",
      rename_result.keys[0].contains("renamed()"))
  else
    out.push("e3-rename-keys: expected 1 key, got " + rename_result.keys.len().to_string())
  end
  # an unparsable statement fragment fails closed with the evidence
  let bad_payload = "insert-statement\nm::f#fn()->unit\nm::f#fn()->unit#B0#S0\nlet =\n" + edit_src
  let bad_result = edit_apply_query(edit_apply_lane_session(), bad_payload)
  explain_lane_bool(&mut out, "e3-rejected-kind", bad_result.kind == "edit.rejected")
  explain_lane_bool(&mut out, "e3-rejected-evidence", bad_result.keys.len() == 1)
  # a payload outside the grammar answers unsupported
  let unsupported = edit_apply_query(edit_apply_lane_session(), "nope".to_string())
  explain_lane_bool(&mut out, "e3-unsupported-kind", unsupported.kind == "edit.unsupported")

  out
end

# ———————————————————————————————————————————————————————————————
# The coverage op lane (third-audit item 34): the §38 test.affected /
# coverage.affected answers over an ingested snapshot, plus the
# unavailable gates on a coverage-free session. Empty = the lane verifies.
# ———————————————————————————————————————————————————————————————

def coverage_query_lane_same(a: Vec[String], b: Vec[String]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end

def coverage_query_lane_rows(inout out: Vec[String], name: String, got: Vec[String], expected: Vec[String]) -> Unit
  if !coverage_query_lane_same(got, expected) then
    out.push(name + ": expected [" + expected.join(",") + "], got [" + got.join(",") + "]")
  end
  ()
end

pub def coverage_query_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— Q1: a coverage-free session answers unavailable ————
  let empty_session = explain_lane_session()
  let t0 = query(&empty_session, "test.affected".to_string(), "m::f#fn()->unit".to_string())
  if t0.kind != "test.affected_unavailable" then
    out.push("q1-test-unavailable-kind: expected test.affected_unavailable, got " + t0.kind.clone())
  end
  if t0.keys.len() != 0 then
    out.push("q1-test-unavailable-keys: expected [], got [" + t0.keys.join(",") + "]")
  end
  let c0 = query(&empty_session, "coverage.affected".to_string(), "m::f#fn()->unit".to_string())
  if c0.kind != "coverage.affected_unavailable" then
    out.push("q2-coverage-unavailable-kind: expected coverage.affected_unavailable, got " + c0.kind.clone())
  end

  # ———— Q2: an ingested session answers the real rows ————
  let trace = "test|m::test_a#fn()->unit\n" +
    "block|m::f#fn()->unit#B0\n" +
    "edge|m::f#fn()->unit#B0|m::f#fn()->unit#B1\n" +
    "test|m::test_b#fn()->unit\n" +
    "block|m::f#fn()->unit#B1\n"
  let snapshot = coverage_ingest(explain_lane_snapshot(), trace)
  let session = new_semantic_query_session(snapshot.clone(), build_semantic_index(&snapshot))
  let t1 = query(&session, "test.affected".to_string(), "m::f#fn()->unit".to_string())
  if t1.kind != "test.affected" then
    out.push("q3-test-kind: expected test.affected, got " + t1.kind.clone())
  end
  coverage_query_lane_rows(&mut out, "q4-test-rows", t1.keys.clone(),
    Vec::from([
      "m::test_a#fn()->unit".to_string(),
      "m::test_b#fn()->unit".to_string()
    ]))
  let c1 = query(&session, "coverage.affected".to_string(), "m::f#fn()->unit".to_string())
  if c1.kind != "coverage.affected" then
    out.push("q5-coverage-kind: expected coverage.affected, got " + c1.kind.clone())
  end
  coverage_query_lane_rows(&mut out, "q6-coverage-rows", c1.keys.clone(),
    Vec::from([
      "m::f#fn()->unit#B0".to_string(),
      "m::f#fn()->unit#B0|>m::f#fn()->unit#B1|cf".to_string(),
      "m::f#fn()->unit#B1".to_string()
    ]))
  # ———— Q3: a coverage-free symbol on a covered session answers empty ————
  let t2 = query(&session, "test.affected".to_string(), "m::nobody#fn()->unit".to_string())
  if t2.kind != "test.affected" then
    out.push("q7-empty-kind: expected test.affected, got " + t2.kind.clone())
  end
  if t2.keys.len() != 0 then
    out.push("q8-empty-keys: expected [], got [" + t2.keys.join(",") + "]")
  end

  out
end

# ———————————————————————————————————————————————————————————————
# The item-20 query lane (third-audit items 20/23 executable rows)
# ———————————————————————————————————————————————————————————————
# ONE hand-built snapshot drives the new op answers: symbol_get over a
# symbol with NO other row, symbol_search over the symbol table, type.use
# (the typed TypeUseEdge inverse), type.layout (the ABI type row),
# trait.resolve (typed impl keys), contract.obligations (+ its contract
# refs) and type.get / type.properties. Empty = the lane verifies.

def index_query_lane_snapshot() -> SemanticSnapshot
  var s = explain_lane_snapshot()
  s.symbols = Vec::from([
    SemanticSymbol {
      stable_id: stable_def_id_digested("m::lonely#fn()->unit".to_string(), "m::lonely".to_string()),
      kind: DefKind::Function,
      name: "lonely".to_string(),
      module_path: "m".to_string(),
      is_pub: false,
      is_generic: false
    }
  ])
  s.types = Vec::from([
    SemanticType {
      stable_id: stable_def_id_digested("m::T#struct{a:Int}".to_string(), "m::T".to_string()),
      kind: SemanticTypeKind::Struct,
      name: "T".to_string(),
      module_path: "m".to_string(),
      generic_arity: 0,
      is_pub: true
    },
    SemanticType {
      stable_id: stable_def_id_digested("m::Tr#trait{m()}".to_string(), "m::Tr".to_string()),
      kind: SemanticTypeKind::Trait,
      name: "Tr".to_string(),
      module_path: "m".to_string(),
      generic_arity: 0,
      is_pub: true
    }
  ])
  s.abi_surfaces = Vec::from([
    AbiSurfaceRow {
      surface_id: "type:m::T#struct{a:Int}".to_string(),
      symbol_key: "m::T#struct{a:Int}".to_string(),
      kind: "type".to_string(),
      size: 8,
      alignment: 4,
      fields: Vec::from(["a 0 4"])
    }
  ])
  s.dependencies = SemanticDependencyGraph {
    type_uses: Vec::from([
      TypeUseEdge {
        user: "m::u#fn(m::T)->unit".to_string(),
        used_type: "m::T#struct{a:Int}".to_string()
      }
    ]),
    trait_impls: Vec::from([
      TraitImplEdge {
        impl_key: "impl::m::S#struct{}|as|m::Tr#trait{m()}".to_string(),
        trait_key: "m::Tr#trait{m()}".to_string(),
        self_type: "m::S#struct{}".to_string()
      }
    ]),
    trait_selections: Vec::from([
      TraitSelectionEdge {
        function: "m::S::m#fn()->unit".to_string(),
        trait_key: "m::Tr#trait{m()}".to_string(),
        impl_key: "impl::m::S#struct{}|as|m::Tr#trait{m()}".to_string()
      }
    ]),
    contract_references: Vec::from([
      ContractReferenceEdge {
        contract_id: "m::f#fn()->unit|Pre|gt(x,0)".to_string(),
        referenced_symbol: "m::g#fn()->unit".to_string()
      }
    ])
  }
  let clause_text = "gt(x,0)".to_string()
  s.contracts = Vec::from([
    ContractFact {
      id: StableContractId { stable_key: "m::f#fn()->unit|Pre|gt(x,0)".to_string() },
      function: stable_def_id_digested("m::f#fn()->unit".to_string(), "m::f".to_string()),
      kind: AstContractKind::AstPre,
      expression_fingerprint: stable_digest_of(&clause_text),
      canonical_expression: ContractExprIR {
        op: "gt".to_string(),
        args: Vec::from(["x".to_string(), "0".to_string()])
      },
      message: Option::None
    }
  ])
  s
end

pub def index_query_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  let snapshot = index_query_lane_snapshot()
  let session = new_semantic_query_session(snapshot.clone(), build_semantic_index(&snapshot))

  # Q1 — symbol_get on a symbol with NO other row succeeds; search finds it.
  let lonely = "m::lonely#fn()->unit".to_string()
  let got = query(&session, "symbol_get".to_string(), lonely.clone())
  explain_lane_bool(&mut out, "q1-symbol-get-kind", got.kind == "symbol_get")
  explain_lane_rows(&mut out, "q1-symbol-get-keys", got.keys.clone(), Vec::from([lonely.clone()]))
  let found = query(&session, "symbol_search".to_string(), "lonely".to_string())
  explain_lane_rows(&mut out, "q2-symbol-search", found.keys.clone(), Vec::from([lonely.clone()]))

  # Q2 — type.use answers the typed TypeUseEdge users.
  let used = query(&session, "type.use".to_string(), "m::T#struct{a:Int}".to_string())
  explain_lane_bool(&mut out, "q3-type-use-kind", used.kind == "type.use")
  explain_lane_rows(&mut out, "q3-type-use-keys", used.keys.clone(),
    Vec::from(["m::u#fn(m::T)->unit".to_string()]))

  # Q3 — type.layout answers the ABI type row / fails closed without one.
  let layout = query(&session, "type.layout".to_string(), "m::T#struct{a:Int}".to_string())
  explain_lane_bool(&mut out, "q4-type-layout-kind", layout.kind == "type.layout")
  explain_lane_rows(&mut out, "q4-type-layout-keys", layout.keys.clone(),
    Vec::from(["size=8;align=4;fields=a 0 4".to_string()]))
  let no_layout = query(&session, "type.layout".to_string(), "m::Nope#struct{}".to_string())
  explain_lane_bool(&mut out, "q5-type-layout-unavailable", no_layout.kind == "type.layout_unavailable")

  # Q4 — trait.resolve answers the typed impl key.
  let impl_key = "impl::m::S#struct{}|as|m::Tr#trait{m()}".to_string()
  let resolved = query(&session, "trait.resolve".to_string(), "m::Tr#trait{m()}".to_string())
  explain_lane_bool(&mut out, "q6-trait-resolve-kind", resolved.kind == "trait.resolve")
  explain_lane_rows(&mut out, "q6-trait-resolve-keys", resolved.keys.clone(), Vec::from([impl_key.clone()]))

  # Q5 — contract.obligations answers the clause + its typed contract refs.
  let obligations = query(&session, "contract.obligations".to_string(), "m::f#fn()->unit".to_string())
  explain_lane_bool(&mut out, "q7-contract-kind", obligations.kind == "contract.obligations")
  explain_lane_rows(&mut out, "q7-contract-keys", obligations.keys.clone(),
    Vec::from([
      "contract-ref:m::g#fn()->unit".to_string(),
      "m::f#fn()->unit|Pre|gt(x,0)".to_string()
    ]))

  # Q6 — type.get / type.properties over the type table.
  let tget = query(&session, "type.get".to_string(), "m::T#struct{a:Int}".to_string())
  explain_lane_bool(&mut out, "q8-type-get-kind", tget.kind == "type.get")
  explain_lane_rows(&mut out, "q8-type-get-keys", tget.keys.clone(), Vec::from(["Struct".to_string()]))
  let tprops = query(&session, "type.properties".to_string(), "m::Tr#trait{m()}".to_string())
  explain_lane_bool(&mut out, "q9-type-properties-kind", tprops.kind == "type.properties")
  explain_lane_rows(&mut out, "q9-type-properties-keys", tprops.keys.clone(), Vec::from(["m".to_string()]))
  out
end
