# Tangerine Compiler — Semantic Query facade (audit §38)
# Self-hosting compiler written in Tangerine
#
# The TYPED query facade over the semantic machinery: ONE QueryResults
# record (kind word + sorted stable key texts — never prose, never spans,
# never digest words) is the whole result protocol. Every op DELEGATES to
# an existing accessor / row table — no new analyses: this module is the
# dispatch surface the §32 index / §29 snapshot / §31 delta rows serve.
#
# QUERY KINDS (dispatch vocabulary): callers/callees/types/effects/
# capabilities/contracts/fields/impls/properties (the §32 index accessors
# of the arg key); mir_function (the arg key's coarse MirSemanticSummary
# render — the §32 index payload text; absent rows fall back to the raw
# key text); symbol_get / symbol_search (presence probe + sorted
# contains-match over the index's def-key universe); contract_list (the
# arg key's RECORDED contract rows as §31 row-key texts "<fn key>|Pre|
# clause" — recorded only, no "verified" marker invented; contract_has_rows
# is the Bool gate); type_explain (fields + impls + properties, deduped);
# ownership (row-key texts whose subject prefix matches the arg — scan-
# based: not a §32 index family); mir_slice_unavailable (mir_slice's
# always-empty result — real slices need a MirProgram, the §33 domain);
# semantic_diff / abi_inspect (change helpers over a §31 SemanticDelta —
# delta-scoped, so query() returns kind "unknown" for those names);
# unknown (anything outside the dispatch set).
#
# Session: SemanticQuerySession { snapshot + index }; query() routes the
# session-scoped ops by name; the delta-scoped defs stay callable
# directly. No env gates. Every keys list is sorted.

use std::collections::{Vec, Map}

use tg_compiler::ast::{AstContractKind, AccessConvention}
use tg_compiler::mir::{MirProgram}
use tg_compiler::semantic_model::{SemanticSnapshot, MirSemanticSummary}
use tg_compiler::semantic_index::{
  SemanticIndex, index_callers_of, index_callees_of, index_types_of, index_effects_of,
  index_capabilities_of, index_contracts_of, index_fields_of, index_impls_of,
  index_properties_of, index_mir_payload
}
use tg_compiler::semantic_delta::{SemanticDelta}

# ———————————————————————————————————————————————————————————————
# The §38 records — QueryResults + SemanticQuerySession
# ———————————————————————————————————————————————————————————————
# QueryResults.keys holds the query's stable key texts / canonical row
# texts (sorted, no prose); kind is the vocabulary word above — the ONLY
# discriminator a caller needs. The session pairs a snapshot with the
# index built from it; neither side is ever mutated.
struct QueryResults
  kind: String
  keys: Vec[String] = Vec::new()
end

struct SemanticQuerySession
  snapshot: SemanticSnapshot
  index: SemanticIndex
end

pub def new_semantic_query_session(snapshot: SemanticSnapshot, index: SemanticIndex) -> SemanticQuerySession
  SemanticQuerySession {
    snapshot: snapshot,
    index: index
  }
end

# ———————————————————————————————————————————————————————————————
# The typed accessors — O(1) delegates to the §32 index accessors
# ———————————————————————————————————————————————————————————————
# Each returns kind = its operation name; keys = the accessor's rows for
# the arg key (callers/callees: stable keys; types/effects: 0-1 rows).

def query_callers(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "callers", keys: index_callers_of(&index, key.clone()) }
end

def query_callees(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "callees", keys: index_callees_of(&index, key.clone()) }
end

def query_types(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "types", keys: index_types_of(&index, key.clone()) }
end

def query_effects(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "effects", keys: index_effects_of(&index, key.clone()) }
end

def query_capabilities(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "capabilities", keys: index_capabilities_of(&index, key.clone()) }
end

# contracts rows are the index row form; the §31 row-key form rides contract_list.
def query_contracts(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "contracts", keys: index_contracts_of(&index, key.clone()) }
end

def query_fields(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "fields", keys: index_fields_of(&index, key.clone()) }
end

def query_impls(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "impls", keys: index_impls_of(&index, key.clone()) }
end

def query_properties(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "properties", keys: index_properties_of(&index, key.clone()) }
end

# ———————————————————————————————————————————————————————————————
# Symbol ops — presence + contains-search over the index's def-key
# universe (all maps key on stable def key TEXTS; defs without any
# indexed row are absent by design).
# ———————————————————————————————————————————————————————————————

def query_collect_vec_keys(m: Map[String, Vec[String]], inout keys: Vec[String]) -> Unit
  for entry in m.entries() do
    keys.push(entry.0.clone())
  end
  ()
end

def query_collect_single_keys(m: Map[String, String], inout keys: Vec[String]) -> Unit
  for entry in m.entries() do
    keys.push(entry.0.clone())
  end
  ()
end

def query_collect_mir_keys(m: Map[String, MirSemanticSummary], inout keys: Vec[String]) -> Unit
  for entry in m.entries() do
    keys.push(entry.0.clone())
  end
  ()
end

# The sorted, deduped union of every index map key (Vec-contains dedupe).
def query_index_keys(index: SemanticIndex) -> Vec[String]
  var keys: Vec[String] = Vec::new()
  query_collect_vec_keys(&index.callers, &mut keys)
  query_collect_vec_keys(&index.callees, &mut keys)
  query_collect_single_keys(&index.symbol_types, &mut keys)
  query_collect_single_keys(&index.effects, &mut keys)
  query_collect_vec_keys(&index.capabilities, &mut keys)
  query_collect_vec_keys(&index.contracts, &mut keys)
  query_collect_vec_keys(&index.type_fields, &mut keys)
  query_collect_vec_keys(&index.type_impls, &mut keys)
  query_collect_vec_keys(&index.type_properties, &mut keys)
  query_collect_vec_keys(&index.type_layouts, &mut keys)
  query_collect_vec_keys(&index.test_targets, &mut keys)
  query_collect_vec_keys(&index.test_symbols, &mut keys)
  query_collect_mir_keys(&index.mir_summaries, &mut keys)
  keys.sort_by(|a, b| a < b)
  var out: Vec[String] = Vec::new()
  for key in keys do
    if !out.contains(&key) then
      out.push(key.clone())
    end
  end
  out
end

# Presence probe: Some(key) when any index map holds rows keyed by the
# canonical key text (None = unknown to the index).
def symbol_get(index: SemanticIndex, key: String) -> Option[String]
  if index.callers.contains_key(&key) ||
    index.callees.contains_key(&key) ||
    index.symbol_types.contains_key(&key) ||
    index.effects.contains_key(&key) ||
    index.capabilities.contains_key(&key) ||
    index.contracts.contains_key(&key) ||
    index.type_fields.contains_key(&key) ||
    index.type_impls.contains_key(&key) ||
    index.type_properties.contains_key(&key) ||
    index.type_layouts.contains_key(&key) ||
    index.test_targets.contains_key(&key) ||
    index.test_symbols.contains_key(&key) ||
    index.mir_summaries.contains_key(&key) then
    Option::Some(key.clone())
  else
    Option::None
  end
end

# The sorted def keys containing the needle (substring, not prefix).
def symbol_search(index: SemanticIndex, needle: String) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for key in query_index_keys(&index) do
    if key.contains(needle.clone()) then
      out.push(key.clone())
    end
  end
  out
end

def query_symbol_get(index: SemanticIndex, key: String) -> QueryResults
  var keys: Vec[String] = Vec::new()
  match symbol_get(&index, key.clone())
  when Option::Some(k) then keys.push(k)
  when Option::None then ()
  end
  QueryResults { kind: "symbol_get", keys: keys }
end

def query_symbol_search(index: SemanticIndex, key: String) -> QueryResults
  QueryResults { kind: "symbol_search", keys: symbol_search(&index, key.clone()) }
end

# ———————————————————————————————————————————————————————————————
# Contract helpers — the RECORDED contract rows of a key (scan-based;
# the projections mirror the §31 delta row-key vocabulary — recorded
# only, no verification semantics invented).
# ———————————————————————————————————————————————————————————————

def query_contract_kind_text(k: AstContractKind) -> String
  match k
  when AstContractKind::AstPre then "Pre"
  when AstContractKind::AstPost then "Post"
  when AstContractKind::AstInvariant then "Invariant"
  end
end

# The §31 row-key texts of every contract row recorded for key (sorted).
def contract_obligations(snapshot: SemanticSnapshot, key: String) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  for c in snapshot.contracts do
    if c.function.key == key then
      rows.push(key.clone() + "|" + query_contract_kind_text(&c.kind) + "|" + c.clause_text.clone())
    end
  end
  rows.sort_by(|a, b| a < b)
  rows
end

def contract_has_rows(snapshot: SemanticSnapshot, key: String) -> Bool
  var found = false
  for c in snapshot.contracts do
    if c.function.key == key then
      found = true
      break
    end
  end
  found
end

# The dispatchable form (kind "contract_list" — the recorded §31 row-key rows).
def contract_list(snapshot: SemanticSnapshot, key: String) -> QueryResults
  QueryResults { kind: "contract_list", keys: contract_obligations(&snapshot, key.clone()) }
end

# ———————————————————————————————————————————————————————————————
# Explain helpers — type membership + per-function ownership rows
# ———————————————————————————————————————————————————————————————

# The type key's index surface: fields + impls + properties rows for the
# key, deduped across the three index families and sorted.
def type_explain(index: SemanticIndex, key: String) -> QueryResults
  var rows: Vec[String] = Vec::new()
  for r in index_fields_of(&index, key.clone()) do
    if !rows.contains(&r) then rows.push(r.clone()) end
  end
  for r in index_impls_of(&index, key.clone()) do
    if !rows.contains(&r) then rows.push(r.clone()) end
  end
  for r in index_properties_of(&index, key.clone()) do
    if !rows.contains(&r) then rows.push(r.clone()) end
  end
  rows.sort_by(|a, b| a < b)
  QueryResults { kind: "type_explain", keys: rows }
end

# The ownership row-key texts ("<fn key>|place|<conv>") whose subject-field
# prefix matches key — scan-based (not an index family); conv words mirror
# the §31 delta vocabulary.
def query_ownership_conv_text(c: AccessConvention) -> String
  match c
  when AccessConvention::Let then "let"
  when AccessConvention::Inout then "inout"
  when AccessConvention::Sink then "sink"
  when AccessConvention::Set then "set"
  end
end

def ownership_explain(snapshot: SemanticSnapshot, key: String) -> QueryResults
  var keys: Vec[String] = Vec::new()
  for o in snapshot.ownership do
    let row_key = o.function.key.clone() + "|" + o.place_key.clone() + "|" +
      query_ownership_conv_text(&o.convention)
    if row_key.starts_with(key.clone() + "|") then
      keys.push(row_key)
    end
  end
  keys.sort_by(|a, b| a < b)
  QueryResults { kind: "ownership", keys: keys }
end

# ———————————————————————————————————————————————————————————————
# MIR query helpers — the snapshot carries only the COARSE per-function
# MirSemanticSummary rows (never statements — that is the §33 slice
# domain, over a MirProgram)
# ———————————————————————————————————————————————————————————————

# One key: the def-keyed function's coarse summary render (the §32 index
# payload text — the text the index digest emits for the summary); an
# absent row falls back to the raw key text (no render exists).
def mir_function(snapshot: SemanticSnapshot, key: String) -> QueryResults
  var keys: Vec[String] = Vec::new()
  for m in snapshot.mir_functions do
    if m.function.key == key then
      keys.push(index_mir_payload(&m))
    end
  end
  if keys.is_empty() then
    keys.push(key.clone())
  end
  QueryResults { kind: "mir_function", keys: keys }
end

# The mir_slice query slot — §38 DOCUMENTED GAP: a real slice walks the
# verified MirProgram through the §33 machinery; none rides the §29
# snapshot, so the Option-like empty default keeps the slot callable and
# the result is ALWAYS the empty "mir_slice_unavailable" row set.
def mir_slice(key: String, mir_program: Option[MirProgram] = Option::None) -> QueryResults
  QueryResults { kind: "mir_slice_unavailable", keys: Vec::new() }
end

# ———————————————————————————————————————————————————————————————
# Change helpers — typed probes over one §31 SemanticDelta
# ———————————————————————————————————————————————————————————————

# Membership in the delta's affected closure (see semantic_delta.tg).
def change_affected(delta: SemanticDelta, key: String) -> Bool
  delta.affected.contains(&key)
end

def change_semantic_diff(delta: SemanticDelta) -> QueryResults
  var keys: Vec[String] = Vec::new()
  for e in delta.modified do
    keys.push(e.stable_id.clone())
  end
  keys.sort_by(|a, b| a < b)
  QueryResults { kind: "semantic_diff", keys: keys }
end

# The delta's ABI row keys (the b-side pub-Function stable keys of §31).
def abi_inspect(delta: SemanticDelta) -> QueryResults
  var keys: Vec[String] = Vec::new()
  for k in delta.abi_delta.abi_rows do
    keys.push(k.clone())
  end
  keys.sort_by(|a, b| a < b)
  QueryResults { kind: "abi_inspect", keys: keys }
end

# ———————————————————————————————————————————————————————————————
# The dispatch — one session-scoped query() per operation name
# ———————————————————————————————————————————————————————————————
# Routes the session-scoped ops by name; names outside the set — the
# delta-scoped ops included (change_* / abi_inspect need a delta the
# session does not hold) — return kind "unknown".
pub def query(session: SemanticQuerySession, operation: String, arg: String) -> QueryResults
  match operation
  when "callers" then query_callers(&session.index, arg.clone())
  when "callees" then query_callees(&session.index, arg.clone())
  when "types" then query_types(&session.index, arg.clone())
  when "effects" then query_effects(&session.index, arg.clone())
  when "capabilities" then query_capabilities(&session.index, arg.clone())
  when "contracts" then query_contracts(&session.index, arg.clone())
  when "fields" then query_fields(&session.index, arg.clone())
  when "impls" then query_impls(&session.index, arg.clone())
  when "properties" then query_properties(&session.index, arg.clone())
  when "mir_function" then mir_function(&session.snapshot, arg.clone())
  when "symbol_get" then query_symbol_get(&session.index, arg.clone())
  when "symbol_search" then query_symbol_search(&session.index, arg.clone())
  when "contract_list" then contract_list(&session.snapshot, arg.clone())
  when "type_explain" then type_explain(&session.index, arg.clone())
  when "ownership_explain" then ownership_explain(&session.snapshot, arg.clone())
  when "mir_slice" then mir_slice(arg.clone())
  when _ then QueryResults { kind: "unknown", keys: Vec::new() }
  end
end
