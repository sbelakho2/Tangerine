## Tangerine Compiler — Assembler / Instruction Encoder
## Self-hosting compiler written in Tangerine
##
## Encodes machine instructions for:
## - x86-64 (System V AMD64; Windows x64)
## - ARM64 / AArch64 (AAPCS64)
##
## NO dependency on any other language — raw byte emission only.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map}

# ———————————————————————————————————————————————————————————————
# Code Buffer — the raw byte stream
# ———————————————————————————————————————————————————————————————

struct CodeBuffer
  bytes: Vec[u8]
  labels: Map[String, Int]
  fixups: Vec[Fixup]
  symbols: Vec[AsmSymbol]
  relocations: Vec[Relocation]
end

struct Fixup
  offset: Int          # byte offset in buffer where patch goes
  kind: FixupKind
  label: String        # target label name
end

enum FixupKind
  Rel32              # 32-bit PC-relative (x86-64 jmp/call/jcc)
  Branch26           # ARM64 26-bit branch (B, BL)
  BCond19            # ARM64 19-bit conditional branch (B.cond, CBZ, CBNZ)
  Adrp21             # ARM64 ADRP page
  AddImm12           # ARM64 ADD lo12
end

struct Relocation
  offset: Int
  kind: RelocKind
  symbol: String
  addend: Int
end

enum RelocKind
  # ELF x86-64
  R_X86_64_PC32
  R_X86_64_PLT32
  R_X86_64_GOTPCREL
  R_X86_64_64
  # ELF ARM64
  R_AARCH64_ABS64
  R_AARCH64_CALL26
  R_AARCH64_ADR_PREL_PG_HI21
  R_AARCH64_ADD_ABS_LO12_NC
  R_AARCH64_CONDBR19
  R_AARCH64_PREL32
  R_AARCH64_MOVW_UABS_G0_NC
  R_AARCH64_MOVW_UABS_G1_NC
  R_AARCH64_MOVW_UABS_G2_NC
  R_AARCH64_LDST16_ABS_LO12_NC
  R_AARCH64_LDST64_ABS_LO12_NC
  R_AARCH64_LDST32_ABS_LO12_NC
  R_AARCH64_LDST8_ABS_LO12_NC
  # Mach-O
  X86_64_RELOC_BRANCH
  X86_64_RELOC_SIGNED
  ARM64_RELOC_BRANCH26
  ARM64_RELOC_PAGE21
  ARM64_RELOC_PAGEOFF12
end

def from_elf_reloc_type(arch: Arch, reloc_type: Int) -> Option[RelocKind]
  match arch
  when Arch::X86_64 then
    match reloc_type
    when 1 then Option::Some(RelocKind::R_X86_64_64)
    when 2 then Option::Some(RelocKind::R_X86_64_PC32)
    when 4 then Option::Some(RelocKind::R_X86_64_PLT32)
    when 9 then Option::Some(RelocKind::R_X86_64_GOTPCREL)
    when _ then Option::None
    end
  when Arch::AArch64 then
    match reloc_type
    when 257 then Option::Some(RelocKind::R_AARCH64_ABS64)
    when 261 then Option::Some(RelocKind::R_AARCH64_PREL32)
    when 264 then Option::Some(RelocKind::R_AARCH64_MOVW_UABS_G0_NC)
    when 266 then Option::Some(RelocKind::R_AARCH64_MOVW_UABS_G1_NC)
    when 268 then Option::Some(RelocKind::R_AARCH64_MOVW_UABS_G2_NC)
    when 275 then Option::Some(RelocKind::R_AARCH64_ADR_PREL_PG_HI21)
    when 278 then Option::Some(RelocKind::R_AARCH64_LDST8_ABS_LO12_NC)
    when 277 then Option::Some(RelocKind::R_AARCH64_ADD_ABS_LO12_NC)
    when 280 then Option::Some(RelocKind::R_AARCH64_CONDBR19)
    when 284 then Option::Some(RelocKind::R_AARCH64_LDST16_ABS_LO12_NC)
    when 285 then Option::Some(RelocKind::R_AARCH64_LDST32_ABS_LO12_NC)
    when 286 then Option::Some(RelocKind::R_AARCH64_LDST64_ABS_LO12_NC)
    when 283 then Option::Some(RelocKind::R_AARCH64_CALL26)
    when _ then Option::None
    end
  end
end

def from_macho_reloc_type(arch: Arch, reloc_type: Int) -> Option[RelocKind]
  match arch
  when Arch::X86_64 then
    match reloc_type
    when 1 then Option::Some(RelocKind::X86_64_RELOC_SIGNED)
    when 2 then Option::Some(RelocKind::X86_64_RELOC_BRANCH)
    when _ then Option::None
    end
  when Arch::AArch64 then
    match reloc_type
    when 2 then Option::Some(RelocKind::ARM64_RELOC_BRANCH26)
    when 3 then Option::Some(RelocKind::ARM64_RELOC_PAGE21)
    when 4 then Option::Some(RelocKind::ARM64_RELOC_PAGEOFF12)
    when _ then Option::None
    end
  end
end

struct AsmSymbol
  name: String
  section: Section
  offset: Int
  size: Int
  binding: SymBinding
  kind: SymKind
end

enum SymBinding
  Local
  Global
  Weak
end

enum SymKind
  Func
  Data
  NoType
end

enum Section
  Text
  Data
  Rodata
  Bss
  Extern    # External/undefined symbol (for linker resolution)
end

# ———————————————————————————————————————————————————————————————
# Buffer operations
# ———————————————————————————————————————————————————————————————

def buf_new() -> CodeBuffer
  CodeBuffer {
    bytes: Vec::new(),
    labels: Map::new(),
    fixups: Vec::new(),
    symbols: Vec::new(),
    relocations: Vec::new()
  }
end

# Merge the contents of `src` into `dst`, adjusting all offsets
# by `dst`'s current byte position.  After this call every label,
# fixup, symbol and relocation from `src` is present in `dst` at
# the correct absolute offset within the merged buffer.
def merge_code_buffer(dst: &mut CodeBuffer, src: &CodeBuffer) -> Unit
  let base = buf_pos(dst)

  # 1. Append raw bytes
  var i = 0
  while i < src.bytes.len() do
    emit8(dst, src.bytes[i])
    i = i + 1
  end

  # 2. Merge labels — offset each by base
  let label_entries = src.labels.entries()
  var li = 0
  while li < label_entries.len() do
    let entry = label_entries[li]
    dst.labels.insert(entry.0.clone(), entry.1 + base)
    li = li + 1
  end

  # 3. Merge fixups — offset each by base
  var fi = 0
  while fi < src.fixups.len() do
    let fx = src.fixups[fi]
    dst.fixups.push(Fixup {
      offset: fx.offset + base,
      kind: fx.kind,
      label: fx.label.clone()
    })
    fi = fi + 1
  end

  # 4. Merge relocations — offset each by base
  var ri = 0
  while ri < src.relocations.len() do
    let rl = src.relocations[ri]
    dst.relocations.push(Relocation {
      offset: rl.offset + base,
      kind: rl.kind,
      symbol: rl.symbol.clone(),
      addend: rl.addend
    })
    ri = ri + 1
  end

  # 5. Merge symbols — offset each by base
  var si = 0
  while si < src.symbols.len() do
    let sym = src.symbols[si]
    dst.symbols.push(AsmSymbol {
      name: sym.name.clone(),
      section: sym.section,
      offset: sym.offset + base,
      size: sym.size,
      binding: sym.binding,
      kind: sym.kind
    })
    si = si + 1
  end
end

def buf_pos(b: &CodeBuffer) -> Int
  b.bytes.len()
end

def code_buffer_fixups_len(b: &CodeBuffer) -> Int
  b.fixups.len()
end

def code_buffer_fixup_at(b: &CodeBuffer, index: Int) -> Fixup
  b.fixups[index]
end

def code_buffer_has_label(b: &CodeBuffer, name: &String) -> Bool
  b.labels.contains_key(name)
end

def code_buffer_symbols_clone(b: &CodeBuffer) -> Vec[AsmSymbol]
  b.symbols.clone()
end

def code_buffer_relocations_clone(b: &CodeBuffer) -> Vec[Relocation]
  b.relocations.clone()
end

def code_buffer_bytes_clone(b: &CodeBuffer) -> Vec[u8]
  b.bytes.clone()
end

def code_buffer_label_entries(b: &CodeBuffer) -> Vec[(String, Int)]
  b.labels.entries()
end

def emit8(b: &mut CodeBuffer, v: u8) -> Unit
  b.bytes.push(v)
end

def emit16_le(b: &mut CodeBuffer, v: u16) -> Unit
  emit8(b, (v & 0xFF) as u8)
  emit8(b, ((v >> 8) & 0xFF) as u8)
end

def emit32_le(b: &mut CodeBuffer, v: u32) -> Unit
  emit8(b, (v & 0xFF) as u8)
  emit8(b, ((v >> 8) & 0xFF) as u8)
  emit8(b, ((v >> 16) & 0xFF) as u8)
  emit8(b, ((v >> 24) & 0xFF) as u8)
end

def emit64_le(b: &mut CodeBuffer, v: u64) -> Unit
  emit32_le(b, (v & 0xFFFFFFFF) as u32)
  emit32_le(b, ((v >> 32) & 0xFFFFFFFF) as u32)
end

def emit_i32(b: &mut CodeBuffer, v: i32) -> Unit
  emit32_le(b, v as u32)
end

def patch32_le(b: &mut CodeBuffer, offset: Int, v: u32) -> Unit
  b.bytes[offset]     = (v & 0xFF) as u8
  b.bytes[offset + 1] = ((v >> 8) & 0xFF) as u8
  b.bytes[offset + 2] = ((v >> 16) & 0xFF) as u8
  b.bytes[offset + 3] = ((v >> 24) & 0xFF) as u8
end

def def_label(b: &mut CodeBuffer, name: String) -> Unit
  let pos = buf_pos(b)
  b.labels.insert(name.clone(), pos)
end

def add_fixup(b: &mut CodeBuffer, kind: FixupKind, label: String) -> Unit
  b.fixups.push(Fixup { offset: buf_pos(b), kind: kind, label: label })
end

def add_reloc(b: &mut CodeBuffer, kind: RelocKind, sym: String, addend: Int) -> Unit
  b.relocations.push(Relocation { offset: buf_pos(b), kind: kind, symbol: sym, addend: addend })
end

def add_symbol(b: &mut CodeBuffer, sink sym: AsmSymbol) -> Unit
  b.symbols.push(sym)
end

def patch_rel32_fixup(b: &mut CodeBuffer, offset: Int, target: Int) -> Unit
  let rel = target - (offset + 4)
  patch32_le(b, offset, (rel & 0xFFFF_FFFF) as u32)
end

def patch_branch26_fixup(b: &mut CodeBuffer, offset: Int, target: Int) -> Unit
  let rel = target - offset
  let imm26 = (rel >> 2) & 0x03FFFFFF
  let old = read32_le(b, offset)
  patch32_le(b, offset, (old & 0xFC000000) | (imm26 as u32))
end

def patch_bcond19_fixup(b: &mut CodeBuffer, offset: Int, target: Int) -> Unit
  let rel = target - offset
  let imm19 = ((rel >> 2) & 0x7FFFF) as u32
  let old = read32_le(b, offset)
  patch32_le(b, offset, (old & 0xFF00001F) | (imm19 << 5))
end

def patch_adrp21_fixup(b: &mut CodeBuffer, offset: Int, target: Int) -> Unit
  let pc_page = offset & 0xFFFFF000
  let target_page = target & 0xFFFFF000
  let page_delta = (target_page - pc_page) >> 12
  let immlo = (page_delta & 0x3) as u32
  let immhi = ((page_delta >> 2) & 0x7FFFF) as u32
  let old = read32_le(b, offset)
  patch32_le(b, offset, (old & 0x9F00001F) | (immlo << 29) | (immhi << 5))
end

def patch_addimm12_fixup(b: &mut CodeBuffer, offset: Int, target: Int) -> Unit
  let lo12 = (target & 0xFFF) as u32
  let old = read32_le(b, offset)
  patch32_le(b, offset, (old & 0xFFC003FF) | (lo12 << 10))
end

def resolve_fixups(b: &mut CodeBuffer) -> Result[Unit, String]
  var unresolved: Vec[String] = Vec::new()
  var fi = 0
  while fi < b.fixups.len() do
    let f = b.fixups[fi]
    match b.labels.get(f.label)
    when Option::Some(target) then
      match f.kind
      when FixupKind::Rel32 then
        patch_rel32_fixup(b, f.offset, target)
      when FixupKind::Branch26 then
        patch_branch26_fixup(b, f.offset, target)
      when FixupKind::BCond19 then
        patch_bcond19_fixup(b, f.offset, target)
      when FixupKind::Adrp21 then
        patch_adrp21_fixup(b, f.offset, target)
      when FixupKind::AddImm12 then
        patch_addimm12_fixup(b, f.offset, target)
      end
    when Option::None then
      let fixup_label = f.label.clone()
      if !unresolved.contains(&fixup_label) then
        unresolved.push(fixup_label)
      end
    end
    fi = fi + 1
  end
  if !unresolved.is_empty() then
    # Unresolved fixups are a hard compilation error, never a deferred runtime
    # hang. Patching them into branch-to-self traps turns a deterministic
    # compiler error into a delayed hang once the missing symbol's call path is
    # executed. Bootstrap builds must reject this before emitting an executable.
    var msg = "unresolved assembler labels:"
    for lbl in unresolved do
      msg = msg + " " + lbl
    end
    return Result::Err(msg)
  end
  Result::Ok(())
end

def read32_le(b: &CodeBuffer, offset: Int) -> u32
  (b.bytes[offset] as u32) | ((b.bytes[offset + 1] as u32) << 8) | ((b.bytes[offset + 2] as u32) << 16) | ((b.bytes[offset + 3] as u32) << 24)
end

def align_to(b: &mut CodeBuffer, alignment: Int, arch: Arch) -> Unit
  let remainder = buf_pos(b) % alignment
  if remainder == 0 then
    return
  end

  let padding = alignment - remainder
  var i = 0
  match arch
  when Arch::X86_64 then
    while i < padding do
      emit8(b, 0x90)
      i = i + 1
    end
  when Arch::AArch64 then
    # AArch64 instructions are always 4 bytes.  Pad with zero bytes to reach
    # 4-byte alignment first, then emit complete NOP instructions (0xD503201F).
    let misalign = buf_pos(b) % 4
    if misalign != 0 then
      let fill = 4 - misalign
      var j = 0
      while j < fill do
        emit8(b, 0x00)
        j = j + 1
      end
      i = i + fill
    end
    # Emit full 4-byte NOP instructions for the remaining padding
    while i + 4 <= padding do
      emit8(b, 0x1F)
      emit8(b, 0x20)
      emit8(b, 0x03)
      emit8(b, 0xD5)
      i = i + 4
    end
    # Any leftover bytes (< 4) are filled with zeros (data padding,
    # not executable instructions)
    while i < padding do
      emit8(b, 0x00)
      i = i + 1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# x86-64 Registers
# ———————————————————————————————————————————————————————————————

enum X64
  RAX; RCX; RDX; RBX; RSP; RBP; RSI; RDI
  R8; R9; R10; R11; R12; R13; R14; R15
end

def x64_code(r: X64) -> u8
  match r
  when X64::RAX then 0; when X64::RCX then 1; when X64::RDX then 2; when X64::RBX then 3
  when X64::RSP then 4; when X64::RBP then 5; when X64::RSI then 6; when X64::RDI then 7
  when X64::R8 then 8;  when X64::R9 then 9;  when X64::R10 then 10; when X64::R11 then 11
  when X64::R12 then 12; when X64::R13 then 13; when X64::R14 then 14; when X64::R15 then 15
  end
end

def x64_lo3(r: X64) -> u8
  x64_code(r) & 0x07
end

def x64_hi(r: X64) -> Bool
  x64_code(r) >= 8
end

# System V AMD64: RDI, RSI, RDX, RCX, R8, R9
def x64_arg_reg(i: Int) -> Option[X64]
  match i
  when 0 then Option::Some(X64::RDI)
  when 1 then Option::Some(X64::RSI)
  when 2 then Option::Some(X64::RDX)
  when 3 then Option::Some(X64::RCX)
  when 4 then Option::Some(X64::R8)
  when 5 then Option::Some(X64::R9)
  when _ then Option::None
  end
end

# Callee-saved: RBX, RBP, R12–R15
def x64_callee_saved() -> Vec[X64]
  [X64::RBX, X64::R12, X64::R13, X64::R14, X64::R15]
end

def is_callee_saved(r: X64) -> Bool
  match r
  when X64::RBX then true
  when X64::R12 then true
  when X64::R13 then true
  when X64::R14 then true
  when X64::R15 then true
  when _ then false
  end
end

# ———————————————————————————————————————————————————————————————
# x86-64 Encoding helpers
# ———————————————————————————————————————————————————————————————

def rex(w: Bool, r: Bool, x: Bool, b_: Bool) -> u8
  var v: u8 = 0x40
  if w  then v = v | 0x08 end
  if r  then v = v | 0x04 end
  if x  then v = v | 0x02 end
  if b_ then v = v | 0x01 end
  v
end

def modrm(mod_: u8, reg: u8, rm: u8) -> u8
  ((mod_ & 3) << 6) | ((reg & 7) << 3) | (rm & 7)
end

def sib(scale: u8, idx: u8, base: u8) -> u8
  ((scale & 3) << 6) | ((idx & 7) << 3) | (base & 7)
end

# ———————————————————————————————————————————————————————————————
# x86-64 Instructions
# ———————————————————————————————————————————————————————————————

# MOV r64, imm64  (REX.W + B8+rd io)
def x64_mov_ri(b: &mut CodeBuffer, dst: X64, imm: i64) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  emit8(b, 0xB8 + x64_lo3(dst))
  emit64_le(b, imm as u64)
end

# MOV r64, r64  (REX.W + 89 /r)
def x64_mov_rr(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(src), false, x64_hi(dst)))
  emit8(b, 0x89)
  emit8(b, modrm(0x03, x64_lo3(src), x64_lo3(dst)))
end

# MOV r64, [base + disp32]
def x64_mov_rm(b: &mut CodeBuffer, dst: X64, base: X64, disp: i32) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(base)))
  emit8(b, 0x8B)
  x64_emit_memop(b, x64_lo3(dst), base, disp)
end

# MOV [base + disp32], r64
def x64_mov_mr(b: &mut CodeBuffer, base: X64, disp: i32, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(src), false, x64_hi(base)))
  emit8(b, 0x89)
  x64_emit_memop(b, x64_lo3(src), base, disp)
end

# Helper: emit ModRM + SIB + displacement for [base+disp]
def x64_emit_memop(b: &mut CodeBuffer, reg: u8, base: X64, disp: i32) -> Unit
  let blo = x64_lo3(base)
  if disp == 0 && blo != 5 then
    emit8(b, modrm(0x00, reg, blo))
    if blo == 4 then emit8(b, sib(0, 4, 4)) end
  elsif disp >= -128 && disp <= 127 then
    emit8(b, modrm(0x01, reg, blo))
    if blo == 4 then emit8(b, sib(0, 4, 4)) end
    emit8(b, disp as u8)
  else
    emit8(b, modrm(0x02, reg, blo))
    if blo == 4 then emit8(b, sib(0, 4, 4)) end
    emit_i32(b, disp)
  end
end

# ADD r64, r64
def x64_add_rr(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(src), false, x64_hi(dst)))
  emit8(b, 0x01)
  emit8(b, modrm(0x03, x64_lo3(src), x64_lo3(dst)))
end

# ADD r64, imm32
def x64_add_ri(b: &mut CodeBuffer, dst: X64, imm: i32) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  if x64_code(dst) == 0 then
    emit8(b, 0x05)
  else
    emit8(b, 0x81)
    emit8(b, modrm(0x03, 0, x64_lo3(dst)))
  end
  emit_i32(b, imm)
end

# SUB r64, r64
def x64_sub_rr(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(src), false, x64_hi(dst)))
  emit8(b, 0x29)
  emit8(b, modrm(0x03, x64_lo3(src), x64_lo3(dst)))
end

# SUB r64, imm32
def x64_sub_ri(b: &mut CodeBuffer, dst: X64, imm: i32) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  if x64_code(dst) == 0 then
    emit8(b, 0x2D)
  else
    emit8(b, 0x81)
    emit8(b, modrm(0x03, 5, x64_lo3(dst)))
  end
  emit_i32(b, imm)
end

# IMUL r64, r64
def x64_imul_rr(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(src)))
  emit8(b, 0x0F); emit8(b, 0xAF)
  emit8(b, modrm(0x03, x64_lo3(dst), x64_lo3(src)))
end

# CQO  (sign-extend RAX -> RDX:RAX)
def x64_cqo(b: &mut CodeBuffer) -> Unit
  emit8(b, rex(true, false, false, false))
  emit8(b, 0x99)
end

# IDIV r64  (RDX:RAX / r -> RAX quot, RDX rem)
def x64_idiv_r(b: &mut CodeBuffer, src: X64) -> Unit
  emit8(b, rex(true, false, false, x64_hi(src)))
  emit8(b, 0xF7)
  emit8(b, modrm(0x03, 7, x64_lo3(src)))
end

# AND r64, r64
def x64_and_rr(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(src), false, x64_hi(dst)))
  emit8(b, 0x21)
  emit8(b, modrm(0x03, x64_lo3(src), x64_lo3(dst)))
end

# AND r64, imm8 (sign-extended)
def x64_and_ri8(b: &mut CodeBuffer, dst: X64, imm: i8) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  emit8(b, 0x83)
  emit8(b, modrm(0x03, 4, x64_lo3(dst)))  # /4 = AND
  emit8(b, imm as u8)
end

# AND r64, imm32
def x64_and_ri(b: &mut CodeBuffer, dst: X64, imm: i32) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  if x64_code(dst) == 0 then
    emit8(b, 0x25)
  else
    emit8(b, 0x81)
    emit8(b, modrm(0x03, 4, x64_lo3(dst)))
  end
  emit_i32(b, imm)
end

# OR r64, r64
def x64_or_rr(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(src), false, x64_hi(dst)))
  emit8(b, 0x09)
  emit8(b, modrm(0x03, x64_lo3(src), x64_lo3(dst)))
end

# XOR r64, r64
def x64_xor_rr(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(src), false, x64_hi(dst)))
  emit8(b, 0x31)
  emit8(b, modrm(0x03, x64_lo3(src), x64_lo3(dst)))
end

# SHL r64, CL
def x64_shl_rcl(b: &mut CodeBuffer, dst: X64) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  emit8(b, 0xD3)
  emit8(b, modrm(0x03, 4, x64_lo3(dst)))
end

# SHL r64, imm8 (shift left by immediate)
def x64_shl_ri(b: &mut CodeBuffer, dst: X64, imm: u8) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  if imm == 1 then
    # SHL r/m64, 1 = D1 /4
    emit8(b, 0xD1)
    emit8(b, modrm(0x03, 4, x64_lo3(dst)))
  else
    # SHL r/m64, imm8 = C1 /4 ib
    emit8(b, 0xC1)
    emit8(b, modrm(0x03, 4, x64_lo3(dst)))
    emit8(b, imm)
  end
end

# CMOVA r64, r64 (conditional move if above, CF=0 && ZF=0)
def x64_cmova_rr(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(src), false, x64_hi(dst)))
  emit8(b, 0x0F)
  emit8(b, 0x47)
  emit8(b, modrm(0x03, x64_lo3(src), x64_lo3(dst)))
end

# SHR r64, CL
def x64_shr_rcl(b: &mut CodeBuffer, dst: X64) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  emit8(b, 0xD3)
  emit8(b, modrm(0x03, 5, x64_lo3(dst)))
end

# SHR r64, imm8 (shift right by immediate)
def x64_shr_ri(b: &mut CodeBuffer, dst: X64, imm: u8) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  if imm == 1 then
    # SHR r/m64, 1 = D1 /5
    emit8(b, 0xD1)
    emit8(b, modrm(0x03, 5, x64_lo3(dst)))
  else
    # SHR r/m64, imm8 = C1 /5 ib
    emit8(b, 0xC1)
    emit8(b, modrm(0x03, 5, x64_lo3(dst)))
    emit8(b, imm)
  end
end

# SAR r64, CL (arithmetic shift right)
def x64_sar_rcl(b: &mut CodeBuffer, dst: X64) -> Unit
  emit8(b, rex(true, false, false, x64_hi(dst)))
  emit8(b, 0xD3)
  emit8(b, modrm(0x03, 7, x64_lo3(dst)))
end

# NEG r64
def x64_neg_r(b: &mut CodeBuffer, r: X64) -> Unit
  emit8(b, rex(true, false, false, x64_hi(r)))
  emit8(b, 0xF7)
  emit8(b, modrm(0x03, 3, x64_lo3(r)))
end

# NOT r64
def x64_not_r(b: &mut CodeBuffer, r: X64) -> Unit
  emit8(b, rex(true, false, false, x64_hi(r)))
  emit8(b, 0xF7)
  emit8(b, modrm(0x03, 2, x64_lo3(r)))
end

# CMP r64, r64
def x64_cmp_rr(b: &mut CodeBuffer, left: X64, right: X64) -> Unit
  emit8(b, rex(true, x64_hi(right), false, x64_hi(left)))
  emit8(b, 0x39)
  emit8(b, modrm(0x03, x64_lo3(right), x64_lo3(left)))
end

# CMP r64, imm32
def x64_cmp_ri(b: &mut CodeBuffer, r: X64, imm: i32) -> Unit
  emit8(b, rex(true, false, false, x64_hi(r)))
  emit8(b, 0x81)
  emit8(b, modrm(0x03, 7, x64_lo3(r)))
  emit_i32(b, imm)
end

# TEST r64, r64
def x64_test_rr(b: &mut CodeBuffer, a: X64, b_: X64) -> Unit
  emit8(b, rex(true, x64_hi(b_), false, x64_hi(a)))
  emit8(b, 0x85)
  emit8(b, modrm(0x03, x64_lo3(b_), x64_lo3(a)))
end

# Condition codes
enum CC
  E; NE; L; LE; G; GE; B; BE; A; AE; S; NS; O; NO
end

def cc_byte(c: CC) -> u8
  match c
  when CC::E  then 0x04; when CC::NE then 0x05
  when CC::L  then 0x0C; when CC::LE then 0x0E
  when CC::G  then 0x0F; when CC::GE then 0x0D
  when CC::B  then 0x02; when CC::BE then 0x06
  when CC::A  then 0x07; when CC::AE then 0x03
  when CC::S  then 0x08; when CC::NS then 0x09
  when CC::O  then 0x00; when CC::NO then 0x01
  end
end

# SETcc r8 (only low byte)
def x64_setcc(b: &mut CodeBuffer, cc: CC, dst: X64) -> Unit
  let dc = x64_code(dst)
  if dc >= 4 then
    emit8(b, rex(false, false, false, x64_hi(dst)))
  end
  emit8(b, 0x0F); emit8(b, 0x90 + cc_byte(cc))
  emit8(b, modrm(0x03, 0, x64_lo3(dst)))
end

# MOVZX r64, r8
def x64_movzx_r64_r8(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(src)))
  emit8(b, 0x0F); emit8(b, 0xB6)
  emit8(b, modrm(0x03, x64_lo3(dst), x64_lo3(src)))
end

# MOVZX r64, byte [base + disp]
def x64_movzx_r64_m8(b: &mut CodeBuffer, dst: X64, base: X64, disp: i32) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(base)))
  emit8(b, 0x0F); emit8(b, 0xB6)
  x64_emit_memop(b, x64_lo3(dst), base, disp)
end

# MOVZX r64, word [base + disp]
def x64_movzx_r64_m16(b: &mut CodeBuffer, dst: X64, base: X64, disp: i32) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(base)))
  emit8(b, 0x0F); emit8(b, 0xB7)
  x64_emit_memop(b, x64_lo3(dst), base, disp)
end

# MOVSX r64, byte [base + disp]
def x64_movsx_r64_m8(b: &mut CodeBuffer, dst: X64, base: X64, disp: i32) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(base)))
  emit8(b, 0x0F); emit8(b, 0xBE)
  x64_emit_memop(b, x64_lo3(dst), base, disp)
end

# MOVSX r64, word [base + disp]
def x64_movsx_r64_m16(b: &mut CodeBuffer, dst: X64, base: X64, disp: i32) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(base)))
  emit8(b, 0x0F); emit8(b, 0xBF)
  x64_emit_memop(b, x64_lo3(dst), base, disp)
end

# MOV r32, dword [base + disp]  (upper 32 bits of dst zeroed)
def x64_mov_r32_m32(b: &mut CodeBuffer, dst: X64, base: X64, disp: i32) -> Unit
  if x64_hi(dst) || x64_hi(base) then
    emit8(b, rex(false, x64_hi(dst), false, x64_hi(base)))
  end
  emit8(b, 0x8B)
  x64_emit_memop(b, x64_lo3(dst), base, disp)
end

# MOVSXD r64, dword [base + disp]  (sign-extend 32-bit memory to 64-bit)
def x64_movsx_r64_m32(b: &mut CodeBuffer, dst: X64, base: X64, disp: i32) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(base)))
  emit8(b, 0x63)
  x64_emit_memop(b, x64_lo3(dst), base, disp)
end

# MOV byte [base + disp], r8 (low 8 bits of src)
def x64_mov_m8_r8(b: &mut CodeBuffer, base: X64, disp: i32, src: X64) -> Unit
  if x64_hi(base) || x64_hi(src) then
    emit8(b, rex(false, x64_hi(src), false, x64_hi(base)))
  end
  emit8(b, 0x88)
  x64_emit_memop(b, x64_lo3(src), base, disp)
end

# MOV word [base + disp], r16 (low 16 bits of src)
def x64_mov_m16_r16(b: &mut CodeBuffer, base: X64, disp: i32, src: X64) -> Unit
  emit8(b, 0x66)
  if x64_hi(base) || x64_hi(src) then
    emit8(b, rex(false, x64_hi(src), false, x64_hi(base)))
  end
  emit8(b, 0x89)
  x64_emit_memop(b, x64_lo3(src), base, disp)
end

# MOV dword [base + disp], r32 (low 32 bits of src)
def x64_mov_m32_r32(b: &mut CodeBuffer, base: X64, disp: i32, src: X64) -> Unit
  if x64_hi(base) || x64_hi(src) then
    emit8(b, rex(false, x64_hi(src), false, x64_hi(base)))
  end
  emit8(b, 0x89)
  x64_emit_memop(b, x64_lo3(src), base, disp)
end

# MOV r32, r32 (32-bit move, upper 32 bits zeroed)
def x64_mov_r32(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  # Use 32-bit operand size (no REX.W) so upper 32 bits are zeroed
  let need_rex = x64_hi(src) || x64_hi(dst)
  if need_rex then
    emit8(b, rex(false, x64_hi(src), false, x64_hi(dst)))
  end
  emit8(b, 0x89)
  emit8(b, modrm(0x03, x64_lo3(src), x64_lo3(dst)))
end

# MOVSXD r64, r32 (sign-extend 32-bit to 64-bit)
def x64_movsxd(b: &mut CodeBuffer, dst: X64, src: X64) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(src)))
  emit8(b, 0x63)
  emit8(b, modrm(0x03, x64_lo3(dst), x64_lo3(src)))
end

# JMP rel32  (with fixup)
def x64_jmp(b: &mut CodeBuffer, label: String) -> Unit
  emit8(b, 0xE9)
  add_fixup(b, FixupKind::Rel32, label)
  emit_i32(b, 0)
end

# Jcc rel32  (with fixup)
def x64_jcc(b: &mut CodeBuffer, cc: CC, label: String) -> Unit
  emit8(b, 0x0F)
  emit8(b, 0x80 + cc_byte(cc))
  add_fixup(b, FixupKind::Rel32, label)
  emit_i32(b, 0)
end

# CALL rel32  (with fixup or relocation)
def x64_call_label(b: &mut CodeBuffer, label: String) -> Unit
  emit8(b, 0xE8)
  add_fixup(b, FixupKind::Rel32, label)
  emit_i32(b, 0)
end

# CALL rel32 external (needs relocation)
def x64_call_extern(b: &mut CodeBuffer, sym: String) -> Unit
  emit8(b, 0xE8)
  add_reloc(b, RelocKind::R_X86_64_PLT32, sym, -4)
  emit_i32(b, 0)
end

# CALL r64
def x64_call_r(b: &mut CodeBuffer, r: X64) -> Unit
  if x64_hi(r) then emit8(b, rex(false, false, false, true)) end
  emit8(b, 0xFF)
  emit8(b, modrm(0x03, 2, x64_lo3(r)))
end

# JMP r64
def x64_jmp_r(b: &mut CodeBuffer, r: X64) -> Unit
  if x64_hi(r) then emit8(b, rex(false, false, false, true)) end
  emit8(b, 0xFF)
  emit8(b, modrm(0x03, 4, x64_lo3(r)))
end

# RET
def x64_ret(b: &mut CodeBuffer) -> Unit
  emit8(b, 0xC3)
end

# PUSH r64
def x64_push(b: &mut CodeBuffer, r: X64) -> Unit
  if x64_hi(r) then emit8(b, rex(false, false, false, true)) end
  emit8(b, 0x50 + x64_lo3(r))
end

# POP r64
def x64_pop(b: &mut CodeBuffer, r: X64) -> Unit
  if x64_hi(r) then emit8(b, rex(false, false, false, true)) end
  emit8(b, 0x58 + x64_lo3(r))
end

# LEA r64, [rip + rel32]   (RIP-relative)
def x64_lea_rip(b: &mut CodeBuffer, dst: X64, label: String) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, false))
  emit8(b, 0x8D)
  emit8(b, modrm(0x00, x64_lo3(dst), 5))
  add_fixup(b, FixupKind::Rel32, label)
  emit_i32(b, 0)
end

# LEA r64, [base + disp32]
def x64_lea_mem(b: &mut CodeBuffer, dst: X64, base: X64, disp: i32) -> Unit
  emit8(b, rex(true, x64_hi(dst), false, x64_hi(base)))
  emit8(b, 0x8D)
  x64_emit_memop(b, x64_lo3(dst), base, disp)
end

# SYSCALL
def x64_syscall(b: &mut CodeBuffer) -> Unit
  emit8(b, 0x0F); emit8(b, 0x05)
end

# UD2  (unreachable / trap)
def x64_ud2(b: &mut CodeBuffer) -> Unit
  emit8(b, 0x0F); emit8(b, 0x0B)
end

# INT3  (debug breakpoint)
def x64_int3(b: &mut CodeBuffer) -> Unit
  emit8(b, 0xCC)
end

# NOP
def x64_nop(b: &mut CodeBuffer) -> Unit
  emit8(b, 0x90)
end

# Multi-byte NOP (for alignment padding)
def x64_nop_n(b: &mut CodeBuffer, n: Int) -> Unit
  # Use recommended multi-byte NOP encodings
  var remaining = n
  while remaining > 0 do
    if remaining >= 9 then
      # 66 0F 1F 84 00 00 00 00 00
      emit8(b, 0x66); emit8(b, 0x0F); emit8(b, 0x1F)
      emit8(b, 0x84); emit8(b, 0x00)
      emit32_le(b, 0)
      remaining = remaining - 9
    elsif remaining >= 8 then
      emit8(b, 0x0F); emit8(b, 0x1F)
      emit8(b, 0x84); emit8(b, 0x00)
      emit32_le(b, 0)
      remaining = remaining - 8
    elsif remaining >= 7 then
      emit8(b, 0x0F); emit8(b, 0x1F)
      emit8(b, 0x80); emit32_le(b, 0)
      remaining = remaining - 7
    elsif remaining >= 4 then
      emit8(b, 0x0F); emit8(b, 0x1F)
      emit8(b, 0x40); emit8(b, 0x00)
      remaining = remaining - 4
    elsif remaining >= 3 then
      emit8(b, 0x0F); emit8(b, 0x1F); emit8(b, 0x00)
      remaining = remaining - 3
    elsif remaining >= 2 then
      emit8(b, 0x66); emit8(b, 0x90)
      remaining = remaining - 2
    else
      emit8(b, 0x90)
      remaining = remaining - 1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# ARM64 (AArch64) Registers
# ———————————————————————————————————————————————————————————————

# 64-bit general-purpose (X) registers
enum A64
  X0; X1; X2; X3; X4; X5; X6; X7
  X8; X9; X10; X11; X12; X13; X14; X15
  X16; X17; X18; X19; X20; X21; X22; X23
  X24; X25; X26; X27; X28
  FP    # X29
  LR    # X30
  SP
  XZR
end

# SIMD/Floating-point registers (V0–V31)
# Used as Sn (32-bit float), Dn (64-bit double), Qn (128-bit SIMD)
enum A64V
  V0; V1; V2; V3; V4; V5; V6; V7
  V8; V9; V10; V11; V12; V13; V14; V15
  V16; V17; V18; V19; V20; V21; V22; V23
  V24; V25; V26; V27; V28; V29; V30; V31
end

def a64v_code(r: A64V) -> u32
  match r
  when A64V::V0 then 0;   when A64V::V1 then 1;   when A64V::V2 then 2;   when A64V::V3 then 3
  when A64V::V4 then 4;   when A64V::V5 then 5;   when A64V::V6 then 6;   when A64V::V7 then 7
  when A64V::V8 then 8;   when A64V::V9 then 9;   when A64V::V10 then 10; when A64V::V11 then 11
  when A64V::V12 then 12; when A64V::V13 then 13; when A64V::V14 then 14; when A64V::V15 then 15
  when A64V::V16 then 16; when A64V::V17 then 17; when A64V::V18 then 18; when A64V::V19 then 19
  when A64V::V20 then 20; when A64V::V21 then 21; when A64V::V22 then 22; when A64V::V23 then 23
  when A64V::V24 then 24; when A64V::V25 then 25; when A64V::V26 then 26; when A64V::V27 then 27
  when A64V::V28 then 28; when A64V::V29 then 29; when A64V::V30 then 30; when A64V::V31 then 31
  end
end

def a64_code(r: A64) -> u32
  match r
  when A64::X0 then 0;   when A64::X1 then 1;   when A64::X2 then 2;   when A64::X3 then 3
  when A64::X4 then 4;   when A64::X5 then 5;   when A64::X6 then 6;   when A64::X7 then 7
  when A64::X8 then 8;   when A64::X9 then 9;   when A64::X10 then 10; when A64::X11 then 11
  when A64::X12 then 12; when A64::X13 then 13; when A64::X14 then 14; when A64::X15 then 15
  when A64::X16 then 16; when A64::X17 then 17; when A64::X18 then 18; when A64::X19 then 19
  when A64::X20 then 20; when A64::X21 then 21; when A64::X22 then 22; when A64::X23 then 23
  when A64::X24 then 24; when A64::X25 then 25; when A64::X26 then 26; when A64::X27 then 27
  when A64::X28 then 28; when A64::FP then 29;  when A64::LR then 30
  when A64::SP then 31;  when A64::XZR then 31
  end
end

# AAPCS64: X0–X7 for arguments
def a64_arg_reg(i: Int) -> Option[A64]
  match i
  when 0 then Option::Some(A64::X0); when 1 then Option::Some(A64::X1)
  when 2 then Option::Some(A64::X2); when 3 then Option::Some(A64::X3)
  when 4 then Option::Some(A64::X4); when 5 then Option::Some(A64::X5)
  when 6 then Option::Some(A64::X6); when 7 then Option::Some(A64::X7)
  when _ then Option::None
  end
end

# Callee-saved: X19–X28, FP, LR
def a64_callee_saved() -> Vec[A64]
  [A64::X19, A64::X20, A64::X21, A64::X22, A64::X23,
   A64::X24, A64::X25, A64::X26, A64::X27, A64::X28]
end

# ———————————————————————————————————————————————————————————————
# ARM64 Instructions
# ———————————————————————————————————————————————————————————————

# ADD Xd, Xn, Xm
def a64_add_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0x8B000000 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# ADD Xd, Xn, #imm12
def a64_add_rri(b: &mut CodeBuffer, d: A64, n: A64, imm: u32) -> Unit
  if imm > 0xFFF then panic("a64_add_rri: immediate " + imm.to_string() + " exceeds 12-bit range") end
  emit32_le(b, 0x91000000 | ((imm & 0xFFF) << 10) | (a64_code(n) << 5) | a64_code(d))
end

# SUB Xd, Xn, Xm  (shifted register form — reg31 = XZR, NOT SP)
def a64_sub_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0xCB000000 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# SUB SP, SP, Xm, UXTX #0  (extended register form — reg31 = SP)
def a64_sub_sp_sp_r(b: &mut CodeBuffer, m: A64) -> Unit
  emit32_le(b, 0xCB2063FF | (a64_code(m) << 16))
end

# SUB Xd, Xn, #imm12
def a64_sub_rri(b: &mut CodeBuffer, d: A64, n: A64, imm: u32) -> Unit
  if imm > 0xFFF then panic("a64_sub_rri: immediate " + imm.to_string() + " exceeds 12-bit range") end
  emit32_le(b, 0xD1000000 | ((imm & 0xFFF) << 10) | (a64_code(n) << 5) | a64_code(d))
end

# MUL Xd, Xn, Xm  (MADD Xd, Xn, Xm, XZR)
def a64_mul_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0x9B007C00 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# SDIV Xd, Xn, Xm
def a64_sdiv_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0x9AC00C00 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# AND Xd, Xn, Xm
def a64_and_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0x8A000000 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# AND Xd, Xn, #bitmask  (using MOVZ + AND sequence via scratch X16)
# For truncation masks like 0xFF, 0xFFFF, 0xFFFFFFFF.
# Encodes: MOVZ X16, #imm_lo; [MOVK X16, #imm_hi, LSL#16]; AND Xd, Xd, X16
def a64_and_ri(b: &mut CodeBuffer, d: A64, imm: u32) -> Unit
  let lo = (imm & 0xFFFF) as u16
  let hi = ((imm >> 16) & 0xFFFF) as u16
  let scratch = if d == A64::X16 then A64::X15 else A64::X16 end
  a64_movz(b, scratch, lo, 0)
  if hi != 0 then
    a64_movk(b, scratch, hi, 16)
  end
  emit32_le(b, 0x8A000000 | (a64_code(scratch) << 16) | (a64_code(d) << 5) | a64_code(d))
end

# ORR Xd, Xn, Xm
def a64_orr_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0xAA000000 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# EOR Xd, Xn, Xm
def a64_eor_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0xCA000000 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# MOV Xd, Xn  (ORR Xd, XZR, Xn)
def a64_mov_rr(b: &mut CodeBuffer, d: A64, n: A64) -> Unit
  # In ARM64, register 31 is XZR in ORR but SP in ADD/SUB.
  # When either operand is SP, use ADD Xd, Xn, #0 instead.
  match n
  when A64::SP then
    emit32_le(b, 0x91000000 | (a64_code(n) << 5) | a64_code(d))
  when _ then
    match d
    when A64::SP then
      emit32_le(b, 0x91000000 | (a64_code(n) << 5) | a64_code(d))
    when _ then
      emit32_le(b, 0xAA0003E0 | (a64_code(n) << 16) | a64_code(d))
    end
  end
end

# MOV Wd, Wn (32-bit register move, zero-extends to 64-bit)
# Encoded as ORR Wd, WZR, Wn (sf=0)
def a64_mov_w(b: &mut CodeBuffer, d: A64, n: A64) -> Unit
  # 32-bit ORR: 0x2A0003E0 = sf=0 ORR Wd, WZR, Wn
  emit32_le(b, 0x2A0003E0 | (a64_code(n) << 16) | a64_code(d))
end

# SXTW Xd, Wn (sign-extend 32-bit to 64-bit)
# Encoded as SBFM Xd, Xn, #0, #31
def a64_sxtw(b: &mut CodeBuffer, d: A64, n: A64) -> Unit
  # SBFM: 0x93407C00 = sf=1 opc=00 N=1 immr=0 imms=31(0x1F) -> 0x93407C00
  emit32_le(b, 0x93407C00 | (a64_code(n) << 5) | a64_code(d))
end

# MOVZ Xd, #imm16, LSL #shift
def a64_movz(b: &mut CodeBuffer, d: A64, imm: u16, shift: u32) -> Unit
  if shift != 0 && shift != 16 && shift != 32 && shift != 48 then panic("a64_movz: shift must be 0, 16, 32, or 48") end
  let hw = shift / 16
  emit32_le(b, 0xD2800000 | (hw << 21) | ((imm as u32) << 5) | a64_code(d))
end

# MOVK Xd, #imm16, LSL #shift
def a64_movk(b: &mut CodeBuffer, d: A64, imm: u16, shift: u32) -> Unit
  if shift != 0 && shift != 16 && shift != 32 && shift != 48 then panic("a64_movk: shift must be 0, 16, 32, or 48") end
  let hw = shift / 16
  emit32_le(b, 0xF2800000 | (hw << 21) | ((imm as u32) << 5) | a64_code(d))
end

# Load full 64-bit immediate using MOVZ + MOVK sequence
def a64_mov_ri(b: &mut CodeBuffer, d: A64, imm: i64) -> Unit
  let u = imm as u64
  let lane0 = (u & 0xFFFF) as u16
  let lane1 = ((u >> 16) & 0xFFFF) as u16
  let lane2 = ((u >> 32) & 0xFFFF) as u16
  let lane3 = ((u >> 48) & 0xFFFF) as u16

  a64_movz(b, d, lane0, 0)
  if lane1 != 0 then a64_movk(b, d, lane1, 16) end
  if lane2 != 0 then a64_movk(b, d, lane2, 32) end
  if lane3 != 0 then a64_movk(b, d, lane3, 48) end
end

# LDR Xd, [Xn, #imm12*8]
def a64_ldr(b: &mut CodeBuffer, d: A64, base: A64, offset: u32) -> Unit
  let imm12 = (offset / 8) & 0xFFF
  emit32_le(b, 0xF9400000 | (imm12 << 10) | (a64_code(base) << 5) | a64_code(d))
end

# STR Xd, [Xn, #imm12*8]
def a64_str(b: &mut CodeBuffer, src: A64, base: A64, offset: u32) -> Unit
  let imm12 = (offset / 8) & 0xFFF
  emit32_le(b, 0xF9000000 | (imm12 << 10) | (a64_code(base) << 5) | a64_code(src))
end

# LDUR Xd, [Xn, #simm9]  (unscaled offset)
def a64_ldur(b: &mut CodeBuffer, d: A64, base: A64, offset: i32) -> Unit
  let imm9 = (offset & 0x1FF) as u32
  emit32_le(b, 0xF8400000 | (imm9 << 12) | (a64_code(base) << 5) | a64_code(d))
end

# STUR Xd, [Xn, #simm9]
def a64_stur(b: &mut CodeBuffer, src: A64, base: A64, offset: i32) -> Unit
  let imm9 = (offset & 0x1FF) as u32
  emit32_le(b, 0xF8000000 | (imm9 << 12) | (a64_code(base) << 5) | a64_code(src))
end

# CMP Xn, Xm  (SUBS XZR, Xn, Xm)
def a64_cmp_rr(b: &mut CodeBuffer, n: A64, m: A64) -> Unit
  emit32_le(b, 0xEB00001F | (a64_code(m) << 16) | (a64_code(n) << 5))
end

# CMP Xn, #imm12
def a64_cmp_ri(b: &mut CodeBuffer, n: A64, imm: u32) -> Unit
  if imm <= 0xFFF then
    emit32_le(b, 0xF100001F | ((imm & 0xFFF) << 10) | (a64_code(n) << 5))
  elsif (imm & 0xFFF) == 0 && (imm >> 12) <= 0xFFF then
    emit32_le(b, 0xF140001F | (((imm >> 12) & 0xFFF) << 10) | (a64_code(n) << 5))
  else
    let scratch = if n == A64::X16 then A64::X17 else A64::X16 end
    a64_mov_ri(b, scratch, imm as i64)
    a64_cmp_rr(b, n, scratch)
  end
end

# CSET Xd, cond  (CSINC Xd, XZR, XZR, inv(cond))
def a64_cset(b: &mut CodeBuffer, d: A64, cond: u32) -> Unit
  let inv = cond ^ 1
  emit32_le(b, 0x9A9F07E0 | (inv << 12) | a64_code(d))
end

# B label (unconditional)
def a64_b(b: &mut CodeBuffer, label: String) -> Unit
  add_fixup(b, FixupKind::Branch26, label)
  emit32_le(b, 0x14000000)
end

# B.cond label
def a64_bcond(b: &mut CodeBuffer, cond: u32, label: String) -> Unit
  add_fixup(b, FixupKind::BCond19, label)
  emit32_le(b, 0x54000000 | (cond & 0xF))
end

# BL label
def a64_bl(b: &mut CodeBuffer, label: String) -> Unit
  add_fixup(b, FixupKind::Branch26, label)
  emit32_le(b, 0x94000000)
end

# BLR Xn
def a64_blr(b: &mut CodeBuffer, n: A64) -> Unit
  emit32_le(b, 0xD63F0000 | (a64_code(n) << 5))
end

# RET  (BR X30)
def a64_ret(b: &mut CodeBuffer) -> Unit
  emit32_le(b, 0xD65F03C0)
end

# STP Xt1, Xt2, [Xn, #imm7*8]!  (pre-index)
def a64_stp_pre(b: &mut CodeBuffer, r1: A64, r2: A64, base: A64, offset: i32) -> Unit
  let imm7 = ((offset / 8) & 0x7F) as u32
  emit32_le(b, 0xA9800000 | (imm7 << 15) | (a64_code(r2) << 10) | (a64_code(base) << 5) | a64_code(r1))
end

# LDP Xt1, Xt2, [Xn], #imm7*8  (post-index)
def a64_ldp_post(b: &mut CodeBuffer, r1: A64, r2: A64, base: A64, offset: i32) -> Unit
  let imm7 = ((offset / 8) & 0x7F) as u32
  emit32_le(b, 0xA8C00000 | (imm7 << 15) | (a64_code(r2) << 10) | (a64_code(base) << 5) | a64_code(r1))
end

# LDR Xt, [Xn], #simm9  (post-index)
def a64_ldr_post(b: &mut CodeBuffer, d: A64, base: A64, offset: i32) -> Unit
  let imm9 = (offset & 0x1FF) as u32
  emit32_le(b, 0xF8400400 | (imm9 << 12) | (a64_code(base) << 5) | a64_code(d))
end

# SVC #0  (system call on Linux)
def a64_svc(b: &mut CodeBuffer, imm: u16) -> Unit
  emit32_le(b, 0xD4000001 | ((imm as u32) << 5))
end

# BRK #0  (debug break)
def a64_brk(b: &mut CodeBuffer, imm: u16) -> Unit
  emit32_le(b, 0xD4200000 | ((imm as u32) << 5))
end

# UDF  (undefined / trap)
def a64_udf(b: &mut CodeBuffer) -> Unit
  emit32_le(b, 0x00000000)
end

# NOP
def a64_nop(b: &mut CodeBuffer) -> Unit
  emit32_le(b, 0xD503201F)
end

# ———————————————————————————————————————————————————————————————
# ARM64 atomic intrinsics (ARMv8.1 LSE — supported on Apple Silicon)
# ———————————————————————————————————————————————————————————————

# DMB ISH  (data memory barrier, inner shareable)
def a64_dmb_ish(b: &mut CodeBuffer) -> Unit
  emit32_le(b, 0xD5033BBF)
end

# CASALB Ws, Wt, [Xn]   8-bit compare-and-swap, acquire-release
# If [Xn] == Ws then [Xn] = Wt; Ws is then overwritten with the original [Xn].
def a64_casalb(b: &mut CodeBuffer, s: A64, t: A64, n: A64) -> Unit
  emit32_le(b, 0x08E0FC00 | (a64_code(s) << 16) | (a64_code(n) << 5) | a64_code(t))
end

# CASAL Ws, Wt, [Xn]    32-bit compare-and-swap, acquire-release
def a64_casal_w(b: &mut CodeBuffer, s: A64, t: A64, n: A64) -> Unit
  emit32_le(b, 0x88E0FC00 | (a64_code(s) << 16) | (a64_code(n) << 5) | a64_code(t))
end

# CASAL Xs, Xt, [Xn]    64-bit compare-and-swap, acquire-release
def a64_casal_x(b: &mut CodeBuffer, s: A64, t: A64, n: A64) -> Unit
  emit32_le(b, 0xC8E0FC00 | (a64_code(s) << 16) | (a64_code(n) << 5) | a64_code(t))
end

# LDADDAL Ws, Wt, [Xn]  32-bit atomic add, acquire-release
# Atomically [Xn] += Ws; Wt receives the original value of [Xn].
# Note: Ws/Wt/Xn must NOT alias (CONSTRAINED UNPREDICTABLE per ARM ARM).
def a64_ldaddal_w(b: &mut CodeBuffer, s: A64, t: A64, n: A64) -> Unit
  emit32_le(b, 0xB8E00000 | (a64_code(s) << 16) | (a64_code(n) << 5) | a64_code(t))
end

# LDADDAL Xs, Xt, [Xn]  64-bit atomic add, acquire-release
def a64_ldaddal_x(b: &mut CodeBuffer, s: A64, t: A64, n: A64) -> Unit
  emit32_le(b, 0xF8E00000 | (a64_code(s) << 16) | (a64_code(n) << 5) | a64_code(t))
end

# CMP Wn, Wm   (SUBS WZR, Wn, Wm)
def a64_cmp_w(b: &mut CodeBuffer, n: A64, m: A64) -> Unit
  emit32_le(b, 0x6B00001F | (a64_code(m) << 16) | (a64_code(n) << 5))
end

# CSET Xd, eq    (CSINC Xd, XZR, XZR, NE)
def a64_cset_eq(b: &mut CodeBuffer, d: A64) -> Unit
  emit32_le(b, 0x9A9F17E0 | a64_code(d))
end

# MOV Wd, Wn   (ORR Wd, WZR, Wn)
def a64_mov_w_rr(b: &mut CodeBuffer, d: A64, n: A64) -> Unit
  emit32_le(b, 0x2A0003E0 | (a64_code(n) << 16) | a64_code(d))
end

# NEG Wd, Wm  (SUB Wd, WZR, Wm) — 32-bit
def a64_neg_w(b: &mut CodeBuffer, d: A64, m: A64) -> Unit
  emit32_le(b, 0x4B0003E0 | (a64_code(m) << 16) | a64_code(d))
end

# NEG Xd, Xm  (SUB Xd, XZR, Xm)
def a64_neg(b: &mut CodeBuffer, d: A64, m: A64) -> Unit
  a64_sub_rrr(b, d, A64::XZR, m)
end

# MVN Xd, Xm  (ORN Xd, XZR, Xm — bitwise NOT)
def a64_mvn(b: &mut CodeBuffer, d: A64, m: A64) -> Unit
  emit32_le(b, 0xAA200000 | (a64_code(m) << 16) | (0x1F << 5) | a64_code(d))
end

# TST Xn, Xm  (ANDS XZR, Xn, Xm)
def a64_tst(b: &mut CodeBuffer, n: A64, m: A64) -> Unit
  emit32_le(b, 0xEA00001F | (a64_code(m) << 16) | (a64_code(n) << 5))
end

# LSLV Xd, Xn, Xm (logical shift left, variable)
def a64_lsl_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0x9AC02000 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# LSL Xd, Xn, #amount (immediate form)
def a64_lsl(b: &mut CodeBuffer, d: A64, n: A64, amount: u32) -> Unit
  # UBFM Xd, Xn, #(64-amount), #(63-amount)
  if amount == 0 || amount > 63 then panic("a64_lsl: invalid shift amount") end
  let immr = 64 - amount
  let imms = 63 - amount
  emit32_le(b, 0xD3400000 | (immr << 16) | (imms << 10) | (a64_code(n) << 5) | a64_code(d))
end

# LSRV Xd, Xn, Xm (logical shift right, variable)
def a64_lsr_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0x9AC02400 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# LSR Xd, Xn, #amount (immediate form)
def a64_lsr(b: &mut CodeBuffer, d: A64, n: A64, amount: u32) -> Unit
  # UBFM Xd, Xn, #amount, #63
  if amount == 0 || amount > 63 then panic("a64_lsr: invalid shift amount") end
  let immr = amount
  let imms: u32 = 63
  emit32_le(b, 0xD3400000 | (immr << 16) | (imms << 10) | (a64_code(n) << 5) | a64_code(d))
end

# UDIV Xd, Xn, Xm (unsigned divide)
def a64_udiv(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0x9AC00800 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# MSUB Xd, Xm, Xa, Xn (multiply-subtract: d = n - m*a)
def a64_msub(b: &mut CodeBuffer, d: A64, m: A64, a: A64, n: A64) -> Unit
  emit32_le(b, 0x9B008000 | (a64_code(a) << 16) | (a64_code(n) << 10) | (a64_code(m) << 5) | a64_code(d))
end

# CSEL Xd, Xn, Xm, cond (conditional select)
def a64_csel(b: &mut CodeBuffer, d: A64, n: A64, m: A64, cond: u32) -> Unit
  emit32_le(b, 0x9A800000 | (a64_code(m) << 16) | (cond << 12) | (a64_code(n) << 5) | a64_code(d))
end

# ADD Xd, Xn, Xm, LSL #shift (shifted register form)
def a64_add_rrr_lsl(b: &mut CodeBuffer, d: A64, n: A64, m: A64, shift: u32) -> Unit
  # shift amount in bits 22:21 for LSL, 0=LSL, 1=LSR, 2=ASR
  let imm6 = (shift & 0x3F) as u32
  emit32_le(b, 0x8B000000 | (imm6 << 10) | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# ASRV Xd, Xn, Xm (arithmetic shift right, variable)
def a64_asr_rrr(b: &mut CodeBuffer, d: A64, n: A64, m: A64) -> Unit
  emit32_le(b, 0x9AC02800 | (a64_code(m) << 16) | (a64_code(n) << 5) | a64_code(d))
end

# LDRB Wd, [Xn, #imm12] (load byte, zero-extend)
def a64_ldrb(b: &mut CodeBuffer, d: A64, base: A64, offset: u32) -> Unit
  emit32_le(b, 0x39400000 | ((offset & 0xFFF) << 10) | (a64_code(base) << 5) | a64_code(d))
end

# STRB Wd, [Xn, #imm12] (store byte)
def a64_strb(b: &mut CodeBuffer, src: A64, base: A64, offset: u32) -> Unit
  emit32_le(b, 0x39000000 | ((offset & 0xFFF) << 10) | (a64_code(base) << 5) | a64_code(src))
end

# LDRH Wd, [Xn, #imm12*2] (load halfword, zero-extend)
def a64_ldrh(b: &mut CodeBuffer, d: A64, base: A64, offset: u32) -> Unit
  let imm12 = (offset / 2) & 0xFFF
  emit32_le(b, 0x79400000 | (imm12 << 10) | (a64_code(base) << 5) | a64_code(d))
end

# STRH Wd, [Xn, #imm12*2] (store halfword)
def a64_strh(b: &mut CodeBuffer, src: A64, base: A64, offset: u32) -> Unit
  let imm12 = (offset / 2) & 0xFFF
  emit32_le(b, 0x79000000 | (imm12 << 10) | (a64_code(base) << 5) | a64_code(src))
end

# LDR Wd, [Xn, #imm12*4] (load 32-bit word)
def a64_ldr_w(b: &mut CodeBuffer, d: A64, base: A64, offset: u32) -> Unit
  let imm12 = (offset / 4) & 0xFFF
  emit32_le(b, 0xB9400000 | (imm12 << 10) | (a64_code(base) << 5) | a64_code(d))
end

# STR Wd, [Xn, #imm12*4] (store 32-bit word)
def a64_str_w(b: &mut CodeBuffer, src: A64, base: A64, offset: u32) -> Unit
  let imm12 = (offset / 4) & 0xFFF
  emit32_le(b, 0xB9000000 | (imm12 << 10) | (a64_code(base) << 5) | a64_code(src))
end

# ADRP Xd, label (PC-relative page address)
def a64_adrp(b: &mut CodeBuffer, d: A64, label: String) -> Unit
  add_fixup(b, FixupKind::Adrp21, label)
  emit32_le(b, 0x90000000 | a64_code(d))
end

# ADD Xd, Xn, #lo12(label) — lower 12 bits of a page-relative address
def a64_add_lo12(b: &mut CodeBuffer, d: A64, n: A64, label: String) -> Unit
  
  add_fixup(b, FixupKind::AddImm12, label)
  emit32_le(b, 0x91000000 | (a64_code(n) << 5) | a64_code(d))
end

# ARM64 condition codes
# EQ=0, NE=1, CS(=HS)=0b0010, CC(=LO)=0b0011,
# LT=0b1011, LE=0b1101, GT=0b1100, GE=0b1010
def a64_cc_eq() -> u32 = 0
def a64_cc_ne() -> u32 = 1
def a64_cc_cs() -> u32 = 2
def a64_cc_cc() -> u32 = 3
def a64_cc_lt() -> u32 = 11  # 0b1011
def a64_cc_le() -> u32 = 13  # 0b1101
def a64_cc_gt() -> u32 = 12  # 0b1100
def a64_cc_ge() -> u32 = 10  # 0b1010

# ———————————————————————————————————————————————————————————————
# ARM64 SIMD/FP Instructions (using V registers as Dn for double)
# ———————————————————————————————————————————————————————————————

# FMOV Dd, Dn  (copy FP register to FP register, double precision)
def a64_fmov_dd(b: &mut CodeBuffer, d: A64V, n: A64V) -> Unit
  emit32_le(b, 0x1E604000 | (a64v_code(n) << 5) | a64v_code(d))
end

# FMOV Dd, Xn  (general register to FP register, 64-bit)
def a64_fmov_dx(b: &mut CodeBuffer, d: A64V, n: A64) -> Unit
  emit32_le(b, 0x9E670000 | (a64_code(n) << 5) | a64v_code(d))
end

# FMOV Xd, Dn  (FP register to general register, 64-bit)
def a64_fmov_xd(b: &mut CodeBuffer, d: A64, n: A64V) -> Unit
  emit32_le(b, 0x9E660000 | (a64v_code(n) << 5) | a64_code(d))
end

# FADD Dd, Dn, Dm  (double-precision add)
def a64_fadd_ddd(b: &mut CodeBuffer, d: A64V, n: A64V, m: A64V) -> Unit
  emit32_le(b, 0x1E602800 | (a64v_code(m) << 16) | (a64v_code(n) << 5) | a64v_code(d))
end

# FSUB Dd, Dn, Dm  (double-precision subtract)
def a64_fsub_ddd(b: &mut CodeBuffer, d: A64V, n: A64V, m: A64V) -> Unit
  emit32_le(b, 0x1E603800 | (a64v_code(m) << 16) | (a64v_code(n) << 5) | a64v_code(d))
end

# FMUL Dd, Dn, Dm  (double-precision multiply)
def a64_fmul_ddd(b: &mut CodeBuffer, d: A64V, n: A64V, m: A64V) -> Unit
  emit32_le(b, 0x1E600800 | (a64v_code(m) << 16) | (a64v_code(n) << 5) | a64v_code(d))
end

# FDIV Dd, Dn, Dm  (double-precision divide)
def a64_fdiv_ddd(b: &mut CodeBuffer, d: A64V, n: A64V, m: A64V) -> Unit
  emit32_le(b, 0x1E601800 | (a64v_code(m) << 16) | (a64v_code(n) << 5) | a64v_code(d))
end

# FNEG Dd, Dn  (double-precision negate)
def a64_fneg_dd(b: &mut CodeBuffer, d: A64V, n: A64V) -> Unit
  emit32_le(b, 0x1E614000 | (a64v_code(n) << 5) | a64v_code(d))
end

# FCMP Dn, Dm  (compare two doubles, sets NZCV)
def a64_fcmp_dd(b: &mut CodeBuffer, n: A64V, m: A64V) -> Unit
  emit32_le(b, 0x1E602000 | (a64v_code(m) << 16) | (a64v_code(n) << 5))
end

# LDR Dt, [Xn, #imm12*8]  (load 64-bit FP from memory)
def a64_ldr_d(b: &mut CodeBuffer, d: A64V, base: A64, offset: u32) -> Unit
  let imm12 = (offset / 8) & 0xFFF
  emit32_le(b, 0xFD400000 | (imm12 << 10) | (a64_code(base) << 5) | a64v_code(d))
end

# STR Dt, [Xn, #imm12*8]  (store 64-bit FP to memory)
def a64_str_d(b: &mut CodeBuffer, src: A64V, base: A64, offset: u32) -> Unit
  let imm12 = (offset / 8) & 0xFFF
  emit32_le(b, 0xFD000000 | (imm12 << 10) | (a64_code(base) << 5) | a64v_code(src))
end

# LDUR Dt, [Xn, #simm9]  (unscaled offset load FP)
def a64_ldur_d(b: &mut CodeBuffer, d: A64V, base: A64, offset: i32) -> Unit
  let imm9 = (offset & 0x1FF) as u32
  emit32_le(b, 0xFC400000 | (imm9 << 12) | (a64_code(base) << 5) | a64v_code(d))
end

# STUR Dt, [Xn, #simm9]  (unscaled offset store FP)
def a64_stur_d(b: &mut CodeBuffer, src: A64V, base: A64, offset: i32) -> Unit
  let imm9 = (offset & 0x1FF) as u32
  emit32_le(b, 0xFC000000 | (imm9 << 12) | (a64_code(base) << 5) | a64v_code(src))
end

# SCVTF Dd, Xn  (signed int to double)
def a64_scvtf_dx(b: &mut CodeBuffer, d: A64V, n: A64) -> Unit
  emit32_le(b, 0x9E620000 | (a64_code(n) << 5) | a64v_code(d))
end

# FCVTZS Xd, Dn  (double to signed int, round toward zero)
def a64_fcvtzs_xd(b: &mut CodeBuffer, d: A64, n: A64V) -> Unit
  emit32_le(b, 0x9E780000 | (a64v_code(n) << 5) | a64_code(d))
end

# FSQRT Dd, Dn  (double square root)
def a64_fsqrt_dd(b: &mut CodeBuffer, d: A64V, n: A64V) -> Unit
  emit32_le(b, 0x1E61C000 | (a64v_code(n) << 5) | a64v_code(d))
end

# ———————————————————————————————————————————————————————————————
# x86-64 SSE2 Instructions (for float support)
# ———————————————————————————————————————————————————————————————

# SSE register encoding: XMM0=0, XMM1=1, ..., XMM15=15
# Mapped into PhysReg::X64Reg as indices 16..31

# MOVSD xmm_d, xmm_s  (F2 0F 10 /r)
def x64_movsd_rr(b: &mut CodeBuffer, d: u8, s: u8) -> Unit
  b.bytes.push(0xF2)
  if d >= 8 || s >= 8 then
    b.bytes.push(0x40 | ((d >> 3) << 2) | (s >> 3))
  end
  b.bytes.push(0x0F)
  b.bytes.push(0x10)
  b.bytes.push(0xC0 | ((d & 7) << 3) | (s & 7))
end

# MOVSD xmm, [base + disp32]  (F2 0F 10 /r)
def x64_movsd_load(b: &mut CodeBuffer, d: u8, base: X64, disp: i32) -> Unit
  b.bytes.push(0xF2)
  if d >= 8 || x64_hi(base) then
    b.bytes.push(rex(false, d >= 8, false, x64_hi(base)))
  end
  b.bytes.push(0x0F)
  b.bytes.push(0x10)
  let modrm = 0x80 | ((d & 7) << 3) | (x64_code(base) & 7)
  b.bytes.push(modrm)
  if x64_code(base) == 4 then b.bytes.push(0x24) end
  emit32_le(b, disp as u32)
end

# MOVSD [base + disp32], xmm  (F2 0F 11 /r)
def x64_movsd_store(b: &mut CodeBuffer, base: X64, disp: i32, s: u8) -> Unit
  b.bytes.push(0xF2)
  b.bytes.push(0x0F)
  b.bytes.push(0x11)
  let modrm = 0x80 | ((s & 7) << 3) | (x64_code(base) & 7)
  b.bytes.push(modrm)
  if x64_code(base) == 4 then b.bytes.push(0x24) end
  emit32_le(b, disp as u32)
end

# ADDSD xmm_d, xmm_s  (F2 0F 58 /r)
def x64_addsd(b: &mut CodeBuffer, d: u8, s: u8) -> Unit
  b.bytes.push(0xF2)
  b.bytes.push(0x0F)
  b.bytes.push(0x58)
  b.bytes.push(0xC0 | ((d & 7) << 3) | (s & 7))
end

# SUBSD xmm_d, xmm_s  (F2 0F 5C /r)
def x64_subsd(b: &mut CodeBuffer, d: u8, s: u8) -> Unit
  b.bytes.push(0xF2)
  b.bytes.push(0x0F)
  b.bytes.push(0x5C)
  b.bytes.push(0xC0 | ((d & 7) << 3) | (s & 7))
end

# MULSD xmm_d, xmm_s  (F2 0F 59 /r)
def x64_mulsd(b: &mut CodeBuffer, d: u8, s: u8) -> Unit
  b.bytes.push(0xF2)
  b.bytes.push(0x0F)
  b.bytes.push(0x59)
  b.bytes.push(0xC0 | ((d & 7) << 3) | (s & 7))
end

# DIVSD xmm_d, xmm_s  (F2 0F 5E /r)
def x64_divsd(b: &mut CodeBuffer, d: u8, s: u8) -> Unit
  b.bytes.push(0xF2)
  b.bytes.push(0x0F)
  b.bytes.push(0x5E)
  b.bytes.push(0xC0 | ((d & 7) << 3) | (s & 7))
end

# UCOMISD xmm, xmm  (66 0F 2E /r — sets EFLAGS from FP compare)
def x64_ucomisd(b: &mut CodeBuffer, a: u8, c: u8) -> Unit
  b.bytes.push(0x66)
  b.bytes.push(0x0F)
  b.bytes.push(0x2E)
  b.bytes.push(0xC0 | ((a & 7) << 3) | (c & 7))
end

# CVTSI2SD xmm, reg64  (F2 REX.W 0F 2A /r — int-to-double)
def x64_cvtsi2sd(b: &mut CodeBuffer, d: u8, src: X64) -> Unit
  b.bytes.push(0xF2)
  b.bytes.push(0x48 | ((d >> 3) << 2))
  b.bytes.push(0x0F)
  b.bytes.push(0x2A)
  b.bytes.push(0xC0 | ((d & 7) << 3) | (x64_code(src) & 7))
end

# CVTTSD2SI reg64, xmm  (F2 REX.W 0F 2C /r — double-to-int truncate)
def x64_cvttsd2si(b: &mut CodeBuffer, d: X64, src: u8) -> Unit
  b.bytes.push(0xF2)
  b.bytes.push(0x48 | ((x64_code(d) >> 3) << 2))
  b.bytes.push(0x0F)
  b.bytes.push(0x2C)
  b.bytes.push(0xC0 | ((x64_code(d) & 7) << 3) | (src & 7))
end

# ———————————————————————————————————————————————————————————————
# Target triple detection
# ———————————————————————————————————————————————————————————————

enum Arch
  X86_64
  AArch64
end

enum OsAbi
  Linux
  MacOS
  Windows
end

struct AsmTarget
  arch: Arch
  os: OsAbi
  pointer_size: Int   # always 8 for 64-bit
end

def asm_target(arch: Arch, os: OsAbi) -> AsmTarget
  AsmTarget { arch: arch, os: os, pointer_size: 8 }
end

def host_target() -> AsmTarget
  # Detect host target from environment or system
  # Check TG_HOST_TARGET env var first for override
  match std::env::get_env("TG_HOST_TARGET".to_string())
  when Option::Some(triple) then
    return parse_target_triple(triple)
  when Option::None then ()
  end

  match std::env::get_env("TARGET".to_string())
  when Option::Some(triple) then
    return parse_target_triple(triple)
  when Option::None then ()
  end

  match std::env::get_env("HOST".to_string())
  when Option::Some(triple) then
    return parse_target_triple(triple)
  when Option::None then ()
  end

  match std::env::get_env("MACHTYPE".to_string())
  when Option::Some(triple) then
    return parse_target_triple(triple)
  when Option::None then ()
  end
  
  # Try to detect from system info
  # On Unix-like systems, check uname
  let arch_str = match std::env::get_env("HOSTTYPE".to_string())
  when Option::Some(h) then h
  when Option::None then
    match std::env::get_env("PROCESSOR_ARCHITECTURE".to_string())
    when Option::Some(p) then p
    when Option::None then "unknown"
    end
  end
  
  let os_str = match std::env::get_env("OSTYPE".to_string())
  when Option::Some(o) then o
  when Option::None then
    # Try to infer from other env vars
    match std::env::get_env("OS".to_string())
    when Option::Some(w) then
      if w.contains("Windows") then "windows" else "unknown" end
    when Option::None then "unknown"
    end
  end
  
  # Parse detected values — fall back to aarch64-macos when detection fails
  # (common under interpreter or when env vars are missing/wrong)
  let arch = if arch_str.contains("x86_64") || arch_str.contains("amd64") || arch_str.contains("AMD64") then
    Arch::X86_64
  elsif arch_str.contains("aarch64") || arch_str.contains("arm64") then
    Arch::AArch64
  elsif arch_str == "unknown" then
    # Default to AArch64 on macOS when env detection fails
    eprintln("[host_target] warning: could not detect host arch, defaulting to aarch64")
    Arch::AArch64
  else
    panic("unsupported host architecture: " + arch_str.to_string())
  end
  
  let os = if os_str.contains("darwin") || os_str.contains("macos") then
    OsAbi::MacOS
  elsif os_str.contains("linux") then
    OsAbi::Linux
  elsif os_str.contains("windows") then
    OsAbi::Windows
  elsif os_str == "unknown" then
    # Default to macOS when env detection fails
    eprintln("[host_target] warning: could not detect host OS, defaulting to macos")
    OsAbi::MacOS
  else
    panic("unsupported host OS: " + os_str.to_string())
  end
  
  asm_target(arch, os)
end

def parse_target_triple(triple: String) -> AsmTarget
  # Parse strings like "x86_64-linux-gnu", "aarch64-macos", "x86_64-windows-msvc"
  let parts = triple.split("-")
  
  let arch = if parts.len() > 0 then
    let a = parts[0]
    if a == "x86_64" || a == "x86-64" || a == "amd64" then
      Arch::X86_64
    elsif a == "aarch64" || a == "arm64" then
      Arch::AArch64
    else
      panic("unsupported target architecture in triple: " + triple)
    end
  else
    panic("missing target architecture in triple: " + triple)
  end
  
  var os: Option[OsAbi] = Option::None
  var idx = 1
  while idx < parts.len() do
    let part = parts[idx]
    if part == "linux" || part == "gnu" || part == "musl" || part == "freebsd" then
      os = Option::Some(OsAbi::Linux)
      break
    elsif part == "macos" || part == "darwin" || part == "apple" then
      os = Option::Some(OsAbi::MacOS)
      break
    elsif part == "windows" || part == "win32" || part == "msvc" || part == "mingw" || part == "gnu" then
      os = Option::Some(OsAbi::Windows)
      break
    end
    idx = idx + 1
  end
  let os = match os
  when Option::Some(found) then found
  when Option::None then panic("unsupported target OS in triple: " + triple)
  end
  
  asm_target(arch, os)
end
