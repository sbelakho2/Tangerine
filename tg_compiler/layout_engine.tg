# tg_compiler/layout_engine.tg — Centralized Layout Engine
# SINGLE SOURCE OF TRUTH for all type layout queries.
# All compiler phases (interpreter, verifier, lowering, codegen, stdlib) must use this API.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use std::alloc::{Layout, FieldLayout, VariantLayout, EnumLayout}
use tg_compiler::types::{Type, TypeId}
use tg_compiler::mir::{MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef}

# ———————————————————————————————————————————————————————————————
# Failure Class Categorization
# ———————————————————————————————————————————————————————————————

# Every layout-related bug must be tagged as one of these categories.
# This prevents "memory offset" bugs from becoming one huge vague pile.
enum LayoutFailureClass
  # The central layout engine computed the wrong size/alignment/offset.
  LAYOUT_COMPUTATION_BUG
  
  # The layout engine is right, but lowering/codegen/runtime used it wrong.
  LAYOUT_CONSUMER_BUG
  
  # Heap object / fat pointer / closure / string / slice header layout is inconsistent.
  HEADER_MODEL_BUG
  
  # FFI or call lowering uses a different memory convention.
  ABI_BOUNDARY_BUG
  
  # Pointer size, endianness, alignment policy, or ABI rules are wrong for target.
  TARGET_DESCRIPTOR_BUG
  
  # The type is not resolved to a concrete type (Var, Error, generic param).
  UNRESOLVED_TYPE
  
  # The type has no supported concrete layout in the engine.
  UNSUPPORTED_TYPE
end

# Diagnostic error with failure class
struct LayoutError
  class: LayoutFailureClass
  message: String
  type_name: String
  expected: Int
  actual: Int
  context: String  # File:line or function name where error occurred
end

def layout_error_to_string(err: &LayoutError) -> String
  let class_str = match err.class
  when LayoutFailureClass::LAYOUT_COMPUTATION_BUG then "LAYOUT_COMPUTATION_BUG"
  when LayoutFailureClass::LAYOUT_CONSUMER_BUG then "LAYOUT_CONSUMER_BUG"
  when LayoutFailureClass::HEADER_MODEL_BUG then "HEADER_MODEL_BUG"
  when LayoutFailureClass::ABI_BOUNDARY_BUG then "ABI_BOUNDARY_BUG"
  when LayoutFailureClass::TARGET_DESCRIPTOR_BUG then "TARGET_DESCRIPTOR_BUG"
  when LayoutFailureClass::UNRESOLVED_TYPE then "UNRESOLVED_TYPE"
  when LayoutFailureClass::UNSUPPORTED_TYPE then "UNSUPPORTED_TYPE"
  end
  "[" + class_str + "] " + err.message + " for type '" + err.type_name + 
    "': expected " + err.expected.to_string() + ", got " + err.actual.to_string() +
    " at " + err.context
end

# ———————————————————————————————————————————————————————————————
# Canonical Layout Categories (Step 2)
# ———————————————————————————————————————————————————————————————

enum LayoutCategory
  # Fixed-width integer and float types
  Primitive
  # Pointer-width types (references, raw pointers, Box)
  Pointer
  # Fat pointer types (slices, trait objects)
  FatPointer
  # Inline aggregates (structs laid out field-by-field)
  InlineStruct
  # Discriminated unions (enums with tag + max_payload)
  TaggedUnion
  # Dynamically-sized containers (Vec, String, Map, Set)
  DynContainer
  # Zero-sized types (Unit, Never, zero-variant enums)
  ZeroSized
  # Function types (raw function pointers)
  FunctionType
end

# ———————————————————————————————————————————————————————————————
# P0-AR: Runtime Value Representation — THE DECISION TABLE
# ———————————————————————————————————————————————————————————————
# ONE place states how every fundamental type's runtime value is stored.
# Every layout query (size_of, align_of, layout_of, struct field placement,
# enum payload placement, tuple element placement, container header sizes)
# consults type_repr and NEVER re-decides the storage shape.
#
#   TYPE                                 | REPRESENTATION  | OWNS MEMORY | COPY OP
#   —————————————————————————————————————+—————————————————+—————————————+——————————
#   Int, UInt, Float, Char, Bool,         |                 |             |
#     I8..I128, U8..U128, ISize, USize,   |                 |             |
#     F32, F64, Unit, Never               | Immediate       | No          | bit
#   Ptr[T], PtrMut[T], RefInternal        | RawPtr          | No          | bit
#   Box[T], Rc[T]                         | RawPtr          | Yes         | move
#   String                                | StringPtr       | Yes         | clone
#   Vec[T], Array[T, 0]                   | HeapVecHeader   | Yes         | move + clone
#   Array[T, N] (N > 0)                   | Inline          | N elements  | structural
#   Slice[T]                              | HeapVecHeader   | No          | bit
#   Map[K,V]                              | HeapMapHeader   | Yes         | move + clone
#   Set[T]                                | HeapSetHeader   | Yes         | move + clone
#   struct                                | Inline          | fields      | structural
#   enum                                  | Inline (tagged) | variants    | structural
#   Option[T], Result[T,E], Dyn[T],       |                 |             |
#     Effect, Var, Param, unknown         | OpaquePtr       | payload     | move + clone
#   Function                              | OpaquePtr       | env: Yes    | move
#
# Heap header sizes (F2 FROZEN — must agree with codegen/runtime; the value
# itself is always ONE pointer-width handle, these are the sizes of the
# heap objects the handle points at):
#   StringPtr     -> 8   (raw pointer to null-terminated UTF-8; NO inline header)
#   HeapVecHeader -> 24  ({ptr:0, len:8, cap:16})
#   HeapMapHeader -> 48  ({buckets:0, len:8, cap:16, hash_fn:24})
#   HeapSetHeader -> 32  ({map:0, len:8})
#
#   Storage size rules derived from this table (repr_storage_size):
#   Immediate  -> the intrinsic primitive size (primitive_size)
#   RawPtr, StringPtr, Heap*, TaggedPtr -> target.pointer_size (8)
#   Inline     -> the full inline aggregate size (struct/enum/tuple/fixed array)
#   OpaquePtr  -> target.fn_ptr_size for Function, else target.pointer_size
#
# FIXED ARRAYS (P0-P): the Type::Array(elem, count) count decides the
# representation.  Array[T, N] with N > 0 is a fixed inline array; Array[T, 0]
# is the heap vector handle (Vec).  A positive count means N elements stored
# inline with the element's storage size and alignment
# (size = N * elem_stride, aligned to the element's alignment); count 0/absent
# (the heap-vector sentinel the codebase uses, e.g. the Vec alias) stays the
# pointer to a heap {ptr,len,cap} header (HeapVecHeader).
#
# (TaggedPtr is reserved: codegen's inline-tag shortcut for payload-less
# enums (< 256 discriminants stored as raw integers, >= 256 as heap
# pointers to the tagged-inline image described by F3) is an encoding
# optimization over the Inline (tagged) representation the engine computes.)

enum Repr
  Immediate      # value bits ARE the value (primitives, Unit, Never)
  RawPtr         # raw pointer to memory (Ptr/PtrMut/Box/Rc/RefInternal)
  StringPtr      # 8-byte raw pointer to null-terminated UTF-8 (FROZEN String ABI)
  HeapVecHeader  # pointer to a heap {ptr,len,cap} header (Vec/Array/Slice)
  HeapMapHeader  # pointer to a heap Map header
  HeapSetHeader  # pointer to a heap Set header
  Inline         # stored field-by-field inline (structs, tagged enums, tuples)
  TaggedPtr      # reserved: pointer with tag bits (not used by the engine today)
  OpaquePtr      # opaque pointer-sized handle (Option/Result/Dyn/Effect/Function/unknown)
end

# THE single decision function: the representation of a type's runtime
# value, per the DECIDED model documented above.  Every storage-shape
# decision in this engine reads from here.
def type_repr(engine: &LayoutEngine, ty: &Type) -> Repr
  match ty
  when Type::Unit    then Repr::Immediate
  when Type::Bool    then Repr::Immediate
  when Type::Int     then Repr::Immediate
  when Type::UInt    then Repr::Immediate
  when Type::Float   then Repr::Immediate
  when Type::Char    then Repr::Immediate
  when Type::Never   then Repr::Immediate
  when Type::I8      then Repr::Immediate
  when Type::I16     then Repr::Immediate
  when Type::I32     then Repr::Immediate
  when Type::I64     then Repr::Immediate
  when Type::I128    then Repr::Immediate
  when Type::U8      then Repr::Immediate
  when Type::U16     then Repr::Immediate
  when Type::U32     then Repr::Immediate
  when Type::U64     then Repr::Immediate
  when Type::U128    then Repr::Immediate
  when Type::ISize   then Repr::Immediate
  when Type::USize   then Repr::Immediate
  when Type::F32     then Repr::Immediate
  when Type::F64     then Repr::Immediate
  when Type::String  then Repr::StringPtr
  when Type::RefInternal(_, _) then Repr::RawPtr
  when Type::Ptr(_)        then Repr::RawPtr
  when Type::PtrMut(_)     then Repr::RawPtr
  when Type::Box(_)        then Repr::RawPtr
  when Type::Rc(_)         then Repr::RawPtr
  when Type::Slice(_)      then Repr::HeapVecHeader
  # Array[T, N] with N > 0 is a fixed inline array; Array[T, 0] is the heap
  # vector handle (Vec).  The count is the single discriminator: the fixed
  # form stores N elements inline with the element's storage size/alignment,
  # the heap form is a pointer to a {ptr,len,cap} header.
  when Type::Array(_, count) then
    if count > 0 then Repr::Inline else Repr::HeapVecHeader end
  when Type::Map(_, _)     then Repr::HeapMapHeader
  when Type::Set(_)        then Repr::HeapSetHeader
  when Type::Option(_)     then Repr::OpaquePtr
  when Type::Result(_, _)  then Repr::OpaquePtr
  when Type::Function(_, _) then Repr::OpaquePtr
  when Type::Dyn(_)        then Repr::OpaquePtr
  when Type::Effect(_, _)  then Repr::OpaquePtr
  when Type::Tuple(_)      then Repr::Inline
  when Type::Named(tid, _) then named_type_repr(engine, tid.id)
  when Type::Var(_)        then Repr::OpaquePtr
  when Type::Param(_)      then Repr::OpaquePtr
  when Type::Error         then Repr::OpaquePtr
  when _                   then Repr::OpaquePtr
  end
end

# F2 container name -> representation (mirror of container_header_size).
# The engine never sees "Vec"/"Array"/"Map"/"Set"/"String" as registered
# struct definitions (Vec[T] lowers to Type::Array, Map/Set are Type
# variants), but the name keys are the frozen F2 ABI table and keep the
# header sizes in the decision table.
def container_repr_for_name(type_name: &String) -> Repr
  if type_name == "String" then Repr::StringPtr
  else if type_name == "Vec" || type_name == "Array" then Repr::HeapVecHeader
  else if type_name == "Map" || type_name == "HashMap" then Repr::HeapMapHeader
  else if type_name == "Set" || type_name == "HashSet" then Repr::HeapSetHeader
  else Repr::OpaquePtr
  end
end

# Representation of a registered named type (struct/enum).  Container names
# win over the definition kind: a Named "Vec" is a compiler intrinsic whose
# value is a heap header handle, never an inline aggregate.
def named_type_repr(engine: &LayoutEngine, type_id: Int) -> Repr
  let name = lookup_type_name(engine, type_id)
  let container_repr = container_repr_for_name(&name)
  if container_repr != Repr::OpaquePtr then
    return container_repr
  end

  # Registered definitions: structs and enums are stored inline (F7/F3).
  for td in engine.type_defs do
    if td.id.id == type_id then
      match td.kind
      when MirTypeDefKind::Struct(_) then return Repr::Inline
      when MirTypeDefKind::Enum(_)   then return Repr::Inline
      end
    end
  end

  # Unregistered (generic-parameter placeholder, unknown): opaque handle.
  Repr::OpaquePtr
end

# Heap header size for a representation (F2 FROZEN; 0 = no heap header).
def repr_header_size(repr: Repr) -> Int
  match repr
  when Repr::StringPtr     then 8
  when Repr::HeapVecHeader then 24
  when Repr::HeapMapHeader then 48
  when Repr::HeapSetHeader then 32
  when _                   then 0
  end
end

# The byte size a value of `ty` occupies in a storage slot (struct field,
# enum payload field, tuple element, or any slot that holds the value).
# This is the ONE storage decision for every aggregate placement; it
# consults type_repr and never re-decides the storage shape.
def repr_storage_size(engine: &mut LayoutEngine, ty: &Type) -> Int
  match type_repr(engine, ty)
  when Repr::Immediate then
    # Intrinsic sizes (primitive_size).  String is NOT here: it is
    # StringPtr, whose slot size is one pointer.
    let ps = primitive_size(engine, ty)
    if ps >= 0 then ps else 0 end
  when Repr::Inline then
    inline_storage_size(engine, ty)
  when Repr::RawPtr      then engine.target.pointer_size
  when Repr::StringPtr   then engine.target.pointer_size
  when Repr::HeapVecHeader then engine.target.pointer_size
  when Repr::HeapMapHeader then engine.target.pointer_size
  when Repr::HeapSetHeader then engine.target.pointer_size
  when Repr::TaggedPtr   then engine.target.pointer_size
  when Repr::OpaquePtr   then
    match ty
    when Type::Function(_, _) then engine.target.fn_ptr_size
    when _ then engine.target.pointer_size
    end
  end
end

# Alignment counterpart of repr_storage_size: the alignment a slot holding
# a value of `ty` must have.
def repr_storage_align(engine: &mut LayoutEngine, ty: &Type) -> Int
  match type_repr(engine, ty)
  when Repr::Immediate then primitive_align(engine, ty)
  when Repr::Inline then
    match ty
    when Type::Named(tid, _) then compute_type_layout(engine, tid.id).align
    when Type::Tuple(fields) then compute_tuple_layout(engine, fields).align
    when Type::Array(elem, _) then repr_storage_align(engine, elem)
    when _ then engine.target.pointer_align
    end
  when _ then engine.target.pointer_align
  end
end

# Fixed inline array (P0-P): Array[T, N] with N > 0 stores N elements inline.
# The element stride is the element's storage size rounded up to its
# alignment; the array's total size is N * stride, aligned to the element's
# alignment.  Count 0 is the heap-vector sentinel and never reaches here
# (type_repr maps it to HeapVecHeader), but is defended anyway.
def inline_array_storage_size(engine: &mut LayoutEngine, elem: &Type, count: Int) -> Int
  if count <= 0 then 0
  else
    let elem_size = repr_storage_size(engine, elem)
    let elem_align = repr_storage_align(engine, elem)
    let elem_stride = layout_align_up(elem_size, elem_align)
    layout_align_up(count * elem_stride, elem_align)
  end
end

# Full inline size of an aggregate: the real layout of a named struct/enum
# (computed on the spot, NEVER a placeholder record — placeholder reads
# during compute_all_layouts would silently report size 0) or of a tuple.
def inline_storage_size(engine: &mut LayoutEngine, ty: &Type) -> Int
  match ty
  when Type::Named(tid, _) then
    compute_type_layout(engine, tid.id).size
  when Type::Tuple(fields) then
    compute_tuple_layout(engine, fields).size
  when Type::Array(elem, count) then
    inline_array_storage_size(engine, elem, count)
  when _ then 0
  end
end

# DFS visit state for the inline layout graph.  A type that reaches itself
# through inline storage only (no pointer/Box indirection) has no finite
# layout and is diagnosed as an infinitely sized recursive type.
enum LayoutVisitState
  Unvisited
  Visiting
  Resolved
end

# ———————————————————————————————————————————————————————————————
# Layout Record (Step 3)
# ———————————————————————————————————————————————————————————————





struct LayoutRecord
  type_id: Int
  name: String
  category: LayoutCategory
  repr: Repr                # Runtime value representation (P0-AR decision table)
  size: Int              # Total size in bytes
  align: Int             # Required alignment in bytes
  stride: Int            # Distance between consecutive elements (>= size, multiple of align)
  field_count: Int       # Number of fields
  
  # Detailed field layouts (for structs)
  fields: Vec[FieldLayout]
  
  # Variant layouts (for enums)
  variants: Vec[VariantLayout]
  
  # Tag info (for enums)
  tag_offset: Int        # Offset of discriminant tag (0 for all enums)
  tag_size: Int          # Size of tag (8 bytes)
  
  # Header info (for heap objects)
  header_size: Int       # 0 for non-heap types
  payload_offset: Int    # Offset of payload from heap object base
  
  # Hash for caching
  hash: Int
end

# ———————————————————————————————————————————————————————————————
# Unified ABI Layout (Single ABI Authority)
# ———————————————————————————————————————————————————————————————

# The canonical result of every layout query.  ABI consumers (codegen,
# lowering, runtime glue) must derive size/alignment/stride/field placement
# and enum tagging from a single Layout value instead of reconstructing
# offsets with ad-hoc `* 8` arithmetic.  This makes the layout engine the
# single authority for the machine-level ABI.

# Discriminated-union (enum) tagging info.




# ———————————————————————————————————————————————————————————————
# Target Layout Descriptor (Step 1)
# ———————————————————————————————————————————————————————————————

struct TargetDescriptor
  arch_name: String        # "aarch64" or "x86_64"
  pointer_size: Int        # 8 for LP64
  pointer_align: Int       # 8 for LP64
  max_align: Int           # Maximum natural alignment
  int_size: Int            # 8 for LP64
  bool_size: Int           # 1 (memory representation)
  char_size: Int           # 4 (Unicode scalar)
  fn_ptr_size: Int         # 16 (Tangerine closure: code ptr + env ptr)
  float_size: Int          # 8 (f64)
  double_size: Int         # 8 (f64, same as float)
  endianness: String       # "little" or "big"
  stack_align: Int         # Stack alignment (16)
end

# Pre-defined target descriptors
def aarch64_target() -> TargetDescriptor
  TargetDescriptor {
    arch_name: "aarch64",
    pointer_size: 8,
    pointer_align: 8,
    max_align: 16,
    int_size: 8,
    bool_size: 1,
    char_size: 4,
    fn_ptr_size: 16,
    float_size: 8,
    double_size: 8,
    endianness: "little",
    stack_align: 16
  }
end

def x86_64_target() -> TargetDescriptor
  TargetDescriptor {
    arch_name: "x86_64",
    pointer_size: 8,
    pointer_align: 8,
    max_align: 16,
    int_size: 8,
    bool_size: 1,
    char_size: 4,
    fn_ptr_size: 16,
    float_size: 8,
    double_size: 8,
    endianness: "little",
    stack_align: 16
  }
end

# ———————————————————————————————————————————————————————————————
# Centralized Layout Engine (Requirement 2 + Step 3)
# ———————————————————————————————————————————————————————————————

struct LayoutEngine
  target: TargetDescriptor
  records: Map[Int, LayoutRecord]      # type_id -> LayoutRecord
  name_index: Map[String, Int]          # type_name -> type_id
  type_defs: Vec[MirTypeDef]            # All type definitions
  visit_states: Map[Int, LayoutVisitState]   # Inline-cycle DFS states (compute_all_layouts)
  strict_states: Map[Int, LayoutVisitState]  # Recursive strict-verification cache (layout_of_concrete)
  cache_hits: Int
  cache_misses: Int
end

# Create a new layout engine for a target
def layout_engine_new(target: TargetDescriptor) -> LayoutEngine
  LayoutEngine {
    target: target,
    records: Map::new(),
    name_index: Map::new(),
    type_defs: Vec::new(),
    visit_states: Map::new(),
    strict_states: Map::new(),
    cache_hits: 0,
    cache_misses: 0
  }
end

# Register type definitions (call before computing layouts)
def layout_engine_register_types(engine: &mut LayoutEngine, types: &Vec[MirTypeDef]) -> Unit
  engine.type_defs = types.clone()
  for td in types do
    engine.name_index.insert(td.name.clone(), td.id.id)
  end
end

# ———————————————————————————————————————————————————————————————
# Primitive Type Sizes (F1 - Frozen)
# ———————————————————————————————————————————————————————————————
# NOTE: String is deliberately NOT in this table. Its 8-byte size is the
# StringPtr representation (see type_repr / container_repr_for_name), not
# an Immediate primitive: a String value is an 8-byte raw pointer to a
# null-terminated UTF-8 buffer (FROZEN String ABI).

def primitive_size(engine: &LayoutEngine, ty: &Type) -> Int
  match ty
  when Type::Unit    then 0
  when Type::Bool    then engine.target.bool_size
  when Type::Char    then engine.target.char_size
  when Type::Int     then engine.target.int_size
  when Type::UInt    then engine.target.int_size
  when Type::Float   then engine.target.float_size
  when Type::F32     then 4
  when Type::F64     then 8
  when Type::I8      then 1
  when Type::U8      then 1
  when Type::I16     then 2
  when Type::U16     then 2
  when Type::I32     then 4
  when Type::U32     then 4
  when Type::I64     then 8
  when Type::U64     then 8
  when Type::I128    then 16
  when Type::U128    then 16
  when Type::ISize   then engine.target.pointer_size
  when Type::USize   then engine.target.pointer_size
  when Type::Never   then 0
  when _             then -1   # Not a primitive
  end
end

def primitive_align(engine: &LayoutEngine, ty: &Type) -> Int
  match ty
  when Type::Unit    then 1
  when Type::Bool    then 1
  when Type::Char    then 4
  when Type::I8      then 1
  when Type::U8      then 1
  when Type::I16     then 2
  when Type::U16     then 2
  when Type::I32     then 4
  when Type::U32     then 4
  when Type::F32     then 4
  when Type::I64     then 8
  when Type::U64     then 8
  when Type::F64     then 8
  when Type::I128    then 16
  when Type::U128    then 16
  when Type::ISize   then engine.target.pointer_align
  when Type::USize   then engine.target.pointer_align
  when _             then engine.target.pointer_align  # Default to pointer alignment
  end
end

# ———————————————————————————————————————————————————————————————
# Layout Computation Core
# ———————————————————————————————————————————————————————————————

# Align value up to alignment boundary.
# Kept module-unique to avoid collisions with other tg_compiler helpers during bootstrap MIR merge.
def layout_align_up(value: Int, align: Int) -> Int
  if align <= 1 then
    return value
  end
  let rem = value % align
  if rem == 0 then value else value + (align - rem) end
end

# Compute hash for a layout record (for caching)
def compute_layout_hash(name: &String, size: Int, align: Int, field_count: Int) -> Int
  # Simple hash using Int to avoid interpreter UInt64 issues
  var h: Int = 5381
  let name_len = name.len()
  var idx = 0
  while idx < name_len do
    h = ((h * 33) + (name.char_at(idx) as Int)) % 2147483647
    idx = idx + 1
  end
  h = ((h * 33) + size) % 2147483647
  h = ((h * 33) + align) % 2147483647
  h = ((h * 33) + field_count) % 2147483647
  h
end

# Get the size of a type (main entry point)
# Every storage-shape decision is delegated to type_repr (the P0-AR
# decision table); no branch re-decides the representation here.
def size_of(engine: &mut LayoutEngine, ty: &Type) -> Int
  # Error is a recovery sentinel with no runtime value (never materialized);
  # the strict path (check_concrete_layout) rejects it before codegen.
  match ty
  when Type::Error then
    return 0
  when _ then ()
  end

  match type_repr(engine, ty)
  when Repr::Immediate then
    let prim_size = primitive_size(engine, ty)
    if prim_size >= 0 then
      prim_size
    else
      0
    end
  when Repr::Inline then
    match ty
    when Type::Named(tid, _) then
      # Look up cached record
      let tid_key = tid.id
      match engine.records.get(&tid_key)
      when Option::Some(rec) then
        engine.cache_hits = engine.cache_hits + 1
        rec.size
      when Option::None then
        engine.cache_misses = engine.cache_misses + 1
        # Compute and cache
        let rec = compute_type_layout(engine, tid_key)
        rec.size
      end
    when Type::Tuple(fields) then
      let tl = compute_tuple_layout(engine, fields)
      tl.size
    when Type::Array(elem, count) then
      inline_array_storage_size(engine, elem, count)
    when _ then 0
    end
  when Repr::RawPtr      then engine.target.pointer_size
  when Repr::StringPtr   then engine.target.pointer_size
  when Repr::HeapVecHeader then engine.target.pointer_size
  when Repr::HeapMapHeader then engine.target.pointer_size
  when Repr::HeapSetHeader then engine.target.pointer_size
  when Repr::TaggedPtr   then engine.target.pointer_size
  when Repr::OpaquePtr   then
    match ty
    when Type::Function(_, _) then engine.target.fn_ptr_size
    when _ then engine.target.pointer_size
    end
  end
end

# Get the alignment of a type
# Delegates to type_repr (P0-AR decision table), never re-deciding.
def align_of(engine: &mut LayoutEngine, ty: &Type) -> Int
  match type_repr(engine, ty)
  when Repr::Immediate then
    # Primitive intrinsic alignments.  This intentionally returns
    # pointer_align for Never (8), preserving the pre-existing value.
    primitive_align(engine, ty)
  when Repr::Inline then
    match ty
    when Type::Tuple(fields) then
      let tl = compute_tuple_layout(engine, fields)
      tl.align
    when Type::Named(tid, _) then
      let tid_key = tid.id
      match engine.records.get(&tid_key)
      when Option::Some(rec) then rec.align
      when Option::None then engine.target.pointer_align
      end
    when Type::Array(elem, _) then
      repr_storage_align(engine, elem)
    when _ then engine.target.pointer_align
    end
  when _ then engine.target.pointer_align
  end
end

# Get the stride of a type (distance between array elements)
def stride_of(engine: &mut LayoutEngine, ty: &Type) -> Int
  let sz = size_of(engine, ty)
  let al = align_of(engine, ty)
  layout_align_up(sz, al)
end

# ———————————————————————————————————————————————————————————————
# Unified Layout Query (Single ABI Authority)
# ———————————————————————————————————————————————————————————————

# Return a complete Layout for a type.  This is the canonical ABI query:
# consumers should use layout_of instead of reconstructing size/align/
# stride/field offsets independently.  Storage shapes come from type_repr
# (P0-AR decision table); no branch re-decides the representation.
def layout_of(engine: &mut LayoutEngine, ty: &Type) -> Layout
  match type_repr(engine, ty)
  when Repr::Immediate then
    let prim_size = primitive_size(engine, ty)
    if prim_size >= 0 then
      let psize = prim_size
      let palign = primitive_align(engine, ty)
      Layout {
        size: psize,
        align: palign,
        stride: layout_align_up(psize, palign),
        fields: Vec::new(),
        enum_layout: Option::None
      }
    else
      # No Immediate type is outside primitive_size (Unit/Never included);
      # defensive fallback.
      pointer_layout(engine)
    end
  when Repr::Inline then
    match ty
    when Type::Tuple(fields) then tuple_layout(engine, fields)
    when Type::Named(tid, _) then
      let rec = compute_type_layout(engine, tid.id)
      record_to_layout(&rec)
    when Type::Array(elem, count) then
      let sz = inline_array_storage_size(engine, elem, count)
      let al = repr_storage_align(engine, elem)
      Layout {
        size: sz,
        align: al,
        stride: layout_align_up(sz, al),
        fields: Vec::new(),
        enum_layout: Option::None
      }
    when _ then pointer_layout(engine)
    end
  when Repr::RawPtr      then pointer_layout(engine)
  when Repr::StringPtr   then pointer_layout(engine)
  when Repr::HeapVecHeader then pointer_layout(engine)
  when Repr::HeapMapHeader then pointer_layout(engine)
  when Repr::HeapSetHeader then pointer_layout(engine)
  when Repr::TaggedPtr   then pointer_layout(engine)
  when Repr::OpaquePtr   then
    match ty
    when Type::Function(_, _) then fn_ptr_layout(engine)
    when _ then pointer_layout(engine)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Recursive Strict Concrete-Layout Verification (P0-AS)
# ———————————————————————————————————————————————————————————————
# The general size_of keeps its fallbacks (Var -> pointer size, Error -> 0,
# `when _` -> pointer size) for non-strict callers.  The strict path must
# NEVER let an unresolved inline child fall back to a guess: it recursively
# proves that a type and all of its inline children have concrete layouts.
#
# Inline children are named types stored by value (struct fields, enum
# payloads, tuple elements).  Indirections — pointers (Ptr/PtrMut/Ref),
# Box/Rc, slices, arrays and heap containers (Option/Result/Map/Set/
# Function/String) — are opaque pointer-sized handles and do not require
# their pointee to be resolved.  A named type with no registered definition
# is likewise an opaque handle (lowering emits TypeId{id:0} for generic
# parameters), so it does not fail the strict check.

def check_concrete_layout(engine: &mut LayoutEngine, ty: &Type) -> Result[Unit, LayoutError]
  match ty
  when Type::Var(_) then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Type variable has no concrete layout",
      type_name: "Type::Var",
      expected: 0,
      actual: 0,
      context: "check_concrete_layout"
    })
  when Type::Error then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Error type has no concrete layout",
      type_name: "Type::Error",
      expected: 0,
      actual: 0,
      context: "check_concrete_layout"
    })
  when Type::Param(name) then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Generic parameter has no concrete layout",
      type_name: "Type::Param(" + name + ")",
      expected: 0,
      actual: 0,
      context: "check_concrete_layout"
    })
  when Type::Named(tid, _) then
    if engine_has_type_def(engine, tid.id) then
      let state = match engine.strict_states.get(&tid.id)
      when Option::Some(s) then s
      when Option::None then LayoutVisitState::Unvisited
      end
      match state
      when LayoutVisitState::Visiting then
        # Reached through inline storage only: infinitely sized recursive type.
        Result::Err(LayoutError {
          class: LayoutFailureClass::UNSUPPORTED_TYPE,
          message: "Infinitely sized recursive type: reaches itself through inline storage without an indirection",
          type_name: lookup_type_name(engine, tid.id),
          expected: 0,
          actual: 0,
          context: "check_concrete_layout"
        })
      when LayoutVisitState::Resolved then
        Result::Ok(())
      when LayoutVisitState::Unvisited then
        engine.strict_states.insert(tid.id, LayoutVisitState::Visiting)
        # Prove every inline child of the definition recursively.
        for td in engine.type_defs do
          if td.id.id == tid.id then
            match td.kind
            when MirTypeDefKind::Struct(fields) then
              for f in fields do
                match check_concrete_layout(engine, &f.ty)
                when Result::Err(e) then
                  engine.strict_states.insert(tid.id, LayoutVisitState::Unvisited)
                  return Result::Err(e)
                when Result::Ok(()) then ()
                end
              end
            when MirTypeDefKind::Enum(variants) then
              for v in variants do
                for fty in v.fields do
                  match check_concrete_layout(engine, fty)
                  when Result::Err(e) then
                    engine.strict_states.insert(tid.id, LayoutVisitState::Unvisited)
                    return Result::Err(e)
                  when Result::Ok(()) then ()
                  end
                end
              end
            end
          end
        end
        engine.strict_states.insert(tid.id, LayoutVisitState::Resolved)
        Result::Ok(())
      end
    else
      # Unregistered named type: opaque pointer-sized handle (generic
      # parameter lowering emits TypeId{id:0}); its layout is the handle.
      Result::Ok(())
    end
  when Type::Tuple(fields) then
    # Inline aggregate: every element must be concrete.
    for f in fields do
      match check_concrete_layout(engine, f)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(()) then ()
      end
    end
    Result::Ok(())
  when Type::Array(elem, count) then
    # Fixed inline array (count > 0): the element is stored inline N times,
    # so it must be concrete.  Count 0 is the heap-vector handle (Vec): an
    # opaque pointer-sized handle, concrete without inspecting the pointee.
    if count > 0 then
      check_concrete_layout(engine, elem)
    else
      Result::Ok(())
    end
  when _ then
    # Primitives, pointers, Box/Rc, slices, heap containers, function types:
    # fixed-size or opaque handle — concrete without inspecting the pointee.
    Result::Ok(())
  end
end

# Strict concrete layout query: returns Err instead of guessing pointer sizes
# for unresolved types (Var, Error, generic params), unknown named types, and
# types with unresolved INLINE children.  The failure propagates to callers
# (codegen's layout_of_strict panics with the LayoutError's type_name).
def layout_of_concrete(engine: &mut LayoutEngine, ty: &Type) -> Result[Layout, LayoutError]
  match ty
  when Type::Var(_) then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Type variable has no concrete layout",
      type_name: "Type::Var",
      expected: 0,
      actual: 0,
      context: "layout_of_concrete"
    })
  when Type::Error then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Error type has no concrete layout",
      type_name: "Type::Error",
      expected: 0,
      actual: 0,
      context: "layout_of_concrete"
    })
  when Type::Param(name) then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Generic parameter has no concrete layout",
      type_name: "Type::Param(" + name + ")",
      expected: 0,
      actual: 0,
      context: "layout_of_concrete"
    })
  when Type::Named(tid, _) then
    if engine_has_type_def(engine, tid.id) then
      # Recursively strict: an unresolved inline child (Var/Error/Param) or an
      # inline storage cycle must fail here instead of falling back to a
      # pointer-sized guess.
      match check_concrete_layout(engine, ty)
      when Result::Ok(()) then Result::Ok(layout_of(engine, ty))
      when Result::Err(e) then Result::Err(e)
      end
    else
      Result::Err(LayoutError {
        class: LayoutFailureClass::UNSUPPORTED_TYPE,
        message: "No type definition registered for type id",
        type_name: "type#" + tid.id.to_string(),
        expected: 0,
        actual: 0,
        context: "layout_of_concrete"
      })
    end
  when Type::Tuple(_) then
    match check_concrete_layout(engine, ty)
    when Result::Ok(()) then Result::Ok(layout_of(engine, ty))
    when Result::Err(e) then Result::Err(e)
    end
  when _ then
    Result::Ok(layout_of(engine, ty))
  end
end

def engine_has_type_def(engine: &LayoutEngine, type_id: Int) -> Bool
  for td in engine.type_defs do
    if td.id.id == type_id then
      return true
    end
  end
  false
end

def pointer_layout(engine: &LayoutEngine) -> Layout
  let s = engine.target.pointer_size
  Layout { size: s, align: engine.target.pointer_align, stride: s, fields: Vec::new(), enum_layout: Option::None }
end

def fn_ptr_layout(engine: &LayoutEngine) -> Layout
  let s = engine.target.fn_ptr_size
  Layout { size: s, align: engine.target.pointer_align, stride: s, fields: Vec::new(), enum_layout: Option::None }
end

def record_to_layout(rec: &LayoutRecord) -> Layout
  let enum_info = if rec.category == LayoutCategory::TaggedUnion then
    Option::Some(EnumLayout {
      tag_offset: rec.tag_offset,
      tag_size: rec.tag_size,
      payload_offset: rec.payload_offset,
      variants: rec.variants.clone()
    })
  else
    Option::None
  end
  Layout {
    size: rec.size,
    align: rec.align,
    stride: rec.stride,
    fields: rec.fields.clone(),
    enum_layout: enum_info
  }
end

def tuple_layout(engine: &mut LayoutEngine, fields: &Vec[Type]) -> Layout
  let tl = compute_tuple_layout(engine, fields)
  var field_layouts = Vec::new()
  var i = 0
  for fty in fields do
    # Field metadata mirrors the placement table (repr_storage_*), so the
    # reported size/align always agree with the computed offsets.
    let fsize = repr_storage_size(engine, fty)
    let falign = repr_storage_align(engine, fty)
    let off = if i < tl.field_offsets.len() then tl.field_offsets[i] else 0 end
    field_layouts.push(FieldLayout {
      name: i.to_string(),
      offset: off,
      size: fsize,
      align: falign,
      type_id: extract_type_id(fty)
    })
    i = i + 1
  end
  Layout {
    size: tl.size,
    align: tl.align,
    stride: tl.size,
    fields: field_layouts,
    enum_layout: Option::None
  }
end

# ———————————————————————————————————————————————————————————————
# Tuple Layout Computation
# ———————————————————————————————————————————————————————————————

struct TupleLayout
  size: Int
  align: Int
  field_offsets: Vec[Int]
end

def compute_tuple_layout(engine: &mut LayoutEngine, fields: &Vec[Type]) -> TupleLayout
  var offsets = Vec::new()
  var current_offset = 0
  var max_align = 1
  
  # Tuples are inline aggregates: element placement comes from the SAME
  # decision table as struct/enum field placement (repr_storage_size/align).
  # This is also placeholder-safe during compute_all_layouts: Inline named
  # elements compute their real layout instead of reading a placeholder.
  for f in fields do
    let f_align = repr_storage_align(engine, f)
    let f_size = repr_storage_size(engine, f)
    
    if f_align > max_align then
      max_align = f_align
    end
    
    # Align field
    current_offset = layout_align_up(current_offset, f_align)
    offsets.push(current_offset)
    current_offset = current_offset + f_size
  end
  
  # Final alignment
  let total_size = layout_align_up(current_offset, max_align)
  
  TupleLayout {
    size: total_size,
    align: max_align,
    field_offsets: offsets
  }
end

# Struct/enum payload fields are slots sized by the SAME decision table as
# every other placement (type_repr), never by an ad-hoc "everything
# non-primitive is a pointer slot" rule.
def struct_field_storage_align(engine: &mut LayoutEngine, ty: &Type) -> Int
  repr_storage_align(engine, ty)
end

def struct_field_storage_size(engine: &mut LayoutEngine, ty: &Type) -> Int
  repr_storage_size(engine, ty)
end

# ———————————————————————————————————————————————————————————————
# Struct Layout Computation (F7 - declaration order, no reordering)
# ———————————————————————————————————————————————————————————————

def compute_struct_layout(engine: &mut LayoutEngine, type_id: Int, fields: &Vec[MirFieldDef]) -> LayoutRecord
  var field_layouts = Vec::new()
  var current_offset = 0
  var max_align = 1

  var field_idx = 0
  while field_idx < fields.len() do
    let f = fields[field_idx]
    let f_size = struct_field_storage_size(engine, &f.ty)
    let f_align = struct_field_storage_align(engine, &f.ty)
    
    if f_align > max_align then
      max_align = f_align
    end
    
    # Align field (F7: fields in declaration order, no reordering)
    current_offset = layout_align_up(current_offset, f_align)
    
    field_layouts.push(FieldLayout {
      name: f.name.clone(),
      offset: current_offset,
      size: f_size,
      align: f_align,
      type_id: extract_type_id(&f.ty)
    })
    
    current_offset = current_offset + f_size
    field_idx = field_idx + 1
  end
  
  let total_size = layout_align_up(current_offset, max_align)
  let type_name = lookup_type_name(engine, type_id)
  let hash = compute_layout_hash(&type_name, total_size, max_align, fields.len())
  
  LayoutRecord {
    type_id: type_id,
    name: type_name,
    category: LayoutCategory::InlineStruct,
    repr: Repr::Inline,
    size: total_size,
    align: max_align,
    stride: total_size,
    field_count: fields.len(),
    fields: field_layouts,
    variants: Vec::new(),
    tag_offset: 0,
    tag_size: 0,
    header_size: 0,
    payload_offset: 0,
    hash: hash
  }
end

# ———————————————————————————————————————————————————————————————
# Enum Layout Computation (F3 - tag at 0, payload at 8)
# ———————————————————————————————————————————————————————————————

def compute_enum_layout(engine: &mut LayoutEngine, type_id: Int, variants: &Vec[MirVariantDef]) -> LayoutRecord
  var variant_layouts = Vec::new()
  var max_payload_size = 0
  var max_align = 8  # Tag alignment

  var variant_idx = 0
  while variant_idx < variants.len() do
    let v = variants[variant_idx]
    var payload_offset = 8  # F3: payload starts at offset 8
    var payload_size = 0
    var field_layouts = Vec::new()

    var payload_field_idx = 0
    while payload_field_idx < v.fields.len() do
      let fty = v.fields[payload_field_idx]
      # Enum payload slots are sized by the SAME decision table as every
      # other placement (type_repr via repr_storage_size/align): primitives
      # are Immediate, containers/pointers/String are pointer-width, nested
      # structs/enums are Inline.  Inline children are computed directly
      # (compute_type_layout), never read from a placeholder record, so the
      # dependency-order bug of the old uniform-8-byte-slot rule cannot
      # recur: a later type's layout is computed on the spot.
      let f_size = repr_storage_size(engine, fty)
      let f_align = repr_storage_align(engine, fty)

      if f_align > max_align then
        max_align = f_align
      end

      payload_offset = layout_align_up(payload_offset, f_align)
      
      field_layouts.push(FieldLayout {
        name: "",
        offset: payload_offset,
        size: f_size,
        align: f_align,
        type_id: extract_type_id(fty)
      })
      
      payload_offset = payload_offset + f_size
      payload_size = payload_size + f_size
      payload_field_idx = payload_field_idx + 1
    end
    
    if payload_size > max_payload_size then
      max_payload_size = payload_size
    end
    
    variant_layouts.push(VariantLayout {
      name: v.name.clone(),
      discriminant: v.discriminant,
      payload_offset: 8,
      payload_size: payload_size,
      fields: field_layouts
    })
    variant_idx = variant_idx + 1
  end
  
  # Total size: tag (8 bytes) + max_payload (aligned)
  let payload_total = layout_align_up(max_payload_size, max_align)
  let total_size = layout_align_up(8 + payload_total, max_align)
  
  let type_name = lookup_type_name(engine, type_id)
  let hash = compute_layout_hash(&type_name, total_size, max_align, variants.len())
  
  LayoutRecord {
    type_id: type_id,
    name: type_name,
    category: LayoutCategory::TaggedUnion,
    repr: Repr::Inline,
    size: total_size,
    align: max_align,
    stride: total_size,
    field_count: variants.len(),
    fields: Vec::new(),
    variants: variant_layouts,
    tag_offset: 0,      # F3: tag at offset 0
    tag_size: 8,        # F3: tag is 8 bytes
    header_size: 0,
    payload_offset: 8,  # F3: payload at offset 8
    hash: hash
  }
end

# ———————————————————————————————————————————————————————————————
# Type Layout Computation Dispatcher
# ———————————————————————————————————————————————————————————————

def compute_type_layout(engine: &mut LayoutEngine, type_id: Int) -> LayoutRecord
  # Inline-cycle guard (P0-AT): re-entering a type whose layout is still being
  # computed means it reaches itself through inline storage only (no pointer/
  # Box indirection) — an infinitely sized recursive type, diagnosed here.
  let visit_state = match engine.visit_states.get(&type_id)
  when Option::Some(s) then s
  when Option::None then LayoutVisitState::Unvisited
  end
  match visit_state
  when LayoutVisitState::Visiting then
    panic("layout: infinitely sized recursive type '" + lookup_type_name(engine, type_id) + "': inline storage cycle (use a pointer or Box to break the cycle)")
  when _ then ()
  end

  # Find the type definition
  var type_def = Option::None
  for td in engine.type_defs do
    if td.id.id == type_id then
      type_def = Option::Some(td)
    end
  end
  
  match type_def
  when Option::Some(td) then
    engine.visit_states.insert(type_id, LayoutVisitState::Visiting)
    let rec = match td.kind
    when MirTypeDefKind::Struct(fields) then
      compute_struct_layout(engine, type_id, &fields)
    when MirTypeDefKind::Enum(variants) then
      compute_enum_layout(engine, type_id, &variants)
    end
    
    # Cache the result
    engine.records.insert(type_id, rec.clone())
    engine.visit_states.insert(type_id, LayoutVisitState::Resolved)
    rec
  when Option::None then
    # Unknown type - return default pointer-sized layout
    LayoutRecord {
      type_id: type_id,
      name: "unknown",
      category: LayoutCategory::Pointer,
      repr: Repr::OpaquePtr,
      size: engine.target.pointer_size,
      align: engine.target.pointer_align,
      stride: engine.target.pointer_size,
      field_count: 0,
      fields: Vec::new(),
      variants: Vec::new(),
      tag_offset: 0,
      tag_size: 0,
      header_size: 0,
      payload_offset: 0,
      hash: 0
    }
  end
end

# ———————————————————————————————————————————————————————————————
# Field Offset Query (Requirement 2 - no ad-hoc offsets)
# ———————————————————————————————————————————————————————————————

# Get the byte offset of a field by index
def field_offset(engine: &mut LayoutEngine, type_id: Int, field_index: Int) -> Int
  let ty = Type::Named(TypeId { id: type_id }, Vec::new())
  let layout = layout_of(engine, &ty)
  if field_index >= 0 && field_index < layout.fields.len() then
    layout.fields[field_index].offset
  else
    panic("field_offset: field index " + field_index.to_string() + " out of range for type id " + type_id.to_string())
  end
end

# Get the byte offset of a field by name
def field_offset_by_name(engine: &mut LayoutEngine, type_id: Int, field_name: &String) -> Option[Int]
  let ty = Type::Named(TypeId { id: type_id }, Vec::new())
  let layout = layout_of(engine, &ty)
  var i = 0
  for f in layout.fields do
    if f.name == field_name then
      return Option::Some(f.offset)
    end
    i = i + 1
  end
  Option::None
end

# Get field size by index
def field_size(engine: &mut LayoutEngine, type_id: Int, field_index: Int) -> Int
  let ty = Type::Named(TypeId { id: type_id }, Vec::new())
  let layout = layout_of(engine, &ty)
  if field_index >= 0 && field_index < layout.fields.len() then
    layout.fields[field_index].size
  else
    panic("field_size: field index " + field_index.to_string() + " out of range for type id " + type_id.to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# Enum/Tagged Union Queries
# ———————————————————————————————————————————————————————————————

# Get discriminant offset (always 0 per F3)
def discriminant_offset(engine: &LayoutEngine, type_id: Int) -> Int
  match engine.records.get(&type_id)
  when Option::Some(rec) then rec.tag_offset
  when Option::None then 0
  end
end

# Get discriminant size (always 8 per F3)
def discriminant_size(engine: &LayoutEngine, type_id: Int) -> Int
  match engine.records.get(&type_id)
  when Option::Some(rec) then rec.tag_size
  when Option::None then 8
  end
end

# Get payload offset (always 8 per F3)
def payload_offset(engine: &LayoutEngine, type_id: Int) -> Int
  match engine.records.get(&type_id)
  when Option::Some(rec) then rec.payload_offset
  when Option::None then 8
  end
end

# Get variant discriminant value
def variant_discriminant(engine: &LayoutEngine, type_id: Int, variant_name: &String) -> Option[Int]
  match engine.records.get(&type_id)
  when Option::Some(rec) then
    for v in rec.variants do
      if v.name == variant_name then
        return Option::Some(v.discriminant)
      end
    end
    Option::None
  when Option::None then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Header Layout Queries (for heap objects)
# ———————————————————————————————————————————————————————————————

# STRING ABI (FROZEN)
# ———————————————————————————————————————————————————————————————
# The by-value String ABI is FROZEN as an 8-byte raw pointer to a
# null-terminated UTF-8 byte buffer. There is NO inline {ptr,len,cap}
# header on String values; the runtime helpers (strlen-based) and
# `normalize_string_arg0_for_current_arch` in codegen both rely on this.
#
# The 24-byte {ptr:0, len:8, cap:16} shape described elsewhere belongs
# ONLY to the internal char-vector buffer produced by `str.chars()` (a
# Vec[Int]), never to String values. Changing `string_abi_size` or
# `string_abi_is_raw_pointer` is a breaking ABI change.
#
# The value comes from the P0-AR decision table: String is Repr::StringPtr
# and its header size is repr_header_size(StringPtr).
def string_abi_size() -> Int = repr_header_size(Repr::StringPtr)
def string_abi_is_raw_pointer() -> Bool = true

# Known container ABI sizes (F2 - FROZEN)
# These values are frozen and MUST NOT change during stabilization.
# They come from the P0-AR decision table (repr_header_size via
# container_repr_for_name): the full inline heap header size behind the
# 8-byte value handle. String uses the raw-pointer ABI (see
# string_abi_size), NOT a 24-byte inline header; its {ptr,len,cap} shape is
# only the internal char-Vec buffer produced by `str.chars()`, never the
# String value ABI.
def container_header_size(type_name: &String) -> Int
  repr_header_size(container_repr_for_name(type_name))
end

# Container field offsets (F2)
# Dispatched by the same name -> Repr table as container_header_size, so
# the container shape knowledge lives in ONE place.
# NOTE: String values have NO inline {ptr,len,cap} header (raw-pointer ABI,
# see string_abi_size). The offsets below describe the internal char-Vec
# buffer produced by `str.chars()`, which is laid out like Vec[u8]. They are
# exposed via the "Vec" entry; the String branch is retained for byte-image
# tooling only and does not apply to String values.
def container_field_offset(type_name: &String, field_name: &String) -> Int
  match container_repr_for_name(type_name)
  when Repr::StringPtr then
    if field_name == "ptr" || field_name == "data" then 0
    else if field_name == "len" || field_name == "length" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else 0
    end
  when Repr::HeapVecHeader then
    if field_name == "ptr" || field_name == "data" then 0
    else if field_name == "len" || field_name == "length" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else 0
    end
  when Repr::HeapMapHeader then
    if field_name == "buckets" then 0
    else if field_name == "len" || field_name == "length" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else if field_name == "hash_fn" then 24
    else 0
    end
  when Repr::HeapSetHeader then
    if field_name == "map" then 0
    else if field_name == "len" || field_name == "length" then 8
    else 0
    end
  when _ then
    0
  end
end

# ———————————————————————————————————————————————————————————————
# Layout Validation (for golden tests)
# ———————————————————————————————————————————————————————————————

struct LayoutAssertion
  type_name: String
  expected_size: Int
  expected_align: Int
  expected_stride: Int
  field_offsets: Vec[Int]
end

def validate_layout(engine: &mut LayoutEngine, assertion: &LayoutAssertion) -> Result[Unit, LayoutError]
  let type_id = match engine.name_index.get(&assertion.type_name)
  when Option::Some(id) then id
  when Option::None then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Type not found",
      type_name: assertion.type_name.clone(),
      expected: 0,
      actual: 0,
      context: "validate_layout"
    })
  end
  
  let rec = match engine.records.get(&type_id)
  when Option::Some(r) then r.clone()
  when Option::None then compute_type_layout(engine, type_id)
  end
  
  # Validate size
  if rec.size != assertion.expected_size then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Size mismatch",
      type_name: assertion.type_name.clone(),
      expected: assertion.expected_size,
      actual: rec.size,
      context: "validate_layout:size"
    })
  end
  
  # Validate alignment
  if rec.align != assertion.expected_align then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Alignment mismatch",
      type_name: assertion.type_name.clone(),
      expected: assertion.expected_align,
      actual: rec.align,
      context: "validate_layout:align"
    })
  end
  
  # Validate stride
  if rec.stride != assertion.expected_stride then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Stride mismatch",
      type_name: assertion.type_name.clone(),
      expected: assertion.expected_stride,
      actual: rec.stride,
      context: "validate_layout:stride"
    })
  end
  
  # Validate field offsets
  var i = 0
  for expected_off in assertion.field_offsets do
    if i < rec.fields.len() then
      if rec.fields[i].offset != expected_off then
        return Result::Err(LayoutError {
          class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
          message: "Field " + i.to_string() + " offset mismatch",
          type_name: assertion.type_name.clone(),
          expected: expected_off,
          actual: rec.fields[i].offset,
          context: "validate_layout:field_offset"
        })
      end
    end
    i = i + 1
  end
  
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Layout Table Dump (Step 4)
# ———————————————————————————————————————————————————————————————

def dump_layout_table(engine: &LayoutEngine) -> Unit
  eprintln("=== Layout Table Dump ===")
  eprintln("  Target: " + engine.target.arch_name)
  eprintln("  Records: " + engine.records.len().to_string())
  eprintln("  Cache hits: " + engine.cache_hits.to_string())
  eprintln("  Cache misses: " + engine.cache_misses.to_string())
  
  for entry in engine.records do
    let rec = entry.1
    eprintln("  TYPE " + rec.name + " (id=" + rec.type_id.to_string() + ")")
    eprintln("    category: " + category_to_string(&rec.category))
    eprintln("    repr: " + repr_to_string(&rec.repr))
    eprintln("    size: " + rec.size.to_string() + " align: " + rec.align.to_string() + " stride: " + rec.stride.to_string())
    
    if rec.fields.len() > 0 then
      eprintln("    fields:")
      var fi = 0
      for f in rec.fields do
        eprintln("      [" + fi.to_string() + "] " + f.name + " offset=" + f.offset.to_string() + " size=" + f.size.to_string() + " align=" + f.align.to_string())
        fi = fi + 1
      end
    end
    
    if rec.variants.len() > 0 then
      eprintln("    variants:")
      for v in rec.variants do
        eprintln("      " + v.name + " disc=" + v.discriminant.to_string() + " payload_size=" + v.payload_size.to_string())
      end
    end
  end
  eprintln("=== End Layout Table ===")
end

def category_to_string(cat: &LayoutCategory) -> String
  match cat
  when LayoutCategory::Primitive then "Primitive"
  when LayoutCategory::Pointer then "Pointer"
  when LayoutCategory::FatPointer then "FatPointer"
  when LayoutCategory::InlineStruct then "InlineStruct"
  when LayoutCategory::TaggedUnion then "TaggedUnion"
  when LayoutCategory::DynContainer then "DynContainer"
  when LayoutCategory::ZeroSized then "ZeroSized"
  when LayoutCategory::FunctionType then "FunctionType"
  end
end

def repr_to_string(repr: &Repr) -> String
  match repr
  when Repr::Immediate     then "Immediate"
  when Repr::RawPtr        then "RawPtr"
  when Repr::StringPtr     then "StringPtr"
  when Repr::HeapVecHeader then "HeapVecHeader"
  when Repr::HeapMapHeader then "HeapMapHeader"
  when Repr::HeapSetHeader then "HeapSetHeader"
  when Repr::Inline        then "Inline"
  when Repr::TaggedPtr     then "TaggedPtr"
  when Repr::OpaquePtr     then "OpaquePtr"
  end
end

# ———————————————————————————————————————————————————————————————
# Utility Functions
# ———————————————————————————————————————————————————————————————

def extract_type_id(ty: &Type) -> Int
  match ty
  when Type::Named(tid, _) then tid.id
  when Type::RefInternal(inner, _) then extract_type_id(&inner)
  when _ then -1
  end
end

def lookup_type_name(engine: &LayoutEngine, type_id: Int) -> String
  for td in engine.type_defs do
    if td.id.id == type_id then
      return td.name.clone()
    end
  end
  "unknown_" + type_id.to_string()
end

# ———————————————————————————————————————————————————————————————
# ABI/Calling Convention Queries
# ———————————————————————————————————————————————————————————————

# Should a type be passed directly in registers, or indirectly via pointer?
# Direct: primitives, pointers, small structs (<= 16 bytes, power-of-2)
# Indirect: large structs, some enums
# ———————————————————————————————————————————————————————————————
# Value ABI classification
# ———————————————————————————————————————————————————————————————
# StorageLayout (the Layout struct) answers "how is this type laid out in
# memory". ValueAbi answers "how is a value of this type passed/returned" —
# direct in registers vs indirect via a pointer. Every size used here comes
# from the canonical size_of/layout_of, never from an independent estimate.
struct ValueAbi
  passing: Bool          # true = direct (registers), false = indirect (sret/ptr)
  register_class: String # "int" or "float"
  register_width: Int    # bytes per register slot
  register_count: Int    # number of registers used (direct) or 1 pointer (indirect)
  stack_size: Int        # bytes consumed on the stack when indirect
  extension: String      # "zero", "sign", "none"
end

def value_abi(engine: &LayoutEngine, ty: &Type) -> ValueAbi
  let sz = size_of(engine, ty)
  let direct = sz == 0 || (sz <= 16 && (sz == 1 || sz == 2 || sz == 4 || sz == 8 || sz == 16))
  let cls = match ty
  when Type::Float then "float"
  when Type::F32 then "float"
  when Type::F64 then "float"
  when _ then "int"
  end
  ValueAbi {
    passing: direct,
    register_class: cls,
    register_width: if direct then (if sz == 0 then 8 else sz end) else 8 end,
    register_count: if direct then (if sz == 0 then 0 else (if sz <= 8 then 1 else 2 end) end) else 1 end,
    stack_size: sz,
    extension: "none"
  }
end

def should_pass_directly(engine: &LayoutEngine, ty: &Type) -> Bool
  # Derived entirely from the canonical storage size.
  let sz = size_of(engine, ty)
  if sz == 0 then return true end
  if sz > 16 then return false end
  sz == 1 || sz == 2 || sz == 4 || sz == 8 || sz == 16
end

# Should a type be returned directly in registers, or via output pointer?
def should_return_directly(engine: &LayoutEngine, ty: &Type) -> Bool
  # Same rules as passing for now
  should_pass_directly(engine, ty)
end

# Get the number of argument registers needed for a type
def arg_register_count(engine: &LayoutEngine, ty: &Type) -> Int
  let sz = match ty
  when Type::Unit then 0
  when Type::Tuple(fields) then fields.len()  # Each field in separate register
  when _ then
    if should_pass_directly(engine, ty) then 1 else 1 end  # Indirect = 1 pointer
  end
  sz
end

# Absolute byte offsets of each payload field for an enum variant, taken from
# the single layout authority.  Offsets are relative to the enum base (tag at
# 0, payload at tag_size).  Replaces any ad-hoc `payload_offset + i * 8`.
def enum_variant_field_offsets(engine: &LayoutEngine, type_id: Int, variant_index: Int) -> Vec[Int]
  var offs = Vec::new()
  match engine.records.get(&type_id)
  when Option::Some(rec) then
    if variant_index >= 0 && variant_index < rec.variants.len() then
      for f in rec.variants[variant_index].fields do
        offs.push(f.offset)
      end
    end
  when Option::None then ()
  end
  offs
end

# Variant payload sizes, from the layout authority.
def enum_variant_field_sizes(engine: &LayoutEngine, type_id: Int, variant_index: Int) -> Vec[Int]
  var sizes = Vec::new()
  match engine.records.get(&type_id)
  when Option::Some(rec) then
    if variant_index >= 0 && variant_index < rec.variants.len() then
      for f in rec.variants[variant_index].fields do
        sizes.push(f.size)
      end
    end
  when Option::None then ()
  end
  sizes
end

# ———————————————————————————————————————————————————————————————
# Pre-compute all layouts (call after registering types)
# ———————————————————————————————————————————————————————————————

# Collect TypeIds of named types reached through INLINE storage only: direct
# Named fields and tuple elements, and fixed inline array elements
# (Array[T, N] with N > 0 — the count-0 heap-vector handle is an
# indirection and is never followed).  Other indirections (Ptr/PtrMut/Ref,
# Box/Rc, Slice, Option/Result/Map/Set, Function, String) are pointer-sized
# opaque handles and are never followed; unregistered named types have no
# definition to recurse into.
def collect_inline_named_children(ty: &Type, out: &mut Vec[Int]) -> Unit
  match ty
  when Type::Named(tid, _) then
    out.push(tid.id)
  when Type::Tuple(elems) then
    for e in elems do
      collect_inline_named_children(e, out)
    end
  when Type::Array(elem, count) then
    if count > 0 then
      collect_inline_named_children(elem, out)
    end
  when _ then ()
  end
end

# DFS over the inline layout graph (P0-AT).  Reaching a type that is still
# Visiting means it reaches itself through inline storage only — no finite
# inline layout exists (e.g. `struct Bad { child: Bad }`).  Types reached
# through indirection (e.g. `struct Node { next: Box[Node] }`) are never
# flagged.  The engine has no error list; the existing diagnostic channel
# for unrecoverable layout problems is panic, so the cycle is reported there.
def check_inline_layout_cycles(engine: &mut LayoutEngine, type_id: Int) -> Unit
  let state = match engine.visit_states.get(&type_id)
  when Option::Some(s) then s
  when Option::None then LayoutVisitState::Unvisited
  end
  match state
  when LayoutVisitState::Visiting then
    panic("layout: infinitely sized recursive type '" + lookup_type_name(engine, type_id) + "': inline storage cycle (use a pointer or Box to break the cycle)")
  when LayoutVisitState::Resolved then ()
  when LayoutVisitState::Unvisited then
    engine.visit_states.insert(type_id, LayoutVisitState::Visiting)
    var children = Vec::new()
    for td in engine.type_defs do
      if td.id.id == type_id then
        match td.kind
        when MirTypeDefKind::Struct(fields) then
          for f in fields do
            collect_inline_named_children(&f.ty, &mut children)
          end
        when MirTypeDefKind::Enum(variants) then
          for v in variants do
            for fty in v.fields do
              collect_inline_named_children(&fty, &mut children)
            end
          end
        end
      end
    end
    for child in children do
      check_inline_layout_cycles(engine, child)
    end
    engine.visit_states.insert(type_id, LayoutVisitState::Resolved)
  end
end

def compute_all_layouts(engine: &mut LayoutEngine) -> Unit
  # Diagnose infinitely sized recursive inline types FIRST: the DFS marks
  # Unvisited/Visiting/Resolved per type, and re-visiting a Visiting type
  # through inline storage is reported before placeholder seeding could mask
  # the cycle.  Types behind indirection (Box, pointers, containers) are
  # finite and never flagged.
  engine.visit_states = Map::new()
  engine.strict_states = Map::new()
  for td in engine.type_defs do
    check_inline_layout_cycles(engine, td.id.id)
  end

  # First pass: insert placeholder records (cycles are already diagnosed
  # above, so a placeholder can never mask one).
  for td in engine.type_defs do
    engine.records.insert(td.id.id, LayoutRecord {
      type_id: td.id.id,
      name: td.name.clone(),
      category: LayoutCategory::ZeroSized,
      repr: Repr::OpaquePtr,
      size: 0,
      align: 1,
      stride: 0,
      field_count: 0,
      fields: Vec::new(),
      variants: Vec::new(),
      tag_offset: 0,
      tag_size: 0,
      header_size: 0,
      payload_offset: 0,
      hash: 0
    })
  end

  # Second pass: compute real layouts from the definitions.  Every record is
  # recomputed and overwrites its placeholder, so a placeholder's size 0 can
  # never determine a field's eventual size.
  for td in engine.type_defs do
    let rec = compute_type_layout(engine, td.id.id)
    engine.records.insert(td.id.id, rec)
  end
end