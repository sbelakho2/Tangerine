# tg_compiler/layout_engine.tg — Centralized Layout Engine
# SINGLE SOURCE OF TRUTH for all type layout queries.
# All compiler phases (interpreter, verifier, lowering, codegen, stdlib) must use this API.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use tg_compiler::types::{Type, TypeId}
use tg_compiler::mir::{MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef}

# ———————————————————————————————————————————————————————————————
# Failure Class Categorization
# ———————————————————————————————————————————————————————————————

# Every layout-related bug must be tagged as one of these categories.
# This prevents "memory offset" bugs from becoming one huge vague pile.
enum LayoutFailureClass
  # The central layout engine computed the wrong size/alignment/offset.
  LAYOUT_COMPUTATION_BUG
  
  # The layout engine is right, but lowering/codegen/runtime used it wrong.
  LAYOUT_CONSUMER_BUG
  
  # Heap object / fat pointer / closure / string / slice header layout is inconsistent.
  HEADER_MODEL_BUG
  
  # FFI or call lowering uses a different memory convention.
  ABI_BOUNDARY_BUG
  
  # Pointer size, endianness, alignment policy, or ABI rules are wrong for target.
  TARGET_DESCRIPTOR_BUG
end

# Diagnostic error with failure class
struct LayoutError
  class: LayoutFailureClass
  message: String
  type_name: String
  expected: Int
  actual: Int
  context: String  # File:line or function name where error occurred
end

def layout_error_to_string(err: &LayoutError) -> String
  let class_str = match err.class
  when LayoutFailureClass::LAYOUT_COMPUTATION_BUG then "LAYOUT_COMPUTATION_BUG"
  when LayoutFailureClass::LAYOUT_CONSUMER_BUG then "LAYOUT_CONSUMER_BUG"
  when LayoutFailureClass::HEADER_MODEL_BUG then "HEADER_MODEL_BUG"
  when LayoutFailureClass::ABI_BOUNDARY_BUG then "ABI_BOUNDARY_BUG"
  when LayoutFailureClass::TARGET_DESCRIPTOR_BUG then "TARGET_DESCRIPTOR_BUG"
  end
  "[" + class_str + "] " + err.message + " for type '" + err.type_name + 
    "': expected " + err.expected.to_string() + ", got " + err.actual.to_string() +
    " at " + err.context
end

# ———————————————————————————————————————————————————————————————
# Canonical Layout Categories (Step 2)
# ———————————————————————————————————————————————————————————————

enum LayoutCategory
  # Fixed-width integer and float types
  Primitive
  # Pointer-width types (references, raw pointers, Box)
  Pointer
  # Fat pointer types (slices, trait objects)
  FatPointer
  # Inline aggregates (structs laid out field-by-field)
  InlineStruct
  # Discriminated unions (enums with tag + max_payload)
  TaggedUnion
  # Dynamically-sized containers (Vec, String, Map, Set)
  DynContainer
  # Zero-sized types (Unit, Never, zero-variant enums)
  ZeroSized
  # Function types (fn pointer + optional closure env)
  FunctionType
end

# ———————————————————————————————————————————————————————————————
# Layout Record (Step 3)
# ———————————————————————————————————————————————————————————————

struct FieldLayout
  name: String
  offset: Int        # Byte offset from struct base
  size: Int          # Byte size of field
  align: Int         # Alignment requirement
  type_id: Int       # TypeId.id for the field's type
end

struct VariantLayout
  name: String
  discriminant: Int  # Variant discriminant value
  payload_offset: Int  # Offset of payload within enum
  payload_size: Int    # Size of payload
  fields: Vec[FieldLayout]
end

struct LayoutRecord
  type_id: Int
  name: String
  category: LayoutCategory
  size: Int              # Total size in bytes
  align: Int             # Required alignment in bytes
  stride: Int            # Distance between consecutive elements (>= size, multiple of align)
  field_count: Int       # Number of fields
  
  # Detailed field layouts (for structs)
  fields: Vec[FieldLayout]
  
  # Variant layouts (for enums)
  variants: Vec[VariantLayout]
  
  # Tag info (for enums)
  tag_offset: Int        # Offset of discriminant tag (0 for all enums)
  tag_size: Int          # Size of tag (8 bytes)
  
  # Header info (for heap objects)
  header_size: Int       # 0 for non-heap types
  payload_offset: Int    # Offset of payload from heap object base
  
  # Hash for caching
  hash: Int
end

# ———————————————————————————————————————————————————————————————
# Target Layout Descriptor (Step 1)
# ———————————————————————————————————————————————————————————————

struct TargetDescriptor
  arch_name: String        # "aarch64" or "x86_64"
  pointer_size: Int        # 8 for LP64
  pointer_align: Int       # 8 for LP64
  max_align: Int           # Maximum natural alignment
  int_size: Int            # 8 for LP64
  bool_size: Int           # 1
  char_size: Int           # 4 (Unicode scalar)
  fn_ptr_size: Int         # 16 (fn ptr + env)
  float_size: Int          # 8 (f64)
  double_size: Int         # 8 (f64, same as float)
  endianness: String       # "little" or "big"
  stack_align: Int         # Stack alignment (16)
end

# Pre-defined target descriptors
def aarch64_target() -> TargetDescriptor
  TargetDescriptor {
    arch_name: "aarch64",
    pointer_size: 8,
    pointer_align: 8,
    max_align: 16,
    int_size: 8,
    bool_size: 1,
    char_size: 4,
    fn_ptr_size: 16,
    float_size: 8,
    double_size: 8,
    endianness: "little",
    stack_align: 16
  }
end

def x86_64_target() -> TargetDescriptor
  TargetDescriptor {
    arch_name: "x86_64",
    pointer_size: 8,
    pointer_align: 8,
    max_align: 16,
    int_size: 8,
    bool_size: 1,
    char_size: 4,
    fn_ptr_size: 16,
    float_size: 8,
    double_size: 8,
    endianness: "little",
    stack_align: 16
  }
end

# ———————————————————————————————————————————————————————————————
# Centralized Layout Engine (Requirement 2 + Step 3)
# ———————————————————————————————————————————————————————————————

struct LayoutEngine
  target: TargetDescriptor
  records: Map[Int, LayoutRecord]      # type_id -> LayoutRecord
  name_index: Map[String, Int]          # type_name -> type_id
  type_defs: Vec[MirTypeDef]            # All type definitions
  cache_hits: Int
  cache_misses: Int
end

# Create a new layout engine for a target
def layout_engine_new(target: TargetDescriptor) -> LayoutEngine
  LayoutEngine {
    target: target,
    records: Map::new(),
    name_index: Map::new(),
    type_defs: Vec::new(),
    cache_hits: 0,
    cache_misses: 0
  }
end

# Register type definitions (call before computing layouts)
def layout_engine_register_types(engine: &mut LayoutEngine, types: &Vec[MirTypeDef]) -> Unit
  engine.type_defs = types.clone()
  for td in types do
    engine.name_index.insert(td.name.clone(), td.id.id)
  end
end

# ———————————————————————————————————————————————————————————————
# Primitive Type Sizes (F1 - Frozen)
# ———————————————————————————————————————————————————————————————

def primitive_size(engine: &LayoutEngine, ty: &Type) -> Int
  match ty
  when Type::Unit    then 0
  when Type::Bool    then engine.target.bool_size
  when Type::Char    then engine.target.char_size
  when Type::Int     then engine.target.int_size
  when Type::UInt    then engine.target.int_size
  when Type::Float   then engine.target.float_size
  when Type::F32     then 4
  when Type::F64     then 8
  when Type::I8      then 1
  when Type::U8      then 1
  when Type::I16     then 2
  when Type::U16     then 2
  when Type::I32     then 4
  when Type::U32     then 4
  when Type::I64     then 8
  when Type::U64     then 8
  when Type::I128    then 16
  when Type::U128    then 16
  when Type::ISize   then engine.target.pointer_size
  when Type::USize   then engine.target.pointer_size
  when Type::String  then engine.target.pointer_size  # heap header is queried via container_header_size
  when Type::Never   then 0
  when _             then -1   # Not a primitive
  end
end

def primitive_align(engine: &LayoutEngine, ty: &Type) -> Int
  match ty
  when Type::Unit    then 1
  when Type::Bool    then 1
  when Type::Char    then 4
  when Type::I8      then 1
  when Type::U8      then 1
  when Type::I16     then 2
  when Type::U16     then 2
  when Type::I32     then 4
  when Type::U32     then 4
  when Type::F32     then 4
    when Type::I64     then 8
    when Type::U64     then 8
    when Type::F64     then 8
    when Type::I128    then 16
    when Type::U128    then 16
    when Type::ISize   then engine.target.pointer_align
    when Type::USize   then engine.target.pointer_align
  when _             then engine.target.pointer_align  # Default to pointer alignment
  end
end

# ———————————————————————————————————————————————————————————————
# Layout Computation Core
# ———————————————————————————————————————————————————————————————

# Align value up to alignment boundary.
# Kept module-unique to avoid collisions with other tg_compiler helpers during bootstrap MIR merge.
def layout_align_up(value: Int, align: Int) -> Int
  if align <= 1 then
    return value
  end
  let rem = value % align
  if rem == 0 then value else value + (align - rem) end
end

# Compute hash for a layout record (for caching)
def compute_layout_hash(name: &String, size: Int, align: Int, field_count: Int) -> Int
  # Simple hash using Int to avoid interpreter UInt64 issues
  mut h: Int = 5381
  for byte in name.bytes() do
    h = ((h * 33) + (byte as Int)) % 2147483647
  end
  h = ((h * 33) + size) % 2147483647
  h = ((h * 33) + align) % 2147483647
  h = ((h * 33) + field_count) % 2147483647
  h
end

# Get the size of a type (main entry point)
def size_of(engine: &mut LayoutEngine, ty: &Type) -> Int
  # Check primitives first
  let prim_size = primitive_size(engine, ty)
  if prim_size >= 0 then
    return prim_size
  end
  
  match ty
  when Type::Ref(_, _)     then engine.target.pointer_size
  when Type::RefMut(_, _)  then engine.target.pointer_size
  when Type::Owned(_)      then engine.target.pointer_size
  when Type::Ptr(_)        then engine.target.pointer_size
  when Type::PtrMut(_)     then engine.target.pointer_size
  when Type::Slice(_)      then engine.target.pointer_size  # current runtime lowers slices/Vec to heap-header pointers
  when Type::Function(_, _) then engine.target.fn_ptr_size  # 16 bytes
  when Type::Tuple(fields) then
    let tl = compute_tuple_layout(engine, fields)
    tl.size
  when Type::Array(elem, count) then
    let elem_size = size_of(engine, elem)
    elem_size * count
  when Type::Named(tid, _) then
    # Look up cached record
    match engine.records.get(tid.id)
    when Option::Some(rec) then
      engine.cache_hits = engine.cache_hits + 1
      rec.size
    when Option::None then
      engine.cache_misses = engine.cache_misses + 1
      # Compute and cache
      let rec = compute_type_layout(engine, tid.id)
      rec.size
    end
  when Type::Var(_) then engine.target.pointer_size  # Unknown; default to pointer
  when Type::Error then 0
  when _ then engine.target.pointer_size
  end
end

# Get the alignment of a type
def align_of(engine: &mut LayoutEngine, ty: &Type) -> Int
  let prim_align = primitive_align(engine, ty)
  if prim_align > 0 then
    return prim_align
  end
  
  match ty
  when Type::Unit    then 1
  when Type::Never   then 1
  when Type::Ref(_, _)     then engine.target.pointer_align
  when Type::RefMut(_, _)  then engine.target.pointer_align
  when Type::Owned(_)      then engine.target.pointer_align
  when Type::Tuple(fields) then
    let tl = compute_tuple_layout(engine, fields)
    tl.align
  when Type::Array(elem, _) then
    align_of(engine, elem)
  when Type::Named(tid, _) then
    match engine.records.get(tid.id)
    when Option::Some(rec) then rec.align
    when Option::None then engine.target.pointer_align
    end
  when _ then engine.target.pointer_align
  end
end

# Get the stride of a type (distance between array elements)
def stride_of(engine: &mut LayoutEngine, ty: &Type) -> Int
  let sz = size_of(engine, ty)
  let al = align_of(engine, ty)
  layout_align_up(sz, al)
end

# ———————————————————————————————————————————————————————————————
# Tuple Layout Computation
# ———————————————————————————————————————————————————————————————

struct TupleLayout
  size: Int
  align: Int
  field_offsets: Vec[Int]
end

def compute_tuple_layout(engine: &mut LayoutEngine, fields: &Vec[Type]) -> TupleLayout
  mut offsets = Vec::new()
  mut current_offset = 0
  mut max_align = 1
  
  for f in fields do
    let f_align = align_of(engine, f)
    let f_size = size_of(engine, f)
    
    if f_align > max_align then
      max_align = f_align
    end
    
    # Align field
    current_offset = layout_align_up(current_offset, f_align)
    offsets.push(current_offset)
    current_offset = current_offset + f_size
  end
  
  # Final alignment
  let total_size = layout_align_up(current_offset, max_align)
  
  TupleLayout {
    size: total_size,
    align: max_align,
    field_offsets: offsets
  }
end

# ———————————————————————————————————————————————————————————————
# Struct Layout Computation (F7 - declaration order, no reordering)
# ———————————————————————————————————————————————————————————————

def compute_struct_layout(engine: &mut LayoutEngine, type_id: Int, fields: &Vec[MirFieldDef]) -> LayoutRecord
  mut field_layouts = Vec::new()
  mut current_offset = 0
  mut max_align = 1
  
  for f in fields do
    # Tangerine runtime uses uniform pointer-sized (8-byte) slots for ALL struct fields
    let f_size = engine.target.pointer_size
    let f_align = engine.target.pointer_align
    
    if f_align > max_align then
      max_align = f_align
    end
    
    # Align field (F7: fields in declaration order, no reordering)
    current_offset = layout_align_up(current_offset, f_align)
    
    field_layouts.push(FieldLayout {
      name: f.name.clone(),
      offset: current_offset,
      size: f_size,
      align: f_align,
      type_id: extract_type_id(&f.ty)
    })
    
    current_offset = current_offset + f_size
  end
  
  let total_size = layout_align_up(current_offset, max_align)
  let type_name = lookup_type_name(engine, type_id)
  let hash = compute_layout_hash(&type_name, total_size, max_align, fields.len())
  
  LayoutRecord {
    type_id: type_id,
    name: type_name,
    category: LayoutCategory::InlineStruct,
    size: total_size,
    align: max_align,
    stride: total_size,
    field_count: fields.len(),
    fields: field_layouts,
    variants: Vec::new(),
    tag_offset: 0,
    tag_size: 0,
    header_size: 0,
    payload_offset: 0,
    hash: hash
  }
end

# ———————————————————————————————————————————————————————————————
# Enum Layout Computation (F3 - tag at 0, payload at 8)
# ———————————————————————————————————————————————————————————————

def compute_enum_layout(engine: &mut LayoutEngine, type_id: Int, variants: &Vec[MirVariantDef]) -> LayoutRecord
  mut variant_layouts = Vec::new()
  mut max_payload_size = 0
  mut max_align = 8  # Tag alignment

  for v in variants do
    mut payload_offset = 8  # F3: payload starts at offset 8
    mut payload_size = 0
    mut field_layouts = Vec::new()

    for fty in v.fields do
      let f_size = size_of(engine, fty)
      let f_align = align_of(engine, fty)

      if f_align > max_align then
        max_align = f_align
      end

      payload_offset = layout_align_up(payload_offset, f_align)
      
      field_layouts.push(FieldLayout {
        name: "",
        offset: payload_offset,
        size: f_size,
        align: f_align,
        type_id: extract_type_id(fty)
      })
      
      payload_offset = payload_offset + f_size
      payload_size = payload_size + f_size
    end
    
    if payload_size > max_payload_size then
      max_payload_size = payload_size
    end
    
    variant_layouts.push(VariantLayout {
      name: v.name.clone(),
      discriminant: v.discriminant,
      payload_offset: 8,
      payload_size: payload_size,
      fields: field_layouts
    })
  end
  
  # Total size: tag (8 bytes) + max_payload (aligned)
  let payload_total = layout_align_up(max_payload_size, max_align)
  let total_size = layout_align_up(8 + payload_total, max_align)
  
  let type_name = lookup_type_name(engine, type_id)
  let hash = compute_layout_hash(&type_name, total_size, max_align, variants.len())
  
  LayoutRecord {
    type_id: type_id,
    name: type_name,
    category: LayoutCategory::TaggedUnion,
    size: total_size,
    align: max_align,
    stride: total_size,
    field_count: variants.len(),
    fields: Vec::new(),
    variants: variant_layouts,
    tag_offset: 0,      # F3: tag at offset 0
    tag_size: 8,        # F3: tag is 8 bytes
    header_size: 0,
    payload_offset: 8,  # F3: payload at offset 8
    hash: hash
  }
end

# ———————————————————————————————————————————————————————————————
# Type Layout Computation Dispatcher
# ———————————————————————————————————————————————————————————————

def compute_type_layout(engine: &mut LayoutEngine, type_id: Int) -> LayoutRecord
  # Find the type definition
  mut type_def = Option::None
  for td in engine.type_defs do
    if td.id.id == type_id then
      type_def = Option::Some(td)
    end
  end
  
  match type_def
  when Option::Some(td) then
    let rec = match td.kind
    when MirTypeDefKind::Struct(fields) then
      compute_struct_layout(engine, type_id, fields)
    when MirTypeDefKind::Enum(variants) then
      compute_enum_layout(engine, type_id, variants)
    end
    
    # Cache the result
    engine.records.insert(type_id, rec.clone())
    rec
  when Option::None then
    # Unknown type - return default pointer-sized layout
    LayoutRecord {
      type_id: type_id,
      name: "unknown",
      category: LayoutCategory::Pointer,
      size: engine.target.pointer_size,
      align: engine.target.pointer_align,
      stride: engine.target.pointer_size,
      field_count: 0,
      fields: Vec::new(),
      variants: Vec::new(),
      tag_offset: 0,
      tag_size: 0,
      header_size: 0,
      payload_offset: 0,
      hash: 0
    }
  end
end

# ———————————————————————————————————————————————————————————————
# Field Offset Query (Requirement 2 - no ad-hoc offsets)
# ———————————————————————————————————————————————————————————————

# Get the byte offset of a field by index
def field_offset(engine: &mut LayoutEngine, type_id: Int, field_index: Int) -> Int
  match engine.records.get(type_id)
  when Option::Some(rec) then
    if field_index < rec.fields.len() then
      rec.fields[field_index].offset
    else
      # F8: unknown fields default to index * 8
      field_index * 8
    end
  when Option::None then
    # Not cached - compute layout first
    let rec = compute_type_layout(engine, type_id)
    if field_index < rec.fields.len() then
      rec.fields[field_index].offset
    else
      field_index * 8
    end
  end
end

# Get the byte offset of a field by name
def field_offset_by_name(engine: &mut LayoutEngine, type_id: Int, field_name: &String) -> Option[Int]
  match engine.records.get(type_id)
  when Option::Some(rec) then
    mut i = 0
    for f in rec.fields do
      if f.name == *field_name then
        return Option::Some(f.offset)
      end
      i = i + 1
    end
    Option::None
  when Option::None then
    let rec = compute_type_layout(engine, type_id)
    field_offset_by_name(engine, type_id, field_name)
  end
end

# Get field size by index
def field_size(engine: &mut LayoutEngine, type_id: Int, field_index: Int) -> Int
  match engine.records.get(type_id)
  when Option::Some(rec) then
    if field_index < rec.fields.len() then
      rec.fields[field_index].size
    else
      8  # Default to pointer size
    end
  when Option::None then
    let rec = compute_type_layout(engine, type_id)
    if field_index < rec.fields.len() then
      rec.fields[field_index].size
    else
      8
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Enum/Tagged Union Queries
# ———————————————————————————————————————————————————————————————

# Get discriminant offset (always 0 per F3)
def discriminant_offset(engine: &LayoutEngine, type_id: Int) -> Int
  match engine.records.get(type_id)
  when Option::Some(rec) then rec.tag_offset
  when Option::None then 0
  end
end

# Get discriminant size (always 8 per F3)
def discriminant_size(engine: &LayoutEngine, type_id: Int) -> Int
  match engine.records.get(type_id)
  when Option::Some(rec) then rec.tag_size
  when Option::None then 8
  end
end

# Get payload offset (always 8 per F3)
def payload_offset(engine: &LayoutEngine, type_id: Int) -> Int
  match engine.records.get(type_id)
  when Option::Some(rec) then rec.payload_offset
  when Option::None then 8
  end
end

# Get variant discriminant value
def variant_discriminant(engine: &LayoutEngine, type_id: Int, variant_name: &String) -> Option[Int]
  match engine.records.get(type_id)
  when Option::Some(rec) then
    for v in rec.variants do
      if v.name == *variant_name then
        return Option::Some(v.discriminant)
      end
    end
    Option::None
  when Option::None then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Header Layout Queries (for heap objects)
# ———————————————————————————————————————————————————————————————

# Known container ABI sizes (F2 - FROZEN)
# These values are frozen and MUST NOT change during stabilization.
# For heap containers this is the full inline header size.
# String shares the same inline header shape as Vec[u8]: ptr, len, cap.
def container_header_size(type_name: &String) -> Int
  if type_name == "String" then 24
  else if type_name == "Vec" then 24
  else if type_name == "Array" then 24
  else if type_name == "Map" then 48
  else if type_name == "HashMap" then 48
  else if type_name == "Set" then 32
  else if type_name == "HashSet" then 32
  else 0
  end
end

# Container field offsets (F2)
def container_field_offset(type_name: &String, field_name: &String) -> Int
  if type_name == "String" then
    if field_name == "ptr" || field_name == "data" then 0
    else if field_name == "len" || field_name == "length" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else 0
    end
  else if type_name == "Vec" || type_name == "Array" then
    if field_name == "ptr" || field_name == "data" then 0
    else if field_name == "len" || field_name == "length" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else 0
    end
  else if type_name == "Map" || type_name == "HashMap" then
    if field_name == "buckets" then 0
    else if field_name == "len" || field_name == "length" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else if field_name == "hash_fn" then 24
    else 0
    end
  else if type_name == "Set" || type_name == "HashSet" then
    if field_name == "map" then 0
    else if field_name == "len" || field_name == "length" then 8
    else 0
    end
  else
    0
  end
end

# ———————————————————————————————————————————————————————————————
# Layout Validation (for golden tests)
# ———————————————————————————————————————————————————————————————

struct LayoutAssertion
  type_name: String
  expected_size: Int
  expected_align: Int
  expected_stride: Int
  field_offsets: Vec[Int]
end

def validate_layout(engine: &mut LayoutEngine, assertion: &LayoutAssertion) -> Result[Unit, LayoutError]
  let type_id = match engine.name_index.get(&assertion.type_name)
  when Option::Some(id) then id
  when Option::None then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Type not found",
      type_name: assertion.type_name.clone(),
      expected: 0,
      actual: 0,
      context: "validate_layout"
    })
  end
  
  let rec = match engine.records.get(type_id)
  when Option::Some(r) then r.clone()
  when Option::None then compute_type_layout(engine, type_id)
  end
  
  # Validate size
  if rec.size != assertion.expected_size then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Size mismatch",
      type_name: assertion.type_name.clone(),
      expected: assertion.expected_size,
      actual: rec.size,
      context: "validate_layout:size"
    })
  end
  
  # Validate alignment
  if rec.align != assertion.expected_align then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Alignment mismatch",
      type_name: assertion.type_name.clone(),
      expected: assertion.expected_align,
      actual: rec.align,
      context: "validate_layout:align"
    })
  end
  
  # Validate stride
  if rec.stride != assertion.expected_stride then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Stride mismatch",
      type_name: assertion.type_name.clone(),
      expected: assertion.expected_stride,
      actual: rec.stride,
      context: "validate_layout:stride"
    })
  end
  
  # Validate field offsets
  mut i = 0
  for expected_off in assertion.field_offsets do
    if i < rec.fields.len() then
      if rec.fields[i].offset != expected_off then
        return Result::Err(LayoutError {
          class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
          message: "Field " + i.to_string() + " offset mismatch",
          type_name: assertion.type_name.clone(),
          expected: expected_off,
          actual: rec.fields[i].offset,
          context: "validate_layout:field_offset"
        })
      end
    end
    i = i + 1
  end
  
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Layout Table Dump (Step 4)
# ———————————————————————————————————————————————————————————————

def dump_layout_table(engine: &LayoutEngine) -> Unit
  eprintln("=== Layout Table Dump ===")
  eprintln("  Target: " + engine.target.arch_name)
  eprintln("  Records: " + engine.records.len().to_string())
  eprintln("  Cache hits: " + engine.cache_hits.to_string())
  eprintln("  Cache misses: " + engine.cache_misses.to_string())
  
  for entry in engine.records do
    let rec = entry.1
    eprintln("  TYPE " + rec.name + " (id=" + rec.type_id.to_string() + ")")
    eprintln("    category: " + category_to_string(&rec.category))
    eprintln("    size: " + rec.size.to_string() + " align: " + rec.align.to_string() + " stride: " + rec.stride.to_string())
    
    if rec.fields.len() > 0 then
      eprintln("    fields:")
      mut fi = 0
      for f in rec.fields do
        eprintln("      [" + fi.to_string() + "] " + f.name + " offset=" + f.offset.to_string() + " size=" + f.size.to_string() + " align=" + f.align.to_string())
        fi = fi + 1
      end
    end
    
    if rec.variants.len() > 0 then
      eprintln("    variants:")
      for v in rec.variants do
        eprintln("      " + v.name + " disc=" + v.discriminant.to_string() + " payload_size=" + v.payload_size.to_string())
      end
    end
  end
  eprintln("=== End Layout Table ===")
end

def category_to_string(cat: &LayoutCategory) -> String
  match cat
  when LayoutCategory::Primitive then "Primitive"
  when LayoutCategory::Pointer then "Pointer"
  when LayoutCategory::FatPointer then "FatPointer"
  when LayoutCategory::InlineStruct then "InlineStruct"
  when LayoutCategory::TaggedUnion then "TaggedUnion"
  when LayoutCategory::DynContainer then "DynContainer"
  when LayoutCategory::ZeroSized then "ZeroSized"
  when LayoutCategory::FunctionType then "FunctionType"
  end
end

# ———————————————————————————————————————————————————————————————
# Utility Functions
# ———————————————————————————————————————————————————————————————

def extract_type_id(ty: &Type) -> Int
  match ty
  when Type::Named(tid, _) then tid.id
  when Type::Ref(inner, _) then extract_type_id(inner)
  when Type::RefMut(inner, _) then extract_type_id(inner)
  when _ then -1
  end
end

def lookup_type_name(engine: &LayoutEngine, type_id: Int) -> String
  for td in engine.type_defs do
    if td.id.id == type_id then
      return td.name.clone()
    end
  end
  "unknown_" + type_id.to_string()
end

# ———————————————————————————————————————————————————————————————
# ABI/Calling Convention Queries
# ———————————————————————————————————————————————————————————————

# Should a type be passed directly in registers, or indirectly via pointer?
# Direct: primitives, pointers, small structs (<= 16 bytes, power-of-2)
# Indirect: large structs, some enums
def should_pass_directly(engine: &LayoutEngine, ty: &Type) -> Bool
  let sz = match ty
  when Type::Unit then 0
  when Type::Bool then 1
  when Type::Char then 4
  when Type::Int then 8
  when Type::UInt then 8
  when Type::Float then 8
  when Type::F32 then 4
  when Type::F64 then 8
  when Type::I8 then 1
  when Type::U8 then 1
  when Type::I16 then 2
  when Type::U16 then 2
  when Type::I32 then 4
  when Type::U32 then 4
  when Type::I64 then 8
  when Type::U64 then 8
  when Type::I128 then 16
  when Type::U128 then 16
  when Type::ISize then 8
  when Type::USize then 8
  when Type::String then engine.target.pointer_size
  when Type::Ref(_, _) then 8
  when Type::RefMut(_, _) then 8
  when Type::Owned(_) then 8
  when Type::Ptr(_) then 8
  when Type::PtrMut(_) then 8
  when Type::Slice(_) then engine.target.pointer_size
  when Type::Function(_, _) then 16  # Function pointer - indirect
  when Type::Tuple(fields) then
    # Small tuples (<= 16 bytes, power of 2) can be direct
    mut total = 0
    for f in fields do
      total = total + 8  # Simplified: each field is 8 bytes
    end
    total
  when Type::Array(_, _) then 16  # Indirect (usually heap-allocated)
  when Type::Named(tid, _) then
    match engine.records.get(tid.id)
    when Option::Some(rec) then rec.size
    when Option::None then 8
    end
  when _ then 8
  end
  
  # Direct if size <= 16 and is power of 2 (or 0)
  if sz == 0 then return true end
  if sz > 16 then return false end
  # Check power of 2
  sz == 1 || sz == 2 || sz == 4 || sz == 8 || sz == 16
end

# Should a type be returned directly in registers, or via output pointer?
def should_return_directly(engine: &LayoutEngine, ty: &Type) -> Bool
  # Same rules as passing for now
  should_pass_directly(engine, ty)
end

# Get the number of argument registers needed for a type
def arg_register_count(engine: &LayoutEngine, ty: &Type) -> Int
  let sz = match ty
  when Type::Unit then 0
  when Type::Tuple(fields) then fields.len()  # Each field in separate register
  when _ then
    if should_pass_directly(engine, ty) then 1 else 1 end  # Indirect = 1 pointer
  end
  sz
end

# ———————————————————————————————————————————————————————————————
# Pre-compute all layouts (call after registering types)
# ———————————————————————————————————————————————————————————————

def compute_all_layouts(engine: &mut LayoutEngine) -> Unit
  # First pass: insert placeholder records to break cycles
  for td in engine.type_defs do
    engine.records.insert(td.id.id, LayoutRecord {
      type_id: td.id.id,
      name: td.name.clone(),
      category: LayoutCategory::ZeroSized,
      size: 0,
      align: 1,
      stride: 0,
      field_count: 0,
      fields: Vec::new(),
      variants: Vec::new(),
      tag_offset: 0,
      tag_size: 0,
      header_size: 0,
      payload_offset: 0,
      hash: 0
    })
  end

  # Second pass: compute real layouts
  for td in engine.type_defs do
    let rec = compute_type_layout(engine, td.id.id)
    engine.records.insert(td.id.id, rec)
  end
end