# tg_compiler/layout_engine.tg — Centralized Layout Engine
# SINGLE SOURCE OF TRUTH for all type layout queries.
# All compiler phases (interpreter, verifier, lowering, codegen, stdlib) must use this API.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
# NOTE: the std EnumLayout is NOT imported — the ONE EnumLayout authority is
# defined in this module (see the EnumLayout section below). The std
# Layout.enum_layout field is a flat projection that no consumer reads; the
# rich EnumLayout lives here.
use std::alloc::{Layout, FieldLayout, VariantLayout}
use tg_compiler::types::{Type, TypeId, subst_type_args}
use tg_compiler::mir::{MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef, mir_type_identity_key}

# ———————————————————————————————————————————————————————————————
# Failure Class Categorization
# ———————————————————————————————————————————————————————————————

# Every layout-related bug must be tagged as one of these categories.
# This prevents "memory offset" bugs from becoming one huge vague pile.
enum LayoutFailureClass
  # The central layout engine computed the wrong size/alignment/offset.
  LAYOUT_COMPUTATION_BUG
  
  # The layout engine is right, but lowering/codegen/runtime used it wrong.
  LAYOUT_CONSUMER_BUG
  
  # Heap object / fat pointer / closure / string / slice header layout is inconsistent.
  HEADER_MODEL_BUG
  
  # FFI or call lowering uses a different memory convention.
  ABI_BOUNDARY_BUG
  
  # Pointer size, endianness, alignment policy, or ABI rules are wrong for target.
  TARGET_DESCRIPTOR_BUG
  
  # The type is not resolved to a concrete type (Var, Error, generic param).
  UNRESOLVED_TYPE
  
  # The type has no supported concrete layout in the engine.
  UNSUPPORTED_TYPE
end

# Diagnostic error with failure class
struct LayoutError
  class: LayoutFailureClass
  message: String
  type_name: String
  expected: Int
  actual: Int
  context: String  # File:line or function name where error occurred
end

def layout_error_to_string(err: &LayoutError) -> String
  let class_str = match err.class
  when LayoutFailureClass::LAYOUT_COMPUTATION_BUG then "LAYOUT_COMPUTATION_BUG"
  when LayoutFailureClass::LAYOUT_CONSUMER_BUG then "LAYOUT_CONSUMER_BUG"
  when LayoutFailureClass::HEADER_MODEL_BUG then "HEADER_MODEL_BUG"
  when LayoutFailureClass::ABI_BOUNDARY_BUG then "ABI_BOUNDARY_BUG"
  when LayoutFailureClass::TARGET_DESCRIPTOR_BUG then "TARGET_DESCRIPTOR_BUG"
  when LayoutFailureClass::UNRESOLVED_TYPE then "UNRESOLVED_TYPE"
  when LayoutFailureClass::UNSUPPORTED_TYPE then "UNSUPPORTED_TYPE"
  end
  "[" + class_str + "] " + err.message + " for type '" + err.type_name + 
    "': expected " + err.expected.to_string() + ", got " + err.actual.to_string() +
    " at " + err.context
end

# ———————————————————————————————————————————————————————————————
# Canonical Layout Categories (Step 2)
# ———————————————————————————————————————————————————————————————

enum LayoutCategory
  # Fixed-width integer and float types
  Primitive
  # Pointer-width types (references, raw pointers, Box)
  Pointer
  # Fat pointer types (slices, trait objects)
  FatPointer
  # Inline aggregates (structs laid out field-by-field)
  InlineStruct
  # Discriminated unions (enums with tag + max_payload)
  TaggedUnion
  # Dynamically-sized containers (Vec, String, Map, Set)
  DynContainer
  # Zero-sized types (Unit, Never, zero-variant enums)
  ZeroSized
  # Function types (raw function pointers)
  FunctionType
end

# ———————————————————————————————————————————————————————————————
# P0-AR: Runtime Value Representation — THE DECISION TABLE
# ———————————————————————————————————————————————————————————————
# ONE place states how every fundamental type's runtime value is stored.
# Every layout query (size_of, align_of, layout_of, struct field placement,
# enum payload placement, tuple element placement, container header sizes)
# consults type_repr and NEVER re-decides the storage shape.
#
#   TYPE                                 | REPRESENTATION  | OWNS MEMORY | COPY OP
#   —————————————————————————————————————+—————————————————+—————————————+——————————
#   Int, UInt, Float, Char, Bool,         |                 |             |
#     I8..I128, U8..U128, ISize, USize,   |                 |             |
#     F32, F64, Unit, Never               | Immediate       | No          | bit
#   Ptr[T], PtrMut[T], RefInternal        | RawPtr          | No          | bit
#   Box[T], Rc[T]                         | RawPtr          | Yes         | move
#   String                                | StringPtr       | Yes         | clone
#   Vec[T], Array[T]                      | HeapVecHeader   | Yes         | move + clone
#   FixedArray[T, N] (any N >= 0)         | Inline          | N elements  | structural
#   Slice[T]                              | Inline view     | No          | bit
#     ({ptr: Ptr[T] @0, len: UInt @8})
#   Map[K,V]                              | HeapMapHeader   | Yes         | move + clone
#   Set[T]                                | HeapSetHeader   | Yes         | move + clone
#   struct                                | Inline          | fields      | structural
#   enum                                  | Inline (tagged) | variants    | structural
#   Option[T], Result[T,E]                | Inline (tagged) | variants    | structural
#     (registered enums like any other — the runtime VALUE is the TaggedPtr
#      word described by their EnumLayout; no name-based OpaquePtr special
#      case exists)
#   Dyn[T], Effect                        | OpaquePtr       | payload    | move + clone
#   FnPtr / Closure                       | OpaquePtr       | env: Yes    | move
#     (the closure VALUE is one pointer to the closure OBJECT { code @ 0,
#      env: capture-tuple } — the object layout is registered by ClosureId)
#   Var, Param, Error, unknown            | Invalid         | —          | —
#     (unresolved types have NO representation; every layout query on them
#      must fail closed — never a guessed pointer word)
#
# Heap header sizes (F2 FROZEN — must agree with codegen/runtime; the value
# itself is always ONE pointer-width handle, these are the sizes of the
# heap objects the handle points at):
#   StringPtr     -> 8   (raw pointer to null-terminated UTF-8; NO inline header)
#   HeapVecHeader -> 32  ({data:0, len:8, cap:16, stride:24} — the heap
#                         object behind Vec/Array values. The stride field
#                         (element stride in bytes, set from the CONCRETE
#                         element type at creation: 1/2/4/8 for immediate
#                         scalars, 8 for pointer-represented values, the
#                         aligned fixed-array size for [T; N] elements) is
#                         the runtime's element-addressing authority — every
#                         _tg_array_* helper computes data + i*stride and
#                         releases cap*stride bytes. Slice is NOT in this
#                         class: a Slice value is a 16-byte inline {ptr,len}
#                         VIEW)
#   HeapMapHeader -> 88  (the runtime's actual Map header — an 88-byte raw
#                         byte arena plus the CONCRETE layout parameters:
#                         {buckets:0, size:8, capacity:16, key_stride:24,
#                         key_align:32, value_stride:40, value_align:48,
#                         key_off:56, value_off:64, next_off:72,
#                         bucket_stride:80} — runtime.tg "Map header (88
#                         bytes)". The four derived layout fields
#                         (key_off/value_off/next_off/bucket_stride) are
#                         computed once at map creation from the four layout
#                         parameters; the runtime derives nothing)
#   HeapSetHeader -> 88  (Set is MAP-BACKED — the runtime's _tg_set_* helpers
#                         tail-call the map helpers, so the Set header IS the
#                         same 88-byte map header)
#
#   Storage size rules derived from this table (repr_storage_size):
#   Immediate  -> the intrinsic primitive size (primitive_size)
#   RawPtr, StringPtr, Heap*, TaggedPtr -> target.pointer_size (8)
#   Inline     -> the full inline aggregate size (struct/enum/tuple/fixed array)
#   OpaquePtr  -> target.fn_ptr_size for FnPtr, else target.pointer_size
#   Invalid    -> NO layout (unresolved/error type): every consumer must fail
#                 closed — panicking ICE — never assume a word
#
# FIXED ARRAYS: the [T; N] annotation is the DISTINCT Type::FixedArray(elem,
# n) variant (the reviewer's FixedArray[T, N] — the count lives IN the type;
# the heap-vector Adt Array form no longer doubles as a fixed array).
# FixedArray(elem, n) is ALWAYS
# Inline storage of n elements (stride = align_up(elem size, elem align),
# total size = n * stride; n == 0 is a legal zero-length fixed array with
# size 0). The named Array[T] syntax (the heap vector) is the Adt form with
# the LangItems array id and stays HeapVecHeader — a pointer-sized handle,
# never inline.
#
# SLICE (the reviewer's no-general-borrow view model — adopted): Slice[T] is
# a COMPILER-SCOPED VIEW, the plain two-field aggregate
#     Slice[T] = { ptr: Ptr[T] @ 0, len: UInt @ 8 }
# (a 16-byte inline value, Repr::Inline — the same shape as the std's
# StrView / FfiSlice). It owns NO memory (owns=false), needs NO drop, and
# is bit-copyable. It is NOT a pointer to a heap {ptr,len,cap} Vec header:
# Slice values carry no capacity, and no consumer may read a Slice through a
# HeapVecHeader offset. Escape (storing a view beyond the lifetime of its
# backing buffer) is constrained by the safe access model — the
# projected-access enforcement of the resource checker's IterationPlan is
# the eventual mechanism (see the Slice contract in std/collections.tg).
#
# (TaggedPtr is the enum VALUE encoding — one pointer-width word holding a
# raw discriminant below the inline-tag threshold or a heap pointer (at/above
# the threshold) to the inline tagged image the engine computes (F3). The
# encoding decision lives in EnumLayout — the single enum-representation
# authority (see the EnumLayout section); codegen asks it questions and never
# contains the boundary policy.)

enum Repr
  Immediate      # value bits ARE the value (primitives, Unit, Never)
  RawPtr         # raw pointer to memory (Ptr/PtrMut/Box/Rc/RefInternal)
  StringPtr      # 8-byte raw pointer to null-terminated UTF-8 (FROZEN String ABI)
  HeapVecHeader  # pointer to a heap {ptr,len,cap} header (Vec/Array — NOT Slice)
  HeapMapHeader  # pointer to a heap Map header
  HeapSetHeader  # pointer to a heap Set header
  Inline         # stored field-by-field inline (structs, tagged enums, tuples)
  TaggedPtr      # reserved: pointer with tag bits (not used by the engine today)
  OpaquePtr      # opaque pointer-sized handle (Dyn/Effect/FnPtr/Closure)
  Invalid        # explicit INVALID representation: Var/Param/Error/unknown —
                 # unresolved types have no representation. Layout queries on
                 # Invalid MUST fail closed (panic ICE), never guess a word.
end

# THE single decision function: the representation of a type's runtime
# value, per the DECIDED model documented above.  Every storage-shape
# decision in this engine reads from here.
#
# FAIL-CLOSED (P0-UR): unresolved types — Type::Var, Type::Param,
# Type::Error and anything the match does not name — return Repr::Invalid,
# NEVER a plausible OpaquePtr. A layout query on an unresolved type is a
# compiler bug (the strict path layout_of_concrete rejects those types with
# a LayoutError before codegen); returning a guessed word here would let the
# bug pass silently as an 8-byte value. Consumers of Repr must treat
# Invalid as an internal error.
def type_repr(engine: &LayoutEngine, ty: &Type) -> Repr
  match ty
  when Type::Unit    then Repr::Immediate
  when Type::Bool    then Repr::Immediate
  when Type::Int     then Repr::Immediate
  when Type::UInt    then Repr::Immediate
  when Type::Float   then Repr::Immediate
  when Type::Char    then Repr::Immediate
  when Type::Never   then Repr::Immediate
  when Type::I8      then Repr::Immediate
  when Type::I16     then Repr::Immediate
  when Type::I32     then Repr::Immediate
  when Type::I64     then Repr::Immediate
  when Type::I128    then Repr::Immediate
  when Type::U8      then Repr::Immediate
  when Type::U16     then Repr::Immediate
  when Type::U32     then Repr::Immediate
  when Type::U64     then Repr::Immediate
  when Type::U128    then Repr::Immediate
  when Type::ISize   then Repr::Immediate
  when Type::USize   then Repr::Immediate
  when Type::F32     then Repr::Immediate
  when Type::F64     then Repr::Immediate
  when Type::String  then Repr::StringPtr
  when Type::RefInternal(_, _) then Repr::RawPtr
  when Type::Ptr(_)        then Repr::RawPtr
  when Type::PtrMut(_)     then Repr::RawPtr
  when Type::FnPtr(_, _) then Repr::OpaquePtr
  when Type::Closure(_, _, _, _) then Repr::OpaquePtr
  when Type::Dyn(_)        then Repr::OpaquePtr
  when Type::Effect(_, _)  then Repr::OpaquePtr
  when Type::Tuple(_)      then Repr::Inline
  when Type::FixedArray(_, _) then Repr::Inline
  when Type::Adt(tid, args) then
    # P0-J2: Adt form of the builtin compound types (storage form).
    # Mirrors the deleted canonical arms via the registered type name; the
    # Adt form of Array is the heap-vector (named Array[T] — the fixed
    # arrays are the distinct Type::FixedArray variant, which never reaches
    # this arm). Option/Result are registered enums — they get the SAME
    # representation as every other registered enum (Inline via
    # named_type_repr): there is NO name-based OpaquePtr special case for
    # them. Anything else keeps the pre-existing named fallback.
    let named_repr_name = lookup_type_name(engine, tid.id)
    if named_repr_name == "Box" then Repr::RawPtr
    elsif named_repr_name == "Rc" then Repr::RawPtr
    # Slice[T] is the two-field {ptr: Ptr[T], len: UInt} VIEW (16-byte inline
    # aggregate — see the SLICE note above); it is NOT a HeapVecHeader handle.
    elsif named_repr_name == "Slice" then Repr::Inline
    elsif named_repr_name == "Array" then Repr::HeapVecHeader
    elsif named_repr_name == "Map" then Repr::HeapMapHeader
    elsif named_repr_name == "Set" then Repr::HeapSetHeader
    else named_type_repr(engine, tid.id)
    end
  when Type::Var(_)        then Repr::Invalid
  when Type::Param(_)      then Repr::Invalid
  when Type::Error         then Repr::Invalid
  when _                   then Repr::Invalid
  end
end

# F2 container name -> representation (mirror of container_header_size).
# The engine never sees "Vec"/"Array"/"Map"/"Set"/"String" as registered
# struct definitions (the builtins arrive as Adt forms of their registered
# ids), but the name keys are the frozen F2 ABI table and keep the
# header sizes in the decision table.
def container_repr_for_name(type_name: &String) -> Repr
  if type_name == "String" then Repr::StringPtr
  else if type_name == "Vec" || type_name == "Array" then Repr::HeapVecHeader
  else if type_name == "Map" || type_name == "HashMap" then Repr::HeapMapHeader
  else if type_name == "Set" || type_name == "HashSet" then Repr::HeapSetHeader
  else Repr::OpaquePtr
  end
end

# Representation of a registered named type (struct/enum).  Container names
# win over the definition kind: a Named "Vec" is a compiler intrinsic whose
# value is a heap header handle, never an inline aggregate.
def named_type_repr(engine: &LayoutEngine, type_id: Int) -> Repr
  let name = lookup_type_name(engine, type_id)
  let container_repr = container_repr_for_name(&name)
  if container_repr != Repr::OpaquePtr then
    return container_repr
  end

  # Registered definitions: structs and enums are stored inline (F7/F3).
  for td in engine.type_defs do
    if td.id.id == type_id then
      match td.kind
      when MirTypeDefKind::Struct(_) then return Repr::Inline
      when MirTypeDefKind::Enum(_)   then return Repr::Inline
      end
    end
  end

  # Unregistered named type: FAIL CLOSED — the generic-parameter SLOT
  # convention is DELETED (P0-CK). A generic definition is never laid out
  # nominally: every layout is computed under a ConcreteTypeKey with the
  # def's fields SUBSTITUTED (see compute_type_layout / substituted_type_def),
  # so a Type::Param never reaches a field placement. An unregistered Adt at
  # a VALUE site is a lowering/verifier defect — Repr::Invalid makes every
  # storage query panic instead of guessing a pointer word.
  Repr::Invalid
end

# Heap header size for a representation (F2 FROZEN; 0 = no heap header).
# Map and Set share the runtime's actual 88-byte map header
# ({buckets:0, size:8, capacity:16, key_stride:24, key_align:32,
# value_stride:40, value_align:48, key_off:56, value_off:64, next_off:72,
# bucket_stride:80} — Set is map-backed, see runtime.tg).
# The Vec header carries the element stride at offset 24 (32 bytes total) —
# the runtime's element-addressing authority; the layout values stored there
# come from the CONCRETE element type at each creation site (codegen passes
# element_stride_bytes(T), the same authority ProjIndex uses).
def repr_header_size(repr: Repr) -> Int
  match repr
  when Repr::StringPtr     then 8
  when Repr::HeapVecHeader then 32
  when Repr::HeapMapHeader then 88
  when Repr::HeapSetHeader then 88
  when Repr::Invalid       then
    panic("layout: header-size query on Repr::Invalid (unresolved type) — must fail closed, never a guess")
  when _                   then 0
  end
end

# The byte size a value of `ty` occupies in a storage slot (struct field,
# enum payload field, tuple element, or any slot that holds the value).
# This is the ONE storage decision for every aggregate placement; it
# consults type_repr and never re-decides the storage shape.
def repr_storage_size(engine: &mut LayoutEngine, ty: &Type) -> Int
  match type_repr(engine, ty)
  when Repr::Immediate then
    # Intrinsic sizes (primitive_size).  String is NOT here: it is
    # StringPtr, whose slot size is one pointer.
    let ps = primitive_size(engine, ty)
    if ps >= 0 then ps else 0 end
  when Repr::Inline then
    inline_storage_size(engine, ty)
  when Repr::RawPtr      then engine.target.pointer_size
  when Repr::StringPtr   then engine.target.pointer_size
  when Repr::HeapVecHeader then engine.target.pointer_size
  when Repr::HeapMapHeader then engine.target.pointer_size
  when Repr::HeapSetHeader then engine.target.pointer_size
  when Repr::TaggedPtr   then engine.target.pointer_size
  when Repr::OpaquePtr   then
    match ty
  when Type::FnPtr(_, _) then engine.target.fn_ptr_size
  when Type::Closure(_, _, _, _) then engine.target.fn_ptr_size
    when _ then engine.target.pointer_size
    end
  when Repr::Invalid     then
    panic("layout: storage-size query on an unresolved type (Repr::Invalid) — must fail closed, never a guessed pointer word")
  end
end

# Alignment counterpart of repr_storage_size: the alignment a slot holding
# a value of `ty` must have.
def repr_storage_align(engine: &mut LayoutEngine, ty: &Type) -> Int
  match type_repr(engine, ty)
  when Repr::Immediate then primitive_align(engine, ty)
  when Repr::Inline then
    match ty
    when Type::Adt(tid, args) then
      # P0-J2: Adt form of Array mirrors the deleted canonical Array arm
      # (element alignment); the named Array[T] form is the heap-vector and
      # never reaches the Inline case — the fixed arrays are the distinct
      # Type::FixedArray variant below.
      if is_slice_view_tid(engine, tid.id) then
        # Slice[T] is the two-field {ptr,len} view: alignment is the pointer
        # alignment (both fields are pointer-width).
        engine.target.pointer_align
      elsif lookup_type_name(engine, tid.id) == "Array" && !args.is_empty() then
        repr_storage_align(engine, &args[0])
      else
        # P0-CK: concrete-keyed — the substituted def's layout under THIS
        # Adt's args (Wrapper[u8] align 1, Wrapper[Int] align 8, ...).
        compute_type_layout(engine, ty).align
      end
    when Type::Tuple(fields) then compute_tuple_layout(engine, fields).align
    when Type::FixedArray(elem, _) then repr_storage_align(engine, &elem)
    when _ then engine.target.pointer_align
    end
  when Repr::Invalid     then
    panic("layout: storage-align query on an unresolved type (Repr::Invalid) — must fail closed, never a guessed pointer alignment")
  when _ then engine.target.pointer_align
  end
end

# Fixed inline array storage size: n * element stride, where the element
# stride is align_up(elem size, elem align). The count n comes from the
# Type::FixedArray(elem, n) variant (never a heap-vector sentinel); n == 0
# is a legal zero-length fixed array with size 0.
def inline_array_storage_size(engine: &mut LayoutEngine, elem: &Type, count: Int) -> Int
  if count <= 0 then 0
  else
    let elem_size = repr_storage_size(engine, elem)
    let elem_align = repr_storage_align(engine, elem)
    let elem_stride = layout_align_up(elem_size, elem_align)
    layout_align_up(count * elem_stride, elem_align)
  end
end

# Full inline size of an aggregate: the real layout of a named struct/enum
# (computed on the spot, NEVER a placeholder record — placeholder reads
# during compute_all_layouts would silently report size 0) or of a tuple.
def inline_storage_size(engine: &mut LayoutEngine, ty: &Type) -> Int
  match ty
  when Type::Adt(tid, args) then
    # P0-J2: Adt form of Array mirrors the deleted canonical Array arm; the
    # named Array[T] form is the heap-vector and never reaches the Inline
    # case (type_repr maps it to HeapVecHeader) — the fixed arrays are the
    # distinct Type::FixedArray variant below.
    if is_slice_view_tid(engine, tid.id) then
      # Slice[T] view: 2 pointer-width fields {ptr @ 0, len @ 8}.
      slice_view_layout(engine).size
    elsif lookup_type_name(engine, tid.id) == "Array" && !args.is_empty() then
      inline_array_storage_size(engine, &args[0], 0)
    else
      # P0-CK: concrete-keyed — the substituted def's layout under THIS
      # Adt's args (never a nominal record, never a pointer slot).
      compute_type_layout(engine, ty).size
    end
  when Type::Tuple(fields) then
    compute_tuple_layout(engine, fields).size
  when Type::FixedArray(elem, n) then
    inline_array_storage_size(engine, &elem, n)
  when _ then 0
  end
end

# DFS visit state for the inline layout graph.  A type that reaches itself
# through inline storage only (no pointer/Box indirection) has no finite
# layout and is diagnosed as an infinitely sized recursive type.
enum LayoutVisitState
  Unvisited
  Visiting
  Resolved
end

# ———————————————————————————————————————————————————————————————
# Layout Record (Step 3)
# ———————————————————————————————————————————————————————————————





struct LayoutRecord
  type_id: Int
  name: String
  category: LayoutCategory
  repr: Repr                # Runtime value representation (P0-AR decision table)
  size: Int              # Total size in bytes
  align: Int             # Required alignment in bytes
  stride: Int            # Distance between consecutive elements (>= size, multiple of align)
  field_count: Int       # Number of fields
  
  # Detailed field layouts (for structs)
  fields: Vec[FieldLayout]
  
  # Variant layouts (for enums)
  variants: Vec[VariantLayout]
  
  # Tag info (for enums)
  tag_offset: Int        # Offset of discriminant tag (0 for all enums)
  tag_size: Int          # Size of tag (8 bytes)
  
  # Header info (for heap objects)
  header_size: Int       # 0 for non-heap types
  payload_offset: Int    # Offset of payload from heap object base
  
  # Hash for caching
  hash: Int
end

# ———————————————————————————————————————————————————————————————
# Unified ABI Layout (Single ABI Authority)
# ———————————————————————————————————————————————————————————————

# The canonical result of every layout query.  ABI consumers (codegen,
# lowering, runtime glue) must derive size/alignment/stride/field placement
# and enum tagging from a single Layout value instead of reconstructing
# offsets with ad-hoc `* 8` arithmetic.  This makes the layout engine the
# single authority for the machine-level ABI.

# Discriminated-union (enum) tagging info.




# ———————————————————————————————————————————————————————————————
# Target Layout Descriptor (Step 1)
# ———————————————————————————————————————————————————————————————

struct TargetDescriptor
  arch_name: String        # "aarch64" or "x86_64"
  pointer_size: Int        # 8 for LP64
  pointer_align: Int       # 8 for LP64
  max_align: Int           # Maximum natural alignment
  int_size: Int            # 8 for LP64
  bool_size: Int           # 1 (memory representation)
  char_size: Int           # 4 (Unicode scalar)
  fn_ptr_size: Int         # 16 (Tangerine closure: code ptr + env ptr)
  float_size: Int          # 8 (f64)
  double_size: Int         # 8 (f64, same as float)
  endianness: String       # "little" or "big"
  stack_align: Int         # Stack alignment (16)
end

# Pre-defined target descriptors
def aarch64_target() -> TargetDescriptor
  TargetDescriptor {
    arch_name: "aarch64",
    pointer_size: 8,
    pointer_align: 8,
    max_align: 16,
    int_size: 8,
    bool_size: 1,
    char_size: 4,
    fn_ptr_size: 16,
    float_size: 8,
    double_size: 8,
    endianness: "little",
    stack_align: 16
  }
end

def x86_64_target() -> TargetDescriptor
  TargetDescriptor {
    arch_name: "x86_64",
    pointer_size: 8,
    pointer_align: 8,
    max_align: 16,
    int_size: 8,
    bool_size: 1,
    char_size: 4,
    fn_ptr_size: 16,
    float_size: 8,
    double_size: 8,
    endianness: "little",
    stack_align: 16
  }
end

# Pre-defined target descriptor for the WASM backend (wasm32: 4-byte
# pointers, 4-byte words — the classifier derives every width from the
# target, so wasm value categories come out pointer-sized (4) automatically).
def wasm32_target() -> TargetDescriptor
  TargetDescriptor {
    arch_name: "wasm32",
    pointer_size: 4,
    pointer_align: 4,
    max_align: 8,
    int_size: 4,
    bool_size: 1,
    char_size: 4,
    fn_ptr_size: 4,
    float_size: 4,
    double_size: 8,
    endianness: "little",
    stack_align: 4
  }
end

# ———————————————————————————————————————————————————————————————
# Centralized Layout Engine (Requirement 2 + Step 3)
# ———————————————————————————————————————————————————————————————

struct LayoutEngine
  target: TargetDescriptor
  # P0-CK: the layout cache is CONCRETE-KEYED — records/visit states are
  # keyed by the canonical render of the concrete Type::Adt(tid, args)
  # (mir_type_identity_key — the SAME (TypeId, substs) identity domain as the
  # MIR's concrete deinit-plan and drop-glue tables). Wrapper[u8],
  # Wrapper[Int], Wrapper[(Int,Int)] and Wrapper[[u8;64]] are DISTINCT keys
  # with DISTINCT records; the nominal TypeId-keyed table is gone (a generic
  # definition has no nominal layout — only concrete instantiations do).
  records: Map[String, LayoutRecord]      # concrete key -> LayoutRecord
  name_index: Map[String, Int]          # type_name -> type_id
  type_defs: Vec[MirTypeDef]            # All type definitions
  visit_states: Map[String, LayoutVisitState]   # Inline-cycle DFS states (concrete-keyed)
  strict_states: Map[String, LayoutVisitState]  # Recursive strict-verification cache (concrete-keyed)
  cache_hits: Int
  cache_misses: Int
end

# Create a new layout engine for a target
def layout_engine_new(target: TargetDescriptor) -> LayoutEngine
  LayoutEngine {
    target: target,
    records: Map::new(),
    name_index: Map::new(),
    type_defs: Vec::new(),
    visit_states: Map::new(),
    strict_states: Map::new(),
    cache_hits: 0,
    cache_misses: 0
  }
end

# ———————————————————————————————————————————————————————————————
# ConcreteTypeKey — THE concrete type identity (P0-CK)
# ———————————————————————————————————————————————————————————————
# The structural key of a concrete Type::Adt(tid, args) instantiation:
#   { def: TypeId, substs: Vec[Type] }.
# This is the LAYOUT AUTHORITY. Every layout query (compute_type_layout,
# the record cache, the inline-cycle recursion detection, the strict
# verification states, size_of/align_of/layout_of, the field-offset queries
# and the enum queries) resolves through the concrete key — a generic
# definition's layout is computed PER SUBSTITUTION, never from a nominal
# TypeId-keyed record and never through a pointer-width placeholder slot.
#
# The canonical render (concrete_type_key_render) reuses
# mir_type_identity_key — the MIR's concrete (TypeId, substs) key for the
# deinit-plan cache and the drop-glue instance table — so the layout cache,
# the plan table and the drop glue share ONE identity domain:
# Wrapper[u8] -> "Named#<wrapper>[U8]" vs Wrapper[Int] ->
# "Named#<wrapper>[Int]" are distinct keys with distinct records.
struct ConcreteTypeKey
  def: TypeId
  substs: Vec[Type]
end

# The ConcreteTypeKey of a type: Option::Some for the Adt form (the only
# nominal layout carrier), Option::None for everything else.
def concrete_type_key_of(ty: &Type) -> Option[ConcreteTypeKey]
  match ty
  when Type::Adt(tid, args) then Option::Some(ConcreteTypeKey { def: tid.clone(), substs: args.clone() })
  when _ then Option::None
  end
end

# Canonical render of a concrete key — the mir_type_identity_key Adt
# rendering ("Named#<def id>[<arg renders>...]"), byte-identical to the
# MIR's concrete plan/drop-glue keys.
def concrete_type_key_render(key: &ConcreteTypeKey) -> String
  let ty = Type::Adt(key.def.clone(), key.substs.clone())
  mir_type_identity_key(&ty)
end

# ———————————————————————————————————————————————————————————————
# The Substituted-Field Computation (P0-CK)
# ———————————————————————————————————————————————————————————————
# A generic definition's FIELDS are substituted under the concrete key
# BEFORE any offset/size is computed: the def's generic_params (declaration
# order — P0-GPI GenericParamIds) are replaced by the key's concrete args
# via subst_type_args. Wrapper[u8]'s field is u8 (size 1/align 1),
# Wrapper[Int]'s is Int (8/8) — the pointer-width generic-slot placeholder
# no longer exists. A parameter the args do not cover stays Type::Param,
# which fails CLOSED at placement (Repr::Invalid — never a guessed word).

# The MirTypeDef of a concrete Adt with its fields/variants substituted
# under the concrete args; Option::None when the def is not registered.
def substituted_type_def(engine: &LayoutEngine, ty: &Type) -> Option[MirTypeDef]
  match ty
  when Type::Adt(tid, args) then
    for td in engine.type_defs do
      if td.id.id == tid.id then
        match td.kind
        when MirTypeDefKind::Struct(fields) then
          var new_fields = Vec::new()
          for f in fields do
            new_fields.push(MirFieldDef {
              name: f.name.clone(),
              ty: subst_type_args(&f.ty, &td.generic_params, args)
            })
          end
          return Option::Some(MirTypeDef {
            id: td.id.clone(),
            name: td.name.clone(),
            kind: MirTypeDefKind::Struct(new_fields),
            generic_params: td.generic_params.clone()
          })
        when MirTypeDefKind::Enum(variants) then
          var new_variants = Vec::new()
          for v in variants do
            var new_fields = Vec::new()
            for fty in v.fields do
              new_fields.push(subst_type_args(fty, &td.generic_params, args))
            end
            new_variants.push(MirVariantDef {
              name: v.name.clone(),
              discriminant: v.discriminant,
              fields: new_fields
            })
          end
          return Option::Some(MirTypeDef {
            id: td.id.clone(),
            name: td.name.clone(),
            kind: MirTypeDefKind::Enum(new_variants),
            generic_params: td.generic_params.clone()
          })
        end
      end
    end
    Option::None
  when _ then Option::None
  end
end

# Substitute a type occurring INSIDE the definition of a concrete Adt (a
# def-level field/variant type) under that Adt's concrete args. Consumers
# that read a MirTypeDef field type (codegen's projected_field_type, the
# enum-eq helper) ask for the CONCRETE type this way.
def substitute_in_concrete_adt(engine: &LayoutEngine, adt_ty: &Type, inner: &Type) -> Type
  match adt_ty
  when Type::Adt(tid, args) then
    for td in engine.type_defs do
      if td.id.id == tid.id then
        return subst_type_args(inner, &td.generic_params, args)
      end
    end
    inner.clone()
  when _ then inner.clone()
  end
end

# Register type definitions (call before computing layouts)
def layout_engine_register_types(engine: &mut LayoutEngine, types: &Vec[MirTypeDef]) -> Unit
  engine.type_defs = types.clone()
  for td in types do
    engine.name_index.insert(td.name.clone(), td.id.id)
  end
end

# ———————————————————————————————————————————————————————————————
# Primitive Type Sizes (F1 - Frozen)
# ———————————————————————————————————————————————————————————————
# NOTE: String is deliberately NOT in this table. Its 8-byte size is the
# StringPtr representation (see type_repr / container_repr_for_name), not
# an Immediate primitive: a String value is an 8-byte raw pointer to a
# null-terminated UTF-8 buffer (FROZEN String ABI).

def primitive_size(engine: &LayoutEngine, ty: &Type) -> Int
  match ty
  when Type::Unit    then 0
  when Type::Bool    then engine.target.bool_size
  when Type::Char    then engine.target.char_size
  when Type::Int     then engine.target.int_size
  when Type::UInt    then engine.target.int_size
  when Type::Float   then engine.target.float_size
  when Type::F32     then 4
  when Type::F64     then 8
  when Type::I8      then 1
  when Type::U8      then 1
  when Type::I16     then 2
  when Type::U16     then 2
  when Type::I32     then 4
  when Type::U32     then 4
  when Type::I64     then 8
  when Type::U64     then 8
  when Type::I128    then 16
  when Type::U128    then 16
  when Type::ISize   then engine.target.pointer_size
  when Type::USize   then engine.target.pointer_size
  when Type::Never   then 0
  when _             then -1   # Not a primitive
  end
end

def primitive_align(engine: &LayoutEngine, ty: &Type) -> Int
  match ty
  when Type::Unit    then 1
  when Type::Bool    then 1
  when Type::Char    then 4
  when Type::I8      then 1
  when Type::U8      then 1
  when Type::I16     then 2
  when Type::U16     then 2
  when Type::I32     then 4
  when Type::U32     then 4
  when Type::F32     then 4
  when Type::I64     then 8
  when Type::U64     then 8
  when Type::F64     then 8
  when Type::I128    then 16
  when Type::U128    then 16
  when Type::ISize   then engine.target.pointer_align
  when Type::USize   then engine.target.pointer_align
  when _             then engine.target.pointer_align  # Default to pointer alignment
  end
end

# ———————————————————————————————————————————————————————————————
# Layout Computation Core
# ———————————————————————————————————————————————————————————————

# Align value up to alignment boundary.
# Kept module-unique to avoid collisions with other tg_compiler helpers during bootstrap MIR merge.
def layout_align_up(value: Int, align: Int) -> Int
  if align <= 1 then
    return value
  end
  let rem = value % align
  if rem == 0 then value else value + (align - rem) end
end

# Compute hash for a layout record (for caching)
def compute_layout_hash(name: &String, size: Int, align: Int, field_count: Int) -> Int
  # Simple hash using Int to avoid interpreter UInt64 issues
  var h: Int = 5381
  let name_len = name.len()
  var idx = 0
  while idx < name_len do
    h = ((h * 33) + (name.char_at(idx) as Int)) % 2147483647
    idx = idx + 1
  end
  h = ((h * 33) + size) % 2147483647
  h = ((h * 33) + align) % 2147483647
  h = ((h * 33) + field_count) % 2147483647
  h
end

# Get the size of a type (main entry point)
# Every storage-shape decision is delegated to type_repr (the P0-AR
# decision table); no branch re-decides the representation here.
# FAIL-CLOSED: unresolved/error types (Var/Param/Error/unknown) have no
# layout — this query panics (ICE); the strict path (layout_of_concrete)
# returns Result::Err for them before any value query reaches codegen.
def size_of(engine: &mut LayoutEngine, ty: &Type) -> Int
  match type_repr(engine, ty)
  when Repr::Immediate then
    let prim_size = primitive_size(engine, ty)
    if prim_size >= 0 then
      prim_size
    else
      0
    end
  when Repr::Inline then
    match ty
    when Type::Adt(tid, args) then
      # P0-J2: Adt form of Array mirrors the deleted canonical Array arm with
      # the named Array[T] heap-vector identity only (fixed arrays are the
      # distinct Type::FixedArray variant).
      if is_slice_view_tid(engine, tid.id) then
        # Slice[T] view: the 16-byte {ptr, len} aggregate.
        slice_view_layout(engine).size
      elsif lookup_type_name(engine, tid.id) == "Array" && !args.is_empty() then
        inline_array_storage_size(engine, &args[0], 0)
      else
        # Look up the cached CONCRETE record (P0-CK): keyed by the canonical
        # (TypeId, substs) render of THIS Adt — Wrapper[u8] and Wrapper[Int]
        # are distinct entries. A miss computes the substituted layout.
        let ckey = mir_type_identity_key(ty)
        match engine.records.get(&ckey)
        when Option::Some(rec) then
          engine.cache_hits = engine.cache_hits + 1
          rec.size
        when Option::None then
          engine.cache_misses = engine.cache_misses + 1
          # Compute and cache (the def's fields substituted under this key)
          let rec = compute_type_layout(engine, ty)
          rec.size
        end
      end
    when Type::Tuple(fields) then
      let tl = compute_tuple_layout(engine, fields)
      tl.size
    when Type::FixedArray(elem, n) then
      inline_array_storage_size(engine, &elem, n)
    when _ then 0
    end
  when Repr::RawPtr      then engine.target.pointer_size
  when Repr::StringPtr   then engine.target.pointer_size
  when Repr::HeapVecHeader then engine.target.pointer_size
  when Repr::HeapMapHeader then engine.target.pointer_size
  when Repr::HeapSetHeader then engine.target.pointer_size
  when Repr::TaggedPtr   then engine.target.pointer_size
  when Repr::OpaquePtr   then
    match ty
  when Type::FnPtr(_, _) then engine.target.fn_ptr_size
  when Type::Closure(_, _, _, _) then engine.target.fn_ptr_size
    when _ then engine.target.pointer_size
    end
  when Repr::Invalid     then
    panic("layout: size_of on an unresolved type (Repr::Invalid) — must fail closed, never a guessed pointer word")
  end
end

# Get the alignment of a type
# Delegates to type_repr (P0-AR decision table), never re-deciding.
# FAIL-CLOSED: unresolved types (Repr::Invalid) panic instead of falling
# back to a pointer alignment guess.
def align_of(engine: &mut LayoutEngine, ty: &Type) -> Int
  match type_repr(engine, ty)
  when Repr::Immediate then
    # Primitive intrinsic alignments.  This intentionally returns
    # pointer_align for Never (8), preserving the pre-existing value.
    primitive_align(engine, ty)
  when Repr::Inline then
    match ty
    when Type::Tuple(fields) then
      let tl = compute_tuple_layout(engine, fields)
      tl.align
    when Type::Adt(tid, args) then
      # P0-J2: Adt form of Array mirrors the deleted canonical Array arm
      # (element alignment); the fixed arrays are the distinct Type::FixedArray
      # variant below.
      if is_slice_view_tid(engine, tid.id) then
        # Slice[T] view: pointer alignment (both fields are pointer-width).
        engine.target.pointer_align
      elsif lookup_type_name(engine, tid.id) == "Array" && !args.is_empty() then
        repr_storage_align(engine, &args[0])
      else
        # P0-CK: concrete-keyed — compute the substituted layout on a miss
        # (never a pointer-alignment guess).
        let ckey = mir_type_identity_key(ty)
        match engine.records.get(&ckey)
        when Option::Some(rec) then rec.align
        when Option::None then compute_type_layout(engine, ty).align
        end
      end
    when Type::FixedArray(elem, _) then repr_storage_align(engine, &elem)
    when _ then engine.target.pointer_align
    end
  when Repr::Invalid     then
    panic("layout: align_of on an unresolved type (Repr::Invalid) — must fail closed, never a guessed pointer alignment")
  when _ then engine.target.pointer_align
  end
end

# Get the stride of a type (distance between array elements)
def stride_of(engine: &mut LayoutEngine, ty: &Type) -> Int
  let sz = size_of(engine, ty)
  let al = align_of(engine, ty)
  layout_align_up(sz, al)
end

# ———————————————————————————————————————————————————————————————
# Unified Layout Query (Single ABI Authority)
# ———————————————————————————————————————————————————————————————

# Return a complete Layout for a type.  This is the canonical ABI query:
# consumers should use layout_of instead of reconstructing size/align/
# stride/field offsets independently.  Storage shapes come from type_repr
# (P0-AR decision table); no branch re-decides the representation.
# FAIL-CLOSED: unresolved/error types (Repr::Invalid) panic — never a
# pointer-sized guess (use layout_of_concrete for the Result form).
def layout_of(engine: &mut LayoutEngine, ty: &Type) -> Layout
  match type_repr(engine, ty)
  when Repr::Immediate then
    let prim_size = primitive_size(engine, ty)
    if prim_size >= 0 then
      let psize = prim_size
      let palign = primitive_align(engine, ty)
      Layout {
        size: psize,
        align: palign,
        stride: layout_align_up(psize, palign),
        fields: Vec::new(),
        enum_layout: Option::None
      }
    else
      # No Immediate type is outside primitive_size (Unit/Never included);
      # defensive fallback.
      pointer_layout(engine)
    end
  when Repr::Inline then
    match ty
    when Type::Tuple(fields) then tuple_layout(engine, fields)
    when Type::Adt(tid, args) then
      # P0-J2: Adt form of Array mirrors the deleted canonical Array arm with
      # the named Array[T] heap-vector identity only (fixed arrays are the
      # distinct Type::FixedArray variant below).
      if is_slice_view_tid(engine, tid.id) then
        # Slice[T] is the two-field {ptr,len} view — the 16-byte aggregate.
        slice_view_layout(engine)
      elsif lookup_type_name(engine, tid.id) == "Array" && !args.is_empty() then
        let sz = inline_array_storage_size(engine, &args[0], 0)
        let al = repr_storage_align(engine, &args[0])
        Layout {
          size: sz,
          align: al,
          stride: layout_align_up(sz, al),
          fields: Vec::new(),
          enum_layout: Option::None
        }
      else
        # P0-CK: the substituted def's layout under THIS Adt's args.
        let rec = compute_type_layout(engine, ty)
        record_to_layout(&rec)
      end
    when Type::FixedArray(elem, n) then
      let sz = inline_array_storage_size(engine, &elem, n)
      let al = repr_storage_align(engine, &elem)
      Layout {
        size: sz,
        align: al,
        stride: layout_align_up(sz, al),
        fields: Vec::new(),
        enum_layout: Option::None
      }
    when _ then pointer_layout(engine)
    end
  when Repr::RawPtr      then pointer_layout(engine)
  when Repr::StringPtr   then pointer_layout(engine)
  when Repr::HeapVecHeader then pointer_layout(engine)
  when Repr::HeapMapHeader then pointer_layout(engine)
  when Repr::HeapSetHeader then pointer_layout(engine)
  when Repr::TaggedPtr   then pointer_layout(engine)
  when Repr::OpaquePtr   then
    match ty
  when Type::FnPtr(_, _) then fn_ptr_layout(engine)
  when Type::Closure(_, _, _, _) then fn_ptr_layout(engine)
    when _ then pointer_layout(engine)
    end
  when Repr::Invalid     then
    panic("layout: layout_of on an unresolved type (Repr::Invalid) — must fail closed, never a guessed pointer-sized Layout")
  end
end

# ———————————————————————————————————————————————————————————————
# Recursive Strict Concrete-Layout Verification (P0-AS)
# ———————————————————————————————————————————————————————————————
# The lenient size_of/layout_of now FAIL CLOSED on unresolved types
# (Repr::Invalid panics — see type_repr), so no caller can silently read a
# guessed word. The strict path is the Result-based form of the same rule:
# it recursively proves that a type and all of its inline children have
# concrete layouts, returning Result::Err instead of panicking.
#
# Inline children are named types stored by value (struct fields, enum
# payloads, tuple elements).  Indirections — pointers (Ptr/PtrMut/Ref),
# Box/Rc, slices (the {ptr,len} view holds a raw pointer), arrays and heap
# containers (Map/Set/Function/String) — do not require
# their pointee to be resolved.
# P0-CK: the strict walk is CONCRETE-keyed — a generic definition's fields
# are SUBSTITUTED under the queried Adt's args before the children are
# proven (check_concrete_layout on Type::Adt(tid, args) proves the
# substituted fields, never the template's params, and never a
# pointer-width placeholder). A named type with no registered definition
# FAILS the strict check (the generic-slot convention is deleted).

def check_concrete_layout(engine: &mut LayoutEngine, ty: &Type) -> Result[Unit, LayoutError]
  match ty
  when Type::Var(_) then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Type variable has no concrete layout",
      type_name: "Type::Var",
      expected: 0,
      actual: 0,
      context: "check_concrete_layout"
    })
  when Type::Error then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Error type has no concrete layout",
      type_name: "Type::Error",
      expected: 0,
      actual: 0,
      context: "check_concrete_layout"
    })
  when Type::Param(name) then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Generic parameter has no concrete layout",
      type_name: "Type::Param(#" + name.index.to_string() + ")",
      expected: 0,
      actual: 0,
      context: "check_concrete_layout"
    })
  when Type::Adt(tid, args) then
    # P0-J2: Adt form of Array is the heap-vector identity (the named
    # Array[T]) — an opaque pointer-sized handle, concrete without
    # inspecting the pointee (fixed inline arrays are the distinct
    # Type::FixedArray variant). Slice[T] is the two-field view builtin —
    # also concrete without inspecting the element (the view holds a raw
    # pointer; the element's own layout lives behind the indirection).
    if lookup_type_name(engine, tid.id) == "Array" || is_slice_view_tid(engine, tid.id) then
      Result::Ok(())
    else
      if engine_has_type_def(engine, tid.id) then
        # P0-CK: the recursion state and the inline-children walk are
        # CONCRETE-keyed — the def's fields are SUBSTITUTED under this
        # Adt's args before the children are proven (Option[File] proves
        # File; Option[Int] proves Int; a generic template with empty args
        # keeps its Params and fails closed below).
        let ckey = mir_type_identity_key(ty)
        let state = match engine.strict_states.get(&ckey)
        when Option::Some(s) then s
        when Option::None then LayoutVisitState::Unvisited
        end
        match state
        when LayoutVisitState::Visiting then
          # Reached through inline storage only: infinitely sized recursive type.
          Result::Err(LayoutError {
            class: LayoutFailureClass::UNSUPPORTED_TYPE,
            message: "Infinitely sized recursive type: reaches itself through inline storage without an indirection",
            type_name: lookup_type_name(engine, tid.id),
            expected: 0,
            actual: 0,
            context: "check_concrete_layout"
          })
        when LayoutVisitState::Resolved then
          Result::Ok(())
        when LayoutVisitState::Unvisited then
          engine.strict_states.insert(ckey.clone(), LayoutVisitState::Visiting)
          # Prove every inline child of the definition recursively, with the
          # concrete args substituted into the field/variant types.
          match substituted_type_def(engine, ty)
          when Option::Some(std) then
            match std.kind
            when MirTypeDefKind::Struct(fields) then
              for f in fields do
                match check_concrete_layout(engine, &f.ty)
                when Result::Err(e) then
                  engine.strict_states.insert(ckey.clone(), LayoutVisitState::Unvisited)
                  return Result::Err(e)
                when Result::Ok(()) then ()
                end
              end
            when MirTypeDefKind::Enum(variants) then
              for v in variants do
                for fty in v.fields do
                  match check_concrete_layout(engine, fty)
                  when Result::Err(e) then
                    engine.strict_states.insert(ckey.clone(), LayoutVisitState::Unvisited)
                    return Result::Err(e)
                  when Result::Ok(()) then ()
                  end
                end
              end
            end
          when Option::None then
            # Registered per engine_has_type_def but not found in the walk:
            # internal inconsistency — fail closed.
            return Result::Err(LayoutError {
              class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
              message: "Registered type definition missing from the engine's def table during the strict walk",
              type_name: lookup_type_name(engine, tid.id),
              expected: 0,
              actual: 0,
              context: "check_concrete_layout"
            })
          end
          engine.strict_states.insert(ckey, LayoutVisitState::Resolved)
          Result::Ok(())
        end
      else
        # Unregistered named type: FAIL CLOSED — the generic-parameter slot
        # placeholder is deleted (P0-CK); an unregistered Adt has no layout.
        Result::Err(LayoutError {
          class: LayoutFailureClass::UNSUPPORTED_TYPE,
          message: "No type definition registered for type id",
          type_name: "type#" + tid.id.to_string(),
          expected: 0,
          actual: 0,
          context: "check_concrete_layout"
        })
      end
    end
  when Type::Tuple(fields) then
    # Inline aggregate: every element must be concrete.
    for f in fields do
      match check_concrete_layout(engine, f)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(()) then ()
      end
    end
    Result::Ok(())
  when Type::FixedArray(elem, n) then
    # Fixed arrays are INLINE element storage: every element must be
    # concrete. A zero-length array (n == 0) stores no elements, so it is
    # concrete regardless of the element type.
    if n > 0 then
      match check_concrete_layout(engine, &elem)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(()) then Result::Ok(())
      end
    else
      Result::Ok(())
    end
  when _ then
    # Primitives, pointers, Box/Rc, slices, heap containers, function types:
    # fixed-size or opaque handle — concrete without inspecting the pointee.
    Result::Ok(())
  end
end

# Strict concrete layout query: returns Err instead of guessing pointer sizes
# for unresolved types (Var, Error, generic params), unknown named types, and
# types with unresolved INLINE children.  The failure propagates to callers
# (codegen's layout_of_strict panics with the LayoutError's type_name).
def layout_of_concrete(engine: &mut LayoutEngine, ty: &Type) -> Result[Layout, LayoutError]
  match ty
  when Type::Var(_) then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Type variable has no concrete layout",
      type_name: "Type::Var",
      expected: 0,
      actual: 0,
      context: "layout_of_concrete"
    })
  when Type::Error then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Error type has no concrete layout",
      type_name: "Type::Error",
      expected: 0,
      actual: 0,
      context: "layout_of_concrete"
    })
  when Type::Param(name) then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Generic parameter has no concrete layout",
      type_name: "Type::Param(#" + name.index.to_string() + ")",
      expected: 0,
      actual: 0,
      context: "layout_of_concrete"
    })
  when Type::Adt(tid, _) then
    if is_slice_view_tid(engine, tid.id) then
      # Slice[T] is the registered-but-Opaque view builtin: it has NO
      # MirTypeDef, but its layout is fully concrete — the 16-byte {ptr,len}
      # aggregate (the view never depends on the element type).
      Result::Ok(slice_view_layout(engine))
    elsif engine_has_type_def(engine, tid.id) then
      # Recursively strict: an unresolved inline child (Var/Error/Param) or an
      # inline storage cycle must fail here instead of falling back to a
      # pointer-sized guess.
      match check_concrete_layout(engine, ty)
      when Result::Ok(()) then Result::Ok(layout_of(engine, ty))
      when Result::Err(e) then Result::Err(e)
      end
    else
      Result::Err(LayoutError {
        class: LayoutFailureClass::UNSUPPORTED_TYPE,
        message: "No type definition registered for type id",
        type_name: "type#" + tid.id.to_string(),
        expected: 0,
        actual: 0,
        context: "layout_of_concrete"
      })
    end
  when Type::Tuple(_) then
    match check_concrete_layout(engine, ty)
    when Result::Ok(()) then Result::Ok(layout_of(engine, ty))
    when Result::Err(e) then Result::Err(e)
    end
  when Type::FixedArray(_, _) then
    # Fixed arrays are inline element storage: strict the same way as
    # tuples (the zero-length array's element check is trivially Ok).
    match check_concrete_layout(engine, ty)
    when Result::Ok(()) then Result::Ok(layout_of(engine, ty))
    when Result::Err(e) then Result::Err(e)
    end
  when _ then
    Result::Ok(layout_of(engine, ty))
  end
end

def engine_has_type_def(engine: &LayoutEngine, type_id: Int) -> Bool
  for td in engine.type_defs do
    if td.id.id == type_id then
      return true
    end
  end
  false
end

def pointer_layout(engine: &LayoutEngine) -> Layout
  let s = engine.target.pointer_size
  Layout { size: s, align: engine.target.pointer_align, stride: s, fields: Vec::new(), enum_layout: Option::None }
end

def fn_ptr_layout(engine: &LayoutEngine) -> Layout
  let s = engine.target.fn_ptr_size
  Layout { size: s, align: engine.target.pointer_align, stride: s, fields: Vec::new(), enum_layout: Option::None }
end

# True when a TypeId is the registered Slice builtin (LangItems id). The
# Slice is a compiler-scoped VIEW — a 16-byte two-field aggregate, never a
# heap container.
def is_slice_view_tid(engine: &LayoutEngine, type_id: Int) -> Bool
  lookup_type_name(engine, type_id) == "Slice"
end

# The Slice[T] view layout: { ptr: Ptr[T] @ 0, len: UInt @ 8 } — a 16-byte
# inline value (size 2 * pointer_size, align pointer_align). Slice is a
# registered Opaque builtin with NO MirTypeDef, so every inline layout path
# special-cases it here instead of falling into compute_type_layout (which
# would report the unknown-type pointer-sized record).
def slice_view_layout(engine: &LayoutEngine) -> Layout
  let ptr_size = engine.target.pointer_size
  let palign = engine.target.pointer_align
  var field_layouts = Vec::new()
  field_layouts.push(FieldLayout {
    name: "ptr",
    offset: 0,
    size: ptr_size,
    align: palign,
    type_id: -1
  })
  field_layouts.push(FieldLayout {
    name: "len",
    offset: ptr_size,
    size: ptr_size,
    align: palign,
    type_id: -1
  })
  Layout {
    size: 2 * ptr_size,
    align: palign,
    stride: 2 * ptr_size,
    fields: field_layouts,
    enum_layout: Option::None
  }
end

def record_to_layout(rec: &LayoutRecord) -> Layout
  # The flat std::alloc::EnumLayout projection is intentionally NOT filled:
  # the ONE enum authority is this module's rich EnumLayout (see
  # enum_layout_for_type — representation + tag_layout + payload_offset +
  # variant_layouts + niches), which codegen queries. No consumer reads
  # Layout.enum_layout (it is never dereferenced anywhere in the compiler);
  # the record's tag/variant fields remain available through the engine.
  Layout {
    size: rec.size,
    align: rec.align,
    stride: rec.stride,
    fields: rec.fields.clone(),
    enum_layout: Option::None
  }
end

# ———————————————————————————————————————————————————————————————
# EnumLayout — THE single enum-representation authority (P0-ER)
# ———————————————————————————————————————————————————————————————
# Every question about how an enum's runtime VALUE is encoded — the
# register-resident word, the heap image, the tag, the payload, the
# variants, the niches — is answered HERE. Codegen asks the EnumLayout and
# never contains the encoding policy (no inline-discriminant thresholds,
# no heap-pointer tests, no payload offsets are decided in codegen).
#
# The representation describes the REGISTER-RESIDENT value encoding:
#   TaggedPtr(threshold): the value is ONE pointer-width word. Below the
#     threshold it IS the raw discriminant (payload-less values stay inline
#     in the word); at/above the threshold it is a heap pointer to the
#     inline tagged image { tag @ tag_layout.offset, payload @
#     payload_offset }. This is the encoding every registered enum uses
#     today (the aggregate/heap-image convention).
#   InlineTagged: the value IS the inline tagged image (tag + payload
#     fields in the value's storage). Reserved — no registered enum uses it
#     today; the model supports it.
#   Opaque: no resolvable enum layout (unregistered/unresolved). Consumers
#     must fail closed instead of guessing.
#
# The memory IMAGE is always the inline tagged aggregate the engine
# computes (compute_enum_layout / LayoutCategory::TaggedUnion): tag at
# tag_layout.offset (0), payload at payload_offset (8). Niche optimization,
# when it exists, lives in `niches` — never in codegen.

enum EnumValueRepresentation
  TaggedPtr(Int)    # register word: raw disc < threshold, heap ptr >= threshold
  InlineTagged      # the value is the inline tagged image itself
  Opaque            # unresolved: no representation (fail closed)
end

struct EnumTagLayout
  offset: Int       # byte offset of the discriminant tag in the image
  size: Int         # byte width of the tag
end

struct EnumNiche
  variant_index: Int
  value: Int
end

struct EnumLayout
  representation: EnumValueRepresentation
  tag_layout: EnumTagLayout
  payload_offset: Int
  variant_layouts: Vec[VariantLayout]
  niches: Vec[EnumNiche]
end

# The inline-tag threshold of the TaggedPtr encoding: register values below
# this are raw discriminants; values at/above are heap pointers. 256 = the
# lowest plausible heap address — bump-arena/mmap allocations never land
# below it, while discriminants of payload-less enums fit well under it.
# This is the SINGLE place the boundary value exists; codegen reads it from
# the EnumLayout and never contains it.
def enum_inline_tag_threshold() -> Int = 256

# The EnumLayout projection of a TaggedUnion record (Option::None for
# non-enum records).
def enum_layout_from_record(rec: &LayoutRecord) -> Option[EnumLayout]
  if rec.category == LayoutCategory::TaggedUnion then
    Option::Some(EnumLayout {
      representation: EnumValueRepresentation::TaggedPtr(enum_inline_tag_threshold()),
      tag_layout: EnumTagLayout {
        offset: rec.tag_offset,
        size: rec.tag_size
      },
      payload_offset: rec.payload_offset,
      variant_layouts: rec.variants.clone(),
      niches: Vec::new()
    })
  else
    Option::None
  end
end

# The EnumLayout of a registered enum TYPE (the concrete Adt form), from
# the computed records — P0-CK: resolved through the CONCRETE key (the
# (TypeId, substs) render), so Option[u8] and Option[(Int, Int)] are
# distinct EnumLayouts. A cache miss COMPUTES the substituted enum layout
# on demand (the engine is the authority; a registered enum queried without
# a precomputed record is never a guess). Option::None when the type is not
# a registered enum (not TaggedUnion).
def enum_layout_for_type(engine: &mut LayoutEngine, ty: &Type) -> Option[EnumLayout]
  match ty
  when Type::Adt(_, _) then
    let ckey = mir_type_identity_key(ty)
    match engine.records.get(&ckey)
    when Option::Some(rec) then enum_layout_from_record(rec)
    when Option::None then
      # Compute-on-miss: the concrete (substituted) enum layout under this
      # key (cached by compute_type_layout).
      enum_layout_from_record(&compute_type_layout(engine, ty))
    end
  when _ then Option::None
  end
end

# True when the TypeId is a REGISTERED enum definition (the engine's
# type_defs — the same authority is_enum_type_id in codegen consults).
def is_enum_type_def(engine: &LayoutEngine, type_id: Int) -> Bool
  if type_id < 0 then return false end
  for td in engine.type_defs do
    if td.id.id == type_id then
      match td.kind
      when MirTypeDefKind::Enum(_) then return true
      when _ then return false
      end
    end
  end
  false
end

def tuple_layout(engine: &mut LayoutEngine, fields: &Vec[Type]) -> Layout
  let tl = compute_tuple_layout(engine, fields)
  var field_layouts = Vec::new()
  var i = 0
  for fty in fields do
    # Field metadata mirrors the placement table (repr_storage_*), so the
    # reported size/align always agree with the computed offsets.
    let fsize = repr_storage_size(engine, fty)
    let falign = repr_storage_align(engine, fty)
    let off = if i < tl.field_offsets.len() then tl.field_offsets[i] else 0 end
    field_layouts.push(FieldLayout {
      name: i.to_string(),
      offset: off,
      size: fsize,
      align: falign,
      type_id: extract_type_id(fty)
    })
    i = i + 1
  end
  Layout {
    size: tl.size,
    align: tl.align,
    stride: tl.size,
    fields: field_layouts,
    enum_layout: Option::None
  }
end

# ———————————————————————————————————————————————————————————————
# Tuple Layout Computation
# ———————————————————————————————————————————————————————————————

struct TupleLayout
  size: Int
  align: Int
  field_offsets: Vec[Int]
end

def compute_tuple_layout(engine: &mut LayoutEngine, fields: &Vec[Type]) -> TupleLayout
  var offsets = Vec::new()
  var current_offset = 0
  var max_align = 1
  
  # Tuples are inline aggregates: element placement comes from the SAME
  # decision table as struct/enum field placement (repr_storage_size/align).
  # This is also placeholder-safe during compute_all_layouts: Inline named
  # elements compute their real layout instead of reading a placeholder.
  for f in fields do
    let f_align = repr_storage_align(engine, f)
    let f_size = repr_storage_size(engine, f)
    
    if f_align > max_align then
      max_align = f_align
    end
    
    # Align field
    current_offset = layout_align_up(current_offset, f_align)
    offsets.push(current_offset)
    current_offset = current_offset + f_size
  end
  
  # Final alignment
  let total_size = layout_align_up(current_offset, max_align)
  
  TupleLayout {
    size: total_size,
    align: max_align,
    field_offsets: offsets
  }
end

# Struct/enum payload fields are slots sized by the SAME decision table as
# every other placement (type_repr), never by an ad-hoc "everything
# non-primitive is a pointer slot" rule.
def struct_field_storage_align(engine: &mut LayoutEngine, ty: &Type) -> Int
  repr_storage_align(engine, ty)
end

def struct_field_storage_size(engine: &mut LayoutEngine, ty: &Type) -> Int
  repr_storage_size(engine, ty)
end

# ———————————————————————————————————————————————————————————————
# Struct Layout Computation (F7 - declaration order, no reordering)
# ———————————————————————————————————————————————————————————————

# P0-CK: the record's identity is the CONCRETE Adt (def id + args render in
# the record name when substituted — Wrapper[u8] vs Wrapper[Int] stay
# distinguishable in dumps). `fields` arrive ALREADY SUBSTITUTED (see
# compute_type_layout / substituted_type_def) — no Param can reach a
# placement here.
def compute_struct_layout(engine: &mut LayoutEngine, ty: &Type, fields: &Vec[MirFieldDef]) -> LayoutRecord
  var type_id = -1
  match ty
  when Type::Adt(tid, _) then type_id = tid.id
  when _ then panic("layout: compute_struct_layout requires a concrete Adt type")
  end
  var field_layouts = Vec::new()
  var current_offset = 0
  var max_align = 1

  var field_idx = 0
  while field_idx < fields.len() do
    let f = fields[field_idx]
    let f_size = struct_field_storage_size(engine, &f.ty)
    let f_align = struct_field_storage_align(engine, &f.ty)
    
    if f_align > max_align then
      max_align = f_align
    end
    
    # Align field (F7: fields in declaration order, no reordering)
    current_offset = layout_align_up(current_offset, f_align)
    
    field_layouts.push(FieldLayout {
      name: f.name.clone(),
      offset: current_offset,
      size: f_size,
      align: f_align,
      type_id: extract_type_id(&f.ty)
    })
    
    current_offset = current_offset + f_size
    field_idx = field_idx + 1
  end
  
  let total_size = layout_align_up(current_offset, max_align)
  let type_name = lookup_type_name(engine, type_id)
  let hash = compute_layout_hash(&type_name, total_size, max_align, fields.len())
  
  LayoutRecord {
    type_id: type_id,
    name: type_name,
    category: LayoutCategory::InlineStruct,
    repr: Repr::Inline,
    size: total_size,
    align: max_align,
    stride: total_size,
    field_count: fields.len(),
    fields: field_layouts,
    variants: Vec::new(),
    tag_offset: 0,
    tag_size: 0,
    header_size: 0,
    payload_offset: 0,
    hash: hash
  }
end

# ———————————————————————————————————————————————————————————————
# P1: the Closure-Object Layout — { code: fn ptr @ 0, env: capture-tuple }
# ———————————————————————————————————————————————————————————————
# The closure OBJECT's layout, REGISTERED BY the closure's identity (the
# ClosureId-keyed concrete key of the Type::Closure — the SAME identity the
# MIR's AggregateKind::Closure(ClosureId) and the closure-call dispatch
# use): field 0 is the CODE pointer (one pointer-width slot), and the ENV
# (the CAPTURE TUPLE — the closure type's 4th payload) is stored INLINE
# after it, at the capture tuple's concrete layout offsets. Computed on
# demand and cached in engine.records under the closure's key; codegen's
# build_all_layouts registers the object's size/field tables from this
# record, and the aggregate emission (codegen_aggregate's general path) and
# the closure dispatch (codegen_indirect_callee) resolve the field offsets
# through those tables. The closure VALUE itself stays a single pointer to
# this object (classify_value_category's Closure arm — the pointer-width
# slot); the object's record is never the value's own layout.
def closure_object_record(engine: &mut LayoutEngine, ty: &Type) -> LayoutRecord
  match ty
  when Type::Closure(cid, _, _, captures) then
    let ckey = mir_type_identity_key(ty)
    match engine.records.get(ckey.clone())
    when Option::Some(rec) then rec.clone()
    when Option::None then
      # The env: the capture tuple's element types, in tuple order.
      var env_fields: Vec[Type] = Vec::new()
      match captures
      when Type::Tuple(caps) then
        for c in caps do
          env_fields.push(c.clone())
        end
      when _ then ()
      end
      let tl = compute_tuple_layout(engine, env_fields)
      # Field 0: the code pointer.
      var field_layouts = Vec::new()
      var current_offset = 0
      var max_align = engine.target.pointer_align
      field_layouts.push(FieldLayout {
        name: "code".to_string(),
        offset: 0,
        size: engine.target.pointer_size,
        align: engine.target.pointer_align,
        type_id: -1
      })
      current_offset = engine.target.pointer_size
      # The env's base is aligned to the capture tuple's alignment; the
      # env fields follow at the tuple's concrete offsets.
      let env_base = layout_align_up(current_offset, tl.align)
      if tl.align > max_align then max_align = tl.align end
      var env_idx = 0
      while env_idx < env_fields.len() do
        let f_size = repr_storage_size(engine, env_fields[env_idx])
        let f_align = repr_storage_align(engine, env_fields[env_idx])
        if f_align > max_align then max_align = f_align end
        let f_off = if env_idx < tl.field_offsets.len() then tl.field_offsets[env_idx] else 0 end
        field_layouts.push(FieldLayout {
          name: env_idx.to_string(),
          offset: env_base + f_off,
          size: f_size,
          align: f_align,
          type_id: extract_type_id(env_fields[env_idx])
        })
        env_idx = env_idx + 1
      end
      let total_size = layout_align_up(env_base + tl.size, max_align)
      let rec_name = "closure#" + cid.id.to_string()
      let rec_hash = compute_layout_hash(&rec_name, total_size, max_align, field_layouts.len())
      let rec = LayoutRecord {
        type_id: -1,
        name: rec_name,
        category: LayoutCategory::InlineStruct,
        repr: Repr::Inline,
        size: total_size,
        align: max_align,
        stride: total_size,
        field_count: field_layouts.len(),
        fields: field_layouts,
        variants: Vec::new(),
        tag_offset: 0,
        tag_size: 0,
        header_size: 0,
        payload_offset: 0,
        hash: rec_hash
      }
      engine.records.insert(ckey, rec.clone())
      rec
    end
  when _ then
    panic("layout: closure_object_record requires a Type::Closure")
  end
end

# ———————————————————————————————————————————————————————————————
# Enum Layout Computation (F3 - tag at 0, payload at 8)
# ———————————————————————————————————————————————————————————————

# P0-CK: the record's identity is the CONCRETE Adt (def id + args render);
# `variants` arrive ALREADY SUBSTITUTED under the concrete key (see
# compute_type_layout / substituted_type_def) — Option[u8]'s Some carries
# the u8 payload, Option[(Int, Int)]'s the 16-byte tuple, never a
# pointer-width slot.
def compute_enum_layout(engine: &mut LayoutEngine, ty: &Type, variants: &Vec[MirVariantDef]) -> LayoutRecord
  var type_id = -1
  match ty
  when Type::Adt(tid, _) then type_id = tid.id
  when _ then panic("layout: compute_enum_layout requires a concrete Adt type")
  end
  var variant_layouts = Vec::new()
  var max_payload_size = 0
  var max_align = 8  # Tag alignment

  var variant_idx = 0
  while variant_idx < variants.len() do
    let v = variants[variant_idx]
    var payload_offset = 8  # F3: payload starts at offset 8
    var payload_size = 0
    var field_layouts = Vec::new()

    var payload_field_idx = 0
    while payload_field_idx < v.fields.len() do
      let fty = v.fields[payload_field_idx]
      # Enum payload slots are sized by the SAME decision table as every
      # other placement (type_repr via repr_storage_size/align): primitives
      # are Immediate, containers/pointers/String are pointer-width, nested
      # structs/enums are Inline.  Inline children are computed directly
      # (compute_type_layout), never read from a placeholder record, so the
      # dependency-order bug of the old uniform-8-byte-slot rule cannot
      # recur: a later type's layout is computed on the spot.
      let f_size = repr_storage_size(engine, fty)
      let f_align = repr_storage_align(engine, fty)

      if f_align > max_align then
        max_align = f_align
      end

      payload_offset = layout_align_up(payload_offset, f_align)
      
      field_layouts.push(FieldLayout {
        name: "",
        offset: payload_offset,
        size: f_size,
        align: f_align,
        type_id: extract_type_id(fty)
      })
      
      payload_offset = payload_offset + f_size
      payload_size = payload_size + f_size
      payload_field_idx = payload_field_idx + 1
    end
    
    if payload_size > max_payload_size then
      max_payload_size = payload_size
    end
    
    variant_layouts.push(VariantLayout {
      name: v.name.clone(),
      discriminant: v.discriminant,
      payload_offset: 8,
      payload_size: payload_size,
      fields: field_layouts
    })
    variant_idx = variant_idx + 1
  end
  
  # Total size: tag (8 bytes) + max_payload (aligned)
  let payload_total = layout_align_up(max_payload_size, max_align)
  let total_size = layout_align_up(8 + payload_total, max_align)
  
  # The FLAT field list — the layout engine's own flat projection of the
  # enum image: [tag @ 0, variant 0's payload fields, variant 1's payload
  # fields, ...] in DECLARATION order (each payload field offset is the
  # ABSOLUTE image offset — tag at 0, payload fields at 8 + alignment).
  # Codegen's enum_field_offset_for_variant_index computes the flat index
  # as 1 + Σ(prior-variant field counts) + field_idx and resolves it
  # through this list (field_offset on the enum's TypeId) — the two must
  # agree exactly. Without this list the record's `fields` was empty and
  # every enum-payload offset query failed closed with a panic.
  var flat_fields = Vec::new()
  flat_fields.push(FieldLayout {
    name: "tag",
    offset: 0,
    size: 8,
    align: 8,
    type_id: -1
  })
  for fv in variant_layouts do
    for ff in fv.fields do
      flat_fields.push(ff.clone())
    end
  end
  
  let type_name = lookup_type_name(engine, type_id)
  let hash = compute_layout_hash(&type_name, total_size, max_align, variants.len())
  
  LayoutRecord {
    type_id: type_id,
    name: type_name,
    category: LayoutCategory::TaggedUnion,
    repr: Repr::Inline,
    size: total_size,
    align: max_align,
    stride: total_size,
    field_count: variants.len(),
    fields: flat_fields,
    variants: variant_layouts,
    tag_offset: 0,      # F3: tag at offset 0
    tag_size: 8,        # F3: tag is 8 bytes
    header_size: 0,
    payload_offset: 8,  # F3: payload at offset 8
    hash: hash
  }
end

# ———————————————————————————————————————————————————————————————
# Type Layout Computation Dispatcher
# ———————————————————————————————————————————————————————————————

# THE concrete layout computation (P0-CK): computes the layout of a
# Type::Adt(tid, args) under its ConcreteTypeKey — the def's fields are
# SUBSTITUTED with `args` before any offset/size is computed, the result is
# cached under the key's canonical render, and the inline-cycle guard runs
# per concrete key. A generic definition has NO nominal layout: computing
# the def with empty args leaves the Param fields in place, which fail
# closed (Repr::Invalid) at placement — never a pointer-width slot.
def compute_type_layout(engine: &mut LayoutEngine, ty: &Type) -> LayoutRecord
  match ty
  when Type::Adt(tid, args) then
    let ckey = mir_type_identity_key(ty)
    # Inline-cycle guard (P0-AT): re-entering a type whose layout is still
    # being computed means it reaches itself through inline storage only (no
    # pointer/Box indirection) — an infinitely sized recursive type,
    # diagnosed here. The state is CONCRETE-keyed: Wrapper[u8] and
    # Wrapper[Wrapper[u8]] are different states.
    let visit_state = match engine.visit_states.get(&ckey)
    when Option::Some(s) then s
    when Option::None then LayoutVisitState::Unvisited
    end
    match visit_state
    when LayoutVisitState::Visiting then
      panic("layout: infinitely sized recursive type '" + lookup_type_name(engine, tid.id) + "': inline storage cycle (use a pointer or Box to break the cycle)")
    when _ then ()
    end

    # Find the type definition
    var type_def = Option::None
    for td in engine.type_defs do
      if td.id.id == tid.id then
        type_def = Option::Some(td)
      end
    end

    match type_def
    when Option::Some(td) then
      engine.visit_states.insert(ckey.clone(), LayoutVisitState::Visiting)
      let rec = match td.kind
      when MirTypeDefKind::Struct(fields) then
        # The substituted-field computation: the def's fields under THIS
        # concrete key (generic_params <- args).
        compute_struct_layout(engine, ty, &substitute_mir_fields(engine, ty, &fields))
      when MirTypeDefKind::Enum(variants) then
        compute_enum_layout(engine, ty, &substitute_mir_variants(engine, ty, &variants))
      end

      # Cache the result under the CONCRETE key
      engine.records.insert(ckey.clone(), rec.clone())
      engine.visit_states.insert(ckey, LayoutVisitState::Resolved)
      rec
    when Option::None then
      # Unregistered def: FAIL CLOSED — never a pointer-sized guess. The
      # lenient query paths reject unregistered Adts (Repr::Invalid) before
      # this is reachable; this branch is the last-resort ICE.
      panic("layout: no type definition registered for type '" + lookup_type_name(engine, tid.id) + "' (id " + tid.id.to_string() + ") — layout queries fail closed, never a guessed pointer word")
    end
  when _ then
    panic("layout: compute_type_layout requires a concrete Type::Adt (the layout authority is the ConcreteTypeKey { def: TypeId, substs: Vec[Type] })")
  end
end

# Substitute a struct def's field types under a concrete Adt key (the
# substituted-field computation — see the ConcreteTypeKey section).
def substitute_mir_fields(engine: &LayoutEngine, ty: &Type, fields: &Vec[MirFieldDef]) -> Vec[MirFieldDef]
  var out = Vec::new()
  match ty
  when Type::Adt(tid, args) then
    for td in engine.type_defs do
      if td.id.id == tid.id then
        for f in fields do
          out.push(MirFieldDef {
            name: f.name.clone(),
            ty: subst_type_args(&f.ty, &td.generic_params, args)
          })
        end
        return out
      end
    end
    fields.clone()
  when _ then fields.clone()
  end
end

# Substitute an enum def's variant payload types under a concrete Adt key.
def substitute_mir_variants(engine: &LayoutEngine, ty: &Type, variants: &Vec[MirVariantDef]) -> Vec[MirVariantDef]
  var out = Vec::new()
  match ty
  when Type::Adt(tid, args) then
    for td in engine.type_defs do
      if td.id.id == tid.id then
        for v in variants do
          var new_fields = Vec::new()
          for fty in v.fields do
            new_fields.push(subst_type_args(fty, &td.generic_params, args))
          end
          out.push(MirVariantDef {
            name: v.name.clone(),
            discriminant: v.discriminant,
            fields: new_fields
          })
        end
        return out
      end
    end
    variants.clone()
  when _ then variants.clone()
  end
end

# ———————————————————————————————————————————————————————————————
# Field Offset Query (Requirement 2 - no ad-hoc offsets)
# ———————————————————————————————————————————————————————————————

# Get the byte offset of a field by index — P0-CK: the query takes the
# CONCRETE Type (the field layout of Wrapper[u8] is resolved under the
# Wrapper[u8] key, never a nominal record).
def field_offset(engine: &mut LayoutEngine, ty: &Type, field_index: Int) -> Int
  let layout = layout_of(engine, ty)
  if field_index >= 0 && field_index < layout.fields.len() then
    layout.fields[field_index].offset
  else
    panic("field_offset: field index " + field_index.to_string() + " out of range for type '" + mir_type_identity_key(ty) + "'")
  end
end

# Get the byte offset of a field by name (concrete-keyed).
def field_offset_by_name(engine: &mut LayoutEngine, ty: &Type, field_name: &String) -> Option[Int]
  let layout = layout_of(engine, ty)
  for f in layout.fields do
    if f.name == field_name then
      return Option::Some(f.offset)
    end
  end
  Option::None
end

# Get field size by index (concrete-keyed).
def field_size(engine: &mut LayoutEngine, ty: &Type, field_index: Int) -> Int
  let layout = layout_of(engine, ty)
  if field_index >= 0 && field_index < layout.fields.len() then
    layout.fields[field_index].size
  else
    panic("field_size: field index " + field_index.to_string() + " out of range for type '" + mir_type_identity_key(ty) + "'")
  end
end

# ———————————————————————————————————————————————————————————————
# Enum/Tagged Union Queries
# ———————————————————————————————————————————————————————————————

# Get discriminant offset (always 0 per F3) — concrete-keyed with
# compute-on-miss (the record of a registered enum under the query's
# concrete key; a miss computes and caches the substituted layout).
def discriminant_offset(engine: &mut LayoutEngine, ty: &Type) -> Int
  let ckey = mir_type_identity_key(ty)
  match engine.records.get(&ckey)
  when Option::Some(rec) then rec.tag_offset
  when Option::None then
    let computed = compute_type_layout(engine, ty)
    computed.tag_offset
  end
end

# Get discriminant size (always 8 per F3) — concrete-keyed.
def discriminant_size(engine: &mut LayoutEngine, ty: &Type) -> Int
  let ckey = mir_type_identity_key(ty)
  match engine.records.get(&ckey)
  when Option::Some(rec) then rec.tag_size
  when Option::None then
    let computed = compute_type_layout(engine, ty)
    computed.tag_size
  end
end

# Get payload offset (always 8 per F3) — concrete-keyed.
def payload_offset(engine: &mut LayoutEngine, ty: &Type) -> Int
  let ckey = mir_type_identity_key(ty)
  match engine.records.get(&ckey)
  when Option::Some(rec) then rec.payload_offset
  when Option::None then
    let computed = compute_type_layout(engine, ty)
    computed.payload_offset
  end
end

# Get variant discriminant value (concrete-keyed, compute-on-miss).
def variant_discriminant(engine: &mut LayoutEngine, ty: &Type, variant_name: &String) -> Option[Int]
  let ckey = mir_type_identity_key(ty)
  match engine.records.get(&ckey)
  when Option::Some(rec) then
    for v in rec.variants do
      if v.name == variant_name then
        return Option::Some(v.discriminant)
      end
    end
    Option::None
  when Option::None then
    let computed = compute_type_layout(engine, ty)
    for v in computed.variants do
      if v.name == variant_name then
        return Option::Some(v.discriminant)
      end
    end
    Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Header Layout Queries (for heap objects)
# ———————————————————————————————————————————————————————————————

# STRING ABI (FROZEN)
# ———————————————————————————————————————————————————————————————
# The by-value String ABI is FROZEN as an 8-byte raw pointer to a
# null-terminated UTF-8 byte buffer. There is NO inline {ptr,len,cap}
# header on String values; the runtime helpers (strlen-based) and
# `normalize_string_arg0_for_current_arch` in codegen both rely on this.
#
# The 32-byte {data:0, len:8, cap:16, stride:24} Vec-header shape described
# elsewhere belongs ONLY to Vec/Array values and the internal char-vector
# buffer produced by `str.chars()` (a Vec[Char], stride 4), never to String
# values. Changing `string_abi_size` or `string_abi_is_raw_pointer` is a
# breaking ABI change.
#
# The value comes from the P0-AR decision table: String is Repr::StringPtr
# and its header size is repr_header_size(StringPtr).
def string_abi_size() -> Int = repr_header_size(Repr::StringPtr)
def string_abi_is_raw_pointer() -> Bool = true

# Known container ABI sizes (F2 - FROZEN)
# These values are frozen and MUST NOT change during stabilization.
# They come from the P0-AR decision table (repr_header_size via
# container_repr_for_name): the full inline heap header size behind the
# 8-byte value handle. String uses the raw-pointer ABI (see
# string_abi_size), NOT a 32-byte inline Vec header; its {data,len,cap,
# stride} shape is only the internal char-Vec buffer produced by
# `str.chars()`, never the String value ABI.
def container_header_size(type_name: &String) -> Int
  repr_header_size(container_repr_for_name(type_name))
end

# Container field offsets (F2)
# Dispatched by the same name -> Repr table as container_header_size, so
# the container shape knowledge lives in ONE place.
# The HeapVecHeader stride field (offset 24) is the runtime's element
# addressing authority: every _tg_array_* helper reads it for element
# addresses (data + i*stride) and allocation sizes (cap*stride). Codegen's
# heap_header_field_offset reads it the same way; the value is written by
# _tg_array_new from the stride argument codegen passes (computed from the
# CONCRETE element type via element_stride_bytes).
# Map and Set share the runtime's 88-byte layout header ({buckets:0,
# size:8, capacity:16, key_stride:24, key_align:32, value_stride:40,
# value_align:48, key_off:56, value_off:64, next_off:72, bucket_stride:80} —
# the layout parameters are stored at creation from the concrete K/V and the
# runtime derives nothing; see runtime.tg "Map header (88 bytes)").
# NOTE: String values have NO inline {ptr,len,cap} header (raw-pointer ABI,
# see string_abi_size). The offsets below describe the internal char-Vec
# buffer produced by `str.chars()`, which is laid out like Vec[u8]. They are
# exposed via the "Vec" entry; the String branch is retained for byte-image
# tooling only and does not apply to String values.
#
# Slice is deliberately NOT in container_repr_for_name: a Slice value is the
# inline two-field view { ptr: Ptr[T] @ 0, len: UInt @ pointer_size }
# (slice_view_layout) — never a heap header. Consumers of Slice values use
# slice_view_field_offset, never container_field_offset / HeapVecHeader.
def slice_view_field_offset(engine: &LayoutEngine, field_name: &String) -> Int
  let ptr_size = engine.target.pointer_size
  if field_name == "ptr" || field_name == "data" then 0
  else if field_name == "len" || field_name == "length" then ptr_size
  else 0
  end
end

def container_field_offset(type_name: &String, field_name: &String) -> Int
  match container_repr_for_name(type_name)
  when Repr::StringPtr then
    if field_name == "ptr" || field_name == "data" then 0
    else if field_name == "len" || field_name == "length" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else if field_name == "stride" then 24
    else 0
    end
  when Repr::HeapVecHeader then
    if field_name == "ptr" || field_name == "data" then 0
    else if field_name == "len" || field_name == "length" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else if field_name == "stride" then 24
    else 0
    end
  when Repr::HeapMapHeader then
    # Runtime Map header (88 bytes — {buckets:0, size:8, capacity:16,
    # key_stride:24, key_align:32, value_stride:40, value_align:48,
    # key_off:56, value_off:64, next_off:72, bucket_stride:80} — runtime.tg
    # "Map header (88 bytes)"). The "len"/"length"/"size" aliases all read
    # the live-entry count at 8; "cap"/"capacity" read 16.
    if field_name == "buckets" then 0
    else if field_name == "len" || field_name == "length" || field_name == "size" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else if field_name == "key_stride" then 24
    else if field_name == "key_align" then 32
    else if field_name == "value_stride" then 40
    else if field_name == "value_align" then 48
    else if field_name == "key_off" then 56
    else if field_name == "value_off" then 64
    else if field_name == "next_off" then 72
    else if field_name == "bucket_stride" then 80
    else 0
    end
  when Repr::HeapSetHeader then
    # Set is map-backed: the Set header IS the 88-byte Map header
    # ({buckets:0, size:8, capacity:16, key_stride:24, ...} — _tg_set_*
    # tail-calls the map helpers, see runtime.tg).
    if field_name == "buckets" || field_name == "map" then 0
    else if field_name == "len" || field_name == "length" || field_name == "size" then 8
    else if field_name == "cap" || field_name == "capacity" then 16
    else if field_name == "key_stride" then 24
    else if field_name == "key_align" then 32
    else if field_name == "value_stride" then 40
    else if field_name == "value_align" then 48
    else if field_name == "key_off" then 56
    else if field_name == "value_off" then 64
    else if field_name == "next_off" then 72
    else if field_name == "bucket_stride" then 80
    else 0
    end
  when _ then
    0
  end
end

# ———————————————————————————————————————————————————————————————
# Layout Validation (for golden tests)
# ———————————————————————————————————————————————————————————————

struct LayoutAssertion
  type_name: String
  expected_size: Int
  expected_align: Int
  expected_stride: Int
  field_offsets: Vec[Int]
end

def validate_layout(engine: &mut LayoutEngine, assertion: &LayoutAssertion) -> Result[Unit, LayoutError]
  let type_id = match engine.name_index.get(&assertion.type_name)
  when Option::Some(id) then id
  when Option::None then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Type not found",
      type_name: assertion.type_name.clone(),
      expected: 0,
      actual: 0,
      context: "validate_layout"
    })
  end
  
  let cty = Type::Adt(TypeId { id: type_id }, Vec::new())
  let ckey = mir_type_identity_key(&cty)
  let rec = match engine.records.get(&ckey)
  when Option::Some(r) then r.clone()
  when Option::None then compute_type_layout(engine, &cty)
  end
  
  # Validate size
  if rec.size != assertion.expected_size then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Size mismatch",
      type_name: assertion.type_name.clone(),
      expected: assertion.expected_size,
      actual: rec.size,
      context: "validate_layout:size"
    })
  end
  
  # Validate alignment
  if rec.align != assertion.expected_align then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Alignment mismatch",
      type_name: assertion.type_name.clone(),
      expected: assertion.expected_align,
      actual: rec.align,
      context: "validate_layout:align"
    })
  end
  
  # Validate stride
  if rec.stride != assertion.expected_stride then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
      message: "Stride mismatch",
      type_name: assertion.type_name.clone(),
      expected: assertion.expected_stride,
      actual: rec.stride,
      context: "validate_layout:stride"
    })
  end
  
  # Validate field offsets
  var i = 0
  for expected_off in assertion.field_offsets do
    if i < rec.fields.len() then
      if rec.fields[i].offset != expected_off then
        return Result::Err(LayoutError {
          class: LayoutFailureClass::LAYOUT_COMPUTATION_BUG,
          message: "Field " + i.to_string() + " offset mismatch",
          type_name: assertion.type_name.clone(),
          expected: expected_off,
          actual: rec.fields[i].offset,
          context: "validate_layout:field_offset"
        })
      end
    end
    i = i + 1
  end
  
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Layout Table Dump (Step 4)
# ———————————————————————————————————————————————————————————————

def dump_layout_table(engine: &LayoutEngine) -> Unit
  eprintln("=== Layout Table Dump ===")
  eprintln("  Target: " + engine.target.arch_name)
  eprintln("  Records: " + engine.records.len().to_string())
  eprintln("  Cache hits: " + engine.cache_hits.to_string())
  eprintln("  Cache misses: " + engine.cache_misses.to_string())
  
  for entry in engine.records do
    let rec = entry.1
    eprintln("  KEY " + entry.0 + "  TYPE " + rec.name + " (id=" + rec.type_id.to_string() + ")")
    eprintln("    category: " + category_to_string(&rec.category))
    eprintln("    repr: " + repr_to_string(&rec.repr))
    eprintln("    size: " + rec.size.to_string() + " align: " + rec.align.to_string() + " stride: " + rec.stride.to_string())
    
    if rec.fields.len() > 0 then
      eprintln("    fields:")
      var fi = 0
      for f in rec.fields do
        eprintln("      [" + fi.to_string() + "] " + f.name + " offset=" + f.offset.to_string() + " size=" + f.size.to_string() + " align=" + f.align.to_string())
        fi = fi + 1
      end
    end
    
    if rec.variants.len() > 0 then
      eprintln("    variants:")
      for v in rec.variants do
        eprintln("      " + v.name + " disc=" + v.discriminant.to_string() + " payload_size=" + v.payload_size.to_string())
      end
    end
  end
  eprintln("=== End Layout Table ===")
end

def category_to_string(cat: &LayoutCategory) -> String
  match cat
  when LayoutCategory::Primitive then "Primitive"
  when LayoutCategory::Pointer then "Pointer"
  when LayoutCategory::FatPointer then "FatPointer"
  when LayoutCategory::InlineStruct then "InlineStruct"
  when LayoutCategory::TaggedUnion then "TaggedUnion"
  when LayoutCategory::DynContainer then "DynContainer"
  when LayoutCategory::ZeroSized then "ZeroSized"
  when LayoutCategory::FunctionType then "FunctionType"
  end
end

def repr_to_string(repr: &Repr) -> String
  match repr
  when Repr::Immediate     then "Immediate"
  when Repr::RawPtr        then "RawPtr"
  when Repr::StringPtr     then "StringPtr"
  when Repr::HeapVecHeader then "HeapVecHeader"
  when Repr::HeapMapHeader then "HeapMapHeader"
  when Repr::HeapSetHeader then "HeapSetHeader"
  when Repr::Inline        then "Inline"
  when Repr::TaggedPtr     then "TaggedPtr"
  when Repr::OpaquePtr     then "OpaquePtr"
  when Repr::Invalid       then "Invalid"
  end
end

# ———————————————————————————————————————————————————————————————
# Utility Functions
# ———————————————————————————————————————————————————————————————

def extract_type_id(ty: &Type) -> Int
  match ty
  when Type::Adt(tid, _) then tid.id
  when Type::RefInternal(inner, _) then extract_type_id(&inner)
  when _ then -1
  end
end

def lookup_type_name(engine: &LayoutEngine, type_id: Int) -> String
  for td in engine.type_defs do
    if td.id.id == type_id then
      return td.name.clone()
    end
  end
  "unknown_" + type_id.to_string()
end

# ———————————————————————————————————————————————————————————————
# Value ABI classification — the value-category model (P0-VC)
# ———————————————————————————————————————————————————————————————
# The single authority that answers "how does a value of this type cross an
# ABI boundary (argument / result / move / copy)?" — built on the
# centralized layout engine (layout_of_concrete — every size comes from the
# canonical query, never an independent estimate). This REPLACES the old
# ad-hoc register/8-byte-word logic (value_abi / should_pass_directly /
# should_return_directly / arg_register_count), which classified by nothing
# but the raw size.
#
# Categories (the first-class distinction the backends consume):
#   ZeroSized           — no payload (Unit, Never, empty aggregates)
#   Scalar(width)       — ONE ABI slot of `width` bytes (1/2/4/8): the value
#                         itself travels in the slot
#   ScalarPair(w1, w2)  — exactly TWO words (16-byte aggregates: pairs,
#                         16-byte tuples/structs, the Slice view, I128):
#                         a two-slot value
#   ByAddress(size)     — more than 16 bytes: the value crosses BY ADDRESS
#                         (the slot carries the address; returns use sret)
#
# Type-structure rules (each shape keeps emitting the code it emits today):
#   primitives      -> Scalar(primitive size); I128/U128 (16) -> ScalarPair
#   pointers/handles-> Scalar(pointer width) (Ptr/PtrMut/Ref, String, heap
#                      containers, Box/Rc, Function/Dyn/Effect)
#   enums (tagged)  -> asked of the EnumLayout: TaggedPtr-represented enums
#                      cross as their ONE pointer-width TaggedPtr word
#                      (Scalar(pointer_size)) — the image size is NOT the
#                      crossing size; InlineTagged enums use the size rule
#   tuples/structs/fixed arrays (Inline) -> by layout size: 0 -> ZeroSized,
#                      1/2/4/8 -> Scalar(size), 16 -> ScalarPair(8, 8),
#                      >16 -> ByAddress(size)
#   Slice (the 16-byte view) -> ScalarPair(8, 8) via the size rule
# FAIL-CLOSED: Var/Param/Error/unknown -> Result::Err(LayoutError) — the
# caller (codegen's classify pair, sret decisions) must ICE, never assume a
# word.
enum ValueCategory
  ZeroSized
  Scalar(Int)          # one ABI slot; slot width in bytes (1/2/4/8)
  ScalarPair(Int, Int) # two ABI slots (16-byte aggregate: two words)
  ByAddress(Int)       # by reference (address in the slot); payload byte size
end

# Size-based category for INLINE aggregates (tuples, structs, fixed arrays,
# the Slice view, InlineTagged-represented enums): the layout size decides.
def inline_aggregate_category(engine: &mut LayoutEngine, ty: &Type) -> Result[ValueCategory, LayoutError]
  match layout_of_concrete(engine, ty)
  when Result::Ok(l) then
    if l.size == 0 then
      Result::Ok(ValueCategory::ZeroSized)
    elsif l.size <= 8 then
      Result::Ok(ValueCategory::Scalar(l.size))
    elsif l.size == 16 then
      Result::Ok(ValueCategory::ScalarPair(8, 8))
    else
      Result::Ok(ValueCategory::ByAddress(l.size))
    end
  when Result::Err(e) then Result::Err(e)
  end
end

# THE value-category classifier. Every ABI decision (arguments, results,
# moves/copies) is derived from this single function.
def classify_value_category(engine: &mut LayoutEngine, ty: &Type) -> Result[ValueCategory, LayoutError]
  # FAIL-CLOSED: unresolved types have no category.
  match ty
  when Type::Var(_) then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Type variable has no ABI value category",
      type_name: "Type::Var",
      expected: 0,
      actual: 0,
      context: "classify_value_category"
    })
  when Type::Param(name) then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Generic parameter has no ABI value category",
      type_name: "Type::Param(#" + name.index.to_string() + ")",
      expected: 0,
      actual: 0,
      context: "classify_value_category"
    })
  when Type::Error then
    return Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Error type has no ABI value category",
      type_name: "Type::Error",
      expected: 0,
      actual: 0,
      context: "classify_value_category"
    })
  when _ then ()
  end

  match type_repr(engine, ty)
  when Repr::Invalid then
    Result::Err(LayoutError {
      class: LayoutFailureClass::UNRESOLVED_TYPE,
      message: "Unresolved type reached the ABI classifier (type_repr = Invalid)",
      type_name: "unknown",
      expected: 0,
      actual: 0,
      context: "classify_value_category"
    })
  when Repr::Immediate then
    # Primitives: the primitive width decides (Unit/Never -> ZeroSized;
    # 1/2/4/8 -> Scalar; I128/U128 (16) -> ScalarPair).
    let ps = primitive_size(engine, ty)
    if ps == 0 then Result::Ok(ValueCategory::ZeroSized)
    elsif ps <= 8 then Result::Ok(ValueCategory::Scalar(ps))
    else Result::Ok(ValueCategory::ScalarPair(8, 8))
    end
  when Repr::RawPtr then
    # Pointers (Ptr/PtrMut/RefInternal) and pointer-represented smart
    # pointers: one pointer-width slot.
    Result::Ok(ValueCategory::Scalar(engine.target.pointer_size))
  when Repr::StringPtr then
    Result::Ok(ValueCategory::Scalar(engine.target.pointer_size))
  when Repr::HeapVecHeader then
    Result::Ok(ValueCategory::Scalar(engine.target.pointer_size))
  when Repr::HeapMapHeader then
    Result::Ok(ValueCategory::Scalar(engine.target.pointer_size))
  when Repr::HeapSetHeader then
    Result::Ok(ValueCategory::Scalar(engine.target.pointer_size))
  when Repr::TaggedPtr then
    Result::Ok(ValueCategory::Scalar(engine.target.pointer_size))
  when Repr::OpaquePtr then
    match ty
  when Type::FnPtr(_, _) then Result::Ok(ValueCategory::Scalar(engine.target.fn_ptr_size))
  # P1 (the closure {code, env} ABI): the closure VALUE is ONE pointer to
  # the closure OBJECT ({ code: fn ptr @ 0, env: capture-tuple } — the
  # object's layout is registered by the ClosureId), so the value crosses
  # in one pointer-width slot.
  when Type::Closure(_, _, _, _) then Result::Ok(ValueCategory::Scalar(engine.target.pointer_size))
    when _ then Result::Ok(ValueCategory::Scalar(engine.target.pointer_size))
    end
  when Repr::Inline then
    match ty
    when Type::Adt(tid, _) then
      if is_enum_type_def(engine, tid.id) then
        # Enums are classified by their EnumLayout — the single
        # enum-representation authority. A TaggedPtr-represented enum's
        # VALUE is one pointer-width word (raw discriminant or heap
        # pointer), so it crosses in ONE slot regardless of its image size.
        match enum_layout_for_type(engine, ty)
        when Option::Some(el) then
          match el.representation
          when EnumValueRepresentation::TaggedPtr(_) then
            Result::Ok(ValueCategory::Scalar(engine.target.pointer_size))
          when EnumValueRepresentation::InlineTagged then
            inline_aggregate_category(engine, ty)
          when EnumValueRepresentation::Opaque then
            Result::Err(LayoutError {
              class: LayoutFailureClass::UNSUPPORTED_TYPE,
              message: "Enum has an opaque (unresolved) EnumLayout — no ABI category",
              type_name: "type#" + tid.id.to_string(),
              expected: 0,
              actual: 0,
              context: "classify_value_category"
            })
          end
        when Option::None then
          Result::Err(LayoutError {
            class: LayoutFailureClass::UNSUPPORTED_TYPE,
            message: "Registered enum has no EnumLayout record — no ABI category",
            type_name: "type#" + tid.id.to_string(),
            expected: 0,
            actual: 0,
            context: "classify_value_category"
          })
        end
      else
        inline_aggregate_category(engine, ty)
      end
    when _ then
      inline_aggregate_category(engine, ty)
    end
  end
end

# Absolute byte offsets of each payload field for an enum variant, taken from
# the single layout authority.  Offsets are relative to the enum base (tag at
# 0, payload at tag_size).  Replaces any ad-hoc `payload_offset + i * 8`.
# P0-CK: concrete-keyed with compute-on-miss — the variant offsets come from
# the SUBSTITUTED enum layout under the query's concrete key (Option[u8]'s
# Some payload sits at 8; Option[(Int,Int)]'s at 8 with a 16-byte size).
def enum_variant_field_offsets(engine: &mut LayoutEngine, ty: &Type, variant_index: Int) -> Vec[Int]
  var offs = Vec::new()
  let ckey = mir_type_identity_key(ty)
  match engine.records.get(&ckey)
  when Option::Some(rec) then
    if variant_index >= 0 && variant_index < rec.variants.len() then
      for f in rec.variants[variant_index].fields do
        offs.push(f.offset)
      end
    end
  when Option::None then
    let computed = compute_type_layout(engine, ty)
    if variant_index >= 0 && variant_index < computed.variants.len() then
      for f in computed.variants[variant_index].fields do
        offs.push(f.offset)
      end
    end
  end
  offs
end

# Variant payload sizes, from the layout authority (concrete-keyed,
# compute-on-miss).
def enum_variant_field_sizes(engine: &mut LayoutEngine, ty: &Type, variant_index: Int) -> Vec[Int]
  var sizes = Vec::new()
  let ckey = mir_type_identity_key(ty)
  match engine.records.get(&ckey)
  when Option::Some(rec) then
    if variant_index >= 0 && variant_index < rec.variants.len() then
      for f in rec.variants[variant_index].fields do
        sizes.push(f.size)
      end
    end
  when Option::None then
    let computed = compute_type_layout(engine, ty)
    if variant_index >= 0 && variant_index < computed.variants.len() then
      for f in computed.variants[variant_index].fields do
        sizes.push(f.size)
      end
    end
  end
  sizes
end

# ———————————————————————————————————————————————————————————————
# Pre-compute all layouts (call after registering types)
# ———————————————————————————————————————————————————————————————

# Collect TypeIds of named types reached through INLINE storage only: direct
# Adt fields, tuple elements, and fixed-array elements. The named Array[T]
# Adt form is the heap-vector handle — an indirection never followed. Other
# indirections (Ptr/PtrMut/Ref, Box/Rc, Slice — the {ptr,len} view holds a
# raw pointer, Option/Result/Map/Set, Function, String) are never followed;
# unregistered named types have no definition to recurse into.
def collect_inline_named_children(engine: &LayoutEngine, ty: &Type, out: &mut Vec[Int]) -> Unit
  match ty
  when Type::Adt(tid, args) then
    # P0-J2: Adt form of Array is the heap-vector identity (the named
    # Array[T]) — an indirection, never followed into inline children. The
    # Slice view is likewise an indirection (its only field is a raw Ptr),
    # so it is never an inline child. The fixed arrays are the distinct
    # Type::FixedArray variant below.
    if lookup_type_name(engine, tid.id) == "Array" || is_slice_view_tid(engine, tid.id) then
      ()
    else
      out.push(tid.id)
    end
  when Type::Tuple(elems) then
    for e in elems do
      collect_inline_named_children(engine, e, out)
    end
  when Type::FixedArray(elem, _) then
    # Fixed arrays store their elements INLINE: the element's named
    # children are inline children too (a struct Bad { a: FixedArray[Bad, 2] }
    # is an inline storage cycle).
    collect_inline_named_children(engine, &elem, out)
  when _ then ()
  end
end

# DFS over the inline layout graph (P0-AT).  Reaching a type that is still
# Visiting means it reaches itself through inline storage only — no finite
# inline layout exists (e.g. `struct Bad { child: Bad }`).  Types reached
# through indirection (e.g. `struct Node { next: Box[Node] }`) are never
# flagged.  The engine has no error list; the existing diagnostic channel
# for unrecoverable layout problems is panic, so the cycle is reported there.
# P0-CK: the DFS states are keyed by the def's NOMINAL concrete key (the
# empty-args Adt render — the def-level graph); the per-instantiation
# compute path re-checks recursion under each CONCRETE key in
# compute_type_layout.
def check_inline_layout_cycles(engine: &mut LayoutEngine, type_id: Int) -> Unit
  let ckey = mir_type_identity_key(&Type::Adt(TypeId { id: type_id }, Vec::new()))
  let state = match engine.visit_states.get(&ckey)
  when Option::Some(s) then s
  when Option::None then LayoutVisitState::Unvisited
  end
  match state
  when LayoutVisitState::Visiting then
    panic("layout: infinitely sized recursive type '" + lookup_type_name(engine, type_id) + "': inline storage cycle (use a pointer or Box to break the cycle)")
  when LayoutVisitState::Resolved then ()
  when LayoutVisitState::Unvisited then
    engine.visit_states.insert(ckey.clone(), LayoutVisitState::Visiting)
    var children = Vec::new()
    for td in engine.type_defs do
      if td.id.id == type_id then
        match td.kind
        when MirTypeDefKind::Struct(fields) then
          for f in fields do
            collect_inline_named_children(engine, &f.ty, &mut children)
          end
        when MirTypeDefKind::Enum(variants) then
          for v in variants do
            for fty in v.fields do
              collect_inline_named_children(engine, &fty, &mut children)
            end
          end
        end
      end
    end
    for child in children do
      check_inline_layout_cycles(engine, child)
    end
    engine.visit_states.insert(ckey, LayoutVisitState::Resolved)
  end
end

def compute_all_layouts(engine: &mut LayoutEngine) -> Unit
  # Diagnose infinitely sized recursive inline types FIRST: the DFS marks
  # Unvisited/Visiting/Resolved per type, and re-visiting a Visiting type
  # through inline storage is reported before placeholder seeding could mask
  # the cycle.  Types behind indirection (Box, pointers, containers) are
  # finite and never flagged.
  engine.visit_states = Map::new()
  engine.strict_states = Map::new()
  for td in engine.type_defs do
    check_inline_layout_cycles(engine, td.id.id)
  end

  # P0-CK: placeholders and computed records exist for NON-GENERIC defs
  # only (their fields are already concrete, so the nominal key IS the
  # concrete key). A GENERIC def has NO nominal layout: its records are
  # computed per concrete instantiation on demand (compute_type_layout
  # under each ConcreteTypeKey) — the pointer-width generic slot is gone.
  for td in engine.type_defs do
    if td.generic_params.is_empty() then
      let nominal_ty = Type::Adt(td.id.clone(), Vec::new())
      let ckey = mir_type_identity_key(&nominal_ty)
      # First pass: insert placeholder records (cycles are already diagnosed
      # above, so a placeholder can never mask one).
      engine.records.insert(ckey, LayoutRecord {
        type_id: td.id.id,
        name: td.name.clone(),
        category: LayoutCategory::ZeroSized,
        repr: Repr::OpaquePtr,
        size: 0,
        align: 1,
        stride: 0,
        field_count: 0,
        fields: Vec::new(),
        variants: Vec::new(),
        tag_offset: 0,
        tag_size: 0,
        header_size: 0,
        payload_offset: 0,
        hash: 0
      })
    end
  end

  # Second pass: compute real layouts from the definitions.  Every record is
  # recomputed and overwrites its placeholder, so a placeholder's size 0 can
  # never determine a field's eventual size.
  for td in engine.type_defs do
    if td.generic_params.is_empty() then
      let cty = Type::Adt(td.id.clone(), Vec::new())
      let rec = compute_type_layout(engine, &cty)
      engine.records.insert(mir_type_identity_key(&cty), rec)
    end
  end
end