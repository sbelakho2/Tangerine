extern def libc_write(fd: Int, buf: Ptr[u8], count: UInt) -> Int
extern def read_file_to_string_native(path: String) -> String
def syscall_write(fd: Int, buf: Ptr[u8], count: UInt) -> Int
  libc_write(fd, buf, count)
end

# 
# Compiler Options
# 

pub struct CompilerOptions
  # Input/output
  input_files: Vec[String]
  output_file: Option[String]
  
  # Compilation mode
  emit: EmitMode
  
  # Optimization level
  opt_level: Int
  
  # Debug info
  debug_info: Bool
  
  # Features
  enable_contracts: Bool
  enable_capabilities: Bool
  enable_effects: Bool
  enable_budgets: Bool
  
  # Warnings
  warn_unused: Bool
  warn_all: Bool
  deny_warnings: Bool
  
  # Verbosity
  verbose: Bool
  quiet: Bool
  
  # Special modes
  check_only: Bool
  stop_after: StopAfter
  strict_resolution: Bool
  emit_mir: Bool
  print_ast: Bool
  print_tokens: Bool
  dump_phase: Option[String]
  
  # Output format
  json_diagnostics: Bool
  color: Bool
  
  # Cross-compilation
  target_triple: Option[String]

  # PGO
  pgo_gen: Option[String]    # --pgo-gen=<path> : instrument and write profile
  pgo_use: Option[String]    # --pgo-use=<path> : read profile for optimization

  # Mode system
  mode: Mode                  # Dev/Strict/Production/Hardened
  mode_config: ModeConfig     # Derived from mode
end

pub enum EmitMode
  Executable
  Object
  Assembly
  MIR
end

# Explicit compilation stopping phase. Commands map onto a single phase:
#   tg parse   -> Parse
#   tg check   -> Mir
#   tg compile -> Link
# Each phase includes everything before it (lex, parse, dependency resolution,
# macro expansion, name/type checking, access checking, resource checking, MIR
# lowering, MIR verification), so `tg check` is a real semantic gate and never a
# parse-only shortcut.
pub enum StopAfter
  Parse
  Semantic
  Mir
  Object
  Link
end

# Failures while collecting imported dependencies. Each distinguishes the
# stage that failed so a partially parsed dependency is never silently merged
# into a compiler program.
pub enum DependencyError
  Read
  Lex
  Parse
  Recursive
end

pub def dep_error_message(e: DependencyError, path: String) -> String
  match e
  when DependencyError::Read      then "failed to read dependency: " + path
  when DependencyError::Lex       then "failed to lex dependency: " + path
  when DependencyError::Parse     then "failed to parse dependency: " + path
  when DependencyError::Recursive then "failed to collect transitive dependency of: " + path
  end
end

pub def default_options() -> CompilerOptions
  CompilerOptions {
    input_files: Vec::new(),
    output_file: Option::None,
    emit: EmitMode::Executable,
    opt_level: 0,
    debug_info: false,
    enable_contracts: true,
    enable_capabilities: true,
    enable_effects: true,
    enable_budgets: true,
    warn_unused: true,
    warn_all: false,
    deny_warnings: false,
    verbose: false,
    quiet: false,
    check_only: false,
    stop_after: StopAfter::Link,
    strict_resolution: false,
    emit_mir: false,
    print_ast: false,
    print_tokens: false,
    dump_phase: Option::None,
    json_diagnostics: false,
    color: true,
    target_triple: Option::None,
    pgo_gen: Option::None,
    pgo_use: Option::None,
    mode: Mode::Dev,
    mode_config: config_for_mode(Mode::Dev)
  }
end

pub def is_compiler_driver_path(path: String) -> Bool
  path == "tg_compiler/driver.tg" || path.ends_with("/tg_compiler/driver.tg")
end

pub def should_skip_bootstrap_semantic_checks(opts: &CompilerOptions, path: String) -> Bool
  # Semantic checks are never skipped. Stage outputs are executables, not
  # source programs; their filename must never alter frontend correctness.
  # `-o tg_stage2` must behave identically to `-o foo` for identical inputs.
  false
end

pub def bootstrap_codegen_target() -> AsmTarget
  asm_target(Arch::AArch64, OsAbi::MacOS)
end

pub def driver_lower_to_mir(ast: &Program, typed: &Option[TypedProgram]) -> Result[MirProgram, String]
  match typed
  when Option::Some(tp) then lower_to_mir(ast, tp)
  when Option::None then Result::Err("MIR lowering requires a typed program")
  end
end

# Use Diagnostic definition from parser
use tg_compiler::parser::{Diagnostic, DiagLevel, Suggestion, ErrorCode}

# 
# Diagnostics Emitter
# 

pub struct DiagnosticEmitter
  source_map: SourceMap
  current_source_id: Int
  diagnostics: Vec[Diagnostic]
  error_count: Int
  warning_count: Int
  json_mode: Bool
  color_enabled: Bool
end

pub struct SourceMap
  files: Vec[SourceFile]
end

pub struct SourceFile
  name: String
  content: String
  lines: Vec[Int]  # Line start offsets
end

pub def emitter_new() -> DiagnosticEmitter
  DiagnosticEmitter {
    source_map: SourceMap { files: Vec::new() },
    current_source_id: -1,
    diagnostics: Vec::new(),
    error_count: 0,
    warning_count: 0,
    json_mode: false,
    color_enabled: true
  }
end

pub def emitter_new_json() -> DiagnosticEmitter
  DiagnosticEmitter {
    source_map: SourceMap { files: Vec::new() },
    current_source_id: -1,
    diagnostics: Vec::new(),
    error_count: 0,
    warning_count: 0,
    json_mode: true,
    color_enabled: false
  }
end

pub def add_source(e: &mut DiagnosticEmitter, name: String, content: String) -> Int
  var lines = Vec::new()
  lines.push(0)
  var i = 0
  while i < content.len() do
    if content.char_at(i) == '\n' then
      lines.push(i + 1)
    end
    i = i + 1
  end
  
  e.source_map.files.push(SourceFile {
    name: name,
    content: content,
    lines: lines
  })

  let id = e.source_map.files.len() - 1
  e.current_source_id = id
  
  id
end

pub def emit_diagnostic(e: &mut DiagnosticEmitter, d: Diagnostic) -> Unit
  # Track counts
  match d.level
  when DiagLevel::Error then
    e.error_count = e.error_count + 1
  when DiagLevel::Warning then
    e.warning_count = e.warning_count + 1
  when _ then ()
  end
  
  if e.json_mode then
    emit_diagnostic_json(e, &d)
    e.diagnostics.push(d)
    return
  end
  
  # Human-readable format
  let level_str = match d.level
  when DiagLevel::Error then "error"
  when DiagLevel::Warning then "warning"
  when DiagLevel::Info then "info"
  when DiagLevel::Note then "note"
  when DiagLevel::Help then "help"
  end
  
  if e.color_enabled then
    let color = match d.level
    when DiagLevel::Error then "\x1b[31m"
    when DiagLevel::Warning then "\x1b[33m"
    when DiagLevel::Info then "\x1b[36m"
    when DiagLevel::Note then "\x1b[34m"
    when DiagLevel::Help then "\x1b[32m"
    end
    eprint_styled(level_str, color)
  else
    eprint(level_str)
  end
  
  # Print error code if present
  match d.code
  when Option::Some(code) then
    eprint("[" + code + "]")
  when Option::None then ()
  end

  eprint(": " + d.message + "\n")
  
  
  # Print source location
  match d.span
  when Option::Some(span) then
    print_source_location(e, span)
  when Option::None then ()
  end
  
  # Print notes
  for note in d.notes do
    eprint("note: " + note + "\n")
  end
  
  # Print suggestions
  for suggestion in d.suggestions do
    eprint("help: " + suggestion.message + "\n")
  end
  
  e.diagnostics.push(d)
end

pub def eprint_styled(s: String, style: String) -> Unit
  eprint(style + s + "\x1b[0m")
end

pub def eprint(s: String) -> Unit
  let _n = syscall_write(2, s.as_ptr(), s.len())
end

pub def print_source_location(e: &DiagnosticEmitter, span: Span) -> Unit
  # Find the source file containing this span using span.file
  var found_file: Option[SourceFile] = Option::None
  for f in e.source_map.files do
    if f.name == span.file then
      found_file = Option::Some(&f)
      break
    end
  end
  
  match found_file
  when Option::Some(file) then
    # Find the line number and column
    var line_num = 1
    var line_start = 0
    for offset in file.lines do
      if offset > span.start then
        break
      end
      line_start = offset
      line_num = line_num + 1
    end
    line_num = line_num - 1  # Adjust (loop increments one extra)
    let col = span.start - line_start
    
    # Find end of line
    var line_end = line_start
    while line_end < file.content.len() && file.content.char_at(line_end) != '\n' do
      line_end = line_end + 1
    end
    
    # Extract the source line
    let source_line = file.content.slice(line_start, line_end)
    
    # Print location header
    let loc_header = "  --> " + file.name.clone() + ":" + line_num.to_string() + ":" + (col + 1).to_string()
    
    # Print line number gutter
    let line_str = line_num.to_string()
    let padding = "     ".slice(0, 5 - line_str.len())
    
    # Print caret indicator
    var caret_line = ""
    var i = 0
    while i < 5 do
      caret_line = caret_line + " "
      i = i + 1
    end
    caret_line = caret_line + " | "
    i = 0
    while i < col do
      caret_line = caret_line + " "
      i = i + 1
    end
    # Draw the caret(s) for the span width
    let span_len = if span.end_pos > span.start then span.end_pos - span.start else 1 end
    i = 0
    while i < span_len do
      caret_line = caret_line + "^"
      i = i + 1
    end

    eprint(loc_header + "\n")
    eprint(padding + " |\n")
    eprint(line_str + padding + " | " + source_line + "\n")
    eprint(caret_line + "\n")

  when Option::None then
    # Fallback when the source file is not in the emitter's source map:
    # print the file name and byte offset so diagnostics are still locatable.
    eprint("  --> " + span.file.clone() + ":" + span.start.to_string() + "\n")
  end
end

# 
# JSON Diagnostic Output
# 

pub def emit_diagnostic_json(e: &DiagnosticEmitter, d: &Diagnostic) -> Unit
  var json = "{"
  
  # Level
  let level_str = match d.level
  when DiagLevel::Error then "error"
  when DiagLevel::Warning then "warning"
  when DiagLevel::Info then "info"
  when DiagLevel::Note then "note"
  when DiagLevel::Help then "help"
  end
  json = json + "\"level\":\"" + level_str + "\","
  
  # Message (escape special chars)
  json = json + "\"message\":\"" + json_escape(d.message.clone()) + "\","
  
  # Error code
  match d.code
  when Option::Some(code) then
    json = json + "\"code\":{\"code\":\"" + code + "\",\"explanation\":\"" +
           json_escape(explain_error_code(code.clone())) + "\"},"
  when Option::None then
    json = json + "\"code\":null,"
  end
  
  # Spans
  json = json + "\"spans\":["
  match d.span
  when Option::Some(span) then
    json = json + emit_span_json(e, span)
  when Option::None then ()
  end
  json = json + "],"
  
  # Notes as children
  json = json + "\"children\":["
  var first = true
  for note in d.notes do
    if !first then json = json + "," end
    json = json + "{\"level\":\"note\",\"message\":\"" + json_escape(note.clone()) + "\"}"
    first = false
  end
  json = json + "],"
  
  # Suggestions
  json = json + "\"suggestions\":["
  first = true
  for sugg in d.suggestions do
    if !first then json = json + "," end
    json = json + emit_suggestion_json(&sugg)
    first = false
  end
  json = json + "]"
  
  json = json + "}"
end

pub def emit_span_json(e: &DiagnosticEmitter, span: Span) -> String
  var json = "{"
  json = json + "\"byte_start\":" + span.start.to_string() + ","
  json = json + "\"byte_end\":" + span.end_pos.to_string() + ","
  
  # Try to find file and line info
  var found = false
  for f in e.source_map.files do
    if span.start < f.content.len() then
      # Find line and column
      var line_num = 1
      var line_start = 0
      for offset in f.lines do
        if offset > span.start then break end
        line_start = offset
        line_num = line_num + 1
      end
      line_num = line_num - 1
      let col = span.start - line_start
      
      # End line and column
      var end_line = 1
      var end_line_start = 0
      for offset in f.lines do
        if offset > span.end_pos then break end
        end_line_start = offset
        end_line = end_line + 1
      end
      end_line = end_line - 1
      let end_col = span.end_pos - end_line_start
      
      json = json + "\"file_name\":\"" + json_escape(f.name.clone()) + "\","
      json = json + "\"line_start\":" + line_num.to_string() + ","
      json = json + "\"line_end\":" + end_line.to_string() + ","
      json = json + "\"column_start\":" + (col + 1).to_string() + ","
      json = json + "\"column_end\":" + (end_col + 1).to_string() + ","
      json = json + "\"is_primary\":true"
      found = true
      break
    end
  end
  
  if !found then
    json = json + "\"file_name\":\"<unknown>\","
    json = json + "\"line_start\":0,\"line_end\":0,"
    json = json + "\"column_start\":0,\"column_end\":0,"
    json = json + "\"is_primary\":true"
  end
  
  json = json + "}"
  json
end

pub def emit_suggestion_json(sugg: &Suggestion) -> String
  var json = "{"
  json = json + "\"message\":\"" + json_escape(sugg.message.clone()) + "\","
  json = json + "\"replacement\":\"" + json_escape(sugg.replacement.clone()) + "\","
  json = json + "\"span\":" + "{"
  json = json + "\"byte_start\":" + sugg.span.start.to_string() + ","
  json = json + "\"byte_end\":" + sugg.span.end_pos.to_string()
  json = json + "}}"
  json
end

pub def json_escape(s: String) -> String
  var result = ""
  var i = 0
  while i < s.len() do
    let c = s.char_at(i)
    if c == '"' then
      result = result + "\\\""
    elsif c == '\\' then
      result = result + "\\\\"
    elsif c == '\n' then
      result = result + "\\n"
    elsif c == '\r' then
      result = result + "\\r"
    elsif c == '\t' then
      result = result + "\\t"
    elsif c == '\x08' then
      result = result + "\\b"
    elsif c == '\x0C' then
      result = result + "\\f"
    elsif (c as UInt) < 0x20 then
      # Escape other control characters as \u00XX
      let code = c as UInt
      let hex_digits = "0123456789abcdef"
      result = result + "\\u00"
      result = result + hex_digits.char_at(((code >> 4) & 0xF) as Int).to_string()
      result = result + hex_digits.char_at((code & 0xF) as Int).to_string()
    else
      result = result + c.to_string()
    end
    i = i + 1
  end
  result
end

pub def emit_all_diagnostics_json(e: &DiagnosticEmitter) -> String
  # Emit as a JSON array
  var json = "["
  var first = true
  for d in e.diagnostics do
    if !first then json = json + "," end
    # Re-serialize to JSON (simplified)
    let level_str = match d.level
    when DiagLevel::Error then "error"
    when DiagLevel::Warning then "warning"
    when DiagLevel::Info then "info"
    when DiagLevel::Note then "note"
    when DiagLevel::Help then "help"
    end
    json = json + "{\"level\":\"" + level_str + "\","
    json = json + "\"message\":\"" + json_escape(d.message.clone()) + "\"}"
    first = false
  end
  json = json + "]"
  json
end

pub def has_errors(e: &DiagnosticEmitter) -> Bool
  e.error_count > 0
end

# 
# Error Code Registry
# 

pub def explain_error_code(code: String) -> String
  match code.as_str()
  # Lexer/Parser errors
  when "E0001" then "Unexpected character in source input."
  when "E0002" then "Unterminated string literal."
  when "E0003" then "Expected expression but found a different token."
  when "E0004" then "Mismatched brackets, braces, or parentheses."
  when "E0005" then "Unexpected end of file while parsing."
  when "E0010" then "Invalid numeric literal format."
  when "E0011" then "Expected `:` after struct field name."
  when "E0012" then "Expected `end` to close block."
  when "E0013" then "Expected `->` before return type."
  when "E0014" then "Invalid pattern in match arm."
  
  # Name resolution errors
  when "E0100" then "Unresolved name  the identifier was not found in scope."
  when "E0101" then "Duplicate definition  a name was defined more than once in the same scope."
  when "E0102" then "Unresolved import  the imported module or symbol was not found."
  when "E0103" then "Glob import conflict  two glob imports bring the same name into scope."
  when "E0104" then "Private symbol cannot be accessed from this module."
  when "E0105" then "Cannot import from a non-module item."
  when "E0106" then "Circular import dependency detected."
  
  # Type checking errors
  when "E0200" then "Type mismatch  expected one type but found another."
  when "E0201" then "Unknown type name  the type was not found."
  when "E0202" then "Wrong number of type arguments for generic type."
  when "E0203" then "Missing field in struct literal."
  when "E0204" then "Unknown field in struct literal."
  when "E0205" then "Binary operator cannot be applied to these types."
  when "E0206" then "Cannot call a non-function type."
  when "E0207" then "Wrong number of arguments in function call."
  when "E0208" then "Return type mismatch  function body returns a different type."
  when "E0209" then "Cannot access field on a non-struct type."
  when "E0210" then "Cannot index into a non-array/non-Vec type."
  when "E0211" then "Match arms have incompatible types."
  when "E0212" then "Non-exhaustive match  not all variants are covered."
  when "E0213" then "Infinite type detected  a type refers to itself without indirection."
  
  # Trait errors
  when "E0270" then "Trait not satisfied  type does not implement the required trait."
  when "E0271" then "Associated type mismatch in trait implementation."
  when "E0272" then "Missing method in trait implementation."
  when "E0273" then "Method signature does not match trait definition."
  when "E0274" then "Orphan rule violation  cannot implement foreign trait for foreign type."
  when "E0275" then "Overlapping trait implementations  coherence violation."
  when "E0276" then "Negative trait bounds not satisfied."
  when "E0277" then "Required trait bound not satisfied."
  
  # Safety errors
  when "E0400" then "Operation requires unsafe context."
  when "E0401" then "Raw pointer dereference outside unsafe block."
  when "E0402" then "FFI call outside unsafe block."
  when "E0403" then "Access to mutable static outside unsafe block."
  when "E0404" then "Transmute call outside unsafe block."
  
  # Codegen errors
  when "E0500" then "Unsupported target architecture."
  when "E0501" then "Linker error  undefined symbol."
  when "E0502" then "Linker error  duplicate symbol."
  when "E0503" then "Object file format error."
  
  when _ then "No extended information available for this error code."
  end
end

pub def error_code_example(code: String) -> String
  match code.as_str()
  when "E0200" then
    "  def foo() -> Int\n    \"hello\"        # error: expected Int, found String\n  end"
  when "E0274" then
    "  # In crate `my_crate`:\n  impl std::fmt::Display for std::vec::Vec[Int]\n  # error: neither Display nor Vec is defined in the current crate"
  when _ then ""
  end
end

# 
# Compilation Pipeline
# 

pub struct CompilationUnit
  name: String
  source: String
  tokens: Vec[Token]
  ast: Option[Program]
  mir: Option[MirProgram]
end

pub def read_file_text_direct(path: String) -> String
  read_file_to_string_native(path)
end

# Canonical AST preparation: macro expansion + node-id assignment.
# analyze_parsed uses this, and the bootstrap "skip semantic checks" path
# uses it too, so preparation is defined exactly ONCE and every pipeline
# (ordinary compile, `tg check`, bootstrap compile) flows through the same
# preparation + analyze_parsed + lowering shape.
# P1 (macro hygiene, expansion-depth contract): the diagnostic bag is the
# parser's channel — when the 64-pass expansion fixpoint fails to converge,
# expand_macros records E105 into it (diag_macro_expansion_depth_exceeded);
# the caller checks diag_has_errors on it and returns the failed state before
# any lowering happens.
pub def prepare_parsed(program: &mut Program, diags: &mut Vec[Diagnostic]) -> Unit
  let expanded = expand_macros(program.clone(), diags)
  *program = expanded
  assign_node_ids(program)
end

# P1 diagnostic aggregation: a failing phase reports its ENTIRE error set,
# never just the first error. Each error becomes one line of the form
#   error at <file>:<start>: <message>
# and lines are joined with "\n". The pipeline's String interface is kept
# unchanged, so every consumer (compile_file_core, driver, lib) sees the
# full set without an interface break.
def join_type_errors(errors: &Vec[TypeError]) -> String
  var out = ""
  var first = true
  for e in errors do
    if !first then out = out + "\n" end
    first = false
    let code_str = match e.code
    when Option::Some(c) then "[" + c + "] "
    when Option::None then ""
    end
    out = out + "error at " + e.span.file + ":" + e.span.start.to_string() + ": " + code_str + e.message
  end
  out
end

def join_access_errors(errors: &Vec[AccessError]) -> String
  var out = ""
  var first = true
  for e in errors do
    if !first then out = out + "\n" end
    first = false
    out = out + "error at " + e.span.file + ":" + e.span.start.to_string() + ": " + e.message
  end
  out
end

def join_resource_errors(errors: &Vec[ResourceError]) -> String
  var out = ""
  var first = true
  for e in errors do
    if !first then out = out + "\n" end
    first = false
    out = out + "error at " + e.span.file + ":" + e.span.start.to_string() + ": " + e.message
  end
  out
end

def join_resolution_errors(errors: &Vec[ResolutionError]) -> String
  var out = ""
  var first = true
  for e in errors do
    if !first then out = out + "\n" end
    first = false
    out = out + "error at " + e.span.file + ":" + e.span.start.to_string() + ": " + e.message
  end
  out
end

def join_parse_diagnostics(diags: &Vec[Diagnostic]) -> String
  var out = ""
  var first = true
  for d in diags do
    if !first then out = out + "\n" end
    first = false
    let loc = match d.span
    when Option::Some(sp) then "error at " + sp.file + ":" + sp.start.to_string() + ": "
    when Option::None then "error: "
    end
    out = out + loc + d.message
  end
  out
end

pub def analyze_parsed(env: &mut TypeEnv, program: &mut Program, opts: &CompilerOptions) -> Result[TypedProgram, String]
  # P1 (macro hygiene, expansion-depth contract): preparation records E105
  # through the parser's diagnostic channel when the expansion fixpoint does
  # not converge; diag_has_errors then returns the failed state BEFORE
  # resolution/type-checking (and therefore before any lowering) — an
  # incompletely expanded AST is never semantically processed.
  var macro_diags: Vec[Diagnostic] = Vec::new()
  prepare_parsed(program, &mut macro_diags)
  if diag_has_errors(&macro_diags) then
    return Result::Err(join_parse_diagnostics(&macro_diags))
  end
  match resolve_names(program)
  when Result::Ok(res) then
    # P1 (recovery separation): the compilation path ALWAYS runs strict.
    # Guard: a real compilation with strict_resolution = false is an internal
    # error, so the flag is forced on unconditionally here (type_check_typed
    # enforces the same invariant); permissive resolution is unreachable from
    # compilation and remains only for editor recovery via type_check /
    # type_check_strict (errors only, never a codegenable TypedProgram).
    env.strict_resolution = true
    let type_result = type_check_typed(env, program, &res)
    if !type_result.errors.is_empty() then
      return Result::Err(join_type_errors(&type_result.errors))
    end
    let typed = type_result.program
    let access_errors = access_check(program, &typed)
    if !access_errors.is_empty() then
      return Result::Err(join_access_errors(&access_errors))
    end
    let res_result = resource_check(program, &typed)
    if !res_result.errors.is_empty() then
      return Result::Err(join_resource_errors(&res_result.errors))
    end
    # The authoritative per-function finalize plan flows from the resource
    # checker into the typed program so MIR cleanup is single-sourced (MIR
    # consumes typed.finalize_plan instead of re-deriving ownership).
    Result::Ok(TypedProgram {
      ast: typed.ast,
      resolutions: typed.resolutions,
      expr_types: typed.expr_types,
      typed_exprs: typed.typed_exprs,
      call_targets: typed.call_targets,
      call_instances: typed.call_instances,
      field_targets: typed.field_targets,
      access_effects: typed.access_effects,
      closure_captures: typed.closure_captures,
      local_bindings: typed.local_bindings,
      ident_resolutions: typed.ident_resolutions,
      param_binding_resolutions: typed.param_binding_resolutions,
      pattern_binding_resolutions: typed.pattern_binding_resolutions,
      deinit_plans: typed.deinit_plans,
      aggregate_ownership: typed.aggregate_ownership,
      finalize_plan: res_result.finalize_plan,
      # P0-CE: the String-keyed edge_cleanup serialization is DELETED from
      # the checker's result; the TypedProgram field (types.tg) is kept
      # empty and unread — the MIR consumes the CleanupEdge table through
      # the checker's own result channel (lower_program re-runs
      # resource_check and reads plan_result.cfg).
      edge_cleanup: Map::new(),
      type_names: typed.type_names,
      deinit_targets: typed.deinit_targets,
      type_fields: typed.type_fields,
      type_variants: typed.type_variants,
      type_params: typed.type_params,
      type_kinds: typed.type_kinds,
      generic_param_ids: typed.generic_param_ids,
      generic_param_names: typed.generic_param_names
    })
  when Result::Err(res_errors) then
    if res_errors.len() > 0 then
      Result::Err(join_resolution_errors(&res_errors))
    else
      Result::Err("name resolution failed")
    end
  end
end

pub def analyze_program(env: &mut TypeEnv, program: &mut Program, opts: &CompilerOptions) -> Result[TypedProgram, String]
  analyze_parsed(env, program, opts)
end

pub def analyze_source(source: String, file: String, opts: &CompilerOptions) -> Result[TypedProgram, String]
  let lex_result = tokenize(source, file)
  let parse_out = parse(lex_result)
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return Result::Err(join_parse_diagnostics(&parse_diags))
  end
  var ast = parse_out.program
  var env = type_env_new()
  analyze_parsed(&mut env, &mut ast, opts)
end

pub def compile_file_core(path: String, opts: &CompilerOptions, emitter: &mut DiagnosticEmitter) -> Result[Unit, String]
  if opts.verbose then
    println("[diag] compile_file_core entered, path=" + path.clone())
  end

  let source = read_file_text_direct(path.clone())
  if source.len() == 0 then
    return Result::Err("Failed to read file: " + path.clone())
  end

  if opts.verbose then
    println("  Source len=" + source.len().to_string())
  end

  let is_bootstrap_driver = is_compiler_driver_path(path.clone())
  
  if !is_bootstrap_driver then
    add_source(emitter, path.clone(), source)
  end
  
  if opts.verbose then
    println("Compiling: " + path.clone())
  end
  
  # Phase 1: Lexing
  if opts.verbose then
    println("  Lexing...")
  end
  
  # Create lexer and tokenize
  var lex = lexer_new(source, path.clone())
  let lex_result = tokenize_impl(&mut lex)
  if opts.print_tokens then
    println("Tokens:")
    for tok in lex_result.tokens do
      println("  " + token_debug(tok))
    end
  end
  match opts.dump_phase
  when Option::Some("tokens") then
    return Result::Ok(())
  when _ then ()
  end
  
  # Phase 2: Parsing
  if opts.verbose then
    println("  Parsing...")
  end
  
  let parse_out = parse(lex_result)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return Result::Err("Parse error")
  end

  if opts.verbose then
  end
  
  if opts.print_ast then
    println("AST:")
    print_ast(&ast)
  end
  
  match opts.dump_phase
  when Option::Some("ast") then
    println("AST:")
    print_ast(&ast)
    return Result::Ok(())
  when _ then ()
  end
  
  if opts.stop_after == StopAfter::Parse then
    return Result::Ok(())
  end
  
  # Phase 2.3: Standard library prelude is merged structurally later.
  # Avoid concatenating std source text into the current file, which corrupts
  # spans and makes parse failures in prelude modules look like local source errors.
  let ast_with_prelude = ast

  # Phase 2.4: Merge imported dependencies (so MIR lowering sees all functions)
  if opts.verbose then
    let import_paths = extract_import_paths(&ast_with_prelude)
  end

  if opts.verbose then
    println("[diag] before merge_imported_deps")
  end
  # `var` so the canonical semantic pass below can take &mut ast.
  var ast = match merge_imported_deps(ast_with_prelude, include_compiler_lib: is_bootstrap_driver)
  when Result::Ok(a) then a
  when Result::Err(e) then
    return Result::Err(e)
  end
  if opts.verbose then
    println("[diag] after merge_imported_deps")
  end

  match opts.dump_phase
  when Option::Some("resolved-ast") then
    # DEBUG-ONLY dump path: expands macros and assigns node ids locally for
    # human inspection. It does NOT feed the real pipeline — the canonical
    # semantic pass (analyze_parsed) performs its own expansion/id assignment
    # on the shared `ast` below. The diagnostic bag is discarded: this path
    # is not a compilation, so the E105 failed state is not applicable.
    var dump_diags: Vec[Diagnostic] = Vec::new()
    var dump_ast = expand_macros(ast.clone(), &mut dump_diags)
    assign_node_ids(&mut dump_ast)
    println("Resolved AST:")
    print_ast(&dump_ast)
    return Result::Ok(())
  when _ then ()
  end

  if opts.verbose then
  end
  
  # Phase 2.5: Macro expansion and node-id assignment are NOT performed here.
  # They are part of the single canonical semantic API analyze_parsed (called
  # below via analyze_program). Performing them again beforehand expanded
  # macros TWICE and assigned node ids twice — the second pass renumbers
  # node ids, corrupting any identity derived from the first pass, and the
  # divergent pre-pass made positive and negative canaries flow through
  # different semantic pipelines.
  if opts.verbose then
  end
  
  # Phase 3: Type checking
  if opts.verbose then
    println("  Type checking...")
  end
  var typed_program: Option[TypedProgram] = Option::None
  var env = type_env_new()
  match analyze_program(&mut env, &mut ast, opts)
  when Result::Ok(tp) then
    typed_program = Option::Some(tp)
  when Result::Err(e) then
    emit_diagnostic(emitter, Diagnostic {
      level: DiagLevel::Error,
      message: e,
      span: Option::None,
      notes: Vec::new(),
      suggestions: Vec::new(),
      code: Option::Some("E0405")
    })
    return Result::Err("Type check failed")
  end
  
  if opts.stop_after == StopAfter::Semantic then
    return Result::Ok(())
  end
  
  # Phase 5: MIR lowering
  if opts.verbose then
    println("  Lowering to MIR...")
  end
  
  var mir = MirProgram { functions: Vec::new(), statics: Vec::new(), types: Vec::new() }
  match driver_lower_to_mir(&ast, &typed_program)
  when Result::Ok(m) then
    mir = m
  when Result::Err(e) then
    eprintln("MIR lowering failed: " + e)
    return Result::Err("MIR lowering failed: " + e)
  end

  if opts.verbose then
  end

  # Verify MIR invariants after lowering.
  let post_lower_errs = verify_mir(&mir)
  if !post_lower_errs.is_empty() then
    for e in post_lower_errs do
      eprintln("MIR verifier (post-lower): " + e)
    end
    return Result::Err("MIR verification failed after lowering")
  end

  # `tg check` stops here: the program has been lexed, parsed, dependencies
  # resolved, macros expanded, type-checked, access-checked, lowered to MIR and
  # verified — without generating native code.
  match opts.dump_phase
  when Option::Some("mir-lowered") then
    print_mir(&mir)
    return Result::Ok(())
  when _ then ()
  end

  if opts.stop_after == StopAfter::Mir then
    return Result::Ok(())
  end

  # Phase 5.5: Monomorphization  specialize generic functions for concrete types
  if opts.verbose then
    println("  Monomorphizing generics...")
  end
  var mono_cache = match typed_program
  when Option::Some(tp) then mono_cache_new(&ast, &tp.resolutions)
  when Option::None then return Result::Err("monomorphization requires a typed program")
  end
  match monomorphize_program(&mut mir, &mut mono_cache)
  when Result::Err(mono_errs) then
    for e in mono_errs do
      eprintln("monomorphization error: " + e)
    end
    return Result::Err("monomorphization failed with " + mono_errs.len().to_string() + " error(s)")
  when Result::Ok(_) then ()
  end

  if opts.verbose then
  end

  # Verify MIR invariants after monomorphization.
  let post_mono_errs = verify_mir(&mir)
  if !post_mono_errs.is_empty() then
    for e in post_mono_errs do
      eprintln("MIR verifier (post-mono): " + e)
    end
    return Result::Err("MIR verification failed after monomorphization")
  end

  match opts.dump_phase
  when Option::Some("mir-mono") then
    print_mir(&mir)
    return Result::Ok(())
  when _ then ()
  end

  # Phase 5.6: MIR Optimization (gated by opt_level)
  if opts.verbose then
    println("  Optimizing MIR (O" + opts.opt_level.to_string() + ")...")
  end
  
  # PGO instrumentation: if --pgo-gen, instrument before optimization
  match opts.pgo_gen
  when Option::Some(_) then
    instrument_for_pgo(&mut mir)
  when Option::None then ()
  end
  
  # PGO-guided optimization: if --pgo-use, load profile and apply. An
  # explicitly requested profile must load; silently ignoring a failed read
  # would quietly compile without the requested optimization.
  match opts.pgo_use
  when Option::Some(profile_path) then
    match read_pgo_profile(&profile_path)
    when Result::Ok(profile) then
      apply_pgo_profile(&mut mir, &profile)
    when Result::Err(e) then
      return Result::Err("failed to read requested PGO profile '" + profile_path + "': " + e)
    end
  when Option::None then ()
  end
  
  if opts.emit_mir then
  end

  optimize_mir(&mut mir, opts.opt_level)

  if opts.verbose then
  end

  # Verify MIR invariants after optimization.
  let post_opt_errs = verify_mir(&mir)
  if !post_opt_errs.is_empty() then
    for e in post_opt_errs do
      eprintln("MIR verifier (post-opt): " + e)
    end
    return Result::Err("MIR verification failed after optimization")
  end

  if opts.emit_mir then
    print_mir(&mir)
    return Result::Ok(())
  end

  match opts.dump_phase
  when Option::Some("mir-opt") then
    print_mir(&mir)
    return Result::Ok(())
  when _ then ()
  end
  
  # Phase 6: Native code generation
  if opts.verbose then
    println("  Generating native code...")
  end
  
  let target = match opts.target_triple
  when Option::Some(triple) then parse_target_triple(triple)
  when Option::None then detect_host_target()
  end
  
  match opts.emit
  when EmitMode::Object then
    let obj_bytes = match generate_object_file(&mir, &target)
    when Result::Ok(b) then b
    when Result::Err(e) then
      println(e)
      return 1
    end
    let obj_path = get_output_path(opts, path.clone(), ".o")
    match write_file_bytes(obj_path.clone(), &obj_bytes)
    when Result::Ok(_) then
      if !file_exists(obj_path.clone()) then
        return Result::Err("Failed to materialize object file: " + obj_path)
      end
      if !opts.quiet then
        println("Object file: " + obj_path)
      end
    when Result::Err(e) then
      return Result::Err("Failed to write object file: " + e)
    end
    if opts.stop_after == StopAfter::Object then
      return Result::Ok(())
    end
  when EmitMode::Executable then
    let exe_path = get_output_path(opts, path.clone(), "")
    if file_exists(exe_path.clone()) then
      let _ = delete_file(exe_path.clone())
    end

    match generate_executable(&mir, &target, exe_path.clone())
    when Result::Ok(_) then ()
    when Result::Err(e) then
      return Result::Err("Native compilation failed: " + e)
    end
    if !opts.quiet then
      println("Compiled: " + exe_path)
    end
  when _ then ()
  end

  if opts.verbose then
    println("  Returning compile_file_core OK")
  end
  
  Result::Ok(())
end

pub def compile_file(opts: &CompilerOptions, path: String) -> Result[String, String]
  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end
  match compile_file_core(path, opts, &mut emitter)
  when Result::Ok(_) then
    Result::Ok("")
  when Result::Err(e) then
    Result::Err(e)
  end
end

pub def compile_startup_file_raw(opts: &CompilerOptions, path_arg_index: Int) -> Result[String, String]
  let path = raw_arg_copy(path_arg_index)
  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end
  match compile_file_core(path, opts, &mut emitter)
  when Result::Ok(_) then
    Result::Ok("")
  when Result::Err(e) then
    Result::Err(e)
  end
end


pub def compile_startup_entry(opts: &CompilerOptions, path: String, output_path: String) -> Int
  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end

  let source = read_file_text_direct(path.clone())
  if source.len() == 0 then
    println("Failed to read file: " + path.clone())
    return 1
  end

  if opts.verbose then
    println("  Source len=" + source.len().to_string())
  end

  let is_bootstrap_driver = is_compiler_driver_path(path.clone())
  if !is_bootstrap_driver then
    add_source(&mut emitter, path.clone(), source)
  end

  if opts.verbose then
    println("Compiling: " + path.clone())
    println("  Lexing...")
  end

  var lex = lexer_new(source, path.clone())
  let lex_result = tokenize_impl(&mut lex)
  if opts.print_tokens then
    println("Tokens:")
    for tok in lex_result.tokens do
      println("  " + token_debug(tok))
    end
  end

  if opts.verbose then
    println("  Parsing...")
  end

  let parse_out = parse(lex_result)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    var i = 0
    while i < parse_diags.len() do
      let d = parse_diags[i]
      println("Parse error: " + d.message)
      i = i + 1
    end
    return 1
  end

  if opts.print_ast then
    println("AST:")
    print_ast(&ast)
  end

  if opts.stop_after == StopAfter::Parse then
    return 0
  end

  let ast_with_prelude = ast
  if opts.verbose then
    let import_paths = extract_import_paths(&ast_with_prelude)
  end

  # `var` so the canonical semantic pass below can take &mut ast.
  var ast = match merge_imported_deps(ast_with_prelude, include_compiler_lib: is_bootstrap_driver)
  when Result::Ok(a) then a
  when Result::Err(e) then
    println(e)
    return 1
  end

  let skip_bootstrap_semantic_checks = should_skip_bootstrap_semantic_checks(opts, path.clone())
  if opts.verbose then
    println("  Type checking...")
  end
  # THE ONE canonical semantic path: analyze_parsed (via analyze_program)
  # expands macros, assigns node ids, resolves names, type-checks,
  # access-checks and resource-checks. compile_startup_entry must not contain
  # any semantic stage of its own — a second hand-rolled pipeline here
  # duplicated expansion and node-id assignment and could drift from what
  # analyze_parsed does, so positive and negative canaries were checked
  # through different routes.
  var typed_program: Option[TypedProgram] = Option::None
  if skip_bootstrap_semantic_checks then
    if opts.verbose then
      println("  Skipping semantic checks during compiler bootstrap")
    end
    # The bootstrap path still needs a prepared AST (macros expanded, node
    # ids assigned) so the shared MIR lowering below can run; preparation is
    # the same canonical helper analyze_parsed uses. The E105 diagnostic
    # channel is honored even here: a non-converging expansion must fail the
    # bootstrap loudly, never silently continue with a partial expansion.
    var bootstrap_diags: Vec[Diagnostic] = Vec::new()
    prepare_parsed(&mut ast, &mut bootstrap_diags)
    if diag_has_errors(&bootstrap_diags) then
      println(join_parse_diagnostics(&bootstrap_diags))
      return 1
    end
  else
    var env = type_env_new()
    # P1 (recovery separation): compilation always runs strict — the flag is
    # forced on unconditionally at the invocation (a real compilation with
    # strict_resolution = false is an internal error); permissive editor
    # recovery never produces a TypedProgram.
    env.strict_resolution = true
    match analyze_program(&mut env, &mut ast, opts)
    when Result::Ok(tp) then
      typed_program = Option::Some(tp)
    when Result::Err(e) then
      emit_diagnostic(&mut emitter, Diagnostic {
        level: DiagLevel::Error,
        message: e,
        span: Option::None,
        notes: Vec::new(),
        suggestions: Vec::new(),
        code: Option::Some("E0405")
      })
      println("Type check failed")
      return 1
    end
  end

  if !skip_bootstrap_semantic_checks && has_errors(&emitter) then
    println("Type check failed")
    return 1
  end

  if opts.verbose then
    println("  Lowering to MIR...")
  end
  var mir = MirProgram { functions: Vec::new(), statics: Vec::new(), types: Vec::new() }
  match driver_lower_to_mir(&ast, &typed_program)
  when Result::Ok(m) then
    mir = m
  when Result::Err(e) then
    eprintln("MIR lowering failed: " + e)
    return 1
  end

  let post_lower_errs = verify_mir(&mir)
  if !post_lower_errs.is_empty() then
    for e in post_lower_errs do
      eprintln("MIR verifier (post-lower): " + e)
    end
    println("MIR verification failed after lowering")
    return 1
  end

  if opts.verbose then
    println("  Monomorphizing generics...")
  end
  var mono_cache = match typed_program
  when Option::Some(tp) then mono_cache_new(&ast, &tp.resolutions)
  when Option::None then return 1
  end
  match monomorphize_program(&mut mir, &mut mono_cache)
  when Result::Err(mono_errs) then
    for e in mono_errs do
      eprintln("monomorphization error: " + e)
    end
    println("monomorphization failed with " + mono_errs.len().to_string() + " error(s)")
    return 1
  when Result::Ok(_) then ()
  end

  let post_mono_errs = verify_mir(&mir)
  if !post_mono_errs.is_empty() then
    for e in post_mono_errs do
      eprintln("MIR verifier (post-mono): " + e)
    end
    println("MIR verification failed after monomorphization")
    return 1
  end

  if opts.verbose then
    println("  Optimizing MIR (O" + opts.opt_level.to_string() + ")...")
  end
  match opts.pgo_gen
  when Option::Some(_) then
    instrument_for_pgo(&mut mir)
  when Option::None then ()
  end

  match opts.pgo_use
  when Option::Some(profile_path) then
    match read_pgo_profile(&profile_path)
    when Result::Ok(profile) then
      apply_pgo_profile(&mut mir, &profile)
    when Result::Err(e) then
      println("failed to read requested PGO profile '" + profile_path + "': " + e)
      return 1
    end
  when Option::None then ()
  end

  optimize_mir(&mut mir, opts.opt_level)

  let post_opt_errs = verify_mir(&mir)
  if !post_opt_errs.is_empty() then
    for e in post_opt_errs do
      eprintln("MIR verifier (post-opt): " + e)
    end
    println("MIR verification failed after optimization")
    return 1
  end

  if opts.emit_mir then
    print_mir(&mir)
    return 0
  end

  if opts.verbose then
    println("  Generating native code...")
  end
  let target = if skip_bootstrap_semantic_checks then
    bootstrap_codegen_target()
  else
    match opts.target_triple
    when Option::Some(triple) then parse_target_triple(triple)
    when Option::None then detect_host_target()
    end
  end

  match opts.emit
  when EmitMode::Object then
    let obj_bytes = match generate_object_file(&mir, &target)
    when Result::Ok(b) then b
    when Result::Err(e) then
      println(e)
      return 1
    end
    match write_file_bytes(output_path.clone(), &obj_bytes)
    when Result::Ok(_) then
      if !file_exists(output_path.clone()) then
        println("Failed to materialize object file: " + output_path.clone())
        return 1
      end
      if !opts.quiet then
        println("Object file: " + output_path.clone())
      end
    when Result::Err(e) then
      println("Failed to write object file: " + e)
      return 1
    end
  when EmitMode::Executable then
    if file_exists(output_path.clone()) then
      let _ = delete_file(output_path.clone())
    end

    match generate_executable(&mir, &target, output_path.clone())
    when Result::Ok(_) then ()
    when Result::Err(e) then
      println("Native compilation failed: " + e)
      return 1
    end
    # write_file_bytes already reports errors. file_exists uses raw_stat which
    # may have wrong syscall numbers on macOS AArch64. Skip the redundant check.
    if !opts.quiet then
      println("Compiled: " + output_path.clone())
    end
  when _ then ()
  end

  0
end

# Recursively load and merge imported dependency files into the program.
# This ensures function definitions from imports (e.g. println from std::io)
# are available during MIR lowering, not just type definitions.
# include_compiler_lib: when true, also preload the compiler KERNEL library
# (tg_compiler/lib_kernel.tg, the minimal bootstrap subset declared in
# bootstrap/compiler_kernel.manifest) so the compiler's internal types are
# available during type checking of the compiler's own source files. For user
# code compilation, this should be false to avoid polluting the type namespace
# with compiler internals. The full lib.tg is only for users embedding the
# complete compiler.
#
# MODULE FLATTENING (P0-AM): imported modules are recursively parsed and
# their items merged into one Program, and the Crate module table is the
# single module identity (see the P0-AM note below). store_type_def
# (types.tg) registers each declaration under its module-qualified key, so
# same-named DISTINCT types in different modules are distinct module-local
# types — never merged.
#
# P0-AM module table (construction site): while flattening, this function
# (with collect_dep_file below) BUILDS the Program.crate Crate — the single
# module table the reviewer's design specifies: Crate { root: ModuleId,
# modules: Map[ModuleId, Module] }, one Module per distinct module, each
# carrying its OWN item list (Module.items: Vec[ItemId] — an ItemId is the
# item's index into the flat Program.items) and path, and every item its
# owner ModuleId directly. ModuleIds are assigned in processing order: the
# root module (the main program's top-level items) is id 0, and each
# distinct dependency gets the next id — the `loaded` set dedups, so every
# module path is recorded exactly once. The flat items vector stays the
# interface; the Crate is CONSUMED by the resolver's per-module
# registration tables (SymbolTable.module_tables, keyed by each Module's
# path joined by "::") — the first-wins REGISTRATION decision for every
# item is (owner ModuleId, namespace, name) against that per-module table,
# so a same-named declaration in a DIFFERENT file module registers its own
# qualified entry instead of failing the root bare-name occupancy.
pub def merge_imported_deps(program: Program, include_compiler_lib: Bool = false) -> Result[Program, String]
  var loaded = Set::new()
  var merged_items = Vec::new()
  var merged_modules = Map::new()
  # Program items first  ensures the main program's definitions
  # (especially main) take priority over dependency definitions.
  # Shared iteration is projected (by reference): the element is cloned for
  # the move into the merged list (consuming iteration is not supported yet).
  for item in program.items do
    merged_items.push(item.clone())
  end
  # P0-AM: the root module (id 0, empty path, no imports) covers the main
  # program's top-level items; dependencies get ids 1, 2, ... in processing
  # order. P1: the root module's per-module item list (Module.items:
  # Vec[ItemId]) is built here — each ItemId the flat index of one main
  # program item (the items already carry the root owner ModuleId from the
  # parser's make_item).
  var root_items = Vec::new()
  var ri = 0
  while ri < merged_items.len() do
    root_items.push(ItemId { id: ri })
    ri = ri + 1
  end
  let root_id = ModuleId { id: 0 }
  merged_modules.insert(root_id, Module {
    id: root_id,
    path: Vec::new(),
    items: root_items,
    imports: Vec::new()
  })
  # Canonical bootstrap source list: when compiling the compiler itself
  # (include_compiler_lib), consume bootstrap/compiler_kernel.manifest exactly
  # like stage0 (sorted std files, then sorted compiler files). User programs
  # keep the normal prelude + recursive import discovery.
  let preludes = if include_compiler_lib then
    match bootstrap_manifest_sources()
    when Option::Some(files) then files
    when Option::None then prelude_files()
    end
  else
    prelude_files()
  end
  for prelude in preludes do
    match collect_dep_file(prelude, &mut merged_items, &mut loaded, &mut merged_modules)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      return Result::Err(dep_error_message(e, prelude))
    end
  end
  if include_compiler_lib then
    # Bootstrap loads the KERNEL library (lib_kernel.tg), which re-exports only
    # the minimal self-hostable module set. The full lib.tg is reserved for
    # user embedding and pulls in non-bootstrap tooling modules. This keeps the
    # bootstrap compiler closure small (bootstrap/compiler_kernel.manifest).
    match collect_dep_file("tg_compiler/lib_kernel.tg", &mut merged_items, &mut loaded, &mut merged_modules)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      return Result::Err(dep_error_message(e, "tg_compiler/lib_kernel.tg"))
    end
  end
  match collect_dep_items(&program, &mut merged_items, &mut loaded, &mut merged_modules)
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err(dep_error_message(e, "<program>"))
  end
  Result::Ok(Program {
    items: merged_items,
    crate: Crate { root: root_id, modules: merged_modules },
    span: program.span
  })
end

pub def build_dep_file_path(segments: &Vec[String], count: Int) -> Option[String]
  if count < 2 then
    return Option::None
  end

  let root = segments[0]
  var path = if root == "std" then
    "std/"
  elsif root == "tg_compiler" then
    "tg_compiler/"
  else
    return Option::None
  end

  var i = 0
  i = 1
  while i < count do
    if i > 1 then
      path = path + "/"
    end
    path = path + segments[i]
    i = i + 1
  end

  Option::Some(path + ".tg")
end

pub def dep_use_to_file(u: &UseDecl) -> Option[String]
  let segment_count = u.path.segments.len()
  if segment_count < 2 then
    return Option::None
  end

  # Braced and glob imports already carry the containing module path.
  match u.names
  when Option::Some(_) then
    return build_dep_file_path(&u.path.segments, segment_count)
  when Option::None then ()
  end
  if u.glob then
    return build_dep_file_path(&u.path.segments, segment_count)
  end

  match build_dep_file_path(&u.path.segments, segment_count)
  when Option::Some(full_path) then
    if file_exists(full_path.clone()) then
      return Option::Some(full_path)
    end
    if segment_count > 2 then
      match build_dep_file_path(&u.path.segments, segment_count - 1)
      when Option::Some(parent_path) then
        if file_exists(parent_path.clone()) then
          return Option::Some(parent_path)
        end
      when Option::None then ()
      end
    end
    Option::None
  when Option::None then
    Option::None
  end
end

pub def collect_dep_items(program: &Program, out: &mut Vec[Item], loaded: &mut Set[String], modules: &mut Map[ModuleId, Module]) -> Result[Unit, DependencyError]
  # P0-AM (module table construction site): this drives the recursive
  # dependency walk that merge_imported_deps's Crate consumes. Every distinct
  # dependency file yields exactly one Module (see collect_dep_file); the
  # `loaded` set keys the dedup, so ModuleIds stay 1:1 with module paths and
  # the resolver's per-module registration tables key by those paths.
  for item in program.items do
    match item.kind
    when ItemKind::ItemUse(u) then
      match dep_use_to_file(&u)
      when Option::Some(path) then
        match collect_dep_file(path, out, loaded, modules)
        when Result::Ok(_) then ()
        when Result::Err(e) then
          return Result::Err(e)
        end
      when Option::None then ()
      end
    when _ then ()
    end
  end
  Result::Ok(())
end

# P0-AM: derive the module path segments of a dependency file for its
# Module ("std/core.tg" -> ["std", "core"], "tg_compiler/ast.tg" ->
# ["tg_compiler", "ast"]). The main program is the root module ([]).
def module_path_from_file(path: &String) -> Vec[String]
  var segments = Vec::new()
  let parts = path.split("/")
  var pi = 0
  while pi < parts.len() do
    var seg = parts[pi].clone()
    if pi == parts.len() - 1 && seg.ends_with(".tg") then
      seg = seg.slice(0, seg.len() - 3)
    end
    if !seg.is_empty() then
      segments.push(seg)
    end
    pi = pi + 1
  end
  segments
end

pub def collect_dep_file(path: String, out: &mut Vec[Item], loaded: &mut Set[String], modules: &mut Map[ModuleId, Module]) -> Result[Unit, DependencyError]
  if loaded.contains(&path) then
    return Result::Ok(())
  end
  loaded.insert(path.clone())

  # Distinguish a legitimate empty module from a failed read. An empty string
  # from a non-existent/unreadable file is an error, not an empty module.
  if !file_exists(path.clone()) then
    return Result::Err(DependencyError::Read)
  end
  let source = read_file_text_direct(path)

  let tokens = tokenize(source, path.clone())
  let dep_parse = parse(tokens)
  let dep_parse_diags = dep_parse.diagnostics
  if diag_has_errors(&dep_parse_diags) then
    # Never merge a partially valid dependency into a compiler program.
    var di = 0
    while di < dep_parse_diags.len() do
      let d = dep_parse_diags[di]
      match d.span
      when Option::Some(sp) then
        eprintln("dep parse [" + path + "] @" + sp.start.to_string() + ": " + d.message)
      when Option::None then
        eprintln("dep parse [" + path + "]: " + d.message)
      end
      di = di + 1
    end
    return Result::Err(dep_error_message(DependencyError::Parse, path))
  end

  let dep_ast = dep_parse.program
  # Recurse into this dependency's own imports
  match collect_dep_items(&dep_ast, out, loaded, modules)
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err(e)
  end
  # MODULE FLATTENING (P0-AM): add all items from this dependency into the
  # single merged Program.items vector (see merge_imported_deps). Dedup: the
  # `loaded` set is keyed by module path and is inserted before recursion, so
  # each distinct module is processed exactly once; diamond and cyclic imports
  # neither duplicate items nor recurse forever. Items of a module stay
  # contiguous after its own imports, so per-module ordering is preserved.
  # P1 (module table — construction site): record this module's Module in
  # the Crate here — the `loaded` dedup above guarantees exactly one entry
  # per distinct module path, and the ModuleId is its processing order
  # (root = 0, then 1, 2, ... in dependency-processing order). The per-module
  # item list (Module.items: Vec[ItemId]) is built HERE, once, around the
  # push loop below — each ItemId is the pushed item's index into the flat
  # Program.items — and EVERY pushed item is stamped with its owning
  # dep_id (Item.owner_module), so owner lookups are table reads, never
  # range scans. The module's imports field carries its own use declarations
  # (path joins) for the Crate's import-graph transition. The resolver's
  # per-module registration tables (SymbolTable.module_tables) key by this
  # path joined by "::" — the module path join is the per-module identity
  # the (owner ModuleId, namespace, name) duplicate test runs against.
  var mod_start = out.len()
  let dep_id = ModuleId { id: modules.len() }
  # Shared iteration is projected: clone the item for the move into `out`,
  # stamping the dependency's ModuleId onto the clone (the parser's root
  # default no longer applies — this item belongs to this file module).
  for item in dep_ast.items do
    var owned = item.clone()
    owned.owner_module = dep_id
    out.push(owned)
  end
  var mod_items = Vec::new()
  var mi = mod_start
  while mi < out.len() do
    mod_items.push(ItemId { id: mi })
    mi = mi + 1
  end
  var mod_imports = Vec::new()
  for item in dep_ast.items do
    match item.kind
    when ItemKind::ItemUse(u) then
      mod_imports.push(u.path.segments.join("::"))
    when _ then ()
    end
  end
  modules.insert(dep_id, Module {
    id: dep_id,
    path: module_path_from_file(&path),
    items: mod_items,
    imports: mod_imports
  })
  Result::Ok(())
end

pub def get_output_path(opts: &CompilerOptions, input: String, ext: String) -> String
  match opts.output_file
  when Option::Some(out) then out
  when Option::None then
    # Replace .tg with ext
    if input.ends_with(".tg") then
      input.slice(0, input.len() - 3) + ext
    else
      input + ext
    end
  end
end

pub def token_debug(tok: Token) -> String
  tok.kind.to_string() + " @ " + tok.span.start.to_string() + ".." + tok.span.end_pos.to_string()
end

pub def print_ast(program: &Program) -> Unit
  println("Program with " + program.items.len().to_string() + " items")
  for item in program.items do
    println("  Item: " + item.kind.to_string())
  end
end

pub def print_mir(mir: &MirProgram) -> Unit
  println(pretty_print_mir(mir))
end

pub struct MacroEnv
  # P1 (macro identity): the macro table is MODULE-SCOPED. Every macro is
  # registered under its module-qualified identity — the (module path, name)
  # pair rendered with the resolver's module-qualified key form
  # ("path::name", the root module's empty path degenerates to the bare
  # name, exactly like module_qualified_key in resolver.tg) — so macros obey
  # the same module/import ambiguity rules as other declarations: a macro
  # defined in module a is NOT visible as a bare name in module b, and two
  # macros with the same name in the same module (or imported into the same
  # scope) are an ambiguity ERROR (E107), never a last-wins shadow. The
  # qualified keys are MacroId { module_path, name } rendered by macro_id_key.
  macros: Map[String, MacroDecl]
  # P1 (macro identity): the module path (Program.crate module path) of the
  # item currently being expanded. expand_program_pass sets it per item from
  # the item's OWNER ModuleId (program.items[i].owner_module -> the crate
  # table — see module_path_for_item); it is the resolution anchor for
  # bare macro names and for relative qualified paths at call sites.
  current_module: Vec[String]
  # P1 (macro identity): per-module import tables for macro names — module
  # path join -> the qualified keys of the macros its use declarations bring
  # into scope. Bare-name lookup consults the current module's table after
  # its own definitions; two imports naming the same local macro from
  # different modules is an ambiguity error (E107).
  macro_imports: Map[String, Vec[String]]
  # P1 (macro identity): per-module import tables for MODULE aliases —
  # module path join -> the imported module paths (from `use a::b;` /
  # braced / glob declarations, mirroring the resolver's import machinery).
  # Qualified path resolution expands a first segment that aliases an
  # imported module path.
  module_imports: Map[String, Vec[Vec[String]]]
  # Recursion stack for macro identity (prevents infinite expansion)
  expansion_stack: Vec[String]
  # P1 (macro hygiene, structural): per-program expansion context counter.
  # Every macro expansion interns one fresh syntax-context mark (see
  # intern_syntax_context); the marks stamp the identifiers the expansion
  # introduces so no two expansions and no expansion and its surrounding
  # scope can collide. The counter is monotonic across the 64-pass fixpoint
  # loop (the env outlives all passes), so the marks are unique per program.
  #
  # Context COMPOSITION: an expansion is stamped with a context STACK (the
  # per-expansion mark plus the marks of every enclosing expansion whose
  # body it is nested inside), so the identifier key carries the whole stack
  # (see identifier_key_of) — an inner expansion's generated names can never
  # collide with the outer's even when their symbols match (see the
  # expand_expr macro arms: the substituted body of an expansion is
  # re-expanded with the composed stack inherited from the outer context).
  expansion_counter: Int
  # P1 (macro hygiene, structural): the SYNTAX-CONTEXT INTERN TABLE — every
  # fresh mark records the composed context stack it represents (the parent
  # stack plus the mark itself). The marks are the interned syntax contexts
  # of the generated Identifier { symbol, syntax_context } values; the
  # resolver keys locals by identifier string, and the stamped key is the
  # (symbol, context) pair rendered in an identifier-impossible encoding
  # (see identifier_key_of: `$` is outside the lexer's identifier charset,
  # so no user-written identifier can ever equal a generated key).
  syntax_contexts: Map[Int, Vec[Int]]
  # P1 (macro identity): diagnostics recorded during expansion (macro
  # ambiguity E107, recorded at the call/definition site). expand_macros
  # drains this bag into the parser's diagnostic channel after the fixpoint
  # loop (and before the early returns), so an ambiguity fails the
  # compilation through diag_has_errors like every other parser diagnostic.
  diagnostics: Vec[Diagnostic]
end

# P1 (macro hygiene, structural): the generated identifier — the SYMBOL
# (the spelling the macro body used) plus the INTERNED SYNTAX-CONTEXT MARK
# (the fresh expansion mark that owns the identifier). Two identifiers with
# the same symbol but different contexts are DIFFERENT identifiers; a user
# identifier (no mark) can never equal a generated one because the rendered
# key carries the mark in an identifier-impossible encoding.
pub struct Identifier
  symbol: String
  syntax_context: Int
end

# P1 (macro identity): the module-scoped identity of a macro definition —
# the owner module path plus the bare name. Registered and looked up through
# the module-qualified key form (macro_id_key), the same module-qualified
# machinery the resolver uses for every other declaration.
pub struct MacroId
  module_path: Vec[String]
  name: String
end

# The module-qualified key of a MacroId: "path::name" (the root module's
# empty path degenerates to the bare name) — the exact key form the
# resolver's module-qualified symbol tables use, so macro identity follows
# the same module scoping as functions/types/traits.
pub def macro_id_key(id: &MacroId) -> String
  let joined = id.module_path.join("::")
  if joined.is_empty() then
    id.name.clone()
  else
    joined + "::" + id.name.clone()
  end
end

# The structural key of a generated identifier under a composed context
# stack: the (symbol, context) pair rendered as `symbol$c1$c2$...` — the
# innermost (fresh) mark last. `$` is NOT in the lexer's identifier charset
# (lexer.tg is_ident_char = [A-Za-z0-9_]), so the rendered key is
# IMPOSSIBLE for user code to spell: a user writing any identifier, however
# mangled, produces a different string, and a generated binding can never
# be captured by (or capture) a user binding. The resolver keys locals by
# identifier string, so a stamped binding resolves exactly against its own
# stamped references — resolution IS by (symbol, context).
pub def identifier_key_of(id: &Identifier, ctx_stack: &Vec[Int]) -> String
  var out = id.symbol.clone()
  var ci = 0
  while ci < ctx_stack.len() do
    out = out + "$" + ctx_stack[ci].to_string()
    ci = ci + 1
  end
  out
end

# The Identifier of a macro-body-own name under the composed context stack:
# the syntax_context is the FRESH mark of the expansion doing the stamping
# (the innermost level of the composed stack).
pub def hygiene_identifier(symbol: &String, ctx_stack: &Vec[Int]) -> Identifier
  var mark = 0
  if ctx_stack.len() > 0 then
    mark = ctx_stack[ctx_stack.len() - 1]
  end
  Identifier { symbol: symbol.clone(), syntax_context: mark }
end

# Intern a fresh syntax-context mark for one macro expansion: the mark is
# the monotonic per-program counter, and the intern table records the
# composed stack it represents (the inherited parent stack plus the mark).
# Returns the fresh mark. (Like the rest of the expansion machinery, the
# env is borrowed through the compiler's single `&` reference form, which
# permits the interior mutation of the counter and the intern table.)
pub def intern_syntax_context(env: &MacroEnv, parent: &Vec[Int]) -> Int
  env.expansion_counter = env.expansion_counter + 1
  var stack = parent.clone()
  stack.push(env.expansion_counter)
  env.syntax_contexts.insert(env.expansion_counter, stack)
  env.expansion_counter
end

# The module-qualified key of a macro (module path, name) — the MacroId
# key form. The root module's empty path degenerates to the bare name.
def macro_key_from(module_path: &Vec[String], name: &String) -> String
  var id = MacroId { module_path: module_path.clone(), name: name.clone() }
  macro_id_key(&id)
end

# Whether a module-qualified macro key names the given bare macro name (the
# root-module degenerate form is the bare name itself).
def macro_key_matches_name(key: &String, name: &String) -> Bool
  if key == name then
    return true
  end
  let suffix = "::" + name.clone()
  key.len() > suffix.len() && key.slice(key.len() - suffix.len(), key.len()) == suffix
end

pub struct ExpandedProgram
  program: Program
  did_expand: Bool
end

pub struct ExpandedItem
  item: Item
  did_expand: Bool
end

pub struct ExpandedFunctionDecl
  func: FunctionDecl
  did_expand: Bool
end

pub struct ExpandedTraitMethod
  method: TraitMethod
  did_expand: Bool
end

pub struct ExpandedBlock
  block: Block
  did_expand: Bool
end

pub struct ExpandedStmt
  stmt: Stmt
  did_expand: Bool
end

pub struct ExpandedExpr
  expr: Expr
  did_expand: Bool
end

pub struct ExpandedExprVec
  args: Vec[Expr]
  did_expand: Bool
end

# The module path owning the flat item at `item_idx` — a TABLE READ (P1):
# the item's OWNER ModuleId (Item.owner_module, stamped at the module-
# assembly construction sites) keys Program.crate.modules directly; the
# owner Module's path is the item's module path (the root module's empty
# path when the owner Module is missing from the table — the same root
# fallback the resolver's module_path_of_item_resolver uses). No range
# scanning: the item list of a module is per-module (Module.items), and the
# owner lookup never walks it.
def module_path_for_item(program: &Program, item_idx: Int) -> Vec[String]
  let owner = program.items[item_idx].owner_module
  match program.crate.modules.get(owner)
  when Option::Some(info) then
    var path = Vec::new()
    for seg in info.path do
      path.push(seg.clone())
    end
    path
  when Option::None then
    Vec::new()
  end
end

# Register one macro under its module-qualified identity. A same-named
# macro already registered in the SAME module is an ambiguity error (E107)
# — the per-module occupancy rule of every other declaration, instead of
# the old global last-wins shadowing.
def register_macro(env: &mut MacroEnv, module_path: &Vec[String], name: &String, decl: &MacroDecl, span: Span) -> Unit
  let key = macro_key_from(module_path, name)
  if env.macros.contains_key(&key) then
    diag_macro_ambiguity(&mut env.diagnostics, "macro '" + name.clone() + "' is defined more than once in module '" +
      module_path.join("::") + "' (macro identity is module-scoped; rename one of the definitions)", span)
  else
    env.macros.insert(key, decl.clone())
  end
end

# Register the macros of an inline module tree under the composed module
# path (parent path + the inline module's segment).
def register_module_tree_macros(env: &mut MacroEnv, module_path: &Vec[String], md: &ModuleDecl) -> Unit
  var child_path = module_path.clone()
  child_path.push(md.name.clone())
  for item in md.items do
    match item.kind
    when ItemKind::ItemMacro(m) then
      register_macro(env, &child_path, &m.name, &m, item.span)
    when ItemKind::ItemModule(nested) then
      register_module_tree_macros(env, &child_path, &nested)
    when _ then ()
    end
  end
end

# Record the macros a use declaration brings into `module_path`'s scope:
#   - braced imports (`use a::b::{m, n}`) import the named macros of the
#     target module;
#   - plain imports (`use a::b::m`) import the named macro of `a::b` (and,
#     for a module import `use a::b`, the macros of `a::b` under the last
#     segment's alias);
#   - glob imports (`use a::b::*`) import every macro of `a::b`.
# Only names that actually resolve to a REGISTERED macro are recorded, so
# ordinary name imports never pollute the macro tables.
def record_module_imports(env: &mut MacroEnv, module_path: &Vec[String], u: &UseDecl) -> Unit
  let mod_key = module_path.join("::")
  var module_imports: Vec[Vec[String]] = match env.module_imports.get(&mod_key)
  when Option::Some(list) then list.clone()
  when Option::None then Vec::new()
  end
  module_imports.push(u.path.segments.clone())
  env.module_imports.insert(mod_key, module_imports)
  match u.names
  when Option::Some(names) then
    for n in names do
      let key = macro_key_from(&u.path.segments, &n)
      if env.macros.contains_key(&key) then
        record_imported_macro_key(env, module_path, &key)
      end
    end
  when Option::None then
    if u.glob then
      let module_entries = env.macros.entries()
      for (key, _) in module_entries do
        if key.starts_with(u.path.segments.join("::") + "::") then
          record_imported_macro_key(env, module_path, &key)
        end
      end
    else
      let seg_count = u.path.segments.len()
      if seg_count > 0 then
        let last = u.path.segments[seg_count - 1].clone()
        var mod_segs = u.path.segments.clone()
        mod_segs.pop()
        var key = macro_key_from(&mod_segs, &last)
        if env.macros.contains_key(&key) then
          record_imported_macro_key(env, module_path, &key)
        end
        key = macro_key_from(&u.path.segments, &last)
        if env.macros.contains_key(&key) then
          record_imported_macro_key(env, module_path, &key)
        end
      end
    end
  end
end

def record_imported_macro_key(env: &mut MacroEnv, module_path: &Vec[String], key: &String) -> Unit
  let mod_key = module_path.join("::")
  var list: Vec[String] = match env.macro_imports.get(&mod_key)
  when Option::Some(existing) then existing.clone()
  when Option::None then Vec::new()
  end
  if !list.contains(key) then
    list.push(key.clone())
    env.macro_imports.insert(mod_key, list)
  end
end

def record_module_tree_imports(env: &mut MacroEnv, module_path: &Vec[String], md: &ModuleDecl) -> Unit
  var child_path = module_path.clone()
  child_path.push(md.name.clone())
  for item in md.items do
    match item.kind
    when ItemKind::ItemUse(u) then record_module_imports(env, &child_path, &u)
    when ItemKind::ItemModule(nested) then record_module_tree_imports(env, &child_path, &nested)
    when _ then ()
    end
  end
end

# The qualified keys of the macros the module's imports bring into scope
# under the given bare name (the current module's own definitions are
# consulted separately by lookup_macro).
def imported_macro_candidates(env: &MacroEnv, module_path: &Vec[String], name: &String) -> Vec[String]
  var out = Vec::new()
  let mod_key = module_path.join("::")
  match env.macro_imports.get(&mod_key)
  when Option::Some(keys) then
    for key in keys do
      if macro_key_matches_name(&key, name) then
        out.push(key.clone())
      end
    end
  when Option::None then ()
  end
  out
end

# Add a (module path, name) candidate to the candidate list, deduplicated
# by qualified key.
def push_macro_candidate(candidates: &mut Vec[String], env: &MacroEnv, module_path: &Vec[String], name: &String) -> Unit
  let key = macro_key_from(module_path, name)
  if env.macros.contains_key(&key) && !candidates.contains(&key) then
    candidates.push(key)
  end
end

# Resolve a macro invocation path at the CURRENT module (env.current_module)
# to its module-qualified KEY:
#   - bare paths (`m`) resolve in the current module first, then through its
#     imports (use declarations);
#   - qualified paths (`a::b::m`) resolve relative to the current module,
#     then absolutely against the root, then through import aliases (the
#     first segment aliasing an imported module path) — the resolver's
#     module-qualified machinery;
#   - MORE THAN ONE candidate is an ambiguity ERROR (E107) — the same
#     ambiguity rule other declarations obey.
# Returns Option::None when no macro matches (the call may be an ordinary
# function call). Ambiguity is recorded in env.diagnostics (the parser's
# channel), which expand_macros drains after the fixpoint loop.
pub def lookup_macro(env: &MacroEnv, segments: &Vec[String], span: &Span) -> Option[String]
  var candidates: Vec[String] = Vec::new()
  if segments.len() == 1 then
    let name = segments[0]
    push_macro_candidate(&mut candidates, env, &env.current_module, &name)
    for key in imported_macro_candidates(env, &env.current_module, &name) do
      if !candidates.contains(&key) then
        candidates.push(key)
      end
    end
  else
    let name = segments[segments.len() - 1].clone()
    var mod_segs = segments.slice(0, segments.len() - 1)
    # Relative: the module path of the call site plus the written segments.
    var rel_path = env.current_module.clone()
    for seg in mod_segs do
      rel_path.push(seg.clone())
    end
    push_macro_candidate(&mut candidates, env, &rel_path, &name)
    # Absolute: the written segments against the root.
    push_macro_candidate(&mut candidates, env, &mod_segs, &name)
    # Import aliases: the first segment aliases an imported module path
    # (`use a::b;` then `b::c::m` -> `a::b::c::m`), mirroring the resolver's
    # record_path_call_target alias expansion.
    let mod_key = env.current_module.join("::")
    match env.module_imports.get(&mod_key)
    when Option::Some(imports) then
      for imp in imports do
        if imp.len() > 0 && imp[imp.len() - 1] == segments[0] then
          var alias_path = imp.slice(0, imp.len() - 1)
          for seg in mod_segs do
            alias_path.push(seg.clone())
          end
          push_macro_candidate(&mut candidates, env, &alias_path, &name)
        end
      end
    when Option::None then ()
    end
  end
  match candidates.len()
  when 0 then Option::None
  when 1 then Option::Some(candidates[0].clone())
  when _ then
    diag_macro_ambiguity(&mut env.diagnostics, "macro '" + segments[segments.len() - 1].clone() +
      "' is ambiguous: it resolves to more than one module-qualified macro (" +
      candidates.join(", ") + ")", span.clone())
    Option::None
  end
end

# P1 (macro hygiene, expansion-depth contract): `diags` is the parser's
# diagnostic channel. The 64-pass fixpoint below is the DEPTH CAP: when it
# does not converge (an expansion chain longer than 64 levels, e.g. a macro
# whose body recursively embeds itself — one extra nesting level per pass),
# the residual ExprMacroCall nodes are reported as E105 through
# diag_macro_expansion_depth_exceeded instead of silently continuing with an
# incompletely expanded AST. The pipeline (analyze_parsed and the bootstrap
# skip-semantic-checks paths) checks diag_has_errors on the bag and returns
# the failed state before lowering.
pub def expand_macros(program: Program, diags: &mut Vec[Diagnostic]) -> Program
  # Phase 1: collect macro declarations, MODULE-SCOPED. Every macro registers
  # under the module path of its owning module (from Program.crate's module
  # table, read via the item's OWNER ModuleId — module_path_for_item is a
  # table read, no range scan; inline module trees append their segment).
  # A same-named macro in the same module is an ambiguity ERROR
  # (E107), not a last-wins shadow — the same per-module occupancy rule the
  # resolver applies to every other declaration.
  var env = MacroEnv {
    macros: Map::new(),
    current_module: Vec::new(),
    macro_imports: Map::new(),
    module_imports: Map::new(),
    expansion_stack: Vec::new(),
    expansion_counter: 0,
    syntax_contexts: Map::new(),
    diagnostics: Vec::new()
  }
  var mi = 0
  while mi < program.items.len() do
    let module_path = module_path_for_item(&program, mi)
    match program.items[mi].kind
    when ItemKind::ItemMacro(m) then
      register_macro(&mut env, &module_path, &m.name, &m, program.items[mi].span)
    when ItemKind::ItemModule(md) then
      register_module_tree_macros(&mut env, &module_path, &md)
    when _ then ()
    end
    mi = mi + 1
  end

  # Phase 1b: per-module macro import tables (the module-scoped counterpart
  # of the resolver's import machinery — `use` declarations bring macro
  # names into the importing module's scope).
  mi = 0
  while mi < program.items.len() do
    let module_path = module_path_for_item(&program, mi)
    match program.items[mi].kind
    when ItemKind::ItemUse(u) then
      record_module_imports(&mut env, &module_path, &u)
    when ItemKind::ItemModule(md) then
      record_module_tree_imports(&mut env, &module_path, &md)
    when _ then ()
    end
    mi = mi + 1
  end

  # If no macros defined, return as-is (a registration-time ambiguity error
  # implies at least one macro WAS registered, so no diagnostics can be
  # pending when this early return is taken; the single drain below covers
  # every recorded macro diagnostic).
  if env.macros.is_empty() then
    return program
  end

  # Phase 2: iteratively expand until fixpoint (max 64 passes).
  #
  # P1 (macro hygiene, expansion-depth contract): 64 is the DEPTH CAP. The
  # eager re-expansion of substituted bodies (see expand_expr's macro arms)
  # normally converges in one or two passes; a macro that transitively
  # embeds itself adds one nesting level per pass, so 64 passes bounds the
  # nesting depth. If the fixpoint has not converged when the cap is hit,
  # residual ExprMacroCall nodes remain — that is the E105 failure recorded
  # below after the macro definitions are filtered out.
  var current = program
  var pass = 0
  while pass < 64 do
    let expanded_result = expand_program_pass(&env, current)
    current = expanded_result.program
    if !expanded_result.did_expand then break end
    pass = pass + 1
  end

  # The parser's diagnostic channel receives the env-recorded lookup
  # diagnostics (call-site macro ambiguity, E107).
  for d in env.diagnostics do
    diags.push(d.clone())
  end

  # Phase 3: remove macro declarations from the output AST
  let current_span = current.span.clone()
  var filtered_items = Vec::new()
  for item in current.items do
    match item.kind
    when ItemKind::ItemMacro(_) then ()  # Drop macro defs
    when _ then filtered_items.push(item.clone())
    end
  end
  # P1 (module table): the modules map indexes the filtered items, so it is
  # rebuilt here — per module, its OWN item list (Module.items) is walked,
  # macro declarations are dropped, and every surviving ItemId is remapped
  # to its new flat index (the count of macros removed so far). The flat
  # Program stays the interface; the rebuilt table is what the resolver's
  # per-module registration tables (module_tables, keyed by path join)
  # consume, keeping the per-module first-wins foundation valid past macro
  # filtering. The filtered items keep their owner ModuleId (they are
  # cloned with it), and the module ids are carried unchanged.
  var filtered_modules = Map::new()
  var removed_global = 0
  let module_entries = current.crate.modules.entries()
  for (mid, info) in module_entries do
    var removed_in_module = 0
    var new_items = Vec::new()
    for it_id in info.items do
      match current.items[it_id.id].kind
      when ItemKind::ItemMacro(_) then removed_in_module = removed_in_module + 1
      when _ then
        new_items.push(ItemId { id: it_id.id - removed_global - removed_in_module })
      end
    end
    filtered_modules.insert(mid, Module {
      id: mid,
      path: info.path.clone(),
      items: new_items,
      imports: info.imports.clone()
    })
    removed_global = removed_global + removed_in_module
  end
  let filtered_program = Program {
    items: filtered_items,
    crate: Crate { root: current.crate.root, modules: filtered_modules },
    span: current_span
  }

  # ── P1 (macro hygiene, expansion-depth contract): E105 on non-convergence ──
  # After the 64-pass depth cap, any surviving ExprMacroCall means the
  # fixpoint did not converge (or a call refers to an undefined macro):
  # expansion never reached a fixpoint. Record E105 through the parser's
  # diagnostic channel (diag_macro_expansion_depth_exceeded) at the first
  # residual call's span; the caller's diag_has_errors check then returns the
  # failed state and the pipeline never lowers the partial AST.
  var residual_calls: Vec[Expr] = Vec::new()
  for item in filtered_program.items do
    residual_macro_calls_in_item(&item, &mut residual_calls)
  end
  if !residual_calls.is_empty() then
    diag_macro_expansion_depth_exceeded(diags, residual_calls[0].span.clone())
  end

  filtered_program
end

# ───────────────────────────────────────────────────────────────────────
# P1 (macro hygiene, expansion-depth contract): residual macro-call walker
# ───────────────────────────────────────────────────────────────────────
# Total AST walk used by expand_macros' E105 check: it must find ANY
# ExprMacroCall the fixpoint left behind — including positions the expander
# walks but also positions it clones verbatim (elsif/else branches, for
# bodies) — so a surviving call always records the depth diagnostic.
def residual_macro_calls_in_expr(expr: &Expr, out: &mut Vec[Expr]) -> Unit
  match expr.kind
  when ExprKind::ExprMacroCall(_, _) then out.push(expr.clone())
  when ExprKind::ExprCall(callee, args) then
    residual_macro_calls_in_expr(&callee, out)
    for a in args do residual_macro_calls_in_expr(&a, out) end
  when ExprKind::ExprBlock(block) then residual_macro_calls_in_block(block, out)
  when ExprKind::ExprMethodCall(receiver, _, _, args) then
    residual_macro_calls_in_expr(&receiver, out)
    for a in args do residual_macro_calls_in_expr(&a, out) end
  when ExprKind::ExprIf(if_expr) then
    residual_macro_calls_in_expr(&if_expr.cond, out)
    residual_macro_calls_in_block(&if_expr.then_block, out)
    for (_, eb) in if_expr.elsif_branches do residual_macro_calls_in_block(&eb, out) end
    match if_expr.else_block
    when Option::Some(eb) then residual_macro_calls_in_block(&eb, out)
    when Option::None then ()
    end
  when ExprKind::ExprMatch(match_expr) then
    residual_macro_calls_in_expr(&match_expr.scrutinee, out)
    for arm in match_expr.arms do
      match arm.guard_expr
      when Option::Some(g) then residual_macro_calls_in_expr(&g, out)
      when Option::None then ()
      end
      residual_macro_calls_in_block(&arm.body, out)
    end
  when ExprKind::ExprClosure(_, _, body) then residual_macro_calls_in_expr(&body, out)
  when ExprKind::ExprUnsafe(_, block) then residual_macro_calls_in_block(block, out)
  when ExprKind::ExprAsync(block) then residual_macro_calls_in_block(block, out)
  when ExprKind::ExprComptime(block) then residual_macro_calls_in_block(block, out)
  when ExprKind::ExprEnumVariant(_, args) then
    for a in args do residual_macro_calls_in_expr(&a, out) end
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    residual_macro_calls_in_expr(&lhs, out)
    residual_macro_calls_in_expr(&rhs, out)
  when ExprKind::ExprUnaryOp(_, operand) then residual_macro_calls_in_expr(&operand, out)
  when ExprKind::ExprFieldAccess(obj, _) then residual_macro_calls_in_expr(&obj, out)
  when ExprKind::ExprIndex(obj, idx) then
    residual_macro_calls_in_expr(&obj, out)
    residual_macro_calls_in_expr(&idx, out)
  when ExprKind::ExprArrayLit(elems) then
    for e in elems do residual_macro_calls_in_expr(&e, out) end
  when ExprKind::ExprTupleLit(elems) then
    for e in elems do residual_macro_calls_in_expr(&e, out) end
  when ExprKind::ExprStructLit(_, fields) then
    for (_, fv) in fields do residual_macro_calls_in_expr(&fv, out) end
  when ExprKind::ExprMapLit(entries) then
    for (k, v) in entries do
      residual_macro_calls_in_expr(&k, out)
      residual_macro_calls_in_expr(&v, out)
    end
  when ExprKind::ExprAccess(inner) then residual_macro_calls_in_expr(&inner, out)
  when ExprKind::ExprRawDeref(inner) then residual_macro_calls_in_expr(&inner, out)
  when ExprKind::ExprAwait(inner) then residual_macro_calls_in_expr(&inner, out)
  when ExprKind::ExprTry(inner) then residual_macro_calls_in_expr(&inner, out)
  when ExprKind::ExprRange(start_e, end_e, _) then
    match start_e
    when Option::Some(s) then residual_macro_calls_in_expr(&s, out)
    when Option::None then ()
    end
    match end_e
    when Option::Some(e) then residual_macro_calls_in_expr(&e, out)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, _) then residual_macro_calls_in_expr(&inner, out)
  when ExprKind::ExprTypeCheck(inner, _) then residual_macro_calls_in_expr(&inner, out)
  when ExprKind::ExprAssign(target, value) then
    residual_macro_calls_in_expr(&target, out)
    residual_macro_calls_in_expr(&value, out)
  when ExprKind::ExprPipe(lhs, rhs) then
    residual_macro_calls_in_expr(&lhs, out)
    residual_macro_calls_in_expr(&rhs, out)
  when _ then ()
  end
end

def residual_macro_calls_in_block(block: &Block, out: &mut Vec[Expr]) -> Unit
  for stmt in block.stmts do
    residual_macro_calls_in_stmt(&stmt, out)
  end
end

def residual_macro_calls_in_stmt(stmt: &Stmt, out: &mut Vec[Expr]) -> Unit
  match stmt.kind
  when StmtKind::StmtLet(_, _, init, _) then residual_macro_calls_in_expr(&init, out)
  when StmtKind::StmtAssign(target, value) then
    residual_macro_calls_in_expr(&target, out)
    residual_macro_calls_in_expr(&value, out)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    residual_macro_calls_in_expr(&target, out)
    residual_macro_calls_in_expr(&value, out)
  when StmtKind::StmtIf(if_stmt) then
    residual_macro_calls_in_expr(&if_stmt.cond, out)
    residual_macro_calls_in_block(&if_stmt.then_block, out)
    for (_, eb) in if_stmt.elsif_branches do residual_macro_calls_in_block(&eb, out) end
    match if_stmt.else_block
    when Option::Some(eb) then residual_macro_calls_in_block(&eb, out)
    when Option::None then ()
    end
  when StmtKind::StmtMatch(match_expr) then
    residual_macro_calls_in_expr(&match_expr.scrutinee, out)
    for arm in match_expr.arms do
      match arm.guard_expr
      when Option::Some(g) then residual_macro_calls_in_expr(&g, out)
      when Option::None then ()
      end
      residual_macro_calls_in_block(&arm.body, out)
    end
  when StmtKind::StmtWhile(cond, body) then
    residual_macro_calls_in_expr(&cond, out)
    residual_macro_calls_in_block(&body, out)
  when StmtKind::StmtFor(f) then
    residual_macro_calls_in_expr(&f.iter, out)
    residual_macro_calls_in_block(&f.body, out)
  when StmtKind::StmtLoop(body) then residual_macro_calls_in_block(&body, out)
  when StmtKind::StmtReturn(oe) then
    match oe
    when Option::Some(e) then residual_macro_calls_in_expr(&e, out)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(oe) then
    match oe
    when Option::Some(e) then residual_macro_calls_in_expr(&e, out)
    when Option::None then ()
    end
  when StmtKind::StmtExpr(e) then residual_macro_calls_in_expr(&e, out)
  when StmtKind::StmtUnsafe(_, body) then residual_macro_calls_in_block(&body, out)
  when StmtKind::StmtDefer(body) then residual_macro_calls_in_block(&body, out)
  when StmtKind::StmtGuard(cond, ge) then
    residual_macro_calls_in_expr(&cond, out)
    match ge
    when GuardElse::Return(oe) then
      match oe
      when Option::Some(e) then residual_macro_calls_in_expr(&e, out)
      when Option::None then ()
      end
    when GuardElse::Panic(_) then ()
    when GuardElse::Break(oe) then
      match oe
      when Option::Some(e) then residual_macro_calls_in_expr(&e, out)
      when Option::None then ()
      end
    when GuardElse::Continue then ()
    end
  when StmtKind::StmtTry(body, catches, fin) then
    residual_macro_calls_in_block(&body, out)
    for c in catches do residual_macro_calls_in_block(&c.body, out) end
    match fin
    when Option::Some(fb) then residual_macro_calls_in_block(&fb, out)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, _, body) then
    residual_macro_calls_in_expr(&expr, out)
    residual_macro_calls_in_block(&body, out)
  when StmtKind::StmtHandleWith(expr, handlers) then
    residual_macro_calls_in_expr(&expr, out)
    for h in handlers do
      for arm in h.arms do residual_macro_calls_in_block(&arm.body, out) end
    end
  when _ then ()
  end
end

def residual_macro_calls_in_fn_body(body: &FnBody, out: &mut Vec[Expr]) -> Unit
  match body
  when FnBody::FnBlock(block) then residual_macro_calls_in_block(&block, out)
  when FnBody::FnExpr(e) then residual_macro_calls_in_expr(&e, out)
  when _ then ()
  end
end

def residual_macro_calls_in_function(f: &FunctionDecl, out: &mut Vec[Expr]) -> Unit
  residual_macro_calls_in_fn_body(&f.body, out)
  for c in f.contracts do
    residual_macro_calls_in_expr(&c.expr, out)
  end
end

def residual_macro_calls_in_item(item: &Item, out: &mut Vec[Expr]) -> Unit
  match item.kind
  when ItemKind::ItemFunction(f) then residual_macro_calls_in_function(&f, out)
  when ItemKind::ItemStruct(s) then
    for m in s.methods do residual_macro_calls_in_function(&m, out) end
    for fd in s.fields do
      match fd.default
      when Option::Some(e) then residual_macro_calls_in_expr(&e, out)
      when Option::None then ()
      end
    end
  when ItemKind::ItemTrait(t) then
    for m in t.methods do residual_macro_calls_in_fn_body(&m.default_body, out) end
  when ItemKind::ItemImpl(imp) then
    for m in imp.methods do residual_macro_calls_in_function(&m, out) end
  when ItemKind::ItemModule(m) then
    for sub in m.items do residual_macro_calls_in_item(&sub, out) end
  when ItemKind::ItemConst(c) then residual_macro_calls_in_expr(&c.value, out)
  when ItemKind::ItemStatic(s) then residual_macro_calls_in_expr(&s.value, out)
  when ItemKind::ItemMacro(m) then residual_macro_calls_in_block(&m.body, out)
  when _ then ()
  end
end

pub def expand_program_pass(env: &MacroEnv, program: Program) -> ExpandedProgram
  let program_span = program.span.clone()
  var new_items = Vec::new()
  var did_expand = false
  var i = 0
  while i < program.items.len() do
    # P1 (macro identity): anchor the resolution of this item's macro calls
    # in its OWNING module (the item's owner ModuleId read through the crate
    # table — module_path_for_item; no range scan). A bare macro
    # name resolves in this module; a qualified path resolves relative to it
    # (then absolutely, then through import aliases).
    env.current_module = module_path_for_item(&program, i)
    let expanded_item = expand_item(env, program.items[i].clone())
    new_items.push(expanded_item.item.clone())
    if expanded_item.did_expand then did_expand = true end
    i = i + 1
  end
  # P0-AM: items map 1:1 through expansion (no insertion/deletion), so the
  # Crate is carried through unchanged and still indexes the new flat items
  # vector.
  ExpandedProgram { program: Program { items: new_items, crate: program.crate.clone(), span: program_span }, did_expand }
end

pub def expand_item(env: &MacroEnv, item: Item) -> ExpandedItem
  match item.kind
  when ItemKind::ItemFunction(f) then
    let expanded_f = expand_function_decl(env, &f)
    ExpandedItem {
      item: Item { kind: ItemKind::ItemFunction(expanded_f.func), attrs: item.attrs.clone(), span: item.span, is_pub: item.is_pub },
      did_expand: expanded_f.did_expand
    }
  when ItemKind::ItemImpl(impl_block) then
    let impl_vis = impl_block.vis
    let impl_self_type = impl_block.self_type.clone()
    let impl_trait_name = impl_block.trait_name.clone()
    let impl_for_type = impl_block.for_type.clone()
    let impl_generic_params = impl_block.generic_params.clone()
    let impl_where_clause = impl_block.where_clause.clone()
    let impl_assoc_types = impl_block.assoc_types.clone()
    let impl_span = impl_block.span
    var new_methods = Vec::new()
    var did_expand = false
    for method in impl_block.methods do
      let expanded_method = expand_function_decl(env, &method)
      new_methods.push(expanded_method.func.clone())
      if expanded_method.did_expand then did_expand = true end
    end
    let new_impl = ImplDecl {
      vis: impl_vis,
      self_type: impl_self_type,
      trait_name: impl_trait_name,
      for_type: impl_for_type,
      generic_params: impl_generic_params,
      where_clause: impl_where_clause,
      methods: new_methods,
      assoc_types: impl_assoc_types,
      span: impl_span
    }
    ExpandedItem {
      item: Item { kind: ItemKind::ItemImpl(new_impl), attrs: item.attrs.clone(), span: item.span, is_pub: item.is_pub },
      did_expand
    }
  when ItemKind::ItemTrait(trait_decl) then
    let trait_vis = trait_decl.vis
    let trait_name = trait_decl.name.clone()
    let trait_generic_params = trait_decl.generic_params.clone()
    let trait_super_traits = trait_decl.super_traits.clone()
    let trait_assoc_types = trait_decl.assoc_types.clone()
    let trait_span = trait_decl.span
    var new_methods = Vec::new()
    var did_expand = false
    for ti in trait_decl.methods do
      let expanded = expand_trait_method(env, ti)
      new_methods.push(expanded.method.clone())
      if expanded.did_expand then did_expand = true end
    end
    let new_trait = TraitDecl {
      vis: trait_vis,
      name: trait_name,
      generic_params: trait_generic_params,
      super_traits: trait_super_traits,
      methods: new_methods,
      assoc_types: trait_assoc_types,
      span: trait_span
    }
    ExpandedItem {
      item: Item { kind: ItemKind::ItemTrait(new_trait), attrs: item.attrs.clone(), span: item.span, is_pub: item.is_pub },
      did_expand
    }
  when _ then ExpandedItem { item, did_expand: false }
  end
end

pub def expand_function_decl(env: &MacroEnv, f: &FunctionDecl) -> ExpandedFunctionDecl
  let f_vis = f.vis
  let f_name = f.name.clone()
  let f_generic_params = f.generic_params.clone()
  let f_params = f.params.clone()
  let f_ret_type = f.ret_type.clone()
  let f_where_clause = f.where_clause.clone()
  let f_is_async = f.is_async
  let f_is_unsafe = f.is_unsafe
  let f_is_const = f.is_const
  let f_is_inline = f.is_inline
  let f_is_pure = f.is_pure
  let f_contracts = f.contracts.clone()
  let f_budget_val = f.budget_val.clone()
  let f_required_caps = f.required_caps.clone()
  let f_effects = f.effects.clone()
  let f_span = f.span
  match f.body
  when FnBody::FnBlock(block) then
    # P1 (macro hygiene, context composition): the root of the expansion walk
    # starts with an EMPTY hygiene context stack — composition only applies
    # to expansions nested inside a substituted macro body (see expand_expr).
    var root_ctx: Vec[Int] = Vec::new()
    let expanded_block = expand_block(env, &block, &root_ctx)
    ExpandedFunctionDecl {
      func: FunctionDecl {
        vis: f_vis,
        name: f_name,
        generic_params: f_generic_params,
        params: f_params,
        ret_type: f_ret_type,
        where_clause: f_where_clause,
        body: FnBody::FnBlock(expanded_block.block),
        is_async: f_is_async,
        is_unsafe: f_is_unsafe,
        is_const: f_is_const,
        is_inline: f_is_inline,
        is_pure: f_is_pure,
        contracts: f_contracts,
        budget_val: f_budget_val,
        required_caps: f_required_caps,
        effects: f_effects,
        span: f_span
      },
      did_expand: expanded_block.did_expand
    }
  when _ then
    ExpandedFunctionDecl {
      func: FunctionDecl {
        vis: f_vis,
        name: f_name,
        generic_params: f_generic_params,
        params: f_params,
        ret_type: f_ret_type,
        where_clause: f_where_clause,
        body: f.body.clone(),
        is_async: f_is_async,
        is_unsafe: f_is_unsafe,
        is_const: f_is_const,
        is_inline: f_is_inline,
        is_pure: f_is_pure,
        contracts: f_contracts,
        budget_val: f_budget_val,
        required_caps: f_required_caps,
        effects: f_effects,
        span: f_span
      },
      did_expand: false
    }
  end
end

pub def expand_trait_method(env: &MacroEnv, method: TraitMethod) -> ExpandedTraitMethod
  ExpandedTraitMethod { method, did_expand: false }
end

# ctx_stack: the P1 hygiene context stack of the expansions whose body this
# walk is inside (empty at the root of a pass; composed at nested macro
# expansions — see expand_expr's macro arms).
pub def expand_block(env: &MacroEnv, block: &Block, ctx_stack: &Vec[Int]) -> ExpandedBlock
  let block_span = block.span
  var new_stmts = Vec::new()
  var did_expand = false
  var i = 0
  while i < block.stmts.len() do
    let expanded_stmt = expand_stmt(env, &block.stmts[i], ctx_stack)
    new_stmts.push(expanded_stmt.stmt.clone())
    if expanded_stmt.did_expand then did_expand = true end
    i = i + 1
  end
  ExpandedBlock { block: Block { stmts: new_stmts, span: block_span }, did_expand }
end

pub def expand_stmt(env: &MacroEnv, stmt: &Stmt, ctx_stack: &Vec[Int]) -> ExpandedStmt
  match stmt.kind
  when StmtKind::StmtExpr(expr) then
    let expanded_expr = expand_expr(env, &expr, ctx_stack)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtExpr(expanded_expr.expr), span: stmt.span, node_id: 0 },
      did_expand: expanded_expr.did_expand
    }
  when StmtKind::StmtLet(pat, ty, init, is_mut) then
    let expanded_expr = expand_expr(env, &init, ctx_stack)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtLet(pat.clone(), ty.clone(), expanded_expr.expr, is_mut), span: stmt.span, node_id: 0 },
      did_expand: expanded_expr.did_expand
    }
  when StmtKind::StmtAssign(target, value) then
    let et = expand_expr(env, &target, ctx_stack)
    let ev = expand_expr(env, &value, ctx_stack)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtAssign(et.expr, ev.expr), span: stmt.span, node_id: 0 },
      did_expand: et.did_expand || ev.did_expand
    }
  when StmtKind::StmtCompoundAssign(op, target, value) then
    let et = expand_expr(env, &target, ctx_stack)
    let ev = expand_expr(env, &value, ctx_stack)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtCompoundAssign(op, et.expr, ev.expr), span: stmt.span, node_id: 0 },
      did_expand: et.did_expand || ev.did_expand
    }
  when StmtKind::StmtIf(if_stmt) then
    let ec = expand_expr(env, &if_stmt.cond, ctx_stack)
    let eb = expand_block(env, &if_stmt.then_block, ctx_stack)
    let did = ec.did_expand || eb.did_expand
    let new_if = IfStmt {
      cond: ec.expr,
      then_block: eb.block,
      elsif_branches: if_stmt.elsif_branches.clone(),
      else_block: if_stmt.else_block.clone(),
      span: if_stmt.span
    }
    ExpandedStmt { stmt: Stmt { kind: StmtKind::StmtIf(new_if), span: stmt.span, node_id: 0 }, did_expand: did }
  when StmtKind::StmtWhile(cond, body) then
    let ec = expand_expr(env, &cond, ctx_stack)
    let eb = expand_block(env, &body, ctx_stack)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtWhile(ec.expr, eb.block), span: stmt.span, node_id: 0 },
      did_expand: ec.did_expand || eb.did_expand
    }
  when StmtKind::StmtFor(_) then
    ExpandedStmt { stmt: stmt.clone(), did_expand: false }
  when StmtKind::StmtLoop(body) then
    let eb = expand_block(env, &body, ctx_stack)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtLoop(eb.block), span: stmt.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when StmtKind::StmtReturn(opt_expr) then
    match opt_expr
    when Option::Some(expr) then
      let ee = expand_expr(env, &expr, ctx_stack)
      ExpandedStmt {
        stmt: Stmt { kind: StmtKind::StmtReturn(Option::Some(ee.expr)), span: stmt.span, node_id: 0 },
        did_expand: ee.did_expand
      }
    when Option::None then ExpandedStmt { stmt: stmt.clone(), did_expand: false }
    end
  when StmtKind::StmtUnsafe(reason, body) then
    let eb = expand_block(env, &body, ctx_stack)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtUnsafe(reason.clone(), eb.block), span: stmt.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when StmtKind::StmtDefer(body) then
    let eb = expand_block(env, &body, ctx_stack)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtDefer(eb.block), span: stmt.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when _ then ExpandedStmt { stmt: stmt.clone(), did_expand: false }
  end
end

pub def expand_exprs(env: &MacroEnv, args: &Vec[Expr], ctx_stack: &Vec[Int]) -> ExpandedExprVec
  var new_args = Vec::new()
  var did_expand = false
  var i = 0
  while i < args.len() do
    let expanded_arg = expand_expr(env, &args[i], ctx_stack)
    new_args.push(expanded_arg.expr.clone())
    if expanded_arg.did_expand then did_expand = true end
    i = i + 1
  end
  ExpandedExprVec { args: new_args, did_expand }
end

pub def is_vec_like_from_path(path: &AstPath) -> Bool
  if path.segments.len() < 2 then
    return false
  end
  let method = path.segments[path.segments.len() - 1]
  let owner = path.segments[path.segments.len() - 2]
  method == "from" && (owner == "Vec" || owner == "Array")
end

pub def expand_vec_like_from_array(path: &AstPath, elems: &Vec[Expr], span: &Span) -> Expr
  var new_segments = Vec::new()
  for segment in path.segments do
    new_segments.push(segment.clone())
  end
  new_segments[new_segments.len() - 1] = "new".to_string()

  let temp_name = "__tg_vec_from_" + span.start.to_string() + "_" + span.end_pos.to_string()
  let new_path = make_path(new_segments, span.clone())
  let new_callee = make_expr(ExprKind::ExprPath(new_path), span.clone())
  let new_call = make_expr(ExprKind::ExprCall(Box::new(new_callee), Vec::new()), span.clone())
  let temp_pat = make_pattern(PatternKind::Ident(temp_name.clone(), true), span.clone())

  var stmts = Vec::new()
  stmts.push(make_stmt(StmtKind::StmtLet(temp_pat, Option::None, new_call, true), span.clone()))

  for elem in elems do
    let receiver = make_expr(ExprKind::ExprIdent(temp_name.clone()), span.clone())
    var push_args = Vec::new()
    push_args.push(elem.clone())
    let push_call = make_expr(
      ExprKind::ExprMethodCall(Box::new(receiver), "push".to_string(), Vec::new(), push_args),
      span.clone()
    )
    stmts.push(make_stmt(StmtKind::StmtExpr(push_call), span.clone()))
  end

  let result_expr = make_expr(ExprKind::ExprIdent(temp_name), span.clone())
  stmts.push(make_stmt(StmtKind::StmtExpr(result_expr), span.clone()))
  make_expr(ExprKind::ExprBlock(make_block(stmts, span.clone())), span.clone())
end

# ctx_stack: the P1 hygiene context stack inherited from the expansions whose
# body this walk is inside (empty at the root of a pass). The macro arms
# COMPOSE it: each instantiation interns a fresh syntax-context mark (see
# intern_syntax_context) appended to the inherited stack, and the substituted
# body is then re-expanded under the composed stack, so nested macro calls
# inside that body inherit the outer expansion's context and their generated
# identifiers carry BOTH contexts (their keys render the whole composed
# stack — see identifier_key_of).
pub def expand_expr(env: &MacroEnv, expr: &Expr, ctx_stack: &Vec[Int]) -> ExpandedExpr
  match expr.kind
  when ExprKind::ExprCall(callee, args) then
    ## Check if callee is a path that matches a macro name
    match callee.kind
    when ExprKind::ExprPath(path) then
      let ea = expand_exprs(env, &args, ctx_stack)
      if is_vec_like_from_path(&path) && ea.args.len() == 1 then
        match ea.args[0].kind
        when ExprKind::ExprArrayLit(elems) then
          return ExpandedExpr {
            expr: expand_vec_like_from_array(&path, &elems, &expr.span),
            did_expand: true
          }
        when _ then ()
        end
      end
      # P1 (macro identity): macro lookup is module-qualified — the path's
      # segments resolve against the call site's module (bare names in the
      # current module and its imports; qualified paths relatively,
      # absolutely, and through import aliases); ambiguity is an error.
      match lookup_macro(env, &path.segments, &expr.span)
      when Option::Some(qualified_key) then
        match env.macros.get(&qualified_key)
        when Option::Some(macro_decl) then
          if env.expansion_stack.contains(&qualified_key) then
            ExpandedExpr {
              expr: Expr { kind: ExprKind::ExprError("recursive macro invocation: '" + macro_decl.name.clone() + "'"), span: expr.span, node_id: 0 },
              did_expand: false
            }
          else
            env.expansion_stack.push(qualified_key.clone())
            # P1 (macro hygiene, context composition): each expansion interns
            # one unique syntax-context mark (intern_syntax_context records it
            # in the intern table), which is APPENDED to the inherited stack —
            # the substituted body's nested macro calls then run with the
            # composed context. The substituted body is re-expanded IMMEDIATELY
            # under the composed stack (the nested ExprMacroCall inside it is
            # expanded here, not on a later pass), so the inner expansion's
            # generated identifiers carry both the outer and the inner
            # contexts and can never collide with the outer-marked names even
            # when their symbols match.
            let fresh_mark = intern_syntax_context(env, ctx_stack)
            var composed_ctx = ctx_stack.clone()
            composed_ctx.push(fresh_mark)
            let expanded = instantiate_macro(macro_decl, &args, &expr.span, &composed_ctx)
            let re_expanded = expand_expr(env, &expanded, &composed_ctx)
            env.expansion_stack.pop()
            ExpandedExpr { expr: re_expanded.expr, did_expand: true }
          end
        when Option::None then
          ## Not a macro  expand arguments recursively
          let ec = expand_expr(env, &callee, ctx_stack)
          ExpandedExpr {
            expr: Expr { kind: ExprKind::ExprCall(Box::new(ec.expr), ea.args), span: expr.span, node_id: 0 },
            did_expand: ec.did_expand || ea.did_expand
          }
        end
      when Option::None then
        ## Not a macro  expand arguments recursively
        let ec = expand_expr(env, &callee, ctx_stack)
        ExpandedExpr {
          expr: Expr { kind: ExprKind::ExprCall(Box::new(ec.expr), ea.args), span: expr.span, node_id: 0 },
          did_expand: ec.did_expand || ea.did_expand
        }
      end
    when _ then
      let ea = expand_exprs(env, &args, ctx_stack)
      let ec = expand_expr(env, &callee, ctx_stack)
      ExpandedExpr {
        expr: Expr { kind: ExprKind::ExprCall(Box::new(ec.expr), ea.args), span: expr.span, node_id: 0 },
        did_expand: ec.did_expand || ea.did_expand
      }
    end
  when ExprKind::ExprMacroCall(name, args) then
    # P1 (macro identity): the bare name resolves in the call site's module
    # (current module first, then its imports); ambiguity is an error.
    var bare_segments = Vec::new()
    bare_segments.push(name.clone())
    match lookup_macro(env, &bare_segments, &expr.span)
    when Option::Some(qualified_key) then
      match env.macros.get(&qualified_key)
      when Option::Some(macro_decl) then
        if env.expansion_stack.contains(&qualified_key) then
          ExpandedExpr {
            expr: Expr { kind: ExprKind::ExprError("recursive macro invocation: '" + name.clone() + "'"), span: expr.span, node_id: 0 },
            did_expand: false
          }
        else
          env.expansion_stack.push(qualified_key.clone())
          # P1 (macro hygiene, context composition): see the ExprCall arm —
          # the fresh context mark is interned and appended to the inherited
          # context stack and the substituted body is re-expanded under the
          # composed context so a nested macro call inside the body inherits
          # the outer context.
          let fresh_mark = intern_syntax_context(env, ctx_stack)
          var composed_ctx = ctx_stack.clone()
          composed_ctx.push(fresh_mark)
          let expanded = instantiate_macro(macro_decl, &args, &expr.span, &composed_ctx)
          let re_expanded = expand_expr(env, &expanded, &composed_ctx)
          env.expansion_stack.pop()
          ExpandedExpr { expr: re_expanded.expr, did_expand: true }
        end
      when Option::None then
        let ea = expand_exprs(env, &args, ctx_stack)
        ExpandedExpr {
          expr: Expr { kind: ExprKind::ExprMacroCall(name.clone(), ea.args), span: expr.span, node_id: 0 },
          did_expand: ea.did_expand
        }
      end
    when Option::None then
      let ea = expand_exprs(env, &args, ctx_stack)
      ExpandedExpr {
        expr: Expr { kind: ExprKind::ExprMacroCall(name.clone(), ea.args), span: expr.span, node_id: 0 },
        did_expand: ea.did_expand
      }
    end
  when ExprKind::ExprBlock(block) then
    let expanded_block = expand_block(env, &block, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprBlock(expanded_block.block), span: expr.span, node_id: 0 },
      did_expand: expanded_block.did_expand
    }
  when ExprKind::ExprIf(if_expr) then
    let expanded_cond = expand_expr(env, &if_expr.cond, ctx_stack)
    let expanded_then = expand_block(env, &if_expr.then_block, ctx_stack)
    let expanded = expanded_cond.did_expand || expanded_then.did_expand
    let new_if = IfStmt {
      cond: expanded_cond.expr,
      then_block: expanded_then.block,
      elsif_branches: if_expr.elsif_branches.clone(),
      else_block: if_expr.else_block.clone(),
      span: if_expr.span
    }
    ExpandedExpr { expr: Expr { kind: ExprKind::ExprIf(new_if), span: expr.span, node_id: 0 }, did_expand: expanded }
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    let el = expand_expr(env, &lhs, ctx_stack)
    let er = expand_expr(env, &rhs, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprBinaryOp(op, Box::new(el.expr), Box::new(er.expr)), span: expr.span, node_id: 0 },
      did_expand: el.did_expand || er.did_expand
    }
  when ExprKind::ExprUnaryOp(op, operand) then
    let eo = expand_expr(env, &operand, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprUnaryOp(op, Box::new(eo.expr)), span: expr.span, node_id: 0 },
      did_expand: eo.did_expand
    }
  when ExprKind::ExprMethodCall(receiver, method, targs, args) then
    let er = expand_expr(env, &receiver, ctx_stack)
    let ea = expand_exprs(env, &args, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprMethodCall(Box::new(er.expr), method.clone(), targs.clone(), ea.args), span: expr.span, node_id: 0 },
      did_expand: er.did_expand || ea.did_expand
    }
  when ExprKind::ExprFieldAccess(obj, field) then
    let eo = expand_expr(env, &obj, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprFieldAccess(Box::new(eo.expr), field.clone()), span: expr.span, node_id: 0 },
      did_expand: eo.did_expand
    }
  when ExprKind::ExprIndex(obj, idx) then
    let eo = expand_expr(env, &obj, ctx_stack)
    let ei = expand_expr(env, &idx, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprIndex(Box::new(eo.expr), Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: eo.did_expand || ei.did_expand
    }
  when ExprKind::ExprArrayLit(elems) then
    let ea = expand_exprs(env, &elems, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprArrayLit(ea.args), span: expr.span, node_id: 0 },
      did_expand: ea.did_expand
    }
  when ExprKind::ExprTupleLit(elems) then
    let ea = expand_exprs(env, &elems, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprTupleLit(ea.args), span: expr.span, node_id: 0 },
      did_expand: ea.did_expand
    }
  when ExprKind::ExprStructLit(path, fields) then
    var new_fields = Vec::new()
    var did_expand = false
    for (field_name, field_value) in fields do
      let expanded_field = expand_expr(env, &field_value, ctx_stack)
      new_fields.push((field_name.clone(), expanded_field.expr))
      if expanded_field.did_expand then did_expand = true end
    end
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprStructLit(path.clone(), new_fields), span: expr.span, node_id: 0 },
      did_expand
    }
  when ExprKind::ExprMapLit(entries) then
    var new_entries = Vec::new()
    var did_expand = false
    for (key_expr, value_expr) in entries do
      let ek = expand_expr(env, &key_expr, ctx_stack)
      let ev = expand_expr(env, &value_expr, ctx_stack)
      new_entries.push((ek.expr, ev.expr))
      if ek.did_expand || ev.did_expand then did_expand = true end
    end
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprMapLit(new_entries), span: expr.span, node_id: 0 },
      did_expand
    }
  when ExprKind::ExprAccess(inner) then
    let ei = expand_expr(env, &inner, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAccess(Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprRawDeref(inner) then
    let ei = expand_expr(env, &inner, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprRawDeref(Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprClosure(params, ret_ty, body) then
    let eb = expand_expr(env, &body, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprClosure(params.clone(), ret_ty.clone(), Box::new(eb.expr)), span: expr.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprMatch(match_expr) then
    let es = expand_expr(env, &match_expr.scrutinee, ctx_stack)
    var new_arms = Vec::new()
    var did_expand = es.did_expand
    for arm in match_expr.arms do
      let new_guard = match arm.guard_expr
      when Option::Some(guard_expr) then
        let eg = expand_expr(env, &guard_expr, ctx_stack)
        if eg.did_expand then did_expand = true end
        Option::Some(eg.expr)
      when Option::None then
        Option::None
      end
      let eb = expand_block(env, &arm.body, ctx_stack)
      if eb.did_expand then did_expand = true end
      new_arms.push(MatchArm {
        pattern: arm.pattern.clone(),
        guard_expr: new_guard,
        body: eb.block,
        span: arm.span
      })
    end
    ExpandedExpr {
      expr: Expr { node_id: 0, kind: ExprKind::ExprMatch(MatchExpr {
        scrutinee: es.expr,
        arms: new_arms,
        span: match_expr.span
      }), span: expr.span },
      did_expand
    }
  when ExprKind::ExprUnsafe(reason, block) then
    let eb = expand_block(env, &block, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprUnsafe(reason.clone(), eb.block), span: expr.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprAwait(inner) then
    let ei = expand_expr(env, &inner, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAwait(Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprTry(inner) then
    let ei = expand_expr(env, &inner, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprTry(Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprRange(start_expr, end_expr, inclusive) then
    let new_start = match start_expr
    when Option::Some(start) then
      let es = expand_expr(env, &start, ctx_stack)
      Option::Some(Box::new(es.expr))
    when Option::None then
      Option::None
    end
    let new_end = match end_expr
    when Option::Some(end_expr_inner) then
      let ee = expand_expr(env, &end_expr_inner, ctx_stack)
      Option::Some(Box::new(ee.expr))
    when Option::None then
      Option::None
    end
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprRange(new_start, new_end, inclusive), span: expr.span, node_id: 0 },
      did_expand: false
    }
  when ExprKind::ExprAssign(target, value) then
    let et = expand_expr(env, &target, ctx_stack)
    let ev = expand_expr(env, &value, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAssign(Box::new(et.expr), Box::new(ev.expr)), span: expr.span, node_id: 0 },
      did_expand: et.did_expand || ev.did_expand
    }
  when ExprKind::ExprPipe(lhs, rhs) then
    let el = expand_expr(env, &lhs, ctx_stack)
    let er = expand_expr(env, &rhs, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprPipe(Box::new(el.expr), Box::new(er.expr)), span: expr.span, node_id: 0 },
      did_expand: el.did_expand || er.did_expand
    }
  when ExprKind::ExprCast(inner, ty) then
    let ei = expand_expr(env, &inner, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprCast(Box::new(ei.expr), ty.clone()), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprTypeCheck(inner, ty) then
    let ei = expand_expr(env, &inner, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprTypeCheck(Box::new(ei.expr), ty.clone()), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprAsync(block) then
    let eb = expand_block(env, &block, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAsync(eb.block), span: expr.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprComptime(block) then
    let eb = expand_block(env, &block, ctx_stack)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprComptime(eb.block), span: expr.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprEnumVariant(path, args) then
    # P1 (macro identity): module-qualified calls ("a::m!(x)" — the parser
    # produces ExprEnumVariant for qualified call paths) may name a macro in
    # another module. Resolve the path module-qualified first; when it names
    # a macro, expand it; otherwise keep the variant construction (with the
    # arguments expanded).
    match lookup_macro(env, &path.segments, &expr.span)
    when Option::Some(qualified_key) then
      match env.macros.get(&qualified_key)
      when Option::Some(macro_decl) then
        if env.expansion_stack.contains(&qualified_key) then
          ExpandedExpr {
            expr: Expr { kind: ExprKind::ExprError("recursive macro invocation: '" + macro_decl.name.clone() + "'"), span: expr.span, node_id: 0 },
            did_expand: false
          }
        else
          env.expansion_stack.push(qualified_key.clone())
          let fresh_mark = intern_syntax_context(env, ctx_stack)
          var composed_ctx = ctx_stack.clone()
          composed_ctx.push(fresh_mark)
          let expanded = instantiate_macro(macro_decl, &args, &expr.span, &composed_ctx)
          let re_expanded = expand_expr(env, &expanded, &composed_ctx)
          env.expansion_stack.pop()
          ExpandedExpr { expr: re_expanded.expr, did_expand: true }
        end
      when Option::None then
        let ea = expand_exprs(env, &args, ctx_stack)
        ExpandedExpr {
          expr: Expr { kind: ExprKind::ExprEnumVariant(path.clone(), ea.args), span: expr.span, node_id: 0 },
          did_expand: ea.did_expand
        }
      end
    when Option::None then
      let ea = expand_exprs(env, &args, ctx_stack)
      ExpandedExpr {
        expr: Expr { kind: ExprKind::ExprEnumVariant(path.clone(), ea.args), span: expr.span, node_id: 0 },
        did_expand: ea.did_expand
      }
    end
  when _ then ExpandedExpr { expr: expr.clone(), did_expand: false }
  end
end

# hygiene_ctx is the composed P1 context STACK for this expansion: the
# per-expansion syntax-context mark appended to the stack of every enclosing
# expansion whose body this call is nested inside (see expand_expr's macro
# arms — intern_syntax_context). The stamping below uses the whole stack, so
# nested expansions compose.
pub def instantiate_macro(macro_decl: &MacroDecl, args: &Vec[Expr], call_span: &Span, hygiene_ctx: &Vec[Int]) -> Expr
  # Validate argument count matches parameter count
  if args.len() != macro_decl.params.len() then
    # Return an error expression - type checker will catch this
    return Expr { node_id: 0, kind: ExprKind::ExprError("macro '" + macro_decl.name.clone() + "' expects " +
      macro_decl.params.len().to_string() + " arguments, got " + args.len().to_string()),
      span: call_span.clone() }
  end

  # ── P1 macro hygiene (structural, context-based stamping) ──────────────
  # Every expansion is assigned a unique SYNTAX-CONTEXT MARK (interned by
  # intern_syntax_context before this call — the mark is the innermost level
  # of the INHERITED context stack hygiene_ctx, whose outer levels are the
  # marks of the enclosing expansions whose body this call sits inside;
  # empty for top-level calls). The substitution walk below then
  # distinguishes the two kinds of names the expansion contains:
  #
  #   1. USER-VISIBLE tokens — the macro parameters are replaced by the
  #      argument expressions the user wrote, which are cloned as-is and
  #      NEVER re-stamped: the user's names stay exactly as spelled.
  #   2. MACRO-BODY-OWN identifiers — names introduced BY THE MACRO
  #      DEFINITION (its let-bound temporaries) become generated
  #      Identifier { symbol, syntax_context } values (hygiene_identifier):
  #      binding AND every use of that binding inside the body are stamped
  #      with the composed context stack, and the identifier KEY rendered
  #      from (symbol, context) is what the AST carries (identifier_key_of
  #      — `symbol$c1$c2$...`, the innermost expansion's mark last). The
  #      resolver keys locals by identifier string, so a stamped binding is
  #      a distinct local: it can neither capture a surrounding `tmp` (its
  #      key no longer matches) nor be captured by one (surrounding
  #      references to `tmp` no longer see it). CONTEXT COMPOSITION: when
  #      this expansion is nested inside another macro's body, the outer
  #      mark is part of the stack, so this expansion's generated
  #      identifiers carry BOTH contexts and can never collide with the
  #      outer-marked names even when their symbols match. Free identifiers
  #      in expression positions are left untouched: they legitimately
  #      resolve to names outside the macro.
  #
  # Marker scheme (STRUCTURAL, not spelling-based): the key is rendered with
  # `$` as the separator — `$` is NOT in the lexer's identifier charset
  # (lexer.tg is_ident_char = [A-Za-z0-9_]), so the rendered key is an
  # identifier NO user-written source text can produce. Hygiene therefore
  # does not depend on a reserved prefix a user must avoid: a user writing
  # any spelling, including the old reserved-prefix mangle form, cannot
  # capture a generated binding, because their identifier lexes to a
  # different string (the `$` mark can never be part of it). The intern
  # table (MacroEnv.syntax_contexts) records each mark's composed stack.
  # Shadowing rule: names re-bound by constructs the stamp does NOT rename
  # (closure params, match patterns) shadow the stamp at their references,
  # so those references stay untouched and keep resolving to the shadow.
  #
  # Residual (documented, out of scope): the stamp covers exactly the region
  # the substitution walk enters (StmtExpr/StmtLet statements; ExprBlock,
  # ExprIf-cond/then, ExprMatch-arm-body, ExprClosure bodies). Constructs the
  # walk clones verbatim (while/for/async/comptime statements, if-elsif/else
  # branches) are outside the stamp — matching their pre-existing
  # substitution behavior.
  # ───────────────────────────────────────────────────────────────────────

  # Build substitution map: param_name  argument expression
  var subst_map: Map[String, Expr] = Map::new()
  var i = 0
  while i < macro_decl.params.len() do
    subst_map.insert(macro_decl.params[i].name.clone(), args[i].clone())
    i = i + 1
  end

  # Clone the macro body, substitute the argument tokens, and stamp the
  # macro-body-own bindings with this expansion's syntax context.
  var empty_frames: Vec[Map[String, Bool]] = Vec::new()
  let substituted_block = substitute_block(&subst_map, hygiene_ctx, &empty_frames, &macro_decl.body)

  # Wrap the block as a block expression
  Expr { kind: ExprKind::ExprBlock(substituted_block), span: call_span.clone(), node_id: 0 }
end

# ───────────────────────────────────────────────────────────────────────
# P1 macro hygiene: expansion-context stamping (see instantiate_macro)
# ───────────────────────────────────────────────────────────────────────
# Hygiene frames: a Vec of scope frames, one per entered scope. Each frame
# maps a name to the kind of its innermost binding: `true` marks a
# macro-internal let binding (the binding was re-stamped, so its references
# are re-stamped identically); `false` marks a NON-renamed shadow (closure
# params and match patterns are NOT re-stamped, so references to them stay
# as-is). Lookup walks the frames innermost-first; the innermost binding of
# a name decides how its references are treated.
#
# Context composition (P1): the frames are keyed by the ORIGINAL spellings
# and the re-stamp is applied at lookup time with the composed context
# STACK, so the composed keys extend the existing shadow-frame machinery
# unchanged: a binding and its references always land on the same
# (symbol, context)-derived key regardless of nesting depth.

def hygiene_ident_lookup(frames: &Vec[Map[String, Bool]], name: &String) -> Option[Bool]
  var fi = frames.len()
  while fi > 0 do
    fi = fi - 1
    match frames[fi].get(name)
    when Option::Some(b) then return Option::Some(b)
    when Option::None then ()
    end
  end
  Option::None
end

def hygiene_collect_pattern_names(pat: &Pattern, out: &mut Vec[String]) -> Unit
  match pat.kind
  when PatternKind::Ident(name, _) then out.push(name.clone())
  when PatternKind::Tuple(ps) then
    for p in ps do hygiene_collect_pattern_names(&p, out) end
  when PatternKind::Array(ps) then
    for p in ps do hygiene_collect_pattern_names(&p, out) end
  when PatternKind::Struct(_, fields) then
    for (_, p) in fields do hygiene_collect_pattern_names(&p, out) end
  when PatternKind::Variant(_, ps) then
    for p in ps do hygiene_collect_pattern_names(&p, out) end
  when PatternKind::Or(ps) then
    for p in ps do hygiene_collect_pattern_names(&p, out) end
  when _ then ()
  end
end

def hygiene_renamed_pattern(ctx_stack: &Vec[Int], subst: &Map[String, Expr], pat: &Pattern) -> Pattern
  match pat.kind
  when PatternKind::Ident(name, is_mut) then
    # A let-bound name matching a macro parameter is the user's interface
    # (its occurrences are replaced by the argument tokens, which are never
    # re-stamped); it is left unrenamed.
    if subst.contains_key(&name) then
      Pattern { kind: PatternKind::Ident(name.clone(), is_mut), span: pat.span, node_id: 0 }
    else
      # P1 (structural hygiene): the binding becomes a generated identifier
      # carrying this expansion's syntax context — its rendered key is the
      # (symbol, context) pair in the identifier-impossible `$` encoding.
      let id = hygiene_identifier(&name, ctx_stack)
      Pattern { kind: PatternKind::Ident(identifier_key_of(&id, ctx_stack), is_mut), span: pat.span, node_id: 0 }
    end
  when PatternKind::Tuple(ps) then
    var new_ps = Vec::new()
    for p in ps do new_ps.push(hygiene_renamed_pattern(ctx_stack, subst, &p)) end
    Pattern { kind: PatternKind::Tuple(new_ps), span: pat.span, node_id: 0 }
  when PatternKind::Array(ps) then
    var new_ps = Vec::new()
    for p in ps do new_ps.push(hygiene_renamed_pattern(ctx_stack, subst, &p)) end
    Pattern { kind: PatternKind::Array(new_ps), span: pat.span, node_id: 0 }
  when PatternKind::Struct(path, fields) then
    var new_fields = Vec::new()
    for (fname, p) in fields do
      new_fields.push((fname.clone(), hygiene_renamed_pattern(ctx_stack, subst, &p)))
    end
    Pattern { kind: PatternKind::Struct(path.clone(), new_fields), span: pat.span, node_id: 0 }
  when PatternKind::Variant(path, ps) then
    var new_ps = Vec::new()
    for p in ps do new_ps.push(hygiene_renamed_pattern(ctx_stack, subst, &p)) end
    Pattern { kind: PatternKind::Variant(path.clone(), new_ps), span: pat.span, node_id: 0 }
  when PatternKind::Or(ps) then
    var new_ps = Vec::new()
    for p in ps do new_ps.push(hygiene_renamed_pattern(ctx_stack, subst, &p)) end
    Pattern { kind: PatternKind::Or(new_ps), span: pat.span, node_id: 0 }
  when _ then pat.clone()
  end
end

def hygiene_push_shadow_frame(frames: &Vec[Map[String, Bool]], names: &Vec[String]) -> Vec[Map[String, Bool]]
  var new_frames = frames.clone()
  new_frames.push(Map::new())
  let last = new_frames.len() - 1
  for n in names do
    new_frames[last].insert(n.clone(), false)
  end
  new_frames
end

# ctx_stack: the composed P1 hygiene context stack of THIS expansion (see
# instantiate_macro) — every binding the body introduces and every reference
# to it is stamped with the composed key.
pub def substitute_block(subst: &Map[String, Expr], ctx_stack: &Vec[Int], frames: &Vec[Map[String, Bool]], block: &Block) -> Block
  # Each block opens a hygiene scope: the block's own let bindings land in a
  # fresh frame, so nested blocks shadow without leaking outward.
  var inner_frames = frames.clone()
  inner_frames.push(Map::new())
  var new_stmts = Vec::new()
  var i = 0
  while i < block.stmts.len() do
    new_stmts.push(substitute_stmt(subst, ctx_stack, &inner_frames, &block.stmts[i]))
    i = i + 1
  end
  Block { stmts: new_stmts, span: block.span }
end

pub def substitute_stmt(subst: &Map[String, Expr], ctx_stack: &Vec[Int], frames: &Vec[Map[String, Bool]], stmt: &Stmt) -> Stmt
  match stmt.kind
  when StmtKind::StmtExpr(expr) then
    Stmt { kind: StmtKind::StmtExpr(substitute_expr(subst, ctx_stack, frames, &expr)), span: stmt.span, node_id: 0 }
  when StmtKind::StmtLet(pat, ty, init, is_mut) then
    # P1 (macro hygiene): the let-bound temporaries the macro body itself
    # introduces are re-stamped with the composed expansion context stack.
    # The init is substituted BEFORE the binding enters the hygiene frame,
    # so an init-side reference to the same name still resolves to the
    # enclosing scope (unchanged semantics).
    let new_init = substitute_expr(subst, ctx_stack, frames, &init)
    let new_pat = hygiene_renamed_pattern(ctx_stack, subst, &pat)
    # The frame is keyed by the ORIGINAL spellings: a later reference (also
    # spelled originally) is re-stamped with the same composed context stack,
    # landing on the same (symbol, context)-derived key as the binding.
    var names = Vec::new()
    hygiene_collect_pattern_names(&pat, &mut names)
    let last_frame = frames.len() - 1
    for n in names do
      frames[last_frame].insert(n.clone(), true)
    end
    Stmt { kind: StmtKind::StmtLet(new_pat, ty.clone(), new_init, is_mut), span: stmt.span, node_id: 0 }
  when _ then stmt.clone()
  end
end

pub def substitute_expr(subst: &Map[String, Expr], ctx_stack: &Vec[Int], frames: &Vec[Map[String, Bool]], expr: &Expr) -> Expr
  match expr.kind
  when ExprKind::ExprPath(path) then
    let name = path_to_name(&path)
    match subst.get(&name)
    when Option::Some(replacement) then replacement.clone()
    when Option::None then
      # P1 (macro hygiene): re-stamp only bare paths; qualified paths
      # (e.g. Benchmark::new) can never name a local.
      if path.segments.len() == 1 then
        match hygiene_ident_lookup(frames, &name)
        when Option::Some(true) then
          var new_segs = Vec::new()
          let id = hygiene_identifier(&name, ctx_stack)
          new_segs.push(identifier_key_of(&id, ctx_stack))
          Expr { kind: ExprKind::ExprPath(AstPath { segments: new_segs, span: path.span }), span: expr.span, node_id: 0 }
        when _ then expr.clone()
        end
      else
        expr.clone()
      end
    end
  when ExprKind::ExprIdent(name) then
    match subst.get(&name)
    when Option::Some(replacement) then replacement.clone()
    when Option::None then
      # P1 (macro hygiene): references to a re-stamped macro-internal let
      # binding are re-stamped identically (same composed context stack —
      # the (symbol, context)-derived key); references to a shadow (closure
      # param / match pattern) or to a free name stay untouched.
      match hygiene_ident_lookup(frames, &name)
      when Option::Some(true) then
        let id = hygiene_identifier(&name, ctx_stack)
        Expr { kind: ExprKind::ExprIdent(identifier_key_of(&id, ctx_stack)), span: expr.span, node_id: 0 }
      when _ then expr.clone()
      end
    end
  when ExprKind::ExprCall(callee, args) then
    let new_callee = substitute_expr(subst, ctx_stack, frames, &callee)
    var new_args = Vec::new()
    var i = 0
    while i < args.len() do
      new_args.push(substitute_expr(subst, ctx_stack, frames, &args[i]))
      i = i + 1
    end
    Expr { kind: ExprKind::ExprCall(Box::new(new_callee), new_args), span: expr.span, node_id: 0 }
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    Expr { kind: ExprKind::ExprBinaryOp(op, Box::new(substitute_expr(subst, ctx_stack, frames, &lhs)), Box::new(substitute_expr(subst, ctx_stack, frames, &rhs))), span: expr.span, node_id: 0 }
  when ExprKind::ExprUnaryOp(op, operand) then
    Expr { kind: ExprKind::ExprUnaryOp(op, Box::new(substitute_expr(subst, ctx_stack, frames, &operand))), span: expr.span, node_id: 0 }
  when ExprKind::ExprBlock(block) then
    Expr { kind: ExprKind::ExprBlock(substitute_block(subst, ctx_stack, frames, &block)), span: expr.span, node_id: 0 }
  when ExprKind::ExprMethodCall(receiver, method, targs, args) then
    let new_recv = substitute_expr(subst, ctx_stack, frames, &receiver)
    var new_args = Vec::new()
    var i = 0
    while i < args.len() do
      new_args.push(substitute_expr(subst, ctx_stack, frames, &args[i]))
      i = i + 1
    end
    Expr { kind: ExprKind::ExprMethodCall(Box::new(new_recv), method.clone(), targs.clone(), new_args), span: expr.span, node_id: 0 }
  when ExprKind::ExprEnumVariant(path, args) then
    var new_args = Vec::new()
    for arg in args do
      new_args.push(substitute_expr(subst, ctx_stack, frames, &arg))
    end
    Expr { kind: ExprKind::ExprEnumVariant(path.clone(), new_args), span: expr.span, node_id: 0 }
  when ExprKind::ExprFieldAccess(obj, field) then
    Expr { kind: ExprKind::ExprFieldAccess(Box::new(substitute_expr(subst, ctx_stack, frames, &obj)), field.clone()), span: expr.span, node_id: 0 }
  when ExprKind::ExprIndex(obj, idx) then
    Expr { kind: ExprKind::ExprIndex(Box::new(substitute_expr(subst, ctx_stack, frames, &obj)), Box::new(substitute_expr(subst, ctx_stack, frames, &idx))), span: expr.span, node_id: 0 }
  when ExprKind::ExprArrayLit(elems) then
    var new_elems = Vec::new()
    for e in elems do new_elems.push(substitute_expr(subst, ctx_stack, frames, &e)) end
    Expr { kind: ExprKind::ExprArrayLit(new_elems), span: expr.span, node_id: 0 }
  when ExprKind::ExprTupleLit(elems) then
    var new_elems = Vec::new()
    for e in elems do new_elems.push(substitute_expr(subst, ctx_stack, frames, &e)) end
    Expr { kind: ExprKind::ExprTupleLit(new_elems), span: expr.span, node_id: 0 }
  when ExprKind::ExprStructLit(path, fields) then
    var new_fields = Vec::new()
    for (field_name, field_value) in fields do
      new_fields.push((field_name.clone(), substitute_expr(subst, ctx_stack, frames, &field_value)))
    end
    Expr { kind: ExprKind::ExprStructLit(path.clone(), new_fields), span: expr.span, node_id: 0 }
  when ExprKind::ExprMapLit(entries) then
    var new_entries = Vec::new()
    for (key_expr, value_expr) in entries do
      new_entries.push((substitute_expr(subst, ctx_stack, frames, &key_expr), substitute_expr(subst, ctx_stack, frames, &value_expr)))
    end
    Expr { kind: ExprKind::ExprMapLit(new_entries), span: expr.span, node_id: 0 }
  when ExprKind::ExprAccess(inner) then
    Expr { kind: ExprKind::ExprAccess(Box::new(substitute_expr(subst, ctx_stack, frames, &inner))), span: expr.span, node_id: 0 }
  when ExprKind::ExprRawDeref(inner) then
    Expr { kind: ExprKind::ExprRawDeref(Box::new(substitute_expr(subst, ctx_stack, frames, &inner))), span: expr.span, node_id: 0 }
  when ExprKind::ExprAwait(inner) then
    Expr { kind: ExprKind::ExprAwait(Box::new(substitute_expr(subst, ctx_stack, frames, &inner))), span: expr.span, node_id: 0 }
  when ExprKind::ExprTry(inner) then
    Expr { kind: ExprKind::ExprTry(Box::new(substitute_expr(subst, ctx_stack, frames, &inner))), span: expr.span, node_id: 0 }
  when ExprKind::ExprRange(start_expr, end_expr, inclusive) then
    let new_start = match start_expr
    when Option::Some(start) then Option::Some(Box::new(substitute_expr(subst, ctx_stack, frames, &start)))
    when Option::None then Option::None
    end
    let new_end = match end_expr
    when Option::Some(end_expr_inner) then Option::Some(Box::new(substitute_expr(subst, ctx_stack, frames, &end_expr_inner)))
    when Option::None then Option::None
    end
    Expr { kind: ExprKind::ExprRange(new_start, new_end, inclusive), span: expr.span, node_id: 0 }
  when ExprKind::ExprCast(inner, ty) then
    Expr { kind: ExprKind::ExprCast(Box::new(substitute_expr(subst, ctx_stack, frames, &inner)), ty.clone()), span: expr.span, node_id: 0 }
  when ExprKind::ExprTypeCheck(inner, ty) then
    Expr { kind: ExprKind::ExprTypeCheck(Box::new(substitute_expr(subst, ctx_stack, frames, &inner)), ty.clone()), span: expr.span, node_id: 0 }
  when ExprKind::ExprAssign(target, value) then
    Expr { kind: ExprKind::ExprAssign(Box::new(substitute_expr(subst, ctx_stack, frames, &target)), Box::new(substitute_expr(subst, ctx_stack, frames, &value))), span: expr.span, node_id: 0 }
  when ExprKind::ExprPipe(lhs, rhs) then
    Expr { kind: ExprKind::ExprPipe(Box::new(substitute_expr(subst, ctx_stack, frames, &lhs)), Box::new(substitute_expr(subst, ctx_stack, frames, &rhs))), span: expr.span, node_id: 0 }
  when ExprKind::ExprIf(if_expr) then
    let new_cond = substitute_expr(subst, ctx_stack, frames, &if_expr.cond)
    let new_then = substitute_block(subst, ctx_stack, frames, &if_expr.then_block)
    let new_if = IfStmt {
      cond: new_cond,
      then_block: new_then,
      elsif_branches: if_expr.elsif_branches.clone(),
      else_block: if_expr.else_block.clone(),
      span: if_expr.span
    }
    Expr { kind: ExprKind::ExprIf(new_if), span: expr.span, node_id: 0 }
  when ExprKind::ExprUnsafe(reason, block) then
    Expr { kind: ExprKind::ExprUnsafe(reason.clone(), substitute_block(subst, ctx_stack, frames, &block)), span: expr.span, node_id: 0 }
  when ExprKind::ExprMatch(match_expr) then
    var new_arms = Vec::new()
    for arm in match_expr.arms do
      # Match patterns are NOT re-stamped: they shadow macro-internal names
      # inside the arm (guard + body), and references to them stay as-is.
      var arm_names = Vec::new()
      hygiene_collect_pattern_names(&arm.pattern, &mut arm_names)
      let arm_frames = hygiene_push_shadow_frame(frames, &arm_names)
      let new_guard = match arm.guard_expr
      when Option::Some(guard_expr) then Option::Some(substitute_expr(subst, ctx_stack, &arm_frames, &guard_expr))
      when Option::None then Option::None
      end
      new_arms.push(MatchArm {
        pattern: arm.pattern.clone(),
        guard_expr: new_guard,
        body: substitute_block(subst, ctx_stack, &arm_frames, &arm.body),
        span: arm.span
      })
    end
    Expr { node_id: 0, kind: ExprKind::ExprMatch(MatchExpr {
      scrutinee: substitute_expr(subst, ctx_stack, frames, &match_expr.scrutinee),
      arms: new_arms,
      span: match_expr.span
    }), span: expr.span }
  when ExprKind::ExprClosure(params, ret_ty, body) then
    # Closure params are NOT re-stamped: they shadow macro-internal names
    # inside the closure body, and references to them stay as-is.
    var param_names = Vec::new()
    var pi = 0
    while pi < params.len() do
      hygiene_collect_pattern_names(&params[pi].pat, &mut param_names)
      pi = pi + 1
    end
    let closure_frames = hygiene_push_shadow_frame(frames, &param_names)
    Expr { kind: ExprKind::ExprClosure(params.clone(), ret_ty.clone(), Box::new(substitute_expr(subst, ctx_stack, &closure_frames, &body))), span: expr.span, node_id: 0 }
  when _ then expr.clone()
  end
end

pub def path_to_name(path: &AstPath) -> String
  # Simple: use the last segment name
  if path.segments.is_empty() then
    "".to_string()
  else
    path.segments[path.segments.len() - 1].clone()
  end
end

# Compile multiple source files by merging their ASTs into a single program.
# Each file is read, lexed, and parsed independently, then their items are
# concatenated into one Program before going through merge_imported_deps,
# MIR lowering, optimization, and code generation.
pub def compile_multiple_files(opts: &CompilerOptions, files: Vec[String], output_path: String) -> Int
  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end

  let is_bootstrap_driver = files.len() == 1 && is_compiler_driver_path(files[0].clone())
  # Stage outputs are executables, not source programs. Their filename never
  # alters frontend correctness, so semantic checks are never skipped here.
  let skip_bootstrap_semantic_checks = false
  var all_items: Vec[Item] = Vec::new()

  if opts.verbose then
    println("Compiling " + files.len().to_string() + " files...")
  end

  var fi = 0
  while fi < files.len() do
    let path = files[fi].clone()
    if opts.verbose then
      println("  Reading: " + path.clone())
    end

    let source = read_file_text_direct(path.clone())
    if source.len() == 0 then
      println("Failed to read file: " + path.clone())
      return 1
    end

    if opts.verbose then
      println("  Lexing: " + path.clone())
    end
    var lex = lexer_new(source, path.clone())
    let lex_result = tokenize_impl(&mut lex)

    if opts.verbose then
      println("  Parsing: " + path.clone())
    end
    let parse_out = parse(lex_result)
    let ast = parse_out.program
    let parse_diags = parse_out.diagnostics
    if diag_has_errors(&parse_diags) then
      println("Parse error in " + path.clone())
      for d in parse_diags do
        let pos_info = match d.span
        when Option::Some(s) then " at offset " + s.start.to_string()
        when Option::None then ""
        end
        println("  " + d.message + pos_info)
      end
      return 1
    end

    # Merge items from this file
    var ii = 0
    while ii < ast.items.len() do
      all_items.push(ast.items[ii])
      ii = ii + 1
    end
    fi = fi + 1
  end

  # Create merged AST spanning all files (use span of first file as reference)
  if all_items.len() == 0 then
    println("No valid items found in input files")
    return 1
  end
  # P0-AM (Crate construction): multiple files are concatenated into one flat
  # items vector, so the root module (id 0, empty path) covers all of them;
  # the full Crate is rebuilt by merge_imported_deps below. P1: the root
  # module's per-module item list (Module.items: Vec[ItemId]) is built here
  # over the concatenated items.
  var merged_modules = Map::new()
  var merged_items = Vec::new()
  var mi3 = 0
  while mi3 < all_items.len() do
    merged_items.push(ItemId { id: mi3 })
    mi3 = mi3 + 1
  end
  let root_id = ModuleId { id: 0 }
  merged_modules.insert(root_id, Module {
    id: root_id,
    path: Vec::new(),
    items: merged_items,
    imports: Vec::new()
  })
  let merged_ast = Program {
    items: all_items,
    crate: Crate { root: root_id, modules: merged_modules },
    span: all_items[0].span
  }

  # ── canonical pipeline: merge -> analyze_parsed -> lower -> emit ────────
  # Semantic stages (macro expansion, node ids, resolution, type/access/
  # resource checks) are performed exclusively by analyze_parsed (via
  # analyze_program) so multi-file compilation goes through the SAME
  # canonical path as every other entry point.
  if opts.verbose then
    println("  Merging imported dependencies...")
  end
  # `var` so the canonical semantic pass below can take &mut ast.
  var ast = match merge_imported_deps(merged_ast, include_compiler_lib: is_bootstrap_driver)
  when Result::Ok(a) then a
  when Result::Err(e) then
    println(e)
    return 1
  end

  if opts.verbose then
    println("  Type checking...")
  end
  var typed_program: Option[TypedProgram] = Option::None
  if !skip_bootstrap_semantic_checks then
    var env = type_env_new()
    # P1 (recovery separation): compilation always runs strict — the flag is
    # forced on unconditionally at the invocation (a real compilation with
    # strict_resolution = false is an internal error); permissive editor
    # recovery never produces a TypedProgram.
    env.strict_resolution = true
    match analyze_program(&mut env, &mut ast, opts)
    when Result::Ok(tp) then
      typed_program = Option::Some(tp)
    when Result::Err(e) then
      emit_diagnostic(&mut emitter, Diagnostic {
        level: DiagLevel::Error,
        message: e,
        span: Option::None,
        notes: Vec::new(),
        suggestions: Vec::new(),
        code: Option::Some("E0405")
      })
      println("Type check failed")
      return 1
    end
  else
    # P1 (macro hygiene, expansion-depth contract): the skip-semantic-checks
    # path still routes expansion failures (E105) through the parser's
    # diagnostic channel and fails loudly instead of lowering a partial AST.
    var skip_diags: Vec[Diagnostic] = Vec::new()
    prepare_parsed(&mut ast, &mut skip_diags)
    if diag_has_errors(&skip_diags) then
      println(join_parse_diagnostics(&skip_diags))
      return 1
    end
  end

  if !skip_bootstrap_semantic_checks && has_errors(&emitter) then
    println("Type check failed")
    return 1
  end

  if opts.verbose then
    println("  Lowering to MIR...")
  end
  var mir = MirProgram { functions: Vec::new(), statics: Vec::new(), types: Vec::new() }
  match driver_lower_to_mir(&ast, &typed_program)
  when Result::Ok(m) then
    mir = m
  when Result::Err(e) then
    eprintln("MIR lowering failed: " + e)
    return 1
  end

  let post_lower_errs = verify_mir(&mir)
  if !post_lower_errs.is_empty() then
    for e in post_lower_errs do
      eprintln("MIR verifier (post-lower): " + e)
    end
    println("MIR verification failed after lowering")
    return 1
  end

  if opts.verbose then
    println("  Monomorphizing generics...")
  end
  var mono_cache = match typed_program
  when Option::Some(tp) then mono_cache_new(&ast, &tp.resolutions)
  when Option::None then return 1
  end
  match monomorphize_program(&mut mir, &mut mono_cache)
  when Result::Err(mono_errs) then
    for e in mono_errs do
      eprintln("monomorphization error: " + e)
    end
    println("monomorphization failed with " + mono_errs.len().to_string() + " error(s)")
    return 1
  when Result::Ok(_) then ()
  end

  let post_mono_errs = verify_mir(&mir)
  if !post_mono_errs.is_empty() then
    for e in post_mono_errs do
      eprintln("MIR verifier (post-mono): " + e)
    end
    println("MIR verification failed after monomorphization")
    return 1
  end

  if opts.verbose then
    println("  Optimizing MIR (O" + opts.opt_level.to_string() + ")...")
  end
  match opts.pgo_gen
  when Option::Some(_) then
    instrument_for_pgo(&mut mir)
  when Option::None then ()
  end
  match opts.pgo_use
  when Option::Some(profile_path) then
    match read_pgo_profile(&profile_path)
    when Result::Ok(profile) then
      apply_pgo_profile(&mut mir, &profile)
    when Result::Err(e) then ()
    end
  when Option::None then ()
  end
  optimize_mir(&mut mir, opts.opt_level)

  let post_opt_errs = verify_mir(&mir)
  if !post_opt_errs.is_empty() then
    for e in post_opt_errs do
      eprintln("MIR verifier (post-opt): " + e)
    end
    println("MIR verification failed after optimization")
    return 1
  end

  if opts.emit_mir then
    print_mir(&mir)
    return 0
  end

  if opts.verbose then
    println("  Generating native code...")
  end
  let target = if skip_bootstrap_semantic_checks then
    bootstrap_codegen_target()
  else
    match opts.target_triple
    when Option::Some(triple) then parse_target_triple(triple)
    when Option::None then detect_host_target()
    end
  end

  match opts.emit
  when EmitMode::Object then
    let obj_bytes = match generate_object_file(&mir, &target)
    when Result::Ok(b) then b
    when Result::Err(e) then
      println(e)
      return 1
    end
    match write_file_bytes(output_path.clone(), &obj_bytes)
    when Result::Ok(_) then
      if !file_exists(output_path.clone()) then
        println("Failed to materialize object file: " + output_path.clone())
        return 1
      end
      if !opts.quiet then
        println("Object file: " + output_path.clone())
      end
    when Result::Err(e) then
      println("Failed to write object file: " + e)
      return 1
    end
  when EmitMode::Executable then
    if file_exists(output_path.clone()) then
      let _ = delete_file(output_path.clone())
    end
    match generate_executable(&mir, &target, output_path.clone())
    when Result::Ok(_) then ()
    when Result::Err(e) then
      println("Native compilation failed: " + e)
      return 1
    end
    if !opts.quiet then
      println("Compiled: " + output_path.clone())
    end
  when _ then ()
  end

  0
end

# 
# Standard Library Prelude
# 

# Read bootstrap/compiler_kernel.manifest and return the canonical ordered
# source list: sorted std files, then sorted compiler files — the exact same
# order the Swift stage0 consumes. Returns None when the manifest is absent.
pub def bootstrap_manifest_sources() -> Option[Vec[String]]
  if !file_exists("bootstrap/compiler_kernel.manifest") then
    return Option::None
  end
  let text = read_file_text_direct("bootstrap/compiler_kernel.manifest")
  let lines = text.split("\n")
  var std_files = Vec::new()
  var compiler_files = Vec::new()
  var li = 0
  while li < lines.len() do
    let line = lines[li].trim()
    if line.len() == 0 || line.starts_with("#") then
      li = li + 1
      next
    end
    let colon = line.index_of(":")
    if colon < 0 then
      li = li + 1
      next
    end
    let key = line.slice(0, colon).trim()
    let value = line.slice(colon + 1, line.len()).trim()
    if value.len() == 0 then
      li = li + 1
      next
    end
    if key == "std" then
      std_files.push(value)
    elsif key == "compiler" then
      compiler_files.push(value)
    end
    li = li + 1
  end
  if std_files.is_empty() && compiler_files.is_empty() then
    return Option::None
  end
  std_files.sort()
  compiler_files.sort()
  var out = Vec::new()
  for f in std_files do
    out.push("std/" + f)
  end
  for f in compiler_files do
    out.push("tg_compiler/" + f)
  end
  Option::Some(out)
end

pub def prelude_files() -> Vec[String]  # The bootstrap stdlib set is defined ONLY by bootstrap/compiler_kernel.manifest.
  # This list must mirror that manifest exactly and must never independently
  # describe bootstrap semantics. Modules the driver imports explicitly (env,
  # contracts, capabilities, effects, budget, test) are pulled in by
  # collect_dep_items on demand; they are not part of the always-loaded prelude.
  var files = Vec::new()
  files.push("std/alloc.tg")
  files.push("std/collections.tg")
  files.push("std/core.tg")
  files.push("std/ffi.tg")
  files.push("std/fmt.tg")
  files.push("std/fs.tg")
  files.push("std/io.tg")
  files.push("std/taint.tg")
  files
end
