extern def libc_write(fd: Int, buf: &u8, count: UInt) -> Int
extern def read_file_to_string_native(path: String) -> String
def syscall_write(fd: Int, buf: &u8, count: UInt) -> Int
  libc_write(fd, buf, count)
end

# 
# Compiler Options
# 

pub struct CompilerOptions
  # Input/output
  input_files: Vec[String]
  output_file: Option[String]
  
  # Compilation mode
  emit: EmitMode
  
  # Optimization level
  opt_level: Int
  
  # Debug info
  debug_info: Bool
  
  # Features
  enable_contracts: Bool
  enable_capabilities: Bool
  enable_effects: Bool
  enable_budgets: Bool
  
  # Warnings
  warn_unused: Bool
  warn_all: Bool
  deny_warnings: Bool
  
  # Verbosity
  verbose: Bool
  quiet: Bool
  
  # Special modes
  check_only: Bool
  stop_after: StopAfter
  strict_resolution: Bool
  emit_mir: Bool
  print_ast: Bool
  print_tokens: Bool
  dump_phase: Option[String]
  
  # Output format
  json_diagnostics: Bool
  color: Bool
  
  # Cross-compilation
  target_triple: Option[String]

  # PGO
  pgo_gen: Option[String]    # --pgo-gen=<path> : instrument and write profile
  pgo_use: Option[String]    # --pgo-use=<path> : read profile for optimization

  # Mode system
  mode: Mode                  # Dev/Strict/Production/Hardened
  mode_config: ModeConfig     # Derived from mode
end

pub enum EmitMode
  Executable
  Object
  Assembly
  MIR
end

# Explicit compilation stopping phase. Commands map onto a single phase:
#   tg parse   -> Parse
#   tg check   -> Mir
#   tg compile -> Link
# Each phase includes everything before it (lex, parse, dependency resolution,
# macro expansion, name/type checking, access checking, resource checking, MIR
# lowering, MIR verification), so `tg check` is a real semantic gate and never a
# parse-only shortcut.
pub enum StopAfter
  Parse
  Semantic
  Mir
  Object
  Link
end

# Failures while collecting imported dependencies. Each distinguishes the
# stage that failed so a partially parsed dependency is never silently merged
# into a compiler program.
pub enum DependencyError
  Read
  Lex
  Parse
  Recursive
end

pub def dep_error_message(e: DependencyError, path: String) -> String
  match e
  when DependencyError::Read      then "failed to read dependency: " + path
  when DependencyError::Lex       then "failed to lex dependency: " + path
  when DependencyError::Parse     then "failed to parse dependency: " + path
  when DependencyError::Recursive then "failed to collect transitive dependency of: " + path
  end
end

pub def default_options() -> CompilerOptions
  CompilerOptions {
    input_files: Vec::new(),
    output_file: Option::None,
    emit: EmitMode::Executable,
    opt_level: 0,
    debug_info: false,
    enable_contracts: true,
    enable_capabilities: true,
    enable_effects: true,
    enable_budgets: true,
    warn_unused: true,
    warn_all: false,
    deny_warnings: false,
    verbose: false,
    quiet: false,
    check_only: false,
    stop_after: StopAfter::Link,
    strict_resolution: false,
    emit_mir: false,
    print_ast: false,
    print_tokens: false,
    dump_phase: Option::None,
    json_diagnostics: false,
    color: true,
    target_triple: Option::None,
    pgo_gen: Option::None,
    pgo_use: Option::None,
    mode: Mode::Dev,
    mode_config: config_for_mode(Mode::Dev)
  }
end

pub def is_compiler_driver_path(path: String) -> Bool
  path == "tg_compiler/driver.tg" || path.ends_with("/tg_compiler/driver.tg")
end

pub def should_skip_bootstrap_semantic_checks(opts: &CompilerOptions, path: String) -> Bool
  # Semantic checks are never skipped. Stage outputs are executables, not
  # source programs; their filename must never alter frontend correctness.
  # `-o tg_stage2` must behave identically to `-o foo` for identical inputs.
  false
end

pub def bootstrap_codegen_target() -> AsmTarget
  asm_target(Arch::AArch64, OsAbi::MacOS)
end

pub def driver_lower_to_mir(ast: &Program, typed: &Option[TypedProgram]) -> Result[MirProgram, String]
  match typed
  when Option::Some(tp) then lower_to_mir(ast, tp)
  when Option::None then Result::Err("MIR lowering requires a typed program")
  end
end

# Use Diagnostic definition from parser
use tg_compiler::parser::{Diagnostic, DiagLevel, Suggestion, ErrorCode}

# 
# Diagnostics Emitter
# 

pub struct DiagnosticEmitter
  source_map: SourceMap
  current_source_id: Int
  diagnostics: Vec[Diagnostic]
  error_count: Int
  warning_count: Int
  json_mode: Bool
  color_enabled: Bool
end

pub struct SourceMap
  files: Vec[SourceFile]
end

pub struct SourceFile
  name: String
  content: String
  lines: Vec[Int]  # Line start offsets
end

pub def emitter_new() -> DiagnosticEmitter
  DiagnosticEmitter {
    source_map: SourceMap { files: Vec::new() },
    current_source_id: -1,
    diagnostics: Vec::new(),
    error_count: 0,
    warning_count: 0,
    json_mode: false,
    color_enabled: true
  }
end

pub def emitter_new_json() -> DiagnosticEmitter
  DiagnosticEmitter {
    source_map: SourceMap { files: Vec::new() },
    current_source_id: -1,
    diagnostics: Vec::new(),
    error_count: 0,
    warning_count: 0,
    json_mode: true,
    color_enabled: false
  }
end

pub def add_source(e: &mut DiagnosticEmitter, name: String, content: String) -> Int
  var lines = Vec::new()
  lines.push(0)
  var i = 0
  while i < content.len() do
    if content.char_at(i) == '\n' then
      lines.push(i + 1)
    end
    i = i + 1
  end
  
  e.source_map.files.push(SourceFile {
    name: name,
    content: content,
    lines: lines
  })

  let id = e.source_map.files.len() - 1
  e.current_source_id = id
  
  id
end

pub def emit_diagnostic(e: &mut DiagnosticEmitter, d: Diagnostic) -> Unit
  # Track counts
  match d.level
  when DiagLevel::Error then
    e.error_count = e.error_count + 1
  when DiagLevel::Warning then
    e.warning_count = e.warning_count + 1
  when _ then ()
  end
  
  if e.json_mode then
    emit_diagnostic_json(e, &d)
    e.diagnostics.push(d)
    return
  end
  
  # Human-readable format
  let level_str = match d.level
  when DiagLevel::Error then "error"
  when DiagLevel::Warning then "warning"
  when DiagLevel::Info then "info"
  when DiagLevel::Note then "note"
  when DiagLevel::Help then "help"
  end
  
  if e.color_enabled then
    let color = match d.level
    when DiagLevel::Error then "\x1b[31m"
    when DiagLevel::Warning then "\x1b[33m"
    when DiagLevel::Info then "\x1b[36m"
    when DiagLevel::Note then "\x1b[34m"
    when DiagLevel::Help then "\x1b[32m"
    end
    eprint_styled(level_str, color)
  else
    eprint(level_str)
  end
  
  # Print error code if present
  match d.code
  when Option::Some(code) then
    eprint("[" + code + "]")
  when Option::None then ()
  end

  eprint(": " + d.message + "\n")
  
  
  # Print source location
  match d.span
  when Option::Some(span) then
    print_source_location(e, span)
  when Option::None then ()
  end
  
  # Print notes
  for note in d.notes do
    eprint("note: " + note + "\n")
  end
  
  # Print suggestions
  for suggestion in d.suggestions do
    eprint("help: " + suggestion.message + "\n")
  end
  
  e.diagnostics.push(d)
end

pub def eprint_styled(s: String, style: String) -> Unit
  eprint(style + s + "\x1b[0m")
end

pub def eprint(s: String) -> Unit
  let _n = syscall_write(2, s.as_ptr(), s.len())
end

pub def print_source_location(e: &DiagnosticEmitter, span: Span) -> Unit
  # Find the source file containing this span using span.file
  var found_file: Option[&SourceFile] = Option::None
  for f in e.source_map.files do
    if f.name == span.file then
      found_file = Option::Some(&f)
      break
    end
  end
  
  match found_file
  when Option::Some(file) then
    # Find the line number and column
    var line_num = 1
    var line_start = 0
    for offset in file.lines do
      if offset > span.start then
        break
      end
      line_start = offset
      line_num = line_num + 1
    end
    line_num = line_num - 1  # Adjust (loop increments one extra)
    let col = span.start - line_start
    
    # Find end of line
    var line_end = line_start
    while line_end < file.content.len() && file.content.char_at(line_end) != '\n' do
      line_end = line_end + 1
    end
    
    # Extract the source line
    let source_line = file.content.slice(line_start, line_end)
    
    # Print location header
    let loc_header = "  --> " + file.name.clone() + ":" + line_num.to_string() + ":" + (col + 1).to_string()
    
    # Print line number gutter
    let line_str = line_num.to_string()
    let padding = "     ".slice(0, 5 - line_str.len())
    
    # Print caret indicator
    var caret_line = ""
    var i = 0
    while i < 5 do
      caret_line = caret_line + " "
      i = i + 1
    end
    caret_line = caret_line + " | "
    i = 0
    while i < col do
      caret_line = caret_line + " "
      i = i + 1
    end
    # Draw the caret(s) for the span width
    let span_len = if span.end_pos > span.start then span.end_pos - span.start else 1 end
    i = 0
    while i < span_len do
      caret_line = caret_line + "^"
      i = i + 1
    end

    eprint(loc_header + "\n")
    eprint(padding + " |\n")
    eprint(line_str + padding + " | " + source_line + "\n")
    eprint(caret_line + "\n")

  when Option::None then
    # Fallback when the source file is not in the emitter's source map:
    # print the file name and byte offset so diagnostics are still locatable.
    eprint("  --> " + span.file.clone() + ":" + span.start.to_string() + "\n")
  end
end

# 
# JSON Diagnostic Output
# 

pub def emit_diagnostic_json(e: &DiagnosticEmitter, d: &Diagnostic) -> Unit
  var json = "{"
  
  # Level
  let level_str = match d.level
  when DiagLevel::Error then "error"
  when DiagLevel::Warning then "warning"
  when DiagLevel::Info then "info"
  when DiagLevel::Note then "note"
  when DiagLevel::Help then "help"
  end
  json = json + "\"level\":\"" + level_str + "\","
  
  # Message (escape special chars)
  json = json + "\"message\":\"" + json_escape(d.message.clone()) + "\","
  
  # Error code
  match d.code
  when Option::Some(code) then
    json = json + "\"code\":{\"code\":\"" + code + "\",\"explanation\":\"" +
           json_escape(explain_error_code(code.clone())) + "\"},"
  when Option::None then
    json = json + "\"code\":null,"
  end
  
  # Spans
  json = json + "\"spans\":["
  match d.span
  when Option::Some(span) then
    json = json + emit_span_json(e, span)
  when Option::None then ()
  end
  json = json + "],"
  
  # Notes as children
  json = json + "\"children\":["
  var first = true
  for note in d.notes do
    if !first then json = json + "," end
    json = json + "{\"level\":\"note\",\"message\":\"" + json_escape(note.clone()) + "\"}"
    first = false
  end
  json = json + "],"
  
  # Suggestions
  json = json + "\"suggestions\":["
  first = true
  for sugg in d.suggestions do
    if !first then json = json + "," end
    json = json + emit_suggestion_json(&sugg)
    first = false
  end
  json = json + "]"
  
  json = json + "}"
end

pub def emit_span_json(e: &DiagnosticEmitter, span: Span) -> String
  var json = "{"
  json = json + "\"byte_start\":" + span.start.to_string() + ","
  json = json + "\"byte_end\":" + span.end_pos.to_string() + ","
  
  # Try to find file and line info
  var found = false
  for f in e.source_map.files do
    if span.start < f.content.len() then
      # Find line and column
      var line_num = 1
      var line_start = 0
      for offset in f.lines do
        if offset > span.start then break end
        line_start = offset
        line_num = line_num + 1
      end
      line_num = line_num - 1
      let col = span.start - line_start
      
      # End line and column
      var end_line = 1
      var end_line_start = 0
      for offset in f.lines do
        if offset > span.end_pos then break end
        end_line_start = offset
        end_line = end_line + 1
      end
      end_line = end_line - 1
      let end_col = span.end_pos - end_line_start
      
      json = json + "\"file_name\":\"" + json_escape(f.name.clone()) + "\","
      json = json + "\"line_start\":" + line_num.to_string() + ","
      json = json + "\"line_end\":" + end_line.to_string() + ","
      json = json + "\"column_start\":" + (col + 1).to_string() + ","
      json = json + "\"column_end\":" + (end_col + 1).to_string() + ","
      json = json + "\"is_primary\":true"
      found = true
      break
    end
  end
  
  if !found then
    json = json + "\"file_name\":\"<unknown>\","
    json = json + "\"line_start\":0,\"line_end\":0,"
    json = json + "\"column_start\":0,\"column_end\":0,"
    json = json + "\"is_primary\":true"
  end
  
  json = json + "}"
  json
end

pub def emit_suggestion_json(sugg: &Suggestion) -> String
  var json = "{"
  json = json + "\"message\":\"" + json_escape(sugg.message.clone()) + "\","
  json = json + "\"replacement\":\"" + json_escape(sugg.replacement.clone()) + "\","
  json = json + "\"span\":" + "{"
  json = json + "\"byte_start\":" + sugg.span.start.to_string() + ","
  json = json + "\"byte_end\":" + sugg.span.end_pos.to_string()
  json = json + "}}"
  json
end

pub def json_escape(s: String) -> String
  var result = ""
  var i = 0
  while i < s.len() do
    let c = s.char_at(i)
    if c == '"' then
      result = result + "\\\""
    elsif c == '\\' then
      result = result + "\\\\"
    elsif c == '\n' then
      result = result + "\\n"
    elsif c == '\r' then
      result = result + "\\r"
    elsif c == '\t' then
      result = result + "\\t"
    elsif c == '\x08' then
      result = result + "\\b"
    elsif c == '\x0C' then
      result = result + "\\f"
    elsif (c as UInt) < 0x20 then
      # Escape other control characters as \u00XX
      let code = c as UInt
      let hex_digits = "0123456789abcdef"
      result = result + "\\u00"
      result = result + hex_digits.char_at(((code >> 4) & 0xF) as Int).to_string()
      result = result + hex_digits.char_at((code & 0xF) as Int).to_string()
    else
      result = result + c.to_string()
    end
    i = i + 1
  end
  result
end

pub def emit_all_diagnostics_json(e: &DiagnosticEmitter) -> String
  # Emit as a JSON array
  var json = "["
  var first = true
  for d in e.diagnostics do
    if !first then json = json + "," end
    # Re-serialize to JSON (simplified)
    let level_str = match d.level
    when DiagLevel::Error then "error"
    when DiagLevel::Warning then "warning"
    when DiagLevel::Info then "info"
    when DiagLevel::Note then "note"
    when DiagLevel::Help then "help"
    end
    json = json + "{\"level\":\"" + level_str + "\","
    json = json + "\"message\":\"" + json_escape(d.message.clone()) + "\"}"
    first = false
  end
  json = json + "]"
  json
end

pub def has_errors(e: &DiagnosticEmitter) -> Bool
  e.error_count > 0
end

# 
# Error Code Registry
# 

pub def explain_error_code(code: String) -> String
  match code.as_str()
  # Lexer/Parser errors
  when "E0001" then "Unexpected character in source input."
  when "E0002" then "Unterminated string literal."
  when "E0003" then "Expected expression but found a different token."
  when "E0004" then "Mismatched brackets, braces, or parentheses."
  when "E0005" then "Unexpected end of file while parsing."
  when "E0010" then "Invalid numeric literal format."
  when "E0011" then "Expected `:` after struct field name."
  when "E0012" then "Expected `end` to close block."
  when "E0013" then "Expected `->` before return type."
  when "E0014" then "Invalid pattern in match arm."
  
  # Name resolution errors
  when "E0100" then "Unresolved name  the identifier was not found in scope."
  when "E0101" then "Duplicate definition  a name was defined more than once in the same scope."
  when "E0102" then "Unresolved import  the imported module or symbol was not found."
  when "E0103" then "Glob import conflict  two glob imports bring the same name into scope."
  when "E0104" then "Private symbol cannot be accessed from this module."
  when "E0105" then "Cannot import from a non-module item."
  when "E0106" then "Circular import dependency detected."
  
  # Type checking errors
  when "E0200" then "Type mismatch  expected one type but found another."
  when "E0201" then "Unknown type name  the type was not found."
  when "E0202" then "Wrong number of type arguments for generic type."
  when "E0203" then "Missing field in struct literal."
  when "E0204" then "Unknown field in struct literal."
  when "E0205" then "Binary operator cannot be applied to these types."
  when "E0206" then "Cannot call a non-function type."
  when "E0207" then "Wrong number of arguments in function call."
  when "E0208" then "Return type mismatch  function body returns a different type."
  when "E0209" then "Cannot access field on a non-struct type."
  when "E0210" then "Cannot index into a non-array/non-Vec type."
  when "E0211" then "Match arms have incompatible types."
  when "E0212" then "Non-exhaustive match  not all variants are covered."
  when "E0213" then "Infinite type detected  a type refers to itself without indirection."
  
  # Trait errors
  when "E0270" then "Trait not satisfied  type does not implement the required trait."
  when "E0271" then "Associated type mismatch in trait implementation."
  when "E0272" then "Missing method in trait implementation."
  when "E0273" then "Method signature does not match trait definition."
  when "E0274" then "Orphan rule violation  cannot implement foreign trait for foreign type."
  when "E0275" then "Overlapping trait implementations  coherence violation."
  when "E0276" then "Negative trait bounds not satisfied."
  when "E0277" then "Required trait bound not satisfied."
  
  # Safety errors
  when "E0400" then "Operation requires unsafe context."
  when "E0401" then "Raw pointer dereference outside unsafe block."
  when "E0402" then "FFI call outside unsafe block."
  when "E0403" then "Access to mutable static outside unsafe block."
  when "E0404" then "Transmute call outside unsafe block."
  
  # Codegen errors
  when "E0500" then "Unsupported target architecture."
  when "E0501" then "Linker error  undefined symbol."
  when "E0502" then "Linker error  duplicate symbol."
  when "E0503" then "Object file format error."
  
  when _ then "No extended information available for this error code."
  end
end

pub def error_code_example(code: String) -> String
  match code.as_str()
  when "E0200" then
    "  def foo() -> Int\n    \"hello\"        # error: expected Int, found String\n  end"
  when "E0274" then
    "  # In crate `my_crate`:\n  impl std::fmt::Display for std::vec::Vec[Int]\n  # error: neither Display nor Vec is defined in the current crate"
  when _ then ""
  end
end

# 
# Compilation Pipeline
# 

pub struct CompilationUnit
  name: String
  source: String
  tokens: Vec[Token]
  ast: Option[Program]
  mir: Option[MirProgram]
end

pub def read_file_text_direct(path: String) -> String
  read_file_to_string_native(path)
end

pub def analyze_parsed(env: &mut TypeEnv, program: &mut Program, opts: &CompilerOptions) -> Result[TypedProgram, String]
  let expanded = expand_macros(program.clone())
  *program = expanded
  assign_node_ids(program)
  match resolve_names(program)
  when Result::Ok(res) then
    if opts.strict_resolution then
      env.strict_resolution = true
    end
    let type_result = type_check_typed(env, program, &res)
    if !type_result.errors.is_empty() then
      return Result::Err(type_result.errors[0].message)
    end
    let typed = type_result.program
    let access_errors = access_check(program, &typed)
    if !access_errors.is_empty() then
      return Result::Err(access_errors[0].message)
    end
    let resource_errors = resource_check(program, &typed)
    if !resource_errors.is_empty() then
      return Result::Err(resource_errors[0].message)
    end
    Result::Ok(typed)
  when Result::Err(res_errors) then
    if res_errors.len() > 0 then
      Result::Err(res_errors[0].message)
    else
      Result::Err("name resolution failed")
    end
  end
end

pub def analyze_program(env: &mut TypeEnv, program: &mut Program, opts: &CompilerOptions) -> Result[TypedProgram, String]
  analyze_parsed(env, program, opts)
end

pub def analyze_source(source: String, file: String, opts: &CompilerOptions) -> Result[TypedProgram, String]
  let lex_result = tokenize(source, file)
  let parse_out = parse(lex_result)
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return Result::Err("Parse error: " + parse_diags[0].message)
  end
  var ast = parse_out.program
  var env = type_env_new()
  analyze_parsed(&mut env, &mut ast, opts)
end

pub def compile_file_core(path: String, opts: &CompilerOptions, emitter: &mut DiagnosticEmitter) -> Result[Unit, String]
  if opts.verbose then
    println("[diag] compile_file_core entered, path=" + path.clone())
  end

  let source = read_file_text_direct(path.clone())
  if source.len() == 0 then
    return Result::Err("Failed to read file: " + path.clone())
  end

  if opts.verbose then
    println("  Source len=" + source.len().to_string())
  end

  let is_bootstrap_driver = is_compiler_driver_path(path.clone())
  
  if !is_bootstrap_driver then
    add_source(emitter, path.clone(), source)
  end
  
  if opts.verbose then
    println("Compiling: " + path.clone())
  end
  
  # Phase 1: Lexing
  if opts.verbose then
    println("  Lexing...")
  end
  
  # Create lexer and tokenize
  var lex = lexer_new(source, path.clone())
  let lex_result = tokenize_impl(&mut lex)
  if opts.print_tokens then
    println("Tokens:")
    for tok in lex_result.tokens do
      println("  " + token_debug(tok))
    end
  end
  match opts.dump_phase
  when Option::Some("tokens") then
    return Result::Ok(())
  when _ then ()
  end
  
  # Phase 2: Parsing
  if opts.verbose then
    println("  Parsing...")
  end
  
  let parse_out = parse(lex_result)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    return Result::Err("Parse error")
  end

  if opts.verbose then
  end
  
  if opts.print_ast then
    println("AST:")
    print_ast(&ast)
  end
  
  match opts.dump_phase
  when Option::Some("ast") then
    println("AST:")
    print_ast(&ast)
    return Result::Ok(())
  when _ then ()
  end
  
  if opts.stop_after == StopAfter::Parse then
    return Result::Ok(())
  end
  
  # Phase 2.3: Standard library prelude is merged structurally later.
  # Avoid concatenating std source text into the current file, which corrupts
  # spans and makes parse failures in prelude modules look like local source errors.
  let ast_with_prelude = ast

  # Phase 2.4: Merge imported dependencies (so MIR lowering sees all functions)
  if opts.verbose then
    let import_paths = extract_import_paths(&ast_with_prelude)
  end

  if opts.verbose then
    println("[diag] before merge_imported_deps")
  end
  let ast = match merge_imported_deps(ast_with_prelude, include_compiler_lib: is_bootstrap_driver)
  when Result::Ok(a) then a
  when Result::Err(e) then
    return Result::Err(e)
  end
  if opts.verbose then
    println("[diag] after merge_imported_deps")
  end

  match opts.dump_phase
  when Option::Some("resolved-ast") then
    var dump_ast = expand_macros(ast.clone())
    assign_node_ids(&mut dump_ast)
    println("Resolved AST:")
    print_ast(&dump_ast)
    return Result::Ok(())
  when _ then ()
  end

  if opts.verbose then
  end
  
  # Phase 2.5: Macro expansion
  if opts.verbose then
    println("  Expanding macros...")
  end
  var ast = expand_macros(ast)
  assign_node_ids(&mut ast)

  if opts.verbose then
  end
  
  # Phase 3: Type checking
  if opts.verbose then
    println("  Type checking...")
  end
  var typed_program: Option[TypedProgram] = Option::None
  var env = type_env_new()
  match analyze_program(&mut env, &mut ast, opts)
  when Result::Ok(tp) then
    typed_program = Option::Some(tp)
  when Result::Err(e) then
    emit_diagnostic(emitter, Diagnostic {
      level: DiagLevel::Error,
      message: e,
      span: Option::None,
      notes: Vec::new(),
      suggestions: Vec::new(),
      code: Option::Some("E0405")
    })
    return Result::Err("Type check failed")
  end
  
  if opts.stop_after == StopAfter::Semantic then
    return Result::Ok(())
  end
  
  # Phase 5: MIR lowering
  if opts.verbose then
    println("  Lowering to MIR...")
  end
  
  var mir = MirProgram { functions: Vec::new(), statics: Vec::new(), types: Vec::new() }
  match driver_lower_to_mir(&ast, &typed_program)
  when Result::Ok(m) then
    mir = m
  when Result::Err(e) then
    eprintln("MIR lowering failed: " + e)
    return Result::Err("MIR lowering failed: " + e)
  end

  if opts.verbose then
  end

  # Verify MIR invariants after lowering.
  let post_lower_errs = verify_mir(&mir)
  if !post_lower_errs.is_empty() then
    for e in post_lower_errs do
      eprintln("MIR verifier (post-lower): " + e)
    end
    return Result::Err("MIR verification failed after lowering")
  end

  # `tg check` stops here: the program has been lexed, parsed, dependencies
  # resolved, macros expanded, type-checked, access-checked, lowered to MIR and
  # verified — without generating native code.
  match opts.dump_phase
  when Option::Some("mir-lowered") then
    print_mir(&mir)
    return Result::Ok(())
  when _ then ()
  end

  if opts.stop_after == StopAfter::Mir then
    return Result::Ok(())
  end

  # Phase 5.5: Monomorphization  specialize generic functions for concrete types
  if opts.verbose then
    println("  Monomorphizing generics...")
  end
  var mono_cache = mono_cache_new()
  monomorphize_program(&mut mir, &mut mono_cache)

  if opts.verbose then
  end

  # Verify MIR invariants after monomorphization.
  let post_mono_errs = verify_mir(&mir)
  if !post_mono_errs.is_empty() then
    for e in post_mono_errs do
      eprintln("MIR verifier (post-mono): " + e)
    end
    return Result::Err("MIR verification failed after monomorphization")
  end

  match opts.dump_phase
  when Option::Some("mir-mono") then
    print_mir(&mir)
    return Result::Ok(())
  when _ then ()
  end

  # Phase 5.6: MIR Optimization (gated by opt_level)
  if opts.verbose then
    println("  Optimizing MIR (O" + opts.opt_level.to_string() + ")...")
  end
  
  # PGO instrumentation: if --pgo-gen, instrument before optimization
  match opts.pgo_gen
  when Option::Some(_) then
    instrument_for_pgo(&mut mir)
  when Option::None then ()
  end
  
  # PGO-guided optimization: if --pgo-use, load profile and apply. An
  # explicitly requested profile must load; silently ignoring a failed read
  # would quietly compile without the requested optimization.
  match opts.pgo_use
  when Option::Some(profile_path) then
    match read_pgo_profile(&profile_path)
    when Result::Ok(profile) then
      apply_pgo_profile(&mut mir, &profile)
    when Result::Err(e) then
      return Result::Err("failed to read requested PGO profile '" + profile_path + "': " + e)
    end
  when Option::None then ()
  end
  
  if opts.emit_mir then
  end

  optimize_mir(&mut mir, opts.opt_level)

  if opts.verbose then
  end

  # Verify MIR invariants after optimization.
  let post_opt_errs = verify_mir(&mir)
  if !post_opt_errs.is_empty() then
    for e in post_opt_errs do
      eprintln("MIR verifier (post-opt): " + e)
    end
    return Result::Err("MIR verification failed after optimization")
  end

  if opts.emit_mir then
    print_mir(&mir)
    return Result::Ok(())
  end

  match opts.dump_phase
  when Option::Some("mir-opt") then
    print_mir(&mir)
    return Result::Ok(())
  when _ then ()
  end
  
  # Phase 6: Native code generation
  if opts.verbose then
    println("  Generating native code...")
  end
  
  let target = match opts.target_triple
  when Option::Some(triple) then parse_target_triple(triple)
  when Option::None then detect_host_target()
  end
  
  match opts.emit
  when EmitMode::Object then
    let obj_bytes = match generate_object_file(&mir, &target)
    when Result::Ok(b) then b
    when Result::Err(e) then
      println(e)
      return 1
    end
    let obj_path = get_output_path(opts, path.clone(), ".o")
    match write_file_bytes(obj_path.clone(), &obj_bytes)
    when Result::Ok(_) then
      if !file_exists(obj_path.clone()) then
        return Result::Err("Failed to materialize object file: " + obj_path)
      end
      if !opts.quiet then
        println("Object file: " + obj_path)
      end
    when Result::Err(e) then
      return Result::Err("Failed to write object file: " + e)
    end
    if opts.stop_after == StopAfter::Object then
      return Result::Ok(())
    end
  when EmitMode::Executable then
    let exe_path = get_output_path(opts, path.clone(), "")
    if file_exists(exe_path.clone()) then
      let _ = delete_file(exe_path.clone())
    end

    match generate_executable(&mir, &target, exe_path.clone())
    when Result::Ok(_) then ()
    when Result::Err(e) then
      return Result::Err("Native compilation failed: " + e)
    end
    if !opts.quiet then
      println("Compiled: " + exe_path)
    end
  when _ then ()
  end

  if opts.verbose then
    println("  Returning compile_file_core OK")
  end
  
  Result::Ok(())
end

pub def compile_file(opts: &CompilerOptions, path: String) -> Result[String, String]
  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end
  match compile_file_core(path, opts, &mut emitter)
  when Result::Ok(_) then
    Result::Ok("")
  when Result::Err(e) then
    Result::Err(e)
  end
end

pub def compile_startup_file_raw(opts: &CompilerOptions, path_arg_index: Int) -> Result[String, String]
  let path = raw_arg_copy(path_arg_index)
  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end
  match compile_file_core(path, opts, &mut emitter)
  when Result::Ok(_) then
    Result::Ok("")
  when Result::Err(e) then
    Result::Err(e)
  end
end


pub def compile_startup_entry(opts: &CompilerOptions, path: String, output_path: String) -> Int
  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end

  let source = read_file_text_direct(path.clone())
  if source.len() == 0 then
    println("Failed to read file: " + path.clone())
    return 1
  end

  if opts.verbose then
    println("  Source len=" + source.len().to_string())
  end

  let is_bootstrap_driver = is_compiler_driver_path(path.clone())
  if !is_bootstrap_driver then
    add_source(&mut emitter, path.clone(), source)
  end

  if opts.verbose then
    println("Compiling: " + path.clone())
    println("  Lexing...")
  end

  var lex = lexer_new(source, path.clone())
  let lex_result = tokenize_impl(&mut lex)
  if opts.print_tokens then
    println("Tokens:")
    for tok in lex_result.tokens do
      println("  " + token_debug(tok))
    end
  end

  if opts.verbose then
    println("  Parsing...")
  end

  let parse_out = parse(lex_result)
  let ast = parse_out.program
  let parse_diags = parse_out.diagnostics
  if diag_has_errors(&parse_diags) then
    var i = 0
    while i < parse_diags.len() do
      let d = parse_diags[i]
      println("Parse error: " + d.message)
      i = i + 1
    end
    return 1
  end

  if opts.print_ast then
    println("AST:")
    print_ast(&ast)
  end

  if opts.stop_after == StopAfter::Parse then
    return 0
  end

  let ast_with_prelude = ast
  if opts.verbose then
    let import_paths = extract_import_paths(&ast_with_prelude)
  end

  let ast = match merge_imported_deps(ast_with_prelude, include_compiler_lib: is_bootstrap_driver)
  when Result::Ok(a) then a
  when Result::Err(e) then
    println(e)
    return 1
  end

  if opts.verbose then
    println("  Expanding macros...")
  end
  var ast = expand_macros(ast)
  assign_node_ids(&mut ast)

  let skip_bootstrap_semantic_checks = should_skip_bootstrap_semantic_checks(opts, path.clone())
  if opts.verbose then
    println("  Type checking...")
  end
  var typed_program: Option[TypedProgram] = Option::None
  if skip_bootstrap_semantic_checks then
    if opts.verbose then
      println("  Skipping semantic checks during compiler bootstrap")
    end
  else
    let type_errors = match resolve_names(&ast)
    when Result::Ok(res) then
      var env = type_env_new()
      if opts.strict_resolution then
        env.strict_resolution = true
      end
      let type_result = type_check_typed(&mut env, &ast, &res)
      typed_program = Option::Some(type_result.program)
      type_result.errors
    when Result::Err(res_errors) then
      for re in res_errors do
        emit_diagnostic(&mut emitter, Diagnostic {
          level: DiagLevel::Error,
          message: re.message,
          span: Option::Some(re.span),
          notes: Vec::new(),
          suggestions: Vec::new(),
          code: Option::Some("E0405")
        })
      end
      println("Type check failed")
      return 1
    end
    for err in type_errors do
      emit_diagnostic(&mut emitter, Diagnostic {
        level: DiagLevel::Error,
        message: err.message,
        span: Option::Some(err.span),
        notes: Vec::new(),
        suggestions: Vec::new(),
        code: Option::None
      })
    end
  end

  if !skip_bootstrap_semantic_checks && has_errors(&emitter) then
    println("Type check failed")
    return 1
  end

  if opts.verbose then
    println("  Access checking...")
  end
  if !skip_bootstrap_semantic_checks then
    match typed_program
    when Option::Some(tp) then
      let access_errors = access_check(&ast, &tp)
      for err in access_errors do
        emit_diagnostic(&mut emitter, Diagnostic {
          level: DiagLevel::Error,
          message: err.message,
          span: Option::Some(err.span),
          notes: Vec::new(),
          suggestions: Vec::new(),
          code: Option::None
        })
      end
      if has_errors(&emitter) then
        println("Access check failed")
        return 1
      end
    when Option::None then ()
    end
  end

  if opts.verbose then
    println("  Resource checking...")
  end
  if !skip_bootstrap_semantic_checks then
    match typed_program
    when Option::Some(tp) then
      let resource_errors = resource_check(&ast, &tp)
      for err in resource_errors do
        emit_diagnostic(&mut emitter, Diagnostic {
          level: DiagLevel::Error,
          message: err.message,
          span: Option::Some(err.span),
          notes: Vec::new(),
          suggestions: Vec::new(),
          code: Option::None
        })
      end
      if has_errors(&emitter) then
        println("Resource check failed")
        return 1
      end
    when Option::None then ()
    end
  end

  if opts.verbose then
    println("  Lowering to MIR...")
  end
  var mir = MirProgram { functions: Vec::new(), statics: Vec::new(), types: Vec::new() }
  match driver_lower_to_mir(&ast, &typed_program)
  when Result::Ok(m) then
    mir = m
  when Result::Err(e) then
    eprintln("MIR lowering failed: " + e)
    return 1
  end

  let post_lower_errs = verify_mir(&mir)
  if !post_lower_errs.is_empty() then
    for e in post_lower_errs do
      eprintln("MIR verifier (post-lower): " + e)
    end
    println("MIR verification failed after lowering")
    return 1
  end

  if opts.verbose then
    println("  Monomorphizing generics...")
  end
  var mono_cache = mono_cache_new()
  monomorphize_program(&mut mir, &mut mono_cache)

  let post_mono_errs = verify_mir(&mir)
  if !post_mono_errs.is_empty() then
    for e in post_mono_errs do
      eprintln("MIR verifier (post-mono): " + e)
    end
    println("MIR verification failed after monomorphization")
    return 1
  end

  if opts.verbose then
    println("  Optimizing MIR (O" + opts.opt_level.to_string() + ")...")
  end
  match opts.pgo_gen
  when Option::Some(_) then
    instrument_for_pgo(&mut mir)
  when Option::None then ()
  end

  match opts.pgo_use
  when Option::Some(profile_path) then
    match read_pgo_profile(&profile_path)
    when Result::Ok(profile) then
      apply_pgo_profile(&mut mir, &profile)
    when Result::Err(e) then
      println("failed to read requested PGO profile '" + profile_path + "': " + e)
      return 1
    end
  when Option::None then ()
  end

  optimize_mir(&mut mir, opts.opt_level)

  let post_opt_errs = verify_mir(&mir)
  if !post_opt_errs.is_empty() then
    for e in post_opt_errs do
      eprintln("MIR verifier (post-opt): " + e)
    end
    println("MIR verification failed after optimization")
    return 1
  end

  if opts.emit_mir then
    print_mir(&mir)
    return 0
  end

  if opts.verbose then
    println("  Generating native code...")
  end
  let target = if skip_bootstrap_semantic_checks then
    bootstrap_codegen_target()
  else
    match opts.target_triple
    when Option::Some(triple) then parse_target_triple(triple)
    when Option::None then detect_host_target()
    end
  end

  match opts.emit
  when EmitMode::Object then
    let obj_bytes = match generate_object_file(&mir, &target)
    when Result::Ok(b) then b
    when Result::Err(e) then
      println(e)
      return 1
    end
    match write_file_bytes(output_path.clone(), &obj_bytes)
    when Result::Ok(_) then
      if !file_exists(output_path.clone()) then
        println("Failed to materialize object file: " + output_path.clone())
        return 1
      end
      if !opts.quiet then
        println("Object file: " + output_path.clone())
      end
    when Result::Err(e) then
      println("Failed to write object file: " + e)
      return 1
    end
  when EmitMode::Executable then
    if file_exists(output_path.clone()) then
      let _ = delete_file(output_path.clone())
    end

    match generate_executable(&mir, &target, output_path.clone())
    when Result::Ok(_) then ()
    when Result::Err(e) then
      println("Native compilation failed: " + e)
      return 1
    end
    # write_file_bytes already reports errors. file_exists uses raw_stat which
    # may have wrong syscall numbers on macOS AArch64. Skip the redundant check.
    if !opts.quiet then
      println("Compiled: " + output_path.clone())
    end
  when _ then ()
  end

  0
end

# Recursively load and merge imported dependency files into the program.
# This ensures function definitions from imports (e.g. println from std::io)
# are available during MIR lowering, not just type definitions.
# include_compiler_lib: when true, also preload the compiler KERNEL library
# (tg_compiler/lib_kernel.tg, the minimal bootstrap subset declared in
# bootstrap/compiler_kernel.manifest) so the compiler's internal types are
# available during type checking of the compiler's own source files. For user
# code compilation, this should be false to avoid polluting the type namespace
# with compiler internals. The full lib.tg is only for users embedding the
# complete compiler.
pub def merge_imported_deps(program: Program, include_compiler_lib: Bool = false) -> Result[Program, String]
  var loaded = Set::new()
  var merged_items = Vec::new()
  # Program items first  ensures the main program's definitions
  # (especially main) take priority over dependency definitions.
  for item in program.items do
    merged_items.push(item)
  end
  # Canonical bootstrap source list: when compiling the compiler itself
  # (include_compiler_lib), consume bootstrap/compiler_kernel.manifest exactly
  # like stage0 (sorted std files, then sorted compiler files). User programs
  # keep the normal prelude + recursive import discovery.
  let preludes = if include_compiler_lib then
    match bootstrap_manifest_sources()
    when Option::Some(files) then files
    when Option::None then prelude_files()
    end
  else
    prelude_files()
  end
  for prelude in preludes do
    match collect_dep_file(prelude, &mut merged_items, &mut loaded)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      return Result::Err(dep_error_message(e, prelude))
    end
  end
  if include_compiler_lib then
    # Bootstrap loads the KERNEL library (lib_kernel.tg), which re-exports only
    # the minimal self-hostable module set. The full lib.tg is reserved for
    # user embedding and pulls in non-bootstrap tooling modules. This keeps the
    # bootstrap compiler closure small (bootstrap/compiler_kernel.manifest).
    match collect_dep_file("tg_compiler/lib_kernel.tg", &mut merged_items, &mut loaded)
    when Result::Ok(_) then ()
    when Result::Err(e) then
      return Result::Err(dep_error_message(e, "tg_compiler/lib_kernel.tg"))
    end
  end
  match collect_dep_items(&program, &mut merged_items, &mut loaded)
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err(dep_error_message(e, "<program>"))
  end
  Result::Ok(Program { items: merged_items, span: program.span })
end

pub def build_dep_file_path(segments: &Vec[String], count: Int) -> Option[String]
  if count < 2 then
    return Option::None
  end

  let root = segments[0]
  var path = if root == "std" then
    "std/"
  elsif root == "tg_compiler" then
    "tg_compiler/"
  else
    return Option::None
  end

  var i = 0
  i = 1
  while i < count do
    if i > 1 then
      path = path + "/"
    end
    path = path + segments[i]
    i = i + 1
  end

  Option::Some(path + ".tg")
end

pub def dep_use_to_file(u: &UseDecl) -> Option[String]
  let segment_count = u.path.segments.len()
  if segment_count < 2 then
    return Option::None
  end

  # Braced and glob imports already carry the containing module path.
  match u.names
  when Option::Some(_) then
    return build_dep_file_path(&u.path.segments, segment_count)
  when Option::None then ()
  end
  if u.glob then
    return build_dep_file_path(&u.path.segments, segment_count)
  end

  match build_dep_file_path(&u.path.segments, segment_count)
  when Option::Some(full_path) then
    if file_exists(full_path.clone()) then
      return Option::Some(full_path)
    end
    if segment_count > 2 then
      match build_dep_file_path(&u.path.segments, segment_count - 1)
      when Option::Some(parent_path) then
        if file_exists(parent_path.clone()) then
          return Option::Some(parent_path)
        end
      when Option::None then ()
      end
    end
    Option::None
  when Option::None then
    Option::None
  end
end

pub def collect_dep_items(program: &Program, out: &mut Vec[Item], loaded: &mut Set[String]) -> Result[Unit, DependencyError]
  for item in program.items do
    match item.kind
    when ItemKind::ItemUse(u) then
      match dep_use_to_file(&u)
      when Option::Some(path) then
        match collect_dep_file(path, out, loaded)
        when Result::Ok(_) then ()
        when Result::Err(e) then
          return Result::Err(e)
        end
      when Option::None then ()
      end
    when _ then ()
    end
  end
  Result::Ok(())
end

pub def collect_dep_file(path: String, out: &mut Vec[Item], loaded: &mut Set[String]) -> Result[Unit, DependencyError]
  if loaded.contains(&path) then
    return Result::Ok(())
  end
  loaded.insert(path.clone())

  # Distinguish a legitimate empty module from a failed read. An empty string
  # from a non-existent/unreadable file is an error, not an empty module.
  if !file_exists(path.clone()) then
    return Result::Err(DependencyError::Read)
  end
  let source = read_file_text_direct(path)

  let tokens = tokenize(source, path.clone())
  let dep_parse = parse(tokens)
  let dep_parse_diags = dep_parse.diagnostics
  if diag_has_errors(&dep_parse_diags) then
    # Never merge a partially valid dependency into a compiler program.
    var di = 0
    while di < dep_parse_diags.len() do
      let d = dep_parse_diags[di]
      match d.span
      when Option::Some(sp) then
        eprintln("dep parse [" + path + "] @" + sp.start.to_string() + ": " + d.message)
      when Option::None then
        eprintln("dep parse [" + path + "]: " + d.message)
      end
      di = di + 1
    end
    return Result::Err(dep_error_message(DependencyError::Parse, path))
  end

  let dep_ast = dep_parse.program
  # Recurse into this dependency's own imports
  match collect_dep_items(&dep_ast, out, loaded)
  when Result::Ok(_) then ()
  when Result::Err(e) then
    return Result::Err(e)
  end
  # Add all items from this dependency
  for item in dep_ast.items do
    out.push(item)
  end
  Result::Ok(())
end

pub def get_output_path(opts: &CompilerOptions, input: String, ext: String) -> String
  match opts.output_file
  when Option::Some(out) then out
  when Option::None then
    # Replace .tg with ext
    if input.ends_with(".tg") then
      input.slice(0, input.len() - 3) + ext
    else
      input + ext
    end
  end
end

pub def token_debug(tok: Token) -> String
  tok.kind.to_string() + " @ " + tok.span.start.to_string() + ".." + tok.span.end_pos.to_string()
end

pub def print_ast(program: &Program) -> Unit
  println("Program with " + program.items.len().to_string() + " items")
  for item in program.items do
    println("  Item: " + item.kind.to_string())
  end
end

pub def print_mir(mir: &MirProgram) -> Unit
  println(pretty_print_mir(mir))
end

pub struct MacroEnv
  macros: Map[String, MacroDecl]
  # Recursion stack for hygiene (prevents infinite expansion)
  expansion_stack: Vec[String]
end

pub struct ExpandedProgram
  program: Program
  did_expand: Bool
end

pub struct ExpandedItem
  item: Item
  did_expand: Bool
end

pub struct ExpandedFunctionDecl
  func: FunctionDecl
  did_expand: Bool
end

pub struct ExpandedTraitMethod
  method: TraitMethod
  did_expand: Bool
end

pub struct ExpandedBlock
  block: Block
  did_expand: Bool
end

pub struct ExpandedStmt
  stmt: Stmt
  did_expand: Bool
end

pub struct ExpandedExpr
  expr: Expr
  did_expand: Bool
end

pub struct ExpandedExprVec
  args: Vec[Expr]
  did_expand: Bool
end

pub def expand_macros(program: Program) -> Program
  # Phase 1: collect macro declarations
  var env = MacroEnv { macros: Map::new(), expansion_stack: Vec::new() }
  for item in program.items do
    match item.kind
    when ItemKind::ItemMacro(m) then
      let key = m.name.clone()
      let val = m.clone()
      env.macros.insert(key, val)
    when _ then ()
    end
  end

  # If no macros defined, return as-is
  if env.macros.is_empty() then
    return program
  end

  # Phase 2: iteratively expand until fixpoint (max 64 passes)
  var current = program
  var pass = 0
  while pass < 64 do
    let expanded_result = expand_program_pass(&env, current)
    current = expanded_result.program
    if !expanded_result.did_expand then break end
    pass = pass + 1
  end

  # Phase 3: remove macro declarations from the output AST
  let current_span = current.span.clone()
  var filtered_items = Vec::new()
  for item in current.items do
    match item.kind
    when ItemKind::ItemMacro(_) then ()  # Drop macro defs
    when _ then filtered_items.push(item.clone())
    end
  end
  Program { items: filtered_items, span: current_span }
end

pub def expand_program_pass(env: &MacroEnv, program: Program) -> ExpandedProgram
  let program_span = program.span.clone()
  var new_items = Vec::new()
  var did_expand = false
  var i = 0
  while i < program.items.len() do
    let expanded_item = expand_item(env, program.items[i].clone())
    new_items.push(expanded_item.item)
    if expanded_item.did_expand then did_expand = true end
    i = i + 1
  end
  ExpandedProgram { program: Program { items: new_items, span: program_span }, did_expand }
end

pub def expand_item(env: &MacroEnv, item: Item) -> ExpandedItem
  match item.kind
  when ItemKind::ItemFunction(f) then
    let expanded_f = expand_function_decl(env, &f)
    ExpandedItem {
      item: Item { kind: ItemKind::ItemFunction(expanded_f.func), attrs: item.attrs.clone(), span: item.span, is_pub: item.is_pub },
      did_expand: expanded_f.did_expand
    }
  when ItemKind::ItemImpl(impl_block) then
    let impl_vis = impl_block.vis
    let impl_self_type = impl_block.self_type.clone()
    let impl_trait_name = impl_block.trait_name.clone()
    let impl_for_type = impl_block.for_type.clone()
    let impl_generic_params = impl_block.generic_params.clone()
    let impl_where_clause = impl_block.where_clause.clone()
    let impl_assoc_types = impl_block.assoc_types.clone()
    let impl_span = impl_block.span
    var new_methods = Vec::new()
    var did_expand = false
    for method in impl_block.methods do
      let expanded_method = expand_function_decl(env, &method)
      new_methods.push(expanded_method.func)
      if expanded_method.did_expand then did_expand = true end
    end
    let new_impl = ImplDecl {
      vis: impl_vis,
      self_type: impl_self_type,
      trait_name: impl_trait_name,
      for_type: impl_for_type,
      generic_params: impl_generic_params,
      where_clause: impl_where_clause,
      methods: new_methods,
      assoc_types: impl_assoc_types,
      span: impl_span
    }
    ExpandedItem {
      item: Item { kind: ItemKind::ItemImpl(new_impl), attrs: item.attrs.clone(), span: item.span, is_pub: item.is_pub },
      did_expand
    }
  when ItemKind::ItemTrait(trait_decl) then
    let trait_vis = trait_decl.vis
    let trait_name = trait_decl.name.clone()
    let trait_generic_params = trait_decl.generic_params.clone()
    let trait_super_traits = trait_decl.super_traits.clone()
    let trait_assoc_types = trait_decl.assoc_types.clone()
    let trait_span = trait_decl.span
    var new_methods = Vec::new()
    var did_expand = false
    for ti in trait_decl.methods do
      let expanded = expand_trait_method(env, ti)
      new_methods.push(expanded.method)
      if expanded.did_expand then did_expand = true end
    end
    let new_trait = TraitDecl {
      vis: trait_vis,
      name: trait_name,
      generic_params: trait_generic_params,
      super_traits: trait_super_traits,
      methods: new_methods,
      assoc_types: trait_assoc_types,
      span: trait_span
    }
    ExpandedItem {
      item: Item { kind: ItemKind::ItemTrait(new_trait), attrs: item.attrs.clone(), span: item.span, is_pub: item.is_pub },
      did_expand
    }
  when _ then ExpandedItem { item, did_expand: false }
  end
end

pub def expand_function_decl(env: &MacroEnv, f: &FunctionDecl) -> ExpandedFunctionDecl
  let f_vis = f.vis
  let f_name = f.name.clone()
  let f_generic_params = f.generic_params.clone()
  let f_params = f.params.clone()
  let f_ret_type = f.ret_type.clone()
  let f_where_clause = f.where_clause.clone()
  let f_is_async = f.is_async
  let f_is_unsafe = f.is_unsafe
  let f_is_const = f.is_const
  let f_is_inline = f.is_inline
  let f_is_pure = f.is_pure
  let f_contracts = f.contracts.clone()
  let f_budget_val = f.budget_val.clone()
  let f_required_caps = f.required_caps.clone()
  let f_effects = f.effects.clone()
  let f_span = f.span
  match f.body
  when FnBody::FnBlock(block) then
    let expanded_block = expand_block(env, &block)
    ExpandedFunctionDecl {
      func: FunctionDecl {
        vis: f_vis,
        name: f_name,
        generic_params: f_generic_params,
        params: f_params,
        ret_type: f_ret_type,
        where_clause: f_where_clause,
        body: FnBody::FnBlock(expanded_block.block),
        is_async: f_is_async,
        is_unsafe: f_is_unsafe,
        is_const: f_is_const,
        is_inline: f_is_inline,
        is_pure: f_is_pure,
        contracts: f_contracts,
        budget_val: f_budget_val,
        required_caps: f_required_caps,
        effects: f_effects,
        span: f_span
      },
      did_expand: expanded_block.did_expand
    }
  when _ then
    ExpandedFunctionDecl {
      func: FunctionDecl {
        vis: f_vis,
        name: f_name,
        generic_params: f_generic_params,
        params: f_params,
        ret_type: f_ret_type,
        where_clause: f_where_clause,
        body: f.body.clone(),
        is_async: f_is_async,
        is_unsafe: f_is_unsafe,
        is_const: f_is_const,
        is_inline: f_is_inline,
        is_pure: f_is_pure,
        contracts: f_contracts,
        budget_val: f_budget_val,
        required_caps: f_required_caps,
        effects: f_effects,
        span: f_span
      },
      did_expand: false
    }
  end
end

pub def expand_trait_method(env: &MacroEnv, method: TraitMethod) -> ExpandedTraitMethod
  ExpandedTraitMethod { method, did_expand: false }
end

pub def expand_block(env: &MacroEnv, block: &Block) -> ExpandedBlock
  let block_span = block.span
  var new_stmts = Vec::new()
  var did_expand = false
  var i = 0
  while i < block.stmts.len() do
    let expanded_stmt = expand_stmt(env, &block.stmts[i])
    new_stmts.push(expanded_stmt.stmt)
    if expanded_stmt.did_expand then did_expand = true end
    i = i + 1
  end
  ExpandedBlock { block: Block { stmts: new_stmts, span: block_span }, did_expand }
end

pub def expand_stmt(env: &MacroEnv, stmt: &Stmt) -> ExpandedStmt
  match stmt.kind
  when StmtKind::StmtExpr(expr) then
    let expanded_expr = expand_expr(env, &expr)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtExpr(expanded_expr.expr), span: stmt.span, node_id: 0 },
      did_expand: expanded_expr.did_expand
    }
  when StmtKind::StmtLet(pat, ty, init, is_mut) then
    let expanded_expr = expand_expr(env, &init)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtLet(pat.clone(), ty.clone(), expanded_expr.expr, is_mut), span: stmt.span, node_id: 0 },
      did_expand: expanded_expr.did_expand
    }
  when StmtKind::StmtAssign(target, value) then
    let et = expand_expr(env, &target)
    let ev = expand_expr(env, &value)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtAssign(et.expr, ev.expr), span: stmt.span, node_id: 0 },
      did_expand: et.did_expand || ev.did_expand
    }
  when StmtKind::StmtCompoundAssign(op, target, value) then
    let et = expand_expr(env, &target)
    let ev = expand_expr(env, &value)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtCompoundAssign(op, et.expr, ev.expr), span: stmt.span, node_id: 0 },
      did_expand: et.did_expand || ev.did_expand
    }
  when StmtKind::StmtIf(if_stmt) then
    let ec = expand_expr(env, &if_stmt.cond)
    let eb = expand_block(env, &if_stmt.then_block)
    let did = ec.did_expand || eb.did_expand
    let new_if = IfStmt {
      cond: ec.expr,
      then_block: eb.block,
      elsif_branches: if_stmt.elsif_branches.clone(),
      else_block: if_stmt.else_block.clone(),
      span: if_stmt.span
    }
    ExpandedStmt { stmt: Stmt { kind: StmtKind::StmtIf(new_if), span: stmt.span, node_id: 0 }, did_expand: did }
  when StmtKind::StmtWhile(cond, body) then
    let ec = expand_expr(env, &cond)
    let eb = expand_block(env, &body)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtWhile(ec.expr, eb.block), span: stmt.span, node_id: 0 },
      did_expand: ec.did_expand || eb.did_expand
    }
  when StmtKind::StmtFor(_) then
    ExpandedStmt { stmt: stmt.clone(), did_expand: false }
  when StmtKind::StmtLoop(body) then
    let eb = expand_block(env, &body)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtLoop(eb.block), span: stmt.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when StmtKind::StmtReturn(opt_expr) then
    match opt_expr
    when Option::Some(expr) then
      let ee = expand_expr(env, &expr)
      ExpandedStmt {
        stmt: Stmt { kind: StmtKind::StmtReturn(Option::Some(ee.expr)), span: stmt.span, node_id: 0 },
        did_expand: ee.did_expand
      }
    when Option::None then ExpandedStmt { stmt: stmt.clone(), did_expand: false }
    end
  when StmtKind::StmtUnsafe(reason, body) then
    let eb = expand_block(env, &body)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtUnsafe(reason.clone(), eb.block), span: stmt.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when StmtKind::StmtDefer(body) then
    let eb = expand_block(env, &body)
    ExpandedStmt {
      stmt: Stmt { kind: StmtKind::StmtDefer(eb.block), span: stmt.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when _ then ExpandedStmt { stmt: stmt.clone(), did_expand: false }
  end
end

pub def expand_exprs(env: &MacroEnv, args: &Vec[Expr]) -> ExpandedExprVec
  var new_args = Vec::new()
  var did_expand = false
  var i = 0
  while i < args.len() do
    let expanded_arg = expand_expr(env, &args[i])
    new_args.push(expanded_arg.expr)
    if expanded_arg.did_expand then did_expand = true end
    i = i + 1
  end
  ExpandedExprVec { args: new_args, did_expand }
end

pub def is_vec_like_from_path(path: &AstPath) -> Bool
  if path.segments.len() < 2 then
    return false
  end
  let method = path.segments[path.segments.len() - 1]
  let owner = path.segments[path.segments.len() - 2]
  method == "from" && (owner == "Vec" || owner == "Array")
end

pub def expand_vec_like_from_array(path: &AstPath, elems: &Vec[Expr], span: &Span) -> Expr
  var new_segments = Vec::new()
  for segment in path.segments do
    new_segments.push(segment.clone())
  end
  new_segments[new_segments.len() - 1] = "new".to_string()

  let temp_name = "__tg_vec_from_" + span.start.to_string() + "_" + span.end_pos.to_string()
  let new_path = make_path(new_segments, span.clone())
  let new_callee = make_expr(ExprKind::ExprPath(new_path), span.clone())
  let new_call = make_expr(ExprKind::ExprCall(Box::new(new_callee), Vec::new()), span.clone())
  let temp_pat = make_pattern(PatternKind::Ident(temp_name.clone(), true), span.clone())

  var stmts = Vec::new()
  stmts.push(make_stmt(StmtKind::StmtLet(temp_pat, Option::None, new_call, true), span.clone()))

  for elem in elems do
    let receiver = make_expr(ExprKind::ExprIdent(temp_name.clone()), span.clone())
    var push_args = Vec::new()
    push_args.push(elem.clone())
    let push_call = make_expr(
      ExprKind::ExprMethodCall(Box::new(receiver), "push".to_string(), Vec::new(), push_args),
      span.clone()
    )
    stmts.push(make_stmt(StmtKind::StmtExpr(push_call), span.clone()))
  end

  let result_expr = make_expr(ExprKind::ExprIdent(temp_name), span.clone())
  stmts.push(make_stmt(StmtKind::StmtExpr(result_expr), span.clone()))
  make_expr(ExprKind::ExprBlock(make_block(stmts, span.clone())), span.clone())
end

pub def expand_expr(env: &MacroEnv, expr: &Expr) -> ExpandedExpr
  match expr.kind
  when ExprKind::ExprCall(callee, args) then
    ## Check if callee is a path that matches a macro name
    match callee.kind
    when ExprKind::ExprPath(path) then
      let ea = expand_exprs(env, &args)
      if is_vec_like_from_path(&path) && ea.args.len() == 1 then
        match ea.args[0].kind
        when ExprKind::ExprArrayLit(elems) then
          return ExpandedExpr {
            expr: expand_vec_like_from_array(&path, &elems, &expr.span),
            did_expand: true
          }
        when _ then ()
        end
      end
      let name = path_to_name(&path)
      match env.macros.get(&name)
      when Option::Some(macro_decl) then
        if env.expansion_stack.contains(&name) then
          ExpandedExpr {
            expr: Expr { kind: ExprKind::ExprError("recursive macro invocation: '" + name.clone() + "'"), span: expr.span, node_id: 0 },
            did_expand: false
          }
        else
          env.expansion_stack.push(name.clone())
          let expanded = instantiate_macro(macro_decl, &args, &expr.span)
          env.expansion_stack.pop()
          ExpandedExpr { expr: expanded, did_expand: true }
        end
      when Option::None then
        ## Not a macro  expand arguments recursively
        let ec = expand_expr(env, &callee)
        ExpandedExpr {
          expr: Expr { kind: ExprKind::ExprCall(Box::new(ec.expr), ea.args), span: expr.span, node_id: 0 },
          did_expand: ec.did_expand || ea.did_expand
        }
      end
    when _ then
      let ea = expand_exprs(env, &args)
      let ec = expand_expr(env, &callee)
      ExpandedExpr {
        expr: Expr { kind: ExprKind::ExprCall(Box::new(ec.expr), ea.args), span: expr.span, node_id: 0 },
        did_expand: ec.did_expand || ea.did_expand
      }
    end
  when ExprKind::ExprMacroCall(name, args) then
    match env.macros.get(&name)
    when Option::Some(macro_decl) then
      if env.expansion_stack.contains(&name) then
        ExpandedExpr {
          expr: Expr { kind: ExprKind::ExprError("recursive macro invocation: '" + name.clone() + "'"), span: expr.span, node_id: 0 },
          did_expand: false
        }
      else
        env.expansion_stack.push(name.clone())
        let expanded = instantiate_macro(macro_decl, &args, &expr.span)
        env.expansion_stack.pop()
        ExpandedExpr { expr: expanded, did_expand: true }
      end
    when Option::None then
      let ea = expand_exprs(env, &args)
      ExpandedExpr {
        expr: Expr { kind: ExprKind::ExprMacroCall(name.clone(), ea.args), span: expr.span, node_id: 0 },
        did_expand: ea.did_expand
      }
    end
  when ExprKind::ExprBlock(block) then
    let expanded_block = expand_block(env, &block)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprBlock(expanded_block.block), span: expr.span, node_id: 0 },
      did_expand: expanded_block.did_expand
    }
  when ExprKind::ExprIf(if_expr) then
    let expanded_cond = expand_expr(env, &if_expr.cond)
    let expanded_then = expand_block(env, &if_expr.then_block)
    let expanded = expanded_cond.did_expand || expanded_then.did_expand
    let new_if = IfStmt {
      cond: expanded_cond.expr,
      then_block: expanded_then.block,
      elsif_branches: if_expr.elsif_branches.clone(),
      else_block: if_expr.else_block.clone(),
      span: if_expr.span
    }
    ExpandedExpr { expr: Expr { kind: ExprKind::ExprIf(new_if), span: expr.span, node_id: 0 }, did_expand: expanded }
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    let el = expand_expr(env, &lhs)
    let er = expand_expr(env, &rhs)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprBinaryOp(op, Box::new(el.expr), Box::new(er.expr)), span: expr.span, node_id: 0 },
      did_expand: el.did_expand || er.did_expand
    }
  when ExprKind::ExprUnaryOp(op, operand) then
    let eo = expand_expr(env, &operand)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprUnaryOp(op, Box::new(eo.expr)), span: expr.span, node_id: 0 },
      did_expand: eo.did_expand
    }
  when ExprKind::ExprMethodCall(receiver, method, targs, args) then
    let er = expand_expr(env, &receiver)
    let ea = expand_exprs(env, &args)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprMethodCall(Box::new(er.expr), method.clone(), targs.clone(), ea.args), span: expr.span, node_id: 0 },
      did_expand: er.did_expand || ea.did_expand
    }
  when ExprKind::ExprFieldAccess(obj, field) then
    let eo = expand_expr(env, &obj)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprFieldAccess(Box::new(eo.expr), field.clone()), span: expr.span, node_id: 0 },
      did_expand: eo.did_expand
    }
  when ExprKind::ExprIndex(obj, idx) then
    let eo = expand_expr(env, &obj)
    let ei = expand_expr(env, &idx)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprIndex(Box::new(eo.expr), Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: eo.did_expand || ei.did_expand
    }
  when ExprKind::ExprArrayLit(elems) then
    let ea = expand_exprs(env, &elems)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprArrayLit(ea.args), span: expr.span, node_id: 0 },
      did_expand: ea.did_expand
    }
  when ExprKind::ExprTupleLit(elems) then
    let ea = expand_exprs(env, &elems)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprTupleLit(ea.args), span: expr.span, node_id: 0 },
      did_expand: ea.did_expand
    }
  when ExprKind::ExprStructLit(path, fields) then
    var new_fields = Vec::new()
    var did_expand = false
    for (field_name, field_value) in fields do
      let expanded_field = expand_expr(env, &field_value)
      new_fields.push((field_name.clone(), expanded_field.expr))
      if expanded_field.did_expand then did_expand = true end
    end
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprStructLit(path.clone(), new_fields), span: expr.span, node_id: 0 },
      did_expand
    }
  when ExprKind::ExprMapLit(entries) then
    var new_entries = Vec::new()
    var did_expand = false
    for (key_expr, value_expr) in entries do
      let ek = expand_expr(env, &key_expr)
      let ev = expand_expr(env, &value_expr)
      new_entries.push((ek.expr, ev.expr))
      if ek.did_expand || ev.did_expand then did_expand = true end
    end
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprMapLit(new_entries), span: expr.span, node_id: 0 },
      did_expand
    }
  when ExprKind::ExprAccess(inner) then
    let ei = expand_expr(env, &inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAccess(Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprRawDeref(inner) then
    let ei = expand_expr(env, &inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprRawDeref(Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprClosure(params, ret_ty, body) then
    let eb = expand_expr(env, &body)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprClosure(params.clone(), ret_ty.clone(), Box::new(eb.expr)), span: expr.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprMatch(match_expr) then
    let es = expand_expr(env, &match_expr.scrutinee)
    var new_arms = Vec::new()
    var did_expand = es.did_expand
    for arm in match_expr.arms do
      let new_guard = match arm.guard_expr
      when Option::Some(guard_expr) then
        let eg = expand_expr(env, &guard_expr)
        if eg.did_expand then did_expand = true end
        Option::Some(eg.expr)
      when Option::None then
        Option::None
      end
      let eb = expand_block(env, &arm.body)
      if eb.did_expand then did_expand = true end
      new_arms.push(MatchArm {
        pattern: arm.pattern.clone(),
        guard_expr: new_guard,
        body: eb.block,
        span: arm.span
      })
    end
    ExpandedExpr {
      expr: Expr { node_id: 0, kind: ExprKind::ExprMatch(MatchExpr {
        scrutinee: es.expr,
        arms: new_arms,
        span: match_expr.span
      }), span: expr.span },
      did_expand
    }
  when ExprKind::ExprUnsafe(reason, block) then
    let eb = expand_block(env, &block)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprUnsafe(reason.clone(), eb.block), span: expr.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprAwait(inner) then
    let ei = expand_expr(env, &inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAwait(Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprTry(inner) then
    let ei = expand_expr(env, &inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprTry(Box::new(ei.expr)), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprRange(start_expr, end_expr, inclusive) then
    let new_start = match start_expr
    when Option::Some(start) then
      let es = expand_expr(env, &start)
      Option::Some(Box::new(es.expr))
    when Option::None then
      Option::None
    end
    let new_end = match end_expr
    when Option::Some(end_expr_inner) then
      let ee = expand_expr(env, &end_expr_inner)
      Option::Some(Box::new(ee.expr))
    when Option::None then
      Option::None
    end
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprRange(new_start, new_end, inclusive), span: expr.span, node_id: 0 },
      did_expand: false
    }
  when ExprKind::ExprAssign(target, value) then
    let et = expand_expr(env, &target)
    let ev = expand_expr(env, &value)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAssign(Box::new(et.expr), Box::new(ev.expr)), span: expr.span, node_id: 0 },
      did_expand: et.did_expand || ev.did_expand
    }
  when ExprKind::ExprPipe(lhs, rhs) then
    let el = expand_expr(env, &lhs)
    let er = expand_expr(env, &rhs)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprPipe(Box::new(el.expr), Box::new(er.expr)), span: expr.span, node_id: 0 },
      did_expand: el.did_expand || er.did_expand
    }
  when ExprKind::ExprCast(inner, ty) then
    let ei = expand_expr(env, &inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprCast(Box::new(ei.expr), ty.clone()), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprTypeCheck(inner, ty) then
    let ei = expand_expr(env, &inner)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprTypeCheck(Box::new(ei.expr), ty.clone()), span: expr.span, node_id: 0 },
      did_expand: ei.did_expand
    }
  when ExprKind::ExprAsync(block) then
    let eb = expand_block(env, &block)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprAsync(eb.block), span: expr.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when ExprKind::ExprComptime(block) then
    let eb = expand_block(env, &block)
    ExpandedExpr {
      expr: Expr { kind: ExprKind::ExprComptime(eb.block), span: expr.span, node_id: 0 },
      did_expand: eb.did_expand
    }
  when _ then ExpandedExpr { expr: expr.clone(), did_expand: false }
  end
end

pub def instantiate_macro(macro_decl: &MacroDecl, args: &Vec[Expr], call_span: &Span) -> Expr
  # Validate argument count matches parameter count
  if args.len() != macro_decl.params.len() then
    # Return an error expression - type checker will catch this
    return Expr { node_id: 0, kind: ExprKind::ExprError("macro '" + macro_decl.name.clone() + "' expects " +
      macro_decl.params.len().to_string() + " arguments, got " + args.len().to_string()),
      span: call_span.clone() }
  end

  # Build substitution map: param_name  argument expression
  var subst_map: Map[String, Expr] = Map::new()
  var i = 0
  while i < macro_decl.params.len() do
    subst_map.insert(macro_decl.params[i].name.clone(), args[i].clone())
    i = i + 1
  end

  # Clone the macro body and substitute identifiers matching parameter names
  let substituted_block = substitute_block(&subst_map, &macro_decl.body)

  # Wrap the block as a block expression
  Expr { kind: ExprKind::ExprBlock(substituted_block), span: call_span.clone(), node_id: 0 }
end

pub def substitute_block(subst: &Map[String, Expr], block: &Block) -> Block
  var new_stmts = Vec::new()
  var i = 0
  while i < block.stmts.len() do
    new_stmts.push(substitute_stmt(subst, &block.stmts[i]))
    i = i + 1
  end
  Block { stmts: new_stmts, span: block.span }
end

pub def substitute_stmt(subst: &Map[String, Expr], stmt: &Stmt) -> Stmt
  match stmt.kind
  when StmtKind::StmtExpr(expr) then
    Stmt { kind: StmtKind::StmtExpr(substitute_expr(subst, &expr)), span: stmt.span, node_id: 0 }
  when StmtKind::StmtLet(pat, ty, init, is_mut) then
    let new_init = substitute_expr(subst, &init)
    Stmt { kind: StmtKind::StmtLet(pat.clone(), ty.clone(), new_init, is_mut), span: stmt.span, node_id: 0 }
  when _ then stmt.clone()
  end
end

pub def substitute_expr(subst: &Map[String, Expr], expr: &Expr) -> Expr
  match expr.kind
  when ExprKind::ExprPath(path) then
    let name = path_to_name(&path)
    match subst.get(&name)
    when Option::Some(replacement) then replacement.clone()
    when Option::None then expr.clone()
    end
  when ExprKind::ExprIdent(name) then
    match subst.get(&name)
    when Option::Some(replacement) then replacement.clone()
    when Option::None then expr.clone()
    end
  when ExprKind::ExprCall(callee, args) then
    let new_callee = substitute_expr(subst, &callee)
    var new_args = Vec::new()
    var i = 0
    while i < args.len() do
      new_args.push(substitute_expr(subst, &args[i]))
      i = i + 1
    end
    Expr { kind: ExprKind::ExprCall(Box::new(new_callee), new_args), span: expr.span, node_id: 0 }
  when ExprKind::ExprBinaryOp(op, lhs, rhs) then
    Expr { kind: ExprKind::ExprBinaryOp(op, Box::new(substitute_expr(subst, &lhs)), Box::new(substitute_expr(subst, &rhs))), span: expr.span, node_id: 0 }
  when ExprKind::ExprUnaryOp(op, operand) then
    Expr { kind: ExprKind::ExprUnaryOp(op, Box::new(substitute_expr(subst, &operand))), span: expr.span, node_id: 0 }
  when ExprKind::ExprBlock(block) then
    Expr { kind: ExprKind::ExprBlock(substitute_block(subst, &block)), span: expr.span, node_id: 0 }
  when ExprKind::ExprMethodCall(receiver, method, targs, args) then
    let new_recv = substitute_expr(subst, &receiver)
    var new_args = Vec::new()
    var i = 0
    while i < args.len() do
      new_args.push(substitute_expr(subst, &args[i]))
      i = i + 1
    end
    Expr { kind: ExprKind::ExprMethodCall(Box::new(new_recv), method.clone(), targs.clone(), new_args), span: expr.span, node_id: 0 }
  when ExprKind::ExprEnumVariant(path, args) then
    var new_args = Vec::new()
    for arg in args do
      new_args.push(substitute_expr(subst, &arg))
    end
    Expr { kind: ExprKind::ExprEnumVariant(path.clone(), new_args), span: expr.span, node_id: 0 }
  when ExprKind::ExprFieldAccess(obj, field) then
    Expr { kind: ExprKind::ExprFieldAccess(Box::new(substitute_expr(subst, &obj)), field.clone()), span: expr.span, node_id: 0 }
  when ExprKind::ExprIndex(obj, idx) then
    Expr { kind: ExprKind::ExprIndex(Box::new(substitute_expr(subst, &obj)), Box::new(substitute_expr(subst, &idx))), span: expr.span, node_id: 0 }
  when ExprKind::ExprArrayLit(elems) then
    var new_elems = Vec::new()
    for e in elems do new_elems.push(substitute_expr(subst, &e)) end
    Expr { kind: ExprKind::ExprArrayLit(new_elems), span: expr.span, node_id: 0 }
  when ExprKind::ExprTupleLit(elems) then
    var new_elems = Vec::new()
    for e in elems do new_elems.push(substitute_expr(subst, &e)) end
    Expr { kind: ExprKind::ExprTupleLit(new_elems), span: expr.span, node_id: 0 }
  when ExprKind::ExprStructLit(path, fields) then
    var new_fields = Vec::new()
    for (field_name, field_value) in fields do
      new_fields.push((field_name.clone(), substitute_expr(subst, &field_value)))
    end
    Expr { kind: ExprKind::ExprStructLit(path.clone(), new_fields), span: expr.span, node_id: 0 }
  when ExprKind::ExprMapLit(entries) then
    var new_entries = Vec::new()
    for (key_expr, value_expr) in entries do
      new_entries.push((substitute_expr(subst, &key_expr), substitute_expr(subst, &value_expr)))
    end
    Expr { kind: ExprKind::ExprMapLit(new_entries), span: expr.span, node_id: 0 }
  when ExprKind::ExprAccess(inner) then
    Expr { kind: ExprKind::ExprAccess(Box::new(substitute_expr(subst, &inner))), span: expr.span, node_id: 0 }
  when ExprKind::ExprRawDeref(inner) then
    Expr { kind: ExprKind::ExprRawDeref(Box::new(substitute_expr(subst, &inner))), span: expr.span, node_id: 0 }
  when ExprKind::ExprAwait(inner) then
    Expr { kind: ExprKind::ExprAwait(Box::new(substitute_expr(subst, &inner))), span: expr.span, node_id: 0 }
  when ExprKind::ExprTry(inner) then
    Expr { kind: ExprKind::ExprTry(Box::new(substitute_expr(subst, &inner))), span: expr.span, node_id: 0 }
  when ExprKind::ExprRange(start_expr, end_expr, inclusive) then
    let new_start = match start_expr
    when Option::Some(start) then Option::Some(Box::new(substitute_expr(subst, &start)))
    when Option::None then Option::None
    end
    let new_end = match end_expr
    when Option::Some(end_expr_inner) then Option::Some(Box::new(substitute_expr(subst, &end_expr_inner)))
    when Option::None then Option::None
    end
    Expr { kind: ExprKind::ExprRange(new_start, new_end, inclusive), span: expr.span, node_id: 0 }
  when ExprKind::ExprCast(inner, ty) then
    Expr { kind: ExprKind::ExprCast(Box::new(substitute_expr(subst, &inner)), ty.clone()), span: expr.span, node_id: 0 }
  when ExprKind::ExprTypeCheck(inner, ty) then
    Expr { kind: ExprKind::ExprTypeCheck(Box::new(substitute_expr(subst, &inner)), ty.clone()), span: expr.span, node_id: 0 }
  when ExprKind::ExprAssign(target, value) then
    Expr { kind: ExprKind::ExprAssign(Box::new(substitute_expr(subst, &target)), Box::new(substitute_expr(subst, &value))), span: expr.span, node_id: 0 }
  when ExprKind::ExprPipe(lhs, rhs) then
    Expr { kind: ExprKind::ExprPipe(Box::new(substitute_expr(subst, &lhs)), Box::new(substitute_expr(subst, &rhs))), span: expr.span, node_id: 0 }
  when ExprKind::ExprIf(if_expr) then
    let new_cond = substitute_expr(subst, &if_expr.cond)
    let new_then = substitute_block(subst, &if_expr.then_block)
    let new_if = IfStmt {
      cond: new_cond,
      then_block: new_then,
      elsif_branches: if_expr.elsif_branches.clone(),
      else_block: if_expr.else_block.clone(),
      span: if_expr.span
    }
    Expr { kind: ExprKind::ExprIf(new_if), span: expr.span, node_id: 0 }
  when ExprKind::ExprUnsafe(reason, block) then
    Expr { kind: ExprKind::ExprUnsafe(reason.clone(), substitute_block(subst, &block)), span: expr.span, node_id: 0 }
  when ExprKind::ExprMatch(match_expr) then
    var new_arms = Vec::new()
    for arm in match_expr.arms do
      let new_guard = match arm.guard_expr
      when Option::Some(guard_expr) then Option::Some(substitute_expr(subst, &guard_expr))
      when Option::None then Option::None
      end
      new_arms.push(MatchArm {
        pattern: arm.pattern.clone(),
        guard_expr: new_guard,
        body: substitute_block(subst, &arm.body),
        span: arm.span
      })
    end
    Expr { node_id: 0, kind: ExprKind::ExprMatch(MatchExpr {
      scrutinee: substitute_expr(subst, &match_expr.scrutinee),
      arms: new_arms,
      span: match_expr.span
    }), span: expr.span }
  when ExprKind::ExprClosure(params, ret_ty, body) then
    Expr { kind: ExprKind::ExprClosure(params.clone(), ret_ty.clone(), Box::new(substitute_expr(subst, &body))), span: expr.span, node_id: 0 }
  when _ then expr.clone()
  end
end

pub def path_to_name(path: &AstPath) -> String
  # Simple: use the last segment name
  if path.segments.is_empty() then
    "".to_string()
  else
    path.segments[path.segments.len() - 1].clone()
  end
end

# Compile multiple source files by merging their ASTs into a single program.
# Each file is read, lexed, and parsed independently, then their items are
# concatenated into one Program before going through merge_imported_deps,
# MIR lowering, optimization, and code generation.
pub def compile_multiple_files(opts: &CompilerOptions, files: Vec[String], output_path: String) -> Int
  var emitter = if opts.json_diagnostics then
    emitter_new_json()
  else
    var e = emitter_new()
    e.color_enabled = opts.color
    e
  end

  let is_bootstrap_driver = files.len() == 1 && is_compiler_driver_path(files[0].clone())
  # Stage outputs are executables, not source programs. Their filename never
  # alters frontend correctness, so semantic checks are never skipped here.
  let skip_bootstrap_semantic_checks = false
  var all_items: Vec[Item] = Vec::new()

  if opts.verbose then
    println("Compiling " + files.len().to_string() + " files...")
  end

  var fi = 0
  while fi < files.len() do
    let path = files[fi].clone()
    if opts.verbose then
      println("  Reading: " + path.clone())
    end

    let source = read_file_text_direct(path.clone())
    if source.len() == 0 then
      println("Failed to read file: " + path.clone())
      return 1
    end

    if opts.verbose then
      println("  Lexing: " + path.clone())
    end
    var lex = lexer_new(source, path.clone())
    let lex_result = tokenize_impl(&mut lex)

    if opts.verbose then
      println("  Parsing: " + path.clone())
    end
    let parse_out = parse(lex_result)
    let ast = parse_out.program
    let parse_diags = parse_out.diagnostics
    if diag_has_errors(&parse_diags) then
      println("Parse error in " + path.clone())
      for d in parse_diags do
        let pos_info = match d.span
        when Option::Some(s) then " at offset " + s.start.to_string()
        when Option::None then ""
        end
        println("  " + d.message + pos_info)
      end
      return 1
    end

    # Merge items from this file
    var ii = 0
    while ii < ast.items.len() do
      all_items.push(ast.items[ii])
      ii = ii + 1
    end
    fi = fi + 1
  end

  # Create merged AST spanning all files (use span of first file as reference)
  if all_items.len() == 0 then
    println("No valid items found in input files")
    return 1
  end
  let merged_ast = Program { items: all_items, span: all_items[0].span }

  # ── pipeline from merge_imported_deps through codegen ─────────
  if opts.verbose then
    println("  Merging imported dependencies...")
  end
  let ast = match merge_imported_deps(merged_ast, include_compiler_lib: is_bootstrap_driver)
  when Result::Ok(a) then a
  when Result::Err(e) then
    println(e)
    return 1
  end

  if opts.verbose then
    println("  Expanding macros...")
  end
  var ast = expand_macros(ast)
  assign_node_ids(&mut ast)

  if opts.verbose then
    println("  Type checking...")
  end
  var typed_program: Option[TypedProgram] = Option::None
  if !skip_bootstrap_semantic_checks then
    let type_errors = match resolve_names(&ast)
    when Result::Ok(res) then
      var env = type_env_new()
      if opts.strict_resolution then
        env.strict_resolution = true
      end
      let type_result = type_check_typed(&mut env, &ast, &res)
      typed_program = Option::Some(type_result.program)
      type_result.errors
    when Result::Err(res_errors) then
      for re in res_errors do
        emit_diagnostic(&mut emitter, Diagnostic {
          level: DiagLevel::Error,
          message: re.message,
          span: Option::Some(re.span),
          notes: Vec::new(),
          suggestions: Vec::new(),
          code: Option::Some("E0405")
        })
      end
      println("Type check failed")
      return 1
    end
    for err in type_errors do
      emit_diagnostic(&mut emitter, Diagnostic {
        level: DiagLevel::Error,
        message: err.message,
        span: Option::Some(err.span),
        notes: Vec::new(),
        suggestions: Vec::new(),
        code: Option::None
      })
    end
  end

  if !skip_bootstrap_semantic_checks && has_errors(&emitter) then
    println("Type check failed")
    return 1
  end

  if opts.verbose then
    println("  Access checking...")
  end
  if !skip_bootstrap_semantic_checks then
    match typed_program
    when Option::Some(tp) then
      let access_errors = access_check(&ast, &tp)
      for err in access_errors do
        emit_diagnostic(&mut emitter, Diagnostic {
          level: DiagLevel::Error,
          message: err.message,
          span: Option::Some(err.span),
          notes: Vec::new(),
          suggestions: Vec::new(),
          code: Option::None
        })
      end
      if has_errors(&emitter) then
        println("Access check failed")
        return 1
      end
    when Option::None then ()
    end
  end

  if opts.verbose then
    println("  Resource checking...")
  end
  if !skip_bootstrap_semantic_checks then
    match typed_program
    when Option::Some(tp) then
      let resource_errors = resource_check(&ast, &tp)
      for err in resource_errors do
        emit_diagnostic(&mut emitter, Diagnostic {
          level: DiagLevel::Error,
          message: err.message,
          span: Option::Some(err.span),
          notes: Vec::new(),
          suggestions: Vec::new(),
          code: Option::None
        })
      end
      if has_errors(&emitter) then
        println("Resource check failed")
        return 1
      end
    when Option::None then ()
    end
  end

  if opts.verbose then
    println("  Lowering to MIR...")
  end
  var mir = MirProgram { functions: Vec::new(), statics: Vec::new(), types: Vec::new() }
  match driver_lower_to_mir(&ast, &typed_program)
  when Result::Ok(m) then
    mir = m
  when Result::Err(e) then
    eprintln("MIR lowering failed: " + e)
    return 1
  end

  let post_lower_errs = verify_mir(&mir)
  if !post_lower_errs.is_empty() then
    for e in post_lower_errs do
      eprintln("MIR verifier (post-lower): " + e)
    end
    println("MIR verification failed after lowering")
    return 1
  end

  if opts.verbose then
    println("  Monomorphizing generics...")
  end
  var mono_cache = mono_cache_new()
  monomorphize_program(&mut mir, &mut mono_cache)

  let post_mono_errs = verify_mir(&mir)
  if !post_mono_errs.is_empty() then
    for e in post_mono_errs do
      eprintln("MIR verifier (post-mono): " + e)
    end
    println("MIR verification failed after monomorphization")
    return 1
  end

  if opts.verbose then
    println("  Optimizing MIR (O" + opts.opt_level.to_string() + ")...")
  end
  match opts.pgo_gen
  when Option::Some(_) then
    instrument_for_pgo(&mut mir)
  when Option::None then ()
  end
  match opts.pgo_use
  when Option::Some(profile_path) then
    match read_pgo_profile(&profile_path)
    when Result::Ok(profile) then
      apply_pgo_profile(&mut mir, &profile)
    when Result::Err(e) then ()
    end
  when Option::None then ()
  end
  optimize_mir(&mut mir, opts.opt_level)

  let post_opt_errs = verify_mir(&mir)
  if !post_opt_errs.is_empty() then
    for e in post_opt_errs do
      eprintln("MIR verifier (post-opt): " + e)
    end
    println("MIR verification failed after optimization")
    return 1
  end

  if opts.emit_mir then
    print_mir(&mir)
    return 0
  end

  if opts.verbose then
    println("  Generating native code...")
  end
  let target = if skip_bootstrap_semantic_checks then
    bootstrap_codegen_target()
  else
    match opts.target_triple
    when Option::Some(triple) then parse_target_triple(triple)
    when Option::None then detect_host_target()
    end
  end

  match opts.emit
  when EmitMode::Object then
    let obj_bytes = match generate_object_file(&mir, &target)
    when Result::Ok(b) then b
    when Result::Err(e) then
      println(e)
      return 1
    end
    match write_file_bytes(output_path.clone(), &obj_bytes)
    when Result::Ok(_) then
      if !file_exists(output_path.clone()) then
        println("Failed to materialize object file: " + output_path.clone())
        return 1
      end
      if !opts.quiet then
        println("Object file: " + output_path.clone())
      end
    when Result::Err(e) then
      println("Failed to write object file: " + e)
      return 1
    end
  when EmitMode::Executable then
    if file_exists(output_path.clone()) then
      let _ = delete_file(output_path.clone())
    end
    match generate_executable(&mir, &target, output_path.clone())
    when Result::Ok(_) then ()
    when Result::Err(e) then
      println("Native compilation failed: " + e)
      return 1
    end
    if !opts.quiet then
      println("Compiled: " + output_path.clone())
    end
  when _ then ()
  end

  0
end

# 
# Standard Library Prelude
# 

# Read bootstrap/compiler_kernel.manifest and return the canonical ordered
# source list: sorted std files, then sorted compiler files — the exact same
# order the Swift stage0 consumes. Returns None when the manifest is absent.
pub def bootstrap_manifest_sources() -> Option[Vec[String]]
  if !file_exists("bootstrap/compiler_kernel.manifest") then
    return Option::None
  end
  let text = read_file_text_direct("bootstrap/compiler_kernel.manifest")
  let lines = text.split("\n")
  var std_files = Vec::new()
  var compiler_files = Vec::new()
  var li = 0
  while li < lines.len() do
    let line = lines[li].trim()
    if line.len() == 0 || line.starts_with("#") then
      li = li + 1
      next
    end
    let colon = line.index_of(":")
    if colon < 0 then
      li = li + 1
      next
    end
    let key = line.slice(0, colon).trim()
    let value = line.slice(colon + 1, line.len()).trim()
    if value.len() == 0 then
      li = li + 1
      next
    end
    if key == "std" then
      std_files.push(value)
    elsif key == "compiler" then
      compiler_files.push(value)
    end
    li = li + 1
  end
  if std_files.is_empty() && compiler_files.is_empty() then
    return Option::None
  end
  std_files.sort()
  compiler_files.sort()
  var out = Vec::new()
  for f in std_files do
    out.push("std/" + f)
  end
  for f in compiler_files do
    out.push("tg_compiler/" + f)
  end
  Option::Some(out)
end

pub def prelude_files() -> Vec[String]  # The bootstrap stdlib set is defined ONLY by bootstrap/compiler_kernel.manifest.
  # This list must mirror that manifest exactly and must never independently
  # describe bootstrap semantics. Modules the driver imports explicitly (env,
  # contracts, capabilities, effects, budget, test) are pulled in by
  # collect_dep_items on demand; they are not part of the always-loaded prelude.
  var files = Vec::new()
  files.push("std/alloc.tg")
  files.push("std/collections.tg")
  files.push("std/core.tg")
  files.push("std/ffi.tg")
  files.push("std/fmt.tg")
  files.push("std/fs.tg")
  files.push("std/io.tg")
  files.push("std/taint.tg")
  files
end
