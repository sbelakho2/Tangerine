def rationale_lane_delta() -> RationaleRecord
  rationale_of_delta("rev-3".to_string(), semantic_delta_empty())
end

def rationale_lane_delta_created() -> SemanticDelta
  var delta = semantic_delta_empty()
  delta.created = Vec::from(["m::g#fn()->unit".to_string()])
  delta
end

def rationale_lane_delta_affected() -> SemanticDelta
  var delta = semantic_delta_empty()
  delta.affected = Vec::from(["m::g#fn()->unit".to_string()])
  delta
end

# The escaping stress record: separators in every field, a real newline in
# the reason, an EMPTY evidence reference (the "\e" codec path) and a
# dependency key carrying ',' ';' '|'.
def rationale_lane_escaped() -> RationaleRecord
  RationaleRecord {
    origin_revision: "rev|4".to_string(),
    kind: RationaleKind::Delta,
    subject: rationale_subject_of_text("m::f#fn()->unit|part".to_string()),
    decision: "a;b".to_string(),
    reason: "line1\nline2".to_string(),
    evidence: Vec::from([
      rationale_evidence("row".to_string(), "e|1;2".to_string()),
      rationale_evidence("row".to_string(), "".to_string()),
      rationale_evidence("row".to_string(), "plain".to_string())
    ]),
    supporting_dependency_hashes: Vec::from([
      rationale_dependency("affected".to_string(), "k,1;2|3".to_string())
    ])
  }
end

# ———— The snapshot fixtures (the state lane) ————

def rationale_lane_target() -> StableTargetId
  StableTargetId {
    triple: "lane-none".to_string(),
    arch: "lane".to_string(),
    cpu: "lane".to_string(),
    pointer_width: 64,
    endian: "little".to_string(),
    abi: "sysv".to_string(),
    float_abi: "hard".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def rationale_lane_symbol(key: String) -> SemanticSymbol
  SemanticSymbol {
    stable_id: StableDefId { hash: 0, key: key.clone(), path: "lane".to_string(), id: 0 },
    kind: DefKind::Function,
    name: "f".to_string(),
    module_path: "m".to_string(),
    is_pub: false,
    is_generic: false
  }
end

# A one-symbol snapshot ("" = no symbol row).
def rationale_lane_snapshot(symbol_key: String) -> SemanticSnapshot
  var symbols: Vec[SemanticSymbol] = Vec::new()
  if symbol_key.len() > 0 then
    symbols.push(rationale_lane_symbol(symbol_key))
  end
  SemanticSnapshot {
    revision: StableDigest { hi: 0, lo: 0 },
    compiler_version: "lane".to_string(),
    target: rationale_lane_target(),
    public_api_hash: StableDigest { hi: 0, lo: 0 },
    abi_hash: StableDigest { hi: 0, lo: 0 },
    unsafe_hash: StableDigest { hi: 0, lo: 0 },
    symbols: symbols
  }
end

# A handle-subject record whose ONLY dependency is the symbol row: the
# subject itself has no snapshot table, so this record isolates the
# dependency-staleness rule.
def rationale_lane_dependency_record() -> RationaleRecord
  RationaleRecord {
    origin_revision: "rev-s".to_string(),
    kind: RationaleKind::Optimization,
    subject: rationale_subject_of_handle("decision:inline".to_string()),
    decision: "inline-rejected".to_string(),
    reason: "lane dependency fixture".to_string(),
    supporting_dependency_hashes: Vec::from([
      rationale_dependency("symbol".to_string(), "m::f#fn()->unit".to_string())
    ])
  }
end

# R1-R5: the five grounded kinds over the TYPED fields, the store semantics
# (idempotency, digest determinism, order-independent history digest), the
# typed subject query, the v2 save/load round-trip (legacy v1 reading) and
# the snapshot-relative state (Valid / Stale / Invalidated).
pub def rationale_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— R1: the five grounded kinds (typed) ————
  let opt = rationale_lane_optimization()
  rationale_lane_text(&mut out, "r1-optimization-kind", rationale_kind_word(opt.kind.clone()), "optimization")
  rationale_lane_text(&mut out, "r1-optimization-subject-kind", opt.subject.kind.clone(), "decl")
  rationale_lane_text(&mut out, "r1-optimization-subject-id", opt.subject.id.clone(), "m::f#fn()->unit")
  rationale_lane_text(&mut out, "r1-optimization-decision", opt.decision.clone(), "inline-rejected")
  rationale_lane_int(&mut out, "r1-optimization-evidence-len", opt.evidence.len(), 2)
  if opt.evidence.len() == 2 then
    rationale_lane_text(&mut out, "r1-optimization-pass", opt.evidence[0].id.clone(), "inline")
    rationale_lane_bool(&mut out, "r1-optimization-site-presentation", opt.evidence[1].presentation)
    rationale_lane_text(&mut out, "r1-optimization-site-render", rationale_evidence_render(opt.evidence[1].clone()), "lane.tg:3-9")
  end
  rationale_lane_int(&mut out, "r1-optimization-deps-len", opt.supporting_dependency_hashes.len(), 1)
  if opt.supporting_dependency_hashes.len() == 1 then
    rationale_lane_text(&mut out, "r1-optimization-dep-kind",
      opt.supporting_dependency_hashes[0].kind.clone(), "symbol")
    rationale_lane_text(&mut out, "r1-optimization-dep-key",
      opt.supporting_dependency_hashes[0].key.clone(), "m::f#fn()->unit")
  end

  let diag = rationale_lane_diagnostic()
  rationale_lane_text(&mut out, "r1-diagnostic-kind", rationale_kind_word(diag.kind.clone()), "diagnostic")
  rationale_lane_text(&mut out, "r1-diagnostic-subject-kind", diag.subject.kind.clone(), "decl")
  rationale_lane_text(&mut out, "r1-diagnostic-subject-id", diag.subject.id.clone(), "m::f#fn()->unit")
  rationale_lane_text(&mut out, "r1-diagnostic-decision", diag.decision.clone(), "E0201")
  rationale_lane_text(&mut out, "r1-diagnostic-reason", diag.reason.clone(), "use of moved value `r`")
  rationale_lane_int(&mut out, "r1-diagnostic-evidence-len", diag.evidence.len(), 4)
  if diag.evidence.len() == 4 then
    rationale_lane_text(&mut out, "r1-diagnostic-id-row-kind", diag.evidence[0].kind.clone(), "diagnostic")
    rationale_lane_bool(&mut out, "r1-diagnostic-id-row-stable", !diag.evidence[0].presentation)
    rationale_lane_text(&mut out, "r1-diagnostic-related-kind", diag.evidence[2].kind.clone(), "related")
    rationale_lane_bool(&mut out, "r1-diagnostic-related-presentation", diag.evidence[2].presentation)
    rationale_lane_text(&mut out, "r1-diagnostic-related-render", diag.evidence[2].id.clone(), "place:r")
  end
  rationale_lane_int(&mut out, "r1-diagnostic-deps-len", diag.supporting_dependency_hashes.len(), 1)
  if diag.supporting_dependency_hashes.len() == 1 then
    rationale_lane_text(&mut out, "r1-diagnostic-dep-kind",
      diag.supporting_dependency_hashes[0].kind.clone(), "symbol")
  end

  let delta = rationale_lane_delta()
  rationale_lane_text(&mut out, "r1-delta-kind", rationale_kind_word(delta.kind.clone()), "delta")
  rationale_lane_text(&mut out, "r1-delta-subject-kind", delta.subject.kind.clone(), "handle")
  rationale_lane_bool(&mut out, "r1-delta-subject", delta.subject.id.starts_with("delta:"))
  rationale_lane_text(&mut out, "r1-delta-decision", delta.decision.clone(), "delta-summary")
  rationale_lane_bool(&mut out, "r1-delta-summary-row",
    delta.reason.contains("created:0") && delta.reason.contains("affected:0"))
  rationale_lane_int(&mut out, "r1-delta-evidence-len", delta.evidence.len(), 1)
  if delta.evidence.len() == 1 then
    rationale_lane_text(&mut out, "r1-delta-evidence-kind", delta.evidence[0].kind.clone(), "delta-digest")
  end
  rationale_lane_int(&mut out, "r1-delta-deps-len", delta.supporting_dependency_hashes.len(), 0)
  # A delta with an affected set carries one typed "affected" dependency per
  # affected entity key.
  let delta_affected = rationale_of_delta("rev-3".to_string(), rationale_lane_delta_affected())
  rationale_lane_int(&mut out, "r1-delta-affected-deps", delta_affected.supporting_dependency_hashes.len(), 1)
  if delta_affected.supporting_dependency_hashes.len() == 1 then
    rationale_lane_text(&mut out, "r1-delta-affected-dep-kind",
      delta_affected.supporting_dependency_hashes[0].kind.clone(), "affected")
    rationale_lane_text(&mut out, "r1-delta-affected-dep-key",
      delta_affected.supporting_dependency_hashes[0].key.clone(), "m::g#fn()->unit")
  end

  let budget_ok = rationale_of_budget(
    "rev-4".to_string(),
    "change:empty".to_string(),
    ChangeBudget {},
    semantic_delta_empty()
  )
  rationale_lane_text(&mut out, "r1-budget-verified-kind", rationale_kind_word(budget_ok.kind.clone()), "budget")
  rationale_lane_text(&mut out, "r1-budget-verified-subject-kind", budget_ok.subject.kind.clone(), "handle")
  rationale_lane_text(&mut out, "r1-budget-verified-decision", budget_ok.decision.clone(), "budget-verified")
  rationale_lane_text(&mut out, "r1-budget-verified-reason", budget_ok.reason.clone(), "no violations")
  rationale_lane_int(&mut out, "r1-budget-verified-evidence", budget_ok.evidence.len(), 0)

  let budget_bad = rationale_of_budget(
    "rev-4".to_string(),
    "change:created".to_string(),
    ChangeBudget {},
    rationale_lane_delta_created()
  )
  rationale_lane_text(&mut out, "r1-budget-violated-decision", budget_bad.decision.clone(), "budget-violated")
  rationale_lane_int(&mut out, "r1-budget-violated-evidence", budget_bad.evidence.len(), 1)
  if budget_bad.evidence.len() == 1 then
    rationale_lane_text(&mut out, "r1-budget-violated-kind", budget_bad.evidence[0].kind.clone(), "violation")
    rationale_lane_bool(&mut out, "r1-budget-violated-row",
      budget_bad.evidence[0].id.starts_with("budget:"))
  end

  let eq = rationale_of_equivalence(
    "rev-5".to_string(),
    "m::f#fn()->unit".to_string(),
    equivalence_structural("normalized-mir".to_string())
  )
  rationale_lane_text(&mut out, "r1-equivalence-kind", rationale_kind_word(eq.kind.clone()), "equivalence")
  rationale_lane_text(&mut out, "r1-equivalence-decision", eq.decision.clone(), "structurally-equivalent")
  rationale_lane_text(&mut out, "r1-equivalence-reason", eq.reason.clone(), "normalized-mir")
  rationale_lane_int(&mut out, "r1-equivalence-evidence", eq.evidence.len(), 2)
  if eq.evidence.len() == 2 then
    rationale_lane_text(&mut out, "r1-equivalence-level-kind", eq.evidence[0].kind.clone(), "level")
  end

  let unk = rationale_of_equivalence(
    "rev-5".to_string(),
    "m::f#fn()->unit".to_string(),
    equivalence_unknown("bounded domain requires an evaluator".to_string())
  )
  rationale_lane_text(&mut out, "r1-unknown-decision", unk.decision.clone(), "unknown")

  # ———— R2: add + idempotency + digest determinism ————
  var store = rationale_store_new()
  let d1 = rationale_store_add(&mut store, opt.clone())
  let d1_again = rationale_store_add(&mut store, opt.clone())
  rationale_lane_bool(&mut out, "r2-idempotent-digest", d1.hi == d1_again.hi && d1.lo == d1_again.lo)
  rationale_lane_int(&mut out, "r2-idempotent-len", rationale_store_len(store.clone()), 1)
  let d2 = rationale_store_add(&mut store, diag.clone())
  let d3 = rationale_store_add(&mut store, delta.clone())
  rationale_lane_int(&mut out, "r2-store-len", rationale_store_len(store.clone()), 3)
  rationale_lane_bool(&mut out, "r2-distinct-digests",
    (d2.hi != d1.hi || d2.lo != d1.lo) && (d3.hi != d2.hi || d3.lo != d2.lo))
  let computed = rationale_digest(opt.clone())
  rationale_lane_bool(&mut out, "r2-returned-digest",
    computed.hi == d1.hi && computed.lo == d1.lo)
  if store.records.len() == 3 then
    rationale_lane_bool(&mut out, "r2-stored-digest-sealed",
      store.records[0].digest_hi == d1.hi && store.records[0].digest_lo == d1.lo)
  end
  let sealed = rationale_record_with_digest(opt.clone())
  rationale_lane_bool(&mut out, "r2-sealed-constructor",
    sealed.digest_hi == d1.hi && sealed.digest_lo == d1.lo)
  var all_store = rationale_store_new()
  let all_digests = rationale_store_add_all(&mut all_store, Vec::from([
    opt.clone(),
    diag.clone(),
    opt.clone()
  ]))
  rationale_lane_int(&mut out, "r2-add-all-digests", all_digests.len(), 3)
  rationale_lane_int(&mut out, "r2-add-all-len", rationale_store_len(all_store.clone()), 2)
  let generic = rationale_record_new(
    "rev-6".to_string(),
    RationaleKind::Budget,
    rationale_subject_of_decl_key("m::f#fn()->unit".to_string()),
    "budget-verified".to_string(),
    "no violations".to_string(),
    Vec::from([rationale_evidence("row".to_string(), "row".to_string())]),
    Vec::new()
  )
  rationale_lane_int(&mut out, "r2-record-new-evidence", generic.evidence.len(), 1)
  rationale_lane_text(&mut out, "r2-record-new-subject-kind", generic.subject.kind.clone(), "decl")
  var changed = opt.clone()
  changed.reason = "different reason".to_string()
  let d_changed = rationale_digest(changed.clone())
  rationale_lane_bool(&mut out, "r2-digest-field-sensitive",
    d_changed.hi != d1.hi || d_changed.lo != d1.lo)
  # A presentation-only render change must NOT change the identity.
  var render_changed = opt.clone()
  render_changed.evidence[1].render = "lane.tg:999-999".to_string()
  let d_render_changed = rationale_digest(render_changed.clone())
  rationale_lane_bool(&mut out, "r2-presentation-render-not-identity",
    d_render_changed.hi == d1.hi && d_render_changed.lo == d1.lo)
  # A typed subject digest change DOES change the identity.
  var subject_changed = opt.clone()
  subject_changed.subject.id_hi = subject_changed.subject.id_hi + (1 as UInt)
  let d_subject_changed = rationale_digest(subject_changed.clone())
  rationale_lane_bool(&mut out, "r2-subject-identity-sensitive",
    d_subject_changed.hi != d1.hi || d_subject_changed.lo != d1.lo)

  # The history digest is over the SORTED records: insertion order cannot
  # change it.
  var store_a = rationale_store_new()
  let _a1 = rationale_store_add(&mut store_a, opt.clone())
  let _a2 = rationale_store_add(&mut store_a, diag.clone())
  var store_b = rationale_store_new()
  let _b1 = rationale_store_add(&mut store_b, diag.clone())
  let _b2 = rationale_store_add(&mut store_b, opt.clone())
  let history_a = rationale_store_digest(store_a.clone())
  let history_b = rationale_store_digest(store_b.clone())
  rationale_lane_bool(&mut out, "r2-history-digest-order-independent",
    history_a.hi == history_b.hi && history_a.lo == history_b.lo)

  # ———— R3: the typed subject query ————
  var subject_store = rationale_store_new()
  let _s1 = rationale_store_add(&mut subject_store, opt.clone())
  var opt_late = opt.clone()
  opt_late.origin_revision = "rev-2".to_string()
  opt_late.decision = "bounds-check-retained".to_string()
  let _s2 = rationale_store_add(&mut subject_store, opt_late.clone())
  let _s3 = rationale_store_add(&mut subject_store, delta.clone())
  let empty_snapshot = rationale_lane_snapshot("".to_string())
  let found = rationale_for_subject(subject_store.clone(),
    rationale_subject_of_decl_key("m::f#fn()->unit".to_string()), empty_snapshot.clone())
  rationale_lane_int(&mut out, "r3-subject-count", found.len(), 2)
  if found.len() == 2 then
    rationale_lane_text(&mut out, "r3-subject-sorted-first", found[0].record.origin_revision.clone(), "rev-1")
    rationale_lane_text(&mut out, "r3-subject-sorted-second", found[1].record.origin_revision.clone(), "rev-2")
    # The subject is absent from the empty snapshot -> Invalidated.
    rationale_lane_text(&mut out, "r3-subject-state", rationale_state_word(found[0].state.clone()), "invalidated")
  end
  rationale_lane_int(&mut out, "r3-subject-absent",
    rationale_for_subject(subject_store.clone(),
      rationale_subject_of_decl_key("no::such#fn()->unit".to_string()), empty_snapshot.clone()).len(), 0)
  rationale_lane_int(&mut out, "r3-subject-delta",
    rationale_for_subject(subject_store.clone(), delta.subject.clone(), empty_snapshot.clone()).len(), 1)
  # The text-entry query parses the canonical subject text at the boundary.
  rationale_lane_int(&mut out, "r3-subject-text-count",
    rationale_for_subject_text(subject_store.clone(), "m::f#fn()->unit".to_string(), empty_snapshot.clone()).len(), 2)

  # ———— R4: the v2 save / load round-trip (typed fields) ————
  let text = rationale_store_save(store.clone())
  let loaded = rationale_store_load(text.clone())
  rationale_lane_int(&mut out, "r4-load-len", rationale_store_len(loaded.clone()), 3)
  rationale_lane_text(&mut out, "r4-save-load-save", rationale_store_save(loaded.clone()), text.clone())
  let original_all = rationale_store_all(store.clone())
  let loaded_all = rationale_store_all(loaded.clone())
  rationale_lane_int(&mut out, "r4-all-len", loaded_all.len(), original_all.len())
  var i = 0
  while i < original_all.len() && i < loaded_all.len() do
    let digest_a = rationale_digest(original_all[i].clone())
    let digest_b = rationale_digest(loaded_all[i].clone())
    if digest_a.hi != digest_b.hi || digest_a.lo != digest_b.lo then
      out.push("r4-record-digest[" + i.to_string() + "]: loaded digest differs")
    end
    i = i + 1
  end
  rationale_lane_bool(&mut out, "r4-history-digest-round-trip",
    rationale_store_digest(store.clone()).hi == rationale_store_digest(loaded.clone()).hi &&
    rationale_store_digest(store.clone()).lo == rationale_store_digest(loaded.clone()).lo)
  # The TYPED fields survive the round trip (kind, subject kind/id/words,
  # evidence refs + presentation flag, dependency kinds/keys/words).
  if loaded_all.len() == 3 then
    let back_opt = loaded_all[0].clone()
    rationale_lane_text(&mut out, "r4-typed-kind", rationale_kind_word(back_opt.kind.clone()), "optimization")
    rationale_lane_text(&mut out, "r4-typed-subject-kind", back_opt.subject.kind.clone(), "decl")
    rationale_lane_text(&mut out, "r4-typed-subject-id", back_opt.subject.id.clone(), "m::f#fn()->unit")
    rationale_lane_bool(&mut out, "r4-typed-subject-words",
      back_opt.subject.id_hi == opt.subject.id_hi && back_opt.subject.id_lo == opt.subject.id_lo)
    rationale_lane_int(&mut out, "r4-typed-evidence-len", back_opt.evidence.len(), 2)
    if back_opt.evidence.len() == 2 then
      rationale_lane_text(&mut out, "r4-typed-evidence-kind", back_opt.evidence[0].kind.clone(), "pass")
      rationale_lane_text(&mut out, "r4-typed-evidence-id", back_opt.evidence[0].id.clone(), "inline")
      rationale_lane_bool(&mut out, "r4-typed-evidence-presentation", back_opt.evidence[1].presentation)
    end
    rationale_lane_int(&mut out, "r4-typed-deps-len", back_opt.supporting_dependency_hashes.len(), 1)
    if back_opt.supporting_dependency_hashes.len() == 1 then
      rationale_lane_text(&mut out, "r4-typed-dep-kind",
        back_opt.supporting_dependency_hashes[0].kind.clone(), "symbol")
      rationale_lane_text(&mut out, "r4-typed-dep-key",
        back_opt.supporting_dependency_hashes[0].key.clone(), "m::f#fn()->unit")
      rationale_lane_bool(&mut out, "r4-typed-dep-words",
        back_opt.supporting_dependency_hashes[0].digest_hi == opt.supporting_dependency_hashes[0].digest_hi &&
        back_opt.supporting_dependency_hashes[0].digest_lo == opt.supporting_dependency_hashes[0].digest_lo)
    end
  end

  # The escaping codec: separators, a real newline, an empty evidence
  # reference and a dependency key carrying ',;|' all round-trip exactly.
  var escaped_store = rationale_store_new()
  let escaped = rationale_lane_escaped()
  let escaped_digest = rationale_store_add(&mut escaped_store, escaped.clone())
  let escaped_text = rationale_store_save(escaped_store.clone())
  let escaped_loaded = rationale_store_load(escaped_text.clone())
  rationale_lane_int(&mut out, "r4-escaped-len", rationale_store_len(escaped_loaded.clone()), 1)
  if rationale_store_len(escaped_loaded.clone()) == 1 then
    let back = rationale_store_all(escaped_loaded.clone())[0].clone()
    rationale_lane_text(&mut out, "r4-escaped-revision", back.origin_revision.clone(), "rev|4")
    rationale_lane_text(&mut out, "r4-escaped-subject", back.subject.id.clone(), "m::f#fn()->unit|part")
    rationale_lane_text(&mut out, "r4-escaped-decision", back.decision.clone(), "a;b")
    rationale_lane_text(&mut out, "r4-escaped-reason", back.reason.clone(), "line1\nline2")
    rationale_lane_int(&mut out, "r4-escaped-evidence-len", back.evidence.len(), 3)
    if back.evidence.len() == 3 then
      rationale_lane_text(&mut out, "r4-escaped-evidence-0", back.evidence[0].id.clone(), "e|1;2")
      rationale_lane_text(&mut out, "r4-escaped-evidence-1", back.evidence[1].id.clone(), "")
      rationale_lane_text(&mut out, "r4-escaped-evidence-2", back.evidence[2].id.clone(), "plain")
    end
    rationale_lane_int(&mut out, "r4-escaped-deps-len", back.supporting_dependency_hashes.len(), 1)
    if back.supporting_dependency_hashes.len() == 1 then
      rationale_lane_text(&mut out, "r4-escaped-dep-key",
        back.supporting_dependency_hashes[0].key.clone(), "k,1;2|3")
    end
    let back_digest = rationale_digest(back.clone())
    rationale_lane_bool(&mut out, "r4-escaped-digest",
      back_digest.hi == escaped_digest.hi && back_digest.lo == escaped_digest.lo)
  end

  # The legacy v1 line still reads: the kind/subject words map onto the
  # typed fields and the rendered evidence rows are presentation-only.
  let v1_store = rationale_store_load(
    "rev-9|budget|m::f#fn()->unit|budget-verified|no violations|pass:inline".to_string())
  rationale_lane_int(&mut out, "r4-v1-len", rationale_store_len(v1_store.clone()), 1)
  if rationale_store_len(v1_store.clone()) == 1 then
    let v1 = rationale_store_all(v1_store.clone())[0].clone()
    rationale_lane_text(&mut out, "r4-v1-kind", rationale_kind_word(v1.kind.clone()), "budget")
    rationale_lane_text(&mut out, "r4-v1-subject-kind", v1.subject.kind.clone(), "decl")
    rationale_lane_text(&mut out, "r4-v1-subject-id", v1.subject.id.clone(), "m::f#fn()->unit")
    rationale_lane_text(&mut out, "r4-v1-origin", v1.origin_revision.clone(), "rev-9")
    rationale_lane_int(&mut out, "r4-v1-evidence-len", v1.evidence.len(), 1)
    if v1.evidence.len() == 1 then
      rationale_lane_text(&mut out, "r4-v1-evidence-kind", v1.evidence[0].kind.clone(), "pass")
      rationale_lane_text(&mut out, "r4-v1-evidence-id", v1.evidence[0].id.clone(), "inline")
      rationale_lane_bool(&mut out, "r4-v1-evidence-presentation", v1.evidence[0].presentation)
    end
    rationale_lane_int(&mut out, "r4-v1-deps-len", v1.supporting_dependency_hashes.len(), 0)
  end

  # The total loader: malformed / short / empty texts never fabricate rows.
  rationale_lane_int(&mut out, "r4-empty-text",
    rationale_store_len(rationale_store_load("".to_string())), 0)
  rationale_lane_int(&mut out, "r4-malformed-text",
    rationale_store_len(rationale_store_load("not a store line".to_string())), 0)
  rationale_lane_int(&mut out, "r4-short-line",
    rationale_store_len(rationale_store_load("a|b|c".to_string())), 0)

  # ———— R5: the snapshot-relative state ————
  # Unchanged: the subject and its symbol dependency both live -> Valid.
  var state_store = rationale_store_new()
  let _state_opt = rationale_store_add(&mut state_store, opt.clone())
  let dep_record = rationale_lane_dependency_record()
  let _state_dep = rationale_store_add(&mut state_store, dep_record.clone())
  let live_snapshot = rationale_lane_snapshot("m::f#fn()->unit".to_string())
  rationale_lane_text(&mut out, "r5-valid-state",
    rationale_state_word(rationale_state_of(state_store.clone(), dep_record.clone(), live_snapshot.clone())), "valid")
  rationale_lane_bool(&mut out, "r5-valid-not-stale",
    !rationale_stale(state_store.clone(), dep_record.clone(), live_snapshot.clone()))
  rationale_lane_text(&mut out, "r5-valid-subject-state",
    rationale_state_word(rationale_state_of(state_store.clone(), opt.clone(), live_snapshot.clone())), "valid")
  # Changed dependency: the symbol row's key moved -> Stale.
  let moved_snapshot = rationale_lane_snapshot("m::f#fn(Int)->unit".to_string())
  rationale_lane_text(&mut out, "r5-stale-state",
    rationale_state_word(rationale_state_of(state_store.clone(), dep_record.clone(), moved_snapshot.clone())), "stale")
  rationale_lane_bool(&mut out, "r5-stale-flag",
    rationale_stale(state_store.clone(), dep_record.clone(), moved_snapshot.clone()))
  # Dependency row deleted entirely -> Stale.
  let gone_snapshot = rationale_lane_snapshot("".to_string())
  rationale_lane_text(&mut out, "r5-dependency-gone-state",
    rationale_state_word(rationale_state_of(state_store.clone(), dep_record.clone(), gone_snapshot.clone())), "stale")
  # Subject deleted -> Invalidated (the opt record's Decl subject is absent).
  rationale_lane_text(&mut out, "r5-invalidated-state",
    rationale_state_word(rationale_state_of(state_store.clone(), opt.clone(), gone_snapshot.clone())), "invalidated")
  rationale_lane_bool(&mut out, "r5-invalidated-stale-flag",
    rationale_stale(state_store.clone(), opt.clone(), gone_snapshot.clone()))
  # The subject query carries the state of each record.
  let state_query = rationale_for_subject(state_store.clone(),
    rationale_subject_of_decl_key("m::f#fn()->unit".to_string()), live_snapshot.clone())
  rationale_lane_int(&mut out, "r5-query-len", state_query.len(), 1)
  if state_query.len() == 1 then
    rationale_lane_text(&mut out, "r5-query-state", rationale_state_word(state_query[0].state.clone()), "valid")
  end
  let stale_query = rationale_for_subject(state_store.clone(),
    rationale_subject_of_handle("decision:inline".to_string()), moved_snapshot.clone())
  rationale_lane_int(&mut out, "r5-stale-query-len", stale_query.len(), 1)
  if stale_query.len() == 1 then
    rationale_lane_text(&mut out, "r5-stale-query-state", rationale_state_word(stale_query[0].state.clone()), "stale")
  end

  out
end

# T1-T3: the discovery surface — sorted deterministic enumeration, registry
# coverage, the audited count, the named ops' flags and the filter views.
pub def semantic_tools_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  let tools = semantic_tools()

  # ———— T1: sorted, deduped, registry-covered ————
  rationale_lane_int(&mut out, "t1-tool-count", tools.len(), 80)
  var sorted = true
  var i = 1
  while i < tools.len() do
    if tools[i - 1].name > tools[i].name then
      sorted = false
    end
    i = i + 1
  end
  rationale_lane_bool(&mut out, "t1-sorted", sorted)
  var unique = true
  i = 1
  while i < tools.len() do
    if tools[i - 1].name == tools[i].name then
      unique = false
    end
    i = i + 1
  end
  rationale_lane_bool(&mut out, "t1-unique", unique)

  let registry = server_operations()
  rationale_lane_int(&mut out, "t1-registry-count", registry.len(), 62)
  var covered = true
  var missing = ""
  for op in registry do
    match semantic_tool_lookup(op.name.clone())
    when Option::Some(_) then ()
    when Option::None then
      covered = false
      missing = op.name.clone()
    end
  end
  rationale_lane_bool(&mut out, "t1-registry-metadata-covered", covered)
  if !covered then
    out.push("t1-registry-metadata-missing: " + missing)
  end
  var listed = true
  for op in registry do
    var found = false
    for tool in tools do
      if tool.name == op.name then
        found = true
      end
    end
    if !found then
      listed = false
    end
  end
  rationale_lane_bool(&mut out, "t1-registry-listed", listed)

  # ———— T2: the named ops' capability metadata ————
  match tool_for("mir.dominators".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-dominators-mir", tool.requires_mir)
    rationale_lane_bool(&mut out, "t2-dominators-coverage", !tool.requires_coverage)
    rationale_lane_bool(&mut out, "t2-dominators-store", !tool.requires_store)
    rationale_lane_text(&mut out, "t2-dominators-stability", tool.stability.clone(), "experimental")
    rationale_lane_text(&mut out, "t2-dominators-capability", tool.capability.clone(), "mir")
  when Option::None then
    out.push("t2-dominators: expected Some, got None")
  end
  match tool_for("coverage.affected".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-coverage-flag", tool.requires_coverage)
    rationale_lane_bool(&mut out, "t2-coverage-mir", !tool.requires_mir)
  when Option::None then
    out.push("t2-coverage: expected Some, got None")
  end
  # The §39 registry spells the op "symbol_get" (there is no dotted
  # "symbol.get" name in the dispatch): it requires NOTHING extra.
  match tool_for("symbol_get".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-symbol-get-requires-nothing",
      !tool.requires_mir && !tool.requires_coverage && !tool.requires_store)
    rationale_lane_text(&mut out, "t2-symbol-get-stability", tool.stability.clone(), "stable")
  when Option::None then
    out.push("t2-symbol-get: expected Some, got None")
  end
  match tool_for("diagnostic.get".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-diagnostic-store", tool.requires_store)
  when Option::None then
    out.push("t2-diagnostic-store: expected Some, got None")
  end
  match tool_for("rationale.for_subject".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-rationale-store", tool.requires_store)
  when Option::None then
    out.push("t2-rationale-store: expected Some, got None")
  end
  # The registry-gap finding: mir.block is implemented by the §38 dispatch
  # but absent from server_operations; the discovery surface carries it.
  match tool_for("mir.block".to_string())
  when Option::Some(tool) then
    rationale_lane_bool(&mut out, "t2-mir-block-flag", tool.requires_mir)
  when Option::None then
    out.push("t2-mir-block: expected Some, got None")
  end
  # The supplement's engine families are present.
  for engine_name in Vec::from([
    "type.use".to_string(),
    "change.semantic_diff".to_string(),
    "abi.inspect".to_string(),
    "perf.reports".to_string(),
    "hole.constraints".to_string()
  ]) do
    match tool_for(engine_name.clone())
    when Option::Some(_) then ()
    when Option::None then
      out.push("t2-engine-missing: " + engine_name.clone())
    end
  end

  # ———— T3: the filter views ————
  let mir_tools = tools_requiring_mir()
  rationale_lane_int(&mut out, "t3-mir-count", mir_tools.len(), 12)
  rationale_lane_rows(&mut out, "t3-mir-names", tool_name_rows(mir_tools.clone()), Vec::from([
    "mir.block".to_string(),
    "mir.control".to_string(),
    "mir.diff".to_string(),
    "mir.dominators".to_string(),
    "mir.loops".to_string(),
    "mir.path".to_string(),
    "mir.postdominators".to_string(),
    "mir.reaching".to_string(),
    "mir_slice".to_string(),
    "perf.facts.mir".to_string(),
    "perf.report.mir".to_string(),
    "perf.reports".to_string()
  ]))
  let coverage_tools = tools_requiring_coverage()
  rationale_lane_rows(&mut out, "t3-coverage-names", tool_name_rows(coverage_tools.clone()), Vec::from([
    "coverage.affected".to_string(),
    "test.affected".to_string()
  ]))
  let store_tools = tools_requiring_store()
  rationale_lane_int(&mut out, "t3-store-count", store_tools.len(), 7)
  rationale_lane_rows(&mut out, "t3-store-names", tool_name_rows(store_tools.clone()), Vec::from([
    "diagnostic.explain".to_string(),
    "diagnostic.get".to_string(),
    "diagnostic.repair_context".to_string(),
    "rationale.add".to_string(),
    "rationale.for_subject".to_string(),
    "rationale.save".to_string(),
    "rationale.store_digest".to_string()
  ]))
  match tool_for("no.such.tool".to_string())
  when Option::Some(_) then
    out.push("t3-absent: expected None, got Some")
  when Option::None then ()
  end

  out
end

pub def semantic_rationale_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()
  for row in rationale_lane_check() do
    out.push(row.clone())
  end
  for row in semantic_tools_lane_check() do
    out.push(row.clone())
  end
  out
end
