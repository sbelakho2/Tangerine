# Tangerine Compiler — Semantic Rationale + Tool Discovery (Tier-4)
# Self-hosting compiler written in Tangerine
#
# TWO well-defined Tier-4 pieces, one module, no gate change:
#
# 1. COMPILER-GROUNDED PERSISTENT RATIONALE HISTORY (fourth-audit P1-4).
#    ONE RationaleRecord is the compiler's own decision record with TYPED
#    fields (never prose):
#      kind        — the RationaleKind union: Optimization | Diagnostic |
#                    Delta | Budget | Equivalence.
#      subject     — the typed RationaleSubject union (a kind word + the
#                    P0-4/P0-7 stable id record): Decl (StableDeclId) |
#                    HIRNode | MIRNode | Place | Contract | Effect
#                    (StableEffectId) | Capability (StableCapabilityId) |
#                    ABI | handle (a content-addressed stable render whose
#                    digest words ride id_hi/id_lo) | none. The subject
#                    identity digests the typed id's digest words only —
#                    the render text is collision cargo.
#      evidence    — typed RationaleEvidence references: a kind word + the
#                    stable reference id + the id's digest words + a
#                    display RENDER. A presentation evidence entry (a dense
#                    site locator, a rendered related row) is persisted and
#                    rendered but NEVER enters the record identity.
#      origin_revision — the compile revision text the decision was taken
#                    under (the §30 snapshot revision render at the driver
#                    boundary; a bare label in a hand-built store).
#      decision / reason — the fixed decision word and the human reason
#                    text (reason participates in identity; it is the
#                    decision's evidence text, never a rendered row).
#      supporting_dependency_hashes — the typed RationaleDependency rows
#                    the decision depends on: the dependency kind + the
#                    canonical key + the 128-bit digest of "kind|key" at
#                    record time. For optimization records the function's
#                    symbol row; for diagnostics the subject's symbol /
#                    ownership / MIR / contract / effect / ABI row; for
#                    delta records the affected-set entity keys.
#    The history is grounded in the FIVE implemented decision sources that
#    already exist in this tree: optimization — mir.tg's
#    OptimizationDecision rows; diagnostic — semantic_diagnostics.tg's
#    DiagnosticRecord rows; delta — ONE SemanticDelta summary row; budget —
#    change_budget.tg's budget_verify violation rows; equivalence —
#    equivalence.tg's EquivalenceResult LEVEL + detail (TestedNoCounterexample
#    is never promoted to a proof here).
#    RationaleState is Valid | Stale | Invalidated. rationale_state_of
#    compares every recorded dependency hash against the CURRENT snapshot
#    row (a missing row or a changed dependency key is Stale) and reports
#    Invalidated when the subject no longer exists (the snapshot-visible
#    subject kinds; a hive/handle subject with no snapshot table is never
#    invalidated by absence — its dependencies still gate the state).
#    rationale_for_subject returns RationaleRecordState rows (record +
#    state) in the deterministic order; rationale_stale is the boolean
#    form. RationaleStore is append-only; rationale_store_add is idempotent
#    by the record's stable digest (the digest IS the identity; the text is
#    format only). rationale_store_save writes the v2 one-line-per-record
#    format ("v2|origin|kind|subject-kind|subject-id|subject-id-words|
#    subject-digest-words|decision|reason|dependencies|evidence", every
#    field escaped so every byte round-trips: '|', ';', ',', '\', CR/LF and
#    the empty string); rationale_store_load reads v2 AND the legacy v1
#    6-column format (a v1 line maps its kind/subject words onto the typed
#    fields and marks its rendered evidence rows presentation-only).
#    rationale_digest / rationale_store_digest content-address one record /
#    the whole history.
#    PERSISTENCE CONVENTION (the driver store convention: accept/produce
#    text): the sibling artifact is "<snapshot>.rationale", written and
#    loaded exactly like driver.tg's declaration-lineage sibling
#    ("<snapshot>.lineages"): compile_snapshot_serve_route loads the text
#    at build start (read_file -> rationale_store_load, empty store when
#    absent), and after a successful build adds the in-scope decision
#    records and writes rationale_store_save's text back beside the
#    snapshot (skipped when the store is empty). THE WIRED FEED: the
#    optimization decision journal (opt_decisions_of_mir over the finalized
#    MirProgram — the route's capturing optimizer entry) grounds one
#    "optimization" record per OptimizationDecision; the driver call site
#    is unchanged (rationale_of_optimization_decision keeps its signature).
#    The other four grounded sources (diagnostic / delta / budget /
#    equivalence) are ready in the plumbing but not in scope at that
#    boundary: the route computes no SemanticDelta, no ChangeBudget and no
#    EquivalenceResult, and diagnostics exist only on the error path (the
#    route fails closed before the boundary).
#
# 2. DYNAMIC SEMANTIC-TOOL DISCOVERY. ONE SemanticTool row per implemented
#    semantic operation family — the surface automated consumers enumerate
#    instead of hardcoding (the audit's ask). The list is built from TWO
#    live sources and one static metadata table, never invented names:
#      a. the §39 OPERATION REGISTRY WALK: semantic_server.tg's
#         server_operations() (semantic_server.tg:595-662) is iterated at
#         call time; every registered name appears in the tool list. A
#         registered name with no explicit metadata row would still appear
#         (conservative "experimental" default, requires_mir from the
#         handler family), so the registry can never silently shrink the
#         surface.
#      b. the §38 QUERY-DISPATCH + EXPORT SUPPLEMENT: the op names
#         semantic_query.tg's query() dispatches (semantic_query.tg:2398)
#         plus the implemented engine exports not carried by the registry
#         (change_affected / change_semantic_diff semantic_query.tg:1013 /
#         1022, abi_inspect semantic_query.tg:1038, hole_constraints
#         semantic_query.tg:2257, type_use semantic_query.tg:1755,
#         semantic_slice.tg's mir graph engines, perf_report.tg's report /
#         fact engines, abi_report.tg's report / diff engines, and this
#         module's own rationale surface).
#    The wire-response families (third-audit item 22's twelve typed records)
#    are not duplicated as synthetic op names: each carrying tool's outputs
#    field names them ("wire:CallersResponse", ... "wire:PlanResponse").
#    Stability vocabulary: "stable" = the long-standing session families
#    (index / explain / type / ownership / contract / symbol / snapshot /
#    plan / service) that answer from the session snapshot+index; 
#     "experimental" = the third-audit families that answer from
#    caller-supplied artifacts (the final MirProgram, ingested coverage
#    traces, EventTraces, retained stores, LirAlloc, TypedProgram, a
#    SemanticDelta) or carry a documented unavailable form. semantic_tools
#    is deterministic byte-sorted and deduped; tool_for / tools_requiring_mir
#    / tools_requiring_coverage / tools_requiring_store are the filters.
#    REGISTRY FINDING (PATCHED — see the two comments below): "mir.block" is
#    dispatched by §38 query() (semantic_query.tg:2428) and is NOW registered
#    in server_operations() beside the other seven mir graph ops
#    (semantic_server.tg), so the registry walk carries it with no discovery
#    change.
#
# TABLE OF CONTENTS:
#   1. RationaleKind / RationaleSubject / RationaleEvidence /
#      RationaleDependency / RationaleRecord / RationaleStore + the v2 text
#      codec (legacy v1 reading).
#   2. The five grounded source constructors (typed).
#   3. The store API (add / save / load / subject query / digests) and the
#      snapshot-relative state (rationale_state_of / rationale_stale).
#   4. SemanticTool + the discovery surface.
#   5. The executable lanes (rationale_lane_check, semantic_tools_lane_check,
#      the aggregate semantic_rationale_lane_check).

use std::collections::{Vec}

use tg_compiler::ids::{StableDigest, StableDefId, DefKind, stable_digest_of}
use tg_compiler::stable_ids::{
  StableDeclId, StableHirNodeId, StableMirNodeId, StablePlaceId,
  StableContractId, StableEffectId, StableCapabilityId, StableAbiSurfaceId,
  stable_key_name_part, stable_decl_of_key, stable_decl_identity_text_of,
  stable_place_of_text, stable_place_text_of, stable_hir_node_identity_text,
  stable_mir_node_key_of, stable_text_to_uint
}
use tg_compiler::semantic_model::{
  SemanticSnapshot, SemanticSymbol, MirSemanticSummary,
  OwnershipFact, ContractFact, EffectEdge, AbiSurfaceRow, StableTargetId,
  semantic_digest_render, semantic_abi_surface_row_text
}
use tg_compiler::mir::{OptimizationDecision}
use tg_compiler::semantic_diagnostics::{
  DiagnosticRecord, DiagnosticSubject, stable_diagnostic_id_text, stable_diagnostic_id_of
}
use tg_compiler::semantic_delta::{
  SemanticDelta, semantic_delta_digest, semantic_delta_empty
}
use tg_compiler::change_budget::{ChangeBudget, budget_verify}
use tg_compiler::equivalence::{
  EquivalenceResult, equivalence_level_word, equivalence_result_render,
  equivalence_structural, equivalence_unknown
}
use tg_compiler::semantic_server::{ServerOperation, server_operations}

# ═══════════════════════════════════════════════════════════════
# 1. THE TYPED RATIONALE RECORD + STORE
# ═══════════════════════════════════════════════════════════════
# (fourth-audit P1-4) The record's fields are TYPED: RationaleKind, the
# RationaleSubject union, typed RationaleEvidence references, the typed
# RationaleDependency rows and the origin revision string. digest_hi /
# digest_lo ARE the identity (the 128-bit stable digest of the TYPED
# identity preimage — never a render, never a span); the fields are cargo.
# The digest words are NEVER serialized — save/load recomputes them, so a
# loaded record is identity-equal to the stored one.

# The five grounded decision kinds.
pub enum RationaleKind
  Optimization
  Diagnostic
  Delta
  Budget
  Equivalence
end

pub def rationale_kind_word(kind: RationaleKind) -> String
  match kind
  when RationaleKind::Optimization then "optimization"
  when RationaleKind::Diagnostic then "diagnostic"
  when RationaleKind::Delta then "delta"
  when RationaleKind::Budget then "budget"
  when RationaleKind::Equivalence then "equivalence"
  end
end

# The kind of a stored kind word (Option::None for a word outside the five).
pub def rationale_kind_of_word(word: String) -> Option[RationaleKind]
  if word == "optimization" then return Option::Some(RationaleKind::Optimization) end
  if word == "diagnostic" then return Option::Some(RationaleKind::Diagnostic) end
  if word == "delta" then return Option::Some(RationaleKind::Delta) end
  if word == "budget" then return Option::Some(RationaleKind::Budget) end
  if word == "equivalence" then return Option::Some(RationaleKind::Equivalence) end
  Option::None
end

# The snapshot-relative rationale state (P1-4): Valid = every dependency
# hash still matches the current snapshot; Stale = a dependency row moved /
# changed / disappeared; Invalidated = the subject no longer exists.
pub enum RationaleState
  Valid
  Stale
  Invalidated
end

pub def rationale_state_word(state: RationaleState) -> String
  match state
  when RationaleState::Valid then "valid"
  when RationaleState::Stale then "stale"
  when RationaleState::Invalidated then "invalidated"
  end
end

# ———— The typed subject union (Decl | HIRNode | MIRNode | Place |
# Contract | Effect | Capability | ABI | handle | none) ————
# The typed id's digest words are the identity (kind + id_hi/id_lo); the id
# text is the collision-detection / query cargo and display is presentation
# only. A "handle" subject is a content-addressed stable render (the delta
# digest, an obligation render) whose digest words are the digest of the
# handle text — never a span.
pub struct RationaleSubject
  kind: String = "none"
  id: String = ""
  id_hi: UInt = 0
  id_lo: UInt = 0
  decl: Option[StableDeclId] = Option::None
  hir_node: Option[StableHirNodeId] = Option::None
  mir_node: Option[StableMirNodeId] = Option::None
  place: Option[StablePlaceId] = Option::None
  contract: Option[StableContractId] = Option::None
  effect: Option[StableEffectId] = Option::None
  capability: Option[StableCapabilityId] = Option::None
  abi: Option[StableAbiSurfaceId] = Option::None
  display: String = ""
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

def rationale_lenpref(piece: String) -> String
  piece.len().to_string() + ":" + piece
end

def rationale_subject_of_parts(
  kind: String, id: String, id_hi: UInt, id_lo: UInt, display: String
) -> RationaleSubject
  let text = rationale_lenpref("subject") + rationale_lenpref(&kind) +
    rationale_lenpref(&id_hi.to_string()) + rationale_lenpref(&id_lo.to_string())
  let digest = stable_digest_of(&text)
  RationaleSubject {
    kind: kind,
    id: id,
    id_hi: id_hi,
    id_lo: id_lo,
    display: display,
    digest_hi: digest.hi,
    digest_lo: digest.lo
  }
end

pub def rationale_subject_none() -> RationaleSubject
  rationale_subject_of_parts("none".to_string(), "".to_string(), 0, 0, "".to_string())
end

pub def rationale_subject_of_decl(decl: StableDeclId, display: String) -> RationaleSubject
  var text = display.clone()
  if text.len() == 0 then
    text = stable_decl_identity_text_of(decl.clone())
  end
  var subject = rationale_subject_of_parts("decl".to_string(), text, decl.digest_hi, decl.digest_lo, display)
  subject.decl = Option::Some(decl)
  subject
end

pub def rationale_subject_of_decl_key(key: String) -> RationaleSubject
  rationale_subject_of_decl(stable_decl_of_key(&key), key)
end

pub def rationale_subject_of_hir_node(node: StableHirNodeId, display: String) -> RationaleSubject
  var text = display.clone()
  if text.len() == 0 then
    text = stable_hir_node_identity_text(node.clone())
  end
  var subject = rationale_subject_of_parts("hir-node".to_string(), text, node.digest_hi, node.digest_lo, display)
  subject.hir_node = Option::Some(node)
  subject
end

pub def rationale_subject_of_mir_node(node: StableMirNodeId, display: String) -> RationaleSubject
  var subject = rationale_subject_of_parts("mir-node".to_string(),
    stable_mir_node_key_of(node.clone()), node.digest_hi, node.digest_lo, display)
  subject.mir_node = Option::Some(node)
  subject
end

pub def rationale_subject_of_place(place: StablePlaceId, display: String) -> RationaleSubject
  var subject = rationale_subject_of_parts("place".to_string(),
    stable_place_text_of(place.clone()), place.digest_hi, place.digest_lo, display)
  subject.place = Option::Some(place)
  subject
end

pub def rationale_subject_of_place_text(text: String) -> RationaleSubject
  match stable_place_of_text(&text)
  when Option::Some(place) then rationale_subject_of_place(place, text)
  when Option::None then rationale_subject_none()
  end
end

pub def rationale_subject_of_contract(contract: StableContractId) -> RationaleSubject
  var subject = rationale_subject_of_parts("contract".to_string(),
    contract.stable_key.clone(), contract.digest_hi, contract.digest_lo, contract.stable_key.clone())
  subject.contract = Option::Some(contract)
  subject
end

pub def rationale_subject_of_effect(effect: StableEffectId, display: String) -> RationaleSubject
  var subject = rationale_subject_of_parts("effect".to_string(),
    effect.stable_key.clone(), effect.digest_hi, effect.digest_lo, display)
  subject.effect = Option::Some(effect)
  subject
end

pub def rationale_subject_of_capability(capability: StableCapabilityId, display: String) -> RationaleSubject
  var subject = rationale_subject_of_parts("capability".to_string(),
    capability.stable_key.clone(), capability.digest_hi, capability.digest_lo, display)
  subject.capability = Option::Some(capability)
  subject
end

pub def rationale_subject_of_abi(abi: StableAbiSurfaceId) -> RationaleSubject
  var subject = rationale_subject_of_parts("abi".to_string(),
    abi.stable_key.clone(), abi.digest_hi, abi.digest_lo, abi.stable_key.clone())
  subject.abi = Option::Some(abi)
  subject
end

# A content-addressed handle subject (a delta digest render, an obligation
# render): the digest words are the stable digest of the handle text.
pub def rationale_subject_of_handle(text: String) -> RationaleSubject
  let handle_text = rationale_lenpref("handle") + rationale_lenpref(&text)
  let digest = stable_digest_of(&handle_text)
  rationale_subject_of_parts("handle".to_string(), text.clone(), digest.hi, digest.lo, text)
end

# The TOTAL text boundary: a def key (contains '#') -> Decl; a header-like
# text (contains ':') or anything that is not a canonical place -> handle;
# a canonical place ("r", "self.field") -> Place.
pub def rationale_subject_of_text(text: String) -> RationaleSubject
  if text.len() == 0 then
    return rationale_subject_none()
  end
  if rationale_index_of(&text, "#", 0) > 0 then
    return rationale_subject_of_decl_key(text)
  end
  if rationale_index_of(&text, ":", 0) > 0 then
    return rationale_subject_of_handle(text)
  end
  let place = rationale_subject_of_place_text(text.clone())
  if place.kind == "place" then
    return place
  end
  rationale_subject_of_handle(text)
end

# The subject identity preimage: kind + the typed id's digest words, never
# the id text, never the display.
pub def rationale_subject_identity_key(subject: RationaleSubject) -> String
  rationale_lenpref("subject") + rationale_lenpref(&subject.kind) +
    rationale_lenpref(&subject.id_hi.to_string()) + rationale_lenpref(&subject.id_lo.to_string())
end

pub def rationale_subject_matches(a: RationaleSubject, b: RationaleSubject) -> Bool
  rationale_subject_identity_key(a) == rationale_subject_identity_key(b)
end

# The typed subject of a P1-1 DiagnosticSubject (the rationale subject union
# adds Effect/Capability and maps the obligation subject to a handle).
pub def rationale_subject_of_diagnostic_subject(ds: DiagnosticSubject) -> RationaleSubject
  match ds.decl.clone()
  when Option::Some(d) then
    if ds.kind == "decl" then return rationale_subject_of_decl(d, ds.display.clone()) end
  when Option::None then ()
  end
  match ds.hir_node.clone()
  when Option::Some(h) then
    if ds.kind == "hir-node" then return rationale_subject_of_hir_node(h, ds.display.clone()) end
  when Option::None then ()
  end
  match ds.mir_node.clone()
  when Option::Some(m) then
    if ds.kind == "mir-node" then return rationale_subject_of_mir_node(m, ds.display.clone()) end
  when Option::None then ()
  end
  match ds.place.clone()
  when Option::Some(p) then
    if ds.kind == "place" then return rationale_subject_of_place(p, ds.display.clone()) end
  when Option::None then ()
  end
  match ds.contract.clone()
  when Option::Some(c) then
    if ds.kind == "contract" then return rationale_subject_of_contract(c) end
  when Option::None then ()
  end
  match ds.abi.clone()
  when Option::Some(a) then
    if ds.kind == "abi" then return rationale_subject_of_abi(a) end
  when Option::None then ()
  end
  match ds.trait_obligation.clone()
  when Option::Some(ob) then
    if ds.kind == "trait-obligation" then
      return rationale_subject_of_handle("obligation:" + ob.obligation.clone())
    end
  when Option::None then ()
  end
  if ds.kind != "none" && ds.id.len() > 0 then
    return rationale_subject_of_handle(ds.id.clone())
  end
  rationale_subject_none()
end

# ———— Typed evidence references ————
# kind + the stable reference id + the id's digest words + a display render
# + the presentation-only flag. A presentation entry (a dense site locator,
# a rendered related row) is persisted and rendered but NEVER enters the
# record identity — only its kind does.
pub struct RationaleEvidence
  kind: String = ""
  id: String = ""
  digest_hi: UInt = 0
  digest_lo: UInt = 0
  presentation: Bool = false
  render: String = ""
end

pub def rationale_evidence_of_parts(
  kind: String, id: String, render: String, presentation: Bool
) -> RationaleEvidence
  let text = kind.clone() + "|" + id.clone()
  let digest = stable_digest_of(&text)
  RationaleEvidence {
    kind: kind,
    id: id,
    digest_hi: digest.hi,
    digest_lo: digest.lo,
    presentation: presentation,
    render: render
  }
end

# A STABLE evidence reference (participates in the record identity).
pub def rationale_evidence(kind: String, id: String) -> RationaleEvidence
  rationale_evidence_of_parts(kind, id.clone(), id, false)
end

# A stable reference with an explicit display render.
pub def rationale_evidence_text(kind: String, id: String, render: String) -> RationaleEvidence
  rationale_evidence_of_parts(kind, id, render, false)
end

# A PRESENTATION-only evidence row (display cargo; the identity folds its
# kind only).
pub def rationale_evidence_presentation(kind: String, id: String, render: String) -> RationaleEvidence
  rationale_evidence_of_parts(kind, id, render, true)
end

pub def rationale_evidence_render(e: RationaleEvidence) -> String
  if e.render.len() > 0 then e.render.clone() else e.id.clone() end
end

# ———— Typed dependency hashes ————
# kind + the canonical dependency key + the 128-bit digest of "kind|key" at
# record time. The snapshot-relative state recomputes "kind|<current key>"
# for the SAME dependency kind and reports Stale on any difference.
pub struct RationaleDependency
  kind: String = ""
  key: String = ""
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

pub def rationale_dependency(kind: String, key: String) -> RationaleDependency
  let text = kind.clone() + "|" + key.clone()
  let digest = stable_digest_of(&text)
  RationaleDependency {
    kind: kind,
    key: key,
    digest_hi: digest.hi,
    digest_lo: digest.lo
  }
end

pub def rationale_dependency_words(kind: String, key: String, hi: UInt, lo: UInt) -> RationaleDependency
  RationaleDependency { kind: kind, key: key, digest_hi: hi, digest_lo: lo }
end

# ———— The typed record + the sealed state row ————

pub struct RationaleRecord
  origin_revision: String = ""
  kind: RationaleKind = RationaleKind::Optimization
  subject: RationaleSubject = RationaleSubject {}
  decision: String = ""
  reason: String = ""
  evidence: Vec[RationaleEvidence] = Vec::new()
  supporting_dependency_hashes: Vec[RationaleDependency] = Vec::new()
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# ONE query answer: the record plus its snapshot-relative state. The state
# is NOT stored on the record (it is a function of the queried snapshot).
pub struct RationaleRecordState
  record: RationaleRecord = RationaleRecord {}
  state: RationaleState = RationaleState::Valid
end

pub struct RationaleStore
  records: Vec[RationaleRecord] = Vec::new()
end

pub def rationale_store_new() -> RationaleStore
  RationaleStore { records: Vec::new() }
end

# The generic constructor: the digest is NOT set here (rationale_digest /
# rationale_store_add set it; rationale_record_with_digest seals a copy).
pub def rationale_record_new(
  origin_revision: String,
  kind: RationaleKind,
  subject: RationaleSubject,
  decision: String,
  reason: String,
  evidence: Vec[RationaleEvidence],
  supporting_dependency_hashes: Vec[RationaleDependency]
) -> RationaleRecord
  RationaleRecord {
    origin_revision: origin_revision,
    kind: kind,
    subject: subject,
    decision: decision,
    reason: reason,
    evidence: evidence,
    supporting_dependency_hashes: supporting_dependency_hashes
  }
end

# ———— The v2 text codec (legacy v1 reading) ————
# One record is ONE v2 line:
#   v2|origin|kind|subject-kind|subject-id|subject-id-hi|subject-id-lo|
#     subject-digest-hi|subject-digest-lo|decision|reason|deps|evidence
# Every scalar field is escaped so the separators are unambiguous: '\' ->
# "\\", '|' -> "\p", ';' -> "\s", ',' -> "\c", LF -> "\n", CR -> "\r", and
# the EMPTY string -> "\e". Dependency rows are ';'-joined "kind,key,hi,lo"
# rows; evidence rows are ';'-joined "kind,id,hi,lo,present,render" rows
# (every component escaped). The escape makes the text an exact round-trip
# codec; the digest of the TYPED identity preimage is the identity. The
# legacy v1 line "rev|kind|subject|decision|reason|e1;e2;..." is still read
# (its words map onto the typed fields; its rendered evidence rows are
# presentation-only).

def rationale_escape(s: String) -> String
  if s.len() == 0 then
    return "\\e"
  end
  var out = ""
  var i = 0
  while i < s.len() do
    let ch = s.slice(i, i + 1)
    if ch == "\\" then
      out = out + "\\\\"
    elsif ch == "|" then
      out = out + "\\p"
    elsif ch == ";" then
      out = out + "\\s"
    elsif ch == "," then
      out = out + "\\c"
    elsif ch == "\n" then
      out = out + "\\n"
    elsif ch == "\r" then
      out = out + "\\r"
    else
      out = out + ch
    end
    i = i + 1
  end
  out
end

def rationale_unescape(s: String) -> String
  var out = ""
  var i = 0
  while i < s.len() do
    let ch = s.slice(i, i + 1)
    if ch == "\\" && i + 1 < s.len() then
      let nxt = s.slice(i + 1, i + 2)
      if nxt == "\\" then
        out = out + "\\"
      elsif nxt == "p" then
        out = out + "|"
      elsif nxt == "s" then
        out = out + ";"
      elsif nxt == "c" then
        out = out + ","
      elsif nxt == "n" then
        out = out + "\n"
      elsif nxt == "r" then
        out = out + "\r"
      elsif nxt == "e" then
        out = out + ""
      else
        out = out + nxt
      end
      i = i + 2
    else
      out = out + ch
      i = i + 1
    end
  end
  out
end

# Split on unescaped separators (a backslash keeps its next byte in the
# current part, so "\|" never splits and "\;" survives the evidence split).
def rationale_split_unescaped(s: String, sep: String) -> Vec[String]
  var parts: Vec[String] = Vec::new()
  var current = ""
  var i = 0
  while i < s.len() do
    let ch = s.slice(i, i + 1)
    if ch == "\\" && i + 1 < s.len() then
      current = current + ch + s.slice(i + 1, i + 2)
      i = i + 2
    elsif ch == sep then
      parts.push(current.clone())
      current = ""
      i = i + 1
    else
      current = current + ch
      i = i + 1
    end
  end
  parts.push(current)
  parts
end

# The byte index of `needle` at or after `from` (-1 when absent).
pub def rationale_index_of(s: String, needle: String, from: Int) -> Int
  if needle.len() == 0 then
    return -1
  end
  var i = from
  while i + needle.len() <= s.len() do
    if s.slice(i, i + needle.len()) == needle then
      return i
    end
    i = i + 1
  end
  -1
end

# The identity preimage: kind + subject identity + origin revision +
# decision + reason + the stable evidence refs + the dependency rows. A
# presentation evidence row contributes its kind ONLY; the renders and the
# dense locators never enter it.
def rationale_evidence_identity_text(e: RationaleEvidence) -> String
  if e.presentation then
    rationale_lenpref("presentation") + rationale_lenpref(&e.kind)
  else
    rationale_lenpref("evidence") + rationale_lenpref(&e.kind) + rationale_lenpref(&e.id) +
      rationale_lenpref(&e.digest_hi.to_string()) + rationale_lenpref(&e.digest_lo.to_string())
  end
end

def rationale_dependency_identity_text(d: RationaleDependency) -> String
  rationale_lenpref("dependency") + rationale_lenpref(&d.kind) + rationale_lenpref(&d.key) +
    rationale_lenpref(&d.digest_hi.to_string()) + rationale_lenpref(&d.digest_lo.to_string())
end

pub def rationale_identity_text(record: RationaleRecord) -> String
  var text = rationale_lenpref("rationale") +
    rationale_lenpref(&rationale_kind_word(record.kind.clone())) +
    rationale_lenpref(&record.origin_revision) +
    rationale_lenpref(&rationale_subject_identity_key(record.subject.clone())) +
    rationale_lenpref(&record.decision) + rationale_lenpref(&record.reason)
  for e in record.evidence do
    text = text + rationale_evidence_identity_text(e.clone())
  end
  for d in record.supporting_dependency_hashes do
    text = text + rationale_dependency_identity_text(d.clone())
  end
  text
end

# The identity digest of one record.
pub def rationale_digest(record: RationaleRecord) -> StableDigest
  stable_digest_of(&rationale_identity_text(record))
end

# The v2 column texts of the typed row lists (components escaped; the
# separators stay raw so the loader can split them).
def rationale_dependency_rows_text(deps: Vec[RationaleDependency]) -> String
  var out = ""
  var i = 0
  while i < deps.len() do
    if i > 0 then
      out = out + ";"
    end
    let d = deps[i].clone()
    out = out + rationale_escape(d.kind.clone()) + "," + rationale_escape(d.key.clone()) + "," +
      rationale_escape(d.digest_hi.to_string()) + "," + rationale_escape(d.digest_lo.to_string())
    i = i + 1
  end
  out
end

def rationale_evidence_rows_text(evidence: Vec[RationaleEvidence]) -> String
  var out = ""
  var i = 0
  while i < evidence.len() do
    if i > 0 then
      out = out + ";"
    end
    let e = evidence[i].clone()
    let present = if e.presentation then "1" else "0" end
    out = out + rationale_escape(e.kind.clone()) + "," + rationale_escape(e.id.clone()) + "," +
      rationale_escape(e.digest_hi.to_string()) + "," + rationale_escape(e.digest_lo.to_string()) + "," +
      rationale_escape(present) + "," + rationale_escape(e.render.clone())
    i = i + 1
  end
  out
end

# The record's canonical v2 save line (trailing newline included).
pub def rationale_record_text(record: RationaleRecord) -> String
  "v2|" + rationale_escape(record.origin_revision.clone()) + "|" +
    rationale_escape(rationale_kind_word(record.kind.clone())) + "|" +
    rationale_escape(record.subject.kind.clone()) + "|" +
    rationale_escape(record.subject.id.clone()) + "|" +
    rationale_escape(record.subject.id_hi.to_string()) + "|" +
    rationale_escape(record.subject.id_lo.to_string()) + "|" +
    rationale_escape(record.subject.digest_hi.to_string()) + "|" +
    rationale_escape(record.subject.digest_lo.to_string()) + "|" +
    rationale_escape(record.decision.clone()) + "|" +
    rationale_escape(record.reason.clone()) + "|" +
    rationale_dependency_rows_text(record.supporting_dependency_hashes.clone()) + "|" +
    rationale_evidence_rows_text(record.evidence.clone()) + "\n"
end

# The typed row lists of a v2 column text.
def rationale_dependencies_of_text(text: String) -> Vec[RationaleDependency]
  var out: Vec[RationaleDependency] = Vec::new()
  if text.len() == 0 then
    return out
  end
  for row in rationale_split_unescaped(text.clone(), ";") do
    let cells = rationale_split_unescaped(row.clone(), ",")
    if cells.len() == 4 then
      out.push(rationale_dependency_words(
        rationale_unescape(cells[0].clone()),
        rationale_unescape(cells[1].clone()),
        stable_text_to_uint(&rationale_unescape(cells[2].clone())),
        stable_text_to_uint(&rationale_unescape(cells[3].clone()))))
    end
  end
  out
end

def rationale_evidence_of_text(text: String) -> Vec[RationaleEvidence]
  var out: Vec[RationaleEvidence] = Vec::new()
  if text.len() == 0 then
    return out
  end
  for row in rationale_split_unescaped(text.clone(), ";") do
    let cells = rationale_split_unescaped(row.clone(), ",")
    if cells.len() == 6 then
      let present = rationale_unescape(cells[4].clone()) == "1"
      out.push(RationaleEvidence {
        kind: rationale_unescape(cells[0].clone()),
        id: rationale_unescape(cells[1].clone()),
        digest_hi: stable_text_to_uint(&rationale_unescape(cells[2].clone())),
        digest_lo: stable_text_to_uint(&rationale_unescape(cells[3].clone())),
        presentation: present,
        render: rationale_unescape(cells[5].clone())
      })
    end
  end
  out
end

# The subject of the v2 columns: the kind/id/words are restored; the typed
# option fields are collision cargo the identity words already cover, so
# they stay Option::None on a loaded record.
def rationale_subject_of_columns(
  kind: String, id: String, id_hi: UInt, id_lo: UInt, digest_hi: UInt, digest_lo: UInt
) -> RationaleSubject
  var subject = rationale_subject_of_parts(kind, id, id_hi, id_lo, id)
  subject.digest_hi = digest_hi
  subject.digest_lo = digest_lo
  subject
end

def rationale_record_of_v2(parts: Vec[String]) -> Option[RationaleRecord]
  if parts.len() != 13 then
    return Option::None
  end
  match rationale_kind_of_word(rationale_unescape(parts[2].clone()))
  when Option::Some(kind) then
    Option::Some(RationaleRecord {
      origin_revision: rationale_unescape(parts[1].clone()),
      kind: kind,
      subject: rationale_subject_of_columns(
        rationale_unescape(parts[3].clone()),
        rationale_unescape(parts[4].clone()),
        stable_text_to_uint(&rationale_unescape(parts[5].clone())),
        stable_text_to_uint(&rationale_unescape(parts[6].clone())),
        stable_text_to_uint(&rationale_unescape(parts[7].clone())),
        stable_text_to_uint(&rationale_unescape(parts[8].clone()))),
      decision: rationale_unescape(parts[9].clone()),
      reason: rationale_unescape(parts[10].clone()),
      supporting_dependency_hashes: rationale_dependencies_of_text(parts[11].clone()),
      evidence: rationale_evidence_of_text(parts[12].clone())
    })
  when Option::None then
    Option::None
  end
end

# The legacy v1 record: the six columns map onto the typed fields (an
# unknown kind word degrades to Optimization; a rendered evidence row is
# presentation-only).
def rationale_record_of_v1(parts: Vec[String]) -> RationaleRecord
  let kind = match rationale_kind_of_word(rationale_unescape(parts[1].clone()))
    when Option::Some(k) then k
    when Option::None then RationaleKind::Optimization
  end
  var evidence: Vec[RationaleEvidence] = Vec::new()
  let evidence_text = parts[5].clone()
  if evidence_text.len() > 0 then
    for part in rationale_split_unescaped(evidence_text.clone(), ";") do
      let row = rationale_unescape(part.clone())
      let mark = rationale_index_of(&row, ":", 0)
      if mark > 0 then
        evidence.push(rationale_evidence_presentation(row.slice(0, mark),
          row.slice(mark + 1, row.len()), row))
      else
        evidence.push(rationale_evidence_presentation("legacy-row".to_string(), row.clone(), row))
      end
    end
  end
  RationaleRecord {
    origin_revision: rationale_unescape(parts[0].clone()),
    kind: kind,
    subject: rationale_subject_of_text(rationale_unescape(parts[2].clone())),
    decision: rationale_unescape(parts[3].clone()),
    reason: rationale_unescape(parts[4].clone()),
    evidence: evidence,
    supporting_dependency_hashes: Vec::new()
  }
end

# The record with its identity digest fields sealed. rationale_store_add
# returns the digest; this constructor is for callers that need the sealed
# record value itself.
pub def rationale_record_with_digest(record: RationaleRecord) -> RationaleRecord
  let digest = rationale_digest(record.clone())
  var out = record.clone()
  out.digest_hi = digest.hi
  out.digest_lo = digest.lo
  out
end

# ═══════════════════════════════════════════════════════════════
# 2. THE FIVE GROUNDED SOURCE CONSTRUCTORS (typed)
# ═══════════════════════════════════════════════════════════════

# OptimizationDecision -> Optimization. subject = the containing fn's
# stable declaration (Decl); the pass word is a STABLE evidence reference,
# the site locator is PRESENTATION-only evidence (it never enters the
# identity); the function's symbol row is the supporting dependency.
pub def rationale_of_optimization_decision(
  origin_revision: String, decision: OptimizationDecision
) -> RationaleRecord
  var evidence: Vec[RationaleEvidence] = Vec::new()
  evidence.push(rationale_evidence("pass".to_string(), decision.pass.clone()))
  evidence.push(rationale_evidence_presentation("site".to_string(), decision.site.clone(), decision.site.clone()))
  var deps: Vec[RationaleDependency] = Vec::new()
  deps.push(rationale_dependency("symbol".to_string(), decision.symbol.clone()))
  RationaleRecord {
    origin_revision: origin_revision,
    kind: RationaleKind::Optimization,
    subject: rationale_subject_of_decl_key(decision.symbol.clone()),
    decision: decision.decision.clone(),
    reason: decision.reason.clone(),
    evidence: evidence,
    supporting_dependency_hashes: deps
  }
end

# DiagnosticRecord -> Diagnostic. subject = the typed diagnostic subject
# converted to the rationale union; decision = the diagnostic code; reason
# = the recorded message; the id render + semantic class are stable
# evidence refs and every typed related row is presentation-only evidence.
# The subject's snapshot row (symbol / place / MIR / contract / effect /
# ABI) is the supporting dependency.
pub def rationale_of_diagnostic_record(
  origin_revision: String, record: DiagnosticRecord
) -> RationaleRecord
  let subject = rationale_subject_of_diagnostic_subject(record.id.subject.clone())
  var evidence: Vec[RationaleEvidence] = Vec::new()
  evidence.push(rationale_evidence("diagnostic".to_string(), stable_diagnostic_id_text(record.id.clone())))
  evidence.push(rationale_evidence("semantic-kind".to_string(), record.semantic_kind.clone()))
  for row in record.related do
    evidence.push(rationale_evidence_presentation("related".to_string(), row.clone(), row.clone()))
  end
  var deps: Vec[RationaleDependency] = Vec::new()
  if rationale_subject_has_snapshot_dependency(subject.clone()) then
    deps.push(rationale_dependency(
      rationale_subject_dependency_kind(subject.clone()),
      rationale_subject_dependency_key(subject.clone())))
  end
  RationaleRecord {
    origin_revision: origin_revision,
    kind: RationaleKind::Diagnostic,
    subject: subject,
    decision: record.id.code.clone(),
    reason: record.message.clone(),
    evidence: evidence,
    supporting_dependency_hashes: deps
  }
end

# Whether the subject kind has a snapshot row family the state check can
# read (HIR nodes / handles / none do not).
def rationale_subject_has_snapshot_dependency(subject: RationaleSubject) -> Bool
  subject.kind == "decl" || subject.kind == "place" || subject.kind == "mir-node" ||
    subject.kind == "contract" || subject.kind == "effect" || subject.kind == "abi"
end

# The dependency kind of a subject kind.
def rationale_subject_dependency_kind(subject: RationaleSubject) -> String
  if subject.kind == "decl" then return "symbol" end
  if subject.kind == "place" then return "place" end
  if subject.kind == "mir-node" then return "mir-function" end
  if subject.kind == "contract" then return "contract" end
  if subject.kind == "effect" then return "effect" end
  if subject.kind == "abi" then return "abi" end
  "subject"
end

# The dependency key of a subject (a MIR node depends on its FUNCTION's
# summary row, not the node identity).
def rationale_subject_dependency_key(subject: RationaleSubject) -> String
  if subject.kind == "mir-node" then
    match subject.mir_node.clone()
    when Option::Some(node) then return node.function_key.clone()
    when Option::None then ()
    end
  end
  subject.id.clone()
end

# ONE deterministic summary row of a delta: the per-table row counts plus
# the closure size. This is the delta record's reason text (and the audit's
# "SemanticDelta summary row").
pub def semantic_delta_summary_row(delta: SemanticDelta) -> String
  "created:" + delta.created.len().to_string() +
    " removed:" + delta.removed.len().to_string() +
    " modified:" + delta.modified.len().to_string() +
    " call:" + delta.call_delta.len().to_string() +
    " effect:" + delta.effect_delta.len().to_string() +
    " capability:" + delta.capability_delta.len().to_string() +
    " ownership:" + delta.ownership_delta.len().to_string() +
    " contract:" + delta.contract_delta.len().to_string() +
    " unsafe-created:" + delta.unsafe_delta.created.len().to_string() +
    " unsafe-removed:" + delta.unsafe_delta.removed.len().to_string() +
    " affected:" + delta.affected.len().to_string()
end

# SemanticDelta -> Delta. subject = a content-addressed handle
# "delta:<digest render>" (its digest words are the handle's stable digest);
# deps = the affected-set entity keys; evidence = the digest reference.
pub def rationale_of_delta(origin_revision: String, delta: SemanticDelta) -> RationaleRecord
  let digest = semantic_delta_digest(&delta)
  let digest_text = semantic_digest_render(&digest)
  var deps: Vec[RationaleDependency] = Vec::new()
  for key in delta.affected.clone() do
    deps.push(rationale_dependency("affected".to_string(), key.clone()))
  end
  RationaleRecord {
    origin_revision: origin_revision,
    kind: RationaleKind::Delta,
    subject: rationale_subject_of_handle("delta:" + digest_text.clone()),
    decision: "delta-summary".to_string(),
    reason: semantic_delta_summary_row(&delta),
    evidence: Vec::from([rationale_evidence("delta-digest".to_string(), digest_text)]),
    supporting_dependency_hashes: deps
  }
end

# budget_verify rows -> Budget. Empty violations = "budget-verified" with
# reason "no violations"; any violation = "budget-violated" with the first
# violation as the reason and the whole fail-closed list as typed evidence.
pub def rationale_of_budget_rows(
  origin_revision: String, subject: String, violations: Vec[String]
) -> RationaleRecord
  var decision = "budget-verified".to_string()
  var reason = "no violations".to_string()
  if violations.len() > 0 then
    decision = "budget-violated".to_string()
    reason = violations[0].clone()
  end
  var evidence: Vec[RationaleEvidence] = Vec::new()
  for row in violations do
    evidence.push(rationale_evidence("violation".to_string(), row.clone()))
  end
  RationaleRecord {
    origin_revision: origin_revision,
    kind: RationaleKind::Budget,
    subject: rationale_subject_of_text(subject),
    decision: decision,
    reason: reason,
    evidence: evidence,
    supporting_dependency_hashes: Vec::new()
  }
end

# The budget source in one call: the §36 verifier runs HERE (budget_verify)
# and its rows ground the record.
pub def rationale_of_budget(
  origin_revision: String, subject: String, budget: ChangeBudget, delta: SemanticDelta
) -> RationaleRecord
  rationale_of_budget_rows(origin_revision, subject, budget_verify(&budget, &delta))
end

# EquivalenceResult -> Equivalence. decision = the exact level word,
# reason = the result's detail text, evidence = the level + the canonical
# render (both stable references). The level word is read through
# equivalence_level_word, never inferred from the detail (the claim
# discipline travels with the level).
pub def rationale_of_equivalence(
  origin_revision: String, subject: String, result: EquivalenceResult
) -> RationaleRecord
  let render = equivalence_result_render(result.clone())
  match result
  when EquivalenceResult::EquivalenceOutcome(level, detail) then
    let word = equivalence_level_word(level)
    var evidence: Vec[RationaleEvidence] = Vec::new()
    evidence.push(rationale_evidence("level".to_string(), word.clone()))
    evidence.push(rationale_evidence("render".to_string(), render))
    RationaleRecord {
      origin_revision: origin_revision,
      kind: RationaleKind::Equivalence,
      subject: rationale_subject_of_text(subject),
      decision: word,
      reason: detail,
      evidence: evidence,
      supporting_dependency_hashes: Vec::new()
    }
  end
end

# ═══════════════════════════════════════════════════════════════
# 3. THE STORE API + THE SNAPSHOT-RELATIVE STATE
# ═══════════════════════════════════════════════════════════════

# Append ONE record: the digest is recomputed from the record content (the
# caller's digest fields are ignored), and a record whose digest is already
# stored is IDEMPOTENT — the existing digest is returned and no second row
# is appended (the diagnostic_store_add idempotency rule).
pub def rationale_store_add(
  inout store: RationaleStore, record: RationaleRecord
) -> StableDigest
  let digest = rationale_digest(record.clone())
  var i = 0
  while i < store.records.len() do
    if store.records[i].digest_hi == digest.hi && store.records[i].digest_lo == digest.lo then
      return digest
    end
    i = i + 1
  end
  var stored = record.clone()
  stored.digest_hi = digest.hi
  stored.digest_lo = digest.lo
  store.records.push(stored)
  digest
end

pub def rationale_store_add_all(
  inout store: RationaleStore, records: Vec[RationaleRecord]
) -> Vec[StableDigest]
  var out: Vec[StableDigest] = Vec::new()
  for record in records do
    out.push(rationale_store_add(store, record.clone()))
  end
  out
end

pub def rationale_store_len(store: RationaleStore) -> Int
  store.records.len()
end

# The deterministic record order: origin revision, then kind word, then
# decision, then the identity digest render (the final tiebreak). No
# insertion order and no Map order ever reaches a query.
def rationale_record_sort_key(record: RationaleRecord) -> String
  record.origin_revision.clone() + "|" + rationale_kind_word(record.kind.clone()) + "|" +
    record.decision.clone() + "|" + semantic_digest_render(&rationale_digest(record.clone()))
end

def rationale_record_sort_lt(a: RationaleRecord, b: RationaleRecord) -> Bool
  rationale_record_sort_key(a.clone()) < rationale_record_sort_key(b.clone())
end

pub def rationale_store_all(store: RationaleStore) -> Vec[RationaleRecord]
  var out: Vec[RationaleRecord] = Vec::new()
  for record in store.records do
    out.push(record.clone())
  end
  out.sort_by(|a, b| rationale_record_sort_lt(a, b))
  out
end

# ———— The snapshot-side dependency checks ————

# The current canonical key of a snapshot symbol matching `key`: the exact
# full def key, else the symbol whose registration part (before '#')
# equals `key`. Option::None when no symbol row matches.
def rationale_snapshot_symbol_key(snapshot: SemanticSnapshot, key: String) -> Option[String]
  for sym in snapshot.symbols do
    let sym_key = sym.stable_id.key.clone()
    if sym_key == key || stable_key_name_part(&sym_key) == key then
      return Option::Some(sym_key)
    end
  end
  Option::None
end

def rationale_snapshot_place_key(snapshot: SemanticSnapshot, place_key: String) -> Option[String]
  for fact in snapshot.ownership do
    if fact.place_key == place_key then
      return Option::Some(fact.place_key.clone())
    end
  end
  Option::None
end

def rationale_snapshot_mir_function_key(snapshot: SemanticSnapshot, key: String) -> Option[String]
  for row in snapshot.mir_functions do
    if row.function.key == key then
      return Option::Some(row.function.key.clone())
    end
  end
  Option::None
end

def rationale_snapshot_effect_key(snapshot: SemanticSnapshot, key: String) -> Option[String]
  for e in snapshot.effects do
    if e.function.key == key then
      return Option::Some(e.function.key.clone() + "|" + e.purity_status.clone())
    end
  end
  Option::None
end

def rationale_snapshot_contract_key(snapshot: SemanticSnapshot, key: String) -> Option[String]
  for c in snapshot.contracts do
    if c.id.stable_key == key then
      return Option::Some(c.id.stable_key.clone() + "|" +
        c.expression_fingerprint.hi.to_string() + "-" + c.expression_fingerprint.lo.to_string())
    end
  end
  Option::None
end

def rationale_snapshot_abi_key(snapshot: SemanticSnapshot, key: String) -> Option[String]
  for row in snapshot.abi_surfaces do
    if row.surface_id == key || row.symbol_key == key then
      return Option::Some(semantic_abi_surface_row_text(row.clone()))
    end
  end
  Option::None
end

# The current canonical key of a recorded dependency: the kind routes to
# the snapshot table; a missing row is Option::None (Stale). Kinds with no
# snapshot table keep the recorded key (the dependency text is the
# content-addressed handle itself); an "affected" def-shaped key still
# requires a live symbol row so a deleted entity is Stale.
def rationale_dependency_current_key(
  snapshot: SemanticSnapshot, dep: RationaleDependency
) -> Option[String]
  if dep.kind == "symbol" then
    return rationale_snapshot_symbol_key(&snapshot, dep.key.clone())
  end
  if dep.kind == "place" then
    return rationale_snapshot_place_key(&snapshot, dep.key.clone())
  end
  if dep.kind == "mir-function" then
    return rationale_snapshot_mir_function_key(&snapshot, dep.key.clone())
  end
  if dep.kind == "effect" then
    return rationale_snapshot_effect_key(&snapshot, dep.key.clone())
  end
  if dep.kind == "contract" then
    return rationale_snapshot_contract_key(&snapshot, dep.key.clone())
  end
  if dep.kind == "abi" then
    return rationale_snapshot_abi_key(&snapshot, dep.key.clone())
  end
  if dep.kind == "affected" && rationale_index_of(&dep.key, "#", 0) > 0 then
    return rationale_snapshot_symbol_key(&snapshot, dep.key.clone())
  end
  Option::Some(dep.key.clone())
end

# Whether the record's subject still exists in the snapshot. The subject
# kinds with a RELIABLE snapshot table (Decl, and MIR-node once the MIR
# table is populated) are checked; the kinds without one (HIR nodes,
# handles, none) are never invalidated by absence — their dependencies
# still gate the state.
pub def rationale_subject_exists(snapshot: SemanticSnapshot, subject: RationaleSubject) -> Bool
  if subject.kind == "decl" then
    match rationale_snapshot_symbol_key(&snapshot, subject.id.clone())
    when Option::Some(_) then return true
    when Option::None then return false
    end
  end
  if subject.kind == "mir-node" then
    match subject.mir_node.clone()
    when Option::Some(node) then
      if snapshot.mir_functions.len() == 0 then
        return true
      end
      match rationale_snapshot_mir_function_key(&snapshot, node.function_key.clone())
      when Option::Some(_) then return true
      when Option::None then return false
      end
    when Option::None then return true
    end
  end
  true
end

# The snapshot-relative state of ONE record:
#   - Invalidated when the subject no longer exists in the snapshot;
#   - Stale when any recorded dependency hash differs from the current
#     snapshot row (the row changed, moved or disappeared);
#   - Valid otherwise.
pub def rationale_state_of(
  store: RationaleStore, record: RationaleRecord, current_snapshot: SemanticSnapshot
) -> RationaleState
  if !rationale_subject_exists(&current_snapshot, record.subject.clone()) then
    return RationaleState::Invalidated
  end
  for dep in record.supporting_dependency_hashes do
    match rationale_dependency_current_key(&current_snapshot, dep.clone())
    when Option::Some(current_key) then
      let current_text = dep.kind.clone() + "|" + current_key.clone()
      let expected = stable_digest_of(&current_text)
      if expected.hi != dep.digest_hi || expected.lo != dep.digest_lo then
        return RationaleState::Stale
      end
    when Option::None then
      return RationaleState::Stale
    end
  end
  RationaleState::Valid
end

# The boolean form: anything but Valid is a stale answer (Stale or
# Invalidated) — a consumer that only needs "do not trust this record".
pub def rationale_stale(
  store: RationaleStore, record: RationaleRecord, current_snapshot: SemanticSnapshot
) -> Bool
  rationale_state_of(store, record, current_snapshot) != RationaleState::Valid
end

# The records of ONE typed subject (identity match on the subject identity
# key), each carrying its state against the current snapshot, in the
# deterministic order above.
pub def rationale_for_subject(
  store: RationaleStore, subject: RationaleSubject, current_snapshot: SemanticSnapshot
) -> Vec[RationaleRecordState]
  var out: Vec[RationaleRecordState] = Vec::new()
  let state_store = store.clone()
  for record in store.records do
    if rationale_subject_matches(record.subject.clone(), subject.clone()) then
      out.push(RationaleRecordState {
        record: record.clone(),
        state: rationale_state_of(state_store.clone(), record.clone(), current_snapshot.clone())
      })
    end
  end
  out.sort_by(|a, b| rationale_record_sort_lt(a.record.clone(), b.record.clone()))
  out
end

# The text-entry form of the subject query (the caller hands the canonical
# subject key/handle text; the boundary parses it into the typed union).
pub def rationale_for_subject_text(
  store: RationaleStore, subject_text: String, current_snapshot: SemanticSnapshot
) -> Vec[RationaleRecordState]
  rationale_for_subject(store, rationale_subject_of_text(subject_text), current_snapshot)
end

# The canonical store text: one v2 record line per record, in INSERTION
# order (the history order). Not the identity — load recomputes each
# record's digest.
pub def rationale_store_save(store: RationaleStore) -> String
  var out = ""
  for record in store.records do
    out = out + rationale_record_text(record.clone())
  end
  out
end

# The store of a canonical store text: every line parses the v2 grammar or
# the legacy v1 grammar and its fields are unescaped; the identity digests
# are RECOMPUTED (the text carries no digest words). TOTAL loader: a
# malformed line is skipped, never a fabricated record. Duplicate records
# collapse through rationale_store_add's idempotency.
pub def rationale_store_load(text: String) -> RationaleStore
  var store = rationale_store_new()
  for line in text.lines() do
    let parts = rationale_split_unescaped(line.clone(), "|")
    if parts.len() == 13 && rationale_unescape(parts[0].clone()) == "v2" then
      match rationale_record_of_v2(parts.clone())
      when Option::Some(record) then
        rationale_store_add(&mut store, record)
        ()
      when Option::None then ()
      end
    elsif parts.len() == 6 then
      rationale_store_add(&mut store, rationale_record_of_v1(parts.clone()))
    end
  end
  store
end

# The content-addressed digest of the whole history: over the SORTED records
# (order-independent — two stores holding the same records digest equal
# whatever their insertion order was).
pub def rationale_store_digest(store: RationaleStore) -> StableDigest
  var text = ""
  for record in rationale_store_all(store.clone()) do
    text = text + rationale_record_text(record.clone())
  end
  stable_digest_of(&text)
end

# ═══════════════════════════════════════════════════════════════
# 4. THE SEMANTIC-TOOL DISCOVERY SURFACE
# ═══════════════════════════════════════════════════════════════
# ONE SemanticTool per implemented semantic operation family. capability is
# the handler/operation family word; inputs / outputs are the honest
# argument and answer descriptions (the wire-record families are named as
# "wire:<Record>" in outputs — the third-audit item-22 typed records, not
# synthetic op names); stability is "stable" or "experimental" per the
# module doc's rule; requires_mir / requires_coverage / requires_store say
# which caller-supplied artifact the FULL answer needs (an op may still
# answer a documented "<op>_unavailable" form without it).

pub struct SemanticTool
  name: String = ""
  capability: String = ""
  inputs: String = ""
  outputs: String = ""
  stability: String = ""
  requires_mir: Bool = false
  requires_coverage: Bool = false
  requires_store: Bool = false
end

def semantic_tool_row(
  name: String,
  capability: String,
  inputs: String,
  outputs: String,
  stability: String,
  requires_mir: Bool,
  requires_coverage: Bool,
  requires_store: Bool
) -> SemanticTool
  SemanticTool {
    name: name,
    capability: capability,
    inputs: inputs,
    outputs: outputs,
    stability: stability,
    requires_mir: requires_mir,
    requires_coverage: requires_coverage,
    requires_store: requires_store
  }
end

def tool_index(name: String, inputs: String, outputs: String) -> SemanticTool
  semantic_tool_row(name, "index", inputs, outputs, "stable", false, false, false)
end

def tool_index_coverage(name: String, inputs: String, outputs: String) -> SemanticTool
  semantic_tool_row(name, "index", inputs, outputs, "experimental", false, true, false)
end

def tool_explain(name: String, inputs: String, outputs: String) -> SemanticTool
  semantic_tool_row(name, "explain", inputs, outputs, "stable", false, false, false)
end

def tool_mir(name: String, inputs: String, outputs: String) -> SemanticTool
  semantic_tool_row(name, "mir", inputs, outputs, "experimental", true, false, false)
end

def tool_session(
  name: String, capability: String, inputs: String, outputs: String
) -> SemanticTool
  semantic_tool_row(name, capability, inputs, outputs, "stable", false, false, false)
end

def tool_experimental(
  name: String,
  capability: String,
  inputs: String,
  outputs: String,
  requires_mir: Bool,
  requires_coverage: Bool,
  requires_store: Bool
) -> SemanticTool
  semantic_tool_row(name, capability, inputs, outputs, "experimental",
    requires_mir, requires_coverage, requires_store)
end

# The explicit metadata rows for every name of the §39 registry (59 ops) —
# the audit's enumeration, anchored per family in the module doc. A
# registry name absent here still appears via the conservative default row
# below; the lane pins that every CURRENT registry name resolves here.
def semantic_tool_table() -> Vec[SemanticTool]
  Vec::from([
    # ———— §39 registry: the index family (§32 SemanticIndex) ————
    tool_index("callers", "fn stable key", "wire:CallersResponse: sorted caller fn stable keys"),
    tool_index("callees", "fn stable key", "wire:CalleesResponse: sorted callee fn stable keys"),
    tool_index("types", "symbol stable key", "wire:TypeResponse: type stable keys of the symbol"),
    tool_index("effects", "fn stable key", "wire:EffectsResponse: the §11 effect summary row"),
    tool_index("capabilities", "fn stable key", "wire:EffectsResponse: capability row keys"),
    tool_index("purity.get", "fn stable key", "ordered purity status + evidence rows"),
    tool_index("contracts", "fn stable key", "wire:ContractResponse: contract row keys"),
    tool_index("fields", "type stable key", "wire:TypeResponse: field rows"),
    tool_index("impls", "type or trait stable key", "sorted impl row keys"),
    tool_index("properties", "type stable key", "sorted property rows"),
    tool_index("mir_function", "fn stable key", "wire:MirFunctionResponse: coarse MIR summary rows"),
    tool_index("symbol_get", "def key or symbol name", "wire:SymbolsResponse: matching symbol stable keys"),
    tool_index("symbol_search", "name substring", "wire:SymbolsResponse: matching symbol stable keys"),
    tool_index("contract_list", "fn stable key", "wire:ContractResponse: contract clause rows"),
    tool_index("type_explain", "type stable key", "type explanation rows"),
    tool_index("ownership_explain", "symbol or place key", "sorted ownership row keys"),
    tool_index_coverage("test.affected", "changed symbol stable key", "covering test stable keys (empty without ingested coverage)"),
    tool_index_coverage("coverage.affected", "symbol stable key", "coverage point rows (empty without ingested coverage)"),

    # ———— §39 registry: the mir family (needs the session's final MIR) ————
    tool_mir("mir_slice", "<slice kind>|<fn key>|<anchor>", "sorted §33 statement keys + the typed MirSlice payload"),
    tool_mir("mir.dominators", "fn stable key", "sorted dominator block rows"),
    tool_mir("mir.postdominators", "fn stable key", "sorted postdominator block rows"),
    tool_mir("mir.loops", "fn stable key", "sorted natural-loop rows"),
    tool_mir("mir.control", "fn stable key", "sorted control-dependence rows"),
    tool_mir("mir.path", "fn stable key|node key", "the path's sorted statement keys"),
    tool_mir("mir.reaching", "fn stable key|use node key", "sorted reaching-definition rows"),
    tool_mir("mir.diff", "fn stable key A|fn stable key B", "normalized-MIR diff rows"),
    # The §38 dispatch arm that was missing from the §39 registry
    # (semantic_query.tg:2428 dispatches mir.block; the server_operations
    # Vec listed the other seven graph ops): the registry row is NOW
    # registered (semantic_server.tg's mir family), so the registry walk
    # resolves this metadata row directly. The supplemental list still
    # carries a deduped backup entry (registry rows win).
    tool_mir("mir.block", "block key <fn>#B<id>", "sorted stable statement-id rows"),

    # ———— §39 registry: the explain family (audit item 52 trees) ————
    tool_explain("type.explain", "type stable key", "indented derivation tree lines"),
    tool_explain("trait.resolve", "subject stable key", "typed impl keys (the §38 index answer)"),
    tool_explain("trait.explain", "subject stable key", "indented derivation tree lines"),
    tool_explain("ownership.explain", "symbol or place key", "indented derivation tree lines"),
    tool_explain("effect.explain", "fn stable key", "indented derivation tree lines"),
    tool_explain("capability.explain", "fn stable key", "indented derivation tree lines"),
    tool_explain("layout.explain", "type stable key", "indented tree lines (the documented 'not available from snapshot rows' leaf without a layout row)"),
    tool_explain("optimization.explain", "fn stable key", "indented tree lines (the documented not-available leaf: no optimization rows ride a snapshot)"),
    tool_experimental("diagnostic.explain", "explain", "diagnostic id render or store index", "indented derivation tree lines", false, false, true),

    # ———— §39 registry: type / ownership / contract / symbol families ————
    tool_session("type.get", "type", "type stable key", "wire:TypeResponse: the type row"),
    tool_session("type.layout", "type", "type stable key", "layout / alignment rows"),
    tool_session("type.properties", "type", "type stable key", "sorted property rows"),
    tool_session("ownership.moves", "ownership", "fn stable key", "wire:OwnershipResponse: move rows"),
    tool_session("ownership.drop_plan", "ownership", "fn stable key", "wire:OwnershipResponse: drop-plan rows"),
    tool_session("contract.obligations", "contract", "fn stable key", "wire:ContractResponse: recorded obligation rows"),
    tool_session("contract.verify", "contract", "fn stable key", "contract verification rows"),
    tool_session("symbol.references", "symbol", "symbol stable key", "sorted reference rows"),

    # ———— §39 registry: snapshot / plan / edit / diagnostic / replay / service ————
    tool_session("snapshot.get", "snapshot", "none (uses the session snapshot)", "revision + table summary rows"),
    tool_experimental("snapshot.diff", "snapshot", "none (delta-scoped)", "snapshot.diff_unavailable (use session_delta / semantic_delta_of)", false, false, false),
    tool_experimental("edit.apply", "edit", "source + the edit payload grammar", "edited source + expected §31 delta rows", false, false, false),
    tool_session("build.plan", "plan", "none (uses the session evidence)", "wire:PlanResponse: build plan rows"),
    tool_session("verify.plan", "plan", "none (uses the session evidence)", "wire:PlanResponse: verification plan rows"),
    tool_experimental("diagnostic.get", "diagnostic", "diagnostic id render or store index", "wire:DiagnosticResponse: record rows", false, false, true),
    tool_experimental("diagnostic.repair_context", "diagnostic", "diagnostic id render or store index", "repair context rows", false, false, true),
    tool_experimental("replay.trace_rows", "replay", "EventTrace payload", "canonical event rows", false, false, false),
    tool_experimental("replay.digest", "replay", "EventTrace payload", "the trace digest row", false, false, false),
    tool_experimental("replay.writes_to", "replay", "EventTrace + place", "event rows writing the place", false, false, false),
    tool_experimental("replay.value_at", "replay", "EventTrace + place", "value rows", false, false, false),
    tool_experimental("replay.causal_predecessors", "replay", "EventTrace + event index", "causal predecessor rows", false, false, false),
    tool_experimental("replay.first_divergence", "replay", "two EventTraces", "first-divergence rows", false, false, false),
    tool_experimental("replay.minimal_causal_slice", "replay", "EventTrace + event index", "minimal causal slice rows", false, false, false),
    # (P1-9) the typed record/run/compare registry rows: the module-scope
    # replay_query interface carries the trace (a §38 session carries
    # none), so these are trace-payload operations like their siblings.
    tool_experimental("replay.record", "replay", "revision + typed choice supplies", "an EventTrace", false, false, false),
    tool_experimental("replay.run", "replay", "EventTrace payload", "the deterministic choice stream rows", false, false, false),
    tool_experimental("replay.diff", "replay", "two EventTraces", "semantic first-divergence rows", false, false, false),
    tool_session("revision", "service", "none", "the revision digest render")
  ])
end

# The §38-dispatch / export supplement: implemented operations that the §39
# registry does not carry (delta-scoped probes, the ABI / perf report
# engines, the typed-hole surface, the missing registry row mir.block, and
# this module's rationale surface). Names are the callers' real exported
# operation names; nothing synthetic is invented.
def semantic_tools_supplemental() -> Vec[SemanticTool]
  Vec::from([
    tool_session("type.use", "type", "type stable key", "sorted use-of-type rows"),
    tool_experimental("change.affected", "change", "SemanticDelta + stable key", "affected-closure membership (Bool)", false, false, false),
    tool_experimental("change.semantic_diff", "change", "SemanticDelta", "wire:DeltaResponse: modified stable ids + affected closure", false, false, false),
    tool_experimental("abi.inspect", "abi", "SemanticDelta", "wire:AbiResponse: changed ABI surface rows", false, false, false),
    tool_experimental("abi.diff", "abi", "two ABI row sets", "layout / arg-location diff rows", false, false, false),
    tool_experimental("abi.ffi_report", "abi", "symbol stable key + snapshot", "FfiReport rows", false, false, false),
    tool_experimental("abi.rows", "abi", "SemanticSnapshot", "canonical ABI surface row texts", false, false, false),
    tool_experimental("perf.report.mir", "perf", "optimized MirFunction", "PerfReport aggregates", true, false, false),
    tool_experimental("perf.report.lir", "perf", "LirAlloc", "PerfReport aggregates (spills / reloads / stack bytes)", false, false, false),
    tool_experimental("perf.reports", "perf", "optimized MirProgram", "per-function PerfReports sorted by fn key", true, false, false),
    tool_experimental("perf.facts.mir", "perf", "MirFunction", "labeled PerfFact rows + provenance", true, false, false),
    tool_experimental("perf.facts.lir", "perf", "LirAlloc", "labeled PerfFact rows + provenance", false, false, false),
    tool_experimental("hole.constraints", "holes", "TypedProgram + hole node id", "typed-hole constraint rows", false, false, false),
    tool_experimental("mir.block", "mir", "block key <fn>#B<id>", "sorted stable statement-id rows", true, false, false),
    tool_experimental("rationale.add", "rationale", "RationaleRecord", "record identity digest (idempotent)", false, false, true),
    tool_experimental("rationale.save", "rationale", "RationaleStore", "JSONL store text", false, false, true),
    tool_experimental("rationale.load", "rationale", "JSONL store text", "RationaleStore (total; malformed lines skipped)", false, false, false),
    tool_experimental("rationale.for_subject", "rationale", "subject text", "sorted matching records", false, false, true),
    tool_experimental("rationale.store_digest", "rationale", "RationaleStore", "content-addressed history digest", false, false, true)
  ])
end

def semantic_tool_lookup(name: String) -> Option[SemanticTool]
  for tool in semantic_tool_table() do
    if tool.name == name then
      return Option::Some(tool.clone())
    end
  end
  Option::None
end

def semantic_tools_has(tools: Vec[SemanticTool], name: String) -> Bool
  for tool in tools do
    if tool.name == name then
      return true
    end
  end
  false
end

# The conservative default for a registry name with no explicit metadata
# row: it is still listed (never silently dropped) with experimental
# stability and the requires flags its handler family implies.
def semantic_tool_default(op: ServerOperation) -> SemanticTool
  semantic_tool_row(
    op.name.clone(),
    op.handler_kind.clone(),
    "registry:" + op.handler_kind.clone(),
    "registry:" + op.handler_kind.clone(),
    "experimental",
    op.handler_kind == "mir",
    false,
    op.handler_kind == "diagnostic"
  )
end

# (a) the live registry walk: every §39 server_operations() name, explicit
# metadata when the table has it, the conservative default otherwise.
def semantic_tools_from_registry() -> Vec[SemanticTool]
  var out: Vec[SemanticTool] = Vec::new()
  for op in server_operations() do
    match semantic_tool_lookup(op.name.clone())
    when Option::Some(tool) then
      if !semantic_tools_has(out.clone(), tool.name.clone()) then
        out.push(tool)
      end
    when Option::None then
      if !semantic_tools_has(out.clone(), op.name.clone()) then
        out.push(semantic_tool_default(op.clone()))
      end
    end
  end
  out
end

# The discovery surface: registry walk + supplement, deduped by name
# (registry rows win), byte-sorted by name. Deterministic on every call.
pub def semantic_tools() -> Vec[SemanticTool]
  var out = semantic_tools_from_registry()
  for tool in semantic_tools_supplemental() do
    if !semantic_tools_has(out.clone(), tool.name.clone()) then
      out.push(tool)
    end
  end
  out.sort_by(|a, b| a.name < b.name)
  out
end

pub def tool_for(name: String) -> Option[SemanticTool]
  for tool in semantic_tools() do
    if tool.name == name then
      return Option::Some(tool.clone())
    end
  end
  Option::None
end

pub def tools_requiring_mir() -> Vec[SemanticTool]
  var out: Vec[SemanticTool] = Vec::new()
  for tool in semantic_tools() do
    if tool.requires_mir then
      out.push(tool.clone())
    end
  end
  out
end

pub def tools_requiring_coverage() -> Vec[SemanticTool]
  var out: Vec[SemanticTool] = Vec::new()
  for tool in semantic_tools() do
    if tool.requires_coverage then
      out.push(tool.clone())
    end
  end
  out
end

pub def tools_requiring_store() -> Vec[SemanticTool]
  var out: Vec[SemanticTool] = Vec::new()
  for tool in semantic_tools() do
    if tool.requires_store then
      out.push(tool.clone())
    end
  end
  out
end

# ═══════════════════════════════════════════════════════════════
# 5. THE EXECUTABLE LANES
# ═══════════════════════════════════════════════════════════════
# The sibling lane style (semantic_diagnostics_lane_check /
# semantic_planning_lane_check): each helper row returns the mismatch texts;
# an empty list verifies. R1-R5 are the rationale history rows, T1-T3 the
# tool-discovery rows.

def rationale_lane_bool(inout out: Vec[String], name: String, ok: Bool) -> Unit
  if !ok then
    out.push(name + ": expected true")
  end
  ()
end

def rationale_lane_int(inout out: Vec[String], name: String, got: Int, expected: Int) -> Unit
  if got != expected then
    out.push(name + ": expected " + expected.to_string() + ", got " + got.to_string())
  end
  ()
end

def rationale_lane_text(inout out: Vec[String], name: String, got: String, expected: String) -> Unit
  if got != expected then
    out.push(name + ": expected '" + expected + "', got '" + got + "'")
  end
  ()
end

def rationale_lane_rows(
  inout out: Vec[String], name: String, got: Vec[String], expected: Vec[String]
) -> Unit
  if got.len() != expected.len() then
    out.push(name + ": expected " + expected.len().to_string() + " rows, got " + got.len().to_string())
    return ()
  end
  var i = 0
  while i < got.len() do
    if got[i] != expected[i] then
      out.push(name + "[" + i.to_string() + "]: expected '" + expected[i].clone() + "', got '" + got[i].clone() + "'")
    end
    i = i + 1
  end
  ()
end

def tool_name_rows(tools: Vec[SemanticTool]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for tool in tools do
    out.push(tool.name.clone())
  end
  out
end

