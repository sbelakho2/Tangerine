# Tangerine monomorphization — the ONE monomorphizer.
# Split out of trait_resolve.tg: the entire
# monomorphization machinery lives here — the mono cache, the instance
# identity (InstanceId / instance_key), the canonical generic-parameter
# identity through owners (canonical_param_aliases — the mono-layer
# binder bijection the substitution and the devirtualization
# instance-argument solving consult), the exhaustive body specialization
# (substitute_type / substitute_rvalue / substitute_operand /
# substitute_place), the instance WORK QUEUE (monomorphize_program), and
# the symbol mangling (mangle_name for the INTERNAL single-compilation
# emission labels, and the Tangerine ABI mangling for the PUBLIC external
# symbols).
# trait_resolve.tg re-exports this module's public API for the existing
# importers (mir.tg, lib.tg, lib_kernel.tg, driver.tg).

use std::core::{Option, Result}
use std::collections::{Vec, Map, Set, VecDeque}
use tg_compiler::ids::{
  InstanceId, CallableId, DefId, DefKind, TypeId, GenericParamId, ClosureId,
  GenericArg, ConstValue,
  def_id_numeric, generic_param_id_numeric, generic_param_id_eq, generic_param_name_from,
  generic_arg_type_view, generic_arg_of_type_view, const_value_type_view,
  generic_args_of_types
effect_vec_eq, }
use tg_compiler::stable_ids::{
  StructuralInstanceId, structural_instance_id_of,
  structural_instance_mangle_text, StableDeclId, stable_callable_decl_of,
  stable_structural_callable_decl_of, stable_key_module, stable_key_name,
  CanonicalGenericArg, CanonicalConstValue,
  canonical_type_key_of, canonical_const_value_of, canonical_const_sym_of_render,
  stable_mir_node_id_of_generated, stable_mir_block_id_of_control_generated
}
use tg_compiler::ast::{Program, Item, ItemKind, AccessConvention}
use tg_compiler::resolver::{ResolvedNames, def_kind_of}
use tg_compiler::types::{
  Type, ParamType, fn_owner_key, fn_owner_key_of_def, crate_module_path_of, AccessEffect,
  TypeCanonFrame, TypeCanonCtx, type_canon_render, effect_registry_new,
  const_sym_tree_has_param, const_sym_tree_uses_param, const_sym_tree_param_ids,
  const_sym_tree_subst_consts, const_sym_tree_eq, const_sym_fold_type,
  const_sym_tree_render_numeric, intrinsic_id_of_call,
  generic_param_alias_table, rewrite_generic_param_aliases_in_type
}
use tg_compiler::mir::{
  MirProgram, MirFunction, MirLocal, MirBlock, MirStatement, MirStatementKind,
  MirRvalue, MirRvalueKind, MirOperand, MirOperandKind, MirConstant, MirConstantKind,
  MirCallArg, MirCallValue, MirTerminator, MirTerminatorKind, AggregateKind,
  AssertMessage, Place, Projection, MirBlockId, MirLocalId, MirContract,
  MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef,
  mir_origins_check
}

# The work-queue guard: the queue + seen-set terminate for every FINITE
# instance set (each instance is popped and specialized at most once). The
# bound is a CONFIGURABLE RESOURCE LIMIT on how many instances ONE
# compilation may specialize — a FINITE program can genuinely instantiate
# more than 8192 functions, so exceeding the limit NEVER proves infinite
# recursion: it is reported as a resource-limit diagnostic (increase
# MAX_MONO_INSTANCES), not as a monomorphization-recursion claim.
const MAX_MONO_INSTANCES: Int = 8192

# The trait-contract devirtualization wave's round bound: each round
# rewrites at least one call site to a LOWERED emission name, a site the
# following rounds never reconsider, so a finite program reaches the
# fixpoint in at most (number of contract call sites + 1) rounds. The
# bound is a defensive resource limit; exceeding it is a fail-closed
# diagnostic, never a claim about the seed's semantics.
const MAX_MONO_DEVIRT_ROUNDS: Int = 64

# ———————————————————————————————————————————————————————————————
# Data Structures
# ———————————————————————————————————————————————————————————————
#
# (MonoKey deletion; fourth-audit P0-5/P0-6): specialization identity is
# the InstanceId — the semantic (def, args) payload, where args is the
# TYPED GenericArg union in declared binder order (P0-5) — NEVER a
# source/emission name. The cache holds the specialized bodies in ONE map
# keyed by the STRUCTURAL instance record (StructuralInstanceId,
# stable_ids.tg section 9 — the digest-word record of the same
# callable/args the emission text renders, with the args in DECLARED
# cross-kind order). The former MonoKey { func_name, type_args } record
# and the name-derived dedup entry (monomorphize) is not part of the
# model: dedup is `instances.contains_key(key)` over the structured
# record, and the emission symbol is DERIVED from the instance at the
# mangling boundary (structural_instance_mangle_text). The work queue
# (monomorphize_program) carries (callee emission name, InstanceId) pairs
# — the NAME is only the TEMPLATE-LOOKUP key into mir.functions (finding
# the generic definition to specialize); the specialization itself is
# keyed exclusively by the structural instance key.
pub struct MonoCache
  # Specialized MIR function bodies keyed by the STRUCTURAL instance
  # identity (StructuralInstanceId — the digest-word record; never a
  # source name and never the rendered "$"-text). "InstanceId ->
  # structural instance -> specialized MirFunction": the map key is the
  # identity authority, while the cached MirFunction's `name` field
  # carries the mangled EMISSION text (the codegen label the mangling
  # boundary derived from the same instance) — so the cache hit, the
  # emission name and the call-site rewrite all agree on the instance
  # identity. Every insert/lookup site derives the structural instance
  # once from the instance it holds (the work-queue drain pop / rewrite
  # lookups through structured_instance_key; the name-API path through
  # structured_key_of_text_and_args); there is no text-keyed index.
  # DETERMINISM (P1-24 discipline): no pass iterates this map — specialized
  # bodies enter mir.functions in WORK-QUEUE POP ORDER (the FIFO VecDeque
  # pending queue), so emission order is insertion-ordered and independent
  # of the map's hash layout. Any future iteration over this map for
  # emitted output MUST sort by the key's digest words (callable, then
  # every arg row in declared order — instance_key_eq's positional order),
  # never by the map's native order.
  instances: Map[StructuralInstanceId, MirFunction]
  # Inference failures recorded during monomorphization (deduplicated)
  errors: Vec[String]
  # The stable declaration binding of callables (fourth-audit P0-6):
  # keyed by the callable's compilation-local REGISTRATION key
  # ("path::name"). mono_cache_new_ephemeral SEEDS this map for EVERY
  # resolver-registered callable DefId (mono_cache_seed_stable_callables:
  # the index-free registration-scope structural declaration), and
  # mono_cache_new_persistent OVERWRITES the seeds from the mandatory
  # persistent CallableLineageView (mono_cache_bind_stable_callable) so
  # instance ids stay rename-stable. A source callable with NEITHER
  # binding is an internal error at the instance boundary
  # (require_stable_callable_decl_for_def) — a synthetic name-derived
  # lineage is never substituted for a source callable; only
  # compiler-generated entities use synthetic_for_generated.
  stable_callables: Map[String, StableDeclId]
 # the typed program's Program and the resolver's
  # ResolvedNames snapshot — the crate module table (Program.crate.modules)
  # and the def_kinds metadata the DefId renders (fn_owner_key_of_def /
  # crate_module_path_of — the ONE shared O(1) table lookup — / def_kind_of).
  # Wired at cache construction
  # (mono_cache_new_ephemeral / mono_cache_new_persistent); the monomorphizer receives the program THROUGH the
  # cache, so every instance-key render is byte-identical to the MIR
  # builder's emission-name renders (mir.tg's b.program / b.resolutions —
  # the same module-table authority).: the snapshot also
  # carries the checker's TypeId -> DefId association
  # (resolutions.type_def_ids) — the public ABI's DIRECT
  # type-to-declaration join.
  program: Program
  resolutions: ResolvedNames
 # the serialized param-name table (numeric GenericParamId ->
  # name) — the monomorphizer renders parameter names for diagnostics
  # (residual-param violations, the ABI canonicalizer's fail-closed
  # errors) from this snapshot. Populated from MirProgram at
  # monomorphize_program entry; identity is the id everywhere, names are
  # display-only.
  generic_param_names: Map[Int, String]
end

# ———————————————————————————————————————————————————————————————
# The callable lineage view — the persistent identity INPUT of a cache
# ———————————————————————————————————————————————————————————————
# The persistent declaration bindings a build derived BEFORE any instance
# enqueued (the pre-mono stamping pass over the caller's DeclLineageStore).
# Keyed by the compilation-local REGISTRATION key ("path::name") — the
# same key the MonoCache.stable_callables map and the resolver's
# module_symbols share. The view is the MANDATORY input of the production
# constructor (mono_cache_new_persistent): a production cache is never
# constructed without the persistent declaration identity of every
# resolver-registered symbol, so the seeded structural fallback can never
# silently stand in for a persisted declaration.
#
# A view entry OVERRIDES the structural seed for that key. The view is
# built from the loaded DeclLineageStore by the shared snapshot lineage
# pass (semantic_snapshot.tg snapshot_lineage_view_of), so the binding a
# persisted rename/move continuation resolved is exactly the declaration
# the same build's snapshot walk re-stamps.
pub struct CallableLineageView
  decls: Map[String, StableDeclId]
end

# The empty view (test/bootstrap construction only: an empty view cannot
# satisfy mono_cache_new_persistent for a program with registered
# symbols — the constructor fails closed).
pub def callable_lineage_view_new() -> CallableLineageView
  CallableLineageView { decls: Map::new() }
end

# Bind (or overwrite) the persistent declaration of one registration key.
pub def callable_lineage_view_bind(inout view: CallableLineageView, registration_key: String, decl: StableDeclId) -> Unit
  view.decls.insert(registration_key, decl)
  ()
end

# The persistent declaration bound to a registration key, else None.
pub def callable_lineage_view_get(view: CallableLineageView, registration_key: String) -> Option[StableDeclId]
  view.decls.get(&registration_key)
end

# Whether the view carries a binding for the registration key.
pub def callable_lineage_view_contains(view: CallableLineageView, registration_key: String) -> Bool
  view.decls.contains_key(&registration_key)
end

# The number of bindings in the view.
pub def callable_lineage_view_len(view: CallableLineageView) -> Int
  view.decls.len()
end

# The common monomorphization setup boundary for TEST/BOOTSTRAP
# construction: the structural (index-free, registration-scope) identity
# only — no persisted declaration store is consulted. EVERY production
# entry uses mono_cache_new_persistent instead (the persistent map is a
# mandatory input there); this constructor exists so a test lane or a
# kernel/bootstrap route that holds no DeclLineageStore can build a cache
# explicitly, never by accident.
#
# Construction SEEDS the stable declaration binding of EVERY
# resolver-registered callable DefId (mono_cache_seed_stable_callables) —
# so the instance identity never falls back to a synthetic name-derived
# lineage for a source callable. The seeded declaration is the index-free
# registration-scope structural record (package + module path + kind +
# name); it is NOT rename-stable: a `path::name` change re-keys the
# instance (the structural behavior the regression lane pins).
pub def mono_cache_new_ephemeral(program: Program, res: ResolvedNames) -> MonoCache
  var cache = MonoCache {
    instances: Map::new(),
    errors: Vec::new(),
    stable_callables: Map::new(),
    program: program.clone(),
    resolutions: res.clone(),
    generic_param_names: Map::new()
  }
  mono_cache_seed_stable_callables(&mut cache)
  cache
end

# The PRODUCTION monomorphization setup boundary: every production entry
# (the LIR compile, the semantic snapshot build, the semantic server, the
# verified-edit transaction, the coverage harness) constructs its cache
# through here, AFTER the resolver/type checking finalized AND after the
# caller's persisted DeclLineageStore was loaded and stamped into a
# CallableLineageView (semantic_snapshot.tg snapshot_lineage_view_of) —
# and BEFORE any instance is enqueued.
#
# The view is a MANDATORY input: construction BINDS every view entry
# (mono_cache_bind_stable_callable) over the structural seeds, then FAILS
# CLOSED when any resolver-registered symbol lacks a view binding — a
# production cache can never silently fall back to the seeded structural
# identity for a declaration whose persistent identity exists. The
# persistent bindings consult first (stable_callables is a map insert; the
# view entries overwrite the seeds), so instances the monomorphizer emits
# carry the persistent, rename/move-stable StructuralInstanceId.
pub def mono_cache_new_persistent(program: Program, res: ResolvedNames, view: CallableLineageView) -> MonoCache
  var cache = mono_cache_new_ephemeral(program, res)
  for (key, decl) in view.decls.entries() do
    mono_cache_bind_stable_callable(&mut cache, key.clone(), decl)
  end
  # Fail closed: EVERY resolver-registered symbol of this program must
  # carry a persistent binding. The view builder (snapshot_lineage_view_of)
  # stamps the full registered set, so a missing key is a broken
  # construction path — never a silently structural fallback.
  let entries = cache.resolutions.module_symbols.entries()
  for (key, _did) in entries do
    if !view.decls.contains_key(&key) then
      panic("internal error: mono_cache_new_persistent requires a persistent declaration binding for every resolver-registered symbol; `" + key + "` is missing from the lineage view (build the view with semantic_snapshot.tg snapshot_lineage_view_of, or use mono_cache_new_ephemeral explicitly for a bootstrap/test cache)")
    end
  end
  cache
end

# The resolver REGISTRATION key ("path::name") of a DefId — the
# module_symbols identity lookup. Option::None for a def the resolver
# never registered (compiler-synthetic entities only; a source callable
# always has a registration). This is the DefId -> stable-key resolution
# helper the seeding and the fail-closed lookup share.
pub def stable_callable_key_for_def(res: ResolvedNames, did: DefId) -> Option[String]
  for (ms_key, ms_did) in res.module_symbols.entries() do
    if ms_did.module.id == did.module.id && ms_did.index == did.index then
      return Option::Some(ms_key.clone())
    end
  end
  Option::None
end

# Seed the STABLE DECLARATION binding of every resolver-registered
# callable DefId (fourth-audit P0-6), keyed by the def's registration
# key. The declaration is the INDEX-FREE registration-scope structural
# identity (stable_structural_callable_decl_of: package + module path +
# kind + name; the per-module definition index never enters), which is
# the deterministic compilation-local authority the persistent
# DeclLineageStore supersedes. Idempotent: an already-bound key (a
# persisted store binding installed through
# mono_cache_bind_stable_callable) is never overwritten.
#
# The DISPLAY cargo is the fn_owner_key render (the same emission base
# the instance boundary derived before the general seeding landed), so
# emitted internal symbol bytes do not move. The kind comes from the
# resolver's DefKind metadata; a registration without metadata degrades
# to DefKind::Other exactly like the documented fn_owner_key recovery —
# the identity stays deterministic (the index never enters either way).
pub def mono_cache_seed_stable_callables(inout cache: MonoCache) -> Unit
  let res = cache.resolutions.clone()
  let entries = res.module_symbols.entries()
  for (ms_key, ms_did) in entries do
    if !cache.stable_callables.contains_key(&ms_key) then
      let kind = match def_kind_of(&res, &ms_did)
      when Option::Some(k) then k
      when Option::None then DefKind::Other
      end
      let module_path = crate_module_path_of(&cache.program, &ms_did.module).join("::")
      let display = fn_owner_key(module_path, ms_did.index, kind)
      cache.stable_callables.insert(ms_key.clone(), stable_structural_callable_decl_of(
        "".to_string(),
        stable_key_module(&ms_key),
        mono_def_kind_word(kind),
        stable_key_name(&ms_key),
        display
      ))
    end
  end
  ()
end

# Install the persistent stable declaration binding of one callable
# (fourth-audit P0-6): the store-backed authority of the callable's
# structural instance identity, keyed by the compilation-local
# REGISTRATION key ("path::name"). A binding installed here OVERRIDES the
# seeded registration-scope declaration for that key. Absent a store
# binding the seeded declaration stands — no synthetic name-derived
# lineage is ever substituted for a source callable.
pub def mono_cache_bind_stable_callable(inout cache: MonoCache, callable_scope_key: String, decl: StableDeclId) -> Unit
  cache.stable_callables.insert(callable_scope_key, decl)
  ()
end

# ———————————————————————————————————————————————————————————————
# Call-level Instance Identity 
# ———————————————————————————————————————————————————————————————
# The semantic identity of a monomorphized callee: the DEFINITION the call
# resolves to (the typed program's call_targets DefId) plus the concrete
# generic arguments — the TYPED GenericArg union in declared binder order
# (P0-5). This is the target shape the string-only MirFnItem
# names migrate to: a MirFnItem keeps its name as the mangled EMISSION key
# (codegen's resolve_callee_label authority) and carries the InstanceId as
# its semantic identity alongside. The args are the concrete generic
# arguments; the instance payload is the ONLY authority for generic
# arguments at the monomorphizer — ZERO-INFERENCE: the monomorphizer never
# fills them from a call site (see the fail-closed invariant at
# monomorphize_program).

# NOTE: InstanceId is IMPORTED from ids.tg — the
# target shape (def: CallableId wrapping the ModuleId-based DefId, plus
# the typed GenericArg args vector). The trait_resolve facade's re-export
# (pub use tg_compiler::mono::{InstanceId,...}) flows the ids.tg type
# through unchanged, so mir.tg's payload construction
# (InstanceId { def: CallableId { def: did }, args }) and this module's
# consumption agree on the same identity.

# The instance -> mangled-name mapping (fourth-audit P0-6). The emission
# base is the DefId's fn_owner_key_of_def rendering — compilation-local
# LOOKUP/DISPLAY only; the identity is the StructuralInstanceId, whose
# callable is the def's REQUIRED stable declaration (the seeded
# registration scope, or a persisted store binding). The suffix render is
# the canonical args in declared order, derived from the record.
#
# THE EMISSION-NAME FLOW: this function is the mangling
# AUTHORITY — symbol names are produced only at this boundary, never at the
# source level. The full flow for every top-level function:
#
#   source name (diagnostics/display only)
#     -> DefId (resolver: ResolvedNames.item_defs / call_targets — the
#        owner ModuleId + per-module symbol index; record_item_def
#        guarantees one for every top-level function)
#     -> fn_owner_key_of_def (the compilation-local base render; the
#        per-module index is LOOKUP/DISPLAY only, never identity)
#     -> StructuralInstanceId (the stable callable declaration + the
#        ordered CanonicalGenericArg vector — the mono cache identity)
#     -> structural_instance_mangle_text (the mangled EMISSION name
#        derived from the record: base + "$<concrete args>" — the
#        symbol-mangling boundary, where the MirFunction/MirFnItem name is
#        produced)
#     -> label (codegen's fn_alias identity entry ".Lfn_entry.<index>",
#        resolved by resolve_callee_label)
#
# The source name survives ONLY at the linking boundary (extern symbols,
# intrinsic names, the OS-entry "main"/"_start") and in diagnostics. Method
# names ("Type__method") are exempt by design: the finalizer and registered
# Drop identities depend on them unchanged.
pub def instance_key(cache: MonoCache, instance: InstanceId) -> String
  structural_instance_mangle_text(structured_instance_key(cache, instance))
end

# (audit item 49; fourth-audit P0-5/P0-6): the STRUCTURAL instance record
# of an InstanceId — the identity face of instance_key (stable_ids.tg
# section 9). The callable is the def's REQUIRED stable declaration
# (require_stable_callable_decl_for_def: the seeded registration-scope
# identity, or a persisted store binding — a source callable with
# neither fails closed; the per-module definition index never enters, so
# inserting an unrelated function before a generic never re-keys its
# instances). The args are built DIRECTLY from the typed GenericArg
# vector (P0-5) — each Type row renders its CanonInternal type text, each
# Const row its canonical const segment; const-vs-type is carried by the
# payload and NEVER re-classified from a rendered string. Eq/Hash fold
# the record's digest words (never a "$"-text). THIS RECORD IS the
# MonoCache.instances key (the map is never keyed by the emission text).
pub def structured_instance_key(cache: MonoCache, instance: InstanceId) -> StructuralInstanceId
  let callable = require_stable_callable_decl_for_def(cache, &instance.def.def)
  structural_instance_id_of(callable, canonical_args_of_typed(&instance.args))
end

# The compilation-local DefKind word of a def (the same vocabulary
# fn_owner_key renders — types.tg). Used to build the index-free
# registration-scope callable identity (fourth-audit P0-6).
def mono_def_kind_word(kind: DefKind) -> String
  match kind
  when DefKind::Function then "fn"
  when DefKind::Method then "method"
  when DefKind::Static then "static"
  when DefKind::Constant then "const"
  when DefKind::EnumVariant then "variant"
  when DefKind::StructField then "field"
  when DefKind::Intrinsic then "intrinsic"
  when DefKind::TypeName then "type"
  when DefKind::Trait then "trait"
  when DefKind::Other then "other"
  end
end

# The canonical identity row of ONE typed generic argument — derived
# DIRECTLY from the typed payload (P0-5; no render-string
# classification):
#   GenericArg::Type(t) -> the CanonInternal render's type row
#   Value(v)            -> the canonical value row "c<v>"
#   Param(g)            -> the forwarding row "constparam<n>"
#   Sym(tree)           -> the symbolic row "constsym(<numeric tree>)"
# The row texts are byte-identical to the CanonInternal segment renders
# the former positional string classification produced, so emitted
# symbols and stable identities stay stable across the migration.
pub def canonical_arg_of_typed(arg: GenericArg) -> CanonicalGenericArg
  match arg
  when GenericArg::Type(ty) then CanonicalGenericArg::Type(canonical_type_key_of(type_to_mangled(ty)))
  when GenericArg::Const(cv) then CanonicalGenericArg::Const(canonical_const_of_typed(cv))
  end
end

pub def canonical_const_of_typed(cv: ConstValue) -> CanonicalConstValue
  match cv
  when ConstValue::Value(v) then canonical_const_value_of("signed".to_string(), v)
  when ConstValue::Param(gpid) then canonical_const_value_of("constparam".to_string(), generic_param_id_numeric(&gpid))
  when ConstValue::Sym(tree) then canonical_const_sym_of_render(const_sym_tree_render_numeric(&tree))
  end
end

pub def canonical_args_of_typed(args: Vec[GenericArg]) -> Vec[CanonicalGenericArg]
  var out: Vec[CanonicalGenericArg] = Vec::new()
  for arg in args do
    out.push(canonical_arg_of_typed(arg))
  end
  out
end

# The compiler-GENERATED origin boundary (audit item 1 / fourth-audit
# P0-6): a synthetic name-derived declaration identity is allowed ONLY
# here — explicitly, for a compiler-synthetic entity (drop glue /
# derived / closure / shim) whose origin text the generating site owns.
# Source callables NEVER reach this constructor:
# require_stable_callable_decl_for_def fails closed instead.
pub def synthetic_for_generated(origin: String) -> StableDeclId
  stable_callable_decl_of(&origin)
end

# The REQUIRED stable declaration of a callable DefId (fail closed):
#   - a resolver-registered source callable MUST have a seeded (or
#     store-bound) stable declaration; a missing binding is an internal
#     error carrying the registration key and DefId context — NEVER a
#     synthetic name-derived lineage fallback;
#   - a def in the compiler-SYNTHETIC band (module id < 0: drop glue,
#     synthetic callables) has no registration by construction and builds
#     the explicit generated-origin identity.
pub def require_stable_callable_decl_for_def(cache: MonoCache, did: DefId) -> StableDeclId
  match stable_callable_key_for_def(&cache.resolutions, &did)
  when Option::Some(key) then
    match cache.stable_callables.get(&key)
    when Option::Some(decl) then decl.clone()
    when Option::None then
      panic("internal error: source callable DefId " + def_id_numeric(&did).to_string() + " (registration key `" + key + "`) has no stable declaration binding — the mono cache must be seeded at construction (mono_cache_seed_stable_callables); no synthetic name-derived lineage is substituted for a source callable")
    end
  when Option::None then
    if did.module.id < 0 then
      synthetic_for_generated("synthetic::" + def_id_numeric(&did).to_string())
    else
      panic("internal error: callable DefId " + def_id_numeric(&did).to_string() + " is not registered in the resolver's module_symbols and is not in the compiler-synthetic module band — a source callable must have a stable declaration identity (fail closed; no synthetic name-derived lineage)")
    end
  end
end

# The structured key over a callable text + concrete args — the shared
# builder behind the name-API path (mono_specialize_function, which holds
# the template's emission name and explicit args but no InstanceId). This
# is a GENERATED-origin boundary (the explicit synthetic_for_generated
# constructor — the caller owns the emission-name text; source callables
# never take this path). The args are wrapped through the typed view
# (constructor inspection, never a rendering parse).
def structured_key_of_text_and_args(callable_key_text: String, type_args: Vec[Type]) -> StructuralInstanceId
  structural_instance_id_of(
    synthetic_for_generated(&callable_key_text),
    canonical_args_of_typed(generic_args_of_types(type_args))
  )
end

# ———————————————————————————————————————————————————————————————
# Type-Param Helper Predicates
# ———————————————————————————————————————————————————————————————

# Check whether a type contains any Type::Param reference.
def type_has_params(ty: Type) -> Bool
  match ty
  when Type::Param(_) then true
  when Type::Tuple(elems) then
    var found = false
    for e in elems do
      if type_has_params(&e) then found = true; break end
    end
    found
  when Type::FnPtr(params, ret, _) then
    var found = false
    for p in params do
      if type_has_params(&p.ty) then found = true; break end
    end
    found || type_has_params(ret)
  when Type::Closure(_, params, ret, captures, _) then
    var found = false
    for p in params do
      if type_has_params(&p.ty) then found = true; break end
    end
    found || type_has_params(ret) || type_has_params(&captures)
  when Type::Adt(_, args) then
    var found = false
    for a in args do
      if type_has_params(&a) then found = true; break end
    end
    found
  when Type::FixedArray(elem, _) then type_has_params(elem)
  when Type::FixedArraySym(elem, gpid) then true
  when Type::ConstParam(_) then true
  when Type::ConstSym(tree) then const_sym_tree_has_param(&tree)
  when Type::RefInternal(inner, _) then type_has_params(inner)
  when Type::Ptr(inner) then type_has_params(inner)
  when Type::PtrMut(inner) then type_has_params(inner)
  when Type::Effect(_, inner) then type_has_params(inner)
  when _ then false
  end  end  end
end

# Check whether a specific Type::Param id appears in a type.
def type_uses_param_id(ty: Type, gpid: GenericParamId) -> Bool
  match ty
  when Type::Param(n) then generic_param_id_eq(&n, gpid)
  when Type::Tuple(elems) then
    var found = false
    for e in elems do
      if type_uses_param_id(&e, gpid) then found = true; break end
    end
    found
  when Type::FnPtr(params, ret, _) then
    var found = false
    for p in params do
      if type_uses_param_id(&p.ty, gpid) then found = true; break end
    end
    found || type_uses_param_id(ret, gpid)
  when Type::Closure(_, params, ret, captures, _) then
    var found = false
    for p in params do
      if type_uses_param_id(&p.ty, gpid) then found = true; break end
    end
    found || type_uses_param_id(ret, gpid) || type_uses_param_id(&captures, gpid)
  when Type::Adt(_, args) then
    var found = false
    for a in args do
      if type_uses_param_id(&a, gpid) then found = true; break end
    end
    found
  when Type::FixedArray(elem, _) then type_uses_param_id(elem, gpid)
  when Type::FixedArraySym(elem, size_gpid) then
    if generic_param_id_eq(&size_gpid, gpid) then
      true
    else
      type_uses_param_id(elem, gpid)
    end
  when Type::ConstParam(n) then generic_param_id_eq(&n, gpid)
  when Type::ConstSym(tree) then const_sym_tree_uses_param(&tree, gpid)
  when Type::RefInternal(inner, _) then type_uses_param_id(inner, gpid)
  when Type::Ptr(inner) then type_uses_param_id(inner, gpid)
  when Type::PtrMut(inner) then type_uses_param_id(inner, gpid)
  when Type::Effect(_, inner) then type_uses_param_id(inner, gpid)
  when _ then false
  end  end
end

# Check whether a function is generic (has Type::Param in its signature,
# or carries declared generic parameters in MirFunction.generic_params).
def is_generic_function(func: MirFunction) -> Bool
  if !func.generic_params.is_empty() then return true end
  if type_has_params(&func.ret_type) then return true end
  for param in func.params do
    if type_has_params(&param.ty) then return true end
  end
  for local in func.locals do
    if type_has_params(&local.ty) then return true end
  end
  false
end

# ———————————————————————————————————————————————————————————————
# ZERO-INFERENCE INVARIANT
# ———————————————————————————————————————————————————————————————
# The monomorphizer performs NO call-site type-argument inference. Every
# generic call that reaches monomorphize_program carries its SOLVED
# instance (the MirFnItem's InstanceId payload):
#   - source calls carry the type checker's solved substitution (the
#     typed_call_instances authority, threaded through mir_call_instance);
#   - return-type-only shapes (Vec::new()-style constructors) are parked
#     (pending_call_instances) and re-resolved at the end of type checking,
#     after the annotation/expected-type unifications land — a call the
#     caller's context never constrains is a hard error ("cannot infer type
#     parameter `T`: add an annotation"), never a Unit/legacy guess;
#   - IR-synthesized calls (the deinit/drain/destroy glue, the intrinsic
#     calls, the for-loop length calls) are either non-generic emission
#     names, members of the monomorphic-per-call `__intrinsic_*` family, or
#     carry an instance attached by construction (see the enumeration in
#     mir.tg).
# A call whose callee has a generic base and NO usable instance payload is
# a compiler-internal gap: the monomorphizer FAILS CLOSED — it records an
# error instead of inferring. The former structural argument-match
# (infer_type_args_for_call and its helpers) has been REMOVED; inference is
# not performed on the program's call graph.

# ———————————————————————————————————————————————————————————————
# Canonical generic-parameter identity through owners
# ———————————————————————————————————————————————————————————————
# ONE logical parameter can be interned under more than one owner: the
# checker's per-owner interning (ids.tg intern_generic_param — the index
# IS the declaration order within ONE owner) makes each owner's binder
# list internally consistent, but the SAME declared parameter reached
# through two declarations carries DISTINCT GenericParamIds — a def's
# merged binder list vs its impl's binder list, an impl's trait arguments
# vs the trait's declared parameters, a nominal's declared field types vs
# the nominal's re-registered builtin shape. The residual class is the
# "array(param:A) into array(param:B)" / "constant type: Type::Param(...)"
# row: two spellings of ONE binder that the structural substitution and
# the verifier's key comparison cannot reconcile.
#
# This section establishes the mono layer's canonical binder identity:
# for ONE declaration, the CANONICAL binder list is the recorded
# declaration-order list (MirFunction.generic_params /
# MirTypeDef.generic_params); an OBSERVED parameter id — an id the
# declaration's own types reference — that is not canonical is paired
# with the canonical id carrying the SAME declared name. The pairing
# mirrors the seed's signature_identity binder bijection (P0-2): a
# correspondence binds a pair once, and an AMBIGUOUS correspondence (two
# canonical binders of one name — legal shadowing) fails closed: no alias
# is derived for that name, so the residual-param gates keep reporting
# the unpaired id instead of guessing. The identity the substitution
# writes is always the canonical GenericParamId; the declared name is the
# correspondence witness only (identity is the id, never the name).
#
# Application points (the SAME canonical identity at every boundary):
#   - specialize_function_keyed: the template's substitution map binds
#     every alias of a canonical binder to that binder's concrete
#     argument, so a specialized body's formerly owner-side Param
#     positions (and every callee InstanceId payload it carries) become
#     concrete;
#   - monomorphize_program entry: the program's MirTypeDef field/variant
#     tables are canonicalized against each def's declared parameter
#     list, so the declared-field substitution (the verifier's aggregate
#     check, the layout/deinit consumers) instantiates iterator-adapter
#     and container typed-field tables to concrete field types;
#   - the devirtualization candidate index: a template's declared
#     receiver/return types are canonicalized before the receiver
#     unification binds their binders, so the solved instance arguments
#     are the canonical ids.

# Push `gpid` onto `out` unless the id is already present (first-occurrence
# order — deterministic; the collectors never iterate a Map).
def param_id_push_unique(inout out: Vec[GenericParamId], gpid: GenericParamId) -> Unit
  let num = generic_param_id_numeric(&gpid)
  for existing in out do
    if generic_param_id_numeric(&existing) == num then
      return
    end
  end
  out.push(gpid)
end

# Collect the generic-parameter ids a type references (Type::Param /
# Type::ConstParam / FixedArraySym's size parameter / a ConstSym tree's
# parameter leaves), deduplicated in first-occurrence order.
def collect_param_ids_in_type(ty: Type, inout out: Vec[GenericParamId]) -> Unit
  match ty
  when Type::Param(gpid) then param_id_push_unique(out, gpid)
  when Type::ConstParam(gpid) then param_id_push_unique(out, gpid)
  when Type::FixedArraySym(elem, gpid) then
    collect_param_ids_in_type(elem, out)
    param_id_push_unique(out, gpid)
  when Type::ConstSym(tree) then
    for gpid in const_sym_tree_param_ids(&tree) do
      param_id_push_unique(out, gpid)
    end
  when Type::Tuple(elems) then
    for e in elems do
      collect_param_ids_in_type(e, out)
    end
  when Type::FnPtr(params, ret, _) then
    for p in params do
      collect_param_ids_in_type(p.ty, out)
    end
    collect_param_ids_in_type(ret, out)
  when Type::Closure(_, params, ret, captures, _) then
    for p in params do
      collect_param_ids_in_type(p.ty, out)
    end
    collect_param_ids_in_type(ret, out)
    collect_param_ids_in_type(captures, out)
  when Type::Adt(_, args) then
    for a in args do
      collect_param_ids_in_type(a, out)
    end
  when Type::FixedArray(elem, _) then collect_param_ids_in_type(elem, out)
  when Type::RefInternal(inner, _) then collect_param_ids_in_type(inner, out)
  when Type::Ptr(inner) then collect_param_ids_in_type(inner, out)
  when Type::PtrMut(inner) then collect_param_ids_in_type(inner, out)
  when Type::Effect(_, inner) then collect_param_ids_in_type(inner, out)
  when _ then ()
  end
end

# Collect the parameter ids a generic argument references: a Type row
# through the type walk; a Const row through its Param form or its
# ConstSym tree's parameter leaves.
def collect_param_ids_in_generic_arg(arg: GenericArg, inout out: Vec[GenericParamId]) -> Unit
  match arg
  when GenericArg::Type(ty) then collect_param_ids_in_type(ty, out)
  when GenericArg::Const(cv) then
    match cv
    when ConstValue::Value(_) then ()
    when ConstValue::Param(gpid) then param_id_push_unique(out, gpid)
    when ConstValue::Sym(tree) then
      for gpid in const_sym_tree_param_ids(&tree) do
        param_id_push_unique(out, gpid)
      end
    end
  end
end

# Collect the parameter ids an operand references: a constant's carried
# type and the substitution rows of its callee/deinit instance payload.
def collect_param_ids_in_operand(op: MirOperand, inout out: Vec[GenericParamId]) -> Unit
  match op.kind
  when MirOperandKind::MirConstant(cst) then
    collect_param_ids_in_type(cst.ty, out)
    match cst.instance
    when Option::Some(inst) then
      for a in inst.args do
        collect_param_ids_in_generic_arg(a, out)
      end
    when Option::None then ()
    end
  when _ then ()
  end
end

def collect_param_ids_in_assert_message(msg: AssertMessage, inout out: Vec[GenericParamId]) -> Unit
  match msg
  when AssertMessage::BoundsCheck(op1, op2) then
    collect_param_ids_in_operand(op1, out)
    collect_param_ids_in_operand(op2, out)
  when _ then ()
  end
end

# Collect the parameter ids an rvalue embeds: operand constants, the cast
# target, and the array aggregate's element type.
def collect_param_ids_in_rvalue(rvalue: MirRvalue, inout out: Vec[GenericParamId]) -> Unit
  match rvalue.kind
  when MirRvalueKind::MirMove(op) then collect_param_ids_in_operand(op, out)
  when MirRvalueKind::MirRef(_) then ()
  when MirRvalueKind::MirAggregate(kind, ops) then
    match kind
    when AggregateKind::MirArray(ty) then collect_param_ids_in_type(ty, out)
    when _ then ()
    end
    for op in ops do
      collect_param_ids_in_operand(op, out)
    end
  when MirRvalueKind::MirBinOp(_, lhs, rhs) then
    collect_param_ids_in_operand(lhs, out)
    collect_param_ids_in_operand(rhs, out)
  when MirRvalueKind::MirUnOp(_, op) then collect_param_ids_in_operand(op, out)
  when MirRvalueKind::MirDiscriminant(_) then ()
  when MirRvalueKind::MirLen(_) then ()
  when MirRvalueKind::MirCast(_, op, target_ty) then
    collect_param_ids_in_operand(op, out)
    collect_param_ids_in_type(target_ty, out)
  when MirRvalueKind::MirRepeat(op, count) then
    collect_param_ids_in_operand(op, out)
    collect_param_ids_in_operand(count, out)
  when MirRvalueKind::MirPhi(_) then ()
  end
end

# The function-wide observed binder collection: the signature types, the
# local types, and every embedded type position of the body (operand
# constant types, instance substitution rows, cast targets, aggregate
# element types, contract/assert operands, deinit instance payloads) —
# the same positions the verifier's embedded-types walk covers.
def collect_param_ids_in_function(func: MirFunction, inout out: Vec[GenericParamId]) -> Unit
  for p in func.params do
    collect_param_ids_in_type(p.ty, out)
  end
  collect_param_ids_in_type(func.ret_type, out)
  for l in func.locals do
    collect_param_ids_in_type(l.ty, out)
  end
  for block in func.blocks do
    for stmt in block.statements do
      match stmt.kind
      when MirStatementKind::MirAssign(_, rvalue) then collect_param_ids_in_rvalue(rvalue, out)
      when MirStatementKind::MirContractCheck(contract, op) then
        collect_param_ids_in_operand(contract.condition, out)
        collect_param_ids_in_operand(op, out)
      when MirStatementKind::MirEffectRecord(_, op) then collect_param_ids_in_operand(op, out)
      when MirStatementKind::MirEffectPerform(_, _, _, payload_ptr, result_ptr) then
        collect_param_ids_in_operand(payload_ptr, out)
        collect_param_ids_in_operand(result_ptr, out)
      when MirStatementKind::MirEffectFrameEnter(_, _, _, _, env_ptr) then collect_param_ids_in_operand(env_ptr, out)
      when _ then ()
      end
    end
    match block.terminator.kind
    when MirTerminatorKind::MirCall(_, callee, args, _, _, _, _) then
      collect_param_ids_in_operand(callee, out)
      for a in args do
        match a.value
        when MirCallValue::Value(op) then collect_param_ids_in_operand(op, out)
        when MirCallValue::Place(_) then ()
        end
      end
    when MirTerminatorKind::MirAssert(cond, _, msg, _, _) then
      collect_param_ids_in_operand(cond, out)
      collect_param_ids_in_assert_message(msg, out)
    when MirTerminatorKind::MirDeinit(_, deinit_fn, _, _) then
      for a in deinit_fn.args do
        collect_param_ids_in_generic_arg(a, out)
      end
    when MirTerminatorKind::MirSwitchInt(discr, _, _) then collect_param_ids_in_operand(discr, out)
    when _ then ()
    end
  end
end

# Collect the parameter ids a type definition's field/variant types
# reference.
def collect_param_ids_in_type_def(td: MirTypeDef, inout out: Vec[GenericParamId]) -> Unit
  match td.kind
  when MirTypeDefKind::Struct(fields) then
    for f in fields do
      collect_param_ids_in_type(f.ty, out)
    end
  when MirTypeDefKind::Enum(variants) then
    for v in variants do
      for fty in v.fields do
        collect_param_ids_in_type(fty, out)
      end
    end
  end
end

# Whether any observed id lies outside the canonical binder list — the
# cheap guard that keeps the name-table snapshot (and the bijection)
# off the specialization hot path for declarations whose types are
# already canonical.
def has_noncanonical_param_ids(canonical_ids: Vec[GenericParamId], observed: Vec[GenericParamId]) -> Bool
  for gpid in observed do
    let num = generic_param_id_numeric(&gpid)
    var found = false
    for c in canonical_ids do
      if generic_param_id_numeric(&c) == num then
        found = true
        break
      end
    end
    if !found then
      return true
    end
  end
  false
end

# The canonical binder aliases of ONE declaration. `param_names` is the
# serialized param-name table (numeric GenericParamId -> declared name);
# `canonical_ids` the declaration's recorded declaration-order binder
# list; `observed` the parameter ids the declaration's own types
# reference (the collect_param_ids_* walks above). Every observed id that
# is not canonical is paired with the canonical id carrying the same
# declared name — UNLESS that name is carried by more than one canonical
# binder (legal shadowing: never pick a side) or by none (an id outside
# the declaration's scope), in which case the id stays unpaired and the
# residual-param gates fail closed. Result: alias numeric id -> canonical
# GenericParamId. An empty result is the fast path (already canonical).
def canonical_param_aliases(param_names: Map[Int, String], canonical_ids: Vec[GenericParamId], observed: Vec[GenericParamId]) -> Map[Int, GenericParamId]
  # (FINDING 6): the pairing rule lives once, in types.tg's
  # generic_param_alias_table (identical parameters, identical order);
  # this wrapper keeps mono.tg's name so every call site is unchanged.
  generic_param_alias_table(param_names, canonical_ids, observed)
end

# Re-point every parameter id of a type through the alias map (an id with
# no alias is left as-is — the residual gates report it; the alias map is
# consulted, never iterated for identity).
def rewrite_param_aliases_in_type(aliases: Map[Int, GenericParamId], ty: Type) -> Type
  # (FINDING 6): delegates to types.tg's
  # rewrite_generic_param_aliases_in_type (identical parameters) so the
  # rewrite rule lives once.
  rewrite_generic_param_aliases_in_type(aliases, ty)
end

# Canonicalize the program's MirTypeDef field/variant tables: every
# observed parameter id that is an owner-side spelling of a declared
# parameter is re-pointed at the def's canonical id, so the def's
# generic_params list covers every parameter its field types reference
# (the declared-field substitution at the verifier/layout/deinit
# boundaries then instantiates the field types to concrete types — the
# iterator-adapter and container typed-field tables included). A def
# whose tables are already canonical is untouched (the empty-alias fast
# path).
def canonicalize_type_def_binders(inout mir: MirProgram, param_names: Map[Int, String]) -> Unit
  var ti = 0
  while ti < mir.types.len() do
    var td = mir.types[ti]
    var observed: Vec[GenericParamId] = Vec::new()
    collect_param_ids_in_type_def(td, &mut observed)
    let aliases = canonical_param_aliases(param_names.clone(), td.generic_params.clone(), observed)
    if aliases.len() > 0 then
      let rewritten = match td.kind
      when MirTypeDefKind::Struct(fields) then
        var new_fields: Vec[MirFieldDef] = Vec::new()
        for f in fields do
          new_fields.push(MirFieldDef {
            name: f.name.clone(),
            ty: rewrite_param_aliases_in_type(aliases.clone(), f.ty)
          })
        end
        MirTypeDefKind::Struct(new_fields)
      when MirTypeDefKind::Enum(variants) then
        var new_variants: Vec[MirVariantDef] = Vec::new()
        for v in variants do
          var new_field_tys: Vec[Type] = Vec::new()
          for fty in v.fields do
            new_field_tys.push(rewrite_param_aliases_in_type(aliases.clone(), fty))
          end
          new_variants.push(MirVariantDef {
            name: v.name.clone(),
            discriminant: v.discriminant,
            fields: new_field_tys
          })
        end
        MirTypeDefKind::Enum(new_variants)
      end
      td.kind = rewritten
      mir.types[ti] = td
    end
    ti = ti + 1
  end
end

# ———————————————————————————————————————————————————————————————
# Monomorphization Body Specialization
# ———————————————————————————————————————————————————————————————
# Given a generic MIR function and concrete type arguments, produce
# a specialized copy with all type parameters substituted. The
# specialization is keyed EXCLUSIVELY by the InstanceId (the cache key is
# the STRUCTURED instance key — StructuralInstanceId, the digest-word record of the
# same (def, args) payload the emission text renders); the name-derived
# dedup entry (the former name-plus-args dedup record + monomorphize) is
# not part of the model — source/emission names never participate in
# specialization identity.

struct TypeSubstMap
 # Maps type parameter ids (numeric GenericParamId — identity is
  # the id, never the name) to concrete types
  params: Map[Int, Type]
end

# Pure substitution-map builder: binds the declaration-order generic
# parameter ids to the concrete arguments POSITIONALLY (P0-5: the typed
# GenericArg vector; the map value is the Type view — Type rows as-is,
# Const rows as their Type::Const/ConstParam/ConstSym constructor form).
# The min-length loop below keeps the EQUAL-length semantics (each
# declared parameter bound to its aligned argument); a length MISMATCH
# would silently truncate to the shorter side, so the EXACT-ARITY
# invariant is enforced by the callers (specialize_function_keyed's arity
# guard fires BEFORE any map is built, catching BOTH the too-few and the
# too-many direction; devirt_resolve_contract_call solves at the
# candidate's declared arity — every declaration-order parameter must be
# solved by the receiver unification).
def type_subst_new_args(type_param_ids: Vec[GenericParamId], args: Vec[GenericArg]) -> TypeSubstMap
  var params = Map::new()
  var i = 0
  while i < type_param_ids.len() && i < args.len() do
    params.insert(generic_param_id_numeric(&type_param_ids[i]), generic_arg_type_view(args[i].clone()))
    i = i + 1
  end
  TypeSubstMap { params: params }
end

# The alias-aware substitution-map builder: the declaration-order
# canonical ids bind the concrete arguments POSITIONALLY (the same
# contract as type_subst_new_args), and every canonical binder's ALIASES
# (canonical_param_aliases — the owner-side spellings of the same
# declared binder) bind the SAME concrete argument. A body position
# spelled through an owner-side binder therefore substitutes exactly like
# its canonical spelling, and the callee InstanceId payloads the body
# carries become concrete under the caller's own specialization (zero
# inference — the arguments are the caller's solved ones).
def type_subst_new_args_with_aliases(type_param_ids: Vec[GenericParamId], args: Vec[GenericArg], aliases: Map[Int, GenericParamId]) -> TypeSubstMap
  var params = Map::new()
  var i = 0
  while i < type_param_ids.len() && i < args.len() do
    params.insert(generic_param_id_numeric(&type_param_ids[i]), generic_arg_type_view(args[i].clone()))
    i = i + 1
  end
  if aliases.len() > 0 then
    var ai = 0
    while ai < type_param_ids.len() && ai < args.len() do
      let canonical_num = generic_param_id_numeric(&type_param_ids[ai])
      let concrete = generic_arg_type_view(args[ai].clone())
      for (alias_num, canonical) in aliases.entries() do
        if generic_param_id_numeric(&canonical) == canonical_num then
          params.insert(alias_num, concrete.clone())
        end
      end
      ai = ai + 1
    end
  end
  TypeSubstMap { params: params }
end

# specialize a generic function under its STRUCTURED instance key — the
# solved-instance path's specialization. The key is the cache identity
# (MonoCache.instances: Map[StructuralInstanceId, MirFunction]); `mangled` is the
# emission label the same instance renders (the specialized body's name
# field — the mangling boundary's symbol). A caller holding the solved
# instance computes both faces from it (instance_key /
# structured_instance_key — the work-queue drain and monomorphize_instance);
# the name-API path holds no InstanceId and computes them from the
# template's emission name + the concrete args (specialize_function_named
# below). The specialization always proceeds from the given solved
# arguments (the typed P0-5 vector) — ZERO-INFERENCE: nothing is ever
# inferred here.
#
# FAIL-CLOSED RESULT INTERFACE: the specialization succeeds (Result::Ok)
# and caches the body ONLY when the post-instantiation verification finds
# no residual Type::Param / Type::Var anywhere in the instantiated types.
# A violation returns Result::Err WITHOUT caching the body, so the call
# site is never rewritten to a poisoned name; the caller propagates the
# error and aborts the compilation. An EXACT-ARITY violation
# (type_param_ids.len() != args.len() — too few or too many concrete
# args) is the FIRST failure: it returns Result::Err BEFORE any
# substitution map is built (see the arity guard below).
def specialize_function_keyed(
  inout cache: MonoCache,
  original: MirFunction,
  type_param_ids: Vec[GenericParamId],
  args: Vec[GenericArg],
  mangled: String,
  key: StructuralInstanceId
) -> Result[Unit, String]
  # If already specialized, return cached version
  match cache.instances.get(&key)
  when Option::Some(_) then return Result::Ok(())
  when Option::None then ()
  end
  
  # EXACT-ARITY GUARD (fail-closed, BEFORE a substitution map is built):
  # the declaration-order generic parameter ids and the instance's
  # concrete arguments must have EXACTLY the same length. The
  # min-length loop in type_subst_new_args would otherwise SILENTLY
  # truncate: a TOO-FEW args leaves a declaration-order parameter
  # unbound — the residual-param verification catches that only when the
  # specialized body happens to mention the parameter (a parameter unused
  # in the signature would specialize silently under the truncated map);
  # a TOO-MANY args silently drops the excess arguments. Both directions
  # are compiler-internal contract breaks (the checker records every
  # instance at the DECLARED arity — mirroring the zero-inference
  # invariant, the monomorphizer never re-derives or pads the args), so
  # both abort here with the internal arity error, never a truncated
  # substitution.
  if type_param_ids.len() != args.len() then
    return Result::Err("monomorphization arity error for `" + original.name + "`: expected " + type_param_ids.len().to_string() + " generic arguments (the declared parameters), got " + args.len().to_string() + " — every instance carries exactly the declared arguments")
  end

  # (§20 const generics, slice 3): FAIL-CLOSED symbolic-argument guard. A
  # generic instance whose arguments still carry ANY symbolic generic
  # reference (Type::Param / Type::ConstParam / ConstValue::Param /
  # ConstValue::Sym / FixedArraySym — the param-carrying forms, see
  # has_any_param_args) cannot specialize: a const parameter's VALUE
  # inside the body substitutes from the instance's argument
  # (ConstValue::Value(v) -> MirInt(v)), and a symbolic argument would
  # leave the value placeholder unresolved in a body cached as concrete.
  # The worklist defers such instances (the caller's own specialization
  # substitutes the payload and the re-walk enqueues the now-concrete
  # instance — zero inference); reaching this point with a symbolic
  # argument is a compiler-internal gap or external-API misuse — rejected
  # here, never a placeholder-carrying body.
  if has_any_param_args(&args) then
    return Result::Err("monomorphization of `" + original.name + "` rejected: the instance's arguments still carry a generic parameter (a symbolic const argument cannot produce the concrete per-instance value of a const parameter read; the instance must be re-specialized under the caller's concrete substitutions)")
  end

  # (canonical binder identity): the template's OWN observed parameter
  # ids — the ids its signature, locals and embedded body types actually
  # reference — are paired with the declared (canonical) binders by the
  # mono-layer binder bijection, and every alias binds the SAME concrete
  # argument as its canonical spelling. A body position (or a callee
  # InstanceId payload) spelled through an owner-side interning therefore
  # substitutes exactly like its canonical spelling; an id the bijection
  # leaves unpaired keeps its Param form and the residual-param
  # verification below still fails closed.
  var observed: Vec[GenericParamId] = Vec::new()
  collect_param_ids_in_function(original, &mut observed)
  var aliases: Map[Int, GenericParamId] = Map::new()
  if has_noncanonical_param_ids(type_param_ids.clone(), observed.clone()) then
    aliases = canonical_param_aliases(cache.generic_param_names.clone(), type_param_ids.clone(), observed)
  end
  let subst = type_subst_new_args_with_aliases(type_param_ids, args, aliases)
  
  # Create specialized function with substituted types. The instantiated
  # body is a CONCRETE codegen instance: it carries no generic parameters
  # (the declaration-order names are substituted out by construction).
  var specialized = MirFunction {
    name: mangled.clone(),
    params: Vec::new(),
    ret_type: substitute_type(&subst, &original.ret_type),
    generic_params: Vec::new(),
    locals: Vec::new(),
    blocks: Vec::new(),
    entry_block: MirBlockId { id: original.entry_block.id },
    is_async: original.is_async,
    is_unsafe: original.is_unsafe,
    is_extern: original.is_extern,
    is_pure: original.is_pure,
    is_extern_variadic: original.is_extern_variadic,
    extern_abi: original.extern_abi.clone(),
    contracts: original.contracts.clone(),
    attr_inline_hint: original.attr_inline_hint,
    attr_inline_always: original.attr_inline_always,
    attr_noinline: original.attr_noinline,
    attr_cold: original.attr_cold,
    attr_interrupt: original.attr_interrupt,
    fp_fast: original.fp_fast,
    span: original.span.clone()
  }
  
  # Substitute parameter types
  for param in original.params do
    specialized.params.push(MirLocal {
      id: MirLocalId { id: param.id.id },
      name: param.name.clone(),
      ty: substitute_type(&subst, &param.ty),
      is_mut: param.is_mut,
      span: param.span
    })
  end
  
  # Substitute local variable types
  for local in original.locals do
    specialized.locals.push(MirLocal {
      id: MirLocalId { id: local.id.id },
      name: local.name.clone(),
      ty: substitute_type(&subst, &local.ty),
      is_mut: local.is_mut,
      span: local.span
    })
  end
  
  # Deep-copy and substitute all blocks
  for block in original.blocks do
    var new_stmts = Vec::new()
    for stmt in block.statements do
      new_stmts.push(substitute_statement(&subst, &stmt))
    end
    
    specialized.blocks.push(MirBlock {
      id: MirBlockId { id: block.id.id },
      statements: new_stmts,
      terminator: substitute_terminator(&subst, &block.terminator),
      origin: block.origin.clone()
    })
  end
  
  # Verification: after instantiation, a CONCRETE codegen instance must
  # carry no Type::Param and no unresolved Type::Var anywhere in the
  # instantiated types (params, return type, locals). An uninferred
  # parameter would poison the mangled name and the specialized body; a
  # Var (produced when the substitution chased a still-generic caller's
  # argument type) is equally non-codegenable. A violation records an
  # error and fails the specialization (the body is not cached, so the
  # call site is never rewritten to a poisoned name).
  match residual_param_in_function(cache, &specialized, type_param_ids)
  when Option::Some(what) then
    Result::Err(what + " remains in instantiated types of `" + original.name + "`")
  when Option::None then
    # Cache the specialized body under the STRUCTURED instance key; the
    # body's `name` field carries the emission text (same instance, both
    # faces).
    cache.instances.insert(key, specialized)
    Result::Ok(())
  end
end

# specialize_function_named (the PUBLIC name-API entry): specialize a
# generic function under an EXPLICIT mangled name. This path is keyed by
# the caller's EXPLICIT emission label `mangled`, so the structured key is
# the structured face of that label: recover its callable base by
# stripping the mangle suffix the concrete args render (mangle_name's
# "$"-joined suffix — no canonical render contains "$", so the split is
# unambiguous) and build the key from that base + the same args. A
# mismatched label falls back to the whole text as the base (still
# deterministic per label). Callers holding a semantic InstanceId (the
# work-queue drain / monomorphize_instance) call specialize_function_keyed
# with the key computed from the instance — the Map is never keyed by text
# either way.
pub def specialize_function_named(
  inout cache: MonoCache,
  original: MirFunction,
  type_param_ids: Vec[GenericParamId],
  type_args: Vec[Type],
  mangled: String
) -> Result[Unit, String]
  let suffix = mangle_name("".to_string(), type_args.clone())
  var base = mangled.clone()
  if mangled.len() >= suffix.len() && mangled.slice(mangled.len() - suffix.len(), mangled.len()) == suffix then
    base = mangled.slice(0, mangled.len() - suffix.len())
  end
  let key = structured_key_of_text_and_args(base, type_args.clone())
  specialize_function_keyed(cache, original, type_param_ids, generic_args_of_types(type_args), mangled, key)
end

# (final): the post-instantiation verification. A specialized body is
# a CONCRETE codegen instance: it must contain no Type::Param and no
# unresolved Type::Var anywhere (params, return type, locals). The first
# violation is described as:
#   - "type parameter `<name>`" — the callee's own parameter the
#     substitution failed to cover (a recorded instance whose args are
#     shorter than the declaration-order ids (MirFunction.generic_params)),
#     or a stray Param from a
#     still-generic caller's argument types; the name renders from the
# cache's param-name table (identity is the id);
#   - "inference variable (Type::Var)" — a Var the substitution produced
#     (the type args carried it; the subst resolution chases env.subst at
#     specialization time and a Var has no mapping there).
def residual_param_in_function(cache: MonoCache, f: MirFunction, ids: Vec[GenericParamId]) -> Option[String]
  for gpid in ids do
    if type_uses_param_id(&f.ret_type, &gpid) then
      return Option::Some("type parameter `" + generic_param_name_from(&cache.generic_param_names, &gpid) + "`")
    end
    for p in f.params do
      if type_uses_param_id(&p.ty, &gpid) then
        return Option::Some("type parameter `" + generic_param_name_from(&cache.generic_param_names, &gpid) + "`")
      end
    end
    for l in f.locals do
      if type_uses_param_id(&l.ty, &gpid) then
        return Option::Some("type parameter `" + generic_param_name_from(&cache.generic_param_names, &gpid) + "`")
      end
    end
  end
  match first_param_id_in_function(f)
  when Option::Some(gpid) then return Option::Some("type parameter `" + generic_param_name_from(&cache.generic_param_names, &gpid) + "`")
  when Option::None then ()
  end
  if residual_var_in_function(f) then
    return Option::Some("inference variable (Type::Var)")
  end
  Option::None
end

# Find the first Type::Param id anywhere in a function's instantiated
# types (params, return type, locals).
def first_param_id_in_function(f: MirFunction) -> Option[GenericParamId]
  match first_param_id_in_type(&f.ret_type)
  when Option::Some(n) then return Option::Some(n)
  when Option::None then ()
  end
  for p in f.params do
    match first_param_id_in_type(&p.ty)
    when Option::Some(n) then return Option::Some(n)
    when Option::None then ()
    end
  end
  for l in f.locals do
    match first_param_id_in_type(&l.ty)
    when Option::Some(n) then return Option::Some(n)
    when Option::None then ()
    end
  end
  Option::None  end
end

# Find the first Type::Param id in a type (mirrors type_has_params).
def first_param_id_in_type(ty: Type) -> Option[GenericParamId]
  match ty
  when Type::Param(gpid) then Option::Some(gpid.clone())
  when Type::Tuple(elems) then
    for e in elems do
      match first_param_id_in_type(&e)
      when Option::Some(n) then return Option::Some(n)
      when Option::None then ()
      end
    end
    Option::None
  when Type::FnPtr(params, ret, _) then
    for p in params do
      match first_param_id_in_type(&p.ty)
      when Option::Some(n) then return Option::Some(n)
      when Option::None then ()
      end
    end
    first_param_id_in_type(ret)
  when Type::Closure(_, params, ret, captures, _) then
    for p in params do
      match first_param_id_in_type(&p.ty)
      when Option::Some(n) then return Option::Some(n)
      when Option::None then ()
      end
    end
    match first_param_id_in_type(ret)
    when Option::Some(n) then return Option::Some(n)
    when Option::None then ()
    end
    first_param_id_in_type(&captures)
  when Type::Adt(_, args) then
    for a in args do
      match first_param_id_in_type(&a)
      when Option::Some(n) then return Option::Some(n)
      when Option::None then ()
      end
    end
    Option::None
  when Type::FixedArray(elem, _) then first_param_id_in_type(elem)
  when Type::FixedArraySym(elem, gpid) then
    match first_param_id_in_type(elem)
    when Option::Some(n) then Option::Some(n)
    when Option::None then Option::Some(gpid)
    end
  when Type::ConstParam(gpid) then Option::Some(gpid)
  when Type::ConstSym(tree) then
    # (§20 slice 2): the first parameter of a symbolic const-expression
    # argument is its FIRST parameter leaf in tree order (the leaves are
    # the only parameter-carrying positions of the tree).
    let leaf_ids = const_sym_tree_param_ids(&tree)
    if leaf_ids.len() > 0 then Option::Some(leaf_ids[0].clone()) else Option::None end
  when Type::RefInternal(inner, _) then first_param_id_in_type(inner)
  when Type::Ptr(inner) then first_param_id_in_type(inner)
  when Type::PtrMut(inner) then first_param_id_in_type(inner)
  when Type::Effect(_, inner) then first_param_id_in_type(inner)
  when _ then Option::None
  end  end
end

# Whether any unresolved Type::Var appears anywhere in a function's
# instantiated types.
def residual_var_in_function(f: MirFunction) -> Bool
  if type_has_unresolved_var(&f.ret_type) then return true end
  for p in f.params do
    if type_has_unresolved_var(&p.ty) then return true end
  end
  for l in f.locals do
    if type_has_unresolved_var(&l.ty) then return true end
  end
  false
end

# Whether a type contains any Type::Var (mirrors type_has_params).
def type_has_unresolved_var(ty: Type) -> Bool
  match ty
  when Type::Var(_) then true
  when Type::Tuple(elems) then
    var found = false
    for e in elems do
      if type_has_unresolved_var(&e) then found = true; break end
    end
    found
  when Type::FnPtr(params, ret, _) then
    var found = false
    for p in params do
      if type_has_unresolved_var(&p.ty) then found = true; break end
    end
    found || type_has_unresolved_var(ret)
  when Type::Closure(_, params, ret, captures, _) then
    var found = false
    for p in params do
      if type_has_unresolved_var(&p.ty) then found = true; break end
    end
    found || type_has_unresolved_var(ret) || type_has_unresolved_var(&captures)
  when Type::Adt(_, args) then
    var found = false
    for a in args do
      if type_has_unresolved_var(&a) then found = true; break end
    end
    found
  when Type::FixedArray(elem, _) then type_has_unresolved_var(elem)
  when Type::FixedArraySym(elem, _) then type_has_unresolved_var(elem)
  when Type::RefInternal(inner, _) then type_has_unresolved_var(inner)
  when Type::Ptr(inner) then type_has_unresolved_var(inner)
  when Type::PtrMut(inner) then type_has_unresolved_var(inner)
  when Type::Effect(_, inner) then type_has_unresolved_var(inner)
  when _ then false
  end  end
end

# (final): the ONE exhaustive substitution visitor — the sole
# substitution path into a specialized body. Every structural Type variant
# (Adt/Tuple/Function/RefInternal/Ptr/PtrMut/Effect/FixedArray — the
# fixed-array ELEMENT type is substituted, the constant count is part of
# the type identity and passes through) is rebuilt with its inner types
# substituted; the builtin compound types are Adt forms (their args carry
# the inner types — the canonical variants no longer exist); the
# non-structural variants (primitives, Var, Error, Dyn) are identity-cloned
# by the fallback arm. The post-instantiation verification
# (residual_param_in_function) rejects any Param/Var the visitor leaves
# behind.
def substitute_type(subst: TypeSubstMap, ty: Type) -> Type
  match ty
  when Type::Param(gpid) then
    match subst.params.get(generic_param_id_numeric(&gpid))
    when Option::Some(concrete) then concrete.clone()
    when Option::None then ty.clone()
    end
  when Type::ConstParam(gpid) then
    # (§20 slice 2): a SYMBOLIC const parameter reference substitutes to its
    # parameter's solved argument (Type::Const(v) — the value the instance
    # was recorded at), so an Adt const slot or a nested signature position
    # carrying the parameter (e.g. the `N` of `ArrayVec[T, N]` inside a
    # generic function's signature) becomes concrete in the specialized
    # body. A missing entry leaves the symbolic reference (the
    # post-instantiation verification rejects the residual like any
    # leftover Param — fail-closed, never a fabricated value).
    match subst.params.get(generic_param_id_numeric(&gpid))
    when Option::Some(concrete) then concrete.clone()
    when Option::None then ty.clone()
    end
  when Type::RefInternal(inner, mutable) then Type::RefInternal(substitute_type(subst, inner), mutable)
  when Type::Ptr(inner) then Type::Ptr(substitute_type(subst, inner))
  when Type::PtrMut(inner) then Type::PtrMut(substitute_type(subst, inner))
  when Type::Effect(effects, inner) then Type::Effect(effects.clone(), substitute_type(subst, inner))
  when Type::FixedArray(elem, n) then Type::FixedArray(substitute_type(subst, elem), n)
  when Type::FixedArraySym(elem, gpid) then
    # (§20 slice 1): the symbolic-size array under the mono substitution.
    # The size parameter's concrete argument decides the result:
    #   - Type::Const(v)      -> the CONCRETE Type::FixedArray(elem', v)
    #     (the substitution the layout engine needs — a body whose array
    #     size was the const parameter becomes the fixed-count form);
    #   - Type::ConstParam(g2) -> an OUTER const parameter's reference:
    #     the symbolic form survives with the outer id;
    #   - a missing/uncovered entry -> the symbolic form survives (the
    #     post-instantiation verification rejects the residual like any
    #     leftover Param — fail-closed, never a fabricated count).
    let sub_elem = substitute_type(subst, elem)
    match subst.params.get(generic_param_id_numeric(&gpid))
    when Option::Some(concrete) then
      match concrete
      when Type::Const(v) then Type::FixedArray(sub_elem, v)
      when Type::ConstParam(g2) then Type::FixedArraySym(sub_elem, g2)
      when _ then Type::FixedArraySym(sub_elem, gpid)
      end
    when Option::None then Type::FixedArraySym(sub_elem, gpid)
    end
  when Type::ConstSym(tree) then
    # (§20 slice 2): a SYMBOLIC CONST-EXPRESSION type argument under the
    # mono substitution — the instance fold: every parameter LEAF whose
    # parameter the instance solved becomes its concrete value
    # (Type::Const(v) -> literal leaf; a Type::ConstParam(g2) solution —
    # an enclosing generic's parameter — re-points the leaf at the outer
    # id), then the tree FOLDS: a fully-literal tree becomes the CONCRETE
    # Type::Const(v) in the specialized body (the return/signature slot
    # `Decimal128[SCALE + S2]` of an instance at SCALE=10, S2=2 becomes
    # Decimal128[12] — the value the layout engine and the caller's
    # signature comparisons see). A tree whose leaves the instance does
    # not cover stays symbolic (an enclosing generic's parameters — the
    # post-instantiation verification rejects the residual ConstSym like a
    # residual ConstParam/Param — fail-closed, never a fabricated value).
    let t2 = const_sym_tree_subst_consts(&tree, subst.params)
    const_sym_fold_type(&t2)
  when Type::Tuple(elems) then
    var subs = Vec::new()
    for e in elems do
      subs.push(substitute_type(subst, &e))
    end
    Type::Tuple(subs)
  when Type::FnPtr(params, ret, effects) then
    var sub_params = Vec::new()
    for p in params do
      sub_params.push(ParamType { ty: substitute_type(subst, &p.ty), convention: p.convention })
    end
    Type::FnPtr(sub_params, substitute_type(subst, ret), effects.clone())
  when Type::Closure(cid, params, ret, captures, effects) then
    var sub_params = Vec::new()
    for p in params do
      sub_params.push(ParamType { ty: substitute_type(subst, &p.ty), convention: p.convention })
    end
    Type::Closure(cid.clone(), sub_params, substitute_type(subst, ret), substitute_type(subst, &captures), effects.clone())
  when Type::Adt(id, args) then
    var sub_args = Vec::new()
    for a in args do
      sub_args.push(substitute_type(subst, &a))
    end
    Type::Adt(id, sub_args)
  when _ then ty.clone()
  end  end
end

# The EXHAUSTIVE statement substitution: every MirStatementKind variant is
# rebuilt; every operand/place/rvalue inside is substituted.
def substitute_statement(subst: TypeSubstMap, stmt: MirStatement) -> MirStatement
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    MirStatement {
      kind: MirStatementKind::MirAssign(substitute_place(subst, &place), substitute_rvalue(subst, &rvalue)),
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  when MirStatementKind::MirStorageLive(local) then
    MirStatement {
      kind: MirStatementKind::MirStorageLive(local.clone()),
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  when MirStatementKind::MirStorageDead(local) then
    MirStatement {
      kind: MirStatementKind::MirStorageDead(local.clone()),
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  when MirStatementKind::MirNop then
    MirStatement {
      kind: MirStatementKind::MirNop,
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  when MirStatementKind::MirContractCheck(contract, op) then
    MirStatement {
      kind: MirStatementKind::MirContractCheck(substitute_contract(subst, &contract), substitute_operand(subst, &op)),
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  when MirStatementKind::MirBudgetConsume(resource, amount) then
    MirStatement {
      kind: MirStatementKind::MirBudgetConsume(resource.clone(), amount),
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  when MirStatementKind::MirEffectRecord(effect, op) then
    MirStatement {
      kind: MirStatementKind::MirEffectRecord(effect.clone(), substitute_operand(subst, &op)),
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  when MirStatementKind::MirEffectPerform(eid, op_index, op_name, payload_ptr, result_ptr) then
    MirStatement {
      kind: MirStatementKind::MirEffectPerform(eid.clone(), op_index, op_name.clone(), substitute_operand(subst, &payload_ptr), substitute_operand(subst, &result_ptr)),
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  when MirStatementKind::MirEffectFrameEnter(eid, op_count, bitmap, disp_name, env_ptr) then
    MirStatement {
      kind: MirStatementKind::MirEffectFrameEnter(eid.clone(), op_count, bitmap, disp_name.clone(), substitute_operand(subst, &env_ptr)),
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  when MirStatementKind::MirEffectFrameExit then
    MirStatement {
      kind: MirStatementKind::MirEffectFrameExit,
      span: stmt.span.clone(),
      origin: stmt.origin.clone()
    }
  end  end
end

def substitute_contract(subst: TypeSubstMap, contract: MirContract) -> MirContract
  MirContract {
    kind: contract.kind.clone(),
    condition: substitute_operand(subst, &contract.condition),
    message: contract.message.clone(),
    span: contract.span.clone()
  }
end

# The EXHAUSTIVE rvalue substitution: EVERY MirRvalueKind variant is
# rebuilt recursively via substitute_operand / substitute_place /
# substitute_type — a generic type or instance payload hidden in any
# rvalue shape (moves, references, aggregates, binops, casts, repeats)
# is substituted, never left behind by a fallthrough clone.
def substitute_rvalue(subst: TypeSubstMap, rvalue: MirRvalue) -> MirRvalue
  match rvalue.kind
  when MirRvalueKind::MirMove(op) then
    MirRvalue { kind: MirRvalueKind::MirMove(substitute_operand(subst, &op)) }
  when MirRvalueKind::MirRef(place) then
    MirRvalue { kind: MirRvalueKind::MirRef(substitute_place(subst, &place)) }
  when MirRvalueKind::MirAggregate(kind, ops) then
    # Substitute type in aggregate kind if it references generics, and
    # substitute every aggregate operand.
    var new_ops = Vec::new()
    for op in ops do
      new_ops.push(substitute_operand(subst, &op))
    end
    MirRvalue { kind: MirRvalueKind::MirAggregate(substitute_aggregate_kind(subst, &kind), new_ops) }
  when MirRvalueKind::MirBinOp(bop, lhs, rhs) then
    MirRvalue {
      kind: MirRvalueKind::MirBinOp(bop.clone(), substitute_operand(subst, &lhs), substitute_operand(subst, &rhs))
    }
  when MirRvalueKind::MirUnOp(uop, op) then
    MirRvalue { kind: MirRvalueKind::MirUnOp(uop.clone(), substitute_operand(subst, &op)) }
  when MirRvalueKind::MirDiscriminant(place) then
    MirRvalue { kind: MirRvalueKind::MirDiscriminant(substitute_place(subst, &place)) }
  when MirRvalueKind::MirLen(place) then
    MirRvalue { kind: MirRvalueKind::MirLen(substitute_place(subst, &place)) }
  when MirRvalueKind::MirCast(ckind, op, target_ty) then
    MirRvalue {
      kind: MirRvalueKind::MirCast(ckind.clone(), substitute_operand(subst, &op), substitute_type(subst, &target_ty))
    }
  when MirRvalueKind::MirRepeat(op, count) then
    # (§20 const generics, slice 3): the repeat COUNT is an operand — the
    # SYMBOLIC MirConstParamValue placeholder for an in-scope const
    # parameter count substitutes through the ordinary operand path to the
    # concrete per-instance MirInt, exactly like a value read of the
    # parameter (the placeholder survives only while the body is still
    # generic; a concrete-instance body never emits a symbolic count —
    # codegen fails closed).
    MirRvalue { kind: MirRvalueKind::MirRepeat(substitute_operand(subst, &op), substitute_operand(subst, &count)) }
  when MirRvalueKind::MirPhi(pairs) then
    MirRvalue { kind: MirRvalueKind::MirPhi(pairs.clone()) }
  end  end
end

# The EXHAUSTIVE aggregate-kind substitution. MirArray(T) substitutes the
# element type (the array aggregate's element type may carry a generic
# parameter); the remaining kinds carry no type payload.
def substitute_aggregate_kind(subst: TypeSubstMap, kind: AggregateKind) -> AggregateKind
  match kind
  when AggregateKind::Tuple then AggregateKind::Tuple
  when AggregateKind::MirArray(ty) then AggregateKind::MirArray(substitute_type(subst, ty))
  when AggregateKind::Struct(tid, fields) then AggregateKind::Struct(tid.clone(), fields.clone())
  when AggregateKind::Closure(cid) then AggregateKind::Closure(ClosureId { id: cid.id })
  when AggregateKind::Generator(tid) then AggregateKind::Generator(tid.clone())
  end  end
end

# Substitute types in an operand (recursively substitutes in places and
# constants). ZERO-INFERENCE: the MirFnItem's INSTANCE payload args are
# substituted under the CALLER's specialization map too — a solved instance
# that still carries the caller's generic parameters ([Param "T"] from a
# still-generic caller, deferred by the monomorphizer's worklist) becomes
# the CONCRETE instance ([Int]) inside the specialized caller's body, so
# the re-walk enqueues it with zero inference. A subst entry the caller's
# map does not cover stays Param-carrying and keeps deferring.
def substitute_operand(subst: TypeSubstMap, op: MirOperand) -> MirOperand
  match op.kind
  when MirOperandKind::MirCopy(place) then
    MirOperand { kind: MirOperandKind::MirCopy(substitute_place(subst, &place)) }
  when MirOperandKind::MirMovePlace(place) then
    MirOperand { kind: MirOperandKind::MirMovePlace(substitute_place(subst, &place)) }
  when MirOperandKind::MirRead(place) then
    MirOperand { kind: MirOperandKind::MirRead(substitute_place(subst, &place)) }
  when MirOperandKind::MirConsume(place) then
    MirOperand { kind: MirOperandKind::MirConsume(substitute_place(subst, &place)) }
  when MirOperandKind::MirConstant(c) then
    # (§20 const generics, slice 3): the SYMBOLIC per-instance value of a
    # const generic parameter read (MirConstParamValue — the payload is
    # the parameter's numeric GenericParamId) resolves through the SAME
    # substitution map that substitutes its type:
    #   - Type::Const(v)     -> the CONCRETE MirInt(v) (the normal
    #     fully-solved case — the value of `N` at this instance);
    #   - Type::ConstParam(g2) -> an OUTER const parameter's reference:
    #     the placeholder FORWARDS with the outer id (the nested-generic
    #     deferral form; such instances only reach the drain once their
    #     substitutions are concrete, so this is the symbolic-argument
    #     fail-closed path — the specialization guard rejects those);
    #   - a missing/uncovered entry -> the placeholder survives (the
    #     post-instantiation verification's symbolic-argument guard
    #     rejects the body — never a fabricated value).
    match c.kind
    when MirConstantKind::MirConstParamValue(gpid_num) then
      let sub_ty = substitute_type(subst, &c.ty)
      match subst.params.get(gpid_num)
      when Option::Some(concrete) then
        match concrete
        when Type::Const(v) then
          MirOperand { kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirInt(v),
            ty: sub_ty,
            instance: Option::None
          })}
        when Type::ConstParam(g2) then
          MirOperand { kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirConstParamValue(generic_param_id_numeric(&g2)),
            ty: sub_ty,
            instance: Option::None
          })}
        when _ then
          MirOperand { kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirConstParamValue(gpid_num),
            ty: sub_ty,
            instance: Option::None
          })}
        end
      when Option::None then
        MirOperand { kind: MirOperandKind::MirConstant(MirConstant {
          kind: MirConstantKind::MirConstParamValue(gpid_num),
          ty: sub_ty,
          instance: Option::None
        })}
      end
    when _ then
    MirOperand { kind: MirOperandKind::MirConstant(MirConstant {
      kind: c.kind.clone(),
      ty: substitute_type(subst, &c.ty),
      instance: match c.instance.clone()
      when Option::Some(inst) then
        var new_args: Vec[GenericArg] = Vec::new()
        for a in inst.args do
          new_args.push(substitute_generic_arg(subst, a))
        end
        Option::Some(InstanceId { def: inst.def.clone(), args: new_args })
      when Option::None then Option::None
      end
    })}
    end
  end  end
end

# Substitute types in a place (places are local + projections, types are in locals)
def substitute_place(subst: TypeSubstMap, place: Place) -> Place
  Place {
    local: place.local.clone(),
    projections: place.projections.clone()
  }
end

def substitute_call_arg(subst: TypeSubstMap, arg: MirCallArg) -> MirCallArg
  MirCallArg {
    effect: arg.effect.clone(),
    value: match arg.value
    when MirCallValue::Value(op) then MirCallValue::Value(substitute_operand(subst, &op))
    when MirCallValue::Place(p) then MirCallValue::Place(substitute_place(subst, &p))
    end
  }
end

# The EXHAUSTIVE terminator substitution: every MirTerminatorKind variant
# is rebuilt; call/assert/switch/deinit payloads are substituted,
# including the assertion message's operands.
def substitute_terminator(subst: TypeSubstMap, term: MirTerminator) -> MirTerminator
  let new_kind = match term.kind
  when MirTerminatorKind::MirGoto(target) then MirTerminatorKind::MirGoto(target.clone())
  when MirTerminatorKind::MirReturn then MirTerminatorKind::MirReturn
  when MirTerminatorKind::MirUnreachable then MirTerminatorKind::MirUnreachable
  when MirTerminatorKind::MirSwitchInt(discr, targets, default_target) then
    let new_discr = substitute_operand(subst, &discr)
    MirTerminatorKind::MirSwitchInt { op: new_discr, targets: targets.clone(), default_target: default_target.clone() }
  when MirTerminatorKind::MirCall(dest, func_op, args, target, unwind, intrinsic, tail) then
    # Mangle callee name with substituted type arguments
    let mangled_op = substitute_operand(subst, &func_op)
    # Substitute types in arguments
    var new_args = Vec::new()
    for arg in args do
      new_args.push(substitute_call_arg(subst, arg))
    end
    # Substitute return type in destination
    let new_dest = substitute_place(subst, &dest)
    MirTerminatorKind::MirCall {
      dest: new_dest,
      func: mangled_op,
      args: new_args,
      success: target.clone(),
      unwind: unwind.clone(),
      intrinsic: intrinsic,
      tail: tail
    }
  when MirTerminatorKind::MirAssert(cond, expected, msg, target, unwind) then
    let new_cond = substitute_operand(subst, &cond)
    MirTerminatorKind::MirAssert {
      cond: new_cond,
      expected: expected.clone(),
      msg: substitute_assert_message(subst, &msg),
      target: target.clone(),
      unwind: unwind.clone()
    }
  when MirTerminatorKind::MirAbort then MirTerminatorKind::MirAbort
  when MirTerminatorKind::MirDeinit(place, deinit_fn, target, unwind) then
 # (the generic ownership policy — the concrete glue after
    # substitution): the MirDeinit payload is a SEMANTIC InstanceId; its
    # substitutions are substituted under the CALLER's specialization map
    # exactly like a MirConstant's instance payload (a payload still
    # carrying the caller's generic parameters — [Param "T"] from a
    # still-generic template — becomes the CONCRETE instance ([File])
    # inside the specialized caller's body, so the concrete drop glue after
    # substitution is what the instance destroys with). A subst entry the
    # caller's map does not cover stays Param-carrying and keeps deferring.
    let new_place = substitute_place(subst, &place)
    var new_deinit_args: Vec[GenericArg] = Vec::new()
    for a in deinit_fn.args do
      new_deinit_args.push(substitute_generic_arg(subst, a))
    end
    let new_deinit_fn = InstanceId { def: deinit_fn.def.clone(), args: new_deinit_args }
    MirTerminatorKind::MirDeinit { place: new_place, deinit_fn: new_deinit_fn, target: target.clone(), unwind: unwind.clone() }
  end
  MirTerminator { kind: new_kind, span: term.span.clone(), origin: term.origin.clone() }
end

# The TYPED generic-argument substitution (P0-5): a Type row substitutes
# through the ordinary type visitor; a Const row substitutes through its
# Type view (the const parameter map / symbolic-tree fold — the SAME
# const_sym fold the type visitor applies) and is classified back to its
# ConstValue constructor form. A Const row the substitution turns into a
# non-const type is a compiler-internal contract break (a const parameter
# bound to a type argument) — fail closed, never a silently re-typed row.
def substitute_generic_arg(subst: TypeSubstMap, arg: GenericArg) -> GenericArg
  match arg
  when GenericArg::Type(ty) then GenericArg::Type(substitute_type(subst, &ty))
  when GenericArg::Const(cv) then
    let view = substitute_type(subst, &const_value_type_view(cv))
    match view
    when Type::Const(v) then GenericArg::Const(ConstValue::Value(v))
    when Type::ConstParam(gpid) then GenericArg::Const(ConstValue::Param(gpid))
    when Type::ConstSym(tree) then GenericArg::Const(ConstValue::Sym(tree))
    when _ then
      panic("internal error: const generic argument substitution produced a non-const type — a const parameter was bound to a type argument (fail closed; no inferred value)")
    end
  end
end

def substitute_assert_message(subst: TypeSubstMap, msg: AssertMessage) -> AssertMessage
  match msg
  when AssertMessage::BoundsCheck(op1, op2) then
    AssertMessage::BoundsCheck(substitute_operand(subst, op1), substitute_operand(subst, op2))
  when AssertMessage::Overflow(bop) then AssertMessage::Overflow(bop.clone())
  when AssertMessage::DivisionByZero then AssertMessage::DivisionByZero
  when AssertMessage::RemainderByZero then AssertMessage::RemainderByZero
  when AssertMessage::NullPointer then AssertMessage::NullPointer
  when AssertMessage::ContractViolation(message) then AssertMessage::ContractViolation(message.clone())
  end  end
end

# ———————————————————————————————————————————————————————————————
# Call-Site Rewriting
# ———————————————————————————————————————————————————————————————

# After monomorphization, rewrite all call sites that reference generic
# functions so they point to the specialized (mangled) version instead.
def rewrite_call_sites_in_program(inout mir: MirProgram, inout cache: MonoCache) -> Unit
  # Pre-build a set of generic function names for fast lookup
  var generic_names = Set::new()
  for f in mir.functions do
    if is_generic_function(f) then
      generic_names.insert(f.name.clone())
    end
  end

  # (copy-mutation): the function/block walk is INDEXED and every rewrite
  # is written back through mir.functions — `for func in mir.functions`
  # binds a COPY, so the former `block.terminator.kind = ...` write was
  # lost and NO call site ever reached its `$`-suffixed instance name (a
  # call whose structural instance key IS cached still carried the generic
  # base name). Codegen's resolve_callee_label fails closed on an
  # unresolved generic base, so the rewrite must land.
  var fi = 0
  while fi < mir.functions.len() do
    var f_out = mir.functions[fi]
    var f_changed = false
    var bi = 0
    while bi < f_out.blocks.len() do
      var blk = f_out.blocks[bi]
      match blk.terminator.kind
      when MirTerminatorKind::MirCall(dest, callee, args, success, unwind, intrinsic, tail) then
        match callee.kind
        when MirOperandKind::MirConstant(const_val) then
          match const_val.kind
          when MirConstantKind::MirFnItem(callee_name) then
            # Only process calls to known generic functions
            if generic_names.contains(&callee_name) then
              # Look up the function definition in the program
              for candidate in mir.functions do
                if candidate.name == callee_name then
                  # (final): a SOLVED INSTANCE is the AUTHORITY. When
                  # the call operand's MirConstant carries an instance with
                  # NON-EMPTY args (the type checker solved this call's
                  # generic arguments), use inst.args DIRECTLY as the typed
                  # arguments — zero inference for this call; instance_key
                  # produces the mangled emission name and
                  # structured_instance_key the cache identity.
                  # ZERO-INFERENCE (fail-closed): there is NO fallback here.
                  # A call whose instance is not usable yet (None/empty
                  # args, or solved args still carrying Params from a
                  # still-generic caller) is left pointing at its base name:
                  # the caller's specialization substitutes the payload
                  # (substitute_operand carries the instance through), and
                  # the worklist Phase 1 enqueues it in a later iteration.
                  # A genuinely instance-less generic call was already
                  # reported by Phase 1; the rewrite pass never infers.
                  var mangled = "".to_string()
                  var specialized = false
                  match const_val.instance.clone()
                  when Option::Some(inst) then
                    if !inst.args.is_empty() && !has_any_param_args(&inst.args) then
                      # (audit item 49 migration; fourth-audit P0-6): the
                      # rewrite site holds the solved InstanceId, so the
                      # STRUCTURAL key is computed directly from it — the
                      # SAME derivation the cache insert boundary uses —
                      # and the emission label is derived from the record.
                      # The map is never keyed by the emission text.
                      let key_struct = structured_instance_key(cache, &inst)
                      mangled = structural_instance_mangle_text(key_struct.clone())
                      specialized = cache.instances.contains_key(&key_struct)
                    end
                  when Option::None then ()
                  end
                  if specialized && mangled != callee_name then
                    # Rewrite the call site to use the mangled instance
                    # name. The rewritten MirFnItem KEEPS the constant's
                    # instance payload (the semantic callee identity
                    # survives the emission-key rewrite). The write lands
                    # in the indexed function/block copy and is stored
                    # back below.
                    blk.terminator = MirTerminator {
                      kind: MirTerminatorKind::MirCall(
                        dest.clone(),
                        MirOperand {
                          kind: MirOperandKind::MirConstant(MirConstant {
                            kind: MirConstantKind::MirFnItem(mangled),
                            ty: const_val.ty.clone(),
                            instance: const_val.instance.clone()
                          })
                        },
                        args.clone(),
                        success.clone(),
                        unwind.clone(),
                        intrinsic,
                        tail
                      ),
                      span: blk.terminator.span.clone(),
                      origin: blk.terminator.origin.clone(),
                      provenance: blk.terminator.provenance.clone()
                    }
                    f_changed = true
                  end
                  break
                end
              end
            end
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
      f_out.blocks[bi] = blk
      bi = bi + 1
    end
    if f_changed then
      mir.functions[fi] = f_out
    end
    fi = fi + 1
  end
end

# Check if any type in a vector contains Type::Param.
def has_any_param_types(types: Vec[Type]) -> Bool
  for ty in types do
    if type_has_params(ty) then return true end
  end
  false
end

# Whether any TYPED generic argument still carries a generic parameter
# (P0-5): a Type row through type_has_params; a Const row for the
# Param/Sym forms (a concrete Value never carries one). The
# zero-inference enqueue/rewrite/specialize guards share this predicate.
def has_any_param_args(args: Vec[GenericArg]) -> Bool
  for arg in args do
    match arg
    when GenericArg::Type(ty) then
      if type_has_params(ty) then return true end
    when GenericArg::Const(cv) then
      match cv
      when ConstValue::Value(_) then ()
      when ConstValue::Param(_) then return true
      when ConstValue::Sym(tree) then
        if const_sym_tree_has_param(&tree) then return true end
      end
    end
  end
  false
end

# ———————————————————————————————————————————————————————————————
# Map/Set Dispatch-Call Injection 
# ———————————————————————————————————————————————————————————————
# Every map/set operation site hashes and compares its concrete key type
# through the CONCRETE Hash::hash / Eq::eq instances (user-defined
# `impl Hash for MyKey` / `impl Eq for MyKey` dispatch; kernel key types
# dispatch to the runtime helpers instead — see codegen's
# map_hash_dispatch_label / map_eq_dispatch_label). For the impls to be
# EMITTED (reachable) and GENERIC impls to be specialized, the program
# must contain call sites referencing them. This pass runs INSIDE
# monomorphize_program (after the first specialization wave, when every
# call site's key type is concrete — including formerly-Param keys in
# specialized generic bodies) and injects a hash call and an eq call ahead
# of every key-operating map/set intrinsic call:
#
#   hash_dispatch_tmp = MyKey__hash(&key)     (instance payload by
#   eq_dispatch_tmp   = MyKey__eq(&key, &key)   construction: the
#                                                 resolver DefId + the
#                                                 concrete key type)
#  ... the original map intrinsic call...
#
# The injected calls carry the SOLVED instance (zero inference); the
# monomorphizer's second wave specializes the generic impls and the final
# rewrite points the injected call sites at the mangled instance names.
# The calls are pure (hashing/equality of the live key); their results are
# discarded — their PURPOSE is reachability + specialization. The codegen
# computes its own hash call at the map-op site and resolves the same
# labels.
#
# The core-ABI gate: dispatch_methods records each impl method's DECLARED
# parameter count; a core-ABI hash declares exactly 1 param
# (hash(self) -> Int), a core-ABI eq exactly 2 (eq(self, other) -> Bool).
# Hasher-style impls (`def hash[H: Hasher](self, state)`) declare 2 and
# are skipped.

# The map/set intrinsics whose operations hash and compare the key.
def map_key_op_intrinsic_name(name: String) -> Bool
  name == "__intrinsic_map_insert" || name == "__intrinsic_map_get" ||
  name == "__intrinsic_map_remove" || name == "__intrinsic_map_contains_key" ||
  name == "__intrinsic_set_insert" || name == "__intrinsic_set_contains" ||
  name == "__intrinsic_set_remove"
end

# Kernel key types that dispatch to the runtime helpers (their registered
# std::hash impls are Hasher-style — a different ABI). String keys
# (— the owned String object) dispatch to _tg_hash_str /
# _tg_eq_str, which unwrap the String object header and hash/compare the
# data bytes; the map/set key slots hold the String-object pointer.
def mono_kernel_map_key_type(ty: Type) -> Bool
  match ty
  when Type::Int then true
  when Type::UInt then true
  when Type::Bool then true
  when Type::Char then true
  when Type::Float then true
  when Type::F32 then true
  when Type::F64 then true
  when Type::I8 then true
  when Type::I16 then true
  when Type::I32 then true
  when Type::I64 then true
  when Type::I128 then true
  when Type::U8 then true
  when Type::U16 then true
  when Type::U32 then true
  when Type::U64 then true
  when Type::U128 then true
  when Type::ISize then true
  when Type::USize then true
  when Type::String then true
  when _ then false
  end  end
end

# The key operand's place in a map/set intrinsic call (args[1]).
def map_op_key_place(args: Vec[MirCallArg]) -> Option[Place]
  if args.len() < 2 then
    return Option::None
  end
  match args[1].value
  when MirCallValue::Place(p) then Option::Some(p.clone())
  when MirCallValue::Value(op) then
    match op.kind
    when MirOperandKind::MirCopy(p) then Option::Some(p.clone())
    when MirOperandKind::MirMovePlace(p) then Option::Some(p.clone())
    when MirOperandKind::MirRead(p) then Option::Some(p.clone())
    when MirOperandKind::MirConsume(p) then Option::Some(p.clone())
    when _ then Option::None
    end
  end
end

# The key place's local type by id.
def mono_mir_local_type(f: MirFunction, local_id: Int) -> Type
  for l in f.locals do
    if l.id.id == local_id then
      return l.ty.clone()
    end
  end
  Type::Unit
end

# The concrete key TYPE and the KEY place to borrow for the injected
# calls. For `&K` operands (get/remove/contains) the borrowed place is the
# reference's pointee.
def map_op_key_type_and_place(f: MirFunction, args: Vec[MirCallArg]) -> Option[(Type, Place)]
  match map_op_key_place(args)
  when Option::Some(p) then
    let lt = mono_mir_local_type(f, p.local.id)
    match lt
    when Type::RefInternal(inner, _) then
      var projs = p.projections.clone()
      projs.push(Projection::ProjDeref)
      Option::Some((inner.clone(), Place { local: p.local, projections: projs }))
    when _ then Option::Some((lt.clone(), p))
    end
  when Option::None then Option::None
  end  end
end

# The concrete type's MIR name by TypeId.
def mono_mir_type_name(mir: MirProgram, tid: TypeId) -> String
  for td in mir.types do
    if td.id.id == tid.id then
      return td.name.clone()
    end
  end
  ""
end

# The impl method base name for a concrete key type ("MyKey__hash"), or
# None for kernel types and StrView.
def mono_map_key_impl_base(mir: MirProgram, k_ty: Type, method: String) -> Option[String]
  if mono_kernel_map_key_type(k_ty) then
    return Option::None
  end
  match k_ty
  when Type::Adt(tid, _) then
    let tn = mono_mir_type_name(mir, tid)
 # the StrView key selection is the LangItems str_view TypeId — the
    # semantic identity — never the registered name. The -1 defensive
    # fallback (a snapshot with no StrView registration) keeps the name
    # check ONLY as the registration-absence path (mirroring the tree's
    # snapshot-fallback pattern for the id-selected builtins); the semantic
    # decision is the id.
    let str_view_id = mir.lang_items.str_view
    if str_view_id != -1 then
      if tid.id == str_view_id then
        Option::None
      else
        Option::Some(tn + "__" + method)
      end
    else
      if tn == "StrView" then
        Option::None
      else
        Option::Some(tn + "__" + method)
      end
    end
  when _ then Option::None
  end
end

# A fresh local id for the injected temporaries.
def mono_fresh_local_id(f: MirFunction) -> Int
  var max_id = 0
  for l in f.locals do
    if l.id.id > max_id then
      max_id = l.id.id
    end
  end
  max_id + 1
end

# The argument count of the injected dispatch instance: mono_dispatch_fn_operand
# constructs exactly ONE GenericArg::Type (the concrete key type). The arity
# guard below compares this count against the template's declared binder list.
const MONO_DISPATCH_INSTANCE_ARGS: Int = 1

# The dispatch-template ARITY INDEX (FINDING 10): the per-program
# precomputation of the arity verdict. inject_map_dispatch_calls builds it
# ONCE (dispatch_template_arity_index) before its per-site injection loop
# — the guard formerly scanned all of mir.functions at every hash/eq gate,
# costing O(functions) per dispatch site. The fields the scan read
# (is_generic_function over the declared binders/signature/local types,
# and the declared binder count) are INVARIANT under dispatch injection
# (which only appends fresh concrete-typed locals and blocks and replaces
# terminators), and no function is added or renamed during the pass — so
# the precomputed verdict is exactly the old scan's.
struct DispatchTemplateArity
  generic: Bool
  binder_count: Int
end

# Build the name -> arity-verdict index in mir.functions order. The old
# linear scan returned on the FIRST function carrying a name, so the
# index keeps the first occurrence and ignores later namesakes
# (duplicate-name behavior preserved).
def dispatch_template_arity_index(mir: MirProgram) -> Map[String, DispatchTemplateArity]
  var index: Map[String, DispatchTemplateArity] = Map::new()
  for candidate in mir.functions do
    if !index.contains_key(&candidate.name) then
      index.insert(candidate.name.clone(), DispatchTemplateArity {
        generic: is_generic_function(candidate),
        binder_count: function_generic_param_names(candidate).len()
      })
    end
  end
  index
end

# The dispatch-template ARITY GUARD (mirror of specialize_function_keyed's
# fail-closed exact-arity check, mono.tg's `type_param_ids.len() !=
# args.len()`), consulted through the precomputed arity index. The
# injected instance carries EXACTLY ONE argument (the concrete key type —
# mono_dispatch_fn_operand's construction), so a GENERIC dispatch template
# must declare exactly one declaration-order binder for the drain to
# specialize it: a multi-parameter generic impl (`impl[A, B] Hash for
# Pair[A, B]`) would otherwise trip the arity error and abort the
# compilation. A NON-generic template declares no binders and has no
# specialization path — its emitted body is the call target, so the
# reachability injection still applies (the arity guard governs ONLY
# specialize_function_keyed's input). A name ABSENT from the index cannot
# resolve the injected call at all: fail closed and never inject.
def mono_dispatch_template_arity_ok(index: Map[String, DispatchTemplateArity], base: String) -> Bool
  match index.get(&base)
  when Option::Some(template) then
    if !template.generic then
      return true
    end
    return template.binder_count == MONO_DISPATCH_INSTANCE_ARGS
  when Option::None then ()
  end
  false
end

# The injected callee operand: the MirFnItem with the SOLVED instance
# (resolver DefId + the concrete key type as the typed argument).
def mono_dispatch_fn_operand(base: String, did: DefId, k_ty: Type) -> MirOperand
  MirOperand {
    kind: MirOperandKind::MirConstant(MirConstant {
      kind: MirConstantKind::MirFnItem(base.clone()),
      ty: Type::FnPtr(Vec::new(), Type::Unit, Vec::new()),
      instance: Option::Some(InstanceId { def: CallableId { def: did.clone() }, args: vec![GenericArg::Type(k_ty.clone())] })
    })
  }
end

# Inject the hash/eq dispatch calls ahead of the map/set intrinsic call at
# block `site` of `func`. The original call becomes the terminator of a
# fresh block; the injected calls chain ahead of it.
def apply_dispatch_injection(mir: MirProgram, dispatch_arity: Map[String, DispatchTemplateArity], inout func: MirFunction, site: Int) -> Unit
  let block = func.blocks[site]
  match block.terminator.kind
  when MirTerminatorKind::MirCall(dest, callee, args, success, unwind, intrinsic, _) then
    match map_op_key_type_and_place(func, &args)
    when Option::Some((k_ty, key_place)) then
      if type_has_params(&k_ty) then
        # A residual Param here is a compiler-internal gap; leave the site
        # untouched (the codegen falls back to the kernel helpers).
        return
      end
      let hash_base = match mono_map_key_impl_base(mir, &k_ty, "hash")
      when Option::Some(hb) then Option::Some(hb)
      when Option::None then Option::None
      end
      let eq_base = match mono_map_key_impl_base(mir, &k_ty, "eq")
      when Option::Some(eb) then Option::Some(eb)
      when Option::None then Option::None
      end
      # Core-ABI gates from the dispatch metadata (declared param counts).
      let hash_did: Option[DefId] = Option::None
      match hash_base
      when Option::Some(hb) then
        match mir.dispatch_methods.get(&hb)
        when Option::Some((did, _, pc)) then
          if pc == 1 then
            # ARITY GATE (mono_dispatch_template_arity_ok): a generic
            # template must declare exactly one binder for the injected
            # one-argument instance to specialize; otherwise THIS dispatch
            # call is not injected (the drain's arity error is never
            # tripped) — the eq gate below is independent.
            if mono_dispatch_template_arity_ok(dispatch_arity, &hb) then
              hash_did = Option::Some(did.clone())
            end
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
      let eq_did: Option[DefId] = Option::None
      match eq_base
      when Option::Some(eb) then
        match mir.dispatch_methods.get(&eb)
        when Option::Some((did2, _, pc2)) then
          if pc2 == 2 then
            # ARITY GATE (mono_dispatch_template_arity_ok): same as hash.
            if mono_dispatch_template_arity_ok(dispatch_arity, &eb) then
              eq_did = Option::Some(did2.clone())
            end
          end
        when Option::None then ()
        end
      when Option::None then ()
      end
      # Core-ABI gate: neither a hash nor an eq impl resolved -> nothing to
      # inject (the codegen dispatches to the kernel/structural helpers).
      match hash_did
      when Option::Some(_) then ()
      when Option::None then
        match eq_did
        when Option::Some(_) then ()
        when Option::None then return
        end
      end
      # The borrowed-key temporary: `key_ref = &key`.
      let ref_id = mono_fresh_local_id(func)
      let ref_local = MirLocal {
        id: MirLocalId { id: ref_id },
        name: "map_dispatch_key_ref".to_string(),
        ty: Type::RefInternal(k_ty.clone(), false),
        is_mut: false,
        span: block.terminator.span.clone()
      }
      func.locals.push(ref_local)
      func.blocks[site].statements.push(MirStatement {
        kind: MirStatementKind::MirAssign(
          Place { local: MirLocalId { id: ref_id }, projections: Vec::new() },
          MirRvalue { kind: MirRvalueKind::MirRef(key_place) }
        ),
        span: block.terminator.span.clone(),
        origin: Option::Some(stable_mir_node_id_of_generated(
          func.name.clone(), func.name.clone(), "map-dispatch".to_string(),
          "key-ref".to_string(), ref_id))
      })
      # The chain: current terminator -> hash call -> eq call -> original.
      var chain_head = MirTerminator {
        kind: MirTerminatorKind::MirCall(dest.clone(), callee.clone(), args.clone(), success.clone(), unwind.clone(), intrinsic, false),
        span: block.terminator.span.clone(),
        origin: Option::Some(stable_mir_node_id_of_generated(
          func.name.clone(), func.name.clone(), "map-dispatch".to_string(),
          "key-ref-call".to_string(), ref_id))
      }
      # eq call (innermost first)
      match eq_did
      when Option::Some(eq_did_v) then
        match eq_base
        when Option::Some(eq_base_v) then
          let eq_tmp_id = mono_fresh_local_id(func)
          func.locals.push(MirLocal {
            id: MirLocalId { id: eq_tmp_id },
            name: "map_dispatch_eq_tmp".to_string(),
            ty: Type::Bool,
            is_mut: false,
            span: block.terminator.span.clone()
          })
          let eq_blk = MirBlock {
            id: MirBlockId { id: func.blocks.len() },
            statements: Vec::new(),
            terminator: chain_head,
            origin: Option::Some(stable_mir_block_id_of_control_generated(
              func.name.clone(), func.name.clone(), "map-dispatch".to_string(),
              "eq-call".to_string(), func.blocks.len()))
          }
          func.blocks.push(eq_blk)
          let ref_place = Place { local: MirLocalId { id: ref_id }, projections: Vec::new() }
          chain_head = MirTerminator {
            kind: MirTerminatorKind::MirCall(
              Place { local: MirLocalId { id: eq_tmp_id }, projections: Vec::new() },
              mono_dispatch_fn_operand(&eq_base_v, &eq_did_v, &k_ty),
              vec![
                MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(ref_place.clone()) }) },
                MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(ref_place) }) }
              ],
              MirBlockId { id: func.blocks.len() - 1 },
              Option::None,
              Option::None,
              false
            ),
            span: block.terminator.span.clone(),
            origin: Option::Some(stable_mir_node_id_of_generated(
              func.name.clone(), func.name.clone(), "map-dispatch".to_string(),
              "eq-call".to_string(), eq_tmp_id))
          }
        when Option::None then ()
        end
      when Option::None then ()
      end
      # hash call (outermost)
      match hash_did
      when Option::Some(hash_did_v) then
        match hash_base
        when Option::Some(hash_base_v) then
          let hash_tmp_id = mono_fresh_local_id(func)
          func.locals.push(MirLocal {
            id: MirLocalId { id: hash_tmp_id },
            name: "map_dispatch_hash_tmp".to_string(),
            ty: Type::Int,
            is_mut: false,
            span: block.terminator.span.clone()
          })
          let hash_blk = MirBlock {
            id: MirBlockId { id: func.blocks.len() },
            statements: Vec::new(),
            terminator: chain_head,
            origin: Option::Some(stable_mir_block_id_of_control_generated(
              func.name.clone(), func.name.clone(), "map-dispatch".to_string(),
              "hash-call".to_string(), func.blocks.len()))
          }
          func.blocks.push(hash_blk)
          let ref_place2 = Place { local: MirLocalId { id: ref_id }, projections: Vec::new() }
          chain_head = MirTerminator {
            kind: MirTerminatorKind::MirCall(
              Place { local: MirLocalId { id: hash_tmp_id }, projections: Vec::new() },
              mono_dispatch_fn_operand(&hash_base_v, &hash_did_v, &k_ty),
              vec![MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(MirOperand { kind: MirOperandKind::MirCopy(ref_place2) }) }],
              MirBlockId { id: func.blocks.len() - 1 },
              Option::None,
              Option::None,
              false
            ),
            span: block.terminator.span.clone(),
            origin: Option::Some(stable_mir_node_id_of_generated(
              func.name.clone(), func.name.clone(), "map-dispatch".to_string(),
              "hash-call".to_string(), hash_tmp_id))
          }
        when Option::None then ()
        end
      when Option::None then ()
      end
      func.blocks[site].terminator = chain_head
    when Option::None then ()
    end
  when _ then ()
  end
end

# Scan the whole program: every CONCRETE function (generic templates are
# skipped — their sites become concrete in the specialized bodies) with a
# key-operating map/set intrinsic call gets the dispatch calls injected.
def inject_map_dispatch_calls(inout mir: MirProgram) -> Unit
  # (copy-mutation): the walk is INDEXED and the mutated function is
  # written back through mir.functions — `for func in mir.functions`
  # binds a COPY, so every write apply_dispatch_injection performed
  # (the key-ref statement, the fresh locals/blocks, the replaced
  # terminator) mutated the discarded copy and the whole pass was a
  # silent no-op. The write-back mirrors rewrite_call_sites_in_program's
  # indexed walk.
  # (FINDING 10): the dispatch-template arity index is built ONCE for the
  # whole program — the hash/eq gates formerly scanned mir.functions per
  # site; the index is stable across the pass (dispatch_template_arity_index).
  let dispatch_arity = dispatch_template_arity_index(mir)
  var fi = 0
  while fi < mir.functions.len() do
    var func = mir.functions[fi]
    if !is_generic_function(func) then
      var sites: Vec[Int] = Vec::new()
      var bi = 0
      while bi < func.blocks.len() do
        match func.blocks[bi].terminator.kind
        when MirTerminatorKind::MirCall(_, callee, _, _, _, _, _) then
          match callee.kind
          when MirOperandKind::MirConstant(cv) then
            match cv.kind
            when MirConstantKind::MirFnItem(name) then
              if map_key_op_intrinsic_name(&name) then
                sites.push(bi)
              end
            when _ then ()
            end
          when _ then ()
          end
        when _ then ()
        end
        bi = bi + 1
      end
      if !sites.is_empty() then
        for site in sites do
          apply_dispatch_injection(mir, dispatch_arity, &mut func, site)
        end
        mir.functions[fi] = func
      end
    end
    fi = fi + 1
  end
end

# ———————————————————————————————————————————————————————————————
# Trait-contract devirtualization (the bodyless re-dispatch)
# ———————————————————————————————————————————————————————————————
# A call on a generic-bound receiver (`I: Iterator[T]`'s
# `self.inner.advance()` in the adapters, `self.advance()` in the
# extension impls) is lowered under the CONTRACT's surface name — the bare
# method name `advance`: a bounded Param receiver has no owner TypeId, so
# the lowering's owner-name resolution declines and the concrete impl's
# method is lowered separately under its `Type__method` emission name
# (`VecIterator__advance`). Once a body is SPECIALIZED its receiver type
# is concrete, so the call can be re-dispatched to the concrete impl's
# method instance — the body the specializer emits — exactly as the
# seed's Mono.build ~resolve_bodyless (stage0_ocaml/src/mono.ml and
# driver.ml's mono_bodyless_resolver) re-dispatches a body-less contract
# instance to the concrete impl's registered method. Without this wave a
# concrete-specialized caller keeps referencing the contract surface,
# which no emitted body answers.
#
# SELECTION (the seed's rule): the receiver type is the call's FIRST
# argument — the receiver operand's place local type with the RefInternal
# ABI wrapper peeled — AFTER substitution; the concrete impl is the
# lowered template whose method segment matches the callee name and whose
# DECLARED receiver parameter type (the template's `self` parameter,
# params[0].ty) unifies with that receiver type. The instance arguments
# are the template's declaration-order generic parameters bound by that
# unification; the unification only READS the already-substituted
# receiver type (ZERO-INFERENCE: nothing is inferred from the call), and
# an instance argument the receiver type does not solve is never
# fabricated.
#
# FAIL-CLOSED / DEFERRAL (the seed's keep-vs-error split):
#   - a receiver still carrying generic parameters DEFERS: the caller's
#     own specialization substitutes the receiver type and this wave
#     revisits the specialized body (the worklist's shape-2 contract);
#   - a callee name that is NOT the contract surface (an emission-mangled
#     name, an intrinsic label, or an already-lowered function) is left
#     to the class that owns it (keep) — the monomorphizer never guesses
#     an owner for a name the lowering did not produce from a bound
#     receiver;
#   - a bare contract name whose candidate impl templates exist but none
#     unifies with the concrete receiver (including a candidate whose
#     declaration-order parameters the receiver type cannot solve) FAILS
#     CLOSED with the precise caller/callee/receiver context: the
#     concrete impl the checker's bound resolution promised does not
#     exist at this instance.

# The method segment of an emission name: the text after the LAST "__"
# ("VecIterator__advance" -> "advance"). A bare name is returned as-is —
# the lowering's bound-receiver contract surface (`advance`).
def devirt_method_segment(name: String) -> String
  match name.rfind("__")
  when Option::Some(pos) then name.slice(pos + 2, name.len())
  when Option::None then name.clone()
  end
end

# The receiver type of a call: the first argument's place local type with
# the RefInternal ABI wrapper peeled (the lowering passes an unborrowed
# receiver through a ref temp; a borrowed receiver arrives already-ref).
# None when the first argument is not a place.
def devirt_receiver_type(inout func: MirFunction, args: Vec[MirCallArg]) -> Option[Type]
  if args.is_empty() then
    return Option::None
  end
  let place_opt = match args[0].value
  when MirCallValue::Value(op) then
    match op.kind
    when MirOperandKind::MirCopy(p) then Option::Some(p.clone())
    when MirOperandKind::MirMovePlace(p) then Option::Some(p.clone())
    when MirOperandKind::MirRead(p) then Option::Some(p.clone())
    when MirOperandKind::MirConsume(p) then Option::Some(p.clone())
    when _ then Option::None
    end
  when MirCallValue::Place(p) then Option::Some(p.clone())
  end
  match place_opt
  when Option::Some(p) then
    var peeled = Type::Unit
    for l in func.locals do
      if l.id.id == p.local.id then
        peeled = l.ty.clone()
        break
      end
    end
    var peel_depth = 0
    while peel_depth < 4 do
      match peeled.clone()
      when Type::RefInternal(inner, _) then
        peeled = inner
        peel_depth = peel_depth + 1
      when _ then break
      end
    end
    Option::Some(peeled)
  when Option::None then Option::None
  end
end

# whether the callee name is a surface the codegen/runtime answers without
# an emitted body (the intrinsic router's name-only classification — the
# same test the verifier's accepted-name rule runs first).
def devirt_intrinsic_surface(name: String) -> Bool
  if name.len() >= 12 && name.slice(0, 12) == "__intrinsic_" then return true end
  match intrinsic_id_of_call(&name, &Type::Unit, &"".to_string(), &Type::Unit, &"".to_string(), &name, false, false)
  when Option::Some(_) then true
  when Option::None then false
  end
end

# Structural head unification of a template's declared receiver parameter
# type against the concrete receiver type: Type::Param / Type::ConstParam
# rows BIND (the declaration-order parameter -> the concrete argument),
# every other row must match structurally. The map is keyed by the
# parameter's numeric id — the mono substitution's own key space.
def devirt_unify_head(tmpl_ty: Type, recv_ty: Type, inout bind: Map[Int, Type]) -> Bool
  match tmpl_ty
  when Type::Param(gpid) then
    let key = generic_param_id_numeric(&gpid)
    match bind.get(key)
    when Option::Some(prev) then type_eq(&prev, &recv_ty)
    when Option::None then
      bind.insert(key, recv_ty.clone())
      true
    end
  when Type::ConstParam(gpid) then
    let key = generic_param_id_numeric(&gpid)
    match bind.get(key)
    when Option::Some(prev) then type_eq(&prev, &recv_ty)
    when Option::None then
      bind.insert(key, recv_ty.clone())
      true
    end
  when Type::Adt(tid, args) then
    match recv_ty
    when Type::Adt(rtid, rargs) then
      if tid.id != rtid.id || args.len() != rargs.len() then
        false
      else
        var ok = true
        var i = 0
        while i < args.len() do
          if !devirt_unify_head(args[i].clone(), rargs[i].clone(), &mut bind) then
            ok = false
            break
          end
          i = i + 1
        end
        ok
      end
    when _ then false
    end
  when Type::Tuple(elems) then
    match recv_ty
    when Type::Tuple(relems) then
      if elems.len() != relems.len() then
        false
      else
        var ok = true
        var i = 0
        while i < elems.len() do
          if !devirt_unify_head(elems[i].clone(), relems[i].clone(), &mut bind) then
            ok = false
            break
          end
          i = i + 1
        end
        ok
      end
    when _ then false
    end
  when Type::RefInternal(inner, mutable) then
    match recv_ty
    when Type::RefInternal(rinner, rmut) then
      if mutable != rmut then
        false
      else
        devirt_unify_head(inner, rinner, &mut bind)
      end
    when _ then devirt_unify_head(inner, recv_ty, &mut bind)
    end
  when Type::Ptr(inner) then
    match recv_ty
    when Type::Ptr(rinner) then devirt_unify_head(inner, rinner, &mut bind)
    when _ then false
    end
  when Type::PtrMut(inner) then
    match recv_ty
    when Type::PtrMut(rinner) then devirt_unify_head(inner, rinner, &mut bind)
    when _ then false
    end
  when Type::FixedArray(elem, n) then
    match recv_ty
    when Type::FixedArray(relem, rn) then
      if n != rn then
        false
      else
        devirt_unify_head(elem, relem, &mut bind)
      end
    when _ then false
    end
  when _ then type_eq(&tmpl_ty, &recv_ty)
  end
end

# ONE devirtualization candidate: the lowered impl-method template whose
# method segment a contract call may re-dispatch to, with the DECLARED
# inputs the receiver-type unification reads (the template's `self`
# parameter type, its declaration-order generic parameters, its declared
# return type) and the impl method's semantic DefId (the dispatch
# registry's record — the instance identity's callable face).
struct DevirtCandidate
  template_name: String
  self_ty: Type
  generic_params: Vec[GenericParamId]
  ret_type: Type
  did: DefId
end

# The per-wave candidate index: method segment -> the impl-method
# templates carrying it. Only templates that declare a receiver parameter
# are candidates (a `Type__method` emission name — the non-method surface
# is never a contract target); the DefId comes from the same dispatch
# registry the map-key injection reads. The candidate's DECLARED receiver
# and return types are canonicalized against its own declared binder list
# before the receiver unification reads them (canonical_param_aliases), so
# the binders the unification pairs — and the instance arguments it
# solves — are the canonical ids.
def devirt_candidate_index(mir: MirProgram, param_names: Map[Int, String]) -> Map[String, Vec[DevirtCandidate]]
  var index: Map[String, Vec[DevirtCandidate]] = Map::new()
  for tmpl in mir.functions do
    if tmpl.params.is_empty() then
      next
    end
    let segment = devirt_method_segment(tmpl.name.clone())
    if segment == tmpl.name then
      next
    end
    match mir.dispatch_methods.get(&tmpl.name)
    when Option::Some((did, _, _)) then
      var rows = match index.get(&segment)
      when Option::Some(v) then v.clone()
      when Option::None then Vec::new()
      end
      var observed: Vec[GenericParamId] = Vec::new()
      collect_param_ids_in_type(tmpl.params[0].ty.clone(), &mut observed)
      collect_param_ids_in_type(tmpl.ret_type.clone(), &mut observed)
      var aliases: Map[Int, GenericParamId] = Map::new()
      if has_noncanonical_param_ids(tmpl.generic_params.clone(), observed.clone()) then
        aliases = canonical_param_aliases(param_names.clone(), tmpl.generic_params.clone(), observed)
      end
      rows.push(DevirtCandidate {
        template_name: tmpl.name.clone(),
        self_ty: rewrite_param_aliases_in_type(aliases.clone(), tmpl.params[0].ty.clone()),
        generic_params: tmpl.generic_params.clone(),
        ret_type: rewrite_param_aliases_in_type(aliases.clone(), tmpl.ret_type.clone()),
        did: did.clone()
      })
      index.insert(segment, rows)
    when Option::None then ()
    end
  end
  index
end

# Resolve ONE bound-receiver contract call to the concrete impl method's
# instance operand. Returns None when the site is not this wave's class
# (the caller keeps it). A concrete receiver with candidate impl
# templates that do not unify records the fail-closed row in `errors`.
def devirt_resolve_contract_call(
  inout index: Map[String, Vec[DevirtCandidate]],
  inout lowered: Set[String],
  inout func: MirFunction,
  block_id: Int,
  callee_name: String,
  args: Vec[MirCallArg],
  inout errors: Vec[String]
) -> Option[MirOperand]
  # The contract surface is a BARE method name; an emission-mangled name
  # (or a lowered function / intrinsic label) belongs to another class.
  if lowered.contains(&callee_name) then
    return Option::None
  end
  let method = devirt_method_segment(callee_name.clone())
  if method != callee_name then
    return Option::None
  end
  if devirt_intrinsic_surface(callee_name.clone()) then
    return Option::None
  end
  match devirt_receiver_type(&mut func, args)
  when Option::None then Option::None
  when Option::Some(recv_ty) then
    if type_has_params(&recv_ty) then
      # DEFER: the caller's own specialization substitutes the receiver
      # type; the wave revisits the specialized body.
      return Option::None
    end
    # (fail-closed scope): only a NOMINAL concrete receiver is a
    # contract-call shape this wave owns. A fn-pointer / closure receiver
    # is a value-position call (another lowering class); the receiver Adt
    # gate keeps the fail-closed row from firing on those.
    let recv_is_adt = match recv_ty.clone()
    when Type::Adt(_, _) then true
    when _ then false
    end
    let cands = match index.get(&method)
    when Option::Some(v) then v.clone()
    when Option::None then Vec::new()
    end
    var matches = 0
    var found_name = "".to_string()
    var found_did: Option[DefId] = Option::None
    var found_args: Vec[GenericArg] = Vec::new()
    var found_ret = func.ret_type.clone()
    for cand in cands do
      # an EXTENSION-impl template (a bare-parameter head, `I__fold`) is
      # never a concrete selection: the lowering already names those
      # methods from the registered param-for-type table, so a concrete
      # receiver selects only a DECLARED head.
      let head_is_param = match cand.self_ty.clone()
      when Type::Param(_) then true
      when Type::ConstParam(_) then true
      when _ then false
      end
      if head_is_param then
        next
      end
      var bind: Map[Int, Type] = Map::new()
      if !devirt_unify_head(cand.self_ty.clone(), recv_ty.clone(), &mut bind) then
        next
      end
      # every declaration-order parameter must be solved by the receiver
      # type — an unsolved parameter makes the candidate unselectable
      # (never a fabricated argument).
      var solved = true
      var tmpl_args: Vec[GenericArg] = Vec::new()
      for gpid in cand.generic_params.clone() do
        match bind.get(generic_param_id_numeric(&gpid))
        when Option::Some(bound) then tmpl_args.push(generic_arg_of_type_view(bound.clone()))
        when Option::None then solved = false
        end
      end
      if !solved then
        next
      end
      if matches == 0 then
        found_name = cand.template_name.clone()
        found_did = Option::Some(cand.did.clone())
        found_args = tmpl_args.clone()
        let subst = type_subst_new_args(cand.generic_params.clone(), tmpl_args.clone())
        found_ret = substitute_type(&subst, &cand.ret_type.clone())
      end
      matches = matches + 1
    end
    if matches == 1 then
      match found_did
      when Option::Some(did) then
        Option::Some(MirOperand {
          kind: MirOperandKind::MirConstant(MirConstant {
            kind: MirConstantKind::MirFnItem(found_name.clone()),
            ty: Type::FnPtr(Vec::new(), found_ret.clone(), Vec::new()),
            instance: Option::Some(InstanceId { def: CallableId { def: did.clone() }, args: found_args.clone() })
          })
        })
      when Option::None then Option::None
      end
    else
      if matches > 1 && recv_is_adt then
        let msg = "monomorphization: trait-contract devirtualization for `" + callee_name.clone() + "` on the concrete receiver `" + type_to_mangled(recv_ty.clone()) + "` in `" + func.name.clone() + "` (bb" + block_id.to_string() + ") matched " + matches.to_string() + " impl templates — ambiguous, no rewrite (fail closed)"
        if !errors.contains(&msg) then
          errors.push(msg)
        end
      elsif cands.len() > 0 && recv_is_adt then
        let msg = "monomorphization: no impl of `" + callee_name.clone() + "` for the concrete receiver `" + type_to_mangled(recv_ty.clone()) + "` in `" + func.name.clone() + "` (bb" + block_id.to_string() + ") — the bound-contract call has no concrete impl at this instance (fail closed)"
        if !errors.contains(&msg) then
          errors.push(msg)
        end
      end
      Option::None
    end
  end
end

# The trait-contract devirtualization wave: rewrite every resolvable
# bound-receiver contract call in the program's bodies. Returns true when
# at least one call site was rewritten (the caller re-walks and drains).
# The lowered emission-name set is the wave's trigger boundary: a callee
# that already names an emitted function (template or instance) is never
# a contract surface row. `param_names` is the serialized param-name table
# the candidate index's canonical binder bijection reads.
def devirtualize_contract_calls(inout mir: MirProgram, inout errors: Vec[String], param_names: Map[Int, String]) -> Bool
  var changed = false
  var lowered: Set[String] = Set::new()
  for f in mir.functions do
    lowered.insert(f.name.clone())
  end
  var index = devirt_candidate_index(mir, param_names.clone())
  var fi = 0
  while fi < mir.functions.len() do
    var f_out = mir.functions[fi]
    var bi = 0
    while bi < f_out.blocks.len() do
      var rewrite: Option[MirOperand] = Option::None
      match f_out.blocks[bi].terminator.kind
      when MirTerminatorKind::MirCall(_, callee, args, _, _, _, _) then
        match callee.kind
        when MirOperandKind::MirConstant(cv) then
          match cv.kind
          when MirConstantKind::MirFnItem(name) then
            rewrite = devirt_resolve_contract_call(&mut index, &mut lowered, &mut f_out, bi, name.clone(), args.clone(), &mut errors)
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
      match rewrite
      when Option::Some(new_callee) then
        var blk = f_out.blocks[bi]
        match blk.terminator.kind
        when MirTerminatorKind::MirCall(dest, _, cargs, success, unwind, intrinsic, tail) then
          blk.terminator = MirTerminator {
            kind: MirTerminatorKind::MirCall(dest, new_callee, cargs, success, unwind, intrinsic, tail),
            span: blk.terminator.span.clone(),
            origin: blk.terminator.origin.clone(),
            provenance: blk.terminator.provenance.clone()
          }
          f_out.blocks[bi] = blk
          mir.functions[fi] = f_out
          changed = true
        when _ then ()
        end
      when Option::None then ()
      end
      bi = bi + 1
    end
    fi = fi + 1
  end
  changed
end

# ———————————————————————————————————————————————————————————————
# Monomorphize Program: instance WORK QUEUE entry point
# ———————————————————————————————————————————————————————————————
# (final): the worklist is instance-driven — a real work queue of
# INSTANCES (`pending`, seeded with the generic call sites of the program)
# plus a `seen` set, so each instance is specialized AT MOST ONCE. There is
# no iteration ceiling: the queue drains for every FINITE instance set.
# MAX_MONO_INSTANCES is a CONFIGURABLE RESOURCE LIMIT on the instance count
# of one compilation — a finite program can genuinely exceed it, so the
# limit reports a RESOURCE-LIMIT diagnostic (increase MAX_MONO_INSTANCES),
# never a claim of infinite generic expansion.
#
# Each call's callee instance is the SOLVED substitution the type checker
# recorded for the call node (typed_call_instances, threaded through the
# MirFnItem's InstanceId payload). The worklist specializes each discovered
# instance and then REWALKS the specialized bodies' calls, discovering the
# callee instances TRANSITIVELY — the exhaustive walk. The checker solves
# EVERY source-call shape (impl-registry methods, builtin-method generics,
# extension-impl methods, and return-type-only parameters via the caller's
# annotation context, resolved by resolve_pending_call_instances at the end
# of type checking).
#
# ZERO-INFERENCE INVARIANT (the monomorphizer entry): every generic call
# reaching this pass carries its solved instance. The instance payload is
# the ONLY authority for type arguments — there is no call-site inference
# over the program's call graph. Three shapes are handled without
# inference:
#   1. a call whose instance is already concrete enters under its
#      STRUCTURED instance key (the digest-word record; the emission text
#      is only the label the drain derives for the body);
#   2. a call whose SOLVED args still carry the caller's generic
#      parameters (a still-generic caller) DEFERS: the caller's own
#      specialization substitutes the payload (substitute_operand carries
#      the instance through), and the re-walk enqueues the now-concrete
#      instance — zero inference;
#   3. a call with NO instance payload (or an empty one) on a GENERIC base
#      FAILS CLOSED — an error is recorded; inference is never performed.
#
# RESULT INTERFACE: the errors collected by the queue (fail-closed gaps and
# residual-param violations) ABORT the compilation — monomorphize_program
# returns Result::Err(errors) and the caller (compiler_core's compile
# pipeline) propagates. On Ok, every discovered instance is specialized and
# ONE final rewrite pass points every generic call site at its mangled
# instance name.
pub def monomorphize_program(inout mir: MirProgram, inout cache: MonoCache) -> Result[Unit, Vec[String]]
 # the param-name table snapshot reaches the cache from the MIR
  # program (the MirBuilder serialized the checker's table at lowering) —
  # the residual-param and ABI diagnostics render names from it, and the
  # canonical binder bijection (canonical_param_aliases) reads it as the
  # declared-name correspondence witness.
  cache.generic_param_names = mir.generic_param_names.clone()
  # (canonical binder identity): the program's typed-field tables are
  # canonicalized ONCE at the mono boundary — every MirTypeDef's
  # field/variant types re-point their owner-side binder spellings at the
  # def's declared (canonical) ids, so the declared-field substitution
  # (the verifier's aggregate check, the layout/deinit consumers)
  # instantiates the iterator-adapter and container field tables to
  # concrete field types.
  canonicalize_type_def_binders(mir, cache.generic_param_names.clone())
  var pending: VecDeque[(String, InstanceId)] = VecDeque::new()
  var seen: Set[StructuralInstanceId] = Set::new()
  var errors: Vec[String] = Vec::new()
  var specialized_count = 0

  # Phase 1 (seed): collect generic call sites. A work queue entry carries
  # (callee emission name, instance): the NAME is the call site's emission
  # identity — the key the generic definition is registered under in
  # mir.functions (top-level functions: the fn_owner_key_of_def rendering,
  # which IS the instance's base name; methods: the pre-mangled
  # "Type__method" name, per the exemption); the INSTANCE is the
  # SOLVED (def, args) payload — a call whose MirFnItem constant carries
  # a solved, fully concrete instance enters under the INSTANCE's
  # STRUCTURED key (the seen-set is Set[StructuralInstanceId]).
 # (final): the recorded instances cover every shape the checker
  # solves — the impl-registry generic methods, the builtin-method
  # generics (Option::map / Result::and_then /...), the extension-impl
  # methods (`impl[T, I: Iterator[T]] I`), and the return-type-only
  # parameters solved by the caller's annotation context
  # (resolve_pending_call_instances). ZERO-INFERENCE (fail-closed): a call
  # with a generic base and NO usable instance payload records an error
  # instead of inferring — every generic call reaching the monomorphizer
  # carries its solved instance; inference is not performed on the
  # program's call graph.
  for func in mir.functions do
    scan_call_sites_in_function(func, mir, cache, &mut pending, &mut seen, &mut errors)
  end

  # Phase 2: drain the queue. Each pop specializes ONE instance (cache
  # identity: the instance's STRUCTURED key; the emission text is only the
  # label the same pop derives for the specialized body and the rewrite
  # pass). The seen-set is checked at ENQUEUE time, so an instance is
  # popped at most once; the specialized body's own call sites are
  # re-walked immediately, discovering callee instances transitively
  # (deferred instances become concrete under the caller's substitution
  # and enter the queue here).
  mono_drain_worklist(mir, cache, &mut pending, &mut seen, &mut errors, &mut specialized_count)

 # Phase 2b: inject the map/set Hash/Eq dispatch calls. After the
  # first wave every call site's key type is CONCRETE (including formerly
  # Param keys in specialized generic bodies), so the concrete impl base
  # names resolve here. The injected calls reference the impl TEMPLATES,
  # so the worklist re-seeds and drains before the rewrite.
  inject_map_dispatch_calls(mir)
  for func in mir.functions do
    scan_call_sites_in_function(func, mir, cache, &mut pending, &mut seen, &mut errors)
  end
  mono_drain_worklist(mir, cache, &mut pending, &mut seen, &mut errors, &mut specialized_count)

  # Phase 2c: devirtualize the trait-contract calls (the seed's bodyless
  # re-dispatch). A call on a generic-bound receiver keeps the contract's
  # bare surface name (`advance`) until the receiver's type is concrete;
  # the wave selects the concrete impl's method template by the
  # substituted receiver type, rewrites the callee operand to that
  # template's emission name + solved instance, and re-drains so the
  # selected instance is specialized. The wave is re-run until it is a
  # fixpoint: a specialized body can expose newly-concrete receivers
  # (the deferral rule) whose own call sites need the next round.
  var devirt_changed = true
  var devirt_rounds = 0
  while devirt_changed do
    devirt_rounds = devirt_rounds + 1
    if devirt_rounds > MAX_MONO_DEVIRT_ROUNDS then
      let msg = "monomorphization: trait-contract devirtualization did not reach a fixpoint after " + MAX_MONO_DEVIRT_ROUNDS.to_string() + " rounds (every round rewrote at least one call site — a non-terminating receiver chain)"
      if !errors.contains(&msg) then
        errors.push(msg)
      end
      return Result::Err(errors)
    end
    devirt_changed = devirtualize_contract_calls(mir, &mut errors, cache.generic_param_names.clone())
    if devirt_changed then
      for func in mir.functions do
        scan_call_sites_in_function(func, mir, cache, &mut pending, &mut seen, &mut errors)
      end
      mono_drain_worklist(mir, cache, &mut pending, &mut seen, &mut errors, &mut specialized_count)
    end
  end

  # Any zero-inference violation or residual-param error recorded during
  # monomorphization aborts the compilation.
  if !errors.is_empty() then
    return Result::Err(errors)
  end

  # Phase 3: rewrite existing call sites to use mangled names. Every
  # discovered instance is specialized by now, so ONE pass covers every
  # generic call site.
  rewrite_call_sites_in_program(mir, cache)
  # (audit order item 1 closeout) FAIL CLOSED at the monomorphization
  # boundary: every specialized body must carry the persistent origin of
  # the node it was instantiated from. A program lowered by lower_to_mir
  # has origins_enforced set; any surviving origin-less node aborts with
  # the precise stage context (hand-built MIR without the flag is
  # untouched — its persistent consumers report it untracked).
  if mir.origins_enforced then
    match mir_origins_check(&mir, "monomorphization".to_string())
    when Result::Ok(()) then ()
    when Result::Err(e) then
      if !errors.contains(&e) then
        errors.push(e)
      end
      return Result::Err(errors)
    end
  end
  Result::Ok(())
end

# The Phase-2 work-queue drain loop (shared by the two waves).
def mono_drain_worklist(
  inout mir: MirProgram,
  inout cache: MonoCache,
  inout pending: VecDeque[(String, InstanceId)],
  inout seen: Set[StructuralInstanceId],
  inout errors: Vec[String],
  inout specialized_count: Int
) -> Unit
  while !pending.is_empty() do
    match pending.pop_front()
    when Option::Some((callee_name, inst)) then
      # (audit item 49 migration; fourth-audit P0-6): the pop computes the
      # STRUCTURAL instance once — the MonoCache.instances / worklist
      # identity — and DERIVES the emission text from it (the specialized
      # body's `name` and the rewrite pass's label). The text is never a
      # map key.
      let key_struct = structured_instance_key(cache, &inst)
      let key = structural_instance_mangle_text(key_struct.clone())
      # Cache hit (specialized by an earlier pop or by the external APIs):
      # nothing to do — the body is already in the program.
      if !cache.instances.contains_key(&key_struct) then
        var found: Option[MirFunction] = Option::None
        for f in mir.functions do
          if f.name == callee_name then
            found = Option::Some(f)
            break
          end
        end
        match found
        when Option::Some(original) then
          let type_param_names = function_generic_param_names(original)
          if type_param_names.is_empty() then
 # FAIL-CLOSED: a generic template whose declaration-
            # order generic parameter ids were not recorded at lowering is
            # MALFORMED MIR — the former signature-derived fallback
            # (infer_type_param_names) is never used; the ids are
            # the declared-binder-order contract (MirFunction.generic_params is
            # populated at lowering in mir.tg).
            let msg = "generic template `" + callee_name + "` reached the monomorphizer without declaration-order generic parameter ids (malformed MIR — MirFunction.generic_params must be populated at lowering)"
            if !errors.contains(&msg) then
              errors.push(msg)
            end
          else
            match specialize_function_keyed(cache, original, &type_param_names, &inst.args, key.clone(), key_struct.clone())
            when Result::Ok(()) then
              # The specialized body is cached now; append it to the
              # program and re-walk its calls (the transitive discovery).
              match cache.instances.get(&key_struct)
              when Option::Some(body) then
                mir.functions.push(body.clone())
                scan_call_sites_in_function(body, mir, cache, pending, seen, errors)
              when Option::None then ()
              end
            when Result::Err(msg) then
              # FAIL-CLOSED: the residual violation aborts the compilation
              # (the body was not cached; the call site is never rewritten
              # to a poisoned name).
              if !errors.contains(&msg) then
                errors.push(msg)
              end
            end
          end
        when Option::None then ()
        end
      end
    when Option::None then ()
    end
    specialized_count = specialized_count + 1
    if specialized_count > MAX_MONO_INSTANCES then
 # RESOURCE LIMIT: the bound is a configurable resource
      # limit, never proof of infinite recursion — a finite program can
      # genuinely instantiate more than MAX_MONO_INSTANCES functions.
      let msg = "monomorphization instance limit reached: " + MAX_MONO_INSTANCES.to_string() + " — increase MAX_MONO_INSTANCES"
      if !errors.contains(&msg) then
        errors.push(msg)
      end
      return
    end
  end
end

# Scan one function's call sites and enqueue every generic callee that
# carries a SOLVED, fully-concrete instance (the work-queue seed and the
# transitive re-walk share this single enqueue path — zero inference).
def scan_call_sites_in_function(
  func: MirFunction,
  mir: MirProgram,
  cache: MonoCache,
  inout pending: VecDeque[(String, InstanceId)],
  inout seen: Set[StructuralInstanceId],
  inout errors: Vec[String]
) -> Unit
  for block in func.blocks do
    match block.terminator.kind
    when MirTerminatorKind::MirCall(dest, callee, args, _, _, _, _) then
      enqueue_call_instance(callee, mir, cache, pending, seen, errors)
    when _ then ()
    end
  end
end

# Enqueue ONE call-site callee: when the MirFnItem constant carries a
# SOLVED instance whose args are fully concrete, the instance enters the
# queue under its STRUCTURED key (deduplicated by the seen-set, itself
# Set[StructuralInstanceId] — the worklist identity is never the render text). A
# payload whose args still carry Params (a still-generic caller) DEFERS —
# the caller's specialization substitutes it and the re-walk enqueues the
# concrete instance. A payload that is absent or empty on a generic base is
# a compiler-internal gap: the error is recorded (fail-closed — inference
# is never performed).
def enqueue_call_instance(
  callee: MirOperand,
  mir: MirProgram,
  cache: MonoCache,
  inout pending: VecDeque[(String, InstanceId)],
  inout seen: Set[StructuralInstanceId],
  inout errors: Vec[String]
) -> Unit
  match callee.kind
  when MirOperandKind::MirConstant(cv) then
    match cv.kind
    when MirConstantKind::MirFnItem(callee_name) then
      # Look up the callee in the program — is it generic?
      var is_generic = false
      for candidate in mir.functions do
        if candidate.name == callee_name then
          is_generic = is_generic_function(candidate)
          break
        end
      end
      if is_generic then
        match cv.instance.clone()
        when Option::Some(inst) then
          if !inst.args.is_empty() then
 # (final): a SOLVED INSTANCE is the AUTHORITY. Only a
            # fully-concrete payload (no Params) is enqueueable — the
            # emission label comes from instance_key, the queue/dedup
            # identity from structured_instance_key. A payload still
            # carrying the caller's generic parameters DEFERS (the
            # caller's specialization substitutes it; the re-walk
            # enqueues the concrete instance later) — zero inference.
            if !has_any_param_args(&inst.args) then
              let key = structured_instance_key(cache, &inst)
              if !seen.contains(&key) then
                seen.insert(key)
                pending.push_back((callee_name.clone(), inst))
              end
            end
          else
            # ZERO-INFERENCE (fail-closed): no inference is ever performed
            # here. An EMPTY payload on a generic base is a
            # compiler-internal gap: record the error.
            let msg = "generic call to `" + callee_name + "` reached the monomorphizer without a solved instance — every generic call carries its solved instance; inference is not performed on the program's call graph"
            if !errors.contains(&msg) then
              errors.push(msg)
            end
          end
        when Option::None then
          # ZERO-INFERENCE (fail-closed): an ABSENT payload on a generic
          # base is a compiler-internal gap: record the error.
          let msg = "generic call to `" + callee_name + "` reached the monomorphizer without a solved instance — every generic call carries its solved instance; inference is not performed on the program's call graph"
          if !errors.contains(&msg) then
            errors.push(msg)
          end
        end
      end
    when _ then ()
    end
  when _ then ()
  end
end

def report_mono_errors(cache: MonoCache) -> Unit
  if cache.errors.is_empty() then
    return
  end
  for err in cache.errors do
    eprintln("[mono] error: " + err)
  end
end

# ———————————————————————————————————————————————————————————————
# Public API: mono_specialize_function
# ———————————————————————————————————————————————————————————————
# Specialize a single generic function with concrete type arguments
# and add the result to the MIR program.  Returns the mangled name
# on success, or None if the function was not found / the specialization
# failed the residual verification.
pub def mono_specialize_function(
  inout cache: MonoCache,
  inout mir: MirProgram,
  func_name: String,
  type_args: Vec[Type]
) -> Option[String]
  # the param-name table snapshot (the canonical binder bijection's
  # declared-name correspondence witness) reaches the cache from the MIR
  # program — the same seed monomorphize_program performs at its entry.
  cache.generic_param_names = mir.generic_param_names.clone()
  # Find the generic function
  var found: Option[MirFunction] = Option::None
  for f in mir.functions do
    if f.name == func_name then
      found = Option::Some(f)
      break
    end
  end

  match found
  when Option::None then
    return Option::None
  when Option::Some(original) then
    # If not generic, return the name as-is
    if !is_generic_function(original) then
      return Option::Some(func_name)
    end

    let type_param_names = function_generic_param_names(original)
    if type_param_names.is_empty() then
      return Option::Some(func_name)
    end

    # Specialize — specialize_function_keyed caches internally. The
    # STRUCTURAL cache identity is computed ONCE from the template's
    # emission-name text + the concrete args (fourth-audit P0-6: there is
    # no InstanceId on this name-API path, so the callable text is the
    # generated-origin emission base), and the emission label is DERIVED
    # from it (never the reverse). The explicit args are wrapped into the
    # typed union via the constructor-inspecting view adapter.
    let typed_args = generic_args_of_types(type_args.clone())
    let key = structured_key_of_text_and_args(func_name.clone(), &type_args)
    let mangled = structural_instance_mangle_text(key.clone())
    if !cache.instances.contains_key(&key) then
      match specialize_function_keyed(cache, original, &type_param_names, &typed_args, mangled.clone(), key.clone())
      when Result::Ok(()) then
        match cache.instances.get(&key)
        when Option::Some(specialized) then
          mir.functions.push(specialized.clone())

          # Rewrite call sites in the entire program to catch any calls
          # that should now point to the mangled name
          rewrite_call_sites_in_program(mir, cache)
        when Option::None then ()
        end
      when Result::Err(msg) then
        # FAIL-CLOSED: a residual violation means no body was cached; the
        # specialization fails (None) and the error is reported.
        if !cache.errors.contains(&msg) then
          cache.errors.push(msg)
        end
        report_mono_errors(cache)
        return Option::None
      end
    end

    # Report any zero-inference violations recorded during specialization.
    report_mono_errors(cache)

    Option::Some(mangled)
  end
end

# Public API: monomorphize_instance — the specialize path keyed by a
# semantic InstanceId instead of a name string. A caller that holds the
# call site's (def, args) requests the instance directly; the body is
# produced through the SAME specialize_function_keyed path as the worklist
# monomorphizer, so cache identity and mangling stay single-sourced.
#
# NOTE (layer): the MIR call lowering records the DefId with EMPTY
# arguments when the checker recorded no solved substitution — under the
# ZERO-INFERENCE invariant such a call is a compiler-internal gap (the
# worklist monomorphizer records an error for it, and the type checker
# reports the genuinely unconstrained shape at end of checking); an
# instance requested directly in this layer must therefore already carry
# concrete arguments, and empty args are rejected here.
# (final): the base-name lookup below is the DefId rendering
# (fn_owner_key_of_def over the cache's program/resolutions snapshot) —
# and MirFunction names ARE that same rendering for top-level functions
# (mir.tg's lower_program records mir_fn_emission_name from item_defs via
# the same fn_owner_key_of_def render), so the seam is closed: the
# instance's base name and the lowered function's emission name agree
# byte-for-byte, and the `f.name == base` search below finds the
# definition. Methods stay name-based (the "Type__method" mangled
# identities), and the OS-entry function keeps its source name (the
# linking boundary).
pub def monomorphize_instance(
  inout cache: MonoCache,
  inout mir: MirProgram,
  instance: InstanceId
) -> Result[Unit, String]
  # the param-name table snapshot (the canonical binder bijection's
  # declared-name correspondence witness) reaches the cache from the MIR
  # program — the same seed monomorphize_program performs at its entry.
  cache.generic_param_names = mir.generic_param_names.clone()
  let base = fn_owner_key_of_def(&cache.program, &cache.resolutions, &instance.def.def)
  if instance.args.is_empty() then
    return Result::Err("instance " + base + " has empty generic arguments — every generic call carries its solved instance; inference is not performed on the program's call graph")
  end
  # (audit item 49 migration; fourth-audit P0-6): the STRUCTURAL key of
  # the requested instance — computed once per request from the
  # InstanceId, it IS the MonoCache.instances identity; the emission label
  # is DERIVED from the record (the callable's registration-scope stable
  # declaration + the ordered args), never fed back into it.
  let key = structured_instance_key(cache, &instance)
  let mangled = structural_instance_mangle_text(key.clone())
  if cache.instances.contains_key(&key) then
    return Result::Ok(())
  end
  var found: Option[MirFunction] = Option::None
  for f in mir.functions do
    if f.name == base then
      found = Option::Some(f)
      break
    end
  end
  match found
  when Option::Some(original) then
    let type_param_names = function_generic_param_names(original)
    if type_param_names.is_empty() then
      return Result::Ok(())
    end
    match specialize_function_keyed(cache, original, &type_param_names, &instance.args, mangled.clone(), key.clone())
    when Result::Ok(()) then
      match cache.instances.get(&key)
      when Option::Some(specialized) then
        mir.functions.push(specialized.clone())
      when Option::None then ()
      end
      rewrite_call_sites_in_program(mir, cache)
      Result::Ok(())
    when Result::Err(msg) then
      Result::Err(msg)
    end
  when Option::None then
    Result::Err("instance base `" + base + "` not found in the MIR program")
  end
end

# ———————————————————————————————————————————————————————————————
# Generic-Parameter Ids
# ———————————————————————————————————————————————————————————————
# The AUTHORITATIVE declaration-order generic parameter ids of a function.
# MirFunction.generic_params (mir.tg) is the typed-metadata population
# point — the checker's interning, written by the MIR builder at lowering
# (lower_function's write site). This accessor is the monomorphizer's ONLY
# source for the declaration-order ids: a generic template whose list is
# empty is MALFORMED MIR (the former signature-derived fallback —
# infer_type_param_names — is not part of the model; the declaration-order ids ARE the
# declared-binder-order contract the InstanceId.args Vec aligns with).
def function_generic_param_names(func: MirFunction) -> Vec[GenericParamId]
  func.generic_params.clone()
end

# Generate mangled name for a monomorphized function. The type arguments
# are joined with "$" — a character that appears in NO type rendering
# (the CanonInternal frame of type_canon_render emits only alphanumerics
# and the bracket/delimiter characters), so the arg
# list is unambiguous: two distinct subst vectors never render to the same
# suffix. (The "_"-joined form was ambiguous: `f[Adt(1, []), Int]` and
# `f[Adt(1, [Int])]` both rendered "base$t1_int", collapsing two distinct
# instances into one mangled identity — the instance-key collision bug.
# (the consolidation): the suffix renderings come from the ONE canonical
# type encoding (type_canon_render, CanonInternal frame) — the emission
# labels never contain "$", so the "$"-joined arg list is unambiguous.
def mangle_name(base: String, type_args: Vec[Type]) -> String
  var name = base + "$"
  var first = true
  for ty in type_args do
    if !first then
      name = name + "$"
    end
    name = name + type_to_mangled(ty)
    first = false
  end
  name
end

# ———————————————————————————————————————————————————————————————
# Tangerine ABI Symbol Mangling (extern "tangerine")
# ———————————————————————————————————————————————————————————————
# Format: _TG{edition}_{revision}_{pkgHash}_{moduleLen}:{modulePath}_{nameLen}:{name}_{sigHash}_{substHash}
#
# The PUBLIC external symbol identity of an exported (pub) top-level
# function of a library compilation — NEVER the ephemeral DefId/TypeId
# indices ("Do not use ephemeral DefId indices as
# the public Tangerine ABI"). The components ARE the public identity:
#   edition    — language edition (TANGERINE_ABI_EDITION, e.g. "2026")
#   revision   — ABI revision (TANGERINE_ABI_REVISION; bump on any change
#                to the canonicalization below)
#   pkgHash    — 64-bit hex of the package identity (the PackageId: name +
#                version, FNV-1a)
#   modulePath — length-prefixed module path (e.g. "std::collections")
#   name       — length-prefixed PUBLIC SOURCE name of the function
#   sigHash    — 64-bit hex of the CANONICAL signature (ONE type
#                canonicalizer — type_canon_render's CanonExternal frame,
#                the consolidation: exhaustive over every Type variant:
#                parameter access conventions, the canonical ordered
#                effect sets, fixed-array lengths, tuple structure, ADT
#                stable paths)
#   substHash  — 64-bit hex of the canonical generic substitutions in the
#                DECLARED parameter order (the InstanceId.args Vec order —
#                the ABI mangling never iterates a Map); 0 for a
#                non-generic export
#
# INTERNAL-vs-EXTERNAL: the internal emission names —
# the fn_owner_key DefId renderings (instance_key / mangle_name) — remain
# the single-compilation labels (codegen's resolve_callee_label authority
# within one compilation); the TANGERINE_ABI mangling is the EXTERNAL
# identity ONLY. tangerine_exported_symbol_name is the boundary: exported
# (pub) functions of a library compilation get the ABI-mangled name; every
# other function keeps its internal emission name. The ABI canonicalizer
# is FAIL-CLOSED: a type that cannot be canonicalized
# (Param / Var / Error / Closure — a per-compilation identity — or an Adt
# with no stable path) fails the mangling with an error — there is NO
# "unknown"/"any" collapse in the ABI path.

pub const TANGERINE_ABI_EDITION: String = "2026"
pub const TANGERINE_ABI_REVISION: UInt = 2  #: the canonical effect-set ordering in the External frame (the consolidation)

# THE canonical type walk for the Tangerine ABI — the CanonExternal frame
# of the ONE canonical semantic type encoding (type_canon_render,
# types.tg — the consolidation: the frontend identity, the mono
# internal mangling and this ABI canonicalization are ONE walk,
# parameterized only by the EXTERNAL SYMBOL FRAMING). Exhaustive over
# every Type variant with a distinct, deterministic rendering:
#   primitives  — unit/bool/int/uint/float/char/str/never/i8..f64
#   Adt         — T[<module path>::<source name>][<args in order>] — the
#                 ADT STABLE PATH, resolved DIRECTLY through the
#                 TypeId -> DefId association (resolutions.type_def_ids —
#                 the checker's registration), never the ephemeral TypeId
#                 index and never a name/order correlation
#   FixedArray  — A[<elem>;<count>] — the fixed array LENGTH is part of the
#                 identity
#   Function/FnPtr — F[<convention>:<ty>,...|<ret>] — the PARAMETER ACCESS
#                 CONVENTIONS are part of the identity
#   Closure     — FAIL-CLOSED: a closure value carries the per-compilation
#                 ClosureId — it has NO stable public identity
#   RefInternal — R[mut|ref|<inner>]
#   Ptr/PtrMut  — P[<inner>] / Q[<inner>]
#   Dyn         — D[<stable trait path>]
#   Effect      — E[{<effects>,...}|<inner>] — the effect set is
#                 ABI-relevant, rendered in the canonical ordered form
#   Tuple       — (<elems in order>)
#   Param/Var/Error — FAIL-CLOSED: they must NOT appear in a public ABI
#                 symbol (an instance with unresolved parameters/inference
#                 variables is not codegen-ready); the mangling errors
#                 instead of collapsing to a placeholder.
# The canonical string is the input to the signature hash, so the symbol
# is self-consistent per (edition, revision) and deterministic across
# compilations: module paths and source names come from the crate module
# table and the semantic type table, never from per-compilation counters.
def tangerine_abi_canon_type(stable_paths: Map[Int, String], param_names: Map[Int, String], ty: Type) -> Result[String, String]
  let ctx = TypeCanonCtx {
    frame: TypeCanonFrame::CanonExternal,
    type_names: stable_paths.clone(),
    param_names: param_names.clone(),
    lang_option: -1,
    lang_result: -1,
    lang_map: -1,
    lang_set: -1,
    lang_slice: -1,
    lang_array: -1,
    lang_box: -1,
    lang_rc: -1,
    effects: effect_registry_new()
  }
  type_canon_render(&ctx, ty)
end

# The stable path of an Adt/Dyn: "<module path>::<source name>" — derived
# DIRECTLY from the type-to-declaration association (): the checker's
# registration recorded every nominal TypeId's defining DefId
# (resolutions.type_def_ids — the TypeId -> DefId table filled at
# store_type_def); the stable path IS the DefId's module_symbols
# registration key ("path::name" -> DefId — the type's registered module,
# recovered by scanning the snapshot for the DefId). NO name/order
# correlation: two same-named declarations in different modules
# (a::Point, b::Point) are two registrations and yield two DISTINCT
# module-qualified paths through their own DefIds; a TypeId the checker
# never registered (a builtin, a compiler-synthesized id) records no
# path — the canonicalizer then fails closed with an error instead of
# guessing — the ABI never falls back to the ephemeral TypeId index.
pub def tangerine_abi_stable_paths(cache: MonoCache, type_names: Map[Int, String]) -> Map[Int, String]
  var paths = Map::new()
  # The DIRECT join: every TypeId with a registered DefId resolves its
  # stable path through the DefId's module_symbols key. The DefId scan is
  # per-type over the qualified registrations; the association itself is
  # the checker's registration (type_def_ids), never a name/order pairing.
  for (tid, _) in type_names.entries() do
    match cache.resolutions.type_def_ids.get(tid)
    when Option::Some(did) then
      var found_key = ""
      for (ms_key, ms_did) in cache.resolutions.module_symbols.entries() do
        if ms_did.module.id == did.module.id && ms_did.index == did.index then
          found_key = ms_key.clone()
          break
        end
      end
      if !found_key.is_empty() then
        paths.insert(tid, found_key)
      end
    when Option::None then ()
    end
  end
  paths
end

def source_item_name(item: Item) -> String
  match item.kind
  when ItemKind::ItemStruct(s) then s.name.clone()
  when ItemKind::ItemEnum(e) then e.name.clone()
  when ItemKind::ItemTrait(t) then t.name.clone()
  when ItemKind::ItemTypeAlias(a) then a.name.clone()
  when _ then "".to_string()
  end  end
end

# The module path containing an item index, from the item's stamped OWNER
# ModuleId — the O(1) shared table read (types.tg's crate_module_path_of —
# the Crate.modules[ModuleId] authority, never a containment scan).
def item_module_path(cache: MonoCache, item_idx: Int) -> String
 # the item's OWNER ModuleId is stamped at assembly — the module table
  # read replaces the [start, end) item-range containment scan. STRICT
  # (the compile path): a missing module is an internal error, never the
  # empty-path fallback.
  if item_idx < cache.program.items.len() then
    let owner = cache.program.items[item_idx].owner_module
    return crate_module_path_of(&cache.program, &owner).join("::")
  end
  "".to_string()
end

# The canonical generic-substitution suffix of an ABI symbol — the DECLARED
# PARAMETER ORDER (/ deterministic ordering): the
# InstanceId.args Vec is populated in declared binder order, so the suffix
# iterates the Vec BY INDEX; a Map is never iterated (map iteration order
# is not canonical). The parts are joined with "$" — a character that
# appears in NO canonical type rendering (tangerine_abi_canon_type emits
# only letters, digits and [ ] (), ;: | _), so the joined suffix is
# unambiguous: two distinct substitution vectors never produce the same
# suffix and therefore never share a substHash. (The former "_" join was
# ambiguous — a module path or type name containing "_" made e.g.
# [foo_bar::T] and [foo, bar::T] render identically — the ABI collision
# bug.)
def tangerine_abi_substs_suffix(stable_paths: Map[Int, String], param_names: Map[Int, String], substs: Vec[Type]) -> Result[String, String]
  var parts = Vec::new()
  var i = 0
  while i < substs.len() do
    match tangerine_abi_canon_type(stable_paths, param_names, &substs[i])
    when Result::Ok(c) then parts.push(c)
    when Result::Err(msg) then return Result::Err(msg)
    end
    i = i + 1
  end
  Result::Ok(parts.join("$"))
end

# Full Tangerine ABI symbol mangling. FAIL-CLOSED: the canonical signature
# hash and the ordered substitution hash are computed through the ONE
# canonicalizer; a non-canonicalizable signature (or substitution) returns
# Result::Err instead of collapsing to "unknown".
pub def mangle_tangerine_symbol(
  pkg_name: String,
  pkg_version: String,
  module_path: String,
  name: String,
  signature: Type,
  stable_paths: Map[Int, String],
  param_names: Map[Int, String],
  substs: Vec[Type]
) -> Result[String, String]
  let pkg_hash = compute_pkg_hash(&pkg_name, &pkg_version)
  let module_len = module_path.len()
  let name_len = name.len()
  match compute_signature_hash(stable_paths, param_names, signature)
  when Result::Ok(sig_hash) then
    match compute_substs_hash(stable_paths, param_names, substs)
    when Result::Ok(subst_hash) then
      Result::Ok(
        "_TG" + TANGERINE_ABI_EDITION + "_" +
          TANGERINE_ABI_REVISION.to_string() + "_" +
          hex_u64(pkg_hash) + "_" +
          module_len.to_string() + ":" + module_path + "_" +
          name_len.to_string() + ":" + name + "_" +
          hex_u64(sig_hash) + "_" +
          hex_u64(subst_hash)
      )
    when Result::Err(msg) then Result::Err(msg)
    end
  when Result::Err(msg) then Result::Err(msg)
  end
end

# Best-effort demangler for symbols emitted by mangle_tangerine_symbol.
# The fields are length-prefixed, so the parse is length-driven (a module
# path or name containing "_" or ":" cannot confuse it).
# Returns a readable summary: module_path::name [edition=..., abi_revision=..., pkg=..., sig=..., substs=...]
pub def demangle_tangerine_symbol(symbol: String) -> Option[String]
  if !symbol.starts_with("_TG") then
    return Option::None
  end
  let rest = symbol.slice(3, symbol.len())
  match rest.split_once("_")
  when Option::Some((edition, after_edition)) then
    match after_edition.split_once("_")
    when Option::Some((revision, after_revision)) then
      match after_revision.split_once("_")
      when Option::Some((pkg_hash, after_pkg)) then
        match after_pkg.split_once(":")
        when Option::Some((mlen_s, after_mlen)) then
          match mlen_s.parse_int()
          when Result::Ok(mlen) then
            if mlen < 0 || mlen > after_mlen.len() then return Option::None end
            let module_path = after_mlen.slice(0, mlen)
            if mlen >= after_mlen.len() || after_mlen.slice(mlen, mlen + 1) != "_" then return Option::None end
            let after_module = after_mlen.slice(mlen + 1, after_mlen.len())
            match after_module.split_once(":")
            when Option::Some((nlen_s, after_nlen)) then
              match nlen_s.parse_int()
              when Result::Ok(nlen) then
                if nlen < 0 || nlen > after_nlen.len() then return Option::None end
                let name = after_nlen.slice(0, nlen)
                if nlen >= after_nlen.len() || after_nlen.slice(nlen, nlen + 1) != "_" then return Option::None end
                let after_name = after_nlen.slice(nlen + 1, after_nlen.len())
                match after_name.split_once("_")
                when Option::Some((sig_hash, subst_hash)) then
                  Option::Some(module_path + "::" + name + " [edition=" + edition + ", abi_revision=" + revision + ", pkg=" + pkg_hash + ", sig=" + sig_hash + ", substs=" + subst_hash + "]")
                when Option::None then Option::None
                end
              when Result::Err(_) then Option::None
              end
            when Option::None then Option::None
            end
          when Result::Err(_) then Option::None
          end
        when Option::None then Option::None
        end
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

# Compute package identity hash (name + version — the PackageId identity
# of pkg_manager.tg; FNV-1a).
def compute_pkg_hash(name: String, version: String) -> UInt
  var h: UInt = 0xcbf29ce484222325  # FNV-1a offset basis
  let name_bytes: Vec[u8] = name.bytes()
  for c in name_bytes do
    h = h ^ (c as UInt)
    h = h * 0x100000001b3  # FNV-1a prime
  end
  h = h ^ 0xff  # separator
  let version_bytes: Vec[u8] = version.bytes()
  for c in version_bytes do
    h = h ^ (c as UInt)
    h = h * 0x100000001b3
  end
  h
end

# Compute the canonical signature hash through THE one ABI canonicalizer.
# FAIL-CLOSED: a non-canonicalizable type returns Result::Err (the ABI
# path never falls back to an "unknown" rendering).
def compute_signature_hash(stable_paths: Map[Int, String], param_names: Map[Int, String], ty: Type) -> Result[UInt, String]
  match tangerine_abi_canon_type(stable_paths, param_names, ty)
  when Result::Ok(repr) then
    var h: UInt = 0xcbf29ce484222325
    let repr_bytes: Vec[u8] = repr.bytes()
    for c in repr_bytes do
      h = h ^ (c as UInt)
      h = h * 0x100000001b3
    end
    Result::Ok(h)
  when Result::Err(msg) then Result::Err(msg)
  end  end
end

# Compute the ordered generic-substitution hash (declared parameter order;
# 0 for a non-generic export). The canonical suffix iterates the substs Vec
# by index — never a Map.
def compute_substs_hash(stable_paths: Map[Int, String], param_names: Map[Int, String], substs: Vec[Type]) -> Result[UInt, String]
  match tangerine_abi_substs_suffix(stable_paths, param_names, substs)
  when Result::Ok(suffix) then
    if suffix.is_empty() then
      Result::Ok(0 as UInt)
    else
      var h: UInt = 0xcbf29ce484222325
      let suffix_bytes: Vec[u8] = suffix.bytes()
      for c in suffix_bytes do
        h = h ^ (c as UInt)
        h = h * 0x100000001b3
      end
      Result::Ok(h)
    end
  when Result::Err(msg) then Result::Err(msg)
  end  end
end

# Convert u64 to 16-char hex string
def hex_u64(val: UInt) -> String
  let chars = "0123456789abcdef"
  var result = ""
  var v = val
  var i = 0
  while i < 16 do
    let nibble = (v >> 60) & 0xf
    result = result + chars.char_at(nibble as Int).to_string()
    v = v << 4
    i = i + 1
  end
  result
end

# ———————————————————————————————————————————————————————————————
# The Internal-vs-External Identity Boundary 
# ———————————————————————————————————————————————————————————————
# The INTERNAL emission names (instance_key / mangle_name — the
# fn_owner_key DefId renderings) stay the single-compilation labels:
# codegen's resolve_callee_label authority inside ONE compilation. The
# PUBLIC external symbols — the exported (pub) functions of a library
# compilation — are the TANGERINE_ABI-mangled names produced here:
# (package identity, module path, public source name, canonical signature,
# edition/ABI revision, generic substitutions).
#
# The export marking is Item.is_pub: the item scan over the merged program
# (Program.items + ResolvedNames.item_defs, the DefId -> item index
# authority) decides. Only top-level PUB functions export; the OS entry
# ("main"/"_start"), methods, statics, constants and non-pub functions
# keep their internal emission names.

# Whether a DefId names an EXPORTED (pub) top-level function of the
# compilation. The item scan is the authority: the DefId must belong to an
# ItemFunction item (never a method/static/constant DefId, which live on
# other item kinds) and that item must be pub. Deterministic (item order).
def is_exported_function_def(cache: MonoCache, did: DefId) -> Bool
  var idx = 0
  for item in cache.program.items do
    match item.kind
    when ItemKind::ItemFunction(_) then
      match cache.resolutions.item_defs.get(idx)
      when Option::Some(dids) then
        for d in dids do
          if d.module.id == did.module.id && d.index == did.index then
            return item.is_pub
          end
        end
      when Option::None then ()
      end
    when _ then ()
    end
    idx = idx + 1
  end
  false
end

# The PUBLIC external symbol name of a top-level function DefId:
#   Option::Some(abi_name) — the TANGERINE_ABI-mangled name, when the
#     function is an exported (pub) function of a library compilation;
#   Option::None          — the function keeps its internal emission name
#     (non-pub, entry, or a method/static/constant DefId).
# The caller supplies the function's canonical signature (for a generic
# function, the SPECIALIZED post-substitution signature — a Param in the
# signature fails the mangling, as it must) and the instance's generic
# arguments (the typed InstanceId.args in declared parameter order; empty
# for a non-generic function). The ABI substitution hash consumes the
# TYPE VIEW of each argument (the public ABI canonicalizer is type-only;
# a symbolic const form fails the mangling exactly as before).
def generic_arg_type_views(args: Vec[GenericArg]) -> Vec[Type]
  var out: Vec[Type] = Vec::new()
  for a in args do
    out.push(generic_arg_type_view(a))
  end
  out
end

pub def tangerine_exported_symbol_name(
  cache: MonoCache,
  type_names: Map[Int, String],
  pkg_name: String,
  pkg_version: String,
  did: DefId,
  source_name: String,
  signature: Type,
  instance: InstanceId
) -> Result[Option[String], String]
  # Linking boundary: the OS entry keeps its source name.
  if source_name == "main" || source_name == "_start" then
    return Result::Ok(Option::None)
  end
  # The export marking: a top-level PUB function of the compilation. Not
  # exported -> the internal emission name stays.
  if !is_exported_function_def(cache, did) then
    return Result::Ok(Option::None)
  end
  let stable_paths = tangerine_abi_stable_paths(cache, type_names)
  let module_path = crate_module_path_of(&cache.program, &did.module).join("::")
  match mangle_tangerine_symbol(pkg_name, pkg_version, module_path, source_name.clone(), signature, &stable_paths, &cache.generic_param_names, generic_arg_type_views(instance.args))
  when Result::Ok(sym) then Result::Ok(Option::Some(sym))
  when Result::Err(msg) then Result::Err(msg)
  end
end

# The canonical function type of a MIR function for ABI mangling. The MIR
# parameter list carries the INOUT access convention structurally
# (Type::RefInternal(inner, true) — mir.tg's lower_function convention
# lowering); the convention is RECOVERED, never invented: RefInternal(true)
# -> Inout, everything else -> Let. The typed-signature path
# (tangerine_exported_symbol_name's signature argument) carries the full
# ParamType conventions; this recovery covers the MIR-derived path.
def mir_fn_abi_signature(fn: MirFunction) -> Type
  var params = Vec::new()
  for p in fn.params do
    match p.ty
    when Type::RefInternal(inner, mutable) then
      if mutable then
        params.push(ParamType { ty: inner.clone(), convention: AccessConvention::Inout })
      else
        params.push(ParamType { ty: p.ty.clone(), convention: AccessConvention::Let })
      end
    when _ then
      params.push(ParamType { ty: p.ty.clone(), convention: AccessConvention::Let })
    end
  end
  Type::FnPtr(params, fn.ret_type.clone(), fn.declared_effects.clone())
end

# The library-compilation export table: (internal emission name, public
# TANGERINE_ABI symbol) for every exported (pub) non-generic top-level
# function, in program declaration order (deterministic — iterated by item
# index, never by map order). A GENERIC base has no single ABI symbol:
# each concrete instance is exported via tangerine_exported_symbol_name
# with the instance's solved args (declared binder order), which is
# the substHash component of the ABI name.
pub def tangerine_export_symbol_table(
  cache: MonoCache,
  type_names: Map[Int, String],
  pkg_name: String,
  pkg_version: String,
  mir: MirProgram
) -> Result[Vec[(String, String)], String]
  let stable_paths = tangerine_abi_stable_paths(cache, type_names)
  var out = Vec::new()
  var idx = 0
  for item in cache.program.items do
    match item.kind
    when ItemKind::ItemFunction(f) then
      if item.is_pub && f.name != "main" && f.name != "_start" then
        match cache.resolutions.item_defs.get(idx)
        when Option::Some(dids) then
          if dids.len() > 0 then
            let did = dids[0]
            let internal = fn_owner_key_of_def(&cache.program, &cache.resolutions, &did)
            let module_path = crate_module_path_of(&cache.program, &did.module).join("::")
            for mir_fn in mir.functions do
              if mir_fn.name == internal then
                if !is_generic_function(mir_fn) then
                  let sig = mir_fn_abi_signature(mir_fn)
                  var empty_substs: Vec[Type] = Vec::new()
                  match mangle_tangerine_symbol(pkg_name.clone(), pkg_version.clone(), module_path.clone(), f.name.clone(), &sig, &stable_paths, &cache.generic_param_names, &empty_substs)
                  when Result::Ok(sym) then out.push((internal.clone(), sym))
                  when Result::Err(msg) then return Result::Err(msg)
                  end
                end
              end
            end
          end
        when Option::None then ()
        end
      end
    when _ then ()
    end
    idx = idx + 1
  end
  Result::Ok(out)
end

# INTERNAL-LABEL type rendering — the per-compilation emission names ONLY
# (the "$<args>" suffix of instance_key / mangle_name): the CanonInternal
# frame of the ONE canonical semantic type encoding (type_canon_render,
# types.tg — the consolidation; the framing difference from the public
# ABI is EXACTLY the nominal identity source — the ephemeral TypeId index
# is legal HERE because internal labels never cross a compilation boundary
# — and the unresolved-type policy — Param/Var/Error render distinctly,
# never fail). The renderings are UNAMBIGUOUS under concatenation: every
# composite variant is bracket-delimited, so a parse of a concatenated
# label splits uniquely at the matching bracket — two distinct types never
# render to the same string, and the "$"-joined arg list of mangle_name
# cannot be confused with any rendering (renderings contain no "$").
pub def type_to_mangled(ty: Type) -> String
  let ctx = TypeCanonCtx {
    frame: TypeCanonFrame::CanonInternal,
    type_names: Map::new(),
    param_names: Map::new(),
    lang_option: -1,
    lang_result: -1,
    lang_map: -1,
    lang_set: -1,
    lang_slice: -1,
    lang_array: -1,
    lang_box: -1,
    lang_rc: -1,
    effects: effect_registry_new()
  }
  match type_canon_render(&ctx, ty)
  when Result::Ok(s) then s
  when Result::Err(_) then "err"
  end
end

def types_equal(a: Vec[Type], b: Vec[Type]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if !type_eq(&a[i], &b[i]) then
      return false
    end
    i = i + 1
  end
  true
end

def type_eq(a: Type, b: Type) -> Bool
  # EXHAUSTIVE over every Type variant (the former version handled only the
  # seven primitive/Adt shapes and returned false for everything else — two
  # IDENTICAL tuple/function/ref/fixed-array types never compared equal, so
  # the former name-derived dedup (the MonoKey record) silently
  # degraded to append-always; the
  # mangled names stayed deterministic so correctness survived, but the
  # cache never hit).
  match a
  when Type::Unit then
    match b
    when Type::Unit then true
    when _ then false
    end
  when Type::Bool then
    match b
    when Type::Bool then true
    when _ then false
    end
  when Type::Int then
    match b
    when Type::Int then true
    when _ then false
    end
  when Type::UInt then
    match b
    when Type::UInt then true
    when _ then false
    end
  when Type::Float then
    match b
    when Type::Float then true
    when _ then false
    end
  when Type::Char then
    match b
    when Type::Char then true
    when _ then false
    end
  when Type::String then
    match b
    when Type::String then true
    when _ then false
    end
  when Type::Never then
    match b
    when Type::Never then true
    when _ then false
    end
  when Type::I8 then
    match b
    when Type::I8 then true
    when _ then false
    end
  when Type::I16 then
    match b
    when Type::I16 then true
    when _ then false
    end
  when Type::I32 then
    match b
    when Type::I32 then true
    when _ then false
    end
  when Type::I64 then
    match b
    when Type::I64 then true
    when _ then false
    end
  when Type::I128 then
    match b
    when Type::I128 then true
    when _ then false
    end
  when Type::U8 then
    match b
    when Type::U8 then true
    when _ then false
    end
  when Type::U16 then
    match b
    when Type::U16 then true
    when _ then false
    end
  when Type::U32 then
    match b
    when Type::U32 then true
    when _ then false
    end
  when Type::U64 then
    match b
    when Type::U64 then true
    when _ then false
    end
  when Type::U128 then
    match b
    when Type::U128 then true
    when _ then false
    end
  when Type::ISize then
    match b
    when Type::ISize then true
    when _ then false
    end
  when Type::USize then
    match b
    when Type::USize then true
    when _ then false
    end
  when Type::F32 then
    match b
    when Type::F32 then true
    when _ then false
    end
  when Type::F64 then
    match b
    when Type::F64 then true
    when _ then false
    end
  when Type::Adt(n1, args1) then
    match b
    when Type::Adt(n2, args2) then
      n1.id == n2.id && types_equal(args1, args2)
    when _ then false
    end
  when Type::FixedArray(e1, n1) then
    match b
    when Type::FixedArray(e2, n2) then
      n1 == n2 && type_eq(e1, e2)
    when _ then false
    end
  when Type::Tuple(elems1) then
    match b
    when Type::Tuple(elems2) then types_equal(elems1, elems2)
    when _ then false
    end
  when Type::FnPtr(params1, ret1, _) then
    match b
    when Type::FnPtr(params2, ret2, _) then
      type_eq_params(params1, params2) && type_eq(ret1, ret2)
    when Type::Closure(_, params2, ret2, _, _) then
      type_eq_params(params1, params2) && type_eq(ret1, ret2)
    when _ then false
    end
  when Type::Closure(cid1, params1, ret1, captures1, _) then
    match b
    when Type::FnPtr(params2, ret2, _) then
      type_eq_params(params1, params2) && type_eq(ret1, ret2)
    when Type::Closure(cid2, params2, ret2, captures2, _) then
      cid1.id == cid2.id && type_eq_params(params1, params2) && type_eq(ret1, ret2) && type_eq(&captures1, &captures2)
    when _ then false
    end
  when Type::RefInternal(inner1, mut1) then
    match b
    when Type::RefInternal(inner2, mut2) then
      mut1 == mut2 && type_eq(inner1, inner2)
    when _ then false
    end
  when Type::Ptr(inner1) then
    match b
    when Type::Ptr(inner2) then type_eq(inner1, inner2)
    when _ then false
    end
  when Type::PtrMut(inner1) then
    match b
    when Type::PtrMut(inner2) then type_eq(inner1, inner2)
    when _ then false
    end
  when Type::Dyn(t1) then
    match b
    when Type::Dyn(t2) then t1.id == t2.id
    when _ then false
    end
  when Type::Effect(effects1, inner1) then
    match b
    when Type::Effect(effects2, inner2) then
      effect_vec_eq(effects1, effects2) && type_eq(inner1, inner2)
    when _ then false
    end
  when Type::Var(v1) then
    match b
    when Type::Var(v2) then v1.id == v2.id
    when _ then false
    end
  when Type::Param(gpid1) then
    match b
    when Type::Param(gpid2) then generic_param_id_eq(&gpid1, &gpid2)
    when _ then false
    end
  when Type::Const(v1) then
    # (§20 slice 1): const generic ARGUMENTS compare by VALUE — Const(4) ==
    # Const(4), Const(4) != Const(8) (the §20 canonical-identity
    # requirement; slice 2 folds const EXPRESSION and module-const
    # SPELLINGS to the same Type::Const before identity comparisons ever
    # run — the args carry values, never spellings). Const never equals a
    # symbolic ConstParam.
    match b
    when Type::Const(v2) then v1 == v2
    when _ then false
    end
  when Type::ConstParam(gpid1) then
    # (§20 slice 1): a SYMBOLIC const parameter reference is alpha-equal by
    # its GenericParamId identity — (owner, index), never the name.
    match b
    when Type::ConstParam(gpid2) then generic_param_id_eq(&gpid1, &gpid2)
    when _ then false
    end
  when Type::ConstSym(tree1) then
    # (§20 slice 2): two SYMBOLIC const-EXPRESSION arguments compare by
    # ORDER-SENSITIVE STRUCTURAL tree equality (const_sym_tree_eq —
    # spelling-sensitive while symbolic, documented in the ConstExprT
    # note); they never equal a folded Const or a bare ConstParam — after
    # substitution a bound tree FOLDS to Type::Const BEFORE any identity
    # comparison sees the slot, so the instance keys compare values.
    match b
    when Type::ConstSym(tree2) then const_sym_tree_eq(&tree1, &tree2)
    when _ then false
    end
  when Type::FixedArraySym(e1, gpid1) then
    # (§20 slice 1): two symbolic-size arrays compare equal exactly when the
    # elements do and the size parameters are the SAME parameter.
    match b
    when Type::FixedArraySym(e2, gpid2) then
      generic_param_id_eq(&gpid1, &gpid2) && type_eq(e1, e2)
    when _ then false
    end
  when Type::IntLiteral(v1) then
    match b
    when Type::IntLiteral(v2) then v1 == v2
    when _ then false
    end
  when Type::StaticStrPtr then
    match b
    when Type::StaticStrPtr then true
    when _ then false
    end
  when Type::Error then
    match b
    when Type::Error then true
    when _ then false
    end
  end
end

# Structural equality of two ParamType lists — the parameter types AND the
# access conventions (two functions differing only in a parameter's access
# convention are different types).
def type_eq_params(a: Vec[ParamType], b: Vec[ParamType]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if !type_eq(&a[i].ty, &b[i].ty) || a[i].convention != b[i].convention then
      return false
    end
    i = i + 1
  end
  true
end

# Structural equality of two String vectors (element order matters).
def string_vec_eq(a: Vec[String], b: Vec[String]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then
      return false
    end
    i = i + 1
  end
  true
end
