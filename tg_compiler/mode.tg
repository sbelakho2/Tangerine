## Tangerine Compiler — Mode System
## Progressive strictness: Dev → Strict → Production → Hardened
##
## §1 of needed.txt: Zero Bureaucracy, Maximum Power
## Strictness scales automatically with project maturity.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map}

# ———————————————————————————————————————————————————————————————
# §1.1 — Four Layered Modes
# ———————————————————————————————————————————————————————————————

enum Mode
  Dev        # Fast iteration, relaxed enforcement
  Strict     # Team reliability, warnings escalate
  Production # Guarantees enforced, build gates
  Hardened   # Security-critical, strictest enforcement
end

struct ModeConfig
  mode: Mode
  auto_escalate: Bool         # Strictness scales with maturity
  allow_stubs: Bool           # Dev = true, others = false
  enforce_contracts: Bool     # Strict+ = true
  enforce_effects: Bool       # Strict+ = true
  enforce_budgets: Bool       # Prod+ = true
  enforce_capabilities: Bool  # All modes, severity varies
  enforce_coverage: Bool      # Strict+ = true
  gate_on_score: Bool         # Prod+ = true
  require_docs_for_pub: Bool  # Strict+ = true
  require_tests_for_pub: Bool # Strict+ = true
  forbid_unsafe_no_reason: Bool # All modes
  forbid_all_unsafe: Bool     # Hardened = true (no unsafe at all)
  require_code_review: Bool   # Hardened = true
  enforce_memory_safety: Bool # Hardened = true (extra bounds checks)
  audit_dependencies: Bool    # Hardened = true
end

# ———————————————————————————————————————————————————————————————
# Default Configuration per Mode
# ———————————————————————————————————————————————————————————————

def dev_config() -> ModeConfig
  ModeConfig {
    mode: Mode::Dev,
    auto_escalate: true,
    allow_stubs: true,
    enforce_contracts: false,
    enforce_effects: false,
    enforce_budgets: false,
    enforce_capabilities: true,
    enforce_coverage: false,
    gate_on_score: false,
    require_docs_for_pub: false,
    require_tests_for_pub: false,
    forbid_unsafe_no_reason: true,
    forbid_all_unsafe: false,
    require_code_review: false,
    enforce_memory_safety: false,
    audit_dependencies: false
  }
end

def strict_config() -> ModeConfig
  ModeConfig {
    mode: Mode::Strict,
    auto_escalate: true,
    allow_stubs: false,
    enforce_contracts: true,
    enforce_effects: true,
    enforce_budgets: false,
    enforce_capabilities: true,
    enforce_coverage: true,
    gate_on_score: false,
    require_docs_for_pub: true,
    require_tests_for_pub: true,
    forbid_unsafe_no_reason: true,
    forbid_all_unsafe: false,
    require_code_review: false,
    enforce_memory_safety: false,
    audit_dependencies: false
  }
end

def production_config() -> ModeConfig
  ModeConfig {
    mode: Mode::Production,
    auto_escalate: false,
    allow_stubs: false,
    enforce_contracts: true,
    enforce_effects: true,
    enforce_budgets: true,
    enforce_capabilities: true,
    enforce_coverage: true,
    gate_on_score: true,
    require_docs_for_pub: true,
    require_tests_for_pub: true,
    forbid_unsafe_no_reason: true,
    forbid_all_unsafe: false,
    require_code_review: false,
    enforce_memory_safety: true,
    audit_dependencies: false
  }
end

def hardened_config() -> ModeConfig
  ModeConfig {
    mode: Mode::Hardened,
    auto_escalate: false,
    allow_stubs: false,
    enforce_contracts: true,
    enforce_effects: true,
    enforce_budgets: true,
    enforce_capabilities: true,
    enforce_coverage: true,
    gate_on_score: true,
    require_docs_for_pub: true,
    require_tests_for_pub: true,
    forbid_unsafe_no_reason: true,
    forbid_all_unsafe: true,
    require_code_review: true,
    enforce_memory_safety: true,
    audit_dependencies: true
  }
end

# ———————————————————————————————————————————————————————————————
# Mode Resolution from Tangerine.toml
# ———————————————————————————————————————————————————————————————

def config_for_mode(mode: Mode) -> ModeConfig
  match mode
  when Mode::Dev then dev_config()
  when Mode::Strict then strict_config()
  when Mode::Production then production_config()
  when Mode::Hardened then hardened_config()
  end
end

def parse_mode(s: String) -> Option[Mode]
  match s.to_lowercase()
  when "dev" then Option::Some(Mode::Dev)
  when "strict" then Option::Some(Mode::Strict)
  when "production" then Option::Some(Mode::Production)
  when "hardened" then Option::Some(Mode::Hardened)
  when _ then Option::None
  end
end

def mode_name(m: Mode) -> String
  match m
  when Mode::Dev then "Dev"
  when Mode::Strict then "Strict"
  when Mode::Production then "Production"
  when Mode::Hardened then "Hardened"
  end
end

def mode_ordinal(m: Mode) -> Int
  match m
  when Mode::Dev then 0
  when Mode::Strict then 1
  when Mode::Production then 2
  when Mode::Hardened then 3
  end
end

def is_at_least(current: Mode, threshold: Mode) -> Bool
  mode_ordinal(current) >= mode_ordinal(threshold)
end

# ———————————————————————————————————————————————————————————————
# §3.2 — Security Profiles
# ———————————————————————————————————————————————————————————————

enum SecurityProfile
  Backend   # Allows network, restricts process spawn, sandboxes FS
  Cli       # Full FS/env, restricted network, no process spawn
  Ui        # Restricted FS, network for assets, no process spawn
  Library   # No implicit capabilities at all
  Custom(String)
end

struct ProfileConfig
  profile: SecurityProfile
  allow_network: Bool
  allow_filesystem: Bool
  sandbox_fs_to_root: Bool
  allow_process_spawn: Bool
  allow_env_mutation: Bool
  allow_ffi: Bool
end

def backend_profile() -> ProfileConfig
  ProfileConfig {
    profile: SecurityProfile::Backend,
    allow_network: true,
    allow_filesystem: true,
    sandbox_fs_to_root: true,
    allow_process_spawn: false,
    allow_env_mutation: false,
    allow_ffi: false
  }
end

def cli_profile() -> ProfileConfig
  ProfileConfig {
    profile: SecurityProfile::Cli,
    allow_network: false,
    allow_filesystem: true,
    sandbox_fs_to_root: false,
    allow_process_spawn: false,
    allow_env_mutation: true,
    allow_ffi: false
  }
end

def ui_profile() -> ProfileConfig
  ProfileConfig {
    profile: SecurityProfile::Ui,
    allow_network: true,
    allow_filesystem: false,
    sandbox_fs_to_root: true,
    allow_process_spawn: false,
    allow_env_mutation: false,
    allow_ffi: false
  }
end

def library_profile() -> ProfileConfig
  ProfileConfig {
    profile: SecurityProfile::Library,
    allow_network: false,
    allow_filesystem: false,
    sandbox_fs_to_root: false,
    allow_process_spawn: false,
    allow_env_mutation: false,
    allow_ffi: false
  }
end

def parse_profile(s: String) -> SecurityProfile
  match s.to_lowercase()
  when "backend" then SecurityProfile::Backend
  when "cli" then SecurityProfile::Cli
  when "ui" then SecurityProfile::Ui
  when "library" then SecurityProfile::Library
  when _ then SecurityProfile::Custom(s)
  end
end

def profile_name(p: SecurityProfile) -> String
  match p
  when SecurityProfile::Backend then "backend"
  when SecurityProfile::Cli then "cli"
  when SecurityProfile::Ui then "ui"
  when SecurityProfile::Library then "library"
  when SecurityProfile::Custom(name) then name
  end
end

# ———————————————————————————————————————————————————————————————
# §4 — Stub & Incomplete Detection Configuration
# ———————————————————————————————————————————————————————————————

struct StubDetectionConfig
  warn_constant_returns: Bool
  warn_unreachable: Bool
  warn_empty_match_arms: Bool
  warn_todo_comments: Bool
  error_pub_placeholders: Bool
  error_untested_branches: Bool
  error_silent_fallthrough: Bool
  enforce_completeness: Bool
end

def stub_config_for_mode(mode: Mode) -> StubDetectionConfig
  match mode
  when Mode::Dev then
    StubDetectionConfig {
      warn_constant_returns: true,
      warn_unreachable: true,
      warn_empty_match_arms: true,
      warn_todo_comments: true,
      error_pub_placeholders: false,
      error_untested_branches: false,
      error_silent_fallthrough: false,
      enforce_completeness: false
    }
  when Mode::Strict then
    StubDetectionConfig {
      warn_constant_returns: true,
      warn_unreachable: true,
      warn_empty_match_arms: true,
      warn_todo_comments: true,
      error_pub_placeholders: true,
      error_untested_branches: true,
      error_silent_fallthrough: true,
      enforce_completeness: false
    }
  when Mode::Production then
    StubDetectionConfig {
      warn_constant_returns: true,
      warn_unreachable: true,
      warn_empty_match_arms: true,
      warn_todo_comments: true,
      error_pub_placeholders: true,
      error_untested_branches: true,
      error_silent_fallthrough: true,
      enforce_completeness: true
    }
  when Mode::Hardened then
    StubDetectionConfig {
      warn_constant_returns: true,
      warn_unreachable: true,
      warn_empty_match_arms: true,
      warn_todo_comments: true,
      error_pub_placeholders: true,
      error_untested_branches: true,
      error_silent_fallthrough: true,
      enforce_completeness: true
    }
  end
end

# ———————————————————————————————————————————————————————————————
# §7 — Error Handling Discipline Configuration
# ———————————————————————————————————————————————————————————————

enum ErrorDisposition
  Propagated        # Used `?` operator
  Handled           # Matched/consumed
  IgnoredWithReason # .ignore("reason") — documented intent
  Swallowed         # Unchecked — violation
end

struct ErrorHandlingConfig
  require_propagation_or_handling: Bool
  allow_ignore_with_reason: Bool
  audit_ignores: Bool
end

def error_config_for_mode(mode: Mode) -> ErrorHandlingConfig
  match mode
  when Mode::Dev then
    ErrorHandlingConfig {
      require_propagation_or_handling: false,
      allow_ignore_with_reason: true,
      audit_ignores: false
    }
  when Mode::Strict then
    ErrorHandlingConfig {
      require_propagation_or_handling: true,
      allow_ignore_with_reason: true,
      audit_ignores: true
    }
  when Mode::Production then
    ErrorHandlingConfig {
      require_propagation_or_handling: true,
      allow_ignore_with_reason: true,
      audit_ignores: true
    }
  when Mode::Hardened then
    ErrorHandlingConfig {
      require_propagation_or_handling: true,
      allow_ignore_with_reason: true,
      audit_ignores: true
    }
  end
end

# ———————————————————————————————————————————————————————————————
# §10 — Budget Enforcement Configuration
# ———————————————————————————————————————————————————————————————

enum BudgetEnforcement
  ShowStats   # Dev: live stats
  WarnRegress # Strict: warns on regression
  FailBuild   # Prod: fails build
end

def budget_enforcement_for_mode(mode: Mode) -> BudgetEnforcement
  match mode
  when Mode::Dev then BudgetEnforcement::ShowStats
  when Mode::Strict then BudgetEnforcement::WarnRegress
  when Mode::Production then BudgetEnforcement::FailBuild
  when Mode::Hardened then BudgetEnforcement::FailBuild
  end
end

# ———————————————————————————————————————————————————————————————
# §17 — Strong Defaults Against Partial APIs
# ———————————————————————————————————————————————————————————————

struct PublicApiRules
  must_have_doc_example: Bool
  must_have_test: Bool
  must_define_error_model: Bool
  must_not_expose_raw_ptrs: Bool
end

def pub_api_rules_for_mode(mode: Mode) -> PublicApiRules
  match mode
  when Mode::Dev then
    PublicApiRules {
      must_have_doc_example: false,
      must_have_test: false,
      must_define_error_model: false,
      must_not_expose_raw_ptrs: true
    }
  when Mode::Strict then
    PublicApiRules {
      must_have_doc_example: true,
      must_have_test: true,
      must_define_error_model: true,
      must_not_expose_raw_ptrs: true
    }
  when Mode::Production then
    PublicApiRules {
      must_have_doc_example: true,
      must_have_test: true,
      must_define_error_model: true,
      must_not_expose_raw_ptrs: true
    }
  when Mode::Hardened then
    PublicApiRules {
      must_have_doc_example: true,
      must_have_test: true,
      must_define_error_model: true,
      must_not_expose_raw_ptrs: true
    }
  end
end

# ———————————————————————————————————————————————————————————————
# §13 — Implementation Fullness Enforcement
# ———————————————————————————————————————————————————————————————

struct FullnessConfig
  require_integration_test: Bool
  forbid_unexercised_branches: Bool
  forbid_dead_code: Bool
  detect_unreachable_pub: Bool
end

def fullness_config_for_mode(mode: Mode) -> FullnessConfig
  match mode
  when Mode::Dev then
    FullnessConfig {
      require_integration_test: false,
      forbid_unexercised_branches: false,
      forbid_dead_code: false,
      detect_unreachable_pub: true
    }
  when Mode::Strict then
    FullnessConfig {
      require_integration_test: true,
      forbid_unexercised_branches: false,
      forbid_dead_code: true,
      detect_unreachable_pub: true
    }
  when Mode::Production then
    FullnessConfig {
      require_integration_test: true,
      forbid_unexercised_branches: true,
      forbid_dead_code: true,
      detect_unreachable_pub: true
    }
  when Mode::Hardened then
    FullnessConfig {
      require_integration_test: true,
      forbid_unexercised_branches: true,
      forbid_dead_code: true,
      detect_unreachable_pub: true
    }
  end
end

# ———————————————————————————————————————————————————————————————
# §19 — Compiler as Advisor (Suggestion Engine)
# ———————————————————————————————————————————————————————————————

enum SuggestionKind
  PromoteGuardToContract   # "You always check x > 0. Promote to contract?"
  ConsolidatePattern       # "Repeated pattern detected — extract helper?"
  AddPropertyTest          # "Complex logic detected — add property test?"
  TightenSecurity          # "Capability drift detected — tighten?"
  AddBudget                # "Hot function without budget — add @budget?"
  AddEffectAnnotation      # "Inferred effects — declare explicitly?"
  AddDocExample            # "Public API missing doc example"
  UseStrongerType          # "Raw string used where SqlQuery/HtmlSafe fits"
end

struct CompilerSuggestion
  kind: SuggestionKind
  message: String
  span: Option[RichSpan]
  confidence: Float
  auto_fixable: Bool
end

# Note: This is a richer span type with file/line info, distinct from token.tg's Span (offset-based)
struct RichSpan
  file: String
  start_line: Int
  start_col: Int
  end_line: Int
  end_col: Int
end

def format_suggestion(s: CompilerSuggestion) -> String
  let prefix = match s.kind
  when SuggestionKind::PromoteGuardToContract then "💡 Contract"
  when SuggestionKind::ConsolidatePattern then "💡 Refactor"
  when SuggestionKind::AddPropertyTest then "💡 Testing"
  when SuggestionKind::TightenSecurity then "🔒 Security"
  when SuggestionKind::AddBudget then "⏱ Performance"
  when SuggestionKind::AddEffectAnnotation then "💡 Effects"
  when SuggestionKind::AddDocExample then "📖 Docs"
  when SuggestionKind::UseStrongerType then "🛡 Types"
  end
  prefix + ": " + s.message
end
