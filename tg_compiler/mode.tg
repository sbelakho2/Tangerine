## Tangerine Compiler — Mode System
## Progressive strictness: Dev → Strict → Production → Hardened
##
## §1 of needed.txt: Zero Bureaucracy, Maximum Power
## Strictness scales automatically with project maturity.
##
## REDUCED SURFACE (2026-08): ModeConfig carries ONLY the behavior the
## pipeline actually implements. The former configuration bits (effects/
## budgets/coverage/CQS/docs/tests gates, the unsafe bans, the review and
## memory-safety and dependency-audit policies, stubs, auto-escalation)
## were configuration data claiming semantics no pass implements — no
## compile/check path read them (language.md §Progressive Strictness
## downgraded them; the bits and their per-mode factories are deleted
## here, not just documented as pending).

use std::core::{Option}

# ———————————————————————————————————————————————————————————————
# §1.1 — Four Layered Modes
# ———————————————————————————————————————————————————————————————

enum Mode
  Dev        # Fast iteration, relaxed enforcement
  Strict     # Team reliability, warnings escalate
  Production # Guarantees enforced, build gates
  Hardened   # Security-critical, strictest enforcement
end

# The mode configuration. The two bits that remain describe behavior the
# pipeline ACTUALLY enforces — and both are UNCONDITIONAL: the contract
# check lowering (mir.tg `lower_contract` → MirContractCheck → runtime
# trap) and the capability exit machinery (resource_check.tg
# `validate_capability_exit`) never consult the mode flag, so `--mode`
# selects the enum only; the bits are never read as gates.
struct ModeConfig
  mode: Mode
  enforce_contracts: Bool     # enforced unconditionally (lower_contract, mir.tg)
  enforce_capabilities: Bool  # enforced unconditionally (validate_capability_exit, resource_check.tg)
end

# ———————————————————————————————————————————————————————————————
# Default Configuration per Mode
# ———————————————————————————————————————————————————————————————

def dev_config() -> ModeConfig
  ModeConfig {
    mode: Mode::Dev,
    enforce_contracts: true,
    enforce_capabilities: true
  }
end

def strict_config() -> ModeConfig
  ModeConfig {
    mode: Mode::Strict,
    enforce_contracts: true,
    enforce_capabilities: true
  }
end

def production_config() -> ModeConfig
  ModeConfig {
    mode: Mode::Production,
    enforce_contracts: true,
    enforce_capabilities: true
  }
end

def hardened_config() -> ModeConfig
  ModeConfig {
    mode: Mode::Hardened,
    enforce_contracts: true,
    enforce_capabilities: true
  }
end

# ———————————————————————————————————————————————————————————————
# Mode Resolution from Tangerine.toml
# ———————————————————————————————————————————————————————————————

def config_for_mode(mode: Mode) -> ModeConfig
  match mode
  when Mode::Dev then dev_config()
  when Mode::Strict then strict_config()
  when Mode::Production then production_config()
  when Mode::Hardened then hardened_config()
  end  end  end
end

def parse_mode(s: String) -> Option[Mode]
  match s.to_lowercase()
  when "dev" then Option::Some(Mode::Dev)
  when "strict" then Option::Some(Mode::Strict)
  when "production" then Option::Some(Mode::Production)
  when "hardened" then Option::Some(Mode::Hardened)
  when _ then Option::None
  end  end
end

def mode_name(m: Mode) -> String
  match m
  when Mode::Dev then "Dev"
  when Mode::Strict then "Strict"
  when Mode::Production then "Production"
  when Mode::Hardened then "Hardened"
  end  end
end

def mode_ordinal(m: Mode) -> Int
  match m
  when Mode::Dev then 0
  when Mode::Strict then 1
  when Mode::Production then 2
  when Mode::Hardened then 3
  end  end
end

def is_at_least(current: Mode, threshold: Mode) -> Bool
  mode_ordinal(current) >= mode_ordinal(threshold)
end

# ———————————————————————————————————————————————————————————————
# Span surface shared with the tooling modules (cqs.tg consumes it).
# RichSpan is line/column-oriented, distinct from token.tg's offset-based
# Span.
# ———————————————————————————————————————————————————————————————

struct RichSpan
  file: String
  start_line: Int
  start_col: Int
  end_line: Int
  end_col: Int
end
