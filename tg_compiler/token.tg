# Tangerine Compiler — Token Definitions
# Self-hosting compiler written in Tangerine
#
# This module defines all tokens for the Tangerine language including:
# - Core language constructs (def, struct, enum, trait, impl)
# - Memory safety primitives (mut, &, &mut, move, copy)
# - Agentic features (pre, post, invariant, cap, requires, budget)
# - Modern control flow (async, await, defer, try, catch)
# - Compile-time features (comptime, const, static, type)

use std::core::{Option, Result, panic, __intrinsic_pow, __intrinsic_int_to_float}
use std::collections::{Vec}

# ———————————————————————————————————————————————————————————————
# Source Location
# ———————————————————————————————————————————————————————————————

struct Span
  file: String
  start: Int
  end_pos: Int
end

def span_new(start: Int, end_pos: Int) -> Span
  Span { file: "", start: start, end_pos: end_pos }
end

def span_to_line_col(span: Span, source: String) -> (Int, Int, Int, Int)
  # The Unicode line semantics: LF -> line+1, CRLF -> line+1 (one break,
  # both bytes), CR alone -> line+1 (the CR is a line ending).
  mut start_line = 1
  mut start_col = 1
  mut end_line = 1
  mut end_col = 1
  mut i = 0
  while i < source.len() do
    if i == span.start then
      start_line = end_line
      start_col = end_col
    end
    if i == span.end_pos then
      break
    end
    let c = source.char_at(i)
    if c == '\r' then
      end_line = end_line + 1
      end_col = 1
      if i + 1 < source.len() && source.char_at(i + 1) == '\n' then
        # the CRLF pair is ONE line break: consume the LF here
        i = i + 1
      end
    elsif c == '\n' then
      end_line = end_line + 1
      end_col = 1
    else
      end_col = end_col + 1
    end
    i = i + 1
  end
  (start_line, start_col, end_line, end_col)
end

def span_dummy() -> Span
  Span { file: "", start: 0, end_pos: 0 }
end

def span_start(span: Span) -> Int
  span.start
end

def span_end(span: Span) -> Int
  span.end_pos
end

def span_merge(a: Span, b: Span) -> Span
  let s = if a.start < b.start then a.start else b.start end
  let e = if a.end_pos > b.end_pos then a.end_pos else b.end_pos end
  Span { file: a.file, start: s, end_pos: e }
end

# ———————————————————————————————————————————————————————————————
# Numeric Literal Payloads — the lossless pre-typing representation
# ———————————————————————————————————————————————————————————————
# The LEXER preserves the literal's digits — arbitrary precision, never
# converted to the host Int — and the TYPE CHECKER alone decides whether
# the literal fits its target type (the suffix's exact range, the
# inferred Int range; the overflow is ONE stable diagnostic, never a
# fabricated 0/0.0). The host-value helpers below exist ONLY for the
# MIR/const-eval consumers that materialize a checker-accepted literal;
# the lexer never calls them.

struct ParsedIntegerLiteral
  sign: Int                 # +1 at lex time (unary minus is a separate token; the checker folds the sign)
  radix: UInt               # 10, 16, 2, or 8
  magnitude: Vec[u8]        # the digits, most-significant first, each digit < radix — the arbitrary precision
  explicit_suffix: Option[String]
  source_span: Span
end

struct ParsedFloatLiteral
  significand: String       # the digit text (integer and fraction digits with '.', separators stripped)
  exponent: String          # the exponent digit text with its sign ("" when absent)
  has_exponent: Bool
  explicit_suffix: Option[String]
  source_span: Span
  value: Option[Float]      # the host f64 parse; None when the value does not parse finitely (overflow) — fail-closed, never a fabricated 0.0
end

# The host-Int value of an integer literal (wrapping accumulation — the
# two's-complement bit pattern; exact for literals whose magnitude fits
# the host Int, the wrapped bit pattern for the unsigned-typed cases the
# checker accepted against the unsigned range).
def parsed_int_to_host(p: ParsedIntegerLiteral) -> Int
  mut result = 0
  let rad = p.radix as Int
  for d in p.magnitude do
    result = result * rad + (d as Int)
  end
  if p.sign < 0 then 0 - result else result end
end

# Whether the literal's magnitude fits the host Int — the fail-closed
# pre-check: every accumulation step is guarded before the multiply, so a
# magnitude beyond the host range is DETECTED (never silently wrapped).
def parsed_int_fits_host(p: ParsedIntegerLiteral) -> Bool
  mut result = 0
  let rad = p.radix as Int
  for d in p.magnitude do
    let dv = d as Int
    if dv > 0 && result > (9223372036854775807 - dv) / rad then
      return false
    end
    result = result * rad + dv
  end
  true
end

def parsed_int_is_zero(p: ParsedIntegerLiteral) -> Bool
  p.magnitude.len() == 1 && p.magnitude[0] == 0u8
end

# The literal's digits as text in their own radix (never the host value).
def parsed_int_magnitude_text(p: ParsedIntegerLiteral) -> String
  mut s = ""
  for d in p.magnitude do
    let v = d as Int
    let c = if v < 10 then (('0' as Int) + v) as Char else (('a' as Int) + v - 10) as Char end
    s = s + c.to_string()
  end
  s
end

# The literal's source spelling (radix prefix + digits + suffix) — the
# faithful form for the formatter (never the host conversion).
def parsed_int_spelling(p: ParsedIntegerLiteral) -> String
  let prefix = match p.radix
    when 16 then "0x"
    when 2 then "0b"
    when 8 then "0o"
    when _ then ""
  end
  let mut s = prefix + parsed_int_magnitude_text(p)
  match p.explicit_suffix
  when Option::Some(sfx) then s + sfx
  when Option::None then s
  end
end

# The float literal's source spelling (significand + exponent + suffix).
def parsed_float_spelling(p: ParsedFloatLiteral) -> String
  let mut s = p.significand
  if p.has_exponent then
    s = s + "e" + p.exponent
  end
  match p.explicit_suffix
  when Option::Some(sfx) then s + sfx
  when Option::None then s
  end
end

# The magnitude as a canonical DECIMAL digit string — arbitrary precision
# (the radix digits are re-based into decimal via digit-array arithmetic;
# string-based, never overflows).
def parsed_int_decimal(p: ParsedIntegerLiteral) -> String
  mut dec = Vec::from([0u8])
  let rad = p.radix as Int
  for d in p.magnitude do
    dec = decimal_mul_add(dec, rad, d as Int)
  end
  decimal_digits_to_string(dec)
end

# dec (little-endian decimal digits) * radix + add — digit-array arithmetic.
def decimal_mul_add(dec: Vec[u8], radix: Int, add: Int) -> Vec[u8]
  mut out = Vec::new()
  for d in dec do
    out.push(d)
  end
  mut carry = add
  mut i = 0
  while i < out.len() do
    let v = (out[i] as Int) * radix + carry
    out[i] = (v % 10) as u8
    carry = v / 10
    i = i + 1
  end
  while carry > 0 do
    out.push((carry % 10) as u8)
    carry = carry / 10
  end
  out
end

def decimal_digits_to_string(dec: Vec[u8]) -> String
  mut s = ""
  var i = dec.len()
  while i > 0 do
    i = i - 1
    s = s + (((('0' as Int) + (dec[i] as Int)) as Char).to_string())
  end
  s
end

# Whether the parsed float is a FINITE f64 value (not None, not ±inf, not
# NaN) — the checker's fail-closed overflow gate.
def parsed_float_finite(p: ParsedFloatLiteral) -> Bool
  match p.value
  when Option::Some(f) then
    let bits = f.to_bits()
    let biased_exp = bits & 0x7FF0000000000000
    biased_exp != 0x7FF0000000000000
  when Option::None then false
  end  end  end
end

# The host Float of a checker-accepted float literal. Fail-closed: a
# non-finite value is a checker-rejected literal (compilation already
# aborted) — never a fabricated 0.0.
def parsed_float_to_host(p: ParsedFloatLiteral) -> Float
  match p.value
  when Option::Some(f) then
    if parsed_float_finite(p) then
      f
    else
      panic("internal error: parsed_float_to_host on a non-finite float literal (the checker rejected it)")
    end
  when Option::None then
    panic("internal error: parsed_float_to_host on an unparsed float literal (the checker rejected it)")
  end  end
end

# The significand digit string and the TOTAL decimal exponent (the
# exponent of the digit string as an integer, the decimal point folded in)
# — the arbitrary-precision float form the range gates compare against the
# f32/f64 maxima.
def parsed_float_digits_and_exp(p: ParsedFloatLiteral) -> (String, Int)
  let digits = p.significand.replace(".", "")
  let int_part_len = match p.significand.find(".")
    when Option::Some(dot_pos) then dot_pos
    when Option::None then p.significand.len()
  end
  mut exp_val = 0
  var neg_exp = false
  var e0 = 0
  if p.exponent.len() > 0 && p.exponent.char_at(0) == '-' then
    neg_exp = true
    e0 = 1
  elsif p.exponent.len() > 0 && p.exponent.char_at(0) == '+' then
    e0 = 1
  end
  let exp_body = p.exponent.slice(e0, p.exponent.len())
  if exp_body.len() > 9 then
    # the exponent beyond Int precision — the sign alone decides the order
    if neg_exp then
      return (digits, -1000000000)
    else
      return (digits, 1000000000)
    end
  end
  var ei = 0
  while ei < exp_body.len() do
    exp_val = exp_val * 10 + ((exp_body.char_at(ei) as Int) - ('0' as Int))
    ei = ei + 1
  end
  if neg_exp then exp_val = 0 - exp_val end
  (digits, exp_val + (int_part_len - digits.len()))
end

# Whether the exact decimal magnitude exceeds the f64 maximum
# (1.7976931348623157e308) OR the materialized value is not finite — the
# fail-closed overflow gate (1e309 is the overflow, never a silent inf).
def parsed_float_f64_overflow(p: ParsedFloatLiteral) -> Bool
  let (digits, total_exp) = parsed_float_digits_and_exp(p)
  if decimal_float_strings_gt(digits, total_exp, "17976931348623157", 292) then
    true
  else
    !parsed_float_finite(p)
  end
end

# Whether the exact decimal magnitude exceeds the f32 maximum
# (3.40282346638528859812e38) — decided by the significand/exponent
# STRINGS (arbitrary precision), never the host Float.
def parsed_float_f32_overflow(p: ParsedFloatLiteral) -> Bool
  let (digits, total_exp) = parsed_float_digits_and_exp(p)
  decimal_float_strings_gt(digits, total_exp, "340282346638528859811704183484516925440", 0)
end

# The f64 value from the significand/exponent STRINGS (the runtime's
# parse_float does not support exponents — this conversion does: the
# 17-digit rounded mantissa times the power of ten). None on the overflow
# side (beyond f64 finite range) — fail-closed, never a fabricated 0.0;
# the underflow side legitimately rounds to 0.0.
def parsed_float_value_of(significand: String, exponent: String) -> Option[Float]
  let digits = significand.replace(".", "")
  var start_idx = 0
  while start_idx < digits.len() - 1 && digits.char_at(start_idx) == '0' do
    start_idx = start_idx + 1
  end
  let body = digits.slice(start_idx, digits.len())
  if body.len() == 0 then
    return Option::Some(0.0)
  end
  let int_part_len = match significand.find(".")
    when Option::Some(dot_pos) then dot_pos
    when Option::None then significand.len()
  end
  mut exp_val = 0
  var neg_exp = false
  var e0 = 0
  if exponent.len() > 0 && exponent.char_at(0) == '-' then
    neg_exp = true
    e0 = 1
  elsif exponent.len() > 0 && exponent.char_at(0) == '+' then
    e0 = 1
  end
  let exp_body = exponent.slice(e0, exponent.len())
  if exp_body.len() > 9 then
    return Option::None
  end
  var ei = 0
  while ei < exp_body.len() do
    exp_val = exp_val * 10 + ((exp_body.char_at(ei) as Int) - ('0' as Int))
    ei = ei + 1
  end
  if neg_exp then exp_val = 0 - exp_val end
  let total_exp = exp_val + (int_part_len - digits.len())
  mut mant = 0
  mut di = 0
  while di < 17 do
    let dv = if di < body.len() then (body.char_at(di) as Int) - ('0' as Int) else 0 end
    mant = mant * 10 + dv
    di = di + 1
  end
  if body.len() > 17 && body.char_at(17) >= '5' then
    mant = mant + 1
  end
  let final_exp = total_exp + body.len() - 17
  if final_exp > 308 then
    return Option::None
  end
  let f_mant = __intrinsic_int_to_float(mant)
  if final_exp < -324 then
    return Option::Some(0.0)
  end
  let f_pow = __intrinsic_pow(10.0, __intrinsic_int_to_float(final_exp))
  Option::Some(f_mant * f_pow)
end

# strict > for value = digits × 10^exp (both normalized, arbitrary
# precision digit-string comparison).
def decimal_float_strings_gt(digits1: String, exp1: Int, digits2: String, exp2: Int) -> Bool
  let d1 = strip_trailing_zeros(digits1)
  let d2 = strip_trailing_zeros(digits2)
  mut len1 = d1.len()
  mut len2 = d2.len()
  mut e1 = exp1
  mut e2 = exp2
  if len1 < len2 then
    e1 = e1 - (len2 - len1)
    len1 = len2
  elsif len2 < len1 then
    e2 = e2 - (len1 - len2)
    len2 = len1
  end
  if e1 != e2 then
    return e1 > e2
  end
  mut ci = 0
  while ci < len1 do
    let c1 = d1.char_at(ci) as Int
    let c2 = d2.char_at(ci) as Int
    if c1 != c2 then
      return c1 > c2
    end
    ci = ci + 1
  end
  false
end

def strip_trailing_zeros(s: String) -> String
  var end_idx = s.len()
  while end_idx > 1 && s.char_at(end_idx - 1) == '0' do
    end_idx = end_idx - 1
  end
  s.slice(0, end_idx)
end

# ———————————————————————————————————————————————————————————————
# Token Kinds
# ———————————————————————————————————————————————————————————————

enum TokenKind
  # Literals
  IntLit(ParsedIntegerLiteral)
  FloatLit(ParsedFloatLiteral)
  StringLit(String)
  CharLit(Char)
  
  # Identifier
  Ident(String)
  
  # Doc comment (##... until newline)
  DocComment(String)
  
  # Core Keywords
  Def
  End
  Do
  If
  Elsif
  Else
  While
  For
  In
  Loop
  Match
  When
  Then
  Unless
  Until
  Let
  Mut
  Return
  Break
  Next
  Struct
  Enum
  Trait
  Impl
  Module
  Use
  As
  Pub
  Private
  Macro
  Where
  True
  False
  Nil
  Self_
  SelfType
  
  # Memory Safety Keywords
  TkMove
  TkCopy
  TkDrop
  TkOwn
  TkRef
  TkRefMut
  Inout
  Sink
  Set
  Resource
  Deinit
  
  # Agentic Keywords
  Pre
  Post
  Invariant
  Cap
  Unsafe
  Rationale
  Budget
  Edition
  Requires
  Ensures
  Effect
  Pure
  
  # Modern Language Keywords
  Async
  Await
  Defer
  Try
  Catch
  Finally
  Guard
  Handle
  With
  Is
  Implies
  Comptime
  Const
  Static
  Type
  Alias
  Extern
  Inline
  
  # Operators
  Plus
  Minus
  Star
  Slash
  Percent
  Eq
  EqEq
  BangEq
  Lt
  Gt
  LtEq
  GtEq
  And
  Or
  Bang
  Amp
  AmpMut
  Pipe
  PipeArrow
  Arrow
  FatArrow
  Question
  ColonColon
  Dot
  DotDot
  DotDotEq
  Tilde
  Caret
  DoubleStar
  Shl
  Shr
  PlusEq
  MinusEq
  StarEq
  SlashEq
  PercentEq
  AmpEq
  PipeEq
  CaretEq
  ShlEq
  ShrEq
  
  # Delimiters
  LParen
  RParen
  LBracket
  RBracket
  LBrace
  RBrace
  
  # Punctuation
  Colon
  Semicolon
  Comma
  At
  Hash
  
  # Special
  Newline
  Eof
  Error(String)
end

struct Token
  kind: TokenKind
  span: Span
end

def token_new(kind: TokenKind, span: Span) -> Token
  Token { kind: kind, span: span }
end

# ———————————————————————————————————————————————————————————————
# Keyword Lookup (hash map based for O(1) amortized lookup)
# ———————————————————————————————————————————————————————————————

mut KEYWORD_MAP: Option[Map[String, TokenKind]] = Option::None

def init_keyword_map() -> Map[String, TokenKind]
  mut m = Map::new()
  m.insert("def", TokenKind::Def)
  m.insert("end", TokenKind::End)
  m.insert("do", TokenKind::Do)
  m.insert("if", TokenKind::If)
  m.insert("elsif", TokenKind::Elsif)
  m.insert("else", TokenKind::Else)
  m.insert("while", TokenKind::While)
  m.insert("for", TokenKind::For)
  m.insert("in", TokenKind::In)
  m.insert("loop", TokenKind::Loop)
  m.insert("match", TokenKind::Match)
  m.insert("when", TokenKind::When)
  m.insert("then", TokenKind::Then)
  m.insert("unless", TokenKind::Unless)
  m.insert("until", TokenKind::Until)
  m.insert("let", TokenKind::Let)
  m.insert("mut", TokenKind::Mut)
  m.insert("var", TokenKind::Mut)
  m.insert("inout", TokenKind::Inout)
  m.insert("sink", TokenKind::Sink)
  m.insert("set", TokenKind::Set)
  m.insert("resource", TokenKind::Resource)
  m.insert("deinit", TokenKind::Deinit)
  m.insert("return", TokenKind::Return)
  m.insert("break", TokenKind::Break)
  m.insert("next", TokenKind::Next)
  m.insert("continue", TokenKind::Next)
  m.insert("struct", TokenKind::Struct)
  m.insert("enum", TokenKind::Enum)
  m.insert("trait", TokenKind::Trait)
  m.insert("impl", TokenKind::Impl)
  m.insert("module", TokenKind::Module)
  m.insert("mod", TokenKind::Module)
  m.insert("use", TokenKind::Use)
  m.insert("as", TokenKind::As)
  m.insert("pub", TokenKind::Pub)
  m.insert("private", TokenKind::Private)
  m.insert("macro", TokenKind::Macro)
  m.insert("where", TokenKind::Where)
  m.insert("true", TokenKind::True)
  m.insert("false", TokenKind::False)
  m.insert("nil", TokenKind::Nil)
  m.insert("self", TokenKind::Self_)
  m.insert("Self", TokenKind::SelfType)
  m.insert("super", TokenKind::Ident("super".to_string()))
  m.insert("crate", TokenKind::Ident("crate".to_string()))
  m.insert("move", TokenKind::TkMove)
  m.insert("copy", TokenKind::TkCopy)
  m.insert("drop", TokenKind::TkDrop)
  m.insert("own", TokenKind::TkOwn)
  m.insert("ref", TokenKind::TkRef)
  m.insert("pre", TokenKind::Pre)
  m.insert("post", TokenKind::Post)
  m.insert("invariant", TokenKind::Invariant)
  m.insert("cap", TokenKind::Cap)
  m.insert("unsafe", TokenKind::Unsafe)
  m.insert("rationale", TokenKind::Rationale)
  m.insert("budget", TokenKind::Budget)
  m.insert("edition", TokenKind::Edition)
  m.insert("requires", TokenKind::Requires)
  m.insert("ensures", TokenKind::Ensures)
  m.insert("effect", TokenKind::Effect)
  m.insert("pure", TokenKind::Pure)
  m.insert("async", TokenKind::Async)
  m.insert("await", TokenKind::Await)
  m.insert("defer", TokenKind::Defer)
  m.insert("try", TokenKind::Try)
  m.insert("catch", TokenKind::Catch)
  m.insert("finally", TokenKind::Finally)
  m.insert("guard", TokenKind::Guard)
  m.insert("handle", TokenKind::Handle)
  m.insert("with", TokenKind::With)
  m.insert("is", TokenKind::Is)
  m.insert("implies", TokenKind::Implies)
  m.insert("comptime", TokenKind::Comptime)
  m.insert("const", TokenKind::Const)
  m.insert("static", TokenKind::Static)
  m.insert("type", TokenKind::Type)
  m.insert("typealias", TokenKind::Type)
  m.insert("alias", TokenKind::Alias)
  m.insert("extern", TokenKind::Extern)
  m.insert("inline", TokenKind::Inline)
  return m
end

def keyword_from_str(s: String) -> Option[TokenKind]
  if s.len() > 9 then
    return Option::None
  end

  match s
  when "def" then Option::Some(TokenKind::Def)
  when "end" then Option::Some(TokenKind::End)
  when "do" then Option::Some(TokenKind::Do)
  when "if" then Option::Some(TokenKind::If)
  when "elsif" then Option::Some(TokenKind::Elsif)
  when "else" then Option::Some(TokenKind::Else)
  when "while" then Option::Some(TokenKind::While)
  when "for" then Option::Some(TokenKind::For)
  when "in" then Option::Some(TokenKind::In)
  when "loop" then Option::Some(TokenKind::Loop)
  when "match" then Option::Some(TokenKind::Match)
  when "when" then Option::Some(TokenKind::When)
  when "then" then Option::Some(TokenKind::Then)
  when "unless" then Option::Some(TokenKind::Unless)
  when "until" then Option::Some(TokenKind::Until)
  when "let" then Option::Some(TokenKind::Let)
  when "mut" then Option::Some(TokenKind::Mut)
  when "var" then Option::Some(TokenKind::Mut)
  when "inout" then Option::Some(TokenKind::Inout)
  when "sink" then Option::Some(TokenKind::Sink)
  when "set" then Option::Some(TokenKind::Set)
  when "resource" then Option::Some(TokenKind::Resource)
  when "deinit" then Option::Some(TokenKind::Deinit)
  when "return" then Option::Some(TokenKind::Return)
  when "break" then Option::Some(TokenKind::Break)
  when "continue" then Option::Some(TokenKind::Next)
  when "next" then Option::Some(TokenKind::Next)
  when "struct" then Option::Some(TokenKind::Struct)
  when "enum" then Option::Some(TokenKind::Enum)
  when "trait" then Option::Some(TokenKind::Trait)
  when "impl" then Option::Some(TokenKind::Impl)
  when "module" then Option::Some(TokenKind::Module)
  when "mod" then Option::Some(TokenKind::Module)
  when "use" then Option::Some(TokenKind::Use)
  when "as" then Option::Some(TokenKind::As)
  when "pub" then Option::Some(TokenKind::Pub)
  when "private" then Option::Some(TokenKind::Private)
  when "macro" then Option::Some(TokenKind::Macro)
  when "where" then Option::Some(TokenKind::Where)
  when "true" then Option::Some(TokenKind::True)
  when "false" then Option::Some(TokenKind::False)
  when "nil" then Option::Some(TokenKind::Nil)
  when "self" then Option::Some(TokenKind::Self_)
  when "Self" then Option::Some(TokenKind::SelfType)
  when "super" then Option::Some(TokenKind::Ident("super".to_string()))
  when "crate" then Option::Some(TokenKind::Ident("crate".to_string()))
  when "move" then Option::Some(TokenKind::TkMove)
  when "copy" then Option::Some(TokenKind::TkCopy)
  when "drop" then Option::Some(TokenKind::TkDrop)
  when "own" then Option::Some(TokenKind::TkOwn)
  when "ref" then Option::Some(TokenKind::TkRef)
  when "pre" then Option::Some(TokenKind::Pre)
  when "post" then Option::Some(TokenKind::Post)
  when "invariant" then Option::Some(TokenKind::Invariant)
  when "cap" then Option::Some(TokenKind::Cap)
  when "unsafe" then Option::Some(TokenKind::Unsafe)
  when "rationale" then Option::Some(TokenKind::Rationale)
  when "budget" then Option::Some(TokenKind::Budget)
  when "edition" then Option::Some(TokenKind::Edition)
  when "requires" then Option::Some(TokenKind::Requires)
  when "ensures" then Option::Some(TokenKind::Ensures)
  when "effect" then Option::Some(TokenKind::Effect)
  when "pure" then Option::Some(TokenKind::Pure)
  when "async" then Option::Some(TokenKind::Async)
  when "await" then Option::Some(TokenKind::Await)
  when "defer" then Option::Some(TokenKind::Defer)
  when "try" then Option::Some(TokenKind::Try)
  when "catch" then Option::Some(TokenKind::Catch)
  when "finally" then Option::Some(TokenKind::Finally)
  when "guard" then Option::Some(TokenKind::Guard)
  when "handle" then Option::Some(TokenKind::Handle)
  when "with" then Option::Some(TokenKind::With)
  when "is" then Option::Some(TokenKind::Is)
  when "implies" then Option::Some(TokenKind::Implies)
  when "comptime" then Option::Some(TokenKind::Comptime)
  when "const" then Option::Some(TokenKind::Const)
  when "static" then Option::Some(TokenKind::Static)
  when "type" then Option::Some(TokenKind::Type)
  when "typealias" then Option::Some(TokenKind::Type)
  when "alias" then Option::Some(TokenKind::Alias)
  when "extern" then Option::Some(TokenKind::Extern)
  when "inline" then Option::Some(TokenKind::Inline)
  else Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Token Classification
# ———————————————————————————————————————————————————————————————

def is_expr_start(kind: TokenKind) -> Bool
  match kind
  when TokenKind::IntLit(_) then return true
  when TokenKind::FloatLit(_) then return true
  when TokenKind::StringLit(_) then return true
  when TokenKind::CharLit(_) then return true
  when TokenKind::Ident(_) then return true
  when TokenKind::True then return true
  when TokenKind::False then return true
  when TokenKind::Nil then return true
  when TokenKind::Self_ then return true
  when TokenKind::LParen then return true
  when TokenKind::LBracket then return true
  when TokenKind::LBrace then return true
  when TokenKind::Bang then return true
  when TokenKind::Minus then return true
  when TokenKind::Amp then return true
  when TokenKind::AmpMut then return true
  when TokenKind::If then return true
  when TokenKind::Unless then return true
  when TokenKind::Match then return true
  when TokenKind::Do then return true
  when TokenKind::Try then return true
  when TokenKind::Await then return true
  when TokenKind::TkMove then return true
  when TokenKind::TkCopy then return true
  when TokenKind::Loop then return true
  when TokenKind::Comptime then return true
  when TokenKind::Handle then return true
  when TokenKind::Unsafe then return true
  when TokenKind::Pipe then return true
  when TokenKind::Or then return true
  when TokenKind::Star then return true
  when TokenKind::Async then return true
  when TokenKind::Module then return true
  when TokenKind::Pre then return true
  when TokenKind::Post then return true
  when TokenKind::Effect then return true
  when TokenKind::Pure then return true
  when TokenKind::TkRef then return true
  when TokenKind::TkCopy then return true
  when TokenKind::Inline then return true
  when TokenKind::Edition then return true
  when TokenKind::Inout then return true
  when TokenKind::Sink then return true
  when TokenKind::Set then return true
  when TokenKind::Resource then return true
  when TokenKind::Deinit then return true
  when _ then return false
  end  end
end

def is_stmt_start(kind: TokenKind) -> Bool
  if is_expr_start(kind) then
    return true
  else
    match kind
    when TokenKind::Let then return true
    when TokenKind::Mut then return true
    when TokenKind::Return then return true
    when TokenKind::Break then return true
    when TokenKind::Next then return true
    when TokenKind::While then return true
    when TokenKind::Until then return true
    when TokenKind::For then return true
    when TokenKind::If then return true
    when TokenKind::Unless then return true
    when TokenKind::Match then return true
    when TokenKind::Unsafe then return true
    when TokenKind::Defer then return true
    when TokenKind::Guard then return true
    when TokenKind::Loop then return true
    when TokenKind::Handle then return true
    when TokenKind::Const then return true
    when TokenKind::Static then return true
    when TokenKind::Type then return true
    when TokenKind::At then return true
    when _ then return false
    end
  end
end

def is_item_start(kind: TokenKind) -> Bool
  match kind
  when TokenKind::Def then return true
  when TokenKind::Struct then return true
  when TokenKind::Resource then return true
  when TokenKind::Enum then return true
  when TokenKind::Trait then return true
  when TokenKind::Impl then return true
  when TokenKind::Module then return true
  when TokenKind::Use then return true
  when TokenKind::Macro then return true
  when TokenKind::Cap then return true
  when TokenKind::Rationale then return true
  when TokenKind::Edition then return true
  when TokenKind::Const then return true
  when TokenKind::Let then return true
  when TokenKind::Static then return true
  when TokenKind::Type then return true
  when TokenKind::Extern then return true
  when TokenKind::Pub then return true
  when TokenKind::Private then return true
  when TokenKind::Async then return true
  when TokenKind::Unsafe then return true
  when TokenKind::Pure then return true
  when TokenKind::Inline then return true
  when _ then return false
  end  end
end

def is_doc_comment(kind: TokenKind) -> Bool
  match kind
  when TokenKind::DocComment(_) then return true
  when _ then return false
  end  end
end
