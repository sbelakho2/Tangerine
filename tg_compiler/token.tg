# Tangerine Compiler — Token Definitions
# Self-hosting compiler written in Tangerine
#
# This module defines all tokens for the Tangerine language including:
# - Core language constructs (def, struct, enum, trait, impl)
# - Memory safety primitives (mut, &, &mut, move, copy)
# - Agentic features (pre, post, invariant, cap, requires, budget)
# - Modern control flow (async, await, yield, defer, try, catch)
# - Compile-time features (comptime, const, static, type)

use std::core::{Option, Result}

# ———————————————————————————————————————————————————————————————
# Source Location
# ———————————————————————————————————————————————————————————————

struct Span
  file: String
  start: Int
  end_pos: Int
end

def span_new(start: Int, end_pos: Int) -> Span
  Span { start: start, end_pos: end_pos }
end

def span_to_line_col(span: &Span, source: &String) -> (Int, Int, Int, Int)
  mut start_line = 1
  mut start_col = 1
  mut end_line = 1
  mut end_col = 1
  mut i = 0
  while i < source.len() do
    if i == span.start then
      start_line = end_line
      start_col = end_col
    end
    if i == span.end_pos then
      break
    end
    if source.char_at(i) == '\n' then
      end_line = end_line + 1
      end_col = 1
    else
      end_col = end_col + 1
    end
    i = i + 1
  end
  (start_line, start_col, end_line, end_col)
end

def span_dummy() -> Span
  Span { start: 0, end_pos: 0 }
end

def span_start(span: &Span) -> Int
  span.start
end

def span_end(span: &Span) -> Int
  span.end_pos
end

def span_merge(a: Span, b: Span) -> Span
  let s = if a.start < b.start then a.start else b.start end
  let e = if a.end_pos > b.end_pos then a.end_pos else b.end_pos end
  Span { start: s, end_pos: e }
end

# ———————————————————————————————————————————————————————————————
# Token Kinds
# ———————————————————————————————————————————————————————————————

enum TokenKind
  # Literals
  IntLit(Int)
  FloatLit(Float)
  StringLit(String)
  CharLit(Char)
  
  # Identifier
  Ident(String)
  
  # Doc comment (## ... until newline)
  DocComment(String)
  
  # Core Keywords
  Def
  End
  Do
  If
  Elsif
  Else
  While
  For
  In
  Loop
  Match
  When
  Then
  Unless
  Until
  Let
  Mut
  Return
  Break
  Next
  Struct
  Enum
  Trait
  Impl
  Module
  Use
  As
  Pub
  Private
  Macro
  Where
  True
  False
  Nil
  Self_
  SelfType
  
  # Memory Safety Keywords
  TkMove
  TkCopy
  TkDrop
  TkOwn
  TkRef
  TkRefMut
  
  # Agentic Keywords
  Pre
  Post
  Invariant
  Cap
  Unsafe
  Rationale
  Budget
  Edition
  Requires
  Ensures
  Effect
  Pure
  
  # Modern Language Keywords
  Async
  Await
  Yield
  Defer
  Try
  Catch
  Finally
  Guard
  Handle
  With
  Is
  Implies
  Comptime
  Const
  Static
  Type
  Alias
  Extern
  Inline
  
  # Operators
  Plus
  Minus
  Star
  Slash
  Percent
  Eq
  EqEq
  BangEq
  Lt
  Gt
  LtEq
  GtEq
  And
  Or
  Bang
  Amp
  AmpMut
  Pipe
  PipeArrow
  Arrow
  FatArrow
  Question
  ColonColon
  Dot
  DotDot
  DotDotEq
  Tilde
  Caret
  DoubleStar
  Shl
  Shr
  PlusEq
  MinusEq
  StarEq
  SlashEq
  PercentEq
  AmpEq
  PipeEq
  CaretEq
  ShlEq
  ShrEq
  
  # Delimiters
  LParen
  RParen
  LBracket
  RBracket
  LBrace
  RBrace
  
  # Punctuation
  Colon
  Semicolon
  Comma
  At
  Hash
  
  # Special
  Newline
  Eof
  Error(String)
end

struct Token
  kind: TokenKind
  span: Span
end

def token_new(kind: TokenKind, span: Span) -> Token
  Token { kind: kind, span: span }
end

# ———————————————————————————————————————————————————————————————
# Keyword Lookup (hash map based for O(1) amortized lookup)
# ———————————————————————————————————————————————————————————————

mut KEYWORD_MAP: Option[Map[String, TokenKind]] = Option::None

def init_keyword_map() -> Map[String, TokenKind]
  mut m = Map::new()
  m.insert("def", TokenKind::Def)
  m.insert("end", TokenKind::End)
  m.insert("do", TokenKind::Do)
  m.insert("if", TokenKind::If)
  m.insert("elsif", TokenKind::Elsif)
  m.insert("else", TokenKind::Else)
  m.insert("while", TokenKind::While)
  m.insert("for", TokenKind::For)
  m.insert("in", TokenKind::In)
  m.insert("loop", TokenKind::Loop)
  m.insert("match", TokenKind::Match)
  m.insert("when", TokenKind::When)
  m.insert("then", TokenKind::Then)
  m.insert("unless", TokenKind::Unless)
  m.insert("until", TokenKind::Until)
  m.insert("let", TokenKind::Let)
  m.insert("mut", TokenKind::Mut)
  m.insert("return", TokenKind::Return)
  m.insert("break", TokenKind::Break)
  m.insert("next", TokenKind::Next)
  m.insert("struct", TokenKind::Struct)
  m.insert("enum", TokenKind::Enum)
  m.insert("trait", TokenKind::Trait)
  m.insert("impl", TokenKind::Impl)
  m.insert("module", TokenKind::Module)
  m.insert("mod", TokenKind::Module)
  m.insert("use", TokenKind::Use)
  m.insert("as", TokenKind::As)
  m.insert("pub", TokenKind::Pub)
  m.insert("private", TokenKind::Private)
  m.insert("macro", TokenKind::Macro)
  m.insert("where", TokenKind::Where)
  m.insert("true", TokenKind::True)
  m.insert("false", TokenKind::False)
  m.insert("nil", TokenKind::Nil)
  m.insert("self", TokenKind::Self_)
  m.insert("fn", TokenKind::Def)
  m.insert("Self", TokenKind::SelfType)
  m.insert("super", TokenKind::Ident("super".to_string()))
  m.insert("crate", TokenKind::Ident("crate".to_string()))
  m.insert("move", TokenKind::TkMove)
  m.insert("copy", TokenKind::TkCopy)
  m.insert("drop", TokenKind::TkDrop)
  m.insert("own", TokenKind::TkOwn)
  m.insert("ref", TokenKind::TkRef)
  m.insert("pre", TokenKind::Pre)
  m.insert("post", TokenKind::Post)
  m.insert("invariant", TokenKind::Invariant)
  m.insert("cap", TokenKind::Cap)
  m.insert("unsafe", TokenKind::Unsafe)
  m.insert("rationale", TokenKind::Rationale)
  m.insert("budget", TokenKind::Budget)
  m.insert("edition", TokenKind::Edition)
  m.insert("requires", TokenKind::Requires)
  m.insert("ensures", TokenKind::Ensures)
  m.insert("effect", TokenKind::Effect)
  m.insert("pure", TokenKind::Pure)
  m.insert("async", TokenKind::Async)
  m.insert("await", TokenKind::Await)
  m.insert("yield", TokenKind::Yield)
  m.insert("defer", TokenKind::Defer)
  m.insert("try", TokenKind::Try)
  m.insert("catch", TokenKind::Catch)
  m.insert("finally", TokenKind::Finally)
  m.insert("guard", TokenKind::Guard)
  m.insert("handle", TokenKind::Handle)
  m.insert("with", TokenKind::With)
  m.insert("is", TokenKind::Is)
  m.insert("implies", TokenKind::Implies)
  m.insert("comptime", TokenKind::Comptime)
  m.insert("const", TokenKind::Const)
  m.insert("static", TokenKind::Static)
  m.insert("type", TokenKind::Type)
  m.insert("alias", TokenKind::Alias)
  m.insert("extern", TokenKind::Extern)
  m.insert("inline", TokenKind::Inline)
  m
end

def keyword_from_str(s: String) -> Option[TokenKind]
  let map = init_keyword_map()
  map.get(s)
end

# ———————————————————————————————————————————————————————————————
# Token Classification
# ———————————————————————————————————————————————————————————————

def is_expr_start(kind: TokenKind) -> Bool
  match kind
  when TokenKind::IntLit(_) then true
  when TokenKind::FloatLit(_) then true
  when TokenKind::StringLit(_) then true
  when TokenKind::CharLit(_) then true
  when TokenKind::Ident(_) then true
  when TokenKind::True then true
  when TokenKind::False then true
  when TokenKind::Nil then true
  when TokenKind::Self_ then true
  when TokenKind::LParen then true
  when TokenKind::LBracket then true
  when TokenKind::LBrace then true
  when TokenKind::Bang then true
  when TokenKind::Minus then true
  when TokenKind::Amp then true
  when TokenKind::AmpMut then true
  when TokenKind::If then true
  when TokenKind::Unless then true
  when TokenKind::Match then true
  when TokenKind::Do then true
  when TokenKind::Try then true
  when TokenKind::Await then true
  when TokenKind::Yield then true
  when TokenKind::TkMove then true
  when TokenKind::TkCopy then true
  when TokenKind::Loop then true
  when TokenKind::Comptime then true
  when TokenKind::Handle then true
  when TokenKind::Unsafe then true
  when TokenKind::Pipe then true
  when TokenKind::Or then true
  when TokenKind::Star then true
  when TokenKind::Async then true
  when TokenKind::Module then true
  when TokenKind::Pre then true
  when TokenKind::Post then true
  when TokenKind::Effect then true
  when TokenKind::Pure then true
  when TokenKind::TkRef then true
  when TokenKind::TkCopy then true
  when TokenKind::Inline then true
  when TokenKind::Edition then true
  when _ then false
  end
end

def is_stmt_start(kind: TokenKind) -> Bool
  if is_expr_start(kind) then
    true
  else
    match kind
    when TokenKind::Let then true
    when TokenKind::Mut then true
    when TokenKind::Return then true
    when TokenKind::Break then true
    when TokenKind::Next then true
    when TokenKind::While then true
    when TokenKind::Until then true
    when TokenKind::For then true
    when TokenKind::If then true
    when TokenKind::Unless then true
    when TokenKind::Match then true
    when TokenKind::Unsafe then true
    when TokenKind::Defer then true
    when TokenKind::Guard then true
    when TokenKind::Loop then true
    when TokenKind::Handle then true
    when TokenKind::Const then true
    when TokenKind::Static then true
    when TokenKind::Type then true
    when TokenKind::At then true
    when _ then false
    end
  end
end

def is_item_start(kind: TokenKind) -> Bool
  match kind
  when TokenKind::Def then true
  when TokenKind::Struct then true
  when TokenKind::Enum then true
  when TokenKind::Trait then true
  when TokenKind::Impl then true
  when TokenKind::Module then true
  when TokenKind::Use then true
  when TokenKind::Macro then true
  when TokenKind::Cap then true
  when TokenKind::Rationale then true
  when TokenKind::Edition then true
  when TokenKind::Const then true
  when TokenKind::Static then true
  when TokenKind::Type then true
  when TokenKind::Extern then true
  when TokenKind::Pub then true
  when TokenKind::Private then true
  when TokenKind::Async then true
  when TokenKind::Unsafe then true
  when TokenKind::Pure then true
  when TokenKind::Inline then true
  when _ then false
  end
end

def is_doc_comment(kind: TokenKind) -> Bool
  match kind
  when TokenKind::DocComment(_) then true
  when _ then false
  end
end
