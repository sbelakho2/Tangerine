## tg_compiler::template — Project scaffolding and templates
## Create new Tangerine projects from templates.
## Spec: §tooling.template

module tg_compiler::template

use std::core::{Option, Result, Display}
use std::collections::{Map, Array}
use std::fs

# ─── Template types ──────────────────────────────────────────────────

pub enum ProjectTemplate
  Library            ## Reusable library crate
  Cli                ## Command-line application
  WebService         ## HTTP/REST web service
  WasmLib            ## WebAssembly library
  WasmComponent      ## WASM Component Model
  Plugin             ## Tangerine plugin
  Workspace          ## Multi-crate workspace
  Custom(String)     ## User-defined template path
end

impl Display for ProjectTemplate
  def fmt(self: Self) -> String
    match self
    when Library then "library"
    when Cli then "cli"
    when WebService then "web-service"
    when WasmLib then "wasm-lib"
    when WasmComponent then "wasm-component"
    when Plugin then "plugin"
    when Workspace then "workspace"
    when ProjectTemplate::Custom(name) then "custom:" + name
    end
  end
end

# ─── Scaffold configuration ─────────────────────────────────────────

pub struct ScaffoldConfig
  pub name: String
  pub template: ProjectTemplate
  pub author: Option[String]
  pub license: String
  pub edition: String
  pub description: Option[String]
  pub vcs: TemplateVcsInit
end

pub enum TemplateVcsInit
  VcsGit
  VcsNone
end

impl ScaffoldConfig
  pub def default(name: str) -> ScaffoldConfig
    ScaffoldConfig {
      name: name.to_string(),
      template: ProjectTemplate::Library,
      author: std::env::get_env("USER".to_string()),
      license: "MIT".to_string(),
      edition: "2024".to_string(),
      description: Option::None,
      vcs: TemplateVcsInit::VcsGit,
    }
  end
end

# ─── Scaffolder ──────────────────────────────────────────────────────

pub struct Scaffolder
  config: ScaffoldConfig
  root: String
end

impl Scaffolder
  pub def new(config: ScaffoldConfig) -> Scaffolder
    let root = config.name.clone()
    Scaffolder { config: config, root: root }
  end

  pub def scaffold(self) -> Result[Unit, TemplateError]
    ## Refuse to overwrite existing project directory
    if fs::path_exists(self.root.clone()) then
      return Err(TemplateError::IoError(
        "directory already exists: " + self.root.clone() + " (use --force to overwrite)"
      ))
    end

    ## Create root directory
    fs::create_dir_all(self.root.clone())
      .map_err(|e| TemplateError::IoError(e.to_string()))?

    ## Generate Tangerine.toml
    self.write_manifest()?

    ## Generate source files based on template
    match self.config.template
    when Library then self.scaffold_library()?
    when Cli then self.scaffold_cli()?
    when WebService then self.scaffold_web_service()?
    when WasmLib then self.scaffold_wasm_lib()?
    when WasmComponent then self.scaffold_wasm_component()?
    when Plugin then self.scaffold_plugin()?
    when Workspace then self.scaffold_workspace()?
    when ProjectTemplate::Custom(path) then self.scaffold_from_custom(path)?
    end

    ## Generate common files
    self.write_gitignore()?
    self.write_readme()?

    ## Initialize VCS
    match self.config.vcs
    when TemplateVcsInit::VcsGit then self.init_git()?
    when TemplateVcsInit::VcsNone then ()
    end

    Ok(())
  end

  def write_manifest(self) -> Result[Unit, TemplateError]
    let content = _manifest_template(&self.config)
    _write_file(&self.root, "Tangerine.toml", &content)
  end

  def scaffold_library(self) -> Result[Unit, TemplateError]
    fs::create_dir_all(self.root.clone() + "/src")
      .map_err(|e| TemplateError::IoError(e.to_string()))?
    fs::create_dir_all(self.root.clone() + "/tests")
      .map_err(|e| TemplateError::IoError(e.to_string()))?

    _write_file(&self.root, "src/lib.tg", &_lib_template(&self.config.name))?
    _write_file(&self.root, "tests/lib_test.tg", &_lib_test_template(&self.config.name))
  end

  def scaffold_cli(self) -> Result[Unit, TemplateError]
    fs::create_dir_all(self.root.clone() + "/src")
      .map_err(|e| TemplateError::IoError(e.to_string()))?

    _write_file(&self.root, "src/main.tg", &_cli_template(&self.config.name))?
    _write_file(&self.root, "src/lib.tg", &_lib_template(&self.config.name))
  end

  def scaffold_web_service(self) -> Result[Unit, TemplateError]
    fs::create_dir_all(self.root.clone() + "/src")
      .map_err(|e| TemplateError::IoError(e.to_string()))?
    fs::create_dir_all(self.root.clone() + "/tests")
      .map_err(|e| TemplateError::IoError(e.to_string()))?

    _write_file(&self.root, "src/main.tg", &_web_service_template(&self.config.name))?
    _write_file(&self.root, "src/routes.tg", &_routes_template())?
    _write_file(&self.root, "src/handlers.tg", &_handlers_template())
  end

  def scaffold_wasm_lib(self) -> Result[Unit, TemplateError]
    fs::create_dir_all(self.root.clone() + "/src")
      .map_err(|e| TemplateError::IoError(e.to_string()))?
    _write_file(&self.root, "src/lib.tg", &_wasm_lib_template(&self.config.name))
  end

  def scaffold_wasm_component(self) -> Result[Unit, TemplateError]
    fs::create_dir_all(self.root.clone() + "/src")
      .map_err(|e| TemplateError::IoError(e.to_string()))?
    fs::create_dir_all(self.root.clone() + "/wit")
      .map_err(|e| TemplateError::IoError(e.to_string()))?
    _write_file(&self.root, "src/lib.tg", &_wasm_component_template(&self.config.name))?
    _write_file(&self.root, "wit/world.wit", &_wit_template(&self.config.name))
  end

  def scaffold_plugin(self) -> Result[Unit, TemplateError]
    fs::create_dir_all(self.root.clone() + "/src")
      .map_err(|e| TemplateError::IoError(e.to_string()))?
    _write_file(&self.root, "src/lib.tg", &_plugin_template(&self.config.name))
  end

  def scaffold_workspace(self) -> Result[Unit, TemplateError]
    _write_file(&self.root, "Tangerine.toml", &_workspace_manifest(&self.config))?
    fs::create_dir_all(self.root.clone() + "/crates")
      .map_err(|e| TemplateError::IoError(e.to_string()))
  end

  def scaffold_from_custom(self, template_path: str) -> Result[Unit, TemplateError]
    ## Copy template directory contents, substituting variables
    if !fs::path_exists(template_path.to_string()) then
      return Err(TemplateError::TemplateNotFound(template_path.to_string()))
    end
    _copy_template_dir(template_path, &self.root, &self.config)
  end

  def write_gitignore(self) -> Result[Unit, TemplateError]
    let content = "# Tangerine build artifacts\n/target/\n*.o\n*.a\n*.so\n*.dylib\n\n# IDE\n.idea/\n.vscode/\n*.swp\n\n# OS\n.DS_Store\nThumbs.db\n"
    _write_file(&self.root, ".gitignore", content)
  end

  def write_readme(self) -> Result[Unit, TemplateError]
    let desc = self.config.description.clone().unwrap_or("A Tangerine project".to_string())
    let content = "# " + &self.config.name + "\n\n" + &desc + "\n\n## Build\n\n```sh\ntangerine build\n```\n\n## Test\n\n```sh\ntangerine test\n```\n"
    _write_file(&self.root, "README.md", content)
  end

  def init_git(self) -> Result[Unit, TemplateError]
    ## Shell out to git init
    match std::process::run("git", ["init", &self.root])
    when Ok(out) then
      if out.status.success then
        Ok(())
      else
        Err(TemplateError::IoError("git init failed with exit code " + out.status.code.to_string()))
      end
    when Err(e) then Err(TemplateError::IoError("git init failed: " + e.to_string() + " (is git installed and in PATH?)"))
    end
  end
end

# ─── Errors ──────────────────────────────────────────────────────────

pub enum TemplateError
  IoError(String)
  TemplateNotFound(String)
  InvalidConfig(String)
end

impl Display for TemplateError
  def fmt(self: Self) -> String
    match self
    when IoError(msg) then "template I/O error: " + msg
    when TemplateNotFound(name) then "template not found: " + name
    when InvalidConfig(msg) then "invalid template config: " + msg
    end
  end
end

# ─── Template strings ────────────────────────────────────────────────

def _manifest_template(config: ScaffoldConfig) -> String
  var s = "[package]\n"
  s = s + "name = \"" + &config.name + "\"\n"
  s = s + "version = \"0.1.0\"\n"
  s = s + "edition = \"" + &config.edition + "\"\n"
  match config.author
  when Option::Some(author) then s = s + "authors = [\"" + author + "\"]\n"
  when Option::None then ()
  end
  s = s + "license = \"" + &config.license + "\"\n"
  match config.description
  when Option::Some(desc) then s = s + "description = \"" + desc + "\"\n"
  when Option::None then ()
  end
  s = s + "\n[dependencies]\n"
  s
end

def _workspace_manifest(config: ScaffoldConfig) -> String
  "[workspace]\nmembers = [\n  \"crates/*\",\n]\n\n[workspace.package]\nedition = \"" + &config.edition + "\"\nlicense = \"" + &config.license + "\"\n"
end

def _lib_template(name: str) -> String
  "## " + name + " library\n\nmodule " + name + "\n\npub def hello() -> String\n  \"Hello from " + name + "!\"\nend\n\nend ## module " + name + "\n"
end

def _lib_test_template(name: str) -> String
  "use std::test::{describe, it, expect}\nuse " + name + "\n\ndescribe(\"" + name + "\") do\n  it(\"returns a greeting\") do\n    expect(" + name + "::hello()).to_eq(\"Hello from " + name + "!\")\n  end\nend\n"
end

def _cli_template(name: str) -> String
  "## " + name + " — command-line application\n\nuse std::cli::{App, Arg, Command}\nuse " + name + "\n\ndef main() -> Int\n  let app = App.new(\"" + name + "\")\n    .version(\"0.1.0\")\n    .author(\"Your Name\")\n    .about(\"A Tangerine CLI application\")\n    .arg(Arg.new(\"verbose\").short('v').long(\"verbose\").help(\"Enable verbose output\"))\n\n  let matches = app.parse(std::env::args())\n  println(" + name + "::hello())\n  0\nend\n"
end

def _web_service_template(name: str) -> String
  "## " + name + " — web service\n\nuse std::http::{Server, Router}\nuse " + name + "::routes\n\ndef main() -> Int\n  let router = routes::configure(Router.new())\n  let server = Server.bind(\"0.0.0.0:8080\")\n  println(\"Listening on http://0.0.0.0:8080\")\n  server.serve(router)\n  0\nend\n"
end

def _routes_template() -> String
  "use std::http::{Router, Method}\nuse super::handlers\n\npub def configure(router: Router) -> Router\n  router\n    .route(Method::Get, \"/\", handlers::index)\n    .route(Method::Get, \"/health\", handlers::health)\nend\n"
end

def _handlers_template() -> String
  "use std::http::{Request, Response, StatusCode}\n\npub def index(req: Request) -> Response\n  Response.ok().body(\"Hello, Tangerine!\")\nend\n\npub def health(req: Request) -> Response\n  Response.ok().json(\"{\\\"status\\\": \\\"ok\\\"}\")\nend\n"
end

def _wasm_lib_template(name: str) -> String
  "## " + name + " — WebAssembly library\n\nmodule " + name + "\n\n@wasm_export\npub def greet(name: String) -> String\n  \"Hello, \" + name + \"!\"\nend\n\n@wasm_export\npub def add(a: i32, b: i32) -> i32\n  a + b\nend\n\nend ## module " + name + "\n"
end

def _wasm_component_template(name: str) -> String
  "## " + name + " — WASM Component\n\nuse std::wasm::component\n\nmodule " + name + "\n\n@component_export(\"" + name + "\")\npub def process(input: String) -> String\n  \"Processed: \" + input\nend\n\nend ## module " + name + "\n"
end

def _wit_template(name: str) -> String
  "package tangerine:" + name + "\n\nworld " + name + " {\n  export process: func(input: string) -> string\n}\n"
end

def _plugin_template(name: str) -> String
  "## " + name + " — Tangerine plugin\n\nuse std::plugin::{Plugin, PluginContext}\n\nmodule " + name + "\n\npub struct " + name.capitalize() + "Plugin end\n\nimpl Plugin for " + name.capitalize() + "Plugin\n  def name(self) -> String\n    \"" + name + "\"\n  end\n\n  def version(self) -> String\n    \"0.1.0\"\n  end\n\n  def init(inout self: Self, inout ctx: PluginContext) -> Result[Unit, String]\n    ctx.register_command(\"hello\", |_args| {\n      println(\"Hello from " + name + " plugin!\")\n      Ok(())\n    })\n    Ok(())\n  end\nend\n\nend ## module " + name + "\n"
end

def _write_file(root: str, rel_path: str, content: str) -> Result[Unit, TemplateError]
  let full_path = root.to_string() + "/" + rel_path
  fs::write_string(full_path, content.to_string())
    .map_err(|e| TemplateError::IoError(e.to_string()))
end

def _copy_template_dir(src: str, dst: str, config: ScaffoldConfig) -> Result[Unit, TemplateError]
  match fs::read_dir(src.to_string())
  when Ok(entries) then
    for entry in entries do
      let dst_path = dst.to_string() + "/" + &entry.name
      if entry.is_dir then
        fs::create_dir_all(dst_path.clone())
          .map_err(|e| TemplateError::IoError(e.to_string()))?
        _copy_template_dir(&entry.path, &dst_path, config)?
      else
        let content = fs::read_to_string(entry.path)
          .map_err(|e| TemplateError::IoError(e.to_string()))?
        let expanded = _expand_variables(&content, config)
        fs::write_string(dst_path, expanded)
          .map_err(|e| TemplateError::IoError(e.to_string()))?
      end
    end
    Ok(())
  when Err(e) then Err(TemplateError::IoError(e.to_string()))
  end  end  end
end

def _expand_variables(content: str, config: ScaffoldConfig) -> String
  content
    .replace("{{name}}", &config.name)
    .replace("{{edition}}", &config.edition)
    .replace("{{license}}", &config.license)
    .replace("{{author}}", &config.author.clone().unwrap_or("".to_string()))
end

end ## module tg_compiler::template
