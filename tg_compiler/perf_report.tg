# Tangerine Compiler — per-function performance report (audit §44)
# Self-hosting compiler written in Tangerine
#
# ONE compact PerfReport per function of an OPTIMIZED MirProgram, plus
# the LIR view when the allocation artifacts are available — the
# per-function introspection fields over the REAL post-optimization
# artifacts: "inspect actual optimized MIR/LIR; then optimization work
# is directed by actual causes." The module counts what the artifacts
# carry and returns zeros — never invented numbers — for every surface
# they do NOT record (the sibling discipline of abi_report.tg).
#
# PIPELINE ARTIFACTS: optimize_mir_verified (mir.tg) batches DCE, copy
# propagation, constant folding, dead-store elimination, CFG
# simplification, strength reduction, and (opt >= 2) GVN, LICM,
# eliminate_bounds_checks, then simplify_moves + final DCE, then (opt
# >= 2) escape_analysis and (opt >= 3) apply_pgo_optimizations (a
# FILE-fed pass — PGO counts never ride the program). NO pass records
# statistics: each is an in-out Unit rewrite and the verifier
# checkpoints journal only diagnostics, so pass-PRODUCED metrics are
# unrecoverable from the optimized program and stay 0 here (documented
# per field): the bounds checks eliminate_bounds_checks PROVED AND
# REMOVED (provable MirAssert/BoundsCheck terms are rewritten to
# MirGoto — mir.tg:19641), the inline decisions (an inlined site
# becomes a plain MirGoto; the residue is only the "_inlined" local
# suffix), the spill/reload decisions (LIR-allocator data),
# escape_analysis's heap-to-stack promotions and the PGO counts.
# Nonzero counts measure the SURVIVING optimized body: the remaining
# BoundsCheck asserts, call sites and operand traffic.
#
# COUNTING RULES (field by field — the report anchors):
#   heap_allocations      — the §11 allocating MirCall sites + the §11
#     string-concat sites (the two site kinds the §11 DIRECT scan
#     classifies allocating). The call mirror reuses the machinery's
#     own predicates (effect_summary_of_intrinsic /
#     effect_summary_of_extern_name / intrinsic_id_of_call — the
#     decision path of mir_effect_classify_call, mir.tg:28736): a
#     STAMPED intrinsic allocates iff its record's may_allocate is
#     true; an unstamped named callee allocates iff it has NO body in
#     this program and the bodyless route (intrinsic-name router, then
#     extern-name seeds) says may_allocate — unknown bodyless and
#     INDIRECT callees count (the §11 fail-closed rule). An in-program
#     callee never counts at the SITE (its allocations land on the
#     callee's own report). The concat mirror is the Add-over-strings
#     arm of mir_effect_scan_function (mir.tg:28817). MirDeinit and
#     effect performs are not MirCall sites and never count. The count
#     is an UPPER BOUND (the fail-closed arms may over-count an unknown
#     callee) — its PerfFact row is StaticUpperBound.
#   arena_allocations      — (item 40a) MirCall sites whose §11 effect
#     RECORD carries the arena capability (capability_id_arena,
#     types.tg:9595 — "a bounded bump-arena allocation, which is NOT a
#     heap allocation"). The typed capability predicate replaces the
#     old callee-name "arena"/"bump" substring heuristic. NO §11 record
#     currently carries the capability (the IntrinsicId vocabulary has
#     no bump-arena op and codegen emits _tg_bump_alloc directly,
#     never as a MirCall), so the measured count is 0 today — an EXACT
#     typed-walk zero, not "not recorded". Its row is StaticExact.
#   escapes                — MirRef rvalue sites + call-ARGUMENT
#     occurrences that are BARE local places (no projections, all
#     operand forms incl. the Place form) — the documented
#     approximation of escape_analysis's ArgEscape sites. The walk is
#     conservative (it counts address-taken and bare-arg sites, a
#     superset of the promotions escape_analysis actually performs), so
#     its row is StaticUpperBound.
#   stack_bytes            — 0 from the MIR (a frame size exists only
#     after LIR allocation: LirAlloc.frame_bytes fills this in the
#     LIR view).
#   bounds_checks          — MirAssert terminators with an
#     AssertMessage::BoundsCheck message — the checks that SURVIVED
#     the optimizer.
#   proven_removed_bounds  — 0: the optimizer records no per-function
#     counter; nonzero needs a pass-side journal.
#   copies / moves         — MirCopy + MirRead operand occurrences
#     (copies) / MirMovePlace occurrences (moves) over every operand
#     position of the function's statements and terminator. MirConsume
#     operands are in no audit field and are not counted.
#   drops                  — MirDeinit terminators.
#   retain_release         — (item 40a) the Arc/Rc reference-count
#     operations. NO such semantic operation exists in the compiler's
#     operation vocabulary: ids.tg's IntrinsicId carries no
#     Retain/Release/Arc*/Rc* variant, the checker stamps none, and
#     ArcStrong's clone/drop lower as ordinary impl-method calls. The
#     field stays 0 and the view emits NO RetainRelease row (the
#     documented no-semantic-op rule). The old callee-name
#     retain/"release" substring heuristic is REMOVED; when Arc/Rc
#     operation ids land, a typed predicate over them re-enables the
#     count and the row.
#   clones                 — (item 40a) calls to the derived/Clone
#     semantic OPERATION: the call's stamped intrinsic is
#     IntrinsicId::Clone, or — for an unstamped named callee — the
#     semantic intrinsic-name router (intrinsic_id_of_call,
#     types.tg:14414) classifies the callee as IntrinsicId::Clone. The
#     resolved concrete clone implementation is dispatch data
#     (codegen.tg:9091-9110 dispatches to the compiled
#     "TypeName__clone" body or the String/runtime clone); the class
#     walk never re-spells a callee name. semantic_snapshot.tg's
#     MirOrigin classifier has NO derived-Clone family today
#     (MirOrigin::Derived is the effect-dispatcher family,
#     semantic_snapshot.tg:3141-3145), so a derived clone body's call
#     site carries the same stamped Clone operation as every other
#     clone call — the operation id is the identity, never the origin
#     text. The specialized String/Map/Set clone intrinsic ids are
#     distinct operations (counted as allocations through may_allocate,
#     not folded here). A call to a name that merely CONTAINS "clone"
#     is never counted. The walk is exact over the stamped/
#     router-classified sites; its row is StaticExact.
#   spills / reloads       — 0 from the MIR (allocator-side records —
#     see the LIR view).
#   inline_decisions       — 0: the inliner records no decisions.
#   branch_count           — MirGoto + MirSwitchInt + MirAssert terms
#     (jump / multiway-switch / conditional-check kinds; MirCall /
#     MirDeinit / MirReturn / MirAbort / MirUnreachable never count).
#     The walk is exact — its row is StaticExact.
#   est_instruction_count  — 2 * statements + 3 * terminators over the
#     whole function (a DERIVED estimate — a call statement expands to
#     several machine instructions, so it is not a bound either way;
#     its row is StaticEstimate).
#   vectorization_eligible — any STATEMENT operates on an array/vector
#     type: the assigned local's declared type is an inline array
#     (Type::FixedArray / FixedArraySym) or a registered std SIMD Adt
#     (bare name Vec2/Vec4/Vec8/Vec16 — the layout_engine vector-row
#     vocabulary), or the rvalue constructs an array (MirAggregate
#     MirArray, MirRepeat) or reads an array's length (MirLen over an
#     array-typed local). The walk is exact — StaticExact.
#   hotness                — 0: no per-function hotness rides the
#     optimized program (PGO counts live in the external profile file;
#     MirFunction.attr_cold is a layout hint, not a count). A
#     ProfileMeasured row would be emitted only when a profile-fed
#     view produces one; none does here.
#
# DETERMINISM: pure reads of the program; perf_reports_of_program
# returns reports SORTED by function_key (ties keep program order).
# The LIR view reads only the lowering + allocation artifacts and
# fills spills / reloads / stack_bytes / branch_count; the rest stay
# defaulted (doc note in the builder).
#
# LABELED FACT ROWS (audit item 57; item 40b the provenance taxonomy):
# the aggregate PerfReport fields above are joined by the per-field
# PerfFact row lists, where every row carries its PerfField, measured
# value, PerfFactSource provenance label and site text. The provenance
# rule is per metric:
#   StaticExact       — the value is walked EXACTLY over the artifact:
#                       the surviving bounds checks, the copy/move/drop
#                       occurrences, the branch terms, the vectorization
#                       eligibility flag, the typed-call clone count and
#                       the typed §11 arena-capability walk.
#   StaticUpperBound  — the value is a CONSERVATIVE (fail-closed or
#                       approximation) walk that may over-count: the heap
#                       allocation sites (unknown bodyless/indirect
#                       callees count) and the escape sites (the
#                       documented ArgEscape approximation).
#   StaticEstimate    — a DERIVED estimate, exact in neither direction:
#                       the MIR instruction-count estimate (2*stmts +
#                       3*blocks) and the LIR machine instruction-count
#                       estimate (one per LIR statement + one per block
#                       terminator).
#   MachineActual     — a value RECORDED by the lowering/allocator (LIR
#                       machine level): spills, reloads, stack bytes, the
#                       lowered LIR branch terms and the assigned
#                       callee-saved registers.
#   ProfileMeasured   — a runtime profile-fed value: NO view produces one
#                       here (the stable-keyed PGO profile lives in the
#                       external profile file; perf_report reads no
#                       profile).
# The MIR view (perf_facts_of_mir_function) emits one row per surface
# the MIR scan COUNTS (heap, arena, escapes, surviving bounds checks,
# copies, moves, drops, clones, branches, the instruction-count
# estimate and vectorization eligibility); the surfaces the MIR
# artifacts do NOT record emit NO row (their aggregate stays 0 — never
# an invented number, matching the field rules above). NO RetainRelease
# row is emitted: the MIR carries no Arc/Rc operation id, so there is no
# semantic operation to classify (item 40a — the documented
# no-semantic-op rule). The LIR/allocator view (perf_facts_of_lir) marks
# the allocator-recorded surfaces MachineActual and keeps
# MachineInstructionCount a StaticEstimate because the emitted machine
# WORD count exists only inside the per-route emitter buffers after LIR
# and never rides the LIR artifacts (the prerequisite is documented at
# the exact row site).

use std::core::{Option}
use std::collections::{Vec, Map, Set}

use tg_compiler::mir::{
  MirProgram, MirFunction, MirStatementKind, MirRvalueKind, MirBinOp, MirOperand,
  MirOperandKind, MirConstantKind, MirCallArg, MirCallValue, MirTerminatorKind,
  AggregateKind, AssertMessage, Place
}
use tg_compiler::types::{
  Type, EffectSummary, intrinsic_id_of_call, effect_summary_of_intrinsic,
  effect_summary_of_extern_name, effect_summary_unknown, capability_id_arena
}
use tg_compiler::ids::{IntrinsicId}
use tg_compiler::lir::{LirFunction, LirAlloc, LirTermKind}

# ———————————————————————————————————————————————————————————————
# The §44 record — one PerfReport per function
# ———————————————————————————————————————————————————————————————
# Every field is defaulted (zero means "the artifact records nothing"
# — never a measured zero unless a rule above says so).

pub struct PerfReport
  function_key: String = ""
  heap_allocations: Int = 0
  arena_allocations: Int = 0
  escapes: Int = 0
  stack_bytes: Int = 0
  bounds_checks: Int = 0
  proven_removed_bounds: Int = 0
  copies: Int = 0
  moves: Int = 0
  drops: Int = 0
  # (item 40a) the Arc/Rc reference-count sites — ALWAYS 0 today: the MIR
  # carries no retain/release operation id (see the field rule above).
  retain_release: Int = 0
  # (item 40a) the derived/Clone semantic-operation call sites
  # (IntrinsicId::Clone — stamped or router-classified).
  clones: Int = 0
  spills: Int = 0
  reloads: Int = 0
  inline_decisions: Int = 0
  branch_count: Int = 0
  est_instruction_count: Int = 0
  vectorization_eligible: Bool = false
  hotness: Int = 0
end

# The per-function running tallies of the MIR scan.
struct MirPerfTally
  statements: Int = 0
  heap_allocs: Int = 0
  arena_allocs: Int = 0
  escapes: Int = 0
  bounds_checks: Int = 0
  copies: Int = 0
  moves: Int = 0
  drops: Int = 0
  clones: Int = 0
  branches: Int = 0
  vector_ok: Bool = false
end

# ———————————————————————————————————————————————————————————————
# Type-text and type-shape mirrors (the §11 router vocabulary)
# ———————————————————————————————————————————————————————————————

# The last path segment of a registered type name ("std::simd::Vec4" ->
# "Vec4" — the intrinsic router's receiver_named vocabulary).
def perf_bare_type_name(name: String) -> String
  var i = name.len()
  while i >= 2 do
    if name.slice(i - 2, i) == "::" then
      return name.slice(i, name.len())
    end
    i = i - 1
  end
  name.clone()
end

# The bare registered name of a Type::Adt ("" for non-Adt types) — the
# mirror of mir_effect_adt_name over the program's MirTypeDef table.
def perf_adt_name(type_index: Map[Int, String], ty: Type) -> String
  match ty
  when Type::Adt(tid, _) then
    match type_index.get(tid.id)
    when Option::Some(n) then perf_bare_type_name(&n)
    when Option::None then "".to_string()
    end
  when _ then "".to_string()
  end
end

# Strip one reference layer (mir_effect_strip_ref's mirror).
def perf_strip_ref(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then inner.clone()
  when _ then ty.clone()
  end
end

# Whether a type is String-like (the owned String or the MIR-internal
# StaticStrPtr literal view) — mir_effect_type_is_string_like's mirror.
def perf_type_is_string_like(ty: Type) -> Bool
  let t = perf_strip_ref(ty)
  match t
  when Type::String then true
  when Type::StaticStrPtr then true
  when _ then false
  end
end

# The declared type of a place's base local (Type::Unit for an
# out-of-range id) — mir_effect_place_type's mirror.
def perf_place_type(f: MirFunction, p: Place) -> Type
  if p.local.id >= 0 && p.local.id < f.locals.len() then
    f.locals[p.local.id].ty.clone()
  else
    Type::Unit
  end
end

# The type of one call argument value — mir_effect_arg_value_type's
# mirror (a place operand reads its base local's declared type).
def perf_arg_value_type(f: MirFunction, arg: MirCallArg) -> Type
  match arg.value
  when MirCallValue::Value(op) then
    match op.kind
    when MirOperandKind::MirConstant(c) then c.ty.clone()
    when MirOperandKind::MirCopy(p) then perf_place_type(f, &p)
    when MirOperandKind::MirMovePlace(p) then perf_place_type(f, &p)
    when MirOperandKind::MirRead(p) then perf_place_type(f, &p)
    when MirOperandKind::MirConsume(p) then perf_place_type(f, &p)
    end
  when MirCallValue::Place(p) then perf_place_type(f, &p)
  end
end

# Whether an operand holds the String form a `+` concat recognizes —
# mir_effect_operand_is_string's mirror.
def perf_operand_is_string(f: MirFunction, op: MirOperand) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then perf_type_is_string_like(&c.ty)
  when MirOperandKind::MirCopy(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  when MirOperandKind::MirMovePlace(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  when MirOperandKind::MirRead(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  when MirOperandKind::MirConsume(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  end
end

# The type-directed router facts of a call's receiver/needle arguments
# (positions 0 and 1) — mir_effect_router_facts' mirror.
def perf_router_facts(f: MirFunction, type_index: Map[Int, String], args: Vec[MirCallArg]) -> (Type, String, Type, String, Bool, Bool)
  var recv_ty = Type::Unit
  var recv_named = "".to_string()
  var needle_ty = Type::Unit
  var needle_named = "".to_string()
  var recv_is_string = false
  var needle_is_string = false
  if args.len() > 0 then
    recv_ty = perf_strip_ref(perf_arg_value_type(f, &args[0]))
    recv_named = perf_adt_name(&type_index, &recv_ty)
    recv_is_string = perf_type_is_string_like(&recv_ty)
  end
  if args.len() > 1 then
    needle_ty = perf_strip_ref(perf_arg_value_type(f, &args[1]))
    needle_named = perf_adt_name(&type_index, &needle_ty)
    needle_is_string = perf_type_is_string_like(&needle_ty)
  end
  (recv_ty, recv_named, needle_ty, needle_named, recv_is_string, needle_is_string)
end

# ———————————————————————————————————————————————————————————————
# The §11 allocating-call mirror (mir_effect_classify_call)
# ———————————————————————————————————————————————————————————————

# The MirFnItem name of a call-target operand (Option::None for an
# indirect closure/pointer target).
def perf_callee_name_of(func: MirOperand) -> Option[String]
  match func.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirFnItem(name) then Option::Some(name.clone())
    when _ then Option::None
    end
  when _ then Option::None
  end
end

# The §11 effect summary of a BODYLESS callee name: the intrinsic-name
# router first, then the extern-name seed table, then fail-closed
# unknown — mir_effect_classify_bodyless' exact route (mir.tg:28703).
def perf_bodyless_summary(f: MirFunction, type_index: Map[Int, String], name: String, args: Vec[MirCallArg]) -> EffectSummary
  let facts = perf_router_facts(f, type_index, args)
  match intrinsic_id_of_call(name.clone(), facts.0, facts.1, facts.2, facts.3, "".to_string(), facts.4, facts.5)
  when Option::Some(iid) then
    effect_summary_of_intrinsic(iid)
  when Option::None then
    match effect_summary_of_extern_name(name.clone())
    when Option::Some(sum) then sum
    when Option::None then effect_summary_unknown()
    end
  end
end

# The §11 effect summary of one MirCall SITE (mir_effect_classify_call's
# decision, mir.tg:28736): a stamped intrinsic decides by its effect
# record; an unstamped named callee with a body in this program has the
# EMPTY site record (its effects land on the callee's own report — the
# transitive-edge rule); a bodyless named callee routes through the
# §11 bodyless table; an indirect callee is unknown (fail closed).
def perf_call_summary(f: MirFunction, type_index: Map[Int, String], bodied: Set[String], func: MirOperand, args: Vec[MirCallArg], intrinsic: Option[IntrinsicId]) -> EffectSummary
  match intrinsic
  when Option::Some(iid) then
    effect_summary_of_intrinsic(iid)
  when Option::None then
    match perf_callee_name_of(&func)
    when Option::Some(name) then
      if bodied.contains(&name) then
        EffectSummary {}
      else
        perf_bodyless_summary(f, type_index, name, args)
      end
    when Option::None then
      effect_summary_unknown()
    end
  end
end

# Whether a call SITE allocates (the §11 summary's Alloc class; see the
# heap_allocations field rule).
def perf_call_allocates(f: MirFunction, type_index: Map[Int, String], bodied: Set[String], func: MirOperand, args: Vec[MirCallArg], intrinsic: Option[IntrinsicId]) -> Bool
  perf_call_summary(f, type_index, bodied, func, args, intrinsic).may_allocate
end

# Whether an effect summary carries the §11 arena capability
# (capability_id_arena, types.tg:9595) — the typed predicate the
# arena_allocations rule uses (item 40a; replaces the callee-name
# substring heuristic).
def perf_summary_has_arena_capability(summary: EffectSummary) -> Bool
  let arena = capability_id_arena()
  summary.capabilities.contains(&arena)
end

# Whether a call SITE carries the arena capability (the call's §11
# effect record — stamped intrinsic, bodyless route, or the empty
# in-program site record; an indirect callee's unknown record carries no
# capability). No §11 record currently sets capability_id_arena, so the
# walk's measured count is 0 today (an exact typed zero — the doc note).
def perf_call_is_arena_allocation(f: MirFunction, type_index: Map[Int, String], bodied: Set[String], func: MirOperand, args: Vec[MirCallArg], intrinsic: Option[IntrinsicId]) -> Bool
  perf_summary_has_arena_capability(perf_call_summary(f, type_index, bodied, func, args, intrinsic))
end

# Whether a call SITE is the derived/Clone semantic OPERATION
# (item 40a): the call's stamped intrinsic is IntrinsicId::Clone, or —
# for an unstamped named callee — the semantic intrinsic-name router
# (intrinsic_id_of_call, the compiler's canonical classifier,
# types.tg:14414) classifies the callee as IntrinsicId::Clone. The
# resolved concrete clone implementation is codegen dispatch data
# (codegen.tg:9091-9110: the compiled "TypeName__clone" body or the
# runtime/String clone), never a name re-spelling here. The MirOrigin
# derived classifier has no derived-Clone family today
# (MirOrigin::Derived is the effect dispatcher — semantic_snapshot.tg:
# 3141-3145), so a derived body's clone call site still carries the
# stamped Clone operation. An indirect callee carries no clone
# identity. The specialized String/Map/Set clone ids are distinct
# operations and do not match.
def perf_call_is_clone(f: MirFunction, type_index: Map[Int, String], func: MirOperand, args: Vec[MirCallArg], intrinsic: Option[IntrinsicId]) -> Bool
  match intrinsic
  when Option::Some(iid) then
    iid == IntrinsicId::Clone
  when Option::None then
    match perf_callee_name_of(&func)
    when Option::Some(name) then
      let facts = perf_router_facts(f, type_index, args)
      match intrinsic_id_of_call(name, facts.0, facts.1, facts.2, facts.3, "".to_string(), facts.4, facts.5)
      when Option::Some(iid) then iid == IntrinsicId::Clone
      when Option::None then false
      end
    when Option::None then false
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The array/vector eligibility predicate and program indexes
# ———————————————————————————————————————————————————————————————

# Whether a type is array/vector-shaped for vectorization_eligible: an
# inline fixed array (Type::FixedArray / FixedArraySym) or a registered
# std SIMD Adt — bare name Vec2/Vec4/Vec8/Vec16 — the layout_engine
# vector-row vocabulary.
def perf_type_is_array_vector(type_index: Map[Int, String], ty: Type) -> Bool
  match ty
  when Type::FixedArray(_, _) then true
  when Type::FixedArraySym(_, _) then true
  when Type::Adt(tid, _) then
    match type_index.get(tid.id)
    when Option::Some(n) then
      let bare = perf_bare_type_name(&n)
      bare == "Vec2" || bare == "Vec4" || bare == "Vec8" || bare == "Vec16"
    when Option::None then false
    end
  when _ then false
  end
end

# The registered type-name index (TypeId.id -> name) over the program's
# MirTypeDef table.
def perf_type_index_of(mir: MirProgram) -> Map[Int, String]
  var type_index: Map[Int, String] = Map::new()
  for td in mir.types do
    type_index.insert(td.id.id, td.name.clone())
  end
  type_index
end

# The emission names of the functions WITH a body in this program (the
# body test of mir_effect_classify_call's fn_index lookup — an entry
# with no blocks is a bodyless extern declaration).
def perf_bodied_names_of(mir: MirProgram) -> Set[String]
  var bodied: Set[String] = Set::new()
  for f in mir.functions do
    if f.blocks.len() > 0 then
      bodied.insert(f.name.clone())
    end
  end
  bodied
end

# ———————————————————————————————————————————————————————————————
# THE MIR SCAN — one PerfReport per optimized MirFunction
# ———————————————————————————————————————————————————————————————

# Tally one operand occurrence by kind (the copies/moves rules:
# MirCopy and MirRead count as copies, MirMovePlace as a move;
# MirConsume and constants are in no audit field).
def perf_count_operand(inout t: MirPerfTally, op: MirOperand) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(_) then t.copies = t.copies + 1
  when MirOperandKind::MirRead(_) then t.copies = t.copies + 1
  when MirOperandKind::MirMovePlace(_) then t.moves = t.moves + 1
  when _ then ()
  end
end

# The per-function scan over the optimized MIR (every block's
# statements + terminator). Field rules: see the module doc — each arm
# mirrors an artifact the optimized MIR actually carries.
def perf_report_build(f: MirFunction, type_index: Map[Int, String], bodied: Set[String]) -> PerfReport
  var t = MirPerfTally {}
  for block in f.blocks do
    t.statements = t.statements + block.statements.len()
    for st in block.statements do
      match st.kind
      when MirStatementKind::MirAssign(dest, rvalue) then
        if perf_type_is_array_vector(&type_index, &perf_place_type(&f, &dest)) then
          t.vector_ok = true
        end
        match rvalue.kind
        when MirRvalueKind::MirMove(op) then
          perf_count_operand(t, &op)
        when MirRvalueKind::MirRef(_) then
          # MirRef sites: address-taken places (one escape each).
          t.escapes = t.escapes + 1
        when MirRvalueKind::MirAggregate(kind, ops) then
          for op in ops do
            perf_count_operand(t, &op)
          end
          match kind
          when AggregateKind::MirArray(_) then
            t.vector_ok = true
          when _ then ()
          end
        when MirRvalueKind::MirBinOp(MirBinOp::Add, lhs, rhs) then
          perf_count_operand(t, &lhs)
          perf_count_operand(t, &rhs)
          # The §11 string-concat allocation site (Add-over-strings).
          let dest_str = perf_type_is_string_like(&perf_place_type(&f, &dest))
          if dest_str || perf_operand_is_string(&f, &lhs) || perf_operand_is_string(&f, &rhs) then
            t.heap_allocs = t.heap_allocs + 1
          end
        when MirRvalueKind::MirBinOp(_, lhs, rhs) then
          perf_count_operand(t, &lhs)
          perf_count_operand(t, &rhs)
        when MirRvalueKind::MirUnOp(_, op) then
          perf_count_operand(t, &op)
        when MirRvalueKind::MirDiscriminant(_) then ()
        when MirRvalueKind::MirLen(place) then
          if perf_type_is_array_vector(&type_index, &perf_place_type(&f, &place)) then
            t.vector_ok = true
          end
        when MirRvalueKind::MirCast(_, op, _) then
          perf_count_operand(t, &op)
        when MirRvalueKind::MirRepeat(op, _) then
          # An array-initialization repeat constructs an inline array.
          t.vector_ok = true
          perf_count_operand(t, &op)
        when MirRvalueKind::MirPhi(_) then ()
        end
      when MirStatementKind::MirStorageLive(_) then ()
      when MirStatementKind::MirStorageDead(_) then ()
      when MirStatementKind::MirNop then ()
      when MirStatementKind::MirContractCheck(_, op) then
        perf_count_operand(t, &op)
      when MirStatementKind::MirBudgetConsume(_, _) then ()
      when MirStatementKind::MirEffectRecord(_, op) then
        perf_count_operand(t, &op)
      when MirStatementKind::MirEffectPerform(_, _, _, op1, op2) then
        perf_count_operand(t, &op1)
        perf_count_operand(t, &op2)
      when MirStatementKind::MirEffectFrameEnter(_, _, _, _, op) then
        perf_count_operand(t, &op)
      when MirStatementKind::MirEffectFrameExit then ()
      end
    end
    match block.terminator.kind
    when MirTerminatorKind::MirGoto(_) then
      t.branches = t.branches + 1
    when MirTerminatorKind::MirReturn then ()
    when MirTerminatorKind::MirUnreachable then ()
    when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
      t.branches = t.branches + 1
      perf_count_operand(t, &op)
    when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
      if perf_call_allocates(&f, &type_index, &bodied, &func, &args, &intrinsic) then
        t.heap_allocs = t.heap_allocs + 1
      end
      # (item 40a) The SEMANTIC operation classification: the arena
      # capability from the §11 effect records (no callee-name text is
      # inspected) and the derived/Clone semantic operation. There is NO
      # typed retain/release predicate: no Arc/Rc operation id exists in
      # the MIR vocabulary, so no count is produced and the view emits no
      # RetainRelease row (documented at the field rule).
      if perf_call_is_arena_allocation(&f, &type_index, &bodied, &func, &args, &intrinsic) then
        t.arena_allocs = t.arena_allocs + 1
      end
      if perf_call_is_clone(&f, &type_index, &func, &args, &intrinsic) then
        t.clones = t.clones + 1
      end
      for arg in args do
        match arg.value
        when MirCallValue::Value(op) then
          perf_count_operand(t, &op)
          match op.kind
          when MirOperandKind::MirCopy(p) then
            if p.projections.is_empty() then t.escapes = t.escapes + 1 end
          when MirOperandKind::MirMovePlace(p) then
            if p.projections.is_empty() then t.escapes = t.escapes + 1 end
          when MirOperandKind::MirRead(p) then
            if p.projections.is_empty() then t.escapes = t.escapes + 1 end
          when MirOperandKind::MirConsume(p) then
            if p.projections.is_empty() then t.escapes = t.escapes + 1 end
          when _ then ()
          end
        when MirCallValue::Place(p) then
          if p.projections.is_empty() then t.escapes = t.escapes + 1 end
        end
      end
    when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
      t.branches = t.branches + 1
      perf_count_operand(t, &cond)
      match msg
      when AssertMessage::BoundsCheck(index_op, len_op) then
        # A surviving check (a proven one became a MirGoto — module doc).
        t.bounds_checks = t.bounds_checks + 1
        perf_count_operand(t, &index_op)
        perf_count_operand(t, &len_op)
      when _ then ()
      end
    when MirTerminatorKind::MirAbort then ()
    when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
      # drops: one implicit destruction terminator.
      t.drops = t.drops + 1
    end
  end
  # est = 2 * statements + 3 * terminators (module doc). The surfaces
  # the optimized MIR does NOT record stay 0 (module doc field rules).
  PerfReport {
    function_key: f.name.clone(),
    heap_allocations: t.heap_allocs,
    arena_allocations: t.arena_allocs,
    escapes: t.escapes,
    stack_bytes: 0,
    bounds_checks: t.bounds_checks,
    proven_removed_bounds: 0,
    copies: t.copies,
    moves: t.moves,
    drops: t.drops,
    retain_release: 0,
    clones: t.clones,
    spills: 0,
    reloads: 0,
    inline_decisions: 0,
    branch_count: t.branches,
    est_instruction_count: 2 * t.statements + 3 * f.blocks.len(),
    vectorization_eligible: t.vector_ok,
    hotness: 0
  }
end

# ———————————————————————————————————————————————————————————————
# The public builders
# ———————————————————————————————————————————————————————————————

# One PerfReport over an OPTIMIZED MirFunction of the given program.
# ANCHOR NOTE: the §11 allocation mirror is program-scoped (an
# in-program callee's allocation must land on the CALLEE's report,
# never the site), so the program rides along — a lone function cannot
# classify its call sites.
pub def perf_report_of_mir_function(mir: MirProgram, f: MirFunction) -> PerfReport
  let type_index = perf_type_index_of(&mir)
  let bodied = perf_bodied_names_of(&mir)
  perf_report_build(&f, &type_index, &bodied)
end

# One PerfReport over the LIR artifacts (function + allocation) when
# they are available — the allocator-side view. spills = the allocator's
# recorded spill-store events (LirAlloc.spills — the "(call position,
# vreg)" store-before-call list; the alternative readings — the
# memory-resident vreg count over LirAlloc.segs_of's phys < 0 segments
# and LirAlloc.slots — are documented but unused); reloads =
# LirAlloc.reloads (the recorded post-call slot re-loads — the emitter
# inserts no slot-load STATEMENTS, so the records ARE the count);
# stack_bytes = LirAlloc.frame_bytes (the aligned frame allocation
# size); branch_count = the LirJump + LirSwitch terms (MIR asserts and
# switches lower to these — LIR has no other branching term). Every
# other field stays defaulted: bounds checks, drops and the operand
# traffic are MIR-level facts that do not survive into LIR's scalar
# subset (documented).
pub def perf_report_of_lir_alloc(lir_fn: LirFunction, alloc: LirAlloc) -> PerfReport
  var branches = 0
  for block in lir_fn.blocks do
    match block.term.kind
    when LirTermKind::LirJump(_) then branches = branches + 1
    when LirTermKind::LirSwitch(_, _, _) then branches = branches + 1
    when LirTermKind::LirRet(_) then ()
    when LirTermKind::LirTrap then ()
    when LirTermKind::LirCall(_, _, _, _, _) then ()
    end
  end
  PerfReport {
    function_key: lir_fn.name.clone(),
    heap_allocations: 0,
    arena_allocations: 0,
    escapes: 0,
    stack_bytes: alloc.frame_bytes,
    bounds_checks: 0,
    proven_removed_bounds: 0,
    copies: 0,
    moves: 0,
    drops: 0,
    retain_release: 0,
    clones: 0,
    spills: alloc.spills.len(),
    reloads: alloc.reloads.len(),
    inline_decisions: 0,
    branch_count: branches,
    est_instruction_count: 0,
    vectorization_eligible: false,
    hotness: 0
  }
end

# The §44 session helper: one PerfReport per function of the optimized
# program, SORTED by function_key (ties keep program order).
pub def perf_reports_of_program(mir: MirProgram) -> Vec[PerfReport]
  let type_index = perf_type_index_of(&mir)
  let bodied = perf_bodied_names_of(&mir)
  var reports: Vec[PerfReport] = Vec::new()
  for f in mir.functions do
    reports.push(perf_report_build(&f, &type_index, &bodied))
  end
  reports.sort_by(|a, b| perf_report_lt(a, b))
  reports
end

def perf_report_lt(a: PerfReport, b: PerfReport) -> Bool
  a.function_key < b.function_key
end

# ———————————————————————————————————————————————————————————————
# The labeled fact rows (audit item 57; item 40b provenance taxonomy)
# ———————————————————————————————————————————————————————————————
# ONE row per counted surface with its provenance label:
#   StaticExact      — a value walked EXACTLY over the static artifact;
#   StaticUpperBound — a conservative walk that may over-count;
#   StaticEstimate   — a DERIVED estimate (exact in neither direction);
#   MachineActual    — a value RECORDED by the LIR lowering / register
#                      allocator;
#   ProfileMeasured  — a runtime profile-fed value (no producer in the
#                      current views — the PGO profile is external and
#                      perf_report reads no profile).
# The per-metric assignment is the module doc's LABELED FACT ROWS rule.

pub enum PerfFactSource
  StaticExact
  StaticUpperBound
  StaticEstimate
  MachineActual
  ProfileMeasured
end

# The fact vocabulary. Every aggregate PerfReport field has a row field (a
# few row-only fields — the sites / register / machine families — name
# surfaces no aggregate currently sums; they are declared for the row
# protocol and are emitted only when a view records them).
pub enum PerfField
  HeapAllocations
  ArenaAllocations
  Escapes
  StackBytes
  BoundsChecks
  ProvenRemovedBounds
  Copies
  Moves
  Drops
  RetainRelease
  Clones
  Spills
  Reloads
  InlineDecisions
  BranchCount
  EstInstructionCount
  VectorizationEligible
  Hotness
  AllocatedRegisters
  MachineInstructionCount
  AllocationSites
  BoundsCheckSites
  VectorizationDecisions
  InlineDecisionsM
end

# One labeled fact: `field` + measured `value` + provenance `source` +
# the anchor `site`. Whole-function aggregate rows carry an empty site
# (the function identity is the query's input — both row builders take
# exactly one function/LIR record); a per-site row carries the statement
# or call-site locator text.
pub struct PerfFact
  field: PerfField
  value: Int = 0
  source: PerfFactSource
  site: String = ""
end

# The exact static walk (item 40b).
def perf_fact_exact(field: PerfField, value: Int) -> PerfFact
  PerfFact { field: field, value: value, source: PerfFactSource::StaticExact }
end

# The conservative (fail-closed / approximation) static walk (item 40b).
def perf_fact_upper(field: PerfField, value: Int) -> PerfFact
  PerfFact { field: field, value: value, source: PerfFactSource::StaticUpperBound }
end

# The derived static estimate (item 40b).
def perf_fact_static(field: PerfField, value: Int) -> PerfFact
  PerfFact { field: field, value: value, source: PerfFactSource::StaticEstimate }
end

def perf_fact_machine(field: PerfField, value: Int) -> PerfFact
  PerfFact { field: field, value: value, source: PerfFactSource::MachineActual }
end

# The MIR view's labeled rows: the counted surfaces of the MIR scan (see
# the field rules above), each labeled by the per-metric provenance rule
# (item 40b): the exact walks StaticExact, the fail-closed allocation
# walk and the escape approximation StaticUpperBound, the derived
# instruction estimate StaticEstimate. NO RetainRelease row is emitted —
# the MIR carries no Arc/Rc operation id (item 40a). A surface the MIR
# artifacts do not record (stack bytes, proven-removed bounds,
# spills/reloads, inline decisions, hotness, and the register/machine/site
# families) also emits NO row — the aggregate's 0 means "not recorded",
# never "measured zero". A counted surface emits its measured value, a
# measured zero included.
pub def perf_facts_of_mir_function(mir: MirProgram, f: MirFunction) -> Vec[PerfFact]
  let report = perf_report_of_mir_function(&mir, &f)
  var facts: Vec[PerfFact] = Vec::new()
  facts.push(perf_fact_upper(PerfField::HeapAllocations, report.heap_allocations))
  facts.push(perf_fact_exact(PerfField::ArenaAllocations, report.arena_allocations))
  facts.push(perf_fact_upper(PerfField::Escapes, report.escapes))
  facts.push(perf_fact_exact(PerfField::BoundsChecks, report.bounds_checks))
  facts.push(perf_fact_exact(PerfField::Copies, report.copies))
  facts.push(perf_fact_exact(PerfField::Moves, report.moves))
  facts.push(perf_fact_exact(PerfField::Drops, report.drops))
  facts.push(perf_fact_exact(PerfField::Clones, report.clones))
  facts.push(perf_fact_exact(PerfField::BranchCount, report.branch_count))
  facts.push(perf_fact_static(PerfField::EstInstructionCount, report.est_instruction_count))
  var vector_eligible = 0
  if report.vectorization_eligible then
    vector_eligible = 1
  end
  facts.push(perf_fact_exact(PerfField::VectorizationEligible, vector_eligible))
  facts
end

# The LIR/allocator view's labeled rows: the allocator-recorded surfaces
# (spills, reloads, the frame's stack_bytes) and the lowered LIR
# artifact facts (the branch terms; the assigned callee-saved register
# count — LirAlloc.cc_used, populated by the aarch64 allocation and
# empty on the word-geometry routes whose allocator persists no such
# list) are MachineActual. MachineInstructionCount is the DOCUMENTED
# StaticEstimate — one per LIR statement plus one per block terminator —
# and the prerequisite for making it exact is recorded HERE: the aarch64
# emitter (lir.tg's lir_emit_fn, lir.tg:17100) and the x86-64 emitter
# append their encodings into the shared CodegenCtx.text CodeBuffer
# (codegen.tg:213); neither returns a per-function word vec, and no
# per-function emitted-word count rides the LirFunction/LirAlloc
# artifacts perf_report_of_lir_alloc receives. Exposing it needs the
# emitter to record (buf_pos(&ctx.text) after lir_emit_fn minus the
# function's start offset) / 4 on a per-function artifact field. Until
# that lands the row stays StaticEstimate. The MIR-level surfaces do not
# survive into LIR's scalar subset and emit no row, as in
# perf_report_of_lir_alloc.
pub def perf_facts_of_lir(lir_fn: LirFunction, alloc: LirAlloc) -> Vec[PerfFact]
  let report = perf_report_of_lir_alloc(&lir_fn, &alloc)
  var facts: Vec[PerfFact] = Vec::new()
  facts.push(perf_fact_machine(PerfField::Spills, report.spills))
  facts.push(perf_fact_machine(PerfField::Reloads, report.reloads))
  facts.push(perf_fact_machine(PerfField::StackBytes, report.stack_bytes))
  facts.push(perf_fact_machine(PerfField::BranchCount, report.branch_count))
  facts.push(perf_fact_machine(PerfField::AllocatedRegisters, alloc.cc_used.len()))
  var lir_ops = 0
  for block in lir_fn.blocks do
    lir_ops = lir_ops + block.stmts.len() + 1
  end
  facts.push(perf_fact_static(PerfField::MachineInstructionCount, lir_ops))
  facts
end
