# Tangerine Compiler — per-function performance report (audit §44)
# Self-hosting compiler written in Tangerine
#
# ONE compact PerfReport per function of an OPTIMIZED MirProgram, plus
# the LIR view when the allocation artifacts are available — the
# per-function introspection fields over the REAL post-optimization
# artifacts: "inspect actual optimized MIR/LIR; then optimization work
# is directed by actual causes." (fourth-audit P1-6) Every field is a
# typed PerfMetric[T] whose value is Option[T]: a recorded zero is
# Some(0), a surface the artifact does NOT record is None with its
# provenance/bound_kind — the two are never conflated. No number is ever
# invented (the sibling discipline of abi_report.tg).
#
# (fourth-audit P1-6) ONE OPERATION CLASSIFICATION: the allocating /
# arena-capability / derived-Clone decision is mir.tg's typed
# operation_class_of_call (the single shared classifier the §11 effect
# scan and the @budget allocation analysis consume too); this module
# never re-derives it from a callee name or a parallel predicate set.
#
# PIPELINE ARTIFACTS: optimize_mir_verified (mir.tg) batches DCE, copy
# propagation, constant folding, dead-store elimination, CFG
# simplification, strength reduction, and (opt >= 2) GVN, LICM,
# eliminate_bounds_checks, then simplify_moves + final DCE, then (opt
# >= 2) escape_analysis and (opt >= 3) apply_pgo_optimizations (a
# FILE-fed pass — PGO counts never ride the program). NO pass records
# statistics: each is an in-out Unit rewrite and the verifier
# checkpoints journal only diagnostics, so pass-PRODUCED metrics are
# unrecoverable from the optimized program and stay 0 here (documented
# per field): the bounds checks eliminate_bounds_checks PROVED AND
# REMOVED (provable MirAssert/BoundsCheck terms are rewritten to
# MirGoto — mir.tg:19641), the inline decisions (an inlined site
# becomes a plain MirGoto; the residue is only the "_inlined" local
# suffix), the spill/reload decisions (LIR-allocator data),
# escape_analysis's heap-to-stack promotions and the PGO counts.
# Nonzero counts measure the SURVIVING optimized body: the remaining
# BoundsCheck asserts, call sites and operand traffic.
#
# COUNTING RULES (field by field — the report anchors):
#   heap_allocations      — the §11 allocating MirCall sites + the §11
#     string-concat sites (the two site kinds the §11 DIRECT scan
#     classifies allocating). The call classification IS the shared
#     operation_class_of_call (mir.tg): a STAMPED intrinsic allocates
#     iff its record's may_allocate is true; an unstamped named callee
#     allocates iff it has NO body in this program and the bodyless
#     route (intrinsic-name router, then extern-name seeds) says
#     may_allocate — unknown bodyless and INDIRECT callees count (the
#     §11 fail-closed rule). An in-program callee never counts at the
#     SITE (its allocations land on the callee's own report). The concat
#     mirror is the Add-over-strings arm of mir_effect_scan_function. A
#     MirDeinit is not a MirCall site and never counts. The count is an
#     UPPER BOUND (the fail-closed arms may over-count an unknown
#     callee) — its PerfMetric value is Some with bound_kind
#     "upper-bound".
#   arena_allocations      — (item 40a) MirCall sites whose §11 effect
#     RECORD carries the arena capability (capability_id_arena,
#     types.tg:9595 — "a bounded bump-arena allocation, which is NOT a
#     heap allocation"). The typed capability predicate replaces the
#     old callee-name "arena"/"bump" substring heuristic. NO §11 record
#     currently carries the capability (the IntrinsicId vocabulary has
#     no bump-arena op and codegen emits _tg_bump_alloc directly,
#     never as a MirCall), so the measured count is 0 today — an EXACT
#     typed-walk zero, not "not recorded". Its row is StaticExact.
#   escapes                — MirRef rvalue sites + call-ARGUMENT
#     occurrences that are BARE local places (no projections, all
#     operand forms incl. the Place form) — the documented
#     approximation of escape_analysis's ArgEscape sites. The walk is
#     conservative (it counts address-taken and bare-arg sites, a
#     superset of the promotions escape_analysis actually performs), so
#     its row is StaticUpperBound.
#   stack_bytes            — None from the MIR (a frame size exists only
#     after LIR allocation: LirAlloc.frame_bytes fills this in the
#     LIR view as a measured value).
#   bounds_checks          — MirAssert terminators with an
#     AssertMessage::BoundsCheck message — the checks that SURVIVED
#     the optimizer.
#   proven_removed_bounds  — None: the optimizer records no per-function
#     counter; nonzero needs a pass-side journal.
#   copies / moves         — MirCopy + MirRead operand occurrences
#     (copies) / MirMovePlace occurrences (moves) over every operand
#     position of the function's statements and terminator. MirConsume
#     operands are in no audit field and are not counted.
#   drops                  — MirDeinit terminators.
#   retain_release         — (item 40a) the Arc/Rc reference-count
#     operations. NO such semantic operation exists in the compiler's
#     operation vocabulary: ids.tg's IntrinsicId carries no
#     Retain/Release/Arc*/Rc* variant, the checker stamps none, and
#     ArcStrong's clone/drop lower as ordinary impl-method calls. The
#     metric value is None with bound_kind "unknown" (the shared
#     classifier's retain_release flag is reserved false) — no count is
#     produced. When Arc/Rc operation ids land, the typed predicate
#     over them re-enables the count at the ONE classifier and every
#     consumer at once.
#   clones                 — (item 40a) calls to the derived/Clone
#     semantic OPERATION: the call's stamped intrinsic is
#     IntrinsicId::Clone, or — for an unstamped named callee — the
#     semantic intrinsic-name router (intrinsic_id_of_call,
#     types.tg:14414) classifies the callee as IntrinsicId::Clone. The
#     resolved concrete clone implementation is dispatch data
#     (codegen.tg:9091-9110 dispatches to the compiled
#     "TypeName__clone" body or the String/runtime clone); the class
#     walk never re-spells a callee name. semantic_snapshot.tg's
#     MirOrigin classifier has NO derived-Clone family today
#     (MirOrigin::Derived is the effect-dispatcher family,
#     semantic_snapshot.tg:3141-3145), so a derived clone body's call
#     site carries the same stamped Clone operation as every other
#     clone call — the operation id is the identity, never the origin
#     text. The specialized String/Map/Set clone intrinsic ids are
#     distinct operations (counted as allocations through may_allocate,
#     not folded here). A call to a name that merely CONTAINS "clone"
#     is never counted. The walk is exact over the stamped/
#     router-classified sites; its row is StaticExact.
#   spills / reloads       — None from the MIR (allocator-side records —
#     see the LIR view); the LIR view fills measured values.
#   inline_decisions       — None: the inliner records no decisions.
#   branch_count           — MirGoto + MirSwitchInt + MirAssert terms
#     (jump / multiway-switch / conditional-check kinds; MirCall /
#     MirDeinit / MirReturn / MirAbort / MirUnreachable never count).
#     The walk is exact — its value is Some with bound_kind "exact".
#   instruction_count      — 2 * statements + 3 * terminators over the
#     whole function (a DERIVED estimate — a call statement expands to
#     several machine instructions, so it is not a bound either way;
#     bound_kind "estimate", StaticEstimate).
#   vectorization_eligibility — any STATEMENT operates on an array/vector
#     type: the assigned local's declared type is an inline array
#     (Type::FixedArray / FixedArraySym) or a registered std SIMD Adt
#     (bare name Vec2/Vec4/Vec8/Vec16 — the layout_engine vector-row
#     vocabulary), or the rvalue constructs an array (MirAggregate
#     MirArray, MirRepeat) or reads an array's length (MirLen over an
#     array-typed local). The walk is exact — StaticExact.
#   hotness                — None: no per-function hotness rides the
#     optimized program (PGO counts live in the external profile file;
#     MirFunction.attr_cold is a layout hint, not a count). A measured
#     value would appear only when a profile-fed view produces one; none
#     does here.
#
# DETERMINISM: pure reads of the program; perf_reports_of_program
# returns reports SORTED by function_key (ties keep program order).
# The LIR view reads only the lowering + allocation artifacts and
# fills spills / reloads / stack_bytes / branch_count / allocated_
# registers; every MIR-level metric is None (doc note in the builder).
#
# LABELED FACT ROWS (audit item 57; item 40b the provenance taxonomy):
# every PerfReport metric is also a PerfFact row (field + the SAME typed
# PerfMetric: value / provenance / bound_kind / sites). The provenance
# rule is per metric:
#   StaticExact       — the value is walked EXACTLY over the artifact:
#                       the surviving bounds checks, the copy/move/drop
#                       occurrences, the branch terms, the vectorization
#                       eligibility flag, the typed-call clone count and
#                       the typed §11 arena-capability walk.
#   StaticUpperBound  — the value is a CONSERVATIVE (fail-closed or
#                       approximation) walk that may over-count: the heap
#                       allocation sites (unknown bodyless/indirect
#                       callees count) and the escape sites (the
#                       documented ArgEscape approximation).
#   StaticEstimate    — a DERIVED estimate, exact in neither direction:
#                       the MIR instruction-count estimate (2*stmts +
#                       3*blocks).
#   MachineActual     — a value RECORDED by the lowering/allocator (LIR
#                       machine level): spills, reloads, stack bytes, the
#                       lowered LIR branch terms and the assigned
#                       callee-saved registers.
#   ProfileMeasured   — a runtime profile-fed value: NO view produces one
#                       here (the stable-keyed PGO profile lives in the
#                       external profile file; perf_report reads no
#                       profile).
# The MIR view (perf_facts_of_mir_function) emits one row per metric of
# the MIR report — including the unrecorded surfaces as value None (so
# Some(0) and None are distinct at the row level) and the RetainRelease
# row as None/unknown (the MIR carries no Arc/Rc operation id — item
# 40a). The LIR/allocator view (perf_facts_of_lir) marks the
# allocator-recorded surfaces MachineActual/measured; its
# MachineInstructionCount row is None with bound_kind "estimate" because
# the emitted machine WORD count exists only inside the per-route emitter
# buffers after LIR and never rides the LIR artifacts (the prerequisite
# is documented at the exact row site).

use std::core::{Option}
use std::collections::{Vec, Map}

use tg_compiler::mir::{
  MirProgram, MirFunction, MirStatementKind, MirRvalueKind, MirBinOp, MirOperand,
  MirOperandKind, MirCallValue, MirTerminatorKind,
  AggregateKind, AssertMessage, Place,
  # (fourth-audit P1-6) the ONE shared typed call-operation classification.
  operation_class_of_call,
  mir_function_index_of
}
use tg_compiler::types::{
  Type
}
use tg_compiler::stable_ids::{stable_mir_node_key_of, StableMirNodeId}
use tg_compiler::lir::{LirFunction, LirAlloc, LirTermKind}

# ———————————————————————————————————————————————————————————————
# The §44 record — one PerfReport per function
# ———————————————————————————————————————————————————————————————
# (fourth-audit P1-6) Every metric is a typed PerfMetric[T]:
#
#   value       — Option[T]: `Some(v)` is a RECORDED value (a measured
#                 zero included — Some(0) and None are DISTINCT), `None`
#                 means the artifact records nothing for the surface.
#   provenance  — the PerfFactSource family the value comes from.
#   bound_kind  — the value's claim word: "exact" | "upper-bound" |
#                 "estimate" | "measured" | "unknown".
#   sites       — the contributing stable P0-7 site ids (the MIR node
#                 keys of the counted statements/terminators; empty when
#                 the metric does not carry a per-site list).
#
# The field-by-field rules of the module doc still apply; a surface the
# artifact does NOT record is a None value with bound_kind "unknown"
# (the LIR allocator surfaces carry a measured value or a None/estimate
# for the machine word count — see perf_report_of_lir_alloc).

pub struct PerfMetric[T]
  value: Option[T]
  provenance: PerfFactSource
  bound_kind: String
  sites: Vec[String] = Vec::new()
end

pub struct PerfReport
  function_key: String = ""
  heap_allocations: PerfMetric[Int]
  arena_allocations: PerfMetric[Int]
  escapes: PerfMetric[Int]
  stack_bytes: PerfMetric[Int]
  bounds_checks: PerfMetric[Int]
  proven_removed_bounds: PerfMetric[Int]
  copies: PerfMetric[Int]
  moves: PerfMetric[Int]
  drops: PerfMetric[Int]
  retain_release: PerfMetric[Int]
  spills: PerfMetric[Int]
  reloads: PerfMetric[Int]
  inline_decisions: PerfMetric[Int]
  branch_count: PerfMetric[Int]
  instruction_count: PerfMetric[Int]
  vectorization_eligibility: PerfMetric[Bool]
  hotness: PerfMetric[Int]
  clones: PerfMetric[Int]
  allocated_registers: PerfMetric[Int]
  allocation_sites: PerfMetric[Int]
  bounds_check_sites: PerfMetric[Int]
end

# ———————————————————————————————————————————————————————————————
# The PerfMetric constructors (the bound-kind vocabulary)
# ———————————————————————————————————————————————————————————————
# The five claim words; every consumer compares these exact texts.

def perf_bound_exact() -> String
  "exact"
end

def perf_bound_upper() -> String
  "upper-bound"
end

def perf_bound_estimate() -> String
  "estimate"
end

def perf_bound_measured() -> String
  "measured"
end

def perf_bound_unknown() -> String
  "unknown"
end

# A recorded Int value with its provenance and claim word.
pub def perf_metric_int(value: Int, provenance: PerfFactSource, bound_kind: String, sites: Vec[String]) -> PerfMetric[Int]
  let m: PerfMetric[Int] = PerfMetric {
    value: Option::Some(value),
    provenance: provenance,
    bound_kind: bound_kind,
    sites: sites
  }
  m
end

# A recorded Bool value (vectorization eligibility) with its provenance.
pub def perf_metric_bool(value: Bool, provenance: PerfFactSource, bound_kind: String, sites: Vec[String]) -> PerfMetric[Bool]
  let m: PerfMetric[Bool] = PerfMetric {
    value: Option::Some(value),
    provenance: provenance,
    bound_kind: bound_kind,
    sites: sites
  }
  m
end

# A NOT-RECORDED Bool surface (the LIR view's vectorization eligibility).
def perf_metric_bool_none(provenance: PerfFactSource, bound_kind: String, sites: Vec[String]) -> PerfMetric[Bool]
  let m: PerfMetric[Bool] = PerfMetric {
    value: Option::None,
    provenance: provenance,
    bound_kind: bound_kind,
    sites: sites
  }
  m
end

# A NOT-RECORDED Int surface (value None) with the claim word that names
# what a value would be (e.g. a machine count's documented estimate gap).
pub def perf_metric_none(provenance: PerfFactSource, bound_kind: String, sites: Vec[String]) -> PerfMetric[Int]
  let m: PerfMetric[Int] = PerfMetric {
    value: Option::None,
    provenance: provenance,
    bound_kind: bound_kind,
    sites: sites
  }
  m
end

# The exact static walk (item 40b): the value is walked exactly.
def perf_metric_exact(value: Int, sites: Vec[String]) -> PerfMetric[Int]
  perf_metric_int(value, PerfFactSource::StaticExact, perf_bound_exact(), sites)
end

# The conservative (fail-closed / approximation) static walk.
def perf_metric_upper(value: Int, sites: Vec[String]) -> PerfMetric[Int]
  perf_metric_int(value, PerfFactSource::StaticUpperBound, perf_bound_upper(), sites)
end

# The derived static estimate (exact in neither direction).
def perf_metric_estimate(value: Int, sites: Vec[String]) -> PerfMetric[Int]
  perf_metric_int(value, PerfFactSource::StaticEstimate, perf_bound_estimate(), sites)
end

# The allocator-recorded (machine-level) value.
def perf_metric_machine(value: Int, sites: Vec[String]) -> PerfMetric[Int]
  perf_metric_int(value, PerfFactSource::MachineActual, perf_bound_measured(), sites)
end

# An exact Bool value (vectorization eligibility).
def perf_metric_bool_exact(value: Bool, sites: Vec[String]) -> PerfMetric[Bool]
  perf_metric_bool(value, PerfFactSource::StaticExact, perf_bound_exact(), sites)
end

# The per-function running tallies of the MIR scan (the P0-7 site lists
# ride along so the emitted PerfMetric rows carry their contributing node
# keys).
struct MirPerfTally
  statements: Int = 0
  heap_allocs: Int = 0
  arena_allocs: Int = 0
  escapes: Int = 0
  bounds_checks: Int = 0
  copies: Int = 0
  moves: Int = 0
  drops: Int = 0
  clones: Int = 0
  branches: Int = 0
  vector_ok: Bool = false
  heap_sites: Vec[String] = Vec::new()
  arena_sites: Vec[String] = Vec::new()
  escape_sites: Vec[String] = Vec::new()
  bounds_sites: Vec[String] = Vec::new()
  clone_sites: Vec[String] = Vec::new()
end

# ———————————————————————————————————————————————————————————————
# Type-text and type-shape mirrors (the §11 router vocabulary)
# ———————————————————————————————————————————————————————————————

# The last path segment of a registered type name ("std::simd::Vec4" ->
# "Vec4" — the intrinsic router's receiver_named vocabulary).
def perf_bare_type_name(name: String) -> String
  var i = name.len()
  while i >= 2 do
    if name.slice(i - 2, i) == "::" then
      return name.slice(i, name.len())
    end
    i = i - 1
  end
  name.clone()
end

# Strip one reference layer (mir_effect_strip_ref's mirror).
def perf_strip_ref(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then inner.clone()
  when _ then ty.clone()
  end
end

# Whether a type is String-like (the owned String or the MIR-internal
# StaticStrPtr literal view) — mir_effect_type_is_string_like's mirror.
def perf_type_is_string_like(ty: Type) -> Bool
  let t = perf_strip_ref(ty)
  match t
  when Type::String then true
  when Type::StaticStrPtr then true
  when _ then false
  end
end

# The declared type of a place's base local (Type::Unit for an
# out-of-range id) — mir_effect_place_type's mirror.
def perf_place_type(f: MirFunction, p: Place) -> Type
  if p.local.id >= 0 && p.local.id < f.locals.len() then
    f.locals[p.local.id].ty.clone()
  else
    Type::Unit
  end
end

# Whether an operand holds the String form a `+` concat recognizes —
# mir_effect_operand_is_string's mirror.
def perf_operand_is_string(f: MirFunction, op: MirOperand) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then perf_type_is_string_like(&c.ty)
  when MirOperandKind::MirCopy(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  when MirOperandKind::MirMovePlace(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  when MirOperandKind::MirRead(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  when MirOperandKind::MirConsume(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  end
end

# ———————————————————————————————————————————————————————————————
# The array/vector eligibility predicate and program indexes
# ———————————————————————————————————————————————————————————————

# Whether a type is array/vector-shaped for vectorization_eligibility: an
# inline fixed array (Type::FixedArray / FixedArraySym) or a registered
# std SIMD Adt — bare name Vec2/Vec4/Vec8/Vec16 — the layout_engine
# vector-row vocabulary.
def perf_type_is_array_vector(type_index: Map[Int, String], ty: Type) -> Bool
  match ty
  when Type::FixedArray(_, _) then true
  when Type::FixedArraySym(_, _) then true
  when Type::Adt(tid, _) then
    match type_index.get(tid.id)
    when Option::Some(n) then
      let bare = perf_bare_type_name(&n)
      bare == "Vec2" || bare == "Vec4" || bare == "Vec8" || bare == "Vec16"
    when Option::None then false
    end
  when _ then false
  end
end

# The registered type-name index (TypeId.id -> name) over the program's
# MirTypeDef table.
def perf_type_index_of(mir: MirProgram) -> Map[Int, String]
  var type_index: Map[Int, String] = Map::new()
  for td in mir.types do
    type_index.insert(td.id.id, td.name.clone())
  end
  type_index
end

# ———————————————————————————————————————————————————————————————
# THE MIR SCAN — one PerfReport per optimized MirFunction
# ———————————————————————————————————————————————————————————————

# Tally one operand occurrence by kind (the copies/moves rules:
# MirCopy and MirRead count as copies, MirMovePlace as a move;
# MirConsume and constants are in no audit field).
def perf_count_operand(inout t: MirPerfTally, op: MirOperand) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(_) then t.copies = t.copies + 1
  when MirOperandKind::MirRead(_) then t.copies = t.copies + 1
  when MirOperandKind::MirMovePlace(_) then t.moves = t.moves + 1
  when _ then ()
  end
end

# The stable P0-7 site id of one statement: the carried node key, else
# the "bbN#S<idx>" locator fallback for hand-built IR without origins.
def perf_statement_site(block_id: Int, stmt_index: Int, origin: Option[StableMirNodeId]) -> String
  match origin
  when Option::Some(node) then stable_mir_node_key_of(node)
  when Option::None then "bb" + block_id.to_string() + "#S" + stmt_index.to_string()
  end
end

# The stable P0-7 site id of one terminator: the carried node key, else
# the "bbN#T" locator fallback.
def perf_terminator_site(block_id: Int, origin: Option[StableMirNodeId]) -> String
  match origin
  when Option::Some(node) then stable_mir_node_key_of(node)
  when Option::None then "bb" + block_id.to_string() + "#T"
  end
end

# The per-function scan over the optimized MIR (every block's statements +
# terminator). Field rules: see the module doc — each arm mirrors an
# artifact the optimized MIR actually carries. (fourth-audit P1-6) The
# allocating / arena / clone arms consume the ONE shared typed
# operation_class_of_call; every counted site records its stable P0-7
# node key in the metric's `sites` list.
def perf_report_build(mir: MirProgram, f: MirFunction, type_index: Map[Int, String], fn_index: Map[String, Int]) -> PerfReport
  var t = MirPerfTally {}
  for block in f.blocks do
    t.statements = t.statements + block.statements.len()
    var stmt_index = 0
    while stmt_index < block.statements.len() do
      let st = block.statements[stmt_index]
      let site = perf_statement_site(block.id.id, stmt_index, st.origin.clone())
      match st.kind
      when MirStatementKind::MirAssign(dest, rvalue) then
        if perf_type_is_array_vector(&type_index, &perf_place_type(&f, &dest)) then
          t.vector_ok = true
        end
        match rvalue.kind
        when MirRvalueKind::MirMove(op) then
          perf_count_operand(t, &op)
        when MirRvalueKind::MirRef(_) then
          # MirRef sites: address-taken places (one escape each).
          t.escapes = t.escapes + 1
          t.escape_sites.push(site.clone())
        when MirRvalueKind::MirAggregate(kind, ops) then
          for op in ops do
            perf_count_operand(t, &op)
          end
          match kind
          when AggregateKind::MirArray(_) then
            t.vector_ok = true
          when _ then ()
          end
        when MirRvalueKind::MirBinOp(MirBinOp::Add, lhs, rhs) then
          perf_count_operand(t, &lhs)
          perf_count_operand(t, &rhs)
          # The §11 string-concat allocation site (Add-over-strings).
          let dest_str = perf_type_is_string_like(&perf_place_type(&f, &dest))
          if dest_str || perf_operand_is_string(&f, &lhs) || perf_operand_is_string(&f, &rhs) then
            t.heap_allocs = t.heap_allocs + 1
            t.heap_sites.push(site.clone())
          end
        when MirRvalueKind::MirBinOp(_, lhs, rhs) then
          perf_count_operand(t, &lhs)
          perf_count_operand(t, &rhs)
        when MirRvalueKind::MirUnOp(_, op) then
          perf_count_operand(t, &op)
        when MirRvalueKind::MirDiscriminant(_) then ()
        when MirRvalueKind::MirLen(place) then
          if perf_type_is_array_vector(&type_index, &perf_place_type(&f, &place)) then
            t.vector_ok = true
          end
        when MirRvalueKind::MirCast(_, op, _) then
          perf_count_operand(t, &op)
        when MirRvalueKind::MirRepeat(op, _) then
          # An array-initialization repeat constructs an inline array.
          t.vector_ok = true
          perf_count_operand(t, &op)
        when MirRvalueKind::MirPhi(_) then ()
        end
      when MirStatementKind::MirStorageLive(_) then ()
      when MirStatementKind::MirStorageDead(_) then ()
      when MirStatementKind::MirNop then ()
      when MirStatementKind::MirContractCheck(_, op) then
        perf_count_operand(t, &op)
      when MirStatementKind::MirBudgetConsume(_, _) then ()
      when MirStatementKind::MirEffectRecord(_, op) then
        perf_count_operand(t, &op)
      when MirStatementKind::MirEffectPerform(_, _, _, op1, op2) then
        perf_count_operand(t, &op1)
        perf_count_operand(t, &op2)
      when MirStatementKind::MirEffectFrameEnter(_, _, _, _, op) then
        perf_count_operand(t, &op)
      when MirStatementKind::MirEffectFrameExit then ()
      end
      stmt_index = stmt_index + 1
    end
    let term_site = perf_terminator_site(block.id.id, block.terminator.origin.clone())
    match block.terminator.kind
    when MirTerminatorKind::MirGoto(_) then
      t.branches = t.branches + 1
    when MirTerminatorKind::MirReturn then ()
    when MirTerminatorKind::MirUnreachable then ()
    when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
      t.branches = t.branches + 1
      perf_count_operand(t, &op)
    when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
      # (fourth-audit P1-6) ONE shared typed classification: allocation,
      # arena capability and derived-Clone (the exact flags; a Clone call
      # allocates its backing so both fire).
      let op = operation_class_of_call(mir, f, &type_index, &fn_index, &func, &args, intrinsic)
      if op.allocate then
        t.heap_allocs = t.heap_allocs + 1
        t.heap_sites.push(term_site.clone())
      end
      if op.arena_allocation then
        t.arena_allocs = t.arena_allocs + 1
        t.arena_sites.push(term_site.clone())
      end
      if op.clone then
        t.clones = t.clones + 1
        t.clone_sites.push(term_site.clone())
      end
      for arg in args do
        match arg.value
        when MirCallValue::Value(op2) then
          perf_count_operand(t, &op2)
          match op2.kind
          when MirOperandKind::MirCopy(p) then
            if p.projections.is_empty() then
              t.escapes = t.escapes + 1
              t.escape_sites.push(term_site.clone())
            end
          when MirOperandKind::MirMovePlace(p) then
            if p.projections.is_empty() then
              t.escapes = t.escapes + 1
              t.escape_sites.push(term_site.clone())
            end
          when MirOperandKind::MirRead(p) then
            if p.projections.is_empty() then
              t.escapes = t.escapes + 1
              t.escape_sites.push(term_site.clone())
            end
          when MirOperandKind::MirConsume(p) then
            if p.projections.is_empty() then
              t.escapes = t.escapes + 1
              t.escape_sites.push(term_site.clone())
            end
          when _ then ()
          end
        when MirCallValue::Place(p) then
          if p.projections.is_empty() then
            t.escapes = t.escapes + 1
            t.escape_sites.push(term_site.clone())
          end
        end
      end
    when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
      t.branches = t.branches + 1
      perf_count_operand(t, &cond)
      match msg
      when AssertMessage::BoundsCheck(index_op, len_op) then
        # A surviving check (a proven one became a MirGoto — module doc).
        t.bounds_checks = t.bounds_checks + 1
        t.bounds_sites.push(term_site.clone())
        perf_count_operand(t, &index_op)
        perf_count_operand(t, &len_op)
      when _ then ()
      end
    when MirTerminatorKind::MirAbort then ()
    when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
      # drops: one implicit destruction terminator.
      t.drops = t.drops + 1
    end
  end
  PerfReport {
    function_key: f.name.clone(),
    heap_allocations: perf_metric_upper(t.heap_allocs, t.heap_sites.clone()),
    arena_allocations: perf_metric_exact(t.arena_allocs, t.arena_sites.clone()),
    escapes: perf_metric_upper(t.escapes, t.escape_sites.clone()),
    stack_bytes: perf_metric_none(PerfFactSource::MachineActual, perf_bound_unknown(), Vec::new()),
    bounds_checks: perf_metric_exact(t.bounds_checks, t.bounds_sites.clone()),
    proven_removed_bounds: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    copies: perf_metric_exact(t.copies, Vec::new()),
    moves: perf_metric_exact(t.moves, Vec::new()),
    drops: perf_metric_exact(t.drops, Vec::new()),
    retain_release: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    clones: perf_metric_exact(t.clones, t.clone_sites.clone()),
    spills: perf_metric_none(PerfFactSource::MachineActual, perf_bound_unknown(), Vec::new()),
    reloads: perf_metric_none(PerfFactSource::MachineActual, perf_bound_unknown(), Vec::new()),
    inline_decisions: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    branch_count: perf_metric_exact(t.branches, Vec::new()),
    instruction_count: perf_metric_estimate(2 * t.statements + 3 * f.blocks.len(), Vec::new()),
    vectorization_eligibility: perf_metric_bool_exact(t.vector_ok, Vec::new()),
    hotness: perf_metric_none(PerfFactSource::ProfileMeasured, perf_bound_unknown(), Vec::new()),
    allocated_registers: perf_metric_none(PerfFactSource::MachineActual, perf_bound_unknown(), Vec::new()),
    allocation_sites: perf_metric_upper(t.heap_allocs, t.heap_sites.clone()),
    bounds_check_sites: perf_metric_exact(t.bounds_checks, t.bounds_sites.clone())
  }
end

# ———————————————————————————————————————————————————————————————
# The public builders
# ———————————————————————————————————————————————————————————————

# One PerfReport over an OPTIMIZED MirFunction of the given program.
# ANCHOR NOTE: the §11 allocation classification is program-scoped (an
# in-program callee's allocation must land on the CALLEE's report, never
# the site), so the program rides along — a lone function cannot classify
# its call sites. The classification itself is the ONE shared
# operation_class_of_call (fourth-audit P1-6).
pub def perf_report_of_mir_function(mir: MirProgram, f: MirFunction) -> PerfReport
  let type_index = perf_type_index_of(&mir)
  let fn_index = mir_function_index_of(&mir)
  perf_report_build(mir, f, &type_index, &fn_index)
end

# One PerfReport over the LIR artifacts (function + allocation) when they
# are available — the allocator-side view. spills = the allocator's
# recorded spill-store events (LirAlloc.spills — the "(call position,
# vreg)" store-before-call list; the alternative readings — the
# memory-resident vreg count over LirAlloc.segs_of's phys < 0 segments and
# LirAlloc.slots — are documented but unused); reloads = LirAlloc.reloads
# (the recorded post-call slot re-loads — the emitter inserts no slot-load
# STATEMENTS, so the records ARE the count); stack_bytes =
# LirAlloc.frame_bytes (the aligned frame allocation size); branch_count =
# the LirJump + LirSwitch terms (MIR asserts and switches lower to these —
# LIR has no other branching term). Every MIR-level metric is None with
# bound_kind "unknown": bounds checks, drops and the operand traffic do
# not survive into LIR's scalar subset (documented). instruction_count is
# None/estimate: the emitted machine WORD count exists only inside the
# per-route emitter buffers and never rides LirFunction/LirAlloc (the
# prerequisite is recorded at perf_facts_of_lir); allocated_registers =
# LirAlloc.cc_used (measured).
pub def perf_report_of_lir_alloc(lir_fn: LirFunction, alloc: LirAlloc) -> PerfReport
  var branches = 0
  for block in lir_fn.blocks do
    match block.term.kind
    when LirTermKind::LirJump(_) then branches = branches + 1
    when LirTermKind::LirSwitch(_, _, _) then branches = branches + 1
    when LirTermKind::LirRet(_) then ()
    when LirTermKind::LirTrap then ()
    when LirTermKind::LirCall(_, _, _, _, _) then ()
    end
  end
  PerfReport {
    function_key: lir_fn.name.clone(),
    heap_allocations: perf_metric_none(PerfFactSource::StaticUpperBound, perf_bound_unknown(), Vec::new()),
    arena_allocations: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    escapes: perf_metric_none(PerfFactSource::StaticUpperBound, perf_bound_unknown(), Vec::new()),
    stack_bytes: perf_metric_machine(alloc.frame_bytes, Vec::new()),
    bounds_checks: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    proven_removed_bounds: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    copies: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    moves: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    drops: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    retain_release: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    clones: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    spills: perf_metric_machine(alloc.spills.len(), Vec::new()),
    reloads: perf_metric_machine(alloc.reloads.len(), Vec::new()),
    inline_decisions: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    branch_count: perf_metric_machine(branches, Vec::new()),
    instruction_count: perf_metric_none(PerfFactSource::StaticEstimate, perf_bound_estimate(), Vec::new()),
    vectorization_eligibility: perf_metric_bool_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()),
    hotness: perf_metric_none(PerfFactSource::ProfileMeasured, perf_bound_unknown(), Vec::new()),
    allocated_registers: perf_metric_machine(alloc.cc_used.len(), Vec::new()),
    allocation_sites: perf_metric_none(PerfFactSource::StaticUpperBound, perf_bound_unknown(), Vec::new()),
    bounds_check_sites: perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new())
  }
end

# The §44 session helper: one PerfReport per function of the optimized
# program, SORTED by function_key (ties keep program order).
pub def perf_reports_of_program(mir: MirProgram) -> Vec[PerfReport]
  let type_index = perf_type_index_of(&mir)
  let fn_index = mir_function_index_of(&mir)
  var reports: Vec[PerfReport] = Vec::new()
  for f in mir.functions do
    reports.push(perf_report_build(mir.clone(), f, &type_index, &fn_index))
  end
  reports.sort_by(|a, b| perf_report_lt(a, b))
  reports
end

def perf_report_lt(a: PerfReport, b: PerfReport) -> Bool
  a.function_key < b.function_key
end

# ———————————————————————————————————————————————————————————————————
# The labeled fact rows (audit item 57; item 40b provenance taxonomy)
# ———————————————————————————————————————————————————————————————————
# ONE row per surface the view RECORDS (fourth-audit P1-6): the row IS a
# PerfMetric[Int] — value Option::Some(v) for a recorded value (Some(0)
# included), Option::None for a surface the view does not record — with
# the same provenance, bound_kind and site list as the aggregate metric.
# The row's field word names the surface; a per-site row carries its
# stable P0-7 site ids in metric.sites.
#   StaticExact      — a value walked EXACTLY over the static artifact;
#   StaticUpperBound — a conservative walk that may over-count;
#   StaticEstimate   — a DERIVED estimate (exact in neither direction);
#   MachineActual    — a value RECORDED by the LIR lowering / register
#                      allocator;
#   ProfileMeasured  — a runtime profile-fed value (no producer in the
#                      current views — the PGO profile is external and
#                      perf_report reads no profile).

pub enum PerfFactSource
  StaticExact
  StaticUpperBound
  StaticEstimate
  MachineActual
  ProfileMeasured
end

# The fact vocabulary. Every aggregate PerfReport metric has a row field;
# the row-only families (the register / machine / extra decision words)
# are declared for the row protocol and emitted by the view that records
# them.
pub enum PerfField
  HeapAllocations
  ArenaAllocations
  Escapes
  StackBytes
  BoundsChecks
  ProvenRemovedBounds
  Copies
  Moves
  Drops
  RetainRelease
  Clones
  Spills
  Reloads
  InlineDecisions
  BranchCount
  InstructionCount
  VectorizationEligible
  Hotness
  AllocatedRegisters
  MachineInstructionCount
  AllocationSites
  BoundsCheckSites
  VectorizationDecisions
  InlineDecisionsM
end

# One labeled fact: the field word + its typed metric record.
pub struct PerfFact
  field: PerfField
  metric: PerfMetric[Int]
end

def perf_fact_of(field: PerfField, metric: PerfMetric[Int]) -> PerfFact
  PerfFact { field: field, metric: metric }
end

# The Int projection of the Bool vectorization metric (the row protocol's
# value domain is Int; 1 = eligible, 0 = not).
def perf_metric_bool_to_int(metric: PerfMetric[Bool]) -> PerfMetric[Int]
  match metric.value
  when Option::Some(b) then
    var v = 0
    if b then v = 1 end
    perf_metric_int(v, metric.provenance, metric.bound_kind.clone(), metric.sites.clone())
  when Option::None then
    perf_metric_none(metric.provenance, metric.bound_kind.clone(), metric.sites.clone())
  end
end

# (audit item 34) The vectorization-decision fact. The bounded SLP pass
# (mir.tg slp_vectorize, opt_level >= 2) appends one "slp-vectorized"
# OptimizationDecision row per accepted group (pass "slp-vectorize") to
# the optimized program's journal when the capturing optimizer entry ran.
# This row counts them for the function: an exact Some(n) over a captured
# journal — Some(0) when the journal exists and this function accepted no
# group, so a recorded zero stays DISTINCT from an unrecorded surface —
# and None/unknown when no capturing run left a journal.
def perf_vectorization_decisions_fact(mir: MirProgram, f: MirFunction) -> PerfFact
  match mir.opt_decisions
  when Option::Some(rows) then
    var count = 0
    var sites: Vec[String] = Vec::new()
    for row in rows do
      if row.pass == "slp-vectorize" && row.decision == "slp-vectorized" && row.symbol == f.name then
        count = count + 1
        sites.push(row.site.clone())
      end
    end
    perf_fact_of(PerfField::VectorizationDecisions, perf_metric_exact(count, sites))
  when Option::None then
    perf_fact_of(PerfField::VectorizationDecisions, perf_metric_none(PerfFactSource::StaticExact, perf_bound_unknown(), Vec::new()))
  end
end

# The MIR view's labeled rows: the full metric set of perf_report_of_
# mir_function, projected field by field. The allocation/escape metrics
# carry their conservative bound words and P0-7 site lists; the surfaces
# the MIR artifact does not record (stack bytes, proven-removed bounds,
# spills/reloads, inline decisions, hotness, the register/site families)
# are rows whose value is None with bound_kind "unknown" — a recorded
# zero is Some(0) and stays DISTINCT from an unrecorded surface.
pub def perf_facts_of_mir_function(mir: MirProgram, f: MirFunction) -> Vec[PerfFact]
  let report = perf_report_of_mir_function(mir, f)
  var facts: Vec[PerfFact] = Vec::new()
  facts.push(perf_fact_of(PerfField::HeapAllocations, report.heap_allocations))
  facts.push(perf_fact_of(PerfField::ArenaAllocations, report.arena_allocations))
  facts.push(perf_fact_of(PerfField::Escapes, report.escapes))
  facts.push(perf_fact_of(PerfField::StackBytes, report.stack_bytes))
  facts.push(perf_fact_of(PerfField::BoundsChecks, report.bounds_checks))
  facts.push(perf_fact_of(PerfField::ProvenRemovedBounds, report.proven_removed_bounds))
  facts.push(perf_fact_of(PerfField::Copies, report.copies))
  facts.push(perf_fact_of(PerfField::Moves, report.moves))
  facts.push(perf_fact_of(PerfField::Drops, report.drops))
  facts.push(perf_fact_of(PerfField::RetainRelease, report.retain_release))
  facts.push(perf_fact_of(PerfField::Clones, report.clones))
  facts.push(perf_fact_of(PerfField::Spills, report.spills))
  facts.push(perf_fact_of(PerfField::Reloads, report.reloads))
  facts.push(perf_fact_of(PerfField::InlineDecisions, report.inline_decisions))
  facts.push(perf_fact_of(PerfField::BranchCount, report.branch_count))
  facts.push(perf_fact_of(PerfField::InstructionCount, report.instruction_count))
  facts.push(perf_fact_of(PerfField::VectorizationEligible, perf_metric_bool_to_int(report.vectorization_eligibility)))
  facts.push(perf_fact_of(PerfField::Hotness, report.hotness))
  facts.push(perf_fact_of(PerfField::AllocatedRegisters, report.allocated_registers))
  facts.push(perf_fact_of(PerfField::AllocationSites, report.allocation_sites))
  facts.push(perf_fact_of(PerfField::BoundsCheckSites, report.bounds_check_sites))
  facts.push(perf_vectorization_decisions_fact(mir, f))
  facts
end

# The LIR/allocator view's labeled rows: the full metric set of
# perf_report_of_lir_alloc (the allocator-recorded surfaces are Some/
# "measured"; every MIR-level surface is None) PLUS the
# MachineInstructionCount row. That row is None with bound_kind
# "estimate": the emitted machine WORD count exists only inside the
# per-route emitter buffers after LIR and never rides the LIR artifacts —
# the aarch64 emitter (lir.tg:18276 lir_emit_fn) and the x86-64 emitter
# append their encodings into the shared CodegenCtx.text CodeBuffer
# (codegen.tg:253); neither returns a per-function word vec. Exposing it
# needs the emitter to record (buf_pos(&ctx.text) after lir_emit_fn minus
# the function's start offset) / 4 on a per-function artifact field; until
# then the value stays None (the MIR estimate is a separate
# InstructionCount metric, never presented as the machine count).
pub def perf_facts_of_lir(lir_fn: LirFunction, alloc: LirAlloc) -> Vec[PerfFact]
  let report = perf_report_of_lir_alloc(lir_fn, alloc)
  var facts: Vec[PerfFact] = Vec::new()
  facts.push(perf_fact_of(PerfField::HeapAllocations, report.heap_allocations))
  facts.push(perf_fact_of(PerfField::ArenaAllocations, report.arena_allocations))
  facts.push(perf_fact_of(PerfField::Escapes, report.escapes))
  facts.push(perf_fact_of(PerfField::StackBytes, report.stack_bytes))
  facts.push(perf_fact_of(PerfField::BoundsChecks, report.bounds_checks))
  facts.push(perf_fact_of(PerfField::ProvenRemovedBounds, report.proven_removed_bounds))
  facts.push(perf_fact_of(PerfField::Copies, report.copies))
  facts.push(perf_fact_of(PerfField::Moves, report.moves))
  facts.push(perf_fact_of(PerfField::Drops, report.drops))
  facts.push(perf_fact_of(PerfField::RetainRelease, report.retain_release))
  facts.push(perf_fact_of(PerfField::Clones, report.clones))
  facts.push(perf_fact_of(PerfField::Spills, report.spills))
  facts.push(perf_fact_of(PerfField::Reloads, report.reloads))
  facts.push(perf_fact_of(PerfField::InlineDecisions, report.inline_decisions))
  facts.push(perf_fact_of(PerfField::BranchCount, report.branch_count))
  facts.push(perf_fact_of(PerfField::InstructionCount, report.instruction_count))
  facts.push(perf_fact_of(PerfField::VectorizationEligible, perf_metric_bool_to_int(report.vectorization_eligibility)))
  facts.push(perf_fact_of(PerfField::Hotness, report.hotness))
  facts.push(perf_fact_of(PerfField::AllocatedRegisters, report.allocated_registers))
  facts.push(perf_fact_of(PerfField::AllocationSites, report.allocation_sites))
  facts.push(perf_fact_of(PerfField::BoundsCheckSites, report.bounds_check_sites))
  facts.push(perf_fact_of(PerfField::MachineInstructionCount,
    perf_metric_none(PerfFactSource::StaticEstimate, perf_bound_estimate(), Vec::new())))
  facts
end
