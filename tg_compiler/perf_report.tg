# Tangerine Compiler — per-function performance report (audit §44)
# Self-hosting compiler written in Tangerine
#
# The §44 slice: ONE compact PerfReport per function of an OPTIMIZED
# MirProgram, plus the LIR view when the allocation artifacts are
# available — the per-function introspection audit fields over the REAL
# post-optimization artifacts: "inspect actual optimized MIR/LIR; then
# optimization work is directed by actual causes." The module counts
# what the artifacts already carry; nothing here runs passes or mutates
# state, and every surface the artifacts do NOT record stays zero —
# never invented (the sibling discipline of abi_report.tg).
#
# PIPELINE ARTIFACTS — what the optimized MIR actually records:
# optimize_mir_verified (mir.tg) batches inline_functions,
# eliminate_dead_code, propagate_copies, fold_constants,
# fold_enum_ctor_reads, propagate_constants, eliminate_dead_stores,
# simplify_cfg, strength_reduction and (opt_level >= 2)
# global_value_numbering, loop_invariant_code_motion,
# eliminate_bounds_checks, then simplify_moves + a final
# eliminate_dead_code, then (opt_level >= 2) escape_analysis and
# (opt_level >= 3) apply_pgo_optimizations (a FILE-fed pass: the PGO
# profile never rides the program). NO pass records statistics
# anywhere — every pass is an in-out Unit rewrite and
# verifier_program_checkpoint journals only verification diagnostics —
# so the pass-PRODUCED metrics are unrecoverable from the optimized
# program and stay 0 here (documented per field): the bounds checks
# eliminate_bounds_checks PROVED AND REMOVED (it replaces provable
# MirAssert/BoundsCheck terms with MirGoto and returns Unit —
# mir.tg:19641), the inline decisions of inline_functions (an inlined
# call site becomes a plain MirGoto; the only residue is the
# "_inlined" local-name suffix — not a count), the spill/reload
# decisions (allocator-side LIR data), the heap-to-stack promotions of
# escape_analysis and the PGO counts. The module's nonzero counts
# therefore measure the SURVIVING optimized body: the remaining
# BoundsCheck asserts, the remaining call sites and their operand
# traffic.
#
# COUNTING RULES (field by field — the anchors of the report):
#   heap_allocations      — the §11 allocating MirCall sites + the §11
#     string-concat statement sites (the ONLY two site kinds the §11
#     effect machinery's DIRECT scan classifies allocating). The call
#     mirror reuses the machinery's own predicates (types.tg's
#     effect_summary_of_intrinsic / effect_summary_of_extern_name /
#     intrinsic_id_of_call — the exact decision path of
#     mir_effect_classify_call, mir.tg:25893): a STAMPED intrinsic
#     allocates iff its effect record's may_allocate is true; an
#     unstamped MirFnItem call allocates iff the callee has NO body in
#     this program and the bodyless route (intrinsic-name router, then
#     the extern-name seed table) says may_allocate — an unknown
#     bodyless or INDIRECT (closure/function-pointer) callee counts
#     (the §11 fail-closed rule). A call to an in-program callee never
#     counts at the SITE — its allocations land on the callee's own
#     report (the §11 transitive-edge rule). The concat mirror is
#     mir_effect_scan_function's: a MirBinOp::Add with a String-like
#     destination or operand (mir.tg:25988). MirDeinit terminators and
#     algebraic-effect performs are NOT MirCall sites and never count
#     here (documented).
#   arena_allocations      — MirCall sites whose callee NAME text
#     contains "arena" or "bump" (case-insensitive — the audit's
#     documented heuristic; "slab" is not a matched word).
#   escapes                — MirRef rvalue sites (address-taken
#     places) + call ARGUMENT occurrences that are BARE local places
#     (no projections, in any of the operand forms incl. the Place
#     form) — the documented approximation of the escape_analysis
#     ArgEscape sites (mir.tg:20885 — every call argument local
#     escapes to at least ArgEscape).
#   stack_bytes            — 0 from the MIR (a frame size exists only
#     after LIR allocation: LirAlloc.frame_bytes fills this in the
#     LIR view).
#   bounds_checks          — MirAssert terminators whose message is
#     AssertMessage::BoundsCheck — the checks that SURVIVED the
#     optimizer (an eliminated check is a MirGoto now).
#   proven_removed_bounds  — 0: the optimizer records no per-function
#     counter (documented above); nonzero requires a pass-side
#     journal.
#   copies                 — MirCopy operand occurrences + MirRead
#     operand occurrences (the documented rule) over every operand
#     position of the function's statements and terminator.
#   moves                  — MirMovePlace operand occurrences (same
#     positions). MirConsume operands are in no audit field and are
#     not counted.
#   drops                  — MirDeinit terminators.
#   retain_release         — MirCall sites whose callee name text
#     contains "retain", "release" or "clone" (case-insensitive —
#     documented heuristic over the mangled emission name; a stamped
#     intrinsic without a MirFnItem name has no text and never
#     matches).
#   spills / reloads       — 0 from the MIR (allocator-side records,
#     see the LIR view).
#   inline_decisions       — 0: the inliner records no decisions
#     (documented above).
#   branch_count           — MirGoto + MirSwitchInt + MirAssert
#     terminators (the jump / multiway-switch / conditional-check
#     control-transfer kinds — MirCall / MirDeinit / MirReturn /
#     MirAbort / MirUnreachable never count; documented).
#   est_instruction_count  — 2 * statements + 3 * terminators over the
#     whole function (the documented estimate; one terminator per
#     block).
#   vectorization_eligible — any STATEMENT operates on an array/vector
#     type: the assigned local's declared type is an inline-array
#     (Type::FixedArray / FixedArraySym) or a registered std SIMD Adt
#     (bare name Vec2/Vec4/Vec8/Vec16 — the layout_engine vector-row
#     vocabulary), or the rvalue CONSTRUCTS an array (MirAggregate
#     with AggregateKind::MirArray, MirRepeat) or reads an array's
#     length (MirLen over an array-typed local).
#   hotness                — 0: no per-function hotness is recorded on
#     the optimized program (PGO counts live in the external profile
#     file apply_pgo_optimizations reads; MirFunction.attr_cold is a
#     declared layout hint, not a count).
#
# DETERMINISM: pure reads of the program; the per-program helper
# returns reports SORTED by function_key (ties keep program order).
# The LIR view (perf_report_of_lir_alloc) reads ONLY the lowering +
# allocation artifacts (LirFunction / LirAlloc) and fills spills /
# reloads / stack_bytes / branch_count; every other field stays
# defaulted (doc note in the builder).

use std::core::{Option}
use std::collections::{Vec, Map, Set}

use tg_compiler::mir::{
  MirProgram, MirFunction, MirStatementKind, MirRvalueKind, MirBinOp, MirOperand,
  MirOperandKind, MirConstantKind, MirCallArg, MirCallValue, MirTerminatorKind,
  AggregateKind, AssertMessage, Place
}
use tg_compiler::types::{
  Type, intrinsic_id_of_call, effect_summary_of_intrinsic, effect_summary_of_extern_name
}
use tg_compiler::ids::{IntrinsicId}
use tg_compiler::lir::{LirFunction, LirAlloc, LirTermKind}

# ———————————————————————————————————————————————————————————————
# The §44 record — one PerfReport per function
# ———————————————————————————————————————————————————————————————
# Every numeric field is defaulted (zero means "the artifact records
# nothing" — never a measured zero unless a rule says so; the field
# docs above state which rule each field counts under).

pub struct PerfReport
  function_key: String = ""
  heap_allocations: Int = 0
  arena_allocations: Int = 0
  escapes: Int = 0
  stack_bytes: Int = 0
  bounds_checks: Int = 0
  proven_removed_bounds: Int = 0
  copies: Int = 0
  moves: Int = 0
  drops: Int = 0
  retain_release: Int = 0
  spills: Int = 0
  reloads: Int = 0
  inline_decisions: Int = 0
  branch_count: Int = 0
  est_instruction_count: Int = 0
  vectorization_eligible: Bool = false
  hotness: Int = 0
end

# The per-function running tallies of the MIR scan (statement counts,
# operand-kind occurrences, terminator counts, the array/vector flag).
struct MirPerfTally
  statements: Int = 0
  heap_allocs: Int = 0
  arena_allocs: Int = 0
  escapes: Int = 0
  bounds_checks: Int = 0
  copies: Int = 0
  moves: Int = 0
  drops: Int = 0
  retain_release: Int = 0
  branches: Int = 0
  vector_ok: Bool = false
end

# ———————————————————————————————————————————————————————————————
# Type-text and type-shape mirrors (the §11 router vocabulary)
# ———————————————————————————————————————————————————————————————

# The last path segment of a registered type name ("std::simd::Vec4" ->
# "Vec4" — the receiver_named vocabulary of the intrinsic router).
def perf_bare_type_name(name: String) -> String
  var i = name.len()
  while i >= 2 do
    if name.slice(i - 2, i) == "::" then
      return name.slice(i, name.len())
    end
    i = i - 1
  end
  name.clone()
end

# The bare registered name of a Type::Adt ("" for non-Adt types) — the
# mirror of mir_effect_adt_name over the program's MirTypeDef table.
def perf_adt_name(type_index: Map[Int, String], ty: Type) -> String
  match ty
  when Type::Adt(tid, _) then
    match type_index.get(tid.id)
    when Option::Some(n) then perf_bare_type_name(&n)
    when Option::None then "".to_string()
    end
  when _ then "".to_string()
  end
end

# Strip one reference layer (the router's receiver facts see the
# referenced value's type) — the mirror of mir_effect_strip_ref.
def perf_strip_ref(ty: Type) -> Type
  match ty
  when Type::RefInternal(inner, _) then inner.clone()
  when _ then ty.clone()
  end
end

# Whether a type is String-like (the owned String or the MIR-internal
# StaticStrPtr literal view) — the mirror of mir_effect_type_is_string_like.
def perf_type_is_string_like(ty: Type) -> Bool
  let t = perf_strip_ref(ty)
  match t
  when Type::String then true
  when Type::StaticStrPtr then true
  when _ then false
  end
end

# The declared type of a place's base local (Type::Unit for an
# out-of-range id — the defensive mirror of mir_effect_place_type).
def perf_place_type(f: MirFunction, p: Place) -> Type
  if p.local.id >= 0 && p.local.id < f.locals.len() then
    f.locals[p.local.id].ty.clone()
  else
    Type::Unit
  end
end

# The type of one call argument VALUE (the operand's type; a place
# operand reads its base local's declared type) — the mirror of
# mir_effect_arg_value_type.
def perf_arg_value_type(f: MirFunction, arg: MirCallArg) -> Type
  match arg.value
  when MirCallValue::Value(op) then
    match op.kind
    when MirOperandKind::MirConstant(c) then c.ty.clone()
    when MirOperandKind::MirCopy(p) then perf_place_type(f, &p)
    when MirOperandKind::MirMovePlace(p) then perf_place_type(f, &p)
    when MirOperandKind::MirRead(p) then perf_place_type(f, &p)
    when MirOperandKind::MirConsume(p) then perf_place_type(f, &p)
    end
  when MirCallValue::Place(p) then perf_place_type(f, &p)
  end
end

# Whether an operand holds the String form a `+` concat recognizes —
# the mirror of mir_effect_operand_is_string.
def perf_operand_is_string(f: MirFunction, op: MirOperand) -> Bool
  match op.kind
  when MirOperandKind::MirConstant(c) then perf_type_is_string_like(&c.ty)
  when MirOperandKind::MirCopy(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  when MirOperandKind::MirMovePlace(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  when MirOperandKind::MirRead(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  when MirOperandKind::MirConsume(p) then perf_type_is_string_like(&perf_place_type(f, &p))
  end
end

# The type-directed router facts of a call's receiver/needle arguments —
# the mirror of mir_effect_router_facts (arguments 0 and 1 only).
def perf_router_facts(f: MirFunction, type_index: Map[Int, String], args: Vec[MirCallArg]) -> (Type, String, Type, String, Bool, Bool)
  var recv_ty = Type::Unit
  var recv_named = "".to_string()
  var needle_ty = Type::Unit
  var needle_named = "".to_string()
  var recv_is_string = false
  var needle_is_string = false
  if args.len() > 0 then
    recv_ty = perf_strip_ref(perf_arg_value_type(f, &args[0]))
    recv_named = perf_adt_name(&type_index, &recv_ty)
    recv_is_string = perf_type_is_string_like(&recv_ty)
  end
  if args.len() > 1 then
    needle_ty = perf_strip_ref(perf_arg_value_type(f, &args[1]))
    needle_named = perf_adt_name(&type_index, &needle_ty)
    needle_is_string = perf_type_is_string_like(&needle_ty)
  end
  (recv_ty, recv_named, needle_ty, needle_named, recv_is_string, needle_is_string)
end

# ———————————————————————————————————————————————————————————————
# The §11 allocating-call mirror (mir_effect_classify_call's decision)
# ———————————————————————————————————————————————————————————————

# The MirFnItem name of a call-target operand ("" when the target is
# not a named function item — an indirect closure/pointer value).
def perf_callee_name_of(func: MirOperand) -> Option[String]
  match func.kind
  when MirOperandKind::MirConstant(c) then
    match c.kind
    when MirConstantKind::MirFnItem(name) then Option::Some(name.clone())
    when _ then Option::None
    end
  when _ then Option::None
  end
end

# The §11 allocating decision of a BODYLESS callee name (the callee
# has no body in this program): the intrinsic-name router first, then
# the extern-name seed table, then fail-closed unknown — the exact
# route of mir_effect_classify_bodyless.
def perf_bodyless_allocates(f: MirFunction, type_index: Map[Int, String], name: String, args: Vec[MirCallArg]) -> Bool
  let facts = perf_router_facts(f, type_index, args)
  match intrinsic_id_of_call(name.clone(), facts.0, facts.1, facts.2, facts.3, "".to_string(), facts.4, facts.5)
  when Option::Some(iid) then
    effect_summary_of_intrinsic(iid).may_allocate
  when Option::None then
    match effect_summary_of_extern_name(name.clone())
    when Option::Some(sum) then sum.may_allocate
    when Option::None then true
    end
  end
end

# Whether one MirCall SITE allocates, mirroring mir_effect_classify_call
# (mir.tg:25893): a stamped intrinsic decides by its effect record; an
# unstamped named callee allocates only when it has NO body in this
# program (an in-program callee's allocations land on the callee's own
# report — the transitive-edge rule); an indirect callee is unknown and
# counts (fail closed).
def perf_call_allocates(f: MirFunction, type_index: Map[Int, String], bodied: Set[String], func: MirOperand, args: Vec[MirCallArg], intrinsic: Option[IntrinsicId]) -> Bool
  match intrinsic
  when Option::Some(iid) then
    effect_summary_of_intrinsic(iid).may_allocate
  when Option::None then
    match perf_callee_name_of(&func)
    when Option::Some(name) then
      if bodied.contains(&name) then
        false
      else
        perf_bodyless_allocates(f, type_index, name, args)
      end
    when Option::None then
      true
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The array/vector eligibility predicate
# ———————————————————————————————————————————————————————————————

# Whether a type is array/vector-shaped for the vectorization_eligible
# rule: an inline fixed array (Type::FixedArray / FixedArraySym) or a
# registered std SIMD Adt — bare name Vec2/Vec4/Vec8/Vec16 — the
# layout_engine vector-row vocabulary.
def perf_type_is_array_vector(type_index: Map[Int, String], ty: Type) -> Bool
  match ty
  when Type::FixedArray(_, _) then true
  when Type::FixedArraySym(_, _) then true
  when Type::Adt(tid, _) then
    match type_index.get(tid.id)
    when Option::Some(n) then
      let bare = perf_bare_type_name(&n)
      bare == "Vec2" || bare == "Vec4" || bare == "Vec8" || bare == "Vec16"
    when Option::None then false
    end
  when _ then false
  end
end

# ———————————————————————————————————————————————————————————————
# The program-level indexes (mir_effect's fn_index/type_index twins)
# ———————————————————————————————————————————————————————————————

# The registered type-name index (TypeId.id -> registered name) over
# the program's MirTypeDef table.
def perf_type_index_of(mir: MirProgram) -> Map[Int, String]
  var type_index: Map[Int, String] = Map::new()
  for td in mir.types do
    type_index.insert(td.id.id, td.name.clone())
  end
  type_index
end

# The emission names of the functions WITH a body in this program (the
# body test of mir_effect_classify_call's fn_index lookup — a name
# whose entry has no blocks is a bodyless extern declaration).
def perf_bodied_names_of(mir: MirProgram) -> Set[String]
  var bodied: Set[String] = Set::new()
  for f in mir.functions do
    if f.blocks.len() > 0 then
      bodied.insert(f.name.clone())
    end
  end
  bodied
end

# ———————————————————————————————————————————————————————————————
# THE MIR SCAN — one PerfReport per optimized MirFunction
# ———————————————————————————————————————————————————————————————

# Tally one operand occurrence by its kind (the copies/moves rules:
# MirCopy and MirRead count as copies, MirMovePlace as a move;
# MirConsume and constants are in no audit field).
def perf_count_operand(inout t: MirPerfTally, op: MirOperand) -> Unit
  match op.kind
  when MirOperandKind::MirCopy(_) then t.copies = t.copies + 1
  when MirOperandKind::MirRead(_) then t.copies = t.copies + 1
  when MirOperandKind::MirMovePlace(_) then t.moves = t.moves + 1
  when _ then ()
  end
end

# The per-function scan over the optimized MIR (statements +
# terminators of every block). Field rules: see the module doc — every
# arm mirrors an artifact the optimized MIR actually carries.
def perf_report_build(f: MirFunction, type_index: Map[Int, String], bodied: Set[String]) -> PerfReport
  var t = MirPerfTally {}
  for block in f.blocks do
    t.statements = t.statements + block.statements.len()
    for st in block.statements do
      match st.kind
      when MirStatementKind::MirAssign(dest, rvalue) then
        # vectorization_eligible: an array/vector-typed destination, an
        # array CONSTRUCTION, or an array-length read.
        if perf_type_is_array_vector(&type_index, &perf_place_type(&f, &dest)) then
          t.vector_ok = true
        end
        match rvalue.kind
        when MirRvalueKind::MirMove(op) then
          perf_count_operand(t, &op)
        when MirRvalueKind::MirRef(_) then
          # MirRef sites: address-taken places (one escape each).
          t.escapes = t.escapes + 1
        when MirRvalueKind::MirAggregate(kind, ops) then
          for op in ops do
            perf_count_operand(t, &op)
          end
          match kind
          when AggregateKind::MirArray(_) then
            t.vector_ok = true
          when _ then ()
          end
        when MirRvalueKind::MirBinOp(MirBinOp::Add, lhs, rhs) then
          perf_count_operand(t, &lhs)
          perf_count_operand(t, &rhs)
          # The §11 string-concat allocation site (the mirror of
          # mir_effect_scan_function's Add-over-strings arm): a concat
          # lowers to the owned heap String wrap, so the site allocates.
          let dest_str = perf_type_is_string_like(&perf_place_type(&f, &dest))
          if dest_str || perf_operand_is_string(&f, &lhs) || perf_operand_is_string(&f, &rhs) then
            t.heap_allocs = t.heap_allocs + 1
          end
        when MirRvalueKind::MirBinOp(_, lhs, rhs) then
          perf_count_operand(t, &lhs)
          perf_count_operand(t, &rhs)
        when MirRvalueKind::MirUnOp(_, op) then
          perf_count_operand(t, &op)
        when MirRvalueKind::MirDiscriminant(_) then ()
        when MirRvalueKind::MirLen(place) then
          if perf_type_is_array_vector(&type_index, &perf_place_type(&f, &place)) then
            t.vector_ok = true
          end
        when MirRvalueKind::MirCast(_, op, _) then
          perf_count_operand(t, &op)
        when MirRvalueKind::MirRepeat(op, _) then
          # An array-initialization repeat constructs an inline array.
          t.vector_ok = true
          perf_count_operand(t, &op)
        when MirRvalueKind::MirPhi(_) then ()
        end
      when MirStatementKind::MirStorageLive(_) then ()
      when MirStatementKind::MirStorageDead(_) then ()
      when MirStatementKind::MirNop then ()
      when MirStatementKind::MirContractCheck(_, op) then
        perf_count_operand(t, &op)
      when MirStatementKind::MirBudgetConsume(_, _) then ()
      when MirStatementKind::MirEffectRecord(_, op) then
        perf_count_operand(t, &op)
      when MirStatementKind::MirEffectPerform(_, _, _, op1, op2) then
        perf_count_operand(t, &op1)
        perf_count_operand(t, &op2)
      when MirStatementKind::MirEffectFrameEnter(_, _, _, _, op) then
        perf_count_operand(t, &op)
      when MirStatementKind::MirEffectFrameExit then ()
      end
    end
    match block.terminator.kind
    when MirTerminatorKind::MirGoto(_) then
      t.branches = t.branches + 1
    when MirTerminatorKind::MirReturn then ()
    when MirTerminatorKind::MirUnreachable then ()
    when MirTerminatorKind::MirSwitchInt { op, targets, default_target } then
      t.branches = t.branches + 1
      perf_count_operand(t, &op)
    when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic } then
      # heap_allocations: the §11 allocating-call mirror. arena /
      # retain_release: the callee-name text heuristics (only a named
      # MirFnItem target has text). escapes: bare-local-place argument
      # occurrences (the ArgEscape approximation).
      if perf_call_allocates(&f, &type_index, &bodied, &func, &args, &intrinsic) then
        t.heap_allocs = t.heap_allocs + 1
      end
      match perf_callee_name_of(&func)
      when Option::Some(name) then
        let lower = name.to_lowercase()
        if lower.contains("arena") || lower.contains("bump") then
          t.arena_allocs = t.arena_allocs + 1
        end
        if lower.contains("retain") || lower.contains("release") || lower.contains("clone") then
          t.retain_release = t.retain_release + 1
        end
      when Option::None then ()
      end
      for arg in args do
        match arg.value
        when MirCallValue::Value(op) then
          perf_count_operand(t, &op)
          match op.kind
          when MirOperandKind::MirCopy(p) then
            if p.projections.is_empty() then t.escapes = t.escapes + 1 end
          when MirOperandKind::MirMovePlace(p) then
            if p.projections.is_empty() then t.escapes = t.escapes + 1 end
          when MirOperandKind::MirRead(p) then
            if p.projections.is_empty() then t.escapes = t.escapes + 1 end
          when MirOperandKind::MirConsume(p) then
            if p.projections.is_empty() then t.escapes = t.escapes + 1 end
          when _ then ()
          end
        when MirCallValue::Place(p) then
          if p.projections.is_empty() then t.escapes = t.escapes + 1 end
        end
      end
    when MirTerminatorKind::MirAssert { cond, expected, msg, target, unwind } then
      t.branches = t.branches + 1
      perf_count_operand(t, &cond)
      match msg
      when AssertMessage::BoundsCheck(index_op, len_op) then
        # A bounds check that SURVIVED the optimizer (a proven one was
        # replaced by a MirGoto — see the module doc).
        t.bounds_checks = t.bounds_checks + 1
        perf_count_operand(t, &index_op)
        perf_count_operand(t, &len_op)
      when _ then ()
      end
    when MirTerminatorKind::MirAbort then ()
    when MirTerminatorKind::MirDeinit { place, deinit_fn, target, unwind } then
      # drops: one implicit destruction terminator.
      t.drops = t.drops + 1
    end
  end
  # The report: est_instruction_count = 2 * statements + 3 * terminators
  # (one terminator per block — the documented estimate). The surfaces
  # the optimized MIR does NOT record (stack_bytes, spills, reloads,
  # inline_decisions, proven_removed_bounds, hotness) stay 0 — see the
  # module doc's field rules.
  PerfReport {
    function_key: f.name.clone(),
    heap_allocations: t.heap_allocs,
    arena_allocations: t.arena_allocs,
    escapes: t.escapes,
    stack_bytes: 0,
    bounds_checks: t.bounds_checks,
    proven_removed_bounds: 0,
    copies: t.copies,
    moves: t.moves,
    drops: t.drops,
    retain_release: t.retain_release,
    spills: 0,
    reloads: 0,
    inline_decisions: 0,
    branch_count: t.branches,
    est_instruction_count: 2 * t.statements + 3 * f.blocks.len(),
    vectorization_eligible: t.vector_ok,
    hotness: 0
  }
end

# ———————————————————————————————————————————————————————————————
# The public builders
# ———————————————————————————————————————————————————————————————

# One PerfReport over an OPTIMIZED MirFunction of the given program.
# NOTE (compile-risk / anchor): the §11 allocation mirror is
# program-scoped (an in-program callee's allocation must land on the
# CALLEE's report, never the site), so the program rides along — a
# function alone cannot classify its call sites.
pub def perf_report_of_mir_function(mir: MirProgram, f: MirFunction) -> PerfReport
  let type_index = perf_type_index_of(&mir)
  let bodied = perf_bodied_names_of(&mir)
  perf_report_build(&f, &type_index, &bodied)
end

# One PerfReport over the LIR artifacts (function + its allocation)
# when they are available — the allocator-side view. spills = the
# allocator's recorded spill-store events (LirAlloc.spills — the
# "(call position, vreg)" store-before-call list; the alternative
# readings — the memory-resident vreg count over LirAlloc.segs_of's
# phys < 0 segments and LirAlloc.slots — are documented but not used);
# reloads = LirAlloc.reloads (the recorded slot re-loads after calls —
# the emitter inserts no slot-load STATEMENTS, so the records ARE the
# count); stack_bytes = LirAlloc.frame_bytes (the 16/8-aligned frame
# allocation size); branch_count = the LirJump + LirSwitch terms
# (MirGoto/MirAssert/switch lowering — LIR has no other branching
# term). Every other field stays defaulted: bounds checks, drops and
# the operand traffic are MIR-level facts that do not survive into
# LIR's scalar subset (documented).
pub def perf_report_of_lir_alloc(lir_fn: LirFunction, alloc: LirAlloc) -> PerfReport
  var branches = 0
  for block in lir_fn.blocks do
    match block.term.kind
    when LirTermKind::LirJump(_) then branches = branches + 1
    when LirTermKind::LirSwitch(_, _, _) then branches = branches + 1
    when LirTermKind::LirRet(_) then ()
    when LirTermKind::LirTrap then ()
    when LirTermKind::LirCall(_, _, _, _, _) then ()
    end
  end
  PerfReport {
    function_key: lir_fn.name.clone(),
    heap_allocations: 0,
    arena_allocations: 0,
    escapes: 0,
    stack_bytes: alloc.frame_bytes,
    bounds_checks: 0,
    proven_removed_bounds: 0,
    copies: 0,
    moves: 0,
    drops: 0,
    retain_release: 0,
    spills: alloc.spills.len(),
    reloads: alloc.reloads.len(),
    inline_decisions: 0,
    branch_count: branches,
    est_instruction_count: 0,
    vectorization_eligible: false,
    hotness: 0
  }
end

# The §44 session helper: one PerfReport per function of the optimized
# program, SORTED by function_key (ties keep program order).
pub def perf_reports_of_program(mir: MirProgram) -> Vec[PerfReport]
  let type_index = perf_type_index_of(&mir)
  let bodied = perf_bodied_names_of(&mir)
  var reports: Vec[PerfReport] = Vec::new()
  for f in mir.functions do
    reports.push(perf_report_build(&f, &type_index, &bodied))
  end
  reports.sort_by(|a, b| perf_report_lt(a, b))
  reports
end

def perf_report_lt(a: PerfReport, b: PerfReport) -> Bool
  a.function_key < b.function_key
end
