# ———————————————————————————————————————————————————————————————
# The RISC-V family — the audit's canonical instances. Every member
# is little-endian, stack-align 16, unaligned_access Faulting, with
# the psABI register file (the instances below keep the pre-slice
# reg lists; the rv32 instances model ILP32 with flash/ram spaces,
# the rv64 LP64 with ram-only spaces, as before).
# ATOMIC WIDTH CLASSES (audit §16, consumed per audit item 43): the
# RISC-V A extension's LR/SC
# (and AMO) forms carry the WORD (4) on RV32 and the word + the
# doubleword (4, 8) on RV64 — those are the NATIVE widths. There is
# NO byte/halfword LR/SC or AMO without the Zabha extension, so the
# sub-word widths 1/2 sit in the EMULATED class on every instance of
# this slice: backend_rv.tg serves a sub-word atomic RMW/CAS on
# NORMAL memory by the masked word-width LR/SC loop (audit item 43 —
# the loop READS AND WRITES THE WHOLE SURROUNDING WORD: it may touch a
# neighbouring MMIO register, so 1/2 are NEVER MMIO-safe and never
# appear in mmio_atomic_widths (which equals the native set: the
# native LR/SC/AMO forms are single-register accesses) —
# mmio_atomic_support answers Unsupported there). Adding the
# Zabha extension (a future instance carrying the "zabha" isa token)
# moves 1/2 into native_atomic_widths AND mmio_atomic_widths (Zabha's
# subword AMOs access exactly the addressed byte/halfword), leaving
# emulated_atomic_widths empty.
# FPU SPLIT: riscv32imac / riscv64imac have fpu None (the plain ima
# cores this backend serves); riscv32imafc adds the F extension (fpu RVF, FLEN 32) and
# riscv32imafdc / riscv64gc the F+D pair (fpu RVD, FLEN 64) with
# float_abi Hard (the psABI float argument registers fa0..fa7 — f10..
# f17). The riscv LIR backend's word-only accept set consumes the
# imac-class data this slice (its float slice is not implemented);
# the F/D instances exist for the exact target naming and for the
# future float slice.
# ———————————————————————————————————————————————————————————————

def riscv32imac_desc() -> TargetDesc
  TargetDesc {
    name: "riscv32imac",
    pointer_width: 4,
    endianness: Endianness::Little,
    stack_alignment: 16,
    arch: Arch::RiscV32,
    cpu: Cpu::GenericRiscV32,
    isa: "rv32imac",
    isa_features: Vec::from(["i", "m", "a", "c"]),
    float_abi: FloatAbi::Soft,
    fpu: Fpu::None,
    fpu_register_width: 0,
    integer_div: IntegerDiv::Hardware,
    native_atomic_widths: Vec::from([4]),
    emulated_atomic_widths: Vec::from([1, 2]),
    mmio_atomic_widths: Vec::from([4]),
    unaligned_policy: UnalignedPolicy::Faulting,
    cache_line_size: Option::None,
    red_zone: 0,
    tls_model: "none",
    interrupt_abi: Option::None,
    reg_caller_saved: Vec::from([
      "ra", "t0", "t1", "t2", "t3", "t4", "t5", "t6",
      "a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7"
    ]),
    reg_callee_saved: Vec::from([
      "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7",
      "s8", "s9", "s10", "s11"
    ]),
    arg_regs: Vec::from(["a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7"]),
    memory_spaces: Vec::from(["flash", "ram"])
  }
end

