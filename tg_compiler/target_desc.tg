    endianness: Endianness::Little,
    stack_alignment: 16,
    arch: Arch::RiscV64,
    cpu: Cpu::GenericRiscV64,
    isa: "rv64gc",
    isa_features: Vec::from(["i", "m", "a", "f", "d", "c"]),
    float_abi: FloatAbi::Hard,
    fpu: Fpu::RVD,
    fpu_register_width: 64,
    integer_div: IntegerDiv::Hardware,
    native_atomic_widths: Vec::from([4, 8]),
    emulated_atomic_widths: Vec::from([1, 2]),
    mmio_atomic_widths: Vec::from([4, 8]),
    unaligned_policy: UnalignedPolicy::Faulting,
    cache_line_size: Option::None,
    red_zone: 0,
    tls_model: "none",
    interrupt_abi: Option::None,
    reg_caller_saved: Vec::from([
      "ra", "t0", "t1", "t2", "t3", "t4", "t5", "t6",
      "a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7"
    ]),
    reg_callee_saved: Vec::from([
      "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7",
      "s8", "s9", "s10", "s11"
    ]),
    arg_regs: Vec::from(["a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7"]),
    memory_spaces: Vec::from(["ram"])
  }
end

# ———————————————————————————————————————————————————————————————
# x86_64 — System V AMD64 (the only x86-64 ABI this compiler targets;
# a Windows-x64 profile differs in arg/callee-saved registers and would
# be its own instance). Unaligned access is legal for all normal
# operations; atomics (lock-prefixed RMW / XCHG) support 1/2/4/8
# bytes natively — the classes are all full (nothing emulated; the
# lock-prefixed forms are single-address accesses, MMIO-safe like the
# aarch64 LSE set). fpu: SSE2 is the x86-64 baseline (required by
# SysV), 128-bit; AVX is a per-machine extension and is NOT assumed.
def x86_64_desc() -> TargetDesc
  TargetDesc {
    name: "x86_64",
    pointer_width: 8,
    endianness: Endianness::Little,
    stack_alignment: 16,
    arch: Arch::X86_64,
    cpu: Cpu::GenericX86_64,
    isa: "x86-64",
    isa_features: Vec::new(),
    float_abi: FloatAbi::Hard,
    fpu: Fpu::Sse2,
    fpu_register_width: 128,
    integer_div: IntegerDiv::Hardware,
    native_atomic_widths: Vec::from([1, 2, 4, 8]),
    emulated_atomic_widths: Vec::new(),
    mmio_atomic_widths: Vec::from([1, 2, 4, 8]),
    unaligned_policy: UnalignedPolicy::Allowed,
    cache_line_size: Option::None,
    red_zone: 128,
    tls_model: "none",
    interrupt_abi: Option::None,
    reg_caller_saved: Vec::from([
      "rax", "rcx", "rdx", "rsi", "rdi",
      "r8", "r9", "r10", "r11"
    ]),
    reg_callee_saved: Vec::from(["rbx", "rbp", "r12", "r13", "r14", "r15"]),
    arg_regs: Vec::from(["rdi", "rsi", "rdx", "rcx", "r8", "r9"]),
    memory_spaces: Vec::from(["ram"])
  }
end

# ———————————————————————————————————————————————————————————————
# THE ONE TRIPLE -> DESC LOOKUP (audit item 39) — the target-identity
# universe is THIS table, keyed by the --target triples. Every canonical
# descriptor instance above is mapped by its canonical triple; the host
# triples and the LEGACY route names (the old TANGERINE_LIR_TARGET
# values) are ALIAS KEYS of the same table — they resolve to exactly the
# instances the canonical triples name, so an env value can never select
# a target that no --target triple can name (and vice versa). There is
# no environment-only target universe: "LIR vs direct" is a compiler
# implementation detail (the driver routes a desc'd thumb/riscv triple
# to the LIR pipeline for its desc), never a second target naming
# system.
#
# The key sets per instance (fresh value data per lookup — the instances
# are plain functions returning fresh records, so two lookups never
# share mutable state):
#   - aarch64_desc       — "aarch64-unknown-none" (the embedded triple),
#                          the host triples "aarch64-unknown-linux-gnu" /
#                          "aarch64-apple-darwin", and the route name
#                          "aarch64" (the LIR route's default key);
#   - thumbv7m_cortex_m3_desc  — "thumbv7m-none-eabi" (+ "cortex-m3");
#   - thumbv7em_cortex_m4_desc — "thumbv7em-none-eabi" (the M4 WITHOUT
#                          its optional FPU) (+ "cortex-m4");
#   - thumbv7em_cortex_m4f_desc — "thumbv7em-none-eabihf" (the hard-
#                          float M4F) (+ "cortex-m4f" and the legacy
#                          "cortex-m" alias — the least-breaking mapping
#                          the pre-slice cortex_m instance implies the
#                          VFP unit, and the float route requires it);
#   - thumbv7em_cortex_m7_desc — "cortex-m7" ONLY (no canonical
#                          rustc-style triple exists for the M7's
#                          FPv5D16 class; thumbv7em-none-eabihf maps to
#                          the m4f instance above — the FPv4-SP subset
#                          is the shared common denominator, per the
#                          module header);
#   - riscv32imac_desc    — "riscv32imac-unknown-none-elf"
#                          (+ "riscv32imac" and the legacy "riscv32");
#   - riscv32imafc_desc   — "riscv32imafc-unknown-none-elf"
#                          (+ "riscv32imafc");
#   - riscv32imafdc_desc  — "riscv32imafdc-unknown-none-elf"
#                          (+ "riscv32imafdc");
#   - riscv64imac_desc    — "riscv64imac-unknown-none-elf"
#                          (+ "riscv64imac" and the legacy "riscv64");
#   - riscv64gc_desc      — "riscv64gc-unknown-none-elf" (+ "riscv64gc");
#   - x86_64_desc         — the host triples "x86_64-unknown-linux-gnu" /
#                          "x86_64-apple-darwin" (+ "x86_64").
# The triples WITHOUT a descriptor instance (thumbv6m-none-eabi,
# thumbv8m.main-none-eabihf, riscv32imc-unknown-none-elf — the ARMv6-M
# and IMC profiles no backend models this slice) return None: fail
# closed, never a fabricated image under a foreign triple.
def target_desc_of_triple(triple: String) -> Option[TargetDesc]
  if triple == "aarch64-unknown-none" || triple == "aarch64-unknown-linux-gnu" || triple == "aarch64-apple-darwin" || triple == "aarch64" then
    return Option::Some(aarch64_desc())
  end
  if triple == "x86_64-unknown-linux-gnu" || triple == "x86_64-apple-darwin" || triple == "x86_64" then
    return Option::Some(x86_64_desc())
  end
  if triple == "thumbv7m-none-eabi" || triple == "cortex-m3" then
    return Option::Some(thumbv7m_cortex_m3_desc())
  end
  if triple == "thumbv7em-none-eabi" || triple == "cortex-m4" then
    return Option::Some(thumbv7em_cortex_m4_desc())
  end
  if triple == "thumbv7em-none-eabihf" || triple == "cortex-m4f" || triple == "cortex-m" then
    return Option::Some(thumbv7em_cortex_m4f_desc())
  end
  if triple == "cortex-m7" then
    return Option::Some(thumbv7em_cortex_m7_desc())
  end
  if triple == "riscv32imac-unknown-none-elf" || triple == "riscv32imac" || triple == "riscv32" then
    return Option::Some(riscv32imac_desc())
  end
  if triple == "riscv32imafc-unknown-none-elf" || triple == "riscv32imafc" then
    return Option::Some(riscv32imafc_desc())
  end
  if triple == "riscv32imafdc-unknown-none-elf" || triple == "riscv32imafdc" then
    return Option::Some(riscv32imafdc_desc())
  end
  if triple == "riscv64imac-unknown-none-elf" || triple == "riscv64imac" || triple == "riscv64" then
    return Option::Some(riscv64imac_desc())
  end
  if triple == "riscv64gc-unknown-none-elf" || triple == "riscv64gc" then
    return Option::Some(riscv64gc_desc())
  end
  Option::None
end

# The desc route-family predicates (audit item 39): the families with a
# code generator on the driver's LIR route. The consumers (driver.tg's
# embedded/LIR routing) select the backend from the desc's family — the
# same data the instance records carry — never from a second naming
# system.
def target_desc_is_thumb_family(desc: TargetDesc) -> Bool
  match desc.arch
  when Arch::Armv6M then true
  when Arch::Armv7M then true
  when _ then false
  end
end

def target_desc_is_riscv_family(desc: TargetDesc) -> Bool
  match desc.arch
  when Arch::RiscV32 then true
  when Arch::RiscV64 then true
  when _ then false
  end
end
