# Tangerine trait resolution — Part F of the spec
# Coherence checking, orphan rule, method lookup, candidate ranking.
#
# This module resolves method calls by searching inherent impls first
# then trait impls, ranking candidates by specificity.

use tg_compiler::ast::{ Program, Item, ItemKind, ImplDecl, TraitDecl, Span, TypeExpr, TypeExprKind, AccessConvention }
use tg_compiler::types::{ Type, TypeId, TypeEnv, TypeDef, TypeDefKind, MethodSig, ParamType, get_type_def_by_name, fn_owner_key }
use tg_compiler::ids::DefId

# ———————————————————————————————————————————————————————————————
# Data Structures
# ———————————————————————————————————————————————————————————————

enum CandidateKind
  Inherent
  Trait
end

struct Candidate
  kind: CandidateKind
  trait_name: Option[String]
  method_name: String
  method_sig: MethodSig
  concreteness: Int
  is_local: Bool
end

def duplicate_candidate(candidate: &Candidate) -> Candidate
  Candidate {
    kind: candidate.kind,
    trait_name: candidate.trait_name.clone(),
    method_name: candidate.method_name.clone(),
    method_sig: candidate.method_sig.clone(),
    concreteness: candidate.concreteness,
    is_local: candidate.is_local
  }
end

struct ImplEntry
  trait_name: String
  for_type: Type
  methods: Vec[MethodSig]
  is_inherent: Bool
  span: Span
end

struct TraitResolver
  impls: Vec[ImplEntry]
  errors: Vec[TraitError]
  local_types: Set[String]   # Types/traits defined in the current crate
  type_names: Map[Int, String]  # TypeId.id -> human-readable type name
end

struct TraitError
  message: String
  span: Span
end

# ———————————————————————————————————————————————————————————————
# Constructor
# ———————————————————————————————————————————————————————————————

def trait_resolver_new() -> TraitResolver
  TraitResolver {
    impls: Vec::new(),
    errors: Vec::new(),
    local_types: Set::new(),
    type_names: Map::new()
  }
end

def register_type_name(resolver: &mut TraitResolver, tid: Int, name: String) -> Unit
  resolver.type_names.insert(tid, name)
end

# ———————————————————————————————————————————————————————————————
# Impl Registration
# ———————————————————————————————————————————————————————————————

def register_impl(resolver: &mut TraitResolver, entry: ImplEntry) -> Unit
  resolver.impls.push(entry)
end

# Convert a type expression into a resolved Type through the typed program's
# type tables (the same tables the type layer's resolve_type_expr uses).
# A name that is a genuinely declared generic parameter of the impl/method
# becomes Type::Param(name) — a real parameter reference that matches only
# the same-named Param, never a wildcard. Every other named type resolves to
# Type::Named(resolved TypeId, args) (or a canonical variant for builtin
# compounds); a name that cannot be resolved is an explicit error, recorded
# on the resolver and returned as Type::Error — never a Param wildcard.
def ast_type_to_type(resolver: &mut TraitResolver, env: &TypeEnv, generic_params: &Vec[String], ty: &TypeExpr) -> Type
  match ty.kind
  when TypeExprKind::Unit then Type::Unit
  when TypeExprKind::Never then Type::Never
  when TypeExprKind::Named(name, args) then
    if generic_params.contains(&name) then
      # Declared impl/method generic parameter: genuine Param reference.
      Type::Param(name)
    elsif name == "Unit" || name == "Nil" then Type::Unit
    elsif name == "Bool" then Type::Bool
    elsif name == "Int" then Type::Int
    elsif name == "i8" then Type::I8
    elsif name == "i16" then Type::I16
    elsif name == "i32" then Type::I32
    elsif name == "i64" then Type::I64
    elsif name == "i128" then Type::I128
    elsif name == "UInt" then Type::UInt
    elsif name == "u8" then Type::U8
    elsif name == "u16" then Type::U16
    elsif name == "u32" then Type::U32
    elsif name == "u64" then Type::U64
    elsif name == "u128" then Type::U128
    elsif name == "isize" then Type::ISize
    elsif name == "usize" then Type::USize
    elsif name == "Float" then Type::Float
    elsif name == "f32" then Type::F32
    elsif name == "f64" then Type::F64
    elsif name == "Char" then Type::Char
    elsif name == "String" || name == "str" then Type::String
    elsif name == "Never" then Type::Never
    elsif name == "Fn" then
      # Named Fn syntax mirrors the type layer's canonical Function type.
      var param_types = Vec::new()
      for arg in args do
        param_types.push(ParamType { ty: ast_type_to_type(resolver, env, generic_params, &arg), convention: AccessConvention::Let })
      end
      Type::Function(param_types, Type::Unit)
    elsif name == "Array" then
      if args.len() >= 1 then
        Type::Array(ast_type_to_type(resolver, env, generic_params, &args[0]), 0)
      else
        Type::Error
      end
    elsif name == "Slice" then
      if args.len() >= 1 then
        Type::Slice(ast_type_to_type(resolver, env, generic_params, &args[0]))
      else
        Type::Error
      end
    else
      # Resolve through the typed program's type tables.
      match get_type_def_by_name(env, name.clone())
      when Option::Some(td) then
        var resolved_args = Vec::new()
        for arg in args do
          resolved_args.push(ast_type_to_type(resolver, env, generic_params, &arg))
        end
        # Canonical variants for builtin compounds so matching agrees with
        # the type layer's resolve_type_expr.
        if td.name == "Option" then
          if resolved_args.len() >= 1 then Type::Option(resolved_args[0]) else Type::Error end
        elsif td.name == "Result" then
          if resolved_args.len() >= 2 then Type::Result(resolved_args[0], resolved_args[1]) else Type::Error end
        elsif td.name == "Map" then
          if resolved_args.len() >= 2 then Type::Map(resolved_args[0], resolved_args[1]) else Type::Error end
        elsif td.name == "Set" then
          if resolved_args.len() >= 1 then Type::Set(resolved_args[0]) else Type::Error end
        else
          Type::Named(td.id, resolved_args)
        end
      when Option::None then
        # Explicit failure: an unresolvable named type is an error, never a
        # Param wildcard.
        resolver.errors.push(TraitError {
          message: "unresolved named type `" + name + "` in trait impl",
          span: ty.span
        })
        Type::Error
      end
    end
  when TypeExprKind::Slice(inner) then Type::Slice(ast_type_to_type(resolver, env, generic_params, &inner))
  when TypeExprKind::Tuple(elems) then
    let mapped = Vec::new()
    for e in elems do
      mapped.push(ast_type_to_type(resolver, env, generic_params, &e))
    end
    Type::Tuple(mapped)
  when _ then Type::Error
  end
end

def collect_impls(resolver: &mut TraitResolver, program: &Program, env: &TypeEnv) -> Unit
  for item in program.items do
    match item.kind
    when ItemKind::ItemImpl(impl_block) then
      # Impl-level generic parameters are in scope for the impl's for_type
      # and for every method signature (mirrors the type layer's check_impl).
      var impl_generic_names = Vec::new()
      for gp in impl_block.generic_params do
        impl_generic_names.push(gp.name.clone())
      end
      var methods = Vec::new()
      for method in impl_block.methods do
        # Method-level generic parameters are additionally in scope for this
        # method's signature.
        var generic_names = impl_generic_names.clone()
        for mgp in method.generic_params do
          generic_names.push(mgp.name.clone())
        end
        var param_types = Vec::new()
        for p in method.params do
          match p.ty
          when Some(param_ty) then param_types.push(ParamType { ty: ast_type_to_type(resolver, env, &generic_names, &param_ty), convention: p.convention })
          when None then param_types.push(ParamType { ty: Type::Error, convention: p.convention })
          end
        end
        methods.push(MethodSig {
          name: method.name.clone(),
          params: param_types,
          ret_type: match method.ret_type
            when Some(ret_ty) then ast_type_to_type(resolver, env, &generic_names, &ret_ty)
            when None then Type::Unit
          end,
          is_method: true
        })
      end
      let is_inherent = impl_block.trait_name.is_none()
      register_impl(resolver, ImplEntry {
        trait_name: match impl_block.trait_name
          when Some(name) then name
          when None then "_"
        end,
        for_type: ast_type_to_type(resolver, env, &impl_generic_names, &impl_block.for_type),
        methods: methods,
        is_inherent: is_inherent,
        span: impl_block.span
      })
    when _ then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Method Resolution
# ———————————————————————————————————————————————————————————————

# Resolves method calls using the algorithm from Part F:
#   1. Search inherent impls (impl X without a trait)
#   2. Search trait impls
#   3. Rank by (is_inherent, concreteness, is_local)
def resolve_method(
  resolver: &TraitResolver,
  receiver_ty: &Type,
  method_name: String,
  span: Span
) -> Option[Candidate]
  var candidates: Vec[Candidate] = Vec::new()

  # 1. Search inherent impls first (highest priority)
  for imp in resolver.impls do
    if !type_matches(&imp.for_type, receiver_ty) then
      next
    end
    if !imp.is_inherent then
      next
    end
    for method in imp.methods do
      if method.name == method_name then
        candidates.push(Candidate {
          kind: CandidateKind::Inherent,
          trait_name: None,
          method_name: method.name.clone(),
          method_sig: method.clone(),
          concreteness: type_concreteness(&imp.for_type),
          is_local: true
        })
      end
    end
  end

  # If we found inherent candidates, return the best one
  if !candidates.is_empty() then
    return Some(best_candidate(&candidates))
  end

  # 2. Search trait impls
  for imp in resolver.impls do
    if !type_matches(&imp.for_type, receiver_ty) then
      next
    end
    if imp.is_inherent then
      next
    end
    for method in imp.methods do
      if method.name == method_name then
        candidates.push(Candidate {
          kind: CandidateKind::Trait,
          trait_name: Some(imp.trait_name.clone()),
          method_name: method.name.clone(),
          method_sig: method.clone(),
          concreteness: type_concreteness(&imp.for_type),
          is_local: true
        })
      end
    end
  end

  if candidates.is_empty() then
    return None
  end

  Some(best_candidate(&candidates))
end

# ———————————————————————————————————————————————————————————————
# Type Matching
# ———————————————————————————————————————————————————————————————

# Check if a pattern type matches a concrete type.
# Type::Param matches only the SAME named generic parameter and Type::Var
# only the identical pending inference variable; no type matches "anything".
def type_matches(pattern: &Type, concrete: &Type) -> Bool
  match pattern
  when Type::Param(p_name) then
    match concrete
    when Type::Param(c_name) then p_name == c_name
    when _ then false
    end
  when Type::Var(p_var) then
    match concrete
    when Type::Var(c_var) then p_var.id == c_var.id
    when _ then false
    end
  when Type::Unit then
    match concrete
    when Type::Unit then true
    when _ then false
    end
  when Type::Bool then
    match concrete
    when Type::Bool then true
    when _ then false
    end
  when Type::Int then
    match concrete
    when Type::Int then true
    when _ then false
    end
  when Type::UInt then
    match concrete
    when Type::UInt then true
    when _ then false
    end
  when Type::Float then
    match concrete
    when Type::Float then true
    when _ then false
    end
  when Type::Char then
    match concrete
    when Type::Char then true
    when _ then false
    end
  when Type::String then
    match concrete
    when Type::String then true
    when _ then false
    end
  when Type::Named(n1, args1) then
    match concrete
    when Type::Named(n2, args2) then
      if n1 != n2 then
        false
      elsif args1.len() != args2.len() then
        false
      else
        var ok = true
        var i = 0
        while i < args1.len() do
          if !type_matches(&args1[i], &args2[i]) then
            ok = false
            break
          end
          i = i + 1
        end
        ok
      end
    when _ then false
    end
  when Type::Option(t1) then
    match concrete
    when Type::Option(t2) then type_matches(t1, t2)
    when _ then false
    end
  when Type::Result(ok1, err1) then
    match concrete
    when Type::Result(ok2, err2) then
      type_matches(ok1, ok2) && type_matches(err1, err2)
    when _ then false
    end
  when Type::Map(k1, v1) then
    match concrete
    when Type::Map(k2, v2) then
      type_matches(k1, k2) && type_matches(v1, v2)
    when _ then false
    end
  when Type::Set(t1) then
    match concrete
    when Type::Set(t2) then type_matches(t1, t2)
    when _ then false
    end
  when Type::Tuple(elems1) then
    match concrete
    when Type::Tuple(elems2) then
      if elems1.len() != elems2.len() then
        false
      else
        var ok = true
        var i = 0
        while i < elems1.len() do
          if !type_matches(&elems1[i], &elems2[i]) then
            ok = false
            break
          end
          i = i + 1
        end
        ok
      end
    when _ then false
    end
  when Type::Array(t1, n1) then
    match concrete
    when Type::Array(t2, n2) then n1 == n2 && type_matches(t1, t2)
    when _ then false
    end
  when Type::Slice(t1) then
    match concrete
    when Type::Slice(t2) then type_matches(t1, t2)
    when _ then false
    end
  when Type::Function(p1, r1) then
    match concrete
    when Type::Function(p2, r2) then
      if p1.len() != p2.len() then
        false
      else
        var ok = true
        var i = 0
        while i < p1.len() do
          if !type_matches(&p1[i].ty, &p2[i].ty) then
            ok = false
            break
          end
          if !(p1[i].convention == p2[i].convention) then
            ok = false
            break
          end
          i = i + 1
        end
        if ok then type_matches(r1, r2) else false end
      end
    when _ then false
    end
  when _ then false
  end
end

# Compute type concreteness — more concrete types rank higher in resolution.
# Generic/unresolved params have concreteness 0; concrete primitives have 1;
# compound types sum child concreteness.
def type_concreteness(ty: &Type) -> Int
  match ty
  when Type::Param(_) then 0
  when Type::Var(_) then 0
  when Type::Array(elem, _) then 1 + type_concreteness(elem)
  when Type::Slice(elem) then 1 + type_concreteness(elem)
  when Type::Tuple(elems) then
    var sum = 1
    for e in elems do
      sum = sum + type_concreteness(e)
    end
    sum
  when Type::Map(k, v) then 1 + type_concreteness(k) + type_concreteness(v)
  when Type::Set(inner) then 1 + type_concreteness(inner)
  when Type::Option(inner) then 1 + type_concreteness(inner)
  when Type::Result(ok, err) then 1 + type_concreteness(ok) + type_concreteness(err)
  when Type::Named(_, args) then
    var sum = 1
    for a in args do
      sum = sum + type_concreteness(a)
    end
    sum
  when Type::Function(params, ret) then
    var sum = 1
    for p in params do
      sum = sum + type_concreteness(&p.ty)
    end
    sum + type_concreteness(ret)
  when _ then 1
  end
end

# ———————————————————————————————————————————————————————————————
# Candidate Ranking
# ———————————————————————————————————————————————————————————————

# Select the best candidate from a list using the ranking:
#   1. Inherent > Trait
#   2. More concrete > less concrete
#   3. Local > external
def best_candidate(candidates: &Vec[Candidate]) -> Candidate
  if candidates.len() == 1 then
    return duplicate_candidate(&candidates[0])
  end

  var best = candidates[0]
  var i = 1
  while i < candidates.len() do
    let c = candidates[i]
    if candidate_rank(c) > candidate_rank(best) then
      best = c
    end
    i = i + 1
  end
  duplicate_candidate(best)
end

# Returns a ranking tuple as a single comparable integer.
# Higher is better. Encoding: inherent(1000000) + concreteness(1000) + local(1)
def candidate_rank(c: &Candidate) -> Int
  var rank = 0
  match c.kind
  when CandidateKind::Inherent then rank = rank + 1000000
  when CandidateKind::Trait then ()
  end
  rank = rank + c.concreteness * 1000
  if c.is_local then
    rank = rank + 1
  end
  rank
end

# ———————————————————————————————————————————————————————————————
# Coherence Checking
# ———————————————————————————————————————————————————————————————

# Ensure no overlapping impls for the same trait on the same type.
# This is the orphan rule / coherence check from Part F.
def check_coherence(resolver: &mut TraitResolver) -> Unit
  # Phase 1: Check for overlapping impls
  # Group impls by trait_name to avoid O(n²) over all impls
  let by_trait: Map[String, Vec[UInt]] = Map::new()
  var idx: UInt = 0
  while idx < resolver.impls.len() do
    let imp = resolver.impls[idx]
    let name = imp.trait_name.clone()
    match by_trait.get(&name)
    when Option::Some(list) then
      var new_list = list
      new_list.push(idx)
      by_trait.insert(name, new_list)
    when Option::None then by_trait.insert(name, vec![idx])
    end
    idx = idx + 1
  end

  # Only check pairs that share the same trait
  for (_, indices) in by_trait.entries() do
    var i = 0
    while i < indices.len() do
      var j = i + 1
      while j < indices.len() do
        let a = resolver.impls[indices[i]]
        let b = resolver.impls[indices[j]]
        if type_matches(&a.for_type, &b.for_type) then
          resolver.errors.push(TraitError {
            message: "overlapping impls for trait '" + a.trait_name + "' — coherence violation",
            span: b.span
          })
        end
        j = j + 1
      end
      i = i + 1
    end
  end

  # Phase 2: Check orphan rule
  check_orphan_rules(resolver)
end

# ———————————————————————————————————————————————————————————————
# Orphan Rule Enforcement
# ———————————————————————————————————————————————————————————————

# The orphan rule states: at least one of the trait or the self-type
# must be defined in the current crate. This prevents conflicting
# blanket impls across crate boundaries.
#
# Exceptions:
# - "Covered type" rule: a foreign trait may be implemented for a
#   foreign type if a local type appears as a type parameter in
#   the uncovered position (e.g., impl ForeignTrait for Vec[LocalType])
def check_orphan_rules(resolver: &mut TraitResolver) -> Unit
  for imp in resolver.impls do
    if imp.is_inherent then next end
    
    let trait_is_local = is_type_local(resolver, imp.trait_name.clone())
    let type_is_local = is_self_type_local(resolver, &imp.for_type)
    
    if !trait_is_local && !type_is_local then
      # Check the covered type exception
      if !has_local_covered_type(resolver, &imp.for_type) then
        resolver.errors.push(TraitError {
          message: "orphan rule violation: cannot implement foreign trait '" +
                   imp.trait_name + "' for foreign type '" +
                   type_to_string(&imp.for_type) + "' — at least one must be " +
                   "defined in the current crate",
          span: imp.span
        })
      end
    end
  end
end

def is_type_local(resolver: &TraitResolver, name: String) -> Bool
  # A type/trait is local if it was defined in the current compilation unit
  # Check if it's in our local definitions
  match resolver.local_types.get(&name)
  when Option::Some(_) then true
  when Option::None then
    # Builtin types are not local
    is_builtin_type(name.clone()) == false &&
    is_builtin_trait(name.clone()) == false
  end
end

def is_self_type_local(resolver: &TraitResolver, ty: &Type) -> Bool
  match ty
  when Type::Named(tid, args) then
    let name = type_id_to_name(resolver, tid)
    is_type_local(resolver, name)
  when Type::Tuple(_) then false  # Tuples are builtin
  when Type::Array(_, _) then false  # Arrays are builtin
  when _ then false
  end
end

def has_local_covered_type(resolver: &TraitResolver, ty: &Type) -> Bool
  # A type is "covered" if a local type appears inside a generic parameter
  # Example: impl Display for Vec[MyLocalType] is OK because MyLocalType covers it
  match ty
  when Type::Named(_, args) then
    for arg in args do
      if is_self_type_local(resolver, &arg) then return true end
      if has_local_covered_type(resolver, &arg) then return true end
    end
    false
  when _ then false
  end
end

def is_builtin_type(name: String) -> Bool
  name == "Int" || name == "UInt" || name == "Float" || name == "Bool" ||
  name == "String" || name == "Char" || name == "Unit" || name == "Vec" ||
  name == "Map" || name == "Set" || name == "Option" || name == "Result"
end

def is_builtin_trait(name: String) -> Bool
  name == "Drop" || name == "Clone" || name == "Display" || name == "Debug" ||
  name == "Iterator" || name == "Send" || name == "Sync" || name == "Eq" ||
  name == "Ord" || name == "Hash" || name == "Default" || name == "Into" ||
  name == "From" || name == "Future"
end

def type_id_to_name(resolver: &TraitResolver, tid: &TypeId) -> String
  match resolver.type_names.get(&tid.id)
  when Some(name) then name.clone()
  when None then "<type_" + tid.id.to_string() + ">"
  end
end

def type_to_string(ty: &Type) -> String
  match ty
  when Type::Named(tid, args) then
    if args.is_empty() then
      "<type_" + tid.id.to_string() + ">"
    else
      var s = "<type_" + tid.id.to_string() + ">["
      var first = true
      for arg in args do
        if !first then s = s + ", " end
        s = s + type_to_string(&arg)
        first = false
      end
      s + "]"
    end
  when Type::Tuple(elems) then
    var s = "("
    var first = true
    for e in elems do
      if !first then s = s + ", " end
      s = s + type_to_string(&e)
      first = false
    end
    s + ")"
  when _ then "<unknown>".to_string()
  end
end

# ———————————————————————————————————————————————————————————————
# Trait Bound Checking
# ———————————————————————————————————————————————————————————————

# Check whether a type satisfies a trait bound.
# Searches all registered impls for a matching impl.
def satisfies_trait(resolver: &TraitResolver, ty: &Type, trait_name: String) -> Bool
  for imp in resolver.impls do
    if imp.trait_name == trait_name && type_matches(&imp.for_type, ty) then
      return true
    end
  end
  false
end

# Check whether a type satisfies all trait bounds in a where clause.
def check_where_bounds(
  resolver: &TraitResolver,
  ty: &Type,
  bounds: &Vec[String],
  span: Span
) -> Vec[TraitError]
  var errors = Vec::new()
  for bound in bounds do
    if !satisfies_trait(resolver, ty, bound.clone()) then
      errors.push(TraitError {
        message: "type does not satisfy trait bound '" + bound + "'",
        span: span
      })
    end
  end
  errors
end

# ———————————————————————————————————————————————————————————————
# Monomorphization Support
# ———————————————————————————————————————————————————————————————

struct MonoKey
  func_name: String
  type_args: Vec[Type]
end

struct MonoCache
  entries: Vec[MonoEntry]
  # Specialized MIR function bodies keyed by mangled name
  specialized_bodies: Map[String, MirFunction]
  # Inference failures recorded during monomorphization (deduplicated)
  errors: Vec[String]
end

struct MonoEntry
  key: MonoKey
  mangled_name: String
end

def mono_cache_new() -> MonoCache
  MonoCache { entries: Vec::new(), specialized_bodies: Map::new(), errors: Vec::new() }
end

# ———————————————————————————————————————————————————————————————
# Call-level Instance Identity (P0-AK)
# ———————————————————————————————————————————————————————————————
# The semantic identity of a monomorphized callee: the DEFINITION the call
# resolves to (the typed program's call_targets DefId) plus the concrete
# type substitutions. This is the target shape the string-only MirFnItem
# names migrate to: a MirFnItem keeps its name as the mangled EMISSION key
# (codegen's resolve_callee_label authority) and carries the InstanceId as
# its semantic identity alongside. The substs are the concrete generic
# arguments; the monomorphizer's call-site inference
# (infer_type_args_for_call) fills them from each call site.

pub struct InstanceId
  def: DefId
  substs: Vec[Type]
end

# The SINGLE instance -> mangled-name mapping. The base is the DefId
# rendered by fn_owner_key (the canonical semantic rendering the resource
# checker and MIR owner keys use — the DefId carries no source name, so
# this rendering IS the def identity); the suffix is the existing
# mangle_name applied to the concrete substitutions. Deterministic per
# (def, substs), so the same instance always maps to the same name.
#
# THE EMISSION-NAME FLOW (P0-AM, final): this function is the mangling
# AUTHORITY — symbol names are produced only at this boundary, never at the
# source level. The full flow for every top-level function:
#
#   source name (diagnostics/display only)
#     -> DefId (resolver: ResolvedNames.item_defs / call_targets — the
#        module + per-module symbol index; record_item_def guarantees one
#        for every top-level function)
#     -> fn_owner_key (semantic identity: "<module path>::<index>::fn" —
#        the P0-C key, rendered by fn_owner_key in types.tg)
#     -> instance_key / mangle_name (the mangled EMISSION name: for a
#        non-generic function, instance_key with empty substs IS the
#        fn_owner_key base; for a generic instantiation, mangle_name
#        appends the "$<concrete args>" suffix — the symbol-mangling
#        boundary, where the MirFunction/MirFnItem name is produced)
#     -> label (codegen's fn_alias identity entry ".Lfn_entry.<index>",
#        resolved by resolve_callee_label)
#
# The source name survives ONLY at the linking boundary (extern symbols,
# intrinsic names, the OS-entry "main"/"_start") and in diagnostics. Method
# names ("Type__method") are exempt by design: the finalizer and registered
# Drop identities depend on them unchanged.
pub def instance_key(instance: &InstanceId) -> String
  let base = fn_owner_key(instance.def.module.clone(), instance.def.index, instance.def.kind)
  mangle_name(base, &instance.substs)
end

# ———————————————————————————————————————————————————————————————
# Type-Param Helper Predicates
# ———————————————————————————————————————————————————————————————

# Check whether a type contains any Type::Param reference.
def type_has_params(ty: &Type) -> Bool
  match ty
  when Type::Param(_) then true
  when Type::Option(inner) then type_has_params(inner)
  when Type::Result(ok, err) then type_has_params(ok) || type_has_params(err)
  when Type::Map(k, v) then type_has_params(k) || type_has_params(v)
  when Type::Set(inner) then type_has_params(inner)
  when Type::Slice(inner) then type_has_params(inner)
  when Type::Array(inner, _) then type_has_params(inner)
  when Type::Tuple(elems) then
    var found = false
    for e in elems do
      if type_has_params(&e) then found = true; break end
    end
    found
  when Type::Function(params, ret) then
    var found = false
    for p in params do
      if type_has_params(&p.ty) then found = true; break end
    end
    found || type_has_params(ret)
  when Type::Named(_, args) then
    var found = false
    for a in args do
      if type_has_params(&a) then found = true; break end
    end
    found
  when Type::RefInternal(inner, _) then type_has_params(inner)
  when Type::Ptr(inner) then type_has_params(inner)
  when Type::PtrMut(inner) then type_has_params(inner)
  when Type::Box(inner) then type_has_params(inner)
  when Type::Rc(inner) then type_has_params(inner)
  when Type::Effect(_, inner) then type_has_params(inner)
  when _ then false
  end
end

# Check whether a specific Type::Param name appears in a type.
def type_uses_param_name(ty: &Type, name: &String) -> Bool
  match ty
  when Type::Param(n) then n == name
  when Type::Option(inner) then type_uses_param_name(inner, name)
  when Type::Result(ok, err) then type_uses_param_name(ok, name) || type_uses_param_name(err, name)
  when Type::Map(k, v) then type_uses_param_name(k, name) || type_uses_param_name(v, name)
  when Type::Set(inner) then type_uses_param_name(inner, name)
  when Type::Slice(inner) then type_uses_param_name(inner, name)
  when Type::Array(inner, _) then type_uses_param_name(inner, name)
  when Type::Tuple(elems) then
    var found = false
    for e in elems do
      if type_uses_param_name(&e, name) then found = true; break end
    end
    found
  when Type::Function(params, ret) then
    var found = false
    for p in params do
      if type_uses_param_name(&p.ty, name) then found = true; break end
    end
    found || type_uses_param_name(ret, name)
  when Type::Named(_, args) then
    var found = false
    for a in args do
      if type_uses_param_name(&a, name) then found = true; break end
    end
    found
  when Type::RefInternal(inner, _) then type_uses_param_name(inner, name)
  when Type::Ptr(inner) then type_uses_param_name(inner, name)
  when Type::PtrMut(inner) then type_uses_param_name(inner, name)
  when Type::Box(inner) then type_uses_param_name(inner, name)
  when Type::Rc(inner) then type_uses_param_name(inner, name)
  when Type::Effect(_, inner) then type_uses_param_name(inner, name)
  when _ then false
  end
end

# Check whether a function is generic (has Type::Param in its signature).
def is_generic_function(func: &MirFunction) -> Bool
  if type_has_params(&func.ret_type) then return true end
  for param in func.params do
    if type_has_params(&param.ty) then return true end
  end
  for local in func.locals do
    if type_has_params(&local.ty) then return true end
  end
  false
end

# Get the concrete type of a MirOperand from the function context.
def operand_type_from_func(func: &MirFunction, op: &MirOperand) -> Type
  match op.kind
  when MirOperandKind::MirCopy(place) then
    let idx = place.local.id
    if idx >= 0 && idx < func.locals.len() then
      func.locals[idx].ty.clone()
    else
      Type::Unit
    end
  when MirOperandKind::MirMovePlace(place) then
    let idx = place.local.id
    if idx >= 0 && idx < func.locals.len() then
      func.locals[idx].ty.clone()
    else
      Type::Unit
    end
  when MirOperandKind::MirConstant(c) then
    c.ty.clone()
  end
end

# ———————————————————————————————————————————————————————————————
# Structural generic-parameter inference
# ———————————————————————————————————————————————————————————————
# The inference walks each (callee parameter type, call argument type)
# pair in lockstep.  A Type::Param(name) at a position binds name to the
# argument's SUB-STRUCTURE at that position (param Option[T] vs arg
# Option[Int] binds T = Int, never T = Option[Int]); container kinds
# recurse positionally.  Every occurrence must agree: a second occurrence
# that would bind the name to a different CONCRETE type records an
# inconsistency error.  Bindings that still carry Params/Vars are deferred
# (the caller is itself generic; a later specialization iteration
# re-infers them with concrete types).

struct TypeInferenceResult
  type_args: Vec[Type]
  errors: Vec[String]
end

# Structural equality used for inference agreement checks.  Covers every
# Type variant; Param and Var leaves compare by identity.
def infer_types_equal(a: &Type, b: &Type) -> Bool
  match a
  when Type::Unit then
    match b
    when Type::Unit then true
    when _ then false
    end
  when Type::Bool then
    match b
    when Type::Bool then true
    when _ then false
    end
  when Type::Int then
    match b
    when Type::Int then true
    when _ then false
    end
  when Type::UInt then
    match b
    when Type::UInt then true
    when _ then false
    end
  when Type::Float then
    match b
    when Type::Float then true
    when _ then false
    end
  when Type::Char then
    match b
    when Type::Char then true
    when _ then false
    end
  when Type::String then
    match b
    when Type::String then true
    when _ then false
    end
  when Type::Never then
    match b
    when Type::Never then true
    when _ then false
    end
  when Type::I8 then
    match b
    when Type::I8 then true
    when _ then false
    end
  when Type::I16 then
    match b
    when Type::I16 then true
    when _ then false
    end
  when Type::I32 then
    match b
    when Type::I32 then true
    when _ then false
    end
  when Type::I64 then
    match b
    when Type::I64 then true
    when _ then false
    end
  when Type::I128 then
    match b
    when Type::I128 then true
    when _ then false
    end
  when Type::U8 then
    match b
    when Type::U8 then true
    when _ then false
    end
  when Type::U16 then
    match b
    when Type::U16 then true
    when _ then false
    end
  when Type::U32 then
    match b
    when Type::U32 then true
    when _ then false
    end
  when Type::U64 then
    match b
    when Type::U64 then true
    when _ then false
    end
  when Type::U128 then
    match b
    when Type::U128 then true
    when _ then false
    end
  when Type::ISize then
    match b
    when Type::ISize then true
    when _ then false
    end
  when Type::USize then
    match b
    when Type::USize then true
    when _ then false
    end
  when Type::F32 then
    match b
    when Type::F32 then true
    when _ then false
    end
  when Type::F64 then
    match b
    when Type::F64 then true
    when _ then false
    end
  when Type::Param(n1) then
    match b
    when Type::Param(n2) then n1 == n2
    when _ then false
    end
  when Type::Var(v1) then
    match b
    when Type::Var(v2) then v1.id == v2.id
    when _ then false
    end
  when Type::Error then
    match b
    when Type::Error then true
    when _ then false
    end
  when Type::Named(id1, args1) then
    match b
    when Type::Named(id2, args2) then
      id1.id == id2.id && infer_type_lists_equal(args1, args2)
    when _ then false
    end
  when Type::Option(t1) then
    match b
    when Type::Option(t2) then infer_types_equal(t1, t2)
    when _ then false
    end
  when Type::Result(ok1, err1) then
    match b
    when Type::Result(ok2, err2) then
      infer_types_equal(ok1, ok2) && infer_types_equal(err1, err2)
    when _ then false
    end
  when Type::Map(k1, v1) then
    match b
    when Type::Map(k2, v2) then
      infer_types_equal(k1, k2) && infer_types_equal(v1, v2)
    when _ then false
    end
  when Type::Set(t1) then
    match b
    when Type::Set(t2) then infer_types_equal(t1, t2)
    when _ then false
    end
  when Type::Slice(t1) then
    match b
    when Type::Slice(t2) then infer_types_equal(t1, t2)
    when _ then false
    end
  when Type::Array(t1, n1) then
    match b
    when Type::Array(t2, n2) then n1 == n2 && infer_types_equal(t1, t2)
    when _ then false
    end
  when Type::Tuple(elems1) then
    match b
    when Type::Tuple(elems2) then infer_type_lists_equal(elems1, elems2)
    when _ then false
    end
  when Type::Function(p1, r1) then
    match b
    when Type::Function(p2, r2) then
      if p1.len() != p2.len() then
        false
      else
        var ok = true
        var i = 0
        while i < p1.len() do
          if !infer_types_equal(&p1[i].ty, &p2[i].ty) then
            ok = false
            break
          end
          if !(p1[i].convention == p2[i].convention) then
            ok = false
            break
          end
          i = i + 1
        end
        ok && infer_types_equal(r1, r2)
      end
    when _ then false
    end
  when Type::RefInternal(t1, m1) then
    match b
    when Type::RefInternal(t2, m2) then m1 == m2 && infer_types_equal(t1, t2)
    when _ then false
    end
  when Type::Ptr(t1) then
    match b
    when Type::Ptr(t2) then infer_types_equal(t1, t2)
    when _ then false
    end
  when Type::PtrMut(t1) then
    match b
    when Type::PtrMut(t2) then infer_types_equal(t1, t2)
    when _ then false
    end
  when Type::Box(t1) then
    match b
    when Type::Box(t2) then infer_types_equal(t1, t2)
    when _ then false
    end
  when Type::Rc(t1) then
    match b
    when Type::Rc(t2) then infer_types_equal(t1, t2)
    when _ then false
    end
  when Type::Dyn(id1) then
    match b
    when Type::Dyn(id2) then id1.id == id2.id
    when _ then false
    end
  when Type::Effect(effects1, t1) then
    match b
    when Type::Effect(effects2, t2) then
      if effects1.len() != effects2.len() then
        false
      else
        var ok = true
        var i = 0
        while i < effects1.len() do
          if !(effects1[i] == effects2[i]) then
            ok = false
            break
          end
          i = i + 1
        end
        ok && infer_types_equal(t1, t2)
      end
    when _ then false
    end
  end
end

def infer_type_lists_equal(a: &Vec[Type], b: &Vec[Type]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if !infer_types_equal(&a[i], &b[i]) then
      return false
    end
    i = i + 1
  end
  true
end

# Check whether a type contains any Type::Var reference (deferred inference
# state that a later specialization iteration may still resolve).
def type_has_var(ty: &Type) -> Bool
  match ty
  when Type::Var(_) then true
  when Type::Option(inner) then type_has_var(inner)
  when Type::Result(ok, err) then type_has_var(ok) || type_has_var(err)
  when Type::Map(k, v) then type_has_var(k) || type_has_var(v)
  when Type::Set(inner) then type_has_var(inner)
  when Type::Slice(inner) then type_has_var(inner)
  when Type::Array(inner, _) then type_has_var(inner)
  when Type::Tuple(elems) then
    var found = false
    for e in elems do
      if type_has_var(&e) then found = true; break end
    end
    found
  when Type::Function(params, ret) then
    var found = false
    for p in params do
      if type_has_var(&p.ty) then found = true; break end
    end
    found || type_has_var(ret)
  when Type::Named(_, args) then
    var found = false
    for a in args do
      if type_has_var(&a) then found = true; break end
    end
    found
  when Type::RefInternal(inner, _) then type_has_var(inner)
  when Type::Ptr(inner) then type_has_var(inner)
  when Type::PtrMut(inner) then type_has_var(inner)
  when Type::Box(inner) then type_has_var(inner)
  when Type::Rc(inner) then type_has_var(inner)
  when Type::Effect(_, inner) then type_has_var(inner)
  when _ then false
  end
end

# A type is concrete when it carries no Type::Param and no Type::Var.
def type_is_concrete(ty: &Type) -> Bool
  !type_has_params(ty) && !type_has_var(ty)
end

# Record a binding of a parameter name to the argument sub-structure at a
# position.  A second occurrence must agree: two different CONCRETE types
# for the same name are an inconsistency error; a binding that still
# carries Params/Vars is a deferred generic-caller shape, kept as-is (a
# concrete later occurrence replaces it).
def bind_param_name(
  name: String,
  ty: &Type,
  bindings: &mut Map[String, Type],
  errors: &mut Vec[String]
) -> Unit
  match bindings.get(&name)
  when Option::Some(existing) then
    if !type_is_concrete(existing) || !type_is_concrete(ty) then
      if !type_is_concrete(existing) && type_is_concrete(ty) then
        bindings.insert(name.clone(), ty.clone())
      end
    else
      if !infer_types_equal(existing, ty) then
        let msg = "inconsistent type parameter inference for `" + name + "`"
        if !errors.contains(&msg) then
          errors.push(msg)
        end
      end
    end
  when Option::None then bindings.insert(name.clone(), ty.clone())
  end
end

# Structural matcher: walk param_ty against arg_ty in lockstep, binding
# Type::Param names to the argument's sub-structure.  Container kinds
# recurse positionally into the matching arg kind.  Reference/smart-pointer
# wrappers on either side are peeled before descending (MIR lowers method
# receivers to RefInternal-wrapped params while call-site arguments carry
# the bare local type).  Non-matching shapes bind nothing: the parameter is
# left for a later (generic-caller) iteration or reported as uninferrable.
def infer_match_types(
  param_ty: &Type,
  arg_ty: &Type,
  bindings: &mut Map[String, Type],
  errors: &mut Vec[String]
) -> Unit
  match param_ty
  when Type::Param(name) then
    bind_param_name(name.clone(), arg_ty, bindings, errors)
  when Type::Option(inner) then
    match arg_ty
    when Type::Option(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when _ then ()
    end
  when Type::Result(ok, err) then
    match arg_ty
    when Type::Result(a_ok, a_err) then
      infer_match_types(ok, a_ok, bindings, errors)
      infer_match_types(err, a_err, bindings, errors)
    when _ then ()
    end
  when Type::Map(k, v) then
    match arg_ty
    when Type::Map(a_k, a_v) then
      infer_match_types(k, a_k, bindings, errors)
      infer_match_types(v, a_v, bindings, errors)
    when _ then ()
    end
  when Type::Set(inner) then
    match arg_ty
    when Type::Set(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when _ then ()
    end
  when Type::Slice(inner) then
    match arg_ty
    when Type::Slice(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when _ then ()
    end
  when Type::Array(inner, n) then
    match arg_ty
    when Type::Array(a_inner, a_n) then
      if n == a_n then infer_match_types(inner, a_inner, bindings, errors) end
    when _ then ()
    end
  when Type::Tuple(elems) then
    match arg_ty
    when Type::Tuple(a_elems) then
      if elems.len() == a_elems.len() then
        var i = 0
        while i < elems.len() do
          infer_match_types(&elems[i], &a_elems[i], bindings, errors)
          i = i + 1
        end
      end
    when _ then ()
    end
  when Type::Function(params, ret) then
    match arg_ty
    when Type::Function(a_params, a_ret) then
      if params.len() == a_params.len() then
        var i = 0
        while i < params.len() do
          infer_match_types(&params[i].ty, &a_params[i].ty, bindings, errors)
          i = i + 1
        end
      end
      infer_match_types(ret, a_ret, bindings, errors)
    when _ then ()
    end
  when Type::Named(id, args) then
    match arg_ty
    when Type::Named(a_id, a_args) then
      if id.id == a_id.id && args.len() == a_args.len() then
        var i = 0
        while i < args.len() do
          infer_match_types(&args[i], &a_args[i], bindings, errors)
          i = i + 1
        end
      end
    when _ then ()
    end
  when Type::RefInternal(inner, _) then
    match arg_ty
    when Type::RefInternal(a_inner, _) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Ptr(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::PtrMut(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Box(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Rc(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when _ then infer_match_types(inner, arg_ty, bindings, errors)
    end
  when Type::Ptr(inner) then
    match arg_ty
    when Type::Ptr(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::RefInternal(a_inner, _) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::PtrMut(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Box(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Rc(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when _ then infer_match_types(inner, arg_ty, bindings, errors)
    end
  when Type::PtrMut(inner) then
    match arg_ty
    when Type::PtrMut(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Ptr(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::RefInternal(a_inner, _) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Box(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Rc(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when _ then infer_match_types(inner, arg_ty, bindings, errors)
    end
  when Type::Box(inner) then
    match arg_ty
    when Type::Box(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Ptr(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::PtrMut(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::RefInternal(a_inner, _) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Rc(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when _ then infer_match_types(inner, arg_ty, bindings, errors)
    end
  when Type::Rc(inner) then
    match arg_ty
    when Type::Rc(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Ptr(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::PtrMut(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::Box(a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when Type::RefInternal(a_inner, _) then infer_match_types(inner, a_inner, bindings, errors)
    when _ then infer_match_types(inner, arg_ty, bindings, errors)
    end
  when Type::Effect(_, inner) then
    match arg_ty
    when Type::Effect(_, a_inner) then infer_match_types(inner, a_inner, bindings, errors)
    when _ then infer_match_types(inner, arg_ty, bindings, errors)
    end
  when _ then ()
  end
end

# The caller's context for the return-type-only case: the destination local
# of the call.  For method calls the MIR builder types it with the typed
# program's concrete call-result type (the "let-binding" inference), so the
# callee's return type can be matched against it.
def dest_place_type(caller_func: &MirFunction, dest: &Place) -> Option[Type]
  let idx = dest.local.id
  if idx >= 0 && idx < caller_func.locals.len() then
    Option::Some(caller_func.locals[idx].ty.clone())
  else
    Option::None
  end
end

# Legacy heuristic fallback retained ONLY for parameters that appear in no
# parameter position and cannot be resolved from the caller's return-type
# context (e.g. Vec::new-style constructors, whose MIR destination type
# still carries the callee's own Param): infer from the first call argument
# if any, else Unit — exactly the pre-fix behavior for these shapes.
def legacy_fallback_type(caller_func: &MirFunction, call_args: &Vec[MirCallArg]) -> Type
  if call_args.len() > 0 then
    let arg_op0 = mir_call_arg_operand(&call_args[0])
    operand_type_from_func(caller_func, &arg_op0)
  else
    Type::Unit
  end
end

# Check whether any parameter position of the callee mentions the name.
def param_positions_use_name(func: &MirFunction, name: &String) -> Bool
  for p in func.params do
    if type_uses_param_name(&p.ty, name) then
      return true
    end
  end
  false
end

# P0-AL (final): infer concrete type arguments for a generic function from
# a call site — the FALLBACK ONLY for calls without a recorded solved
# instance (IR-synthesized calls and the residual shapes no checker context
# solved). Source calls consume their recorded instances with ZERO
# inference; this structural argument-match is the "instantiate with the
# caller's context" rule for the rest. For each type parameter name of the
# generic function, structurally match the callee's parameter types against
# the call's argument types; a name bound in a parameter position is taken
# from the argument SUB-STRUCTURE. Names that appear in no parameter
# position are resolved from the caller's destination
# (return-type-only case — the MIR dest_place_type gives the caller's
# expected type) or fall back to the legacy heuristic.
# Returns type_args in the same order as type_param_names, plus any
# inference errors.
def infer_type_args_for_call(
  generic_func: &MirFunction,
  type_param_names: &Vec[String],
  caller_func: &MirFunction,
  call_args: &Vec[MirCallArg],
  dest: &Place
) -> TypeInferenceResult
  var bindings: Map[String, Type] = Map::new()
  var errors = Vec::new()

  # 1. Structural matching of every parameter position against its argument.
  var param_idx: Int = 0
  while param_idx < generic_func.params.len() && param_idx < call_args.len() do
    let arg_op = mir_call_arg_operand(&call_args[param_idx])
    let arg_ty = operand_type_from_func(caller_func, &arg_op)
    infer_match_types(&generic_func.params[param_idx].ty, &arg_ty, &mut bindings, &mut errors)
    param_idx = param_idx + 1
  end

  # 2. Return-type-only parameters: resolve from the caller's context — the
  #    destination local's type of the call (the "let-binding" inference).
  var dest_bindings: Map[String, Type] = Map::new()
  match dest_place_type(caller_func, dest)
  when Option::Some(dest_ty) then
    if dest_ty != Type::Unit && type_has_params(&generic_func.ret_type) then
      var dest_errors = Vec::new()
      infer_match_types(&generic_func.ret_type, &dest_ty, &mut dest_bindings, &mut dest_errors)
    end
  when Option::None then ()
  end

  # 3. Assemble type args in type_param_names order.
  var type_args = Vec::new()
  for name in type_param_names do
    match bindings.get(&name)
    when Option::Some(ty) then
      type_args.push(ty.clone())
    when Option::None then
      if param_positions_use_name(generic_func, &name) then
        # The name occurs in a parameter position but every occurrence was a
        # deferred (Param/Var-typed or shape-mismatched) argument: leave the
        # name unbound so the worklist's Param filter defers this call site
        # to a later specialization iteration.
        type_args.push(Type::Param(name.clone()))
      elsif type_uses_param_name(&generic_func.ret_type, &name) then
        # Return-type-only parameter: adopt the destination-derived binding
        # when it is fully concrete (the caller's context resolved it);
        # otherwise retain the legacy fallback (e.g. Vec::new-style
        # constructors whose MIR destination still carries the callee's own
        # Param, or a still-generic caller).
        match dest_bindings.get(&name)
        when Option::Some(dty) then
          if type_is_concrete(dty) then
            type_args.push(dty.clone())
          else
            type_args.push(legacy_fallback_type(caller_func, call_args))
          end
        when Option::None then
          type_args.push(legacy_fallback_type(caller_func, call_args))
        end
      else
        # Phantom parameter that appears in no parameter position and no
        # return type: retained legacy fallback (first argument's type, else
        # Unit) — matches the pre-fix behavior for these shapes.
        type_args.push(legacy_fallback_type(caller_func, call_args))
      end
    end
  end

  TypeInferenceResult { type_args: type_args, errors: errors }
end

# Look up or create a monomorphized instance for a generic function call.
# Returns the mangled name.
def monomorphize(cache: &mut MonoCache, func_name: String, type_args: Vec[Type]) -> String
  # Check if already monomorphized
  for entry in cache.entries do
    if entry.key.func_name == func_name && types_equal(&entry.key.type_args, &type_args) then
      return entry.mangled_name.clone()
    end
  end

  # Create new monomorphized instance
  let mangled = mangle_name(func_name.clone(), &type_args)
  cache.entries.push(MonoEntry {
    key: MonoKey {
      func_name: func_name,
      type_args: type_args
    },
    mangled_name: mangled.clone()
  })
  mangled
end

# ———————————————————————————————————————————————————————————————
# Monomorphization Body Specialization
# ———————————————————————————————————————————————————————————————
# Given a generic MIR function and concrete type arguments, produce
# a specialized copy with all type parameters substituted.

struct TypeSubstMap
  # Maps type parameter names to concrete types
  params: Map[String, Type]
end

def type_subst_new(type_param_names: &Vec[String], type_args: &Vec[Type]) -> TypeSubstMap
  var params = Map::new()
  var i = 0
  while i < type_param_names.len() && i < type_args.len() do
    params.insert(type_param_names[i].clone(), type_args[i].clone())
    i = i + 1
  end
  TypeSubstMap { params: params }
end

# P0-AL: specialize a generic function under an EXPLICIT mangled name — the
# solved-instance path's specialization. When a call's MirFnItem carries a
# solved instance, the specialized body is named by the INSTANCE's key
# (instance_key) so the emitted name and the cache key agree; the fallback
# name-derived path (specialize_function below) delegates here after
# computing mangle_name. The specialization always proceeds from the given
# (solved or inferred) type args.
def specialize_function_named(
  cache: &mut MonoCache,
  original: &MirFunction,
  type_param_names: &Vec[String],
  type_args: &Vec[Type],
  mangled: String
) -> MirFunction
  # If already specialized, return cached version
  match cache.specialized_bodies.get(&mangled)
  when Option::Some(existing) then return existing.clone()
  when Option::None then ()
  end
  
  let subst = type_subst_new(type_param_names, type_args)
  
  # Create specialized function with substituted types
  var specialized = MirFunction {
    name: mangled.clone(),
    params: Vec::new(),
    ret_type: substitute_type(&subst, &original.ret_type),
    locals: Vec::new(),
    blocks: Vec::new(),
    entry_block: BlockId { id: original.entry_block.id },
    is_async: original.is_async,
    is_unsafe: original.is_unsafe,
    is_extern: original.is_extern,
    extern_abi: original.extern_abi.clone(),
    contracts: original.contracts.clone(),
    span: original.span.clone()
  }
  
  # Substitute parameter types
  for param in original.params do
    specialized.params.push(MirLocal {
      id: LocalId { id: param.id.id },
      name: param.name.clone(),
      ty: substitute_type(&subst, &param.ty),
      is_mut: param.is_mut,
      span: param.span
    })
  end
  
  # Substitute local variable types
  for local in original.locals do
    specialized.locals.push(MirLocal {
      id: LocalId { id: local.id.id },
      name: local.name.clone(),
      ty: substitute_type(&subst, &local.ty),
      is_mut: local.is_mut,
      span: local.span
    })
  end
  
  # Deep-copy and substitute all blocks
  for block in original.blocks do
    var new_stmts = Vec::new()
    for stmt in block.statements do
      new_stmts.push(substitute_statement(&subst, &stmt))
    end
    
    specialized.blocks.push(MirBlock {
      id: BlockId { id: block.id.id },
      statements: new_stmts,
      terminator: substitute_terminator(&subst, &block.terminator)
    })
  end
  
  # Verification: after instantiation, a CONCRETE codegen instance must
  # carry no Type::Param and no unresolved Type::Var anywhere in the
  # instantiated types (params, return type, locals). An uninferred
  # parameter would poison the mangled name and the specialized body; a
  # Var (produced when the substitution chased a still-generic caller's
  # argument type) is equally non-codegenable. A violation records an
  # error and fails the specialization (the body is not cached, so the
  # call site is never rewritten to a poisoned name).
  match residual_param_in_function(&specialized, type_param_names)
  when Option::Some(what) then
    let msg = what + " remains in instantiated types of `" + original.name + "`"
    if !cache.errors.contains(&msg) then
      cache.errors.push(msg)
    end
    return specialized
  when Option::None then ()
  end
  
  # Cache the specialized body
  cache.specialized_bodies.insert(mangled, specialized.clone())
  specialized
end

def specialize_function(
  cache: &mut MonoCache,
  original: &MirFunction,
  type_param_names: &Vec[String],
  type_args: &Vec[Type]
) -> MirFunction
  # Name-derived path (unsolved shapes): the mangled name comes from the
  # function name + type args. Solved-instance calls instead pass the
  # instance's key (instance_key) directly to specialize_function_named.
  let mangled = monomorphize(cache, original.name.clone(), type_args.clone())
  specialize_function_named(cache, original, type_param_names, type_args, mangled)
end

# P0-AL (final): the post-instantiation verification. A specialized body is
# a CONCRETE codegen instance: it must contain no Type::Param and no
# unresolved Type::Var anywhere (params, return type, locals). The first
# violation is described as:
#   - "type parameter `<name>`" — the callee's own parameter the
#     substitution failed to cover (a recorded instance whose substs are
#     shorter than infer_type_param_names), or a stray Param from a
#     still-generic caller's argument types;
#   - "inference variable (Type::Var)" — a Var the substitution produced
#     (the type args carried it; the subst resolution chases env.subst at
#     specialization time and a Var has no mapping there).
def residual_param_in_function(f: &MirFunction, names: &Vec[String]) -> Option[String]
  for name in names do
    if type_uses_param_name(&f.ret_type, &name) then
      return Option::Some("type parameter `" + name + "`")
    end
    for p in f.params do
      if type_uses_param_name(&p.ty, &name) then
        return Option::Some("type parameter `" + name + "`")
      end
    end
    for l in f.locals do
      if type_uses_param_name(&l.ty, &name) then
        return Option::Some("type parameter `" + name + "`")
      end
    end
  end
  match first_param_name_in_function(f)
  when Option::Some(pname) then return Option::Some("type parameter `" + pname + "`")
  when Option::None then ()
  end
  if residual_var_in_function(f) then
    return Option::Some("inference variable (Type::Var)")
  end
  Option::None
end

# Find the first Type::Param name anywhere in a function's instantiated
# types (params, return type, locals).
def first_param_name_in_function(f: &MirFunction) -> Option[String]
  match first_param_name_in_type(&f.ret_type)
  when Option::Some(n) then return Option::Some(n)
  when Option::None then ()
  end
  for p in f.params do
    match first_param_name_in_type(&p.ty)
    when Option::Some(n) then return Option::Some(n)
    when Option::None then ()
    end
  end
  for l in f.locals do
    match first_param_name_in_type(&l.ty)
    when Option::Some(n) then return Option::Some(n)
    when Option::None then ()
    end
  end
  Option::None
end

# Find the first Type::Param name in a type (mirrors type_has_params).
def first_param_name_in_type(ty: &Type) -> Option[String]
  match ty
  when Type::Param(name) then Option::Some(name.clone())
  when Type::Option(inner) then first_param_name_in_type(inner)
  when Type::Result(ok, err) then
    match first_param_name_in_type(ok)
    when Option::Some(n) then Option::Some(n)
    when Option::None then first_param_name_in_type(err)
    end
  when Type::Map(k, v) then
    match first_param_name_in_type(k)
    when Option::Some(n) then Option::Some(n)
    when Option::None then first_param_name_in_type(v)
    end
  when Type::Set(inner) then first_param_name_in_type(inner)
  when Type::Slice(inner) then first_param_name_in_type(inner)
  when Type::Array(inner, _) then first_param_name_in_type(inner)
  when Type::Tuple(elems) then
    for e in elems do
      match first_param_name_in_type(&e)
      when Option::Some(n) then return Option::Some(n)
      when Option::None then ()
      end
    end
    Option::None
  when Type::Function(params, ret) then
    for p in params do
      match first_param_name_in_type(&p.ty)
      when Option::Some(n) then return Option::Some(n)
      when Option::None then ()
      end
    end
    first_param_name_in_type(ret)
  when Type::Named(_, args) then
    for a in args do
      match first_param_name_in_type(&a)
      when Option::Some(n) then return Option::Some(n)
      when Option::None then ()
      end
    end
    Option::None
  when Type::RefInternal(inner, _) then first_param_name_in_type(inner)
  when Type::Ptr(inner) then first_param_name_in_type(inner)
  when Type::PtrMut(inner) then first_param_name_in_type(inner)
  when Type::Box(inner) then first_param_name_in_type(inner)
  when Type::Rc(inner) then first_param_name_in_type(inner)
  when Type::Effect(_, inner) then first_param_name_in_type(inner)
  when _ then Option::None
  end
end

# Whether any unresolved Type::Var appears anywhere in a function's
# instantiated types.
def residual_var_in_function(f: &MirFunction) -> Bool
  if type_has_unresolved_var(&f.ret_type) then return true end
  for p in f.params do
    if type_has_unresolved_var(&p.ty) then return true end
  end
  for l in f.locals do
    if type_has_unresolved_var(&l.ty) then return true end
  end
  false
end

# Whether a type contains any Type::Var (mirrors type_has_params).
def type_has_unresolved_var(ty: &Type) -> Bool
  match ty
  when Type::Var(_) then true
  when Type::Option(inner) then type_has_unresolved_var(inner)
  when Type::Result(ok, err) then type_has_unresolved_var(ok) || type_has_unresolved_var(err)
  when Type::Map(k, v) then type_has_unresolved_var(k) || type_has_unresolved_var(v)
  when Type::Set(inner) then type_has_unresolved_var(inner)
  when Type::Slice(inner) then type_has_unresolved_var(inner)
  when Type::Array(inner, _) then type_has_unresolved_var(inner)
  when Type::Tuple(elems) then
    var found = false
    for e in elems do
      if type_has_unresolved_var(&e) then found = true; break end
    end
    found
  when Type::Function(params, ret) then
    var found = false
    for p in params do
      if type_has_unresolved_var(&p.ty) then found = true; break end
    end
    found || type_has_unresolved_var(ret)
  when Type::Named(_, args) then
    var found = false
    for a in args do
      if type_has_unresolved_var(&a) then found = true; break end
    end
    found
  when Type::RefInternal(inner, _) then type_has_unresolved_var(inner)
  when Type::Ptr(inner) then type_has_unresolved_var(inner)
  when Type::PtrMut(inner) then type_has_unresolved_var(inner)
  when Type::Box(inner) then type_has_unresolved_var(inner)
  when Type::Rc(inner) then type_has_unresolved_var(inner)
  when Type::Effect(_, inner) then type_has_unresolved_var(inner)
  when _ then false
  end
end

# P0-AL (final): the ONE exhaustive substitution visitor — the sole
# substitution path into a specialized body. Every structural Type variant
# (Named/Tuple/Function/RefInternal/Ptr/PtrMut/Box/Rc/Option/Result/Map/
# Set/Array/Slice/Effect) is rebuilt with its inner types substituted; the
# non-structural variants (primitives, Var, Error, Dyn) are identity-cloned
# by the fallback arm. The post-instantiation verification
# (residual_param_in_function) rejects any Param/Var the visitor leaves
# behind.
def substitute_type(subst: &TypeSubstMap, ty: &Type) -> Type
  match ty
  when Type::Param(name) then
    match subst.params.get(&name)
    when Option::Some(concrete) then concrete.clone()
    when Option::None then ty.clone()
    end
  when Type::Option(inner) then Type::Option(Box::new(substitute_type(subst, inner)))
  when Type::Result(ok, err) then
    Type::Result(Box::new(substitute_type(subst, ok)), Box::new(substitute_type(subst, err)))
  when Type::Map(k, v) then
    Type::Map(Box::new(substitute_type(subst, k)), Box::new(substitute_type(subst, v)))
  when Type::Set(inner) then Type::Set(Box::new(substitute_type(subst, inner)))
  when Type::Slice(inner) then Type::Slice(Box::new(substitute_type(subst, inner)))
  when Type::Array(inner, n) then Type::Array(Box::new(substitute_type(subst, inner)), n)
  when Type::RefInternal(inner, mutable) then Type::RefInternal(Box::new(substitute_type(subst, inner)), mutable)
  when Type::Ptr(inner) then Type::Ptr(Box::new(substitute_type(subst, inner)))
  when Type::PtrMut(inner) then Type::PtrMut(Box::new(substitute_type(subst, inner)))
  when Type::Box(inner) then Type::Box(Box::new(substitute_type(subst, inner)))
  when Type::Rc(inner) then Type::Rc(Box::new(substitute_type(subst, inner)))
  when Type::Effect(effects, inner) then Type::Effect(effects.clone(), Box::new(substitute_type(subst, inner)))
  when Type::Tuple(elems) then
    var subs = Vec::new()
    for e in elems do
      subs.push(substitute_type(subst, &e))
    end
    Type::Tuple(subs)
  when Type::Function(params, ret) then
    var sub_params = Vec::new()
    for p in params do
      sub_params.push(ParamType { ty: substitute_type(subst, &p.ty), convention: p.convention })
    end
    Type::Function(sub_params, Box::new(substitute_type(subst, ret)))
  when Type::Named(id, args) then
    var sub_args = Vec::new()
    for a in args do
      sub_args.push(substitute_type(subst, &a))
    end
    Type::Named(id, sub_args)
  when _ then ty.clone()
  end
end

def substitute_statement(subst: &TypeSubstMap, stmt: &MirStatement) -> MirStatement
  match stmt.kind
  when MirStatementKind::MirAssign(place, rvalue) then
    MirStatement {
      kind: MirStatementKind::MirAssign(place.clone(), substitute_rvalue(subst, &rvalue)),
      span: stmt.span.clone()
    }
  when _ then stmt.clone()
  end
end

def substitute_rvalue(subst: &TypeSubstMap, rvalue: &MirRvalue) -> MirRvalue
  match rvalue.kind
  when MirRvalueKind::MirCast(kind, op, target_ty) then
    MirRvalue { kind: MirRvalueKind::MirCast(kind.clone(), op.clone(), substitute_type(subst, &target_ty)) }
  when MirRvalueKind::MirAggregate(kind, ops) then
    # Substitute type in aggregate kind if it references generics
    MirRvalue { kind: MirRvalueKind::MirAggregate(substitute_aggregate_kind(subst, &kind), ops.clone()) }
  when _ then rvalue.clone()
  end
end

def substitute_aggregate_kind(subst: &TypeSubstMap, kind: &AggregateKind) -> AggregateKind
  match kind
  when AggregateKind::Tuple then AggregateKind::Tuple
  when AggregateKind::MirArray(ty) then AggregateKind::MirArray(ty)
  when AggregateKind::Struct(tid, fields) then AggregateKind::Struct(tid.clone(), fields.clone())
  when _ then kind.clone()
  end
end

# Substitute types in an operand (recursively substitutes in places and constants)
def substitute_operand(subst: &TypeSubstMap, op: &MirOperand) -> MirOperand
  match op.kind
  when MirOperandKind::MirCopy(place) then
    MirOperand { kind: MirOperandKind::MirCopy(substitute_place(subst, &place)) }
  when MirOperandKind::MirMovePlace(place) then
    MirOperand { kind: MirOperandKind::MirMovePlace(substitute_place(subst, &place)) }
  when MirOperandKind::MirRead(place) then
    MirOperand { kind: MirOperandKind::MirRead(substitute_place(subst, &place)) }
  when MirOperandKind::MirConsume(place) then
    MirOperand { kind: MirOperandKind::MirConsume(substitute_place(subst, &place)) }
  when MirOperandKind::MirConstant(c) then
    MirOperand { kind: MirOperandKind::MirConstant(MirConstant {
      kind: c.kind.clone(),
      ty: substitute_type(subst, &c.ty),
      instance: c.instance.clone()
    })}
  end
end

# Substitute types in a place (places are local + projections, types are in locals)
def substitute_place(subst: &TypeSubstMap, place: &Place) -> Place
  Place {
    local: place.local.clone(),
    projections: place.projections.clone()
  }
end

def substitute_call_arg(subst: &TypeSubstMap, arg: &MirCallArg) -> MirCallArg
  MirCallArg {
    effect: arg.effect.clone(),
    value: match arg.value
    when MirCallValue::Value(op) then MirCallValue::Value(substitute_operand(subst, &op))
    when MirCallValue::Place(p) then MirCallValue::Place(substitute_place(subst, &p))
    end
  }
end

def substitute_terminator(subst: &TypeSubstMap, term: &MirTerminator) -> MirTerminator
  let new_kind = match term.kind
  when MirTerminatorKind::MirCall(dest, func_op, args, target, unwind) then
    # Mangle callee name with substituted type arguments
    let mangled_op = substitute_operand(subst, &func_op)
    # Substitute types in arguments
    var new_args = Vec::new()
    for arg in args do
      new_args.push(substitute_call_arg(subst, arg))
    end
    # Substitute return type in destination
    let new_dest = substitute_place(subst, &dest)
    MirTerminatorKind::MirCall {
      dest: new_dest,
      func: mangled_op,
      args: new_args,
      success: target.clone(),
      unwind: unwind.clone()
    }
  when MirTerminatorKind::MirSwitchInt(discr, targets, default_target) then
    let new_discr = substitute_operand(subst, &discr)
    MirTerminatorKind::MirSwitchInt { op: new_discr, targets: targets.clone(), default_target: default_target.clone() }
  when MirTerminatorKind::MirDeinit(place, deinit_fn, target, unwind) then
    let new_place = substitute_place(subst, &place)
    MirTerminatorKind::MirDeinit { place: new_place, deinit_fn: deinit_fn.clone(), target: target.clone(), unwind: unwind.clone() }
  when MirTerminatorKind::MirAssert(cond, expected, msg, target, unwind) then
    let new_cond = substitute_operand(subst, &cond)
    MirTerminatorKind::MirAssert {
      cond: new_cond,
      expected: expected.clone(),
      msg: msg.clone(),
      target: target.clone(),
      unwind: unwind.clone()
    }
  when _ then
    term.kind.clone()
  end
  MirTerminator { kind: new_kind, span: term.span.clone() }
end

# Mangle a function name with type substitutions for monomorphization
def mangle_with_subst(name: &String, subst: &TypeSubstMap) -> String
  if subst.params.is_empty() then
    return name.clone()
  end
  var mangled = name.clone()
  for (param, ty) in subst.params.entries() do
    mangled = mangled + "_" + type_to_mangled_name(ty)
  end
  mangled
end

def type_to_mangled_name(ty: &Type) -> String
  match ty
  when Type::Int then "Int"
  when Type::Float then "Float"
  when Type::Bool then "Bool"
  when Type::String then "String"
  when Type::Unit then "Unit"
  when Type::Named(id, args) then
    if args.is_empty() then
      "t" + id.id.to_string()
    else
      var s = "t" + id.id.to_string()
      for arg in args do
        s = s + "_" + type_to_mangled_name(arg)
      end
      s
    end
  when _ then "unknown"
  end
end

# ———————————————————————————————————————————————————————————————
# Call-Site Rewriting
# ———————————————————————————————————————————————————————————————

# After monomorphization, rewrite all call sites that reference generic
# functions so they point to the specialized (mangled) version instead.
def rewrite_call_sites_in_program(mir: &mut MirProgram, cache: &mut MonoCache) -> Unit
  # Pre-build a set of generic function names for fast lookup
  var generic_names = Set::new()
  for f in mir.functions do
    if is_generic_function(f) then
      generic_names.insert(f.name.clone())
    end
  end

  for func in mir.functions do
    for block in func.blocks do
      match block.terminator.kind
      when MirTerminatorKind::MirCall(dest, callee, args, success, unwind) then
        match callee.kind
        when MirOperandKind::MirConstant(const_val) then
          match const_val.kind
          when MirConstantKind::MirFnItem(callee_name) then
            # Only process calls to known generic functions
            if generic_names.contains(&callee_name) then
              # Look up the function definition in the program
              for candidate in mir.functions do
                if candidate.name == callee_name then
                  # P0-AL (final): a SOLVED INSTANCE is the AUTHORITY. When
                  # the call operand's MirConstant carries an instance with
                  # NON-EMPTY substs (the type checker solved this call's
                  # generic arguments), use inst.substs as the type args
                  # DIRECTLY — zero inference for this call; instance_key
                  # produces the mangled name.
                  # P0-AL doc: solved instances are the authority; infer_type_args_for_call is the fallback only for unsolved shapes (None/empty instances, or solved substs still carrying Params from a generic caller).
                  var mangled = "".to_string()
                  var used_instance = false
                  match const_val.instance.clone()
                  when Option::Some(inst) then
                    if !inst.substs.is_empty() && !has_any_param_types(&inst.substs) then
                      mangled = instance_key(&inst)
                      used_instance = true
                    end
                  when Option::None then ()
                  end
                  if !used_instance then
                    # Infer concrete type args from this call site (fallback)
                    let type_param_names = infer_type_param_names(candidate)
                    let inference = infer_type_args_for_call(
                      candidate, &type_param_names, func, args, &dest
                    )
                    for err in inference.errors do
                      if !cache.errors.contains(&err) then
                        cache.errors.push(err)
                      end
                    end
                    # Compute the mangled name and check the cache
                    mangled = mangle_name(callee_name.clone(), &inference.type_args)
                  end
                  if cache.specialized_bodies.contains_key(&mangled) then
                    # Rewrite the call site to use the mangled name. The
                    # rewritten MirFnItem KEEPS the constant's P0-AK instance
                    # payload (the semantic callee identity survives the
                    # emission-key rewrite).
                    block.terminator.kind = MirTerminatorKind::MirCall(
                      dest.clone(),
                      MirOperand {
                        kind: MirOperandKind::MirConstant(MirConstant {
                          kind: MirConstantKind::MirFnItem(mangled),
                          ty: const_val.ty.clone(),
                          instance: const_val.instance.clone()
                        })
                      },
                      args.clone(),
                      success.clone(),
                      unwind.clone()
                    )
                  end
                  break
                end
              end
            end
          when _ then ()
          end
        when _ then ()
        end
      when _ then ()
      end
    end
  end
end

# Check if any type in a vector contains Type::Param.
def has_any_param_types(types: &Vec[Type]) -> Bool
  for ty in types do
    if type_has_params(ty) then return true end
  end
  false
end

# ———————————————————————————————————————————————————————————————
# Monomorphize Program: worklist-based entry point
# ———————————————————————————————————————————————————————————————
# P0-AL (final): the worklist is instance-driven. The entry instances are
# the generic call sites of the program's functions; each call's callee
# instance is the SOLVED substitution the type checker recorded for the
# call node (typed_call_instances, threaded through the MirFnItem's
# InstanceId payload). The worklist specializes each discovered instance
# and then REWALKS the specialized bodies' calls, discovering the callee
# instances TRANSITIVELY — the exhaustive walk. A call to an
# already-specialized instance is a cache hit (specialized_bodies keyed by
# instance_key). The checker solves EVERY source-call shape (impl-registry
# methods, builtin-method generics, extension-impl methods, and
# return-type-only parameters via the caller's annotation context), so the
# fallback — infer_type_args_for_call, the structural argument-match — is
# zero-inference for source calls: it fires only for IR-synthesized calls
# and the residual shapes no context ever solved (a return-type-only
# parameter without an annotation, solved by the MIR destination local's
# type). Iterates until no new generic call sites remain; after each
# iteration, calls rewrite_call_sites_in_program so that existing call
# sites are updated to point to the newly-mangled names.

def monomorphize_program(mir: &mut MirProgram, cache: &mut MonoCache) -> Unit
  var changed = true
  var iter = 0
  while changed do
    changed = false
    iter = iter + 1
    eprintln("[mono] iter=" + iter.to_string() + " functions=" + mir.functions.len().to_string())
    if iter > 8 then
      eprintln("[mono] giving up after 8 iterations — probable runaway")
      return
    end

    # Phase 1: collect generic call sites and infer type args. Worklist
    # entries carry (callee name, type args, mangled name): a call whose
    # MirFnItem constant carries a SOLVED instance (non-empty, fully
    # concrete substs) enters under the INSTANCE's key.
    # P0-AL (final): the recorded instances cover every shape the checker
    # solves — the impl-registry generic methods, the builtin-method
    # generics (Option::map / Result::and_then / ...), the extension-impl
    # methods (`impl[T, I: Iterator[T]] I`), and the return-type-only
    # parameters solved by the caller's annotation context. The fallback
    # below (infer_type_args_for_call) therefore fires only for
    # IR-synthesized calls (no InstanceId payload) and the residual
    # unsolved shapes — its structural argument-match IS the
    # "instantiate with the caller's context" rule for those calls.
    var worklist: Vec[(String, Vec[Type], String)] = Vec::new()
    for func in mir.functions do
      for block in func.blocks do
        match block.terminator.kind
        when MirTerminatorKind::MirCall(dest, callee, args, _, _) then
          match callee.kind
          when MirOperandKind::MirConstant(cv) then
            match cv.kind
            when MirConstantKind::MirFnItem(callee_name) then
              # Look up the callee in the program — is it generic?
              for candidate in mir.functions do
                if candidate.name == callee_name then
                  if is_generic_function(candidate) then
                    let type_param_names = infer_type_param_names(candidate)
                    if !type_param_names.is_empty() then
                      # P0-AL (final): a SOLVED INSTANCE is the AUTHORITY.
                      # When the MirFnItem constant carries an instance with
                      # non-empty substs that are fully concrete (the type
                      # checker solved them), use inst.substs DIRECTLY as the
                      # type args — zero inference for this call — and take
                      # the mangled name from instance_key.
                      # P0-AL doc: solved instances are the authority; infer_type_args_for_call is the fallback only for unsolved shapes (solved substs still carrying Params from a still-generic caller are NOT usable yet: they defer exactly as the inferred-arg guard below defers Param-carrying args).
                      var solved_mangled: Option[String] = Option::None
                      var solved_args: Vec[Type] = Vec::new()
                      match cv.instance.clone()
                      when Option::Some(inst) then
                        if !inst.substs.is_empty() && !has_any_param_types(&inst.substs) then
                          solved_args = inst.substs.clone()
                          solved_mangled = Option::Some(instance_key(&inst))
                        end
                      when Option::None then ()
                      end
                      match solved_mangled
                      when Option::Some(mangled) then
                        worklist.push((callee_name.clone(), solved_args, mangled))
                      when Option::None then
                        # Infer concrete type args from the call site
                        # (infer_type_args_for_call is the documented
                        # FALLBACK for unsolved shapes)
                        let inference = infer_type_args_for_call(
                          candidate, &type_param_names, func, args, &dest
                        )
                        for err in inference.errors do
                          if !cache.errors.contains(&err) then
                            cache.errors.push(err)
                          end
                        end
                        let type_args = inference.type_args
                        # Skip entries where any inferred arg is itself a Param —
                        # those would create $any$any-mangled cycles when the
                        # caller is itself a specialization whose locals still
                        # carry Param types.  Only enqueue fully-concrete args.
                        if !has_any_param_types(&type_args) then
                          worklist.push((callee_name.clone(), type_args, mangle_name(callee_name.clone(), &type_args)))
                        end
                      end
                    end
                  end
                  break
                end
              end
            when _ then ()
            end
          when _ then ()
          end
        when _ then ()
        end
      end
    end

    # Phase 2: specialize each entry and add to program. The cache key is
    # the entry's mangled name — for solved-instance entries that IS the
    # instance's key (instance_key), so the cache key path uses the solved
    # args consistently: the same name the rewrite pass will emit.
    var new_funcs: Vec[MirFunction] = Vec::new()
    for (func_name, type_args, mangled) in worklist do
      # Check if already specialized (cache hit)
      if cache.specialized_bodies.contains_key(&mangled) then
        next
      end

      var found: Option[&MirFunction] = Option::None
      for f in mir.functions do
        if f.name == func_name then
          found = Option::Some(f)
          break
        end
      end

      match found
      when Option::Some(original) then
        let type_param_names = infer_type_param_names(original)
        if !type_param_names.is_empty() then
          let specialized = specialize_function_named(cache, original, &type_param_names, &type_args, mangled)
          new_funcs.push(specialized)
          changed = true
        end
      when Option::None then ()
      end
    end

    for f in new_funcs do
      mir.functions.push(f)
    end
    eprintln("[mono]   worklist=" + worklist.len().to_string() + " new_specs=" + new_funcs.len().to_string())

    # Phase 3: rewrite existing call sites to use mangled names
    if changed then
      rewrite_call_sites_in_program(mir, cache)
    end
  end

  # Report any inference failures recorded during monomorphization.
  report_mono_errors(cache)
end

def report_mono_errors(cache: &MonoCache) -> Unit
  if cache.errors.is_empty() then
    return
  end
  for err in cache.errors do
    eprintln("[mono] error: " + err)
  end
end

# ———————————————————————————————————————————————————————————————
# Public API: mono_specialize_function
# ———————————————————————————————————————————————————————————————
# Specialize a single generic function with concrete type arguments
# and add the result to the MIR program.  Returns the mangled name
# on success, or None if the function was not found.
pub def mono_specialize_function(
  cache: &mut MonoCache,
  mir: &mut MirProgram,
  func_name: String,
  type_args: Vec[Type]
) -> Option[String]
  # Find the generic function
  var found: Option[&MirFunction] = Option::None
  for f in mir.functions do
    if f.name == func_name then
      found = Option::Some(f)
      break
    end
  end

  match found
  when Option::None then
    return Option::None
  when Option::Some(original) then
    # If not generic, return the name as-is
    if !is_generic_function(original) then
      return Option::Some(func_name)
    end

    let type_param_names = infer_type_param_names(original)
    if type_param_names.is_empty() then
      return Option::Some(func_name)
    end

    # Specialize — specialize_function handles caching internally
    let mangled = mangle_name(func_name.clone(), &type_args)
    if !cache.specialized_bodies.contains_key(&mangled) then
      let specialized = specialize_function(cache, original, &type_param_names, &type_args)
      mir.functions.push(specialized)

      # Rewrite call sites in the entire program to catch any calls
      # that should now point to the mangled name
      rewrite_call_sites_in_program(mir, cache)
    end

    # Report any inference failures recorded during specialization.
    report_mono_errors(cache)

    Option::Some(mangled)
  end
end

# Public API: monomorphize_instance — the specialize path keyed by a
# semantic InstanceId instead of a name string. A caller that holds the
# call site's (def, substs) requests the instance directly; the body is
# produced through the SAME specialize_function path as the worklist
# monomorphizer, so cache identity and mangling stay single-sourced.
#
# NOTE (P0-AK layer): the MIR call lowering records the DefId with EMPTY
# substs — the typed program does not yet expose the checker's solved
# substitutions — so an instance requested directly in this layer must
# already carry concrete substitutions; empty substs are rejected with the
# documented inference note. The worklist monomorphizer
# (monomorphize_program) remains the authority that fills empty substs
# from each call site via infer_type_args_for_call.
# P0-AM (final): the base-name lookup below is the DefId rendering
# (fn_owner_key) — and MirFunction names ARE that same rendering for
# top-level functions (mir.tg's lower_program records mir_fn_emission_name
# from item_defs), so the seam is closed: the instance's base name and the
# lowered function's emission name agree byte-for-byte, and the
# `f.name == base` search below finds the definition. Methods stay
# name-based (the "Type__method" mangled identities), and the OS-entry
# function keeps its source name (the linking boundary).
pub def monomorphize_instance(
  cache: &mut MonoCache,
  mir: &mut MirProgram,
  instance: &InstanceId
) -> Result[Unit, String]
  let base = fn_owner_key(instance.def.module.clone(), instance.def.index, instance.def.kind)
  if instance.substs.is_empty() then
    return Result::Err("instance " + base + " has empty substitutions — the call-site inference pass (infer_type_args_for_call) fills them during monomorphize_program")
  end
  let mangled = mangle_name(base.clone(), &instance.substs)
  if cache.specialized_bodies.contains_key(&mangled) then
    return Result::Ok(())
  end
  var found: Option[&MirFunction] = Option::None
  for f in mir.functions do
    if f.name == base then
      found = Option::Some(f)
      break
    end
  end
  match found
  when Option::Some(original) then
    let type_param_names = infer_type_param_names(original)
    if type_param_names.is_empty() then
      return Result::Ok(())
    end
    let specialized = specialize_function_named(cache, original, &type_param_names, &instance.substs, mangled.clone())
    mir.functions.push(specialized)
    rewrite_call_sites_in_program(mir, cache)
    Result::Ok(())
  when Option::None then
    Result::Err("instance base `" + base + "` not found in the MIR program")
  end
end

def infer_type_param_names(func: &MirFunction) -> Vec[String]
  # Scan function locals/params for Param types and collect their names
  var names = Vec::new()
  var seen = Set::new()
  
  for param in func.params do
    collect_type_params(&param.ty, &mut names, &mut seen)
  end
  collect_type_params(&func.ret_type, &mut names, &mut seen)
  for local in func.locals do
    collect_type_params(&local.ty, &mut names, &mut seen)
  end
  names
end

def collect_type_params(ty: &Type, names: &mut Vec[String], seen: &mut Set[String]) -> Unit
  match ty
  when Type::Param(name) then
    if !seen.contains(&name) then
      seen.insert(name.clone())
      names.push(name.clone())
    end
  when Type::Option(inner) then collect_type_params(inner, names, seen)
  when Type::Result(ok, err) then
    collect_type_params(ok, names, seen)
    collect_type_params(err, names, seen)
  when Type::Map(k, v) then
    collect_type_params(k, names, seen)
    collect_type_params(v, names, seen)
  when Type::Set(inner) then collect_type_params(inner, names, seen)
  when Type::Slice(inner) then collect_type_params(inner, names, seen)
  when Type::Tuple(elems) then
    for e in elems do
      collect_type_params(&e, names, seen)
    end
  when Type::Function(params, ret) then
    for p in params do
      collect_type_params(&p.ty, names, seen)
    end
    collect_type_params(ret, names, seen)
  when Type::Named(_, args) then
    for a in args do
      collect_type_params(&a, names, seen)
    end
  when Type::RefInternal(inner, _) then collect_type_params(inner, names, seen)
  when Type::Ptr(inner) then collect_type_params(inner, names, seen)
  when Type::PtrMut(inner) then collect_type_params(inner, names, seen)
  when Type::Box(inner) then collect_type_params(inner, names, seen)
  when Type::Rc(inner) then collect_type_params(inner, names, seen)
  when Type::Effect(_, inner) then collect_type_params(inner, names, seen)
  when _ then ()
  end
end

# Generate mangled name for a monomorphized function
def mangle_name(base: String, type_args: &Vec[Type]) -> String
  var name = base + "$"
  var first = true
  for ty in type_args do
    if !first then
      name = name + "_"
    end
    name = name + type_to_mangled(ty)
    first = false
  end
  name
end

# ———————————————————————————————————————————————————————————————
# Tangerine ABI Symbol Mangling (extern "tangerine")
# ———————————————————————————————————————————————————————————————
# Format: _TG{edition}_{pkgHash}_{modulePathLen}:{modulePath}_{nameLen}:{name}_{sigHash}
#
# Components:
#   edition    — language edition (e.g., "2026")
#   pkgHash    — 64-bit hex of package identity (name + version + registry)
#   modulePath — module path (e.g., "std::collections")
#   name       — function/type name
#   sigHash    — 64-bit hex hash of monomorphized signature

pub const TANGERINE_ABI_EDITION: String = "2026"
pub const TANGERINE_ABI_REVISION: UInt = 1

# Full Tangerine ABI symbol mangling
pub def mangle_tangerine_symbol(
  pkg_name: String,
  pkg_version: String,
  module_path: String,
  name: String,
  signature: &Type
) -> String
  let pkg_hash = compute_pkg_hash(&pkg_name, &pkg_version)
  let sig_hash = compute_signature_hash(signature)
  
  let module_len = module_path.len()
  let name_len = name.len()
  
  "_TG" + TANGERINE_ABI_EDITION + "_" +
    hex_u64(pkg_hash) + "_" +
    module_len.to_string() + ":" + module_path + "_" +
    name_len.to_string() + ":" + name + "_" +
    hex_u64(sig_hash)
end

# Best-effort demangler for symbols emitted by mangle_tangerine_symbol.
# Returns a readable summary: module_path::name [edition=..., pkg=..., sig=...]
pub def demangle_tangerine_symbol(symbol: &String) -> Option[String]
  if !symbol.starts_with("_TG") then
    return Option::None
  end

  let parts = symbol.split("_")
  if parts.len() < 6 then
    return Option::None
  end

  let edition_part = parts[1]
  if !edition_part.starts_with("TG") then
    return Option::None
  end

  let edition = edition_part.slice(2, edition_part.len())
  let pkg_hash = parts[2]
  let module_field = parts[3]
  let name_field = parts[4]
  let sig_hash = parts[5]

  let module_parts = module_field.split(":")
  let name_parts = name_field.split(":")
  if module_parts.len() < 2 || name_parts.len() < 2 then
    return Option::None
  end

  let module_path = module_parts[1]
  let name = name_parts[1]

  Option::Some(module_path + "::" + name + " [edition=" + edition + ", pkg=" + pkg_hash + ", sig=" + sig_hash + "]")
end

# Compute package identity hash (name + version + registry)
def compute_pkg_hash(name: &String, version: &String) -> UInt
  var h: UInt = 0xcbf29ce484222325  # FNV-1a offset basis
  let name_bytes: Vec[Int] = name.bytes()
  for c in name_bytes do
    h = h ^ (c as UInt)
    h = h * 0x100000001b3  # FNV-1a prime
  end
  h = h ^ 0xff  # separator
  let version_bytes: Vec[Int] = version.bytes()
  for c in version_bytes do
    h = h ^ (c as UInt)
    h = h * 0x100000001b3
  end
  h
end

# Compute signature hash from type
def compute_signature_hash(ty: &Type) -> UInt
  var h: UInt = 0xcbf29ce484222325
  let repr = type_to_mangled(ty)
  let repr_bytes: Vec[Int] = repr.bytes()
  for c in repr_bytes do
    h = h ^ (c as UInt)
    h = h * 0x100000001b3
  end
  h
end

# Convert u64 to 16-char hex string
def hex_u64(val: UInt) -> String
  let chars = "0123456789abcdef"
  var result = ""
  var v = val
  var i = 0
  while i < 16 do
    let nibble = (v >> 60) & 0xf
    result = result + chars.char_at(nibble as UInt).to_string()
    v = v << 4
    i = i + 1
  end
  result
end

def type_to_mangled(ty: &Type) -> String
  match ty
  when Type::Unit then "unit"
  when Type::Bool then "bool"
  when Type::Int then "i64"
  when Type::UInt then "u64"
  when Type::Float then "f64"
  when Type::Char then "char"
  when Type::String then "str"
  when Type::Named(tid, _) then "t" + tid.id.to_string()
  when Type::Option(inner) then "opt_" + type_to_mangled(inner)
  when Type::Result(ok, err) then "res_" + type_to_mangled(ok) + "_" + type_to_mangled(err)
  when Type::Map(k, v) then "map_" + type_to_mangled(k) + "_" + type_to_mangled(v)
  when Type::Set(inner) then "set_" + type_to_mangled(inner)
  when _ then "any"
  end
end

def types_equal(a: &Vec[Type], b: &Vec[Type]) -> Bool
  if a.len() != b.len() then
    return false
  end
  var i = 0
  while i < a.len() do
    if !type_eq(&a[i], &b[i]) then
      return false
    end
    i = i + 1
  end
  true
end

def type_eq(a: &Type, b: &Type) -> Bool
  match a
  when Type::Unit then
    match b
    when Type::Unit then true
    when _ then false
    end
  when Type::Bool then
    match b
    when Type::Bool then true
    when _ then false
    end
  when Type::Int then
    match b
    when Type::Int then true
    when _ then false
    end
  when Type::UInt then
    match b
    when Type::UInt then true
    when _ then false
    end
  when Type::Float then
    match b
    when Type::Float then true
    when _ then false
    end
  when Type::Char then
    match b
    when Type::Char then true
    when _ then false
    end
  when Type::String then
    match b
    when Type::String then true
    when _ then false
    end
  when Type::Named(n1, args1) then
    match b
    when Type::Named(n2, args2) then
      n1 == n2 && types_equal(args1, args2)
    when _ then false
    end
  when Type::Option(t1) then
    match b
    when Type::Option(t2) then type_eq(t1, t2)
    when _ then false
    end
  when Type::Result(ok1, err1) then
    match b
    when Type::Result(ok2, err2) then
      type_eq(ok1, ok2) && type_eq(err1, err2)
    when _ then false
    end
  when Type::Map(k1, v1) then
    match b
    when Type::Map(k2, v2) then
      type_eq(k1, k2) && type_eq(v1, v2)
    when _ then false
    end
  when Type::Set(t1) then
    match b
    when Type::Set(t2) then type_eq(t1, t2)
    when _ then false
    end
  when _ then false
  end
end

# ———————————————————————————————————————————————————————————————
# Virtual Tables (vtables) for Dynamic Dispatch
# ———————————————————————————————————————————————————————————————
#
# Trait objects (`dyn Trait`) are fat pointers: (data_ptr, vtable_ptr).
# The vtable holds function pointers for each method of the trait.
#
# Layout of a vtable:
#   [0] drop_in_place function pointer (destructor)
#   [1] size of the concrete type
#   [2] alignment of the concrete type
#   [3..] one function pointer per trait method (in declaration order)

struct VTable
  trait_name: String
  concrete_type: Type
  entries: Vec[VTableEntry]
  drop_fn: String           # Mangled name of drop glue
  size: Int                 # Size of concrete type
  align: Int                # Alignment of concrete type
end

struct VTableEntry
  method_name: String
  fn_symbol: String         # Mangled function symbol to call
  signature: MethodSig
end

# MethodSig is imported from tg_compiler::types — uses fields:
# name, params, ret_type, is_method

struct VTableRegistry
  vtables: Map[String, VTable]    # trait_name + "$" + mangled_type -> VTable
end

def vtable_registry_new() -> VTableRegistry
  VTableRegistry { vtables: Map::new() }
end

# Generate a vtable for a concrete type implementing a trait
def generate_vtable(
  registry: &mut VTableRegistry,
  resolver: &TraitResolver,
  trait_name: String,
  concrete_type: &Type,
  trait_methods: &Vec[String],   # Method names in declaration order
  size: Int,
  align: Int
) -> String
  let key = vtable_key(&trait_name, concrete_type)
  
  # Check if already generated
  if registry.vtables.contains_key(&key) then
    return key
  end
  
  # Build vtable entries for each trait method
  var entries = Vec::new()
  for method_name in trait_methods do
    let mangled = mangle_name(method_name.clone(), &vec![concrete_type.clone()])
    
    # Try to find the concrete implementation
    let method_sig = match resolve_method(resolver, concrete_type, method_name.clone(), span_dummy())
    when Option::Some(candidate) then
      candidate.method_sig.clone()
    when Option::None then
      MethodSig { name: method_name.clone(), params: Vec::new(), ret_type: Type::Unit, is_method: true }
    end
    
    entries.push(VTableEntry {
      method_name: method_name.clone(),
      fn_symbol: mangled,
      signature: method_sig
    })
  end
  
  let drop_fn = mangle_name("drop".to_string(), &vec![concrete_type.clone()])
  
  let vtable = VTable {
    trait_name: trait_name.clone(),
    concrete_type: concrete_type.clone(),
    entries: entries,
    drop_fn: drop_fn,
    size: size,
    align: align
  }
  
  registry.vtables.insert(key.clone(), vtable)
  key
end

def vtable_key(trait_name: &String, concrete_type: &Type) -> String
  trait_name.clone() + "$" + type_to_mangled(concrete_type)
end

# Look up a specific method in a vtable — returns the slot index
def vtable_method_index(registry: &VTableRegistry, vtable_key: &String, method_name: &String) -> Option[Int]
  match registry.vtables.get(vtable_key)
  when Option::Some(vtable) then
    var idx = 0
    for entry in vtable.entries do
      if entry.method_name == method_name then
        return Option::Some(idx + 3)  # +3 for drop/size/align header
      end
      idx = idx + 1
    end
    Option::None
  when Option::None then Option::None
  end
end

# Generate a vtable as a static data symbol (for codegen)
def vtable_to_static_data(vtable: &VTable) -> Vec[String]
  # Returns a list of symbol names in vtable order:
  #   [0] drop function
  #   [1] size (as integer literal)
  #   [2] align (as integer literal)
  #   [3..] method function pointers
  var symbols = Vec::new()
  symbols.push(vtable.drop_fn.clone())
  symbols.push("__size_" + vtable.size.to_string())
  symbols.push("__align_" + vtable.align.to_string())
  for entry in vtable.entries do
    symbols.push(entry.fn_symbol.clone())
  end
  symbols
end

# Dynamic dispatch: generate code to call through vtable
# Returns the vtable slot index for a trait method call
def dyn_dispatch_slot(
  registry: &VTableRegistry,
  trait_name: &String,
  method_name: &String,
  concrete_type: &Type
) -> Option[Int]
  let key = vtable_key(trait_name, concrete_type)
  match vtable_method_index(registry, &key, method_name)
  when Option::Some(slot) then Option::Some(slot)
  when Option::None then Option::None
  end
end

# Check if a type is a trait object (dyn Trait)
def is_trait_object(ty: &Type) -> Bool
  match ty
  when Type::Dyn(_) then true
  when _ then false
  end
end

# Extract the trait name from a dyn trait type
def trait_object_trait_name(ty: &Type) -> Option[String]
  match ty
  when Type::Dyn(tid) then
    Option::Some("<type_" + tid.id.to_string() + ">")
  when _ then Option::None
  end
end

# Collect all types that implement a specific trait (for vtable generation)
def implementors_of(resolver: &TraitResolver, trait_name: &String) -> Vec[Type]
  var types = Vec::new()
  for entry in resolver.impls do
    if entry.trait_name == trait_name then
      types.push(entry.for_type.clone())
    end
  end
  types
end

# Generate all vtables for a given trait across all known implementors
def generate_all_vtables(
  registry: &mut VTableRegistry,
  resolver: &TraitResolver,
  trait_name: String,
  trait_methods: &Vec[String]
) -> Vec[String]
  let impls = implementors_of(resolver, &trait_name)
  var keys = Vec::new()
  for impl_type in impls do
    # Compute size/align based on type.
    # Primitive types have known sizes; compound types use pointer-width (8).
    let (size, align) = compute_type_size_align(&impl_type)
    let key = generate_vtable(registry, resolver, trait_name.clone(), &impl_type, trait_methods, size, align)
    keys.push(key)
  end
  keys
end

# Compute the size and alignment of a type for vtable metadata.
def compute_type_size_align(ty: &Type) -> (Int, Int)
  match ty
  when Type::Int then (8, 8)
  when Type::UInt then (8, 8)
  when Type::Float then (8, 8)
  when Type::Bool then (1, 1)
  when Type::Char then (4, 4)
  when Type::Unit then (0, 1)
  when Type::Never then (0, 1)
  when Type::Named(_, _) then
    (8, 8)
  when Type::Function(_, _) then (8, 8)
  when Type::Tuple(elems) then
    let size = elems.len() * 8
    (size, 8)
  when Type::Array(_, n) then (n * 8, 8)
  when Type::Slice(_) then (16, 8)   # ptr + len
  when _ then (8, 8)
  end
end
