# Tangerine trait resolution — FACADE over the ONE canonical trait solver.
#
# The single trait solver lives in types.tg (solve_obligation over
# env.impls — the impl registry populated by check_impl /
# register_builtin_trait). This module is its facade: the trait queries the
# compiler surface consumes delegate to that solver, and the monomorphizer
# (moved to tg_compiler::mono) is re-exported here for the existing
# importers (mir.tg, lib.tg, lib_kernel.tg, driver.tg).
#
# The former SECOND trait engine has been deleted: the duplicate
# candidate-ranking (best_candidate / candidate_rank / type_concreteness),
# the duplicate type matching (type_matches), the duplicate coherence /
# orphan-rule checking (check_coherence / check_orphan_rules and their
# local/covered helpers), the AST-side impl collection
# (collect_impls / ast_type_to_type / TraitResolver / ImplEntry /
# Candidate), and the vtable machinery (VTable / generate_vtable /
# implementors_of-style registry helpers — retained only as the
# solver-delegating queries below) are all gone. Impl applicability and
# trait bounds are decided in exactly one place: types.tg's obligation
# solver.

use std::collections::{Vec}
use tg_compiler::types::{Type, TypeEnv, Obligation, TraitRef, solve_obligation, trait_id_for}

# ———————————————————————————————————————————————————————————————
# Monomorphization (moved to tg_compiler::mono) — re-exports
# ———————————————————————————————————————————————————————————————
# The ENTIRE monomorphizer lives in mono.tg (the mono cache, the instance
# work queue, the exhaustive specialization, the symbol mangling). The
# importers of this module's historical mono surface (mir.tg imports
# InstanceId / instance_key / monomorphize_instance; lib.tg and
# lib_kernel.tg re-export monomorphize_program / mono_cache_new /
# mono_specialize_function; driver.tg imports monomorphize_program /
# mono_cache_new) keep working through these re-exports.

pub use tg_compiler::mono::{
  InstanceId, instance_key,
  MonoCache, mono_cache_new,
  monomorphize_program, mono_specialize_function, monomorphize_instance
}

# ———————————————————————————————————————————————————————————————
# Trait Queries — facade over types.tg's obligation solver
# ———————————————————————————————————————————————————————————————
# Every query below delegates to the canonical solver; none of them
# re-implements matching or coherence.

# Whether `ty` satisfies the trait bound `trait_name` — delegated to the
# canonical obligation solver (types.tg::solve_obligation), the SAME solver
# method lookup, the where-clause gates and the builtin-trait checks use.
# The trait name is resolved to its TraitId through the module-qualified
# declaration identity (types.tg::trait_id_for — the resolver's
# DefKind::Trait declaration table mirrored into the checker's
# module-qualified map), so the Obligation's trait_id is the
# declaration-derived TraitId end-to-end. The obligation carries the full
# TraitRef (trait_id, self_ty, args) — the canonical solver key and the
# candidate matching operate on the TraitRef; the bare-name facade passes
# no trait arguments (an args-less obligation imposes no argument
# constraint on the candidates).
def satisfies_trait(env: &mut TypeEnv, ty: &Type, trait_name: String) -> Bool
  let obligation = Obligation {
    trait_ref: TraitRef {
      trait_id: trait_id_for(env, &trait_name),
      self_ty: ty.clone(),
      args: Vec::new()
    },
    trait_name: trait_name
  }
  solve_obligation(env, &obligation)
end

# Check whether a type satisfies all trait bounds in a where clause.
# Returns the failed bounds as error strings; each bound is solved by the
# canonical obligation solver.
def check_where_bounds(env: &mut TypeEnv, ty: &Type, bounds: &Vec[String]) -> Vec[String]
  var errors = Vec::new()
  for bound in bounds do
    if !satisfies_trait(env, ty, bound.clone()) then
      errors.push("type does not satisfy trait bound '" + bound + "'")
    end
  end
  errors
end

# Collect the concrete self types of every registered impl of `trait_name`
# — read from the canonical impl registry (env.impls), the same registry
# the obligation solver and method lookup consult. The impls are matched
# by the DECLARATION-DERIVED TraitId (trait_id_for — the name's
# module-qualified declaration identity), never by the trait name string
# (the name survives only as diagnostics on the ImplInfo).
def implementors_of(env: &TypeEnv, trait_name: &String) -> Vec[Type]
  var types = Vec::new()
  let target_id = trait_id_for(env, trait_name)
  for imp in env.impls do
    if imp.trait_id.id == target_id.id then
      types.push(imp.for_type.clone())
    end
  end
  types
end
