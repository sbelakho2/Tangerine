# provprobe.tg — focused in-VM runner for the P0-7 provenance work.
#
# Runs, over the REAL kernel modules:
#   1. mir.tg's origin-identity lane, the new lowered-insertion lane and
#      semantic_slice.tg's provenance-derivation lane (the mismatch rows),
#   2. a real parse -> resolve -> typecheck -> lower_to_mir -> optimize
#      smoke on a source snippet, asserting the strict origin/provenance
#      invariants at the lowering and post-optimization boundaries.
#
# Built through bootstrap/prov_mini.manifest by the OCaml seed:
#   tg_stage0.exe compile --repo-root . --manifest bootstrap/prov_mini.manifest \
#     --target aarch64-apple-darwin
#
# The identity lane's pre-existing PGO/tail rows are printed as
# IDENTITY_ROW diagnostics: the Seed VM's Int_value.to_string renders
# 64-bit UInt digest words SIGNED, so a digest word with the high bit set
# serializes as "-N" and the lane's own key parser rejects the round-trip.
# That is a seed-VM rendering artifact in unchanged code, not a provenance
# failure; the acceptance rows for THIS task are the INSERTION_FAIL /
# SLICE_FAIL / LOWER_SMOKE FAIL lines (absent on success).
use std::core::{Option, Result}
use std::collections::Vec
use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::ast::{assign_node_ids}
use tg_compiler::resolver::{resolve_names}
use tg_compiler::types::{type_env_new, type_check_typed}
use tg_compiler::mir::{
  lower_to_mir, optimize_mir, mir_origins_check, verify_mir_provenance,
  mir_origin_identity_lane_check, mir_origin_insertion_lane_check,
  mir_origin_insertion_lane_function, mir_origin_insertion_lane_key,
  mir_origin_insertion_lane_provenance_text
}
use tg_compiler::semantic_slice::{mir_slice_provenance_lane_check}

def provprobe_lower_smoke() -> Int
  let src = "def add(a: Int, b: Int) -> Int\n  let c = a + b\n  c\nend\n"
  let parsed = parse(tokenize(src, "prov_lower_smoke.tg"))
  if diag_has_errors(&parsed.diagnostics) then
    println("LOWER_SMOKE_FAIL parse")
    return 2
  end
  var program = parsed.program
  assign_node_ids(&mut program)
  match resolve_names(program)
  when Result::Ok(res) then
    var env = type_env_new()
    env.strict_resolution = true
    let result = type_check_typed(&mut env, &program, &res)
    if result.errors.len() > 0 then
      println("LOWER_SMOKE_FAIL typecheck errors=" + result.errors.len().to_string())
      var ei = 0
      while ei < result.errors.len() do
        println("  " + result.errors[ei].message.clone())
        ei = ei + 1
      end
      return 1
    end
    match lower_to_mir(program, result.program)
    when Result::Ok(mir) then
      match mir_origins_check(mir.clone(), "provprobe".to_string())
      when Result::Ok(()) then ()
      when Result::Err(e) then
        println("LOWER_SMOKE_FAIL origins check: " + e)
        return 1
      end
      let perrors = verify_mir_provenance(mir.clone())
      if perrors.len() > 0 then
        println("LOWER_SMOKE_FAIL lowering provenance rows=" + perrors.len().to_string())
        return 1
      end
      var p = mir.clone()
      optimize_mir(&mut p, 2, Option::None)
      let oerrors = verify_mir_provenance(p.clone())
      if oerrors.len() > 0 then
        println("LOWER_SMOKE_FAIL post-opt provenance rows=" + oerrors.len().to_string())
        return 1
      end
      println("LOWER_SMOKE_PASS lowered_functions=" + mir.functions.len().to_string())
      0
    when Result::Err(e) then
      println("LOWER_SMOKE_FAIL lower: " + e)
      1
    end
  when Result::Err(errs) then
    println("LOWER_SMOKE_FAIL resolve=" + errs.len().to_string())
    3
  end
end

def main() -> Int
  let id_rows = mir_origin_identity_lane_check()
  let ins_rows = mir_origin_insertion_lane_check()
  let sl_rows = mir_slice_provenance_lane_check()
  for r in id_rows do println("IDENTITY_ROW " + r) end
  for r in ins_rows do println("INSERTION_FAIL " + r) end
  for r in sl_rows do println("SLICE_FAIL " + r) end
  let anchor_fn = mir_origin_insertion_lane_function()
  println("PROV_ANCHOR key=" + mir_origin_insertion_lane_key(anchor_fn.clone()))
  println("PROV_ANCHOR provenance=" + mir_origin_insertion_lane_provenance_text(anchor_fn))
  let smoke = provprobe_lower_smoke()
  if ins_rows.len() == 0 && sl_rows.len() == 0 && smoke == 0 then
    println("PROV_LANE_PASS insertion=0 slice=0 smoke=0 identity_rows=" + id_rows.len().to_string())
    return 0
  end
  println("PROV_LANE_FAIL insertion=" + ins_rows.len().to_string() + " slice=" + sl_rows.len().to_string() + " smoke=" + smoke.to_string())
  1
end
