end

def semantic_contract_reference_edge_lt(a: ContractReferenceEdge, b: ContractReferenceEdge) -> Bool
  if a.contract_id != b.contract_id then
    a.contract_id < b.contract_id
  else
    a.referenced_symbol < b.referenced_symbol
  end
end

def semantic_contract_reference_edges_sort(inout edges: Vec[ContractReferenceEdge]) -> Unit
  var i = 1
  while i < edges.len() do
    let current = edges[i].clone()
    var j = i
    while j > 0 && semantic_contract_reference_edge_lt(&edges[j - 1], &current) do
      edges[j] = edges[j - 1].clone()
      j = j - 1
    end
    edges[j] = current
    i = i + 1
  end
end

def semantic_abi_dependency_edge_lt(a: AbiDependencyEdge, b: AbiDependencyEdge) -> Bool
  if a.surface_id != b.surface_id then
    a.surface_id < b.surface_id
  else
    a.type_key < b.type_key
  end
end

def semantic_abi_dependency_edges_sort(inout edges: Vec[AbiDependencyEdge]) -> Unit
  var i = 1
  while i < edges.len() do
    let current = edges[i].clone()
    var j = i
    while j > 0 && semantic_abi_dependency_edge_lt(&edges[j - 1], &current) do
      edges[j] = edges[j - 1].clone()
      j = j - 1
    end
    edges[j] = current
    i = i + 1
  end
end

# Sort every family of the dependency graph in place (the ONE graph sort
# the writer/finalizer runs before any rendering or hashing).
def semantic_dependency_graph_sort(inout graph: SemanticDependencyGraph) -> Unit
  semantic_type_use_edges_sort(&mut graph.type_uses)
  semantic_trait_impl_edges_sort(&mut graph.trait_impls)
  semantic_trait_selection_edges_sort(&mut graph.trait_selections)
  semantic_generic_instantiation_edges_sort(&mut graph.generic_instantiations)
  semantic_layout_dependency_edges_sort(&mut graph.layout_dependencies)
  semantic_const_eval_dependency_edges_sort(&mut graph.const_eval_dependencies)
  semantic_derived_body_edges_sort(&mut graph.derived_bodies)
  semantic_contract_reference_edges_sort(&mut graph.contract_references)
  semantic_abi_dependency_edges_sort(&mut graph.abi_dependencies)
end

# ———————————————————————————————————————————————————————————————
# Serialization helpers (the writer's text-form primitives)
# ———————————————————————————————————————————————————————————————
# The snapshot's canonical text form is line-oriented JSON records (the
# coverage.tg tgcov JSONL precedent — the compiler's real artifact format).
# These helpers are the data-structure-side primitives ONLY: the writer
# slice composes the rows, sorts every table through the functions above and
# hashes the render with ids.tg's stable_digest_of. Escaped field text
# round-trips through the same escaping on read.

# The canonical text of a digest: "hi-lo" (the decimal UInt words, '-'
# joined). Deterministic on every platform; two digests render
# byte-identically iff their words are equal. (The writer emits every hash
# field in this form.)
def semantic_digest_render(d: StableDigest) -> String
  d.hi.to_string() + "-" + d.lo.to_string()
end

# JSON field-text escaping — byte-for-byte the coverage.tg json_escape
# shape (the compiler's artifact serializer; duplicated here so this
# data-only module never imports the tooling modules that build on it).
def semantic_json_escape(s: String) -> String
  var result = String::new()
  for c in s.chars() do
    match c
    when '"' then result.push_str("\\\"")
    when '\\' then result.push_str("\\\\")
    when '\n' then result.push_str("\\n")
    when '\r' then result.push_str("\\r")
    when '\t' then result.push_str("\\t")
    when c then result.push(c)
    end
  end
  result
end
