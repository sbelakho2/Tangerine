    end
    edges[j] = current
    i = i + 1
  end
end

def semantic_derived_body_edge_lt(a: DerivedBodyEdge, b: DerivedBodyEdge) -> Bool
  if a.derived_key != b.derived_key then
    a.derived_key < b.derived_key
  else
    a.source_type < b.source_type
  end
end

def semantic_derived_body_edges_sort(inout edges: Vec[DerivedBodyEdge]) -> Unit
