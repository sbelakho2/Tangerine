    edges[j] = current
    i = i + 1
  end
end

def semantic_const_eval_dependency_edge_lt(a: ConstEvalDependencyEdge, b: ConstEvalDependencyEdge) -> Bool
  if a.dependent != b.dependent then
    a.dependent < b.dependent
  else
    a.referenced_const < b.referenced_const
  end
end

def semantic_const_eval_dependency_edges_sort(inout edges: Vec[ConstEvalDependencyEdge]) -> Unit
  var i = 1
  while i < edges.len() do
