# Tangerine Compiler — Semantic Model (Snapshot / Delta Protocol Data)
# Self-hosting compiler written in Tangerine
#
# (audit §29 + §45) ARCHITECTURE CONTRACT — the snapshot/delta semantic
# protocol:
#   - SOURCE IS ONE VIEW: the snapshot is the compiler's semantic MODEL of a
#     compilation, not a rendering of its text. The same semantics may be
#     produced from differently-arranged source text (harmless textual
#     movement — reformatting, comment edits, statement reordering within a
#     block — must not change the semantic entities the snapshot records).
#   - SPANS ARE METADATA, NEVER IDENTITY: every record's provenance is an
#     Option[Span] carried for navigation/diagnostics only. No span, file
#     offset or source-order ordinal participates in any identity or in any
#     deterministic ordering below.
#   - SEMANTIC ENTITIES SURVIVE: identity rides the compiler's existing
#     stable-ID infrastructure (ids.tg — the initial stable-ID machinery:
#     StableDigest, StableDefId and stable_def_id_digested), whose identity
#     is the 128-bit digest of a canonical content key, never an ephemeral
#     per-compilation id and never a name/position.
#
# SCOPE (this slice): DATA STRUCTURES ONLY — records, enums, ids and the
# deterministic-ordering/serialization helpers the snapshot writer (a later
# slice) composes. NO analysis passes live here: nothing in this module
# walks the AST, the typed program or the MIR; every producer is a later
# analysis slice that fills these records.
#
# §29 ADAPTATIONS TO WHAT EXISTS (the audit's Digest/TargetId/... mapped onto
# the compiler's real primitives, never invented look-alikes):
#   - Digest (revision / public_api_hash / abi_hash / unsafe_hash) is ids.tg's
#     StableDigest — the 128-bit stable digest (hi/lo UInt words) the
#     stable-ID model already digests canonical keys with.
#   - TargetId is a strong newtype over the canonical target TRIPLE STRING
#     (the codebase's only target identity is TargetDesc.name / the
#     detect_host_target triple; no central TargetId domain exists yet — this
#     record seeds that domain, name-only until a digest domain is wired).
#     The SNAPSHOT header's target field carries StableTargetId instead —
#     the digest-bearing full identity (triple/arch/cpu/width/endian/abi/
#     float_abi/features/widths + the digest of the complete TargetDesc
#     record) built by semantic_snapshot.tg's stable_target_id_of (audit
#     item 9). TargetId itself stays for the asm-level AsmTarget consumers.
#   - symbols/types/callables reference the resolver's StableDefId records
#     (canonical key + digest words + registered low-word id) — the existing
#     stable identity for definitions.
#   - effect facts reuse the §11 EffectSummary record (types.tg) VERBATIM —
#     its may_allocate / may_block / may_io / may_spawn / may_sleep /
#     may_panic / may_unsafe flags and Set[CapabilityId] capabilities — and
#     the CapabilityId domain it carries.
#   - ownership conventions reuse ast.tg's AccessConvention (Let / Inout /
#     Sink / Set — the ONE access-convention vocabulary the semantic AST
#     already uses); contract kinds reuse AstContractKind (AstPre / AstPost /
#     AstInvariant); symbol kinds reuse DefKind (ids.tg).
#   - domains the compiler has no id for (call edges, per-place ownership
#     facts, branch points) order by the stable digest of their canonical
#     CONTENT KEY (documented per record); the key text is stored where the
#     domain is textual (place_key, branch_id) so collisions stay detectable.
#
# DETERMINISTIC ORDERING: every table below has a comparator + in-place sort
# (cqs.tg sort_signals style) keyed on the stable digest (hi word, then lo
# word) with canonical keys / semantic discriminants as total-order
# tiebreaks. The snapshot writer MUST emit every Vec through its sort before
# hashing, so byte-identical snapshots imply byte-identical tables.

use std::core::{Option}
use std::collections::{Vec, Map}
use tg_compiler::ids::{StableDigest, StableDefId, DefKind}
use tg_compiler::stable_ids::{StableContractId, StableUnsafeSiteId}
use tg_compiler::ast::{AccessConvention, AstContractKind}
use tg_compiler::token::{Span}
use tg_compiler::types::{EffectSummary, CapabilityId}

# ———————————————————————————————————————————————————————————————
# Target identity
# ———————————————————————————————————————————————————————————————
# The target of the compilation the snapshot models. Strong newtype over the
# canonical target triple/name — the ONLY target identity the codebase has
# today (TargetDesc.name in target_desc.tg; the detect_host_target triple
# strings). The snapshot's hash fields (abi_hash in particular) are
# target-dependent, so the target rides the snapshot header. This newtype
# is retained for the pre-desc consumers (the asm-level AsmTarget renders);
# the SNAPSHOT record carries the full StableTargetId below.
struct TargetId
  name: String   # canonical target triple / TargetDesc.name ("aarch64-apple-darwin", "cortex-m4f", ...)
end

# The FULL target identity of a snapshot (audit item 9): the digest-bearing
# record the SemanticSnapshot header carries instead of the name-only
# TargetId. Built by semantic_snapshot.tg's stable_target_id_of from the
# REAL TargetDesc record of the compilation (target_desc.tg — every field
# below is a canonical render of desc data, never a guess). M4 vs M4F
# snapshots differ: the cpu / float_abi fields and the digest words are
# pure functions of the desc, so two descs that differ in ANY field produce
# different digests.
#   triple            — TargetDesc.name (the canonical instance name).
#   arch / cpu        — the canonical target_desc Arch / Cpu words.
#   pointer_width     — TargetDesc.pointer_width (bytes per pointer).
#   endian            — "little" | "big" (TargetDesc.endianness).
#   abi               — the integer-model word: pointer_width 8 -> "lp64",
#                        pointer_width 4 -> "ilp32" (target_desc.tg's
#                        documented integer-ABI rule: the integer word IS
#                        the pointer width on every canonical instance).
#   float_abi         — "soft" | "softfp" | "hard" (TargetDesc.float_abi).
#   isa_features      — the desc's extension tokens, canonicalized (sorted).
#   native_atomic_widths — the desc's native atomic widths, sorted.
#   digest_hi / lo    — the 128-bit stable digest of the COMPLETE desc
#                        record rendered canonically (every TargetDesc field
#                        participates — stack alignment, isa, fpu, register
#                        classes, memory spaces, ... — so any desc change
#                        moves the digest).
struct StableTargetId
  triple: String
  arch: String
  cpu: String
  pointer_width: Int
  endian: String
  abi: String
  float_abi: String
  isa_features: Vec[String]
  native_atomic_widths: Vec[Int]
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

# The target-identity clone: every identity text and feature vector
# duplicates; the widths/digest words are immediates. Registered because
# SemanticSnapshot.target is a component of the snapshot clones.
impl Clone for StableTargetId
  def clone(self: Self) -> StableTargetId
    StableTargetId {
      triple: self.triple.clone(),
      arch: self.arch.clone(),
      cpu: self.cpu.clone(),
      pointer_width: self.pointer_width,
      endian: self.endian.clone(),
      abi: self.abi.clone(),
      float_abi: self.float_abi.clone(),
      isa_features: self.isa_features.clone(),
      native_atomic_widths: self.native_atomic_widths.clone(),
      digest_hi: self.digest_hi,
      digest_lo: self.digest_lo
    }
  end
end

# ———————————————————————————————————————————————————————————————
# SnapshotHeader — the compilation's identity/environment carrier
# (fourth-audit P1-5a)
# ———————————————————————————————————————————————————————————————
# The snapshot's HEADER payload: what produced this artifact and under
# which semantically relevant settings. The record is a projection of the
# SemanticSnapshot fields below (semantic_snapshot_header) — the writer
# renders it into the snapshot header row and the parser rebuilds it from
# that row, so the header JOINS THE DIGEST PREIMAGE (two builds differing
# in feature_set / semantic_options produce different revisions).
#
#   compiler_version — the producing compiler's version.tg VERSION text.
#   target           — the StableTargetId record (the digest-bearing full
#                      target identity; TargetId above stays for asm-level
#                      consumers).
#   feature_set      — the SEMANTICALLY RELEVANT compiler features in
#                      effect, canonical words sorted: the enable_* flags
#                      (contracts / capabilities / effects / budgets, as
#                      "<word>" when enabled and "no-<word>" when
#                      disabled), strict-resolution, coverage,
#                      verify-everything, and one "target-feature:<f>" row
#                      per TargetDesc.isa_features entry (sorted). Two
#                      builds differing in a feature here produce different
#                      revisions by construction.
#   semantic_options — the semantically relevant CompilerOptions values in
#                      effect, canonical "name:value" words sorted:
#                      opt-level / codegen route / emit mode / mode word /
#                      stop-after / pgo-use / the target triple. Cosmetic
#                      options (color, verbosity, warning flags, JSON
#                      diagnostics, output paths, check-only) never ride
#                      the header.
struct SnapshotHeader
  compiler_version: String
  target: StableTargetId
  feature_set: Vec[String] = Vec::new()
  semantic_options: Vec[String] = Vec::new()
end

# The canonical identity text of the header's feature/option carrier —
# "features=<comma-joined>;options=<comma-joined>" — the digest preimage
# component the per-domain features digest hashes.
def semantic_snapshot_header_features_text(h: SnapshotHeader) -> String
  "features=" + h.feature_set.join(",") + ";options=" + h.semantic_options.join(",")
end

# ———————————————————————————————————————————————————————————————
# SemanticDomainDigests — the per-table content digests (P1-5c)
# ———————————————————————————————————————————————————————————————
# The snapshot's per-DOMAIN digest record: one 128-bit stable digest per
# semantically independent table family, persisted in the snapshot header.
# public_api / abi / unsafe_ mirror the three surface hashes (their
# authoritative computed values; kept here so one header record carries
# the whole digest set); concrete_types / drop_plans / allocation_sites /
# features digest each new table's canonical sorted row text (the
# features digest covers feature_set + semantic_options). The writer's
# finalizer recomputes the record before the revision digest, so a table
# edit moves both its domain digest and the revision.
struct SemanticDomainDigests
  public_api: StableDigest = semantic_digest_zero()
  abi: StableDigest = semantic_digest_zero()
  unsafe_: StableDigest = semantic_digest_zero()
  concrete_types: StableDigest = semantic_digest_zero()
  drop_plans: StableDigest = semantic_digest_zero()
  allocation_sites: StableDigest = semantic_digest_zero()
  features: StableDigest = semantic_digest_zero()
end

# ———————————————————————————————————————————————————————————————
# SemanticSnapshot — the §29 top-level protocol record
# ———————————————————————————————————————————————————————————————
# One snapshot models one compilation's semantics: the per-definition
# symbols/types, the cross-entity relationship tables (calls, effects,
# capabilities, ownership, contracts, tests, coverage), the per-function
# MIR-level semantic summaries, and the three surface hashes the delta
# architecture compares across compilations. Field order is the protocol's
# canonical record order (the writer's text form emits fields in this order).
#
#   revision        — digest of this snapshot's canonical serialized text
#                     (computed by the writer slice after the tables are
#                     sorted and rendered; zero until then).
#   compiler_version — the producing compiler's version.tg VERSION text.
#   target          — the compilation target (the StableTargetId record —
#                     the digest-bearing full target identity; TargetId
#                     above stays for the asm-level consumers).
#   feature_set / semantic_options — the P1-5 header payload (see
#                     SnapshotHeader): the semantically relevant features
#                     and options in effect; both ride the header row and
#                     the digest preimage.
#   fields / variants / callable_signatures / trait_methods — the P1-3
#                     TYPED table family (see the records below): the
#                     declared struct fields, enum variants (with payload
#                     shapes), function/method signatures (typed params +
#                     conventions + return + declared effects) and trait
#                     methods, emitted from TYPED finalized state — never
#                     parsed back out of a canonical key render. The
#                     evolution planners consume these tables by typed
#                     membership.
#   concrete_types  — the P1-5b concrete type-instance table: one row per
#                     concrete Type::Adt(tid, args) instance the canonical
#                     instance sources reach, with the template declaration,
#                     canonical args and layout summary.
#   allocation_sites — the P1-5c allocation-site table: one row per
#                     allocating MIR statement/terminator with its §33 node
#                     site key and the budget classification's size kind.
#   domain_digests  — the per-domain digest record (P1-5c; see
#                     SemanticDomainDigests), persisted in the header row.
#   symbols         — declared definitions (the DefKind vocabulary).
#   types           — nominal type declarations (struct/enum/trait).
#   calls           — caller -> callee call edges.
#   indirect_calls  — explicit rows for the calls whose callee is NOT
#                     statically known (audit item 13 — see IndirectCallEdge;
#                     the row replaces a silent omission: every indirect
#                     site is recorded, completeness "Unknown" unless
#                     points-to info is available).
#   effects         — per-function/operation effect facts (the §11 record).
#   capabilities    — function -> capability edges (the CapabilityId domain).
#   ownership       — per-place ownership facts inside a function body.
#   contracts       — per-function pre/post/invariant clause facts.
#   tests           — test-function -> exercised-function relationships.
#   coverage        — function -> branch/arm-point coverage relationships.
#   mir_functions   — per-function semantic summaries of the lowered MIR.
#   unsafe_facts    — the unsafe-surface fact rows (item 16): one row per
#                     unsafe marker the snapshot builder records (unsafe-fn
#                     / extern-call / transmute / unknown-call markers on
#                     def-keyed lowerings — see semantic_snapshot.tg), each
#                     with its function key, UnsafeKind word, site key and
#                     the 128-bit digest words of its canonical fact text.
#   abi_surfaces    — the PERSISTED canonical ABI/layout rows (item 18;
#                     third-audit items 42/43): one AbiSurfaceRow per pub
#                     def-keyed function OR pub extern declaration (the
#                     ABI classification of the signature plus the typed
#                     FFI-surface mirror — conventions, ownership,
#                     nullability, variadic, failure/thread/taint words
#                     and the enum-crossing boundary) and per declared
#                     type (layout size/alignment/field offsets), keyed by
#                     a stable surface id. The table is the EXPLANATORY
#                     payload behind abi_hash: abi_hash is the §30
#                     CanonExternal text digest (unchanged), while
#                     abi_surfaces lets abi.diff report the exact changed
#                     size/offset/class/convention per surface instead of
#                     a hash mismatch alone. Classification failures are
#                     persisted as "abi-fail-closed" rows carrying the
#                     reason (the snapshot_abi_text marker convention),
#                     never fabricated values.
#   dependencies    — the PERSISTED typed dependency graph (third-audit
#                     item 18): the per-family edge rows (TypeUse /
#                     TraitImpl / TraitSelection / GenericInstantiation /
#                     LayoutDependency / ConstEvalDependency / DerivedBody /
#                     ContractReference / AbiDependency — the records
#                     below) the builder emits from TYPED finalized state
#                     and the extended affected closure walks. Defaulted
#                     empty (a compilation with no rows for a family stays
#                     representable); the writer sorts every family and
#                     emits the rows into the digest preimage. The graph
#                     ALSO carries dependency_completeness — the
#                     per-family producer-status table (fourth-audit
#                     P0-9): one entry per RELATION FAMILY naming whether
#                     the producer's data source covered the family
#                     ("complete" = rows-or-known-empty, "partial" =
#                     documented residual gaps, "unavailable" = the data
#                     source was not reachable); the closure NEVER
#                     substitutes call edges for an unavailable family.
#   public_api_hash — digest of the public-API surface (writer-computed).
#   abi_hash        — digest of the public ABI surface (writer-computed).
#   unsafe_hash     — digest of the unsafe surface (writer-computed).
#
# The three hash fields are the DELTA KEYS of §29: two snapshots whose
# public_api_hash / abi_hash / unsafe_hash agree are API/ABI/safety-surface
# compatible by construction (the hashes digest canonical semantic text ONLY
# — never spans, never ephemeral ids, never raw source text).
struct SemanticSnapshot
  revision: StableDigest
  compiler_version: String
  target: StableTargetId
  # (fourth-audit P1-5a) The semantically relevant compiler features and
  # options in effect (the SnapshotHeader carrier): sorted canonical words,
  # rendered into the header row and digested with it (two builds differing
  # in a feature produce different revisions).
  feature_set: Vec[String] = Vec::new()
  semantic_options: Vec[String] = Vec::new()
  symbols: Vec[SemanticSymbol] = Vec::new()
  types: Vec[SemanticType] = Vec::new()
  calls: Vec[CallEdge] = Vec::new()
  indirect_calls: Vec[IndirectCallEdge] = Vec::new()
  effects: Vec[EffectEdge] = Vec::new()
  capabilities: Vec[CapabilityEdge] = Vec::new()
  ownership: Vec[OwnershipFact] = Vec::new()
  contracts: Vec[ContractFact] = Vec::new()
  tests: Vec[TestRelationship] = Vec::new()
  coverage: Vec[CoverageRelationship] = Vec::new()
  mir_functions: Vec[MirSemanticSummary] = Vec::new()
  unsafe_facts: Vec[UnsafeFact] = Vec::new()
  abi_surfaces: Vec[AbiSurfaceRow] = Vec::new()
  # (fourth-audit P1-3) The TYPED member/signature tables: declared struct
  # fields, enum variants (with payload shapes), callable signatures
  # (typed params + conventions + return + declared effects) and trait
  # methods. Populated at snapshot build from TYPED finalized state; the
  # evolution planners consume them by typed membership — no
  # struct{...}/enum{...}/signature render is parsed.
  fields: Vec[SemanticField] = Vec::new()
  variants: Vec[SemanticVariant] = Vec::new()
  callable_signatures: Vec[SemanticCallableSignature] = Vec::new()
  trait_methods: Vec[SemanticTraitMethod] = Vec::new()
  # (fourth-audit P1-5b) One row per concrete type instance reachable from
  # the canonical instance sources (defaulted empty so every pre-P1-5
  # constructor stays valid).
  concrete_types: Vec[SemanticConcreteType] = Vec::new()
  # (fourth-audit P1-5c) One row per allocating MIR statement/terminator.
  allocation_sites: Vec[SemanticAllocationSite] = Vec::new()
  # (fourth-audit P0-17) The PERSISTED typed drop-plan facts: one row per
  # materialized deinit site of the resource checker's finalize plan (the
  # exact-place masked drops included), keyed by the stable place/drop-site
  # texts. Defaulted empty so every pre-P0-17 snapshot constructor stays
  # valid and an absent table parses as no recorded drop plan; the writer
  # sorts through semantic_drop_plans_sort and emits the rows into the
  # digest preimage; the §31 delta diffs the table into typed
  # DropPlanDelta rows.
  drop_plans: Vec[DropPlanFact] = Vec::new()
  # The PERSISTED typed dependency graph (third-audit item 18): the
  # per-family edge rows the builder emits from TYPED finalized state
  # (never from rendered canonical strings) and the extended affected
  # closure walks. Defaulted empty; the writer sorts every family through
  # semantic_dependency_graph_sort and emits the rows into the digest
  # preimage.
  dependencies: SemanticDependencyGraph = SemanticDependencyGraph {}
  # (fourth-audit P1-5c) The per-domain digest record (persisted in the
  # header row; recomputed by semantic_snapshot_finalize before the
  # revision digest).
  domain_digests: SemanticDomainDigests = SemanticDomainDigests {}
  public_api_hash: StableDigest
  abi_hash: StableDigest
  unsafe_hash: StableDigest
end

# The projected header of a snapshot (the writer/parser carrier — see
# SnapshotHeader above).
def semantic_snapshot_header(snapshot: SemanticSnapshot) -> SnapshotHeader
  SnapshotHeader {
    compiler_version: snapshot.compiler_version.clone(),
    target: snapshot.target.clone(),
    feature_set: snapshot.feature_set.clone(),
    semantic_options: snapshot.semantic_options.clone()
  }
end

# The zero digest — the "not yet computed" placeholder for revision and the
# three surface hashes (stable_def_id_digested's collision-free zero word
# pair; nothing digests to zero in practice — the FNV-1a passes never emit
# the empty-word state).
def semantic_digest_zero() -> StableDigest
  StableDigest { hi: 0, lo: 0 }
end

# An EMPTY snapshot: no tables, zero digest words — the seed record the
# writer slice fills (the writer then sorts every table, renders the
# canonical text form and computes revision / the three surface hashes via
# ids.tg's stable_digest_of).
def semantic_snapshot_new(compiler_version: String, target: StableTargetId) -> SemanticSnapshot
  SemanticSnapshot {
    revision: semantic_digest_zero(),
    compiler_version: compiler_version,
    target: target,
    public_api_hash: semantic_digest_zero(),
    abi_hash: semantic_digest_zero(),
    unsafe_hash: semantic_digest_zero()
  }
end

# ———————————————————————————————————————————————————————————————
# AbiSurfaceRow — one persisted canonical ABI/layout row (audit item 18)
# ———————————————————————————————————————————————————————————————
# The ABI surface used to be a HASH ONLY (abi_hash digests the §30
# snapshot_abi_text lines); this table persists the canonical rows behind
# that surface so abi.diff can explain EXACT per-surface changes — layout
# sizes/alignments/field offsets, per-parameter ABI classes and the return
# class — instead of a hash mismatch alone.
#
#   surface_id  — the row's ABI-surface identity and the delta's join key:
#                 "fn:<full stable key>" for a function row,
#                 "type:<full stable key>" for a declared type row. Both
#                 are content-derived stable texts (never ephemeral ids).
#   symbol_key  — the underlying def's full stable key text
#                 ("module_path::name#signature" — the symbol/mir row key
#                 domain; a registration key without a signature component
#                 for defs the resolver registered without one).
#   kind        — the row family word: "fn" (function signature row) /
#                 "type" (declared type layout row) / "abi-fail-closed"
#                 (classification failed — the fields carry the reason,
#                 mirroring the snapshot_abi_text fail-closed marker
#                 convention; values are NEVER fabricated).
#   size        — the layout's total byte size (type rows); -1 on fn rows
#                 and fail-closed rows (no layout data — never a guess).
#   alignment   — the layout's byte alignment (type rows); -1 elsewhere.
#   arg_classes — one canonical ABI class word per DECLARED parameter
#                 (function rows; empty on type rows): the rendered
#                 AbiValueClass of the ONE plan authority
#                 (layout_engine.tg's classify_call_plan — third-audit
#                 item 41; the legacy per-position classifier remains the
#                 fail-reason authority) — "zero" / "scalar:<w>" /
#                 "pair:<w1>:<w2>" / "vector:<w>" / "by-address:<size>".
#                 Equal to param_classes (the same typed classes, kept as
#                 the item-18 render).
#   ret_class   — the return class word (function rows; "" otherwise): the
#                 plan's delivery render (abi_return_text) — "direct:" |
#                 "sret:" + the class word (ScalarPair / ByAddress return
#                 indirectly; Vector and scalar/zero results directly).
#   fields      — type rows: one "<name> <offset> <size>" text per field in
#                 declaration order (enum payload fields are variant-
#                 qualified "<Variant>#<index>" and the tag row is
#                 "tag <offset> <size>"); an "abi-fail-closed" row carries
#                 its single "reason:<word>" text; otherwise empty.
#
# THIRD-AUDIT ITEMS 42/43 — THE TYPED FFI-SURFACE MIRROR (all defaulted, so
# every pre-item-43 constructor stays valid; fn rows fill them from TYPED
# state — see semantic_snapshot.tg — and type/fail-closed rows keep the
# empty defaults; values are NEVER parsed back out of a signature string):
#   calling_convention — the function's ABI classification word: the extern
#                 declaration's MIR extern_abi tag ("C" | "System" |
#                 "Ruby" | "Tangerine") for an extern surface, "tangerine"
#                 for a def-keyed function (the compiler's own convention).
#   external_symbol — the linker symbol of an extern declaration (the MIR
#                 emission name); "" on def-keyed/type rows (an exported
#                 function's Tangerine-ABI name is not persisted today).
#   param_classes — one rendered AbiValueClass per declared parameter (the
#                 plan as arg_classes, kept as the typed mirror).
#   param_locations — one rendered AbiLocation per declared parameter
#                 (register names / "stack+<off>" / "none"). The location
#                 of an aggregate is the slot carrying its image/address;
#                 the access convention (ownership_in) carries the
#                 address-vs-value semantics.
#   ownership_in — one access-convention word per declared parameter
#                 ("let" | "inout" | "sink" | "set"), from the checker's
#                 typed FnSignature record — never from a text scan.
#   ownership_out — the return's ownership word: "owned" (the typed return
#                 type is ownership-carrying per the type-properties
#                 authority — owns_state, a registered destructor, or
#                 linear resource/capability state), "borrowed" (a
#                 Copy/non-owning value) or "none" (Unit).
#   nullability — one "arg<i> <word>" row per Ptr/PtrMut-typed parameter:
#                 "unknown" (the model has no nullability marker
#                 vocabulary — emitted explicitly, never omitted) or
#                 "nonnull" when a declared marker says so.
#   variadic — the extern declaration's trailing "..." marker (the typed
#                 FnSignature.variadic record / MIR is_extern_variadic);
#                 false for every def-keyed function.
#   extension — one rendered AbiExtension per declared parameter
#                 ("none" | "sign" | "zero" | "any").
#   platform — the StableTargetId triple word of the compilation (the
#                 platform the classes/locations belong to).
#   failure_convention — "result" when the declared return type is the
#                 builtin Result, "trap" for every other concrete return
#                 (the repo's panic model), "unknown" when undecidable.
#   thread_safety — "unknown" (no typed per-surface thread-safety marker
#                 exists; never inferred).
#   taint — "unmodeled" (no typed taint marker reaches the snapshot).
#   canonical_boundary — the enum-crossing authority's answer for the
#                 signature (third-audit item 42): the deduped
#                 "|"-joined renders of classify_enum_crossing over every
#                 enum parameter/return, "n/a" when the signature mentions
#                 no enum, "fail-closed:<word>" when the authority refuses.
#                 This is the ONE crossing BOTH routes use (fourth-audit
#                 P0-20): the canonical TaggedPtr value word for a
#                 registered enum (the LIR route constructs/reads/moves/
#                 drops that same word and consumes the same call plan),
#                 InlineScalar for the legacy one-word InlineTagged image.
#                 The former LIR-private `inline-image-v1` representation,
#                 its per-function version marker and the
#                 `tg.abi.enumver` object note were deleted.
struct AbiSurfaceRow
  surface_id: String
  symbol_key: String
  kind: String
  size: Int
  alignment: Int
  arg_classes: Vec[String] = Vec::new()
  ret_class: String = ""
  fields: Vec[String] = Vec::new()
  calling_convention: String = ""
  external_symbol: String = ""
  param_classes: Vec[String] = Vec::new()
  param_locations: Vec[String] = Vec::new()
  ownership_in: Vec[String] = Vec::new()
  ownership_out: String = ""
  nullability: Vec[String] = Vec::new()
  variadic: Bool = false
  extension: Vec[String] = Vec::new()
  platform: String = ""
  failure_convention: String = ""
  thread_safety: String = ""
  taint: String = ""
  canonical_boundary: String = ""
end

# The canonical text of one ABI surface row — the ONE grammar the delta's
# per-surface before/after texts and abi_report's row render share:
#   "surface=<id>;symbol=<key>;kind=<kind>;size=<n>;align=<n>;args=<a,b>;ret=<r>;fields=<f1;f2>;conv=<c>;extern=<x>;pclasses=<a|b>;plocs=<a|b>;ownin=<let|sink>;ownout=<o>;null=<arg0 unknown|...>;variadic=<true|false>;ext=<a|b>;platform=<triple>;failure=<f>;thread=<t>;taint=<t>;boundary=<b|...>"
# (arg class / convention / ownership / extension / platform / failure /
# thread / taint / boundary words carry no ',' / ';' / '|'; field texts and
# ownership_in values carry no ';' either; the new VECTOR fields are
# '|'-joined because a rendered location ("x0,x1") may itself contain a
# comma; empty vectors render as empty runs). The new pairs are APPENDED
# after the item-18 prefix, so prefix readers (change_budget's
# budget_abi_row_key) stay valid.
def semantic_abi_surface_row_text(r: AbiSurfaceRow) -> String
  let variadic_word = if r.variadic then "true" else "false" end
  "surface=" + r.surface_id.clone() + ";symbol=" + r.symbol_key.clone() +
    ";kind=" + r.kind.clone() + ";size=" + r.size.to_string() +
    ";align=" + r.alignment.to_string() +
    ";args=" + r.arg_classes.join(",") +
    ";ret=" + r.ret_class.clone() +
    ";fields=" + r.fields.join(";") +
    ";conv=" + r.calling_convention.clone() +
    ";extern=" + r.external_symbol.clone() +
    ";pclasses=" + r.param_classes.join("|") +
    ";plocs=" + r.param_locations.join("|") +
    ";ownin=" + r.ownership_in.join("|") +
    ";ownout=" + r.ownership_out.clone() +
    ";null=" + r.nullability.join("|") +
    ";variadic=" + variadic_word +
    ";ext=" + r.extension.join("|") +
    ";platform=" + r.platform.clone() +
    ";failure=" + r.failure_convention.clone() +
    ";thread=" + r.thread_safety.clone() +
    ";taint=" + r.taint.clone() +
    ";boundary=" + r.canonical_boundary.clone()
end

# ———————————————————————————————————————————————————————————————
# SemanticSymbol — one declared definition
# ———————————————————————————————————————————————————————————————
# Identity is the definition's StableDefId (ids.tg): the 128-bit digest of
# the canonical "path::name#signature" key the resolver computes
# (compute_stable_def_id) — content-derived and order-independent, verified
# against key collisions by stable_digest_verify at registration. kind is
# the resolver's DefKind metadata vocabulary (ids.tg); name / module_path
# are the flat spellings of stable_id.path's two components (stable_id.key =
# module_path + "::" + name + "#" + signature). is_pub marks the public
# surface (the public_api_hash domain). span is provenance only.
struct SemanticSymbol
  stable_id: StableDefId   # stable identity: canonical key + 128-bit digest
  kind: DefKind            # Function / Method / Static / Constant / EnumVariant / StructField / Intrinsic / TypeName / Trait / Other
  name: String             # declaration name (the stable key's name component)
  module_path: String      # module-qualified path ("a::b") of the declaration
  is_pub: Bool             # public-surface membership
  is_generic: Bool         # declaration declares generic parameters
  span: Option[Span] = Option::None   # declaration span — provenance metadata ONLY, never identity
end

# ———————————————————————————————————————————————————————————————
# SemanticType — one nominal type declaration
# ———————————————————————————————————————————————————————————————
# The stable identity is the type declaration's StableDefId (types register
# through the same resolver machinery as the DefKind::TypeName / Trait
# entries). kind splits the nominal family — struct vs enum vs trait is not
# distinguished by any single existing id, so the snapshot carries its own
# small vocabulary; the per-compilation TypeId/DefId associations are NOT
# snapshot data (they are ephemeral; the mapping lives in the producing
# compilation's resolver tables).
struct SemanticType
  stable_id: StableDefId   # stable identity: canonical key + 128-bit digest
  kind: SemanticTypeKind   # Struct | Enum | Trait
  name: String
  module_path: String
  generic_arity: Int       # declared generic-parameter count
  is_pub: Bool
  span: Option[Span] = Option::None   # declaration span — provenance metadata ONLY
end

enum SemanticTypeKind
  Struct
  Enum
  Trait
end

# ———————————————————————————————————————————————————————————————
# CallEdge — one caller -> callee call relationship
# ———————————————————————————————————————————————————————————————
# Both endpoints are stable definition ids (callers and callees are defs —
# functions, methods, statics, intrinsics — so the StableDefId domain covers
# them). kind classifies the call: Direct is a statically-resolved call,
# Indirect a closure/function-pointer call recorded against the statically-
# known declaration it routes through, Intrinsic a compiler-known intrinsic
# operation (the IntrinsicId KIND classification is per-compilation and never
# rides a snapshot). sites is the call-site span LIST (one entry per textual
# site) — metadata only: a call edge exists once per (caller, callee, kind)
# regardless of how many sites call it, so harmless textual movement never
# forks an edge.
struct CallEdge
  caller: StableDefId
  callee: StableDefId
  kind: CallEdgeKind       # Direct | Indirect | Intrinsic
  sites: Vec[Span] = Vec::new()   # call-site spans — provenance metadata ONLY
end

enum CallEdgeKind
  Direct
  Indirect
  Intrinsic
end

# ———————————————————————————————————————————————————————————————
# IndirectCallEdge — one call whose callee is NOT statically known
# ———————————————————————————————————————————————————————————————
# (audit item 13 — the EXPLICIT row replacing the snapshot's silent
# omission): the call graph records a direct edge only when the callee is
# statically known; an indirect site (a call through a function-pointer /
# closure / unknown VALUE) is recorded HERE instead, so no call site is
# ever silently dropped from the snapshot. Fields:
#   caller      — the caller function's row key text (the def digest key
#                 for a def-keyed caller, the origin key text for a
#                 synthesized caller — the SAME text the caller's
#                 mir_functions row carries, so consumers can join).
#   site        — the call-site locator text within the caller (the §33
#                 grammar "<caller key>#B<block id>#T").
#   signature   — the canonical type text of the indirect callee (the
#                 FnPtr/Closure surface when the MIR carries it; the
#                 canonical text of the best-resolved operand type).
#   candidates  — the statically known candidate set (points-to results).
#                 EMPTY unless the compiler has points-to info: the
#                 snapshot's call builder carries none, so every row it
#                 emits has an empty candidate set.
#   completeness — "Unknown" unless points-to analysis completed the
#                 candidate set ("Known" then). "Unknown" rows mean the
#                 row's caller makes a call the delta/change machinery
#                 cannot see through.
# CONSERVATISM CONTRACT (change.affected): a change report MUST treat the
# caller of an "Unknown" indirect row as potentially affected by ANY callee
# change — an unknown indirect caller can reach anything, so excluding it
# from an affected set is only sound when the caller's own key is the
# change subject.
struct IndirectCallEdge
  caller: String
  site: String
  signature: String
  candidates: Vec[String] = Vec::new()
  completeness: String       # "Unknown" | "Known"
end

# ———————————————————————————————————————————————————————————————
# EffectEdge — one function/operation effect fact
# ———————————————————————————————————————————————————————————————
# Reuses the §11 canonical effect record (types.tg EffectSummary) VERBATIM —
# the may_allocate / may_block / may_io / may_spawn / may_sleep / may_panic /
# may_unsafe flags plus the Set[CapabilityId] capability set — so snapshot
# effect data is byte-identical in shape to what the §11 MIR pass computes
# (effect_summary_merge / effect_summary_unknown live there, not here). The
# row's subject is the function whose body performs the summarized operation
# set. span is the summarized operation's site — metadata only.
struct EffectEdge
  function: StableDefId    # the subject function (stable identity)
  summary: EffectSummary   # the §11 semantic effect record — fields reused verbatim
  # (third-audit item 25) The subject function's COMPILER-VERIFIED purity
  # status word ("ProvenPure" | "Impure" | "Unknown"; "" = the function is
  # not in any analyzed purity domain) plus the evidence rows the MIR
  # purity pass recorded for it (the offending allocate/io/block/sleep/
  # spawn class site, the mmio/arena capability, the pointer/static
  # store, or the caller->callee path into one of them; panic-class
  # operations are permitted by the theorem's documented decision). Plain
  # String / Vec[String] fields keep this model module independent of MIR;
  # the snapshot writer maps the mir.tg PurityStatus through
  # purity_status_word / purity_status_evidence. Only ProvenPure carries
  # the optimizer/equivalence privileges.
  purity_status: String = ""
  purity_evidence: Vec[String] = Vec::new()
  span: Option[Span] = Option::None   # operation site — provenance metadata ONLY
end

# ———————————————————————————————————————————————————————————————
# CapabilityEdge — one function <-> capability edge
# ———————————————————————————————————————————————————————————————
# capability is the existing CapabilityId domain (types.tg — fixed numeric
# identities, never names: the arena / mmio behavioral capabilities of the
# §11 record). kind is the edge direction: Requires = the function's body
# requires the capability to run, Provides = the function provides/grants
# the capability to its callers. span is the declaring/performing site —
# metadata only.
struct CapabilityEdge
  function: StableDefId
  capability: CapabilityId
  kind: CapabilityEdgeKind # Requires | Provides
  span: Option[Span] = Option::None   # declaring site — provenance metadata ONLY
end

enum CapabilityEdgeKind
  Requires
  Provides
end

# ———————————————————————————————————————————————————————————————
# OwnershipFact — one per-place ownership fact in a function body
# ———————————————————————————————————————————————————————————————
# Ownership is a per-place property and the compiler has NO stable id for a
# place (LocalId / MirLocalId are ephemeral per-compilation domains) — so the
# fact's object is the canonical place-key TEXT within the subject function
# (the delta identity digests that text), never an ephemeral local id and
# never a span. convention is the existing AccessConvention vocabulary (Let =
# shared read, Inout = mutable borrow, Sink = moved, Set = written). span is
# the transfer site — metadata only.
struct OwnershipFact
  function: StableDefId    # the subject function (stable identity)
  place_key: String        # canonical place path text within the function ("self.field", "x[i]")
  convention: AccessConvention   # Let | Inout | Sink | Set — the ast.tg ownership vocabulary
  span: Option[Span] = Option::None   # transfer site — provenance metadata ONLY
end

# ———————————————————————————————————————————————————————————————
# ContractFact — one declared contract clause on a function
# ———————————————————————————————————————————————————————————————
# The canonical contract clause row (audit item 11): the row IDENTITY is
# the clause's StableContractId — the stable_ids.tg composite key
# "<fn digest key>|Pre|Post|Invariant|<canonical clause text>" (the
# stable_contract_row_key grammar — the canonical text component is the
# flattened ContractExprIR, NEVER the message and never the source
# spelling), so a formatting/whitespace/comment-only edit of a clause —
# and a message-only edit — reproduce the SAME row. kind reuses
# AstContractKind (AstPre / AstPost / AstInvariant). The clause CONTENT is
# three fields:
#   expression_fingerprint — the 128-bit stable digest of the canonical
#                            clause text (the flattened canonical
#                            expression — the delta compares the rows by
#                            this fingerprint).
#   canonical_expression   — the canonical typed-expression render
#                            (ContractExprIR — op word + canonical argument
#                            texts; resolved symbols ride as their stable
#                            key texts where the compiler carries them,
#                            constants by value, operators by kind; spans,
#                            parens, whitespace and comments never
#                            participate).
#   message                — the clause's declared human message
#                            (Option::None = the clause declared none).
# span is the clause's span — metadata only.
struct ContractExprIR
  op: String          # the canonical operator/kind word of the expression
  args: Vec[String]   # the canonical payload/child texts, in fixed order
  # (third-audit item 18) The clause expression's RESOLVED symbol
  # references: the def stable keys of every resolved reference the clause
  # carries (collected structurally from the source expression's resolved
  # path nodes at the snapshot builder's canonical-clause lowering, then
  # resolved against the def universe). Replaces the delta's flatten-text
  # token scan ("path(...)") for the ContractReferences edge class: the
  # refs are FIELDS here, never re-parsed from semantic_contract_expr_text.
  # Defaulted empty so every pre-item-18 literal site stays legal; a clause
  # with no resolvable reference carries none.
  resolved_refs: Vec[String] = Vec::new()
end

# The canonical-clause clone: every field is an owned String or a vector of
# owned strings, so the default container clones discharge it. Registered
# because ContractFact.canonical_expression is a component of the sorted
# fact rows.
impl Clone for ContractExprIR
  def clone(self: Self) -> ContractExprIR
    ContractExprIR {
      op: self.op.clone(),
      args: self.args.clone(),
      resolved_refs: self.resolved_refs.clone()
    }
  end
end

struct ContractFact
  id: StableContractId      # the stable clause identity (the row key record)
  function: StableDefId     # the declaring function/method (stable identity)
  kind: AstContractKind     # AstPre | AstPost | AstInvariant
  expression_fingerprint: StableDigest   # digest of the canonical clause text
  canonical_expression: ContractExprIR   # the canonical clause form
  message: Option[String]   # the declared message (None = none declared)
  span: Option[Span] = Option::None   # clause span — provenance metadata ONLY
end

# The flattened canonical text of a ContractExprIR — the deterministic
# "op(arg1,arg2,...)" form the row keys, fingerprints and sort tiebreaks
# digest/compare (the identity text: two clauses are the SAME clause iff
# these texts are equal after the function/kind components agree).
def semantic_contract_expr_text(ce: ContractExprIR) -> String
  ce.op + "(" + ce.args.join(",") + ")"
end

# ———————————————————————————————————————————————————————————————
# TestRelationship — one test-function -> exercised-function relationship
# ———————————————————————————————————————————————————————————————
# Both endpoints are stable definition ids: test is the test-carrying
# function (a #[test]-annotated def), target is the function it exercises. A
# test that exercises nothing (a compile-only test) never appears. span is
# the test function's declaration span — metadata only.
struct TestRelationship
  test: StableDefId        # the test function (subject)
  target: StableDefId      # the exercised function (object)
  span: Option[Span] = Option::None   # test declaration span — provenance metadata ONLY
end

# ———————————————————————————————————————————————————————————————
# CoverageRelationship — one function <-> branch-point coverage fact
# ———————————————————————————————————————————————————————————————
# Coverage structure is branch/arm-granular and the codebase's coverage
# domain (coverage.tg §62) identifies points by stable STRING ids derived
# from the owning symbol id + block/terminator ordinals — the compiler has no
# digest domain for a branch point, so the fact's object is that canonical
# branch-id TEXT (the row digests it for deltas). kind is the branch-point
# classification text ("IfExpr", "MatchExpr", ...). arm_id is the
# arm-granular id when the fact is arm-scoped. test_id is the coverage
# fact's TEST ENDPOINT (the audit item-19/§40 model change): the stable
# key text of the exercising test function when an execution-side ingest
# records the fact under a test run — the row-level link the §40
# MirBlockId/MirEdgeId -> TestId indexes need; the defaulted "" is the
# unbound endpoint (a fact recorded outside any test run, or before the
# ingest fills the field). span is the branch point's
# span — metadata only (the coverage ids themselves are span-free by
# construction).
struct CoverageRelationship
  function: StableDefId    # the function owning the branch point
  branch_id: String        # canonical coverage branch id text (the §62.2 stable scheme)
  arm_id: Option[String] = Option::None   # canonical arm id when arm-granular
  kind: String             # branch-point classification ("IfExpr", "MatchExpr", ...)
  test_id: String = ""     # exercising test's stable key text (defaulted "" = unbound)
  span: Option[Span] = Option::None   # branch-point span — provenance metadata ONLY
end

# ———————————————————————————————————————————————————————————————
# MirSemanticSummary — one function's lowered-MIR semantic summary
# ———————————————————————————————————————————————————————————————
# The semantic face of a lowered function: structural counts (blocks /
# statements / locals) plus the function's TRANSITIVE §11 effect summary
# (the fixed-point union the §11 MIR pass computes over the lowered program
# — EffectSummary reused verbatim) and the fail-closed markers: calls_unsafe
# (an unsafe operation was reachable) and calls_unknown (an operation with
# unbounded behavior was reachable — the effect_summary_unknown shape, never
# silently clean). reachable = the function's entry was reached in the
# lowered program's reachability walk.
struct MirSemanticSummary
  function: StableDefId
  block_count: Int         # lowered basic-block count
  statement_count: Int     # lowered statement count
  local_count: Int         # lowered local-slot count
  reachable: Bool          # entry reachable in the lowered program
  calls_unsafe: Bool       # an unsafe operation is reachable
  calls_unknown: Bool      # an unbounded-behavior operation is reachable (fail closed)
  effect_summary: EffectSummary   # the §11 transitive semantic summary — fields reused verbatim
  # (third-audit item 25) The row's compiler-verified purity status word
  # and evidence rows — the SAME projection the effect row carries (see
  # EffectEdge); "" = not in any analyzed purity domain.
  purity_status: String = ""
  purity_evidence: Vec[String] = Vec::new()
end

# ———————————————————————————————————————————————————————————————
# UnsafeKind — the unsafe-surface fact vocabulary (audit item 16)
# ———————————————————————————————————————————————————————————————
# One word per unsafe operation CLASS the snapshot's unsafe surface can
# record. The snapshot builder derives facts from the unsafe markers it
# already computes (semantic_snapshot.tg — unsafe-fn / extern-call /
# transmute / unknown-call marker rows of the verified MIR's def-keyed
# lowerings), so only the four kinds below are PRODUCED today (each marker
# maps onto its kind + site key: "unsafe-fn" -> UnsafeFunction with an
# empty site; "extern-call:<name>" -> ExternBoundary with the callee name
# as the site; "transmute" -> Transmute; "unknown-call:<name>" ->
# UnknownUnsafeCall with the callee name as the site). The remaining kinds
# (UnsafeBlock / RawDeref / RawPointerCast / UncheckedIndex / InlineAsm /
# VolatileRawAccess / UnsafeTraitImpl) are the audit vocabulary reserved
# for the marker families the snapshot walk does not emit today — never
# produced, never invented for an operation the walk cannot see.
enum UnsafeKind
  UnsafeBlock
  UnsafeFunction
  RawDeref
  RawPointerCast
  Transmute
  UncheckedIndex
  ExternBoundary
  InlineAsm
  VolatileRawAccess
  UnsafeTraitImpl
  UnknownUnsafeCall
end

# ONE unsafe-surface fact (audit item 16): the subject function's stable
# key TEXT (the same text the def's symbol/mir rows carry — the digest
# key, never a name), the UnsafeKind word, and the SITE key of the marker
# within the function (the extern/unknown-call callee name; "" for the
# site-less marker families). digest_hi / digest_lo are the 128-bit
# stable digest words of the fact's canonical text
# "<function>|<kind-word>|<site>" — the fact's content identity (the
# builder computes them; Eq/Hash fold them like every stable-id record).
struct UnsafeFact
  function: String
  kind: UnsafeKind
  site: String
  digest_hi: UInt = 0
  digest_lo: UInt = 0
  # (fourth-audit P0-19) The TYPED unsafe-site identity of the row: the
  # owning declaration's StableDeclId, the kind word and the site text —
  # the member the §36 ChangeBudget's typed allowed_unsafe set keys on
  # (the budget never re-parses a rendered marker row). Defaulted None so
  # every pre-P0-19 literal site stays valid; the snapshot builder
  # populates it through stable_unsafe_site_id_of at fact construction.
  site_id: Option[StableUnsafeSiteId] = Option::None
end

impl Eq for UnsafeFact
  # Content equality over the digest words — the stable-id doctrine: the
  # words digest the fact's canonical text, so two facts with equal words
  # are the same fact (the builder dedupes and computes the words over
  # the same canonical grammar every row uses).
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for UnsafeFact
  # The two digest words folded through the unsigned 64-bit view (the
  # stable_ids.tg hash fold — unsigned arithmetic wraps, so the signed
  # +-*-trap never fires inside the hash).
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

# The created/removed fact lists of ONE delta (audit item 16): what the
# b-side unsafe_facts table gained / lost against the a-side table —
# rows created (Present only in b) and rows removed (Present only in a).
# Both lists default empty (the empty delta's unsafe surface).
struct UnsafeDelta
  created: Vec[UnsafeFact] = Vec::new()
  removed: Vec[UnsafeFact] = Vec::new()
end

# (fourth-audit P0-17) ONE TYPED drop-plan fact: a materialized deinit site
# of one function's ownership cleanup, keyed by the stable place text and
# the drop-site identity. The row is the PERSISTED form of the resource
# checker's path-sensitive finalize plan (the cleanup edges' Drop actions
# and the exact-place masked drops) as the MIR materializes them:
#   function         — the owning function's stable key text (the same
#                      emission key the mir_functions/ownership rows carry).
#   place            — the canonical place key the value is destroyed at
#                      (the snapshot_place_key grammar — "x", "self.field").
#   drop_site        — the deinit site's stable text: the CFG edge's
#                      structural identity "<function>|<edge-kind>|B<source>"
#                      (the resource checker's CfgEdgeKind word + the
#                      originating node id).
#   conditional_paths — the path conditions the drop executes under: the
#                      edge's branch word ("branch:true" / "branch:false" /
#                      "loop-backedge" / ...) plus any consumed-extension
#                      MASK rows of an exact-place partial drop ("mask:<path>").
#                      Empty = the drop runs on every path through the site.
#   kind             — the drop kind word: "fn-end" | "scope-exit" |
#                      "branch-cleanup" | "loop-exit" | "iteration" |
#                      "guard-else" | "assign-replace", derived from the
#                      cleanup edge kind (the resource checker's own
#                      classification), never invented.
# The table is sorted through semantic_drop_plans_sort and the §31 delta
# diffs it per (function, place) into typed DropPlanDelta rows.
struct DropPlanFact
  function: String
  place: String
  drop_site: String
  conditional_paths: Vec[String] = Vec::new()
  kind: String
end

# The canonical kind WORD of an UnsafeKind (the snapshot/unsafe_text
# marker vocabulary of the produced kinds — "unsafe-fn", "extern-call",
# "transmute", "unknown-call"; the reserved kinds render their kebab-case
# variant words).
def semantic_unsafe_kind_text(k: UnsafeKind) -> String
  match k
  when UnsafeKind::UnsafeBlock then "unsafe-block"
  when UnsafeKind::UnsafeFunction then "unsafe-fn"
  when UnsafeKind::RawDeref then "raw-deref"
  when UnsafeKind::RawPointerCast then "raw-pointer-cast"
  when UnsafeKind::Transmute then "transmute"
  when UnsafeKind::UncheckedIndex then "unchecked-index"
  when UnsafeKind::ExternBoundary then "extern-call"
  when UnsafeKind::InlineAsm then "inline-asm"
  when UnsafeKind::VolatileRawAccess then "volatile-raw-access"
  when UnsafeKind::UnsafeTraitImpl then "unsafe-trait-impl"
  when UnsafeKind::UnknownUnsafeCall then "unknown-call"
  end
end

# The UnsafeKind discriminant — declaration order above (the sort
# tiebreak; deterministic per the enum declaration).
def semantic_unsafe_kind_numeric(k: UnsafeKind) -> Int
  match k
  when UnsafeKind::UnsafeBlock then 0
  when UnsafeKind::UnsafeFunction then 1
  when UnsafeKind::RawDeref then 2
  when UnsafeKind::RawPointerCast then 3
  when UnsafeKind::Transmute then 4
  when UnsafeKind::UncheckedIndex then 5
  when UnsafeKind::ExternBoundary then 6
  when UnsafeKind::InlineAsm then 7
  when UnsafeKind::VolatileRawAccess then 8
  when UnsafeKind::UnsafeTraitImpl then 9
  when UnsafeKind::UnknownUnsafeCall then 10
  end
end

# The canonical text of a fact — "<function>|<kind-word>|<site>" — the
# digest preimage the builder digests into digest_hi/lo. The site is the
# LAST field, so a site containing '|' stays unambiguous (the contract
# clause convention of the row-key grammars).
def semantic_unsafe_fact_text(f: UnsafeFact) -> String
  f.function.clone() + "|" + semantic_unsafe_kind_text(&f.kind) + "|" + f.site.clone()
end

# ———————————————————————————————————————————————————————————————
# DependencyEdgeKind — the semantic dependency-graph edge vocabulary
# (audit item 41)
# ———————————————————————————————————————————————————————————————
# SemanticDelta.affected is the fixed-point closure over a SEMANTIC
# DEPENDENCY GRAPH, not just the call graph: a changed entity (a seed from
# the delta's created / removed / modified lists) affects every entity
# reachable through the dependency edges of the requested kinds. Each kind
# below is one EDGE CLASS of that graph — the selector vocabulary of the
# extended closure API (semantic_delta.tg's affected_closure). The per-kind
# data source and coverage status live in that function's doc matrix; the
# classes the snapshot's typed dependency graph carries rows for
# (snapshot.dependencies — the third-audit item 18 records below) are
# walked over those REAL edges. A class whose family is UNAVAILABLE is
# reported by the closure (AffectedResult.missing_relations) and is NEVER
# substituted by the caller closure (fourth-audit P0-9 — the status table
# is SemanticDependencyGraph.dependency_completeness).
#
# Declaration order is the canonical kind order (the numeric flattening
# below is the closure's deterministic kind selector). TypeUse is APPENDED
# (numeric 12): the pre-existing discriminants never move.
#   Call                  — call rows, walked callee -> caller.
#   Implements            — impl rows (trait -> implementors) + selection rows (method -> impl).
#   GenericInstantiation  — template -> mono instance rows.
#   ContainsType          — container -> contained type rows (LayoutDependencyEdge).
#   LayoutDependent       — layout consumers of a type (LayoutDependencyEdge).
#   ConstEvalDependent    — const-evaluation dependents (ConstEvalDependencyEdge rows).
#   DerivedImpl           — derived-body dependents (DerivedBodyEdge rows).
#   AbiConsumer           — pub-fn call consumers + AbiDependencyEdge surface rows.
#   EffectPropagation     — transitive §11 effect propagation (rides the call rows).
#   CapabilityPropagation — capability propagation to callers (rides the call rows).
#   ContractReferences    — ContractReferenceEdge rows (contract -> referenced def).
#   TestReferences        — test -> exercised-function rows, walked target -> test.
#   TypeUse               — user -> used-type rows (TypeUseEdge).
enum DependencyEdgeKind
  Call
  Implements
  GenericInstantiation
  ContainsType
  LayoutDependent
  ConstEvalDependent
  DerivedImpl
  AbiConsumer
  EffectPropagation
  CapabilityPropagation
  ContractReferences
  TestReferences
  TypeUse
end

# The DependencyEdgeKind discriminant — declaration order above (the
# closure's deterministic kind selector).
def semantic_dependency_edge_kind_numeric(k: DependencyEdgeKind) -> Int
  match k
  when DependencyEdgeKind::Call then 0
  when DependencyEdgeKind::Implements then 1
  when DependencyEdgeKind::GenericInstantiation then 2
  when DependencyEdgeKind::ContainsType then 3
  when DependencyEdgeKind::LayoutDependent then 4
  when DependencyEdgeKind::ConstEvalDependent then 5
  when DependencyEdgeKind::DerivedImpl then 6
  when DependencyEdgeKind::AbiConsumer then 7
  when DependencyEdgeKind::EffectPropagation then 8
  when DependencyEdgeKind::CapabilityPropagation then 9
  when DependencyEdgeKind::ContractReferences then 10
  when DependencyEdgeKind::TestReferences then 11
  when DependencyEdgeKind::TypeUse then 12
  end
end

# ———————————————————————————————————————————————————————————————
# The typed semantic dependency-graph records (third-audit items 18/19)
# ———————————————————————————————————————————————————————————————
# One per-class record per edge family. Every endpoint is a canonical
# stable-key / row-id TEXT in the snapshot's key domain (the SAME domain the
# delta's created / removed / modified seed lists carry), so the closure
# walks REAL rows by identity and never re-parses another row's rendered
# content. The per-family PRODUCER anchors live in semantic_snapshot.tg's
# dependency-graph section (typed data only: resolved signatures, typed
# field shapes, ImplInfo records, InstanceId constants, MirStaticRef
# operands, derived-body lowerings, AbiSurface type references); the
# per-kind CONSUMER anchors are semantic_delta.tg's affected_closure.
#
#   TypeUseEdge              — user (a def or type key) -> used_type (a
#                              registered nominal type key).
#   TraitImplEdge            — impl_key (canonical text
#                              "impl::<self type key>|as|<trait key>") ->
#                              trait_key + self_type.
#   TraitSelectionEdge       — function (the impl method's def key — the
#                              semantically known selection/dispatch site)
#                              -> trait_key + impl_key.
#   GenericInstantiationEdge — instance_key (the mono instance's mir row key
#                              "instance::<emission>") -> template (the
#                              generic def's key).
#   LayoutDependencyEdge     — dependent_type -> source_type (a type the
#                              dependent's typed field shapes contain).
#   ConstEvalDependencyEdge  — dependent (the referencing lowering's mir row
#                              key) -> referenced_const (the module
#                              const/static def key a MirStaticRef operand
#                              names).
#   DerivedBodyEdge          — derived_key (the derived lowering's mir row
#                              key) -> source_type (a nominal type its typed
#                              lowering references).
#   ContractReferenceEdge    — contract_id (StableContractId.stable_key) ->
#                              referenced_symbol (a def key of the clause's
#                              resolved reference set).
#   AbiDependencyEdge        — surface_id ("fn:<key>" / "type:<key>") ->
#                              type_key (a nominal type the surface's typed
#                              signature/layout references).
struct TypeUseEdge
  user: String
  used_type: String
end

struct TraitImplEdge
  impl_key: String
  trait_key: String
  self_type: String
end

struct TraitSelectionEdge
  function: String
  trait_key: String
  impl_key: String
end

struct GenericInstantiationEdge
  instance_key: String
  template: String
end

struct LayoutDependencyEdge
  dependent_type: String
  source_type: String
end

struct ConstEvalDependencyEdge
  dependent: String
  referenced_const: String
end

struct DerivedBodyEdge
  derived_key: String
  source_type: String
end

struct ContractReferenceEdge
  contract_id: String
  referenced_symbol: String
end

struct AbiDependencyEdge
  surface_id: String
  type_key: String
end

# The dependency-graph edge clones: every edge row is a pair of owned
# canonical key texts, so each clone duplicates its strings. Registered
# because SemanticDependencyGraph's vectors (and the snapshot's graph
# field) clone through these component instances.
impl Clone for TypeUseEdge
  def clone(self: Self) -> TypeUseEdge
    TypeUseEdge { user: self.user.clone(), used_type: self.used_type.clone() }
  end
end

impl Clone for TraitImplEdge
  def clone(self: Self) -> TraitImplEdge
    TraitImplEdge { impl_key: self.impl_key.clone(), trait_key: self.trait_key.clone(), self_type: self.self_type.clone() }
  end
end

impl Clone for TraitSelectionEdge
  def clone(self: Self) -> TraitSelectionEdge
    TraitSelectionEdge { function: self.function.clone(), trait_key: self.trait_key.clone(), impl_key: self.impl_key.clone() }
  end
end

impl Clone for GenericInstantiationEdge
  def clone(self: Self) -> GenericInstantiationEdge
    GenericInstantiationEdge { instance_key: self.instance_key.clone(), template: self.template.clone() }
  end
end

impl Clone for LayoutDependencyEdge
  def clone(self: Self) -> LayoutDependencyEdge
    LayoutDependencyEdge { dependent_type: self.dependent_type.clone(), source_type: self.source_type.clone() }
  end
end

impl Clone for ConstEvalDependencyEdge
  def clone(self: Self) -> ConstEvalDependencyEdge
    ConstEvalDependencyEdge { dependent: self.dependent.clone(), referenced_const: self.referenced_const.clone() }
  end
end

impl Clone for DerivedBodyEdge
  def clone(self: Self) -> DerivedBodyEdge
    DerivedBodyEdge { derived_key: self.derived_key.clone(), source_type: self.source_type.clone() }
  end
end

impl Clone for ContractReferenceEdge
  def clone(self: Self) -> ContractReferenceEdge
    ContractReferenceEdge { contract_id: self.contract_id.clone(), referenced_symbol: self.referenced_symbol.clone() }
  end
end

impl Clone for AbiDependencyEdge
  def clone(self: Self) -> AbiDependencyEdge
    AbiDependencyEdge { surface_id: self.surface_id.clone(), type_key: self.type_key.clone() }
  end
end

# The snapshot's PERSISTED dependency graph: one vector per edge family
# above, all defaulted empty so an edge family a compilation produces no
# rows for stays representable (and pre-graph serialized snapshots stay
# loadable under the defaulted field).
#
# dependency_completeness (fourth-audit P0-9) is the graph's PER-FAMILY
# producer-status table: family name -> status word. It is what lets the
# affected closure distinguish "this family has no dependents" (the
# producer POPULATED it and the rows are legitimately empty) from "this
# family's dependents are UNKNOWN" (the producer lacked the data source).
# The status vocabulary:
#   "complete"    — the producer's data source covered the family: rows
#                   may be empty because the program really has no
#                   dependency of this family (Complete-no-dependents).
#   "partial"     — rows were produced where the typed data was reachable
#                   but the producer documents residual gaps (e.g. the
#                   const-eval type-level folds, the trait-selection
#                   resolution gaps); the rows that exist are real, the
#                   absence of a row is not proof of no dependency.
#   "unavailable" — the producer had no data source for the family; an
#                   empty family carries NO information.
# Family names are the closure's relation-family words (Call / TypeUse /
# TraitImpl / TraitSelection / GenericInstantiation / LayoutDependency /
# ConstEvalDependency / DerivedBody / ContractReference / AbiDependency /
# TestReferences); see semantic_snapshot.tg's producer section for the
# per-family status anchors and semantic_delta.tg's affected_closure for
# the consumer rule. A family with NO entry fails closed as unavailable
# (except Call / TestReferences, whose row tables predate the table).
struct SemanticDependencyGraph
  type_uses: Vec[TypeUseEdge] = Vec::new()
  trait_impls: Vec[TraitImplEdge] = Vec::new()
  trait_selections: Vec[TraitSelectionEdge] = Vec::new()
  generic_instantiations: Vec[GenericInstantiationEdge] = Vec::new()
  layout_dependencies: Vec[LayoutDependencyEdge] = Vec::new()
  const_eval_dependencies: Vec[ConstEvalDependencyEdge] = Vec::new()
  derived_bodies: Vec[DerivedBodyEdge] = Vec::new()
  contract_references: Vec[ContractReferenceEdge] = Vec::new()
  abi_dependencies: Vec[AbiDependencyEdge] = Vec::new()
  dependency_completeness: Map[String, String] = Map::new()
end

# The dependency-graph clone: every edge family duplicates elementwise
# through its registered edge Clone; the completeness map duplicates
# through the registered String-keyed Map clone (the digest texts are the
# values). Registered because SemanticSnapshot.dependencies is a component
# of the snapshot clones.
impl Clone for SemanticDependencyGraph
  def clone(self: Self) -> SemanticDependencyGraph
    SemanticDependencyGraph {
      type_uses: self.type_uses.clone(),
      trait_impls: self.trait_impls.clone(),
      trait_selections: self.trait_selections.clone(),
      generic_instantiations: self.generic_instantiations.clone(),
      layout_dependencies: self.layout_dependencies.clone(),
      const_eval_dependencies: self.const_eval_dependencies.clone(),
      derived_bodies: self.derived_bodies.clone(),
      contract_references: self.contract_references.clone(),
      abi_dependencies: self.abi_dependencies.clone(),
      dependency_completeness: self.dependency_completeness.clone()
    }
  end
end

# ———————————————————————————————————————————————————————————————
# SemanticResponsePayload — the typed semantic RESPONSE envelope (audit
# item 23: replace the free-form "kind" String + keys rows of the query
# protocol with TYPED per-kind payloads)
# ———————————————————————————————————————————————————————————————
# The payload of ONE semantic answer (the §38 QueryResults.payload /
# §39 SemanticResponse.payload slot). MODULE-REALITY MAPPING — explicit:
# the snapshot/delta protocol carries every semantic fact as CANONICAL ROW
# TEXT (stable-key texts, §31 row-key texts, §32 payload renders — the
# rows of semantic_query.tg / semantic_server.tg's QueryResults.keys), so
# the variants below carry those SAME canonical row texts, but each row
# set is DISCRIMINATED BY ITS SEMANTIC KIND in the variant name and typed
# fields — the free-form kind String of the old protocol is never semantic
# content (kind remains the ENVELOPE TAG only; QueryResults.keys stays the
# serialization/protocol carrier). Variant fields are the typed lifts of
# the canonical rows: single-row answers lift into the String fields
# (Symbol.row_text / MirFunction.summary_text), the effect row's
# "dirty-word;cap-ids" text splits into Effects.bits / Effects.caps, and
# the §33 slice's statement keys + external anchors ride
# MirSlice.statements / MirSlice.externals (the same two sorted lists the
# §22 MirSlice record — semantic_slice.tg — and its SliceResult source
# carry: SliceResult.statements / .external).
# RECORD-TYPED payloads (variants carrying SemanticSymbol / CallEdge / ...
# records instead of row texts) land once the query rows are
# record-carried — documented gap of this slice.
#
# Variant -> query-kind mapping (the accessors that build each variant):
#   Symbol       — symbol_get (the ONE matched def-key row; "" when absent)
#   Symbols      — symbol_search (the matched def-key rows)
#   Callers      — callers
#   Callees      — callees
#   Type         — types (kind_word = the nominal kind word row; rows = the
#                  same 0-1 canonical kind-word rows, lifted per the
#                  carrier doctrine)
#   Effects      — effects (bits = the dirty-class word, caps = the
#                  capability-id texts — the split of the canonical
#                  "dirty-word;cap-ids" effect row)
#   Capabilities — capabilities ("cap<id>|Requires|Provides" rows)
#   Ownership    — ownership_explain ("<fn key>|place|<conv>" rows)
#   MirFunction  — mir_function (the coarse MirSemanticSummary render; the
#                  raw def key when no summary row exists — the §38
#                  documented fallback)
#   MirSlice     — mir_slice (the §33 slice rows: statement keys + external
#                  anchors — the §38/§39 slot routes the typed engine over
#                  the session's final_mir; the program-less session keeps
#                  the empty MirSlice([], []) — kind
#                  "mir_slice_unavailable")
#   Contract     — contracts / contract_list (the §31 contract row keys)
#   Delta        — change_semantic_diff (changed = the modified-entity
#                  stable ids — the semantic_diff answer rows; rows = the
#                  delta's affected closure — the invalidation unit)
#   Abi          — abi_inspect (the ABI surface symmetric-difference rows)
# Every rows list is sorted (the §38 keys-list discipline). Ops whose
# answer rows belong to no enumerated family (the type-member probes
# fields / impls / properties / type_explain — pure index-membership row
# lists) and the service-op revision keep payload = None: their kind tag +
# keys stay the whole answer (documented in semantic_query.tg).
enum SemanticResponsePayload
  Symbol(row_text: String)
  Symbols(rows: Vec[String])
  Callers(rows: Vec[String])
  Callees(rows: Vec[String])
  Type(kind_word: String, rows: Vec[String])
  Effects(bits: Int, caps: Vec[String])
  Capabilities(rows: Vec[String])
  Ownership(rows: Vec[String])
  MirFunction(summary_text: String)
  MirSlice(statements: Vec[String], externals: Vec[String])
  Contract(rows: Vec[String])
  Delta(changed: Vec[String], rows: Vec[String])
  Abi(rows: Vec[String])
end

# ———————————————————————————————————————————————————————————————
# Deterministic ordering — stable digest order + the table sorts
# ———————————————————————————————————————————————————————————————
# Total order over the identity digests: hi word first, then lo word (UInt
# numeric order — no signed wrap), then the canonical key text. Tables sort
# by the identity of their subject/endpoint defs with semantic-discriminant
# tiebreaks, so the order is TOTAL and byte-deterministic: the snapshot
# writer sorts every table through these functions before rendering/hashing
# (the §29 snapshot-comparability contract).

# StableDigest word order: (hi, lo).
def semantic_digest_lt(a: StableDigest, b: StableDigest) -> Bool
  if a.hi != b.hi then
    a.hi < b.hi
  else
    a.lo < b.lo
  end
end

# StableDefId order: the identity digest words (digest_hi, digest_lo), then
# the canonical key text — the total-order tiebreak that keeps two distinct
# keys with equal digest words (detectable collisions) deterministically
# ordered instead of unstable.
def semantic_stable_def_id_lt(a: StableDefId, b: StableDefId) -> Bool
  if a.digest_hi != b.digest_hi then
    a.digest_hi < b.digest_hi
  elsif a.digest_lo != b.digest_lo then
    a.digest_lo < b.digest_lo
  else
    a.key < b.key
  end
end

# StableDigest of a StableDefId — the identity digest the table sorts ride
# (the ids.tg stable_def_id_digest projection).
def semantic_stable_def_id_digest(sid: StableDefId) -> StableDigest
  StableDigest { hi: sid.digest_hi, lo: sid.digest_lo }
end

# — the semantic discriminant flattenings (the serialized numeric
# projections the sort tiebreaks and the writer's text form use — the ids.tg
# finalizer_kind_numeric / intrinsic_id_numeric precedent; values are
# deterministic per enum DECLARATION order).

def semantic_type_kind_numeric(k: SemanticTypeKind) -> Int
  match k
  when SemanticTypeKind::Struct then 0
  when SemanticTypeKind::Enum then 1
  when SemanticTypeKind::Trait then 2
  end
end

# The call-row kind digit of the §31 call-row key grammar
# ("caller|callee|<digit>") — the ONE authority the delta's
# delta_call_row_key and semantic_edit.tg's call-site resolution share.
pub def semantic_call_edge_kind_numeric(k: CallEdgeKind) -> Int
  match k
  when CallEdgeKind::Direct then 0
  when CallEdgeKind::Indirect then 1
  when CallEdgeKind::Intrinsic then 2
  end
end

def semantic_capability_edge_kind_numeric(k: CapabilityEdgeKind) -> Int
  match k
  when CapabilityEdgeKind::Requires then 0
  when CapabilityEdgeKind::Provides then 1
  end
end

# AccessConvention (ast.tg) discriminant — declaration order Let / Inout /
# Sink / Set.
def semantic_access_convention_numeric(c: AccessConvention) -> Int
  match c
  when AccessConvention::Let then 0
  when AccessConvention::Inout then 1
  when AccessConvention::Sink then 2
  when AccessConvention::Set then 3
  end
end

# AstContractKind (ast.tg) discriminant — declaration order AstPre /
# AstPost / AstInvariant.
def semantic_contract_kind_numeric(k: AstContractKind) -> Int
  match k
  when AstContractKind::AstPre then 0
  when AstContractKind::AstPost then 1
  when AstContractKind::AstInvariant then 2
  end
end

# The DefKind (ids.tg) discriminant text — the resolver's kind vocabulary
# has no numeric flattening today; the text is deterministic and
# self-documenting (used ONLY as the duplicate-identity tiebreak below; the
# primary order is always the stable digest).
def semantic_def_kind_text(k: DefKind) -> String
  match k
  when DefKind::Function then "Function"
  when DefKind::Method then "Method"
  when DefKind::Static then "Static"
  when DefKind::Constant then "Constant"
  when DefKind::EnumVariant then "EnumVariant"
  when DefKind::StructField then "StructField"
  when DefKind::Intrinsic then "Intrinsic"
  when DefKind::TypeName then "TypeName"
  when DefKind::Trait then "Trait"
  when DefKind::Other then "Other"
  end
end

# Option[String] order: None sorts before Some; Some compares textually.
def semantic_option_string_cmp(a: Option[String], b: Option[String]) -> Int
  match a
  when Option::Some(av) then
    match b
    when Option::Some(bv) then
      if av < bv then
        -1
      elsif bv < av then
        1
      else
        0
      end
    when Option::None then 1
    end
  when Option::None then
    match b
    when Option::Some(_) then -1
    when Option::None then 0
    end
  end
end

# Closure-free stable row sorts for the bootstrap subset (the subset has
# no closure expressions — a closure comparator argument is rejected by
# E9040).
# The ascending insertion pass is the same algorithm as linker.tg's
# existing non-closure candidate sort; the semantic modules share it for
# their text and integer row lists. Insertion sort is stable: equal rows
# keep their input order.
def semantic_strings_sort(inout rows: Vec[String]) -> Unit
  var i = 1
  while i < rows.len() do
    let current = rows[i].clone()
    var j = i
    while j > 0 && rows[j - 1] > current do
      rows[j] = rows[j - 1].clone()
      j = j - 1
    end
    rows[j] = current
    i = i + 1
  end
end

def semantic_ints_sort(inout rows: Vec[Int]) -> Unit
  var i = 1
  while i < rows.len() do
    let current = rows[i]
    var j = i
    while j > 0 && rows[j - 1] > current do
      rows[j] = rows[j - 1]
      j = j - 1
    end
    rows[j] = current
    i = i + 1
  end
end

# SemanticSymbol order: the stable identity digest, then the canonical key
# text (semantic_stable_def_id_lt covers both), then — for duplicate-key rows
# only — the kind text and the name.
def semantic_symbol_lt(a: SemanticSymbol, b: SemanticSymbol) -> Bool
  if semantic_stable_def_id_lt(&a.stable_id, &b.stable_id) then
    true
  elsif semantic_stable_def_id_lt(&b.stable_id, &a.stable_id) then
    false
  elsif semantic_def_kind_text(&a.kind) != semantic_def_kind_text(&b.kind) then
    semantic_def_kind_text(&a.kind) < semantic_def_kind_text(&b.kind)
  else
    a.name < b.name
  end
end

# Sort the symbol table in place (the cqs.tg sort_signals convention).
def semantic_symbols_sort(inout symbols: Vec[SemanticSymbol]) -> Unit
  var i = 1
  while i < symbols.len() do
    let current = symbols[i].clone()
    var j = i
    while j > 0 && semantic_symbol_lt(&symbols[j - 1], &current) do
      symbols[j] = symbols[j - 1].clone()
      j = j - 1
    end
    symbols[j] = current
    i = i + 1
  end
end

# SemanticType order: the identity digest, then the kind discriminant, then
# the name (duplicate-key rows only).
def semantic_type_lt(a: SemanticType, b: SemanticType) -> Bool
  if semantic_stable_def_id_lt(&a.stable_id, &b.stable_id) then
    true
  elsif semantic_stable_def_id_lt(&b.stable_id, &a.stable_id) then
    false
  elsif semantic_type_kind_numeric(&a.kind) != semantic_type_kind_numeric(&b.kind) then
    semantic_type_kind_numeric(&a.kind) < semantic_type_kind_numeric(&b.kind)
  else
    a.name < b.name
  end
end

def semantic_types_sort(inout types: Vec[SemanticType]) -> Unit
  var i = 1
  while i < types.len() do
    let current = types[i].clone()
    var j = i
    while j > 0 && semantic_type_lt(&types[j - 1], &current) do
      types[j] = types[j - 1].clone()
      j = j - 1
    end
    types[j] = current
    i = i + 1
  end
end

# CallEdge order: caller digest, then callee digest, then the kind
# discriminant.
def semantic_call_edge_lt(a: CallEdge, b: CallEdge) -> Bool
  if semantic_stable_def_id_lt(&a.caller, &b.caller) then
    true
  elsif semantic_stable_def_id_lt(&b.caller, &a.caller) then
    false
  elsif semantic_stable_def_id_lt(&a.callee, &b.callee) then
    true
  elsif semantic_stable_def_id_lt(&b.callee, &a.callee) then
    false
  elsif semantic_call_edge_kind_numeric(&a.kind) != semantic_call_edge_kind_numeric(&b.kind) then
    semantic_call_edge_kind_numeric(&a.kind) < semantic_call_edge_kind_numeric(&b.kind)
  else
    false
  end
end

def semantic_call_edges_sort(inout calls: Vec[CallEdge]) -> Unit
  var i = 1
  while i < calls.len() do
    let current = calls[i].clone()
    var j = i
    while j > 0 && semantic_call_edge_lt(&calls[j - 1], &current) do
      calls[j] = calls[j - 1].clone()
      j = j - 1
    end
    calls[j] = current
    i = i + 1
  end
end

# IndirectCallEdge order: caller text, then the site text, then the
# signature, then the completeness word, then the joined candidate text
# (total order — the row is textual by design).
def semantic_indirect_call_edge_lt(a: IndirectCallEdge, b: IndirectCallEdge) -> Bool
  if a.caller != b.caller then
    a.caller < b.caller
  elsif a.site != b.site then
    a.site < b.site
  elsif a.signature != b.signature then
    a.signature < b.signature
  elsif a.completeness != b.completeness then
    a.completeness < b.completeness
  else
    a.candidates.join(",") < b.candidates.join(",")
  end
end

def semantic_indirect_call_edges_sort(inout indirect_calls: Vec[IndirectCallEdge]) -> Unit
  var i = 1
  while i < indirect_calls.len() do
    let current = indirect_calls[i].clone()
    var j = i
    while j > 0 && semantic_indirect_call_edge_lt(&indirect_calls[j - 1], &current) do
      indirect_calls[j] = indirect_calls[j - 1].clone()
      j = j - 1
    end
    indirect_calls[j] = current
    i = i + 1
  end
end

# EffectEdge order: subject-function digest, then the summary's dirty-class
# projection (the may_* flags packed deterministically in the §11 field
# order — the writer's text form carries the same projection). Identical
# rows (same function, same flags) are textually identical whatever their
# relative order, so the comparator ends at false.
def semantic_effect_edge_lt(a: EffectEdge, b: EffectEdge) -> Bool
  if semantic_stable_def_id_lt(&a.function, &b.function) then
    true
  elsif semantic_stable_def_id_lt(&b.function, &a.function) then
    false
  elsif semantic_summary_dirty_word(&a.summary) != semantic_summary_dirty_word(&b.summary) then
    semantic_summary_dirty_word(&a.summary) < semantic_summary_dirty_word(&b.summary)
  else
    false
  end
end

# The deterministic 7-bit dirty-class projection of an EffectSummary: the
# may_* flags in the §11 declaration order (allocate=1, block=2, io=4,
# spawn=8, sleep=16, panic=32, unsafe=64). A summary is never ordered by
# span or by capability-set iteration order.
def semantic_summary_dirty_word(s: EffectSummary) -> Int
  var w = 0
  if s.may_allocate then w = w + 1 end
  if s.may_block then w = w + 2 end
  if s.may_io then w = w + 4 end
  if s.may_spawn then w = w + 8 end
  if s.may_sleep then w = w + 16 end
  if s.may_panic then w = w + 32 end
  if s.may_unsafe then w = w + 64 end
  w
end

def semantic_effect_edges_sort(inout effects: Vec[EffectEdge]) -> Unit
  var i = 1
  while i < effects.len() do
    let current = effects[i].clone()
    var j = i
    while j > 0 && semantic_effect_edge_lt(&effects[j - 1], &current) do
      effects[j] = effects[j - 1].clone()
      j = j - 1
    end
    effects[j] = current
    i = i + 1
  end
end

# CapabilityEdge order: function digest, then the capability id, then the
# edge-kind discriminant.
def semantic_capability_edge_lt(a: CapabilityEdge, b: CapabilityEdge) -> Bool
  if semantic_stable_def_id_lt(&a.function, &b.function) then
    true
  elsif semantic_stable_def_id_lt(&b.function, &a.function) then
    false
  elsif a.capability.id != b.capability.id then
    a.capability.id < b.capability.id
  elsif semantic_capability_edge_kind_numeric(&a.kind) != semantic_capability_edge_kind_numeric(&b.kind) then
    semantic_capability_edge_kind_numeric(&a.kind) < semantic_capability_edge_kind_numeric(&b.kind)
  else
    false
  end
end

def semantic_capability_edges_sort(inout capabilities: Vec[CapabilityEdge]) -> Unit
  var i = 1
  while i < capabilities.len() do
    let current = capabilities[i].clone()
    var j = i
    while j > 0 && semantic_capability_edge_lt(&capabilities[j - 1], &current) do
      capabilities[j] = capabilities[j - 1].clone()
      j = j - 1
    end
    capabilities[j] = current
    i = i + 1
  end
end

# OwnershipFact order: function digest, then the canonical place-key text,
# then the convention discriminant.
def semantic_ownership_fact_lt(a: OwnershipFact, b: OwnershipFact) -> Bool
  if semantic_stable_def_id_lt(&a.function, &b.function) then
    true
  elsif semantic_stable_def_id_lt(&b.function, &a.function) then
    false
  elsif a.place_key != b.place_key then
    a.place_key < b.place_key
  elsif semantic_access_convention_numeric(&a.convention) != semantic_access_convention_numeric(&b.convention) then
    semantic_access_convention_numeric(&a.convention) < semantic_access_convention_numeric(&b.convention)
  else
    false
  end
end

def semantic_ownership_facts_sort(inout ownership: Vec[OwnershipFact]) -> Unit
  var i = 1
  while i < ownership.len() do
    let current = ownership[i].clone()
    var j = i
    while j > 0 && semantic_ownership_fact_lt(&ownership[j - 1], &current) do
      ownership[j] = ownership[j - 1].clone()
      j = j - 1
    end
    ownership[j] = current
    i = i + 1
  end
end

# ContractFact order: function digest, then the kind discriminant, then the
# canonical clause text (the row's content-delta identity — the flattened
# canonical expression; semantic text movement never moves a row), then the
# declared message (identical-row tiebreak only).
def semantic_contract_fact_lt(a: ContractFact, b: ContractFact) -> Bool
  if semantic_stable_def_id_lt(&a.function, &b.function) then
    true
  elsif semantic_stable_def_id_lt(&b.function, &a.function) then
    false
  elsif semantic_contract_kind_numeric(&a.kind) != semantic_contract_kind_numeric(&b.kind) then
    semantic_contract_kind_numeric(&a.kind) < semantic_contract_kind_numeric(&b.kind)
  else
    let atext = semantic_contract_expr_text(&a.canonical_expression)
    let btext = semantic_contract_expr_text(&b.canonical_expression)
    if atext != btext then
      atext < btext
    else
      semantic_option_string_cmp(&a.message, &b.message) < 0
    end
  end
end

def semantic_contract_facts_sort(inout contracts: Vec[ContractFact]) -> Unit
  var i = 1
  while i < contracts.len() do
    let current = contracts[i].clone()
    var j = i
    while j > 0 && semantic_contract_fact_lt(&contracts[j - 1], &current) do
      contracts[j] = contracts[j - 1].clone()
      j = j - 1
    end
    contracts[j] = current
    i = i + 1
  end
end

# TestRelationship order: the test digest, then the target digest.
def semantic_test_relationship_lt(a: TestRelationship, b: TestRelationship) -> Bool
  if semantic_stable_def_id_lt(&a.test, &b.test) then
    true
  elsif semantic_stable_def_id_lt(&b.test, &a.test) then
    false
  else
    semantic_stable_def_id_lt(&a.target, &b.target)
  end
end

def semantic_test_relationships_sort(inout tests: Vec[TestRelationship]) -> Unit
  var i = 1
  while i < tests.len() do
    let current = tests[i].clone()
    var j = i
    while j > 0 && semantic_test_relationship_lt(&tests[j - 1], &current) do
      tests[j] = tests[j - 1].clone()
      j = j - 1
    end
    tests[j] = current
    i = i + 1
  end
end

# CoverageRelationship order: function digest, then the branch-id text, then
# the arm id, then the kind text, then the test-id text (the test-endpoint
# tiebreak keeps rows of one (function, branch, arm, kind) deterministic
# when an ingest records several exercising tests for one point).
def semantic_coverage_relationship_lt(a: CoverageRelationship, b: CoverageRelationship) -> Bool
  if semantic_stable_def_id_lt(&a.function, &b.function) then
    true
  elsif semantic_stable_def_id_lt(&b.function, &a.function) then
    false
  elsif a.branch_id != b.branch_id then
    a.branch_id < b.branch_id
  elsif semantic_option_string_cmp(&a.arm_id, &b.arm_id) != 0 then
    semantic_option_string_cmp(&a.arm_id, &b.arm_id) < 0
  elsif a.kind != b.kind then
    a.kind < b.kind
  else
    a.test_id < b.test_id
  end
end

def semantic_coverage_relationships_sort(inout coverage: Vec[CoverageRelationship]) -> Unit
  var i = 1
  while i < coverage.len() do
    let current = coverage[i].clone()
    var j = i
    while j > 0 && semantic_coverage_relationship_lt(&coverage[j - 1], &current) do
      coverage[j] = coverage[j - 1].clone()
      j = j - 1
    end
    coverage[j] = current
    i = i + 1
  end
end

# MirSemanticSummary order: the function digest (one summary per function;
# duplicate rows tiebreak by block count so the order stays total).
def semantic_mir_summary_lt(a: MirSemanticSummary, b: MirSemanticSummary) -> Bool
  if semantic_stable_def_id_lt(&a.function, &b.function) then
    true
  elsif semantic_stable_def_id_lt(&b.function, &a.function) then
    false
  else
    a.block_count < b.block_count
  end
end

def semantic_mir_summaries_sort(inout mir_functions: Vec[MirSemanticSummary]) -> Unit
  var i = 1
  while i < mir_functions.len() do
    let current = mir_functions[i].clone()
    var j = i
    while j > 0 && semantic_mir_summary_lt(&mir_functions[j - 1], &current) do
      mir_functions[j] = mir_functions[j - 1].clone()
      j = j - 1
    end
    mir_functions[j] = current
    i = i + 1
  end
end

# UnsafeFact order: the fact's digest words (hi, lo — the content
# identity), then the function key text, then the kind discriminant, then
# the site text (identical-word duplicates — detectable collisions — stay
# deterministically ordered; a duplicate fact row is content-identical
# and the sort is only its total-order tiebreak).
def semantic_unsafe_fact_lt(a: UnsafeFact, b: UnsafeFact) -> Bool
  if a.digest_hi != b.digest_hi then
    a.digest_hi < b.digest_hi
  elsif a.digest_lo != b.digest_lo then
    a.digest_lo < b.digest_lo
  elsif a.function != b.function then
    a.function < b.function
  elsif semantic_unsafe_kind_numeric(&a.kind) != semantic_unsafe_kind_numeric(&b.kind) then
    semantic_unsafe_kind_numeric(&a.kind) < semantic_unsafe_kind_numeric(&b.kind)
  else
    a.site < b.site
  end
end

def semantic_unsafe_facts_sort(inout unsafe_facts: Vec[UnsafeFact]) -> Unit
  var i = 1
  while i < unsafe_facts.len() do
    let current = unsafe_facts[i].clone()
    var j = i
    while j > 0 && semantic_unsafe_fact_lt(&unsafe_facts[j - 1], &current) do
      unsafe_facts[j] = unsafe_facts[j - 1].clone()
      j = j - 1
    end
    unsafe_facts[j] = current
    i = i + 1
  end
end

# (fourth-audit P0-17) DropPlanFact order: the function key, the place
# text, the drop-site text, the kind word, then the conditional paths —
# the total order over the row (identical field tuples are the same row
# and end in false), so the writer's render is byte-deterministic whatever
# the producer's emission order.
def semantic_drop_plan_fact_lt(a: DropPlanFact, b: DropPlanFact) -> Bool
  if a.function != b.function then
    a.function < b.function
  elsif a.place != b.place then
    a.place < b.place
  elsif a.drop_site != b.drop_site then
    a.drop_site < b.drop_site
  elsif a.kind != b.kind then
    a.kind < b.kind
  else
    a.conditional_paths.join(",") < b.conditional_paths.join(",")
  end
end

def semantic_drop_plans_sort(inout drop_plans: Vec[DropPlanFact]) -> Unit
  var i = 1
  while i < drop_plans.len() do
    let current = drop_plans[i].clone()
    var j = i
    while j > 0 && semantic_drop_plan_fact_lt(&drop_plans[j - 1], &current) do
      drop_plans[j] = drop_plans[j - 1].clone()
      j = j - 1
    end
    drop_plans[j] = current
    i = i + 1
  end
end

# The (function, place) key of a drop-plan fact — the §31 diff's row key
# (the typed identity the DropPlanDelta rows carry).
def semantic_drop_plan_fact_key(f: DropPlanFact) -> String
  f.function.clone() + "|" + f.place.clone()
end

# Whether two facts describe the SAME site record (site + conditions +
# kind; the function/place key is compared separately by the diff). Used
# by the snapshot round-trip and the delta's per-place site-set compare.
def semantic_drop_plan_fact_sites_equal(a: DropPlanFact, b: DropPlanFact) -> Bool
  a.drop_site == b.drop_site && a.kind == b.kind &&
    a.conditional_paths.join(",") == b.conditional_paths.join(",")
end

# The canonical text of one drop-plan fact — the per-domain digest row
# grammar: "<function>|<place>|<site>|<kind>|<paths>".
def semantic_drop_plan_fact_text(f: DropPlanFact) -> String
  f.function.clone() + "|" + f.place.clone() + "|" + f.drop_site.clone() +
    "|" + f.kind.clone() + "|" + f.conditional_paths.join(",")
end

# ———————————————————————————————————————————————————————————————
# The TYPED member/signature tables (fourth-audit P1-3)
# ———————————————————————————————————————————————————————————————
# The snapshot's typed projection of the program's declared MEMBERS and
# SIGNATURES. Every record below is emitted at snapshot build from TYPED
# finalized state (env.type_list fields/variants/methods, the checker's
# typed FnSignature records) — a consumer decides by typed membership,
# never by parsing a "struct{...}"/"enum{...}"/"fn(...)" render out of a
# canonical key. The owner fields are the owning declaration's StableDefId
# (the row identity domain of the symbols/types tables); member_id is the
# member-lineage identity text of the durable member-lineage domain
# (stable_ids.tg stable_member_synthetic_lineage +
# stable_member_lineage_identity_text — the documented name-derived
# fallback until the store-backed member stamping is threaded here).
#
# SemanticParam — one parameter/payload-position shape: the convention
#                 (the ast.tg AccessConvention vocabulary), the canonical
#                 typed type text and the declared name ("" where the
#                 typed source carries none, e.g. FnSignature.params).
struct SemanticParam
  convention: AccessConvention = AccessConvention::Let
  ty: String
  name: String = ""
end

# SemanticField — one declared STRUCT field.
struct SemanticField
  owner: StableDefId       # the owning nominal type declaration
  name: String             # declared name, verbatim (delimiters are content)
  index: Int               # declaration position — a snapshot locator
  ty: String               # canonical typed field-type text
  member_id: String = ""   # member-lineage identity text
  is_pub: Bool = false
end

# SemanticVariant — one ENUM variant with its payload shape (positional
# SemanticParam rows; the convention is Let — enum payloads are moved).
struct SemanticVariant
  owner: StableDefId
  name: String
  index: Int               # declaration position — the discriminant order
  payload: Vec[SemanticParam] = Vec::new()
  member_id: String = ""
end

# SemanticCallableSignature — one function/method's typed signature:
# params (typed conventions), the canonical return type text, the declared
# effect-id texts (sorted; the "effects(...)" suffix's typed content) and
# the C-variadic marker. The row is the signature plan's source of truth.
struct SemanticCallableSignature
  function: StableDefId
  params: Vec[SemanticParam] = Vec::new()
  ret_type: String = ""
  declared_effects: Vec[String] = Vec::new()
  variadic: Bool = false
end

# SemanticTraitMethod — one declared trait method: name, declaration
# position, typed params/return and the member-lineage identity text.
struct SemanticTraitMethod
  owner: StableDefId       # the trait declaration
  name: String
  index: Int
  params: Vec[SemanticParam] = Vec::new()
  ret_type: String = ""
  member_id: String = ""
end

# ———————————————————————————————————————————————————————————————
# SemanticConcreteType — one concrete type instance (fourth-audit P1-5b)
# ———————————————————————————————————————————————————————————————
# One Type::Adt(tid, args) instance the canonical instance sources reach.
#   instance_key  — the canonical concrete-instance identity text: the
#                   template's full stable key + "<" + the canonical arg
#                   texts (comma-joined) + ">" (deterministic and stable;
#                   never a per-compilation TypeId).
#   template      — the template type declaration's full stable key.
#   args          — the canonical arg texts in declared order.
#   size/alignment — the layout summary from layout_of_concrete (-1 when
#                   the layout was unavailable; never a guess).
#   fields        — the layout's "name offset size" field rows (empty on
#                   failure).
#   layout_status — "ok" | "layout-fail:<class-word>" | "unavailable"
#                   (the documented reachability boundary).
struct SemanticConcreteType
  instance_key: String
  template: String
  args: Vec[String] = Vec::new()
  size: Int = -1
  alignment: Int = -1
  fields: Vec[String] = Vec::new()
  layout_status: String = "unavailable"
end

# ———————————————————————————————————————————————————————————————
# SemanticAllocationSite — one allocating MIR node (fourth-audit P1-5c)
# ———————————————————————————————————————————————————————————————
# size_kind is the budget classification's size vocabulary:
#   Exact      — a statically known byte count (size carries it)
#   UpperBound — the documented conservative per-site cap (size carries it)
#   Unbounded  — a runtime-sized allocation (string concat / effect perform;
#                size is -1 — the size is not computable from the row)
#   Unknown    — the site's behavior is fail-closed unknown (size is -1)
enum SemanticAllocationSizeKind
  Exact
  UpperBound
  Unbounded
  Unknown
end

#   function — the owning lowered body's mir row key text (the SAME text
#              the mir_functions/allocation-origin rows carry).
#   site     — the §33 node key of the allocating node: a STATEMENT site
#              "<fn key>#B<block>#S<idx>" or a TERMINATOR site
#              "<fn key>#B<block>#T" (the stable_ids StableAllocationSiteId
#              stable_key grammar).
struct SemanticAllocationSite
  function: String
  site: String
  size_kind: SemanticAllocationSizeKind
  size: Int = -1
end

# The canonical word of an allocation size kind.
def semantic_allocation_size_kind_text(k: SemanticAllocationSizeKind) -> String
  match k
  when SemanticAllocationSizeKind::Exact then "Exact"
  when SemanticAllocationSizeKind::UpperBound then "UpperBound"
  when SemanticAllocationSizeKind::Unbounded then "Unbounded"
  when SemanticAllocationSizeKind::Unknown then "Unknown"
  end
end

def semantic_allocation_size_kind_numeric(k: SemanticAllocationSizeKind) -> Int
  match k
  when SemanticAllocationSizeKind::Exact then 0
  when SemanticAllocationSizeKind::UpperBound then 1
  when SemanticAllocationSizeKind::Unbounded then 2
  when SemanticAllocationSizeKind::Unknown then 3
  end
end

# The canonical "conv:ty" render of a typed parameter — the output
# projection the plans and deltas carry (decisions are typed membership;
# this render is report text only).
def semantic_param_text(p: SemanticParam) -> String
  match p.convention
  when AccessConvention::Let then "let:" + p.ty.clone()
  when AccessConvention::Inout then "inout:" + p.ty.clone()
  when AccessConvention::Sink then "sink:" + p.ty.clone()
  when AccessConvention::Set then "set:" + p.ty.clone()
  end
end

def semantic_params_text(params: Vec[SemanticParam]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  for p in params do
    out.push(semantic_param_text(&p))
  end
  out
end

# The canonical payload-shape text of a variant (the typed payload fields'
# name/type rows joined deterministically) — the modified-variant signal.
def semantic_variant_payload_text(v: SemanticVariant) -> String
  var parts: Vec[String] = Vec::new()
  for p in v.payload do
    parts.push(p.name.clone() + ":" + p.ty.clone())
  end
  parts.join(",")
end

# ————— the table orders (stable-digest order, then canonical tiebreaks) —————

def semantic_field_lt(a: SemanticField, b: SemanticField) -> Bool
  if semantic_stable_def_id_lt(&a.owner, &b.owner) then
    true
  elsif semantic_stable_def_id_lt(&b.owner, &a.owner) then
    false
  elsif a.index != b.index then
    a.index < b.index
  else
    a.name < b.name
  end
end

def semantic_fields_sort(inout fields: Vec[SemanticField]) -> Unit
  var i = 1
  while i < fields.len() do
    let current = fields[i].clone()
    var j = i
    while j > 0 && semantic_field_lt(&fields[j - 1], &current) do
      fields[j] = fields[j - 1].clone()
      j = j - 1
    end
    fields[j] = current
    i = i + 1
  end
end

def semantic_variant_lt(a: SemanticVariant, b: SemanticVariant) -> Bool
  if semantic_stable_def_id_lt(&a.owner, &b.owner) then
    true
  elsif semantic_stable_def_id_lt(&b.owner, &a.owner) then
    false
  elsif a.index != b.index then
    a.index < b.index
  else
    a.name < b.name
  end
end

def semantic_variants_sort(inout variants: Vec[SemanticVariant]) -> Unit
  var i = 1
  while i < variants.len() do
    let current = variants[i].clone()
    var j = i
    while j > 0 && semantic_variant_lt(&variants[j - 1], &current) do
      variants[j] = variants[j - 1].clone()
      j = j - 1
    end
    variants[j] = current
    i = i + 1
  end
end

def semantic_callable_signature_lt(a: SemanticCallableSignature, b: SemanticCallableSignature) -> Bool
  semantic_stable_def_id_lt(&a.function, &b.function)
end

def semantic_callable_signatures_sort(inout signatures: Vec[SemanticCallableSignature]) -> Unit
  var i = 1
  while i < signatures.len() do
    let current = signatures[i].clone()
    var j = i
    while j > 0 && semantic_callable_signature_lt(&signatures[j - 1], &current) do
      signatures[j] = signatures[j - 1].clone()
      j = j - 1
    end
    signatures[j] = current
    i = i + 1
  end
end

def semantic_trait_method_lt(a: SemanticTraitMethod, b: SemanticTraitMethod) -> Bool
  if semantic_stable_def_id_lt(&a.owner, &b.owner) then
    true
  elsif semantic_stable_def_id_lt(&b.owner, &a.owner) then
    false
  elsif a.index != b.index then
    a.index < b.index
  else
    a.name < b.name
  end
end

def semantic_trait_methods_sort(inout methods: Vec[SemanticTraitMethod]) -> Unit
  var i = 1
  while i < methods.len() do
    let current = methods[i].clone()
    var j = i
    while j > 0 && semantic_trait_method_lt(&methods[j - 1], &current) do
      methods[j] = methods[j - 1].clone()
      j = j - 1
    end
    methods[j] = current
    i = i + 1
  end
end

def semantic_concrete_type_lt(a: SemanticConcreteType, b: SemanticConcreteType) -> Bool
  if a.instance_key != b.instance_key then
    a.instance_key < b.instance_key
  else
    a.template < b.template
  end
end

def semantic_concrete_types_sort(inout types: Vec[SemanticConcreteType]) -> Unit
  var i = 1
  while i < types.len() do
    let current = types[i].clone()
    var j = i
    while j > 0 && semantic_concrete_type_lt(&types[j - 1], &current) do
      types[j] = types[j - 1].clone()
      j = j - 1
    end
    types[j] = current
    i = i + 1
  end
end

def semantic_allocation_site_lt(a: SemanticAllocationSite, b: SemanticAllocationSite) -> Bool
  if a.function != b.function then
    a.function < b.function
  elsif a.site != b.site then
    a.site < b.site
  elsif semantic_allocation_size_kind_numeric(&a.size_kind) != semantic_allocation_size_kind_numeric(&b.size_kind) then
    semantic_allocation_size_kind_numeric(&a.size_kind) < semantic_allocation_size_kind_numeric(&b.size_kind)
  else
    a.size < b.size
  end
end

def semantic_allocation_sites_sort(inout sites: Vec[SemanticAllocationSite]) -> Unit
  var i = 1
  while i < sites.len() do
    let current = sites[i].clone()
    var j = i
    while j > 0 && semantic_allocation_site_lt(&sites[j - 1], &current) do
      sites[j] = sites[j - 1].clone()
      j = j - 1
    end
    sites[j] = current
    i = i + 1
  end
end

# The canonical text of one allocation site — the per-domain digest row
# grammar: "<function>|<site>|<kind-word>|<size>".
def semantic_allocation_site_text(s: SemanticAllocationSite) -> String
  s.function.clone() + "|" + s.site.clone() + "|" +
    semantic_allocation_size_kind_text(&s.size_kind) + "|" + s.size.to_string()
end

# The canonical text of one concrete-type row — the per-domain digest row
# grammar: "<instance-key>|<template>|<args>|<size>|<align>|<status>|<fields>".
def semantic_concrete_type_text(c: SemanticConcreteType) -> String
  c.instance_key.clone() + "|" + c.template.clone() + "|" +
    c.args.join(",") + "|" + c.size.to_string() + "|" + c.alignment.to_string() +
    "|" + c.layout_status.clone() + "|" + c.fields.join(";")
end


# AbiSurfaceRow order: the surface id (the delta join key — unique per row
# by construction), then the kind word, then the symbol key text (the
# tiebreaks keep the order total under a duplicate surface id).
def semantic_abi_surface_lt(a: AbiSurfaceRow, b: AbiSurfaceRow) -> Bool
  if a.surface_id != b.surface_id then
    a.surface_id < b.surface_id
  elsif a.kind != b.kind then
    a.kind < b.kind
  else
    a.symbol_key < b.symbol_key
  end
end

def semantic_abi_surfaces_sort(inout abi_surfaces: Vec[AbiSurfaceRow]) -> Unit
  var i = 1
  while i < abi_surfaces.len() do
    let current = abi_surfaces[i].clone()
    var j = i
    while j > 0 && semantic_abi_surface_lt(&abi_surfaces[j - 1], &current) do
      abi_surfaces[j] = abi_surfaces[j - 1].clone()
      j = j - 1
    end
    abi_surfaces[j] = current
    i = i + 1
  end
end

# — the typed dependency-graph edge orders (third-audit item 18): each is
# the lexicographic order of the record's fields, a TOTAL order over the
# row (identical field tuples are the same row and end in false), so the
# writer's render is byte-deterministic whatever the producer's emission
# order.

def semantic_type_use_edge_lt(a: TypeUseEdge, b: TypeUseEdge) -> Bool
  if a.user != b.user then
    a.user < b.user
  else
    a.used_type < b.used_type
  end
end

def semantic_type_use_edges_sort(inout edges: Vec[TypeUseEdge]) -> Unit
  var i = 1
  while i < edges.len() do
    let current = edges[i].clone()
    var j = i
    while j > 0 && semantic_type_use_edge_lt(&edges[j - 1], &current) do
      edges[j] = edges[j - 1].clone()
      j = j - 1
    end
    edges[j] = current
    i = i + 1
  end
end

def semantic_trait_impl_edge_lt(a: TraitImplEdge, b: TraitImplEdge) -> Bool
  if a.impl_key != b.impl_key then
    a.impl_key < b.impl_key
  elsif a.trait_key != b.trait_key then
    a.trait_key < b.trait_key
  else
    a.self_type < b.self_type
  end
end

def semantic_trait_impl_edges_sort(inout edges: Vec[TraitImplEdge]) -> Unit
  var i = 1
  while i < edges.len() do
    let current = edges[i].clone()
    var j = i
    while j > 0 && semantic_trait_impl_edge_lt(&edges[j - 1], &current) do
      edges[j] = edges[j - 1].clone()
      j = j - 1
    end
    edges[j] = current
    i = i + 1
  end
end

def semantic_trait_selection_edge_lt(a: TraitSelectionEdge, b: TraitSelectionEdge) -> Bool
  if a.function != b.function then
    a.function < b.function
  elsif a.trait_key != b.trait_key then
    a.trait_key < b.trait_key
  else
    a.impl_key < b.impl_key
  end
end

def semantic_trait_selection_edges_sort(inout edges: Vec[TraitSelectionEdge]) -> Unit
  var i = 1
  while i < edges.len() do
    let current = edges[i].clone()
    var j = i
    while j > 0 && semantic_trait_selection_edge_lt(&edges[j - 1], &current) do
      edges[j] = edges[j - 1].clone()
      j = j - 1
    end
    edges[j] = current
    i = i + 1
  end
end

def semantic_generic_instantiation_edge_lt(a: GenericInstantiationEdge, b: GenericInstantiationEdge) -> Bool
  if a.instance_key != b.instance_key then
    a.instance_key < b.instance_key
  else
    a.template < b.template
  end
end

def semantic_generic_instantiation_edges_sort(inout edges: Vec[GenericInstantiationEdge]) -> Unit
  var i = 1
  while i < edges.len() do
    let current = edges[i].clone()
    var j = i
    while j > 0 && semantic_generic_instantiation_edge_lt(&edges[j - 1], &current) do
      edges[j] = edges[j - 1].clone()
      j = j - 1
    end
    edges[j] = current
    i = i + 1
  end
end

def semantic_layout_dependency_edge_lt(a: LayoutDependencyEdge, b: LayoutDependencyEdge) -> Bool
  if a.dependent_type != b.dependent_type then
    a.dependent_type < b.dependent_type
  else
    a.source_type < b.source_type
  end
end

def semantic_layout_dependency_edges_sort(inout edges: Vec[LayoutDependencyEdge]) -> Unit
