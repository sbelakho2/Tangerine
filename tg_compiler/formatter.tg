# Tangerine Compiler — AST-Based Code Formatter
#
# Provides configurable, canonical formatting for Tangerine source code.
# Uses the AST for structure-aware formatting rather than simple text manipulation.
#
# Supports:
# - Configurable indentation (spaces/tabs, width)
# - Maximum line width with intelligent wrapping
# - Consistent spacing around operators
# - Blank line normalization between items
# - Trailing comma policy
# - Alignment options
# - stdin/stdout mode for piping
# - Check mode (no writes, just report)

use std::core::{Option, Result, Vec, String, Bool, UInt}
use std::collections::{Map}
use std::fs::{read_file, write_file}
use std::io::{print, println, eprintln}

use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse, diag_has_errors}
use tg_compiler::ast::{Program, Item, ItemKind, Expr, ExprKind, Stmt, StmtKind,
                        FunctionDecl, FnBody, FunctionSig, Param, ParamTypeExpr, TypeExpr, TypeExprKind,
                        Pattern, PatternKind, MatchArm, MatchExpr, IfStmt, ForStmt, CatchArm,
                        Block, ClosureParam, GuardElse,
                        Visibility, Attribute, GenericParam, AccessConvention, BinOp, UnOp,
                        StructDecl, EnumDecl, TraitDecl, TraitMethod, AssocType, FieldDecl,
                        VariantDecl, WherePredicate,
                        ImplDecl, AssocTypeImpl, ConstDecl, StaticDecl,
                        ModuleDecl, UseDecl, TypeAliasDecl, ExternBlock,
                        ExternItem, ExternFn, ExternStatic,
                        MacroDecl, CapabilityDecl, EffectDecl, RationaleBlock, EditionDecl,
                        NominalKind, EffectHandler, HandlerArm,
                        make_block, make_stmt, make_expr}
use tg_compiler::token::{Token, TokenKind, Span, parsed_int_spelling, parsed_float_spelling}

# ———————————————————————————————————————————————————————————————
# Configuration
# ———————————————————————————————————————————————————————————————

struct FormatConfig
  indent_width: UInt          # Spaces per indent level (default: 2)
  use_tabs: Bool              # Use tabs instead of spaces
  max_line_width: UInt        # Maximum line width (default: 100)
  trailing_comma: TrailingComma  # Trailing comma policy
  blank_lines_between_items: UInt  # Blank lines between top-level items
  blank_lines_between_methods: UInt  # Blank lines between methods in impl/trait
  spaces_around_binary_ops: Bool  # Spaces around binary operators
  spaces_after_comma: Bool    # Space after commas
  space_before_colon: Bool    # Space before colon in type annotations
  space_after_colon: Bool     # Space after colon in type annotations
  align_struct_fields: Bool   # Align struct field types
  align_match_arms: Bool      # Align match arm bodies
  newline_before_end: Bool    # Newline before `end` keyword
  remove_trailing_whitespace: Bool  # Strip trailing whitespace
  ensure_final_newline: Bool  # Ensure file ends with newline
  sort_imports: Bool          # Sort `use` declarations
  group_imports: Bool         # Group imports by module
end

enum TrailingComma
  Always    # Always add trailing comma
  Never     # Never add trailing comma
  Multi     # Add trailing comma only for multi-line constructs
end

def default_format_config() -> FormatConfig
  FormatConfig {
    indent_width: 2,
    use_tabs: false,
    max_line_width: 100,
    trailing_comma: TrailingComma::Multi,
    blank_lines_between_items: 1,
    blank_lines_between_methods: 1,
    spaces_around_binary_ops: true,
    spaces_after_comma: true,
    space_before_colon: false,
    space_after_colon: true,
    align_struct_fields: false,
    align_match_arms: false,
    newline_before_end: true,
    remove_trailing_whitespace: true,
    ensure_final_newline: true,
    # sort_imports defaults to FALSE: the "sort" is an identity today and
    # the import-move-to-front reorder breaks the semantic-equivalence
    # gate (parse(original) == parse(format(original))) for files whose
    # imports are not leading — item order must be preserved.
    sort_imports: false,
    group_imports: true
  }
end

def duplicate_format_config(config: FormatConfig) -> FormatConfig
  FormatConfig {
    indent_width: config.indent_width,
    use_tabs: config.use_tabs,
    max_line_width: config.max_line_width,
    trailing_comma: config.trailing_comma,
    blank_lines_between_items: config.blank_lines_between_items,
    blank_lines_between_methods: config.blank_lines_between_methods,
    spaces_around_binary_ops: config.spaces_around_binary_ops,
    spaces_after_comma: config.spaces_after_comma,
    space_before_colon: config.space_before_colon,
    space_after_colon: config.space_after_colon,
    align_struct_fields: config.align_struct_fields,
    align_match_arms: config.align_match_arms,
    newline_before_end: config.newline_before_end,
    remove_trailing_whitespace: config.remove_trailing_whitespace,
    ensure_final_newline: config.ensure_final_newline,
    sort_imports: config.sort_imports,
    group_imports: config.group_imports
  }
end

# ———————————————————————————————————————————————————————————————
# Formatter State
# ———————————————————————————————————————————————————————————————

struct Formatter
  config: FormatConfig
  output: String
  indent_level: UInt
  current_line_width: UInt
  last_was_newline: Bool
  blank_line_count: UInt
end

def formatter_new(config: FormatConfig) -> Formatter
  Formatter {
    config: config,
    output: "".to_string(),
    indent_level: 0,
    current_line_width: 0,
    last_was_newline: true,
    blank_line_count: 0
  }
end

# String.trim_end does not exist in std::core; strip trailing spaces/tabs by
# slicing so emit_newline can honor remove_trailing_whitespace.
def string_trim_end(s: String) -> String
  var end_idx = s.len()
  while end_idx > 0 do
    let ch = s.slice(end_idx - 1, end_idx)
    if ch == " " || ch == "\t" then
      end_idx = end_idx - 1
    else
      break
    end
  end
  s.slice(0, end_idx)
end

# Re-escape string literal content so the emitted text re-lexes to the same
# StringLit value (quotes/backslashes must not terminate the literal).
def escape_string_content(s: String) -> String
  var out = String::new()
  for ch in s.chars() do
    match ch
    when '"' then out.push_str("\\\"")
    when '\\' then out.push_str("\\\\")
    when '\n' then out.push_str("\\n")
    when '\t' then out.push_str("\\t")
    when '\r' then out.push_str("\\r")
    when '\0' then out.push_str("\\0")
    when _ then out.push(ch)
    end
  end
  out
end

def escape_char_content(c: Char) -> String
  match c
  when '\'' then "\\'"
  when '\\' then "\\\\"
  when '\n' then "\\n"
  when '\t' then "\\t"
  when '\r' then "\\r"
  when '\0' then "\\0"
  when _ then c.to_string()
  end  end  end
end

def binop_symbol(op: BinOp) -> String
  match op
  when BinOp::Add then "+"
  when BinOp::Sub then "-"
  when BinOp::Mul then "*"
  when BinOp::Div then "/"
  when BinOp::Mod then "%"
  when BinOp::Pow then "**"
  when BinOp::Eq then "=="
  when BinOp::Ne then "!="
  when BinOp::Lt then "<"
  when BinOp::Le then "<="
  when BinOp::Gt then ">"
  when BinOp::Ge then ">="
  when BinOp::And then "&&"
  when BinOp::Or then "||"
  when BinOp::BitAnd then "&"
  when BinOp::BitOr then "|"
  when BinOp::BitXor then "^"
  when BinOp::Shl then "<<"
  when BinOp::Shr then ">>"
  end  end
end

def unop_symbol(op: UnOp) -> String
  match op
  when UnOp::Neg then "-"
  when UnOp::Not then "!"
  when UnOp::BitNot then "~"
  end  end
end

impl Formatter
  def emit(inout self, s: str) -> Unit
    if self.last_was_newline && !s.is_empty() then
      self.emit_indent()
      self.last_was_newline = false
      self.blank_line_count = 0
    end
    self.output = self.output + s
    self.current_line_width = self.current_line_width + s.len()
  end
  
  def emit_newline(inout self) -> Unit
    if self.config.remove_trailing_whitespace then
      self.output = string_trim_end(&self.output)
    end
    self.output = self.output + "\n"
    self.current_line_width = 0
    self.last_was_newline = true
    self.blank_line_count = self.blank_line_count + 1
  end
  
  def emit_blank_line(inout self, max: UInt) -> Unit
    if self.blank_line_count < max then
      self.emit_newline()
    end
  end
  
  def emit_indent(inout self) -> Unit
    let indent = make_indent(&self.config, self.indent_level)
    self.output = self.output + indent
    self.current_line_width = indent.len()
  end
  
  def indent(inout self) -> Unit
    self.indent_level = self.indent_level + 1
  end
  
  def dedent(inout self) -> Unit
    if self.indent_level > 0 then
      self.indent_level = self.indent_level - 1
    end
  end
  
  def space(inout self) -> Unit
    self.emit(" ")
  end
  
  def remaining_width(self) -> UInt
    if self.current_line_width >= self.config.max_line_width then
      0
    else
      self.config.max_line_width - self.current_line_width
    end
  end
  
  def would_overflow(self, text: str) -> Bool
    self.current_line_width + text.len() > self.config.max_line_width
  end
end

def make_indent(config: FormatConfig, level: UInt) -> String
  var parts: Vec[String] = Vec::new()
  let unit = if config.use_tabs then "\t" else
    var space_parts: Vec[String] = Vec::new()
    var i: UInt = 0
    while i < config.indent_width do
      space_parts.push(" ")
      i = i + 1
    end
    space_parts.join("")
  end
  
  var i: UInt = 0
  while i < level do
    parts.push(unit)
    i = i + 1
  end
  parts.join("")
end

# ———————————————————————————————————————————————————————————————
# AST Formatting
# ———————————————————————————————————————————————————————————————

def format_program(inout f: Formatter, program: Program) -> Unit
  # Sort and emit imports first
  if f.config.sort_imports then
    let (imports, other_items) = partition_imports(&program.items)
    let sorted_imports = sort_import_items(imports, f.config.group_imports)
    
    for imp in sorted_imports do
      format_item(f, imp)
      f.emit_newline()
    end
    
    if !sorted_imports.is_empty() && !other_items.is_empty() then
      f.emit_blank_line(1)
    end
    
    var first = true
    for item in other_items do
      if !first then
        f.emit_blank_line(f.config.blank_lines_between_items)
      end
      format_item(f, item)
      f.emit_newline()
      first = false
    end
  else
    var first = true
    for item in program.items do
      if !first then
        f.emit_blank_line(f.config.blank_lines_between_items)
      end
      format_item(f, item)
      f.emit_newline()
      first = false
    end
  end
  
  if f.config.ensure_final_newline then
    if !f.output.ends_with("\n") then
      f.emit_newline()
    end
  end
end

# Format an attribute: @name or @name(arg1, arg2,...)
def format_annotation(inout f: Formatter, ann: Attribute) -> Unit
  f.emit("@")
  f.emit(ann.name.as_str())
  
  if !ann.args.is_empty() then
    f.emit("(")
    var first = true
    for arg in ann.args do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(arg.as_str())
      first = false
    end
    f.emit(")")
  end
  
  f.emit_newline()
end

def format_item(inout f: Formatter, item: Item) -> Unit
  # Emit annotations (#[name] or #[name(args)])
  for ann in item.attrs do
    format_annotation(f, ann)
  end
  
  match item.kind
  when ItemKind::ItemUse(u) then format_use(f, u)
  when ItemKind::ItemFunction(func) then format_function(f, func, false)
  when ItemKind::ItemStruct(s) then format_struct(f, s)
  when ItemKind::ItemEnum(e) then format_enum(f, e)
  when ItemKind::ItemTrait(t) then format_trait(f, t)
  when ItemKind::ItemImpl(imp) then format_impl(f, imp)
  when ItemKind::ItemConst(c) then format_const(f, c)
  when ItemKind::ItemModule(m) then format_module(f, m)
  when ItemKind::ItemExternBlock(ext) then format_extern(f, ext)
  when ItemKind::ItemTypeAlias(ta) then format_type_alias(f, ta)
  when ItemKind::ItemStatic(s) then format_static(f, s)
  when ItemKind::ItemMacro(m) then format_macro(f, m)
  when ItemKind::ItemCapabilityDecl(c) then format_capability(f, c)
  when ItemKind::ItemEffectDecl(e) then format_effect(f, e)
  when ItemKind::ItemRationaleBlock(r) then format_rationale(f, r)
  when ItemKind::ItemEditionDecl(ed) then format_edition(f, ed)
  end
end

def format_use(inout f: Formatter, u: UseDecl) -> Unit
  f.emit("use ")
  f.emit(u.path.segments.join("::"))

  if u.glob then
    f.emit("::*")
  elsif u.names.is_some() then
    f.emit("::{")
    var first = true
    match u.names
    when Option::Some(items) then
      for item in items do
        if !first then
          f.emit(",")
          if f.config.spaces_after_comma then f.space() end
        end
        f.emit(item.as_str())
        first = false
      end
    when Option::None then ()
    end
    f.emit("}")
  end

  match u.alias_name
  when Option::Some(alias_name) then
    f.emit(" as ")
    f.emit(alias_name.as_str())
  when Option::None then ()
  end
end

def format_trait_method(inout f: Formatter, m: TraitMethod) -> Unit
  # Trait methods declare a signature, optionally with a default body.
  f.emit("def ")
  f.emit(m.sig.name.as_str())
  
  if !m.sig.generic_params.is_empty() then
    f.emit("[")
    var first = true
    for gp in m.sig.generic_params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(gp.name.as_str())
      first = false
    end
    f.emit("]")
  end
  
  f.emit("(")
  var first = true
  for param in m.sig.params do
    if !first then
      f.emit(",")
      if f.config.spaces_after_comma then f.space() end
    end
    format_param(f, param)
    first = false
  end
  f.emit(")")
  
  match m.sig.ret_type
  when Option::Some(ret) then
    f.emit(" -> ")
    format_type_expr(f, &ret)
  when Option::None then ()
  end
  
  match m.default_body
  when FnBody::FnBlock(block) then
    f.emit_newline()
    f.indent()
    format_block(f, &block)
    f.dedent()
    f.emit("end")
  when FnBody::FnExpr(expr) then
    f.emit(" = ")
    format_expr(f, &expr)
    f.emit_newline()
  when _ then
    f.emit(" end")
  end
end

def format_function(inout f: Formatter, func: FunctionDecl, is_method: Bool) -> Unit
  # Visibility
  match func.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  
  f.emit("def ")
  f.emit(func.name.as_str())
  
  # Generic parameters
  if !func.generic_params.is_empty() then
    f.emit("[")
    var first = true
    for gp in func.generic_params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(gp.name.as_str())
      if !gp.bounds.is_empty() then
        f.emit(": ")
        var first_bound = true
        for bound in gp.bounds do
          if !first_bound then f.emit(" + ") end
          format_type_expr(f, bound)
          first_bound = false
        end
      end
      first = false
    end
    f.emit("]")
  end
  
  # Parameters
  f.emit("(")
  let params_str = format_params_inline(func, &f.config)
  
  if f.would_overflow(params_str.as_str()) then
    # Multi-line parameters
    f.emit_newline()
    f.indent()
    var first = true
    for param in func.params do
      if !first then
        f.emit(",")
        f.emit_newline()
      end
      format_param(f, param)
      first = false
    end
    f.emit_newline()
    f.dedent()
  else
    var first = true
    for param in func.params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_param(f, param)
      first = false
    end
  end
  f.emit(")")
  
  # Return type
  match func.ret_type
  when Option::Some(ret) then
    f.emit(" -> ")
    format_type_expr(f, &ret)
  when Option::None then ()
  end
  
  # Where clauses — emitted inline on the signature line because the parser
  # looks for 'where' immediately after the return type (a where clause on a
  # fresh line would be misparsed as a body statement).
  if !func.where_clause.is_empty() then
    f.emit(" where ")
    var first_clause = true
    for clause in func.where_clause do
      if !first_clause then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(fmt_type_expr_to_string(&clause.ty).as_str())
      f.emit(": ")
      var first_bound = true
      for bound in clause.bounds do
        if !first_bound then f.emit(" + ") end
        format_type_expr(f, bound)
        first_bound = false
      end
      first_clause = false
    end
  end
  
  # Body
  match func.body
  when FnBody::FnBlock(block) then
    f.emit_newline()
    f.indent()
    format_block(f, &block)
    f.dedent()
    f.emit("end")
  when FnBody::FnExpr(expr) then
    f.emit(" = ")
    format_expr(f, &expr)
    f.emit_newline()
  when FnBody::FnExtern(name) then
    f.emit(" = extern(\"")
    f.emit(name.as_str())
    f.emit("\")")
    f.emit_newline()
  when FnBody::FnNone then
    f.emit_newline()
    f.emit("end")
  end
end

def format_param(inout f: Formatter, param: Param) -> Unit
  # The ONE semantic record is the access convention — the legacy
  # spellings (mut / & / &mut / move / own) are converted at parse time.
  # Emit the convention so the round-trip preserves the parameter's access
  # semantics (Let prints nothing — the legacy `&`/plain spelling both
  # normalize to it).
  match param.convention
  when AccessConvention::Inout then f.emit("inout ")
  when AccessConvention::Sink then f.emit("sink ")
  when AccessConvention::Set then f.emit("set ")
  when AccessConvention::Let then ()
  end
  
  f.emit(param.name.as_str())
  
  match param.ty
  when Option::Some(ty) then
    if !f.config.space_before_colon then () else f.space() end
    f.emit(":")
    if f.config.space_after_colon then f.space() end
    format_type_expr(f, &ty)
  when Option::None then ()
  end
end

def format_params_inline(func: FunctionDecl, config: FormatConfig) -> String
  var parts: Vec[String] = Vec::new()
  var first = true
  for param in func.params do
    if !first then
      parts.push(", ")
    end
    match param.convention
    when AccessConvention::Inout then parts.push("inout ")
    when AccessConvention::Sink then parts.push("sink ")
    when AccessConvention::Set then parts.push("set ")
    when AccessConvention::Let then ()
    end
    parts.push(param.name.clone())
    match param.ty
    when Option::Some(ty) then
      parts.push(": " + fmt_type_expr_to_string(&ty))
    when Option::None then ()
    end
    first = false
  end
  parts.join("")
end

def format_struct(inout f: Formatter, s: StructDecl) -> Unit
  match s.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  if s.kind == NominalKind::Resource then
    f.emit("resource ")
  else
    f.emit("struct ")
  end
  f.emit(s.name.as_str())
  
  if !s.generic_params.is_empty() then
    f.emit("[")
    var first = true
    for gp in s.generic_params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(gp.name.as_str())
      first = false
    end
    f.emit("]")
  end
  
  f.emit_newline()
  f.indent()
  
  # Calculate max field name width for alignment
  var max_name_width: UInt = 0
  if f.config.align_struct_fields then
    for field in s.fields do
      if field.name.len() > max_name_width then
        max_name_width = field.name.len()
      end
    end
  end
  
  for field in s.fields do
    match field.vis
    when Visibility::Public then f.emit("pub ")
    when _ then ()
    end
    f.emit(field.name.as_str())
    
    if f.config.align_struct_fields then
      # Pad to alignment
      var padding = max_name_width - field.name.len()
      while padding > 0 do
        f.space()
        padding = padding - 1
      end
    end
    
    if !f.config.space_before_colon then () else f.space() end
    f.emit(":")
    if f.config.space_after_colon then f.space() end
    format_type_expr(f, &field.ty)
    match field.default
    when Option::Some(default_expr) then
      f.emit(" = ")
      format_expr(f, &default_expr)
    when Option::None then ()
    end
    f.emit_newline()
  end
  
  # Resource methods (resource bodies may contain defs)
  var first_method = true
  for method in s.methods do
    if !first_method then
      f.emit_blank_line(f.config.blank_lines_between_methods)
    end
    format_function(f, method, true)
    f.emit_newline()
    first_method = false
  end
  
  f.dedent()
  f.emit("end")  end
end

def format_enum(inout f: Formatter, e: EnumDecl) -> Unit
  match e.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  f.emit("enum ")
  f.emit(e.name.as_str())
  
  if !e.generic_params.is_empty() then
    f.emit("[")
    var first = true
    for gp in e.generic_params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(gp.name.as_str())
      first = false
    end
    f.emit("]")
  end
  
  f.emit_newline()
  f.indent()
  
  for variant in e.variants do
    f.emit(variant.name.as_str())
    
    if !variant.fields.is_empty() then
      f.emit("(")
      var first = true
      var i = 0
      while i < variant.fields.len() do
        let field = variant.fields[i]
        if !first then
          f.emit(",")
          if f.config.spaces_after_comma then f.space() end
        end
        if i < variant.field_names.len() then
          match variant.field_names[i]
          when Option::Some(field_name) then
            if !field_name.is_empty() then
              f.emit(field_name.as_str())
              f.emit(": ")
            end
          when Option::None then ()
          end
        end
        format_type_expr(f, field)
        first = false
        i = i + 1
      end
      f.emit(")")
    end
    
    f.emit_newline()
  end
  
  f.dedent()
  f.emit("end")  end
end

def format_trait(inout f: Formatter, t: TraitDecl) -> Unit
  match t.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  f.emit("trait ")
  f.emit(t.name.as_str())
  
  if !t.generic_params.is_empty() then
    f.emit("[")
    var first = true
    for gp in t.generic_params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(gp.name.as_str())
      first = false
    end
    f.emit("]")
  end
  
  if !t.super_traits.is_empty() then
    f.emit(": ")
    var first = true
    for st in t.super_traits do
      if !first then f.emit(" + ") end
      f.emit(fmt_type_expr_to_string(&st).as_str())
      first = false
    end
  end
  
  f.emit_newline()
  f.indent()
  
  var first_method = true
  for method in t.methods do
    if !first_method then
      f.emit_blank_line(f.config.blank_lines_between_methods)
    end
    format_trait_method(f, method)
    f.emit_newline()
    first_method = false
  end
  
  # Associated types: type Item: Bound or type Item = Default
  for at in t.assoc_types do
    if !first_method then
      f.emit_blank_line(f.config.blank_lines_between_methods)
    end
    f.emit("type ")
    f.emit(at.name.as_str())
    if !at.bounds.is_empty() then
      f.emit(": ")
      var first_bound = true
      for bound in at.bounds do
        if !first_bound then f.emit(" + ") end
        format_type_expr(f, &bound)
        first_bound = false
      end
    end
    match at.default
    when Option::Some(default_ty) then
      f.emit(" = ")
      format_type_expr(f, &default_ty)
    when Option::None then ()
    end
    f.emit_newline()
    first_method = false
  end
  
  f.dedent()
  f.emit("end")  end
end

def format_impl(inout f: Formatter, imp: ImplDecl) -> Unit
  f.emit("impl ")
  
  if !imp.generic_params.is_empty() then
    f.emit("[")
    var first = true
    for gp in imp.generic_params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(gp.name.as_str())
      first = false
    end
    f.emit("] ")
  end
  
  match imp.trait_name
  when Option::Some(trait_name) then
    f.emit(trait_name.as_str())
    f.emit(" for ")
  when Option::None then ()
  end
  
  format_type_expr(f, &imp.for_type)
  
  # Where clauses stay on the header line (the parser expects 'where' there).
  if !imp.where_clause.is_empty() then
    f.emit(" where ")
    var first_clause = true
    for clause in imp.where_clause do
      if !first_clause then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(fmt_type_expr_to_string(&clause.ty).as_str())
      f.emit(": ")
      var first_bound = true
      for bound in clause.bounds do
        if !first_bound then f.emit(" + ") end
        format_type_expr(f, &bound)
        first_bound = false
      end
      first_clause = false
    end
  end
  
  f.emit_newline()
  f.indent()
  
  var first_method = true
  for method in imp.methods do
    if !first_method then
      f.emit_blank_line(f.config.blank_lines_between_methods)
    end
    format_function(f, method, true)
    f.emit_newline()
    first_method = false
  end
  
  # Associated type impls: type Item = Concrete
  for assoc in imp.assoc_types do
    if !first_method then
      f.emit_blank_line(f.config.blank_lines_between_methods)
    end
    f.emit("type ")
    f.emit(assoc.name.as_str())
    f.emit(" = ")
    format_type_expr(f, &assoc.ty)
    f.emit_newline()
    first_method = false
  end
  
  f.dedent()
  f.emit("end")
end

def format_const(inout f: Formatter, c: ConstDecl) -> Unit
  match c.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  f.emit("const ")
  f.emit(c.name.as_str())
  match c.ty
  when Option::Some(ty) then
    f.emit(": ")
    format_type_expr(f, &ty)
  when Option::None then ()
  end
  f.emit(" = ")
  format_expr(f, &c.value)  end
end

def format_module(inout f: Formatter, m: ModuleDecl) -> Unit
  f.emit("module ")
  f.emit(m.name.as_str())
  f.emit_newline()
  f.indent()
  
  for item in m.items do
    format_item(f, item)
    f.emit_newline()
    f.emit_blank_line(f.config.blank_lines_between_items)
  end
  
  f.dedent()
  f.emit("end")
end

def format_extern_item(inout f: Formatter, item: ExternItem) -> Unit
  match item
  when ExternItem::Function(efn) then
    f.emit("def ")
    f.emit(efn.name.as_str())
    f.emit("(")
    var first = true
    for param in efn.params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_param(f, param)
      first = false
    end
    f.emit(")")
    match efn.ret_type
    when Option::Some(ret) then
      f.emit(" -> ")
      format_type_expr(f, &ret)
    when Option::None then ()
    end
  when ExternItem::Static(es) then
    f.emit("static ")
    f.emit(es.name.as_str())
    f.emit(": ")
    format_type_expr(f, &es.ty)
  end  end
end

def format_extern(inout f: Formatter, ext: ExternBlock) -> Unit
  # With an ABI, the parser reads `extern "ABI"` followed by `def`/`static`
  # lines and a closing `end` — per-item `extern` prefixes would split the
  # block into separate ABI-less blocks. A single leading static is emitted in
  # the standalone `extern "ABI" static x: T` form (no end) because the parser
  # does not consume a trailing end on that path.
  match ext.abi
  when Option::Some(abi) then
    if ext.items.len() > 0 then
      match ext.items[0]
      when ExternItem::Function(_) then
        f.emit("extern \"")
        f.emit(abi.as_str())
        f.emit("\"")
        f.emit_newline()
        f.indent()
        for item in ext.items do
          format_extern_item(f, item)
          f.emit_newline()
        end
        f.dedent()
        f.emit("end")
      when ExternItem::Static(_) then
        f.emit("extern \"")
        f.emit(abi.as_str())
        f.emit("\" ")
        format_extern_item(f, ext.items[0])
      end
    else
      f.emit("extern \"")
      f.emit(abi.as_str())
      f.emit("\"")
      f.emit_newline()
      f.emit("end")
    end
  when Option::None then
    f.emit("extern")
    f.emit_newline()
    f.indent()
    for item in ext.items do
      format_extern_item(f, item)
      f.emit_newline()
    end
    f.dedent()
    f.emit("end")
  end
end

def format_type_alias(inout f: Formatter, ta: TypeAliasDecl) -> Unit
  match ta.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  f.emit("type ")
  f.emit(ta.name.as_str())
  
  if !ta.generic_params.is_empty() then
    f.emit("[")
    var first = true
    for gp in ta.generic_params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(gp.name.as_str())
      first = false
    end
    f.emit("]")
  end
  
  f.emit(" = ")
  let _fmt_ignore = format_type_expr(f, &ta.ty)  end
end

def format_static(inout f: Formatter, s: StaticDecl) -> Unit
  match s.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  f.emit("static ")
  if s.is_mut then f.emit("mut ") end
  f.emit(s.name.as_str())
  f.emit(": ")
  format_type_expr(f, &s.ty)
  f.emit(" = ")
  format_expr(f, &s.value)  end
end

def format_macro(inout f: Formatter, m: MacroDecl) -> Unit
  match m.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  f.emit("macro ")
  f.emit(m.name.as_str())
  f.emit("(")
  var first = true
  for param in m.params do
    if !first then
      f.emit(",")
      if f.config.spaces_after_comma then f.space() end
    end
    format_param(f, param)
    first = false
  end
  f.emit(")")
  f.emit_newline()
  f.indent()
  format_block(f, &m.body)
  f.dedent()
  f.emit("end")  end
end

def format_capability(inout f: Formatter, c: CapabilityDecl) -> Unit
  match c.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  f.emit("cap ")
  f.emit(c.name.as_str())
  match c.parent
  when Option::Some(parent) then
    f.emit(": ")
    f.emit(parent.as_str())
  when Option::None then ()
  end
  if !c.permissions.is_empty() then
    f.emit(" implies ")
    var first = true
    for perm in c.permissions do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      f.emit(perm.as_str())
      first = false
    end
  end
  f.emit(" end")  end
end

def format_effect(inout f: Formatter, e: EffectDecl) -> Unit
  match e.vis
  when Visibility::Public then f.emit("pub ")
  when _ then ()
  end
  f.emit("effect ")
  f.emit(e.name.as_str())
  match e.parent
  when Option::Some(parent) then
    f.emit(": ")
    f.emit(parent.as_str())
  when Option::None then ()
  end
  f.emit(" end")  end
end

def format_rationale(inout f: Formatter, r: RationaleBlock) -> Unit
  f.emit("rationale")
  f.emit_newline()
  f.indent()
  f.emit("objective: \"")
  f.emit(escape_string_content(&r.title).as_str())
  f.emit("\"")
  f.emit_newline()
  # The parser folds the objective + every why/description line into body
  # (newline-joined). When body carries content beyond the title, re-emit
  # it as ONE description line (the `\n` escapes round-trip through the
  # string literal) so parse(format(original)) keeps the same body — the
  # semantic-equivalence gate's requirement.
  if r.body != r.title && !r.body.is_empty() then
    f.emit("description: \"")
    f.emit(escape_string_content(&r.body).as_str())
    f.emit("\"")
    f.emit_newline()
  end
  match r.author
  when Option::Some(author) then
    f.emit("author: \"")
    f.emit(escape_string_content(&author).as_str())
    f.emit("\"")
    f.emit_newline()
  when Option::None then ()
  end
  for tag in r.tags do
    f.emit("tag: \"")
    f.emit(escape_string_content(&tag).as_str())
    f.emit("\"")
    f.emit_newline()
  end
  f.dedent()
  f.emit("end")
end

def format_edition(inout f: Formatter, ed: EditionDecl) -> Unit
  f.emit("edition \"")
  f.emit(escape_string_content(&ed.version).as_str())
  f.emit("\"")
end

# ———————————————————————————————————————————————————————————————
# Expression Formatting
# ———————————————————————————————————————————————————————————————

def format_expr(inout f: Formatter, expr: Expr) -> Unit
  match expr.kind
  when ExprKind::ExprIntLit(n) then
    f.emit(parsed_int_spelling(&n).as_str())
  when ExprKind::ExprFloatLit(n) then
    f.emit(parsed_float_spelling(&n).as_str())
  when ExprKind::ExprStringLit(s) then
    f.emit("\"")
    f.emit(escape_string_content(&s).as_str())
    f.emit("\"")
  when ExprKind::ExprCharLit(c) then
    f.emit("'")
    f.emit(escape_char_content(c).as_str())
    f.emit("'")
  when ExprKind::ExprBoolLit(b) then
    if b then f.emit("true") else f.emit("false") end
  when ExprKind::ExprNilLit then
    f.emit("nil")
  when ExprKind::ExprIdent(name) then
    f.emit(name.as_str())
  when ExprKind::ExprPath(path) then
    var first = true
    for seg in path.segments do
      if !first then f.emit("::") end
      f.emit(seg.as_str())
      first = false
    end
  when ExprKind::ExprSelfRef then
    f.emit("self")
  when ExprKind::ExprBinaryOp(op, left, right) then
    format_expr(f, left)
    if f.config.spaces_around_binary_ops then f.space() end
    f.emit(binop_symbol(op).as_str())
    if f.config.spaces_around_binary_ops then f.space() end
    format_expr(f, right)
  when ExprKind::ExprUnaryOp(op, operand) then
    f.emit(unop_symbol(op).as_str())
    format_expr(f, operand)
  when ExprKind::ExprCall(callee, args) then
    format_expr(f, callee)
    f.emit("(")
    var first = true
    for arg in args do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_expr(f, arg)
      first = false
    end
    f.emit(")")
  when ExprKind::ExprMethodCall(receiver, method, type_args, args) then
    format_expr(f, receiver)
    f.emit(".")
    f.emit(method.as_str())
    if !type_args.is_empty() then
      f.emit("[")
      var first_ta = true
      for ta in type_args do
        if !first_ta then
          f.emit(",")
          if f.config.spaces_after_comma then f.space() end
        end
        format_type_expr(f, &ta)
        first_ta = false
      end
      f.emit("]")
    end
    f.emit("(")
    var first = true
    for arg in args do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_expr(f, arg)
      first = false
    end
    f.emit(")")
  when ExprKind::ExprFieldAccess(obj, field) then
    format_expr(f, obj)
    f.emit(".")
    f.emit(field.as_str())
  when ExprKind::ExprIndex(arr, idx) then
    format_expr(f, arr)
    f.emit("[")
    format_expr(f, idx)
    f.emit("]")
  when ExprKind::ExprIf(if_stmt) then
    f.emit("if ")
    format_expr(f, &if_stmt.cond)
    f.emit(" then")
    f.emit_newline()
    f.indent()
    format_block(f, &if_stmt.then_block)
    f.dedent()
    for (cond, block) in if_stmt.elsif_branches do
      f.emit("elsif ")
      format_expr(f, &cond)
      f.emit(" then")
      f.emit_newline()
      f.indent()
      format_block(f, &block)
      f.dedent()
    end
    match if_stmt.else_block
    when Option::Some(else_blk) then
      f.emit("else")
      f.emit_newline()
      f.indent()
      format_block(f, &else_blk)
      f.dedent()
    when Option::None then ()
    end
    f.emit("end")
  when ExprKind::ExprMatch(match_expr) then
    f.emit("match ")
    format_expr(f, &match_expr.scrutinee)
    f.emit_newline()
    for arm in match_expr.arms do
      f.emit("when ")
      format_pattern(f, &arm.pattern)
      match arm.guard_expr
      when Option::Some(guard_expr) then
        f.emit(" if ")
        format_expr(f, &guard_expr)
      when Option::None then ()
      end
      f.emit(" then")
      f.emit_newline()
      f.indent()
      format_block(f, &arm.body)
      f.dedent()
    end
    f.emit("end")
  when ExprKind::ExprBlock(block) then
    f.emit("do")
    f.emit_newline()
    f.indent()
    format_block(f, &block)
    f.dedent()
    f.emit("end")
  when ExprKind::ExprClosure(params, ret_ty, body) then
    f.emit("|")
    var first = true
    for param in params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_pattern(f, &param.pat)
      match param.ty
      when Option::Some(param_ty) then
        f.emit(": ")
        format_type_expr(f, &param_ty)
      when Option::None then ()
      end
      first = false
    end
    f.emit("|")
    match ret_ty
    when Option::Some(ret_type) then
      f.emit(" -> ")
      format_type_expr(f, &ret_type)
    when Option::None then ()
    end
    f.space()
    format_expr(f, body)
  when ExprKind::ExprAccess(inner) then
    f.emit("&")
    format_expr(f, inner)
  when ExprKind::ExprRawDeref(inner) then
    f.emit("*")
    format_expr(f, inner)
  when ExprKind::ExprStructLit(path, fields) then
    var first_seg = true
    for seg in path.segments do
      if !first_seg then f.emit("::") end
      f.emit(seg.as_str())
      first_seg = false
    end
    f.emit(" {")
    let inline = fields.len() <= 3
    if inline then
      f.space()
      var first = true
      for (field_name, field_value) in fields do
        if !first then
          f.emit(",")
          if f.config.spaces_after_comma then f.space() end
        end
        f.emit(field_name.as_str())
        f.emit(": ")
        format_expr(f, &field_value)
        first = false
      end
      f.space()
    else
      f.emit_newline()
      f.indent()
      for (field_name, field_value) in fields do
        f.emit(field_name.as_str())
        f.emit(": ")
        format_expr(f, &field_value)
        f.emit(",")
        f.emit_newline()
      end
      f.dedent()
    end
    f.emit("}")
  when ExprKind::ExprArrayLit(elems) then
    f.emit("[")
    var first = true
    for elem in elems do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_expr(f, &elem)
      first = false
    end
    f.emit("]")
  when ExprKind::ExprTupleLit(elems) then
    f.emit("(")
    var first = true
    for elem in elems do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_expr(f, &elem)
      first = false
    end
    if elems.len() == 1 then
      # (a,) is a 1-tuple; (a) reparses as a parenthesized expression.
      f.emit(",")
    end
    f.emit(")")
  when ExprKind::ExprMapLit(entries) then
    f.emit("{")
    var first = true
    for (key, value) in entries do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_expr(f, &key)
      f.emit(" => ")
      format_expr(f, &value)
      first = false
    end
    f.emit("}")
  when ExprKind::ExprRange(start_opt, end_opt, inclusive) then
    match start_opt
    when Option::Some(s) then format_expr(f, s)
    when Option::None then ()
    end
    if inclusive then f.emit("..=") else f.emit("..") end
    match end_opt
    when Option::Some(e) then format_expr(f, e)
    when Option::None then ()
    end
  when ExprKind::ExprCast(val, ty) then
    format_expr(f, val)
    f.emit(" as ")
    format_type_expr(f, &ty)
  when ExprKind::ExprTypeCheck(val, ty) then
    format_expr(f, val)
    f.emit(" is ")
    format_type_expr(f, &ty)
  when ExprKind::ExprAssign(target, value) then
    format_expr(f, target)
    f.emit(" = ")
    format_expr(f, value)
  when ExprKind::ExprAsync(block) then
    f.emit("async")
    f.emit_newline()
    f.indent()
    format_block(f, &block)
    f.dedent()
    f.emit("end")
  when ExprKind::ExprUnsafe(justification, block) then
    # The justification label is part of the AST (unsafe "reason" do/end) —
    # emitting it is required for the semantic-equivalence gate.
    f.emit("unsafe")
    match justification
    when Option::Some(reason) then
      f.emit(" \"")
      f.emit(escape_string_content(&reason).as_str())
      f.emit("\"")
    when Option::None then ()
    end
    f.emit_newline()
    f.indent()
    format_block(f, &block)
    f.dedent()
    f.emit("end")
  when ExprKind::ExprAwait(inner) then
    # await is a prefix operator; parenthesize operands that would otherwise
    # bind looser on reparse (await x + 1 must not become (await x) + 1).
    f.emit("await ")
    match inner.kind
    when ExprKind::ExprBinaryOp(_, _, _) then
      f.emit("(")
      format_expr(f, inner)
      f.emit(")")
    when ExprKind::ExprUnaryOp(_, _) then
      f.emit("(")
      format_expr(f, inner)
      f.emit(")")
    when ExprKind::ExprRange(_, _, _) then
      f.emit("(")
      format_expr(f, inner)
      f.emit(")")
    when _ then
      format_expr(f, inner)
    end
  when ExprKind::ExprTry(inner) then
    format_expr(f, inner)
    f.emit("?")
  when ExprKind::ExprComptime(block) then
    f.emit("comptime")
    f.emit_newline()
    f.indent()
    format_block(f, &block)
    f.dedent()
    f.emit("end")
  when ExprKind::ExprEnumVariant(path, args) then
    var first_seg = true
    for seg in path.segments do
      if !first_seg then f.emit("::") end
      f.emit(seg.as_str())
      first_seg = false
    end
    if args.len() > 0 then
      f.emit("(")
      var first = true
      for arg in args do
        if !first then
          f.emit(",")
          if f.config.spaces_after_comma then f.space() end
        end
        format_expr(f, &arg)
        first = false
      end
      f.emit(")")
    end
  when ExprKind::ExprPipe(left, right) then
    format_expr(f, left)
    f.emit(" |> ")
    format_expr(f, right)
  when ExprKind::ExprMacroCall(name, args) then
    f.emit(name.as_str())
    f.emit("![")
    var first = true
    for arg in args do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_expr(f, &arg)
      first = false
    end
    f.emit("]")
  when _ then
    f.emit("<expr>")
  end  end
end

def format_stmt(inout f: Formatter, stmt: Stmt) -> Unit
  match stmt.kind
  when StmtKind::StmtExpr(expr) then
    format_expr(f, &expr)
  when StmtKind::StmtLet(pattern, ty_opt, init, is_mut) then
    if is_mut then
      # 'mut <pattern>' only reparses when the pattern is a plain identifier;
      # destructuring mutable bindings must use the 'let mut <pattern>' form.
      match pattern.kind
      when PatternKind::Ident(_, _) then
        f.emit("mut ")
      when _ then
        f.emit("let mut ")
      end
    else
      f.emit("let ")
    end
    format_pattern(f, &pattern)
    match ty_opt
    when Option::Some(ty) then
      if !f.config.space_before_colon then () else f.space() end
      f.emit(":")
      if f.config.space_after_colon then f.space() end
      format_type_expr(f, &ty)
    when Option::None then ()
    end
    f.emit(" = ")
    format_expr(f, &init)
  when StmtKind::StmtAssign(target, value) then
    format_expr(f, &target)
    f.emit(" = ")
    format_expr(f, &value)
  when StmtKind::StmtCompoundAssign(op, target, value) then
    format_expr(f, &target)
    f.space()
    f.emit(binop_symbol(op).as_str())
    f.emit("=")
    f.space()
    format_expr(f, &value)
  when StmtKind::StmtIf(if_stmt) then
    f.emit("if ")
    format_expr(f, &if_stmt.cond)
    f.emit(" then")
    f.emit_newline()
    f.indent()
    format_block(f, &if_stmt.then_block)
    f.dedent()
    for (cond, block) in if_stmt.elsif_branches do
      f.emit("elsif ")
      format_expr(f, &cond)
      f.emit(" then")
      f.emit_newline()
      f.indent()
      format_block(f, &block)
      f.dedent()
    end
    match if_stmt.else_block
    when Option::Some(else_blk) then
      f.emit("else")
      f.emit_newline()
      f.indent()
      format_block(f, &else_blk)
      f.dedent()
    when Option::None then ()
    end
    f.emit("end")
  when StmtKind::StmtMatch(match_expr) then
    f.emit("match ")
    format_expr(f, &match_expr.scrutinee)
    f.emit_newline()
    for arm in match_expr.arms do
      f.emit("when ")
      format_pattern(f, &arm.pattern)
      match arm.guard_expr
      when Option::Some(guard_expr) then
        f.emit(" if ")
        format_expr(f, &guard_expr)
      when Option::None then ()
      end
      f.emit(" then")
      f.emit_newline()
      f.indent()
      format_block(f, &arm.body)
      f.dedent()
    end
    f.emit("end")
  when StmtKind::StmtFor(for_stmt) then
    f.emit("for ")
    format_pattern(f, &for_stmt.pattern)
    f.emit(" in ")
    format_expr(f, &for_stmt.iter)
    f.emit(" do")
    f.emit_newline()
    f.indent()
    format_block(f, &for_stmt.body)
    f.dedent()
    f.emit("end")
  when StmtKind::StmtWhile(cond, body) then
    f.emit("while ")
    format_expr(f, &cond)
    f.emit(" do")
    f.emit_newline()
    f.indent()
    format_block(f, &body)
    f.dedent()
    f.emit("end")
  when StmtKind::StmtLoop(body) then
    f.emit("loop")
    f.emit_newline()
    f.indent()
    format_block(f, &body)
    f.dedent()
    f.emit("end")
  when StmtKind::StmtReturn(val) then
    f.emit("return")
    match val
    when Option::Some(v) then
      f.space()
      format_expr(f, &v)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(val) then
    f.emit("break")
    match val
    when Option::Some(v) then
      f.space()
      format_expr(f, &v)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then
    f.emit("next")
  when StmtKind::StmtUnsafe(justification, body) then
    f.emit("unsafe")
    match justification
    when Option::Some(reason) then
      f.emit(" \"")
      f.emit(escape_string_content(&reason).as_str())
      f.emit("\"")
    when Option::None then ()
    end
    f.emit_newline()
    f.indent()
    format_block(f, &body)
    f.dedent()
    f.emit("end")
  when StmtKind::StmtDefer(body) then
    f.emit("defer")
    f.emit_newline()
    f.indent()
    format_block(f, &body)
    f.dedent()
    f.emit("end")
  when StmtKind::StmtGuard(cond, else_action) then
    f.emit("guard ")
    format_expr(f, &cond)
    f.emit(" else ")
    match else_action
    when GuardElse::Return(val_opt) then
      f.emit("return")
      match val_opt
      when Option::Some(v) then
        f.space()
        format_expr(f, &v)
      when Option::None then ()
      end
    when GuardElse::Break(val_opt) then
      f.emit("break")
      match val_opt
      when Option::Some(v) then
        f.space()
        format_expr(f, &v)
      when Option::None then ()
      end
    when GuardElse::Continue then
      # The dialect's continue keyword is `next` (TokenKind::Next) — the
      # emitted form must re-lex to the same token.
      f.emit("next")
    when GuardElse::Panic(msg) then
      f.emit("panic(\"")
      f.emit(escape_string_content(&msg).as_str())
      f.emit("\")")
    end
  when StmtKind::StmtTry(body, catches, finally_opt) then
    f.emit("try")
    f.emit_newline()
    f.indent()
    format_block(f, &body)
    f.dedent()
    for catch_arm in catches do
      f.emit("catch ")
      format_pattern(f, &catch_arm.pattern)
      f.emit_newline()
      f.indent()
      format_block(f, &catch_arm.body)
      f.dedent()
    end
    match finally_opt
    when Option::Some(fin) then
      f.emit("finally")
      f.emit_newline()
      f.indent()
      format_block(f, &fin)
      f.dedent()
    when Option::None then ()
    end
    f.emit("end")
  when StmtKind::StmtWith(expr, pat, body) then
    # (audit P1-1 first pass): the scoped-access statement —
    # `with <expr> as let <name>` / `with <expr> as inout <name>`, block,
    # `end`. The pattern is the parser's bare Ident(name, is_mut) binding;
    # is_mut carries the effect (false = `let`, true = `inout`).
    f.emit("with ")
    format_expr(f, &expr)
    f.emit(" as ")
    match pat.kind
    when PatternKind::Ident(name, is_inout) then
      if is_inout then
        f.emit("inout ")
      else
        f.emit("let ")
      end
      f.emit(name.as_str())
    when _ then
      format_pattern(f, &pat)
    end
    f.emit_newline()
    f.indent()
    format_block(f, &body)
    f.dedent()
    f.emit("end")
  when StmtKind::StmtHandleWith(expr, handlers) then
    f.emit("handle ")
    format_expr(f, &expr)
    for handler in handlers do
      f.emit(" with ")
      f.emit(handler.effect_name.as_str())
      f.emit_newline()
      f.indent()
      for arm in handler.arms do
        f.emit(arm.operation.as_str())
        f.emit("(")
        var first = true
        for p in arm.params do
          if !first then
            f.emit(",")
            if f.config.spaces_after_comma then f.space() end
          end
          format_pattern(f, &p)
          first = false
        end
        f.emit(") =>")
        f.emit_newline()
        f.indent()
        format_block(f, &arm.body)
        f.dedent()
      end
      f.dedent()
    end
    f.emit("end")
  when _ then ()
  end  end
end

def format_block(inout f: Formatter, block: Block) -> Unit
  format_block_stmts(f, &block.stmts)
end

def format_block_stmts(inout f: Formatter, stmts: Vec[Stmt]) -> Unit
  for stmt in stmts do
    format_stmt(f, stmt)
    f.emit_newline()
  end
end

def format_pattern(inout f: Formatter, pat: Pattern) -> Unit
  match pat.kind
  when PatternKind::Ident(name, is_mut) then
    if is_mut then f.emit("mut ") end
    f.emit(name.as_str())
  when PatternKind::Wildcard then f.emit("_")
  when PatternKind::Literal(lit) then format_expr(f, &lit)
  when PatternKind::Tuple(pats) then
    f.emit("(")
    var first = true
    for p in pats do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_pattern(f, p)
      first = false
    end
    f.emit(")")
  when PatternKind::Array(pats) then
    f.emit("[")
    var first = true
    for p in pats do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_pattern(f, p)
      first = false
    end
    f.emit("]")
  when PatternKind::Variant(path, pats) then
    f.emit(path.segments.join("::"))
    if !pats.is_empty() then
      f.emit("(")
      var first = true
      for p in pats do
        if !first then
          f.emit(",")
          if f.config.spaces_after_comma then f.space() end
        end
        format_pattern(f, p)
        first = false
      end
      f.emit(")")
    end
  when PatternKind::Struct(path, fields) then
    f.emit(path.segments.join("::"))
    f.emit(" { ")
    var first = true
    for field in fields do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      let field_name = field.0
      let field_pat = field.1
      f.emit(field_name.as_str())
      f.emit(": ")
      format_pattern(f, &field_pat)
      first = false
    end
    f.emit(" }")
  when PatternKind::Or(parts) then
    var first = true
    for part in parts do
      if !first then f.emit(" | ") end
      format_pattern(f, &part)
      first = false
    end
  when PatternKind::Range(start, end_val, inclusive) then
    match start
    when Option::Some(s) then format_expr(f, &s)
    when Option::None then ()
    end
    if inclusive then f.emit("..=") else f.emit("..") end
    match end_val
    when Option::Some(e) then format_expr(f, &e)
    when Option::None then ()
    end
  end  end
end

def format_type_expr(inout f: Formatter, ty: TypeExpr) -> Unit
  match ty.kind
  when TypeExprKind::Named(name, args) then
    f.emit(name.as_str())
    if !args.is_empty() then
      f.emit("[")
      var first = true
      for arg in args do
        if !first then
          f.emit(",")
          if f.config.spaces_after_comma then f.space() end
        end
        format_type_expr(f, &arg)
        first = false
      end
      f.emit("]")
    end
  when TypeExprKind::Unit then f.emit("Unit")
  when TypeExprKind::Never then f.emit("Never")
  when TypeExprKind::Tuple(elems) then
    f.emit("(")
    var first = true
    for elem in elems do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      format_type_expr(f, &elem)
      first = false
    end
    f.emit(")")
  when TypeExprKind::Array(elem, size) then
    # Fixed arrays reparse via [T; N] (the Array[T, N] spelling is a generic).
    f.emit("[")
    format_type_expr(f, &elem)
    match size
    when Option::Some(size_expr) then
      f.emit("; ")
      format_expr(f, &size_expr)
    when Option::None then ()
    end
    f.emit("]")
  when TypeExprKind::Slice(elem) then
    f.emit("[")
    format_type_expr(f, &elem)
    f.emit("]")
  when TypeExprKind::Ptr(inner) then
    f.emit("Ptr[")
    format_type_expr(f, &inner)
    f.emit("]")
  when TypeExprKind::PtrMut(inner) then
    f.emit("PtrMut[")
    format_type_expr(f, &inner)
    f.emit("]")
  when TypeExprKind::Ref(inner, mutable) then
    # Reference types appear in extern ABI contexts (`extern def f(x: &K)`);
    # the parser accepts them there and only there.
    if mutable then f.emit("&mut ") else f.emit("&") end
    format_type_expr(f, &inner)
  when TypeExprKind::Fn(params, ret) then
    f.emit("(")
    var first = true
    for p in params do
      if !first then
        f.emit(",")
        if f.config.spaces_after_comma then f.space() end
      end
      match p.convention
      when AccessConvention::Inout then f.emit("inout ")
      when AccessConvention::Sink then f.emit("sink ")
      when AccessConvention::Set then f.emit("set ")
      when AccessConvention::Let then ()
      end
      format_type_expr(f, &p.ty)
      first = false
    end
    f.emit(") -> ")
    format_type_expr(f, &ret)
  when TypeExprKind::Async(inner) then
    f.emit("async ")
    format_type_expr(f, &inner)
  when TypeExprKind::Effect(name, inner) then
    f.emit(name.as_str())
    f.emit(" ")
    format_type_expr(f, &inner)
  when TypeExprKind::Path(path) then f.emit(path.segments.join("::"))
  when TypeExprKind::Infer then f.emit("_")
  end  end
end

def fmt_type_expr_to_string(ty: TypeExpr) -> String
  match ty.kind
  when TypeExprKind::Named(name, args) then
    if args.is_empty() then
      name.clone()
    else
      var s = name.clone() + "["
      var first = true
      for arg in args do
        if !first then s = s + ", " end
        s = s + fmt_type_expr_to_string(&arg)
        first = false
      end
      s + "]"
    end
  when TypeExprKind::Unit then "Unit"
  when TypeExprKind::Never then "Never"
  when TypeExprKind::Tuple(elems) then
    var s = "("
    var first = true
    for elem in elems do
      if !first then s = s + ", " end
      s = s + fmt_type_expr_to_string(&elem)
      first = false
    end
    s + ")"
  when TypeExprKind::Array(elem, size) then
    match size
    when Option::Some(size_expr) then
      "[" + fmt_type_expr_to_string(&elem) + "; " + format_expr_to_string(&size_expr) + "]"
    when Option::None then
      "[" + fmt_type_expr_to_string(&elem) + "]"
    end
  when TypeExprKind::Slice(elem) then
    "[" + fmt_type_expr_to_string(&elem) + "]"
  when TypeExprKind::Ptr(inner) then
    "Ptr[" + fmt_type_expr_to_string(&inner) + "]"
  when TypeExprKind::PtrMut(inner) then
    "PtrMut[" + fmt_type_expr_to_string(&inner) + "]"
  when TypeExprKind::Ref(inner, mutable) then
    if mutable then "&mut " + fmt_type_expr_to_string(&inner) else "&" + fmt_type_expr_to_string(&inner) end
  when TypeExprKind::Fn(params, ret) then
    var s = "("
    var first = true
    for p in params do
      if !first then s = s + ", " end
      match p.convention
      when AccessConvention::Inout then s = s + "inout "
      when AccessConvention::Sink then s = s + "sink "
      when AccessConvention::Set then s = s + "set "
      when AccessConvention::Let then ()
      end
      s = s + fmt_type_expr_to_string(&p.ty)
      first = false
    end
    s + ") -> " + fmt_type_expr_to_string(&ret)
  when TypeExprKind::Async(inner) then
    "async " + fmt_type_expr_to_string(&inner)
  when TypeExprKind::Effect(name, inner) then
    name.clone() + " " + fmt_type_expr_to_string(&inner)
  when TypeExprKind::Path(path) then path.segments.join("::")
  when TypeExprKind::Infer then "_"
  end  end
end

def format_expr_to_string(expr: Expr) -> String
  var f = formatter_new(default_format_config())
  format_expr(&mut f, expr)
  f.output.clone()
end

# ———————————————————————————————————————————————————————————————
# Import Sorting
# ———————————————————————————————————————————————————————————————

def partition_imports(items: Vec[Item]) -> (Vec[Item], Vec[Item])
  var imports = Vec::new()
  var others = Vec::new()
  
  for item in items do
    match item.kind
    when ItemKind::ItemUse(_) then imports.push(item)
    when _ then others.push(item)
    end
  end
  
  (imports, others)
end

def sort_import_items(imports: Vec[Item], group: Bool) -> Vec[Item]
  imports
end

def import_sort_key(item: Item) -> String
  match item.kind
  when ItemKind::ItemUse(u) then u.path.segments.join("::")
  when _ then ""
  end  end
end

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

# Format a source string using the given configuration.
pub def format_source(source: String, config: FormatConfig) -> Result[String, String]
  let tokens = tokenize(source.clone(), "")
  let parse_out = parse(tokens)
  if !diag_has_errors(&parse_out.diagnostics) then
    var f = formatter_new(duplicate_format_config(config))
    format_program(&mut f, &parse_out.program)
    Result::Ok(f.output)
  else
    # If parsing fails, fall back to line-based formatting
    Result::Ok(format_lines_fallback(source, config))
  end
end

# Format a file in place. Returns true if the file was changed.
pub def format_file(path: String, config: FormatConfig) -> Result[Bool, String]
  match read_file(path.clone())
  when Result::Err(e) then Result::Err("Cannot read: " + e)
  when Result::Ok(source) then
    match format_source(source.clone(), config)
    when Result::Err(e) then Result::Err(e)
    when Result::Ok(formatted) then
      if formatted == source then
        Result::Ok(false)  # No changes
      else
        match write_file(path, formatted)
        when Result::Err(e) then Result::Err("Cannot write: " + e)
        when Result::Ok(_) then Result::Ok(true)
        end
      end
    end
  end  end
end

# Check if a file needs formatting. Returns true if it would change.
pub def format_check(path: String, config: FormatConfig) -> Result[Bool, String]
  match read_file(path)
  when Result::Err(e) then Result::Err("Cannot read: " + e)
  when Result::Ok(source) then
    match format_source(source.clone(), config)
    when Result::Err(e) then Result::Err(e)
    when Result::Ok(formatted) then
      Result::Ok(formatted != source)
    end
  end  end
end

# Line-based fallback formatter (when AST parsing fails)
def format_lines_fallback(source: String, config: FormatConfig) -> String
  var parts: Vec[String] = Vec::new()
  var indent_level: UInt = 0
  var prev_was_blank = false
  
  for line in source.lines() do
    let trimmed = line.trim()
    
    if trimmed.is_empty() then
      if !prev_was_blank then
        parts.push("\n")
        prev_was_blank = true
      end
      next
    end
    prev_was_blank = false
    
    # Decrease indent for closing keywords
    if trimmed.starts_with("end") ||
       trimmed.starts_with("elsif") ||
       trimmed.starts_with("else") ||
       trimmed.starts_with("when") then
      if indent_level > 0 then
        indent_level = indent_level - 1
      end
    end
    
    parts.push(make_indent(config, indent_level) + trimmed + "\n")
    
    # Increase indent after block-opening keywords
    if trimmed.starts_with("def ") ||
       trimmed.starts_with("pub def ") ||
       trimmed.starts_with("struct ") ||
       trimmed.starts_with("pub struct ") ||
       trimmed.starts_with("enum ") ||
       trimmed.starts_with("pub enum ") ||
       trimmed.starts_with("trait ") ||
       trimmed.starts_with("impl ") ||
       trimmed.starts_with("module ") ||
       trimmed.starts_with("if ") ||
       trimmed.starts_with("elsif ") ||
       trimmed == "else" ||
       trimmed.starts_with("match ") ||
       trimmed.starts_with("when ") ||
       trimmed.starts_with("for ") ||
       trimmed.starts_with("while ") ||
       trimmed.starts_with("loop") ||
       trimmed.starts_with("extern ") ||
       trimmed.starts_with("unsafe") then
      indent_level = indent_level + 1
    end
    
    if trimmed.starts_with("when ") && trimmed.contains(" then ") && !trimmed.ends_with("then") then
      indent_level = indent_level - 1
    end
  end
  
  var output = parts.join("")
  if config.ensure_final_newline && !output.ends_with("\n") then
    output = output + "\n"
  end
  
  output
end

# ———————————————————————————————————————————————————————————————
# The Formatter Gate: semantic equivalence + idempotence
# ———————————————————————————————————————————————————————————————
# format_invariant_check(source) is the tool-proof gate the reviewer's
# item 6 demands, asserted over the compiler/std/test tree by
# tests/run_formatter_gate.sh:
#
#   parse(original)                       — must succeed (else skipped)
#   parse(format(original))               — must succeed
#   gate_sig(parse(original))
#       == gate_sig(parse(format(original)))   — SEMANTIC EQUIVALENCE:
#          the structural signature below is an order-sensitive,
#          span/node_id-insensitive shape+content walk — two programs with
#          the same signature are structurally the same program
#   format(format(original)) == format(original) — IDEMPOTENCE

# The signature walkers: every node kind contributes its tag and payload;
# a construct the emitter dropped or altered changes the signature of the
# re-parsed program, so the gate fails.

def gate_sig_vis(vis: Visibility, inout out: String) -> Unit
  match vis
  when Visibility::Public then out = out + "pub"
  when Visibility::Private then out = out + "priv"
  when Visibility::Default then out = out + "def"
  end  end
end

def gate_sig_convention(conv: AccessConvention, inout out: String) -> Unit
  match conv
  when AccessConvention::Let then out = out + "let"
  when AccessConvention::Inout then out = out + "inout"
  when AccessConvention::Sink then out = out + "sink"
  when AccessConvention::Set then out = out + "set"
  end  end
end

def gate_sig_generic_params(params: Vec[GenericParam], inout out: String) -> Unit
  out = out + "g(" + params.len().to_string() + ")"
  for gp in params do
    out = out + gp.name.clone() + ":"
    for bound in gp.bounds do
      gate_sig_type_expr(&bound, &mut out)
    end
    match gp.default
    when Option::Some(d) then
      out = out + "="
      gate_sig_expr(&d, &mut out)
    when Option::None then ()
    end
  end
end

def gate_sig_params(params: Vec[Param], inout out: String) -> Unit
  out = out + "p(" + params.len().to_string() + ")"
  for param in params do
    gate_sig_convention(param.convention, &mut out)
    out = out + param.name.clone() + ":"
    match param.ty
    when Option::Some(ty) then gate_sig_type_expr(&ty, &mut out)
    when Option::None then out = out + "-"
    end
    match param.default
    when Option::Some(d) then
      out = out + "="
      gate_sig_expr(&d, &mut out)
    when Option::None then ()
    end
  end
end

def gate_sig_where_clause(clauses: Vec[WherePredicate], inout out: String) -> Unit
  out = out + "w(" + clauses.len().to_string() + ")"
  for clause in clauses do
    gate_sig_type_expr(&clause.ty, &mut out)
    out = out + ":"
    for bound in clause.bounds do
      gate_sig_type_expr(&bound, &mut out)
    end
  end
end

def gate_sig_function(func: FunctionDecl, inout out: String) -> Unit
  gate_sig_vis(func.vis, &mut out)
  out = out + "fn:" + func.name.clone()
  if func.is_async then out = out + "async" end
  if func.is_unsafe then out = out + "unsafe" end
  if func.is_const then out = out + "const" end
  if func.is_inline then out = out + "inline" end
  if func.is_pure then out = out + "pure" end
  gate_sig_generic_params(func.generic_params, &mut out)
  gate_sig_params(func.params, &mut out)
  match func.ret_type
  when Option::Some(ty) then
    out = out + "->"
    gate_sig_type_expr(&ty, &mut out)
  when Option::None then out = out + "->-"
  end
  gate_sig_where_clause(func.where_clause, &mut out)
  out = out + "e(" + func.effects.len().to_string() + ")"
  for eff in func.effects do
    out = out + eff
  end
  match func.body
  when FnBody::FnBlock(block) then gate_sig_block(&block, &mut out)
  when FnBody::FnExpr(expr) then
    out = out + "="
    gate_sig_expr(&expr, &mut out)
  when FnBody::FnExtern(name) then out = out + "extern:" + name
  when FnBody::FnNone then out = out + "none"
  end
end

def gate_sig_block(block: Block, inout out: String) -> Unit
  out = out + "{"
  for stmt in block.stmts do
    gate_sig_stmt(stmt, &mut out)
  end
  out = out + "}"
end

def gate_sig_if(if_stmt: IfStmt, inout out: String) -> Unit
  out = out + "if:"
  gate_sig_expr(&if_stmt.cond, &mut out)
  gate_sig_block(&if_stmt.then_block, &mut out)
  out = out + "elsif(" + if_stmt.elsif_branches.len().to_string() + ")"
  for (econd, ebody) in if_stmt.elsif_branches do
    gate_sig_expr(&econd, &mut out)
    gate_sig_block(&ebody, &mut out)
  end
  match if_stmt.else_block
  when Option::Some(e) then
    out = out + "else"
    gate_sig_block(&e, &mut out)
  when Option::None then ()
  end
end

def gate_sig_match(m: MatchExpr, inout out: String) -> Unit
  out = out + "match:"
  gate_sig_expr(&m.scrutinee, &mut out)
  out = out + "arms(" + m.arms.len().to_string() + ")"
  for arm in m.arms do
    gate_sig_pattern(&arm.pattern, &mut out)
    match arm.guard_expr
    when Option::Some(g) then
      out = out + "if"
      gate_sig_expr(&g, &mut out)
    when Option::None then ()
    end
    gate_sig_block(&arm.body, &mut out)
  end
end

def gate_sig_stmt(stmt: Stmt, inout out: String) -> Unit
  match stmt.kind
  when StmtKind::StmtLet(pattern, ty_opt, init, is_mut) then
    out = out + "let" + if is_mut then "mut" else "" end
    gate_sig_pattern(&pattern, &mut out)
    match ty_opt
    when Option::Some(ty) then
      out = out + ":"
      gate_sig_type_expr(&ty, &mut out)
    when Option::None then ()
    end
    out = out + "="
    gate_sig_expr(&init, &mut out)
  when StmtKind::StmtAssign(target, value) then
    out = out + "assign:"
    gate_sig_expr(&target, &mut out)
    out = out + "="
    gate_sig_expr(&value, &mut out)
  when StmtKind::StmtCompoundAssign(op, target, value) then
    out = out + "opassign:" + binop_symbol(op)
    gate_sig_expr(&target, &mut out)
    gate_sig_expr(&value, &mut out)
  when StmtKind::StmtIf(if_stmt) then gate_sig_if(&if_stmt, &mut out)
  when StmtKind::StmtMatch(m) then gate_sig_match(&m, &mut out)
  when StmtKind::StmtWhile(cond, body) then
    out = out + "while:"
    gate_sig_expr(&cond, &mut out)
    gate_sig_block(&body, &mut out)
  when StmtKind::StmtFor(for_stmt) then
    out = out + "for:"
    gate_sig_pattern(&for_stmt.pattern, &mut out)
    out = out + "in"
    gate_sig_expr(&for_stmt.iter, &mut out)
    gate_sig_block(&for_stmt.body, &mut out)
  when StmtKind::StmtLoop(body) then
    out = out + "loop"
    gate_sig_block(&body, &mut out)
  when StmtKind::StmtReturn(val) then
    out = out + "return"
    match val
    when Option::Some(v) then
      out = out + ":"
      gate_sig_expr(&v, &mut out)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(val) then
    out = out + "break"
    match val
    when Option::Some(v) then
      out = out + ":"
      gate_sig_expr(&v, &mut out)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then out = out + "next"
  when StmtKind::StmtExpr(expr) then gate_sig_expr(&expr, &mut out)
  when StmtKind::StmtUnsafe(reason, body) then
    out = out + "unsafe"
    match reason
    when Option::Some(r) then out = out + ":" + r
    when Option::None then ()
    end
    gate_sig_block(&body, &mut out)
  when StmtKind::StmtDefer(body) then
    out = out + "defer"
    gate_sig_block(&body, &mut out)
  when StmtKind::StmtGuard(cond, else_action) then
    out = out + "guard:"
    gate_sig_expr(&cond, &mut out)
    out = out + "else"
    match else_action
    when GuardElse::Return(val_opt) then
      out = out + "return"
      match val_opt
      when Option::Some(v) then gate_sig_expr(&v, &mut out)
      when Option::None then ()
      end
    when GuardElse::Break(val_opt) then
      out = out + "break"
      match val_opt
      when Option::Some(v) then gate_sig_expr(&v, &mut out)
      when Option::None then ()
      end
    when GuardElse::Continue then out = out + "next"
    when GuardElse::Panic(msg) then out = out + "panic:" + msg
    end
  when StmtKind::StmtTry(body, catches, finally_opt) then
    out = out + "try"
    gate_sig_block(&body, &mut out)
    out = out + "catch(" + catches.len().to_string() + ")"
    for catch_arm in catches do
      gate_sig_pattern(&catch_arm.pattern, &mut out)
      gate_sig_block(&catch_arm.body, &mut out)
    end
    match finally_opt
    when Option::Some(fin) then
      out = out + "finally"
      gate_sig_block(&fin, &mut out)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, pat, body) then
    out = out + "with"
    gate_sig_pattern(&pat, &mut out)
    out = out + "="
    gate_sig_expr(&expr, &mut out)
    gate_sig_block(&body, &mut out)
  when StmtKind::StmtHandleWith(expr, handlers) then
    out = out + "handle"
    gate_sig_expr(&expr, &mut out)
    out = out + "with(" + handlers.len().to_string() + ")"
    for handler in handlers do
      out = out + ":" + handler.effect_name.clone() + "(" + handler.arms.len().to_string() + ")"
      for arm in handler.arms do
        out = out + arm.operation.clone() + "(" + arm.params.len().to_string() + ")"
        for p in arm.params do
          gate_sig_pattern(&p, &mut out)
        end
        gate_sig_block(&arm.body, &mut out)
      end
    end
  end  end
end

def gate_sig_pattern(pat: Pattern, inout out: String) -> Unit
  match pat.kind
  when PatternKind::Wildcard then out = out + "_"
  when PatternKind::Ident(name, is_mut) then
    out = out + if is_mut then "mut" else "" end + "id:" + name
  when PatternKind::Literal(lit) then
    out = out + "lit:"
    gate_sig_expr(&lit, &mut out)
  when PatternKind::Tuple(pats) then
    out = out + "tuple(" + pats.len().to_string() + ")"
    for p in pats do
      gate_sig_pattern(&p, &mut out)
    end
  when PatternKind::Array(pats) then
    out = out + "arrpat(" + pats.len().to_string() + ")"
    for p in pats do
      gate_sig_pattern(&p, &mut out)
    end
  when PatternKind::Struct(path, fields) then
    out = out + "structpat:" + path.segments.join("::") + "(" + fields.len().to_string() + ")"
    for (field_name, field_pat) in fields do
      out = out + field_name + ":"
      gate_sig_pattern(&field_pat, &mut out)
    end
  when PatternKind::Variant(path, pats) then
    out = out + "variant:" + path.segments.join("::") + "(" + pats.len().to_string() + ")"
    for p in pats do
      gate_sig_pattern(&p, &mut out)
    end
  when PatternKind::Or(pats) then
    out = out + "or(" + pats.len().to_string() + ")"
    for p in pats do
      gate_sig_pattern(&p, &mut out)
    end
  when PatternKind::Range(start, end_val, inclusive) then
    out = out + "range" + if inclusive then "=" else "" end
    match start
    when Option::Some(s) then gate_sig_expr(&s, &mut out)
    when Option::None then ()
    end
    match end_val
    when Option::Some(e) then gate_sig_expr(&e, &mut out)
    when Option::None then ()
    end
  end  end
end

def gate_sig_type_expr(ty: TypeExpr, inout out: String) -> Unit
  match ty.kind
  when TypeExprKind::Named(name, args) then
    out = out + "T:" + name + "(" + args.len().to_string() + ")"
    for a in args do
      gate_sig_type_expr(&a, &mut out)
    end
  when TypeExprKind::Unit then out = out + "Unit"
  when TypeExprKind::Never then out = out + "Never"
  when TypeExprKind::Tuple(elems) then
    out = out + "Tup(" + elems.len().to_string() + ")"
    for e in elems do
      gate_sig_type_expr(&e, &mut out)
    end
  when TypeExprKind::Array(elem, size) then
    out = out + "Arr["
    gate_sig_type_expr(&elem, &mut out)
    match size
    when Option::Some(size_expr) then
      out = out + ";"
      gate_sig_expr(&size_expr, &mut out)
    when Option::None then ()
    end
    out = out + "]"
  when TypeExprKind::Slice(elem) then
    out = out + "Slice["
    gate_sig_type_expr(&elem, &mut out)
    out = out + "]"
  when TypeExprKind::Ptr(inner) then
    out = out + "Ptr["
    gate_sig_type_expr(&inner, &mut out)
    out = out + "]"
  when TypeExprKind::PtrMut(inner) then
    out = out + "PtrMut["
    gate_sig_type_expr(&inner, &mut out)
    out = out + "]"
  when TypeExprKind::Ref(inner, mutable) then
    out = out + if mutable then "&mut" else "&" end
    gate_sig_type_expr(&inner, &mut out)
  when TypeExprKind::Fn(params, ret) then
    out = out + "Fn(" + params.len().to_string() + ")"
    for p in params do
      gate_sig_convention(p.convention, &mut out)
      gate_sig_type_expr(&p.ty, &mut out)
    end
    out = out + "->"
    gate_sig_type_expr(&ret, &mut out)
  when TypeExprKind::Async(inner) then
    out = out + "async"
    gate_sig_type_expr(&inner, &mut out)
  when TypeExprKind::Effect(name, inner) then
    out = out + "effect:" + name
    gate_sig_type_expr(&inner, &mut out)
  when TypeExprKind::Path(path) then out = out + "TPath:" + path.segments.join("::")
  when TypeExprKind::Infer then out = out + "_"
  end  end
end

def gate_sig_expr(expr: Expr, inout out: String) -> Unit
  match expr.kind
  when ExprKind::ExprIntLit(n) then
    out = out + "int(" + parsed_int_spelling(&n) + ")"
  when ExprKind::ExprFloatLit(n) then
    out = out + "float(" + parsed_float_spelling(&n) + ")"
  when ExprKind::ExprStringLit(s) then
    out = out + "str(" + escape_string_content(&s) + ")"
  when ExprKind::ExprCharLit(c) then
    out = out + "char(" + escape_char_content(c) + ")"
  when ExprKind::ExprBoolLit(b) then
    out = out + if b then "true" else "false" end
  when ExprKind::ExprNilLit then out = out + "nil"
  when ExprKind::ExprArrayLit(elems) then
    out = out + "arr(" + elems.len().to_string() + ")"
    for e in elems do
      gate_sig_expr(&e, &mut out)
    end
  when ExprKind::ExprTupleLit(elems) then
    out = out + "tup(" + elems.len().to_string() + ")"
    for e in elems do
      gate_sig_expr(&e, &mut out)
    end
  when ExprKind::ExprStructLit(path, fields) then
    out = out + "struct:" + path.segments.join("::") + "(" + fields.len().to_string() + ")"
    for (field_name, field_value) in fields do
      out = out + field_name + ":"
      gate_sig_expr(&field_value, &mut out)
    end
  when ExprKind::ExprMapLit(entries) then
    out = out + "map(" + entries.len().to_string() + ")"
    for (key, value) in entries do
      gate_sig_expr(&key, &mut out)
      out = out + "=>"
      gate_sig_expr(&value, &mut out)
    end
  when ExprKind::ExprIdent(name) then out = out + "id:" + name
  when ExprKind::ExprPath(path) then out = out + "path:" + path.segments.join("::")
  when ExprKind::ExprSelfRef then out = out + "self"
  when ExprKind::ExprBinaryOp(op, left, right) then
    out = out + "("
    gate_sig_expr(left, &mut out)
    out = out + binop_symbol(op)
    gate_sig_expr(right, &mut out)
    out = out + ")"
  when ExprKind::ExprUnaryOp(op, operand) then
    out = out + "(" + unop_symbol(op)
    gate_sig_expr(operand, &mut out)
    out = out + ")"
  when ExprKind::ExprFieldAccess(obj, field) then
    gate_sig_expr(obj, &mut out)
    out = out + "." + field
  when ExprKind::ExprMethodCall(receiver, method, type_args, args) then
    gate_sig_expr(receiver, &mut out)
    out = out + "." + method + "(" + type_args.len().to_string() + "," + args.len().to_string() + ")"
    for ta in type_args do
      gate_sig_type_expr(&ta, &mut out)
    end
    for a in args do
      gate_sig_expr(&a, &mut out)
    end
  when ExprKind::ExprIndex(arr, idx) then
    gate_sig_expr(arr, &mut out)
    out = out + "["
    gate_sig_expr(idx, &mut out)
    out = out + "]"
  when ExprKind::ExprCall(callee, args) then
    gate_sig_expr(callee, &mut out)
    out = out + "(" + args.len().to_string() + ")"
    for a in args do
      gate_sig_expr(&a, &mut out)
    end
  when ExprKind::ExprClosure(params, ret_ty, body) then
    out = out + "|"
    for param in params do
      gate_sig_pattern(&param.pat, &mut out)
      match param.ty
      when Option::Some(param_ty) then
        out = out + ":"
        gate_sig_type_expr(&param_ty, &mut out)
      when Option::None then ()
      end
    end
    out = out + "|"
    match ret_ty
    when Option::Some(ret_type) then
      out = out + "->"
      gate_sig_type_expr(&ret_type, &mut out)
    when Option::None then ()
    end
    gate_sig_expr(body, &mut out)
  when ExprKind::ExprAccess(inner) then
    out = out + "&"
    gate_sig_expr(inner, &mut out)
  when ExprKind::ExprRawDeref(inner) then
    out = out + "*"
    gate_sig_expr(inner, &mut out)
  when ExprKind::ExprIf(if_stmt) then gate_sig_if(&if_stmt, &mut out)
  when ExprKind::ExprMatch(m) then gate_sig_match(&m, &mut out)
  when ExprKind::ExprBlock(block) then
    out = out + "do"
    gate_sig_block(&block, &mut out)
    out = out + "end"
  when ExprKind::ExprUnsafe(justification, block) then
    out = out + "unsafe"
    match justification
    when Option::Some(reason) then out = out + ":" + reason
    when Option::None then ()
    end
    gate_sig_block(&block, &mut out)
    out = out + "end"
  when ExprKind::ExprAsync(block) then
    out = out + "async"
    gate_sig_block(&block, &mut out)
    out = out + "end"
  when ExprKind::ExprAwait(inner) then
    out = out + "await"
    gate_sig_expr(inner, &mut out)
  when ExprKind::ExprTry(inner) then
    gate_sig_expr(inner, &mut out)
    out = out + "?"
  when ExprKind::ExprRange(start_opt, end_opt, inclusive) then
    out = out + "range" + if inclusive then "=" else "" end
    match start_opt
    when Option::Some(s) then gate_sig_expr(&s, &mut out)
    when Option::None then ()
    end
    match end_opt
    when Option::Some(e) then gate_sig_expr(&e, &mut out)
    when Option::None then ()
    end
  when ExprKind::ExprCast(val, ty) then
    gate_sig_expr(val, &mut out)
    out = out + "as"
    gate_sig_type_expr(&ty, &mut out)
  when ExprKind::ExprTypeCheck(val, ty) then
    gate_sig_expr(val, &mut out)
    out = out + "is"
    gate_sig_type_expr(&ty, &mut out)
  when ExprKind::ExprComptime(block) then
    out = out + "comptime"
    gate_sig_block(&block, &mut out)
    out = out + "end"
  when ExprKind::ExprEnumVariant(path, args) then
    out = out + "enumvar:" + path.segments.join("::") + "(" + args.len().to_string() + ")"
    for a in args do
      gate_sig_expr(&a, &mut out)
    end
  when ExprKind::ExprAssign(target, value) then
    gate_sig_expr(target, &mut out)
    out = out + "="
    gate_sig_expr(value, &mut out)
  when ExprKind::ExprPipe(left, right) then
    gate_sig_expr(left, &mut out)
    out = out + "|>"
    gate_sig_expr(right, &mut out)
  when ExprKind::ExprMacroCall(name, args) then
    out = out + "macro!" + name + "(" + args.len().to_string() + ")"
    for a in args do
      gate_sig_expr(&a, &mut out)
    end
  when ExprKind::ExprError(msg) then out = out + "err:" + msg
  end  end
end

def gate_sig_item(item: Item, inout out: String) -> Unit
  out = out + "attrs(" + item.attrs.len().to_string() + ")"
  for attr in item.attrs do
    out = out + "@" + attr.name.clone() + "(" + attr.args.len().to_string() + ")"
    for a in attr.args do
      out = out + a
    end
  end
  match item.kind
  when ItemKind::ItemUse(u) then
    out = out + "use"
    gate_sig_vis(u.vis, &mut out)
    out = out + ":" + u.path.segments.join("::")
    if u.glob then out = out + "::*" end
    match u.names
    when Option::Some(names) then
      out = out + "::{" + names.len().to_string() + "}"
      for n in names do
        out = out + n
      end
    when Option::None then ()
    end
    match u.alias_name
    when Option::Some(alias_name) then out = out + "as" + alias_name
    when Option::None then ()
    end
  when ItemKind::ItemFunction(func) then gate_sig_function(func, &mut out)
  when ItemKind::ItemStruct(s) then
    gate_sig_vis(s.vis, &mut out)
    out = out + "struct:" + s.name.clone()
    match s.kind
    when NominalKind::Value then ()
    when NominalKind::Resource then out = out + "resource"
    end
    gate_sig_generic_params(s.generic_params, &mut out)
    out = out + "fields(" + s.fields.len().to_string() + ")"
    for fld in s.fields do
      gate_sig_vis(fld.vis, &mut out)
      out = out + fld.name.clone() + ":"
      gate_sig_type_expr(&fld.ty, &mut out)
      match fld.default
      when Option::Some(d) then
        out = out + "="
        gate_sig_expr(&d, &mut out)
      when Option::None then ()
      end
    end
    out = out + "derives(" + s.derives.len().to_string() + ")"
    for d in s.derives do
      out = out + d
    end
    out = out + "methods(" + s.methods.len().to_string() + ")"
    for m in s.methods do
      gate_sig_function(m, &mut out)
    end
  when ItemKind::ItemEnum(e) then
    gate_sig_vis(e.vis, &mut out)
    out = out + "enum:" + e.name.clone()
    gate_sig_generic_params(e.generic_params, &mut out)
    out = out + "variants(" + e.variants.len().to_string() + ")"
    for v in e.variants do
      out = out + v.name.clone() + "(" + v.fields.len().to_string() + ")"
      for fty in v.fields do
        gate_sig_type_expr(&fty, &mut out)
      end
      out = out + "names(" + v.field_names.len().to_string() + ")"
      for fn_opt in v.field_names do
        match fn_opt
        when Option::Some(n) then out = out + n
        when Option::None then out = out + "-"
        end
      end
      match v.discriminant
      when Option::Some(d) then
        out = out + "="
        gate_sig_expr(&d, &mut out)
      when Option::None then ()
      end
    end
    out = out + "derives(" + e.derives.len().to_string() + ")"
    for d in e.derives do
      out = out + d
    end
  when ItemKind::ItemTrait(t) then
    gate_sig_vis(t.vis, &mut out)
    out = out + "trait:" + t.name.clone()
    gate_sig_generic_params(t.generic_params, &mut out)
    out = out + "super(" + t.super_traits.len().to_string() + ")"
    for st in t.super_traits do
      gate_sig_type_expr(&st, &mut out)
    end
    out = out + "methods(" + t.methods.len().to_string() + ")"
    for m in t.methods do
      out = out + m.sig.name.clone()
      gate_sig_generic_params(m.sig.generic_params, &mut out)
      gate_sig_params(m.sig.params, &mut out)
      match m.sig.ret_type
      when Option::Some(ty) then
        out = out + "->"
        gate_sig_type_expr(&ty, &mut out)
      when Option::None then ()
      end
      match m.default_body
      when FnBody::FnBlock(block) then gate_sig_block(&block, &mut out)
      when FnBody::FnExpr(expr) then
        out = out + "="
        gate_sig_expr(&expr, &mut out)
      when _ then ()
      end
    end
    out = out + "assoc(" + t.assoc_types.len().to_string() + ")"
    for at in t.assoc_types do
      out = out + at.name.clone() + ":bounds(" + at.bounds.len().to_string() + ")"
      for bound in at.bounds do
        gate_sig_type_expr(&bound, &mut out)
      end
      match at.default
      when Option::Some(ty) then
        out = out + "="
        gate_sig_type_expr(&ty, &mut out)
      when Option::None then ()
      end
    end
  when ItemKind::ItemImpl(imp) then
    gate_sig_vis(imp.vis, &mut out)
    out = out + "impl"
    gate_sig_generic_params(imp.generic_params, &mut out)
    match imp.trait_name
    when Option::Some(tname) then out = out + "for:" + tname
    when Option::None then ()
    end
    for ta in imp.trait_type_args do
      gate_sig_type_expr(&ta, &mut out)
    end
    gate_sig_type_expr(&imp.for_type, &mut out)
    gate_sig_type_expr(&imp.self_type, &mut out)
    gate_sig_where_clause(imp.where_clause, &mut out)
    out = out + "methods(" + imp.methods.len().to_string() + ")"
    for m in imp.methods do
      gate_sig_function(m, &mut out)
    end
    out = out + "assoc(" + imp.assoc_types.len().to_string() + ")"
    for at in imp.assoc_types do
      out = out + at.name.clone() + ":"
      gate_sig_type_expr(&at.ty, &mut out)
    end
  when ItemKind::ItemModule(m) then
    gate_sig_vis(m.vis, &mut out)
    out = out + "module:" + m.name.clone()
    if m.is_inline then out = out + "inline" end
    out = out + "items(" + m.items.len().to_string() + ")"
    for inner in m.items do
      gate_sig_item(&inner, &mut out)
    end
  when ItemKind::ItemMacro(mac) then
    gate_sig_vis(mac.vis, &mut out)
    out = out + "macro:" + mac.name.clone() + "(" + mac.params.len().to_string() + ")"
    for p in mac.params do
      out = out + p.name.clone()
    end
    gate_sig_block(&mac.body, &mut out)
  when ItemKind::ItemTypeAlias(ta) then
    gate_sig_vis(ta.vis, &mut out)
    out = out + "type:" + ta.name.clone()
    gate_sig_generic_params(ta.generic_params, &mut out)
    out = out + "="
    gate_sig_type_expr(&ta.ty, &mut out)
  when ItemKind::ItemConst(c) then
    gate_sig_vis(c.vis, &mut out)
    out = out + "const:" + c.name.clone()
    match c.ty
    when Option::Some(ty) then
      out = out + ":"
      gate_sig_type_expr(&ty, &mut out)
    when Option::None then ()
    end
    out = out + "="
    gate_sig_expr(&c.value, &mut out)
  when ItemKind::ItemStatic(s) then
    gate_sig_vis(s.vis, &mut out)
    out = out + "static:" + s.name.clone()
    if s.is_mut then out = out + "mut" end
    out = out + ":"
    gate_sig_type_expr(&s.ty, &mut out)
    out = out + "="
    gate_sig_expr(&s.value, &mut out)
  when ItemKind::ItemCapabilityDecl(c) then
    gate_sig_vis(c.vis, &mut out)
    out = out + "capability:" + c.name.clone()
    match c.parent
    when Option::Some(parent) then out = out + ":" + parent
    when Option::None then ()
    end
    out = out + "perms(" + c.permissions.len().to_string() + ")"
    for p in c.permissions do
      out = out + p
    end
  when ItemKind::ItemEffectDecl(e) then
    gate_sig_vis(e.vis, &mut out)
    out = out + "effect:" + e.name.clone()
    match e.parent
    when Option::Some(parent) then out = out + ":" + parent
    when Option::None then ()
    end
  when ItemKind::ItemRationaleBlock(r) then
    out = out + "rationale:" + r.title.clone() + "|" + r.body.clone() + "|"
    match r.author
    when Option::Some(author) then out = out + "author:" + author
    when Option::None then ()
    end
    out = out + "tags(" + r.tags.len().to_string() + ")"
    for tag in r.tags do
      out = out + tag
    end
  when ItemKind::ItemEditionDecl(ed) then
    out = out + "edition:" + ed.version.clone()
  when ItemKind::ItemExternBlock(ext) then
    out = out + "extern"
    match ext.abi
    when Option::Some(abi) then out = out + ":" + abi
    when Option::None then ()
    end
    out = out + "items(" + ext.items.len().to_string() + ")"
    for item in ext.items do
      match item
      when ExternItem::Function(efn) then
        out = out + "fnextern:" + efn.name.clone()
        gate_sig_generic_params(efn.generic_params, &mut out)
        gate_sig_params(efn.params, &mut out)
        match efn.ret_type
        when Option::Some(ty) then
          out = out + "->"
          gate_sig_type_expr(&ty, &mut out)
        when Option::None then ()
        end
      when ExternItem::Static(es) then
        out = out + "staticextern:" + es.name.clone()
        if es.is_mut then out = out + "mut" end
        out = out + ":"
        gate_sig_type_expr(&es.ty, &mut out)
      end
    end
  end
end

# The full structural signature of a parsed program.
def gate_signature(program: Program) -> String
  var out = ""
  gate_sig_program(&program, &mut out)
  out
end

def gate_sig_program(program: Program, inout out: String) -> Unit
  out = out + "P(" + program.items.len().to_string() + "){"
  for item in program.items do
    gate_sig_item(&item, &mut out)
  end
  out = out + "}"
end

# The tool-proof gate for one source: Result::Ok(()) when the source holds
# the invariants, Result::Err(description) on a violation. A source that
# does not parse is NOT part of the gate (Result::Ok — the harness counts
# it as skipped).
pub def format_invariant_check(source: String) -> Result[Unit, String]
  let lex_result = tokenize(source.clone(), "")
  let parse_out = parse(lex_result)
  if diag_has_errors(&parse_out.diagnostics) then
    return Result::Ok(())
  end
  let original = parse_out.program

  let formatted = match format_source(source.clone(), default_format_config())
  when Result::Err(e) then return Result::Err("format failed: " + e)
  when Result::Ok(f) then f
  end

  let lex2 = tokenize(formatted.clone(), "")
  let parse2 = parse(lex2)
  if diag_has_errors(&parse2.diagnostics) then
    return Result::Err("formatted output does not reparse")
  end

  let original_sig = gate_signature(original)
  let formatted_sig = gate_signature(parse2.program)
  if original_sig != formatted_sig then
    return Result::Err("semantic-equivalence violation: parse(original) != parse(format(original))")
  end

  let reformatted = match format_source(formatted.clone(), default_format_config())
  when Result::Err(e) then return Result::Err("reformat failed: " + e)
  when Result::Ok(f) then f
  end
  if reformatted != formatted then
    return Result::Err("idempotence violation: format(format(original)) != format(original)")
  end

  Result::Ok(())
end
