# tg_compiler/identity_probe.tg — focused probe (persistent identity
# integration). It exercises the identity layer the mono cache binds and
# hashes:
#
#   (1) a rename/move with an explicit DeclContinuation keeps the
#       StructuralInstanceId byte-identical (the persistent path);
#   (2) the index-free registration-scope structural records of the old
#       and new spelling RE-KEY the StructuralInstanceId (the ephemeral
#       path's documented behavior);
#   (3) the P0-4 MEMBER lineage: re-stamping an unchanged member keeps its
#       lineage; an explicit member-rename continuation keeps it; an
#       unrelated new member is fresh;
#   (4) the P1-2 PERSISTENT HIR identity: an unrelated source/HIR node
#       inserted before an existing call node (renumbering its parse
#       locator) through the same store keeps the existing node's
#       store-backed lineage — and its StableSemanticNodeId is
#       byte-identical.
#
# main returns 0 iff every check holds (1..7 = the first failing check).
# Run through the seed closure harness (stage0_ocaml):
#
#   cd stage0_ocaml && _build/default/selfcheck/tg_identity.exe

use std::core::{Option, Result}
use std::collections::{Vec}

use tg_compiler::ids::{stable_digest_of}
use tg_compiler::stable_ids::{
  StableDeclId, DeclLineageStore, stable_lineage_store_new,
  stable_lineage_store_begin_revision, stable_lineage_store_finish_revision,
  stable_decl_stamp_or_continue, stable_lineage_scope_key,
  stable_lineage_store_add_continuation,
  stable_member_scope_key, stable_lineage_store_member_add_continuation,
  stable_member_lineage_stamp, MemberLineageId,
  StructuralInstanceId, structural_instance_id_of_renders,
  stable_structural_callable_decl_of,
  # (P1-2) the pre-lowering persistent HIR-node view + the HIR-anchored
  # semantic identity the cross-build insertion regression pins.
  HirNodeLineageView, hir_node_lineage_view_new, hir_node_lineage_view_bind,
  hir_node_lineage_view_get, stable_hir_node_lineage_stamp,
  stable_hir_node_id_of,
  StableSemanticNodeId, stable_semantic_node_id_of_origin,
  stable_semantic_node_key_text, MirNodeOrigin
}

# Stamp one Function declaration through the store in its OWN revision
# (the snapshot builder's per-build window).
def probe_stamp_decl(inout store: DeclLineageStore, module_path: String, name: String) -> StableDeclId
  stable_lineage_store_begin_revision(store)
  let sig = "fn()->unit".to_string()
  let d = stable_digest_of(&sig)
  let live = Vec::from([
    stable_lineage_scope_key("".to_string(), module_path.clone(), "Function".to_string(), name.clone())
  ])
  let decl = stable_decl_stamp_or_continue(store, "".to_string(), module_path, "Function".to_string(),
    name, d.hi, d.lo, sig, live)
  stable_lineage_store_finish_revision(store)
  decl
end

# The structural instance id of one callable record with the arg render
# ["int"] (the identity preimage the mono cache hashes).
def probe_instance(decl: StableDeclId) -> StructuralInstanceId
  structural_instance_id_of_renders(decl, Vec::from(["int".to_string()]))
end

def probe_same_instance(a: StructuralInstanceId, b: StructuralInstanceId) -> Bool
  a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo
end

# Stamp one field member; returns its persistent MemberLineageId.
def probe_stamp_member(inout store: DeclLineageStore, owner: StableDeclId, owner_key: String, name: String) -> MemberLineageId
  let key = stable_member_scope_key("".to_string(), owner_key.clone(), "field".to_string(), name.clone())
  stable_member_lineage_stamp(store, "".to_string(), owner_key, owner, "field".to_string(),
    name, 0, 0, "".to_string(), Vec::from([key]))
end

# (P1-2) ONE build's pre-lowering HIR-node view: stamp every (locator,
# CONTENT anchor) pair through the shared store and bind the store-backed
# record at that locator. The anchor is the node's content key — the store
# row is found by anchor, so a renumbered locator in build B maps to the
# SAME persistent lineage.
def probe_hir_view_build(
  inout store: DeclLineageStore,
  owner: StableDeclId,
  owner_key: String,
  seqs: Vec[Int],
  anchors: Vec[String]
) -> HirNodeLineageView
  var view = hir_node_lineage_view_new()
  var i = 0
  while i < seqs.len() do
    let id = stable_hir_node_lineage_stamp(store, owner.clone(), owner_key.clone(),
      seqs[i], anchors[i].clone(), 0, 0, anchors[i].clone())
    hir_node_lineage_view_bind(&mut view, seqs[i], id)
    i = i + 1
  end
  view
end

# The HIR-anchored StableSemanticNodeId of the node bound at `seq` in a
# build view — the SAME derivation the semantic slice's primary path runs
# (stable_semantic_node_id_of_origin over the typed FromHir provenance).
def probe_hir_semantic_id(view: HirNodeLineageView, fn_key: String, seq: Int) -> Option[StableSemanticNodeId]
  match hir_node_lineage_view_get(view, seq)
  when Option::Some(hir) then
    Option::Some(stable_semantic_node_id_of_origin(
      fn_key.clone(),
      MirNodeOrigin::FromHir(hir, "call".to_string(), 0),
      "call".to_string(),
      "".to_string(),
      Vec::new()
    ))
  when Option::None then Option::None
  end
end

def probe_hir_same_semantic(a: StableSemanticNodeId, b: StableSemanticNodeId) -> Bool
  a.digest_hi == b.digest_hi && a.digest_lo == b.digest_lo &&
  stable_semantic_node_key_text(a) == stable_semantic_node_key_text(b)
end

def main() -> Int
  var store = stable_lineage_store_new()
  # (1) persistent rename continuity: a::generic -> b::generic through an
  # explicit continuation.
  let old = probe_stamp_decl(&mut store, "a".to_string(), "generic".to_string())
  let before = probe_instance(old.clone())
  let old_scope = stable_lineage_scope_key("".to_string(), "a".to_string(), "Function".to_string(), "generic".to_string())
  let new_scope = stable_lineage_scope_key("".to_string(), "b".to_string(), "Function".to_string(), "generic".to_string())
  stable_lineage_store_add_continuation(&mut store, old.lineage.lineage, old_scope, new_scope, "rename".to_string())
  let renamed = probe_stamp_decl(&mut store, "b".to_string(), "generic".to_string())
  let after = probe_instance(renamed.clone())
  if !probe_same_instance(before, after) then
    return 1
  end
  # (2) the ephemeral registration-scope records re-key on the rename.
  let struct_a = stable_structural_callable_decl_of("".to_string(), "a".to_string(), "fn".to_string(),
    "generic".to_string(), "a::generic".to_string())
  let struct_b = stable_structural_callable_decl_of("".to_string(), "b".to_string(), "fn".to_string(),
    "generic".to_string(), "b::generic".to_string())
  if probe_same_instance(probe_instance(struct_a), probe_instance(struct_b)) then
    return 2
  end
  # (3) member lineage continuity.
  let owner_key = old.digest_hi.to_string() + "-" + old.digest_lo.to_string()
  let _m_a = probe_stamp_member(&mut store, old.clone(), owner_key.clone(), "a".to_string())
  let m_b = probe_stamp_member(&mut store, old.clone(), owner_key.clone(), "b".to_string())
  let m_b_again = probe_stamp_member(&mut store, old.clone(), owner_key.clone(), "b".to_string())
  if m_b_again.lineage != m_b.lineage then
    return 3
  end
  let m_old_loc = stable_member_scope_key("".to_string(), owner_key.clone(), "field".to_string(), "b".to_string())
  let m_new_loc = stable_member_scope_key("".to_string(), owner_key.clone(), "field".to_string(), "renamed_b".to_string())
  stable_lineage_store_member_add_continuation(&mut store, m_b.lineage, m_old_loc, m_new_loc, "rename".to_string())
  let m_renamed = probe_stamp_member(&mut store, old.clone(), owner_key.clone(), "renamed_b".to_string())
  if m_renamed.lineage != m_b.lineage then
    return 4
  end
  let m_new = probe_stamp_member(&mut store, old.clone(), owner_key.clone(), "unrelated".to_string())
  if m_new.lineage == m_b.lineage then
    return 5
  end
  # (6) (P1-2) the PERSISTENT HIR identity across an unrelated insertion:
  # build A stamps the existing call node's content anchor at locator 101;
  # build B inserts an unrelated node before it (fresh content anchor, the
  # existing node's locator renumbered to 999) through the SAME store. The
  # existing node must keep its store-backed lineage, and its
  # StableSemanticNodeId must be byte-identical.
  var hir_store = stable_lineage_store_new()
  stable_lineage_store_begin_revision(&mut hir_store)
  let hir_sig = "fn()->unit".to_string()
  let hir_d = stable_digest_of(&hir_sig)
  let hir_scope = stable_lineage_scope_key("".to_string(), "m".to_string(), "Function".to_string(), "hirprobe".to_string())
  let hir_owner = stable_decl_stamp_or_continue(&mut hir_store, "".to_string(), "m".to_string(),
    "Function".to_string(), "hirprobe".to_string(), hir_d.hi, hir_d.lo, hir_sig,
    Vec::from([hir_scope]))
  let hir_owner_key = hir_owner.digest_hi.to_string() + "-" + hir_owner.digest_lo.to_string()
  let view_a = probe_hir_view_build(&mut hir_store, hir_owner.clone(), hir_owner_key.clone(),
    Vec::from([101, 202]),
    Vec::from(["call|first".to_string(), "stmt|body".to_string()]))
  let view_b = probe_hir_view_build(&mut hir_store, hir_owner.clone(), hir_owner_key.clone(),
    Vec::from([50, 999, 202]),
    Vec::from(["call|unrelated".to_string(), "call|first".to_string(), "stmt|body".to_string()]))
  stable_lineage_store_finish_revision(&mut hir_store)
  let hir_fn_key = "m::hirprobe".to_string()
  match probe_hir_semantic_id(view_a, hir_fn_key.clone(), 101)
  when Option::Some(sid_a) then
    match probe_hir_semantic_id(view_b, hir_fn_key.clone(), 999)
    when Option::Some(sid_b) then
      if !probe_hir_same_semantic(sid_a.clone(), sid_b.clone()) then
        return 6
      end
      # The persistent id is not the sequence-derived synthetic fallback.
      let synthetic = stable_semantic_node_id_of_origin(
        hir_fn_key.clone(),
        MirNodeOrigin::FromHir(stable_hir_node_id_of(hir_owner.clone(), 101), "call".to_string(), 0),
        "call".to_string(),
        "".to_string(),
        Vec::new()
      )
      if stable_semantic_node_key_text(sid_a) == stable_semantic_node_key_text(synthetic) then
        return 7
      end
    when Option::None then
      return 6
    end
  when Option::None then
    return 6
  end
  0
end
