# provlirprobe.tg — the in-VM LIR-boundary leg of the P0-7 provenance
# lowered-insertion lane (mir_origin_insertion_lane_check's companion).
#
# The identity lane proves B's stable id survives an unrelated origin-less
# call insertion across the O2 optimizer on the MIR side. THIS probe runs
# the same optimized function through the real LIR lowering and the LIR
# verifier, and asserts B's MIR origin key is unchanged at that boundary:
#   lower_to_mir-shape -> optimize O2 -> lower_mir_fn_to_lir_mode -> verify_lir.
#
# Built through bootstrap/provlir_mini.manifest by the OCaml seed:
#   tg_stage0.exe compile --repo-root . --manifest bootstrap/provlir_mini.manifest \
#     --target aarch64-apple-darwin
use std::core::{Option, Result}
use tg_compiler::mir::{
  mir_origin_insertion_lane_optimized_function,
  mir_origin_insertion_lane_key
}
use tg_compiler::lir::{
  lower_mir_fn_to_lir_mode, lir_alloc_registers_a64, verify_lir, LirVerifyRoute
}

def main() -> Int
  let f = mir_origin_insertion_lane_optimized_function()
  let key = mir_origin_insertion_lane_key(f.clone())
  if key.len() == 0 then
    println("LIR_LANE_FAIL the optimized call B carries no stable id")
    return 1
  end
  match lower_mir_fn_to_lir_mode(f.clone(), true, true)
  when Result::Err(e) then
    println("LIR_LANE_FAIL lower_mir_fn_to_lir_mode: " + e)
    return 1
  when Result::Ok(lf) then
    let alloc = lir_alloc_registers_a64(lf.clone())
    let rows = verify_lir(lf.clone(), alloc, LirVerifyRoute::LirVerifyA64)
    if rows.len() > 0 then
      for r in rows do println("LIR_LANE_FAIL verify_lir " + r) end
      return 1
    end
  end
  if mir_origin_insertion_lane_key(f) != key then
    println("LIR_LANE_FAIL B's stable id changed through the LIR boundary")
    return 1
  end
  println("LIR_LANE_PASS key=" + key)
  0
end
