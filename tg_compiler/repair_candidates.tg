# Tangerine Compiler — Durable Repair Candidates (audit §35 +
# repair-candidates-as-semantic-operations closure)
# Self-hosting compiler written in Tangerine
#
# THE DURABLE REPAIR MODEL. The advisory/synthetic-string candidate shape
# (a RepairKind plus "local::<name>" / "fn::<name>" digest keys fabricated
# from display text) is REPLACED by a typed semantic operation:
#
#   StableRepairId    — the repair candidate's stable identity: the
#                       ordinal-free TYPED diagnostic identity, the
#                       canonical target identity text and the operation
#                       template text, digested 128-bit (the §29 digest
#                       model). Eq/Hash compare the digest words only; the
#                       pieces are collision cargo. The within-diagnostic
#                       ordinal distinguishes candidates that share the
#                       same (diagnostic, target, operation) triple.
#   RepairCandidate   — { id, diagnostic: StableDiagnosticId,
#                       target: SemanticTargetId, preconditions:
#                       Vec[SemanticPredicate], operation:
#                       SemanticEditTemplate, expected_delta:
#                       DeltaConstraint, verification_plan:
#                       VerificationPlan }.
#   SemanticTargetId  — the TYPED target union (semantic_model.tg):
#                       Decl(StableDeclId) | Place(StablePlaceId) |
#                       MirStmt(StableMirStmtId) | Unavailable(kind,
#                       reason). A target that has a stable id derives it
#                       through the stable_ids boundary constructors
#                       (stable_decl_of_key / stable_place_of_text); a
#                       target that genuinely has no stable id on this
#                       surface carries the typed Unavailable MARKER —
#                       never a fabricated key.
#   SemanticPredicate — one typed applicability fact: kind (the fact
#                       vocabulary), the typed subject target, the display
#                       text, the obligation render and whether the
#                       diagnostic's own typed facts already establish it.
#   SemanticEditTemplate — the operation schema: one variant per audit §35
#                       repair kind carrying only the FIXED semantic words
#                       the rule derived. The concrete anchors/statement
#                       text an application supplies are the template's
#                       required parameters (rc_template_required_params).
#   DeltaConstraint   — the narrow semantic-delta envelope the repair may
#                       introduce (signature changes, newly added impls,
#                       annotation changes, the expected delta rows).
#   VerificationPlan  — the fail-closed check plan the instantiated edit
#                       must pass (the pipeline stage names + the
#                       obligations the verifying layer owns).
#   RepairParams / RepairInstantiation — the typed parameter bag and the
#                       fail-closed instantiation envelope:
#                       repair_instantiate(candidate, params) produces
#                       kind = "edit" with a real SemanticEdit (the SAME
#                       semantic-edit protocol the verified-edit
#                       transaction applies), or kind =
#                       "missing-parameter" / "unavailable" with the exact
#                       reason — never a marker edit, never a silent
#                       no-op.
#
# RULES (typed facts ONLY). candidate_of_diagnostic pattern-matches
# diag.semantic_data and runs the per-payload rules; every text the rules
# emit comes from the payload's own fields (the real place / type /
# obligation / effect / path renders). A diagnostic WITHOUT typed data
# produces NO candidates — the transitional text-grammar path is REMOVED:
# prose is never parsed into a repair. Candidate order within one
# diagnostic is the audit order (ownership use-after-move family,
# expected-vs-actual mismatch, trait-resolution gaps, effect/contract
# rows); the ordinals re-key the concatenated list deterministically.
#
#   Ownership(OwnershipDiagnosticData):
#     operation "use"/"read" + state "consumed" -> MoveUseBefore /
#       CloneBeforeMove (+ MakeFieldExplicit over the typed related
#       symbol for the "read" class) + the sink->let convention change at
#       the recorded consume_site.
#     operation "consume" + state "consumed"    -> CloneBeforeMove +
#       the sink->let convention change.
#     operation "let-param" / "inout-param"     -> the convention changes.
#     everything else -> NO candidates (not audit §35 classes).
#   TypeMismatch(TypeMismatchData)  -> the audit's structural wrapper
#       class: ConstructVia("Money::from_minor") and ResolveIntoImpl
#       ("From<Int> for <expected>") over the record's renders.
#   TraitFailure(TraitFailureData)  -> InsertImpl("<trait> for
#       <subject>") over the obligation's subject; Copy is structural and
#       foreign (::-qualified) subjects are skipped.
#   EffectViolation(EffectViolationData) -> RemoveEffectAnnotation over
#       the effect word; RemoveViolatingCall over a non-foreign path leaf.
#   Capability / Contract / Abi payloads -> NO candidates: not audit §35
#       classes; the typed diagnostic's explain tree remains the answer.
#
# INSTANTIATION WIRING (repair-candidates-as-semantic-operations closure):
# repair_instantiate maps each template onto the semantic-edit protocol
# (semantic_edit.tg):
#   MoveUseBefore / CloneBeforeMove / MakeFieldExplicit -> InsertStatement
#   ConstructVia / InsertImpl                            -> InsertStatement
#   ChangeParamConvention / RemoveEffectAnnotation       -> ChangeSignature
#   RemoveViolatingCall                                  -> ReplaceCall
# The instantiated SemanticEdit is exactly what the verified-edit
# transaction (edit.apply_verified) consumes, so a repaired candidate is a
# real, verifiable edit request — not an advisory string.
#
# REPAIR CONTEXT over the typed ExplainNode derivation tree (third-audit
# item 23 follow-up) is retained below: the context extraction walks the
# typed tree by node KIND instead of re-parsing rendered prose. The typed
# rules engine is the candidate authority.

use std::core::{Option}
use std::collections::{Vec}
use tg_compiler::token::{Span}
use tg_compiler::parser::{
  Diagnostic, DiagLevel, DiagnosticSemanticData, OwnershipDiagnosticData, TypeMismatchData,
  TraitFailureData, EffectViolationData
}
use tg_compiler::ids::{stable_digest_of}
use tg_compiler::stable_ids::{
  stable_decl_of_key, stable_decl_identity_text_of,
  stable_place_of_text, stable_place_text_of
}
use tg_compiler::semantic_model::{SemanticTargetId}
use tg_compiler::semantic_edit::{SemanticEdit}
use tg_compiler::semantic_diagnostics::{
  ExplainNode, explain_node_find_all, diagnostic_explain_node,
  StableDiagnosticId, DiagnosticRecord, stable_diagnostic_id_typed,
  stable_diagnostic_id_text, diagnostic_subject_of, diagnostic_cause_of,
  stable_diagnostic_code
}

# ———————————————————————————————————————————————————————————————
# StableRepairId — the repair candidate's stable identity
# ———————————————————————————————————————————————————————————————
# digest_hi/digest_lo are the 128-bit digest of the canonical
# length-prefixed preimage ("repair" || diagnostic id text || target
# identity text || operation text || ordinal); Eq/Hash compare the digest
# words only, like the stable_ids section-3/6 records. The pieces are the
# collision cargo / the diagnostics surface.
pub struct StableRepairId
  diagnostic_key: String
  target_key: String
  operation_key: String
  ordinal: Int = 0
  digest_hi: UInt = 0
  digest_lo: UInt = 0
end

impl Eq for StableRepairId
  def eq(self: Self, other: Self) -> Bool
    self.digest_hi == other.digest_hi && self.digest_lo == other.digest_lo
  end
end

impl Hash for StableRepairId
  def hash(self: Self) -> Int
    var h = 0
    h = ((h as UInt) * 31 + self.digest_hi) as Int
    h = ((h as UInt) * 31 + self.digest_lo) as Int
    h
  end
end

# ———————————————————————————————————————————————————————————————
# The durable candidate records
# ———————————————————————————————————————————————————————————————

# One semantic precondition of a repair: the fact vocabulary the verifying
# layer checks ("TraitBound", "SinkParamTransfer", "OneFieldWrapper",
# "ConstructorExists", "IntoImplResolves", "LocalNominal", "LocalCallee").
# subject is the TYPED target the fact concerns; subject_text the display
# render; obligation the fact's canonical render; established is true only
# when the diagnostic's own typed payload already proves the fact (the
# rules below never claim a fact the payload cannot establish).
pub struct SemanticPredicate
  kind: String
  subject: SemanticTargetId
  subject_text: String = ""
  obligation: String = ""
  established: Bool = false
end

# The durable operation schema: one variant per audit §35 repair kind. The
# variant carries the FIXED semantic words the rule derived; the concrete
# anchors/text ride the instantiation parameters (the required-parameter
# list is rc_template_required_params). No synthetic symbol strings.
pub enum SemanticEditTemplate
  # reorder the use before the recorded consumption anchor.
  MoveUseBefore(move_anchor: String)
  # clone the value before the recorded consumption anchor.
  CloneBeforeMove(move_anchor: String)
  # change an access convention ("sink" -> "let" / "let" -> "sink" / ...).
  ChangeParamConvention(from: String, to: String)
  # construct the expected value through a named constructor.
  ConstructVia(constructor: String)
  # add the missing impl of "<trait> for <subject>".
  InsertImpl(trait_name: String, subject: String)
  # re-initialize / bind a moved-out field explicitly.
  MakeFieldExplicit(field: String)
  # remove an effect-class annotation from the subject declaration.
  RemoveEffectAnnotation(annotation: String)
  # remove (or replace) the violating call at the evidence leaf.
  RemoveViolatingCall(callee: String)
end

# The narrow semantic-delta envelope a repair may introduce (§31
# vocabulary). The three dimensions are the ONLY deltas a candidate may
# claim; expected_rows carries the delta row identities the instantiated
# edit is expected to produce (the P0-15 planned-set comparison).
pub struct DeltaConstraint
  allows_signature_change: Bool = false
  allows_new_impls: Vec[String] = Vec::new()
  allows_annotation_changes: Vec[String] = Vec::new()
  expected_rows: Vec[String] = Vec::new()
end

# The fail-closed verification plan of a candidate: the pipeline stages the
# instantiated edit is re-validated through (the verified-edit
# transaction's stage vocabulary) plus the obligations the verifying layer
# owns. fails_closed = true means an unverifiable/ungrounded edit is
# refused, never admitted.
pub struct VerificationPlan
  checks: Vec[String] = Vec::new()
  obligations: Vec[String] = Vec::new()
  fails_closed: Bool = true
end

# ONE durable repair candidate.
pub struct RepairCandidate
  id: StableRepairId
  diagnostic: StableDiagnosticId
  target: SemanticTargetId
  preconditions: Vec[SemanticPredicate] = Vec::new()
  operation: SemanticEditTemplate
  expected_delta: DeltaConstraint
  verification_plan: VerificationPlan
end

# The instantiation parameter bag (name -> value).
pub struct RepairParam
  name: String
  value: String
end

pub struct RepairParams
  rows: Vec[RepairParam] = Vec::new()
end

# The fail-closed instantiation envelope: kind = "edit" carries the real
# SemanticEdit; "missing-parameter" names every required parameter the
# bag did not supply; "unavailable" carries the typed target-unavailable
# reason (a candidate whose target has no stable id can never be
# instantiated into a pretend edit).
pub struct RepairInstantiation
  kind: String
  edit: Option[SemanticEdit] = Option::None
  missing: Vec[String] = Vec::new()
  reason: String = ""
end

# ———————————————————————————————————————————————————————————————
# Primitives
# ———————————————————————————————————————————————————————————————

def rc_lenpref(piece: String) -> String
  piece.len().to_string() + ":" + piece
end

def rc_index_of(s: String, sub: String, from: Int) -> Int
  if sub.len() == 0 then
    return -1
  end
  var i = from
  while i + sub.len() <= s.len() do
    if s.slice(i, i + sub.len()) == sub then
      return i
    end
    i = i + 1
  end
  -1
end

# The canonical identity text of a typed target (the StableRepairId
# preimage component and the candidate render). Unavailable renders its
# typed marker — never a fabricated key.
pub def semantic_target_id_text(t: SemanticTargetId) -> String
  match t
  when SemanticTargetId::Decl(decl) then "decl|" + stable_decl_identity_text_of(decl.clone())
  when SemanticTargetId::Place(place) then "place|" + stable_place_text_of(place.clone())
  when SemanticTargetId::MirStmt(stmt) then "mir-stmt|" + stmt.stable_key.clone()
  when SemanticTargetId::Unavailable(kind, reason) then "unavailable|" + kind + "|" + reason
  end
end

pub def semantic_target_id_kind(t: SemanticTargetId) -> String
  match t
  when SemanticTargetId::Decl(_) then "decl"
  when SemanticTargetId::Place(_) then "place"
  when SemanticTargetId::MirStmt(_) then "mir-stmt"
  when SemanticTargetId::Unavailable(_, _) then "unavailable"
  end
end

# The typed target of a place text: the structured StablePlaceId when the
# text is the canonical place grammar (the stable_ids boundary), else the
# typed Unavailable marker (a dynamic index / non-place text is NEVER
# rewritten into a fake place id).
pub def repair_target_of_place_text(text: String) -> SemanticTargetId
  match stable_place_of_text(&text)
  when Option::Some(place) then SemanticTargetId::Place(place)
  when Option::None then
    SemanticTargetId::Unavailable("place".to_string(),
      "text is not a canonical stable place: " + text)
  end
end

# The typed target of a declaration-render text: the stable_ids text
# boundary constructor (the documented StableDeclId derivation), else the
# typed Unavailable marker for an empty render.
pub def repair_target_of_decl_text(text: String) -> SemanticTargetId
  if text.len() == 0 then
    SemanticTargetId::Unavailable("decl".to_string(), "the diagnostic names no declaration")
  else
    SemanticTargetId::Decl(stable_decl_of_key(&text))
  end
end

# The stable repair id: the 128-bit digest of the typed canonical preimage.
pub def stable_repair_id_typed(
  diagnostic: StableDiagnosticId, target_key: String, operation_key: String, ordinal: Int
) -> StableRepairId
  var text = rc_lenpref("repair") + rc_lenpref(&stable_diagnostic_id_text(diagnostic.clone()))
  text = text + rc_lenpref(&target_key) + rc_lenpref(&operation_key) +
    rc_lenpref(&ordinal.to_string())
  let d = stable_digest_of(&text)
  StableRepairId {
    diagnostic_key: stable_diagnostic_id_text(diagnostic),
    target_key: target_key,
    operation_key: operation_key,
    ordinal: ordinal,
    digest_hi: d.hi,
    digest_lo: d.lo
  }
end

# The canonical repair id render (wire / lane cargo).
pub def stable_repair_id_text(id: StableRepairId) -> String
  "repair|" + id.diagnostic_key.clone() + "|" + id.target_key.clone() + "|" +
    id.operation_key.clone() + "|#" + id.ordinal.to_string()
end

# The canonical template render (the operation key component).
pub def rc_template_text(t: SemanticEditTemplate) -> String
  match t
  when SemanticEditTemplate::MoveUseBefore(anchor) then "MoveUseBefore(" + anchor + ")"
  when SemanticEditTemplate::CloneBeforeMove(anchor) then "CloneBeforeMove(" + anchor + ")"
  when SemanticEditTemplate::ChangeParamConvention(from, to) then
    "ChangeParamConvention(" + from + " -> " + to + ")"
  when SemanticEditTemplate::ConstructVia(constructor) then "ConstructVia(" + constructor + ")"
  when SemanticEditTemplate::InsertImpl(trait_name, subject) then
    "InsertImpl(" + trait_name + " for " + subject + ")"
  when SemanticEditTemplate::MakeFieldExplicit(field) then "MakeFieldExplicit(" + field + ")"
  when SemanticEditTemplate::RemoveEffectAnnotation(annotation) then
    "RemoveEffectAnnotation(@" + annotation + ")"
  when SemanticEditTemplate::RemoveViolatingCall(callee) then
    "RemoveViolatingCall(" + callee + ")"
  end
end

# The REQUIRED instantiation parameters of a template (the names the
# parameter bag must carry; missing names answer the typed
# missing-parameter envelope).
pub def rc_template_required_params(t: SemanticEditTemplate) -> Vec[String]
  match t
  when SemanticEditTemplate::MoveUseBefore(_) then
    Vec::from(["function_key".to_string(), "before_stmt_key".to_string(), "statement_text".to_string()])
  when SemanticEditTemplate::CloneBeforeMove(_) then
    Vec::from(["function_key".to_string(), "before_stmt_key".to_string(), "statement_text".to_string()])
  when SemanticEditTemplate::ChangeParamConvention(_, _) then
    Vec::from(["decl".to_string(), "new_signature_text".to_string()])
  when SemanticEditTemplate::ConstructVia(_) then
    Vec::from(["function_key".to_string(), "before_stmt_key".to_string(), "statement_text".to_string()])
  when SemanticEditTemplate::InsertImpl(_, _) then
    Vec::from(["function_key".to_string(), "before_stmt_key".to_string(), "statement_text".to_string()])
  when SemanticEditTemplate::MakeFieldExplicit(_) then
    Vec::from(["function_key".to_string(), "before_stmt_key".to_string(), "statement_text".to_string()])
  when SemanticEditTemplate::RemoveEffectAnnotation(_) then
    Vec::from(["decl".to_string(), "new_signature_text".to_string()])
  when SemanticEditTemplate::RemoveViolatingCall(_) then
    Vec::from(["call_site_key".to_string(), "callee".to_string()])
  end
end

# ———————————————————————————————————————————————————————————————
# Builders
# ———————————————————————————————————————————————————————————————

def rc_predicate(kind: String, subject: SemanticTargetId, subject_text: String, obligation: String) -> SemanticPredicate
  SemanticPredicate {
    kind: kind,
    subject: subject,
    subject_text: subject_text,
    obligation: obligation,
    established: false
  }
end

def rc_delta_plain() -> DeltaConstraint
  DeltaConstraint {}
end

def rc_delta_sig() -> DeltaConstraint
  DeltaConstraint { allows_signature_change: true }
end

def rc_delta_new_impls(impls: Vec[String]) -> DeltaConstraint
  DeltaConstraint { allows_new_impls: impls }
end

def rc_delta_annotations(anns: Vec[String]) -> DeltaConstraint
  DeltaConstraint { allows_annotation_changes: anns }
end

# The standard verification plan: the front-end stages the verified-edit
# transaction re-runs plus the planned-delta comparison.
def rc_verification_plan() -> VerificationPlan
  VerificationPlan {
    checks: Vec::from([
      "parse".to_string(),
      "resolve".to_string(),
      "type".to_string(),
      "access".to_string(),
      "resource".to_string(),
      "expected-delta".to_string()
    ]),
    obligations: Vec::new(),
    fails_closed: true
  }
end

# ONE candidate with its stable id under the given ordinal.
def rc_candidate(
  diagnostic: StableDiagnosticId,
  ordinal: Int,
  target: SemanticTargetId,
  operation: SemanticEditTemplate,
  preconditions: Vec[SemanticPredicate],
  expected_delta: DeltaConstraint
) -> RepairCandidate
  let target_key = semantic_target_id_text(target.clone())
  let operation_key = rc_template_text(operation.clone())
  RepairCandidate {
    id: stable_repair_id_typed(diagnostic.clone(), target_key, operation_key, ordinal),
    diagnostic: diagnostic,
    target: target,
    preconditions: preconditions,
    operation: operation,
    expected_delta: expected_delta,
    verification_plan: rc_verification_plan()
  }
end

# Re-key a concatenated candidate list with the within-diagnostic ordinals
# (the audit order is the list order; the id is the only thing that
# changes).
def rc_assign_ordinals(diagnostic: StableDiagnosticId, cands: Vec[RepairCandidate]) -> Vec[RepairCandidate]
  var out: Vec[RepairCandidate] = Vec::new()
  var i = 0
  while i < cands.len() do
    let c = cands[i].clone()
    out.push(RepairCandidate {
      id: stable_repair_id_typed(diagnostic.clone(),
        semantic_target_id_text(c.target.clone()), rc_template_text(c.operation.clone()), i),
      diagnostic: c.diagnostic,
      target: c.target,
      preconditions: c.preconditions,
      operation: c.operation,
      expected_delta: c.expected_delta,
      verification_plan: c.verification_plan
    })
    i = i + 1
  end
  out
end

# The typed diagnostic id of a live Diagnostic: the ordinal-free typed
# identity derivation (code + typed subject + typed cause) the persistent
# store uses; the store-scoped collision ordinal is NOT part of a repair
# candidate's identity (two stores that observed the same typed diagnostic
# yield the same candidates).
pub def repair_diagnostic_id_of(d: Diagnostic) -> StableDiagnosticId
  stable_diagnostic_id_typed(
    stable_diagnostic_code(&d),
    diagnostic_subject_of(&d),
    diagnostic_cause_of(&d),
    0)
end

# ———————————————————————————————————————————————————————————————
# THE TYPED RULES (semantic_data ONLY — no prose parsing)
# ———————————————————————————————————————————————————————————————

def rc_is_foreign_name(name: String) -> Bool
  name.starts_with("std::") || name.starts_with("core::") || name.starts_with("builtin::")
end

# The typed ownership rule: (operation, state_before) select the audit
# class. name = the payload's place (falling back to the primary symbol
# when the payload carries none); the target is the structured place id.
def rc_ownership_candidates(
  diagnostic: StableDiagnosticId,
  data: OwnershipDiagnosticData,
  primary: String,
  related: Vec[String]
) -> Vec[RepairCandidate]
  var out: Vec[RepairCandidate] = Vec::new()
  var name = primary.clone()
  if name == "" then
    name = data.place.clone()
  end
  if name == "" then
    return out
  end
  let target = repair_target_of_place_text(name.clone())
  match data.operation
  when "use" then
    match data.state_before
    when "consumed" then
      out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
        SemanticEditTemplate::MoveUseBefore(data.consume_site.clone()),
        Vec::new(), rc_delta_plain()))
      out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
        SemanticEditTemplate::CloneBeforeMove(data.consume_site.clone()),
        Vec::from([rc_predicate("TraitBound".to_string(), target.clone(), name.clone(), "Clone".to_string())]),
        rc_delta_plain()))
      out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
        SemanticEditTemplate::ChangeParamConvention("sink".to_string(), "let".to_string()),
        Vec::from([rc_predicate("SinkParamTransfer".to_string(), target.clone(),
          name.clone(), data.consume_site.clone())]),
        rc_delta_sig()))
    when _ then ()
    end
  when "read" then
    match data.state_before
    when "consumed" then
      out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
        SemanticEditTemplate::MoveUseBefore(data.consume_site.clone()),
        Vec::new(), rc_delta_plain()))
      out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
        SemanticEditTemplate::CloneBeforeMove(data.consume_site.clone()),
        Vec::from([rc_predicate("TraitBound".to_string(), target.clone(), name.clone(), "Clone".to_string())]),
        rc_delta_plain()))
      if related.len() > 0 then
        out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
          SemanticEditTemplate::MakeFieldExplicit(related[0].clone()),
          Vec::new(), rc_delta_plain()))
      end
    when _ then ()
    end
  when "consume" then
    match data.state_before
    when "consumed" then
      out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
        SemanticEditTemplate::CloneBeforeMove(data.consume_site.clone()),
        Vec::from([rc_predicate("TraitBound".to_string(), target.clone(), name.clone(), "Clone".to_string())]),
        rc_delta_plain()))
      out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
        SemanticEditTemplate::ChangeParamConvention("sink".to_string(), "let".to_string()),
        Vec::from([rc_predicate("SinkParamTransfer".to_string(), target.clone(),
          name.clone(), data.consume_site.clone())]),
        rc_delta_sig()))
    when _ then ()
    end
  when "let-param" then
    out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
      SemanticEditTemplate::ChangeParamConvention("let".to_string(), "sink".to_string()),
      Vec::new(), rc_delta_sig()))
  when "inout-param" then
    out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
      SemanticEditTemplate::ChangeParamConvention("inout".to_string(), "sink".to_string()),
      Vec::new(), rc_delta_sig()))
  when _ then ()
  end
  out
end

# The typed expected-vs-actual rule: the structural wrapper class over the
# record's two renders. The target is the expected type's declaration
# identity (the text boundary), or the typed unavailable marker for an
# empty render.
def rc_mismatch_candidates(diagnostic: StableDiagnosticId, data: TypeMismatchData) -> Vec[RepairCandidate]
  var out: Vec[RepairCandidate] = Vec::new()
  var exp_head = data.expected.clone()
  let bi = rc_index_of(exp_head.clone(), "[", 0)
  if bi >= 0 then
    exp_head = exp_head.slice(0, bi)
  end
  if exp_head == "Money" && data.actual == "Int" then
    let target = repair_target_of_decl_text(data.expected.clone())
    out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
      SemanticEditTemplate::ConstructVia("Money::from_minor".to_string()),
      Vec::from([
        rc_predicate("OneFieldWrapper".to_string(), target.clone(), data.expected.clone(),
          data.expected.clone()),
        rc_predicate("ConstructorExists".to_string(), target.clone(), data.expected.clone(),
          "Money::from_minor(minor: Int)")
      ]),
      rc_delta_plain()))
    var impl_key = "From<Int> for " + data.expected
    out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
      SemanticEditTemplate::InsertImpl("From<Int>".to_string(), data.expected.clone()),
      Vec::from([rc_predicate("IntoImplResolves".to_string(), target.clone(),
        data.expected.clone(), impl_key.clone())]),
      rc_delta_new_impls(Vec::from([impl_key]))))
  end
  out
end

# The typed trait-failure rule: InsertImpl over the obligation's subject.
# Copy is structural (never suggested) and foreign (::-qualified) subjects
# are skipped (the no-foreign-edits narrowing).
def rc_trait_candidates(diagnostic: StableDiagnosticId, data: TraitFailureData) -> Vec[RepairCandidate]
  var out: Vec[RepairCandidate] = Vec::new()
  if data.obligation.len() == 0 then
    return out
  end
  let obl = data.obligation.clone()
  let sep = rc_index_of(obl.clone(), " for ", 0)
  if sep < 0 then
    return out
  end
  let trait_word = obl.slice(0, sep)
  let subject = obl.slice(sep + 5, obl.len())
  if trait_word == "Copy" then
    return out
  end
  if subject.len() == 0 then
    return out
  end
  if rc_index_of(subject.clone(), "::", 0) >= 0 then
    return out
  end
  let target = repair_target_of_decl_text(subject.clone())
  out.push(rc_candidate(diagnostic.clone(), 0, target.clone(),
    SemanticEditTemplate::InsertImpl(trait_word.clone(), subject.clone()),
    Vec::from([rc_predicate("LocalNominal".to_string(), target.clone(),
      subject.clone(), subject.clone())]),
    rc_delta_new_impls(Vec::from([obl.clone()]))))
  out
end

# The typed E0232/E0234 rule: RemoveEffectAnnotation over the effect word
# (subject = the path head) and RemoveViolatingCall over a non-foreign
# direct leaf. The annotation-removal target is the subject function's
# declaration identity (or the typed unavailable marker when the path
# names no subject); the call-removal target is the leaf's declaration
# identity.
def rc_effect_candidates(diagnostic: StableDiagnosticId, data: EffectViolationData) -> Vec[RepairCandidate]
  var out: Vec[RepairCandidate] = Vec::new()
  if data.effect.len() == 0 then
    return out
  end
  var subject = ""
  if data.path.len() > 0 then
    subject = data.path[0].clone()
  end
  let ann_target = if subject.len() > 0 then repair_target_of_decl_text(subject.clone()) else
    SemanticTargetId::Unavailable("function".to_string(),
      "the effect evidence names no subject function") end
  out.push(rc_candidate(diagnostic.clone(), 0, ann_target.clone(),
    SemanticEditTemplate::RemoveEffectAnnotation(data.effect.clone()),
    Vec::new(),
    rc_delta_annotations(Vec::from(["@" + data.effect.clone()]))))
  if data.path.len() > 1 then
    let leaf = data.path[data.path.len() - 1].clone()
    if leaf != subject && !rc_is_foreign_name(leaf.clone()) then
      let leaf_target = repair_target_of_decl_text(leaf.clone())
      out.push(rc_candidate(diagnostic.clone(), 0, leaf_target.clone(),
        SemanticEditTemplate::RemoveViolatingCall(leaf.clone()),
        Vec::from([rc_predicate("LocalCallee".to_string(), leaf_target.clone(),
          leaf.clone(), leaf.clone())]),
        rc_delta_plain()))
    end
  end
  out
end

# The payload dispatcher: one payload class -> its rule's candidate list.
# Capability / contract / ABI produce no candidates (not audit §35
# classes). A payload-less diagnostic produces NO candidates — prose is
# never parsed into a repair.
def rc_candidates_of_payload(
  diagnostic: StableDiagnosticId, data: Option[DiagnosticSemanticData], primary: String, related: Vec[String]
) -> Vec[RepairCandidate]
  var out: Vec[RepairCandidate] = Vec::new()
  match data
  when Option::None then ()
  when Option::Some(sd) then
    match sd
    when DiagnosticSemanticData::Ownership(od) then
      for c in rc_ownership_candidates(diagnostic.clone(), od, primary.clone(), related.clone()) do
        out.push(c)
      end
    when DiagnosticSemanticData::TypeMismatch(tm) then
      for c in rc_mismatch_candidates(diagnostic.clone(), tm) do
        out.push(c)
      end
    when DiagnosticSemanticData::TraitFailure(tf) then
      for c in rc_trait_candidates(diagnostic.clone(), tf) do
        out.push(c)
      end
    when DiagnosticSemanticData::EffectViolation(ev) then
      for c in rc_effect_candidates(diagnostic.clone(), ev) do
        out.push(c)
      end
    when DiagnosticSemanticData::Capability(_) then ()
    when DiagnosticSemanticData::Contract(_) then ()
    when DiagnosticSemanticData::Abi(_) then ()
    end
  end
  out
end

# THE rules engine: one Diagnostic in, the deterministic durable candidate
# list out. The typed payload is the ONLY source; the diagnostic without
# typed data yields NO candidates.
pub def candidate_of_diagnostic(diag: Diagnostic) -> Vec[RepairCandidate]
  let diagnostic = repair_diagnostic_id_of(&diag)
  var primary = ""
  match diag.primary_symbol
  when Option::Some(p) then primary = p.clone()
  when Option::None then ()
  end
  let cands = rc_candidates_of_payload(diagnostic.clone(), diag.semantic_data.clone(),
    primary, diag.related_symbols.clone())
  rc_assign_ordinals(diagnostic, cands)
end

# The STORE form: the record's retained typed payload is the source (the
# id is the record's already-stable diagnostic id). The record does not
# retain the related-SYMBOL channel (only the payload's rendered fact
# rows), so the partial-move MakeFieldExplicit rule's chain subject is
# empty on this path — the payload rules below never parse a rendered
# row into a candidate (the live-diagnostic path owns the chain).
pub def candidate_of_record(record: DiagnosticRecord) -> Vec[RepairCandidate]
  let cands = rc_candidates_of_payload(record.id.clone(), record.payload.clone(),
    "".to_string(), Vec::new())
  rc_assign_ordinals(record.id.clone(), cands)
end

# ———————————————————————————————————————————————————————————————
# Instantiation: candidate + params -> a REAL SemanticEdit
# ———————————————————————————————————————————————————————————————

pub def repair_params_new() -> RepairParams
  RepairParams { rows: Vec::new() }
end

pub def repair_params_add(inout params: RepairParams, name: String, value: String) -> Unit
  params.rows.push(RepairParam { name: name, value: value })
  ()
end

pub def repair_params_get(params: RepairParams, name: String) -> String
  for r in params.rows do
    if r.name == name then
      return r.value.clone()
    end
  end
  "".to_string()
end

def rc_collect_missing(
  operation: SemanticEditTemplate, params: RepairParams, inout missing: Vec[String]
) -> Unit
  for name in rc_template_required_params(operation) do
    if repair_params_get(params.clone(), name.clone()) == "" then
      missing.push(name.clone())
    end
  end
  ()
end

# THE instantiation: fail closed on an Unavailable target, fail closed on
# a missing required parameter, otherwise build the real SemanticEdit the
# verified-edit transaction applies.
pub def repair_instantiate(candidate: RepairCandidate, params: RepairParams) -> RepairInstantiation
  match candidate.target.clone()
  when SemanticTargetId::Unavailable(kind, reason) then
    RepairInstantiation {
      kind: "unavailable".to_string(),
      reason: "target-unavailable|" + kind + "|" + reason
    }
  when _ then
    var missing: Vec[String] = Vec::new()
    rc_collect_missing(candidate.operation.clone(), params.clone(), &mut missing)
    if missing.len() > 0 then
      return RepairInstantiation {
        kind: "missing-parameter".to_string(),
        missing: missing,
        reason: "the operation template requires the missing parameters"
      }
    end
    let edit = match candidate.operation.clone()
    when SemanticEditTemplate::MoveUseBefore(_) then
      SemanticEdit::InsertStatement(
        repair_params_get(params.clone(), "function_key".to_string()),
        repair_params_get(params.clone(), "before_stmt_key".to_string()),
        repair_params_get(params.clone(), "statement_text".to_string()))
    when SemanticEditTemplate::CloneBeforeMove(_) then
      SemanticEdit::InsertStatement(
        repair_params_get(params.clone(), "function_key".to_string()),
        repair_params_get(params.clone(), "before_stmt_key".to_string()),
        repair_params_get(params.clone(), "statement_text".to_string()))
    when SemanticEditTemplate::ChangeParamConvention(_, _) then
      SemanticEdit::ChangeSignature(
        repair_params_get(params.clone(), "decl".to_string()),
        repair_params_get(params.clone(), "new_signature_text".to_string()))
    when SemanticEditTemplate::ConstructVia(_) then
      SemanticEdit::InsertStatement(
        repair_params_get(params.clone(), "function_key".to_string()),
        repair_params_get(params.clone(), "before_stmt_key".to_string()),
        repair_params_get(params.clone(), "statement_text".to_string()))
    when SemanticEditTemplate::InsertImpl(_, _) then
      SemanticEdit::InsertStatement(
        repair_params_get(params.clone(), "function_key".to_string()),
        repair_params_get(params.clone(), "before_stmt_key".to_string()),
        repair_params_get(params.clone(), "statement_text".to_string()))
    when SemanticEditTemplate::MakeFieldExplicit(_) then
      SemanticEdit::InsertStatement(
        repair_params_get(params.clone(), "function_key".to_string()),
        repair_params_get(params.clone(), "before_stmt_key".to_string()),
        repair_params_get(params.clone(), "statement_text".to_string()))
    when SemanticEditTemplate::RemoveEffectAnnotation(_) then
      SemanticEdit::ChangeSignature(
        repair_params_get(params.clone(), "decl".to_string()),
        repair_params_get(params.clone(), "new_signature_text".to_string()))
    when SemanticEditTemplate::RemoveViolatingCall(_) then
      SemanticEdit::ReplaceCall(
        repair_params_get(params.clone(), "call_site_key".to_string()),
        repair_params_get(params.clone(), "callee".to_string()))
    end
    RepairInstantiation {
      kind: "edit".to_string(),
      edit: Option::Some(edit),
      reason: ""
    }
  end
end

# ———————————————————————————————————————————————————————————————
# Renders
# ———————————————————————————————————————————————————————————————

def rc_bool_text(b: Bool) -> String
  if b then "true" else "false" end
end

def rc_predicate_text(p: SemanticPredicate) -> String
  p.kind.clone() + ":" + p.subject_text.clone() + ":" + rc_bool_text(p.established)
end

def rc_delta_text(d: DeltaConstraint) -> String
  var out = "sig:" + rc_bool_text(d.allows_signature_change)
  if d.allows_new_impls.len() > 0 then
    out = out + ";impls:[" + d.allows_new_impls.join(",") + "]"
  end
  if d.allows_annotation_changes.len() > 0 then
    out = out + ";anns:[" + d.allows_annotation_changes.join(",") + "]"
  end
  if d.expected_rows.len() > 0 then
    out = out + ";rows:[" + d.expected_rows.join(",") + "]"
  end
  out
end

def rc_plan_text(p: VerificationPlan) -> String
  p.checks.join(",")
end

# One canonical line per durable candidate.
pub def repair_candidate_rows(cands: Vec[RepairCandidate]) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  for c in cands do
    var preds: Vec[String] = Vec::new()
    for p in c.preconditions do
      preds.push(rc_predicate_text(p.clone()))
    end
    var line = "id=" + stable_repair_id_text(c.id.clone())
    line = line + ";diagnostic=" + stable_diagnostic_id_text(c.diagnostic.clone())
    line = line + ";target=" + semantic_target_id_text(c.target.clone())
    line = line + ";op=" + rc_template_text(c.operation.clone())
    if preds.len() > 0 then
      line = line + ";pre={" + preds.join(";") + "}"
    end
    line = line + ";delta={" + rc_delta_text(c.expected_delta.clone()) + "}"
    line = line + ";verify={" + rc_plan_text(c.verification_plan.clone()) + "}"
    rows.push(line)
  end
  rows
end

def rc_edit_text(edit: SemanticEdit) -> String
  match edit
  when SemanticEdit::ReplaceCall(call_site_key, callee) then
    "ReplaceCall(" + call_site_key + " -> " + callee + ")"
  when SemanticEdit::InsertStatement(function_key, before_stmt_key, statement_text) then
    "InsertStatement(" + function_key + "|" + before_stmt_key + "|" + statement_text + ")"
  when SemanticEdit::ChangeContract(contract_id, new_expression_text) then
    "ChangeContract(" + contract_id + "|" + new_expression_text + ")"
  when SemanticEdit::Rename(decl, new_name) then
    "Rename(" + decl + " -> " + new_name + ")"
  when SemanticEdit::ChangeSignature(decl, new_signature_text) then
    "ChangeSignature(" + decl + "|" + new_signature_text + ")"
  when SemanticEdit::FillHole(hole_key, expression_text) then
    "FillHole(" + hole_key + "|" + expression_text + ")"
  end
end

# The canonical instantiation rows (one line per answer component).
pub def repair_instantiation_rows(result: RepairInstantiation) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  rows.push("kind:" + result.kind.clone())
  if result.missing.len() > 0 then
    rows.push("missing:" + result.missing.join(","))
  end
  if result.reason.len() > 0 then
    rows.push("reason:" + result.reason.clone())
  end
  match result.edit
  when Option::Some(edit) then
    rows.push("edit:" + rc_edit_text(edit))
  when Option::None then ()
  end
  rows
end

# ———————————————————————————————————————————————————————————————
# REPAIR CONTEXT over the typed ExplainNode derivation tree
# (third-audit item 23 follow-up)
# ———————————————————————————————————————————————————————————————
# The derivation behind a diagnostic is a TYPED tree (semantic_diagnostics
# .tg's ExplainNode — the same tree the explain ops render). The context
# extraction below walks the tree by node KIND (machine identity) instead
# of re-parsing rendered row prose: the class node subject carries the
# typed class word and every "reason" node carries one verbatim §34 trace
# row. The durable rules engine above is the candidate authority — this is
# the context surface its verifying consumers read.

def rc_node_rows(tree: ExplainNode, kind: String) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  for n in explain_node_find_all(tree, kind) do
    rows.push(n.subject.clone())
  end
  rows
end

# The repair context rows of a typed explain tree: one "class:<word>:<subject>"
# row per typed payload class node, then one "reason:<row>" row per §34
# trace leaf (recorded order), never a fabricated fact.
pub def repair_context_rows_of_explain(tree: ExplainNode) -> Vec[String]
  var rows: Vec[String] = Vec::new()
  let classes = Vec::from([
    "ownership-rejection".to_string(),
    "type-mismatch".to_string(),
    "trait-failure".to_string(),
    "effect-violation".to_string(),
    "capability-failure".to_string(),
    "contract-violation".to_string(),
    "abi-boundary".to_string()
  ])
  for k in classes do
    for r in rc_node_rows(tree.clone(), k.clone()) do
      rows.push("class:" + k.clone() + ":" + r.clone())
    end
  end
  for r2 in rc_node_rows(tree.clone(), "reason".to_string()) do
    rows.push("reason:" + r2.clone())
  end
  rows
end

# The repair context of ONE Diagnostic, derived from its typed tree (the
# diagnostic.repair_context op's in-process form).
pub def diagnostic_repair_context(d: Diagnostic) -> Vec[String]
  repair_context_rows_of_explain(diagnostic_explain_node(&d))
end

# ———————————————————————————————————————————————————————————————
# The module lane (durable repair model executable rows)
# ———————————————————————————————————————————————————————————————
# R1: a use-after-move diagnostic yields a stable target + a real
#     InsertStatement instantiation; R2: a trait failure yields the
#     InsertImpl template; R3: an unavailable target is typed and refuses
#     instantiation; R4: the diagnostic id derivation round-trips through
#     the explain tree; R5: a payload-less diagnostic yields NO candidates
#     (prose is never parsed); R6: the stable repair id is deterministic
#     and distinct per operation. Empty result = the lane verifies.

def rc_lane_bool(inout out: Vec[String], name: String, ok: Bool) -> Unit
  if !ok then
    out.push(name + ": expected true")
  end
  ()
end

def rc_lane_text(inout out: Vec[String], name: String, got: String, expected: String) -> Unit
  if got != expected then
    out.push(name + ": expected '" + expected + "', got '" + got + "'")
  end
  ()
end

def rc_lane_int(inout out: Vec[String], name: String, got: Int, expected: Int) -> Unit
  if got != expected then
    out.push(name + ": expected " + expected.to_string() + ", got " + got.to_string())
  end
  ()
end

def rc_lane_span(start: Int) -> Span
  Span { file: "repair-lane.tg", start: start, end_pos: start + 1 }
end

def rc_lane_ownership_diag(place: String, operation: String) -> Diagnostic
  Diagnostic {
    level: DiagLevel::Error,
    message: "use of moved value `" + place.clone() + "`",
    span: Option::Some(rc_lane_span(5)),
    notes: Vec::new(),
    suggestions: Vec::new(),
    code: Option::Some("E0201".to_string()),
    primary_symbol: Option::Some("m::f#fn()->unit".to_string()),
    semantic_site: Option::Some("ownership analysis (whole-value use)"),
    semantic_data: Option::Some(DiagnosticSemanticData::Ownership(OwnershipDiagnosticData {
      place: place,
      state_before: "consumed".to_string(),
      operation: operation,
      consume_site: "repair-lane.tg:3".to_string(),
      use_site: "repair-lane.tg:5".to_string(),
      type_id: "R".to_string()
    }))
  }
end

def rc_lane_trait_diag(obligation: String) -> Diagnostic
  Diagnostic {
    level: DiagLevel::Error,
    message: "trait bound not satisfied: " + obligation.clone(),
    span: Option::Some(rc_lane_span(20)),
    notes: Vec::new(),
    suggestions: Vec::new(),
    code: Option::Some("E0203".to_string()),
    primary_symbol: Option::Some("m::f#fn()->unit".to_string()),
    semantic_site: Option::Some("method call resolution"),
    semantic_data: Option::Some(DiagnosticSemanticData::TraitFailure(TraitFailureData {
      obligation: obligation,
      rejected_candidates: Vec::from(["impl Display for R".to_string()])
    }))
  }
end

def rc_lane_insert_params(fn_key: String, anchor: String, text: String) -> RepairParams
  var params = repair_params_new()
  repair_params_add(&mut params, "function_key".to_string(), fn_key)
  repair_params_add(&mut params, "before_stmt_key".to_string(), anchor)
  repair_params_add(&mut params, "statement_text".to_string(), text)
  params
end

pub def repair_candidates_lane_check() -> Vec[String]
  var out: Vec[String] = Vec::new()

  # ———— R1: use-after-move -> stable target + InsertStatement ————
  let d1 = rc_lane_ownership_diag("r".to_string(), "use".to_string())
  let cands1 = candidate_of_diagnostic(d1.clone())
  rc_lane_int(&mut out, "r1-count", cands1.len(), 3)
  if cands1.len() == 3 then
    let c1 = cands1[0].clone()
    rc_lane_text(&mut out, "r1-target-kind", semantic_target_id_kind(c1.target.clone()), "place")
    rc_lane_bool(&mut out, "r1-target-stable",
      semantic_target_id_text(c1.target.clone()).starts_with("place|"))
    rc_lane_text(&mut out, "r1-op", rc_template_text(c1.operation.clone()), "MoveUseBefore(repair-lane.tg:3)")
    # The candidate's diagnostic id is the typed derivation of the live
    # diagnostic (same identity key, same text).
    rc_lane_text(&mut out, "r1-diagnostic-id",
      stable_diagnostic_id_text(c1.diagnostic.clone()),
      stable_diagnostic_id_text(repair_diagnostic_id_of(&d1)))
    # instantiate -> the real SemanticEdit.
    let params = rc_lane_insert_params("m::f#fn()->unit".to_string(),
      "m::f#fn()->unit#H7".to_string(), "let r2 = R { }".to_string())
    let inst = repair_instantiate(c1.clone(), params)
    rc_lane_text(&mut out, "r1-instantiate-kind", inst.kind.clone(), "edit")
    match inst.edit
    when Option::Some(edit) then
      match edit
      when SemanticEdit::InsertStatement(f, b, s) then
        rc_lane_text(&mut out, "r1-edit-function", f.clone(), "m::f#fn()->unit")
        rc_lane_text(&mut out, "r1-edit-anchor", b.clone(), "m::f#fn()->unit#H7")
        rc_lane_text(&mut out, "r1-edit-text", s.clone(), "let r2 = R { }")
      when _ then out.push("r1-edit: expected InsertStatement")
      end
    when Option::None then out.push("r1-edit: expected Some, got None")
    end
    # The clone candidate carries the TraitBound Clone precondition.
    let c2 = cands1[1].clone()
    rc_lane_text(&mut out, "r1-clone-op", rc_template_text(c2.operation.clone()), "CloneBeforeMove(repair-lane.tg:3)")
    rc_lane_int(&mut out, "r1-clone-pre", c2.preconditions.len(), 1)
    rc_lane_bool(&mut out, "r1-ordered-ids",
      stable_repair_id_text(c1.id.clone()) != stable_repair_id_text(c2.id.clone()))
    rc_lane_int(&mut out, "r1-ordinals", c1.id.ordinal + c2.id.ordinal, 1)
  end

  # ———— R2: trait failure -> the impl-candidate template ————
  let d2 = rc_lane_trait_diag("Display for R".to_string())
  let cands2 = candidate_of_diagnostic(d2.clone())
  rc_lane_int(&mut out, "r2-count", cands2.len(), 1)
  if cands2.len() == 1 then
    let c = cands2[0].clone()
    rc_lane_text(&mut out, "r2-target-kind", semantic_target_id_kind(c.target.clone()), "decl")
    rc_lane_text(&mut out, "r2-op", rc_template_text(c.operation.clone()), "InsertImpl(Display for R)")
    match c.operation.clone()
    when SemanticEditTemplate::InsertImpl(t, s) then
      rc_lane_text(&mut out, "r2-trait", t.clone(), "Display")
      rc_lane_text(&mut out, "r2-subject", s.clone(), "R")
    when _ then out.push("r2-op-kind: expected InsertImpl")
    end
    # The impl instantiation is an InsertStatement of the supplied text.
    let params2 = rc_lane_insert_params("m".to_string(), "m#item0".to_string(),
      "impl Display for R ... end".to_string())
    let inst2 = repair_instantiate(c.clone(), params2)
    rc_lane_text(&mut out, "r2-instantiate-kind", inst2.kind.clone(), "edit")
  end

  # ———— R3: Unavailable targets are typed ————
  let d3 = rc_lane_ownership_diag("r[i]".to_string(), "use".to_string())
  let cands3 = candidate_of_diagnostic(d3.clone())
  rc_lane_int(&mut out, "r3-count", cands3.len(), 3)
  if cands3.len() > 0 then
    let c3 = cands3[0].clone()
    rc_lane_text(&mut out, "r3-target-kind", semantic_target_id_kind(c3.target.clone()), "unavailable")
    match c3.target.clone()
    when SemanticTargetId::Unavailable(kind, reason) then
      rc_lane_text(&mut out, "r3-kind-word", kind.clone(), "place")
      rc_lane_bool(&mut out, "r3-reason", reason.len() > 0)
    when _ then out.push("r3-target: expected Unavailable")
    end
    # instantiate refuses fail-closed (never a marker edit).
    let inst3 = repair_instantiate(c3.clone(), repair_params_new())
    rc_lane_text(&mut out, "r3-instantiate-kind", inst3.kind.clone(), "unavailable")
    rc_lane_bool(&mut out, "r3-instantiate-no-edit",
      match inst3.edit
      when Option::None then true
      when Option::Some(_) then false
      end)
  end

  # ———— R4: explain <-> repair round trip from the typed diagnostic ————
  # The typed explain tree carries the payload class node; the same
  # diagnostic id keys the candidates; the context extraction reads the
  # class node by kind (no prose).
  let tree = diagnostic_explain_node(&d1)
  let class_rows = repair_context_rows_of_explain(tree)
  var saw_class = false
  var saw_place = false
  for r in class_rows do
    if r.starts_with("class:ownership-rejection:") then saw_class = true end
    if r == "place r" then saw_place = true end
  end
  rc_lane_bool(&mut out, "r4-explain-class", saw_class)
  rc_lane_bool(&mut out, "r4-explain-fact", saw_place)
  rc_lane_text(&mut out, "r4-diagnostic-round-trip",
    stable_diagnostic_id_text(cands1[0].clone().diagnostic),
    stable_diagnostic_id_text(repair_diagnostic_id_of(&d1)))

  # ———— R5: a payload-less diagnostic yields NO candidates ————
  let d_legacy = Diagnostic {
    level: DiagLevel::Error,
    message: "use of moved value `r`".to_string(),
    span: Option::Some(rc_lane_span(30)),
    notes: Vec::new(),
    suggestions: Vec::new(),
    code: Option::Some("E0201".to_string())
  }
  rc_lane_int(&mut out, "r5-no-prose-candidates", candidate_of_diagnostic(d_legacy.clone()).len(), 0)

  # ———— R6: stable repair id determinism + distinctness ————
  let again = candidate_of_diagnostic(d1.clone())
  rc_lane_text(&mut out, "r6-deterministic-id",
    stable_repair_id_text(cands1[0].clone().id),
    stable_repair_id_text(again[0].clone().id))
  rc_lane_bool(&mut out, "r6-distinct-ops",
    stable_repair_id_text(cands1[0].clone().id) != stable_repair_id_text(cands1[1].clone().id))
  rc_lane_bool(&mut out, "r6-digest-words",
    cands1[0].clone().id.digest_hi == again[0].clone().id.digest_hi &&
      cands1[0].clone().id.digest_lo == again[0].clone().id.digest_lo)

  # ———— R7: missing parameters fail closed ————
  let inst7 = repair_instantiate(cands1[0].clone(), repair_params_new())
  rc_lane_text(&mut out, "r7-missing-kind", inst7.kind.clone(), "missing-parameter")
  rc_lane_int(&mut out, "r7-missing-count", inst7.missing.len(), 3)

  out
end
