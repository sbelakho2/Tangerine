# Test struct, enum, impl, self, methods
enum Color
  Red
  Green
  Blue
end

struct Point
  x: Int
  y: Int
end

impl Point
  def sum(self) -> Int
    self.x + self.y
  end
end

def test_enum(c: Color) -> Int
  match c
  when Color::Red then 1
  when Color::Green then 2
  when Color::Blue then 3
  end
end

def main() -> Int
  let p = Point { x: 10, y: 20 }
  let s = p.sum()
  let c = test_enum(Color::Red)
  s + c  # 30 + 1 = 31
end
