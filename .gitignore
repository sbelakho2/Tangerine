# =============================================================================
# Tangerine — .gitignore
# =============================================================================
# NOTE: *.tg files are SOURCE files (std lib, golden tests, compiler-in-Tangerine).
#       They are NEVER ignored here.
# =============================================================================

# -----------------------------------------------------------------------------
# Rust / Cargo build artifacts
# -----------------------------------------------------------------------------
/target/
!/target/
target/*
!target/bugs_a_scan.json
**/target/
**/*.rs.bk

# -----------------------------------------------------------------------------
# Tangerine compiler output
# Intermediate / generated files produced when .tg sources are compiled.
# Source .tg files themselves are always tracked.
# -----------------------------------------------------------------------------

# LLVM / object-level intermediates
*.ll
*.bc
*.o
*.s

# Shared / static libraries that might be emitted
*.a
*.so
*.dylib
*.dll
*.lib
*.cmt
*.cmo
*.cmi
# Generic binary output name (e.g. `tg -o foo foo.tg` → plain `foo`)
# Add specific filenames here if needed; avoid blanket executable exclusions
# that could shadow intentional golden fixtures.

# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# -----------------------------------------------------------------------------
# IDE / editor
# -----------------------------------------------------------------------------
# JetBrains (IntelliJ, CLion, …)
.idea/
*.iml
*.iws
*.ipr

# VS Code (uncomment if you don't want to share settings)
# .vscode/

# Vim / Neovim / Emacs
*~
*.swp
*.swo
*.orig
\#*\#
.#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# Logs / temporary files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.cmt
.cmi
.cmo
# -----------------------------------------------------------------------------
# VSCode extension build output
# -----------------------------------------------------------------------------
tangerine-vscode/out/
tangerine-vscode/node_modules/
tangerine-vscode/*.vsix

# -----------------------------------------------------------------------------
# Coverage merge output (keep originals)
# -----------------------------------------------------------------------------
target/cqs/coverage/merged.tgcov

# -----------------------------------------------------------------------------
# CQS generated outputs (baselines are tracked; runtime outputs are not)
# -----------------------------------------------------------------------------
.tg/cqs/cache/*
!.tg/cqs/cache/.gitkeep

.tg/cqs/reports/*.json
.tg/cqs/reports/*.txt
!.tg/cqs/reports/.gitkeep

.tg/cqs/coverage/runs/*
!.tg/cqs/coverage/runs/.gitkeep

# -----------------------------------------------------------------------------
# OS / misc
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Build directory (all build artifacts and outputs)
# -----------------------------------------------------------------------------
build/
.build_stage0/
.tg/swift_build/

# -----------------------------------------------------------------------------
# Swift / stage0_swift build artifacts
# -----------------------------------------------------------------------------
stage0_swift/.build/
stage0_swift/.build_stage0/
stage0_swift/build/
stage0_swift/.swiftpm/
stage0_swift/.package-registry/
stage0_swift/*.xcodeproj/
stage0_swift/*.xcworkspace/
stage0_swift/Package.pins
stage0_swift/Package.resolved

# -----------------------------------------------------------------------------
# Generated / temporary .tg files (compiler test outputs)
# -----------------------------------------------------------------------------
build/*.tg
build/*.ll
build/*.bc
build/*.o
build/*.s
build/*.a
build/*.so
build/*.dylib
build/*.dll
build/*.lib
build/*.txt
build/*.err
build/*.out
build/*.status
build/*.cmd
build/*.tgcov

# -----------------------------------------------------------------------------
# Compiler version files (build artifacts)
# -----------------------------------------------------------------------------
tg_stage1_v*
tg_stage2_v*
tg_stage0

# -----------------------------------------------------------------------------
# Probe / test binaries (build artifacts)
# -----------------------------------------------------------------------------
arg_probe_bin
apply_op_test
calculator_stage0_probe
calculator_app/calculator_bin
calculator_test
calculator_wrapper_probe
stage1_bin
test_calc_mini_ocaml
test_calc_mini_wrapper
test_import_ocaml
test_simple
test_struct_enum_ocaml
tg
tg_compiler_ast_probe
tg_selfhost.*

# -----------------------------------------------------------------------------
# Disassembly / debug output files
# -----------------------------------------------------------------------------
*_disasm*.txt
*_disasm*.cmd
lldb_cmds

# -----------------------------------------------------------------------------
# Documentation / audit files (not source code)
# -----------------------------------------------------------------------------
checklist.md
stage3_bootstrap_audit.md
MCOT.txt
New.txt
tangerine_full.txt

# -----------------------------------------------------------------------------
# Script files (build/runtime helpers, not source)
# NOTE: run_bootstrap.sh is intentionally NOT ignored — CI depends on it
# (bash ./run_bootstrap.sh), so it must be tracked in the repository.
# -----------------------------------------------------------------------------
fix_generics.py

# -----------------------------------------------------------------------------
# In file (likely input/temporary)
# -----------------------------------------------------------------------------
in

# -----------------------------------------------------------------------------
# Image assets (logo, mascot)
# -----------------------------------------------------------------------------
logo.png
logo_black.png
mascot.png
