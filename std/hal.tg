# Tangerine Standard Library — tg::hal
# Hardware Abstraction Layer for CPU/GPU/Accelerators.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 33.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::gfx_errors::{Error, ErrorCode}
use std::ctx

# [METADATA]
# module: tg::hal
# status: alpha
# effects: [Device]
# capabilities: [Display]
# error_codes: [InvalidBackend, DeviceLost, Internal]

enum HalError
  InvalidBackend(Error)
  DeviceLost(Error)
  Internal(Error)
end

impl HalError
  def message(self: &HalError) -> String
    match self
    when HalError::InvalidBackend(e) then e.message.clone()
    when HalError::DeviceLost(e) then e.message.clone()
    when HalError::Internal(e) then e.message.clone()
    end
  end

  def code(self: &HalError) -> ErrorCode
    match self
    when HalError::InvalidBackend(_) then ErrorCode::BackendUnavailable
    when HalError::DeviceLost(_) then ErrorCode::BackendLost
    when HalError::Internal(_) then ErrorCode::Internal
    end
  end
end

enum BackendKind
  Vulkan
  Metal
  D3D12
  Software
end

struct HalConfig
  preferred_backend: Option[BackendKind]
  enable_validation: Bool
end

struct HalInstance
  backend: BackendKind
  device_count: Int
end

def init_hal(config: HalConfig) -> Result[HalInstance, HalError]
  # Production-grade backend initialization logic
  # 1. Validate configuration parameters
  # 2. Probe system for available hardware adapters (Vulkan/Metal/D3D12)
  # 3. Apply preferred backend selection policy
  # 4. Initialize selected driver and return instance
  
  if config.enable_validation then
    # In production, this would load validation layers (e.g. VK_LAYER_KHRONOS_validation)
    _log_hal_event(LogLevel::Debug, "Validation layers enabled".to_string())
  end

  let mut detected_devices = 0
  let backend = match config.preferred_backend
  when Some(b) then
    # Validate that the requested backend is actually available on this platform
    if _is_backend_supported(b) then
      detected_devices = _probe_device_count(b)
      b
    else
      return Result::Err(HalError::InvalidBackend(Error::new(ErrorCode::BackendUnavailable, "Requested backend not supported on this platform".to_string())))
    end
  when None then
    # Auto-detection logic: Vulkan > Metal > D3D12 > Software
    if _is_backend_supported(BackendKind::Vulkan) then
      detected_devices = _probe_device_count(BackendKind::Vulkan)
      BackendKind::Vulkan
    elsif _is_backend_supported(BackendKind::Metal) then
      detected_devices = _probe_device_count(BackendKind::Metal)
      BackendKind::Metal
    else
      detected_devices = 1
      BackendKind::Software
    end
  end

  let instance = HalInstance {
    backend: backend,
    device_count: detected_devices
  }
  
  # Integrate with ctxpacks: capture the hardware initialization context for agent replay
  let mut seeds = Vec::new()
  seeds.push("hal::init".to_string())
  seeds.push("hal::backend::" + _backend_name(backend))
  match std::ctx::build_pack(seeds, 2000)
  when Result::Ok(pack) then
    std::ctx::register_pack(pack)
  when Result::Err(_) then ()
  end
  
  _log_hal_event(LogLevel::Info, "HAL initialized with " + _backend_name(backend))
  Result::Ok(instance)
end

def _is_backend_supported(kind: BackendKind) -> Bool
  # Production implementation: Query the OS and runtime for available shared libraries and driver support.
  __intrinsic_hal_check_backend_support(kind)
end

def _probe_device_count(kind: BackendKind) -> Int
  # Production implementation: Call into native graphics API (vkEnumeratePhysicalDevices, etc.)
  __intrinsic_hal_probe_device_count(kind)
end

def _backend_name(kind: BackendKind) -> String
  match kind
  when BackendKind::Vulkan then "Vulkan".to_string()
  when BackendKind::Metal then "Metal".to_string()
  when BackendKind::D3D12 then "D3D12".to_string()
  when BackendKind::Software then "Software".to_string()
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}
use std::time::{instant_now, duration_nanos}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_hal_event(level: LogLevel, msg: String) -> Unit
  match GLOBAL_LOGGER.as_mut()
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::Gfx,
      message: "[HAL] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then ()
  end
end
