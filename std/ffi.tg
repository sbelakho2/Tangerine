## Tangerine Standard Library — std::ffi
## Foreign Function Interface for C interop, Ruby interop, and cross-language bridging.
##
## Tangerine uses `extern` blocks to declare foreign functions:
##
##   extern "C" do
##     def malloc(size: UInt) -> Ptr[u8]
##     def free(ptr: Ptr[u8]) -> Unit
##   end
##
##   extern "Ruby" do
##     def rb_funcall(recv: RubyValue, mid: RubyID, argc: Int, ...) -> RubyValue
##   end
##
## This module provides:
## 1. Primitive FFI types (Ptr, CStr, CString, Opaque)
## 2. Ruby C API bindings (VALUE, ID, rb_* functions)
## 3. Type marshaling between Tangerine and C/Ruby
## 4. Safe wrappers around unsafe FFI calls

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map}
use std::alloc::{size_of}

# ———————————————————————————————————————————————————————————————
# Primitive FFI types
# ———————————————————————————————————————————————————————————————

# Raw pointer type — opaque, unsafe to dereference without checks
struct Ptr[T]
  address: UInt
end

def address_of[T](v: &mut T) -> Ptr[T]
  v as Ptr[T]
end

# Ptr implementation — unified null pointer API
impl Ptr[T]
  # Creates a null pointer (Rust-style API: Ptr::null())
  def null() -> Ptr[T]
    Ptr { address: 0 }
  end

  # Check if pointer is null
  def is_null(self: &Self) -> Bool
    self.address == 0
  end

  # Check if pointer is non-null
  def is_some(self: &Self) -> Bool
    self.address != 0
  end

  # Convert to Option — Rust-style null safety
  # Returns None if null, Some(NonNull) if valid
  def to_option(self: &Self) -> Option[NonNull[T]]
    if self.address == 0 then
      Option::None
    else
      Option::Some(NonNull { ptr: self })
    end
  end

  # Cast to different pointer type
  def cast[U](self: &Self) -> Ptr[U]
    Ptr { address: self.address }
  end

  # Offset pointer by count elements
  #
  # # Safety
  # The caller must ensure:
  # - The resulting pointer remains within the same allocated object
  # - Or is one byte past the end of the allocated object
  #
  # In debug builds, this method performs bounds checking when possible.
  def offset(self: &Self, count: Int) -> Ptr[T]
    let elem_size = size_of[T]()
    let new_addr = self.address + (count * elem_size) as UInt
    
    # Debug assertion: check for overflow/underflow
    debug_assert!(
      count >= 0 || new_addr <= self.address,
      "Ptr::offset() caused underflow"
    )
    debug_assert!(
      count <= 0 || new_addr >= self.address,
      "Ptr::offset() caused overflow"
    )
    
    Ptr { address: new_addr }
  end

  # Add byte offset
  #
  # # Safety
  # The caller must ensure the resulting pointer remains valid.
  # Prefer offset() for element-based arithmetic when possible.
  def byte_add(self: &Self, bytes: UInt) -> Ptr[T]
    let new_addr = self.address + bytes
    
    # Debug assertion: check for overflow
    debug_assert!(new_addr >= self.address, "Ptr::byte_add() caused overflow")
    
    Ptr { address: new_addr }
  end
end

# NonNull[T] — Guaranteed non-null pointer (like Rust's NonNull<T>)
# Use this in APIs where null is never valid
struct NonNull[T]
  ptr: Ptr[T]
end

impl NonNull[T]
  # Create from raw pointer, panics if null
  def new(ptr: Ptr[T]) -> NonNull[T]
    if ptr.address == 0 then
      panic("NonNull::new called with null pointer")
    end
    NonNull { ptr: ptr }
  end

  # Create from raw pointer, returns None if null
  def try_new(ptr: Ptr[T]) -> Option[NonNull[T]]
    if ptr.address == 0 then
      Option::None
    else
      Option::Some(NonNull { ptr: ptr })
    end
  end

  # Get underlying pointer (guaranteed non-null)
  def as_ptr(self: &Self) -> Ptr[T]
    self.ptr
  end

  # Cast to different pointer type
  def cast[U](self: &Self) -> NonNull[U]
    NonNull { ptr: self.ptr.cast[U]() }
  end
end

# ———————————————————————————————————————————————————————————————
# OwnedPtr — resource wrapper owning a raw pointer
# ———————————————————————————————————————————————————————————————

resource OwnedPtr[T]
  ptr: Ptr[T]
end

impl[T] OwnedPtr[T]
  def new(ptr: Ptr[T]) -> OwnedPtr[T]
    OwnedPtr { ptr: ptr }
  end

  def deinit(sink self: Self) -> Unit
    let p = self.ptr
    if !p.is_null() then
      tg_free(p.cast[u8](), size_of[T](), 8)
    end
  end
end

# Null pointer constant (free function for backward compatibility)
def null_ptr[T]() -> Ptr[T]
  Ptr[T] { address: 0 }
end

# Check if pointer is null (free function for backward compatibility)
def is_null[T](p: &Ptr[T]) -> Bool
  p.address == 0
end

# Opaque type for foreign handles
struct Opaque
  _private: UInt
end

# C-compatible string (borrowed, NUL-terminated)
struct CStr
  ptr: Ptr[u8]
  len: Int
end

# Owned C-compatible string with NUL terminator.
# Holds an independently allocated copy of the source string data so the
# CString remains valid after the source String is dropped.
resource CString
  ptr: Ptr[u8]
end

def cstring_new(s: String) -> CString
  # Copy the string data into a freshly allocated, independently-owned buffer
  # so the CString does not alias the original String's storage.
  let src = s.as_ptr()
  let len = s.len()
  let buf = alloc(len + 1) as Ptr[u8]
  mut i = 0
  while i < len do
    unsafe "copy string byte to CString buffer" do
      *(buf.offset(i as isize)) = *(src.offset(i as isize))
    end
    i = i + 1
  end
  unsafe "NUL-terminate CString" do
    *(buf.offset(len as isize)) = 0
  end
  CString { ptr: buf }
end

def cstring_as_ptr(cs: &CString) -> Ptr[u8]
  cs.ptr
end

def cstring_to_string(cs: &CString) -> String
  if cs.ptr.is_null() then
    String::new()
  else
    unsafe "CString pointer must reference a NUL-terminated buffer" do
      String::from_c_str(cs.ptr)
    end
  end
end

impl CString
  def new(s: String) -> CString
    cstring_new(s)
  end

  def deinit(sink self: Self) -> Unit
    let p = self.ptr
    if !p.is_null() then
      tg_free(p, 1, 8)
    end
  end
end

unsafe def read_ptr[T](p: Ptr[T]) -> T
  *p
end

unsafe def write_ptr[T](p: PtrMut[T], x: T) -> Unit
  *p = x
end

# ———————————————————————————————————————————————————————————————
# C ABI type sizes and alignment
# ———————————————————————————————————————————————————————————————

enum CType
  Void
  Bool
  Char
  UChar
  Short
  UShort
  Int
  UInt
  Long
  ULong
  LongLong
  ULongLong
  Float
  Double
  SizeT
  PtrDiff
  Pointer
end

def c_type_size(ty: CType) -> Int
  match ty
  when CType::Void      then 0
  when CType::Bool      then 1
  when CType::Char      then 1
  when CType::UChar     then 1
  when CType::Short     then 2
  when CType::UShort    then 2
  when CType::Int       then 4
  when CType::UInt      then 4
  when CType::Long      then 8   # 64-bit platforms
  when CType::ULong     then 8
  when CType::LongLong  then 8
  when CType::ULongLong then 8
  when CType::Float     then 4
  when CType::Double    then 8
  when CType::SizeT     then 8
  when CType::PtrDiff   then 8
  when CType::Pointer   then 8
  end
end

def c_type_align(ty: CType) -> Int
  c_type_size(ty)  # On LP64, align == size for primitive types
end

# ———————————————————————————————————————————————————————————————
# Ruby C API types and constants
# ———————————————————————————————————————————————————————————————

# Ruby VALUE — an unsigned integer holding either an immediate value
# or a pointer to a heap-allocated Ruby object.
struct RubyValue
  raw: UInt
end

# Ruby ID — interned symbol for method/variable names
struct RubyID
  raw: UInt
end

# Ruby type tags (T_* constants from ruby/ruby.h)
def RUBY_T_NONE()    -> Int = 0x00
def RUBY_T_OBJECT()  -> Int = 0x01
def RUBY_T_CLASS()   -> Int = 0x02
def RUBY_T_MODULE()  -> Int = 0x03
def RUBY_T_FLOAT()   -> Int = 0x04
def RUBY_T_STRING()  -> Int = 0x05
def RUBY_T_REGEXP()  -> Int = 0x06
def RUBY_T_ARRAY()   -> Int = 0x07
def RUBY_T_HASH()    -> Int = 0x08
def RUBY_T_STRUCT()  -> Int = 0x09
def RUBY_T_BIGNUM()  -> Int = 0x0A
def RUBY_T_FILE()    -> Int = 0x0B
def RUBY_T_DATA()    -> Int = 0x0C
def RUBY_T_MATCH()   -> Int = 0x0D
def RUBY_T_COMPLEX() -> Int = 0x0E  
def RUBY_T_RATIONAL()-> Int = 0x0F  
def RUBY_T_NIL()     -> Int = 0x11
def RUBY_T_TRUE()    -> Int = 0x12  
def RUBY_T_FALSE()   -> Int = 0x13  
def RUBY_T_SYMBOL()  -> Int = 0x14
def RUBY_T_FIXNUM()  -> Int = 0x15

# Singleton VALUE constants
def RUBY_Qnil()   -> RubyValue = RubyValue { raw: 0x08 }
def RUBY_Qtrue()  -> RubyValue = RubyValue { raw: 0x14 }
def RUBY_Qfalse() -> RubyValue = RubyValue { raw: 0x00 }

# Check if a VALUE is nil
def ruby_nil_p(v: RubyValue) -> Bool
  v.raw == RUBY_Qnil().raw
end

# Check if a VALUE is a fixnum (tagged integer)
def ruby_fixnum_p(v: RubyValue) -> Bool
  (v.raw & 1) == 1
end

# Convert Int to Ruby fixnum VALUE (tagged pointer)
def int_to_ruby_fixnum(n: Int) -> RubyValue
  RubyValue { raw: ((n as UInt) << 1) | 1 }
end

# Convert Ruby fixnum VALUE to Int
def ruby_fixnum_to_int(v: RubyValue) -> Int
  (v.raw >> 1) as Int
end

# ———————————————————————————————————————————————————————————————
# Ruby C API function declarations
# ———————————————————————————————————————————————————————————————
# These are declared as extern "C" — the linker resolves them against
# libruby.dylib / libruby.so at link time.

extern "C" do
  # Initialization
  def ruby_init() -> Unit
  def ruby_init_loadpath() -> Unit
  def ruby_finalize() -> Unit

  # Module / class definition
  def rb_define_module(name: Ptr[u8]) -> RubyValue
  def rb_define_class(name: Ptr[u8], super_: RubyValue) -> RubyValue
  def rb_define_class_under(outer: RubyValue, name: Ptr[u8], super_: RubyValue) -> RubyValue
  def rb_define_module_under(outer: RubyValue, name: Ptr[u8]) -> RubyValue

  # Method definition
  def rb_define_method(klass: RubyValue, name: Ptr[u8], func: Ptr[u8], argc: Int) -> Unit
  def rb_define_singleton_method(obj: RubyValue, name: Ptr[u8], func: Ptr[u8], argc: Int) -> Unit
  def rb_define_module_function(mod_: RubyValue, name: Ptr[u8], func: Ptr[u8], argc: Int) -> Unit

  # Method invocation
  def rb_funcall(recv: RubyValue, mid: RubyID, argc: Int) -> RubyValue
  def rb_funcall2(recv: RubyValue, mid: RubyID, argc: Int, argv: Ptr[RubyValue]) -> RubyValue

  # Symbol / ID operations
  def rb_intern(name: Ptr[u8]) -> RubyID
  def rb_id2name(id: RubyID) -> Ptr[u8]
  def rb_id2sym(id: RubyID) -> RubyValue
  def rb_sym2id(sym: RubyValue) -> RubyID

  # String operations
  def rb_str_new(ptr: Ptr[u8], len: Int) -> RubyValue
  def rb_str_new_cstr(cstr: Ptr[u8]) -> RubyValue
  def rb_string_value_cstr(valp: Ptr[RubyValue]) -> Ptr[u8]
  def rb_str_cat(str_: RubyValue, ptr: Ptr[u8], len: Int) -> RubyValue
  def rb_str_to_str(val: RubyValue) -> RubyValue

  # Array operations
  def rb_ary_new() -> RubyValue
  def rb_ary_new_capa(capa: Int) -> RubyValue
  def rb_ary_push(ary: RubyValue, item: RubyValue) -> RubyValue
  def rb_ary_pop(ary: RubyValue) -> RubyValue
  def rb_ary_entry(ary: RubyValue, idx: Int) -> RubyValue
  def rb_ary_store(ary: RubyValue, idx: Int, val: RubyValue) -> Unit
  def rb_ary_len(ary: RubyValue) -> Int

  # Hash operations
  def rb_hash_new() -> RubyValue
  def rb_hash_aset(hash: RubyValue, key: RubyValue, val: RubyValue) -> RubyValue
  def rb_hash_aref(hash: RubyValue, key: RubyValue) -> RubyValue
  def rb_hash_delete(hash: RubyValue, key: RubyValue) -> RubyValue

  # Type conversion
  def rb_num2int(val: RubyValue) -> Int
  def rb_int2num(n: Int) -> RubyValue
  def rb_num2dbl(val: RubyValue) -> Float
  def rb_float_new(d: Float) -> RubyValue

  # Object type checking
  def rb_obj_is_kind_of(obj: RubyValue, klass: RubyValue) -> RubyValue
  def rb_type(obj: RubyValue) -> Int
  def rb_obj_classname(obj: RubyValue) -> Ptr[u8]

  # Constants
  def rb_cObject() -> RubyValue
  def rb_cArray() -> RubyValue
  def rb_cHash() -> RubyValue
  def rb_cString() -> RubyValue
  def rb_cInteger() -> RubyValue
  def rb_cFloat() -> RubyValue
  def rb_cNilClass() -> RubyValue
  def rb_cTrueClass() -> RubyValue
  def rb_cFalseClass() -> RubyValue
  def rb_cSymbol() -> RubyValue
  def rb_mKernel() -> RubyValue

  # Exception handling
  def rb_raise(exc: RubyValue, msg: Ptr[u8]) -> Unit
  def rb_exc_new_str(exc_class: RubyValue, msg: RubyValue) -> RubyValue
  def rb_eRuntimeError() -> RubyValue
  def rb_eTypeError() -> RubyValue
  def rb_eArgError() -> RubyValue
  def rb_eStandardError() -> RubyValue

  # Evaluation
  def rb_eval_string(str_: Ptr[u8]) -> RubyValue
  def rb_eval_string_protect(str_: Ptr[u8], state: Ptr[Int]) -> RubyValue

  # Require / load
  def rb_require(name: Ptr[u8]) -> RubyValue

  # GC
  def rb_gc_register_address(valp: Ptr[RubyValue]) -> Unit
  def rb_gc_unregister_address(valp: Ptr[RubyValue]) -> Unit

  # Global variables
  def rb_gv_set(name: Ptr[u8], val: RubyValue) -> RubyValue
  def rb_gv_get(name: Ptr[u8]) -> RubyValue
end

# ———————————————————————————————————————————————————————————————
# Safe Tangerine ↔ Ruby value marshaling
# ———————————————————————————————————————————————————————————————

# Convert a Tangerine String to a Ruby String VALUE
def tg_string_to_ruby(s: String) -> RubyValue
  let cs = cstring_new(s)
  rb_str_new_cstr(cstring_as_ptr(&cs))
end

# Convert a Ruby String VALUE to a Tangerine String
def ruby_to_tg_string(v: RubyValue) -> Result[String, String]
  let rtype = rb_type(v)
  if rtype != RUBY_T_STRING() then
    # Try to_s conversion (one attempt only — guard against infinite recursion)
    let to_s_id = rb_intern(cstring_as_ptr(&cstring_new("to_s")))
    let sv = rb_funcall(v, to_s_id, 0)
    let sv_type = rb_type(sv)
    if sv_type != RUBY_T_STRING() then
      return Result::Err("Ruby value could not be converted to String via to_s")
    end
    let mut sv_holder = sv
    let sv_cptr = rb_string_value_cstr(Ptr { address: address_of(&mut sv_holder) as UInt })
    if sv_cptr.address == 0 then
      return Result::Err("Ruby to_s conversion returned null")
    end
    return Result::Ok(String::from_c_str(sv_cptr))
  end
  let mut val_holder = v
  let cptr = rb_string_value_cstr(Ptr { address: address_of(&mut val_holder) as UInt })
  if cptr.address == 0 then
    Result::Err("Ruby string conversion returned null")
  else
    Result::Ok(String::from_c_str(cptr))
  end
end

# Convert a Tangerine Int to Ruby Integer
def tg_int_to_ruby(n: Int) -> RubyValue
  rb_int2num(n)
end

# Convert a Ruby Integer to Tangerine Int
def ruby_to_tg_int(v: RubyValue) -> Int
  if ruby_fixnum_p(v) then
    ruby_fixnum_to_int(v)
  else
    rb_num2int(v)
  end
end

# Convert a Tangerine Float to Ruby Float
def tg_float_to_ruby(f: Float) -> RubyValue
  rb_float_new(f)
end

# Convert a Ruby Float to Tangerine Float
def ruby_to_tg_float(v: RubyValue) -> Float
  rb_num2dbl(v)
end

# Convert a Tangerine Bool to Ruby true/false
def tg_bool_to_ruby(b: Bool) -> RubyValue
  if b then RUBY_Qtrue() else RUBY_Qfalse() end
end

# Convert a Ruby Bool VALUE to Tangerine Bool
def ruby_to_tg_bool(v: RubyValue) -> Bool
  v.raw != RUBY_Qfalse().raw && v.raw != RUBY_Qnil().raw
end

# Convert Tangerine Unit to Ruby nil
def tg_unit_to_ruby() -> RubyValue
  RUBY_Qnil()
end

# Convert a Tangerine Option[T] style result (None ↔ nil)
def tg_option_to_ruby[T](opt: Option[T], convert: fn(T) -> RubyValue) -> RubyValue
  match opt
  when Option::Some(val) then convert(val)
  when Option::None then RUBY_Qnil()
  end
end

# Convert a Tangerine Vec[T] to a Ruby Array
def tg_vec_to_ruby[T](vec: &Vec[T], convert: fn(&T) -> RubyValue) -> RubyValue
  let ary = rb_ary_new_capa(vec.len())
  for item in vec do
    rb_ary_push(ary, convert(&item))
  end
  ary
end

# Convert a Ruby Array to a Tangerine Vec[T]
def ruby_to_tg_vec[T](ary: RubyValue, convert: fn(RubyValue) -> T) -> Vec[T]
  mut result = Vec::new()
  let len = rb_ary_len(ary)
  mut i = 0
  while i < len do
    let elem = rb_ary_entry(ary, i)
    result.push(convert(elem))
    i = i + 1
  end
  result
end

# Convert a Tangerine Map[String, T] to a Ruby Hash
def tg_map_to_ruby[T](map: &Map[String, T], convert: fn(&T) -> RubyValue) -> RubyValue
  let hash = rb_hash_new()
  for (k, v) in map do
    let ruby_key = tg_string_to_ruby(k.clone())
    let ruby_val = convert(&v)
    rb_hash_aset(hash, ruby_key, ruby_val)
  end
  hash
end

# ———————————————————————————————————————————————————————————————
# Ruby runtime lifecycle
# ———————————————————————————————————————————————————————————————

struct RubyRuntime
  initialized: Bool
end


extern "C" do
  def __sync_bool_compare_and_swap_1(ptr: Ptr[u8], expected: u8, desired: u8) -> Bool
  def __sync_synchronize() -> Unit
end

mut _RUBY_RUNTIME_LOCK: u8 = 0
mut _RUBY_RUNTIME: Option[RubyRuntime] = Option::None

def ruby_runtime_lock() -> Unit
  while !__sync_bool_compare_and_swap_1(&_RUBY_RUNTIME_LOCK, 0, 1) do
    # Spin
  end
end

def ruby_runtime_unlock() -> Unit
  __sync_synchronize()
  _RUBY_RUNTIME_LOCK = 0
end

def ruby_start() -> Result[RubyRuntime, String]
  ruby_runtime_lock()
  match _RUBY_RUNTIME
  when Option::Some(_) then
    ruby_runtime_unlock()
    return Result::Err("Ruby runtime already initialized")
  when Option::None then ()
  end
  
  ruby_init()
  ruby_init_loadpath()
  
  let rt = RubyRuntime { initialized: true }
  _RUBY_RUNTIME = Option::Some(rt)
  ruby_runtime_unlock()
  Result::Ok(rt)
end

def ruby_stop() -> Unit
  ruby_runtime_lock()
  match _RUBY_RUNTIME
  when Option::Some(_) then
    ruby_finalize()
    _RUBY_RUNTIME = Option::None
  when Option::None then ()
  end
  ruby_runtime_unlock()
end

# ———————————————————————————————————————————————————————————————
# Safe Ruby method calls
# ———————————————————————————————————————————————————————————————

# Call a Ruby method by name on a receiver, with no arguments
def ruby_call(recv: RubyValue, method: String) -> RubyValue
  let mid = rb_intern(cstring_as_ptr(&cstring_new(method)))
  rb_funcall(recv, mid, 0)
end

# Call a Ruby method with one argument
def ruby_call1(recv: RubyValue, method: String, arg1: RubyValue) -> RubyValue
  let mid = rb_intern(cstring_as_ptr(&cstring_new(method)))
  let mut args = Vec::new()
  args.push(arg1)
  rb_funcall2(recv, mid, 1, args.as_ptr_address() as Ptr[RubyValue])
end

# Call a Ruby method with two arguments
def ruby_call2(recv: RubyValue, method: String, arg1: RubyValue, arg2: RubyValue) -> RubyValue
  let mid = rb_intern(cstring_as_ptr(&cstring_new(method)))
  let mut args = Vec::new()
  args.push(arg1)
  args.push(arg2)
  rb_funcall2(recv, mid, 2, args.as_ptr_address() as Ptr[RubyValue])
end

# Call a Ruby method with a variable number of arguments
def ruby_call_args(recv: RubyValue, method: String, args: &Vec[RubyValue]) -> RubyValue
  let mid = rb_intern(cstring_as_ptr(&cstring_new(method)))
  rb_funcall2(recv, mid, args.len(), args.as_ptr_address() as Ptr[RubyValue])
end

# Evaluate a string of Ruby code
def ruby_eval(code: String) -> Result[RubyValue, String]
  let cs = cstring_new(code)
  mut state: Int = 0
  let result = rb_eval_string_protect(cstring_as_ptr(&cs), Ptr { address: address_of(&mut state) as UInt })
  if state != 0 then
    # Exception occurred
    let exc = ruby_call(result, "message")
    match ruby_to_tg_string(exc)
    when Result::Ok(msg) then Result::Err("Ruby exception: " + msg)
    when Result::Err(_) then Result::Err("Ruby exception (could not read message)")
    end
  else
    Result::Ok(result)
  end
end

# Require a Ruby file/gem
def ruby_require(name: String) -> Result[Unit, String]
  let cs = cstring_new(name)
  let mut state: Int = 0
  rb_eval_string_protect(
    cstring_as_ptr(&cstring_new("require '" + name + "'")),
    Ptr { address: address_of(&mut state) as UInt }
  )
  if state != 0 then
    Result::Err("Failed to require: " + name)
  else
    Result::Ok(())
  end
end

# ———————————————————————————————————————————————————————————————
# Expose Tangerine functions to Ruby
# ———————————————————————————————————————————————————————————————

# Register a Tangerine module in Ruby
def ruby_define_module(name: String) -> RubyValue
  rb_define_module(cstring_as_ptr(&cstring_new(name)))
end

# Register a Tangerine class in Ruby
def ruby_define_class(name: String, parent: RubyValue) -> RubyValue
  rb_define_class(cstring_as_ptr(&cstring_new(name)), parent)
end

# Register a Tangerine function as a Ruby method on a class/module
# `func_ptr` is a pointer to a C-ABI compatible function:
#   RubyValue func(RubyValue self, RubyValue arg1, ...)  for argc >= 0
#   RubyValue func(int argc, RubyValue *argv, RubyValue self)  for argc == -1
def ruby_define_method(klass: RubyValue, name: String, func_ptr: Ptr[u8], argc: Int) -> Unit
  rb_define_method(klass, cstring_as_ptr(&cstring_new(name)), func_ptr, argc)
end

def ruby_define_module_function(mod_: RubyValue, name: String, func_ptr: Ptr[u8], argc: Int) -> Unit
  rb_define_module_function(mod_, cstring_as_ptr(&cstring_new(name)), func_ptr, argc)
end

# ———————————————————————————————————————————————————————————————
# Dynamic library loading (for runtime FFI)
# ———————————————————————————————————————————————————————————————

extern "C" do
  def dlopen(path: Ptr[u8], flags: Int) -> Ptr[u8]
  def dlsym(handle: Ptr[u8], symbol: Ptr[u8]) -> Ptr[u8]
  def dlclose(handle: Ptr[u8]) -> Int
  def dlerror() -> Ptr[u8]
end

def RTLD_LAZY()    -> Int = 1
def RTLD_NOW()     -> Int = 2
def RTLD_GLOBAL()  -> Int = 8

struct DynLib
  handle: Ptr[u8]
  path: String
end

# Load a shared library (.dylib / .so / .dll)
def dynlib_open(path: String) -> Result[DynLib, String]
  let cs = cstring_new(path)
  let handle = dlopen(cstring_as_ptr(&cs), RTLD_LAZY())
  if is_null(&handle) then
    let err = dlerror()
    if is_null(&Ptr[u8] { address: err.address }) then
      Result::Err("Failed to load library: " + path)
    else
      Result::Err("Failed to load library: " + String::from_c_str(err))
    end
  else
    Result::Ok(DynLib { handle: handle, path: path })
  end
end

# Look up a symbol in a loaded library
def dynlib_sym(lib: &DynLib, name: String) -> Result[Ptr[u8], String]
  let cs = cstring_new(name)
  let sym = dlsym(lib.handle, cstring_as_ptr(&cs))
  if is_null(&sym) then
    Result::Err("Symbol not found: " + name)
  else
    Result::Ok(sym)
  end
end

# Close a loaded library
def dynlib_close(lib: DynLib) -> Unit
  let _ = dlclose(lib.handle)
end

# ———————————————————————————————————————————————————————————————
# Callback wrapping for passing Tangerine closures to C/Ruby
# ———————————————————————————————————————————————————————————————

# FfiCallback wraps a Tangerine closure as a C function pointer.
# The compiler generates a trampoline that restores the closure
# environment before invoking the body.
struct FfiCallback
  fn_ptr: Ptr[u8]       # C-callable function pointer (generated trampoline)
  closure_env: Ptr[u8]  # Pointer to captured environment
  _prevent_gc: Bool     # Prevent GC from collecting the environment
end

# Create a callback wrapping a Tangerine closure.
# The closure must have C-compatible parameter and return types.
# `arity` is the number of parameters.
# The compiler will generate the appropriate trampoline at codegen time.
def make_ffi_callback(closure_fn: Ptr[u8], closure_env: Ptr[u8], arity: Int) -> FfiCallback
  # Guard: closure_fn must not be null (would produce a callback that traps on call)
  if is_null(&closure_fn) then
    panic("make_ffi_callback: closure_fn must not be null")
  end
  # The actual trampoline generation happens in codegen.
  # This function records the closure info so the linker can wire it up.
  FfiCallback {
    fn_ptr: closure_fn,
    closure_env: closure_env,
    _prevent_gc: true
  }
end

# ———————————————————————————————————————————————————————————————
# Convenience: Ruby gem interop
# ———————————————————————————————————————————————————————————————

# Load a Ruby gem and return a handle to its main module
def ruby_gem_load(gem_name: String) -> Result[RubyValue, String]
  match ruby_require(gem_name) 
  when Result::Ok(_) then
    # Try to find the module with the capitalized gem name
    let module_name = gem_name_to_module(gem_name)
    let cs = cstring_new(module_name)
    # Use a local state variable — passing null as state pointer would
    # cause rb_eval_string_protect to dereference null on exception.
    mut state: Int = 0
    let result = rb_eval_string_protect(
      cstring_as_ptr(&cstring_new(module_name)),
      Ptr { address: address_of(&mut state) as UInt }
    )
    if state != 0 then
      Result::Err("Failed to resolve module: " + module_name)
    else
      Result::Ok(result)
    end
  when Result::Err(e) then Result::Err(e)
  end
end

# Convert gem name to Ruby module name (e.g., "active_support" → "ActiveSupport")
def gem_name_to_module(name: String) -> String
  mut result = ""
  mut capitalize_next = true
  for ch in name.chars() do
    if ch == '_' || ch == '-' then
      capitalize_next = true
    else
      if capitalize_next then
        result = result + ch.to_uppercase().to_string()
        capitalize_next = false
      else
        result = result + ch.to_string()
      end
    end
  end
  result
end

# ———————————————————————————————————————————————————————————————
# Tangerine Interop ABI Types (per interop.txt)
# ———————————————————————————————————————————————————————————————

# TgResult — FFI-safe result type for C interop (repr(c))
# Per interop.txt §7.2
@repr(C)
pub struct TgResult[T]
  ok: Bool           # true if success, false if error
  err_code: Int      # 0 if ok, otherwise error code
  value: T           # valid only if ok == true
end

pub def tg_result_ok[T](value: T) -> TgResult[T]
  TgResult { ok: true, err_code: 0, value: value }
end

pub def tg_result_err[T](code: Int, default_value: T) -> TgResult[T]
  TgResult { ok: false, err_code: code, value: default_value }
end

pub def tg_result_is_ok[T](r: &TgResult[T]) -> Bool
  r.ok
end

pub def tg_result_unwrap[T](r: TgResult[T]) -> T
  if r.ok then
    r.value
  else
    panic("TgResult::unwrap called on Err")
  end
end

# ———————————————————————————————————————————————————————————————
# Ownership Qualifiers for FFI (per interop.txt §6.1)
# ———————————————————————————————————————————————————————————————

# Borrowed — pointer does not transfer ownership; valid only for call duration
@repr(C)
pub struct Borrowed[T]
  ptr: Ptr[T]
end

pub def borrowed[T](ptr: Ptr[T]) -> Borrowed[T]
  Borrowed { ptr: ptr }
end

pub def borrowed_get[T](b: &Borrowed[T]) -> Ptr[T]
  if b.ptr.is_null() then
    panic("borrowed_get: null pointer")
  end
  b.ptr
end

# Owned — ownership transfers to callee; callee must free
@repr(C)
pub struct Owned[T]
  ptr: Ptr[T]
  alloc_domain: AllocDomain
end

pub enum AllocDomain
  Tangerine    # freed via tg_free
  C            # freed via free()
  Ruby         # managed by Ruby GC
end

extern "C" do
  def __sync_fetch_and_add(ptr: Ptr[UInt], val: UInt) -> UInt
  def __sync_fetch_and_sub(ptr: Ptr[UInt], val: UInt) -> UInt
end

pub def owned_new[T](ptr: Ptr[T], domain: AllocDomain) -> Owned[T]
  Owned { ptr: ptr, alloc_domain: domain }
end

pub def owned_get[T](o: &Owned[T]) -> Ptr[T]
  if o.ptr.is_null() then
    panic("owned_get: null pointer")
  end
  o.ptr
end

pub def owned_take[T](o: Owned[T]) -> (Ptr[T], AllocDomain)
  (o.ptr, o.alloc_domain)
end

# Shared — reference-counted or VM-managed handle
@repr(C)
pub struct Shared[T]
  ptr: Ptr[T]
  refcount: Ptr[UInt]
end

pub def shared_new[T](ptr: Ptr[T]) -> Shared[T]
  # Allocate refcount
  let rc = tg_alloc(8, 8) as Ptr[UInt]
  if rc.is_null() then
    panic("shared_new: failed to allocate refcount")
  end
  unsafe "dereferencing raw pointer" do *rc = 1 end
  Shared { ptr: ptr, refcount: rc }
end

pub def shared_clone[T](s: &Shared[T]) -> Shared[T]
  if s.refcount.is_null() then
    panic("shared_clone: null refcount")
  end
  __sync_fetch_and_add(s.refcount, 1)
  Shared { ptr: s.ptr, refcount: s.refcount }
end

pub def shared_drop[T](s: Shared[T]) -> Unit
  if s.refcount.is_null() then
    return
  end
  let prev = __sync_fetch_and_sub(s.refcount, 1)
  if prev == 1 then
    if !s.ptr.is_null() then
      tg_free(s.ptr as Ptr[u8], size_of[T](), 8)
    end
    tg_free(s.refcount as Ptr[u8], 8, 8)
  end
end

# ———————————————————————————————————————————————————————————————
# FFI Slice/Str Views (per interop.txt §5.5)
# ———————————————————————————————————————————————————————————————

# Slice[T] — borrowed view of contiguous memory (repr(c))
@repr(C)
pub struct FfiSlice[T]
  ptr: Ptr[T]
  len: UInt
end

pub def ffi_slice_new[T](ptr: Ptr[T], len: UInt) -> FfiSlice[T]
  FfiSlice { ptr: ptr, len: len }
end

pub def ffi_slice_empty[T]() -> FfiSlice[T]
  FfiSlice { ptr: null_ptr(), len: 0 }
end

# FfiStr — UTF-8 string view (borrowed, repr(c))
@repr(C)
pub struct FfiStr
  ptr: Ptr[u8]
  len: UInt
end

pub def ffi_str_new(ptr: Ptr[u8], len: UInt) -> FfiStr
  FfiStr { ptr: ptr, len: len }
end

pub def ffi_str_from_string(s: &String) -> FfiStr
  FfiStr { ptr: s.as_ptr(), len: s.len() }
end

pub def ffi_str_to_string(s: &FfiStr) -> String
  if s.len == 0 then
    return ""
  end

  if s.ptr.is_null() then
    return ""
  end

  String::from_utf8_unchecked(s.ptr, s.len)
end

# ———————————————————————————————————————————————————————————————
# Tangerine Runtime Exports (per interop.txt §11)
# ———————————————————————————————————————————————————————————————

# Last error tracking (thread-local)
static mut _last_error_code: Int = 0
static mut _last_error_message: String = ""

# 11.1 Allocation
@export("tg_alloc")
pub def tg_alloc(size: UInt, align: UInt) -> Ptr[u8]
  use std::alloc::system_alloc
  system_alloc(size, align)
end

@export("tg_realloc")
pub def tg_realloc(ptr: Ptr[u8], new_size: UInt, align: UInt) -> Ptr[u8]
  use std::alloc::system_realloc
  system_realloc(ptr, new_size, align)
end

@export("tg_free")
pub def tg_free(ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
  use std::alloc::system_free
  system_free(ptr, size, align)
end

# 11.2 Error helpers
@export("tg_last_error_code")
pub def tg_last_error_code() -> Int
  _last_error_code
end

@export("tg_last_error_message")
pub def tg_last_error_message(out: Ptr[FfiStr]) -> Unit
  if out.is_null() then
    return
  end
  unsafe "dereferencing raw pointer" do
    *out = ffi_str_from_string(&_last_error_message)
  end
end

pub def tg_set_last_error(code: Int, message: String) -> Unit
  _last_error_code = code
  _last_error_message = message
end

pub def tg_clear_last_error() -> Unit
  _last_error_code = 0
  _last_error_message = ""
end

# 11.3 Ruby bridge
@export("tg_ruby_init")
pub def tg_ruby_init() -> Bool
  ruby_init()
  true
end

@export("tg_ruby_eval")
pub def tg_ruby_eval(code: FfiStr) -> TgResult[RubyValue]
  let code_str = ffi_str_to_string(&code)
  match ruby_eval(&code_str)
  when Result::Ok(v) then tg_result_ok(v)
  when Result::Err(e) then
    tg_set_last_error(1, e)
    tg_result_err(1, RUBY_Qnil())
  end
end

@export("tg_ruby_gc_register")
pub def tg_ruby_gc_register(v: RubyValue) -> Unit
  rb_gc_register_address(Ptr { address: address_of(&mut v.raw) as UInt })
end

@export("tg_ruby_gc_unregister")
pub def tg_ruby_gc_unregister(v: RubyValue) -> Unit
  rb_gc_unregister_address(Ptr { address: address_of(&mut v.raw) as UInt })
end

# ———————————————————————————————————————————————————————————————
# ABI Version Info
# ———————————————————————————————————————————————————————————————

pub const FFI_ABI_EDITION: String = "2026"
pub const FFI_ABI_REVISION: UInt = 1

@export("tg_abi_edition")
pub def tg_abi_edition() -> FfiStr
  ffi_str_from_string(&FFI_ABI_EDITION)
end

@export("tg_abi_revision")
pub def tg_abi_revision() -> UInt
  FFI_ABI_REVISION
end

# ———————————————————————————————————————————————————————————————
# §12 — FFI Taint Integration
# ———————————————————————————————————————————————————————————————

## All data entering Tangerine through FFI boundaries is automatically
## wrapped in Tainted[T] by the compiler. This section documents the
## integration points.
##
## The compiler inserts taint wrappers at:
##   1. Return values of `extern` function calls → Tainted[ReturnType]
##   2. Parameters passed TO Tangerine callbacks FROM FFI → Tainted[ParamType]
##   3. Data read from FFI pointers (Ptr.read()) → Tainted[T]
##
## To use FFI data, callers MUST validate through std::taint::validate().
##
## Example:
##   extern "C" do
##     def getenv(name: CStr) -> Ptr[u8]  # Returns Tainted[Ptr[u8]]
##   end
##
##   def get_home() -> Result[String, String]
##     let raw = getenv(c_str("HOME"))           # Tainted[Ptr[u8]]
##     let validated = validate(raw, NonNullValidator {})  # Result[Ptr[u8], ...]
##     match validated
##       when Result::Ok(ptr) then
##         let s = c_str_from_ptr(ptr)            # Still Tainted[String]
##         validate(s, MaxLengthValidator { max_len: 4096 })
##       when Result::Err(e) then Result::Err(e.message)
##     end
##   end

## Marker trait: types that cross FFI boundary get auto-tainted.
trait FfiBoundary end

## Applied by compiler to all extern return types.
## Not called directly — compiler inserts this at codegen.
def __ffi_auto_taint[T: FfiBoundary](value: T, source: String) -> Tainted[T]
  use std::taint::{taint, TaintLabel}
  taint(value, TaintLabel::FfiInput)
end

## Applied by compiler to callback parameters from FFI.
def __ffi_callback_taint[T: FfiBoundary](value: T, callback: String) -> Tainted[T]
  use std::taint::{taint, TaintLabel}
  taint(value, TaintLabel::FfiCallback)
end
