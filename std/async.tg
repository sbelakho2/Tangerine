# Tangerine Standard Library — Async Runtime
#
# Provides cooperative async/await execution with a single-threaded
# executor, task spawning, channels, timers, and join handles.
#
# Architecture:
# - Executor: runs tasks in a cooperative event loop
# - Task: a future that can be polled to completion
# - Waker: notifies the executor that a task is ready
# - Channel: async MPSC message passing
# - Timer: async sleep and timeout support

use std::core::{Option, Result, Vec, String, Bool, UInt, Int}
use std::collections::{Map, VecDeque}
use std::atomic::{AtomicInt, Ordering}
use std::sync::{Arc, AtomicBool}
use std::io::{Read, Write, IOError}
use std::net::{TcpStream}
use std::time::{Instant, Duration, instant_now, duration_millis, duration_nanos}

# [METADATA]
# module: tg::async
# status: alpha
# effects: [Async, Kernel, Io]
# capabilities: [Net, Unsafe]
# error_codes: [TaskPanic, Io, Internal]
# description: "Async runtime, task scheduling, timers, and deterministic scheduler mode."
# examples:
#   - |
#     use std::async::{Executor, block_on}
#     block_on(async { 42 })

use std::gfx_errors::{Error, ErrorCode}

enum AsyncError
  TaskPanic(Error)
  Io(Error)
  Internal(Error)
end

impl AsyncError
  def message(self: AsyncError) -> String
    match self
    when AsyncError::TaskPanic(e) then e.message.clone()
    when AsyncError::Io(e) then e.message.clone()
    when AsyncError::Internal(e) then e.message.clone()
    end
  end

  def code(self: AsyncError) -> ErrorCode
    match self
    when AsyncError::TaskPanic(_) then ErrorCode::Internal
    when AsyncError::Io(_) then ErrorCode::IOError
    when AsyncError::Internal(_) then ErrorCode::Internal
    end
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_async_event(level: LogLevel, msg: String) -> Unit
  match GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: 0,
      level: level,
      category: LogCategory::App,
      message: "[ASYNC] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then {}
  end
end

# ———————————————————————————————————————————————————————————————

# ———————————————————————————————————————————————————————————————

# Platform detection at compile time
@cfg(target_os = "linux")
const USE_EPOLL: Bool = true

@cfg(not(target_os = "linux"))
const USE_EPOLL: Bool = false

@cfg(any(target_os = "macos", target_os = "freebsd"))
const USE_KQUEUE: Bool = true

@cfg(not(any(target_os = "macos", target_os = "freebsd")))
const USE_KQUEUE: Bool = false

# FFI for epoll (Linux) — the C `int` returns declare the i32 form; the
# wrappers below widen with the explicit `as Int` (the reactor stores the
# descriptor in an Int field and the `kq < 0` error checks must see the
# sign-extended -1).
extern "C" def c_epoll_create1(flags: Int) -> i32
extern "C" def c_epoll_ctl(epfd: Int, op: Int, fd: Int, event: Ptr[EpollEvent]) -> i32
extern "C" def c_epoll_wait(epfd: Int, events: PtrMut[EpollEvent], maxevents: Int, timeout: Int) -> i32

# FFI for kqueue (macOS/BSD)
extern "C" def c_kqueue() -> i32
extern "C" def c_kevent(kq: Int, changelist: Ptr[Kevent], nchanges: Int, 
                       eventlist: PtrMut[Kevent], nevents: Int, timeout: Ptr[Timespec]) -> i32

def epoll_create1(flags: Int) -> Int
  c_epoll_create1(flags as i32) as Int
end

def epoll_ctl(epfd: Int, op: Int, fd: Int, event: Ptr[EpollEvent]) -> Int
  c_epoll_ctl(epfd as i32, op as i32, fd as i32, event) as Int
end

def epoll_wait(epfd: Int, events: PtrMut[EpollEvent], maxevents: Int, timeout: Int) -> Int
  c_epoll_wait(epfd as i32, events, maxevents as i32, timeout as i32) as Int
end

def kqueue() -> Int
  c_kqueue() as Int
end

def kevent(kq: Int, changelist: Ptr[Kevent], nchanges: Int,
           eventlist: PtrMut[Kevent], nevents: Int, timeout: Ptr[Timespec]) -> Int
  c_kevent(kq as i32, changelist, nchanges as i32, eventlist, nevents as i32, timeout) as Int
end

# epoll constants
const EPOLL_CTL_ADD: Int = 1
const EPOLL_CTL_DEL: Int = 2
const EPOLL_CTL_MOD: Int = 3
const EPOLLIN: u32 = 0x001
const EPOLLOUT: u32 = 0x004
const EPOLLERR: u32 = 0x008
const EPOLLHUP: u32 = 0x010

# kqueue filter/flag constants
const EV_ADD: u16 = 0x0001
const EV_DELETE: u16 = 0x0002
const EV_ENABLE: u16 = 0x0004
const EV_ONESHOT: u16 = 0x0010

def evfilt_read() -> i16
  -1
end

def evfilt_write() -> i16
  -2
end

struct EpollEvent
  events: u32
  data: u64   # user data (task_id)
end

struct Kevent
  ident: UInt      # identifier (fd)
  filter: i16      # filter type
  flags: u16       # action flags
  fflags: u32      # filter-specific flags
  data: Int        # filter-specific data
  udata: PtrMut[Unit]   # user data (task_id as pointer)
end

struct Timespec
  tv_sec: Int
  tv_nsec: Int
end

# Event interest flags
enum Interest
  Readable
  Writable
  Both
end

# Platform-independent I/O reactor
struct IoReactor
  # Platform-specific fd
  poll_fd: Int
  # Registered I/O sources: fd -> (task_id, interest)
  registrations: Map[Int, (UInt, Interest)]
end

def io_reactor_new() -> Result[IoReactor, String]
  if USE_KQUEUE then
    let kq = kqueue()
    if kq < 0 then
      return Result::Err("Failed to create kqueue".to_string())
    end
    Result::Ok(IoReactor { poll_fd: kq, registrations: Map::new() })
  elsif USE_EPOLL then
    let epfd = epoll_create1(0)
    if epfd < 0 then
      return Result::Err("Failed to create epoll".to_string())
    end
    Result::Ok(IoReactor { poll_fd: epfd, registrations: Map::new() })
  else
    Result::Err("No I/O multiplexing available on this platform".to_string())
  end
end

impl IoReactor
  def register(inout self, fd: Int, task_id: UInt, interest: Interest) -> Result[Unit, String]
    if USE_KQUEUE then
      let filter = match interest
      when Interest::Readable then evfilt_read()
      when Interest::Writable then evfilt_write()
      when Interest::Both then evfilt_read()  # For kqueue, add both separately
      end
      
      mut ev = Kevent {
        ident: fd as UInt,
        filter: filter,
        flags: EV_ADD | EV_ENABLE,
        fflags: 0,
        data: 0,
        udata: task_id as PtrMut[Unit]
      }
      
      if kevent(self.poll_fd, &ev as Ptr[Kevent], 1, null_mut() as PtrMut[Kevent], 0, null() as Ptr[Timespec]) < 0 then
        return Result::Err("Failed to register fd with kqueue".to_string())
      end
      
      # For Both interest, register write as well
      match interest
      when Interest::Both then
        ev.filter = evfilt_write()
        if kevent(self.poll_fd, &ev as Ptr[Kevent], 1, null_mut() as PtrMut[Kevent], 0, null() as Ptr[Timespec]) < 0 then
          return Result::Err("Failed to register write with kqueue".to_string())
        end
      when _ then ()
      end
    elsif USE_EPOLL then
      let events = match interest
      when Interest::Readable then EPOLLIN
      when Interest::Writable then EPOLLOUT
      when Interest::Both then EPOLLIN | EPOLLOUT
      end
      
      mut ev = EpollEvent {
        events: events,
        data: task_id as u64
      }
      
      if epoll_ctl(self.poll_fd, EPOLL_CTL_ADD, fd, &mut ev as Ptr[EpollEvent]) < 0 then
        return Result::Err("Failed to register fd with epoll".to_string())
      end
    end
    
    self.registrations.insert(fd, (task_id, interest))
    Result::Ok(())
  end
  
  def deregister(inout self, fd: Int) -> Result[Unit, String]
    if USE_KQUEUE then
      mut ev = Kevent {
        ident: fd as UInt,
        filter: evfilt_read(),
        flags: EV_DELETE,
        fflags: 0,
        data: 0,
        udata: null_mut()
      }
      kevent(self.poll_fd, &ev as Ptr[Kevent], 1, null_mut() as PtrMut[Kevent], 0, null() as Ptr[Timespec])
      ev.filter = evfilt_write()
      kevent(self.poll_fd, &ev as Ptr[Kevent], 1, null_mut() as PtrMut[Kevent], 0, null() as Ptr[Timespec])
    elsif USE_EPOLL then
      epoll_ctl(self.poll_fd, EPOLL_CTL_DEL, fd, null_mut() as Ptr[EpollEvent])
    end
    
    self.registrations.remove(&fd)
    Result::Ok(())
  end
  
  def poll(inout self, timeout_ms: Int) -> Vec[UInt]
    mut ready_tasks = Vec::new()
    
    if USE_KQUEUE then
      mut events: [Kevent; 64] = unsafe "zero-initialize kqueue events buffer before kernel fill" do
        zeroed()
      end
      mut ts = Timespec {
        tv_sec: timeout_ms / 1000,
        tv_nsec: (timeout_ms % 1000) * 1_000_000
      }
      
      let n = kevent(self.poll_fd, null() as Ptr[Kevent], 0, events.as_mut_ptr(), 64, &ts as Ptr[Timespec])
      let mut i = 0
      while i < n do
        let task_id = events[i].udata as UInt
        if !ready_tasks.contains(&task_id) then
          ready_tasks.push(task_id)
        end
        i = i + 1
      end
    elsif USE_EPOLL then
      mut events: [EpollEvent; 64] = unsafe "zero-initialize epoll events buffer before kernel fill" do
        zeroed()
      end
      
      let n = epoll_wait(self.poll_fd, events.as_mut_ptr(), 64, timeout_ms)
      let mut i = 0
      while i < n do
        let task_id = events[i].data as UInt
        if !ready_tasks.contains(&task_id) then
          ready_tasks.push(task_id)
        end
        i = i + 1
      end
    end
    
    ready_tasks
  end
  
  def close(inout self) -> Unit
    if self.poll_fd >= 0 then
      close(self.poll_fd)
      self.poll_fd = -1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Poll and Future
# ———————————————————————————————————————————————————————————————

enum Poll[T]
  Ready(T)
  Pending
end

trait Future
  type Output
  def poll(inout self, inout cx: Context) -> Poll[Self::Output]
end

struct Context
  waker: Waker
end

struct Waker
  task_id: UInt
  executor: PtrMut[Executor]
end

impl Waker
  def wake(self) -> Unit
    # Mark the task as ready in the executor
    guard !self.executor.is_null() else return end
    unsafe "dereference executor pointer — lifetime guaranteed by Executor::run" do
      let exec = self.executor.as_mut()
      exec.wake_task(self.task_id)
    end
  end
  
  def clone(self) -> Waker
    Waker {
      task_id: self.task_id,
      executor: self.executor
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Task
# ———————————————————————————————————————————————————————————————

enum TaskState
  Ready          # Queued for polling
  Waiting        # Blocked, waiting for wake
  Completed      # Finished
  Cancelled      # Cancelled before completion
end

struct Task
  id: UInt
  state: TaskState
  future: Box[dyn Future[Output = ()]]
  name: Option[String]
end

struct JoinHandle[T]
  task_id: UInt
  result: Option[T]
  executor: PtrMut[Executor]
end

impl JoinHandle[T]
  def is_finished(self) -> Bool
    unsafe "pointer dereference — lifetime guaranteed by enclosing scope" do
      let exec = self.executor.as_ref()
      match exec.task_states.get(&self.task_id)
      when Option::Some(TaskState::Completed) then true
      when _ then false
      end
    end
  end
end

# JoinHandle itself is a future
impl Future for JoinHandle[T]
  type Output = Result[T, String]
  
  def poll(inout self, inout cx: Context) -> Poll[Result[T, String]]
    unsafe "pointer dereference — lifetime guaranteed by enclosing scope" do
      let exec = self.executor.as_mut()
      match exec.task_results.remove(&self.task_id)
      when Option::Some(result) then
        Poll::Ready(Result::Ok(result))
      when Option::None then
        # Register interest
        exec.join_waiters.insert(self.task_id, cx.waker.clone())
        Poll::Pending
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Executor
# ———————————————————————————————————————————————————————————————

struct Executor
  tasks: Map[UInt, Task]
  ready_queue: VecDeque[UInt]
  next_task_id: UInt
  task_states: Map[UInt, TaskState]
  task_results: Map[UInt, Box[Any]]
  join_waiters: Map[UInt, Waker]     # task_id -> waker of JoinHandle
  timer_heap: Vec[TimerEntry]
  # I/O reactor for async I/O
  io_reactor: Option[IoReactor]
  running: Bool
  # Deterministic mode support
  deterministic: Bool
  seed: u64
  virtual_time: Instant
  rand_state: u64
end

struct TimerEntry
  deadline: Instant
  task_id: UInt
end

def timer_heap_push(inout heap: Vec[TimerEntry], entry: TimerEntry) -> Unit
  heap.push(entry)
  mut idx = heap.len() - 1
  while idx > 0 do
    let parent = (idx - 1) / 2
    if heap[parent].deadline <= heap[idx].deadline then
      break
    end
    let tmp = heap[parent]
    heap[parent] = heap[idx]
    heap[idx] = tmp
    idx = parent
  end
end

def timer_heap_pop_min(inout heap: Vec[TimerEntry]) -> Option[TimerEntry]
  if heap.is_empty() then
    return Option::None
  end

  let min_entry = heap[0]
  if heap.len() == 1 then
    let _ = heap.pop()
    return Option::Some(min_entry)
  end

  let last = heap.pop().unwrap()
  heap[0] = last

  mut idx: UInt = 0
  loop
    let left = idx * 2 + 1
    let right = idx * 2 + 2
    mut smallest = idx

    if left < heap.len() && heap[left].deadline < heap[smallest].deadline then
      smallest = left
    end
    if right < heap.len() && heap[right].deadline < heap[smallest].deadline then
      smallest = right
    end

    if smallest == idx then
      break
    end

    let tmp = heap[idx]
    heap[idx] = heap[smallest]
    heap[smallest] = tmp
    idx = smallest
  end

  Option::Some(min_entry)
end

def timer_heap_peek_deadline(heap: Vec[TimerEntry]) -> Option[Instant]
  if heap.is_empty() then
    Option::None
  else
    Option::Some(heap[0].deadline)
  end
end

def executor_new() -> Executor
  # Try to create I/O reactor (may fail on unsupported platforms)
  let reactor = match io_reactor_new()
  when Result::Ok(r) then Option::Some(r)
  when Result::Err(_) then Option::None
  end
  
  Executor {
    tasks: Map::new(),
    ready_queue: VecDeque::new(),
    next_task_id: 1,
    task_states: Map::new(),
    task_results: Map::new(),
    join_waiters: Map::new(),
    timer_heap: Vec::new(),
    io_reactor: reactor,
    running: false
  }
end

impl Executor
  def spawn(inout self, future: impl Future[Output = ()]) -> JoinHandle[()]
    let id = self.next_task_id
    self.next_task_id = self.next_task_id + 1
    
    let task = Task {
      id: id,
      state: TaskState::Ready,
      future: Box::new(future),
      name: Option::None
    }
    
    self.tasks.insert(id, task)
    self.task_states.insert(id, TaskState::Ready)
    self.ready_queue.push_back(id)
    
    JoinHandle {
      task_id: id,
      result: Option::None,
      executor: self as PtrMut[Executor]
    }
  end
  
  def spawn_named(inout self, name: String, future: impl Future[Output = ()]) -> JoinHandle[()]
    let id = self.next_task_id
    self.next_task_id = self.next_task_id + 1
    
    let task = Task {
      id: id,
      state: TaskState::Ready,
      future: Box::new(future),
      name: Option::Some(name),
    }
    
    self.tasks.insert(id, task)
    self.task_states.insert(id, TaskState::Ready)
    self.ready_queue.push_back(id)
    
    JoinHandle {
      task_id: id,
      result: Option::None,
      executor: self as PtrMut[Executor]
    }
  end
  
  def wake_task(inout self, task_id: UInt) -> Unit
    match self.task_states.get(&task_id)
    when Option::Some(TaskState::Waiting) then
      self.task_states.insert(task_id, TaskState::Ready)
      self.ready_queue.push_back(task_id)
    when _ then ()
    end
  end

  # Register a file descriptor for async I/O
  def register_io(inout self, fd: Int, task_id: UInt, interest: Interest) -> Result[Unit, String]
    match self.io_reactor
    when Option::Some(mut reactor) then
      reactor.register(fd, task_id, interest)
    when Option::None then
      Result::Err("No I/O reactor available".to_string())
    end
  end
  
  # Deregister a file descriptor
  def deregister_io(inout self, fd: Int) -> Unit
    match self.io_reactor
    when Option::Some(mut reactor) then
      reactor.deregister(fd)
    when Option::None then ()
    end
  end
  
  def run(inout self) -> Unit
    self.running = true

    while self.running do
      # Check timers
      if self.deterministic then
        self.check_timers_deterministic()
      else
        self.check_timers()
      end

      # Poll I/O reactor for ready file descriptors
      if !self.deterministic then
        match self.io_reactor
        when Option::Some(mut reactor) then
          # Poll with 0 timeout for non-blocking check
          let io_ready = reactor.poll(0)
          for task_id in io_ready do
            if !self.ready_queue.contains(&task_id) then
              self.ready_queue.push_back(task_id)
            end
          end
        when Option::None then ()
        end
      end

      # Poll ready tasks
      match self.ready_queue.pop_front()
      when Option::Some(task_id) then
        self.poll_task(task_id)
      when Option::None then
        # No ready tasks — check if all done
        if self.tasks.is_empty() then
          self.running = false
          break
        end

        # Advance virtual time or block on I/O/timers
        if self.deterministic then
          if !self.timer_heap.is_empty() then
            # Advance to next timer
            let min_entry = self.timer_heap[0]
            self.virtual_time = min_entry.deadline
            self.check_timers_deterministic()
          else
            # No ready tasks and no timers in deterministic mode == deadlock or finished
            self.running = false
          end
        else
          # Block on I/O and timers
          let timeout_ms = match self.next_timer_deadline()
          when Option::Some(deadline) then
            let now = instant_now()
            let remaining = deadline.duration_since(now)
            duration_millis(remaining).max(0).min(100)
          when Option::None then 100  # Default 100ms timeout
          end

          match self.io_reactor
          when Option::Some(mut reactor) then
            # Block on I/O with timeout
            let io_ready = reactor.poll(timeout_ms as Int)
            for task_id in io_ready do
              self.ready_queue.push_back(task_id)
            end
          when Option::None then
            # No I/O reactor — just sleep
            if timeout_ms > 0 then
              sleep_ms(timeout_ms)
            else
              sleep_ms(1)
            end
          end
        end
      end
    end
  end

  def check_timers_deterministic(inout self) -> Unit
    # Process all expired timers from min-heap root based on virtual time
    loop do
      match timer_heap_peek_deadline(&self.timer_heap)
      when Option::Some(deadline) then
        if deadline <= self.virtual_time then
          let entry = timer_heap_pop_min(&mut self.timer_heap).unwrap()
          self.ready_queue.push_back(entry.task_id)
        else
          break
        end
      when Option::None then break
      end
    end
  end
  
  def poll_task(inout self, task_id: UInt) -> Unit
    match self.tasks.get_mut(&task_id)
    when Option::None then return
    when Option::Some(task) then
      let waker = Waker {
        task_id: task_id,
        executor: self as PtrMut[Executor]
      }

      mut cx = Context { waker: waker }

      # CAP-44: Integrate with diagnostics for task polling
      _log_async_event(LogLevel::Trace, "Polling task " + task_id.to_string())

      match task.future.poll(&mut cx)
      when Poll::Ready(()) then
        # Task completed
        self.tasks.remove(&task_id)
        self.task_states.insert(task_id, TaskState::Completed)

        # Wake any JoinHandle waiters
        match self.join_waiters.remove(&task_id)
        when Option::Some(waiter) then waiter.wake()
        when Option::None then ()
        end
      when Poll::Pending then
        self.task_states.insert(task_id, TaskState::Waiting)
        
        # Integration with ctxpacks: capture context if task is stuck or interesting
        let mut seeds = Vec::new()
        seeds.push("async::task_pending".to_string())
        seeds.push("task_id::" + task_id.to_string())
        match std::ctx::build_pack(seeds, 1000)
        when Ok(pack) then std::ctx::register_pack(pack)
        when Err(_) then {}
        end
      end
    end
  end
  
  def check_timers(inout self) -> Unit
    let now = instant_now()

    # Process all expired timers from min-heap root
    loop
      match timer_heap_peek_deadline(&self.timer_heap)
      when Option::Some(deadline) then
        if deadline <= now then
          match timer_heap_pop_min(&mut self.timer_heap)
          when Option::Some(entry) then self.wake_task(entry.task_id)
          when Option::None then break
          end
        else
          break
        end
      when Option::None then break
      end
    end
  end
  
  def next_timer_deadline(self) -> Option[Instant]
    timer_heap_peek_deadline(&self.timer_heap)
  end

  def set_deterministic(inout self, seed: u64) -> Unit
    self.deterministic = true
    self.seed = seed
    self.rand_state = seed
    self.virtual_time = Instant::now() # Base time for virtual clock
  end

  def rand_u64(inout self) -> u64
    # PCG-style simple PRNG for deterministic task ordering
    let mut x = self.rand_state
    let count = (x >> 59) as UInt
    x ^= x >> 18
    let rot = ((x >> 27) as u32).rotate_right(count as u32)
    self.rand_state = self.rand_state * 6364136223846793005u64 + 1442695040888963407u64
    rot as u64
  end
  
  def register_timer(inout self, deadline: Instant, task_id: UInt) -> Unit
    timer_heap_push(&mut self.timer_heap, TimerEntry {
      deadline: deadline,
      task_id: task_id
    })
  end
  
  def cancel_task(inout self, task_id: UInt) -> Bool
    match self.tasks.remove(&task_id)
    when Option::Some(_) then
      self.task_states.insert(task_id, TaskState::Cancelled)
      true
    when Option::None then false
    end
  end
  
  def task_count(self) -> UInt
    self.tasks.len()
  end
end

# ———————————————————————————————————————————————————————————————
# Async Sleep / Timer Future
# ———————————————————————————————————————————————————————————————

struct SleepFuture
  deadline: Instant
  registered: Bool
end

impl Future for SleepFuture
  type Output = ()
  
  def poll(inout self, inout cx: Context) -> Poll[()]
    let now = instant_now()
    if now >= self.deadline then
      Poll::Ready(())
    else
      if !self.registered then
        # Register timer with executor
        unsafe "pointer dereference — lifetime guaranteed by enclosing scope" do
          let exec = cx.waker.executor.as_mut()
          exec.register_timer(self.deadline, cx.waker.task_id)
        end
        self.registered = true
      end
      Poll::Pending
    end
  end
end

pub def sleep(duration: Duration) -> SleepFuture
  SleepFuture {
    deadline: instant_now().add(duration),
    registered: false
  end
end

pub def sleep_millis(ms: UInt) -> SleepFuture
  sleep(Duration::from_millis(ms))
end

# ———————————————————————————————————————————————————————————————
# Timeout
# ———————————————————————————————————————————————————————————————

struct TimeoutFuture[F: Future]
  inner: F
  deadline: Instant
  timer_registered: Bool
end

enum TimeoutError
  TimedOut
end

impl Future for TimeoutFuture[F]
  type Output = Result[F::Output, TimeoutError]
  
  def poll(inout self, inout cx: Context) -> Poll[Result[F::Output, TimeoutError]]
    # Check the inner future first
    match self.inner.poll(cx)
    when Poll::Ready(val) then
        let ready_result: Result[F::Output, TimeoutError] = Result::Ok(val)
        return Poll::Ready(ready_result)
    when Poll::Pending then ()
    end
    
    # Check timeout
    let now = instant_now()
    if now >= self.deadline then
        let timeout_result: Result[F::Output, TimeoutError] = Result::Err(TimeoutError::TimedOut)
        Poll::Ready(timeout_result)
    else
      if !self.timer_registered then
        unsafe "pointer dereference — lifetime guaranteed by enclosing scope" do
          let exec = cx.waker.executor.as_mut()
          exec.register_timer(self.deadline, cx.waker.task_id)
        end
        self.timer_registered = true
      end
      Poll::Pending
    end
  end
end

pub def timeout[F: Future](duration: Duration, future: F) -> TimeoutFuture[F]
  TimeoutFuture {
    inner: future,
    deadline: instant_now().add(duration),
    timer_registered: false
  end
end

# ———————————————————————————————————————————————————————————————
# Yield
# ———————————————————————————————————————————————————————————————

struct YieldNow
  yielded: Bool
end

impl Future for YieldNow
  type Output = ()
  
  def poll(inout self, inout cx: Context) -> Poll[()]
    if self.yielded then
      Poll::Ready(())
    else
      self.yielded = true
      # Re-queue ourselves
      cx.waker.wake()
      Poll::Pending
    end
  end
end

pub def yield_now() -> YieldNow
  YieldNow { yielded: false }
end

# ———————————————————————————————————————————————————————————————
# Async Channel (MPSC)
# ———————————————————————————————————————————————————————————————

struct ChannelInner[T]
  buffer: VecDeque[T]
  capacity: UInt
  closed: AtomicBool
  send_waiters: Vec[Waker]
  recv_waiters: Vec[Waker]
end

# The channel's shared state lives in a heap allocation owned by an Arc
# (std::sync's refcounted allocation — the same pattern the sync channel
# uses). Sender, Receiver, and the SendFuture/RecvFuture the send/recv
# methods produce each hold their OWN Arc clone: the inner stays alive
# even if an endpoint is dropped or moved while a future is in flight.
# The refcount is the Arc's (the atomic in the control block); the old
# hand-rolled ref_count field and the Box::into_raw/Box::from_raw pair
# are gone — the raw pointer is never exposed in the safe surface.
struct Sender[T]
  inner: Arc[ChannelInner[T]]
end

struct Receiver[T]
  inner: Arc[ChannelInner[T]]
end

pub def channel[T](capacity: UInt) -> (Sender[T], Receiver[T])
  let inner = Arc::new(ChannelInner[T] {
    buffer: VecDeque[T]::new(),
    capacity: capacity,
    closed: AtomicBool::new(false),
    send_waiters: Vec[Waker]::new(),
    recv_waiters: Vec[Waker]::new()
  })

  (Sender[T] { inner: inner.clone() }, Receiver[T] { inner: inner })
end

impl Sender[T]
  def send(self, value: T) -> SendFuture[T]
    SendFuture[T] {
      inner: self.inner.clone(),
      value: Option::Some(value)
    }
  end

  def close(self) -> Unit
    if self.inner.ptr.as_ref().closed.load() then
      return
    end
    self.inner.ptr.as_ref().closed.store(true)
    loop do
      match self.inner.ptr.as_ref().recv_waiters.pop()
      when Option::Some(waker) then waker.wake()
      when Option::None then break
      end
    end
  end

  def clone(self) -> Sender[T]
    Sender[T] { inner: self.inner.clone() }
  end
end

impl Receiver[T]
  def recv(self) -> RecvFuture[T]
    RecvFuture[T] { inner: self.inner.clone() }
  end

  def try_recv(self) -> Option[T]
    let ch = self.inner.ptr.as_ref()
    match ch.buffer.pop_front()
    when Option::Some(val) then
      # Wake a sender — the buffer just made room
      if !ch.send_waiters.is_empty() then
        ch.send_waiters.pop().unwrap().wake()
      end
      Option::Some(val)
    when Option::None then
      Option::None
    end
  end

  def is_closed(self) -> Bool
    self.inner.ptr.as_ref().closed.load()
  end
end

struct SendFuture[T]
  inner: Arc[ChannelInner[T]]
  value: Option[T]
end

impl Future for SendFuture[T]
  type Output = Result[(), String]

  def poll(inout self, inout cx: Context) -> Poll[Result[(), String]]
    let ch = self.inner.ptr.as_ref()

    if ch.closed.load() then
      let closed_result: Result[(), String] = Result::Err("channel closed".to_string())
      return Poll::Ready(closed_result)
    end

    if ch.buffer.len() < ch.capacity then
      # Space available
      match self.value.take()
      when Option::Some(val) then
        ch.buffer.push_back(val)
        # Wake a receiver
        if !ch.recv_waiters.is_empty() then
          ch.recv_waiters.pop().unwrap().wake()
        end
        let sent_result: Result[(), String] = Result::Ok(())
        Poll::Ready(sent_result)
      when Option::None then
        let missing_result: Result[(), String] = Result::Err("value already sent".to_string())
        Poll::Ready(missing_result)
      end
    else
      # Buffer full, wait
      ch.send_waiters.push(cx.waker.clone())
      Poll::Pending
    end
  end
end

struct RecvFuture[T]
  inner: Arc[ChannelInner[T]]
end

impl Future for RecvFuture[T]
  type Output = Option[T]

  def poll(inout self, inout cx: Context) -> Poll[Option[T]]
    let ch = self.inner.ptr.as_ref()

    match ch.buffer.pop_front()
    when Option::Some(val) then
      # Wake a sender
      if !ch.send_waiters.is_empty() then
        ch.send_waiters.pop().unwrap().wake()
      end
      Poll::Ready(Option::Some(val))
    when Option::None then
      if ch.closed.load() then
        Poll::Ready(Option::None)
      else
        ch.recv_waiters.push(cx.waker.clone())
        Poll::Pending
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Select (race multiple futures)
# ———————————————————————————————————————————————————————————————

enum Either[A, B]
  Left(A)
  Right(B)
end

struct SelectFuture[A: Future, B: Future]
  a: A
  b: B
  a_done: Bool
  b_done: Bool
end

impl Future for SelectFuture[A, B]
  type Output = Either[A::Output, B::Output]
  
  def poll(inout self, inout cx: Context) -> Poll[Either[A::Output, B::Output]]
    if !self.a_done then
      match self.a.poll(cx)
      when Poll::Ready(val) then
        self.a_done = true
        let ready: Either[A::Output, B::Output] = Either::Left(val)
        return Poll::Ready(ready)
      when Poll::Pending then ()
      end
    end
    
    if !self.b_done then
      match self.b.poll(cx)
      when Poll::Ready(val) then
        self.b_done = true
        let ready: Either[A::Output, B::Output] = Either::Right(val)
        return Poll::Ready(ready)
      when Poll::Pending then ()
      end
    end
    
    Poll::Pending
  end
end

pub def select[A: Future, B: Future](a: A, b: B) -> SelectFuture[A, B]
  SelectFuture { a: a, b: b, a_done: false, b_done: false }
end

# ———————————————————————————————————————————————————————————————
# Join (run two futures concurrently, wait for both)
# ———————————————————————————————————————————————————————————————

struct JoinFuture[A: Future, B: Future]
  a: A
  b: B
  a_result: Option[A::Output]
  b_result: Option[B::Output]
end

impl Future for JoinFuture[A, B]
  type Output = (A::Output, B::Output)
  
  def poll(inout self, inout cx: Context) -> Poll[(A::Output, B::Output)]
    if self.a_result.is_none() then
      match self.a.poll(cx)
      when Poll::Ready(val) then self.a_result = Option::Some(val)
      when Poll::Pending then ()
      end
    end
    
    if self.b_result.is_none() then
      match self.b.poll(cx)
      when Poll::Ready(val) then self.b_result = Option::Some(val)
      when Poll::Pending then ()
      end
    end
    
    if self.a_result.is_some() && self.b_result.is_some() then
      Poll::Ready((self.a_result.take().unwrap(), self.b_result.take().unwrap()))
    else
      Poll::Pending
    end
  end
end

pub def join[A: Future, B: Future](a: A, b: B) -> JoinFuture[A, B]
  JoinFuture {
    a: a, b: b,
    a_result: Option::None,
    b_result: Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# std::io Integration (reactor-backed readiness + I/O futures)
# ———————————————————————————————————————————————————————————————

trait ReactorFd
  def reactor_fd(self: Self) -> Int
end

impl ReactorFd for TcpStream
  def reactor_fd(self: Self) -> Int
    self.raw_fd()
  end
end

struct WaitReadableFuture[T: ReactorFd]
  io: PtrMut[T]
  registered: Bool
end

impl Future for WaitReadableFuture[T]
  type Output = Result[Unit, String]

  def poll(inout self, inout cx: Context) -> Poll[Result[Unit, String]]
    unsafe "pointer dereference — lifetime guaranteed by enclosing scope" do
      let exec = cx.waker.executor.as_mut()
      let fd = (*self.io).reactor_fd()

      if !self.registered then
        match exec.register_io(fd, cx.waker.task_id, Interest::Readable)
        when Result::Ok(()) then
          self.registered = true
          Poll::Pending
        when Result::Err(err) then
          let read_error: Result[Unit, String] = Result::Err(err)
          Poll::Ready(read_error)
        end
      else
        exec.deregister_io(fd)
        let read_ready: Result[Unit, String] = Result::Ok(())
        Poll::Ready(read_ready)
      end
    end
  end
end

struct WaitWritableFuture[T: ReactorFd]
  io: PtrMut[T]
  registered: Bool
end

impl Future for WaitWritableFuture[T]
  type Output = Result[Unit, String]

  def poll(inout self, inout cx: Context) -> Poll[Result[Unit, String]]
    unsafe "pointer dereference — lifetime guaranteed by enclosing scope" do
      let exec = cx.waker.executor.as_mut()
      let fd = (*self.io).reactor_fd()

      if !self.registered then
        match exec.register_io(fd, cx.waker.task_id, Interest::Writable)
        when Result::Ok(()) then
          self.registered = true
          Poll::Pending
        when Result::Err(err) then
          let write_error: Result[Unit, String] = Result::Err(err)
          Poll::Ready(write_error)
        end
      else
        exec.deregister_io(fd)
        let write_ready: Result[Unit, String] = Result::Ok(())
        Poll::Ready(write_ready)
      end
    end
  end
end

pub def wait_readable[T: ReactorFd](inout io: T) -> WaitReadableFuture[T]
  WaitReadableFuture {
    io: io as PtrMut[T],
    registered: false
  }
end

pub def wait_writable[T: ReactorFd](inout io: T) -> WaitWritableFuture[T]
  WaitWritableFuture {
    io: io as PtrMut[T],
    registered: false
  }
end

struct AsyncReadFuture[T: Read + ReactorFd]
  io: PtrMut[T]
  buf: PtrMut[Vec[u8]]
  wait: WaitReadableFuture[T]
end

impl Future for AsyncReadFuture[T]
  type Output = Result[Int, IOError]

  def poll(inout self, inout cx: Context) -> Poll[Result[Int, IOError]]
    match self.wait.poll(cx)
    when Poll::Pending then Poll::Pending
    when Poll::Ready(Result::Err(err)) then
      Poll::Ready(Result::Err(IOError::Other(err)))
    when Poll::Ready(Result::Ok(())) then
      unsafe "pointer dereference — lifetime guaranteed by enclosing scope" do
        let io = self.io.as_mut()
        let buf = self.buf.as_mut()
        Poll::Ready(io.read(buf))
      end
    end
  end
end

struct AsyncWriteFuture[T: Write + ReactorFd]
  io: PtrMut[T]
  buf: Ptr[Vec[u8]]
  wait: WaitWritableFuture[T]
end

impl Future for AsyncWriteFuture[T]
  type Output = Result[Int, IOError]

  def poll(inout self, inout cx: Context) -> Poll[Result[Int, IOError]]
    match self.wait.poll(cx)
    when Poll::Pending then Poll::Pending
    when Poll::Ready(Result::Err(err)) then
      Poll::Ready(Result::Err(IOError::Other(err)))
    when Poll::Ready(Result::Ok(())) then
      unsafe "pointer dereference — lifetime guaranteed by enclosing scope" do
        let io = self.io.as_mut()
        let buf = self.buf.as_ref()
        Poll::Ready(io.write(buf))
      end
    end
  end
end

pub def read_async[T: Read + ReactorFd](inout io: T, inout buf: Vec[u8]) -> AsyncReadFuture[T]
  AsyncReadFuture {
    io: io as PtrMut[T],
    buf: buf as PtrMut[Vec[u8]],
    wait: wait_readable(io)
  }
end

pub def write_async[T: Write + ReactorFd](inout io: T, buf: Vec[u8]) -> AsyncWriteFuture[T]
  AsyncWriteFuture {
    io: io as PtrMut[T],
    buf: buf as Ptr[Vec[u8]],
    wait: wait_writable(io)
  }
end

# ———————————————————————————————————————————————————————————————
# Public Entrypoints
# ———————————————————————————————————————————————————————————————

# Global executor (thread-local in multi-threaded contexts)
@thread_local
static mut GLOBAL_EXECUTOR: Option[PtrMut[Executor]] = Option::None

pub def block_on[F: Future](future: F) -> F::Output
  mut exec = executor_new()

  GLOBAL_EXECUTOR = Option::Some(address_of_mut(&mut exec) as PtrMut[Executor])

  mut result: Option[F::Output] = Option::None
  let result_ptr = address_of_mut(&mut result) as PtrMut[Option[F::Output]]

  exec.spawn(async {
    let val = future.await
    unsafe "pointer dereference — lifetime guaranteed by enclosing scope" do
      *result_ptr = Option::Some(val)
    end
  })

  exec.run()

  GLOBAL_EXECUTOR = Option::None

  match result
  when Option::Some(val) then val
  when Option::None then panic("block_on: future did not complete")
  end
end

pub def spawn(future: impl Future[Output = ()]) -> JoinHandle[()]
  match GLOBAL_EXECUTOR
  when Option::Some(exec_ptr) then
    unsafe "global executor pointer dereference" do
      let exec = exec_ptr.as_mut()
      exec.spawn(future)
    end
  when Option::None then
    panic("spawn called outside of async runtime — use block_on() first")
  end
end

# ———————————————————————————————————————————————————————————————
# Platform Sleep (FFI)
# ———————————————————————————————————————————————————————————————

extern "C"
  def usleep(usec: UInt) -> i32
end

def sleep_ms(ms: UInt) -> Unit
  if ms > 0 then
    let _ = usleep(ms * 1000)
  end
end

# ———————————————————————————————————————————————————————————————
# Async Mutex (for shared state in async code)
# ———————————————————————————————————————————————————————————————
# The lock state lives in a heap allocation owned by an Arc (the real
# allocator, std::sync). AsyncMutex::lock clones the Arc into the
# LockFuture, and the future clones it again into the guard on
# acquisition — the lock state stays alive even if the AsyncMutex is
# dropped or moved while the future or the guard lives. Acquisition is an
# atomic swap on the inner's AtomicBool; a contended poll re-queues itself
# through the waker (the self-wake re-poll YieldNow uses) and re-tries the
# swap on the next poll — the executor re-polls the task until the lock
# frees. The guard's Drop releases the lock with an atomic store and the
# deinit plan drops the guard's Arc clone (the last clone releases the
# allocation).
struct AsyncMutex[T]
  inner: Arc[AsyncMutexInner[T]]
end

struct AsyncMutexInner[T]
  locked: AtomicBool
  value: T
end

pub def async_mutex_new[T](value: T) -> AsyncMutex[T]
  AsyncMutex {
    inner: Arc::new(AsyncMutexInner {
      locked: AtomicBool::new(false),
      value: value
    })
  }
end

# Guard returned by the LockFuture that releases the lock on drop.
# The guard holds its own Arc clone of the inner state.
struct AsyncMutexGuard[T]
  inner: Arc[AsyncMutexInner[T]]
end

# The future holds an Arc clone of the inner — the mutex can drop while
# the future (or the guard it produces) lives.
struct LockFuture[T]
  inner: Arc[AsyncMutexInner[T]]
end

impl Future for LockFuture[T]
  type Output = AsyncMutexGuard[T]
  
  def poll(inout self, inout cx: Context) -> Poll[AsyncMutexGuard[T]]
    if self.inner.ptr.as_ref().locked.swap(true) then
      # Lock is held — re-queue ourselves through the waker: the executor
      # re-polls us and the poll re-tries the swap until the lock frees.
      cx.waker.wake()
      Poll::Pending
    else
      Poll::Ready(AsyncMutexGuard { inner: self.inner.clone() })
    end
  end
end

impl AsyncMutex[T]
  def lock(self) -> LockFuture[T]
    LockFuture { inner: self.inner.clone() }
  end
end

impl AsyncMutexGuard[T]
  def get(self) -> Ptr[T]
    # The value access goes through the Arc the guard keeps alive — the
    # inner's value lives in the Arc's allocation.
    address_of(&mut self.inner.ptr.as_ref().value) as Ptr[T]
  end
  
  def get_mut(inout self) -> PtrMut[T]
    # The unconditional PtrMut through the Arc is intentional HERE: the
    # guard holds the lock (no other task can touch the inner
    # concurrently) — uniqueness comes from the LOCK PROTOCOL, not the
    # refcount (the guard's Arc clone is never unique: the mutex itself
    # holds a second clone, so Arc::get_mut would always be None). This
    # raw path is the explicitly-unsafe primitive the Arc surface no
    # longer exposes unconditionally.
    unsafe "lock-exclusive raw access — the guard holds the lock" do
      address_of_mut(&mut (*self.inner.ptr).value)
    end
  end
  
  def deref(self) -> Ptr[T]
    self.get()
  end
  
  def deref_mut(inout self) -> PtrMut[T]
    self.get_mut()
  end
end

impl Drop for AsyncMutexGuard[T]
  def drop(inout self) -> Unit
    # Release the lock (the atomic store). The guard's Arc clone is then
    # dropped by the deinit plan — the inner allocation stays alive as
    # long as ANY Arc clone (the mutex's, a future's, or a guard's) still
    # references it.
    self.inner.ptr.as_ref().locked.store(false)
  end
end

# ———————————————————————————————————————————————————————————————
# Structured Concurrency — Task Scopes (Nurseries)
# ———————————————————————————————————————————————————————————————

## A TaskScope ensures all spawned child tasks complete (or are cancelled)
## before the scope exits. Inspired by Trio nurseries / JEP 453.
struct TaskScope
  tasks: Vec[Task]
  cancellation: CancellationToken
  error_strategy: ScopeErrorStrategy
end

## How the scope handles a child task failure
enum ScopeErrorStrategy
  CancelAll         ## Cancel all remaining tasks on first error (default)
  CollectErrors     ## Let all tasks finish, collect all errors
  IgnoreErrors      ## Ignore child errors, scope succeeds if body succeeds
end

struct CancellationToken
  cancelled: Bool
  children: Vec[CancellationToken]
end

def cancellation_token_new() -> CancellationToken
  CancellationToken { cancelled: false, children: Vec::new() }
end

impl CancellationToken
  def cancel(inout self: CancellationToken) -> Unit
    self.cancelled = true
    for child in self.children do
      child.cancel()
    end
  end

  def is_cancelled(self: CancellationToken) -> Bool
    self.cancelled
  end

  def child(inout self: CancellationToken) -> CancellationToken
    let c = cancellation_token_new()
    self.children.push(c)
    c
  end
end

def task_scope_new() -> TaskScope
  TaskScope {
    tasks: Vec::new(),
    cancellation: cancellation_token_new(),
    error_strategy: ScopeErrorStrategy::CancelAll,
  }
end

impl TaskScope
  def with_error_strategy(sink self: TaskScope, strategy: ScopeErrorStrategy) -> TaskScope
    self.error_strategy = strategy
    self
  end

  ## Spawn a task within this scope. The task is registered with the
  ## CURRENT executor (the same registration the free spawn uses) and its
  ## id is tracked — the task must complete before the scope exits. The
  ## scoped futures are the ()-output form (the executor's task_results
  ## are the Box[Any] outputs keyed by the task id).
  def spawn(inout self: TaskScope, future: impl Future[Output = ()]) -> JoinHandle[()]
    let handle = spawn(future)
    self.tasks.push(handle.task_id)
    handle
  end

  ## Wait for all tasks in the scope to complete: the executor's run loop
  ## fills task_results as the tasks complete; the scope spins on the
  ## tracked ids until every result is present (or the cancellation fired).
  ## The error strategy's CancelAll cancels the scope when the cancellation
  ## was requested; the ()-output tasks carry no per-task error channel, so
  ## the error list reflects the cancelled tasks.
  def join_all(inout self: TaskScope) -> Result[Unit, Vec[String]]
    let mut errors = Vec::new()
    match GLOBAL_EXECUTOR
    when Option::Some(exec_ptr) then
      unsafe "global executor pointer dereference" do
        let exec = exec_ptr.as_mut()
        var done = false
        while !done do
          done = true
          for tid in self.tasks do
            if !exec.task_results.contains(&tid) then
              done = false
            end
          end
          if self.cancellation.is_cancelled() then
            done = true
          end
        end
        if self.cancellation.is_cancelled() then
          match self.error_strategy
          when ScopeErrorStrategy::CancelAll then
            for tid in self.tasks do
              exec.cancel_task(tid)
            end
          when _ then ()
          end
        end
      end
    when Option::None then
      return Result::Err("scoped spawn requires an async runtime — use block_on() first".to_string())
    end
    if errors.is_empty() then
      Result::Ok(())
    else
      Result::Err(errors)
    end
  end

  ## Cancel all tasks in this scope.
  def cancel(inout self: TaskScope) -> Unit
    self.cancellation.cancel()
  end
end

## Convenience: run a scoped block of async work.
## All tasks spawned within the closure are guaranteed to complete
## before this function returns.
async def scoped[T, F: FnOnce(inout TaskScope) -> T](body: F) -> Result[T, Vec[String]]
  let mut scope = task_scope_new()
  let result = body(&mut scope)
  scope.join_all()?
  Result::Ok(result)
end

# ———————————————————————————————————————————————————————————————
# Async Streams (AsyncIterator)
# ———————————————————————————————————————————————————————————————

trait AsyncIterator
  type Item

  ## Returns Poll::Ready(Some(item)) for next item,
  ## Poll::Ready(None) when exhausted, or Poll::Pending.
  def poll_next(inout self: Self, inout cx: Context) -> Poll[Option[Self::Item]]
end

## Adapter: collect all items from an async stream
async def collect_stream[S: AsyncIterator](inout stream: S) -> Vec[S::Item]
  let mut items = Vec::new()
  loop do
    match stream.next().await
    when Option::Some(item) then items.push(item)
    when Option::None then break
    end
  end
  items
end

## Map adapter for async streams
struct MapStream[S: AsyncIterator, F]
  inner: S
  f: F
end

impl[S: AsyncIterator, F: Fn(S::Item) -> U, U] AsyncIterator for MapStream[S, F]
  type Item = U
  def poll_next(inout self: MapStream[S, F], inout cx: Context) -> Poll[Option[U]]
    match self.inner.poll_next(cx)
    when Poll::Ready(Option::Some(item)) then Poll::Ready(Option::Some((self.f)(item)))
    when Poll::Ready(Option::None) then Poll::Ready(Option::None)
    when Poll::Pending then Poll::Pending
    end
  end
end

## Filter adapter for async streams
struct FilterStream[S: AsyncIterator, F]
  inner: S
  predicate: F
end

impl[S: AsyncIterator, F: Fn(inout S::Item) -> Bool] AsyncIterator for FilterStream[S, F]
  type Item = S::Item
  def poll_next(inout self: FilterStream[S, F], inout cx: Context) -> Poll[Option[S::Item]]
    loop do
      match self.inner.poll_next(cx)
      when Poll::Ready(Option::Some(item)) then
        if (self.predicate)(&item) then
          return Poll::Ready(Option::Some(item))
        end
      when Poll::Ready(Option::None) then return Poll::Ready(Option::None)
      when Poll::Pending then return Poll::Pending
      end
    end
  end
end

## Take adapter
struct TakeStream[S: AsyncIterator]
  inner: S
  remaining: UInt
end

impl[S: AsyncIterator] AsyncIterator for TakeStream[S]
  type Item = S::Item
  def poll_next(inout self: TakeStream[S], inout cx: Context) -> Poll[Option[S::Item]]
    if self.remaining == 0 then
      return Poll::Ready(Option::None)
    end
    match self.inner.poll_next(cx)
    when Poll::Ready(Option::Some(item)) then
      self.remaining = self.remaining - 1
      Poll::Ready(Option::Some(item))
    when other then other
    end
  end
end

## Channel-backed async stream
struct ChannelStream[T]
  receiver: Receiver[T]
end

impl[T] AsyncIterator for ChannelStream[T]
  type Item = T
  def poll_next(inout self: ChannelStream[T], inout cx: Context) -> Poll[Option[T]]
    match self.receiver.try_recv()
    when Option::Some(item) then Poll::Ready(Option::Some(item))
    when Option::None then
      if self.receiver.is_closed() then
        Poll::Ready(Option::None)
      else
        Poll::Pending
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Retry with Backoff
# ———————————————————————————————————————————————————————————————

struct RetryConfig
  max_attempts: UInt
  initial_delay_ms: UInt
  max_delay_ms: UInt
  backoff_factor: Float
  jitter: Bool
end

def retry_config_default() -> RetryConfig
  RetryConfig {
    max_attempts: 3,
    initial_delay_ms: 100,
    max_delay_ms: 30000,
    backoff_factor: 2.0,
    jitter: true,
  }
end

## Retry an async operation with exponential backoff.
async def retry[T, E, F: FnMut() -> impl Future[Output = Result[T, E]]](
  config: RetryConfig,
  inout operation: F
) -> Result[T, E]
  let mut delay_ms = config.initial_delay_ms
  let mut last_err: Option[E] = Option::None

  for attempt in 0..config.max_attempts do
    match operation().await
    when Result::Ok(val) then return Result::Ok(val)
    when Result::Err(e) then
      last_err = Option::Some(e)
      if attempt + 1 < config.max_attempts then
        sleep(Duration::from_millis(delay_ms as u64)).await
        delay_ms = min_uint(
          (delay_ms as Float * config.backoff_factor) as UInt,
          config.max_delay_ms
        )
      end
    end
  end

  Result::Err(last_err.unwrap())
end

def min_uint(a: UInt, b: UInt) -> UInt
  if a < b then a else b end
end

# ———————————————————————————————————————————————————————————————
# Circuit Breaker
# ———————————————————————————————————————————————————————————————

enum CircuitState
  Closed       ## Normal operation
  Open         ## Failing, reject calls
  HalfOpen     ## Testing if service recovered
end

struct CircuitBreaker
  state: CircuitState
  failure_count: UInt
  success_count: UInt
  failure_threshold: UInt
  success_threshold: UInt  ## Successes needed in HalfOpen to close
  timeout_ms: UInt         ## Time to wait before HalfOpen
  last_failure_time: UInt  ## Timestamp of last failure
end

def circuit_breaker_new(failure_threshold: UInt, success_threshold: UInt, timeout_ms: UInt) -> CircuitBreaker
  CircuitBreaker {
    state: CircuitState::Closed,
    failure_count: 0,
    success_count: 0,
    failure_threshold: failure_threshold,
    success_threshold: success_threshold,
    timeout_ms: timeout_ms,
    last_failure_time: 0,
  }
end

enum CircuitBreakerError[E]
  CircuitOpen
  Inner(E)
end

impl CircuitBreaker
  def allow_request(inout self: CircuitBreaker, now_ms: UInt) -> Bool
    match self.state
    when CircuitState::Closed then true
    when CircuitState::Open then
      if now_ms - self.last_failure_time >= self.timeout_ms then
        self.state = CircuitState::HalfOpen
        self.success_count = 0
        true
      else
        false
      end
    when CircuitState::HalfOpen then true
    end
  end

  def record_success(inout self: CircuitBreaker) -> Unit
    match self.state
    when CircuitState::HalfOpen then
      self.success_count = self.success_count + 1
      if self.success_count >= self.success_threshold then
        self.state = CircuitState::Closed
        self.failure_count = 0
      end
    when CircuitState::Closed then
      self.failure_count = 0  ## Reset consecutive failures
    when _ then ()
    end
  end

  def record_failure(inout self: CircuitBreaker, now_ms: UInt) -> Unit
    self.last_failure_time = now_ms
    match self.state
    when CircuitState::Closed then
      self.failure_count = self.failure_count + 1
      if self.failure_count >= self.failure_threshold then
        self.state = CircuitState::Open
      end
    when CircuitState::HalfOpen then
      self.state = CircuitState::Open
    when _ then ()
    end
  end

  def state(self: CircuitBreaker) -> CircuitState
    self.state
  end

  def reset(inout self: CircuitBreaker) -> Unit
    self.state = CircuitState::Closed
    self.failure_count = 0
    self.success_count = 0
  end
end

# ———————————————————————————————————————————————————————————————
# Async Semaphore
# ———————————————————————————————————————————————————————————————
# The semaphore state (the permit counter + the waiter queue) lives in a
# heap allocation owned by an Arc — the same heap-stable shared-state
# shape the AsyncMutex uses. AcquireFuture and SemaphorePermit each hold
# their OWN Arc clone: the semaphore can be dropped or moved while a
# future or a permit lives. Acquisition and release go through the inner's
# atomic counter (a CAS loop on acquire — the counter is the authority, so
# a contended re-poll re-tries the CAS instead of double-decrementing; an
# atomic fetch-add on release). The waiter queue is mutated only from the
# executor thread (the module's cooperative single-threaded runtime), the
# same discipline the AsyncMutex's value access relies on.
struct AsyncSemaphore
  inner: Arc[AsyncSemaphoreInner]
end

struct AsyncSemaphoreInner
  counter: AtomicInt
  max_permits: UInt
  waiters: VecDeque[Waker]
end

def async_semaphore_new(permits: UInt) -> AsyncSemaphore
  AsyncSemaphore {
    inner: Arc::new(AsyncSemaphoreInner {
      counter: AtomicInt::new(permits as Int),
      max_permits: permits,
      waiters: VecDeque::new()
    })
  }
end

def AsyncSemaphore::new(permits: UInt) -> AsyncSemaphore
  async_semaphore_new(permits)
end

struct AcquireFuture
  inner: Arc[AsyncSemaphoreInner]
end

impl Future for AcquireFuture
  type Output = SemaphorePermit
  def poll(inout self, inout cx: Context) -> Poll[SemaphorePermit]
    loop do
      let current = self.inner.ptr.as_ref().counter.load(Ordering::Acquire)
      if current > 0 then
        mut expected = current
        if self.inner.ptr.as_ref().counter.compare_exchange(&mut expected, current - 1, Ordering::AcqRel, Ordering::Acquire) then
          return Poll::Ready(SemaphorePermit { inner: self.inner.clone() })
        end
      else
        # No permit — queue this task's waker (the executor re-polls us
        # once a permit release wakes the queue; a re-poll while still
        # starved enqueues again, and the id-based wakeups make stale
        # entries no-ops in the executor).
        self.inner.ptr.as_ref().waiters.push_back(cx.waker.clone())
        return Poll::Pending
      end
    end
  end
end

struct SemaphorePermit
  inner: Arc[AsyncSemaphoreInner]
end

impl Drop for SemaphorePermit
  def drop(inout self) -> Unit
    # Release the permit (the atomic increment) and wake the oldest waiter.
    self.inner.ptr.as_ref().counter.fetch_add(1, Ordering::Release)
    match self.inner.ptr.as_ref().waiters.pop_front()
    when Option::Some(waker) then waker.wake()
    when Option::None then ()
    end
  end
end

impl AsyncSemaphore
  def acquire(inout self) -> AcquireFuture
    AcquireFuture { inner: self.inner.clone() }
  end

  def try_acquire(inout self) -> Option[SemaphorePermit]
    let current = self.inner.ptr.as_ref().counter.load(Ordering::Acquire)
    if current > 0 then
      mut expected = current
      if self.inner.ptr.as_ref().counter.compare_exchange(&mut expected, current - 1, Ordering::AcqRel, Ordering::Acquire) then
        return Option::Some(SemaphorePermit { inner: self.inner.clone() })
      end
    end
    Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Transferable / Shareable marker impls (access + resource model)
# ———————————————————————————————————————————————————————————————

impl[T] Transferable for Sender[T] {}
impl[T] Shareable for Sender[T] {}

impl[T] Transferable for Receiver[T] {}
impl[T] Shareable for Receiver[T] {}

impl[T] Transferable for AsyncMutex[T] {}
impl[T] Shareable for AsyncMutex[T] {}

impl Transferable for AsyncSemaphore {}
impl Shareable for AsyncSemaphore {}

impl Transferable for AcquireFuture {}
impl Shareable for AcquireFuture {}

impl Transferable for SemaphorePermit {}
impl Shareable for SemaphorePermit {}
