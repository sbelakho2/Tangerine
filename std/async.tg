# Tangerine Standard Library — Async Runtime
#
# Provides cooperative async/await execution with a single-threaded
# executor, task spawning, channels, timers, and join handles.
#
# Architecture:
# - Executor: a thin Arc wrapper — { inner: Arc[ExecutorInner] }. The whole
#   scheduler state (tasks, ready queue, task states, task results, join
#   waiters, the timer heap, the I/O reactor, the deterministic-mode state)
#   lives in the inner's heap allocation. Wakers and JoinHandles hold
#   their OWN Arc clone of the inner, so a task can outlive the
#   stack-local Executor that spawned it — the same heap-stable shape the
#   channel's Arc[ChannelInner], the AsyncMutex's Arc, and the
#   AsyncSemaphore's Arc use. The old `self as PtrMut[Executor]` handles
#   (which dangled the moment the stack/local executor moved) are gone.
# - Task: a future that can be polled to completion
# - Waker: notifies the executor that a task is ready
# - Channel: async MPSC message passing
# - Timer: async sleep and timeout support

use std::core::{Option, Result, Vec, String, Bool, UInt, Int, Eq, Hash}
use std::collections::{Map, VecDeque}
use std::atomic::{AtomicInt, Ordering}
use std::sync::{Arc, AtomicBool, Mutex}
use std::io::{Read, Write, IOError}
use std::net::{TcpStream, close}
use std::time::{Instant, Duration, instant_now, duration_millis, duration_nanos}

# [METADATA]
# module: tg::async
# status: alpha
# effects: [Async, Kernel, Io]
# capabilities: [Net, Unsafe]
# error_codes: [TaskPanic, Io, Internal]
# description: "Async runtime, task scheduling, timers, and deterministic scheduler mode."
# examples:
#   - |
#     use std::async::{Executor, block_on}
#     block_on(async { 42 })

use std::gfx_errors::{Error, ErrorCode}

enum AsyncError
  TaskPanic(Error)
  Io(Error)
  Internal(Error)
end

impl AsyncError
  def message(self: AsyncError) -> String
    match self
    when AsyncError::TaskPanic(e) then e.message.clone()
    when AsyncError::Io(e) then e.message.clone()
    when AsyncError::Internal(e) then e.message.clone()
    end
  end

  def code(self: AsyncError) -> ErrorCode
    match self
    when AsyncError::TaskPanic(_) then ErrorCode::Internal
    when AsyncError::Io(_) then ErrorCode::IOError
    when AsyncError::Internal(_) then ErrorCode::Internal
    end
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_async_event(level: LogLevel, msg: String) -> Unit
  match GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: 0,
      level: level,
      category: LogCategory::App,
      message: "[ASYNC] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then {}
  end
end

# ———————————————————————————————————————————————————————————————

# ———————————————————————————————————————————————————————————————

# Platform detection at compile time
@cfg(target_os = "linux")
const USE_EPOLL: Bool = true

@cfg(not(target_os = "linux"))
const USE_EPOLL: Bool = false

@cfg(any(target_os = "macos", target_os = "freebsd"))
const USE_KQUEUE: Bool = true

@cfg(not(any(target_os = "macos", target_os = "freebsd")))
const USE_KQUEUE: Bool = false

# FFI for epoll (Linux) — via the native shim (native/epoll_shims.c). The
# Linux x86-64 `struct epoll_event` is a PACKED 12-byte struct ({ u32
# events @0, u64 data @4 } — size 12, alignment 4); the Tangerine-side
# EpollEvent is the padded 16-byte native representation ({ u32 events,
# u32 _pad, u64 data }), and the shim converts between the two at the C
# boundary — the shim holds the REAL libc struct and the std::async calls
# route through it. The C `int` returns declare the i32 form; the wrappers
# below widen with the explicit `as Int` (the reactor stores the
# descriptor in an Int field and the `epfd < 0` error checks must see the
# sign-extended -1).
extern "C" def tg_epoll_create1(flags: Int) -> i32
extern "C" def tg_epoll_ctl(epfd: Int, op: Int, fd: Int, event: Ptr[EpollEvent]) -> i32
extern "C" def tg_epoll_wait(epfd: Int, events: PtrMut[EpollEvent], maxevents: Int, timeout: Int) -> i32
extern "C" def tg_errno_is_eagain() -> i32

# FFI for kqueue (macOS/BSD)
extern "C" def c_kqueue() -> i32
extern "C" def c_kevent(kq: Int, changelist: Ptr[Kevent], nchanges: Int, 
                       eventlist: PtrMut[Kevent], nevents: Int, timeout: Ptr[Timespec]) -> i32

def epoll_create1(flags: Int) -> Int
  tg_epoll_create1(flags as i32) as Int
end

def epoll_ctl(epfd: Int, op: Int, fd: Int, event: Ptr[EpollEvent]) -> Int
  tg_epoll_ctl(epfd as i32, op as i32, fd as i32, event) as Int
end

def epoll_wait(epfd: Int, events: PtrMut[EpollEvent], maxevents: Int, timeout: Int) -> Int
  tg_epoll_wait(epfd as i32, events, maxevents as i32, timeout as i32) as Int
end

# The stale-readiness probe: whether the calling thread's errno is
# EAGAIN/EWOULDBLOCK — the async I/O futures decide the re-register path
# on it. Read through the shim (the real thread-local errno).
def errno_is_eagain() -> Bool
  tg_errno_is_eagain() != 0
end

def kqueue() -> Int
  c_kqueue() as Int
end

def kevent(kq: Int, changelist: Ptr[Kevent], nchanges: Int,
           eventlist: PtrMut[Kevent], nevents: Int, timeout: Ptr[Timespec]) -> Int
  c_kevent(kq as i32, changelist, nchanges as i32, eventlist, nevents as i32, timeout) as Int
end

# epoll constants
const EPOLL_CTL_ADD: Int = 1
const EPOLL_CTL_DEL: Int = 2
const EPOLL_CTL_MOD: Int = 3
const EPOLLIN: u32 = 0x001
const EPOLLOUT: u32 = 0x004
const EPOLLERR: u32 = 0x008
const EPOLLHUP: u32 = 0x010

# kqueue filter/flag constants
const EV_ADD: u16 = 0x0001
const EV_DELETE: u16 = 0x0002
const EV_ENABLE: u16 = 0x0004
const EV_ONESHOT: u16 = 0x0010

def evfilt_read() -> i16
  -1
end

def evfilt_write() -> i16
  -2
end

# The Tangerine-NATIVE epoll event representation: the explicit `_pad`
# makes the layout deterministic ({ u32, u32, u64 } = 16 bytes) — the
# shim's tg_epoll_event_layout mirrors it field-for-field, and the shim
# converts to/from the kernel's PACKED 12-byte epoll_event at the C
# boundary (a Tangerine { u32, u64 } struct would pad to 16 bytes with
# the data at offset 8 — mismatched with the kernel ABI). `data` carries
# the packed RegistrationId (pack_registration) — the readiness token the
# event handler decodes to identify the registration.
struct EpollEvent
  events: u32
  _pad: u32
  data: UInt
end

struct Kevent
  ident: UInt      # identifier (fd)
  filter: i16      # filter type
  flags: u16       # action flags
  fflags: u32      # filter-specific flags
  data: Int        # filter-specific data
  udata: PtrMut[Unit]   # user data (task_id as pointer)
end

struct Timespec
  tv_sec: Int
  tv_nsec: Int
end

# Event interest flags
enum Interest
  Readable
  Writable
  Both
end

# The readiness token: the identity of ONE registration. The futures store
# the id their registration returned; the event handler recovers the id
# from the kernel event's data word; the reactor's registration map is
# keyed by it. The GENERATION component is the fd-number-reuse guard: a
# stale registration (its fd was closed and the number was reused by a new
# registration) never receives the new fd's events — the handler looks the
# decoded id up in the registration map and ignores ids that no longer
# exist. The same fd may carry TWO registrations — one Readable, one
# Writable — as distinct ids.
struct RegistrationId
  task: UInt
  fd: Int
  interest: Interest
  generation: UInt
end

# The per-registration readiness state: the event handler marks it ready;
# the futures' polls inspect it (not-ready -> Pending; ready -> consume
# the event — deregister/modify — then perform the operation). The old
# "second poll == I/O ready" assumption is gone: a poll for an UNRELATED
# reason (a timer wake, another task's event) observes not-ready and stays
# Pending.
struct IoRegistration
  ready: Bool
end

# The three-way status a future's poll inspects for its stored id.
enum RegistrationStatus
  NotRegistered
  Pending
  Ready
end

def interest_eq(a: Interest, b: Interest) -> Bool
  match a
  when Interest::Readable then
    match b
    when Interest::Readable then true
    when _ then false
    end
  when Interest::Writable then
    match b
    when Interest::Writable then true
    when _ then false
    end
  when Interest::Both then
    match b
    when Interest::Both then true
    when _ then false
    end
  end
end

def interest_code(i: Interest) -> Int
  match i
  when Interest::Readable then 1
  when Interest::Writable then 2
  when Interest::Both then 3
  end
end

impl Eq for RegistrationId
  def eq(self: RegistrationId, other: RegistrationId) -> Bool
    if self.task != other.task then return false end
    if self.fd != other.fd then return false end
    if self.generation != other.generation then return false end
    interest_eq(self.interest, other.interest)
  end
end

impl Hash for RegistrationId
  def hash(self: RegistrationId) -> Int
    ((((self.task as Int) * 31 + self.fd) * 31) + (self.generation as Int)) * 31 + interest_code(self.interest)
  end
end

# The RegistrationId is packed into the kernel event's data word (epoll's
# data / kqueue's udata pointer slot — both 64-bit) so the event handler
# can recover the registration identity. The generation component (bits
# 34..64) strictly increases per register, so a stale id can never collide
# with a live one.
def pack_registration(rid: RegistrationId) -> UInt
  let interest_bits: UInt = match rid.interest
  when Interest::Readable then 0
  when Interest::Writable then 1
  when Interest::Both then 2
  end
  ((rid.generation << 34) | (((rid.fd as UInt) & 0xFFFF) << 18) | (interest_bits << 16) | (rid.task & 0xFFFF))
end

def decode_registration(packed: UInt) -> RegistrationId
  RegistrationId {
    task: packed & 0xFFFF,
    fd: ((packed >> 18) & 0xFFFF) as Int,
    interest: match (packed >> 16) & 0x3
    when 0 then Interest::Readable
    when 1 then Interest::Writable
    when _ then Interest::Both
    end,
    generation: packed >> 34
  }
end

# Platform-independent I/O reactor with REAL readiness tokens.
#
# - registrations: Map[RegistrationId, IoRegistration] — the readiness
#   state per registration (the event handler marks ready; the futures'
#   polls inspect).
# - read_rids / write_rids: the CURRENT registration per (fd, interest)
#   slot — the two interests of the same fd are independent registrations.
#   The kernel is (re)programmed through ADD vs MOD on the fd's interest
#   union; DEL when the last interest of an fd deregisters. The slots also
#   drive the event handler: an event for fd marks the slot registrations
#   whose interest matches the event's bits (EPOLLIN/EPOLLOUT/errors).
# - displaced: tasks whose registration was replaced (the fd-number reuse
#   case) — the executor drains it and wakes them so their futures poll,
#   observe the lost registration, and terminate instead of hanging.
# - shut_down: after close(), register fails closed.
struct IoReactor
  poll_fd: Int
  next_generation: UInt
  registrations: Map[RegistrationId, IoRegistration]
  read_rids: Map[Int, RegistrationId]
  write_rids: Map[Int, RegistrationId]
  displaced: VecDeque[UInt]
  shut_down: Bool
end

def io_reactor_new() -> Result[IoReactor, String]
  if USE_KQUEUE then
    let kq = kqueue()
    if kq < 0 then
      return Result::Err("Failed to create kqueue".to_string())
    end
    Result::Ok(IoReactor {
      poll_fd: kq,
      next_generation: 0,
      registrations: Map::new(),
      read_rids: Map::new(),
      write_rids: Map::new(),
      displaced: VecDeque::new(),
      shut_down: false
    })
  elsif USE_EPOLL then
    let epfd = epoll_create1(0)
    if epfd < 0 then
      return Result::Err("Failed to create epoll".to_string())
    end
    Result::Ok(IoReactor {
      poll_fd: epfd,
      next_generation: 0,
      registrations: Map::new(),
      read_rids: Map::new(),
      write_rids: Map::new(),
      displaced: VecDeque::new(),
      shut_down: false
    })
  else
    Result::Err("No I/O multiplexing available on this platform".to_string())
  end
end

impl IoReactor
  # Register a fresh readiness token for (fd, interest). Every register
  # allocates a new generation: a registration that replaces a stale slot
  # entry (the fd was closed and its number reused) removes the old
  # registration — the old id can never receive the new fd's events — and
  # records the displaced task for the executor to wake. The kernel call
  # is ADD when the fd has no live interest yet, MOD otherwise (the fd's
  # interest union changes — the second interest of the same fd does not
  # ADD again: EEXIST would reject it).
  def register(inout self, fd: Int, task_id: UInt, interest: Interest) -> Result[RegistrationId, String]
    if self.shut_down then
      return Result::Err("I/O reactor is shut down".to_string())
    end

    let rid = RegistrationId {
      task: task_id,
      fd: fd,
      interest: interest,
      generation: self.next_generation
    }
    self.next_generation = self.next_generation + 1

    if USE_KQUEUE then
      let filter = match interest
      when Interest::Readable then evfilt_read()
      when Interest::Writable then evfilt_write()
      when Interest::Both then evfilt_read()  # For kqueue, add both separately
      end

      mut ev = Kevent {
        ident: fd as UInt,
        filter: filter,
        flags: EV_ADD | EV_ENABLE,
        fflags: 0,
        data: 0,
        udata: pack_registration(rid) as PtrMut[Unit]
      }

      if kevent(self.poll_fd, &ev as Ptr[Kevent], 1, null_mut() as PtrMut[Kevent], 0, null() as Ptr[Timespec]) < 0 then
        return Result::Err("Failed to register fd with kqueue".to_string())
      end

      # For Both interest, register write as well
      match interest
      when Interest::Both then
        ev.filter = evfilt_write()
        if kevent(self.poll_fd, &ev as Ptr[Kevent], 1, null_mut() as PtrMut[Kevent], 0, null() as Ptr[Timespec]) < 0 then
          return Result::Err("Failed to register write with kqueue".to_string())
        end
      when _ then ()
      end
    elsif USE_EPOLL then
      let has_read = self.read_rids.contains_key(&fd)
      let has_write = self.write_rids.contains_key(&fd)
      let mut old_mask: u32 = 0
      if has_read then old_mask = old_mask | EPOLLIN end
      if has_write then old_mask = old_mask | EPOLLOUT end
      let op = if old_mask == 0 then EPOLL_CTL_ADD else EPOLL_CTL_MOD end
      let new_mask = match interest
      when Interest::Readable then EPOLLIN
      when Interest::Writable then EPOLLOUT
      when Interest::Both then EPOLLIN | EPOLLOUT
      end

      mut ev = EpollEvent {
        events: old_mask | new_mask,
        _pad: 0,
        data: pack_registration(rid)
      }

      if epoll_ctl(self.poll_fd, op, fd, &mut ev as Ptr[EpollEvent]) < 0 then
        # ADD failed (the fd number was reused and the kernel still holds
        # the old entry — EEXIST): retry as MOD. A non-EEXIST failure
        # (e.g. EBADF — the fd was closed) fails the MOD too and errors.
        if op == EPOLL_CTL_ADD then
          if epoll_ctl(self.poll_fd, EPOLL_CTL_MOD, fd, &mut ev as Ptr[EpollEvent]) < 0 then
            return Result::Err("Failed to register fd with epoll".to_string())
          end
        else
          return Result::Err("Failed to register fd with epoll".to_string())
        end
      end
    end

    # Replace a stale registration for the same (fd, interest) — the fd
    # number was reused: the old id must never receive the new fd's
    # events. The displaced task is queued for the executor to wake.
    match interest
    when Interest::Readable then
      match self.read_rids.get(&fd)
      when Option::Some(old_rid) then
        if old_rid != rid then
          let _ = self.registrations.remove(old_rid)
          self.displaced.push_back(old_rid.task)
        end
      when Option::None then ()
      end
    when Interest::Writable then
      match self.write_rids.get(&fd)
      when Option::Some(old_rid) then
        if old_rid != rid then
          let _ = self.registrations.remove(old_rid)
          self.displaced.push_back(old_rid.task)
        end
      when Option::None then ()
      end
    when Interest::Both then
      match self.read_rids.get(&fd)
      when Option::Some(old_rid) then
        if old_rid != rid then
          let _ = self.registrations.remove(old_rid)
          self.displaced.push_back(old_rid.task)
        end
      when Option::None then ()
      end
      match self.write_rids.get(&fd)
      when Option::Some(old_rid) then
        if old_rid != rid then
          let _ = self.registrations.remove(old_rid)
          self.displaced.push_back(old_rid.task)
        end
      when Option::None then ()
      end
    end

    match interest
    when Interest::Readable then let _ = self.read_rids.insert(fd, rid)
    when Interest::Writable then let _ = self.write_rids.insert(fd, rid)
    when Interest::Both then
      let _ = self.read_rids.insert(fd, rid)
      let _ = self.write_rids.insert(fd, rid)
    end
    self.registrations.insert(rid, IoRegistration { ready: false })
    Result::Ok(rid)
  end

  # Consume the readiness: remove the registration and reprogram the
  # kernel for the fd's remaining interests (MOD) or delete the fd's
  # kernel entry when no interest remains (DEL). A DEL failure (the fd was
  # closed — the kernel already dropped the entry) is ignored: the
  # Tangerine-side state is the authority.
  def deregister(inout self, rid: RegistrationId) -> Result[Unit, String]
    match self.registrations.remove(rid)
    when Option::Some(_) then
      self.clear_slot(rid)
      self.sync_fd(rid.fd)
      Result::Ok(())
    when Option::None then
      Result::Ok(())
    end
  end

  # Clear the (fd, interest) slot when it still points at THIS rid (a
  # newer registration may own the slot after an fd-number reuse).
  def clear_slot(inout self, rid: RegistrationId) -> Unit
    match rid.interest
    when Interest::Readable then
      match self.read_rids.get(&rid.fd)
      when Option::Some(slot) then
        if slot == rid then
          let _ = self.read_rids.remove(&rid.fd)
        end
      when Option::None then ()
      end
    when Interest::Writable then
      match self.write_rids.get(&rid.fd)
      when Option::Some(slot) then
        if slot == rid then
          let _ = self.write_rids.remove(&rid.fd)
        end
      when Option::None then ()
      end
    when Interest::Both then
      match self.read_rids.get(&rid.fd)
      when Option::Some(slot) then
        if slot == rid then
          let _ = self.read_rids.remove(&rid.fd)
        end
      when Option::None then ()
      end
      match self.write_rids.get(&rid.fd)
      when Option::Some(slot) then
        if slot == rid then
          let _ = self.write_rids.remove(&rid.fd)
        end
      when Option::None then ()
      end
    end
  end

  # Recompute the kernel registration for an fd from its live slots:
  # DEL when nothing remains, MOD with the combined mask otherwise (the
  # data carries a live slot's rid so events decode to a live
  # registration).
  def sync_fd(inout self, fd: Int) -> Unit
    let has_read = self.read_rids.contains_key(&fd)
    let has_write = self.write_rids.contains_key(&fd)
    if !has_read && !has_write then
      if USE_EPOLL then
        let _ = epoll_ctl(self.poll_fd, EPOLL_CTL_DEL, fd, null_mut() as Ptr[EpollEvent])
      elsif USE_KQUEUE then
        mut ev = Kevent {
          ident: fd as UInt,
          filter: evfilt_read(),
          flags: EV_DELETE,
          fflags: 0,
          data: 0,
          udata: null_mut()
        }
        let _ = kevent(self.poll_fd, &ev as Ptr[Kevent], 1, null_mut() as PtrMut[Kevent], 0, null() as Ptr[Timespec])
        ev.filter = evfilt_write()
        let _ = kevent(self.poll_fd, &ev as Ptr[Kevent], 1, null_mut() as PtrMut[Kevent], 0, null() as Ptr[Timespec])
      end
    elsif USE_EPOLL then
      let mut mask: u32 = 0
      if has_read then mask = mask | EPOLLIN end
      if has_write then mask = mask | EPOLLOUT end
      let data = match self.read_rids.get(&fd)
      when Option::Some(slot) then pack_registration(slot)
      when Option::None then
        match self.write_rids.get(&fd)
        when Option::Some(slot) then pack_registration(slot)
        when Option::None then 0
        end
      end
      mut ev = EpollEvent {
        events: mask,
        _pad: 0,
        data: data
      }
      let _ = epoll_ctl(self.poll_fd, EPOLL_CTL_MOD, fd, &mut ev as Ptr[EpollEvent])
    end
  end

  # Mark a registration ready and queue its task. Stale ids (deregistered,
  # replaced, cancelled) are ignored — the event belonged to a past
  # registration lifecycle.
  def mark_ready(inout self, rid: RegistrationId, inout ready_tasks: Vec[UInt]) -> Unit
    match self.registrations.get(rid)
    when Option::Some(_) then
      self.registrations.insert(rid, IoRegistration { ready: true })
      if !ready_tasks.contains(&rid.task) then
        ready_tasks.push(rid.task)
      end
    when Option::None then ()
    end
  end

  # The event handler: wait for kernel events, decode each event's data
  # into the registration identity, and mark the fd's CURRENT slot
  # registrations ready per the event's interest bits. EPOLLIN marks the
  # read slot; EPOLLOUT the write slot; EPOLLERR/EPOLLHUP mark both (an
  # error unblocks every waiter of the fd). The marked readiness is the
  # consumed-token state the futures' polls inspect.
  def poll(inout self, timeout_ms: Int) -> Vec[UInt]
    mut ready_tasks = Vec::new()
    if self.shut_down then
      return ready_tasks
    end

    if USE_KQUEUE then
      mut events: [Kevent; 64] = unsafe "zero-initialize kqueue events buffer before kernel fill" do
        zeroed()
      end
      mut ts = Timespec {
        tv_sec: timeout_ms / 1000,
        tv_nsec: (timeout_ms % 1000) * 1_000_000
      }

      let n = kevent(self.poll_fd, null() as Ptr[Kevent], 0, events.as_mut_ptr(), 64, &ts as Ptr[Timespec])
      let mut i = 0
      while i < n do
        let rid = decode_registration(events[i].udata as UInt)
        let fd = rid.fd
        match rid.interest
        when Interest::Readable then
          match self.read_rids.get(&fd)
          when Option::Some(slot) then self.mark_ready(slot, &mut ready_tasks)
          when Option::None then ()
          end
        when Interest::Writable then
          match self.write_rids.get(&fd)
          when Option::Some(slot) then self.mark_ready(slot, &mut ready_tasks)
          when Option::None then ()
          end
        when Interest::Both then
          match self.read_rids.get(&fd)
          when Option::Some(slot) then self.mark_ready(slot, &mut ready_tasks)
          when Option::None then ()
          end
          match self.write_rids.get(&fd)
          when Option::Some(slot) then self.mark_ready(slot, &mut ready_tasks)
          when Option::None then ()
          end
        end
        i = i + 1
      end
    elsif USE_EPOLL then
      mut events: [EpollEvent; 64] = unsafe "zero-initialize epoll events buffer before kernel fill" do
        zeroed()
      end

      let n = epoll_wait(self.poll_fd, events.as_mut_ptr(), 64, timeout_ms)
      let mut i = 0
      while i < n do
        let rid = decode_registration(events[i].data)
        let fd = rid.fd
        let ev_events = events[i].events
        if (ev_events & EPOLLIN) != 0 then
          match self.read_rids.get(&fd)
          when Option::Some(slot) then self.mark_ready(slot, &mut ready_tasks)
          when Option::None then ()
          end
        end
        if (ev_events & EPOLLOUT) != 0 then
          match self.write_rids.get(&fd)
          when Option::Some(slot) then self.mark_ready(slot, &mut ready_tasks)
          when Option::None then ()
          end
        end
        if (ev_events & (EPOLLERR | EPOLLHUP)) != 0 then
          match self.read_rids.get(&fd)
          when Option::Some(slot) then self.mark_ready(slot, &mut ready_tasks)
          when Option::None then ()
          end
          match self.write_rids.get(&fd)
          when Option::Some(slot) then self.mark_ready(slot, &mut ready_tasks)
          when Option::None then ()
          end
        end
        i = i + 1
      end
    end

    ready_tasks
  end

  # The readiness probe (the futures' polls): a registration that exists
  # and is ready reports true. The id is the consumed-token authority — a
  # replaced/cancelled id simply no longer exists.
  def is_ready(self: IoReactor, rid: RegistrationId) -> Bool
    match self.registrations.get(rid)
    when Option::Some(reg) then reg.ready
    when Option::None then false
    end
  end

  # The three-way status the futures' polls inspect.
  def status(self: IoReactor, rid: RegistrationId) -> RegistrationStatus
    match self.registrations.get(rid)
    when Option::Some(reg) then
      if reg.ready then
        RegistrationStatus::Ready
      else
        RegistrationStatus::Pending
      end
    when Option::None then RegistrationStatus::NotRegistered
    end
  end

  # Task cancellation: drop every registration of the task and reprogram
  # the affected fds.
  def remove_task(inout self, task_id: UInt) -> Unit
    let mut removed: Vec[RegistrationId] = Vec::new()
    let mut kept: Map[RegistrationId, IoRegistration] = Map::new()
    loop do
      match self.registrations.drain_one()
      when Option::Some((rid, reg)) then
        if rid.task == task_id then
          removed.push(rid)
        else
          kept.insert(rid, reg)
        end
      when Option::None then break
      end
    end
    self.registrations = kept
    while removed.len() > 0 do
      let rid = removed.remove(0)
      self.clear_slot(rid)
      self.sync_fd(rid.fd)
    end
  end

  # The executor's run loop drains the displaced-task queue and wakes each
  # task (its registration was replaced by an fd-number reuse — the task
  # must poll and observe the lost registration instead of hanging).
  def drain_displaced(inout self, inout ready_queue: VecDeque[UInt]) -> Unit
    while !self.displaced.is_empty() do
      let tid = self.displaced.pop_front().unwrap()
      if !ready_queue.contains(&tid) then
        ready_queue.push_back(tid)
      end
    end
  end

  # Reactor shutdown: close the polling fd and fail all further
  # registrations closed.
  def close(inout self) -> Unit
    if self.poll_fd >= 0 then
      close(self.poll_fd)
      self.poll_fd = -1
    end
    self.shut_down = true
  end
end

# ———————————————————————————————————————————————————————————————
# Poll and Future
# ———————————————————————————————————————————————————————————————

enum Poll[T]
  Ready(T)
  Pending
end

trait Future
  type Output
  def poll(inout self, inout cx: Context) -> Poll[Self::Output]
end

struct Context
  waker: Waker
end

struct Waker
  task_id: UInt
  # The waker holds its OWN Arc clone of the executor inner — a task's
  # waker keeps the executor (and the task's state) alive even after the
  # stack-local Executor that spawned the task is dropped or moved. The
  # old PtrMut[Executor] handle died with the stack frame.
  executor: Arc[ExecutorInner]
end

impl Waker
  def wake(self) -> Unit
    # Mark the task as ready in the executor
    guard !self.executor.is_null() else return end
    unsafe "executor inner access — the waker's Arc clone keeps the executor alive" do
      let exec = self.executor.ptr.as_mut()
      exec.wake_task(self.task_id)
    end
  end
  
  def clone(self) -> Waker
    Waker {
      task_id: self.task_id,
      executor: self.executor.clone()
    }
  end
end

# ———————————————————————————————————————————————————————————————
# Task
# ———————————————————————————————————————————————————————————————

enum TaskState
  Ready          # Queued for polling
  Waiting        # Blocked, waiting for wake
  Completed      # Finished
  Cancelled      # Cancelled before completion
  Failed         # Finished with an error
end

# The terminal outcome a finished task leaves behind. finish_task records
# it in the task's state and wakes the join waiters exactly once — the
# single terminal path the normal completion AND the cancellation route
# through.
enum TaskOutcome
  Completed
  Cancelled
  Failed
end

struct Task
  id: UInt
  state: TaskState
  future: Box[dyn Future[Output = ()]]
  name: Option[String]
end

struct JoinHandle[T]
  task_id: UInt
  result: Option[T]
  # The handle holds its OWN Arc clone of the executor inner — the handle
  # keeps the executor (and the task's results and join waiters) alive
  # even after the spawning Executor is dropped or moved.
  executor: Arc[ExecutorInner]
end

impl JoinHandle[T]
  def is_finished(self) -> Bool
    let exec = self.executor.ptr.as_ref()
    match exec.task_states.get(&self.task_id)
    when Option::Some(TaskState::Completed) then true
    when Option::Some(TaskState::Cancelled) then true
    when Option::Some(TaskState::Failed) then true
    when _ then false
    end
  end
end

# JoinHandle itself is a future. The result is the Result[(), String]
# form ("task cancelled" / "task failed") — the typed JoinError enum is
# the documented future work.
impl Future for JoinHandle[T]
  type Output = Result[T, String]
  
  def poll(inout self, inout cx: Context) -> Poll[Result[T, String]]
    unsafe "executor inner access — the handle's Arc clone keeps the executor alive" do
      let exec = self.executor.ptr.as_mut()
      match exec.task_results.remove(&self.task_id)
      when Option::Some(_) then
        Poll::Ready(Result::Ok(()))
      when Option::None then
        # The terminal states: the cancelled/failed task's join completes
        # with the error (the finish_task path woke this poll — a handle
        # that registered a waiter before the cancellation is re-polled
        # and observes the terminal state here).
        match exec.task_states.get(&self.task_id)
        when Option::Some(TaskState::Cancelled) then
          let cancel_result: Result[T, String] = Result::Err("task cancelled".to_string())
          Poll::Ready(cancel_result)
        when Option::Some(TaskState::Failed) then
          let fail_result: Result[T, String] = Result::Err("task failed".to_string())
          Poll::Ready(fail_result)
        when _ then
          # Register interest
          exec.join_waiters.insert(self.task_id, cx.waker.clone())
          Poll::Pending
        end
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# ScopedTaskHandle (the typed child handle — the JoinHandle class)
# ———————————————————————————————————————————————————————————————

# The handle TaskScope::spawn returns: the child's task id plus the
# handle's OWN Arc clone of the executor inner (the handle keeps the
# executor — and the child's state — alive even if the spawning Executor
# is dropped or moved). The handle is itself a future whose Output is the
# child's TERMINAL RESULT: Ok(()) when the child completed, Err when the
# child was cancelled. Awaiting the handle from the scoped join_all is the
# cooperative wait — the executor advances the children between the
# join_all task's polls.
struct ScopedTaskHandle
  task_id: UInt
  executor: Arc[ExecutorInner]
end

impl ScopedTaskHandle
  # Cancel the child task: the task reaches the terminal state Cancelled,
  # its registrations are removed, and its join waiters (a join_all
  # awaiting it) are woken — the handle then resolves Err on the next
  # poll.
  def cancel(self: ScopedTaskHandle) -> Bool
    let mut exec = Executor { inner: self.executor.clone() }
    exec.cancel_task(self.task_id)
  end
end

impl Future for ScopedTaskHandle
  type Output = Result[Unit, String]

  def poll(inout self, inout cx: Context) -> Poll[Result[Unit, String]]
    unsafe "executor inner access — the handle's Arc clone keeps the executor alive" do
      let exec = self.executor.ptr.as_mut()
      # The terminal states: Completed (a result is stored) or Cancelled.
      # Everything else — the child is still running — registers the
      # waiter and stays Pending (the child's completion or cancellation
      # wakes this handle).
      if exec.task_results.contains_key(&self.task_id) then
        let ok_result: Result[Unit, String] = Result::Ok(())
        return Poll::Ready(ok_result)
      end
      match exec.task_states.get(&self.task_id)
      when Option::Some(TaskState::Cancelled) then
        let cancel_result: Result[Unit, String] = Result::Err("task cancelled".to_string())
        Poll::Ready(cancel_result)
      when Option::Some(TaskState::Failed) then
        let fail_result: Result[Unit, String] = Result::Err("task failed".to_string())
        Poll::Ready(fail_result)
      when _ then
        exec.join_waiters.insert(self.task_id, cx.waker.clone())
        Poll::Pending
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Executor
# ———————————————————————————————————————————————————————————————

# The scheduler state lives in a heap allocation owned by an Arc (the
# same std::sync Arc the channel/AsyncMutex/AsyncSemaphore use). Wakers
# and JoinHandles hold their own inner clones, so a task keeps the
# executor alive even after the stack-local Executor that spawned it is
# dropped or moved.
struct ExecutorInner
  tasks: Map[UInt, Task]
  ready_queue: VecDeque[UInt]
  next_task_id: UInt
  task_states: Map[UInt, TaskState]
  task_results: Map[UInt, Unit]   # the executor's tasks are all ()-output
  join_waiters: Map[UInt, Waker]     # task_id -> waker of JoinHandle
  timer_heap: Vec[TimerEntry]
  # I/O reactor for async I/O
  io_reactor: Option[IoReactor]
  running: Bool
  # Deterministic mode support
  deterministic: Bool
  seed: u64
  virtual_time: Instant
  rand_state: u64
end

# The Executor is a thin Arc wrapper over the inner — the public API
# (new/spawn/spawn_named/run/poll_task/set_deterministic/task_count/
# cancel_task/register_timer) stays on the wrapper; the stateful
# scheduler methods live on ExecutorInner and are reached through the Arc
# the wakers/handles hold. `self as PtrMut[Executor]` is gone: no handle
# ever addresses a caller-owned stack slot.
struct Executor
  inner: Arc[ExecutorInner]
end

struct TimerEntry
  deadline: Instant
  task_id: UInt
end

def timer_heap_push(inout heap: Vec[TimerEntry], entry: TimerEntry) -> Unit
  heap.push(entry)
  mut idx = heap.len() - 1
  while idx > 0 do
    let parent = (idx - 1) / 2
    if heap[parent].deadline <= heap[idx].deadline then
      break
    end
    let tmp = heap[parent]
    heap[parent] = heap[idx]
    heap[idx] = tmp
    idx = parent
  end
end

def timer_heap_pop_min(inout heap: Vec[TimerEntry]) -> Option[TimerEntry]
  if heap.is_empty() then
    return Option::None
  end

  let min_entry = heap[0]
  if heap.len() == 1 then
    let _ = heap.pop()
    return Option::Some(min_entry)
  end

  let last = heap.pop().unwrap()
  heap[0] = last

  mut idx: UInt = 0
  loop
    let left = idx * 2 + 1
    let right = idx * 2 + 2
    mut smallest = idx

    if left < heap.len() && heap[left].deadline < heap[smallest].deadline then
      smallest = left
    end
    if right < heap.len() && heap[right].deadline < heap[smallest].deadline then
      smallest = right
    end

    if smallest == idx then
      break
    end

    let tmp = heap[idx]
    heap[idx] = heap[smallest]
    heap[smallest] = tmp
    idx = smallest
  end

  Option::Some(min_entry)
end

def timer_heap_peek_deadline(heap: Vec[TimerEntry]) -> Option[Instant]
  if heap.is_empty() then
    Option::None
  else
    Option::Some(heap[0].deadline)
  end
end

def executor_new() -> Executor
  # Try to create I/O reactor (may fail on unsupported platforms)
  let reactor = match io_reactor_new()
  when Result::Ok(r) then Option::Some(r)
  when Result::Err(_) then Option::None
  end
  
  Executor {
    inner: Arc::new(ExecutorInner {
      tasks: Map::new(),
      ready_queue: VecDeque::new(),
      next_task_id: 1,
      task_states: Map::new(),
      task_results: Map::new(),
      join_waiters: Map::new(),
      timer_heap: Vec::new(),
      io_reactor: reactor,
      running: false,
      deterministic: false,
      seed: 0,
      virtual_time: Instant::now(),
      rand_state: 0
    })
  }
end

impl Executor
  def new() -> Result[Executor, String]
    Result::Ok(executor_new())
  end

  def spawn(inout self, future: impl Future[Output = ()]) -> JoinHandle[()]
    # The handle takes an Arc clone of the inner — the task (and its
    # result slot) stays alive even if this Executor is dropped or moved.
    let id = unsafe "executor inner access — the Arc clone keeps the executor alive" do
      let inner = self.inner.ptr.as_mut()
      let id = inner.next_task_id
      inner.next_task_id = inner.next_task_id + 1
      
      let task = Task {
        id: id,
        state: TaskState::Ready,
        future: Box::new(future),
        name: Option::None
      }
      
      inner.tasks.insert(id, task)
      inner.task_states.insert(id, TaskState::Ready)
      inner.ready_queue.push_back(id)
      id
    end
    
    JoinHandle {
      task_id: id,
      result: Option::None,
      executor: self.inner.clone()
    }
  end
  
  def spawn_named(inout self, name: String, future: impl Future[Output = ()]) -> JoinHandle[()]
    let id = unsafe "executor inner access — the Arc clone keeps the executor alive" do
      let inner = self.inner.ptr.as_mut()
      let id = inner.next_task_id
      inner.next_task_id = inner.next_task_id + 1
      
      let task = Task {
        id: id,
        state: TaskState::Ready,
        future: Box::new(future),
        name: Option::Some(name)
      }
      
      inner.tasks.insert(id, task)
      inner.task_states.insert(id, TaskState::Ready)
      inner.ready_queue.push_back(id)
      id
    end
    
    JoinHandle {
      task_id: id,
      result: Option::None,
      executor: self.inner.clone()
    }
  end
  
  def run(inout self) -> Unit
    unsafe "executor inner access — the Arc clone keeps the executor alive" do
      let inner = self.inner.ptr.as_mut()
      inner.running = true

      while inner.running do
        # Check timers
        if inner.deterministic then
          inner.check_timers_deterministic()
        else
          inner.check_timers()
        end

        # Poll I/O reactor for ready file descriptors
        if !inner.deterministic then
          match inner.io_reactor
          when Option::Some(mut reactor) then
            # Wake tasks displaced by registration replacement (the
            # fd-number reuse case) — their futures must poll and observe
            # the lost registration.
            reactor.drain_displaced(&mut inner.ready_queue)
            # Poll with 0 timeout for non-blocking check
            let io_ready = reactor.poll(0)
            for task_id in io_ready do
              if !inner.ready_queue.contains(&task_id) then
                inner.ready_queue.push_back(task_id)
              end
            end
          when Option::None then ()
          end
        end

        # Poll ready tasks
        match inner.ready_queue.pop_front()
        when Option::Some(task_id) then
          self.poll_task(task_id)
        when Option::None then
          # No ready tasks — check if all done
          if inner.tasks.is_empty() then
            inner.running = false
            break
          end

          # Advance virtual time or block on I/O/timers
          if inner.deterministic then
            if !inner.timer_heap.is_empty() then
              # Advance to next timer
              let min_entry = inner.timer_heap[0]
              inner.virtual_time = min_entry.deadline
              inner.check_timers_deterministic()
            else
              # No ready tasks and no timers in deterministic mode == deadlock or finished
              inner.running = false
            end
          else
            # Block on I/O and timers
            let timeout_ms = match inner.next_timer_deadline()
            when Option::Some(deadline) then
              let now = instant_now()
              let remaining = deadline.duration_since(now)
              duration_millis(remaining).max(0).min(100)
            when Option::None then 100  # Default 100ms timeout
            end

            match inner.io_reactor
            when Option::Some(mut reactor) then
              # Block on I/O with timeout
              let io_ready = reactor.poll(timeout_ms as Int)
              for task_id in io_ready do
                inner.ready_queue.push_back(task_id)
              end
            when Option::None then
              # No I/O reactor — just sleep
              if timeout_ms > 0 then
                sleep_ms(timeout_ms)
              else
                sleep_ms(1)
              end
            end
          end
        end
      end
    end
  end

  def poll_task(inout self, task_id: UInt) -> Unit
    # The per-task waker holds an Arc clone of the inner: the task (and
    # its waker) keeps the executor alive even if the stack-local
    # Executor is dropped while the task is in flight.
    let waker = Waker {
      task_id: task_id,
      executor: self.inner.clone()
    }

    mut cx = Context { waker: waker }

    unsafe "executor inner access — the Arc clone keeps the executor alive" do
      let inner = self.inner.ptr.as_mut()
      match inner.tasks.get_mut(&task_id)
      when Option::None then return
      when Option::Some(task) then
        # CAP-44: Integrate with diagnostics for task polling
        _log_async_event(LogLevel::Trace, "Polling task " + task_id.to_string())

        match task.future.poll(&mut cx)
        when Poll::Ready(()) then
          # Task completed — the single terminal path (removes the task,
          # records the Completed state + the ()-result, and wakes the
          # join waiters exactly once).
          inner.finish_task(task_id, TaskOutcome::Completed)
        when Poll::Pending then
          inner.task_states.insert(task_id, TaskState::Waiting)
          
          # Integration with ctxpacks: capture context if task is stuck or interesting
          let mut seeds = Vec::new()
          seeds.push("async::task_pending".to_string())
          seeds.push("task_id::" + task_id.to_string())
          match std::ctx::build_pack(seeds, 1000)
          when Ok(pack) then std::ctx::register_pack(pack)
          when Err(_) then {}
          end
        end
      end
    end
  end
  
  def set_deterministic(inout self, seed: u64) -> Unit
    unsafe "executor inner access — the Arc clone keeps the executor alive" do
      let inner = self.inner.ptr.as_mut()
      inner.set_deterministic(seed)
    end
  end

  def task_count(self) -> UInt
    let inner = self.inner.ptr.as_ref()
    inner.task_count()
  end
  
  def cancel_task(inout self, task_id: UInt) -> Bool
    unsafe "executor inner access — the Arc clone keeps the executor alive" do
      let inner = self.inner.ptr.as_mut()
      inner.cancel_task(task_id)
    end
  end
  
  def register_timer(inout self, deadline: Instant, task_id: UInt) -> Unit
    unsafe "executor inner access — the Arc clone keeps the executor alive" do
      let inner = self.inner.ptr.as_mut()
      inner.register_timer(deadline, task_id)
    end
  end
end

impl ExecutorInner
  def wake_task(inout self, task_id: UInt) -> Unit
    match self.task_states.get(&task_id)
    when Option::Some(TaskState::Waiting) then
      self.task_states.insert(task_id, TaskState::Ready)
      self.ready_queue.push_back(task_id)
    when _ then ()
    end
  end

  # Register a file descriptor for async I/O — returns the readiness
  # token (the RegistrationId) the future stores and re-polls against.
  def register_io(inout self, fd: Int, task_id: UInt, interest: Interest) -> Result[RegistrationId, String]
    match self.io_reactor
    when Option::Some(mut reactor) then
      reactor.register(fd, task_id, interest)
    when Option::None then
      Result::Err("No I/O reactor available".to_string())
    end
  end

  # Consume the readiness of a registration (deregister/modify the kernel
  # registration).
  def deregister_io(inout self, rid: RegistrationId) -> Unit
    match self.io_reactor
    when Option::Some(mut reactor) then
      let _ = reactor.deregister(rid)
    when Option::None then ()
    end
  end

  # The three-way readiness status a future's poll inspects for its
  # stored token: not-ready stays Pending; ready is consumed by the
  # deregister+operation; a vanished registration (replaced or cancelled)
  # is NotRegistered.
  def io_status(self: ExecutorInner, rid: RegistrationId) -> RegistrationStatus
    match self.io_reactor
    when Option::Some(reactor) then
      reactor.status(rid)
    when Option::None then
      RegistrationStatus::NotRegistered
    end
  end

  def check_timers_deterministic(inout self) -> Unit
    # Process all expired timers from min-heap root based on virtual time
    loop do
      match timer_heap_peek_deadline(&self.timer_heap)
      when Option::Some(deadline) then
        if deadline <= self.virtual_time then
          let entry = timer_heap_pop_min(&mut self.timer_heap).unwrap()
          self.ready_queue.push_back(entry.task_id)
        else
          break
        end
      when Option::None then break
      end
    end
  end
  
  def check_timers(inout self) -> Unit
    let now = instant_now()

    # Process all expired timers from min-heap root
    loop
      match timer_heap_peek_deadline(&self.timer_heap)
      when Option::Some(deadline) then
        if deadline <= now then
          match timer_heap_pop_min(&mut self.timer_heap)
          when Option::Some(entry) then self.wake_task(entry.task_id)
          when Option::None then break
          end
        else
          break
        end
      when Option::None then break
      end
    end
  end
  
  def next_timer_deadline(self) -> Option[Instant]
    timer_heap_peek_deadline(&self.timer_heap)
  end

  def set_deterministic(inout self, seed: u64) -> Unit
    self.deterministic = true
    self.seed = seed
    self.rand_state = seed
    self.virtual_time = Instant::now() # Base time for virtual clock
  end

  def rand_u64(inout self) -> u64
    # PCG-style simple PRNG for deterministic task ordering
    let mut x = self.rand_state
    let count = (x >> 59) as UInt
    x ^= x >> 18
    let rot = ((x >> 27) as u32).rotate_right(count as u32)
    self.rand_state = self.rand_state * 6364136223846793005u64 + 1442695040888963407u64
    rot as u64
  end
  
  def register_timer(inout self, deadline: Instant, task_id: UInt) -> Unit
    timer_heap_push(&mut self.timer_heap, TimerEntry {
      deadline: deadline,
      task_id: task_id
    })
  end
  
  # THE single terminal-outcome path: removes the task, records the
  # terminal state (Completed also stores the ()-result slot), and wakes
  # the task's join waiter exactly once. The normal completion (poll_task
  # observing Ready) AND the cancellation (cancel_task) both route
  # through here — a cancelled/failed task's pending join is woken and
  # completes with the error on its next poll.
  def finish_task(inout self, task_id: UInt, outcome: TaskOutcome) -> Unit
    let _ = self.tasks.remove(&task_id)
    match outcome
    when TaskOutcome::Completed then
      self.task_states.insert(task_id, TaskState::Completed)
      self.task_results.insert(task_id, ())
    when TaskOutcome::Cancelled then
      self.task_states.insert(task_id, TaskState::Cancelled)
    when TaskOutcome::Failed then
      self.task_states.insert(task_id, TaskState::Failed)
    end
    match self.join_waiters.remove(&task_id)
    when Option::Some(waiter) then waiter.wake()
    when Option::None then ()
    end
  end

  # Cancel a task: it reaches the terminal state Cancelled through the
  # shared finish_task path (the join waiter is woken there — a pending
  # join completes with "task cancelled" on its next poll), and its I/O
  # registrations are removed from the reactor.
  def cancel_task(inout self, task_id: UInt) -> Bool
    if !self.tasks.contains_key(&task_id) then
      return false
    end
    match self.io_reactor
    when Option::Some(mut reactor) then reactor.remove_task(task_id)
    when Option::None then ()
    end
    self.finish_task(task_id, TaskOutcome::Cancelled)
    true
  end
  
  def task_count(self) -> UInt
    self.tasks.len()
  end
end

# ———————————————————————————————————————————————————————————————
# Async Sleep / Timer Future
# ———————————————————————————————————————————————————————————————

# The executor's clock: the deterministic mode's VIRTUAL time, the wall
# clock otherwise — the two faces of ExecutorInner's existing
# deterministic/virtual_time state. The sleep/timeout futures read their
# time from THIS clock (never the raw wall clock): the deterministic run
# advances virtual_time and the sleeps complete against that advance,
# exactly like real time drives the wall-clock run.
struct ExecutorClock
  executor: Arc[ExecutorInner]
end

impl ExecutorClock
  def now(self) -> Instant
    unsafe "executor inner access — the clock's Arc clone keeps the executor alive" do
      let exec = self.executor.ptr.as_ref()
      if exec.deterministic then
        exec.virtual_time
      else
        instant_now()
      end
    end
  end
end

struct SleepFuture
  duration: Duration
  deadline: Option[Instant]   # fixed at the FIRST poll from the clock
  registered: Bool
end

impl Future for SleepFuture
  type Output = ()
  
  def poll(inout self, inout cx: Context) -> Poll[()]
    # The deadline is set at the FIRST poll from the executor's clock
    # (virtual time in the deterministic mode, the wall clock otherwise)
    # — NOT at construction, and never from the raw wall clock: the
    # deterministic run advances virtual_time, and the sleep must
    # complete against that advance (the wall clock never moves there).
    let clock = ExecutorClock { executor: cx.waker.executor.clone() }
    let now = clock.now()
    let deadline = match self.deadline
    when Option::Some(d) then d
    when Option::None then
      let d = now.add(self.duration)
      self.deadline = Option::Some(d)
      d
    end
    if now >= deadline then
      Poll::Ready(())
    else
      if !self.registered then
        # Register timer with executor
        unsafe "executor inner access — the waker's Arc clone keeps the executor alive" do
          let exec = cx.waker.executor.ptr.as_mut()
          exec.register_timer(deadline, cx.waker.task_id)
        end
        self.registered = true
      end
      Poll::Pending
    end
  end
end

pub def sleep(duration: Duration) -> SleepFuture
  SleepFuture {
    duration: duration,
    deadline: Option::None,
    registered: false
  }
end

pub def sleep_millis(ms: UInt) -> SleepFuture
  sleep(Duration::from_millis(ms))
end

# ———————————————————————————————————————————————————————————————
# Timeout
# ———————————————————————————————————————————————————————————————

struct TimeoutFuture[F: Future]
  inner: F
  duration: Duration
  deadline: Option[Instant]   # fixed at the FIRST poll from the clock
  timer_registered: Bool
end

enum TimeoutError
  TimedOut
end

impl Future for TimeoutFuture[F]
  type Output = Result[F::Output, TimeoutError]
  
  def poll(inout self, inout cx: Context) -> Poll[Result[F::Output, TimeoutError]]
    # Check the inner future first
    match self.inner.poll(cx)
    when Poll::Ready(val) then
        let ready_result: Result[F::Output, TimeoutError] = Result::Ok(val)
        return Poll::Ready(ready_result)
    when Poll::Pending then ()
    end
    
    # The deadline is fixed at the FIRST poll from the executor's clock
    # (the same clock the SleepFuture uses): virtual time in the
    # deterministic mode, the wall clock otherwise.
    let clock = ExecutorClock { executor: cx.waker.executor.clone() }
    let now = clock.now()
    let deadline = match self.deadline
    when Option::Some(d) then d
    when Option::None then
      let d = now.add(self.duration)
      self.deadline = Option::Some(d)
      d
    end
    if now >= deadline then
        let timeout_result: Result[F::Output, TimeoutError] = Result::Err(TimeoutError::TimedOut)
        Poll::Ready(timeout_result)
    else
      if !self.timer_registered then
        unsafe "executor inner access — the waker's Arc clone keeps the executor alive" do
          let exec = cx.waker.executor.ptr.as_mut()
          exec.register_timer(deadline, cx.waker.task_id)
        end
        self.timer_registered = true
      end
      Poll::Pending
    end
  end
end

pub def timeout[F: Future](duration: Duration, future: F) -> TimeoutFuture[F]
  TimeoutFuture {
    inner: future,
    duration: duration,
    deadline: Option::None,
    timer_registered: false
  }
end

# ———————————————————————————————————————————————————————————————
# Yield
# ———————————————————————————————————————————————————————————————

struct YieldNow
  yielded: Bool
end

impl Future for YieldNow
  type Output = ()
  
  def poll(inout self, inout cx: Context) -> Poll[()]
    if self.yielded then
      Poll::Ready(())
    else
      self.yielded = true
      # Re-queue ourselves
      cx.waker.wake()
      Poll::Pending
    end
  end
end

pub def yield_now() -> YieldNow
  YieldNow { yielded: false }
end

# ———————————————————————————————————————————————————————————————
# Async Channel (MPSC)
# ———————————————————————————————————————————————————————————————

struct ChannelInner[T]
  buffer: VecDeque[T]
  capacity: UInt
  closed: AtomicBool
  send_waiters: Vec[Waker]
  recv_waiters: Vec[Waker]
end

# The channel's shared state lives in a heap allocation owned by an Arc
# (std::sync's refcounted allocation — the same pattern the sync channel
# uses). Sender, Receiver, and the SendFuture/RecvFuture the send/recv
# methods produce each hold their OWN Arc clone: the inner stays alive
# even if an endpoint is dropped or moved while a future is in flight.
# The refcount is the Arc's (the atomic in the control block); the old
# hand-rolled ref_count field and the Box::into_raw/Box::from_raw pair
# are gone — the raw pointer is never exposed in the safe surface.
struct Sender[T]
  inner: Arc[ChannelInner[T]]
end

struct Receiver[T]
  inner: Arc[ChannelInner[T]]
end

pub def channel[T](capacity: UInt) -> (Sender[T], Receiver[T])
  let inner = Arc::new(ChannelInner[T] {
    buffer: VecDeque[T]::new(),
    capacity: capacity,
    closed: AtomicBool::new(false),
    send_waiters: Vec[Waker]::new(),
    recv_waiters: Vec[Waker]::new()
  })

  (Sender[T] { inner: inner.clone() }, Receiver[T] { inner: inner })
end

impl Sender[T]
  def send(self, value: T) -> SendFuture[T]
    SendFuture[T] {
      inner: self.inner.clone(),
      value: Option::Some(value)
    }
  end

  def close(self) -> Unit
    if self.inner.ptr.as_ref().closed.load() then
      return
    end
    self.inner.ptr.as_ref().closed.store(true)
    loop do
      match self.inner.ptr.as_ref().recv_waiters.pop()
      when Option::Some(waker) then waker.wake()
      when Option::None then break
      end
    end
  end

  def clone(self) -> Sender[T]
    Sender[T] { inner: self.inner.clone() }
  end
end

impl Receiver[T]
  def recv(self) -> RecvFuture[T]
    RecvFuture[T] { inner: self.inner.clone() }
  end

  def try_recv(self) -> Option[T]
    let ch = self.inner.ptr.as_ref()
    match ch.buffer.pop_front()
    when Option::Some(val) then
      # Wake a sender — the buffer just made room
      if !ch.send_waiters.is_empty() then
        ch.send_waiters.pop().unwrap().wake()
      end
      Option::Some(val)
    when Option::None then
      Option::None
    end
  end

  def is_closed(self) -> Bool
    self.inner.ptr.as_ref().closed.load()
  end
end

struct SendFuture[T]
  inner: Arc[ChannelInner[T]]
  value: Option[T]
end

impl Future for SendFuture[T]
  type Output = Result[(), String]

  def poll(inout self, inout cx: Context) -> Poll[Result[(), String]]
    let ch = self.inner.ptr.as_ref()

    if ch.closed.load() then
      let closed_result: Result[(), String] = Result::Err("channel closed".to_string())
      return Poll::Ready(closed_result)
    end

    if ch.buffer.len() < ch.capacity then
      # Space available
      match self.value.take()
      when Option::Some(val) then
        ch.buffer.push_back(val)
        # Wake a receiver
        if !ch.recv_waiters.is_empty() then
          ch.recv_waiters.pop().unwrap().wake()
        end
        let sent_result: Result[(), String] = Result::Ok(())
        Poll::Ready(sent_result)
      when Option::None then
        let missing_result: Result[(), String] = Result::Err("value already sent".to_string())
        Poll::Ready(missing_result)
      end
    else
      # Buffer full, wait
      ch.send_waiters.push(cx.waker.clone())
      Poll::Pending
    end
  end
end

struct RecvFuture[T]
  inner: Arc[ChannelInner[T]]
end

impl Future for RecvFuture[T]
  type Output = Option[T]

  def poll(inout self, inout cx: Context) -> Poll[Option[T]]
    let ch = self.inner.ptr.as_ref()

    match ch.buffer.pop_front()
    when Option::Some(val) then
      # Wake a sender
      if !ch.send_waiters.is_empty() then
        ch.send_waiters.pop().unwrap().wake()
      end
      Poll::Ready(Option::Some(val))
    when Option::None then
      if ch.closed.load() then
        Poll::Ready(Option::None)
      else
        ch.recv_waiters.push(cx.waker.clone())
        Poll::Pending
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Select (race multiple futures)
# ———————————————————————————————————————————————————————————————

enum Either[A, B]
  Left(A)
  Right(B)
end

struct SelectFuture[A: Future, B: Future]
  a: A
  b: B
  a_done: Bool
  b_done: Bool
end

impl Future for SelectFuture[A, B]
  type Output = Either[A::Output, B::Output]
  
  def poll(inout self, inout cx: Context) -> Poll[Either[A::Output, B::Output]]
    if !self.a_done then
      match self.a.poll(cx)
      when Poll::Ready(val) then
        self.a_done = true
        let ready: Either[A::Output, B::Output] = Either::Left(val)
        return Poll::Ready(ready)
      when Poll::Pending then ()
      end
    end
    
    if !self.b_done then
      match self.b.poll(cx)
      when Poll::Ready(val) then
        self.b_done = true
        let ready: Either[A::Output, B::Output] = Either::Right(val)
        return Poll::Ready(ready)
      when Poll::Pending then ()
      end
    end
    
    Poll::Pending
  end
end

pub def select[A: Future, B: Future](a: A, b: B) -> SelectFuture[A, B]
  SelectFuture { a: a, b: b, a_done: false, b_done: false }
end

# ———————————————————————————————————————————————————————————————
# Join (run two futures concurrently, wait for both)
# ———————————————————————————————————————————————————————————————

struct JoinFuture[A: Future, B: Future]
  a: A
  b: B
  a_result: Option[A::Output]
  b_result: Option[B::Output]
end

impl Future for JoinFuture[A, B]
  type Output = (A::Output, B::Output)
  
  def poll(inout self, inout cx: Context) -> Poll[(A::Output, B::Output)]
    if self.a_result.is_none() then
      match self.a.poll(cx)
      when Poll::Ready(val) then self.a_result = Option::Some(val)
      when Poll::Pending then ()
      end
    end
    
    if self.b_result.is_none() then
      match self.b.poll(cx)
      when Poll::Ready(val) then self.b_result = Option::Some(val)
      when Poll::Pending then ()
      end
    end
    
    if self.a_result.is_some() && self.b_result.is_some() then
      Poll::Ready((self.a_result.take().unwrap(), self.b_result.take().unwrap()))
    else
      Poll::Pending
    end
  end
end

pub def join[A: Future, B: Future](a: A, b: B) -> JoinFuture[A, B]
  JoinFuture {
    a: a, b: b,
    a_result: Option::None,
    b_result: Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# std::io Integration (reactor-backed readiness + I/O futures)
# ———————————————————————————————————————————————————————————————

trait ReactorFd
  def reactor_fd(self: Self) -> Int
end

impl ReactorFd for TcpStream
  def reactor_fd(self: Self) -> Int
    self.raw_fd()
  end
end

# Test fault-injection: when set, the async I/O futures report ONE stale
# readiness (the deterministic stand-in for a racing consumer that drained
# the data between the readiness event and the operation). The first
# ready-branch then runs the EAGAIN re-registration path and the flag
# self-clears (one-shot). Mirrors std::thread's __tg_spawn_fail_create
# fault-injection precedent.
mut __tg_async_force_eagain: Bool = false

# The I/O futures OWN their I/O value (and buffer): wait_readable takes
# the sink T — the value moves into the future, and the poll reads the
# owned value's fd. The old PtrMut fields pointed into the caller's
# inout-arg storage — the raw pointers escaped the caller's scope and
# dangled the moment the args moved. Each future stores the REGISTRATION
# TOKEN its registration returned; the poll inspects the token's
# readiness (not-ready -> Pending — a poll for an unrelated reason never
# completes the future; ready -> consume the event — deregister/modify —
# then perform the operation; a vanished token — the fd was closed and
# reused, or the registration was cancelled — re-registers fresh, and a
# closed fd fails the kernel ADD with the error propagated).
struct WaitReadableFuture[T: ReactorFd]
  io: T
  registration: Option[RegistrationId]
end

impl Future for WaitReadableFuture[T]
  type Output = Result[Unit, String]

  def poll(inout self, inout cx: Context) -> Poll[Result[Unit, String]]
    let fd = self.io.reactor_fd()
    unsafe "executor inner access — the waker's Arc clone keeps the executor alive" do
      let exec = cx.waker.executor.ptr.as_mut()
      match self.registration
      when Option::None then
        match exec.register_io(fd, cx.waker.task_id, Interest::Readable)
        when Result::Ok(rid) then
          self.registration = Option::Some(rid)
          Poll::Pending
        when Result::Err(err) then
          let reg_error: Result[Unit, String] = Result::Err(err)
          Poll::Ready(reg_error)
        end
      when Option::Some(rid) then
        match exec.io_status(rid)
        when RegistrationStatus::NotRegistered then
          self.registration = Option::None
          let lost_error: Result[Unit, String] = Result::Err("I/O registration lost — the file descriptor was closed or replaced".to_string())
          Poll::Ready(lost_error)
        when RegistrationStatus::Pending then
          Poll::Pending
        when RegistrationStatus::Ready then
          # consume the readiness: deregister, then the operation (the
          # readability is confirmed — nothing to read here)
          exec.deregister_io(rid)
          self.registration = Option::None
          let read_ready: Result[Unit, String] = Result::Ok(())
          Poll::Ready(read_ready)
        end
      end
    end
  end
end

struct WaitWritableFuture[T: ReactorFd]
  io: T
  registration: Option[RegistrationId]
end

impl Future for WaitWritableFuture[T]
  type Output = Result[Unit, String]

  def poll(inout self, inout cx: Context) -> Poll[Result[Unit, String]]
    let fd = self.io.reactor_fd()
    unsafe "executor inner access — the waker's Arc clone keeps the executor alive" do
      let exec = cx.waker.executor.ptr.as_mut()
      match self.registration
      when Option::None then
        match exec.register_io(fd, cx.waker.task_id, Interest::Writable)
        when Result::Ok(rid) then
          self.registration = Option::Some(rid)
          Poll::Pending
        when Result::Err(err) then
          let reg_error: Result[Unit, String] = Result::Err(err)
          Poll::Ready(reg_error)
        end
      when Option::Some(rid) then
        match exec.io_status(rid)
        when RegistrationStatus::NotRegistered then
          self.registration = Option::None
          let lost_error: Result[Unit, String] = Result::Err("I/O registration lost — the file descriptor was closed or replaced".to_string())
          Poll::Ready(lost_error)
        when RegistrationStatus::Pending then
          Poll::Pending
        when RegistrationStatus::Ready then
          exec.deregister_io(rid)
          self.registration = Option::None
          let write_ready: Result[Unit, String] = Result::Ok(())
          Poll::Ready(write_ready)
        end
      end
    end
  end
end

# AsyncReadFuture owns the io value AND the buffer: read_async takes both
# by sink — the poll reads into the owned buffer through the owned value.
# (The registration logic is inlined so the io is owned ONCE — a nested
# wait future would need a second copy of the io.)
struct AsyncReadFuture[T: Read + ReactorFd]
  io: T
  buf: Vec[u8]
  registration: Option[RegistrationId]
end

impl Future for AsyncReadFuture[T]
  type Output = Result[Int, IOError]

  def poll(inout self, inout cx: Context) -> Poll[Result[Int, IOError]]
    let fd = self.io.reactor_fd()
    unsafe "executor inner access — the waker's Arc clone keeps the executor alive" do
      let exec = cx.waker.executor.ptr.as_mut()
      match self.registration
      when Option::None then
        match exec.register_io(fd, cx.waker.task_id, Interest::Readable)
        when Result::Ok(rid) then
          self.registration = Option::Some(rid)
          Poll::Pending
        when Result::Err(err) then
          Poll::Ready(Result::Err(IOError::Other(err)))
        end
      when Option::Some(rid) then
        match exec.io_status(rid)
        when RegistrationStatus::NotRegistered then
          self.registration = Option::None
          let lost: Result[Int, IOError] = Result::Err(IOError::Other("I/O registration lost — the file descriptor was closed or replaced".to_string()))
          Poll::Ready(lost)
        when RegistrationStatus::Pending then
          Poll::Pending
        when RegistrationStatus::Ready then
          # consume the readiness: deregister, then the operation
          exec.deregister_io(rid)
          self.registration = Option::None
          let mut injected = false
          if __tg_async_force_eagain then
            __tg_async_force_eagain = false
            injected = true
          else
            match self.io.read(self.buf.as_mut_slice())
            when Result::Ok(n) then
              return Poll::Ready(Result::Ok(n))
            when Result::Err(e) then
              if errno_is_eagain() then
                # stale readiness (a racing consumer drained the data):
                # re-register and keep waiting — the next readiness
                # re-attempts the operation.
                injected = true
              else
                return Poll::Ready(Result::Err(e))
              end
            end
          end
          if injected then
            match exec.register_io(fd, cx.waker.task_id, Interest::Readable)
            when Result::Ok(rid2) then
              self.registration = Option::Some(rid2)
              Poll::Pending
            when Result::Err(e2) then
              Poll::Ready(Result::Err(IOError::Other(e2)))
            end
          else
            Poll::Pending
          end
        end
      end
    end
  end
end

# AsyncWriteFuture owns the io value AND the buffer. The write attempts a
# CLONE of the buffer (the trait write takes the Vec by value), so an
# EAGAIN stale-readiness re-registration never loses the pending payload.
struct AsyncWriteFuture[T: Write + ReactorFd]
  io: T
  buf: Vec[u8]
  registration: Option[RegistrationId]
end

impl Future for AsyncWriteFuture[T]
  type Output = Result[Int, IOError]

  def poll(inout self, inout cx: Context) -> Poll[Result[Int, IOError]]
    let fd = self.io.reactor_fd()
    unsafe "executor inner access — the waker's Arc clone keeps the executor alive" do
      let exec = cx.waker.executor.ptr.as_mut()
      match self.registration
      when Option::None then
        match exec.register_io(fd, cx.waker.task_id, Interest::Writable)
        when Result::Ok(rid) then
          self.registration = Option::Some(rid)
          Poll::Pending
        when Result::Err(err) then
          Poll::Ready(Result::Err(IOError::Other(err)))
        end
      when Option::Some(rid) then
        match exec.io_status(rid)
        when RegistrationStatus::NotRegistered then
          self.registration = Option::None
          let lost: Result[Int, IOError] = Result::Err(IOError::Other("I/O registration lost — the file descriptor was closed or replaced".to_string()))
          Poll::Ready(lost)
        when RegistrationStatus::Pending then
          Poll::Pending
        when RegistrationStatus::Ready then
          exec.deregister_io(rid)
          self.registration = Option::None
          let mut injected = false
          if __tg_async_force_eagain then
            __tg_async_force_eagain = false
            injected = true
          else
            match self.io.write(self.buf.clone())
            when Result::Ok(n) then
              return Poll::Ready(Result::Ok(n))
            when Result::Err(e) then
              if errno_is_eagain() then
                injected = true
              else
                return Poll::Ready(Result::Err(e))
              end
            end
          end
          if injected then
            match exec.register_io(fd, cx.waker.task_id, Interest::Writable)
            when Result::Ok(rid2) then
              self.registration = Option::Some(rid2)
              Poll::Pending
            when Result::Err(e2) then
              Poll::Ready(Result::Err(IOError::Other(e2)))
            end
          else
            Poll::Pending
          end
        end
      end
    end
  end
end

pub def wait_readable[T: ReactorFd](sink io: T) -> WaitReadableFuture[T]
  WaitReadableFuture {
    io: io,
    registration: Option::None
  }
end

pub def wait_writable[T: ReactorFd](sink io: T) -> WaitWritableFuture[T]
  WaitWritableFuture {
    io: io,
    registration: Option::None
  }
end

pub def read_async[T: Read + ReactorFd](sink io: T, sink buf: Vec[u8]) -> AsyncReadFuture[T]
  AsyncReadFuture {
    io: io,
    buf: buf,
    registration: Option::None
  }
end

pub def write_async[T: Write + ReactorFd](sink io: T, buf: Vec[u8]) -> AsyncWriteFuture[T]
  AsyncWriteFuture {
    io: io,
    buf: buf,
    registration: Option::None
  }
end

# ———————————————————————————————————————————————————————————————
# Public Entrypoints
# ———————————————————————————————————————————————————————————————

# Global executor (thread-local in multi-threaded contexts). The Arc
# keeps the inner alive for the whole block_on run; the entry is reset at
# the end so the last clone releases the executor.
@thread_local
static mut GLOBAL_EXECUTOR: Option[Arc[ExecutorInner]] = Option::None

pub def block_on[F: Future](future: F) -> F::Output
  mut exec = executor_new()

  GLOBAL_EXECUTOR = Option::Some(exec.inner.clone())

  mut result: Option[F::Output] = Option::None
  let result_ptr = address_of_mut(&mut result) as PtrMut[Option[F::Output]]

  exec.spawn(async {
    let val = future.await
    unsafe "block_on result slot — the block_on frame outlives the run loop" do
      *result_ptr = Option::Some(val)
    end
  })

  exec.run()

  GLOBAL_EXECUTOR = Option::None

  match result
  when Option::Some(val) then val
  when Option::None then panic("block_on: future did not complete")
  end
end

pub def spawn(future: impl Future[Output = ()]) -> JoinHandle[()]
  match GLOBAL_EXECUTOR.clone()
  when Option::Some(exec_inner) then
    let exec = Executor { inner: exec_inner }
    exec.spawn(future)
  when Option::None then
    panic("spawn called outside of async runtime — use block_on() first")
  end
end

# Cancel a task on the block_on global executor by id — the counterpart
# of spawn. The cancellation routes through the executor's cancel_task
# and the shared finish_task terminal path (the pending join waiter is
# woken; the join completes with "task cancelled").
pub def cancel_task(task_id: UInt) -> Bool
  match GLOBAL_EXECUTOR.clone()
  when Option::Some(exec_inner) then
    let exec = Executor { inner: exec_inner }
    exec.cancel_task(task_id)
  when Option::None then
    false
  end
end

# ———————————————————————————————————————————————————————————————
# Platform Sleep (FFI)
# ———————————————————————————————————————————————————————————————

extern "C"
  def usleep(usec: UInt) -> i32
end

def sleep_ms(ms: UInt) -> Unit
  if ms > 0 then
    let _ = usleep(ms * 1000)
  end
end

# ———————————————————————————————————————————————————————————————
# Async Mutex (for shared state in async code)
# ———————————————————————————————————————————————————————————————
# The lock state (the atomic flag + the waiter queue) lives in a heap
# allocation owned by an Arc (the real allocator, std::sync).
# AsyncMutex::lock clones the Arc into the LockFuture, and the future
# clones it again into the guard on acquisition — the lock state stays
# alive even if the AsyncMutex is dropped or moved while the future or
# the guard lives. Acquisition is an atomic swap on the inner's
# AtomicBool; a CONTENDED poll enqueues its waker ONCE (the registered
# waker — repeated polls never append duplicates) and returns Pending.
# The guard's Drop releases the lock with an atomic store and then wakes
# the OLDEST waiter (the FIFO queue pop) — the woken waiter's next poll
# re-tries the swap and acquires. A waiter that leaves the queue without
# acquiring (the LockFuture's Drop — e.g. its task is cancelled) removes
# its own entry, so the guard's Drop wakes the NEXT waiter. The deinit
# plan drops the guard's/future's Arc clone (the last clone releases the
# allocation).
struct AsyncMutex[T]
  inner: Arc[AsyncMutexInner[T]]
end

struct AsyncMutexInner[T]
  locked: AtomicBool
  value: T
  waiters: Vec[Waker]
end

pub def async_mutex_new[T](value: T) -> AsyncMutex[T]
  AsyncMutex {
    inner: Arc::new(AsyncMutexInner {
      locked: AtomicBool::new(false),
      value: value,
      waiters: Vec::new()
    })
  }
end

# Guard returned by the LockFuture that releases the lock on drop.
# The guard holds its own Arc clone of the inner state.
struct AsyncMutexGuard[T]
  inner: Arc[AsyncMutexInner[T]]
end

# The future holds an Arc clone of the inner — the mutex can drop while
# the future (or the guard it produces) lives. The stored waker is the
# waiter's registered entry: enqueued once on the first contended poll,
# cleared on acquisition, and used by Drop to remove the entry when the
# waiter leaves the queue without acquiring.
struct LockFuture[T]
  inner: Arc[AsyncMutexInner[T]]
  waker: Option[Waker]
end

impl Future for LockFuture[T]
  type Output = AsyncMutexGuard[T]
  
  def poll(inout self, inout cx: Context) -> Poll[AsyncMutexGuard[T]]
    if self.inner.ptr.as_ref().locked.swap(true) then
      # Lock is held — enqueue the waker ONCE (the registered flag; a
      # repeated poll re-tries the swap without appending a duplicate)
      # and return Pending: the guard's Drop wakes the OLDEST waiter
      # when the lock frees.
      if self.waker.is_none() then
        let waiter = cx.waker.clone()
        self.inner.ptr.as_ref().waiters.push(waiter.clone())
        self.waker = Option::Some(waiter)
      end
      Poll::Pending
    else
      self.waker = Option::None
      Poll::Ready(AsyncMutexGuard { inner: self.inner.clone() })
    end
  end
end

impl Drop for LockFuture[T]
  def drop(inout self) -> Unit
    # The waiter left the queue without acquiring: remove its own entry
    # (the task_id match — one waiter per task) so the guard's Drop
    # wakes the NEXT waiter (the queue stays FIFO).
    match self.waker
    when Option::Some(waiter) then
      let inner = self.inner.ptr.as_ref()
      let mut i = 0
      let n = inner.waiters.len()
      while i < n do
        if inner.waiters[i].task_id == waiter.task_id then
          let _ = inner.waiters.remove(i)
          break
        end
        i = i + 1
      end
    when Option::None then ()
    end
  end
end

impl AsyncMutex[T]
  def lock(self) -> LockFuture[T]
    LockFuture { inner: self.inner.clone() }
  end
end

impl AsyncMutexGuard[T]
  def get(self) -> Ptr[T]
    # The value access goes through the Arc the guard keeps alive — the
    # inner's value lives in the Arc's allocation.
    address_of(&mut self.inner.ptr.as_ref().value) as Ptr[T]
  end
  
  def get_mut(inout self) -> PtrMut[T]
    # The unconditional PtrMut through the Arc is intentional HERE: the
    # guard holds the lock (no other task can touch the inner
    # concurrently) — uniqueness comes from the LOCK PROTOCOL, not the
    # refcount (the guard's Arc clone is never unique: the mutex itself
    # holds a second clone, so Arc::get_mut would always be None). This
    # raw path is the explicitly-unsafe primitive the Arc surface no
    # longer exposes unconditionally.
    unsafe "lock-exclusive raw access — the guard holds the lock" do
      address_of_mut(&mut (*self.inner.ptr).value)
    end
  end
  
  def deref(self) -> Ptr[T]
    self.get()
  end
  
  def deref_mut(inout self) -> PtrMut[T]
    self.get_mut()
  end
end

impl Drop for AsyncMutexGuard[T]
  def drop(inout self) -> Unit
    # Release the lock (the atomic store), then wake the OLDEST waiter
    # (the FIFO queue pop) — the woken waiter's next poll re-tries the
    # swap and acquires. The guard's Arc clone is then dropped by the
    # deinit plan — the inner allocation stays alive as long as ANY Arc
    # clone (the mutex's, a future's, or a guard's) still references it.
    let inner = self.inner.ptr.as_ref()
    inner.locked.store(false)
    if !inner.waiters.is_empty() then
      let waiter = inner.waiters.remove(0)
      waiter.wake()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Structured Concurrency — Task Scopes (Nurseries)
# ———————————————————————————————————————————————————————————————

## A TaskScope ensures all spawned child tasks reach a terminal state
## (complete or cancel) before the scope exits. Inspired by Trio nurseries
## / JEP 453.
##
## THE TYPED CHILD HANDLES: the scope tracks Vec[ScopedTaskHandle] — the
## JoinHandle-class children carrying the child's task id and an Arc clone
## of the executor. join_all is an ASYNC function: it AWAITS each child's
## handle, so the executor's cooperative scheduling advances the children
## between the join_all task's polls — the old synchronous spin (a
## deadlock in the cooperative runtime: the executor could never make
## progress while the scope's caller burned the CPU) is gone. The child's
## TERMINAL RESULT propagates through the handle: Ok when the child
## completed, Err when it was cancelled.
##
## THE ERROR STRATEGIES: CancelAll (default) cancels the remaining
## children after the first failure; CollectErrors waits for every child
## and aggregates the error list; IgnoreErrors waits but suppresses the
## child errors. In every strategy the scope exit returns only when every
## child has reached a terminal state.
struct TaskScope
  tasks: Vec[ScopedTaskHandle]
  cancellation: CancellationToken
  error_strategy: ScopeErrorStrategy
end

## How the scope handles a child task failure
enum ScopeErrorStrategy
  CancelAll         ## Cancel all remaining tasks on first error (default)
  CollectErrors     ## Let all tasks finish, collect all errors
  IgnoreErrors      ## Ignore child errors, scope succeeds if body succeeds
end

# The cancellation state lives in a heap allocation owned by an Arc (the
# same heap-stable shape the channel/AsyncMutex/AsyncSemaphore use):
# clones share the same state, and the token stays alive while any clone
# references it.
#
# THE CANCELLATION TREE: a token's children (registered by child()) form
# a parent->descendant tree. cancel() sets the ATOMIC cancelled flag
# (idempotent: a second cancel observes the flag and returns) and then
# propagates to every registered descendant under the children
# synchronization. A child's cancel NEVER cancels its parent (the parent
# is not in the child's children list).
#
# THE CONCURRENT-REGISTRATION RACE: child() takes the children lock FIRST
# and checks the cancelled flag UNDER THE SAME LOCK the cancel uses to
# detach-and-propagate. A registration that linearizes after the cancel's
# flag swap therefore observes the flag at registration (the child is
# created ALREADY cancelled); a registration that linearizes before the
# swap is detached and cancelled by the propagation. Either interleaving:
# a child registered during the parent's cancellation observes the
# cancelled state — no lost cancellation.
struct CancellationState
  cancelled: AtomicBool
  children: Mutex[Vec[Arc[CancellationState]]]
end

struct CancellationToken
  inner: Arc[CancellationState]
end

def cancellation_token_new() -> CancellationToken
  CancellationToken {
    inner: Arc::new(CancellationState {
      cancelled: AtomicBool::new(false),
      children: Mutex::new(Vec::new())
    })
  }
end

# The cancel core: the idempotent flag swap, then the synchronized
# detach-and-propagate. The detach happens under the children lock; the
# per-child recursion runs AFTER the lock is released (no lock nesting —
# the tree's propagation can never deadlock).
def cancellation_state_cancel(state: Arc[CancellationState]) -> Unit
  let inner = state.ptr.as_ref()
  if inner.cancelled.swap(true) then
    return
  end
  let mut guard = inner.children.lock()
  let mut cohort: Vec[Arc[CancellationState]] = Vec::new()
  while guard.len() > 0 do
    cohort.push(guard.remove(0))
  end
  drop(guard)
  while cohort.len() > 0 do
    cancellation_state_cancel(cohort.remove(0))
  end
end

impl CancellationToken
  def cancel(self: CancellationToken) -> Unit
    cancellation_state_cancel(self.inner.clone())
  end

  def is_cancelled(self: CancellationToken) -> Bool
    self.inner.ptr.as_ref().cancelled.load()
  end

  # Register a descendant: the children lock brackets the cancelled-flag
  # check and the registration push (see the race note above — a child
  # registered during the parent's cancellation always observes the
  # cancelled state).
  def child(self: CancellationToken) -> CancellationToken
    let c = cancellation_token_new()
    let inner = self.inner.ptr.as_ref()
    let c_inner = c.inner.ptr.as_ref()
    let mut guard = inner.children.lock()
    if inner.cancelled.load() then
      c_inner.cancelled.store(true)
    end
    guard.push(c.inner.clone())
    c
  end

  # A clone observes the SAME state: the Arc clone shares the atomic flag
  # and the children list.
  def clone(self: CancellationToken) -> CancellationToken
    CancellationToken { inner: self.inner.clone() }
  end
end

def task_scope_new() -> TaskScope
  TaskScope {
    tasks: Vec::new(),
    cancellation: cancellation_token_new(),
    error_strategy: ScopeErrorStrategy::CancelAll,
  }
end

impl TaskScope
  def with_error_strategy(inout self: TaskScope, strategy: ScopeErrorStrategy) -> Unit
    self.error_strategy = strategy
  end

  ## Spawn a task within this scope. The task is registered with the
  ## CURRENT executor (the same registration the free spawn uses) and its
  ## typed handle (the task id + the executor Arc clone) is tracked — the
  ## task must reach a terminal state before the scope exits. The scoped
  ## futures are the ()-output form (the executor's task_results key the
  ## completion by the task id).
  def spawn(inout self: TaskScope, future: impl Future[Output = ()]) -> ScopedTaskHandle
    let handle = spawn(future)
    let scoped_handle = ScopedTaskHandle {
      task_id: handle.task_id,
      executor: handle.executor.clone()
    }
    self.tasks.push(scoped_handle)
    scoped_handle
  end

  ## Wait for all children to reach a terminal state — the ASYNC join:
  ## awaiting each child's handle yields the executor's cooperative
  ## scheduling (the children advance between this future's polls); the
  ## old synchronous spin on the executor's result map is gone (it could
  ## never make progress — a deadlock in the cooperative runtime).
  ##
  ## CancelAll: on the first failure, the scope's cancellation fires (it
  ## propagates to descendant tokens) and the remaining children are
  ## cancelled; every remaining handle still resolves (terminal state
  ## Cancelled), so the exit waits for every child. CollectErrors: every
  ## child awaited, all errors aggregated. IgnoreErrors: every child
  ## awaited, child errors suppressed.
  async def join_all(inout self: TaskScope) -> Result[Unit, Vec[String]]
    let mut errors = Vec::new()
    match self.error_strategy
    when ScopeErrorStrategy::CancelAll then
      var first_error: Option[String] = Option::None
      while self.tasks.len() > 0 do
        let handle = self.tasks.remove(0)
        match handle.await
        when Result::Ok(()) then ()
        when Result::Err(e) then
          if first_error.is_none() then
            first_error = Option::Some(e)
            # the first failure: fire the scope's cancellation (it
            # propagates to the descendants) and cancel the remaining
            # children — cancel() iterates exactly the not-yet-awaited
            # handles.
            self.cancel()
          end
        end
      end
      match first_error
      when Option::Some(e) then errors.push(e)
      when Option::None then ()
      end
    when ScopeErrorStrategy::CollectErrors then
      while self.tasks.len() > 0 do
        let handle = self.tasks.remove(0)
        match handle.await
        when Result::Ok(()) then ()
        when Result::Err(e) then errors.push(e)
        end
      end
    when ScopeErrorStrategy::IgnoreErrors then
      while self.tasks.len() > 0 do
        let handle = self.tasks.remove(0)
        let _ = handle.await
      end
    end
    if errors.is_empty() then
      Result::Ok(())
    else
      Result::Err(errors)
    end
  end

  ## Cancel this scope: the cancellation token fires (propagating to the
  ## descendant tokens) and every tracked child task is cancelled through
  ## the executor — each cancelled child reaches the terminal state
  ## Cancelled, and a join_all awaiting it is woken and observes the
  ## cancellation.
  def cancel(inout self: TaskScope) -> Unit
    self.cancellation.cancel()
    if self.tasks.len() > 0 then
      let mut exec = Executor { inner: self.tasks[0].executor.clone() }
      var j = 0
      while j < self.tasks.len() do
        let _ = exec.cancel_task(self.tasks[j].task_id)
        j = j + 1
      end
    end
  end
end

## Convenience: run a scoped block of async work.
## All tasks spawned within the closure reach a terminal state
## before this function returns.
async def scoped[T, F: FnOnce(inout TaskScope) -> T](body: F) -> Result[T, Vec[String]]
  let mut scope = task_scope_new()
  let result = body(&mut scope)
  scope.join_all().await?
  Result::Ok(result)
end

# ———————————————————————————————————————————————————————————————
# Async Streams (AsyncIterator)
# ———————————————————————————————————————————————————————————————

trait AsyncIterator
  type Item

  ## Returns Poll::Ready(Some(item)) for next item,
  ## Poll::Ready(None) when exhausted, or Poll::Pending.
  def poll_next(inout self: Self, inout cx: Context) -> Poll[Option[Self::Item]]
end

## Adapter: collect all items from an async stream
async def collect_stream[S: AsyncIterator](inout stream: S) -> Vec[S::Item]
  let mut items = Vec::new()
  loop do
    match stream.next().await
    when Option::Some(item) then items.push(item)
    when Option::None then break
    end
  end
  items
end

## Map adapter for async streams
struct MapStream[S: AsyncIterator, F]
  inner: S
  f: F
end

impl[S: AsyncIterator, F: Fn(S::Item) -> U, U] AsyncIterator for MapStream[S, F]
  type Item = U
  def poll_next(inout self: MapStream[S, F], inout cx: Context) -> Poll[Option[U]]
    match self.inner.poll_next(cx)
    when Poll::Ready(Option::Some(item)) then Poll::Ready(Option::Some((self.f)(item)))
    when Poll::Ready(Option::None) then Poll::Ready(Option::None)
    when Poll::Pending then Poll::Pending
    end
  end
end

## Filter adapter for async streams
struct FilterStream[S: AsyncIterator, F]
  inner: S
  predicate: F
end

impl[S: AsyncIterator, F: Fn(inout S::Item) -> Bool] AsyncIterator for FilterStream[S, F]
  type Item = S::Item
  def poll_next(inout self: FilterStream[S, F], inout cx: Context) -> Poll[Option[S::Item]]
    loop do
      match self.inner.poll_next(cx)
      when Poll::Ready(Option::Some(item)) then
        if (self.predicate)(&item) then
          return Poll::Ready(Option::Some(item))
        end
      when Poll::Ready(Option::None) then return Poll::Ready(Option::None)
      when Poll::Pending then return Poll::Pending
      end
    end
  end
end

## Take adapter
struct TakeStream[S: AsyncIterator]
  inner: S
  remaining: UInt
end

impl[S: AsyncIterator] AsyncIterator for TakeStream[S]
  type Item = S::Item
  def poll_next(inout self: TakeStream[S], inout cx: Context) -> Poll[Option[S::Item]]
    if self.remaining == 0 then
      return Poll::Ready(Option::None)
    end
    match self.inner.poll_next(cx)
    when Poll::Ready(Option::Some(item)) then
      self.remaining = self.remaining - 1
      Poll::Ready(Option::Some(item))
    when other then other
    end
  end
end

## Channel-backed async stream
struct ChannelStream[T]
  receiver: Receiver[T]
end

impl[T] AsyncIterator for ChannelStream[T]
  type Item = T
  def poll_next(inout self: ChannelStream[T], inout cx: Context) -> Poll[Option[T]]
    match self.receiver.try_recv()
    when Option::Some(item) then Poll::Ready(Option::Some(item))
    when Option::None then
      if self.receiver.is_closed() then
        Poll::Ready(Option::None)
      else
        Poll::Pending
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Retry with Backoff
# ———————————————————————————————————————————————————————————————

struct RetryConfig
  max_attempts: UInt
  initial_delay_ms: UInt
  max_delay_ms: UInt
  backoff_factor: Float
  jitter: Bool
end

def retry_config_default() -> RetryConfig
  RetryConfig {
    max_attempts: 3,
    initial_delay_ms: 100,
    max_delay_ms: 30000,
    backoff_factor: 2.0,
    jitter: true,
  }
end

## Retry an async operation with exponential backoff.
async def retry[T, E, F: FnMut() -> impl Future[Output = Result[T, E]]](
  config: RetryConfig,
  inout operation: F
) -> Result[T, E]
  let mut delay_ms = config.initial_delay_ms
  let mut last_err: Option[E] = Option::None

  for attempt in 0..config.max_attempts do
    match operation().await
    when Result::Ok(val) then return Result::Ok(val)
    when Result::Err(e) then
      last_err = Option::Some(e)
      if attempt + 1 < config.max_attempts then
        sleep(Duration::from_millis(delay_ms as u64)).await
        delay_ms = min_uint(
          (delay_ms as Float * config.backoff_factor) as UInt,
          config.max_delay_ms
        )
      end
    end
  end

  Result::Err(last_err.unwrap())
end

def min_uint(a: UInt, b: UInt) -> UInt
  if a < b then a else b end
end

# ———————————————————————————————————————————————————————————————
# Circuit Breaker
# ———————————————————————————————————————————————————————————————

enum CircuitState
  Closed       ## Normal operation
  Open         ## Failing, reject calls
  HalfOpen     ## Testing if service recovered
end

struct CircuitBreaker
  state: CircuitState
  failure_count: UInt
  success_count: UInt
  failure_threshold: UInt
  success_threshold: UInt  ## Successes needed in HalfOpen to close
  timeout_ms: UInt         ## Time to wait before HalfOpen
  last_failure_time: UInt  ## Timestamp of last failure
end

def circuit_breaker_new(failure_threshold: UInt, success_threshold: UInt, timeout_ms: UInt) -> CircuitBreaker
  CircuitBreaker {
    state: CircuitState::Closed,
    failure_count: 0,
    success_count: 0,
    failure_threshold: failure_threshold,
    success_threshold: success_threshold,
    timeout_ms: timeout_ms,
    last_failure_time: 0,
  }
end

enum CircuitBreakerError[E]
  CircuitOpen
  Inner(E)
end

impl CircuitBreaker
  def allow_request(inout self: CircuitBreaker, now_ms: UInt) -> Bool
    match self.state
    when CircuitState::Closed then true
    when CircuitState::Open then
      if now_ms - self.last_failure_time >= self.timeout_ms then
        self.state = CircuitState::HalfOpen
        self.success_count = 0
        true
      else
        false
      end
    when CircuitState::HalfOpen then true
    end
  end

  def record_success(inout self: CircuitBreaker) -> Unit
    match self.state
    when CircuitState::HalfOpen then
      self.success_count = self.success_count + 1
      if self.success_count >= self.success_threshold then
        self.state = CircuitState::Closed
        self.failure_count = 0
      end
    when CircuitState::Closed then
      self.failure_count = 0  ## Reset consecutive failures
    when _ then ()
    end
  end

  def record_failure(inout self: CircuitBreaker, now_ms: UInt) -> Unit
    self.last_failure_time = now_ms
    match self.state
    when CircuitState::Closed then
      self.failure_count = self.failure_count + 1
      if self.failure_count >= self.failure_threshold then
        self.state = CircuitState::Open
      end
    when CircuitState::HalfOpen then
      self.state = CircuitState::Open
    when _ then ()
    end
  end

  def state(self: CircuitBreaker) -> CircuitState
    self.state
  end

  def reset(inout self: CircuitBreaker) -> Unit
    self.state = CircuitState::Closed
    self.failure_count = 0
    self.success_count = 0
  end
end

# ———————————————————————————————————————————————————————————————
# Async Semaphore
# ———————————————————————————————————————————————————————————————
# The semaphore state (the permit counter + the waiter queue) lives in a
# heap allocation owned by an Arc — the same heap-stable shared-state
# shape the AsyncMutex uses. AcquireFuture and SemaphorePermit each hold
# their OWN Arc clone: the semaphore can be dropped or moved while a
# future or a permit lives. Acquisition and release go through the inner's
# atomic counter (a CAS loop on acquire — the counter is the authority, so
# a contended re-poll re-tries the CAS instead of double-decrementing; an
# atomic fetch-add on release). The waiter queue is mutated only from the
# executor thread (the module's cooperative single-threaded runtime), the
# same discipline the AsyncMutex's value access relies on.
struct AsyncSemaphore
  inner: Arc[AsyncSemaphoreInner]
end

struct AsyncSemaphoreInner
  counter: AtomicInt
  max_permits: UInt
  waiters: VecDeque[Waker]
end

def async_semaphore_new(permits: UInt) -> AsyncSemaphore
  AsyncSemaphore {
    inner: Arc::new(AsyncSemaphoreInner {
      counter: AtomicInt::new(permits as Int),
      max_permits: permits,
      waiters: VecDeque::new()
    })
  }
end

def AsyncSemaphore::new(permits: UInt) -> AsyncSemaphore
  async_semaphore_new(permits)
end

struct AcquireFuture
  inner: Arc[AsyncSemaphoreInner]
end

impl Future for AcquireFuture
  type Output = SemaphorePermit
  def poll(inout self, inout cx: Context) -> Poll[SemaphorePermit]
    loop do
      let current = self.inner.ptr.as_ref().counter.load(Ordering::Acquire)
      if current > 0 then
        mut expected = current
        if self.inner.ptr.as_ref().counter.compare_exchange(&mut expected, current - 1, Ordering::AcqRel, Ordering::Acquire) then
          return Poll::Ready(SemaphorePermit { inner: self.inner.clone() })
        end
      else
        # No permit — queue this task's waker (the executor re-polls us
        # once a permit release wakes the queue; a re-poll while still
        # starved enqueues again, and the id-based wakeups make stale
        # entries no-ops in the executor).
        self.inner.ptr.as_ref().waiters.push_back(cx.waker.clone())
        return Poll::Pending
      end
    end
  end
end

struct SemaphorePermit
  inner: Arc[AsyncSemaphoreInner]
end

impl Drop for SemaphorePermit
  def drop(inout self) -> Unit
    # Release the permit (the atomic increment) and wake the oldest waiter.
    self.inner.ptr.as_ref().counter.fetch_add(1, Ordering::Release)
    match self.inner.ptr.as_ref().waiters.pop_front()
    when Option::Some(waker) then waker.wake()
    when Option::None then ()
    end
  end
end

impl AsyncSemaphore
  def acquire(inout self) -> AcquireFuture
    AcquireFuture { inner: self.inner.clone() }
  end

  def try_acquire(inout self) -> Option[SemaphorePermit]
    let current = self.inner.ptr.as_ref().counter.load(Ordering::Acquire)
    if current > 0 then
      mut expected = current
      if self.inner.ptr.as_ref().counter.compare_exchange(&mut expected, current - 1, Ordering::AcqRel, Ordering::Acquire) then
        return Option::Some(SemaphorePermit { inner: self.inner.clone() })
      end
    end
    Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Transferable / Shareable — NO marker impls (concurrency properties)
# ———————————————————————————————————————————————————————————————
# The manual Transferable/Shareable impls are DELETED: the compiler
# derives the properties structurally (tg_compiler/types.tg — the single
# authority). Sender/Receiver/AsyncMutex/AsyncSemaphore/AcquireFuture/
# SemaphorePermit are all Arc-wrapped (the recognized synchronized
# representation), so the derivation answers Transferable + Shareable
# through the Arc layer.

