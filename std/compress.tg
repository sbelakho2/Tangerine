# Tangerine Standard Library — Compression & Archives
#
# Compression algorithms and archive formats.
#
# Usage:
#   let compressed = gzip::compress(data)?
#   let decompressed = gzip::decompress(compressed)?
#   
#   let archive = TarBuilder::new("archive.tar.gz")?
#   archive.add_file("file.txt", content)?
#   archive.finish()?

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{fixed_array_mut_view}
use std::io::{Read, Write, BufReader, BufWriter}
use std::fs::{File, Path}

# ═══════════════════════════════════════════════════════════════
# PART 1: ZLIB / DEFLATE
# ═══════════════════════════════════════════════════════════════

# FFI bindings for zlib
extern "C"
  def compress(dest: PtrMut[u8], destLen: PtrMut[UInt], source: Ptr[u8], sourceLen: UInt) -> i32
  def compress2(dest: PtrMut[u8], destLen: PtrMut[UInt], source: Ptr[u8], sourceLen: UInt, level: i32) -> i32
  def uncompress(dest: PtrMut[u8], destLen: PtrMut[UInt], source: Ptr[u8], sourceLen: UInt) -> i32
  def compressBound(sourceLen: UInt) -> UInt
  def deflateInit_(strm: PtrMut[ZStream], level: i32, version: Ptr[u8], stream_size: i32) -> i32
  def deflate(strm: PtrMut[ZStream], flush: i32) -> i32
  def deflateEnd(strm: PtrMut[ZStream]) -> i32
  def inflateInit_(strm: PtrMut[ZStream], version: Ptr[u8], stream_size: i32) -> i32
  def inflate(strm: PtrMut[ZStream], flush: i32) -> i32
  def inflateEnd(strm: PtrMut[ZStream]) -> i32
  def deflateInit2_(strm: PtrMut[ZStream], level: i32, method: i32, windowBits: i32,
                    memLevel: i32, strategy: i32, version: Ptr[u8], stream_size: i32) -> i32
  def inflateInit2_(strm: PtrMut[ZStream], windowBits: i32, version: Ptr[u8], stream_size: i32) -> i32
  def crc32(crc: u32, buf: Ptr[u8], len: u32) -> u32
  def adler32(adler: u32, buf: Ptr[u8], len: u32) -> u32
end

const Z_OK: i32 = 0
const Z_STREAM_END: i32 = 1
const Z_NEED_DICT: i32 = 2

def z_errno() -> i32
  -1
end

def z_stream_error() -> i32
  -2
end

def z_data_error() -> i32
  -3
end

def z_mem_error() -> i32
  -4
end

def z_buf_error() -> i32
  -5
end

const Z_NO_FLUSH: i32 = 0
const Z_PARTIAL_FLUSH: i32 = 1
const Z_SYNC_FLUSH: i32 = 2
const Z_FULL_FLUSH: i32 = 3
const Z_FINISH: i32 = 4

const Z_DEFLATED: i32 = 8
const Z_DEFAULT_STRATEGY: i32 = 0

const ZLIB_VERSION: String = "1.2.11"

@repr(C)
struct ZStream
  next_in: Ptr[u8]
  avail_in: u32
  total_in: UInt
  next_out: PtrMut[u8]
  avail_out: u32
  total_out: UInt
  msg: Ptr[u8]
  state: PtrMut[Unit]
  zalloc: Ptr[Unit]
  zfree: Ptr[Unit]
  opaque: PtrMut[Unit]
  data_type: i32
  adler: u32
  reserved: UInt
end

impl ZStream
  def new() -> ZStream
    ZStream {
      next_in: Ptr::null(),
      avail_in: 0,
      total_in: 0,
      next_out: Ptr::null(),
      avail_out: 0,
      total_out: 0,
      msg: Ptr::null(),
      state: Ptr::null(),
      zalloc: Ptr::null(),
      zfree: Ptr::null(),
      opaque: Ptr::null(),
      data_type: 0,
      adler: 0,
      reserved: 0
    end
  end
end

enum CompressionError
  DataError(String)
  BufferError
  MemoryError
  StreamError
  InvalidInput
  ChecksumMismatch
  UnsupportedFormat
  IoError(String)
end

def compression_error_message(e: CompressionError) -> String
  match e
  when CompressionError::DataError(s) then "data error: " + s.clone()
  when CompressionError::BufferError then "buffer error"
  when CompressionError::MemoryError then "memory error"
  when CompressionError::StreamError then "stream error"
  when CompressionError::InvalidInput then "invalid input"
  when CompressionError::ChecksumMismatch then "checksum mismatch"
  when CompressionError::UnsupportedFormat then "unsupported format"
  when CompressionError::IoError(s) then "IO error: " + s.clone()
  end
end

impl Error for CompressionError
  def message(self: CompressionError) -> String
    compression_error_message(self)
  end
end

def zlib_error_from_code(code: i32, context: str) -> CompressionError
  if code == Z_OK then
    CompressionError::StreamError
  elsif code == Z_STREAM_END then
    CompressionError::StreamError
  elsif code == Z_NEED_DICT then
    CompressionError::DataError(context.to_string() + ": dictionary required")
  elsif code == z_errno() then
    CompressionError::IoError(context.to_string() + ": zlib I/O error")
  elsif code == z_stream_error() then
    CompressionError::StreamError
  elsif code == z_data_error() then
    CompressionError::DataError(context.to_string() + ": invalid compressed data")
  elsif code == z_mem_error() then
    CompressionError::MemoryError
  elsif code == z_buf_error() then
    CompressionError::BufferError
  else
    CompressionError::DataError(context.to_string() + ": zlib error code " + code.to_string())
  end
end

enum CompressionLevel
  None
  Fast
  Default
  Best
  Custom(i32)
end

impl CompressionLevel
  def to_zlib_level(self: CompressionLevel) -> i32
    match self
    when CompressionLevel::None then 0
    when CompressionLevel::Fast then 1
    when CompressionLevel::Default then 6
    when CompressionLevel::Best then 9
    when CompressionLevel::Custom(l) then l
    end
  end
end

# ———————————————————————————————————————————————————————————————
# DEFLATE Module
# ———————————————————————————————————————————————————————————————

mod deflate
  const MAX_DECOMPRESSED_SIZE: UInt = 268435456  # 256 MiB hard cap

  def compress(data: [u8]) -> Result[Vec[u8], CompressionError]
    compress_level(data, CompressionLevel::Default)
  end
  
  def compress_level(data: [u8], level: CompressionLevel) -> Result[Vec[u8], CompressionError]
    if data.is_empty() then
      return Result::Ok(Vec::new())
    end
    
    let bound = unsafe "FFI boundary" do compressBound(data.len()) end
    let mut output: Vec[u8] = Vec::with_capacity(bound)
    output.resize(bound, 0)
    
    let mut dest_len = bound
    
    let rc = unsafe "FFI boundary" do
      compress2(
        output.as_mut_ptr() as Ptr[u8],
        (address_of_mut(&mut dest_len)),
        data.as_ptr(),
        data.len(),
        level.to_zlib_level()
      )
    end
    
    match rc
    when Z_OK then
      output.truncate(dest_len)
      Result::Ok(output)
    when _ then Result::Err(zlib_error_from_code(rc, "zlib compress2"))
    end
  end
  
  def decompress(data: [u8]) -> Result[Vec[u8], CompressionError]
    decompress_with_size(data, data.len() * 4)
  end
  
  def decompress_with_size(data: [u8], estimated_size: UInt) -> Result[Vec[u8], CompressionError]
    if data.is_empty() then
      return Result::Ok(Vec::new())
    end
    
    let mut dest_len = if estimated_size == 0 then 1 else estimated_size end
    if dest_len > MAX_DECOMPRESSED_SIZE then
      return Result::Err(CompressionError::BufferError)
    end

    let mut output: Vec[u8] = Vec::with_capacity(dest_len)
    output.resize(dest_len, 0)
    
    loop
      let rc = unsafe "FFI boundary" do
        uncompress(
          output.as_mut_ptr() as Ptr[u8],
          &mut dest_len as PtrMut[UInt],
          data.as_ptr(),
          data.len()
        )
      end
      
      match rc
      when Z_OK then
        output.truncate(dest_len)
        return Result::Ok(output)
      when _ if rc == z_buf_error() then
        # Buffer too small, double it and retry
        if dest_len >= MAX_DECOMPRESSED_SIZE then
          return Result::Err(CompressionError::BufferError)
        end
        dest_len = dest_len * 2
        if dest_len > MAX_DECOMPRESSED_SIZE then
          dest_len = MAX_DECOMPRESSED_SIZE
        end
        output.resize(dest_len, 0)
      when _ then return Result::Err(zlib_error_from_code(rc, "zlib uncompress"))
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Raw DEFLATE (without zlib header)
# ———————————————————————————————————————————————————————————————

mod raw_deflate
  def compress(data: [u8]) -> Result[Vec[u8], CompressionError]
    compress_level(data, CompressionLevel::Default)
  end
  
  def compress_level(data: [u8], level: CompressionLevel) -> Result[Vec[u8], CompressionError]
    if data.is_empty() then
      return Result::Ok(Vec::new())
    end
    
    let mut strm = ZStream::new()
    let version = ZLIB_VERSION.to_cstring()
    
    # windowBits = -15 for raw deflate (no zlib header)
    let rc = unsafe "FFI boundary" do
      deflateInit2_(
        &mut strm as PtrMut[ZStream],
        level.to_zlib_level(),
        Z_DEFLATED,
        -15,
        8,
        Z_DEFAULT_STRATEGY,
        version.as_ptr(),
        size_of[ZStream]() as i32
      )
    end
    
    if rc != Z_OK then
      return Result::Err(zlib_error_from_code(rc, "raw deflate init"))
    end
    
    let bound = unsafe "FFI boundary" do compressBound(data.len()) end
    let mut output: Vec[u8] = Vec::with_capacity(bound)
    output.resize(bound, 0)
    
    strm.next_in = data.as_ptr()
    strm.avail_in = data.len() as u32
    strm.next_out = output.as_mut_ptr()
    strm.avail_out = bound as u32
    
    let rc = unsafe "FFI boundary" do deflate(&mut strm as PtrMut[ZStream], Z_FINISH) end
    
    if rc != Z_STREAM_END then
      unsafe "FFI boundary" do deflateEnd(&mut strm as PtrMut[ZStream]) end
      return Result::Err(zlib_error_from_code(rc, "raw deflate"))
    end
    
    let output_len = strm.total_out
    let end_rc = unsafe "FFI boundary" do deflateEnd(&mut strm as PtrMut[ZStream]) end
    if end_rc != Z_OK then
      return Result::Err(zlib_error_from_code(end_rc, "raw deflate finalize"))
    end
    
    output.truncate(output_len)
    Result::Ok(output)
  end
  
  def decompress(data: [u8]) -> Result[Vec[u8], CompressionError]
    decompress_with_size(data, data.len() * 4)
  end
  
  def decompress_with_size(data: [u8], estimated_size: UInt) -> Result[Vec[u8], CompressionError]
    if data.is_empty() then
      return Result::Ok(Vec::new())
    end
    
    let mut strm = ZStream::new()
    let version = ZLIB_VERSION.to_cstring()
    
    # windowBits = -15 for raw inflate
    let rc = unsafe "FFI boundary" do
      inflateInit2_(&mut strm as PtrMut[ZStream], -15, version.as_ptr(), size_of[ZStream]() as i32)
    end
    
    if rc != Z_OK then
      return Result::Err(zlib_error_from_code(rc, "raw inflate init"))
    end
    
    let mut output: Vec[u8] = Vec::with_capacity(estimated_size)
    output.resize(estimated_size, 0)
    
    strm.next_in = data.as_ptr()
    strm.avail_in = data.len() as u32
    strm.next_out = output.as_mut_ptr()
    strm.avail_out = estimated_size as u32
    
    let rc = unsafe "FFI boundary" do inflate(&mut strm as PtrMut[ZStream], Z_FINISH) end
    
    if rc != Z_STREAM_END && rc != Z_OK then
      unsafe "FFI boundary" do inflateEnd(&mut strm as PtrMut[ZStream]) end
      return Result::Err(zlib_error_from_code(rc, "raw inflate"))
    end
    
    let output_len = strm.total_out
    let end_rc = unsafe "FFI boundary" do inflateEnd(&mut strm as PtrMut[ZStream]) end
    if end_rc != Z_OK then
      return Result::Err(zlib_error_from_code(end_rc, "raw inflate finalize"))
    end
    
    output.truncate(output_len)
    Result::Ok(output)
  end
end

# ———————————————————————————————————————————————————————————————
# GZIP Module
# ———————————————————————————————————————————————————————————————

mod gzip
  const GZIP_DEFLATE: u8 = 8
  
  const FTEXT: u8 = 1
  const FHCRC: u8 = 2
  const FEXTRA: u8 = 4
  const FNAME: u8 = 8
  const FCOMMENT: u8 = 16
  
  struct GzipHeader
    mtime: u32
    extra_flags: u8
    os: u8
    filename: Option[String]
    comment: Option[String]
  end
  
  impl GzipHeader
    def new() -> GzipHeader
      GzipHeader {
        mtime: 0,
        extra_flags: 0,
        os: 255,  # unknown
        filename: Option::None,
        comment: Option::None
      end
    end
  end
  
  def compress(data: [u8]) -> Result[Vec[u8], CompressionError]
    compress_with_header(data, GzipHeader::new(), CompressionLevel::Default)
  end
  
  def compress_level(data: [u8], level: CompressionLevel) -> Result[Vec[u8], CompressionError]
    compress_with_header(data, GzipHeader::new(), level)
  end
  
  def compress_with_header(data: [u8], header: GzipHeader,
      level: CompressionLevel) -> Result[Vec[u8], CompressionError]
    let mut output = Vec::new()
    
    # Magic number
    output.push(0x1f)
    output.push(0x8b)
    
    # Compression method (deflate)
    output.push(GZIP_DEFLATE)
    
    # Flags
    let mut flags = 0u8
    if header.filename.is_some() then
      flags = flags | FNAME
    end
    if header.comment.is_some() then
      flags = flags | FCOMMENT
    end
    output.push(flags)
    
    # Modification time (4 bytes, little-endian)
    output.push((header.mtime & 0xff) as u8)
    output.push(((header.mtime >> 8) & 0xff) as u8)
    output.push(((header.mtime >> 16) & 0xff) as u8)
    output.push(((header.mtime >> 24) & 0xff) as u8)
    
    # Extra flags
    output.push(header.extra_flags)
    
    # OS
    output.push(header.os)
    
    # Optional filename
    if let Option::Some(name) = header.filename then
      for c in name.bytes() do
        output.push(c)
      end
      output.push(0)
    end
    
    # Optional comment
    if let Option::Some(comment) = header.comment then
      for c in comment.bytes() do
        output.push(c)
      end
      output.push(0)
    end
    
    # Compressed data (raw deflate)
    let compressed = raw_deflate::compress_level(data, level)?
    output.extend(compressed)
    
    # CRC32
    let crc = unsafe "FFI boundary" do crc32(0, data.as_ptr(), data.len() as u32) end
    output.push((crc & 0xff) as u8)
    output.push(((crc >> 8) & 0xff) as u8)
    output.push(((crc >> 16) & 0xff) as u8)
    output.push(((crc >> 24) & 0xff) as u8)
    
    # Original size (mod 2^32)
    let size = data.len() as u32
    output.push((size & 0xff) as u8)
    output.push(((size >> 8) & 0xff) as u8)
    output.push(((size >> 16) & 0xff) as u8)
    output.push(((size >> 24) & 0xff) as u8)
    
    Result::Ok(output)
  end
  
  def decompress(data: [u8]) -> Result[Vec[u8], CompressionError]
    if data.len() < 10 then
      return Result::Err(CompressionError::InvalidInput)
    end
    
    # Check magic number
    if data[0] != 0x1f || data[1] != 0x8b then
      return Result::Err(CompressionError::UnsupportedFormat)
    end
    
    # Check compression method
    if data[2] != 8 then
      return Result::Err(CompressionError::UnsupportedFormat)
    end
    
    let flags = data[3]
    let mut pos = 10
    
    # Skip extra field
    if (flags & FEXTRA) != 0 then
      if pos + 2 > data.len() then
        return Result::Err(CompressionError::InvalidInput)
      end
      let xlen = (data[pos] as UInt) | ((data[pos + 1] as UInt) << 8)
      pos = pos + 2 + xlen
    end
    
    # Skip filename
    if (flags & FNAME) != 0 then
      while pos < data.len() && data[pos] != 0 do
        pos = pos + 1
      end
      pos = pos + 1
    end
    
    # Skip comment
    if (flags & FCOMMENT) != 0 then
      while pos < data.len() && data[pos] != 0 do
        pos = pos + 1
      end
      pos = pos + 1
    end
    
    # Skip header CRC
    if (flags & FHCRC) != 0 then
      pos = pos + 2
    end
    
    if pos >= data.len() || data.len() < 8 then
      return Result::Err(CompressionError::InvalidInput)
    end
    
    # Compressed data ends 8 bytes before end (CRC32 + ISIZE)
    let compressed_data = data[pos..data.len() - 8]
    
    # Get expected CRC and size
    let trailer_start = data.len() - 8
    let expected_crc = (data[trailer_start] as u32) |
                       ((data[trailer_start + 1] as u32) << 8) |
                       ((data[trailer_start + 2] as u32) << 16) |
                       ((data[trailer_start + 3] as u32) << 24)
    let expected_size = (data[trailer_start + 4] as u32) |
                        ((data[trailer_start + 5] as u32) << 8) |
                        ((data[trailer_start + 6] as u32) << 16) |
                        ((data[trailer_start + 7] as u32) << 24)
    
    # Decompress
    let decompressed = raw_deflate::decompress_with_size(compressed_data, expected_size as UInt)?
    
    # Verify CRC
    let actual_crc = unsafe "FFI boundary" do crc32(0, decompressed.as_ptr(), decompressed.len() as u32) end
    if actual_crc != expected_crc then
      return Result::Err(CompressionError::ChecksumMismatch)
    end
    
    # Verify size (mod 2^32)
    if (decompressed.len() as u32) != expected_size then
      return Result::Err(CompressionError::DataError("size mismatch"))
    end
    
    Result::Ok(decompressed)
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 2: TAR ARCHIVES
# ═══════════════════════════════════════════════════════════════

enum TarEntryType
  Regular
  HardLink
  SymLink
  CharDevice
  BlockDevice
  Directory
  Fifo
  ContiguousFile
  Extended
  GlobalExtended
end

impl TarEntryType
  def from_byte(b: u8) -> TarEntryType
    match b
    when 0 | 48 then TarEntryType::Regular
    when 49 then TarEntryType::HardLink
    when 50 then TarEntryType::SymLink
    when 51 then TarEntryType::CharDevice
    when 52 then TarEntryType::BlockDevice
    when 53 then TarEntryType::Directory
    when 54 then TarEntryType::Fifo
    when 55 then TarEntryType::ContiguousFile
    when 120 then TarEntryType::Extended
    when 103 then TarEntryType::GlobalExtended
    when _ then TarEntryType::Regular
    end
  end
  
  def to_byte(self: TarEntryType) -> u8
    match self
    when TarEntryType::Regular then 48
    when TarEntryType::HardLink then 49
    when TarEntryType::SymLink then 50
    when TarEntryType::CharDevice then 51
    when TarEntryType::BlockDevice then 52
    when TarEntryType::Directory then 53
    when TarEntryType::Fifo then 54
    when TarEntryType::ContiguousFile then 55
    when TarEntryType::Extended then 120
    when TarEntryType::GlobalExtended then 103
    end
  end
end

struct TarEntry
  name: String
  mode: u32
  uid: u32
  gid: u32
  size: UInt
  mtime: u64
  entry_type: TarEntryType
  linkname: String
  uname: String
  gname: String
  devmajor: u32
  devminor: u32
  data: Vec[u8]
end

impl TarEntry
  def new(name: str) -> TarEntry
    TarEntry {
      name: name.to_string(),
      mode: 0o644,
      uid: 0,
      gid: 0,
      size: 0,
      mtime: 0,
      entry_type: TarEntryType::Regular,
      linkname: String::new(),
      uname: String::new(),
      gname: String::new(),
      devmajor: 0,
      devminor: 0,
      data: Vec::new()
    end
  end
  
  def is_file(self: TarEntry) -> Bool
    match self.entry_type
    when TarEntryType::Regular then true
    when _ then false
    end
  end
  
  def is_dir(self: TarEntry) -> Bool
    match self.entry_type
    when TarEntryType::Directory then true
    when _ then false
    end
  end
  
  def is_symlink(self: TarEntry) -> Bool
    match self.entry_type
    when TarEntryType::SymLink then true
    when _ then false
    end
  end
end

# TAR header is 512 bytes
struct TarHeader
  data: [u8; 512]
end

impl TarHeader
  def new() -> TarHeader
    TarHeader { data: [0; 512] end
  end
  
  def get_name(self: TarHeader) -> String
    read_null_terminated(&self.data[0..100])
  end
  
  def get_mode(self: TarHeader) -> u32
    parse_octal(&self.data[100..108]) as u32
  end
  
  def get_uid(self: TarHeader) -> u32
    parse_octal(&self.data[108..116]) as u32
  end
  
  def get_gid(self: TarHeader) -> u32
    parse_octal(&self.data[116..124]) as u32
  end
  
  def get_size(self: TarHeader) -> UInt
    parse_octal(&self.data[124..136])
  end
  
  def get_mtime(self: TarHeader) -> u64
    parse_octal(&self.data[136..148]) as u64
  end
  
  def get_checksum(self: TarHeader) -> u32
    parse_octal(&self.data[148..156]) as u32
  end
  
  def get_type(self: TarHeader) -> TarEntryType
    TarEntryType::from_byte(self.data[156])
  end
  
  def get_linkname(self: TarHeader) -> String
    read_null_terminated(&self.data[157..257])
  end
  
  def get_magic(self: TarHeader) -> String
    read_null_terminated(&self.data[257..263])
  end
  
  def get_uname(self: TarHeader) -> String
    read_null_terminated(&self.data[265..297])
  end
  
  def get_gname(self: TarHeader) -> String
    read_null_terminated(&self.data[297..329])
  end
  
  def get_prefix(self: TarHeader) -> String
    read_null_terminated(&self.data[345..500])
  end
  
  def is_ustar(self: TarHeader) -> Bool
    self.get_magic().starts_with("ustar")
  end
  
  def is_null(self: TarHeader) -> Bool
    for b in self.data do
      if *b != 0 then
        return false
      end
    end
    true
  end
  
  def compute_checksum(self: TarHeader) -> u32
    let mut sum = 0u32
    for i in 0..512 do
      if i >= 148 && i < 156 then
        sum = sum + (' ' as u32)
      else
        sum = sum + (self.data[i] as u32)
      end
    end
    sum
  end
  
  def set_name(inout self: TarHeader, name: str) -> Unit
    write_string(&mut self.data[0..100], name)
  end
  
  def set_mode(inout self: TarHeader, mode: u32) -> Unit
    write_octal(&mut self.data[100..108], mode as UInt, 7)
  end
  
  def set_uid(inout self: TarHeader, uid: u32) -> Unit
    write_octal(&mut self.data[108..116], uid as UInt, 7)
  end
  
  def set_gid(inout self: TarHeader, gid: u32) -> Unit
    write_octal(&mut self.data[116..124], gid as UInt, 7)
  end
  
  def set_size(inout self: TarHeader, size: UInt) -> Unit
    write_octal(&mut self.data[124..136], size, 11)
  end
  
  def set_mtime(inout self: TarHeader, mtime: u64) -> Unit
    write_octal(&mut self.data[136..148], mtime as UInt, 11)
  end
  
  def set_checksum(inout self: TarHeader, checksum: u32) -> Unit
    write_octal(&mut self.data[148..156], checksum as UInt, 6)
    self.data[154] = 0
    self.data[155] = 32
  end
  
  def set_type(inout self: TarHeader, t: TarEntryType) -> Unit
    self.data[156] = t.to_byte()
  end
  
  def set_linkname(inout self: TarHeader, name: str) -> Unit
    write_string(&mut self.data[157..257], name)
  end
  
  def set_ustar(inout self: TarHeader) -> Unit
    write_string(&mut self.data[257..263], "ustar")
    self.data[263] = 0
    self.data[264] = 48
    self.data[265] = 48
  end
  
  def set_uname(inout self: TarHeader, name: str) -> Unit
    write_string(&mut self.data[265..297], name)
  end
  
  def set_gname(inout self: TarHeader, name: str) -> Unit
    write_string(&mut self.data[297..329], name)
  end
end

def read_null_terminated(data: [u8]) -> String
  let mut s = String::new()
  for b in data do
    if *b == 0 then
      break
    end
    s.push(*b as char)
  end
  s
end

def parse_octal(data: [u8]) -> UInt
  let mut result = 0
  for b in data do
    if *b == 0 || *b == 32 then
      next
    end
    if *b >= 48 && *b <= 55 then
      result = result * 8 + (*b - 48) as UInt
    end
  end
  result
end

def write_string(inout dest: [u8], s: str) -> Unit
  let bytes = s.bytes()
  let len = if bytes.len() < dest.len() then bytes.len() else dest.len() end
  for i in 0..len do
    dest[i] = bytes[i]
  end
  for i in len..dest.len() do
    dest[i] = 0
  end
end

def write_octal(inout dest: [u8], value: UInt, width: UInt) -> Unit
  mut tmp: [u8; 32] = [0; 32]
  mut n = value
  mut digits: UInt = 0

  if n == 0 then
    tmp[0] = 48
    digits = 1
  else
    while n > 0 && digits < 32 do
      tmp[digits] = 48 + (n % 8) as u8
      n = n / 8
      digits = digits + 1
    end
  end

  let field_width = if width < dest.len() then width else dest.len() end
  for i in 0..field_width do
    dest[i] = 48
  end

  let copy_digits = if digits < field_width then digits else field_width end
  let start = field_width - copy_digits
  for i in 0..copy_digits do
    dest[start + i] = tmp[copy_digits - 1 - i]
  end

  if field_width < dest.len() then
    dest[field_width] = 0
  end
end

# ———————————————————————————————————————————————————————————————
# TAR Reader
# ———————————————————————————————————————————————————————————————

struct TarReader[R]
  reader: R
  finished: Bool
end

impl[R] TarReader[R] where R: Read
  def new(reader: R) -> TarReader[R]
    TarReader { reader: reader, finished: false end
  end
  
  def entries(inout self: TarReader[R]) -> Result[Vec[TarEntry], CompressionError]
    let mut entries = Vec::new()

    loop
      match self.next_entry()?
      when Option::Some(next_entry) then entries.push(next_entry)
      when Option::None then break
      end
    end
    
    Result::Ok(entries)
  end
  
  def next_entry(inout self: TarReader[R]) -> Result[Option[TarEntry], CompressionError]
    if self.finished then
      return Result::Ok(Option::None)
    end
    
    let mut header = TarHeader::new()
    let bytes_read = self.reader.read(fixed_array_mut_view(address_of_mut(&mut header.data) as PtrMut[u8], 512))
      .map_err(|e| CompressionError::IoError(e.to_string()))?
    
    if bytes_read == 0 || header.is_null() then
      # Check for second null block
      let mut second = TarHeader::new()
      let _ = self.reader.read(fixed_array_mut_view(address_of_mut(&mut second.data) as PtrMut[u8], 512))
      self.finished = true
      return Result::Ok(Option::None)
    end
    
    if bytes_read != 512 then
      return Result::Err(CompressionError::InvalidInput)
    end
    
    # Verify checksum
    let stored_checksum = header.get_checksum()
    let computed_checksum = header.compute_checksum()
    if stored_checksum != computed_checksum then
      return Result::Err(CompressionError::ChecksumMismatch)
    end
    
    let mut name = header.get_name()
    if header.is_ustar() then
      let prefix = header.get_prefix()
      if !prefix.is_empty() then
        name = prefix + "/" + name
      end
    end
    
    let size = header.get_size()
    
    # Read data
    let mut data = Vec::with_capacity(size)
    data.resize(size, 0)
    
    if size > 0 then
      let bytes_read = self.reader.read(data.as_mut_slice())
        .map_err(|e| CompressionError::IoError(e.to_string()))?
      if bytes_read != size then
        return Result::Err(CompressionError::InvalidInput)
      end
      
      # Skip padding to 512-byte boundary
      let padding = (512 - (size % 512)) % 512
      if padding > 0 then
        let mut pad_buf = Vec::with_capacity(padding)
        pad_buf.resize(padding, 0)
        self.reader.read(pad_buf.as_mut_slice())
          .map_err(|e| CompressionError::IoError(e.to_string()))?
      end
    end
    
    Result::Ok(Option::Some(TarEntry {
      name: name,
      mode: header.get_mode(),
      uid: header.get_uid(),
      gid: header.get_gid(),
      size: size,
      mtime: header.get_mtime(),
      entry_type: header.get_type(),
      linkname: header.get_linkname(),
      uname: header.get_uname(),
      gname: header.get_gname(),
      devmajor: 0,
      devminor: 0,
      data: data
    }))
  end
end

# ———————————————————————————————————————————————————————————————
# TAR Writer
# ———————————————————————————————————————————————————————————————

struct TarBuilder[W]
  writer: W
end

impl[W] TarBuilder[W] where W: Write
  def new(writer: W) -> TarBuilder[W]
    TarBuilder { writer: writer end
  end
  
  def add_entry(inout self: TarBuilder[W], entry: TarEntry) -> Result[Unit, CompressionError]
    let mut header = TarHeader::new()
    
    # Handle long names
    if entry.name.len() > 100 then
      # Use prefix for ustar
      if entry.name.len() <= 255 then
        let (prefix, name) = split_tar_name(&entry.name)
        header.set_name(&name)
        write_string(&mut header.data[345..500], &prefix)
      else
        return Result::Err(CompressionError::DataError("name too long"))
      end
    else
      header.set_name(&entry.name)
    end
    
    header.set_mode(entry.mode)
    header.set_uid(entry.uid)
    header.set_gid(entry.gid)
    header.set_size(entry.data.len())
    header.set_mtime(entry.mtime)
    header.set_type(entry.entry_type.clone())
    header.set_linkname(&entry.linkname)
    header.set_ustar()
    header.set_uname(&entry.uname)
    header.set_gname(&entry.gname)
    
    let checksum = header.compute_checksum()
    header.set_checksum(checksum)
    
    self.writer.write_all(&header.data)
      .map_err(|e| CompressionError::IoError(e.to_string()))?
    
    if !entry.data.is_empty() then
      self.writer.write_all(&entry.data)
        .map_err(|e| CompressionError::IoError(e.to_string()))?
      
      # Padding
      let padding = (512 - (entry.data.len() % 512)) % 512
      if padding > 0 then
        let zeros = vec![0u8; padding]
        self.writer.write_all(&zeros)
          .map_err(|e| CompressionError::IoError(e.to_string()))?
      end
    end
    
    Result::Ok(())
  end
  
  def add_file(inout self: TarBuilder[W], name: str, data: [u8]) -> Result[Unit, CompressionError]
    let entry = TarEntry {
      name: name.to_string(),
      mode: 0o644,
      uid: 0,
      gid: 0,
      size: data.len(),
      mtime: 0,
      entry_type: TarEntryType::Regular,
      linkname: String::new(),
      uname: String::new(),
      gname: String::new(),
      devmajor: 0,
      devminor: 0,
      data: data.to_vec()
    end
    self.add_entry(&entry)
  end
  
  def add_dir(inout self: TarBuilder[W], name: str) -> Result[Unit, CompressionError]
    let mut dir_name = name.to_string()
    if !dir_name.ends_with('/') then
      dir_name.push('/')
    end
    
    let entry = TarEntry {
      name: dir_name,
      mode: 0o755,
      uid: 0,
      gid: 0,
      size: 0,
      mtime: 0,
      entry_type: TarEntryType::Directory,
      linkname: String::new(),
      uname: String::new(),
      gname: String::new(),
      devmajor: 0,
      devminor: 0,
      data: Vec::new()
    end
    self.add_entry(&entry)
  end
  
  def finish(inout self: TarBuilder[W]) -> Result[Unit, CompressionError]
    # Write two null blocks
    let zeros = [0u8; 1024]
    self.writer.write_all(&zeros)
      .map_err(|e| CompressionError::IoError(e.to_string()))
  end
end

def split_tar_name(name: str) -> (String, String)
  if name.len() <= 100 then
    return (String::new(), name.to_string())
  end
  
  # Find split point
  let limit = if name.len() <= 255 then name.len() - 100 else 155 end
  
  let mut split = limit
  for i in (0..limit).rev() do
    if name.char_at(i) == '/' then
      split = i
      break
    end
  end
  
  let prefix = name[0..split].to_string()
  let suffix = name[split + 1..].to_string()
  (prefix, suffix)
end

# ———————————————————————————————————————————————————————————————
# TAR.GZ convenience
# ———————————————————————————————————————————————————————————————

mod tar_gz
  def compress(entries: [TarEntry]) -> Result[Vec[u8], CompressionError]
    let mut tar_data = Vec::new()
    let mut builder = TarBuilder::new(&mut tar_data)
    
    for entry in entries do
      builder.add_entry(entry)?
    end
    builder.finish()?
    
    gzip::compress(tar_data.as_slice())
  end
  
  def decompress(data: [u8]) -> Result[Vec[TarEntry], CompressionError]
    let tar_data = gzip::decompress(data)?
    let mut reader = TarReader::new(tar_data.as_slice())
    reader.entries()
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 3: ZIP ARCHIVES
# ═══════════════════════════════════════════════════════════════

const ZIP_LOCAL_HEADER_SIG: u32 = 0x04034b50
const ZIP_CENTRAL_HEADER_SIG: u32 = 0x02014b50
const ZIP_END_CENTRAL_DIR_SIG: u32 = 0x06054b50

const ZIP_METHOD_STORE: u16 = 0
const ZIP_METHOD_DEFLATE: u16 = 8

struct ZipEntry
  name: String
  compression_method: u16
  compressed_size: u32
  uncompressed_size: u32
  crc32: u32
  mtime: u16
  mdate: u16
  external_attrs: u32
  data: Vec[u8]
  is_directory: Bool
end

impl ZipEntry
  def new(name: str) -> ZipEntry
    ZipEntry {
      name: name.to_string(),
      compression_method: ZIP_METHOD_DEFLATE,
      compressed_size: 0,
      uncompressed_size: 0,
      crc32: 0,
      mtime: 0,
      mdate: 0,
      external_attrs: 0,
      data: Vec::new(),
      is_directory: false
    end
  end
end

# ———————————————————————————————————————————————————————————————
# ZIP Reader
# ———————————————————————————————————————————————————————————————

struct ZipReader
  data: Vec[u8]
  entries: Vec[ZipCentralDir]
end

struct ZipCentralDir
  name: String
  compression_method: u16
  compressed_size: u32
  uncompressed_size: u32
  crc32: u32
  mtime: u16
  mdate: u16
  local_header_offset: u32
  external_attrs: u32
end

impl ZipReader
  def open(data: Vec[u8]) -> Result[ZipReader, CompressionError]
    if data.len() < 22 then
      return Result::Err(CompressionError::InvalidInput)
    end
    
    # Find end of central directory
    let mut eocd_pos: Option[UInt] = Option::None
    for i in (0..data.len()-21).rev() do
      if read_u32_le(&data, i) == ZIP_END_CENTRAL_DIR_SIG then
        eocd_pos = Option::Some(i as UInt)
        break
      end
    end
    
    let eocd_pos = match eocd_pos
    when Option::Some(p) then p
    when Option::None then return Result::Err(CompressionError::InvalidInput)
    end
    
    let entry_count = read_u16_le(&data, eocd_pos + 10) as UInt
    let central_dir_offset = read_u32_le(&data, eocd_pos + 16) as UInt
    
    # Parse central directory
    let mut entries = Vec::new()
    let mut pos = central_dir_offset
    
    for _ in 0..entry_count do
      if read_u32_le(&data, pos) != ZIP_CENTRAL_HEADER_SIG then
        return Result::Err(CompressionError::InvalidInput)
      end
      
      let compression_method = read_u16_le(&data, pos + 10)
      let mtime = read_u16_le(&data, pos + 12)
      let mdate = read_u16_le(&data, pos + 14)
      let crc32 = read_u32_le(&data, pos + 16)
      let compressed_size = read_u32_le(&data, pos + 20)
      let uncompressed_size = read_u32_le(&data, pos + 24)
      let name_len = read_u16_le(&data, pos + 28) as UInt
      let extra_len = read_u16_le(&data, pos + 30) as UInt
      let comment_len = read_u16_le(&data, pos + 32) as UInt
      let external_attrs = read_u32_le(&data, pos + 38)
      let local_header_offset = read_u32_le(&data, pos + 42)
      
      let name = String::from_utf8_lossy(&data.slice(pos + 46, pos + 46 + name_len))
      
      entries.push(ZipCentralDir {
        name: name,
        compression_method: compression_method,
        compressed_size: compressed_size,
        uncompressed_size: uncompressed_size,
        crc32: crc32,
        mtime: mtime,
        mdate: mdate,
        local_header_offset: local_header_offset,
        external_attrs: external_attrs
      })
      
      pos = pos + 46 + name_len + extra_len + comment_len
    end
    
    Result::Ok(ZipReader { data: data, entries: entries })
  end
  
  def entries(self: ZipReader) -> Vec[ZipCentralDir]
    var out = Vec::new()
    for entry in self.entries do
      out.push(entry.clone())
    end
    out
  end
  
  def read_entry(self: ZipReader, entry: ZipCentralDir) -> Result[Vec[u8], CompressionError]
    let pos = entry.local_header_offset as UInt
    
    if read_u32_le(&self.data, pos) != ZIP_LOCAL_HEADER_SIG then
      return Result::Err(CompressionError::InvalidInput)
    end
    
    let name_len = read_u16_le(&self.data, pos + 26) as UInt
    let extra_len = read_u16_le(&self.data, pos + 28) as UInt
    let data_start = pos + 30 + name_len + extra_len
    let data_end = data_start + entry.compressed_size as UInt
    
    let compressed = self.data[data_start..data_end]
    
    let decompressed = match entry.compression_method
    when ZIP_METHOD_STORE then compressed.to_vec()
    when ZIP_METHOD_DEFLATE then raw_deflate::decompress_with_size(compressed, entry.uncompressed_size as UInt)?
    when _ then return Result::Err(CompressionError::UnsupportedFormat)
    end
    
    # Verify CRC
    let computed_crc = unsafe "FFI boundary" do crc32(0, decompressed.as_ptr(), decompressed.len() as u32) end
    if computed_crc != entry.crc32 then
      return Result::Err(CompressionError::ChecksumMismatch)
    end
    
    Result::Ok(decompressed)
  end
  
  def extract_all(self: ZipReader) -> Result[Vec[ZipEntry], CompressionError]
    let mut result = Vec::new()
    
    for entry in self.entries do
      let data = self.read_entry(entry)?
      result.push(ZipEntry {
        name: entry.name.clone(),
        compression_method: entry.compression_method,
        compressed_size: entry.compressed_size,
        uncompressed_size: entry.uncompressed_size,
        crc32: entry.crc32,
        mtime: entry.mtime,
        mdate: entry.mdate,
        external_attrs: entry.external_attrs,
        data: data,
        is_directory: entry.name.ends_with('/')
      })
    end
    
    Result::Ok(result)
  end
end

# ———————————————————————————————————————————————————————————————
# ZIP Writer
# ———————————————————————————————————————————————————————————————

struct ZipWriter
  data: Vec[u8]
  entries: Vec[ZipLocalEntry]
end

struct ZipLocalEntry
  name: String
  compression_method: u16
  compressed_size: u32
  uncompressed_size: u32
  crc32: u32
  mtime: u16
  mdate: u16
  offset: u32
end

impl ZipWriter
  def new() -> ZipWriter
    ZipWriter { data: Vec::new(), entries: Vec::new() end
  end
  
  def add_file(inout self: ZipWriter, name: str, content: [u8]) -> Result[Unit, CompressionError]
    self.add_file_compressed(name, content, true)
  end
  
  def add_file_compressed(inout self: ZipWriter, name: str,
      content: [u8], compress: Bool) -> Result[Unit, CompressionError]
    let offset = self.data.len() as u32
    let file_crc = unsafe "FFI boundary" do crc32(0, content.as_ptr(), content.len() as u32) end
    
    let (compressed, method) = if compress && content.len() > 0 then
      let c = raw_deflate::compress(content)?
      if c.len() < content.len() then
        (c, ZIP_METHOD_DEFLATE)
      else
        (content.to_vec(), ZIP_METHOD_STORE)
      end
    else
      (content.to_vec(), ZIP_METHOD_STORE)
    end
    
    # Local file header
    write_u32_le(&mut self.data, ZIP_LOCAL_HEADER_SIG)
    write_u16_le(&mut self.data, 20)  # version needed
    write_u16_le(&mut self.data, 0)   # general purpose flag
    write_u16_le(&mut self.data, method)
    write_u16_le(&mut self.data, 0)   # mtime
    write_u16_le(&mut self.data, 0)   # mdate
    write_u32_le(&mut self.data, file_crc)
    write_u32_le(&mut self.data, compressed.len() as u32)
    write_u32_le(&mut self.data, content.len() as u32)
    write_u16_le(&mut self.data, name.len() as u16)
    write_u16_le(&mut self.data, 0)   # extra field length
    self.data.extend(name.bytes())
    self.data.extend(&compressed)
    
    self.entries.push(ZipLocalEntry {
      name: name.to_string(),
      compression_method: method,
      compressed_size: compressed.len() as u32,
      uncompressed_size: content.len() as u32,
      crc32: file_crc,
      mtime: 0,
      mdate: 0,
      offset: offset
    })
    
    Result::Ok(())
  end
  
  def add_directory(inout self: ZipWriter, name: str) -> Result[Unit, CompressionError]
    let mut dir_name = name.to_string()
    if !dir_name.ends_with('/') then
      dir_name.push('/')
    end
    let empty: Vec[u8] = Vec.new()
    self.add_file(&dir_name, &empty)
  end
  
  def finish(inout self: ZipWriter) -> Vec[u8]
    let central_dir_start = self.data.len() as u32
    
    # Central directory
    for entry in self.entries do
      write_u32_le(&mut self.data, ZIP_CENTRAL_HEADER_SIG)
      write_u16_le(&mut self.data, 20)  # version made by
      write_u16_le(&mut self.data, 20)  # version needed
      write_u16_le(&mut self.data, 0)   # general purpose flag
      write_u16_le(&mut self.data, entry.compression_method)
      write_u16_le(&mut self.data, entry.mtime)
      write_u16_le(&mut self.data, entry.mdate)
      write_u32_le(&mut self.data, entry.crc32)
      write_u32_le(&mut self.data, entry.compressed_size)
      write_u32_le(&mut self.data, entry.uncompressed_size)
      write_u16_le(&mut self.data, entry.name.len() as u16)
      write_u16_le(&mut self.data, 0)   # extra field length
      write_u16_le(&mut self.data, 0)   # comment length
      write_u16_le(&mut self.data, 0)   # disk number start
      write_u16_le(&mut self.data, 0)   # internal attrs
      write_u32_le(&mut self.data, 0)   # external attrs
      write_u32_le(&mut self.data, entry.offset)
      self.data.extend(entry.name.bytes())
    end
    
    let central_dir_size = self.data.len() as u32 - central_dir_start
    
    # End of central directory
    write_u32_le(&mut self.data, ZIP_END_CENTRAL_DIR_SIG)
    write_u16_le(&mut self.data, 0)  # disk number
    write_u16_le(&mut self.data, 0)  # disk with central dir
    write_u16_le(&mut self.data, self.entries.len() as u16)
    write_u16_le(&mut self.data, self.entries.len() as u16)
    write_u32_le(&mut self.data, central_dir_size)
    write_u32_le(&mut self.data, central_dir_start)
    write_u16_le(&mut self.data, 0)  # comment length
    
    self.data.clone()
  end
end

# Little-endian helpers
def read_u16_le(data: [u8], offset: UInt) -> u16
  (data[offset] as u16) | ((data[offset + 1] as u16) << 8)
end

def read_u32_le(data: [u8], offset: UInt) -> u32
  (data[offset] as u32) |
  ((data[offset + 1] as u32) << 8) |
  ((data[offset + 2] as u32) << 16) |
  ((data[offset + 3] as u32) << 24)
end

def write_u16_le(inout data: Vec[u8], value: u16) -> Unit
  data.push((value & 0xff) as u8)
  data.push(((value >> 8) & 0xff) as u8)
end

def write_u32_le(inout data: Vec[u8], value: u32) -> Unit
  data.push((value & 0xff) as u8)
  data.push(((value >> 8) & 0xff) as u8)
  data.push(((value >> 16) & 0xff) as u8)
  data.push(((value >> 24) & 0xff) as u8)
end

# ═══════════════════════════════════════════════════════════════
# PART 4: STREAMING COMPRESSION
# ═══════════════════════════════════════════════════════════════

struct DeflateEncoder[W]
  writer: W
  stream: ZStream
  buffer: Vec[u8]
  finished: Bool
end

impl[W] DeflateEncoder[W] where W: Write
  def new(writer: W) -> Result[DeflateEncoder[W], CompressionError]
    DeflateEncoder::with_level(writer, CompressionLevel::Default)
  end
  
  def with_level(writer: W, level: CompressionLevel) -> Result[DeflateEncoder[W], CompressionError]
    let mut stream = ZStream::new()
    let version = ZLIB_VERSION.to_cstring()
    
    let rc = unsafe "FFI boundary" do
      deflateInit_(&mut stream as PtrMut[ZStream], level.to_zlib_level(), version.as_ptr(), size_of[ZStream]() as i32)
    end
    
    if rc != Z_OK then
      return Result::Err(zlib_error_from_code(rc, "deflate encoder init"))
    end
    
    Result::Ok(DeflateEncoder {
      writer: writer,
      stream: stream,
      buffer: vec![0u8; 32768],
      finished: false
    })
  end
  
  def write(inout self: DeflateEncoder[W], data: [u8]) -> Result[UInt, CompressionError]
    if data.is_empty() then
      return Result::Ok(0)
    end
    
    self.stream.next_in = data.as_ptr()
    self.stream.avail_in = data.len() as u32
    
    while self.stream.avail_in > 0 do
      self.stream.next_out = self.buffer.as_mut_ptr()
      self.stream.avail_out = self.buffer.len() as u32
      
      let rc = unsafe "FFI boundary" do deflate(&mut self.stream as PtrMut[ZStream], Z_NO_FLUSH) end
      if rc != Z_OK then
        return Result::Err(zlib_error_from_code(rc, "deflate encoder write"))
      end
      
      let have = self.buffer.len() - self.stream.avail_out as UInt
      if have > 0 then
        self.writer.write_all(&self.buffer[0..have])
          .map_err(|e| CompressionError::IoError(e.to_string()))?
      end
    end
    
    Result::Ok(data.len())
  end
  
  def finish(inout self: DeflateEncoder[W]) -> Result[Unit, CompressionError]
    if self.finished then
      return Result::Ok(())
    end
    
    self.stream.next_in = Ptr::null()
    self.stream.avail_in = 0
    
    loop
      self.stream.next_out = self.buffer.as_mut_ptr()
      self.stream.avail_out = self.buffer.len() as u32
      
      let rc = unsafe "FFI boundary" do deflate(&mut self.stream as PtrMut[ZStream], Z_FINISH) end
      
      let have = self.buffer.len() - self.stream.avail_out as UInt
      if have > 0 then
        self.writer.write_all(&self.buffer[0..have])
          .map_err(|e| CompressionError::IoError(e.to_string()))?
      end
      
      if rc == Z_STREAM_END then
        break
      elsif rc != Z_OK then
        return Result::Err(zlib_error_from_code(rc, "deflate encoder finish"))
      end
    end
    
    let end_rc = unsafe "FFI boundary" do deflateEnd(&mut self.stream as PtrMut[ZStream]) end
    if end_rc != Z_OK then
      return Result::Err(zlib_error_from_code(end_rc, "deflate encoder finalize"))
    end

    self.finished = true
    Result::Ok(())
  end
end

impl[W] Drop for DeflateEncoder[W]
  def drop(inout self: DeflateEncoder[W]) -> Unit
    if !self.finished then
      let _ = unsafe "FFI boundary" do deflateEnd(&mut self.stream as PtrMut[ZStream]) end
    end
  end
end

struct DeflateDecoder[R]
  reader: R
  stream: ZStream
  input_buffer: Vec[u8]
  finished: Bool
end

impl[R] DeflateDecoder[R] where R: Read
  def new(reader: R) -> Result[DeflateDecoder[R], CompressionError]
    let mut stream = ZStream::new()
    let version = ZLIB_VERSION.to_cstring()
    
    let rc = unsafe "FFI boundary" do
      inflateInit_(&mut stream as PtrMut[ZStream], version.as_ptr(), size_of[ZStream]() as i32)
    end
    
    if rc != Z_OK then
      return Result::Err(zlib_error_from_code(rc, "deflate decoder init"))
    end
    
    Result::Ok(DeflateDecoder {
      reader: reader,
      stream: stream,
      input_buffer: vec![0u8; 32768],
      finished: false
    })
  end
  
  def read(inout self: DeflateDecoder[R], inout output: [u8]) -> Result[UInt, CompressionError]
    if self.finished || output.is_empty() then
      return Result::Ok(0)
    end
    
    self.stream.next_out = output.as_mut_ptr()
    self.stream.avail_out = output.len() as u32
    
    while self.stream.avail_out > 0 do
      if self.stream.avail_in == 0 then
        let bytes_read = self.reader.read(self.input_buffer.as_mut_slice())
          .map_err(|e| CompressionError::IoError(e.to_string()))?
        
        if bytes_read == 0 then
          break
        end
        
        self.stream.next_in = self.input_buffer.as_ptr()
        self.stream.avail_in = bytes_read as u32
      end
      
      let rc = unsafe "FFI boundary" do inflate(&mut self.stream as PtrMut[ZStream], Z_NO_FLUSH) end
      
      if rc == Z_STREAM_END then
        let end_rc = unsafe "FFI boundary" do inflateEnd(&mut self.stream as PtrMut[ZStream]) end
        if end_rc != Z_OK then
          return Result::Err(zlib_error_from_code(end_rc, "deflate decoder finalize"))
        end
        self.finished = true
        break
      elsif rc != Z_OK then
        return Result::Err(zlib_error_from_code(rc, "deflate decoder read"))
      end
    end
    
    Result::Ok(output.len() - self.stream.avail_out as UInt)
  end
end

impl[R] Drop for DeflateDecoder[R]
  def drop(inout self: DeflateDecoder[R]) -> Unit
    if !self.finished then
      let _ = unsafe "FFI boundary" do inflateEnd(&mut self.stream as PtrMut[ZStream]) end
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 5: CHECKSUM UTILITIES
# ═══════════════════════════════════════════════════════════════

mod checksum
  def crc32(data: [u8]) -> u32
    crc32_init().update(data).finalize()
  end
  
  def adler32(data: [u8]) -> u32
    adler32_init().update(data).finalize()
  end
  
  struct Crc32
    value: u32
  end
  
  def crc32_init() -> Crc32
    Crc32 { value: 0 end
  end
  
  impl Crc32
    def update(sink self: Crc32, data: [u8]) -> Crc32
      if !data.is_empty() then
        self.value = unsafe "FFI boundary" do crc32(self.value, data.as_ptr(), data.len() as u32) end
      end
      self
    end
    
    def finalize(self: Crc32) -> u32
      self.value
    end
    
    def reset(inout self: Crc32) -> Unit
      self.value = 0
    end
  end
  
  struct Adler32
    value: u32
  end
  
  def adler32_init() -> Adler32
    Adler32 { value: 1 end
  end
  
  impl Adler32
    def update(sink self: Adler32, data: [u8]) -> Adler32
      if !data.is_empty() then
        self.value = unsafe "FFI boundary" do adler32(self.value, data.as_ptr(), data.len() as u32) end
      end
      self
    end
    
    def finalize(self: Adler32) -> u32
      self.value
    end
    
    def reset(inout self: Adler32) -> Unit
      self.value = 1
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 6: ZSTD (Zstandard) COMPRESSION
# ═══════════════════════════════════════════════════════════════

## FFI bindings for libzstd
extern "C"
  def ZSTD_compress(dst: PtrMut[u8], dstCapacity: UInt, src: Ptr[u8], srcSize: UInt, compressionLevel: i32) -> UInt
  def ZSTD_decompress(dst: PtrMut[u8], dstCapacity: UInt, src: Ptr[u8], compressedSize: UInt) -> UInt
  def ZSTD_isError(code: UInt) -> u32
  def ZSTD_getErrorName(code: UInt) -> Ptr[u8]
  def ZSTD_compressBound(srcSize: UInt) -> UInt
  def ZSTD_getFrameContentSize(src: Ptr[u8], srcSize: UInt) -> u64
  def ZSTD_createCCtx() -> Ptr[Unit]
  def ZSTD_freeCCtx(cctx: Ptr[Unit]) -> UInt
  def ZSTD_createDCtx() -> Ptr[Unit]
  def ZSTD_freeDCtx(dctx: Ptr[Unit]) -> UInt
  def ZSTD_compressCCtx(cctx: Ptr[Unit], dst: PtrMut[u8], dstCapacity: UInt,
                         src: Ptr[u8], srcSize: UInt, compressionLevel: i32) -> UInt
  def ZSTD_decompressDCtx(dctx: Ptr[Unit], dst: PtrMut[u8], dstCapacity: UInt,
                           src: Ptr[u8], srcSize: UInt) -> UInt
  ## Streaming API
  def ZSTD_createCStream() -> Ptr[Unit]
  def ZSTD_freeCStream(zcs: Ptr[Unit]) -> UInt
  def ZSTD_initCStream(zcs: Ptr[Unit], compressionLevel: i32) -> UInt
  def ZSTD_createDStream() -> Ptr[Unit]
  def ZSTD_freeDStream(zds: Ptr[Unit]) -> UInt
  def ZSTD_initDStream(zds: Ptr[Unit]) -> UInt
end

const ZSTD_CONTENTSIZE_UNKNOWN: u64 = 0xFFFFFFFFFFFFFFFF
const ZSTD_CONTENTSIZE_ERROR: u64 = 0xFFFFFFFFFFFFFFFE
const ZSTD_DEFAULT_LEVEL: i32 = 3
const ZSTD_MIN_LEVEL: i32 = 1
const ZSTD_MAX_LEVEL: i32 = 22

module zstd
  enum ZstdLevel
    Fast       ## Level 1
    Default    ## Level 3
    Best       ## Level 19
    Custom(i32)
  end

  def level_to_int(level: ZstdLevel) -> i32
    match level
    when ZstdLevel::Fast then 1
    when ZstdLevel::Default then 3
    when ZstdLevel::Best then 19
    when ZstdLevel::Custom(l) then l
    end
  end

  ## One-shot compression
  def compress(data: [u8]) -> Result[Vec[u8], CompressionError]
    compress_level(data, &ZstdLevel::Default)
  end

  def compress_level(data: [u8], level: ZstdLevel) -> Result[Vec[u8], CompressionError]
    let bound = unsafe "FFI boundary" do ZSTD_compressBound(data.len()) end
    let mut output = vec![0u8; bound]
    let result = unsafe "FFI boundary" do
      ZSTD_compress(output.as_mut_ptr(), bound, data.as_ptr(), data.len(), level_to_int(level))
    end
    let is_err = unsafe "FFI boundary" do ZSTD_isError(result) end
    if is_err != 0 then
      return Result::Err(CompressionError::DataError("Zstd compression failed".to_string()))
    end
    output.truncate(result)
    Result::Ok(output)
  end

  ## One-shot decompression
  def decompress(data: [u8]) -> Result[Vec[u8], CompressionError]
    let content_size = unsafe "FFI boundary" do ZSTD_getFrameContentSize(data.as_ptr(), data.len()) end
    let dst_capacity = if content_size == ZSTD_CONTENTSIZE_UNKNOWN || content_size == ZSTD_CONTENTSIZE_ERROR then
      data.len() * 4  ## Heuristic
    else
      content_size as UInt
    end
    let mut output = vec![0u8; dst_capacity]
    let result = unsafe "FFI boundary" do
      ZSTD_decompress(output.as_mut_ptr(), dst_capacity, data.as_ptr(), data.len())
    end
    let is_err = unsafe "FFI boundary" do ZSTD_isError(result) end
    if is_err != 0 then
      return Result::Err(CompressionError::DataError("Zstd decompression failed".to_string()))
    end
    output.truncate(result)
    Result::Ok(output)
  end

  ## Streaming compressor
  struct ZstdEncoder[W: Write]
    writer: W
    cctx: Ptr[Unit]
    buffer: Vec[u8]
  end

  def ZstdEncoder::new[W: Write](writer: W, level: ZstdLevel) -> Result[ZstdEncoder[W], CompressionError]
    let cctx = unsafe "FFI boundary" do ZSTD_createCCtx() end
    if cctx.is_null() then
      return Result::Err(CompressionError::MemoryError("failed to allocate Zstd context".to_string()))
    end
    Result::Ok(ZstdEncoder {
      writer: writer,
      cctx: cctx,
      buffer: Vec::with_capacity(65536),
    })
  end

  impl[W: Write] Drop for ZstdEncoder[W]
    def drop(inout self: ZstdEncoder[W]) -> Unit
      if self.cctx != (Ptr::null() as Ptr[Unit]) then
        let _ = unsafe "FFI boundary" do ZSTD_freeCCtx(self.cctx) end
      end
    end
  end

  ## Streaming decompressor
  struct ZstdDecoder[R: Read]
    reader: R
    dctx: Ptr[Unit]
    buffer: Vec[u8]
  end

  def ZstdDecoder::new[R: Read](reader: R) -> Result[ZstdDecoder[R], CompressionError]
    let dctx = unsafe "FFI boundary" do ZSTD_createDCtx() end
    if dctx.is_null() then
      return Result::Err(CompressionError::MemoryError("failed to allocate Zstd decompression context".to_string()))
    end
    Result::Ok(ZstdDecoder {
      reader: reader,
      dctx: dctx,
      buffer: Vec::with_capacity(65536),
    })
  end

  impl[R: Read] Drop for ZstdDecoder[R]
    def drop(inout self: ZstdDecoder[R]) -> Unit
      if self.dctx != (Ptr::null() as Ptr[Unit]) then
        let _ = unsafe "FFI boundary" do ZSTD_freeDCtx(self.dctx) end
      end
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 7: BROTLI COMPRESSION
# ═══════════════════════════════════════════════════════════════

extern "C"
  def BrotliEncoderCompress(quality: i32, lgwin: i32, mode: i32,
                             input_size: UInt, input_buffer: Ptr[u8],
                             encoded_size: PtrMut[UInt], encoded_buffer: PtrMut[u8]) -> i32
  def BrotliDecoderDecompress(encoded_size: UInt, encoded_buffer: Ptr[u8],
                               decoded_size: PtrMut[UInt], decoded_buffer: PtrMut[u8]) -> i32
end

const BROTLI_MODE_GENERIC: i32 = 0
const BROTLI_MODE_TEXT: i32 = 1
const BROTLI_MODE_FONT: i32 = 2
const BROTLI_DEFAULT_QUALITY: i32 = 11
const BROTLI_DEFAULT_WINDOW: i32 = 22

module brotli
  enum BrotliMode
    Generic
    Text
    Font
  end

  def mode_to_int(mode: BrotliMode) -> i32
    match mode
    when BrotliMode::Generic then BROTLI_MODE_GENERIC
    when BrotliMode::Text then BROTLI_MODE_TEXT
    when BrotliMode::Font then BROTLI_MODE_FONT
    end
  end

  def compress(data: [u8]) -> Result[Vec[u8], CompressionError]
    compress_opts(data, BROTLI_DEFAULT_QUALITY, &BrotliMode::Generic)
  end

  def compress_opts(data: [u8], quality: i32, mode: BrotliMode) -> Result[Vec[u8], CompressionError]
    let mut out_size = data.len() + 1024  ## Conservative estimate
    let mut output = vec![0u8; out_size]
    let ret = unsafe "FFI boundary" do
      BrotliEncoderCompress(quality, BROTLI_DEFAULT_WINDOW, mode_to_int(mode),
                             data.len(), data.as_ptr(), &mut out_size as PtrMut[UInt], output.as_mut_ptr())
    end
    if ret == 0 then
      return Result::Err(CompressionError::DataError("Brotli compression failed".to_string()))
    end
    output.truncate(out_size)
    Result::Ok(output)
  end

  def decompress(data: [u8]) -> Result[Vec[u8], CompressionError]
    ## Start with 4x input size estimate, retry with larger if needed
    let mut out_size = data.len() * 4
    let mut output = vec![0u8; out_size]
    let ret = unsafe "FFI boundary" do
      BrotliDecoderDecompress(data.len(), data.as_ptr(), &mut out_size as PtrMut[UInt], output.as_mut_ptr())
    end
    if ret == 0 then
      return Result::Err(CompressionError::DataError("Brotli decompression failed".to_string()))
    end
    output.truncate(out_size)
    Result::Ok(output)
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 8: LZ4 COMPRESSION
# ═══════════════════════════════════════════════════════════════

extern "C"
  def LZ4_compress_default(src: Ptr[u8], dst: PtrMut[u8], srcSize: i32, dstCapacity: i32) -> i32
  def LZ4_decompress_safe(src: Ptr[u8], dst: PtrMut[u8], compressedSize: i32, dstCapacity: i32) -> i32
  def LZ4_compressBound(inputSize: i32) -> i32
end

module lz4
  def compress(data: [u8]) -> Result[Vec[u8], CompressionError]
    let bound = unsafe "FFI boundary" do LZ4_compressBound(data.len() as i32) end
    if bound <= 0 then
      return Result::Err(CompressionError::DataError("LZ4 compressBound failed".to_string()))
    end
    ## Prepend original size as 4 bytes for decompression
    let mut output = vec![0u8; (bound as UInt) + 4]
    let orig_len = data.len() as u32
    output[0] = (orig_len & 0xFF) as u8
    output[1] = ((orig_len >> 8) & 0xFF) as u8
    output[2] = ((orig_len >> 16) & 0xFF) as u8
    output[3] = ((orig_len >> 24) & 0xFF) as u8

    let written = unsafe "FFI boundary" do
      LZ4_compress_default(data.as_ptr(), output.as_mut_ptr().offset(4), data.len() as i32, bound)
    end
    if written <= 0 then
      return Result::Err(CompressionError::DataError("LZ4 compression failed".to_string()))
    end
    output.truncate((written as UInt) + 4)
    Result::Ok(output)
  end

  def decompress(data: [u8]) -> Result[Vec[u8], CompressionError]
    if data.len() < 4 then
      return Result::Err(CompressionError::DataError("LZ4 frame too short".to_string()))
    end
    let orig_len = (data[0] as u32) | ((data[1] as u32) << 8) |
                   ((data[2] as u32) << 16) | ((data[3] as u32) << 24)
    let mut output = vec![0u8; orig_len as UInt]
    let written = unsafe "FFI boundary" do
      LZ4_decompress_safe(data.as_ptr().offset(4), output.as_mut_ptr(),
                           (data.len() - 4) as i32, orig_len as i32)
    end
    if written < 0 then
      return Result::Err(CompressionError::DataError("LZ4 decompression failed".to_string()))
    end
    output.truncate(written as UInt)
    Result::Ok(output)
  end
end
