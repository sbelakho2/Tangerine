## Tangerine Standard Library — std::stats
## Statistical Functions
##
## Provides comprehensive statistical operations:
## - Descriptive statistics (mean, median, mode, variance, etc.)
## - Probability distributions
## - Hypothesis testing
## - Regression analysis
## - Correlation coefficients

use std::collections::Vec
use std::math::{sqrt, pow, exp, log, PI, abs}
use std::core::{Option, Result}

# ———————————————————————————————————————————————————————————————
# Descriptive Statistics
# ———————————————————————————————————————————————————————————————

pub fn mean(data: Vec[f64]) -> f64
  if data.is_empty() then return 0.0 end
  let sum: f64 = data.iter().sum()
  sum / (data.len() as f64)
end

pub fn median(data: Vec[f64]) -> f64
  if data.is_empty() then return 0.0 end
  let mut sorted = data.clone()
  sorted.sort()
  let n = sorted.len()
  if n % 2 == 0 then
    (sorted[n / 2 - 1] + sorted[n / 2]) / 2.0
  else
    sorted[n / 2]
  end
end

pub fn variance(data: Vec[f64]) -> f64
  if data.len() < 2 then return 0.0 end
  let m = mean(data)
  let sum_sq: f64 = data.iter().map(|x| (x - m) * (x - m)).sum()
  sum_sq / ((data.len() - 1) as f64)
end

pub fn std_dev(data: Vec[f64]) -> f64
  sqrt(variance(data))
end

pub fn min_val(data: Vec[f64]) -> f64
  if data.is_empty() then return 0.0 end
  data.iter().fold(f64::INFINITY, |a, &b| if a < b then a else b)
end

pub fn max_val(data: Vec[f64]) -> f64
  if data.is_empty() then return 0.0 end
  data.iter().fold(f64::NEG_INFINITY, |a, &b| if a > b then a else b)
end

pub fn range(data: Vec[f64]) -> f64
  max_val(data) - min_val(data)
end

pub fn percentile(data: Vec[f64], p: f64) -> f64
  if data.is_empty() then return 0.0 end
  let mut sorted = data.clone()
  sorted.sort()
  let n = sorted.len()
  let rank = (p / 100.0) * ((n - 1) as f64)
  let lower = rank.floor() as usize
  let upper = (lower + 1).min(n - 1)
  let frac = rank - (lower as f64)
  sorted[lower] * (1.0 - frac) + sorted[upper] * frac
end

pub fn skewness(data: Vec[f64]) -> f64
  let n = data.len()
  if n < 3 then return 0.0 end
  let m = mean(data)
  let s = std_dev(data)
  if s == 0.0 then return 0.0 end
  let sum_cubed: f64 = data.iter().map(|x| pow((x - m) / s, 3)).sum()
  (n as f64) / (((n - 1) * (n - 2)) as f64) * sum_cubed
end

pub fn kurtosis(data: Vec[f64]) -> f64
  let n = data.len()
  if n < 4 then return 0.0 end
  let m = mean(data)
  let s = std_dev(data)
  if s == 0.0 then return 0.0 end
  let sum_fourth: f64 = data.iter().map(|x| pow((x - m) / s, 4)).sum()
  sum_fourth / (n as f64) - 3.0
end

# ———————————————————————————————————————————————————————————————
# Correlation
# ———————————————————————————————————————————————————————————————

pub fn covariance(x: Vec[f64], y: Vec[f64]) -> f64
  let n = x.len()
  if n != y.len() || n < 2 then return 0.0 end
  let mx = mean(x)
  let my = mean(y)
  let sum: f64 = (0..n).map(|i| (x[i] - mx) * (y[i] - my)).sum()
  sum / ((n - 1) as f64)
end

pub fn correlation(x: Vec[f64], y: Vec[f64]) -> f64
  let cov = covariance(x, y)
  let sx = std_dev(x)
  let sy = std_dev(y)
  if sx == 0.0 || sy == 0.0 then return 0.0 end
  cov / (sx * sy)
end

# ———————————————————————————————————————————————————————————————
# Linear Regression
# ———————————————————————————————————————————————————————————————

pub struct LinearRegression
  pub slope: f64
  pub intercept: f64
  pub r_squared: f64
end

pub fn linear_regression(x: Vec[f64], y: Vec[f64]) -> LinearRegression
  let n = x.len()
  if n != y.len() || n < 2 then
    return LinearRegression { slope: 0.0, intercept: 0.0, r_squared: 0.0 }
  end
  
  let mx = mean(x)
  let my = mean(y)
  let ss_xy: f64 = (0..n).map(|i| (x[i] - mx) * (y[i] - my)).sum()
  let ss_xx: f64 = (0..n).map(|i| (x[i] - mx) * (x[i] - mx)).sum()
  
  let slope = if ss_xx != 0.0 then ss_xy / ss_xx else 0.0
  let intercept = my - slope * mx
  
  let y_pred: Vec[f64] = x.iter().map(|&xi| slope * xi + intercept).collect()
  let ss_tot: f64 = y.iter().map(|&yi| (yi - my) * (yi - my)).sum()
  let ss_res: f64 = (0..n).map(|i| (y[i] - y_pred[i]) * (y[i] - y_pred[i])).sum()
  let r_squared = if ss_tot != 0.0 then 1.0 - ss_res / ss_tot else 0.0
  
  LinearRegression { slope: slope, intercept: intercept, r_squared: r_squared }
end

# ———————————————————————————————————————————————————————————————
# Probability Distributions
# ———————————————————————————————————————————————————————————————

pub fn normal_pdf(x: f64, mean: f64, std: f64) -> f64
  let z = (x - mean) / std
  exp(-0.5 * z * z) / (std * sqrt(2.0 * PI))
end

pub fn normal_cdf(x: f64, mean: f64, std: f64) -> f64
  let z = (x - mean) / std
  0.5 * (1.0 + erf(z / sqrt(2.0)))
end

pub fn t_pdf(x: f64, df: usize) -> f64
  let df_f = df as f64
  let coeff = gamma((df_f + 1.0) / 2.0) / (sqrt(df_f * PI) * gamma(df_f / 2.0))
  coeff * pow(1.0 + x * x / df_f, -((df_f + 1.0) / 2.0))
end

pub fn chi2_pdf(x: f64, df: usize) -> f64
  if x <= 0.0 then return 0.0 end
  let df_f = df as f64
  pow(x, df_f / 2.0 - 1.0) * exp(-x / 2.0) / (pow(2.0, df_f / 2.0) * gamma(df_f / 2.0))
end

# ———————————————————————————————————————————————————————————————
# Hypothesis Testing
# ———————————————————————————————————————————————————————————————

pub struct TTestResult
  pub t_statistic: f64
  pub p_value: f64
  pub df: usize
end

pub fn t_test_one_sample(data: Vec[f64], mu: f64) -> TTestResult
  let n = data.len()
  if n < 2 then return TTestResult { t_statistic: 0.0, p_value: 1.0, df: n - 1 } end
  
  let m = mean(data)
  let s = std_dev(data)
  let se = s / sqrt(n as f64)
  let t = if se != 0.0 then (m - mu) / se else 0.0
  let df = n - 1
  
  TTestResult { t_statistic: t, p_value: 2.0 * (1.0 - t_cdf_abs(abs(t), df)), df: df }
end

# ———————————————————————————————————————————————————————————————
# Helper Functions
# ———————————————————————————————————————————————————————————————

fn erf(x: f64) -> f64
  let a1 =  0.254829592
  let a2 = -0.284496736
  let a3 =  1.421413741
  let a4 = -1.453152027
  let a5 =  1.061405429
  let p  =  0.3275911
  
  let sign = if x < 0.0 then -1.0 else 1.0
  let x = abs(x)
  let t = 1.0 / (1.0 + p * x)
  let y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * exp(-x * x)
  sign * y
end

fn gamma(x: f64) -> f64
  if x <= 0.0 then return f64::INFINITY end
  let g = 7
  let c = vec![0.99999999999980993, 676.5203681218851, -1259.1392167224028,
               771.32342877765313, -176.61502916214059, 12.507343278686905,
               -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7]
  let z = x - 1.0
  let mut x_val = c[0]
  for i in 1..=g + 1 do
    x_val += c[i] / (z + i as f64)
  end
  let t = z + (g as f64) + 0.5
  sqrt(2.0 * PI) * pow(t, z + 0.5) * exp(-t) * x_val
end

fn t_cdf_abs(t: f64, df: usize) -> f64
  # Simplified approximation
  let x = df as f64 / (df as f64 + t * t)
  0.5 + 0.5 * (1.0 - pow(x, df as f64 / 2.0)) * (t / abs(t)).min(1.0).max(-1.0)
end