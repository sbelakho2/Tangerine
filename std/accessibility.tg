# Tangerine Standard Library — tg::accessibility
# Accessibility tree emission for platform screen readers.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 13.4.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::geom::{Rect}
use std::gfx_errors::{AccessibilityError, Error, ErrorCode}
use std::capabilities::{Capability, custom_cap}

# [METADATA]
# module: tg::accessibility
# status: alpha
# effects: [Accessibility]
# capabilities: [Accessibility]
# error_codes: [InvalidArg, Unsupported, PermissionDenied, Internal]

# ═══════════════════════════════════════════════════════════════
# §13.4 Capabilities
# ═══════════════════════════════════════════════════════════════

def accessibility_cap() -> Capability
  custom_cap("Accessibility")
end

# ═══════════════════════════════════════════════════════════════
# §13.4 Types
# ═══════════════════════════════════════════════════════════════

enum Role
  Window
  Button
  Label
  TextField
  Image
  List
  ListItem
  Canvas
  CheckBox
  StaticText
  Group
end

struct A11yNode
  id: u64              # Maps to tg::ui::UiId.value
  role: Role
  label: String
  rect: Rect
  focusable: Bool
  children: Vec[A11yNode]
end

# ═══════════════════════════════════════════════════════════════
# §13.4 Module API
# ═══════════════════════════════════════════════════════════════

use std::time::{instant_now, duration_nanos}
use std::ctx

def tree_emit(root: &A11yNode, cap: &Capability) -> Result[Unit, AccessibilityError]
  # Capability check
  if cap.name != "Accessibility" then
    let err = Error::permission_denied("Accessibility capability required for tree_emit")
    return Result::Err(AccessibilityError::PermissionDenied(err))
  end

  # Serialize the a11y tree and push to the platform accessibility bridge.
  # Reference implementation prints diagnostics; production delegates to
  # the backend's platform accessibility API.
  _emit_recursive(root, 0)

  # Integrate with ctxpacks: capture accessibility tree context
  let seeds = Vec::new()
  seeds.push("accessibility::tree::" + root.id.fmt())
  match std::ctx::build_pack(seeds, 5000)
  when Ok(pack) then
    std::ctx::register_pack(pack)
  when Err(_) then {}
  end

  Result::Ok(())
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry}

# ═══════════════════════════════════════════════════════════════
# §13.4 Internal (Shadow Tree for Platform Bridge)
# ═══════════════════════════════════════════════════════════════

mut SHADOW_A11Y_TREE: Option[A11yNode] = Option::None

def _emit_recursive(node: &A11yNode, depth: Int) -> Unit
  # Walk tree depth-first and synchronize with platform accessibility bridge.
  
  # 1. Log the node emission for diagnostics
  let msg = "Emitting node ID=" + node.id.fmt() + " role=" + _role_name(node.role) + " label='" + node.label + "'"
  _log_a11y_event(LogLevel::Trace, msg)

  # 2. Update the shadow tree at depth 0
  if depth == 0 then
    SHADOW_A11Y_TREE = Option::Some(node.clone())
  end

  # 3. Emit to platform accessibility bridge
  _platform_emit_node(node, depth)

  let i = 0
  while i < node.children.len() do
    _emit_recursive(&node.children.get(i), depth + 1)
    i = i + 1
  end
end

# Platform accessibility bridge — dispatch to OS-specific APIs
def _platform_emit_node(node: &A11yNode, depth: Int) -> Unit
  let role_str = _role_name(node.role)

  @cfg(target_os = "linux")
  {
    # AT-SPI2 bridge via D-Bus
    # Emit an accessible object with properties matching the AT-SPI interface
    _atspi_emit(node.id, role_str, node.label.clone(), depth)
  }
  @cfg(target_os = "macos")
  {
    # NSAccessibility bridge
    _nsaccessibility_emit(node.id, role_str, node.label.clone(), depth)
  }
  @cfg(target_os = "windows")
  {
    # UI Automation (UIA) bridge
    _uia_emit(node.id, role_str, node.label.clone(), depth)
  }
end

# AT-SPI2 (Linux) — emit accessible element via D-Bus org.a]11y.atspi interface
@cfg(target_os = "linux")
def _atspi_emit(id: u64, role: String, label: String, depth: Int) -> Unit
  # Construct D-Bus message to org.a11y.atspi.Registry
  # Path: /org/a11y/atspi/accessible/<id>
  # Interface: org.a11y.atspi.Accessible
  # Properties: Name=label, Role=role
  let path = "/org/a11y/atspi/accessible/" + id.to_string()
  match __intrinsic_dbus_call(
    "org.a11y.atspi.Registry",
    path,
    "org.a11y.atspi.Accessible",
    "SetProperties",
    [("Name", label), ("Role", role)]
  )
  when Result::Ok(_) then ()
  when Result::Err(e) then
    _log_a11y_event(LogLevel::Warn, "AT-SPI emit failed: " + e)
  end
end

# NSAccessibility (macOS) — emit via Objective-C runtime bridge
@cfg(target_os = "macos")
def _nsaccessibility_emit(id: u64, role: String, label: String, depth: Int) -> Unit
  match __intrinsic_objc_call(
    "NSAccessibilityElement",
    "setAccessibilityRole:label:",
    [_ns_role_from_string(role), label]
  )
  when Result::Ok(_) then ()
  when Result::Err(e) then
    _log_a11y_event(LogLevel::Warn, "NSAccessibility emit failed: " + e)
  end
end

@cfg(target_os = "macos")
def _ns_role_from_string(role: String) -> String
  match role.as_str()
  when "Window" then "AXWindow"
  when "Button" then "AXButton"
  when "Label" then "AXStaticText"
  when "TextField" then "AXTextField"
  when "Image" then "AXImage"
  when "List" then "AXList"
  when "CheckBox" then "AXCheckBox"
  when _ then "AXGroup"
  end
end

# UI Automation (Windows) — emit via UIA provider interface
@cfg(target_os = "windows")
def _uia_emit(id: u64, role: String, label: String, depth: Int) -> Unit
  match __intrinsic_uia_call(
    "RaiseAutomationEvent",
    id,
    _uia_control_type(role),
    label
  )
  when Result::Ok(_) then ()
  when Result::Err(e) then
    _log_a11y_event(LogLevel::Warn, "UIA emit failed: " + e)
  end
end

@cfg(target_os = "windows")
def _uia_control_type(role: String) -> Int
  match role.as_str()
  when "Window" then 50032
  when "Button" then 50000
  when "Label" then 50020
  when "TextField" then 50004
  when "Image" then 50006
  when "List" then 50008
  when "CheckBox" then 50002
  when _ then 50026  # Group
  end
end

# Platform intrinsics — provided by codegen backend or runtime
extern def __intrinsic_dbus_call(dest: &str, path: String, iface: &str, method: &str, args: &[(String, String)]) -> Result[Unit, String]
extern def __intrinsic_objc_call(cls: &str, selector: &str, args: &[String]) -> Result[Unit, String]
extern def __intrinsic_uia_call(method: &str, id: u64, control_type: Int, name: String) -> Result[Unit, String]

def _role_name(role: Role) -> String
  match role
  when Role::Window then "Window".to_string()
  when Role::Button then "Button".to_string()
  when Role::Label then "Label".to_string()
  when Role::TextField then "TextField".to_string()
  when Role::Image then "Image".to_string()
  when Role::List then "List".to_string()
  when Role::ListItem then "ListItem".to_string()
  when Role::Canvas then "Canvas".to_string()
  when Role::CheckBox then "CheckBox".to_string()
  when Role::StaticText then "StaticText".to_string()
  when Role::Group then "Group".to_string()
  end
end

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_a11y_event(level: LogLevel, msg: String) -> Unit
  match &GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::Accessibility,
      message: "[A11Y] " + msg,
      correlation_id: "".to_string()
    }
    logger.log(entry)
  when Option::None then {}
  end
end
