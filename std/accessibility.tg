# Tangerine Standard Library — tg::accessibility
# Accessibility tree emission for platform screen readers.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 13.4.

use std::core::{Option, Result, String, Bool, Int, Unit}
use std::geom::{Rect}

# ═══════════════════════════════════════════════════════════════
# §13.4 Types
# ═══════════════════════════════════════════════════════════════

enum Role
  Window
  Button
  Label
  TextField
  Image
  List
  ListItem
  Canvas
end

struct A11yNode
  id: u64              # Maps to tg::ui::UiId.value
  role: Role
  label: String
  rect: Rect
  focusable: Bool
  children: Vec[A11yNode]
end

# ═══════════════════════════════════════════════════════════════
# §13.4 Module API
# ═══════════════════════════════════════════════════════════════

def tree_emit(root: &A11yNode) -> Unit
  # Serialize the a11y tree and push to the platform accessibility bridge.
  # Reference implementation prints diagnostics; production delegates to
  # the backend's platform accessibility API.
  _emit_recursive(root, 0)
end

# ═══════════════════════════════════════════════════════════════
# Internal
# ═══════════════════════════════════════════════════════════════

def _emit_recursive(node: &A11yNode, depth: Int) -> Unit
  # Walk tree depth-first.
  let role_name = match node.role
  when Role::Window then "Window"
  when Role::Button then "Button"
  when Role::Label then "Label"
  when Role::TextField then "TextField"
  when Role::Image then "Image"
  when Role::List then "List"
  when Role::ListItem then "ListItem"
  when Role::Canvas then "Canvas"
  end

  # In production the tree is serialized to the platform a11y bridge.
  # Reference impl: no-op traversal (validates tree structure).
  let i = 0
  while i < node.children.len() do
    _emit_recursive(&node.children.get(i), depth + 1)
    i = i + 1
  end
end
