use std::core::{Option, Result, String, Bool, Int, Vec, to_string}
use std::io::{print, println, stdout, flush}
use std::collections::{Map}

# ═══════════════════════════════════════════════════════════════
# §14.1 — Low-level Terminal Handling
# ═══════════════════════════════════════════════════════════════

@ffi("c") extern def isatty(fd: Int) -> Int end
@ffi("c") extern def ioctl(fd: Int, request: UInt, arg: PtrMut[u8]) -> Int end
@ffi("c") extern def tcgetattr(fd: Int, termios: PtrMut[u8]) -> Int end
@ffi("c") extern def tcsetattr(fd: Int, optional_actions: Int, termios: Ptr[u8]) -> Int end

# Platform-specific constants (Linux/macOS)
const STDIN_FILENO: Int = 0
const STDOUT_FILENO: Int = 1
const TIOCGWINSZ: UInt = 0x40087468 # macOS; Linux is 0x5413

struct TermSize
  rows: u16
  cols: u16
  xpixel: u16
  ypixel: u16
end

def get_terminal_size() -> Option[TermSize]
  let mut size = TermSize { rows: 0, cols: 0, xpixel: 0, ypixel: 0 }
  let res = unsafe { ioctl(STDOUT_FILENO, TIOCGWINSZ, &size as PtrMut[u8]) }
  if res == 0 then
    Option::Some(size)
  else
    Option::None
  end
end

# ═══════════════════════════════════════════════════════════════
# §14.2 — ANSI Escape Sequences
# ═══════════════════════════════════════════════════════════════

def clear_screen() -> Unit
  print("\x1b[2J\x1b[H")
end

def move_cursor(row: Int, col: Int) -> Unit
  print("\x1b[" + (row + 1).to_string() + ";" + (col + 1).to_string() + "H")
end

def hide_cursor() -> Unit
  print("\x1b[?25l")
end

def show_cursor() -> Unit
  print("\x1b[?25h")
end

enum Color
  Black
  Red
  Green
  Yellow
  Blue
  Magenta
  Cyan
  White
  Default
end

def set_fg(color: Color) -> Unit
  let code = match color
    when Color::Black then "30"
    when Color::Red then "31"
    when Color::Green then "32"
    when Color::Yellow then "33"
    when Color::Blue then "34"
    when Color::Magenta then "35"
    when Color::Cyan then "36"
    when Color::White then "37"
    when Color::Default then "39"
  end
  print("\x1b[" + code + "m")
end

def set_bg(color: Color) -> Unit
  let code = match color
    when Color::Black then "40"
    when Color::Red then "41"
    when Color::Green then "42"
    when Color::Yellow then "43"
    when Color::Blue then "44"
    when Color::Magenta then "45"
    when Color::Cyan then "46"
    when Color::White then "47"
    when Color::Default then "49"
  end
  print("\x1b[" + code + "m")
end

def reset_style() -> Unit
  print("\x1b[0m")
end

# ═══════════════════════════════════════════════════════════════
# §14.3 — TUI Framework (Widgets)
# ═══════════════════════════════════════════════════════════════

struct Rect
  x: Int
  y: Int
  width: Int
  height: Int
end

trait Widget
  def render(self: Self, area: Rect) -> Unit
end

struct Label
  text: String
  color: Color
end

impl Widget for Label
  def render(self: Self, area: Rect) -> Unit
    move_cursor(area.y, area.x)
    set_fg(self.color)
    print(self.text.clone())
    reset_style()
  end
end

struct BoxWidget
  title: String
  border_color: Color
end

impl Widget for BoxWidget
  def render(self: Self, area: Rect) -> Unit
    set_fg(self.border_color)
    
    # Top border
    move_cursor(area.y, area.x)
    print("┌")
    let mut i = 1
    while i < area.width - 1 do
      print("─")
      i = i + 1
    end
    print("┐")
    
    # Sides
    let mut j = 1
    while j < area.height - 1 do
      move_cursor(area.y + j, area.x)
      print("│")
      move_cursor(area.y + j, area.x + area.width - 1)
      print("│")
      j = j + 1
    end
    
    # Bottom border
    move_cursor(area.y + area.height - 1, area.x)
    print("└")
    i = 1
    while i < area.width - 1 do
      print("─")
      i = i + 1
    end
    print("┘")
    
    # Title
    if !self.title.is_empty() then
      move_cursor(area.y, area.x + 2)
      print(" " + self.title.clone() + " ")
    end
    
    reset_style()
  end
end

# ═══════════════════════════════════════════════════════════════
# §14.4 — Main Loop & Events
# ═══════════════════════════════════════════════════════════════

struct Terminal
  size: TermSize
end

impl Terminal
  def new() -> Option[Terminal]
    match get_terminal_size()
    when Option::Some(s) then Option::Some(Terminal { size: s })
    when Option::None then Option::None
    end
  end

  def refresh(inout self: Terminal) -> Unit
    match get_terminal_size()
    when Option::Some(s) then self.size = s
    when Option::None then ()
    end
  end
end
