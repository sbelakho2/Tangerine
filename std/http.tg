# Tangerine Standard Library — HTTP
#
# HTTP/1.1 client and server with connection pooling and TLS support.
#
# Usage:
#   let resp = http::get("https://example.com")?
#   let body = resp.text()?
#
#   let client = HttpClient::new()
#   let resp = client.post("https://api.example.com/data")
#     .header("Content-Type", "application/json")
#     .body("{\"key\": \"value\"}")
#     .send()?

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{Map}
use std::io::{IOError}
use std::net::{TcpStream, tcp_connect_host}
use std::thread::{AtomicInt, Ordering, thread_yield}
use std::url::{Url, UrlError}
use std::serde::{Serialize, Deserialize}
use std::json

# [METADATA]
# module: tg::http
# status: alpha
# effects: [Net]
# capabilities: [Net]
# error_codes: [InvalidUrl, ConnectionFailed, Timeout, Internal]

use std::ctx

# ———————————————————————————————————————————————————————————————
# HTTP Methods
# ———————————————————————————————————————————————————————————————

enum HttpMethod
  Get
  Post
  Put
  Delete
  Patch
  Head
  Options
  Connect
  Trace
end

def method_to_string(m: &HttpMethod) -> String
  match m
  when HttpMethod::Get then "GET"
  when HttpMethod::Post then "POST"
  when HttpMethod::Put then "PUT"
  when HttpMethod::Delete then "DELETE"
  when HttpMethod::Patch then "PATCH"
  when HttpMethod::Head then "HEAD"
  when HttpMethod::Options then "OPTIONS"
  when HttpMethod::Connect then "CONNECT"
  when HttpMethod::Trace then "TRACE"
  end.to_string()
end

def method_from_string(s: &str) -> Option[HttpMethod]
  match s.to_uppercase().as_str()
  when "GET" then Option::Some(HttpMethod::Get)
  when "POST" then Option::Some(HttpMethod::Post)
  when "PUT" then Option::Some(HttpMethod::Put)
  when "DELETE" then Option::Some(HttpMethod::Delete)
  when "PATCH" then Option::Some(HttpMethod::Patch)
  when "HEAD" then Option::Some(HttpMethod::Head)
  when "OPTIONS" then Option::Some(HttpMethod::Options)
  when "CONNECT" then Option::Some(HttpMethod::Connect)
  when "TRACE" then Option::Some(HttpMethod::Trace)
  when _ then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# HTTP Status
# ———————————————————————————————————————————————————————————————

struct HttpStatus
  code: UInt
  reason: String
end

def HttpStatus::new(code: UInt) -> HttpStatus
  HttpStatus {
    code: code,
    reason: status_reason(code)
  }
end

def status_reason(code: UInt) -> String
  match code
  when 100 then "Continue"
  when 101 then "Switching Protocols"
  when 200 then "OK"
  when 201 then "Created"
  when 202 then "Accepted"
  when 204 then "No Content"
  when 206 then "Partial Content"
  when 301 then "Moved Permanently"
  when 302 then "Found"
  when 303 then "See Other"
  when 304 then "Not Modified"
  when 307 then "Temporary Redirect"
  when 308 then "Permanent Redirect"
  when 400 then "Bad Request"
  when 401 then "Unauthorized"
  when 403 then "Forbidden"
  when 404 then "Not Found"
  when 405 then "Method Not Allowed"
  when 408 then "Request Timeout"
  when 409 then "Conflict"
  when 410 then "Gone"
  when 413 then "Payload Too Large"
  when 415 then "Unsupported Media Type"
  when 422 then "Unprocessable Entity"
  when 429 then "Too Many Requests"
  when 500 then "Internal Server Error"
  when 502 then "Bad Gateway"
  when 503 then "Service Unavailable"
  when 504 then "Gateway Timeout"
  when _ then "Unknown"
  end.to_string()
end

impl HttpStatus
  def is_informational(self: &HttpStatus) -> Bool
    self.code >= 100 && self.code < 200
  end
  def is_success(self: &HttpStatus) -> Bool
    self.code >= 200 && self.code < 300
  end
  def is_redirect(self: &HttpStatus) -> Bool
    self.code >= 300 && self.code < 400
  end
  def is_client_error(self: &HttpStatus) -> Bool
    self.code >= 400 && self.code < 500
  end
  def is_server_error(self: &HttpStatus) -> Bool
    self.code >= 500 && self.code < 600
  end
  def is_error(self: &HttpStatus) -> Bool
    self.code >= 400
  end
end

# ———————————————————————————————————————————————————————————————
# HTTP Headers
# ———————————————————————————————————————————————————————————————

struct HttpHeaders
  entries: Vec[(String, String)]
end

def HttpHeaders::new() -> HttpHeaders
  HttpHeaders { entries: Vec::new() }
end

impl HttpHeaders
  def get(self: &HttpHeaders, name: &str) -> Option[&String]
    let lower = name.to_lowercase()
    for entry in self.entries do
      let (k, v) = entry
      if *k == lower then
        return Option::Some(&v)
      end
    end
    Option::None
  end
  
  def get_all(self: &HttpHeaders, name: &str) -> Vec[&String]
    let lower = name.to_lowercase()
    let mut result = Vec::new()
    for entry in self.entries do
      let (k, v) = entry
      if *k == lower then
        result.push(&v)
      end
    end
    result
  end
  
  def set(self: &mut HttpHeaders, name: &str, value: &str) -> Unit
    let lower = name.to_lowercase()
    # Remove existing
    self.entries.retain(|e| e.0 != lower)
    # Add new
    self.entries.push((lower, value.to_string()))
  end
  
  def append(self: &mut HttpHeaders, name: &str, value: &str) -> Unit
    self.entries.push((name.to_lowercase(), value.to_string()))
  end
  
  def remove(self: &mut HttpHeaders, name: &str) -> Unit
    let lower = name.to_lowercase()
    self.entries.retain(|e| e.0 != lower)
  end
  
  def contains(self: &HttpHeaders, name: &str) -> Bool
    self.get(name).is_some()
  end
  
  def iter(self: &HttpHeaders) -> &Vec[(String, String)]
    &self.entries
  end
  
  def content_type(self: &HttpHeaders) -> Option[&String]
    self.get("content-type")
  end
  
  def content_length(self: &HttpHeaders) -> Option[UInt]
    match self.get("content-length")
    when Option::Some(v) then parse_uint(v)
    when Option::None then Option::None
    end
  end
end

# ———————————————————————————————————————————————————————————————

# ———————————————————————————————————————————————————————————————

struct Cookie
  name: String
  value: String
  domain: Option[String]
  path: Option[String]
  expires: Option[String]
  max_age: Option[Int]
  secure: Bool
  http_only: Bool
  same_site: Option[String]
end

def Cookie::new(name: String, value: String) -> Cookie
  Cookie {
    name: name,
    value: value,
    domain: Option::None,
    path: Option::None,
    expires: Option::None,
    max_age: Option::None,
    secure: false,
    http_only: false,
    same_site: Option::None
  }
end

impl Cookie
  def to_header_value(self: &Cookie) -> String
    self.name.clone() + "=" + self.value.clone()
  end
  
  def parse(s: &str) -> Option[Cookie]
    # Parse "name=value; attr1; attr2=val2"
    let parts: Vec[&str] = s.split(';').collect()
    if parts.is_empty() then
      return Option::None
    end
    
    # First part is name=value
    let nv: Vec[&str] = parts[0].trim().splitn(2, '=').collect()
    if nv.len() < 2 then
      return Option::None
    end
    
    let mut cookie = Cookie::new(nv[0].to_string(), nv[1].to_string())
    
    # Parse attributes
    let mut i = 1
    while i < parts.len() do
      let attr = parts[i].trim()
      let kv: Vec[&str] = attr.splitn(2, '=').collect()
      let key = kv[0].to_lowercase()
      
      match key.as_str()
      when "domain" then
        if kv.len() > 1 then cookie.domain = Option::Some(kv[1].to_string()) end
      when "path" then
        if kv.len() > 1 then cookie.path = Option::Some(kv[1].to_string()) end
      when "expires" then
        if kv.len() > 1 then cookie.expires = Option::Some(kv[1].to_string()) end
      when "max-age" then
        if kv.len() > 1 then
          match kv[1].parse::<Int>()
          when Result::Ok(n) then cookie.max_age = Option::Some(n)
          when _ then ()
          end
        end
      when "secure" then cookie.secure = true
      when "httponly" then cookie.http_only = true
      when "samesite" then
        if kv.len() > 1 then cookie.same_site = Option::Some(kv[1].to_string()) end
      when _ then ()
      end
      
      i = i + 1
    end
    
    Option::Some(cookie)
  end
end

# Cookie jar for managing cookies
struct CookieJar
  cookies: Map[String, Cookie]   # domain+path+name -> cookie
end

def CookieJar::new() -> CookieJar
  CookieJar { cookies: Map::new() }
end

impl CookieJar
  def add(self: &mut CookieJar, cookie: Cookie) -> Unit
    let key = self.cookie_key(&cookie)
    self.cookies.insert(key, cookie)
  end
  
  def get(self: &CookieJar, name: &str, domain: &str, path: &str) -> Option[&Cookie]
    let key = domain.to_string() + "|" + path + "|" + name
    self.cookies.get(&key)
  end
  
  def cookies_for_url(self: &CookieJar, url: &Url) -> Vec[&Cookie]
    let mut result = Vec::new()
    for (_, cookie) in self.cookies.iter() do
      if self.cookie_matches(cookie, url) then
        result.push(cookie)
      end
    end
    result
  end
  
  def cookie_key(self: &CookieJar, c: &Cookie) -> String
    let domain = match c.domain
    when Option::Some(ref d) then d.clone()
    when Option::None then "".to_string()
    end
    let path = match c.path
    when Option::Some(ref p) then p.clone()
    when Option::None then "/".to_string()
    end
    domain + "|" + path.as_str() + "|" + c.name.as_str()
  end
  
  def cookie_matches(self: &CookieJar, c: &Cookie, url: &Url) -> Bool
    # Check domain match
    match c.domain
    when Option::Some(ref d) then
      if !url.host().ends_with(d.as_str()) then
        return false
      end
    when Option::None then ()
    end
    
    # Check path match
    match c.path
    when Option::Some(ref p) then
      if !url.path().starts_with(p.as_str()) then
        return false
      end
    when Option::None then ()
    end
    
    # Check secure
    if c.secure && url.scheme() != "https" then
      return false
    end
    
    true
  end
  
  def to_header_value(self: &CookieJar, url: &Url) -> String
    let cookies = self.cookies_for_url(url)
    let mut parts = Vec::new()
    for c in cookies do
      parts.push(c.to_header_value())
    end
    parts.join("; ")
  end
end

# ———————————————————————————————————————————————————————————————
# HTTP Request
# ———————————————————————————————————————————————————————————————

struct HttpRequest
  method: HttpMethod
  url: Url
  headers: HttpHeaders
  body: Option[Vec[u8]]
end

def HttpRequest::new(method: HttpMethod, url: Url) -> HttpRequest
  HttpRequest {
    method: method,
    url: url,
    headers: HttpHeaders::new(),
    body: Option::None
  }
end

impl HttpRequest
  def header(self: &mut HttpRequest, name: &str, value: &str) -> &mut HttpRequest
    self.headers.set(name, value)
    self
  end
  
  def body_bytes(self: &mut HttpRequest, data: Vec[u8]) -> &mut HttpRequest
    self.body = Option::Some(data)
    self
  end
  
  def body_string(self: &mut HttpRequest, data: &str) -> &mut HttpRequest
    self.body = Option::Some(data.as_bytes().to_vec())
    self
  end
  
  def body_json[T: Serialize](self: &mut HttpRequest, data: &T) -> Result[&mut HttpRequest, HttpError]
    match json::to_json(data)
    when Result::Ok(json_str) then
      self.headers.set("Content-Type", "application/json")
      self.body = Option::Some(json_str.as_bytes().to_vec())
      Result::Ok(self)
    when Result::Err(e) then Result::Err(HttpError::Serialize(std::serde::ser_error_message(&e)))
    end
  end
  
  def serialize(self: &HttpRequest) -> Vec[u8]
    let mut request = String::new()
    
    # Request line
    request.push_str(method_to_string(&self.method).as_str())
    request.push(' ')
    request.push_str(self.url.path().as_str())
    match self.url.query()
    when Option::Some(q) then
      request.push('?')
      request.push_str(q.as_str())
    when Option::None then ()
    end
    request.push_str(" HTTP/1.1\r\n")
    
    # Host header
    match self.url.host()
    when Option::Some(h) then
      request.push_str("Host: ")
      request.push_str(h.as_str())
      let port = self.url.port_or_default()
      if port != 80 && port != 443 then
        request.push(':')
        request.push_str(port.to_string().as_str())
      end
      request.push_str("\r\n")
    when Option::None then ()
    end
    
    # Other headers
    for entry in self.headers.iter() do
      let (k, v) = entry
      if k.to_lowercase() != "host" then
        request.push_str(k.as_str())
        request.push_str(": ")
        request.push_str(v.as_str())
        request.push_str("\r\n")
      end
    end
    
    # Content-Length
    match self.body
    when Option::Some(b) then
      if !self.headers.contains("content-length") then
        request.push_str("Content-Length: ")
        request.push_str(b.len().to_string().as_str())
        request.push_str("\r\n")
      end
    when Option::None then ()
    end
    
    # End of headers
    request.push_str("\r\n")
    
    let mut result = request.as_bytes().to_vec()
    match self.body
    when Option::Some(b) then result.extend(&b)
    when Option::None then ()
    end
    
    result
  end
end

# ———————————————————————————————————————————————————————————————
# HTTP Response
# ———————————————————————————————————————————————————————————————

struct HttpResponse
  status: HttpStatus
  headers: HttpHeaders
  body: Vec[u8]
end

impl HttpResponse
  def status_code(self: &HttpResponse) -> UInt
    self.status.code
  end
  def is_success(self: &HttpResponse) -> Bool
    self.status.is_success()
  end
  def is_error(self: &HttpResponse) -> Bool
    self.status.is_error()
  end
  
  def text(self: &HttpResponse) -> Result[String, HttpError]
    match String::from_utf8(&self.body)
    when Result::Ok(s) then Result::Ok(s)
    when Result::Err(_) then Result::Err(HttpError::InvalidUtf8)
    end
  end
  
  def json[T: Deserialize](self: &HttpResponse) -> Result[T, HttpError]
    let text = self.text()?
    match json::from_json[T](text.as_str())
    when Result::Ok(v) then Result::Ok(v)
    when Result::Err(e) then Result::Err(HttpError::Deserialize(json::json_error_message(&e)))
    end
  end
  
  def bytes(self: &HttpResponse) -> &Vec[u8]
    &self.body
  end
end

# ———————————————————————————————————————————————————————————————

# ———————————————————————————————————————————————————————————————

struct StreamingResponse
  status: HttpStatus
  headers: HttpHeaders
  stream: TcpStream
  remaining: UInt   # Bytes remaining for content-length, or 0 for chunked
  chunked: Bool
  done: Bool
end

impl StreamingResponse
  def status_code(self: &StreamingResponse) -> UInt
    self.status.code
  end
  
  def headers(self: &StreamingResponse) -> &HttpHeaders
    &self.headers
  end
  
  # Read next chunk of body data
  def read_chunk(self: &mut StreamingResponse, max_size: UInt) -> Result[Vec[u8], HttpError]
    if self.done then
      return Result::Ok(Vec::new())
    end
    
    if self.chunked then
      # HTTP/1.1 chunked transfer encoding
      let mut buf: [u8; 256] = [0; 256]
      
      # Read chunk size line (hex\r\n)
      let mut size_line = String::new()
      loop
        let mut byte: [u8; 1] = [0; 1]
        match self.stream.read(&mut byte)
        when Result::Ok(1) then
          if byte[0] == '\n' as u8 then
            break
          elsif byte[0] != '\r' as u8 then
            size_line.push(byte[0] as Char)
          end
        when Result::Ok(_) then break
        when Result::Err(e) then return Result::Err(HttpError::Io(e))
        end
      end
      
      # Parse chunk size
      let chunk_size = match UInt::from_str_radix(size_line.trim(), 16)
      when Result::Ok(n) then n
      when Result::Err(_) then return Result::Err(HttpError::InvalidResponse("invalid chunk size"))
      end
      
      if chunk_size == 0 then
        self.done = true
        return Result::Ok(Vec::new())
      end
      
      # Read chunk data
      let mut data = Vec::new()
      let to_read = chunk_size.min(max_size)
      let mut read_buf = vec![0u8; to_read as Int]
      match self.stream.read(&mut read_buf)
      when Result::Ok(n) then
        data.extend(&read_buf[0..n])
      when Result::Err(e) then return Result::Err(HttpError::Io(e))
      end
      
      # Skip trailing \r\n
      let mut crlf: [u8; 2] = [0; 2]
      self.stream.read(&mut crlf)
      
      Result::Ok(data)
    else
      # Content-Length based
      if self.remaining == 0 then
        self.done = true
        return Result::Ok(Vec::new())
      end
      
      let to_read = self.remaining.min(max_size).min(8192) as Int
      let mut buf = vec![0u8; to_read]
      
      match self.stream.read(&mut buf)
      when Result::Ok(n) then
        self.remaining = self.remaining - (n as UInt)
        if self.remaining == 0 then
          self.done = true
        end
        Result::Ok(buf[0..n].to_vec())
      when Result::Err(e) then Result::Err(HttpError::Io(e))
      end
    end
  end
  
  # Read entire body
  def read_all(self: &mut StreamingResponse) -> Result[Vec[u8], HttpError]
    let mut body = Vec::new()
    while !self.done do
      let chunk = self.read_chunk(65536)?
      body.extend(&chunk)
    end
    Result::Ok(body)
  end
end

# ———————————————————————————————————————————————————————————————
# HTTP/2 Frame Types and Multiplexing
# ———————————————————————————————————————————————————————————————

# HTTP/2 frame type identifiers (RFC 7540 Section 6)
const H2_FRAME_DATA: u8          = 0x0
const H2_FRAME_HEADERS: u8       = 0x1
const H2_FRAME_PRIORITY: u8      = 0x2
const H2_FRAME_RST_STREAM: u8    = 0x3
const H2_FRAME_SETTINGS: u8      = 0x4
const H2_FRAME_PUSH_PROMISE: u8  = 0x5
const H2_FRAME_PING: u8          = 0x6
const H2_FRAME_GOAWAY: u8        = 0x7
const H2_FRAME_WINDOW_UPDATE: u8 = 0x8
const H2_FRAME_CONTINUATION: u8  = 0x9

# HTTP/2 frame flags
const H2_FLAG_END_STREAM: u8  = 0x1
const H2_FLAG_END_HEADERS: u8 = 0x4
const H2_FLAG_PADDED: u8      = 0x8
const H2_FLAG_PRIORITY: u8    = 0x20

# HTTP/2 error codes (RFC 7540 Section 7)
enum H2ErrorCode
  NoError
  ProtocolError
  InternalError
  FlowControlError
  SettingsTimeout
  StreamClosed
  FrameSizeError
  RefusedStream
  Cancel
  CompressionError
  ConnectError
  EnhanceYourCalm
  InadequateSecurity
  Http11Required
end

def h2_error_code_value(e: &H2ErrorCode) -> u32
  match e
  when H2ErrorCode::NoError then 0x0
  when H2ErrorCode::ProtocolError then 0x1
  when H2ErrorCode::InternalError then 0x2
  when H2ErrorCode::FlowControlError then 0x3
  when H2ErrorCode::SettingsTimeout then 0x4
  when H2ErrorCode::StreamClosed then 0x5
  when H2ErrorCode::FrameSizeError then 0x6
  when H2ErrorCode::RefusedStream then 0x7
  when H2ErrorCode::Cancel then 0x8
  when H2ErrorCode::CompressionError then 0x9
  when H2ErrorCode::ConnectError then 0xa
  when H2ErrorCode::EnhanceYourCalm then 0xb
  when H2ErrorCode::InadequateSecurity then 0xc
  when H2ErrorCode::Http11Required then 0xd
  end
end

# HTTP/2 settings identifiers
const H2_SETTINGS_HEADER_TABLE_SIZE: u16      = 0x1
const H2_SETTINGS_ENABLE_PUSH: u16            = 0x2
const H2_SETTINGS_MAX_CONCURRENT_STREAMS: u16 = 0x3
const H2_SETTINGS_INITIAL_WINDOW_SIZE: u16    = 0x4
const H2_SETTINGS_MAX_FRAME_SIZE: u16         = 0x5
const H2_SETTINGS_MAX_HEADER_LIST_SIZE: u16   = 0x6

# HTTP/2 connection preface
const H2_PREFACE: &str = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

# A raw HTTP/2 frame (9-byte header + payload)
struct H2Frame
  length: u32       # 24-bit payload length
  frame_type: u8    # frame type identifier
  flags: u8         # type-specific flags
  stream_id: u32    # 31-bit stream identifier (high bit reserved)
  payload: Vec[u8]  # frame payload
end

def H2Frame::new(frame_type: u8, flags: u8, stream_id: u32, payload: Vec[u8]) -> H2Frame
  H2Frame {
    length: payload.len() as u32,
    frame_type: frame_type,
    flags: flags,
    stream_id: stream_id & 0x7FFFFFFF,
    payload: payload
  }
end

impl H2Frame
  def serialize(self: &H2Frame) -> Vec[u8]
    let mut buf = Vec::new()
    # 3-byte length (big-endian)
    buf.push(((self.length >> 16) & 0xFF) as u8)
    buf.push(((self.length >> 8) & 0xFF) as u8)
    buf.push((self.length & 0xFF) as u8)
    # 1-byte type
    buf.push(self.frame_type)
    # 1-byte flags
    buf.push(self.flags)
    # 4-byte stream id (big-endian, high bit reserved = 0)
    buf.push(((self.stream_id >> 24) & 0x7F) as u8)
    buf.push(((self.stream_id >> 16) & 0xFF) as u8)
    buf.push(((self.stream_id >> 8) & 0xFF) as u8)
    buf.push((self.stream_id & 0xFF) as u8)
    # Payload
    buf.extend(&self.payload)
    buf
  end

  def parse(data: &[u8]) -> Result[H2Frame, String]
    if data.len() < 9 then
      return Result::Err("HTTP/2 frame too short".to_string())
    end
    let length = ((data[0] as u32) << 16) | ((data[1] as u32) << 8) | (data[2] as u32)
    let frame_type = data[3]
    let flags = data[4]
    let stream_id = ((data[5] as u32 & 0x7F) << 24) | ((data[6] as u32) << 16) |
                    ((data[7] as u32) << 8) | (data[8] as u32)

    if data.len() < 9 + length as UInt then
      return Result::Err("HTTP/2 frame payload incomplete".to_string())
    end

    let payload = data[9..(9 + length as UInt)].to_vec()
    Result::Ok(H2Frame {
      length: length,
      frame_type: frame_type,
      flags: flags,
      stream_id: stream_id,
      payload: payload
    })
  end

  def is_end_stream(self: &H2Frame) -> Bool
    (self.flags & H2_FLAG_END_STREAM) != 0
  end

  def is_end_headers(self: &H2Frame) -> Bool
    (self.flags & H2_FLAG_END_HEADERS) != 0
  end
end

def h2_settings_frame(settings: &Vec[(u16, u32)]) -> H2Frame
  let mut payload = Vec::new()
  for (id, val) in settings do
    payload.push(((*id >> 8) & 0xFF) as u8)
    payload.push((*id & 0xFF) as u8)
    payload.push(((*val >> 24) & 0xFF) as u8)
    payload.push(((*val >> 16) & 0xFF) as u8)
    payload.push(((*val >> 8) & 0xFF) as u8)
    payload.push((*val & 0xFF) as u8)
  end
  H2Frame::new(H2_FRAME_SETTINGS, 0, 0, payload)
end

def h2_settings_ack() -> H2Frame
  H2Frame::new(H2_FRAME_SETTINGS, H2_FLAG_END_STREAM, 0, Vec::new())
end

def h2_data_frame(stream_id: u32, data: Vec[u8], end_stream: Bool) -> H2Frame
  let flags = if end_stream then H2_FLAG_END_STREAM else 0 end
  H2Frame::new(H2_FRAME_DATA, flags, stream_id, data)
end

def h2_headers_frame(stream_id: u32, header_block: Vec[u8], end_stream: Bool, end_headers: Bool) -> H2Frame
  let mut flags: u8 = 0
  if end_stream then flags = flags | H2_FLAG_END_STREAM end
  if end_headers then flags = flags | H2_FLAG_END_HEADERS end
  H2Frame::new(H2_FRAME_HEADERS, flags, stream_id, header_block)
end

def h2_rst_stream_frame(stream_id: u32, error_code: H2ErrorCode) -> H2Frame
  let code = h2_error_code_value(&error_code)
  let mut payload = Vec::new()
  payload.push(((code >> 24) & 0xFF) as u8)
  payload.push(((code >> 16) & 0xFF) as u8)
  payload.push(((code >> 8) & 0xFF) as u8)
  payload.push((code & 0xFF) as u8)
  H2Frame::new(H2_FRAME_RST_STREAM, 0, stream_id, payload)
end

def h2_goaway_frame(last_stream_id: u32, error_code: H2ErrorCode) -> H2Frame
  let code = h2_error_code_value(&error_code)
  let mut payload = Vec::new()
  payload.push(((last_stream_id >> 24) & 0x7F) as u8)
  payload.push(((last_stream_id >> 16) & 0xFF) as u8)
  payload.push(((last_stream_id >> 8) & 0xFF) as u8)
  payload.push((last_stream_id & 0xFF) as u8)
  payload.push(((code >> 24) & 0xFF) as u8)
  payload.push(((code >> 16) & 0xFF) as u8)
  payload.push(((code >> 8) & 0xFF) as u8)
  payload.push((code & 0xFF) as u8)
  H2Frame::new(H2_FRAME_GOAWAY, 0, 0, payload)
end

def h2_window_update_frame(stream_id: u32, increment: u32) -> H2Frame
  let mut payload = Vec::new()
  payload.push(((increment >> 24) & 0x7F) as u8)
  payload.push(((increment >> 16) & 0xFF) as u8)
  payload.push(((increment >> 8) & 0xFF) as u8)
  payload.push((increment & 0xFF) as u8)
  H2Frame::new(H2_FRAME_WINDOW_UPDATE, 0, stream_id, payload)
end

def h2_ping_frame(opaque_data: [u8; 8], ack: Bool) -> H2Frame
  let flags = if ack then H2_FLAG_END_STREAM else 0 end
  H2Frame::new(H2_FRAME_PING, flags, 0, opaque_data.to_vec())
end

# HTTP/2 stream states (RFC 7540 Section 5.1)
enum H2StreamState
  Idle
  ReservedLocal
  ReservedRemote
  Open
  HalfClosedLocal
  HalfClosedRemote
  Closed
end

# A single HTTP/2 stream within a multiplexed connection
struct H2Stream
  id: u32
  state: H2StreamState
  request_headers: HttpHeaders
  response_headers: HttpHeaders
  send_window: Int
  recv_window: Int
  recv_buffer: Vec[u8]
end

def H2Stream::new(id: u32) -> H2Stream
  H2Stream {
    id: id,
    state: H2StreamState::Idle,
    request_headers: HttpHeaders::new(),
    response_headers: HttpHeaders::new(),
    send_window: 65535,
    recv_window: 65535,
    recv_buffer: Vec::new()
  }
end

impl H2Stream
  def is_open(self: &H2Stream) -> Bool
    match self.state
    when H2StreamState::Open then true
    when H2StreamState::HalfClosedLocal then true
    when H2StreamState::HalfClosedRemote then true
    when _ then false
    end
  end

  def receive_data(self: &mut H2Stream, data: &[u8]) -> Unit
    self.recv_buffer.extend(data)
    self.recv_window = self.recv_window - data.len() as Int
  end

  def consume_data(self: &mut H2Stream) -> Vec[u8]
    let data = self.recv_buffer.clone()
    self.recv_buffer.clear()
    data
  end
end

# HTTP/2 connection settings
struct H2Settings
  header_table_size: u32
  enable_push: Bool
  max_concurrent_streams: u32
  initial_window_size: u32
  max_frame_size: u32
  max_header_list_size: u32
end

def H2Settings::default() -> H2Settings
  H2Settings {
    header_table_size: 4096,
    enable_push: true,
    max_concurrent_streams: 100,
    initial_window_size: 65535,
    max_frame_size: 16384,
    max_header_list_size: 8192
  }
end

# Multiplexed HTTP/2 connection managing multiple streams
struct H2Connection
  conn: Box[dyn HttpConnection]
  streams: Map[u32, H2Stream]
  next_stream_id: u32
  local_settings: H2Settings
  remote_settings: H2Settings
  connection_window: Int
  goaway_received: Bool
  last_stream_id: u32
  recv_buffer: Vec[u8]
end

def H2Connection::new(conn: Box[dyn HttpConnection]) -> H2Connection
  H2Connection {
    conn: conn,
    streams: Map::new(),
    next_stream_id: 1,
    local_settings: H2Settings::default(),
    remote_settings: H2Settings::default(),
    connection_window: 65535,
    goaway_received: false,
    last_stream_id: 0,
    recv_buffer: Vec::new()
  }
end

impl H2Connection
  def send_preface(self: &mut H2Connection) -> Result[Unit, HttpError]
    # Send the connection preface
    let preface_bytes = H2_PREFACE.as_bytes()
    self.conn.write_all(preface_bytes)?

    # Send initial SETTINGS frame
    let settings = Vec::new()
    let frame = h2_settings_frame(&settings)
    self.conn.write_all(&frame.serialize())?
    Result::Ok(())
  end

  def open_stream(self: &mut H2Connection) -> u32
    let id = self.next_stream_id
    self.next_stream_id = self.next_stream_id + 2
    self.streams.insert(id, H2Stream::new(id))
    id
  end

  def send_frame(self: &mut H2Connection, frame: &H2Frame) -> Result[Unit, HttpError]
    let bytes = frame.serialize()
    self.conn.write_all(&bytes)
  end

  def recv_frame(self: &mut H2Connection) -> Result[H2Frame, HttpError]
    # Ensure we have at least the 9-byte frame header
    let mut temp = [0u8; 4096]
    while self.recv_buffer.len() < 9 do
      let n = self.conn.read(&mut temp)?
      if n == 0 then
        return Result::Err(HttpError::InvalidResponse("connection closed during HTTP/2 frame read"))
      end
      self.recv_buffer.extend(&temp[0..n])
    end

    # Parse length from header
    let length = ((self.recv_buffer[0] as u32) << 16) |
                 ((self.recv_buffer[1] as u32) << 8) |
                 (self.recv_buffer[2] as u32)

    let total = 9 + length as UInt
    while self.recv_buffer.len() < total do
      let n = self.conn.read(&mut temp)?
      if n == 0 then
        return Result::Err(HttpError::InvalidResponse("connection closed during HTTP/2 payload read"))
      end
      self.recv_buffer.extend(&temp[0..n])
    end

    let frame_data = self.recv_buffer[0..total].to_vec()
    self.recv_buffer = self.recv_buffer[total..].to_vec()

    match H2Frame::parse(&frame_data)
    when Result::Ok(frame) then Result::Ok(frame)
    when Result::Err(e) then Result::Err(HttpError::InvalidResponse(e))
    end
  end

  def process_frame(self: &mut H2Connection, frame: &H2Frame) -> Result[Unit, HttpError]
    match frame.frame_type
    when H2_FRAME_SETTINGS then
      if (frame.flags & H2_FLAG_END_STREAM) == 0 then
        # Acknowledge the settings
        let ack = h2_settings_ack()
        self.send_frame(&ack)?
      end
    when H2_FRAME_WINDOW_UPDATE then
      if frame.stream_id == 0 then
        if frame.payload.len() >= 4 then
          let increment = ((frame.payload[0] as u32 & 0x7F) << 24) |
                         ((frame.payload[1] as u32) << 16) |
                         ((frame.payload[2] as u32) << 8) |
                         (frame.payload[3] as u32)
          self.connection_window = self.connection_window + increment as Int
        end
      else
        match self.streams.get_mut(&frame.stream_id)
        when Option::Some(stream) then
          if frame.payload.len() >= 4 then
            let increment = ((frame.payload[0] as u32 & 0x7F) << 24) |
                           ((frame.payload[1] as u32) << 16) |
                           ((frame.payload[2] as u32) << 8) |
                           (frame.payload[3] as u32)
            stream.send_window = stream.send_window + increment as Int
          end
        when Option::None then ()
        end
      end
    when H2_FRAME_DATA then
      match self.streams.get_mut(&frame.stream_id)
      when Option::Some(stream) then
        stream.receive_data(&frame.payload)
        if frame.is_end_stream() then
          stream.state = H2StreamState::HalfClosedRemote
        end
      when Option::None then ()
      end
    when H2_FRAME_RST_STREAM then
      match self.streams.get_mut(&frame.stream_id)
      when Option::Some(stream) then
        stream.state = H2StreamState::Closed
      when Option::None then ()
      end
    when H2_FRAME_GOAWAY then
      self.goaway_received = true
      if frame.payload.len() >= 4 then
        self.last_stream_id = ((frame.payload[0] as u32 & 0x7F) << 24) |
                              ((frame.payload[1] as u32) << 16) |
                              ((frame.payload[2] as u32) << 8) |
                              (frame.payload[3] as u32)
      end
    when H2_FRAME_PING then
      if (frame.flags & H2_FLAG_END_STREAM) == 0 then
        let mut ack_data: [u8; 8] = [0; 8]
        let copy_len = frame.payload.len().min(8)
        let mut i = 0
        while i < copy_len do
          ack_data[i] = frame.payload[i]
          i = i + 1
        end
        let ack = h2_ping_frame(ack_data, true)
        self.send_frame(&ack)?
      end
    when _ then ()
    end
    Result::Ok(())
  end

  def close_stream(self: &mut H2Connection, stream_id: u32) -> Unit
    match self.streams.get_mut(&stream_id)
    when Option::Some(stream) then
      stream.state = H2StreamState::Closed
    when Option::None then ()
    end
  end

  def active_stream_count(self: &H2Connection) -> UInt
    let mut count: UInt = 0
    for (_, stream) in self.streams.iter() do
      if stream.is_open() then
        count = count + 1
      end
    end
    count
  end
end

# ———————————————————————————————————————————————————————————————
# HTTP Error
# ———————————————————————————————————————————————————————————————

enum HttpError
  InvalidUrl(String)
  ConnectionFailed(String)
  Timeout
  TooManyRedirects
  InvalidResponse(String)
  InvalidUtf8
  Io(String)
  Tls(String)
  Serialize(String)
  Deserialize(String)
end

def http_error_message(e: &HttpError) -> String
  match e
  when HttpError::InvalidUrl(s) then "invalid URL: " + s.clone()
  when HttpError::ConnectionFailed(s) then "connection failed: " + s.clone()
  when HttpError::Timeout then "request timeout"
  when HttpError::TooManyRedirects then "too many redirects"
  when HttpError::InvalidResponse(s) then "invalid response: " + s.clone()
  when HttpError::InvalidUtf8 then "invalid UTF-8 in response body"
  when HttpError::Io(s) then "IO error: " + s.clone()
  when HttpError::Tls(s) then "TLS error: " + s.clone()
  when HttpError::Serialize(s) then "serialize error: " + s.clone()
  when HttpError::Deserialize(s) then "deserialize error: " + s.clone()
  end
end

impl Error for HttpError
  def message(self: &HttpError) -> String
    http_error_message(self)
  end
end

def map_tcp_connect_error(host: &String, port: UInt, net_error: &IOError) -> HttpError
  let net_error_str = net_error.to_string()
  let lower = net_error_str.to_lowercase()
  if lower.contains("timeout") || lower.contains("timed out") then
    HttpError::Timeout
  else
    let detail = host.clone() + ":" + port.to_string() + " - " + net_error_str
    HttpError::ConnectionFailed(detail)
  end
end

def map_io_error(io_error: &IOError) -> HttpError
  let io_error_str = io_error.to_string()
  let lower = io_error_str.to_lowercase()
  if lower.contains("timeout") || lower.contains("timed out") then
    HttpError::Timeout
  else
    HttpError::Io(io_error_str)
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}
use std::time::{instant_now, duration_nanos}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_http_event(level: LogLevel, msg: String) -> Unit
  match &GLOBAL_LOGGER
  when Option::Some(logger) then
      let entry = LogEntry {
        timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
        level: level,
        category: LogCategory::App,
        message: "[HTTP] " + msg,
        correlation_id: ""
      }
      logger.log(entry)
  when Option::None then ()
  end
end

# ———————————————————————————————————————————————————————————————
# HTTP Client
# ———————————————————————————————————————————————————————————————

struct HttpClient
  timeout_ms: UInt
  max_redirects: UInt
  default_headers: HttpHeaders
  user_agent: String
end

def HttpClient::new() -> HttpClient
  let mut headers = HttpHeaders::new()
  headers.set("Accept", "*/*")
  headers.set("Accept-Encoding", "identity")
  headers.set("Connection", "close")
  
  HttpClient {
    timeout_ms: 30000,
    max_redirects: 10,
    default_headers: headers,
    user_agent: "Tangerine/1.0".to_string()
  }
end

impl HttpClient
  def timeout(self: &mut HttpClient, ms: UInt) -> &mut HttpClient
    self.timeout_ms = ms
    self
  end
  
  def max_redirects(self: &mut HttpClient, n: UInt) -> &mut HttpClient
    self.max_redirects = n
    self
  end
  
  def default_header(self: &mut HttpClient, name: &str, value: &str) -> &mut HttpClient
    self.default_headers.set(name, value)
    self
  end
  
  def user_agent(self: &mut HttpClient, ua: &str) -> &mut HttpClient
    self.user_agent = ua.to_string()
    self
  end
  
  def get(self: &HttpClient, url: &str) -> RequestBuilder
    self.request(HttpMethod::Get, url)
  end
  
  def post(self: &HttpClient, url: &str) -> RequestBuilder
    self.request(HttpMethod::Post, url)
  end
  
  def put(self: &HttpClient, url: &str) -> RequestBuilder
    self.request(HttpMethod::Put, url)
  end
  
  def delete(self: &HttpClient, url: &str) -> RequestBuilder
    self.request(HttpMethod::Delete, url)
  end
  
  def patch(self: &HttpClient, url: &str) -> RequestBuilder
    self.request(HttpMethod::Patch, url)
  end
  
  def head(self: &HttpClient, url: &str) -> RequestBuilder
    self.request(HttpMethod::Head, url)
  end
  
  def request(self: &HttpClient, method: HttpMethod, url: &str) -> RequestBuilder
    RequestBuilder {
      client: self,
      method: method,
      url: url.to_string(),
      headers: HttpHeaders::new(),
      body: Option::None,
      timeout: Option::None
    }
  end
  
  def send_request(self: &HttpClient, req: &HttpRequest) -> Result[HttpResponse, HttpError]
    let mut redirect_count = 0
    let mut current_url = req.url.clone()
    let mut current_method = req.method.clone()
    let mut current_body = req.body.clone()
    let mut current_headers = req.headers.clone()
    
    loop
      let response = self.do_request(&current_url, &current_method, &current_headers, &current_body)?
      
      if response.status.is_redirect() && redirect_count < self.max_redirects then
        redirect_count = redirect_count + 1
        
        match response.headers.get("location")
        when Option::Some(location) then
          let old_url = current_url.clone()
          match current_url.join(location.as_str())
          when Result::Ok(new_url) then
            let old_host = old_url.host().unwrap_or("")
            let new_host = new_url.host().unwrap_or("")
            if old_host != new_host then
              current_headers.remove("authorization")
              current_headers.remove("proxy-authorization")
            end

            current_url = new_url
            # Change to GET for 303, or if POST->301/302
            let is_post = match current_method
              when HttpMethod::Post then true
              when _ then false
            end
            if response.status.code == 303 ||
               ((response.status.code == 301 || response.status.code == 302) && is_post) then
              current_method = HttpMethod::Get
              current_body = Option::None
            end
            next
          when Result::Err(e) then return Result::Err(HttpError::InvalidUrl(std::url::url_error_message(&e)))
          end
        when Option::None then return Result::Err(HttpError::InvalidResponse("redirect without location"))
        end
      elsif response.status.is_redirect() && redirect_count >= self.max_redirects then
        return Result::Err(HttpError::TooManyRedirects)
      else
        return Result::Ok(response)
      end
    end
  end
  
  def do_request(self: &HttpClient, url: &Url, method: &HttpMethod,
                 headers: &HttpHeaders, body: &Option[Vec[u8]]) -> Result[HttpResponse, HttpError]
    let host = match url.host()
    when Option::Some(h) then h.clone()
    when Option::None then return Result::Err(HttpError::InvalidUrl("no host"))
    end
    
    let port = url.port_or_default()
    let is_https = url.is_secure()
    
    # Connect
    let stream = match tcp_connect_host(host.clone(), port as u16)
    when Result::Ok(s) then s
    when Result::Err(e) then return Result::Err(map_tcp_connect_error(&host, port as UInt, &e))
    end
    
    # For HTTPS, wrap with TLS
    let mut conn: Box[dyn HttpConnection] = if is_https then
      match tls_connect(stream, &host)
      when Result::Ok(tls) then Box::new(tls)
      when Result::Err(e) then return Result::Err(HttpError::Tls(e))
      end
    else
      Box::new(stream)
    end
    
    # Build and send request
    let mut req = HttpRequest::new(method.clone(), url.clone())
    
    # Copy default headers
    for entry in self.default_headers.iter() do
      let (k, v) = entry
      if !headers.contains(k.as_str()) then
        req.headers.set(k.as_str(), v.as_str())
      end
    end
    
    # Copy request headers
    for entry in headers.iter() do
      let (k, v) = entry
      req.headers.set(k.as_str(), v.as_str())
    end
    
    # User-Agent
    if !req.headers.contains("user-agent") then
      req.headers.set("User-Agent", self.user_agent.as_str())
    end
    
    req.body = body.clone()
    
    let request_bytes = req.serialize()
    conn.write_all(&request_bytes)?
    
    # Parse response
    parse_response(&mut conn)
  end
end

# ———————————————————————————————————————————————————————————————
# Request Builder
# ———————————————————————————————————————————————————————————————

struct RequestBuilder
  client: &HttpClient
  method: HttpMethod
  url: String
  headers: HttpHeaders
  body: Option[Vec[u8]]
  timeout: Option[UInt]
end

impl RequestBuilder
  def header(self: &mut RequestBuilder, name: &str, value: &str) -> &mut RequestBuilder
    self.headers.set(name, value)
    self
  end
  
  def body(self: &mut RequestBuilder, data: &str) -> &mut RequestBuilder
    self.body = Option::Some(data.as_bytes().to_vec())
    self
  end
  
  def body_bytes(self: &mut RequestBuilder, data: Vec[u8]) -> &mut RequestBuilder
    self.body = Option::Some(data)
    self
  end
  
  def json[T: Serialize](self: &mut RequestBuilder, data: &T) -> &mut RequestBuilder
    match json::to_json(data)
    when Result::Ok(json_str) then
      self.headers.set("Content-Type", "application/json")
      self.body = Option::Some(json_str.as_bytes().to_vec())
    when Result::Err(_) then ()
    end
    self
  end
  
  def form(self: &mut RequestBuilder, data: &Map[String, String]) -> &mut RequestBuilder
    self.headers.set("Content-Type", "application/x-www-form-urlencoded")
    let encoded = std::url::build_query_string(&data.iter().collect())
    self.body = Option::Some(encoded.as_bytes().to_vec())
    self
  end
  
  def timeout(self: &mut RequestBuilder, ms: UInt) -> &mut RequestBuilder
    self.timeout = Option::Some(ms)
    self
  end
  
  def send(self: &RequestBuilder) -> Result[HttpResponse, HttpError]
    let url = match Url::parse(self.url.as_str())
    when Result::Ok(u) then u
    when Result::Err(e) then return Result::Err(HttpError::InvalidUrl(std::url::url_error_message(&e)))
    end
    
    let mut req = HttpRequest::new(self.method.clone(), url)
    for entry in self.headers.iter() do
      let (k, v) = entry
      req.headers.set(k.as_str(), v.as_str())
    end
    req.body = self.body.clone()
    
    self.client.send_request(&req)
  end
end

# ———————————————————————————————————————————————————————————————
# Convenience Functions
# ———————————————————————————————————————————————————————————————

def get(url: &str) -> Result[HttpResponse, HttpError]
  HttpClient::new().get(url).send()
end

def post(url: &str, body: &str) -> Result[HttpResponse, HttpError]
  HttpClient::new().post(url).body(body).send()
end

def post_json[T: Serialize](url: &str, data: &T) -> Result[HttpResponse, HttpError]
  HttpClient::new().post(url).json(data).send()
end

# ———————————————————————————————————————————————————————————————
# HTTP Connection Trait
# ———————————————————————————————————————————————————————————————

trait HttpConnection
  def read(self: &mut Self, buf: &mut [u8]) -> Result[UInt, HttpError]
  def write_all(self: &mut Self, data: &[u8]) -> Result[Unit, HttpError]
  def close(self: &mut Self) -> Unit
end

impl HttpConnection for TcpStream
  def read(self: &mut TcpStream, buf: &mut [u8]) -> Result[UInt, HttpError]
    match self.recv(buf)
    when Result::Ok(n) then Result::Ok(n)
    when Result::Err(e) then Result::Err(map_io_error(&e))
    end
  end
  
  def write_all(self: &mut TcpStream, data: &[u8]) -> Result[Unit, HttpError]
    mut offset = 0
    while offset < data.len() do
      match self.send(&data[offset..])
      when Result::Ok(n) then
        if n == 0 then
          return Result::Err(HttpError::Io("write returned 0".to_string()))
        end
        offset = offset + n as UInt
      when Result::Err(e) then return Result::Err(map_io_error(&e))
      end
    end
    Result::Ok(())
  end
  
  def close(self: &mut TcpStream) -> Unit
    let _ = self.shutdown(2)
  end
end

# ———————————————————————————————————————————————————————————————
# TLS Support
# ———————————————————————————————————————————————————————————————

struct TlsStream
  inner: TcpStream
  ssl_ctx: Ptr[u8]
  ssl: Ptr[u8]
end

extern "C"
  # OpenSSL bindings
  def SSL_library_init() -> Int
  def SSL_load_error_strings() -> Unit
  def TLS_client_method() -> Ptr[u8]
  def SSL_CTX_new(method: Ptr[u8]) -> Ptr[u8]
  def SSL_CTX_set_verify(ctx: Ptr[u8], mode: Int, verify_callback: Ptr[u8]) -> Unit
  def SSL_CTX_set_default_verify_paths(ctx: Ptr[u8]) -> Int
  def SSL_CTX_free(ctx: Ptr[u8]) -> Unit
  def SSL_new(ctx: Ptr[u8]) -> Ptr[u8]
  def SSL_free(ssl: Ptr[u8]) -> Unit
  def SSL_set_fd(ssl: Ptr[u8], fd: Int) -> Int
  def SSL_set_tlsext_host_name(ssl: Ptr[u8], name: Ptr[u8]) -> Int
  def SSL_set1_host(ssl: Ptr[u8], name: Ptr[u8]) -> Int
  def SSL_connect(ssl: Ptr[u8]) -> Int
  def SSL_get_verify_result(ssl: Ptr[u8]) -> Int
  def SSL_read(ssl: Ptr[u8], buf: Ptr[u8], num: Int) -> Int
  def SSL_write(ssl: Ptr[u8], buf: Ptr[u8], num: Int) -> Int
  def SSL_shutdown(ssl: Ptr[u8]) -> Int
  def SSL_get_error(ssl: Ptr[u8], ret: Int) -> Int
  def ERR_get_error() -> UInt
  def ERR_error_string(e: UInt, buf: Ptr[u8]) -> Ptr[u8]
end

static mut TLS_INIT_STATE: AtomicInt = AtomicInt { value: 0 }

def tls_init() -> Unit
  let INCOMPLETE = 0
  let RUNNING = 1
  let COMPLETE = 2

  match TLS_INIT_STATE.compare_exchange(INCOMPLETE, RUNNING, Ordering::Acquire, Ordering::Relaxed)
  when Result::Ok(_) then
    SSL_library_init()
    SSL_load_error_strings()
    TLS_INIT_STATE.store(COMPLETE, Ordering::Release)
  when Result::Err(_) then
    while TLS_INIT_STATE.load(Ordering::Acquire) == RUNNING do
      thread_yield()
    end
  end
end

def ssl_error_message(ssl: Ptr[u8], ret: Int, op: &str) -> String
  let ssl_err = SSL_get_error(ssl, ret)
  let openssl_err = ERR_get_error()
  if openssl_err != 0 then
    op.to_string() + " failed (ssl_error=" + ssl_err.to_string() + ", openssl_error=" + openssl_err.to_string() + ")"
  else
    op.to_string() + " failed (ssl_error=" + ssl_err.to_string() + ")"
  end
end

def tls_connect(stream: TcpStream, hostname: &String) -> Result[TlsStream, String]
  tls_init()
  let SSL_VERIFY_PEER = 1
  let X509_V_OK = 0
  
  let method = TLS_client_method()
  let ctx = SSL_CTX_new(method)
  if ctx.is_null() then
    return Result::Err("failed to create SSL context")
  end

  SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, Ptr::null())
  if SSL_CTX_set_default_verify_paths(ctx) != 1 then
    SSL_CTX_free(ctx)
    return Result::Err("failed to load system CA trust store")
  end
  
  let ssl = SSL_new(ctx)
  if ssl.is_null() then
    SSL_CTX_free(ctx)
    return Result::Err("failed to create SSL object")
  end
  
  # Set file descriptor
  let fd = stream.fd()
  if SSL_set_fd(ssl, fd) != 1 then
    SSL_free(ssl)
    SSL_CTX_free(ctx)
    return Result::Err("failed to set SSL fd")
  end
  
  # Set SNI hostname
  let hostname_cstr = hostname.to_cstring()
  if SSL_set_tlsext_host_name(ssl, hostname_cstr.as_ptr()) != 1 then
    SSL_free(ssl)
    SSL_CTX_free(ctx)
    return Result::Err("failed to set TLS SNI hostname")
  end

  if SSL_set1_host(ssl, hostname_cstr.as_ptr()) != 1 then
    SSL_free(ssl)
    SSL_CTX_free(ctx)
    return Result::Err("failed to enable TLS hostname verification")
  end
  
  # Perform handshake
  let ret = SSL_connect(ssl)
  if ret != 1 then
    let err_msg = ssl_error_message(ssl, ret, "SSL handshake")
    SSL_free(ssl)
    SSL_CTX_free(ctx)
    return Result::Err(err_msg)
  end

  if SSL_get_verify_result(ssl) != X509_V_OK then
    SSL_free(ssl)
    SSL_CTX_free(ctx)
    return Result::Err("TLS certificate verification failed")
  end
  
  Result::Ok(TlsStream {
    inner: stream,
    ssl_ctx: ctx,
    ssl: ssl
  })
end

impl HttpConnection for TlsStream
  def read(self: &mut TlsStream, buf: &mut [u8]) -> Result[UInt, HttpError]
    let ret = SSL_read(self.ssl, buf.as_mut_ptr(), buf.len() as Int)
    if ret < 0 then
      Result::Err(HttpError::Tls(ssl_error_message(self.ssl, ret, "SSL read")))
    else
      Result::Ok(ret as UInt)
    end
  end
  
  def write_all(self: &mut TlsStream, data: &[u8]) -> Result[Unit, HttpError]
    mut offset = 0
    while offset < data.len() do
      let ret = SSL_write(self.ssl, data[offset..].as_ptr(), (data.len() - offset) as Int)
      if ret < 0 then
        return Result::Err(HttpError::Tls(ssl_error_message(self.ssl, ret, "SSL write")))
      elsif ret == 0 then
        return Result::Err(HttpError::Tls("SSL write returned 0".to_string()))
      else
        offset = offset + ret as UInt
      end
    end
    Result::Ok(())
  end
  
  def close(self: &mut TlsStream) -> Unit
    if !self.ssl.is_null() then
      SSL_shutdown(self.ssl)
      SSL_free(self.ssl)
      self.ssl = Ptr::null()
    end
    if !self.ssl_ctx.is_null() then
      SSL_CTX_free(self.ssl_ctx)
      self.ssl_ctx = Ptr::null()
    end
    let _ = self.inner.shutdown(2)
  end
end

impl Drop for TlsStream
  def drop(self: &mut TlsStream) -> Unit
    self.close()
  end
end

# ———————————————————————————————————————————————————————————————
# Response Parsing
# ———————————————————————————————————————————————————————————————

def parse_response(conn: &mut Box[dyn HttpConnection]) -> Result[HttpResponse, HttpError]
  let mut buffer = Vec::new()
  let mut temp = [0u8; 4096]
  
  # Read until we have full headers
  let mut headers_end = Option::None
  while headers_end.is_none() do
    let n = conn.read(&mut temp)?
    if n == 0 then
      return Result::Err(HttpError::InvalidResponse("connection closed"))
    end
    buffer.extend(&temp[0..n])
    
    # Look for \r\n\r\n
    if buffer.len() >= 4 then
      for i in 0..(buffer.len() - 3) do
        if buffer[i] == '\r' as u8 && buffer[i+1] == '\n' as u8 &&
           buffer[i+2] == '\r' as u8 && buffer[i+3] == '\n' as u8 then
          headers_end = Option::Some(i)
          break
        end
      end
    end
  end
  
  let header_end = headers_end.unwrap()
  let header_bytes = &buffer[0..header_end]
  let header_str = match String::from_utf8(header_bytes)
  when Result::Ok(s) then s
  when Result::Err(_) then return Result::Err(HttpError::InvalidResponse("invalid header encoding"))
  end
  
  # Parse status line
  let lines = header_str.split("\r\n")
  if lines.is_empty() then
    return Result::Err(HttpError::InvalidResponse("no status line"))
  end
  
  let status_line = &lines[0]
  let status_parts = status_line.split(' ')
  if status_parts.len() < 2 then
    return Result::Err(HttpError::InvalidResponse("malformed status line"))
  end
  
  let status_code = match parse_uint(&status_parts[1])
  when Option::Some(c) then c
  when Option::None then return Result::Err(HttpError::InvalidResponse("invalid status code"))
  end
  
  let status = HttpStatus::new(status_code)
  
  # Parse headers
  let mut headers = HttpHeaders::new()
  for i in 1..lines.len() do
    let line = &lines[i]
    match line.find(':')
    when Option::Some(colon) then
      let name = line.slice(0, colon).trim()
      let value = line.slice(colon + 1, line.len()).trim()
      headers.append(name.as_str(), value.as_str())
    when Option::None then ()
    end
  end
  
  # Read body
  let body_start = header_end + 4
  let mut body = buffer[body_start..].to_vec()
  
  let content_length = headers.content_length()
  let is_chunked = match headers.get("transfer-encoding")
  when Option::Some(te) then te.to_lowercase().contains("chunked")
  when Option::None then false
  end
  
  if is_chunked then
    # Read chunked body
    body = read_chunked_body(conn, &body)?
  else
    match content_length
    when Option::Some(len) then
      # Read remaining bytes
      while body.len() < len do
        let n = conn.read(&mut temp)?
        if n == 0 then break end
        body.extend(&temp[0..n])
      end
    when Option::None then
      # Read until connection close
      loop
        let n = conn.read(&mut temp)?
        if n == 0 then break end
        body.extend(&temp[0..n])
      end
    end
  end
  
  Result::Ok(HttpResponse {
    status: status,
    headers: headers,
    body: body
  })
end

def read_chunked_body(conn: &mut Box[dyn HttpConnection], initial: &Vec[u8]) -> Result[Vec[u8], HttpError]
  let mut buffer = initial.clone()
  let mut result = Vec::new()
  let mut temp = [0u8; 4096]
  
  loop
    # Find chunk size line
    let line_end = find_crlf(&buffer)
    if line_end.is_none() then
      let n = conn.read(&mut temp)?
      if n == 0 then break end
      buffer.extend(&temp[0..n])
      next
    end
    
    let line_end_idx = line_end.unwrap()
    let size_str = String::from_utf8(&buffer[0..line_end_idx]).unwrap_or(String::new())
    let chunk_size = parse_hex_uint(&size_str.trim())
    
    if chunk_size == 0 then
      break  # End of chunks
    end
    
    # Remove size line from buffer
    buffer = buffer[(line_end_idx + 2)..].to_vec()
    
    # Read chunk data
    while buffer.len() < chunk_size do
      let n = conn.read(&mut temp)?
      if n == 0 then break end
      buffer.extend(&temp[0..n])
    end
    
    result.extend(&buffer[0..chunk_size])
    buffer = buffer[chunk_size..].to_vec()
    
    # Skip trailing \r\n
    if buffer.len() >= 2 then
      buffer = buffer[2..].to_vec()
    end
  end
  
  Result::Ok(result)
end

def find_crlf(buf: &Vec[u8]) -> Option[UInt]
  if buf.len() < 2 then return Option::None end
  for i in 0..(buf.len() - 1) do
    if buf[i] == '\r' as u8 && buf[i+1] == '\n' as u8 then
      return Option::Some(i)
    end
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# HTTP Server (minimal)
# ———————————————————————————————————————————————————————————————

struct HttpServer
  port: UInt
  handler: fn(HttpRequest) -> HttpResponse
end

def HttpServer::new(port: UInt, handler: fn(HttpRequest) -> HttpResponse) -> HttpServer
  HttpServer { port: port, handler: handler }
end

impl HttpServer
  def listen(self: &HttpServer) -> Result[Unit, HttpError]
    let bind_addr = std::net::socket_addr_v4(std::net::ipv4_any(), self.port as u16)
    let listener = match std::net::tcp_bind(bind_addr)
    when Result::Ok(l) then l
    when Result::Err(e) then return Result::Err(HttpError::Io(e.to_string()))
    end
    
    loop
      match listener.accept()
      when Result::Ok(stream) then
        # Handle request (single-threaded for simplicity)
        self.handle_connection(stream)
      when Result::Err(e) then
        # Log and continue
        ()
      end
    end
  end

  def handle_connection(self: &HttpServer, mut stream: TcpStream) -> Unit
    let mut buffer = [0u8; 8192]
    match stream.recv(&mut buffer)
    when Result::Ok(n) then
      if n > 0 then
        match parse_request(&buffer[0..n])
        when Result::Ok(req) then
          let response = (self.handler)(req)
          let response_bytes = serialize_response(&response)
          stream.send(&response_bytes)
        when Result::Err(_) then ()
        end
      end
    when Result::Err(_) then ()
    end
    let _ = stream.shutdown(2)
  end
end

def parse_request(data: &[u8]) -> Result[HttpRequest, HttpError]
  let s = match String::from_utf8(data)
  when Result::Ok(s) then s
  when Result::Err(_) then return Result::Err(HttpError::InvalidResponse("invalid encoding"))
  end
  
  let lines = s.split("\r\n")
  if lines.is_empty() then
    return Result::Err(HttpError::InvalidResponse("empty request"))
  end
  
  let request_line = &lines[0]
  let parts = request_line.split(' ')
  if parts.len() < 2 then
    return Result::Err(HttpError::InvalidResponse("malformed request line"))
  end
  
  let method = match method_from_string(parts[0].as_str())
  when Option::Some(m) then m
  when Option::None then return Result::Err(HttpError::InvalidResponse("unknown method"))
  end
  
  let path = &parts[1]
  let url = match Url::parse(("http://localhost" + path).as_str())
  when Result::Ok(u) then u
  when Result::Err(e) then return Result::Err(HttpError::InvalidUrl(std::url::url_error_message(&e)))
  end
  
  let mut headers = HttpHeaders::new()
  let mut body_start = Option::None
  
  for i in 1..lines.len() do
    let line = &lines[i]
    if line.is_empty() then
      body_start = Option::Some(i + 1)
      break
    end
    match line.find(':')
    when Option::Some(colon) then
      let name = line.slice(0, colon).trim()
      let value = line.slice(colon + 1, line.len()).trim()
      headers.append(name.as_str(), value.as_str())
    when Option::None then ()
    end
  end
  
  let body = match body_start
  when Option::Some(idx) then
    let body_str = lines[idx..].join("\r\n")
    Option::Some(body_str.as_bytes().to_vec())
  when Option::None then Option::None
  end
  
  let mut req = HttpRequest::new(method, url)
  req.headers = headers
  req.body = body
  
  Result::Ok(req)
end

def serialize_response(resp: &HttpResponse) -> Vec[u8]
  let mut s = String::new()
  s.push_str("HTTP/1.1 ")
  s.push_str(resp.status.code.to_string().as_str())
  s.push(' ')
  s.push_str(resp.status.reason.as_str())
  s.push_str("\r\n")
  
  for entry in resp.headers.iter() do
    let (k, v) = entry
    s.push_str(k.as_str())
    s.push_str(": ")
    s.push_str(v.as_str())
    s.push_str("\r\n")
  end
  
  s.push_str("Content-Length: ")
  s.push_str(resp.body.len().to_string().as_str())
  s.push_str("\r\n\r\n")
  
  let mut result = s.as_bytes().to_vec()
  result.extend(&resp.body)
  result
end

# ———————————————————————————————————————————————————————————————
# Helper Functions
# ———————————————————————————————————————————————————————————————

def parse_uint(s: &String) -> Option[UInt]
  let mut result: UInt = 0
  for c in s.chars() do
    if c >= '0' && c <= '9' then
      result = result * 10 + (c as UInt - '0' as UInt)
    else
      return Option::None
    end
  end
  Option::Some(result)
end

def parse_hex_uint(s: &String) -> UInt
  let mut result: UInt = 0
  for c in s.chars() do
    let digit = if c >= '0' && c <= '9' then
      c as UInt - '0' as UInt
    elsif c >= 'a' && c <= 'f' then
      c as UInt - 'a' as UInt + 10
    elsif c >= 'A' && c <= 'F' then
      c as UInt - 'A' as UInt + 10
    else
      break
    end
    result = result * 16 + digit
  end
  result
end

# ———————————————————————————————————————————————————————————————
# WebSocket Protocol (RFC 6455)
# ———————————————————————————————————————————————————————————————

enum WsOpcode
  Continuation   ## 0x0
  Text           ## 0x1
  Binary         ## 0x2
  Close          ## 0x8
  Ping           ## 0x9
  Pong           ## 0xA
end

def opcode_to_u8(op: &WsOpcode) -> u8
  match op
  when WsOpcode::Continuation then 0x0
  when WsOpcode::Text then 0x1
  when WsOpcode::Binary then 0x2
  when WsOpcode::Close then 0x8
  when WsOpcode::Ping then 0x9
  when WsOpcode::Pong then 0xA
  end
end

def u8_to_opcode(v: u8) -> Option[WsOpcode]
  match v
  when 0x0 then Option::Some(WsOpcode::Continuation)
  when 0x1 then Option::Some(WsOpcode::Text)
  when 0x2 then Option::Some(WsOpcode::Binary)
  when 0x8 then Option::Some(WsOpcode::Close)
  when 0x9 then Option::Some(WsOpcode::Ping)
  when 0xA then Option::Some(WsOpcode::Pong)
  when _ then Option::None
  end
end

struct WsFrame
  fin: Bool
  opcode: WsOpcode
  mask: Option[[u8; 4]]
  payload: Vec[u8]
end

struct WsMessage
  opcode: WsOpcode
  data: Vec[u8]
end

impl WsMessage
  def text(s: &str) -> WsMessage
    WsMessage { opcode: WsOpcode::Text, data: s.as_bytes().to_vec() }
  end

  def binary(data: Vec[u8]) -> WsMessage
    WsMessage { opcode: WsOpcode::Binary, data: data }
  end

  def as_text(self: &WsMessage) -> Result[String, String]
    String::from_utf8(self.data.clone())
  end

  def is_text(self: &WsMessage) -> Bool
    match self.opcode
    when WsOpcode::Text then true
    when _ then false
    end
  end

  def is_binary(self: &WsMessage) -> Bool
    match self.opcode
    when WsOpcode::Binary then true
    when _ then false
    end
  end
end

enum WsError
  ConnectionFailed(String)
  HandshakeFailed(String)
  ProtocolError(String)
  MessageTooLarge(UInt)
  Closed(u16, String)
  Io(String)
end

impl Error for WsError
  def message(&self) -> String
    match self
    when WsError::ConnectionFailed(s) then "WS connection failed: " + s.clone()
    when WsError::HandshakeFailed(s) then "WS handshake failed: " + s.clone()
    when WsError::ProtocolError(s) then "WS protocol error: " + s.clone()
    when WsError::MessageTooLarge(sz) then "WS message too large: " + sz.to_string()
    when WsError::Closed(code, reason) then "WS closed: " + code.to_string() + " " + reason.clone()
    when WsError::Io(s) then "WS IO error: " + s.clone()
    end
  end
end

struct WebSocket
  stream: TcpStream  ## or TlsStream wrapped as Read+Write
  is_client: Bool
  closed: Bool
  max_message_size: UInt
end

struct WsConfig
  max_message_size: UInt  ## Default 64 MB
  auto_pong: Bool
end

def ws_config_default() -> WsConfig
  WsConfig {
    max_message_size: 64 * 1024 * 1024,
    auto_pong: true,
  }
end

## Connect to a WebSocket server
def ws_connect(url: &str) -> Result[WebSocket, WsError]
  ws_connect_with_config(url, &ws_config_default())
end

def ws_connect_with_config(url: &str, config: &WsConfig) -> Result[WebSocket, WsError]
  ## Parse ws:// or wss:// URL
  let (host, port, path, use_tls) = match parse_ws_url(url)
  when Result::Ok(parts) then parts
  when Result::Err(e) then return Result::Err(WsError::ConnectionFailed(e))
  end

  ## TCP connection
  let stream = match tcp_connect_host(host.clone(), port)
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err(WsError::ConnectionFailed(e.message()))
  end

  ## Generate Sec-WebSocket-Key (16 random bytes base64-encoded)
  let key_bytes = [0u8; 16]  ## Would use random_bytes in practice
  let ws_key = "dGhlIHNhbXBsZSBub25jZQ=="  ## Placeholder base64 key

  ## Send HTTP upgrade request
  let req = "GET " + path + " HTTP/1.1\r\n" +
    "Host: " + host + ":" + port.to_string() + "\r\n" +
    "Upgrade: websocket\r\n" +
    "Connection: Upgrade\r\n" +
    "Sec-WebSocket-Key: " + ws_key + "\r\n" +
    "Sec-WebSocket-Version: 13\r\n\r\n"

  match stream.write_all(req.as_bytes())
  when Result::Ok(_) then ()
  when Result::Err(e) then return Result::Err(WsError::ConnectionFailed(e.message()))
  end

  # Read HTTP response (enough for status line + headers)
  var resp_buf = [0u8; 4096]
  let n = match stream.read(&mut resp_buf)
  when Result::Ok(n) then n
  when Result::Err(e) then return Result::Err(WsError::ConnectionFailed(e.message()))
  end

  let resp = String::from_utf8_lossy(&resp_buf[..n])

  # Validate 101 Switching Protocols
  if !resp.starts_with("HTTP/1.1 101") then
    let status_line = match resp.find("\r\n")
    when Option::Some(idx) then resp[..idx].to_string()
    when Option::None then resp.clone()
    end
    return Result::Err(WsError::ProtocolError("expected 101, got: " + status_line))
  end

  # Verify Upgrade and Connection headers
  let resp_lower = resp.to_lowercase()
  if !resp_lower.contains("upgrade: websocket") then
    return Result::Err(WsError::ProtocolError("missing Upgrade: websocket header".to_string()))
  end
  if !resp_lower.contains("connection: upgrade") then
    return Result::Err(WsError::ProtocolError("missing Connection: Upgrade header".to_string()))
  end

  Result::Ok(WebSocket {
    stream: stream,
    is_client: true,
    closed: false,
    max_message_size: config.max_message_size,
  })
end

def parse_ws_url(url: &str) -> Result[(String, u16, String, Bool), String]
  let (scheme, rest) = if url.starts_with("wss://") then
    ("wss", &url[6..])
  elsif url.starts_with("ws://") then
    ("ws", &url[5..])
  else
    return Result::Err("invalid WebSocket URL scheme".to_string())
  end

  let use_tls = scheme == "wss"
  let default_port: u16 = if use_tls then 443 else 80 end

  let (host_port, path) = match rest.find("/")
  when Option::Some(idx) then (&rest[..idx], &rest[idx..])
  when Option::None then (rest, "/")
  end

  let (host, port) = match host_port.find(":")
  when Option::Some(idx) then
    let h = &host_port[..idx]
    let p = host_port[idx+1..].parse_u16().unwrap_or(default_port)
    (h.to_string(), p)
  when Option::None then (host_port.to_string(), default_port)
  end

  Result::Ok((host, port, path.to_string(), use_tls))
end

impl WebSocket
  ## Send a message
  def send(self: &mut WebSocket, msg: &WsMessage) -> Result[Unit, WsError]
    if self.closed then
      return Result::Err(WsError::ProtocolError("connection closed".to_string()))
    end
    let mask = if self.is_client then
      Option::Some([0x12u8, 0x34, 0x56, 0x78])  ## Should use random mask
    else
      Option::None
    end
    let frame = encode_ws_frame(&WsFrame {
      fin: true,
      opcode: msg.opcode,
      mask: mask,
      payload: msg.data.clone(),
    })
    match self.stream.write_all(&frame)
    when Result::Ok(_) then Result::Ok(())
    when Result::Err(e) then Result::Err(WsError::Io(e.message()))
    end
  end

  ## Receive a message
  def recv(self: &mut WebSocket) -> Result[WsMessage, WsError]
    if self.closed then
      return Result::Err(WsError::ProtocolError("connection closed".to_string()))
    end
    ## Read frame header (2 bytes minimum)
    let mut header = [0u8; 2]
    match self.stream.read_exact(&mut header)
    when Result::Err(e) then return Result::Err(WsError::Io(e.message()))
    when _ then ()
    end

    let fin = (header[0] & 0x80) != 0
    let opcode_val = header[0] & 0x0F
    let masked = (header[1] & 0x80) != 0
    let mut payload_len = (header[1] & 0x7F) as u64

    ## Extended payload length
    if payload_len == 126 then
      let mut ext = [0u8; 2]
      let _ = self.stream.read_exact(&mut ext)
      payload_len = ((ext[0] as u64) << 8) | (ext[1] as u64)
    elsif payload_len == 127 then
      let mut ext = [0u8; 8]
      let _ = self.stream.read_exact(&mut ext)
      payload_len = 0
      for i in 0..8 do
        payload_len = (payload_len << 8) | (ext[i] as u64)
      end
    end

    if payload_len as UInt > self.max_message_size then
      return Result::Err(WsError::MessageTooLarge(payload_len as UInt))
    end

    ## Read mask key if present
    let mask = if masked then
      let mut mk = [0u8; 4]
      let _ = self.stream.read_exact(&mut mk)
      Option::Some(mk)
    else
      Option::None
    end

    ## Read payload
    let mut payload = vec![0u8; payload_len as UInt]
    let _ = self.stream.read_exact(&mut payload)

    ## Unmask
    if let Option::Some(mk) = mask then
      for i in 0..payload.len() do
        payload[i] = payload[i] ^ mk[i % 4]
      end
    end

    let opcode = match u8_to_opcode(opcode_val)
    when Option::Some(op) then op
    when Option::None then return Result::Err(WsError::ProtocolError("unknown opcode".to_string()))
    end

    ## Handle control frames
    match opcode
    when WsOpcode::Close then
      self.closed = true
      let (code, reason) = if payload.len() >= 2 then
        let c = ((payload[0] as u16) << 8) | (payload[1] as u16)
        let r = if payload.len() > 2 then
          String::from_utf8(payload[2..].to_vec()).unwrap_or("".to_string())
        else "".to_string() end
        (c, r)
      else
        (1000u16, "".to_string())
      end
      return Result::Err(WsError::Closed(code, reason))
    when WsOpcode::Ping then
      ## Auto-pong
      let pong = WsMessage { opcode: WsOpcode::Pong, data: payload.clone() }
      let _ = self.send(&pong)
      return self.recv()  ## Read next actual message
    when _ then ()
    end

    Result::Ok(WsMessage { opcode: opcode, data: payload })
  end

  ## Close the WebSocket connection
  def close(self: &mut WebSocket, code: u16, reason: &str) -> Result[Unit, WsError]
    let mut payload = Vec::new()
    payload.push((code >> 8) as u8)
    payload.push((code & 0xFF) as u8)
    payload.extend(reason.as_bytes())
    let msg = WsMessage { opcode: WsOpcode::Close, data: payload }
    self.send(&msg)?
    self.closed = true
    Result::Ok(())
  end

  def is_closed(self: &WebSocket) -> Bool
    self.closed
  end
end

## Encode a WebSocket frame to bytes
def encode_ws_frame(frame: &WsFrame) -> Vec[u8]
  let mut buf = Vec::new()
  let mut b0: u8 = opcode_to_u8(&frame.opcode)
  if frame.fin then b0 = b0 | 0x80 end
  buf.push(b0)

  let len = frame.payload.len()
  let masked = frame.mask.is_some()
  let mask_bit: u8 = if masked then 0x80 else 0 end

  if len < 126 then
    buf.push((len as u8) | mask_bit)
  elsif len < 65536 then
    buf.push(126u8 | mask_bit)
    buf.push(((len >> 8) & 0xFF) as u8)
    buf.push((len & 0xFF) as u8)
  else
    buf.push(127u8 | mask_bit)
    for i in (0..8).rev() do
      buf.push(((len >> (i * 8)) & 0xFF) as u8)
    end
  end

  if let Option::Some(mk) = &frame.mask then
    buf.extend(mk)
    for i in 0..frame.payload.len() do
      buf.push(frame.payload[i] ^ mk[i % 4])
    end
  else
    buf.extend(&frame.payload)
  end

  buf
end

# ———————————————————————————————————————————————————————————————
# Connection Pool
# ———————————————————————————————————————————————————————————————

struct ConnectionPoolEntry
  stream: TcpStream
  host: String
  port: u16
  created_at: UInt   ## timestamp ms
  last_used: UInt
  is_tls: Bool
end

struct ConnectionPool
  connections: Vec[ConnectionPoolEntry]
  max_idle_per_host: UInt
  max_total: UInt
  idle_timeout_ms: UInt
end

def connection_pool_new() -> ConnectionPool
  ConnectionPool {
    connections: Vec::new(),
    max_idle_per_host: 8,
    max_total: 64,
    idle_timeout_ms: 90000,  ## 90 seconds
  }
end

impl ConnectionPool
  def get(self: &mut ConnectionPool, host: &str, port: u16) -> Option[TcpStream]
    let mut idx = Option::None
    for i in 0..self.connections.len() do
      if self.connections[i].host == host && self.connections[i].port == port then
        idx = Option::Some(i)
        break
      end
    end
    match idx
    when Option::Some(i) then
      let entry = self.connections.remove(i)
      Option::Some(entry.stream)
    when Option::None then Option::None
    end
  end

  def put(self: &mut ConnectionPool, stream: TcpStream, host: String, port: u16) -> Unit
    ## Count connections for this host
    let mut count = 0_u
    for entry in &self.connections do
      if entry.host == host && entry.port == port then
        count = count + 1
      end
    end
    if count >= self.max_idle_per_host || self.connections.len() >= self.max_total then
      return  ## Drop the connection
    end
    self.connections.push(ConnectionPoolEntry {
      stream: stream,
      host: host,
      port: port,
      created_at: 0,
      last_used: 0,
      is_tls: false,
    })
  end

  def evict_expired(self: &mut ConnectionPool, now_ms: UInt) -> Unit
    self.connections.retain(|entry| {
      now_ms - entry.last_used < self.idle_timeout_ms
    })
  end

  def clear(self: &mut ConnectionPool) -> Unit
    self.connections.clear()
  end
end

# ———————————————————————————————————————————————————————————————
# HTTP Middleware
# ———————————————————————————————————————————————————————————————

## Middleware processes requests before they reach handlers and
## responses before they are sent to clients.
trait Middleware
  def process_request(self: &Self, req: &mut HttpRequest) -> Result[Unit, HttpError]
  def process_response(self: &Self, req: &HttpRequest, resp: &mut HttpResponse) -> Result[Unit, HttpError]
end

## Logging middleware
struct LoggingMiddleware
  log_headers: Bool
  log_body: Bool
end

impl Middleware for LoggingMiddleware
  def process_request(self: &LoggingMiddleware, req: &mut HttpRequest) -> Result[Unit, HttpError]
    ## Log: METHOD PATH
    Result::Ok(())
  end
  def process_response(self: &LoggingMiddleware, req: &HttpRequest, resp: &mut HttpResponse) -> Result[Unit, HttpError]
    ## Log: STATUS for METHOD PATH
    Result::Ok(())
  end
end

## CORS middleware
struct CorsMiddleware
  allowed_origins: Vec[String]
  allowed_methods: Vec[String]
  allowed_headers: Vec[String]
  max_age: UInt
end

def cors_permissive() -> CorsMiddleware
  CorsMiddleware {
    allowed_origins: vec!["*".to_string()],
    allowed_methods: vec!["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"].iter().map(|s| s.to_string()).collect(),
    allowed_headers: vec!["*".to_string()],
    max_age: 86400,
  }
end

impl Middleware for CorsMiddleware
  def process_request(self: &CorsMiddleware, req: &mut HttpRequest) -> Result[Unit, HttpError]
    Result::Ok(())
  end
  def process_response(self: &CorsMiddleware, req: &HttpRequest, resp: &mut HttpResponse) -> Result[Unit, HttpError]
    let origin_header = if self.allowed_origins.len() == 1 && self.allowed_origins[0] == "*" then
      "*".to_string()
    else
      self.allowed_origins.join(", ")
    end
    resp.headers.set("Access-Control-Allow-Origin", &origin_header)
    resp.headers.set("Access-Control-Allow-Methods", &self.allowed_methods.join(", "))
    resp.headers.set("Access-Control-Allow-Headers", &self.allowed_headers.join(", "))
    resp.headers.set("Access-Control-Max-Age", &self.max_age.to_string())
    Result::Ok(())
  end
end

## Rate limiting middleware
struct RateLimitMiddleware
  max_requests: UInt
  window_ms: UInt
  counters: Map[String, (UInt, UInt)]  ## IP -> (count, window_start)
end

impl Middleware for RateLimitMiddleware
  def process_request(self: &RateLimitMiddleware, req: &mut HttpRequest) -> Result[Unit, HttpError]
    ## Check rate limit based on client IP
    Result::Ok(())
  end
  def process_response(self: &RateLimitMiddleware, req: &HttpRequest, resp: &mut HttpResponse) -> Result[Unit, HttpError]
    Result::Ok(())
  end
end

## Middleware chain
struct MiddlewareChain
  middlewares: Vec[Box[dyn Middleware]]
end

def middleware_chain_new() -> MiddlewareChain
  MiddlewareChain { middlewares: Vec::new() }
end

impl MiddlewareChain
  def add[M: Middleware + 'static](self: &mut MiddlewareChain, middleware: M) -> &mut MiddlewareChain
    self.middlewares.push(Box::new(middleware))
    self
  end

  def process_request(self: &MiddlewareChain, req: &mut HttpRequest) -> Result[Unit, HttpError]
    for mw in &self.middlewares do
      mw.process_request(req)?
    end
    Result::Ok(())
  end

  def process_response(self: &MiddlewareChain, req: &HttpRequest, resp: &mut HttpResponse) -> Result[Unit, HttpError]
    ## Process in reverse order
    for i in (0..self.middlewares.len()).rev() do
      self.middlewares[i].process_response(req, resp)?
    end
    Result::Ok(())
  end
end
