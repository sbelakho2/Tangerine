# Tangerine Standard Library — std::dynload
# Dynamic Library Loading (dlopen/LoadLibrary)
# Cross-platform shared library loading and symbol resolution

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, Ptr}
use std::ffi::{CString, CStr}

# ═══════════════════════════════════════════════════════════════
# Platform Detection
# ═══════════════════════════════════════════════════════════════

enum Platform
  Linux
  MacOS
  Windows
  FreeBSD
  OpenBSD
  NetBSD
  Unknown
end

def current_platform() -> Platform
  @cfg(target_os = "linux")
  return Platform::Linux
  
  @cfg(target_os = "macos")
  return Platform::MacOS
  
  @cfg(target_os = "windows")
  return Platform::Windows
  
  @cfg(target_os = "freebsd")
  return Platform::FreeBSD
  
  @cfg(target_os = "openbsd")
  return Platform::OpenBSD
  
  @cfg(target_os = "netbsd")
  return Platform::NetBSD
  
  @cfg(not(any(target_os = "linux", target_os = "macos", target_os = "windows", 
               target_os = "freebsd", target_os = "openbsd", target_os = "netbsd")))
  return Platform::Unknown
end

# ═══════════════════════════════════════════════════════════════
# Load Flags
# ═══════════════════════════════════════════════════════════════

struct LoadFlags
  # POSIX dlopen flags
  rtld_now: Bool           # Resolve all symbols immediately
  rtld_lazy: Bool          # Defer symbol resolution
  rtld_local: Bool         # Symbols not available to other libs
  rtld_global: Bool        # Symbols available to subsequently loaded libs
  rtld_nodelete: Bool      # Never unload the library
  rtld_no_load: Bool       # Don't load, just check if loaded
  rtld_deepbind: Bool      # Prefer local symbols over global
  
  # Windows-specific flags
  load_library_search_default_dirs: Bool
  load_library_search_application_dir: Bool
  load_library_search_system32: Bool
  load_library_search_user_dirs: Bool
  load_with_altered_search_path: Bool
end

def LoadFlags::default() -> LoadFlags
  LoadFlags {
    rtld_now: true,
    rtld_lazy: false,
    rtld_local: true,
    rtld_global: false,
    rtld_nodelete: false,
    rtld_no_load: false,
    rtld_deepbind: false,
    load_library_search_default_dirs: false,
    load_library_search_application_dir: false,
    load_library_search_system32: false,
    load_library_search_user_dirs: false,
    load_with_altered_search_path: false
  }
end

def LoadFlags::lazy() -> LoadFlags
  let mut flags = LoadFlags::default()
  flags.rtld_now = false
  flags.rtld_lazy = true
  flags
end

def LoadFlags::global() -> LoadFlags
  let mut flags = LoadFlags::default()
  flags.rtld_local = false
  flags.rtld_global = true
  flags
end

# ═══════════════════════════════════════════════════════════════
# Error Handling
# ═══════════════════════════════════════════════════════════════

enum DynLoadError
  LibraryNotFound(String)
  SymbolNotFound(String)
  InvalidHandle
  PlatformError(String)
  PermissionDenied(String)
  CorruptLibrary(String)
  VersionMismatch(String)
  DependencyMissing(String)
  Unknown(String)
end

impl DynLoadError
  def message(self: &DynLoadError) -> String
    match self
    when DynLoadError::LibraryNotFound(s) then "library not found: " + s.clone()
    when DynLoadError::SymbolNotFound(s) then "symbol not found: " + s.clone()
    when DynLoadError::InvalidHandle then "invalid library handle"
    when DynLoadError::PlatformError(s) then "platform error: " + s.clone()
    when DynLoadError::PermissionDenied(s) then "permission denied: " + s.clone()
    when DynLoadError::CorruptLibrary(s) then "corrupt library: " + s.clone()
    when DynLoadError::VersionMismatch(s) then "version mismatch: " + s.clone()
    when DynLoadError::DependencyMissing(s) then "dependency missing: " + s.clone()
    when DynLoadError::Unknown(s) then "unknown error: " + s.clone()
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Library Handle
# ═══════════════════════════════════════════════════════════════

struct Library
  handle: Ptr      # Platform-specific handle (void* / HMODULE)
  path: String     # Path to the loaded library
  platform: Platform
end

# ═══════════════════════════════════════════════════════════════
# POSIX FFI Bindings (Linux/macOS/BSD)
# ═══════════════════════════════════════════════════════════════

@cfg(any(target_os = "linux", target_os = "macos", target_os = "freebsd", 
         target_os = "openbsd", target_os = "netbsd"))
@ffi("c")
extern def dlopen(filename: &u8, flags: Int) -> Ptr
end

@cfg(any(target_os = "linux", target_os = "macos", target_os = "freebsd", 
         target_os = "openbsd", target_os = "netbsd"))
@ffi("c")
extern def dlsym(handle: Ptr, symbol: &u8) -> Ptr
end

@cfg(any(target_os = "linux", target_os = "macos", target_os = "freebsd", 
         target_os = "openbsd", target_os = "netbsd"))
@ffi("c")
extern def dlclose(handle: Ptr) -> Int
end

@cfg(any(target_os = "linux", target_os = "macos", target_os = "freebsd", 
         target_os = "openbsd", target_os = "netbsd"))
@ffi("c")
extern def dlerror() -> &u8
end

# POSIX RTLD constants
def RTLD_NOW() -> Int = 2
def RTLD_LAZY() -> Int = 1
def RTLD_LOCAL() -> Int = 0
def RTLD_GLOBAL() -> Int = 256
def RTLD_NODELETE() -> Int = 4096
def RTLD_NOLOAD() -> Int = 4
def RTLD_DEEPBIND() -> Int = 8

# ═══════════════════════════════════════════════════════════════
# Windows FFI Bindings
# ═══════════════════════════════════════════════════════════════

@cfg(target_os = "windows")
@ffi("kernel32")
extern def LoadLibraryA(lpLibFileName: &u8) -> Ptr
end

@cfg(target_os = "windows")
@ffi("kernel32")
extern def LoadLibraryExA(lpLibFileName: &u8, hFile: Ptr, dwFlags: UInt) -> Ptr
end

@cfg(target_os = "windows")
@ffi("kernel32")
extern def LoadLibraryW(lpLibFileName: &u16) -> Ptr
end

@cfg(target_os = "windows")
@ffi("kernel32")
extern def GetModuleHandleA(lpModuleName: &u8) -> Ptr
end

@cfg(target_os = "windows")
@ffi("kernel32")
extern def GetProcAddress(hModule: Ptr, lpProcName: &u8) -> Ptr
end

@cfg(target_os = "windows")
@ffi("kernel32")
extern def FreeLibrary(hModule: Ptr) -> Int
end

@cfg(target_os = "windows")
@ffi("kernel32")
extern def GetLastError() -> UInt
end

@cfg(target_os = "windows")
@ffi("kernel32")
extern def SetLastError(dwErrCode: UInt) -> Unit
end

@cfg(target_os = "windows")
@ffi("kernel32")
extern def FormatMessageA(dwFlags: UInt, lpSource: Ptr, dwMessageId: UInt, 
                          dwLanguageId: UInt, lpBuffer: &u8, nSize: UInt, 
                          arguments: Ptr) -> UInt
end

# Windows LoadLibraryEx flags
def LOAD_LIBRARY_SEARCH_DEFAULT_DIRS() -> UInt = 4096
def LOAD_LIBRARY_SEARCH_APPLICATION_DIR() -> UInt = 512
def LOAD_LIBRARY_SEARCH_SYSTEM32() -> UInt = 2048
def LOAD_LIBRARY_SEARCH_USER_DIRS() -> UInt = 1024
def LOAD_WITH_ALTERED_SEARCH_PATH() -> UInt = 8
def FORMAT_MESSAGE_FROM_SYSTEM() -> UInt = 4096
def FORMAT_MESSAGE_ALLOCATE_BUFFER() -> UInt = 256
def FORMAT_MESSAGE_IGNORE_INSERTS() -> UInt = 512

# ═══════════════════════════════════════════════════════════════
# Core Loading Functions
# ═══════════════════════════════════════════════════════════════

def load_library(path: &String) -> Result[Library, DynLoadError]
  load_library_flags(path, LoadFlags::default())
end

def load_library_flags(path: &String, flags: LoadFlags) -> Result[Library, DynLoadError]
  let platform = current_platform()
  
  match platform
  when Platform::Linux then load_library_posix(path, flags, platform)
  when Platform::MacOS then load_library_posix(path, flags, platform)
  when Platform::FreeBSD then load_library_posix(path, flags, platform)
  when Platform::OpenBSD then load_library_posix(path, flags, platform)
  when Platform::NetBSD then load_library_posix(path, flags, platform)
  when Platform::Windows then load_library_windows(path, flags)
  when Platform::Unknown then 
    Result::Err(DynLoadError::PlatformError("unsupported platform"))
  end
end

@cfg(any(target_os = "linux", target_os = "macos", target_os = "freebsd", 
         target_os = "openbsd", target_os = "netbsd"))
def load_library_posix(path: &String, flags: LoadFlags, platform: Platform) -> Result[Library, DynLoadError]
  # Build dlopen flags
  mut dl_flags = 0
  if flags.rtld_now then dl_flags = dl_flags | RTLD_NOW() end
  if flags.rtld_lazy then dl_flags = dl_flags | RTLD_LAZY() end
  if flags.rtld_local then dl_flags = dl_flags | RTLD_LOCAL() end
  if flags.rtld_global then dl_flags = dl_flags | RTLD_GLOBAL() end
  if flags.rtld_nodelete then dl_flags = dl_flags | RTLD_NODELETE() end
  if flags.rtld_no_load then dl_flags = dl_flags | RTLD_NOLOAD() end
  if flags.rtld_deepbind then dl_flags = dl_flags | RTLD_DEEPBIND() end
  
  # Clear any existing error
  let _ = dlerror()
  
  # Convert path to CString
  let cpath = CString::new(path)
  let handle = dlopen(cpath.as_ptr(), dl_flags)
  
  if handle.is_null() then
    let err = dlerror()
    let err_str = if err.is_null() then "unknown error" else CStr::from_ptr(err).to_string() end
    Result::Err(DynLoadError::LibraryNotFound(err_str))
  else
    Result::Ok(Library { handle: handle, path: path.clone(), platform: platform })
  end
end

@cfg(target_os = "windows")
def load_library_windows(path: &String, flags: LoadFlags) -> Result[Library, DynLoadError]
  # Build Windows flags
  mut win_flags: UInt = 0
  if flags.load_library_search_default_dirs then 
    win_flags = win_flags | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS() 
  end
  if flags.load_library_search_application_dir then 
    win_flags = win_flags | LOAD_LIBRARY_SEARCH_APPLICATION_DIR() 
  end
  if flags.load_library_search_system32 then 
    win_flags = win_flags | LOAD_LIBRARY_SEARCH_SYSTEM32() 
  end
  if flags.load_library_search_user_dirs then 
    win_flags = win_flags | LOAD_LIBRARY_SEARCH_USER_DIRS() 
  end
  if flags.load_with_altered_search_path then 
    win_flags = win_flags | LOAD_WITH_ALTERED_SEARCH_PATH() 
  end
  
  SetLastError(0)
  
  let cpath = CString::new(path)
  let handle = if win_flags != 0 then
    LoadLibraryExA(cpath.as_ptr(), Ptr::null(), win_flags)
  else
    LoadLibraryA(cpath.as_ptr())
  end
  
  if handle.is_null() then
    let err = GetLastError()
    let err_str = format_windows_error(err)
    Result::Err(DynLoadError::LibraryNotFound(err_str))
  else
    Result::Ok(Library { handle: handle, path: path.clone(), platform: Platform::Windows })
  end
end

@cfg(target_os = "windows")
def format_windows_error(error_code: UInt) -> String
  if error_code == 0 then return "no error".to_string() end
  
  mut buffer: Vec[u8] = Vec::with_capacity(512)
  buffer.resize(512, 0)
  
  let len = FormatMessageA(
    FORMAT_MESSAGE_FROM_SYSTEM() | FORMAT_MESSAGE_IGNORE_INSERTS(),
    Ptr::null(),
    error_code,
    0,
    buffer.as_mut_ptr(),
    511,
    Ptr::null()
  )
  
  if len == 0 then
    "error code: " + error_code.to_string()
  else
    # Remove trailing whitespace
    mut end = len as Int - 1
    while end >= 0 && (buffer[end] == 13 || buffer[end] == 10 || buffer[end] == 32) do
      end = end - 1
    end
    String::from_bytes(buffer.slice(0, end + 1))
  end
end

# ═══════════════════════════════════════════════════════════════
# Symbol Resolution
# ═══════════════════════════════════════════════════════════════

def get_symbol(lib: &Library, name: &String) -> Result[Ptr, DynLoadError]
  match lib.platform
  when Platform::Linux then get_symbol_posix(lib, name)
  when Platform::MacOS then get_symbol_posix(lib, name)
  when Platform::FreeBSD then get_symbol_posix(lib, name)
  when Platform::OpenBSD then get_symbol_posix(lib, name)
  when Platform::NetBSD then get_symbol_posix(lib, name)
  when Platform::Windows then get_symbol_windows(lib, name)
  when Platform::Unknown then Result::Err(DynLoadError::PlatformError("unsupported platform"))
  end
end

@cfg(any(target_os = "linux", target_os = "macos", target_os = "freebsd", 
         target_os = "openbsd", target_os = "netbsd"))
def get_symbol_posix(lib: &Library, name: &String) -> Result[Ptr, DynLoadError]
  let _ = dlerror()  # Clear any existing error
  
  let cname = CString::new(name)
  let sym = dlsym(lib.handle, cname.as_ptr())
  
  let err = dlerror()
  if !err.is_null() then
    let err_str = CStr::from_ptr(err).to_string()
    Result::Err(DynLoadError::SymbolNotFound(err_str))
  else
    Result::Ok(sym)
  end
end

@cfg(target_os = "windows")
def get_symbol_windows(lib: &Library, name: &String) -> Result[Ptr, DynLoadError]
  SetLastError(0)
  
  let cname = CString::new(name)
  let sym = GetProcAddress(lib.handle, cname.as_ptr())
  
  if sym.is_null() then
    let err = GetLastError()
    let err_str = format_windows_error(err)
    Result::Err(DynLoadError::SymbolNotFound(err_str))
  else
    Result::Ok(sym)
  end
end

# ═══════════════════════════════════════════════════════════════
# Typed Symbol Access
# ═══════════════════════════════════════════════════════════════

# Function pointer type-erased wrapper
struct ForeignFunction
  ptr: Ptr
  name: String
  library: String
end

def get_function(lib: &Library, name: &String) -> Result[ForeignFunction, DynLoadError]
  let ptr = get_symbol(lib, name)?
  Result::Ok(ForeignFunction { 
    ptr: ptr, 
    name: name.clone(), 
    library: lib.path.clone() 
  })
end

# Generic variable accessor
struct ForeignVariable[T]
  ptr: Ptr
  name: String
  library: String
end

def get_variable[T](lib: &Library, name: &String) -> Result[ForeignVariable[T], DynLoadError]
  let ptr = get_symbol(lib, name)?
  Result::Ok(ForeignVariable[T] { 
    ptr: ptr, 
    name: name.clone(), 
    library: lib.path.clone() 
  })
end

def ForeignVariable[T]::read(self: &ForeignVariable[T]) -> T
  # Dereference the pointer to read the value
  # This is unsafe and requires the pointer to be valid
  @ptr_read(self.ptr, T)
end

def ForeignVariable[T]::write(self: &mut ForeignVariable[T], value: T) -> Unit
  # Write to the pointer location
  @ptr_write(self.ptr, value)
end

# ═══════════════════════════════════════════════════════════════
# Library Unloading
# ═══════════════════════════════════════════════════════════════

def close_library(lib: Library) -> Result[Unit, DynLoadError]
  match lib.platform
  when Platform::Linux then close_library_posix(lib)
  when Platform::MacOS then close_library_posix(lib)
  when Platform::FreeBSD then close_library_posix(lib)
  when Platform::OpenBSD then close_library_posix(lib)
  when Platform::NetBSD then close_library_posix(lib)
  when Platform::Windows then close_library_windows(lib)
  when Platform::Unknown then Result::Err(DynLoadError::PlatformError("unsupported platform"))
  end
end

@cfg(any(target_os = "linux", target_os = "macos", target_os = "freebsd", 
         target_os = "openbsd", target_os = "netbsd"))
def close_library_posix(lib: Library) -> Result[Unit, DynLoadError]
  let result = dlclose(lib.handle)
  if result != 0 then
    let err = dlerror()
    let err_str = if err.is_null() then "unknown error" else CStr::from_ptr(err).to_string() end
    Result::Err(DynLoadError::PlatformError(err_str))
  else
    Result::Ok(())
  end
end

@cfg(target_os = "windows")
def close_library_windows(lib: Library) -> Result[Unit, DynLoadError]
  let result = FreeLibrary(lib.handle)
  if result == 0 then
    let err = GetLastError()
    let err_str = format_windows_error(err)
    Result::Err(DynLoadError::PlatformError(err_str))
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Convenience Functions
# ═══════════════════════════════════════════════════════════════

# Load a library and get a symbol in one call
def load_symbol(lib_path: &String, sym_name: &String) -> Result[Ptr, DynLoadError]
  let lib = load_library(lib_path)?
  let sym = get_symbol(&lib, sym_name)
  # Note: library remains loaded (reference counted by OS)
  sym
end

# Check if a library is already loaded
def is_library_loaded(path: &String) -> Bool
  match current_platform()
  when Platform::Windows then
    let cpath = CString::new(path)
    let handle = GetModuleHandleA(cpath.as_ptr())
    !handle.is_null()
  else
    # POSIX: use RTLD_NOLOAD to check
    let cpath = CString::new(path)
    let handle = dlopen(cpath.as_ptr(), RTLD_NOLOAD())
    if !handle.is_null() then
      let _ = dlclose(handle)
      true
    else
      false
    end
  end
end

# Get the handle for an already-loaded library
def get_loaded_library(path: &String) -> Result[Library, DynLoadError]
  match current_platform()
  when Platform::Windows then
    let cpath = CString::new(path)
    let handle = GetModuleHandleA(cpath.as_ptr())
    if handle.is_null() then
      Result::Err(DynLoadError::LibraryNotFound(path.clone()))
    else
      Result::Ok(Library { handle: handle, path: path.clone(), platform: Platform::Windows })
    end
  else
    let cpath = CString::new(path)
    let handle = dlopen(cpath.as_ptr(), RTLD_NOLOAD() | RTLD_LOCAL())
    if handle.is_null() then
      Result::Err(DynLoadError::LibraryNotFound(path.clone()))
    else
      Result::Ok(Library { handle: handle, path: path.clone(), platform: current_platform() })
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Platform-Specific Library Names
# ═══════════════════════════════════════════════════════════════

def library_name(base: &String) -> String
  match current_platform()
  when Platform::Windows then base + ".dll"
  when Platform::MacOS then "lib" + base + ".dylib"
  else "lib" + base + ".so"
  end
end

def library_name_with_version(base: &String, major: Int, minor: Int, patch: Int) -> String
  match current_platform()
  when Platform::Windows then 
    base + "_" + major.to_string() + "_" + minor.to_string() + "_" + patch.to_string() + ".dll"
  when Platform::MacOS then 
    "lib" + base + "." + major.to_string() + "." + minor.to_string() + "." + patch.to_string() + ".dylib"
  else 
    "lib" + base + ".so." + major.to_string() + "." + minor.to_string() + "." + patch.to_string()
  end
end

# Common library paths for the current platform
def default_library_paths() -> Vec[String]
  match current_platform()
  when Platform::Linux then
    ["/usr/lib".to_string(), "/usr/local/lib".to_string(), "/lib".to_string(), 
     "/lib64".to_string(), "/usr/lib64".to_string()]
  when Platform::MacOS then
    ["/usr/lib".to_string(), "/usr/local/lib".to_string(), "/opt/homebrew/lib".to_string(),
     "/opt/local/lib".to_string()]
  when Platform::Windows then
    # Windows uses DLL search order
    Vec::new()
  else
    Vec::new()
  end
end

# Search for a library in default paths
def find_library(name: &String) -> Option[String]
  use std::fs
  
  # First check if it's an absolute path
  if name.starts_with("/") || (name.len() > 2 && name.char_at(1) == ':') then
    if fs::exists(name) then return Option::Some(name.clone()) end
    return Option::None
  end
  
  # Search in default paths
  for path in default_library_paths() do
    let full_path = path + "/" + name
    if fs::exists(&full_path) then
      return Option::Some(full_path)
    end
  end
  
  Option::None
end

# ═══════════════════════════════════════════════════════════════
# Self-Loading (get handle to current executable)
# ═══════════════════════════════════════════════════════════════

def load_self() -> Result[Library, DynLoadError]
  match current_platform()
  when Platform::Windows then
    let handle = GetModuleHandleA(Ptr::null() as &u8)
    if handle.is_null() then
      Result::Err(DynLoadError::PlatformError("failed to get self handle"))
    else
      Result::Ok(Library { handle: handle, path: "".to_string(), platform: Platform::Windows })
    end
  else
    # POSIX: pass NULL to dlopen to get a handle to the main executable
    let handle = dlopen(Ptr::null() as &u8, RTLD_NOW() | RTLD_LOCAL())
    if handle.is_null() then
      let err = dlerror()
      let err_str = if err.is_null() then "unknown error" else CStr::from_ptr(err).to_string() end
      Result::Err(DynLoadError::PlatformError(err_str))
    else
      Result::Ok(Library { handle: handle, path: "".to_string(), platform: current_platform() })
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# RAII Wrapper
# ═══════════════════════════════════════════════════════════════

struct OwnedLibrary
  inner: Option[Library]
end

def OwnedLibrary::load(path: &String) -> Result[OwnedLibrary, DynLoadError]
  let lib = load_library(path)?
  Result::Ok(OwnedLibrary { inner: Option::Some(lib) })
end

def OwnedLibrary::load_flags(path: &String, flags: LoadFlags) -> Result[OwnedLibrary, DynLoadError]
  let lib = load_library_flags(path, flags)?
  Result::Ok(OwnedLibrary { inner: Option::Some(lib) })
end

def OwnedLibrary::get_symbol(self: &OwnedLibrary, name: &String) -> Result[Ptr, DynLoadError]
  match &self.inner
  when Option::Some(lib) then get_symbol(lib, name)
  when Option::None then Result::Err(DynLoadError::InvalidHandle)
  end
end

def OwnedLibrary::get_function(self: &OwnedLibrary, name: &String) -> Result[ForeignFunction, DynLoadError]
  match &self.inner
  when Option::Some(lib) then get_function(lib, name)
  when Option::None then Result::Err(DynLoadError::InvalidHandle)
  end
end

def OwnedLibrary::path(self: &OwnedLibrary) -> Option[String]
  match &self.inner
  when Option::Some(lib) then Option::Some(lib.path.clone())
  when Option::None then Option::None
  end
end

def OwnedLibrary::is_loaded(self: &OwnedLibrary) -> Bool
  match &self.inner
  when Option::Some(_) then true
  when Option::None then false
  end
end

impl Drop for OwnedLibrary
  def drop(self: &mut OwnedLibrary) -> Unit
    match self.inner.take()
    when Option::Some(lib) then
      let _ = close_library(lib)
    when Option::None then ()
    end
  end
end