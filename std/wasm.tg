## std::wasm — WebAssembly target support and bindings
## Provides WASM host/guest APIs, component model, and runtime helpers.
## Spec: §stdlib.wasm

# [METADATA]
# module: tg::wasm
# status: alpha
# effects: [Kernel]
# capabilities: [Wasm, Net]
# error_codes: [ValidationFailed, InstantiationFailed, LinkError, RuntimeTrap, MemoryAccessOutOfBounds, TypeMismatch, ExportNotFound, FuelExhausted, StackOverflow]
# description: "WebAssembly host interface, module loading, instance management, and component model support."
# examples:
#   - |
#     use std::wasm::{WasmModule, WasmInstance}
#     let module = WasmModule::from_file("app.wasm").unwrap()
#     let mut instance = WasmInstance::new(&module).unwrap()
#     instance.call("start", []).unwrap()

module std::wasm

use std::ctx
use std::gfx_errors::{Error, ErrorCode}
use std::core::{Option, Result, Display, Bytes}
use std::collections::{Map}

# ─── WASM Value Types ────────────────────────────────────────────────

pub enum ValType
  I32
  I64
  F32
  F64
  V128
  FuncRef
  ExternRef
end

pub enum Val
  I32(i32)
  I64(i64)
  F32(f32)
  F64(f64)
  V128([u8; 16])
  FuncRef(Option[FuncRef])
  ExternRef(Option[ExternRef])
end

pub struct FuncRef
  _handle: UInt
end

pub struct ExternRef
  _handle: UInt
end

impl Display for ValType
  def to_string(self) -> String
    match self
    when I32 then "i32"
    when I64 then "i64"
    when F32 then "f32"
    when F64 then "f64"
    when V128 then "v128"
    when FuncRef then "funcref"
    when ExternRef then "externref"
    end
  end
end

# ─── WASM Module (Host-side) ────────────────────────────────────────

pub struct WasmModule
  _bytes: Bytes
  _validated: Bool
end

pub struct WasmInstance
  _module: WasmModule
  _memory: Option[Memory]
  _exports: Map[String, Export]
  _imports: Map[String, Import]
end

pub enum Export
  Func(ExportedFunc)
  Memory(Memory)
  Table(Table)
  Global(Global)
end

pub enum Import
  Func(ImportedFunc)
  Memory(MemoryType)
  Table(TableType)
  Global(GlobalType)
end

pub struct ExportedFunc
  pub name: String
  pub params: List[ValType]
  pub results: List[ValType]
  _index: UInt
end

pub struct ImportedFunc
  pub module: String
  pub name: String
  pub params: List[ValType]
  pub results: List[ValType]
end

pub struct Memory
  _handle: UInt
  pub min_pages: UInt   ## each page = 64KB
  pub max_pages: Option[UInt]
end

pub struct MemoryType
  pub min: UInt
  pub max: Option[UInt]
end

pub struct Table
  _handle: UInt
  pub element: ValType
  pub min: UInt
  pub max: Option[UInt]
end

pub struct TableType
  pub element: ValType
  pub min: UInt
  pub max: Option[UInt]
end

pub struct Global
  _handle: UInt
  pub val_type: ValType
  pub mutable: Bool
end

pub struct GlobalType
  pub val_type: ValType
  pub mutable: Bool
end

# ─── Error type ──────────────────────────────────────────────────────

pub enum WasmError
  ValidationFailed(String)
  InstantiationFailed(String)
  LinkError(String)
  RuntimeTrap(TrapCode)
  MemoryAccessOutOfBounds
  TypeMismatch { expected: ValType, got: ValType }
  ExportNotFound(String)
  FuelExhausted
  StackOverflow
end

pub enum TrapCode
  Unreachable
  IntegerOverflow
  IntegerDivisionByZero
  InvalidConversionToInt
  MemoryOutOfBounds
  TableOutOfBounds
  IndirectCallTypeMismatch
  StackOverflow
  OutOfFuel
end

impl Display for WasmError
  def to_string(self) -> String
    match self
    when ValidationFailed(msg) then "wasm validation failed: " + msg
    when InstantiationFailed(msg) then "wasm instantiation failed: " + msg
    when LinkError(msg) then "wasm link error: " + msg
    when RuntimeTrap(code) then "wasm trap: " + code.to_string()
    when MemoryAccessOutOfBounds then "wasm memory access out of bounds"
    when TypeMismatch { expected, got } then
      "wasm type mismatch: expected " + expected.to_string() + ", got " + got.to_string()
    when ExportNotFound(name) then "wasm export not found: " + name
    when FuelExhausted then "wasm fuel exhausted"
    when StackOverflow then "wasm stack overflow"
    end
  end
end

impl Display for TrapCode
  def to_string(self) -> String
    match self
    when Unreachable then "unreachable"
    when IntegerOverflow then "integer overflow"
    when IntegerDivisionByZero then "integer division by zero"
    when InvalidConversionToInt then "invalid conversion to integer"
    when MemoryOutOfBounds then "out of bounds memory access"
    when TableOutOfBounds then "out of bounds table access"
    when IndirectCallTypeMismatch then "indirect call type mismatch"
    when StackOverflow then "call stack exhausted"
    when OutOfFuel then "all fuel consumed"
    end
  end
end

# ─── Module API ──────────────────────────────────────────────────────

impl WasmModule
  ## Load a WASM module from bytes (validates).
  pub def from_bytes(bytes: &[u8]) -> Result[WasmModule, WasmError]
    _validate_wasm(bytes)?
    Ok(WasmModule { _bytes: Bytes.from(bytes), _validated: true })
  end

  ## Load from a .wasm file.
  pub def from_file(path: &str) -> Result[WasmModule, WasmError]
    match std::fs::file_open(path.to_string())
    when Result::Ok(mut file) then
      let mut bytes: Vec[u8] = Vec.new()
      let chunk_size = 8192
      let mut done = false
      while !done do
        let mut chunk: Vec[u8] = Vec.new()
        match std::fs::file_read(&file, &mut chunk, chunk_size)
        when Result::Ok(n) then
          if n == 0 then
            done = true
          else
            bytes.extend(&chunk)
          end
        when Result::Err(e) then
          std::fs::file_close(&mut file)
          return Result::Err(WasmError::ValidationFailed("cannot read file: " + e.to_string()))
        end
      end
      std::fs::file_close(&mut file)
      Self.from_bytes(&bytes)
    when Result::Err(e) then
      Result::Err(WasmError::ValidationFailed("cannot read file: " + e.to_string()))
    end
  end

  ## List imports required by this module.
  pub def imports(self) -> List[Import]
    _parse_imports(&self._bytes)
  end

  ## List exports provided by this module.
  pub def exports(self) -> List[(String, Export)]
    _parse_exports(&self._bytes)
  end
end

# ─── Instance API ────────────────────────────────────────────────────

pub struct Linker
  _funcs: Map[String, Map[String, HostFunc]]
  _memories: Map[String, Map[String, Memory]]
end

pub struct HostFunc
  _callback: def(&mut Caller, &[Val]) -> Result[List[Val], WasmError]
end

pub struct Caller
  _instance: *mut WasmInstance
end

impl Linker
  pub def new() -> Linker
    Linker { _funcs: Map.new(), _memories: Map.new() }
  end

  pub def define_func(
    &mut self,
    module: &str,
    name: &str,
    func: def(&mut Caller, &[Val]) -> Result[List[Val], WasmError]
  ) -> &mut Self
    let mod_map = self._funcs.entry(module.to_string()).or_insert(Map.new())
    mod_map.insert(name.to_string(), HostFunc { _callback: func })
    self
  end

  pub def instantiate(&self, module: &WasmModule) -> Result[WasmInstance, WasmError]
    _link_and_instantiate(module, self)
  end
end

impl WasmInstance
  ## Call an exported function by name.
  pub def call(
    &mut self,
    name: &str,
    args: &[Val]
  ) -> Result[List[Val], WasmError]
    let export = self._exports.get(name)
      .ok_or(WasmError::ExportNotFound(name.to_string()))?
    match export
    when Func(f) then _invoke_func(self, f, args)
    else Err(WasmError::ExportNotFound(name.to_string() + " is not a function"))
    end
  end

  ## Get a reference to linear memory.
  pub def get_memory(&self, name: &str) -> Option[&Memory]
    match self._exports.get(name)
    when Some(Memory(m)) then Some(m)
    else None
    end
  end
end

impl Caller
  pub def get_memory(&self, name: &str) -> Option[&Memory]
    unsafe { (*self._instance).get_memory(name) }
  end
end

# ─── Memory operations ──────────────────────────────────────────────

impl Memory
  pub def size_pages(self) -> UInt
    _memory_size(self._handle)
  end

  pub def size_bytes(self) -> UInt
    self.size_pages() * 65536
  end

  pub def grow(&mut self, delta_pages: UInt) -> Result[UInt, WasmError]
    let old_size = _memory_grow(self._handle, delta_pages)
    if old_size == UInt::MAX then
      Err(WasmError::MemoryAccessOutOfBounds)
    else
      Ok(old_size)
    end
  end

  pub def read_bytes(&self, offset: UInt, len: UInt) -> Result[Bytes, WasmError]
    if offset + len > self.size_bytes() then
      return Err(WasmError::MemoryAccessOutOfBounds)
    end
    Ok(_memory_read(self._handle, offset, len))
  end

  pub def write_bytes(&mut self, offset: UInt, data: &[u8]) -> Result[Unit, WasmError]
    if offset + data.len() as UInt > self.size_bytes() then
      return Err(WasmError::MemoryAccessOutOfBounds)
    end
    _memory_write(self._handle, offset, data)
    Ok(())
  end

  pub def read_i32(&self, offset: UInt) -> Result[i32, WasmError]
    let bytes = self.read_bytes(offset, 4)?
    Ok(i32.from_le_bytes(bytes.as_slice()))
  end

  pub def write_i32(&mut self, offset: UInt, value: i32) -> Result[Unit, WasmError]
    self.write_bytes(offset, &value.to_le_bytes())
  end

  pub def read_string(&self, offset: UInt, len: UInt) -> Result[String, WasmError]
    let bytes = self.read_bytes(offset, len)?
    String.from_utf8(bytes.to_vec())
      .map_err(|_| WasmError::RuntimeTrap(TrapCode::Unreachable))
  end

  pub def write_string(&mut self, offset: UInt, s: &str) -> Result[Unit, WasmError]
    self.write_bytes(offset, s.as_bytes())
  end
end

# ─── WASM Component Model (preview) ─────────────────────────────────

pub mod component
  use super::*

  pub struct Component
    _bytes: Bytes
    pub imports: List[ComponentImport]
    pub exports: List[ComponentExport]
  end

  pub struct ComponentImport
    pub name: String
    pub ty: ComponentType
  end

  pub struct ComponentExport
    pub name: String
    pub ty: ComponentType
  end

  pub enum ComponentType
    Func { params: List[(String, WitType)], results: List[WitType] }
    Instance(List[ComponentExport])
    Type(WitType)
  end

  ## WIT (WASM Interface Types)
  pub enum WitType
    Bool
    U8
    U16
    U32
    U64
    S8
    S16
    S32
    S64
    Float32
    Float64
    Char
    Str
    List(Box[WitType])
    Option(Box[WitType])
    Result { ok: Option[Box[WitType]], err: Option[Box[WitType]] }
    Tuple(List[WitType])
    Record(List[(String, WitType)])
    Variant(List[(String, Option[WitType])])
    Enum(List[String])
    Flags(List[String])
    Own(String)
    Borrow(String)
  end

  pub def from_bytes(bytes: &[u8]) -> Result[Component, WasmError]
    ## Parse the component section
    _validate_component(bytes)?
    let (imports, exports) = _parse_component_sections(bytes)
    Ok(Component { _bytes: Bytes.from(bytes), imports: imports, exports: exports })
  end
end

# ─── Guest-side helpers (used when compiling TO wasm) ────────────────

pub mod guest
  ## Export a function to the host.
  ## Usage: @wasm::guest::export("my_func")
  pub def export(name: &str) -> Unit
    ## Handled by the compiler as an attribute
    @compiler_directive("wasm_export", name)
  end

  ## Import a function from the host.
  pub def import(module: &str, name: &str) -> Unit
    @compiler_directive("wasm_import", module, name)
  end

  ## Allocate memory visible to the host.
  @export("tg_alloc")
  pub def alloc(size: UInt) -> *mut u8
    std::alloc::global_alloc(size, 1)
  end

  ## Free memory allocated by alloc.
  @export("tg_dealloc")
  pub def dealloc(ptr: *mut u8, size: UInt) -> Unit
    std::alloc::dealloc(ptr, std::alloc::Layout.from_size_align(size, 1))
  end

  ## Abort handler for WASM (traps).
  @export("tg_abort")
  pub def abort(msg_ptr: *const u8, msg_len: UInt) -> Unit
    let msg = unsafe { String.from_raw_parts(msg_ptr, msg_len) }
    panic(msg)
  end
end

# ─── Fuel / metering ────────────────────────────────────────────────

pub struct FuelConfig
  pub initial_fuel: UInt
  pub fuel_per_instruction: UInt
  pub fuel_per_memory_page: UInt
end

impl FuelConfig
  pub def default() -> FuelConfig
    FuelConfig {
      initial_fuel: 1_000_000,
      fuel_per_instruction: 1,
      fuel_per_memory_page: 1000,
    }
  end
end

# ─── Internal stubs ──────────────────────────────────────────────────

def _validate_wasm(bytes: &[u8]) -> Result[Unit, WasmError]
  ## Check magic number: \0asm
  if bytes.len() < 8 then
    return Err(WasmError::ValidationFailed("too short"))
  end
  if bytes[0] != 0x00 || bytes[1] != 0x61 || bytes[2] != 0x73 || bytes[3] != 0x6D then
    return Err(WasmError::ValidationFailed("invalid magic number"))
  end
  ## Check version (1)
  if bytes[4] != 0x01 || bytes[5] != 0x00 || bytes[6] != 0x00 || bytes[7] != 0x00 then
    return Err(WasmError::ValidationFailed("unsupported version"))
  end
  ## Full validation deferred to runtime engine
  Ok(())
end

def _validate_component(bytes: &[u8]) -> Result[Unit, WasmError]
  if bytes.len() < 8 then
    return Err(WasmError::ValidationFailed("too short"))
  end
  ## Component magic: \0asm + version 0x0d (component)
  if bytes[0] != 0x00 || bytes[1] != 0x61 || bytes[2] != 0x73 || bytes[3] != 0x6D then
    return Err(WasmError::ValidationFailed("invalid magic"))
  end
  Ok(())
end

def _parse_imports(bytes: &Bytes) -> List[Import]
  ## Production implementation: Parse WASM import section
  match __intrinsic_wasm_parse_imports(bytes)
  when Ok(imports) then imports
  when Err(_) then List.new()
  end
end

def _parse_exports(bytes: &Bytes) -> List[(String, Export)]
  ## Production implementation: Parse WASM export section
  match __intrinsic_wasm_parse_exports(bytes)
  when Ok(exports) then exports
  when Err(_) then List.new()
  end
end

def _parse_component_sections(bytes: &[u8]) -> (List[component::ComponentImport], List[component::ComponentExport])
  ## Production implementation: Parse WASM Component Model sections
  match __intrinsic_wasm_parse_component_sections(bytes)
  when Ok(sections) then sections
  when Err(_) then (List.new(), List.new())
  end
end

def _link_and_instantiate(module: &WasmModule, linker: &Linker) -> Result[WasmInstance, WasmError]
  ## Production implementation: Link and instantiate via engine backend
  match __intrinsic_wasm_instantiate(module, linker)
  when Ok(instance) then Result::Ok(instance)
  when Err(e) then Result::Err(e)
  end
end

def _invoke_func(instance: &mut WasmInstance, func: &ExportedFunc, args: &[Val]) -> Result[List[Val], WasmError]
  ## Production implementation: Invoke WASM function via engine
  match __intrinsic_wasm_invoke(instance, func._index, args)
  when Ok(results) then Result::Ok(results)
  when Err(e) then Result::Err(e)
  end
end

def _memory_size(handle: UInt) -> UInt
  __intrinsic_wasm_memory_size(handle)
end

def _memory_grow(handle: UInt, delta: UInt) -> UInt
  __intrinsic_wasm_memory_grow(handle, delta)
end

def _memory_read(handle: UInt, offset: UInt, len: UInt) -> Bytes
  __intrinsic_wasm_memory_read(handle, offset, len)
end

def _memory_write(handle: UInt, offset: UInt, data: &[u8]) -> Unit
  __intrinsic_wasm_memory_write(handle, offset, data)
end

end ## module std::wasm
