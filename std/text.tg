# Tangerine Standard Library — tg::text
# Fonts, shaping, and layout.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 10.

# [METADATA]
# module: tg::text
# status: alpha
# effects: [Io]
# capabilities: [Net]
# error_codes: [FontNotFound, InvalidFont, ShapingFailed, IOError, Internal]
# description: "Fonts, text shaping (HarfBuzz-like), and layout engine with TrueType/OpenType support."
# examples:
#   - |
#     use std::text::{font_db_new, shape, TextStyle}
#     let db = font_db_new()
#     let run = shape(&db, "Hello", TextStyle{size: 16.0, ...}, default_shaping_opts()).unwrap()

use std::ctx
use std::gfx_errors::{Error, ErrorCode, TextError}

# ═══════════════════════════════════════════════════════════════
# §10.1 Types / enums
# ═══════════════════════════════════════════════════════════════

struct FontId
  value: u64
end

struct FontStyle
  weight: Int      # 100..900 (400 = normal, 700 = bold)
  italic: Bool
end

enum Direction
  Auto
  LTR
  RTL
end

enum TextAlign
  Start
  Center
  End
  Justify
end

struct TextStyle
  size: f32
  font: Option[FontId]
  color: Color
end

struct ShapingOpts
  direction: Direction
  language: Option[String]
end

struct LayoutOpts
  wrap: Bool
  align: TextAlign
  line_height: Option[f32]
end

# Opaque font database — holds loaded font faces.
struct FontDb
  _fonts: Vec[_FontEntry]
  _next_id: u64
end

struct Glyph
  id: Int
  x_adv: f32
  y_adv: f32
  x_off: f32
  y_off: f32
end

struct GlyphRun
  font: FontId
  size: f32
  glyphs: Vec[Glyph]
  xs: Vec[f32]
  ys: Vec[f32]
  bounds: Rect
  # Opaque handle for gfx integration
  _opaque: u64
end

struct CaretPos
  line: Int
  col: Int
end

struct TextLine
  run: GlyphRun
  baseline_y: f32
  rect: Rect
end

struct TextLayout
  lines: Vec[TextLine]
  bounds: Rect
end

# ═══════════════════════════════════════════════════════════════
# §10 TextError — MOVED TO GFX_ERRORS
# ═══════════════════════════════════════════════════════════════

use std::geom::{Color, Rect}
use std::app::{FsCap}
use std::core::{Option, Result, String, Bool, Int, Unit, Vec}

# ═══════════════════════════════════════════════════════════════
# Internal font storage
# ═══════════════════════════════════════════════════════════════

struct _FontEntry
  id: FontId
  family: String
  style: FontStyle
  data: Vec[u8]     # Raw font file bytes (TrueType/OpenType)
  units_per_em: Int  # Head table unitsPerEm (default 1000)
end

# ═══════════════════════════════════════════════════════════════
# Defaults
# ═══════════════════════════════════════════════════════════════

def default_shaping_opts() -> ShapingOpts
  ShapingOpts { direction: Direction::Auto, language: Option::None }
end

def default_layout_opts() -> LayoutOpts
  LayoutOpts { wrap: true, align: TextAlign::Start, line_height: Option::None }
end

# ═══════════════════════════════════════════════════════════════
# §10.2 Module API
# ═══════════════════════════════════════════════════════════════

def font_db_new() -> FontDb
  FontDb { _fonts: Vec::new(), _next_id: 1u64 }
end

def font_db_add_file(db: &mut FontDb, path: String, fs: &FsCap) -> Result[FontId, TextError]
  # Load font bytes from file system via FsCap.
  match fs.read_to_vec(path)
  when Result::Ok(bytes) then font_db_add_bytes(db, &bytes)
  when Result::Err(e) then Result::Err(TextError::IOError(e))
  end
end

def font_db_add_bytes(db: &mut FontDb, bytes: &Vec[u8]) -> Result[FontId, TextError]
  # Validate minimal TrueType/OpenType header, then store.
  let len = bytes.len()
  if len < 12 then
    return Result::Err(TextError::InvalidFont(
      Error::invalid_arg("Font data too short (< 12 bytes).".to_string())
    ))
  end

  # Check for TrueType ('00 01 00 00') or OpenType ('OTTO') signature.
  let b0 = bytes.get(0) as Int
  let b1 = bytes.get(1) as Int
  let b2 = bytes.get(2) as Int
  let b3 = bytes.get(3) as Int
  let is_ttf = b0 == 0 && b1 == 1 && b2 == 0 && b3 == 0
  let is_otf = b0 == 79 && b1 == 84 && b2 == 84 && b3 == 79  # "OTTO"

  if !is_ttf && !is_otf then
    return Result::Err(TextError::InvalidFont(
      Error::invalid_arg("Unrecognized font format (expected TrueType or OpenType).".to_string())
    ))
  end

  let id = FontId { value: db._next_id }
  db._next_id = db._next_id + 1u64

  # Clone font data for storage.
  let stored = Vec::with_capacity(len)
  let mut i = 0
  while i < len do
    stored.push(bytes.get(i))
    i = i + 1
  end

  # Parse units_per_em from head table
  let num_tables = _ttf_read_u16(&stored, 4) as Int
  let head_off = _ttf_find_table(&stored, num_tables, 104, 101, 97, 100)
  let upem = if head_off > 0 then _ttf_read_u16(&stored, head_off + 18) else 1000 end

  let entry = _FontEntry {
    id: id,
    family: "Unknown".to_string(),
    style: FontStyle { weight: 400, italic: false },
    data: stored,
    units_per_em: upem,
  }
  db._fonts.push(entry)
  Result::Ok(id)
end

def font_db_resolve(db: &FontDb, family: String, style: FontStyle) -> Option[FontId]
  # Linear scan — production implementation should index by family.
  let i = 0
  while i < db._fonts.len() do
    let entry = db._fonts.get(i)
    if entry.family == family && entry.style.weight == style.weight && entry.style.italic == style.italic then
      return Option::Some(entry.id)
    end
    i = i + 1
  end
  Option::None
end

def shape(db: &FontDb, text: String, style: TextStyle, opts: ShapingOpts) -> Result[GlyphRun, TextError]
  let font_id = match style.font
  when Option::Some(fid) then fid
  when Option::None then
    if db._fonts.len() == 0 then
      return Result::Err(TextError::FontNotFound(
        Error::invalid_arg("No fonts loaded in FontDb.".to_string())
      ))
    end
    db._fonts.get(0).id
  end

  # Find the font entry
  let mut font_entry_idx = -1
  let mut fi = 0
  while fi < db._fonts.len() do
    if db._fonts.get(fi).id.value == font_id.value then
      font_entry_idx = fi
    end
    fi = fi + 1
  end
  if font_entry_idx < 0 then
    return Result::Err(TextError::FontNotFound(
      Error::invalid_arg("Font not found in database.".to_string())
    ))
  end

  let entry = db._fonts.get(font_entry_idx)
  let font_data = &entry.data
  let upem = entry.units_per_em
  let scale = style.size / (upem as f32)

  # Parse font tables for metrics
  let num_tables = _ttf_read_u16(font_data, 4) as Int
  let cmap_offset = _ttf_find_table(font_data, num_tables, 99, 109, 97, 112)
  let hmtx_offset = _ttf_find_table(font_data, num_tables, 104, 109, 116, 120)
  let hhea_offset = _ttf_find_table(font_data, num_tables, 104, 104, 101, 97)
  let head_offset = _ttf_find_table(font_data, num_tables, 104, 101, 97, 100)

  # Get ascent/descent from hhea
  let ascent_raw = if hhea_offset > 0 then _ttf_read_i16(font_data, hhea_offset + 4) else 800 end
  let descent_raw = if hhea_offset > 0 then _ttf_read_i16(font_data, hhea_offset + 6) else -200 end
  let num_h_metrics = if hhea_offset > 0 then _ttf_read_u16(font_data, hhea_offset + 34) as Int else 0 end

  let ascent = (ascent_raw as f32) * scale
  let descent_abs = if descent_raw < 0 then (0 - descent_raw) as f32 * scale else (descent_raw as f32) * scale end

  let char_count = text.len()
  let glyphs = Vec::with_capacity(char_count)
  let xs = Vec::with_capacity(char_count)
  let ys = Vec::with_capacity(char_count)
  let mut x_cursor = 0.0f32

  let mut idx = 0
  while idx < char_count do
    let cp = text.char_at(idx) as Int
    let glyph_id = if cmap_offset > 0 then _cmap_lookup(font_data, cmap_offset, cp) else cp end
    let adv_raw = if hmtx_offset > 0 && num_h_metrics > 0 then
      let metric_idx = if glyph_id < num_h_metrics then glyph_id else num_h_metrics - 1 end
      _ttf_read_u16(font_data, hmtx_offset + metric_idx * 4) as Int
    else
      (upem * 6) / 10
    end
    let advance = (adv_raw as f32) * scale

    let g = Glyph {
      id: glyph_id,
      x_adv: advance,
      y_adv: 0.0f32,
      x_off: 0.0f32,
      y_off: 0.0f32,
    }
    glyphs.push(g)
    xs.push(x_cursor)
    ys.push(0.0f32)
    x_cursor = x_cursor + advance
    idx = idx + 1
  end

  let run_bounds = Rect {
    x: 0.0f32,
    y: 0.0f32 - ascent,
    w: x_cursor,
    h: ascent + descent_abs,
  }

  # Register with gfx module for rendering
  let glyph_ids = Vec::with_capacity(char_count)
  let advances = Vec::with_capacity(char_count)
  let mut gidx = 0
  while gidx < glyphs.len() do
    glyph_ids.push(glyphs.get(gidx).id as u32)
    advances.push(glyphs.get(gidx).x_adv)
    gidx = gidx + 1
  end
  let gfx_run = std::gfx::_register_glyph_run(glyph_ids, xs.clone(), ys.clone(), advances)

  Result::Ok(GlyphRun {
    font: font_id,
    size: style.size,
    glyphs: glyphs,
    xs: xs,
    ys: ys,
    bounds: run_bounds,
    _opaque: gfx_run._opaque,
  })
end

def layout(db: &FontDb, text: String, style: TextStyle, max_width: f32, opts: LayoutOpts) -> Result[TextLayout, TextError]
  # Reference layout: single-line or word-wrap based on max_width.
  let run_result = shape(db, text, style, ShapingOpts {
    direction: Direction::Auto,
    language: Option::None,
  })
  let run = match run_result
  when Result::Ok(r) then r
  when Result::Err(e) then return Result::Err(e)
  end

  let line_h = match opts.line_height
  when Option::Some(h) then h
  when Option::None then style.size * 1.2
  end

  if !opts.wrap || run.bounds.w <= max_width then
    # Single line.
    let line_rect = Rect { x: 0.0f32, y: 0.0f32, w: run.bounds.w, h: line_h }
    let tl = TextLine { run: run, baseline_y: style.size * 0.8, rect: line_rect }
    let lines = Vec::new()
    lines.push(tl)
    let layout_bounds = Rect { x: 0.0f32, y: 0.0f32, w: run.bounds.w, h: line_h }
    return Result::Ok(TextLayout { lines: lines, bounds: layout_bounds })
  end

  # Word-wrap: break at glyph that exceeds max_width.
  let lines = Vec::new()
  let glyph_count = run.glyphs.len()
  let line_start = 0
  let current_x = 0.0f32
  let y_offset = 0.0f32
  let max_line_w = 0.0f32

  let gi = 0
  while gi < glyph_count do
    let glyph = run.glyphs.get(gi)
    let next_x = current_x + glyph.x_adv

    if next_x > max_width && gi > line_start then
      # Emit line from line_start..gi
      let line_run = _sub_run(&run, line_start, gi, style)
      let lw = line_run.bounds.w
      if lw > max_line_w then
        max_line_w = lw
      end
      let lr = Rect { x: 0.0f32, y: y_offset, w: lw, h: line_h }
      lines.push(TextLine { run: line_run, baseline_y: y_offset + style.size * 0.8, rect: lr })
      y_offset = y_offset + line_h
      line_start = gi
      current_x = glyph.x_adv
    else
      current_x = next_x
    end
    gi = gi + 1
  end

  # Remaining glyphs
  if line_start < glyph_count then
    let line_run = _sub_run(&run, line_start, glyph_count, style)
    let lw = line_run.bounds.w
    if lw > max_line_w then
      max_line_w = lw
    end
    let lr = Rect { x: 0.0f32, y: y_offset, w: lw, h: line_h }
    lines.push(TextLine { run: line_run, baseline_y: y_offset + style.size * 0.8, rect: lr })
    y_offset = y_offset + line_h
  end

  let layout_bounds = Rect { x: 0.0f32, y: 0.0f32, w: max_line_w, h: y_offset }
  Result::Ok(TextLayout { lines: lines, bounds: layout_bounds })
end

def hit_test(layout: &TextLayout, x: f32, y: f32) -> CaretPos
  # Determine caret position from (x, y) coordinate.
  let line_count = layout.lines.len()
  if line_count == 0 then
    return CaretPos { line: 0, col: 0 }
  end

  # Find the line by y coordinate.
  let line_idx = 0
  let li = 0
  while li < line_count do
    let tl = layout.lines.get(li)
    if y >= tl.rect.y && y < tl.rect.y + tl.rect.h then
      line_idx = li
      li = line_count  # break
    else
      if li == line_count - 1 then
        line_idx = li
      end
    end
    li = li + 1
  end

  # Find column by x within the run.
  let tl = layout.lines.get(line_idx)
  let glyph_count = tl.run.glyphs.len()
  let col = glyph_count  # default: end of line
  let gi = 0
  while gi < glyph_count do
    let gx = tl.run.xs.get(gi)
    let adv = tl.run.glyphs.get(gi).x_adv
    if x < gx + adv * 0.5 then
      col = gi
      gi = glyph_count  # break
    end
    gi = gi + 1
  end

  CaretPos { line: line_idx, col: col }
end

def selection_rects(layout: &TextLayout, a: CaretPos, b: CaretPos) -> Vec[Rect]
  # Compute rectangles covering the selection from caret a to caret b.
  let rects = Vec::new()
  let start = a
  let stop = b
  if a.line > b.line || (a.line == b.line && a.col > b.col) then
    start = b
    stop = a
  end

  let line_idx = start.line
  while line_idx <= stop.line do
    if line_idx >= layout.lines.len() then
      line_idx = line_idx + 1
      next
    end
    let tl = layout.lines.get(line_idx)
    let col_start = if line_idx == start.line then start.col else 0 end
    let col_end = if line_idx == stop.line then stop.col else tl.run.glyphs.len() end

    if col_start >= col_end then
      line_idx = line_idx + 1
      next
    end

    let x0 = if col_start < tl.run.xs.len() then tl.run.xs.get(col_start) else 0.0f32 end
    let x1 = if col_end < tl.run.xs.len() then
      tl.run.xs.get(col_end)
    else
      tl.run.bounds.w
    end

    rects.push(Rect { x: x0, y: tl.rect.y, w: x1 - x0, h: tl.rect.h })
    line_idx = line_idx + 1
  end

  rects
end

# ═══════════════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════════════

def _sub_run(full: &GlyphRun, start: Int, stop: Int, style: TextStyle) -> GlyphRun
  # Extract a sub-range of glyphs as a new GlyphRun.
  let count = stop - start
  let glyphs = Vec::with_capacity(count)
  let xs = Vec::with_capacity(count)
  let ys = Vec::with_capacity(count)
  let advances = Vec::with_capacity(count)
  let glyph_ids = Vec::with_capacity(count)
  let x_origin = full.xs.get(start)
  let w = 0.0f32

  let i = start
  while i < stop do
    let g = full.glyphs.get(i)
    glyphs.push(g)
    glyph_ids.push(g.id as u32)
    advances.push(g.x_adv)
    xs.push(full.xs.get(i) - x_origin)
    ys.push(full.ys.get(i))
    w = w + g.x_adv
    i = i + 1
  end

  let bounds = Rect {
    x: 0.0f32,
    y: full.bounds.y,
    w: w,
    h: full.bounds.h,
  }

  # Register sub-run with gfx module
  let gfx_run = std::gfx::_register_glyph_run(glyph_ids, xs.clone(), ys.clone(), advances)

  GlyphRun {
    font: full.font,
    size: full.size,
    glyphs: glyphs,
    xs: xs,
    ys: ys,
    bounds: bounds,
    _opaque: gfx_run._opaque,
  }
end

# ═══════════════════════════════════════════════════════════════
# TrueType/OpenType parsing helpers
# ═══════════════════════════════════════════════════════════════

def _ttf_read_u16(data: &Vec[u8], off: Int) -> Int
  let b0 = data.get(off) as Int
  let b1 = data.get(off + 1) as Int
  (b0 << 8) | b1
end

def _ttf_read_i16(data: &Vec[u8], off: Int) -> Int
  let v = _ttf_read_u16(data, off)
  if v >= 32768 then v - 65536 else v end
end

def _ttf_read_u32(data: &Vec[u8], off: Int) -> Int
  let b0 = data.get(off) as Int
  let b1 = data.get(off + 1) as Int
  let b2 = data.get(off + 2) as Int
  let b3 = data.get(off + 3) as Int
  (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
end

def _ttf_find_table(data: &Vec[u8], num_tables: Int, t0: Int, t1: Int, t2: Int, t3: Int) -> Int
  let mut i = 0
  while i < num_tables do
    let record_off = 12 + i * 16
    if (data.get(record_off) as Int) == t0 &&
       (data.get(record_off + 1) as Int) == t1 &&
       (data.get(record_off + 2) as Int) == t2 &&
       (data.get(record_off + 3) as Int) == t3 then
      return _ttf_read_u32(data, record_off + 8)
    end
    i = i + 1
  end
  0
end

def _cmap_lookup(data: &Vec[u8], cmap_off: Int, codepoint: Int) -> Int
  let num_subtables = _ttf_read_u16(data, cmap_off + 2) as Int
  let mut best_offset = 0
  let mut i = 0
  while i < num_subtables do
    let rec = cmap_off + 4 + i * 8
    let platform = _ttf_read_u16(data, rec)
    let encoding = _ttf_read_u16(data, rec + 2)
    let sub_offset = _ttf_read_u32(data, rec + 4)
    # Prefer format 4 (platform 3 encoding 1) or format 12 (platform 3 encoding 10)
    if platform == 3 && (encoding == 1 || encoding == 10) then
      best_offset = cmap_off + sub_offset
    end
    i = i + 1
  end
  if best_offset == 0 then
    return codepoint
  end
  let fmt = _ttf_read_u16(data, best_offset)
  if fmt == 4 then
    _cmap_format4_lookup(data, best_offset, codepoint)
  elsif fmt == 12 then
    _cmap_format12_lookup(data, best_offset, codepoint)
  else
    codepoint
  end
end

def _cmap_format4_lookup(data: &Vec[u8], off: Int, cp: Int) -> Int
  if cp > 65535 then return 0 end
  let seg_count = _ttf_read_u16(data, off + 6) / 2
  let mut seg = 0
  while seg < seg_count do
    let end_code = _ttf_read_u16(data, off + 14 + seg * 2)
    if end_code >= cp then
      let start_off = off + 16 + seg_count * 2 + seg * 2
      let start_code = _ttf_read_u16(data, start_off)
      if start_code <= cp then
        let delta_off = off + 16 + seg_count * 4 + seg * 2
        let id_delta = _ttf_read_i16(data, delta_off)
        let range_off_pos = off + 16 + seg_count * 6 + seg * 2
        let id_range_offset = _ttf_read_u16(data, range_off_pos)
        if id_range_offset == 0 then
          return (cp + id_delta) & 0xFFFF
        else
          let glyph_off = range_off_pos + id_range_offset + (cp - start_code) * 2
          let glyph_id = _ttf_read_u16(data, glyph_off)
          if glyph_id != 0 then
            return (glyph_id + id_delta) & 0xFFFF
          end
          return 0
        end
      end
    end
    seg = seg + 1
  end
  0
end

def _cmap_format12_lookup(data: &Vec[u8], off: Int, cp: Int) -> Int
  let num_groups = _ttf_read_u32(data, off + 12) as Int
  let mut g = 0
  while g < num_groups do
    let group_off = off + 16 + g * 12
    let start_code = _ttf_read_u32(data, group_off)
    let end_code = _ttf_read_u32(data, group_off + 4)
    let start_glyph = _ttf_read_u32(data, group_off + 8)
    if cp >= start_code && cp <= end_code then
      return start_glyph + (cp - start_code)
    end
    g = g + 1
  end
  0
end
