end

pub trait SpiMaster
  def configure(&mut self, config: &SpiConfig) -> Result[Unit, HalError]
  def transfer(&mut self, write: &[u8], read: &mut [u8]) -> Result[Unit, HalError]
  def write(&mut self, data: &[u8]) -> Result[Unit, HalError]
  def read(&mut self, buf: &mut [u8]) -> Result[Unit, HalError]
end

