pub enum SpiMode
  Mode0  ## CPOL=0, CPHA=0
  Mode1  ## CPOL=0, CPHA=1
  Mode2  ## CPOL=1, CPHA=0
  Mode3  ## CPOL=1, CPHA=1
end

pub enum SpiBitOrder
