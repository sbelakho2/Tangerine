# ═══════════════════════════════════════════════════════════════════════
# §6  DMA Abstraction
# ═══════════════════════════════════════════════════════════════════════

pub enum DmaDirection
  MemoryToMemory
  MemoryToPeripheral
  PeripheralToMemory
end

pub enum DmaPriority
  Low
  Medium
  High
  VeryHigh
end

pub enum DmaDataSize
  Byte
  HalfWord
  Word
end

pub struct DmaConfig
  pub direction: DmaDirection
  pub priority: DmaPriority
  pub src_data_size: DmaDataSize
  pub dst_data_size: DmaDataSize
  pub src_increment: Bool
  pub dst_increment: Bool
  pub circular: Bool
end

pub trait DmaChannel
  def configure(inout self, config: DmaConfig) -> Result[Unit, HalError]
  def start(inout self, src: UInt, dst: UInt, length: UInt) -> Result[Unit, HalError]
  def stop(inout self) -> Unit
  def is_complete(self) -> Bool
  def is_error(self) -> Bool
  def remaining_transfers(self) -> UInt
  def clear_flags(inout self) -> Unit
  def enable_interrupt(inout self) -> Unit
  def disable_interrupt(inout self) -> Unit
end

## Safe DMA transfer handle that ties buffer lifetime to the transfer.
pub struct DmaTransfer[B]
  channel: PtrMut[dyn DmaChannel]
  buffer: B
  complete: Bool
end

impl[B] DmaTransfer[B]
  ## Check if the transfer is complete.
  pub def is_done(self) -> Bool
    self.complete || self.channel.as_ref().is_complete()
  end

  ## Block until transfer completes.
  pub def wait(inout self) -> Result[Unit, HalError]
    while !self.is_done() do
      if self.channel.as_ref().is_error() then
        return Err(HalError::Other(0))
      end
      nop()
    end
    self.complete = true
    Ok(())
  end

  ## Consume transfer and return the buffer.
  pub def release(self) -> B
    pre self.is_done(), "cannot release buffer before transfer completes"
    self.channel.as_ref().stop()
    self.buffer
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §7  Power Management
# ═══════════════════════════════════════════════════════════════════════

pub enum PowerMode
  ## Normal execution mode.
  Run
  ## Reduced clock speed, peripherals still active.
  LowPower
  ## CPU stopped, RAM retained, fast wake-up.
  Sleep
  ## Most clocks stopped, selected wake sources.
  DeepSleep
  ## Only RTC and wake-up pins active, RAM may be lost.
  Standby
  ## Everything off except wake-up pin. Cold boot on wake.
  Shutdown
end

pub trait PowerController
  def enter_mode(inout self, mode: PowerMode) -> Result[Unit, HalError]
  def current_mode(self) -> PowerMode
  def set_wake_source(inout self, source: WakeSource) -> Result[Unit, HalError]
  def disable_wake_source(inout self, source: WakeSource) -> Result[Unit, HalError]
  def get_reset_reason(self) -> ResetReason
end

pub enum WakeSource
  Pin(u8)
  Rtc
  Watchdog
  UartActivity
  I2cAddress
  Custom(u32)
end

pub enum ResetReason
  PowerOn
  ExternalReset
  Watchdog
  Software
  Brownout
  DeepSleepWake
  Unknown
end

# ═══════════════════════════════════════════════════════════════════════
# §8  Real-Time Safety
# ═══════════════════════════════════════════════════════════════════════

## Bounded stack analysis attribute.
## The compiler will verify that the annotated function and all callees
## use no more than `max_bytes` of stack space.
##
## Example:
##   @[max_stack(512)]
##   def isr_handler() -> Unit... end
@compiler_attribute("max_stack")
pub def max_stack(max_bytes: UInt) -> Unit end

## Worst-case execution time (WCET) annotation.
## The compiler will warn if static analysis suggests the function
## may exceed the specified time budget.
##
## Example:
##   @[wcet_us(100)]
##   def process_sample(sample: i16) -> i16... end
@compiler_attribute("wcet_us")
pub def wcet_us(max_microseconds: UInt) -> Unit end

## Assertion that no heap allocation occurs within the annotated scope.
## Compile error if any code path allocates.
@compiler_attribute("no_heap")
pub def no_heap() -> Unit end

## Assertion that no thread spawning occurs within the annotated scope.
@compiler_attribute("no_spawn")
pub def no_spawn() -> Unit end

## Assertion that no dynamic dispatch occurs within the annotated scope.
## All trait calls must be monomorphized.
@compiler_attribute("no_dynamic_dispatch")
pub def no_dynamic_dispatch() -> Unit end

# ═══════════════════════════════════════════════════════════════════════
# §9  Startup & Linker Script Integration
# ═══════════════════════════════════════════════════════════════════════

## Minimal startup code for bare-metal targets.
## Initializes.bss to zero, copies.data from flash to RAM, then calls main.
static __bss_start: u32 = 0u32
static __bss_end: u32 = 0u32
static __data_start: u32 = 0u32
static __data_end: u32 = 0u32
static __data_load: u32 = 0u32
extern def main() -> !

@[link_section(".text.reset")]
pub def _reset_handler() -> !
  ## Zero.bss section
  var bss_ptr = address_of(&mut __bss_start) as PtrMut[u32]
  let bss_end = address_of(&mut __bss_end) as Ptr[u32]
  while (bss_ptr as UInt) < (bss_end as UInt) do
    volatile_write(bss_ptr, 0u32)
    bss_ptr = bss_ptr.offset(1)
  end

  ## Copy.data from flash to RAM
  var data_ptr = address_of(&mut __data_start) as PtrMut[u32]
  let data_end = address_of(&mut __data_end) as Ptr[u32]
  var load_ptr = address_of(&mut __data_load) as Ptr[u32]
  while (data_ptr as UInt) < (data_end as UInt) do
    volatile_write(data_ptr, volatile_read(load_ptr))
    data_ptr = data_ptr.offset(1)
    load_ptr = load_ptr.offset(1)
  end

  ## Call user entry point
  main()
end

## Standard linker script symbols that the compiler recognizes.
pub mod linker
  ## Linker script template for ARM Cortex-M.
  pub const CORTEX_M_LINKER_SCRIPT: String = "
MEMORY
{
  FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 256K
  RAM   (rwx) : ORIGIN = 0x20000000, LENGTH = 64K
}

SECTIONS
{
 .isr_vector: { KEEP(*(.isr_vector)) } > FLASH
 .text      : { *(.text.text.*) } > FLASH
 .rodata    : { *(.rodata.rodata.*) } > FLASH
 .data      : {
    __data_start = .;
    *(.data .data.*)
    __data_end = .;
  } > RAM AT > FLASH
  __data_load = LOADADDR(.data);
 .bss (NOLOAD): {
    __bss_start = .;
    *(.bss .bss.*)
    __bss_end = .;
  } > RAM
  _stack_top = ORIGIN(RAM) + LENGTH(RAM);
}
"

  ## Linker script template for RISC-V.
  pub const RISCV_LINKER_SCRIPT: String = "
MEMORY
{
  FLASH (rx)  : ORIGIN = 0x20000000, LENGTH = 512K
  RAM   (rwx) : ORIGIN = 0x80000000, LENGTH = 64K
}

SECTIONS
{
 .text: { *(.text.init) *(.text.text.*) } > FLASH
 .rodata: { *(.rodata.rodata.*) } > FLASH
 .data: {
    __data_start = .;
    *(.data .data.*)
    __data_end = .;
  } > RAM AT > FLASH
  __data_load = LOADADDR(.data);
 .bss (NOLOAD): {
    __bss_start = .;
    *(.bss .bss.*)
    __bss_end = .;
  } > RAM
  _stack_top = ORIGIN(RAM) + LENGTH(RAM);
}
"
end

# ═══════════════════════════════════════════════════════════════════════
# §10  Embedded Target Definitions
# ═══════════════════════════════════════════════════════════════════════

pub enum EmbeddedTarget
  ## ARM Cortex-M0/M0+ (ARMv6-M, Thumb only)
  CortexM0
  ## ARM Cortex-M3 (ARMv7-M, Thumb-2)
  CortexM3
  ## ARM Cortex-M4 (ARMv7E-M, Thumb-2 + DSP)
  CortexM4
  ## ARM Cortex-M4F (ARMv7E-M, Thumb-2 + DSP + single-precision FPU)
  CortexM4F
  ## ARM Cortex-M7 (ARMv7E-M, Thumb-2 + DSP + double-precision FPU)
  CortexM7
  ## ARM Cortex-M33 (ARMv8-M Mainline, TrustZone)
  CortexM33
  ## RISC-V RV32I (base integer, no extensions)
  RiscV32I
  ## RISC-V RV32IMC (integer, multiply, compressed)
  RiscV32IMC
  ## RISC-V RV32IMAC (integer, multiply, atomics, compressed)
  RiscV32IMAC
  ## RISC-V RV64GC (general-purpose 64-bit)
  RiscV64GC
  ## ESP32 (Xtensa LX6 or RISC-V)
  Esp32
  ## AVR (ATmega328P, etc.)
  Avr
end

pub struct TargetSpec
  pub target: EmbeddedTarget
  pub cpu: String
  pub arch: String
  pub fpu: Bool
  pub endianness: Endianness
  pub pointer_width: u8
  pub max_atomic_width: u8
  pub default_linker: String
end

pub enum Endianness
  Little
  Big
end

impl EmbeddedTarget
  pub def spec(self) -> TargetSpec
    match self
    when CortexM0 then TargetSpec {
      target: self, cpu: "cortex-m0", arch: "thumbv6m",
      fpu: false, endianness: Endianness::Little,
      pointer_width: 32, max_atomic_width: 0,
      default_linker: "arm-none-eabi-ld",
    }
    when CortexM4F then TargetSpec {
      target: self, cpu: "cortex-m4", arch: "thumbv7em",
      fpu: true, endianness: Endianness::Little,
      pointer_width: 32, max_atomic_width: 32,
      default_linker: "arm-none-eabi-ld",
    }
    when CortexM7 then TargetSpec {
      target: self, cpu: "cortex-m7", arch: "thumbv7em",
      fpu: true, endianness: Endianness::Little,
      pointer_width: 32, max_atomic_width: 32,
      default_linker: "arm-none-eabi-ld",
    }
    when CortexM33 then TargetSpec {
      target: self, cpu: "cortex-m33", arch: "thumbv8m.main",
      fpu: true, endianness: Endianness::Little,
      pointer_width: 32, max_atomic_width: 32,
      default_linker: "arm-none-eabi-ld",
    }
    when RiscV32IMC then TargetSpec {
      target: self, cpu: "generic-rv32", arch: "riscv32imc",
      fpu: false, endianness: Endianness::Little,
      pointer_width: 32, max_atomic_width: 0,
      default_linker: "riscv32-unknown-elf-ld",
    }
    when RiscV32IMAC then TargetSpec {
      target: self, cpu: "generic-rv32", arch: "riscv32imac",
      fpu: false, endianness: Endianness::Little,
      pointer_width: 32, max_atomic_width: 32,
      default_linker: "riscv32-unknown-elf-ld",
    }
    when RiscV64GC then TargetSpec {
      target: self, cpu: "generic-rv64", arch: "riscv64gc",
      fpu: true, endianness: Endianness::Little,
      pointer_width: 64, max_atomic_width: 64,
      default_linker: "riscv64-unknown-elf-ld",
    }
    else TargetSpec {
      target: self, cpu: "generic", arch: "unknown",
      fpu: false, endianness: Endianness::Little,
      pointer_width: 32, max_atomic_width: 0,
      default_linker: "ld",
    }
    end
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §11  Firmware Packaging & Debug Probe Integration
# ═══════════════════════════════════════════════════════════════════════

## Firmware image formats for flashing.
pub enum FirmwareFormat
  ## Raw binary image.
  RawBin
  ## Intel HEX format.
  IntelHex
  ## ELF executable (for debuggers).
  Elf
  ## Motorola S-Record.
  SRecord
  ## UF2 (USB Flashing Format, e.g., RP2040).
  Uf2
end

## Debug probe types.
pub enum DebugProbe
  ## SEGGER J-Link (JTAG/SWD).
  JLink
  ## ST-LINK (STMicroelectronics).
  StLink
  ## CMSIS-DAP (standard debug access port).
  CmsisDap
  ## Black Magic Probe (GDB server built-in).
  BlackMagic
  ## OpenOCD (generic, many probes).
  OpenOcd
  ## Espressif ESP-Prog.
  EspProg
end

## Flash tool configuration.
pub struct FlashConfig
  pub probe: DebugProbe
  pub target: EmbeddedTarget
  pub firmware_format: FirmwareFormat
  pub verify_after_flash: Bool
  pub reset_after_flash: Bool
  pub speed_khz: u32
end

impl FlashConfig
  pub def default_for(target: EmbeddedTarget) -> FlashConfig
    FlashConfig {
      probe: DebugProbe::CmsisDap,
      target: target,
      firmware_format: FirmwareFormat::Elf,
      verify_after_flash: true,
      reset_after_flash: true,
      speed_khz: 4000,
    }
  end
end

## Commands that `tg` provides for embedded workflows:
##
## ```sh
## # Add an embedded target
## tg target add thumbv7em-none-eabihf
##
## # Build for Cortex-M4F
## tg build --target thumbv7em-none-eabihf --release
##
## # Flash to device via probe-rs
## tg flash --probe stlink --chip STM32F407VG
##
## # Start a GDB debug session
## tg debug --probe jlink --chip nRF52840
##
## # Analyze stack usage
## tg stack-analysis --target thumbv7em-none-eabihf
##
## # Generate firmware image
## tg objcopy --format ihex -o firmware.hex
## ```

# ═══════════════════════════════════════════════════════════════════════
# §12  Heap-Free Collections (for no_alloc environments)
# ═══════════════════════════════════════════════════════════════════════

## Fixed-capacity array-backed vector (no heap allocation).
pub struct ArrayVec[T, const N: UInt]
  _data: [T; N]
  _len: UInt
end

impl[T: Copy + Default, const N: UInt] ArrayVec[T, N]
  pub def new() -> ArrayVec[T, N]
      ArrayVec { _data: [T.default(); N], _len: 0 }
  end

  pub def len(self) -> UInt = self._len

  pub def capacity(self) -> UInt = self._data.len() as UInt

  pub def is_empty(self) -> Bool = self._len == 0

  pub def is_full(self) -> Bool = self._len == N

  pub def push(inout self, value: T) -> Result[Unit, T]
    if self._len >= N then
      return Err(value)
    end
    self._data[self._len] = value
    self._len = self._len + 1
    Ok(())
  end

  pub def pop(inout self) -> Option[T]
    if self._len == 0 then
      None
    else
      self._len = self._len - 1
      Some(self._data[self._len])
    end
  end

  pub def get(self, index: UInt) -> Option[T]
    if index < self._len then Some(self._data[index]) else None end
  end

  pub def get_mut(inout self, index: UInt) -> Option[PtrMut[T]]
    if index < self._len then Some(address_of_mut(&mut self._data[index])) else None end
  end

  pub def clear(inout self) -> Unit
    self._len = 0
  end

  pub def as_slice(self) -> FfiSlice[T]
    ffi_slice_new(&self._data[0] as Ptr[T], self._len)
  end
end

## Fixed-capacity ring buffer (for interrupt-safe producer/consumer).
pub struct RingBuffer[T: Copy + Default, const N: UInt]
  _data: [T; N]
  _head: UInt  ## next write position
  _tail: UInt  ## next read position
  _count: UInt
end

impl[T: Copy + Default, const N: UInt] RingBuffer[T, N]
  pub def new() -> RingBuffer[T, N]
      RingBuffer { _data: [T.default(); N], _head: 0, _tail: 0, _count: 0 }
  end

  pub def len(self) -> UInt = self._count

  pub def capacity(self) -> UInt = self._data.len() as UInt

  pub def is_empty(self) -> Bool = self._count == 0

  pub def is_full(self) -> Bool = self._count == N

  pub def push(inout self, value: T) -> Result[Unit, T]
    if self.is_full() then return Err(value) end
    self._data[self._head] = value
    self._head = (self._head + 1) % N
    self._count = self._count + 1
    Ok(())
  end

  pub def pop(inout self) -> Option[T]
    if self.is_empty() then return None end
    let value = self._data[self._tail]
    self._tail = (self._tail + 1) % N
    self._count = self._count - 1
    Some(value)
  end

  pub def peek(self) -> Option[T]
    if self.is_empty() then None else Some(self._data[self._tail]) end
  end
end

end ## module std::embedded
