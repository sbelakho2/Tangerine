## std::embedded — Embedded Systems & Bare-Metal Support
## Provides no_std core, hardware abstraction layer (HAL), volatile memory access,
## register abstractions, interrupt handling, DMA, power management, and
## bare-metal target support for ARM Cortex-M, RISC-V, and other embedded targets.
##
## Design goals:
##   - Zero runtime overhead
##   - No hidden allocations
##   - Deterministic execution
##   - Safe abstractions over unsafe hardware access
##   - Safely typed MMIO: one unsafe `from_address` binds a register
##     handle to its address; read/write/modify afterwards are safe,
##     width-exact volatile operations typed by the value type and the
##     access mode
##   - Compatible with no_alloc mode
##
## Spec: §stdlib.embedded

module std::embedded

use std::core::{Option, Result, Unit, Bool, Display}
use std::alloc::{size_of}
use std::ffi::{FfiSlice, Ptr, ffi_slice_new}

# ═══════════════════════════════════════════════════════════════════════
# §1  No-Std / No-Alloc Mode
# ═══════════════════════════════════════════════════════════════════════

## Panic strategies for embedded targets. Set via Tangerine.toml:
##   [profile.embedded]
##   panic = "abort"   # or "reset", "log", "ignore", "custom"
pub enum PanicStrategy
  ## Immediately abort the process (default for embedded).
  Abort
  ## Trigger a hardware reset via the reset vector.
  Reset
  ## Log the panic message and continue (unsafe — may leave inconsistent state).
  Log
  ## Silently ignore panics (unsafe — use only in hard real-time loops).
  Ignore
  ## Call a user-provided panic handler.
  Custom
end

## Custom panic handler type for embedded.
## Register via `@[panic_handler]` attribute on a function.
pub type PanicHandler = def(info: PanicInfo) -> !

pub struct PanicInfo
  pub message: String
  pub file: String
  pub line: Int
  pub column: Int
end

## Attribute to mark a function as the panic handler.
## Only one such function may exist per binary.
##
## Example:
##   @[panic_handler]
##   def my_panic(info: &PanicInfo) -> !
##     ## Write to UART, blink LED, etc.
##     loop { wfi() }
##   end
@compiler_attribute("panic_handler")
pub def panic_handler() -> Unit end

## Declare that the current crate uses no standard library.
## Equivalent to Rust's `#![no_std]`.
## Set in Tangerine.toml: `no_std = true`
@compiler_attribute("no_std")
pub def no_std() -> Unit end

## Declare that allocation is forbidden at compile time.
## Any code path that allocates will produce a compile error.
## Set in Tangerine.toml: `no_alloc = true`
@compiler_attribute("no_alloc")
pub def no_alloc() -> Unit end

## Declare the entry point for a bare-metal binary.
## Replaces the standard `main` function.
##
## Example:
##   @[entry]
##   def main() -> !
##     setup_hardware()
##     loop { run_main_loop() }
##   end
@compiler_attribute("entry")
pub def entry() -> Unit end

# ═══════════════════════════════════════════════════════════════════════
# §2  Volatile Memory Access
# ═══════════════════════════════════════════════════════════════════════

## Read a value from a memory address without compiler reordering or elision.
## The read is guaranteed to occur exactly once and not be optimized away.
@inline(always)
pub def volatile_read[T: Copy](ptr: Ptr[T]) -> T
  if ptr.is_null() then
    panic("null pointer in volatile_read")
  end
  (ptr as Ptr[T]).read()
end

## Write a value to a memory address without compiler reordering or elision.
## The write is guaranteed to occur exactly once and not be optimized away.
@inline(always)
pub def volatile_write[T: Copy](ptr: PtrMut[T], value: T) -> Unit
  if ptr.is_null() then
    panic("null pointer in volatile_write")
  end
  (ptr as Ptr[T]).write(value)
end

# ─── The runtime volatile intrinsics (the volatile/MMIO lowering arms) ───
# The width-exact volatile load/store surface. The compiler's runtime
# (tg_compiler/runtime.tg emit_volatile_runtime) provides the dedicated
# `_tg_volatile_read*` / `_tg_volatile_write*` functions — explicit
# load/store arms the optimizer cannot elide or reorder (the call boundary
# is opaque), emitted for aarch64 (ldrb/ldrh/ldr/strb/strh/str) and x86-64
# (movzx/mov). These are the MMIO register accessors the Register
# abstraction lowers to.

extern def _tg_volatile_read8(addr: UInt) -> u8
extern def _tg_volatile_read16(addr: UInt) -> u16
extern def _tg_volatile_read32(addr: UInt) -> u32
extern def _tg_volatile_read64(addr: UInt) -> u64
extern def _tg_volatile_write8(addr: UInt, value: u8) -> Unit
extern def _tg_volatile_write16(addr: UInt, value: u16) -> Unit
extern def _tg_volatile_write32(addr: UInt, value: u32) -> Unit
extern def _tg_volatile_write64(addr: UInt, value: u64) -> Unit

## Volatile 8-bit load (the runtime intrinsic arm).
@inline(always)
pub def volatile_read8(addr: UInt) -> u8
  _tg_volatile_read8(addr)
end

## Volatile 16-bit load (the runtime intrinsic arm).
@inline(always)
pub def volatile_read16(addr: UInt) -> u16
  _tg_volatile_read16(addr)
end

## Volatile 32-bit load (the runtime intrinsic arm).
@inline(always)
pub def volatile_read32(addr: UInt) -> u32
  _tg_volatile_read32(addr)
end

## Volatile 64-bit load (the runtime intrinsic arm).
@inline(always)
pub def volatile_read64(addr: UInt) -> u64
  _tg_volatile_read64(addr)
end

## Volatile 8-bit store (the runtime intrinsic arm).
@inline(always)
pub def volatile_write8(addr: UInt, value: u8) -> Unit
  _tg_volatile_write8(addr, value)
end

## Volatile 16-bit store (the runtime intrinsic arm).
@inline(always)
pub def volatile_write16(addr: UInt, value: u16) -> Unit
  _tg_volatile_write16(addr, value)
end

## Volatile 32-bit store (the runtime intrinsic arm).
@inline(always)
pub def volatile_write32(addr: UInt, value: u32) -> Unit
  _tg_volatile_write32(addr, value)
end

## Volatile 64-bit store (the runtime intrinsic arm).
@inline(always)
pub def volatile_write64(addr: UInt, value: u64) -> Unit
  _tg_volatile_write64(addr, value)
end

## Read-modify-write on a volatile address.
@inline(always)
pub def volatile_modify[T: Copy](ptr: PtrMut[T], f: def(T) -> T) -> Unit
  let old = volatile_read(ptr)
  volatile_write(ptr, f(old))
end

## Set specific bits in a volatile register.
@inline(always)
pub def volatile_set_bits(ptr: PtrMut[u32], mask: u32) -> Unit
  let value: u32 = (ptr as Ptr[u32]).read()
  volatile_write(ptr, value | mask)
end

## Clear specific bits in a volatile register.
@inline(always)
pub def volatile_clear_bits(ptr: PtrMut[u32], mask: u32) -> Unit
  let value: u32 = (ptr as Ptr[u32]).read()
  volatile_write(ptr, value & !mask)
end

## Toggle specific bits in a volatile register.
@inline(always)
pub def volatile_toggle_bits(ptr: PtrMut[u32], mask: u32) -> Unit
  let value: u32 = (ptr as Ptr[u32]).read()
  volatile_write(ptr, value ^ mask)
end

# ═══════════════════════════════════════════════════════════════════════
# §3  Memory-Mapped I/O & Register Abstraction
# ═══════════════════════════════════════════════════════════════════════

# ─── Raw MMIO Addresses ────────────────────────────────────────────

## A raw address of a memory-mapped peripheral register. A RawAddress is
## an opaque token, NOT a pointer: it cannot be dereferenced and no
## Ptr/PtrMut can be produced from it in safe code, so a register handle
## bound to a RawAddress can never leak a raw pointer. Conversion to and
## from the integer address is explicit (from_uint / as_uint).
pub struct RawAddress
  value: UInt
end

impl RawAddress
  ## Wrap a raw integer address (e.g. a device-block base).
  pub const def from_uint(value: UInt) -> RawAddress
    RawAddress { value: value }
  end

  ## Unwrap the raw integer address.
  pub const def as_uint(self) -> UInt
    self.value
  end

  ## Whether the address is naturally aligned to `size` bytes — the
  ## MMIO alignment contract checked at Register::from_address.
  pub def is_aligned_to(self, size: UInt) -> Bool
    self.value % size == 0
  end
end

# ─── Access Modes ──────────────────────────────────────────────────

## Access-mode marker: the register supports volatile reads only.
pub struct ReadOnlyMode
end

## Access-mode marker: the register supports volatile writes only.
pub struct WriteOnlyMode
end

## Access-mode marker: the register supports volatile reads, writes and
## read-modify-writes.
pub struct ReadWriteMode
end

# ─── The Access-Typed Register ─────────────────────────────────────

## A memory-mapped register at a fixed RawAddress, typed over the value
## type `T` and the access mode `Access` (ReadOnlyMode / WriteOnlyMode /
## ReadWriteMode).
##
## Safety model — one unsafe construction, then safe access:
##   - Construction from an arbitrary address requires the `unsafe`
##     context (`unsafe Register[T, Access]::from_address(...)`) and is
##     the ONLY unsafe point of the API. The width and alignment
##     invariants are enforced there (they panic — they are not
##     unchecked preconditions);
##   - WIDTH INVARIANT: `T` is one of u8 / u16 / u32 / u64. Enforced at
##     construction (size_of[T]() must be 1/2/4/8 bytes) and at the type
##     level: the volatile read/write/modify accessors exist only for
##     the u8/u16/u32/u64 instantiations below, so an access width is
##     always exactly the register width;
##   - ALIGNMENT: the address must be naturally aligned to the access
##     width (size_of[T]() bytes). The volatile load/store arms are
##     plain ldr/str-family accesses and MMIO registers on the
##     peripheral buses require natural alignment, so a misaligned
##     binding panics at construction instead of faulting at access
##     time (the aarch64/x86-64 host targets tolerate unaligned normal
##     accesses; MMIO semantics still require the natural alignment);
##   - VOLATILITY: every access routes through the width-exact volatile
##     runtime arms (volatile_read8/16/32/64 and volatile_write8/16/32/64
##     — the `_tg_volatile_*` externs), which are opaque call boundaries
##     the optimizer can neither elide nor reorder;
##   - NO POINTER ESCAPE: a register value stores only a RawAddress
##     token and offers no pointer accessor; `T` and `Access` are
##     phantom type parameters (the struct stores the address only,
##     mirroring Ptr[T]). A register handle is one word, Copy,
##     allocation-free and drop-free.
##
## The mode aliases ReadOnly[T] / WriteOnly[T] / ReadWrite[T] below
## spell the common instantiations.
pub struct Register[T, Access]
  address: RawAddress
end

impl[T, Access] Register[T, Access]
  ## Bind a register handle to an MMIO address — the single unsafe
  ## construction point. Every subsequent read()/write()/modify() on
  ## the handle is safe.
  ##
  ## # Safety
  ## The caller must guarantee that `address` references a real MMIO
  ## register of size_of[T]() bytes that is mapped and stays mapped for
  ## the whole lifetime of the handle.
  ##
  ## Panics (never UB) when an invariant is violated:
  ##   - size_of[T]() is not 1/2/4/8 (T is not u8/u16/u32/u64);
  ##   - the address is not naturally aligned to size_of[T]().
  pub unsafe def from_address(address: RawAddress) -> Register[T, Access]
    let width = size_of[T]()
    if width != 1 && width != 2 && width != 4 && width != 8 then
      panic("Register::from_address: T must be u8/u16/u32/u64 (size_of[T]() = " + width.to_string() + " bytes)")
    end
    if !address.is_aligned_to(width) then
      panic("Register::from_address: unaligned MMIO address (must be aligned to " + width.to_string() + " bytes)")
    end
    Register[T, Access] { address: address }
  end

  ## The raw address the register handle is bound to (register-block
  ## navigation: derive sibling registers from the unwrapped address).
  pub def raw_address(self) -> RawAddress
    self.address
  end
end

# ─── Access-Mode Aliases ───────────────────────────────────────────

## A read-only MMIO register handle — Register[T, ReadOnlyMode].
##
## Example:
##   let status = unsafe { ReadOnly[u32].from_address(RawAddress::from_uint(0x4002_1000)) }
##   let s: u32 = status.read()
pub type ReadOnly[T] = Register[T, ReadOnlyMode]

## A write-only MMIO register handle — Register[T, WriteOnlyMode].
##
## Example:
##   let ctrl = unsafe { WriteOnly[u32].from_address(RawAddress::from_uint(0x4002_1004)) }
##   ctrl.write(0x1)
pub type WriteOnly[T] = Register[T, WriteOnlyMode]

## A read-write MMIO register handle — Register[T, ReadWriteMode].
##
## Example:
##   let cr = unsafe { ReadWrite[u32].from_address(RawAddress::from_uint(0x4002_1008)) }
##   cr.modify(|v| v | 0x20)
pub type ReadWrite[T] = Register[T, ReadWriteMode]

## Convenience alias for 32-bit MMIO registers (read-write).
pub type Reg32 = Register[u32, ReadWriteMode]

## Convenience alias for 16-bit MMIO registers (read-write).
pub type Reg16 = Register[u16, ReadWriteMode]

## Convenience alias for 8-bit MMIO registers (read-write).
pub type Reg8 = Register[u8, ReadWriteMode]

# ─── Width-Exact Volatile Accessors ────────────────────────────────
# The accessor impls are per (width, mode) instantiation on purpose: the
# volatile runtime arms are width-typed externs (volatile_read8...
# volatile_write64) and the language has no type-level dispatch to pick
# the arm from a generic T, so the safe read/write/modify surface is
# monomorphized here for exactly the four sanctioned widths. Generic
# code can carry Register[T, Access] values (construction, address
# queries, block navigation) but performs its MMIO accesses on concrete
# instantiations — a Register[u32, ...] handle is a 32-bit register by
# construction.

# ─── 8-bit registers ───────────────────────────────────────────────

impl Register[u8, ReadOnlyMode]
  ## Read the register value (width-exact volatile byte load).
  @inline(always)
  pub def read(self) -> u8
    volatile_read8(self.address.as_uint())
  end
end

impl Register[u8, WriteOnlyMode]
  ## Write the register value (width-exact volatile byte store).
  @inline(always)
  pub def write(self, value: u8) -> Unit
    volatile_write8(self.address.as_uint(), value)
  end
end

impl Register[u8, ReadWriteMode]
  ## Read the register value (width-exact volatile byte load).
  @inline(always)
  pub def read(self) -> u8
    volatile_read8(self.address.as_uint())
  end

  ## Write the register value (width-exact volatile byte store).
  @inline(always)
  pub def write(self, value: u8) -> Unit
    volatile_write8(self.address.as_uint(), value)
  end

  ## Read-modify-write: apply `f` to the current value and store the
  ## result (two width-exact volatile arms; not atomic against a
  ## concurrent writer).
  @inline(always)
  pub def modify(self, f: def(u8) -> u8) -> Unit
    let current = volatile_read8(self.address.as_uint())
    volatile_write8(self.address.as_uint(), f(current))
  end
end

# ─── 16-bit registers ──────────────────────────────────────────────

impl Register[u16, ReadOnlyMode]
  ## Read the register value (width-exact volatile halfword load).
  @inline(always)
  pub def read(self) -> u16
    volatile_read16(self.address.as_uint())
  end
end

impl Register[u16, WriteOnlyMode]
  ## Write the register value (width-exact volatile halfword store).
  @inline(always)
  pub def write(self, value: u16) -> Unit
    volatile_write16(self.address.as_uint(), value)
  end
end

impl Register[u16, ReadWriteMode]
  ## Read the register value (width-exact volatile halfword load).
  @inline(always)
  pub def read(self) -> u16
    volatile_read16(self.address.as_uint())
  end

  ## Write the register value (width-exact volatile halfword store).
  @inline(always)
  pub def write(self, value: u16) -> Unit
    volatile_write16(self.address.as_uint(), value)
  end

  ## Read-modify-write: apply `f` to the current value and store the
  ## result (two width-exact volatile arms; not atomic against a
  ## concurrent writer).
  @inline(always)
  pub def modify(self, f: def(u16) -> u16) -> Unit
    let current = volatile_read16(self.address.as_uint())
    volatile_write16(self.address.as_uint(), f(current))
  end
end

# ─── 32-bit registers ──────────────────────────────────────────────

impl Register[u32, ReadOnlyMode]
  ## Read the register value (width-exact volatile word load).
  @inline(always)
  pub def read(self) -> u32
    volatile_read32(self.address.as_uint())
  end
end

impl Register[u32, WriteOnlyMode]
  ## Write the register value (width-exact volatile word store).
  @inline(always)
  pub def write(self, value: u32) -> Unit
    volatile_write32(self.address.as_uint(), value)
  end
end

impl Register[u32, ReadWriteMode]
  ## Read the register value (width-exact volatile word load).
  @inline(always)
  pub def read(self) -> u32
    volatile_read32(self.address.as_uint())
  end

  ## Write the register value (width-exact volatile word store).
  @inline(always)
  pub def write(self, value: u32) -> Unit
    volatile_write32(self.address.as_uint(), value)
  end

  ## Read-modify-write: apply `f` to the current value and store the
  ## result (two width-exact volatile arms; not atomic against a
  ## concurrent writer).
  @inline(always)
  pub def modify(self, f: def(u32) -> u32) -> Unit
    let current = volatile_read32(self.address.as_uint())
    volatile_write32(self.address.as_uint(), f(current))
  end

  ## Set the bits of `mask` (read-modify-write OR).
  @inline(always)
  pub def set_bits(self, mask: u32) -> Unit
    self.modify(|v| v | mask)
  end

  ## Clear the bits of `mask` (read-modify-write AND-NOT).
  @inline(always)
  pub def clear_bits(self, mask: u32) -> Unit
    self.modify(|v| v & !mask)
  end

  ## Toggle the bits of `mask` (read-modify-write XOR).
  @inline(always)
  pub def toggle_bits(self, mask: u32) -> Unit
    self.modify(|v| v ^ mask)
  end
end

# ─── 64-bit registers ──────────────────────────────────────────────

impl Register[u64, ReadOnlyMode]
  ## Read the register value (width-exact volatile doubleword load).
  @inline(always)
  pub def read(self) -> u64
    volatile_read64(self.address.as_uint())
  end
end

impl Register[u64, WriteOnlyMode]
  ## Write the register value (width-exact volatile doubleword store).
  @inline(always)
  pub def write(self, value: u64) -> Unit
    volatile_write64(self.address.as_uint(), value)
  end
end

impl Register[u64, ReadWriteMode]
  ## Read the register value (width-exact volatile doubleword load).
  @inline(always)
  pub def read(self) -> u64
    volatile_read64(self.address.as_uint())
  end

  ## Write the register value (width-exact volatile doubleword store).
  @inline(always)
  pub def write(self, value: u64) -> Unit
    volatile_write64(self.address.as_uint(), value)
  end

  ## Read-modify-write: apply `f` to the current value and store the
  ## result (two width-exact volatile arms; not atomic against a
  ## concurrent writer).
  @inline(always)
  pub def modify(self, f: def(u64) -> u64) -> Unit
    let current = volatile_read64(self.address.as_uint())
    volatile_write64(self.address.as_uint(), f(current))
  end
end

# ─── Bitfield Support ────────────────────────────────────────────────

## Bitfield extraction and insertion for register manipulation.
pub struct Bitfield
  offset: u32
  width: u32
end

impl Bitfield
  pub const def new(offset: u32, width: u32) -> Bitfield
    Bitfield { offset: offset, width: width }
  end

  ## Create a single-bit field.
  pub const def bit(offset: u32) -> Bitfield
    Bitfield { offset: offset, width: 1 }
  end

  ## Get the bitmask for this field.
  pub const def mask(self) -> u32
    ((1u32 << self.width) - 1) << self.offset
  end

  ## Extract this field from a register value.
  @inline(always)
  pub def extract(self, value: u32) -> u32
    (value >> self.offset) & ((1u32 << self.width) - 1)
  end

  ## Insert a value into this field of a register value.
  @inline(always)
  pub def insert(self, reg_value: u32, field_value: u32) -> u32
    let mask = self.mask()
    (reg_value & !mask) | ((field_value << self.offset) & mask)
  end

  ## Check if field is set (for single-bit fields).
  @inline(always)
  pub def is_set(self, value: u32) -> Bool
    (value & self.mask()) != 0
  end
end

# ─── Packed Struct Support ───────────────────────────────────────────

## Attribute to declare a packed struct with no padding.
## Usage: @[packed] on a struct declaration.
##
## Example:
##   @[packed]
##   @[repr(C)]
##   struct UartConfig
##     baud_rate: u32
##     data_bits: u8
##     stop_bits: u8
##     parity: u8
##     flow_control: u8
##   end
@compiler_attribute("packed")
pub def packed() -> Unit end

## Attribute to specify alignment.
## Usage: @[align(N)] on a struct declaration.
##
## Example:
##   @[align(4)]
##   struct DmaDescriptor
##     source: u32
##     dest: u32
##     length: u32
##     control: u32
##   end
@compiler_attribute("align")
pub def align(n: UInt) -> Unit end

## Attribute to specify linker section placement.
## Usage: @[link_section(".text.isr_vector")] on a function or static.
##
## Example:
##   @[link_section(".isr_vector")]
##   pub const VECTOR_TABLE: [*const def() -> Unit; 48] = [...]
@compiler_attribute("link_section")
pub def link_section(name: str) -> Unit end

# ═══════════════════════════════════════════════════════════════════════
# §4  Interrupt Handling
# ═══════════════════════════════════════════════════════════════════════

## Attribute to mark a function as an interrupt handler.
## The compiler ensures proper save/restore of registers and uses
## the correct return instruction (e.g., `bx lr` on ARM).
##
## Example:
##   @[interrupt]
##   def timer_isr() -> Unit
##     TIMER.clear_interrupt()
##     tick_count = tick_count + 1
##   end
@compiler_attribute("interrupt")
pub def interrupt() -> Unit end

## Attribute to mark a function as an exception handler.
@compiler_attribute("exception")
pub def exception() -> Unit end

# ─── The interrupt vector table ─────────────────────────────────────

## One vector table entry: the handler's position (the ARM Cortex-M
## vector table ordering — the reset vector is slot 0) and its entry
## function. The table lives in the `.isr_vector` section (the
## link_section contract); the embedded route collects every @interrupt
## function into the table in declaration order.
pub struct InterruptVector
  pub slot: UInt
  pub handler: String
end

## Build the interrupt vector table for the compiled program: slot 0 is
## the reset vector (`_reset_handler`), followed by the named @interrupt
## handlers in the given order. The result is the section-placement
## contract the linker script's KEEP(*(.isr_vector)) consumes.
pub def interrupt_vector_table(reset: String, handlers: [String]) -> [InterruptVector; 8]
  var table: [InterruptVector; 8] = [
    InterruptVector { slot: 0, handler: reset },
    InterruptVector { slot: 1, handler: if handlers.len() > 0 then handlers[0] else "default_handler" end },
    InterruptVector { slot: 2, handler: if handlers.len() > 1 then handlers[1] else "default_handler" end },
    InterruptVector { slot: 3, handler: if handlers.len() > 2 then handlers[2] else "default_handler" end },
    InterruptVector { slot: 4, handler: if handlers.len() > 3 then handlers[3] else "default_handler" end },
    InterruptVector { slot: 5, handler: if handlers.len() > 4 then handlers[4] else "default_handler" end },
    InterruptVector { slot: 6, handler: if handlers.len() > 5 then handlers[5] else "default_handler" end },
    InterruptVector { slot: 7, handler: if handlers.len() > 6 then handlers[6] else "default_handler" end },
  ]
  table
end

## The default (unhandled) interrupt entry: disable interrupts and loop.
@inline(always)
pub def default_handler() -> Unit
  disable_interrupts()
  loop { nop() }
end

## The atomicity availability for the current target: the maximum atomic
## access width in bits the target supports (0 = no hardware atomics —
## the Cortex-M0/thumbv6m and the RV32IMC contracts; 32 = the ARMv7E-M
## and RV32IMAC contracts; 64 = the RV64GC contract). Compiling an
## atomic type wider than the target's maximum must fail at the target
## layer; the embedded route records the same value in the target spec
## JSON.
pub def target_max_atomic_width() -> UInt
  @cfg(any(target_arch = "thumbv6m", target_arch = "riscv32imc"))
  return 0u32
  @cfg(any(target_arch = "thumbv7em", target_arch = "thumbv8m.main", target_arch = "riscv32imac"))
  return 32u32
  @cfg(any(target_arch = "riscv64gc"))
  return 64u32
  @cfg(any(target_arch = "aarch64", target_arch = "x86_64"))
  return 64u32
  0u32
end

## The abort contract: panic on an embedded target is abort-only — the
## `@[panic_handler]` function (or the default abort) is called and never
## returns.
pub def abort() -> !
  panic("embedded abort: unrecoverable fault")
end

## Interrupt priority type.
pub type InterruptPriority = u8

## Enable global interrupts.
@inline(always)
pub def enable_interrupts() -> Unit
  @cfg(target_arch = "arm")
  unsafe { asm!("cpsie i") }
  @cfg(target_arch = "aarch64")
  unsafe { asm!("msr daifclr, #2") }
  @cfg(target_arch = "riscv32")
  unsafe { asm!("csrsi mstatus, 0x8") }
  @cfg(target_arch = "riscv64")
  unsafe { asm!("csrsi mstatus, 0x8") }
end

## Disable global interrupts.
@inline(always)
pub def disable_interrupts() -> Unit
  @cfg(target_arch = "arm")
  unsafe { asm!("cpsid i") }
  @cfg(target_arch = "aarch64")
  unsafe { asm!("msr daifset, #2") }
  @cfg(target_arch = "riscv32")
  unsafe { asm!("csrci mstatus, 0x8") }
  @cfg(target_arch = "riscv64")
  unsafe { asm!("csrci mstatus, 0x8") }
end

## Execute a closure with interrupts disabled (critical section).
## Interrupts are restored to their previous state after the closure.
pub def critical_section[T](f: def() -> T) -> T
  let primask = _save_and_disable_interrupts()
  let result = f()
  _restore_interrupts(primask)
  result
end

@cfg(target_arch = "arm")
def _save_and_disable_interrupts() -> u32
  var primask: u32 = 0
  unsafe {
    asm!("mrs {0}, primask" : "=r"(primask))
    asm!("cpsid i")
  }
  primask
end

@cfg(target_arch = "arm")
def _restore_interrupts(primask: u32) -> Unit
  unsafe { asm!("msr primask, {0}" :: "r"(primask)) }
end

@cfg(target_arch = "riscv32")
def _save_and_disable_interrupts() -> u32
  var mstatus: u32 = 0
  unsafe {
    asm!("csrrci {0}, mstatus, 0x8" : "=r"(mstatus))
  }
  mstatus & 0x8
end

@cfg(target_arch = "riscv32")
def _restore_interrupts(mstatus_mie: u32) -> Unit
  if mstatus_mie != 0 then
    unsafe { asm!("csrsi mstatus, 0x8") }
  end
end

## Wait for interrupt (low-power sleep until next interrupt).
@inline(always)
pub def wfi() -> Unit
  @cfg(target_arch = "arm")
  unsafe { asm!("wfi") }
  @cfg(target_arch = "aarch64")
  unsafe { asm!("wfi") }
  @cfg(target_arch = "riscv32")
  unsafe { asm!("wfi") }
  @cfg(target_arch = "riscv64")
  unsafe { asm!("wfi") }
end

## Wait for event.
@inline(always)
pub def wfe() -> Unit
  @cfg(target_arch = "arm")
  unsafe { asm!("wfe") }
  @cfg(target_arch = "aarch64")
  unsafe { asm!("wfe") }
end

## Send event (wake other cores from WFE).
@inline(always)
pub def sev() -> Unit
  @cfg(target_arch = "arm")
  unsafe { asm!("sev") }
  @cfg(target_arch = "aarch64")
  unsafe { asm!("sev") }
end

## Data memory barrier.
@inline(always)
pub def dmb() -> Unit
  @cfg(target_arch = "arm")
  unsafe { asm!("dmb") }
  @cfg(target_arch = "aarch64")
  unsafe { asm!("dmb ish") }
  @cfg(target_arch = "riscv32")
  unsafe { asm!("fence rw, rw") }
end

## Data synchronization barrier.
@inline(always)
pub def dsb() -> Unit
  @cfg(target_arch = "arm")
  unsafe { asm!("dsb") }
  @cfg(target_arch = "aarch64")
  unsafe { asm!("dsb ish") }
  @cfg(target_arch = "riscv32")
  unsafe { asm!("fence iorw, iorw") }
end

## Instruction synchronization barrier.
@inline(always)
pub def isb() -> Unit
  @cfg(target_arch = "arm")
  unsafe { asm!("isb") }
  @cfg(target_arch = "aarch64")
  unsafe { asm!("isb") }
  @cfg(target_arch = "riscv32")
  unsafe { asm!("fence.i") }
end

## No-operation (for timing loops).
@inline(always)
pub def nop() -> Unit
  @cfg(any(target_arch = "arm", target_arch = "aarch64"))
  unsafe { asm!("nop") }
  @cfg(target_arch = "x86_64")
  unsafe { asm!("nop") }
  @cfg(any(target_arch = "riscv32", target_arch = "riscv64"))
  unsafe { asm!("nop") }
end

# ═══════════════════════════════════════════════════════════════════════
# §5  Hardware Abstraction Layer (HAL) Traits
# ═══════════════════════════════════════════════════════════════════════

## Error type for HAL operations.
pub enum HalError
  Busy
  Timeout
  OverflowError
  CrcError
  FrameError
  ParityError
  NoiseError
  BufferOverflow
  InvalidConfiguration
  NotReady
  Other(u32)
end

impl Display for HalError
  def to_string(self) -> String
    match self
    when Busy then "device busy"
    when Timeout then "operation timed out"
    when OverflowError then "overflow"
    when CrcError then "CRC error"
    when FrameError then "frame error"
    when ParityError then "parity error"
    when NoiseError then "noise error"
    when BufferOverflow then "buffer overflow"
    when InvalidConfiguration then "invalid configuration"
    when NotReady then "not ready"
    when Other(code) then "HAL error: " + code.to_string()
    end
  end
end

