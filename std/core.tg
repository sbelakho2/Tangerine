# Tangerine Standard Library — std::core
# Primitives, Option, Result, fundamental traits, prelude

enum Option[T]
  Some(T)
  None
end

enum Result[T, E]
  Ok(T)
  Err(E)
end

trait Copy
end

trait Drop
  def drop(self: &mut Self) -> Unit
end

# Standalone drop function: takes ownership and drops the value
def drop[T](x: T) -> Unit
end

trait Clone
  def clone(self: &Self) -> Self
end

trait Eq
  def eq(self: &Self, other: &Self) -> Bool
end

enum Ordering
  Less
  Equal
  Greater
end

trait Ord
  def cmp(self: &Self, other: &Self) -> Ordering
end

trait Hash
  def hash(self: &Self) -> Int
end

trait Default
  def default() -> Self
end

trait Into[T]
  def into(self) -> T
end

trait From[T]
  def from(x: T) -> Self
end

# Common error trait — implemented by all std error types
trait Error
  def message(self: &Self) -> String
  def source(self: &Self) -> Option[&dyn Error]
    Option::None
  end
end

# Display trait for user-facing string conversion
trait Display
  def fmt(self: &Self) -> String
end

# Vec[T] is an alias for Array[T] (dynamically-sized growable array).
# Array[T] is defined in std/collections.tg.
type Vec[T] = Array[T]

# List[T] is an alias for Array[T] (used by various std modules).
type List[T] = Array[T]
