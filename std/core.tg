# Intrinsic function declarations (extern — provided by codegen/interpreter)
# ———————————————————————————————————————————————————————————————

extern def __intrinsic_int_to_string(x: Int) -> String
extern def __intrinsic_float_to_string(x: Float) -> String
extern def __intrinsic_bool_to_string(x: Bool) -> String
extern def __intrinsic_char_to_string(x: Char) -> String

extern def __intrinsic_string_as_str(s: &String) -> str
extern def __intrinsic_string_len(s: &String) -> Int
extern def __intrinsic_string_push(s: &mut String, ch: Char) -> Unit
extern def __intrinsic_string_push_str(s: &mut String, other: &str) -> Unit
# P0-STRING: the owned String-object surface. string_new is the compiler
# constructor (String::new — no extern spelling needed); from_static is the
# explicit owned conversion of the static StrView (a string literal), and
# reserve is the capacity growth of the owned object (internal growth
# path of push/push_str).
extern def __intrinsic_string_from_static(s: &str) -> String
extern def __intrinsic_string_reserve(s: &mut String, extra: Int) -> Unit
extern def __intrinsic_string_find(s: &String, sub: &str) -> Option[Int]
# P0-STRING (the owned slice): string_slice computes the substring and
# allocates an OWNED String object (header + buffer) — the result is the
# String-object handle, never a raw byte buffer. The lowering delegates to
# the _tg_string_slice runtime helper on both arches.
extern def __intrinsic_string_slice(s: &String, start: Int, end_idx: Int) -> String
extern def __intrinsic_string_parse_int(s: &String) -> Result[Int, String]
extern def __intrinsic_string_replace(s: &String, from: &str, to: &str) -> String
# P0-STRING (the String-object transformation surface): trim/trim_matches
# return the OWNED object with the trimmed span; to_lowercase/to_uppercase
# return the OWNED object with the ASCII-mapped bytes; split/lines return
# Vec[String] of OWNED String objects. Each lowering delegates to the
# _tg_string_* runtime helper on both arches (the String ABI — never the
# Array ABI).
extern def __intrinsic_string_trim(s: &String) -> String
extern def __intrinsic_string_trim_matches(s: &String, ch: &str) -> String
extern def __intrinsic_string_to_lowercase(s: &String) -> String
extern def __intrinsic_string_to_uppercase(s: &String) -> String
extern def __intrinsic_string_split(s: &String, sep: &str) -> Vec[String]
extern def __intrinsic_string_lines(s: &String) -> Vec[String]
