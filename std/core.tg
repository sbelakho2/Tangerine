# Tangerine Standard Library — std::core
# Primitives, Option, Result, fundamental traits, prelude

enum Option[T]
  Some(T)
  None
end

enum Result[T, E]
  Ok(T)
  Err(E)
end

trait Copy
end

trait Drop
  def drop(self: &mut Self) -> Unit
end

trait Clone
  def clone(self: &Self) -> Self
end

trait Eq
  def eq(self, other: &Self) -> Bool
end

trait Ord
  def cmp(self, other: &Self) -> Int
end

trait Hash
  def hash(self) -> Int
end

trait Default
  def default() -> Self
end

trait Into[T]
  def into(self) -> T
end

trait From[T]
  def from(x: T) -> Self
end

def panic(msg: String) -> Unit
  # Compiler intrinsic: abort with message
  panic(msg)
end

def assert(cond: Bool, msg: String) -> Unit
  if !cond
    panic(msg)
  end
end

def unreachable(msg: String) -> Unit
  panic(msg)
end

def min(a: Int, b: Int) -> Int
  if a < b
    a
  else
    b
  end
end

def max(a: Int, b: Int) -> Int
  if a > b
    a
  else
    b
  end
end

def abs(x: Int) -> Int
  if x < 0
    0 - x
  else
    x
  end
end
