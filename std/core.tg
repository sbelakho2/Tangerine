extern def __intrinsic_string_as_ptr(s: &String) -> Ptr[u8]
extern def __intrinsic_string_parse_float(s: &String) -> Option[Float]

extern def __intrinsic_str_len(s: &str) -> Int
extern def __intrinsic_str_to_string(s: &str) -> String
extern def __intrinsic_str_find(s: &str, sub: &str) -> Option[Int]
extern def __intrinsic_str_slice(s: &str, start: Int, end_idx: Int) -> String
extern def __intrinsic_str_parse_int(s: &str) -> Result[Int, String]

extern def __intrinsic_float_to_bits(f: &Float) -> u64
