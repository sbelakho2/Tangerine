# Tangerine Standard Library — std::core
# Primitives, Option, Result, fundamental traits, prelude

enum Option[T]
  Some(T)
  None
end

enum Result[T, E]
  Ok(T)
  Err(E)
end

# ———————————————————————————————————————————————————————————————
# Ownership marker families
#
# FINAL MODEL (one distinction):
#   - Copy      = the semantic guarantee that raw value duplication is valid
#                 (the compiler's is_trivially_copyable structural property;
#                 the primitives only — String is NOT Copy)
#   - Clone     = the explicit duplication operation; may allocate/retain
#   - Move      = ownership transfer (the default for non-Copy values)
#   - Drop      = destruction (the trait method and the standalone sink drop)
#   - Transferable / Shareable = Send / Sync concurrency properties
#
# The Copyable trait is REMOVED: the compiler's trivially-copyable structural
# property IS the Copy guarantee. The Copy trait is the source-level marker
# used by generic bounds on the raw-read APIs (get/slice/entries in
# std::collections). Clone is an explicit operation with a REQUIRED body —
# there is no default (not every Clone type is Copy).
# ———————————————————————————————————————————————————————————————

trait Copy
end

trait Drop
  def drop(self: &mut Self) -> Unit
end

# Standalone drop function: the sink consumes the value (destruction)
def drop[T](sink x: T) -> Unit
end

trait Clone
  def clone(self: &Self) -> Self
end

trait Transferable
end

trait Shareable
end

# ———————————————————————————————————————————————————————————————
# Raw-pointer thread-safety GATE (P1, DECIDED)
# ———————————————————————————————————————————————————————————————
# A raw pointer is a plain bit pattern, but bit-copyability says NOTHING
# about whether the ADDRESS remains meaningful and race-safe on another
# thread: the pointee may live in the creating thread's stack, in a buffer
# that is freed or mutated concurrently, or in a region with a different
# lifetime on the target thread. `T: Transferable` guarantees the VALUE can
# move between threads — it does not guarantee that an arbitrary address
# into T's storage stays valid or race-free there.
#
# Therefore Ptr[T] / PtrMut[T] are NOT automatically Transferable or
# Shareable. Pointer thread-safety is OPT-IN and UNSAFE: implement the
# gate marker for the POINTEE type to assert (under the documented safety
# contract of the code that produced the pointer) that a Ptr[T] may be
# transferred to (UnsafeTransferable) or shared across (UnsafeShareable)
# another thread. Without an explicit gate impl the obligation solver
# rejects the pointer — the conservative, safe default.
trait UnsafeTransferable
end

trait UnsafeShareable
end

# ———————————————————————————————————————————————————————————————
# Concurrency property traits (Transferable = Send, Shareable = Sync)
#
# SINGLE RULE (P1, DECIDED — auto traits, ONE authority): Transferable and
# Shareable are AUTO TRAITS whose STRUCTURAL DERIVATION IS the canonical
# solver rule. "T: Transferable" holds iff the structural derivation
# proves it — the type's fields/variants/contents are all Transferable —
# and the obligation solver IS the derivation: the bounded impls below
# (primitives, containers, the gated raw-pointer impls) materialize the
# structural rule through the impl registry. There is NO second, unrelated
# fallback algorithm: when the registry cannot decide a type, the SAME
# structural rule is applied (types.tg derives it directly), never a
# different authority, so the two paths cannot disagree by construction.
# The compiler's string-name exclusion sets (non_send_types /
# non_sync_types in tg_compiler/types.tg, e.g. "Rc" / "Cell") are a
# documentation mirror only — never read in the decision path.
# ———————————————————————————————————————————————————————————————

trait Eq
  def eq(self: &Self, other: &Self) -> Bool
end

enum Ordering
  Less
  Equal
  Greater
end

trait Ord
  def cmp(self: &Self, other: &Self) -> Ordering
end

trait Hash
  def hash(self: &Self) -> Int
end

trait Default
  def default() -> Self
end

trait Into[T]
  def into(self) -> T
end

trait From[T]
  def from(x: T) -> Self
end

# Common error trait — implemented by all std error types
trait Error
  def message(self: &Self) -> String
  def source(self: &Self) -> Option[Error]
    Option::None
  end
end

# Display trait for user-facing string conversion
trait Display
  def fmt(self: &Self) -> String
end

# Vec[T] is the compiler-registered heap vector (the Adt form of Array[T] —
# the growable dynamic array). The runtime value is one pointer to the
# 32-byte header { data@0, len@8, cap@16, stride@24 }: the `stride` field
# (element stride in bytes, computed from the CONCRETE element type at the
# creation site — 1/2/4/8 for immediate scalars, 8 for pointer-represented
# values, align_up(size,align) for fixed-array elements) is the runtime's
# element-addressing authority: every _tg_array_* helper computes element
# addresses as data + index*stride and releases cap*stride bytes. Fixed-size
# arrays are the distinct FixedArray[T, N] annotation ([T; N]); there is no
# Vec alias here.

# List[T] is an alias for Array[T] (used by various std modules).
type List[T] = Array[T]
