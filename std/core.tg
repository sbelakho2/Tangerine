extern def __intrinsic_syscall6(num: Int, arg1: Int, arg2: Int, arg3: Int, arg4: Int, arg5: Int, arg6: Int) -> Int

# Array and Map intrinsics (generic)
extern def __intrinsic_array_set[T](self: &mut Array[T], index: Int, sink value: T) -> Unit
