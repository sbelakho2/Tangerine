extern def __intrinsic_array_set[T](inout self: Array[T], index: Int, sink value: T) -> Unit
extern def __intrinsic_array_as_ptr[T](self: Array[T]) -> Ptr[T]
extern def __intrinsic_array_as_mut_ptr[T](inout self: Array[T]) -> PtrMut[T]

# ———————————————————————————————————————————————————————————————
# Display Implementations for Primitive Types
# ———————————————————————————————————————————————————————————————

impl Display for Int
  def fmt(self: Self) -> String
    __intrinsic_int_to_string(self)
  end
end

impl Display for Bool
  def fmt(self: Self) -> String
    if self then "true" else "false" end
  end
end

impl Display for Float
  def fmt(self: Self) -> String
    __intrinsic_float_to_string(self)
  end
end

impl Display for String
  def fmt(self: Self) -> String
    self.clone()
  end
end

# String — ownership contract: String is an OWNED,
# MUTABLE string object with semantic nonaliasing: moves transfer the
# buffer, clone() allocates a new one, and the value is never
# bitwise-copyable (String is Clone, NOT Copy). "Owned" is a
# semantic/ownership statement, NOT immutability: push()/push_str() grow
# the owned buffer in place on the owned value (inout receiver).
#
# RUNTIME REPRESENTATION (the String ABI): the String VALUE is ONE 8-byte
# pointer to a 32-byte String object header — the same shape as the Vec
# header (the engine's StringPtr VALUE width stays 8 — StringHandleLayout;
# the heap object behind the handle is the 32-byte OwnedStringObjectLayout
# that mutation needs):
#   { data: Ptr[u8] @ 0, len: Int @ 8, cap: Int @ 16, stride: Int @ 24 }
#   data   — pointer to the null-terminated UTF-8 byte buffer (the REAL
#            heap — _tg_mem_alloc, the malloc-style pair with
#            _tg_mem_free; NUL at data[len])
#   len    — byte length (excluding the NUL)
#   cap    — byte capacity (>= len, >= 8)
#   stride — 1 (u8 byte stride — the u8 mirror of the Vec machinery)
# Every owned String operation (new/push/push_str/reserve/len/as_ptr/
# as_str/clone/bytes/from_bytes) is a mutable-string-object operation on
# this header — the _tg_string_* runtime functions (tg_compiler/runtime.tg
# "String Object Runtime"), on BOTH arches. The String intrinsics dispatch
# to the String ABI, NEVER to the Array runtime.
#
# THE LITERAL / VIEW SPLIT (— the typed view): a string LITERAL
# expression is the STATIC STRVIEW — the interned static bytes behind a raw
# pointer (the codegen constant load). In MIR the literal CONSTANT carries
# the view type (Type::StaticStrPtr — the true type of the value it carries),
# NEVER the owned String type: a raw static data pointer must never be
# typed as an owned String-object handle. The conversion to an OWNED String
# is the explicit typed coercion: String::from_static (the literal path)
# and String::from_str_view (the shared-view path — the view pins a
# snapshot, so the copy is always valid) — and the compiler
# emits that coercion at EVERY place a String is promised, driven by the
# DESTINATION's field/parameter/slot type: the aggregate construction paths
# (struct/enum fields — Some("x"), S { name: "x" } — tuple elements ("x",
# 1), [String; N] elements, vec! elements), the by-value String parameters
# (the diagnostics: panic, assert, error messages; the format strings; the
# path strings), and the String destinations (let/var initializers). The
# `str` type (the registered escape spelling of String) denotes the
# BORROWED view: &str parameters receive the raw static/borrowed bytes
# without conversion.
#
# RELEASE (— REAL String lifetime): every owned String has real
# allocation/deallocation semantics. The String OBJECT and its data BUFFER
# are allocated from the real heap (_tg_mem_alloc — the malloc-style pair
# with _tg_mem_free, the same allocator the Vec data buffers use), growth
# releases the old buffer at the growth boundary (_tg_string_reserve), and
# the compiler's drop glue destroys the value at its semantic lifetime
# boundary: the MIR's deinit plan for String is the String destructor
# (DeinitPlan::String — requires_drop_glue=true on the engine's
# drop-glue axis), emitted as _tg_string_drop, which frees the buffer AND
# the object. Short-lived strings, clones, and temporary concatenations
# are reclaimed when their value dies — no unbounded arena growth for
# long-running apps. There is no `impl Drop for String` in the std: the
# destructor is compiler-owned (the String drop), so source-level
# `drop(s)` on a String value still routes through the same glue.
# The argv/environment strings handed to the program by the OS are
# BORROWED (never freed, never mutated) and are exposed through the
# SHARED StrView (the views PIN their process-lifetime blocks into the
# pinned backing — see std::env / std::args);
# String::from_cstr / String::from_str_view / String::from_static produce
# the OWNED String (an owning copy) when an owned value is required.
# ———————————————————————————————————————————————————————————————
# StrView — ownership contract (DECIDED — the shared/pinned backing, the
# safe-view model; ONE REPRESENTATION, ONE SEMANTIC AUTHORITY: the
# SOURCE-spelled StrView IS the shared/pinned form — the StrView twin of
# the source-spelled Slice[T]; the raw {ptr,len} byte view is
# unsafe/FFI-only — the explicit UnsafeSlice builtin / FfiSlice)
# ———————————————————————————————————————————————————————————————
# StrView is the SAFE SHARED/PINNED UTF-8 view — the StrView twin of the
# safe Slice:
#     StrViewBacking = { ptr: Ptr[u8], len: UInt, offset: UInt }
#                      — the PINNED BYTE BACKING: the pinned byte buffer
#                        (ptr) plus the view window's offset/len. The
#                        backing owns a pinned allocation holding the
#                        window's bytes, so the backing ITSELF keeps the
#                        underlying storage alive.
#     StrView        = { inner: Arc[StrViewBacking] } — the Arc-class
#                      handle: one pointer-sized Arc to the pinned byte
#                      backing (the 8-byte layout: { inner: Arc @ 0 }).
#
# The view SURVIVES its source's drop (the Arc keeps the pinned backing
# alive), and the source's mutations never move it (the backing is the
# separate pinned allocation). The backing's deinit releases the pinned
# bytes when the last Arc dies. StrView is an ordinary OWNING value: it
# can be returned, stored (Vec[StrView], struct fields), and captured —
# no escape tracking, no access-scoping, no lifetime inference.
#
# Construction pins a SNAPSHOT of the window: String::as_str_view pins the
# owned String's bytes; the OS argv/environment views (std::env /
# std::args) pin their process-lifetime blocks through str_view_pin.
# String::from_str_view CLONES the pinned bytes into an owned String.
# The raw byte view (UnsafeSlice[u8] / FfiSlice — the 16-byte {ptr,len}
# borrowed form — the explicit unsafe/FFI spelling) is the ONLY place the
# raw form exists: safe code cannot produce it.
struct StrViewBacking
  ptr: Ptr[u8]
  len: UInt
  offset: UInt
end

struct StrView
  inner: ArcStrong[StrViewBacking]
end

# Pin the window [offset, offset + len) of the byte buffer at `ptr` into a
# FRESH pinned allocation (the pin copies the window — the pinned record
# is self-contained, so the view can never dangle). The backing's ptr IS
# the window's start (byte i of the view lives at backing.ptr + i); the
# offset records the window's start within the SOURCE buffer at pin time —
# metadata for the sub-view chaining.
def str_view_pin(ptr: Ptr[u8], len: UInt, offset: UInt) -> StrView
  var buf: Ptr[u8] = Ptr::null()
  if len > 0 then
    buf = alloc_array[u8](len)
    ptr_copy(ptr, buf, len)
  end
  let inner = alloc[ArcInnerWeak[StrViewBacking]]()
  if inner.is_null() then
    panic("str_view_pin: out of memory")
  end
  inner.write(ArcInnerWeak {
    refcount: 1,
    weak_count: 0,
    data: StrViewBacking { ptr: buf, len: len, offset: offset }
  })
  StrView { inner: ArcStrong { ptr: inner } }
end

impl StrViewBacking
  # The backing owns the pinned bytes: when the LAST view's Arc drops, the
  # deinit releases the pinned allocation (the compiler's single
  # destruction protocol — the Arc's drop_in_place runs this hook first).
  def deinit(sink self: Self) -> Unit
    if !self.ptr.is_null() then
      dealloc_array[u8](self.ptr, self.len)
    end
  end
end

impl StrView
  def len(self: Self) -> UInt
    self.inner.ptr.as_mut().data.len
  end

  def is_empty(self: Self) -> Bool
    self.len() == 0
  end

  # The pinned bytes of the view (read-only): valid for as long as this
  # view lives — the Arc keeps the pinned backing alive (the String::as_ptr
  # contract, extended to the shared view).
  def ptr(self: Self) -> Ptr[u8]
    self.inner.ptr.as_mut().data.ptr
  end

  def offset(self: Self) -> UInt
    self.inner.ptr.as_mut().data.offset
  end

  # The sub-view [start, start + len): a fresh pinned backing holds the
  # sub-window (the pin copies from the parent's pinned bytes at `start`;
  # the sub-view is self-contained). The recorded offset is the
  # sub-window's start within the ORIGINAL source buffer (the metadata
  # chaining rule — element reads always use backing.ptr directly).
  def sub(self: Self, start: Int, len: UInt) -> StrView
    let b = self.inner.ptr.as_mut().data
    str_view_pin((b.ptr as Int + start) as Ptr[u8], len, (b.offset as Int + start) as UInt)
  end
end
# ———————————————————————————————————————————————————————————————
# Concurrency properties — NO user-implementable marker impls
# (concurrency properties): Transferable/Shareable are COMPILER-DERIVED from
# the type properties (the transferable walk / the shareable walk in
# tg_compiler/types.tg — the single authority). The impls that the
# intermediate wave kept here (primitives, containers, the gated pointer
# impls) are DELETED: the derivation answers the obligations directly and
# a leftover impl is never consulted. The ONLY opt-in surface is the
# UnsafeTransferable/UnsafeShareable gate above — for raw pointers and
# for the execution-context-affine native handles.
# ———————————————————————————————————————————————————————————————
# String owns a unique buffer: moving the value moves the buffer — the
# owned type is Transferable (the derivation's Type::String arm), NOT
# Shareable (shared mutable state must go through Arc/Mutex/RwLock/
# atomics/channels).

impl String
  def as_str(self: Self) -> str
    __intrinsic_string_as_str(self)
  end

  def len(self: Self) -> Int
    __intrinsic_string_len(self)
  end

  def is_empty(self: Self) -> Bool
    self.len() == 0
  end

  # Buffer growth on the OWNED value: the inout receiver is the owned
  # String; the character is appended to its buffer (mutating the owned
  # value — String is owned, not immutable).
  def push(inout self: Self, ch: Char) -> Unit
    __intrinsic_string_push(self, ch)
  end

  # Buffer growth on the OWNED value: appends the view's bytes to the
  # owned String's buffer (the view is borrowed read-only for the call).
  def push_str(inout self: Self, s: str) -> Unit
    __intrinsic_string_push_str(self, s)
  end

  def split(self: Self, sep: str) -> Vec[String]
    # The owned String-object split: _tg_string_split slices each segment
    # into an OWNED String object and pushes the handles through the
    # collection ABI (an empty separator splits into single characters).
    __intrinsic_string_split(self, sep)
  end

  def find(self: Self, sub: str) -> Option[Int]
    __intrinsic_string_find(self, sub)
  end

  # Extract a substring as a NEW OWNED String object (the owned String ABI:
  # the _tg_string_slice runtime helper allocates the object header + the
  # copied bytes and returns the object handle — never a raw buffer).
  def slice(self: Self, start: Int, end_idx: Int) -> String
    __intrinsic_string_slice(self, start, end_idx)
  end

  def parse_int(self: Self) -> Result[Int, String]
    __intrinsic_string_parse_int(self)
  end

  def replace(self: Self, from: str, to: str) -> String
    __intrinsic_string_replace(self, from, to)
  end

  def contains(self: Self, sub: str) -> Bool
    self.find(sub).is_some()
  end

  def starts_with(self: Self, prefix: str) -> Bool
    if self.len() < prefix.len() then
      false
    else
      self.slice(0, prefix.len()) == prefix.to_string()
    end
  end

  def ends_with(self: Self, suffix: str) -> Bool
    if self.len() < suffix.len() then
      false
    else
      self.slice(self.len() - suffix.len(), self.len()) == suffix.to_string()
    end
  end

  def lines(self: Self) -> Vec[String]
    __intrinsic_string_lines(self)
  end

  def trim(self: Self) -> String
    # The owned String-object trim: _tg_string_trim scans the whitespace
    # span (space/tab/CR/LF) and returns the OWNED object for the trimmed
    # span.
    __intrinsic_string_trim(self)
  end

  def trim_matches(self: Self, ch: str) -> String
    # The owned String-object trim_matches: _tg_string_trim_matches trims
    # the pattern bytes from both ends and returns the OWNED object for
    # the trimmed span (an empty pattern trims nothing).
    __intrinsic_string_trim_matches(self, ch)
  end

  def split_once(self: Self, sep: str) -> Option[(String, String)]
    match self.find(sep)
    when Option::Some(idx) then
      Option::Some((self.slice(0, idx), self.slice(idx + sep.len(), self.len())))
    when Option::None then
      Option::None
    end
  end

  def rfind(self: Self, sub: str) -> Option[Int]
    let sub_len = sub.len()
    if sub_len == 0 then
      return Option::Some(self.len())
    end
    if sub_len > self.len() then
      return Option::None
    end
    var i = self.len() - sub_len
    loop
      if self.slice(i, i + sub_len) == sub.to_string() then
        return Option::Some(i)
      end
      if i == 0 then break end
      i = i - 1
    end
    Option::None
  end

  def as_bytes(self: Self) -> Vec[u8]
    __intrinsic_string_as_bytes(self)
  end

  def as_ptr(self: Self) -> Ptr[u8]
    __intrinsic_string_as_ptr(self)
  end

  # The SHARED/PINNED view of the owned bytes: pins a snapshot of the
  # buffer into the pinned backing. The returned StrView SURVIVES this
  # String's drop and its growth — the Arc keeps the pinned backing alive.
  def as_str_view(self: Self) -> StrView
    str_view_pin(self.as_ptr(), self.len() as UInt, 0)
  end
end

impl str
  def len(self: Self) -> Int
    __intrinsic_str_len(self)
  end

  def to_string(self: Self) -> String
    __intrinsic_str_to_string(self)
  end

  def split(self: Self, sep: str) -> Vec[String]
    self.to_string().split(sep)
  end

  def find(self: Self, sub: str) -> Option[Int]
    __intrinsic_str_find(self, sub)
  end

  # Extract a substring of the BORROWED view as a NEW OWNED String object
  # (the owned String ABI — the _tg_string_slice runtime helper returns the
  # object handle, never a raw buffer).
  def slice(self: Self, start: Int, end_idx: Int) -> String
    __intrinsic_str_slice(self, start, end_idx)
  end

  def parse_int(self: Self) -> Result[Int, String]
    __intrinsic_str_parse_int(self)
  end

  def contains(self: Self, sub: str) -> Bool
    self.find(sub).is_some()
  end

  def starts_with(self: Self, prefix: str) -> Bool
    if self.len() < prefix.len() then
      false
    else
      self.slice(0, prefix.len()) == prefix.to_string()
    end
  end

  def ends_with(self: Self, suffix: str) -> Bool
    if self.len() < suffix.len() then
      false
    else
      self.slice(self.len() - suffix.len(), self.len()) == suffix.to_string()
    end
  end
end

# EXPERIMENTAL (unstable): catch an unwinding panic. Under the stable
# abort-only strategy a panicking closure aborts the process, so this can
# never observe a panic; it exists only for the experimental unwind
# machinery.
def catch_panic[T](f: fn() -> T) -> Option[String]
  match catch_unwind(f)
  when Result::Ok(_) then Option::None
  when Result::Err(msg) then Option::Some(msg)
  end
end

# Provides `.to_string()` for any type implementing Display.
def to_string[T: Display](val: T) -> String
  val.fmt()
end

def panic(msg: String) -> Never
  let info = PanicInfo {
    message: msg.clone(),
    file: "<unknown>",
    line: 0,
    column: 0
  }
  # STATE A (the stable panic strategy — ABORT-ONLY): the process
  # terminates immediately after the panic hook runs. No unwinding, no
  # catch, no resumption exists on the stable path — a panicking program
  # ends. The resource-safety statement follows directly: with abort, the
  # process ends, so there is NO partial destruction to reason about — the
  # cleanup contract is "the process terminates; whatever the OS reclaims
  # is reclaimed by the OS". The compiler rejects any request for a stable
  # panic=unwind strategy (see the driver's --panic-strategy validation),
  # and the unwind/catch APIs below are EXPERIMENTAL (unstable) surfaces
  # that must not be relied on for cleanup claims.
  match _panic_hook
  when Option::Some(hook) then hook(info.clone())
  when Option::None then default_panic_hook(info.clone())
  end
  __intrinsic_abort()
end

# ———————————————————————————————————————————————————————————————
# Panic / Unwind Infrastructure (EXPERIMENTAL — not part of the stable std)
# ———————————————————————————————————————————————————————————————
#
# STATE A (abort-only) is the ONLY stable panic strategy: `panic` aborts
# the process after the hook runs. The machinery below (catch_unwind,
# catch_panic, resume_unwind, try_invoke, panic_unwind, begin_unwind) is
# EXPERIMENTAL/UNSTABLE: it is kept for API compatibility (std::bench and
# std::web_ext use it), it is not part of the stable std contract, and it
# makes NO cleanup claims. Under the stable abort-only strategy a panicking
# closure terminates the process — catch_unwind can never observe a panic.
#
# NOTE (ownership): the unwind path does NOT carry semantic cleanup
# edges — generated MirDeinit chains run only on normal control flow. A
# panic that unwinds through a frame skips resource finalizers. Until the
# unwind cleanup edge is implemented, the unwind machinery must not be used
# for programs with live owned resources (the stable strategy is abort).

struct PanicInfo
  message: String
  file: String
  line: Int
  column: Int
end

impl Clone for PanicInfo
  def clone(self: Self) -> PanicInfo
    PanicInfo {
      message: self.message.clone(),
      file: self.file.clone(),
      line: self.line,
      column: self.column
    }
  end
end

# Type-erased payload carried during an unwind
enum PanicPayload
  Message(String)
  Value(Box[Any])
end

# Thread-local panic hook.
@thread_local
static mut _panic_hook: Option[fn(PanicInfo) -> Unit] = Option::None

# [METADATA]
# module: tg::core
# status: alpha
# effects: []
# capabilities: []

def set_panic_hook(hook: fn(PanicInfo) -> Unit) -> Unit
  _panic_hook = Option::Some(hook)
end

def take_panic_hook() -> Option[fn(PanicInfo) -> Unit]
  let hook = _panic_hook.clone()
  _panic_hook = Option::None
  hook
end

def default_panic_hook(info: PanicInfo) -> Unit
  eprintln("thread panicked at '" + info.message.clone() + "', "
           + info.file.clone() + ":" + info.line.to_string()
           + ":" + info.column.to_string())
end

struct CatchFrame
  id: Int
  active: Bool
end

@thread_local
static mut _catch_frame_stack: Vec[CatchFrame] = Vec::new()
@thread_local
static mut _current_panic: Option[PanicPayload] = Option::None

# EXPERIMENTAL (unstable): invoke a closure, catching any panic under the
# experimental unwind machinery. Returns Result::Ok(value) on success,
# Result::Err(payload_msg) on panic. Under the stable abort-only strategy
# a panicking closure aborts the process — this can never return Err.
def catch_unwind[T](f: fn() -> T) -> Result[T, String]
  let frame_id = _catch_frame_stack.len()
  _catch_frame_stack.push(CatchFrame { id: frame_id, active: true })

  let result = try_invoke(f)

  if !_catch_frame_stack.is_empty() then
    let top = _catch_frame_stack[_catch_frame_stack.len() - 1]
    if top.id == frame_id then
      _catch_frame_stack.pop()
    else
      panic("catch_unwind: frame ID mismatch on pop (expected " + frame_id.to_string() + ", got " + top.id.to_string() + ")")
    end
  end

  match result
  when Option::Some(val) then Result::Ok(val)
  when Option::None then
    let msg = match _current_panic
    when Option::Some(PanicPayload::Message(m)) then m.clone()
    when Option::Some(PanicPayload::Value(_)) then "<boxed panic>".to_string()
    when Option::None then "<unknown panic>".to_string()
    end
    _current_panic = Option::None
    Result::Err(msg)
  end
end

extern def __intrinsic_try_invoke[T](f: fn() -> T) -> Option[T]

def try_invoke[T](f: fn() -> T) -> Option[T]
  __intrinsic_try_invoke(f)
end

# Begin an unwind from a panic.
def begin_unwind(payload: PanicPayload) -> Unit
  _current_panic = Option::Some(payload)

  if !_catch_frame_stack.is_empty() then
    let frame = _catch_frame_stack[_catch_frame_stack.len() - 1]
    if frame.active then
      __intrinsic_longjmp(frame.id)
    end
  end

  __intrinsic_abort()
end

# EXPERIMENTAL (unstable): the unwind-strategy panic entry (the stable
# `panic` no longer calls this — under STATE A it aborts directly). This
# remains only for the experimental unwind machinery.
def panic_unwind(info: PanicInfo) -> Unit
  # Invoke the panic hook
  match _panic_hook
  when Option::Some(hook) then hook(info.clone())
  when Option::None then default_panic_hook(info.clone())
  end

  begin_unwind(PanicPayload::Message(info.message.clone()))
end

extern def __intrinsic_longjmp(frame_id: Int) -> Unit
extern def __intrinsic_abort() -> Unit

# EXPERIMENTAL (unstable): re-panic with a payload (useful after
# catch_unwind under the experimental unwind machinery). Not part of the
# stable std; under the stable abort-only strategy this aborts the process.
def resume_unwind(msg: String) -> Unit
  begin_unwind(PanicPayload::Message(msg))
end

# ———————————————————————————————————————————————————————————————

def assert(cond: Bool, msg: String) -> Unit
  if !cond
    panic(msg)
  end
end

def unreachable(msg: String) -> Unit
  panic(msg)
end

def min(a: Int, b: Int) -> Int
  if a < b
    a
  else
    b
  end
end

def max(a: Int, b: Int) -> Int
  if a > b
    a
  else
    b
  end
end

def abs(x: Int) -> Int
  if x < 0
    0 - x
  else
    x
  end
end

# ———————————————————————————————————————————————————————————————
# Option[T] methods
# ———————————————————————————————————————————————————————————————

impl[T] Option[T]
  # Consuming operations take `sink self`: they TRANSFER or destroy the
  # payload, so a resource inside the Option moves exactly once (a `let
  # self` (read) unwrap would duplicate ownership of a resource payload).
  def unwrap(sink self: Self) -> T
    match self
    when Option::Some(v) then v
    when Option::None then panic("called Option::unwrap() on a None value")
    end
  end

  def unwrap_or(sink self: Self, default: T) -> T
    match self
    when Option::Some(v) then v
    when Option::None then default
    end
  end

  def map[U](sink self: Self, f: fn(T) -> U) -> Option[U]
    match self
    when Option::Some(v) then Option::Some(f(v))
    when Option::None then Option::None
    end
  end

  def and_then[U](sink self: Self, f: fn(T) -> Option[U]) -> Option[U]
    match self
    when Option::Some(v) then f(v)
    when Option::None then Option::None
    end
  end

  def is_some(self: Self) -> Bool
    match self
    when Option::Some(_) then true
    when Option::None then false
    end
  end

  def is_none(self: Self) -> Bool
    match self
    when Option::Some(_) then false
    when Option::None then true
    end
  end

  def take(inout self: Option[T]) -> Option[T]
    let old = match self
    when Option::Some(v) then Option::Some(v)
    when Option::None then Option::None
    end
    self = Option::None
    old
  end
end

# ———————————————————————————————————————————————————————————————
# Result[T, E] methods
# ———————————————————————————————————————————————————————————————

impl[T, E] Result[T, E]
  # Consuming extraction: moves the payload out of the Result — must be sink
  # self (a plain `self` read would duplicate a resource payload exactly like
  # the old Option::unwrap hole).
  def unwrap(sink self: Self) -> T
    match self
    when Result::Ok(v) then v
    when Result::Err(_) then panic("called Result::unwrap() on an Err value")
    end
  end

  def unwrap_or(sink self: Self, default: T) -> T
    match self
    when Result::Ok(v) then v
    when Result::Err(_) then default
    end
  end

  def map[U](sink self: Self, f: fn(T) -> U) -> Result[U, E]
    match self
    when Result::Ok(v) then Result::Ok(f(v))
    when Result::Err(e) then Result::Err(e)
    end
  end

  def and_then[U](sink self: Self, f: fn(T) -> Result[U, E]) -> Result[U, E]
    match self
    when Result::Ok(v) then f(v)
    when Result::Err(e) then Result::Err(e)
    end
  end

  def is_ok(self: Self) -> Bool
    match self
    when Result::Ok(_) then true
    when Result::Err(_) then false
    end
  end

  def is_err(self: Self) -> Bool
    match self
    when Result::Ok(_) then false
    when Result::Err(_) then true
    end
  end

  def map_err[F](sink self: Self, f: fn(E) -> F) -> Result[T, F]
    match self
    when Result::Ok(v) then Result::Ok(v)
    when Result::Err(e) then Result::Err(f(e))
    end
  end

  def unwrap_err(sink self: Self) -> E
    match self
    when Result::Ok(_) then panic("called Result::unwrap_err() on an Ok value")
    when Result::Err(e) then e
    end
  end

  def or_else[F](sink self: Self, f: fn(E) -> Result[T, F]) -> Result[T, F]
    match self
    when Result::Ok(v) then Result::Ok(v)
    when Result::Err(e) then f(e)
    end
  end

  ## Attach a context message to the error (wraps in ContextError). The
  ## Result and the message are consumed (sink) — the same ownership rule
  ## as unwrap/map: a let-self read would duplicate a resource payload.
  def context(sink self: Self, sink msg: String) -> Result[T, ContextError]
    match self
    when Result::Ok(v) then Result::Ok(v)
    when Result::Err(e) then
      Result::Err(ContextError {
        message: msg,
        source: Option::Some(Box::new(e.to_string())),
      })
    end
  end

  ## Attach lazy context (only evaluated on error). The Result and the
  ## closure are consumed (sink).
  def with_context(sink self: Self, sink f: fn() -> String) -> Result[T, ContextError]
    match self
    when Result::Ok(v) then Result::Ok(v)
    when Result::Err(e) then
      Result::Err(ContextError {
        message: f(),
        source: Option::Some(Box::new(e.to_string())),
      })
    end
  end
end

# ———————————————————————————————————————————————————————————————
# ContextError — chained error with context messages
# ———————————————————————————————————————————————————————————————

struct ContextError
  message: String
  source: Option[Box[String]]
end

impl Error for ContextError
  def message(self: Self) -> String
    match self.source
    when Option::Some(src) then
      self.message.clone() + ": " + src.as_ref().clone()
    when Option::None then self.message.clone()
    end
  end

  def source(self: Self) -> Option[Error]
    Option::None  # Chain is flattened into message
  end
end

impl Display for ContextError
  def fmt(self: Self) -> String
    self.message()
  end
end

impl Clone for ContextError
  def clone(self: Self) -> ContextError
    ContextError {
      message: self.message.clone(),
      source: self.source.clone(),
    }
  end
end

# ———————————————————————————————————————————————————————————————
# String: the Clone/Eq/Hash trait impls — String is Clone (never Copy),
# equality is content equality, and the hash feeds the Map/Set key
# dispatch (_tg_hash_str). These make the `[T: Clone]` / `[T: Eq]` /
# `[T: Hash]` bounds satisfiable for String (the intrinsic classification
# resolves the bodies).
# ———————————————————————————————————————————————————————————————
impl Clone for String
  def clone(self: Self) -> String
    string_clone(self)
  end
end

impl Eq for String
  def eq(self: Self, other: Self) -> Bool
    self == other
  end
end

# the primitive integer Eq instances (the kernel's generic `contains`/
# `Vec[Int]::contains` where-clause obligations — the compiler knows
# these, so the kernel declares them like the other primitives)
impl Eq for Int
  def eq(self: Self, other: Self) -> Bool
    self == other
  end
end

impl Eq for UInt
  def eq(self: Self, other: Self) -> Bool
    self == other
  end
end









impl Eq for Bool
  def eq(self: Self, other: Self) -> Bool
    self == other
  end
end

impl Eq for Char
  def eq(self: Self, other: Self) -> Bool
    self == other
  end
end

impl Hash for String
  def hash(self: Self) -> Int
    string_hash(self)
  end
end

# ———————————————————————————————————————————————————————————————
# Stable error codes for categorized errors
# ———————————————————————————————————————————————————————————————

enum ErrorKind
  NotFound        ## E0001
  PermissionDenied ## E0002
  InvalidInput    ## E0003
  InvalidData     ## E0004
  TimedOut        ## E0005
  ConnectionRefused ## E0006
  ConnectionReset ## E0007
  AlreadyExists   ## E0008
  WouldBlock      ## E0009
  Interrupted     ## E0010
  OutOfMemory     ## E0011
  Unsupported     ## E0012
  Other           ## E9999
end

impl ErrorKind
  def code(self: Self) -> String
    match self
    when NotFound then "E0001"
    when PermissionDenied then "E0002"
    when InvalidInput then "E0003"
    when InvalidData then "E0004"
    when TimedOut then "E0005"
    when ConnectionRefused then "E0006"
    when ConnectionReset then "E0007"
    when AlreadyExists then "E0008"
    when WouldBlock then "E0009"
    when Interrupted then "E0010"
    when OutOfMemory then "E0011"
    when Unsupported then "E0012"
    when Other then "E9999"
    end
  end

  def description(self: Self) -> String
    match self
    when NotFound then "entity not found"
    when PermissionDenied then "permission denied"
    when InvalidInput then "invalid input parameter"
    when InvalidData then "invalid data"
    when TimedOut then "operation timed out"
    when ConnectionRefused then "connection refused"
    when ConnectionReset then "connection reset"
    when AlreadyExists then "entity already exists"
    when WouldBlock then "operation would block"
    when Interrupted then "operation interrupted"
    when OutOfMemory then "out of memory"
    when Unsupported then "operation not supported"
    when Other then "other error"
    end
  end
end

impl Display for ErrorKind
  def fmt(self: Self) -> String
    self.code() + ": " + self.description()
  end
end

# --- Additional String methods (separate impl block to avoid error cascading) ---
impl String
  def to_lowercase(self: Self) -> String
    # The owned String-object case mapping: _tg_string_tolower maps the
    # ASCII uppercase bytes and returns the OWNED object with the mapped
    # bytes (non-ASCII bytes pass through unchanged).
    __intrinsic_string_to_lowercase(self)
  end

  def to_uppercase(self: Self) -> String
    # The owned String-object case mapping: _tg_string_toupper maps the
    # ASCII lowercase bytes and returns the OWNED object with the mapped
    # bytes (non-ASCII bytes pass through unchanged).
    __intrinsic_string_to_uppercase(self)
  end

  def index_of(self: Self, sub: str) -> Int
    match self.find(sub)
    when Option::Some(idx) then idx
    when Option::None then -1
    end
  end

  def last_index_of(self: Self, sub: str) -> Int
    let sub_len = sub.len()
    if sub_len == 0 then
      return self.len()
    end
    var last = -1
    var i = 0
    while i + sub_len <= self.len() do
      if self.slice(i, i + sub_len) == sub.to_string() then
        last = i
      end
      i = i + 1
    end
    last
  end

  def bytes(self: Self) -> Vec[u8]
    # the RAW UTF-8 encoded bytes (deterministic — identical to
    # as_bytes).  The previous loop pushed `char_at(i) as Int` — the
    # Unicode code points — into a Vec declared to hold u8, so the
    # name/type/implementation did not agree (re-audit P0: String
    # bytes() semantics).  For compiler hashing the deterministic raw
    # encoded bytes are the correct meaning.
    self.as_bytes()
  end

  # Build a NEW OWNED String from a null-terminated C pointer (the same
  # ownership contract as every String constructor: the result owns its
  # buffer — moves transfer, clone allocates, push grows it). The pointer
  # must remain valid for the duration of the copy.
  def from_cstr(ptr: Ptr[u8]) -> String
    var result = String::new()
    var i = 0
    loop
      let byte = *(ptr.offset(i))
      if byte == 0 then break end
      result.push(byte as Char)
      i = i + 1
    end
    result
  end

  # Clone a StrView's PINNED bytes into a NEW OWNED String buffer (the
  # view is the shared/pinned form — its Arc keeps the pinned backing
  # alive; the result owns — same ownership contract as every String
  # constructor). The OS-argv/environment views (the CStringView path)
  # convert through here when an owning value is required; the pinned
  # backing guarantees the bytes stay valid for the duration of the copy.
  def from_str_view(self: StrView) -> String
    var result = String::new()
    var i = 0
    while (i as UInt) < self.len() do
      let byte = *(self.ptr().offset(i))
      result.push(byte as Char)
      i = i + 1
    end
    result
  end

  # Copy the bytes of a BORROWED str view (a string literal — the static
  # StrView — or any borrowed buffer) into a NEW OWNED String object.
  # This is the explicit literal → owned coercion; the compiler also emits
  # it automatically at every owned-String promise site (aggregate fields
  # whose destination type is the owned String, by-value String parameters,
  # String destinations).
  # The borrowed view must stay alive for the duration of the copy.
  def from_static(s: str) -> String
    __intrinsic_string_from_static(s)
  end

  # Convert an owned byte buffer into a String, validating UTF-8. The
  # buffer is consumed (sink — the owned Vec moves into the conversion);
  # Err carries a message on invalid input. (Call sites that need the
  # bytes regardless use String::from_bytes, the infallible intrinsic.)
  def from_utf8(sink data: Vec[u8]) -> Result[String, String]
    if is_valid_utf8(&data) then
      Result::Ok(String::from_bytes(data))
    else
      Result::Err("invalid UTF-8".to_string())
    end
  end

  # Lossy conversion: invalid byte sequences are replaced with U+FFFD
  # (the 3-byte UTF-8 encoding, pushed as raw bytes).
  def from_utf8_lossy(data: Vec[u8]) -> String
    var result = String::new()
    var i = 0
    while i < data.len() do
      let b = data[i]
      if b < 0x80 then
        result.push(b as Char)
        i = i + 1
      else
        let seq_len = utf8_seq_len(b)
        if seq_len > 0 && i + seq_len <= data.len() && utf8_seq_valid(data, i, seq_len) then
          var j = 0
          while j < seq_len do
            result.push(data[i + j] as Char)
            j = j + 1
          end
          i = i + seq_len
        else
          result.push(0xEF as Char)
          result.push(0xBF as Char)
          result.push(0xBD as Char)
          i = i + 1
        end
      end
    end
    result
  end

  # Copy a bounds-checked byte range into a String (empty string on
  # out-of-bounds input).
  def from_utf8_range(data: Vec[u8], start: Int, len: Int) -> String
    if start < 0 || len < 0 || start + len > data.len() then
      return String::new()
    end
    String::from_bytes(data.slice(start, start + len))
  end

  # Copy len raw bytes from a pointer into a NEW OWNED String (same
  # ownership contract as from_cstr). The caller vouches for the pointer
  # and the byte count.
  def from_utf8_unchecked(ptr: Ptr[u8], len: UInt) -> String
    var result = String::new()
    var i = 0
    while (i as UInt) < len do
      let byte = *(ptr.offset(i as Int))
      result.push(byte as Char)
      i = i + 1
    end
    result
  end
end

def utf8_seq_len(b: u8) -> Int
  if b >= 0xC2 && b <= 0xDF then 2
  elsif b >= 0xE0 && b <= 0xEF then 3
  elsif b >= 0xF0 && b <= 0xF4 then 4
  else 0
  end
end

def utf8_seq_valid(data: Vec[u8], i: Int, seq_len: Int) -> Bool
  var j = 1
  while j < seq_len do
    let c = data[i + j]
    if c < 0x80 || c > 0xBF then
      return false
    end
    j = j + 1
  end
  let b0 = data[i]
  if seq_len == 2 && b0 < 0xC2 then return false end
  if seq_len == 3 then
    if b0 == 0xE0 && data[i + 1] < 0xA0 then return false end
    if b0 == 0xED && data[i + 1] > 0x9F then return false end
  end
  if seq_len == 4 then
    if b0 == 0xF0 && data[i + 1] < 0x90 then return false end
    if b0 == 0xF4 && data[i + 1] > 0x8F then return false end
  end
  true
end

def is_valid_utf8(data: Vec[u8]) -> Bool
  var i = 0
  while i < data.len() do
    let b = data[i]
    if b < 0x80 then
      i = i + 1
    else
      let seq_len = utf8_seq_len(b)
      if seq_len == 0 || i + seq_len > data.len() then
        return false
      end
      if !utf8_seq_valid(data, i, seq_len) then
        return false
      end
      i = i + seq_len
    end
  end
  true
end

impl Float
  def to_bits(self: Self) -> u64
    __intrinsic_float_to_bits(self)
  end
end

def is_alphanumeric(c: Char) -> Bool
  let code = c as Int
  (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
end

def parse_float(s: String) -> Option[Float]
  __intrinsic_string_parse_float(s)
end
