# Tangerine Standard Library — std::web_server
# Web server framework layer with routing, middleware, and replayable transcripts.
# Spec reference: TG-WEB-SPEC-001 v0.1

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{Map}
use std::http::{HttpRequest, HttpResponse, HttpMethod, HttpStatus, HttpServer as RawHttpServer}
use std::gfx_errors::{Error, ErrorCode}

# [METADATA]
# module: tg::web_server
# status: alpha
# effects: [Net, Io]
# capabilities: [Net]
# error_codes: [RouteNotFound, MiddlewareError, TranscriptError, Internal]
# description: "High-level web framework with declarative routing and audit transcripts."
# examples:
#   - |
#     use std::web_server::{Router, HttpServer}
#     let mut router = Router::new()
#     router.get("/", |req| HttpResponse::ok("Hello World"))
#     let server = HttpServer::new(8080, router)
#     server.start()

# ———————————————————————————————————————————————————————————————
# Routing
# ———————————————————————————————————————————————————————————————

type Handler = fn(HttpRequest) -> HttpResponse

struct Router
  routes: Map[HttpMethod, Map[String, Handler]]
  middleware: Vec[Middleware]
end

impl Router
  def new() -> Self
    Router {
      routes: Map::new(),
      middleware: Vec::new(),
    }
  end

  def add_route(&mut self, method: HttpMethod, path: String, handler: Handler) -> Unit
    let method_routes = self.routes.entry(method).or_insert(Map::new())
    method_routes.insert(path, handler)
  end

  def get(&mut self, path: String, handler: Handler) -> Unit
    self.add_route(HttpMethod::Get, path, handler)
  end

  def post(&mut self, path: String, handler: Handler) -> Unit
    self.add_route(HttpMethod::Post, path, handler)
  end

  def use_middleware(&mut self, m: Middleware) -> Unit
    self.middleware.push(m)
  end

  def handle(&self, req: HttpRequest) -> HttpResponse
    # Apply middleware (simplified)
    # Match route
    let path = req.url.path()
    match self.routes.get(&req.method)
    when Option::Some(method_routes) then
      match method_routes.get(path)
      when Option::Some(handler) then
        (handler)(req)
      when Option::None then
        # Integration with ctxpacks: Capture 404 context
        let mut seeds = Vec::new()
        seeds.push("web_server::route_not_found".to_string())
        seeds.push("path::" + path.clone())
        match std::ctx::build_pack(seeds, 1500)
        when Ok(pack) then std::ctx::register_pack(pack)
        when Err(_) then {}
        end
        HttpResponse::new(HttpStatus::new(404))
      end
    when Option::None then
      HttpResponse::new(HttpStatus::new(404))
    end
  end
end

type Middleware = fn(HttpRequest, fn(HttpRequest) -> HttpResponse) -> HttpResponse

# ———————————————————————————————————————————————————————————————
# Replayable Transcripts
# ———————————————————————————————————————————————————————————————

struct ExchangeTranscript
  request: HttpRequest
  response: HttpResponse
  timestamp_ns: i64
  duration_ns: i64
end

struct TranscriptStore
  exchanges: Vec[ExchangeTranscript]
end

impl TranscriptStore
  def new() -> Self
    TranscriptStore { exchanges: Vec::new() }
  end

  def record(&mut self, transcript: ExchangeTranscript) -> Unit
    self.exchanges.push(transcript)
  end
end

# ———————————————————————————————————————————————————————————————
# High-level HttpServer
# ———————————————————————————————————————————————————————————————

struct HttpServer
  port: UInt
  router: Router
  transcripts: TranscriptStore
end

impl HttpServer
  def new(port: UInt, router: Router) -> Self
    HttpServer {
      port: port,
      router: router,
      transcripts: TranscriptStore::new(),
    }
  end

  def start(&self) -> Result[Unit, WebError]
    # In a real impl, this would wrap RawHttpServer and inject the router/transcript logic
    # Here we simulate the integration
    let raw_server = RawHttpServer::new(self.port, |req| self.router.handle(req))
    raw_server.listen().map_err(|e| WebError::Internal(Error::new(ErrorCode::Internal, e.message())))
  end
end

# ———————————————————————————————————————————————————————————————
# Error Types
# ———————————————————————————————————————————————————————————————

enum WebError
  RouteNotFound(Error)
  MiddlewareError(Error)
  TranscriptError(Error)
  Internal(Error)
end

impl WebError
  def message(self: &WebError) -> &String
    match self
    when WebError::RouteNotFound(e) then &e.message
    when WebError::MiddlewareError(e) then &e.message
    when WebError::TranscriptError(e) then &e.message
    when WebError::Internal(e) then &e.message
    end
  end
end
