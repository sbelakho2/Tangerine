# Tangerine Backend Plugin ABI — Stable C ABI Definitions
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 14.
#
# This module defines the complete ABI surface between the Tangerine
# host runtime and backend plugins. All types use repr(c) layout.
# Strings are TgStr (ptr + len), arrays are TgSlice (ptr + len).
# No Rust/Tangerine native ABI is used across plugin boundaries.

use std::core::{Option, Result, String, Bool, Int, Unit}

# ═══════════════════════════════════════════════════════════════
# §14.1 ABI principles (encoded as module-level documentation)
#
# 1. Do NOT use Rust/Tangerine native ABI for plugins.
# 2. Export C ABI symbols only.
# 3. All interface tables start with TgInterfaceHeader.
# 4. Discover interfaces via query_interface(name, major, minor).
# 5. Cross-boundary ownership: persistent buffers use host.alloc;
#    free with host.free unless negotiated otherwise.
# 6. Strings: TgStr (ptr + len). Arrays: TgSlice (ptr + len).
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# §14.2 ABI base types / constants
# ═══════════════════════════════════════════════════════════════

let TG_BACKEND_ABI_MAJOR: u32 = 1u32
let TG_BACKEND_ABI_MINOR: u32 = 0u32

struct TgStr
  ptr: u64       # *const u8 (pointer as u64 for ABI safety)
  len: u64       # usize
end

struct TgSlice
  ptr: u64       # *const u8
  len: u64       # usize (byte count)
end

struct TgError
  code: i32
  message: TgStr
end

struct TgResult
  ok: Bool
  err: TgError
end

struct TgHandle
  value: u64
end

struct TgInterfaceHeader
  abi_major: u32
  abi_minor: u32
  size_bytes: u32
end

# ═══════════════════════════════════════════════════════════════
# §14.3 Host services (TgHostV1)
# ═══════════════════════════════════════════════════════════════

struct TgHostV1
  alloc: u64       # extern "c" fn(size: usize, align: usize) -> *mut u8
  free: u64        # extern "c" fn(ptr: *mut u8, size: usize, align: usize) -> Unit
  log: u64         # extern "c" fn(level: i32, msg: TgStr) -> Unit
end

# ═══════════════════════════════════════════════════════════════
# §14.4 Required export symbols
# ═══════════════════════════════════════════════════════════════
#
# extern "c" fn tg_backend_manifest_v1(
#   host: *const TgHostV1,
#   out_json: *mut TgStr
# ) -> TgResult
#
# Returns a JSON manifest string allocated with host.alloc.
#
# extern "c" fn tg_backend_init_v1(
#   host: *const TgHostV1,
#   out_backend: *mut TgBackendRootV1
# ) -> TgResult

# ═══════════════════════════════════════════════════════════════
# §14.5 TgBackendRootV1
# ═══════════════════════════════════════════════════════════════

struct TgBackendRootV1
  hdr: TgInterfaceHeader
  query_interface: u64   # extern "c" fn(name: TgStr, want_major: u32, want_minor: u32, out_iface: *mut *const u8) -> TgResult
end

# ═══════════════════════════════════════════════════════════════
# §14.6 Interface name constants
# ═══════════════════════════════════════════════════════════════

let IFACE_APP_V1: String = "tg.app.v1"
let IFACE_GFX_V1: String = "tg.gfx.v1"
let IFACE_TEXT_V1: String = "tg.text.v1"
let IFACE_IMAGE_V1: String = "tg.image.v1"       # optional but recommended
let IFACE_GPU_V1: String = "tg.gpu.v1"            # optional Tier C
let IFACE_CLIP_V1: String = "tg.clipboard.v1"     # optional
let IFACE_IME_V1: String = "tg.ime.v1"            # optional
let IFACE_DND_V1: String = "tg.dragdrop.v1"       # optional

# ═══════════════════════════════════════════════════════════════
# §14.7 tg.app.v1 ABI
# ═══════════════════════════════════════════════════════════════

# Event tag numeric mapping (u32).
let TG_EVENT_KEY_DOWN: u32    = 1u32
let TG_EVENT_KEY_UP: u32      = 2u32
let TG_EVENT_TEXT_INPUT: u32   = 3u32
let TG_EVENT_IME_START: u32    = 4u32
let TG_EVENT_IME_UPDATE: u32   = 5u32
let TG_EVENT_IME_END: u32      = 6u32
let TG_EVENT_MOUSE_MOVE: u32   = 7u32
let TG_EVENT_MOUSE_DOWN: u32   = 8u32
let TG_EVENT_MOUSE_UP: u32     = 9u32
let TG_EVENT_SCROLL: u32       = 10u32
let TG_EVENT_RESIZE: u32       = 11u32
let TG_EVENT_FOCUS: u32        = 12u32
let TG_EVENT_CLOSE: u32        = 13u32
let TG_EVENT_REDRAW: u32       = 14u32
let TG_EVENT_DRAG_ENTER: u32   = 15u32
let TG_EVENT_DRAG_OVER: u32    = 16u32
let TG_EVENT_DRAG_DROP: u32    = 17u32
let TG_EVENT_DRAG_LEAVE: u32   = 18u32

struct TgEventV1
  tag: u32
  a: i32
  b: i32
  x: f32
  y: f32
  text: TgStr
end

struct TgAppV1
  hdr: TgInterfaceHeader
  app_create: u64         # extern "c" fn(opts_json: TgStr, out_app: *mut TgHandle) -> TgResult
  app_run: u64            # extern "c" fn(app: TgHandle) -> TgResult
  app_drop: u64           # extern "c" fn(app: TgHandle) -> Unit
  window_create: u64      # extern "c" fn(app: TgHandle, title: TgStr, w: i32, h: i32, out_win: *mut TgHandle) -> TgResult
  window_poll_event: u64  # extern "c" fn(win: TgHandle, out_evt: *mut TgEventV1) -> Bool
  window_request_redraw: u64  # extern "c" fn(win: TgHandle) -> Unit
  window_surface: u64     # extern "c" fn(win: TgHandle, out_surface: *mut TgHandle) -> TgResult
  window_size: u64        # extern "c" fn(win: TgHandle, out_w: *mut i32, out_h: *mut i32) -> Unit
  window_dpi: u64         # extern "c" fn(win: TgHandle, out_scale: *mut f32) -> Unit
  window_drop: u64        # extern "c" fn(win: TgHandle) -> Unit
end

# ═══════════════════════════════════════════════════════════════
# §14.8 tg.gfx.v1 ABI
# ═══════════════════════════════════════════════════════════════

struct TgColor
  r: f32
  g: f32
  b: f32
  a: f32
end

struct TgRect
  x: f32
  y: f32
  w: f32
  h: f32
end

struct TgTransform2D
  m00: f32
  m01: f32
  m02: f32
  m10: f32
  m11: f32
  m12: f32
end

# Paint kind tags (u32).
let TG_PAINT_SOLID: u32   = 0u32
let TG_PAINT_LINEAR: u32  = 1u32
let TG_PAINT_RADIAL: u32  = 2u32

struct TgColorStop
  t: f32
  color: TgColor
end

struct TgPaintV1
  kind_tag: u32
  color_space: u32
  solid: TgColor           # Used when kind_tag == SOLID
  p0_x: f32                # Gradient start x
  p0_y: f32                # Gradient start y
  p1_x: f32                # Gradient end x
  p1_y: f32                # Gradient end y
  p2_x: f32                # Radial: center x
  p2_y: f32                # Radial: center y
  p3: f32                  # Radial: radius
  stops_ptr: u64           # *const TgColorStop
  stops_len: u64           # usize
end

struct TgStrokeV1
  width: f32
  cap: u32                 # 0=Butt, 1=Round, 2=Square
  join: u32                # 0=Miter, 1=Round, 2=Bevel
  miter_limit: f32
  dash_ptr: u64            # *const f32 (dash pattern)
  dash_len: u64            # usize
  dash_phase: f32
end

struct TgImageDrawOptsV1
  blend: u32
  opacity: f32
  filter: u32
end

struct TgGfxV1
  hdr: TgInterfaceHeader
  surface_begin_frame: u64
  surface_end_frame: u64
  surface_present: u64
  surface_drop: u64
  canvas_clear: u64
  canvas_save: u64
  canvas_restore: u64
  canvas_transform: u64
  canvas_clip_rect: u64
  canvas_fill_rect: u64
  canvas_stroke_rect: u64
  canvas_fill_path: u64
  canvas_stroke_path: u64
  canvas_draw_image: u64
  canvas_draw_glyph_run: u64
  canvas_drop: u64
  image_from_bitmap: u64
  image_drop: u64
  path_new: u64
  path_move_to: u64
  path_line_to: u64
  path_close: u64
  path_drop: u64
end

# ═══════════════════════════════════════════════════════════════
# §14.9 tg.text.v1 + tg.image.v1 ABI
# ═══════════════════════════════════════════════════════════════

struct TgGlyphV1
  id: u32
  x_adv: f32
  y_adv: f32
  x_off: f32
  y_off: f32
end

struct TgGlyphRunV1
  font: TgHandle
  size: f32
  glyphs_ptr: u64         # *const TgGlyphV1
  glyphs_len: u64         # usize
  xs_ptr: u64              # *const f32
  ys_ptr: u64              # *const f32
  bounds: TgRect
end

struct TgTextStyleV1
  size: f32
  font: TgHandle
  color: TgColor
  direction: u32           # 0=Auto, 1=LTR, 2=RTL
end

struct TgTextV1
  hdr: TgInterfaceHeader
  fontdb_create: u64       # extern "c" fn(out_db: *mut TgHandle) -> TgResult
  fontdb_add_bytes: u64    # extern "c" fn(db: TgHandle, bytes: TgSlice, out_font: *mut TgHandle) -> TgResult
  text_shape: u64          # extern "c" fn(db: TgHandle, text: TgStr, style: TgTextStyleV1, out_run: *mut TgGlyphRunV1) -> TgResult
  fontdb_drop: u64         # extern "c" fn(db: TgHandle) -> Unit
end

struct TgImageInfoV1
  w: i32
  h: i32
  format: u32              # 0=RGBA8, 1=BGRA8, 2=RGBAF16
  color_space: u32         # 0=sRGB, 1=DisplayP3
  stride: i32
end

struct TgBitmapV1
  info: TgImageInfoV1
  data_ptr: u64            # *const u8
  data_len: u64            # usize
end

struct TgImageV1
  hdr: TgInterfaceHeader
  decode: u64              # extern "c" fn(bytes: TgSlice, out_bmp: *mut TgBitmapV1) -> TgResult
  encode_png: u64          # extern "c" fn(bmp: *const TgBitmapV1, out_bytes: *mut TgSlice) -> TgResult
end

# ═══════════════════════════════════════════════════════════════
# §14.10 Optional ABI interfaces
# ═══════════════════════════════════════════════════════════════

struct TgClipboardV1
  hdr: TgInterfaceHeader
  set_text: u64            # extern "c" fn(win: TgHandle, text: TgStr) -> TgResult
  get_text: u64            # extern "c" fn(win: TgHandle, out_text: *mut TgStr) -> TgResult  (host frees via host.free)
end

struct TgImeV1
  hdr: TgInterfaceHeader
  enable: u64              # extern "c" fn(win: TgHandle, enable: Bool) -> TgResult
  set_cursor_rect: u64     # extern "c" fn(win: TgHandle, r: TgRect) -> TgResult
end

struct TgDragDropV1
  hdr: TgInterfaceHeader
  enable: u64              # extern "c" fn(win: TgHandle, enable: Bool) -> TgResult
end

struct TgGpuV1
  hdr: TgInterfaceHeader
  instance_create: u64     # extern "c" fn(out_inst: *mut TgHandle) -> TgResult
  adapter_list: u64        # extern "c" fn(inst: TgHandle, out_adapters: *mut TgSlice) -> TgResult  (host-alloc'd)
  device_request: u64      # extern "c" fn(adapter: TgHandle, out_dev: *mut TgHandle, out_queue: *mut TgHandle) -> TgResult
  surface_from_window: u64 # extern "c" fn(inst: TgHandle, win: TgHandle, out_surf: *mut TgHandle) -> TgResult
  swapchain_create: u64    # extern "c" fn(dev: TgHandle, surf: TgHandle, fmt: u32, mode: u32, out_sc: *mut TgHandle) -> TgResult
  swapchain_next_view: u64 # extern "c" fn(sc: TgHandle, out_view: *mut TgHandle) -> TgResult
  swapchain_present: u64   # extern "c" fn(sc: TgHandle) -> TgResult
end

# ═══════════════════════════════════════════════════════════════
# §14.11 Manifest JSON keys
# ═══════════════════════════════════════════════════════════════
#
# Required keys in the manifest JSON returned by tg_backend_manifest_v1:
#
# {
#   "name": "string",
#   "version": "string (semver)",
#   "abi_major": 1,
#   "abi_minor": 0,
#   "interfaces": ["tg.app.v1", "tg.gfx.v1", "tg.text.v1", ...],
#   "capabilities": {
#     "deterministic_raster": true|false,
#     "gpu_nondeterminism_possible": true|false,
#     "threadsafe_calls": true|false
#   },
#   "platforms": ["macos-aarch64", "linux-x86_64", ...]
# }

# Example manifest for validation:
def _example_manifest() -> String
  "{" +
    "\"name\": \"tg-software-backend\"," +
    "\"version\": \"0.1.0\"," +
    "\"abi_major\": 1," +
    "\"abi_minor\": 0," +
    "\"interfaces\": [\"tg.app.v1\", \"tg.gfx.v1\", \"tg.text.v1\"]," +
    "\"capabilities\": {" +
      "\"deterministic_raster\": true," +
      "\"gpu_nondeterminism_possible\": false," +
      "\"threadsafe_calls\": false" +
    "}," +
    "\"platforms\": [\"macos-aarch64\", \"macos-x86_64\", \"linux-x86_64\", \"windows-x86_64\"]" +
  "}"
end

# ═══════════════════════════════════════════════════════════════
# §14.12 Loader rules
# ═══════════════════════════════════════════════════════════════

enum LoaderSearchOrder
  ExplicitPath         # Tangerine.toml [backend] path = "..."
  EnvVariable          # TG_BACKEND_PATH environment variable
  SystemDirectory      # Platform system plugin directories
  BuiltinFallback      # Statically-linked reference backend
end

enum LoaderPriority
  Explicit
  ProjectLock
  System
  Fallback
end

struct LoaderConfig
  search_order: Vec[LoaderSearchOrder]
  required_interfaces: Vec[String]
end

def default_loader_config() -> LoaderConfig
  let order = Vec::new()
  order.push(LoaderSearchOrder::ExplicitPath)
  order.push(LoaderSearchOrder::EnvVariable)
  order.push(LoaderSearchOrder::SystemDirectory)
  order.push(LoaderSearchOrder::BuiltinFallback)

  let required = Vec::new()
  required.push("tg.app.v1".to_string())
  required.push("tg.gfx.v1".to_string())
  required.push("tg.text.v1".to_string())

  LoaderConfig { search_order: order, required_interfaces: required }
end

def validate_abi_version(plugin_major: u32, plugin_minor: u32) -> Bool
  # MUST match major exactly; MAY accept higher minor.
  plugin_major == TG_BACKEND_ABI_MAJOR && plugin_minor >= TG_BACKEND_ABI_MINOR
end

def validate_interface_header(hdr: &TgInterfaceHeader, expected_min_size: u32) -> Bool
  # MUST verify size_bytes before reading fields for forward compatibility.
  hdr.size_bytes >= expected_min_size
end
