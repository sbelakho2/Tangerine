# Tangerine Standard Library — tg::term
# Terminal/Console I/O

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt}
use std::ffi::{c_int, c_uint, c_ulong, c_ushort, c_void}
use std::io::{Read, Write, Stdin, Stdout, stderr}

# [METADATA]
# module: tg::term
# status: stable
# effects: [IO]
# capabilities: [terminal]

# ═══════════════════════════════════════════════════════════════
# FFI Declarations for Termios (POSIX) — exact ABI widths
# ═══════════════════════════════════════════════════════════════
# The C `int` returns (isatty/tcgetattr/tcsetattr/ioctl) declare the i32
# form (the 32-bit int); the callers' `< 0` / `== 0` checks compare
# against the sign-extended value. The fd/optional_actions/request
# by-value parameters are passed wide (the C callee reads the low 32
# bits) — the request is the LP64 `unsigned long` (u64).

@ffi("c")
extern def isatty(fd: c_int) -> i32
end

@ffi("c")
extern def tcgetattr(fd: c_int, inout termios_p: termios) -> i32
end

@ffi("c")
extern def tcsetattr(fd: c_int, optional_actions: c_int, termios_p: Ptr[termios]) -> i32
end

@ffi("c")
extern def cfmakeraw(inout termios_p: termios) -> Unit
end

# ioctl for terminal size
@ffi("c")
extern def ioctl(fd: c_int, request: c_ulong, ...) -> i32
end

# ═══════════════════════════════════════════════════════════════
# Termios Structure (per-platform C layout)
# ═══════════════════════════════════════════════════════════════
# The layouts are the libc user-space structs:
#   Linux (glibc): tcflag_t = unsigned int (u32) x4 at 0/4/8/12,
#     cc_t c_line at 16, cc_t c_cc[32] at 17, speed_t (u32) x2 at 52/56
#     — 60 bytes total.
#   macOS (Darwin): tcflag_t = unsigned long (u64) x4 at 0/8/16/24,
#     cc_t c_cc[20] at 32, speed_t = unsigned long (u64) x2 at 56/64
#     — 72 bytes total (VMIN/VTIME = 16/17, not 6/5).

@cfg(target_os = "linux")
struct termios
  c_iflag: u32   # Input modes
  c_oflag: u32   # Output modes
  c_cflag: u32   # Control modes
  c_lflag: u32   # Local modes
  c_line: u8     # Line discipline
  c_cc: [u8; 32]  # Control characters (NCCS = 32)
  c_ispeed: u32  # Input speed
  c_ospeed: u32  # Output speed
end

@cfg(target_os = "macos")
struct termios
  c_iflag: u64   # Input modes
  c_oflag: u64   # Output modes
  c_cflag: u64   # Control modes
  c_lflag: u64   # Local modes
  c_cc: [u8; 20]  # Control characters (NCCS = 20)
  c_ispeed: u64  # Input speed
  c_ospeed: u64  # Output speed
end

@cfg(target_os = "linux")
def termios_zero() -> termios
  termios {
    c_iflag: 0,
    c_oflag: 0,
    c_cflag: 0,
    c_lflag: 0,
    c_line: 0,
    c_cc: [0u8; 32],
    c_ispeed: 0,
    c_ospeed: 0
  }
end

@cfg(target_os = "macos")
def termios_zero() -> termios
  termios {
    c_iflag: 0,
    c_oflag: 0,
    c_cflag: 0,
    c_lflag: 0,
    c_cc: [0u8; 20],
    c_ispeed: 0,
    c_ospeed: 0
  }
end

# Termios constants
def TCSANOW() -> c_int = 0
def TCSADRAIN() -> c_int = 1
def TCSAFLUSH() -> c_int = 2

# Input flags — per-platform: tcflag_t is u32 on Linux, u64 on macOS,
# and several values differ (the constants must unify with the struct's
# field types — the compiler's integer types are exact, no silent
# coercion between widths).
@cfg(target_os = "linux")
def IGNBRK() -> u32 = 0o0000001
@cfg(target_os = "macos")
def IGNBRK() -> u64 = 0x00000001
@cfg(target_os = "linux")
def BRKINT() -> u32 = 0o0000002
@cfg(target_os = "macos")
def BRKINT() -> u64 = 0x00000002
@cfg(target_os = "linux")
def IGNPAR() -> u32 = 0o0000004
@cfg(target_os = "macos")
def IGNPAR() -> u64 = 0x00000004
@cfg(target_os = "linux")
def PARMRK() -> u32 = 0o0000010
@cfg(target_os = "macos")
def PARMRK() -> u64 = 0x00000008
@cfg(target_os = "linux")
def INPCK() -> u32 = 0o0000020
@cfg(target_os = "macos")
def INPCK() -> u64 = 0x00000010
@cfg(target_os = "linux")
def ISTRIP() -> u32 = 0o0000040
@cfg(target_os = "macos")
def ISTRIP() -> u64 = 0x00000020
@cfg(target_os = "linux")
def INLCR() -> u32 = 0o0000100
@cfg(target_os = "macos")
def INLCR() -> u64 = 0x00000040
@cfg(target_os = "linux")
def IGNCR() -> u32 = 0o0000200
@cfg(target_os = "macos")
def IGNCR() -> u64 = 0x00000080
@cfg(target_os = "linux")
def ICRNL() -> u32 = 0o0000400
@cfg(target_os = "macos")
def ICRNL() -> u64 = 0x00000100
@cfg(target_os = "linux")
def IXON() -> u32 = 0o0002000
@cfg(target_os = "macos")
def IXON() -> u64 = 0x00000200

# Output flags
@cfg(target_os = "linux")
def OPOST() -> u32 = 0o0000001
@cfg(target_os = "macos")
def OPOST() -> u64 = 0x00000001
@cfg(target_os = "linux")
def ONLCR() -> u32 = 0o0000004
@cfg(target_os = "macos")
def ONLCR() -> u64 = 0x00000002

# Control flags
@cfg(target_os = "linux")
def CSIZE() -> u32 = 0o0000060
@cfg(target_os = "macos")
def CSIZE() -> u64 = 0x00000300
@cfg(target_os = "linux")
def CS8() -> u32 = 0o0000060
@cfg(target_os = "macos")
def CS8() -> u64 = 0x00000300
@cfg(target_os = "linux")
def CREAD() -> u32 = 0o0000200
@cfg(target_os = "macos")
def CREAD() -> u64 = 0x00000800

# Local flags
@cfg(target_os = "linux")
def ISIG() -> u32 = 0o0000001
@cfg(target_os = "macos")
def ISIG() -> u64 = 0x00000080
@cfg(target_os = "linux")
def ICANON() -> u32 = 0o0000002
@cfg(target_os = "macos")
def ICANON() -> u64 = 0x00000100
@cfg(target_os = "linux")
def ECHO() -> u32 = 0o0000010
@cfg(target_os = "macos")
def ECHO() -> u64 = 0x00000008
@cfg(target_os = "linux")
def ECHOE() -> u32 = 0o0000020
@cfg(target_os = "macos")
def ECHOE() -> u64 = 0x00000002
@cfg(target_os = "linux")
def ECHOK() -> u32 = 0o0000040
@cfg(target_os = "macos")
def ECHOK() -> u64 = 0x00000004
@cfg(target_os = "linux")
def ECHONL() -> u32 = 0o0000100
@cfg(target_os = "macos")
def ECHONL() -> u64 = 0x00000010
@cfg(target_os = "linux")
def NOFLSH() -> u32 = 0o0000200
@cfg(target_os = "macos")
def NOFLSH() -> u64 = 0x80000000
@cfg(target_os = "linux")
def IEXTEN() -> u32 = 0o0100000
@cfg(target_os = "macos")
def IEXTEN() -> u64 = 0x00000400

# Control characters (the c_cc index constants are platform-specific:
# glibc VMIN/VTIME = 6/5, Darwin = 16/17)
@cfg(target_os = "linux")
def VMIN() -> c_int = 6
@cfg(target_os = "macos")
def VMIN() -> c_int = 16
@cfg(target_os = "linux")
def VTIME() -> c_int = 5
@cfg(target_os = "macos")
def VTIME() -> c_int = 17
@cfg(target_os = "linux")
def VEOF() -> c_int = 4
@cfg(target_os = "macos")
def VEOF() -> c_int = 4
@cfg(target_os = "linux")
def VEOL() -> c_int = 11
@cfg(target_os = "macos")
def VEOL() -> c_int = 1

# ioctl constants (Linux x86-64)
def TIOCGWINSZ() -> c_ulong = 0x5413
def TIOCSWINSZ() -> c_ulong = 0x5414

# File descriptors
def STDIN_FILENO() -> c_int = 0
def STDOUT_FILENO() -> c_int = 1
def STDERR_FILENO() -> c_int = 2

# ═══════════════════════════════════════════════════════════════
# Window Size Structure
# ═══════════════════════════════════════════════════════════════

struct winsize
  ws_row: c_ushort
  ws_col: c_ushort
  ws_xpixel: c_ushort
  ws_ypixel: c_ushort
end

# ═══════════════════════════════════════════════════════════════
# Terminal Size
# ═══════════════════════════════════════════════════════════════

struct Size
  rows: UInt
  cols: UInt
end

def size() -> Option[Size]
  mut ws = winsize { ws_row: 0, ws_col: 0, ws_xpixel: 0, ws_ypixel: 0 }
  
  let result = ioctl(STDOUT_FILENO(), TIOCGWINSZ(), &mut ws as PtrMut[u8])
  
  if result == 0 && ws.ws_row > 0 && ws.ws_col > 0 then
    Option::Some(Size { rows: ws.ws_row as UInt, cols: ws.ws_col as UInt })
  else
    Option::None
  end
end

def rows() -> Option[UInt]
  match size()
  when Option::Some(s) then Option::Some(s.rows)
  when Option::None then Option::None
  end
end

def cols() -> Option[UInt]
  match size()
  when Option::Some(s) then Option::Some(s.cols)
  when Option::None then Option::None
  end
end

# ═══════════════════════════════════════════════════════════════
# Terminal Mode Control
# ═══════════════════════════════════════════════════════════════

def is_terminal(fd: c_int) -> Bool
  isatty(fd) == 1
end

def is_stdin_terminal() -> Bool
  is_terminal(STDIN_FILENO())
end

def is_stdout_terminal() -> Bool
  is_terminal(STDOUT_FILENO())
end

def is_stderr_terminal() -> Bool
  is_terminal(STDERR_FILENO())
end

# ═══════════════════════════════════════════════════════════════
# Raw Mode
# ═══════════════════════════════════════════════════════════════

struct RawModeGuard
  original: termios
  fd: c_int
end

def enable_raw_mode(fd: c_int) -> Result[RawModeGuard, String]
  if !is_terminal(fd) then
    return Result::Err("Not a terminal".to_string())
  end
  
  mut original = termios_zero()
  
  if tcgetattr(fd, &mut original) < 0 then
    return Result::Err("Failed to get terminal attributes".to_string())
  end
  
  mut raw = original.clone()
  
  # Disable: break interrupt, parity, strip, CR to NL, flow control
  raw.c_iflag = raw.c_iflag & !(BRKINT() | ISTRIP() | INPCK() | ICRNL() | IXON())
  
  # Disable: output processing
  raw.c_oflag = raw.c_oflag & !OPOST()
  
  # Set: 8-bit characters
  raw.c_cflag = (raw.c_cflag & !CSIZE()) | CS8() | CREAD()
  
  # Disable: echo, signals, canonical mode, extended processing
  raw.c_lflag = raw.c_lflag & !(ECHO() | ECHONL() | ICANON() | ISIG() | IEXTEN())
  
  # Set: minimum bytes and timeout for read
  raw.c_cc[VMIN() as UInt] = 0
  raw.c_cc[VTIME() as UInt] = 1  # 0.1 seconds
  
  if tcsetattr(fd, TCSADRAIN(), &raw as Ptr[termios]) < 0 then
    return Result::Err("Failed to set terminal attributes".to_string())
  end
  
  Result::Ok(RawModeGuard { original: original, fd: fd })
end

def RawModeGuard::disable(self: RawModeGuard) -> Result[Unit, String]
  if tcsetattr(self.fd, TCSADRAIN(), &self.original as Ptr[termios]) < 0 then
    Result::Err("Failed to restore terminal attributes".to_string())
  else
    Result::Ok(())
  end
end

def RawModeGuard::drop(inout self: RawModeGuard) -> Unit
  let _ = self.disable()
end

# ═══════════════════════════════════════════════════════════════
# ANSI Color Support
# ═══════════════════════════════════════════════════════════════

enum Color
  Black
  Red
  Green
  Yellow
  Blue
  Magenta
  Cyan
  White
  BrightBlack
  BrightRed
  BrightGreen
  BrightYellow
  BrightBlue
  BrightMagenta
  BrightCyan
  BrightWhite
  Rgb(u8, u8, u8)
  Ansi256(u8)
  Reset
end

def Color::to_fg(self: Color) -> String
  match self
  when Color::Black then "\x1b[30m"
  when Color::Red then "\x1b[31m"
  when Color::Green then "\x1b[32m"
  when Color::Yellow then "\x1b[33m"
  when Color::Blue then "\x1b[34m"
  when Color::Magenta then "\x1b[35m"
  when Color::Cyan then "\x1b[36m"
  when Color::White then "\x1b[37m"
  when Color::BrightBlack then "\x1b[90m"
  when Color::BrightRed then "\x1b[91m"
  when Color::BrightGreen then "\x1b[92m"
  when Color::BrightYellow then "\x1b[93m"
  when Color::BrightBlue then "\x1b[94m"
  when Color::BrightMagenta then "\x1b[95m"
  when Color::BrightCyan then "\x1b[96m"
  when Color::BrightWhite then "\x1b[97m"
  when Color::Rgb(r, g, b) then "\x1b[38;2;" + r.to_string() + ";" + g.to_string() + ";" + b.to_string() + "m"
  when Color::Ansi256(n) then "\x1b[38;5;" + n.to_string() + "m"
  when Color::Reset then "\x1b[39m"
  end
end

def Color::to_bg(self: Color) -> String
  match self
  when Color::Black then "\x1b[40m"
  when Color::Red then "\x1b[41m"
  when Color::Green then "\x1b[42m"
  when Color::Yellow then "\x1b[43m"
  when Color::Blue then "\x1b[44m"
  when Color::Magenta then "\x1b[45m"
  when Color::Cyan then "\x1b[46m"
  when Color::White then "\x1b[47m"
  when Color::BrightBlack then "\x1b[100m"
  when Color::BrightRed then "\x1b[101m"
  when Color::BrightGreen then "\x1b[102m"
  when Color::BrightYellow then "\x1b[103m"
  when Color::BrightBlue then "\x1b[104m"
  when Color::BrightMagenta then "\x1b[105m"
  when Color::BrightCyan then "\x1b[106m"
  when Color::BrightWhite then "\x1b[107m"
  when Color::Rgb(r, g, b) then "\x1b[48;2;" + r.to_string() + ";" + g.to_string() + ";" + b.to_string() + "m"
  when Color::Ansi256(n) then "\x1b[48;5;" + n.to_string() + "m"
  when Color::Reset then "\x1b[49m"
  end
end

# ═══════════════════════════════════════════════════════════════
# Text Styles
# ═══════════════════════════════════════════════════════════════

struct Style
  fg: Option[Color]
  bg: Option[Color]
  bold: Bool
  dim: Bool
  italic: Bool
  underline: Bool
  blink: Bool
  reverse: Bool
  hidden: Bool
  strikethrough: Bool
end

def Style::new() -> Style
  Style {
    fg: Option::None,
    bg: Option::None,
    bold: false,
    dim: false,
    italic: false,
    underline: false,
    blink: false,
    reverse: false,
    hidden: false,
    strikethrough: false
  }
end

def Style::fg(sink self: Style, color: Color) -> Style
  self.fg = Option::Some(color)
  self
end

def Style::bg(sink self: Style, color: Color) -> Style
  self.bg = Option::Some(color)
  self
end

def Style::bold(sink self: Style) -> Style
  self.bold = true
  self
end

def Style::dim(sink self: Style) -> Style
  self.dim = true
  self
end

def Style::italic(sink self: Style) -> Style
  self.italic = true
  self
end

def Style::underline(sink self: Style) -> Style
  self.underline = true
  self
end

def Style::blink(sink self: Style) -> Style
  self.blink = true
  self
end

def Style::reverse(sink self: Style) -> Style
  self.reverse = true
  self
end

def Style::hidden(sink self: Style) -> Style
  self.hidden = true
  self
end

def Style::strikethrough(sink self: Style) -> Style
  self.strikethrough = true
  self
end

def Style::to_prefix(self: Style) -> String
  mut codes = Vec::new()
  
  match self.fg
  when Option::Some(color) then
    codes.push(color.to_fg())
  when Option::None then ()
  end
  
  match self.bg
  when Option::Some(color) then
    codes.push(color.to_bg())
  when Option::None then ()
  end
  
  if self.bold then codes.push("\x1b[1m") end
  if self.dim then codes.push("\x1b[2m") end
  if self.italic then codes.push("\x1b[3m") end
  if self.underline then codes.push("\x1b[4m") end
  if self.blink then codes.push("\x1b[5m") end
  if self.reverse then codes.push("\x1b[7m") end
  if self.hidden then codes.push("\x1b[8m") end
  if self.strikethrough then codes.push("\x1b[9m") end
  
  codes.join("")
end

def Style::to_suffix(self: Style) -> String
  "\x1b[0m"
end

def Style::apply(self: Style, text: String) -> String
  self.to_prefix() + text + self.to_suffix()
end

# ═══════════════════════════════════════════════════════════════
# Terminal Control Sequences
# ═══════════════════════════════════════════════════════════════

def clear_screen() -> String
  "\x1b[2J"
end

def clear_screen_down() -> String
  "\x1b[J"
end

def clear_screen_up() -> String
  "\x1b[1J"
end

def clear_line() -> String
  "\x1b[2K"
end

def clear_line_right() -> String
  "\x1b[K"
end

def clear_line_left() -> String
  "\x1b[1K"
end

def move_to(row: UInt, col: UInt) -> String
  "\x1b[" + row.to_string() + ";" + col.to_string() + "H"
end

def move_to_first_column() -> String
  "\x1b[G"
end

def move_up(n: UInt) -> String
  if n == 0 then "" else "\x1b[" + n.to_string() + "A" end
end

def move_down(n: UInt) -> String
  if n == 0 then "" else "\x1b[" + n.to_string() + "B" end
end

def move_right(n: UInt) -> String
  if n == 0 then "" else "\x1b[" + n.to_string() + "C" end
end

def move_left(n: UInt) -> String
  if n == 0 then "" else "\x1b[" + n.to_string() + "D" end
end

def save_cursor() -> String
  "\x1b[s"
end

def restore_cursor() -> String
  "\x1b[u"
end

def hide_cursor() -> String
  "\x1b[?25l"
end

def show_cursor() -> String
  "\x1b[?25h"
end

def set_title(title: String) -> String
  "\x1b]0;" + title + "\x07"
end

def scroll_up(n: UInt) -> String
  "\x1b[" + n.to_string() + "S"
end

def scroll_down(n: UInt) -> String
  "\x1b[" + n.to_string() + "T"
end

def alternate_screen() -> String
  "\x1b[?1049h"
end

def main_screen() -> String
  "\x1b[?1049l"
end

def reset() -> String
  "\x1b[c"
end

def soft_reset() -> String
  "\x1b[!p"
end

# ═══════════════════════════════════════════════════════════════
# Cursor Shape
# ═══════════════════════════════════════════════════════════════

enum CursorShape
  Block
  Underline
  Bar
end

def set_cursor_shape(shape: CursorShape) -> String
  match shape
  when CursorShape::Block then "\x1b[2 q"
  when CursorShape::Underline then "\x1b[4 q"
  when CursorShape::Bar then "\x1b[6 q"
  end
end

def blinking_cursor(enable: Bool) -> String
  if enable then "\x1b[?12h" else "\x1b[?12l" end
end

# ═══════════════════════════════════════════════════════════════
# Input Reading
# ═══════════════════════════════════════════════════════════════

def read_single_char() -> Result[char, String]
  match enable_raw_mode(STDIN_FILENO())
  when Result::Ok(guard) then
    mut buf: [u8; 4] = [0u8; 4]
    let stdin = std::io::stdin()
    
    match stdin.read(&mut buf)
    when Result::Ok(n) then
      let _ = guard.disable()
      if n == 0 then
        Result::Err("No input available".to_string())
      else
        # Decode UTF-8 character
        let ch = decode_utf8_char(&buf[0..n])
        Result::Ok(ch)
      end
    when Result::Err(e) then
      let _ = guard.disable()
      Result::Err(e)
    end
  when Result::Err(e) then Result::Err(e)
  end
end

def decode_utf8_char(bytes: [u8]) -> char
  if bytes.len() == 0 then
    return '\0'
  end
  
  if (bytes[0] & 0x80) == 0 then
    # Single byte (ASCII)
    bytes[0] as char
  else if (bytes[0] & 0xE0) == 0xC0 && bytes.len() >= 2 then
    # Two bytes
    (((bytes[0] & 0x1F) as u32) << 6 | ((bytes[1] & 0x3F) as u32)) as char
  else if (bytes[0] & 0xF0) == 0xE0 && bytes.len() >= 3 then
    # Three bytes
    (((bytes[0] & 0x0F) as u32) << 12 | ((bytes[1] & 0x3F) as u32) << 6 | ((bytes[2] & 0x3F) as u32)) as char
  else if (bytes[0] & 0xF8) == 0xF0 && bytes.len() >= 4 then
    # Four bytes
    (((bytes[0] & 0x07) as u32) << 18 | ((bytes[1] & 0x3F) as u32) << 12 | ((bytes[2] & 0x3F) as u32) << 6 | ((bytes[3] & 0x3F) as u32)) as char
  else
    '\0'
  end
end

# ═══════════════════════════════════════════════════════════════
# Key Events
# ═══════════════════════════════════════════════════════════════

enum Key
  Char(char)
  Up
  Down
  Left
  Right
  Home
  End
  PageUp
  PageDown
  Insert
  Delete
  Backspace
  Tab
  Enter
  Escape
  F1
  F2
  F3
  F4
  F5
  F6
  F7
  F8
  F9
  F10
  F11
  F12
  Unknown(String)
end

def read_key() -> Result[Key, String]
  match enable_raw_mode(STDIN_FILENO())
  when Result::Ok(guard) then
    mut buf: [u8; 16] = [0u8; 16]
    let stdin = std::io::stdin()
    
    match stdin.read(&mut buf)
    when Result::Ok(n) then
      let _ = guard.disable()
      
      if n == 0 then
        Result::Err("No input available".to_string())
      else if n == 1 then
        # Single character
        let ch = buf[0]
        if ch == 0x1B then
          Result::Ok(Key::Escape)
        else if ch == 0x7F then
          Result::Ok(Key::Backspace)
        else if ch == 0x09 then
          Result::Ok(Key::Tab)
        else if ch == 0x0D then
          Result::Ok(Key::Enter)
        else
          Result::Ok(Key::Char(ch as char))
        end
      else
        # Escape sequence
        parse_escape_sequence(&buf[0..n])
      end
    when Result::Err(e) then
      let _ = guard.disable()
      Result::Err(e)
    end
  when Result::Err(e) then Result::Err(e)
  end
end

def parse_escape_sequence(bytes: [u8]) -> Result[Key, String]
  if bytes.len() < 2 then
    return Result::Ok(Key::Unknown(String::from_utf8_lossy(&bytes.to_vec())))
  end
  
  if bytes[0] != 0x1B then
    return Result::Ok(Key::Char(decode_utf8_char(bytes)))
  end
  
  if bytes[1] == 0x5B then
    # CSI sequence (ESC [)
    if bytes.len() == 3 then
      match bytes[2]
      when 0x41 then return Result::Ok(Key::Up)
      when 0x42 then return Result::Ok(Key::Down)
      when 0x43 then return Result::Ok(Key::Right)
      when 0x44 then return Result::Ok(Key::Left)
      when 0x48 then return Result::Ok(Key::Home)
      when 0x46 then return Result::Ok(Key::End)
      when 0x5A then return Result::Ok(Key::Tab)  # Shift+Tab
      else ()
      end
    else if bytes.len() == 4 && bytes[3] == 0x7E then
      match bytes[2]
      when 0x31 then return Result::Ok(Key::Home)
      when 0x33 then return Result::Ok(Key::Delete)
      when 0x34 then return Result::Ok(Key::End)
      when 0x35 then return Result::Ok(Key::PageUp)
      when 0x36 then return Result::Ok(Key::PageDown)
      when 0x32 then return Result::Ok(Key::Insert)
      else ()
      end
    else if bytes.len() >= 4 && bytes[2] == 0x31 then
      # F1-F4: ESC [ 1 ~ P, Q, R, S
      if bytes.len() == 4 then
        match bytes[3]
        when 0x50 then return Result::Ok(Key::F1)
        when 0x51 then return Result::Ok(Key::F2)
        when 0x52 then return Result::Ok(Key::F3)
        when 0x53 then return Result::Ok(Key::F4)
        else ()
        end
      end
    else if bytes.len() >= 4 && bytes[2] == 0x32 then
      # F5-F12: ESC [ 1? ~
      if bytes.len() == 4 then
        match bytes[3]
        when 0x37 then return Result::Ok(Key::F6)
        when 0x38 then return Result::Ok(Key::F7)
        when 0x39 then return Result::Ok(Key::F8)
        else ()
        end
      else if bytes.len() == 5 && bytes[4] == 0x7E then
        match bytes[3]
        when 0x31 then return Result::Ok(Key::F1)
        when 0x32 then return Result::Ok(Key::F2)
        when 0x33 then return Result::Ok(Key::F3)
        when 0x34 then return Result::Ok(Key::F4)
        when 0x35 then return Result::Ok(Key::F5)
        when 0x36 then return Result::Ok(Key::F6)
        when 0x37 then return Result::Ok(Key::F7)
        when 0x38 then return Result::Ok(Key::F8)
        when 0x39 then return Result::Ok(Key::F9)
        when 0x3A then return Result::Ok(Key::F10)
        when 0x3B then return Result::Ok(Key::F11)
        when 0x3C then return Result::Ok(Key::F12)
        else ()
        end
      end
    end
  end
  
  Result::Ok(Key::Unknown(String::from_utf8_lossy(bytes)))
end

# ═══════════════════════════════════════════════════════════════
# Password Input
# ═══════════════════════════════════════════════════════════════

def read_password(prompt: String) -> Result[String, String]
  print(prompt)
  std::io::stdout().flush()
  
  match enable_raw_mode(STDIN_FILENO())
  when Result::Ok(guard) then
    mut password = ""
    loop
      match read_single_char()
      when Result::Ok(ch) then
        if ch == '\r' || ch == '\n' then
          println!()
          let _ = guard.disable()
          return Result::Ok(password)
        else if ch == '\x7F' || ch == '\x08' then
          # Backspace
          if password.len() > 0 then
            password = password[0..password.len()-1]
          end
        else if ch == '\x03' then
          # Ctrl+C
          let _ = guard.disable()
          return Result::Err("Interrupted".to_string())
        else if ch == '\x1B' then
          # Escape
          let _ = guard.disable()
          return Result::Err("Cancelled".to_string())
        else
          password = password + ch.to_string()
        end
      when Result::Err(e) then
        let _ = guard.disable()
        return Result::Err(e)
      end
    end
  when Result::Err(e) then Result::Err(e)
  end
end

def read_password_masked(prompt: String, mask: char) -> Result[String, String]
  print(prompt)
  std::io::stdout().flush()
  
  match enable_raw_mode(STDIN_FILENO())
  when Result::Ok(guard) then
    mut password = ""
    loop
      match read_single_char()
      when Result::Ok(ch) then
        if ch == '\r' || ch == '\n' then
          println!()
          let _ = guard.disable()
          return Result::Ok(password)
        else if ch == '\x7F' || ch == '\x08' then
          if password.len() > 0 then
            password = password[0..password.len()-1]
            print("\x08 \x08")  # Erase character
            std::io::stdout().flush()
          end
        else if ch == '\x03' then
          let _ = guard.disable()
          return Result::Err("Interrupted".to_string())
        else if ch == '\x1B' then
          let _ = guard.disable()
          return Result::Err("Cancelled".to_string())
        else
          password = password + ch.to_string()
          print(mask.to_string())
          std::io::stdout().flush()
        end
      when Result::Err(e) then
        let _ = guard.disable()
        return Result::Err(e)
      end
    end
  when Result::Err(e) then Result::Err(e)
  end
end

# ═══════════════════════════════════════════════════════════════
# Progress Bar
# ═══════════════════════════════════════════════════════════════

struct ProgressBar
  total: UInt
  current: UInt
  width: UInt
  filled_char: char
  empty_char: char
  prefix: String
  suffix: String
  show_percent: Bool
  show_count: Bool
  show_eta: Bool
  start_time: u64
end

def ProgressBar::new(total: UInt) -> ProgressBar
  ProgressBar {
    total: total,
    current: 0,
    width: 40,
    filled_char: '=',
    empty_char: ' ',
    prefix: "",
    suffix: "",
    show_percent: true,
    show_count: true,
    show_eta: true,
    start_time: std::time::unix_timestamp() as u64
  }
end

def ProgressBar::width(sink self: ProgressBar, w: UInt) -> ProgressBar
  self.width = w
  self
end

def ProgressBar::style(sink self: ProgressBar, filled: char, empty: char) -> ProgressBar
  self.filled_char = filled
  self.empty_char = empty
  self
end

def ProgressBar::prefix(sink self: ProgressBar, p: String) -> ProgressBar
  self.prefix = p
  self
end

def ProgressBar::suffix(sink self: ProgressBar, s: String) -> ProgressBar
  self.suffix = s
  self
end

def ProgressBar::set(inout self: ProgressBar, current: UInt) -> Unit
  self.current = if current > self.total then self.total else current end
  self.render()
end

def ProgressBar::inc(inout self: ProgressBar, delta: UInt) -> Unit
  self.set(self.current + delta)
end

def ProgressBar::tick(inout self: ProgressBar) -> Unit
  self.render()
end

def ProgressBar::render(self: ProgressBar) -> Unit
  let percent = if self.total > 0 then (self.current * 100) / self.total else 0 end
  let filled = if self.total > 0 then (self.current * self.width) / self.total else 0 end
  let empty = self.width - filled
  
  mut bar = String::with_capacity(self.width + 50)
  
  # Prefix
  if self.prefix.len() > 0 then
    bar = bar + self.prefix + " "
  end
  
  # Bar
  bar = bar + "["
  mut i = 0
  while i < filled do
    bar = bar + self.filled_char.to_string()
    i = i + 1
  end
  i = 0
  while i < empty do
    bar = bar + self.empty_char.to_string()
    i = i + 1
  end
  bar = bar + "]"
  
  # Percentage
  if self.show_percent then
    bar = bar + " " + percent.to_string() + "%"
  end
  
  # Count
  if self.show_count then
    bar = bar + " " + self.current.to_string() + "/" + self.total.to_string()
  end
  
  # ETA
  if self.show_eta && self.current > 0 then
    let elapsed = (std::time::unix_timestamp() as u64) - self.start_time
    let rate = self.current / (elapsed + 1)
    let remaining = if rate > 0 then (self.total - self.current) / rate else 0 end
    bar = bar + " ETA: " + format_duration(remaining)
  end
  
  # Suffix
  if self.suffix.len() > 0 then
    bar = bar + " " + self.suffix
  end
  
  # Clear line and print
  print("\r" + clear_line_right() + bar)
  std::io::stdout().flush()
end

def ProgressBar::finish(inout self: ProgressBar) -> Unit
  self.current = self.total
  self.render()
  println!()
end

def ProgressBar::clear(self: ProgressBar) -> Unit
  print("\r" + clear_line_right())
  std::io::stdout().flush()
end

def format_duration(seconds: UInt) -> String
  if seconds < 60 then
    seconds.to_string() + "s"
  else if seconds < 3600 then
    (seconds / 60).to_string() + "m " + (seconds % 60).to_string() + "s"
  else
    (seconds / 3600).to_string() + "h " + ((seconds % 3600) / 60).to_string() + "m"
  end
end

# ═══════════════════════════════════════════════════════════════
# Spinner
# ═══════════════════════════════════════════════════════════════

struct Spinner
  frames: Vec[String]
  current: UInt
  message: String
end

def Spinner::new() -> Spinner
  Spinner {
    frames: vec!["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"],
    current: 0,
    message: ""
  }
end

def Spinner::dots() -> Spinner
  Spinner {
    frames: vec!["⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"],
    current: 0,
    message: ""
  }
end

def Spinner::line() -> Spinner
  Spinner {
    frames: vec!["-", "\\", "|", "/"],
    current: 0,
    message: ""
  }
end

def Spinner::arrow() -> Spinner
  Spinner {
    frames: vec!["←", "↖", "↑", "↗", "→", "↘", "↓", "↙"],
    current: 0,
    message: ""
  }
end

def Spinner::message(sink self: Spinner, msg: String) -> Spinner
  self.message = msg
  self
end

def Spinner::tick(inout self: Spinner) -> Unit
  let frame = self.frames[self.current % self.frames.len()].clone()
  print("\r" + frame + " " + self.message)
  std::io::stdout().flush()
  self.current = self.current + 1
end

def Spinner::finish(inout self: Spinner, msg: String) -> Unit
  print("\r" + clear_line_right() + "✓ " + msg + "\n")
  std::io::stdout().flush()
end

def Spinner::fail(inout self: Spinner, msg: String) -> Unit
  print("\r" + clear_line_right() + "✗ " + msg + "\n")
  std::io::stdout().flush()
end

def Spinner::clear(self: Spinner) -> Unit
  print("\r" + clear_line_right())
  std::io::stdout().flush()
end

# ═══════════════════════════════════════════════════════════════
# Terminal Detection
# ═══════════════════════════════════════════════════════════════

def supports_color() -> Bool
  # Check COLORTERM environment variable
  match std::env::get_env("COLORTERM")
  when Option::Some(val) then
    val == "truecolor" || val == "24bit"
  when Option::None then
    # Check TERM
    match std::env::get_env("TERM")
    when Option::Some(term) then
      term.contains("256color") || term.contains("xterm") || term == "screen-256color"
    when Option::None then
      is_stdout_terminal()
    end
  end
end

def supports_true_color() -> Bool
  match std::env::get_env("COLORTERM")
  when Option::Some(val) then val == "truecolor" || val == "24bit"
  when Option::None then false
  end
end

def color_depth() -> UInt
  if supports_true_color() then
    24
  else if supports_color() then
    256
  else if is_stdout_terminal() then
    16
  else
    0
  end
end

# ═══════════════════════════════════════════════════════════════
# Terminal Bell
# ═══════════════════════════════════════════════════════════════

def bell() -> Unit
  print("\x07")
  std::io::stdout().flush()
end

# ═══════════════════════════════════════════════════════════════
# Line Editing
# ═══════════════════════════════════════════════════════════════

struct LineEditor
  buffer: String
  cursor: UInt
  prompt: String
  history: Vec[String]
  history_index: Option[UInt]
}

def LineEditor::new(prompt: String) -> LineEditor
  LineEditor {
    buffer: "",
    cursor: 0,
    prompt: prompt,
    history: Vec::new(),
    history_index: Option::None
  }
end

def LineEditor::with_history(sink self: LineEditor, history: Vec[String]) -> LineEditor
  self.history = history
  self
end

def LineEditor::read_line(inout self: LineEditor) -> Result[String, String]
  print(self.prompt)
  std::io::stdout().flush()
  
  match enable_raw_mode(STDIN_FILENO())
  when Result::Ok(guard) then
    loop
      match read_key()
      when Result::Ok(key) then
        match key
        when Key::Enter then
          println!()
          let result = self.buffer.clone()
          self.buffer = ""
          self.cursor = 0
          let _ = guard.disable()
          return Result::Ok(result)
        when Key::Char(ch) then
          self.insert_char(ch)
          self.redraw()
        when Key::Backspace then
          self.backspace()
          self.redraw()
        when Key::Delete then
          self.delete()
          self.redraw()
        when Key::Left then
          self.move_left()
          self.redraw()
        when Key::Right then
          self.move_right()
          self.redraw()
        when Key::Home then
          self.cursor = 0
          self.redraw()
        when Key::End then
          self.cursor = self.buffer.len()
          self.redraw()
        when Key::Escape then
          let _ = guard.disable()
          return Result::Err("Cancelled".to_string())
        else ()
        end
      when Result::Err(e) then
        let _ = guard.disable()
        return Result::Err(e)
      end
    end
  when Result::Err(e) then Result::Err(e)
  end
end

def LineEditor::insert_char(inout self: LineEditor, ch: char) -> Unit
  if self.cursor >= self.buffer.len() then
    self.buffer = self.buffer + ch.to_string()
  else
    let before = self.buffer[0..self.cursor]
    let after = self.buffer[self.cursor..self.buffer.len()]
    self.buffer = before + ch.to_string() + after
  end
  self.cursor = self.cursor + 1
end

def LineEditor::backspace(inout self: LineEditor) -> Unit
  if self.cursor > 0 then
    let before = self.buffer[0..self.cursor - 1]
    let after = self.buffer[self.cursor..self.buffer.len()]
    self.buffer = before + after
    self.cursor = self.cursor - 1
  end
end

def LineEditor::delete(inout self: LineEditor) -> Unit
  if self.cursor < self.buffer.len() then
    let before = self.buffer[0..self.cursor]
    let after = self.buffer[self.cursor + 1..self.buffer.len()]
    self.buffer = before + after
  end
end

def LineEditor::move_left(inout self: LineEditor) -> Unit
  if self.cursor > 0 then
    self.cursor = self.cursor - 1
  end
end

def LineEditor::move_right(inout self: LineEditor) -> Unit
  if self.cursor < self.buffer.len() then
    self.cursor = self.cursor + 1
  end
end

def LineEditor::redraw(self: LineEditor) -> Unit
  # Move to beginning of line, clear, redraw
  let prompt_len = self.prompt.len()
  print("\r" + clear_line_right())
  print(self.prompt)
  print(self.buffer)
  
  # Position cursor
  let target = prompt_len + self.cursor
  print(move_to_first_column())
  if target > 0 then
    print(move_right(target))
  end
  
  std::io::stdout().flush()
end

# ═══════════════════════════════════════════════════════════════
# Terminal Info
# ═══════════════════════════════════════════════════════════════

struct TerminalInfo
  rows: UInt
  cols: UInt
  color_depth: UInt
  is_terminal: Bool
  supports_true_color: Bool
end

def info() -> TerminalInfo
  let s = size()
  
  TerminalInfo {
    rows: match s when Option::Some(size) then size.rows when Option::None then 24 end,
    cols: match s when Option::Some(size) then size.cols when Option::None then 80 end,
    color_depth: color_depth(),
    is_terminal: is_stdout_terminal(),
    supports_true_color: supports_true_color()
  }
end

# ═══════════════════════════════════════════════════════════════
# Menu Selection
# ═══════════════════════════════════════════════════════════════

struct Menu[T]
  items: Vec[(String, T)]
  selected: UInt
  prompt: String
end

def Menu::new[T](items: Vec[(String, T)]) -> Menu[T]
  Menu {
    items: items,
    selected: 0,
    prompt: "Select an option:"
  }
end

def Menu::prompt(sink self: Menu[T], p: String) -> Menu[T]
  self.prompt = p
  self
end

def Menu::select(inout self: Menu[T]) -> Result[T, String]
  if self.items.len() == 0 then
    return Result::Err("No items to select".to_string())
  end
  
  match enable_raw_mode(STDIN_FILENO())
  when Result::Ok(guard) then
    self.render()
    
    loop
      match read_key()
      when Result::Ok(key) then
        match key
        when Key::Up then
          if self.selected > 0 then
            self.selected = self.selected - 1
          else
            self.selected = self.items.len() - 1
          end
          self.render()
        when Key::Down then
          self.selected = (self.selected + 1) % self.items.len()
          self.render()
        when Key::Enter then
          let _ = guard.disable()
          self.clear()
          return Result::Ok(self.items[self.selected].1.clone())
        when Key::Escape then
          let _ = guard.disable()
          self.clear()
          return Result::Err("Cancelled".to_string())
        else ()
        end
      when Result::Err(e) then
        let _ = guard.disable()
        return Result::Err(e)
      end
    end
  when Result::Err(e) then Result::Err(e)
  end
end

def Menu::render(self: Menu[T]) -> Unit
  # Clear previous render
  let lines = self.items.len() + 1
  print(move_up(lines as UInt) + clear_screen_down())
  
  # Print prompt
  println!(self.prompt)
  
  # Print items
  mut i = 0
  while i < self.items.len() do
    let label = self.items[i].0.clone()
    if i == self.selected then
      println!("> " + Style::new().fg(Color::Cyan).apply(&label))
    else
      println!("  " + label)
    end
    i = i + 1
  end
  
  std::io::stdout().flush()
end

def Menu::clear(self: Menu[T]) -> Unit
  let lines = self.items.len() + 1
  print(move_up(lines as UInt) + clear_screen_down())
  std::io::stdout().flush()
end

# ═══════════════════════════════════════════════════════════════
# Utility Functions
# ═══════════════════════════════════════════════════════════════

def print_at(row: UInt, col: UInt, text: String) -> Unit
  print(move_to(row, col) + text + save_cursor() + restore_cursor())
  std::io::stdout().flush()
end

def clear_and_print(text: String) -> Unit
  print(clear_screen() + move_to(1, 1) + text)
  std::io::stdout().flush()
end

def center_text(text: String) -> String
  match cols()
  when Option::Some(width) then
    let padding = (width - text.len()) / 2
    " ".repeat(padding) + text
  when Option::None then
    text
  end
end

def String.repeat(self: String, n: UInt) -> String
  mut result = ""
  mut i = 0
  while i < n do
    result = result + self
    i = i + 1
  end
  result
end