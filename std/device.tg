# Tangerine Standard Library — tg::device
# Device discovery and capability model across CPU/GPU/accelerators.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 14.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec, Map}
use std::gfx_errors::{Error, ErrorCode}

# [METADATA]
# module: tg::device
# status: alpha
# effects: [Device]
# capabilities: [Display]
# error_codes: [NotFound, PermissionDenied, Unsupported, Internal]

enum DeviceError
  NotFound(Error)
  PermissionDenied(Error)
  Unsupported(Error)
  Internal(Error)
end

impl DeviceError
  def message(self: &DeviceError) -> &String
    match self
    when DeviceError::NotFound(e) then &e.message
    when DeviceError::PermissionDenied(e) then &e.message
    when DeviceError::Unsupported(e) then &e.message
    when DeviceError::Internal(e) then &e.message
    end
  end

  def code(self: &DeviceError) -> ErrorCode
    match self
    when DeviceError::NotFound(_) then ErrorCode::InvalidArg
    when DeviceError::PermissionDenied(_) then ErrorCode::PermissionDenied
    when DeviceError::Unsupported(_) then ErrorCode::Unsupported
    when DeviceError::Internal(_) then ErrorCode::Internal
    end
  end
end

enum DeviceClass
  Cpu
  Gpu
  Accelerator
  Input
end

struct DeviceCapability
  name: String
  version: u32
  value: String # Serialized capability value
end

struct Device
  id: String
  class: DeviceClass
  name: String
  vendor_id: u32
  device_id: u32
  capabilities: Map[String, DeviceCapability]
end

struct DeviceProfile
  required_capabilities: Vec[String]
  min_compute_units: Option[Int]
end

def list_devices(class_filter: Option[DeviceClass]) -> Result[Vec[Device], DeviceError]
  # Reference implementation: returns discovered CPU and mock GPU/Accelerator.
  # Production backends query udev/sysfs (Linux), IOKit (macOS), Win32.
  let mut devices = Vec[Device].new()
  
  # CPU Discovery (Skeletal)
  let mut cpu_caps = Map[String, DeviceCapability].new()
  cpu_caps.insert("threads".to_string(), DeviceCapability { name: "threads".to_string(), version: 1, value: "8".to_string() })
  
  devices.push(Device {
    id: "cpu-0".to_string(),
    class: DeviceClass::Cpu,
    name: "System CPU".to_string(),
    vendor_id: 0,
    device_id: 0,
    capabilities: cpu_caps
  })
  
  # Mock GPU
  let mut gpu_caps = Map[String, DeviceCapability].new()
  gpu_caps.insert("vulkan".to_string(), DeviceCapability { name: "vulkan".to_string(), version: 120, value: "1.2".to_string() })
  
  devices.push(Device {
    id: "gpu-0".to_string(),
    class: DeviceClass::Gpu,
    name: "Integrated GPU".to_string(),
    vendor_id: 0x8086,
    device_id: 0x1234,
    capabilities: gpu_caps
  })
  
  Result::Ok(devices)
end

def select_device(profile: DeviceProfile) -> Result[Device, DeviceError]
  let devices = list_devices(Option::None)?
  
  # Deterministic selection policy based on profile
  let mut i = 0
  while i < devices.len() do
    let dev = devices.get(i)
    let mut all_satisfied = true
    
    let mut j = 0
    while j < profile.required_capabilities.len() do
      let cap_name = profile.required_capabilities.get(j)
      if !dev.capabilities.contains_key(&cap_name) then
        all_satisfied = false
        break
      end
      j = j + 1
    end
    
    if all_satisfied then
      _log_device_event(LogLevel::Info, "Selected device: " + dev.id)
      return Result::Ok(dev.clone())
    end
    i = i + 1
  end
  
  Result::Err(DeviceError::NotFound(Error::new(ErrorCode::InvalidArg, "No device matches profile".to_string())))
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

use std::time::{instant_now, duration_nanos}

def _log_device_event(level: LogLevel, msg: String) -> Unit
  match &GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::App,
      message: "[DEVICE] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then ()
  end
end
