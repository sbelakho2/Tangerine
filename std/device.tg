# Tangerine Standard Library — tg::device
# Device discovery and capability model across CPU/GPU/accelerators.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 14.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec, Map}
use std::gfx_errors::{Error, ErrorCode}

# [METADATA]
# module: tg::device
# status: alpha
# effects: [Device]
# capabilities: [Display]
# error_codes: [NotFound, PermissionDenied, Unsupported, Internal]

enum DeviceError
  NotFound(Error)
  PermissionDenied(Error)
  Unsupported(Error)
  Internal(Error)
end

impl DeviceError
  def message(self: &DeviceError) -> &String
    match self
    when DeviceError::NotFound(e) then &e.message
    when DeviceError::PermissionDenied(e) then &e.message
    when DeviceError::Unsupported(e) then &e.message
    when DeviceError::Internal(e) then &e.message
    end
  end

  def code(self: &DeviceError) -> ErrorCode
    match self
    when DeviceError::NotFound(_) then ErrorCode::InvalidArg
    when DeviceError::PermissionDenied(_) then ErrorCode::PermissionDenied
    when DeviceError::Unsupported(_) then ErrorCode::Unsupported
    when DeviceError::Internal(_) then ErrorCode::Internal
    end
  end
end

enum DeviceClass
  Cpu
  Gpu
  Accelerator
  Input
end

struct DeviceCapability
  name: String
  version: u32
  value: String # Serialized capability value
end

struct Device
  id: String
  class: DeviceClass
  name: String
  vendor_id: u32
  device_id: u32
  capabilities: Map[String, DeviceCapability]
end

struct DeviceProfile
  required_capabilities: Vec[String]
  min_compute_units: Option[Int]
end

def list_devices(class_filter: Option[DeviceClass]) -> Result[Vec[Device], DeviceError]
  # Discover real hardware via platform-specific introspection.
  let mut devices: Vec[Device] = Vec::new()
  
  # CPU Discovery — read /proc/cpuinfo on Linux, sysctl on macOS
  let cpu_info = _discover_cpu()
  devices.push(cpu_info)

  # GPU/Accelerator Discovery — read /sys/class/drm on Linux, IOKit on macOS
  let gpu_list = _discover_gpus()
  for gpu in gpu_list do
    devices.push(gpu)
  end

  # Apply class filter if provided
  match class_filter
  when Option::Some(cls) then
    let mut filtered = Vec::new()
    for dev in devices do
      if _device_class_eq(&dev.class, &cls) then
        filtered.push(dev)
      end
    end
    Result::Ok(filtered)
  when Option::None then Result::Ok(devices)
  end
end

def _device_class_eq(a: &DeviceClass, b: &DeviceClass) -> Bool
  match (a, b)
  when (DeviceClass::Cpu, DeviceClass::Cpu) then true
  when (DeviceClass::Gpu, DeviceClass::Gpu) then true
  when (DeviceClass::Accelerator, DeviceClass::Accelerator) then true
  when _ then false
  end
end

def _discover_cpu() -> Device
  let mut name = "System CPU".to_string()
  let mut threads = 1
  let mut caps: Map[String, DeviceCapability] = Map::new()

  # Try /proc/cpuinfo (Linux)
  match std::fs::read_to_string("/proc/cpuinfo".to_string())
  when Result::Ok(info) then
    let lines = info.lines()
    for line in lines do
      if line.starts_with("model name") then
        match line.find(": ") 
        when Option::Some(idx) then name = line[idx + 2..].trim().to_string()
        when Option::None then ()
        end
      elsif line.starts_with("processor") then
        threads = threads + 1
      end
    end
    # Last line increments one too many
    if threads > 1 then threads = threads - 1 end
  when Result::Err(_) then
    # Fallback: try sysctl on macOS
    match std::process::command_output("sysctl", ["-n", "machdep.cpu.brand_string"])
    when Result::Ok(out) then name = out.trim().to_string()
    when Result::Err(_) then ()
    end
    match std::process::command_output("sysctl", ["-n", "hw.ncpu"])
    when Result::Ok(out) then
      match out.trim().parse_int()
      when Result::Ok(n) then threads = n
      when Result::Err(_) then ()
      end
    when Result::Err(_) then ()
    end
  end

  caps.insert("threads".to_string(),
    DeviceCapability { name: "threads".to_string(), version: 1, value: threads.to_string() })

  Device {
    id: "cpu-0".to_string(),
    class: DeviceClass::Cpu,
    name: name,
    vendor_id: 0,
    device_id: 0,
    capabilities: caps
  }
end

def _discover_gpus() -> Vec[Device]
  let mut gpus = Vec::new()
  let mut gpu_idx = 0

  # Try /sys/class/drm on Linux for each card*
  match std::fs::list_dir("/sys/class/drm".to_string())
  when Result::Ok(entries) then
    for entry in entries do
      if entry.starts_with("card") == false then next end
      if entry.find("-").is_some() then next end
      let dev_path = "/sys/class/drm/" + entry + "/device"
      let mut gpu_name: String = entry.to_string()
      let mut vendor: u32 = 0
      let mut devid: u32 = 0
      let mut caps: Map[String, DeviceCapability] = Map::new()

      match std::fs::read_to_string(dev_path + "/vendor")
      when Result::Ok(v) then
        let trimmed = v.trim()
        if trimmed.starts_with("0x") then
          match _parse_hex(&trimmed[2..])
          when Option::Some(n) then vendor = n as u32
          when Option::None then ()
          end
        end
      when Result::Err(_) then ()
      end

      match std::fs::read_to_string(dev_path + "/device")
      when Result::Ok(v) then
        let trimmed = v.trim()
        if trimmed.starts_with("0x") then
          match _parse_hex(&trimmed[2..])
          when Option::Some(n) then devid = n as u32
          when Option::None then ()
          end
        end
      when Result::Err(_) then ()
      end

      # Try to get a better name from uevent
      match std::fs::read_to_string(dev_path + "/uevent")
      when Result::Ok(uevent) then
        for line in uevent.lines() do
          if line.starts_with("PCI_SLOT_NAME=") then
            gpu_name = "GPU [" + line[14..].trim().to_string() + "]"
          end
        end
      when Result::Err(_) then ()
      end

      # Detect Vulkan support
      match std::fs::list_dir("/usr/share/vulkan/icd.d")
      when Result::Ok(_) then
        caps.insert("vulkan".to_string(),
          DeviceCapability { name: "vulkan".to_string(), version: 100, value: "detected".to_string() })
      when Result::Err(_) then ()
      end

      gpus.push(Device {
        id: "gpu-" + gpu_idx.to_string(),
        class: DeviceClass::Gpu,
        name: gpu_name,
        vendor_id: vendor,
        device_id: devid,
        capabilities: caps
      })
      gpu_idx = gpu_idx + 1
    end
  when Result::Err(_) then
    # macOS: try system_profiler for GPU info
    match std::process::command_output("system_profiler", ["SPDisplaysDataType", "-detailLevel", "mini"])
    when Result::Ok(output) then
      for line in output.lines() do
        let trimmed = line.trim()
        if trimmed.starts_with("Chipset Model:") then
          let gpu_name = trimmed[15..].trim().to_string()
          let caps: Map[String, DeviceCapability] = Map::new()
          gpus.push(Device {
            id: "gpu-" + gpu_idx.to_string(),
            class: DeviceClass::Gpu,
            name: gpu_name,
            vendor_id: 0,
            device_id: 0,
            capabilities: caps
          })
          gpu_idx = gpu_idx + 1
        end
      end
    when Result::Err(_) then ()
    end
  end
  gpus
end

def _parse_hex(s: &str) -> Option[Int]
  let mut result = 0
  for ch in s.chars() do
    let digit = if ch >= '0' && ch <= '9' then (ch as Int) - ('0' as Int)
    elsif ch >= 'a' && ch <= 'f' then (ch as Int) - ('a' as Int) + 10
    elsif ch >= 'A' && ch <= 'F' then (ch as Int) - ('A' as Int) + 10
    else return Option::None
    end
    result = result * 16 + digit
  end
  Option::Some(result)
end

def select_device(profile: DeviceProfile) -> Result[Device, DeviceError]
  let devices = list_devices(Option::None)?
  
  # Deterministic selection policy based on profile
  let mut i = 0
  while i < devices.len() do
    let dev = devices.get(i)
    let mut all_satisfied = true
    
    let mut j = 0
    while j < profile.required_capabilities.len() do
      let cap_name = profile.required_capabilities.get(j)
      if !dev.capabilities.contains_key(&cap_name) then
        all_satisfied = false
        break
      end
      j = j + 1
    end
    
    if all_satisfied then
      _log_device_event(LogLevel::Info, "Selected device: " + dev.id)
      return Result::Ok(dev.clone())
    end
    i = i + 1
  end
  
  Result::Err(DeviceError::NotFound(Error::new(ErrorCode::InvalidArg, "No device matches profile".to_string())))
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

use std::time::{instant_now, duration_nanos}

def _log_device_event(level: LogLevel, msg: String) -> Unit
  match &GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::App,
      message: "[DEVICE] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then ()
  end
end
