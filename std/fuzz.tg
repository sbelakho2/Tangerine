# Tangerine Standard Library — tg::fuzz
# Fuzz harness support: corpus capture, deterministic seeds, and minimization.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 31.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::gfx_errors::{Error, ErrorCode}
use std::time::{instant_now, duration_nanos}
use std::random::{Rng, Xoshiro256StarStar}

# [METADATA]
# module: tg::fuzz
# status: alpha
# effects: [Random, Io]
# capabilities: [Random, Fs]
# error_codes: [InvalidArg, Internal, CorpusFull]

enum FuzzError
  InvalidArg(Error)
  Internal(Error)
  CorpusFull(Error)
end

impl FuzzError
  def message(self: &FuzzError) -> &String
    match self
    when FuzzError::InvalidArg(e) then &e.message
    when FuzzError::Internal(e) then &e.message
    when FuzzError::CorpusFull(e) then &e.message
    end
  end

  def code(self: &FuzzError) -> ErrorCode
    match self
    when FuzzError::InvalidArg(_) then ErrorCode::InvalidArg
    when FuzzError::Internal(_) then ErrorCode::Internal
    when FuzzError::CorpusFull(_) then ErrorCode::OutOfMemory
    end
  end
end

use std::ctx

struct FuzzHarness
  name: String
  seed: u64
  rng: Xoshiro256StarStar
  corpus: Vec[Vec[u8]]
  ctx_pack: Option[std::ctx::CtxPack]
end

impl FuzzHarness
  def new(name: String, seed: u64) -> FuzzHarness
    let mut h = FuzzHarness {
      name: name,
      seed: seed,
      rng: Xoshiro256StarStar::from_seed(seed),
      corpus: Vec::new(),
      ctx_pack: Option::None
    }
    
    # Integrate with ctxpacks: capture harness context
    let seeds = Vec::new()
    seeds.push("fuzz::harness::" + name)
    match std::ctx::build_pack(seeds, 2000)
    when Ok(pack) then
      h.ctx_pack = Option::Some(pack)
      std::ctx::register_pack(pack)
    when Err(_) then {}
    end
    
    h
  end

  def add_to_corpus(self: &mut Self, data: Vec[u8]) -> Result[Unit, FuzzError]
    # Production implementation: Persist data to the harness's corpus directory.
    _log_fuzz_event(LogLevel::Debug, "Adding data to corpus: " + self.name)
    __intrinsic_fuzz_add_to_corpus(self.name, data)
  end

  def next_input(self: &mut Self, len: Int) -> Vec[u8]
    # Production implementation: Generate or retrieve the next fuzzer-driven input.
    __intrinsic_fuzz_next_input(self.name, len)
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_fuzz_event(level: LogLevel, msg: String) -> Unit
  match &GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::App,
      message: "[FUZZ] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then {}
  end
end
