# Tangerine Standard Library — std::doc_gen
# Documentation Generator - Production Implementation
# NO PLACEHOLDERS - Full Doc Generation

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt}
use std::collections::{Map, Set}
use std::fs
use std::io

# ═══════════════════════════════════════════════════════════════
# Documentation Types
# ═══════════════════════════════════════════════════════════════

struct DocItem
  name: String
  kind: DocKind
  doc_string: Option[String]
  signature: String
  params: Vec[DocParam]
  return_type: Option[String]
  examples: Vec[DocExample]
  source_file: String
  source_line: UInt
  deprecated: Bool
  deprecation_message: Option[String]
  since_version: Option[String]
end

enum DocKind
  Function
  Struct
  Enum
  Trait
  Impl
  Constant
  TypeAlias
  Module
end

struct DocParam
  name: String
  type_annotation: Option[String]
  description: Option[String]
end

struct DocExample
  code: String
  description: Option[String]
end

struct DocModule
  name: String
  doc_string: Option[String]
  items: Vec[DocItem]
  submodules: Vec[DocModule]
end

# ═══════════════════════════════════════════════════════════════
# Configuration
# ═══════════════════════════════════════════════════════════════

struct DocConfig
  output_dir: String
  format: OutputFormat
  include_private: Bool
  include_examples: Bool
  include_source_links: Bool
  base_url: Option[String]
  theme: String
  generate_index: Bool
  generate_search: Bool
end

enum OutputFormat
  HTML
  Markdown
  JSON
  Rustdoc
end

def DocConfig::default() -> DocConfig
  DocConfig {
    output_dir: "docs".to_string(),
    format: OutputFormat::HTML,
    include_private: false,
    include_examples: true,
    include_source_links: true,
    base_url: Option::None,
    theme: "light".to_string(),
    generate_index: true,
    generate_search: true
  }
end

# ═══════════════════════════════════════════════════════════════
# Documentation Parser
# ═══════════════════════════════════════════════════════════════

struct DocParser
  source: String
  pos: UInt
  current_file: String
end

def DocParser::new(source: String, file: String) -> DocParser
  DocParser { source: source, pos: 0, current_file: file }
end

def DocParser::parse_module(&mut self) -> DocModule
  let mut items = Vec::new()
  let lines = self.source.split("\n")
  let mut current_doc = "".to_string()
  let mut i = 0
  
  while i < lines.len() do
    let line = lines[i].trim()
    
    # Collect doc comments
    if line.starts_with("# ") then
      current_doc = current_doc + line.slice(1, line.len()).trim() + "\n"
      i += 1
      continue
    end
    
    # Parse definitions
    if line.starts_with("def ") then
      let item = self.parse_function_doc(&lines, i, &current_doc)
      items.push(item)
      current_doc = "".to_string()
    elsif line.starts_with("struct ") then
      let item = self.parse_struct_doc(&lines, i, &current_doc)
      items.push(item)
      current_doc = "".to_string()
    elsif line.starts_with("enum ") then
      let item = self.parse_enum_doc(&lines, i, &current_doc)
      items.push(item)
      current_doc = "".to_string()
    elsif line.starts_with("trait ") then
      let item = self.parse_trait_doc(&lines, i, &current_doc)
      items.push(item)
      current_doc = "".to_string()
    elsif line.starts_with("impl ") then
      let item = self.parse_impl_doc(&lines, i, &current_doc)
      items.push(item)
      current_doc = "".to_string()
    elsif line.starts_with("const ") then
      let item = self.parse_const_doc(&lines, i, &current_doc)
      items.push(item)
      current_doc = "".to_string()
    elsif line.starts_with("type ") then
      let item = self.parse_type_doc(&lines, i, &current_doc)
      items.push(item)
      current_doc = "".to_string()
    else
      current_doc = "".to_string()
    end
    
    i += 1
  end
  
  let module_doc = self.extract_module_doc(&lines)
  
  DocModule {
    name: self.current_file.clone(),
    doc_string: if module_doc.len() > 0 then Option::Some(module_doc) else Option::None end,
    items: items,
    submodules: Vec::new()
  }
end

def DocParser::extract_module_doc(&self, lines: &Vec[String]) -> String
  let mut doc = "".to_string()
  
  # Look for module-level doc at the top
  for line in lines do
    let trimmed = line.trim()
    if trimmed.starts_with("#!") then
      # Shebang, skip
      continue
    elsif trimmed.starts_with("# ") then
      doc = doc + trimmed.slice(1, trimmed.len()).trim() + "\n"
    elsif trimmed.starts_with("#") && !trimmed.starts_with("#[") then
      doc = doc + trimmed.slice(1, trimmed.len()).trim() + "\n"
    elsif trimmed.len() > 0 && !trimmed.starts_with("#") then
      break
    end
  end
  
  doc.trim().to_string()
end

def DocParser::parse_function_doc(&self, lines: &Vec[String], start: UInt, doc: &String) -> DocItem
  let line = lines[start]
  let mut name = "".to_string()
  let mut sig = line.clone()
  let mut params = Vec::new()
  let mut ret_type = Option::None
  
  # Extract function name
  let parts = line.split_whitespace()
  if parts.len() >= 2 then
    name = parts[1].split("(")[0].clone()
  end
  
  # Parse parameters from signature
  let paren_start = line.find("(")
  match paren_start
  when Option::Some(idx) =>
    let paren_end = line.rfind(")")
    match paren_end
    when Option::Some(end) =>
      let param_str = line.slice(idx + 1, end)
      params = self.parse_params(&param_str)
    when Option::None => ()
    end
  when Option::None => ()
  end
  
  # Parse return type
  let arrow_idx = line.find("->")
  match arrow_idx
  when Option::Some(idx) =>
    ret_type = Option::Some(line.slice(idx + 2, line.len()).trim().to_string())
  when Option::None => ()
  end
  
  # Extract examples from doc
  let examples = self.extract_examples(doc)
  
  DocItem {
    name: name,
    kind: DocKind::Function,
    doc_string: if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
    signature: sig,
    params: params,
    return_type: ret_type,
    examples: examples,
    source_file: self.current_file.clone(),
    source_line: start,
    deprecated: doc.contains("@deprecated"),
    deprecation_message: self.extract_deprecation_message(doc),
    since_version: self.extract_since_version(doc)
  }
end

def DocParser::parse_params(&self, param_str: &String) -> Vec[DocParam]
  let mut params = Vec::new()
  if param_str.trim().len() == 0 then return params end
  
  let parts = param_str.split(",")
  for part in parts do
    let trimmed = part.trim()
    let colon_idx = trimmed.find(":")
    match colon_idx
    when Option::Some(idx) =>
      let name = trimmed.slice(0, idx).trim().to_string()
      let type_str = trimmed.slice(idx + 1, trimmed.len()).trim().to_string()
      params.push(DocParam { name: name, type_annotation: Option::Some(type_str), description: Option::None })
    when Option::None =>
      if trimmed.len() > 0 then
        params.push(DocParam { name: trimmed.clone(), type_annotation: Option::None, description: Option::None })
      end
    end
  end
  
  params
end

def DocParser::parse_struct_doc(&self, lines: &Vec[String], start: UInt, doc: &String) -> DocItem
  let line = lines[start]
  let name = line.split_whitespace()[1].clone().split("[")[0].clone()
  
  DocItem {
    name: name.clone(),
    kind: DocKind::Struct,
    doc_string: if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
    signature: line.clone(),
    params: Vec::new(),
    return_type: Option::None,
    examples: self.extract_examples(doc),
    source_file: self.current_file.clone(),
    source_line: start,
    deprecated: doc.contains("@deprecated"),
    deprecation_message: self.extract_deprecation_message(doc),
    since_version: self.extract_since_version(doc)
  }
end

def DocParser::parse_enum_doc(&self, lines: &Vec[String], start: UInt, doc: &String) -> DocItem
  let line = lines[start]
  let name = line.split_whitespace()[1].clone()
  
  DocItem {
    name: name.clone(),
    kind: DocKind::Enum,
    doc_string: if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
    signature: line.clone(),
    params: Vec::new(),
    return_type: Option::None,
    examples: self.extract_examples(doc),
    source_file: self.current_file.clone(),
    source_line: start,
    deprecated: doc.contains("@deprecated"),
    deprecation_message: self.extract_deprecation_message(doc),
    since_version: self.extract_since_version(doc)
  }
end

def DocParser::parse_trait_doc(&self, lines: &Vec[String], start: UInt, doc: &String) -> DocItem
  let line = lines[start]
  let name = line.split_whitespace()[1].clone()
  
  DocItem {
    name: name.clone(),
    kind: DocKind::Trait,
    doc_string: if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
    signature: line.clone(),
    params: Vec::new(),
    return_type: Option::None,
    examples: self.extract_examples(doc),
    source_file: self.current_file.clone(),
    source_line: start,
    deprecated: doc.contains("@deprecated"),
    deprecation_message: self.extract_deprecation_message(doc),
    since_version: self.extract_since_version(doc)
  }
end

def DocParser::parse_impl_doc(&self, lines: &Vec[String], start: UInt, doc: &String) -> DocItem
  let line = lines[start]
  let parts = line.split_whitespace()
  let name = if parts.len() >= 2 then parts[1].clone() else "impl".to_string() end
  
  DocItem {
    name: name.clone(),
    kind: DocKind::Impl,
    doc_string: if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
    signature: line.clone(),
    params: Vec::new(),
    return_type: Option::None,
    examples: Vec::new(),
    source_file: self.current_file.clone(),
    source_line: start,
    deprecated: false,
    deprecation_message: Option::None,
    since_version: Option::None
  }
end

def DocParser::parse_const_doc(&self, lines: &Vec[String], start: UInt, doc: &String) -> DocItem
  let line = lines[start]
  let name = line.split_whitespace()[1].clone()
  
  DocItem {
    name: name.clone(),
    kind: DocKind::Constant,
    doc_string: if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
    signature: line.clone(),
    params: Vec::new(),
    return_type: Option::None,
    examples: self.extract_examples(doc),
    source_file: self.current_file.clone(),
    source_line: start,
    deprecated: doc.contains("@deprecated"),
    deprecation_message: self.extract_deprecation_message(doc),
    since_version: self.extract_since_version(doc)
  }
end

def DocParser::parse_type_doc(&self, lines: &Vec[String], start: UInt, doc: &String) -> DocItem
  let line = lines[start]
  let name = line.split_whitespace()[1].clone()
  
  DocItem {
    name: name.clone(),
    kind: DocKind::TypeAlias,
    doc_string: if doc.len() > 0 then Option::Some(doc.clone()) else Option::None end,
    signature: line.clone(),
    params: Vec::new(),
    return_type: Option::None,
    examples: Vec::new(),
    source_file: self.current_file.clone(),
    source_line: start,
    deprecated: doc.contains("@deprecated"),
    deprecation_message: self.extract_deprecation_message(doc),
    since_version: self.extract_since_version(doc)
  }
end

def DocParser::extract_examples(&self, doc: &String) -> Vec[DocExample]
  let mut examples = Vec::new()
  let lines = doc.split("\n")
  let mut in_example = false
  let mut current_code = "".to_string()
  let mut current_desc = "".to_string()
  
  for line in lines do
    if line.contains("@example") then
      in_example = true
      current_desc = line.split("@example")[1].trim().to_string()
    elsif in_example then
      if line.starts_with("```") then
        if current_code.len() > 0 then
          examples.push(DocExample { code: current_code.trim().to_string(), description: if current_desc.len() > 0 then Option::Some(current_desc.clone()) else Option::None end })
          current_code = "".to_string()
          current_desc = "".to_string()
        end
        in_example = false
      else
        current_code = current_code + line + "\n"
      end
    end
  end
  
  examples
end

def DocParser::extract_deprecation_message(&self, doc: &String) -> Option[String]
  let lines = doc.split("\n")
  for line in lines do
    if line.contains("@deprecated") then
      let msg = line.split("@deprecated")[1].trim().to_string()
      if msg.len() > 0 then return Option::Some(msg) end
    end
  end
  Option::None
end

def DocParser::extract_since_version(&self, doc: &String) -> Option[String]
  let lines = doc.split("\n")
  for line in lines do
    if line.contains("@since") then
      let version = line.split("@since")[1].trim().to_string()
      if version.len() > 0 then return Option::Some(version) end
    end
  end
  Option::None
end

# ═══════════════════════════════════════════════════════════════
# HTML Generator
# ═══════════════════════════════════════════════════════════════

def generate_html(module: &DocModule, config: &DocConfig) -> String
  let mut html = "".to_string()
  
  html = html + "<!DOCTYPE html>\n"
  html = html + "<html lang=\"en\">\n"
  html = html + "<head>\n"
  html = html + "  <meta charset=\"UTF-8\">\n"
  html = html + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n"
  html = html + "  <title>" + module.name.clone() + " - Tangerine Documentation</title>\n"
  html = html + "  <style>\n"
  html = html + "    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 1200px; margin: 0 auto; padding: 20px; }\n"
  html = html + "    h1 { border-bottom: 2px solid #e67e22; padding-bottom: 10px; }\n"
  html = html + "    h2 { color: #e67e22; margin-top: 30px; }\n"
  html = html + "    pre { background: #f4f4f4; padding: 15px; border-radius: 5px; overflow-x: auto; }\n"
  html = html + "    code { font-family: 'Fira Code', monospace; }\n"
  html = html + "    .signature { background: #fff3e0; padding: 10px; border-left: 3px solid #e67e22; margin: 10px 0; }\n"
  html = html + "    .deprecated { background: #ffebee; border-left-color: #f44336; }\n"
  html = html + "    .doc-string { color: #555; line-height: 1.6; }\n"
  html = html + "    .param { margin: 5px 0; }\n"
  html = html + "    .param-name { font-weight: bold; color: #1976d2; }\n"
  html = html + "    .param-type { color: #7b1fa2; }\n"
  html = html + "    .example { background: #e8f5e9; padding: 15px; margin: 10px 0; border-radius: 5px; }\n"
  html = html + "    nav { background: #e67e22; color: white; padding: 15px; margin: -20px -20px 20px -20px; }\n"
  html = html + "    nav a { color: white; text-decoration: none; margin-right: 20px; }\n"
  html = html + "    .search-box { padding: 10px; margin: 10px 0; width: 100%; max-width: 400px; font-size: 16px; }\n"
  html = html + "  </style>\n"
  html = html + "</head>\n"
  html = html + "<body>\n"
  
  # Navigation
  html = html + "  <nav>\n"
  html = html + "    <a href=\"index.html\">Home</a>\n"
  html = html + "    <a href=\"#modules\">Modules</a>\n"
  html = html + "    <a href=\"#functions\">Functions</a>\n"
  html = html + "    <a href=\"#types\">Types</a>\n"
  html = html + "  </nav>\n"
  
  # Module header
  html = html + "  <h1>" + module.name.clone() + "</h1>\n"
  
  match module.doc_string
  when Option::Some(d) => html = html + "  <div class=\"doc-string\">" + d + "</div>\n"
  when Option::None => ()
  end
  
  # Search box
  if config.generate_search then
    html = html + "  <input type=\"text\" class=\"search-box\" placeholder=\"Search documentation...\" id=\"search\">\n"
  end
  
  # Group items by kind
  let functions = module.items.filter(|i| match i.kind when DocKind::Function => true else => false end)
  let structs = module.items.filter(|i| match i.kind when DocKind::Struct => true else => false end)
  let enums = module.items.filter(|i| match i.kind when DocKind::Enum => true else => false end)
  let traits = module.items.filter(|i| match i.kind when DocKind::Trait => true else => false end)
  
  # Functions section
  if functions.len() > 0 then
    html = html + "  <h2 id=\"functions\">Functions</h2>\n"
    for item in functions do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Structs section
  if structs.len() > 0 then
    html = html + "  <h2 id=\"types\">Structs</h2>\n"
    for item in structs do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Enums section
  if enums.len() > 0 then
    html = html + "  <h2>Enums</h2>\n"
    for item in enums do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Traits section
  if traits.len() > 0 then
    html = html + "  <h2>Traits</h2>\n"
    for item in traits do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Search script
  if config.generate_search then
    html = html + "  <script>\n"
    html = html + "    document.getElementById('search').addEventListener('input', function(e) {\n"
    html = html + "      const query = e.target.value.toLowerCase();\n"
    html = html + "      document.querySelectorAll('.item').forEach(function(item) {\n"
    html = html + "        const text = item.textContent.toLowerCase();\n"
    html = html + "        item.style.display = text.includes(query) ? 'block' : 'none';\n"
    html = html + "      });\n"
    html = html + "    });\n"
    html = html + "  </script>\n"
  end
  
  html = html + "</body>\n"
  html = html + "</html>\n"
  
  html
end

def generate_item_html(item: &DocItem, config: &DocConfig) -> String
  let mut html = "".to_string()
  
  html = html + "  <div class=\"item\" id=\"" + item.name.clone() + "\">\n"
  
  # Header with name
  let deprecation_class = if item.deprecated then " deprecated" else "" end
  html = html + "    <h3>" + item.name.clone()
  if item.deprecated then
    html = html + " <span style=\"color: #f44336;\">(Deprecated)</span>"
  end
  html = html + "</h3>\n"
  
  # Signature
  html = html + "    <div class=\"signature" + deprecation_class + "\">\n"
  html = html + "      <code>" + escape_html(&item.signature) + "</code>\n"
  html = html + "    </div>\n"
  
  # Deprecation message
  match item.deprecation_message
  when Option::Some(msg) =>
    html = html + "    <p style=\"color: #f44336;\"><strong>Deprecated:</strong> " + msg + "</p>\n"
  when Option::None => ()
  end
  
  # Documentation
  match item.doc_string
  when Option::Some(d) =>
    html = html + "    <div class=\"doc-string\">" + format_doc_string(d) + "</div>\n"
  when Option::None => ()
  end
  
  # Parameters
  if item.params.len() > 0 then
    html = html + "    <h4>Parameters</h4>\n"
    html = html + "    <ul>\n"
    for param in item.params do
      html = html + "      <li class=\"param\">\n"
      html = html + "        <span class=\"param-name\">" + param.name.clone() + "</span>"
      match param.type_annotation
      when Option::Some(t) => html = html + ": <span class=\"param-type\">" + t + "</span>"
      when Option::None => ()
      end
      match param.description
      when Option::Some(d) => html = html + " - " + d
      when Option::None => ()
      end
      html = html + "\n      </li>\n"
    end
    html = html + "    </ul>\n"
  end
  
  # Return type
  match item.return_type
  when Option::Some(t) =>
    html = html + "    <h4>Returns</h4>\n"
    html = html + "    <p><code>" + t + "</code></p>\n"
  when Option::None => ()
  end
  
  # Examples
  if item.examples.len() > 0 then
    html = html + "    <h4>Examples</h4>\n"
    for example in item.examples do
      html = html + "    <div class=\"example\">\n"
      match example.description
      when Option::Some(d) => html = html + "      <p>" + d + "</p>\n"
      when Option::None => ()
      end
      html = html + "      <pre><code>" + escape_html(&example.code) + "</code></pre>\n"
      html = html + "    </div>\n"
    end
  end
  
  # Source link
  if config.include_source_links then
    match config.base_url
    when Option::Some(base) =>
      html = html + "    <p><a href=\"" + base + "/" + item.source_file.clone() + "#L" + item.source_line.to_string() + "\">View source</a></p>\n"
    when Option::None =>
      html = html + "    <p><small>Defined in " + item.source_file.clone() + ":" + item.source_line.to_string() + "</small></p>\n"
    end
  end
  
  html = html + "  </div>\n"
  
  html
end

def escape_html(s: &String) -> String
  s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
end

def format_doc_string(doc: &String) -> String
  # Convert markdown-like formatting
  let mut result = doc.clone()
  result = result.replace("\n\n", "</p><p>")
  result = result.replace("\n", "<br>")
  "<p>".to_string() + result + "</p>"
end

# ═══════════════════════════════════════════════════════════════
# Markdown Generator
# ═══════════════════════════════════════════════════════════════

def generate_markdown(module: &DocModule, config: &DocConfig) -> String
  let mut md = "".to_string()
  
  md = md + "# " + module.name.clone() + "\n\n"
  
  match module.doc_string
  when Option::Some(d) => md = md + d + "\n\n"
  when Option::None => ()
  end
  
  # Table of contents
  md = md + "## Contents\n\n"
  for item in module.items do
    md = md + "- [" + item.name.clone() + "](#" + item.name.to_lowercase().replace(" ", "-") + ")\n"
  end
  md = md + "\n"
  
  # Items
  for item in module.items do
    md = md + generate_item_markdown(&item, config) + "\n"
  end
  
  md
end

def generate_item_markdown(item: &DocItem, config: &DocConfig) -> String
  let mut md = "".to_string()
  
  md = md + "## `" + item.name.clone() + "`\n\n"
  
  if item.deprecated then
    md = md + "> **Deprecated"
    match item.deprecation_message
    when Option::Some(msg) => md = md + ": " + msg
    when Option::None => ()
    end
    md = md + "**\n\n"
  end
  
  md = md + "```tangerine\n" + item.signature.clone() + "\n```\n\n"
  
  match item.doc_string
  when Option::Some(d) => md = md + d + "\n\n"
  when Option::None => ()
  end
  
  if item.params.len() > 0 then
    md = md + "### Parameters\n\n"
    for param in item.params do
      md = md + "- `" + param.name.clone() + "`"
      match param.type_annotation
      when Option::Some(t) => md = md + ": `" + t + "`"
      when Option::None => ()
      end
      md = md + "\n"
    end
    md = md + "\n"
  end
  
  match item.return_type
  when Option::Some(t) => md = md + "### Returns\n\n`" + t + "`\n\n"
  when Option::None => ()
  end
  
  if item.examples.len() > 0 then
    md = md + "### Examples\n\n"
    for example in item.examples do
      match example.description
      when Option::Some(d) => md = md + d + "\n\n"
      when Option::None => ()
      end
      md = md + "```tangerine\n" + example.code.clone() + "\n```\n\n"
    end
  end
  
  md
end

# ═══════════════════════════════════════════════════════════════
# JSON Generator
# ═══════════════════════════════════════════════════════════════

def generate_json(module: &DocModule) -> String
  let mut json = "{\n"
  json = json + "  \"name\": \"" + module.name.clone() + "\",\n"
  
  match module.doc_string
  when Option::Some(d) => json = json + "  \"doc\": \"" + escape_json_string(d) + "\",\n"
  when Option::None => json = json + "  \"doc\": null,\n"
  end
  
  json = json + "  \"items\": [\n"
  
  for (i, item) in module.items.enumerate() do
    if i > 0 then json = json + ",\n" end
    json = json + generate_item_json(&item)
  end
  
  json = json + "\n  ]\n"
  json = json + "}\n"
  
  json
end

def generate_item_json(item: &DocItem) -> String
  let mut json = "    {\n"
  json = json + "      \"name\": \"" + item.name.clone() + "\",\n"
  json = json + "      \"kind\": \"" + kind_to_string(&item.kind) + "\",\n"
  json = json + "      \"signature\": \"" + escape_json_string(&item.signature) + "\",\n"
  
  match item.doc_string
  when Option::Some(d) => json = json + "      \"doc\": \"" + escape_json_string(d) + "\",\n"
  when Option::None => json = json + "      \"doc\": null,\n"
  end
  
  json = json + "      \"deprecated\": " + if item.deprecated then "true" else "false" end + "\n"
  json = json + "    }"
  
  json
end

def kind_to_string(kind: &DocKind) -> String
  match kind
  when DocKind::Function => "function"
  when DocKind::Struct => "struct"
  when DocKind::Enum => "enum"
  when DocKind::Trait => "trait"
  when DocKind::Impl => "impl"
  when DocKind::Constant => "constant"
  when DocKind::TypeAlias => "type_alias"
  when DocKind::Module => "module"
  end
end

def escape_json_string(s: &String) -> String
  s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
end

# ═══════════════════════════════════════════════════════════════
# Public API
# ═══════════════════════════════════════════════════════════════

def generate_docs(source: &String, file: &String, config: &DocConfig) -> String
  let mut parser = DocParser::new(source.clone(), file.clone())
  let module = parser.parse_module()
  
  match config.format
  when OutputFormat::HTML => generate_html(&module, config)
  when OutputFormat::Markdown => generate_markdown(&module, config)
  when OutputFormat::JSON => generate_json(&module)
  when OutputFormat::Rustdoc => generate_markdown(&module, config)  # Similar format
  end
end

def generate_docs_for_file(path: &String, config: &DocConfig) -> Result[String, String]
  let source = match fs::read_to_string(path)
  when Result::Ok(s) => s
  when Result::Err(e) => return Result::Err("Failed to read file: ".to_string() + e)
  end
  
  Result::Ok(generate_docs(&source, path, config))
end

def generate_docs_for_dir(dir: &String, config: &DocConfig) -> Result[UInt, String]
  let mut count = 0u
  
  let entries = match fs::read_dir(dir)
  when Result::Ok(e) => e
  when Result::Err(e) => return Result::Err("Failed to read directory: ".to_string() + e)
  end
  
  for entry in entries do
    let path = entry.path()
    if path.ends_with(".tg") then
      let output = generate_docs_for_file(&path, config)?
      let output_path = config.output_dir.clone() + "/" + path.replace(".tg", match config.format
        when OutputFormat::HTML => ".html"
        when OutputFormat::Markdown => ".md"
        when OutputFormat::JSON => ".json"
        when OutputFormat::Rustdoc => ".md"
      end)
      
      fs::write(&output_path, &output)?
      count += 1
    end
  end
  
  # Generate index if configured
  if config.generate_index then
    let index = generate_index_html(dir, config)
    fs::write(&config.output_dir + "/index.html", &index)?
  end
  
  Result::Ok(count)
end

def generate_index_html(dir: &String, config: &DocConfig) -> String
  let mut html = "<!DOCTYPE html>\n<html>\n<head>\n"
  html = html + "<title>Tangerine Documentation</title>\n"
  html = html + "<style>body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }</style>\n"
  html = html + "</head>\n<body>\n"
  html = html + "<h1>Tangerine Documentation</h1>\n"
  html = html + "<h2>Modules</h2>\n<ul>\n"
  
  let entries = match fs::read_dir(dir) when Result::Ok(e) => e when Result::Err(_) => return html + "</ul>\n</body>\n</html>" end
  
  for entry in entries do
    let path = entry.path()
    if path.ends_with(".tg") then
      let name = path.filename().replace(".tg", "")
      html = html + "<li><a href=\"" + name + ".html\">" + name + "</a></li>\n"
    end
  end
  
  html = html + "</ul>\n</body>\n</html>\n"
  html
end