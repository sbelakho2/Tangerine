# Tangerine Standard Library — std::doc_gen
# Documentation Generator — the DATA MODEL + RENDERERS.
#
# The source-text PARSING fork is GONE: this module never re-parses
# source. The document model is populated from the compiler's
# AST/ResolvedProgram by tg_compiler/docgen.tg (which consumes the
# compiler's own lexer/parser and walks the parsed Program), and this
# the module renders the resulting DocModule to HTML / Markdown / JSON.
#
# The assembly API (DocModule::new / DocModule::add_item / DocItem::new)
# is the compiler-side entry: the extraction feeds DocItem values in
# here; the renderers are the only text production.

use std::core::{Option, String, Vec, Unit, Bool, UInt}

# ═══════════════════════════════════════════════════════════════
# Documentation Types
# ═══════════════════════════════════════════════════════════════

struct DocItem
  name: String
  kind: DocKind
  doc_string: Option[String]
  signature: String
  params: Vec[DocParam]
  return_type: Option[String]
  examples: Vec[DocExample]
  source_file: String
  source_line: UInt
  deprecated: Bool
  deprecation_message: Option[String]
  since_version: Option[String]
end

enum DocKind
  Function
  Struct
  Enum
  Trait
  Impl
  Constant
  TypeAlias
  Module
end

struct DocParam
  name: String
  type_annotation: Option[String]
  description: Option[String]
end

struct DocExample
  code: String
  description: Option[String]
end

struct DocModule
  name: String
  doc_string: Option[String]
  items: Vec[DocItem]
  submodules: Vec[DocModule]
end

# ═══════════════════════════════════════════════════════════════
# Assembly API (populated by the compiler-side extraction —
# tg_compiler/docgen.tg walks the AST and fills this model)
# ═══════════════════════════════════════════════════════════════

def DocModule::new(name: String, doc: Option[String]) -> DocModule
  DocModule {
    name: name,
    doc_string: doc,
    items: Vec::new(),
    submodules: Vec::new()
  }
end

def DocModule::add_item(inout self, item: DocItem) -> Unit
  self.items.push(item)
end

def DocItem::new(name: String, kind: DocKind, signature: String, doc: Option[String],
                 params: Vec[DocParam], return_type: Option[String], source_file: String,
                 source_line: UInt) -> DocItem
  DocItem {
    name: name,
    kind: kind,
    doc_string: doc,
    signature: signature,
    params: params,
    return_type: return_type,
    examples: Vec::new(),
    source_file: source_file,
    source_line: source_line,
    deprecated: false,
    deprecation_message: Option::None,
    since_version: Option::None
  }
end

def DocItem::with_doc_flags(inout self, doc: String) -> Unit
  self.deprecated = doc.contains("@deprecated")
  self.deprecation_message = extract_deprecation_message(doc)
  self.since_version = extract_since_version(doc)
  self.examples = extract_examples(doc)
end

def DocParam::new(name: String, type_annotation: Option[String]) -> DocParam
  DocParam { name: name, type_annotation: type_annotation, description: Option::None }
end

# ═══════════════════════════════════════════════════════════════
# Doc-comment helpers (operate on the DOC TEXT only — the compiler's
# extraction attaches the comment it read off the AST spans)
# ═══════════════════════════════════════════════════════════════

def extract_examples(doc: String) -> Vec[DocExample]
  let mut examples = Vec::new()
  let lines = doc.split("\n")
  let mut in_example = false
  let mut current_code = "".to_string()
  let mut current_desc = "".to_string()
  
  for line in lines do
    if line.contains("@example") then
      in_example = true
      current_desc = line.split("@example")[1].trim().to_string()
    elsif in_example then
      if line.starts_with("```") then
        if current_code.len() > 0 then
          examples.push(DocExample { code: current_code.trim().to_string(), description: if current_desc.len() > 0 then Option::Some(current_desc.clone()) else Option::None end })
          current_code = "".to_string()
          current_desc = "".to_string()
        end
        in_example = false
      else
        current_code = current_code + line + "\n"
      end
    end
  end
  
  examples
end

def extract_deprecation_message(doc: String) -> Option[String]
  let lines = doc.split("\n")
  for line in lines do
    if line.contains("@deprecated") then
      let msg = line.split("@deprecated")[1].trim().to_string()
      if msg.len() > 0 then return Option::Some(msg) end
    end
  end
  Option::None
end

def extract_since_version(doc: String) -> Option[String]
  let lines = doc.split("\n")
  for line in lines do
    if line.contains("@since") then
      let version = line.split("@since")[1].trim().to_string()
      if version.len() > 0 then return Option::Some(version) end
    end
  end
  Option::None
end

# ═══════════════════════════════════════════════════════════════
# Configuration
# ═══════════════════════════════════════════════════════════════

struct DocConfig
  output_dir: String
  format: OutputFormat
  include_private: Bool
  include_examples: Bool
  include_source_links: Bool
  base_url: Option[String]
  theme: String
  generate_index: Bool
  generate_search: Bool
end

enum OutputFormat
  HTML
  Markdown
  JSON
  Rustdoc
end

def DocConfig::default() -> DocConfig
  DocConfig {
    output_dir: "docs".to_string(),
    format: OutputFormat::HTML,
    include_private: false,
    include_examples: true,
    include_source_links: true,
    base_url: Option::None,
    theme: "light".to_string(),
    generate_index: true,
    generate_search: true
  }
end

# ═══════════════════════════════════════════════════════════════
# HTML Generator
# ═══════════════════════════════════════════════════════════════

def generate_html(doc_module: DocModule, config: DocConfig) -> String
  let mut html = "".to_string()
  
  html = html + "<!DOCTYPE html>\n"
  html = html + "<html lang=\"en\">\n"
  html = html + "<head>\n"
  html = html + "  <meta charset=\"UTF-8\">\n"
  html = html + "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n"
  html = html + "  <title>" + doc_module.name.clone() + " - Tangerine Documentation</title>\n"
  html = html + "  <style>\n"
  html = html + "    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 1200px; margin: 0 auto; padding: 20px; }\n"
  html = html + "    h1 { border-bottom: 2px solid #e67e22; padding-bottom: 10px; }\n"
  html = html + "    h2 { color: #e67e22; margin-top: 30px; }\n"
  html = html + "    pre { background: #f4f4f4; padding: 15px; border-radius: 5px; overflow-x: auto; }\n"
  html = html + "    code { font-family: 'Fira Code', monospace; }\n"
  html = html + "    .signature { background: #fff3e0; padding: 10px; border-left: 3px solid #e67e22; margin: 10px 0; }\n"
  html = html + "    .deprecated { background: #ffebee; border-left-color: #f44336; }\n"
  html = html + "    .doc-string { color: #555; line-height: 1.6; }\n"
  html = html + "    .param { margin: 5px 0; }\n"
  html = html + "    .param-name { font-weight: bold; color: #1976d2; }\n"
  html = html + "    .param-type { color: #7b1fa2; }\n"
  html = html + "    .example { background: #e8f5e9; padding: 15px; margin: 10px 0; border-radius: 5px; }\n"
  html = html + "    nav { background: #e67e22; color: white; padding: 15px; margin: -20px -20px 20px -20px; }\n"
  html = html + "    nav a { color: white; text-decoration: none; margin-right: 20px; }\n"
  html = html + "    .search-box { padding: 10px; margin: 10px 0; width: 100%; max-width: 400px; font-size: 16px; }\n"
  html = html + "  </style>\n"
  html = html + "</head>\n"
  html = html + "<body>\n"
  
  # Navigation
  html = html + "  <nav>\n"
  html = html + "    <a href=\"index.html\">Home</a>\n"
  html = html + "    <a href=\"#modules\">Modules</a>\n"
  html = html + "    <a href=\"#functions\">Functions</a>\n"
  html = html + "    <a href=\"#types\">Types</a>\n"
  html = html + "  </nav>\n"
  
  # Module header
  html = html + "  <h1>" + doc_module.name.clone() + "</h1>\n"
  
  match doc_module.doc_string
  when Option::Some(d) => html = html + "  <div class=\"doc-string\">" + d + "</div>\n"
  when Option::None => ()
  end
  
  # Search box
  if config.generate_search then
    html = html + "  <input type=\"text\" class=\"search-box\" placeholder=\"Search documentation...\" id=\"search\">\n"
  end
  
  # Group items by kind
  let functions = doc_module.items.filter(|i| match i.kind when DocKind::Function => true else => false end)
  let structs = doc_module.items.filter(|i| match i.kind when DocKind::Struct => true else => false end)
  let enums = doc_module.items.filter(|i| match i.kind when DocKind::Enum => true else => false end)
  let traits = doc_module.items.filter(|i| match i.kind when DocKind::Trait => true else => false end)
  let impls = doc_module.items.filter(|i| match i.kind when DocKind::Impl => true else => false end)
  let constants = doc_module.items.filter(|i| match i.kind when DocKind::Constant => true else => false end)
  let aliases = doc_module.items.filter(|i| match i.kind when DocKind::TypeAlias => true else => false end)
  
  # Functions section
  if functions.len() > 0 then
    html = html + "  <h2 id=\"functions\">Functions</h2>\n"
    for item in functions do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Structs section
  if structs.len() > 0 then
    html = html + "  <h2 id=\"types\">Structs</h2>\n"
    for item in structs do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Enums section
  if enums.len() > 0 then
    html = html + "  <h2>Enums</h2>\n"
    for item in enums do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Traits section
  if traits.len() > 0 then
    html = html + "  <h2>Traits</h2>\n"
    for item in traits do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Impl blocks section
  if impls.len() > 0 then
    html = html + "  <h2>Impls</h2>\n"
    for item in impls do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Constants section
  if constants.len() > 0 then
    html = html + "  <h2>Constants</h2>\n"
    for item in constants do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Type aliases section
  if aliases.len() > 0 then
    html = html + "  <h2>Type Aliases</h2>\n"
    for item in aliases do
      html = html + generate_item_html(&item, config)
    end
  end
  
  # Search script
  if config.generate_search then
    html = html + "  <script>\n"
    html = html + "    document.getElementById('search').addEventListener('input', function(e) {\n"
    html = html + "      const query = e.target.value.toLowerCase();\n"
    html = html + "      document.querySelectorAll('.item').forEach(function(item) {\n"
    html = html + "        const text = item.textContent.toLowerCase();\n"
    html = html + "        item.style.display = text.includes(query) ? 'block' : 'none';\n"
    html = html + "      });\n"
    html = html + "    });\n"
    html = html + "  </script>\n"
  end
  
  html = html + "</body>\n"
  html = html + "</html>\n"
  
  html
end

def generate_item_html(item: DocItem, config: DocConfig) -> String
  let mut html = "".to_string()
  
  html = html + "  <div class=\"item\" id=\"" + item.name.clone() + "\">\n"
  
  # Header with name
  let deprecation_class = if item.deprecated then " deprecated" else "" end
  html = html + "    <h3>" + item.name.clone()
  if item.deprecated then
    html = html + " <span style=\"color: #f44336;\">(Deprecated)</span>"
  end
  html = html + "</h3>\n"
  
  # Signature
  html = html + "    <div class=\"signature" + deprecation_class + "\">\n"
  html = html + "      <code>" + escape_html(&item.signature) + "</code>\n"
  html = html + "    </div>\n"
  
  # Deprecation message
  match item.deprecation_message
  when Option::Some(msg) =>
    html = html + "    <p style=\"color: #f44336;\"><strong>Deprecated:</strong> " + msg + "</p>\n"
  when Option::None => ()
  end
  
  # Documentation
  match item.doc_string
  when Option::Some(d) =>
    html = html + "    <div class=\"doc-string\">" + format_doc_string(d) + "</div>\n"
  when Option::None => ()
  end
  
  # Parameters
  if item.params.len() > 0 then
    html = html + "    <h4>Parameters</h4>\n"
    html = html + "    <ul>\n"
    for param in item.params do
      html = html + "      <li class=\"param\">\n"
      html = html + "        <span class=\"param-name\">" + param.name.clone() + "</span>"
      match param.type_annotation
      when Option::Some(t) => html = html + ": <span class=\"param-type\">" + t + "</span>"
      when Option::None => ()
      end
      match param.description
      when Option::Some(d) => html = html + " - " + d
      when Option::None => ()
      end
      html = html + "\n      </li>\n"
    end
    html = html + "    </ul>\n"
  end
  
  # Return type
  match item.return_type
  when Option::Some(t) =>
    html = html + "    <h4>Returns</h4>\n"
    html = html + "    <p><code>" + t + "</code></p>\n"
  when Option::None => ()
  end
  
  # Examples
  if item.examples.len() > 0 then
    html = html + "    <h4>Examples</h4>\n"
    for example in item.examples do
      html = html + "    <div class=\"example\">\n"
      match example.description
      when Option::Some(d) => html = html + "      <p>" + d + "</p>\n"
      when Option::None => ()
      end
      html = html + "      <pre><code>" + escape_html(&example.code) + "</code></pre>\n"
      html = html + "    </div>\n"
    end
  end
  
  # Source link
  if config.include_source_links then
    match config.base_url
    when Option::Some(base) =>
      html = html + "    <p><a href=\"" + base + "/" + item.source_file.clone() + "#L" + item.source_line.to_string() + "\">View source</a></p>\n"
    when Option::None =>
      html = html + "    <p><small>Defined in " + item.source_file.clone() + ":" + item.source_line.to_string() + "</small></p>\n"
    end
  end
  
  html = html + "  </div>\n"
  
  html
end

def escape_html(s: String) -> String
  s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
end

def format_doc_string(doc: String) -> String
  # Convert markdown-like formatting
  let mut result = doc.clone()
  result = result.replace("\n\n", "</p><p>")
  result = result.replace("\n", "<br>")
  "<p>".to_string() + result + "</p>"
end

# ═══════════════════════════════════════════════════════════════
# Markdown Generator
# ═══════════════════════════════════════════════════════════════

def generate_markdown(doc_module: DocModule, config: DocConfig) -> String
  let mut md = "".to_string()
  
  md = md + "# " + doc_module.name.clone() + "\n\n"
  
  match doc_module.doc_string
  when Option::Some(d) => md = md + d + "\n\n"
  when Option::None => ()
  end
  
  # Table of contents
  md = md + "## Contents\n\n"
  for item in doc_module.items do
    md = md + "- [" + item.name.clone() + "](#" + item.name.to_lowercase().replace(" ", "-") + ")\n"
  end
  md = md + "\n"
  
  # Items
  for item in doc_module.items do
    md = md + generate_item_markdown(&item, config) + "\n"
  end
  
  md
end

def generate_item_markdown(item: DocItem, config: DocConfig) -> String
  let mut md = "".to_string()
  
  md = md + "## `" + item.name.clone() + "`\n\n"
  
  if item.deprecated then
    md = md + "> **Deprecated"
    match item.deprecation_message
    when Option::Some(msg) => md = md + ": " + msg
    when Option::None => ()
    end
    md = md + "**\n\n"
  end
  
  md = md + "```tangerine\n" + item.signature.clone() + "\n```\n\n"
  
  match item.doc_string
  when Option::Some(d) => md = md + d + "\n\n"
  when Option::None => ()
  end
  
  if item.params.len() > 0 then
    md = md + "### Parameters\n\n"
    for param in item.params do
      md = md + "- `" + param.name.clone() + "`"
      match param.type_annotation
      when Option::Some(t) => md = md + ": `" + t + "`"
      when Option::None => ()
      end
      md = md + "\n"
    end
    md = md + "\n"
  end
  
  match item.return_type
  when Option::Some(t) => md = md + "### Returns\n\n`" + t + "`\n\n"
  when Option::None => ()
  end
  
  if item.examples.len() > 0 then
    md = md + "### Examples\n\n"
    for example in item.examples do
      match example.description
      when Option::Some(d) => md = md + d + "\n\n"
      when Option::None => ()
      end
      md = md + "```tangerine\n" + example.code.clone() + "\n```\n\n"
    end
  end
  
  md
end

# ═══════════════════════════════════════════════════════════════
# JSON Generator
# ═══════════════════════════════════════════════════════════════

def generate_json(doc_module: DocModule) -> String
  let mut json = "{\n"
  json = json + "  \"name\": \"" + doc_module.name.clone() + "\",\n"
  
  match doc_module.doc_string
  when Option::Some(d) => json = json + "  \"doc\": \"" + escape_json_string(d) + "\",\n"
  when Option::None => json = json + "  \"doc\": null,\n"
  end
  
  json = json + "  \"items\": [\n"
  
  for (i, item) in doc_module.items.enumerate() do
    if i > 0 then json = json + ",\n" end
    json = json + generate_item_json(&item)
  end
  
  json = json + "\n  ]\n"
  json = json + "}\n"
  
  json
end

def generate_item_json(item: DocItem) -> String
  let mut json = "    {\n"
  json = json + "      \"name\": \"" + item.name.clone() + "\",\n"
  json = json + "      \"kind\": \"" + kind_to_string(&item.kind) + "\",\n"
  json = json + "      \"signature\": \"" + escape_json_string(&item.signature) + "\",\n"
  
  match item.doc_string
  when Option::Some(d) => json = json + "      \"doc\": \"" + escape_json_string(d) + "\",\n"
  when Option::None => json = json + "      \"doc\": null,\n"
  end
  
  json = json + "      \"deprecated\": " + if item.deprecated then "true" else "false" end + "\n"
  json = json + "    }"
  
  json
end

def kind_to_string(kind: DocKind) -> String
  match kind
  when DocKind::Function => "function"
  when DocKind::Struct => "struct"
  when DocKind::Enum => "enum"
  when DocKind::Trait => "trait"
  when DocKind::Impl => "impl"
  when DocKind::Constant => "constant"
  when DocKind::TypeAlias => "type_alias"
  when DocKind::Module => "doc_module"
  end  end  end
end

def escape_json_string(s: String) -> String
  s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
end

# ═══════════════════════════════════════════════════════════════
# Public API
# ═══════════════════════════════════════════════════════════════
# Renders a COMPILER-BUILT DocModule (the model populated from the
# AST/ResolvedProgram by tg_compiler/docgen.tg). No source text is
# accepted or parsed here.

def generate_docs(doc_module: DocModule, config: DocConfig) -> String
  match config.format
  when OutputFormat::HTML => generate_html(&doc_module, config)
  when OutputFormat::Markdown => generate_markdown(&doc_module, config)
  when OutputFormat::JSON => generate_json(&doc_module)
  when OutputFormat::Rustdoc => generate_markdown(&doc_module, config)  # Similar format
  end  end
end
