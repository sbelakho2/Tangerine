# std::cbor — CBOR (RFC 8949) binary serialization
# Concise Binary Object Representation for compact, efficient data interchange.
#
# RFC 8949 coverage: the full major-type matrix (unsigned/negative ints,
# byte/text strings, arrays, maps, tags, simple values, the float16/32/64
# forms) AND the indefinite-length forms (additional info 31: the
# indefinite byte/text string chunking, the indefinite array/map, the
# 0xFF break terminator) — decode-side fully implemented, encode-side
# via the explicit encode_indefinite_* forms (the definite forms remain
# the default, as RFC 8949 §3.2 permits either).

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::collections::{Map}
use std::gfx_errors::{Error, ErrorCode}

# ─── Value ───────────────────────────────────────────────────────────

enum Value
  UnsignedInt(UInt)
  NegativeInt(Int)
  ByteString(Vec[u8])
  TextString(String)
  Array(Vec[Value])
  Map(Vec[(Value, Value)])
  Tag(UInt, Box[Value])
  SimpleValue(u8)
  Float16(Float)
  Float32(Float)
  Float64(Float)
end

impl Value
  def null() -> Value
    Value::SimpleValue(22)
  end

  def undefined() -> Value
    Value::SimpleValue(23)
  end

  def bool_val(b: Bool) -> Value
    Value::SimpleValue(if b then 21 else 20 end)
  end

  def is_null(self: Value) -> Bool
    match self
    when Value::SimpleValue(22) then true
    else false
    end
  end

  def as_int(self: Value) -> Option[Int]
    match self
    when Value::UnsignedInt(u) then Option::Some(u as Int)
    when Value::NegativeInt(i) then Option::Some(i)
    else Option::None
    end
  end

  def as_str(self: Value) -> Option[String]
    match self
    when Value::TextString(s) then Option::Some(s.clone())
    else Option::None
    end
  end

  def as_bytes(self: Value) -> Option[Vec[u8]]
    match self
    when Value::ByteString(b) then Option::Some(b.clone())
    else Option::None
    end
  end

  def as_bool(self: Value) -> Option[Bool]
    match self
    when Value::SimpleValue(21) then Option::Some(true)
    when Value::SimpleValue(20) then Option::Some(false)
    else Option::None
    end
  end

  def as_float(self: Value) -> Option[Float]
    match self
    when Value::Float16(f) then Option::Some(f)
    when Value::Float32(f) then Option::Some(f)
    when Value::Float64(f) then Option::Some(f)
    when Value::UnsignedInt(u) then Option::Some(u as Float)
    when Value::NegativeInt(i) then Option::Some(i as Float)
    else Option::None
    end
  end

  def as_array(self: Value) -> Option[Vec[Value]]
    match self
    when Value::Array(a) then Option::Some(a.clone())
    else Option::None
    end
  end

  def as_map(self: Value) -> Option[Vec[(Value, Value)]]
    match self
    when Value::Map(m) then Option::Some(m.clone())
    else Option::None
    end
  end
end

# ─── Error ───────────────────────────────────────────────────────────

enum CborError
  UnexpectedEof
  InvalidMajorType(u8)
  InvalidAdditionalInfo(u8)
  UnexpectedBreak
  InvalidIndefiniteChunk
  InvalidUtf8
  NestedTooDeep
  TrailingData
  UnsupportedType(String)
  IoError(String)
end

def cbor_error_message(e: CborError) -> String
  match e
  when CborError::UnexpectedEof then "CBOR: unexpected end of input".to_string()
  when CborError::InvalidMajorType(t) then "CBOR: invalid major type " + (t as Int).to_string()
  when CborError::InvalidAdditionalInfo(i) then "CBOR: invalid additional info " + (i as Int).to_string()
  when CborError::UnexpectedBreak then "CBOR: break byte outside an indefinite-length context".to_string()
  when CborError::InvalidIndefiniteChunk then "CBOR: invalid chunk in an indefinite-length byte/text string".to_string()
  when CborError::InvalidUtf8 then "CBOR: invalid UTF-8 in text string".to_string()
  when CborError::NestedTooDeep then "CBOR: nesting too deep".to_string()
  when CborError::TrailingData then "CBOR: trailing data after value".to_string()
  when CborError::UnsupportedType(t) then "CBOR: unsupported type: " + t
  when CborError::IoError(msg) then "CBOR I/O error: " + msg
  end  end  end
end

# ─── Encoder ─────────────────────────────────────────────────────────

struct Encoder
  output: Vec[u8]
end

def encoder_new() -> Encoder
  Encoder { output: Vec::new() }
end

def encoder_with_capacity(cap: Int) -> Encoder
  Encoder { output: Vec::with_capacity(cap as UInt) }
end

impl Encoder
  def encode(inout self: Encoder, value: Value) -> Unit
    match value
    when Value::UnsignedInt(u) then self._write_type_value(0, u)
    when Value::NegativeInt(i) then
      if i >= 0 then
        self._write_type_value(0, i as UInt)
      else
        self._write_type_value(1, ((-1 - i) as UInt))
      end
    when Value::ByteString(bytes) then
      self._write_type_value(2, bytes.len() as UInt)
      for b in bytes do
        self.output.push(b)
      end
    when Value::TextString(s) then
      let bytes = s.as_bytes()
      self._write_type_value(3, bytes.len() as UInt)
      for b in bytes do
        self.output.push(b)
      end
    when Value::Array(items) then
      self._write_type_value(4, items.len() as UInt)
      for item in items do
        self.encode(&item)
      end
    when Value::Map(entries) then
      self._write_type_value(5, entries.len() as UInt)
      for entry in entries do
        let (key, val) = entry
        self.encode(&key)
        self.encode(&val)
      end
    when Value::Tag(tag, inner) then
      self._write_type_value(6, tag)
      self.encode(inner)
    when Value::SimpleValue(sv) then
      if sv < 24 then
        self.output.push((7 << 5) | sv)
      else
        self.output.push((7 << 5) | 24)
        self.output.push(sv)
      end
    when Value::Float16(f) then
      self.output.push((7 << 5) | 25)
      self._write_f16(f)
    when Value::Float32(f) then
      self.output.push((7 << 5) | 26)
      self._write_f32(f)
    when Value::Float64(f) then
      self.output.push((7 << 5) | 27)
      self._write_f64(f)
    end
  end

  def into_bytes(self: Encoder) -> Vec[u8]
    self.output
  end

  # The indefinite-length ENCODING forms (RFC 8949 §3.2): the definite
  # forms above remain the default (RFC 8949 permits either), and these
  # four emit the additional-info-31 headers with the 0xFF break
  # terminator explicitly — round-trippable through the decoder.

  def encode_indefinite_bytes(inout self: Encoder, chunks: Vec[Vec[u8]]) -> Unit
    self.output.push((2 << 5) | 31)
    for chunk in chunks do
      self._write_type_value(2, chunk.len() as UInt)
      for b in chunk do
        self.output.push(b)
      end
    end
    self.output.push(0xFF)
  end

  def encode_indefinite_text(inout self: Encoder, chunks: Vec[String]) -> Unit
    self.output.push((3 << 5) | 31)
    for chunk in chunks do
      let bytes = chunk.as_bytes()
      self._write_type_value(3, bytes.len() as UInt)
      for b in bytes do
        self.output.push(b)
      end
    end
    self.output.push(0xFF)
  end

  def encode_indefinite_array(inout self: Encoder, items: Vec[Value]) -> Unit
    self.output.push((4 << 5) | 31)
    for item in items do
      self.encode(&item)
    end
    self.output.push(0xFF)
  end

  def encode_indefinite_map(inout self: Encoder, entries: Vec[(Value, Value)]) -> Unit
    self.output.push((5 << 5) | 31)
    for entry in entries do
      let (key, val) = entry
      self.encode(&key)
      self.encode(&val)
    end
    self.output.push(0xFF)
  end

  def _write_type_value(inout self: Encoder, major: u8, value: UInt) -> Unit
    let mt = major << 5
    if value < 24 then
      self.output.push(mt | (value as u8))
    elsif value <= 0xFF then
      self.output.push(mt | 24)
      self.output.push(value as u8)
    elsif value <= 0xFFFF then
      self.output.push(mt | 25)
      self.output.push(((value >> 8) & 0xFF) as u8)
      self.output.push((value & 0xFF) as u8)
    elsif value <= 0xFFFFFFFF then
      self.output.push(mt | 26)
      let mut i = 0
      while i < 4 do
        self.output.push(((value >> ((3 - i) * 8)) & 0xFF) as u8)
        i = i + 1
      end
    else
      self.output.push(mt | 27)
      let mut i = 0
      while i < 8 do
        self.output.push(((value >> ((7 - i) * 8)) & 0xFF) as u8)
        i = i + 1
      end
    end
  end

  def _write_f16(inout self: Encoder, f: Float) -> Unit
    let bits = _float_to_f16_bits(f)
    self.output.push(((bits >> 8) & 0xFF) as u8)
    self.output.push((bits & 0xFF) as u8)
  end

  def _write_f32(inout self: Encoder, f: Float) -> Unit
    let bits = _float_to_f32_bits(f)
    let mut i = 0
    while i < 4 do
      self.output.push(((bits >> ((3 - i) * 8)) & 0xFF) as u8)
      i = i + 1
    end
  end

  def _write_f64(inout self: Encoder, f: Float) -> Unit
    let bits = _float_to_f64_bits(f)
    let mut i = 0
    while i < 8 do
      self.output.push(((bits >> ((7 - i) * 8)) & 0xFF) as u8)
      i = i + 1
    end
  end
end

# ─── Decoder ─────────────────────────────────────────────────────────

struct Decoder
  input: Vec[u8]
  pos: Int
  max_depth: Int
end

def decoder_new(input: Vec[u8]) -> Decoder
  Decoder { input: input, pos: 0, max_depth: 128 }
end

def decoder_with_max_depth(input: Vec[u8], max_depth: Int) -> Decoder
  Decoder { input: input, pos: 0, max_depth: max_depth }
end

impl Decoder
  def decode(inout self: Decoder) -> Result[Value, CborError]
    self._decode_value(0)
  end

  def decode_strict(inout self: Decoder) -> Result[Value, CborError]
    match self._decode_value(0)
    when Result::Ok(value) then
      if self.pos < self.input.len() as Int then
        Result::Err(CborError::TrailingData)
      else
        Result::Ok(value)
      end
    when Result::Err(e) then Result::Err(e)
    end
  end

  def _decode_value(inout self: Decoder, depth: Int) -> Result[Value, CborError]
    if depth > self.max_depth then return Result::Err(CborError::NestedTooDeep) end
    if self.pos >= self.input.len() as Int then return Result::Err(CborError::UnexpectedEof) end

    let initial = self._read_byte()?
    let major = (initial >> 5) & 0x07
    let additional = initial & 0x1F

    match major
    when 0 then
      let val = self._read_uint(additional)?
      Result::Ok(Value::UnsignedInt(val))
    when 1 then
      let val = self._read_uint(additional)?
      Result::Ok(Value::NegativeInt(-1 - (val as Int)))
    when 2 then
      if additional == 31 then
        self._decode_indefinite_bytes(depth)
      else
        let len = self._read_uint(additional)? as Int
        let bytes = self._read_bytes(len)?
        Result::Ok(Value::ByteString(bytes))
      end
    when 3 then
      if additional == 31 then
        self._decode_indefinite_text(depth)
      else
        let len = self._read_uint(additional)? as Int
        let bytes = self._read_bytes(len)?
        match String::from_utf8(bytes)
        when Result::Ok(s) then Result::Ok(Value::TextString(s))
        when Result::Err(_) then Result::Err(CborError::InvalidUtf8)
        end
      end
    when 4 then
      if additional == 31 then
        self._decode_indefinite_array(depth)
      else
        let count = self._read_uint(additional)? as Int
        let mut items = Vec::with_capacity(count as UInt)
        let mut i = 0
        while i < count do
          match self._decode_value(depth + 1)
          when Result::Ok(v) then items.push(v)
          when Result::Err(e) then return Result::Err(e)
          end
          i = i + 1
        end
        Result::Ok(Value::Array(items))
      end
    when 5 then
      if additional == 31 then
        self._decode_indefinite_map(depth)
      else
        let count = self._read_uint(additional)? as Int
        let mut entries = Vec::with_capacity(count as UInt)
        let mut i = 0
        while i < count do
          let key = self._decode_value(depth + 1)?
          let val = self._decode_value(depth + 1)?
          entries.push((key, val))
          i = i + 1
        end
        Result::Ok(Value::Map(entries))
      end
    when 6 then
      let tag = self._read_uint(additional)?
      let inner = self._decode_value(depth + 1)?
      Result::Ok(Value::Tag(tag, Box::new(inner)))
    when 7 then
      match additional
      when 20 then Result::Ok(Value::SimpleValue(20))
      when 21 then Result::Ok(Value::SimpleValue(21))
      when 22 then Result::Ok(Value::SimpleValue(22))
      when 23 then Result::Ok(Value::SimpleValue(23))
      when 24 then
        let sv = self._read_byte()?
        Result::Ok(Value::SimpleValue(sv))
      when 25 then
        let b0 = self._read_byte()? as UInt
        let b1 = self._read_byte()? as UInt
        let bits = (b0 << 8) | b1
        Result::Ok(Value::Float16(_f16_bits_to_float(bits)))
      when 26 then
        let mut bits: UInt = 0
        let mut i = 0
        while i < 4 do
          bits = (bits << 8) | (self._read_byte()? as UInt)
          i = i + 1
        end
        Result::Ok(Value::Float32(_f32_bits_to_float(bits)))
      when 27 then
        let mut bits: UInt = 0
        let mut i = 0
        while i < 8 do
          bits = (bits << 8) | (self._read_byte()? as UInt)
          i = i + 1
        end
        Result::Ok(Value::Float64(_f64_bits_to_float(bits)))
      when 31 then
        # The break byte (0xFF) is legal ONLY inside an indefinite-length
        # context; the indefinite decoders consume it themselves, so a
        # break that reaches _decode_value is an error.
        Result::Err(CborError::UnexpectedBreak)
      else
        if additional < 20 then
          Result::Ok(Value::SimpleValue(additional))
        else
          Result::Err(CborError::InvalidAdditionalInfo(additional))
        end
      end
    else
      Result::Err(CborError::InvalidMajorType(major))
    end
  end

  def _read_byte(inout self: Decoder) -> Result[u8, CborError]
    if self.pos >= self.input.len() as Int then return Result::Err(CborError::UnexpectedEof) end
    let b = self.input.get(self.pos as UInt)
    self.pos = self.pos + 1
    Result::Ok(b)
  end

  # The indefinite-length forms (RFC 8949 §3.2): additional info 31 with
  # the break byte (0xFF) terminator. The byte/text forms consist of
  # definite-length chunks of the SAME major type (an indefinite chunk or
  # a foreign major type inside is invalid); the array/map forms are
  # ordinary items terminated by the break.

  def _decode_indefinite_bytes(inout self: Decoder, depth: Int) -> Result[Value, CborError]
    # 0x5F ... 0xFF: the chunks are definite-length byte strings.
    let mut chunks = Vec::new()
    loop
      if self.pos >= self.input.len() as Int then return Result::Err(CborError::UnexpectedEof) end
      let initial = self.input.get(self.pos as UInt)
      if initial == 0xFF then
        self.pos = self.pos + 1
        break
      end
      match self._decode_value(depth + 1)
      when Result::Ok(Value::ByteString(b)) then chunks.push(b)
      when Result::Ok(_) then return Result::Err(CborError::InvalidIndefiniteChunk)
      when Result::Err(e) then return Result::Err(e)
      end
    end
    let mut result = Vec::new()
    for chunk in chunks do
      for b in chunk do
        result.push(b)
      end
    end
    Result::Ok(Value::ByteString(result))
  end

  def _decode_indefinite_text(inout self: Decoder, depth: Int) -> Result[Value, CborError]
    # 0x7F ... 0xFF: the chunks are definite-length text strings; the
    # concatenated bytes are validated as UTF-8 once, after the chunks.
    let mut chunks = Vec::new()
    loop
      if self.pos >= self.input.len() as Int then return Result::Err(CborError::UnexpectedEof) end
      let initial = self.input.get(self.pos as UInt)
      if initial == 0xFF then
        self.pos = self.pos + 1
        break
      end
      match self._decode_value(depth + 1)
      when Result::Ok(Value::TextString(s)) then chunks.push(s)
      when Result::Ok(_) then return Result::Err(CborError::InvalidIndefiniteChunk)
      when Result::Err(e) then return Result::Err(e)
      end
    end
    let mut bytes = Vec::new()
    for chunk in chunks do
      let chunk_bytes = chunk.as_bytes()
      for b in chunk_bytes do
        bytes.push(b)
      end
    end
    match String::from_utf8(bytes)
    when Result::Ok(s) then Result::Ok(Value::TextString(s))
    when Result::Err(_) then Result::Err(CborError::InvalidUtf8)
    end
  end

  def _decode_indefinite_array(inout self: Decoder, depth: Int) -> Result[Value, CborError]
    # 0x9F ... 0xFF: the items until the break.
    let mut items = Vec::new()
    loop
      if self.pos >= self.input.len() as Int then return Result::Err(CborError::UnexpectedEof) end
      let initial = self.input.get(self.pos as UInt)
      if initial == 0xFF then
        self.pos = self.pos + 1
        break
      end
      let item = self._decode_value(depth + 1)?
      items.push(item)
    end
    Result::Ok(Value::Array(items))
  end

  def _decode_indefinite_map(inout self: Decoder, depth: Int) -> Result[Value, CborError]
    # 0xBF ... 0xFF: the alternating key/value pairs until the break.
    let mut entries = Vec::new()
    loop
      if self.pos >= self.input.len() as Int then return Result::Err(CborError::UnexpectedEof) end
      let initial = self.input.get(self.pos as UInt)
      if initial == 0xFF then
        self.pos = self.pos + 1
        break
      end
      let key = self._decode_value(depth + 1)?
      let val = self._decode_value(depth + 1)?
      entries.push((key, val))
    end
    Result::Ok(Value::Map(entries))
  end

  def _read_bytes(inout self: Decoder, n: Int) -> Result[Vec[u8], CborError]
    if self.pos + n > self.input.len() as Int then return Result::Err(CborError::UnexpectedEof) end
    let mut result = Vec::with_capacity(n as UInt)
    let mut i = 0
    while i < n do
      result.push(self.input.get((self.pos + i) as UInt))
      i = i + 1
    end
    self.pos = self.pos + n
    Result::Ok(result)
  end

  def _read_uint(inout self: Decoder, additional: u8) -> Result[UInt, CborError]
    if additional < 24 then
      Result::Ok(additional as UInt)
    elsif additional == 24 then
      match self._read_byte()
      when Result::Ok(b) then Result::Ok(b as UInt)
      when Result::Err(e) then Result::Err(e)
      end
    elsif additional == 25 then
      let b0 = self._read_byte()? as UInt
      let b1 = self._read_byte()? as UInt
      Result::Ok((b0 << 8) | b1)
    elsif additional == 26 then
      let mut val: UInt = 0
      let mut i = 0
      while i < 4 do
        val = (val << 8) | (self._read_byte()? as UInt)
        i = i + 1
      end
      Result::Ok(val)
    elsif additional == 27 then
      let mut val: UInt = 0
      let mut i = 0
      while i < 8 do
        val = (val << 8) | (self._read_byte()? as UInt)
        i = i + 1
      end
      Result::Ok(val)
    else
      Result::Err(CborError::InvalidAdditionalInfo(additional))
    end
  end
end

# ─── Float conversion helpers ────────────────────────────────────────

extern "C"
  def memcpy(dst: Ptr[u8], src: Ptr[u8], n: UInt) -> Ptr[u8]
end

def _float_to_f64_bits(f: Float) -> UInt
  let mut bits: UInt = 0
  memcpy(address_of_mut(&mut bits) as Ptr[u8], address_of(&mut f) as Ptr[u8], 8)
  bits
end

def _f64_bits_to_float(bits: UInt) -> Float
  let mut f: Float = 0.0
  memcpy(address_of_mut(&mut f) as Ptr[u8], address_of(&mut bits) as Ptr[u8], 8)
  f
end

def _float_to_f32_bits(f: Float) -> UInt
  let f32_val = f as f32
  let mut bits: UInt = 0
  memcpy(address_of_mut(&mut bits) as Ptr[u8], address_of(&mut f32_val) as Ptr[u8], 4)
  bits & 0xFFFFFFFF
end

def _f32_bits_to_float(bits: UInt) -> Float
  let mut f32_val: f32 = 0.0
  let masked = bits & 0xFFFFFFFF
  memcpy(&mut f32_val as Ptr[u8], &masked as Ptr[u8], 4)
  f32_val as Float
end

def _float_to_f16_bits(f: Float) -> UInt
  let f32_bits = _float_to_f32_bits(f)
  let sign = (f32_bits >> 16) & 0x8000
  let exp = ((f32_bits >> 23) & 0xFF) as Int - 127 + 15
  let frac = (f32_bits >> 13) & 0x03FF
  if exp <= 0 then sign
  elsif exp >= 31 then sign | 0x7C00
  else sign | ((exp as UInt) << 10) | frac
  end
end

def _f16_bits_to_float(bits: UInt) -> Float
  let sign = (bits >> 15) & 1
  let exp = (bits >> 10) & 0x1F
  let frac = bits & 0x03FF
  let mut f: Float = 0.0
  if exp == 0 then
    f = (frac as Float) * (1.0 / 16777216.0)
  elsif exp == 31 then
    f = if frac == 0 then 1.0 / 0.0 else 0.0 / 0.0 end
  else
    f = ((frac as Float) / 1024.0 + 1.0) * std::math::pow(2.0, (exp as Float) - 15.0)
  end
  if sign == 1 then -f else f end
end

# ─── Convenience functions ───────────────────────────────────────────

def cbor_encode(value: Value) -> Vec[u8]
  let mut enc = encoder_new()
  enc.encode(value)
  enc.into_bytes()
end

def cbor_decode(bytes: Vec[u8]) -> Result[Value, CborError]
  let mut dec = decoder_new(bytes.clone())
  dec.decode()
end

def cbor_decode_strict(bytes: Vec[u8]) -> Result[Value, CborError]
  let mut dec = decoder_new(bytes.clone())
  dec.decode_strict()
end

# Structural equality over the CBOR Value tree (used by the RFC 8949
# vector tests; the definite vs indefinite distinction is NOT part of the
# value — an indefinite array decoded equals its definite encoding).
def cbor_value_eq(a: Value, b: Value) -> Bool
  match a
  when Value::UnsignedInt(x) then
    match b
    when Value::UnsignedInt(y) then x == y
    else false
    end
  when Value::NegativeInt(x) then
    match b
    when Value::NegativeInt(y) then x == y
    else false
    end
  when Value::ByteString(x) then
    match b
    when Value::ByteString(y) then _bytes_eq(x, y)
    else false
    end
  when Value::TextString(x) then
    match b
    when Value::TextString(y) then x == y
    else false
    end
  when Value::Array(x) then
    match b
    when Value::Array(y) then _value_vec_eq(x, y)
    else false
    end
  when Value::Map(x) then
    match b
    when Value::Map(y) then _map_eq(x, y)
    else false
    end
  when Value::Tag(t1, inner1) then
    match b
    when Value::Tag(t2, inner2) then
      t1 == t2 && cbor_value_eq(*inner1.get(), *inner2.get())
    else false
    end
  when Value::SimpleValue(x) then
    match b
    when Value::SimpleValue(y) then x == y
    else false
    end
  when Value::Float16(x) then
    match b
    when Value::Float16(y) then x == y
    else false
    end
  when Value::Float32(x) then
    match b
    when Value::Float32(y) then x == y
    else false
    end
  when Value::Float64(x) then
    match b
    when Value::Float64(y) then x == y
    else false
    end
  end  end
end

def _bytes_eq(x: Vec[u8], y: Vec[u8]) -> Bool
  if x.len() != y.len() then
    return false
  end
  var i = 0
  while i < x.len() do
    if x[i] != y[i] then
      return false
    end
    i = i + 1
  end
  true
end

def _value_vec_eq(x: Vec[Value], y: Vec[Value]) -> Bool
  if x.len() != y.len() then
    return false
  end
  var i = 0
  while i < x.len() do
    if !cbor_value_eq(x[i], y[i]) then
      return false
    end
    i = i + 1
  end
  true
end

def _map_eq(x: Vec[(Value, Value)], y: Vec[(Value, Value)]) -> Bool
  if x.len() != y.len() then
    return false
  end
  var i = 0
  while i < x.len() do
    let (xk, xv) = x[i]
    let (yk, yv) = y[i]
    if !cbor_value_eq(xk, yk) || !cbor_value_eq(xv, yv) then
      return false
    end
    i = i + 1
  end
  true
end