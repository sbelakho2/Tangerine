## std::cbor — CBOR (RFC 8949) binary serialization
## Concise Binary Object Representation for compact, efficient data interchange.
## Spec: §stdlib.cbor

module std::cbor

use std::core::{Option, Result, Display}
use std::collections::{Array, Map}
use std::serde::{Serialize, Deserialize, Serializer, Deserializer}

# ─── Value ───────────────────────────────────────────────────────────

pub enum Value
  UnsignedInt(UInt)
  NegativeInt(Int)
  ByteString(Vec[u8])
  TextString(String)
  Array(Vec[Value])
  Map(Vec[(Value, Value)])
  Tag(UInt, Box[Value])
  SimpleValue(u8)       ## includes true(20), false(21), null(22), undefined(23)
  Float16(Float)
  Float32(Float)
  Float64(Float)
end

impl Value
  pub def null() -> Value = Value.SimpleValue(22)
  pub def undefined() -> Value = Value.SimpleValue(23)
  pub def bool(b: Bool) -> Value = Value.SimpleValue(if b then 21 else 20 end)

  pub def is_null(self) -> Bool
    match self
    when Value.SimpleValue(22) then true
    else false
    end
  end

  pub def as_int(self) -> Option[Int]
    match self
    when Value.UnsignedInt(u) then Some(u as Int)
    when Value.NegativeInt(i) then Some(i)
    else None
    end
  end

  pub def as_str(self) -> Option[&String]
    match self
    when Value.TextString(ref s) then Some(s)
    else None
    end
  end

  pub def as_bytes(self) -> Option[&Vec[u8]]
    match self
    when Value.ByteString(ref b) then Some(b)
    else None
    end
  end

  pub def as_bool(self) -> Option[Bool]
    match self
    when Value.SimpleValue(21) then Some(true)
    when Value.SimpleValue(20) then Some(false)
    else None
    end
  end

  pub def as_float(self) -> Option[Float]
    match self
    when Value.Float16(f) then Some(f)
    when Value.Float32(f) then Some(f)
    when Value.Float64(f) then Some(f)
    when Value.UnsignedInt(u) then Some(u as Float)
    when Value.NegativeInt(i) then Some(i as Float)
    else None
    end
  end

  pub def as_array(self) -> Option[&Vec[Value]]
    match self
    when Value.Array(ref a) then Some(a)
    else None
    end
  end

  pub def as_map(self) -> Option[&Vec[(Value, Value)]>
    match self
    when Value.Map(ref m) then Some(m)
    else None
    end
  end
end

# ─── Error ───────────────────────────────────────────────────────────

pub enum CborError
  UnexpectedEof
  InvalidMajorType(u8)
  InvalidAdditionalInfo(u8)
  InvalidUtf8
  NestedTooDeep
  TrailingData
  UnsupportedType(String)
  IoError(String)
end

impl Display for CborError
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    match self
    when CborError.UnexpectedEof then f.write_str("CBOR: unexpected end of input")
    when CborError.InvalidMajorType(t) then f.write_str("CBOR: invalid major type " + t.to_string())
    when CborError.InvalidAdditionalInfo(i) then f.write_str("CBOR: invalid additional info " + i.to_string())
    when CborError.InvalidUtf8 then f.write_str("CBOR: invalid UTF-8 in text string")
    when CborError.NestedTooDeep then f.write_str("CBOR: nesting too deep")
    when CborError.TrailingData then f.write_str("CBOR: trailing data after value")
    when CborError.UnsupportedType(t) then f.write_str("CBOR: unsupported type: " + t)
    when CborError.IoError(msg) then f.write_str("CBOR I/O error: " + msg)
    end
  end
end

# ─── Encoder ─────────────────────────────────────────────────────────

pub struct Encoder
  output: Vec[u8]
end

impl Encoder
  pub def new() -> Encoder
    Encoder { output: Vec[u8].new() }
  end

  pub def with_capacity(cap: Int) -> Encoder
    Encoder { output: Vec[u8].with_capacity(cap as UInt) }
  end

  pub def encode(&mut self, value: &Value) -> Unit
    match value
    when Value.UnsignedInt(u) then self._write_type_value(0, *u)
    when Value.NegativeInt(i) then
      if *i >= 0 then
        self._write_type_value(0, *i as UInt)
      else
        self._write_type_value(1, ((-1 - *i) as UInt))
      end
    when Value.ByteString(ref bytes) then
      self._write_type_value(2, bytes.len() as UInt)
      self.output.extend(bytes)
    when Value.TextString(ref s) then
      let bytes = s.as_bytes()
      self._write_type_value(3, bytes.len() as UInt)
      self.output.extend(&bytes)
    when Value.Array(ref items) then
      self._write_type_value(4, items.len() as UInt)
      for item in items do
        self.encode(item)
      end
    when Value.Map(ref entries) then
      self._write_type_value(5, entries.len() as UInt)
      for (key, val) in entries do
        self.encode(key)
        self.encode(val)
      end
    when Value.Tag(tag, ref inner) then
      self._write_type_value(6, *tag)
      self.encode(inner)
    when Value.SimpleValue(sv) then
      if *sv < 24 then
        self.output.push((7 << 5) | *sv)
      else
        self.output.push((7 << 5) | 24)
        self.output.push(*sv)
      end
    when Value.Float16(f) then
      self.output.push((7 << 5) | 25)
      self._write_f16(*f)
    when Value.Float32(f) then
      self.output.push((7 << 5) | 26)
      self._write_f32(*f)
    when Value.Float64(f) then
      self.output.push((7 << 5) | 27)
      self._write_f64(*f)
    end
  end

  pub def into_bytes(self) -> Vec[u8] = self.output

  def _write_type_value(&mut self, major: u8, value: UInt) -> Unit
    let mt = major << 5
    if value < 24 then
      self.output.push(mt | (value as u8))
    elsif value <= 0xFF then
      self.output.push(mt | 24)
      self.output.push(value as u8)
    elsif value <= 0xFFFF then
      self.output.push(mt | 25)
      self.output.push(((value >> 8) & 0xFF) as u8)
      self.output.push((value & 0xFF) as u8)
    elsif value <= 0xFFFFFFFF then
      self.output.push(mt | 26)
      for i in (0..4).rev() do
        self.output.push(((value >> (i * 8)) & 0xFF) as u8)
      end
    else
      self.output.push(mt | 27)
      for i in (0..8).rev() do
        self.output.push(((value >> (i * 8)) & 0xFF) as u8)
      end
    end
  end

  def _write_f16(&mut self, f: Float) -> Unit
    ## Simplified: convert via f32 intermediary
    let bits = _float_to_f16_bits(f)
    self.output.push(((bits >> 8) & 0xFF) as u8)
    self.output.push((bits & 0xFF) as u8)
  end

  def _write_f32(&mut self, f: Float) -> Unit
    let bits = _float_to_f32_bits(f)
    for i in (0..4).rev() do
      self.output.push(((bits >> (i * 8)) & 0xFF) as u8)
    end
  end

  def _write_f64(&mut self, f: Float) -> Unit
    let bits = _float_to_f64_bits(f)
    for i in (0..8).rev() do
      self.output.push(((bits >> (i * 8)) & 0xFF) as u8)
    end
  end
end

# ─── Decoder ─────────────────────────────────────────────────────────

pub struct Decoder
  input: Vec[u8]
  pos: Int
  max_depth: Int
end

impl Decoder
  pub def new(input: Vec[u8]) -> Decoder
    Decoder { input: input, pos: 0, max_depth: 128 }
  end

  pub def with_max_depth(input: Vec[u8], max_depth: Int) -> Decoder
    Decoder { input: input, pos: 0, max_depth: max_depth }
  end

  pub def decode(&mut self) -> Result[Value, CborError]
    self._decode_value(0)
  end

  pub def decode_strict(&mut self) -> Result[Value, CborError]
    let value = self._decode_value(0)?
    if self.pos < self.input.len() as Int then
      return Err(CborError.TrailingData)
    end
    Ok(value)
  end

  def _decode_value(&mut self, depth: Int) -> Result[Value, CborError]
    if depth > self.max_depth then return Err(CborError.NestedTooDeep) end
    if self.pos >= self.input.len() as Int then return Err(CborError.UnexpectedEof) end

    let initial = self._read_byte()?
    let major = (initial >> 5) & 0x07
    let additional = initial & 0x1F

    match major
    when 0 then  ## unsigned integer
      let val = self._read_uint(additional)?
      Ok(Value.UnsignedInt(val))
    when 1 then  ## negative integer
      let val = self._read_uint(additional)?
      Ok(Value.NegativeInt(-1 - (val as Int)))
    when 2 then  ## byte string
      let len = self._read_uint(additional)? as Int
      let bytes = self._read_bytes(len)?
      Ok(Value.ByteString(bytes))
    when 3 then  ## text string
      let len = self._read_uint(additional)? as Int
      let bytes = self._read_bytes(len)?
      match String.from_utf8(bytes)
      when Ok(s) then Ok(Value.TextString(s))
      when Err(_) then Err(CborError.InvalidUtf8)
      end
    when 4 then  ## array
      let count = self._read_uint(additional)? as Int
      var items = Vec[Value].with_capacity(count as UInt)
      for _ in 0..count do
        items.push(self._decode_value(depth + 1)?)
      end
      Ok(Value.Array(items))
    when 5 then  ## map
      let count = self._read_uint(additional)? as Int
      var entries = Vec[(Value, Value)].with_capacity(count as UInt)
      for _ in 0..count do
        let key = self._decode_value(depth + 1)?
        let val = self._decode_value(depth + 1)?
        entries.push((key, val))
      end
      Ok(Value.Map(entries))
    when 6 then  ## tag
      let tag = self._read_uint(additional)?
      let inner = self._decode_value(depth + 1)?
      Ok(Value.Tag(tag, Box.new(inner)))
    when 7 then  ## simple/float
      match additional
      when 20 then Ok(Value.SimpleValue(20))  ## false
      when 21 then Ok(Value.SimpleValue(21))  ## true
      when 22 then Ok(Value.SimpleValue(22))  ## null
      when 23 then Ok(Value.SimpleValue(23))  ## undefined
      when 24 then
        let sv = self._read_byte()?
        Ok(Value.SimpleValue(sv))
      when 25 then  ## float16
        let b0 = self._read_byte()? as UInt
        let b1 = self._read_byte()? as UInt
        let bits = (b0 << 8) | b1
        Ok(Value.Float16(_f16_bits_to_float(bits)))
      when 26 then  ## float32
        var bits: UInt = 0
        for _ in 0..4 do
          bits = (bits << 8) | (self._read_byte()? as UInt)
        end
        Ok(Value.Float32(_f32_bits_to_float(bits)))
      when 27 then  ## float64
        var bits: UInt = 0
        for _ in 0..8 do
          bits = (bits << 8) | (self._read_byte()? as UInt)
        end
        Ok(Value.Float64(_f64_bits_to_float(bits)))
      else
        if additional < 20 then
          Ok(Value.SimpleValue(additional))
        else
          Err(CborError.InvalidAdditionalInfo(additional))
        end
      end
    else
      Err(CborError.InvalidMajorType(major))
    end
  end

  def _read_byte(&mut self) -> Result[u8, CborError]
    if self.pos >= self.input.len() as Int then return Err(CborError.UnexpectedEof) end
    let b = self.input[self.pos as UInt]
    self.pos = self.pos + 1
    Ok(b)
  end

  def _read_bytes(&mut self, n: Int) -> Result[Vec[u8], CborError]
    if self.pos + n > self.input.len() as Int then return Err(CborError.UnexpectedEof) end
    var result = Vec[u8].with_capacity(n as UInt)
    for i in 0..n do
      result.push(self.input[(self.pos + i) as UInt])
    end
    self.pos = self.pos + n
    Ok(result)
  end

  def _read_uint(&mut self, additional: u8) -> Result[UInt, CborError]
    if additional < 24 then
      Ok(additional as UInt)
    elsif additional == 24 then
      Ok(self._read_byte()? as UInt)
    elsif additional == 25 then
      let b0 = self._read_byte()? as UInt
      let b1 = self._read_byte()? as UInt
      Ok((b0 << 8) | b1)
    elsif additional == 26 then
      var val: UInt = 0
      for _ in 0..4 do val = (val << 8) | (self._read_byte()? as UInt) end
      Ok(val)
    elsif additional == 27 then
      var val: UInt = 0
      for _ in 0..8 do val = (val << 8) | (self._read_byte()? as UInt) end
      Ok(val)
    else
      Err(CborError.InvalidAdditionalInfo(additional))
    end
  end
end

# ─── Float conversion helpers ────────────────────────────────────────

@ffi("c") extern def memcpy(dst: *mut u8, src: *u8, n: UInt) -> *mut u8 end

def _float_to_f64_bits(f: Float) -> UInt
  var bits: UInt = 0
  unsafe { memcpy(&mut bits as *mut u8, &f as *u8, 8) }
  bits
end

def _f64_bits_to_float(bits: UInt) -> Float
  var f: Float = 0.0
  unsafe { memcpy(&mut f as *mut u8, &bits as *u8, 8) }
  f
end

def _float_to_f32_bits(f: Float) -> UInt
  let f32_val = f as f32
  var bits: UInt = 0
  unsafe { memcpy(&mut bits as *mut u8, &f32_val as *u8, 4) }
  bits & 0xFFFFFFFF
end

def _f32_bits_to_float(bits: UInt) -> Float
  var f32_val: f32 = 0.0
  let masked = bits & 0xFFFFFFFF
  unsafe { memcpy(&mut f32_val as *mut u8, &masked as *u8, 4) }
  f32_val as Float
end

def _float_to_f16_bits(f: Float) -> UInt
  let f32_bits = _float_to_f32_bits(f)
  let sign = (f32_bits >> 16) & 0x8000
  let exp = ((f32_bits >> 23) & 0xFF) as Int - 127 + 15
  let frac = (f32_bits >> 13) & 0x03FF
  if exp <= 0 then sign
  elsif exp >= 31 then sign | 0x7C00
  else sign | ((exp as UInt) << 10) | frac
  end
end

def _f16_bits_to_float(bits: UInt) -> Float
  let sign = (bits >> 15) & 1
  let exp = (bits >> 10) & 0x1F
  let frac = bits & 0x03FF
  var f: Float = 0.0
  if exp == 0 then
    f = (frac as Float) * (1.0 / 16777216.0)  ## 2^-24
  elsif exp == 31 then
    f = if frac == 0 then 1.0 / 0.0 else 0.0 / 0.0 end
  else
    f = ((frac as Float) / 1024.0 + 1.0) * std::math::pow(2.0, (exp as Float) - 15.0)
  end
  if sign == 1 then -f else f end
end

# ─── Convenience functions ───────────────────────────────────────────

pub def encode(value: &Value) -> Vec[u8]
  var enc = Encoder.new()
  enc.encode(value)
  enc.into_bytes()
end

pub def decode(bytes: &[u8]) -> Result[Value, CborError]
  var dec = Decoder.new(bytes.to_vec())
  dec.decode()
end

pub def decode_strict(bytes: &[u8]) -> Result[Value, CborError]
  var dec = Decoder.new(bytes.to_vec())
  dec.decode_strict()
end

end ## module std::cbor
