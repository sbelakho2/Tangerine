# Tangerine Standard Library — Logging, Tracing, and Metrics
#
# Structured logging with levels, spans, and metrics collection.
#
# Usage:
#   log::info("server started", &[("port", "8080")])
#   
#   let span = trace::span("handle_request")
#   defer span.end()
#   
#   metrics::counter("requests_total").inc()

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{Map}
use std::time::{Instant, Duration}
use std::thread::{Mutex}

# ———————————————————————————————————————————————————————————————
# Log Levels
# ———————————————————————————————————————————————————————————————

enum LogLevel
  Trace
  Debug
  Info
  Warn
  Error
  Fatal
end

def level_value(level: &LogLevel) -> Int
  match level
  when LogLevel::Trace then 0
  when LogLevel::Debug then 1
  when LogLevel::Info then 2
  when LogLevel::Warn then 3
  when LogLevel::Error then 4
  when LogLevel::Fatal then 5
  end
end

def level_name(level: &LogLevel) -> &str
  match level
  when LogLevel::Trace then "TRACE"
  when LogLevel::Debug then "DEBUG"
  when LogLevel::Info then "INFO"
  when LogLevel::Warn then "WARN"
  when LogLevel::Error then "ERROR"
  when LogLevel::Fatal then "FATAL"
  end
end

def level_from_string(s: &str) -> Option[LogLevel]
  match s.to_uppercase().as_str()
  when "TRACE" then Option::Some(LogLevel::Trace)
  when "DEBUG" then Option::Some(LogLevel::Debug)
  when "INFO" then Option::Some(LogLevel::Info)
  when "WARN" then Option::Some(LogLevel::Warn)
  when "ERROR" then Option::Some(LogLevel::Error)
  when "FATAL" then Option::Some(LogLevel::Fatal)
  when _ then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Log Record
# ———————————————————————————————————————————————————————————————

struct LogRecord
  level: LogLevel
  message: String
  fields: Vec[(String, String)]
  target: String
  file: Option[String]
  line: Option[UInt]
  timestamp: Instant
end

def LogRecord::new(level: LogLevel, message: &str) -> LogRecord
  LogRecord {
    level: level,
    message: message.to_string(),
    fields: Vec::new(),
    target: String::new(),
    file: Option::None,
    line: Option::None,
    timestamp: Instant::now()
  }
end

impl LogRecord
  def field(self: &mut LogRecord, key: &str, value: &str) -> &mut LogRecord
    self.fields.push((key.to_string(), value.to_string()))
    self
  end
  
  def target(self: &mut LogRecord, target: &str) -> &mut LogRecord
    self.target = target.to_string()
    self
  end
  
  def location(self: &mut LogRecord, file: &str, line: UInt) -> &mut LogRecord
    self.file = Option::Some(file.to_string())
    self.line = Option::Some(line)
    self
  end
end

# ———————————————————————————————————————————————————————————————
# Logger Trait
# ———————————————————————————————————————————————————————————————

trait Logger
  def enabled(self: &Self, level: &LogLevel) -> Bool
  def log(self: &mut Self, record: &LogRecord) -> Unit
  def flush(self: &mut Self) -> Unit
end

# ———————————————————————————————————————————————————————————————
# Console Logger
# ———————————————————————————————————————————————————————————————

struct ConsoleLogger
  min_level: LogLevel
  use_colors: Bool
  show_timestamp: Bool
  show_target: Bool
end

def ConsoleLogger::new() -> ConsoleLogger
  ConsoleLogger {
    min_level: LogLevel::Info,
    use_colors: true,
    show_timestamp: true,
    show_target: false
  }
end

impl ConsoleLogger
  def level(self: &mut ConsoleLogger, level: LogLevel) -> &mut ConsoleLogger
    self.min_level = level
    self
  end
  
  def colors(self: &mut ConsoleLogger, enabled: Bool) -> &mut ConsoleLogger
    self.use_colors = enabled
    self
  end
  
  def timestamps(self: &mut ConsoleLogger, enabled: Bool) -> &mut ConsoleLogger
    self.show_timestamp = enabled
    self
  end
  
  def targets(self: &mut ConsoleLogger, enabled: Bool) -> &mut ConsoleLogger
    self.show_target = enabled
    self
  end
end

impl Logger for ConsoleLogger
  def enabled(self: &ConsoleLogger, level: &LogLevel) -> Bool
    level_value(level) >= level_value(&self.min_level)
  end
  
  def log(self: &mut ConsoleLogger, record: &LogRecord) -> Unit
    if !self.enabled(&record.level) then
      return
    end
    
    let mut output = String::new()
    
    # Timestamp
    if self.show_timestamp then
      output.push_str(format_timestamp(record.timestamp).as_str())
      output.push(' ')
    end
    
    # Level
    if self.use_colors then
      output.push_str(level_color(&record.level).as_str())
    end
    output.push_str(level_name(&record.level))
    if self.use_colors then
      output.push_str("\x1b[0m")
    end
    output.push(' ')
    
    # Target
    if self.show_target && !record.target.is_empty() then
      output.push('[')
      output.push_str(record.target.as_str())
      output.push_str("] ")
    end
    
    # Message
    output.push_str(record.message.as_str())
    
    # Fields
    if !record.fields.is_empty() then
      for field in &record.fields do
        let (k, v) = field
        output.push(' ')
        if self.use_colors then
          output.push_str("\x1b[2m")  # dim
        end
        output.push_str(k.as_str())
        output.push('=')
        output.push_str(v.as_str())
        if self.use_colors then
          output.push_str("\x1b[0m")
        end
      end
    end
    
    # Location
    match record.file
    when Option::Some(f) then
      output.push_str(" (")
      output.push_str(f.as_str())
      match record.line
      when Option::Some(l) then
        output.push(':')
        output.push_str(l.to_string().as_str())
      when Option::None then ()
      end
      output.push(')')
    when Option::None then ()
    end
    
    output.push('\n')
    
    # Write to stderr for warn/error/fatal, stdout otherwise
    if level_value(&record.level) >= level_value(&LogLevel::Warn) then
      std::io::stderr().write_all(output.as_bytes())
    else
      std::io::stdout().write_all(output.as_bytes())
    end
  end
  
  def flush(self: &mut ConsoleLogger) -> Unit
    std::io::stdout().flush()
    std::io::stderr().flush()
  end
end

def level_color(level: &LogLevel) -> String
  match level
  when LogLevel::Trace then "\x1b[35m"   # magenta
  when LogLevel::Debug then "\x1b[36m"   # cyan
  when LogLevel::Info then "\x1b[32m"    # green
  when LogLevel::Warn then "\x1b[33m"    # yellow
  when LogLevel::Error then "\x1b[31m"   # red
  when LogLevel::Fatal then "\x1b[1;31m" # bold red
  end.to_string()
end

def format_timestamp(instant: Instant) -> String
  # Format as ISO 8601
  std::time::format_rfc3339(instant.to_system_time())
end

# ———————————————————————————————————————————————————————————————
# JSON Logger
# ———————————————————————————————————————————————————————————————

struct JsonLogger
  min_level: LogLevel
  writer: Box[dyn std::io::Write]
end

def JsonLogger::new(writer: Box[dyn std::io::Write]) -> JsonLogger
  JsonLogger {
    min_level: LogLevel::Info,
    writer: writer
  }
end

impl Logger for JsonLogger
  def enabled(self: &JsonLogger, level: &LogLevel) -> Bool
    level_value(level) >= level_value(&self.min_level)
  end
  
  def log(self: &mut JsonLogger, record: &LogRecord) -> Unit
    if !self.enabled(&record.level) then
      return
    end
    
    let mut obj = Map::new()
    obj.insert("level".to_string(), std::json::Value::String(level_name(&record.level).to_string()))
    obj.insert("message".to_string(), std::json::Value::String(record.message.clone()))
    obj.insert("timestamp".to_string(), std::json::Value::String(format_timestamp(record.timestamp)))
    
    if !record.target.is_empty() then
      obj.insert("target".to_string(), std::json::Value::String(record.target.clone()))
    end
    
    match record.file
    when Option::Some(f) then
      obj.insert("file".to_string(), std::json::Value::String(f.clone()))
    when Option::None then ()
    end
    
    match record.line
    when Option::Some(l) then
      obj.insert("line".to_string(), std::json::Value::Int(l as Int))
    when Option::None then ()
    end
    
    if !record.fields.is_empty() then
      let mut fields = Map::new()
      for field in &record.fields do
        let (k, v) = field
        fields.insert(k.clone(), std::json::Value::String(v.clone()))
      end
      obj.insert("fields".to_string(), std::json::Value::Object(fields))
    end
    
    let json_str = std::json::stringify(&std::json::Value::Object(obj))
    self.writer.write_all(json_str.as_bytes())
    self.writer.write_all(b"\n")
  end
  
  def flush(self: &mut JsonLogger) -> Unit
    self.writer.flush()
  end
end

# ———————————————————————————————————————————————————————————————
# File Logger
# ———————————————————————————————————————————————————————————————

struct FileLogger
  inner: ConsoleLogger
  file: std::fs::File
  max_size: UInt
  current_size: UInt
  rotate_count: UInt
  path: String
end

def FileLogger::new(path: &str) -> Result[FileLogger, String]
  let file = match std::fs::File::create(path)
  when Result::Ok(f) then f
  when Result::Err(e) then return Result::Err(e.to_string())
  end
  
  Result::Ok(FileLogger {
    inner: ConsoleLogger::new(),
    file: file,
    max_size: 10 * 1024 * 1024,  # 10MB default
    current_size: 0,
    rotate_count: 5,
    path: path.to_string()
  })
end

impl FileLogger
  def max_size(self: &mut FileLogger, size: UInt) -> &mut FileLogger
    self.max_size = size
    self
  end
  
  def rotate_count(self: &mut FileLogger, count: UInt) -> &mut FileLogger
    self.rotate_count = count
    self
  end
  
  def rotate(self: &mut FileLogger) -> Result[Unit, String]
    self.file.flush()
    
    # Rotate existing files
    for i in (1..self.rotate_count).rev() do
      let old_path = self.path.clone() + "." + i.to_string()
      let new_path = self.path.clone() + "." + (i + 1).to_string()
      std::fs::rename(&old_path, &new_path)
    end
    
    # Move current file
    let backup = self.path.clone() + ".1"
    std::fs::rename(&self.path, &backup)
    
    # Create new file
    self.file = match std::fs::File::create(&self.path)
    when Result::Ok(f) then f
    when Result::Err(e) then return Result::Err(e.to_string())
    end
    
    self.current_size = 0
    Result::Ok(())
  end
end

impl Logger for FileLogger
  def enabled(self: &FileLogger, level: &LogLevel) -> Bool
    self.inner.enabled(level)
  end
  
  def log(self: &mut FileLogger, record: &LogRecord) -> Unit
    if !self.enabled(&record.level) then
      return
    end
    
    # Check for rotation
    if self.current_size >= self.max_size then
      self.rotate()
    end
    
    let line = format_log_line(record)
    let bytes = line.as_bytes()
    self.file.write_all(bytes)
    self.current_size = self.current_size + bytes.len()
  end
  
  def flush(self: &mut FileLogger) -> Unit
    self.file.flush()
  end
end

def format_log_line(record: &LogRecord) -> String
  let mut output = String::new()
  output.push_str(format_timestamp(record.timestamp).as_str())
  output.push(' ')
  output.push_str(level_name(&record.level))
  output.push(' ')
  output.push_str(record.message.as_str())
  
  for field in &record.fields do
    let (k, v) = field
    output.push(' ')
    output.push_str(k.as_str())
    output.push('=')
    output.push_str(v.as_str())
  end
  
  output.push('\n')
  output
end

# ———————————————————————————————————————————————————————————————
# Global Logger
# ———————————————————————————————————————————————————————————————

static mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None
static mut LOGGER_LOCK: Mutex = Mutex::new()

def set_logger(logger: Box[dyn Logger]) -> Unit
  LOGGER_LOCK.lock()
  GLOBAL_LOGGER = Option::Some(logger)
  LOGGER_LOCK.unlock()
end

def init() -> Unit
  let logger = Box::new(ConsoleLogger::new())
  set_logger(logger)
end

def init_with_level(level: LogLevel) -> Unit
  let mut console = ConsoleLogger::new()
  console.level(level)
  set_logger(Box::new(console))
end

def log(level: LogLevel, message: &str, fields: &[(&str, &str)]) -> Unit
  LOGGER_LOCK.lock()
  match GLOBAL_LOGGER.as_mut()
  when Option::Some(logger) then
    let mut record = LogRecord::new(level, message)
    for field in fields do
      let (k, v) = field
      record.field(k, v)
    end
    logger.log(&record)
  when Option::None then ()
  end
  LOGGER_LOCK.unlock()
end

# Convenience functions
def trace(message: &str, fields: &[(&str, &str)]) -> Unit
  log(LogLevel::Trace, message, fields)
end

def debug(message: &str, fields: &[(&str, &str)]) -> Unit
  log(LogLevel::Debug, message, fields)
end

def info(message: &str, fields: &[(&str, &str)]) -> Unit
  log(LogLevel::Info, message, fields)
end

def warn(message: &str, fields: &[(&str, &str)]) -> Unit
  log(LogLevel::Warn, message, fields)
end

def error(message: &str, fields: &[(&str, &str)]) -> Unit
  log(LogLevel::Error, message, fields)
end

def fatal(message: &str, fields: &[(&str, &str)]) -> Unit
  log(LogLevel::Fatal, message, fields)
end

# ———————————————————————————————————————————————————————————————
# Distributed Tracing
# ———————————————————————————————————————————————————————————————

struct TraceId
  high: u64
  low: u64
end

struct SpanId
  value: u64
end

def TraceId::new() -> TraceId
  TraceId {
    high: std::core::random_u64(),
    low: std::core::random_u64()
  }
end

def SpanId::new() -> SpanId
  SpanId { value: std::core::random_u64() }
end

def to_hex_fixed_u64(value: u64) -> String
  let digits = "0123456789abcdef"
  mut out = ""
  mut v = value
  mut i = 0
  while i < 16 do
    let nibble = ((v >> 60) & 0xf) as UInt
    out = out + digits.char_at(nibble).unwrap().to_string()
    v = v << 4
    i = i + 1
  end
  out
end

impl TraceId
  def to_hex(self: &TraceId) -> String
    to_hex_fixed_u64(self.high) + to_hex_fixed_u64(self.low)
  end
end

impl SpanId
  def to_hex(self: &SpanId) -> String
    to_hex_fixed_u64(self.value)
  end
end

struct SpanContext
  trace_id: TraceId
  span_id: SpanId
  parent_span_id: Option[SpanId]
  trace_flags: u8
  trace_state: String
end

# ———————————————————————————————————————————————————————————————
# Span
# ———————————————————————————————————————————————————————————————

struct Span
  name: String
  context: SpanContext
  start_time: Instant
  end_time: Option[Instant]
  attributes: Map[String, SpanValue]
  events: Vec[SpanEvent]
  status: SpanStatus
  kind: SpanKind
end

enum SpanValue
  String(String)
  Int(Int)
  Float(f64)
  Bool(Bool)
  StringArray(Vec[String])
  IntArray(Vec[Int])
end

struct SpanEvent
  name: String
  timestamp: Instant
  attributes: Map[String, SpanValue]
end

enum SpanStatus
  Unset
  Ok
  Error(String)
end

enum SpanKind
  Internal
  Server
  Client
  Producer
  Consumer
end

def span(name: &str) -> Span
  let trace_id = TraceId::new()
  let span_id = SpanId::new()
  
  # Check for parent span in context
  let parent = get_current_span()
  
  let ctx = SpanContext {
    trace_id: match parent
    when Option::Some(p) then p.context.trace_id.clone()
    when Option::None then trace_id
    end,
    span_id: span_id,
    parent_span_id: match parent
    when Option::Some(p) then Option::Some(p.context.span_id.clone())
    when Option::None then Option::None
    end,
    trace_flags: 1,  # sampled
    trace_state: String::new()
  }
  
  let s = Span {
    name: name.to_string(),
    context: ctx,
    start_time: Instant::now(),
    end_time: Option::None,
    attributes: Map::new(),
    events: Vec::new(),
    status: SpanStatus::Unset,
    kind: SpanKind::Internal
  }
  
  set_current_span(&s)
  s
end

impl Span
  def set_attribute(self: &mut Span, key: &str, value: SpanValue) -> &mut Span
    self.attributes.insert(key.to_string(), value)
    self
  end
  
  def set_string(self: &mut Span, key: &str, value: &str) -> &mut Span
    self.set_attribute(key, SpanValue::String(value.to_string()))
  end
  
  def set_int(self: &mut Span, key: &str, value: Int) -> &mut Span
    self.set_attribute(key, SpanValue::Int(value))
  end
  
  def set_bool(self: &mut Span, key: &str, value: Bool) -> &mut Span
    self.set_attribute(key, SpanValue::Bool(value))
  end
  
  def add_event(self: &mut Span, name: &str) -> &mut Span
    self.events.push(SpanEvent {
      name: name.to_string(),
      timestamp: Instant::now(),
      attributes: Map::new()
    })
    self
  end
  
  def add_event_with_attrs(self: &mut Span, name: &str, attrs: Map[String, SpanValue]) -> &mut Span
    self.events.push(SpanEvent {
      name: name.to_string(),
      timestamp: Instant::now(),
      attributes: attrs
    })
    self
  end
  
  def set_status(self: &mut Span, status: SpanStatus) -> &mut Span
    self.status = status
    self
  end
  
  def set_error(self: &mut Span, message: &str) -> &mut Span
    self.status = SpanStatus::Error(message.to_string())
    self
  end
  
  def set_kind(self: &mut Span, kind: SpanKind) -> &mut Span
    self.kind = kind
    self
  end
  
  def end(self: &mut Span) -> Unit
    self.end_time = Option::Some(Instant::now())
    
    # Export to tracer
    export_span(self)
    
    # Restore parent span
    pop_current_span()
  end
  
  def duration(self: &Span) -> Duration
    match self.end_time
    when Option::Some(end) then end.duration_since(self.start_time)
    when Option::None then Instant::now().duration_since(self.start_time)
    end
  end
  
  def trace_id(self: &Span) -> String
    self.context.trace_id.to_hex()
  end
  
  def span_id(self: &Span) -> String
    self.context.span_id.to_hex()
  end
end

# Thread-local span stack
thread_local static mut SPAN_STACK: Vec[Span] = Vec::new()

def get_current_span() -> Option[&Span]
  if SPAN_STACK.is_empty() then
    Option::None
  else
    Option::Some(&SPAN_STACK[SPAN_STACK.len() - 1])
  end
end

def set_current_span(span: &Span) -> Unit
  SPAN_STACK.push(span.clone())
end

def pop_current_span() -> Option[Span]
  SPAN_STACK.pop()
end

# ———————————————————————————————————————————————————————————————
# Tracer Backend
# ———————————————————————————————————————————————————————————————

trait SpanExporter
  def export(self: &mut Self, span: &Span) -> Unit
  def shutdown(self: &mut Self) -> Unit
end

struct ConsoleSpanExporter
  show_events: Bool
end

impl SpanExporter for ConsoleSpanExporter
  def export(self: &mut ConsoleSpanExporter, span: &Span) -> Unit
    let duration = span.duration()
    let status = match span.status
    when SpanStatus::Unset then "unset"
    when SpanStatus::Ok then "ok"
    when SpanStatus::Error(_) then "error"
    end
    
    info("span ended", &[
      ("name", span.name.as_str()),
      ("trace_id", span.trace_id().as_str()),
      ("span_id", span.span_id().as_str()),
      ("duration_ms", duration.as_millis().to_string().as_str()),
      ("status", status)
    ])
  end
  
  def shutdown(self: &mut ConsoleSpanExporter) -> Unit {}
end

struct OtlpExporter
  endpoint: String
  headers: Map[String, String]
end

def OtlpExporter::new(endpoint: &str) -> OtlpExporter
  OtlpExporter {
    endpoint: endpoint.to_string(),
    headers: Map::new()
  }
end

impl OtlpExporter
  def header(self: &mut OtlpExporter, key: &str, value: &str) -> &mut OtlpExporter
    self.headers.insert(key.to_string(), value.to_string())
    self
  end
end

impl SpanExporter for OtlpExporter
  def export(self: &mut OtlpExporter, span: &Span) -> Unit
    # Build OTLP JSON payload
    let payload = build_otlp_span(span)
    
    # Send to collector
    let mut client = std::http::HttpClient::new()
    match client.post(self.endpoint.as_str())
      .header("Content-Type", "application/json")
      .body(payload.as_str())
      .send()
    when Result::Ok(_) then ()
    when Result::Err(e) then
      error("failed to export span", &[("error", std::http::http_error_message(&e).as_str())])
    end
  end
  
  def shutdown(self: &mut OtlpExporter) -> Unit {}
end

def build_otlp_span(span: &Span) -> String
  # Simplified OTLP format
  let mut s = String::from("{\"resourceSpans\":[{\"scopeSpans\":[{\"spans\":[{")
  s.push_str("\"traceId\":\"")
  s.push_str(span.trace_id().as_str())
  s.push_str("\",\"spanId\":\"")
  s.push_str(span.span_id().as_str())
  s.push_str("\",\"name\":\"")
  s.push_str(span.name.as_str())
  s.push_str("\",\"startTimeUnixNano\":")
  s.push_str(span.start_time.as_nanos().to_string().as_str())
  s.push_str(",\"endTimeUnixNano\":")
  match span.end_time
  when Option::Some(end) then s.push_str(end.as_nanos().to_string().as_str())
  when Option::None then s.push_str("0")
  end
  s.push_str("}]}]}]}")
  s
end

static mut SPAN_EXPORTER: Option[Box[dyn SpanExporter]] = Option::None
static mut EXPORTER_LOCK: Mutex = Mutex::new()

def set_exporter(exporter: Box[dyn SpanExporter]) -> Unit
  EXPORTER_LOCK.lock()
  SPAN_EXPORTER = Option::Some(exporter)
  EXPORTER_LOCK.unlock()
end

def export_span(span: &Span) -> Unit
  EXPORTER_LOCK.lock()
  match SPAN_EXPORTER.as_mut()
  when Option::Some(exporter) then exporter.export(span)
  when Option::None then ()
  end
  EXPORTER_LOCK.unlock()
end

# ———————————————————————————————————————————————————————————————
# Metrics
# ———————————————————————————————————————————————————————————————

enum MetricKind
  Counter
  Gauge
  Histogram
end

struct Metric
  name: String
  description: String
  kind: MetricKind
  labels: Map[String, String]
end

# Counter - monotonically increasing value
struct Counter
  name: String
  labels: Map[String, String]
  value: f64
end

def Counter::new(name: &str) -> Counter
  Counter {
    name: name.to_string(),
    labels: Map::new(),
    value: 0.0
  }
end

impl Counter
  def with_label(self: &mut Counter, key: &str, value: &str) -> &mut Counter
    self.labels.insert(key.to_string(), value.to_string())
    self
  end
  
  def inc(self: &mut Counter) -> Unit
    self.add(1.0)
  end
  
  def add(self: &mut Counter, v: f64) -> Unit
    self.value = self.value + v
    record_metric(&self.name, self.value, &self.labels, MetricKind::Counter)
  end
  
  def get(self: &Counter) -> f64 { self.value }
end

# Gauge - value that can go up and down
struct Gauge
  name: String
  labels: Map[String, String]
  value: f64
end

def Gauge::new(name: &str) -> Gauge
  Gauge {
    name: name.to_string(),
    labels: Map::new(),
    value: 0.0
  }
end

impl Gauge
  def with_label(self: &mut Gauge, key: &str, value: &str) -> &mut Gauge
    self.labels.insert(key.to_string(), value.to_string())
    self
  end
  
  def set(self: &mut Gauge, v: f64) -> Unit
    self.value = v
    record_metric(&self.name, self.value, &self.labels, MetricKind::Gauge)
  end
  
  def inc(self: &mut Gauge) -> Unit { self.add(1.0) }
  def dec(self: &mut Gauge) -> Unit { self.sub(1.0) }
  
  def add(self: &mut Gauge, v: f64) -> Unit
    self.set(self.value + v)
  end
  
  def sub(self: &mut Gauge, v: f64) -> Unit
    self.set(self.value - v)
  end
  
  def get(self: &Gauge) -> f64 { self.value }
end

# Histogram - distribution of values
struct Histogram
  name: String
  labels: Map[String, String]
  buckets: Vec[f64]
  counts: Vec[UInt]
  sum: f64
  count: UInt
end

def Histogram::new(name: &str) -> Histogram
  # Default buckets
  let buckets = [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0]
  let mut counts = Vec::new()
  mut i = 0
  while i < buckets.len() + 1 do
    counts.push(0)
    i = i + 1
  end
  
  Histogram {
    name: name.to_string(),
    labels: Map::new(),
    buckets: buckets,
    counts: counts,
    sum: 0.0,
    count: 0
  }
end

def Histogram::with_buckets(name: &str, buckets: Vec[f64]) -> Histogram
  let mut counts = Vec::new()
  mut j = 0
  while j < buckets.len() + 1 do
    counts.push(0)
    j = j + 1
  end
  Histogram {
    name: name.to_string(),
    labels: Map::new(),
    buckets: buckets,
    counts: counts,
    sum: 0.0,
    count: 0
  }
end

impl Histogram
  def with_label(self: &mut Histogram, key: &str, value: &str) -> &mut Histogram
    self.labels.insert(key.to_string(), value.to_string())
    self
  end
  
  def observe(self: &mut Histogram, value: f64) -> Unit
    self.sum = self.sum + value
    self.count = self.count + 1
    
    # Find bucket
    for i in 0..self.buckets.len() do
      if value <= self.buckets[i] then
        self.counts[i] = self.counts[i] + 1
        break
      end
    end
    # Also increment +Inf bucket
    self.counts[self.buckets.len()] = self.counts[self.buckets.len()] + 1
    
    record_histogram_metric(&self.name, &self.buckets, &self.counts, self.sum, self.count, &self.labels)
  end
  
  def time[T](self: &mut Histogram, f: fn() -> T) -> T
    let start = Instant::now()
    let result = f()
    let duration = Instant::now().duration_since(start)
    self.observe(duration.as_secs_f64())
    result
  end
  
  def start_timer(self: &mut Histogram) -> HistogramTimer
    HistogramTimer {
      histogram: self,
      start: Instant::now()
    }
  end
end

struct HistogramTimer
  histogram: &mut Histogram
  start: Instant
end

impl HistogramTimer
  def stop(self: HistogramTimer) -> f64
    let duration = Instant::now().duration_since(self.start)
    let secs = duration.as_secs_f64()
    self.histogram.observe(secs)
    secs
  end
end

# ———————————————————————————————————————————————————————————————
# Metrics Registry
# ———————————————————————————————————————————————————————————————

struct MetricsRegistry
  counters: Map[String, Counter]
  gauges: Map[String, Gauge]
  histograms: Map[String, Histogram]
end

def MetricsRegistry::new() -> MetricsRegistry
  MetricsRegistry {
    counters: Map::new(),
    gauges: Map::new(),
    histograms: Map::new()
  }
end

static mut GLOBAL_METRICS: Option[MetricsRegistry] = Option::None
static mut METRICS_LOCK: Mutex = Mutex::new()

def init_metrics() -> Unit
  METRICS_LOCK.lock()
  GLOBAL_METRICS = Option::Some(MetricsRegistry::new())
  METRICS_LOCK.unlock()
end

def counter(name: &str) -> &mut Counter
  METRICS_LOCK.lock()
  let registry = GLOBAL_METRICS.as_mut().unwrap()
  if !registry.counters.contains_key(name) then
    registry.counters.insert(name.to_string(), Counter::new(name))
  end
  let c = registry.counters.get_mut(name).unwrap()
  METRICS_LOCK.unlock()
  c
end

def gauge(name: &str) -> &mut Gauge
  METRICS_LOCK.lock()
  let registry = GLOBAL_METRICS.as_mut().unwrap()
  if !registry.gauges.contains_key(name) then
    registry.gauges.insert(name.to_string(), Gauge::new(name))
  end
  let g = registry.gauges.get_mut(name).unwrap()
  METRICS_LOCK.unlock()
  g
end

def histogram(name: &str) -> &mut Histogram
  METRICS_LOCK.lock()
  let registry = GLOBAL_METRICS.as_mut().unwrap()
  if !registry.histograms.contains_key(name) then
    registry.histograms.insert(name.to_string(), Histogram::new(name))
  end
  let h = registry.histograms.get_mut(name).unwrap()
  METRICS_LOCK.unlock()
  h
end

# ———————————————————————————————————————————————————————————————
# Metrics Export
# ———————————————————————————————————————————————————————————————

trait MetricsExporter
  def record(self: &mut Self, name: &str, value: f64, labels: &Map[String, String], kind: MetricKind)
  def record_histogram(self: &mut Self, name: &str, buckets: &[f64],
      counts: &[UInt], sum: f64, count: UInt, labels: &Map[String, String])
  def flush(self: &mut Self) -> Unit
end

struct PrometheusExporter
  metrics: Vec[String]
end

impl PrometheusExporter
  def expose(self: &PrometheusExporter) -> String
    # Return Prometheus text format
    METRICS_LOCK.lock()
    let mut output = String::new()
    
    match GLOBAL_METRICS.as_ref()
    when Option::Some(registry) then
      # Counters
      for (name, counter) in &registry.counters do
        output.push_str("# TYPE ")
        output.push_str(name.as_str())
        output.push_str(" counter\n")
        output.push_str(name.as_str())
        output.push_str(format_labels(&counter.labels).as_str())
        output.push(' ')
        output.push_str(counter.value.to_string().as_str())
        output.push('\n')
      end
      
      # Gauges
      for (name, gauge) in &registry.gauges do
        output.push_str("# TYPE ")
        output.push_str(name.as_str())
        output.push_str(" gauge\n")
        output.push_str(name.as_str())
        output.push_str(format_labels(&gauge.labels).as_str())
        output.push(' ')
        output.push_str(gauge.value.to_string().as_str())
        output.push('\n')
      end
      
      # Histograms
      for (name, hist) in &registry.histograms do
        output.push_str("# TYPE ")
        output.push_str(name.as_str())
        output.push_str(" histogram\n")
        
        let mut cumulative = 0u64
        for i in 0..hist.buckets.len() do
          cumulative = cumulative + hist.counts[i] as u64
          output.push_str(name.as_str())
          output.push_str("_bucket{le=\"")
          output.push_str(hist.buckets[i].to_string().as_str())
          output.push_str("\"} ")
          output.push_str(cumulative.to_string().as_str())
          output.push('\n')
        end
        
        output.push_str(name.as_str())
        output.push_str("_sum ")
        output.push_str(hist.sum.to_string().as_str())
        output.push('\n')
        
        output.push_str(name.as_str())
        output.push_str("_count ")
        output.push_str(hist.count.to_string().as_str())
        output.push('\n')
      end
    when Option::None then ()
    end
    
    METRICS_LOCK.unlock()
    output
  end
end

def format_labels(labels: &Map[String, String]) -> String
  if labels.is_empty() then
    return String::new()
  end
  
  let mut s = String::from("{")
  let mut first = true
  for (k, v) in labels do
    if !first then
      s.push(',')
    end
    first = false
    s.push_str(k.as_str())
    s.push_str("=\"")
    s.push_str(v.as_str())
    s.push('"')
  end
  s.push('}')
  s
end

static mut METRICS_EXPORTER: Option[Box[dyn MetricsExporter]] = Option::None

def set_metrics_exporter(exporter: Box[dyn MetricsExporter]) -> Unit
  METRICS_EXPORTER = Option::Some(exporter)
end

def record_metric(name: &str, value: f64, labels: &Map[String, String], kind: MetricKind) -> Unit
  match METRICS_EXPORTER.as_mut()
  when Option::Some(exporter) then exporter.record(name, value, labels, kind)
  when Option::None then ()
  end
end

def record_histogram_metric(name: &str, buckets: &[f64], counts: &[UInt],
    sum: f64, count: UInt, labels: &Map[String, String]) -> Unit
  match METRICS_EXPORTER.as_mut()
  when Option::Some(exporter) then exporter.record_histogram(name, buckets, counts, sum, count, labels)
  when Option::None then ()
  end
end
