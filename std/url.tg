# Tangerine Standard Library — URL
#
# RFC 3986 compliant URL parsing, building, and encoding.
#
# Usage:
#   let url = Url::parse("https://example.com/path?q=1")?
#   let host = url.host()
#   let query = url.query_params().get("q")

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{Map}

# ———————————————————————————————————————————————————————————————
# URL Types
# ———————————————————————————————————————————————————————————————

struct Url
  scheme: String
  username: Option[String]
  password: Option[String]
  host: Option[String]
  port: Option[UInt]
  path: String
  query: Option[String]
  fragment: Option[String]
end

enum UrlError
  EmptyInput
  InvalidScheme
  InvalidHost
  InvalidPort
  InvalidPath
  InvalidPercent
  RelativeUrl
end

def url_error_message(e: &UrlError) -> String
  match e
  when UrlError::EmptyInput then "empty input"
  when UrlError::InvalidScheme then "invalid scheme"
  when UrlError::InvalidHost then "invalid host"
  when UrlError::InvalidPort then "invalid port"
  when UrlError::InvalidPath then "invalid path"
  when UrlError::InvalidPercent then "invalid percent encoding"
  when UrlError::RelativeUrl then "relative URL"
  end
end

impl Error for UrlError
  def message(&self) -> String
    url_error_message(self)
  end
end

# ———————————————————————————————————————————————————————————————
# URL Parsing
# ———————————————————————————————————————————————————————————————

def Url::parse(input: &str) -> Result[Url, UrlError]
  if input.is_empty() then
    return Result::Err(UrlError::EmptyInput)
  end
  
  let s = input.to_string()
  let mut parser = UrlParser::new(&s)
  parser.parse()
end

struct UrlParser
  input: String
  pos: UInt
end

def UrlParser::new(input: &str) -> UrlParser
  UrlParser { input: input.to_string(), pos: 0 }
end

impl UrlParser
  def remaining(self: &UrlParser) -> String
    self.input.slice(self.pos, self.input.len())
  end
  
  def peek(self: &UrlParser) -> Option[Char]
    if self.pos >= self.input.len() then Option::None
    else Option::Some(self.input.char_at(self.pos))
    end
  end
  
  def advance(self: &mut UrlParser) -> Option[Char]
    match self.peek()
    when Option::Some(c) then
      self.pos = self.pos + 1
      Option::Some(c)
    when Option::None then Option::None
    end
  end
  
  def parse(self: &mut UrlParser) -> Result[Url, UrlError]
    # Parse scheme
    let scheme = self.parse_scheme()?
    
    # Expect "://"
    if !self.consume_str("://") then
      return Result::Err(UrlError::InvalidScheme)
    end
    
    # Parse authority (userinfo@host:port)
    let (username, password, host, port) = self.parse_authority()?
    
    # Parse path
    let path = self.parse_path()
    
    # Parse query
    let query = if self.consume_char('?') then
      Option::Some(self.parse_query())
    else
      Option::None
    end
    
    # Parse fragment
    let fragment = if self.consume_char('#') then
      Option::Some(self.remaining())
    else
      Option::None
    end
    
    Result::Ok(Url {
      scheme: scheme,
      username: username,
      password: password,
      host: host,
      port: port,
      path: path,
      query: query,
      fragment: fragment
    })
  end
  
  def parse_scheme(self: &mut UrlParser) -> Result[String, UrlError]
    let mut scheme = String::new()
    
    # First char must be alpha
    match self.peek()
    when Option::Some(c) then
      if !is_alpha(c) then
        return Result::Err(UrlError::InvalidScheme)
      end
      scheme.push(c.to_lowercase())
      self.advance()
    when Option::None then return Result::Err(UrlError::InvalidScheme)
    end
    
    # Rest can be alpha, digit, +, -, .
    while match self.peek()
    when Option::Some(c) then c != ':'
    when Option::None then false
    end do
      match self.advance()
      when Option::Some(c) then
        if is_alpha(c) || is_digit(c) || c == '+' || c == '-' || c == '.' then
          scheme.push(c.to_lowercase())
        else
          return Result::Err(UrlError::InvalidScheme)
        end
      when Option::None then break
      end
    end
    
    Result::Ok(scheme)
  end
  
  def parse_authority(self: &mut UrlParser) -> Result[(Option[String], Option[String], Option[String], Option[UInt]), UrlError]
    let mut username: Option[String] = Option::None
    let mut password: Option[String] = Option::None
    let mut host: Option[String] = Option::None
    let mut port: Option[UInt] = Option::None
    
    # Check for userinfo
    let authority_end = self.find_first_of("/?#")
    let authority = self.input.slice(self.pos, authority_end)
    
    match authority.find('@')
    when Option::Some(at_pos) then
      let userinfo = authority.slice(0, at_pos)
      match userinfo.find(':')
      when Option::Some(colon_pos) then
        username = Option::Some(percent_decode(&userinfo.slice(0, colon_pos)))
        password = Option::Some(percent_decode(&userinfo.slice(colon_pos + 1, userinfo.len())))
      when Option::None then
        username = Option::Some(percent_decode(&userinfo))
      end
      self.pos = self.pos + at_pos + 1
    when Option::None then ()
    end
    
    # Parse host[:port]
    let host_port_end = self.find_first_of("/?#")
    let host_port = self.input.slice(self.pos, host_port_end)
    self.pos = host_port_end
    
    if !host_port.is_empty() then
      # Check for IPv6 address
      if host_port.starts_with("[") then
        match host_port.find(']')
        when Option::Some(bracket_end) then
          host = Option::Some(host_port.slice(1, bracket_end).to_string())
          if bracket_end + 1 < host_port.len() && host_port.char_at(bracket_end + 1) == ':' then
            let port_str = host_port.slice(bracket_end + 2, host_port.len())
            port = parse_port(&port_str)?
          end
        when Option::None then return Result::Err(UrlError::InvalidHost)
        end
      else
        match host_port.rfind(':')
        when Option::Some(colon_pos) then
          host = Option::Some(host_port.slice(0, colon_pos).to_string())
          let port_str = host_port.slice(colon_pos + 1, host_port.len())
          port = parse_port(&port_str)?
        when Option::None then
          host = Option::Some(host_port)
        end
      end
    end
    
    Result::Ok((username, password, host, port))
  end
  
  def parse_path(self: &mut UrlParser) -> String
    let mut path = String::new()
    
    while match self.peek()
    when Option::Some(c) then c != '?' && c != '#'
    when Option::None then false
    end do
      path.push(self.advance().unwrap())
    end
    
    if path.is_empty() then
      "/".to_string()
    else
      path
    end
  end
  
  def parse_query(self: &mut UrlParser) -> String
    let mut query = String::new()
    
    while match self.peek()
    when Option::Some(c) then c != '#'
    when Option::None then false
    end do
      query.push(self.advance().unwrap())
    end
    
    query
  end
  
  def find_first_of(self: &UrlParser, chars: &str) -> UInt
    let mut i = self.pos
    while i < self.input.len() do
      let c = self.input.char_at(i)
      for ch in chars.chars() do
        if c == ch then return i end
      end
      i = i + 1
    end
    self.input.len()
  end
  
  def consume_char(self: &mut UrlParser, expected: Char) -> Bool
    match self.peek()
    when Option::Some(c) then
      if c == expected then
        self.advance()
        true
      else
        false
      end
    when Option::None then false
    end
  end
  
  def consume_str(self: &mut UrlParser, expected: &str) -> Bool
    let len = expected.len()
    if self.pos + len > self.input.len() then
      return false
    end
    for i in 0..len do
      if self.input.char_at(self.pos + i) != expected.char_at(i) then
        return false
      end
    end
    self.pos = self.pos + len
    true
  end
end

# ———————————————————————————————————————————————————————————————
# URL Methods
# ———————————————————————————————————————————————————————————————

impl Url
  def scheme(self: &Url) -> &String { &self.scheme }
  def host(self: &Url) -> Option[&String] { self.host.as_ref() }
  def port(self: &Url) -> Option[UInt] { self.port }
  def path(self: &Url) -> &String { &self.path }
  def query(self: &Url) -> Option[&String] { self.query.as_ref() }
  def fragment(self: &Url) -> Option[&String] { self.fragment.as_ref() }
  def username(self: &Url) -> Option[&String] { self.username.as_ref() }
  def password(self: &Url) -> Option[&String] { self.password.as_ref() }
  
  def port_or_default(self: &Url) -> UInt
    match self.port
    when Option::Some(p) then p
    when Option::None then
      match self.scheme.as_str()
      when "http" then 80
      when "https" then 443
      when "ftp" then 21
      when "ssh" then 22
      when "ws" then 80
      when "wss" then 443
      when _ then 0
      end
    end
  end
  
  def is_secure(self: &Url) -> Bool
    self.scheme == "https" || self.scheme == "wss"
  end
  
  def authority(self: &Url) -> String
    let mut result = String::new()
    
    match self.username
    when Option::Some(u) then
      result.push_str(percent_encode(&u, USERNAME_SAFE).as_str())
      match self.password
      when Option::Some(p) then
        result.push(':')
        result.push_str(percent_encode(&p, PASSWORD_SAFE).as_str())
      when Option::None then ()
      end
      result.push('@')
    when Option::None then ()
    end
    
    match self.host
    when Option::Some(h) then
      if h.contains(':') then
        # IPv6
        result.push('[')
        result.push_str(h.as_str())
        result.push(']')
      else
        result.push_str(h.as_str())
      end
    when Option::None then ()
    end
    
    match self.port
    when Option::Some(p) then
      result.push(':')
      result.push_str(p.to_string().as_str())
    when Option::None then ()
    end
    
    result
  end
  
  def query_params(self: &Url) -> Map[String, String]
    match self.query
    when Option::Some(q) then parse_query_string(&q)
    when Option::None then Map::new()
    end
  end
  
  def to_string(self: &Url) -> String
    let mut result = String::new()
    
    result.push_str(self.scheme.as_str())
    result.push_str("://")
    result.push_str(self.authority().as_str())
    result.push_str(self.path.as_str())
    
    match self.query
    when Option::Some(q) then
      result.push('?')
      result.push_str(q.as_str())
    when Option::None then ()
    end
    
    match self.fragment
    when Option::Some(f) then
      result.push('#')
      result.push_str(f.as_str())
    when Option::None then ()
    end
    
    result
  end
  
  def join(self: &Url, relative: &str) -> Result[Url, UrlError]
    if relative.starts_with("//") then
      # Protocol-relative
      Url::parse((self.scheme.clone() + ":" + relative).as_str())
    else if relative.starts_with("/") then
      # Absolute path
      Result::Ok(Url {
        scheme: self.scheme.clone(),
        username: self.username.clone(),
        password: self.password.clone(),
        host: self.host.clone(),
        port: self.port,
        path: relative.to_string(),
        query: Option::None,
        fragment: Option::None
      })
    else if relative.contains("://") then
      # Absolute URL
      Url::parse(relative)
    else
      # Relative path
      let base_path = match self.path.rfind('/')
      when Option::Some(idx) then self.path.slice(0, idx + 1)
      when Option::None then "/"
      end
      let new_path = normalize_path(&(base_path.to_string() + relative))
      Result::Ok(Url {
        scheme: self.scheme.clone(),
        username: self.username.clone(),
        password: self.password.clone(),
        host: self.host.clone(),
        port: self.port,
        path: new_path,
        query: Option::None,
        fragment: Option::None
      })
    end end end
  end
end

# ———————————————————————————————————————————————————————————————
# URL Builder
# ———————————————————————————————————————————————————————————————

struct UrlBuilder
  scheme: String
  username: Option[String]
  password: Option[String]
  host: Option[String]
  port: Option[UInt]
  path: String
  query_params: Vec[(String, String)]
  fragment: Option[String]
end

def UrlBuilder::new() -> UrlBuilder
  UrlBuilder {
    scheme: "https".to_string(),
    username: Option::None,
    password: Option::None,
    host: Option::None,
    port: Option::None,
    path: "/".to_string(),
    query_params: Vec::new(),
    fragment: Option::None
  }
end

impl UrlBuilder
  def scheme(self: &mut UrlBuilder, s: &str) -> &mut UrlBuilder
    self.scheme = s.to_string()
    self
  end
  
  def host(self: &mut UrlBuilder, h: &str) -> &mut UrlBuilder
    self.host = Option::Some(h.to_string())
    self
  end
  
  def port(self: &mut UrlBuilder, p: UInt) -> &mut UrlBuilder
    self.port = Option::Some(p)
    self
  end
  
  def path(self: &mut UrlBuilder, p: &str) -> &mut UrlBuilder
    self.path = p.to_string()
    self
  end
  
  def username(self: &mut UrlBuilder, u: &str) -> &mut UrlBuilder
    self.username = Option::Some(u.to_string())
    self
  end
  
  def password(self: &mut UrlBuilder, p: &str) -> &mut UrlBuilder
    self.password = Option::Some(p.to_string())
    self
  end
  
  def query(self: &mut UrlBuilder, key: &str, value: &str) -> &mut UrlBuilder
    self.query_params.push((key.to_string(), value.to_string()))
    self
  end
  
  def fragment(self: &mut UrlBuilder, f: &str) -> &mut UrlBuilder
    self.fragment = Option::Some(f.to_string())
    self
  end
  
  def build(self: &UrlBuilder) -> Url
    let query = if self.query_params.is_empty() then
      Option::None
    else
      Option::Some(build_query_string(&self.query_params))
    end
    
    Url {
      scheme: self.scheme.clone(),
      username: self.username.clone(),
      password: self.password.clone(),
      host: self.host.clone(),
      port: self.port,
      path: self.path.clone(),
      query: query,
      fragment: self.fragment.clone()
    }
  end
end

# ———————————————————————————————————————————————————————————————
# Percent Encoding
# ———————————————————————————————————————————————————————————————

const UNRESERVED: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~"
const PATH_SAFE: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:@/"
const QUERY_SAFE: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:@/?[]"
const QUERY_COMPONENT_SAFE: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~"
const USERNAME_SAFE: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;="
const PASSWORD_SAFE: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:"
const FRAGMENT_SAFE: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~!$&'()*+,;=:@/?[]"

def percent_encode(s: &str, safe: &str) -> String
  let mut result = String::new()
  for c in s.chars() do
    if safe.contains(c) then
      result.push(c)
    else
      # Encode as UTF-8 bytes
      let bytes = char_to_utf8(c)
      for b in bytes do
        result.push('%')
        result.push(hex_digit((b >> 4) & 0xF))
        result.push(hex_digit(b & 0xF))
      end
    end
  end
  result
end

def percent_decode(s: &str) -> String
  let mut result = String::new()
  let mut i = 0
  
  while i < s.len() do
    let c = s.char_at(i)
    if c == '%' && i + 2 < s.len() then
      let h1 = hex_value(s.char_at(i + 1))
      let h2 = hex_value(s.char_at(i + 2))
      if h1 != 255 && h2 != 255 then
        result.push(((h1 << 4) | h2) as Char)
        i = i + 3
        continue
      end
    else if c == '+' then
      result.push(' ')
      i = i + 1
      continue
    end
    result.push(c)
    i = i + 1
  end
  
  result
end

def encode_uri_component(s: &str) -> String
  percent_encode(&s.to_string(), QUERY_COMPONENT_SAFE)
end

def decode_uri_component(s: &str) -> String
  percent_decode(&s.to_string())
end

# ———————————————————————————————————————————————————————————————
# Query String Handling
# ———————————————————————————————————————————————————————————————

def parse_query_string(query: &str) -> Map[String, String]
  let mut result: Map[String, String] = Map::new()
  
  for pair in query.split('&') do
    if pair.is_empty() then continue end
    
    match pair.find('=')
    when Option::Some(eq_pos) then
      let key = percent_decode(&pair.slice(0, eq_pos))
      let value = percent_decode(&pair.slice(eq_pos + 1, pair.len()))
      result.insert(key, value)
    when Option::None then
      let key = percent_decode(&pair)
      result.insert(key, String::new())
    end
  end
  
  result
end

def build_query_string(params: &Vec[(String, String)]) -> String
  let mut result = String::new()
  let mut first = true
  
  for param in params do
    let (key, value) = param
    if !first then result.push('&') end
    first = false
    
    result.push_str(encode_uri_component(key.as_str()).as_str())
    result.push('=')
    result.push_str(encode_uri_component(value.as_str()).as_str())
  end
  
  result
end

# ———————————————————————————————————————————————————————————————
# Path Normalization
# ———————————————————————————————————————————————————————————————

def normalize_path(path: &String) -> String
  let mut segments: Vec[String] = Vec::new()
  
  for segment in path.split('/') do
    if segment == ".." then
      if !segments.is_empty() then
        segments.pop()
      end
    else if segment == "." || segment.is_empty() then
      # Skip
    else
      segments.push(segment)
    end end
  end
  
  if segments.is_empty() then
    "/".to_string()
  else
    let mut result = String::new()
    for seg in segments do
      result.push('/')
      result.push_str(seg.as_str())
    end
    result
  end
end

# ———————————————————————————————————————————————————————————————
# Helper Functions
# ———————————————————————————————————————————————————————————————

def is_alpha(c: Char) -> Bool
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
end

def is_digit(c: Char) -> Bool
  c >= '0' && c <= '9'
end

def hex_digit(n: u8) -> Char
  if n < 10 then
    ('0' as u8 + n) as Char
  else
    ('A' as u8 + n - 10) as Char
  end
end

def hex_value(c: Char) -> u8
  if c >= '0' && c <= '9' then
    c as u8 - '0' as u8
  else if c >= 'a' && c <= 'f' then
    c as u8 - 'a' as u8 + 10
  else if c >= 'A' && c <= 'F' then
    c as u8 - 'A' as u8 + 10
  else
    255
  end end end
end

def char_to_utf8(c: Char) -> Vec[u8]
  let mut bytes = Vec::new()
  let code = c as UInt
  
  if code < 0x80 then
    bytes.push(code as u8)
  else if code < 0x800 then
    bytes.push((0xC0 | (code >> 6)) as u8)
    bytes.push((0x80 | (code & 0x3F)) as u8)
  else if code < 0x10000 then
    bytes.push((0xE0 | (code >> 12)) as u8)
    bytes.push((0x80 | ((code >> 6) & 0x3F)) as u8)
    bytes.push((0x80 | (code & 0x3F)) as u8)
  else
    bytes.push((0xF0 | (code >> 18)) as u8)
    bytes.push((0x80 | ((code >> 12) & 0x3F)) as u8)
    bytes.push((0x80 | ((code >> 6) & 0x3F)) as u8)
    bytes.push((0x80 | (code & 0x3F)) as u8)
  end end end
  
  bytes
end

def parse_port(s: &String) -> Result[Option[UInt], UrlError]
  if s.is_empty() then
    return Result::Ok(Option::None)
  end
  
  let mut port: UInt = 0
  for c in s.chars() do
    if c >= '0' && c <= '9' then
      port = port * 10 + (c as UInt - '0' as UInt)
      if port > 65535 then
        return Result::Err(UrlError::InvalidPort)
      end
    else
      return Result::Err(UrlError::InvalidPort)
    end
  end
  
  Result::Ok(Option::Some(port))
end
