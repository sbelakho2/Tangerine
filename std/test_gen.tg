# Tangerine Standard Library — std::test_gen
# Automatic test generation and test case suggestion
#
# This module provides types and functions for generating test cases
# from contracts, function signatures, and code analysis.

# [METADATA]
# module: tg::test_gen
# status: alpha
# effects: [Io]
# capabilities: []
# error_codes: [Internal]
# description: "Generative testing and automated test case suggestion based on contracts and types."
# examples:
#   - |
#     use std::test_gen::{generate_test_suite}
#     let suite = generate_test_suite(my_source, "my_mod")

use std::ctx
use std::gfx_errors::{Error, ErrorCode, TestError}
use std::collections::{Vec, Map, Set}
use std::contracts::{Contract, ContractKind}

# ———————————————————————————————————————————————————————————————
# Core Types
# ———————————————————————————————————————————————————————————————

enum TestKind
  Unit
  Property
  Boundary
  Contract
  Fuzz
end

struct TestCase
  name: String
  kind: TestKind
  fn_under_test: String
  inputs: Vec[TestInput]
  expected: TestExpectation
  generated: Bool
end

struct TestInput
  param_name: String
  value: String
  description: Option[String]
end

enum TestExpectation
  Returns(String)
  Panics(String)
  Satisfies(String)    # Postcondition expression
  NoException
end

struct TestSuite
  name: String
  tests: Vec[TestCase]
  coverage_targets: Vec[String]
end

struct FunctionInfo
  name: String
  params: Vec[ParamInfo]
  return_type: String
  contracts: Vec[Contract]
end

struct ParamInfo
  name: String
  ty: String
end

# ———————————————————————————————————————————————————————————————
# Function Analysis
# ———————————————————————————————————————————————————————————————

def extract_function_info(source: String, fn_name: String) -> Option[FunctionInfo]
  let lines = source.lines()
  
  for line in lines
    let trimmed = line.trim()
    if trimmed.starts_with("def " + fn_name + "(")
      let params = parse_params(trimmed)
      let ret_type = parse_return_type(trimmed)
      let contracts = extract_function_contracts(source, fn_name)
      
      return Option::Some(FunctionInfo {
        name: fn_name,
        params: params,
        return_type: ret_type,
        contracts: contracts
      })
    end
  end
  
  Option::None
end

def parse_params(def_line: String) -> Vec[ParamInfo]
  let mut params = Vec::new()
  let paren_start = def_line.find("(").unwrap_or(0) + 1
  let paren_end = def_line.find(")").unwrap_or(def_line.len())
  let param_str = def_line.slice(paren_start, paren_end)
  
  let parts = param_str.split(",")
  for part in parts
    let trimmed = part.trim()
    if trimmed.len() > 0
      let colon_idx = trimmed.find(":").unwrap_or(trimmed.len())
      let name = trimmed.slice(0, colon_idx).trim()
      let ty = if colon_idx < trimmed.len()
        trimmed.slice(colon_idx + 1, trimmed.len()).trim()
      else
        "Unknown"
      end
      params.push(ParamInfo { name: name, ty: ty })
    end
  end
  
  params
end

def parse_return_type(def_line: String) -> String
  let arrow_idx = def_line.find("->")
  match arrow_idx
    when Option::Some(idx) then
      let rest = def_line.slice(idx + 2, def_line.len()).trim()
      let end_idx = rest.find_first_of(" \n").unwrap_or(rest.len())
      rest.slice(0, end_idx)
    when Option::None then
      "Unit"
  end
end

def extract_function_contracts(source: String, fn_name: String) -> Vec[Contract]
  let mut contracts = Vec::new()
  let lines = source.lines()
  let mut in_function = false
  
  for line in lines
    let trimmed = line.trim()
    
    if trimmed.starts_with("def " + fn_name + "(")
      in_function = true
    elsif in_function
      if trimmed.starts_with("pre ")
        let expr = trimmed.slice(4, trimmed.len())
        contracts.push(Contract {
          kind: ContractKind::Pre,
          expr: expr,
          has_message: false,
          message: ""
        })
      elsif trimmed.starts_with("post ")
        let expr = trimmed.slice(5, trimmed.len())
        contracts.push(Contract {
          kind: ContractKind::Post,
          expr: expr,
          has_message: false,
          message: ""
        })
      elsif !trimmed.starts_with("#") && !trimmed.starts_with("invariant") && trimmed.len() > 0
        # Body started, stop looking for contracts
        in_function = false
      end
    end
  end
  
  contracts
end

# ———————————————————————————————————————————————————————————————
# Test Case Generation
# ———————————————————————————————————————————————————————————————

def generate_boundary_values(ty: String) -> Vec[String]
  match ty
    when "Int" then ["0", "1", "-1", "2147483647", "-2147483648"]
    when "UInt" then ["0", "1", "4294967295"]
    when "Bool" then ["true", "false"]
    when "String" then ["\"\"", "\"a\"", "\"hello world\""]
    when "Float" then ["0.0", "1.0", "-1.0", "Float::MAX", "Float::MIN"]
    when _ then ["default"]
  end
end

def generate_tests_from_info(info: FunctionInfo) -> Vec[TestCase]
  let mut tests = Vec::new()
  
  # Generate boundary value tests
  tests.append(generate_boundary_tests(info))
  
  # Generate contract-based tests
  tests.append(generate_contract_tests(info))
  
  tests
end

def generate_boundary_tests(info: FunctionInfo) -> Vec[TestCase]
  let mut tests = Vec::new()
  let mut test_num = 0
  
  for param in info.params
    let boundary_vals = generate_boundary_values(param.ty)
    
    for val in boundary_vals
      test_num = test_num + 1
      let mut inputs = Vec::new()
      
      # Set this param to boundary value, others to defaults
      for p in info.params
        if p.name == param.name
          inputs.push(TestInput {
            param_name: p.name,
            value: val,
            description: Option::Some("boundary value")
          })
        else
          inputs.push(TestInput {
            param_name: p.name,
            value: default_value_for_type(p.ty),
            description: Option::None
          })
        end
      end
      
      tests.push(TestCase {
        name: "test_" + info.name + "_boundary_" + test_num.to_string(),
        kind: TestKind::Boundary,
        fn_under_test: info.name,
        inputs: inputs,
        expected: TestExpectation::NoException,
        generated: true
      })
    end
  end
  
  tests
end

def generate_contract_tests(info: FunctionInfo) -> Vec[TestCase]
  let mut tests = Vec::new()
  
  for contract in info.contracts
    match contract.kind
      when ContractKind::Pre then
        # Generate test that violates precondition (should panic)
        let inputs = generate_violating_inputs(contract.expr, info.params)
        tests.push(TestCase {
          name: "test_" + info.name + "_pre_violation",
          kind: TestKind::Contract,
          fn_under_test: info.name,
          inputs: inputs,
          expected: TestExpectation::Panics("Precondition failed"),
          generated: true
        })
        
        # Generate test that satisfies precondition
        let valid_inputs = generate_satisfying_inputs(contract.expr, info.params)
        tests.push(TestCase {
          name: "test_" + info.name + "_pre_satisfied",
          kind: TestKind::Contract,
          fn_under_test: info.name,
          inputs: valid_inputs,
          expected: TestExpectation::NoException,
          generated: true
        })
        
      when ContractKind::Post then
        # Generate test to verify postcondition
        let inputs = generate_default_inputs(info.params)
        tests.push(TestCase {
          name: "test_" + info.name + "_post_check",
          kind: TestKind::Contract,
          fn_under_test: info.name,
          inputs: inputs,
          expected: TestExpectation::Satisfies(contract.expr),
          generated: true
        })
        
      when ContractKind::Invariant then
        # Invariant tests - check before and after
        ()
    end
  end
  
  tests
end

def default_value_for_type(ty: String) -> String
  match ty
    when "Int" then "0"
    when "UInt" then "0"
    when "Bool" then "true"
    when "String" then "\"\""
    when "Float" then "0.0"
    when _ then "default"
  end
end

def generate_default_inputs(params: Vec[ParamInfo]) -> Vec[TestInput]
  let mut inputs = Vec::new()
  for p in params
    inputs.push(TestInput {
      param_name: p.name,
      value: default_value_for_type(p.ty),
      description: Option::None
    })
  end
  inputs
end

def generate_violating_inputs(pre_expr: String, params: Vec[ParamInfo]) -> Vec[TestInput]
  let mut inputs = Vec::new()
  
  # Simple heuristic: if precondition is "x != 0", use 0
  # if precondition is "x > 0", use 0 or -1
  for p in params
    let val = if pre_expr.contains(p.name + " != 0") || pre_expr.contains(p.name + " > 0")
      "0"
    elsif pre_expr.contains(p.name + " >= 0")
      "-1"
    elsif pre_expr.contains(p.name + " < ")
      "999999"
    else
      default_value_for_type(p.ty)
    end
    
    inputs.push(TestInput {
      param_name: p.name,
      value: val,
      description: Option::Some("violating value")
    })
  end
  
  inputs
end

def generate_satisfying_inputs(pre_expr: String, params: Vec[ParamInfo]) -> Vec[TestInput]
  let mut inputs = Vec::new()
  
  for p in params
    let val = if pre_expr.contains(p.name + " != 0") || pre_expr.contains(p.name + " > 0")
      "1"
    elsif pre_expr.contains(p.name + " >= 0")
      "0"
    elsif pre_expr.contains(p.name + " < ")
      "0"
    else
      default_value_for_type(p.ty)
    end
    
    inputs.push(TestInput {
      param_name: p.name,
      value: val,
      description: Option::Some("satisfying value")
    })
  end
  
  inputs
end

# ———————————————————————————————————————————————————————————————
# Test Suite Generation
# ———————————————————————————————————————————————————————————————

def generate_test_suite(source: String, module_name: String) -> TestSuite
  let mut tests = Vec::new()
  let fn_names = extract_all_function_names(source)
  
  for name in fn_names
    match extract_function_info(source, name)
      when Option::Some(info) then
        tests.append(generate_tests_from_info(info))
      when Option::None then ()
    end
  end
  
  TestSuite {
    name: module_name + "_tests",
    tests: tests,
    coverage_targets: fn_names
  }
end

def extract_all_function_names(source: String) -> Vec[String]
  let mut names = Vec::new()
  let lines = source.lines()
  
  for line in lines
    let trimmed = line.trim()
    if trimmed.starts_with("def ")
      let rest = trimmed.slice(4, trimmed.len())
      let paren_idx = rest.find("(").unwrap_or(rest.len())
      let name = rest.slice(0, paren_idx)
      names.push(name)
    end
  end
  
  names
end

# ———————————————————————————————————————————————————————————————
# Code Generation
# ———————————————————————————————————————————————————————————————

def format_test_case(tc: TestCase) -> String
  let mut lines = Vec::new()
  lines.push("@test")
  lines.push("def " + tc.name + "() -> Unit")
  
  # Build call arguments
  let mut args = Vec::new()
  for input in tc.inputs
    args.push(input.value.clone())
  end
  let call = tc.fn_under_test + "(" + args.join(", ") + ")"
  
  match tc.expected
    when TestExpectation::Returns(val) then
      lines.push("  assert_eq(" + call + ", " + val + ")")
    when TestExpectation::Panics(msg) then
      lines.push("  assert_panics(|| " + call + ", \"" + msg + "\")")
    when TestExpectation::Satisfies(expr) then
      lines.push("  let result = " + call)
      lines.push("  assert(" + expr.replace("$result", "result") + ")")
    when TestExpectation::NoException then
      lines.push("  let _ = " + call)
  end
  
  lines.push("end")
  lines.join("\n")
end

def format_test_suite(suite: TestSuite) -> String
  let mut lines = Vec::new()
  lines.push("# Auto-generated tests for " + suite.name)
  lines.push("# Coverage targets: " + suite.coverage_targets.join(", "))
  lines.push("")
  
  for tc in suite.tests
    lines.push(format_test_case(tc))
    lines.push("")
  end
  
  lines.join("\n")
end

# ———————————————————————————————————————————————————————————————
# Pretty Printing
# ———————————————————————————————————————————————————————————————

def format_test_summary(suite: TestSuite) -> String
  let mut by_kind: Map[String, Int] = Map::new()
  
  for tc in suite.tests
    let kind_name = match tc.kind
      when TestKind::Unit then "unit"
      when TestKind::Property then "property"
      when TestKind::Boundary then "boundary"
      when TestKind::Contract then "contract"
      when TestKind::Fuzz then "fuzz"
    end
    
    let count = by_kind.get(&kind_name).cloned().unwrap_or(0)
    by_kind.insert(kind_name, count + 1)
  end
  
  let mut lines = Vec::new()
  lines.push("=== Test Suite: " + suite.name + " ===")
  lines.push("Total tests: " + suite.tests.len().to_string())
  
  for entry in by_kind.entries()
    lines.push("  " + entry.key + ": " + entry.value.to_string())
  end
  
  lines.push("Functions covered: " + suite.coverage_targets.len().to_string())
  
  lines.join("\n")
end
