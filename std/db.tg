# Tangerine Standard Library — Database
#
# SQL database abstractions with SQLite and PostgreSQL drivers.
#
# Usage:
#   let db = Sqlite::open("app.db")?
#   db.execute("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")?
#   let rows = db.query("SELECT * FROM users WHERE age > ?", &[&42])?

use std::core::{Option, Result, Vec, String, Bool, Int, StrView}
use std::collections::{Map, VecDeque}
# The blocking pool (blocking-pool design): the N bounded worker threads from
# std::thread, the blocking job queue, the BlockingFuture result delivery
# (the synchronized result cell + the executor's external-wake bridge).
use std::thread::{ThreadBuilder, JoinHandle, AtomicBool, Ordering, Once, once_new, atomic_bool_new, atomic_int_new}
use std::async::{ExecutorInner, Future, Poll, Context, global_executor_inner}

# ═══════════════════════════════════════════════════════════════
# PART 1: DATABASE ABSTRACTIONS
# ═══════════════════════════════════════════════════════════════

# ———————————————————————————————————————————————————————————————
# Database Types
# ———————————————————————————————————————————————————————————————

trait Connection
  def execute(inout self: Self, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  def query(self: Self, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  def begin_transaction(inout self: Self) -> Result[Transaction, DbError]
  def prepare(inout self: Self, sql: str) -> Result[Statement, DbError]
  def close(inout self: Self) -> Result[Unit, DbError]
end

trait ToSqlParam
  def to_sql_param(self: Self) -> SqlValue
end

trait FromSqlValue
  def from_sql_value(value: SqlValue) -> Result[Self, DbError]
end

enum SqlValue
  Null
  Integer(i64)
  Float(f64)
  Text(String)
  Blob(Vec[u8])
  Bool(Bool)
  Timestamp(i64)
end

enum DbError
  ConnectionFailed(String)
  QueryFailed(String)
  BindError(UInt, String)
  TypeMismatch(String)
  TransactionError(String)
  NotFound
  ConstraintViolation(String)
  Timeout
  Closed
  Busy(String)
  Internal(String)
end

def db_error_message(e: DbError) -> String
  match e
  when DbError::ConnectionFailed(s) then "connection failed: " + s.clone()
  when DbError::QueryFailed(s) then "query failed: " + s.clone()
  when DbError::BindError(idx, s) then "bind error at " + idx.to_string() + ": " + s.clone()
  when DbError::TypeMismatch(s) then "type mismatch: " + s.clone()
  when DbError::TransactionError(s) then "transaction error: " + s.clone()
  when DbError::NotFound then "not found"
  when DbError::ConstraintViolation(s) then "constraint violation: " + s.clone()
  when DbError::Timeout then "connection timeout"
  when DbError::Closed then "connection closed"
  when DbError::Busy(s) then "connection busy: " + s.clone()
  when DbError::Internal(s) then "internal error: " + s.clone()
  end
end

impl Error for DbError
  def message(self: DbError) -> String
    db_error_message(self)
  end
end

# ToSqlParam implementations
impl ToSqlParam for Int
  def to_sql_param(self: Int) -> SqlValue
    SqlValue::Integer(self as i64)
  end
end

impl ToSqlParam for i64
  def to_sql_param(self: i64) -> SqlValue
    SqlValue::Integer(self)
  end
end

impl ToSqlParam for f64
  def to_sql_param(self: f64) -> SqlValue
    SqlValue::Float(self)
  end
end

impl ToSqlParam for String
  def to_sql_param(self: String) -> SqlValue
    SqlValue::Text(self.clone())
  end
end

impl ToSqlParam for StrView
  def to_sql_param(self: StrView) -> SqlValue
    SqlValue::Text(String::from_str_view(self))
  end
end

impl ToSqlParam for Bool
  def to_sql_param(self: Bool) -> SqlValue
    SqlValue::Bool(self)
  end
end

impl ToSqlParam for Vec[u8]
  def to_sql_param(self: Vec[u8]) -> SqlValue
    SqlValue::Blob(self.clone())
  end
end

impl[T] ToSqlParam for Option[T] where T: ToSqlParam
  def to_sql_param(self: Option[T]) -> SqlValue
    match self
    when Option::Some(v) then v.to_sql_param()
    when Option::None then SqlValue::Null
    end
  end
end

# FromSqlValue implementations
impl FromSqlValue for Int
  def from_sql_value(value: SqlValue) -> Result[Int, DbError]
    match value
    when SqlValue::Integer(i) then Result::Ok(i as Int)
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to Int; use Option[Int]"))
    when _ then Result::Err(DbError::TypeMismatch("expected integer"))
    end
  end
end

impl FromSqlValue for i64
  def from_sql_value(value: SqlValue) -> Result[i64, DbError]
    match value
    when SqlValue::Integer(i) then Result::Ok(i)
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to i64; use Option[i64]"))
    when _ then Result::Err(DbError::TypeMismatch("expected integer"))
    end
  end
end

impl FromSqlValue for f64
  def from_sql_value(value: SqlValue) -> Result[f64, DbError]
    match value
    when SqlValue::Float(f) then Result::Ok(f)
    when SqlValue::Integer(i) then Result::Ok(i as f64)
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to f64; use Option[f64]"))
    when _ then Result::Err(DbError::TypeMismatch("expected float"))
    end
  end
end

impl FromSqlValue for String
  def from_sql_value(value: SqlValue) -> Result[String, DbError]
    match value
    when SqlValue::Text(s) then Result::Ok(s.clone())
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to String; use Option[String]"))
    when _ then Result::Err(DbError::TypeMismatch("expected text"))
    end
  end
end

impl FromSqlValue for Bool
  def from_sql_value(value: SqlValue) -> Result[Bool, DbError]
    match value
    when SqlValue::Bool(b) then Result::Ok(b)
    when SqlValue::Integer(i) then Result::Ok(i != 0)
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to Bool; use Option[Bool]"))
    when _ then Result::Err(DbError::TypeMismatch("expected bool"))
    end
  end
end

impl FromSqlValue for Vec[u8]
  def from_sql_value(value: SqlValue) -> Result[Vec[u8], DbError]
    match value
    when SqlValue::Blob(b) then Result::Ok(b.clone())
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to Vec[u8]; use Option[Vec[u8]]"))
    when _ then Result::Err(DbError::TypeMismatch("expected blob"))
    end
  end
end

impl[T] FromSqlValue for Option[T] where T: FromSqlValue
  def from_sql_value(value: SqlValue) -> Result[Option[T], DbError]
    match value
    when SqlValue::Null then Result::Ok(Option::None)
    when _ then T::from_sql_value(value).map(Option::Some)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Rows and Row
# ———————————————————————————————————————————————————————————————

struct Rows
  columns: Vec[String]
  data: Vec[Vec[SqlValue]]
  pos: UInt
end

impl Rows
  def new(columns: Vec[String], data: Vec[Vec[SqlValue]]) -> Rows
    Rows { columns: columns, data: data, pos: 0 }
  end
  
  def column_count(self: Rows) -> UInt
    self.columns.len()
  end
  
  def column_names(self: Rows) -> Vec[String]
    var out = Vec::new()
    for col in self.columns do
      out.push(col.clone())
    end
    out
  end
  
  def row_count(self: Rows) -> UInt
    self.data.len()
  end
  
  def is_empty(self: Rows) -> Bool
    self.data.is_empty()
  end
end

impl Iterator for Rows
  type Item = Row
  
  def next(inout self: Rows) -> Option[Row]
    if self.pos < self.data.len() then
      var columns = Vec::new()
      for col in self.columns do
        columns.push(col.clone())
      end
      var values = Vec::new()
      var vi = 0
      while vi < self.data[self.pos].len() do
        values.push(self.data[self.pos][vi].clone())
        vi = vi + 1
      end
      let row = Row {
        columns: columns,
        values: values
      }
      self.pos = self.pos + 1
      Option::Some(row)
    else
      Option::None
    end
  end
end

struct Row
  columns: Vec[String]
  values: Vec[SqlValue]
end

impl Row
  def get[T](self: Row, index: UInt) -> Result[T, DbError] where T: FromSqlValue
    if index < self.values.len() then
      T::from_sql_value(&self.values[index])
    else
      Result::Err(DbError::TypeMismatch("column index " + index.to_string() + " out of bounds"))
    end
  end
  
  def get_by_name[T](self: Row, name: str) -> Result[T, DbError] where T: FromSqlValue
    for (i, col) in self.columns.iter().enumerate() do
      if col == name then
        return self.get(i)
      end
    end
    Result::Err(DbError::TypeMismatch("column '" + name.to_string() + "' not found"))
  end
  
  def get_value(self: Row, index: UInt) -> Option[SqlValue]
    if index < self.values.len() then
      Option::Some(self.values[index].clone())
    else
      Option::None
    end
  end
end

# ———————————————————————————————————————————————————————————————
# The ConnectionInner lifecycle (connection-lifetime design)
# ———————————————————————————————————————————————————————————————
# Every driver's inner (SqliteInner / PostgresInner / MysqlInner) gains
# the `life` field: the SAME Arc[ConnLifetime] cell the connection value
# AND every live child (the Statement / Transaction lifetime tokens) hold.
# The cell carries:
#   state    — the Open/Closing/Closed lifecycle state (an atomic int
#              code of the ConnState enum; the connection operations read
#              it before touching the native handle, and every
#              Statement/Transaction operation reads it through its
#              token);
#   children — the count of live statements/transactions holding the
#              connection: incremented at prepare/begin_transaction,
#              decremented at the child's drop. close() reads it for the
#              BUSY POLICY — live children make close() fail with
#              DbError::Busy and the native handle stays owned; the
#              native close only runs when the count is zero (or at the
#              inner's Drop, which the children's pins keep from running
#              while any child lives).
enum ConnState
  Open
  Closing
  Closed
end

def conn_state_to_int(state: ConnState) -> Int
  match state
  when ConnState::Open then 0
  when ConnState::Closing then 1
  when ConnState::Closed then 2
  end
end

struct ConnLifetime
  state: AtomicInt
  children: AtomicInt
end

def conn_lifetime_new() -> Arc[ConnLifetime]
  Arc::new(ConnLifetime {
    state: atomic_int_new(conn_state_to_int(ConnState::Open)),
    children: atomic_int_new(0)
  })
end

def conn_lifetime_open(life: Arc[ConnLifetime]) -> Bool
  life.ptr.as_ref().state.load(Ordering::Acquire) == conn_state_to_int(ConnState::Open)
end

# The state check every connection-level operation runs before touching
# the native handle: a Closing/Closed connection rejects the operation
# with DbError::Closed.
def conn_lifetime_check(life: Arc[ConnLifetime]) -> Result[Unit, DbError]
  if conn_lifetime_open(life) then
    Result::Ok(())
  else
    Result::Err(DbError::Closed)
  end
end

# The child registration: prepare/begin_transaction increment the count;
# the child's drop decrements it (the drop reaches the shared cell
# through the token's own Arc clone of the cell).
def conn_lifetime_register_child(life: Arc[ConnLifetime]) -> Unit
  let _ = life.ptr.as_ref().children.fetch_add(1, Ordering::Relaxed)
end

# THE CONNECTION-LIFETIME TOKEN (connection-lifetime design): carried by every
# Statement/Transaction value. `pin` — the type-erased Arc clone of the
# connection inner (the heap block — and with it the native handle —
# stays alive while the child lives, even after the connection value
# drops); `life` — the SAME Arc[ConnLifetime] cell the connection inner
# holds, so the child's operations can check the connection state and the
# child's drop can release its registration.
struct ConnToken
  pin: Arc[Box[Any]]
  life: Arc[ConnLifetime]
end

def conn_token_new(pin: Arc[Box[Any]], life: Arc[ConnLifetime]) -> ConnToken
  ConnToken { pin: pin, life: life }
end

# ———————————————————————————————————————————————————————————————
# Prepared Statement
# ———————————————————————————————————————————————————————————————

struct Statement
  sql: String
  handle: Ptr[Unit]
  driver: DriverKind
  # The backend-specific prepared-statement state:
  #   conn_handle — the owning connection's native handle (the Postgres
  #                 PgConnection pointer; the statement keeps it alive for
  #                 PQexecPrepared / DEALLOCATE and for the Drop cleanup)
  #   param_count — the prepared statement's parameter metadata (the
  #                 Postgres nParams; Sqlite/Mysql keep 0)
  #   stmt_name   — the statement identity: the Postgres server-side
  #                 prepared-statement name (Sqlite/Mysql keep the native
  #                 statement pointer in `handle` and an empty name)
  conn_handle: Ptr[Unit]
  param_count: UInt
  stmt_name: String
  # The connection-lifetime token (connection-lifetime design): the pin keeps the
  # connection inner (and the native handle) alive while the statement
  # lives; the life cell is the shared Open/Closing/Closed state + the
  # child count — the statement registered at prepare() and releases its
  # registration at its drop. Every statement operation checks the state
  # through the token before touching the native statement.
  conn_token: ConnToken
end

impl Statement
  def execute(inout self: Statement, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    conn_lifetime_check(self.conn_token.life)?
    match self.driver
    when DriverKind::Sqlite then sqlite_stmt_execute(self, params)
    when DriverKind::Postgres then postgres_stmt_execute(self, params)
    when DriverKind::Mysql then mysql_stmt_run(self, params)
    end
  end
  
  def query(self: Statement, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    conn_lifetime_check(self.conn_token.life)?
    match self.driver
    when DriverKind::Sqlite then sqlite_stmt_query(self, params)
    when DriverKind::Postgres then postgres_stmt_query(self, params)
    when DriverKind::Mysql then mysql_stmt_query(self, params)
    end
  end
  
  def finalize(inout self: Statement) -> Result[Unit, DbError]
    match self.driver
    when DriverKind::Sqlite then sqlite_stmt_finalize(self)
    when DriverKind::Postgres then postgres_stmt_finalize(self)
    when DriverKind::Mysql then mysql_stmt_finalize(self)
    end
  end
end

impl Drop for Statement
  def drop(inout self: Statement) -> Unit
    match self.driver
    when DriverKind::Sqlite then
      if !self.handle.is_null() then
        let _ = unsafe "FFI boundary" do sqlite3_finalize(self.handle) end
        self.handle = null_ptr()
      end
    when DriverKind::Postgres then
      # The deterministic server-side cleanup: DEALLOCATE the named
      # prepared statement and PQclear any result, then null the state.
      let _ = postgres_stmt_finalize(self)
    when DriverKind::Mysql then
      if !self.handle.is_null() then
        let _ = unsafe "FFI boundary" do mysql_stmt_close(self.handle) end
        self.handle = null_ptr()
      end
    end
    # The child-count release (connection-lifetime design): the statement's
    # registration in the shared ConnLifetime cell is released at the
    # drop — the count the connection's close() reads for the Busy
    # policy.
    let _ = self.conn_token.life.ptr.as_ref().children.fetch_sub(1, Ordering::Relaxed)
  end
end

# ———————————————————————————————————————————————————————————————
# Transaction
# ———————————————————————————————————————————————————————————————

struct Transaction
  conn_handle: Ptr[Unit]
  # The connection-lifetime token (connection-lifetime design): the pin keeps the
  # connection inner (and the native handle) alive while the transaction
  # lives; the life cell is the shared Open/Closing/Closed state + the
  # child count — the transaction registered at begin_transaction() and
  # releases its registration at its drop. Every transaction operation
  # checks the state through the token before touching the native handle.
  conn_token: ConnToken
  driver: DriverKind
  
  finished: Bool
end

impl Transaction
  def execute(inout self: Transaction, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    if self.finished then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    conn_lifetime_check(self.conn_token.life)?
    
    match self.driver
    when DriverKind::Sqlite then sqlite_execute_raw(self.conn_handle, sql, params)
    when DriverKind::Postgres then postgres_execute_raw(self.conn_handle, sql, params)
    when DriverKind::Mysql then mysql_execute_raw(self.conn_handle, sql, params)
    end
  end
  
  def query(self: Transaction, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    if self.finished then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    conn_lifetime_check(self.conn_token.life)?
    
    match self.driver
    when DriverKind::Sqlite then sqlite_query_raw(self.conn_handle, sql, params)
    when DriverKind::Postgres then postgres_query_raw(self.conn_handle, sql, params)
    when DriverKind::Mysql then mysql_query_raw(self.conn_handle, sql, params)
    end
  end
  
  def commit(inout self: Transaction) -> Result[Unit, DbError]
    if self.finished then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    conn_lifetime_check(self.conn_token.life)?
    
    let result = match self.driver
    when DriverKind::Sqlite then sqlite_execute_raw(self.conn_handle, "COMMIT", &[])
    when DriverKind::Postgres then postgres_execute_raw(self.conn_handle, "COMMIT", &[])
    when DriverKind::Mysql then mysql_execute_raw(self.conn_handle, "COMMIT", &[])
    end
    
    match result
    when Result::Ok(_) then
      self.finished = true
      Result::Ok(())
    when Result::Err(e) then Result::Err(e)
    end
  end
  
  def rollback(inout self: Transaction) -> Result[Unit, DbError]
    if self.finished then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    conn_lifetime_check(self.conn_token.life)?
    
    let result = match self.driver
    when DriverKind::Sqlite then sqlite_execute_raw(self.conn_handle, "ROLLBACK", &[])
    when DriverKind::Postgres then postgres_execute_raw(self.conn_handle, "ROLLBACK", &[])
    when DriverKind::Mysql then mysql_execute_raw(self.conn_handle, "ROLLBACK", &[])
    end
    
    match result
    when Result::Ok(_) then
      self.finished = true
      Result::Ok(())
    when Result::Err(e) then Result::Err(e)
    end
  end
end

impl Drop for Transaction
  def drop(inout self: Transaction) -> Unit
    if !self.finished then
      # Auto-rollback on drop
      let _ = self.rollback()
    end
    # The child-count release (connection-lifetime design): the transaction's
    # registration in the shared ConnLifetime cell is released at the
    # drop.
    let _ = self.conn_token.life.ptr.as_ref().children.fetch_sub(1, Ordering::Relaxed)
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 2: SQLITE DRIVER
# ═══════════════════════════════════════════════════════════════

# FFI bindings for SQLite
extern "C"
  def sqlite3_open(filename: Ptr[u8], ppDb: PtrMut[Ptr[Unit]]) -> i32
  def sqlite3_close(db: Ptr[Unit]) -> i32
  def sqlite3_exec(db: Ptr[Unit], sql: Ptr[u8], callback: Ptr[Unit], arg: Ptr[Unit], errmsg: PtrMut[Ptr[u8]]) -> i32
  def sqlite3_prepare_v2(db: Ptr[Unit], sql: Ptr[u8], nByte: i32, ppStmt: PtrMut[Ptr[Unit]], pzTail: PtrMut[Ptr[u8]]) -> i32
  def sqlite3_bind_int64(stmt: Ptr[Unit], idx: i32, value: i64) -> i32
  def sqlite3_bind_double(stmt: Ptr[Unit], idx: i32, value: f64) -> i32
  def sqlite3_bind_text(stmt: Ptr[Unit], idx: i32, text: Ptr[u8], n: i32, destructor: Ptr[Unit]) -> i32
  def sqlite3_bind_blob(stmt: Ptr[Unit], idx: i32, blob: Ptr[u8], n: i32, destructor: Ptr[Unit]) -> i32
  def sqlite3_bind_null(stmt: Ptr[Unit], idx: i32) -> i32
  def sqlite3_step(stmt: Ptr[Unit]) -> i32
  def sqlite3_reset(stmt: Ptr[Unit]) -> i32
  def sqlite3_finalize(stmt: Ptr[Unit]) -> i32
  def sqlite3_column_count(stmt: Ptr[Unit]) -> i32
  def sqlite3_column_name(stmt: Ptr[Unit], idx: i32) -> Ptr[u8]
  def sqlite3_column_type(stmt: Ptr[Unit], idx: i32) -> i32
  def sqlite3_column_int64(stmt: Ptr[Unit], idx: i32) -> i64
  def sqlite3_column_double(stmt: Ptr[Unit], idx: i32) -> f64
  def sqlite3_column_text(stmt: Ptr[Unit], idx: i32) -> Ptr[u8]
  def sqlite3_column_bytes(stmt: Ptr[Unit], idx: i32) -> i32
  def sqlite3_column_blob(stmt: Ptr[Unit], idx: i32) -> Ptr[u8]
  def sqlite3_changes(db: Ptr[Unit]) -> i32
  def sqlite3_errmsg(db: Ptr[Unit]) -> Ptr[u8]
  def sqlite3_free(ptr: Ptr[Unit]) -> ()
end

const SQLITE_OK: i32 = 0
const SQLITE_BUSY: i32 = 5
const SQLITE_LOCKED: i32 = 6
const SQLITE_READONLY: i32 = 8
const SQLITE_IOERR: i32 = 10
const SQLITE_FULL: i32 = 13
const SQLITE_CONSTRAINT: i32 = 19
const SQLITE_ROW: i32 = 100
const SQLITE_DONE: i32 = 101
const SQLITE_INTEGER: i32 = 1
const SQLITE_FLOAT: i32 = 2
const SQLITE_TEXT: i32 = 3
const SQLITE_BLOB: i32 = 4
const SQLITE_NULL: i32 = 5

def sqlite_transient_destructor() -> Ptr[Unit]
  Ptr { address: (-1 as Int) as UInt }
end

# The heap-stable Sqlite connection: the native handle and the shared
# ConnLifetime cell (the Open/Closing/Closed state + the child count)
# live in the Arc-owned inner (the inner's Drop runs sqlite3_close at the
# Arc's last-release), and statements/transactions hold a boxed clone of
# the inner Arc as their lifetime pin plus a clone of the life cell.
struct SqliteInner
  handle: Ptr[Unit]
  life: Arc[ConnLifetime]
end

struct Sqlite
  inner: Arc[SqliteInner]
end

impl Sqlite
  def open(path: str) -> Result[Sqlite, DbError]
    var handle: Ptr[Unit] = null_ptr()
    let path_cstr = path.to_cstring()
    
    let rc = unsafe "FFI boundary" do sqlite3_open(path_cstr.as_ptr(), &mut handle as PtrMut[Ptr[Unit]]) end
    
    if rc != SQLITE_OK then
      if handle.is_null() then
        return Result::Err(DbError::ConnectionFailed("sqlite3_open failed: out of memory"))
      end
      let err_msg = sqlite_errmsg(handle)
      unsafe "FFI boundary" do sqlite3_close(handle) end
      return Result::Err(DbError::ConnectionFailed(err_msg))
    end
    
    Result::Ok(Sqlite { inner: Arc::new(SqliteInner { handle: handle, life: conn_lifetime_new() }) })
  end
  
  def open_memory() -> Result[Sqlite, DbError]
    Sqlite::open(":memory:")
  end
end

impl Connection for Sqlite
  def execute(inout self: Sqlite, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    conn_lifetime_check(self.inner.ptr.as_ref().life)?
    sqlite_execute_raw(self.inner.ptr.as_ref().handle, sql, params)
  end
  
  def query(self: Sqlite, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    conn_lifetime_check(self.inner.ptr.as_ref().life)?
    sqlite_query_raw(self.inner.ptr.as_ref().handle, sql, params)
  end
  
  def begin_transaction(inout self: Sqlite) -> Result[Transaction, DbError]
    let life = self.inner.ptr.as_ref().life.clone()
    conn_lifetime_check(life)?
    sqlite_execute_raw(self.inner.ptr.as_ref().handle, "BEGIN TRANSACTION", &[])?
    conn_lifetime_register_child(life)
    Result::Ok(Transaction {
      conn_handle: self.inner.ptr.as_ref().handle,
      conn_token: ConnToken { pin: Arc::new(Box::new(self.inner.clone())), life: life },
      driver: DriverKind::Sqlite,
      finished: false
    })
  end
  
  def prepare(inout self: Sqlite, sql: str) -> Result[Statement, DbError]
    let life = self.inner.ptr.as_ref().life.clone()
    conn_lifetime_check(life)?
    var stmt_handle: Ptr[Unit] = null_ptr()
    let sql_cstr = sql.to_cstring()
    
    let rc = unsafe "FFI boundary" do
      sqlite3_prepare_v2(
        self.inner.ptr.as_ref().handle,
        sql_cstr.as_ptr(),
        -1,
        &mut stmt_handle as PtrMut[Ptr[Unit]],
        null_ptr() as PtrMut[Ptr[u8]]
      )
    end
    
    if rc != SQLITE_OK then
      return Result::Err(sqlite_error_from_code(rc, sqlite_errmsg(self.inner.ptr.as_ref().handle)))
    end
    
    conn_lifetime_register_child(life)
    Result::Ok(Statement {
      sql: sql.to_string(),
      handle: stmt_handle,
      driver: DriverKind::Sqlite,
      conn_handle: null_ptr(),
      param_count: 0,
      stmt_name: String::new(),
      conn_token: ConnToken { pin: Arc::new(Box::new(self.inner.clone())), life: life }
    })
  end
  
  def close(inout self: Sqlite) -> Result[Unit, DbError]
    # THE BUSY POLICY (connection-lifetime design): live statements/transactions (the
    # child count in the shared ConnLifetime cell) block the close — the
    # native handle stays owned, the connection stays Open, and the
    # children keep working. The native close only runs when the count is
    # zero.
    let inner = self.inner.ptr.as_ref()
    let life = inner.life.clone()
    if life.ptr.as_ref().children.load(Ordering::Acquire) > 0 then
      return Result::Err(DbError::Busy("connection has live statements or transactions".to_string()))
    end
    if inner.handle.is_null() then
      life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Closed), Ordering::Release)
      return Result::Ok(())
    end
    life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Closing), Ordering::Release)
    let handle = inner.handle
    let rc = unsafe "FFI boundary" do sqlite3_close(handle) end
    if rc != SQLITE_OK then
      # THE FAILED CLOSE KEEPS THE OWNERSHIP (connection-lifetime design): the handle
      # is cleared ONLY on SQLITE_OK — a failed close leaves the handle in
      # the inner (no leak; the inner's Drop retries sqlite3_close at the
      # Arc's last release) and the connection returns to Open.
      life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Open), Ordering::Release)
      return Result::Err(sqlite_error_from_code(rc, sqlite_errmsg(handle)))
    end
    inner.handle = null_ptr()
    life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Closed), Ordering::Release)
    Result::Ok(())
  end
end

impl Drop for SqliteInner
  def drop(inout self: SqliteInner) -> Unit
    if !self.handle.is_null() then
      unsafe "FFI boundary" do sqlite3_close(self.handle) end
      self.handle = null_ptr()
    end
  end
end

# SQLite helper functions
def sqlite_errmsg(handle: Ptr[Unit]) -> String
  let msg_ptr = unsafe "FFI boundary" do sqlite3_errmsg(handle) end
  if msg_ptr.is_null() then
    "unknown error".to_string()
  else
    unsafe "FFI boundary" do String::from_cstr(msg_ptr) end
  end
end

def sqlite_error_from_code(code: i32, msg: String) -> DbError
  match code
  when SQLITE_BUSY then DbError::Timeout
  when SQLITE_LOCKED then DbError::Timeout
  when SQLITE_CONSTRAINT then DbError::ConstraintViolation(msg)
  when SQLITE_READONLY then DbError::QueryFailed("readonly database: " + msg)
  when SQLITE_FULL then DbError::QueryFailed("database full: " + msg)
  when SQLITE_IOERR then DbError::Internal("sqlite io error: " + msg)
  when _ then DbError::QueryFailed(msg)
  end
end

def sqlite_execute_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  var stmt_handle: Ptr[Unit] = null_ptr()
  let sql_cstr = sql.to_cstring()
  
  let rc = unsafe "FFI boundary" do
    sqlite3_prepare_v2(handle, sql_cstr.as_ptr(), -1, &mut stmt_handle as PtrMut[Ptr[Unit]], null_ptr() as PtrMut[Ptr[u8]])
  end
  
  if rc != SQLITE_OK then
    return Result::Err(sqlite_error_from_code(rc, sqlite_errmsg(handle)))
  end
  
  # Bind parameters
  for (i, param) in params.iter().enumerate() do
    let idx = (i + 1) as i32
    let value = param.to_sql_param()
    let bind_rc = match value
    when SqlValue::Null then unsafe "FFI boundary" do sqlite3_bind_null(stmt_handle, idx) end
    when SqlValue::Integer(v) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, v) end
    when SqlValue::Float(v) then unsafe "FFI boundary" do sqlite3_bind_double(stmt_handle, idx, v) end
    when SqlValue::Text(s) then
      let cstr = s.to_cstring()
      unsafe "FFI boundary" do sqlite3_bind_text(stmt_handle, idx, cstr.as_ptr(), -1, sqlite_transient_destructor()) end
    when SqlValue::Blob(b) then
      unsafe "FFI boundary" do sqlite3_bind_blob(stmt_handle, idx, b.as_ptr(), b.len() as i32, sqlite_transient_destructor()) end
    when SqlValue::Bool(b) then
      unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, if b then 1 else 0 end) end
    when SqlValue::Timestamp(t) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, t) end
    end
    
    if bind_rc != SQLITE_OK then
      unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
      return Result::Err(DbError::BindError(i, sqlite_errmsg(handle)))
    end
  end
  
  # Execute
  let step_rc = unsafe "FFI boundary" do sqlite3_step(stmt_handle) end
  unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
  
  if step_rc != SQLITE_DONE && step_rc != SQLITE_ROW then
    return Result::Err(sqlite_error_from_code(step_rc, sqlite_errmsg(handle)))
  end
  
  let changes = unsafe "FFI boundary" do sqlite3_changes(handle) end
  Result::Ok(changes as UInt)
end

def sqlite_query_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  var stmt_handle: Ptr[Unit] = null_ptr()
  let sql_cstr = sql.to_cstring()
  
  let rc = unsafe "FFI boundary" do
    sqlite3_prepare_v2(handle, sql_cstr.as_ptr(), -1, &mut stmt_handle as PtrMut[Ptr[Unit]], null_ptr() as PtrMut[Ptr[u8]])
  end
  
  if rc != SQLITE_OK then
    return Result::Err(sqlite_error_from_code(rc, sqlite_errmsg(handle)))
  end
  
  # Bind parameters
  for (i, param) in params.iter().enumerate() do
    let idx = (i + 1) as i32
    let value = param.to_sql_param()
    let bind_rc = match value
    when SqlValue::Null then unsafe "FFI boundary" do sqlite3_bind_null(stmt_handle, idx) end
    when SqlValue::Integer(v) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, v) end
    when SqlValue::Float(v) then unsafe "FFI boundary" do sqlite3_bind_double(stmt_handle, idx, v) end
    when SqlValue::Text(s) then
      let cstr = s.to_cstring()
      unsafe "FFI boundary" do sqlite3_bind_text(stmt_handle, idx, cstr.as_ptr(), -1, sqlite_transient_destructor()) end
    when SqlValue::Blob(b) then
      unsafe "FFI boundary" do sqlite3_bind_blob(stmt_handle, idx, b.as_ptr(), b.len() as i32, sqlite_transient_destructor()) end
    when SqlValue::Bool(b) then
      unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, if b then 1 else 0 end) end
    when SqlValue::Timestamp(t) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, t) end
    end
    
    if bind_rc != SQLITE_OK then
      unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
      return Result::Err(DbError::BindError(i, sqlite_errmsg(handle)))
    end
  end
  
  # Get column names
  let col_count = unsafe "FFI boundary" do sqlite3_column_count(stmt_handle)  end as UInt
  var columns = Vec::new()
  for i in 0..col_count do
    let name_ptr = unsafe "FFI boundary" do sqlite3_column_name(stmt_handle, i as i32) end
    let name = if name_ptr.is_null() then
      "column_" + i.to_string()
    else
      unsafe "FFI boundary" do String::from_cstr(name_ptr) end
    end
    columns.push(name)
  end
  
  # Fetch rows
  var data = Vec::new()
  loop
    let step_rc = unsafe "FFI boundary" do sqlite3_step(stmt_handle) end
    
    if step_rc == SQLITE_ROW then
      var row_values = Vec::new()
      for i in 0..col_count do
        let col_type = unsafe "FFI boundary" do sqlite3_column_type(stmt_handle, i as i32) end
        let value = match col_type
        when SQLITE_INTEGER then
          SqlValue::Integer(unsafe "FFI boundary" do sqlite3_column_int64(stmt_handle, i as i32)  end)
        when SQLITE_FLOAT then
          SqlValue::Float(unsafe "FFI boundary" do sqlite3_column_double(stmt_handle, i as i32)  end)
        when SQLITE_TEXT then
          let text_ptr = unsafe "FFI boundary" do sqlite3_column_text(stmt_handle, i as i32) end
          let s = if text_ptr.is_null() then String::new() else unsafe "FFI boundary" do String::from_cstr(text_ptr as Ptr[u8])  end end
          SqlValue::Text(s)
        when SQLITE_BLOB then
          let blob_ptr = unsafe "FFI boundary" do sqlite3_column_blob(stmt_handle, i as i32) end
          let blob_len = unsafe "FFI boundary" do sqlite3_column_bytes(stmt_handle, i as i32)  end as UInt
          var blob = Vec::with_capacity(blob_len)
          if !blob_ptr.is_null() then
            for j in 0..blob_len do
              blob.push(unsafe "FFI boundary" do *(blob_ptr.offset(j as isize))  end)
            end
          end
          SqlValue::Blob(blob)
        when SQLITE_NULL | _ then SqlValue::Null
        end
        row_values.push(value)
      end
      data.push(row_values)
    elsif step_rc == SQLITE_DONE then
      break
    else
      unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
      return Result::Err(sqlite_error_from_code(step_rc, sqlite_errmsg(handle)))
    end
  end
  
  unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
  Result::Ok(Rows::new(columns, data))
end

def sqlite_stmt_execute(inout stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  conn_lifetime_check(stmt.conn_token.life)?
  if stmt.handle.is_null() then
    return Result::Err(DbError::QueryFailed("statement already finalized"))
  end
  let reset_rc = unsafe "FFI boundary" do sqlite3_reset(stmt.handle) end
  if reset_rc != SQLITE_OK then
    return Result::Err(sqlite_error_from_code(reset_rc, "statement reset failed".to_string()))
  end
  
  for (i, param) in params.iter().enumerate() do
    let idx = (i + 1) as i32
    let value = param.to_sql_param()
    let bind_rc = match value
    when SqlValue::Null then unsafe "FFI boundary" do sqlite3_bind_null(stmt.handle, idx) end
    when SqlValue::Integer(v) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, v) end
    when SqlValue::Float(v) then unsafe "FFI boundary" do sqlite3_bind_double(stmt.handle, idx, v) end
    when SqlValue::Text(s) then
      let cstr = s.to_cstring()
      unsafe "FFI boundary" do sqlite3_bind_text(stmt.handle, idx, cstr.as_ptr(), -1, sqlite_transient_destructor()) end
    when SqlValue::Blob(b) then
      unsafe "FFI boundary" do sqlite3_bind_blob(stmt.handle, idx, b.as_ptr(), b.len() as i32, sqlite_transient_destructor()) end
    when SqlValue::Bool(b) then
      unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, if b then 1 else 0 end) end
    when SqlValue::Timestamp(t) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, t) end
    end
    
    if bind_rc != SQLITE_OK then
      return Result::Err(sqlite_error_from_code(bind_rc, "bind parameter " + i.to_string() + " failed"))
    end
  end
  
  let step_rc = unsafe "FFI boundary" do sqlite3_step(stmt.handle) end
  if step_rc != SQLITE_DONE && step_rc != SQLITE_ROW then
    return Result::Err(sqlite_error_from_code(step_rc, "statement execution failed".to_string()))
  end
  
  Result::Ok(0)  # SQLite doesn't expose changes from statement
end

def sqlite_stmt_query(stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  conn_lifetime_check(stmt.conn_token.life)?
  if stmt.handle.is_null() then
    return Result::Err(DbError::QueryFailed("statement already finalized"))
  end
  # Similar to sqlite_query_raw but uses existing statement handle
  let reset_rc = unsafe "FFI boundary" do sqlite3_reset(stmt.handle) end
  if reset_rc != SQLITE_OK then
    return Result::Err(sqlite_error_from_code(reset_rc, "statement reset failed".to_string()))
  end
  
  for (i, param) in params.iter().enumerate() do
    let idx = (i + 1) as i32
    let value = param.to_sql_param()
    let bind_rc = match value
    when SqlValue::Null then unsafe "FFI boundary" do sqlite3_bind_null(stmt.handle, idx) end
    when SqlValue::Integer(v) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, v) end
    when SqlValue::Float(v) then unsafe "FFI boundary" do sqlite3_bind_double(stmt.handle, idx, v) end
    when SqlValue::Text(s) then
      let cstr = s.to_cstring()
      unsafe "FFI boundary" do sqlite3_bind_text(stmt.handle, idx, cstr.as_ptr(), -1, sqlite_transient_destructor()) end
    when SqlValue::Blob(b) then
      unsafe "FFI boundary" do sqlite3_bind_blob(stmt.handle, idx, b.as_ptr(), b.len() as i32, sqlite_transient_destructor()) end
    when SqlValue::Bool(b) then
      unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, if b then 1 else 0 end) end
    when SqlValue::Timestamp(t) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, t) end
    end
    
    if bind_rc != SQLITE_OK then
      return Result::Err(sqlite_error_from_code(bind_rc, "bind parameter " + i.to_string() + " failed"))
    end
  end
  
  let col_count = unsafe "FFI boundary" do sqlite3_column_count(stmt.handle)  end as UInt
  var columns = Vec::new()
  for i in 0..col_count do
    let name_ptr = unsafe "FFI boundary" do sqlite3_column_name(stmt.handle, i as i32) end
    let name = if name_ptr.is_null() then "column_" + i.to_string() else unsafe "FFI boundary" do String::from_cstr(name_ptr)  end end
    columns.push(name)
  end
  
  var data = Vec::new()
  loop
    let step_rc = unsafe "FFI boundary" do sqlite3_step(stmt.handle) end
    
    if step_rc == SQLITE_ROW then
      var row_values = Vec::new()
      for i in 0..col_count do
        let col_type = unsafe "FFI boundary" do sqlite3_column_type(stmt.handle, i as i32) end
        let value = match col_type
        when SQLITE_INTEGER then SqlValue::Integer(unsafe "FFI boundary" do sqlite3_column_int64(stmt.handle, i as i32)  end)
        when SQLITE_FLOAT then SqlValue::Float(unsafe "FFI boundary" do sqlite3_column_double(stmt.handle, i as i32)  end)
        when SQLITE_TEXT then
          let text_ptr = unsafe "FFI boundary" do sqlite3_column_text(stmt.handle, i as i32) end
          SqlValue::Text(if text_ptr.is_null() then
            String::new()
          else
            unsafe "FFI boundary" do String::from_cstr(text_ptr as Ptr[u8]) end
          end)
        when SQLITE_BLOB then
          let blob_ptr = unsafe "FFI boundary" do sqlite3_column_blob(stmt.handle, i as i32) end
          let blob_len = unsafe "FFI boundary" do sqlite3_column_bytes(stmt.handle, i as i32)  end as UInt
          var blob = Vec::with_capacity(blob_len)
          if !blob_ptr.is_null() then
            for j in 0..blob_len do
              blob.push(unsafe "FFI boundary" do *(blob_ptr.offset(j as isize))  end)
            end
          end
          SqlValue::Blob(blob)
        when _ then SqlValue::Null
        end
        row_values.push(value)
      end
      data.push(row_values)
    elsif step_rc == SQLITE_DONE then
      break
    else
      return Result::Err(sqlite_error_from_code(step_rc, "statement query failed".to_string()))
    end
  end
  
  Result::Ok(Rows::new(columns, data))
end

def sqlite_stmt_finalize(inout stmt: Statement) -> Result[Unit, DbError]
  # The state check: on a closed connection the native finalize is
  # skipped (a closed connection's statement can only be a stale handle —
  # the explicit close is blocked by the Busy policy while the statement
  # lives); the handle is nulled either way so the drop is a no-op.
  if !stmt.handle.is_null() && conn_lifetime_open(stmt.conn_token.life) then
    let rc = unsafe "FFI boundary" do sqlite3_finalize(stmt.handle) end
    if rc != SQLITE_OK then
      return Result::Err(sqlite_error_from_code(rc, "statement finalize failed".to_string()))
    end
  end
  stmt.handle = null_ptr()
  Result::Ok(())
end

# ═══════════════════════════════════════════════════════════════
# PART 3: POSTGRESQL DRIVER
# ═══════════════════════════════════════════════════════════════

# FFI bindings for libpq
extern "C"
  def PQconnectdb(conninfo: Ptr[u8]) -> Ptr[Unit]
  def PQstatus(conn: Ptr[Unit]) -> i32
  def PQfinish(conn: Ptr[Unit]) -> ()
  def PQerrorMessage(conn: Ptr[Unit]) -> Ptr[u8]
  def PQexec(conn: Ptr[Unit], query: Ptr[u8]) -> Ptr[Unit]
  def PQexecParams(conn: Ptr[Unit], command: Ptr[u8], nParams: i32,
                   paramTypes: Ptr[u32], paramValues: Ptr[Ptr[u8]],
                   paramLengths: Ptr[i32], paramFormats: Ptr[i32],
                   resultFormat: i32) -> Ptr[Unit]
  def PQprepare(conn: Ptr[Unit], stmtName: Ptr[u8], query: Ptr[u8],
                nParams: i32, paramTypes: Ptr[u32]) -> Ptr[Unit]
  def PQexecPrepared(conn: Ptr[Unit], stmtName: Ptr[u8], nParams: i32,
                     paramValues: Ptr[Ptr[u8]], paramLengths: Ptr[i32],
                     paramFormats: Ptr[i32], resultFormat: i32) -> Ptr[Unit]
  def PQresultStatus(res: Ptr[Unit]) -> i32
  def PQresultErrorMessage(res: Ptr[Unit]) -> Ptr[u8]
  def PQclear(res: Ptr[Unit]) -> ()
  def PQntuples(res: Ptr[Unit]) -> i32
  def PQnfields(res: Ptr[Unit]) -> i32
  def PQfname(res: Ptr[Unit], field_num: i32) -> Ptr[u8]
  def PQftype(res: Ptr[Unit], field_num: i32) -> u32
  def PQgetvalue(res: Ptr[Unit], row_number: i32, field_number: i32) -> Ptr[u8]
  def PQgetisnull(res: Ptr[Unit], row_number: i32, field_number: i32) -> i32
  def PQgetlength(res: Ptr[Unit], row_number: i32, field_number: i32) -> i32
  def PQcmdTuples(res: Ptr[Unit]) -> Ptr[u8]
end

const PGRES_COMMAND_OK: i32 = 1
const PGRES_TUPLES_OK: i32 = 2
const CONNECTION_OK: i32 = 0

# PostgreSQL type OIDs
const PG_BOOL_OID: u32 = 16
const PG_INT2_OID: u32 = 21
const PG_INT4_OID: u32 = 23
const PG_INT8_OID: u32 = 20
const PG_FLOAT4_OID: u32 = 700
const PG_FLOAT8_OID: u32 = 701
const PG_TEXT_OID: u32 = 25
const PG_VARCHAR_OID: u32 = 1043
const PG_BYTEA_OID: u32 = 17
const PG_TIMESTAMP_OID: u32 = 1114
const PG_TIMESTAMPTZ_OID: u32 = 1184

# The heap-stable Postgres connection: the native PgConnection pointer,
# the prepared-statement counter, and the shared ConnLifetime cell (the
# Open/Closing/Closed state + the child count) live in the Arc-owned
# inner (the inner's Drop runs PQfinish at the Arc's last-release), and
# statements/transactions hold a boxed clone of the inner Arc as their
# lifetime pin plus a clone of the life cell.
struct PostgresInner
  handle: Ptr[Unit]
  stmt_counter: UInt
  life: Arc[ConnLifetime]
end

struct Postgres
  inner: Arc[PostgresInner]
end

struct PostgresConfig
  host: String
  port: u16
  user: String
  password: String
  database: String
  ssl_mode: String
end

impl PostgresConfig
  def new() -> PostgresConfig
    PostgresConfig {
      host: "localhost".to_string(),
      port: 5432,
      user: "postgres".to_string(),
      password: String::new(),
      database: "postgres".to_string(),
      ssl_mode: "prefer".to_string()
    end
  end
  
  def host(sink self: PostgresConfig, h: str) -> PostgresConfig
    self.host = h.to_string()
    self
  end
  
  def port(sink self: PostgresConfig, p: u16) -> PostgresConfig
    self.port = p
    self
  end
  
  def user(sink self: PostgresConfig, u: str) -> PostgresConfig
    self.user = u.to_string()
    self
  end
  
  def password(sink self: PostgresConfig, p: str) -> PostgresConfig
    self.password = p.to_string()
    self
  end
  
  def database(sink self: PostgresConfig, d: str) -> PostgresConfig
    self.database = d.to_string()
    self
  end
  
  def ssl_mode(sink self: PostgresConfig, m: str) -> PostgresConfig
    self.ssl_mode = m.to_string()
    self
  end
  
  def to_connection_string(self: PostgresConfig) -> String
    var parts = Vec::new()
    parts.push("host=" + self.host)
    parts.push("port=" + self.port.to_string())
    parts.push("user=" + self.user)
    if !self.password.is_empty() then
      parts.push("password=" + self.password)
    end
    parts.push("dbname=" + self.database)
    parts.push("sslmode=" + self.ssl_mode)
    parts.join(" ")
  end
  
  def connect(self: PostgresConfig) -> Result[Postgres, DbError]
    Postgres::connect(self.to_connection_string().as_str())
  end
end

impl Postgres
  def connect(conninfo: str) -> Result[Postgres, DbError]
    let conninfo_cstr = conninfo.to_cstring()
    let handle = unsafe "FFI boundary" do PQconnectdb(conninfo_cstr.as_ptr()) end
    
    if handle.is_null() then
      return Result::Err(DbError::ConnectionFailed("failed to allocate connection"))
    end
    
    let status = unsafe "FFI boundary" do PQstatus(handle) end
    if status != CONNECTION_OK then
      let err_msg = postgres_errmsg(handle)
      unsafe "FFI boundary" do PQfinish(handle) end
      return Result::Err(DbError::ConnectionFailed(err_msg))
    end
    
    Result::Ok(Postgres { inner: Arc::new(PostgresInner { handle: handle, stmt_counter: 0, life: conn_lifetime_new() }) })
  end
  
  # ———————————————————————————————————————————————
  # THE PORTABLE `?` API (the EXPLICIT translation mode): the native
  # query/execute/prepare accept the AUTHORITATIVE $1..$n form and never
  # rewrite the SQL; these methods are the opt-in convenience for the
  # JDBC-style `?` placeholders — each one runs the lexer's ? -> $n
  # translation (quoted-string aware) and then executes/prepares the
  # translated statement through the SAME native raw paths.
  # ———————————————————————————————————————————————
  
  ## Portable execute: `?` placeholders are translated to $1..$n
  ## (quoted-string aware) before the native execution.
  def execute_portable(inout self: Postgres, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    conn_lifetime_check(self.inner.ptr.as_ref().life)?
    let (translated, param_count) = postgres_translate_placeholders(sql)
    if param_count != params.len() as UInt then
      return Result::Err(DbError::BindError(param_count, "placeholder count does not match parameter count".to_string()))
    end
    postgres_execute_raw(self.inner.ptr.as_ref().handle, translated, params)
  end
  
  ## Portable query: `?` placeholders are translated to $1..$n
  ## (quoted-string aware) before the native query.
  def query_portable(self: Postgres, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    conn_lifetime_check(self.inner.ptr.as_ref().life)?
    let (translated, param_count) = postgres_translate_placeholders(sql)
    if param_count != params.len() as UInt then
      return Result::Err(DbError::BindError(param_count, "placeholder count does not match parameter count".to_string()))
    end
    postgres_query_raw(self.inner.ptr.as_ref().handle, translated, params)
  end
  
  ## Portable prepare: the `?` placeholders are translated to $1..$n at
  ## prepare time (the explicit translation mode — the native prepare
  ## never rewrites) and the server-side statement is created with the
  ## translated SQL.
  def prepare_portable(inout self: Postgres, sql: str) -> Result[Statement, DbError]
    let life = self.inner.ptr.as_ref().life.clone()
    conn_lifetime_check(life)?
    let (translated, param_count) = postgres_translate_placeholders(sql)
    self.inner.ptr.as_ref().stmt_counter = self.inner.ptr.as_ref().stmt_counter + 1
    let stmt_name = "stmt_" + self.inner.ptr.as_ref().stmt_counter.to_string()
    let stmt_name_cstr = stmt_name.to_cstring()
    let sql_cstr = translated.to_cstring()
    
    let result = unsafe "FFI boundary" do
      PQprepare(self.inner.ptr.as_ref().handle, stmt_name_cstr.as_ptr(), sql_cstr.as_ptr(), param_count as i32, null_ptr())
    end
    
    if result.is_null() then
      return Result::Err(DbError::QueryFailed(postgres_errmsg(self.inner.ptr.as_ref().handle)))
    end
    
    let status = unsafe "FFI boundary" do PQresultStatus(result) end
    if status != PGRES_COMMAND_OK then
      let err_msg = postgres_result_errmsg(result)
      unsafe "FFI boundary" do PQclear(result) end
      return Result::Err(DbError::QueryFailed(err_msg))
    end
    
    unsafe "FFI boundary" do PQclear(result) end
    
    conn_lifetime_register_child(life)
    Result::Ok(Statement {
      sql: translated,
      handle: null_ptr(),
      driver: DriverKind::Postgres,
      conn_handle: self.inner.ptr.as_ref().handle,
      param_count: param_count,
      stmt_name: stmt_name,
      conn_token: ConnToken { pin: Arc::new(Box::new(self.inner.clone())), life: life }
    })
  end
end

impl Connection for Postgres
  def execute(inout self: Postgres, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    conn_lifetime_check(self.inner.ptr.as_ref().life)?
    postgres_execute_raw(self.inner.ptr.as_ref().handle, sql, params)
  end
  
  def query(self: Postgres, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    conn_lifetime_check(self.inner.ptr.as_ref().life)?
    postgres_query_raw(self.inner.ptr.as_ref().handle, sql, params)
  end
  
  def begin_transaction(inout self: Postgres) -> Result[Transaction, DbError]
    let life = self.inner.ptr.as_ref().life.clone()
    conn_lifetime_check(life)?
    postgres_execute_raw(self.inner.ptr.as_ref().handle, "BEGIN", &[])?
    conn_lifetime_register_child(life)
    Result::Ok(Transaction {
      conn_handle: self.inner.ptr.as_ref().handle,
      conn_token: ConnToken { pin: Arc::new(Box::new(self.inner.clone())), life: life },
      driver: DriverKind::Postgres,
      finished: false
    })
  end
  
  def prepare(inout self: Postgres, sql: str) -> Result[Statement, DbError]
    let life = self.inner.ptr.as_ref().life.clone()
    conn_lifetime_check(life)?
    # THE NATIVE PREPARED STATEMENT (the AUTHORITATIVE $1..$n form): the
    # SQL is sent BYTE-IDENTICAL to PQprepare — the driver never silently
    # rewrites a `?` (the jsonb ?| / ?& operators pass through untouched
    # in the native mode). The server-side statement is created with
    # PQprepare; the nParams is the lexer-aware count of the $n markers
    # (the only scan in the native path — it counts, it never rewrites).
    # The portable `?` form goes through Postgres::prepare_portable (the
    # explicit translation mode).
    let param_count = postgres_count_native_params(sql)
    self.inner.ptr.as_ref().stmt_counter = self.inner.ptr.as_ref().stmt_counter + 1
    let stmt_name = "stmt_" + self.inner.ptr.as_ref().stmt_counter.to_string()
    let stmt_name_cstr = stmt_name.to_cstring()
    let sql_cstr = sql.to_cstring()
    
    let result = unsafe "FFI boundary" do
      PQprepare(self.inner.ptr.as_ref().handle, stmt_name_cstr.as_ptr(), sql_cstr.as_ptr(), param_count as i32, null_ptr())
    end
    
    if result.is_null() then
      return Result::Err(DbError::QueryFailed(postgres_errmsg(self.inner.ptr.as_ref().handle)))
    end
    
    let status = unsafe "FFI boundary" do PQresultStatus(result) end
    if status != PGRES_COMMAND_OK then
      let err_msg = postgres_result_errmsg(result)
      unsafe "FFI boundary" do PQclear(result) end
      return Result::Err(DbError::QueryFailed(err_msg))
    end
    
    unsafe "FFI boundary" do PQclear(result) end
    
    conn_lifetime_register_child(life)
    Result::Ok(Statement {
      sql: sql.to_string(),
      handle: null_ptr(),
      driver: DriverKind::Postgres,
      conn_handle: self.inner.ptr.as_ref().handle,
      param_count: param_count,
      stmt_name: stmt_name,
      conn_token: ConnToken { pin: Arc::new(Box::new(self.inner.clone())), life: life }
    })
  end
  
  def close(inout self: Postgres) -> Result[Unit, DbError]
    # THE BUSY POLICY (connection-lifetime design): live statements/transactions
    # block the close.
    let inner = self.inner.ptr.as_ref()
    let life = inner.life.clone()
    if life.ptr.as_ref().children.load(Ordering::Acquire) > 0 then
      return Result::Err(DbError::Busy("connection has live statements or transactions".to_string()))
    end
    if inner.handle.is_null() then
      life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Closed), Ordering::Release)
      return Result::Ok(())
    end
    life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Closing), Ordering::Release)
    unsafe "FFI boundary" do PQfinish(inner.handle) end
    inner.handle = null_ptr()
    life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Closed), Ordering::Release)
    Result::Ok(())
  end
end

impl Drop for PostgresInner
  def drop(inout self: PostgresInner) -> Unit
    if !self.handle.is_null() then
      unsafe "FFI boundary" do PQfinish(self.handle) end
    end
  end
end

# PostgreSQL helper functions
def postgres_errmsg(handle: Ptr[Unit]) -> String
  let msg_ptr = unsafe "FFI boundary" do PQerrorMessage(handle) end
  if msg_ptr.is_null() then
    "unknown error".to_string()
  else
    unsafe "FFI boundary" do String::from_cstr(msg_ptr) end
  end
end

def postgres_result_errmsg(result: Ptr[Unit]) -> String
  let msg_ptr = unsafe "FFI boundary" do PQresultErrorMessage(result) end
  if msg_ptr.is_null() then
    "unknown error".to_string()
  else
    unsafe "FFI boundary" do String::from_cstr(msg_ptr) end
  end
end

# ———————————————————————————————————————————————————————————————
# The ? -> $n placeholder translation — the real driver lexer
# ———————————————————————————————————————————————————————————————
# THE PORTABLE MODE (the EXPLICIT opt-in): PostgreSQL expects $1..$n
# positional parameters, never the JDBC `?` placeholder. The portable
# wrappers (Postgres::execute_portable / query_portable /
# prepare_portable) run the ? -> $n translation with a STATE MACHINE over
# the enumerated PgLexState states — the single-quoted strings (with the
# '' doubling), the double-quoted identifiers (with the "" doubling), the
# E'...' escape strings (where a backslash escapes the following byte AND
# '' still doubles), the dollar-quoted bodies ($tag$ ... $tag$ — the tag
# is remembered and the body is opaque until the exact closing
# delimiter; a $ followed by a digit is a positional parameter, never a
# dollar-quote opener), the -- line comments, and the /* */ block
# comments (which NEST in PostgreSQL — the depth counter). A `?` inside
# ANY of those regions is DATA, never a parameter; outside them a `?`
# followed by | or & is the jsonb ?| / ?& operator (also not a
# parameter); a lone `?` is rewritten to $1..$n in parameter order.
#
# THE NATIVE MODE (the AUTHORITATIVE $1..$n form): the driver's
# query/execute/prepare accept the $n parameters NATIVELY — the SQL
# passes through BYTE-IDENTICAL (the translation NEVER runs in the
# native path, and the `?` jsonb operator passes through untouched). The
# same state machine is used ONLY to COUNT the $n markers
# (postgres_count_native_params — the highest index) because PQprepare
# requires the exact parameter count; the count scan never rewrites.
#
# The lexer works on the SQL's raw bytes (every state character is ASCII;
# multi-byte UTF-8 content inside strings passes through byte-exact) and
# rebuilds the output as bytes; the doubled-quote rules copy the doubled
# delimiter verbatim and stay inside the string, exactly like the real
# PostgreSQL scanner.
enum PgLexState
  PgNormal
  PgSingleQuote
  PgDoubleQuote
  PgEscapeString
  PgDollarQuote
  PgLineComment
  PgBlockComment
end

struct PgPlaceholderLexer
  state: PgLexState
  dollar_tag: Vec[u8]
  block_depth: UInt
  out: Vec[u8]
  param_count: UInt
  count_native: Bool   # true: count $n markers only (never rewrite)
end

def pg_lex_ident_start(b: u8) -> Bool
  (b >= 'a' as u8 && b <= 'z' as u8) || (b >= 'A' as u8 && b <= 'Z' as u8) || b == '_' as u8
end

def pg_lex_ident_char(b: u8) -> Bool
  pg_lex_ident_start(b) || (b >= '0' as u8 && b <= '9' as u8)
end

def postgres_scan_sql(sql: str, count_native: Bool) -> (String, UInt)
  let bytes = sql.as_bytes()
  let n = bytes.len()
  mut lexer = PgPlaceholderLexer {
    state: PgLexState::PgNormal,
    dollar_tag: Vec::new(),
    block_depth: 0,
    out: Vec::new(),
    param_count: 0,
    count_native: count_native
  }
  mut i = 0
  while i < n do
    let b = bytes[i]
    match lexer.state
    when PgLexState::PgNormal then
      if b == '\'' as u8 then
        lexer.out.push(b)
        lexer.state = PgLexState::PgSingleQuote
      elsif b == '"' as u8 then
        lexer.out.push(b)
        lexer.state = PgLexState::PgDoubleQuote
      elsif (b == 'E' as u8 || b == 'e' as u8) && i + 1 < n && bytes[i + 1] == '\'' as u8 then
        # The E'...' escape string: the E prefix and the opening quote are
        # emitted, the string body is scanned in PgEscapeString.
        lexer.out.push(b)
        i = i + 1
        lexer.out.push(bytes[i])
        lexer.state = PgLexState::PgEscapeString
      elsif b == '-' as u8 && i + 1 < n && bytes[i + 1] == '-' as u8 then
        lexer.out.push(b)
        i = i + 1
        lexer.out.push(bytes[i])
        lexer.state = PgLexState::PgLineComment
      elsif b == '/' as u8 && i + 1 < n && bytes[i + 1] == '*' as u8 then
        lexer.out.push(b)
        i = i + 1
        lexer.out.push(bytes[i])
        lexer.block_depth = 1
        lexer.state = PgLexState::PgBlockComment
      elsif b == '$' as u8 then
        # The dollar-quote check: $tag$ opens a dollar-quoted body when
        # the tag is empty ($$...$$) or starts with a letter/underscore;
        # a $ followed by a digit (or a bare $) is a positional parameter
        # marker / data.
        let tag_start = i + 1
        if tag_start < n && (bytes[tag_start] == '$' as u8 || pg_lex_ident_start(bytes[tag_start])) then
          mut tag_end = tag_start
          while tag_end < n && pg_lex_ident_char(bytes[tag_end]) do
            tag_end = tag_end + 1
          end
          if tag_end < n && bytes[tag_end] == '$' as u8 then
            lexer.dollar_tag = Vec::new()
            var t = tag_start
            while t < tag_end do
              lexer.dollar_tag.push(bytes[t])
              t = t + 1
            end
            lexer.out.push(b)
            var t2 = tag_start
            while t2 <= tag_end do
              lexer.out.push(bytes[t2])
              t2 = t2 + 1
            end
            i = tag_end
            lexer.state = PgLexState::PgDollarQuote
          else
            lexer.out.push(b)
          end
        elsif lexer.count_native && tag_start < n && bytes[tag_start] >= '0' as u8 && bytes[tag_start] <= '9' as u8 then
          # THE NATIVE COUNT MODE: a $n positional marker — the HIGHEST
          # index is the PQprepare parameter count. The scan counts
          # without ever rewriting: the SQL passes through untouched.
          mut val = 0
          var d = tag_start
          while d < n && bytes[d] >= '0' as u8 && bytes[d] <= '9' as u8 do
            val = val * 10 + (bytes[d] as Int - '0' as Int)
            d = d + 1
          end
          if (val as UInt) > lexer.param_count then
            lexer.param_count = val as UInt
          end
          lexer.out.push(b)
        else
          lexer.out.push(b)
        end
      elsif b == '?' as u8 then
        if i + 1 < n && (bytes[i + 1] == '|' as u8 || bytes[i + 1] == '&' as u8) then
          # The ?| / ?& jsonb operators — data, never a parameter.
          lexer.out.push(b)
        elsif lexer.count_native then
          # THE NATIVE MODE: a lone `?` is DATA — the native driver never
          # silently rewrites it (the jsonb ? operator passes through
          # untouched; the portable translation is the explicit opt-in).
          lexer.out.push(b)
        else
          lexer.param_count = lexer.param_count + 1
          let dollar = "$" + lexer.param_count.to_string()
          for db in dollar.as_bytes() do
            lexer.out.push(db)
          end
        end
      else
        lexer.out.push(b)
      end
    when PgLexState::PgSingleQuote then
      if b == '\'' as u8 && i + 1 < n && bytes[i + 1] == '\'' as u8 then
        # The '' doubling: emit both delimiters and stay inside.
        lexer.out.push(b)
        i = i + 1
        lexer.out.push(bytes[i])
      elsif b == '\'' as u8 then
        lexer.out.push(b)
        lexer.state = PgLexState::PgNormal
      else
        lexer.out.push(b)
      end
    when PgLexState::PgDoubleQuote then
      if b == '"' as u8 && i + 1 < n && bytes[i + 1] == '"' as u8 then
        lexer.out.push(b)
        i = i + 1
        lexer.out.push(bytes[i])
      elsif b == '"' as u8 then
        lexer.out.push(b)
        lexer.state = PgLexState::PgNormal
      else
        lexer.out.push(b)
      end
    when PgLexState::PgEscapeString then
      if b == '\\' as u8 && i + 1 < n then
        # The backslash escape: the escaped byte is emitted verbatim —
        # an escaped quote can never close the string.
        lexer.out.push(b)
        i = i + 1
        lexer.out.push(bytes[i])
      elsif b == '\'' as u8 && i + 1 < n && bytes[i + 1] == '\'' as u8 then
        lexer.out.push(b)
        i = i + 1
        lexer.out.push(bytes[i])
      elsif b == '\'' as u8 then
        lexer.out.push(b)
        lexer.state = PgLexState::PgNormal
      else
        lexer.out.push(b)
      end
    when PgLexState::PgDollarQuote then
      if b == '$' as u8 then
        # The closing $tag$ must match the remembered tag EXACTLY; a $tag
        # that only shares a prefix stays body data.
        let tag_len = lexer.dollar_tag.len()
        mut matches = true
        if i + 1 + tag_len < n then
          var t = 0
          while t < tag_len && matches do
            if bytes[i + 1 + t] != lexer.dollar_tag[t] then
              matches = false
            end
            t = t + 1
          end
          if matches && bytes[i + 1 + tag_len] == '$' as u8 then
            lexer.out.push(b)
            var u = 0
            while u <= tag_len do
              lexer.out.push(bytes[i + 1 + u])
              u = u + 1
            end
            i = i + 1 + tag_len
            lexer.state = PgLexState::PgNormal
            lexer.dollar_tag = Vec::new()
          else
            lexer.out.push(b)
          end
        else
          lexer.out.push(b)
        end
      else
        lexer.out.push(b)
      end
    when PgLexState::PgLineComment then
      if b == '\n' as u8 then
        lexer.out.push(b)
        lexer.state = PgLexState::PgNormal
      else
        lexer.out.push(b)
      end
    when PgLexState::PgBlockComment then
      if b == '*' as u8 && i + 1 < n && bytes[i + 1] == '/' as u8 then
        lexer.out.push(b)
        i = i + 1
        lexer.out.push(bytes[i])
        lexer.block_depth = lexer.block_depth - 1
        if lexer.block_depth == 0 then
          lexer.state = PgLexState::PgNormal
        end
      elsif b == '/' as u8 && i + 1 < n && bytes[i + 1] == '*' as u8 then
        # The PostgreSQL block comments NEST — the depth counter.
        lexer.out.push(b)
        i = i + 1
        lexer.out.push(bytes[i])
        lexer.block_depth = lexer.block_depth + 1
      else
        lexer.out.push(b)
      end
    end
    i = i + 1
  end
  let out = String::from_utf8(lexer.out).unwrap_or(String::new())
  (out, lexer.param_count)
end

## The PORTABLE translation: the `?` placeholders are rewritten to $1..$n
## (the portable API's explicit translation mode — used ONLY by the
## *Portable wrappers, never by the native driver paths).
def postgres_translate_placeholders(sql: str) -> (String, UInt)
  postgres_scan_sql(sql, false)
end

## The NATIVE $n count (the PQprepare parameter count): the highest $n
## index in the statement — lexer-aware (the $n markers inside strings,
## dollar-quoted bodies, and comments are data) and NEVER a rewrite: the
## native paths pass the SQL through byte-identical; the scan only
## counts. The `?` operator is data in the native mode — it contributes
## nothing to the count and is never translated.
def postgres_count_native_params(sql: str) -> UInt
  let (_, count) = postgres_scan_sql(sql, true)
  count
end

# ———————————————————————————————————————————————————————————————
# PgParamBacking — the explicit parameter backing for PQexecParams /
# PQexecPrepared
# ———————————————————————————————————————————————————————————————
# Every parameter's PAYLOAD is owned by the backing for the duration of
# the FFI call:
#   owned_buffers — the owned byte buffers: the blob's raw bytes and the
#                   text/numeric NUL-terminated C-string bytes. The blob
#                   bytes are COPIED into an owned buffer here (never a
#                   pointer into a temporary SqlValue payload that dies at
#                   the end of its loop iteration), and each C-string is
#                   likewise an owned buffer — every ptrs[] entry stays
#                   valid until the backing is dropped, i.e. through the
#                   PQexecParams/PQexecPrepared call.
#   ptrs          — the paramValues array: a Ptr[u8] per parameter (null
#                   for SQL NULL).
#   lengths       — the paramLengths entries (Int; converted to the C
#                   i32 ABI at the FFI boundary).
#   formats       — the paramFormats entries (0 = text, 1 = binary).
struct PgParamBacking
  owned_buffers: Vec[Vec[u8]]
  ptrs: Vec[Ptr[u8]]
  lengths: Vec[Int]
  formats: Vec[Int]
end

impl PgParamBacking
  def new() -> PgParamBacking
    PgParamBacking {
      owned_buffers: Vec::new(),
      ptrs: Vec::new(),
      lengths: Vec::new(),
      formats: Vec::new()
    }
  end
  
  def push_null(inout self: PgParamBacking) -> Unit
    self.ptrs.push(null_ptr())
    self.lengths.push(0)
    self.formats.push(0)
  end
  
  # A text-format parameter: the NUL-terminated byte buffer is pushed
  # into owned_buffers BEFORE the backing is used, so the ptrs[] entry
  # points into a buffer that lives through the FFI call.
  def push_text_bytes(inout self: PgParamBacking, sink bytes: Vec[u8]) -> Unit
    self.ptrs.push(bytes.as_ptr())
    self.lengths.push(bytes.len())
    self.formats.push(0)
    self.owned_buffers.push(bytes)
  end
  
  # A binary-format parameter: the blob's bytes are copied into an owned
  # buffer (owned_buffers push) — the pointer cannot dangle before
  # PQexecParams/PQexecPrepared.
  def push_blob(inout self: PgParamBacking, blob: Vec[u8]) -> Unit
    self.ptrs.push(blob.as_ptr())
    self.lengths.push(blob.len())
    self.formats.push(1)
    self.owned_buffers.push(blob)
  end
end

# Build the parameter backing for a parameter slice.
def postgres_build_backing(params: [Box[dyn ToSqlParam]]) -> PgParamBacking
  var backing = PgParamBacking::new()
  for param in params do
    let value = param.to_sql_param()
    match value
    when SqlValue::Null then
      backing.push_null()
    when SqlValue::Integer(i) then
      backing.push_text_bytes(i.to_string().to_cstring_bytes())
    when SqlValue::Float(f) then
      backing.push_text_bytes(f.to_string().to_cstring_bytes())
    when SqlValue::Text(t) then
      backing.push_text_bytes(t.to_cstring_bytes())
    when SqlValue::Bool(b) then
      backing.push_text_bytes((if b then "t" else "f" end).to_cstring_bytes())
    when SqlValue::Blob(blob) then
      backing.push_blob(blob)
    when SqlValue::Timestamp(t) then
      backing.push_text_bytes(t.to_string().to_cstring_bytes())
    end
  end
  backing
end

# Translate the C int32 length/format arrays at the FFI boundary: the
# backing stores the Tangerine-native Int entries; PQexecParams /
# PQexecPrepared read i32 arrays.
def postgres_i32_lengths(backing: PgParamBacking) -> Vec[i32]
  var out = Vec::new()
  for l in backing.lengths do
    out.push(l as i32)
  end
  out
end

def postgres_i32_formats(backing: PgParamBacking) -> Vec[i32]
  var out = Vec::new()
  for f in backing.formats do
    out.push(f as i32)
  end
  out
end

def postgres_execute_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  if params.is_empty() then
    let sql_cstr = sql.to_cstring()
    let result = unsafe "FFI boundary" do PQexec(handle, sql_cstr.as_ptr()) end
    
    if result.is_null() then
      return Result::Err(DbError::QueryFailed(postgres_errmsg(handle)))
    end
    
    let status = unsafe "FFI boundary" do PQresultStatus(result) end
    if status != PGRES_COMMAND_OK && status != PGRES_TUPLES_OK then
      let err_msg = postgres_result_errmsg(result)
      unsafe "FFI boundary" do PQclear(result) end
      return Result::Err(DbError::QueryFailed(err_msg))
    end
    
    let cmd_ptr = unsafe "FFI boundary" do PQcmdTuples(result) end
    let affected_str = if cmd_ptr.is_null() then "0" else unsafe "FFI boundary" do String::from_cstr(cmd_ptr) end end
    let affected = affected_str.parse_uint().unwrap_or(0)
    unsafe "FFI boundary" do PQclear(result) end
    return Result::Ok(affected)
  end
  
  # THE NATIVE PARAMETER FORM (the AUTHORITATIVE $1..$n): the SQL is sent
  # BYTE-IDENTICAL — the driver NEVER silently rewrites it (no `?` -> $n
  # translation in the native path; a `?` that is the jsonb ?| / ?&
  # operator passes through untouched). The parameter count comes from
  # the caller's params array; PostgreSQL validates the $n references
  # itself at the server. The portable `?` form goes through the
  # translate-then-execute wrappers (Postgres::execute_portable /
  # query_portable / prepare_portable).
  let backing = postgres_build_backing(params)
  let sql_cstr = sql.to_cstring()
  let c_lengths = postgres_i32_lengths(backing)
  let c_formats = postgres_i32_formats(backing)
  let result = unsafe "FFI boundary" do
    PQexecParams(
      handle,
      sql_cstr.as_ptr(),
      params.len() as i32,
      null_ptr(),
      backing.ptrs.as_ptr(),
      c_lengths.as_ptr(),
      c_formats.as_ptr(),
      0
    )
  end
  
  if result.is_null() then
    return Result::Err(DbError::QueryFailed(postgres_errmsg(handle)))
  end
  
  let status = unsafe "FFI boundary" do PQresultStatus(result) end
  if status != PGRES_COMMAND_OK && status != PGRES_TUPLES_OK then
    let err_msg = postgres_result_errmsg(result)
    unsafe "FFI boundary" do PQclear(result) end
    return Result::Err(DbError::QueryFailed(err_msg))
  end
  
  let cmd_ptr2 = unsafe "FFI boundary" do PQcmdTuples(result) end
  let affected_str = if cmd_ptr2.is_null() then "0" else unsafe "FFI boundary" do String::from_cstr(cmd_ptr2) end end
  let affected = affected_str.parse_uint().unwrap_or(0)
  unsafe "FFI boundary" do PQclear(result) end
  Result::Ok(affected)
end

def postgres_query_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  let result = if params.is_empty() then
    let sql_cstr = sql.to_cstring()
    unsafe "FFI boundary" do PQexec(handle, sql_cstr.as_ptr()) end
  else
    # THE NATIVE PARAMETER FORM: the SQL passes through byte-identical
    # (never a silent `?` rewrite); the parameter count is the caller's
    # params array length.
    let backing = postgres_build_backing(params)
    let sql_cstr = sql.to_cstring()
    let c_lengths = postgres_i32_lengths(backing)
    let c_formats = postgres_i32_formats(backing)
    unsafe "FFI boundary" do
      PQexecParams(
        handle,
        sql_cstr.as_ptr(),
        params.len() as i32,
        null_ptr(),
        backing.ptrs.as_ptr(),
        c_lengths.as_ptr(),
        c_formats.as_ptr(),
        0
      )
    end
  end
  
  if result.is_null() then
    return Result::Err(DbError::QueryFailed(postgres_errmsg(handle)))
  end
  
  let status = unsafe "FFI boundary" do PQresultStatus(result) end
  if status != PGRES_TUPLES_OK then
    let err_msg = postgres_result_errmsg(result)
    unsafe "FFI boundary" do PQclear(result) end
    return Result::Err(DbError::QueryFailed(err_msg))
  end
  
  let rows = postgres_result_to_rows(result)
  unsafe "FFI boundary" do PQclear(result) end
  Result::Ok(rows)
end

# Read a PGRES_TUPLES_OK result into Rows (shared by the raw query path
# and the prepared-statement query path).
def postgres_result_to_rows(result: Ptr[Unit]) -> Rows
  # Get column info
  let num_fields = unsafe "FFI boundary" do PQnfields(result)  end as UInt
  var columns = Vec::new()
  var col_types = Vec::new()
  
  for i in 0..num_fields do
    let name_ptr = unsafe "FFI boundary" do PQfname(result, i as i32) end
    let name = if name_ptr.is_null() then "column_" + i.to_string() else unsafe "FFI boundary" do String::from_cstr(name_ptr)  end end
    columns.push(name)
    col_types.push(unsafe "FFI boundary" do PQftype(result, i as i32)  end)
  end
  
  # Get rows
  let num_rows = unsafe "FFI boundary" do PQntuples(result)  end as UInt
  var data = Vec::new()
  
  for row_idx in 0..num_rows do
    var row_values = Vec::new()
    for col_idx in 0..num_fields do
      let value = if unsafe "FFI boundary" do PQgetisnull(result, row_idx as i32, col_idx as i32)  end != 0 then
        SqlValue::Null
      else
        let val_ptr = unsafe "FFI boundary" do PQgetvalue(result, row_idx as i32, col_idx as i32) end
        let val_len = unsafe "FFI boundary" do PQgetlength(result, row_idx as i32, col_idx as i32)  end as UInt
        let col_type = col_types[col_idx]
        
        if val_ptr.is_null() then
          SqlValue::Null
        else
          let val_str = unsafe "FFI boundary" do String::from_cstr(val_ptr) end
          
          match col_type
          when PG_BOOL_OID then
            SqlValue::Bool(val_str == "t" || val_str == "true" || val_str == "1")
          when PG_INT2_OID | PG_INT4_OID | PG_INT8_OID then
            SqlValue::Integer(val_str.parse_i64().unwrap_or(0))
          when PG_FLOAT4_OID | PG_FLOAT8_OID then
            SqlValue::Float(val_str.parse_f64().unwrap_or(0.0))
          when PG_BYTEA_OID then
            SqlValue::Blob(decode_bytea(&val_str))
          when PG_TIMESTAMP_OID | PG_TIMESTAMPTZ_OID then
            SqlValue::Timestamp(parse_pg_timestamp(&val_str))
          when _ then SqlValue::Text(val_str)
          end
        end
      end
      row_values.push(value)
    end
    data.push(row_values)
  end
  
  Rows::new(columns, data)
end

# Decode PostgreSQL bytea hex format
def decode_bytea(s: str) -> Vec[u8]
  var result = Vec::new()
  let chars: Vec[char] = s.chars().collect()
  
  if chars.len() >= 2 && chars[0] == '\\' && chars[1] == 'x' then
    # Hex format: \xDEADBEEF
    var i = 2
    while i + 1 < chars.len() do
      let high = hex_char_to_byte(chars[i])
      let low = hex_char_to_byte(chars[i + 1])
      result.push((high << 4) | low)
      i = i + 2
    end
  else
    # Escape format
    var i = 0
    while i < chars.len() do
      if chars[i] == '\\' && i + 1 < chars.len() then
        if chars[i + 1] == '\\' then
          result.push('\\' as u8)
          i = i + 2
        elsif i + 3 < chars.len() && chars[i + 1].is_digit() then
          # Octal escape \NNN
          let oct = ((chars[i + 1] as u8 - '0' as u8) * 64) +
                    ((chars[i + 2] as u8 - '0' as u8) * 8) +
                    (chars[i + 3] as u8 - '0' as u8)
          result.push(oct)
          i = i + 4
        else
          result.push(chars[i] as u8)
          i = i + 1
        end
      else
        result.push(chars[i] as u8)
        i = i + 1
      end
    end
  end
  
  result
end

def hex_char_to_byte(c: char) -> u8
  if c >= '0' && c <= '9' then
    c as u8 - '0' as u8
  elsif c >= 'a' && c <= 'f' then
    c as u8 - 'a' as u8 + 10
  elsif c >= 'A' && c <= 'F' then
    c as u8 - 'A' as u8 + 10
  else
    0
  end
end

def parse_pg_timestamp(s: str) -> i64
  # Parse "YYYY-MM-DD HH:MM:SS" into a unix timestamp (UTC seconds).
  # The day number uses the proleptic-Gregorian days-from-civil formula;
  # timezone and microseconds are not part of the textual format.
  let parts = s.split(" ")
  if parts.len() != 2 then
    return 0
  end
  let date_parts = parts[0].split("-")
  let time_parts = parts[1].split(":")
  if date_parts.len() != 3 || time_parts.len() != 3 then
    return 0
  end

  let year = match date_parts[0].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let month = match date_parts[1].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let day = match date_parts[2].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let hour = match time_parts[0].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let minute = match time_parts[1].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let second = match time_parts[2].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end

  if month < 1 || month > 12 || day < 1 || day > 31 || hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 60 then
    return 0
  end

  let mut y = year
  if month <= 2 then
    y = y - 1
  end
  let era = (if y >= 0 then y else y - 399 end) / 400
  let yoe = y - era * 400
  let m_adj = if month > 2 then month - 3 else month + 9 end
  let doy = (153 * m_adj + 2) / 5 + day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  let days = era * 146097 + doe - 719468
  (days as i64) * 86400 + (hour as i64) * 3600 + (minute as i64) * 60 + (second as i64)
end

def postgres_stmt_execute(inout stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  conn_lifetime_check(stmt.conn_token.life)?
  if stmt.conn_handle.is_null() then
    return Result::Err(DbError::Internal("prepared statement execution requires connection context".to_string()))
  end
  if stmt.stmt_name.is_empty() then
    return Result::Err(DbError::Internal("prepared statement has no server-side identity".to_string()))
  end
  
  # The statement was PQprepare'd at prepare() time with the translated
  # $1..$n SQL and the recorded parameter count; execution goes through
  # PQexecPrepared with the same owned PgParamBacking as the raw path.
  let backing = postgres_build_backing(params)
  let name_cstr = stmt.stmt_name.to_cstring()
  let c_lengths = postgres_i32_lengths(backing)
  let c_formats = postgres_i32_formats(backing)
  let result = unsafe "FFI boundary" do
    PQexecPrepared(
      stmt.conn_handle,
      name_cstr.as_ptr(),
      stmt.param_count as i32,
      backing.ptrs.as_ptr(),
      c_lengths.as_ptr(),
      c_formats.as_ptr(),
      0
    )
  end
  
  if result.is_null() then
    return Result::Err(DbError::QueryFailed(postgres_errmsg(stmt.conn_handle)))
  end
  
  let status = unsafe "FFI boundary" do PQresultStatus(result) end
  if status != PGRES_COMMAND_OK && status != PGRES_TUPLES_OK then
    let err_msg = postgres_result_errmsg(result)
    unsafe "FFI boundary" do PQclear(result) end
    return Result::Err(DbError::QueryFailed(err_msg))
  end
  
  let cmd_ptr = unsafe "FFI boundary" do PQcmdTuples(result) end
  let affected_str = if cmd_ptr.is_null() then "0" else unsafe "FFI boundary" do String::from_cstr(cmd_ptr) end end
  let affected = affected_str.parse_uint().unwrap_or(0)
  unsafe "FFI boundary" do PQclear(result) end
  Result::Ok(affected)
end

def postgres_stmt_query(stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  conn_lifetime_check(stmt.conn_token.life)?
  if stmt.conn_handle.is_null() then
    return Result::Err(DbError::Internal("prepared statement query requires connection context".to_string()))
  end
  if stmt.stmt_name.is_empty() then
    return Result::Err(DbError::Internal("prepared statement has no server-side identity".to_string()))
  end
  
  let backing = postgres_build_backing(params)
  let name_cstr = stmt.stmt_name.to_cstring()
  let c_lengths = postgres_i32_lengths(backing)
  let c_formats = postgres_i32_formats(backing)
  let result = unsafe "FFI boundary" do
    PQexecPrepared(
      stmt.conn_handle,
      name_cstr.as_ptr(),
      stmt.param_count as i32,
      backing.ptrs.as_ptr(),
      c_lengths.as_ptr(),
      c_formats.as_ptr(),
      0
    )
  end
  
  if result.is_null() then
    return Result::Err(DbError::QueryFailed(postgres_errmsg(stmt.conn_handle)))
  end
  
  let status = unsafe "FFI boundary" do PQresultStatus(result) end
  if status != PGRES_TUPLES_OK then
    let err_msg = postgres_result_errmsg(result)
    unsafe "FFI boundary" do PQclear(result) end
    return Result::Err(DbError::QueryFailed(err_msg))
  end
  
  let rows = postgres_result_to_rows(result)
  unsafe "FFI boundary" do PQclear(result) end
  Result::Ok(rows)
end

def postgres_stmt_finalize(inout stmt: Statement) -> Result[Unit, DbError]
  # The deterministic server-side cleanup: DEALLOCATE the named prepared
  # statement on the stored connection (the server frees its plan), and
  # PQclear any result the DEALLOCATE returned. The state check (the
  # connection must be Open — the Busy policy keeps a live statement from
  # outliving its connection) guards the DEALLOCATE; a closed/finished
  # connection simply leaves the session state to the server — the
  # Tangerine-side state is nulled either way.
  if conn_lifetime_open(stmt.conn_token.life) && !stmt.conn_handle.is_null() && !stmt.stmt_name.is_empty() then
    let dealloc_sql = "DEALLOCATE " + stmt.stmt_name
    let sql_cstr = dealloc_sql.to_cstring()
    let result = unsafe "FFI boundary" do PQexec(stmt.conn_handle, sql_cstr.as_ptr()) end
    if !result.is_null() then
      unsafe "FFI boundary" do PQclear(result) end
    end
  end
  stmt.handle = null_ptr()
  stmt.conn_handle = null_ptr()
  stmt.param_count = 0
  stmt.stmt_name = String::new()
  Result::Ok(())
end

# ═══════════════════════════════════════════════════════════════
# PART 4: QUERY BUILDER
# ═══════════════════════════════════════════════════════════════

struct QueryBuilder
  parts: Vec[String]
  params: Vec[SqlValue]
  param_placeholder: fn(UInt) -> String
end

impl QueryBuilder
  def new() -> QueryBuilder
    QueryBuilder {
      parts: Vec::new(),
      params: Vec::new(),
      param_placeholder: |i| "?".to_string()  # SQLite style
    end
  end
  
  def new_postgres() -> QueryBuilder
    QueryBuilder {
      parts: Vec::new(),
      params: Vec::new(),
      param_placeholder: |i| "$" + (i + 1).to_string()  # PostgreSQL style
    end
  end
  
  def select(sink self: QueryBuilder, columns: str) -> QueryBuilder
    self.parts.push("SELECT ".to_string() + columns)
    self
  end
  
  def from(sink self: QueryBuilder, table: str) -> QueryBuilder
    self.parts.push("FROM ".to_string() + table)
    self
  end
  
  def where_clause(sink self: QueryBuilder, condition: str) -> QueryBuilder
    self.parts.push("WHERE ".to_string() + condition)
    self
  end
  
  def and_where(sink self: QueryBuilder, condition: str) -> QueryBuilder
    self.parts.push("AND ".to_string() + condition)
    self
  end
  
  def or_where(sink self: QueryBuilder, condition: str) -> QueryBuilder
    self.parts.push("OR ".to_string() + condition)
    self
  end
  
  def join(sink self: QueryBuilder, table: str, on: str) -> QueryBuilder
    self.parts.push("JOIN ".to_string() + table + " ON " + on)
    self
  end
  
  def left_join(sink self: QueryBuilder, table: str, on: str) -> QueryBuilder
    self.parts.push("LEFT JOIN ".to_string() + table + " ON " + on)
    self
  end
  
  def order_by(sink self: QueryBuilder, columns: str) -> QueryBuilder
    self.parts.push("ORDER BY ".to_string() + columns)
    self
  end
  
  def limit(sink self: QueryBuilder, n: UInt) -> QueryBuilder
    self.parts.push("LIMIT ".to_string() + n.to_string())
    self
  end
  
  def offset(sink self: QueryBuilder, n: UInt) -> QueryBuilder
    self.parts.push("OFFSET ".to_string() + n.to_string())
    self
  end
  
  def group_by(sink self: QueryBuilder, columns: str) -> QueryBuilder
    self.parts.push("GROUP BY ".to_string() + columns)
    self
  end
  
  def having(sink self: QueryBuilder, condition: str) -> QueryBuilder
    self.parts.push("HAVING ".to_string() + condition)
    self
  end
  
  def insert_into(sink self: QueryBuilder, table: str, columns: str) -> QueryBuilder
    self.parts.push("INSERT INTO ".to_string() + table + " (" + columns + ")")
    self
  end
  
  def values(sink self: QueryBuilder, count: UInt) -> QueryBuilder
    var placeholders = Vec::new()
    for i in 0..count do
      placeholders.push((self.param_placeholder)(self.params.len() + i))
    end
    self.parts.push("VALUES (".to_string() + placeholders.join(", ") + ")")
    self
  end
  
  def update(sink self: QueryBuilder, table: str) -> QueryBuilder
    self.parts.push("UPDATE ".to_string() + table)
    self
  end
  
  def set(sink self: QueryBuilder, assignments: str) -> QueryBuilder
    self.parts.push("SET ".to_string() + assignments)
    self
  end
  
  def delete_from(sink self: QueryBuilder, table: str) -> QueryBuilder
    self.parts.push("DELETE FROM ".to_string() + table)
    self
  end
  
  def param(inout self: QueryBuilder, sink value: SqlValue) -> String
    let idx = self.params.len()
    self.params.push(value)
    (self.param_placeholder)(idx)
  end
  
  def raw(sink self: QueryBuilder, sql: str) -> QueryBuilder
    self.parts.push(sql.to_string())
    self
  end
  
  def build(self: QueryBuilder) -> (String, Vec[SqlValue])
    var out = Vec::new()
    for param in self.params do
      out.push(param.clone())
    end
    (self.parts.join(" "), out)
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 5: MIGRATION SYSTEM
# ═══════════════════════════════════════════════════════════════

struct Migration
  version: UInt
  name: String
  up: String
  down: String
end

struct Migrator
  migrations: Vec[Migration]
  table_name: String
end

impl Migrator
  def new() -> Migrator
    Migrator {
      migrations: Vec::new(),
      table_name: "_migrations".to_string()
    end
  end
  
  def add(sink self: Migrator, version: UInt, name: str, up: str, down: str) -> Migrator
    self.migrations.push(Migration {
      version: version,
      name: name.to_string(),
      up: up.to_string(),
      down: down.to_string()
    })
    self
  end
  
  def migrate[C](self: Migrator, inout conn: C) -> Result[UInt, DbError] where C: Connection
    # Create migrations table if not exists
    let create_sql = "CREATE TABLE IF NOT EXISTS ".to_string()
      + self.table_name.as_str()
      + " (version INTEGER PRIMARY KEY, name TEXT, applied_at TEXT)"
    conn.execute(&create_sql, &[])?
    
    # Get current version
    let rows = conn.query(&("SELECT MAX(version) FROM ".to_string() + self.table_name.as_str()), &[])?
    let current: i64 = rows.into_iter().next()
      .and_then(|row| row.get(0).ok())
      .unwrap_or(-1)
    
    var applied = 0
    
    for migration in self.migrations do
      if migration.version as i64 > current then
        var tx = conn.begin_transaction()?
        tx.execute(&migration.up, &[])?
        let insert_sql = "INSERT INTO ".to_string()
          + self.table_name.as_str()
          + " (version, name, applied_at) VALUES (?, ?, datetime('now'))"
        tx.execute(&insert_sql, &[Box::new(migration.version as i64) as Box[dyn ToSqlParam], Box::new(migration.name) as Box[dyn ToSqlParam]])?
        tx.commit()?
        applied = applied + 1
      end
    end
    
    Result::Ok(applied)
  end
  
  def rollback[C](self: Migrator, inout conn: C, steps: UInt) -> Result[UInt, DbError] where C: Connection
    let query_sql = "SELECT version FROM ".to_string()
      + self.table_name.as_str()
      + " ORDER BY version DESC LIMIT ?"
    let rows = conn.query(&query_sql, &[Box::new(steps as i64) as Box[dyn ToSqlParam]])?
    
    let versions: Vec[i64] = rows.into_iter()
      .filter_map(|row| row.get::<i64>(0).ok())
      .collect()
    
    var rolled_back = 0
    
    for version in versions do
      if let Option::Some(migration) = self.migrations.iter().find(|m| m.version as i64 == version) then
        var tx = conn.begin_transaction()?
        tx.execute(&migration.down, &[])?
        tx.execute(&("DELETE FROM ".to_string() + self.table_name.as_str() + " WHERE version = ?"), &[Box::new(version) as Box[dyn ToSqlParam]])?
        tx.commit()?
        rolled_back = rolled_back + 1
      end
    end
    
    Result::Ok(rolled_back)
  end
  
  def status[C](self: Migrator, conn: C) -> Result[Vec[(UInt, String, Bool)], DbError] where C: Connection
    let rows = conn.query(&("SELECT version, name FROM ".to_string() + self.table_name.as_str()), &[])?
    let applied: Map[i64, String] = rows.into_iter()
      .filter_map(|row| {
        let v: i64 = row.get(0).ok()?
        let n: String = row.get(1).ok()?
        Option::Some((v, n))
      })
      .collect()
    
    var status = Vec::new()
    for migration in self.migrations do
      let is_applied = applied.contains_key(&(migration.version as i64))
      status.push((migration.version, migration.name.clone(), is_applied))
    end
    
    Result::Ok(status)
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 6: CONNECTION POOL
# ═══════════════════════════════════════════════════════════════

use std::sync::{Arc, Mutex, Condvar}

# THE ARC-OWNED POOL (the raw-pointer design removed — the ownership
# closure):
# the pool state lives in an Arc-owned PoolInner. The pooled handle holds
# its OWN Arc clone of the inner, so the reviewer's lifetime scenario —
# `pooled = pool.get(); drop(pool); use pooled` — is safe: the pool can
# be dropped while a connection is checked out, and the checked-out
# connection is returned into the STILL-ALIVE inner when the handle
# drops; the inner (and the idle connections it owns) is released when
# the LAST Arc clone (the pool's or a pooled handle's) goes away. No
# handle ever holds a raw pointer into a caller-owned pool.
#
# THE COUNT LIVES UNDER THE LOCK: current_size (the number of
# connections the pool has created) is a field of the Mutex-protected
# PoolState — the max_size bound is decided INSIDE the lock, so the
# "max simultaneously created <= max_size" property holds under any
# number of concurrent getters (Gate X: max_size=4, 64 threads).
# current_size is incremented ONLY when a connection is actually created
# — a factory failure returns the error WITHOUT incrementing (the
# factory-failure consistency: a failed create leaves the pool fully
# usable and the count exact).
#
# THE SHUTDOWN-WITH-CHECKED-OUT CONTRACT (documented): dropping the Pool
# with connections still checked out is SAFE — the checked-out
# PooledConnections keep the inner alive (their Arc clones); the
# connections they return are pushed into the inner's idle list; the
# inner's Drop then runs the idle connections' destruction (and the
# still-checked-out connections drop with their handles). The pool's
# Drop never touches a checked-out connection.
struct PoolInner[C]
  state: Mutex[PoolState[C]]
  max_size: UInt
  create_fn: fn() -> Result[C, DbError]
  available: Condvar
end

struct PoolState[C]
  idle: Vec[C]
  current_size: UInt
end

struct Pool[C]
  inner: Arc[PoolInner[C]]
end

impl[C] Pool[C] where C: Connection
  def new(max_size: UInt, create_fn: fn() -> Result[C, DbError]) -> Result[Pool[C], DbError]
    if max_size == 0 then
      return Result::Err(DbError::Internal("pool max_size must be at least 1".to_string()))
    end
    var idle = Vec::new()
    idle.push(create_fn()?)
    let inner = Arc::new(PoolInner[C] {
      state: Mutex::new(PoolState[C] {
        idle: idle,
        current_size: 1
      }),
      max_size: max_size,
      create_fn: create_fn,
      available: Condvar::new()
    })
    Result::Ok(Pool { inner: inner })
  end
  
  def get(self: Pool[C]) -> Result[PooledConnection[C], DbError]
    let inner = self.inner.clone()
    var guard = inner.ptr.as_ref().state.lock()
    loop do
      if let Option::Some(conn) = guard.get_mut().idle.pop() then
        return Result::Ok(PooledConnection {
          conn: Option::Some(conn),
          inner: inner.clone()
        })
      end
      
      # The max_size enforcement under the lock: a new connection is
      # created ONLY while the created count is below the bound.
      if guard.get_mut().current_size < inner.ptr.as_ref().max_size then
        match (inner.ptr.as_ref().create_fn)()
        when Result::Ok(conn) then
          # The count increments EXACTLY on a successful create.
          guard.get_mut().current_size = guard.get_mut().current_size + 1
          return Result::Ok(PooledConnection {
            conn: Option::Some(conn),
            inner: inner.clone()
          })
        when Result::Err(e) then
          # The factory failure consistency: no increment, the lock is
          # released on return, and a later get() may retry.
          return Result::Err(e)
        end
      end
      
      guard = inner.ptr.as_ref().available.wait(guard)
    end
  end
  
  def return_conn(self: Pool[C], sink conn: C) -> Unit
    let inner = self.inner.clone()
    var guard = inner.ptr.as_ref().state.lock()
    guard.get_mut().idle.push(conn)
    inner.ptr.as_ref().available.notify_one()
  end
end

struct PooledConnection[C]
  conn: Option[C]
  inner: Arc[PoolInner[C]]
end

impl[C] PooledConnection[C] where C: Connection
  def execute(inout self: PooledConnection[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    match self.conn
    when Option::Some(c) then c.execute(sql, params)
    when Option::None then Result::Err(DbError::Closed)
    end
  end
  
  def query(self: PooledConnection[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    match self.conn
    when Option::Some(c) then c.query(sql, params)
    when Option::None then Result::Err(DbError::Closed)
    end
  end
end

impl[C] Drop for PooledConnection[C] where C: Connection
  def drop(inout self: PooledConnection[C]) -> Unit
    if let Option::Some(conn) = self.conn.take() then
      # The handle's Arc clone keeps the pool inner alive for the
      # return — dropping the Pool while this handle lives is safe.
      let pool = Pool { inner: self.inner.clone() }
      pool.return_conn(conn)
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 5: MYSQL DRIVER
# ═══════════════════════════════════════════════════════════════

## FFI bindings for libmysqlclient
extern "C"
  def mysql_init(mysql: Ptr[Unit]) -> Ptr[Unit]
  def mysql_real_connect(mysql: Ptr[Unit], host: Ptr[u8], user: Ptr[u8],
                          passwd: Ptr[u8], db: Ptr[u8], port: u32,
                          unix_socket: Ptr[u8], client_flag: UInt) -> Ptr[Unit]
  def mysql_close(mysql: Ptr[Unit]) -> Unit
  def mysql_query(mysql: Ptr[Unit], query: Ptr[u8]) -> i32
  def mysql_real_query(mysql: Ptr[Unit], query: Ptr[u8], length: UInt) -> i32
  def mysql_store_result(mysql: Ptr[Unit]) -> Ptr[Unit]
  def mysql_free_result(result: Ptr[Unit]) -> Unit
  def mysql_num_fields(result: Ptr[Unit]) -> u32
  def mysql_num_rows(result: Ptr[Unit]) -> u64
  def mysql_fetch_row(result: Ptr[Unit]) -> PtrMut[PtrMut[u8]]
  def mysql_fetch_lengths(result: Ptr[Unit]) -> PtrMut[UInt]
  def mysql_fetch_field(result: Ptr[Unit]) -> PtrMut[MysqlField]
  def mysql_affected_rows(mysql: Ptr[Unit]) -> u64
  def mysql_error(mysql: Ptr[Unit]) -> Ptr[u8]
  def mysql_errno(mysql: Ptr[Unit]) -> u32
  def mysql_real_escape_string(mysql: Ptr[Unit], to: PtrMut[u8], from: Ptr[u8], length: UInt) -> UInt
  def mysql_autocommit(mysql: Ptr[Unit], mode: u8) -> u8
  def mysql_commit(mysql: Ptr[Unit]) -> u8
  def mysql_rollback(mysql: Ptr[Unit]) -> u8
  def mysql_stmt_init(mysql: Ptr[Unit]) -> Ptr[Unit]
  def mysql_stmt_prepare(stmt: Ptr[Unit], query: Ptr[u8], length: UInt) -> i32
  def mysql_stmt_execute(stmt: Ptr[Unit]) -> i32
  def mysql_stmt_store_result(stmt: Ptr[Unit]) -> i32
  def mysql_stmt_fetch(stmt: Ptr[Unit]) -> i32
  def mysql_stmt_result_metadata(stmt: Ptr[Unit]) -> Ptr[Unit]
  def mysql_stmt_close(stmt: Ptr[Unit]) -> u8
  def mysql_stmt_affected_rows(stmt: Ptr[Unit]) -> u64
  def mysql_stmt_error(stmt: Ptr[Unit]) -> Ptr[u8]
  # The MySQL native shim (blocking-pool design): every call that must touch a
  # real MYSQL_BIND goes through the Tangerine-facing shim
  # (native/mysql_shims.c), which builds the MYSQL_BIND arrays internally
  # from the stable Tangerine descriptors (MysqlParam / MysqlResultCell).
  # The handwritten st_mysql_bind layout is gone from the module.
  def tg_mysql_stmt_bind_and_execute(stmt: Ptr[Unit], params: Ptr[MysqlParam], count: UInt) -> i32
  def tg_mysql_stmt_bind_result(stmt: Ptr[Unit], cells: Ptr[MysqlResultCell], count: UInt) -> i32
  def tg_mysql_stmt_fetch_column(stmt: Ptr[Unit], cell: Ptr[MysqlResultCell], column: UInt, offset: UInt) -> i32
  def tg_mysql_layout_probe(out: PtrMut[i64], out_len: UInt) -> i32
end

@repr(C)
struct MysqlField
  name: Ptr[u8]
  org_name: Ptr[u8]
  table: Ptr[u8]
  org_table: Ptr[u8]
  db: Ptr[u8]
  catalog: Ptr[u8]
  def_: Ptr[u8]
  length: UInt
  max_length: UInt
  name_length: u32
  org_name_length: u32
  table_length: u32
  org_table_length: u32
  db_length: u32
  catalog_length: u32
  def_length: u32
  flags: u32
  decimals: u32
  charsetnr: u32
  type_: u32   ## MYSQL_TYPE_*
end

# THE SHIM DESCRIPTORS (blocking-pool design): the stable Tangerine-facing
# layouts the native shim (native/mysql_shims.c) builds the REAL
# MYSQL_BIND arrays from. The hand-written st_mysql_bind layout is gone —
# the Tangerine module never declares it. The C side prints and returns
# the sizeof/_Alignof/offsetof facts of both descriptors (and of
# MYSQL_BIND / MYSQL_FIELD) through tg_mysql_layout_probe; the layout
# probe test asserts the Tangerine @repr(C) layouts against those facts.

# One parameter: type 0 = SQL NULL, 1 = text (MYSQL_TYPE_STRING), 2 =
# blob (MYSQL_TYPE_BLOB); data/len point into the Tangerine-owned
# payload buffer (the MysqlParamBacking owns every payload through the
# call).
@repr(C)
struct MysqlParam
  type_: i32
  data: Ptr[u8]
  len: UInt
end

# One result column: the output buffer (the INITIAL fixed-size buffer —
# a truncated column is refetched through tg_mysql_stmt_fetch_column
# with a RESIZED buffer in a fresh descriptor), its capacity, the
# length/is_null out cells, and the MYSQL_TYPE_* value.
@repr(C)
struct MysqlResultCell
  buffer: Ptr[u8]
  capacity: UInt
  length: Ptr[UInt]
  is_null: Ptr[u8]
  type_: i32
end

const MYSQL_PARAM_NULL: i32 = 0
const MYSQL_PARAM_TEXT: i32 = 1
const MYSQL_PARAM_BLOB: i32 = 2

## enum_field_types values (mysql.h), used as the MysqlResultCell.type_
## (and MysqlField.type_) values.
const MYSQL_TYPE_TINY: u32 = 1
const MYSQL_TYPE_LONGLONG: u32 = 8
const MYSQL_TYPE_DOUBLE: u32 = 5
const MYSQL_TYPE_NULL: u32 = 6
const MYSQL_TYPE_TINY_BLOB: u32 = 249
const MYSQL_TYPE_MEDIUM_BLOB: u32 = 250
const MYSQL_TYPE_LONG_BLOB: u32 = 251
const MYSQL_TYPE_BLOB: u32 = 252
const MYSQL_TYPE_STRING: u32 = 254

## mysql_stmt_fetch() result codes (mysql.h)
const MYSQL_NO_DATA: i32 = 100
const MYSQL_DATA_TRUNCATED: i32 = 101

## The per-column output buffer size for the prepared-statement result
## fetch (a column value longer than this is reported as truncated).
const MYSQL_FETCH_BUFFER_SIZE: UInt = 65536

struct MysqlConfig
  host: String
  port: u16
  user: String
  password: String
  database: String
  charset: String
end

def mysql_config_new(host: str, user: str, password: str, database: str) -> MysqlConfig
  MysqlConfig {
    host: host.to_string(),
    port: 3306,
    user: user.to_string(),
    password: password.to_string(),
    database: database.to_string(),
    charset: "utf8mb4".to_string(),
  }
end

# The heap-stable Mysql connection: the native MYSQL* handle, the
# connected flag, and the shared ConnLifetime cell (the Open/Closing/
# Closed state + the child count) live in the Arc-owned inner (the
# inner's Drop runs mysql_close at the Arc's last-release), and
# statements/transactions hold a boxed clone of the inner Arc as their
# lifetime pin plus a clone of the life cell.
struct MysqlInner
  handle: Ptr[Unit]
  connected: Bool
  life: Arc[ConnLifetime]
end

struct Mysql
  inner: Arc[MysqlInner]
end

def mysql_open(config: MysqlConfig) -> Result[Mysql, DbError]
  let handle = unsafe "FFI boundary" do mysql_init(Ptr::null()) end
  if handle.is_null() then
    return Result::Err(DbError::ConnectionFailed("mysql_init failed".to_string()))
  end

  let result = unsafe "FFI boundary" do
    mysql_real_connect(
      handle,
      config.host.to_cstring().as_ptr(),
      config.user.to_cstring().as_ptr(),
      config.password.to_cstring().as_ptr(),
      config.database.to_cstring().as_ptr(),
      config.port as u32,
      Ptr::null(),
      0
    )
  end

  if result.is_null() then
    let err_msg = unsafe "FFI boundary" do
      cstring_to_string(mysql_error(handle))
    end
    unsafe "FFI boundary" do mysql_close(handle) end
    return Result::Err(DbError::ConnectionFailed(err_msg))
  end

  Result::Ok(Mysql { inner: Arc::new(MysqlInner { handle: handle, connected: true, life: conn_lifetime_new() }) })
end

impl Connection for Mysql
  def execute(inout self: Mysql, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    conn_lifetime_check(self.inner.ptr.as_ref().life)?
    if params.is_empty() then
      let ret = unsafe "FFI boundary" do mysql_query(self.inner.ptr.as_ref().handle, sql.to_cstring().as_ptr()) end
      if ret != 0 then
        let err = unsafe "FFI boundary" do cstring_to_string(mysql_error(self.inner.ptr.as_ref().handle)) end
        return Result::Err(DbError::QueryFailed(err))
      end
      let affected = unsafe "FFI boundary" do mysql_affected_rows(self.inner.ptr.as_ref().handle) end
      Result::Ok(affected as UInt)
    else
      # Parameterized execution goes through the REAL prepared-statement
      # path (the shim's tg_mysql_stmt_bind_and_execute — the MYSQL_BIND
      # array is built inside the C shim) — never the manual
      # interpolation.
      mysql_prepared_execute(self.inner.ptr.as_ref().handle, sql, params)
    end
  end

  def query(self: Mysql, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    conn_lifetime_check(self.inner.ptr.as_ref().life)?
    if params.is_empty() then
      let ret = unsafe "FFI boundary" do
        mysql_real_query(self.inner.ptr.as_ref().handle, sql.to_cstring().as_ptr(), sql.len() as UInt)
      end
      if ret != 0 then
        let err = unsafe "FFI boundary" do cstring_to_string(mysql_error(self.inner.ptr.as_ref().handle)) end
        return Result::Err(DbError::QueryFailed(err))
      end
      let result = unsafe "FFI boundary" do mysql_store_result(self.inner.ptr.as_ref().handle) end
      if result.is_null() then
        return Result::Ok(Rows { columns: Vec::new(), data: Vec::new(), pos: 0 })
      end
      let rows = mysql_result_to_rows(result)
      unsafe "FFI boundary" do mysql_free_result(result) end
      Result::Ok(rows)
    else
      # Parameterized query through the prepared-statement path with the
      # shim-built MYSQL_BIND parameter binding.
      mysql_prepared_query(self.inner.ptr.as_ref().handle, sql, params)
    end
  end

  def begin_transaction(inout self: Mysql) -> Result[Transaction, DbError]
    let life = self.inner.ptr.as_ref().life.clone()
    conn_lifetime_check(life)?
    let ret = unsafe "FFI boundary" do mysql_autocommit(self.inner.ptr.as_ref().handle, 0) end
    if ret != 0 then
      return Result::Err(DbError::TransactionError("failed to disable autocommit".to_string()))
    end
    mysql_execute_raw(self.inner.ptr.as_ref().handle, "BEGIN", &[])?
    conn_lifetime_register_child(life)
    Result::Ok(Transaction {
      conn_handle: self.inner.ptr.as_ref().handle,
      conn_token: ConnToken { pin: Arc::new(Box::new(self.inner.clone())), life: life },
      driver: DriverKind::Mysql,
      finished: false
    })
  end

  def prepare(inout self: Mysql, sql: str) -> Result[Statement, DbError]
    let life = self.inner.ptr.as_ref().life.clone()
    conn_lifetime_check(life)?
    let stmt = unsafe "FFI boundary" do mysql_stmt_init(self.inner.ptr.as_ref().handle) end
    if stmt.is_null() then
      return Result::Err(DbError::Internal("mysql_stmt_init failed".to_string()))
    end
    let ret = unsafe "FFI boundary" do
      mysql_stmt_prepare(stmt, sql.to_cstring().as_ptr(), sql.len())
    end
    if ret != 0 then
      let err = unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end
      unsafe "FFI boundary" do mysql_stmt_close(stmt) end
      return Result::Err(DbError::QueryFailed(err))
    end
    conn_lifetime_register_child(life)
    Result::Ok(Statement {
      handle: stmt,
      sql: sql.to_string(),
      driver: DriverKind::Mysql,
      conn_handle: null_ptr(),
      param_count: 0,
      stmt_name: String::new(),
      conn_token: ConnToken { pin: Arc::new(Box::new(self.inner.clone())), life: life }
    })
  end

  def close(inout self: Mysql) -> Result[Unit, DbError]
    # THE BUSY POLICY (connection-lifetime design): live statements/transactions
    # block the close.
    let inner = self.inner.ptr.as_ref()
    let life = inner.life.clone()
    if life.ptr.as_ref().children.load(Ordering::Acquire) > 0 then
      return Result::Err(DbError::Busy("connection has live statements or transactions".to_string()))
    end
    if !inner.connected then
      life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Closed), Ordering::Release)
      return Result::Ok(())
    end
    life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Closing), Ordering::Release)
    unsafe "FFI boundary" do mysql_close(inner.handle) end
    inner.connected = false
    life.ptr.as_ref().state.store(conn_state_to_int(ConnState::Closed), Ordering::Release)
    Result::Ok(())
  end
end

impl Drop for MysqlInner
  def drop(inout self: MysqlInner) -> Unit
    if self.connected then
      unsafe "FFI boundary" do mysql_close(self.handle) end
      self.connected = false
    end
  end
end

def mysql_execute_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  if params.is_empty() then
    let ret = unsafe "FFI boundary" do mysql_query(handle, sql.to_cstring().as_ptr()) end
    if ret != 0 then
      let err = unsafe "FFI boundary" do cstring_to_string(mysql_error(handle)) end
      return Result::Err(DbError::QueryFailed(err))
    end
    let affected = unsafe "FFI boundary" do mysql_affected_rows(handle) end
    Result::Ok(affected as UInt)
  else
    mysql_prepared_execute(handle, sql, params)
  end
end

def mysql_query_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  if params.is_empty() then
    let ret = unsafe "FFI boundary" do
      mysql_real_query(handle, sql.to_cstring().as_ptr(), sql.len() as UInt)
    end
    if ret != 0 then
      let err = unsafe "FFI boundary" do cstring_to_string(mysql_error(handle)) end
      return Result::Err(DbError::QueryFailed(err))
    end
    let result = unsafe "FFI boundary" do mysql_store_result(handle) end
    if result.is_null() then
      return Result::Ok(Rows { columns: Vec::new(), data: Vec::new(), pos: 0 })
    end
    let rows = mysql_result_to_rows(result)
    unsafe "FFI boundary" do mysql_free_result(result) end
    Result::Ok(rows)
  else
    mysql_prepared_query(handle, sql, params)
  end
end

def mysql_result_to_rows(result: Ptr[Unit]) -> Rows
  let num_fields = unsafe "FFI boundary" do mysql_num_fields(result) end as UInt
  let num_rows = unsafe "FFI boundary" do mysql_num_rows(result) end as UInt

  var columns = Vec::new()
  var col_types = Vec::new()
  for i in 0..num_fields do
    let field = unsafe "FFI boundary" do mysql_fetch_field(result) end
    if !field.is_null() then
      let name = unsafe "FFI boundary" do cstring_to_string(field.name) end
      columns.push(name)
      col_types.push(field.type_)
    end
  end

  var data = Vec::new()
  for _ in 0..num_rows do
    let row_ptr = unsafe "FFI boundary" do mysql_fetch_row(result) end as Ptr[Ptr[u8]]
    if row_ptr.is_null() then break end
    let lengths = unsafe "FFI boundary" do mysql_fetch_lengths(result) end as Ptr[UInt]
    var row_values = Vec::new()
    for j in 0..num_fields do
      let field_ptr = unsafe "FFI boundary" do *row_ptr.offset(j as isize) end
      if field_ptr.is_null() then
        row_values.push(SqlValue::Null)
      else
        let len = unsafe "FFI boundary" do *lengths.offset(j as isize) end
        if mysql_type_is_blob(col_types[j]) then
          var bytes = Vec::with_capacity(len)
          for k in 0..len do
            bytes.push(unsafe "FFI boundary" do *(field_ptr.offset(k as isize)) end)
          end
          row_values.push(SqlValue::Blob(bytes))
        else
          let s = unsafe "FFI boundary" do string_from_ptr(field_ptr, len) end
          row_values.push(SqlValue::Text(s))
        end
      end
    end
    data.push(row_values)
  end

  Rows { columns: columns, data: data, pos: 0 }
end

# ———————————————————————————————————————————————————————————————
# The shim-backed parameter binding
# ———————————————————————————————————————————————————————————————
# The prepared path binds parameters through the native shim
# (tg_mysql_stmt_bind_and_execute): the Tangerine side builds the stable
# MysqlParam descriptor array (the values are sent as DATA, so the
# hostile values (' \ \\ \0 ' OR 1=1 --, multibyte text, binary blobs)
# can never be reinterpreted as SQL), and the C shim builds the real
# MYSQL_BIND array internally and runs bind_param + execute.
#
# MysqlParamBacking owns every payload through the call:
#   params   — the MysqlParam descriptor array (one per parameter)
#   buffers  — the owned byte payloads (text/numeric strings, blob
#              bytes) — the descriptor data pointers stay valid through
#              the call
# The descriptor vectors are pre-sized to the parameter count
# (with_capacity), so their storage never reallocates while the
# per-parameter data pointers are being recorded.
struct MysqlParamBacking
  params: Vec[MysqlParam]
  buffers: Vec[Vec[u8]]
end

impl MysqlParamBacking
  def new(n: UInt) -> MysqlParamBacking
    MysqlParamBacking {
      params: Vec::with_capacity(n),
      buffers: Vec::with_capacity(n)
    }
  end
  
  def push_text_param(inout self: MysqlParamBacking, sink s: String) -> Unit
    let bytes = s.as_bytes()
    let len = bytes.len() as UInt
    self.params.push(MysqlParam { type_: MYSQL_PARAM_TEXT, data: bytes.as_ptr(), len: len })
    self.buffers.push(bytes)
  end
  
  def push_blob_param(inout self: MysqlParamBacking, sink blob: Vec[u8]) -> Unit
    let len = blob.len() as UInt
    self.params.push(MysqlParam { type_: MYSQL_PARAM_BLOB, data: blob.as_ptr(), len: len })
    self.buffers.push(blob)
  end
  
  def push_null_param(inout self: MysqlParamBacking) -> Unit
    self.params.push(MysqlParam { type_: MYSQL_PARAM_NULL, data: null_ptr(), len: 0 })
  end
end

def mysql_build_binds(params: [Box[dyn ToSqlParam]]) -> MysqlParamBacking
  var backing = MysqlParamBacking::new(params.len())
  for param in params do
    let value = param.to_sql_param()
    match value
    when SqlValue::Null then
      backing.push_null_param()
    when SqlValue::Integer(i) then
      backing.push_text_param(i.to_string())
    when SqlValue::Float(f) then
      backing.push_text_param(f.to_string())
    when SqlValue::Text(t) then
      backing.push_text_param(t)
    when SqlValue::Bool(b) then
      backing.push_text_param((if b then "1" else "0" end).to_string())
    when SqlValue::Blob(blob) then
      backing.push_blob_param(blob)
    when SqlValue::Timestamp(t) then
      backing.push_text_param(t.to_string())
    end
  end
  backing
end

# Bind the descriptor array on the statement and execute it through the
# shim; the backing is local, so every payload buffer lives exactly
# through the bind + execute calls.
def mysql_stmt_bind_and_execute(stmt: Ptr[Unit], params: [Box[dyn ToSqlParam]]) -> Result[Unit, DbError]
  if params.is_empty() then
    let ret = unsafe "FFI boundary" do mysql_stmt_execute(stmt) end
    if ret != 0 then
      return Result::Err(DbError::QueryFailed(unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end))
    end
    return Result::Ok(())
  end
  let backing = mysql_build_binds(params)
  let bind_rc = unsafe "FFI boundary" do tg_mysql_stmt_bind_and_execute(stmt, backing.params.as_ptr(), backing.params.len() as UInt) end
  if bind_rc != 0 then
    return Result::Err(DbError::BindError(0, unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end))
  end
  Result::Ok(())
end

def mysql_type_is_blob(t: u32) -> Bool
  t == MYSQL_TYPE_TINY_BLOB || t == MYSQL_TYPE_MEDIUM_BLOB || t == MYSQL_TYPE_LONG_BLOB || t == MYSQL_TYPE_BLOB
end

# Fetch the result set of an executed prepared statement: store the
# result, read the metadata (names + types), bind STRING/BLOB-typed
# output cells through the shim (the real MYSQL_BIND array is built
# inside the C shim), and fetch every row.
def mysql_prepared_fetch_rows(stmt: Ptr[Unit]) -> Result[Rows, DbError]
  let store_rc = unsafe "FFI boundary" do mysql_stmt_store_result(stmt) end
  if store_rc != 0 then
    return Result::Err(DbError::QueryFailed(unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end))
  end
  let metadata = unsafe "FFI boundary" do mysql_stmt_result_metadata(stmt) end
  if metadata.is_null() then
    return Result::Ok(Rows { columns: Vec::new(), data: Vec::new(), pos: 0 })
  end
  let num_fields = unsafe "FFI boundary" do mysql_num_fields(metadata) end as UInt
  var columns = Vec::new()
  var col_types = Vec::new()
  for i in 0..num_fields do
    let field = unsafe "FFI boundary" do mysql_fetch_field(metadata) end
    if !field.is_null() then
      columns.push(unsafe "FFI boundary" do cstring_to_string(field.name) end)
      col_types.push(field.type_)
    else
      columns.push("column_" + i.to_string())
      col_types.push(MYSQL_TYPE_STRING)
    end
  end
  let n = num_fields as Int
  # THE OUTPUT CELLS (blocking-pool design): one MysqlResultCell per column —
  # the INITIAL fixed-size buffer (MYSQL_FETCH_BUFFER_SIZE), the
  # length/is_null out cells — bound through the shim
  # (tg_mysql_stmt_bind_result builds the real MYSQL_BIND array). The
  # out vectors are pre-sized so the length/is_null pointers stay valid.
  var out_cells = Vec::with_capacity(n)
  var out_buffers = Vec::with_capacity(n)
  var out_lengths = Vec::with_capacity(n)
  var out_nulls = Vec::with_capacity(n)
  for i in 0..num_fields do
    out_lengths.push(0)
    out_nulls.push(0)
    let length_ptr = out_lengths.as_ptr().offset(i as Int) as Ptr[UInt]
    let is_null_ptr = out_nulls.as_ptr().offset(i as Int) as Ptr[u8]
    var buf = Vec::with_capacity(MYSQL_FETCH_BUFFER_SIZE as Int)
    let is_blob = mysql_type_is_blob(col_types[i])
    let ty = if is_blob then MYSQL_TYPE_BLOB else MYSQL_TYPE_STRING end
    out_cells.push(MysqlResultCell {
      buffer: buf.as_ptr(),
      capacity: MYSQL_FETCH_BUFFER_SIZE,
      length: length_ptr,
      is_null: is_null_ptr,
      type_: ty as i32
    })
    out_buffers.push(buf)
  end
  let bind_rc = unsafe "FFI boundary" do tg_mysql_stmt_bind_result(stmt, out_cells.as_ptr(), num_fields as UInt) end
  if bind_rc != 0 then
    let err = unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end
    unsafe "FFI boundary" do mysql_free_result(metadata) end
    return Result::Err(DbError::QueryFailed(err))
  end
  var data = Vec::new()
  loop
    let fetch_rc = unsafe "FFI boundary" do mysql_stmt_fetch(stmt) end
    if fetch_rc == MYSQL_NO_DATA then
      break
    end
    if fetch_rc != 0 && fetch_rc != MYSQL_DATA_TRUNCATED then
      let err = unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end
      unsafe "FFI boundary" do mysql_free_result(metadata) end
      return Result::Err(DbError::QueryFailed(err))
    end
    # THE LARGE-VALUE REFETCH (blocking-pool design): a MYSQL_DATA_TRUNCATED
    # fetch leaves the FULL value length in the column's length cell —
    # observe it, grow the column's buffer to the full length, and
    # refetch the FULL value through tg_mysql_stmt_fetch_column (the
    # shim builds the one-off MYSQL_BIND from the resized descriptor).
    # The ORIGINAL bound cells are left untouched: the next row's fetch
    # writes into the original buffers again (no rebind needed, no
    # dangling buffer).
    var full_buffers = Vec::new()
    for j in 0..num_fields do
      full_buffers.push(Vec::new())
    end
    if fetch_rc == MYSQL_DATA_TRUNCATED then
      for j in 0..num_fields do
        let full_len = out_lengths[j]
        if full_len > MYSQL_FETCH_BUFFER_SIZE then
          var full_buf = Vec::with_capacity(full_len as Int)
          let cell = MysqlResultCell {
            buffer: full_buf.as_ptr(),
            capacity: full_len,
            length: out_lengths.as_ptr().offset(j as Int) as Ptr[UInt],
            is_null: out_nulls.as_ptr().offset(j as Int) as Ptr[u8],
            type_: out_cells[j].type_
          }
          let rc2 = unsafe "FFI boundary" do tg_mysql_stmt_fetch_column(stmt, cell, j as UInt, 0) end
          if rc2 != 0 then
            let err = unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end
            unsafe "FFI boundary" do mysql_free_result(metadata) end
            return Result::Err(DbError::QueryFailed(err))
          end
          full_buffers[j] = full_buf
        end
      end
    end
    var row_values = Vec::new()
    for j in 0..num_fields do
      if out_nulls[j] != 0 then
        row_values.push(SqlValue::Null)
      else
        let len = out_lengths[j]
        let buf_ptr = if full_buffers[j].is_empty() then
          out_cells[j].buffer
        else
          full_buffers[j].as_ptr()
        end
        if mysql_type_is_blob(col_types[j]) then
          var bytes = Vec::with_capacity(len)
          for k in 0..len do
            bytes.push(unsafe "FFI boundary" do *(buf_ptr.offset(k as Int)) end)
          end
          row_values.push(SqlValue::Blob(bytes))
        else
          let s = unsafe "FFI boundary" do string_from_ptr(buf_ptr, len) end
          row_values.push(SqlValue::Text(s))
        end
      end
    end
    data.push(row_values)
  end
  unsafe "FFI boundary" do mysql_free_result(metadata) end
  Result::Ok(Rows::new(columns, data))
end

# The parameterized connection-level execute: a fresh prepared statement,
# the real MYSQL_BIND binding, execute, and the deterministic close.
def mysql_prepared_execute(conn: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  let stmt = unsafe "FFI boundary" do mysql_stmt_init(conn) end
  if stmt.is_null() then
    return Result::Err(DbError::Internal("mysql_stmt_init failed".to_string()))
  end
  let prep_rc = unsafe "FFI boundary" do mysql_stmt_prepare(stmt, sql.to_cstring().as_ptr(), sql.len() as UInt) end
  if prep_rc != 0 then
    let err = unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end
    unsafe "FFI boundary" do mysql_stmt_close(stmt) end
    return Result::Err(DbError::QueryFailed(err))
  end
  let res = mysql_stmt_bind_and_execute(stmt, params)
  if let Result::Err(e) = res then
    unsafe "FFI boundary" do mysql_stmt_close(stmt) end
    return Result::Err(e)
  end
  let affected = unsafe "FFI boundary" do mysql_stmt_affected_rows(stmt) end
  unsafe "FFI boundary" do mysql_stmt_close(stmt) end
  Result::Ok(affected as UInt)
end

# The parameterized connection-level query: a fresh prepared statement,
# the real MYSQL_BIND binding, execute, fetch, and the deterministic
# close.
def mysql_prepared_query(conn: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  let stmt = unsafe "FFI boundary" do mysql_stmt_init(conn) end
  if stmt.is_null() then
    return Result::Err(DbError::Internal("mysql_stmt_init failed".to_string()))
  end
  let prep_rc = unsafe "FFI boundary" do mysql_stmt_prepare(stmt, sql.to_cstring().as_ptr(), sql.len() as UInt) end
  if prep_rc != 0 then
    let err = unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end
    unsafe "FFI boundary" do mysql_stmt_close(stmt) end
    return Result::Err(DbError::QueryFailed(err))
  end
  let res = mysql_stmt_bind_and_execute(stmt, params)
  if let Result::Err(e) = res then
    unsafe "FFI boundary" do mysql_stmt_close(stmt) end
    return Result::Err(e)
  end
  let rows = mysql_prepared_fetch_rows(stmt)
  unsafe "FFI boundary" do mysql_stmt_close(stmt) end
  rows
end

def mysql_stmt_run(inout stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  conn_lifetime_check(stmt.conn_token.life)?
  if stmt.handle.is_null() then
    return Result::Err(DbError::QueryFailed("statement already finalized"))
  end
  let res = mysql_stmt_bind_and_execute(stmt.handle, params)
  if let Result::Err(e) = res then
    return Result::Err(e)
  end
  let affected = unsafe "FFI boundary" do mysql_stmt_affected_rows(stmt.handle) end
  Result::Ok(affected as UInt)
end

def mysql_stmt_query(stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  conn_lifetime_check(stmt.conn_token.life)?
  if stmt.handle.is_null() then
    return Result::Err(DbError::QueryFailed("statement already finalized"))
  end
  let res = mysql_stmt_bind_and_execute(stmt.handle, params)
  if let Result::Err(e) = res then
    return Result::Err(e)
  end
  mysql_prepared_fetch_rows(stmt.handle)
end

def mysql_stmt_finalize(inout stmt: Statement) -> Result[Unit, DbError]
  # The state check: on a closed connection the native close is skipped
  # (the explicit close is blocked by the Busy policy while the statement
  # lives); the handle is nulled either way so the drop is a no-op.
  if !stmt.handle.is_null() && conn_lifetime_open(stmt.conn_token.life) then
    unsafe "FFI boundary" do mysql_stmt_close(stmt.handle) end
    stmt.handle = null_ptr()
  end
  Result::Ok(())
end

def cstring_to_string(ptr: Ptr[u8]) -> String
  if ptr.is_null() then return "".to_string() end
  var len = 0
  while unsafe "FFI" do *ptr.offset(len as isize) end != 0 do
    len = len + 1
  end
  unsafe "FFI" do string_from_ptr(ptr, len) end
end

def string_from_ptr(ptr: Ptr[u8], len: UInt) -> String
  var bytes = Vec::with_capacity(len)
  for i in 0..len do
    bytes.push(unsafe "FFI" do *ptr.offset(i as isize) end)
  end
  String::from_utf8(bytes).unwrap_or("".to_string())
end

# ═══════════════════════════════════════════════════════════════
# PART 6: ASYNC DATABASE OPERATIONS
# ═══════════════════════════════════════════════════════════════

# THE REAL BLOCKING POOL (blocking-pool design): spawn_blocking NO LONGER
# executes f() inline on the async executor — it submits the closure to a
# REAL bounded pool of N worker threads (BLOCKING_POOL_SIZE, created
# exactly once via the Once guard — the bounded thread creation). The
# workers block on the job queue (Mutex[VecDeque] + Condvar); the RESULT
# is delivered through the BlockingFuture (the cell + the wake bridge) —
# the worker ONLY publishes the value into the synchronized result cell
# (Arc[Mutex[BlockingCell[T]]]) and enqueues the task's id into the
# executor's thread-safe external-wake inbox (external_wake_queue); the
# executor thread drains the inbox in its run loop and wakes the task via
# the INTERNAL wake_task. The worker NEVER touches the executor's
# ready_queue/task_states/join_waiters/reactor or any cooperative waiter
# list — the single-owner executor design is preserved. The pool is
# process-global (the static holds the inner Arc + the join handles); the
# workers hold their OWN Arc clones, so the inner (and the job queue)
# stays alive regardless of the statics.
#
# THE BOUNDED QUEUE (the backpressure policy — CHOSEN over reject): the
# job queue never grows past BLOCKING_POOL_QUEUE_LIMIT. A submitter whose
# push would exceed the limit BLOCKS on the condvar until a worker frees
# a slot (the worker notifies after every pop) — or the shutdown flag is
# set (the drain guarantees the queued jobs still run). No job is ever
# rejected or silently dropped: the queue is bounded by THROTTLING the
# producers, not by losing work. REJECT (an Err on a full queue) was the
# alternative and is NOT used: it cannot be surfaced through
# spawn_blocking's T-returning future, and the graceful-drain contract
# (queued work always runs) prefers a bounded block over a lost job.
const BLOCKING_POOL_SIZE: UInt = 4
const BLOCKING_POOL_QUEUE_LIMIT: UInt = 64

struct BlockingPoolInner
  job_queue: Mutex[VecDeque[Box[dyn FnOnce()]]]
  condvar: Condvar
  shutdown: AtomicBool
end

struct BlockingPool
  inner: Arc[BlockingPoolInner]
  workers: Vec[JoinHandle[Unit]]
end

static mut BLOCKING_POOL: Option[Arc[BlockingPoolInner]] = Option::None
static mut BLOCKING_POOL_WORKERS: Option[Vec[JoinHandle[Unit]]] = Option::None
static mut BLOCKING_POOL_INIT_ERROR: Option[String] = Option::None
static BLOCKING_POOL_ONCE: Once = once_new()

## The pool initialization — THE RESULT (the minimum-worker-count
## contract): the creation FAILS when any worker cannot start (the
## Result::Err — never a swallowed Err(_) => a None worker slot). The
## already-started workers are joined down before the failure returns
## (no thread leaks behind a failed pool), and the pool is never
## installed in a partial state.
def blocking_pool_init() -> Result[Unit, String]
  let inner = Arc::new(BlockingPoolInner {
    job_queue: Mutex::new(VecDeque::new()),
    condvar: Condvar::new(),
    shutdown: atomic_bool_new(false)
  })
  var workers: Vec[JoinHandle[Unit]] = Vec::new()
  var i: UInt = 0
  while i < BLOCKING_POOL_SIZE do
    let worker_inner = inner.clone()
    match ThreadBuilder::new().spawn(|| blocking_worker_loop(worker_inner))
    when Result::Ok(h) then
      workers.push(h)
    when Result::Err(e) then
      # THE MINIMUM-WORKER-COUNT CONTRACT: a pool with fewer than
      # BLOCKING_POOL_SIZE workers is never installed. The started
      # workers are stopped through the flag + the drain (the empty
      # queue exits them) and joined — no thread is leaked behind the
      # failed creation.
      let ch = inner.ptr.as_ref()
      ch.shutdown.store(true, Ordering::Release)
      ch.condvar.notify_all()
      loop do
        match workers.pop()
        when Option::Some(mut handle) then
          let _ = handle.join()
        when Option::None then
          break
        end
      end
      return Result::Err("blocking pool: worker spawn failed: " + e)
    end
    i = i + 1
  end
  BLOCKING_POOL = Option::Some(inner)
  BLOCKING_POOL_WORKERS = Option::Some(workers)
  Result::Ok(())
end

## The pool getter — the Result: the pool is created exactly once (the
## Once guard — a concurrent first caller never double-creates). A
## FAILED creation is surfaced through the init-error static and fails
## every subsequent get: the pool is never observed in a partial state.
def blocking_pool_get() -> Result[Arc[BlockingPoolInner], String]
  BLOCKING_POOL_ONCE.call_once(|| {
    match blocking_pool_init()
    when Result::Ok(()) then ()
    when Result::Err(e) then BLOCKING_POOL_INIT_ERROR = Option::Some(e)
    end
  })
  match BLOCKING_POOL_INIT_ERROR.clone()
  when Option::Some(e) then
    Result::Err(e)
  when Option::None then
    match BLOCKING_POOL.clone()
    when Option::Some(inner) then Result::Ok(inner)
    when Option::None then Result::Err("blocking pool: not initialized".to_string())
    end
  end
end

## The worker loop: block on the job queue (the condvar) until a job
## arrives or the shutdown flag is set, then run the job.
##
## THE DRAIN ORDER (the graceful drain): the loop's ONLY shutdown check
## runs AFTER the drain — a worker that finds jobs under the shutdown
## flag still runs them. The old top-of-loop flag check abandoned queued
## work (the stop-flag-abandon): the worker exited with jobs still in
## the queue. Here the worker exits only when the queue is EMPTY and the
## flag is set.
def blocking_worker_loop(inner: Arc[BlockingPoolInner]) -> Unit
  loop do
    let ch = inner.ptr.as_ref()
    let mut guard = ch.job_queue.lock()
    # Wait while the queue is empty and the pool is not shutting down —
    # every wakeup re-checks the predicate (no lost wakeup, no spurious
    # exit).
    while guard.is_empty() && !ch.shutdown.load(Ordering::Acquire) do
      guard = ch.condvar.wait(guard)
    end
    if guard.is_empty() then
      # THE SHUTDOWN CHECK AFTER THE DRAIN: the queue is empty — either
      # the shutdown flag is set (the drain is complete — the worker
      # exits) or a spurious wakeup left the queue empty (re-wait).
      drop(guard)
      if ch.shutdown.load(Ordering::Acquire) then
        break
      end
    else
      let job = guard.pop_front()
      drop(guard)
      # The freed slot wakes a backpressured producer (or a sibling
      # worker; the predicate re-checks make every wakeup safe).
      ch.condvar.notify_one()
      match job
      when Option::Some(f) then f()
      when Option::None then ()
      end
    end
  end
end

impl BlockingPoolInner
  # The job must carry the cross-thread property: the closure (with its
  # captures) crosses the pool boundary and runs on a worker thread — the
  # Transferable bound is checked at the submit site.
  #
  # THE BOUNDED QUEUE (backpressure): the push BLOCKS while the queue is
  # at the limit — the worker's post-pop notify wakes the blocked
  # producer (the predicate re-checks make the wakeup safe). The
  # shutdown flag unblocks a producer whose pool is draining: the drain
  # runs the pushed job before the workers exit.
  def execute[F: FnOnce() -> Unit + Transferable](self: BlockingPoolInner, f: F) -> Unit
    let mut guard = self.job_queue.lock()
    while (guard.len() as UInt) >= BLOCKING_POOL_QUEUE_LIMIT && !self.shutdown.load(Ordering::Acquire) do
      guard = self.condvar.wait(guard)
    end
    guard.push_back(Box::new(f))
    drop(guard)
    self.condvar.notify_one()
  end
end

# The graceful shutdown: set the flag, wake every worker, join them (the
# bounded thread creation is released). The workers' drain-first loop
# runs every queued job before the flag check exits them — the shutdown
# never abandons queued work.
def blocking_pool_shutdown() -> Unit
  let workers = match BLOCKING_POOL_WORKERS.take()
  when Option::Some(w) then w
  when Option::None then return
  end
  let inner = match BLOCKING_POOL.clone()
  when Option::Some(i) then i
  when Option::None then return
  end
  let ch = inner.ptr.as_ref()
  ch.shutdown.store(true, Ordering::Release)
  ch.condvar.notify_all()
  loop do
    match workers.pop()
    when Option::Some(mut handle) then
      let _ = handle.join()
    when Option::None then
      break
    end
  end
end

# The Transaction (a raw conn_handle + the Arc pin/life token) crosses
# the pool boundary ONLY as the value returned from begin_transaction:
# the conn_handle's pointee is pinned by the token's Arc for the value's
# whole lifetime, so the raw pointer stays valid on the receiving side.
# The structural solver cannot prove this (Ptr[Unit] is not
# auto-Transferable), so the impl is the explicit, documented opt-in
# through the UnsafeTransferable gate (concurrency properties — the ONLY
# user-implementable marker surface of the concurrency model).
impl UnsafeTransferable for Transaction {}

## Trait for async database connections. Mirrors Connection but returns futures.
trait AsyncConnection
  async def execute(inout self: Self, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  async def query(self: Self, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  async def begin_transaction(inout self: Self) -> Result[AsyncTransaction, DbError]
  async def close(inout self: Self) -> Result[Unit, DbError]
end

## The async transaction: owns the underlying Transaction (taken into the
## pool closure for every operation and put back through the channel).
struct AsyncTransaction
  tx: Option[Transaction]
end

impl AsyncTransaction
  async def execute(inout self: AsyncTransaction, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    match self.tx
    when Option::Some(_) then ()
    when Option::None then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    let sql_owned = sql.to_string()
    let mut tx = self.tx.take().unwrap()
    let result = spawn_blocking(|| {
      let r = tx.execute(&sql_owned, params)
      (r, tx)
    }).await
    let (r, tx_back) = result
    self.tx = Option::Some(tx_back)
    r
  end

  async def query(inout self: AsyncTransaction, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    match self.tx
    when Option::Some(_) then ()
    when Option::None then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    let sql_owned = sql.to_string()
    let mut tx = self.tx.take().unwrap()
    let result = spawn_blocking(|| {
      let r = tx.query(&sql_owned, params)
      (r, tx)
    }).await
    let (r, tx_back) = result
    self.tx = Option::Some(tx_back)
    r
  end

  async def commit(inout self: AsyncTransaction) -> Result[Unit, DbError]
    match self.tx
    when Option::Some(_) then ()
    when Option::None then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    let mut tx = self.tx.take().unwrap()
    let result = spawn_blocking(|| tx.commit()).await
    self.tx = Option::Some(tx)
    result
  end

  async def rollback(inout self: AsyncTransaction) -> Result[Unit, DbError]
    match self.tx
    when Option::Some(_) then ()
    when Option::None then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    let mut tx = self.tx.take().unwrap()
    let result = spawn_blocking(|| tx.rollback()).await
    self.tx = Option::Some(tx)
    result
  end
end

## Async wrapper around a synchronous Connection.
## Executes DB operations on the REAL blocking pool to avoid blocking the
## async executor.
## THE SYNCHRONIZED CONNECTION STATE (blocking-pool design): the wrapper owns
## the connection in an Arc[Mutex[C]] — the shared state. Every async
## method clones the Arc BEFORE the await and the blocking closure locks
## the mutex and runs the operation on the pool; no method ever captures
## the inout receiver into the closure (no inout-across-await).
struct AsyncWrapper[C: Connection + Transferable]
  inner: Arc[Mutex[C]]
end

def async_wrap[C: Connection + Transferable](conn: C) -> AsyncWrapper[C]
  AsyncWrapper { inner: Arc::new(Mutex::new(conn)) }
end

impl[C: Connection + Transferable] AsyncConnection for AsyncWrapper[C]
  async def execute(inout self: AsyncWrapper[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    let conn = self.inner.clone()
    let sql_owned = sql.to_string()
    spawn_blocking(|| {
      let mut guard = conn.lock()
      guard.get_mut().execute(&sql_owned, params)
    }).await
  end

  async def query(self: AsyncWrapper[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    let conn = self.inner.clone()
    let sql_owned = sql.to_string()
    spawn_blocking(|| {
      let mut guard = conn.lock()
      guard.get_mut().query(&sql_owned, params)
    }).await
  end

  async def begin_transaction(inout self: AsyncWrapper[C]) -> Result[AsyncTransaction, DbError]
    let conn = self.inner.clone()
    let result = spawn_blocking(|| {
      let mut guard = conn.lock()
      guard.get_mut().begin_transaction()
    }).await
    match result
    when Result::Ok(t) then Result::Ok(AsyncTransaction { tx: Option::Some(t) })
    when Result::Err(e) then Result::Err(e)
    end
  end

  async def close(inout self: AsyncWrapper[C]) -> Result[Unit, DbError]
    let conn = self.inner.clone()
    spawn_blocking(|| {
      let mut guard = conn.lock()
      guard.get_mut().close()
    }).await
  end
end

## Async connection pool
struct AsyncPool[C: Connection + Transferable]
  pool: Arc[Mutex[Pool[C]]]
end

def async_pool_new[C: Connection + Transferable](max_size: UInt, create_fn: fn() -> Result[C, DbError]) -> Result[AsyncPool[C], DbError]
  let pool = Pool::new(max_size, create_fn)?
  Result::Ok(AsyncPool { pool: Arc::new(Mutex::new(pool)) })
end

impl[C: Connection + Transferable] AsyncPool[C]
  async def get(self: AsyncPool[C]) -> Result[AsyncPooledConnection[C], DbError]
    let pool = self.pool.clone()
    spawn_blocking(|| {
      let mut guard = pool.lock()
      guard.get_mut().get()
    }).await.map(|pc| AsyncPooledConnection { inner: Arc::new(Mutex::new(pc)) })
  end
end

struct AsyncPooledConnection[C: Connection]
  inner: Arc[Mutex[PooledConnection[C]]]
end

impl[C: Connection + Transferable] AsyncConnection for AsyncPooledConnection[C]
  async def execute(inout self: AsyncPooledConnection[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    let pc = self.inner.clone()
    let sql_owned = sql.to_string()
    spawn_blocking(|| {
      let mut guard = pc.lock()
      guard.get_mut().execute(&sql_owned, params)
    }).await
  end

  async def query(self: AsyncPooledConnection[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    let pc = self.inner.clone()
    let sql_owned = sql.to_string()
    spawn_blocking(|| {
      let mut guard = pc.lock()
      guard.get_mut().query(&sql_owned, params)
    }).await
  end

  async def begin_transaction(inout self: AsyncPooledConnection[C]) -> Result[AsyncTransaction, DbError]
    Result::Err(DbError::Internal("use the inner connection for transactions".to_string()))
  end

  async def close(inout self: AsyncPooledConnection[C]) -> Result[Unit, DbError]
    Result::Ok(())  ## Returned to pool on drop
  end
end

# ———————————————————————————————————————————————————————————————
# BlockingFuture — the async side of the blocking pool
# ———————————————————————————————————————————————————————————————
# THE SYNCHRONIZED RESULT CELL (the cell + the wake bridge): the value
# crosses the pool boundary through ONE synchronized handoff —
# BlockingCell[T] { result, task_id } under a single Mutex. The future's
# FIRST poll registers the task id (from the waker) into the same cell
# (the waiter registered ONCE — later polls never re-register); the
# worker publishes the value and reads the registered id under the SAME
# lock, so the publish/read and the check/register are atomic with
# respect to each other: a worker that sees no registered id knows the
# task's guaranteed first poll will observe the cell, and a worker that
# sees the id wakes the task through the external-wake bridge. The
# worker path is exactly TWO synchronized executor interactions — the
# cell (Arc[Mutex[BlockingCell[T]]]) and the external-wake queue enqueue
# (executor.external_wake) — it never mutates the executor's
# ready_queue/task_states/join_waiters/reactor or any cooperative waiter
# list (the single-owner executor design).
struct BlockingCell[T]
  result: Option[T]
  task_id: Option[UInt]
end

struct BlockingFuture[T]
  cell: Arc[Mutex[BlockingCell[T]]]
  executor: Arc[ExecutorInner]
  registered: Bool   # the waiter is registered ONCE (the first poll)
end

impl[T] Future for BlockingFuture[T]
  type Output = T

  def poll(inout self, inout cx: Context) -> Poll[T]
    # The cell check and the registration happen under the SAME lock as
    # the worker's publish + id read: no lost wakeup, no missed result.
    let mut guard = self.cell.lock()
    match guard.get_mut().result.take()
    when Option::Some(value) then
      Poll::Ready(value)
    when Option::None then
      if !self.registered then
        self.registered = true
        guard.get_mut().task_id = Option::Some(cx.waker.task_id)
      end
      Poll::Pending
    end
  end
end

## Helper: run a blocking closure on the REAL blocking pool and return a
## future. The closure is submitted to the pool (never executed inline);
## the worker computes f() and publishes the value into the synchronized
## result cell, then wakes the awaiting task through the external-wake
## bridge — the worker never touches the cooperative channel or the
## executor's scheduler state (the executor thread drains the wake inbox
## and wakes the task itself).
async def spawn_blocking[T: Transferable, F: FnOnce() -> T + Transferable](f: F) -> T
  let pool = match blocking_pool_get()
  when Result::Ok(p) then p
  when Result::Err(e) then panic("spawn_blocking: the blocking pool failed to initialize: " + e)
  end
  let executor = match global_executor_inner()
  when Option::Some(exec) then exec
  when Option::None then panic("spawn_blocking: no async executor in scope — call inside block_on")
  end
  # THE ONE synchronized handoff: the value + the registered task id live
  # in the same cell under the same Mutex.
  let cell = Arc::new(Mutex::new(BlockingCell[T] {
    result: Option::None,
    task_id: Option::None
  }))
  pool.execute(|| {
    let value = f()
    # The worker's ONLY executor interactions: the cell set + the
    # external-wake enqueue — everything else stays on the executor
    # thread.
    let mut guard = cell.lock()
    guard.get_mut().result = Option::Some(value)
    let task_id = guard.get_mut().task_id
    drop(guard)
    match task_id
    when Option::Some(tid) then
      unsafe "executor inner access — the worker only enqueues the external wake" do
        let exec = executor.ptr.as_mut()
        exec.external_wake(tid)
      end
    when Option::None then ()
    end
  })
  let future = BlockingFuture[T] {
    cell: cell,
    executor: executor,
    registered: false
  }
  future.await
end
