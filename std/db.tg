# Tangerine Standard Library — Database
#
# SQL database abstractions with SQLite and PostgreSQL drivers.
#
# Usage:
#   let db = Sqlite::open("app.db")?
#   db.execute("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")?
#   let rows = db.query("SELECT * FROM users WHERE age > ?", &[&42])?

use std::core::{Option, Result, Vec, String, Bool, Int, StrView}
use std::collections::{Map}

# ═══════════════════════════════════════════════════════════════
# PART 1: DATABASE ABSTRACTIONS
# ═══════════════════════════════════════════════════════════════

# ———————————————————————————————————————————————————————————————
# Database Types
# ———————————————————————————————————————————————————————————————

trait Connection
  def execute(inout self: Self, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  def query(self: Self, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  def begin_transaction(inout self: Self) -> Result[Transaction, DbError]
  def prepare(inout self: Self, sql: str) -> Result[Statement, DbError]
  def close(inout self: Self) -> Result[Unit, DbError]
end

trait ToSqlParam
  def to_sql_param(self: Self) -> SqlValue
end

trait FromSqlValue
  def from_sql_value(value: SqlValue) -> Result[Self, DbError]
end

enum SqlValue
  Null
  Integer(i64)
  Float(f64)
  Text(String)
  Blob(Vec[u8])
  Bool(Bool)
  Timestamp(i64)
end

enum DbError
  ConnectionFailed(String)
  QueryFailed(String)
  BindError(UInt, String)
  TypeMismatch(String)
  TransactionError(String)
  NotFound
  ConstraintViolation(String)
  Timeout
  Closed
  Internal(String)
end

def db_error_message(e: DbError) -> String
  match e
  when DbError::ConnectionFailed(s) then "connection failed: " + s.clone()
  when DbError::QueryFailed(s) then "query failed: " + s.clone()
  when DbError::BindError(idx, s) then "bind error at " + idx.to_string() + ": " + s.clone()
  when DbError::TypeMismatch(s) then "type mismatch: " + s.clone()
  when DbError::TransactionError(s) then "transaction error: " + s.clone()
  when DbError::NotFound then "not found"
  when DbError::ConstraintViolation(s) then "constraint violation: " + s.clone()
  when DbError::Timeout then "connection timeout"
  when DbError::Closed then "connection closed"
  when DbError::Internal(s) then "internal error: " + s.clone()
  end
end

impl Error for DbError
  def message(self: DbError) -> String
    db_error_message(self)
  end
end

# ToSqlParam implementations
impl ToSqlParam for Int
  def to_sql_param(self: Int) -> SqlValue
    SqlValue::Integer(self as i64)
  end
end

impl ToSqlParam for i64
  def to_sql_param(self: i64) -> SqlValue
    SqlValue::Integer(self)
  end
end

impl ToSqlParam for f64
  def to_sql_param(self: f64) -> SqlValue
    SqlValue::Float(self)
  end
end

impl ToSqlParam for String
  def to_sql_param(self: String) -> SqlValue
    SqlValue::Text(self.clone())
  end
end

impl ToSqlParam for StrView
  def to_sql_param(self: StrView) -> SqlValue
    SqlValue::Text(String::from_str_view(self))
  end
end

impl ToSqlParam for Bool
  def to_sql_param(self: Bool) -> SqlValue
    SqlValue::Bool(self)
  end
end

impl ToSqlParam for Vec[u8]
  def to_sql_param(self: Vec[u8]) -> SqlValue
    SqlValue::Blob(self.clone())
  end
end

impl[T] ToSqlParam for Option[T] where T: ToSqlParam
  def to_sql_param(self: Option[T]) -> SqlValue
    match self
    when Option::Some(v) then v.to_sql_param()
    when Option::None then SqlValue::Null
    end
  end
end

# FromSqlValue implementations
impl FromSqlValue for Int
  def from_sql_value(value: SqlValue) -> Result[Int, DbError]
    match value
    when SqlValue::Integer(i) then Result::Ok(i as Int)
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to Int; use Option[Int]"))
    when _ then Result::Err(DbError::TypeMismatch("expected integer"))
    end
  end
end

impl FromSqlValue for i64
  def from_sql_value(value: SqlValue) -> Result[i64, DbError]
    match value
    when SqlValue::Integer(i) then Result::Ok(i)
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to i64; use Option[i64]"))
    when _ then Result::Err(DbError::TypeMismatch("expected integer"))
    end
  end
end

impl FromSqlValue for f64
  def from_sql_value(value: SqlValue) -> Result[f64, DbError]
    match value
    when SqlValue::Float(f) then Result::Ok(f)
    when SqlValue::Integer(i) then Result::Ok(i as f64)
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to f64; use Option[f64]"))
    when _ then Result::Err(DbError::TypeMismatch("expected float"))
    end
  end
end

impl FromSqlValue for String
  def from_sql_value(value: SqlValue) -> Result[String, DbError]
    match value
    when SqlValue::Text(s) then Result::Ok(s.clone())
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to String; use Option[String]"))
    when _ then Result::Err(DbError::TypeMismatch("expected text"))
    end
  end
end

impl FromSqlValue for Bool
  def from_sql_value(value: SqlValue) -> Result[Bool, DbError]
    match value
    when SqlValue::Bool(b) then Result::Ok(b)
    when SqlValue::Integer(i) then Result::Ok(i != 0)
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to Bool; use Option[Bool]"))
    when _ then Result::Err(DbError::TypeMismatch("expected bool"))
    end
  end
end

impl FromSqlValue for Vec[u8]
  def from_sql_value(value: SqlValue) -> Result[Vec[u8], DbError]
    match value
    when SqlValue::Blob(b) then Result::Ok(b.clone())
    when SqlValue::Null then Result::Err(DbError::TypeMismatch("NULL cannot be converted to Vec[u8]; use Option[Vec[u8]]"))
    when _ then Result::Err(DbError::TypeMismatch("expected blob"))
    end
  end
end

impl[T] FromSqlValue for Option[T] where T: FromSqlValue
  def from_sql_value(value: SqlValue) -> Result[Option[T], DbError]
    match value
    when SqlValue::Null then Result::Ok(Option::None)
    when _ then T::from_sql_value(value).map(Option::Some)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Rows and Row
# ———————————————————————————————————————————————————————————————

struct Rows
  columns: Vec[String]
  data: Vec[Vec[SqlValue]]
  pos: UInt
end

impl Rows
  def new(columns: Vec[String], data: Vec[Vec[SqlValue]]) -> Rows
    Rows { columns: columns, data: data, pos: 0 }
  end
  
  def column_count(self: Rows) -> UInt
    self.columns.len()
  end
  
  def column_names(self: Rows) -> Vec[String]
    var out = Vec::new()
    for col in self.columns do
      out.push(col.clone())
    end
    out
  end
  
  def row_count(self: Rows) -> UInt
    self.data.len()
  end
  
  def is_empty(self: Rows) -> Bool
    self.data.is_empty()
  end
end

impl Iterator for Rows
  type Item = Row
  
  def next(inout self: Rows) -> Option[Row]
    if self.pos < self.data.len() then
      var columns = Vec::new()
      for col in self.columns do
        columns.push(col.clone())
      end
      var values = Vec::new()
      var vi = 0
      while vi < self.data[self.pos].len() do
        values.push(self.data[self.pos][vi].clone())
        vi = vi + 1
      end
      let row = Row {
        columns: columns,
        values: values
      }
      self.pos = self.pos + 1
      Option::Some(row)
    else
      Option::None
    end
  end
end

struct Row
  columns: Vec[String]
  values: Vec[SqlValue]
end

impl Row
  def get[T](self: Row, index: UInt) -> Result[T, DbError] where T: FromSqlValue
    if index < self.values.len() then
      T::from_sql_value(&self.values[index])
    else
      Result::Err(DbError::TypeMismatch("column index " + index.to_string() + " out of bounds"))
    end
  end
  
  def get_by_name[T](self: Row, name: str) -> Result[T, DbError] where T: FromSqlValue
    for (i, col) in self.columns.iter().enumerate() do
      if col == name then
        return self.get(i)
      end
    end
    Result::Err(DbError::TypeMismatch("column '" + name.to_string() + "' not found"))
  end
  
  def get_value(self: Row, index: UInt) -> Option[SqlValue]
    if index < self.values.len() then
      Option::Some(self.values[index].clone())
    else
      Option::None
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Prepared Statement
# ———————————————————————————————————————————————————————————————

struct Statement
  sql: String
  handle: Ptr[Unit]
  driver: DriverKind
end

enum DriverKind
  Sqlite
  Postgres
  Mysql
end

impl Statement
  def execute(inout self: Statement, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    match self.driver
    when DriverKind::Sqlite then sqlite_stmt_execute(self, params)
    when DriverKind::Postgres then postgres_stmt_execute(self, params)
    when DriverKind::Mysql then mysql_stmt_run(self, params)
    end
  end
  
  def query(self: Statement, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    match self.driver
    when DriverKind::Sqlite then sqlite_stmt_query(self, params)
    when DriverKind::Postgres then postgres_stmt_query(self, params)
    when DriverKind::Mysql then mysql_stmt_query(self, params)
    end
  end
  
  def finalize(inout self: Statement) -> Result[Unit, DbError]
    match self.driver
    when DriverKind::Sqlite then sqlite_stmt_finalize(self)
    when DriverKind::Postgres then postgres_stmt_finalize(self)
    when DriverKind::Mysql then mysql_stmt_finalize(self)
    end
  end
end

impl Drop for Statement
  def drop(inout self: Statement) -> Unit
    if !self.handle.is_null() then
      match self.driver
      when DriverKind::Sqlite then
        let _ = unsafe "FFI boundary" do sqlite3_finalize(self.handle) end
      when DriverKind::Postgres then
        let _ = postgres_stmt_finalize(self)
      when DriverKind::Mysql then
        let _ = unsafe "FFI boundary" do mysql_stmt_close(self.handle) end
      end
      self.handle = null_ptr()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Transaction
# ———————————————————————————————————————————————————————————————

struct Transaction
  conn_handle: Ptr[Unit]
  driver: DriverKind
  
  finished: Bool
end

impl Transaction
  def execute(inout self: Transaction, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    if self.finished then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    
    match self.driver
    when DriverKind::Sqlite then sqlite_execute_raw(self.conn_handle, sql, params)
    when DriverKind::Postgres then postgres_execute_raw(self.conn_handle, sql, params)
    when DriverKind::Mysql then mysql_execute_raw(self.conn_handle, sql, params)
    end
  end
  
  def query(self: Transaction, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    if self.finished then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    
    match self.driver
    when DriverKind::Sqlite then sqlite_query_raw(self.conn_handle, sql, params)
    when DriverKind::Postgres then postgres_query_raw(self.conn_handle, sql, params)
    when DriverKind::Mysql then mysql_query_raw(self.conn_handle, sql, params)
    end
  end
  
  def commit(inout self: Transaction) -> Result[Unit, DbError]
    if self.finished then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    
    let result = match self.driver
    when DriverKind::Sqlite then sqlite_execute_raw(self.conn_handle, "COMMIT", &[])
    when DriverKind::Postgres then postgres_execute_raw(self.conn_handle, "COMMIT", &[])
    when DriverKind::Mysql then mysql_execute_raw(self.conn_handle, "COMMIT", &[])
    end
    
    match result
    when Result::Ok(_) then
      self.finished = true
      Result::Ok(())
    when Result::Err(e) then Result::Err(e)
    end
  end
  
  def rollback(inout self: Transaction) -> Result[Unit, DbError]
    if self.finished then
      return Result::Err(DbError::TransactionError("transaction already finished"))
    end
    
    let result = match self.driver
    when DriverKind::Sqlite then sqlite_execute_raw(self.conn_handle, "ROLLBACK", &[])
    when DriverKind::Postgres then postgres_execute_raw(self.conn_handle, "ROLLBACK", &[])
    when DriverKind::Mysql then mysql_execute_raw(self.conn_handle, "ROLLBACK", &[])
    end
    
    match result
    when Result::Ok(_) then
      self.finished = true
      Result::Ok(())
    when Result::Err(e) then Result::Err(e)
    end
  end
end

impl Drop for Transaction
  def drop(inout self: Transaction) -> Unit
    if !self.finished then
      # Auto-rollback on drop
      let _ = self.rollback()
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 2: SQLITE DRIVER
# ═══════════════════════════════════════════════════════════════

# FFI bindings for SQLite
extern "C"
  def sqlite3_open(filename: Ptr[u8], ppDb: PtrMut[Ptr[Unit]]) -> i32
  def sqlite3_close(db: Ptr[Unit]) -> i32
  def sqlite3_exec(db: Ptr[Unit], sql: Ptr[u8], callback: Ptr[Unit], arg: Ptr[Unit], errmsg: PtrMut[Ptr[u8]]) -> i32
  def sqlite3_prepare_v2(db: Ptr[Unit], sql: Ptr[u8], nByte: i32, ppStmt: PtrMut[Ptr[Unit]], pzTail: PtrMut[Ptr[u8]]) -> i32
  def sqlite3_bind_int64(stmt: Ptr[Unit], idx: i32, value: i64) -> i32
  def sqlite3_bind_double(stmt: Ptr[Unit], idx: i32, value: f64) -> i32
  def sqlite3_bind_text(stmt: Ptr[Unit], idx: i32, text: Ptr[u8], n: i32, destructor: Ptr[Unit]) -> i32
  def sqlite3_bind_blob(stmt: Ptr[Unit], idx: i32, blob: Ptr[u8], n: i32, destructor: Ptr[Unit]) -> i32
  def sqlite3_bind_null(stmt: Ptr[Unit], idx: i32) -> i32
  def sqlite3_step(stmt: Ptr[Unit]) -> i32
  def sqlite3_reset(stmt: Ptr[Unit]) -> i32
  def sqlite3_finalize(stmt: Ptr[Unit]) -> i32
  def sqlite3_column_count(stmt: Ptr[Unit]) -> i32
  def sqlite3_column_name(stmt: Ptr[Unit], idx: i32) -> Ptr[u8]
  def sqlite3_column_type(stmt: Ptr[Unit], idx: i32) -> i32
  def sqlite3_column_int64(stmt: Ptr[Unit], idx: i32) -> i64
  def sqlite3_column_double(stmt: Ptr[Unit], idx: i32) -> f64
  def sqlite3_column_text(stmt: Ptr[Unit], idx: i32) -> Ptr[u8]
  def sqlite3_column_bytes(stmt: Ptr[Unit], idx: i32) -> i32
  def sqlite3_column_blob(stmt: Ptr[Unit], idx: i32) -> Ptr[u8]
  def sqlite3_changes(db: Ptr[Unit]) -> i32
  def sqlite3_errmsg(db: Ptr[Unit]) -> Ptr[u8]
  def sqlite3_free(ptr: Ptr[Unit]) -> ()
end

const SQLITE_OK: i32 = 0
const SQLITE_BUSY: i32 = 5
const SQLITE_LOCKED: i32 = 6
const SQLITE_READONLY: i32 = 8
const SQLITE_IOERR: i32 = 10
const SQLITE_FULL: i32 = 13
const SQLITE_CONSTRAINT: i32 = 19
const SQLITE_ROW: i32 = 100
const SQLITE_DONE: i32 = 101
const SQLITE_INTEGER: i32 = 1
const SQLITE_FLOAT: i32 = 2
const SQLITE_TEXT: i32 = 3
const SQLITE_BLOB: i32 = 4
const SQLITE_NULL: i32 = 5

def sqlite_transient_destructor() -> Ptr[Unit]
  Ptr { address: (-1 as Int) as UInt }
end

struct Sqlite
  handle: Ptr[Unit]
end

impl Sqlite
  def open(path: str) -> Result[Sqlite, DbError]
    var handle: Ptr[Unit] = null_ptr()
    let path_cstr = path.to_cstring()
    
    let rc = unsafe "FFI boundary" do sqlite3_open(path_cstr.as_ptr(), &mut handle as PtrMut[Ptr[Unit]]) end
    
    if rc != SQLITE_OK then
      if handle.is_null() then
        return Result::Err(DbError::ConnectionFailed("sqlite3_open failed: out of memory"))
      end
      let err_msg = sqlite_errmsg(handle)
      unsafe "FFI boundary" do sqlite3_close(handle) end
      return Result::Err(DbError::ConnectionFailed(err_msg))
    end
    
    Result::Ok(Sqlite { handle: handle })
  end
  
  def open_memory() -> Result[Sqlite, DbError]
    Sqlite::open(":memory:")
  end
end

impl Connection for Sqlite
  def execute(inout self: Sqlite, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    sqlite_execute_raw(self.handle, sql, params)
  end
  
  def query(self: Sqlite, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    sqlite_query_raw(self.handle, sql, params)
  end
  
  def begin_transaction(inout self: Sqlite) -> Result[Transaction, DbError]
    sqlite_execute_raw(self.handle, "BEGIN TRANSACTION", &[])?
    Result::Ok(Transaction {
      conn_handle: self.handle,
      driver: DriverKind::Sqlite,
      finished: false
    })
  end
  
  def prepare(inout self: Sqlite, sql: str) -> Result[Statement, DbError]
    var stmt_handle: Ptr[Unit] = null_ptr()
    let sql_cstr = sql.to_cstring()
    
    let rc = unsafe "FFI boundary" do
      sqlite3_prepare_v2(
        self.handle,
        sql_cstr.as_ptr(),
        -1,
        &mut stmt_handle as PtrMut[Ptr[Unit]],
        null_ptr() as PtrMut[Ptr[u8]]
      )
    end
    
    if rc != SQLITE_OK then
      return Result::Err(sqlite_error_from_code(rc, sqlite_errmsg(self.handle)))
    end
    
    Result::Ok(Statement {
      sql: sql.to_string(),
      handle: stmt_handle,
      driver: DriverKind::Sqlite
    })
  end
  
  def close(inout self: Sqlite) -> Result[Unit, DbError]
    if self.handle.is_null() then
      return Result::Ok(())
    end
    let handle = self.handle
    let rc = unsafe "FFI boundary" do sqlite3_close(self.handle) end
    self.handle = null_ptr()
    if rc != SQLITE_OK then
      Result::Err(sqlite_error_from_code(rc, sqlite_errmsg(handle)))
    else
      Result::Ok(())
    end
  end
end

impl Drop for Sqlite
  def drop(inout self: Sqlite) -> Unit
    if !self.handle.is_null() then
      unsafe "FFI boundary" do sqlite3_close(self.handle) end
      self.handle = null_ptr()
    end
  end
end

# SQLite helper functions
def sqlite_errmsg(handle: Ptr[Unit]) -> String
  let msg_ptr = unsafe "FFI boundary" do sqlite3_errmsg(handle) end
  if msg_ptr.is_null() then
    "unknown error".to_string()
  else
    unsafe "FFI boundary" do String::from_cstr(msg_ptr) end
  end
end

def sqlite_error_from_code(code: i32, msg: String) -> DbError
  match code
  when SQLITE_BUSY then DbError::Timeout
  when SQLITE_LOCKED then DbError::Timeout
  when SQLITE_CONSTRAINT then DbError::ConstraintViolation(msg)
  when SQLITE_READONLY then DbError::QueryFailed("readonly database: " + msg)
  when SQLITE_FULL then DbError::QueryFailed("database full: " + msg)
  when SQLITE_IOERR then DbError::Internal("sqlite io error: " + msg)
  when _ then DbError::QueryFailed(msg)
  end
end

def sqlite_execute_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  var stmt_handle: Ptr[Unit] = null_ptr()
  let sql_cstr = sql.to_cstring()
  
  let rc = unsafe "FFI boundary" do
    sqlite3_prepare_v2(handle, sql_cstr.as_ptr(), -1, &mut stmt_handle as PtrMut[Ptr[Unit]], null_ptr() as PtrMut[Ptr[u8]])
  end
  
  if rc != SQLITE_OK then
    return Result::Err(sqlite_error_from_code(rc, sqlite_errmsg(handle)))
  end
  
  # Bind parameters
  for (i, param) in params.iter().enumerate() do
    let idx = (i + 1) as i32
    let value = param.to_sql_param()
    let bind_rc = match value
    when SqlValue::Null then unsafe "FFI boundary" do sqlite3_bind_null(stmt_handle, idx) end
    when SqlValue::Integer(v) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, v) end
    when SqlValue::Float(v) then unsafe "FFI boundary" do sqlite3_bind_double(stmt_handle, idx, v) end
    when SqlValue::Text(s) then
      let cstr = s.to_cstring()
      unsafe "FFI boundary" do sqlite3_bind_text(stmt_handle, idx, cstr.as_ptr(), -1, sqlite_transient_destructor()) end
    when SqlValue::Blob(b) then
      unsafe "FFI boundary" do sqlite3_bind_blob(stmt_handle, idx, b.as_ptr(), b.len() as i32, sqlite_transient_destructor()) end
    when SqlValue::Bool(b) then
      unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, if b then 1 else 0 end) end
    when SqlValue::Timestamp(t) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, t) end
    end
    
    if bind_rc != SQLITE_OK then
      unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
      return Result::Err(DbError::BindError(i, sqlite_errmsg(handle)))
    end
  end
  
  # Execute
  let step_rc = unsafe "FFI boundary" do sqlite3_step(stmt_handle) end
  unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
  
  if step_rc != SQLITE_DONE && step_rc != SQLITE_ROW then
    return Result::Err(sqlite_error_from_code(step_rc, sqlite_errmsg(handle)))
  end
  
  let changes = unsafe "FFI boundary" do sqlite3_changes(handle) end
  Result::Ok(changes as UInt)
end

def sqlite_query_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  var stmt_handle: Ptr[Unit] = null_ptr()
  let sql_cstr = sql.to_cstring()
  
  let rc = unsafe "FFI boundary" do
    sqlite3_prepare_v2(handle, sql_cstr.as_ptr(), -1, &mut stmt_handle as PtrMut[Ptr[Unit]], null_ptr() as PtrMut[Ptr[u8]])
  end
  
  if rc != SQLITE_OK then
    return Result::Err(sqlite_error_from_code(rc, sqlite_errmsg(handle)))
  end
  
  # Bind parameters
  for (i, param) in params.iter().enumerate() do
    let idx = (i + 1) as i32
    let value = param.to_sql_param()
    let bind_rc = match value
    when SqlValue::Null then unsafe "FFI boundary" do sqlite3_bind_null(stmt_handle, idx) end
    when SqlValue::Integer(v) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, v) end
    when SqlValue::Float(v) then unsafe "FFI boundary" do sqlite3_bind_double(stmt_handle, idx, v) end
    when SqlValue::Text(s) then
      let cstr = s.to_cstring()
      unsafe "FFI boundary" do sqlite3_bind_text(stmt_handle, idx, cstr.as_ptr(), -1, sqlite_transient_destructor()) end
    when SqlValue::Blob(b) then
      unsafe "FFI boundary" do sqlite3_bind_blob(stmt_handle, idx, b.as_ptr(), b.len() as i32, sqlite_transient_destructor()) end
    when SqlValue::Bool(b) then
      unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, if b then 1 else 0 end) end
    when SqlValue::Timestamp(t) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt_handle, idx, t) end
    end
    
    if bind_rc != SQLITE_OK then
      unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
      return Result::Err(DbError::BindError(i, sqlite_errmsg(handle)))
    end
  end
  
  # Get column names
  let col_count = unsafe "FFI boundary" do sqlite3_column_count(stmt_handle)  end as UInt
  var columns = Vec::new()
  for i in 0..col_count do
    let name_ptr = unsafe "FFI boundary" do sqlite3_column_name(stmt_handle, i as i32) end
    let name = if name_ptr.is_null() then
      "column_" + i.to_string()
    else
      unsafe "FFI boundary" do String::from_cstr(name_ptr) end
    end
    columns.push(name)
  end
  
  # Fetch rows
  var data = Vec::new()
  loop
    let step_rc = unsafe "FFI boundary" do sqlite3_step(stmt_handle) end
    
    if step_rc == SQLITE_ROW then
      var row_values = Vec::new()
      for i in 0..col_count do
        let col_type = unsafe "FFI boundary" do sqlite3_column_type(stmt_handle, i as i32) end
        let value = match col_type
        when SQLITE_INTEGER then
          SqlValue::Integer(unsafe "FFI boundary" do sqlite3_column_int64(stmt_handle, i as i32)  end)
        when SQLITE_FLOAT then
          SqlValue::Float(unsafe "FFI boundary" do sqlite3_column_double(stmt_handle, i as i32)  end)
        when SQLITE_TEXT then
          let text_ptr = unsafe "FFI boundary" do sqlite3_column_text(stmt_handle, i as i32) end
          let s = if text_ptr.is_null() then String::new() else unsafe "FFI boundary" do String::from_cstr(text_ptr as Ptr[u8])  end end
          SqlValue::Text(s)
        when SQLITE_BLOB then
          let blob_ptr = unsafe "FFI boundary" do sqlite3_column_blob(stmt_handle, i as i32) end
          let blob_len = unsafe "FFI boundary" do sqlite3_column_bytes(stmt_handle, i as i32)  end as UInt
          var blob = Vec::with_capacity(blob_len)
          if !blob_ptr.is_null() then
            for j in 0..blob_len do
              blob.push(unsafe "FFI boundary" do *(blob_ptr.offset(j as isize))  end)
            end
          end
          SqlValue::Blob(blob)
        when SQLITE_NULL | _ then SqlValue::Null
        end
        row_values.push(value)
      end
      data.push(row_values)
    elsif step_rc == SQLITE_DONE then
      break
    else
      unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
      return Result::Err(sqlite_error_from_code(step_rc, sqlite_errmsg(handle)))
    end
  end
  
  unsafe "FFI boundary" do sqlite3_finalize(stmt_handle) end
  Result::Ok(Rows::new(columns, data))
end

def sqlite_stmt_execute(inout stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  if stmt.handle.is_null() then
    return Result::Err(DbError::QueryFailed("statement already finalized"))
  end
  let reset_rc = unsafe "FFI boundary" do sqlite3_reset(stmt.handle) end
  if reset_rc != SQLITE_OK then
    return Result::Err(sqlite_error_from_code(reset_rc, "statement reset failed".to_string()))
  end
  
  for (i, param) in params.iter().enumerate() do
    let idx = (i + 1) as i32
    let value = param.to_sql_param()
    let bind_rc = match value
    when SqlValue::Null then unsafe "FFI boundary" do sqlite3_bind_null(stmt.handle, idx) end
    when SqlValue::Integer(v) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, v) end
    when SqlValue::Float(v) then unsafe "FFI boundary" do sqlite3_bind_double(stmt.handle, idx, v) end
    when SqlValue::Text(s) then
      let cstr = s.to_cstring()
      unsafe "FFI boundary" do sqlite3_bind_text(stmt.handle, idx, cstr.as_ptr(), -1, sqlite_transient_destructor()) end
    when SqlValue::Blob(b) then
      unsafe "FFI boundary" do sqlite3_bind_blob(stmt.handle, idx, b.as_ptr(), b.len() as i32, sqlite_transient_destructor()) end
    when SqlValue::Bool(b) then
      unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, if b then 1 else 0 end) end
    when SqlValue::Timestamp(t) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, t) end
    end
    
    if bind_rc != SQLITE_OK then
      return Result::Err(sqlite_error_from_code(bind_rc, "bind parameter " + i.to_string() + " failed"))
    end
  end
  
  let step_rc = unsafe "FFI boundary" do sqlite3_step(stmt.handle) end
  if step_rc != SQLITE_DONE && step_rc != SQLITE_ROW then
    return Result::Err(sqlite_error_from_code(step_rc, "statement execution failed".to_string()))
  end
  
  Result::Ok(0)  # SQLite doesn't expose changes from statement
end

def sqlite_stmt_query(stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  if stmt.handle.is_null() then
    return Result::Err(DbError::QueryFailed("statement already finalized"))
  end
  # Similar to sqlite_query_raw but uses existing statement handle
  let reset_rc = unsafe "FFI boundary" do sqlite3_reset(stmt.handle) end
  if reset_rc != SQLITE_OK then
    return Result::Err(sqlite_error_from_code(reset_rc, "statement reset failed".to_string()))
  end
  
  for (i, param) in params.iter().enumerate() do
    let idx = (i + 1) as i32
    let value = param.to_sql_param()
    let bind_rc = match value
    when SqlValue::Null then unsafe "FFI boundary" do sqlite3_bind_null(stmt.handle, idx) end
    when SqlValue::Integer(v) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, v) end
    when SqlValue::Float(v) then unsafe "FFI boundary" do sqlite3_bind_double(stmt.handle, idx, v) end
    when SqlValue::Text(s) then
      let cstr = s.to_cstring()
      unsafe "FFI boundary" do sqlite3_bind_text(stmt.handle, idx, cstr.as_ptr(), -1, sqlite_transient_destructor()) end
    when SqlValue::Blob(b) then
      unsafe "FFI boundary" do sqlite3_bind_blob(stmt.handle, idx, b.as_ptr(), b.len() as i32, sqlite_transient_destructor()) end
    when SqlValue::Bool(b) then
      unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, if b then 1 else 0 end) end
    when SqlValue::Timestamp(t) then unsafe "FFI boundary" do sqlite3_bind_int64(stmt.handle, idx, t) end
    end
    
    if bind_rc != SQLITE_OK then
      return Result::Err(sqlite_error_from_code(bind_rc, "bind parameter " + i.to_string() + " failed"))
    end
  end
  
  let col_count = unsafe "FFI boundary" do sqlite3_column_count(stmt.handle)  end as UInt
  var columns = Vec::new()
  for i in 0..col_count do
    let name_ptr = unsafe "FFI boundary" do sqlite3_column_name(stmt.handle, i as i32) end
    let name = if name_ptr.is_null() then "column_" + i.to_string() else unsafe "FFI boundary" do String::from_cstr(name_ptr)  end end
    columns.push(name)
  end
  
  var data = Vec::new()
  loop
    let step_rc = unsafe "FFI boundary" do sqlite3_step(stmt.handle) end
    
    if step_rc == SQLITE_ROW then
      var row_values = Vec::new()
      for i in 0..col_count do
        let col_type = unsafe "FFI boundary" do sqlite3_column_type(stmt.handle, i as i32) end
        let value = match col_type
        when SQLITE_INTEGER then SqlValue::Integer(unsafe "FFI boundary" do sqlite3_column_int64(stmt.handle, i as i32)  end)
        when SQLITE_FLOAT then SqlValue::Float(unsafe "FFI boundary" do sqlite3_column_double(stmt.handle, i as i32)  end)
        when SQLITE_TEXT then
          let text_ptr = unsafe "FFI boundary" do sqlite3_column_text(stmt.handle, i as i32) end
          SqlValue::Text(if text_ptr.is_null() then
            String::new()
          else
            unsafe "FFI boundary" do String::from_cstr(text_ptr as Ptr[u8]) end
          end)
        when SQLITE_BLOB then
          let blob_ptr = unsafe "FFI boundary" do sqlite3_column_blob(stmt.handle, i as i32) end
          let blob_len = unsafe "FFI boundary" do sqlite3_column_bytes(stmt.handle, i as i32)  end as UInt
          var blob = Vec::with_capacity(blob_len)
          if !blob_ptr.is_null() then
            for j in 0..blob_len do
              blob.push(unsafe "FFI boundary" do *(blob_ptr.offset(j as isize))  end)
            end
          end
          SqlValue::Blob(blob)
        when _ then SqlValue::Null
        end
        row_values.push(value)
      end
      data.push(row_values)
    elsif step_rc == SQLITE_DONE then
      break
    else
      return Result::Err(sqlite_error_from_code(step_rc, "statement query failed".to_string()))
    end
  end
  
  Result::Ok(Rows::new(columns, data))
end

def sqlite_stmt_finalize(inout stmt: Statement) -> Result[Unit, DbError]
  let rc = unsafe "FFI boundary" do sqlite3_finalize(stmt.handle) end
  if rc != SQLITE_OK then
    return Result::Err(sqlite_error_from_code(rc, "statement finalize failed".to_string()))
  end
  stmt.handle = null_ptr()
  Result::Ok(())
end

# ═══════════════════════════════════════════════════════════════
# PART 3: POSTGRESQL DRIVER
# ═══════════════════════════════════════════════════════════════

# FFI bindings for libpq
extern "C"
  def PQconnectdb(conninfo: Ptr[u8]) -> Ptr[Unit]
  def PQstatus(conn: Ptr[Unit]) -> i32
  def PQfinish(conn: Ptr[Unit]) -> ()
  def PQerrorMessage(conn: Ptr[Unit]) -> Ptr[u8]
  def PQexec(conn: Ptr[Unit], query: Ptr[u8]) -> Ptr[Unit]
  def PQexecParams(conn: Ptr[Unit], command: Ptr[u8], nParams: i32,
                   paramTypes: Ptr[u32], paramValues: Ptr[Ptr[u8]],
                   paramLengths: Ptr[i32], paramFormats: Ptr[i32],
                   resultFormat: i32) -> Ptr[Unit]
  def PQprepare(conn: Ptr[Unit], stmtName: Ptr[u8], query: Ptr[u8],
                nParams: i32, paramTypes: Ptr[u32]) -> Ptr[Unit]
  def PQexecPrepared(conn: Ptr[Unit], stmtName: Ptr[u8], nParams: i32,
                     paramValues: Ptr[Ptr[u8]], paramLengths: Ptr[i32],
                     paramFormats: Ptr[i32], resultFormat: i32) -> Ptr[Unit]
  def PQresultStatus(res: Ptr[Unit]) -> i32
  def PQresultErrorMessage(res: Ptr[Unit]) -> Ptr[u8]
  def PQclear(res: Ptr[Unit]) -> ()
  def PQntuples(res: Ptr[Unit]) -> i32
  def PQnfields(res: Ptr[Unit]) -> i32
  def PQfname(res: Ptr[Unit], field_num: i32) -> Ptr[u8]
  def PQftype(res: Ptr[Unit], field_num: i32) -> u32
  def PQgetvalue(res: Ptr[Unit], row_number: i32, field_number: i32) -> Ptr[u8]
  def PQgetisnull(res: Ptr[Unit], row_number: i32, field_number: i32) -> i32
  def PQgetlength(res: Ptr[Unit], row_number: i32, field_number: i32) -> i32
  def PQcmdTuples(res: Ptr[Unit]) -> Ptr[u8]
end

const PGRES_COMMAND_OK: i32 = 1
const PGRES_TUPLES_OK: i32 = 2
const CONNECTION_OK: i32 = 0

# PostgreSQL type OIDs
const PG_BOOL_OID: u32 = 16
const PG_INT2_OID: u32 = 21
const PG_INT4_OID: u32 = 23
const PG_INT8_OID: u32 = 20
const PG_FLOAT4_OID: u32 = 700
const PG_FLOAT8_OID: u32 = 701
const PG_TEXT_OID: u32 = 25
const PG_VARCHAR_OID: u32 = 1043
const PG_BYTEA_OID: u32 = 17
const PG_TIMESTAMP_OID: u32 = 1114
const PG_TIMESTAMPTZ_OID: u32 = 1184

struct Postgres
  handle: Ptr[Unit]
  stmt_counter: UInt
end

struct PostgresConfig
  host: String
  port: u16
  user: String
  password: String
  database: String
  ssl_mode: String
end

impl PostgresConfig
  def new() -> PostgresConfig
    PostgresConfig {
      host: "localhost".to_string(),
      port: 5432,
      user: "postgres".to_string(),
      password: String::new(),
      database: "postgres".to_string(),
      ssl_mode: "prefer".to_string()
    end
  end
  
  def host(sink self: PostgresConfig, h: str) -> PostgresConfig
    self.host = h.to_string()
    self
  end
  
  def port(sink self: PostgresConfig, p: u16) -> PostgresConfig
    self.port = p
    self
  end
  
  def user(sink self: PostgresConfig, u: str) -> PostgresConfig
    self.user = u.to_string()
    self
  end
  
  def password(sink self: PostgresConfig, p: str) -> PostgresConfig
    self.password = p.to_string()
    self
  end
  
  def database(sink self: PostgresConfig, d: str) -> PostgresConfig
    self.database = d.to_string()
    self
  end
  
  def ssl_mode(sink self: PostgresConfig, m: str) -> PostgresConfig
    self.ssl_mode = m.to_string()
    self
  end
  
  def to_connection_string(self: PostgresConfig) -> String
    var parts = Vec::new()
    parts.push("host=" + self.host)
    parts.push("port=" + self.port.to_string())
    parts.push("user=" + self.user)
    if !self.password.is_empty() then
      parts.push("password=" + self.password)
    end
    parts.push("dbname=" + self.database)
    parts.push("sslmode=" + self.ssl_mode)
    parts.join(" ")
  end
  
  def connect(self: PostgresConfig) -> Result[Postgres, DbError]
    Postgres::connect(self.to_connection_string().as_str())
  end
end

impl Postgres
  def connect(conninfo: str) -> Result[Postgres, DbError]
    let conninfo_cstr = conninfo.to_cstring()
    let handle = unsafe "FFI boundary" do PQconnectdb(conninfo_cstr.as_ptr()) end
    
    if handle.is_null() then
      return Result::Err(DbError::ConnectionFailed("failed to allocate connection"))
    end
    
    let status = unsafe "FFI boundary" do PQstatus(handle) end
    if status != CONNECTION_OK then
      let err_msg = postgres_errmsg(handle)
      unsafe "FFI boundary" do PQfinish(handle) end
      return Result::Err(DbError::ConnectionFailed(err_msg))
    end
    
    Result::Ok(Postgres { handle: handle, stmt_counter: 0 })
  end
end

impl Connection for Postgres
  def execute(inout self: Postgres, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    postgres_execute_raw(self.handle, sql, params)
  end
  
  def query(self: Postgres, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    postgres_query_raw(self.handle, sql, params)
  end
  
  def begin_transaction(inout self: Postgres) -> Result[Transaction, DbError]
    postgres_execute_raw(self.handle, "BEGIN", &[])?
    Result::Ok(Transaction {
      conn_handle: self.handle,
      driver: DriverKind::Postgres,
      finished: false
    })
  end
  
  def prepare(inout self: Postgres, sql: str) -> Result[Statement, DbError]
    self.stmt_counter = self.stmt_counter + 1
    let stmt_name = "stmt_" + self.stmt_counter.to_string()
    let stmt_name_cstr = stmt_name.to_cstring()
    let sql_cstr = sql.to_cstring()
    
    let result = unsafe "FFI boundary" do
      PQprepare(self.handle, stmt_name_cstr.as_ptr(), sql_cstr.as_ptr(), 0, null_ptr())
    end
    
    if result.is_null() then
      return Result::Err(DbError::QueryFailed("failed to prepare statement"))
    end
    
    let status = unsafe "FFI boundary" do PQresultStatus(result) end
    if status != PGRES_COMMAND_OK then
      let err_msg = postgres_result_errmsg(result)
      unsafe "FFI boundary" do PQclear(result) end
      return Result::Err(DbError::QueryFailed(err_msg))
    end
    
    unsafe "FFI boundary" do PQclear(result) end
    
    # Store statement name in handle pointer (as string pointer for lookup)
    let name_ptr = stmt_name.into_raw() as Ptr[Unit]
    
    Result::Ok(Statement {
      sql: sql.to_string(),
      handle: name_ptr,
      driver: DriverKind::Postgres
    })
  end
  
  def close(inout self: Postgres) -> Result[Unit, DbError]
    unsafe "FFI boundary" do PQfinish(self.handle) end
    self.handle = null_ptr()
    Result::Ok(())
  end
end

impl Drop for Postgres
  def drop(inout self: Postgres) -> Unit
    if !self.handle.is_null() then
      unsafe "FFI boundary" do PQfinish(self.handle) end
    end
  end
end

# PostgreSQL helper functions
def postgres_errmsg(handle: Ptr[Unit]) -> String
  let msg_ptr = unsafe "FFI boundary" do PQerrorMessage(handle) end
  if msg_ptr.is_null() then
    "unknown error".to_string()
  else
    unsafe "FFI boundary" do String::from_cstr(msg_ptr) end
  end
end

def postgres_result_errmsg(result: Ptr[Unit]) -> String
  let msg_ptr = unsafe "FFI boundary" do PQresultErrorMessage(result) end
  if msg_ptr.is_null() then
    "unknown error".to_string()
  else
    unsafe "FFI boundary" do String::from_cstr(msg_ptr) end
  end
end

def postgres_execute_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  if params.is_empty() then
    let sql_cstr = sql.to_cstring()
    let result = unsafe "FFI boundary" do PQexec(handle, sql_cstr.as_ptr()) end
    
    if result.is_null() then
      return Result::Err(DbError::QueryFailed(postgres_errmsg(handle)))
    end
    
    let status = unsafe "FFI boundary" do PQresultStatus(result) end
    if status != PGRES_COMMAND_OK && status != PGRES_TUPLES_OK then
      let err_msg = postgres_result_errmsg(result)
      unsafe "FFI boundary" do PQclear(result) end
      return Result::Err(DbError::QueryFailed(err_msg))
    end
    
    let cmd_ptr = unsafe "FFI boundary" do PQcmdTuples(result) end
    let affected_str = if cmd_ptr.is_null() then "0" else unsafe "FFI boundary" do String::from_cstr(cmd_ptr) end end
    let affected = affected_str.parse_uint().unwrap_or(0)
    unsafe "FFI boundary" do PQclear(result) end
    return Result::Ok(affected)
  end
  
  # Convert parameters to C strings
  var param_values: Vec[Vec[u8]] = Vec::new()
  var param_ptrs: Vec[Ptr[u8]] = Vec::new()
  var param_lengths: Vec[i32] = Vec::new()
  var param_formats: Vec[i32] = Vec::new()
  
  for param in params do
    let value = param.to_sql_param()
    match value
    when SqlValue::Null then
      param_ptrs.push(null_ptr())
      param_lengths.push(0)
      param_formats.push(0)
    when SqlValue::Integer(i) then
      let s = i.to_string().to_cstring_bytes()
      param_ptrs.push(s.as_ptr())
      param_lengths.push(s.len() as i32)
      param_formats.push(0)
      param_values.push(s)
    when SqlValue::Float(f) then
      let s = f.to_string().to_cstring_bytes()
      param_ptrs.push(s.as_ptr())
      param_lengths.push(s.len() as i32)
      param_formats.push(0)
      param_values.push(s)
    when SqlValue::Text(t) then
      let s = t.to_cstring_bytes()
      param_ptrs.push(s.as_ptr())
      param_lengths.push(s.len() as i32)
      param_formats.push(0)
      param_values.push(s)
    when SqlValue::Bool(b) then
      let s = (if b then "t" else "f" end).to_cstring_bytes()
      param_ptrs.push(s.as_ptr())
      param_lengths.push(s.len() as i32)
      param_formats.push(0)
      param_values.push(s)
    when SqlValue::Blob(blob) then
      param_ptrs.push(blob.as_ptr())
      param_lengths.push(blob.len() as i32)
      param_formats.push(1)  # binary format
    when SqlValue::Timestamp(t) then
      let s = t.to_string().to_cstring_bytes()
      param_ptrs.push(s.as_ptr())
      param_lengths.push(s.len() as i32)
      param_formats.push(0)
      param_values.push(s)
    end
  end
  
  let sql_cstr = sql.to_cstring()
  let result = unsafe "FFI boundary" do
    PQexecParams(
      handle,
      sql_cstr.as_ptr(),
      params.len() as i32,
      null_ptr(),
      param_ptrs.as_ptr(),
      param_lengths.as_ptr(),
      param_formats.as_ptr(),
      0
    )
  end
  
  if result.is_null() then
    return Result::Err(DbError::QueryFailed(postgres_errmsg(handle)))
  end
  
  let status = unsafe "FFI boundary" do PQresultStatus(result) end
  if status != PGRES_COMMAND_OK && status != PGRES_TUPLES_OK then
    let err_msg = postgres_result_errmsg(result)
    unsafe "FFI boundary" do PQclear(result) end
    return Result::Err(DbError::QueryFailed(err_msg))
  end
  
  let cmd_ptr2 = unsafe "FFI boundary" do PQcmdTuples(result) end
  let affected_str = if cmd_ptr2.is_null() then "0" else unsafe "FFI boundary" do String::from_cstr(cmd_ptr2) end end
  let affected = affected_str.parse_uint().unwrap_or(0)
  unsafe "FFI boundary" do PQclear(result) end
  Result::Ok(affected)
end

def postgres_query_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  let result = if params.is_empty() then
    let sql_cstr = sql.to_cstring()
    unsafe "FFI boundary" do PQexec(handle, sql_cstr.as_ptr()) end
  else
    # Convert parameters
    var param_values: Vec[Vec[u8]] = Vec::new()
    var param_ptrs: Vec[Ptr[u8]] = Vec::new()
    var param_lengths: Vec[i32] = Vec::new()
    var param_formats: Vec[i32] = Vec::new()
    
    for param in params do
      let value = param.to_sql_param()
      match value
      when SqlValue::Null then
        param_ptrs.push(null_ptr())
        param_lengths.push(0)
        param_formats.push(0)
      when SqlValue::Integer(i) then
        let s = i.to_string().to_cstring_bytes()
        param_ptrs.push(s.as_ptr())
        param_lengths.push(s.len() as i32)
        param_formats.push(0)
        param_values.push(s)
      when SqlValue::Float(f) then
        let s = f.to_string().to_cstring_bytes()
        param_ptrs.push(s.as_ptr())
        param_lengths.push(s.len() as i32)
        param_formats.push(0)
        param_values.push(s)
      when SqlValue::Text(t) then
        let s = t.to_cstring_bytes()
        param_ptrs.push(s.as_ptr())
        param_lengths.push(s.len() as i32)
        param_formats.push(0)
        param_values.push(s)
      when SqlValue::Bool(b) then
        let s = (if b then "t" else "f" end).to_cstring_bytes()
        param_ptrs.push(s.as_ptr())
        param_lengths.push(s.len() as i32)
        param_formats.push(0)
        param_values.push(s)
      when SqlValue::Blob(blob) then
        param_ptrs.push(blob.as_ptr())
        param_lengths.push(blob.len() as i32)
        param_formats.push(1)
      when SqlValue::Timestamp(t) then
        let s = t.to_string().to_cstring_bytes()
        param_ptrs.push(s.as_ptr())
        param_lengths.push(s.len() as i32)
        param_formats.push(0)
        param_values.push(s)
      end
    end
    
    let sql_cstr = sql.to_cstring()
    unsafe "FFI boundary" do
      PQexecParams(
        handle,
        sql_cstr.as_ptr(),
        params.len() as i32,
        null_ptr(),
        param_ptrs.as_ptr(),
        param_lengths.as_ptr(),
        param_formats.as_ptr(),
        0
      )
    end
  end
  
  if result.is_null() then
    return Result::Err(DbError::QueryFailed(postgres_errmsg(handle)))
  end
  
  let status = unsafe "FFI boundary" do PQresultStatus(result) end
  if status != PGRES_TUPLES_OK then
    let err_msg = postgres_result_errmsg(result)
    unsafe "FFI boundary" do PQclear(result) end
    return Result::Err(DbError::QueryFailed(err_msg))
  end
  
  # Get column info
  let num_fields = unsafe "FFI boundary" do PQnfields(result)  end as UInt
  var columns = Vec::new()
  var col_types = Vec::new()
  
  for i in 0..num_fields do
    let name_ptr = unsafe "FFI boundary" do PQfname(result, i as i32) end
    let name = if name_ptr.is_null() then "column_" + i.to_string() else unsafe "FFI boundary" do String::from_cstr(name_ptr)  end end
    columns.push(name)
    col_types.push(unsafe "FFI boundary" do PQftype(result, i as i32)  end)
  end
  
  # Get rows
  let num_rows = unsafe "FFI boundary" do PQntuples(result)  end as UInt
  var data = Vec::new()
  
  for row_idx in 0..num_rows do
    var row_values = Vec::new()
    for col_idx in 0..num_fields do
      let value = if unsafe "FFI boundary" do PQgetisnull(result, row_idx as i32, col_idx as i32)  end != 0 then
        SqlValue::Null
      else
        let val_ptr = unsafe "FFI boundary" do PQgetvalue(result, row_idx as i32, col_idx as i32) end
        let val_len = unsafe "FFI boundary" do PQgetlength(result, row_idx as i32, col_idx as i32)  end as UInt
        let col_type = col_types[col_idx]
        
        if val_ptr.is_null() then
          SqlValue::Null
        else
          let val_str = unsafe "FFI boundary" do String::from_cstr(val_ptr) end
          
          match col_type
          when PG_BOOL_OID then
            SqlValue::Bool(val_str == "t" || val_str == "true" || val_str == "1")
          when PG_INT2_OID | PG_INT4_OID | PG_INT8_OID then
            SqlValue::Integer(val_str.parse_i64().unwrap_or(0))
          when PG_FLOAT4_OID | PG_FLOAT8_OID then
            SqlValue::Float(val_str.parse_f64().unwrap_or(0.0))
          when PG_BYTEA_OID then
            SqlValue::Blob(decode_bytea(&val_str))
          when PG_TIMESTAMP_OID | PG_TIMESTAMPTZ_OID then
            SqlValue::Timestamp(parse_pg_timestamp(&val_str))
          when _ then SqlValue::Text(val_str)
          end
        end
      end
      row_values.push(value)
    end
    data.push(row_values)
  end
  
  unsafe "FFI boundary" do PQclear(result) end
  Result::Ok(Rows::new(columns, data))
end

# Decode PostgreSQL bytea hex format
def decode_bytea(s: str) -> Vec[u8]
  var result = Vec::new()
  let chars: Vec[char] = s.chars().collect()
  
  if chars.len() >= 2 && chars[0] == '\\' && chars[1] == 'x' then
    # Hex format: \xDEADBEEF
    var i = 2
    while i + 1 < chars.len() do
      let high = hex_char_to_byte(chars[i])
      let low = hex_char_to_byte(chars[i + 1])
      result.push((high << 4) | low)
      i = i + 2
    end
  else
    # Escape format
    var i = 0
    while i < chars.len() do
      if chars[i] == '\\' && i + 1 < chars.len() then
        if chars[i + 1] == '\\' then
          result.push('\\' as u8)
          i = i + 2
        elsif i + 3 < chars.len() && chars[i + 1].is_digit() then
          # Octal escape \NNN
          let oct = ((chars[i + 1] as u8 - '0' as u8) * 64) +
                    ((chars[i + 2] as u8 - '0' as u8) * 8) +
                    (chars[i + 3] as u8 - '0' as u8)
          result.push(oct)
          i = i + 4
        else
          result.push(chars[i] as u8)
          i = i + 1
        end
      else
        result.push(chars[i] as u8)
        i = i + 1
      end
    end
  end
  
  result
end

def hex_char_to_byte(c: char) -> u8
  if c >= '0' && c <= '9' then
    c as u8 - '0' as u8
  elsif c >= 'a' && c <= 'f' then
    c as u8 - 'a' as u8 + 10
  elsif c >= 'A' && c <= 'F' then
    c as u8 - 'A' as u8 + 10
  else
    0
  end
end

def parse_pg_timestamp(s: str) -> i64
  # Parse "YYYY-MM-DD HH:MM:SS" into a unix timestamp (UTC seconds).
  # The day number uses the proleptic-Gregorian days-from-civil formula;
  # timezone and microseconds are not part of the textual format.
  let parts = s.split(" ")
  if parts.len() != 2 then
    return 0
  end
  let date_parts = parts[0].split("-")
  let time_parts = parts[1].split(":")
  if date_parts.len() != 3 || time_parts.len() != 3 then
    return 0
  end

  let year = match date_parts[0].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let month = match date_parts[1].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let day = match date_parts[2].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let hour = match time_parts[0].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let minute = match time_parts[1].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end
  let second = match time_parts[2].parse_int()
  when Result::Ok(v) then v
  when Result::Err(_) then return 0
  end

  if month < 1 || month > 12 || day < 1 || day > 31 || hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 60 then
    return 0
  end

  let mut y = year
  if month <= 2 then
    y = y - 1
  end
  let era = (if y >= 0 then y else y - 399 end) / 400
  let yoe = y - era * 400
  let m_adj = if month > 2 then month - 3 else month + 9 end
  let doy = (153 * m_adj + 2) / 5 + day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  let days = era * 146097 + doe - 719468
  (days as i64) * 86400 + (hour as i64) * 3600 + (minute as i64) * 60 + (second as i64)
end

def postgres_stmt_execute(inout stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  # Would need to store connection handle with statement
  Result::Err(DbError::Internal("prepared statement execution requires connection context"))
end

def postgres_stmt_query(stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  Result::Err(DbError::Internal("prepared statement query requires connection context"))
end

def postgres_stmt_finalize(inout stmt: Statement) -> Result[Unit, DbError]
  # Free statement name string
  if !stmt.handle.is_null() then
    let _ = unsafe "FFI boundary" do String::from_raw(stmt.handle as Ptr[u8]) end
    stmt.handle = null_ptr()
  end
  Result::Ok(())
end

# ═══════════════════════════════════════════════════════════════
# PART 4: QUERY BUILDER
# ═══════════════════════════════════════════════════════════════

struct QueryBuilder
  parts: Vec[String]
  params: Vec[SqlValue]
  param_placeholder: fn(UInt) -> String
end

impl QueryBuilder
  def new() -> QueryBuilder
    QueryBuilder {
      parts: Vec::new(),
      params: Vec::new(),
      param_placeholder: |i| "?".to_string()  # SQLite style
    end
  end
  
  def new_postgres() -> QueryBuilder
    QueryBuilder {
      parts: Vec::new(),
      params: Vec::new(),
      param_placeholder: |i| "$" + (i + 1).to_string()  # PostgreSQL style
    end
  end
  
  def select(sink self: QueryBuilder, columns: str) -> QueryBuilder
    self.parts.push("SELECT ".to_string() + columns)
    self
  end
  
  def from(sink self: QueryBuilder, table: str) -> QueryBuilder
    self.parts.push("FROM ".to_string() + table)
    self
  end
  
  def where_clause(sink self: QueryBuilder, condition: str) -> QueryBuilder
    self.parts.push("WHERE ".to_string() + condition)
    self
  end
  
  def and_where(sink self: QueryBuilder, condition: str) -> QueryBuilder
    self.parts.push("AND ".to_string() + condition)
    self
  end
  
  def or_where(sink self: QueryBuilder, condition: str) -> QueryBuilder
    self.parts.push("OR ".to_string() + condition)
    self
  end
  
  def join(sink self: QueryBuilder, table: str, on: str) -> QueryBuilder
    self.parts.push("JOIN ".to_string() + table + " ON " + on)
    self
  end
  
  def left_join(sink self: QueryBuilder, table: str, on: str) -> QueryBuilder
    self.parts.push("LEFT JOIN ".to_string() + table + " ON " + on)
    self
  end
  
  def order_by(sink self: QueryBuilder, columns: str) -> QueryBuilder
    self.parts.push("ORDER BY ".to_string() + columns)
    self
  end
  
  def limit(sink self: QueryBuilder, n: UInt) -> QueryBuilder
    self.parts.push("LIMIT ".to_string() + n.to_string())
    self
  end
  
  def offset(sink self: QueryBuilder, n: UInt) -> QueryBuilder
    self.parts.push("OFFSET ".to_string() + n.to_string())
    self
  end
  
  def group_by(sink self: QueryBuilder, columns: str) -> QueryBuilder
    self.parts.push("GROUP BY ".to_string() + columns)
    self
  end
  
  def having(sink self: QueryBuilder, condition: str) -> QueryBuilder
    self.parts.push("HAVING ".to_string() + condition)
    self
  end
  
  def insert_into(sink self: QueryBuilder, table: str, columns: str) -> QueryBuilder
    self.parts.push("INSERT INTO ".to_string() + table + " (" + columns + ")")
    self
  end
  
  def values(sink self: QueryBuilder, count: UInt) -> QueryBuilder
    var placeholders = Vec::new()
    for i in 0..count do
      placeholders.push((self.param_placeholder)(self.params.len() + i))
    end
    self.parts.push("VALUES (".to_string() + placeholders.join(", ") + ")")
    self
  end
  
  def update(sink self: QueryBuilder, table: str) -> QueryBuilder
    self.parts.push("UPDATE ".to_string() + table)
    self
  end
  
  def set(sink self: QueryBuilder, assignments: str) -> QueryBuilder
    self.parts.push("SET ".to_string() + assignments)
    self
  end
  
  def delete_from(sink self: QueryBuilder, table: str) -> QueryBuilder
    self.parts.push("DELETE FROM ".to_string() + table)
    self
  end
  
  def param(inout self: QueryBuilder, sink value: SqlValue) -> String
    let idx = self.params.len()
    self.params.push(value)
    (self.param_placeholder)(idx)
  end
  
  def raw(sink self: QueryBuilder, sql: str) -> QueryBuilder
    self.parts.push(sql.to_string())
    self
  end
  
  def build(self: QueryBuilder) -> (String, Vec[SqlValue])
    var out = Vec::new()
    for param in self.params do
      out.push(param.clone())
    end
    (self.parts.join(" "), out)
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 5: MIGRATION SYSTEM
# ═══════════════════════════════════════════════════════════════

struct Migration
  version: UInt
  name: String
  up: String
  down: String
end

struct Migrator
  migrations: Vec[Migration]
  table_name: String
end

impl Migrator
  def new() -> Migrator
    Migrator {
      migrations: Vec::new(),
      table_name: "_migrations".to_string()
    end
  end
  
  def add(sink self: Migrator, version: UInt, name: str, up: str, down: str) -> Migrator
    self.migrations.push(Migration {
      version: version,
      name: name.to_string(),
      up: up.to_string(),
      down: down.to_string()
    })
    self
  end
  
  def migrate[C](self: Migrator, inout conn: C) -> Result[UInt, DbError] where C: Connection
    # Create migrations table if not exists
    let create_sql = "CREATE TABLE IF NOT EXISTS ".to_string()
      + self.table_name.as_str()
      + " (version INTEGER PRIMARY KEY, name TEXT, applied_at TEXT)"
    conn.execute(&create_sql, &[])?
    
    # Get current version
    let rows = conn.query(&("SELECT MAX(version) FROM ".to_string() + self.table_name.as_str()), &[])?
    let current: i64 = rows.into_iter().next()
      .and_then(|row| row.get(0).ok())
      .unwrap_or(-1)
    
    var applied = 0
    
    for migration in self.migrations do
      if migration.version as i64 > current then
        var tx = conn.begin_transaction()?
        tx.execute(&migration.up, &[])?
        let insert_sql = "INSERT INTO ".to_string()
          + self.table_name.as_str()
          + " (version, name, applied_at) VALUES (?, ?, datetime('now'))"
        tx.execute(&insert_sql, &[Box::new(migration.version as i64) as Box[dyn ToSqlParam], Box::new(migration.name) as Box[dyn ToSqlParam]])?
        tx.commit()?
        applied = applied + 1
      end
    end
    
    Result::Ok(applied)
  end
  
  def rollback[C](self: Migrator, inout conn: C, steps: UInt) -> Result[UInt, DbError] where C: Connection
    let query_sql = "SELECT version FROM ".to_string()
      + self.table_name.as_str()
      + " ORDER BY version DESC LIMIT ?"
    let rows = conn.query(&query_sql, &[Box::new(steps as i64) as Box[dyn ToSqlParam]])?
    
    let versions: Vec[i64] = rows.into_iter()
      .filter_map(|row| row.get::<i64>(0).ok())
      .collect()
    
    var rolled_back = 0
    
    for version in versions do
      if let Option::Some(migration) = self.migrations.iter().find(|m| m.version as i64 == version) then
        var tx = conn.begin_transaction()?
        tx.execute(&migration.down, &[])?
        tx.execute(&("DELETE FROM ".to_string() + self.table_name.as_str() + " WHERE version = ?"), &[Box::new(version) as Box[dyn ToSqlParam]])?
        tx.commit()?
        rolled_back = rolled_back + 1
      end
    end
    
    Result::Ok(rolled_back)
  end
  
  def status[C](self: Migrator, conn: C) -> Result[Vec[(UInt, String, Bool)], DbError] where C: Connection
    let rows = conn.query(&("SELECT version, name FROM ".to_string() + self.table_name.as_str()), &[])?
    let applied: Map[i64, String] = rows.into_iter()
      .filter_map(|row| {
        let v: i64 = row.get(0).ok()?
        let n: String = row.get(1).ok()?
        Option::Some((v, n))
      })
      .collect()
    
    var status = Vec::new()
    for migration in self.migrations do
      let is_applied = applied.contains_key(&(migration.version as i64))
      status.push((migration.version, migration.name.clone(), is_applied))
    end
    
    Result::Ok(status)
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 6: CONNECTION POOL
# ═══════════════════════════════════════════════════════════════

use std::sync::{Mutex, Condvar}

struct Pool[C]
  connections: Mutex[Vec[C]]
  max_size: UInt
  current_size: UInt
  create_fn: fn() -> Result[C, DbError]
  available: Condvar
end

impl[C] Pool[C] where C: Connection
  def new(max_size: UInt, create_fn: fn() -> Result[C, DbError]) -> Result[Pool[C], DbError]
    var conns = Vec::new()
    
    # Create initial connection
    conns.push(create_fn()?)
    
    Result::Ok(Pool {
      connections: Mutex::new(conns),
      max_size: max_size,
      current_size: 1,
      create_fn: create_fn,
      available: Condvar::new()
    })
  end
  
  def get(self: Pool[C]) -> Result[PooledConnection[C], DbError]
    var guard = self.connections.lock()
    
    loop
      if let Option::Some(conn) = guard.pop() then
        return Result::Ok(PooledConnection {
          conn: Option::Some(conn),
          pool: self as Ptr[Pool[C]]
        })
      end
      
      if self.current_size < self.max_size then
        let conn = (self.create_fn)()?
        # Note: Would need interior mutability for current_size
        return Result::Ok(PooledConnection {
          conn: Option::Some(conn),
          pool: self as Ptr[Pool[C]]
        })
      end
      
      guard = self.available.wait(guard)
    end
  end
  
  def return_conn(self: Pool[C], sink conn: C) -> Unit
    var guard = self.connections.lock()
    guard.push(conn)
    self.available.notify_one()
  end
end

struct PooledConnection[C]
  conn: Option[C]
  pool: Ptr[Pool[C]]
end

impl[C] PooledConnection[C] where C: Connection
  def execute(inout self: PooledConnection[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    match self.conn
    when Option::Some(c) then c.execute(sql, params)
    when Option::None then Result::Err(DbError::Closed)
    end
  end
  
  def query(self: PooledConnection[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    match self.conn
    when Option::Some(c) then c.query(sql, params)
    when Option::None then Result::Err(DbError::Closed)
    end
  end
end

impl[C] Drop for PooledConnection[C] where C: Connection
  def drop(inout self: PooledConnection[C]) -> Unit
    if let Option::Some(conn) = self.conn.take() then
      self.pool.as_ref().return_conn(conn)
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 5: MYSQL DRIVER
# ═══════════════════════════════════════════════════════════════

## FFI bindings for libmysqlclient
extern "C"
  def mysql_init(mysql: Ptr[Unit]) -> Ptr[Unit]
  def mysql_real_connect(mysql: Ptr[Unit], host: Ptr[u8], user: Ptr[u8],
                          passwd: Ptr[u8], db: Ptr[u8], port: u32,
                          unix_socket: Ptr[u8], client_flag: UInt) -> Ptr[Unit]
  def mysql_close(mysql: Ptr[Unit]) -> Unit
  def mysql_query(mysql: Ptr[Unit], query: Ptr[u8]) -> i32
  def mysql_real_query(mysql: Ptr[Unit], query: Ptr[u8], length: UInt) -> i32
  def mysql_store_result(mysql: Ptr[Unit]) -> Ptr[Unit]
  def mysql_free_result(result: Ptr[Unit]) -> Unit
  def mysql_num_fields(result: Ptr[Unit]) -> u32
  def mysql_num_rows(result: Ptr[Unit]) -> u64
  def mysql_fetch_row(result: Ptr[Unit]) -> PtrMut[PtrMut[u8]]
  def mysql_fetch_lengths(result: Ptr[Unit]) -> PtrMut[UInt]
  def mysql_fetch_field(result: Ptr[Unit]) -> PtrMut[MysqlField]
  def mysql_affected_rows(mysql: Ptr[Unit]) -> u64
  def mysql_error(mysql: Ptr[Unit]) -> Ptr[u8]
  def mysql_errno(mysql: Ptr[Unit]) -> u32
  def mysql_real_escape_string(mysql: Ptr[Unit], to: PtrMut[u8], from: Ptr[u8], length: UInt) -> UInt
  def mysql_autocommit(mysql: Ptr[Unit], mode: u8) -> u8
  def mysql_commit(mysql: Ptr[Unit]) -> u8
  def mysql_rollback(mysql: Ptr[Unit]) -> u8
  def mysql_stmt_init(mysql: Ptr[Unit]) -> Ptr[Unit]
  def mysql_stmt_prepare(stmt: Ptr[Unit], query: Ptr[u8], length: UInt) -> i32
  def mysql_stmt_execute(stmt: Ptr[Unit]) -> i32
  def mysql_stmt_close(stmt: Ptr[Unit]) -> u8
  def mysql_stmt_affected_rows(stmt: Ptr[Unit]) -> u64
  def mysql_stmt_error(stmt: Ptr[Unit]) -> Ptr[u8]
end

@repr(C)
struct MysqlField
  name: Ptr[u8]
  org_name: Ptr[u8]
  table: Ptr[u8]
  org_table: Ptr[u8]
  db: Ptr[u8]
  catalog: Ptr[u8]
  def_: Ptr[u8]
  length: UInt
  max_length: UInt
  name_length: u32
  org_name_length: u32
  table_length: u32
  org_table_length: u32
  db_length: u32
  catalog_length: u32
  def_length: u32
  flags: u32
  decimals: u32
  charsetnr: u32
  type_: u32   ## MYSQL_TYPE_*
end

struct MysqlConfig
  host: String
  port: u16
  user: String
  password: String
  database: String
  charset: String
end

def mysql_config_new(host: str, user: str, password: str, database: str) -> MysqlConfig
  MysqlConfig {
    host: host.to_string(),
    port: 3306,
    user: user.to_string(),
    password: password.to_string(),
    database: database.to_string(),
    charset: "utf8mb4".to_string(),
  }
end

struct Mysql
  handle: Ptr[Unit]
  connected: Bool
end

def mysql_open(config: MysqlConfig) -> Result[Mysql, DbError]
  let handle = unsafe "FFI boundary" do mysql_init(Ptr::null()) end
  if handle.is_null() then
    return Result::Err(DbError::ConnectionFailed("mysql_init failed".to_string()))
  end

  let result = unsafe "FFI boundary" do
    mysql_real_connect(
      handle,
      config.host.to_cstring().as_ptr(),
      config.user.to_cstring().as_ptr(),
      config.password.to_cstring().as_ptr(),
      config.database.to_cstring().as_ptr(),
      config.port as u32,
      Ptr::null(),
      0
    )
  end

  if result.is_null() then
    let err_msg = unsafe "FFI boundary" do
      cstring_to_string(mysql_error(handle))
    end
    unsafe "FFI boundary" do mysql_close(handle) end
    return Result::Err(DbError::ConnectionFailed(err_msg))
  end

  Result::Ok(Mysql { handle: handle, connected: true })
end

impl Connection for Mysql
  def execute(inout self: Mysql, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    let query_str = mysql_interpolate_params(self, sql, params)?
    let ret = unsafe "FFI boundary" do
      mysql_real_query(self.handle, query_str.to_cstring().as_ptr(), query_str.len())
    end
    if ret != 0 then
      let err = unsafe "FFI boundary" do cstring_to_string(mysql_error(self.handle)) end
      return Result::Err(DbError::QueryFailed(err))
    end
    let affected = unsafe "FFI boundary" do mysql_affected_rows(self.handle) end
    Result::Ok(affected as UInt)
  end

  def query(self: Mysql, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    let query_str = mysql_interpolate_params_ref(self, sql, params)?
    let ret = unsafe "FFI boundary" do
      mysql_real_query(self.handle, query_str.to_cstring().as_ptr(), query_str.len())
    end
    if ret != 0 then
      let err = unsafe "FFI boundary" do cstring_to_string(mysql_error(self.handle)) end
      return Result::Err(DbError::QueryFailed(err))
    end
    let result = unsafe "FFI boundary" do mysql_store_result(self.handle) end
    if result.is_null() then
      return Result::Ok(Rows { columns: Vec::new(), data: Vec::new(), pos: 0 })
    end
    let rows = mysql_result_to_rows(result)
    unsafe "FFI boundary" do mysql_free_result(result) end
    Result::Ok(rows)
  end

  def begin_transaction(inout self: Mysql) -> Result[Transaction, DbError]
    let ret = unsafe "FFI boundary" do mysql_autocommit(self.handle, 0) end
    if ret != 0 then
      return Result::Err(DbError::TransactionError("failed to disable autocommit".to_string()))
    end
    mysql_execute_raw(self.handle, "BEGIN", &[])?
    Result::Ok(Transaction {
      conn_handle: self.handle,
      driver: DriverKind::Mysql,
      finished: false
    })
  end

  def prepare(inout self: Mysql, sql: str) -> Result[Statement, DbError]
    let stmt = unsafe "FFI boundary" do mysql_stmt_init(self.handle) end
    if stmt.is_null() then
      return Result::Err(DbError::Internal("mysql_stmt_init failed".to_string()))
    end
    let ret = unsafe "FFI boundary" do
      mysql_stmt_prepare(stmt, sql.to_cstring().as_ptr(), sql.len())
    end
    if ret != 0 then
      let err = unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt)) end
      unsafe "FFI boundary" do mysql_stmt_close(stmt) end
      return Result::Err(DbError::QueryFailed(err))
    end
    Result::Ok(Statement {
      handle: stmt,
      sql: sql.to_string(),
      driver: DriverKind::Mysql
    })
  end

  def close(inout self: Mysql) -> Result[Unit, DbError]
    if self.connected then
      unsafe "FFI boundary" do mysql_close(self.handle) end
      self.connected = false
    end
    Result::Ok(())
  end
end

impl Drop for Mysql
  def drop(inout self: Mysql) -> Unit
    let _ = self.close()
  end
end

def mysql_execute_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  let query_str = if params.is_empty() then
    sql.to_string()
  else
    mysql_interpolate(sql, params)?
  end
  let ret = if params.is_empty() then
    unsafe "FFI boundary" do mysql_query(handle, query_str.to_cstring().as_ptr()) end
  else
    unsafe "FFI boundary" do mysql_real_query(handle, query_str.to_cstring().as_ptr(), query_str.len()) end
  end
  if ret != 0 then
    let err = unsafe "FFI boundary" do cstring_to_string(mysql_error(handle)) end
    return Result::Err(DbError::QueryFailed(err))
  end
  let affected = unsafe "FFI boundary" do mysql_affected_rows(handle) end
  Result::Ok(affected as UInt)
end

def mysql_query_raw(handle: Ptr[Unit], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  let query_str = if params.is_empty() then
    sql.to_string()
  else
    mysql_interpolate(sql, params)?
  end
  let ret = unsafe "FFI boundary" do mysql_real_query(handle, query_str.to_cstring().as_ptr(), query_str.len()) end
  if ret != 0 then
    let err = unsafe "FFI boundary" do cstring_to_string(mysql_error(handle)) end
    return Result::Err(DbError::QueryFailed(err))
  end
  let result = unsafe "FFI boundary" do mysql_store_result(handle) end
  if result.is_null() then
    return Result::Ok(Rows { columns: Vec::new(), data: Vec::new(), pos: 0 })
  end
  let rows = mysql_result_to_rows(result)
  unsafe "FFI boundary" do mysql_free_result(result) end
  Result::Ok(rows)
end

def mysql_result_to_rows(result: Ptr[Unit]) -> Rows
  let num_fields = unsafe "FFI boundary" do mysql_num_fields(result) end as UInt
  let num_rows = unsafe "FFI boundary" do mysql_num_rows(result) end as UInt

  var columns = Vec::new()
  for i in 0..num_fields do
    let field = unsafe "FFI boundary" do mysql_fetch_field(result) end
    if !field.is_null() then
      let name = unsafe "FFI boundary" do cstring_to_string(field.name) end
      columns.push(name)
    end
  end

  var data = Vec::new()
  for _ in 0..num_rows do
    let row_ptr = unsafe "FFI boundary" do mysql_fetch_row(result) end as Ptr[Ptr[u8]]
    if row_ptr.is_null() then break end
    let lengths = unsafe "FFI boundary" do mysql_fetch_lengths(result) end as Ptr[UInt]
    var row_values = Vec::new()
    for j in 0..num_fields do
      let field_ptr = unsafe "FFI boundary" do *row_ptr.offset(j as isize) end
      if field_ptr.is_null() then
        row_values.push(SqlValue::Null)
      else
        let len = unsafe "FFI boundary" do *lengths.offset(j as isize) end
        let s = unsafe "FFI boundary" do string_from_ptr(field_ptr, len) end
        row_values.push(SqlValue::Text(s))
      end
    end
    data.push(row_values)
  end

  Rows { columns: columns, data: data, pos: 0 }
end

def mysql_stmt_run(inout stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  if stmt.handle.is_null() then
    return Result::Err(DbError::QueryFailed("statement already finalized"))
  end
  let ret = unsafe "FFI boundary" do mysql_stmt_execute(stmt.handle) end
  if ret != 0 then
    let err = unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt.handle)) end
    return Result::Err(DbError::QueryFailed(err))
  end
  let affected = unsafe "FFI boundary" do mysql_stmt_affected_rows(stmt.handle) end
  Result::Ok(affected as UInt)
end

def mysql_stmt_query(stmt: Statement, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  if stmt.handle.is_null() then
    return Result::Err(DbError::QueryFailed("statement already finalized"))
  end
  let ret = unsafe "FFI boundary" do mysql_stmt_execute(stmt.handle) end
  if ret != 0 then
    let err = unsafe "FFI boundary" do cstring_to_string(mysql_stmt_error(stmt.handle)) end
    return Result::Err(DbError::QueryFailed(err))
  end
  Result::Ok(Rows { columns: Vec::new(), data: Vec::new(), pos: 0 })
end

def mysql_stmt_finalize(inout stmt: Statement) -> Result[Unit, DbError]
  if !stmt.handle.is_null() then
    unsafe "FFI boundary" do mysql_stmt_close(stmt.handle) end
    stmt.handle = null_ptr()
  end
  Result::Ok(())
end

def mysql_interpolate(sql: str, params: [Box[dyn ToSqlParam]]) -> Result[String, DbError]
  var result = String::new()
  var param_idx = 0
  for ch in sql.chars() do
    if ch == '?' then
      if param_idx >= params.len() then
        return Result::Err(DbError::BindError(param_idx as UInt, "too few parameters".to_string()))
      end
      let val = params[param_idx].to_sql_param()
      result.push_str(&sql_value_to_mysql_literal(&val))
      param_idx = param_idx + 1
    else
      result.push(ch)
    end
  end
  Result::Ok(result)
end

def mysql_interpolate_params(inout conn: Mysql, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[String, DbError]
  mysql_interpolate(sql, params)
end

def mysql_interpolate_params_ref(conn: Mysql, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[String, DbError]
  mysql_interpolate(sql, params)
end

def sql_value_to_mysql_literal(val: SqlValue) -> String
  match val
  when SqlValue::Null then "NULL".to_string()
  when SqlValue::Integer(i) then i.to_string()
  when SqlValue::Float(f) then f.to_string()
  when SqlValue::Text(s) then "'" + s.replace("'", "\\'") + "'"
  when SqlValue::Bool(b) then if b then "1" else "0" end.to_string()
  when SqlValue::Blob(_) then "X''".to_string()  ## Simplified
  when SqlValue::Timestamp(t) then t.to_string()
  end
end

def cstring_to_string(ptr: Ptr[u8]) -> String
  if ptr.is_null() then return "".to_string() end
  var len = 0
  while unsafe "FFI" do *ptr.offset(len as isize) end != 0 do
    len = len + 1
  end
  unsafe "FFI" do string_from_ptr(ptr, len) end
end

def string_from_ptr(ptr: Ptr[u8], len: UInt) -> String
  var bytes = Vec::with_capacity(len)
  for i in 0..len do
    bytes.push(unsafe "FFI" do *ptr.offset(i as isize) end)
  end
  String::from_utf8(bytes).unwrap_or("".to_string())
end

# ═══════════════════════════════════════════════════════════════
# PART 6: ASYNC DATABASE OPERATIONS
# ═══════════════════════════════════════════════════════════════

## Trait for async database connections. Mirrors Connection but returns futures.
trait AsyncConnection
  async def execute(inout self: Self, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
  async def query(self: Self, sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
  async def begin_transaction(inout self: Self) -> Result[AsyncTransaction, DbError]
  async def close(inout self: Self) -> Result[Unit, DbError]
end

struct AsyncTransaction
  active: Bool
end

## Async wrapper around a synchronous Connection.
## Executes DB operations on a background thread pool to avoid blocking the async executor.
struct AsyncWrapper[C: Connection + Send]
  inner: C
end

def async_wrap[C: Connection + Send](conn: C) -> AsyncWrapper[C]
  AsyncWrapper { inner: conn }
end

impl[C: Connection + Send] AsyncConnection for AsyncWrapper[C]
  async def execute(inout self: AsyncWrapper[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    ## Offload to thread pool
    let sql_owned = sql.to_string()
    spawn_blocking(|| {
      self.inner.execute(&sql_owned, params)
    }).await
  end

  async def query(self: AsyncWrapper[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    let sql_owned = sql.to_string()
    spawn_blocking(|| {
      self.inner.query(&sql_owned, params)
    }).await
  end

  async def begin_transaction(inout self: AsyncWrapper[C]) -> Result[AsyncTransaction, DbError]
    spawn_blocking(|| {
      self.inner.begin_transaction()
    }).await.map(|t| AsyncTransaction { active: t.active })
  end

  async def close(inout self: AsyncWrapper[C]) -> Result[Unit, DbError]
    spawn_blocking(|| {
      self.inner.close()
    }).await
  end
end

## Async connection pool
struct AsyncPool[C: Connection + Send]
  pool: Pool[C]
end

def async_pool_new[C: Connection + Send](max_size: UInt) -> AsyncPool[C]
  AsyncPool { pool: pool_new(max_size) }
end

impl[C: Connection + Send] AsyncPool[C]
  async def get(self: AsyncPool[C]) -> Result[AsyncPooledConnection[C], DbError]
    spawn_blocking(|| {
      self.pool.acquire()
    }).await.map(|pc| AsyncPooledConnection { inner: pc })
  end
end

struct AsyncPooledConnection[C: Connection]
  inner: PooledConnection[C]
end

impl[C: Connection + Send] AsyncConnection for AsyncPooledConnection[C]
  async def execute(inout self: AsyncPooledConnection[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[UInt, DbError]
    spawn_blocking(|| self.inner.execute(sql, params)).await
  end

  async def query(self: AsyncPooledConnection[C], sql: str, params: [Box[dyn ToSqlParam]]) -> Result[Rows, DbError]
    spawn_blocking(|| self.inner.query(sql, params)).await
  end

  async def begin_transaction(inout self: AsyncPooledConnection[C]) -> Result[AsyncTransaction, DbError]
    Result::Err(DbError::Internal("use the inner connection for transactions".to_string()))
  end

  async def close(inout self: AsyncPooledConnection[C]) -> Result[Unit, DbError]
    Result::Ok(())  ## Returned to pool on drop
  end
end

## Helper: run a blocking closure on a thread pool and return a future.
async def spawn_blocking[T: Send, F: FnOnce() -> T + Send](f: F) -> T
  ## In a real implementation, this dispatches to a blocking thread pool
  ## and returns a future that resolves when the work completes.
  f()
end
