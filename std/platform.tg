# Tangerine Standard Library — tg::clipboard, tg::ime, tg::dragdrop
# Capability-gated platform services.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 12.

use std::core::{Option, Result, String, Bool, Unit}
use std::geom::{Rect}
use std::gfx_errors::{Error, ErrorCode}
use std::app::{ClipboardCap, ImeCap, DragDropCap}

# ═══════════════════════════════════════════════════════════════
# §12 AppError (re-export convenience; canonical definition in gfx_errors)
# ═══════════════════════════════════════════════════════════════

enum PlatformError
  PermissionDenied(Error)
  Unsupported(Error)
  IOError(Error)
  Internal(Error)
end

impl PlatformError
  def message(self: &PlatformError) -> &String
    match self
    when PlatformError::PermissionDenied(e) then &e.message
    when PlatformError::Unsupported(e) then &e.message
    when PlatformError::IOError(e) then &e.message
    when PlatformError::Internal(e) then &e.message
    end
  end

  def code(self: &PlatformError) -> ErrorCode
    match self
    when PlatformError::PermissionDenied(_) then ErrorCode::PermissionDenied
    when PlatformError::Unsupported(_) then ErrorCode::Unsupported
    when PlatformError::IOError(_) then ErrorCode::IOError
    when PlatformError::Internal(_) then ErrorCode::Internal
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# §12 tg::clipboard
# ═══════════════════════════════════════════════════════════════

module clipboard
  def set_text(win: &std::app::Window, caps: &ClipboardCap, text: String) -> Result[Unit, PlatformError]
    # Delegates to backend clipboard interface (tg.clipboard.v1).
    # Reference implementation returns Unsupported.
    Result::Err(PlatformError::Unsupported(
      Error::unsupported("Clipboard set_text requires tg.clipboard.v1 backend interface.".to_string())
    ))
  end

  def get_text(win: &std::app::Window, caps: &ClipboardCap) -> Result[String, PlatformError]
    # Delegates to backend clipboard interface (tg.clipboard.v1).
    Result::Err(PlatformError::Unsupported(
      Error::unsupported("Clipboard get_text requires tg.clipboard.v1 backend interface.".to_string())
    ))
  end
end

# ═══════════════════════════════════════════════════════════════
# §12 tg::ime
# ═══════════════════════════════════════════════════════════════

module ime
  def enable(win: &std::app::Window, caps: &ImeCap, enabled: Bool) -> Result[Unit, PlatformError]
    # Enable/disable IME input for the given window.
    Result::Err(PlatformError::Unsupported(
      Error::unsupported("IME enable requires tg.ime.v1 backend interface.".to_string())
    ))
  end

  def set_cursor_rect(win: &std::app::Window, caps: &ImeCap, rect: Rect) -> Result[Unit, PlatformError]
    # Position the IME candidate window relative to the cursor.
    Result::Err(PlatformError::Unsupported(
      Error::unsupported("IME set_cursor_rect requires tg.ime.v1 backend interface.".to_string())
    ))
  end
end

# ═══════════════════════════════════════════════════════════════
# §12 tg::dragdrop
# ═══════════════════════════════════════════════════════════════

module dragdrop
  def enable(win: &std::app::Window, caps: &DragDropCap, enabled: Bool) -> Result[Unit, PlatformError]
    # Enable/disable drag-and-drop for the given window.
    Result::Err(PlatformError::Unsupported(
      Error::unsupported("DragDrop enable requires tg.dragdrop.v1 backend interface.".to_string())
    ))
  end
end
