# ═══════════════════════════════════════════════════════════════
# AtomicPtr
# ═══════════════════════════════════════════════════════════════

struct AtomicPtr[T]
  ptr: &T
end

def AtomicPtr::new<T>(ptr: &T) -> AtomicPtr[T]
  AtomicPtr { ptr: ptr }
end

def AtomicPtr::load<T>(self: &AtomicPtr[T], order: Ordering) -> &T
  let o = ordering_to_c(order)
  unsafe { __atomic_load_ptr(&self.ptr as &&c_void, o) as &T }
end

def AtomicPtr::store<T>(self: &AtomicPtr[T], ptr: &T, order: Ordering) -> Unit
  let o = ordering_to_c(order)
  __atomic_store_ptr(&self.ptr as &&c_void, ptr as &c_void, o)
end

def AtomicPtr::exchange<T>(self: &AtomicPtr[T], ptr: &T, order: Ordering) -> &T
  let o = ordering_to_c(order)
  unsafe { __atomic_exchange_ptr(&self.ptr as &&c_void, ptr as &c_void, o) as &T }
end

def AtomicPtr::compare_exchange<T>(self: &AtomicPtr[T], expected: &mut &T, desired: &T,
                                    success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  unsafe {
    __atomic_compare_exchange_ptr(
      &self.ptr as &&c_void,
      expected as &&c_void,
      desired as &c_void,
      false, so, fo
    )
  }
end

def AtomicPtr::compare_exchange_weak<T>(self: &AtomicPtr[T], expected: &mut &T, desired: &T,
                                         success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  unsafe {
    __atomic_compare_exchange_ptr(
      &self.ptr as &&c_void,
      expected as &&c_void,
      desired as &c_void,
      true, so, fo
    )
  }
end

def AtomicPtr::get_mut<T>(self: &mut AtomicPtr[T]) -> &mut &T
  &mut self.ptr
end

def AtomicPtr::into_inner<T>(self: AtomicPtr[T]) -> &T
  self.ptr
end

# ═══════════════════════════════════════════════════════════════
# AtomicIsize / AtomicUsize
# ═══════════════════════════════════════════════════════════════

# On 64-bit systems, isize/usize are 64-bit
type AtomicIsize = AtomicInt
type AtomicUsize = AtomicUInt

def AtomicIsize::new(val: isize) -> AtomicIsize
  AtomicInt::new(val as Int)
end

def AtomicUsize::new(val: usize) -> AtomicUsize
  AtomicUInt::new(val as UInt)
end

# ═══════════════════════════════════════════════════════════════
# Global Fence Operations
# ═══════════════════════════════════════════════════════════════

def fence(order: Ordering) -> Unit
  match order
  when Ordering::Release then
    __sync_synchronize()
  when Ordering::Acquire then
    __sync_synchronize()
  when Ordering::AcqRel then
    __sync_synchronize()
  when Ordering::SeqCst then
    __sync_synchronize()
  when Ordering::Relaxed then
    # No fence needed for relaxed ordering
    ()
  end
end

def compiler_fence(order: Ordering) -> Unit
  # Prevents compiler reordering but not CPU reordering
  # This is typically implemented as a compiler barrier
  match order
  when Ordering::Release then
    asm volatile("" ::: "memory")
  when Ordering::Acquire then
    asm volatile("" ::: "memory")
  when Ordering::AcqRel then
    asm volatile("" ::: "memory")
  when Ordering::SeqCst then
    asm volatile("" ::: "memory")
  when Ordering::Relaxed then ()
  end
end

# ═══════════════════════════════════════════════════════════════
# Spin Lock using atomics
# ═══════════════════════════════════════════════════════════════

struct SpinLock
  locked: AtomicBool
end

def SpinLock::new() -> SpinLock
  SpinLock { locked: AtomicBool::new(false) }
end

def SpinLock::lock(self: &SpinLock) -> Unit
  loop
    # Try to acquire
    let mut expected = false
    if self.locked.compare_exchange_weak(&mut expected, true, Ordering::Acquire, Ordering::Relaxed) then
      return
    end
    
    # Spin with exponential backoff
    mut spins = 1
    while self.locked.load(Ordering::Relaxed) do
      mut i = 0
      while i < spins do
        # Pause instruction to reduce power consumption
        asm volatile("pause" ::: "memory")
        i = i + 1
      end
      spins = spins * 2
      if spins > 1024 then spins = 1024 end
    end
  end
end

def SpinLock::try_lock(self: &SpinLock) -> Bool
  let mut expected = false
  self.locked.compare_exchange(&mut expected, true, Ordering::Acquire, Ordering::Relaxed)
end

def SpinLock::unlock(self: &SpinLock) -> Unit
  self.locked.store(false, Ordering::Release)
end

def SpinLock::is_locked(self: &SpinLock) -> Bool
  self.locked.load(Ordering::Relaxed)
end

# ═══════════════════════════════════════════════════════════════
# SeqLock (Sequence Lock)
# ═══════════════════════════════════════════════════════════════

struct SeqLock
  sequence: AtomicUInt
end

def SeqLock::new() -> SeqLock
  SeqLock { sequence: AtomicUInt::new(0) }
end

def SeqLock::write_lock(self: &SeqLock) -> Unit
  # Increment sequence to odd number to indicate write in progress
  let seq = self.sequence.load(Ordering::Relaxed)
  if seq % 2 == 1 then
    panic!("SeqLock write_lock called while write in progress")
  end
  self.sequence.store(seq + 1, Ordering::Relaxed)
  fence(Ordering::Release)
end

def SeqLock::write_unlock(self: &SeqLock) -> Unit
  fence(Ordering::Release)
  let seq = self.sequence.load(Ordering::Relaxed)
  self.sequence.store(seq + 1, Ordering::Release)
end

def SeqLock::read_begin(self: &SeqLock) -> UInt
  loop
    let seq = self.sequence.load(Ordering::Acquire)
    if seq % 2 == 0 then
      return seq
    end
    # Write in progress, spin
    std::thread::yield_now()
  end
end

def SeqLock::read_retry(self: &SeqLock, start_seq: UInt) -> Bool
  fence(Ordering::Acquire)
  let seq = self.sequence.load(Ordering::Acquire)
  seq != start_seq
end

def SeqLock::opt_read<T, F: FnOnce() -> T>(self: &SeqLock, f: F) -> T
  loop
    let seq = self.read_begin()
    let result = f()
    if !self.read_retry(seq) then
      return result
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# RCU (Read-Copy-Update)
# ═══════════════════════════════════════════════════════════════

struct RcuPtr<T>
  ptr: AtomicPtr[T]
end

def RcuPtr::new<T>(ptr: &T) -> RcuPtr<T>
  RcuPtr { ptr: AtomicPtr::new(ptr) }
end

def RcuPtr::read<T>(self: &RcuPtr<T>) -> &T
  self.ptr.load(Ordering::Consume)
end

def RcuPtr::update<T>(self: &RcuPtr<T>, new_ptr: &T) -> &T
  let old = self.ptr.exchange(new_ptr, Ordering::AcqRel)
  # Caller must ensure no concurrent readers before freeing old
  old
end

def RcuPtr::synchronize<T>(self: &RcuPtr<T>) -> Unit
  # Wait for grace period - all pre-existing readers to complete
  # This is a simplified implementation
  fence(Ordering::SeqCst)
  std::thread::sleep_ms(1)
  fence(Ordering::SeqCst)
end

# ═══════════════════════════════════════════════════════════════
# Ticket Lock
# ═══════════════════════════════════════════════════════════════

struct TicketLock
  ticket: AtomicUInt
  serving: AtomicUInt
end

def TicketLock::new() -> TicketLock
  TicketLock {
    ticket: AtomicUInt::new(0),
    serving: AtomicUInt::new(0)
  }
end

def TicketLock::lock(self: &TicketLock) -> UInt
  let my_ticket = self.ticket.fetch_add(1, Ordering::Acquire)
  
  # Wait for our turn
  while self.serving.load(Ordering::Acquire) != my_ticket do
    std::thread::yield_now()
  end
  
  my_ticket
end

def TicketLock::unlock(self: &TicketLock) -> Unit
  self.serving.fetch_add(1, Ordering::Release)
end

def TicketLock::try_lock(self: &TicketLock) -> Option[UInt]
  let current = self.ticket.load(Ordering::Acquire)
  let serving = self.serving.load(Ordering::Acquire)
  
  if current == serving then
    # Try to atomically increment ticket
    let mut expected = current
    if self.ticket.compare_exchange(&mut expected, current + 1, Ordering::Acquire, Ordering::Relaxed) then
      return Option::Some(current)
    end
  end
  
  Option::None
end

# ═══════════════════════════════════════════════════════════════
# MCS Lock (Mellor-Crummey and Scott)
# ═══════════════════════════════════════════════════════════════

struct MCSNode
  next: AtomicPtr[MCSNode]
  locked: AtomicBool
end

def MCSNode::new() -> MCSNode
  MCSNode {
    next: AtomicPtr::new(std::ptr::null()),
    locked: AtomicBool::new(true)
  }
end

struct MCSLock
  tail: AtomicPtr[MCSNode]
end

def MCSLock::new() -> MCSLock
  MCSLock { tail: AtomicPtr::new(std::ptr::null()) }
end

def MCSLock::lock(self: &MCSLock, node: &MCSNode) -> Unit
  node.next.store(std::ptr::null(), Ordering::Relaxed)
  node.locked.store(true, Ordering::Relaxed)
  
  let prev = self.tail.exchange(node, Ordering::AcqRel)
  
  if !prev.is_null() then
    prev.next.store(node, Ordering::Release)
    
    # Wait for lock
    while node.locked.load(Ordering::Acquire) do
      std::thread::yield_now()
    end
  end
end

def MCSLock::unlock(self: &MCSLock, node: &MCSNode) -> Unit
  let next = node.next.load(Ordering::Acquire)
  
  if next.is_null() then
    # Try to set tail to null
    let mut expected = node as &MCSNode
    if self.tail.compare_exchange(&mut expected, std::ptr::null(), Ordering::Release, Ordering::Relaxed) then
      return
    end
    
    # Wait for next to be set
    loop
      next = node.next.load(Ordering::Acquire)
      if !next.is_null() then
        break
      end
      std::thread::yield_now()
    end
  end
  
  next.locked.store(false, Ordering::Release)
end

# ═══════════════════════════════════════════════════════════════
# Countdown Latch
# ═══════════════════════════════════════════════════════════════

struct CountDownLatch
  count: AtomicInt
  cond: std::sync::Condvar
  mutex: std::ffi::pthread_mutex_t
end

def CountDownLatch::new(count: Int) -> CountDownLatch
  CountDownLatch {
    count: AtomicInt::new(count),
    cond: std::sync::Condvar::new(),
    mutex: std::ffi::pthread_mutex_t { _data: [0u8; 48] }
  }
end

def CountDownLatch::count_down(self: &CountDownLatch) -> Unit
  let c = self.count.fetch_sub(1, Ordering::AcqRel)
  if c == 1 then
    let _ = std::ffi::pthread_mutex_lock(&self.mutex)
    let _ = std::ffi::pthread_cond_broadcast(&self.cond as &std::ffi::pthread_cond_t)
    let _ = std::ffi::pthread_mutex_unlock(&self.mutex)
  end
end

def CountDownLatch::await(self: &CountDownLatch) -> Unit
  let _ = std::ffi::pthread_mutex_lock(&self.mutex)
  while self.count.load(Ordering::Acquire) > 0 do
    let _ = std::ffi::pthread_cond_wait(&self.cond as &std::ffi::pthread_cond_t, &self.mutex)
  end
  let _ = std::ffi::pthread_mutex_unlock(&self.mutex)
end

def CountDownLatch::get_count(self: &CountDownLatch) -> Int
  self.count.load(Ordering::Relaxed)
end

# ═══════════════════════════════════════════════════════════════
# Cyclic Barrier
# ═══════════════════════════════════════════════════════════════

struct CyclicBarrier
  parties: UInt
  count: AtomicUInt
  generation: AtomicUInt
  mutex: std::ffi::pthread_mutex_t
  cond: std::ffi::pthread_cond_t
end

def CyclicBarrier::new(parties: UInt) -> CyclicBarrier
  CyclicBarrier {
    parties: parties,
    count: AtomicUInt::new(parties),
    generation: AtomicUInt::new(0),
    mutex: std::ffi::pthread_mutex_t { _data: [0u8; 48] },
    cond: std::ffi::pthread_cond_t { _data: [0u8; 48] }
  }
end

def CyclicBarrier::await(self: &CyclicBarrier) -> Bool
  let _ = std::ffi::pthread_mutex_lock(&self.mutex)
  
  let gen = self.generation.load(Ordering::Relaxed)
  let c = self.count.fetch_sub(1, Ordering::AcqRel)
  
  if c == 1 then
    # Last thread - reset barrier
    self.count.store(self.parties, Ordering::Relaxed)
    self.generation.fetch_add(1, Ordering::Relaxed)
    let _ = std::ffi::pthread_cond_broadcast(&self.cond as &std::ffi::pthread_cond_t)
    let _ = std::ffi::pthread_mutex_unlock(&self.mutex)
    return true  # This thread is the "leader"
  end
  
  # Wait for barrier to trip
  while gen == self.generation.load(Ordering::Relaxed) do
    let _ = std::ffi::pthread_cond_wait(&self.cond as &std::ffi::pthread_cond_t, &self.mutex)
  end
  
  let _ = std::ffi::pthread_mutex_unlock(&self.mutex)
  false
end

def CyclicBarrier::reset(self: &CyclicBarrier) -> Unit
  let _ = std::ffi::pthread_mutex_lock(&self.mutex)
  self.count.store(self.parties, Ordering::Relaxed)
  self.generation.fetch_add(1, Ordering::Relaxed)
  let _ = std::ffi::pthread_cond_broadcast(&self.cond as &std::ffi::pthread_cond_t)
  let _ = std::ffi::pthread_mutex_unlock(&self.mutex)
end

# ═══════════════════════════════════════════════════════════════
# Exchanger
# ═══════════════════════════════════════════════════════════════

struct Exchanger<T>
  slot: AtomicPtr[T]
  mutex: std::ffi::pthread_mutex_t
  cond: std::ffi::pthread_cond_t
end

def Exchanger::new<T>() -> Exchanger<T>
  Exchanger {
    slot: AtomicPtr::new(std::ptr::null()),
    mutex: std::ffi::pthread_mutex_t { _data: [0u8; 48] },
    cond: std::ffi::pthread_cond_t { _data: [0u8; 48] }
  }
end

def Exchanger::exchange<T>(self: &Exchanger<T>, item: &mut T, timeout: Option[std::time::Duration]) -> Result[Unit, String]
  let _ = std::ffi::pthread_mutex_lock(&self.mutex)
  
  let slot = self.slot.load(Ordering::Relaxed)
  
  if slot.is_null() then
    # First thread - store our item and wait
    self.slot.store(item as &T, Ordering::Release)
    
    match timeout
    when Option::Some(dur) then
      # Wait with timeout
      let ts = std::time::to_timespec(dur)
      loop
        if !self.slot.load(Ordering::Relaxed).is_null() then
          # Other thread has filled slot
          break
        end
        let err = std::ffi::pthread_cond_timedwait(&self.cond as &std::ffi::pthread_cond_t, &self.mutex, &ts)
        if err != 0 then
          self.slot.store(std::ptr::null(), Ordering::Relaxed)
          let _ = std::ffi::pthread_mutex_unlock(&self.mutex)
          return Result::Err("Timeout")
        end
      end
    when Option::None then
      # Wait indefinitely
      while self.slot.load(Ordering::Relaxed) == (item as &T) do
        let _ = std::ffi::pthread_cond_wait(&self.cond as &std::ffi::pthread_cond_t, &self.mutex)
      end
    end
    
    # Get other thread's value
    let other = self.slot.load(Ordering::Acquire)
    self.slot.store(std::ptr::null(), Ordering::Relaxed)
    let _ = std::ffi::pthread_cond_signal(&self.cond as &std::ffi::pthread_cond_t)
    let _ = std::ffi::pthread_mutex_unlock(&self.mutex)
    
    # Swap values
    std::mem::swap(item, other as &mut T)
    Result::Ok(())
  else
    # Second thread - fill slot and wake first thread
    self.slot.store(item as &T, Ordering::Release)
    let _ = std::ffi::pthread_cond_signal(&self.cond as &std::ffi::pthread_cond_t)
    
    # Wait for first thread to take our value
    while !self.slot.load(Ordering::Relaxed).is_null() do
      let _ = std::ffi::pthread_cond_wait(&self.cond as &std::ffi::pthread_cond_t, &self.mutex)
    end
    
    let _ = std::ffi::pthread_mutex_unlock(&self.mutex)
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Atomic Reference (Arc-like with weak references)
# ═══════════════════════════════════════════════════════════════

struct AtomicRefInner<T>
  strong: AtomicUInt
  weak: AtomicUInt
  data: T
end

struct AtomicRef<T>
  inner: &AtomicRefInner<T>
end

struct WeakRef<T>
  inner: &AtomicRefInner<T>
end

def AtomicRef::new<T>(value: T) -> AtomicRef<T>
  let inner = std::mem::alloc::[AtomicRefInner[T]]()
  inner.strong = AtomicUInt::new(1)
  inner.weak = AtomicUInt::new(1)
  inner.data = value
  AtomicRef { inner: inner }
end

def AtomicRef::clone<T>(self: &AtomicRef<T>) -> AtomicRef<T>
  self.inner.strong.fetch_add(1, Ordering::Relaxed)
  AtomicRef { inner: self.inner }
end

def AtomicRef::drop<T>(self: &mut AtomicRef<T>) -> Unit
  if self.inner.strong.fetch_sub(1, Ordering::Release) == 1 then
    fence(Ordering::Acquire)
    # Drop the data
    std::mem::drop(&mut self.inner.data)
    
    # Decrement weak count
    if self.inner.weak.fetch_sub(1, Ordering::Release) == 1 then
      fence(Ordering::Acquire)
      std::mem::free(self.inner)
    end
  end
end

def AtomicRef::deref<T>(self: &AtomicRef<T>) -> &T
  &self.inner.data
end

def AtomicRef::strong_count<T>(self: &AtomicRef<T>) -> UInt
  self.inner.strong.load(Ordering::Relaxed)
end

def AtomicRef::weak_count<T>(self: &AtomicRef<T>) -> UInt
  self.inner.weak.load(Ordering::Relaxed)
end

def AtomicRef::downgrade<T>(self: &AtomicRef<T>) -> WeakRef<T>
  self.inner.weak.fetch_add(1, Ordering::Relaxed)
  WeakRef { inner: self.inner }
end

def AtomicRef::get_mut<T>(self: &mut AtomicRef<T>) -> Option[&mut T]
  if self.inner.strong.load(Ordering::Acquire) == 1 then
    fence(Ordering::Acquire)
    Option::Some(&mut self.inner.data)
  else
    Option::None
  end
end

def AtomicRef::compare_exchange<T>(self: &AtomicRef<T>, expected: &AtomicRef<T>, new: AtomicRef<T>) -> Result[AtomicRef[T], AtomicRef[T]]
  # Compare inner pointers
  if self.inner == expected.inner then
    # Increment new ref count
    new.inner.strong.fetch_add(1, Ordering::Relaxed)
    # Decrement old ref count
    let _ = self.inner.strong.fetch_sub(1, Ordering::Release)
    Result::Ok(new)
  else
    Result::Err(expected.clone())
  end
end

def WeakRef::upgrade<T>(self: &WeakRef<T>) -> Option[AtomicRef[T]]
  loop
    let strong = self.inner.strong.load(Ordering::Relaxed)
    if strong == 0 then
      return Option::None
    end
    
    # Try to increment strong count
    let mut expected = strong
    if self.inner.strong.compare_exchange_weak(&mut expected, strong + 1, Ordering::Acquire, Ordering::Relaxed) then
      return Option::Some(AtomicRef { inner: self.inner })
    end
  end
end

def WeakRef::drop<T>(self: &mut WeakRef<T>) -> Unit
  if self.inner.weak.fetch_sub(1, Ordering::Release) == 1 then
    fence(Ordering::Acquire)
    # Only free if strong count is also 0
    if self.inner.strong.load(Ordering::Relaxed) == 0 then
      std::mem::free(self.inner)
    end
  end
end
# ———————————————————————————————————————————————————————————————
# Transferable / Shareable marker impls (access + resource model)
# ———————————————————————————————————————————————————————————————

impl Transferable for AtomicBool {}
impl Shareable for AtomicBool {}

impl Transferable for AtomicInt {}
impl Shareable for AtomicInt {}

impl Transferable for AtomicUInt {}
impl Shareable for AtomicUInt {}

impl Transferable for AtomicU8 {}
impl Shareable for AtomicU8 {}

impl Transferable for AtomicU64 {}
impl Shareable for AtomicU64 {}

impl[T] Transferable for AtomicPtr[T] {}
impl[T] Shareable for AtomicPtr[T] {}
