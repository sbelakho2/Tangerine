# ═══════════════════════════════════════════════════════════════

struct AtomicU8
  value: u8
end

def AtomicU8::new(val: u8) -> AtomicU8
  AtomicU8 { value: val }
end

def AtomicU8::load(self: &AtomicU8, order: Ordering) -> u8
  __atomic_load_u8(&self.value, ordering_to_c(order))
end

def AtomicU8::store(self: &AtomicU8, val: u8, order: Ordering) -> Unit
  __atomic_store_u8(&self.value, val, ordering_to_c(order))
end

def AtomicU8::exchange(self: &AtomicU8, val: u8, order: Ordering) -> u8
  __atomic_exchange_u8(&self.value, val, ordering_to_c(order))
end

def AtomicU8::compare_exchange(self: &AtomicU8, expected: &mut u8, desired: u8,
                                success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  __atomic_compare_exchange_u8(&self.value, expected, desired, false, so, fo)
end

def AtomicU8::compare_exchange_weak(self: &AtomicU8, expected: &mut u8, desired: u8,
                                     success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  __atomic_compare_exchange_u8(&self.value, expected, desired, true, so, fo)
end

def AtomicU8::fetch_add(self: &AtomicU8, val: u8, order: Ordering) -> u8
  loop
    let current = self.load(Ordering::Relaxed)
    let mut expected = current
    let new_val = current + val
    if self.compare_exchange_weak(&mut expected, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicU8::fetch_sub(self: &AtomicU8, val: u8, order: Ordering) -> u8
  loop
    let current = self.load(Ordering::Relaxed)
    let mut expected = current
    let new_val = current - val
    if self.compare_exchange_weak(&mut expected, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

