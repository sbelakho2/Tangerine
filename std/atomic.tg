# ═══════════════════════════════════════════════════════════════
# Memory Ordering
# ═══════════════════════════════════════════════════════════════

enum Ordering
  Relaxed    # No ordering constraints, only atomicity
  Release    # Prevents reordering of writes before this operation
  Acquire    # Prevents reordering of reads after this operation
  AcqRel     # Combines Acquire and Release
  SeqCst     # Sequentially consistent - total order for all threads
end

# Compiler and CPU memory barriers
@ffi("c")
extern def __sync_synchronize() -> Unit
end

# Atomic built-in functions (GCC/Clang)
@ffi("c")
extern def __atomic_load_n(ptr: &Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_store_n(ptr: &Int, val: Int, order: c_int) -> Unit
end

@ffi("c")
extern def __atomic_exchange_n(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_compare_exchange_n(ptr: &Int, expected: &Int, desired: Int, 
                                        weak: Bool, success_order: c_int, failure_order: c_int) -> Bool
end

@ffi("c")
extern def __atomic_add_fetch(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_sub_fetch(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_and_fetch(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_or_fetch(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_xor_fetch(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_fetch_add(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_fetch_sub(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_fetch_and(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_fetch_or(ptr: &Int, val: Int, order: c_int) -> Int
end

@ffi("c")
extern def __atomic_fetch_xor(ptr: &Int, val: Int, order: c_int) -> Int
end

# Unsigned variants
@ffi("c")
