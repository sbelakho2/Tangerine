# Tangerine Standard Library — tg::atomic
# Atomic Types and Operations

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt}
use std::ffi::{c_int, c_void}

# [METADATA]
# module: tg::atomic
# status: stable
# effects: []
# capabilities: [atomic]

# ═══════════════════════════════════════════════════════════════
# Memory Ordering
# ═══════════════════════════════════════════════════════════════

enum Ordering
  Relaxed    # No ordering constraints, only atomicity
  Release    # Prevents reordering of writes before this operation
  Acquire    # Prevents reordering of reads after this operation
  AcqRel     # Combines Acquire and Release
  SeqCst     # Sequentially consistent - total order for all threads
end

# ═══════════════════════════════════════════════════════════════
# Atomic intrinsics — the ONE atomic primitive layer
# ═══════════════════════════════════════════════════════════════
# The compiler emits these inline on BOTH arches (codegen's
# try_emit_atomic_builtin -> emit_atomic_intrinsic: the LDAR/STLR/LSE
# atomics on AArch64, the LOCKed xchg/xadd/cmpxchg on x86). Every
# atomic type in this module AND in std::sync routes through this
# layer — a fence does NOT turn a non-atomic access into an atomic
# one, so the fence-around-ordinary-access pattern is never the
# authority.
#
# ABI: load(ptr, order) -> value; store(ptr, value, order);
# exchange(ptr, value, order) -> old; compare_exchange(ptr,
# &expected, desired, weak, success_order, failure_order) -> Bool
# (the expected slot is updated with the current value on failure);
# fetch_*(ptr, value, order) -> old; *_fetch(ptr, value, order) ->
# new; fence(order). Order codes: 0 = Relaxed, 2 = Acquire,
# 3 = Release, 4 = AcqRel, 5 = SeqCst (ordering_to_c below).

# load / store / exchange per width 1/2/4/8
extern def __intrinsic_atomic_load_u8(ptr: Ptr[u8], order: c_int) -> u8
extern def __intrinsic_atomic_load_u16(ptr: Ptr[u16], order: c_int) -> u16
extern def __intrinsic_atomic_load_u32(ptr: Ptr[u32], order: c_int) -> u32
extern def __intrinsic_atomic_load_u64(ptr: Ptr[u64], order: c_int) -> u64

extern def __intrinsic_atomic_store_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> Unit
extern def __intrinsic_atomic_store_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> Unit
extern def __intrinsic_atomic_store_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> Unit
extern def __intrinsic_atomic_store_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> Unit

extern def __intrinsic_atomic_exchange_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_exchange_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_exchange_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_exchange_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

# compare_exchange per width 1/2/4/8 (the weak flag is accepted for
# ABI compatibility; the emitters use the single-attempt strong form).
extern def __intrinsic_atomic_compare_exchange_u8(ptr: PtrMut[u8], expected: PtrMut[u8], desired: u8, weak: Bool, success_order: c_int, failure_order: c_int) -> Bool
extern def __intrinsic_atomic_compare_exchange_u16(ptr: PtrMut[u16], expected: PtrMut[u16], desired: u16, weak: Bool, success_order: c_int, failure_order: c_int) -> Bool
extern def __intrinsic_atomic_compare_exchange_u32(ptr: PtrMut[u32], expected: PtrMut[u32], desired: u32, weak: Bool, success_order: c_int, failure_order: c_int) -> Bool
extern def __intrinsic_atomic_compare_exchange_u64(ptr: PtrMut[u64], expected: PtrMut[u64], desired: u64, weak: Bool, success_order: c_int, failure_order: c_int) -> Bool

# fetch_* — apply the operation, return the OLD value — per width 1/2/4/8
extern def __intrinsic_atomic_fetch_add_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_fetch_add_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_fetch_add_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_fetch_add_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

extern def __intrinsic_atomic_fetch_sub_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_fetch_sub_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_fetch_sub_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_fetch_sub_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

extern def __intrinsic_atomic_fetch_and_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_fetch_and_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_fetch_and_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_fetch_and_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

extern def __intrinsic_atomic_fetch_or_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_fetch_or_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_fetch_or_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_fetch_or_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

extern def __intrinsic_atomic_fetch_xor_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_fetch_xor_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_fetch_xor_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_fetch_xor_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

# *_fetch — apply the operation, return the NEW value — per width 1/2/4/8
extern def __intrinsic_atomic_add_fetch_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_add_fetch_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_add_fetch_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_add_fetch_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

extern def __intrinsic_atomic_sub_fetch_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_sub_fetch_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_sub_fetch_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_sub_fetch_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

extern def __intrinsic_atomic_and_fetch_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_and_fetch_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_and_fetch_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_and_fetch_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

extern def __intrinsic_atomic_or_fetch_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_or_fetch_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_or_fetch_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_or_fetch_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

extern def __intrinsic_atomic_xor_fetch_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_xor_fetch_u16(ptr: PtrMut[u16], value: u16, order: c_int) -> u16
extern def __intrinsic_atomic_xor_fetch_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_xor_fetch_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

# fence(order) — the memory fence (DMB ISH on AArch64, MFENCE on x86).
extern def __intrinsic_atomic_fence(order: c_int) -> Unit

# Convert ordering to C int
def ordering_to_c(order: Ordering) -> c_int
  match order
  when Ordering::Relaxed then 0
  when Ordering::Acquire then 2
  when Ordering::Release then 3
  when Ordering::AcqRel then 4
  when Ordering::SeqCst then 5
  end
end

# ═══════════════════════════════════════════════════════════════
# AtomicBool
# ═══════════════════════════════════════════════════════════════

struct AtomicBool
  value: u8  # Use u8 for better FFI compatibility
end

def AtomicBool::new(val: Bool) -> AtomicBool
  AtomicBool { value: if val then 1 else 0 end }
end

def AtomicBool::load(self: AtomicBool, order: Ordering) -> Bool
  let o = ordering_to_c(order)
  __intrinsic_atomic_load_u8(&self.value as Ptr[u8], o) != 0
end

def AtomicBool::store(inout self: AtomicBool, val: Bool, order: Ordering) -> Unit
  let o = ordering_to_c(order)
  __intrinsic_atomic_store_u8(&self.value as PtrMut[u8], if val then 1 else 0 end, o)
end

def AtomicBool::exchange(inout self: AtomicBool, val: Bool, order: Ordering) -> Bool
  let o = ordering_to_c(order)
  __intrinsic_atomic_exchange_u8(&self.value as PtrMut[u8], if val then 1 else 0 end, o) != 0
end

def AtomicBool::compare_exchange(inout self: AtomicBool, inout expected: Bool, desired: Bool,
                                  success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  mut exp = if *expected then 1u8 else 0u8 end
  let result = __intrinsic_atomic_compare_exchange_u8(&self.value as PtrMut[u8], &mut exp as PtrMut[u8], if desired then 1 else 0 end, false, so, fo)
  if !result then
    *expected = exp != 0
  end
  result
end

def AtomicBool::compare_exchange_weak(inout self: AtomicBool, inout expected: Bool, desired: Bool,
                                       success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  mut exp = if *expected then 1u8 else 0u8 end
  let result = __intrinsic_atomic_compare_exchange_u8(&self.value as PtrMut[u8], &mut exp as PtrMut[u8], if desired then 1 else 0 end, true, so, fo)
  if !result then
    *expected = exp != 0
  end
  result
end

def AtomicBool::fetch_and(inout self: AtomicBool, val: Bool, order: Ordering) -> Bool
  # Emulated using compare_exchange
  loop
    var current = self.load(Ordering::Relaxed)
    let new_val = current && val
    if self.compare_exchange_weak(&mut current, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicBool::fetch_or(inout self: AtomicBool, val: Bool, order: Ordering) -> Bool
  loop
    var current = self.load(Ordering::Relaxed)
    let new_val = current || val
    if self.compare_exchange_weak(&mut current, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicBool::fetch_xor(inout self: AtomicBool, val: Bool, order: Ordering) -> Bool
  loop
    var current = self.load(Ordering::Relaxed)
    let new_val = current != val
    if self.compare_exchange_weak(&mut current, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicBool::fetch_not(inout self: AtomicBool, order: Ordering) -> Bool
  self.fetch_xor(true, order)
end

def AtomicBool::get_mut(inout self: AtomicBool) -> PtrMut[Bool]
  unsafe { address_of_mut(&mut self.value) }
end

def AtomicBool::into_inner(self: AtomicBool) -> Bool
  self.value != 0
end

# ═══════════════════════════════════════════════════════════════
# AtomicInt
# ═══════════════════════════════════════════════════════════════

struct AtomicInt
  value: Int
end

def AtomicInt::new(val: Int) -> AtomicInt
  AtomicInt { value: val }
end

def AtomicInt::load(self: AtomicInt, order: Ordering) -> Int
  __intrinsic_atomic_load_u64(&self.value as Ptr[u64], ordering_to_c(order)) as Int
end

def AtomicInt::store(inout self: AtomicInt, val: Int, order: Ordering) -> Unit
  __intrinsic_atomic_store_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order))
end

def AtomicInt::exchange(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_exchange_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::compare_exchange(inout self: AtomicInt, inout expected: Int, desired: Int,
                                 success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  __intrinsic_atomic_compare_exchange_u64(&self.value as PtrMut[u64], expected as PtrMut[u64], desired as u64, false, so, fo)
end

def AtomicInt::compare_exchange_weak(inout self: AtomicInt, inout expected: Int, desired: Int,
                                      success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  __intrinsic_atomic_compare_exchange_u64(&self.value as PtrMut[u64], expected as PtrMut[u64], desired as u64, true, so, fo)
end

def AtomicInt::fetch_add(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_fetch_add_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::fetch_sub(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_fetch_sub_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::fetch_and(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_fetch_and_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::fetch_or(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_fetch_or_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::fetch_xor(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_fetch_xor_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::fetch_update[F: Fn(Int) -> Option[Int]](inout self: AtomicInt, set_order: Ordering, fetch_order: Ordering, f: F) -> Result[Int, Int]
  loop
    let current = self.load(fetch_order)
    match f(current)
    when Option::Some(new_val) then
      let mut expected = current
      if self.compare_exchange_weak(&mut expected, new_val, set_order, fetch_order) then
        return Result::Ok(current)
      end
    when Option::None then
      return Result::Err(current)
    end
  end
end

def AtomicInt::fetch_max(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  loop
    let current = self.load(Ordering::Relaxed)
    let new_val = if current > val then current else val end
    let mut expected = current
    if self.compare_exchange_weak(&mut expected, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicInt::fetch_min(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  loop
    let current = self.load(Ordering::Relaxed)
    let new_val = if current < val then current else val end
    let mut expected = current
    if self.compare_exchange_weak(&mut expected, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicInt::add_fetch(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_add_fetch_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::sub_fetch(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_sub_fetch_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::and_fetch(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_and_fetch_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::or_fetch(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_or_fetch_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::xor_fetch(inout self: AtomicInt, val: Int, order: Ordering) -> Int
  __intrinsic_atomic_xor_fetch_u64(&self.value as PtrMut[u64], val as u64, ordering_to_c(order)) as Int
end

def AtomicInt::get_mut(inout self: AtomicInt) -> PtrMut[Int]
  address_of_mut(&mut self.value)
end

def AtomicInt::into_inner(self: AtomicInt) -> Int
  self.value
end

