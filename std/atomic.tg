# Pointer variants
@ffi("c")
extern def __atomic_load_ptr(ptr: &&c_void, order: c_int) -> &c_void
end

@ffi("c")
extern def __atomic_store_ptr(ptr: &&c_void, val: &c_void, order: c_int) -> Unit
end

@ffi("c")
extern def __atomic_exchange_ptr(ptr: &&c_void, val: &c_void, order: c_int) -> &c_void
end

@ffi("c")
