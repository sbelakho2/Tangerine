# Tangerine Standard Library — tg::atomic
# Atomic Types and Operations

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt}
use std::ffi::{c_int, c_void}

# [METADATA]
# module: tg::atomic
# status: stable
