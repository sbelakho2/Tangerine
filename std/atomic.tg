# AtomicU8, AtomicU16, AtomicU32, AtomicU64
# ═══════════════════════════════════════════════════════════════

struct AtomicU8
  value: u8
end

def AtomicU8::new(val: u8) -> AtomicU8
  AtomicU8 { value: val }
end

def AtomicU8::load(self: AtomicU8, order: Ordering) -> u8
  __intrinsic_atomic_load_u8(&self.value as Ptr[u8], ordering_to_c(order))
end

def AtomicU8::store(inout self: AtomicU8, val: u8, order: Ordering) -> Unit
  __intrinsic_atomic_store_u8(&self.value as PtrMut[u8], val, ordering_to_c(order))
end

def AtomicU8::exchange(inout self: AtomicU8, val: u8, order: Ordering) -> u8
  __intrinsic_atomic_exchange_u8(&self.value as PtrMut[u8], val, ordering_to_c(order))
end

def AtomicU8::compare_exchange(inout self: AtomicU8, inout expected: u8, desired: u8,
                                success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  __intrinsic_atomic_compare_exchange_u8(&self.value as PtrMut[u8], expected as PtrMut[u8], desired, false, so, fo)
end

def AtomicU8::compare_exchange_weak(inout self: AtomicU8, inout expected: u8, desired: u8,
                                     success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  __intrinsic_atomic_compare_exchange_u8(&self.value as PtrMut[u8], expected as PtrMut[u8], desired, true, so, fo)
end

