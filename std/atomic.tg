                                          weak: Bool, success_order: c_int, failure_order: c_int) -> Bool
end

# Convert ordering to C int
def ordering_to_c(order: Ordering) -> c_int
  match order
  when Ordering::Relaxed then 0
  when Ordering::Acquire then 2
  when Ordering::Release then 3
  when Ordering::AcqRel then 4
  when Ordering::SeqCst then 5
  end
end

# ═══════════════════════════════════════════════════════════════
# AtomicBool
# ═══════════════════════════════════════════════════════════════

struct AtomicBool
  value: u8  # Use u8 for better FFI compatibility
end

def AtomicBool::new(val: Bool) -> AtomicBool
  AtomicBool { value: if val then 1 else 0 end }
end

def AtomicBool::load(self: &AtomicBool, order: Ordering) -> Bool
  let o = ordering_to_c(order)
  __atomic_load_u8(&self.value, o) != 0
end

def AtomicBool::store(self: &AtomicBool, val: Bool, order: Ordering) -> Unit
  let o = ordering_to_c(order)
  __atomic_store_u8(&self.value, if val then 1 else 0 end, o)
end

def AtomicBool::exchange(self: &AtomicBool, val: Bool, order: Ordering) -> Bool
  let o = ordering_to_c(order)
  __atomic_exchange_u8(&self.value, if val then 1 else 0 end, o) != 0
end

def AtomicBool::compare_exchange(self: &AtomicBool, expected: &mut Bool, desired: Bool,
                                  success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  mut exp = if *expected then 1u8 else 0u8 end
  let result = __atomic_compare_exchange_u8(&self.value, &mut exp, if desired then 1 else 0 end, false, so, fo)
  if !result then
    *expected = exp != 0
  end
  result
end

def AtomicBool::compare_exchange_weak(self: &AtomicBool, expected: &mut Bool, desired: Bool,
                                       success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  mut exp = if *expected then 1u8 else 0u8 end
  let result = __atomic_compare_exchange_u8(&self.value, &mut exp, if desired then 1 else 0 end, true, so, fo)
  if !result then
    *expected = exp != 0
  end
  result
end

def AtomicBool::fetch_and(self: &AtomicBool, val: Bool, order: Ordering) -> Bool
  # Emulated using compare_exchange
  loop
    let current = self.load(Ordering::Relaxed)
    let new_val = current && val
    if self.compare_exchange_weak(&mut current as &mut Bool, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicBool::fetch_or(self: &AtomicBool, val: Bool, order: Ordering) -> Bool
  loop
    let current = self.load(Ordering::Relaxed)
    let new_val = current || val
    if self.compare_exchange_weak(&mut current as &mut Bool, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicBool::fetch_xor(self: &AtomicBool, val: Bool, order: Ordering) -> Bool
  loop
    let current = self.load(Ordering::Relaxed)
    let new_val = current != val
    if self.compare_exchange_weak(&mut current as &mut Bool, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicBool::fetch_not(self: &AtomicBool, order: Ordering) -> Bool
  self.fetch_xor(true, order)
end

def AtomicBool::get_mut(self: &mut AtomicBool) -> &mut Bool
  unsafe { &mut *(&mut self.value as &mut Bool) }
end

def AtomicBool::into_inner(self: AtomicBool) -> Bool
  self.value != 0
end

# ═══════════════════════════════════════════════════════════════
# AtomicInt
# ═══════════════════════════════════════════════════════════════

struct AtomicInt
  value: Int
end

def AtomicInt::new(val: Int) -> AtomicInt
  AtomicInt { value: val }
end

def AtomicInt::load(self: &AtomicInt, order: Ordering) -> Int
  __atomic_load_n(&self.value, ordering_to_c(order))
end

def AtomicInt::store(self: &AtomicInt, val: Int, order: Ordering) -> Unit
  __atomic_store_n(&self.value, val, ordering_to_c(order))
end

def AtomicInt::exchange(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_exchange_n(&self.value, val, ordering_to_c(order))
end

def AtomicInt::compare_exchange(self: &AtomicInt, expected: &mut Int, desired: Int,
                                 success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  let result = __atomic_compare_exchange_n(&self.value, expected, desired, false, so, fo)
  result
end

def AtomicInt::compare_exchange_weak(self: &AtomicInt, expected: &mut Int, desired: Int,
                                      success_order: Ordering, failure_order: Ordering) -> Bool
  let so = ordering_to_c(success_order)
  let fo = ordering_to_c(failure_order)
  __atomic_compare_exchange_n(&self.value, expected, desired, true, so, fo)
end

def AtomicInt::fetch_add(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_fetch_add(&self.value, val, ordering_to_c(order))
end

def AtomicInt::fetch_sub(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_fetch_sub(&self.value, val, ordering_to_c(order))
end

def AtomicInt::fetch_and(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_fetch_and(&self.value, val, ordering_to_c(order))
end

def AtomicInt::fetch_or(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_fetch_or(&self.value, val, ordering_to_c(order))
end

def AtomicInt::fetch_xor(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_fetch_xor(&self.value, val, ordering_to_c(order))
end

def AtomicInt::fetch_update<F: Fn(Int) -> Option[Int]>(self: &AtomicInt, set_order: Ordering, fetch_order: Ordering, f: F) -> Result[Int, Int]
  loop
    let current = self.load(fetch_order)
    match f(current)
    when Option::Some(new_val) then
      let mut expected = current
      if self.compare_exchange_weak(&mut expected, new_val, set_order, fetch_order) then
        return Result::Ok(current)
      end
    when Option::None then
      return Result::Err(current)
    end
  end
end

def AtomicInt::fetch_max(self: &AtomicInt, val: Int, order: Ordering) -> Int
  loop
    let current = self.load(Ordering::Relaxed)
    let new_val = if current > val then current else val end
    let mut expected = current
    if self.compare_exchange_weak(&mut expected, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicInt::fetch_min(self: &AtomicInt, val: Int, order: Ordering) -> Int
  loop
    let current = self.load(Ordering::Relaxed)
    let new_val = if current < val then current else val end
    let mut expected = current
    if self.compare_exchange_weak(&mut expected, new_val, order, Ordering::Relaxed) then
      return current
    end
  end
end

def AtomicInt::add_fetch(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_add_fetch(&self.value, val, ordering_to_c(order))
end

def AtomicInt::sub_fetch(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_sub_fetch(&self.value, val, ordering_to_c(order))
end

def AtomicInt::and_fetch(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_and_fetch(&self.value, val, ordering_to_c(order))
end

def AtomicInt::or_fetch(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_or_fetch(&self.value, val, ordering_to_c(order))
end

def AtomicInt::xor_fetch(self: &AtomicInt, val: Int, order: Ordering) -> Int
  __atomic_xor_fetch(&self.value, val, ordering_to_c(order))
end

def AtomicInt::get_mut(self: &mut AtomicInt) -> &mut Int
  &mut self.value
end

def AtomicInt::into_inner(self: AtomicInt) -> Int
  self.value
end

