# ═══════════════════════════════════════════════════════════════
# Event Handlers
# ═══════════════════════════════════════════════════════════════

def Application::handle_mouse_down(&mut self, widget_id: Int, x: Float, y: Float) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_click
    when Option::Some(callback) => callback(widget_id)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_mouse_up(&mut self, widget_id: Int, x: Float, y: Float) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_click
    when Option::Some(callback) => callback(widget_id)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_mouse_move(&mut self, widget_id: Int, x: Float, y: Float) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_hover
    when Option::Some(callback) => callback(widget_id, true)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_key_down(&mut self, widget_id: Int, key: KeyCode, mods: ModifierKeys) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_key
    when Option::Some(callback) => callback(widget_id, key as Int, 0)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_key_up(&mut self, widget_id: Int, key: KeyCode, mods: ModifierKeys) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_key
    when Option::Some(callback) => callback(widget_id, key as Int, 1)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_text_input(&mut self, widget_id: Int, text: &String) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_change
    when Option::Some(callback) => callback(widget_id, text.clone())
    when Option::None => ()
    end
  when Option::None => ()
  end
end

# ═══════════════════════════════════════════════════════════════
# Layout Operations
# ═══════════════════════════════════════════════════════════════

def Application::add_child(&mut self, parent_id: Int, child_id: Int) -> Result[Unit, GuiError]
  match self.widgets.get_mut(parent_id)
  when Option::Some(parent) =>
    match self.widgets.get(child_id)
    when Option::Some(child) =>
      parent.children.push(child_id)
      Result::Ok(())
    when Option::None => Result::Err(GuiError::InvalidWidget)
    end
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::remove_child(&mut self, parent_id: Int, child_id: Int) -> Result[Unit, GuiError]
  match self.widgets.get_mut(parent_id)
  when Option::Some(parent) =>
    let mut found = false
    let mut i = 0
    while i < parent.children.len() do
      if parent.children[i] == child_id then
        parent.children.remove(i)
        found = true
        break
      end
      i = i + 1
    end
    if found then Result::Ok(()) else Result::Err(GuiError::InvalidWidget)
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::clear_children(&mut self, parent_id: Int) -> Result[Unit, GuiError]
  match self.widgets.get_mut(parent_id)
  when Option::Some(parent) =>
    parent.children.clear()
    Result::Ok(())
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::get_children(&mut self, parent_id: Int) -> Result[Vec[Int], GuiError]
  match self.widgets.get(parent_id)
  when Option::Some(parent) => Result::Ok(parent.children.clone())
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::set_window_root_widget(&mut self, window_id: Int, widget_id: Int) -> Result[Unit, GuiError]
  match self.windows.get_mut(window_id)
  when Option::Some(window) =>
    window.root_widget = widget_id
    Result::Ok(())
  when Option::None => Result::Err(GuiError::InvalidWindow)
  end
end

# ═══════════════════════════════════════════════════════════════
# Menu Operations
# ═══════════════════════════════════════════════════════════════

def Application::create_menu(&mut self) -> Result[Menu, GuiError]
  let id = self.next_id
  self.next_id = self.next_id + 1
  
  let menu = Menu {
    id: id,
    items: Vec::new()
  }
  
  self.menus.insert(id, menu.clone())
  Result::Ok(menu)
end

def Application::add_menu_item(&mut self, menu_id: Int, label: String, accelerator: Option[String]) -> Result[MenuItem, GuiError]
  match self.menus.get_mut(menu_id)
  when Option::Some(menu) =>
    let item_id = self.next_id
    self.next_id = self.next_id + 1
    
    let item = MenuItem {
      id: item_id,
      label: label,
      accelerator: accelerator,
      enabled: true,
      checked: false,
      submenu: Option::None
    }
    
    menu.items.push(item.clone())
    Result::Ok(item)
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::set_menu_bar(&mut self, window_id: Int, menu_id: Int) -> Result[Unit, GuiError]
  Result::Ok(())
end
