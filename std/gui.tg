def Application::set_widget_position(inout self, widget_id: Int, x: Float, y: Float) -> Result[Unit, GuiError]
  match self.widgets.get_mut(widget_id)
  when Option::Some(widget) =>
    widget.position = Position::new(x, y)
    Result::Ok(())
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::set_widget_size(inout self, widget_id: Int, width: Float, height: Float) -> Result[Unit, GuiError]
  match self.widgets.get_mut(widget_id)
  when Option::Some(widget) =>
    widget.size = Size::new(width, height)
    Result::Ok(())
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

