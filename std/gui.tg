# Tangerine Standard Library — std::gui
# Native GUI Toolkit - Cross-platform windowing and widgets
# Supports: Windows (Win32), macOS (Cocoa), Linux (GTK/X11), Android, iOS

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, Ptr, Float}
use std::collections::{Map}
use std::cocoa
use std::ffi::{CString}

# ═══════════════════════════════════════════════════════════════
# GUI Backend
# ═══════════════════════════════════════════════════════════════

enum GuiBackend
  Win32
  Cocoa
  GTK
  X11
  Wayland
  Android
  UIKit
end

# ═══════════════════════════════════════════════════════════════
# Widget Types
# ═══════════════════════════════════════════════════════════════

enum WidgetType
  Window
  Button
  Label
  TextField
  TextArea
  CheckBox
  RadioButton
  ComboBox
  ListView
  TreeView
  Slider
  ProgressBar
  ImageView
  Canvas
  Container
  ScrollView
  TabView
  MenuBar
  MenuItem
  Toolbar
end

# ═══════════════════════════════════════════════════════════════
# Layout Types
# ═══════════════════════════════════════════════════════════════

enum LayoutType
  Box
  Grid
  Flex
  Stack
  Border
  Absolute
end

enum BoxOrientation
  Horizontal
  Vertical
end

enum Alignment
  Start
  Center
  End
  Stretch
  SpaceBetween
  SpaceAround
