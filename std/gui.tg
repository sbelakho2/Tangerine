  position: Position
  size: Size
  min_size: Option[Size]
  max_size: Option[Size]
  fixed_size: Option[Size]
  background: Color
  foreground: Color
  border: Border
  shadow: Shadow
  opacity: Float
  visible: Bool
  enabled: Bool
  text: Option[String]
  tooltip: Option[String]
  icon: Option[Image]
  on_click: Option[fn(Int) -> Unit]
  on_hover: Option[fn(Int, Bool) -> Unit]
  on_focus: Option[fn(Int, Bool) -> Unit]
  on_key: Option[fn(Int, Int, Int) -> Unit]
  on_change: Option[fn(Int, String) -> Unit]
  native_handle: Ptr
end

struct WidgetId
