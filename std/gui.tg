def Application::set_button_text(inout self, widget_id: Int, text: String) -> Result[Unit, GuiError]
  self.set_widget_text(widget_id, text)
end

def Application::set_button_style(inout self, widget_id: Int, style: ButtonStyle) -> Result[Unit, GuiError]
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    if widget.widget_type != WidgetType::Button then
      return Result::Err(GuiError::Unsupported)
    end
  when Option::None => return Result::Err(GuiError::InvalidWidget)
  end
  match self.widget_states.get_mut(widget_id)
  when Option::Some(state) =>
    state.button_style = style
    Result::Ok(())
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::get_button_style(inout self, widget_id: Int) -> Result[ButtonStyle, GuiError]
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    if widget.widget_type != WidgetType::Button then
      return Result::Err(GuiError::Unsupported)
    end
  when Option::None => return Result::Err(GuiError::InvalidWidget)
  end
  match self.widget_states.get(widget_id)
  when Option::Some(state) => Result::Ok(state.button_style)
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

