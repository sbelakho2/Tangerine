# ═══════════════════════════════════════════════════════════════
# Size and Position
# ═══════════════════════════════════════════════════════════════

struct Size
  width: Float
  height: Float
end

struct Position
  x: Float
  y: Float
end

struct Rect
  x: Float
  y: Float
  width: Float
  height: Float
end

def Size::zero() -> Size
  Size { width: 0.0, height: 0.0 }
end

def Size::new(w: Float, h: Float) -> Size
  Size { width: w, height: h }
end

def Size::equals(self: &Size, other: &Size) -> Bool
  self.width == other.width && self.height == other.height
end

def Position::zero() -> Position
  Position { x: 0.0, y: 0.0 }
end

def Position::new(x: Float, y: Float) -> Position
  Position { x: x, y: y }
end

def Rect::new(x: Float, y: Float, w: Float, h: Float) -> Rect
  Rect { x: x, y: y, width: w, height: h }
end

def Rect::contains(self: &Rect, x: Float, y: Float) -> Bool
  x >= self.x && x <= self.x + self.width && y >= self.y && y <= self.y + self.height
end

# ═══════════════════════════════════════════════════════════════
# Color
# ═══════════════════════════════════════════════════════════════

struct Color
  r: Float
  g: Float
  b: Float
  a: Float
end

def Color::rgba(r: Float, g: Float, b: Float, a: Float) -> Color
  Color { r: r.clamp(0.0, 1.0), g: g.clamp(0.0, 1.0), b: b.clamp(0.0, 1.0), a: a.clamp(0.0, 1.0) }
end

def Color::rgb(r: Float, g: Float, b: Float) -> Color
  Color { r: r.clamp(0.0, 1.0), g: g.clamp(0.0, 1.0), b: b.clamp(0.0, 1.0), a: 1.0 }
end

def Color::from_hex(hex: String) -> Color
  let h = hex.trim_start_matches("#")
  if h.len() == 6 then
    Color::rgb(
      parse_hex_byte(&h[0..2]) / 255.0,
      parse_hex_byte(&h[2..4]) / 255.0,
      parse_hex_byte(&h[4..6]) / 255.0
    )
  elsif h.len() == 8 then
    Color::rgba(
      parse_hex_byte(&h[0..2]) / 255.0,
      parse_hex_byte(&h[2..4]) / 255.0,
      parse_hex_byte(&h[4..6]) / 255.0,
      parse_hex_byte(&h[6..8]) / 255.0
    )
  else
    Color::rgb(0.0, 0.0, 0.0)
  end
end

def parse_hex_byte(s: &String) -> Float
  let mut result = 0.0
  for ch in s.chars() do
    result = result * 16.0 + hex_char_to_val(ch)
  end
  result
end

def hex_char_to_val(ch: Char) -> Float
  if ch >= '0' && ch <= '9' then (ch as Int - 48) as Float
  elsif ch >= 'a' && ch <= 'f' then (ch as Int - 87) as Float
  elsif ch >= 'A' && ch <= 'F' then (ch as Int - 55) as Float
  else 0.0
  end
end

def Color::black() -> Color = Color::rgb(0.0, 0.0, 0.0)
def Color::white() -> Color = Color::rgb(1.0, 1.0, 1.0)
def Color::red() -> Color = Color::rgb(1.0, 0.0, 0.0)
def Color::green() -> Color = Color::rgb(0.0, 1.0, 0.0)
def Color::blue() -> Color = Color::rgb(0.0, 0.0, 1.0)
def Color::yellow() -> Color = Color::rgb(1.0, 1.0, 0.0)
def Color::cyan() -> Color = Color::rgb(0.0, 1.0, 1.0)
def Color::magenta() -> Color = Color::rgb(1.0, 0.0, 1.0)
def Color::gray() -> Color = Color::rgb(0.5, 0.5, 0.5)
def Color::dark_gray() -> Color = Color::rgb(0.25, 0.25, 0.25)
def Color::light_gray() -> Color = Color::rgb(0.75, 0.75, 0.75)
def Color::transparent() -> Color = Color::rgba(0.0, 0.0, 0.0, 0.0)

# ═══════════════════════════════════════════════════════════════
# Font
# ═══════════════════════════════════════════════════════════════

struct Font
  family: String
  size: Float
  weight: FontWeight
  style: FontStyle
end

enum FontWeight
  Thin
  ExtraLight
  Light
  Normal
  Medium
  SemiBold
  Bold
  ExtraBold
  Black
end

enum FontStyle
  Normal
  Italic
  Oblique
end

def Font::default() -> Font
  Font {
    family: "system".to_string(),
    size: 14.0,
    weight: FontWeight::Normal,
    style: FontStyle::Normal
  }
end

def Font::new(family: String, size: Float) -> Font
  Font {
    family: family,
    size: size,
    weight: FontWeight::Normal,
    style: FontStyle::Normal
  }
end

def Font::bold(family: String, size: Float) -> Font
  Font {
    family: family,
    size: size,
    weight: FontWeight::Bold,
    style: FontStyle::Normal
  }
end

def Font::italic(family: String, size: Float) -> Font
  Font {
    family: family,
    size: size,
    weight: FontWeight::Normal,
    style: FontStyle::Italic
  }
end

# ═══════════════════════════════════════════════════════════════
# Border and Shadow
# ═══════════════════════════════════════════════════════════════

struct Border
  width: Float
  color: Color
  radius: Float
end

def Border::none() -> Border
  Border { width: 0.0, color: Color::transparent(), radius: 0.0 }
end

def Border::new(width: Float, color: Color) -> Border
  Border { width: width, color: color, radius: 0.0 }
end

def Border::rounded(width: Float, color: Color, radius: Float) -> Border
  Border { width: width, color: color, radius: radius }
end

struct Shadow
  offset_x: Float
  offset_y: Float
  blur: Float
  spread: Float
  color: Color
end

def Shadow::none() -> Shadow
  Shadow { offset_x: 0.0, offset_y: 0.0, blur: 0.0, spread: 0.0, color: Color::transparent() }
end

def Shadow::new(x: Float, y: Float, blur: Float, color: Color) -> Shadow
  Shadow { offset_x: x, offset_y: y, blur: blur, spread: 0.0, color: color }
end

def Shadow::new_with_spread(x: Float, y: Float, blur: Float, spread: Float, color: Color) -> Shadow
  Shadow { offset_x: x, offset_y: y, blur: blur, spread: spread, color: color }
end

