# ═══════════════════════════════════════════════════════════════
# Event Handlers
# ═══════════════════════════════════════════════════════════════

def Application::handle_mouse_down(inout self, widget_id: Int, x: Float, y: Float) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_click
    when Option::Some(callback) => callback(widget_id)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_mouse_up(inout self, widget_id: Int, x: Float, y: Float) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_click
    when Option::Some(callback) => callback(widget_id)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_mouse_move(inout self, widget_id: Int, x: Float, y: Float) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_hover
    when Option::Some(callback) => callback(widget_id, true)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_key_down(inout self, widget_id: Int, key: KeyCode, mods: ModifierKeys) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_key
    when Option::Some(callback) => callback(widget_id, key as Int, 0)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_key_up(inout self, widget_id: Int, key: KeyCode, mods: ModifierKeys) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    match widget.on_key
    when Option::Some(callback) => callback(widget_id, key as Int, 1)
    when Option::None => ()
    end
  when Option::None => ()
  end
end

def Application::handle_text_input(inout self, widget_id: Int, text: String) -> Unit
  match self.widgets.get(widget_id)
  when Option::Some(widget) =>
    if widget.widget_type == WidgetType::TextField then
      match self.widget_states.get_mut(widget_id)
      when Option::Some(state) => state.text_value = text.clone()
      when Option::None => ()
      end
    end
    match widget.on_change
    when Option::Some(callback) => callback(widget_id, text.clone())
    when Option::None => ()
    end
  when Option::None => ()
  end
end

# ═══════════════════════════════════════════════════════════════
# Layout Operations
# ═══════════════════════════════════════════════════════════════

def Application::add_child(inout self, parent_id: Int, child_id: Int) -> Result[Unit, GuiError]
  match self.widgets.get_mut(parent_id)
  when Option::Some(parent) =>
    match self.widgets.get(child_id)
    when Option::Some(child) =>
      parent.children.push(child_id)
      Result::Ok(())
    when Option::None => Result::Err(GuiError::InvalidWidget)
    end
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::remove_child(inout self, parent_id: Int, child_id: Int) -> Result[Unit, GuiError]
  match self.widgets.get_mut(parent_id)
  when Option::Some(parent) =>
    let mut found = false
    let mut i = 0
    while i < parent.children.len() do
      if parent.children[i] == child_id then
        parent.children.remove(i)
        found = true
        break
      end
      i = i + 1
    end
    if found then Result::Ok(()) else Result::Err(GuiError::InvalidWidget)
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::clear_children(inout self, parent_id: Int) -> Result[Unit, GuiError]
  match self.widgets.get_mut(parent_id)
  when Option::Some(parent) =>
    parent.children.clear()
    Result::Ok(())
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::get_children(inout self, parent_id: Int) -> Result[Vec[Int], GuiError]
  match self.widgets.get(parent_id)
  when Option::Some(parent) => Result::Ok(parent.children.clone())
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::set_window_root_widget(inout self, window_id: Int, widget_id: Int) -> Result[Unit, GuiError]
  match self.windows.get_mut(window_id)
  when Option::Some(window) =>
    window.root_widget = widget_id
    Result::Ok(())
  when Option::None => Result::Err(GuiError::InvalidWindow)
  end
end

# ═══════════════════════════════════════════════════════════════
# Menu Operations
# ═══════════════════════════════════════════════════════════════

def Application::create_menu(inout self) -> Result[Menu, GuiError]
  let id = self.next_id
  self.next_id = self.next_id + 1
  
  let menu = Menu {
    id: id,
    items: Vec::new()
  }
  
  self.menus.insert(id, menu.clone())
  Result::Ok(menu)
end

def Application::add_menu_item(inout self, menu_id: Int, label: String, accelerator: Option[String]) -> Result[MenuItem, GuiError]
  match self.menus.get_mut(menu_id)
  when Option::Some(menu) =>
    let item_id = self.next_id
    self.next_id = self.next_id + 1
    
    let item = MenuItem {
      id: item_id,
      label: label,
      accelerator: accelerator,
      enabled: true,
      checked: false,
      submenu: Option::None
    }
    
    menu.items.push(item.clone())
    Result::Ok(item)
  when Option::None => Result::Err(GuiError::InvalidWidget)
  end
end

def Application::set_menu_bar(inout self, window_id: Int, menu_id: Int) -> Result[Unit, GuiError]
  match self.windows.get_mut(window_id)
  when Option::Some(window) =>
    match self.menus.get(menu_id)
    when Option::Some(_) =>
      window.menu_id = menu_id
      Result::Ok(())
    when Option::None => Result::Err(GuiError::InvalidMenu)
    end
  when Option::None => Result::Err(GuiError::InvalidWindow)
  end
end

# ═══════════════════════════════════════════════════════════════
# The software rendering backend (the CPU rasterizer)
# ═══════════════════════════════════════════════════════════════
# The renderer the Canvas widget surface lowers to when no native
# graphics backend is attached: a pure-CPU pixel-buffer rasterizer
# (clear / put_pixel / fill_rect / frame_rect / blit). The pixels are
# 0xRRGGBBAA words, row-major, row 0 at the top. The software backend is
# the always-available rendering path — the same surface every native
# backend (Win32/Cocoa/GTK/...) presents to the widget tree.

## The 0xRRGGBBAA color word.
def rgb(r: UInt, g: UInt, b: UInt) -> u32
  ((r & 0xFF) << 24) | ((g & 0xFF) << 16) | ((b & 0xFF) << 8) | 0xFF
end

## The software canvas: the CPU pixel buffer.
struct CanvasBuffer
  width: Int
  height: Int
  pixels: Vec[u32]
end

def CanvasBuffer::new(width: Int, height: Int) -> CanvasBuffer
  var pixels: Vec[u32] = Vec::new()
  var i = 0
  while i < width * height do
    pixels.push(0x00000000u32)
    i = i + 1
  end
  CanvasBuffer { width: width, height: height, pixels: pixels }
end

def CanvasBuffer::clear(inout self: CanvasBuffer, color: u32) -> Unit
  var i = 0
  while i < self.pixels.len() do
    self.pixels[i] = color
    i = i + 1
  end
  ()
end

def CanvasBuffer::put_pixel(inout self: CanvasBuffer, x: Int, y: Int, color: u32) -> Bool
  if x < 0 || y < 0 || x >= self.width || y >= self.height then
    return false
  end
  self.pixels[y * self.width + x] = color
  true
end

def CanvasBuffer::pixel_at(self: CanvasBuffer, x: Int, y: Int) -> u32
  if x < 0 || y < 0 || x >= self.width || y >= self.height then
    return 0u32
  end
  self.pixels[y * self.width + x]
end

## Fill an axis-aligned rectangle [x0, x1) x [y0, y1).
def CanvasBuffer::fill_rect(inout self: CanvasBuffer, x0: Int, y0: Int, x1: Int, y1: Int, color: u32) -> Unit
  var y = y0
  while y < y1 do
    var x = x0
    while x < x1 do
      let _ = self.put_pixel(x, y, color)
      x = x + 1
    end
    y = y + 1
  end
  ()
end

## Draw an axis-aligned rectangle outline.
def CanvasBuffer::frame_rect(inout self: CanvasBuffer, x0: Int, y0: Int, x1: Int, y1: Int, color: u32) -> Unit
  var x = x0
  while x < x1 do
    let _ = self.put_pixel(x, y0, color)
    let _ = self.put_pixel(x, y1 - 1, color)
    x = x + 1
  end
  var y = y0
  while y < y1 do
    let _ = self.put_pixel(x0, y, color)
    let _ = self.put_pixel(x1 - 1, y, color)
    y = y + 1
  end
  ()
end

## Blit a source canvas into this canvas at (dx, dy).
def CanvasBuffer::blit(inout self: CanvasBuffer, src: CanvasBuffer, dx: Int, dy: Int) -> Unit
  var sy = 0
  while sy < src.height do
    var sx = 0
    while sx < src.width do
      let color = src.pixel_at(sx, sy)
      if color != 0u32 then
        let _ = self.put_pixel(dx + sx, dy + sy, color)
      end
      sx = sx + 1
    end
    sy = sy + 1
  end
  ()
end
