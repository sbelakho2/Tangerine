# Tangerine Standard Library — tg::rand
# Random Number Generation

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, Float}

# [METADATA]
# module: tg::rand
# status: stable
# effects: [Random]
# capabilities: [random]

# ═══════════════════════════════════════════════════════════════
# FFI Declarations for System Random — exact ABI widths
# ═══════════════════════════════════════════════════════════════

# getrandom syscall (Linux) — size_t buflen (u64 on LP64), the C
# `unsigned int` flags (u32), and the ssize_t return (Int — 64-bit on
# the LP64 targets, so the -1 error check is exact).
@ffi("c")
extern def getrandom(buf: PtrMut[u8], buflen: UInt, flags: u32) -> Int
end

# /dev/urandom — the C `int` returns (open/close) declare the i32 form.
@ffi("c")
extern def open(path: Ptr[u8], flags: Int, mode: Int) -> i32
end

@ffi("c")
extern def read(fd: Int, buf: PtrMut[u8], count: UInt) -> Int
end

@ffi("c")
extern def close(fd: Int) -> i32
end

# ═══════════════════════════════════════════════════════════════
# System Entropy Source
# ═══════════════════════════════════════════════════════════════
# THE SHORT-READ / EINTR / ZERO-PROGRESS CONTRACT (the entropy closure):
# the getrandom syscall fills in bounded chunks and is interrupted like
# any syscall — a single call never guarantees the full request:
#   n > 0  -> the chunk advanced the buffer: offset += n, loop continues
#   n < 0  -> EINTR (the retryable transient): retry, bounded by
#             MAX_GETRANDOM_RETRIES so a persistent failure (e.g. a
#             platform without the syscall) can never spin forever
#   n == 0 -> ZERO PROGRESS: the ERROR, never a loop
# A persistent syscall failure falls back to /dev/urandom per the
# contract; a urandom zero-progress read is the error too (the
# offset += 0 spin is impossible).

# The thread-local errno accessor (libc): macOS/BSD expose __error(),
# Linux/Android expose __errno_location(). Both return a pointer to the
# calling thread's errno. The @cfg gates pick the symbol per target.
@cfg(any(target_os = "macos", target_os = "ios", target_os = "freebsd", target_os = "openbsd", target_os = "netbsd"))
@ffi("c")
extern def __error() -> PtrMut[i32]
end

@cfg(any(target_os = "linux", target_os = "android"))
@ffi("c")
extern def __errno_location() -> PtrMut[i32]
end

# EINTR (4) — the retryable transient of getrandom.
const EINTR: Int = 4

# The EINTR-retry bound: a persistent negative return (ENOSYS on a
# platform without the syscall, a wedged RNG, ...) retries this many
# times and then falls back per the contract.
const MAX_GETRANDOM_RETRIES: UInt = 8

def errno_is_eintr() -> Bool
  @cfg(any(target_os = "macos", target_os = "ios", target_os = "freebsd", target_os = "openbsd", target_os = "netbsd"))
  return unsafe "the thread-local errno read" do (*__error()) == EINTR end
  @cfg(any(target_os = "linux", target_os = "android"))
  return unsafe "the thread-local errno read" do (*__errno_location()) == EINTR end
  # The unknown platforms: no accessor — a negative return is treated as
  # the retryable transient (bounded) and falls back on persistence.
  return false
end

# THE FAULT-INJECTION HOOK (the deterministic entropy tests — Gate Y):
# when __tg_rand_fault_active is set, getrandom_syscall replays the
# queued outcomes instead of the real syscall — no real syscalls
# involved, deterministic on every platform. Each queue entry:
#   > 0  a short read of that many bytes (capped at the remaining
#        request)
#   -1   the injected EINTR (the entry is consumed WITHOUT advancing the
#        buffer — the retry shape is exercised)
#   -2   "the rest" (the full remaining request)
#   0    the injected zero-progress error
# The replayed "reads" fill the deterministic pattern (index + 1) % 256,
# so a test can prove the FULL initialization byte by byte.
mut __tg_rand_fault_active: Bool = false
mut __tg_rand_fault_seq: Vec[Int] = Vec::new()
mut __tg_rand_fault_next: UInt = 0

def __tg_rand_replay_fill(inout buf: [u8], start: UInt, count: UInt) -> Unit
  var i = start
  while i < start + count do
    buf[i] = ((i + 1) % 256) as u8
    i = i + 1
  end
end

def getrandom_syscall_replay(inout buf: [u8]) -> Result[Unit, String]
  mut offset: UInt = 0
  mut retries: UInt = 0
  while offset < buf.len() do
    if __tg_rand_fault_next >= __tg_rand_fault_seq.len() then
      return Result::Err("getrandom: the injected fault queue is exhausted".to_string())
    end
    let outcome = __tg_rand_fault_seq[__tg_rand_fault_next]
    __tg_rand_fault_next = __tg_rand_fault_next + 1
    if outcome > 0 then
      __tg_rand_replay_fill(buf, offset, outcome as UInt)
      offset = offset + (outcome as UInt)
      retries = 0
    elsif outcome == 0 then
      # The zero-progress error, never the loop.
      return Result::Err("getrandom: zero progress (injected)".to_string())
    elsif outcome == -2 then
      # "The rest": the full remaining request.
      __tg_rand_replay_fill(buf, offset, buf.len() - offset)
      offset = buf.len()
    else
      # The injected EINTR: retry, bounded exactly like the real path.
      retries = retries + 1
      if retries >= MAX_GETRANDOM_RETRIES then
        return Result::Err("getrandom: persistent failure (injected EINTR)".to_string())
      end
    end
  end
  Result::Ok(())
end

def getrandom_syscall(inout buf: [u8]) -> Result[Unit, String]
  if __tg_rand_fault_active then
    return getrandom_syscall_replay(buf)
  end
  mut offset: UInt = 0
  mut retries: UInt = 0
  while offset < buf.len() do
    let ret = getrandom(buf.as_mut_ptr().add(offset), (buf.len() - offset) as UInt, 0)
    if ret > 0 then
      # The short-read contract: n > 0 advances the offset; the loop
      # keeps filling from the next byte until the buffer is full.
      offset = offset + (ret as UInt)
      retries = 0
    elsif ret == 0 then
      # The zero-progress guard: a getrandom call that makes no progress
      # is the ERROR — never the offset += 0 spin.
      return Result::Err("getrandom: zero progress".to_string())
    else
      # ret < 0 — EINTR is the retryable transient: retry. A persistent
      # failure retries MAX_GETRANDOM_RETRIES times and falls back per
      # the contract (system_random_bytes -> /dev/urandom).
      if errno_is_eintr() then
        retries = retries + 1
        if retries >= MAX_GETRANDOM_RETRIES then
          return Result::Err("getrandom: persistent failure".to_string())
        end
      else
        return Result::Err("getrandom syscall failed".to_string())
      end
    end
  end
  Result::Ok(())
end

def read_urandom(inout buf: [u8]) -> Result[Unit, String]
  let path = "/dev/urandom"
  let fd = open(path.as_ptr(), 0, 0)  # O_RDONLY = 0
  if fd < 0 then
    return Result::Err("Failed to open /dev/urandom".to_string())
  end
  
  mut offset = 0
  while offset < buf.len() do
    let ret = read(fd, &mut buf[offset] as PtrMut[u8], (buf.len() - offset) as UInt)
    if ret < 0 then
      let _ = close(fd)
      return Result::Err("Failed to read from /dev/urandom".to_string())
    elsif ret == 0 then
      # The /dev/urandom zero-progress guard: EOF/zero-length reads must
      # never spin the offset += 0 loop — the error, not the loop.
      let _ = close(fd)
      return Result::Err("Failed to read from /dev/urandom: zero progress".to_string())
    end
    offset = offset + (ret as UInt)
  end
  
  let _ = close(fd)
  Result::Ok(())
end

# Try getrandom first, fall back to /dev/urandom
def system_random_bytes(inout buf: [u8]) -> Result[Unit, String]
  # Try getrandom first (Linux 3.17+): the offset loop inside
  # getrandom_syscall handles the short reads and the EINTR retries; a
  # persistent syscall failure falls back to /dev/urandom.
  match getrandom_syscall(buf)
  when Result::Ok(_) then Result::Ok(())
  when Result::Err(_) then read_urandom(buf)
  end
end

# ═══════════════════════════════════════════════════════════════
# OsRng - Operating System Random Generator
# ═══════════════════════════════════════════════════════════════

struct OsRng

def OsRng::new() -> Result[OsRng, String]
  # Verify we can read from system entropy source
  mut test: [u8; 1] = [0u8; 1]
  match system_random_bytes(&mut test)
  when Result::Ok(_) then Result::Ok(OsRng)
  when Result::Err(e) then Result::Err(e)
  end
end

def OsRng::fill_bytes(self: OsRng, inout buf: [u8]) -> Result[Unit, String]
  system_random_bytes(buf)
end

def OsRng::gen_u32(self: OsRng) -> Result[u32, String]
  mut bytes: [u8; 4] = [0u8; 4]
  match self.fill_bytes(&mut bytes)
  when Result::Ok(_) then
    let val = (bytes[0] as u32) |
              ((bytes[1] as u32) << 8) |
              ((bytes[2] as u32) << 16) |
              ((bytes[3] as u32) << 24)
    Result::Ok(val)
  when Result::Err(e) then Result::Err(e)
  end
end

def OsRng::gen_u64(self: OsRng) -> Result[u64, String]
  mut bytes: [u8; 8] = [0u8; 8]
  match self.fill_bytes(&mut bytes)
  when Result::Ok(_) then
    let val = (bytes[0] as u64) |
              ((bytes[1] as u64) << 8) |
              ((bytes[2] as u64) << 16) |
              ((bytes[3] as u64) << 24) |
              ((bytes[4] as u64) << 32) |
              ((bytes[5] as u64) << 40) |
              ((bytes[6] as u64) << 48) |
              ((bytes[7] as u64) << 56)
    Result::Ok(val)
  when Result::Err(e) then Result::Err(e)
  end
end

# ═══════════════════════════════════════════════════════════════
# THE PUBLISHED REFERENCE VECTORS (the seeded state → the exact
# sequence), pinned for every exported PRNG — the tests assert each one.
# ═══════════════════════════════════════════════════════════════

# Xoshiro256++ — the reference implementation (xoshiro256plusplus.c)
# with the state {1, 2, 3, 4}: the first ten next_u64 values, exactly as
# published by the reference test (the rand_xoshiro crate pins the same
# values against the reference implementation).
const XOSHIRO256PP_REF_VECTORS: [u64; 10] = [
  41943041u64,
  58720359u64,
  3588806011781223u64,
  3591011842654386u64,
  9228616714210784205u64,
  9973669472204895162u64,
  14011001112246962877u64,
  12406186145184390807u64,
  15849039046786891736u64,
  10450023813501588000u64
]

# ChaCha20 — the RFC 8439 zero block: the all-zero key, the all-zero
# nonce, the counter 0 (exactly the ChaCha20Rng::new([0u8; 32]) seeding
# shape). The first 64 keystream bytes are the published zero vector:
#   76b8e0ada0f13d90405d6ae55386bd28bdd219b8a08ded1aa836efcc8b770dc7
#   da41597c5157488d7724e03fb8d84a376a43b8f41518a11cc387b669b2ee6586
const CHACHA20_ZERO_BLOCK: [u8; 64] = [
  0x76, 0xB8, 0xE0, 0xAD, 0xA0, 0xF1, 0x3D, 0x90, 0x40, 0x5D, 0x6A, 0xE5, 0x53, 0x86, 0xBD, 0x28,
  0xBD, 0xD2, 0x19, 0xB8, 0xA0, 0x8D, 0xED, 0x1A, 0xA8, 0x36, 0xEF, 0xCC, 0x8B, 0x77, 0x0D, 0xC7,
  0xDA, 0x41, 0x59, 0x7C, 0x51, 0x57, 0x48, 0x8D, 0x77, 0x24, 0xE0, 0x3F, 0xB8, 0xD8, 0x4A, 0x37,
  0x6A, 0x43, 0xB8, 0xF4, 0x15, 0x18, 0xA1, 0x1C, 0xC3, 0x87, 0xB6, 0x69, 0xB2, 0xEE, 0x65, 0x86
]

# PCG32 — the pcg-basic reference algorithm (pcg32_random_r, the XSH-RR
# scrambler with the 6364136223846793005 multiplier) under the reference
# seeding shape of Pcg32::new(seed) — pcg32_srandom_r(state = seed,
# seq = seed): the first four outputs of Pcg32::new(42), as produced by
# the reference pcg-basic implementation for that seeding.
const PCG32_REF_VECTORS: [u32; 4] = [
  0x40B29785u32,
  0x0A8B3706u32,
  0x2F091207u32,
  0x646BAEF9u32
]

# ═══════════════════════════════════════════════════════════════
# Xoshiro256++ PRNG
# ═══════════════════════════════════════════════════════════════

struct Xoshiro256PlusPlus
  s: [u64; 4]
end

def Xoshiro256PlusPlus::new(seed: u64) -> Xoshiro256PlusPlus
  # Use SplitMix64 to initialize state from single seed
  mut state = seed
  mut rng = Xoshiro256PlusPlus { s: [0u64; 4] }
  
  mut i = 0
  while i < 4 do
    state = state.wrapping_add(0x9E3779B97F4A7C15u64)
    mut z = state
    z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9u64)
    z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EBu64)
    z = z ^ (z >> 31)
    rng.s[i] = z
    i = i + 1
  end
  
  rng
end

def Xoshiro256PlusPlus::from_entropy() -> Result[Xoshiro256PlusPlus, String]
  mut bytes: [u8; 32] = [0u8; 32]
  match system_random_bytes(&mut bytes)
  when Result::Ok(_) then
    mut seed: u64 = 0
    mut i = 0
    while i < 8 do
      seed = seed | ((bytes[i] as u64) << (i * 8))
      i = i + 1
    end
    Result::Ok(Xoshiro256PlusPlus::new(seed))
  when Result::Err(e) then Result::Err(e)
  end
end

def Xoshiro256PlusPlus::next_u64(inout self: Xoshiro256PlusPlus) -> u64
  # THE REFERENCE xoshiro256++ OUTPUT (the rotating_add formula removed):
  #   result = rotl(s0 + s3, 23) + s0
  # The state transition below is the reference transition (t = s1 << 17;
  # s2 ^= s0; s3 ^= s1; s1 ^= s2; s0 ^= s3; s2 ^= t; s3 = rotl(s3, 45)).
  # The published reference vectors (the reference implementation with
  # the state {1, 2, 3, 4}) are pinned by XOSHIRO256PP_REF_VECTORS.
  let result = (self.s[0].wrapping_add(self.s[3])).rotate_left(23).wrapping_add(self.s[0])

  let t = self.s[1] << 17

  self.s[2] = self.s[2] ^ self.s[0]
  self.s[3] = self.s[3] ^ self.s[1]
  self.s[1] = self.s[1] ^ self.s[2]
  self.s[0] = self.s[0] ^ self.s[3]

  self.s[2] = self.s[2] ^ t
  self.s[3] = self.s[3].rotate_left(45)

  result
end

def Xoshiro256PlusPlus::next_u32(inout self: Xoshiro256PlusPlus) -> u32
  (self.next_u64() >> 32) as u32
end

def Xoshiro256PlusPlus::next_u8(inout self: Xoshiro256PlusPlus) -> u8
  (self.next_u64() & 0xFF) as u8
end

def Xoshiro256PlusPlus::next_i64(inout self: Xoshiro256PlusPlus) -> i64
  self.next_u64() as i64
end

def Xoshiro256PlusPlus::next_i32(inout self: Xoshiro256PlusPlus) -> i32
  self.next_u32() as i32
end

def Xoshiro256PlusPlus::next_f64(inout self: Xoshiro256PlusPlus) -> f64
  # Convert to [0, 1) range
  let bits = self.next_u64()
  let mantissa = bits & 0x1FFFFFFFFFFFFFu64  # 53 bits
  (mantissa as f64) / (9007199254740992.0f64)  # 2^53
end

def Xoshiro256PlusPlus::next_f32(inout self: Xoshiro256PlusPlus) -> f32
  let bits = self.next_u32()
  let mantissa = bits & 0x7FFFFFu32  # 23 bits
  (mantissa as f32) / (8388608.0f32)  # 2^23
end

def Xoshiro256PlusPlus::next_bool(inout self: Xoshiro256PlusPlus) -> Bool
  (self.next_u64() & 1) == 1
end

def Xoshiro256PlusPlus::fill_bytes(inout self: Xoshiro256PlusPlus, inout buf: [u8]) -> Unit
  mut i = 0
  while i + 8 <= buf.len() do
    let val = self.next_u64()
    buf[i] = (val & 0xFF) as u8
    buf[i + 1] = ((val >> 8) & 0xFF) as u8
    buf[i + 2] = ((val >> 16) & 0xFF) as u8
    buf[i + 3] = ((val >> 24) & 0xFF) as u8
    buf[i + 4] = ((val >> 32) & 0xFF) as u8
    buf[i + 5] = ((val >> 40) & 0xFF) as u8
    buf[i + 6] = ((val >> 48) & 0xFF) as u8
    buf[i + 7] = ((val >> 56) & 0xFF) as u8
    i = i + 8
  end
  
  while i < buf.len() do
    buf[i] = self.next_u8()
    i = i + 1
  end
end

def Xoshiro256PlusPlus::gen_range(inout self: Xoshiro256PlusPlus, min: i64, max: i64) -> i64
  if min >= max then
    return min
  end
  
  let range = (max - min) as u64
  let val = self.next_u64() % range
  min + (val as i64)
end

def Xoshiro256PlusPlus::gen_range_u(inout self: Xoshiro256PlusPlus, min: u64, max: u64) -> u64
  if min >= max then
    return min
  end
  
  let range = max - min
  let val = self.next_u64() % range
  min + val
end

def Xoshiro256PlusPlus::gen_range_f(inout self: Xoshiro256PlusPlus, min: f64, max: f64) -> f64
  min + self.next_f64() * (max - min)
end

def Xoshiro256PlusPlus::jump(inout self: Xoshiro256PlusPlus) -> Unit
  # Jump constants for 2^128 calls
  let jump_table: [u64; 4] = [
    0x180EC6D33CFD0ABAu64,
    0xD5A61266F0C9392Cu64,
    0xA9582618E03FC9AAu64,
    0x39ABDC4529B1661Cu64
  ]
  
  mut s0 = 0u64
  mut s1 = 0u64
  mut s2 = 0u64
  mut s3 = 0u64
  
  mut i = 0
  while i < 4 do
    mut b = 0
    while b < 64 do
      if (jump_table[i] & (1u64 << b)) != 0 then
        s0 = s0 ^ self.s[0]
        s1 = s1 ^ self.s[1]
        s2 = s2 ^ self.s[2]
        s3 = s3 ^ self.s[3]
      end
      let _ = self.next_u64()
      b = b + 1
    end
    i = i + 1
  end
  
  self.s[0] = s0
  self.s[1] = s1
  self.s[2] = s2
  self.s[3] = s3
end

# ═══════════════════════════════════════════════════════════════
# ChaCha20 RNG (Cryptographically Secure)
# ═══════════════════════════════════════════════════════════════

struct ChaCha20Rng
  state: [u32; 16]
  buffer: [u8; 64]
  buffer_pos: u8
}

def ChaCha20Rng::new(seed: [u8; 32]) -> ChaCha20Rng
  mut rng = ChaCha20Rng {
    state: [0u32; 16],
    buffer: [0u8; 64],
    buffer_pos: 64
  }
  
  # Constants "expand 32-byte k"
  rng.state[0] = 0x61707865u32
  rng.state[1] = 0x3320646eu32
  rng.state[2] = 0x79622d32u32
  rng.state[3] = 0x6b206574u32
  
  # Key (256 bits)
  mut i = 0
  while i < 8 do
    rng.state[4 + i] = (seed[i * 4] as u32) |
                       ((seed[i * 4 + 1] as u32) << 8) |
                       ((seed[i * 4 + 2] as u32) << 16) |
                       ((seed[i * 4 + 3] as u32) << 24)
    i = i + 1
  end
  
  # Counter and nonce (set to 0)
  rng.state[12] = 0
  rng.state[13] = 0
  rng.state[14] = 0
  rng.state[15] = 0
  
  rng
end

def ChaCha20Rng::from_entropy() -> Result[ChaCha20Rng, String]
  mut seed: [u8; 32] = [0u8; 32]
  match system_random_bytes(&mut seed)
  when Result::Ok(_) then Result::Ok(ChaCha20Rng::new(seed))
  when Result::Err(e) then Result::Err(e)
  end
end

def ChaCha20Rng::quarter_round(inout a: u32, inout b: u32, inout c: u32, inout d: u32) -> Unit
  *a = a.wrapping_add(*b)
  *d = d ^ *a
  *d = d.rotate_left(16)
  
  *c = c.wrapping_add(*d)
  *b = b ^ *c
  *b = b.rotate_left(12)
  
  *a = a.wrapping_add(*b)
  *d = d ^ *a
  *d = d.rotate_left(8)
  
  *c = c.wrapping_add(*d)
  *b = b ^ *c
  *b = b.rotate_left(7)
end

def ChaCha20Rng::block(inout self: ChaCha20Rng) -> Unit
  mut working = self.state.clone()
  
  # 20 rounds (10 double rounds)
  mut i = 0
  while i < 10 do
    # Column rounds
    ChaCha20Rng::quarter_round(&mut working[0], &mut working[4], &mut working[8], &mut working[12])
    ChaCha20Rng::quarter_round(&mut working[1], &mut working[5], &mut working[9], &mut working[13])
    ChaCha20Rng::quarter_round(&mut working[2], &mut working[6], &mut working[10], &mut working[14])
    ChaCha20Rng::quarter_round(&mut working[3], &mut working[7], &mut working[11], &mut working[15])
    
    # Diagonal rounds
    ChaCha20Rng::quarter_round(&mut working[0], &mut working[5], &mut working[10], &mut working[15])
    ChaCha20Rng::quarter_round(&mut working[1], &mut working[6], &mut working[11], &mut working[12])
    ChaCha20Rng::quarter_round(&mut working[2], &mut working[7], &mut working[8], &mut working[13])
    ChaCha20Rng::quarter_round(&mut working[3], &mut working[4], &mut working[9], &mut working[14])
    
    i = i + 1
  end
  
  # Add original state
  i = 0
  while i < 16 do
    working[i] = working[i].wrapping_add(self.state[i])
    i = i + 1
  end
  
  # Convert to bytes (little-endian)
  i = 0
  while i < 16 do
    let val = working[i]
    let offset = i * 4
    self.buffer[offset] = (val & 0xFF) as u8
    self.buffer[offset + 1] = ((val >> 8) & 0xFF) as u8
    self.buffer[offset + 2] = ((val >> 16) & 0xFF) as u8
    self.buffer[offset + 3] = ((val >> 24) & 0xFF) as u8
    i = i + 1
  end
  
  # Increment counter
  self.state[12] = self.state[12].wrapping_add(1)
  if self.state[12] == 0 then
    self.state[13] = self.state[13].wrapping_add(1)
  end
  
  self.buffer_pos = 0
end

def ChaCha20Rng::next_u8(inout self: ChaCha20Rng) -> u8
  if self.buffer_pos >= 64 then
    self.block()
  end
  
  let val = self.buffer[self.buffer_pos as UInt]
  self.buffer_pos = self.buffer_pos + 1
  val
end

def ChaCha20Rng::next_u32(inout self: ChaCha20Rng) -> u32
  if self.buffer_pos > 60 then
    self.block()
  end
  
  let pos = self.buffer_pos as UInt
  let val = (self.buffer[pos] as u32) |
            ((self.buffer[pos + 1] as u32) << 8) |
            ((self.buffer[pos + 2] as u32) << 16) |
            ((self.buffer[pos + 3] as u32) << 24)
  self.buffer_pos = self.buffer_pos + 4
  val
end

def ChaCha20Rng::next_u64(inout self: ChaCha20Rng) -> u64
  if self.buffer_pos > 56 then
    self.block()
  end
  
  let pos = self.buffer_pos as UInt
  let val = (self.buffer[pos] as u64) |
            ((self.buffer[pos + 1] as u64) << 8) |
            ((self.buffer[pos + 2] as u64) << 16) |
            ((self.buffer[pos + 3] as u64) << 24) |
            ((self.buffer[pos + 4] as u64) << 32) |
            ((self.buffer[pos + 5] as u64) << 40) |
            ((self.buffer[pos + 6] as u64) << 48) |
            ((self.buffer[pos + 7] as u64) << 56)
  self.buffer_pos = self.buffer_pos + 8
  val
end

def ChaCha20Rng::fill_bytes(inout self: ChaCha20Rng, inout buf: [u8]) -> Unit
  mut i = 0
  while i < buf.len() do
    buf[i] = self.next_u8()
    i = i + 1
  end
end

# ═══════════════════════════════════════════════════════════════
# PCG (Permuted Congruential Generator)
# ═══════════════════════════════════════════════════════════════

struct Pcg32
  state: u64
  inc: u64
end

def Pcg32::new(seed: u64) -> Pcg32
  mut pcg = Pcg32 { state: 0, inc: (seed << 1) | 1 }
  let _ = pcg.next_u32()  # Initialize state
  pcg.state = pcg.state.wrapping_add(seed)
  let _ = pcg.next_u32()
  pcg
end

def Pcg32::from_entropy() -> Result[Pcg32, String]
  mut bytes: [u8; 8] = [0u8; 8]
  match system_random_bytes(&mut bytes)
  when Result::Ok(_) then
    mut seed: u64 = 0
    mut i = 0
    while i < 8 do
      seed = seed | ((bytes[i] as u64) << (i * 8))
      i = i + 1
    end
    Result::Ok(Pcg32::new(seed))
  when Result::Err(e) then Result::Err(e)
  end
end

def Pcg32::next_u32(inout self: Pcg32) -> u32
  let oldstate = self.state
  
  self.state = oldstate.wrapping_mul(6364136223846793005u64)
  self.state = self.state.wrapping_add(self.inc)
  
  # The reference XSH-RR output: the xorshifted value is truncated to
  # 32 bits BEFORE the rotate (the C reference's uint32_t assignment) —
  # the explicit parens pin that order.
  let xorshifted = ((((oldstate >> 18) ^ oldstate) >> 27)) as u32
  let rot = (oldstate >> 59) as u32
  
  xorshifted.rotate_right(rot)
end

def Pcg32::next_u64(inout self: Pcg32) -> u64
  (self.next_u32() as u64) | ((self.next_u32() as u64) << 32)
end

# ═══════════════════════════════════════════════════════════════
# Thread-Local RNG
# ═══════════════════════════════════════════════════════════════

use std::thread::LocalKey

def THREAD_RNG: LocalKey[Xoshiro256PlusPlus] = LocalKey::new()

def init_thread_rng() -> Unit
  match Xoshiro256PlusPlus::from_entropy()
  when Result::Ok(rng) then
    THREAD_RNG.set(rng)
  when Result::Err(_) then
    THREAD_RNG.set(Xoshiro256PlusPlus::new(12345))
  end
end

def random() -> f64
  THREAD_RNG.with_mut(|rng| rng.next_f64())
end

def random_u32() -> u32
  THREAD_RNG.with_mut(|rng| rng.next_u32())
end

def random_u64() -> u64
  THREAD_RNG.with_mut(|rng| rng.next_u64())
end

def random_i32() -> i32
  THREAD_RNG.with_mut(|rng| rng.next_i32())
end

def random_i64() -> i64
  THREAD_RNG.with_mut(|rng| rng.next_i64())
end

def random_bool() -> Bool
  THREAD_RNG.with_mut(|rng| rng.next_bool())
end

def random_range(min: i64, max: i64) -> i64
  THREAD_RNG.with_mut(|rng| rng.gen_range(min, max))
end

def random_range_f(min: f64, max: f64) -> f64
  THREAD_RNG.with_mut(|rng| rng.gen_range_f(min, max))
end

def random_bytes(inout buf: [u8]) -> Unit
  THREAD_RNG.with_mut(|rng| rng.fill_bytes(buf))
end

# ═══════════════════════════════════════════════════════════════
# Distributions
# ═══════════════════════════════════════════════════════════════

trait Distribution[T]
  def sample[R: Rng](self: Self, inout rng: R) -> T
end

# Uniform Distribution
struct Uniform[T]
  low: T
  high: T
end

def Uniform::new[T](low: T, high: T) -> Uniform[T]
  Uniform { low: low, high: high }
end

impl Distribution[i64] for Uniform[i64]
  def sample[R: Rng](self: Uniform[i64], inout rng: R) -> i64
    rng.gen_range(self.low, self.high)
  end
end

impl Distribution[u64] for Uniform[u64]
  def sample[R: Rng](self: Uniform[u64], inout rng: R) -> u64
    rng.gen_range_u(self.low, self.high)
  end
end

impl Distribution[f64] for Uniform[f64]
  def sample[R: Rng](self: Uniform[f64], inout rng: R) -> f64
    rng.gen_range_f(self.low, self.high)
  end
end

# Standard Normal Distribution (Box-Muller transform)
struct StandardNormal

impl Distribution[f64] for StandardNormal
  def sample[R: Rng](self: StandardNormal, inout rng: R) -> f64
    let u1 = rng.next_f64()
    let u2 = rng.next_f64()
    
    let r = (-2.0f64 * u1.ln()).sqrt()
    let theta = 2.0f64 * 3.14159265358979323846f64 * u2
    
    r * theta.cos()
  end
end

def random_normal() -> f64
  let mut rng = Xoshiro256PlusPlus::from_entropy().unwrap()
  StandardNormal.sample(&mut rng)
end

# Exponential Distribution
struct Exp
  lambda: f64
end

impl Distribution[f64] for Exp
  def sample[R: Rng](self: Exp, inout rng: R) -> f64
    -rng.next_f64().ln() / self.lambda
  end
end

# Bernoulli Distribution
struct Bernoulli
  p: f64
end

impl Distribution[Bool] for Bernoulli
  def sample[R: Rng](self: Bernoulli, inout rng: R) -> Bool
    rng.next_f64() < self.p
  end
end

# ═══════════════════════════════════════════════════════════════
# Rng Trait
# ═══════════════════════════════════════════════════════════════

trait Rng
  def next_u8(inout self: Self) -> u8
  def next_u32(inout self: Self) -> u32
  def next_u64(inout self: Self) -> u64
  def fill_bytes(inout self: Self, inout buf: [u8]) -> Unit
end

impl Rng for Xoshiro256PlusPlus
  def next_u8(inout self: Xoshiro256PlusPlus) -> u8
    Xoshiro256PlusPlus::next_u8(self)
  end
  
  def next_u32(inout self: Xoshiro256PlusPlus) -> u32
    Xoshiro256PlusPlus::next_u32(self)
  end
  
  def next_u64(inout self: Xoshiro256PlusPlus) -> u64
    Xoshiro256PlusPlus::next_u64(self)
  end
  
  def fill_bytes(inout self: Xoshiro256PlusPlus, inout buf: [u8]) -> Unit
    Xoshiro256PlusPlus::fill_bytes(self, buf)
  end
end

impl Rng for ChaCha20Rng
  def next_u8(inout self: ChaCha20Rng) -> u8
    ChaCha20Rng::next_u8(self)
  end
  
  def next_u32(inout self: ChaCha20Rng) -> u32
    ChaCha20Rng::next_u32(self)
  end
  
  def next_u64(inout self: ChaCha20Rng) -> u64
    ChaCha20Rng::next_u64(self)
  end
  
  def fill_bytes(inout self: ChaCha20Rng, inout buf: [u8]) -> Unit
    ChaCha20Rng::fill_bytes(self, buf)
  end
end

impl Rng for Pcg32
  def next_u8(inout self: Pcg32) -> u8
    (Pcg32::next_u32(self) & 0xFF) as u8
  end
  
  def next_u32(inout self: Pcg32) -> u32
    Pcg32::next_u32(self)
  end
  
  def next_u64(inout self: Pcg32) -> u64
    Pcg32::next_u64(self)
  end
  
  def fill_bytes(inout self: Pcg32, inout buf: [u8]) -> Unit
    mut i = 0
    while i < buf.len() do
      buf[i] = self.next_u8()
      i = i + 1
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Shuffle
# ═══════════════════════════════════════════════════════════════

def shuffle[T](inout vec: Vec[T], inout rng: impl Rng) -> Unit
  mut i = vec.len()
  while i > 1 do
    i = i - 1
    let j = (rng.next_u64() % (i + 1)) as UInt
    vec.swap(i, j)
  end
end

def sample[T](vec: Vec[T], n: UInt, inout rng: impl Rng) -> Vec[T]
  if n >= vec.len() then
    var out = Vec::new()
    for elem in vec do
      out.push(elem.clone())
    end
    return out
  end
  
  mut indices = Vec::with_capacity(n)
  mut i = 0
  while i < vec.len() do
    indices.push(i)
    i = i + 1
  end
  
  shuffle(&mut indices, rng)
  
  mut result = Vec::with_capacity(n)
  i = 0
  while i < n do
    result.push(vec[indices[i]].clone())
    i = i + 1
  end
  
  result
end

# ═══════════════════════════════════════════════════════════════
# SeedableRng Trait
# ═══════════════════════════════════════════════════════════════

trait SeedableRng: Rng
  type Seed
  
  def from_seed(seed: Self::Seed) -> Self
  def from_entropy() -> Result[Self, String]
end

# ═══════════════════════════════════════════════════════════════
# Helper Extensions
# ═══════════════════════════════════════════════════════════════

def u64.wrapping_add(self: u64, other: u64) -> u64
  let result = self + other
  result  # Overflow wraps naturally
end

def u64.wrapping_mul(self: u64, other: u64) -> u64
  self * other
end

def u64.rotate_left(self: u64, n: u32) -> u64
  (self << n) | (self >> (64 - n))
end

def u64.rotate_right(self: u32, n: u32) -> u32
  (self >> n) | (self << (32 - n))
end

def u32.wrapping_add(self: u32, other: u32) -> u32
  self + other
end

def u32.rotate_left(self: u32, n: u32) -> u32
  (self << n) | (self >> (32 - n))
end

def u32.rotate_right(self: u32, n: u32) -> u32
  (self >> n) | (self << (32 - n))
end