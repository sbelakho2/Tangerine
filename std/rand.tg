# Tangerine Standard Library — tg::rand
# Random Number Generation

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, Float}
use std::ffi::{c_int, c_uint, c_ulong, size_t, ssize_t}

# [METADATA]
# module: tg::rand
# status: stable
# effects: [Random]
# capabilities: [random]

# ═══════════════════════════════════════════════════════════════
# FFI Declarations for System Random
# ═══════════════════════════════════════════════════════════════

# getrandom syscall (Linux)
@ffi("c")
extern def getrandom(buf: &mut u8, buflen: size_t, flags: c_uint) -> ssize_t
end

# /dev/urandom
@ffi("c")
extern def open(path: &u8, flags: c_int, mode: c_int) -> c_int
end

@ffi("c")
extern def read(fd: c_int, buf: &mut u8, count: size_t) -> ssize_t
end

@ffi("c")
extern def close(fd: c_int) -> c_int
end

# ═══════════════════════════════════════════════════════════════
# System Entropy Source
# ═══════════════════════════════════════════════════════════════

def getrandom_syscall(buf: &mut [u8]) -> Result[Unit, String]
  let ret = getrandom(buf.as_mut_ptr(), buf.len() as size_t, 0)
  if ret < 0 then
    Result::Err("getrandom syscall failed".to_string())
  else
    Result::Ok(())
  end
end

def read_urandom(buf: &mut [u8]) -> Result[Unit, String]
  let path = "/dev/urandom"
  let fd = open(path.as_ptr(), 0, 0)  # O_RDONLY = 0
  if fd < 0 then
    return Result::Err("Failed to open /dev/urandom".to_string())
  end
  
  mut offset = 0
  while offset < buf.len() do
    let ret = read(fd, &mut buf[offset], (buf.len() - offset) as size_t)
    if ret < 0 then
      let _ = close(fd)
      return Result::Err("Failed to read from /dev/urandom".to_string())
    end
    offset = offset + (ret as UInt)
  end
  
  let _ = close(fd)
  Result::Ok(())
end

# Try getrandom first, fall back to /dev/urandom
def system_random_bytes(buf: &mut [u8]) -> Result[Unit, String]
  # Try getrandom first (Linux 3.17+)
  let ret = getrandom(buf.as_mut_ptr(), buf.len() as size_t, 0)
  if ret >= 0 then
    return Result::Ok(())
  end
  
  # Fallback to /dev/urandom
  read_urandom(buf)
end

# ═══════════════════════════════════════════════════════════════
# OsRng - Operating System Random Generator
# ═══════════════════════════════════════════════════════════════

struct OsRng

def OsRng::new() -> Result[OsRng, String]
  # Verify we can read from system entropy source
  mut test: [u8; 1] = [0u8; 1]
  match system_random_bytes(&mut test)
  when Result::Ok(_) then Result::Ok(OsRng)
  when Result::Err(e) then Result::Err(e)
  end
end

def OsRng::fill_bytes(self: &OsRng, buf: &mut [u8]) -> Result[Unit, String]
  system_random_bytes(buf)
end

def OsRng::gen_u32(self: &OsRng) -> Result[u32, String]
  mut bytes: [u8; 4] = [0u8; 4]
  match self.fill_bytes(&mut bytes)
  when Result::Ok(_) then
    let val = (bytes[0] as u32) |
              ((bytes[1] as u32) << 8) |
              ((bytes[2] as u32) << 16) |
              ((bytes[3] as u32) << 24)
    Result::Ok(val)
  when Result::Err(e) then Result::Err(e)
  end
end

def OsRng::gen_u64(self: &OsRng) -> Result[u64, String]
  mut bytes: [u8; 8] = [0u8; 8]
  match self.fill_bytes(&mut bytes)
  when Result::Ok(_) then
    let val = (bytes[0] as u64) |
              ((bytes[1] as u64) << 8) |
              ((bytes[2] as u64) << 16) |
              ((bytes[3] as u64) << 24) |
              ((bytes[4] as u64) << 32) |
              ((bytes[5] as u64) << 40) |
              ((bytes[6] as u64) << 48) |
              ((bytes[7] as u64) << 56)
    Result::Ok(val)
  when Result::Err(e) then Result::Err(e)
  end
end

# ═══════════════════════════════════════════════════════════════
# Xoshiro256++ PRNG
# ═══════════════════════════════════════════════════════════════

struct Xoshiro256PlusPlus
  s: [u64; 4]
end

def Xoshiro256PlusPlus::new(seed: u64) -> Xoshiro256PlusPlus
  # Use SplitMix64 to initialize state from single seed
  mut state = seed
  mut rng = Xoshiro256PlusPlus { s: [0u64; 4] }
  
  mut i = 0
  while i < 4 do
    state = state.wrapping_add(0x9E3779B97F4A7C15u64)
    mut z = state
    z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9u64)
    z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EBu64)
    z = z ^ (z >> 31)
    rng.s[i] = z
    i = i + 1
  end
  
  rng
end

def Xoshiro256PlusPlus::from_entropy() -> Result[Xoshiro256PlusPlus, String]
  mut bytes: [u8; 32] = [0u8; 32]
  match system_random_bytes(&mut bytes)
  when Result::Ok(_) then
    mut seed: u64 = 0
    mut i = 0
    while i < 8 do
      seed = seed | ((bytes[i] as u64) << (i * 8))
      i = i + 1
    end
    Result::Ok(Xoshiro256PlusPlus::new(seed))
  when Result::Err(e) then Result::Err(e)
  end
end

def Xoshiro256PlusPlus::next_u64(self: &mut Xoshiro256PlusPlus) -> u64
  let result = self.s[0].wrapping_add(self.s[3])
    .rotating_add(self.s[0].wrapping_mul(5))
    .wrapping_mul(9)
  
  let t = self.s[1] << 17
  
  self.s[2] = self.s[2] ^ self.s[0]
  self.s[3] = self.s[3] ^ self.s[1]
  self.s[1] = self.s[1] ^ self.s[2]
  self.s[0] = self.s[0] ^ self.s[3]
  
  self.s[2] = self.s[2] ^ t
  self.s[3] = self.s[3].rotate_left(45)
  
  result
end

def Xoshiro256PlusPlus::next_u32(self: &mut Xoshiro256PlusPlus) -> u32
  (self.next_u64() >> 32) as u32
end

def Xoshiro256PlusPlus::next_u8(self: &mut Xoshiro256PlusPlus) -> u8
  (self.next_u64() & 0xFF) as u8
end

def Xoshiro256PlusPlus::next_i64(self: &mut Xoshiro256PlusPlus) -> i64
  self.next_u64() as i64
end

def Xoshiro256PlusPlus::next_i32(self: &mut Xoshiro256PlusPlus) -> i32
  self.next_u32() as i32
end

def Xoshiro256PlusPlus::next_f64(self: &mut Xoshiro256PlusPlus) -> f64
  # Convert to [0, 1) range
  let bits = self.next_u64()
  let mantissa = bits & 0x1FFFFFFFFFFFFFu64  # 53 bits
  (mantissa as f64) / (9007199254740992.0f64)  # 2^53
end

def Xoshiro256PlusPlus::next_f32(self: &mut Xoshiro256PlusPlus) -> f32
  let bits = self.next_u32()
  let mantissa = bits & 0x7FFFFFu32  # 23 bits
  (mantissa as f32) / (8388608.0f32)  # 2^23
end

def Xoshiro256PlusPlus::next_bool(self: &mut Xoshiro256PlusPlus) -> Bool
  (self.next_u64() & 1) == 1
end

def Xoshiro256PlusPlus::fill_bytes(self: &mut Xoshiro256PlusPlus, buf: &mut [u8]) -> Unit
  mut i = 0
  while i + 8 <= buf.len() do
    let val = self.next_u64()
    buf[i] = (val & 0xFF) as u8
    buf[i + 1] = ((val >> 8) & 0xFF) as u8
    buf[i + 2] = ((val >> 16) & 0xFF) as u8
    buf[i + 3] = ((val >> 24) & 0xFF) as u8
    buf[i + 4] = ((val >> 32) & 0xFF) as u8
    buf[i + 5] = ((val >> 40) & 0xFF) as u8
    buf[i + 6] = ((val >> 48) & 0xFF) as u8
    buf[i + 7] = ((val >> 56) & 0xFF) as u8
    i = i + 8
  end
  
  while i < buf.len() do
    buf[i] = self.next_u8()
    i = i + 1
  end
end

def Xoshiro256PlusPlus::gen_range(self: &mut Xoshiro256PlusPlus, min: i64, max: i64) -> i64
  if min >= max then
    return min
  end
  
  let range = (max - min) as u64
  let val = self.next_u64() % range
  min + (val as i64)
end

def Xoshiro256PlusPlus::gen_range_u(self: &mut Xoshiro256PlusPlus, min: u64, max: u64) -> u64
  if min >= max then
    return min
  end
  
  let range = max - min
  let val = self.next_u64() % range
  min + val
end

def Xoshiro256PlusPlus::gen_range_f(self: &mut Xoshiro256PlusPlus, min: f64, max: f64) -> f64
  min + self.next_f64() * (max - min)
end

def Xoshiro256PlusPlus::jump(self: &mut Xoshiro256PlusPlus) -> Unit
  # Jump constants for 2^128 calls
  let jump_table: [u64; 4] = [
    0x180EC6D33CFD0ABAu64,
    0xD5A61266F0C9392Cu64,
    0xA9582618E03FC9AAu64,
    0x39ABDC4529B1661Cu64
  ]
  
  mut s0 = 0u64
  mut s1 = 0u64
  mut s2 = 0u64
  mut s3 = 0u64
  
  mut i = 0
  while i < 4 do
    mut b = 0
    while b < 64 do
      if (jump_table[i] & (1u64 << b)) != 0 then
        s0 = s0 ^ self.s[0]
        s1 = s1 ^ self.s[1]
        s2 = s2 ^ self.s[2]
        s3 = s3 ^ self.s[3]
      end
      let _ = self.next_u64()
      b = b + 1
    end
    i = i + 1
  end
  
  self.s[0] = s0
  self.s[1] = s1
  self.s[2] = s2
  self.s[3] = s3
end

# ═══════════════════════════════════════════════════════════════
# ChaCha20 RNG (Cryptographically Secure)
# ═══════════════════════════════════════════════════════════════

struct ChaCha20Rng
  state: [u32; 16]
  buffer: [u8; 64]
  buffer_pos: u8
}

def ChaCha20Rng::new(seed: [u8; 32]) -> ChaCha20Rng
  mut rng = ChaCha20Rng {
    state: [0u32; 16],
    buffer: [0u8; 64],
    buffer_pos: 64
  }
  
  # Constants "expand 32-byte k"
  rng.state[0] = 0x61707865u32
  rng.state[1] = 0x3320646eu32
  rng.state[2] = 0x79622d32u32
  rng.state[3] = 0x6b206574u32
  
  # Key (256 bits)
  mut i = 0
  while i < 8 do
    rng.state[4 + i] = (seed[i * 4] as u32) |
                       ((seed[i * 4 + 1] as u32) << 8) |
                       ((seed[i * 4 + 2] as u32) << 16) |
                       ((seed[i * 4 + 3] as u32) << 24)
    i = i + 1
  end
  
  # Counter and nonce (set to 0)
  rng.state[12] = 0
  rng.state[13] = 0
  rng.state[14] = 0
  rng.state[15] = 0
  
  rng
end

def ChaCha20Rng::from_entropy() -> Result[ChaCha20Rng, String]
  mut seed: [u8; 32] = [0u8; 32]
  match system_random_bytes(&mut seed)
  when Result::Ok(_) then Result::Ok(ChaCha20Rng::new(seed))
  when Result::Err(e) then Result::Err(e)
  end
end

def ChaCha20Rng::quarter_round(a: &mut u32, b: &mut u32, c: &mut u32, d: &mut u32) -> Unit
  *a = a.wrapping_add(*b)
  *d = d ^ *a
  *d = d.rotate_left(16)
  
  *c = c.wrapping_add(*d)
  *b = b ^ *c
  *b = b.rotate_left(12)
  
  *a = a.wrapping_add(*b)
  *d = d ^ *a
  *d = d.rotate_left(8)
  
  *c = c.wrapping_add(*d)
  *b = b ^ *c
  *b = b.rotate_left(7)
end

def ChaCha20Rng::block(self: &mut ChaCha20Rng) -> Unit
  mut working = self.state.clone()
  
  # 20 rounds (10 double rounds)
  mut i = 0
  while i < 10 do
    # Column rounds
    ChaCha20Rng::quarter_round(&mut working[0], &mut working[4], &mut working[8], &mut working[12])
    ChaCha20Rng::quarter_round(&mut working[1], &mut working[5], &mut working[9], &mut working[13])
    ChaCha20Rng::quarter_round(&mut working[2], &mut working[6], &mut working[10], &mut working[14])
    ChaCha20Rng::quarter_round(&mut working[3], &mut working[7], &mut working[11], &mut working[15])
    
    # Diagonal rounds
    ChaCha20Rng::quarter_round(&mut working[0], &mut working[5], &mut working[10], &mut working[15])
    ChaCha20Rng::quarter_round(&mut working[1], &mut working[6], &mut working[11], &mut working[12])
    ChaCha20Rng::quarter_round(&mut working[2], &mut working[7], &mut working[8], &mut working[13])
    ChaCha20Rng::quarter_round(&mut working[3], &mut working[4], &mut working[9], &mut working[14])
    
    i = i + 1
  end
  
  # Add original state
  i = 0
  while i < 16 do
    working[i] = working[i].wrapping_add(self.state[i])
    i = i + 1
  end
  
  # Convert to bytes (little-endian)
  i = 0
  while i < 16 do
    let val = working[i]
    let offset = i * 4
    self.buffer[offset] = (val & 0xFF) as u8
    self.buffer[offset + 1] = ((val >> 8) & 0xFF) as u8
    self.buffer[offset + 2] = ((val >> 16) & 0xFF) as u8
    self.buffer[offset + 3] = ((val >> 24) & 0xFF) as u8
    i = i + 1
  end
  
  # Increment counter
  self.state[12] = self.state[12].wrapping_add(1)
  if self.state[12] == 0 then
    self.state[13] = self.state[13].wrapping_add(1)
  end
  
  self.buffer_pos = 0
end

def ChaCha20Rng::next_u8(self: &mut ChaCha20Rng) -> u8
  if self.buffer_pos >= 64 then
    self.block()
  end
  
  let val = self.buffer[self.buffer_pos as UInt]
  self.buffer_pos = self.buffer_pos + 1
  val
end

def ChaCha20Rng::next_u32(self: &mut ChaCha20Rng) -> u32
  if self.buffer_pos > 60 then
    self.block()
  end
  
  let pos = self.buffer_pos as UInt
  let val = (self.buffer[pos] as u32) |
            ((self.buffer[pos + 1] as u32) << 8) |
            ((self.buffer[pos + 2] as u32) << 16) |
            ((self.buffer[pos + 3] as u32) << 24)
  self.buffer_pos = self.buffer_pos + 4
  val
end

def ChaCha20Rng::next_u64(self: &mut ChaCha20Rng) -> u64
  if self.buffer_pos > 56 then
    self.block()
  end
  
  let pos = self.buffer_pos as UInt
  let val = (self.buffer[pos] as u64) |
            ((self.buffer[pos + 1] as u64) << 8) |
            ((self.buffer[pos + 2] as u64) << 16) |
            ((self.buffer[pos + 3] as u64) << 24) |
            ((self.buffer[pos + 4] as u64) << 32) |
            ((self.buffer[pos + 5] as u64) << 40) |
            ((self.buffer[pos + 6] as u64) << 48) |
            ((self.buffer[pos + 7] as u64) << 56)
  self.buffer_pos = self.buffer_pos + 8
  val
end

def ChaCha20Rng::fill_bytes(self: &mut ChaCha20Rng, buf: &mut [u8]) -> Unit
  mut i = 0
  while i < buf.len() do
    buf[i] = self.next_u8()
    i = i + 1
  end
end

# ═══════════════════════════════════════════════════════════════
# PCG (Permuted Congruential Generator)
# ═══════════════════════════════════════════════════════════════

struct Pcg32
  state: u64
  inc: u64
end

def Pcg32::new(seed: u64) -> Pcg32
  mut pcg = Pcg32 { state: 0, inc: (seed << 1) | 1 }
  let _ = pcg.next_u32()  # Initialize state
  pcg.state = pcg.state.wrapping_add(seed)
  let _ = pcg.next_u32()
  pcg
end

def Pcg32::from_entropy() -> Result[Pcg32, String]
  mut bytes: [u8; 8] = [0u8; 8]
  match system_random_bytes(&mut bytes)
  when Result::Ok(_) then
    mut seed: u64 = 0
    mut i = 0
    while i < 8 do
      seed = seed | ((bytes[i] as u64) << (i * 8))
      i = i + 1
    end
    Result::Ok(Pcg32::new(seed))
  when Result::Err(e) then Result::Err(e)
  end
end

def Pcg32::next_u32(self: &mut Pcg32) -> u32
  let oldstate = self.state
  
  self.state = oldstate.wrapping_mul(6364136223846793005u64)
  self.state = self.state.wrapping_add(self.inc)
  
  let xorshifted = ((oldstate >> 18) ^ oldstate) >> 27 as u32
  let rot = (oldstate >> 59) as u32
  
  xorshifted.rotate_right(rot)
end

def Pcg32::next_u64(self: &mut Pcg32) -> u64
  (self.next_u32() as u64) | ((self.next_u32() as u64) << 32)
end

# ═══════════════════════════════════════════════════════════════
# Thread-Local RNG
# ═══════════════════════════════════════════════════════════════

use std::thread::LocalKey

def THREAD_RNG: LocalKey<Xoshiro256PlusPlus> = LocalKey::new()

def init_thread_rng() -> Unit
  match Xoshiro256PlusPlus::from_entropy()
  when Result::Ok(rng) then
    THREAD_RNG.set(rng)
  when Result::Err(_) then
    THREAD_RNG.set(Xoshiro256PlusPlus::new(12345))
  end
end

def random() -> f64
  THREAD_RNG.with_mut(|rng| rng.next_f64())
end

def random_u32() -> u32
  THREAD_RNG.with_mut(|rng| rng.next_u32())
end

def random_u64() -> u64
  THREAD_RNG.with_mut(|rng| rng.next_u64())
end

def random_i32() -> i32
  THREAD_RNG.with_mut(|rng| rng.next_i32())
end

def random_i64() -> i64
  THREAD_RNG.with_mut(|rng| rng.next_i64())
end

def random_bool() -> Bool
  THREAD_RNG.with_mut(|rng| rng.next_bool())
end

def random_range(min: i64, max: i64) -> i64
  THREAD_RNG.with_mut(|rng| rng.gen_range(min, max))
end

def random_range_f(min: f64, max: f64) -> f64
  THREAD_RNG.with_mut(|rng| rng.gen_range_f(min, max))
end

def random_bytes(buf: &mut [u8]) -> Unit
  THREAD_RNG.with_mut(|rng| rng.fill_bytes(buf))
end

# ═══════════════════════════════════════════════════════════════
# Distributions
# ═══════════════════════════════════════════════════════════════

trait Distribution[T]
  def sample[R: Rng](self: &Self, rng: &mut R) -> T
end

# Uniform Distribution
struct Uniform<T>
  low: T
  high: T
end

def Uniform::new<T>(low: T, high: T) -> Uniform<T>
  Uniform { low: low, high: high }
end

impl Distribution[i64] for Uniform<i64>
  def sample[R: Rng](self: &Uniform<i64>, rng: &mut R) -> i64
    rng.gen_range(self.low, self.high)
  end
end

impl Distribution[u64] for Uniform<u64>
  def sample[R: Rng](self: &Uniform<u64>, rng: &mut R) -> u64
    rng.gen_range_u(self.low, self.high)
  end
end

impl Distribution[f64] for Uniform<f64>
  def sample[R: Rng](self: &Uniform<f64>, rng: &mut R) -> f64
    rng.gen_range_f(self.low, self.high)
  end
end

# Standard Normal Distribution (Box-Muller transform)
struct StandardNormal

impl Distribution[f64] for StandardNormal
  def sample[R: Rng](self: &StandardNormal, rng: &mut R) -> f64
    let u1 = rng.next_f64()
    let u2 = rng.next_f64()
    
    let r = (-2.0f64 * u1.ln()).sqrt()
    let theta = 2.0f64 * 3.14159265358979323846f64 * u2
    
    r * theta.cos()
  end
end

def random_normal() -> f64
  let mut rng = Xoshiro256PlusPlus::from_entropy().unwrap()
  StandardNormal.sample(&mut rng)
end

# Exponential Distribution
struct Exp
  lambda: f64
end

impl Distribution[f64] for Exp
  def sample[R: Rng](self: &Exp, rng: &mut R) -> f64
    -rng.next_f64().ln() / self.lambda
  end
end

# Bernoulli Distribution
struct Bernoulli
  p: f64
end

impl Distribution[Bool] for Bernoulli
  def sample[R: Rng](self: &Bernoulli, rng: &mut R) -> Bool
    rng.next_f64() < self.p
  end
end

# ═══════════════════════════════════════════════════════════════
# Rng Trait
# ═══════════════════════════════════════════════════════════════

trait Rng
  def next_u8(self: &mut Self) -> u8
  def next_u32(self: &mut Self) -> u32
  def next_u64(self: &mut Self) -> u64
  def fill_bytes(self: &mut Self, buf: &mut [u8]) -> Unit
end

impl Rng for Xoshiro256PlusPlus
  def next_u8(self: &mut Xoshiro256PlusPlus) -> u8
    Xoshiro256PlusPlus::next_u8(self)
  end
  
  def next_u32(self: &mut Xoshiro256PlusPlus) -> u32
    Xoshiro256PlusPlus::next_u32(self)
  end
  
  def next_u64(self: &mut Xoshiro256PlusPlus) -> u64
    Xoshiro256PlusPlus::next_u64(self)
  end
  
  def fill_bytes(self: &mut Xoshiro256PlusPlus, buf: &mut [u8]) -> Unit
    Xoshiro256PlusPlus::fill_bytes(self, buf)
  end
end

impl Rng for ChaCha20Rng
  def next_u8(self: &mut ChaCha20Rng) -> u8
    ChaCha20Rng::next_u8(self)
  end
  
  def next_u32(self: &mut ChaCha20Rng) -> u32
    ChaCha20Rng::next_u32(self)
  end
  
  def next_u64(self: &mut ChaCha20Rng) -> u64
    ChaCha20Rng::next_u64(self)
  end
  
  def fill_bytes(self: &mut ChaCha20Rng, buf: &mut [u8]) -> Unit
    ChaCha20Rng::fill_bytes(self, buf)
  end
end

impl Rng for Pcg32
  def next_u8(self: &mut Pcg32) -> u8
    (Pcg32::next_u32(self) & 0xFF) as u8
  end
  
  def next_u32(self: &mut Pcg32) -> u32
    Pcg32::next_u32(self)
  end
  
  def next_u64(self: &mut Pcg32) -> u64
    Pcg32::next_u64(self)
  end
  
  def fill_bytes(self: &mut Pcg32, buf: &mut [u8]) -> Unit
    mut i = 0
    while i < buf.len() do
      buf[i] = self.next_u8()
      i = i + 1
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Shuffle
# ═══════════════════════════════════════════════════════════════

def shuffle[T](vec: &mut Vec[T], rng: &mut impl Rng) -> Unit
  mut i = vec.len()
  while i > 1 do
    i = i - 1
    let j = (rng.next_u64() % (i + 1)) as UInt
    vec.swap(i, j)
  end
end

def sample[T](vec: &Vec[T], n: UInt, rng: &mut impl Rng) -> Vec[T]
  if n >= vec.len() then
    return vec.clone()
  end
  
  mut indices = Vec::with_capacity(n)
  mut i = 0
  while i < vec.len() do
    indices.push(i)
    i = i + 1
  end
  
  shuffle(&mut indices, rng)
  
  mut result = Vec::with_capacity(n)
  i = 0
  while i < n do
    result.push(vec[indices[i]].clone())
    i = i + 1
  end
  
  result
end

# ═══════════════════════════════════════════════════════════════
# SeedableRng Trait
# ═══════════════════════════════════════════════════════════════

trait SeedableRng: Rng
  type Seed
  
  def from_seed(seed: Self::Seed) -> Self
  def from_entropy() -> Result[Self, String]
end

# ═══════════════════════════════════════════════════════════════
# Helper Extensions
# ═══════════════════════════════════════════════════════════════

def u64.wrapping_add(self: u64, other: u64) -> u64
  let result = self + other
  result  # Overflow wraps naturally
end

def u64.wrapping_mul(self: u64, other: u64) -> u64
  self * other
end

def u64.rotate_left(self: u64, n: u32) -> u64
  (self << n) | (self >> (64 - n))
end

def u64.rotate_right(self: u32, n: u32) -> u32
  (self >> n) | (self << (32 - n))
end

def u32.wrapping_add(self: u32, other: u32) -> u32
  self + other
end

def u32.rotate_left(self: u32, n: u32) -> u32
  (self << n) | (self >> (32 - n))
end

def u32.rotate_right(self: u32, n: u32) -> u32
  (self >> n) | (self << (32 - n))
end