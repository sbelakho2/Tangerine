## Tangerine Standard Library — std::collections
## Array, Map, Set, Iterator traits

use std::core::{Option, Result, panic}
use std::alloc::{ArcStrong, ArcInnerWeak, alloc, alloc_array, dealloc_array, ptr_copy}

# ———————————————————————————————————————————————————————————————
# THE SAFE VIEW MODEL (DECIDED — the reviewer's shared/pinned backing;
# ONE representation, ONE semantic authority: the SOURCE-spelled Slice[T]
# IS the shared/pinned form; the raw {ptr,len} view is ONLY the explicit
# UnsafeSlice — unsafe/FFI-only)
# ———————————————————————————————————————————————————————————————
# THE SAFE SLICE = THE SOURCE-SPELLED SLICE (declared below as the
# SHARED/PINNED form):
#     SliceBacking[T] = { ptr: Ptr[T], len: UInt, offset: UInt }
#                       — the PINNED BACKING: the pinned buffer (ptr) plus
#                         the view window's offset/len. The backing owns a
#                         pinned allocation that holds the window's
#                         elements, so the backing ITSELF keeps the
#                         underlying storage alive.
#     Slice[T] (declared below) =
#         { inner: Arc[SliceBacking[T]] }  — the Arc-CLASS {ptr,len}:
#         one pointer-sized Arc handle to the pinned backing record.
#
#   owns    = true    — the view shares the backing through the Arc: the
#                       backing (and its pinned buffer) stays alive exactly
#                       as long as ANY view of it lives. The view SURVIVES
#                       the original owner's drop, and the owner's
#                       capacity-changing mutations NEVER move it — the
#                       backing is the separate pinned allocation (the
#                       mutation allocates a fresh pinned backing for the
#                       new buffer; the views keep the old one alive).
#   drop    = the Arc's drop — the backing's deinit releases the pinned
#             allocation when the last Arc dies. The view is an ordinary
#             OWNING value in the resource checker: no escape tracking,
#             no access-scoping, no "eventual mechanism" — it can be
#             returned, stored in fields/containers, captured, and outlive
#             its source.
#   bit copy= no      — the Arc handle is NOT bit-copyable; the shared
#                       view is moved/cloned (Arc::clone).
#   layout  = the safe Slice is 8 bytes: { inner: Arc @ 0 } — the
#             Arc-class handle. The backing record is 24 bytes:
#             { ptr @ 0, len @ 8, offset @ 16 }.
#
# THE RAW VIEW = UnsafeSlice[T] (the compiler's builtin — the registered
# Opaque generic, the LangItems slice id):
#     UnsafeSlice[T] = { ptr: Ptr[T], len: UInt } — the 16-byte borrowed
#     {ptr,len} fat value. owns=false, drop=none, bit-copyable. It is the
#     FFI/unsafe-only form: SAFE CODE CANNOT PRODUCE IT (no safe API
#     returns it in an escaping position; the opaque builtin cannot be
#     constructed). Its ESCAPES are the P0-SL-rejected cases — the
#     checker rejects a raw view returned from a function, stored into
#     longer-lived state (fields/containers/statics/consts), or captured
#     into an escaping closure, and rejects mutating/reallocating the
#     backing buffer while a raw view of it is live (the registry + the
#     IterationPlan mutation scan). The only raw views safe code ever
#     sees are the compiler-scoped LOOP-CONSUMED iterable forms
#     (chars/bytes/split/iter/keys/values — consumed by the enclosing
#     for-loop, never storable) and the compiler-manufactured literal
#     coercion behind vec!.
#
# The safe APIs return the SHARED form (Vec::as_slice, String::as_str_view);
# the FFI surfaces use the raw form (FfiSlice in std::ffi — mmap/embedded
# as_slice). The conversions are explicit: the pin operations
# (slice_pin / str_view_pin) copy the window into the pinned backing.
# ———————————————————————————————————————————————————————————————
# SliceMut[T] — the MUTABLE io-scoped view { ptr: PtrMut[T], len: UInt } —
# the systems-Read buffer contract (std::io)
# ———————————————————————————————————————————————————————————————
# SliceMut is the raw mutable buffer form: a non-owning 16-byte
# {ptr @ 0, len @ 8} fat value whose `len` UNAMBIGUOUSLY denotes the
# WRITABLE EXTENT — the number of elements the receiver may fill. The
# Read trait is
#     trait Read
#       def read(inout self: Self, buf: SliceMut[u8]) -> Result[Int, IOError]
#     end
# and every implementor requests exactly buf.len bytes — the buffered
# TCP read can never request zero bytes after a clear, because the
# view onto the buffer's capacity is the writable extent.
#
#   owns    = false   — the io view holds NO memory; it is the raw
#                       mutable buffer projection of the io layer
#                       (borrowed for the duration of the call — the io
#                       views never outlive their backing Vec).
#   drop    = none    — the {ptr,len} words are bit-copyable; no
#                       destructor, no clone.
#   len     = the writable extent in ELEMENTS (UInt). There is no
#             capacity field: capacity is the backing Vec's property,
#             and the view exposes it as len when constructed onto the
#             Vec's spare capacity.
#
# Constructors:
#   slice_mut_new(ptr, len)          — the raw {ptr,len} projection
#   fixed_array_mut_view(ptr, len)   — the [T; N] buffer view: the
#                                      fixed-array's mutable address
#                                      (address_of_mut(&mut arr) as
#                                      PtrMut[T]) + the length N
#   Vec::as_mut_slice()              — the view onto [0, len) — from the
#                                      Vec's as_mut_ptr + len
#   Vec::spare_capacity_mut()        — the view onto [len, capacity) —
#                                      the spare capacity IS the writable
#                                      extent of a growable buffer
#   SliceMut::sub(start, len)        — the sub-view [start, start+len)
struct SliceMut[T]
  ptr: PtrMut[T]
  len: UInt
end

def slice_mut_new[T](ptr: PtrMut[T], len: UInt) -> SliceMut[T]
  SliceMut { ptr: ptr, len: len }
end

# The fixed-array MUTABLE VIEW — the [u8; N]-style buffer view for the
# SliceMut Read contract. The language's fixed arrays are BY-VALUE
# [T; N] values whose length N is a compile-time constant carried IN
# the type (there is no generic-over-N), so the helper takes the
# array's mutable address and the length:
#     fixed_array_mut_view(address_of_mut(&mut buf) as PtrMut[u8], N)
# → { ptr: &mut buf, len: N } — the view's len is the writable extent,
# so a read_exact through it fills exactly N bytes.
def fixed_array_mut_view[T](ptr: PtrMut[T], len: UInt) -> SliceMut[T]
  SliceMut { ptr: ptr, len: len }
end

impl[T] SliceMut[T]
  def sub(self: Self, start: Int, len: UInt) -> SliceMut[T]
    # The sub-view [start, start+len): the pointer advances by
    # start * size_of[T]() bytes — the element-scaled offset.
    let elem = size_of[T]() as Int
    SliceMut {
      ptr: (self.ptr as Int + start * elem) as PtrMut[T],
      len: len
    }
  end

  # Unsafe element write through the view (raw pointer dereference).
  unsafe def write(self: Self, index: Int, value: T) -> Unit
    let elem = size_of[T]() as Int
    write_ptr((self.ptr as Int + index * elem) as PtrMut[T], value)
  end
end
# ———————————————————————————————————————————————————————————————
# The SHARED/PINNED slice — SliceBacking[T] + Slice[T]
# (the SAFE SOURCE-SPELLED Slice; the contract header above)
# ———————————————————————————————————————————————————————————————

# The PINNED BACKING — the pinned buffer plus the window's offset/len.
# The backing owns a pinned allocation holding the window's elements, so
# the backing keeps the underlying storage alive for as long as ANY Arc
# to it lives — the view survives the original owner's drop, and the
# owner's capacity-changing mutations never move it (the backing is the
# separate pinned allocation).
struct SliceBacking[T]
  ptr: Ptr[T]
  len: UInt
  offset: UInt
end

# The SHARED/PINNED VIEW — the Arc-class {ptr,len}: one Arc handle to the
# pinned backing record (the 8-byte layout: { inner: Arc @ 0 }). This IS
# the SOURCE-spelled Slice[T] — the one safe Slice representation.
struct Slice[T]
  inner: ArcStrong[SliceBacking[T]]
end

# Pin the window [offset, offset + count) of the buffer at `ptr` into a
# FRESH pinned allocation. The pin copies the window — the pinned record
# is self-contained, so the view can never dangle (no lifetime inference:
# the Arc is the backing's keep-alive, nothing else). The backing's ptr
# IS the window's start (the pin copies exactly the window; element i of
# the view lives at backing.ptr + i * stride). The offset records the
# window's start within the SOURCE buffer at pin time — metadata for the
# sub-view chaining (the backing's deinit releases the pinned window).
def slice_pin[T](ptr: Ptr[T], count: UInt, offset: UInt) -> Slice[T]
  var buf: Ptr[T] = Ptr::null()
  if count > 0 then
    let bytes = (count as Int * size_of[T]() as Int) as UInt
    buf = alloc_array[u8](bytes).cast[T]()
    ptr_copy(ptr.cast[u8](), buf.cast[u8](), bytes)
  end
  let inner = alloc[ArcInnerWeak[SliceBacking[T]]]()
  if inner.is_null() then
    panic("slice_pin: out of memory")
  end
  inner.write(ArcInnerWeak {
    refcount: 1,
    weak_count: 0,
    data: SliceBacking { ptr: buf, len: count, offset: offset }
  })
  Slice { inner: ArcStrong { ptr: inner } }
end

impl[T] SliceBacking[T]
  # The backing owns the pinned allocation: when the LAST view's Arc
  # drops, the deinit releases the pinned buffer (the compiler's single
  # destruction protocol — the Arc's drop_in_place runs this hook first).
  def deinit(sink self: Self) -> Unit
    if !self.ptr.is_null() then
      let bytes = (self.len as Int * size_of[T]() as Int) as UInt
      dealloc_array[u8](self.ptr.cast[u8](), bytes)
    end
  end
end

impl[T] Slice[T]
  def len(self: Self) -> UInt
    self.inner.ptr.as_mut().data.len
  end

  def is_empty(self: Self) -> Bool
    self.len() == 0
  end

  # The sub-view [start, start + len): a fresh pinned backing holds the
  # sub-window (the pin copies from the parent's pinned window at `start`;
  # the sub-view is self-contained and shares nothing with the parent
  # except the element values). The recorded offset is the sub-window's
  # start within the ORIGINAL source buffer (the metadata chaining rule).
  def sub(self: Self, start: Int, len: UInt) -> Slice[T]
    let b = self.inner.ptr.as_mut().data
    let elem = size_of[T]() as Int
    slice_pin((b.ptr as Int + start * elem) as Ptr[T], len, (b.offset as Int + start) as UInt)
  end
end

impl[T: Copy] Slice[T]
  # The pinned element read — safe: the backing owns the pinned buffer,
  # so the view can never dangle. Out-of-range reads TRAP (the std OOB
  # policy, like Array::get). Element i of the view lives at
  # backing.ptr + i * stride — the backing.ptr IS the pinned window's
  # start (the offset is source metadata, never an element address).
  def get(self: Self, index: Int) -> T
    let b = self.inner.ptr.as_mut().data
    let elem = size_of[T]() as Int
    if index < 0 || index >= b.len as Int then
      panic("Slice::get: index out of bounds")
    end
    *((b.ptr as Int + index * elem) as Ptr[T])
  end

  # The first element (None when empty) — the shared form's safe first:
  # reads through the Arc deref into the pinned backing.
  def first(self: Self) -> Option[T]
    if self.len() == 0 then
      Option::None
    else
      Option::Some(self.get(0))
    end
  end

  # The last element (None when empty) — the shared form's safe last:
  # reads through the Arc deref into the pinned backing.
  def last(self: Self) -> Option[T]
    if self.len() == 0 then
      Option::None
    else
      Option::Some(self.get(self.len() as Int - 1))
    end
  end
end
# ———————————————————————————————————————————————————————————————

struct Vec[T]
  # Compiler intrinsic: growable array (the Adt form of Array[T]).
  # The runtime value is a POINTER to the 32-byte heap header
  #   { data: Ptr[u8] @ 0, len: Int @ 8, cap: Int @ 16, stride: Int @ 24 }
  # (repr_header_size(Repr::HeapVecHeader) / container_field_offset in
  # tg_compiler/layout_engine.tg — the stride authority).
  #
  # `stride` is the element stride in bytes, set at creation from the
  # CONCRETE element type T (element_stride_bytes: 1/2/4/8 for immediate
  # scalars, 8 for pointer-represented values, align_up(size, align) for
  # fixed-array elements). EVERY runtime operation computes element
  # addresses as data + index*stride, copies value words with width
  # min(stride, 8), and releases cap*stride bytes on grow/destroy. There is
  # NO hardcoded 8-byte element arithmetic anywhere in the Vec ABI.
end

struct VecDeque[T]
  front: Vec[T]
  back: Vec[T]
end

# vec![a, b, c] is syntax sugar for Vec::from([a, b, c]).
# The compiler expands vec! at parse time into an Array literal.
macro vec!(items: expr)
  Vec::from([items])
end

# Map[K: Hash + Eq, V] — compiler-intrinsic hash map (contract).
#
# STORAGE CONTRACT (the canonical machine-readable authority is
# MAP_HEADER_FIELDS in tg_compiler/layout_engine.tg — map_header_field_offset
# / map_header_total_size; see also tg_compiler/runtime.tg "Map Runtime
# Implementation"): the map is a 96-byte header { buckets:0, size:8,
# capacity:16, key_stride:24, key_align:32, value_stride:40, value_align:48,
# key_off:56, value_off:64, next_off:72, bucket_stride:80, free_list:88 }
# (total 96 bytes) over a raw bucket arena. Buckets hold the CONCRETE K and
# V INLINE: { hash @0, key bytes @key_off, value bytes @value_off, next
# @next_off } — key_off/value_off/next_off/bucket_stride are computed ONCE at
# map creation from the four layout parameters (the concrete K/V sizes and
# alignments from the layout engine) and carried in the header; the runtime
# never hardcodes bucket arithmetic. A Map[BigStruct, Another] therefore
# stores the full struct bytes, not pointers. free_list (header+88) is the
# overflow-node reuse list: the clear path links every chain node into it
# and the insert chain path pops it before mmap'ing a fresh node.
#
# STORED-HASH ENCODING: the bucket's cached hash is NEVER a raw
# user hash. Every map/set runtime operation normalizes the hash argument
# at entry — stored = hash == 0 ? 1: hash — and the probe mask and the
# cached-hash comparison always use the normalized value. A key whose
# Hash::hash returns 0 is stored as the encoding 1 and is found by the
# same encoding at lookup; 0 remains the empty marker.
#
# REMOVAL CONTRACT: removing a record (remove / remove_key /
# drain_one) REAL-unlinks it: a bucket head promotes its chain successor's
# full record image into the head slot (the old successor node goes to the
# free list), a chain node is re-linked out of its parent, and only a tail
# record is marked empty — no live chain successor is ever hidden behind
# a zeroed hash, so every lookup finds every entry after any removal.
#
# HASH/EQ DISPATCH CONTRACT: every map operation hashes the key through
# the CONCRETE Hash::hash instance of K (a user-defined `impl Hash for
# MyKey` / `impl Eq for MyKey` dispatches — the impl methods compile to
# MyKey__hash / MyKey__eq and are called directly; generic impls are
# specialized and mangled by the monomorphizer) and compares keys through
# the CONCRETE Eq::eq instance (its address is passed to the runtime
# probe). Kernel key types (Int, String, StrView, the numeric primitives)
# dispatch to the typed runtime helpers _tg_hash_* / _tg_eq_* — their
# std::hash impls are Hasher-style (`def hash[H: Hasher]`) and do not
# match the core `def hash(self) -> Int` ABI the map surface declares.
# The old heuristic runtime hashing (_tg_runtime_hash_ptr / _tg_key_equal)
# is REMOVED from the map/set paths.
#
# The std API surface (map_new/map_insert/map_get/map_remove/...) is
# UNCHANGED; Set[T] is a Map[T, Unit] with the same storage and dispatch.
struct Map[K: Hash + Eq, V]
  # Compiler intrinsic: hash map
end

struct Set[T: Hash + Eq]
  # Compiler intrinsic: hash set (a Map[T, Unit] under the same contract)
end

extern def __intrinsic_array_len[T](arr: Array[T]) -> Int
extern def __intrinsic_array_push[T](inout arr: Array[T], sink item: T) -> Unit
# pop -> Option[T] (VALUE ABI): the runtime returns the popped element's
# IMAGE ADDRESS (0 when empty — None). For a Scalar T the address is the
# in-buffer slot (the codegen loads the width-matched value word and makes
# it the Some payload); for ScalarPair/ByAddress T the runtime byte-copies
# the FULL element image into a fresh bump allocation and the Some payload
# is that image address. The codegen constructs the complete Option[T]
# TaggedPtr word (the same wrap the map ops use). The runtime NEVER
# returns a raw element word.
extern def __intrinsic_array_pop[T](inout arr: Array[T]) -> Option[T]
# get -> T (VALUE ABI, CHECKED): the codegen's ArrayGet arm is the checked
# path — index < len is verified and out-of-range TRAPS (the defined std
# OOB policy: panic on OOB, matching the language's other panics); the
# runtime primitive is the UNCHECKED address accessor (data + index*stride)
# and the arm materializes the element per its ValueCategory (the
# width-matched value word for Scalar, the FULL image copy to the
# destination for ScalarPair/ByAddress).
extern def __intrinsic_array_get[T](arr: Array[T], index: Int) -> T
extern def __intrinsic_array_new[T]() -> Array[T]

extern def __intrinsic_map_new[K, V]() -> Map[K, V]
extern def __intrinsic_map_get[K, V](m: Map[K, V], key: K) -> Option[V]
extern def __intrinsic_map_insert[K, V](inout m: Map[K, V], sink key: K, sink value: V) -> Option[V]

extern def __intrinsic_set_new[T]() -> Set[T]
extern def __intrinsic_set_contains[T](s: Set[T], item: T) -> Bool
extern def __intrinsic_set_insert[T](inout s: Set[T], sink item: T) -> Bool

# remove -> T (VALUE ABI): the runtime extracts the removed element per
# its ValueCategory — the width-matched VALUE WORD for a Scalar T (the
# complete T in the return register) or the ADDRESS of a fresh bump copy
# of the FULL removed image for ScalarPair/ByAddress (the codegen
# materializes the complete T into the destination). The shift and the len
# shrink leave the removed slot dead to the array's drop glue — the
# returned T is the sole owner of the removed value.
extern def __intrinsic_array_remove[T](inout arr: Array[T], index: Int) -> T
extern def __intrinsic_array_insert[T](inout arr: Array[T], index: Int, sink item: T) -> Unit
extern def __intrinsic_array_clear[T](inout arr: Array[T]) -> Unit
extern def __intrinsic_array_from_list[T](items: [T]) -> Array[T]
# contains -> Bool (Eq DISPATCH): the codegen resolves the CONCRETE Eq::eq
# instance of T (the same dispatch the map keys use — the compiled
# `impl Eq for T` instance, _tg_eq_str for String objects, _tg_eq_str_view
# for StrView, or the _tg_eq_mem structural fallback with the element
# stride) and the runtime probes each element's FULL image through that Eq
# call — never a width-load/direct-register bit comparison. `item` is the
# &T reference VALUE (the element ADDRESS — the runtime probes by
# reference).
extern def __intrinsic_array_contains[T: Eq](arr: Array[T], item: T) -> Bool
extern def __intrinsic_array_capacity[T](arr: Array[T]) -> Int
extern def __intrinsic_array_slice[T](arr: Array[T], start: Int, end_idx: Int) -> Array[T]
extern def __intrinsic_array_extend[T](inout arr: Array[T], other: Array[T]) -> Unit
extern def __intrinsic_array_with_capacity[T](cap: Int) -> Array[T]
extern def __intrinsic_array_destroy[T](inout arr: Array[T]) -> Unit

extern def __intrinsic_map_len[K, V](m: Map[K, V]) -> Int
extern def __intrinsic_map_contains_key[K, V](m: Map[K, V], key: K) -> Bool
extern def __intrinsic_map_remove[K, V](inout m: Map[K, V], key: K) -> Option[V]
extern def __intrinsic_map_clear[K, V](inout m: Map[K, V]) -> Unit
extern def __intrinsic_map_entries[K, V](m: Map[K, V]) -> Vec[(K, V)]
extern def __intrinsic_map_drain_one[K, V](inout m: Map[K, V]) -> Option[(K, V)]
extern def __intrinsic_map_destroy[K, V](inout m: Map[K, V]) -> Unit

extern def __intrinsic_set_len[T](s: Set[T]) -> Int
extern def __intrinsic_set_remove[T](inout s: Set[T], item: T) -> Bool
extern def __intrinsic_set_clear[T](inout s: Set[T]) -> Unit
extern def __intrinsic_set_entries[T](s: Set[T]) -> Vec[T]
extern def __intrinsic_set_drain_one[T](inout s: Set[T]) -> Option[T]
extern def __intrinsic_set_destroy[T](inout s: Set[T]) -> Unit

# The clone-aware record traversal (— the projected READ of the live
# hash-table slots). The begin/next intrinsics walk the map's live records
# NON-DESTRUCTIVELY (no unlink, no image materialization — the runtime
# never byte-copies a stored key or value) and yield the next live key's
# ADDRESS as an Option[&K] (Some = a {disc, key-address} image word; None
# = the inline None discriminant — the TaggedPtr enum encoding). The
# value intrinsic derives the live VALUE address from a yielded key
# address. The consumer (entries_cloned / the set algebra / the snapshot
# iterators) clones every key and value DIRECTLY from these addresses with
# the concrete Clone instance — the read-then-clone shape: the operation
# is a projected READ followed by Clone, never a raw copy of the slot
# (MirCopy/MirMovePlace of the container slot never happens). The set
# variants walk the same Map[T, Unit] storage.
extern def __intrinsic_map_visit_begin[K, V](m: Map[K, V]) -> Option[&K]
extern def __intrinsic_map_visit_next[K, V](m: Map[K, V], key_ref: K) -> Option[&K]
extern def __intrinsic_map_visit_value[K, V](m: Map[K, V], key_ref: K) -> &V
extern def __intrinsic_set_visit_begin[T](s: Set[T]) -> Option[&T]
extern def __intrinsic_set_visit_next[T](s: Set[T], item_ref: T) -> Option[&T]

trait Iterator[T]
  def advance(inout self: Self) -> Option[T]
end

trait IntoIterator[T]
  def into_iter(self) -> Iterator[T]
end

trait Iterable[T]
  def iter(self: Self) -> Iterator[T]
end

# ———————————————————————————————————————————————————————————————
# Concurrency properties — NO marker impls (concurrency properties)
# (the traits are declared in std::core: Transferable / Shareable)
# ———————————————————————————————————————————————————————————————
# The manual container impls are DELETED: the compiler derives the
# properties structurally (tg_compiler/types.tg — the single authority).
# Vec/Array/Map/Set are Transferable through their owned-container layer
# (the generic args walk) and NOT Shareable (the plain owned types are
# Transferable-but-not-Shareable — shared mutable state goes through
# Arc/Mutex/RwLock/atomics/channels).

# Array methods (compiler intrinsics)
def array_len[T](arr: Array[T]) -> Int
  # Compiler intrinsic
  __intrinsic_array_len(arr)
end

def array_push[T](inout arr: Array[T], sink item: T) -> Unit
  # Compiler intrinsic
  __intrinsic_array_push(arr, item)
end

def array_pop[T](inout arr: Array[T]) -> Option[T]
  # Compiler intrinsic
  __intrinsic_array_pop(arr)
end

# Raw shared read: requires T: Copy — the semantic guarantee that raw value
# duplication is valid (the compiler's trivially-copyable structural
# property). Non-Copy elements (e.g. String) must be read through an explicit
# clone path or extracted with the consuming inout APIs.
def array_get[T: Copy](arr: Array[T], index: Int) -> T
  # Compiler intrinsic
  __intrinsic_array_get(arr, index)
end

def array_new[T]() -> Array[T]
  # Compiler intrinsic
  __intrinsic_array_new()
end

# Map methods
def map_new[K, V]() -> Map[K, V]
  # Compiler intrinsic
  __intrinsic_map_new()
end

# Raw shared read: requires the VALUE to be Copy — a shared read must never
# duplicate a resource value (the key is borrowed read-only and is never
# duplicated by get; the materializing entries() path below is the
# key-copying surface and requires both key and value to be Copy).
def map_get[K, V: Copy](m: Map[K, V], key: K) -> Option[V]
  # Compiler intrinsic
  __intrinsic_map_get(m, key)
end

# Ownership-taking insert: both the key and the value are consumed INTO the
# map. When the key already exists, the OLD value is returned as an owned
# Option[V] (Some(old)) — replacement semantics: the new value is acquired
# and moved into the slot, the old value's bytes are extracted BEFORE the
# new bytes are written, and the returned Option owns the old value (the
# caller destroys it or rebinds it). A None result means the key was absent.
#
# SINK-KEY TEARDOWN: the runtime PRESERVES the stored key on the
# replacement path (the map keeps its key identity); the incoming key's
# image was moved into the call but its bytes are NOT consumed by the
# runtime. For an owning K the MIR lowers this method as: the insert
# intrinsic, a branch on the returned Option's discriminant, and — on Some
# (the replacement path was taken) — the concrete K drop glue on the
# caller's incoming-key slot. The incoming key is destroyed exactly when
# the stored key was preserved. the incoming key is ALWAYS
# materialized into a real drop slot before the call (a non-place key
# expression — a call result like `make_resource_key()` — becomes a fresh
# temp), so the teardown activates for every insert shape.
def map_insert[K, V](inout m: Map[K, V], sink key: K, sink value: V) -> Option[V]
  # Compiler intrinsic
  __intrinsic_map_insert(m, key, value)
end

# Set methods
def set_new[T]() -> Set[T]
  __intrinsic_set_new()
end

def set_contains[T](s: Set[T], item: T) -> Bool
  __intrinsic_set_contains(s, item)
end

# Ownership-taking insert: the item is consumed INTO the set. Inserting a
# key that already exists REPLACES the stored key with the new one — the
# set keeps its no-payload semantics (a set entry is a Map[T, Unit] key
# slot, so a replacement carries nothing to return beyond the presence
# result): the Bool result is `true` when the key ALREADY existed (its slot
# was replaced) and `false` when the key was ABSENT (a fresh slot was
# created).
#
# REPLACEMENT CONTRACT: the runtime's found path rewrites the
# STORED element with the incoming image (extract-then-write on the key,
# symmetric with the map value replacement) and returns the fresh owned
# allocation of the OLD stored element; for an owning T the MIR lowers this
# method as: the insert intrinsic, the returned-address test, and — on the
# found path — the concrete T drop glue on the returned old element. The
# incoming item's image owns itself (it became the stored element); the old
# element is destroyed by the MIR exactly when it was replaced.
# the incoming item is ALWAYS materialized into a real drop slot before
# the call (a non-place item expression becomes a fresh temp), so the
# replacement drop activates for every insert shape.
def set_insert[T](inout s: Set[T], sink item: T) -> Bool
  __intrinsic_set_insert(s, item)
end

# ———————————————————————————————————————————————————————————————
# Iterator trait implementations for core collections
# ———————————————————————————————————————————————————————————————

# ArrayIterator is the RAW-STORAGE projection iterator: it holds a raw
# pointer (Ptr[T]) into the source array's storage plus a length snapshot
# instead of a cloned array, so advance() reads each element through the
# pointer (indexed via Ptr::offset, which scales by size_of[T]()) rather
# than from a copied snapshot.
#
# ITERATION MODEL (DECIDED): by-value shared iteration through ArrayIterator
# is COPY-ONLY — advance() returns a raw bit-copy of the element out of the
# array's storage, which is sound only for T: Copy. The COMPILER-SCOPED
# projected for-loop (the resource checker's IterationPlan / the MIR's
# lower_for_projected) is the PRIMARY iteration mechanism for Vec/Array/
# Slice: it binds each element by reference into the collection under the
# checker's projected-iteration guard (no move out of the binding, no
# mutation of the iterated collection inside the loop body). Non-Copy
# elements are never yielded by the by-value iterator; they are iterated by
# the projected for-loop or extracted with the consuming inout APIs
# (pop/remove/drain).
#
# SAFETY: the raw pointer dangles if the source array is mutated while the
# iterator is alive (push/pop/insert/remove/clear, or any operation that may
# reallocate), and the length snapshot may disagree with the live length —
# that is implementation-defined. Construction is therefore an EXPLICITLY
# UNSAFE API (unsafe_iter below): safe code never builds the raw storage
# iterator, and Vec[T] is an alias for Array[T] (see std::core), so
# ArrayIterator[T] also serves as the iterator for Vec[T]. No separate
# VecIterator needed.
struct ArrayIterator[T]
  ptr: Ptr[T]
  len: Int
  index: Int
end

impl[T: Copy] Iterator[T] for ArrayIterator[T]
  def advance(inout self: Self) -> Option[T] inout
    if self.index >= self.len then
      return Option::None
    end
    let item = unsafe "projected element read through ArrayIterator storage pointer" do
      *(self.ptr.offset(self.index))
    end
    self.index = self.index + 1
    Option::Some(item)
  end
end

# Map snapshot iterators (the SAFE snapshot semantics). Map storage has no
# pointer-projection API: every iterator materializes a copied entries array
# (entries_cloned — each key and value an explicit clone()) and each
# advance() CLONES the element out of that snapshot, so the yielded value is
# genuinely owned. The snapshot is safe against mutation of the live map
# during iteration. The compiler-scoped projected for-loop is the follow-up
# for the common case; until then, `for (k, v) in m` iterates the
# materialized snapshot through the collection for-loop lowering.
#
# PROJECTED READ (): advance() NEVER extracts a snapshot element by
# value. The clone receiver is the projected place
# `self.entries[self.index].0` — the MIR lowers the receiver as the
# address of the SLOT (MirRef of the [Field, Index, TupleIndex] projection
# chain), and the concrete clone instance reads the key IN PLACE. No
# owned intermediate (no `let entry = self.entries[self.index]` image
# copy) is ever constructed — the read-then-clone shape: a projected READ
# followed by Clone, never a MirCopy/MirMovePlace of the container slot.
struct MapKeyIterator[K, V]
  entries: Vec[(K, V)]
  index: Int
end

impl[K: Clone, V] Iterator[K] for MapKeyIterator[K, V]
  def advance(inout self: Self) -> Option[K] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let key = self.entries[self.index].0.clone()
    self.index = self.index + 1
    Option::Some(key)
  end
end

struct MapValueIterator[K, V]
  entries: Vec[(K, V)]
  index: Int
end

impl[K, V: Clone] Iterator[V] for MapValueIterator[K, V]
  def advance(inout self: Self) -> Option[V] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let value = self.entries[self.index].1.clone()
    self.index = self.index + 1
    Option::Some(value)
  end
end

# MapIterator materializes a copied entries array (entries_cloned) at
# construction: the copied snapshot is the SAFE semantics — mutating the map
# during iteration only affects this snapshot, not the live map. Projected
# map iteration is the follow-up. The advance clones both fields DIRECTLY
# from the projected slot (see the projected-read contract above) — no
# owned (K, V) intermediate is ever extracted from the snapshot.
struct MapIterator[K, V]
  entries: Vec[(K, V)]
  index: Int
end

impl[K: Clone, V: Clone] Iterator[(K, V)] for MapIterator[K, V]
  def advance(inout self: Self) -> Option[(K, V)] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let key = self.entries[self.index].0.clone()
    let value = self.entries[self.index].1.clone()
    self.index = self.index + 1
    Option::Some((key, value))
  end
end

impl[K: Hash + Eq + Clone, V: Clone] Iterable[(K, V)] for Map[K, V]
  # Iteration yields retained OWNED entries: the iterator materializes
  # cloned entry arrays (entries_cloned — the clone-aware traversal: every
  # key and value an explicit clone() out of the LIVE hash-table records,
  # never the raw byte-copy image intrinsic). The copied snapshot is the
  # SAFE semantics (mutating the map during iteration only affects this
  # snapshot, not the live map).
  def iter(inout self: Self) -> MapIterator[K, V] inout
    MapIterator { entries: self.entries_cloned(), index: 0 }
  end
end

# ———————————————————————————————————————————————————————————————
# Collection impl blocks
# ———————————————————————————————————————————————————————————————

impl[T] Array[T]
  def new() -> Array[T]
    __intrinsic_array_new()
  end

  def with_capacity(cap: Int) -> Array[T]
    __intrinsic_array_with_capacity(cap)
  end

  def len(self: Self) -> Int
    __intrinsic_array_len(self)
  end

  def capacity(self: Self) -> Int
    __intrinsic_array_capacity(self)
  end

  def is_empty(self: Self) -> Bool
    self.len() == 0
  end

  def push(inout self: Self, sink item: T) -> Unit inout
    __intrinsic_array_push(self, item)
  end

  def pop(inout self: Self) -> Option[T] inout
    # VALUE ABI: the runtime returns the popped element's image address or
    # 0 (None); the codegen constructs the complete Option[T] word — the
    # Some payload is the width-matched value word for a Scalar T and the
    # FULL-image address for ScalarPair/ByAddress T.
    __intrinsic_array_pop(self)
  end

  def remove(inout self: Self, index: Int) -> T inout
    # VALUE ABI: the removed element is extracted per its ValueCategory —
    # the value word for a Scalar T, the FULL image (fresh copy) for
    # ScalarPair/ByAddress T — and materialized into the complete T.
    __intrinsic_array_remove(self, index)
  end

  def insert(inout self: Self, index: Int, sink item: T) -> Unit inout
    __intrinsic_array_insert(self, index, item)
  end

 # Clear is an OWNERSHIP operation: for trivial (no needs_drop)
  # elements the fast intrinsic stays (len = 0); for owning elements the
  # MIR emits the per-element drop loop — the concrete element glue at
  # data + i*stride for i in 0..len — and THEN len = 0 (capacity
  # retained).
  def clear(inout self: Self) -> Unit inout
    __intrinsic_array_clear(self)
  end
end

# Raw-read Array APIs require T: Copy — a shared read or a materialized copy
# must never manufacture a second owner of a resource element. Resource
# elements are extracted with the consuming inout APIs above (pop/remove).
# String is NOT Copy (std::core: String is OWNED — moves transfer, clone()
# allocates): a shared read of a Vec[String]/Map[.., String]/Set[String]
# element must NEVER bitwise-copy the 8-byte String-object pointer — that
# would duplicate the owned buffer into a second owner without the required
# clone.
# Element reads must produce an explicit clone; owned elements are extracted
# with the consuming inout APIs.
#
# The by-value raw-storage iterator (ArrayIterator) lives HERE, under the
# Copy bound: advance() returns a raw bit-copy of each element, which is
# sound only for T: Copy. It is constructed ONLY through the explicitly-
# unsafe unsafe_iter() — the raw storage projection cannot be created from
# safe code (mutating the array during iteration is implementation-defined;
# the projected compiler-scoped for-loop is the safe iteration mechanism).
impl[T: Copy] Array[T]
  def from(items: [T]) -> Array[T]
    __intrinsic_array_from_list(items)
  end

  def get(self: Self, index: Int) -> T
    # VALUE ABI, CHECKED: out-of-range TRAPS (the defined std OOB policy —
    # panic on OOB). The element is materialized per its ValueCategory:
    # the width-matched value word for a Scalar T, the FULL image copy for
    # ScalarPair/ByAddress T.
    __intrinsic_array_get(self, index)
  end

  def slice(self: Self, start: Int, end_idx: Int) -> Array[T]
    __intrinsic_array_slice(self, start, end_idx)
  end

  def extend(inout self: Self, other: Array[T]) -> Unit inout
    __intrinsic_array_extend(self, other)
  end

  # The SAFE VIEW: pins the window [0, len) into a fresh pinned backing and
  # returns the SHARED/PINNED Slice — the SOURCE-spelled Slice[T] (the
  # Arc-class view). The view survives
  # this array's drop and its capacity-changing mutations — the backing is
  # the separate pinned allocation. The pin copies the window; the view is
  # immutable and never dangles (no lifetime inference).
  def as_slice(self: Self) -> Slice[T]
    slice_pin(self.as_ptr(), self.len() as UInt, 0)
  end

  # EXPLICITLY UNSAFE: constructs the raw-storage projection iterator
  # (a raw pointer into this array's storage plus a length snapshot).
  # Mutating the array while the iterator is alive is
  # implementation-defined (the pointer may dangle / the length snapshot
  # may disagree with the live length). The safe for-loop iteration is the
  # compiler-scoped projected access (the resource checker's IterationPlan).
  unsafe def unsafe_iter(inout self: Self) -> ArrayIterator[T] inout
    unsafe "raw storage projection: mutating the array during iteration is implementation-defined" do
      ArrayIterator { ptr: self.as_ptr(), len: self.len(), index: 0 }
    end
  end
end

impl[T] VecDeque[T]
  def new() -> VecDeque[T]
    VecDeque {
      front: Array::new(),
      back: Array::new()
    }
  end

  def len(self: Self) -> Int
    self.front.len() + self.back.len()
  end

  def is_empty(self: Self) -> Bool
    self.front.is_empty() && self.back.is_empty()
  end

  def push_back(inout self: Self, sink item: T) -> Unit inout
    self.back.push(item)
  end

  def pop_front(inout self: Self) -> Option[T] inout
    if self.front.is_empty() then
      while !self.back.is_empty() do
        match self.back.pop()
        when Option::Some(item) then self.front.push(item)
        when Option::None then break
        end
      end
    end

    self.front.pop()
  end
end

impl[T: Eq] VecDeque[T]
  def contains(self: Self, item: T) -> Bool
    self.front.contains(item) || self.back.contains(item)
  end
end

impl[T: Eq] Array[T]
  def contains(self: Self, item: T) -> Bool
    # Eq DISPATCH: the concrete Eq::eq instance of T probes every element
    # (the map-key dispatch) — never a bit comparison.
    __intrinsic_array_contains(self, item)
  end
end

impl[K, V] Map[K, V]
  def new() -> Map[K, V]
    __intrinsic_map_new()
  end

  # Ownership-taking insert: key and value are consumed INTO the map; the
  # returned Option[V] carries the REPLACED old value (owned) when the key
  # already existed — see the map_insert ownership contract above (the
  # sink-key teardown is MIR-side: the incoming key's drop runs on the
  # replacement path).
  def insert(inout self: Self, sink key: K, sink value: V) -> Option[V] inout
    __intrinsic_map_insert(self, key, value)
  end

  # Ownership-taking remove: the removed VALUE is extracted as an owned
 # Option[V], and the stored KEY is DESTROYED: the MIR lowers
  # this method as the ownership-transfer remove intrinsic (the runtime
  # copies the value image out into the caller's slot and REAL-unlinks the
 # record — a bucket head promotes its chain successor's full
  # record image into the head slot, a chain node is re-linked out of its
  # parent, and the displaced overflow node goes to the free list; only a
  # tail record is marked empty — and returns the removed key's image
  # address), the concrete K drop glue on the returned key address, then
  # the Option[V] re-encode. The key bytes of a removed entry never leak,
  # and no chain successor is ever hidden behind a zeroed hash.
  def remove(inout self: Self, key: K) -> Option[V] inout
    __intrinsic_map_remove(self, key)
  end

  def drain_one(inout self: Self) -> Option[(K, V)] inout
    __intrinsic_map_drain_one(self)
  end

  def contains_key(self: Self, key: K) -> Bool
    __intrinsic_map_contains_key(self, key)
  end

  def len(self: Self) -> Int
    __intrinsic_map_len(self)
  end

  def is_empty(self: Self) -> Bool
    self.len() == 0
  end

 # Clear is an OWNERSHIP operation: the MIR decides. For trivial
  # (no needs_drop) K and V the fast intrinsic (_tg_map_clear — every
  # head's hash AND next are zeroed, every chain's overflow nodes are
  # linked into the header's free list for later insertions to reuse,
  # size = 0) stays. For owning K or V the MIR emits the DRAIN-AND-DROP
  # loop: each live entry is unlinked through __intrinsic_map_drain_one
  # (the drain's own cleanup) and its key and value are dropped through
  # their concrete glues, until the drain returns None. Either way the
  # bucket arena and capacity are retained and no overflow node leaks.
  def clear(inout self: Self) -> Unit inout
    __intrinsic_map_clear(self)
  end

end

# Raw-read Map APIs: `get` borrows the key (the key is NEVER duplicated by a
# lookup — the runtime probes the key bytes by reference) and materializes
# only the VALUE, so it requires V: Copy and leaves K unconstrained. The
# raw entries() materialization produces (K, V) pairs — it bit-copies BOTH
# the key and the value record bytes, so it is the Copy-keys-AND-values fast
# path. Resource keys/values are extracted with the consuming inout APIs
# (remove/drain_one) or the Clone-bound entries_cloned surface below.
impl[K: Hash + Eq, V: Copy] Map[K, V]
  def get(self: Self, key: K) -> Option[V]
    __intrinsic_map_get(self, key)
  end
end

impl[K: Hash + Eq + Copy, V: Copy] Map[K, V]
  # Raw entries materialization: the intrinsic bit-copies the record bytes,
  # so it is sound only for Copy keys and values (the fast path).
  def entries(self: Self) -> Vec[(K, V)]
    __intrinsic_map_entries(self)
  end
end

# Clone-bound map surfaces: entries_cloned materializes a copied entries
# array in which EVERY key and value is an explicit clone() — the pairs it
# yields are genuinely owned and never share a pointer with the live map.
#
# THE CLONE-AWARE TRAVERSAL (): entries_cloned NEVER calls the raw
# materialization intrinsic (__intrinsic_map_entries — the byte-copy image
# snapshot). It walks the map's LIVE RECORDS through the record-visit
# intrinsics (__intrinsic_map_visit_begin / _next / _value — the projected
# READ: each visit yields the live key's ADDRESS, and the value address is
# derived from it; the runtime never byte-copies a stored key or value).
# Every key and value is then cloned DIRECTLY from its live slot with the
# CONCRETE Clone instance (`key_ref.clone()` — the receiver is the
# projected place read; the MIR lowers it as the slot ADDRESS, so the
# clone reads the field in place and no owned intermediate is ever
# constructed) and the pair of clones is pushed into the destination Vec.
# The keys()/values()/iter() snapshot iterators are built on it (their
# advance() clones each element out of the snapshot through the same
# projected-read shape), so the materializing iteration surface is
# consistently Clone-based.
impl[K: Hash + Eq + Clone, V: Clone] Map[K, V]
  def entries_cloned(self: Self) -> Vec[(K, V)]
    var out = Vec::new()
    var cursor = __intrinsic_map_visit_begin(self)
    loop
      match cursor
      when Option::Some(key_ref) then
        let val_ref = __intrinsic_map_visit_value(self, key_ref)
        out.push((key_ref.clone(), val_ref.clone()))
        cursor = __intrinsic_map_visit_next(self, key_ref)
      when Option::None then break
      end
    end
    out
  end

  def keys(inout self: Self) -> MapKeyIterator[K, V] inout
    MapKeyIterator { entries: self.entries_cloned(), index: 0 }
  end

  def values(inout self: Self) -> MapValueIterator[K, V] inout
    MapValueIterator { entries: self.entries_cloned(), index: 0 }
  end
end

impl[T] Set[T]
  def new() -> Set[T]
    __intrinsic_set_new()
  end

  def contains(self: Self, item: T) -> Bool
    __intrinsic_set_contains(self, item)
  end

  # Ownership-taking insert: the item is consumed INTO the set. Replacing an
  # existing key keeps the set's no-payload semantics — nothing is returned
  # beyond the presence result (see the set_insert replacement contract
  # above: the stored element is rewritten and the OLD element is dropped
  # MIR-side through its concrete glue).
  def insert(inout self: Self, sink item: T) -> Bool inout
    __intrinsic_set_insert(self, item)
  end

 # Ownership-taking remove: the removed ELEMENT is DESTROYED :
  # the MIR lowers this method as the ownership-transfer remove intrinsic
 # (the runtime REAL-unlinks the record — head promotion /
  # chain-node re-link / tail empty-mark, with the displaced overflow
  # node going to the free list — and returns the removed element's image
  # address), the concrete T drop glue on the returned address, then the
  # Bool result. The removed element's bytes never leak, and no chain
  # successor is ever hidden behind a zeroed hash.
  def remove(inout self: Self, item: T) -> Bool inout
    __intrinsic_set_remove(self, item)
  end

  def drain_one(inout self: Self) -> Option[T] inout
    __intrinsic_set_drain_one(self)
  end

  def len(self: Self) -> Int
    __intrinsic_set_len(self)
  end

  def is_empty(self: Self) -> Bool
    self.len() == 0
  end

 # Clear is an OWNERSHIP operation: for trivial (no needs_drop)
  # elements the fast intrinsic stays (every head's hash AND next are
  # zeroed and every chain's overflow nodes are linked into the header's
  # free list for later insertions to reuse); for owning elements the MIR
  # emits the DRAIN-AND-DROP loop — each live element is unlinked through
  # __intrinsic_set_drain_one and dropped through its concrete glue, until
  # the drain returns None. The bucket arena and capacity are retained
  # and no overflow node leaks.
  def clear(inout self: Self) -> Unit inout
    __intrinsic_set_clear(self)
  end
end

# The Set surface splits into TWO entry surfaces:
#   - entries_copy (T: Copy) — the RAW materialization fast path: the
#     intrinsic bit-copies the stored element image, sound only for
#     T: Copy (the exact __intrinsic_set_entries contract);
#   - entries_cloned (T: Clone) — the CLONE-AWARE traversal: every
#     element is cloned DIRECTLY from its live hash-table slot through the
#     record-visit intrinsics (__intrinsic_set_visit_begin / _next — the
#     projected READ: the walk yields the live element's ADDRESS and the
#     runtime NEVER synthesizes a second T with memcpy), with the
#     concrete Clone instance (`item_ref.clone()` — the projected place
#     read as the clone receiver).
# Every Clone-bounded operation (the algebra below, Set::clone, Set::iter)
# uses the traversal — never __intrinsic_set_entries.
impl[T: Hash + Eq + Copy] Set[T]
  def entries_copy(self: Self) -> Vec[T]
    __intrinsic_set_entries(self)
  end
end

impl[T: Hash + Eq + Clone] Set[T]
  def entries_cloned(self: Self) -> Vec[T]
    var out = Vec::new()
    var cursor = __intrinsic_set_visit_begin(self)
    loop
      match cursor
      when Option::Some(item_ref) then
        out.push(item_ref.clone())
        cursor = __intrinsic_set_visit_next(self, item_ref)
      when Option::None then break
      end
    end
    out
  end

  def union(self: Self, other: Set[T]) -> Set[T]
    var result = Set::new()
    var cursor = __intrinsic_set_visit_begin(self)
    loop
      match cursor
      when Option::Some(item_ref) then
        result.insert(item_ref.clone())
        cursor = __intrinsic_set_visit_next(self, item_ref)
      when Option::None then break
      end
    end
    var other_cursor = __intrinsic_set_visit_begin(other)
    loop
      match other_cursor
      when Option::Some(item_ref2) then
        result.insert(item_ref2.clone())
        other_cursor = __intrinsic_set_visit_next(other, item_ref2)
      when Option::None then break
      end
    end
    result
  end

  def intersection(self: Self, other: Set[T]) -> Set[T]
    var result = Set::new()
    var cursor = __intrinsic_set_visit_begin(self)
    loop
      match cursor
      when Option::Some(item_ref) then
        if other.contains(item_ref) then
          result.insert(item_ref.clone())
        end
        cursor = __intrinsic_set_visit_next(self, item_ref)
      when Option::None then break
      end
    end
    result
  end

  def difference(self: Self, other: Set[T]) -> Set[T]
    var result = Set::new()
    var cursor = __intrinsic_set_visit_begin(self)
    loop
      match cursor
      when Option::Some(item_ref) then
        if !other.contains(item_ref) then
          result.insert(item_ref.clone())
        end
        cursor = __intrinsic_set_visit_next(self, item_ref)
      when Option::None then break
      end
    end
    result
  end

  def is_subset(self: Self, other: Set[T]) -> Bool
    var cursor = __intrinsic_set_visit_begin(self)
    loop
      match cursor
      when Option::Some(item_ref) then
        if !other.contains(item_ref) then
          return false
        end
        cursor = __intrinsic_set_visit_next(self, item_ref)
      when Option::None then break
      end
    end
    true
  end

  def is_superset(self: Self, other: Set[T]) -> Bool
    other.is_subset(self)
  end
end

# ———————————————————————————————————————————————————————————————
# SetIterator
# ———————————————————————————————————————————————————————————————

# SetIterator materializes a copied element array (set_entries_cloned —
# every element an explicit clone() out of the LIVE hash-table slots; the
# clone-aware traversal NEVER calls the raw __intrinsic_set_entries image
# snapshot) and CLONES each element out of the snapshot on advance():
# the snapshot is the current SAFE semantics (hash-set storage has no
# stable element addresses and no pointer-projection intrinsic, so a
# snapshot is required; mutating the set during iteration only affects
# this snapshot). Projected set iteration is the follow-up.
#
# PROJECTED READ (): advance() never extracts a snapshot element by
# value — the clone receiver is the projected slot
# (`self.entries[self.index]` — the MIR lowers it as the element's
# ADDRESS) and the concrete clone instance reads the element IN PLACE. No
# owned intermediate is ever constructed: the read-then-clone shape, never
# a MirCopy/MirMovePlace of the container slot.
struct SetIterator[T]
  entries: Vec[T]
  index: Int
end

impl[T: Clone] Iterator[T] for SetIterator[T]
  def advance(inout self: Self) -> Option[T] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let item = self.entries[self.index].clone()
    self.index = self.index + 1
    Option::Some(item)
  end
end

impl[T: Clone] Iterable[T] for Set[T]
  # Iteration yields retained OWNED elements: the iterator materializes
  # cloned entry arrays (set_entries_cloned — the clone-aware traversal:
  # each element an explicit clone() out of the live hash-table slot) and
  # clones each element out on advance through the projected-read shape —
  # an explicit duplication that requires Clone. The copied snapshot is
  # the current SAFE semantics (set storage exposes no pointer
  # projection). Projected set iteration is the follow-up.
  def iter(inout self: Self) -> SetIterator[T] inout
    SetIterator { entries: self.entries_cloned(), index: 0 }
  end
end

# ———————————————————————————————————————————————————————————————
# OrderedMap — insertion-order-preserving hash map
# ———————————————————————————————————————————————————————————————
#
# OWNERSHIP CONTRACT (): the ordered storage (entries: Array[(K, V)])
# holds the OWNED key/value pairs; the index (Map[K, Int]) is the position
# lookup and holds its OWN key copy. Every key is therefore duplicated
# across the two structures, so any mutation that (re)registers a key in
# the index requires K: Clone. The values are NEVER duplicated by the
# structure: shifts inside the entries array are MOVES, and the consuming
# APIs (insert/remove) extract the value as an owned move. Raw shared
# reads require V: Copy (the by-value extraction of a copy); the
# clone-aware read (get_cloned) is the explicit duplication path under
# V: Clone — the projected read + the concrete V::clone instance. A safe
# get_ref-style view is not yet enforceable (the access model has no
# escaping reference surface for container elements), so get_cloned is the
# only non-Copy read path.

struct OrderedMap[K: Hash + Eq, V]
  entries: Array[(K, V)]
  index:   Map[K, Int]   # key -> position in entries
end

# Base surface — no bounds: construction, size queries, membership and
# destruction touch neither the keys nor the values.
impl[K: Hash + Eq, V] OrderedMap[K, V]
  def new() -> OrderedMap[K, V]
    OrderedMap { entries: Array::new(), index: Map::new() }
  end

  def len(self: Self) -> Int
    self.entries.len()
  end

  def is_empty(self: Self) -> Bool
    self.entries.is_empty()
  end

  def contains_key(self: Self, key: K) -> Bool
    self.index.contains_key(key)
  end

  def clear(inout self: Self) -> Unit inout
    self.entries.clear()
    self.index.clear()
  end
end

# Copy read: the by-value extraction of a copy out of shared storage. The
# position lookup is the Map[K, Int] get (the key is borrowed read-only);
# the entry read is the projected indexed read (no raw materialization of
# the (K, V) pair) and the returned value is a bit-copy — sound only under
# V: Copy. Non-Copy values are read through get_cloned (V: Clone) or
# extracted with the consuming remove.
impl[K: Hash + Eq, V: Copy] OrderedMap[K, V]
  def get(self: Self, key: K) -> Option[V]
    match self.index.get(key)
    when Option::Some(idx) then
      Option::Some(self.entries[idx].1)
    when Option::None then Option::None
    end
  end
end

# Clone-aware read and value iteration: the projected read + the concrete
# V::clone instance — the explicit duplication that requires V: Clone (the
# key is borrowed read-only and is never duplicated here).
impl[K: Hash + Eq, V: Clone] OrderedMap[K, V]
  def get_cloned(self: Self, key: K) -> Option[V]
    match self.index.get(key)
    when Option::Some(idx) then
      Option::Some(self.entries[idx].1.clone())
    when Option::None then Option::None
    end
  end

  def values(inout self: Self) -> Array[V] inout
    var result = Array::new()
    for (_, v) in self.entries do
      result.push(v.clone())
    end
    result
  end
end

# Owned-key mutation surface — K: Clone is the exact bound the
# implementation needs: the absent branch of insert registers the key in
# the index while a clone of it goes into the entries array, and remove
# re-registers the shifted keys as explicit clones (the dual storage owns
# two key copies). The VALUES are handled by MOVES: the replacement path
# of insert shifts the trailing entries with Array::remove/Array::insert
# (pure moves — the ordered storage holds the owned values) and returns
# the old value as the owned Option[V]; remove extracts the removed value
# the same way (the Array::remove move, no clone of V anywhere).
impl[K: Hash + Eq + Clone, V] OrderedMap[K, V]
  # Ownership-taking insert: key and value are consumed INTO the map.
  # Replacement (the key exists): the old (K, V) pair is MOVED out with
  # Array::remove (the trailing entries shift left — moves, not clones),
  # the new pair is written back at the same position with Array::insert
  # (they shift right again — the net positions are unchanged, so the
  # index stays valid), and the old value is returned as the owned
  # Option[V] while the old key is dropped with the removed pair. Absent
  # (fresh entry): the key is CLONED into the entries array while the
  # owned key is consumed INTO the index — the dual storage (entries +
  # index) owns two key copies.
  def insert(inout self: Self, sink key: K, sink value: V) -> Option[V] inout
    match self.index.get(&key)
    when Option::Some(idx) then
      let (_, old_val) = self.entries.remove(idx)
      self.entries.insert(idx, (key, value))
      Option::Some(old_val)
    when Option::None then
      let pos = self.entries.len()
      self.entries.push((key.clone(), value))
      self.index.insert(key, pos)
      Option::None
    end
  end

  # Ownership-taking remove: the removed VALUE is extracted as an owned
  # Option[V] — a MOVE out of the storage (Array::remove returns the full
  # (K, V) image; the value moves into the Option and the key is dropped
  # with the destructured pair) — no clone of V anywhere. The keys of the
  # shifted entries are re-registered in the index as explicit clones
  # (the dual-storage key copy), the one K: Clone the implementation
  # needs. The entries ARRAY is the position authority: the projected
  # loop is the unbounded read — no raw map materialization.
  def remove(inout self: Self, key: K) -> Option[V] inout
    match self.index.remove(key)
    when Option::Some(idx) then
      let (_, val) = self.entries.remove(idx)
      var i = idx
      while i < self.entries.len() do
        let k2 = self.entries[i].0.clone()
        self.index.insert(k2, i)
        i = i + 1
      end
      Option::Some(val)
    when Option::None then Option::None
    end
  end

  # Materializes a copied key array from a shared receiver; requires a
  # mutable receiver so resource keys cannot be duplicated (same contract
  # as the Map/Set iterators above). The for-loop is the compiler-scoped
  # iteration over the entries array (no by-value raw iterator).
  def keys(inout self: Self) -> Array[K] inout
    var result = Array::new()
    for (k, _) in self.entries do
      result.push(k.clone())
    end
    result
  end
end

# ———————————————————————————————————————————————————————————————
# RingBuffer — fixed-capacity circular buffer
# ———————————————————————————————————————————————————————————————

struct RingBuffer[T]
  buf: Array[Option[T]]
  head: Int
  tail: Int
  count: Int
  cap: Int
end

impl[T] RingBuffer[T]
  def new(capacity: Int) -> RingBuffer[T]
    assert(capacity > 0, "RingBuffer capacity must be positive")
    var buf = Array::with_capacity(capacity)
    var i = 0
    while i < capacity do
      buf.push(Option::None)
      i = i + 1
    end
    RingBuffer { buf: buf, head: 0, tail: 0, count: 0, cap: capacity }
  end

  def len(self: Self) -> Int
    self.count
  end

  def capacity(self: Self) -> Int
    self.cap
  end

  def is_empty(self: Self) -> Bool
    self.count == 0
  end

  def is_full(self: Self) -> Bool
    self.count == self.cap
  end

  def push_back(inout self: Self, sink item: T) -> Option[T] inout
    ## Returns evicted item if buffer was full
    let evicted = if self.is_full() then
      let old = self.buf[self.head].take()
      self.head = (self.head + 1) % self.cap
      self.count = self.count - 1
      old
    else
      Option::None
    end
    self.buf[self.tail] = Option::Some(item)
    self.tail = (self.tail + 1) % self.cap
    self.count = self.count + 1
    evicted
  end

  def pop_front(inout self: Self) -> Option[T] inout
    if self.is_empty() then return Option::None end
    let item = self.buf[self.head].take()
    self.head = (self.head + 1) % self.cap
    self.count = self.count - 1
    item
  end

  def clear(inout self: Self) -> Unit inout
    while !self.is_empty() do self.pop_front() end
  end
end

# Copy read: peek_front returns the front element BY VALUE out of the shared
# slot — a raw duplication of the stored element, sound only for T: Copy
# (the semantic guarantee that raw value duplication is valid). Non-Copy
# elements (String, Box, resources) are read through peek_front_cloned
# (T: Clone — the clone-aware projected read) or extracted with the
# consuming inout APIs (pop_front).
impl[T: Copy] RingBuffer[T]
  def peek_front(self: Self) -> Option[T]
    if self.is_empty() then return Option::None end
    match self.buf[self.head]
    when Option::Some(v) then Option::Some(v)
    when Option::None then Option::None
    end
  end
end

# Clone-aware projected read: the front slot is cloned DIRECTLY from the
# place (`self.buf[self.head].clone()` — the receiver is the slot address;
# the concrete Clone instance reads the element in place, no owned
# intermediate is ever constructed) — the read-then-clone shape under the
# T: Clone bound.
impl[T: Clone] RingBuffer[T]
  def peek_front_cloned(self: Self) -> Option[T]
    if self.is_empty() then return Option::None end
    self.buf[self.head].clone()
  end
end

# ———————————————————————————————————————————————————————————————
# Lazy Iterator Adapters
# ———————————————————————————————————————————————————————————————

struct MapIter[T, U, I: Iterator[T]]
  inner: I
  func: fn(T) -> U
end

impl[T, U, I: Iterator[T]] Iterator[U] for MapIter[T, U, I]
  def advance(inout self: Self) -> Option[U] inout
    match self.inner.advance()
    when Option::Some(v) then Option::Some((self.func)(v))
    when Option::None then Option::None
    end
  end
end

struct FilterIter[T, I: Iterator[T]]
  inner: I
  predicate: fn(T) -> Bool
end

impl[T, I: Iterator[T]] Iterator[T] for FilterIter[T, I]
  def advance(inout self: Self) -> Option[T] inout
    loop
      match self.inner.advance()
      when Option::Some(v) then
        if (self.predicate)(&v) then return Option::Some(v) end
      when Option::None then return Option::None
      end
    end
  end
end

struct TakeIter[T, I: Iterator[T]]
  inner: I
  remaining: Int
end

impl[T, I: Iterator[T]] Iterator[T] for TakeIter[T, I]
  def advance(inout self: Self) -> Option[T] inout
    if self.remaining <= 0 then return Option::None end
    self.remaining = self.remaining - 1
    self.inner.advance()
  end
end

struct SkipIter[T, I: Iterator[T]]
  inner: I
  to_skip: Int
  skipped: Bool
end

impl[T, I: Iterator[T]] Iterator[T] for SkipIter[T, I]
  def advance(inout self: Self) -> Option[T] inout
    if !self.skipped then
      self.skipped = true
      var i = 0
      while i < self.to_skip do
        self.inner.advance()
        i = i + 1
      end
    end
    self.inner.advance()
  end
end

struct ZipIter[A, B, IA: Iterator[A], IB: Iterator[B]]
  a: IA
  b: IB
end

def _zip_pair[A, B](left_value: A, right_value: B) -> (A, B)
  (left_value, right_value)
end

impl[A, B, IA: Iterator[A], IB: Iterator[B]] Iterator[(A, B)] for ZipIter[A, B, IA, IB]
  def advance(inout self: Self) -> Option[(A, B)] inout
    match (self.a.advance(), self.b.advance())
    when (Option::Some(x), Option::Some(y)) then Option::Some(_zip_pair(x, y))
    else Option::None
    end
  end
end

struct ChainIter[T, IA: Iterator[T], IB: Iterator[T]]
  a: IA
  b: IB
  a_done: Bool
end

impl[T, IA: Iterator[T], IB: Iterator[T]] Iterator[T] for ChainIter[T, IA, IB]
  def advance(inout self: Self) -> Option[T] inout
    if !self.a_done then
      match self.a.advance()
      when Option::Some(v) then return Option::Some(v)
      when Option::None then self.a_done = true
      end
    end
    self.b.advance()
  end
end

struct EnumerateIter[T, I: Iterator[T]]
  inner: I
  index: Int
end

impl[T, I: Iterator[T]] Iterator[(Int, T)] for EnumerateIter[T, I]
  def advance(inout self: Self) -> Option[(Int, T)] inout
    match self.inner.advance()
    when Option::Some(v) then
      let i = self.index
      self.index = self.index + 1
      Option::Some((i, v))
    when Option::None then Option::None
    end
  end
end

struct FlatMapIter[T, U, I: Iterator[T], J: Iterator[U]]
  outer: I
  inner: Option[J]
  func: fn(T) -> J
end

impl[T, U, I: Iterator[T], J: Iterator[U]] Iterator[U] for FlatMapIter[T, U, I, J]
  def advance(inout self: Self) -> Option[U] inout
    loop
      match self.inner
      when Option::Some(var it) then
        match it.advance()
        when Option::Some(v) then return Option::Some(v)
        when Option::None then self.inner = Option::None
        end
      when Option::None then ()
      end

      match self.outer.advance()
      when Option::Some(item) then
        self.inner = Option::Some((self.func)(item))
      when Option::None then return Option::None
      end
    end
  end
end

struct PeekableIter[T, I: Iterator[T]]
  inner: I
  peeked: Option[Option[T]]
end

# Copy read: peek returns the cached element BY VALUE out of the shared
# peeked slot — a raw duplication, sound only for T: Copy. Non-Copy
# elements are read through peek_cloned (T: Clone) or with advance().
impl[T: Copy, I: Iterator[T]] PeekableIter[T, I]
  def peek(inout self: Self) -> Option[T] inout
    if self.peeked.is_none() then
      self.peeked = Option::Some(self.inner.advance())
    end
    match self.peeked
    when Option::Some(Option::Some(v)) then Option::Some(v)
    else Option::None
    end
  end
end

# Clone-aware peek: the cached slot is CLONED directly from the place
# (`self.peeked.clone()` — the read-then-clone shape under the T: Clone
# bound; no owned intermediate is ever extracted from the slot).
impl[T: Clone, I: Iterator[T]] PeekableIter[T, I]
  def peek_cloned(inout self: Self) -> Option[T] inout
    if self.peeked.is_none() then
      self.peeked = Option::Some(self.inner.advance())
    end
    match self.peeked.clone()
    when Option::Some(Option::Some(v)) then Option::Some(v)
    else Option::None
    end
  end
end

impl[T, I: Iterator[T]] Iterator[T] for PeekableIter[T, I]
  def advance(inout self: Self) -> Option[T] inout
    match self.peeked.take()
    when Option::Some(v) then v
    when Option::None then self.inner.advance()
    end
  end
end

struct ClonedIter[T: Clone, I: Iterator[T]]
  inner: I
end

impl[T: Clone, I: Iterator[T]] Iterator[T] for ClonedIter[T, I]
  def advance(inout self: Self) -> Option[T] inout
    match self.inner.advance()
    when Option::Some(v) then Option::Some(v.clone())
    when Option::None then Option::None
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Iterator extension methods (consuming adapters)
# ———————————————————————————————————————————————————————————————

## Extension methods available on any Iterator[T]
impl[T, I: Iterator[T]] I
  def map[U](self, f: fn(T) -> U) -> MapIter[T, U, I]
    MapIter { inner: self, func: f }
  end

  def filter(self, p: fn(T) -> Bool) -> FilterIter[T, I]
    FilterIter { inner: self, predicate: p }
  end

  def take(self, n: Int) -> TakeIter[T, I]
    TakeIter { inner: self, remaining: n }
  end

  def skip(self, n: Int) -> SkipIter[T, I]
    SkipIter { inner: self, to_skip: n, skipped: false }
  end

  def zip[B, IB: Iterator[B]](self, other: IB) -> ZipIter[T, B, I, IB]
    ZipIter { a: self, b: other }
  end

  def chain[IB: Iterator[T]](self, other: IB) -> ChainIter[T, I, IB]
    ChainIter { a: self, b: other, a_done: false }
  end

  def enumerate(self) -> EnumerateIter[T, I]
    EnumerateIter { inner: self, index: 0 }
  end

  def flat_map[U, J: Iterator[U]](self, f: fn(T) -> J) -> FlatMapIter[T, U, I, J]
    FlatMapIter { outer: self, inner: Option::None, func: f }
  end

  def peekable(self) -> PeekableIter[T, I]
    PeekableIter { inner: self, peeked: Option::None }
  end

  def cloned[U: Clone](self) -> ClonedIter[U, I]
    ClonedIter { inner: self }
  end

  def fold[A](inout self: Self, init: A, f: fn(A, T) -> A) -> A inout
    var acc = init
    loop
      match self.advance()
      when Option::Some(v) then acc = f(acc, v)
      when Option::None then break
      end
    end
    acc
  end

  def join(inout self: Self, sep: str) -> String inout
    var result = "".to_string()
    var first = true
    loop
      match self.advance()
      when Option::Some(v) then
        if !first then result = result + sep end
        # We use a hack here if the trait system doesn't allow T: Display bound on this method
        # but most things joined are Strings or have a to_string() method.
        result = result + v.to_string()
        first = false
      when Option::None then break
      end
    end
    result
  end

  def collect(inout self: Self) -> Array[T] inout
    var result = Array::new()
    loop
      match self.advance()
      when Option::Some(v) then result.push(v)
      when Option::None then break
      end
    end
    result
  end

  def count(inout self: Self) -> Int inout
    var n = 0
    loop
      match self.advance()
      when Option::Some(_) then n = n + 1
      when Option::None then break
      end
    end
    n
  end

  def any(inout self: Self, p: fn(T) -> Bool) -> Bool inout
    loop
      match self.advance()
      when Option::Some(v) then if p(&v) then return true end
      when Option::None then break
      end
    end
    false
  end

  def all(inout self: Self, p: fn(T) -> Bool) -> Bool inout
    loop
      match self.advance()
      when Option::Some(v) then if !p(&v) then return false end
      when Option::None then break
      end
    end
    true
  end

  def find(inout self: Self, p: fn(T) -> Bool) -> Option[T] inout
    loop
      match self.advance()
      when Option::Some(v) then if p(&v) then return Option::Some(v) end
      when Option::None then return Option::None
      end
    end
  end

  def for_each(inout self: Self, f: fn(T) -> Unit) -> Unit inout
    loop
      match self.advance()
      when Option::Some(v) then f(v)
      when Option::None then break
      end
    end
  end

  def last(inout self: Self) -> Option[T] inout
    var result = Option::None
    loop
      match self.advance()
      when Option::Some(v) then result = Option::Some(v)
      when Option::None then break
      end
    end
    result
  end

  def nth(inout self: Self, n: Int) -> Option[T] inout
    var i = 0
    loop
      match self.advance()
      when Option::Some(v) then
        if i == n then return Option::Some(v) end
        i = i + 1
      when Option::None then return Option::None
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Chunk and Window iterators
# ———————————————————————————————————————————————————————————————

struct ChunksIter[T, I: Iterator[T]]
  inner: I
  size: Int
end

impl[T, I: Iterator[T]] Iterator[Array[T]] for ChunksIter[T, I]
  def advance(inout self: Self) -> Option[Array[T]] inout
    var chunk = Array::new()
    var i = 0
    while i < self.size do
      match self.inner.advance()
      when Option::Some(v) then chunk.push(v)
      when Option::None then break
      end
      i = i + 1
    end
    if chunk.is_empty() then return Option::None end
    Option::Some(chunk)
  end
end

struct WindowsIter[T: Copy]
  data: Array[T]
  size: Int
  pos: Int
end

impl[T: Copy] Iterator[Array[T]] for WindowsIter[T]
  def advance(inout self: Self) -> Option[Array[T]] inout
    if self.pos + self.size > self.data.len() then return Option::None end
    let window = self.data.slice(self.pos, self.pos + self.size)
    self.pos = self.pos + 1
    Option::Some(window)
  end
end

## Chunk an iterator into groups of `size`.
def chunks[T, I: Iterator[T]](iter: I, size: Int) -> ChunksIter[T, I]
  assert(size > 0, "chunk size must be positive")
  ChunksIter { inner: iter, size: size }
end

## Sliding windows over an array.
def windows[T: Copy](data: Array[T], size: Int) -> WindowsIter[T]
  assert(size > 0, "window size must be positive")
  WindowsIter { data: data.clone(), size: size, pos: 0 }
end

# ———————————————————————————————————————————————————————————————
# Range iterator (convenience)
# ———————————————————————————————————————————————————————————————

struct RangeIter
  current: Int
  end_val: Int
  step: Int
end

impl Iterator[Int] for RangeIter
  def advance(inout self: Self) -> Option[Int] inout
    if self.step > 0 && self.current < self.end_val then
      let v = self.current
      self.current = self.current + self.step
      return Option::Some(v)
    end
    if self.step < 0 && self.current > self.end_val then
      let v = self.current
      self.current = self.current + self.step
      return Option::Some(v)
    end
    Option::None
  end
end

def range(start: Int, end_val: Int) -> RangeIter
  RangeIter { current: start, end_val: end_val, step: 1 }
end

def range_step(start: Int, end_val: Int, step: Int) -> RangeIter
  assert(step != 0, "step must not be zero")
  RangeIter { current: start, end_val: end_val, step: step }
end

# --- Additional Array methods (separate impl blocks to avoid error cascading) ---
impl[T] Array[T]
  def set(inout self: Self, index: Int, sink value: T) -> Unit inout
    __intrinsic_array_set(self, index, value)
  end

  # Raw-pointer access: returns a POINTER, never an owned element — the
  # safe language cannot obtain a resource value through as_ptr (that would
  # be a linearity bypass). Pointer conversion lives behind the unsafe/FFI
  # boundary: the pointer itself is a normal value; DEREFERENCING it is an
  # unsafe operation.
  def as_ptr(self: Self) -> Ptr[T]
    __intrinsic_array_as_ptr(self)
  end

  def as_mut_ptr(inout self: Self) -> PtrMut[T] inout
    __intrinsic_array_as_mut_ptr(self)
  end

  # The projected MUTABLE VIEW: { as_mut_ptr, len } — the view onto
  # [0, len). The view's len is the writable extent (a Read through this
  # view requests exactly len bytes).
  def as_mut_slice(inout self: Self) -> SliceMut[T] inout
    SliceMut { ptr: self.as_mut_ptr(), len: self.len() as UInt }
  end

  # The view onto the Vec's SPARE CAPACITY [len, capacity): the spare
  # region is the writable extent of a growable buffer (capacity - len
  # elements) — a fill_buf-style refill reads through this view, so a
  # cleared buffer still requests its full capacity, never zero bytes.
  def spare_capacity_mut(inout self: Self) -> SliceMut[T] inout
    let elem = size_of[T]() as Int
    SliceMut {
      ptr: (self.as_mut_ptr() as Int + self.len() * elem) as PtrMut[T],
      len: (self.capacity() - self.len()) as UInt
    }
  end
end

# The Clone-bounded clone: element-wise duplication under the T: Clone
# surface — the Copy-gated clone above bit-copies element words; a
# Clone-only element (String, aggregates, smart pointers) must be
# duplicated through its concrete Clone instance, never by raw copy.
impl[T: Clone] Array[T]
  def clone(self: Self) -> Array[T]
    var out = Vec::new()
    var i = 0
    while i < self.len() do
      out.push(self[i].clone())
      i = i + 1
    end
    out
  end
end

# The raw-read Array helpers (get/slice — Copy-gated) back every method that
# duplicates element values: reverse/last/clone/starts_with bit-copy element
# words out of the shared storage, so they are Copy-only like get/slice.
impl[T: Copy] Array[T]
  def reverse(inout self: Self) -> Unit inout
    var i = 0
    var j = self.len() - 1
    while i < j do
      let tmp = self.get(i)
      self.set(i, self.get(j))
      self.set(j, tmp)
      i = i + 1
      j = j - 1
    end
  end

  def last(self: Self) -> Option[T]
    if self.is_empty() then
      return Option::None
    end
    Option::Some(self[self.len() - 1])
  end

  def clone(self: Self) -> Array[T]
    self.slice(0, self.len())
  end

  def starts_with(self: Self, prefix: Array[T]) -> Bool
    if prefix.len() > self.len() then
      return false
    end
    var i = 0
    while i < prefix.len() do
      if self.get(i) != prefix.get(i) then
        return false
      end
      i = i + 1
    end
    true
  end
end

impl[T: Copy + Display] Array[T]
  def join(self: Self, sep: str) -> String
    var result = String::new()
    var i = 0
    while i < self.len() do
      if i > 0 then
        result.push_str(sep)
      end
      let s = self.get(i).to_string()
      result.push_str(s.as_str())
      i = i + 1
    end
    result
  end

  def to_string(self: Self) -> String
    var result = String::new()
    result.push_str("[")
    var i = 0
    while i < self.len() do
      if i > 0 then
        result.push_str(", ")
      end
      let s = self.get(i).to_string()
      result.push_str(s.as_str())
      i = i + 1
    end
    result.push_str("]")
    result
  end
end

# --- Additional Map methods (separate impl blocks) ---
impl[K: Hash + Eq + Clone, V: Clone] Map[K, V]
  # Clone materializes a copied entries array (entries_cloned — every key
  # and value an explicit clone()) and inserts each cloned pair into the
  # fresh map: the result owns its entries and never shares a pointer with
  # the source map. The loop reads each pair through the PROJECTED slot
  # (`items[i].0` / `items[i].1` — the clone receivers are the element
  # addresses; no owned (K, V) intermediate is ever extracted from the
  # snapshot — the read-then-clone shape).
  def clone(self: Self) -> Map[K, V]
    var result = Map::new()
    let items = self.entries_cloned()
    var i = 0
    while i < items.len() do
      result.insert(items[i].0.clone(), items[i].1.clone())
      i = i + 1
    end
    result
  end
end

impl[K: Hash + Eq, V: Copy] Map[K, V]
  def unwrap(self: Self, key: K) -> V
    match self.get(key)
    when Option::Some(v) then v
    when Option::None then panic("Map::unwrap: key not found")
    end
  end
end

# --- Additional Set methods (separate impl blocks) ---
impl[T: Hash + Eq + Clone] Set[T]
  # Clone materializes a copied element array (set_entries_cloned — the
  # clone-aware traversal: every element an explicit clone() out of the
  # live hash-table slots) and inserts an explicit clone of every element
  # into the fresh set: the result owns its elements and never shares a
  # pointer with the source set. The loop reads each element through the
  # PROJECTED slot (`items[i]` — the clone receiver is the element's
  # address; no owned intermediate is ever extracted from the snapshot —
  # the read-then-clone shape).
  def clone(self: Self) -> Set[T]
    var result = Set::new()
    let items = self.entries_cloned()
    var i = 0
    while i < items.len() do
      result.insert(items[i].clone())
      i = i + 1
    end
    result
  end
end

impl[T: Copy] Set[T]
  def unwrap(self: Self, item: T) -> T
    if self.contains(item) then
      *item
    else
      panic("Set::unwrap: item not found")
    end
  end
end
