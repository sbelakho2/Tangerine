## Tangerine Standard Library — std::collections
## Array, Map, Set, Iterator traits

struct Vec[T]
  # Compiler intrinsic: growable array
  # ptr: *T, len: Int, cap: Int
end

struct VecDeque[T]
  front: Vec[T]
  back: Vec[T]
end

# vec![a, b, c] is syntax sugar for Vec::from([a, b, c]).
# The compiler expands vec! at parse time into an Array literal.
macro vec!(items: expr)
  Vec::from([items])
end

struct Map[K: Hash + Eq, V]
  # Compiler intrinsic: hash map
end

struct Set[T: Hash + Eq]
  # Compiler intrinsic: hash set
end

extern def __intrinsic_array_len[T](arr: &Array[T]) -> Int
extern def __intrinsic_array_push[T](arr: &mut Array[T], item: T) -> Unit
extern def __intrinsic_array_pop[T](arr: &mut Array[T]) -> Option[T]
extern def __intrinsic_array_get[T](arr: &Array[T], index: Int) -> T
extern def __intrinsic_array_new[T]() -> Array[T]

extern def __intrinsic_map_new[K, V]() -> Map[K, V]
extern def __intrinsic_map_get[K, V](m: &Map[K, V], key: &K) -> Option[V]
extern def __intrinsic_map_insert[K, V](m: &mut Map[K, V], key: K, value: V) -> Option[V]

extern def __intrinsic_set_new[T]() -> Set[T]
extern def __intrinsic_set_contains[T](s: &Set[T], item: &T) -> Bool
extern def __intrinsic_set_insert[T](s: &mut Set[T], item: T) -> Bool

extern def __intrinsic_array_remove[T](arr: &mut Array[T], index: Int) -> T
extern def __intrinsic_array_insert[T](arr: &mut Array[T], index: Int, item: T) -> Unit
extern def __intrinsic_array_clear[T](arr: &mut Array[T]) -> Unit
extern def __intrinsic_array_from_list[T](items: &[T]) -> Array[T]
extern def __intrinsic_array_contains[T: Eq](arr: &Array[T], item: &T) -> Bool
extern def __intrinsic_array_capacity[T](arr: &Array[T]) -> Int
extern def __intrinsic_array_slice[T](arr: &Array[T], start: Int, end_idx: Int) -> Array[T]
extern def __intrinsic_array_extend[T](arr: &mut Array[T], other: &Array[T]) -> Unit
extern def __intrinsic_array_with_capacity[T](cap: Int) -> Array[T]

extern def __intrinsic_map_len[K, V](m: &Map[K, V]) -> Int
extern def __intrinsic_map_contains_key[K, V](m: &Map[K, V], key: &K) -> Bool
extern def __intrinsic_map_remove[K, V](m: &mut Map[K, V], key: &K) -> Option[V]
extern def __intrinsic_map_clear[K, V](m: &mut Map[K, V]) -> Unit
extern def __intrinsic_map_entries[K, V](m: &Map[K, V]) -> Vec[(K, V)]

extern def __intrinsic_set_len[T](s: &Set[T]) -> Int
extern def __intrinsic_set_remove[T](s: &mut Set[T], item: &T) -> Bool
extern def __intrinsic_set_clear[T](s: &mut Set[T]) -> Unit
extern def __intrinsic_set_entries[T](s: &Set[T]) -> Vec[T]

trait Iterator[T]
  def advance(self: &mut Self) -> Option[T]
end

trait IntoIterator[T]
  def into_iter(self) -> Iterator[T]
end

trait Iterable[T]
  def iter(self: &Self) -> Iterator[T]
end

# Array methods (compiler intrinsics)
def array_len[T](arr: &Array[T]) -> Int
  # Compiler intrinsic
  __intrinsic_array_len(arr)
end

def array_push[T](arr: &mut Array[T], item: T) -> Unit
  # Compiler intrinsic
  __intrinsic_array_push(arr, item)
end

def array_pop[T](arr: &mut Array[T]) -> Option[T]
  # Compiler intrinsic
  __intrinsic_array_pop(arr)
end

# Copy-producing generic wrapper: requires T: Copyable so a resource element
# can never be duplicated through a shared read (the intrinsic-level checker
# rule only sees monomorphic calls; the generic wrapper needs the bound).
def array_get[T: Copyable](arr: &Array[T], index: Int) -> T
  # Compiler intrinsic
  __intrinsic_array_get(arr, index)
end

def array_new[T]() -> Array[T]
  # Compiler intrinsic
  __intrinsic_array_new()
end

# Map methods
def map_new[K, V]() -> Map[K, V]
  # Compiler intrinsic
  __intrinsic_map_new()
end

def map_get[K, V](m: &Map[K, V], key: &K) -> Option[V]
  # Compiler intrinsic
  __intrinsic_map_get(m, key)
end

def map_insert[K, V](m: &mut Map[K, V], key: K, value: V) -> Option[V]
  # Compiler intrinsic
  __intrinsic_map_insert(m, key, value)
end

# Set methods
def set_new[T]() -> Set[T]
  __intrinsic_set_new()
end

def set_contains[T](s: &Set[T], item: &T) -> Bool
  __intrinsic_set_contains(s, item)
end

def set_insert[T](s: &mut Set[T], item: T) -> Bool
  __intrinsic_set_insert(s, item)
end

# ———————————————————————————————————————————————————————————————
# Iterator trait implementations for core collections
# ———————————————————————————————————————————————————————————————

struct ArrayIterator[T]
  array: Array[T]
  index: Int
end

# Vec[T] is an alias for Array[T] (see std::core), so ArrayIterator[T]
# also serves as the iterator for Vec[T]. No separate VecIterator needed.

impl[T] Iterator[T] for ArrayIterator[T]
  def advance(self: &mut Self) -> Option[T] inout
    if self.index >= array_len(self.array) then
      return Option::None
    end
    let item = array_get(self.array, self.index)
    self.index = self.index + 1
    Option::Some(item)
  end
end

impl[T: Copyable] Iterable[T] for Array[T]
  # Iteration requires T: Copyable: the iterator copies element storage
  # (self.clone() below), which is only sound for Copyable elements — a
  # resource element would be duplicated into a second owner. Resource
  # containers have no shared iteration. TODO: replace the copied-element
  # iterator with projected place-based iteration (or sink-self consuming
  # iteration) so resource containers can iterate without duplication.
  def iter(self: &mut Self) -> ArrayIterator[T] inout
    ArrayIterator { array: self.clone(), index: 0 }
  end
end

struct MapKeyIterator[K, V]
  entries: Vec[(K, V)]
  index: Int
end

impl[K, V] Iterator[K] for MapKeyIterator[K, V]
  def advance(self: &mut Self) -> Option[K] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let entry = self.entries[self.index]
    self.index = self.index + 1
    Option::Some(entry.0)
  end
end

struct MapValueIterator[K, V]
  entries: Vec[(K, V)]
  index: Int
end

impl[K, V] Iterator[V] for MapValueIterator[K, V]
  def advance(self: &mut Self) -> Option[V] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let entry = self.entries[self.index]
    self.index = self.index + 1
    Option::Some(entry.1)
  end
end

struct MapIterator[K, V]
  entries: Vec[(K, V)]
  index: Int
end

impl[K, V] Iterator[(K, V)] for MapIterator[K, V]
  def advance(self: &mut Self) -> Option[(K, V)] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let entry = self.entries[self.index]
    self.index = self.index + 1
    Option::Some(entry)
  end
end

impl[K: Hash + Eq, V: Copyable] Iterable[(K, V)] for Map[K, V]
  # Iteration requires Copyable values: the iterator materializes copied
  # entry arrays (self.entries()), which would duplicate resource values.
  # TODO: projected place iteration / sink-self consuming iteration.
  def iter(self: &mut Self) -> MapIterator[K, V] inout
    MapIterator { entries: self.entries(), index: 0 }
  end
end

# ———————————————————————————————————————————————————————————————
# Collection impl blocks
# ———————————————————————————————————————————————————————————————

impl[T] Array[T]
  def new() -> Array[T]
    __intrinsic_array_new()
  end

  def with_capacity(cap: Int) -> Array[T]
    __intrinsic_array_with_capacity(cap)
  end

  def len(self: &Self) -> Int
    __intrinsic_array_len(self)
  end

  def capacity(self: &Self) -> Int
    __intrinsic_array_capacity(self)
  end

  def is_empty(self: &Self) -> Bool
    self.len() == 0
  end

  def push(self: &mut Self, item: T) -> Unit inout
    __intrinsic_array_push(self, item)
  end

  def pop(self: &mut Self) -> Option[T] inout
    __intrinsic_array_pop(self)
  end

  def remove(self: &mut Self, index: Int) -> T inout
    __intrinsic_array_remove(self, index)
  end

  def insert(self: &mut Self, index: Int, item: T) -> Unit inout
    __intrinsic_array_insert(self, index, item)
  end

  def clear(self: &mut Self) -> Unit inout
    __intrinsic_array_clear(self)
  end
end

# Copy-producing Array APIs require T: Copyable — a shared read or a copy
# must never manufacture a second owner of a resource element. Resource
# elements are extracted with the consuming inout APIs above (pop/remove).
impl[T: Copyable] Array[T]
  def from(items: &[T]) -> Array[T]
    __intrinsic_array_from_list(items)
  end

  def get(self: &Self, index: Int) -> T
    __intrinsic_array_get(self, index)
  end

  def slice(self: &Self, start: Int, end_idx: Int) -> Array[T]
    __intrinsic_array_slice(self, start, end_idx)
  end

  def extend(self: &mut Self, other: &Array[T]) -> Unit inout
    __intrinsic_array_extend(self, other)
  end
end

impl[T] VecDeque[T]
  def new() -> VecDeque[T]
    VecDeque {
      front: Array::new(),
      back: Array::new()
    }
  end

  def len(self: &Self) -> Int
    self.front.len() + self.back.len()
  end

  def is_empty(self: &Self) -> Bool
    self.front.is_empty() && self.back.is_empty()
  end

  def push_back(self: &mut Self, item: T) -> Unit inout
    self.back.push(item)
  end

  def pop_front(self: &mut Self) -> Option[T] inout
    if self.front.is_empty() then
      while !self.back.is_empty() do
        match self.back.pop()
        when Option::Some(item) then self.front.push(item)
        when Option::None then break
        end
      end
    end

    self.front.pop()
  end
end

impl[T: Eq] VecDeque[T]
  def contains(self: &Self, item: &T) -> Bool
    self.front.contains(item) || self.back.contains(item)
  end
end

impl[T: Eq] Array[T]
  def contains(self: &Self, item: &T) -> Bool
    __intrinsic_array_contains(self, item)
  end
end

impl[K, V] Map[K, V]
  def new() -> Map[K, V]
    __intrinsic_map_new()
  end

  def insert(self: &mut Self, key: K, value: V) -> Option[V] inout
    __intrinsic_map_insert(self, key, value)
  end

  def remove(self: &mut Self, key: &K) -> Option[V] inout
    __intrinsic_map_remove(self, key)
  end

  def contains_key(self: &Self, key: &K) -> Bool
    __intrinsic_map_contains_key(self, key)
  end

  def len(self: &Self) -> Int
    __intrinsic_map_len(self)
  end

  def is_empty(self: &Self) -> Bool
    self.len() == 0
  end

  def clear(self: &mut Self) -> Unit inout
    __intrinsic_map_clear(self)
  end

  def entries(self: &Self) -> Vec[(K, V)]
    __intrinsic_map_entries(self)
  end
end

# Copy-producing Map APIs require Copyable values: a shared read or copied
# entries must never manufacture a second owner of a resource value.
# Resource values are extracted with the consuming remove(key) API.
impl[K: Hash + Eq, V: Copyable] Map[K, V]
  def get(self: &Self, key: &K) -> Option[V]
    __intrinsic_map_get(self, key)
  end

  # Shared map iteration materializes copied entry arrays (self.entries());
  # only sound for Copyable values (same contract as Map::iter above).
  def keys(self: &mut Self) -> MapKeyIterator[K, V] inout
    MapKeyIterator { entries: self.entries(), index: 0 }
  end

  def values(self: &mut Self) -> MapValueIterator[K, V] inout
    MapValueIterator { entries: self.entries(), index: 0 }
  end
end

impl[T] Set[T]
  def new() -> Set[T]
    __intrinsic_set_new()
  end

  def contains(self: &Self, item: &T) -> Bool
    __intrinsic_set_contains(self, item)
  end

  def insert(self: &mut Self, item: T) -> Bool inout
    __intrinsic_set_insert(self, item)
  end

  def remove(self: &mut Self, item: &T) -> Bool inout
    __intrinsic_set_remove(self, item)
  end

  def len(self: &Self) -> Int
    __intrinsic_set_len(self)
  end

  def is_empty(self: &Self) -> Bool
    self.len() == 0
  end

  def clear(self: &mut Self) -> Unit inout
    __intrinsic_set_clear(self)
  end
end

impl[T: Hash + Eq + Clone] Set[T]
  def union(self: &Self, other: &Set[T]) -> Set[T]
    var result = Set::new()
    let self_items = __intrinsic_set_entries(self)
    var i = 0
    while i < self_items.len() do
      result.insert(self_items[i].clone())
      i = i + 1
    end
    let other_items = __intrinsic_set_entries(other)
    i = 0
    while i < other_items.len() do
      result.insert(other_items[i].clone())
      i = i + 1
    end
    result
  end

  def intersection(self: &Self, other: &Set[T]) -> Set[T]
    var result = Set::new()
    let self_items = __intrinsic_set_entries(self)
    var i = 0
    while i < self_items.len() do
      if other.contains(&self_items[i]) then
        result.insert(self_items[i].clone())
      end
      i = i + 1
    end
    result
  end

  def difference(self: &Self, other: &Set[T]) -> Set[T]
    var result = Set::new()
    let self_items = __intrinsic_set_entries(self)
    var i = 0
    while i < self_items.len() do
      if !other.contains(&self_items[i]) then
        result.insert(self_items[i].clone())
      end
      i = i + 1
    end
    result
  end

  def is_subset(self: &Self, other: &Set[T]) -> Bool
    let self_items = __intrinsic_set_entries(self)
    var i = 0
    while i < self_items.len() do
      if !other.contains(&self_items[i]) then
        return false
      end
      i = i + 1
    end
    true
  end

  def is_superset(self: &Self, other: &Set[T]) -> Bool
    other.is_subset(self)
  end
end

# ———————————————————————————————————————————————————————————————
# SetIterator
# ———————————————————————————————————————————————————————————————

struct SetIterator[T]
  entries: Vec[T]
  index: Int
end

impl[T] Iterator[T] for SetIterator[T]
  def advance(self: &mut Self) -> Option[T] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let item = self.entries[self.index]
    self.index = self.index + 1
    Option::Some(item)
  end
end

impl[T: Copyable] Iterable[T] for Set[T]
  # Iteration requires T: Copyable: the iterator materializes copied entry
  # arrays (__intrinsic_set_entries), which would duplicate resource
  # elements. TODO: projected place iteration / sink-self consuming
  # iteration.
  def iter(self: &mut Self) -> SetIterator[T] inout
    SetIterator { entries: __intrinsic_set_entries(self), index: 0 }
  end
end

# ———————————————————————————————————————————————————————————————
# OrderedMap — insertion-order-preserving hash map
# ———————————————————————————————————————————————————————————————

struct OrderedMap[K: Hash + Eq, V]
  entries: Array[(K, V)]
  index:   Map[K, Int]   # key -> position in entries
end

impl[K: Hash + Eq, V] OrderedMap[K, V]
  def new() -> OrderedMap[K, V]
    OrderedMap { entries: Array::new(), index: Map::new() }
  end

  def len(self: &Self) -> Int
    self.entries.len()
  end

  def is_empty(self: &Self) -> Bool
    self.entries.is_empty()
  end

  def get(self: &Self, key: &K) -> Option[V]
    match self.index.get(key)
    when Option::Some(idx) then
      let pair = self.entries.get(idx)
      Option::Some(pair.1)
    when Option::None then Option::None
    end
  end

  def insert(self: &mut Self, key: K, value: V) -> Option[V] inout
    match self.index.get(&key)
    when Option::Some(idx) then
      let old = self.entries.get(idx).1.clone()
      self.entries[idx] = (key, value)
      Option::Some(old)
    when Option::None then
      let pos = self.entries.len()
      self.entries.push((key.clone(), value))
      self.index.insert(key, pos)
      Option::None
    end
  end

  def contains_key(self: &Self, key: &K) -> Bool
    self.index.contains_key(key)
  end

  def remove(self: &mut Self, key: &K) -> Option[V] inout
    match self.index.remove(key)
    when Option::Some(idx) then
      let (_, val) = self.entries.remove(idx)
      # Update indices for shifted entries
      let entries = self.index.entries()
      for (k, i) in entries do
        if i > idx then
          self.index.insert(k, i - 1)
        end
      end
      Option::Some(val)
    when Option::None then Option::None
    end
  end

  # Materializes a copied key array from a shared receiver; requires a
  # mutable receiver so resource keys cannot be duplicated (same contract
  # as the Map/Set iterators above).
  def keys(self: &mut Self) -> Array[K] inout
    var result = Array::new()
    for (k, _) in self.entries.iter() do
      result.push(k.clone())
    end
    result
  end

  def values(self: &mut Self) -> Array[V] inout
    var result = Array::new()
    for (_, v) in self.entries.iter() do
      result.push(v.clone())
    end
    result
  end

  def clear(self: &mut Self) -> Unit inout
    self.entries.clear()
    self.index.clear()
  end
end

# ———————————————————————————————————————————————————————————————
# RingBuffer — fixed-capacity circular buffer
# ———————————————————————————————————————————————————————————————

struct RingBuffer[T]
  buf: Array[Option[T]]
  head: Int
  tail: Int
  count: Int
  cap: Int
end

impl[T] RingBuffer[T]
  def new(capacity: Int) -> RingBuffer[T]
    assert(capacity > 0, "RingBuffer capacity must be positive")
    var buf = Array::with_capacity(capacity)
    var i = 0
    while i < capacity do
      buf.push(Option::None)
      i = i + 1
    end
    RingBuffer { buf: buf, head: 0, tail: 0, count: 0, cap: capacity }
  end

  def len(self: &Self) -> Int
    self.count
  end

  def capacity(self: &Self) -> Int
    self.cap
  end

  def is_empty(self: &Self) -> Bool
    self.count == 0
  end

  def is_full(self: &Self) -> Bool
    self.count == self.cap
  end

  def push_back(self: &mut Self, item: T) -> Option[T] inout
    ## Returns evicted item if buffer was full
    let evicted = if self.is_full() then
      let old = self.buf[self.head].take()
      self.head = (self.head + 1) % self.cap
      self.count = self.count - 1
      old
    else
      Option::None
    end
    self.buf[self.tail] = Option::Some(item)
    self.tail = (self.tail + 1) % self.cap
    self.count = self.count + 1
    evicted
  end

  def pop_front(self: &mut Self) -> Option[T] inout
    if self.is_empty() then return Option::None end
    let item = self.buf[self.head].take()
    self.head = (self.head + 1) % self.cap
    self.count = self.count - 1
    item
  end

  def peek_front(self: &Self) -> Option[T]
    if self.is_empty() then return Option::None end
    match self.buf[self.head]
    when Option::Some(ref v) then Option::Some(v)
    when Option::None then Option::None
    end
  end

  def clear(self: &mut Self) -> Unit inout
    while !self.is_empty() do self.pop_front() end
  end
end

# ———————————————————————————————————————————————————————————————
# Lazy Iterator Adapters
# ———————————————————————————————————————————————————————————————

struct MapIter[T, U, I: Iterator[T]]
  inner: I
  func: fn(T) -> U
end

impl[T, U, I: Iterator[T]] Iterator[U] for MapIter[T, U, I]
  def advance(self: &mut Self) -> Option[U] inout
    match self.inner.advance()
    when Option::Some(v) then Option::Some((self.func)(v))
    when Option::None then Option::None
    end
  end
end

struct FilterIter[T, I: Iterator[T]]
  inner: I
  predicate: fn(&T) -> Bool
end

impl[T, I: Iterator[T]] Iterator[T] for FilterIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    loop
      match self.inner.advance()
      when Option::Some(v) then
        if (self.predicate)(&v) then return Option::Some(v) end
      when Option::None then return Option::None
      end
    end
  end
end

struct TakeIter[T, I: Iterator[T]]
  inner: I
  remaining: Int
end

impl[T, I: Iterator[T]] Iterator[T] for TakeIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    if self.remaining <= 0 then return Option::None end
    self.remaining = self.remaining - 1
    self.inner.advance()
  end
end

struct SkipIter[T, I: Iterator[T]]
  inner: I
  to_skip: Int
  skipped: Bool
end

impl[T, I: Iterator[T]] Iterator[T] for SkipIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    if !self.skipped then
      self.skipped = true
      var i = 0
      while i < self.to_skip do
        self.inner.advance()
        i = i + 1
      end
    end
    self.inner.advance()
  end
end

struct ZipIter[A, B, IA: Iterator[A], IB: Iterator[B]]
  a: IA
  b: IB
end

def _zip_pair[A, B](left_value: A, right_value: B) -> (A, B)
  (left_value, right_value)
end

impl[A, B, IA: Iterator[A], IB: Iterator[B]] Iterator[(A, B)] for ZipIter[A, B, IA, IB]
  def advance(self: &mut Self) -> Option[(A, B)] inout
    match (self.a.advance(), self.b.advance())
    when (Option::Some(x), Option::Some(y)) then Option::Some(_zip_pair(x, y))
    else Option::None
    end
  end
end

struct ChainIter[T, IA: Iterator[T], IB: Iterator[T]]
  a: IA
  b: IB
  a_done: Bool
end

impl[T, IA: Iterator[T], IB: Iterator[T]] Iterator[T] for ChainIter[T, IA, IB]
  def advance(self: &mut Self) -> Option[T] inout
    if !self.a_done then
      match self.a.advance()
      when Option::Some(v) then return Option::Some(v)
      when Option::None then self.a_done = true
      end
    end
    self.b.advance()
  end
end

struct EnumerateIter[T, I: Iterator[T]]
  inner: I
  index: Int
end

impl[T, I: Iterator[T]] Iterator[(Int, T)] for EnumerateIter[T, I]
  def advance(self: &mut Self) -> Option[(Int, T)] inout
    match self.inner.advance()
    when Option::Some(v) then
      let i = self.index
      self.index = self.index + 1
      Option::Some((i, v))
    when Option::None then Option::None
    end
  end
end

struct FlatMapIter[T, U, I: Iterator[T], J: Iterator[U]]
  outer: I
  inner: Option[J]
  func: fn(T) -> J
end

impl[T, U, I: Iterator[T], J: Iterator[U]] Iterator[U] for FlatMapIter[T, U, I, J]
  def advance(self: &mut Self) -> Option[U] inout
    loop
      match self.inner
      when Option::Some(ref var it) then
        match it.advance()
        when Option::Some(v) then return Option::Some(v)
        when Option::None then self.inner = Option::None
        end
      when Option::None then ()
      end

      match self.outer.advance()
      when Option::Some(item) then
        self.inner = Option::Some((self.func)(item))
      when Option::None then return Option::None
      end
    end
  end
end

struct PeekableIter[T, I: Iterator[T]]
  inner: I
  peeked: Option[Option[T]]
end

impl[T, I: Iterator[T]] PeekableIter[T, I]
  def peek(self: &mut Self) -> Option[T] inout
    if self.peeked.is_none() then
      self.peeked = Option::Some(self.inner.advance())
    end
    match self.peeked
    when Option::Some(Option::Some(ref v)) then Option::Some(v)
    else Option::None
    end
  end
end

impl[T, I: Iterator[T]] Iterator[T] for PeekableIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    match self.peeked.take()
    when Option::Some(v) then v
    when Option::None then self.inner.advance()
    end
  end
end

struct ClonedIter[T: Clone, I: Iterator[T]]
  inner: I
end

impl[T: Clone, I: Iterator[T]] Iterator[T] for ClonedIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    match self.inner.advance()
    when Option::Some(v) then Option::Some(v.clone())
    when Option::None then Option::None
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Iterator extension methods (consuming adapters)
# ———————————————————————————————————————————————————————————————

## Extension methods available on any Iterator[T]
impl[T, I: Iterator[T]] I
  def map[U](self, f: fn(T) -> U) -> MapIter[T, U, I]
    MapIter { inner: self, func: f }
  end

  def filter(self, p: fn(&T) -> Bool) -> FilterIter[T, I]
    FilterIter { inner: self, predicate: p }
  end

  def take(self, n: Int) -> TakeIter[T, I]
    TakeIter { inner: self, remaining: n }
  end

  def skip(self, n: Int) -> SkipIter[T, I]
    SkipIter { inner: self, to_skip: n, skipped: false }
  end

  def zip[B, IB: Iterator[B]](self, other: IB) -> ZipIter[T, B, I, IB]
    ZipIter { a: self, b: other }
  end

  def chain[IB: Iterator[T]](self, other: IB) -> ChainIter[T, I, IB]
    ChainIter { a: self, b: other, a_done: false }
  end

  def enumerate(self) -> EnumerateIter[T, I]
    EnumerateIter { inner: self, index: 0 }
  end

  def flat_map[U, J: Iterator[U]](self, f: fn(T) -> J) -> FlatMapIter[T, U, I, J]
    FlatMapIter { outer: self, inner: Option::None, func: f }
  end

  def peekable(self) -> PeekableIter[T, I]
    PeekableIter { inner: self, peeked: Option::None }
  end

  def cloned[U: Clone](self) -> ClonedIter[U, I]
    ClonedIter { inner: self }
  end

  def fold[A](self: &mut Self, init: A, f: fn(A, T) -> A) -> A inout
    var acc = init
    loop
      match self.advance()
      when Option::Some(v) then acc = f(acc, v)
      when Option::None then break
      end
    end
    acc
  end

  def join(self: &mut Self, sep: &str) -> String inout
    var result = "".to_string()
    var first = true
    loop
      match self.advance()
      when Option::Some(v) then
        if !first then result = result + sep end
        # We use a hack here if the trait system doesn't allow T: Display bound on this method
        # but most things joined are Strings or have a to_string() method.
        result = result + v.to_string()
        first = false
      when Option::None then break
      end
    end
    result
  end

  def collect(self: &mut Self) -> Array[T] inout
    var result = Array::new()
    loop
      match self.advance()
      when Option::Some(v) then result.push(v)
      when Option::None then break
      end
    end
    result
  end

  def count(self: &mut Self) -> Int inout
    var n = 0
    loop
      match self.advance()
      when Option::Some(_) then n = n + 1
      when Option::None then break
      end
    end
    n
  end

  def any(self: &mut Self, p: fn(&T) -> Bool) -> Bool inout
    loop
      match self.advance()
      when Option::Some(v) then if p(&v) then return true end
      when Option::None then break
      end
    end
    false
  end

  def all(self: &mut Self, p: fn(&T) -> Bool) -> Bool inout
    loop
      match self.advance()
      when Option::Some(v) then if !p(&v) then return false end
      when Option::None then break
      end
    end
    true
  end

  def find(self: &mut Self, p: fn(&T) -> Bool) -> Option[T] inout
    loop
      match self.advance()
      when Option::Some(v) then if p(&v) then return Option::Some(v) end
      when Option::None then return Option::None
      end
    end
  end

  def for_each(self: &mut Self, f: fn(T) -> Unit) -> Unit inout
    loop
      match self.advance()
      when Option::Some(v) then f(v)
      when Option::None then break
      end
    end
  end

  def last(self: &mut Self) -> Option[T] inout
    var result = Option::None
    loop
      match self.advance()
      when Option::Some(v) then result = Option::Some(v)
      when Option::None then break
      end
    end
    result
  end

  def nth(self: &mut Self, n: Int) -> Option[T] inout
    var i = 0
    loop
      match self.advance()
      when Option::Some(v) then
        if i == n then return Option::Some(v) end
        i = i + 1
      when Option::None then return Option::None
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Chunk and Window iterators
# ———————————————————————————————————————————————————————————————

struct ChunksIter[T, I: Iterator[T]]
  inner: I
  size: Int
end

impl[T, I: Iterator[T]] Iterator[Array[T]] for ChunksIter[T, I]
  def advance(self: &mut Self) -> Option[Array[T]] inout
    var chunk = Array::new()
    var i = 0
    while i < self.size do
      match self.inner.advance()
      when Option::Some(v) then chunk.push(v)
      when Option::None then break
      end
      i = i + 1
    end
    if chunk.is_empty() then return Option::None end
    Option::Some(chunk)
  end
end

struct WindowsIter[T: Clone]
  data: Array[T]
  size: Int
  pos: Int
end

impl[T: Clone] Iterator[Array[T]] for WindowsIter[T]
  def advance(self: &mut Self) -> Option[Array[T]] inout
    if self.pos + self.size > self.data.len() then return Option::None end
    let window = self.data.slice(self.pos, self.pos + self.size)
    self.pos = self.pos + 1
    Option::Some(window)
  end
end

## Chunk an iterator into groups of `size`.
def chunks[T, I: Iterator[T]](iter: I, size: Int) -> ChunksIter[T, I]
  assert(size > 0, "chunk size must be positive")
  ChunksIter { inner: iter, size: size }
end

## Sliding windows over an array.
def windows[T: Clone](data: &Array[T], size: Int) -> WindowsIter[T]
  assert(size > 0, "window size must be positive")
  WindowsIter { data: data.clone(), size: size, pos: 0 }
end

# ———————————————————————————————————————————————————————————————
# Range iterator (convenience)
# ———————————————————————————————————————————————————————————————

struct RangeIter
  current: Int
  end_val: Int
  step: Int
end

impl Iterator[Int] for RangeIter
  def advance(self: &mut Self) -> Option[Int] inout
    if self.step > 0 && self.current < self.end_val then
      let v = self.current
      self.current = self.current + self.step
      return Option::Some(v)
    end
    if self.step < 0 && self.current > self.end_val then
      let v = self.current
      self.current = self.current + self.step
      return Option::Some(v)
    end
    Option::None
  end
end

def range(start: Int, end_val: Int) -> RangeIter
  RangeIter { current: start, end_val: end_val, step: 1 }
end

def range_step(start: Int, end_val: Int, step: Int) -> RangeIter
  assert(step != 0, "step must not be zero")
  RangeIter { current: start, end_val: end_val, step: step }
end

# --- Additional Array methods (separate impl block to avoid error cascading) ---
impl[T] Array[T]
  def set(self: &mut Self, index: Int, value: T) -> Unit inout
    __intrinsic_array_set(self, index, value)
  end

  def reverse(self: &mut Self) -> Unit inout
    var i = 0
    var j = self.len() - 1
    while i < j do
      let tmp = self.get(i)
      self.set(i, self.get(j))
      self.set(j, tmp)
      i = i + 1
      j = j - 1
    end
  end

  def last(self: &Self) -> Option[T]
    if self.is_empty() then
      return Option::None
    end
    Option::Some(self.get(self.len() - 1))
  end

  def clone(self: &Self) -> Array[T]
    self.slice(0, self.len())
  end

  def as_ptr(self: &Self) -> T
    __intrinsic_array_as_ptr(self)
  end

  def as_mut_ptr(self: &mut Self) -> T inout
    __intrinsic_array_as_mut_ptr(self)
  end

  def starts_with(self: &Self, prefix: &Array[T]) -> Bool
    if prefix.len() > self.len() then
      return false
    end
    var i = 0
    while i < prefix.len() do
      if self.get(i) != prefix.get(i) then
        return false
      end
      i = i + 1
    end
    true
  end

  def join(self: &Self, sep: &str) -> String
    var result = String::new()
    var i = 0
    while i < self.len() do
      if i > 0 then
        result.push_str(sep)
      end
      let s = self.get(i).to_string()
      result.push_str(s.as_str())
      i = i + 1
    end
    result
  end

  def to_string(self: &Self) -> String
    var result = String::new()
    result.push_str("[")
    var i = 0
    while i < self.len() do
      if i > 0 then
        result.push_str(", ")
      end
      let s = self.get(i).to_string()
      result.push_str(s.as_str())
      i = i + 1
    end
    result.push_str("]")
    result
  end
end

# --- Additional Map methods (separate impl block) ---
impl[K, V] Map[K, V]
  def clone(self: &Self) -> Map[K, V]
    var result = Map::new()
    let items = self.entries()
    var i = 0
    while i < items.len() do
      let pair = items.get(i)
      result.insert(pair.0, pair.1)
      i = i + 1
    end
    result
  end

  def unwrap(self: &Self, key: &K) -> V
    match self.get(key)
    when Option::Some(v) then v
    when Option::None then panic("Map::unwrap: key not found")
    end
  end
end

# --- Additional Set methods (separate impl block) ---
impl[T] Set[T]
  def clone(self: &Self) -> Set[T]
    var result = Set::new()
    let items = __intrinsic_set_entries(self)
    var i = 0
    while i < items.len() do
      result.insert(items[i])
      i = i + 1
    end
    result
  end

  def unwrap(self: &Self, item: &T) -> T
    if self.contains(item) then
      item
    else
      panic("Set::unwrap: item not found")
    end
  end
end
