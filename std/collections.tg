## Tangerine Standard Library — std::collections
## Array, Map, Set, Iterator traits

# ———————————————————————————————————————————————————————————————
# Slice[T] — ownership contract (DECIDED, reviewer's no-general-borrow model)
# ———————————————————————————————————————————————————————————————
# Slice[T] is a COMPILER-SCOPED VIEW:
#     Slice[T] = { ptr: Ptr[T], len: UInt }
# a plain two-field aggregate laid out as a 16-byte inline value
# ({ptr @ 0, len @ 8} — the layout authority's slice_view_layout in
# tg_compiler/layout_engine.tg, the same shape as StrView/FfiSlice).
#
#   owns    = false   — the view holds NO memory; it borrows the backing
#                       buffer of a Vec/Array/String/fixed array.
#   drop    = none    — a Slice local needs no destruction and is never in
#                       the resource checker's owning-container class.
#   bit copy= yes     — copying the {ptr,len} words is structurally valid;
#                       the type-copyability engine treats Slice as
#                       bit-copyable regardless of T.
#   escape  = enforced by the safe access model: safe Slice values are
#             access-scoped and non-escaping — the checker rejects a Slice
#             returned from a function, stored into longer-lived state
#             (fields/containers/statics), or captured into an escaping
#             closure, and rejects mutating/reallocating the backing buffer
#             while a view of it is live (the P0-SL registry + the
#             IterationPlan mutation scan).
#
# A Slice is NEVER a pointer to a heap {ptr,len,cap} Vec header: it carries
# no capacity, and no compiler path reads a Slice through HeapVecHeader
# offsets. The slice operations (len/get/iter/first/last/is_empty) address
# elements at ptr + i * size_of(T) with the concrete element size from the
# layout.
# ———————————————————————————————————————————————————————————————

struct Vec[T]
  # Compiler intrinsic: growable array (the Adt form of Array[T]).
  # The runtime value is a POINTER to the 32-byte heap header
  #   { data: Ptr[u8] @ 0, len: Int @ 8, cap: Int @ 16, stride: Int @ 24 }
  # (repr_header_size(Repr::HeapVecHeader) / container_field_offset in
  # tg_compiler/layout_engine.tg — the stride authority).
  #
  # `stride` is the element stride in bytes, set at creation from the
  # CONCRETE element type T (element_stride_bytes: 1/2/4/8 for immediate
  # scalars, 8 for pointer-represented values, align_up(size, align) for
  # fixed-array elements). EVERY runtime operation computes element
  # addresses as data + index*stride, copies value words with width
  # min(stride, 8), and releases cap*stride bytes on grow/destroy. There is
  # NO hardcoded 8-byte element arithmetic anywhere in the Vec ABI.
end

struct VecDeque[T]
  front: Vec[T]
  back: Vec[T]
end

# vec![a, b, c] is syntax sugar for Vec::from([a, b, c]).
# The compiler expands vec! at parse time into an Array literal.
macro vec!(items: expr)
  Vec::from([items])
end

# Map[K: Hash + Eq, V] — compiler-intrinsic hash map (P0-MAP contract).
#
# STORAGE CONTRACT (see tg_compiler/runtime.tg "Map Runtime Implementation"):
# the map is an 88-byte header { buckets, size, capacity, key_stride,
# key_align, value_stride, value_align, key_off, value_off, next_off,
# bucket_stride } over a raw bucket arena. Buckets hold the CONCRETE K and
# V INLINE: { hash @0, key bytes @key_off, value bytes @value_off, next
# @next_off } — key_off/value_off/next_off/bucket_stride are computed ONCE
# at map creation from the four layout parameters (the concrete K/V sizes
# and alignments from the layout engine) and carried in the header; the
# runtime never hardcodes bucket arithmetic. A Map[BigStruct, Another]
# therefore stores the full struct bytes, not pointers.
#
# HASH/EQ DISPATCH CONTRACT: every map operation hashes the key through
# the CONCRETE Hash::hash instance of K (a user-defined `impl Hash for
# MyKey` / `impl Eq for MyKey` dispatches — the impl methods compile to
# MyKey__hash / MyKey__eq and are called directly; generic impls are
# specialized and mangled by the monomorphizer) and compares keys through
# the CONCRETE Eq::eq instance (its address is passed to the runtime
# probe). Kernel key types (Int, String, StrView, the numeric primitives)
# dispatch to the typed runtime helpers _tg_hash_* / _tg_eq_* — their
# std::hash impls are Hasher-style (`def hash[H: Hasher]`) and do not
# match the core `def hash(self) -> Int` ABI the map surface declares.
# The old heuristic runtime hashing (_tg_runtime_hash_ptr / _tg_key_equal)
# is REMOVED from the map/set paths.
#
# The std API surface (map_new/map_insert/map_get/map_remove/...) is
# UNCHANGED; Set[T] is a Map[T, Unit] with the same storage and dispatch.
struct Map[K: Hash + Eq, V]
  # Compiler intrinsic: hash map
end

struct Set[T: Hash + Eq]
  # Compiler intrinsic: hash set (a Map[T, Unit] under the same contract)
end

extern def __intrinsic_array_len[T](arr: &Array[T]) -> Int
extern def __intrinsic_array_push[T](arr: &mut Array[T], sink item: T) -> Unit
extern def __intrinsic_array_pop[T](arr: &mut Array[T]) -> Option[T]
extern def __intrinsic_array_get[T](arr: &Array[T], index: Int) -> T
extern def __intrinsic_array_new[T]() -> Array[T]

extern def __intrinsic_map_new[K, V]() -> Map[K, V]
extern def __intrinsic_map_get[K, V](m: &Map[K, V], key: &K) -> Option[V]
extern def __intrinsic_map_insert[K, V](m: &mut Map[K, V], sink key: K, sink value: V) -> Option[V]

extern def __intrinsic_set_new[T]() -> Set[T]
extern def __intrinsic_set_contains[T](s: &Set[T], item: &T) -> Bool
extern def __intrinsic_set_insert[T](s: &mut Set[T], sink item: T) -> Bool

extern def __intrinsic_array_remove[T](arr: &mut Array[T], index: Int) -> T
extern def __intrinsic_array_insert[T](arr: &mut Array[T], index: Int, sink item: T) -> Unit
extern def __intrinsic_array_clear[T](arr: &mut Array[T]) -> Unit
extern def __intrinsic_array_from_list[T](items: &[T]) -> Array[T]
extern def __intrinsic_array_contains[T: Eq](arr: &Array[T], item: &T) -> Bool
extern def __intrinsic_array_capacity[T](arr: &Array[T]) -> Int
extern def __intrinsic_array_slice[T](arr: &Array[T], start: Int, end_idx: Int) -> Array[T]
extern def __intrinsic_array_extend[T](arr: &mut Array[T], other: &Array[T]) -> Unit
extern def __intrinsic_array_with_capacity[T](cap: Int) -> Array[T]
extern def __intrinsic_array_destroy[T](arr: &mut Array[T]) -> Unit

extern def __intrinsic_map_len[K, V](m: &Map[K, V]) -> Int
extern def __intrinsic_map_contains_key[K, V](m: &Map[K, V], key: &K) -> Bool
extern def __intrinsic_map_remove[K, V](m: &mut Map[K, V], key: &K) -> Option[V]
extern def __intrinsic_map_clear[K, V](m: &mut Map[K, V]) -> Unit
extern def __intrinsic_map_entries[K, V](m: &Map[K, V]) -> Vec[(K, V)]
extern def __intrinsic_map_drain_one[K, V](m: &mut Map[K, V]) -> Option[(K, V)]
extern def __intrinsic_map_destroy[K, V](m: &mut Map[K, V]) -> Unit

extern def __intrinsic_set_len[T](s: &Set[T]) -> Int
extern def __intrinsic_set_remove[T](s: &mut Set[T], item: &T) -> Bool
extern def __intrinsic_set_clear[T](s: &mut Set[T]) -> Unit
extern def __intrinsic_set_entries[T](s: &Set[T]) -> Vec[T]
extern def __intrinsic_set_drain_one[T](s: &mut Set[T]) -> Option[T]
extern def __intrinsic_set_destroy[T](s: &mut Set[T]) -> Unit

trait Iterator[T]
  def advance(self: &mut Self) -> Option[T]
end

trait IntoIterator[T]
  def into_iter(self) -> Iterator[T]
end

trait Iterable[T]
  def iter(self: &Self) -> Iterator[T]
end

# ———————————————————————————————————————————————————————————————
# Concurrency properties — container implementations
# (traits declared in std::core: Transferable / Shareable)
# ———————————————————————————————————————————————————————————————

impl[T: Transferable] Transferable for Vec[T] {}
impl[T: Transferable] Transferable for Array[T] {}
impl[K: Transferable, V: Transferable] Transferable for Map[K, V] {}
impl[T: Transferable] Transferable for Set[T] {}
impl[T: Shareable] Shareable for Vec[T] {}

# Array methods (compiler intrinsics)
def array_len[T](arr: &Array[T]) -> Int
  # Compiler intrinsic
  __intrinsic_array_len(arr)
end

def array_push[T](arr: &mut Array[T], sink item: T) -> Unit
  # Compiler intrinsic
  __intrinsic_array_push(arr, item)
end

def array_pop[T](arr: &mut Array[T]) -> Option[T]
  # Compiler intrinsic
  __intrinsic_array_pop(arr)
end

# Raw shared read: requires T: Copy — the semantic guarantee that raw value
# duplication is valid (the compiler's trivially-copyable structural
# property). Non-Copy elements (e.g. String) must be read through an explicit
# clone path or extracted with the consuming inout APIs.
def array_get[T: Copy](arr: &Array[T], index: Int) -> T
  # Compiler intrinsic
  __intrinsic_array_get(arr, index)
end

def array_new[T]() -> Array[T]
  # Compiler intrinsic
  __intrinsic_array_new()
end

# Map methods
def map_new[K, V]() -> Map[K, V]
  # Compiler intrinsic
  __intrinsic_map_new()
end

# Raw shared read: requires the VALUE to be Copy — a shared read must never
# duplicate a resource value (the key is borrowed read-only and is never
# duplicated by get; the materializing entries() path below is the
# key-copying surface and requires both key and value to be Copy).
def map_get[K, V: Copy](m: &Map[K, V], key: &K) -> Option[V]
  # Compiler intrinsic
  __intrinsic_map_get(m, key)
end

# Ownership-taking insert: both the key and the value are consumed INTO the
# map. When the key already exists, the OLD value is returned as an owned
# Option[V] (Some(old)) — replacement semantics: the new value is acquired
# and moved into the slot, the old value's bytes are extracted BEFORE the
# new bytes are written, and the returned Option owns the old value (the
# caller destroys it or rebinds it). A None result means the key was absent.
#
# SINK-KEY TEARDOWN (P0-OWN): the runtime PRESERVES the stored key on the
# replacement path (the map keeps its key identity); the incoming key's
# image was moved into the call but its bytes are NOT consumed by the
# runtime. For an owning K the MIR lowers this method as: the insert
# intrinsic, a branch on the returned Option's discriminant, and — on Some
# (the replacement path was taken) — the concrete K drop glue on the
# caller's incoming-key slot. The incoming key is destroyed exactly when
# the stored key was preserved.
def map_insert[K, V](m: &mut Map[K, V], sink key: K, sink value: V) -> Option[V]
  # Compiler intrinsic
  __intrinsic_map_insert(m, key, value)
end

# Set methods
def set_new[T]() -> Set[T]
  __intrinsic_set_new()
end

def set_contains[T](s: &Set[T], item: &T) -> Bool
  __intrinsic_set_contains(s, item)
end

# Ownership-taking insert: the item is consumed INTO the set. Inserting a
# key that already exists REPLACES the stored key with the new one — the
# set keeps its no-payload semantics (a set entry is a Map[T, Unit] key
# slot, so a replacement carries nothing to return beyond the presence
# result): the Bool result is `true` when the key ALREADY existed (its slot
# was replaced) and `false` when the key was ABSENT (a fresh slot was
# created).
#
# REPLACEMENT CONTRACT (P0-OWN): the runtime's found path rewrites the
# STORED element with the incoming image (extract-then-write on the key,
# symmetric with the map value replacement) and returns the fresh owned
# allocation of the OLD stored element; for an owning T the MIR lowers this
# method as: the insert intrinsic, the returned-address test, and — on the
# found path — the concrete T drop glue on the returned old element. The
# incoming item's image owns itself (it became the stored element); the old
# element is destroyed by the MIR exactly when it was replaced.
def set_insert[T](s: &mut Set[T], sink item: T) -> Bool
  __intrinsic_set_insert(s, item)
end

# ———————————————————————————————————————————————————————————————
# Iterator trait implementations for core collections
# ———————————————————————————————————————————————————————————————

# ArrayIterator is the RAW-STORAGE projection iterator: it holds a raw
# pointer (Ptr[T]) into the source array's storage plus a length snapshot
# instead of a cloned array, so advance() reads each element through the
# pointer (indexed via Ptr::offset, which scales by size_of[T]()) rather
# than from a copied snapshot.
#
# ITERATION MODEL (DECIDED): by-value shared iteration through ArrayIterator
# is COPY-ONLY — advance() returns a raw bit-copy of the element out of the
# array's storage, which is sound only for T: Copy. The COMPILER-SCOPED
# projected for-loop (the resource checker's IterationPlan / the MIR's
# lower_for_projected) is the PRIMARY iteration mechanism for Vec/Array/
# Slice: it binds each element by reference into the collection under the
# checker's projected-iteration guard (no move out of the binding, no
# mutation of the iterated collection inside the loop body). Non-Copy
# elements are never yielded by the by-value iterator; they are iterated by
# the projected for-loop or extracted with the consuming inout APIs
# (pop/remove/drain).
#
# SAFETY: the raw pointer dangles if the source array is mutated while the
# iterator is alive (push/pop/insert/remove/clear, or any operation that may
# reallocate), and the length snapshot may disagree with the live length —
# that is implementation-defined. Construction is therefore an EXPLICITLY
# UNSAFE API (unsafe_iter below): safe code never builds the raw storage
# iterator, and Vec[T] is an alias for Array[T] (see std::core), so
# ArrayIterator[T] also serves as the iterator for Vec[T]. No separate
# VecIterator needed.
struct ArrayIterator[T]
  ptr: Ptr[T]
  len: Int
  index: Int
end

impl[T: Copy] Iterator[T] for ArrayIterator[T]
  def advance(self: &mut Self) -> Option[T] inout
    if self.index >= self.len then
      return Option::None
    end
    let item = unsafe "projected element read through ArrayIterator storage pointer" do
      *(self.ptr.offset(self.index))
    end
    self.index = self.index + 1
    Option::Some(item)
  end
end

# Map snapshot iterators (the SAFE snapshot semantics). Map storage has no
# pointer-projection API: every iterator materializes a copied entries array
# (entries_cloned — each key and value an explicit clone()) and each
# advance() CLONES the element out of that snapshot, so the yielded value is
# genuinely owned. The snapshot is safe against mutation of the live map
# during iteration. The compiler-scoped projected for-loop is the follow-up
# for the common case; until then, `for (k, v) in m` iterates the
# materialized snapshot through the collection for-loop lowering.
struct MapKeyIterator[K, V]
  entries: Vec[(K, V)]
  index: Int
end

impl[K: Clone, V] Iterator[K] for MapKeyIterator[K, V]
  def advance(self: &mut Self) -> Option[K] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let entry = self.entries[self.index]
    self.index = self.index + 1
    Option::Some(entry.0.clone())
  end
end

struct MapValueIterator[K, V]
  entries: Vec[(K, V)]
  index: Int
end

impl[K, V: Clone] Iterator[V] for MapValueIterator[K, V]
  def advance(self: &mut Self) -> Option[V] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let entry = self.entries[self.index]
    self.index = self.index + 1
    Option::Some(entry.1.clone())
  end
end

# MapIterator materializes a copied entries array (entries_cloned) at
# construction: the copied snapshot is the SAFE semantics — mutating the map
# during iteration only affects this snapshot, not the live map. Projected
# map iteration is the follow-up.
struct MapIterator[K, V]
  entries: Vec[(K, V)]
  index: Int
end

impl[K: Clone, V: Clone] Iterator[(K, V)] for MapIterator[K, V]
  def advance(self: &mut Self) -> Option[(K, V)] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let entry = self.entries[self.index]
    self.index = self.index + 1
    Option::Some((entry.0.clone(), entry.1.clone()))
  end
end

impl[K: Hash + Eq + Clone, V: Clone] Iterable[(K, V)] for Map[K, V]
  # Iteration yields retained OWNED entries: the iterator materializes
  # cloned entry arrays (entries_cloned — an explicit duplication that
  # requires Clone). The copied snapshot is the SAFE semantics (mutating
  # the map during iteration only affects this snapshot, not the live map).
  # The raw materialization intrinsic (__intrinsic_map_entries) is the
  # Copy-only fast path; entries_cloned is the Clone-bound surface.
  def iter(self: &mut Self) -> MapIterator[K, V] inout
    MapIterator { entries: self.entries_cloned(), index: 0 }
  end
end

# ———————————————————————————————————————————————————————————————
# Collection impl blocks
# ———————————————————————————————————————————————————————————————

impl[T] Array[T]
  def new() -> Array[T]
    __intrinsic_array_new()
  end

  def with_capacity(cap: Int) -> Array[T]
    __intrinsic_array_with_capacity(cap)
  end

  def len(self: &Self) -> Int
    __intrinsic_array_len(self)
  end

  def capacity(self: &Self) -> Int
    __intrinsic_array_capacity(self)
  end

  def is_empty(self: &Self) -> Bool
    self.len() == 0
  end

  def push(self: &mut Self, sink item: T) -> Unit inout
    __intrinsic_array_push(self, item)
  end

  def pop(self: &mut Self) -> Option[T] inout
    __intrinsic_array_pop(self)
  end

  def remove(self: &mut Self, index: Int) -> T inout
    __intrinsic_array_remove(self, index)
  end

  def insert(self: &mut Self, index: Int, sink item: T) -> Unit inout
    __intrinsic_array_insert(self, index, item)
  end

  # Clear is an OWNERSHIP operation (P0-OWN): for trivial (no needs_drop)
  # elements the fast intrinsic stays (len = 0); for owning elements the
  # MIR emits the per-element drop loop — the concrete element glue at
  # data + i*stride for i in 0..len — and THEN len = 0 (capacity
  # retained).
  def clear(self: &mut Self) -> Unit inout
    __intrinsic_array_clear(self)
  end
end

# Raw-read Array APIs require T: Copy — a shared read or a materialized copy
# must never manufacture a second owner of a resource element. Resource
# elements are extracted with the consuming inout APIs above (pop/remove).
# String is NOT Copy (std::core: String is OWNED — moves transfer, clone()
# allocates): a shared read of a Vec[String]/Map[.., String]/Set[String]
# element must NEVER bitwise-copy the 8-byte String-object pointer — that
# would duplicate the owned buffer into a second owner without the required
# clone.
# Element reads must produce an explicit clone; owned elements are extracted
# with the consuming inout APIs.
#
# The by-value raw-storage iterator (ArrayIterator) lives HERE, under the
# Copy bound: advance() returns a raw bit-copy of each element, which is
# sound only for T: Copy. It is constructed ONLY through the explicitly-
# unsafe unsafe_iter() — the raw storage projection cannot be created from
# safe code (mutating the array during iteration is implementation-defined;
# the projected compiler-scoped for-loop is the safe iteration mechanism).
impl[T: Copy] Array[T]
  def from(items: &[T]) -> Array[T]
    __intrinsic_array_from_list(items)
  end

  def get(self: &Self, index: Int) -> T
    __intrinsic_array_get(self, index)
  end

  def slice(self: &Self, start: Int, end_idx: Int) -> Array[T]
    __intrinsic_array_slice(self, start, end_idx)
  end

  def extend(self: &mut Self, other: &Array[T]) -> Unit inout
    __intrinsic_array_extend(self, other)
  end

  # EXPLICITLY UNSAFE: constructs the raw-storage projection iterator
  # (a raw pointer into this array's storage plus a length snapshot).
  # Mutating the array while the iterator is alive is
  # implementation-defined (the pointer may dangle / the length snapshot
  # may disagree with the live length). The safe for-loop iteration is the
  # compiler-scoped projected access (the resource checker's IterationPlan).
  unsafe def unsafe_iter(self: &mut Self) -> ArrayIterator[T] inout
    unsafe "raw storage projection: mutating the array during iteration is implementation-defined" do
      ArrayIterator { ptr: self.as_ptr(), len: self.len(), index: 0 }
    end
  end
end

impl[T] VecDeque[T]
  def new() -> VecDeque[T]
    VecDeque {
      front: Array::new(),
      back: Array::new()
    }
  end

  def len(self: &Self) -> Int
    self.front.len() + self.back.len()
  end

  def is_empty(self: &Self) -> Bool
    self.front.is_empty() && self.back.is_empty()
  end

  def push_back(self: &mut Self, sink item: T) -> Unit inout
    self.back.push(item)
  end

  def pop_front(self: &mut Self) -> Option[T] inout
    if self.front.is_empty() then
      while !self.back.is_empty() do
        match self.back.pop()
        when Option::Some(item) then self.front.push(item)
        when Option::None then break
        end
      end
    end

    self.front.pop()
  end
end

impl[T: Eq] VecDeque[T]
  def contains(self: &Self, item: &T) -> Bool
    self.front.contains(item) || self.back.contains(item)
  end
end

impl[T: Eq] Array[T]
  def contains(self: &Self, item: &T) -> Bool
    __intrinsic_array_contains(self, item)
  end
end

impl[K, V] Map[K, V]
  def new() -> Map[K, V]
    __intrinsic_map_new()
  end

  # Ownership-taking insert: key and value are consumed INTO the map; the
  # returned Option[V] carries the REPLACED old value (owned) when the key
  # already existed — see the map_insert ownership contract above (the
  # sink-key teardown is MIR-side: the incoming key's drop runs on the
  # replacement path).
  def insert(self: &mut Self, sink key: K, sink value: V) -> Option[V] inout
    __intrinsic_map_insert(self, key, value)
  end

  # Ownership-taking remove: the removed VALUE is extracted as an owned
  # Option[V], and the stored KEY is DESTROYED (P0-OWN): the MIR lowers
  # this method as the ownership-transfer remove intrinsic (the runtime
  # copies the value image out into the caller's slot and unlinks the
  # record — the hash field is zeroed, the chain link stays intact — and
  # returns the removed record's key address), the concrete K drop glue on
  # the returned key address, then the Option[V] re-encode. The key bytes
  # of a removed entry never leak.
  def remove(self: &mut Self, key: &K) -> Option[V] inout
    __intrinsic_map_remove(self, key)
  end

  def drain_one(self: &mut Self) -> Option[(K, V)] inout
    __intrinsic_map_drain_one(self)
  end

  def contains_key(self: &Self, key: &K) -> Bool
    __intrinsic_map_contains_key(self, key)
  end

  def len(self: &Self) -> Int
    __intrinsic_map_len(self)
  end

  def is_empty(self: &Self) -> Bool
    self.len() == 0
  end

  # Clear is an OWNERSHIP operation (P0-OWN): the MIR decides. For trivial
  # (no needs_drop) K and V the fast intrinsic (_tg_map_clear — the hash
  # fields zeroed, size = 0) stays. For owning K or V the MIR emits the
  # DRAIN-AND-DROP loop: each live entry is unlinked through
  # __intrinsic_map_drain_one (the drain's own cleanup) and its key and
  # value are dropped through their concrete glues, until the drain returns
  # None. Either way the bucket arena and capacity are retained.
  def clear(self: &mut Self) -> Unit inout
    __intrinsic_map_clear(self)
  end

end

# Raw-read Map APIs: `get` borrows the key (the key is NEVER duplicated by a
# lookup — the runtime probes the key bytes by reference) and materializes
# only the VALUE, so it requires V: Copy and leaves K unconstrained. The
# raw entries() materialization produces (K, V) pairs — it bit-copies BOTH
# the key and the value record bytes, so it is the Copy-keys-AND-values fast
# path. Resource keys/values are extracted with the consuming inout APIs
# (remove/drain_one) or the Clone-bound entries_cloned surface below.
impl[K: Hash + Eq, V: Copy] Map[K, V]
  def get(self: &Self, key: &K) -> Option[V]
    __intrinsic_map_get(self, key)
  end
end

impl[K: Hash + Eq + Copy, V: Copy] Map[K, V]
  # Raw entries materialization: the intrinsic bit-copies the record bytes,
  # so it is sound only for Copy keys and values (the fast path).
  def entries(self: &Self) -> Vec[(K, V)]
    __intrinsic_map_entries(self)
  end
end

# Clone-bound map surfaces: entries_cloned materializes a copied entries
# array in which EVERY key and value is an explicit clone() — the pairs it
# yields are genuinely owned and never share a pointer with the live map.
# The raw materialization (__intrinsic_map_entries) builds a TRUE IMAGE
# vec: the header stride is the (K, V) tuple's category-derived element
# stride and each slot holds the tuple IMAGE inline (key at 0, value at
# t_v_off) — the consumer addresses element i at i*stride with NO pointer
# deref (the __intrinsic_array_get below reads the inline image).
# The keys()/values()/iter() snapshot iterators are built on it (their
# advance() clones each element out of the snapshot as well), so the
# materializing iteration surface is consistently Clone-based.
impl[K: Hash + Eq + Clone, V: Clone] Map[K, V]
  def entries_cloned(self: &Self) -> Vec[(K, V)]
    let raw = __intrinsic_map_entries(self)
    var out = Vec::new()
    var i = 0
    while i < raw.len() do
      let pair = __intrinsic_array_get(&raw, i)
      out.push((pair.0.clone(), pair.1.clone()))
      i = i + 1
    end
    out
  end

  def keys(self: &mut Self) -> MapKeyIterator[K, V] inout
    MapKeyIterator { entries: self.entries_cloned(), index: 0 }
  end

  def values(self: &mut Self) -> MapValueIterator[K, V] inout
    MapValueIterator { entries: self.entries_cloned(), index: 0 }
  end
end

impl[T] Set[T]
  def new() -> Set[T]
    __intrinsic_set_new()
  end

  def contains(self: &Self, item: &T) -> Bool
    __intrinsic_set_contains(self, item)
  end

  # Ownership-taking insert: the item is consumed INTO the set. Replacing an
  # existing key keeps the set's no-payload semantics — nothing is returned
  # beyond the presence result (see the set_insert replacement contract
  # above: the stored element is rewritten and the OLD element is dropped
  # MIR-side through its concrete glue).
  def insert(self: &mut Self, sink item: T) -> Bool inout
    __intrinsic_set_insert(self, item)
  end

  # Ownership-taking remove: the removed ELEMENT is DESTROYED (P0-OWN):
  # the MIR lowers this method as the ownership-transfer remove intrinsic
  # (the runtime unlinks the record — the hash field is zeroed, the chain
  # link stays intact — and returns the removed element's address), the
  # concrete T drop glue on the returned address, then the Bool result.
  # The removed element's bytes never leak.
  def remove(self: &mut Self, item: &T) -> Bool inout
    __intrinsic_set_remove(self, item)
  end

  def drain_one(self: &mut Self) -> Option[T] inout
    __intrinsic_set_drain_one(self)
  end

  def len(self: &Self) -> Int
    __intrinsic_set_len(self)
  end

  def is_empty(self: &Self) -> Bool
    self.len() == 0
  end

  # Clear is an OWNERSHIP operation (P0-OWN): for trivial (no needs_drop)
  # elements the fast intrinsic stays; for owning elements the MIR emits
  # the DRAIN-AND-DROP loop — each live element is unlinked through
  # __intrinsic_set_drain_one and dropped through its concrete glue, until
  # the drain returns None. The bucket arena and capacity are retained.
  def clear(self: &mut Self) -> Unit inout
    __intrinsic_set_clear(self)
  end
end

impl[T: Hash + Eq + Clone] Set[T]
  def union(self: &Self, other: &Set[T]) -> Set[T]
    var result = Set::new()
    let self_items = __intrinsic_set_entries(self)
    var i = 0
    while i < self_items.len() do
      result.insert(self_items[i].clone())
      i = i + 1
    end
    let other_items = __intrinsic_set_entries(other)
    i = 0
    while i < other_items.len() do
      result.insert(other_items[i].clone())
      i = i + 1
    end
    result
  end

  def intersection(self: &Self, other: &Set[T]) -> Set[T]
    var result = Set::new()
    let self_items = __intrinsic_set_entries(self)
    var i = 0
    while i < self_items.len() do
      if other.contains(&self_items[i]) then
        result.insert(self_items[i].clone())
      end
      i = i + 1
    end
    result
  end

  def difference(self: &Self, other: &Set[T]) -> Set[T]
    var result = Set::new()
    let self_items = __intrinsic_set_entries(self)
    var i = 0
    while i < self_items.len() do
      if !other.contains(&self_items[i]) then
        result.insert(self_items[i].clone())
      end
      i = i + 1
    end
    result
  end

  def is_subset(self: &Self, other: &Set[T]) -> Bool
    let self_items = __intrinsic_set_entries(self)
    var i = 0
    while i < self_items.len() do
      if !other.contains(&self_items[i]) then
        return false
      end
      i = i + 1
    end
    true
  end

  def is_superset(self: &Self, other: &Set[T]) -> Bool
    other.is_subset(self)
  end
end

# ———————————————————————————————————————————————————————————————
# SetIterator
# ———————————————————————————————————————————————————————————————

# SetIterator materializes a copied element array (__intrinsic_set_entries)
# at construction and CLONES each element out of it on advance(): the
# snapshot is the current SAFE semantics (hash-set storage has no stable
# element addresses and no pointer-projection intrinsic, so a snapshot is
# required; mutating the set during iteration only affects this snapshot).
# Projected set iteration is the follow-up.
struct SetIterator[T]
  entries: Vec[T]
  index: Int
end

impl[T: Clone] Iterator[T] for SetIterator[T]
  def advance(self: &mut Self) -> Option[T] inout
    if self.index >= self.entries.len() then
      return Option::None
    end
    let item = self.entries[self.index]
    self.index = self.index + 1
    Option::Some(item.clone())
  end
end

impl[T: Clone] Iterable[T] for Set[T]
  # Iteration yields retained OWNED elements: the iterator materializes
  # copied entry arrays (__intrinsic_set_entries) and clones each element
  # out on advance — an explicit duplication that requires Clone. The
  # copied snapshot is the current SAFE semantics (set storage exposes no
  # pointer projection). Projected set iteration is the follow-up.
  def iter(self: &mut Self) -> SetIterator[T] inout
    SetIterator { entries: __intrinsic_set_entries(self), index: 0 }
  end
end

# ———————————————————————————————————————————————————————————————
# OrderedMap — insertion-order-preserving hash map
# ———————————————————————————————————————————————————————————————

struct OrderedMap[K: Hash + Eq, V]
  entries: Array[(K, V)]
  index:   Map[K, Int]   # key -> position in entries
end

impl[K: Hash + Eq, V] OrderedMap[K, V]
  def new() -> OrderedMap[K, V]
    OrderedMap { entries: Array::new(), index: Map::new() }
  end

  def len(self: &Self) -> Int
    self.entries.len()
  end

  def is_empty(self: &Self) -> Bool
    self.entries.is_empty()
  end

  def get(self: &Self, key: &K) -> Option[V]
    match self.index.get(key)
    when Option::Some(idx) then
      # The position lookup is the Map[K, Int] get (the key is borrowed
      # read-only); the entry read is the projected indexed read (no raw
      # materialization of the (K, V) pair).
      Option::Some(self.entries[idx].1)
    when Option::None then Option::None
    end
  end

  # Ownership-taking insert: key and value are consumed INTO the map. The
  # existing-key branch clones the old value out (the retained semantics) and
  # re-initializes the entry slot with the new key/value; the returned
  # Option[V] carries the old value (owned by the caller).
  def insert(self: &mut Self, sink key: K, sink value: V) -> Option[V] inout
    match self.index.get(&key)
    when Option::Some(idx) then
      let old = self.entries[idx].1.clone()
      self.entries[idx] = (key, value)
      Option::Some(old)
    when Option::None then
      let pos = self.entries.len()
      self.entries.push((key.clone(), value))
      self.index.insert(key, pos)
      Option::None
    end
  end

  def contains_key(self: &Self, key: &K) -> Bool
    self.index.contains_key(key)
  end

  def remove(self: &mut Self, key: &K) -> Option[V] inout
    match self.index.remove(key)
    when Option::Some(idx) then
      let (_, val) = self.entries.remove(idx)
      # Update indices for shifted entries: the entries ARRAY is the
      # position authority (the projected loop is the unbounded read — no
      # raw map materialization), and every key is re-inserted as an
      # explicit clone.
      var i = idx
      while i < self.entries.len() do
        let k2 = self.entries[i].0.clone()
        self.index.insert(k2, i)
        i = i + 1
      end
      Option::Some(val)
    when Option::None then Option::None
    end
  end

  # Materializes a copied key array from a shared receiver; requires a
  # mutable receiver so resource keys cannot be duplicated (same contract
  # as the Map/Set iterators above). The for-loop is the compiler-scoped
  # iteration over the entries array (no by-value raw iterator).
  def keys(self: &mut Self) -> Array[K] inout
    var result = Array::new()
    for (k, _) in self.entries do
      result.push(k.clone())
    end
    result
  end

  def values(self: &mut Self) -> Array[V] inout
    var result = Array::new()
    for (_, v) in self.entries do
      result.push(v.clone())
    end
    result
  end

  def clear(self: &mut Self) -> Unit inout
    self.entries.clear()
    self.index.clear()
  end
end

# ———————————————————————————————————————————————————————————————
# RingBuffer — fixed-capacity circular buffer
# ———————————————————————————————————————————————————————————————

struct RingBuffer[T]
  buf: Array[Option[T]]
  head: Int
  tail: Int
  count: Int
  cap: Int
end

impl[T] RingBuffer[T]
  def new(capacity: Int) -> RingBuffer[T]
    assert(capacity > 0, "RingBuffer capacity must be positive")
    var buf = Array::with_capacity(capacity)
    var i = 0
    while i < capacity do
      buf.push(Option::None)
      i = i + 1
    end
    RingBuffer { buf: buf, head: 0, tail: 0, count: 0, cap: capacity }
  end

  def len(self: &Self) -> Int
    self.count
  end

  def capacity(self: &Self) -> Int
    self.cap
  end

  def is_empty(self: &Self) -> Bool
    self.count == 0
  end

  def is_full(self: &Self) -> Bool
    self.count == self.cap
  end

  def push_back(self: &mut Self, sink item: T) -> Option[T] inout
    ## Returns evicted item if buffer was full
    let evicted = if self.is_full() then
      let old = self.buf[self.head].take()
      self.head = (self.head + 1) % self.cap
      self.count = self.count - 1
      old
    else
      Option::None
    end
    self.buf[self.tail] = Option::Some(item)
    self.tail = (self.tail + 1) % self.cap
    self.count = self.count + 1
    evicted
  end

  def pop_front(self: &mut Self) -> Option[T] inout
    if self.is_empty() then return Option::None end
    let item = self.buf[self.head].take()
    self.head = (self.head + 1) % self.cap
    self.count = self.count - 1
    item
  end

  def peek_front(self: &Self) -> Option[T]
    if self.is_empty() then return Option::None end
    match self.buf[self.head]
    when Option::Some(ref v) then Option::Some(v)
    when Option::None then Option::None
    end
  end

  def clear(self: &mut Self) -> Unit inout
    while !self.is_empty() do self.pop_front() end
  end
end

# ———————————————————————————————————————————————————————————————
# Lazy Iterator Adapters
# ———————————————————————————————————————————————————————————————

struct MapIter[T, U, I: Iterator[T]]
  inner: I
  func: fn(T) -> U
end

impl[T, U, I: Iterator[T]] Iterator[U] for MapIter[T, U, I]
  def advance(self: &mut Self) -> Option[U] inout
    match self.inner.advance()
    when Option::Some(v) then Option::Some((self.func)(v))
    when Option::None then Option::None
    end
  end
end

struct FilterIter[T, I: Iterator[T]]
  inner: I
  predicate: fn(&T) -> Bool
end

impl[T, I: Iterator[T]] Iterator[T] for FilterIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    loop
      match self.inner.advance()
      when Option::Some(v) then
        if (self.predicate)(&v) then return Option::Some(v) end
      when Option::None then return Option::None
      end
    end
  end
end

struct TakeIter[T, I: Iterator[T]]
  inner: I
  remaining: Int
end

impl[T, I: Iterator[T]] Iterator[T] for TakeIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    if self.remaining <= 0 then return Option::None end
    self.remaining = self.remaining - 1
    self.inner.advance()
  end
end

struct SkipIter[T, I: Iterator[T]]
  inner: I
  to_skip: Int
  skipped: Bool
end

impl[T, I: Iterator[T]] Iterator[T] for SkipIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    if !self.skipped then
      self.skipped = true
      var i = 0
      while i < self.to_skip do
        self.inner.advance()
        i = i + 1
      end
    end
    self.inner.advance()
  end
end

struct ZipIter[A, B, IA: Iterator[A], IB: Iterator[B]]
  a: IA
  b: IB
end

def _zip_pair[A, B](left_value: A, right_value: B) -> (A, B)
  (left_value, right_value)
end

impl[A, B, IA: Iterator[A], IB: Iterator[B]] Iterator[(A, B)] for ZipIter[A, B, IA, IB]
  def advance(self: &mut Self) -> Option[(A, B)] inout
    match (self.a.advance(), self.b.advance())
    when (Option::Some(x), Option::Some(y)) then Option::Some(_zip_pair(x, y))
    else Option::None
    end
  end
end

struct ChainIter[T, IA: Iterator[T], IB: Iterator[T]]
  a: IA
  b: IB
  a_done: Bool
end

impl[T, IA: Iterator[T], IB: Iterator[T]] Iterator[T] for ChainIter[T, IA, IB]
  def advance(self: &mut Self) -> Option[T] inout
    if !self.a_done then
      match self.a.advance()
      when Option::Some(v) then return Option::Some(v)
      when Option::None then self.a_done = true
      end
    end
    self.b.advance()
  end
end

struct EnumerateIter[T, I: Iterator[T]]
  inner: I
  index: Int
end

impl[T, I: Iterator[T]] Iterator[(Int, T)] for EnumerateIter[T, I]
  def advance(self: &mut Self) -> Option[(Int, T)] inout
    match self.inner.advance()
    when Option::Some(v) then
      let i = self.index
      self.index = self.index + 1
      Option::Some((i, v))
    when Option::None then Option::None
    end
  end
end

struct FlatMapIter[T, U, I: Iterator[T], J: Iterator[U]]
  outer: I
  inner: Option[J]
  func: fn(T) -> J
end

impl[T, U, I: Iterator[T], J: Iterator[U]] Iterator[U] for FlatMapIter[T, U, I, J]
  def advance(self: &mut Self) -> Option[U] inout
    loop
      match self.inner
      when Option::Some(ref var it) then
        match it.advance()
        when Option::Some(v) then return Option::Some(v)
        when Option::None then self.inner = Option::None
        end
      when Option::None then ()
      end

      match self.outer.advance()
      when Option::Some(item) then
        self.inner = Option::Some((self.func)(item))
      when Option::None then return Option::None
      end
    end
  end
end

struct PeekableIter[T, I: Iterator[T]]
  inner: I
  peeked: Option[Option[T]]
end

impl[T, I: Iterator[T]] PeekableIter[T, I]
  def peek(self: &mut Self) -> Option[T] inout
    if self.peeked.is_none() then
      self.peeked = Option::Some(self.inner.advance())
    end
    match self.peeked
    when Option::Some(Option::Some(ref v)) then Option::Some(v)
    else Option::None
    end
  end
end

impl[T, I: Iterator[T]] Iterator[T] for PeekableIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    match self.peeked.take()
    when Option::Some(v) then v
    when Option::None then self.inner.advance()
    end
  end
end

struct ClonedIter[T: Clone, I: Iterator[T]]
  inner: I
end

impl[T: Clone, I: Iterator[T]] Iterator[T] for ClonedIter[T, I]
  def advance(self: &mut Self) -> Option[T] inout
    match self.inner.advance()
    when Option::Some(v) then Option::Some(v.clone())
    when Option::None then Option::None
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Iterator extension methods (consuming adapters)
# ———————————————————————————————————————————————————————————————

## Extension methods available on any Iterator[T]
impl[T, I: Iterator[T]] I
  def map[U](self, f: fn(T) -> U) -> MapIter[T, U, I]
    MapIter { inner: self, func: f }
  end

  def filter(self, p: fn(&T) -> Bool) -> FilterIter[T, I]
    FilterIter { inner: self, predicate: p }
  end

  def take(self, n: Int) -> TakeIter[T, I]
    TakeIter { inner: self, remaining: n }
  end

  def skip(self, n: Int) -> SkipIter[T, I]
    SkipIter { inner: self, to_skip: n, skipped: false }
  end

  def zip[B, IB: Iterator[B]](self, other: IB) -> ZipIter[T, B, I, IB]
    ZipIter { a: self, b: other }
  end

  def chain[IB: Iterator[T]](self, other: IB) -> ChainIter[T, I, IB]
    ChainIter { a: self, b: other, a_done: false }
  end

  def enumerate(self) -> EnumerateIter[T, I]
    EnumerateIter { inner: self, index: 0 }
  end

  def flat_map[U, J: Iterator[U]](self, f: fn(T) -> J) -> FlatMapIter[T, U, I, J]
    FlatMapIter { outer: self, inner: Option::None, func: f }
  end

  def peekable(self) -> PeekableIter[T, I]
    PeekableIter { inner: self, peeked: Option::None }
  end

  def cloned[U: Clone](self) -> ClonedIter[U, I]
    ClonedIter { inner: self }
  end

  def fold[A](self: &mut Self, init: A, f: fn(A, T) -> A) -> A inout
    var acc = init
    loop
      match self.advance()
      when Option::Some(v) then acc = f(acc, v)
      when Option::None then break
      end
    end
    acc
  end

  def join(self: &mut Self, sep: &str) -> String inout
    var result = "".to_string()
    var first = true
    loop
      match self.advance()
      when Option::Some(v) then
        if !first then result = result + sep end
        # We use a hack here if the trait system doesn't allow T: Display bound on this method
        # but most things joined are Strings or have a to_string() method.
        result = result + v.to_string()
        first = false
      when Option::None then break
      end
    end
    result
  end

  def collect(self: &mut Self) -> Array[T] inout
    var result = Array::new()
    loop
      match self.advance()
      when Option::Some(v) then result.push(v)
      when Option::None then break
      end
    end
    result
  end

  def count(self: &mut Self) -> Int inout
    var n = 0
    loop
      match self.advance()
      when Option::Some(_) then n = n + 1
      when Option::None then break
      end
    end
    n
  end

  def any(self: &mut Self, p: fn(&T) -> Bool) -> Bool inout
    loop
      match self.advance()
      when Option::Some(v) then if p(&v) then return true end
      when Option::None then break
      end
    end
    false
  end

  def all(self: &mut Self, p: fn(&T) -> Bool) -> Bool inout
    loop
      match self.advance()
      when Option::Some(v) then if !p(&v) then return false end
      when Option::None then break
      end
    end
    true
  end

  def find(self: &mut Self, p: fn(&T) -> Bool) -> Option[T] inout
    loop
      match self.advance()
      when Option::Some(v) then if p(&v) then return Option::Some(v) end
      when Option::None then return Option::None
      end
    end
  end

  def for_each(self: &mut Self, f: fn(T) -> Unit) -> Unit inout
    loop
      match self.advance()
      when Option::Some(v) then f(v)
      when Option::None then break
      end
    end
  end

  def last(self: &mut Self) -> Option[T] inout
    var result = Option::None
    loop
      match self.advance()
      when Option::Some(v) then result = Option::Some(v)
      when Option::None then break
      end
    end
    result
  end

  def nth(self: &mut Self, n: Int) -> Option[T] inout
    var i = 0
    loop
      match self.advance()
      when Option::Some(v) then
        if i == n then return Option::Some(v) end
        i = i + 1
      when Option::None then return Option::None
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Chunk and Window iterators
# ———————————————————————————————————————————————————————————————

struct ChunksIter[T, I: Iterator[T]]
  inner: I
  size: Int
end

impl[T, I: Iterator[T]] Iterator[Array[T]] for ChunksIter[T, I]
  def advance(self: &mut Self) -> Option[Array[T]] inout
    var chunk = Array::new()
    var i = 0
    while i < self.size do
      match self.inner.advance()
      when Option::Some(v) then chunk.push(v)
      when Option::None then break
      end
      i = i + 1
    end
    if chunk.is_empty() then return Option::None end
    Option::Some(chunk)
  end
end

struct WindowsIter[T: Copy]
  data: Array[T]
  size: Int
  pos: Int
end

impl[T: Copy] Iterator[Array[T]] for WindowsIter[T]
  def advance(self: &mut Self) -> Option[Array[T]] inout
    if self.pos + self.size > self.data.len() then return Option::None end
    let window = self.data.slice(self.pos, self.pos + self.size)
    self.pos = self.pos + 1
    Option::Some(window)
  end
end

## Chunk an iterator into groups of `size`.
def chunks[T, I: Iterator[T]](iter: I, size: Int) -> ChunksIter[T, I]
  assert(size > 0, "chunk size must be positive")
  ChunksIter { inner: iter, size: size }
end

## Sliding windows over an array.
def windows[T: Copy](data: &Array[T], size: Int) -> WindowsIter[T]
  assert(size > 0, "window size must be positive")
  WindowsIter { data: data.clone(), size: size, pos: 0 }
end

# ———————————————————————————————————————————————————————————————
# Range iterator (convenience)
# ———————————————————————————————————————————————————————————————

struct RangeIter
  current: Int
  end_val: Int
  step: Int
end

impl Iterator[Int] for RangeIter
  def advance(self: &mut Self) -> Option[Int] inout
    if self.step > 0 && self.current < self.end_val then
      let v = self.current
      self.current = self.current + self.step
      return Option::Some(v)
    end
    if self.step < 0 && self.current > self.end_val then
      let v = self.current
      self.current = self.current + self.step
      return Option::Some(v)
    end
    Option::None
  end
end

def range(start: Int, end_val: Int) -> RangeIter
  RangeIter { current: start, end_val: end_val, step: 1 }
end

def range_step(start: Int, end_val: Int, step: Int) -> RangeIter
  assert(step != 0, "step must not be zero")
  RangeIter { current: start, end_val: end_val, step: step }
end

# --- Additional Array methods (separate impl blocks to avoid error cascading) ---
impl[T] Array[T]
  def set(self: &mut Self, index: Int, sink value: T) -> Unit inout
    __intrinsic_array_set(self, index, value)
  end

  # Raw-pointer access: returns a POINTER, never an owned element — the
  # safe language cannot obtain a resource value through as_ptr (that would
  # be a linearity bypass). Pointer conversion lives behind the unsafe/FFI
  # boundary: the pointer itself is a normal value; DEREFERENCING it is an
  # unsafe operation.
  def as_ptr(self: &Self) -> Ptr[T]
    __intrinsic_array_as_ptr(self)
  end

  def as_mut_ptr(self: &mut Self) -> PtrMut[T] inout
    __intrinsic_array_as_mut_ptr(self)
  end
end

# The raw-read Array helpers (get/slice — Copy-gated) back every method that
# duplicates element values: reverse/last/clone/starts_with bit-copy element
# words out of the shared storage, so they are Copy-only like get/slice.
impl[T: Copy] Array[T]
  def reverse(self: &mut Self) -> Unit inout
    var i = 0
    var j = self.len() - 1
    while i < j do
      let tmp = self.get(i)
      self.set(i, self.get(j))
      self.set(j, tmp)
      i = i + 1
      j = j - 1
    end
  end

  def last(self: &Self) -> Option[T]
    if self.is_empty() then
      return Option::None
    end
    Option::Some(self[self.len() - 1])
  end

  def clone(self: &Self) -> Array[T]
    self.slice(0, self.len())
  end

  def starts_with(self: &Self, prefix: &Array[T]) -> Bool
    if prefix.len() > self.len() then
      return false
    end
    var i = 0
    while i < prefix.len() do
      if self.get(i) != prefix.get(i) then
        return false
      end
      i = i + 1
    end
    true
  end
end

impl[T: Copy + Display] Array[T]
  def join(self: &Self, sep: &str) -> String
    var result = String::new()
    var i = 0
    while i < self.len() do
      if i > 0 then
        result.push_str(sep)
      end
      let s = self.get(i).to_string()
      result.push_str(s.as_str())
      i = i + 1
    end
    result
  end

  def to_string(self: &Self) -> String
    var result = String::new()
    result.push_str("[")
    var i = 0
    while i < self.len() do
      if i > 0 then
        result.push_str(", ")
      end
      let s = self.get(i).to_string()
      result.push_str(s.as_str())
      i = i + 1
    end
    result.push_str("]")
    result
  end
end

# --- Additional Map methods (separate impl blocks) ---
impl[K: Hash + Eq + Clone, V: Clone] Map[K, V]
  # Clone materializes a copied entries array (entries_cloned — every key
  # and value an explicit clone()) and inserts each cloned pair into the
  # fresh map: the result owns its entries and never shares a pointer with
  # the source map.
  def clone(self: &Self) -> Map[K, V]
    var result = Map::new()
    let items = self.entries_cloned()
    var i = 0
    while i < items.len() do
      let pair = items[i]
      result.insert(pair.0.clone(), pair.1.clone())
      i = i + 1
    end
    result
  end
end

impl[K: Hash + Eq, V: Copy] Map[K, V]
  def unwrap(self: &Self, key: &K) -> V
    match self.get(key)
    when Option::Some(v) then v
    when Option::None then panic("Map::unwrap: key not found")
    end
  end
end

# --- Additional Set methods (separate impl blocks) ---
impl[T: Hash + Eq + Clone] Set[T]
  # Clone materializes a copied element array and inserts an explicit
  # clone() of every element into the fresh set: the result owns its
  # elements and never shares a pointer with the source set.
  def clone(self: &Self) -> Set[T]
    var result = Set::new()
    let items = __intrinsic_set_entries(self)
    var i = 0
    while i < items.len() do
      result.insert(items[i].clone())
      i = i + 1
    end
    result
  end
end

impl[T: Copy] Set[T]
  def unwrap(self: &Self, item: &T) -> T
    if self.contains(item) then
      *item
    else
      panic("Set::unwrap: item not found")
    end
  end
end
