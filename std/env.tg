# Tangerine Standard Library — tg::env
# Environment Variables
# Complete implementation using syscalls

use std::core::{Option, Result, String, StrView, Vec, Unit}
use std::args::{args}

# [METADATA]
# module: tg::env
# status: stable
# effects: [Io]
# capabilities: [Env]

# ═══════════════════════════════════════════════════════════════
# Syscall Constants
# ═══════════════════════════════════════════════════════════════

# Linux x86_64
def SYS_GETENV() -> Int = 0  # Use libc getenv via FFI
def SYS_SETENV() -> Int = 0  # Use libc setenv via FFI  
def SYS_UNSETENV() -> Int = 0  # Use libc unsetenv via FFI

# ═══════════════════════════════════════════════════════════════
# FFI to C runtime for environment operations
# ═══════════════════════════════════════════════════════════════

# _tg_env_entry is a runtime function (like _tg_arg) that returns
# the n-th envp entry as a raw borrowed C-string pointer (into the OS
# environment block), or NULL if past end. The entry is NOT owned: it must
# be read through the StrView contract and cloned before being stored.
@ffi("c")
extern def _tg_env_entry(index: Int) -> Ptr[u8]
end

# _tg_env_count returns the number of environment variable entries.
@ffi("c")
extern def _tg_env_count() -> Int
end

# _tg_str_skip returns the C-string pointer advanced by byte offset n.
# Equivalent to pointer arithmetic: str + offset. The result is still a
# borrowed pointer into the same (OS-owned) buffer.
@ffi("c")
extern def _tg_str_skip(s: Ptr[u8], offset: Int) -> Ptr[u8]
end

@ffi("c")
extern def c_setenv(name: Ptr[u8], value: Ptr[u8], overwrite: i32) -> i32
end

@ffi("c")
extern def c_unsetenv(name: Ptr[u8]) -> i32
end

@ffi("c")
extern def environ() -> Ptr[Ptr[u8]]
end

# The C `int` returns (setenv/unsetenv — the 32-bit int) declare the i32
# form; the wrappers widen with the explicit `as Int`. The pid_t and
# uid_t/gid_t externs (C int / unsigned int) are renamed c_* and wrapped
# so the public Int/UInt-typed API stays exact at the boundary.

def setenv(name: Ptr[u8], value: Ptr[u8], overwrite: Int) -> Int
  c_setenv(name, value, overwrite as i32) as Int
end

def unsetenv(name: Ptr[u8]) -> Int
  c_unsetenv(name) as Int
end

# ═══════════════════════════════════════════════════════════════
# High-level Environment Variable API
# ═══════════════════════════════════════════════════════════════

def get_env(key: String) -> Option[String]
  let count = _tg_env_count()
  let key_len = key.len()
  var i = 0
  while i < count do
    # The environment entry is a BORROWED C string (the OS environment block
    # owns the bytes): wrap the pointer plus its length into a non-owning
    # StrView (strlen-style length walk below), and only store the OWNED
    # clone via String::from_str_view.
    let entry_ptr: Ptr[u8] = _tg_env_entry(i)
    if entry_ptr.is_null() then
      return Option::None
    end
    var entry_len: Int = 0
    while *(entry_ptr.offset(entry_len)) != 0 do
      entry_len = entry_len + 1
    end
    let entry_view = StrView { ptr: entry_ptr, len: entry_len as UInt }
    if entry_len > key_len then
      # Check if entry starts with "key="
      var match_found = true
      var j = 0
      while j < key_len do
        if (*(entry_view.ptr.offset(j)) as Int) != (key.char_at(j) as Int) then
          match_found = false
          break
        end
        j = j + 1
      end
      let eq_char = *(entry_view.ptr.offset(key_len))
      if match_found && (eq_char as Int) == 61 then
        # Found it! Value part — pointer into entry after "key="
        let value_ptr: Ptr[u8] = _tg_str_skip(entry_view.ptr, key_len + 1)
        let value_view = StrView { ptr: value_ptr, len: (entry_len - key_len - 1) as UInt }
        # The view borrows the OS block; the result owns the clone.
        return Option::Some(String::from_str_view(&value_view))
      end
    end
    i = i + 1
  end
  Option::None
end

def set_env(key: String, value: String) -> Result[Unit, String]
  let key_bytes = key.bytes()
  let value_bytes = value.bytes()
  
  # Ensure null-terminated
  var key_z: Vec[u8] = key_bytes.clone()
  key_z.push(0)
  var value_z: Vec[u8] = value_bytes.clone()
  value_z.push(0)
  
  let result = setenv(key_z.as_ptr(), value_z.as_ptr(), 1)
  if result == 0 then
    Result::Ok(())
  else
    Result::Err("Failed to set environment variable".to_string())
  end
end

def remove_env(key: String) -> Result[Unit, String]
  var key_bytes = key.bytes()
  key_bytes.push(0)
  
  let result = unsetenv(key_bytes.as_ptr())
  if result == 0 then
    Result::Ok(())
  else
    Result::Err("Failed to remove environment variable".to_string())
  end
end

def get_env_or(key: String, default: String) -> String
  match get_env(key)
  when Option::Some(value) then value
  when Option::None then default
  end
end

def get_env_int(key: String) -> Option[Int]
  match get_env(key)
  when Option::Some(value) then
    match value.parse_int()
    when Result::Ok(n) then Option::Some(n)
    when Result::Err(_) then Option::None
    end
  when Option::None then Option::None
  end
end

def get_env_bool(key: String) -> Option[Bool]
  match get_env(key)
  when Option::Some(value) then
    let lower = value.to_lowercase()
    if lower == "true" || lower == "1" || lower == "yes" || lower == "on" then
      Option::Some(true)
    elsif lower == "false" || lower == "0" || lower == "no" || lower == "off" then
      Option::Some(false)
    else
      Option::None
    end
  when Option::None then Option::None
  end
end

def all_env() -> Vec[(String, String)]
  var result: Vec[(String, String)] = Vec::new()
  let env_ptr = environ()
  
  if env_ptr.is_null() then
    return result
  end
  
  var i = 0
  loop do
    let entry_ptr = *(env_ptr.offset(i))
    if entry_ptr.is_null() then break end

    # Borrowed C-string read: the environment block owns the bytes, so the
    # entry is wrapped as a non-owning StrView (pointer + strlen-style length
    # walk) and only the OWNED clone is stored below.
    var entry_len: Int = 0
    while *(entry_ptr.offset(entry_len)) != 0 do
      entry_len = entry_len + 1
    end
    let entry_view = StrView { ptr: entry_ptr, len: entry_len as UInt }

    # The owned clone — the view borrows, the String owns.
    let entry = String::from_str_view(&entry_view)
    let eq_pos = entry.find("=")
    
    match eq_pos
    when Option::Some(pos) then
      let key = entry.slice(0, pos)
      let value = entry.slice(pos + 1, entry.len())
      result.push((key, value))
    when Option::None then ()
    end
    
    i = i + 1
  end
  
  result
end

def env_keys() -> Vec[String]
  let all = all_env()
  var keys: Vec[String] = Vec::new()
  for (key, _) in all do
    keys.push(key)
  end
  keys
end

def env_contains(key: String) -> Bool
  match get_env(key)
  when Option::Some(_) then true
  when Option::None then false
  end
end

# ═══════════════════════════════════════════════════════════════
# Common Environment Variables
# ═══════════════════════════════════════════════════════════════

def home() -> String
  get_env_or("HOME".to_string(), "/".to_string())
end

def user() -> String
  get_env_or("USER".to_string(), "unknown".to_string())
end

def shell() -> String
  get_env_or("SHELL".to_string(), "/bin/sh".to_string())
end

def path() -> String
  get_env_or("PATH".to_string(), "/usr/bin:/bin".to_string())
end

def pwd() -> String
  get_env_or("PWD".to_string(), ".".to_string())
end

def editor() -> String
  get_env_or("EDITOR".to_string(), "vi".to_string())
end

def visual() -> String
  get_env_or("VISUAL".to_string(), editor())
end

def lang() -> String
  get_env_or("LANG".to_string(), "C".to_string())
end

def term() -> String
  get_env_or("TERM".to_string(), "xterm".to_string())
end

def tmpdir() -> String
  get_env_or("TMPDIR".to_string(), "/tmp".to_string())
end

def hostname() -> String
  get_env_or("HOSTNAME".to_string(), "localhost".to_string())
end

