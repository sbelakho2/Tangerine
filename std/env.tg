## Tangerine Standard Library — std::env
## Environment variables and process args

use std::io::IOError
use std::core::Vec
use std::thread::Mutex
use std::fs::{open, SYS_READ, SYS_WRITE}

static mut ENV_LOCK: Mutex = Mutex::new()

## POSIX libc FFI declarations for environment primitives
@[FFI(lib: "c")]
extern def getenv(name: *const u8) -> *const u8

@[FFI(lib: "c")]
extern def setenv(name: *const u8, value: *const u8, overwrite: Int) -> Int

@[FFI(lib: "c")]
extern def unsetenv(name: *const u8) -> Int

@[FFI(lib: "c")]
extern def getcwd(buf: *mut u8, size: u64) -> *const u8

@[FFI(lib: "c")]
extern def readlink(path: *const u8, buf: *mut u8, bufsiz: u64) -> i64

## Global argument vector, set by the runtime startup code
static mut _ARGS: Vec[String] = Vec::new()

## Called by the runtime before main() to populate args
def _set_args(argv: Vec[String]) -> Unit
  _ARGS = argv
end

def args() -> Vec[String]
  _ARGS.clone()
end

def var(name: String) -> Option[String]
  let cs = name.to_cstr()
  let ptr = getenv(cs.as_ptr())
  if ptr.is_null() then
    Option::None
  else
    Option::Some(String::from_cstr(ptr))
  end
end

def get_env(name: String) -> Option[String]
  var(name)
end

def set_var(name: String, value: String) -> Unit
  ENV_LOCK.lock()
  let name_cs = name.to_cstr()
  let val_cs = value.to_cstr()
  setenv(name_cs.as_ptr(), val_cs.as_ptr(), 1)
  ENV_LOCK.unlock()
end

def remove_var(name: String) -> Unit
  ENV_LOCK.lock()
  let cs = name.to_cstr()
  unsetenv(cs.as_ptr())
  ENV_LOCK.unlock()
end

def vars() -> Vec[(String, String)]
  ## Read all environment variables via extern environ pointer.
  let mut result = Vec::new()
  let envp = _environ()
  let mut i = 0
  while !envp.offset(i).is_null() do
    let entry = String::from_cstr(envp.offset(i).deref())
    match entry.find('=')
    when Option::Some(pos) then
      let key = entry.substring(0, pos)
      let val = entry.substring(pos + 1, entry.len())
      result.push((key, val))
    when Option::None then ()
    end
    i = i + 1
  end
  result
end

@[FFI(lib: "c")]
extern def _environ() -> *mut *mut u8

def home_dir() -> Option[String]
  var("HOME".to_string())
end

def temp_dir() -> String
  match var("TMPDIR".to_string())
  when Option::Some(d) then d
  when Option::None then "/tmp".to_string()
  end
end

def exe_path() -> Result[String, IOError]
  @cfg(target_os = "linux")
  {
    let mut buf: [u8; 4096] = [0; 4096]
    let path = "/proc/self/exe".to_cstr()
    let n = readlink(path.as_ptr(), buf.as_mut_ptr(), 4096u64)
    if n > 0i64 then
      return Result::Ok(String::from_bytes_len(&buf, n as u64))
    end
  }
  @cfg(target_os = "macos")
  {
    let mut buf: [u8; 4096] = [0; 4096]
    let mut size: u32 = 4096u32
    let rc = _NSGetExecutablePath(buf.as_mut_ptr(), &mut size)
    if rc == 0 then
      return Result::Ok(String::from_cstr(buf.as_ptr()))
    end
  }
  Result::Err(IOError::NotFound("cannot determine exe path"))
end

@cfg(target_os = "macos")
@[FFI(lib: "c")]
extern def _NSGetExecutablePath(buf: *mut u8, bufsize: *mut u32) -> Int

def current_dir() -> Result[String, IOError]
  let mut buf: [u8; 4096] = [0; 4096]
  let ptr = getcwd(buf.as_mut_ptr(), 4096u64)
  if ptr.is_null() then
    Result::Err(IOError::PermissionDenied("getcwd failed"))
  else
    Result::Ok(String::from_cstr(ptr))
  end
end
