end

@ffi("c")
extern def getppid() -> Int
end

@ffi("c")
extern def getuid() -> UInt
end

@ffi("c")
extern def getgid() -> UInt
end

@ffi("c")
extern def geteuid() -> UInt
end

@ffi("c")
extern def getegid() -> UInt
end

def current_pid() -> Int
  getpid()
end

def parent_pid() -> Int
  getppid()
end

def current_uid() -> UInt
  getuid()
end

def current_gid() -> UInt
  getgid()
end

def current_euid() -> UInt
  geteuid()
end

def current_egid() -> UInt
  getegid()
end

# ═══════════════════════════════════════════════════════════════
# Current Executable Path
# ═══════════════════════════════════════════════════════════════

@ffi("c")
extern def readlink(path: &u8, buf: &u8, size: UInt) -> Int
end

def current_exe() -> Result[String, String]
  # Linux: read /proc/self/exe
  # macOS: use _NSGetExecutablePath or proc_pidpath
  
  var buf: Vec[u8] = Vec::with_capacity(4096)
  buf.resize(4096, 0)
  
  # Try Linux /proc/self/exe first
  let proc_path = "/proc/self/exe".to_string()
  var proc_bytes = proc_path.bytes()
  proc_bytes.push(0)
  
  let result = readlink(proc_bytes.as_ptr(), buf.as_mut_ptr(), 4096)
  
  if result > 0 then
    buf.truncate(result)
    Result::Ok(String::from_utf8(buf))
  else
    # Fallback: try argv[0] or use platform-specific method
    # On macOS, we would use _NSGetExecutablePath
    match get_env("_".to_string())
    when Option::Some(exe_path) then
      # Check if it's an absolute path
      if exe_path.starts_with("/") then
        Result::Ok(exe_path)
      else
        # Try to resolve relative path
        match current_dir()
        when Result::Ok(cwd) then
          Result::Ok(cwd + "/" + exe_path)
        when Result::Err(e) then
          Result::Err(e)
        end
      end
    when Option::None then
      Result::Err("Could not determine executable path".to_string())
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Working Directory
# ═══════════════════════════════════════════════════════════════

@ffi("c")
extern def chdir(path: &u8) -> Int
end

@ffi("c")
extern def getcwd(buf: &u8, size: UInt) -> &u8
end

def set_current_dir(path: String) -> Result[Unit, String]
  var path_bytes = path.bytes()
  path_bytes.push(0)
  
  let result = chdir(path_bytes.as_ptr())
  if result == 0 then
    Result::Ok(())
  else
    Result::Err("Failed to change directory".to_string())
  end
end

def current_dir() -> Result[String, String]
  var buf: Vec[u8] = Vec::with_capacity(4096)
  buf.resize(4096, 0)
  
  let result = getcwd(buf.as_mut_ptr(), 4096)
  if result.is_null() then
    Result::Err("Failed to get current directory".to_string())
  else
    # Find null terminator
    var len = 0
    while len < buf.len() && buf[len] != 0 do
      len = len + 1
    end
    buf.truncate(len)
    Result::Ok(String::from_utf8(buf))
  end
end