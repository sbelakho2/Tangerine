## Tangerine Standard Library — std::env
## Environment variables and process args

use std::io::IOError

extern def __intrinsic_env_args() -> Array[String]
extern def __intrinsic_env_var(name: String) -> Option[String]
extern def __intrinsic_env_set_var(name: String, value: String) -> Unit
extern def __intrinsic_env_current_dir() -> Result[String, IOError]
extern def __intrinsic_env_remove_var(name: String) -> Unit
extern def __intrinsic_env_vars() -> Array[(String, String)]
extern def __intrinsic_env_home_dir() -> Option[String]
extern def __intrinsic_env_temp_dir() -> String
extern def __intrinsic_env_exe_path() -> Result[String, IOError]

def args() -> Array[String]
  # Compiler intrinsic: return command line arguments
  __intrinsic_env_args()
end

def var(name: String) -> Option[String]
  # Compiler intrinsic: get environment variable
  __intrinsic_env_var(name)
end


def get_env(name: String) -> Option[String]
  var(name)
end

def set_var(name: String, value: String) -> Unit
  # Compiler intrinsic: set environment variable
  __intrinsic_env_set_var(name, value)
end

def remove_var(name: String) -> Unit
  # Remove an environment variable from the process environment.
  __intrinsic_env_remove_var(name)
end

def vars() -> Array[(String, String)]
  # Return all environment variables as (name, value) pairs.
  __intrinsic_env_vars()
end

def home_dir() -> Option[String]
  # Return the user's home directory, if it can be determined.
  # Reads $HOME on POSIX, %USERPROFILE% on Windows.
  __intrinsic_env_home_dir()
end

def temp_dir() -> String
  # Return the system temporary directory path.
  # Reads $TMPDIR on macOS/POSIX, /tmp as fallback.
  __intrinsic_env_temp_dir()
end

def exe_path() -> Result[String, IOError]
  # Return the path to the currently running executable.
  # Uses /proc/self/exe on Linux, _NSGetExecutablePath on macOS.
  __intrinsic_env_exe_path()
end

def current_dir() -> Result[String, IOError]
  # Compiler intrinsic
  __intrinsic_env_current_dir()
end
