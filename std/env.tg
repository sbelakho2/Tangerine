## Tangerine Standard Library — std::env
## Environment variables and process args

use std::io::IOError

extern def __intrinsic_env_args() -> Array[String]
extern def __intrinsic_env_var(name: String) -> Option[String]
extern def __intrinsic_env_set_var(name: String, value: String) -> Unit
extern def __intrinsic_env_current_dir() -> Result[String, IOError]

def args() -> Array[String]
  # Compiler intrinsic: return command line arguments
  __intrinsic_env_args()
end

def var(name: String) -> Option[String]
  # Compiler intrinsic: get environment variable
  __intrinsic_env_var(name)
end

def set_var(name: String, value: String) -> Unit
  # Compiler intrinsic: set environment variable
  __intrinsic_env_set_var(name, value)
end

def current_dir() -> Result[String, IOError]
  # Compiler intrinsic
  __intrinsic_env_current_dir()
end
