# Tangerine Standard Library — tg::env
# Environment Variables
# Complete implementation using syscalls

use std::core::{Option, Result, String, Vec, Unit}
use std::args::{args}

# [METADATA]
# module: tg::env
# status: stable
# effects: [Io]
# capabilities: [Env]

# ═══════════════════════════════════════════════════════════════
# Syscall Constants
# ═══════════════════════════════════════════════════════════════

# Linux x86_64
def SYS_GETENV() -> Int = 0  # Use libc getenv via FFI
def SYS_SETENV() -> Int = 0  # Use libc setenv via FFI  
def SYS_UNSETENV() -> Int = 0  # Use libc unsetenv via FFI

# ═══════════════════════════════════════════════════════════════
# FFI to C runtime for environment operations
# ═══════════════════════════════════════════════════════════════

# _tg_env_entry is a runtime function (like _tg_arg) that returns
# the n-th envp entry as a raw C string pointer, or NULL if past end.
@ffi("c")
extern def _tg_env_entry(index: Int) -> String
end

# _tg_env_count returns the number of environment variable entries.
@ffi("c")
extern def _tg_env_count() -> Int
end

# _tg_str_skip returns a string starting at byte offset n.
# Equivalent to pointer arithmetic: str + offset.
@ffi("c")
extern def _tg_str_skip(s: String, offset: Int) -> String
end

@ffi("c")
extern def setenv(name: &u8, value: &u8, overwrite: Int) -> Int
end

@ffi("c")
extern def unsetenv(name: &u8) -> Int
end

@ffi("c")
extern def environ() -> &&u8
end

# ═══════════════════════════════════════════════════════════════
# High-level Environment Variable API
# ═══════════════════════════════════════════════════════════════

def get_env(key: String) -> Option[String]
  let count = _tg_env_count()
  let key_len = key.len()
  var i = 0
  while i < count do
    let entry: String = _tg_env_entry(i)
    let entry_len = entry.len()
    if entry_len > key_len then
      # Check if entry starts with "key="
      var match_found = true
      var j = 0
      while j < key_len do
        if entry.char_at(j) != key.char_at(j) then
          match_found = false
          break
        end
        j = j + 1
      end
      let eq_char = entry.char_at(key_len)
      if match_found then
      end
      if match_found && eq_char == 61 then
        # Found it! Return value part — pointer into entry after "key="
        let value = _tg_str_skip(entry, key_len + 1)
        return Option::Some(value)
      end
    end
    i = i + 1
  end
  Option::None
end

def set_env(key: String, value: String) -> Result[Unit, String]
  let key_bytes = key.bytes()
  let value_bytes = value.bytes()
  
  # Ensure null-terminated
  var key_z: Vec[u8] = key_bytes.clone()
  key_z.push(0)
  var value_z: Vec[u8] = value_bytes.clone()
  value_z.push(0)
  
  let result = setenv(key_z.as_ptr(), value_z.as_ptr(), 1)
  if result == 0 then
    Result::Ok(())
  else
    Result::Err("Failed to set environment variable".to_string())
  end
end

def remove_env(key: String) -> Result[Unit, String]
  var key_bytes = key.bytes()
  key_bytes.push(0)
  
  let result = unsetenv(key_bytes.as_ptr())
  if result == 0 then
    Result::Ok(())
  else
    Result::Err("Failed to remove environment variable".to_string())
  end
end

def get_env_or(key: String, default: String) -> String
  match get_env(key)
  when Option::Some(value) then value
  when Option::None then default
  end
end

def get_env_int(key: String) -> Option[Int]
  match get_env(key)
  when Option::Some(value) then
    match value.parse_int()
    when Option::Some(n) then Option::Some(n)
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

def get_env_bool(key: String) -> Option[Bool]
  match get_env(key)
  when Option::Some(value) then
    let lower = value.to_lowercase()
    if lower == "true" || lower == "1" || lower == "yes" || lower == "on" then
      Option::Some(true)
    elsif lower == "false" || lower == "0" || lower == "no" || lower == "off" then
      Option::Some(false)
    else
      Option::None
    end
  when Option::None then Option::None
  end
end

def all_env() -> Vec[(String, String)]
  var result: Vec[(String, String)] = Vec::new()
  let env_ptr = environ()
  
  if env_ptr.is_null() then
    return result
  end
  
  var i = 0
  loop do
    let entry_ptr = env_ptr.offset(i).read()
    if entry_ptr.is_null() then break end
    
    # Read entry string (KEY=VALUE format)
    var bytes: Vec[u8] = Vec::new()
    var j = 0
    loop do
      let b = entry_ptr.offset(j).read()
      if b == 0 then break end
      bytes.push(b)
      j = j + 1
    end
    
    let entry = String::from_utf8(bytes)
    let eq_pos = entry.find("=")
    
    match eq_pos
    when Option::Some(pos) then
      let key = entry.slice(0, pos)
      let value = entry.slice(pos + 1, entry.len())
      result.push((key, value))
    when Option::None then ()
    end
    
    i = i + 1
  end
  
  result
end

def env_keys() -> Vec[String]
  let all = all_env()
  var keys: Vec[String] = Vec::new()
  for (key, _) in all do
    keys.push(key)
  end
  keys
end

def env_contains(key: String) -> Bool
  match get_env(key)
  when Option::Some(_) then true
  when Option::None then false
  end
end

# ═══════════════════════════════════════════════════════════════
# Common Environment Variables
# ═══════════════════════════════════════════════════════════════

def home() -> String
  get_env_or("HOME".to_string(), "/".to_string())
end

def user() -> String
  get_env_or("USER".to_string(), "unknown".to_string())
end

def shell() -> String
  get_env_or("SHELL".to_string(), "/bin/sh".to_string())
end

def path() -> String
  get_env_or("PATH".to_string(), "/usr/bin:/bin".to_string())
end

def pwd() -> String
  get_env_or("PWD".to_string(), ".".to_string())
end

def editor() -> String
  get_env_or("EDITOR".to_string(), "vi".to_string())
end

def visual() -> String
  get_env_or("VISUAL".to_string(), editor())
end

def lang() -> String
  get_env_or("LANG".to_string(), "C".to_string())
end

def term() -> String
  get_env_or("TERM".to_string(), "xterm".to_string())
end

def tmpdir() -> String
  get_env_or("TMPDIR".to_string(), "/tmp".to_string())
end

def hostname() -> String
  get_env_or("HOSTNAME".to_string(), "localhost".to_string())
end

