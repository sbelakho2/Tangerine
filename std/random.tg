## std::random — Random number generation
## Provides both cryptographically-secure and fast pseudo-random RNGs.
## Spec: §stdlib.random

module std::random

use std::core::{Result, Option}
use std::crypto  ## for secure_random bytes

# ─── RNG trait ───────────────────────────────────────────────────────

## Trait for all random number generators.
pub trait Rng
  ## Generate next random u64
  def next_u64(self) -> UInt

  ## Generate next random u32
  def next_u32(self) -> UInt
    (self.next_u64() >> 32) as UInt
  end

  ## Generate random bytes filling the given buffer
  def fill_bytes(self, buf: &mut [u8]) -> Unit
    var i = 0
    while i < buf.len() do
      let val = self.next_u64()
      let remaining = buf.len() - i
      let to_copy = if remaining >= 8 then 8 else remaining end
      for j in 0..to_copy do
        buf[i + j] = ((val >> (j * 8)) & 0xFF) as u8
      end
      i = i + to_copy
    end
  end

  ## Generate random integer in [0, bound)
  def next_int_below(self, bound: Int) -> Int
    pre bound > 0, "bound must be positive"
    let b = bound as UInt
    ## Rejection sampling for uniform distribution
    let threshold = (0 - b) % b  ## = (2^64 - b) % b
    loop
      let r = self.next_u64()
      if r >= threshold then
        return (r % b) as Int
      end
    end
  end

  ## Generate random integer in [low, high]
  def next_int_range(self, low: Int, high: Int) -> Int
    pre low <= high, "low must <= high"
    low + self.next_int_below(high - low + 1)
  end

  ## Generate random Float in [0.0, 1.0)
  def next_float(self) -> Float
    let bits = self.next_u64() >> 11  ## 53 bits
    (bits as Float) * (1.0 / ((1u64 << 53) as Float))
  end

  ## Generate random Float in [low, high)
  def next_float_range(self, low: Float, high: Float) -> Float
    low + self.next_float() * (high - low)
  end

  ## Generate random Bool
  def next_bool(self) -> Bool
    (self.next_u64() & 1) == 1
  end

  ## Generate random Bool with given probability of true
  def next_bool_weighted(self, probability: Float) -> Bool
    self.next_float() < probability
  end

  ## Choose random element from a slice
  def choose[T](self, items: &[T]) -> Option[&T]
    if items.len() == 0 then return None end
    Some(&items[self.next_int_below(items.len() as Int)])
  end

  ## Shuffle a mutable slice in-place (Fisher-Yates)
  def shuffle[T](self, items: &mut [T]) -> Unit
    let n = items.len()
    if n <= 1 then return end
    for i in (1..n).rev() do
      let j = self.next_int_below((i + 1) as Int)
      items.swap(i, j as UInt)
    end
  end

  ## Sample n items from a slice without replacement
  def sample[T: Clone](self, items: &[T], n: Int) -> Vec[T]
    pre n >= 0, "sample count must be non-negative"
    pre n as UInt <= items.len(), "sample count exceeds items length"
    ## Partial Fisher-Yates
    var indices = Vec[Int].new()
    for i in 0..items.len() do
      indices.push(i as Int)
    end
    var result = Vec[T].with_capacity(n as UInt)
    for i in 0..n do
      let j = self.next_int_range(i, (items.len() as Int) - 1)
      let idx_i = indices.get(i as UInt).unwrap()
      let idx_j = indices.get(j as UInt).unwrap()
      indices.set(i as UInt, idx_j)
      indices.set(j as UInt, idx_i)
      result.push(items[idx_j as UInt].clone())
    end
    result
  end
end

# ─── Xoshiro256** — Fast non-crypto PRNG ────────────────────────────

## Xoshiro256** (Blackman & Vigna, 2018) — fast, high-quality PRNG.
## Period: 2^256 - 1. NOT suitable for cryptographic use.
pub struct Xoshiro256StarStar
  s0: UInt
  s1: UInt
  s2: UInt
  s3: UInt
end

impl Xoshiro256StarStar
  ## Create from a 64-bit seed, expanded via SplitMix64
  pub def from_seed(seed: UInt) -> Xoshiro256StarStar
    var sm = SplitMix64 { state: seed }
    Xoshiro256StarStar {
      s0: sm.next_u64(),
      s1: sm.next_u64(),
      s2: sm.next_u64(),
      s3: sm.next_u64(),
    }
  end

  ## Create from entropy (system random)
  pub def from_entropy() -> Xoshiro256StarStar
    let bytes = crypto::random_bytes(32)
    Xoshiro256StarStar {
      s0: _u64_from_bytes(bytes, 0),
      s1: _u64_from_bytes(bytes, 8),
      s2: _u64_from_bytes(bytes, 16),
      s3: _u64_from_bytes(bytes, 24),
    }
  end

  ## Jump equivalent to 2^128 calls — for parallel streams
  pub def jump(&mut self) -> Unit
    let jump_table: [UInt; 4] = [
      0x180ec6d33cfd0aba, 0xd5a61266f0c9392c,
      0xa9582618e03fc9aa, 0x39abdc4529b1661c,
    ]
    var s0: UInt = 0
    var s1: UInt = 0
    var s2: UInt = 0
    var s3: UInt = 0
    for i in 0..4 do
      for b in 0..64 do
        if (jump_table[i] >> b) & 1 != 0 then
          s0 = s0 ^ self.s0
          s1 = s1 ^ self.s1
          s2 = s2 ^ self.s2
          s3 = s3 ^ self.s3
        end
        self.next_u64()
      end
    end
    self.s0 = s0
    self.s1 = s1
    self.s2 = s2
    self.s3 = s3
  end
end

impl Rng for Xoshiro256StarStar
  def next_u64(self) -> UInt
    let result = _rotl(self.s1 * 5, 7) * 9
    let t = self.s1 << 17
    self.s2 = self.s2 ^ self.s0
    self.s3 = self.s3 ^ self.s1
    self.s1 = self.s1 ^ self.s2
    self.s0 = self.s0 ^ self.s3
    self.s2 = self.s2 ^ t
    self.s3 = _rotl(self.s3, 45)
    result
  end
end

# ─── SplitMix64 — Simple PRNG (for seeding) ─────────────────────────

## SplitMix64 — fast splittable PRNG, used primarily for seeding.
pub struct SplitMix64
  state: UInt
end

impl SplitMix64
  pub def new(seed: UInt) -> SplitMix64
    SplitMix64 { state: seed }
  end
end

impl Rng for SplitMix64
  def next_u64(self) -> UInt
    self.state = self.state + 0x9e3779b97f4a7c15
    var z = self.state
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) * 0x94d049bb133111eb
    z ^ (z >> 31)
  end
end

# ─── PCG-XSH-RR — Compact PRNG ──────────────────────────────────────

## PCG-XSH-RR-64/32 (O'Neill, 2014) — compact, statistically excellent.
pub struct Pcg32
  state: UInt
  inc: UInt
end

impl Pcg32
  pub def new(seed: UInt, seq: UInt = 1) -> Pcg32
    var rng = Pcg32 { state: 0, inc: (seq << 1) | 1 }
    rng.next_u32()
    rng.state = rng.state + seed
    rng.next_u32()
    rng
  end

  pub def from_entropy() -> Pcg32
    let bytes = crypto::random_bytes(16)
    let seed = _u64_from_bytes(bytes, 0)
    let seq = _u64_from_bytes(bytes, 8)
    Pcg32.new(seed, seq)
  end
end

impl Rng for Pcg32
  def next_u64(self) -> UInt
    let hi = self.next_u32() as UInt
    let lo = self.next_u32() as UInt
    (hi << 32) | lo
  end

  def next_u32(self) -> UInt
    let old_state = self.state
    self.state = old_state * 6364136223846793005 + self.inc
    let xorshifted = (((old_state >> 18) ^ old_state) >> 27) as UInt
    let rot = (old_state >> 59) as UInt
    ((xorshifted >> rot) | (xorshifted << ((0 - rot) & 31))) & 0xFFFFFFFF
  end
end

# ─── CryptoRng — Secure random ──────────────────────────────────────

## Cryptographically secure RNG backed by OS entropy (/dev/urandom, getrandom).
pub struct CryptoRng end

impl CryptoRng
  pub def new() -> CryptoRng = CryptoRng {}
end

impl Rng for CryptoRng
  def next_u64(self) -> UInt
    let bytes = crypto::random_bytes(8)
    _u64_from_bytes(bytes, 0)
  end

  def next_u32(self) -> UInt
    let bytes = crypto::random_bytes(4)
    _u32_from_bytes(bytes, 0)
  end

  def fill_bytes(self, buf: &mut [u8]) -> Unit
    let rand_bytes = crypto::random_bytes(buf.len() as Int)
    for i in 0..buf.len() do
      buf[i] = rand_bytes[i]
    end
  end
end

# ─── Distributions ───────────────────────────────────────────────────

pub trait Distribution[T]
  def sample[R: Rng](self, rng: &mut R) -> T
end

## Uniform distribution over [low, high)
pub struct Uniform[T]
  low: T
  high: T
end

impl Uniform[Int]
  pub def new(low: Int, high: Int) -> Uniform[Int]
    pre low < high, "Uniform range must be non-empty"
    Uniform { low: low, high: high }
  end
end

impl Distribution[Int] for Uniform[Int]
  def sample[R: Rng](self, rng: &mut R) -> Int
    rng.next_int_range(self.low, self.high - 1)
  end
end

impl Uniform[Float]
  pub def new(low: Float, high: Float) -> Uniform[Float]
    pre low < high, "Uniform range must be non-empty"
    Uniform { low: low, high: high }
  end
end

impl Distribution[Float] for Uniform[Float]
  def sample[R: Rng](self, rng: &mut R) -> Float
    rng.next_float_range(self.low, self.high)
  end
end

## Normal (Gaussian) distribution — Box-Muller transform
pub struct Normal
  mean: Float
  stddev: Float
end

impl Normal
  pub def new(mean: Float, stddev: Float) -> Normal
    pre stddev > 0.0, "standard deviation must be positive"
    Normal { mean: mean, stddev: stddev }
  end

  pub def standard() -> Normal
    Normal { mean: 0.0, stddev: 1.0 }
  end
end

impl Distribution[Float] for Normal
  def sample[R: Rng](self, rng: &mut R) -> Float
    ## Box-Muller transform
    let u1 = rng.next_float()
    let u2 = rng.next_float()
    let z0 = std::math::sqrt(-2.0 * std::math::log(u1)) * std::math::cos(2.0 * std::math::PI * u2)
    self.mean + z0 * self.stddev
  end
end

## Bernoulli distribution
pub struct Bernoulli
  p: Float
end

impl Bernoulli
  pub def new(p: Float) -> Bernoulli
    pre p >= 0.0 && p <= 1.0, "probability must be in [0, 1]"
    Bernoulli { p: p }
  end
end

impl Distribution[Bool] for Bernoulli
  def sample[R: Rng](self, rng: &mut R) -> Bool
    rng.next_float() < self.p
  end
end

## Exponential distribution
pub struct Exponential
  lambda: Float
end

impl Exponential
  pub def new(lambda: Float) -> Exponential
    pre lambda > 0.0, "lambda must be positive"
    Exponential { lambda: lambda }
  end
end

impl Distribution[Float] for Exponential
  def sample[R: Rng](self, rng: &mut R) -> Float
    -std::math::log(1.0 - rng.next_float()) / self.lambda
  end
end

## Weighted index distribution
pub struct WeightedIndex
  cumulative: Vec[Float]
end

impl WeightedIndex
  pub def new(weights: &[Float]) -> Result[WeightedIndex, String]
    if weights.len() == 0 then return Err("weights must be non-empty") end
    var cum = Vec[Float].with_capacity(weights.len())
    var total = 0.0
    for w in weights do
      if w < 0.0 then return Err("weights must be non-negative") end
      total = total + w
      cum.push(total)
    end
    if total <= 0.0 then return Err("total weight must be positive") end
    ## Normalize
    for i in 0..cum.len() do
      cum.set(i, cum.get(i).unwrap() / total)
    end
    Ok(WeightedIndex { cumulative: cum })
  end
end

impl Distribution[Int] for WeightedIndex
  def sample[R: Rng](self, rng: &mut R) -> Int
    let r = rng.next_float()
    ## Binary search
    var lo = 0
    var hi = self.cumulative.len() as Int - 1
    while lo < hi do
      let mid = lo + (hi - lo) / 2
      if self.cumulative.get(mid as UInt).unwrap() <= r then
        lo = mid + 1
      else
        hi = mid
      end
    end
    lo
  end
end

# ─── Global convenience functions ────────────────────────────────────

## Thread-local default RNG (auto-seeded from entropy)
var _thread_rng: Option[Xoshiro256StarStar] = None

pub def thread_rng() -> &mut Xoshiro256StarStar
  match _thread_rng
  when None then
    _thread_rng = Some(Xoshiro256StarStar.from_entropy())
    &mut _thread_rng.unwrap()
  when Some(ref mut rng) then
    rng
  end
end

pub def random_int(low: Int, high: Int) -> Int
  thread_rng().next_int_range(low, high)
end

pub def random_float() -> Float
  thread_rng().next_float()
end

pub def random_bool() -> Bool
  thread_rng().next_bool()
end

pub def random_bytes(n: Int) -> Vec[u8]
  var buf = Vec[u8].with_capacity(n as UInt)
  for _ in 0..n do buf.push(0u8) end
  thread_rng().fill_bytes(&mut buf)
  buf
end

pub def secure_random_bytes(n: Int) -> Vec[u8]
  crypto::random_bytes(n)
end

pub def secure_random_u64() -> UInt
  CryptoRng.new().next_u64()
end

# ─── Helpers ─────────────────────────────────────────────────────────

def _rotl(x: UInt, k: Int) -> UInt
  (x << k) | (x >> (64 - k))
end

def _u64_from_bytes(bytes: &[u8], offset: Int) -> UInt
  var result: UInt = 0
  for i in 0..8 do
    result = result | ((bytes[offset + i] as UInt) << (i * 8))
  end
  result
end

def _u32_from_bytes(bytes: &[u8], offset: Int) -> UInt
  var result: UInt = 0
  for i in 0..4 do
    result = result | ((bytes[offset + i] as UInt) << (i * 8))
  end
  result
end

end ## module std::random
