# Tangerine Standard Library — tg::image
# Image codec and bitmap types.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 9.

use std::core::{Option, Result, String, Bool, Int, Unit}
use std::geom::{ColorSpace}
use std::gfx_errors::{Error, ErrorCode}
use std::app::{FsCap}

# ═══════════════════════════════════════════════════════════════
# §9 Types
# ═══════════════════════════════════════════════════════════════

enum PixelFormat
  RGBA8
  BGRA8
  RGBAF16
end

struct ImageInfo
  w: Int
  h: Int
  format: PixelFormat
  color_space: ColorSpace
end

struct Bitmap
  info: ImageInfo
  stride: Int
  data: Vec[u8]
end

struct DecodeOpts
  normalize: Bool   # When true, convert to RGBA8/sRGB regardless of source format
end

struct EncodeOpts
  quality: Int      # 0..100 for lossy codecs; 100 == lossless for PNG
end

# ═══════════════════════════════════════════════════════════════
# §9 ImageError
# ═══════════════════════════════════════════════════════════════

enum ImageError
  InvalidData(Error)
  UnsupportedFormat(Error)
  IOError(Error)
  Internal(Error)
end

impl ImageError
  def message(self: &ImageError) -> &String
    match self
    when ImageError::InvalidData(e) then &e.message
    when ImageError::UnsupportedFormat(e) then &e.message
    when ImageError::IOError(e) then &e.message
    when ImageError::Internal(e) then &e.message
    end
  end

  def code(self: &ImageError) -> ErrorCode
    match self
    when ImageError::InvalidData(_) then ErrorCode::InvalidArg
    when ImageError::UnsupportedFormat(_) then ErrorCode::Unsupported
    when ImageError::IOError(_) then ErrorCode::IOError
    when ImageError::Internal(_) then ErrorCode::Internal
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Defaults
# ═══════════════════════════════════════════════════════════════

def default_decode_opts() -> DecodeOpts
  DecodeOpts { normalize: true }
end

def default_encode_opts() -> EncodeOpts
  EncodeOpts { quality: 100 }
end

# ═══════════════════════════════════════════════════════════════
# §9 Module API
# ═══════════════════════════════════════════════════════════════

def decode(bytes: &Vec[u8], opts: DecodeOpts) -> Result[Bitmap, ImageError]
  # Decode in-memory image bytes (PNG, JPEG, BMP, or WebP).
  # -----------------------------------------------------------
  # Minimal PNG decoder for reference implementation.
  let len = bytes.len()
  if len < 8 then
    return Result::Err(ImageError::InvalidData(
      Error::invalid_arg("Image data too short (< 8 bytes).".to_string())
    ))
  end

  # Check PNG magic: 0x89 P N G \r \n 0x1A \n
  let is_png = bytes.get(0) == 137
            && bytes.get(1) == 80
            && bytes.get(2) == 78
            && bytes.get(3) == 71

  if !is_png then
    return Result::Err(ImageError::UnsupportedFormat(
      Error::unsupported("Only PNG format is supported in the reference decoder.".to_string())
    ))
  end

  # Reference implementation: parse IHDR for dimensions only, produce placeholder bitmap.
  # A production backend would provide a full codec via the backend plugin ABI.
  let w = _read_be_u32(bytes, 16)
  let h = _read_be_u32(bytes, 20)
  let stride = w * 4
  let data_len = stride * h
  let data = Vec::with_capacity(data_len)
  let i = 0
  while i < data_len do
    data.push(0u8)
    i = i + 1
  end

  let info = ImageInfo {
    w: w,
    h: h,
    format: PixelFormat::RGBA8,
    color_space: ColorSpace::SRGB,
  }
  Result::Ok(Bitmap { info: info, stride: stride, data: data })
end

def decode_file(path: String, fs: &FsCap, opts: DecodeOpts) -> Result[Bitmap, ImageError]
  # Read file using FsCap, then delegate to in-memory decode.
  # This is the reference implementation stub — actual file I/O
  # is provided by the FsCap capability and runtime.
  Result::Err(ImageError::IOError(
    Error::io_error("decode_file requires FsCap runtime integration; use decode() with in-memory bytes.".to_string())
  ))
end

def encode_png(bmp: &Bitmap, opts: EncodeOpts) -> Result[Vec[u8], ImageError]
  # Encode a bitmap to PNG format.
  # -----------------------------------------------------------
  let w = bmp.info.w
  let h = bmp.info.h
  if w <= 0 || h <= 0 then
    return Result::Err(ImageError::InvalidData(
      Error::invalid_arg("Bitmap dimensions must be positive.".to_string())
    ))
  end

  # Reference implementation: produce a minimal valid PNG.
  # 8-byte signature + IHDR(25) + IDAT(variable) + IEND(12).
  let out = Vec::new()

  # PNG signature
  out.push(137u8)
  out.push(80u8)
  out.push(78u8)
  out.push(71u8)
  out.push(13u8)
  out.push(10u8)
  out.push(26u8)
  out.push(10u8)

  # IHDR chunk (13 bytes data)
  _write_chunk(&out, "IHDR", _make_ihdr(w, h))

  # IDAT chunk — uncompressed deflate of raw scanlines
  let raw = _make_raw_scanlines(bmp)
  _write_chunk(&out, "IDAT", _deflate_store(raw))

  # IEND chunk (0 bytes data)
  _write_chunk(&out, "IEND", Vec::new())

  Result::Ok(out)
end

# ═══════════════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════════════

def _read_be_u32(data: &Vec[u8], offset: Int) -> Int
  let b0 = data.get(offset) as Int
  let b1 = data.get(offset + 1) as Int
  let b2 = data.get(offset + 2) as Int
  let b3 = data.get(offset + 3) as Int
  (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
end

def _write_be_u32(out: &Vec[u8], val: Int) -> Unit
  out.push(((val >> 24) & 0xFF) as u8)
  out.push(((val >> 16) & 0xFF) as u8)
  out.push(((val >> 8) & 0xFF) as u8)
  out.push((val & 0xFF) as u8)
end

def _make_ihdr(w: Int, h: Int) -> Vec[u8]
  let buf = Vec::new()
  _write_be_u32(&buf, w)          # Width
  _write_be_u32(&buf, h)          # Height
  buf.push(8u8)                    # Bit depth
  buf.push(6u8)                    # Color type: RGBA
  buf.push(0u8)                    # Compression
  buf.push(0u8)                    # Filter
  buf.push(0u8)                    # Interlace
  buf
end

def _make_raw_scanlines(bmp: &Bitmap) -> Vec[u8]
  let w = bmp.info.w
  let h = bmp.info.h
  let stride = bmp.stride
  let out = Vec::new()
  let y = 0
  while y < h do
    out.push(0u8)  # Filter byte: None
    let x = 0
    while x < w * 4 do
      let idx = y * stride + x
      out.push(bmp.data.get(idx))
      x = x + 1
    end
    y = y + 1
  end
  out
end

def _deflate_store(data: Vec[u8]) -> Vec[u8]
  # Minimal "stored" (uncompressed) zlib stream.
  let out = Vec::new()
  # zlib header: CMF=0x78, FLG=0x01
  out.push(0x78u8)
  out.push(0x01u8)

  let len = data.len()
  let offset = 0
  while offset < len do
    let block_size = len - offset
    if block_size > 65535 then
      block_size = 65535
    end
    let is_last = (offset + block_size) >= len
    if is_last then
      out.push(0x01u8)  # BFINAL=1, BTYPE=00 (no compression)
    else
      out.push(0x00u8)  # BFINAL=0, BTYPE=00
    end
    out.push((block_size & 0xFF) as u8)
    out.push(((block_size >> 8) & 0xFF) as u8)
    let nlen = block_size ^ 0xFFFF
    out.push((nlen & 0xFF) as u8)
    out.push(((nlen >> 8) & 0xFF) as u8)
    let i = 0
    while i < block_size do
      out.push(data.get(offset + i))
      i = i + 1
    end
    offset = offset + block_size
  end

  # Adler-32 checksum
  let s1 = 1
  let s2 = 0
  let j = 0
  while j < len do
    s1 = (s1 + (data.get(j) as Int)) % 65521
    s2 = (s2 + s1) % 65521
    j = j + 1
  end
  let adler = (s2 << 16) | s1
  _write_be_u32(&out, adler)

  out
end

def _crc32(data: &Vec[u8]) -> Int
  # Minimal CRC-32 for PNG chunk integrity.
  let crc = 0xFFFFFFFF
  let i = 0
  while i < data.len() do
    let byte = data.get(i) as Int
    let k = 0
    crc = crc ^ byte
    while k < 8 do
      if (crc & 1) == 1 then
        crc = (crc >> 1) ^ 0xEDB88320
      else
        crc = crc >> 1
      end
      k = k + 1
    end
    i = i + 1
  end
  crc ^ 0xFFFFFFFF
end

def _write_chunk(out: &Vec[u8], tag: String, data: Vec[u8]) -> Unit
  let data_len = data.len()
  _write_be_u32(out, data_len)

  # Tag bytes (exactly 4)
  let t = 0
  while t < 4 do
    out.push(tag.byte_at(t))
    t = t + 1
  end

  # Data
  let d = 0
  while d < data_len do
    out.push(data.get(d))
    d = d + 1
  end

  # CRC over tag + data
  let crc_input = Vec::new()
  let t2 = 0
  while t2 < 4 do
    crc_input.push(tag.byte_at(t2))
    t2 = t2 + 1
  end
  let d2 = 0
  while d2 < data_len do
    crc_input.push(data.get(d2))
    d2 = d2 + 1
  end
  let crc = _crc32(&crc_input)
  _write_be_u32(out, crc)
end
