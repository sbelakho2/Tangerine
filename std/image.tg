# Tangerine Standard Library — tg::image
# Image codec and bitmap types.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 9.

use std::core::{Option, Result, String, Bool, Int, Unit}
use std::geom::{ColorSpace}
use std::gfx_errors::{Error, ErrorCode}
use std::app::{FsCap}

# ═══════════════════════════════════════════════════════════════
# §9 Types
# ═══════════════════════════════════════════════════════════════

enum PixelFormat
  RGBA8
  BGRA8
  RGBAF16
end

struct ImageInfo
  w: Int
  h: Int
  format: PixelFormat
  color_space: ColorSpace
end

struct Bitmap
  info: ImageInfo
  stride: Int
  data: Vec[u8]
end

struct DecodeOpts
  normalize: Bool   # When true, convert to RGBA8/sRGB regardless of source format
end

struct EncodeOpts
  quality: Int      # 0..100 for lossy codecs; 100 == lossless for PNG
end

# ═══════════════════════════════════════════════════════════════
# §9 ImageError
# ═══════════════════════════════════════════════════════════════

enum ImageError
  InvalidData(Error)
  UnsupportedFormat(Error)
  IOError(Error)
  Internal(Error)
end

impl ImageError
  def message(self: &ImageError) -> &String
    match self
    when ImageError::InvalidData(e) then &e.message
    when ImageError::UnsupportedFormat(e) then &e.message
    when ImageError::IOError(e) then &e.message
    when ImageError::Internal(e) then &e.message
    end
  end

  def code(self: &ImageError) -> ErrorCode
    match self
    when ImageError::InvalidData(_) then ErrorCode::InvalidArg
    when ImageError::UnsupportedFormat(_) then ErrorCode::Unsupported
    when ImageError::IOError(_) then ErrorCode::IOError
    when ImageError::Internal(_) then ErrorCode::Internal
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Defaults
# ═══════════════════════════════════════════════════════════════

def default_decode_opts() -> DecodeOpts
  DecodeOpts { normalize: true }
end

def default_encode_opts() -> EncodeOpts
  EncodeOpts { quality: 100 }
end

# ═══════════════════════════════════════════════════════════════
# §9 Module API
# ═══════════════════════════════════════════════════════════════

def decode(bytes: &Vec[u8], opts: DecodeOpts) -> Result[Bitmap, ImageError]
  # Decode in-memory image bytes (PNG, JPEG, BMP, or WebP).
  # -----------------------------------------------------------
  # Minimal PNG decoder for reference implementation.
  let len = bytes.len()
  if len < 8 then
    return Result::Err(ImageError::InvalidData(
      Error::invalid_arg("Image data too short (< 8 bytes).".to_string())
    ))
  end

  # Check PNG magic: 0x89 P N G \r \n 0x1A \n
  let is_png = bytes.get(0) == 137
            && bytes.get(1) == 80
            && bytes.get(2) == 78
            && bytes.get(3) == 71

  if !is_png then
    return Result::Err(ImageError::UnsupportedFormat(
      Error::unsupported("Only PNG format is supported in the reference decoder.".to_string())
    ))
  end

  # Parse IHDR (first chunk after 8-byte signature)
  let w = _read_be_u32(bytes, 16)
  let h = _read_be_u32(bytes, 20)
  let bit_depth = bytes.get(24) as Int
  let color_type = bytes.get(25) as Int

  if bit_depth != 8 || (color_type != 2 && color_type != 6) then
    return Result::Err(ImageError::UnsupportedFormat(
      Error::unsupported("Only 8-bit RGB or RGBA PNG is supported.".to_string())
    ))
  end

  let channels = if color_type == 6 then 4 else 3 end

  # Collect all IDAT chunk data
  var idat_data = Vec::new()
  var pos = 8
  while pos + 8 <= bytes.len() do
    let chunk_len = _read_be_u32(bytes, pos)
    let chunk_type_0 = bytes.get(pos + 4)
    let chunk_type_1 = bytes.get(pos + 5)
    let chunk_type_2 = bytes.get(pos + 6)
    let chunk_type_3 = bytes.get(pos + 7)
    if chunk_type_0 == 73 && chunk_type_1 == 68 && chunk_type_2 == 65 && chunk_type_3 == 84 then
      # IDAT chunk
      var j = 0
      while j < chunk_len do
        idat_data.push(bytes.get(pos + 8 + j))
        j = j + 1
      end
    end
    if chunk_type_0 == 73 && chunk_type_1 == 69 && chunk_type_2 == 78 && chunk_type_3 == 68 then
      # IEND — stop
      pos = bytes.len()
    else
      pos = pos + 12 + chunk_len
    end
  end

  # Inflate (zlib stored blocks) the IDAT data
  let raw_scanlines = _inflate_stored(&idat_data)

  # Reconstruct pixels from filtered scanlines
  let stride = w * 4
  var data = Vec::with_capacity(stride * h)
  var i = 0
  while i < stride * h do
    data.push(0u8)
    i = i + 1
  end
  let src_stride = w * channels + 1

  var row = 0
  while row < h do
    let filter_byte = raw_scanlines.get(row * src_stride) as Int
    var col = 0
    while col < w * channels do
      let raw_val = raw_scanlines.get(row * src_stride + 1 + col) as Int
      let recon = _png_unfilter(filter_byte, raw_val, col, channels, row, &data, w, stride)
      let dst_col = if channels == 3 then
        (col / 3) * 4 + (col % 3)
      else
        col
      end
      data[row * stride + dst_col] = (recon & 0xFF) as u8
      # For RGB, fill alpha
      if channels == 3 && (col % 3) == 2 then
        data[row * stride + (col / 3) * 4 + 3] = 255u8
      end
      col = col + 1
    end
    row = row + 1
  end

  let info = ImageInfo {
    w: w,
    h: h,
    format: PixelFormat::RGBA8,
    color_space: ColorSpace::SRGB,
  }
  Result::Ok(Bitmap { info: info, stride: stride, data: data })
end

def decode_file(path: String, fs: &FsCap, opts: DecodeOpts) -> Result[Bitmap, ImageError]
  # Read file using FsCap, then delegate to in-memory decode.
  # This is the reference implementation stub — actual file I/O
  # is provided by the FsCap capability and runtime.
  Result::Err(ImageError::IOError(
    Error::io_error("decode_file requires FsCap runtime integration; use decode() with in-memory bytes.".to_string())
  ))
end

def encode_png(bmp: &Bitmap, opts: EncodeOpts) -> Result[Vec[u8], ImageError]
  # Encode a bitmap to PNG format.
  # -----------------------------------------------------------
  let w = bmp.info.w
  let h = bmp.info.h
  if w <= 0 || h <= 0 then
    return Result::Err(ImageError::InvalidData(
      Error::invalid_arg("Bitmap dimensions must be positive.".to_string())
    ))
  end

  # Reference implementation: produce a minimal valid PNG.
  # 8-byte signature + IHDR(25) + IDAT(variable) + IEND(12).
  let out = Vec::new()

  # PNG signature
  out.push(137u8)
  out.push(80u8)
  out.push(78u8)
  out.push(71u8)
  out.push(13u8)
  out.push(10u8)
  out.push(26u8)
  out.push(10u8)

  # IHDR chunk (13 bytes data)
  _write_chunk(&out, "IHDR", _make_ihdr(w, h))

  # IDAT chunk — uncompressed deflate of raw scanlines
  let raw = _make_raw_scanlines(bmp)
  _write_chunk(&out, "IDAT", _deflate_store(raw))

  # IEND chunk (0 bytes data)
  _write_chunk(&out, "IEND", Vec::new())

  Result::Ok(out)
end

# ═══════════════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════════════

def _read_be_u32(data: &Vec[u8], offset: Int) -> Int
  let b0 = data.get(offset) as Int
  let b1 = data.get(offset + 1) as Int
  let b2 = data.get(offset + 2) as Int
  let b3 = data.get(offset + 3) as Int
  (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
end

def _inflate_stored(data: &Vec[u8]) -> Vec[u8]
  # Inflate zlib stored (uncompressed) blocks.
  # Skip 2-byte zlib header, parse DEFLATE stored blocks.
  var out = Vec::new()
  var pos = 2
  var done = false
  while !done && pos < data.len() do
    let header = data.get(pos) as Int
    let bfinal = header & 1
    let btype = (header >> 1) & 3
    pos = pos + 1
    if btype == 0 then
      # Stored block
      let len_lo = data.get(pos) as Int
      let len_hi = data.get(pos + 1) as Int
      let block_len = len_lo | (len_hi << 8)
      pos = pos + 4
      var k = 0
      while k < block_len do
        out.push(data.get(pos))
        pos = pos + 1
        k = k + 1
      end
    else
      # Compressed block — not supported in reference decoder
      done = true
    end
    if bfinal == 1 then
      done = true
    end
  end
  out
end

def _png_unfilter(filter: Int, raw: Int, col: Int, channels: Int, row: Int, data: &Vec[u8], w: Int, stride: Int) -> Int
  let bpp = channels
  if filter == 0 then
    # None
    raw
  elsif filter == 1 then
    # Sub: recon = raw + left
    let left = if col >= bpp then
      let dst_col = if channels == 3 then ((col - bpp) / 3) * 4 + ((col - bpp) % 3) else col - bpp end
      data.get(row * stride + dst_col) as Int
    else
      0
    end
    (raw + left) & 0xFF
  elsif filter == 2 then
    # Up: recon = raw + above
    let above = if row > 0 then
      let dst_col = if channels == 3 then (col / 3) * 4 + (col % 3) else col end
      data.get((row - 1) * stride + dst_col) as Int
    else
      0
    end
    (raw + above) & 0xFF
  elsif filter == 3 then
    # Average: recon = raw + floor((left + above) / 2)
    let left = if col >= bpp then
      let dst_col = if channels == 3 then ((col - bpp) / 3) * 4 + ((col - bpp) % 3) else col - bpp end
      data.get(row * stride + dst_col) as Int
    else
      0
    end
    let above = if row > 0 then
      let dst_col = if channels == 3 then (col / 3) * 4 + (col % 3) else col end
      data.get((row - 1) * stride + dst_col) as Int
    else
      0
    end
    (raw + (left + above) / 2) & 0xFF
  elsif filter == 4 then
    # Paeth
    let left = if col >= bpp then
      let dst_col = if channels == 3 then ((col - bpp) / 3) * 4 + ((col - bpp) % 3) else col - bpp end
      data.get(row * stride + dst_col) as Int
    else
      0
    end
    let above = if row > 0 then
      let dst_col = if channels == 3 then (col / 3) * 4 + (col % 3) else col end
      data.get((row - 1) * stride + dst_col) as Int
    else
      0
    end
    let above_left = if row > 0 && col >= bpp then
      let dst_col = if channels == 3 then ((col - bpp) / 3) * 4 + ((col - bpp) % 3) else col - bpp end
      data.get((row - 1) * stride + dst_col) as Int
    else
      0
    end
    let p = left + above - above_left
    let pa = if p - left >= 0 then p - left else left - p end
    let pb = if p - above >= 0 then p - above else above - p end
    let pc = if p - above_left >= 0 then p - above_left else above_left - p end
    let paeth = if pa <= pb && pa <= pc then left
    elsif pb <= pc then above
    else above_left end
    (raw + paeth) & 0xFF
  else
    raw
  end
end

def _write_be_u32(out: &Vec[u8], val: Int) -> Unit
  out.push(((val >> 24) & 0xFF) as u8)
  out.push(((val >> 16) & 0xFF) as u8)
  out.push(((val >> 8) & 0xFF) as u8)
  out.push((val & 0xFF) as u8)
end

def _make_ihdr(w: Int, h: Int) -> Vec[u8]
  let buf = Vec::new()
  _write_be_u32(&buf, w)          # Width
  _write_be_u32(&buf, h)          # Height
  buf.push(8u8)                    # Bit depth
  buf.push(6u8)                    # Color type: RGBA
  buf.push(0u8)                    # Compression
  buf.push(0u8)                    # Filter
  buf.push(0u8)                    # Interlace
  buf
end

def _make_raw_scanlines(bmp: &Bitmap) -> Vec[u8]
  let w = bmp.info.w
  let h = bmp.info.h
  let stride = bmp.stride
  let out = Vec::new()
  let y = 0
  while y < h do
    out.push(0u8)  # Filter byte: None
    let x = 0
    while x < w * 4 do
      let idx = y * stride + x
      out.push(bmp.data.get(idx))
      x = x + 1
    end
    y = y + 1
  end
  out
end

def _deflate_store(data: Vec[u8]) -> Vec[u8]
  # Minimal "stored" (uncompressed) zlib stream.
  let out = Vec::new()
  # zlib header: CMF=0x78, FLG=0x01
  out.push(0x78u8)
  out.push(0x01u8)

  let len = data.len()
  let offset = 0
  while offset < len do
    let block_size = len - offset
    if block_size > 65535 then
      block_size = 65535
    end
    let is_last = (offset + block_size) >= len
    if is_last then
      out.push(0x01u8)  # BFINAL=1, BTYPE=00 (no compression)
    else
      out.push(0x00u8)  # BFINAL=0, BTYPE=00
    end
    out.push((block_size & 0xFF) as u8)
    out.push(((block_size >> 8) & 0xFF) as u8)
    let nlen = block_size ^ 0xFFFF
    out.push((nlen & 0xFF) as u8)
    out.push(((nlen >> 8) & 0xFF) as u8)
    let i = 0
    while i < block_size do
      out.push(data.get(offset + i))
      i = i + 1
    end
    offset = offset + block_size
  end

  # Adler-32 checksum
  let s1 = 1
  let s2 = 0
  let j = 0
  while j < len do
    s1 = (s1 + (data.get(j) as Int)) % 65521
    s2 = (s2 + s1) % 65521
    j = j + 1
  end
  let adler = (s2 << 16) | s1
  _write_be_u32(&out, adler)

  out
end

def _crc32(data: &Vec[u8]) -> Int
  # Minimal CRC-32 for PNG chunk integrity.
  let crc = 0xFFFFFFFF
  let i = 0
  while i < data.len() do
    let byte = data.get(i) as Int
    let k = 0
    crc = crc ^ byte
    while k < 8 do
      if (crc & 1) == 1 then
        crc = (crc >> 1) ^ 0xEDB88320
      else
        crc = crc >> 1
      end
      k = k + 1
    end
    i = i + 1
  end
  crc ^ 0xFFFFFFFF
end

def _write_chunk(out: &Vec[u8], tag: String, data: Vec[u8]) -> Unit
  let data_len = data.len()
  _write_be_u32(out, data_len)

  # Tag bytes (exactly 4)
  let t = 0
  while t < 4 do
    out.push(tag.byte_at(t))
    t = t + 1
  end

  # Data
  let d = 0
  while d < data_len do
    out.push(data.get(d))
    d = d + 1
  end

  # CRC over tag + data
  let crc_input = Vec::new()
  let t2 = 0
  while t2 < 4 do
    crc_input.push(tag.byte_at(t2))
    t2 = t2 + 1
  end
  let d2 = 0
  while d2 < data_len do
    crc_input.push(data.get(d2))
    d2 = d2 + 1
  end
  let crc = _crc32(&crc_input)
  _write_be_u32(out, crc)
end
