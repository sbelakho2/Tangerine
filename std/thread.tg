# Tangerine Standard Library — Threading & Synchronization
#
# [METADATA]
# module: tg::thread
# status: alpha
# effects: [Kernel]
# capabilities: [Unsafe]
# error_codes: [ThreadCreationError, JoinError, Internal]
# description: "POSIX threads (pthreads) based threading, synchronization, and atomic operations."
# examples:
#   - |
#     use std::thread::{spawn, JoinHandle}
#     let handle = spawn(|| 42)
#     assert(handle.join().unwrap() == 42)

use std::ctx
use std::gfx_errors::{Error, ErrorCode, SyncError}
use std::core::{Option, Result, panic}
use std::collections::{Vec}
use std::alloc::{alloc, dealloc, Box}
use std::time::{TimeSpec}

# ———————————————————————————————————————————————————————————————
# Synchronization primitives — the std::sync unification
# ———————————————————————————————————————————————————————————————
# std::thread's Mutex/RwLock/guards/Condvar ARE std::sync's types (the ONE
# design — the heap-stable Arc-clone guards, never a raw pointer into a
# caller-owned mutex). std::thread re-exports them so existing
# `std::thread::Mutex` users keep a thread-module name; the pthread-backed
# implementation (Thread/JoinHandle, the pthread opaque types, the channel)
# lives HERE — the single pthread type universe.
use std::sync::{Mutex, RwLock, Arc}

# Fault-injection hook for the spawn failure-path tests: when true,
# spawn's pthread_create reports EAGAIN (11) without invoking the libc
# function, so the failure path — including the placed closure's drop
# glue — is exercised deterministically on every platform (no resource
# exhaustion needed). Test-only; defaults to false, and a normal build
# never touches it.
mut __tg_spawn_fail_create: Bool = false

type Condvar = std::sync::Condvar

# ———————————————————————————————————————————————————————————————
# Thread Safety Markers
# ———————————————————————————————————————————————————————————————

# Marker trait: type can be safely sent between threads
trait Send {}

# Marker trait: type can be safely shared between threads (via &T)
trait Sync {}

# All primitive types implement Send + Sync
impl Send for Int {}
impl Send for UInt {}
impl Send for Bool {}
impl Send for Float {}
impl Send for Char {}
impl Send for u8 {}
impl Send for i64 {}
impl Send for u64 {}

impl Sync for Int {}
impl Sync for UInt {}
impl Sync for Bool {}
impl Sync for Float {}
impl Sync for Char {}
impl Sync for u8 {}
impl Sync for i64 {}
impl Sync for u64 {}

# ———————————————————————————————————————————————————————————————
# POSIX Threads API (extern)
# ———————————————————————————————————————————————————————————————

# Thread creation and management
@ffi("c") extern def pthread_create(thread: PtrMut[PthreadT], attr: Ptr[u8], start_routine: fn(Ptr[u8]) -> Ptr[u8], arg: Ptr[u8]) -> i32 end
@ffi("c") extern def pthread_join(thread: PthreadT, retval: PtrMut[Ptr[u8]]) -> i32 end
@ffi("c") extern def pthread_detach(thread: PthreadT) -> i32 end
@ffi("c") extern def pthread_self() -> PthreadT end
@ffi("c") extern def pthread_equal(t1: PthreadT, t2: PthreadT) -> i32 end
@ffi("c") extern def pthread_exit(retval: Ptr[u8]) -> Unit end
@ffi("c") extern def pthread_cancel(thread: PthreadT) -> i32 end

# Thread attributes
@ffi("c") extern def pthread_attr_init(attr: PtrMut[PthreadAttrT]) -> i32 end
@ffi("c") extern def pthread_attr_destroy(attr: PtrMut[PthreadAttrT]) -> i32 end
@ffi("c") extern def pthread_attr_setstacksize(attr: PtrMut[PthreadAttrT], stacksize: UInt) -> i32 end
@ffi("c") extern def pthread_attr_setdetachstate(attr: PtrMut[PthreadAttrT], detachstate: Int) -> i32 end

# Mutex
@ffi("c") extern def pthread_mutex_init(mutex: PtrMut[PthreadMutexT], attr: Ptr[u8]) -> i32 end
@ffi("c") extern def pthread_mutex_destroy(mutex: PtrMut[PthreadMutexT]) -> i32 end
@ffi("c") extern def pthread_mutex_lock(mutex: PtrMut[PthreadMutexT]) -> i32 end
@ffi("c") extern def pthread_mutex_trylock(mutex: PtrMut[PthreadMutexT]) -> i32 end
@ffi("c") extern def pthread_mutex_unlock(mutex: PtrMut[PthreadMutexT]) -> i32 end

# Condition variables
@ffi("c") extern def pthread_cond_init(cond: PtrMut[PthreadCondT], attr: Ptr[u8]) -> i32 end
@ffi("c") extern def pthread_cond_destroy(cond: PtrMut[PthreadCondT]) -> i32 end
@ffi("c") extern def pthread_cond_wait(cond: PtrMut[PthreadCondT], mutex: PtrMut[PthreadMutexT]) -> i32 end
@ffi("c") extern def pthread_cond_timedwait(cond: PtrMut[PthreadCondT], mutex: PtrMut[PthreadMutexT], abstime: Ptr[TimeSpec]) -> i32 end
@ffi("c") extern def pthread_cond_signal(cond: PtrMut[PthreadCondT]) -> i32 end
@ffi("c") extern def pthread_cond_broadcast(cond: PtrMut[PthreadCondT]) -> i32 end

# Read-write locks — the RwLock implementation lives in std::sync on the
# atomic + Arc layer; no pthread read-write lock type universe here.

# Barriers
@ffi("c") extern def pthread_barrier_init(barrier: PtrMut[PthreadBarrierT], attr: Ptr[u8], count: UInt) -> i32 end
@ffi("c") extern def pthread_barrier_destroy(barrier: PtrMut[PthreadBarrierT]) -> i32 end
@ffi("c") extern def pthread_barrier_wait(barrier: PtrMut[PthreadBarrierT]) -> i32 end

# Thread-local storage
@ffi("c") extern def pthread_key_create(key: PtrMut[PthreadKeyT], destructor: fn(Ptr[u8]) -> Unit) -> i32 end
@ffi("c") extern def pthread_key_delete(key: PthreadKeyT) -> i32 end
@ffi("c") extern def pthread_setspecific(key: PthreadKeyT, value: Ptr[u8]) -> i32 end
@ffi("c") extern def pthread_getspecific(key: PthreadKeyT) -> Ptr[u8] end

# Scheduling
@ffi("c") extern def sched_yield() -> i32 end
@ffi("c") extern def usleep(usec: UInt) -> i32 end
@ffi("c") extern def nanosleep(req: Ptr[TimeSpec], rem: PtrMut[TimeSpec]) -> i32 end

# Time functions
@ffi("c") extern def clock_gettime(clockid: Int, tp: PtrMut[TimeSpec]) -> i32 end

# Opaque pthread types — platform-specific sizes. This block is the ONE
# pthread ABI table: std::sync (the atomic/Arc redesign) carries no
# pthread types; the pthread-backed implementations (Thread/JoinHandle,
# Barrier, the channel) all live here.
@cfg(target_os = "linux")
struct PthreadT
  opaque: [u8; 8]
end

@cfg(target_os = "macos")
struct PthreadT
  opaque: [u8; 8]
end

@cfg(target_os = "linux")
struct PthreadAttrT
  opaque: [u8; 56]
end

@cfg(target_os = "macos")
struct PthreadAttrT
  opaque: [u8; 64]
end

@cfg(target_os = "linux")
struct PthreadMutexT
  opaque: [u8; 40]
end

@cfg(target_os = "macos")
struct PthreadMutexT
  opaque: [u8; 64]
end

@cfg(target_os = "linux")
struct PthreadCondT
  opaque: [u8; 48]
end

@cfg(target_os = "macos")
struct PthreadCondT
  opaque: [u8; 48]
end

@cfg(target_os = "linux")
struct PthreadBarrierT
  opaque: [u8; 32]
end

# Darwin's pthread_barrier_t: long __sig + __opaque[56] = 64 bytes.
@cfg(target_os = "macos")
struct PthreadBarrierT
  opaque: [u8; 64]
end

struct PthreadKeyT
  key: UInt
end

@cfg(target_os = "linux")
def pthread_attr_zero() -> PthreadAttrT
  PthreadAttrT { opaque: [0; 56] }
end

@cfg(target_os = "macos")
def pthread_attr_zero() -> PthreadAttrT
  PthreadAttrT { opaque: [0; 64] }
end

@cfg(target_os = "linux")
def pthread_mutex_zero() -> PthreadMutexT
  PthreadMutexT { opaque: [0; 40] }
end

@cfg(target_os = "macos")
def pthread_mutex_zero() -> PthreadMutexT
  PthreadMutexT { opaque: [0; 64] }
end

def pthread_cond_zero() -> PthreadCondT
  PthreadCondT { opaque: [0; 48] }
end

@cfg(target_os = "linux")
def pthread_barrier_zero() -> PthreadBarrierT
  PthreadBarrierT { opaque: [0; 32] }
end

@cfg(target_os = "macos")
def pthread_barrier_zero() -> PthreadBarrierT
  PthreadBarrierT { opaque: [0; 64] }
end

# ———————————————————————————————————————————————————————————————
# Thread
# ———————————————————————————————————————————————————————————————

struct Thread
  handle: PthreadT
  name: Option[String]
end

struct JoinHandle[T]
  thread: Thread
  result_ptr: Ptr[T]
  joined: Bool
end

struct ThreadBuilder
  name: Option[String]
  stack_size: Option[UInt]
end

def thread_builder() -> ThreadBuilder
  ThreadBuilder {
    name: Option::None,
    stack_size: Option::None
  }
end

impl ThreadBuilder
  def name(sink self: ThreadBuilder, name: String) -> ThreadBuilder
    self.name = Option::Some(name)
    self
  end
  
  def stack_size(sink self: ThreadBuilder, size: UInt) -> ThreadBuilder
    self.stack_size = Option::Some(size)
    self
  end
  
  def spawn[F, T](self: ThreadBuilder, f: F) -> Result[JoinHandle[T], String]
    where F: FnOnce() -> T + Send, T: Send
  
    # Allocate closure and result on heap
    let closure_ptr = alloc[F]()
    if closure_ptr.is_null() then
      return Result::Err("spawn: failed to allocate closure")
    end
    closure_ptr.write(f)
    
    let result_ptr = alloc[T]()
    if result_ptr.is_null() then
      # The closure F is already PLACED in closure_ptr: run its drop glue
      # (the captured destructors fire exactly once — the same
      # drop_in_place machinery the Arc uses) BEFORE releasing the
      # storage; a bare dealloc would leak the captured resources.
      closure_ptr.drop_in_place()
      dealloc(closure_ptr)
      return Result::Err("spawn: failed to allocate result")
    end
    
    # Create thread-safe wrapper context
    let ctx = ThreadContext {
      closure: closure_ptr as Ptr[u8],
      result: result_ptr as Ptr[u8],
      run: thread_run_wrapper
    }
    let ctx_ptr = alloc[ThreadContext]()
    if ctx_ptr.is_null() then
      closure_ptr.drop_in_place()
      dealloc(closure_ptr)
      # T was never written into result_ptr: raw dealloc, no drop glue.
      dealloc(result_ptr)
      return Result::Err("spawn: failed to allocate thread context")
    end
    ctx_ptr.write(ctx)
    
    # Initialize thread attributes if needed
    mut attr = pthread_attr_zero()
    pthread_attr_init(&attr as PtrMut[PthreadAttrT])
    
    match self.stack_size
    when Option::Some(size) then
      pthread_attr_setstacksize(&attr as PtrMut[PthreadAttrT], size)
    when Option::None then ()
    end
    
    # Create thread
    mut handle = PthreadT { opaque: [0; 8] }
    mut ret: i32 = 0
    if __tg_spawn_fail_create then
      # The deterministic injected failure (EAGAIN) — see the flag's
      # documentation; exercises the failure path without exhausting any
      # OS resource.
      ret = 11
    else
      ret = pthread_create(&handle as PtrMut[PthreadT], &attr as Ptr[u8], 
                            thread_entry_point, 
                            ctx_ptr as Ptr[u8])
    end
    
    pthread_attr_destroy(&attr as PtrMut[PthreadAttrT])
    
    if ret != 0 then
      # The closure is still OWNED by the block: run its drop glue before
      # freeing the storage (the captured destructors fire exactly once) —
      # a bare dealloc would bypass them. result_ptr holds no T (never
      # written) and ThreadContext is the {Ptr, Ptr, fn} trio (no owned
      # values), so those free raw.
      closure_ptr.drop_in_place()
      dealloc(closure_ptr)
      dealloc(result_ptr)
      dealloc(ctx_ptr)
      return Result::Err("Failed to create thread".to_string())
    end
    
    Result::Ok(JoinHandle {
      thread: Thread { handle: handle, name: self.name.clone() },
      result_ptr: result_ptr,
      joined: false
    })
  end
end

struct ThreadContext
  closure: Ptr[u8]
  result: Ptr[u8]
  run: fn(Ptr[u8], Ptr[u8]) -> Unit
end

def thread_entry_point(arg: Ptr[u8]) -> Ptr[u8]
  if arg.is_null() then
    return Ptr::null() as Ptr[u8]
  end
  let ctx = (arg as Ptr[ThreadContext]).read()
  (ctx.run)(ctx.closure, ctx.result)
  dealloc(arg as Ptr[ThreadContext])
  Ptr::null() as Ptr[u8]
end

def thread_run_wrapper[F, T](closure_ptr: Ptr[u8], result_ptr: Ptr[u8]) -> Unit
  where F: FnOnce() -> T
  
  let closure = (closure_ptr as Ptr[F]).read()
  let result = closure()
  (result_ptr as Ptr[T]).write(result)
  dealloc(closure_ptr as Ptr[F])
end

def spawn[F, T](f: F) -> JoinHandle[T]
  where F: FnOnce() -> T + Send, T: Send
  
  thread_builder().spawn(f).unwrap()
end

impl[T] JoinHandle[T]
  def join(inout self: JoinHandle[T]) -> Result[T, String]
    if self.joined then
      return Result::Err("Thread already joined".to_string())
    end

    mut retval: Ptr[u8] = Ptr::null() as Ptr[u8]
    let ret = pthread_join(self.thread.handle, &retval as PtrMut[Ptr[u8]])
    
    if ret != 0 then
      return Result::Err("Failed to join thread".to_string())
    end
    
    if self.result_ptr.is_null() then
      return Result::Err("Thread result already consumed")
    end
    let result = self.result_ptr.read()
    dealloc(self.result_ptr)
    self.result_ptr = Ptr::null() as Ptr[T]
    self.joined = true
    Result::Ok(result)
  end
  
  def thread(inout self: JoinHandle[T]) -> Ptr[Thread]
    address_of(&mut self.thread) as Ptr[Thread]
  end
end

impl[T] Drop for JoinHandle[T]
  def drop(inout self: JoinHandle[T]) -> Unit
    if self.joined || self.result_ptr.is_null() then
      return
    end

    mut retval: Ptr[u8] = Ptr::null() as Ptr[u8]
    let ret = pthread_join(self.thread.handle, &retval as PtrMut[Ptr[u8]])

    if ret == 0 then
      drop(&mut self.result_ptr.read())
      dealloc(self.result_ptr)
      self.result_ptr = Ptr::null() as Ptr[T]
      self.joined = true
    else
      pthread_detach(self.thread.handle)
    end
  end
end

impl Thread
  def current() -> Thread
    Thread {
      handle: pthread_self(),
      name: Option::None
    }
  end
  
  def name(self: Thread) -> Option[String]
    match self.name
    when Option::Some(n) then Option::Some(n.clone())
    when Option::None then Option::None
    end
  end
  
  def id(self: Thread) -> u64
    # Convert pthread_t to numeric ID
    let ptr = address_of(&mut self.handle) as Ptr[u64]
    ptr.read()
  end
end

def thread_yield() -> Unit
  let _ = sched_yield()
end

# Alias for compatibility with code expecting yield_now naming
def yield_now() -> Unit
  let _ = sched_yield()
end

def thread_sleep_ms(millis: UInt) -> Unit
  let _ = usleep(millis * 1000)
end

def thread_sleep(secs: i64, nanos: i64) -> Unit
  mut req = TimeSpec { tv_sec: secs, tv_nsec: nanos }
  mut rem = TimeSpec { tv_sec: 0, tv_nsec: 0 }
  let _ = nanosleep(&req as Ptr[TimeSpec], &rem as PtrMut[TimeSpec])
end

# ———————————————————————————————————————————————————————————————
# Mutex / RwLock
# ———————————————————————————————————————————————————————————————
# Mutex, MutexGuard, RwLock, RwLockReadGuard and RwLockWriteGuard are the
# std::sync types (see the unification block above) — the heap-stable
# Arc-clone guard design with the atomic lock state in the Arc's allocation.
# std::thread adds NO duplicate pthread universe for them: the guards are
# produced by `use std::sync::{Mutex, RwLock}`.

# ———————————————————————————————————————————————————————————————
# Condition Variable
# ———————————————————————————————————————————————————————————————
# Condvar is std::sync::Condvar (the `type Condvar = std::sync::Condvar`
# alias above) — the notification counter behind an Arc; wait() drops the
# MutexGuard (the lock release + the Arc release) and re-locks through the
# Arc the guard kept alive.

# ———————————————————————————————————————————————————————————————
# Barrier
# ———————————————————————————————————————————————————————————————

struct Barrier
  inner: PthreadBarrierT
end

def barrier_new(count: UInt) -> Barrier
  mut inner = pthread_barrier_zero()
  let _ = pthread_barrier_init(&inner as PtrMut[PthreadBarrierT], Ptr::null(), count)
  Barrier { inner: inner }
end

impl Barrier
  def wait(inout self: Barrier) -> Bool
    let ret = pthread_barrier_wait(&self.inner as PtrMut[PthreadBarrierT])
    ret == PTHREAD_BARRIER_SERIAL_THREAD()
  end
end

def PTHREAD_BARRIER_SERIAL_THREAD() -> i32 = -1

impl Drop for Barrier
  def drop(inout self: Barrier) -> Unit
    let _ = pthread_barrier_destroy(&self.inner as PtrMut[PthreadBarrierT])
  end
end

impl Send for Barrier {}
impl Sync for Barrier {}

# ———————————————————————————————————————————————————————————————
# Atomic Types
# ———————————————————————————————————————————————————————————————

enum Ordering
  Relaxed
  Acquire
  Release
  AcqRel
  SeqCst
end

extern "Tangerine"
  def atomic_load[T](ptr: Ptr[T], order: Int) -> T
  def atomic_store[T](ptr: Ptr[T], value: T, order: Int) -> Unit
  def atomic_exchange[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_compare_exchange[T](ptr: Ptr[T], expected: Ptr[T], desired: T, 
                                  success_order: Int, fail_order: Int) -> Bool
  def atomic_fetch_add[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_sub[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_and[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_or[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_xor[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fence(order: Int) -> Unit
end

struct AtomicInt
  value: Int
end

def atomic_int_new(val: Int) -> AtomicInt
  AtomicInt { value: val }
end

impl AtomicInt
  def load(self: AtomicInt, order: Ordering) -> Int
    atomic_load[Int](&self.value, ordering_to_int(order))
  end
  
  def store(self: AtomicInt, val: Int, order: Ordering) -> Unit
    let _ = atomic_store[Int](&self.value, val, ordering_to_int(order))
  end
  
  def swap(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_exchange[Int](&self.value, val, ordering_to_int(order))
  end
  
  def compare_exchange(self: AtomicInt, expected: Int, desired: Int, 
                       success: Ordering, failure: Ordering) -> Result[Int, Int]
    mut exp = expected
    if atomic_compare_exchange[Int](&self.value, &exp, desired, 
                                ordering_to_int(success), ordering_to_int(failure)) then
      Result::Ok(exp)
    else
      Result::Err(exp)
    end
  end
  
  def fetch_add(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_add[Int](&self.value, val, ordering_to_int(order))
  end
  
  def fetch_sub(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_sub[Int](&self.value, val, ordering_to_int(order))
  end
  
  def fetch_and(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_and[Int](&self.value, val, ordering_to_int(order))
  end
  
  def fetch_or(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_or[Int](&self.value, val, ordering_to_int(order))
  end
end

impl Send for AtomicInt {}
impl Sync for AtomicInt {}

struct AtomicBool
  value: u8
end

def atomic_bool_new(val: Bool) -> AtomicBool
  AtomicBool { value: if val then 1 else 0 end }
end

impl AtomicBool
  def load(self: AtomicBool, order: Ordering) -> Bool
    atomic_load[u8](&self.value, ordering_to_int(order)) != 0
  end
  
  def store(self: AtomicBool, val: Bool, order: Ordering) -> Unit
    let _ = atomic_store[u8](&self.value, if val then 1 else 0 end, ordering_to_int(order))
  end
  
  def swap(self: AtomicBool, val: Bool, order: Ordering) -> Bool
    atomic_exchange[u8](&self.value, if val then 1 else 0 end, ordering_to_int(order)) != 0
  end
end

impl Send for AtomicBool {}
impl Sync for AtomicBool {}

def ordering_to_int(order: Ordering) -> Int
  match order
  when Ordering::Relaxed then 0
  when Ordering::Acquire then 1
  when Ordering::Release then 2
  when Ordering::AcqRel then 3
  when Ordering::SeqCst then 4
  end
end

def fence(order: Ordering) -> Unit
  let _ = atomic_fence(ordering_to_int(order))
end

# ———————————————————————————————————————————————————————————————
# Channel (MPSC)
# ———————————————————————————————————————————————————————————————

struct Sender[T]
  inner: Ptr[ChannelInner[T]]
end

struct Receiver[T]
  inner: Ptr[ChannelInner[T]]
end

struct ChannelInner[T]
  queue: Vec[T]
  mutex: PthreadMutexT
  not_empty: PthreadCondT
  closed: Bool
  sender_count: AtomicInt
end

def channel[T]() -> (Sender[T], Receiver[T])
  let inner = alloc[ChannelInner[T]]()
  if inner.is_null() then
    panic("channel: allocation failed")
  end
  
  mut mutex = pthread_mutex_zero()
  pthread_mutex_init(&mutex as PtrMut[PthreadMutexT], Ptr::null())
  
  mut cond = pthread_cond_zero()
  pthread_cond_init(&cond as PtrMut[PthreadCondT], Ptr::null())
  
  inner.write(ChannelInner {
    queue: Vec::new(),
    mutex: mutex,
    not_empty: cond,
    closed: false,
    sender_count: atomic_int_new(1)
  })
  
  let sender = Sender { inner: inner }
  let receiver = Receiver { inner: inner }
  
  (sender, receiver)
end

impl[T] Sender[T]
  def send(self: Sender[T], sink value: T) -> Result[Unit, T]
    unsafe "pointer dereference — channel send" do
      let ch = self.inner.as_mut()
      pthread_mutex_lock(&ch.mutex as PtrMut[PthreadMutexT])
      
      if ch.closed then
        pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
        return Result::Err(value)
      end
      
      ch.queue.push(value)
      pthread_cond_signal(&ch.not_empty as PtrMut[PthreadCondT])
      pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
      
      Result::Ok(())
    end
  end
end

impl[T] Clone for Sender[T]
  def clone(self: Sender[T]) -> Sender[T]
    unsafe "pointer dereference — channel clone" do
      let ch = self.inner.as_mut()
      ch.sender_count.fetch_add(1, Ordering::Relaxed)
    end
    Sender { inner: self.inner }
  end
end

impl[T] Drop for Sender[T]
  def drop(inout self: Sender[T]) -> Unit
    unsafe "pointer dereference — channel sender drop" do
      let ch = self.inner.as_mut()
      let prev = ch.sender_count.fetch_sub(1, Ordering::AcqRel)
      if prev == 1 then
        # Last sender - close channel
        pthread_mutex_lock(&ch.mutex as PtrMut[PthreadMutexT])
        ch.closed = true
        pthread_cond_broadcast(&ch.not_empty as PtrMut[PthreadCondT])
        pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
      end
    end
  end
end

impl[T] Receiver[T]
  def recv(self: Receiver[T]) -> Result[T, Unit]
    unsafe "pointer dereference — channel recv" do
      let ch = self.inner.as_mut()
      pthread_mutex_lock(&ch.mutex as PtrMut[PthreadMutexT])
      
      while ch.queue.is_empty() && !ch.closed do
        pthread_cond_wait(&ch.not_empty as PtrMut[PthreadCondT], &ch.mutex as PtrMut[PthreadMutexT])
      end
      
      if ch.queue.is_empty() then
        pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
        return Result::Err(())
      end
      
      let value = ch.queue.remove(0)
      pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
      
      Result::Ok(value)
    end
  end
  
  def try_recv(self: Receiver[T]) -> Option[T]
    unsafe "pointer dereference — channel try_recv" do
      let ch = self.inner.as_mut()
      if pthread_mutex_trylock(&ch.mutex as PtrMut[PthreadMutexT]) != 0 then
        return Option::None
      end
      
      if ch.queue.is_empty() then
        pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
        return Option::None
      end
      
      let value = ch.queue.remove(0)
      pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
      
      Option::Some(value)
    end
  end
  
  def iter(self: Receiver[T]) -> ChannelIter[T]
    ChannelIter { receiver: self as Ptr[Receiver[T]] }
  end
end

struct ChannelIter[T]
  receiver: Ptr[Receiver[T]]
end

impl[T] Iterator for ChannelIter[T]
  type Item = T
  
  def next(inout self: ChannelIter[T]) -> Option[T]
    match self.receiver.as_ref().recv()
    when Result::Ok(val) then Option::Some(val)
    when Result::Err(_) then Option::None
    end
  end
end

impl[T: Send] Send for Sender[T] {}
impl[T: Send] Sync for Sender[T] {}
impl[T: Send] Send for Receiver[T] {}

# ———————————————————————————————————————————————————————————————
# Once (one-time initialization)
# ———————————————————————————————————————————————————————————————

struct Once
  state: AtomicInt    # 0 = incomplete, 1 = running, 2 = complete
end

def once_new() -> Once
  Once { state: atomic_int_new(0) }
end

impl Once
  def call_once[F](self: Once, f: F) -> Unit
    where F: FnOnce() -> Unit
    let current_state = self.state.load(Ordering::Acquire)
    if current_state == 0 then
      self.state.store(1, Ordering::Release)
      f()
      self.state.store(2, Ordering::Release)
    else
      while self.state.load(Ordering::Acquire) == 1 do
        thread_yield()
      end
    end
  end
  
  def is_completed(self: Once) -> Bool
    self.state.load(Ordering::Acquire) == 2
  end
end

impl Send for Once {}
impl Sync for Once {}

# ———————————————————————————————————————————————————————————————
# Thread-Local Storage
# ———————————————————————————————————————————————————————————————

struct ThreadLocal[T]
  key: PthreadKeyT
  init: fn() -> T
end

# Thread-local destructor (called when thread exits)
def tls_destructor[T](value: Ptr[u8]) -> Unit
  if !value.is_null() then
    let ptr = value as Ptr[T]
    ptr.drop_in_place()
    dealloc(value, size_of[T](), align_of[T]())
  end
end

def tls_destructor_raw(_value: Ptr[u8]) -> Unit
  ()
end

def thread_local_new[T](init: fn() -> T) -> ThreadLocal[T]
  mut key = PthreadKeyT { key: 0 }
  # Register destructor to prevent memory leak
  pthread_key_create(&key as PtrMut[PthreadKeyT], tls_destructor_raw)
  ThreadLocal { key: key, init: init }
end

impl[T] ThreadLocal[T]
  def get(self: ThreadLocal[T]) -> Ptr[T]
    let ptr = pthread_getspecific(self.key)
    if ptr.is_null() then
      # Initialize for this thread
      let raw = alloc(size_of[T](), align_of[T]())
      if raw.is_null() then
        panic("ThreadLocal: allocation failed")
      end
      let typed_ptr = raw as Ptr[T]
      typed_ptr.write((self.init)())
      pthread_setspecific(self.key, raw)
      # Destructor registered at key creation will free this
      typed_ptr
    else
      ptr as Ptr[T]
    end
  end
end

impl[T] Drop for ThreadLocal[T]
  def drop(inout self: ThreadLocal[T]) -> Unit
    let _ = pthread_key_delete(self.key)
  end
end

# ———————————————————————————————————————————————————————————————
# Thread Pool
# ———————————————————————————————————————————————————————————————

## A fixed-size thread pool that distributes work across worker threads.
struct ThreadPool
  workers: Vec[Worker]
  job_queue: Mutex[VecDeque[Box[dyn FnOnce()]]]
  condvar: Condvar
  shutdown: AtomicBool
  active_jobs: AtomicInt
end

struct Worker
  thread: Option[JoinHandle[Unit]]
  id: UInt
end

def thread_pool_new(num_threads: UInt) -> ThreadPool
  let pool = ThreadPool {
    workers: Vec::new(),
    job_queue: Mutex::new(VecDeque::new()),
    condvar: Condvar::new(),
    shutdown: atomic_bool_new(false),
    active_jobs: atomic_int_new(0),
  }

  for i in 0..num_threads do
    let worker_pool = address_of(&mut pool)
    let handle = ThreadBuilder::new()
      .name("pool-worker-".to_string() + i.to_string())
      .spawn(|| worker_loop(&*worker_pool))
    pool.workers.push(Worker { thread: Option::Some(handle), id: i })
  end
  pool
end

def worker_loop(pool: ThreadPool) -> Unit
  loop do
    if pool.shutdown.load(Ordering::Acquire) then
      break
    end
    let mut guard = pool.job_queue.lock()
    while guard.is_empty() && !pool.shutdown.load(Ordering::Acquire) do
      guard = pool.condvar.wait(guard)
    end
    if pool.shutdown.load(Ordering::Acquire) && guard.is_empty() then
      break
    end
    let job = guard.pop_front()
    drop(guard)

    match job
    when Option::Some(f) then
      pool.active_jobs.fetch_add(1, Ordering::Relaxed)
      f()
      pool.active_jobs.fetch_sub(1, Ordering::Relaxed)
    when Option::None then ()
    end
  end
end

impl ThreadPool
  ## Submit a job to the pool.
  def execute(self: ThreadPool, f: FnOnce() -> Unit) -> Unit
    let mut guard = self.job_queue.lock()
    guard.push_back(Box::new(f))
    drop(guard)
    self.condvar.notify_one()
  end

  ## Submit a job and get a handle to its result.
  def submit[T](
    self: ThreadPool,
    f: FnOnce() -> T
  ) -> ThreadPoolHandle[T]
    let result = Arc::new(Mutex::new(Option::None))
    let result_clone = result.clone()
    let done = Arc::new(AtomicBool::new(false))
    let done_clone = done.clone()

    self.execute(|| {
      let val = f()
      let mut guard = result_clone.lock()
      *guard = Option::Some(val)
      drop(guard)
      done_clone.store(true, Ordering::Release)
    })

    ThreadPoolHandle { result: result, done: done }
  end

  ## Number of worker threads.
  def num_workers(self: ThreadPool) -> UInt
    self.workers.len()
  end

  ## Number of queued jobs waiting for execution.
  def queued_jobs(self: ThreadPool) -> UInt
    let guard = self.job_queue.lock()
    guard.len()
  end

  ## Number of currently active (executing) jobs.
  def active_jobs(self: ThreadPool) -> Int
    self.active_jobs.load(Ordering::Relaxed)
  end

  ## Gracefully shutdown the pool, waiting for all jobs to finish.
  def shutdown(inout self: ThreadPool) -> Unit
    self.shutdown.store(true, Ordering::Release)
    self.condvar.notify_all()
    for worker in self.workers do
      if let Option::Some(handle) = worker.thread.take() then
        handle.join()
      end
    end
  end
end

impl Drop for ThreadPool
  def drop(inout self: ThreadPool) -> Unit
    if !self.shutdown.load(Ordering::Acquire) then
      self.shutdown()
    end
  end
end

struct ThreadPoolHandle[T]
  result: Arc[Mutex[Option[T]]]
  done: Arc[AtomicBool]
end

impl[T] ThreadPoolHandle[T]
  def is_done(self: ThreadPoolHandle[T]) -> Bool
    self.done.load(Ordering::Acquire)
  end

  def join(self: ThreadPoolHandle[T]) -> T
    while !self.done.load(Ordering::Acquire) do
      thread_yield()
    end
    let mut guard = self.result.lock()
    guard.take().unwrap()
  end
end

# ———————————————————————————————————————————————————————————————
# Scoped Threads
# ———————————————————————————————————————————————————————————————

## Scoped threads guarantee all spawned threads complete before the scope exits,
## allowing safe borrowing of stack data.
struct Scope
  threads: Vec[JoinHandle[Unit]]
end

## Run a closure that can spawn scoped threads. All threads are joined
## before this function returns, so spawned threads can borrow from the parent.
def scoped[T](body: FnOnce(inout Scope) -> T) -> T
  let mut s = Scope { threads: Vec::new() }
  let result = body(&mut s)
  ## Join all threads — this makes the borrow safe
  while !s.threads.is_empty() do
    match s.threads.pop()
    when Option::Some(handle) then
      handle.join()
    when Option::None then ()
    end
  end
  result
end

impl Scope
  ## Spawn a scoped thread. The closure may borrow data from the enclosing scope.
  def spawn(inout self: Scope, f: FnOnce() -> Unit) -> Ptr[JoinHandle[Unit]]
    let handle = ThreadBuilder::new().spawn(f)
    self.threads.push(handle)
    address_of(&mut self.threads[self.threads.len() - 1]) as Ptr[JoinHandle[Unit]]
  end
end

# ———————————————————————————————————————————————————————————————
# Parking (thread park/unpark)
# ———————————————————————————————————————————————————————————————

## Park the current thread until unparked by another thread.
def park() -> Unit
  ## Uses the per-thread park state (mutex + condvar)
  thread_register_current()
  let park_mutex = thread_current_park_mutex()
  let park_cond = thread_current_park_cond()
  let mut guard = park_mutex.as_ref().lock()
  while !thread_current_unparked() do
    guard = park_cond.as_ref().wait(guard)
  end
  thread_clear_unpark()
end

## Unpark the given thread, causing it to wake from park().
def unpark(t: Thread) -> Unit
  let park_mutex = thread_park_mutex(t)
  let park_cond = thread_park_cond(t)
  let guard = park_mutex.as_ref().lock()
  thread_set_unpark(t)
  park_cond.as_ref().notify_one()
  drop(guard)
end

# ———————————————————————————————————————————————————————————————
# Thread Registry for cross-thread operations (e.g. unpark)
# ———————————————————————————————————————————————————————————————

struct ThreadRegistry
  states: Mutex[Map[u64, Ptr[ThreadParkState]]]
end

static THREAD_REGISTRY: ThreadRegistry = ThreadRegistry { states: Mutex::new(Map::new()) }

impl ThreadRegistry
  def get() -> Ptr[ThreadRegistry]
    address_of(&mut THREAD_REGISTRY) as Ptr[ThreadRegistry]
  end

  def register(self: ThreadRegistry, tid: u64, state: Ptr[ThreadParkState]) -> Unit
    let mut guard = self.states.lock()
    guard.get_mut().insert(tid, state)
  end

  def unregister(self: ThreadRegistry, tid: u64) -> Unit
    let mut guard = self.states.lock()
    let _ = guard.get_mut().remove(&tid)
  end

  def get_state(self: ThreadRegistry, tid: u64) -> Option[Ptr[ThreadParkState]]
    let guard = self.states.lock()
    match guard.get().get(&tid)
    when Option::Some(state) then Option::Some(state)
    when Option::None then Option::None
    end
  end
end

## Thread-park state accessors
struct ThreadParkState
  mutex: Mutex[Unit]
  cond: Condvar
  unparked: AtomicBool
end

def init_thread_park_state() -> ThreadParkState
  let state = ThreadParkState {
    mutex: Mutex::new(()),
    cond: Condvar::new(),
    unparked: atomic_bool_new(false)
  }
  state
end

static TLS_PARK: ThreadLocal[ThreadParkState] = thread_local_new(init_thread_park_state)

def thread_register_current() -> Unit
  let state = TLS_PARK.get()
  ThreadRegistry::get().register(thread_current_id(), state)
end

def thread_current_park_state() -> Ptr[ThreadParkState]
  # Use TLS to store park state per thread
  TLS_PARK.get()
end

def thread_current_park_mutex() -> Ptr[Mutex[Unit]]
  address_of(&mut thread_current_park_state().as_ref().mutex) as Ptr[Mutex[Unit]]
end

def thread_current_park_cond() -> Ptr[Condvar]
  address_of(&mut thread_current_park_state().as_ref().cond) as Ptr[Condvar]
end

def thread_current_unparked() -> Bool
  thread_current_park_state().as_ref().unparked.load(Ordering::Acquire)
end

def thread_clear_unpark() -> Unit
  thread_current_park_state().as_ref().unparked.store(false, Ordering::Release)
end

def thread_park_mutex(t: Thread) -> Ptr[Mutex[Unit]]
  match ThreadRegistry::get().get_state(t.id())
  when Option::Some(state) then address_of(&mut state.as_ref().mutex)
  when Option::None then panic("Thread not found in registry")
  end
end

def thread_park_cond(t: Thread) -> Ptr[Condvar]
  match ThreadRegistry::get().get_state(t.id())
  when Option::Some(state) then address_of(&mut state.as_ref().cond)
  when Option::None then panic("Thread not found in registry")
  end
end

def thread_set_unpark(t: Thread) -> Unit
  match ThreadRegistry::get().get_state(t.id())
  when Option::Some(state) then state.as_ref().unparked.store(true, Ordering::Release)
  when Option::None then () # Thread might have already exited
  end
end

# ———————————————————————————————————————————————————————————————
# Transferable / Shareable marker impls (access + resource model)
# ———————————————————————————————————————————————————————————————

impl Transferable for Barrier {}
impl Shareable for Barrier {}

impl Transferable for AtomicInt {}
impl Shareable for AtomicInt {}

impl Transferable for AtomicBool {}
impl Shareable for AtomicBool {}

impl Transferable for Once {}
impl Shareable for Once {}

impl[T: Send] Transferable for Sender[T] {}
impl[T: Send] Shareable for Sender[T] {}

impl[T: Send] Transferable for Receiver[T] {}
