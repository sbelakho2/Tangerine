# Tangerine Standard Library — Threading & Synchronization
#
# [METADATA]
# module: tg::thread
# status: alpha
# effects: [Kernel]
# capabilities: [Unsafe]
# error_codes: [ThreadCreationError, JoinError, Internal]
# description: "POSIX threads (pthreads) based threading, synchronization, and atomic operations."
# examples:
#   - |
#     use std::thread::{spawn, JoinHandle}
#     let handle = spawn(|| 42)
#     assert(handle.join().unwrap() == 42)

use std::ctx
use std::gfx_errors::{Error, ErrorCode, SyncError}
use std::core::{Option, Result, panic, AffineHandle}
use std::collections::{Vec}
use std::alloc::{alloc, dealloc, Box}
use std::time::{TimeSpec}

# ———————————————————————————————————————————————————————————————
# Synchronization primitives — the std::sync unification
# ———————————————————————————————————————————————————————————————
# std::thread's Mutex/RwLock/guards/Condvar ARE std::sync's types (the ONE
# design — the heap-stable Arc-clone guards, never a raw pointer into a
# caller-owned mutex). std::thread re-exports them so existing
# `std::thread::Mutex` users keep a thread-module name; the pthread-backed
# implementation (Thread/JoinHandle, the pthread opaque types, the channel)
# lives HERE — the single pthread type universe.
use std::sync::{Mutex, RwLock, Arc}

# Fault-injection hook for the spawn failure-path tests: when true,
# spawn's pthread_create reports EAGAIN (11) without invoking the libc
# function, so the failure path — including the placed closure's drop
# glue — is exercised deterministically on every platform (no resource
# exhaustion needed). Test-only; defaults to false, and a normal build
# never touches it.
mut __tg_spawn_fail_create: Bool = false

# Fault-injection hook for the join-failure (detach-path) tests: when
# true, pthread_join reports EINVAL (22) without invoking the libc
# function, so the failure path — the detach, the worker's continued
# ownership of the shared result cell — is exercised deterministically on
# every platform (no racing with a real join error). Test-only; defaults
# to false, and a normal build never touches it.
mut __tg_join_fail: Bool = false

# Fault-injection hooks for the TLS failure-path tests: when true,
# pthread_key_create / pthread_setspecific report EAGAIN (11) without
# invoking the libc function, so (a) the ThreadLocal creation failure
# (no uninitialized key is ever used) and (b) the set-failure cleanup
# (the drop thunk runs + the storage is freed immediately — no leak)
# are exercised deterministically on every platform. Test-only; default
# to false, and a normal build never touches them.
mut __tg_tls_key_create_fail: Bool = false
mut __tg_tls_set_fail: Bool = false

type Condvar = std::sync::Condvar

# ———————————————————————————————————————————————————————————————
# Thread Safety Markers — REMOVED (concurrency properties)
# ———————————————————————————————————————————————————————————————
# The old `trait Send {}` / `trait Sync {}` markers and their impls are
# DELETED: Transferable / Shareable are COMPILER-DERIVED properties (the
# transferable walk / the shareable walk in tg_compiler/types.tg — the
# single authority). The derived rules apply here as follows:
#   - Thread / JoinHandle / ThreadLocal hold the EXECUTION-CONTEXT-AFFINE
#     native handle (PthreadT / PthreadKeyT carry the AffineHandle mark) —
#     NOT Transferable/Shareable (no explicit opt-in; the conservative
#     default). A thread handle must not move into another execution
#     context.
#   - Barrier / AtomicInt / AtomicBool / Once / the channel endpoints are
#     structurally Transferable (the scalar/atomic layers) and Shareable
#     (the synchronized representations — atomics, the Arc of the channel
#     inner).
# The pthread synchronization objects (mutex/condvar/barrier) are NOT
# marked affine: they are the shared representations — designed for
# cross-thread use.

# ———————————————————————————————————————————————————————————————
# POSIX Threads API (extern)
# ———————————————————————————————————————————————————————————————

# Thread creation and management
@ffi("c") extern def pthread_create(thread: PtrMut[PthreadT], attr: Ptr[u8], start_routine: fn(Ptr[u8]) -> Ptr[u8], arg: Ptr[u8]) -> i32 end
@ffi("c") extern def pthread_join(thread: PthreadT, retval: PtrMut[Ptr[u8]]) -> i32 end
@ffi("c") extern def pthread_detach(thread: PthreadT) -> i32 end
@ffi("c") extern def pthread_self() -> PthreadT end
@ffi("c") extern def pthread_equal(t1: PthreadT, t2: PthreadT) -> i32 end
@ffi("c") extern def pthread_exit(retval: Ptr[u8]) -> Unit end
@ffi("c") extern def pthread_cancel(thread: PthreadT) -> i32 end

# Thread attributes
@ffi("c") extern def pthread_attr_init(attr: PtrMut[PthreadAttrT]) -> i32 end
@ffi("c") extern def pthread_attr_destroy(attr: PtrMut[PthreadAttrT]) -> i32 end
@ffi("c") extern def pthread_attr_setstacksize(attr: PtrMut[PthreadAttrT], stacksize: UInt) -> i32 end
# C: int detachstate — the exact 32-bit width; callers widen at the boundary.
@ffi("c") extern def pthread_attr_setdetachstate(attr: PtrMut[PthreadAttrT], detachstate: i32) -> i32 end

# Mutex
@ffi("c") extern def pthread_mutex_init(mutex: PtrMut[PthreadMutexT], attr: Ptr[u8]) -> i32 end
@ffi("c") extern def pthread_mutex_destroy(mutex: PtrMut[PthreadMutexT]) -> i32 end
@ffi("c") extern def pthread_mutex_lock(mutex: PtrMut[PthreadMutexT]) -> i32 end
@ffi("c") extern def pthread_mutex_trylock(mutex: PtrMut[PthreadMutexT]) -> i32 end
@ffi("c") extern def pthread_mutex_unlock(mutex: PtrMut[PthreadMutexT]) -> i32 end

# Condition variables
@ffi("c") extern def pthread_cond_init(cond: PtrMut[PthreadCondT], attr: Ptr[u8]) -> i32 end
@ffi("c") extern def pthread_cond_destroy(cond: PtrMut[PthreadCondT]) -> i32 end
@ffi("c") extern def pthread_cond_wait(cond: PtrMut[PthreadCondT], mutex: PtrMut[PthreadMutexT]) -> i32 end
@ffi("c") extern def pthread_cond_timedwait(cond: PtrMut[PthreadCondT], mutex: PtrMut[PthreadMutexT], abstime: Ptr[TimeSpec]) -> i32 end
@ffi("c") extern def pthread_cond_signal(cond: PtrMut[PthreadCondT]) -> i32 end
@ffi("c") extern def pthread_cond_broadcast(cond: PtrMut[PthreadCondT]) -> i32 end

# Read-write locks — the RwLock implementation lives in std::sync on the
# atomic + Arc layer; no pthread read-write lock type universe here.

# Barriers
# C: unsigned count — the exact 32-bit width; the barrier_new wrapper
# widens at the boundary.
@ffi("c") extern def pthread_barrier_init(barrier: PtrMut[PthreadBarrierT], attr: Ptr[u8], count: u32) -> i32 end
@ffi("c") extern def pthread_barrier_destroy(barrier: PtrMut[PthreadBarrierT]) -> i32 end
@ffi("c") extern def pthread_barrier_wait(barrier: PtrMut[PthreadBarrierT]) -> i32 end

# Thread-local storage
@ffi("c") extern def pthread_key_create(key: PtrMut[PthreadKeyT], destructor: fn(Ptr[u8]) -> Unit) -> i32 end
@ffi("c") extern def pthread_key_delete(key: PthreadKeyT) -> i32 end
@ffi("c") extern def pthread_setspecific(key: PthreadKeyT, value: Ptr[u8]) -> i32 end
@ffi("c") extern def pthread_getspecific(key: PthreadKeyT) -> Ptr[u8] end

# Scheduling
@ffi("c") extern def sched_yield() -> i32 end
# C: useconds_t = unsigned int — the exact 32-bit width; the
# thread_sleep_ms wrapper widens at the boundary.
@ffi("c") extern def usleep(usec: u32) -> i32 end
@ffi("c") extern def nanosleep(req: Ptr[TimeSpec], rem: PtrMut[TimeSpec]) -> i32 end

# Time functions
# C: clockid_t = int — the exact 32-bit width; callers widen at the boundary.
@ffi("c") extern def clock_gettime(clockid: i32, tp: PtrMut[TimeSpec]) -> i32 end

# Opaque pthread types — platform-specific sizes. This block is the ONE
# pthread ABI table: std::sync (the atomic/Arc redesign) carries no
# pthread types; the pthread-backed implementations (Thread/JoinHandle,
# Barrier, the channel) all live here.
@cfg(target_os = "linux")
struct PthreadT
  affine: AffineHandle   # the execution-context-affine native handle mark
  opaque: [u8; 8]
end

@cfg(target_os = "macos")
struct PthreadT
  affine: AffineHandle   # the execution-context-affine native handle mark
  opaque: [u8; 8]
end

@cfg(target_os = "linux")
struct PthreadAttrT
  opaque: [u8; 56]
end

@cfg(target_os = "macos")
struct PthreadAttrT
  opaque: [u8; 64]
end

@cfg(target_os = "linux")
struct PthreadMutexT
  opaque: [u8; 40]
end

@cfg(target_os = "macos")
struct PthreadMutexT
  opaque: [u8; 64]
end

@cfg(target_os = "linux")
struct PthreadCondT
  opaque: [u8; 48]
end

@cfg(target_os = "macos")
struct PthreadCondT
  opaque: [u8; 48]
end

@cfg(target_os = "linux")
struct PthreadBarrierT
  opaque: [u8; 32]
end

# Darwin's pthread_barrier_t: long __sig + __opaque[56] = 64 bytes.
@cfg(target_os = "macos")
struct PthreadBarrierT
  opaque: [u8; 64]
end

# pthread_key_t — a C scalar passed BY VALUE to pthread_setspecific /
# pthread_getspecific / pthread_key_delete, so the wrapper struct must
# carry the exact C width per target: unsigned int on Linux (32-bit),
# unsigned long on macOS (64-bit).
@cfg(target_os = "linux")
struct PthreadKeyT
  affine: AffineHandle   # the execution-context-affine native handle mark
  key: u32
end

@cfg(target_os = "macos")
struct PthreadKeyT
  affine: AffineHandle   # the execution-context-affine native handle mark
  key: UInt
end

@cfg(target_os = "linux")
def pthread_attr_zero() -> PthreadAttrT
  PthreadAttrT { opaque: [0; 56] }
end

@cfg(target_os = "macos")
def pthread_attr_zero() -> PthreadAttrT
  PthreadAttrT { opaque: [0; 64] }
end

@cfg(target_os = "linux")
def pthread_mutex_zero() -> PthreadMutexT
  PthreadMutexT { opaque: [0; 40] }
end

@cfg(target_os = "macos")
def pthread_mutex_zero() -> PthreadMutexT
  PthreadMutexT { opaque: [0; 64] }
end

def pthread_cond_zero() -> PthreadCondT
  PthreadCondT { opaque: [0; 48] }
end

@cfg(target_os = "linux")
def pthread_barrier_zero() -> PthreadBarrierT
  PthreadBarrierT { opaque: [0; 32] }
end

@cfg(target_os = "macos")
def pthread_barrier_zero() -> PthreadBarrierT
  PthreadBarrierT { opaque: [0; 64] }
end

# ———————————————————————————————————————————————————————————————
# Thread
# ———————————————————————————————————————————————————————————————

struct Thread
  handle: PthreadT
  name: Option[String]
end

struct JoinHandle[T]
  thread: Thread
  # THE SHARED RESULT CELL (result-cell design): the handle's OWN Arc clone
  # of the one heap-stable storage the worker writes into. There is NO
  # naked separately allocated T* here — the last owner's Arc release
  # disposes the storage and the result value.
  cell: ThreadResultCell[T]
  joined: Bool
end

# ———————————————————————————————————————————————————————————————
# The ThreadResultCell — the shared thread-result storage
# ———————————————————————————————————————————————————————————————
#
# THE TWO-SIDED SHARED CELL (result-cell design): the thread's result lives
# in ONE heap-stable storage — ThreadResultCell[T] { inner:
# Arc[ThreadResultInner[T]] } — the same heap-stable Arc shape the
# channel's Arc[ChannelInner] uses. The WORKER's run frame and the
# JoinHandle each hold their own Arc clone of the cell:
#
#   - the worker WRITES the result into the cell's take-once slot (the
#     Mutex[Option[T]]) and its clone is released when its run frame
#     ends — the worker remains an owner of the storage UNTIL ITS
#     TERMINATION. On the pthread_join-FAILURE (detach) path the handle
#     never touches the cell: the worker's clone keeps it alive, and the
#     LAST owner's release (the worker's clone at its exit, or the
#     handle's clone at its drop) disposes the storage AND runs the
#     result value's destructor through the Arc's last-releaser
#     drop_in_place glue — the result can never be orphaned;
#   - the handle TAKES the result out exactly once: the Option slot is
#     emptied by the take (the transfer is exactly-once; a second take
#     yields None).
#
# THE STATE ENUM (the future support): the minimal statuses NOW are
# Pending (the worker has not yet published) and Ready (the worker
# published into the slot). The RESERVED extensions — documented, not
# yet produced by any path — are Panicked (a future unwind-capable
# worker's panic status; with the current process-abort panic policy a
# panicking closure aborts the process before it could publish),
# Cancelled (a future handle-side pthread_cancel landing), TimedOut (a
# future join_timeout that left the worker running), and Taken (the
# exactly-once transfer consumed the slot — the Option's take is the
# CURRENT implementation of that transfer; the status can surface it to
# join's diagnostics).
enum ThreadResultStatus
  Pending
  Ready
  Panicked
  Cancelled
  TimedOut
  Taken
end

struct ThreadResultCell[T]
  inner: Arc[ThreadResultInner[T]]
end

struct ThreadResultInner[T]
  value: Mutex[Option[T]]   # the take-once slot — the Option IS the
                            # exactly-once transfer
  status: AtomicInt         # the current ThreadResultStatus
end

struct ThreadBuilder
  name: Option[String]
  stack_size: Option[UInt]
end

def thread_builder() -> ThreadBuilder
  ThreadBuilder {
    name: Option::None,
    stack_size: Option::None
  }
end

impl ThreadBuilder
  def name(sink self: ThreadBuilder, name: String) -> ThreadBuilder
    self.name = Option::Some(name)
    self
  end
  
  def stack_size(sink self: ThreadBuilder, size: UInt) -> ThreadBuilder
    self.stack_size = Option::Some(size)
    self
  end
  
  def spawn[F, T](self: ThreadBuilder, f: F) -> Result[JoinHandle[T], String]
    where F: FnOnce() -> T + Transferable, T: Transferable
  
    # Allocate closure on heap
    let closure_ptr = alloc[F]()
    if closure_ptr.is_null() then
      return Result::Err("spawn: failed to allocate closure")
    end
    closure_ptr.write(f)
    
    # THE SHARED RESULT CELL: ONE heap-stable storage, TWO Arc clones —
    # the worker's (placed below, moved into its run frame) and the
    # handle's (returned below). The old naked separately allocated T*
    # (result_ptr) is GONE: no path can orphan the result allocation —
    # the worker's clone keeps the cell alive until the worker
    # terminates, and the LAST owner's release disposes the storage.
    let cell = ThreadResultCell[T]::new()
    
    # The worker's clone — PLACED in its own allocation (the context
    # carries a type-erased pointer to it, the same shape as the closure
    # allocation): the worker reads it out at startup, so the context
    # itself never owns a cell value and frees raw.
    let cell_ptr = alloc[ThreadResultCell[T]]()
    if cell_ptr.is_null() then
      # The closure F is already PLACED in closure_ptr: run its drop glue
      # (the captured destructors fire exactly once — the same
      # drop_in_place machinery the Arc uses) BEFORE releasing the
      # storage; a bare dealloc would leak the captured resources. The
      # local `cell` is the ONLY owner: its scope-end drop releases the
      # shared storage.
      closure_ptr.drop_in_place()
      dealloc(closure_ptr)
      return Result::Err("spawn: failed to allocate result cell")
    end
    cell_ptr.write(cell.clone())
    
    # Create thread-safe wrapper context
    let ctx = ThreadContext {
      closure: closure_ptr as Ptr[u8],
      cell: cell_ptr as Ptr[u8],
      run: thread_run_wrapper
    }
    let ctx_ptr = alloc[ThreadContext]()
    if ctx_ptr.is_null() then
      closure_ptr.drop_in_place()
      dealloc(closure_ptr)
      # The PLACED worker clone is a real owner: run its Arc release glue
      # BEFORE freeing its storage; the local `cell` keeps the shared
      # storage alive either way.
      (cell_ptr as Ptr[ThreadResultCell[T]]).drop_in_place()
      dealloc(cell_ptr)
      return Result::Err("spawn: failed to allocate thread context")
    end
    ctx_ptr.write(ctx)
    
    # Initialize thread attributes if needed
    mut attr = pthread_attr_zero()
    pthread_attr_init(&attr as PtrMut[PthreadAttrT])
    
    match self.stack_size
    when Option::Some(size) then
      pthread_attr_setstacksize(&attr as PtrMut[PthreadAttrT], size)
    when Option::None then ()
    end
    
    # Create thread
    mut handle = PthreadT { affine: AffineHandle {}, opaque: [0; 8] }
    mut ret: i32 = 0
    if __tg_spawn_fail_create then
      # The deterministic injected failure (EAGAIN) — see the flag's
      # documentation; exercises the failure path without exhausting any
      # OS resource.
      ret = 11
    else
      ret = pthread_create(&handle as PtrMut[PthreadT], &attr as Ptr[u8], 
                            thread_entry_point, 
                            ctx_ptr as Ptr[u8])
    end
    
    pthread_attr_destroy(&attr as PtrMut[PthreadAttrT])
    
    if ret != 0 then
      # The closure is still OWNED by the block: run its drop glue before
      # freeing the storage (the captured destructors fire exactly once) —
      # a bare dealloc would bypass them. The PLACED worker clone is a
      # real owner: run its Arc release glue the same way (the local
      # `cell` keeps the shared storage alive). ThreadContext is the
      # {Ptr, Ptr, fn} trio (no owned values), so it frees raw.
      closure_ptr.drop_in_place()
      dealloc(closure_ptr)
      (cell_ptr as Ptr[ThreadResultCell[T]]).drop_in_place()
      dealloc(cell_ptr)
      dealloc(ctx_ptr)
      return Result::Err("Failed to create thread".to_string())
    end
    
    Result::Ok(JoinHandle {
      thread: Thread { handle: handle, name: self.name.clone() },
      cell: cell,
      joined: false
    })
  end
end

struct ThreadContext
  closure: Ptr[u8]
  cell: Ptr[u8]
  run: fn(Ptr[u8], Ptr[u8]) -> Unit
end

def thread_entry_point(arg: Ptr[u8]) -> Ptr[u8]
  if arg.is_null() then
    return Ptr::null() as Ptr[u8]
  end
  let ctx = (arg as Ptr[ThreadContext]).read()
  (ctx.run)(ctx.closure, ctx.cell)
  dealloc(arg as Ptr[ThreadContext])
  Ptr::null() as Ptr[u8]
end

def thread_run_wrapper[F, T](closure_ptr: Ptr[u8], cell_ptr: Ptr[u8]) -> Unit
  where F: FnOnce() -> T
  
  let closure = (closure_ptr as Ptr[F]).read()
  let result = closure()
  dealloc(closure_ptr as Ptr[F])
  # The worker's clone: read out of its placement allocation (the move),
  # then free the placement raw. write_result publishes INTO the shared
  # cell; the clone — the worker's ownership — is released when this run
  # frame ends (the worker's termination), so the detach path can never
  # orphan the result.
  let cell = (cell_ptr as Ptr[ThreadResultCell[T]]).read()
  dealloc(cell_ptr as Ptr[ThreadResultCell[T]])
  cell.write_result(result)
end

def spawn[F, T](f: F) -> JoinHandle[T]
  where F: FnOnce() -> T + Transferable, T: Transferable
  
  thread_builder().spawn(f).unwrap()
end

# ———————————————————————————————————————————————————————————————
# The result cell — construction, the write side, the take-once
# ———————————————————————————————————————————————————————————————

def ThreadResultCell::new[T]() -> ThreadResultCell[T]
  ThreadResultCell[T] {
    inner: Arc::new(ThreadResultInner[T] {
      value: Mutex::new(Option::None),
      status: atomic_int_new(thread_result_status_to_int(ThreadResultStatus::Pending))
    })
  }
end

def ThreadResultCell::clone[T](self: ThreadResultCell[T]) -> ThreadResultCell[T]
  ThreadResultCell[T] { inner: self.inner.clone() }
end

impl[T] ThreadResultCell[T]
  # The WORKER side: publish the result into the take-once slot. Called
  # from the worker's run frame with the worker's own clone; the clone
  # (the worker's ownership) is released when the run frame ends, so the
  # detach path keeps the storage alive to the worker's termination.
  def write_result(self: ThreadResultCell[T], value: T) -> Unit
    let ch = self.inner.ptr.as_ref()
    let mut guard = ch.value.lock()
    let slot = guard.get_mut()
    *slot = Option::Some(value)
    drop(guard)
    ch.status.store(thread_result_status_to_int(ThreadResultStatus::Ready), Ordering::Release)
  end
  
  # The HANDLE side: the take-once transfer — the slot is emptied exactly
  # once; a second take yields None (the transferred result is never
  # double-owned).
  def take_result(self: ThreadResultCell[T]) -> Option[T]
    let ch = self.inner.ptr.as_ref()
    let mut guard = ch.value.lock()
    let taken = guard.take()
    drop(guard)
    taken
  end
end


def thread_result_status_to_int(status: ThreadResultStatus) -> Int
  match status
  when ThreadResultStatus::Pending then 0
  when ThreadResultStatus::Ready then 1
  when ThreadResultStatus::Panicked then 2
  when ThreadResultStatus::Cancelled then 3
  when ThreadResultStatus::TimedOut then 4
  when ThreadResultStatus::Taken then 5
  end  end  end
end

impl[T] JoinHandle[T]
  def join(inout self: JoinHandle[T]) -> Result[T, String]
    if self.joined then
      return Result::Err("Thread already joined".to_string())
    end

    mut retval: Ptr[u8] = Ptr::null() as Ptr[u8]
    let ret = pthread_join(self.thread.handle, &retval as PtrMut[Ptr[u8]])
    
    if ret != 0 then
      # THE JOIN-FAILURE (DETACH) PATH: the worker may still be running
      # (or is already detached). Detach, and NEVER touch the result cell
      # from here: the worker's OWN Arc clone keeps the cell — and with
      # it the result the worker writes — alive until the worker
      # terminates; the LAST owner's release (the worker's clone at its
      # exit, or this handle's clone at its drop) disposes the storage.
      # The result can never be orphaned: there is no naked allocation
      # owned from one side only.
      let _ = pthread_detach(self.thread.handle)
      self.joined = true
      return Result::Err("Failed to join thread".to_string())
    end
    
    self.joined = true
    # The worker terminated (its clone released): take the result out of
    # the shared cell — the exactly-once transfer (the slot is emptied by
    # the take; a second take yields None).
    match self.cell.take_result()
    when Option::Some(result) then Result::Ok(result)
    when Option::None then Result::Err("Thread result already consumed")
    end
  end
  
  def thread(inout self: JoinHandle[T]) -> Ptr[Thread]
    address_of(&mut self.thread) as Ptr[Thread]
  end
end

impl[T] Drop for JoinHandle[T]
  def drop(inout self: JoinHandle[T]) -> Unit
    if self.joined then
      return
    end

    mut retval: Ptr[u8] = Ptr::null() as Ptr[u8]
    let ret = pthread_join(self.thread.handle, &retval as PtrMut[Ptr[u8]])

    if ret != 0 then
      # The join failed: the worker may still be running. Detach — the
      # worker's own cell clone keeps the shared storage alive to its
      # termination; the last owner's release (this handle's clone after
      # this body, or the worker's clone at its exit) disposes the
      # storage AND the result value through the Arc's drop_in_place
      # glue. The old manual read/drop/dealloc of a naked result_ptr is
      # gone — the cell owns the destruction now.
      let _ = pthread_detach(self.thread.handle)
    end
    # ret == 0: the worker terminated and its clone is already released;
    # this handle's cell clone (dropped by the deinit plan after this
    # body) is the LAST owner — its release destroys the stored result
    # value exactly once.
  end
end

impl Thread
  def current() -> Thread
    Thread {
      handle: pthread_self(),
      name: Option::None
    }
  end
  
  def name(self: Thread) -> Option[String]
    match self.name
    when Option::Some(n) then Option::Some(n.clone())
    when Option::None then Option::None
    end
  end
  
  def id(self: Thread) -> u64
    # Convert pthread_t to numeric ID
    let ptr = address_of(&mut self.handle) as Ptr[u64]
    ptr.read()
  end
end

def thread_yield() -> Unit
  let _ = sched_yield()
end

# Alias for compatibility with code expecting yield_now naming
def yield_now() -> Unit
  let _ = sched_yield()
end

def thread_sleep_ms(millis: UInt) -> Unit
  # The extern takes the C useconds_t (u32) — widen at the boundary.
  let _ = usleep((millis * 1000) as u32)
end

def thread_sleep(secs: i64, nanos: i64) -> Unit
  mut req = TimeSpec { tv_sec: secs, tv_nsec: nanos }
  mut rem = TimeSpec { tv_sec: 0, tv_nsec: 0 }
  let _ = nanosleep(&req as Ptr[TimeSpec], &rem as PtrMut[TimeSpec])
end

# ———————————————————————————————————————————————————————————————
# Mutex / RwLock
# ———————————————————————————————————————————————————————————————
# Mutex, MutexGuard, RwLock, RwLockReadGuard and RwLockWriteGuard are the
# std::sync types (see the unification block above) — the heap-stable
# Arc-clone guard design with the atomic lock state in the Arc's allocation.
# std::thread adds NO duplicate pthread universe for them: the guards are
# produced by `use std::sync::{Mutex, RwLock}`.

# ———————————————————————————————————————————————————————————————
# Condition Variable
# ———————————————————————————————————————————————————————————————
# Condvar is std::sync::Condvar (the `type Condvar = std::sync::Condvar`
# alias above) — the notification counter behind an Arc; wait() drops the
# MutexGuard (the lock release + the Arc release) and re-locks through the
# Arc the guard kept alive.

# ———————————————————————————————————————————————————————————————
# Barrier
# ———————————————————————————————————————————————————————————————

struct Barrier
  inner: PthreadBarrierT
end

def barrier_new(count: UInt) -> Barrier
  mut inner = pthread_barrier_zero()
  # The extern takes the C unsigned count (u32) — widen at the boundary.
  let _ = pthread_barrier_init(&inner as PtrMut[PthreadBarrierT], Ptr::null(), count as u32)
  Barrier { inner: inner }
end

impl Barrier
  def wait(inout self: Barrier) -> Bool
    let ret = pthread_barrier_wait(&self.inner as PtrMut[PthreadBarrierT])
    ret == PTHREAD_BARRIER_SERIAL_THREAD()
  end
end

def PTHREAD_BARRIER_SERIAL_THREAD() -> i32 = -1

impl Drop for Barrier
  def drop(inout self: Barrier) -> Unit
    let _ = pthread_barrier_destroy(&self.inner as PtrMut[PthreadBarrierT])
  end
end


# ———————————————————————————————————————————————————————————————
# Atomic Types
# ———————————————————————————————————————————————————————————————

enum Ordering
  Relaxed
  Acquire
  Release
  AcqRel
  SeqCst
end

extern "Tangerine"
  def atomic_load[T](ptr: Ptr[T], order: Int) -> T
  def atomic_store[T](ptr: Ptr[T], value: T, order: Int) -> Unit
  def atomic_exchange[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_compare_exchange[T](ptr: Ptr[T], expected: Ptr[T], desired: T, 
                                  success_order: Int, fail_order: Int) -> Bool
  def atomic_fetch_add[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_sub[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_and[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_or[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_xor[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fence(order: Int) -> Unit
end

struct AtomicInt
  value: Int
end

def atomic_int_new(val: Int) -> AtomicInt
  AtomicInt { value: val }
end

impl AtomicInt
  def load(self: AtomicInt, order: Ordering) -> Int
    atomic_load[Int](&self.value, ordering_to_int(order))
  end
  
  def store(self: AtomicInt, val: Int, order: Ordering) -> Unit
    let _ = atomic_store[Int](&self.value, val, ordering_to_int(order))
  end
  
  def swap(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_exchange[Int](&self.value, val, ordering_to_int(order))
  end
  
  def compare_exchange(self: AtomicInt, expected: Int, desired: Int, 
                       success: Ordering, failure: Ordering) -> Result[Int, Int]
    mut exp = expected
    if atomic_compare_exchange[Int](&self.value, &exp, desired, 
                                ordering_to_int(success), ordering_to_int(failure)) then
      Result::Ok(exp)
    else
      Result::Err(exp)
    end
  end
  
  def fetch_add(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_add[Int](&self.value, val, ordering_to_int(order))
  end
  
  def fetch_sub(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_sub[Int](&self.value, val, ordering_to_int(order))
  end
  
  def fetch_and(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_and[Int](&self.value, val, ordering_to_int(order))
  end
  
  def fetch_or(self: AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_or[Int](&self.value, val, ordering_to_int(order))
  end
end


struct AtomicBool
  value: u8
end

def atomic_bool_new(val: Bool) -> AtomicBool
  AtomicBool { value: if val then 1 else 0 end }
end

impl AtomicBool
  def load(self: AtomicBool, order: Ordering) -> Bool
    atomic_load[u8](&self.value, ordering_to_int(order)) != 0
  end
  
  def store(self: AtomicBool, val: Bool, order: Ordering) -> Unit
    let _ = atomic_store[u8](&self.value, if val then 1 else 0 end, ordering_to_int(order))
  end
  
  def swap(self: AtomicBool, val: Bool, order: Ordering) -> Bool
    atomic_exchange[u8](&self.value, if val then 1 else 0 end, ordering_to_int(order)) != 0
  end
end


def ordering_to_int(order: Ordering) -> Int
  match order
  when Ordering::Relaxed then 0
  when Ordering::Acquire then 1
  when Ordering::Release then 2
  when Ordering::AcqRel then 3
  when Ordering::SeqCst then 4
  end  end
end

def fence(order: Ordering) -> Unit
  let _ = atomic_fence(ordering_to_int(order))
end

# ———————————————————————————————————————————————————————————————
# Channel (MPSC)
# ———————————————————————————————————————————————————————————————
# THE TWO-SIDED OWNERSHIP DESIGN (channel ownership design): the channel's
# shared state — the queue, the pthread mutex/condvar, the sender
# count, the receiver-alive state, the closed flag — lives in ONE heap
# allocation owned by std::sync's Arc, the same heap-stable shape the
# async channel's Arc[ChannelInner] uses. Sender and Receiver hold
# their own Arc clone, so either endpoint can outlive the other:
# dropping the LAST sender closes the receive side and broadcasts
# (every blocked recv wakes with Err); dropping the last receiver
# flips the explicit receiver-alive state (receiver_count > 0) and
# broadcasts (every blocked bounded send wakes, and every future send
# fails with the value in Err). The native mutex and condvar are
# destroyed EXACTLY ONCE — in ChannelInner's Drop, which the Arc's
# last-releaser drop_in_place glue runs when the inner's refcount
# reaches zero. The old manual alloc + raw-pointer endpoints (no
# ownership protocol, no resource destruction) are gone.
#
# THE BLOCKING-CALL CLONE RULE: send/recv/try_recv take the endpoint
# by read access, so a call that can block (the bounded send's
# full-queue wait, the recv's empty-queue wait) takes its OWN Arc
# clone for the call's duration — the inner (and its native mutex and
# condvar) can never die mid-wait, even if every endpoint object is
# dropped while the call is parked. The same rule gives ChannelIter
# its own owned Receiver built on a clone of the inner Arc — the
# iterator never holds a pointer into the caller's receiver object, so
# the receiver can be moved or dropped while the iteration continues
# (the iterator's receiver registers in the receiver count: the
# receive side stays alive for the iteration).
#
# channel[T]() is the UNBOUNDED MPSC (capacity 0 — send never waits);
# channel_bounded[T](capacity) is the bounded variant whose send
# blocks on the full queue until the receiver drains a slot or the
# channel dies. Both share the one ChannelInner protocol.

# Test-only inner-destruction counter: incremented in ChannelInner's
# Drop; the ownership tests assert the inner (and with it the native
# mutex/condvar) is destroyed exactly once per channel. Defaults 0; a
# normal build never reads it.
mut __tg_channel_inner_drop_count: AtomicInt = AtomicInt { value: 0 }

struct Sender[T]
  inner: Arc[ChannelInner[T]]
end

struct Receiver[T]
  inner: Arc[ChannelInner[T]]
end

struct ChannelInner[T]
  queue: Vec[T]
  capacity: UInt                # 0 = unbounded (send never waits)
  mutex: PthreadMutexT
  not_empty: PthreadCondT
  closed: Bool                  # the last sender dropped (receive side closed)
  sender_count: AtomicInt       # live Sender values (clones included)
  receiver_count: AtomicInt     # live Receiver values — the explicit
                                # receiver-alive state (alive while > 0)
end

def channel[T]() -> (Sender[T], Receiver[T])
  channel_bounded[T](0)
end

def channel_bounded[T](capacity: UInt) -> (Sender[T], Receiver[T])
  mut mutex = pthread_mutex_zero()
  let mutex_ret = pthread_mutex_init(&mutex as PtrMut[PthreadMutexT], Ptr::null())
  if mutex_ret != 0 then
    panic("channel: mutex init failed")
  end
  
  mut cond = pthread_cond_zero()
  let cond_ret = pthread_cond_init(&cond as PtrMut[PthreadCondT], Ptr::null())
  if cond_ret != 0 then
    panic("channel: condvar init failed")
  end
  
  let inner = Arc::new(ChannelInner[T] {
    queue: Vec::new(),
    capacity: capacity,
    mutex: mutex,
    not_empty: cond,
    closed: false,
    sender_count: atomic_int_new(1),
    receiver_count: atomic_int_new(1)
  })
  
  (Sender[T] { inner: inner.clone() }, Receiver[T] { inner: inner })
end

impl[T] Sender[T]
  def send(self: Sender[T], sink value: T) -> Result[Unit, T]
    # The in-flight clone keeps the inner alive for the whole call: a
    # bounded send parked on the full queue can be woken by the last
    # receiver's drop (or the last sender's close) after every endpoint
    # object is already gone — the parked call still owns the channel.
    let keep = self.inner.clone()
    let ch = keep.ptr.as_mut()
    pthread_mutex_lock(&ch.mutex as PtrMut[PthreadMutexT])
    
    if ch.closed || ch.receiver_count.load(Ordering::Relaxed) == 0 then
      pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
      return Result::Err(value)
    end
    
    if ch.capacity != 0 then
      # Bounded: wait for room while the channel is open and the
      # receive side is alive. The predicates are re-checked under the
      # mutex after EVERY wake — a broadcast that landed before the
      # wait (the close or the receiver-drop) is never lost.
      while ch.queue.len() >= ch.capacity && !ch.closed && ch.receiver_count.load(Ordering::Relaxed) > 0 do
        pthread_cond_wait(&ch.not_empty as PtrMut[PthreadCondT], &ch.mutex as PtrMut[PthreadMutexT])
      end
      if ch.closed || ch.receiver_count.load(Ordering::Relaxed) == 0 then
        pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
        return Result::Err(value)
      end
    end
    
    ch.queue.push(value)
    # Wake ONE receiver: the queue just went non-empty.
    pthread_cond_signal(&ch.not_empty as PtrMut[PthreadCondT])
    pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
    
    Result::Ok(())
  end
end

impl[T] Clone for Sender[T]
  def clone(self: Sender[T]) -> Sender[T]
    let inner = self.inner.clone()
    # The clone registers in the shared sender count: the LAST Sender
    # value to drop — of any generation — closes the receive side.
    inner.ptr.as_ref().sender_count.fetch_add(1, Ordering::Relaxed)
    Sender[T] { inner: inner }
  end
end

impl[T] Drop for Sender[T]
  def drop(inout self: Sender[T]) -> Unit
    let ch = self.inner.ptr.as_mut()
    let prev = ch.sender_count.fetch_sub(1, Ordering::AcqRel)
    if prev == 1 then
      # The last Sender value: close the receive side and wake every
      # blocked recv (and every blocked bounded send — its re-check
      # fails on the closed flag).
      pthread_mutex_lock(&ch.mutex as PtrMut[PthreadMutexT])
      ch.closed = true
      pthread_cond_broadcast(&ch.not_empty as PtrMut[PthreadCondT])
      pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
    end
  end
end

impl[T] Receiver[T]
  def recv(self: Receiver[T]) -> Result[T, Unit]
    # The in-flight clone: a recv parked on the empty queue keeps the
    # inner alive even if every endpoint object is dropped mid-wait.
    let keep = self.inner.clone()
    let ch = keep.ptr.as_mut()
    pthread_mutex_lock(&ch.mutex as PtrMut[PthreadMutexT])
    
    while ch.queue.is_empty() && !ch.closed && ch.receiver_count.load(Ordering::Relaxed) > 0 do
      pthread_cond_wait(&ch.not_empty as PtrMut[PthreadCondT], &ch.mutex as PtrMut[PthreadMutexT])
    end
    
    if ch.queue.is_empty() then
      pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
      return Result::Err(())
    end
    
    let value = ch.queue.remove(0)
    # Room was made: wake ONE blocked bounded sender.
    pthread_cond_signal(&ch.not_empty as PtrMut[PthreadCondT])
    pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
    
    Result::Ok(value)
  end
  
  def try_recv(self: Receiver[T]) -> Option[T]
    let keep = self.inner.clone()
    let ch = keep.ptr.as_mut()
    if pthread_mutex_trylock(&ch.mutex as PtrMut[PthreadMutexT]) != 0 then
      return Option::None
    end
    
    if ch.queue.is_empty() then
      pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
      return Option::None
    end
    
    let value = ch.queue.remove(0)
    pthread_cond_signal(&ch.not_empty as PtrMut[PthreadCondT])
    pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
    
    Option::Some(value)
  end
  
  def iter(self: Receiver[T]) -> ChannelIter[T]
    # The iterator owns its OWN Receiver built on a CLONE of the inner
    # Arc — never a pointer into the caller's receiver object. The
    # receiver can be moved or dropped after iter() and the iteration
    # continues: the iterator's receiver registers in the receiver
    # count, so the receive side stays alive for the iteration's
    # lifetime.
    let inner = self.inner.clone()
    inner.ptr.as_ref().receiver_count.fetch_add(1, Ordering::Relaxed)
    ChannelIter { receiver: Receiver[T] { inner: inner } }
  end
end

impl[T] Drop for Receiver[T]
  def drop(inout self: Receiver[T]) -> Unit
    let ch = self.inner.ptr.as_mut()
    let prev = ch.receiver_count.fetch_sub(1, Ordering::AcqRel)
    if prev == 1 then
      # The last Receiver value: the explicit receiver-alive state
      # (receiver_count > 0) just went false — wake every blocked
      # bounded sender: its re-check fails and the send returns the
      # value in Err; every future send fails the same way.
      pthread_mutex_lock(&ch.mutex as PtrMut[PthreadMutexT])
      pthread_cond_broadcast(&ch.not_empty as PtrMut[PthreadCondT])
      pthread_mutex_unlock(&ch.mutex as PtrMut[PthreadMutexT])
    end
  end
end

impl[T] Drop for ChannelInner[T]
  def drop(inout self: ChannelInner[T]) -> Unit
    # The inner's Drop is the EXACTLY-ONCE destruction point: the Arc
    # runs it (via its last-releaser drop_in_place glue) when the last
    # clone is released, and only then — no endpoint can touch the
    # native resources afterwards (every blocking call holds its own
    # clone, so the refcount cannot be zero while the mutex/condvar
    # are in use).
    let _ = pthread_mutex_destroy(&self.mutex as PtrMut[PthreadMutexT])
    let _ = pthread_cond_destroy(&self.not_empty as PtrMut[PthreadCondT])
    let _ = __tg_channel_inner_drop_count.fetch_add(1, Ordering::Relaxed)
  end
end

struct ChannelIter[T]
  receiver: Receiver[T]
end

impl[T] Iterator for ChannelIter[T]
  type Item = T
  
  def next(inout self: ChannelIter[T]) -> Option[T]
    match self.receiver.recv()
    when Result::Ok(val) then Option::Some(val)
    when Result::Err(_) then Option::None
    end
  end
end


# ———————————————————————————————————————————————————————————————
# Once (one-time initialization)
# ———————————————————————————————————————————————————————————————
#
# THE CAS STATE MACHINE: UNINITIALIZED 0 -> RUNNING 1 -> COMPLETE 2.
# Only the compare-and-swap 0->1 winner runs the initializer; every
# other caller sees RUNNING (1) and spins until the state leaves
# RUNNING (the same spin/yield class as the sync waits), or COMPLETE
# (2) and no-ops. The old load-then-store (read 0, then store 1) let
# two threads both read 0 and both run the initializer — the single
# atomic 0->1 transition is the fix.
#
# FAILURE SEMANTICS (chosen): the panic policy is PROCESS-ABORT
# (std::core.tg — panic terminates the process immediately; unwind is
# not the default and is unsafe with live owned resources). A panicking
# initializer aborts the process before any thread can observe a stuck
# RUNNING state, so POISONING IS SKIPPED: state 3 is reserved for a
# future unwind-enabled panic mode and is NOT used.
#
# REINITIALIZATION SEMANTICS: call_once on a COMPLETE Once is a no-op —
# the initializer never runs again, regardless of which closure is
# passed; a Once is single-shot.

struct Once
  state: AtomicInt    # 0 = UNINITIALIZED, 1 = RUNNING, 2 = COMPLETE
end

def ONCE_UNINITIALIZED() -> Int = 0
def ONCE_RUNNING() -> Int = 1
def ONCE_COMPLETE() -> Int = 2

def once_new() -> Once
  Once { state: atomic_int_new(ONCE_UNINITIALIZED()) }
end

impl Once
  def call_once[F](self: Once, f: F) -> Unit
    where F: FnOnce() -> Unit
    # The single atomic 0->1 transition: exactly one caller wins the
    # CAS and runs f; the others see RUNNING (spin until the state
    # changes) or COMPLETE (no-op). The load-then-store alternative
    # (read 0, then store 1) let two threads both read 0 and both run
    # f — the CAS is the fix.
    let current = self.state.compare_exchange(ONCE_UNINITIALIZED(), ONCE_RUNNING(), Ordering::AcqRel, Ordering::Acquire)
    match current
    when Result::Ok(_) then
      # The CAS winner: run f and publish COMPLETE.
      f()
      self.state.store(ONCE_COMPLETE(), Ordering::Release)
    when Result::Err(state) then
      if state == ONCE_COMPLETE() then
        # Already initialized — the reinitialization is a no-op.
        ()
      else
        # RUNNING: another thread is initializing — spin until the
        # state leaves RUNNING (the winner stores COMPLETE; a
        # panicking f aborts the process, so the wait always
        # terminates).
        while self.state.load(Ordering::Acquire) == ONCE_RUNNING() do
          thread_yield()
        end
      end
    end
  end
  
  def is_completed(self: Once) -> Bool
    self.state.load(Ordering::Acquire) == ONCE_COMPLETE()
  end
end


# ———————————————————————————————————————————————————————————————
# Thread-Local Storage
# ———————————————————————————————————————————————————————————————

struct ThreadLocal[T]
  key: PthreadKeyT
  init: fn() -> T
end

# THE TYPE-ERASED TLS CELL: the per-thread value stored under the pthread
# key is a POINTER TO A TlsAllocation header — never the raw T. The
# header carries the payload pointer and the per-T drop thunk (drop_fn),
# so the C-compatible key destructor — a NON-GENERIC fn(Ptr[u8]) -> Unit,
# the only function shape pthread_key_create can register — can run T's
# drop glue and free the payload without knowing T. WITHOUT this
# indirection a generic destructor cannot be registered (the key's
# destructor parameter is non-generic), and the old registration of a
# no-op destructor leaked every per-thread value and skipped every
# destructor (the comment claimed the opposite).
struct TlsAllocation
  raw: Ptr[Unit]
  drop_fn: fn(Ptr[Unit]) -> Unit
end

# The per-T drop thunk, monomorphized once per ThreadLocal[T]: drops the
# payload IN PLACE (T's Drop impl / deinit plan runs — the same typed
# drop_in_place machinery the Arc uses) and frees the payload allocation.
# The thunk is referenced as a function-pointer VALUE from the
# TlsAllocation header (the same generic-fn-in-value-position form as
# ThreadContext.run), so it is instantiated with the enclosing
# ThreadLocal's T.
def tls_drop_thunk[T](raw: Ptr[Unit]) -> Unit
  let typed = raw as PtrMut[T]
  typed.drop_in_place()
  dealloc(raw as Ptr[T])
end

# The C-compatible (non-generic) key destructor — the ONLY function shape
# pthread_key_create accepts — called by the pthreads runtime when a
# thread exits: reads the TlsAllocation header stored under the key,
# invokes the header's drop thunk (T's drop glue + the payload free), and
# frees the header itself.
def tls_destroy_allocation(value: Ptr[u8]) -> Unit
  if !value.is_null() then
    let header = value as Ptr[TlsAllocation]
    let alloc = header.read()
    (alloc.drop_fn)(alloc.raw)
    dealloc(header)
  end
end

def thread_local_new[T](init: fn() -> T) -> ThreadLocal[T]
  mut key = PthreadKeyT { affine: AffineHandle {}, key: 0 }
  # Register the REAL destructor: the non-generic C-compatible one that
  # runs the per-thread value's drop glue and frees the storage (the
  # type-erased TlsAllocation indirection above). The old registration of
  # a no-op destructor leaked every per-thread value and never ran its
  # destructor.
  #
  # THE KEY-CREATE CHECK: pthread_key_create's return is CHECKED — a
  # failure (EAGAIN — the PTHREAD_KEYS_MAX exhaustion) makes the
  # ThreadLocal creation FAIL (the panic): an uninitialized key (key ==
  # 0) is never returned to the caller, never stored under, never
  # deleted (the old unchecked call silently produced a broken ThreadLocal
  # whose get()/drop would touch the invalid key 0).
  let key_rc = if __tg_tls_key_create_fail then 11 else pthread_key_create(&key as PtrMut[PthreadKeyT], tls_destroy_allocation) end
  if key_rc != 0 then
    panic("ThreadLocal: pthread_key_create failed (code " + (key_rc as Int).to_string() + ")")
  end
  ThreadLocal { key: key, init: init }
end

impl[T] ThreadLocal[T]
  def get(self: ThreadLocal[T]) -> Ptr[T]
    let ptr = pthread_getspecific(self.key)
    if ptr.is_null() then
      # First touch on this thread: allocate the payload, run init, and
      # publish a type-erased TlsAllocation header under the key — the
      # thread's exit runs tls_destroy_allocation on that header.
      let payload = alloc[T]()
      if payload.is_null() then
        panic("ThreadLocal: allocation failed")
      end
      let header = alloc[TlsAllocation]()
      if header.is_null() then
        dealloc(payload)
        panic("ThreadLocal: allocation failed")
      end
      payload.write((self.init)())
      header.write(TlsAllocation {
        raw: payload as Ptr[Unit],
        drop_fn: tls_drop_thunk
      })
      # THE SET-SPECIFIC CHECK: pthread_setspecific's return is CHECKED.
      # A failure after the payload + header allocations means the
      # per-thread value can never be reached through the key — the drop
      # thunk is invoked NOW (T's drop glue + the payload free) and the
      # header is freed immediately: NO leak, no orphaned value. The
      # ThreadLocal creation (the get) fails with the panic.
      let set_rc = if __tg_tls_set_fail then 11 else pthread_setspecific(self.key, header as Ptr[u8]) end
      if set_rc != 0 then
        tls_destroy_allocation(header as Ptr[u8])
        panic("ThreadLocal: pthread_setspecific failed (code " + (set_rc as Int).to_string() + ")")
      end
      payload
    else
      # Already initialized for this thread: the stored value is the
      # allocation header; the payload pointer is its raw field.
      (ptr as Ptr[TlsAllocation]).read().raw as Ptr[T]
    end
  end
end

impl[T] Drop for ThreadLocal[T]
  def drop(inout self: ThreadLocal[T]) -> Unit
    # pthread_key_delete removes the KEY, nothing more: it does NOT run
    # the destructors of per-thread values still stored under that key in
    # OTHER threads. Deleting a key while threads hold values under it is
    # undefined behavior per POSIX — the destructor is never guaranteed
    # to run for those threads. THE LIFETIME CONTRACT: the ThreadLocal
    # must OUTLIVE every thread that called get() on it (or the caller
    # must join those threads before the ThreadLocal drops), so each
    # thread's EXIT runs the key destructor — the drop glue + the free —
    # on its own value. Deleting the key is NOT a substitute for
    # destructing the values in the arbitrary other threads.
    let _ = pthread_key_delete(self.key)
  end
end

# ———————————————————————————————————————————————————————————————
# Thread Pool
# ———————————————————————————————————————————————————————————————

## A fixed-size thread pool that distributes work across worker threads.
## THE ARC-SHARED INNER (concurrency properties): the pool's shared state — the
## job queue, the condvar, the shutdown flag, the active-jobs counter —
## lives in a heap allocation owned by an Arc (the same heap-stable shape
## the sync module's Mutex/Channel use). Each worker receives its OWN Arc
## clone at spawn, so the state stays alive even if the pool is dropped
## or moved. The old `spawn(|| worker_loop(&*worker_pool))` handed a raw
## address of the caller's stack slot into the threads — the raw
## stack-pointer escape the capture rules reject — and dangled the moment
## the pool moved.
struct ThreadPoolInner
  job_queue: Mutex[VecDeque[Box[dyn FnOnce()]]]
  condvar: Condvar
  shutdown: AtomicBool
  active_jobs: AtomicInt
end

struct ThreadPool
  inner: Arc[ThreadPoolInner]
  workers: Vec[Worker]
end

struct Worker
  thread: Option[JoinHandle[Unit]]
  id: UInt
end

def thread_pool_new(num_threads: UInt) -> ThreadPool
  let inner = Arc::new(ThreadPoolInner {
    job_queue: Mutex::new(VecDeque::new()),
    condvar: Condvar::new(),
    shutdown: atomic_bool_new(false),
    active_jobs: atomic_int_new(0),
  })
  let pool = ThreadPool {
    inner: inner,
    workers: Vec::new()
  }

  for i in 0..num_threads do
    let thread_inner = pool.inner.clone()
    let handle = ThreadBuilder::new()
      .name("pool-worker-".to_string() + i.to_string())
      .spawn(|| worker_loop(thread_inner, i))
    pool.workers.push(Worker { thread: Option::Some(handle), id: i })
  end
  pool
end

def worker_loop(inner: Arc[ThreadPoolInner], worker_id: UInt) -> Unit
  loop do
    if inner.ptr.as_ref().shutdown.load(Ordering::Acquire) then
      break
    end
    let mut guard = inner.ptr.as_ref().job_queue.lock()
    while guard.is_empty() && !inner.ptr.as_ref().shutdown.load(Ordering::Acquire) do
      guard = inner.ptr.as_ref().condvar.wait(guard)
    end
    if inner.ptr.as_ref().shutdown.load(Ordering::Acquire) && guard.is_empty() then
      break
    end
    let job = guard.pop_front()
    drop(guard)

    match job
    when Option::Some(f) then
      inner.ptr.as_ref().active_jobs.fetch_add(1, Ordering::Relaxed)
      f()
      inner.ptr.as_ref().active_jobs.fetch_sub(1, Ordering::Relaxed)
    when Option::None then ()
    end
  end
end

impl ThreadPool
  ## Submit a job to the pool.
  def execute(self: ThreadPool, f: FnOnce() -> Unit) -> Unit
    let mut guard = self.inner.ptr.as_ref().job_queue.lock()
    guard.push_back(Box::new(f))
    drop(guard)
    self.inner.ptr.as_ref().condvar.notify_one()
  end

  ## Submit a job and get a handle to its result.
  def submit[T](
    self: ThreadPool,
    f: FnOnce() -> T
  ) -> ThreadPoolHandle[T]
    let result = Arc::new(Mutex::new(Option::None))
    let result_clone = result.clone()
    let done = Arc::new(AtomicBool::new(false))
    let done_clone = done.clone()

    self.execute(|| {
      let val = f()
      let mut guard = result_clone.lock()
      *guard = Option::Some(val)
      drop(guard)
      done_clone.store(true, Ordering::Release)
    })

    ThreadPoolHandle { result: result, done: done }
  end

  ## Number of worker threads.
  def num_workers(self: ThreadPool) -> UInt
    self.workers.len()
  end

  ## Number of queued jobs waiting for execution.
  def queued_jobs(self: ThreadPool) -> UInt
    let guard = self.inner.ptr.as_ref().job_queue.lock()
    guard.len()
  end

  ## Number of currently active (executing) jobs.
  def active_jobs(self: ThreadPool) -> Int
    self.inner.ptr.as_ref().active_jobs.load(Ordering::Relaxed)
  end

  ## Gracefully shutdown the pool, waiting for all jobs to finish.
  def shutdown(inout self: ThreadPool) -> Unit
    self.inner.ptr.as_ref().shutdown.store(true, Ordering::Release)
    self.inner.ptr.as_ref().condvar.notify_all()
    for worker in self.workers do
      if let Option::Some(handle) = worker.thread.take() then
        handle.join()
      end
    end
  end
end

impl Drop for ThreadPool
  def drop(inout self: ThreadPool) -> Unit
    if !self.inner.ptr.as_ref().shutdown.load(Ordering::Acquire) then
      self.shutdown()
    end
  end
end

struct ThreadPoolHandle[T]
  result: Arc[Mutex[Option[T]]]
  done: Arc[AtomicBool]
end

impl[T] ThreadPoolHandle[T]
  def is_done(self: ThreadPoolHandle[T]) -> Bool
    self.done.load(Ordering::Acquire)
  end

  def join(self: ThreadPoolHandle[T]) -> T
    while !self.done.load(Ordering::Acquire) do
      thread_yield()
    end
    let mut guard = self.result.lock()
    guard.take().unwrap()
  end
end

# ———————————————————————————————————————————————————————————————
# Scoped Threads
# ———————————————————————————————————————————————————————————————

## Scoped threads guarantee all spawned threads complete before the scope exits,
## allowing safe borrowing of stack data.
struct Scope
  threads: Vec[JoinHandle[Unit]]
end

## Run a closure that can spawn scoped threads. All threads are joined
## before this function returns, so spawned threads can borrow from the parent.
def scoped[T](body: FnOnce(inout Scope) -> T) -> T
  let mut s = Scope { threads: Vec::new() }
  let result = body(&mut s)
  ## Join all threads — this makes the borrow safe
  while !s.threads.is_empty() do
    match s.threads.pop()
    when Option::Some(handle) then
      handle.join()
    when Option::None then ()
    end
  end
  result
end

impl Scope
  ## Spawn a scoped thread. The closure may borrow data from the enclosing scope.
  def spawn(inout self: Scope, f: FnOnce() -> Unit) -> Ptr[JoinHandle[Unit]]
    let handle = ThreadBuilder::new().spawn(f)
    self.threads.push(handle)
    address_of(&mut self.threads[self.threads.len() - 1]) as Ptr[JoinHandle[Unit]]
  end
end

# ———————————————————————————————————————————————————————————————
# Parking (thread park/unpark)
# ———————————————————————————————————————————————————————————————

## Park the current thread until unparked by another thread.
def park() -> Unit
  ## Uses the per-thread park state (mutex + condvar)
  thread_register_current()
  let park_mutex = thread_current_park_mutex()
  let park_cond = thread_current_park_cond()
  let mut guard = park_mutex.as_ref().lock()
  while !thread_current_unparked() do
    guard = park_cond.as_ref().wait(guard)
  end
  thread_clear_unpark()
end

## Unpark the given thread, causing it to wake from park().
def unpark(t: Thread) -> Unit
  let park_mutex = thread_park_mutex(t)
  let park_cond = thread_park_cond(t)
  let guard = park_mutex.as_ref().lock()
  thread_set_unpark(t)
  park_cond.as_ref().notify_one()
  drop(guard)
end

# ———————————————————————————————————————————————————————————————
# Thread Registry for cross-thread operations (e.g. unpark)
# ———————————————————————————————————————————————————————————————

struct ThreadRegistry
  states: Mutex[Map[u64, Ptr[ThreadParkState]]]
end

static THREAD_REGISTRY: ThreadRegistry = ThreadRegistry { states: Mutex::new(Map::new()) }

impl ThreadRegistry
  def get() -> Ptr[ThreadRegistry]
    address_of(&mut THREAD_REGISTRY) as Ptr[ThreadRegistry]
  end

  def register(self: ThreadRegistry, tid: u64, state: Ptr[ThreadParkState]) -> Unit
    let mut guard = self.states.lock()
    guard.get_mut().insert(tid, state)
  end

  def unregister(self: ThreadRegistry, tid: u64) -> Unit
    let mut guard = self.states.lock()
    let _ = guard.get_mut().remove(&tid)
  end

  def get_state(self: ThreadRegistry, tid: u64) -> Option[Ptr[ThreadParkState]]
    let guard = self.states.lock()
    match guard.get().get(&tid)
    when Option::Some(state) then Option::Some(state)
    when Option::None then Option::None
    end
  end
end

## Thread-park state accessors
struct ThreadParkState
  mutex: Mutex[Unit]
  cond: Condvar
  unparked: AtomicBool
end

def init_thread_park_state() -> ThreadParkState
  let state = ThreadParkState {
    mutex: Mutex::new(()),
    cond: Condvar::new(),
    unparked: atomic_bool_new(false)
  }
  state
end

static TLS_PARK: ThreadLocal[ThreadParkState] = thread_local_new(init_thread_park_state)

def thread_register_current() -> Unit
  let state = TLS_PARK.get()
  ThreadRegistry::get().register(thread_current_id(), state)
end

def thread_current_park_state() -> Ptr[ThreadParkState]
  # Use TLS to store park state per thread
  TLS_PARK.get()
end

def thread_current_park_mutex() -> Ptr[Mutex[Unit]]
  address_of(&mut thread_current_park_state().as_ref().mutex) as Ptr[Mutex[Unit]]
end

def thread_current_park_cond() -> Ptr[Condvar]
  address_of(&mut thread_current_park_state().as_ref().cond) as Ptr[Condvar]
end

def thread_current_unparked() -> Bool
  thread_current_park_state().as_ref().unparked.load(Ordering::Acquire)
end

def thread_clear_unpark() -> Unit
  thread_current_park_state().as_ref().unparked.store(false, Ordering::Release)
end

def thread_park_mutex(t: Thread) -> Ptr[Mutex[Unit]]
  match ThreadRegistry::get().get_state(t.id())
  when Option::Some(state) then address_of(&mut state.as_ref().mutex)
  when Option::None then panic("Thread not found in registry")
  end  end
end

def thread_park_cond(t: Thread) -> Ptr[Condvar]
  match ThreadRegistry::get().get_state(t.id())
  when Option::Some(state) then address_of(&mut state.as_ref().cond)
  when Option::None then panic("Thread not found in registry")
  end  end
end

def thread_set_unpark(t: Thread) -> Unit
  match ThreadRegistry::get().get_state(t.id())
  when Option::Some(state) then state.as_ref().unparked.store(true, Ordering::Release)
  when Option::None then () # Thread might have already exited
  end  end
end

# ———————————————————————————————————————————————————————————————
# Transferable / Shareable — NO marker impls (concurrency properties)
# ———————————————————————————————————————————————————————————————
# The manual Transferable/Shareable impls are DELETED: the compiler
# derives the properties structurally (see the "Thread Safety Markers"
# header above). Barrier/AtomicInt/AtomicBool/Once are derived through
# their scalar/atomic layers; the channel endpoints through their Arc;
# Thread/JoinHandle/ThreadLocal are rejected by the affine-handle mark.
