# Tangerine Standard Library — Threading & Synchronization
#
# POSIX threads (pthreads) based threading with:
#   - Thread spawning and joining
#   - Mutex locks
#   - Condition variables
#   - Read-write locks
#   - Atomic operations
#   - Thread-local storage
#   - Barriers
#   - Channels (message passing)

use std::core::{Option, Result, panic}
use std::collections::{Vec}
use std::alloc::{alloc, dealloc, Box}
use std::time::{TimeSpec, CLOCK_MONOTONIC, CLOCK_REALTIME}

# ———————————————————————————————————————————————————————————————
# Thread Safety Markers
# ———————————————————————————————————————————————————————————————

# Marker trait: type can be safely sent between threads
trait Send {}

# Marker trait: type can be safely shared between threads (via &T)
trait Sync {}

# All primitive types implement Send + Sync
impl Send for Int {}
impl Send for UInt {}
impl Send for Bool {}
impl Send for Float {}
impl Send for Char {}
impl Send for u8 {}
impl Send for i64 {}
impl Send for u64 {}

impl Sync for Int {}
impl Sync for UInt {}
impl Sync for Bool {}
impl Sync for Float {}
impl Sync for Char {}
impl Sync for u8 {}
impl Sync for i64 {}
impl Sync for u64 {}

# ———————————————————————————————————————————————————————————————
# POSIX Threads API (extern)
# ———————————————————————————————————————————————————————————————

# Thread creation and management
@ffi("c") extern def pthread_create(thread: &PthreadT, attr: &u8, start_routine: fn(&u8) -> &u8, arg: &u8) -> Int end
@ffi("c") extern def pthread_join(thread: PthreadT, retval: &mut &u8) -> Int end
@ffi("c") extern def pthread_detach(thread: PthreadT) -> Int end
@ffi("c") extern def pthread_self() -> PthreadT end
@ffi("c") extern def pthread_equal(t1: PthreadT, t2: PthreadT) -> Int end
@ffi("c") extern def pthread_exit(retval: &u8) -> Unit end
@ffi("c") extern def pthread_cancel(thread: PthreadT) -> Int end

# Thread attributes
@ffi("c") extern def pthread_attr_init(attr: &PthreadAttrT) -> Int end
@ffi("c") extern def pthread_attr_destroy(attr: &PthreadAttrT) -> Int end
@ffi("c") extern def pthread_attr_setstacksize(attr: &PthreadAttrT, stacksize: UInt) -> Int end
@ffi("c") extern def pthread_attr_setdetachstate(attr: &PthreadAttrT, detachstate: Int) -> Int end

# Mutex
@ffi("c") extern def pthread_mutex_init(mutex: &PthreadMutexT, attr: &u8) -> Int end
@ffi("c") extern def pthread_mutex_destroy(mutex: &PthreadMutexT) -> Int end
@ffi("c") extern def pthread_mutex_lock(mutex: &PthreadMutexT) -> Int end
@ffi("c") extern def pthread_mutex_trylock(mutex: &PthreadMutexT) -> Int end
@ffi("c") extern def pthread_mutex_unlock(mutex: &PthreadMutexT) -> Int end

# Condition variables
@ffi("c") extern def pthread_cond_init(cond: &PthreadCondT, attr: &u8) -> Int end
@ffi("c") extern def pthread_cond_destroy(cond: &PthreadCondT) -> Int end
@ffi("c") extern def pthread_cond_wait(cond: &PthreadCondT, mutex: &PthreadMutexT) -> Int end
@ffi("c") extern def pthread_cond_timedwait(cond: &PthreadCondT, mutex: &PthreadMutexT, abstime: &TimeSpec) -> Int end
@ffi("c") extern def pthread_cond_signal(cond: &PthreadCondT) -> Int end
@ffi("c") extern def pthread_cond_broadcast(cond: &PthreadCondT) -> Int end

# Read-write locks
@ffi("c") extern def pthread_rwlock_init(rwlock: &PthreadRwlockT, attr: &u8) -> Int end
@ffi("c") extern def pthread_rwlock_destroy(rwlock: &PthreadRwlockT) -> Int end
@ffi("c") extern def pthread_rwlock_rdlock(rwlock: &PthreadRwlockT) -> Int end
@ffi("c") extern def pthread_rwlock_tryrdlock(rwlock: &PthreadRwlockT) -> Int end
@ffi("c") extern def pthread_rwlock_wrlock(rwlock: &PthreadRwlockT) -> Int end
@ffi("c") extern def pthread_rwlock_trywrlock(rwlock: &PthreadRwlockT) -> Int end
@ffi("c") extern def pthread_rwlock_unlock(rwlock: &PthreadRwlockT) -> Int end

# Barriers
@ffi("c") extern def pthread_barrier_init(barrier: &PthreadBarrierT, attr: &u8, count: UInt) -> Int end
@ffi("c") extern def pthread_barrier_destroy(barrier: &PthreadBarrierT) -> Int end
@ffi("c") extern def pthread_barrier_wait(barrier: &PthreadBarrierT) -> Int end

# Thread-local storage
@ffi("c") extern def pthread_key_create(key: &PthreadKeyT, destructor: fn(&u8) -> Unit) -> Int end
@ffi("c") extern def pthread_key_delete(key: PthreadKeyT) -> Int end
@ffi("c") extern def pthread_setspecific(key: PthreadKeyT, value: &u8) -> Int end
@ffi("c") extern def pthread_getspecific(key: PthreadKeyT) -> &u8 end

# Scheduling
@ffi("c") extern def sched_yield() -> Int end
@ffi("c") extern def usleep(usec: UInt) -> Int end
@ffi("c") extern def nanosleep(req: &TimeSpec, rem: &mut TimeSpec) -> Int end

# Time functions
@ffi("c") extern def clock_gettime(clockid: Int, tp: &TimeSpec) -> Int end

# Opaque pthread types (platform-specific sizes)
# Gated per-platform via #[cfg(target_os)]:
# - Linux glibc x86-64: PthreadMutexT = 40 bytes, PthreadRwlockT = 56 bytes
# - macOS: PthreadMutexT = 64 bytes, PthreadRwlockT = 200 bytes, PthreadBarrierT = 0 (unsupported)

#[cfg(target_os = "linux")]
struct PthreadT
  opaque: [u8; 8]
end

#[cfg(target_os = "linux")]
struct PthreadAttrT
  opaque: [u8; 56]
end

#[cfg(target_os = "linux")]
struct PthreadMutexT
  opaque: [u8; 40]
end

#[cfg(target_os = "linux")]
struct PthreadCondT
  opaque: [u8; 48]
end

#[cfg(target_os = "linux")]
struct PthreadRwlockT
  opaque: [u8; 56]
end

#[cfg(target_os = "linux")]
struct PthreadBarrierT
  opaque: [u8; 32]
end

#[cfg(target_os = "macos")]
struct PthreadT
  opaque: [u8; 8]
end

#[cfg(target_os = "macos")]
struct PthreadAttrT
  opaque: [u8; 64]
end

#[cfg(target_os = "macos")]
struct PthreadMutexT
  opaque: [u8; 64]
end

#[cfg(target_os = "macos")]
struct PthreadCondT
  opaque: [u8; 48]
end

#[cfg(target_os = "macos")]
struct PthreadRwlockT
  opaque: [u8; 200]
end

# Note: macOS does not support pthread_barrier_t; barrier API is unavailable.
#[cfg(target_os = "macos")]
struct PthreadBarrierT
  opaque: [u8; 0]
end

struct PthreadKeyT
  key: UInt
end

#[cfg(target_os = "linux")]
def pthread_attr_zero() -> PthreadAttrT
  PthreadAttrT { opaque: [0; 56] }
end

#[cfg(target_os = "macos")]
def pthread_attr_zero() -> PthreadAttrT
  PthreadAttrT { opaque: [0; 64] }
end

#[cfg(target_os = "linux")]
def pthread_mutex_zero() -> PthreadMutexT
  PthreadMutexT { opaque: [0; 40] }
end

#[cfg(target_os = "macos")]
def pthread_mutex_zero() -> PthreadMutexT
  PthreadMutexT { opaque: [0; 64] }
end

#[cfg(target_os = "linux")]
def pthread_rwlock_zero() -> PthreadRwlockT
  PthreadRwlockT { opaque: [0; 56] }
end

#[cfg(target_os = "macos")]
def pthread_rwlock_zero() -> PthreadRwlockT
  PthreadRwlockT { opaque: [0; 200] }
end

def pthread_cond_zero() -> PthreadCondT
  PthreadCondT { opaque: [0; 48] }
end

# ———————————————————————————————————————————————————————————————
# Thread
# ———————————————————————————————————————————————————————————————

struct Thread
  handle: PthreadT
  name: Option[String]
end

struct JoinHandle[T]
  thread: Thread
  result_ptr: Ptr[T]
  joined: Bool
end

struct ThreadBuilder
  name: Option[String]
  stack_size: Option[UInt]
end

def thread_builder() -> ThreadBuilder
  ThreadBuilder {
    name: Option::None,
    stack_size: Option::None
  }
end

impl ThreadBuilder
  def name(self: &mut ThreadBuilder, name: String) -> &mut ThreadBuilder
    self.name = Option::Some(name)
    self
  end
  
  def stack_size(self: &mut ThreadBuilder, size: UInt) -> &mut ThreadBuilder
    self.stack_size = Option::Some(size)
    self
  end
  
  def spawn[F, T](self: &ThreadBuilder, f: F) -> Result[JoinHandle[T], String]
    where F: FnOnce() -> T + Send, T: Send
  
    # Allocate closure and result on heap
    let closure_ptr = alloc[F]()
    if closure_ptr.is_null() then
      return Result::Err("spawn: failed to allocate closure")
    end
    closure_ptr.write(f)
    
    let result_ptr = alloc[T]()
    if result_ptr.is_null() then
      dealloc(closure_ptr)
      return Result::Err("spawn: failed to allocate result")
    end
    
    # Create thread-safe wrapper context
    let ctx = ThreadContext {
      closure: closure_ptr as Ptr[u8],
      result: result_ptr as Ptr[u8],
      run: thread_run_wrapper[F, T]
    }
    let ctx_ptr = alloc[ThreadContext]()
    if ctx_ptr.is_null() then
      dealloc(closure_ptr)
      dealloc(result_ptr)
      return Result::Err("spawn: failed to allocate thread context")
    end
    ctx_ptr.write(ctx)
    
    # Initialize thread attributes if needed
    mut attr = pthread_attr_zero()
    pthread_attr_init(&attr)
    
    match self.stack_size
    when Option::Some(size) then
      pthread_attr_setstacksize(&attr, size)
    when Option::None then ()
    end
    
    # Create thread
    mut handle = PthreadT { opaque: [0; 8] }
    let ret = pthread_create(&handle, &attr as Ptr[u8], 
                              thread_entry_point as Ptr[u8], 
                              ctx_ptr as Ptr[u8])
    
    pthread_attr_destroy(&attr)
    
    if ret != 0 then
      dealloc(closure_ptr)
      dealloc(result_ptr)
      dealloc(ctx_ptr)
      return Result::Err("Failed to create thread".to_string())
    end
    
    Result::Ok(JoinHandle {
      thread: Thread { handle: handle, name: self.name.clone() },
      result_ptr: result_ptr,
      joined: false
    })
  end
end

struct ThreadContext
  closure: Ptr[u8]
  result: Ptr[u8]
  run: fn(Ptr[u8], Ptr[u8]) -> Unit
end

def thread_entry_point(arg: Ptr[u8]) -> Ptr[u8]
  if arg.is_null() then
    return Ptr::null()
  end
  let ctx = (arg as Ptr[ThreadContext]).read()
  (ctx.run)(ctx.closure, ctx.result)
  dealloc(arg as Ptr[ThreadContext])
  Ptr::null()
end

def thread_run_wrapper[F, T](closure_ptr: Ptr[u8], result_ptr: Ptr[u8]) -> Unit
  where F: FnOnce() -> T
  
  let closure = (closure_ptr as Ptr[F]).read()
  let result = closure()
  (result_ptr as Ptr[T]).write(result)
  dealloc(closure_ptr as Ptr[F])
end

def spawn[F, T](f: F) -> JoinHandle[T]
  where F: FnOnce() -> T + Send, T: Send
  
  thread_builder().spawn(f).unwrap()
end

impl[T] JoinHandle[T]
  def join(mut self: JoinHandle[T]) -> Result[T, String]
    if self.joined then
      return Result::Err("Thread already joined".to_string())
    end

    mut retval: Ptr[u8] = Ptr::null()
    let ret = pthread_join(self.thread.handle, &retval)
    
    if ret != 0 then
      return Result::Err("Failed to join thread".to_string())
    end
    
    if self.result_ptr.is_null() then
      return Result::Err("Thread result already consumed")
    end
    let result = self.result_ptr.read()
    dealloc(self.result_ptr)
    self.result_ptr = Ptr::null()
    self.joined = true
    Result::Ok(result)
  end
  
  def thread(self: &JoinHandle[T]) -> &Thread
    &self.thread
  end
end

impl[T] Drop for JoinHandle[T]
  def drop(self: &mut JoinHandle[T]) -> Unit
    if self.joined || self.result_ptr.is_null() then
      return
    end

    mut retval: Ptr[u8] = Ptr::null()
    let ret = pthread_join(self.thread.handle, &retval)

    if ret == 0 then
      drop(&mut self.result_ptr.read())
      dealloc(self.result_ptr)
      self.result_ptr = Ptr::null()
      self.joined = true
    else
      pthread_detach(self.thread.handle)
    end
  end
end

impl Thread
  def current() -> Thread
    Thread {
      handle: pthread_self(),
      name: Option::None
    }
  end
  
  def name(self: &Thread) -> Option[&String]
    match self.name
    when Option::Some(ref n) then Option::Some(n)
    when Option::None then Option::None
    end
  end
  
  def id(self: &Thread) -> u64
    # Convert pthread_t to numeric ID
    let ptr = &self.handle as Ptr[u64]
    ptr.read()
  end
end

def thread_yield() -> Unit
  sched_yield()
end

def thread_sleep_ms(millis: UInt) -> Unit
  usleep(millis * 1000)
end

def thread_sleep(secs: i64, nanos: i64) -> Unit
  mut req = TimeSpec { tv_sec: secs, tv_nsec: nanos }
  mut rem = TimeSpec { tv_sec: 0, tv_nsec: 0 }
  nanosleep(&req, &rem)
end

# ———————————————————————————————————————————————————————————————
# Mutex
# ———————————————————————————————————————————————————————————————

struct Mutex[T]
  inner: PthreadMutexT
  data: T
end

def mutex_new[T](data: T) -> Mutex[T]
  mut inner = pthread_mutex_zero()
  pthread_mutex_init(&inner, Ptr::null())
  Mutex { inner: inner, data: data }
end

struct MutexGuard[T]
  mutex: &Mutex[T]
end

impl[T] Mutex[T]
  def lock(self: &Mutex[T]) -> MutexGuard[T]
    pthread_mutex_lock(&self.inner)
    MutexGuard { mutex: self }
  end
  
  def try_lock(self: &Mutex[T]) -> Option[MutexGuard[T]]
    if pthread_mutex_trylock(&self.inner) == 0 then
      Option::Some(MutexGuard { mutex: self })
    else
      Option::None
    end
  end
  
  def get_mut(self: &mut Mutex[T]) -> &mut T
    # Safe only when we have exclusive access
    &mut self.data
  end
end

impl[T] MutexGuard[T]
  def get(self: &MutexGuard[T]) -> &T
    &self.mutex.data
  end
  
  def get_mut(self: &mut MutexGuard[T]) -> &mut T
    &mut self.mutex.data
  end
end

impl[T] Drop for MutexGuard[T]
  def drop(self: &mut MutexGuard[T]) -> Unit
    pthread_mutex_unlock(&self.mutex.inner)
  end
end

impl[T] Drop for Mutex[T]
  def drop(self: &mut Mutex[T]) -> Unit
    pthread_mutex_destroy(&self.inner)
  end
end

impl[T: Send] Send for Mutex[T] {}
impl[T: Send] Sync for Mutex[T] {}

# ———————————————————————————————————————————————————————————————
# RwLock (Read-Write Lock)
# ———————————————————————————————————————————————————————————————

struct RwLock[T]
  inner: PthreadRwlockT
  data: T
end

def rwlock_new[T](data: T) -> RwLock[T]
  mut inner = pthread_rwlock_zero()
  pthread_rwlock_init(&inner, Ptr::null())
  RwLock { inner: inner, data: data }
end

struct RwLockReadGuard[T]
  lock: &RwLock[T]
end

struct RwLockWriteGuard[T]
  lock: &RwLock[T]
end

impl[T] RwLock[T]
  def read(self: &RwLock[T]) -> RwLockReadGuard[T]
    pthread_rwlock_rdlock(&self.inner)
    RwLockReadGuard { lock: self }
  end
  
  def try_read(self: &RwLock[T]) -> Option[RwLockReadGuard[T]]
    if pthread_rwlock_tryrdlock(&self.inner) == 0 then
      Option::Some(RwLockReadGuard { lock: self })
    else
      Option::None
    end
  end
  
  def write(self: &RwLock[T]) -> RwLockWriteGuard[T]
    pthread_rwlock_wrlock(&self.inner)
    RwLockWriteGuard { lock: self }
  end
  
  def try_write(self: &RwLock[T]) -> Option[RwLockWriteGuard[T]]
    if pthread_rwlock_trywrlock(&self.inner) == 0 then
      Option::Some(RwLockWriteGuard { lock: self })
    else
      Option::None
    end
  end
end

impl[T] RwLockReadGuard[T]
  def get(self: &RwLockReadGuard[T]) -> &T
    &self.lock.data
  end
end

impl[T] RwLockWriteGuard[T]
  # get() removed - write guards should only provide mutable access
  # Use get_mut() instead to maintain exclusive write semantics
  
  def get_mut(self: &mut RwLockWriteGuard[T]) -> &mut T
    &mut self.lock.data
  end
end

impl[T] Drop for RwLockReadGuard[T]
  def drop(self: &mut RwLockReadGuard[T]) -> Unit
    pthread_rwlock_unlock(&self.lock.inner)
  end
end

impl[T] Drop for RwLockWriteGuard[T]
  def drop(self: &mut RwLockWriteGuard[T]) -> Unit
    pthread_rwlock_unlock(&self.lock.inner)
  end
end

impl[T] Drop for RwLock[T]
  def drop(self: &mut RwLock[T]) -> Unit
    pthread_rwlock_destroy(&self.inner)
  end
end

impl[T: Send] Send for RwLock[T] {}
impl[T: Send + Sync] Sync for RwLock[T] {}

# ———————————————————————————————————————————————————————————————
# Condition Variable
# ———————————————————————————————————————————————————————————————

struct Condvar
  inner: PthreadCondT
end

def condvar_new() -> Condvar
  mut inner = PthreadCondT { opaque: [0; 48] }
  pthread_cond_init(&inner, Ptr::null())
  Condlet mut { inner: inner }
end

impl Condvar
  def wait[T](self: &Condvar, guard: MutexGuard[T]) -> MutexGuard[T]
    pthread_cond_wait(&self.inner, &guard.mutex.inner)
    guard
  end
  
  def wait_timeout[T](self: &Condvar, guard: MutexGuard[T], timeout_ms: UInt) -> (MutexGuard[T], Bool)
    # pthread_cond_timedwait requires ABSOLUTE time, not relative
    mut now = TimeSpec { tv_sec: 0, tv_nsec: 0 }
    clock_gettime(CLOCK_REALTIME, &mut now)
    
    let timeout_secs = (timeout_ms / 1000) as i64
    let timeout_nanos = ((timeout_ms % 1000) * 1000000) as i64
    
    # Add timeout to current time
    mut abstime = TimeSpec {
      tv_sec: now.tv_sec + timeout_secs,
      tv_nsec: now.tv_nsec + timeout_nanos
    }
    
    # Handle nanosecond overflow
    if abstime.tv_nsec >= 1000000000 then
      abstime.tv_sec = abstime.tv_sec + 1
      abstime.tv_nsec = abstime.tv_nsec - 1000000000
    end
    
    let ret = pthread_cond_timedwait(&self.inner, &guard.mutex.inner, &abstime)
    let timed_out = ret != 0
    (guard, timed_out)
  end
  
  def notify_one(self: &Condvar) -> Unit
    pthread_cond_signal(&self.inner)
  end
  
  def notify_all(self: &Condvar) -> Unit
    pthread_cond_broadcast(&self.inner)
  end
end

impl Drop for Condvar
  def drop(self: &mut Condvar) -> Unit
    pthread_cond_destroy(&self.inner)
  end
end

impl Send for Condlet mut {}
impl Sync for Condlet mut {}

# ———————————————————————————————————————————————————————————————
# Barrier
# ———————————————————————————————————————————————————————————————

#[cfg(target_os = "linux")]
struct Barrier
  inner: PthreadBarrierT
end

#[cfg(target_os = "macos")]
struct Barrier
  mu: PthreadMutexT
  cv: PthreadCondT
  threshold: UInt
  count: UInt
  generation: UInt
end

#[cfg(target_os = "linux")]
def barrier_new(count: UInt) -> Barrier
  mut inner = PthreadBarrierT { opaque: [0; 32] }
  pthread_barrier_init(&inner, Ptr::null(), count)
  Barrier { inner: inner }
end

#[cfg(target_os = "macos")]
def barrier_new(count: UInt) -> Barrier
  let mut mu = pthread_mutex_zero()
  pthread_mutex_init(&mu, Ptr::null())
  let mut cv = pthread_cond_zero()
  pthread_cond_init(&cv, Ptr::null())
  Barrier { mu: mu, cv: cv, threshold: count, count: count, generation: 0 }
end

#[cfg(target_os = "linux")]
impl Barrier
  def wait(self: &Barrier) -> Bool
    let ret = pthread_barrier_wait(&self.inner)
    ret == PTHREAD_BARRIER_SERIAL_THREAD()
  end
end

#[cfg(target_os = "macos")]
impl Barrier
  def wait(self: &mut Barrier) -> Bool
    pthread_mutex_lock(&self.mu)
    let gen = self.generation
    self.count = self.count - 1
    if self.count == 0 then
      self.generation = self.generation + 1
      self.count = self.threshold
      pthread_cond_broadcast(&self.cv)
      pthread_mutex_unlock(&self.mu)
      true
    else
      while gen == self.generation do
        pthread_cond_wait(&self.cv, &self.mu)
      end
      pthread_mutex_unlock(&self.mu)
      false
    end
  end
end

def PTHREAD_BARRIER_SERIAL_THREAD() -> Int = -1

#[cfg(target_os = "linux")]
impl Drop for Barrier
  def drop(self: &mut Barrier) -> Unit
    pthread_barrier_destroy(&self.inner)
  end
end

#[cfg(target_os = "macos")]
impl Drop for Barrier
  def drop(self: &mut Barrier) -> Unit
    pthread_mutex_destroy(&self.mu)
    pthread_cond_destroy(&self.cv)
  end
end

impl Send for Barrier {}
impl Sync for Barrier {}

# ———————————————————————————————————————————————————————————————
# Atomic Types
# ———————————————————————————————————————————————————————————————

enum Ordering
  Relaxed
  Acquire
  Release
  AcqRel
  SeqCst
end

extern "Tangerine"
  def atomic_load[T](ptr: Ptr[T], order: Int) -> T
  def atomic_store[T](ptr: Ptr[T], value: T, order: Int) -> Unit
  def atomic_exchange[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_compare_exchange[T](ptr: Ptr[T], expected: Ptr[T], desired: T, 
                                  success_order: Int, fail_order: Int) -> Bool
  def atomic_fetch_add[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_sub[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_and[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_or[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fetch_xor[T](ptr: Ptr[T], value: T, order: Int) -> T
  def atomic_fence(order: Int) -> Unit
end

struct AtomicInt
  value: Int
end

def atomic_int_new(val: Int) -> AtomicInt
  AtomicInt { value: val }
end

impl AtomicInt
  def load(self: &AtomicInt, order: Ordering) -> Int
    atomic_load(&self.value, ordering_to_int(order))
  end
  
  def store(self: &AtomicInt, val: Int, order: Ordering) -> Unit
    atomic_store(&self.value, val, ordering_to_int(order))
  end
  
  def swap(self: &AtomicInt, val: Int, order: Ordering) -> Int
    atomic_exchange(&self.value, val, ordering_to_int(order))
  end
  
  def compare_exchange(self: &AtomicInt, expected: Int, desired: Int, 
                       success: Ordering, failure: Ordering) -> Result[Int, Int]
    mut exp = expected
    if atomic_compare_exchange(&self.value, &exp, desired, 
                                ordering_to_int(success), ordering_to_int(failure)) then
      Result::Ok(exp)
    else
      Result::Err(exp)
    end
  end
  
  def fetch_add(self: &AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_add(&self.value, val, ordering_to_int(order))
  end
  
  def fetch_sub(self: &AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_sub(&self.value, val, ordering_to_int(order))
  end
  
  def fetch_and(self: &AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_and(&self.value, val, ordering_to_int(order))
  end
  
  def fetch_or(self: &AtomicInt, val: Int, order: Ordering) -> Int
    atomic_fetch_or(&self.value, val, ordering_to_int(order))
  end
end

impl Send for AtomicInt {}
impl Sync for AtomicInt {}

struct AtomicBool
  value: u8
end

def atomic_bool_new(val: Bool) -> AtomicBool
  AtomicBool { value: if val then 1 else 0 end }
end

impl AtomicBool
  def load(self: &AtomicBool, order: Ordering) -> Bool
    atomic_load(&self.value, ordering_to_int(order)) != 0
  end
  
  def store(self: &AtomicBool, val: Bool, order: Ordering) -> Unit
    atomic_store(&self.value, if val then 1 else 0 end, ordering_to_int(order))
  end
  
  def swap(self: &AtomicBool, val: Bool, order: Ordering) -> Bool
    atomic_exchange(&self.value, if val then 1 else 0 end, ordering_to_int(order)) != 0
  end
end

impl Send for AtomicBool {}
impl Sync for AtomicBool {}

def ordering_to_int(order: Ordering) -> Int
  match order
  when Ordering::Relaxed then 0
  when Ordering::Acquire then 1
  when Ordering::Release then 2
  when Ordering::AcqRel then 3
  when Ordering::SeqCst then 4
  end
end

def fence(order: Ordering) -> Unit
  atomic_fence(ordering_to_int(order))
end

# ———————————————————————————————————————————————————————————————
# Channel (MPSC)
# ———————————————————————————————————————————————————————————————

struct Sender[T]
  inner: Ptr[ChannelInner[T]]
end

struct Receiver[T]
  inner: Ptr[ChannelInner[T]]
end

struct ChannelInner[T]
  queue: Vec[T]
  mutex: PthreadMutexT
  not_empty: PthreadCondT
  closed: Bool
  sender_count: AtomicInt
end

def channel[T]() -> (Sender[T], Receiver[T])
  let inner = alloc[ChannelInner[T]]()
  if inner.is_null() then
    panic("channel: allocation failed")
  end
  
  mut mutex = pthread_mutex_zero()
  pthread_mutex_init(&mutex, Ptr::null())
  
  mut cond = pthread_cond_zero()
  pthread_cond_init(&cond, Ptr::null())
  
  inner.write(ChannelInner {
    queue: Vec::new(),
    mutex: mutex,
    not_empty: cond,
    closed: false,
    sender_count: atomic_int_new(1)
  })
  
  let sender = Sender { inner: inner }
  let receiver = Receiver { inner: inner }
  
  (sender, receiver)
end

impl[T] Sender[T]
  def send(self: &Sender[T], value: T) -> Result[Unit, T]
    unsafe "pointer dereference — channel send" do
      let ch = &mut *self.inner
      pthread_mutex_lock(&ch.mutex)
      
      if ch.closed then
        pthread_mutex_unlock(&ch.mutex)
        return Result::Err(value)
      end
      
      ch.queue.push(value)
      pthread_cond_signal(&ch.not_empty)
      pthread_mutex_unlock(&ch.mutex)
      
      Result::Ok(())
    end
  end
end

impl[T] Clone for Sender[T]
  def clone(self: &Sender[T]) -> Sender[T]
    unsafe "pointer dereference — channel clone" do
      let ch = &mut *self.inner
      ch.sender_count.fetch_add(1, Ordering::Relaxed)
    end
    Sender { inner: self.inner }
  end
end

impl[T] Drop for Sender[T]
  def drop(self: &mut Sender[T]) -> Unit
    unsafe "pointer dereference — channel sender drop" do
      let ch = &mut *self.inner
      let prev = ch.sender_count.fetch_sub(1, Ordering::AcqRel)
      if prev == 1 then
        # Last sender - close channel
        pthread_mutex_lock(&ch.mutex)
        ch.closed = true
        pthread_cond_broadcast(&ch.not_empty)
        pthread_mutex_unlock(&ch.mutex)
      end
    end
  end
end

impl[T] Receiver[T]
  def recv(self: &Receiver[T]) -> Result[T, Unit]
    unsafe "pointer dereference — channel recv" do
      let ch = &mut *self.inner
      pthread_mutex_lock(&ch.mutex)
      
      while ch.queue.is_empty() && !ch.closed do
        pthread_cond_wait(&ch.not_empty, &ch.mutex)
      end
      
      if ch.queue.is_empty() then
        pthread_mutex_unlock(&ch.mutex)
        return Result::Err(())
      end
      
      let value = ch.queue.remove(0)
      pthread_mutex_unlock(&ch.mutex)
      
      Result::Ok(value)
    end
  end
  
  def try_recv(self: &Receiver[T]) -> Option[T]
    unsafe "pointer dereference — channel try_recv" do
      let ch = &mut *self.inner
      if pthread_mutex_trylock(&ch.mutex) != 0 then
        return Option::None
      end
      
      if ch.queue.is_empty() then
        pthread_mutex_unlock(&ch.mutex)
        return Option::None
      end
      
      let value = ch.queue.remove(0)
      pthread_mutex_unlock(&ch.mutex)
      
      Option::Some(value)
    end
  end
  
  def iter(self: &Receiver[T]) -> ChannelIter[T]
    ChannelIter { receiver: self }
  end
end

struct ChannelIter[T]
  receiver: &Receiver[T]
end

impl[T] Iterator for ChannelIter[T]
  type Item = T
  
  def next(self: &mut ChannelIter[T]) -> Option[T]
    match self.receiver.recv()
    when Result::Ok(val) then Option::Some(val)
    when Result::Err(_) then Option::None
    end
  end
end

impl[T: Send] Send for Sender[T] {}
impl[T: Send] Sync for Sender[T] {}
impl[T: Send] Send for Receiver[T] {}

# ———————————————————————————————————————————————————————————————
# Once (one-time initialization)
# ———————————————————————————————————————————————————————————————

struct Once
  state: AtomicInt    # 0 = incomplete, 1 = running, 2 = complete
end

def once_new() -> Once
  Once { state: atomic_int_new(0) }
end

impl Once
  def call_once[F](self: &Once, f: F) -> Unit
    where F: FnOnce() -> Unit
    
    let INCOMPLETE = 0
    let RUNNING = 1
    let COMPLETE = 2
    
    match self.state.compare_exchange(INCOMPLETE, RUNNING, Ordering::Acquire, Ordering::Relaxed)
    when Result::Ok(_) then
      # We got the lock, run the function
      f()
      self.state.store(COMPLETE, Ordering::Release)
    when Result::Err(current) then
      # Someone else is running or completed
      while self.state.load(Ordering::Acquire) == RUNNING do
        thread_yield()
      end
    end
  end
  
  def is_completed(self: &Once) -> Bool
    self.state.load(Ordering::Acquire) == 2
  end
end

impl Send for Once {}
impl Sync for Once {}

# ———————————————————————————————————————————————————————————————
# Thread-Local Storage
# ———————————————————————————————————————————————————————————————

struct ThreadLocal[T]
  key: PthreadKeyT
  init: fn() -> T
end

# Thread-local destructor (called when thread exits)
extern "C" def tls_destructor[T](value: Ptr[u8]) -> Unit
  if !value.is_null() then
    let ptr = value as Ptr[T]
    ptr.drop_in_place()
    dealloc(value, size_of[T](), align_of[T]())
  end
end

def thread_local_new[T](init: fn() -> T) -> ThreadLocal[T]
  mut key = PthreadKeyT { key: 0 }
  # Register destructor to prevent memory leak
  pthread_key_create(&key, tls_destructor[T] as Ptr[u8])
  ThreadLocal { key: key, init: init }
end

impl[T] ThreadLocal[T]
  def get(self: &ThreadLocal[T]) -> &T
    let ptr = pthread_getspecific(self.key)
    if ptr.is_null() then
      # Initialize for this thread
      let raw = alloc(size_of[T](), align_of[T]())
      if raw.is_null() then
        panic("ThreadLocal: allocation failed")
      end
      let typed_ptr = raw as Ptr[T]
      typed_ptr.write((self.init)())
      pthread_setspecific(self.key, raw)
      # Destructor registered at key creation will free this
      unsafe "pointer dereference — thread-local value" do
        &*typed_ptr
      end
    else
      unsafe "pointer dereference — thread-local value" do
        &*(ptr as Ptr[T])
      end
    end
  end
end

impl[T] Drop for ThreadLocal[T]
  def drop(self: &mut ThreadLocal[T]) -> Unit
    pthread_key_delete(self.key)
  end
end

# ———————————————————————————————————————————————————————————————
# Thread Pool
# ———————————————————————————————————————————————————————————————

## A fixed-size thread pool that distributes work across worker threads.
struct ThreadPool
  workers: Vec[Worker]
  job_queue: Mutex[VecDeque[Box[dyn FnOnce() + Send]]]
  condvar: Condvar
  shutdown: AtomicBool
  active_jobs: AtomicInt
end

struct Worker
  thread: Option[JoinHandle[Unit]]
  id: UInt
end

def thread_pool_new(num_threads: UInt) -> ThreadPool
  let pool = ThreadPool {
    workers: Vec::new(),
    job_queue: Mutex::new(VecDeque::new()),
    condvar: condvar_new(),
    shutdown: atomic_bool_new(false),
    active_jobs: atomic_int_new(0),
  }

  for i in 0..num_threads do
    let worker_pool = &pool  ## shared reference
    let handle = ThreadBuilder::new()
      .name("pool-worker-".to_string() + i.to_string())
      .spawn(|| worker_loop(worker_pool))
    pool.workers.push(Worker { thread: Option::Some(handle), id: i })
  end
  pool
end

def worker_loop(pool: &ThreadPool) -> Unit
  loop do
    if pool.shutdown.load(Ordering::Acquire) then
      break
    end
    let mut guard = pool.job_queue.lock()
    while guard.is_empty() && !pool.shutdown.load(Ordering::Acquire) do
      guard = pool.condvar.wait(guard)
    end
    if pool.shutdown.load(Ordering::Acquire) && guard.is_empty() then
      break
    end
    let job = guard.pop_front()
    drop(guard)

    match job
    when Option::Some(f) then
      pool.active_jobs.fetch_add(1, Ordering::Relaxed)
      f()
      pool.active_jobs.fetch_sub(1, Ordering::Relaxed)
    when Option::None then ()
    end
  end
end

impl ThreadPool
  ## Submit a job to the pool.
  def execute[F: FnOnce() + Send + 'static](self: &ThreadPool, f: F) -> Unit
    let mut guard = self.job_queue.lock()
    guard.push_back(Box::new(f))
    drop(guard)
    self.condvar.notify_one()
  end

  ## Submit a job and get a handle to its result.
  def submit[T: Send + 'static, F: FnOnce() -> T + Send + 'static](
    self: &ThreadPool,
    f: F
  ) -> ThreadPoolHandle[T]
    let result = Arc::new(Mutex::new(Option::None))
    let result_clone = result.clone()
    let done = Arc::new(AtomicBool::new(false))
    let done_clone = done.clone()

    self.execute(|| {
      let val = f()
      let mut guard = result_clone.lock()
      *guard = Option::Some(val)
      drop(guard)
      done_clone.store(true, Ordering::Release)
    })

    ThreadPoolHandle { result: result, done: done }
  end

  ## Number of worker threads.
  def num_workers(self: &ThreadPool) -> UInt
    self.workers.len()
  end

  ## Number of queued jobs waiting for execution.
  def queued_jobs(self: &ThreadPool) -> UInt
    let guard = self.job_queue.lock()
    guard.len()
  end

  ## Number of currently active (executing) jobs.
  def active_jobs(self: &ThreadPool) -> Int
    self.active_jobs.load(Ordering::Relaxed)
  end

  ## Gracefully shutdown the pool, waiting for all jobs to finish.
  def shutdown(self: &mut ThreadPool) -> Unit
    self.shutdown.store(true, Ordering::Release)
    self.condvar.notify_all()
    for worker in &mut self.workers do
      if let Option::Some(handle) = worker.thread.take() then
        handle.join()
      end
    end
  end
end

impl Drop for ThreadPool
  def drop(self: &mut ThreadPool) -> Unit
    if !self.shutdown.load(Ordering::Acquire) then
      self.shutdown()
    end
  end
end

struct ThreadPoolHandle[T]
  result: Arc[Mutex[Option[T]]]
  done: Arc[AtomicBool]
end

impl[T] ThreadPoolHandle[T]
  def is_done(self: &ThreadPoolHandle[T]) -> Bool
    self.done.load(Ordering::Acquire)
  end

  def join(self: ThreadPoolHandle[T]) -> T
    while !self.done.load(Ordering::Acquire) do
      thread_yield()
    end
    let mut guard = self.result.lock()
    guard.take().unwrap()
  end
end

# ———————————————————————————————————————————————————————————————
# Scoped Threads
# ———————————————————————————————————————————————————————————————

## Scoped threads guarantee all spawned threads complete before the scope exits,
## allowing safe borrowing of stack data.
struct Scope[_: 'scope]
  threads: Vec[JoinHandle[Unit]]
end

## Run a closure that can spawn scoped threads. All threads are joined
## before this function returns, so spawned threads can borrow from the parent.
def scope[T, F: FnOnce(&mut Scope) -> T](body: F) -> T
  let mut s = Scope { threads: Vec::new() }
  let result = body(&mut s)
  ## Join all threads — this makes the borrow safe
  for handle in s.threads.drain(..) do
    handle.join()
  end
  result
end

impl Scope
  ## Spawn a scoped thread. The closure may borrow data from the enclosing scope.
  def spawn[F: FnOnce() + Send](self: &mut Scope, f: F) -> &JoinHandle[Unit]
    let handle = ThreadBuilder::new().spawn(f)
    self.threads.push(handle)
    &self.threads[self.threads.len() - 1]
  end
end

# ———————————————————————————————————————————————————————————————
# Once (lazy one-time initialization)
# ———————————————————————————————————————————————————————————————

struct Once
  done: AtomicBool
  lock: Mutex[Unit]
end

def once_new() -> Once
  Once { done: atomic_bool_new(false), lock: Mutex::new(()) }
end

impl Once
  def call_once[F: FnOnce()](self: &Once, f: F) -> Unit
    if self.done.load(Ordering::Acquire) then
      return
    end
    let guard = self.lock.lock()
    if !self.done.load(Ordering::Relaxed) then
      f()
      self.done.store(true, Ordering::Release)
    end
    drop(guard)
  end

  def is_completed(self: &Once) -> Bool
    self.done.load(Ordering::Acquire)
  end
end

# ———————————————————————————————————————————————————————————————
# Parking (thread park/unpark)
# ———————————————————————————————————————————————————————————————

## Park the current thread until unparked by another thread.
def park() -> Unit
  ## Uses the per-thread park state (mutex + condvar)
  let park_mutex = thread_current_park_mutex()
  let park_cond = thread_current_park_cond()
  let mut guard = park_mutex.lock()
  while !thread_current_unparked() do
    guard = park_cond.wait(guard)
  end
  thread_clear_unpark()
end

## Unpark the given thread, causing it to wake from park().
def unpark(t: &Thread) -> Unit
  let park_mutex = thread_park_mutex(t)
  let park_cond = thread_park_cond(t)
  let guard = park_mutex.lock()
  thread_set_unpark(t)
  park_cond.notify_one()
  drop(guard)
end

## Placeholder thread-park state accessors (implementation depends on TLS)
def thread_current_park_mutex() -> &Mutex[Unit]
  panic("park/unpark requires thread-local park state")
end
def thread_current_park_cond() -> &Condvar
  panic("park/unpark requires thread-local park state")
end
def thread_current_unparked() -> Bool = false
def thread_clear_unpark() -> Unit = ()
def thread_park_mutex(t: &Thread) -> &Mutex[Unit]
  panic("park/unpark requires thread-local park state")
end
def thread_park_cond(t: &Thread) -> &Condvar
  panic("park/unpark requires thread-local park state")
end
def thread_set_unpark(t: &Thread) -> Unit = ()
