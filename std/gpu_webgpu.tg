# ———————————————————————————————————————————————————————————————
# Command Buffer and Queue
# ———————————————————————————————————————————————————————————————

pub struct WebGPUCommandBuffer
  handle: Ptr[u8]
end

impl WebGPUCommandBuffer
  pub fn handle(self: Self) -> Ptr[u8]
    self.handle
  end
end

pub struct WebGPUQueue
  handle: WGPUQueue
end

impl WebGPUQueue
  pub fn handle(self: Self) -> WGPUQueue
    self.handle
  end
  
  pub def submit(self: Self, command_buffers: Vec[WebGPUCommandBuffer]) -> Unit
    unsafe "webgpu queue submit" do
      let handles: Vec[Ptr[u8]] = command_buffers.iter().map(|cb| cb.handle).collect()
      wgpu_queue_submit(self.handle, handles.as_ptr(), handles.len())
    end
  end
  
  pub def write_buffer(self: Self, buffer: WebGPUBuffer, offset: u64, data: Ptr[u8], size: u64) -> Unit
    unsafe "webgpu queue write buffer" do
      wgpu_queue_write_buffer(self.handle, buffer.handle, offset, data, size)
    end
  end
  
  pub def write_texture(self: Self, destination: ImageCopyTexture, data: Ptr[u8], data_layout: ImageDataLayout, size: Extent3D) -> Unit
    unsafe "webgpu queue write texture" do
      wgpu_queue_write_texture(
        self.handle,
        destination as Ptr[u8],
        data,
        data_layout.offset,
        data_layout.bytes_per_row.map_or(0, |b| b),
        data_layout.rows_per_image.map_or(0, |r| r),
        size.width,
        size.height,
        size.depth_or_array_layers
      )
    end
  end
end

pub struct ImageDataLayout
  offset: u64
  bytes_per_row: Option[u32]
  rows_per_image: Option[u32]
end

# ———————————————————————————————————————————————————————————————
# Surface and SwapChain
# ———————————————————————————————————————————————————————————————

pub struct WebGPUSurface
  handle: WGPUSurface
end

impl WebGPUSurface
  pub fn handle(self: Self) -> WGPUSurface
    self.handle
  end
  
  pub def get_preferred_format(self: Self, adapter: WebGPUAdapter) -> TextureFormat
    unsafe "webgpu surface get preferred format" do
      let format = wgpu_surface_get_preferred_format(self.handle, adapter.handle)
      match format
        when 23 then TextureFormat::BGRA8Unorm
        when 24 then TextureFormat::BGRA8UnormSrgb
        when 18 then TextureFormat::RGBA8Unorm
        when 19 then TextureFormat::RGBA8UnormSrgb
        else TextureFormat::BGRA8Unorm
      end
    end
  end
  
  pub def configure(self: Self, device: WebGPUDevice, config: SurfaceConfiguration) -> Unit
    unsafe "webgpu surface configure" do
      wgpu_surface_configure(
        self.handle,
        device.handle,
        config.format.to_wgpu(),
        config.usage.to_wgpu(),
        config.width,
        config.height,
        config.present_mode as u32
      )
    end
  end
  
  pub def get_current_texture(self: Self) -> Option[WebGPUTexture]
    unsafe "webgpu surface get current texture" do
      let handle = wgpu_surface_get_current_texture(self.handle)
      if handle.is_null() then
        Option::None
      else
        Option::Some(WebGPUTexture {
          handle: handle,
          width: 0,
          height: 0,
          format: TextureFormat::BGRA8Unorm
        })
      end
    end
  end
  
  pub def present(self: Self) -> Unit
    unsafe "webgpu surface present" do
      wgpu_surface_present(self.handle)
    end
  end
end

pub struct SurfaceConfiguration
  format: TextureFormat
  usage: TextureUsage
  width: u32
  height: u32
  present_mode: PresentMode
end

pub enum PresentMode
  Immediate
  Mailbox
  Fifo
end

# ———————————————————————————————————————————————————————————————
# Native WebGPU FFI declarations
# ———————————————————————————————————————————————————————————————

extern "C" do
  # Instance
  def wgpu_create_instance() -> WGPUInstance
  def wgpu_instance_request_adapter(instance: WGPUInstance, power_preference: u32, force_fallback: Bool) -> Future[WGPUAdapter]
  def wgpu_instance_create_surface(instance: WGPUInstance, window_handle: Ptr[u8]) -> WGPUSurface
  
  # Adapter
  def wgpu_adapter_request_device(adapter: WGPUAdapter, features: u64, max_tex_1d: u32, max_tex_2d: u32, max_tex_3d: u32, max_tex_layers: u32, max_bind_groups: u32, max_bindings: u32, max_buffer_size: u64, max_vertex_stride: u32, max_vertex_buffers: u32, max_vertex_attrs: u32, max_compute_x: u32, max_compute_y: u32, max_compute_z: u32, max_compute_invocations: u32) -> DeviceRequestResult
  
  # Device
  def wgpu_device_create_buffer(device: WGPUDevice, label: Ptr[u8], usage: u32, size: u64, mapped: Bool) -> WGPUBuffer
  def wgpu_device_create_texture(device: WGPUDevice, label: Ptr[u8], usage: u32, dimension: u32, width: u32, height: u32, depth: u32, format: u32, mip_levels: u32, samples: u32) -> WGPUTexture
  def wgpu_device_create_shader_module(device: WGPUDevice, label: Ptr[u8], code: Ptr[u8], code_len: usize) -> WGPUShaderModule
  def wgpu_device_create_render_pipeline(device: WGPUDevice, descriptor: Ptr[u8]) -> WGPURenderPipeline
  def wgpu_device_create_compute_pipeline(device: WGPUDevice, descriptor: Ptr[u8]) -> WGPUComputePipeline
  def wgpu_device_create_command_encoder(device: WGPUDevice, label: Ptr[u8]) -> WGPUCommandEncoder
  def wgpu_device_create_bind_group_layout(device: WGPUDevice, descriptor: Ptr[u8]) -> WGPUBindGroupLayout
  def wgpu_device_create_bind_group(device: WGPUDevice, descriptor: Ptr[u8]) -> WGPUBindGroup
  def wgpu_device_create_sampler(device: WGPUDevice, label: Ptr[u8], addr_u: u32, addr_v: u32, addr_w: u32, mag: u32, min: u32, mipmap: u32, lod_min: f32, lod_max: f32, compare: u32, max_aniso: u16) -> WGPUSampler
  def wgpu_device_poll(device: WGPUDevice, wait: Bool) -> Unit
  
  # Buffer
  def wgpu_buffer_map_async(buffer: WGPUBuffer, mode: u32, offset: u64, size: u64) -> Future[i32]
  def wgpu_buffer_get_mapped_range(buffer: WGPUBuffer, offset: u64, size: u64) -> Ptr[u8]
  def wgpu_buffer_unmap(buffer: WGPUBuffer) -> Unit
  def wgpu_buffer_destroy(buffer: WGPUBuffer) -> Unit
  
  # Texture
  def wgpu_texture_create_view(texture: WGPUTexture, descriptor: Ptr[u8]) -> WGPUTextureView
  def wgpu_texture_destroy(texture: WGPUTexture) -> Unit
  
  # Pipeline
  def wgpu_render_pipeline_get_bind_group_layout(pipeline: WGPURenderPipeline, index: u32) -> WGPUBindGroupLayout
  def wgpu_compute_pipeline_get_bind_group_layout(pipeline: WGPUComputePipeline, index: u32) -> WGPUBindGroupLayout
  
  # Command encoder
  def wgpu_command_encoder_begin_render_pass(encoder: WGPUCommandEncoder, descriptor: Ptr[u8]) -> WGPURenderPassEncoder
  def wgpu_command_encoder_begin_compute_pass(encoder: WGPUCommandEncoder, descriptor: Ptr[u8]) -> WGPUComputePassEncoder
  def wgpu_command_encoder_copy_buffer_to_buffer(encoder: WGPUCommandEncoder, src: WGPUBuffer, src_offset: u64, dst: WGPUBuffer, dst_offset: u64, size: u64) -> Unit
  def wgpu_command_encoder_copy_buffer_to_texture(encoder: WGPUCommandEncoder, src: Ptr[u8], dst: Ptr[u8], width: u32, height: u32, depth: u32) -> Unit
  def wgpu_command_encoder_copy_texture_to_buffer(encoder: WGPUCommandEncoder, src: Ptr[u8], dst: Ptr[u8], width: u32, height: u32, depth: u32) -> Unit
  def wgpu_command_encoder_finish(encoder: WGPUCommandEncoder, descriptor: Ptr[u8]) -> Ptr[u8]
  
  # Render pass
  def wgpu_render_pass_set_pipeline(pass: WGPURenderPassEncoder, pipeline: WGPURenderPipeline) -> Unit
  def wgpu_render_pass_set_bind_group(pass: WGPURenderPassEncoder, index: u32, group: WGPUBindGroup, offsets: Ptr[u32], offset_count: usize) -> Unit
  def wgpu_render_pass_set_vertex_buffer(pass: WGPURenderPassEncoder, slot: u32, buffer: WGPUBuffer, offset: u64, size: u64) -> Unit
  def wgpu_render_pass_set_index_buffer(pass: WGPURenderPassEncoder, buffer: WGPUBuffer, format: u32, offset: u64, size: u64) -> Unit
  def wgpu_render_pass_set_viewport(pass: WGPURenderPassEncoder, x: f32, y: f32, width: f32, height: f32, min_depth: f32, max_depth: f32) -> Unit
  def wgpu_render_pass_set_scissor_rect(pass: WGPURenderPassEncoder, x: u32, y: u32, width: u32, height: u32) -> Unit
  def wgpu_render_pass_set_blend_constant(pass: WGPURenderPassEncoder, r: f64, g: f64, b: f64, a: f64) -> Unit
  def wgpu_render_pass_set_stencil_reference(pass: WGPURenderPassEncoder, reference: u32) -> Unit
  def wgpu_render_pass_draw(pass: WGPURenderPassEncoder, vertex_count: u32, instance_count: u32, first_vertex: u32, first_instance: u32) -> Unit
  def wgpu_render_pass_draw_indexed(pass: WGPURenderPassEncoder, index_count: u32, instance_count: u32, first_index: u32, base_vertex: i32, first_instance: u32) -> Unit
  def wgpu_render_pass_draw_indirect(pass: WGPURenderPassEncoder, buffer: WGPUBuffer, offset: u64) -> Unit
  def wgpu_render_pass_draw_indexed_indirect(pass: WGPURenderPassEncoder, buffer: WGPUBuffer, offset: u64) -> Unit
  def wgpu_render_pass_end(pass: WGPURenderPassEncoder) -> Unit
  
  # Compute pass
  def wgpu_compute_pass_set_pipeline(pass: WGPUComputePassEncoder, pipeline: WGPUComputePipeline) -> Unit
  def wgpu_compute_pass_set_bind_group(pass: WGPUComputePassEncoder, index: u32, group: WGPUBindGroup, offsets: Ptr[u32], offset_count: usize) -> Unit
  def wgpu_compute_pass_dispatch_workgroups(pass: WGPUComputePassEncoder, x: u32, y: u32, z: u32) -> Unit
  def wgpu_compute_pass_dispatch_workgroups_indirect(pass: WGPUComputePassEncoder, buffer: WGPUBuffer, offset: u64) -> Unit
  def wgpu_compute_pass_end(pass: WGPUComputePassEncoder) -> Unit
  
  # Queue
  def wgpu_queue_submit(queue: WGPUQueue, command_buffers: Ptr[Ptr[u8]], count: usize) -> Unit
  def wgpu_queue_write_buffer(queue: WGPUQueue, buffer: WGPUBuffer, offset: u64, data: Ptr[u8], size: u64) -> Unit
  def wgpu_queue_write_texture(queue: WGPUQueue, destination: Ptr[u8], data: Ptr[u8], offset: u64, bytes_per_row: u32, rows_per_image: u32, width: u32, height: u32, depth: u32) -> Unit
  
  # Surface
  def wgpu_surface_get_preferred_format(surface: WGPUSurface, adapter: WGPUAdapter) -> u32
  def wgpu_surface_configure(surface: WGPUSurface, device: WGPUDevice, format: u32, usage: u32, width: u32, height: u32, present_mode: u32) -> Unit
  def wgpu_surface_get_current_texture(surface: WGPUSurface) -> WGPUTexture
  def wgpu_surface_present(surface: WGPUSurface) -> Unit
end

struct DeviceRequestResult
  device: WGPUDevice
  queue: WGPUQueue
end