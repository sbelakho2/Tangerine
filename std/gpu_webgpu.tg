# ———————————————————————————————————————————————————————————————
# Structs
# ———————————————————————————————————————————————————————————————

pub struct Extent3D
  width: u32
  height: u32
  depth_or_array_layers: u32
end

pub struct Origin3D
  x: u32
  y: u32
  z: u32
end

pub struct Color
  r: f64
  g: f64
  b: f64
  a: f64
end

impl Color
  pub def new(r: f64, g: f64, b: f64, a: f64) -> Color
    Color { r: r, g: g, b: b, a: a }
  end
  
  pub fn black() -> Color
    Color::new(0.0, 0.0, 0.0, 1.0)
  end
  
  pub fn white() -> Color
    Color::new(1.0, 1.0, 1.0, 1.0)
  end
  
  pub fn red() -> Color
    Color::new(1.0, 0.0, 0.0, 1.0)
  end
  
  pub fn green() -> Color
    Color::new(0.0, 1.0, 0.0, 1.0)
  end
  
  pub fn blue() -> Color
    Color::new(0.0, 0.0, 1.0, 1.0)
  end
end

# ———————————————————————————————————————————————————————————————
# Instance and Device
# ———————————————————————————————————————————————————————————————

pub struct WebGPUInstance
  handle: WGPUInstance
end

impl WebGPUInstance
  pub def create() -> Result[WebGPUInstance, String]
    let mut handle: WGPUInstance = Ptr::null()
    
    unsafe "webgpu create instance" do
      handle = wgpu_create_instance()
      if handle.is_null() then
        return Result::Err("Failed to create WebGPU instance")
      end
    end
    
    Result::Ok(WebGPUInstance { handle: handle })
  end
  
  pub async fn request_adapter(self: Self, options: RequestAdapterOptions) -> Result[WebGPUAdapter, String]
    let mut handle: WGPUAdapter = Ptr::null()
    
    unsafe "webgpu request adapter" do
      handle = await wgpu_instance_request_adapter(
        self.handle,
        options.power_preference as u32,
        options.force_fallback_adapter
      )
      if handle.is_null() then
        return Result::Err("Failed to request adapter")
      end
    end
    
    Result::Ok(WebGPUAdapter { handle: handle, instance: self.handle })
  end
  
  pub def create_surface(self: Self, window: Window) -> Result[WebGPUSurface, String]
    let mut handle: WGPUSurface = Ptr::null()
    
    unsafe "webgpu create surface" do
      handle = wgpu_instance_create_surface(self.handle, window.native_handle())
      if handle.is_null() then
        return Result::Err("Failed to create surface")
      end
    end
    
    Result::Ok(WebGPUSurface { handle: handle })
  end
  
  pub fn handle(self: Self) -> WGPUInstance
    self.handle
  end
end

pub struct RequestAdapterOptions
  power_preference: PowerPreference
  force_fallback_adapter: Bool
end

pub enum PowerPreference
  LowPower
  HighPerformance
end

pub struct WebGPUAdapter
  handle: WGPUAdapter
  instance: WGPUInstance
end

impl WebGPUAdapter
  pub async fn request_device(self: Self, features: DeviceFeatures, limits: Limits) -> Result[WebGPUDevice, String]
    let mut handle: WGPUDevice = Ptr::null()
    let mut queue: WGPUQueue = Ptr::null()
    
    unsafe "webgpu request device" do
      let result = await wgpu_adapter_request_device(
        self.handle,
        features.bits,
        limits.max_texture_dimension_1d,
        limits.max_texture_dimension_2d,
        limits.max_texture_dimension_3d,
        limits.max_texture_array_layers,
        limits.max_bind_groups,
        limits.max_bindings_per_bind_group,
        limits.max_buffer_size,
        limits.max_vertex_buffer_array_stride,
        limits.max_vertex_buffers,
        limits.max_vertex_attributes,
        limits.max_compute_workgroup_size_x,
        limits.max_compute_workgroup_size_y,
        limits.max_compute_workgroup_size_z,
        limits.max_compute_invocations_per_workgroup
      )
      
      if result.device.is_null() then
        return Result::Err("Failed to request device")
      end
      
      handle = result.device
      queue = result.queue
    end
    
    Result::Ok(WebGPUDevice {
      handle: handle,
      queue: queue,
      adapter: self.handle
    })
  end
  
  pub fn handle(self: Self) -> WGPUAdapter
    self.handle
  end
end

pub struct DeviceFeatures
  bits: u64
end

impl DeviceFeatures
  pub fn none() -> DeviceFeatures
    DeviceFeatures { bits: 0 }
  end
  
  pub fn all() -> DeviceFeatures
    DeviceFeatures { bits: u64::MAX }
  end
end

pub struct Limits
  max_texture_dimension_1d: u32
  max_texture_dimension_2d: u32
  max_texture_dimension_3d: u32
  max_texture_array_layers: u32
  max_bind_groups: u32
  max_bindings_per_bind_group: u32
  max_buffer_size: u64
  max_vertex_buffer_array_stride: u32
  max_vertex_buffers: u32
  max_vertex_attributes: u32
  max_compute_workgroup_size_x: u32
  max_compute_workgroup_size_y: u32
  max_compute_workgroup_size_z: u32
  max_compute_invocations_per_workgroup: u32
end

impl Limits
  pub fn default() -> Limits
    Limits {
      max_texture_dimension_1d: 8192,
      max_texture_dimension_2d: 8192,
      max_texture_dimension_3d: 2048,
      max_texture_array_layers: 256,
      max_bind_groups: 4,
      max_bindings_per_bind_group: 640,
      max_buffer_size: 256 * 1024 * 1024,
      max_vertex_buffer_array_stride: 2048,
      max_vertex_buffers: 8,
      max_vertex_attributes: 16,
      max_compute_workgroup_size_x: 256,
      max_compute_workgroup_size_y: 256,
      max_compute_workgroup_size_z: 64,
      max_compute_invocations_per_workgroup: 256
    }
  end
end

pub struct WebGPUDevice
  handle: WGPUDevice
  queue: WGPUQueue
  adapter: WGPUAdapter
end

impl WebGPUDevice
  pub fn handle(self: Self) -> WGPUDevice
    self.handle
  end
  
  pub fn queue(self: Self) -> WGPUQueue
    self.queue
  end
  
  pub def create_buffer(self: Self, descriptor: BufferDescriptor) -> Result[WebGPUBuffer, String]
    let mut handle: WGPUBuffer = Ptr::null()
    
    unsafe "webgpu create buffer" do
      handle = wgpu_device_create_buffer(
        self.handle,
        descriptor.label.as_ptr(),
        descriptor.usage.to_wgpu(),
        descriptor.size,
        descriptor.mapped_at_creation
      )
      if handle.is_null() then
        return Result::Err("Failed to create buffer")
      end
    end
    
    Result::Ok(WebGPUBuffer {
      handle: handle,
      size: descriptor.size,
      mapped: descriptor.mapped_at_creation
    })
  end
  
  pub def create_texture(self: Self, descriptor: TextureDescriptor) -> Result[WebGPUTexture, String]
    let mut handle: WGPUTexture = Ptr::null()
    
    unsafe "webgpu create texture" do
      handle = wgpu_device_create_texture(
        self.handle,
        descriptor.label.as_ptr(),
        descriptor.usage.to_wgpu(),
        descriptor.dimension as u32,
        descriptor.size.width,
        descriptor.size.height,
        descriptor.size.depth_or_array_layers,
        descriptor.format.to_wgpu(),
        descriptor.mip_level_count,
        descriptor.sample_count
      )
      if handle.is_null() then
        return Result::Err("Failed to create texture")
      end
    end
    
    Result::Ok(WebGPUTexture {
      handle: handle,
      width: descriptor.size.width,
      height: descriptor.size.height,
      format: descriptor.format
    })
  end
  
  pub def create_shader_module(self: Self, descriptor: ShaderModuleDescriptor) -> Result[WebGPUShaderModule, String]
    let mut handle: WGPUShaderModule = Ptr::null()
    
    unsafe "webgpu create shader module" do
      handle = wgpu_device_create_shader_module(
        self.handle,
        descriptor.label.as_ptr(),
        descriptor.code.as_ptr(),
        descriptor.code.len()
      )
      if handle.is_null() then
        return Result::Err("Failed to create shader module")
      end
    end
    
    Result::Ok(WebGPUShaderModule { handle: handle })
  end
  
  pub def create_render_pipeline(self: Self, descriptor: RenderPipelineDescriptor) -> Result[WebGPURenderPipeline, String]
    let mut handle: WGPURenderPipeline = Ptr::null()
    
    unsafe "webgpu create render pipeline" do
      handle = wgpu_device_create_render_pipeline(self.handle, descriptor as Ptr[u8])
      if handle.is_null() then
        return Result::Err("Failed to create render pipeline")
      end
    end
    
    Result::Ok(WebGPURenderPipeline { handle: handle })
  end
  
  pub def create_compute_pipeline(self: Self, descriptor: ComputePipelineDescriptor) -> Result[WebGPUComputePipeline, String]
    let mut handle: WGPUComputePipeline = Ptr::null()
    
    unsafe "webgpu create compute pipeline" do
      handle = wgpu_device_create_compute_pipeline(self.handle, descriptor as Ptr[u8])
      if handle.is_null() then
        return Result::Err("Failed to create compute pipeline")
      end
    end
    
    Result::Ok(WebGPUComputePipeline { handle: handle })
  end
  
  pub def create_command_encoder(self: Self) -> WebGPUCommandEncoder
    let mut handle: WGPUCommandEncoder = Ptr::null()
    
    unsafe "webgpu create command encoder" do
      handle = wgpu_device_create_command_encoder(self.handle, Ptr::null())
    end
    
    WebGPUCommandEncoder { handle: handle, device: self.handle }
  end
  
  pub def create_bind_group_layout(self: Self, descriptor: BindGroupLayoutDescriptor) -> Result[WebGPUBindGroupLayout, String]
    let mut handle: WGPUBindGroupLayout = Ptr::null()
    
    unsafe "webgpu create bind group layout" do
      handle = wgpu_device_create_bind_group_layout(self.handle, descriptor as Ptr[u8])
      if handle.is_null() then
        return Result::Err("Failed to create bind group layout")
      end
    end
    
    Result::Ok(WebGPUBindGroupLayout { handle: handle })
  end
  
  pub def create_bind_group(self: Self, descriptor: BindGroupDescriptor) -> Result[WebGPUBindGroup, String]
    let mut handle: WGPUBindGroup = Ptr::null()
    
    unsafe "webgpu create bind group" do
      handle = wgpu_device_create_bind_group(self.handle, descriptor as Ptr[u8])
      if handle.is_null() then
        return Result::Err("Failed to create bind group")
      end
    end
    
    Result::Ok(WebGPUBindGroup { handle: handle })
  end
  
  pub def create_sampler(self: Self, descriptor: SamplerDescriptor) -> Result[WebGPUSampler, String]
    let mut handle: WGPUSampler = Ptr::null()
    
    unsafe "webgpu create sampler" do
      handle = wgpu_device_create_sampler(
        self.handle,
        descriptor.label.as_ptr(),
        descriptor.address_mode_u as u32,
        descriptor.address_mode_v as u32,
        descriptor.address_mode_w as u32,
        descriptor.mag_filter as u32,
        descriptor.min_filter as u32,
        descriptor.mipmap_filter as u32,
        descriptor.lod_min_clamp,
        descriptor.lod_max_clamp,
        descriptor.compare.map_or(0, |c| c as u32 + 1),
        descriptor.max_anisotropy
      )
      if handle.is_null() then
        return Result::Err("Failed to create sampler")
      end
    end
    
    Result::Ok(WebGPUSampler { handle: handle })
  end
  
  pub def poll(self: Self, wait: Bool) -> Unit
    unsafe "webgpu device poll" do
      wgpu_device_poll(self.handle, wait)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Buffer
# ———————————————————————————————————————————————————————————————

pub struct BufferDescriptor
  label: String
  size: u64
  usage: BufferUsage
  mapped_at_creation: Bool
end

pub struct WebGPUBuffer
  handle: WGPUBuffer
  size: u64
  mapped: Bool
end

impl WebGPUBuffer
  pub fn handle(self: Self) -> WGPUBuffer
    self.handle
  end
  
  pub fn size(self: Self) -> u64
    self.size
  end
  
  pub async fn map_async(self: Self, mode: MapMode, offset: u64, size: u64) -> Result[Unit, String]
    unsafe "webgpu buffer map async" do
      let result = await wgpu_buffer_map_async(self.handle, mode as u32, offset, size)
      if result != 0 then
        return Result::Err("Failed to map buffer")
      end
    end
    Result::Ok(())
  end
  
  pub def get_mapped_range(self: Self, offset: u64, size: u64) -> Ptr[u8]
    unsafe "webgpu buffer get mapped range" do
      wgpu_buffer_get_mapped_range(self.handle, offset, size)
    end
  end
  
  pub def unmap(self: Self) -> Unit
    unsafe "webgpu buffer unmap" do
      wgpu_buffer_unmap(self.handle)
    end
  end
  
  pub def destroy(self: Self) -> Unit
    unsafe "webgpu buffer destroy" do
      wgpu_buffer_destroy(self.handle)
    end
  end
end

pub enum MapMode
  Read
  Write
end

# ———————————————————————————————————————————————————————————————
# Texture
# ———————————————————————————————————————————————————————————————

pub struct TextureDescriptor
  label: String
  size: Extent3D
  mip_level_count: u32
  sample_count: u32
  dimension: TextureDimension
  format: TextureFormat
  usage: TextureUsage
end

pub struct WebGPUTexture
  handle: WGPUTexture
  width: u32
  height: u32
  format: TextureFormat
end

impl WebGPUTexture
  pub fn handle(self: Self) -> WGPUTexture
    self.handle
  end
  
  pub fn width(self: Self) -> u32
    self.width
  end
  
  pub fn height(self: Self) -> u32
    self.height
  end
  
  pub fn format(self: Self) -> TextureFormat
    self.format
  end
  
  pub def create_view(self: Self, descriptor: Option[TextureViewDescriptor]) -> WebGPUTextureView
    let mut handle: WGPUTextureView = Ptr::null()
    
    unsafe "webgpu texture create view" do
      handle = match descriptor
        when Option::Some(desc) then
          wgpu_texture_create_view(self.handle, desc as Ptr[u8])
        when Option::None then
          wgpu_texture_create_view(self.handle, Ptr::null())
      end
    end
    
    WebGPUTextureView { handle: handle }
  end
  
  pub def destroy(self: Self) -> Unit
    unsafe "webgpu texture destroy" do
      wgpu_texture_destroy(self.handle)
    end
  end
end

pub struct TextureViewDescriptor
  label: String
  format: TextureFormat
  dimension: TextureViewDimension
  aspect: TextureAspect
  base_mip_level: u32
  mip_level_count: u32
  base_array_layer: u32
  array_layer_count: u32
end

pub enum TextureAspect
  All
  StencilOnly
  DepthOnly
end

pub struct WebGPUTextureView
  handle: WGPUTextureView
end

impl WebGPUTextureView
  pub fn handle(self: Self) -> WGPUTextureView
    self.handle
  end
end

# ———————————————————————————————————————————————————————————————
# Sampler
# ———————————————————————————————————————————————————————————————

pub struct SamplerDescriptor
  label: String
