## Tangerine Standard Library — std::gpu_webgpu
## WebGPU Graphics API Backend for Web and Native
##
## Provides WebGPU implementation for cross-platform GPU access:
## - Device and adapter management
## - Swapchain and canvas configuration
## - Render pipelines and compute pipelines
## - Buffers, textures, and samplers
## - Command encoding and submission

use std::collections::{Vec, Map}
use std::ffi::{Ptr, CString}
use std::core::{Option, Result}
use std::async_runtime::{Future, AsyncResult}
use std::window::Window

# ———————————————————————————————————————————————————————————————
# WebGPU Types
# ———————————————————————————————————————————————————————————————

type WGPUInstance = Ptr[u8]
type WGPUAdapter = Ptr[u8]
type WGPUDevice = Ptr[u8]
type WGPUQueue = Ptr[u8]
type WGPUBuffer = Ptr[u8]
type WGPUTexture = Ptr[u8]
type WGPUTextureView = Ptr[u8]
type WGPUSampler = Ptr[u8]
type WGPUBindGroupLayout = Ptr[u8]
type WGPUBindGroup = Ptr[u8]
type WGPUPipelineLayout = Ptr[u8]
type WGPURenderPipeline = Ptr[u8]
type WGPUComputePipeline = Ptr[u8]
type WGPUCommandEncoder = Ptr[u8]
type WGPURenderPassEncoder = Ptr[u8]
type WGPUComputePassEncoder = Ptr[u8]
type WGPUShaderModule = Ptr[u8]
type WGPURenderBundle = Ptr[u8]
type WGPUQuerySet = Ptr[u8]
type WGPUSurface = Ptr[u8]
type WGPUSwapChain = Ptr[u8]

# ———————————————————————————————————————————————————————————————
# Enums
# ———————————————————————————————————————————————————————————————

pub enum TextureFormat
  # 8-bit formats
  R8Unorm
  R8Snorm
  R8Uint
  R8Sint
  # 16-bit formats
  R16Uint
  R16Sint
  R16Float
  RG8Unorm
  RG8Snorm
  RG8Uint
  RG8Sint
  # 32-bit formats
  R32Float
  R32Uint
  R32Sint
  RG16Uint
  RG16Sint
  RG16Float
  RGBA8Unorm
  RGBA8UnormSrgb
  RGBA8Snorm
  RGBA8Uint
  RGBA8Sint
  BGRA8Unorm
  BGRA8UnormSrgb
  # 64-bit formats
  RG32Float
  RG32Uint
  RG32Sint
  RGBA16Uint
  RGBA16Sint
  RGBA16Float
  # 128-bit formats
  RGBA32Float
  RGBA32Uint
  RGBA32Sint
  # Depth/stencil formats
  Depth16Unorm
  Depth24Plus
  Depth24PlusStencil8
  Depth32Float
  Depth32FloatStencil8
end

impl TextureFormat
  pub def to_wgpu(self: Self) -> u32
    match self
      when TextureFormat::R8Unorm then 1
      when TextureFormat::R8Snorm then 2
      when TextureFormat::R8Uint then 3
      when TextureFormat::R8Sint then 4
      when TextureFormat::R16Uint then 5
      when TextureFormat::R16Sint then 6
      when TextureFormat::R16Float then 7
      when TextureFormat::RG8Unorm then 8
      when TextureFormat::RG8Snorm then 9
      when TextureFormat::RG8Uint then 10
      when TextureFormat::RG8Sint then 11
      when TextureFormat::R32Float then 12
      when TextureFormat::R32Uint then 13
      when TextureFormat::R32Sint then 14
      when TextureFormat::RG16Uint then 15
      when TextureFormat::RG16Sint then 16
      when TextureFormat::RG16Float then 17
      when TextureFormat::RGBA8Unorm then 18
      when TextureFormat::RGBA8UnormSrgb then 19
      when TextureFormat::RGBA8Snorm then 20
      when TextureFormat::RGBA8Uint then 21
      when TextureFormat::RGBA8Sint then 22
      when TextureFormat::BGRA8Unorm then 23
      when TextureFormat::BGRA8UnormSrgb then 24
      when TextureFormat::RG32Float then 25
      when TextureFormat::RG32Uint then 26
      when TextureFormat::RG32Sint then 27
      when TextureFormat::RGBA16Uint then 28
      when TextureFormat::RGBA16Sint then 29
      when TextureFormat::RGBA16Float then 30
      when TextureFormat::RGBA32Float then 31
      when TextureFormat::RGBA32Uint then 32
      when TextureFormat::RGBA32Sint then 33
      when TextureFormat::Depth16Unorm then 34
      when TextureFormat::Depth24Plus then 35
      when TextureFormat::Depth24PlusStencil8 then 36
      when TextureFormat::Depth32Float then 37
      when TextureFormat::Depth32FloatStencil8 then 38
    end
  end
  
  pub fn bytes_per_pixel(self: Self) -> u32
    match self
      when TextureFormat::R8Unorm then 1
      when TextureFormat::R8Snorm then 1
      when TextureFormat::R8Uint then 1
      when TextureFormat::R8Sint then 1
      when TextureFormat::R16Uint then 2
      when TextureFormat::R16Sint then 2
      when TextureFormat::R16Float then 2
      when TextureFormat::RG8Unorm then 2
      when TextureFormat::RG8Snorm then 2
      when TextureFormat::RG8Uint then 2
      when TextureFormat::RG8Sint then 2
      when TextureFormat::R32Float then 4
      when TextureFormat::R32Uint then 4
      when TextureFormat::R32Sint then 4
      when TextureFormat::RG16Uint then 4
      when TextureFormat::RG16Sint then 4
      when TextureFormat::RG16Float then 4
      when TextureFormat::RGBA8Unorm then 4
      when TextureFormat::RGBA8UnormSrgb then 4
      when TextureFormat::RGBA8Snorm then 4
      when TextureFormat::RGBA8Uint then 4
      when TextureFormat::RGBA8Sint then 4
      when TextureFormat::BGRA8Unorm then 4
      when TextureFormat::BGRA8UnormSrgb then 4
      when TextureFormat::RG32Float then 8
      when TextureFormat::RG32Uint then 8
      when TextureFormat::RG32Sint then 8
      when TextureFormat::RGBA16Uint then 8
      when TextureFormat::RGBA16Sint then 8
      when TextureFormat::RGBA16Float then 8
      when TextureFormat::RGBA32Float then 16
      when TextureFormat::RGBA32Uint then 16
      when TextureFormat::RGBA32Sint then 16
      when TextureFormat::Depth16Unorm then 2
      when TextureFormat::Depth24Plus then 4
      when TextureFormat::Depth24PlusStencil8 then 4
      when TextureFormat::Depth32Float then 4
      when TextureFormat::Depth32FloatStencil8 then 8
    end
  end
end

pub enum BufferUsage
  MapRead
  MapWrite
  CopySrc
  CopyDst
  Index
  Vertex
  Uniform
  Storage
  Indirect
  QueryResolve
end

impl BufferUsage
  pub def to_wgpu(self: Self) -> u32
    match self
      when BufferUsage::MapRead then 1
      when BufferUsage::MapWrite then 2
      when BufferUsage::CopySrc then 4
      when BufferUsage::CopyDst then 8
      when BufferUsage::Index then 16
      when BufferUsage::Vertex then 32
      when BufferUsage::Uniform then 64
      when BufferUsage::Storage then 128
      when BufferUsage::Indirect then 256
      when BufferUsage::QueryResolve then 512
    end
  end
end

pub enum TextureUsage
  CopySrc
  CopyDst
  TextureBinding
  StorageBinding
  RenderAttachment
end

impl TextureUsage
  pub def to_wgpu(self: Self) -> u32
    match self
      when TextureUsage::CopySrc then 1
      when TextureUsage::CopyDst then 2
      when TextureUsage::TextureBinding then 4
      when TextureUsage::StorageBinding then 8
      when TextureUsage::RenderAttachment then 16
    end
  end
end

pub enum TextureDimension
  D1
  D2
  D3
end

pub enum TextureViewDimension
  D1
  D2
  D2Array
  Cube
  CubeArray
  D3
end

pub enum ShaderStage
  Vertex
  Fragment
  Compute
end

impl ShaderStage
  pub def to_wgpu(self: Self) -> u32
    match self
      when ShaderStage::Vertex then 1
      when ShaderStage::Fragment then 2
      when ShaderStage::Compute then 4
    end
  end
end

