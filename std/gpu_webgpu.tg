# ———————————————————————————————————————————————————————————————

pub struct RenderPassDescriptor
  label: String
  color_attachments: Vec[RenderPassColorAttachment]
  depth_stencil_attachment: Option[RenderPassDepthStencilAttachment]
end

pub struct RenderPassColorAttachment
  view: WebGPUTextureView
  resolve_target: Option[WebGPUTextureView]
  load_op: LoadOp
  store_op: StoreOp
  clear_value: Color
end

pub struct RenderPassDepthStencilAttachment
  view: WebGPUTextureView
  depth_load_op: LoadOp
  depth_store_op: StoreOp
  depth_clear_value: f32
  depth_read_only: Bool
  stencil_load_op: LoadOp
  stencil_store_op: StoreOp
  stencil_clear_value: u32
  stencil_read_only: Bool
end

pub struct WebGPURenderPassEncoder
  handle: WGPURenderPassEncoder
end

impl WebGPURenderPassEncoder
  pub def set_pipeline(self: Self, pipeline: WebGPURenderPipeline) -> Unit
    unsafe "webgpu set pipeline" do
      wgpu_render_pass_set_pipeline(self.handle, pipeline.handle)
    end
  end
  
  pub def set_bind_group(self: Self, index: u32, bind_group: WebGPUBindGroup, dynamic_offsets: Vec[u32]) -> Unit
    unsafe "webgpu set bind group" do
      wgpu_render_pass_set_bind_group(self.handle, index, bind_group.handle, dynamic_offsets.as_ptr(), dynamic_offsets.len())
    end
  end
  
  pub def set_vertex_buffer(self: Self, slot: u32, buffer: WebGPUBuffer, offset: u64, size: Option[u64]) -> Unit
    unsafe "webgpu set vertex buffer" do
      wgpu_render_pass_set_vertex_buffer(self.handle, slot, buffer.handle, offset, size.map_or(u64::MAX, |s| s))
    end
  end
  
  pub def set_index_buffer(self: Self, buffer: WebGPUBuffer, format: IndexFormat, offset: u64, size: Option[u64]) -> Unit
    unsafe "webgpu set index buffer" do
      wgpu_render_pass_set_index_buffer(self.handle, buffer.handle, format as u32, offset, size.map_or(u64::MAX, |s| s))
    end
  end
  
  pub def set_viewport(self: Self, x: f32, y: f32, width: f32, height: f32, min_depth: f32, max_depth: f32) -> Unit
    unsafe "webgpu set viewport" do
      wgpu_render_pass_set_viewport(self.handle, x, y, width, height, min_depth, max_depth)
    end
  end
  
  pub def set_scissor_rect(self: Self, x: u32, y: u32, width: u32, height: u32) -> Unit
    unsafe "webgpu set scissor rect" do
      wgpu_render_pass_set_scissor_rect(self.handle, x, y, width, height)
    end
  end
  
  pub def set_blend_constant(self: Self, color: Color) -> Unit
    unsafe "webgpu set blend constant" do
      wgpu_render_pass_set_blend_constant(self.handle, color.r, color.g, color.b, color.a)
    end
  end
  
  pub def set_stencil_reference(self: Self, reference: u32) -> Unit
    unsafe "webgpu set stencil reference" do
      wgpu_render_pass_set_stencil_reference(self.handle, reference)
    end
  end
  
  pub def draw(self: Self, vertex_count: u32, instance_count: u32, first_vertex: u32, first_instance: u32) -> Unit
    unsafe "webgpu draw" do
      wgpu_render_pass_draw(self.handle, vertex_count, instance_count, first_vertex, first_instance)
    end
  end
  
  pub def draw_indexed(self: Self, index_count: u32, instance_count: u32, first_index: u32, base_vertex: i32, first_instance: u32) -> Unit
    unsafe "webgpu draw indexed" do
      wgpu_render_pass_draw_indexed(self.handle, index_count, instance_count, first_index, base_vertex, first_instance)
    end
  end
  
  pub def draw_indirect(self: Self, buffer: WebGPUBuffer, indirect_offset: u64) -> Unit
    unsafe "webgpu draw indirect" do
      wgpu_render_pass_draw_indirect(self.handle, buffer.handle, indirect_offset)
    end
  end
  
  pub def draw_indexed_indirect(self: Self, buffer: WebGPUBuffer, indirect_offset: u64) -> Unit
    unsafe "webgpu draw indexed indirect" do
      wgpu_render_pass_draw_indexed_indirect(self.handle, buffer.handle, indirect_offset)
    end
  end
  
  pub def end(self: Self) -> Unit
    unsafe "webgpu render pass end" do
      wgpu_render_pass_end(self.handle)
    end
  end
end

