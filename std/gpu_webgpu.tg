# ———————————————————————————————————————————————————————————————
# Command Encoder
# ———————————————————————————————————————————————————————————————

pub struct WebGPUCommandEncoder
  handle: WGPUCommandEncoder
  device: WGPUDevice
end

impl WebGPUCommandEncoder
  pub fn handle(self: Self) -> WGPUCommandEncoder
    self.handle
  end
  
  pub def begin_render_pass(self: Self, descriptor: RenderPassDescriptor) -> WebGPURenderPassEncoder
    let mut handle: WGPURenderPassEncoder = Ptr::null()
    
    unsafe "webgpu begin render pass" do
      handle = wgpu_command_encoder_begin_render_pass(self.handle, descriptor as Ptr[u8])
    end
    
    WebGPURenderPassEncoder { handle: handle }
  end
  
  pub def begin_compute_pass(self: Self, descriptor: Option[ComputePassDescriptor]) -> WebGPUComputePassEncoder
    let mut handle: WGPUComputePassEncoder = Ptr::null()
    
    unsafe "webgpu begin compute pass" do
      handle = wgpu_command_encoder_begin_compute_pass(
        self.handle,
        descriptor.map_or_ptr(Ptr::null(), |d| d as Ptr[u8])
      )
    end
    
    WebGPUComputePassEncoder { handle: handle }
  end
  
  pub def copy_buffer_to_buffer(self: Self, src: WebGPUBuffer, src_offset: u64, dst: WebGPUBuffer, dst_offset: u64, size: u64) -> Unit
    unsafe "webgpu copy buffer to buffer" do
      wgpu_command_encoder_copy_buffer_to_buffer(self.handle, src.handle, src_offset, dst.handle, dst_offset, size)
    end
  end
  
  pub def copy_buffer_to_texture(self: Self, src: ImageCopyBuffer, dst: ImageCopyTexture, size: Extent3D) -> Unit
    unsafe "webgpu copy buffer to texture" do
      wgpu_command_encoder_copy_buffer_to_texture(self.handle, src as Ptr[u8], dst as Ptr[u8], size.width, size.height, size.depth_or_array_layers)
    end
  end
  
  pub def copy_texture_to_buffer(self: Self, src: ImageCopyTexture, dst: ImageCopyBuffer, size: Extent3D) -> Unit
    unsafe "webgpu copy texture to buffer" do
      wgpu_command_encoder_copy_texture_to_buffer(self.handle, src as Ptr[u8], dst as Ptr[u8], size.width, size.height, size.depth_or_array_layers)
    end
  end
  
  pub def finish(inout self: Self) -> WebGPUCommandBuffer
    let mut handle: Ptr[u8] = Ptr::null()
    
    unsafe "webgpu command encoder finish" do
      handle = wgpu_command_encoder_finish(self.handle, Ptr::null())
    end
    
    self.handle = Ptr::null()
    WebGPUCommandBuffer { handle: handle }
  end
end

pub struct ImageCopyBuffer
  buffer: WebGPUBuffer
  offset: u64
  bytes_per_row: Option[u32]
  rows_per_image: Option[u32]
end

pub struct ImageCopyTexture
  texture: WebGPUTexture
  mip_level: u32
  origin: Origin3D
  aspect: TextureAspect
end

