# ─── Convenience Wrappers ────────────────────────────────────────────

pub def abs(x: Float) -> Float = fabs(x)

pub def degrees(radians: Float) -> Float = radians * 180.0 / PI

pub def radians(degrees: Float) -> Float = degrees * PI / 180.0

pub def clamp(x: Float, lo: Float, hi: Float) -> Float
  if x < lo then lo
  elsif x > hi then hi
  else x
  end
end

pub def lerp(a: Float, b: Float, t: Float) -> Float
  a + (b - a) * t
end

pub def is_nan(x: Float) -> Bool = x != x

pub def is_infinite(x: Float) -> Bool = x == INFINITY || x == NEG_INFINITY

pub def is_finite(x: Float) -> Bool = !is_nan(x) && !is_infinite(x)

pub def approx_eq(a: Float, b: Float, epsilon: Float = EPSILON) -> Bool
  fabs(a - b) <= epsilon
end

## Integer math utilities
pub def gcd(a: Int, b: Int) -> Int
  var x = if a < 0 then -a else a end
  var y = if b < 0 then -b else b end
  while y != 0 do
    let t = y
    y = x % y
    x = t
  end
  x
end

pub def lcm(a: Int, b: Int) -> Int
  if a == 0 || b == 0 then 0
  else (a / gcd(a, b)) * b
  end
end

pub def factorial(n: Int) -> Int
  pre n >= 0, "factorial requires non-negative input"
  if n <= 1 then 1
  else
    var result = 1
    for i in 2..=n do
      result = result * i
    end
    result
  end
end

pub def pow_int(base: Int, exp: Int) -> Int
  pre exp >= 0, "pow_int requires non-negative exponent"
  if exp == 0 then return 1 end
  var result = 1
  var b = base
  var e = exp
  while e > 0 do
    if e % 2 == 1 then result = result * b end
    b = b * b
    e = e / 2
  end
  result
end

pub def is_prime(n: Int) -> Bool
  if n < 2 then return false end
  if n < 4 then return true end
  if n % 2 == 0 || n % 3 == 0 then return false end
  var i = 5
  while i * i <= n do
    if n % i == 0 || n % (i + 2) == 0 then return false end
    i = i + 6
  end
  true
end

# ─── BigInt — Arbitrary-precision integer ────────────────────────────

pub struct BigInt
  ## Sign: false = non-negative, true = negative
  negative: Bool
  ## Digits in base 2^32, least significant first
  digits: Vec[UInt]
end

impl BigInt
  pub def zero() -> BigInt
    BigInt { negative: false, digits: vec![0u32] }
  end

  pub def one() -> BigInt
    BigInt { negative: false, digits: vec![1u32] }
  end

  pub def from_int(value: Int) -> BigInt
    if value == 0 then return BigInt.zero() end
    let neg = value < 0
    var v: UInt = if neg then (-value) as UInt else value as UInt end
    var digs = Vec[UInt].new()
    while v > 0 do
      digs.push((v & 0xFFFFFFFF) as UInt)
      v = v >> 32
    end
    BigInt { negative: neg, digits: digs }
  end

  pub def from_string(s: String) -> Result[BigInt, String]
    if s.len() == 0 then return Err("empty string") end
    var start = 0
    var neg = false
    if s.char_at(0) == '-' then
      neg = true
      start = 1
    elsif s.char_at(0) == '+' then
      start = 1
    end
    if start >= s.len() then return Err("no digits") end

    var result = BigInt.zero()
    let ten = BigInt.from_int(10)
    for i in start..s.len() do
      let ch = s.char_at(i)
      if ch < '0' || ch > '9' then
        return Err("invalid digit: " + ch.to_string())
      end
      let digit = (ch as Int) - ('0' as Int)
      result = result.mul(ten).add(BigInt.from_int(digit))
    end
    result.negative = neg && !result.is_zero()
    Ok(result)
  end

  pub def is_zero(self) -> Bool
    self.digits.len() == 1 && self.digits.get(0) == Some(0u32)
  end

  pub def negate(self) -> BigInt
    if self.is_zero() then return self end
    BigInt { negative: !self.negative, digits: self.digits.clone() }
  end

  pub def abs(self) -> BigInt
    BigInt { negative: false, digits: self.digits.clone() }
  end

  pub def add(self, other: BigInt) -> BigInt
    if self.negative == other.negative then
      let sum_digits = _add_unsigned(self.digits, other.digits)
      BigInt { negative: self.negative, digits: sum_digits }
    elsif _cmp_unsigned(self.digits, other.digits) >= 0 then
      let diff = _sub_unsigned(self.digits, other.digits)
      BigInt { negative: self.negative, digits: diff }
    else
      let diff = _sub_unsigned(other.digits, self.digits)
      BigInt { negative: other.negative, digits: diff }
    end
  end

  pub def sub(self, other: BigInt) -> BigInt
    self.add(other.negate())
  end

  pub def mul(self, other: BigInt) -> BigInt
    if self.is_zero() || other.is_zero() then return BigInt.zero() end
    let product = _mul_unsigned(self.digits, other.digits)
    BigInt { negative: self.negative != other.negative, digits: product }
  end

  pub def div(self, other: BigInt) -> BigInt
    pre !other.is_zero(), "division by zero"
    let (quotient, _) = _div_mod_unsigned(self.digits, other.digits)
    let neg = self.negative != other.negative
    var result = BigInt { negative: neg, digits: quotient }
    if result.is_zero() then result.negative = false end
    result
  end

  pub def modulo(self, other: BigInt) -> BigInt
    pre !other.is_zero(), "division by zero"
    let (_, remainder) = _div_mod_unsigned(self.digits, other.digits)
    var result = BigInt { negative: self.negative, digits: remainder }
    if result.is_zero() then result.negative = false end
    result
  end

  pub def pow(self, exp: Int) -> BigInt
    pre exp >= 0, "BigInt.pow requires non-negative exponent"
    if exp == 0 then return BigInt.one() end
    var result = BigInt.one()
    var base = self
    var e = exp
    while e > 0 do
      if e % 2 == 1 then result = result.mul(base) end
      base = base.mul(base)
      e = e / 2
    end
    result
  end

  pub def compare(self, other: BigInt) -> Int
    if self.negative && !other.negative then return -1 end
    if !self.negative && other.negative then return 1 end
    let ucmp = _cmp_unsigned(self.digits, other.digits)
    if self.negative then -ucmp else ucmp end
  end

  pub def to_string(self) -> String
    if self.is_zero() then return "0" end
    var current = self.abs()
    let ten = BigInt.from_int(10)
    var chars = Vec[String].new()
    while !current.is_zero() do
      let (q, r) = _div_mod_unsigned(current.digits, ten.digits)
      let digit = if r.len() > 0 then r.get(0).unwrap_or(0u32) else 0u32 end
      chars.push((digit as Int).to_string())
      current = BigInt { negative: false, digits: q }
    end
    var result = if self.negative then "-" else "" end
    for i in (0..chars.len()).rev() do
      result = result + chars.get(i).unwrap_or("0")
    end
    result
  end
end

impl Display for BigInt
  def fmt(self, inout f: fmt::Formatter) -> fmt::Result
    f.write_str(self.to_string())
  end
end

impl Eq for BigInt
  def eq(self, other: BigInt) -> Bool = self.compare(*other) == 0
end

impl Ord for BigInt
  def cmp(self, other: BigInt) -> Ordering
    let ord = self.compare(*other)
    if ord < 0 then Ordering::Less
    elsif ord > 0 then Ordering::Greater
    else Ordering::Equal
    end
  end
end

## Internal unsigned arithmetic helpers
def _add_unsigned(a: Vec[UInt], b: Vec[UInt]) -> Vec[UInt]
  let n = if a.len() > b.len() then a.len() else b.len() end
  var result = Vec[UInt].with_capacity(n + 1)
  var carry: UInt = 0
  for i in 0..n do
    let av: UInt = if i < a.len() then a.get(i).unwrap_or(0u32) else 0u32 end
    let bv: UInt = if i < b.len() then b.get(i).unwrap_or(0u32) else 0u32 end
    let sum: UInt = av + bv + carry
    result.push(sum & 0xFFFFFFFF)
    carry = sum >> 32
  end
  if carry > 0 then result.push(carry) end
  result
end

def _sub_unsigned(a: Vec[UInt], b: Vec[UInt]) -> Vec[UInt]
  var result = Vec[UInt].with_capacity(a.len())
  var borrow: UInt = 0
  for i in 0..a.len() do
    let av = a.get(i).unwrap_or(0u32)
    let bv: UInt = if i < b.len() then b.get(i).unwrap_or(0u32) else 0u32 end
    let diff = (av as Int) - (bv as Int) - (borrow as Int)
    if diff < 0 then
      result.push(((diff + 0x100000000) as UInt) & 0xFFFFFFFF)
      borrow = 1
    else
      result.push((diff as UInt) & 0xFFFFFFFF)
      borrow = 0
    end
  end
  ## Strip leading zeros
  while result.len() > 1 && result.get(result.len() - 1) == Some(0u32) do
    result.pop()
  end
  result
end

def _mul_unsigned(a: Vec[UInt], b: Vec[UInt]) -> Vec[UInt]
  var result = Vec[UInt].with_capacity(a.len() + b.len())
  for _ in 0..(a.len() + b.len()) do result.push(0u32) end
  for i in 0..a.len() do
    var carry: UInt = 0
    for j in 0..b.len() do
      let av = a.get(i).unwrap_or(0u32)
      let bv = b.get(j).unwrap_or(0u32)
      let cur = result.get(i + j).unwrap_or(0u32)
      let prod = (av as UInt) * (bv as UInt) + (cur as UInt) + carry
      result.set(i + j, prod & 0xFFFFFFFF)
      carry = prod >> 32
    end
    if carry > 0 then
      let idx = i + b.len()
      let cur = result.get(idx).unwrap_or(0u32)
      result.set(idx, cur + carry)
    end
  end
  while result.len() > 1 && result.get(result.len() - 1) == Some(0u32) do
    result.pop()
  end
  result
end

def _cmp_unsigned(a: Vec[UInt], b: Vec[UInt]) -> Int
  if a.len() != b.len() then
    return if a.len() > b.len() then 1 else -1 end
  end
  for i in (0..a.len()).rev() do
    let av = a.get(i).unwrap_or(0u32)
    let bv = b.get(i).unwrap_or(0u32)
    if av > bv then return 1 end
    if av < bv then return -1 end
  end
  0
end

def _div_mod_unsigned(a: Vec[UInt], b: Vec[UInt]) -> (Vec[UInt], Vec[UInt])
  if _cmp_unsigned(a, b) < 0 then
    return (vec![0u32], a.clone())
  end
  ## Simple long division — sufficient for correctness; Knuth Algorithm D for perf
  var remainder = BigInt { negative: false, digits: a.clone() }
  var divisor = BigInt { negative: false, digits: b.clone() }
  var quotient = BigInt.zero()
  var shift = BigInt.one()

  ## Find highest power of divisor
  var shifted_divisor = divisor
  var shifted_shift = shift
  while _cmp_unsigned(shifted_divisor.digits, remainder.digits) <= 0 do
    shifted_divisor = shifted_divisor.add(shifted_divisor)  ## mul by 2
    shifted_shift = shifted_shift.add(shifted_shift)
  end

  while _cmp_unsigned(shifted_shift.digits, BigInt.one().digits) > 0 do
    shifted_divisor = BigInt { negative: false, digits: _shr1(shifted_divisor.digits) }
    shifted_shift = BigInt { negative: false, digits: _shr1(shifted_shift.digits) }
    if _cmp_unsigned(remainder.digits, shifted_divisor.digits) >= 0 then
      remainder = remainder.sub(shifted_divisor)
      quotient = quotient.add(shifted_shift)
    end
  end

  (quotient.digits, remainder.digits)
end

def _shr1(digits: Vec[UInt]) -> Vec[UInt]
  var result = Vec[UInt].with_capacity(digits.len())
  var carry: UInt = 0
  for i in (0..digits.len()).rev() do
    let d = digits.get(i).unwrap_or(0u32)
    result.insert(0, (d >> 1) | (carry << 31))
    carry = d & 1
  end
  while result.len() > 1 && result.get(result.len() - 1) == Some(0u32) do
    result.pop()
  end
  result
end

# ─── BigDecimal — Arbitrary-precision decimal ────────────────────────

pub struct BigDecimal
  ## Unscaled value (significand)
  unscaled: BigInt
  ## Number of digits after decimal point
  scale: Int
end

impl BigDecimal
  pub def zero() -> BigDecimal
    BigDecimal { unscaled: BigInt.zero(), scale: 0 }
  end

  pub def from_int(value: Int) -> BigDecimal
    BigDecimal { unscaled: BigInt.from_int(value), scale: 0 }
  end

  pub def from_parts(unscaled: BigInt, scale: Int) -> BigDecimal
    BigDecimal { unscaled: unscaled, scale: scale }
  end

  pub def from_string(s: String) -> Result[BigDecimal, String]
    let dot_pos = s.index_of('.')
    match dot_pos
    when Some(pos) then
      let integer_part = s.substring(0, pos)
      let frac_part = s.substring(pos + 1, s.len())
      let scale = frac_part.len() as Int
      let digits_str = integer_part + frac_part
      let unscaled = BigInt.from_string(digits_str)?
      Ok(BigDecimal { unscaled: unscaled, scale: scale })
    when None then
      let unscaled = BigInt.from_string(s)?
      Ok(BigDecimal { unscaled: unscaled, scale: 0 })
    end
  end

  pub def add(self, other: BigDecimal) -> BigDecimal
    let (a, b) = _align_scales(self, other)
    BigDecimal { unscaled: a.unscaled.add(b.unscaled), scale: a.scale }
  end

  pub def sub(self, other: BigDecimal) -> BigDecimal
    let (a, b) = _align_scales(self, other)
    BigDecimal { unscaled: a.unscaled.sub(b.unscaled), scale: a.scale }
  end

  pub def mul(self, other: BigDecimal) -> BigDecimal
    BigDecimal {
      unscaled: self.unscaled.mul(other.unscaled),
      scale: self.scale + other.scale,
    }
  end

  pub def div(self, other: BigDecimal, precision: Int = 20) -> BigDecimal
    let scale_diff = precision - self.scale + other.scale
    var numerator = self.unscaled
    if scale_diff > 0 then
      let factor = BigInt.from_int(10).pow(scale_diff)
      numerator = numerator.mul(factor)
    end
    BigDecimal { unscaled: numerator.div(other.unscaled), scale: precision }
  end

  pub def negate(self) -> BigDecimal
    BigDecimal { unscaled: self.unscaled.negate(), scale: self.scale }
  end

  pub def abs(self) -> BigDecimal
    BigDecimal { unscaled: self.unscaled.abs(), scale: self.scale }
  end

  pub def round(self, new_scale: Int) -> BigDecimal
    if new_scale >= self.scale then return self end
    let diff = self.scale - new_scale
    let divisor = BigInt.from_int(10).pow(diff)
    let half = divisor.div(BigInt.from_int(2))
    let remainder = self.unscaled.abs().modulo(divisor)
    var quotient = self.unscaled.div(divisor)
    ## Round half-up
    if remainder.compare(half) >= 0 then
      if self.unscaled.compare(BigInt.zero()) >= 0 then
        quotient = quotient.add(BigInt.one())
      else
        quotient = quotient.sub(BigInt.one())
      end
    end
    BigDecimal { unscaled: quotient, scale: new_scale }
  end

  pub def compare(self, other: BigDecimal) -> Int
    let (a, b) = _align_scales(self, other)
    a.unscaled.compare(b.unscaled)
  end

  pub def to_string(self) -> String
    let s = self.unscaled.abs().to_string()
    let neg = if self.unscaled.compare(BigInt.zero()) < 0 then "-" else "" end
    if self.scale <= 0 then
      return neg + s
    end
    let pad_len = self.scale - (s.len() as Int) + 1
    var padded = s
    if pad_len > 0 then
      for _ in 0..pad_len do padded = "0" + padded end
    end
    let dot_pos = padded.len() - (self.scale as UInt)
    neg + padded.substring(0, dot_pos as Int) + "." + padded.substring(dot_pos as Int, padded.len() as Int)
  end
end

impl Display for BigDecimal
  def fmt(self, inout f: fmt::Formatter) -> fmt::Result
    f.write_str(self.to_string())
  end
end

impl Eq for BigDecimal
  def eq(self, other: BigDecimal) -> Bool = self.compare(*other) == 0
end

impl Ord for BigDecimal
  def cmp(self, other: BigDecimal) -> Ordering
    let ord = self.compare(*other)
    if ord < 0 then Ordering::Less
    elsif ord > 0 then Ordering::Greater
    else Ordering::Equal
    end
  end
end

def _align_scales(a: BigDecimal, b: BigDecimal) -> (BigDecimal, BigDecimal)
  if a.scale == b.scale then return (a, b) end
  if a.scale > b.scale then
    let factor = BigInt.from_int(10).pow(a.scale - b.scale)
    let b2 = BigDecimal { unscaled: b.unscaled.mul(factor), scale: a.scale }
    (a, b2)
  else
    let factor = BigInt.from_int(10).pow(b.scale - a.scale)
    let a2 = BigDecimal { unscaled: a.unscaled.mul(factor), scale: b.scale }
    (a2, b)
  end
end

# ─── Numeric trait extensions ────────────────────────────────────────

pub trait Numeric
  def add(self, other: Self) -> Self
  def sub(self, other: Self) -> Self
  def mul(self, other: Self) -> Self
  def div(self, other: Self) -> Self
  def neg(self) -> Self
  def zero() -> Self
  def one() -> Self
end

pub trait FloatOps
  def sin(self) -> Self
  def cos(self) -> Self
  def tan(self) -> Self
  def sqrt(self) -> Self
  def pow(self, exp: Self) -> Self
  def abs(self) -> Self
  def ceil(self) -> Self
  def floor(self) -> Self
  def round(self) -> Self
  def is_nan(self) -> Bool
  def is_infinite(self) -> Bool
  def is_finite(self) -> Bool
end

impl FloatOps for Float
  def sin(self) -> Float = math::sin(self)
  def cos(self) -> Float = math::cos(self)
  def tan(self) -> Float = math::tan(self)
  def sqrt(self) -> Float = math::sqrt(self)
  def pow(self, exp: Float) -> Float = math::pow(self, exp)
  def abs(self) -> Float = math::abs(self)
  def ceil(self) -> Float = math::ceil(self)
  def floor(self) -> Float = math::floor(self)
  def round(self) -> Float = math::round(self)
  def is_nan(self) -> Bool = math::is_nan(self)
  def is_infinite(self) -> Bool = math::is_infinite(self)
  def is_finite(self) -> Bool = math::is_finite(self)
end

# ─── Statistical helpers ─────────────────────────────────────────────

pub def sum(values: [Float]) -> Float
  var s = 0.0
  for v in values do s = s + v end
  s
end

pub def mean(values: [Float]) -> Float
  pre values.len() > 0, "mean requires non-empty slice"
  sum(values) / (values.len() as Float)
end

pub def variance(values: [Float]) -> Float
  pre values.len() > 1, "variance requires at least 2 values"
  let m = mean(values)
  var s = 0.0
  for v in values do
    let d = v - m
    s = s + d * d
  end
  s / ((values.len() - 1) as Float)
end

pub def stddev(values: [Float]) -> Float
  sqrt(variance(values))
end

pub def median(inout values: [Float]) -> Float
  pre values.len() > 0, "median requires non-empty slice"
  values.sort()
  let n = values.len()
  if n % 2 == 1 then
    values[n / 2]
  else
    (values[n / 2 - 1] + values[n / 2]) / 2.0
  end
end

end ## module std::math
