## std::math — Mathematics library
## Provides trigonometric, logarithmic, exponential, rounding, and special functions,
## plus arbitrary-precision BigInt and BigDecimal types and the heap-free
## fixed-point Fixed64/Fixed128 types (explicit rounding modes) and their
## const-scale siblings Decimal64[SCALE] / Decimal128[SCALE] and the
## phantom-dimension Money[Currency, Scale] / Price[Currency, Unit, Scale]
## / Quantity[Unit, Scale] / Rate[RateUnit, Scale] const-scale decimal
## types for finance/engineering (audit §23).
## Spec: §stdlib.math

module std::math

use std::core::{Option, Result, SmallErrorCode, Display, Clone, Eq, Ord, Hash, Default, From}
use std::fmt

# [METADATA]
# module: tg::math
# status: alpha
# effects: []
# capabilities: []
# error_codes: [InvalidArg, Internal]

use std::gfx_errors::{Error, ErrorCode}

enum MathError
  InvalidArg(Error)
  Internal(Error)
end

impl MathError
  def message(self: MathError) -> String
    match self
    when MathError::InvalidArg(e) then e.message.clone()
    when MathError::Internal(e) then e.message.clone()
    end
  end

  def code(self: MathError) -> ErrorCode
    match self
    when MathError::InvalidArg(_) then ErrorCode::InvalidArg
    when MathError::Internal(_) then ErrorCode::Internal
    end
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  let _ = logger
end

def _log_math_event(level: LogLevel, msg: String) -> Unit
  match GLOBAL_LOGGER.as_mut()
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: 0,
      level: level,
      category: LogCategory::App,
      message: "[MATH] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then {}
  end  end  end
end

