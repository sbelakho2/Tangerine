# Tangerine Standard Library — tg::assets
# Asset loading and content-addressable caching.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 13.3.

use std::core::{Option, Result, String, Bool, Int, Unit}
use std::crypto::{sha256}
use std::gfx_errors::{Error, ErrorCode}
use std::app::{FsCap}
use std::image::{Bitmap, ImageError}
use std::text::{FontDb, FontId, TextError}

# ═══════════════════════════════════════════════════════════════
# §13.3 Types
# ═══════════════════════════════════════════════════════════════

struct AssetId
  hash: Vec[u8]    # 32-byte SHA-256 hash of asset content
end

enum AssetError
  IOError(Error)
  InvalidData(Error)
  Unsupported(Error)
end

impl AssetError
  def message(self: &AssetError) -> &String
    match self
    when AssetError::IOError(e) then &e.message
    when AssetError::InvalidData(e) then &e.message
    when AssetError::Unsupported(e) then &e.message
    end
  end

  def code(self: &AssetError) -> ErrorCode
    match self
    when AssetError::IOError(_) then ErrorCode::IOError
    when AssetError::InvalidData(_) then ErrorCode::InvalidArg
    when AssetError::Unsupported(_) then ErrorCode::Unsupported
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# §13.3 Module API
# ═══════════════════════════════════════════════════════════════

def load_image(path: String, fs: &FsCap) -> Result[(AssetId, Bitmap), AssetError]
  # Load an image asset from disk, returning content-addressable AssetId + decoded Bitmap.
  # Requires FsCap for file access; delegates to tg::image::decode_file.
  Result::Err(AssetError::IOError(
    Error::io_error("load_image requires FsCap runtime integration for file access.".to_string())
  ))
end

def load_font(path: String, fs: &FsCap, db: &mut FontDb) -> Result[(AssetId, FontId), AssetError]
  # Load a font asset from disk, adding it to the FontDb.
  # Requires FsCap for file access; delegates to tg::text::font_db_add_file.
  Result::Err(AssetError::IOError(
    Error::io_error("load_font requires FsCap runtime integration for file access.".to_string())
  ))
end

# ═══════════════════════════════════════════════════════════════
# Internal: content hash placeholder
# ═══════════════════════════════════════════════════════════════

def _compute_hash(data: &Vec[u8]) -> AssetId
  let hash_bytes = sha256(data.as_slice())
  let hash = Vec::with_capacity(32)
  var i = 0
  while i < 32 do
    hash.push(hash_bytes[i])
    i = i + 1
  end
  AssetId { hash: hash }
end
