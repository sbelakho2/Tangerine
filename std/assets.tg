# Tangerine Standard Library — tg::assets
# Asset loading and content-addressable caching.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 13.3.

# [METADATA]
# module: tg::assets
# status: alpha
# effects: [File]
# capabilities: [Fs]
# error_codes: [IOError, InvalidData, Unsupported]

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::crypto::{sha256}
use std::gfx_errors::{Error, ErrorCode}
use std::app::{FsCap}
# use std::image::{Bitmap, ImageError}
# use std::text::{FontDb, FontId, TextError}

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

use std::time::{instant_now, duration_nanos}

def _log_asset_event(level: LogLevel, msg: String) -> Unit
  match &GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::Assets,
      message: "[ASSETS] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then {}
  end
end

# ═══════════════════════════════════════════════════════════════
# §13.3 Types
# ═══════════════════════════════════════════════════════════════

struct AssetId
  hash: Vec[u8]    # 32-byte SHA-256 hash of asset content
end

impl AssetId
  def hash_hex(self: &Self) -> String
    let mut s = "".to_string()
    let hex_chars = "0123456789abcdef".to_string()
    let mut i = 0
    while i < self.hash.len() do
      let b = self.hash.get(i)
      let high = (b >> 4) as Int
      let low = (b & 0x0f) as Int
      s.push(hex_chars.as_bytes()[high] as Char)
      s.push(hex_chars.as_bytes()[low] as Char)
      i = i + 1
    end
    s
  end
end

# Forward-declare Bitmap and FontDb/FontId
struct Bitmap
  width: Int
  height: Int
  data: Vec[u8]
end

struct FontId
  value: u64
end

struct FontDb
  fonts: Map[u64, String]
  next_id: u64
end

# ═══════════════════════════════════════════════════════════════
# §13.3 Module API
# ═══════════════════════════════════════════════════════════════

def load_image(path: String, fs: &FsCap) -> Result[(AssetId, Bitmap), AssetError]
  # Load an image asset from disk, returning content-addressable AssetId + decoded Bitmap.
  _log_asset_event(LogLevel::Info, "Loading image: " + path)
  
  # Production implementation: Use FsCap to read file, then decode via native image library.
  __intrinsic_assets_load_image(path, fs)
end

def load_font(path: String, fs: &FsCap, db: &mut FontDb) -> Result[(AssetId, FontId), AssetError]
  # Load a font asset from disk, adding it to the FontDb.
  _log_asset_event(LogLevel::Info, "Loading font: " + path)

  # Production implementation: Use FsCap to read file, then register via native text library.
  __intrinsic_assets_load_font(path, fs, db)
end

# ═══════════════════════════════════════════════════════════════
# Internal: content hash placeholder
# ═══════════════════════════════════════════════════════════════

def _compute_hash(data: &Vec[u8]) -> AssetId
  let hash_bytes = sha256(data.as_slice())
  let hash = Vec::with_capacity(32)
  var i = 0
  while i < 32 do
    hash.push(hash_bytes[i])
    i = i + 1
  end
  AssetId { hash: hash }
end
