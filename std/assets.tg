# Tangerine Standard Library — tg::assets
# Asset loading and content-addressable caching.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 13.3.

# [METADATA]
# module: tg::assets
# status: alpha
# effects: [File]
# capabilities: [Fs]
# error_codes: [IOError, InvalidData, Unsupported]

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::crypto::{sha256}
use std::gfx_errors::{Error, ErrorCode}
use std::app::{FsCap}
# use std::image::{Bitmap, ImageError}
# use std::text::{FontDb, FontId, TextError}

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

use std::time::{instant_now, duration_nanos}

def _log_asset_event(level: LogLevel, msg: String) -> Unit
  match GLOBAL_LOGGER.as_mut()
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::Assets,
      message: "[ASSETS] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then {}
  end
end

# ═══════════════════════════════════════════════════════════════
# §13.3 Types
# ═══════════════════════════════════════════════════════════════

struct AssetId
  hash: Vec[u8]    # 32-byte SHA-256 hash of asset content
end

impl AssetId
  def hash_hex(self: Self) -> String
    let mut s = "".to_string()
    let hex_chars = "0123456789abcdef".to_string()
    let mut i = 0
    while i < self.hash.len() do
      let b = self.hash.get(i)
      let high = (b >> 4) as Int
      let low = (b & 0x0f) as Int
      s.push(hex_chars.as_bytes()[high] as Char)
      s.push(hex_chars.as_bytes()[low] as Char)
      i = i + 1
    end
    s
  end
end

# Forward-declare Bitmap and FontDb/FontId
struct Bitmap
  width: Int
  height: Int
  data: Vec[u8]
end

struct FontId
  value: u64
end

struct FontDb
  fonts: Map[u64, String]
  next_id: u64
end

# ═══════════════════════════════════════════════════════════════
# §13.3 Module API
# ═══════════════════════════════════════════════════════════════

def load_image(path: String, fs: FsCap) -> Result[(AssetId, Bitmap), AssetError]
  _log_asset_event(LogLevel::Info, "Loading image: " + path)
  ## Read file bytes using filesystem capability
  let data = match std::fs::read_bytes(path.clone())
  when Result::Ok(bytes) then bytes
  when Result::Err(_) then return Result::Err(AssetError::NotFound(Error::new(ErrorCode::IOError, "Cannot read image: " + path, "assets")))
  end
  let asset_id = _compute_hash(&data)
  ## Decode image via std::image
  match std::image::decode(&data)
  when Result::Ok(bmp) then Result::Ok((asset_id, bmp))
  when Result::Err(_) then Result::Err(AssetError::LoadFailed(Error::new(ErrorCode::Internal, "Image decode failed: " + path, "assets")))
  end
end

def load_font(path: String, fs: FsCap, inout db: FontDb) -> Result[(AssetId, FontId), AssetError]
  _log_asset_event(LogLevel::Info, "Loading font: " + path)
  ## Read font file bytes using filesystem capability
  let data = match std::fs::read_bytes(path.clone())
  when Result::Ok(bytes) then bytes
  when Result::Err(_) then return Result::Err(AssetError::NotFound(Error::new(ErrorCode::IOError, "Cannot read font: " + path, "assets")))
  end
  let asset_id = _compute_hash(&data)
  ## Register font in the font database
  let font_id = FontId { value: db.next_id }
  db.next_id = db.next_id + 1u64
  db.fonts.insert(font_id.value, path)
  Result::Ok((asset_id, font_id))
end

# ═══════════════════════════════════════════════════════════════
# Internal: content hash (full sha256 of the asset bytes)
# ═══════════════════════════════════════════════════════════════

def _compute_hash(data: Vec[u8]) -> AssetId
  let hash_bytes = sha256(data.as_slice())
  let hash = Vec::with_capacity(32)
  var i = 0
  while i < 32 do
    hash.push(hash_bytes[i])
    i = i + 1
  end
  AssetId { hash: hash }
end
