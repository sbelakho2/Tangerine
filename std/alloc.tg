# Tangerine Standard Library — Memory Allocator Interface
#
# Provides pluggable memory allocation with support for:
# - Global allocator (default heap allocator)
# - Custom allocators (arena, bump, pool, etc.)
# - Allocator traits for generic code
#
# This module uses extern "C" to interface with system allocators.

use std::core::{Option, Result, panic}

# ———————————————————————————————————————————————————————————————
# Allocator Trait
# ———————————————————————————————————————————————————————————————

trait Allocator
  # Allocate memory of the given size and alignment.
  # Returns null pointer on failure.
  def allocate(self: &mut Self, size: UInt, align: UInt) -> Ptr[u8]
  
  # Deallocate memory previously allocated by this allocator.
  def deallocate(self: &mut Self, ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
  
  # Reallocate memory to a new size, preserving contents.
  # May return a different pointer.
  def reallocate(self: &mut Self, ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
  
  # Grow allocation in place if possible.
  def grow_in_place(self: &mut Self, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
  
  # Shrink allocation in place.
  def shrink_in_place(self: &mut Self, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
end

# ———————————————————————————————————————————————————————————————
# Layout Information
# ———————————————————————————————————————————————————————————————

struct Layout
  size: UInt
  align: UInt
end

def layout_new(size: UInt, align: UInt) -> Result[Layout, String]
  # Alignment must be a power of two
  if align == 0 || (align & (align - 1)) != 0 then
    return Result::Err("Alignment must be a power of two".to_string())
  end
  
  # Size must be a multiple of alignment (for arrays)
  if size % align != 0 then
    return Result::Err("Size must be a multiple of alignment".to_string())
  end
  
  Result::Ok(Layout { size: size, align: align })
end

def layout_from_size_align_unchecked(size: UInt, align: UInt) -> Layout
  Layout { size: size, align: align }
end

def layout_for[T]() -> Layout
  # Get size and alignment for type T
  # This is a compiler intrinsic
  Layout {
    size: size_of[T](),
    align: align_of[T]()
  }
end

def layout_array[T](count: UInt) -> Result[Layout, String]
  let elem_layout = layout_for[T]()
  let array_size = elem_layout.size * count
  
  # Check for overflow
  if count != 0 && array_size / count != elem_layout.size then
    return Result::Err("Array size overflow".to_string())
  end
  
  layout_new(array_size, elem_layout.align)
end

# Compiler intrinsics for type info
extern "Tangerine"
  def size_of[T]() -> UInt
  def align_of[T]() -> UInt
end

# ———————————————————————————————————————————————————————————————
# System Allocator (libc malloc/free)
# ———————————————————————————————————————————————————————————————

extern "C"
  def malloc(size: UInt) -> Ptr[u8]
  def free(ptr: Ptr[u8]) -> Unit
  def realloc(ptr: Ptr[u8], size: UInt) -> Ptr[u8]
  def calloc(count: UInt, size: UInt) -> Ptr[u8]
  
  # Aligned allocation (POSIX)
  def posix_memalign(memptr: Ptr[Ptr[u8]], align: UInt, size: UInt) -> Int
  
  # Aligned allocation (C11)
  def aligned_alloc(align: UInt, size: UInt) -> Ptr[u8]
end

struct SystemAllocator
  # Empty — stateless allocator
end

def system_allocator() -> SystemAllocator
  SystemAllocator {}
end

impl Allocator for SystemAllocator
  def allocate(self: &mut SystemAllocator, size: UInt, align: UInt) -> Ptr[u8]
    if size == 0 then
      return Ptr::null()
    end
    
    if align <= 16 then
      # Standard malloc provides at least 16-byte alignment
      malloc(size)
    else
      # Need aligned allocation  
      aligned_alloc(align, size)
    end
  end
  
  def deallocate(self: &mut SystemAllocator, ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
    if !ptr.is_null() then
      free(ptr)
    end
  end
  
  def reallocate(self: &mut SystemAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
    if ptr.is_null() then
      return self.allocate(new_size, align)
    end
    
    if new_size == 0 then
      self.deallocate(ptr, old_size, align)
      return Ptr::null()
    end
    
    if align <= 16 then
      let new_ptr = realloc(ptr, new_size)
      if new_ptr.is_null() then
        return Ptr::null()
      end
      new_ptr
    else
      # Aligned realloc not available - manual copy
      let new_ptr = self.allocate(new_size, align)
      if !new_ptr.is_null() then
        let copy_size = if old_size < new_size then old_size else new_size end
        ptr_copy(ptr, new_ptr, copy_size)
        self.deallocate(ptr, old_size, align)
      end
      new_ptr
    end
  end
  
  def grow_in_place(self: &mut SystemAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    # System allocator doesn't support in-place growth checking
    false
  end
  
  def shrink_in_place(self: &mut SystemAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    # Shrinking in place is always possible (we just use less of the allocation)
    true
  end
end

# ———————————————————————————————————————————————————————————————
# Arena Allocator (Bump Allocator)
# ———————————————————————————————————————————————————————————————

struct ArenaAllocator
  buffer: Ptr[u8]
  capacity: UInt
  offset: UInt
  backing: SystemAllocator
end

def arena_new(capacity: UInt) -> ArenaAllocator
  let backing = system_allocator()
  let buffer = backing.allocate(capacity, 16)
  if buffer.is_null() then
    panic("arena_new: allocation failed — out of memory")
  end
  ArenaAllocator {
    buffer: buffer,
    capacity: capacity,
    offset: 0,
    backing: backing
  }
end

def arena_reset(arena: &mut ArenaAllocator) -> Unit
  if arena.buffer.is_null() || arena.capacity == 0 then
    arena.offset = 0
    return
  end
  arena.offset = 0
end

def arena_destroy(arena: &mut ArenaAllocator) -> Unit
  arena.backing.deallocate(arena.buffer, arena.capacity, 16)
  arena.buffer = Ptr::null()
  arena.capacity = 0
  arena.offset = 0
end

impl Allocator for ArenaAllocator
  def allocate(self: &mut ArenaAllocator, size: UInt, align: UInt) -> Ptr[u8]
    if size == 0 then
      return Ptr::null()
    end

    if self.buffer.is_null() || self.capacity == 0 then
      return Ptr::null()
    end

    if align == 0 || (align & (align - 1)) != 0 then
      return Ptr::null()
    end

    # Align the current offset
    let aligned_offset = (self.offset + align - 1) & !(align - 1)

    if aligned_offset < self.offset then
      return Ptr::null()
    end

    let end_offset = aligned_offset + size
    if end_offset < aligned_offset then
      return Ptr::null()
    end
    
    if end_offset > self.capacity then
      return Ptr::null()  # Out of memory
    end
    
    let ptr = self.buffer.offset(aligned_offset as Int)
    self.offset = end_offset
    ptr
  end
  
  def deallocate(self: &mut ArenaAllocator, ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
    # Arena allocator doesn't free individual allocations
    # Memory is freed when arena is reset or destroyed
  end
  
  def reallocate(self: &mut ArenaAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
    # Simple: allocate new, copy, don't free old
    let new_ptr = self.allocate(new_size, align)
    if !new_ptr.is_null() && !ptr.is_null() then
      let copy_size = if old_size < new_size then old_size else new_size end
      ptr_copy(ptr, new_ptr, copy_size)
    end
    new_ptr
  end
  
  def grow_in_place(self: &mut ArenaAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    false
  end
  
  def shrink_in_place(self: &mut ArenaAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    true
  end
end

# ———————————————————————————————————————————————————————————————
# Pool Allocator (Fixed-Size Blocks)
# ———————————————————————————————————————————————————————————————

struct PoolAllocator
  buffer: Ptr[u8]
  block_size: UInt
  block_count: UInt
  free_list: Ptr[Ptr[u8]]  # Linked list of free blocks
  backing: SystemAllocator
end

def pool_new(block_size: UInt, block_count: UInt) -> PoolAllocator
  # Ensure block size is at least pointer size
  let actual_block_size = if block_size < 8 then 8 else block_size end
  let total_size = actual_block_size * block_count
  
  let backing = system_allocator()
  let buffer = backing.allocate(total_size, 16)
  if buffer.is_null() then
    panic("pool_new: allocation failed — out of memory")
  end
  
  # Initialize free list
  mut current = buffer
  mut i: UInt = 0
  while i < block_count - 1 do
    let next = current.offset(actual_block_size as Int)
    current.cast[Ptr[u8]]().write(next)
    current = next
    i = i + 1
  end
  # Last block points to null
  current.cast[Ptr[u8]]().write(Ptr::null())
  
  PoolAllocator {
    buffer: buffer,
    block_size: actual_block_size,
    block_count: block_count,
    free_list: buffer.cast[Ptr[u8]](),
    backing: backing
  }
end

impl Allocator for PoolAllocator
  def allocate(self: &mut PoolAllocator, size: UInt, align: UInt) -> Ptr[u8]
    if size > self.block_size then
      return Ptr::null()  # Too large for pool
    end
    
    if self.free_list.is_null() then
      return Ptr::null()  # Pool exhausted
    end
    
    let block = self.free_list.cast[u8]()
    self.free_list = self.free_list.read()
    block
  end
  
  def deallocate(self: &mut PoolAllocator, ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
    if ptr.is_null() then return end
    
    # Add to free list
    ptr.cast[Ptr[u8]]().write(self.free_list.cast[u8]())
    self.free_list = ptr.cast[Ptr[u8]]()
  end
  
  def reallocate(self: &mut PoolAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
    if new_size > self.block_size then
      return Ptr::null()  # Can't grow beyond block size
    end
    ptr  # Same block works
  end
  
  def grow_in_place(self: &mut PoolAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    new_size <= self.block_size
  end
  
  def shrink_in_place(self: &mut PoolAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    true
  end
end

# ———————————————————————————————————————————————————————————————
# Global Allocator
# ———————————————————————————————————————————————————————————————

# Minimal spinlock using extern atomics (cannot use thread.tg due to circular dep)
extern "C" do
  # Returns 1 if exchange succeeded (old value was expected)
  def __sync_bool_compare_and_swap_1(ptr: Ptr[u8], expected: u8, desired: u8) -> Bool
  def __sync_synchronize() -> Unit
end

# Spinlock for global allocator - prevents data races on GLOBAL_ALLOCATOR
mut GLOBAL_ALLOCATOR_LOCK: u8 = 0

def global_allocator_lock() -> Unit
  # Spin until we acquire the lock (compare-and-swap 0 -> 1)
  while !__sync_bool_compare_and_swap_1(&GLOBAL_ALLOCATOR_LOCK, 0, 1) do
    # Spin (could add pause/yield for efficiency)
  end
end

def global_allocator_unlock() -> Unit
  __sync_synchronize()  # Memory barrier before unlock
  GLOBAL_ALLOCATOR_LOCK = 0
end

# The global allocator used by default for heap allocations
mut GLOBAL_ALLOCATOR: SystemAllocator = system_allocator()

def global_alloc(size: UInt, align: UInt) -> Ptr[u8]
  global_allocator_lock()
  let result = GLOBAL_ALLOCATOR.allocate(size, align)
  global_allocator_unlock()
  result
end

def global_dealloc(ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
  global_allocator_lock()
  GLOBAL_ALLOCATOR.deallocate(ptr, size, align)
  global_allocator_unlock()
end

def global_realloc(ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
  global_allocator_lock()
  let result = GLOBAL_ALLOCATOR.reallocate(ptr, old_size, new_size, align)
  global_allocator_unlock()
  result
end

# ———————————————————————————————————————————————————————————————
# Allocation Helpers
# ———————————————————————————————————————————————————————————————

def alloc[T]() -> Ptr[T]
  let layout = layout_for[T]()
  global_alloc(layout.size, layout.align).cast[T]()
end

def alloc_array[T](count: UInt) -> Ptr[T]
  match layout_array[T](count)
  when Result::Ok(layout) then
    global_alloc(layout.size, layout.align).cast[T]()
  when Result::Err(_) then
    Ptr::null()
  end
end

def alloc_zeroed[T]() -> Ptr[T]
  let layout = layout_for[T]()
  let ptr = global_alloc(layout.size, layout.align)
  if !ptr.is_null() then
    ptr_zero(ptr, layout.size)
  end
  ptr.cast[T]()
end

def dealloc[T](ptr: Ptr[T]) -> Unit
  let layout = layout_for[T]()
  global_dealloc(ptr.cast[u8](), layout.size, layout.align)
end

def dealloc_array[T](ptr: Ptr[T], count: UInt) -> Unit
  match layout_array[T](count)
  when Result::Ok(layout) then
    global_dealloc(ptr.cast[u8](), layout.size, layout.align)
  when Result::Err(_) then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Pointer Operations
# ———————————————————————————————————————————————————————————————

extern "C"
  def memcpy(dest: Ptr[u8], src: Ptr[u8], n: UInt) -> Ptr[u8]
  def memset(dest: Ptr[u8], c: Int, n: UInt) -> Ptr[u8]
  def memmove(dest: Ptr[u8], src: Ptr[u8], n: UInt) -> Ptr[u8]
end

def ptr_copy(src: Ptr[u8], dest: Ptr[u8], size: UInt) -> Unit
  if size > 0 then
    memcpy(dest, src, size)
  end
end

def ptr_move(src: Ptr[u8], dest: Ptr[u8], size: UInt) -> Unit
  if size > 0 then
    memmove(dest, src, size)
  end
end

def ptr_zero(ptr: Ptr[u8], size: UInt) -> Unit
  if size > 0 then
    memset(ptr, 0, size)
  end
end

def ptr_fill(ptr: Ptr[u8], value: u8, size: UInt) -> Unit
  if size > 0 then
    memset(ptr, value as Int, size)
  end
end

# ———————————————————————————————————————————————————————————————
# Box / Heap Allocation Wrapper
# ———————————————————————————————————————————————————————————————

struct Box[T]
  ptr: Ptr[T]
end

def box_new[T](value: T) -> Box[T]
  let ptr = alloc[T]()
  if ptr.is_null() then
    panic("Out of memory")
  end
  ptr.write(value)
  Box { ptr: ptr }
end

impl[T] Box[T]
  def get(self: &Box[T]) -> &T
    if self.ptr.is_null() then
      panic("Box: use after drop")
    end
    self.ptr.as_ref()
  end
  
  def get_mut(self: &mut Box[T]) -> &mut T
    if self.ptr.is_null() then
      panic("Box: use after drop")
    end
    self.ptr.as_mut()
  end
  
  def into_inner(self: Box[T]) -> T
    let value = self.ptr.read()
    dealloc(self.ptr)
    value
  end
end

impl[T] Drop for Box[T]
  def drop(self: &mut Box[T]) -> Unit
    if !self.ptr.is_null() then
      # Call drop on the contained value
      drop(&mut self.ptr.read())
      dealloc(self.ptr)
      self.ptr = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Unique Pointer (single ownership)
# ———————————————————————————————————————————————————————————————

struct UniquePtr[T]
  ptr: Ptr[T]
  allocator: &dyn Allocator
end

def unique_ptr_new[T, A: Allocator](value: T, allocator: &A) -> UniquePtr[T]
  let layout = layout_for[T]()
  let ptr = allocator.allocate(layout.size, layout.align).cast[T]()
  if ptr.is_null() then
    panic("Out of memory")
  end
  ptr.write(value)
  UniquePtr { ptr: ptr, allocator: allocator as &dyn Allocator }
end

impl[T] Drop for UniquePtr[T]
  def drop(self: &mut UniquePtr[T]) -> Unit
    if !self.ptr.is_null() then
      drop(&mut self.ptr.read())
      let layout = layout_for[T]()
      self.allocator.deallocate(self.ptr.cast[u8](), layout.size, layout.align)
      self.ptr = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Reference-Counted Pointer (single-threaded)
# ———————————————————————————————————————————————————————————————

struct RcInner[T]
  value: T
  strong_count: UInt
  weak_count: UInt
end

struct Rc[T]
  ptr: Ptr[RcInner[T]]
end

def rc_new[T](value: T) -> Rc[T]
  let inner = alloc[RcInner[T]]()
  if inner.is_null() then
    panic("Rc::new: out of memory")
  end
  inner.write(RcInner {
    value: value,
    strong_count: 1,
    weak_count: 0,
  })
  Rc { ptr: inner }
end

impl[T] Rc[T]
  def get(self: &Rc[T]) -> &T
    &self.ptr.as_ref().value
  end

  def strong_count(self: &Rc[T]) -> UInt
    self.ptr.as_ref().strong_count
  end

  def weak_count(self: &Rc[T]) -> UInt
    self.ptr.as_ref().weak_count
  end

  def clone(self: &Rc[T]) -> Rc[T]
    let inner = self.ptr.as_mut()
    inner.strong_count = inner.strong_count + 1
    Rc { ptr: self.ptr }
  end

  def downgrade(self: &Rc[T]) -> WeakRc[T]
    let inner = self.ptr.as_mut()
    inner.weak_count = inner.weak_count + 1
    WeakRc { ptr: self.ptr }
  end

  def try_unwrap(self: Rc[T]) -> Result[T, Rc[T]]
    let inner = self.ptr.as_ref()
    if inner.strong_count == 1 then
      let value = self.ptr.as_ref().value
      let inner_mut = self.ptr.as_mut()
      inner_mut.strong_count = 0
      if inner_mut.weak_count == 0 then
        dealloc(self.ptr)
      end
      Result::Ok(value)
    else
      Result::Err(self)
    end
  end
end

impl[T] Drop for Rc[T]
  def drop(self: &mut Rc[T]) -> Unit
    if !self.ptr.is_null() then
      let inner = self.ptr.as_mut()
      inner.strong_count = inner.strong_count - 1
      if inner.strong_count == 0 then
        # Drop the contained value
        drop(&mut inner.value)
        if inner.weak_count == 0 then
          dealloc(self.ptr)
        end
      end
      self.ptr = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Weak Reference for Rc (single-threaded)
# ———————————————————————————————————————————————————————————————

struct WeakRc[T]
  ptr: Ptr[RcInner[T]]
end

impl[T] WeakRc[T]
  def upgrade(self: &WeakRc[T]) -> Option[Rc[T]]
    if self.ptr.is_null() then
      return Option::None
    end
    let inner = self.ptr.as_ref()
    if inner.strong_count == 0 then
      Option::None
    else
      let inner_mut = self.ptr.as_mut()
      inner_mut.strong_count = inner_mut.strong_count + 1
      Option::Some(Rc { ptr: self.ptr })
    end
  end

  def strong_count(self: &WeakRc[T]) -> UInt
    if self.ptr.is_null() then
      0
    else
      self.ptr.as_ref().strong_count
    end
  end

  def clone(self: &WeakRc[T]) -> WeakRc[T]
    if !self.ptr.is_null() then
      let inner = self.ptr.as_mut()
      inner.weak_count = inner.weak_count + 1
    end
    WeakRc { ptr: self.ptr }
  end
end

impl[T] Drop for WeakRc[T]
  def drop(self: &mut WeakRc[T]) -> Unit
    if !self.ptr.is_null() then
      let inner = self.ptr.as_mut()
      inner.weak_count = inner.weak_count - 1
      if inner.strong_count == 0 && inner.weak_count == 0 then
        dealloc(self.ptr)
      end
      self.ptr = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Weak Reference for Arc (thread-safe, pairs with Arc in std/async.tg)
# ———————————————————————————————————————————————————————————————
# Note: Arc in std/async.tg needs a weak_count field added to ArcInner
# to fully support WeakArc. For now we add the scaffolding using
# atomic CAS operations so once ArcInner gains weak_count it works.

extern "C" do
  def __sync_fetch_and_add(ptr: Ptr[UInt], val: UInt) -> UInt
  def __sync_fetch_and_sub(ptr: Ptr[UInt], val: UInt) -> UInt
  def __sync_val_compare_and_swap_uint(ptr: Ptr[UInt], expected: UInt, desired: UInt) -> UInt
end

struct ArcInnerWeak[T]
  refcount: UInt
  weak_count: UInt
  data: T
end

struct WeakArc[T]
  ptr: Ptr[ArcInnerWeak[T]]
end

def arc_weak_new[T](value: T) -> (ArcStrong[T], WeakArc[T])
  # Creates a pair: a strong handle and a pre-downgraded weak handle
  let inner = alloc[ArcInnerWeak[T]]()
  if inner.is_null() then
    panic("arc_weak_new: out of memory")
  end
  inner.write(ArcInnerWeak {
    refcount: 1,
    weak_count: 1,
    data: value,
  })
  (ArcStrong { ptr: inner }, WeakArc { ptr: inner })
end

struct ArcStrong[T]
  ptr: Ptr[ArcInnerWeak[T]]
end

impl[T] ArcStrong[T]
  def get(self: &ArcStrong[T]) -> &T
    &self.ptr.as_ref().data
  end

  def strong_count(self: &ArcStrong[T]) -> UInt
    __sync_fetch_and_add(&self.ptr.as_mut().refcount, 0)
  end

  def clone(self: &ArcStrong[T]) -> ArcStrong[T]
    __sync_fetch_and_add(&self.ptr.as_mut().refcount, 1)
    ArcStrong { ptr: self.ptr }
  end

  def downgrade(self: &ArcStrong[T]) -> WeakArc[T]
    __sync_fetch_and_add(&self.ptr.as_mut().weak_count, 1)
    WeakArc { ptr: self.ptr }
  end
end

impl[T] Drop for ArcStrong[T]
  def drop(self: &mut ArcStrong[T]) -> Unit
    if !self.ptr.is_null() then
      let old = __sync_fetch_and_sub(&self.ptr.as_mut().refcount, 1)
      if old == 1 then
        # Last strong ref — drop the value
        drop(&mut self.ptr.as_mut().data)
        __sync_synchronize()
        let weak = __sync_fetch_and_add(&self.ptr.as_mut().weak_count, 0)
        if weak == 0 then
          dealloc(self.ptr)
        end
      end
      self.ptr = Ptr::null()
    end
  end
end

impl[T] WeakArc[T]
  def upgrade(self: &WeakArc[T]) -> Option[ArcStrong[T]]
    if self.ptr.is_null() then
      return Option::None
    end
    # Atomically try to increment strong count if > 0
    loop do
      let current = __sync_fetch_and_add(&self.ptr.as_mut().refcount, 0)
      if current == 0 then
        return Option::None
      end
      let old = __sync_val_compare_and_swap_uint(
        &self.ptr.as_mut().refcount, current, current + 1
      )
      if old == current then
        return Option::Some(ArcStrong { ptr: self.ptr })
      end
    end
  end

  def strong_count(self: &WeakArc[T]) -> UInt
    if self.ptr.is_null() then
      0
    else
      __sync_fetch_and_add(&self.ptr.as_mut().refcount, 0)
    end
  end

  def clone(self: &WeakArc[T]) -> WeakArc[T]
    if !self.ptr.is_null() then
      __sync_fetch_and_add(&self.ptr.as_mut().weak_count, 1)
    end
    WeakArc { ptr: self.ptr }
  end
end

impl[T] Drop for WeakArc[T]
  def drop(self: &mut WeakArc[T]) -> Unit
    if !self.ptr.is_null() then
      let old_weak = __sync_fetch_and_sub(&self.ptr.as_mut().weak_count, 1)
      if old_weak == 1 then
        let strong = __sync_fetch_and_add(&self.ptr.as_mut().refcount, 0)
        if strong == 0 then
          dealloc(self.ptr)
        end
      end
      self.ptr = Ptr::null()
    end
  end
end
