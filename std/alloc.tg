# Tangerine Standard Library — Memory Allocator Interface
#
# Provides pluggable memory allocation with support for:
# - Global allocator (default heap allocator)
# - Custom allocators (arena, bump, pool, etc.)
# - Allocator traits for generic code
#
# This module uses extern "C" to interface with system allocators.

use std::core::{Option, Result, panic}

# ———————————————————————————————————————————————————————————————
# Allocator Trait
# ———————————————————————————————————————————————————————————————

trait Allocator
  # Allocate memory of the given size and alignment.
  # Returns null pointer on failure.
  #
  # ALIGNMENT CONTRACT: the runtime allocator guarantees a 16-byte-
  # aligned payload (the 16-byte block header precedes the payload, and
  # the block base is 16-byte aligned, so payload = base + 16 is
  # 16-aligned). EVERY implementation validates the align argument with
  # the SAME policy: any power-of-two align <= 16 is accepted; align 0,
  # a non-power-of-two, or an align > 16 is an EXPLICIT error (panic) —
  # SystemAllocator, ArenaAllocator and PoolAllocator reject
  # out-of-contract requests identically, because none of them can
  # honor an over-aligned request (the runtime payload is 16-aligned,
  # the arena's backing buffer is 16-aligned, the pool's stride is a
  # multiple of 16).
  def allocate(inout self: Self, size: UInt, align: UInt) -> Ptr[u8]
  
  # Deallocate memory previously allocated by this allocator.
  def deallocate(inout self: Self, ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
  
  # Reallocate memory to a new size, preserving contents.
  # May return a different pointer.
  def reallocate(inout self: Self, ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
  
  # Grow allocation in place if possible.
  def grow_in_place(inout self: Self, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
  
  # Shrink allocation in place.
  def shrink_in_place(inout self: Self, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
end

# ———————————————————————————————————————————————————————————————
# Layout Information
# ———————————————————————————————————————————————————————————————

# One fully-resolved layout for a type. Canonical definition: the compiler's
# layout engine and the allocator share this single record.
struct Layout
  size: Int                # Total byte size
  align: Int               # Required alignment in bytes
  stride: Int              # Distance between consecutive elements
  fields: Vec[FieldLayout] # Field placements (structs/tuples)
  enum_layout: Option[EnumLayout]  # Present for tagged unions only
end

struct FieldLayout
  name: String
  offset: Int        # Byte offset from struct base
  size: Int          # Byte size of field
  align: Int         # Alignment requirement
  type_id: Int       # TypeId.id for the field's type
end

struct VariantLayout
  name: String
  discriminant: Int  # Variant discriminant value
  payload_offset: Int  # Offset of payload within enum
  payload_size: Int    # Size of payload
  fields: Vec[FieldLayout]
end

# Discriminated-union (enum) tagging info.
struct EnumLayout
  tag_offset: Int          # Offset of the discriminant tag from the base
  tag_size: Int            # Byte width of the discriminant tag
  payload_offset: Int      # Offset of the variant payload from the base
  variants: Vec[VariantLayout]
end

def layout_new(size: UInt, align: UInt) -> Result[Layout, String]
  # Alignment must be a power of two
  if align == 0 then
    return Result::Err("Alignment must be a power of two".to_string())
  end
  let align_mask = align - 1
  let align_remainder = align & align_mask
  if align_remainder != 0 then
    return Result::Err("Alignment must be a power of two".to_string())
  end
  
  # Stride is the size rounded up to the alignment boundary; the requested
  # size need not itself be a multiple of the alignment.
  let stride = (size + align - 1) & ~align_mask
  
  Result::Ok(Layout { size: size as Int, align: align as Int, stride: stride as Int, fields: Vec::new(), enum_layout: Option::None })
end

def layout_from_size_align_unchecked(size: UInt, align: UInt) -> Layout
  Layout { size: size as Int, align: align as Int, stride: 0, fields: Vec::new(), enum_layout: Option::None }
end

def layout_for[T]() -> Layout
  # Get size and alignment for type T
  # This is a compiler intrinsic
  Layout {
    size: size_of[T]() as Int,
    align: align_of[T]() as Int,
    stride: 0,
    fields: Vec::new(),
    enum_layout: Option::None
  }
end

def layout_array[T](count: UInt) -> Result[Layout, String]
  let elem_layout = layout_for[T]()
  # Arrays stride by the element's ALIGNED size, not its raw size.
  let elem_stride = (elem_layout.size as UInt + elem_layout.align as UInt - 1) & ~(elem_layout.align as UInt - 1)
  let array_size = elem_stride * count
  
  # Check for overflow
  if count != 0 && array_size / count != elem_stride then
    return Result::Err("Array size overflow".to_string())
  end
  
  layout_new(array_size, elem_layout.align as UInt)
end

# Compiler intrinsics for type info
extern "Tangerine"
  def size_of[T]() -> UInt
  def align_of[T]() -> UInt
end

# ———————————————————————————————————————————————————————————————
# System Allocator (the runtime memory authority)
# ———————————————————————————————————————————————————————————————
# SystemAllocator routes through the compiler's runtime allocator — the
# SAME _tg_mem_alloc/_tg_mem_free authority the String/Vec/Map buffers
# use (codegen emits these as the __intrinsic_mem_alloc/mem_free calls;
# the runtime maintains the per-class free lists behind the per-class
# locks). The former mmap-based syscall6/syscall2 stubs returned 0 and
# never allocated; they are removed — the public allocator interface now
# lands on the real heap.
#
# ALIGNMENT: the runtime guarantees a 16-byte-aligned payload. Every
# block carries a 16-byte header (marker + size) and the block base is
# 16-byte aligned (small blocks come from the 16-aligned bump arena or
# the free lists, large blocks from mmap/VirtualAlloc/HeapAlloc), so
# payload = base + 16 is 16-aligned. allocate() therefore accepts any
# power-of-two align <= 16 and rejects over-aligned requests explicitly
# (the runtime cannot honor them).

# The runtime memory authority (the compiler's MemAlloc/MemFree
# intrinsics — resolved to _tg_mem_alloc/_tg_mem_free on both arches).
extern def __intrinsic_mem_alloc(size: UInt) -> Ptr[u8]
extern def __intrinsic_mem_free(ptr: Ptr[u8], size: UInt) -> Unit

struct SystemAllocator
  # Stateless: delegates to the runtime allocator
end

def system_allocator() -> SystemAllocator
  SystemAllocator {}
end

impl Allocator for SystemAllocator
  def allocate(inout self: SystemAllocator, size: UInt, align: UInt) -> Ptr[u8]
    # Alignment contract (honest): the runtime guarantees a 16-byte-
    # aligned payload, so align must be a power of two <= 16. A
    # non-power-of-two or over-aligned request is an explicit error —
    # the runtime allocator cannot honor it and returning a
    # misaligned buffer would silently break the caller.
    if align == 0 || (align & (align - 1)) != 0 then
      panic("SystemAllocator::allocate: align must be a power of two")
    end
    if align > 16 then
      panic("SystemAllocator::allocate: align " + align.to_string() + " > 16 not supported — the runtime guarantees 16-byte alignment")
    end
    if size == 0 then
      return Ptr::null()
    end
    __intrinsic_mem_alloc(size)
  end
  
  def deallocate(inout self: SystemAllocator, ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
    if !ptr.is_null() then
      __intrinsic_mem_free(ptr, size)
    end
  end
  
  def reallocate(inout self: SystemAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
    if ptr.is_null() then
      return self.allocate(new_size, align)
    end
    
    if new_size == 0 then
      self.deallocate(ptr, old_size, align)
      return Ptr::null()
    end
    
    let new_ptr = self.allocate(new_size, align)
    if !new_ptr.is_null() then
      let copy_size = if old_size < new_size then old_size else new_size end
      ptr_copy(ptr, new_ptr, copy_size)
      self.deallocate(ptr, old_size, align)
    end
    new_ptr
  end
  
  def grow_in_place(inout self: SystemAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    false
  end
  
  def shrink_in_place(inout self: SystemAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    true
  end
end

# ———————————————————————————————————————————————————————————————
# Arena Allocator (Bump Allocator)
# ———————————————————————————————————————————————————————————————

struct ArenaAllocator
  buffer: Ptr[u8]
  capacity: UInt
  offset: UInt
  backing: SystemAllocator
end

def arena_new(capacity: UInt) -> ArenaAllocator
  let backing = system_allocator()
  let buffer = backing.allocate(capacity, 16)
  if buffer.is_null() then
    panic("arena_new: allocation failed — out of memory")
  end
  ArenaAllocator {
    buffer: buffer,
    capacity: capacity,
    offset: 0,
    backing: backing
  }
end

def arena_reset(inout arena: ArenaAllocator) -> Unit
  if arena.buffer.is_null() || arena.capacity == 0 then
    arena.offset = 0
    return
  end
  arena.offset = 0
end

def arena_destroy(inout arena: ArenaAllocator) -> Unit
  arena.backing.deallocate(arena.buffer, arena.capacity, 16)
  arena.buffer = Ptr::null()
  arena.capacity = 0
  arena.offset = 0
end

impl Drop for ArenaAllocator
  def drop(inout self: ArenaAllocator) -> Unit
    # Release the backing buffer so a bit-copied arena cannot double-own
    # (and double-free) the mmap region. Idempotent with arena_destroy.
    if !self.buffer.is_null() && self.capacity != 0 then
      self.backing.deallocate(self.buffer, self.capacity, 16)
    end
    self.buffer = Ptr::null()
    self.capacity = 0
    self.offset = 0
  end
end

impl Allocator for ArenaAllocator
  def allocate(inout self: ArenaAllocator, size: UInt, align: UInt) -> Ptr[u8]
    # ALIGNMENT CONTRACT (the SAME policy as SystemAllocator): the
    # backing buffer comes from SystemAllocator and is 16-byte-aligned
    # (payload = base + 16), so any power-of-two align <= 16 is
    # satisfied by the aligned-offset math below. An align 0, a
    # non-power-of-two, or an align > 16 is an EXPLICIT error — the
    # arena cannot honor a request above its backing alignment, and a
    # misaligned buffer would silently break the caller.
    if align == 0 || (align & (align - 1)) != 0 then
      panic("ArenaAllocator::allocate: align must be a power of two")
    end
    if align > 16 then
      panic("ArenaAllocator::allocate: align " + align.to_string() + " > 16 not supported — the backing buffer is 16-byte-aligned")
    end
    if size == 0 then
      return Ptr::null()
    end

    if self.buffer.is_null() || self.capacity == 0 then
      return Ptr::null()
    end

    # Align the current offset
    let align_mask = align - 1
    let aligned_offset = (self.offset + align_mask) & ~align_mask

    if aligned_offset < self.offset then
      return Ptr::null()
    end

    let end_offset = aligned_offset + size
    if end_offset < aligned_offset then
      return Ptr::null()
    end
    
    if end_offset > self.capacity then
      return Ptr::null()  # Out of memory
    end
    
    let ptr = self.buffer.offset(aligned_offset as Int)
    self.offset = end_offset
    ptr
  end
  
  def deallocate(inout self: ArenaAllocator, ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
    # Arena allocator doesn't free individual allocations
    # Memory is freed when arena is reset or destroyed
  end
  
  def reallocate(inout self: ArenaAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
    # Simple: allocate new, copy, don't free old
    let new_ptr = self.allocate(new_size, align)
    if !new_ptr.is_null() && !ptr.is_null() then
      let copy_size = if old_size < new_size then old_size else new_size end
      ptr_copy(ptr, new_ptr, copy_size)
    end
    new_ptr
  end
  
  def grow_in_place(inout self: ArenaAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    false
  end
  
  def shrink_in_place(inout self: ArenaAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    true
  end
end

# ———————————————————————————————————————————————————————————————
# ArenaBuf — resource-style arena wrapper (bump allocator with deinit)
# ———————————————————————————————————————————————————————————————

resource ArenaBuf
  buffer: Ptr[u8]
  capacity: UInt
  offset: UInt
  backing: SystemAllocator
end

impl ArenaBuf
  def new(capacity: UInt) -> ArenaBuf
    let backing = system_allocator()
    let buffer = backing.allocate(capacity, 16)
    if buffer.is_null() then
      panic("ArenaBuf::new: allocation failed — out of memory")
    end
    ArenaBuf {
      buffer: buffer,
      capacity: capacity,
      offset: 0,
      backing: backing
    }
  end

  def alloc(inout self: Self, size: UInt, align: UInt) -> Ptr[u8]
    # ALIGNMENT CONTRACT (the SAME policy as ArenaAllocator::allocate):
    # the backing buffer is 16-aligned (SystemAllocator guarantee), so
    # power-of-two aligns <= 16 are satisfied by the aligned-offset
    # math; an align 0, a non-power-of-two, or an align > 16 is an
    # EXPLICIT error — over-alignment is never honored by luck.
    if align == 0 || (align & (align - 1)) != 0 then
      panic("ArenaBuf::alloc: align must be a power of two")
    end
    if align > 16 then
      panic("ArenaBuf::alloc: align " + align.to_string() + " > 16 not supported — the backing buffer is 16-byte-aligned")
    end
    if size == 0 then
      return Ptr::null()
    end

    if self.buffer.is_null() || self.capacity == 0 then
      return Ptr::null()
    end

    let align_mask = align - 1
    let aligned_offset = (self.offset + align_mask) & ~align_mask

    if aligned_offset < self.offset then
      return Ptr::null()
    end

    let end_offset = aligned_offset + size
    if end_offset < aligned_offset then
      return Ptr::null()
    end

    if end_offset > self.capacity then
      return Ptr::null()
    end

    let ptr = self.buffer.offset(aligned_offset as Int)
    self.offset = end_offset
    ptr
  end

  def reset(inout self: Self) -> Unit
    self.offset = 0
  end

  def deinit(sink self: Self) -> Unit
    let buffer = self.buffer
    let capacity = self.capacity
    let backing = self.backing
    if !buffer.is_null() then
      backing.deallocate(buffer, capacity, 16)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Pool Allocator (Fixed-Size Blocks)
# ———————————————————————————————————————————————————————————————
# The pool's FIXED ALIGNMENT is 16: the backing buffer comes from
# SystemAllocator (a 16-aligned payload) and the buffer is divided into
# fixed strides of round_up(max(block_size, pointer_size), 16) bytes —
# the stride is the block size rounded UP to the pool's alignment, so
# EVERY block sits on a 16-byte boundary (the old stride was
# max(block_size, 8), so an 8-byte pool divided the buffer into 8-byte
# strides and block 1 was only 8-aligned). The free-list link (one
# pointer, 8 bytes) always fits inside a block because the stride is at
# least the pointer size.

struct PoolAllocator
  buffer: Ptr[u8]
  block_size: UInt      # the minimum block payload (at least pointer size)
  stride: UInt          # round_up(max(block_size, 8), 16) — the block pitch
  block_count: UInt
  free_list: Ptr[Ptr[u8]]  # Linked list of free blocks
  backing: SystemAllocator
  alignment: UInt       # the pool's fixed alignment — 16 (the backing buffer's)
end

def pool_new(block_size: UInt, block_count: UInt) -> PoolAllocator
  # The pool's fixed alignment is 16 — the backing buffer's alignment.
  # The stride is the block size rounded up to that alignment, so every
  # returned block is 16-aligned.
  let pool_alignment: UInt = 16
  # Ensure block size is at least pointer size
  let min_block = if block_size < 8 then 8 else block_size end
  let stride = (min_block + (pool_alignment - 1)) & ~(pool_alignment - 1)
  if block_count == 0 then
    return PoolAllocator {
      buffer: Ptr::null(),
      block_size: min_block,
      stride: stride,
      block_count: 0,
      free_list: Ptr::null(),
      backing: system_allocator(),
      alignment: pool_alignment
    }
  end
  let total_size = stride * block_count
  
  let backing = system_allocator()
  let buffer = backing.allocate(total_size, 16)
  if buffer.is_null() then
    panic("pool_new: allocation failed — out of memory")
  end
  
  # Initialize free list
  mut current = buffer
  mut i: UInt = 0
  while i < block_count - 1 do
    let next = current.offset(stride as Int)
    current.cast[Ptr[u8]]().write(next)
    current = next
    i = i + 1
  end
  # Last block points to null
  current.cast[Ptr[u8]]().write(Ptr::null())
  
  PoolAllocator {
    buffer: buffer,
    block_size: min_block,
    stride: stride,
    block_count: block_count,
    free_list: buffer.cast[Ptr[u8]](),
    backing: backing,
    alignment: pool_alignment
  }
end

impl Drop for PoolAllocator
  def drop(inout self: PoolAllocator) -> Unit
    # Release the backing buffer so a bit-copied pool cannot double-own
    # (and double-free) the mmap region.
    if !self.buffer.is_null() && self.block_count != 0 then
      self.backing.deallocate(self.buffer, self.stride * self.block_count, 16)
    end
    self.buffer = Ptr::null()
    self.free_list = Ptr::null()
    self.block_count = 0
  end
end

impl Allocator for PoolAllocator
  def allocate(inout self: PoolAllocator, size: UInt, align: UInt) -> Ptr[u8]
    # ALIGNMENT CONTRACT (the SAME policy as SystemAllocator): the
    # pool's fixed alignment is 16 — every returned block is
    # 16-aligned, so any power-of-two align <= 16 is satisfied. An
    # align 0, a non-power-of-two, or an align above the pool's
    # configured alignment is an EXPLICIT error — the pool cannot
    # honor an over-aligned request.
    if align == 0 || (align & (align - 1)) != 0 then
      panic("PoolAllocator::allocate: align must be a power of two")
    end
    if align > self.alignment then
      panic("PoolAllocator::allocate: align " + align.to_string() + " > " + self.alignment.to_string() + " not supported — the pool's fixed alignment is " + self.alignment.to_string())
    end
    if size > self.block_size then
      return Ptr::null()  # Too large for pool
    end
    
    if self.free_list.is_null() then
      return Ptr::null()  # Pool exhausted
    end
    
    let block = self.free_list.cast[u8]()
    self.free_list = self.free_list.read()
    block
  end
  
  def deallocate(inout self: PoolAllocator, ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
    if ptr.is_null() then return end
    
    # Add to free list
    ptr.cast[Ptr[u8]]().write(self.free_list.cast[u8]())
    self.free_list = ptr.cast[Ptr[u8]]()
  end
  
  def reallocate(inout self: PoolAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
    if new_size > self.block_size then
      return Ptr::null()  # Can't grow beyond block size
    end
    ptr  # Same block works
  end
  
  def grow_in_place(inout self: PoolAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    new_size <= self.block_size
  end
  
  def shrink_in_place(inout self: PoolAllocator, ptr: Ptr[u8], old_size: UInt, new_size: UInt) -> Bool
    true
  end
end

# ———————————————————————————————————————————————————————————————
# Global Allocator
# ———————————————————————————————————————————————————————————————

# Minimal spinlock using extern atomics (cannot use thread.tg due to circular dep)
extern "C" do
  # Returns 1 if exchange succeeded (old value was expected)
  def __sync_bool_compare_and_swap_1(ptr: Ptr[u8], expected: u8, desired: u8) -> Bool
  def __sync_synchronize() -> Unit
  def sched_yield() -> i32
end

# Spinlock for global allocator - prevents data races on GLOBAL_ALLOCATOR
mut GLOBAL_ALLOCATOR_LOCK: u8 = 0

def global_allocator_lock() -> Unit
  # Spin until we acquire the lock (compare-and-swap 0 -> 1)
  mut spins: UInt = 0
  while !__sync_bool_compare_and_swap_1(&GLOBAL_ALLOCATOR_LOCK, 0, 1) do
    spins = spins + 1
    if (spins % 64) == 0 then
      let _ = sched_yield()
    else
      # Lightweight memory barrier to avoid a hot empty loop.
      __sync_synchronize()
    end
  end
end

def global_allocator_unlock() -> Unit
  __sync_synchronize()  # Memory barrier before unlock
  GLOBAL_ALLOCATOR_LOCK = 0
end

def global_alloc(size: UInt, align: UInt) -> Ptr[u8]
  global_allocator_lock()
  let mut allocator = system_allocator()
  let result = allocator.allocate(size, align)
  global_allocator_unlock()
  result
end

def global_dealloc(ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
  global_allocator_lock()
  let mut allocator = system_allocator()
  allocator.deallocate(ptr, size, align)
  global_allocator_unlock()
end

def global_realloc(ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
  global_allocator_lock()
  let mut allocator = system_allocator()
  let result = allocator.reallocate(ptr, old_size, new_size, align)
  global_allocator_unlock()
  result
end

# ———————————————————————————————————————————————————————————————
# Allocation Helpers
# ———————————————————————————————————————————————————————————————

def alloc[T]() -> Ptr[T]
  let layout = layout_for[T]()
  global_alloc(layout.size as UInt, layout.align as UInt).cast[T]()
end

def alloc_array[T](count: UInt) -> Ptr[T]
  match layout_array[T](count)
  when Result::Ok(layout) then
    global_alloc(layout.size as UInt, layout.align as UInt).cast[T]()
  when Result::Err(_) then
    Ptr::null()
  end
end

def alloc_zeroed[T]() -> Ptr[T]
  let layout = layout_for[T]()
  let ptr = global_alloc(layout.size as UInt, layout.align as UInt)
  if !ptr.is_null() then
    ptr_zero(ptr, layout.size as UInt)
  end
  ptr.cast[T]()
end

def dealloc[T](ptr: Ptr[T]) -> Unit
  let layout = layout_for[T]()
  global_dealloc(ptr.cast[u8](), layout.size as UInt, layout.align as UInt)
end

def dealloc_array[T](ptr: Ptr[T], count: UInt) -> Unit
  match layout_array[T](count)
  when Result::Ok(layout) then
    global_dealloc(ptr.cast[u8](), layout.size as UInt, layout.align as UInt)
  when Result::Err(_) then ()
  end
end

# ———————————————————————————————————————————————————————————————
# Pointer Operations
# ———————————————————————————————————————————————————————————————

extern "C"
  def memcpy(dest: Ptr[u8], src: Ptr[u8], n: UInt) -> Ptr[u8]
  def memset(dest: Ptr[u8], c: Int, n: UInt) -> Ptr[u8]
  def memmove(dest: Ptr[u8], src: Ptr[u8], n: UInt) -> Ptr[u8]
end

def ptr_copy(src: Ptr[u8], dest: Ptr[u8], size: UInt) -> Unit
  if size > 0 then
    let _copied = memcpy(dest, src, size)
  end
  ()
end

def ptr_move(src: Ptr[u8], dest: Ptr[u8], size: UInt) -> Unit
  if size > 0 then
    let _moved = memmove(dest, src, size)
  end
  ()
end

def ptr_zero(ptr: Ptr[u8], size: UInt) -> Unit
  if size > 0 then
    let _zeroed = memset(ptr, 0, size)
  end
  ()
end

def ptr_fill(ptr: Ptr[u8], value: u8, size: UInt) -> Unit
  if size > 0 then
    let _filled = memset(ptr, value as Int, size)
  end
  ()
end

# ———————————————————————————————————————————————————————————————
# Box / Heap Allocation Wrapper
# ———————————————————————————————————————————————————————————————

struct Box[T]
  ptr: Ptr[T]
end

def box_new[T](sink value: T) -> Box[T]
  let ptr = alloc[T]()
  if ptr.is_null() then
    panic("Out of memory")
  end
  ptr.write(value)
  Box { ptr: ptr }
end

impl[T] Box[T]
 # RAW-PTR access surface: no stdlib API returns a safe
  # reference. get/get_mut hand out the raw NON-OWNING pointer (a first-class
  # handle with no lifetime); the caller accesses the pointee through the
  # compiler's raw-deref PLACE operation: `*b.get()` reads the value,
  # `(*b.get()).id` reads a field, `*b.get_mut() = v` writes. Do not store
  # the pointer beyond the box's lifetime.
  def get(self: Box[T]) -> Ptr[T]
    if self.ptr.is_null() then
      panic("Box: use after drop")
    end
    self.ptr
  end

  def get_mut(inout self: Box[T]) -> Ptr[T]
    if self.ptr.is_null() then
      panic("Box: use after drop")
    end
    self.ptr
  end
  
  def into_inner(sink self: Box[T]) -> T
    # sink self is consumed by the match so the registered Box Drop never
    # runs against the already-read, already-deallocated pointee.
    match self
    when Box { ptr: ptr } then
      let value = ptr.read()
      dealloc(ptr)
      value
    end
  end
end

impl[T] Drop for Box[T]
  def drop(inout self: Box[T]) -> Unit
    if !self.ptr.is_null() then
      # Call drop on the contained value
      self.ptr.drop_in_place()
      dealloc(self.ptr)
      self.ptr = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Unique Pointer (single ownership)
# ———————————————————————————————————————————————————————————————

struct UniquePtr[T]
  ptr: Ptr[T]
  # UniquePtr allocates through the GLOBAL allocator only. It previously
  # stored `allocator: &dyn Allocator` — a hidden borrowed reference inside
  # an owning pointer that could dangle. unique_ptr_new no longer accepts an
 # allocator argument.
end

def unique_ptr_new[T](sink value: T) -> UniquePtr[T]
 # The allocator parameter is removed: UniquePtr
  # allocates and deallocates through the global allocator, which has no
  # lifetime to dangle.
  let layout = layout_for[T]()
  let ptr = global_alloc(layout.size as UInt, layout.align as UInt).cast[T]()
  if ptr.is_null() then
    panic("Out of memory")
  end
  ptr.write(value)
  UniquePtr { ptr: ptr }
end

impl[T] UniquePtr[T]
 # RAW-PTR access surface: same surface as Box — the
  # raw non-owning pointer, read/written through the raw-deref place op.
  def get(self: UniquePtr[T]) -> Ptr[T]
    self.ptr
  end
end

impl[T] Drop for UniquePtr[T]
  def drop(inout self: UniquePtr[T]) -> Unit
    if !self.ptr.is_null() then
      self.ptr.drop_in_place()
      let layout = layout_for[T]()
      global_dealloc(self.ptr.cast[u8](), layout.size as UInt, layout.align as UInt)
      self.ptr = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Reference-Counted Pointer (single-threaded)
# ———————————————————————————————————————————————————————————————

struct RcInner[T]
  value: T
  strong_count: UInt
  weak_count: UInt
end

struct Rc[T]
  ptr: Ptr[RcInner[T]]
end

def rc_new[T](sink value: T) -> Rc[T]
  let inner = alloc[RcInner[T]]()
  if inner.is_null() then
    panic("Rc::new: out of memory")
  end
  inner.write(RcInner[T] {
    value: value,
    strong_count: 1,
    weak_count: 0,
  })
  Rc[T] { ptr: inner }
end

impl[T] Rc[T]
 # RAW-PTR access surface: no safe reference escapes the
  # stdlib. get returns the raw NON-OWNING pointer to the payload — `value`
  # is the first RcInner field, so the inner-block pointer casts directly to
  # Ptr[T]; the caller reads through the raw-deref place op: `*rc.get()`.
  def get(self: Rc[T]) -> Ptr[T]
    self.ptr as Ptr[T]
  end

  def strong_count(self: Rc[T]) -> UInt
    self.ptr.as_ref().strong_count
  end

  def weak_count(self: Rc[T]) -> UInt
    self.ptr.as_ref().weak_count
  end

  def clone(self: Rc[T]) -> Rc[T]
    __sync_fetch_and_add(&self.ptr.as_ref().strong_count, 1)
    Rc[T] { ptr: self.ptr }
  end

  def downgrade(self: Rc[T]) -> WeakRc[T]
    __sync_fetch_and_add(&self.ptr.as_ref().weak_count, 1)
    WeakRc[T] { ptr: self.ptr }
  end

  def try_unwrap(sink self: Rc[T]) -> Result[T, Rc[T]]
    let inner = self.ptr.as_ref()
    if inner.strong_count == 1 then
 # RAW payload move: `(*self.ptr).value` is a raw
      # deref PLACE read — the payload bytes are loaded out of the control
      # block directly, NOT an ordinary read of a resource field through a
      # reference (which would duplicate ownership while the Rc stays live).
      # For trivially-copyable T this is the byte-copy move; for non-trivial
      # T the same bytes transfer ownership (the block's copy is stale and
      # never destructed). The block is marked destroyed below and released
      # when no weaks remain.
      let value = (*self.ptr).value
      let inner_mut = self.ptr.as_mut()
      inner_mut.strong_count = 0
      if inner_mut.weak_count == 0 then
        dealloc(self.ptr)
      end
      # Consume self on the success path too, so the registered Rc Drop
      # never runs against the already-read, already-deallocated inner block.
      match self
      when Rc { ptr: _ } then Result::Ok(value)
      end
    else
      Result::Err(self)
    end
  end
end

impl[T] Drop for Rc[T]
  def drop(inout self: Rc[T]) -> Unit
    if !self.ptr.is_null() then
      let inner = self.ptr.as_mut()
      let prev = __sync_fetch_and_sub(&inner.strong_count, 1)
      if prev == 1 then
 # RAW drop place: destroy the pointee through the
        # Ptr's drop_in_place (the compiler's typed destruction glue), not
        # the `drop(&mut inner.value)` reference trick.
        self.ptr.drop_in_place()
        if inner.weak_count == 0 then
          dealloc(self.ptr)
        end
      end
      self.ptr = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Weak Reference for Rc (single-threaded)
# ———————————————————————————————————————————————————————————————

struct WeakRc[T]
  ptr: Ptr[RcInner[T]]
end

impl[T] WeakRc[T]
  def upgrade(self: WeakRc[T]) -> Option[Rc[T]]
    if self.ptr.is_null() then
      return Option::None
    end
    let inner = self.ptr.as_ref()
    if inner.strong_count == 0 then
      Option::None
    else
      __sync_fetch_and_add(&self.ptr.as_ref().strong_count, 1)
      Option::Some(Rc[T] { ptr: self.ptr })
    end
  end

  def strong_count(self: WeakRc[T]) -> UInt
    if self.ptr.is_null() then
      0
    else
      self.ptr.as_ref().strong_count
    end
  end

  def clone(self: WeakRc[T]) -> WeakRc[T]
    if !self.ptr.is_null() then
      __sync_fetch_and_add(&self.ptr.as_ref().weak_count, 1)
    end
    WeakRc[T] { ptr: self.ptr }
  end
end

impl[T] Drop for WeakRc[T]
  def drop(inout self: WeakRc[T]) -> Unit
    if !self.ptr.is_null() then
      let inner = self.ptr.as_mut()
      let prev = __sync_fetch_and_sub(&inner.weak_count, 1)
      if inner.strong_count == 0 && prev == 1 then
        dealloc(self.ptr)
      end
      self.ptr = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Weak Reference for Arc (thread-safe, pairs with Arc in std/async.tg)
# ———————————————————————————————————————————————————————————————
# Note: Arc in std/async.tg needs a weak_count field added to ArcInner
# to fully support WeakArc. For now we add the scaffolding using
# atomic CAS operations so once ArcInner gains weak_count it works.

extern "C" do
  def __sync_fetch_and_add(ptr: Ptr[UInt], val: UInt) -> UInt
  def __sync_fetch_and_sub(ptr: Ptr[UInt], val: UInt) -> UInt
  def __sync_val_compare_and_swap_uint(ptr: Ptr[UInt], expected: UInt, desired: UInt) -> UInt
end

struct ArcInnerWeak[T]
  refcount: UInt
  weak_count: UInt
  data: T
end

struct WeakArc[T]
  ptr: Ptr[ArcInnerWeak[T]]
end

def arc_weak_new[T](value: T) -> (ArcStrong[T], WeakArc[T])
  # Creates a pair: a strong handle and a pre-downgraded weak handle
  let inner = alloc[ArcInnerWeak[T]]()
  if inner.is_null() then
    panic("arc_weak_new: out of memory")
  end
  inner.write(ArcInnerWeak[T] {
    refcount: 1,
    weak_count: 1,
    data: value,
  })
  let pair = (ArcStrong[T] { ptr: inner }, WeakArc[T] { ptr: inner })
  pair
end

struct ArcStrong[T]
  ptr: Ptr[ArcInnerWeak[T]]
end

impl[T] ArcStrong[T]
 # The old `get() -> &T` is REMOVED: no stdlib API may
  # return a safe reference, and ArcStrong's payload (`data`) is not the
  # first ArcInnerWeak field, so a raw-pointer get would need fragile offset
  # arithmetic. There are no in-tree callers; raw access is available
  # through the Ptr builtin surface (`self.ptr` + drop_in_place) and
  # std::ffi::read_ptr for values.
  def strong_count(self: ArcStrong[T]) -> UInt
    __sync_fetch_and_add(&self.ptr.as_mut().refcount, 0)
  end

  def clone(self: ArcStrong[T]) -> ArcStrong[T]
    __sync_fetch_and_add(&self.ptr.as_mut().refcount, 1)
    ArcStrong[T] { ptr: self.ptr }
  end

  def downgrade(self: ArcStrong[T]) -> WeakArc[T]
    __sync_fetch_and_add(&self.ptr.as_mut().weak_count, 1)
    WeakArc[T] { ptr: self.ptr }
  end
end

impl[T] Drop for ArcStrong[T]
  def drop(inout self: ArcStrong[T]) -> Unit
    if !self.ptr.is_null() then
      let old = __sync_fetch_and_sub(&self.ptr.as_mut().refcount, 1)
      if old == 1 then
        # Last strong ref — drop the value through the raw drop place
 # (: same drop_in_place path as Rc).
        self.ptr.drop_in_place()
        __sync_synchronize()
        let weak = __sync_fetch_and_add(&self.ptr.as_mut().weak_count, 0)
        if weak == 0 then
          dealloc(self.ptr)
        end
      end
      self.ptr = Ptr::null()
    end
  end
end

impl[T] WeakArc[T]
  def upgrade(self: WeakArc[T]) -> Option[ArcStrong[T]]
    if self.ptr.is_null() then
      return Option::None
    end
    # Atomically try to increment strong count if > 0
    loop do
      let current = __sync_fetch_and_add(&self.ptr.as_mut().refcount, 0)
      if current == 0 then
        return Option::None
      end
      let old = __sync_val_compare_and_swap_uint(
        &self.ptr.as_mut().refcount, current, current + 1
      )
      if old == current then
        return Option::Some(ArcStrong[T] { ptr: self.ptr })
      end
    end
  end

  def strong_count(self: WeakArc[T]) -> UInt
    if self.ptr.is_null() then
      0
    else
      __sync_fetch_and_add(&self.ptr.as_mut().refcount, 0)
    end
  end

  def clone(self: WeakArc[T]) -> WeakArc[T]
    if !self.ptr.is_null() then
      __sync_fetch_and_add(&self.ptr.as_mut().weak_count, 1)
    end
    WeakArc[T] { ptr: self.ptr }
  end
end

# ———————————————————————————————————————————————————————————————
# Standalone allocation functions (used by std::ffi runtime exports)
# ———————————————————————————————————————————————————————————————

# Global SystemAllocator instance used by the standalone functions
mut __tg_system_alloc: SystemAllocator = SystemAllocator {}

pub def system_alloc(size: UInt, align: UInt) -> Ptr[u8]
  __tg_system_alloc.allocate(size, align)
end

# Reallocating an mmap'd region requires the ORIGINAL size: the copy size is
# min(old_size, new_size) and munmap must release the exact old mapping
# (a length-0 or mismatched munmap fails and leaks). The ABI matches
# interop.txt §11.1: tg_realloc(ptr, old_size, new_size, align).
pub def system_realloc(ptr: Ptr[u8], old_size: UInt, new_size: UInt, align: UInt) -> Ptr[u8]
  __tg_system_alloc.reallocate(ptr, old_size, new_size, align)
end

pub def system_free(ptr: Ptr[u8], size: UInt, align: UInt) -> Unit
  __tg_system_alloc.deallocate(ptr, size, align)
end

impl[T] Drop for WeakArc[T]
  def drop(inout self: WeakArc[T]) -> Unit
    if !self.ptr.is_null() then
      let old_weak = __sync_fetch_and_sub(&self.ptr.as_mut().weak_count, 1)
      if old_weak == 1 then
        let strong = __sync_fetch_and_add(&self.ptr.as_mut().refcount, 0)
        if strong == 0 then
          dealloc(self.ptr)
        end
      end
      self.ptr = Ptr::null()
    end
  end
end
