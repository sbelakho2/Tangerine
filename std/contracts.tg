# Tangerine Standard Library — std::contracts
# Design-by-contract verification, proof obligations, and static analysis
# §2: guard keyword — syntactic sugar for precondition early-return

use std::core::{Option, Result, panic}

# [METADATA]
# module: tg::contracts
# status: alpha
# effects: []
# capabilities: []
# error_codes: [ContractViolation, Internal]

# ———————————————————————————————————————————————————————————————
# §27.6 Error codes and correlation IDs (Integrated)
# ———————————————————————————————————————————————————————————————

use std::gfx_errors::{Error, ErrorCode}

enum ContractError
  PreconditionViolation(Error)
  PostconditionViolation(Error)
  InvariantViolation(Error)
  GuardViolation(Error)
  Internal(Error)
end

impl ContractError
  def new(message: String) -> ContractError
    ContractError::Internal(Error::internal(message))
  end

  def message(self: &ContractError) -> &String
    match self
    when ContractError::PreconditionViolation(e) then &e.message
    when ContractError::PostconditionViolation(e) then &e.message
    when ContractError::InvariantViolation(e) then &e.message
    when ContractError::GuardViolation(e) then &e.message
    when ContractError::Internal(e) then &e.message
    end
  end

  def code(self: &ContractError) -> ErrorCode
    match self
    when ContractError::PreconditionViolation(_) then ErrorCode::InvalidArg
    when ContractError::PostconditionViolation(_) then ErrorCode::Internal
    when ContractError::InvariantViolation(_) then ErrorCode::Internal
    when ContractError::GuardViolation(_) then ErrorCode::InvalidArg
    when ContractError::Internal(_) then ErrorCode::Internal
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Core Types
# ———————————————————————————————————————————————————————————————

enum ContractKind
  Pre
  Post
  Invariant
end

struct Contract
  kind: ContractKind
  expr: String
  has_message: Bool
  message: String
end

struct ProofObligation
  origin: String
  kind: ContractKind
  expr: String
  verified: Bool
end

struct VerificationResult
  total: Int
  verified: Int
  failed: Int
end

# ———————————————————————————————————————————————————————————————
# Contract Builders
# ———————————————————————————————————————————————————————————————

def make_pre(expr: String) -> Contract
  make_contract(ContractKind::Pre, expr, false, "")
end

def make_post(expr: String) -> Contract
  make_contract(ContractKind::Post, expr, false, "")
end

def make_invariant(expr: String) -> Contract
  make_contract(ContractKind::Invariant, expr, false, "")
end

def make_contract(kind: ContractKind, expr: String, has_msg: Bool, msg: String) -> Contract
  Contract {
    kind: kind,
    expr: expr,
    has_message: has_msg,
    message: msg
  }
end

def with_message(kind: ContractKind, expr: String, msg: String) -> Contract
  make_contract(kind, expr, true, msg)
end

# ———————————————————————————————————————————————————————————————
# Runtime Checking
# ———————————————————————————————————————————————————————————————

def check_pre(cond: Bool, msg: String) -> Unit
  if !cond
    _log_contract_violation(ContractKind::Pre, &msg)
    panic(msg)
  end
end

def check_post(cond: Bool, msg: String) -> Unit
  if !cond
    _log_contract_violation(ContractKind::Post, &msg)
    panic(msg)
  end
end

def check_invariant(cond: Bool, msg: String) -> Unit
  if !cond
    _log_contract_violation(ContractKind::Invariant, &msg)
    panic(msg)
  end
end

def check_guard(cond: Bool, msg: String) -> Unit
  if !cond
    _log_contract_violation(ContractKind::Pre, &("Guard failed: " + msg))
    panic("Guard failed: " + msg)
  end
end

# ———————————————————————————————————————————————————————————————
# Verification API
# ———————————————————————————————————————————————————————————————

def make_obligation(fn_name: String, kind: ContractKind, expr: String) -> ProofObligation
  ProofObligation {
    origin: fn_name,
    kind: kind,
    expr: expr,
    verified: false
  }
end

def mark_verified(ob: ProofObligation) -> ProofObligation
  ProofObligation {
    origin: ob.origin,
    kind: ob.kind,
    expr: ob.expr,
    verified: true
  }
end

def make_result(total: Int, verified: Int, failed: Int) -> VerificationResult
  VerificationResult {
    total: total,
    verified: verified,
    failed: failed
  }
end

def all_verified(r: VerificationResult) -> Bool
  r.failed == 0
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

use std::time::{instant_now, duration_nanos}
use std::ctx

def _log_contract_violation(kind: ContractKind, msg: &String) -> Unit
  let level = LogLevel::Error
  let category = LogCategory::App # Or a new Contract category if it exists
  
  match &GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: category,
      message: "[CONTRACT VIOLATION] " + kind_name(kind) + ": " + *msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then
    # Fallback to stderr if possible, but in Tangerine we mostly rely on logger
  end

  # Integrate with ctxpacks: generate a pack for the violation context
  let seeds = Vec::new()
  seeds.push("contracts::violation".to_string())
  match std::ctx::build_pack(seeds, 1000)
  when Ok(pack) then
    std::ctx::register_pack(pack)
  when Err(_) then {}
  end
end

# ———————————————————————————————————————————————————————————————
# Pretty Printing
# ———————————————————————————————————————————————————————————————

def kind_name(k: ContractKind) -> String
  match k
  when ContractKind::Pre then
    "pre"
  when ContractKind::Post then
    "post"
  when ContractKind::Invariant then
    "invariant"
  end
end

def format_obligation(ob: ProofObligation) -> String
  let prefix = if ob.verified then "[ok] " else "[??] " end
  prefix + ob.origin + ": " + kind_name(ob.kind) + " " + ob.expr
end

# ———————————————————————————————————————————————————————————————
# §2 — Guard Keyword (precondition early-return sugar)
# ———————————————————————————————————————————————————————————————

## `guard condition else {... }` desugars to:
##   if !condition {... /* must diverge: return/panic */ }
##
## Guards are compile-time checked:
##   - The else branch MUST diverge (return, panic, break, continue)
##   - The condition is promoted to a pre-contract for analysis
##   - After the guard, the condition is assumed true (type narrowing)
##
## Example:
##   def process(x: Option[Int]) -> Int
##     guard let Some(val) = x else { return 0 }
##     val * 2
##   end

struct GuardClause
  condition: String             # Expression that must be true
  else_action: GuardElseAction  # What happens when false
  narrows_type: Bool            # Does this produce a type narrowing?
  promoted_contract: Option[Contract]  # Equivalent pre-contract
end

enum GuardElseAction
  Return(expr: String)      # return <expr>
  Panic(msg: String)        # panic(<msg>)
  Break(label: Option[String])
  Continue(label: Option[String])
end

## Check whether a condition expression produces a type narrowing.
## Recognizes `let` pattern bindings (e.g. `let Some(x) = expr`) and
## `is` type tests (e.g. `x is Int`).
def is_narrowing_condition(condition: &String) -> Bool
  let trimmed = condition.trim()
  # `let` pattern binding guard: `let Pattern = expr`
  if trimmed.starts_with("let ") then
    let rest = trimmed.slice(4, trimmed.len()).trim()
    let has_pattern = rest.contains("(") || rest.contains("::") || rest.contains("|")
    let has_binding = rest.contains("=")
    if has_pattern && has_binding then
      return true
    end
  end
  # `is` type narrowing: `expr is Type`
  let mut i = 0
  let slen = trimmed.len()
  while i + 2 <= slen do
    if trimmed.slice(i, i + 2) == "is" then
      let before_ok = i == 0 || !trimmed.char_at(i - 1).is_alphanumeric()
      let after_ok = i + 2 == slen || !trimmed.char_at(i + 2).is_alphanumeric()
      if before_ok && after_ok then
        return true
      end
    end
    i = i + 1
  end
  false
end

## Build a guard clause.
def make_guard(condition: String, else_action: GuardElseAction) -> GuardClause
  let narrows = is_narrowing_condition(&condition)
  GuardClause {
    condition: condition,
    else_action: else_action,
    narrows_type: narrows,
    promoted_contract: Option::Some(
      make_pre(condition)
    )
  }
end

## Check that a guard's else branch diverges.
## Only Return and Panic unconditionally diverge at the function level.
## Break and Continue only redirect within a loop and do not guarantee
## that code after the guard is unreachable at function scope.
def guard_else_diverges(clause: &GuardClause) -> Bool
  match &clause.else_action
    when GuardElseAction::Return(_) then true
    when GuardElseAction::Panic(_) then true
    when GuardElseAction::Break(_) then false
    when GuardElseAction::Continue(_) then false
  end
end


## Desugar guard to if-else statement (for AST lowering).
def desugar_guard(clause: &GuardClause) -> String
  let else_body = match &clause.else_action
    when GuardElseAction::Return(expr) then "return " + expr
    when GuardElseAction::Panic(msg) then "panic(\"" + msg + "\")"
    when GuardElseAction::Break(label) then
      match label
        when Option::Some(l) then "break :" + l
        when Option::None then "break"
      end
    when GuardElseAction::Continue(label) then
      match label
        when Option::Some(l) then "continue :" + l
        when Option::None then "continue"
      end
  end
  "if !(" + clause.condition + ") then " + else_body + " end"
end
