# Tangerine Standard Library — std::test
# Full unit testing framework with runner, discovery, filtering, and output.

# [METADATA]
# module: tg::test
# status: alpha
# effects: [Io, Kernel]
# capabilities: [Unsafe]
# error_codes: [AssertionFailed, Panic, Timeout, DiscoveryError, Internal]
# description: "Testing framework with test discovery, runner, and assertions."
# examples:
#   - |
#     @test
#     def my_test()
#       assert_eq(1 + 1, 2)
#     end

use std::ctx
use std::gfx_errors::{Error, ErrorCode, TestError}
use std::collections::{Map}
use std::io::{print, println, eprintln}
use std::time::{Instant, Duration, instant_now, duration_between}
use std::env::{get_env}
use std::backtrace::{capture as capture_backtrace, Backtrace}

# ———————————————————————————————————————————————————————————————
# Assertions
# ———————————————————————————————————————————————————————————————

def assert_eq[T](a: T, b: T) -> Unit
  # Compiler intrinsic: compare two values, panic if not equal
  if a != b then
    panic("assertion failed: `assert_eq!`\n  left:  `" + a.to_string() + "`\n  right: `" + b.to_string() + "`")
  end
end

def assert_ne[T](a: T, b: T) -> Unit
  # Compiler intrinsic: compare two values, panic if equal
  if a == b then
    panic("assertion failed: `assert_ne!`\n  both sides equal: `" + a.to_string() + "`")
  end
end

def assert(cond: Bool, msg: String) -> Unit
  if !cond then
    panic("assertion failed: " + msg)
  end
end

def assert_true(cond: Bool) -> Unit
  assert(cond, "expected true, got false")
end

def assert_false(cond: Bool) -> Unit
  assert(!cond, "expected false, got true")
end

def assert_some[T](opt: Option[T]) -> T
  match opt
  when Option::Some(v) then v
  when Option::None then
    panic("assertion failed: expected Some, got None")
  end
end

def assert_none[T](opt: Option[T]) -> Unit
  match opt
  when Option::Some(_) then
    panic("assertion failed: expected None, got Some")
  when Option::None then ()
  end
end

def assert_ok[T, E](result: Result[T, E]) -> T
  match result
  when Result::Ok(v) then v
  when Result::Err(e) then
    panic("assertion failed: expected Ok, got Err(" + e.to_string() + ")")
  end
end

def assert_err[T, E](result: Result[T, E]) -> E
  match result
  when Result::Ok(_) then
    panic("assertion failed: expected Err, got Ok")
  when Result::Err(e) then e
  end
end

def assert_approx_eq(a: Float, b: Float, epsilon: Float) -> Unit
  let diff = if a > b then a - b else b - a end
  if diff > epsilon then
    let msg = "assertion failed: `assert_approx_eq!`\n  left:  `"
      + a.to_string() + "`\n  right: `" + b.to_string()
      + "`\n  epsilon: " + epsilon.to_string()
      + "\n  diff: " + diff.to_string()
    panic(msg)
  end
end

def assert_contains(haystack: String, needle: String) -> Unit
  if !haystack.contains(needle) then
    panic("assertion failed: expected string to contain `" + needle + "`\n  string: `" + haystack + "`")
  end
end

def assert_starts_with(s: String, prefix: String) -> Unit
  if !s.starts_with(prefix) then
    panic("assertion failed: expected string to start with `" + prefix + "`\n  string: `" + s + "`")
  end
end

def assert_panics(f: || -> Unit) -> String
  match catch_panic(f)
  when Option::Some(msg) then msg
  when Option::None then
    panic("assertion failed: expected panic, but none occurred")
  end
end

# ———————————————————————————————————————————————————————————————
# Test Registration
# ———————————————————————————————————————————————————————————————

enum TestOutcome
  Passed
  Failed(message: String, backtrace: Option[Backtrace])
  Skipped(reason: String)
  TimedOut
end

struct TestCase
  name: String
  module: String
  func: || -> Unit
  should_panic: Bool
  ignore: Bool
  timeout_ms: Option[UInt]
  tags: Vec[String]
end

struct TestResult
  name: String
  module: String
  outcome: TestOutcome
  duration: Duration
end

struct TestSuite
  tests: Vec[TestCase]
  before_all: Option[|| -> Unit]
  after_all: Option[|| -> Unit]
  before_each: Option[|| -> Unit]
  after_each: Option[|| -> Unit]
end

def test_suite_new() -> TestSuite
  TestSuite {
    tests: Vec::new(),
    before_all: Option::None,
    after_all: Option::None,
    before_each: Option::None,
    after_each: Option::None
  end
end

def test_case_new(name: String, module: String, func: || -> Unit) -> TestCase
  TestCase {
    name: name,
    module: module,
    func: func,
    should_panic: false,
    ignore: false,
    timeout_ms: Option::None,
    tags: Vec::new()
  end
end

impl TestSuite
  def add_test(&mut self, test: TestCase) -> Unit
    self.tests.push(test)
  end
  
  def register(&mut self, name: String, module: String, func: || -> Unit) -> Unit
    self.tests.push(test_case_new(name, module, func))
  end
  
  def register_should_panic(&mut self, name: String, module: String, func: || -> Unit) -> Unit
    mut tc = test_case_new(name, module, func)
    tc.should_panic = true
    self.tests.push(tc)
  end
  
  def register_ignored(&mut self, name: String, module: String, func: || -> Unit) -> Unit
    mut tc = test_case_new(name, module, func)
    tc.ignore = true
    self.tests.push(tc)
  end
  
  def before_all(&mut self, func: || -> Unit) -> Unit
    self.before_all = Option::Some(func)
  end
  
  def after_all(&mut self, func: || -> Unit) -> Unit
    self.after_all = Option::Some(func)
  end
  
  def before_each(&mut self, func: || -> Unit) -> Unit
    self.before_each = Option::Some(func)
  end
  
  def after_each(&mut self, func: || -> Unit) -> Unit
    self.after_each = Option::Some(func)
  end
end

# ———————————————————————————————————————————————————————————————
# Test Runner
# ———————————————————————————————————————————————————————————————

struct TestRunnerConfig
  filter: Option[String]           # Run only tests matching this pattern
  filter_exact: Bool               # Require exact name match (not substring)
  run_ignored: Bool                # Run ignored tests too
  quiet: Bool                      # Minimal output
  verbose: Bool                    # Maximum detail
  nocapture: Bool                  # Don't capture stdout/stderr
  test_threads: UInt               # Number of parallel test threads (1 = sequential)
  json_output: Bool                # Output as JSON
  list_only: Bool                  # Just list tests, don't run
  color: Bool                      # Colored output
  shuffle: Bool                    # Randomize test order
  timeout_ms: UInt                 # Default timeout per test (0 = no timeout)
end

def default_runner_config() -> TestRunnerConfig
  TestRunnerConfig {
    filter: Option::None,
    filter_exact: false,
    run_ignored: false,
    quiet: false,
    verbose: false,
    nocapture: false,
    test_threads: 1,
    json_output: false,
    list_only: false,
    color: true,
    shuffle: false,
    timeout_ms: 0
  end
end

struct TestRunner
  config: TestRunnerConfig
  results: Vec[TestResult]
  passed: UInt
  failed: UInt
  skipped: UInt
  timed_out: UInt
end

def test_runner_new(config: TestRunnerConfig) -> TestRunner
  TestRunner {
    config: config,
    results: Vec::new(),
    passed: 0,
    failed: 0,
    skipped: 0,
    timed_out: 0
  end
end

impl TestRunner
  def run_suite(&mut self, suite: &TestSuite) -> Bool
    # Filter tests
    let tests = self.filter_tests(&suite.tests)
    
    let total = tests.len()
    
    if self.config.list_only then
      self.list_tests(&tests)
      return true
    end
    
    if !self.config.quiet then
      println("")
      println("running " + total.to_string() + " test(s)")
    end
    
    # Before-all hook
    match suite.before_all
    when Option::Some(f) then f()
    when Option::None then ()
    end
    
    let suite_start = instant_now()
    
    # Run each test
    for test in tests do
      let result = self.run_single_test(test, &suite.before_each, &suite.after_each)
      
      match result.outcome
      when TestOutcome::Passed then
        self.passed = self.passed + 1
        if !self.config.quiet then
          print("test " + result.name + " ... ")
          println("ok (" + format_duration(&result.duration) + ")")
        end
      when TestOutcome::Failed(msg, bt) then
        self.failed = self.failed + 1
        print("test " + result.name + " ... ")
        println("FAILED")
        if self.config.verbose then
          eprintln("  " + msg)
          match bt
          when Option::Some(backtrace) then
            eprintln("  backtrace:")
            eprintln(backtrace.fmt())
          when Option::None then ()
          end
        end
      when TestOutcome::Skipped(reason) then
        self.skipped = self.skipped + 1
        if self.config.verbose then
          println("test " + result.name + " ... skipped (" + reason + ")")
        end
      when TestOutcome::TimedOut then
        self.timed_out = self.timed_out + 1
        print("test " + result.name + " ... ")
        println("TIMED OUT")
      end
      
      self.results.push(result)
    end
    
    # After-all hook
    match suite.after_all
    when Option::Some(f) then f()
    when Option::None then ()
    end
    
    let suite_duration = duration_between(suite_start, instant_now())
    
    # Summary
    self.print_summary(&suite_duration)
    
    # Output JSON if requested
    if self.config.json_output then
      self.print_json_results()
    end
    
    self.failed == 0 && self.timed_out == 0
  end
  
  def run_single_test(&self, test: &TestCase,
                      before_each: &Option[|| -> Unit],
                      after_each: &Option[|| -> Unit]) -> TestResult
    let start = instant_now()
    
    # Check if ignored
    if test.ignore && !self.config.run_ignored then
      return TestResult {
        name: test.module.clone() + "::" + test.name.clone(),
        module: test.module.clone(),
        outcome: TestOutcome::Skipped("ignored".to_string()),
        duration: Duration { nanos: 0 end
      end
    end
    
    # Before-each hook
    match before_each
    when Option::Some(f) then f()
    when Option::None then ()
    end
    
    # Run the test function, catching panics
    let outcome = if test.should_panic then
      match catch_panic(test.func)
      when Option::Some(_) then TestOutcome::Passed
      when Option::None then
        TestOutcome::Failed(
          "test did not panic as expected".to_string(),
          Option::None
        )
      end
    else
      match catch_panic(test.func)
      when Option::None then TestOutcome::Passed
      when Option::Some(msg) then
        let bt = capture_backtrace()
        TestOutcome::Failed(msg, Option::Some(bt))
      end
    end
    
    # After-each hook
    match after_each
    when Option::Some(f) then f()
    when Option::None then ()
    end
    
    let elapsed = duration_between(start, instant_now())
    
    TestResult {
      name: test.module.clone() + "::" + test.name.clone(),
      module: test.module.clone(),
      outcome: outcome,
      duration: elapsed
    end
  end
  
  def filter_tests(&self, tests: &Vec[TestCase]) -> Vec[&TestCase]
    mut filtered = Vec::new()
    
    for test in tests do
      let full_name = test.module.clone() + "::" + test.name.clone()
      
      let matches = match self.config.filter
      when Option::None then true
      when Option::Some(pattern) then
        if self.config.filter_exact then
          full_name == pattern
        else
          full_name.contains(pattern)
        end
      end
      
      if matches then
        filtered.push(test)
      end
    end
    
    filtered
  end
  
  def list_tests(&self, tests: &Vec[&TestCase]) -> Unit
    for test in tests do
      let suffix = if test.ignore then " (ignored)" else "" end
      println(test.module.clone() + "::" + test.name.clone() + suffix)
    end
    println("")
    println(tests.len().to_string() + " test(s) listed")
  end
  
  def print_summary(&self, duration: &Duration) -> Unit
    println("")
    
    if self.failed > 0 then
      println("failures:")
      println("")
      for result in self.results do
        match result.outcome
        when TestOutcome::Failed(msg, _) then
          println("---- " + result.name + " ----")
          println(msg)
          println("")
        when _ then ()
        end
      end
      println("failures:")
      for result in self.results do
        match result.outcome
        when TestOutcome::Failed(_, _) then
          println("    " + result.name)
        when _ then ()
        end
      end
      println("")
    end
    
    let status = if self.failed > 0 || self.timed_out > 0 then "FAILED" else "ok" end
    
    println("test result: " + status + ". " +
            self.passed.to_string() + " passed; " +
            self.failed.to_string() + " failed; " +
            self.skipped.to_string() + " skipped; " +
            self.timed_out.to_string() + " timed out; " +
            "finished in " + format_duration(duration))
  end
  
  def print_json_results(&self) -> Unit
    mut json = "{\"type\":\"suite\",\"passed\":" + self.passed.to_string()
    json = json + ",\"failed\":" + self.failed.to_string()
    json = json + ",\"skipped\":" + self.skipped.to_string()
    json = json + ",\"timed_out\":" + self.timed_out.to_string()
    json = json + ",\"tests\":["
    
    mut first = true
    for result in self.results do
      if !first then json = json + "," end
      json = json + "{\"name\":\"" + result.name + "\""
      
      let status_str = match result.outcome
      when TestOutcome::Passed then "passed"
      when TestOutcome::Failed(_, _) then "failed"
      when TestOutcome::Skipped(_) then "skipped"
      when TestOutcome::TimedOut then "timed_out"
      end
      
      json = json + ",\"status\":\"" + status_str + "\""
      json = json + ",\"duration_ns\":" + result.duration.nanos.to_string()
      
      match result.outcome
      when TestOutcome::Failed(msg, _) then
        json = json + ",\"message\":\"" + json_escape_test(msg) + "\""
      when _ then ()
      end
      
      json = json + "}"
      first = false
    end
    
    json = json + "]}"
    println(json)
  end
end

# ———————————————————————————————————————————————————————————————
# Test Discovery
# ———————————————————————————————————————————————————————————————

# Discover test functions from compiled module metadata.
# The compiler marks functions with #[test] attribute and emits
# test descriptors in the __tangerine_tests section.
def discover_tests(module_path: String) -> Vec[TestCase]
  mut tests = Vec::new()
  
  # Read test descriptors from the compiled module.
  # The compiler emits a global symbol _TG_TEST_DESCRIPTORS
  # containing an array of { name_ptr, func_ptr, should_panic, ignore }.
  let descriptors = unsafe "FFI boundary" do load_test_descriptors(module_path) end
  
  for desc in descriptors do
    mut tc = test_case_new(desc.name.clone(), desc.module.clone(), desc.func)
    tc.should_panic = desc.should_panic
    tc.ignore = desc.ignore
    tests.push(tc)
  end
  
  tests
end

struct TestDescriptor
  name: String
  module: String
  func: || -> Unit
  should_panic: Bool
  ignore: Bool
end

extern "Tangerine"
  # Compiler intrinsic: load test descriptors from compiled module
  def load_test_descriptors(module_path: String) -> Vec[TestDescriptor]
  
  # Compiler intrinsic: catch a panic and return the message
  def catch_panic(f: || -> Unit) -> Option[String]
end

# ———————————————————————————————————————————————————————————————
# CLI Integration
# ———————————————————————————————————————————————————————————————

# Parse test-specific command line arguments (for `tg test`).
def parse_test_args(argv: Vec[String]) -> TestRunnerConfig
  mut config = default_runner_config()
  mut i: UInt = 0
  
  while i < argv.len() do
    let arg = argv[i]
    
    if arg == "--filter" || arg == "-f" then
      i = i + 1
      if i < argv.len() then
        config.filter = Option::Some(argv[i].clone())
      end
    elsif arg == "--exact" then
      config.filter_exact = true
    elsif arg == "--ignored" then
      config.run_ignored = true
    elsif arg == "--quiet" || arg == "-q" then
      config.quiet = true
    elsif arg == "--verbose" || arg == "-v" then
      config.verbose = true
    elsif arg == "--nocapture" then
      config.nocapture = true
    elsif arg == "--test-threads" then
      i = i + 1
      if i < argv.len() then
        config.test_threads = argv[i].parse_uint().unwrap_or(1)
      end
    elsif arg == "--json" then
      config.json_output = true
    elsif arg == "--list" then
      config.list_only = true
    elsif arg == "--no-color" then
      config.color = false
    elsif arg == "--shuffle" then
      config.shuffle = true
    elsif arg == "--timeout" then
      i = i + 1
      if i < argv.len() then
        config.timeout_ms = argv[i].parse_uint().unwrap_or(0)
      end
    elsif !arg.starts_with("-") && config.filter.is_none() then
      # First positional argument is the filter
      config.filter = Option::Some(arg.clone())
    end
    
    i = i + 1
  end
  
  config
end

# Run all tests from discovered modules.
def run_tests(suite: &TestSuite, config: TestRunnerConfig) -> Bool
  mut runner = test_runner_new(config)
  runner.run_suite(suite)
end

# Convenience: run tests with default config.
def run_all_tests(suite: &TestSuite) -> Bool
  run_tests(suite, default_runner_config())
end

# ———————————————————————————————————————————————————————————————
# Helpers
# ———————————————————————————————————————————————————————————————

def format_duration(d: &Duration) -> String
  let total_ms = d.nanos / 1_000_000
  if total_ms < 1000 then
    total_ms.to_string() + "ms"
  else
    let secs = total_ms / 1000
    let ms = total_ms % 1000
    secs.to_string() + "." + pad_left(ms.to_string(), 3, '0') + "s"
  end
end

def pad_left(s: String, width: UInt, fill: Char) -> String
  mut result = s
  while result.len() < width do
    result = fill.to_string() + result
  end
  result
end

def json_escape_test(s: String) -> String
  mut result = ""
  for c in s.chars() do
    if c == '"' then
      result = result + "\\\""
    elsif c == '\\' then
      result = result + "\\\\"
    elsif c == '\n' then
      result = result + "\\n"
    elsif c == '\r' then
      result = result + "\\r"
    elsif c == '\t' then
      result = result + "\\t"
    else
      result = result + c.to_string()
    end
  end
  result
end
