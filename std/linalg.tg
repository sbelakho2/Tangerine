## std::linalg — Linear Algebra Library
## Provides optimized vector, matrix, and quaternion types for 2D/3D/4D
## graphics, physics, and scientific computing. SIMD-accelerated where possible.
##
## Design goals:
##   - Cache-friendly column-major layout (matches OpenGL/Vulkan conventions)
##   - SIMD-accelerated operations via std::simd
##   - Zero-cost abstractions
##   - IEEE 754 compliant by default
##   - Interoperable with GPU buffer formats
##
## Spec: §stdlib.linalg

module std::linalg

use std::core::{Option, Result, Display, Clone, Eq, Default}
use std::fmt
use std::math::{sin, cos, tan, sqrt, atan2, acos, PI, approx_eq, EPSILON}
use std::simd::{f32x4}

# ═══════════════════════════════════════════════════════════════════════
# §1  Vector Types
# ═══════════════════════════════════════════════════════════════════════

## 2D vector (f32).
@repr(C)
pub struct Vec2
  pub x: f32
  pub y: f32
end

## 3D vector (f32).
@repr(C)
pub struct Vec3
  pub x: f32
  pub y: f32
  pub z: f32
end

## 4D vector (f32), also used for homogeneous coordinates.
@repr(C)
@align(16)
pub struct Vec4
  pub x: f32
  pub y: f32
  pub z: f32
  pub w: f32
end

## 2D vector (f64) for high-precision work.
@repr(C)
pub struct DVec2
  pub x: f64
  pub y: f64
end

## 3D vector (f64).
@repr(C)
pub struct DVec3
  pub x: f64
  pub y: f64
  pub z: f64
end

## 4D vector (f64).
@repr(C)
pub struct DVec4
  pub x: f64
  pub y: f64
  pub z: f64
  pub w: f64
end

## 2D integer vector.
@repr(C)
pub struct IVec2
  pub x: i32
  pub y: i32
end

## 3D integer vector.
@repr(C)
pub struct IVec3
  pub x: i32
  pub y: i32
  pub z: i32
end

## 4D integer vector.
@repr(C)
pub struct IVec4
  pub x: i32
  pub y: i32
  pub z: i32
  pub w: i32
end

# ─── Vec2 Implementation ────────────────────────────────────────────

impl Vec2
  pub const ZERO: Vec2 = Vec2 { x: 0.0, y: 0.0 }
  pub const ONE: Vec2 = Vec2 { x: 1.0, y: 1.0 }
  pub const X: Vec2 = Vec2 { x: 1.0, y: 0.0 }
  pub const Y: Vec2 = Vec2 { x: 0.0, y: 1.0 }

  pub def new(x: f32, y: f32) -> Vec2 = Vec2 { x: x, y: y }
  pub def splat(v: f32) -> Vec2 = Vec2 { x: v, y: v }

  pub def add(self, other: Vec2) -> Vec2
    Vec2 { x: self.x + other.x, y: self.y + other.y }
  end

  pub def sub(self, other: Vec2) -> Vec2
    Vec2 { x: self.x - other.x, y: self.y - other.y }
  end

  pub def mul(self, scalar: f32) -> Vec2
    Vec2 { x: self.x * scalar, y: self.y * scalar }
  end

  pub def div(self, scalar: f32) -> Vec2
    pre scalar != 0.0, "division by zero"
    Vec2 { x: self.x / scalar, y: self.y / scalar }
  end

  pub def mul_component(self, other: Vec2) -> Vec2
    Vec2 { x: self.x * other.x, y: self.y * other.y }
  end

  pub def dot(self, other: Vec2) -> f32
    self.x * other.x + self.y * other.y
  end

  ## 2D cross product (returns scalar: the z-component of the 3D cross product).
  pub def cross(self, other: Vec2) -> f32
    self.x * other.y - self.y * other.x
  end

  pub def length_squared(self) -> f32
    self.dot(self)
  end

  pub def length(self) -> f32
    sqrt(self.length_squared() as Float) as f32
  end

  pub def normalize(self) -> Vec2
    let len = self.length()
    if len < 1.0e-8 then Vec2.ZERO else self.div(len) end
  end

  pub def distance(self, other: Vec2) -> f32
    self.sub(other).length()
  end

  pub def lerp(self, other: Vec2, t: f32) -> Vec2
    self.add(other.sub(self).mul(t))
  end

  pub def rotate(self, angle_rad: f32) -> Vec2
    let c = cos(angle_rad as Float) as f32
    let s = sin(angle_rad as Float) as f32
    Vec2 { x: self.x * c - self.y * s, y: self.x * s + self.y * c }
  end

  pub def angle(self) -> f32
    atan2(self.y as Float, self.x as Float) as f32
  end

  pub def perpendicular(self) -> Vec2
    Vec2 { x: -self.y, y: self.x }
  end

  pub def neg(self) -> Vec2
    Vec2 { x: -self.x, y: -self.y }
  end

  pub def min_component(self, other: Vec2) -> Vec2
    Vec2 {
      x: if self.x < other.x then self.x else other.x end,
      y: if self.y < other.y then self.y else other.y end,
    }
  end

  pub def max_component(self, other: Vec2) -> Vec2
    Vec2 {
      x: if self.x > other.x then self.x else other.x end,
      y: if self.y > other.y then self.y else other.y end,
    }
  end

  pub def clamp(self, min: Vec2, max: Vec2) -> Vec2
    self.max_component(min).min_component(max)
  end

  pub def abs(self) -> Vec2
    Vec2 {
      x: if self.x < 0.0 then -self.x else self.x end,
      y: if self.y < 0.0 then -self.y else self.y end,
    }
  end

  pub def reflect(self, normal: Vec2) -> Vec2
    self.sub(normal.mul(2.0 * self.dot(normal)))
  end

  pub def to_vec3(self, z: f32) -> Vec3
    Vec3 { x: self.x, y: self.y, z: z }
  end
end

impl Display for Vec2
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    f.write_str("Vec2(" + self.x.to_string() + ", " + self.y.to_string() + ")")
  end
end

# ─── Vec3 Implementation ────────────────────────────────────────────

impl Vec3
  pub const ZERO: Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 }
  pub const ONE: Vec3 = Vec3 { x: 1.0, y: 1.0, z: 1.0 }
  pub const X: Vec3 = Vec3 { x: 1.0, y: 0.0, z: 0.0 }
  pub const Y: Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 }
  pub const Z: Vec3 = Vec3 { x: 0.0, y: 0.0, z: 1.0 }
  pub const UP: Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 }
  pub const DOWN: Vec3 = Vec3 { x: 0.0, y: -1.0, z: 0.0 }
  pub const FORWARD: Vec3 = Vec3 { x: 0.0, y: 0.0, z: -1.0 }

  pub def new(x: f32, y: f32, z: f32) -> Vec3 = Vec3 { x: x, y: y, z: z }
  pub def splat(v: f32) -> Vec3 = Vec3 { x: v, y: v, z: v }

  pub def add(self, other: Vec3) -> Vec3
    Vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z }
  end

  pub def sub(self, other: Vec3) -> Vec3
    Vec3 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z }
  end

  pub def mul(self, scalar: f32) -> Vec3
    Vec3 { x: self.x * scalar, y: self.y * scalar, z: self.z * scalar }
  end

  pub def div(self, scalar: f32) -> Vec3
    pre scalar != 0.0, "division by zero"
    Vec3 { x: self.x / scalar, y: self.y / scalar, z: self.z / scalar }
  end

  pub def mul_component(self, other: Vec3) -> Vec3
    Vec3 { x: self.x * other.x, y: self.y * other.y, z: self.z * other.z }
  end

  pub def dot(self, other: Vec3) -> f32
    self.x * other.x + self.y * other.y + self.z * other.z
  end

  pub def cross(self, other: Vec3) -> Vec3
    Vec3 {
      x: self.y * other.z - self.z * other.y,
      y: self.z * other.x - self.x * other.z,
      z: self.x * other.y - self.y * other.x,
    }
  end

  pub def length_squared(self) -> f32 = self.dot(self)

  pub def length(self) -> f32 = sqrt(self.length_squared() as Float) as f32

  pub def normalize(self) -> Vec3
    let len = self.length()
    if len < 1.0e-8 then Vec3.ZERO else self.div(len) end
  end

  pub def distance(self, other: Vec3) -> f32 = self.sub(other).length()

  pub def lerp(self, other: Vec3, t: f32) -> Vec3
    self.add(other.sub(self).mul(t))
  end

  pub def neg(self) -> Vec3 = Vec3 { x: -self.x, y: -self.y, z: -self.z }

  pub def reflect(self, normal: Vec3) -> Vec3
    self.sub(normal.mul(2.0 * self.dot(normal)))
  end

  pub def project_onto(self, other: Vec3) -> Vec3
    let d = other.dot(other)
    if d < 1.0e-8 then Vec3.ZERO else other.mul(self.dot(other) / d) end
  end

  pub def angle_between(self, other: Vec3) -> f32
    let d = self.dot(other) / (self.length() * other.length())
    let clamped = if d < -1.0 then -1.0 elsif d > 1.0 then 1.0 else d end
    acos(clamped as Float) as f32
  end

  pub def to_vec4(self, w: f32) -> Vec4
    Vec4 { x: self.x, y: self.y, z: self.z, w: w }
  end

  pub def xy(self) -> Vec2 = Vec2 { x: self.x, y: self.y }
end

impl Display for Vec3
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    f.write_str("Vec3(" + self.x.to_string() + ", " + self.y.to_string() + ", " + self.z.to_string() + ")")
  end
end

# ─── Vec4 Implementation (SIMD-Accelerated) ─────────────────────────

impl Vec4
  pub const ZERO: Vec4 = Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
  pub const ONE: Vec4 = Vec4 { x: 1.0, y: 1.0, z: 1.0, w: 1.0 }

  pub def new(x: f32, y: f32, z: f32, w: f32) -> Vec4
    Vec4 { x: x, y: y, z: z, w: w }
  end

  pub def splat(v: f32) -> Vec4
    Vec4 { x: v, y: v, z: v, w: v }
  end

  ## Convert to SIMD register for batch operations.
  @inline(always)
  def to_simd(self) -> f32x4
    f32x4.new(self.x, self.y, self.z, self.w)
  end

  ## Convert from SIMD register.
  @inline(always)
  def from_simd(v: f32x4) -> Vec4
    Vec4 { x: v.extract(0), y: v.extract(1), z: v.extract(2), w: v.extract(3) }
  end

  pub def add(self, other: Vec4) -> Vec4
    Vec4.from_simd(self.to_simd().add(other.to_simd()))
  end

  pub def sub(self, other: Vec4) -> Vec4
    Vec4.from_simd(self.to_simd().sub(other.to_simd()))
  end

  pub def mul(self, scalar: f32) -> Vec4
    Vec4.from_simd(self.to_simd().mul(f32x4.splat(scalar)))
  end

  pub def div(self, scalar: f32) -> Vec4
    pre scalar != 0.0, "division by zero"
    Vec4.from_simd(self.to_simd().div(f32x4.splat(scalar)))
  end

  pub def mul_component(self, other: Vec4) -> Vec4
    Vec4.from_simd(self.to_simd().mul(other.to_simd()))
  end

  pub def dot(self, other: Vec4) -> f32
    self.to_simd().dot(other.to_simd())
  end

  pub def length_squared(self) -> f32 = self.dot(self)

  pub def length(self) -> f32 = sqrt(self.length_squared() as Float) as f32

  pub def normalize(self) -> Vec4
    let len = self.length()
    if len < 1.0e-8 then Vec4.ZERO else self.div(len) end
  end

  pub def lerp(self, other: Vec4, t: f32) -> Vec4
    self.add(other.sub(self).mul(t))
  end

  pub def neg(self) -> Vec4
    Vec4 { x: -self.x, y: -self.y, z: -self.z, w: -self.w }
  end

  pub def xyz(self) -> Vec3 = Vec3 { x: self.x, y: self.y, z: self.z }
  pub def xy(self) -> Vec2 = Vec2 { x: self.x, y: self.y }
end

impl Display for Vec4
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    f.write_str("Vec4(" + self.x.to_string() + ", " + self.y.to_string() +
      ", " + self.z.to_string() + ", " + self.w.to_string() + ")")
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §2  Matrix Types (Column-Major)
# ═══════════════════════════════════════════════════════════════════════

## 2×2 matrix (column-major). Columns are Vec2.
@repr(C)
pub struct Mat2
  pub col0: Vec2
  pub col1: Vec2
end

## 3×3 matrix (column-major). Columns are Vec3.
@repr(C)
pub struct Mat3
  pub col0: Vec3
  pub col1: Vec3
  pub col2: Vec3
end

## 4×4 matrix (column-major, SIMD-friendly). Columns are Vec4.
@repr(C)
@align(16)
pub struct Mat4
  pub col0: Vec4
  pub col1: Vec4
  pub col2: Vec4
  pub col3: Vec4
end

# ─── Mat2 Implementation ────────────────────────────────────────────

impl Mat2
  pub const IDENTITY: Mat2 = Mat2 {
    col0: Vec2 { x: 1.0, y: 0.0 },
    col1: Vec2 { x: 0.0, y: 1.0 },
  }

  pub const ZERO: Mat2 = Mat2 {
    col0: Vec2.ZERO,
    col1: Vec2.ZERO,
  }

  pub def from_cols(c0: Vec2, c1: Vec2) -> Mat2
    Mat2 { col0: c0, col1: c1 }
  end

  pub def from_rows(r0: Vec2, r1: Vec2) -> Mat2
    Mat2 {
      col0: Vec2 { x: r0.x, y: r1.x },
      col1: Vec2 { x: r0.y, y: r1.y },
    }
  end

  pub def rotation(angle_rad: f32) -> Mat2
    let c = cos(angle_rad as Float) as f32
    let s = sin(angle_rad as Float) as f32
    Mat2 {
      col0: Vec2 { x: c, y: s },
      col1: Vec2 { x: -s, y: c },
    }
  end

  pub def scale(sx: f32, sy: f32) -> Mat2
    Mat2 {
      col0: Vec2 { x: sx, y: 0.0 },
      col1: Vec2 { x: 0.0, y: sy },
    }
  end

  pub def mul_vec2(self, v: Vec2) -> Vec2
    Vec2 {
      x: self.col0.x * v.x + self.col1.x * v.y,
      y: self.col0.y * v.x + self.col1.y * v.y,
    }
  end

  pub def mul_mat2(self, other: Mat2) -> Mat2
    Mat2 {
      col0: self.mul_vec2(other.col0),
      col1: self.mul_vec2(other.col1),
    }
  end

  pub def determinant(self) -> f32
    self.col0.x * self.col1.y - self.col0.y * self.col1.x
  end

  pub def inverse(self) -> Option[Mat2]
    let det = self.determinant()
    if (det as Float).abs() < EPSILON then return None end
    let inv_det = 1.0 / det
    Some(Mat2 {
      col0: Vec2 { x: self.col1.y * inv_det, y: -self.col0.y * inv_det },
      col1: Vec2 { x: -self.col1.x * inv_det, y: self.col0.x * inv_det },
    })
  end

  pub def transpose(self) -> Mat2
    Mat2 {
      col0: Vec2 { x: self.col0.x, y: self.col1.x },
      col1: Vec2 { x: self.col0.y, y: self.col1.y },
    }
  end
end

# ─── Mat3 Implementation ────────────────────────────────────────────

impl Mat3
  pub const IDENTITY: Mat3 = Mat3 {
    col0: Vec3 { x: 1.0, y: 0.0, z: 0.0 },
    col1: Vec3 { x: 0.0, y: 1.0, z: 0.0 },
    col2: Vec3 { x: 0.0, y: 0.0, z: 1.0 },
  }

  pub const ZERO: Mat3 = Mat3 { col0: Vec3.ZERO, col1: Vec3.ZERO, col2: Vec3.ZERO }

  pub def from_cols(c0: Vec3, c1: Vec3, c2: Vec3) -> Mat3
    Mat3 { col0: c0, col1: c1, col2: c2 }
  end

  pub def from_mat4(m: &Mat4) -> Mat3
    Mat3 {
      col0: m.col0.xyz(),
      col1: m.col1.xyz(),
      col2: m.col2.xyz(),
    }
  end

  pub def mul_vec3(self, v: Vec3) -> Vec3
    Vec3 {
      x: self.col0.x * v.x + self.col1.x * v.y + self.col2.x * v.z,
      y: self.col0.y * v.x + self.col1.y * v.y + self.col2.y * v.z,
      z: self.col0.z * v.x + self.col1.z * v.y + self.col2.z * v.z,
    }
  end

  pub def mul_mat3(self, other: Mat3) -> Mat3
    Mat3 {
      col0: self.mul_vec3(other.col0),
      col1: self.mul_vec3(other.col1),
      col2: self.mul_vec3(other.col2),
    }
  end

  pub def determinant(self) -> f32
    self.col0.x * (self.col1.y * self.col2.z - self.col1.z * self.col2.y) -
    self.col1.x * (self.col0.y * self.col2.z - self.col0.z * self.col2.y) +
    self.col2.x * (self.col0.y * self.col1.z - self.col0.z * self.col1.y)
  end

  pub def transpose(self) -> Mat3
    Mat3 {
      col0: Vec3 { x: self.col0.x, y: self.col1.x, z: self.col2.x },
      col1: Vec3 { x: self.col0.y, y: self.col1.y, z: self.col2.y },
      col2: Vec3 { x: self.col0.z, y: self.col1.z, z: self.col2.z },
    }
  end

  pub def inverse(self) -> Option[Mat3]
    let det = self.determinant()
    if (det as Float).abs() < EPSILON then return None end
    let inv_det = 1.0 / det
    Some(Mat3 {
      col0: Vec3 {
        x: (self.col1.y * self.col2.z - self.col1.z * self.col2.y) * inv_det,
        y: (self.col0.z * self.col2.y - self.col0.y * self.col2.z) * inv_det,
        z: (self.col0.y * self.col1.z - self.col0.z * self.col1.y) * inv_det,
      },
      col1: Vec3 {
        x: (self.col1.z * self.col2.x - self.col1.x * self.col2.z) * inv_det,
        y: (self.col0.x * self.col2.z - self.col0.z * self.col2.x) * inv_det,
        z: (self.col0.z * self.col1.x - self.col0.x * self.col1.z) * inv_det,
      },
      col2: Vec3 {
        x: (self.col1.x * self.col2.y - self.col1.y * self.col2.x) * inv_det,
        y: (self.col0.y * self.col2.x - self.col0.x * self.col2.y) * inv_det,
        z: (self.col0.x * self.col1.y - self.col0.y * self.col1.x) * inv_det,
      },
    })
  end
end

# ─── Mat4 Implementation (SIMD-accelerated) ─────────────────────────

impl Mat4
  pub const IDENTITY: Mat4 = Mat4 {
    col0: Vec4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 },
    col1: Vec4 { x: 0.0, y: 1.0, z: 0.0, w: 0.0 },
    col2: Vec4 { x: 0.0, y: 0.0, z: 1.0, w: 0.0 },
    col3: Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
  }

  pub const ZERO: Mat4 = Mat4 {
    col0: Vec4.ZERO, col1: Vec4.ZERO, col2: Vec4.ZERO, col3: Vec4.ZERO,
  }

  pub def from_cols(c0: Vec4, c1: Vec4, c2: Vec4, c3: Vec4) -> Mat4
    Mat4 { col0: c0, col1: c1, col2: c2, col3: c3 }
  end

  ## Multiply matrix by a Vec4.
  pub def mul_vec4(self, v: Vec4) -> Vec4
    let c0 = self.col0.to_simd().mul(f32x4.splat(v.x))
    let c1 = self.col1.to_simd().mul(f32x4.splat(v.y))
    let c2 = self.col2.to_simd().mul(f32x4.splat(v.z))
    let c3 = self.col3.to_simd().mul(f32x4.splat(v.w))
    Vec4.from_simd(c0.add(c1).add(c2).add(c3))
  end

  ## Matrix multiplication.
  pub def mul_mat4(self, other: Mat4) -> Mat4
    Mat4 {
      col0: self.mul_vec4(other.col0),
      col1: self.mul_vec4(other.col1),
      col2: self.mul_vec4(other.col2),
      col3: self.mul_vec4(other.col3),
    }
  end

  ## Transpose.
  pub def transpose(self) -> Mat4
    Mat4 {
      col0: Vec4 { x: self.col0.x, y: self.col1.x, z: self.col2.x, w: self.col3.x },
      col1: Vec4 { x: self.col0.y, y: self.col1.y, z: self.col2.y, w: self.col3.y },
      col2: Vec4 { x: self.col0.z, y: self.col1.z, z: self.col2.z, w: self.col3.z },
      col3: Vec4 { x: self.col0.w, y: self.col1.w, z: self.col2.w, w: self.col3.w },
    }
  end

  ## Determinant (Laplace expansion).
  pub def determinant(self) -> f32
    let a = self.col0.x; let b = self.col1.x; let c = self.col2.x; let d = self.col3.x
    let e = self.col0.y; let f_ = self.col1.y; let g = self.col2.y; let h = self.col3.y
    let i = self.col0.z; let j = self.col1.z; let k = self.col2.z; let l = self.col3.z
    let m = self.col0.w; let n = self.col1.w; let o = self.col2.w; let p = self.col3.w

    let kp_lo = k * p - l * o
    let jp_ln = j * p - l * n
    let jo_kn = j * o - k * n
    let ip_lm = i * p - l * m
    let io_km = i * o - k * m
    let in_jm = i * n - j * m

    a * (f_ * kp_lo - g * jp_ln + h * jo_kn) -
    b * (e * kp_lo - g * ip_lm + h * io_km) +
    c * (e * jp_ln - f_ * ip_lm + h * in_jm) -
    d * (e * jo_kn - f_ * io_km + g * in_jm)
  end

  ## Inverse (returns None if singular).
  pub def inverse(self) -> Option[Mat4]
    let det = self.determinant()
    if (det as Float).abs() < EPSILON then return None end
    let inv_det = 1.0 / det

    let a = self.col0.x; let b = self.col1.x; let c = self.col2.x; let d = self.col3.x
    let e = self.col0.y; let f_ = self.col1.y; let g = self.col2.y; let h = self.col3.y
    let i = self.col0.z; let j = self.col1.z; let k = self.col2.z; let l = self.col3.z
    let m = self.col0.w; let n = self.col1.w; let o = self.col2.w; let p = self.col3.w

    ## Cofactors for first row
    let c00 = f_ * (k*p - l*o) - g * (j*p - l*n) + h * (j*o - k*n)
    let c01 = -(e * (k*p - l*o) - g * (i*p - l*m) + h * (i*o - k*m))
    let c02 = e * (j*p - l*n) - f_ * (i*p - l*m) + h * (i*n - j*m)
    let c03 = -(e * (j*o - k*n) - f_ * (i*o - k*m) + g * (i*n - j*m))

    let c10 = -(b * (k*p - l*o) - c * (j*p - l*n) + d * (j*o - k*n))
    let c11 = a * (k*p - l*o) - c * (i*p - l*m) + d * (i*o - k*m)
    let c12 = -(a * (j*p - l*n) - b * (i*p - l*m) + d * (i*n - j*m))
    let c13 = a * (j*o - k*n) - b * (i*o - k*m) + c * (i*n - j*m)

    let c20 = b * (g*p - h*o) - c * (f_*p - h*n) + d * (f_*o - g*n)
    let c21 = -(a * (g*p - h*o) - c * (e*p - h*m) + d * (e*o - g*m))
    let c22 = a * (f_*p - h*n) - b * (e*p - h*m) + d * (e*n - f_*m)
    let c23 = -(a * (f_*o - g*n) - b * (e*o - g*m) + c * (e*n - f_*m))

    let c30 = -(b * (g*l - h*k) - c * (f_*l - h*j) + d * (f_*k - g*j))
    let c31 = a * (g*l - h*k) - c * (e*l - h*i) + d * (e*k - g*i)
    let c32 = -(a * (f_*l - h*j) - b * (e*l - h*i) + d * (e*j - f_*i))
    let c33 = a * (f_*k - g*j) - b * (e*k - g*i) + c * (e*j - f_*i)

    Some(Mat4 {
      col0: Vec4 { x: c00 * inv_det, y: c01 * inv_det, z: c02 * inv_det, w: c03 * inv_det },
      col1: Vec4 { x: c10 * inv_det, y: c11 * inv_det, z: c12 * inv_det, w: c13 * inv_det },
      col2: Vec4 { x: c20 * inv_det, y: c21 * inv_det, z: c22 * inv_det, w: c23 * inv_det },
      col3: Vec4 { x: c30 * inv_det, y: c31 * inv_det, z: c32 * inv_det, w: c33 * inv_det },
    })
  end

  # ─── Transform Construction ───────────────────────────────────────

  pub def translation(v: Vec3) -> Mat4
    Mat4 {
      col0: Vec4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 },
      col1: Vec4 { x: 0.0, y: 1.0, z: 0.0, w: 0.0 },
      col2: Vec4 { x: 0.0, y: 0.0, z: 1.0, w: 0.0 },
      col3: Vec4 { x: v.x, y: v.y, z: v.z, w: 1.0 },
    }
  end

  pub def scaling(v: Vec3) -> Mat4
    Mat4 {
      col0: Vec4 { x: v.x, y: 0.0, z: 0.0, w: 0.0 },
      col1: Vec4 { x: 0.0, y: v.y, z: 0.0, w: 0.0 },
      col2: Vec4 { x: 0.0, y: 0.0, z: v.z, w: 0.0 },
      col3: Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
    }
  end

  pub def rotation_x(angle_rad: f32) -> Mat4
    let c = cos(angle_rad as Float) as f32
    let s = sin(angle_rad as Float) as f32
    Mat4 {
      col0: Vec4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 },
      col1: Vec4 { x: 0.0, y: c, z: s, w: 0.0 },
      col2: Vec4 { x: 0.0, y: -s, z: c, w: 0.0 },
      col3: Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
    }
  end

  pub def rotation_y(angle_rad: f32) -> Mat4
    let c = cos(angle_rad as Float) as f32
    let s = sin(angle_rad as Float) as f32
    Mat4 {
      col0: Vec4 { x: c, y: 0.0, z: -s, w: 0.0 },
      col1: Vec4 { x: 0.0, y: 1.0, z: 0.0, w: 0.0 },
      col2: Vec4 { x: s, y: 0.0, z: c, w: 0.0 },
      col3: Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
    }
  end

  pub def rotation_z(angle_rad: f32) -> Mat4
    let c = cos(angle_rad as Float) as f32
    let s = sin(angle_rad as Float) as f32
    Mat4 {
      col0: Vec4 { x: c, y: s, z: 0.0, w: 0.0 },
      col1: Vec4 { x: -s, y: c, z: 0.0, w: 0.0 },
      col2: Vec4 { x: 0.0, y: 0.0, z: 1.0, w: 0.0 },
      col3: Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
    }
  end

  pub def rotation_axis(axis: Vec3, angle_rad: f32) -> Mat4
    let n = axis.normalize()
    let c = cos(angle_rad as Float) as f32
    let s = sin(angle_rad as Float) as f32
    let t = 1.0 - c
    Mat4 {
      col0: Vec4 { x: t*n.x*n.x + c,     y: t*n.x*n.y + s*n.z, z: t*n.x*n.z - s*n.y, w: 0.0 },
      col1: Vec4 { x: t*n.x*n.y - s*n.z, y: t*n.y*n.y + c,     z: t*n.y*n.z + s*n.x, w: 0.0 },
      col2: Vec4 { x: t*n.x*n.z + s*n.y, y: t*n.y*n.z - s*n.x, z: t*n.z*n.z + c,     w: 0.0 },
      col3: Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
    }
  end

  # ─── Projection Matrices ──────────────────────────────────────────

  ## Perspective projection (Vulkan NDC: y-down, z in [0,1]).
  pub def perspective(fov_y_rad: f32, aspect: f32, near: f32, far: f32) -> Mat4
    pre near > 0.0, "near plane must be positive"
    pre far > near, "far must be greater than near"
    let f_ = 1.0 / (tan((fov_y_rad / 2.0) as Float) as f32)
    let range_inv = 1.0 / (near - far)
    Mat4 {
      col0: Vec4 { x: f_ / aspect, y: 0.0, z: 0.0, w: 0.0 },
      col1: Vec4 { x: 0.0, y: -f_, z: 0.0, w: 0.0 },
      col2: Vec4 { x: 0.0, y: 0.0, z: far * range_inv, w: -1.0 },
      col3: Vec4 { x: 0.0, y: 0.0, z: near * far * range_inv, w: 0.0 },
    }
  end

  ## Perspective projection (OpenGL NDC: y-up, z in [-1,1]).
  pub def perspective_gl(fov_y_rad: f32, aspect: f32, near: f32, far: f32) -> Mat4
    pre near > 0.0, "near plane must be positive"
    pre far > near, "far must be greater than near"
    let f_ = 1.0 / (tan((fov_y_rad / 2.0) as Float) as f32)
    let range_inv = 1.0 / (near - far)
    Mat4 {
      col0: Vec4 { x: f_ / aspect, y: 0.0, z: 0.0, w: 0.0 },
      col1: Vec4 { x: 0.0, y: f_, z: 0.0, w: 0.0 },
      col2: Vec4 { x: 0.0, y: 0.0, z: (far + near) * range_inv, w: -1.0 },
      col3: Vec4 { x: 0.0, y: 0.0, z: 2.0 * far * near * range_inv, w: 0.0 },
    }
  end

  ## Orthographic projection.
  pub def ortho(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32) -> Mat4
    let rml = right - left
    let tmb = top - bottom
    let fmn = far - near
    Mat4 {
      col0: Vec4 { x: 2.0 / rml, y: 0.0, z: 0.0, w: 0.0 },
      col1: Vec4 { x: 0.0, y: 2.0 / tmb, z: 0.0, w: 0.0 },
      col2: Vec4 { x: 0.0, y: 0.0, z: -1.0 / fmn, w: 0.0 },
      col3: Vec4 { x: -(right + left) / rml, y: -(top + bottom) / tmb, z: -near / fmn, w: 1.0 },
    }
  end

  ## Look-at view matrix.
  pub def look_at(eye: Vec3, target: Vec3, up: Vec3) -> Mat4
    let f_ = target.sub(eye).normalize()
    let s = f_.cross(up).normalize()
    let u = s.cross(f_)
    Mat4 {
      col0: Vec4 { x: s.x, y: u.x, z: -f_.x, w: 0.0 },
      col1: Vec4 { x: s.y, y: u.y, z: -f_.y, w: 0.0 },
      col2: Vec4 { x: s.z, y: u.z, z: -f_.z, w: 0.0 },
      col3: Vec4 { x: -s.dot(eye), y: -u.dot(eye), z: f_.dot(eye), w: 1.0 },
    }
  end

  ## Extract translation component.
  pub def get_translation(self) -> Vec3
    Vec3 { x: self.col3.x, y: self.col3.y, z: self.col3.z }
  end

  ## Extract scale component (approximate — assumes no shear).
  pub def get_scale(self) -> Vec3
    Vec3 {
      x: self.col0.xyz().length(),
      y: self.col1.xyz().length(),
      z: self.col2.xyz().length(),
    }
  end
end

impl Display for Mat4
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    f.write_str("Mat4[\n")
    f.write_str("  " + self.col0.to_string() + "\n")
    f.write_str("  " + self.col1.to_string() + "\n")
    f.write_str("  " + self.col2.to_string() + "\n")
    f.write_str("  " + self.col3.to_string() + "\n")
    f.write_str("]")
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §3  Quaternion
# ═══════════════════════════════════════════════════════════════════════

## Unit quaternion for 3D rotations (x, y, z = imaginary, w = real).
@repr(C)
@align(16)
pub struct Quat
  pub x: f32
  pub y: f32
  pub z: f32
  pub w: f32
end

impl Quat
  pub const IDENTITY: Quat = Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }

  pub def new(x: f32, y: f32, z: f32, w: f32) -> Quat
    Quat { x: x, y: y, z: z, w: w }
  end

  pub def from_axis_angle(axis: Vec3, angle_rad: f32) -> Quat
    let half = angle_rad / 2.0
    let s = sin(half as Float) as f32
    let c = cos(half as Float) as f32
    let n = axis.normalize()
    Quat { x: n.x * s, y: n.y * s, z: n.z * s, w: c }
  end

  pub def from_euler(pitch: f32, yaw: f32, roll: f32) -> Quat
    let cp = cos((pitch / 2.0) as Float) as f32
    let sp = sin((pitch / 2.0) as Float) as f32
    let cy = cos((yaw / 2.0) as Float) as f32
    let sy = sin((yaw / 2.0) as Float) as f32
    let cr = cos((roll / 2.0) as Float) as f32
    let sr = sin((roll / 2.0) as Float) as f32
    Quat {
      x: sr * cp * cy - cr * sp * sy,
      y: cr * sp * cy + sr * cp * sy,
      z: cr * cp * sy - sr * sp * cy,
      w: cr * cp * cy + sr * sp * sy,
    }
  end

  pub def from_mat3(m: &Mat3) -> Quat
    let trace = m.col0.x + m.col1.y + m.col2.z
    if trace > 0.0 then
      let s = sqrt((trace + 1.0) as Float) as f32
      let w = s * 0.5
      let s = 0.5 / s
      Quat {
        x: (m.col1.z - m.col2.y) * s,
        y: (m.col2.x - m.col0.z) * s,
        z: (m.col0.y - m.col1.x) * s,
        w: w,
      }
    elsif m.col0.x > m.col1.y && m.col0.x > m.col2.z then
      let s = sqrt((1.0 + m.col0.x - m.col1.y - m.col2.z) as Float) as f32
      let x = s * 0.5
      let s = 0.5 / s
      Quat {
        x: x,
        y: (m.col0.y + m.col1.x) * s,
        z: (m.col2.x + m.col0.z) * s,
        w: (m.col1.z - m.col2.y) * s,
      }
    elsif m.col1.y > m.col2.z then
      let s = sqrt((1.0 + m.col1.y - m.col0.x - m.col2.z) as Float) as f32
      let y = s * 0.5
      let s = 0.5 / s
      Quat {
        x: (m.col0.y + m.col1.x) * s,
        y: y,
        z: (m.col1.z + m.col2.y) * s,
        w: (m.col2.x - m.col0.z) * s,
      }
    else
      let s = sqrt((1.0 + m.col2.z - m.col0.x - m.col1.y) as Float) as f32
      let z = s * 0.5
      let s = 0.5 / s
      Quat {
        x: (m.col2.x + m.col0.z) * s,
        y: (m.col1.z + m.col2.y) * s,
        z: z,
        w: (m.col0.y - m.col1.x) * s,
      }
    end
  end

  pub def mul(self, other: Quat) -> Quat
    Quat {
      x: self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
      y: self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
      z: self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w,
      w: self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z,
    }
  end

  pub def rotate_vec3(self, v: Vec3) -> Vec3
    let qv = Vec3 { x: self.x, y: self.y, z: self.z }
    let uv = qv.cross(v)
    let uuv = qv.cross(uv)
    v.add(uv.mul(2.0 * self.w)).add(uuv.mul(2.0))
  end

  pub def conjugate(self) -> Quat
    Quat { x: -self.x, y: -self.y, z: -self.z, w: self.w }
  end

  pub def length_squared(self) -> f32
    self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w
  end

  pub def length(self) -> f32
    sqrt(self.length_squared() as Float) as f32
  end

  pub def normalize(self) -> Quat
    let len = self.length()
    if len < 1.0e-8 then Quat.IDENTITY
    else Quat { x: self.x / len, y: self.y / len, z: self.z / len, w: self.w / len }
    end
  end

  pub def inverse(self) -> Quat
    let ls = self.length_squared()
    if ls < 1.0e-8 then Quat.IDENTITY
    else
      let inv = 1.0 / ls
      Quat { x: -self.x * inv, y: -self.y * inv, z: -self.z * inv, w: self.w * inv }
    end
  end

  pub def dot(self, other: Quat) -> f32
    self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w
  end

  ## Spherical linear interpolation (constant angular velocity).
  pub def slerp(self, other: Quat, t: f32) -> Quat
    var d = self.dot(other)
    var target = other
    if d < 0.0 then
      d = -d
      target = Quat { x: -other.x, y: -other.y, z: -other.z, w: -other.w }
    end
    if d > 0.9995 then
      ## Close enough to use linear interpolation
      Quat {
        x: self.x + (target.x - self.x) * t,
        y: self.y + (target.y - self.y) * t,
        z: self.z + (target.z - self.z) * t,
        w: self.w + (target.w - self.w) * t,
      }.normalize()
    else
      let theta = acos(d as Float) as f32
      let sin_theta = sin(theta as Float) as f32
      let s0 = sin(((1.0 - t) * theta) as Float) as f32 / sin_theta
      let s1 = sin((t * theta) as Float) as f32 / sin_theta
      Quat {
        x: self.x * s0 + target.x * s1,
        y: self.y * s0 + target.y * s1,
        z: self.z * s0 + target.z * s1,
        w: self.w * s0 + target.w * s1,
      }
    end
  end

  pub def to_mat3(self) -> Mat3
    let x2 = self.x + self.x; let y2 = self.y + self.y; let z2 = self.z + self.z
    let xx = self.x * x2; let xy = self.x * y2; let xz = self.x * z2
    let yy = self.y * y2; let yz = self.y * z2; let zz = self.z * z2
    let wx = self.w * x2; let wy = self.w * y2; let wz = self.w * z2
    Mat3 {
      col0: Vec3 { x: 1.0 - (yy + zz), y: xy + wz, z: xz - wy },
      col1: Vec3 { x: xy - wz, y: 1.0 - (xx + zz), z: yz + wx },
      col2: Vec3 { x: xz + wy, y: yz - wx, z: 1.0 - (xx + yy) },
    }
  end

  pub def to_mat4(self) -> Mat4
    let m = self.to_mat3()
    Mat4 {
      col0: m.col0.to_vec4(0.0),
      col1: m.col1.to_vec4(0.0),
      col2: m.col2.to_vec4(0.0),
      col3: Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
    }
  end

  pub def to_axis_angle(self) -> (Vec3, f32)
    let angle = 2.0 * acos(self.w as Float) as f32
    let s = sqrt((1.0 - self.w * self.w) as Float) as f32
    if s < 1.0e-8 then
      (Vec3.X, angle)
    else
      (Vec3 { x: self.x / s, y: self.y / s, z: self.z / s }, angle)
    end
  end
end

impl Display for Quat
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    f.write_str("Quat(" + self.x.to_string() + ", " + self.y.to_string() +
      ", " + self.z.to_string() + ", " + self.w.to_string() + ")")
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §4  Transform (TRS)
# ═══════════════════════════════════════════════════════════════════════

## Combined Translation-Rotation-Scale transform (more efficient than Mat4 for
## composition and avoids floating-point drift from repeated matrix multiplications).
pub struct Transform
  pub position: Vec3
  pub rotation: Quat
  pub scale: Vec3
end

impl Transform
  pub const IDENTITY: Transform = Transform {
    position: Vec3.ZERO,
    rotation: Quat.IDENTITY,
    scale: Vec3.ONE,
  }

  pub def new(position: Vec3, rotation: Quat, scale: Vec3) -> Transform
    Transform { position: position, rotation: rotation, scale: scale }
  end

  pub def to_mat4(self) -> Mat4
    let r = self.rotation.to_mat4()
    let s = Mat4.scaling(self.scale)
    let t = Mat4.translation(self.position)
    t.mul_mat4(r.mul_mat4(s))
  end

  pub def transform_point(self, point: Vec3) -> Vec3
    self.rotation.rotate_vec3(point.mul_component(self.scale)).add(self.position)
  end

  pub def transform_direction(self, dir: Vec3) -> Vec3
    self.rotation.rotate_vec3(dir)
  end

  pub def inverse(self) -> Transform
    let inv_rot = self.rotation.inverse()
    let inv_scale = Vec3 {
      x: if self.scale.x != 0.0 then 1.0 / self.scale.x else 0.0 end,
      y: if self.scale.y != 0.0 then 1.0 / self.scale.y else 0.0 end,
      z: if self.scale.z != 0.0 then 1.0 / self.scale.z else 0.0 end,
    }
    let inv_pos = inv_rot.rotate_vec3(self.position.neg().mul_component(inv_scale))
    Transform { position: inv_pos, rotation: inv_rot, scale: inv_scale }
  end

  pub def compose(self, child: Transform) -> Transform
    Transform {
      position: self.transform_point(child.position),
      rotation: self.rotation.mul(child.rotation),
      scale: self.scale.mul_component(child.scale),
    }
  end

  pub def lerp(self, other: Transform, t: f32) -> Transform
    Transform {
      position: self.position.lerp(other.position, t),
      rotation: self.rotation.slerp(other.rotation, t),
      scale: self.scale.lerp(other.scale, t),
    }
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §5  Tests
# ═══════════════════════════════════════════════════════════════════════

@test
def test_vec3_cross_product() -> Unit
  let x = Vec3.X
  let y = Vec3.Y
  let z = x.cross(y)
  assert approx_eq(z.x as Float, 0.0, 0.001)
  assert approx_eq(z.y as Float, 0.0, 0.001)
  assert approx_eq(z.z as Float, 1.0, 0.001)
end

@test
def test_mat4_identity_mul() -> Unit
  let m = Mat4.IDENTITY
  let v = Vec4.new(1.0, 2.0, 3.0, 1.0)
  let result = m.mul_vec4(v)
  assert approx_eq(result.x as Float, 1.0, 0.001)
  assert approx_eq(result.y as Float, 2.0, 0.001)
  assert approx_eq(result.z as Float, 3.0, 0.001)
end

@test
def test_mat4_inverse() -> Unit
  let m = Mat4.translation(Vec3.new(1.0, 2.0, 3.0))
  let inv = m.inverse().unwrap()
  let result = m.mul_mat4(inv)
  assert approx_eq(result.col0.x as Float, 1.0, 0.001)
  assert approx_eq(result.col3.x as Float, 0.0, 0.001)
end

@test
def test_quat_rotation() -> Unit
  let q = Quat.from_axis_angle(Vec3 { x: 0.0, y: 0.0, z: 1.0 }, PI as f32 / 2.0)
  let v = Vec3 { x: 1.0, y: 0.0, z: 0.0 }
  let rotated = q.rotate_vec3(v)
  assert approx_eq(rotated.x as Float, 0.0, 0.01)
  assert approx_eq(rotated.y as Float, 1.0, 0.01)
end

@test
def test_quat_slerp() -> Unit
  let a = Quat.IDENTITY
  let b = Quat.from_axis_angle(Vec3 { x: 0.0, y: 1.0, z: 0.0 }, 3.141592653589793 as f32)
  let mid = a.slerp(b, 0.5)
  let (_, angle) = mid.to_axis_angle()
  assert approx_eq(angle as Float, 3.141592653589793 / 2.0, 0.01)
end

@test
def test_perspective_projection() -> Unit
  let proj = Mat4.perspective((3.141592653589793 / 4.0) as f32, 16.0 / 9.0, 0.1, 100.0)
  ## Should not be identity
  assert proj.col0.x != 1.0
  ## w column should have -1 in z for perspective divide
  assert approx_eq(proj.col2.w as Float, -1.0, 0.001)
end

@test
def test_transform_composition() -> Unit
  let identity_quat = Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
  let one_scale = Vec3 { x: 1.0, y: 1.0, z: 1.0 }
  let parent = Transform.new(Vec3.new(1.0, 0.0, 0.0), identity_quat, one_scale)
  let child = Transform.new(Vec3.new(0.0, 1.0, 0.0), identity_quat, one_scale)
  let combined = parent.compose(child)
  assert approx_eq(combined.position.x as Float, 1.0, 0.001)
  assert approx_eq(combined.position.y as Float, 1.0, 0.001)
end

end ## module std::linalg
