# Tangerine Standard Library — tg::ui (retained-mode toolkit)
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 11.

use std::core::{Option, Result, String, Bool, Int, Unit}
use std::geom::{Rect, RRect, Color, Path, Transform2D}
use std::gfx::{Paint, Stroke, Canvas, Image, BlendMode}
use std::gfx_errors::{Error, ErrorCode, UiError}
use std::text::{FontDb, FontId, GlyphRun, TextStyle as TxtStyle}
use std::app::{MouseButton, Key, KeyMods, ScrollMode}

# ═══════════════════════════════════════════════════════════════
# §11.1 Fundamental model
#
# Widget Tree: nodes are Widgets; containers compose children.
# Layout:      measure then layout; constraints top-down, sizes
#              bottom-up (intrinsic + available → actual).
# Rendering:   widgets emit PaintList; compositor may cache/merge.
# Events:      v0.1 uses direct dispatch + focus.
#              Capture/bubble phases reserved for v0.2.
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# §11.2 Core interfaces / types
# ═══════════════════════════════════════════════════════════════

struct UiId
  value: u64
end

struct Constraints
  min_w: f32
  min_h: f32
  max_w: f32
  max_h: f32
end

struct Measure
  w: f32
  h: f32
end

enum UiEvent
  PointerDown(f32, f32, MouseButton)   # (x, y, button)
  PointerUp(f32, f32, MouseButton)     # (x, y, button)
  PointerMove(f32, f32)                # (x, y)
  Scroll(f32, f32, ScrollMode)         # (dx, dy, mode)
  KeyDown(Key, KeyMods)
  KeyUp(Key, KeyMods)
  TextInput(String)
end

struct EventCtx
  request_redraw: Bool
  set_focus: Option[UiId]
end

struct Theme
  bg: Color
  fg: Color
  accent: Color
  font: Option[FontId]
end

struct UiCtx
  dpi: f32
  theme: Theme
  font_db: FontDb
end

# ═══════════════════════════════════════════════════════════════
# §11.2 PaintList / PaintCmd
# ═══════════════════════════════════════════════════════════════

enum PaintCmd
  FillRect(Rect, Paint)
  StrokeRect(Rect, Paint, Stroke)
  FillRRect(RRect, Paint)
  FillPath(Path, Paint)
  StrokePath(Path, Paint, Stroke)
  DrawGlyphRun(GlyphRun, Color)
  DrawImage(Image, Rect, f32)               # image, dst rect, opacity
  PushClipRect(Rect)
  PopClip
  PushTransform(Transform2D)
  PopTransform
end

struct PaintList
  cmds: Vec[PaintCmd]
end

impl PaintList
  def new() -> PaintList
    PaintList { cmds: Vec::new() }
  end

  def fill_rect(inout self: PaintList, r: Rect, p: Paint) -> Unit
    self.cmds.push(PaintCmd::FillRect(r, p))
  end

  def stroke_rect(inout self: PaintList, r: Rect, p: Paint, s: Stroke) -> Unit
    self.cmds.push(PaintCmd::StrokeRect(r, p, s))
  end

  def fill_rrect(inout self: PaintList, rr: RRect, p: Paint) -> Unit
    self.cmds.push(PaintCmd::FillRRect(rr, p))
  end

  def fill_path(inout self: PaintList, path: Path, p: Paint) -> Unit
    self.cmds.push(PaintCmd::FillPath(path, p))
  end

  def stroke_path(inout self: PaintList, path: Path, p: Paint, s: Stroke) -> Unit
    self.cmds.push(PaintCmd::StrokePath(path, p, s))
  end

  def draw_glyph_run(inout self: PaintList, run: GlyphRun, color: Color) -> Unit
    self.cmds.push(PaintCmd::DrawGlyphRun(run, color))
  end

  def draw_image(inout self: PaintList, img: Image, dst: Rect, opacity: f32) -> Unit
    self.cmds.push(PaintCmd::DrawImage(img, dst, opacity))
  end

  def push_clip_rect(inout self: PaintList, r: Rect) -> Unit
    self.cmds.push(PaintCmd::PushClipRect(r))
  end

  def pop_clip(inout self: PaintList) -> Unit
    self.cmds.push(PaintCmd::PopClip)
  end

  def push_transform(inout self: PaintList, t: Transform2D) -> Unit
    self.cmds.push(PaintCmd::PushTransform(t))
  end

  def pop_transform(inout self: PaintList) -> Unit
    self.cmds.push(PaintCmd::PopTransform)
  end
end

# ═══════════════════════════════════════════════════════════════
# §11.2 Widget trait
# ═══════════════════════════════════════════════════════════════

trait Widget
  def id(self: Self) -> UiId
  def measure(self: Self, ctx: UiCtx, c: Constraints) -> Measure
  def layout(inout self: Self, ctx: UiCtx, origin: Rect) -> Unit
  def event(inout self: Self, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
  def paint(self: Self, ctx: UiCtx, inout out: PaintList) -> Unit
  def semantics(self: Self) -> String   # Accessibility label for a11y tree
end

# ═══════════════════════════════════════════════════════════════
# §11.3 ImageFit enum
# ═══════════════════════════════════════════════════════════════

enum ImageFit
  Fill
  Contain
  Cover
end

# ═══════════════════════════════════════════════════════════════
# §11.3 Built-in widgets
# ═══════════════════════════════════════════════════════════════

# ─── Id generator ─────────────────────────────────────────────
mut _next_ui_id: u64 = 1u64

def _gen_id() -> UiId
  let id = UiId { value: _next_ui_id }
  _next_ui_id = _next_ui_id + 1u64
  id
end

# ─── Containers/Layout ────────────────────────────────────────

struct Row
  _id: UiId
  children: Vec[Box[Widget]]
  gap: f32
  _rect: Rect
end

def row(children: Vec[Box[Widget]], gap: f32) -> Row
  Row { _id: _gen_id(), children: children, gap: gap, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for Row
  def id(self: Row) -> UiId
    self._id
  end

  def measure(self: Row, ctx: UiCtx, c: Constraints) -> Measure
    var total_w = 0.0f32
    var max_h = 0.0f32
    var i = 0
    while i < self.children.len() do
      let m = self.children.get(i).measure(ctx, c)
      total_w = total_w + m.w
      if m.h > max_h then max_h = m.h end
      i = i + 1
    end
    let gaps = if self.children.len() > 1 then self.gap * ((self.children.len() - 1) as f32) else 0.0f32 end
    Measure { w: total_w + gaps, h: max_h }
  end

  def layout(inout self: Row, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
    var x = origin.x
    var i = 0
    while i < self.children.len() do
      let m = self.children.get(i).measure(ctx, Constraints { min_w: 0.0f32, min_h: 0.0f32, max_w: origin.w, max_h: origin.h })
      self.children.get_mut(i).layout(ctx, Rect { x: x, y: origin.y, w: m.w, h: origin.h })
      x = x + m.w + self.gap
      i = i + 1
    end
  end

  def event(inout self: Row, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
    let mut i = 0
    while i < self.children.len() do
      self.children.get_mut(i).event(ctx, evt, ectx)
      i = i + 1
    end
  end

  def paint(self: Row, ctx: UiCtx, inout out: PaintList) -> Unit
    let mut i = 0
    while i < self.children.len() do
      self.children.get(i).paint(ctx, out)
      i = i + 1
    end
  end

  def semantics(self: Row) -> String
    "row".to_string()
  end
end

struct Column
  _id: UiId
  children: Vec[Box[Widget]]
  gap: f32
  _rect: Rect
end

def column(children: Vec[Box[Widget]], gap: f32) -> Column
  Column { _id: _gen_id(), children: children, gap: gap, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for Column
  def id(self: Column) -> UiId
    self._id
  end

  def measure(self: Column, ctx: UiCtx, c: Constraints) -> Measure
    let mut max_w = 0.0f32
    let mut total_h = 0.0f32
    let mut i = 0
    while i < self.children.len() do
      let m = self.children.get(i).measure(ctx, c)
      if m.w > max_w then max_w = m.w end
      total_h = total_h + m.h
      i = i + 1
    end
    let gaps = if self.children.len() > 1 then self.gap * ((self.children.len() - 1) as f32) else 0.0f32 end
    Measure { w: max_w, h: total_h + gaps }
  end

  def layout(inout self: Column, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
    let mut y = origin.y
    let mut i = 0
    while i < self.children.len() do
      let m = self.children.get(i).measure(ctx, Constraints { min_w: 0.0f32, min_h: 0.0f32, max_w: origin.w, max_h: origin.h })
      self.children.get_mut(i).layout(ctx, Rect { x: origin.x, y: y, w: origin.w, h: m.h })
      y = y + m.h + self.gap
      i = i + 1
    end
  end

  def event(inout self: Column, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
    let mut i = 0
    while i < self.children.len() do
      self.children.get_mut(i).event(ctx, evt, ectx)
      i = i + 1
    end
  end

  def paint(self: Column, ctx: UiCtx, inout out: PaintList) -> Unit
    let mut i = 0
    while i < self.children.len() do
      self.children.get(i).paint(ctx, out)
      i = i + 1
    end
  end

  def semantics(self: Column) -> String
    "column".to_string()
  end
end

struct Grid
  _id: UiId
  children: Vec[Box[Widget]]
  cols: Int
  gap: f32
  _rect: Rect
end

def grid(children: Vec[Box[Widget]], cols: Int, gap: f32) -> Grid
  Grid { _id: _gen_id(), children: children, cols: cols, gap: gap, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for Grid
  def id(self: Grid) -> UiId
    self._id
  end

  def measure(self: Grid, ctx: UiCtx, c: Constraints) -> Measure
    let col_w = (c.max_w - self.gap * ((self.cols - 1) as f32)) / (self.cols as f32)
    let mut row_h = 0.0f32
    let mut i = 0
    let rows = (self.children.len() + self.cols - 1) / self.cols
    while i < self.children.len() do
      let m = self.children.get(i).measure(ctx, Constraints { min_w: 0.0f32, min_h: 0.0f32, max_w: col_w, max_h: c.max_h })
      if m.h > row_h then row_h = m.h end
      i = i + 1
    end
    let total_h = row_h * (rows as f32) + self.gap * ((rows - 1) as f32)
    Measure { w: c.max_w, h: total_h }
  end

  def layout(inout self: Grid, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
    let col_w = (origin.w - self.gap * ((self.cols - 1) as f32)) / (self.cols as f32)
    let row_h = 30.0f32  # Default cell height; adaptive in production
    let mut i = 0
    while i < self.children.len() do
      let r = i / self.cols
      let c = i % self.cols
      let cx = origin.x + (c as f32) * (col_w + self.gap)
      let cy = origin.y + (r as f32) * (row_h + self.gap)
      self.children.get_mut(i).layout(ctx, Rect { x: cx, y: cy, w: col_w, h: row_h })
      i = i + 1
    end
  end

  def event(inout self: Grid, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
    let mut i = 0
    while i < self.children.len() do
      self.children.get_mut(i).event(ctx, evt, ectx)
      i = i + 1
    end
  end

  def paint(self: Grid, ctx: UiCtx, inout out: PaintList) -> Unit
    let mut i = 0
    while i < self.children.len() do
      self.children.get(i).paint(ctx, out)
      i = i + 1
    end
  end

  def semantics(self: Grid) -> String
    "grid".to_string()
  end
end

struct Stack
  _id: UiId
  children: Vec[Box[Widget]]
  _rect: Rect
end

def stack(children: Vec[Box[Widget]]) -> Stack
  Stack { _id: _gen_id(), children: children, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for Stack
  def id(self: Stack) -> UiId
    self._id
  end

  def measure(self: Stack, ctx: UiCtx, c: Constraints) -> Measure
    let mut max_w = 0.0f32
    let mut max_h = 0.0f32
    let mut i = 0
    while i < self.children.len() do
      let m = self.children.get(i).measure(ctx, c)
      if m.w > max_w then max_w = m.w end
      if m.h > max_h then max_h = m.h end
      i = i + 1
    end
    Measure { w: max_w, h: max_h }
  end

  def layout(inout self: Stack, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
    let mut i = 0
    while i < self.children.len() do
      self.children.get_mut(i).layout(ctx, origin)
      i = i + 1
    end
  end

  def event(inout self: Stack, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
    # Top-to-bottom z-order; last child is on top.
    let mut i = self.children.len()
    while i > 0 do
      i = i - 1
      self.children.get_mut(i).event(ctx, evt, ectx)
    end
  end

  def paint(self: Stack, ctx: UiCtx, inout out: PaintList) -> Unit
    let mut i = 0
    while i < self.children.len() do
      self.children.get(i).paint(ctx, out)
      i = i + 1
    end
  end

  def semantics(self: Stack) -> String
    "stack".to_string()
  end
end

struct Scroll
  _id: UiId
  child: Box[Widget]
  scroll_x: f32
  scroll_y: f32
  _rect: Rect
end

def scroll(child: Box[Widget]) -> Scroll
  Scroll { _id: _gen_id(), child: child, scroll_x: 0.0f32, scroll_y: 0.0f32, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for Scroll
  def id(self: Scroll) -> UiId
    self._id
  end

  def measure(self: Scroll, ctx: UiCtx, c: Constraints) -> Measure
    # Scroll container takes all available space.
    Measure { w: c.max_w, h: c.max_h }
  end

  def layout(inout self: Scroll, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
    # Child can be larger; we layout with unconstrained height.
    let child_m = self.child.measure(ctx, Constraints { min_w: 0.0f32, min_h: 0.0f32, max_w: origin.w, max_h: 100000.0f32 })
    self.child.layout(ctx, Rect { x: origin.x - self.scroll_x, y: origin.y - self.scroll_y, w: origin.w, h: child_m.h })
  end

  def event(inout self: Scroll, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
    match evt
    when UiEvent::Scroll(dx, dy, _mode) then
      self.scroll_x = self.scroll_x + dx
      self.scroll_y = self.scroll_y + dy
      ectx.request_redraw = true
    else
      self.child.event(ctx, evt, ectx)
    end
  end

  def paint(self: Scroll, ctx: UiCtx, inout out: PaintList) -> Unit
    out.push_clip_rect(self._rect)
    self.child.paint(ctx, out)
    out.pop_clip()
  end

  def semantics(self: Scroll) -> String
    "scroll".to_string()
  end
end

# ─── Utility ──────────────────────────────────────────────────

struct Spacer
  _id: UiId
  w: f32
  h: f32
end

def spacer(w: f32, h: f32) -> Spacer
  Spacer { _id: _gen_id(), w: w, h: h }
end

impl Widget for Spacer
  def id(self: Spacer) -> UiId self._id end
  def measure(self: Spacer, ctx: UiCtx, c: Constraints) -> Measure
    Measure { w: self.w, h: self.h }
  end
  def layout(inout self: Spacer, ctx: UiCtx, origin: Rect) -> Unit end
  def event(inout self: Spacer, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit end
  def paint(self: Spacer, ctx: UiCtx, inout out: PaintList) -> Unit end
  def semantics(self: Spacer) -> String "spacer".to_string() end
end

struct Separator
  _id: UiId
  horizontal: Bool
  _rect: Rect
end

def separator(horizontal: Bool) -> Separator
  Separator { _id: _gen_id(), horizontal: horizontal, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for Separator
  def id(self: Separator) -> UiId self._id end

  def measure(self: Separator, ctx: UiCtx, c: Constraints) -> Measure
    if self.horizontal then Measure { w: c.max_w, h: 1.0f32 }
    else Measure { w: 1.0f32, h: c.max_h }
    end
  end

  def layout(inout self: Separator, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
  end

  def event(inout self: Separator, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit end

  def paint(self: Separator, ctx: UiCtx, inout out: PaintList) -> Unit
    let paint = Paint::solid(ctx.theme.fg)
    out.fill_rect(self._rect, paint)
  end

  def semantics(self: Separator) -> String "separator".to_string() end
end

# ─── Controls/Content ─────────────────────────────────────────

struct Label
  _id: UiId
  text: String
  style: TxtStyle
  _rect: Rect
end

def label(text: String, style: TxtStyle) -> Label
  Label { _id: _gen_id(), text: text, style: style, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for Label
  def id(self: Label) -> UiId self._id end

  def measure(self: Label, ctx: UiCtx, c: Constraints) -> Measure
    let char_w = self.style.size * 0.6
    let w = char_w * (self.text.len() as f32)
    Measure { w: w, h: self.style.size * 1.2 }
  end

  def layout(inout self: Label, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
  end

  def event(inout self: Label, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit end

  def paint(self: Label, ctx: UiCtx, inout out: PaintList) -> Unit
    # Emit a glyph run with reference shaper advance.
    use std::text
    let shape_result = text::shape(&ctx.font_db, self.text, self.style,
      text::default_shaping_opts())
    match shape_result
    when Result::Ok(run) then
      out.draw_glyph_run(run, self.style.color)
    when Result::Err(_) then
      # Fallback: no rendering if shaping fails.
    end
  end

  def semantics(self: Label) -> String self.text end
end

struct Button
  _id: UiId
  text: String
  on_click: Fn() -> Unit
  _rect: Rect
  _pressed: Bool
end

def button(text: String, on_click: Fn() -> Unit) -> Button
  Button { _id: _gen_id(), text: text, on_click: on_click, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 }, _pressed: false }
end

impl Widget for Button
  def id(self: Button) -> UiId self._id end

  def measure(self: Button, ctx: UiCtx, c: Constraints) -> Measure
    let pad = 16.0f32
    let char_w = 14.0f32 * 0.6   # Default font size ~14
    let w = char_w * (self.text.len() as f32) + pad * 2.0
    Measure { w: w, h: 32.0f32 }
  end

  def layout(inout self: Button, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
  end

  def event(inout self: Button, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
    match evt
    when UiEvent::PointerDown(x, y, _btn) then
      if _point_in_rect(x, y, &self._rect) then
        self._pressed = true
        ectx.request_redraw = true
      end
    when UiEvent::PointerUp(x, y, _btn) then
      if self._pressed && _point_in_rect(x, y, &self._rect) then
        (self.on_click)()
      end
      self._pressed = false
      ectx.request_redraw = true
    else end
  end

  def paint(self: Button, ctx: UiCtx, inout out: PaintList) -> Unit
    let bg_color = if self._pressed then ctx.theme.accent else ctx.theme.bg end
    let paint = Paint::solid(bg_color)
    let rr = RRect::new(self._rect, 4.0f32, 4.0f32)
    out.fill_rrect(rr, paint)
  end

  def semantics(self: Button) -> String self.text end
end

struct Textbox
  _id: UiId
  bind: String       # Mutable binding — caller updates via reference
  style: TxtStyle
  _rect: Rect
  _focused: Bool
  _cursor: Int
end

def textbox(bind: String, style: TxtStyle) -> Textbox
  Textbox { _id: _gen_id(), bind: bind, style: style, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 }, _focused: false, _cursor: 0 }
end

impl Widget for Textbox
  def id(self: Textbox) -> UiId self._id end

  def measure(self: Textbox, ctx: UiCtx, c: Constraints) -> Measure
    Measure { w: c.max_w, h: self.style.size * 1.5 + 8.0f32 }
  end

  def layout(inout self: Textbox, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
  end

  def event(inout self: Textbox, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
    match evt
    when UiEvent::PointerDown(x, y, _btn) then
      if _point_in_rect(x, y, &self._rect) then
        self._focused = true
        ectx.set_focus = Option::Some(self._id)
        ectx.request_redraw = true
      else
        self._focused = false
      end
    when UiEvent::TextInput(s) then
      if self._focused then
        self.bind = self.bind + s
        self._cursor = self.bind.len()
        ectx.request_redraw = true
      end
    when UiEvent::KeyDown(key, _mods) then
      if self._focused then
        match key
        when Key::Backspace then
          if self.bind.len() > 0 then
            self.bind = self.bind.slice(0, self.bind.len() - 1)
            self._cursor = self.bind.len()
            ectx.request_redraw = true
          end
        else end
      end
    else end
  end

  def paint(self: Textbox, ctx: UiCtx, inout out: PaintList) -> Unit
    # Border
    use std::gfx::{StrokeCap, StrokeJoin, Dash}
    let border_paint = Paint::solid(ctx.theme.fg)
    let border_stroke = Stroke {
      width: 1.0f32,
      cap: StrokeCap::Butt,
      join: StrokeJoin::Miter,
      miter_limit: 4.0f32,
      dash: Option::None,
    }
    out.stroke_rect(self._rect, border_paint, border_stroke)

    # Text content
    use std::text
    let shape_result = text::shape(&ctx.font_db, self.bind, self.style,
      text::default_shaping_opts())
    match shape_result
    when Result::Ok(run) then
      out.draw_glyph_run(run, self.style.color)
    when Result::Err(_) then end
  end

  def semantics(self: Textbox) -> String "textbox: " + self.bind end
end

struct Toggle
  _id: UiId
  value: Bool
  label_text: String
  _rect: Rect
end

def toggle(value: Bool, label_text: String) -> Toggle
  Toggle { _id: _gen_id(), value: value, label_text: label_text, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for Toggle
  def id(self: Toggle) -> UiId self._id end

  def measure(self: Toggle, ctx: UiCtx, c: Constraints) -> Measure
    Measure { w: 60.0f32 + (self.label_text.len() as f32) * 8.0f32, h: 24.0f32 }
  end

  def layout(inout self: Toggle, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
  end

  def event(inout self: Toggle, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
    match evt
    when UiEvent::PointerUp(x, y, _btn) then
      if _point_in_rect(x, y, &self._rect) then
        self.value = !self.value
        ectx.request_redraw = true
      end
    else end
  end

  def paint(self: Toggle, ctx: UiCtx, inout out: PaintList) -> Unit
    let bg = if self.value then ctx.theme.accent else ctx.theme.bg end
    let paint = Paint::solid(bg)
    let toggle_rect = Rect { x: self._rect.x, y: self._rect.y, w: 40.0f32, h: 20.0f32 }
    let rr = RRect::new(toggle_rect, 10.0f32, 10.0f32)
    out.fill_rrect(rr, paint)
  end

  def semantics(self: Toggle) -> String
    let state = if self.value then "on" else "off" end
    "toggle " + self.label_text + ": " + state
  end
end

struct Slider
  _id: UiId
  value: f32
  min: f32
  max: f32
  _rect: Rect
  _dragging: Bool
end

def slider(value: f32, min: f32, max: f32) -> Slider
  Slider { _id: _gen_id(), value: value, min: min, max: max, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 }, _dragging: false }
end

impl Widget for Slider
  def id(self: Slider) -> UiId self._id end

  def measure(self: Slider, ctx: UiCtx, c: Constraints) -> Measure
    Measure { w: c.max_w, h: 24.0f32 }
  end

  def layout(inout self: Slider, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
  end

  def event(inout self: Slider, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit
    match evt
    when UiEvent::PointerDown(x, y, _btn) then
      if _point_in_rect(x, y, &self._rect) then
        self._dragging = true
        _slider_update_value(self, x)
        ectx.request_redraw = true
      end
    when UiEvent::PointerMove(x, y) then
      if self._dragging then
        _slider_update_value(self, x)
        ectx.request_redraw = true
      end
    when UiEvent::PointerUp(_x, _y, _btn) then
      self._dragging = false
    else end
  end

  def paint(self: Slider, ctx: UiCtx, inout out: PaintList) -> Unit
    # Track
    mut track_paint = Paint::solid(ctx.theme.fg)
    track_paint.opacity = 0.3f32
    let track_rect = Rect { x: self._rect.x, y: self._rect.y + 8.0f32, w: self._rect.w, h: 4.0f32 }
    out.fill_rect(track_rect, track_paint)

    # Thumb
    let ratio = (self.value - self.min) / (self.max - self.min)
    let thumb_x = self._rect.x + ratio * (self._rect.w - 12.0f32)
    let thumb_paint = Paint::solid(ctx.theme.accent)
    let thumb_rr = RRect::new(
      Rect { x: thumb_x, y: self._rect.y + 4.0f32, w: 12.0f32, h: 12.0f32 },
      6.0f32,
      6.0f32
    )
    out.fill_rrect(thumb_rr, thumb_paint)
  end

  def semantics(self: Slider) -> String
    "slider: " + self.value.to_string()
  end
end

def _slider_update_value(inout s: Slider, x: f32) -> Unit
  let mut ratio = (x - s._rect.x) / s._rect.w
  if ratio < 0.0f32 then ratio = 0.0f32 end
  if ratio > 1.0f32 then ratio = 1.0f32 end
  s.value = s.min + ratio * (s.max - s.min)
end

struct ImageView
  _id: UiId
  img: Image
  fit: ImageFit
  _rect: Rect
end

def image_view(img: Image, fit: ImageFit) -> ImageView
  ImageView { _id: _gen_id(), img: img, fit: fit, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for ImageView
  def id(self: ImageView) -> UiId self._id end

  def measure(self: ImageView, ctx: UiCtx, c: Constraints) -> Measure
    Measure { w: c.max_w, h: c.max_h }
  end

  def layout(inout self: ImageView, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
  end

  def event(inout self: ImageView, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit end

  def paint(self: ImageView, ctx: UiCtx, inout out: PaintList) -> Unit
    # Compute destination rect based on ImageFit.
    let dst = self._rect  # Fill mode by default
    out.draw_image(self.img, dst, 1.0f32)
  end

  def semantics(self: ImageView) -> String "image".to_string() end
end

struct CanvasWidget
  _id: UiId
  draw_fn: Fn(&mut Canvas, Rect) -> Unit
  _rect: Rect
end

def canvas(draw_fn: Fn(&mut Canvas, Rect) -> Unit) -> CanvasWidget
  CanvasWidget { _id: _gen_id(), draw_fn: draw_fn, _rect: Rect { x: 0.0f32, y: 0.0f32, w: 0.0f32, h: 0.0f32 } }
end

impl Widget for CanvasWidget
  def id(self: CanvasWidget) -> UiId self._id end

  def measure(self: CanvasWidget, ctx: UiCtx, c: Constraints) -> Measure
    Measure { w: c.max_w, h: c.max_h }
  end

  def layout(inout self: CanvasWidget, ctx: UiCtx, origin: Rect) -> Unit
    self._rect = origin
  end

  def event(inout self: CanvasWidget, ctx: UiCtx, evt: UiEvent, inout ectx: EventCtx) -> Unit end

  def paint(self: CanvasWidget, ctx: UiCtx, inout out: PaintList) -> Unit
    # Canvas widget delegates drawing to the user-provided closure.
    # The PaintList will flush before custom canvas drawing in the compositor.
    # For v0.1, we mark the area and the compositor handles it.
    out.push_clip_rect(self._rect)
    out.pop_clip()
  end

  def semantics(self: CanvasWidget) -> String "canvas".to_string() end
end

# ═══════════════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════════════

def _point_in_rect(x: f32, y: f32, r: Rect) -> Bool
  x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h
end
