# ═══════════════════════════════════════════════════════════════
# iOS Device Information
# ═══════════════════════════════════════════════════════════════

def get_ios_device_name() -> String
  @cfg(target_os = "ios")
  return "iOS Device"
  
  @cfg(not(target_os = "ios"))
  return ""
end

def get_ios_version() -> String
  @cfg(target_os = "ios")
  return "iOS"
  
  @cfg(not(target_os = "ios"))
  return ""
end

def get_ios_model() -> String
  @cfg(target_os = "ios")
  return "iPhone"
  
  @cfg(not(target_os = "ios"))
  return ""
end

def is_ios_device() -> Bool
  @cfg(target_os = "ios")
  return true
  
  @cfg(not(target_os = "ios"))
  return false
end

def is_ipad() -> Bool
  @cfg(target_os = "ios")
  return false
  
  @cfg(not(target_os = "ios"))
  return false
end
