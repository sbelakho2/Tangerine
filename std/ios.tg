# ═══════════════════════════════════════════════════════════════
# Core Location
# ═══════════════════════════════════════════════════════════════

struct CLLocationCoordinate2D
  latitude: Float64
  longitude: Float64
end

struct CLLocation
  coordinate: CLLocationCoordinate2D
  altitude: Float64
  horizontal_accuracy: Float64
  vertical_accuracy: Float64
  timestamp: Float64
end

@cfg(target_os = "ios")
@ffi("CoreLocation")
extern def CLLocationManager_StartUpdatingLocation(mgr: Ptr) -> Unit
end

@cfg(target_os = "ios")
