# Tangerine Standard Library — std::ios
# iOS platform bindings
# Note: Most iOS functionality is covered by std::cocoa (UIKit)
# This file provides additional iOS-specific functionality

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, Ptr}
use std::collections::{Map}
use std::cocoa

# ═══════════════════════════════════════════════════════════════
# iOS-Specific Types (UIKit extensions)
# ═══════════════════════════════════════════════════════════════

# Note: UIKit types are defined in std::cocoa
# This file adds iOS-specific extensions

