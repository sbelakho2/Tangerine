## std::wasi — WebAssembly System Interface (WASI preview1) guest surface
## The guest-side declarations of the wasi_snapshot_preview1 imports and the
## ABI-safe wrappers over them (the fd_read / fd_write / fd_close /
## clock_time_get / proc_exit core set, plus the args/environ pair).
##
## The wasm-target wiring: a wasm32-wasi compile (--target wasm32-wasi)
## adds the wasi_snapshot_preview1 imports to the module's import section
## (tg_compiler/wasm_target.tg add_wasi_imports); the host-side
## implementations of the same ABI live in the compiler runtime
## (tg_compiler/runtime.tg emit_wasi_host_runtime — the _tg_wasi_fd_write /
## _tg_wasi_fd_read / _tg_wasi_fd_close / _tg_wasi_clock_time_get /
## _tg_wasi_proc_exit functions), so a Tangerine HOST embedding the wasm
## target provides the identical ABI surface, and the wasmtime --dir
## conformance lane exercises the module against the real WASI runtime.
##
## Spec: §stdlib.wasi

module std::wasi

use std::core::{Option, Result, Unit, Bool, Int, UInt, String, i32, i64}

# ═══════════════════════════════════════════════════════════════════════
# §1  The preview1 errno surface (the import result codes)
# ═══════════════════════════════════════════════════════════════════════

## The WASI preview1 errno codes the ABI returns (0 = success).
pub enum Errno
  Success
  ArgumentListTooLong
  BadFileDescriptor
  Busy
  CrossDeviceLink
  FileExists
  FileTooLarge
  InvalidArgument
  IoError
  IsDirectory
  NotDirectory
  NoEntry
  NoSpace
  NotSupported
  PermissionDenied
  Other(i32)
end

impl Errno
  ## Map a raw wasi errno integer to the typed code.
  pub def from_raw(code: i32) -> Errno
    if code == 0 then Errno::Success
    elsif code == 28 then Errno::ArgumentListTooLong
    elsif code == 8 then Errno::BadFileDescriptor
    elsif code == 16 then Errno::Busy
    elsif code == 18 then Errno::CrossDeviceLink
    elsif code == 17 then Errno::FileExists
    elsif code == 27 then Errno::FileTooLarge
    elsif code == 22 then Errno::InvalidArgument
    elsif code == 5 then Errno::IoError
    elsif code == 21 then Errno::IsDirectory
    elsif code == 20 then Errno::NotDirectory
    elsif code == 2 then Errno::NoEntry
    elsif code == 28 then Errno::NoSpace
    elsif code == 95 then Errno::NotSupported
    elsif code == 13 then Errno::PermissionDenied
    else Errno::Other(code)
    end
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §2  The iovec wire format (the preview1 {base, len} pair)
# ═══════════════════════════════════════════════════════════════════════

## One scatter/gather entry: the 16-byte {base: u64, len: u64} wire image.
pub struct Iovec
  pub base: Ptr[u8]
  pub len: UInt
end

impl Iovec
  pub def new(ptr: Ptr[u8], length: UInt) -> Iovec
    Iovec { base: ptr, len: length }
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §3  The wasi_snapshot_preview1 imports
# ═══════════════════════════════════════════════════════════════════════

## The clock ids the clock_time_get import accepts.
pub enum ClockId
  Realtime
  Monotonic
  ProcessCpuTime
  ThreadCpuTime
end

impl ClockId
  pub def raw(self) -> i32
    match self
    when Realtime then 0
    when Monotonic then 1
    when ProcessCpuTime then 2
    when ThreadCpuTime then 3
    end
  end
end

extern def fd_write(fd: i32, iovs: Ptr[Iovec], iovs_len: Int, nwritten: PtrMut[i32]) -> i32
extern def fd_read(fd: i32, iovs: Ptr[Iovec], iovs_len: Int, nread: PtrMut[i32]) -> i32
extern def fd_close(fd: i32) -> i32
extern def clock_time_get(clock_id: i32, precision: i64, time: PtrMut[i64]) -> i32
extern def proc_exit(code: i32) -> !
extern def args_get(argv: Ptr, argv_buf: Ptr) -> i32
extern def args_sizes_get(argc: PtrMut[Int], argv_buf_size: PtrMut[Int]) -> i32

# ═══════════════════════════════════════════════════════════════════════
# §4  The ABI wrappers
# ═══════════════════════════════════════════════════════════════════════

## Write the given bytes to the standard output (fd 1) through fd_write.
## Returns the raw errno (0 = success).
pub def write_stdout(data: Ptr[u8], len: UInt) -> i32
  var iovs = Iovec::new(data, len)
  var nwritten: i32 = 0
  fd_write(1, &iovs, 1, &mut nwritten)
end

## Write a string to the standard output (fd 1) through fd_write.
pub def print_str(s: str) -> i32
  let bytes = s.as_bytes()
  write_stdout(bytes.as_ptr(), bytes.len() as UInt)
end

## Write the given bytes to the standard error (fd 2) through fd_write.
pub def write_stderr(data: Ptr[u8], len: UInt) -> i32
  var iovs = Iovec::new(data, len)
  var nwritten: i32 = 0
  fd_write(2, &iovs, 1, &mut nwritten)
end

## Read up to `len` bytes from the standard input (fd 0) through fd_read.
## Returns the raw errno (0 = success; nread receives the byte count).
pub def read_stdin(buf: PtrMut[u8], len: UInt, inout nread: i32) -> i32
  var iovs = Iovec::new(buf as Ptr[u8], len)
  fd_read(0, &iovs, 1, &mut nread)
end

## Close a file descriptor through fd_close. Returns the raw errno.
pub def close(fd: i32) -> i32
  fd_close(fd)
end

## Read a clock's value in nanoseconds through clock_time_get.
## Returns the raw errno (0 = success; the ns value lands in `out`).
pub def clock_time_get_ns(clock: ClockId, precision: i64, out: PtrMut[i64]) -> i32
  clock_time_get(clock.raw(), precision, out)
end

## Terminate the process with the given exit code through proc_exit.
pub def exit(code: i32) -> !
  proc_exit(code)
end

## The exit-code contract used by `tg run` / wasmtime: 0 = success.
pub def success() -> i32 = 0

# ═══════════════════════════════════════════════════════════════════════
# §5  The host-side ABI note (the runtime's wasi surface)
# ═══════════════════════════════════════════════════════════════════════
# The host-side implementations of the same ABI are emitted into every
# native binary by the compiler runtime (the _tg_wasi_fd_write /
# _tg_wasi_fd_read / _tg_wasi_fd_close / _tg_wasi_clock_time_get /
# _tg_wasi_proc_exit symbols — the iovec walk, the errno normalization,
# the clock_gettime-backed clock). A native Tangerine program can thus
# declare these externs and speak the preview1 ABI to its own runtime.

end ## module std::wasi
