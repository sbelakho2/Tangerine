## Tangerine Standard Library — std::audio
## Cross-Platform Audio Support
##
## Provides audio playback and recording capabilities:
## - Audio device enumeration and management
## - Audio buffer and sample format handling
## - Streaming audio playback
## - Audio recording/capture
## - 3D spatial audio
## - Audio effects and mixing

use std::collections::{Vec, Map}
use std::ffi::{Ptr, CString}
use std::core::{Option, Result}
use std::sync::{Mutex, Arc}
use std::thread::Thread
use std::time::Duration

# ———————————————————————————————————————————————————————————————
# Audio Types and Constants
# ———————————————————————————————————————————————————————————————

type AudioDeviceID = u32
type AudioStreamHandle = Ptr[u8]

pub const DEFAULT_SAMPLE_RATE: u32 = 44100
pub const DEFAULT_CHANNELS: u32 = 2
pub const DEFAULT_BUFFER_SIZE: u32 = 512

# ———————————————————————————————————————————————————————————————
# Enums
# ———————————————————————————————————————————————————————————————

pub enum SampleFormat
  when U8      # Unsigned 8-bit
  when I16     # Signed 16-bit
  when I24     # Signed 24-bit
  when I32     # Signed 32-bit
  when F32     # 32-bit float
  when F64     # 64-bit float
end

impl SampleFormat
  pub fn bytes_per_sample(self: &Self) -> u32
    match self
      when SampleFormat::U8 then 1
      when SampleFormat::I16 then 2
      when SampleFormat::I24 then 3
      when SampleFormat::I32 then 4
      when SampleFormat::F32 then 4
      when SampleFormat::F64 then 8
    end
  end
  
  pub fn bits_per_sample(self: &Self) -> u32
    self.bytes_per_sample() * 8
  end
end

pub enum AudioBackend
  when CoreAudio   # macOS/iOS
  when WASAPI      # Windows
  when PulseAudio  # Linux
  when ALSA        # Linux (alternative)
  when OSS         # BSD/Unix
  when OpenAL      # Cross-platform
  when WebAudio    # Browser
end

pub enum AudioDeviceType
  when Input     # Microphone/capture
  when Output    # Speaker/playback
  when Duplex    # Both input and output
end

pub enum AudioState
  when Stopped
  when Playing
  when Paused
  when Recording
end

pub enum SeekMode
  when Start
  when Current
  when End
end

pub enum AudioError
  when DeviceNotFound
  when DeviceBusy
  when InvalidFormat
  when BufferOverflow
  when BufferUnderflow
  when StreamError
  when UnsupportedOperation
  when OutOfMemory
  when PermissionDenied
end

pub enum DistanceModel
  when None
  when InverseDistance
  when InverseDistanceClamped
  when LinearDistance
  when LinearDistanceClamped
  when ExponentDistance
  when ExponentDistanceClamped
end

pub enum AttenuationModel
  when None
  when InverseSquare
  when Linear
  when Exponential
end

# ———————————————————————————————————————————————————————————————
# Audio Format
# ———————————————————————————————————————————————————————————————

pub struct AudioFormat
  sample_rate: u32
  channels: u32
  sample_format: SampleFormat
  buffer_size: u32
end

impl AudioFormat
  pub def new(sample_rate: u32, channels: u32, sample_format: SampleFormat) -> AudioFormat
    AudioFormat {
      sample_rate: sample_rate,
      channels: channels,
      sample_format: sample_format,
      buffer_size: DEFAULT_BUFFER_SIZE
    }
  end
  
  pub fn cd_quality() -> AudioFormat
    AudioFormat::new(44100, 2, SampleFormat::I16)
  end
  
  pub fn dvd_quality() -> AudioFormat
    AudioFormat::new(48000, 2, SampleFormat::I16)
  end
  
  pub fn high_res() -> AudioFormat
    AudioFormat::new(96000, 2, SampleFormat::F32)
  end
  
  pub fn mono() -> AudioFormat
    AudioFormat::new(44100, 1, SampleFormat::I16)
  end
  
  pub fn stereo() -> AudioFormat
    AudioFormat::new(44100, 2, SampleFormat::I16)
  end
  
  pub fn bytes_per_frame(self: &Self) -> u32
    self.sample_format.bytes_per_sample() * self.channels
  end
  
  pub fn bytes_per_second(self: &Self) -> u32
    self.bytes_per_frame() * self.sample_rate
  end
  
  pub fn duration_from_bytes(self: &Self, bytes: u64) -> Duration
    let frames = bytes / self.bytes_per_frame() as u64
    let secs = frames / self.sample_rate as u64
    let nanos = (frames % self.sample_rate as u64) * 1_000_000_000 / self.sample_rate as u64
    Duration::new(secs, nanos as u32)
  end
  
  pub fn bytes_from_duration(self: &Self, duration: Duration) -> u64
    let total_nanos = duration.as_secs() * 1_000_000_000 + duration.subsec_nanos() as u64
    let total_samples = total_nanos * self.sample_rate as u64 / 1_000_000_000
    total_samples * self.bytes_per_frame() as u64
  end
end

# ———————————————————————————————————————————————————————————————
# Audio Device
# ———————————————————————————————————————————————————————————————

pub struct AudioDeviceInfo
  id: AudioDeviceID
  name: String
  device_type: AudioDeviceType
  is_default: Bool
  supported_formats: Vec[AudioFormat]
  min_channels: u32
  max_channels: u32
  min_sample_rate: u32
  max_sample_rate: u32
end

impl AudioDeviceInfo
  pub fn id(self: &Self) -> AudioDeviceID
    self.id
  end
  
  pub fn name(self: &Self) -> &String
    &self.name
  end
  
  pub fn device_type(self: &Self) -> AudioDeviceType
    self.device_type
  end
  
  pub fn is_default(self: &Self) -> Bool
    self.is_default
  end
  
  pub fn supports_format(self: &Self, format: &AudioFormat) -> Bool
    if format.channels < self.min_channels || format.channels > self.max_channels then
      return false
    end
    if format.sample_rate < self.min_sample_rate || format.sample_rate > self.max_sample_rate then
      return false
    end
    true
  end
end

# ———————————————————————————————————————————————————————————————
# Audio System
# ———————————————————————————————————————————————————————————————

pub struct AudioSystem
  backend: AudioBackend
  initialized: Bool
end

impl AudioSystem
  pub def init() -> Result[AudioSystem, String]
    let mut backend: AudioBackend = AudioBackend::CoreAudio
    
    unsafe "audio init" do
      let result = audio_system_init()
      if result != 0 then
        return Result::Err("Failed to initialize audio system")
      end
      
      # Detect backend
      backend = match audio_get_backend()
        when 0 then AudioBackend::CoreAudio
        when 1 then AudioBackend::WASAPI
        when 2 then AudioBackend::PulseAudio
        when 3 then AudioBackend::ALSA
        when 4 then AudioBackend::OpenAL
        when 5 then AudioBackend::WebAudio
        else AudioBackend::CoreAudio
      end
    end
    
    Result::Ok(AudioSystem {
      backend: backend,
      initialized: true
    })
  end
  
  pub fn backend(self: &Self) -> AudioBackend
    self.backend
  end
  
  pub fn is_initialized(self: &Self) -> Bool
    self.initialized
  end
  
  pub def enumerate_input_devices(self: &Self) -> Vec[AudioDeviceInfo]
    let mut devices: Vec[AudioDeviceInfo] = Vec::new()
    
    unsafe "audio enumerate input" do
      let count = audio_get_input_device_count()
      for i in 0..count do
        let info = audio_get_input_device_info(i)
        devices.push(AudioDeviceInfo {
          id: info.id,
          name: String::from_cstr(info.name),
          device_type: AudioDeviceType::Input,
          is_default: info.is_default != 0,
          supported_formats: Vec::new(),
          min_channels: info.min_channels,
          max_channels: info.max_channels,
          min_sample_rate: info.min_sample_rate,
          max_sample_rate: info.max_sample_rate
        })
      end
    end
    
    devices
  end
  
  pub def enumerate_output_devices(self: &Self) -> Vec[AudioDeviceInfo]
    let mut devices: Vec[AudioDeviceInfo] = Vec::new()
    
    unsafe "audio enumerate output" do
      let count = audio_get_output_device_count()
      for i in 0..count do
        let info = audio_get_output_device_info(i)
        devices.push(AudioDeviceInfo {
          id: info.id,
          name: String::from_cstr(info.name),
          device_type: AudioDeviceType::Output,
          is_default: info.is_default != 0,
          supported_formats: Vec::new(),
          min_channels: info.min_channels,
          max_channels: info.max_channels,
          min_sample_rate: info.min_sample_rate,
          max_sample_rate: info.max_sample_rate
        })
      end
    end
    
    devices
  end
  
  pub def get_default_input_device(self: &Self) -> Option[AudioDeviceInfo]
    unsafe "audio get default input" do
      let info = audio_get_default_input_device()
      if info.id == 0 then
        Option::None
      else
        Option::Some(AudioDeviceInfo {
          id: info.id,
          name: String::from_cstr(info.name),
          device_type: AudioDeviceType::Input,
          is_default: true,
          supported_formats: Vec::new(),
          min_channels: info.min_channels,
          max_channels: info.max_channels,
          min_sample_rate: info.min_sample_rate,
          max_sample_rate: info.max_sample_rate
        })
      end
    end
  end
  
  pub def get_default_output_device(self: &Self) -> Option[AudioDeviceInfo]
    unsafe "audio get default output" do
      let info = audio_get_default_output_device()
      if info.id == 0 then
        Option::None
      else
        Option::Some(AudioDeviceInfo {
          id: info.id,
          name: String::from_cstr(info.name),
          device_type: AudioDeviceType::Output,
          is_default: true,
          supported_formats: Vec::new(),
          min_channels: info.min_channels,
          max_channels: info.max_channels,
          min_sample_rate: info.min_sample_rate,
          max_sample_rate: info.max_sample_rate
        })
      end
    end
  end
  
  pub def create_player(self: &Self, device: &AudioDeviceInfo, format: &AudioFormat) -> Result[AudioPlayer, String]
    let mut handle: AudioStreamHandle = Ptr::null()
    
    unsafe "audio create player" do
      handle = audio_create_player(
        device.id,
        format.sample_rate,
        format.channels,
        format.sample_format as u32,
        format.buffer_size
      )
      if handle.is_null() then
        return Result::Err("Failed to create audio player")
      end
    end
    
    Result::Ok(AudioPlayer {
      handle: handle,
      format: format.clone(),
      state: AudioState::Stopped,
      volume: 1.0,
      pan: 0.0
    })
  end
  
  pub def create_recorder(self: &Self, device: &AudioDeviceInfo, format: &AudioFormat) -> Result[AudioRecorder, String]
    let mut handle: AudioStreamHandle = Ptr::null()
    
    unsafe "audio create recorder" do
      handle = audio_create_recorder(
        device.id,
        format.sample_rate,
        format.channels,
        format.sample_format as u32,
        format.buffer_size
      )
      if handle.is_null() then
        return Result::Err("Failed to create audio recorder")
      end
    end
    
    Result::Ok(AudioRecorder {
      handle: handle,
      format: format.clone(),
      state: AudioState::Stopped
    })
  end
  
  pub def shutdown(self: &mut Self) -> Unit
    if self.initialized then
      unsafe "audio shutdown" do
        audio_system_shutdown()
      end
      self.initialized = false
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Audio Buffer
# ———————————————————————————————————————————————————————————————

pub struct AudioBuffer
  data: Vec[u8]
  format: AudioFormat
  duration: Duration
end

impl AudioBuffer
  pub def new(format: &AudioFormat, frames: u32) -> AudioBuffer
    let bytes = frames * format.bytes_per_frame()
    AudioBuffer {
      data: Vec::with_capacity(bytes),
      format: format.clone(),
      duration: Duration::from_millis(frames as u64 * 1000 / format.sample_rate as u64)
    }
  end
  
  pub fn from_samples_f32(samples: &Vec[f32], channels: u32, sample_rate: u32) -> AudioBuffer
    let format = AudioFormat::new(sample_rate, channels, SampleFormat::F32)
    let bytes = samples.len() * 4
    let mut data: Vec[u8] = Vec::with_capacity(bytes)
    
    unsafe "audio buffer from f32" do
      memcpy(data.as_mut_ptr(), samples.as_ptr() as Ptr[u8], bytes)
    end
    
    let frames = samples.len() / channels as usize
    AudioBuffer {
      data: data,
      format: format,
      duration: Duration::from_millis(frames as u64 * 1000 / sample_rate as u64)
    }
  end
  
  pub fn from_samples_i16(samples: &Vec[i16], channels: u32, sample_rate: u32) -> AudioBuffer
    let format = AudioFormat::new(sample_rate, channels, SampleFormat::I16)
    let bytes = samples.len() * 2
    let mut data: Vec[u8] = Vec::with_capacity(bytes)
    
    unsafe "audio buffer from i16" do
      memcpy(data.as_mut_ptr(), samples.as_ptr() as Ptr[u8], bytes)
    end
    
    let frames = samples.len() / channels as usize
    AudioBuffer {
      data: data,
      format: format,
      duration: Duration::from_millis(frames as u64 * 1000 / sample_rate as u64)
    }
  end
  
  pub fn data(self: &Self) -> &Vec[u8]
    &self.data
  end
  
  pub fn data_mut(self: &mut Self) -> &mut Vec[u8]
    &mut self.data
  end
  
  pub fn format(self: &Self) -> &AudioFormat
    &self.format
  end
  
  pub fn duration(self: &Self) -> Duration
    self.duration
  end
  
  pub fn frames(self: &Self) -> u32
    self.data.len() / self.format.bytes_per_frame() as usize
  end
  
  pub fn samples(self: &Self) -> u32
    self.frames() * self.format.channels
  end
  
  pub fn as_f32(self: &Self) -> Vec[f32]
    let mut result: Vec[f32] = Vec::with_capacity(self.samples() as usize)
    
    match self.format.sample_format
      when SampleFormat::F32 then
        unsafe "audio buffer as f32 direct" do
          memcpy(result.as_mut_ptr(), self.data.as_ptr(), self.data.len())
          result.set_len(self.samples() as usize)
        end
      when SampleFormat::I16 then
        let samples_i16 = unsafe { self.data.as_ptr() as *const i16 }
        for i in 0..self.samples() as usize do
          let sample = unsafe { *samples_i16.add(i) }
          result.push(sample as f32 / 32768.0)
        end
      when SampleFormat::U8 then
        for i in 0..self.samples() as usize do
          let sample = self.data[i] as f32
          result.push((sample - 128.0) / 128.0)
        end
      else
        # Unsupported conversion
    end
    
    result
  end
  
  pub fn as_i16(self: &Self) -> Vec[i16]
    let mut result: Vec[i16] = Vec::with_capacity(self.samples() as usize)
    
    match self.format.sample_format
      when SampleFormat::I16 then
        unsafe "audio buffer as i16 direct" do
          memcpy(result.as_mut_ptr(), self.data.as_ptr(), self.data.len())
          result.set_len(self.samples() as usize)
        end
      when SampleFormat::F32 then
        let samples_f32 = unsafe { self.data.as_ptr() as *const f32 }
        for i in 0..self.samples() as usize do
          let sample = unsafe { *samples_f32.add(i) }
          let clamped = sample.clamp(-1.0, 1.0)
          result.push((clamped * 32767.0) as i16)
        end
      else
        # Unsupported conversion
    end
    
    result
  end
  
  pub fn silence(self: &mut Self) -> Unit
    for i in 0..self.data.len() do
      self.data[i] = 0
    end
  end
  
  pub fn convert_to(self: &Self, format: &AudioFormat) -> AudioBuffer
    # Simple resampling and format conversion
    let samples_f32 = self.as_f32()
    let src_channels = self.format.channels
    let dst_channels = format.channels
    let ratio = self.format.sample_rate as f64 / format.sample_rate as f64
    
    let dst_frames = (self.frames() as f64 / ratio) as usize
    let dst_samples = dst_frames * dst_channels as usize
    
    let mut converted: Vec[f32] = Vec::with_capacity(dst_samples)
    
    # Channel conversion
    if src_channels == dst_channels then
      # Linear interpolation resampling
      for i in 0..dst_frames do
        let src_idx = (i as f64 * ratio) as usize * src_channels as usize
        for c in 0..dst_channels as usize do
          if src_idx + c < samples_f32.len() then
            converted.push(samples_f32[src_idx + c])
          else
            converted.push(0.0)
          end
        end
      end
    else if src_channels == 1 && dst_channels == 2 then
      # Mono to stereo
      for i in 0..dst_frames do
        let src_idx = (i as f64 * ratio) as usize
        let sample = if src_idx < samples_f32.len() then samples_f32[src_idx] else 0.0 end
        converted.push(sample)
        converted.push(sample)
      end
    else if src_channels == 2 && dst_channels == 1 then
      # Stereo to mono
      for i in 0..dst_frames do
        let src_idx = (i as f64 * ratio) as usize * 2
        let left = if src_idx < samples_f32.len() then samples_f32[src_idx] else 0.0 end
        let right = if src_idx + 1 < samples_f32.len() then samples_f32[src_idx + 1] else 0.0 end
        converted.push((left + right) / 2.0)
      end
    end
    end
    
    AudioBuffer::from_samples_f32(&converted, dst_channels, format.sample_rate)
  end
  
  pub fn mix(self: &mut Self, other: &AudioBuffer, offset_frames: u32) -> Unit
    let offset_bytes = offset_frames as usize * self.format.bytes_per_frame() as usize
    let mix_len = min(self.data.len(), offset_bytes + other.data.len())
    
    if self.format.sample_format == SampleFormat::F32 && other.format.sample_format == SampleFormat::F32 then
      let dst = unsafe { self.data.as_mut_ptr().add(offset_bytes) as *mut f32 }
      let src = unsafe { other.data.as_ptr() as *const f32 }
      let samples = (mix_len - offset_bytes) / 4
      
      for i in 0..samples do
        unsafe do
          let mixed = *dst.add(i) + *src.add(i)
          *dst.add(i) = mixed.clamp(-1.0, 1.0)
        end
      end
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Audio Player
# ———————————————————————————————————————————————————————————————

pub struct AudioPlayer
  handle: AudioStreamHandle
  format: AudioFormat
  state: AudioState
  volume: f32
  pan: f32
end

impl AudioPlayer
  pub fn state(self: &Self) -> AudioState
    self.state
  end
  
  pub fn volume(self: &Self) -> f32
    self.volume
  end
  
  pub fn pan(self: &Self) -> f32
    self.pan
  end
  
  pub fn format(self: &Self) -> &AudioFormat
    &self.format
  end
  
  pub def set_volume(self: &mut Self, volume: f32) -> Unit
    self.volume = volume.clamp(0.0, 1.0)
    unsafe "audio set volume" do
      audio_set_volume(self.handle, self.volume)
    end
  end
  
  pub def set_pan(self: &mut Self, pan: f32) -> Unit
    self.pan = pan.clamp(-1.0, 1.0)
    unsafe "audio set pan" do
      audio_set_pan(self.handle, self.pan)
    end
  end
  
  pub def queue_buffer(self: &mut Self, buffer: &AudioBuffer) -> Result[Unit, String]
    let converted = if buffer.format.sample_rate != self.format.sample_rate 
                    || buffer.format.channels != self.format.channels then
      buffer.convert_to(&self.format)
    else
      buffer.clone()
    end
    
    unsafe "audio queue buffer" do
      let result = audio_queue_buffer(
        self.handle,
        converted.data.as_ptr(),
        converted.data.len()
      )
      if result != 0 then
        return Result::Err("Failed to queue audio buffer")
      end
    end
    
    Result::Ok(())
  end
  
  pub def play(self: &mut Self) -> Result[Unit, String]
    unsafe "audio play" do
      let result = audio_play(self.handle)
      if result != 0 then
        return Result::Err("Failed to start playback")
      end
    end
    self.state = AudioState::Playing
    Result::Ok(())
  end
  
  pub def pause(self: &mut Self) -> Unit
    unsafe "audio pause" do
      audio_pause(self.handle)
    end
    self.state = AudioState::Paused
  end
  
  pub def stop(self: &mut Self) -> Unit
    unsafe "audio stop" do
      audio_stop(self.handle)
    end
    self.state = AudioState::Stopped
  end
  
  pub fn queued_buffer_count(self: &Self) -> u32
    unsafe "audio queued count" do
      audio_get_queued_buffer_count(self.handle)
    end
  end
  
  pub fn available_buffer_space(self: &Self) -> u32
    unsafe "audio available space" do
      audio_get_available_buffer_space(self.handle)
    end
  end
  
  pub fn latency(self: &Self) -> Duration
    unsafe "audio latency" do
      let ms = audio_get_latency(self.handle)
      Duration::from_millis(ms)
    end
  end
  
  pub def flush(self: &mut Self) -> Unit
    unsafe "audio flush" do
      audio_flush(self.handle)
    end
  end
  
  pub def destroy(self: &mut Self) -> Unit
    if !self.handle.is_null() then
      unsafe "audio destroy player" do
        audio_destroy_player(self.handle)
      end
      self.handle = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Audio Recorder
# ———————————————————————————————————————————————————————————————

pub struct AudioRecorder
  handle: AudioStreamHandle
  format: AudioFormat
  state: AudioState
end

impl AudioRecorder
  pub fn state(self: &Self) -> AudioState
    self.state
  end
  
  pub fn format(self: &Self) -> &AudioFormat
    &self.format
  end
  
  pub def start(self: &mut Self) -> Result[Unit, String]
    unsafe "audio record start" do
      let result = audio_recorder_start(self.handle)
      if result != 0 then
        return Result::Err("Failed to start recording")
      end
    end
    self.state = AudioState::Recording
    Result::Ok(())
  end
  
  pub def stop(self: &mut Self) -> Unit
    unsafe "audio record stop" do
      audio_recorder_stop(self.handle)
    end
    self.state = AudioState::Stopped
  end
  
  pub def read_buffer(self: &mut Self, frames: u32) -> Option[AudioBuffer]
    let bytes = frames * self.format.bytes_per_frame()
    let mut buffer: Vec[u8] = Vec::with_capacity(bytes)
    
    unsafe "audio read buffer" do
      let read = audio_read_buffer(
        self.handle,
        buffer.as_mut_ptr(),
        bytes
      )
      if read == 0 then
        return Option::None
      end
      buffer.set_len(read)
    end
    
    Option::Some(AudioBuffer {
      data: buffer,
      format: self.format.clone(),
      duration: self.format.duration_from_bytes(bytes as u64)
    })
  end
  
  pub fn available_frames(self: &Self) -> u32
    unsafe "audio available frames" do
      audio_get_available_frames(self.handle)
    end
  end
  
  pub def destroy(self: &mut Self) -> Unit
    if !self.handle.is_null() then
      unsafe "audio destroy recorder" do
        audio_destroy_recorder(self.handle)
      end
      self.handle = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Sound (One-shot playback)
# ———————————————————————————————————————————————————————————————

pub struct Sound
  buffer: AudioBuffer
  volume: f32
  loop_enabled: Bool
end

impl Sound
  pub def from_file(path: &String) -> Result[Sound, String]
    let mut format: AudioFormat = AudioFormat::stereo()
    let mut data: Vec[u8] = Vec::new()
    
    unsafe "sound from file" do
      let mut sample_rate: u32 = 44100
      let mut channels: u32 = 2
      let mut sample_format: u32 = 1  # I16
      
      let result = audio_load_file(
        path.as_ptr(),
        &mut sample_rate,
        &mut channels,
        &mut sample_format,
        data.as_mut_ptr(),
        data.capacity()
      )
      
      if result <= 0 then
        return Result::Err("Failed to load audio file")
      end
      
      format = AudioFormat::new(
        sample_rate,
        channels,
        match sample_format
          when 0 then SampleFormat::U8
          when 1 then SampleFormat::I16
          when 2 then SampleFormat::I32
          when 3 then SampleFormat::F32
          else SampleFormat::I16
        end
      )
      data.set_len(result)
    end
    
    let bytes = data.len()
    let frames = bytes / format.bytes_per_frame() as usize
    
    Result::Ok(Sound {
      buffer: AudioBuffer {
        data: data,
        format: format,
        duration: Duration::from_millis(frames as u64 * 1000 / format.sample_rate as u64)
      },
      volume: 1.0,
      loop_enabled: false
    })
  end
  
  pub fn from_buffer(buffer: AudioBuffer) -> Sound
    Sound {
      buffer: buffer,
      volume: 1.0,
      loop_enabled: false
    }
  end
  
  pub fn duration(self: &Self) -> Duration
    self.buffer.duration()
  end
  
  pub fn buffer(self: &Self) -> &AudioBuffer
    &self.buffer
  end
  
  pub fn volume(self: &Self) -> f32
    self.volume
  end
  
  pub def set_volume(self: &mut Self, volume: f32) -> Unit
    self.volume = volume.clamp(0.0, 1.0)
  end
  
  pub fn is_looping(self: &Self) -> Bool
    self.loop_enabled
  end
  
  pub def set_looping(self: &mut Self, enabled: Bool) -> Unit
    self.loop_enabled = enabled
  end
end

# ———————————————————————————————————————————————————————————————
# Audio File I/O
# ———————————————————————————————————————————————————————————————

pub struct AudioFileLoader end

impl AudioFileLoader
  pub def load_wav(path: &String) -> Result[AudioBuffer, String]
    let mut format: AudioFormat = AudioFormat::stereo()
    let mut data: Vec[u8] = Vec::new()
    
    unsafe "audio load wav" do
      let mut sample_rate: u32 = 44100
      let mut channels: u32 = 2
      let mut bits_per_sample: u16 = 16
      
      let result = audio_load_wav(
        path.as_ptr(),
        &mut sample_rate,
        &mut channels,
        &mut bits_per_sample,
        data.as_mut_ptr(),
        data.capacity()
      )
      
      if result <= 0 then
        return Result::Err("Failed to load WAV file")
      end
      
      let sample_format = match bits_per_sample
        when 8 then SampleFormat::U8
        when 16 then SampleFormat::I16
        when 24 then SampleFormat::I24
        when 32 then SampleFormat::I32
        else SampleFormat::I16
      end
      
      format = AudioFormat::new(sample_rate, channels, sample_format)
      data.set_len(result)
    end
    
    let frames = data.len() / format.bytes_per_frame() as usize
    
    Result::Ok(AudioBuffer {
      data: data,
      format: format,
      duration: Duration::from_millis(frames as u64 * 1000 / format.sample_rate as u64)
    })
  end
  
  pub def load_ogg(path: &String) -> Result[AudioBuffer, String]
    let mut format: AudioFormat = AudioFormat::stereo()
    let mut data: Vec[u8] = Vec::new()
    
    unsafe "audio load ogg" do
      let mut sample_rate: u32 = 44100
      let mut channels: u32 = 2
      
      let result = audio_load_ogg(
        path.as_ptr(),
        &mut sample_rate,
        &mut channels,
        data.as_mut_ptr(),
        data.capacity()
      )
      
      if result <= 0 then
        return Result::Err("Failed to load OGG file")
      end
      
      format = AudioFormat::new(sample_rate, channels, SampleFormat::I16)
      data.set_len(result)
    end
    
    let frames = data.len() / format.bytes_per_frame() as usize
    
    Result::Ok(AudioBuffer {
      data: data,
      format: format,
      duration: Duration::from_millis(frames as u64 * 1000 / format.sample_rate as u64)
    })
  end
  
  pub def load_mp3(path: &String) -> Result[AudioBuffer, String]
    let mut format: AudioFormat = AudioFormat::stereo()
    let mut data: Vec[u8] = Vec::new()
    
    unsafe "audio load mp3" do
      let mut sample_rate: u32 = 44100
      let mut channels: u32 = 2
      
      let result = audio_load_mp3(
        path.as_ptr(),
        &mut sample_rate,
        &mut channels,
        data.as_mut_ptr(),
        data.capacity()
      )
      
      if result <= 0 then
        return Result::Err("Failed to load MP3 file")
      end
      
      format = AudioFormat::new(sample_rate, channels, SampleFormat::I16)
      data.set_len(result)
    end
    
    let frames = data.len() / format.bytes_per_frame() as usize
    
    Result::Ok(AudioBuffer {
      data: data,
      format: format,
      duration: Duration::from_millis(frames as u64 * 1000 / format.sample_rate as u64)
    })
  end
  
  pub def load_flac(path: &String) -> Result[AudioBuffer, String]
    let mut format: AudioFormat = AudioFormat::stereo()
    let mut data: Vec[u8] = Vec::new()
    
    unsafe "audio load flac" do
      let mut sample_rate: u32 = 44100
      let mut channels: u32 = 2
      let mut bits_per_sample: u32 = 16
      
      let result = audio_load_flac(
        path.as_ptr(),
        &mut sample_rate,
        &mut channels,
        &mut bits_per_sample,
        data.as_mut_ptr(),
        data.capacity()
      )
      
      if result <= 0 then
        return Result::Err("Failed to load FLAC file")
      end
      
      let sample_format = match bits_per_sample
        when 16 then SampleFormat::I16
        when 24 then SampleFormat::I24
        when 32 then SampleFormat::I32
        else SampleFormat::I16
      end
      
      format = AudioFormat::new(sample_rate, channels, sample_format)
      data.set_len(result)
    end
    
    let frames = data.len() / format.bytes_per_frame() as usize
    
    Result::Ok(AudioBuffer {
      data: data,
      format: format,
      duration: Duration::from_millis(frames as u64 * 1000 / format.sample_rate as u64)
    })
  end
  
  pub def save_wav(path: &String, buffer: &AudioBuffer) -> Result[Unit, String]
    unsafe "audio save wav" do
      let result = audio_save_wav(
        path.as_ptr(),
        buffer.format.sample_rate,
        buffer.format.channels,
        buffer.format.sample_format as u32,
        buffer.data.as_ptr(),
        buffer.data.len()
      )
      
      if result != 0 then
        return Result::Err("Failed to save WAV file")
      end
    end
    Result::Ok(())
  end
end

# ———————————————————————————————————————————————————————————————
# 3D Spatial Audio
# ———————————————————————————————————————————————————————————————

pub struct AudioListener
  position: Vec3
  velocity: Vec3
  forward: Vec3
  up: Vec3
  gain: f32
end

impl AudioListener
  pub def new() -> AudioListener
    AudioListener {
      position: Vec3::zero(),
      velocity: Vec3::zero(),
      forward: Vec3::new(0.0, 0.0, -1.0),
      up: Vec3::new(0.0, 1.0, 0.0),
      gain: 1.0
    }
  end
  
  pub fn position(self: &Self) -> &Vec3
    &self.position
  end
  
  pub fn velocity(self: &Self) -> &Vec3
    &self.velocity
  end
  
  pub fn forward(self: &Self) -> &Vec3
    &self.forward
  end
  
  pub fn up(self: &Self) -> &Vec3
    &self.up
  end
  
  pub fn gain(self: &Self) -> f32
    self.gain
  end
  
  pub def set_position(self: &mut Self, pos: Vec3) -> Unit
    self.position = pos
    unsafe "audio listener set position" do
      audio_listener_set_position(pos.x, pos.y, pos.z)
    end
  end
  
  pub def set_velocity(self: &mut Self, vel: Vec3) -> Unit
    self.velocity = vel
    unsafe "audio listener set velocity" do
      audio_listener_set_velocity(vel.x, vel.y, vel.z)
    end
  end
  
  pub def set_orientation(self: &mut Self, forward: Vec3, up: Vec3) -> Unit
    self.forward = forward
    self.up = up
    unsafe "audio listener set orientation" do
      audio_listener_set_orientation(
        forward.x, forward.y, forward.z,
        up.x, up.y, up.z
      )
    end
  end
  
  pub def set_gain(self: &mut Self, gain: f32) -> Unit
    self.gain = gain
    unsafe "audio listener set gain" do
      audio_listener_set_gain(gain)
    end
  end
end

pub struct SpatialSoundSource
  handle: Ptr[u8]
  position: Vec3
  velocity: Vec3
  gain: f32
  pitch: f32
  reference_distance: f32
  max_distance: f32
  rolloff_factor: f32
  looping: Bool
end

impl SpatialSoundSource
  pub def create(buffer: &AudioBuffer) -> Result[SpatialSoundSource, String]
    let mut handle: Ptr[u8] = Ptr::null()
    
    unsafe "spatial source create" do
      handle = audio_spatial_source_create(
        buffer.format.sample_rate,
        buffer.format.channels,
        buffer.data.as_ptr(),
        buffer.data.len()
      )
      if handle.is_null() then
        return Result::Err("Failed to create spatial sound source")
      end
    end
    
    Result::Ok(SpatialSoundSource {
      handle: handle,
      position: Vec3::zero(),
      velocity: Vec3::zero(),
      gain: 1.0,
      pitch: 1.0,
      reference_distance: 1.0,
      max_distance: 1000.0,
      rolloff_factor: 1.0,
      looping: false
    })
  end
  
  pub fn position(self: &Self) -> &Vec3
    &self.position
  end
  
  pub fn velocity(self: &Self) -> &Vec3
    &self.velocity
  end
  
  pub fn gain(self: &Self) -> f32
    self.gain
  end
  
  pub fn pitch(self: &Self) -> f32
    self.pitch
  end
  
  pub fn is_looping(self: &Self) -> Bool
    self.looping
  end
  
  pub def set_position(self: &mut Self, pos: Vec3) -> Unit
    self.position = pos
    unsafe "spatial source set position" do
      audio_spatial_source_set_position(self.handle, pos.x, pos.y, pos.z)
    end
  end
  
  pub def set_velocity(self: &mut Self, vel: Vec3) -> Unit
    self.velocity = vel
    unsafe "spatial source set velocity" do
      audio_spatial_source_set_velocity(self.handle, vel.x, vel.y, vel.z)
    end
  end
  
  pub def set_gain(self: &mut Self, gain: f32) -> Unit
    self.gain = gain
    unsafe "spatial source set gain" do
      audio_spatial_source_set_gain(self.handle, gain)
    end
  end
  
  pub def set_pitch(self: &mut Self, pitch: f32) -> Unit
    self.pitch = pitch
    unsafe "spatial source set pitch" do
      audio_spatial_source_set_pitch(self.handle, pitch)
    end
  end
  
  pub def set_distance_model(self: &mut Self, ref_dist: f32, max_dist: f32, rolloff: f32) -> Unit
    self.reference_distance = ref_dist
    self.max_distance = max_dist
    self.rolloff_factor = rolloff
    unsafe "spatial source set distance model" do
      audio_spatial_source_set_distance_model(self.handle, ref_dist, max_dist, rolloff)
    end
  end
  
  pub def set_looping(self: &mut Self, looping: Bool) -> Unit
    self.looping = looping
    unsafe "spatial source set looping" do
      audio_spatial_source_set_looping(self.handle, looping)
    end
  end
  
  pub def play(self: &mut Self) -> Unit
    unsafe "spatial source play" do
      audio_spatial_source_play(self.handle)
    end
  end
  
  pub def pause(self: &mut Self) -> Unit
    unsafe "spatial source pause" do
      audio_spatial_source_pause(self.handle)
    end
  end
  
  pub def stop(self: &mut Self) -> Unit
    unsafe "spatial source stop" do
      audio_spatial_source_stop(self.handle)
    end
  end
  
  pub fn is_playing(self: &Self) -> Bool
    unsafe "spatial source is playing" do
      audio_spatial_source_is_playing(self.handle) != 0
    end
  end
  
  pub def destroy(self: &mut Self) -> Unit
    if !self.handle.is_null() then
      unsafe "spatial source destroy" do
        audio_spatial_source_destroy(self.handle)
      end
      self.handle = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Audio Mixer
# ———————————————————————————————————————————————————————————————

pub struct AudioMixer
  master_volume: f32
  channels: Vec[MixerChannel]
end

pub struct MixerChannel
  name: String
  volume: f32
  muted: Bool
  solo: Bool
end

impl AudioMixer
  pub def new() -> AudioMixer
    AudioMixer {
      master_volume: 1.0,
      channels: Vec::new()
    }
  end
  
  pub fn master_volume(self: &Self) -> f32
    self.master_volume
  end
  
  pub def set_master_volume(self: &mut Self, volume: f32) -> Unit
    self.master_volume = volume.clamp(0.0, 1.0)
    unsafe "audio mixer set master" do
      audio_mixer_set_master_volume(self.master_volume)
    end
  end
  
  pub def add_channel(self: &mut Self, name: String) -> u32
    let id = self.channels.len() as u32
    self.channels.push(MixerChannel {
      name: name,
      volume: 1.0,
      muted: false,
      solo: false
    })
    unsafe "audio mixer add channel" do
      audio_mixer_add_channel(id)
    end
    id
  end
  
  pub def set_channel_volume(self: &mut Self, channel: u32, volume: f32) -> Unit
    if channel < self.channels.len() as u32 then
      self.channels[channel].volume = volume.clamp(0.0, 1.0)
      unsafe "audio mixer channel volume" do
        audio_mixer_set_channel_volume(channel, self.channels[channel].volume)
      end
    end
  end
  
  pub def mute_channel(self: &mut Self, channel: u32) -> Unit
    if channel < self.channels.len() as u32 then
      self.channels[channel].muted = true
      unsafe "audio mixer mute channel" do
        audio_mixer_set_channel_muted(channel, true)
      end
    end
  end
  
  pub def unmute_channel(self: &mut Self, channel: u32) -> Unit
    if channel < self.channels.len() as u32 then
      self.channels[channel].muted = false
      unsafe "audio mixer unmute channel" do
        audio_mixer_set_channel_muted(channel, false)
      end
    end
  end
  
  pub fn channel_count(self: &Self) -> u32
    self.channels.len() as u32
  end
end

