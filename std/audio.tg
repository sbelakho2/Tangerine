  when LowPass
  when HighPass
  when BandPass
  when Notch
end

# ———————————————————————————————————————————————————————————————
# Vec3 for 3D Audio
# ———————————————————————————————————————————————————————————————

pub struct Vec3
  x: f32
  y: f32
  z: f32
end

impl Vec3
  pub fn zero() -> Vec3
    Vec3 { x: 0.0, y: 0.0, z: 0.0 }
  end
  
  pub fn new(x: f32, y: f32, z: f32) -> Vec3
    Vec3 { x: x, y: y, z: z }
  end
  
  pub fn magnitude(self: &Self) -> f32
    (self.x * self.x + self.y * self.y + self.z * self.z).sqrt()
  end
  
  pub fn normalized(self: &Self) -> Vec3
    let mag = self.magnitude()
    if mag > 0.0 then
      Vec3::new(self.x / mag, self.y / mag, self.z / mag)
    else
      Vec3::zero()
    end
  end
  
  pub fn dot(self: &Self, other: &Vec3) -> f32
    self.x * other.x + self.y * other.y + self.z * other.z
  end
  
  pub fn cross(self: &Self, other: &Vec3) -> Vec3
    Vec3::new(
      self.y * other.z - self.z * other.y,
      self.z * other.x - self.x * other.z,
      self.x * other.y - self.y * other.x
    )
  end
  
  pub fn distance(self: &Self, other: &Vec3) -> f32
    let dx = self.x - other.x
    let dy = self.y - other.y
    let dz = self.z - other.z
    (dx * dx + dy * dy + dz * dz).sqrt()
  end
end

