  def audio_get_output_device_info(index: u32) -> NativeAudioDeviceInfo
  def audio_get_default_input_device() -> NativeAudioDeviceInfo
  def audio_get_default_output_device() -> NativeAudioDeviceInfo
  
  # Player
  def audio_create_player(device_id: u32, sample_rate: u32, channels: u32, format: u32, buffer_size: u32) -> AudioStreamHandle
  def audio_destroy_player(handle: AudioStreamHandle) -> Unit
  def audio_play(handle: AudioStreamHandle) -> i32
  def audio_pause(handle: AudioStreamHandle) -> Unit
  def audio_stop(handle: AudioStreamHandle) -> Unit
  def audio_queue_buffer(handle: AudioStreamHandle, data: Ptr[u8], size: usize) -> i32
  def audio_set_volume(handle: AudioStreamHandle, volume: f32) -> Unit
  def audio_set_pan(handle: AudioStreamHandle, pan: f32) -> Unit
  def audio_get_queued_buffer_count(handle: AudioStreamHandle) -> u32
  def audio_get_available_buffer_space(handle: AudioStreamHandle) -> u32
  def audio_get_latency(handle: AudioStreamHandle) -> u64
  def audio_flush(handle: AudioStreamHandle) -> Unit
  
  # Recorder
  def audio_create_recorder(device_id: u32, sample_rate: u32, channels: u32, format: u32, buffer_size: u32) -> AudioStreamHandle
  def audio_destroy_recorder(handle: AudioStreamHandle) -> Unit
  def audio_recorder_start(handle: AudioStreamHandle) -> i32
  def audio_recorder_stop(handle: AudioStreamHandle) -> Unit
  def audio_read_buffer(handle: AudioStreamHandle, data: Ptr[u8], max_size: usize) -> usize
  def audio_get_available_frames(handle: AudioStreamHandle) -> u32
  
  # File I/O
  def audio_load_file(path: Ptr[u8], sample_rate: *mut u32, channels: *mut u32, format: *mut u32, data: Ptr[u8], max_size: usize) -> i64
  def audio_load_wav(path: Ptr[u8], sample_rate: *mut u32, channels: *mut u32, bits_per_sample: *mut u16, data: Ptr[u8], max_size: usize) -> i64
  def audio_load_ogg(path: Ptr[u8], sample_rate: *mut u32, channels: *mut u32, data: Ptr[u8], max_size: usize) -> i64
  def audio_load_mp3(path: Ptr[u8], sample_rate: *mut u32, channels: *mut u32, data: Ptr[u8], max_size: usize) -> i64
  def audio_load_flac(path: Ptr[u8], sample_rate: *mut u32, channels: *mut u32, bits_per_sample: *mut u32, data: Ptr[u8], max_size: usize) -> i64
  def audio_save_wav(path: Ptr[u8], sample_rate: u32, channels: u32, format: u32, data: Ptr[u8], size: usize) -> i32
  
  # 3D Audio - Listener
  def audio_listener_set_position(x: f32, y: f32, z: f32) -> Unit
  def audio_listener_set_velocity(x: f32, y: f32, z: f32) -> Unit
  def audio_listener_set_orientation(fx: f32, fy: f32, fz: f32, ux: f32, uy: f32, uz: f32) -> Unit
  def audio_listener_set_gain(gain: f32) -> Unit
  
  # 3D Audio - Source
  def audio_spatial_source_create(sample_rate: u32, channels: u32, data: Ptr[u8], size: usize) -> Ptr[u8]
  def audio_spatial_source_destroy(handle: Ptr[u8]) -> Unit
  def audio_spatial_source_set_position(handle: Ptr[u8], x: f32, y: f32, z: f32) -> Unit
  def audio_spatial_source_set_velocity(handle: Ptr[u8], x: f32, y: f32, z: f32) -> Unit
  def audio_spatial_source_set_gain(handle: Ptr[u8], gain: f32) -> Unit
  def audio_spatial_source_set_pitch(handle: Ptr[u8], pitch: f32) -> Unit
  def audio_spatial_source_set_distance_model(handle: Ptr[u8], ref_dist: f32, max_dist: f32, rolloff: f32) -> Unit
  def audio_spatial_source_set_looping(handle: Ptr[u8], looping: Bool) -> Unit
  def audio_spatial_source_play(handle: Ptr[u8]) -> Unit
  def audio_spatial_source_pause(handle: Ptr[u8]) -> Unit
  def audio_spatial_source_stop(handle: Ptr[u8]) -> Unit
  def audio_spatial_source_is_playing(handle: Ptr[u8]) -> i32
  
  # Mixer
  def audio_mixer_set_master_volume(volume: f32) -> Unit
  def audio_mixer_add_channel(id: u32) -> Unit
  def audio_mixer_set_channel_volume(id: u32, volume: f32) -> Unit
  def audio_mixer_set_channel_muted(id: u32, muted: Bool) -> Unit
  
  # Memory
  def memcpy(dst: Ptr[u8], src: Ptr[u8], size: u64) -> Unit
end

struct NativeAudioDeviceInfo
  id: u32
  name: Ptr[u8]
  is_default: i32
  min_channels: u32
  max_channels: u32
  min_sample_rate: u32
  max_sample_rate: u32
