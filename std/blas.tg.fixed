## Tangerine Standard Library — std::blas
## Basic Linear Algebra Subprograms
##
## Provides BLAS Level 1, 2, and 3 operations:
## - Level 1: Vector-vector operations
## - Level 2: Matrix-vector operations
## - Level 3: Matrix-matrix operations
## - SIMD-accelerated implementations

use std::collections::Vec
use std::simd::{f32x4, f64x2}
use std::math::{sqrt, abs}
use std::ffi::Ptr

# ———————————————————————————————————————————————————————————————
# BLAS Types
# ———————————————————————————————————————————————————————————————

pub enum Order
  when RowMajor
  when ColMajor
end

pub enum Transpose
  when NoTrans
  when Trans
  when ConjTrans
end

pub enum Uplo
  when Upper
  when Lower
end

pub enum Diag
  when NonUnit
  when Unit
end

pub enum Side
  when Left
  when Right
end

# ———————————————————————————————————————————————————————————————
# BLAS Level 1: Vector-Vector Operations
# ———————————————————————————————————————————————————————————————

# DOT: Dot product of two vectors
pub fn sdot(n: usize, x: &Vec[f32], incx: isize, y: &Vec[f32], incy: isize) -> f32
  if n == 0 then return 0.0 end
  
  let mut result: f32 = 0.0
  let mut ix: usize = 0
  let mut iy: usize = 0
  
  if incx < 0 then ix = ((-incx) as usize) * (n - 1) end
  if incy < 0 then iy = ((-incy) as usize) * (n - 1) end
  
  # SIMD path
  if incx == 1 && incy == 1 && n >= 4 then
    let mut sum = f32x4::splat(0.0)
    let chunks = n / 4
    for i in 0..chunks do
      let vx = f32x4::load(&x[i * 4])
      let vy = f32x4::load(&y[i * 4])
      sum = sum + vx * vy
    end
    result = sum.reduce_add()
    
    # Remainder
    for i in (chunks * 4)..n do
      result += x[i] * y[i]
    end
  else
    for i in 0..n do
      result += x[ix] * y[iy]
      ix = (ix as isize + incx) as usize
      iy = (iy as isize + incy) as usize
    end
  end
  
  result
end

pub fn ddot(n: usize, x: &Vec[f64], incx: isize, y: &Vec[f64], incy: isize) -> f64
  if n == 0 then return 0.0 end
  
  let mut result: f64 = 0.0
  let mut ix: usize = 0
  let mut iy: usize = 0
  
  if incx < 0 then ix = ((-incx) as usize) * (n - 1) end
  if incy < 0 then iy = ((-incy) as usize) * (n - 1) end
  
  # SIMD path
  if incx == 1 && incy == 1 && n >= 2 then
    let mut sum = f64x2::splat(0.0)
    let chunks = n / 2
    for i in 0..chunks do
      let vx = f64x2::load(&x[i * 2])
      let vy = f64x2::load(&y[i * 2])
      sum = sum + vx * vy
    end
    result = sum.reduce_add()
    
    # Remainder
    if n % 2 != 0 then
      result += x[n - 1] * y[n - 1]
    end
  else
    for i in 0..n do
      result += x[ix] * y[iy]
      ix = (ix as isize + incx) as usize
      iy = (iy as isize + incy) as usize
    end
  end
  
  result
end

# AXPY: Y = alpha * X + Y
pub fn saxpy(n: usize, alpha: f32, x: &Vec[f32], incx: isize, y: &mut Vec[f32], incy: isize)
  if n == 0 || alpha == 0.0 then return end
  
  let mut ix: usize = 0
  let mut iy: usize = 0
  
  if incx < 0 then ix = ((-incx) as usize) * (n - 1) end
  if incy < 0 then iy = ((-incy) as usize) * (n - 1) end
  
  if incx == 1 && incy == 1 && n >= 4 then
    let alpha_vec = f32x4::splat(alpha)
    let chunks = n / 4
    for i in 0..chunks do
      let vx = f32x4::load(&x[i * 4])
      let mut vy = f32x4::load(&y[i * 4])
      vy = vy + alpha_vec * vx
      vy.store(&mut y[i * 4])
    end
    
    for i in (chunks * 4)..n do
      y[i] += alpha * x[i]
    end
  else
    for i in 0..n do
      y[iy] += alpha * x[ix]
      ix = (ix as isize + incx) as usize
      iy = (iy as isize + incy) as usize
    end
  end
end

pub fn daxpy(n: usize, alpha: f64, x: &Vec[f64], incx: isize, y: &mut Vec[f64], incy: isize)
  if n == 0 || alpha == 0.0 then return end
  
  let mut ix: usize = 0
  let mut iy: usize = 0
  
  if incx < 0 then ix = ((-incx) as usize) * (n - 1) end
  if incy < 0 then iy = ((-incy) as usize) * (n - 1) end
  
  if incx == 1 && incy == 1 && n >= 2 then
    let alpha_vec = f64x2::splat(alpha)
    let chunks = n / 2
    for i in 0..chunks do
      let vx = f64x2::load(&x[i * 2])
      let mut vy = f64x2::load(&y[i * 2])
      vy = vy + alpha_vec * vx
      vy.store(&mut y[i * 2])
    end
    
    if n % 2 != 0 then
      y[n - 1] += alpha * x[n - 1]
    end
  else
    for i in 0..n do
      y[iy] += alpha * x[ix]
      ix = (ix as isize + incx) as usize
      iy = (iy as isize + incy) as usize
    end
  end
end

# SCAL: X = alpha * X
pub fn sscal(n: usize, alpha: f32, x: &mut Vec[f32], incx: isize)
  if n == 0 || alpha == 1.0 then return end
  
  if incx == 1 && n >= 4 then
    let alpha_vec = f32x4::splat(alpha)
    let chunks = n / 4
    for i in 0..chunks do
      let mut vx = f32x4::load(&x[i * 4])
      vx = alpha_vec * vx
      vx.store(&mut x[i * 4])
    end
    
    for i in (chunks * 4)..n do
      x[i] *= alpha
    end
  else
    let mut ix: usize = if incx < 0 then ((-incx) as usize) * (n - 1) else 0 end
    for i in 0..n do
      x[ix] *= alpha
      ix = (ix as isize + incx) as usize
    end
  end
end

pub fn dscal(n: usize, alpha: f64, x: &mut Vec[f64], incx: isize)
  if n == 0 || alpha == 1.0 then return end
  
  if incx == 1 && n >= 2 then
    let alpha_vec = f64x2::splat(alpha)
    let chunks = n / 2
    for i in 0..chunks do
      let mut vx = f64x2::load(&x[i * 2])
      vx = alpha_vec * vx
      vx.store(&mut x[i * 2])
    end
    
    if n % 2 != 0 then
      x[n - 1] *= alpha
    end
  else
    let mut ix: usize = if incx < 0 then ((-incx) as usize) * (n - 1) else 0 end
    for i in 0..n do
      x[ix] *= alpha
      ix = (ix as isize + incx) as usize
    end
  end
end

# NRM2: Euclidean norm
pub fn snrm2(n: usize, x: &Vec[f32], incx: isize) -> f32
  if n == 0 then return 0.0 end
  
  let mut sum: f32 = 0.0
  
  if incx == 1 && n >= 4 then
    let mut sum_vec = f32x4::splat(0.0)
    let chunks = n / 4
    for i in 0..chunks do
      let vx = f32x4::load(&x[i * 4])
      sum_vec = sum_vec + vx * vx
    end
    sum = sum_vec.reduce_add()
    
    for i in (chunks * 4)..n do
      sum += x[i] * x[i]
    end
  else
    let mut ix: usize = if incx < 0 then ((-incx) as usize) * (n - 1) else 0 end
    for i in 0..n do
      sum += x[ix] * x[ix]
      ix = (ix as isize + incx) as usize
    end
  end
  
  sqrt(sum)
end

pub fn dnrm2(n: usize, x: &Vec[f64], incx: isize) -> f64
  if n == 0 then return 0.0 end
  
  let mut sum: f64 = 0.0
  
  if incx == 1 && n >= 2 then
    let mut sum_vec = f64x2::splat(0.0)
    let chunks = n / 2
    for i in 0..chunks do
      let vx = f64x2::load(&x[i * 2])
      sum_vec = sum_vec + vx * vx
    end
    sum = sum_vec.reduce_add()
    
    if n % 2 != 0 then
      sum += x[n - 1] * x[n - 1]
    end
  else
    let mut ix: usize = if incx < 0 then ((-incx) as usize) * (n - 1) else 0 end
    for i in 0..n do
      sum += x[ix] * x[ix]
      ix = (ix as isize + incx) as usize
    end
  end
  
  sqrt(sum)
end

# ASUM: Sum of absolute values
pub fn sasum(n: usize, x: &Vec[f32], incx: isize) -> f32
  if n == 0 then return 0.0 end
  
  let mut sum: f32 = 0.0
  
  if incx == 1 && n >= 4 then
    let mut sum_vec = f32x4::splat(0.0)
    let chunks = n / 4
    for i in 0..chunks do
      let vx = f32x4::load(&x[i * 4])
      sum_vec = sum_vec + vx.abs()
    end
    sum = sum_vec.reduce_add()
    
    for i in (chunks * 4)..n do
      sum += abs(x[i])
    end
  else
    let mut ix: usize = if incx < 0 then ((-incx) as usize) * (n - 1) else 0 end
    for i in 0..n do
      sum += abs(x[ix])
      ix = (ix as isize + incx) as usize
    end
  end
  
  sum
end

# COPY: Copy vector
pub fn scopy(n: usize, x: &Vec[f32], incx: isize, y: &mut Vec[f32], incy: isize)
  if n == 0 then return end
  
  let mut ix: usize = 0
  let mut iy: usize = 0
  
  if incx < 0 then ix = ((-incx) as usize) * (n - 1) end
  if incy < 0 then iy = ((-incy) as usize) * (n - 1) end
  
  if incx == 1 && incy == 1 then
    for i in 0..n do
      y[i] = x[i]
    end
  else
    for i in 0..n do
      y[iy] = x[ix]
      ix = (ix as isize + incx) as usize
      iy = (iy as isize + incy) as usize
    end
  end
end

# SWAP: Swap vectors
pub fn sswap(n: usize, x: &mut Vec[f32], incx: isize, y: &mut Vec[f32], incy: isize)
  if n == 0 then return end
  
  let mut ix: usize = 0
  let mut iy: usize = 0
  
  if incx < 0 then ix = ((-incx) as usize) * (n - 1) end
  if incy < 0 then iy = ((-incy) as usize) * (n - 1) end
  
  for i in 0..n do
    let temp = x[ix]
    x[ix] = y[iy]
    y[iy] = temp
    ix = (ix as isize + incx) as usize
    iy = (iy as isize + incy) as usize
  end
end

# IAMAX: Index of max absolute value
pub fn isamax(n: usize, x: &Vec[f32], incx: isize) -> usize
  if n == 0 then return 0 end
  
  let mut ix: usize = if incx < 0 then ((-incx) as usize) * (n - 1) else 0 end
  let mut max_val = abs(x[ix])
  let mut max_idx = 0
  
  for i in 1..n do
    ix = (ix as isize + incx) as usize
    let val = abs(x[ix])
    if val > max_val then
      max_val = val
      max_idx = i
    end
  end
  
  max_idx
end

# ROT: Givens rotation
pub fn srot(n: usize, x: &mut Vec[f32], incx: isize, y: &mut Vec[f32], incy: isize, c: f32, s: f32)
  if n == 0 then return end
  
  let mut ix: usize = 0
  let mut iy: usize = 0
  
  if incx < 0 then ix = ((-incx) as usize) * (n - 1) end
  if incy < 0 then iy = ((-incy) as usize) * (n - 1) end
  
  for i in 0..n do
    let temp = c * x[ix] + s * y[iy]
    y[iy] = c * y[iy] - s * x[ix]
    x[ix] = temp
    ix = (ix as isize + incx) as usize
    iy = (iy as isize + incy) as usize
  end
end

# ROTG: Generate Givens rotation
pub fn srotg(a: &mut f32, b: &mut f32, c: &mut f32, s: &mut f32)
  let roe = if abs(*a) > abs(*b) then *a else *b
  let scale = abs(*a) + abs(*b)
  
  if scale == 0.0 then
    *c = 1.0
    *s = 0.0
    *a = 0.0
    *b = 0.0
  else
    let r = scale * sqrt((*a / scale) * (*a / scale) + (*b / scale) * (*b / scale))
    r = if roe < 0.0 then -r else r
    *c = *a / r
    *s = *b / r
    let z = if abs(*a) > abs(*b) then *s else 1.0
    let z = if *c != 0.0 then 1.0 / *c else z
    *a = r
    *b = z
  end
end

# ———————————————————————————————————————————————————————————————
# BLAS Level 2: Matrix-Vector Operations
# ———————————————————————————————————————————————————————————————

# GEMV: General matrix-vector multiplication
pub fn sgemv(trans: Transpose, m: usize, n: usize, alpha: f32, a: &Vec[f32], lda: usize, x: &Vec[f32], incx: isize, beta: f32, y: &mut Vec[f32], incy: isize)
  let len_y = match trans
    when Transpose::NoTrans then m
    when Transpose::Trans then n
    when Transpose::ConjTrans then n
  end
  
  # Scale y by beta
  if beta != 1.0 then
    let mut iy: usize = 0
    if incy < 0 then iy = ((-incy) as usize) * (len_y - 1) end
    for i in 0..len_y do
      y[iy] *= beta
      iy = (iy as isize + incy) as usize
    end
  end
  
  if alpha == 0.0 then return end
  
  match trans
    when Transpose::NoTrans then
      # y = alpha * A * x + y
      for i in 0..m do
        let mut temp: f32 = 0.0
        for j in 0..n do
          temp += a[i * lda + j] * x[j]
        end
        let iy = if incy > 0 then i * incy else (m - 1 - i) * ((-incy) as usize) end
        y[iy] += alpha * temp
      end
    when Transpose::Trans then
      # y = alpha * A^T * x + y
      for j in 0..n do
        let mut temp: f32 = 0.0
        for i in 0..m do
          temp += a[i * lda + j] * x[i]
        end
        let iy = if incy > 0 then j * incy else (n - 1 - j) * ((-incy) as usize) end
        y[iy] += alpha * temp
      end
    when Transpose::ConjTrans then
      # Same as Trans for real
      for j in 0..n do
        let mut temp: f32 = 0.0
        for i in 0..m do
          temp += a[i * lda + j] * x[i]
        end
        let iy = if incy > 0 then j * incy else (n - 1 - j) * ((-incy) as usize) end
        y[iy] += alpha * temp
      end
  end
end

# GER: General rank-1 update
pub fn sger(m: usize, n: usize, alpha: f32, x: &Vec[f32], incx: isize, y: &Vec[f32], incy: isize, a: &mut Vec[f32], lda: usize)
  if alpha == 0.0 then return end
  
  for i in 0..m do
    let ix = if incx > 0 then i * incx else (m - 1 - i) * ((-incx) as usize) end
    let temp = alpha * x[ix]
    for j in 0..n do
      let iy = if incy > 0 then j * incy else (n - 1 - j) * ((-incy) as usize) end
      a[i * lda + j] += temp * y[iy]
    end
  end
end

# SYMV: Symmetric matrix-vector multiplication
pub fn ssymv(uplo: Uplo, n: usize, alpha: f32, a: &Vec[f32], lda: usize, x: &Vec[f32], incx: isize, beta: f32, y: &mut Vec[f32], incy: isize)
  # Scale y
  if beta != 1.0 then
    let mut iy: usize = 0
    if incy < 0 then iy = ((-incy) as usize) * (n - 1) end
    for i in 0..n do
      y[iy] *= beta
      iy = (iy as isize + incy) as usize
    end
  end
  
  if alpha == 0.0 then return end
  
  match uplo
    when Uplo::Upper then
      for i in 0..n do
        let temp1 = alpha * x[if incx > 0 then i * incx else (n - 1 - i) * ((-incx) as usize) end]
        let mut temp2: f32 = 0.0
        for j in i..n do
          let jx = if incx > 0 then j * incx else (n - 1 - j) * ((-incx) as usize) end
          let jy = if incy > 0 then j * incy else (n - 1 - j) * ((-incy) as usize) end
          y[jy] += temp1 * a[i * lda + j]
          if j != i then
            temp2 += a[i * lda + j] * x[jx]
          end
        end
        let iy = if incy > 0 then i * incy else (n - 1 - i) * ((-incy) as usize) end
        y[iy] += alpha * temp2
      end
    when Uplo::Lower then
      for i in 0..n do
        let temp1 = alpha * x[if incx > 0 then i * incx else (n - 1 - i) * ((-incx) as usize) end]
        let mut temp2: f32 = 0.0
        for j in 0..=i do
          let jx = if incx > 0 then j * incx else (n - 1 - j) * ((-incx) as usize) end
          let jy = if incy > 0 then j * incy else (n - 1 - j) * ((-incy) as usize) end
          y[jy] += temp1 * a[i * lda + j]
          if j != i then
            temp2 += a[i * lda + j] * x[jx]
          end
        end
        let iy = if incy > 0 then i * incy else (n - 1 - i) * ((-incy) as usize) end
        y[iy] += alpha * temp2
      end
  end
end

# TRSV: Triangular solve
pub fn strsv(uplo: Uplo, trans: Transpose, diag: Diag, n: usize, a: &Vec[f32], lda: usize, x: &mut Vec[f32], incx: isize)
  if n == 0 then return end
  
  let nounit = match diag
    when Diag::NonUnit then true
    when Diag::Unit then false
  end
  
  match (uplo, trans)
    when (Uplo::Upper, Transpose::NoTrans) then
      let mut ix = if incx > 0 then (n - 1) * incx else 0 end
      for i in (0..n).rev() do
        if nounit then
          x[ix] /= a[i * lda + i]
        end
        let temp = x[ix]
        let mut jx = ix - incx
        for j in (0..i).rev() do
          x[jx] -= temp * a[i * lda + j]
          jx -= incx
        end
        ix -= incx
      end
    when (Uplo::Lower, Transpose::NoTrans) then
      let mut ix = 0
      for i in 0..n do
        if nounit then
          x[ix] /= a[i * lda + i]
        end
        let temp = x[ix]
        let mut jx = ix + incx
        for j in (i + 1)..n do
          x[jx] -= temp * a[i * lda + j]
          jx += incx
        end
        ix += incx
      end
    else
      # Handle other cases similarly
  end
end

