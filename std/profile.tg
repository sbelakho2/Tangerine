# Tangerine Standard Library — Profiling and Observability
#
# Performance profiling, flamegraph generation, frame timing for games/UI.
#
# Usage:
#   let profiler = Profiler::new()
#   profiler.start()
#   # ... code to profile ...
#   profiler.stop()
#   profiler.report()

use std::core::{Option, Result, Vec, String, Bool, Int, UInt}
use std::collections::{Map, Set}
use std::fs::{File}
use std::io::{Write, BufWriter}
use std::time::{Instant, Duration, SystemTime}
use std::thread::{ThreadId, spawn, thread_sleep}
use std::alloc::{tg_alloc, tg_free, size_of}

# ═══════════════════════════════════════════════════════════════
# PLATFORM-SPECIFIC SAMPLING EXTERN DECLARATIONS
# ═══════════════════════════════════════════════════════════════

# Linux: SIGPROF-based sampling via setitimer
#[cfg(target_os = "linux")]
extern "C"
  def setitimer(which: Int, new_value: Ptr[ITimerVal], old_value: Ptr[ITimerVal]) -> Int
  def sigaction(signum: Int, act: Ptr[SigAction], oldact: Ptr[SigAction]) -> Int
  def backtrace(buffer: Ptr[Ptr[u8]], size: Int) -> Int
  def backtrace_symbols(buffer: Ptr[Ptr[u8]], size: Int) -> Ptr[Ptr[u8]]
  def dladdr(addr: Ptr[u8], info: Ptr[DlInfo]) -> Int
  def pthread_self() -> u64
  def getpid() -> Int
end

#[cfg(target_os = "linux")]
struct ITimerVal
  it_interval_sec: i64
  it_interval_usec: i64
  it_value_sec: i64
  it_value_usec: i64
end

#[cfg(target_os = "linux")]
struct SigAction
  sa_handler: Ptr[u8]
  sa_mask: [u64; 16]
  sa_flags: Int
  sa_restorer: Ptr[u8]
end

#[cfg(target_os = "linux")]
struct DlInfo
  dli_fname: Ptr[u8]
  dli_fbase: Ptr[u8]
  dli_sname: Ptr[u8]
  dli_saddr: Ptr[u8]
end

#[cfg(target_os = "linux")]
def SIGPROF() -> Int = 27
def ITIMER_PROF() -> Int = 2
def SA_SIGINFO() -> Int = 4

# macOS: mach thread sampling via thread_get_state
#[cfg(target_os = "macos")]
extern "C"
  def mach_thread_self() -> u32
  def thread_get_state(thread: u32, flavor: Int, state: Ptr[u8], count: Ptr[u32]) -> Int
  def task_threads(task: u32, threads: Ptr[Ptr[u32]], count: Ptr[u32]) -> Int
  def mach_task_self() -> u32
  def backtrace(buffer: Ptr[Ptr[u8]], size: Int) -> Int
  def backtrace_symbols(buffer: Ptr[Ptr[u8]], size: Int) -> Ptr[Ptr[u8]]
  def dladdr(addr: Ptr[u8], info: Ptr[Dl_info]) -> Int
  def pthread_self() -> u64
  def getpid() -> Int
end

#[cfg(target_os = "macos")]
struct Dl_info
  dli_fname: Ptr[u8]
  dli_fbase: Ptr[u8]
  dli_sname: Ptr[u8]
  dli_saddr: Ptr[u8]
end

#[cfg(target_os = "macos")]
def x86_THREAD_STATE64() -> Int = 4
def ARM_THREAD_STATE64() -> Int = 6

# Windows: SuspendThread + GetThreadContext
#[cfg(target_os = "windows")]
extern "C"
  def GetCurrentThread() -> Ptr[u8]
  def GetCurrentThreadId() -> u32
  def GetCurrentProcessId() -> u32
  def SuspendThread(hThread: Ptr[u8]) -> u32
  def ResumeThread(hThread: Ptr[u8]) -> u32
  def GetThreadContext(hThread: Ptr[u8], lpContext: Ptr[CONTEXT]) -> Int
  def OpenThread(dwDesiredAccess: u32, bInheritHandle: Int, dwThreadId: u32) -> Ptr[u8]
  def CloseHandle(hObject: Ptr[u8]) -> Int
  def RtlCaptureStackBackTrace(FramesToSkip: u32, FramesToCapture: u32, BackTrace: Ptr[Ptr[u8]], BackTraceHash: Ptr[u32]) -> u16
  def SymFromAddr(hProcess: Ptr[u8], Address: u64, Displacement: Ptr[u64], Symbol: Ptr[SYMBOL_INFO]) -> Int
  def SymInitialize(hProcess: Ptr[u8], UserSearchPath: Ptr[u8], fInvadeProcess: Int) -> Int
  def GetCurrentProcess() -> Ptr[u8]
end

#[cfg(target_os = "windows")]
struct CONTEXT
  data: [u8; 1232]  # Full Windows CONTEXT structure
end

#[cfg(target_os = "windows")]
struct SYMBOL_INFO
  SizeOfStruct: u32
  TypeIndex: u32
  Reserved: [u64; 2]
  Index: u32
  Size: u32
  ModBase: u64
  Flags: u32
  Value: u64
  Address: u64
  Register: u32
  Scope: u32
  Tag: u32
  NameLen: u32
  MaxNameLen: u32
  Name: [u8; 256]
end

#[cfg(target_os = "windows")]
def THREAD_SUSPEND_RESUME() -> u32 = 0x0002
def THREAD_GET_CONTEXT() -> u32 = 0x0008
def CONTEXT_FULL() -> u32 = 0x10001F

# ═══════════════════════════════════════════════════════════════
# SAMPLING BACKEND
# ═══════════════════════════════════════════════════════════════

struct SamplingBackend
  running: Bool
  sample_interval_us: u64
  target_profiler: Ptr[Profiler]
end

mut SAMPLING_BACKEND: Option[SamplingBackend] = Option::None

#[cfg(target_os = "linux")]
def capture_stack_trace(max_depth: UInt) -> Vec[StackFrame]
  mut frames = Vec::new()
  mut buffer: [Ptr[u8]; 128] = [Ptr::null(); 128]
  let depth = max_depth.min(128) as Int
  
  let count = backtrace(&buffer[0], depth)
  
  mut i = 0
  while i < count do
    mut info = DlInfo {
      dli_fname: Ptr::null(),
      dli_fbase: Ptr::null(),
      dli_sname: Ptr::null(),
      dli_saddr: Ptr::null()
    }
    
    if dladdr(buffer[i], &info) != 0 && !info.dli_sname.is_null() then
      let fn_name = String::from_cstr(info.dli_sname)
      let module = if !info.dli_fname.is_null() then 
        String::from_cstr(info.dli_fname)
      else 
        "<unknown>"
      end
      
      frames.push(StackFrame {
        function_name: fn_name,
        module: module,
        file: "",
        line: 0,
        address: buffer[i] as u64
      })
    else
      frames.push(StackFrame {
        function_name: "<unknown>",
        module: "<unknown>",
        file: "",
        line: 0,
        address: buffer[i] as u64
      })
    end
    i = i + 1
  end
  
  frames
end

#[cfg(target_os = "macos")]
def capture_stack_trace(max_depth: UInt) -> Vec[StackFrame]
  mut frames = Vec::new()
  mut buffer: [Ptr[u8]; 128] = [Ptr::null(); 128]
  let depth = max_depth.min(128) as Int
  
  let count = backtrace(&buffer[0], depth)
  
  mut i = 0
  while i < count do
    mut info = Dl_info {
      dli_fname: Ptr::null(),
      dli_fbase: Ptr::null(),
      dli_sname: Ptr::null(),
      dli_saddr: Ptr::null()
    }
    
    if dladdr(buffer[i], &info) != 0 && !info.dli_sname.is_null() then
      let fn_name = String::from_cstr(info.dli_sname)
      let module = if !info.dli_fname.is_null() then 
        String::from_cstr(info.dli_fname)
      else 
        "<unknown>"
      end
      
      frames.push(StackFrame {
        function_name: fn_name,
        module: module,
        file: "",
        line: 0,
        address: buffer[i] as u64
      })
    else
