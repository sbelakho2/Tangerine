# Tangerine Standard Library — Time
#
# Time measurement and manipulation:
#   - Instant (monotonic clock for measurements)
#   - Duration
#   - SystemTime (wall clock)
#   - Date and time formatting
#   - Timers

use std::core::{Option, Result, panic}
use std::fmt::{format}

# ———————————————————————————————————————————————————————————————
# C Time API (extern)
# ———————————————————————————————————————————————————————————————

extern "C"
  # POSIX time functions
  def time(tloc: Ptr[i64]) -> i64
  def gettimeofday(tv: Ptr[TimeVal], tz: Ptr[u8]) -> Int
  def clock_gettime(clk_id: Int, tp: Ptr[TimeSpec]) -> Int
  def nanosleep(req: Ptr[TimeSpec], rem: Ptr[TimeSpec]) -> Int
  
  # Time conversion
  def localtime_r(timep: Ptr[i64], result: Ptr[Tm]) -> Ptr[Tm]
  def gmtime_r(timep: Ptr[i64], result: Ptr[Tm]) -> Ptr[Tm]
  def mktime(tm: Ptr[Tm]) -> i64
  def strftime(s: Ptr[u8], maxsize: UInt, format: Ptr[u8], tm: Ptr[Tm]) -> UInt
  def strptime(s: Ptr[u8], format: Ptr[u8], tm: Ptr[Tm]) -> Ptr[u8]
end

# Time structures
struct TimeVal
  tv_sec: i64
  tv_usec: i64
end

struct TimeSpec
  tv_sec: i64
  tv_nsec: i64
end

struct Tm
  tm_sec: Int      # Seconds [0, 60]
  tm_min: Int      # Minutes [0, 59]
  tm_hour: Int     # Hours [0, 23]
  tm_mday: Int     # Day of month [1, 31]
  tm_mon: Int      # Month [0, 11]
  tm_year: Int     # Years since 1900
  tm_wday: Int     # Day of week [0, 6] (Sunday = 0)
  tm_yday: Int     # Day of year [0, 365]
  tm_isdst: Int    # Daylight saving time flag
end

# Clock IDs (portable across Linux and macOS; may differ on other POSIX systems)
# These rely on clock_gettime() which is POSIX-only.
# TODO: add Windows QueryPerformanceCounter alternative when target_os = "windows".
def CLOCK_REALTIME()  -> Int = 0
def CLOCK_MONOTONIC() -> Int = 1

# ———————————————————————————————————————————————————————————————
# Duration
# ———————————————————————————————————————————————————————————————

struct Duration
  secs: u64
  nanos: u32   # Always less than 1_000_000_000
end

def NANOS_PER_SEC() -> u32 = 1_000_000_000
def NANOS_PER_MILLI() -> u32 = 1_000_000
def NANOS_PER_MICRO() -> u32 = 1_000
def MILLIS_PER_SEC() -> u64 = 1_000
def MICROS_PER_SEC() -> u64 = 1_000_000

def duration_zero() -> Duration
  Duration { secs: 0, nanos: 0 }
end

def duration_from_secs(secs: u64) -> Duration
  Duration { secs: secs, nanos: 0 }
end

def duration_from_millis(millis: u64) -> Duration
  Duration {
    secs: millis / MILLIS_PER_SEC(),
    nanos: ((millis % MILLIS_PER_SEC()) * NANOS_PER_MILLI() as u64) as u32
  }
end

def duration_from_micros(micros: u64) -> Duration
  Duration {
    secs: micros / MICROS_PER_SEC(),
    nanos: ((micros % MICROS_PER_SEC()) * NANOS_PER_MICRO() as u64) as u32
  }
end

def duration_from_nanos(nanos: u64) -> Duration
  Duration {
    secs: nanos / NANOS_PER_SEC() as u64,
    nanos: (nanos % NANOS_PER_SEC() as u64) as u32
  }
end

impl Duration
  def as_secs(self: &Duration) -> u64
    self.secs
  end
  
  def subsec_millis(self: &Duration) -> u32
    self.nanos / NANOS_PER_MILLI()
  end
  
  def subsec_micros(self: &Duration) -> u32
    self.nanos / NANOS_PER_MICRO()
  end
  
  def subsec_nanos(self: &Duration) -> u32
    self.nanos
  end
  
  def as_millis(self: &Duration) -> u64
    self.secs * MILLIS_PER_SEC() + (self.nanos / NANOS_PER_MILLI()) as u64
  end
  
  def as_micros(self: &Duration) -> u64
    self.secs * MICROS_PER_SEC() + (self.nanos / NANOS_PER_MICRO()) as u64
  end
  
  def as_nanos(self: &Duration) -> u128
    (self.secs as u128) * (NANOS_PER_SEC() as u128) + (self.nanos as u128)
  end
  
  def as_secs_f64(self: &Duration) -> Float
    (self.secs as Float) + (self.nanos as Float) / (NANOS_PER_SEC() as Float)
  end
  
  def is_zero(self: &Duration) -> Bool
    self.secs == 0 && self.nanos == 0
  end
  
  def checked_add(self: &Duration, rhs: &Duration) -> Option[Duration]
    let mut nanos = self.nanos + rhs.nanos
    let mut secs = self.secs + rhs.secs
    
    if nanos >= NANOS_PER_SEC() then
      nanos = nanos - NANOS_PER_SEC()
      secs = secs + 1
    end
    
    # Check for overflow
    if secs < self.secs then
      return Option::None
    end
    
    Option::Some(Duration { secs: secs, nanos: nanos })
  end
  
  def checked_sub(self: &Duration, rhs: &Duration) -> Option[Duration]
    if self.secs < rhs.secs || (self.secs == rhs.secs && self.nanos < rhs.nanos) then
      return Option::None
    end
    
    mut secs = self.secs - rhs.secs
    mut nanos = self.nanos as i64 - rhs.nanos as i64
    
    if nanos < 0 then
      secs = secs - 1
      nanos = nanos + NANOS_PER_SEC() as i64
    end
    
    Option::Some(Duration { secs: secs, nanos: nanos as u32 })
  end
  
  def checked_mul(self: &Duration, rhs: u32) -> Option[Duration]
    let total_nanos = (self.nanos as u64) * (rhs as u64)
    let extra_secs = total_nanos / NANOS_PER_SEC() as u64
    let nanos = (total_nanos % NANOS_PER_SEC() as u64) as u32
    
    let secs = self.secs.checked_mul(rhs as u64)
    match secs
    when Option::Some(s) then
      match s.checked_add(extra_secs)
      when Option::Some(total) then Option::Some(Duration { secs: total, nanos: nanos })
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  end
  
  def checked_div(self: &Duration, rhs: u32) -> Option[Duration]
    if rhs == 0 then
      return Option::None
    end
    
    let secs = self.secs / rhs as u64
    let remainder = self.secs % rhs as u64
    let nanos = ((remainder * NANOS_PER_SEC() as u64 + self.nanos as u64) / rhs as u64) as u32
    
    Option::Some(Duration { secs: secs, nanos: nanos })
  end
  
  def to_string(self: &Duration) -> String
    if self.nanos == 0 then
      self.secs.to_string() + "s"
    else
      
      let nanos_str = self.nanos.to_string()
      let padded = pad_left(nanos_str, 9, '0')
      self.secs.to_string() + "." + padded + "s"
    end
  end
end

# Helper to pad a string on the left to a minimum width
def pad_left(s: String, width: UInt, ch: Char) -> String
  if s.len() >= width then
    return s
  end
  mut result = String::new()
  mut i = s.len()
  while i < width do
    result.push(ch)
    i = i + 1
  end
  result + s
end

impl Add for Duration
  type Output = Duration
  
  def add(self: Duration, rhs: Duration) -> Duration
    self.checked_add(&rhs).expect("Duration overflow")
  end
end

impl Sub for Duration
  type Output = Duration
  
  def sub(self: Duration, rhs: Duration) -> Duration
    self.checked_sub(&rhs).expect("Duration underflow")
  end
end

# ———————————————————————————————————————————————————————————————
# Instant (Monotonic Clock)
# ———————————————————————————————————————————————————————————————

struct Instant
  tv: TimeSpec
end

def instant_now() -> Instant
  mut ts = TimeSpec { tv_sec: 0, tv_nsec: 0 }
  clock_gettime(CLOCK_MONOTONIC(), &ts)
  Instant { tv: ts }
end

impl Instant
  def now() -> Instant
    instant_now()
  end
  
  def elapsed(self: &Instant) -> Duration
    let now = instant_now()
    now.duration_since(self)
  end
  
  def duration_since(self: &Instant, earlier: &Instant) -> Duration
    mut secs = self.tv.tv_sec - earlier.tv.tv_sec
    mut nanos = self.tv.tv_nsec - earlier.tv.tv_nsec
    
    if nanos < 0 then
      secs = secs - 1
      nanos = nanos + NANOS_PER_SEC() as i64
    end
    
    Duration { secs: secs as u64, nanos: nanos as u32 }
  end
  
  def checked_add(self: &Instant, duration: &Duration) -> Option[Instant]
    mut secs = self.tv.tv_sec + duration.secs as i64
    mut nanos = self.tv.tv_nsec + duration.nanos as i64
    
    if nanos >= NANOS_PER_SEC() as i64 then
      secs = secs + 1
      nanos = nanos - NANOS_PER_SEC() as i64
    end
    
    Option::Some(Instant { tv: TimeSpec { tv_sec: secs, tv_nsec: nanos } })
  end
  
  def checked_sub(self: &Instant, duration: &Duration) -> Option[Instant]
    mut secs = self.tv.tv_sec - duration.secs as i64
    mut nanos = self.tv.tv_nsec - duration.nanos as i64
    
    if nanos < 0 then
      secs = secs - 1
      nanos = nanos + NANOS_PER_SEC() as i64
    end
    
    if secs < 0 then
      return Option::None
    end
    
    Option::Some(Instant { tv: TimeSpec { tv_sec: secs, tv_nsec: nanos } })
  end
end

impl Add[Duration] for Instant
  type Output = Instant
  
  def add(self: Instant, duration: Duration) -> Instant
    self.checked_add(&duration).expect("Instant overflow")
  end
end

impl Sub[Duration] for Instant
  type Output = Instant
  
  def sub(self: Instant, duration: Duration) -> Instant
    self.checked_sub(&duration).expect("Instant underflow")
  end
end

impl Sub[Instant] for Instant
  type Output = Duration
  
  def sub(self: Instant, other: Instant) -> Duration
    self.duration_since(&other)
  end
end

# ———————————————————————————————————————————————————————————————
# SystemTime (Wall Clock)
# ———————————————————————————————————————————————————————————————

struct SystemTime
  tv: TimeSpec
end

def UNIX_EPOCH() -> SystemTime
  SystemTime { tv: TimeSpec { tv_sec: 0, tv_nsec: 0 } }
end

def system_time_now() -> SystemTime
  mut ts = TimeSpec { tv_sec: 0, tv_nsec: 0 }
  clock_gettime(CLOCK_REALTIME(), &ts)
  SystemTime { tv: ts }
end

impl SystemTime
  def now() -> SystemTime
    system_time_now()
  end
  
  def elapsed(self: &SystemTime) -> Result[Duration, String]
    let now = system_time_now()
    now.duration_since(self)
  end
  
  def duration_since(self: &SystemTime, earlier: &SystemTime) -> Result[Duration, String]
    if self.tv.tv_sec < earlier.tv.tv_sec || 
       (self.tv.tv_sec == earlier.tv.tv_sec && self.tv.tv_nsec < earlier.tv.tv_nsec) then
      return Result::Err("SystemTime earlier than other".to_string())
    end
    
    mut secs = self.tv.tv_sec - earlier.tv.tv_sec
    mut nanos = self.tv.tv_nsec - earlier.tv.tv_nsec
    
    if nanos < 0 then
      secs = secs - 1
      nanos = nanos + NANOS_PER_SEC() as i64
    end
    
    Result::Ok(Duration { secs: secs as u64, nanos: nanos as u32 })
  end
  
  def checked_add(self: &SystemTime, duration: &Duration) -> Option[SystemTime]
    mut secs = self.tv.tv_sec + duration.secs as i64
    mut nanos = self.tv.tv_nsec + duration.nanos as i64
    
    if nanos >= NANOS_PER_SEC() as i64 then
      secs = secs + 1
      nanos = nanos - NANOS_PER_SEC() as i64
    end
    
    Option::Some(SystemTime { tv: TimeSpec { tv_sec: secs, tv_nsec: nanos } })
  end
  
  def checked_sub(self: &SystemTime, duration: &Duration) -> Option[SystemTime]
    mut secs = self.tv.tv_sec - duration.secs as i64
    mut nanos = self.tv.tv_nsec - duration.nanos as i64
    
    if nanos < 0 then
      secs = secs - 1
      nanos = nanos + NANOS_PER_SEC() as i64
    end
    
    Option::Some(SystemTime { tv: TimeSpec { tv_sec: secs, tv_nsec: nanos } })
  end
end

# ———————————————————————————————————————————————————————————————
# DateTime
# ———————————————————————————————————————————————————————————————

struct DateTime
  year: Int
  month: Int      # 1-12
  day: Int        # 1-31
  hour: Int       # 0-23
  minute: Int     # 0-59
  second: Int     # 0-59
  nanosecond: u32 # 0-999999999
  utc_offset: Int # Seconds from UTC
end

def datetime_now_utc() -> DateTime
  mut timestamp: i64 = 0
  time(&timestamp)
  
  mut tm = Tm {
    tm_sec: 0, tm_min: 0, tm_hour: 0,
    tm_mday: 0, tm_mon: 0, tm_year: 0,
    tm_wday: 0, tm_yday: 0, tm_isdst: 0
  }
  gmtime_r(&timestamp, &tm)
  
  DateTime {
    year: tm.tm_year + 1900,
    month: tm.tm_mon + 1,
    day: tm.tm_mday,
    hour: tm.tm_hour,
    minute: tm.tm_min,
    second: tm.tm_sec,
    nanosecond: 0,
    utc_offset: 0
  }
end

def datetime_now_local() -> DateTime
  mut timestamp: i64 = 0
  time(&timestamp)
  
  mut tm = Tm {
    tm_sec: 0, tm_min: 0, tm_hour: 0,
    tm_mday: 0, tm_mon: 0, tm_year: 0,
    tm_wday: 0, tm_yday: 0, tm_isdst: 0
  }
  localtime_r(&timestamp, &tm)
  
  DateTime {
    year: tm.tm_year + 1900,
    month: tm.tm_mon + 1,
    day: tm.tm_mday,
    hour: tm.tm_hour,
    minute: tm.tm_min,
    second: tm.tm_sec,
    nanosecond: 0,
    utc_offset: 0  # Could compute from tm_gmtoff if available
  }
end

impl DateTime
  def from_timestamp(timestamp: i64) -> DateTime
    mut tm = Tm {
      tm_sec: 0, tm_min: 0, tm_hour: 0,
      tm_mday: 0, tm_mon: 0, tm_year: 0,
      tm_wday: 0, tm_yday: 0, tm_isdst: 0
    }
    gmtime_r(&timestamp, &tm)
    
    DateTime {
      year: tm.tm_year + 1900,
      month: tm.tm_mon + 1,
      day: tm.tm_mday,
      hour: tm.tm_hour,
      minute: tm.tm_min,
      second: tm.tm_sec,
      nanosecond: 0,
      utc_offset: 0
    }
  end
  
  def to_timestamp(self: &DateTime) -> i64
    mut tm = Tm {
      tm_sec: self.second,
      tm_min: self.minute,
      tm_hour: self.hour,
      tm_mday: self.day,
      tm_mon: self.month - 1,
      tm_year: self.year - 1900,
      tm_wday: 0,
      tm_yday: 0,
      tm_isdst: -1
    }
    mktime(&tm)
  end
  
  def format(self: &DateTime, fmt: String) -> String
    mut tm = Tm {
      tm_sec: self.second,
      tm_min: self.minute,
      tm_hour: self.hour,
      tm_mday: self.day,
      tm_mon: self.month - 1,
      tm_year: self.year - 1900,
      tm_wday: 0,
      tm_yday: 0,
      tm_isdst: 0
    }
    
    mut buf: [u8; 256] = [0; 256]
    let fmt_cstr = fmt.to_cstring()
    let len = strftime(&buf as Ptr[u8], 256, fmt_cstr.as_ptr(), &tm)
    
    String::from_utf8_lossy(&buf[0..len as Int])
  end
  
  def iso8601(self: &DateTime) -> String
    format("{:04}-{:02}-{:02}T{:02}:{:02}:{:02}Z", [
      self.year.to_string(),
      self.month.to_string(),
      self.day.to_string(),
      self.hour.to_string(),
      self.minute.to_string(),
      self.second.to_string()
    ])
  end
  
  def rfc2822(self: &DateTime) -> String
    self.format("%a, %d %b %Y %H:%M:%S GMT".to_string())
  end
  
  def weekday(self: &DateTime) -> Weekday
    mut tm = Tm {
      tm_sec: self.second,
      tm_min: self.minute,
      tm_hour: self.hour,
      tm_mday: self.day,
      tm_mon: self.month - 1,
      tm_year: self.year - 1900,
      tm_wday: 0,
      tm_yday: 0,
      tm_isdst: -1
    }
    mktime(&tm)  # This fills in tm_wday
    
    match tm.tm_wday
    when 0 then Weekday::Sunday
    when 1 then Weekday::Monday
    when 2 then Weekday::Tuesday
    when 3 then Weekday::Wednesday
    when 4 then Weekday::Thursday
    when 5 then Weekday::Friday
    when 6 then Weekday::Saturday
    when _ then Weekday::Sunday  # Should not happen
    end
  end
end

enum Weekday
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
end

impl Weekday
  def to_string(self: &Weekday) -> String
    match self
    when Weekday::Monday then "Monday".to_string()
    when Weekday::Tuesday then "Tuesday".to_string()
    when Weekday::Wednesday then "Wednesday".to_string()
    when Weekday::Thursday then "Thursday".to_string()
    when Weekday::Friday then "Friday".to_string()
    when Weekday::Saturday then "Saturday".to_string()
    when Weekday::Sunday then "Sunday".to_string()
    end
  end
  
  def num_days_from_monday(self: &Weekday) -> Int
    match self
    when Weekday::Monday then 0
    when Weekday::Tuesday then 1
    when Weekday::Wednesday then 2
    when Weekday::Thursday then 3
    when Weekday::Friday then 4
    when Weekday::Saturday then 5
    when Weekday::Sunday then 6
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Sleep Functions
# ———————————————————————————————————————————————————————————————

def sleep(duration: Duration) -> Unit
  mut req = TimeSpec {
    tv_sec: duration.secs as i64,
    tv_nsec: duration.nanos as i64
  }
  mut rem = TimeSpec { tv_sec: 0, tv_nsec: 0 }
  nanosleep(&req, &rem)
end

def sleep_secs(secs: u64) -> Unit
  sleep(duration_from_secs(secs))
end

def sleep_millis(millis: u64) -> Unit
  sleep(duration_from_millis(millis))
end

# ———————————————————————————————————————————————————————————————
# Stopwatch (convenient timing)
# ———————————————————————————————————————————————————————————————

struct Stopwatch
  start: Instant
  elapsed: Duration
  running: Bool
end

def stopwatch_new() -> Stopwatch
  Stopwatch {
    start: instant_now(),
    elapsed: duration_zero(),
    running: false
  }
end

impl Stopwatch
  def start(self: &mut Stopwatch) -> Unit
    if !self.running then
      self.start = instant_now()
      self.running = true
    end
  end
  
  def stop(self: &mut Stopwatch) -> Unit
    if self.running then
      let now = instant_now()
      match self.elapsed.checked_add(&now.duration_since(&self.start))
      when Option::Some(d) then self.elapsed = d
      when Option::None then ()
      end
      self.running = false
    end
  end
  
  def reset(self: &mut Stopwatch) -> Unit
    self.elapsed = duration_zero()
    self.running = false
  end
  
  def restart(self: &mut Stopwatch) -> Unit
    self.reset()
    self.start()
  end
  
  def elapsed(self: &Stopwatch) -> Duration
    if self.running then
      let now = instant_now()
      self.elapsed.checked_add(&now.duration_since(&self.start)).unwrap_or(self.elapsed.clone())
    else
      self.elapsed.clone()
    end
  end
  
  def is_running(self: &Stopwatch) -> Bool
    self.running
  end
end

# ———————————————————————————————————————————————————————————————
# Timer
# ———————————————————————————————————————————————————————————————

struct Timer
  deadline: Instant
end

def timer_after(duration: Duration) -> Timer
  Timer {
    deadline: instant_now().checked_add(&duration).expect("Timer overflow")
  }
end

impl Timer
  def remaining(self: &Timer) -> Duration
    let now = instant_now()
    if now.tv.tv_sec > self.deadline.tv.tv_sec ||
       (now.tv.tv_sec == self.deadline.tv.tv_sec && now.tv.tv_nsec >= self.deadline.tv.tv_nsec) then
      duration_zero()
    else
      self.deadline.duration_since(&now)
    end
  end
  
  def has_elapsed(self: &Timer) -> Bool
    let now = instant_now()
    now.tv.tv_sec > self.deadline.tv.tv_sec ||
    (now.tv.tv_sec == self.deadline.tv.tv_sec && now.tv.tv_nsec >= self.deadline.tv.tv_nsec)
  end
  
  def wait(self: &Timer) -> Unit
    let remaining = self.remaining()
    if !remaining.is_zero() then
      sleep(remaining)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Interval Timer
# ———————————————————————————————————————————————————————————————

struct Interval
  period: Duration
  next_tick: Instant
end

def interval(period: Duration) -> Interval
  Interval {
    period: period.clone(),
    next_tick: instant_now().checked_add(&period).expect("Interval overflow")
  }
end

impl Interval
  def tick(self: &mut Interval) -> Unit
    let now = instant_now()
    
    # If we haven't reached the next tick, sleep
    if now.tv.tv_sec < self.next_tick.tv.tv_sec ||
       (now.tv.tv_sec == self.next_tick.tv.tv_sec && now.tv.tv_nsec < self.next_tick.tv.tv_nsec) then
      sleep(self.next_tick.duration_since(&now))
    end
    
    # Schedule next tick
    self.next_tick = self.next_tick.checked_add(&self.period).expect("Interval overflow")
  end
end

# ———————————————————————————————————————————————————————————————
# Measurement Helper
# ———————————————————————————————————————————————————————————————

def measure[T, F](f: F) -> (T, Duration)
  where F: FnOnce() -> T
  
  let start = instant_now()
  let result = f()
  let elapsed = start.elapsed()
  
  (result, elapsed)
end

def benchmark[F](iterations: Int, f: F) -> Duration
  where F: Fn() -> Unit
  
  let start = instant_now()
  mut i = 0
  while i < iterations do
    f()
    i = i + 1
  end
  start.elapsed()
end
