# Tangerine Standard Library — tg::time
# Time Operations

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt}

# [METADATA]
# module: tg::time
# status: stable
# effects: [Time]
# capabilities: []

# ═══════════════════════════════════════════════════════════════
# Clock IDs
# ═══════════════════════════════════════════════════════════════

def CLOCK_REALTIME() -> Int = 0
def CLOCK_MONOTONIC() -> Int = 1
def CLOCK_PROCESS_CPUTIME_ID() -> Int = 2
def CLOCK_THREAD_CPUTIME_ID() -> Int = 3
def CLOCK_MONOTONIC_RAW() -> Int = 4
def CLOCK_REALTIME_COARSE() -> Int = 5
def CLOCK_MONOTONIC_COARSE() -> Int = 6
def CLOCK_BOOTTIME() -> Int = 7
def CLOCK_REALTIME_ALARM() -> Int = 8
def CLOCK_BOOTTIME_ALARM() -> Int = 9

# ═══════════════════════════════════════════════════════════════
# FFI to libc for time operations — exact ABI widths
# ═══════════════════════════════════════════════════════════════
# The C-`int` returns (clock_gettime/clock_getres/clock_settime/
# gettimeofday/nanosleep/usleep/timespec_get) declare the i32 form; the
# C `unsigned int` sleep return is u32. time_t returns (time/mktime) and
# the size_t strftime return stay Int/UInt (64-bit on the LP64 targets).

@ffi("c")
extern def clock_gettime(clock_id: Int, tp: PtrMut[u8]) -> i32
end

@ffi("c")
extern def clock_getres(clock_id: Int, res: PtrMut[u8]) -> i32
end

@ffi("c")
extern def clock_settime(clock_id: Int, tp: Ptr[u8]) -> i32
end

@ffi("c")
extern def gettimeofday(tv: Ptr[Int], tz: Ptr[Int]) -> i32
end

@ffi("c")
extern def time(t: Ptr[Int]) -> Int
end

@ffi("c")
extern def nanosleep(req: Ptr[u8], rem: PtrMut[u8]) -> i32
end

@ffi("c")
extern def usleep(usec: UInt) -> i32
end

@ffi("c")
extern def sleep(sec: UInt) -> u32
end

@ffi("c")
extern def gmtime_r(timep: Ptr[Int], result: PtrMut[u8]) -> Ptr[u8]
end

@ffi("c")
extern def localtime_r(timep: Ptr[Int], result: PtrMut[u8]) -> Ptr[u8]
end

@ffi("c")
extern def mktime(tm: PtrMut[u8]) -> Int
end

@ffi("c")
extern def strftime(s: PtrMut[u8], max: UInt, format: Ptr[u8], tm: Ptr[u8]) -> UInt
end

@ffi("c")
extern def timespec_get(ts: PtrMut[u8], base: Int) -> i32
end

# Time 2010 constants
def TIME_UTC() -> Int = 1

# ═══════════════════════════════════════════════════════════════
# Timespec Structure (16 bytes)
# ═══════════════════════════════════════════════════════════════

struct Timespec
  tv_sec: Int      # Seconds
  tv_nsec: Int     # Nanoseconds
end

def Timespec::zero() -> Timespec
  Timespec { tv_sec: 0, tv_nsec: 0 }
end

def Timespec::from_secs(seconds: Int) -> Timespec
  Timespec { tv_sec: seconds, tv_nsec: 0 }
end

def Timespec::from_millis(ms: Int) -> Timespec
  Timespec { 
    tv_sec: ms / 1000,
    tv_nsec: (ms % 1000) * 1_000_000
  }
end

def Timespec::from_micros(us: Int) -> Timespec
  Timespec {
    tv_sec: us / 1_000_000,
    tv_nsec: (us % 1_000_000) * 1_000
  }
end

def Timespec::from_nanos(ns: Int) -> Timespec
  Timespec {
    tv_sec: ns / 1_000_000_000,
    tv_nsec: ns % 1_000_000_000
  }
end

def Timespec::to_nanos(self: Timespec) -> Int
  self.tv_sec * 1_000_000_000 + self.tv_nsec
end

def Timespec::to_micros(self: Timespec) -> Int
  self.tv_sec * 1_000_000 + self.tv_nsec / 1_000
end

def Timespec::to_millis(self: Timespec) -> Int
  self.tv_sec * 1_000 + self.tv_nsec / 1_000_000
end

def Timespec::to_secs(self: Timespec) -> Int
  self.tv_sec
end

def Timespec::as_f64_secs(self: Timespec) -> f64
  self.tv_sec as f64 + self.tv_nsec as f64 / 1_000_000_000.0
end

def Timespec::add(self: Timespec, other: Timespec) -> Timespec
  var sec = self.tv_sec + other.tv_sec
  var nsec = self.tv_nsec + other.tv_nsec
  
  if nsec >= 1_000_000_000 then
    sec = sec + 1
    nsec = nsec - 1_000_000_000
  end
  
  Timespec { tv_sec: sec, tv_nsec: nsec }
end

def Timespec::sub(self: Timespec, other: Timespec) -> Timespec
  var sec = self.tv_sec - other.tv_sec
  var nsec = self.tv_nsec - other.tv_nsec
  
  if nsec < 0 then
    sec = sec - 1
    nsec = nsec + 1_000_000_000
  end
  
  Timespec { tv_sec: sec, tv_nsec: nsec }
end

def Timespec::compare(self: Timespec, other: Timespec) -> Int
  if self.tv_sec < other.tv_sec then return -1 end
  if self.tv_sec > other.tv_sec then return 1 end
  if self.tv_nsec < other.tv_nsec then return -1 end
  if self.tv_nsec > other.tv_nsec then return 1 end
  0
end

def Timespec::eq(self: Timespec, other: Timespec) -> Bool
  self.tv_sec == other.tv_sec && self.tv_nsec == other.tv_nsec
end

def Timespec::lt(self: Timespec, other: Timespec) -> Bool
  self.compare(other) < 0
end

def Timespec::gt(self: Timespec, other: Timespec) -> Bool
  self.compare(other) > 0
end

def Timespec::is_zero(self: Timespec) -> Bool
  self.tv_sec == 0 && self.tv_nsec == 0
end

def Timespec::normalize(self: Timespec) -> Timespec
  var sec = self.tv_sec
  var nsec = self.tv_nsec
  
  # Handle negative nanoseconds
  while nsec < 0 do
    sec = sec - 1
    nsec = nsec + 1_000_000_000
  end
  
  # Handle overflow
  while nsec >= 1_000_000_000 do
    sec = sec + 1
    nsec = nsec - 1_000_000_000
  end
  
  Timespec { tv_sec: sec, tv_nsec: nsec }
end

# Pack Timespec to bytes for FFI
def Timespec::to_bytes(self: Timespec) -> Vec[u8]
  var buf: Vec[u8] = Vec::with_capacity(16)
  buf.resize(16, 0)
  
  # tv_sec (8 bytes, little-endian)
  var sec = self.tv_sec
  buf[0] = (sec & 0xFF) as u8
  buf[1] = ((sec >> 8) & 0xFF) as u8
  buf[2] = ((sec >> 16) & 0xFF) as u8
  buf[3] = ((sec >> 24) & 0xFF) as u8
  buf[4] = ((sec >> 32) & 0xFF) as u8
  buf[5] = ((sec >> 40) & 0xFF) as u8
  buf[6] = ((sec >> 48) & 0xFF) as u8
  buf[7] = ((sec >> 56) & 0xFF) as u8
  
  # tv_nsec (8 bytes, little-endian)
  var nsec = self.tv_nsec
  buf[8] = (nsec & 0xFF) as u8
  buf[9] = ((nsec >> 8) & 0xFF) as u8
  buf[10] = ((nsec >> 16) & 0xFF) as u8
  buf[11] = ((nsec >> 24) & 0xFF) as u8
  buf[12] = ((nsec >> 32) & 0xFF) as u8
  buf[13] = ((nsec >> 40) & 0xFF) as u8
  buf[14] = ((nsec >> 48) & 0xFF) as u8
  buf[15] = ((nsec >> 56) & 0xFF) as u8
  
  buf
end

# Unpack Timespec from bytes
def Timespec::from_bytes(buf: Vec[u8]) -> Timespec
  if buf.len() < 16 then return Timespec::zero() end
  
  let sec = (buf[0] as Int) | 
            ((buf[1] as Int) << 8) |
            ((buf[2] as Int) << 16) |
            ((buf[3] as Int) << 24) |
            ((buf[4] as Int) << 32) |
            ((buf[5] as Int) << 40) |
            ((buf[6] as Int) << 48) |
            ((buf[7] as Int) << 56)
  
  let nsec = (buf[8] as Int) |
             ((buf[9] as Int) << 8) |
             ((buf[10] as Int) << 16) |
             ((buf[11] as Int) << 24) |
             ((buf[12] as Int) << 32) |
             ((buf[13] as Int) << 40) |
             ((buf[14] as Int) << 48) |
             ((buf[15] as Int) << 56)
  
  Timespec { tv_sec: sec, tv_nsec: nsec }
end

# ═══════════════════════════════════════════════════════════════
# Timeval Structure (16 bytes)
# ═══════════════════════════════════════════════════════════════

struct Timeval
  tv_sec: Int       # Seconds
  tv_usec: Int      # Microseconds
end

def Timeval::zero() -> Timeval
  Timeval { tv_sec: 0, tv_usec: 0 }
end

def Timeval::from_secs(seconds: Int) -> Timeval
  Timeval { tv_sec: seconds, tv_usec: 0 }
end

def Timeval::from_millis(ms: Int) -> Timeval
  Timeval {
    tv_sec: ms / 1000,
    tv_usec: (ms % 1000) * 1000
  }
end

def Timeval::to_millis(self: Timeval) -> Int
  self.tv_sec * 1000 + self.tv_usec / 1000
end

def Timeval::to_micros(self: Timeval) -> Int
  self.tv_sec * 1_000_000 + self.tv_usec
end

def Timeval::to_timespec(self: Timeval) -> Timespec
  Timespec {
    tv_sec: self.tv_sec,
    tv_nsec: self.tv_usec * 1000
  }
end

def Timeval::to_bytes(self: Timeval) -> Vec[u8]
  var buf: Vec[u8] = Vec::with_capacity(16)
  buf.resize(16, 0)
  
  # tv_sec (8 bytes)
  buf[0] = (self.tv_sec & 0xFF) as u8
  buf[1] = ((self.tv_sec >> 8) & 0xFF) as u8
  buf[2] = ((self.tv_sec >> 16) & 0xFF) as u8
  buf[3] = ((self.tv_sec >> 24) & 0xFF) as u8
  buf[4] = ((self.tv_sec >> 32) & 0xFF) as u8
  buf[5] = ((self.tv_sec >> 40) & 0xFF) as u8
  buf[6] = ((self.tv_sec >> 48) & 0xFF) as u8
  buf[7] = ((self.tv_sec >> 56) & 0xFF) as u8
  
  # tv_usec (8 bytes)
  buf[8] = (self.tv_usec & 0xFF) as u8
  buf[9] = ((self.tv_usec >> 8) & 0xFF) as u8
  buf[10] = ((self.tv_usec >> 16) & 0xFF) as u8
  buf[11] = ((self.tv_usec >> 24) & 0xFF) as u8
  buf[12] = ((self.tv_usec >> 32) & 0xFF) as u8
  buf[13] = ((self.tv_usec >> 40) & 0xFF) as u8
  buf[14] = ((self.tv_usec >> 48) & 0xFF) as u8
  buf[15] = ((self.tv_usec >> 56) & 0xFF) as u8
  
  buf
end

# ═══════════════════════════════════════════════════════════════
# Instant - Monotonic Time Point
# ═══════════════════════════════════════════════════════════════

struct Instant
  ts: Timespec
end

def Instant::now() -> Instant
  let ts = get_time_monotonic()
  Instant { ts: ts }
end

def Instant::from_timespec(ts: Timespec) -> Instant
  Instant { ts: ts }
end

def Instant::elapsed(self: Instant) -> Timespec
  let now = Instant::now()
  now.ts.sub(self.ts)
end

def Instant::duration_since(self: Instant, earlier: Instant) -> Timespec
  self.ts.sub(earlier.ts)
end

def Instant::add(self: Instant, duration: Timespec) -> Instant
  Instant { ts: self.ts.add(duration) }
end

def Instant::sub(self: Instant, duration: Timespec) -> Instant
  Instant { ts: self.ts.sub(duration) }
end

def Instant::compare(self: Instant, other: Instant) -> Int
  self.ts.compare(other.ts)
end

def Instant::eq(self: Instant, other: Instant) -> Bool
  self.ts.eq(other.ts)
end

def Instant::lt(self: Instant, other: Instant) -> Bool
  self.ts.lt(other.ts)
end

def Instant::gt(self: Instant, other: Instant) -> Bool
  self.ts.gt(other.ts)
end

# ═══════════════════════════════════════════════════════════════
# SystemTime - Realtime Time Point
# ═══════════════════════════════════════════════════════════════

struct SystemTime
  ts: Timespec
end

def SystemTime::now() -> SystemTime
  let ts = get_time_realtime()
  SystemTime { ts: ts }
end

def SystemTime::from_timespec(ts: Timespec) -> SystemTime
  SystemTime { ts: ts }
end

def SystemTime::from_unix_secs(secs: Int) -> SystemTime
  SystemTime { ts: Timespec::from_secs(secs) }
end

def SystemTime::unix_epoch() -> SystemTime
  SystemTime { ts: Timespec::zero() }
end

def SystemTime::elapsed(self: SystemTime) -> Timespec
  let now = SystemTime::now()
  now.ts.sub(self.ts)
end

def SystemTime::duration_since(self: SystemTime, earlier: SystemTime) -> Timespec
  self.ts.sub(earlier.ts)
end

def SystemTime::add(self: SystemTime, duration: Timespec) -> SystemTime
  SystemTime { ts: self.ts.add(duration) }
end

def SystemTime::sub(self: SystemTime, duration: Timespec) -> SystemTime
  SystemTime { ts: self.ts.sub(duration) }
end

def SystemTime::unix_secs(self: SystemTime) -> Int
  self.ts.tv_sec
end

def SystemTime::unix_millis(self: SystemTime) -> Int
  self.ts.to_millis()
end

def SystemTime::unix_micros(self: SystemTime) -> Int
  self.ts.to_micros()
end

def SystemTime::unix_nanos(self: SystemTime) -> Int
  self.ts.to_nanos()
end

# ═══════════════════════════════════════════════════════════════
# Clock Functions
# ═══════════════════════════════════════════════════════════════

def get_time(clock_id: Int) -> Timespec
  var buf: Vec[u8] = Vec::with_capacity(16)
  buf.resize(16, 0)
  
  let result = clock_gettime(clock_id, buf.as_mut_ptr())
  
  if result != 0 then
    return Timespec::zero()
  end
  
  Timespec::from_bytes(buf)
end

def get_time_realtime() -> Timespec
  get_time(CLOCK_REALTIME())
end

def get_time_monotonic() -> Timespec
  get_time(CLOCK_MONOTONIC())
end

def get_time_monotonic_raw() -> Timespec
  get_time(CLOCK_MONOTONIC_RAW())
end

def get_time_boottime() -> Timespec
  get_time(CLOCK_BOOTTIME())
end

def get_time_process_cputime() -> Timespec
  get_time(CLOCK_PROCESS_CPUTIME_ID())
end

def get_time_thread_cputime() -> Timespec
  get_time(CLOCK_THREAD_CPUTIME_ID())
end

def get_clock_resolution(clock_id: Int) -> Timespec
  var buf: Vec[u8] = Vec::with_capacity(16)
  buf.resize(16, 0)
  
  let result = clock_getres(clock_id, buf.as_mut_ptr())
  
  if result != 0 then
    return Timespec::from_nanos(1)  # Default to 1ns
  end
  
  Timespec::from_bytes(buf)
end

def get_realtime_resolution() -> Timespec
  get_clock_resolution(CLOCK_REALTIME())
end

def get_monotonic_resolution() -> Timespec
  get_clock_resolution(CLOCK_MONOTONIC())
end

# ═══════════════════════════════════════════════════════════════
# Unix Timestamp Functions
# ═══════════════════════════════════════════════════════════════

def unix_time() -> Int
  time(Ptr::null())
end

def unix_time_millis() -> Int
  let ts = get_time_realtime()
  ts.to_millis()
end

def unix_time_micros() -> Int
  let ts = get_time_realtime()
  ts.to_micros()
end

def unix_time_nanos() -> Int
  let ts = get_time_realtime()
  ts.to_nanos()
end

# ═══════════════════════════════════════════════════════════════
# Sleep Functions
# ═══════════════════════════════════════════════════════════════

def sleep_secs(secs: UInt) -> UInt
  sleep(secs as u32) as UInt
end

def sleep_millis(ms: UInt) -> Unit
  let secs = ms / 1000
  let usecs = (ms % 1000) * 1000
  
  if secs > 0 then
    let _ = sleep(secs)
  end
  
  if usecs > 0 then
    let _ = usleep(usecs)
  end
end

def sleep_micros(us: UInt) -> Unit
  let secs = us / 1_000_000
  let usecs = us % 1_000_000
  
  if secs > 0 then
    let _ = sleep(secs)
  end
  
  if usecs > 0 then
    let _ = usleep(usecs)
  end
end

def sleep_nanos(ns: UInt) -> Unit
  let req = Timespec::from_nanos(ns as Int)
  let req_bytes = req.to_bytes()
  var rem_bytes: Vec[u8] = Vec::with_capacity(16)
  rem_bytes.resize(16, 0)
  
  let _ = nanosleep(req_bytes.as_ptr(), rem_bytes.as_mut_ptr())
end

def sleep_timespec(duration: Timespec) -> Unit
  let req_bytes = duration.to_bytes()
  var rem_bytes: Vec[u8] = Vec::with_capacity(16)
  rem_bytes.resize(16, 0)
  
  let _ = nanosleep(req_bytes.as_ptr(), rem_bytes.as_mut_ptr())
end

# ═══════════════════════════════════════════════════════════════
# Duration Type
# ═══════════════════════════════════════════════════════════════

typealias Duration = Timespec

def Duration::from_secs(secs: Int) -> Duration
  Timespec::from_secs(secs)
end

def Duration::from_millis(ms: Int) -> Duration
  Timespec::from_millis(ms)
end

def Duration::from_micros(us: Int) -> Duration
  Timespec::from_micros(us)
end

def Duration::from_nanos(ns: Int) -> Duration
  Timespec::from_nanos(ns)
end

def Duration::as_secs(self: Duration) -> Int
  self.tv_sec
end

def Duration::subsec_millis(self: Duration) -> Int
  self.tv_nsec / 1_000_000
end

def Duration::subsec_micros(self: Duration) -> Int
  self.tv_nsec / 1_000
end

def Duration::subsec_nanos(self: Duration) -> Int
  self.tv_nsec
end

def Duration::as_millis(self: Duration) -> Int
  self.to_millis()
end

def Duration::as_micros(self: Duration) -> Int
  self.to_micros()
end

def Duration::as_nanos(self: Duration) -> Int
  self.to_nanos()
end

def Duration::is_zero(self: Duration) -> Bool
  self.tv_sec == 0 && self.tv_nsec == 0
end

# ═══════════════════════════════════════════════════════════════
# Time Measurement Helpers
# ═══════════════════════════════════════════════════════════════

def measure_time(f: () -> Unit) -> Timespec
  let start = Instant::now()
  f()
  start.elapsed()
end

def measure_time_result[T](f: () -> T) -> (T, Timespec)
  let start = Instant::now()
  let result = f()
  let elapsed = start.elapsed()
  (result, elapsed)
end

# ═══════════════════════════════════════════════════════════════
# Timeout Helper
# ═══════════════════════════════════════════════════════════════

def is_timeout_elapsed(start: Instant, timeout: Duration) -> Bool
  let elapsed = start.elapsed()
  elapsed.compare(timeout) >= 0
end

def time_remaining(start: Instant, timeout: Duration) -> Duration
  let elapsed = start.elapsed()
  if elapsed.compare(timeout) >= 0 then
    Duration::from_secs(0)
  else
    timeout.sub(elapsed)
  end
end

# ═══════════════════════════════════════════════════════════════
# Formatting Helpers
# ═══════════════════════════════════════════════════════════════

def Duration::to_string(self: Duration) -> String
  if self.tv_sec >= 3600 then
    let hours = self.tv_sec / 3600
    let mins = (self.tv_sec % 3600) / 60
    let secs = self.tv_sec % 60
    hours.to_string() + "h " + mins.to_string() + "m " + secs.to_string() + "s"
  elsif self.tv_sec >= 60 then
    let mins = self.tv_sec / 60
    let secs = self.tv_sec % 60
    mins.to_string() + "m " + secs.to_string() + "s"
  elsif self.tv_sec > 0 then
    self.tv_sec.to_string() + "." + (self.tv_nsec / 100_000_000).to_string() + "s"
  elsif self.tv_nsec >= 1_000_000 then
    (self.tv_nsec / 1_000_000).to_string() + "ms"
  elsif self.tv_nsec >= 1_000 then
    (self.tv_nsec / 1_000).to_string() + "µs"
  else
    self.tv_nsec.to_string() + "ns"
  end
end

def Timespec::to_string(self: Timespec) -> String
  if self.tv_sec == 0 && self.tv_nsec == 0 then
    "0s"
  elsif self.tv_sec == 0 then
    self.tv_nsec.to_string() + "ns"
  elsif self.tv_nsec == 0 then
    self.tv_sec.to_string() + "s"
  else
    self.tv_sec.to_string() + "s " + self.tv_nsec.to_string() + "ns"
  end
end

# ═══════════════════════════════════════════════════════════════
# Performance Counter (high-resolution)
# ═══════════════════════════════════════════════════════════════

def perf_counter() -> Timespec
  get_time_monotonic()
end

def perf_counter_ns() -> Int
  let ts = get_time_monotonic()
  ts.to_nanos()
end

def perf_counter_us() -> Int
  let ts = get_time_monotonic()
  ts.to_micros()
end

def perf_counter_ms() -> Int
  let ts = get_time_monotonic()
  ts.to_millis()
end

# ═══════════════════════════════════════════════════════════════
# Benchmarking Helper
# ═══════════════════════════════════════════════════════════════

struct Benchmark
  start: Instant
  iterations: Int
end

def Benchmark::start(iterations: Int) -> Benchmark
  Benchmark {
    start: Instant::now(),
    iterations: iterations
  }
end

def Benchmark::elapsed(self: Benchmark) -> Timespec
  self.start.elapsed()
end

def Benchmark::ns_per_iter(self: Benchmark) -> Int
  let total_ns = self.start.elapsed().to_nanos()
  if self.iterations > 0 then
    total_ns / self.iterations
  else
    total_ns
  end
end

def Benchmark::iters_per_sec(self: Benchmark) -> f64
  let elapsed = self.start.elapsed()
  let secs = elapsed.as_f64_secs()
  if secs > 0.0 then
    self.iterations as f64 / secs
  else
    0.0
  end
end

def Benchmark::report(self: Benchmark, name: String) -> String
  let elapsed = self.elapsed()
  let ns_per = self.ns_per_iter()
  
  name + ": " + elapsed.to_string() + " total, " + 
    ns_per.to_string() + " ns/iter, " +
    self.iters_per_sec().to_string() + " iter/s"
end