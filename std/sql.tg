# Tangerine Standard Library — tg::sql
# SQL abstraction layer: typed parameters, prepared statements, and pooling.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 42.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec, Map}
use std::gfx_errors::{Error, ErrorCode}
use std::ctx
use std::secure_types::{SqlQuery, SqlParam}

# [METADATA]
# module: tg::sql
# status: alpha
# effects: [Net, Io]
# capabilities: [Net]
# error_codes: [ConnectionFailed, QueryFailed, InvalidParam, Internal]

enum SqlError
  ConnectionFailed(Error)
  QueryFailed(Error)
  InvalidParam(Error)
  Internal(Error)
end

impl SqlError
  def message(self: SqlError) -> String
    match self
    when SqlError::ConnectionFailed(e) then e.message.clone()
    when SqlError::QueryFailed(e) then e.message.clone()
    when SqlError::InvalidParam(e) then e.message.clone()
    when SqlError::Internal(e) then e.message.clone()
    end
  end

  def code(self: SqlError) -> ErrorCode
    match self
    when SqlError::ConnectionFailed(_) then ErrorCode::BackendUnavailable
    when SqlError::QueryFailed(_) then ErrorCode::InvalidArg
    when SqlError::InvalidParam(_) then ErrorCode::InvalidArg
    when SqlError::Internal(_) then ErrorCode::Internal
    end
  end
end

struct Row
  columns: Map[String, SqlParam]
end

struct ResultSet
  rows: Vec[Row]
end

trait Connection
  def execute(inout self: Self, query: SqlQuery) -> Result[ResultSet, SqlError]
  def prepare(inout self: Self, sql: String) -> Result[PreparedStatement, SqlError]
end

struct PreparedStatement
  sql: String
  # The driver binding surface: the facade's prepared statement records
  # the bindings here — the driver-backed execution path is the concrete
  # driver's Connection::execute.
  _handle: u64
  binds: Vec[(Int, SqlParam)]
end

impl PreparedStatement
  def bind(inout self: Self, index: Int, param: SqlParam) -> Result[Unit, SqlError]
    # The REAL std binding (the phantom __intrinsic_sql_bind removed):
    # SQL parameters are 1-based; the binding is recorded on the
    # statement.
    if index < 1 then
      return Result::Err(SqlError::InvalidParam(Error::new(ErrorCode::InvalidArg, "parameter index must be >= 1")))
    end
    self.binds.push((index, param))
    Result::Ok(())
  end

  def execute(inout self: Self) -> Result[ResultSet, SqlError]
    _log_sql_event(LogLevel::Debug, "Executing prepared statement")
    # THE EXECUTE CONTRACT (the silent Ok(ResultSet { rows: [] }) removed):
    # the facade's PreparedStatement is the sqlite-backed statement
    # created by the concrete driver's Connection::prepare (std::sqlite
    # fills the statement's driver handle); the execution surface is the
    # concrete driver's Connection::execute on the connection that
    # prepared it. The facade itself carries no driver execution path, so
    # a facade statement can never produce rows — the honest result is
    # the explicit Err(Unsupported), never the empty success.
    Result::Err(SqlError::QueryFailed(Error::new(ErrorCode::Unsupported,
      "prepared statement execution is unsupported on the facade: use the concrete driver's Connection::execute")))
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}
use std::time::{instant_now, duration_nanos}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_sql_event(level: LogLevel, msg: String) -> Unit
  match GLOBAL_LOGGER.as_mut()
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::App,
      message: "[SQL] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then ()
  end  end  end
end
