# Tangerine Standard Library — std::lint
# Linting Engine - Production Implementation
# NO PLACEHOLDERS - Full Static Analysis

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt}
use std::collections::{Map, Set}

# ═══════════════════════════════════════════════════════════════
# Lint Levels
# ═══════════════════════════════════════════════════════════════

enum LintLevel
  Allow      # Suppress lint
  Warn       # Warning
  Error      # Error
  Forbid     # Cannot be overridden
end

# ═══════════════════════════════════════════════════════════════
# Lint Categories
# ═══════════════════════════════════════════════════════════════

enum LintCategory
  Correctness    # Code that is wrong
  Style          # Style issues
  Complexity     # Code complexity
  Performance    # Performance issues
  Security       # Security issues
  Deprecated     # Deprecated features
  Pedantic       # Extra strict checks
  Nursery        # Experimental lints
end

# ═══════════════════════════════════════════════════════════════
# Lint Result
# ═══════════════════════════════════════════════════════════════

struct LintMessage
  lint_id: String
  level: LintLevel
  category: LintCategory
  message: String
  file: String
  line: UInt
  column: UInt
  end_line: UInt
  end_column: UInt
  suggestion: Option[String]
  explanation: String
end

def LintMessage::to_string(self: &LintMessage) -> String
  let level_str = match self.level
  when LintLevel::Error => "error"
  when LintLevel::Warn => "warning"
  when LintLevel::Allow => "allow"
  when LintLevel::Forbid => "forbid"
  end
  
  let file_loc = self.file.clone() + ":" + self.line.to_string() + ":" + self.column.to_string()
  var result = "[" + level_str + "] " + file_loc + ": " + self.message.clone()
  
  match &self.suggestion
  when Option::Some(s) => result = result + "\n  suggestion: " + s
  when Option::None => ()
  end
  
  result
end

# ═══════════════════════════════════════════════════════════════
# Lint Configuration
# ═══════════════════════════════════════════════════════════════

struct LintConfig
  # Global settings
  default_level: LintLevel
  max_warnings: Option[UInt]
  treat_warnings_as_errors: Bool
  
  # Individual lint levels
  lint_levels: Map[String, LintLevel]
  
  # Feature toggles
  check_unused: Bool
  check_complexity: Bool
  check_style: Bool
  check_security: Bool
  check_performance: Bool
  check_deprecated: Bool
  
  # Thresholds
  max_function_length: UInt
  max_line_length: UInt
  max_parameters: UInt
  max_nesting_depth: UInt
  max_cognitive_complexity: UInt
  max_cyclomatic_complexity: UInt
end

def LintConfig::default() -> LintConfig
  LintConfig {
    default_level: LintLevel::Warn,
    max_warnings: Option::Some(100),
    treat_warnings_as_errors: false,
    lint_levels: Map::new(),
    check_unused: true,
    check_complexity: true,
    check_style: true,
    check_security: true,
    check_performance: true,
    check_deprecated: true,
    max_function_length: 100,
    max_line_length: 100,
    max_parameters: 7,
    max_nesting_depth: 5,
    max_cognitive_complexity: 25,
    max_cyclomatic_complexity: 10
  }
end

def LintConfig::get_level(self: &LintConfig, lint_id: &String) -> LintLevel
  match self.lint_levels.get(lint_id)
  when Option::Some(level) => level.clone()
  when Option::None => self.default_level.clone()
  end
end

# ═══════════════════════════════════════════════════════════════
# Linter State
# ═══════════════════════════════════════════════════════════════

struct Linter
  config: LintConfig
  messages: Vec[LintMessage]
  current_file: String
  
  # Symbol tables for analysis
  defined_symbols: Map[String, SymbolInfo]
  used_symbols: Set[String]
  assigned_vars: Map[String, UInt]  # var -> assignment count
  read_vars: Map[String, UInt]      # var -> read count
  
  # Complexity tracking
  current_function_length: UInt
  current_nesting_depth: UInt
  current_cognitive_complexity: UInt
  current_cyclomatic_complexity: UInt
end

struct SymbolInfo
  name: String
  kind: SymbolKind
  line: UInt
  column: UInt
  is_mut: Bool
  is_used: Bool
end

enum SymbolKind
  Function
  Struct
  Enum
  Trait
  Impl
  Variable
  Constant
  TypeAlias
  Field
  Parameter
  Module
end

def Linter::new(config: LintConfig) -> Linter
  Linter {
    config: config,
    messages: Vec::new(),
    current_file: "".to_string(),
    defined_symbols: Map::new(),
    used_symbols: Set::new(),
    assigned_vars: Map::new(),
    read_vars: Map::new(),
    current_function_length: 0,
    current_nesting_depth: 0,
    current_cognitive_complexity: 0,
    current_cyclomatic_complexity: 1
  }
end

def Linter::lint_file(&mut self, file: &String, source: &String) -> Vec[LintMessage]
  self.current_file = file.clone()
  self.messages.clear()
  self.defined_symbols.clear()
  self.used_symbols.clear()
  self.assigned_vars.clear()
  self.read_vars.clear()
  
  let lines = source.split("\n")
  
  # Run all lint passes
  self.lint_line_lengths(&lines)
  self.lint_trailing_whitespace(&lines)
  self.lint_trailing_newlines(&lines)
  self.lint_tabs(&lines)
  
  # Parse and analyze
  let tokens = self.tokenize(source)
  self.lint_tokens(&tokens)
  self.lint_ast(&tokens)
  
  # Post-analysis lints
  self.lint_unused_symbols()
  self.lint_shadowing()
  
  self.messages.clone()
end

# ═══════════════════════════════════════════════════════════════
# Tokenizer (simplified for linting)
# ═══════════════════════════════════════════════════════════════

enum TokenType
  Keyword
  Identifier
  String
  Number
  Operator
  Punctuation
  Comment
  Newline
  Whitespace
  Eof
end

struct Token
  type: TokenType
  text: String
  line: UInt
  column: UInt
end

def Linter::tokenize(&self, source: &String) -> Vec[Token]
  var tokens = Vec::new()
  var line = 0u
  var column = 0u
  var pos = 0u
  let chars = source.chars()
  let len = chars.len()
  
  while pos < len do
    let c = chars[pos]
    let start_line = line
    let start_col = column
    
    if c == '\n' then
      tokens.push(Token{type: TokenType::Newline, text: "\n".to_string(), line: line, column: column})
      line += 1
      column = 0
      pos += 1
    elsif c == '\r' then
      pos += 1
    elsif c == ' ' || c == '\t' then
      var end = pos
      while end < len && (chars[end] == ' ' || chars[end] == '\t') do
        column += 1
        end += 1
      end
      tokens.push(Token{type: TokenType::Whitespace, text: source.slice(pos, end), line: start_line, column: start_col})
      pos = end
    elsif c == '#' then
      var end = pos
      while end < len && chars[end] != '\n' do end += 1 end
      tokens.push(Token{type: TokenType::Comment, text: source.slice(pos, end), line: start_line, column: start_col})
      column += end - pos
      pos = end
    elsif c == '"' || c == '\'' then
      let quote = c
      var end = pos + 1
      while end < len do
        if chars[end] == '\\' && end + 1 < len then
          end += 2
          column += 2
        elsif chars[end] == quote then
          end += 1
          column += 1
          break
        else
          end += 1
          column += 1
        end
      end
      tokens.push(Token{type: TokenType::String, text: source.slice(pos, end), line: start_line, column: start_col})
      pos = end
    elsif c.is_digit() then
      var end = pos
      while end < len && (chars[end].is_alphanumeric() || chars[end] == '.') do end += 1 end
      tokens.push(Token{type: TokenType::Number, text: source.slice(pos, end), line: start_line, column: start_col})
      column += end - pos
      pos = end
    elsif c.is_alpha() || c == '_' then
      var end = pos
      while end < len && (chars[end].is_alphanumeric() || chars[end] == '_') do end += 1 end
      let text = source.slice(pos, end)
      let is_kw = self.is_keyword(&text)
      tokens.push(Token{type: if is_kw then TokenType::Keyword else TokenType::Identifier end, text: text, line: start_line, column: start_col})
      column += end - pos
      pos = end
    elsif self.is_punctuation(c) then
      tokens.push(Token{type: TokenType::Punctuation, text: c.to_string(), line: line, column: column})
      column += 1
      pos += 1
    elsif self.is_operator_char(c) then
      var end = pos
      while end < len && self.is_operator_char(chars[end]) do end += 1 end
      tokens.push(Token{type: TokenType::Operator, text: source.slice(pos, end), line: start_line, column: start_col})
      column += end - pos
      pos = end
    else
      column += 1
      pos += 1
    end
  end
  
  tokens.push(Token{type: TokenType::Eof, text: "".to_string(), line: line, column: column})
  tokens
end

def Linter::is_keyword(&self, s: &String) -> Bool
  match s.clone()
  when "def" | "let" | "mut" | "if" | "then" | "else" | "end" | "while" | "for" | "do" | "match" | "when" | "struct" | "enum" | "trait" | "impl" | "use" | "pub" | "return" | "break" | "continue" | "self" | "true" | "false" | "nil" | "and" | "or" | "not" | "async" | "await" | "spawn" | "move" | "ref" | "extern" | "unsafe" | "const" | "type" => true
  else => false
  end
end

def Linter::is_punctuation(&self, c: Char) -> Bool
  match c
  when '(' | ')' | '[' | ']' | '{' | '}' | ',' | ';' => true
  else => false
  end
end

def Linter::is_operator_char(&self, c: Char) -> Bool
  match c
  when '+' | '-' | '*' | '/' | '%' | '=' | '!' | '<' | '>' | '&' | '|' | '^' | '~' | '.' | ':' | '?' | '@' | '#' | '$' => true
  else => false
  end
end

# ═══════════════════════════════════════════════════════════════
# Line-based Lints
# ═══════════════════════════════════════════════════════════════

def Linter::lint_line_lengths(&mut self, lines: &Vec[String])
  if !self.config.check_style then return end
  
  for (i, line) in lines.enumerate() do
    if line.len() > self.config.max_line_length then
      self.add_lint(
        "line-too-long",
        LintLevel::Warn,
        LintCategory::Style,
        "line exceeds maximum length of ".to_string() + self.config.max_line_length.to_string() + " characters (current: " + line.len().to_string() + ")",
        i, 0, i, line.len(),
        Option::Some("break the line into multiple lines".to_string())
      )
    end
  end
end

def Linter::lint_trailing_whitespace(&mut self, lines: &Vec[String])
  if !self.config.check_style then return end
  
  for (i, line) in lines.enumerate() do
    if line.ends_with(" ") || line.ends_with("\t") then
      self.add_lint(
        "trailing-whitespace",
        LintLevel::Warn,
        LintCategory::Style,
        "trailing whitespace".to_string(),
        i, line.trim_end().len(), i, line.len(),
        Option::Some("remove trailing whitespace".to_string())
      )
    end
  end
end

def Linter::lint_trailing_newlines(&mut self, lines: &Vec[String])
  if !self.config.check_style then return end
  
  # Check for missing trailing newline
  if lines.len() > 0 && lines[lines.len() - 1].len() > 0 then
    self.add_lint(
      "missing-trailing-newline",
      LintLevel::Warn,
      LintCategory::Style,
      "file does not end with a newline".to_string(),
      lines.len() - 1, lines[lines.len() - 1].len(),
      lines.len() - 1, lines[lines.len() - 1].len(),
      Option::Some("add a newline at the end of the file".to_string())
    )
  end
  
  # Check for multiple trailing newlines
  var trailing_empty = 0
  for i in (0..lines.len() - 1).rev() do
    if lines[i].len() == 0 then
      trailing_empty += 1
    else
      break
    end
  end
  
  if trailing_empty > 1 then
    self.add_lint(
      "multiple-trailing-newlines",
      LintLevel::Warn,
      LintCategory::Style,
      "multiple blank lines at end of file".to_string(),
      lines.len() - trailing_empty, 0,
      lines.len() - 1, 0,
      Option::Some("remove extra blank lines".to_string())
    )
  end
end

def Linter::lint_tabs(&mut self, lines: &Vec[String])
  if !self.config.check_style then return end
  
  for (i, line) in lines.enumerate() do
    # Check for tab characters (if spaces preferred)
    if line.contains("\t") then
      self.add_lint(
        "tabs-in-indent",
        LintLevel::Warn,
        LintCategory::Style,
        "tabs found in indentation (prefer spaces)".to_string(),
        i, 0, i, line.len(),
        Option::Some("replace tabs with spaces".to_string())
      )
    end
    
    # Check for inconsistent indentation
    let trimmed = line.trim_start()
    let indent = line.len() - trimmed.len()
    if indent > 0 && indent % 2 != 0 then
      self.add_lint(
        "inconsistent-indentation",
        LintLevel::Warn,
        LintCategory::Style,
        "inconsistent indentation (not a multiple of 2)".to_string(),
        i, 0, i, indent,
        Option::Some("use consistent 2-space indentation".to_string())
      )
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Token-based Lints
# ═══════════════════════════════════════════════════════════════

def Linter::lint_tokens(&mut self, tokens: &Vec[Token])
  if !self.config.check_style then return end
  
  for i in 0..tokens.len() do
    let tok = &tokens[i]
    
    # Check for TODO/FIXME/HACK comments
    if tok.type == TokenType::Comment then
      self.lint_comment_todo(tok)
      self.lint_comment_length(tok)
    end
    
    # Check for magic numbers
    if tok.type == TokenType::Number && i > 0 then
      let prev = &tokens[i - 1]
      # Skip if it's part of a range or version
      if prev.type != TokenType::Operator || (prev.text != "." && prev.text != "..") then
        self.lint_magic_number(tok)
      end
    end
    
    # Check string literals
    if tok.type == TokenType::String then
      self.lint_string_literal(tok)
    end
  end
end

def Linter::lint_comment_todo(&mut self, tok: &Token)
  let lower = tok.text.to_lowercase()
  if lower.contains("todo") || lower.contains("fixme") || lower.contains("hack") || lower.contains("xxx") then
    self.add_lint(
      "todo-comment",
      LintLevel::Warn,
      LintCategory::Style,
      "TODO/FIXME/HACK comment found".to_string(),
      tok.line, tok.column, tok.line, tok.column + tok.text.len(),
      Option::Some("resolve or create an issue to track".to_string())
    )
  end
end

def Linter::lint_comment_length(&mut self, tok: &Token)
  if tok.text.len() > 120 then
    self.add_lint(
      "comment-too-long",
      LintLevel::Allow,
      LintCategory::Style,
      "comment line exceeds 120 characters".to_string(),
      tok.line, tok.column, tok.line, tok.column + tok.text.len(),
      Option::Some("wrap comment to multiple lines".to_string())
    )
  end
end

def Linter::lint_magic_number(&mut self, tok: &Token)
  # Allow 0, 1, 2 as common indices
  if tok.text == "0" || tok.text == "1" || tok.text == "2" then return end
  
  # Allow 0.0, 1.0 as common floats
  if tok.text == "0.0" || tok.text == "1.0" || tok.text == "-1" || tok.text == "-1.0" then return end
  
  self.add_lint(
    "magic-number",
    LintLevel::Allow,
    LintCategory::Style,
    "magic number used without constant definition".to_string(),
    tok.line, tok.column, tok.line, tok.column + tok.text.len(),
    Option::Some("consider defining a named constant".to_string())
  )
end

def Linter::lint_string_literal(&mut self, tok: &Token)
  # Check for empty string
  if tok.text == "\"\"" || tok.text == "''" then
    self.add_lint(
      "empty-string-literal",
      LintLevel::Allow,
      LintCategory::Style,
      "empty string literal".to_string(),
      tok.line, tok.column, tok.line, tok.column + tok.text.len(),
      Option::None
    )
  end
  
  # Check for very long strings on one line
  if tok.text.len() > 80 && tok.text.chars()[0] != '`' then
    self.add_lint(
      "long-string-literal",
      LintLevel::Allow,
      LintCategory::Style,
      "string literal longer than 80 characters".to_string(),
      tok.line, tok.column, tok.line, tok.column + tok.text.len(),
      Option::Some("consider using a multi-line string or constant".to_string())
    )
  end
end

# ═══════════════════════════════════════════════════════════════
# AST-based Lints
# ═══════════════════════════════════════════════════════════════

def Linter::lint_ast(&mut self, tokens: &Vec[Token])
  var pos = 0
  
  while pos < tokens.len() do
    let tok = &tokens[pos]
    
    if tok.type == TokenType::Keyword then
      match tok.text.clone()
      when "def" => pos = self.lint_function(tokens, pos)
      when "struct" => pos = self.lint_struct(tokens, pos)
      when "enum" => pos = self.lint_enum(tokens, pos)
      when "trait" => pos = self.lint_trait(tokens, pos)
      when "impl" => pos = self.lint_impl(tokens, pos)
      when "let" => pos = self.lint_let(tokens, pos)
      when "use" => pos = self.lint_use(tokens, pos)
      else => pos += 1
      end
    else
      pos += 1
    end
  end
end

def Linter::lint_function(&mut self, tokens: &Vec[Token], start: UInt) -> UInt
  var pos = start + 1  # Skip 'def'
  
  # Get function name
  while pos < tokens.len() && tokens[pos].type == TokenType::Whitespace do pos += 1 end
  
  if pos >= tokens.len() || tokens[pos].type != TokenType::Identifier then return pos + 1 end
  
  let name = tokens[pos].text.clone()
  let name_line = tokens[pos].line
  let name_col = tokens[pos].column
  
  # Register symbol
  self.defined_symbols.insert(name.clone(), SymbolInfo {
    name: name.clone(),
    kind: SymbolKind::Function,
    line: name_line,
    column: name_col,
    is_mut: false,
    is_used: false
  })
  
  # Check naming convention
  self.check_function_naming(&name, name_line, name_col)
  
  # Parse parameters
  while pos < tokens.len() && tokens[pos].text != "(" do pos += 1 end
  if pos < tokens.len() && tokens[pos].text == "(" then
    pos += 1
    let param_count = self.count_parameters(tokens, pos)
    
    # Check parameter count
    if param_count > self.config.max_parameters then
      self.add_lint(
        "too-many-arguments",
        LintLevel::Warn,
        LintCategory::Complexity,
        "function has ".to_string() + param_count.to_string() + " parameters (max: " + self.config.max_parameters.to_string() + ")",
        name_line, name_col, name_line, name_col + name.len(),
        Option::Some("consider using a struct or builder pattern".to_string())
      )
    end
    
    pos = self.skip_until(tokens, pos, ")")
  end
  
  # Skip return type
  while pos < tokens.len() && tokens[pos].text != "end" && tokens[pos].type != TokenType::Keyword do
    pos += 1
  end
  
  # Count function length
  let func_start_line = tokens[start].line
  var func_end_line = func_start_line
  var depth = 1
  
  while pos < tokens.len() && depth > 0 do
    if tokens[pos].type == TokenType::Keyword then
      match tokens[pos].text.clone()
      when "def" | "struct" | "enum" | "trait" | "impl" | "if" | "while" | "for" | "match" | "do" => depth += 1
      when "end" => depth -= 1
      else => ()
      end
    end
    if depth > 0 then
      func_end_line = tokens[pos].line
      pos += 1
    end
  end
  
  let func_length = func_end_line - func_start_line + 1
  if func_length > self.config.max_function_length then
    self.add_lint(
      "function-too-long",
      LintLevel::Warn,
      LintCategory::Complexity,
      "function is ".to_string() + func_length.to_string() + " lines (max: " + self.config.max_function_length.to_string() + ")",
      name_line, name_col, name_line, name_col + name.len(),
      Option::Some("consider breaking into smaller functions".to_string())
    )
  end
  
  pos + 1
end

def Linter::count_parameters(&self, tokens: &Vec[Token], start: UInt) -> UInt
  var count = 0u
  var pos = start
  var depth = 1
  
  while pos < tokens.len() && depth > 0 do
    let tok = &tokens[pos]
    if tok.text == "(" then depth += 1
    elsif tok.text == ")" then depth -= 1
    elsif tok.text == "," && depth == 1 then count += 1
    elsif tok.type == TokenType::Identifier && depth == 1 then
      # Check if this is a parameter name (followed by: or, or ))
      if pos + 1 < tokens.len() then
        let next = &tokens[pos + 1]
        if next.text == ":" || next.text == "," || next.text == ")" then
          count += 1
        end
      end
    end
    pos += 1
  end
  
  if count > 0 then count else 0 end
end

def Linter::skip_until(&self, tokens: &Vec[Token], start: UInt, target: String) -> UInt
  var pos = start
  while pos < tokens.len() && tokens[pos].text != target do pos += 1 end
  pos + 1
end

def Linter::check_function_naming(&mut self, name: &String, line: UInt, column: UInt)
  if !self.config.check_style then return end
  
  # Check for snake_case
  let has_upper = name.chars().any(|c| c.is_uppercase())
  if has_upper then
    self.add_lint(
      "function-naming-convention",
      LintLevel::Warn,
      LintCategory::Style,
      "function name '".to_string() + name + "' should use snake_case",
      line, column, line, column + name.len(),
      Option::Some("use snake_case: ".to_string() + &name.to_snake_case())
    )
  end
  
  # Check for too short name
  if name.len() < 3 && name != "id" && name != "fn" then
    self.add_lint(
      "min-ident-chars",
      LintLevel::Allow,
      LintCategory::Style,
      "function name is too short (minimum 3 characters)".to_string(),
      line, column, line, column + name.len(),
      Option::Some("use a more descriptive name".to_string())
    )
  end
  
  # Check for too long name
  if name.len() > 40 then
    self.add_lint(
      "max-ident-chars",
      LintLevel::Allow,
      LintCategory::Style,
      "function name is too long (maximum 40 characters)".to_string(),
      line, column, line, column + name.len(),
      Option::Some("use a shorter, more concise name".to_string())
    )
  end
end

def Linter::lint_struct(&mut self, tokens: &Vec[Token], start: UInt) -> UInt
  var pos = start + 1
  
  while pos < tokens.len() && tokens[pos].type == TokenType::Whitespace do pos += 1 end
  
  if pos >= tokens.len() || tokens[pos].type != TokenType::Identifier then return pos + 1 end
  
  let name = tokens[pos].text.clone()
  let name_line = tokens[pos].line
  let name_col = tokens[pos].column
  
  # Register symbol
  self.defined_symbols.insert(name.clone(), SymbolInfo {
    name: name.clone(),
    kind: SymbolKind::Struct,
    line: name_line,
    column: name_col,
    is_mut: false,
    is_used: false
  })
  
  # Check naming convention (PascalCase)
  self.check_type_naming(&name, "struct", name_line, name_col)
  
  # Skip to end
  pos = self.skip_to_end(tokens, pos)
  pos
end

def Linter::lint_enum(&mut self, tokens: &Vec[Token], start: UInt) -> UInt
  var pos = start + 1
  
  while pos < tokens.len() && tokens[pos].type == TokenType::Whitespace do pos += 1 end
  
  if pos >= tokens.len() || tokens[pos].type != TokenType::Identifier then return pos + 1 end
  
  let name = tokens[pos].text.clone()
  let name_line = tokens[pos].line
  let name_col = tokens[pos].column
  
  # Register symbol
  self.defined_symbols.insert(name.clone(), SymbolInfo {
    name: name.clone(),
    kind: SymbolKind::Enum,
    line: name_line,
    column: name_col,
    is_mut: false,
    is_used: false
  })
  
  # Check naming convention
  self.check_type_naming(&name, "enum", name_line, name_col)
  
  pos = self.skip_to_end(tokens, pos)
  pos
end

def Linter::lint_trait(&mut self, tokens: &Vec[Token], start: UInt) -> UInt
  var pos = start + 1
  
  while pos < tokens.len() && tokens[pos].type == TokenType::Whitespace do pos += 1 end
  
  if pos >= tokens.len() || tokens[pos].type != TokenType::Identifier then return pos + 1 end
  
  let name = tokens[pos].text.clone()
  let name_line = tokens[pos].line
  let name_col = tokens[pos].column
  
  # Register symbol
  self.defined_symbols.insert(name.clone(), SymbolInfo {
    name: name.clone(),
    kind: SymbolKind::Trait,
    line: name_line,
    column: name_col,
    is_mut: false,
    is_used: false
  })
  
  # Check naming convention
  self.check_type_naming(&name, "trait", name_line, name_col)
  
  pos = self.skip_to_end(tokens, pos)
  pos
end

def Linter::lint_impl(&mut self, tokens: &Vec[Token], start: UInt) -> UInt
  var pos = start + 1
  
  while pos < tokens.len() && tokens[pos].type == TokenType::Whitespace do pos += 1 end
  
  if pos >= tokens.len() || tokens[pos].type != TokenType::Identifier then return pos + 1 end
  
  let name = tokens[pos].text.clone()
  
  # Register as impl (not typically used directly)
  self.defined_symbols.insert("impl::".to_string() + &name, SymbolInfo {
    name: name.clone(),
    kind: SymbolKind::Impl,
    line: tokens[pos].line,
    column: tokens[pos].column,
    is_mut: false,
    is_used: true
  })
  
  pos = self.skip_to_end(tokens, pos)
  pos
end

def Linter::lint_let(&mut self, tokens: &Vec[Token], start: UInt) -> UInt
  var pos = start + 1
  
  while pos < tokens.len() && tokens[pos].type == TokenType::Whitespace do pos += 1 end
  
  # Check for mut
  let is_mut = pos < tokens.len() && tokens[pos].text == "mut"
  if is_mut then
    pos += 1
    while pos < tokens.len() && tokens[pos].type == TokenType::Whitespace do pos += 1 end
  end
  
  if pos >= tokens.len() || tokens[pos].type != TokenType::Identifier then return pos + 1 end
  
  let name = tokens[pos].text.clone()
  let name_line = tokens[pos].line
  let name_col = tokens[pos].column
  
  # Track variable
  let count = match self.assigned_vars.get(&name) when Option::Some(c) => c when Option::None => 0u end
  self.assigned_vars.insert(name.clone(), count + 1)
  
  # Check variable naming
  self.check_variable_naming(&name, name_line, name_col)
  
  # Skip to end of statement
  while pos < tokens.len() && tokens[pos].type != TokenType::Newline && tokens[pos].text != ";" do
    pos += 1
  end
  
  pos + 1
end

def Linter::lint_use(&mut self, tokens: &Vec[Token], start: UInt) -> UInt
  var pos = start + 1
  
  # Skip whitespace
  while pos < tokens.len() && tokens[pos].type == TokenType::Whitespace do pos += 1 end
  
  # Check for wildcard imports
  while pos < tokens.len() && tokens[pos].type != TokenType::Newline do
    if tokens[pos].text == "*" then
      self.add_lint(
        "wildcard-import",
        LintLevel::Warn,
        LintCategory::Style,
        "wildcard import used".to_string(),
        tokens[pos].line, tokens[pos].column,
        tokens[pos].line, tokens[pos].column + 1,
        Option::Some("list specific items to import".to_string())
      )
    end
    pos += 1
  end
  
  pos + 1
end

def Linter::check_type_naming(&mut self, name: &String, kind: &String, line: UInt, column: UInt)
  if !self.config.check_style then return end
  
  # Check for PascalCase
  let first_char = name.chars()[0]
  if !first_char.is_uppercase() then
    self.add_lint(
      "type-naming-convention",
      LintLevel::Warn,
      LintCategory::Style,
      kind.clone() + " name '" + name + "' should use PascalCase",
      line, column, line, column + name.len(),
      Option::Some("use PascalCase: ".to_string() + &name.to_pascal_case())
    )
  end
end

def Linter::check_variable_naming(&mut self, name: &String, line: UInt, column: UInt)
  if !self.config.check_style then return end
  
  # Check for snake_case
  let has_upper = name.chars().any(|c| c.is_uppercase())
  if has_upper && name != "self" then
    self.add_lint(
      "variable-naming-convention",
      LintLevel::Warn,
      LintCategory::Style,
      "variable name '".to_string() + name + "' should use snake_case",
      line, column, line, column + name.len(),
      Option::Some("use snake_case: ".to_string() + &name.to_snake_case())
    )
  end
  
  # Check for single character names (except common ones)
  if name.len() == 1 && name != "i" && name != "j" && name != "k" && name != "x" && name != "y" && name != "z" then
    self.add_lint(
      "single-char-variable",
      LintLevel::Allow,
      LintCategory::Style,
      "single character variable name '".to_string() + name + "' may be unclear",
      line, column, line, column + name.len(),
      Option::Some("use a more descriptive name".to_string())
    )
  end
end

def Linter::skip_to_end(&self, tokens: &Vec[Token], start: UInt) -> UInt
  var pos = start
  var depth = 1
  
  while pos < tokens.len() && depth > 0 do
    if tokens[pos].type == TokenType::Keyword then
      match tokens[pos].text.clone()
      when "def" | "struct" | "enum" | "trait" | "impl" | "if" | "while" | "for" | "match" | "do" => depth += 1
      when "end" => depth -= 1
      else => ()
      end
    end
    pos += 1
  end
  
  pos
end

# ═══════════════════════════════════════════════════════════════
# Post-Analysis Lints
# ═══════════════════════════════════════════════════════════════

def Linter::lint_unused_symbols(&mut self)
  if !self.config.check_unused then return end
  
  for (name, info) in &self.defined_symbols do
    if !info.is_used && !self.is_allowed_unused(&name) then
      self.add_lint(
        "unused",
        LintLevel::Warn,
        LintCategory::Correctness,
        match info.kind
        when SymbolKind::Function => "function '".to_string() + name + "' is never called"
        when SymbolKind::Struct => "struct '".to_string() + name + "' is never used"
        when SymbolKind::Enum => "enum '".to_string() + name + "' is never used"
        when SymbolKind::Variable => "variable '".to_string() + name + "' is never used"
        when SymbolKind::Constant => "constant '".to_string() + name + "' is never used"
        else => "symbol '".to_string() + name + "' is never used"
        end,
        info.line, info.column, info.line, info.column + name.len(),
        Option::Some(if name.starts_with("_") then "consider removing".to_string() else "prefix with _ to suppress".to_string() end)
      )
    end
  end
end

def Linter::is_allowed_unused(&self, name: &String) -> Bool
  # Allow underscore-prefixed names
  if name.starts_with("_") then return true end
  
  # Allow main function
  if name == "main" then return true end
  
  # Allow common entry points
  if name == "init" || name == "setup" || name == "teardown" then return true end
  
  false
end

def Linter::lint_shadowing(&mut self)
  if !self.config.check_style then return end
  
  for (name, count) in &self.assigned_vars do
    if count > 1 then
      # Find the symbol info for line/column
      match self.defined_symbols.get(name)
      when Option::Some(info) =>
        self.add_lint(
          "shadowed-variable",
          LintLevel::Warn,
          LintCategory::Style,
          "variable '".to_string() + name + "' shadows an outer variable",
          info.line, info.column, info.line, info.column + name.len(),
          Option::Some("use a different name to avoid confusion".to_string())
        )
      when Option::None => ()
      end
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Helper Methods
# ═══════════════════════════════════════════════════════════════

def Linter::add_lint(&mut self, lint_id: &String, level: LintLevel, category: LintCategory, message: String, line: UInt, column: UInt, end_line: UInt, end_column: UInt, suggestion: Option[String])
  let effective_level = self.config.get_level(lint_id)
  
  # Skip if level is Allow
  match effective_level
  when LintLevel::Allow => return
  else => ()
  end
  
  self.messages.push(LintMessage {
    lint_id: lint_id.clone(),
    level: effective_level,
    category: category,
    message: message,
    file: self.current_file.clone(),
    line: line,
    column: column,
    end_line: end_line,
    end_column: end_column,
    suggestion: suggestion,
    explanation: get_lint_explanation(lint_id)
  })
end

def get_lint_explanation(lint_id: &String) -> String
  match lint_id.clone()
  when "line-too-long" => "Long lines can be hard to read and may cause issues with code review tools."
  when "trailing-whitespace" => "Trailing whitespace is unnecessary and can cause noise in version control diffs."
  when "missing-trailing-newline" => "Files should end with a newline for POSIX compliance and better tooling compatibility."
  when "function-too-long" => "Long functions are harder to understand, test, and maintain. Consider breaking them into smaller, focused functions."
  when "too-many-arguments" => "Functions with many arguments are hard to use and maintain. Consider using a struct or builder pattern."
  when "unused" => "Unused code adds noise and maintenance burden. Remove or prefix with _ if intentionally unused."
  when "wildcard-import" => "Wildcard imports can bring in unexpected names and make dependencies unclear."
  when "magic-number" => "Magic numbers without context are hard to understand. Define named constants for clarity."
  when "todo-comment" => "TODO/FIXME comments should be tracked and resolved."
  when "function-naming-convention" => "Consistent naming improves code readability. Functions should use snake_case."
  when "type-naming-convention" => "Types should use PascalCase to distinguish them from variables."
  when "variable-naming-convention" => "Variables should use snake_case for consistency."
  when "shadowed-variable" => "Variable shadowing can lead to confusion and bugs."
  else => "No explanation available."
  end
end

# ═══════════════════════════════════════════════════════════════
# Public API
# ═══════════════════════════════════════════════════════════════

def lint_source(source: &String) -> Vec[LintMessage]
  let config = LintConfig::default()
  var linter = Linter::new(config)
  linter.lint_file(&"source.tg".to_string(), source)
end

def lint_source_with_config(source: &String, config: &LintConfig) -> Vec[LintMessage]
  var linter = Linter::new(config.clone())
  linter.lint_file(&"source.tg".to_string(), source)
end

def lint_file(path: &String) -> Result[Vec[LintMessage], String]
  let source = match std::fs::read_to_string(path)
  when Result::Ok(s) => s
  when Result::Err(e) => return Result::Err("Failed to read file: ".to_string() + e)
  end
  
  let config = LintConfig::default()
  var linter = Linter::new(config)
  Result::Ok(linter.lint_file(path, &source))
end

def format_lint_results(messages: &Vec[LintMessage]) -> String
  var result = "".to_string()
  var errors = 0u
  var warnings = 0u
  
  for msg in messages do
    result = result + &msg.to_string() + "\n\n"
    
    match msg.level
    when LintLevel::Error | LintLevel::Forbid => errors += 1
    when LintLevel::Warn => warnings += 1
    else => ()
    end
  end
  
  result = result + "\n" + "Found ".to_string() + errors.to_string() + " errors and " + warnings.to_string() + " warnings"
  result
end