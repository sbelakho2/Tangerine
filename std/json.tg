# Tangerine Standard Library — JSON
#
# JSON parsing and generation with full RFC 8259 compliance.
#
# Usage:
#   let obj = json::parse("{\"name\": \"Alice\"}")?
#   let str = json::stringify(&obj)
#   
#   let person = json::from_json[Person](json_str)?
#   let json_str = json::to_json(&person)

use std::core::{Option, Result, Vec, String, Bool, Int, Float, Unit, List, panic}
use std::collections::{Map}
use std::crypto::base64
use std::fmt
use std::serde::{Value, Serialize, Deserialize, Serializer, Deserializer, SerError}
use std::gfx_errors::{Error, ErrorCode}

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

# Parse JSON string to Value
def parse(input: str) -> Result[Value, JsonError]
  let mut parser = JsonParser::new(input)
  parser.parse_value()
end

# Stringify Value to JSON
def stringify(value: Value) -> String
  let mut s = JsonStringifier::new()
  s.write_value(value)
  s.finish()
end

# Stringify with pretty-printing
def stringify_pretty(value: Value, indent: UInt) -> String
  let mut s = JsonStringifier::new_pretty(indent)
  s.write_value(value)
  s.finish()
end

# Serialize any type to JSON string
def to_json[T: Serialize](v: T) -> Result[String, SerError]
  let mut s = JsonSerializer::new()
  v.serialize(&mut s)?
  Result::Ok(s.finish())
end

# Serialize with pretty-printing
def to_json_pretty[T: Serialize](v: T, indent: UInt) -> Result[String, SerError]
  let mut s = JsonSerializer::new_pretty(indent)
  v.serialize(&mut s)?
  Result::Ok(s.finish())
end

# Deserialize from JSON string
def from_json[T: Deserialize](input: str) -> Result[T, JsonError]
  let value = parse(input)?
  let mut d = JsonDeserializer::new(&value)
  match T::deserialize(&mut d)
  when Result::Ok(v) then Result::Ok(v)
  when Result::Err(e) then Result::Err(JsonError::Deserialize(Error::new(ErrorCode::InvalidArg, "deserialization error", "json")))
  end
end

# ———————————————————————————————————————————————————————————————
# Error Types
# ———————————————————————————————————————————————————————————————

# [METADATA]
# module: tg::json
# status: alpha
# effects: []
# capabilities: []
# error_codes: [UnexpectedChar, UnexpectedEof, InvalidNumber, InvalidEscape, InvalidUnicode, TrailingComma, ExpectedColon, ExpectedValue, Deserialize, MaxDepthExceeded]

enum JsonError
  UnexpectedChar(Error)
  UnexpectedEof(Error)
  InvalidNumber(Error)
  InvalidEscape(Error)
  InvalidUnicode(Error)
  TrailingComma(Error)
  ExpectedColon(Error)
  ExpectedValue(Error)
  Deserialize(Error)
  MaxDepthExceeded(Error)
end

impl JsonError
  def message(self: JsonError) -> String
    match self
    when JsonError::UnexpectedChar(e) then e.message.clone()
    when JsonError::UnexpectedEof(e) then e.message.clone()
    when JsonError::InvalidNumber(e) then e.message.clone()
    when JsonError::InvalidEscape(e) then e.message.clone()
    when JsonError::InvalidUnicode(e) then e.message.clone()
    when JsonError::TrailingComma(e) then e.message.clone()
    when JsonError::ExpectedColon(e) then e.message.clone()
    when JsonError::ExpectedValue(e) then e.message.clone()
    when JsonError::Deserialize(e) then e.message.clone()
    when JsonError::MaxDepthExceeded(e) then e.message.clone()
    end
  end

  def code(self: JsonError) -> ErrorCode
    match self
    when JsonError::UnexpectedChar(_) then ErrorCode::InvalidArg
    when JsonError::UnexpectedEof(_) then ErrorCode::IOError
    when JsonError::InvalidNumber(_) then ErrorCode::InvalidArg
    when JsonError::InvalidEscape(_) then ErrorCode::InvalidArg
    when JsonError::InvalidUnicode(_) then ErrorCode::InvalidArg
    when JsonError::TrailingComma(_) then ErrorCode::InvalidArg
    when JsonError::ExpectedColon(_) then ErrorCode::InvalidArg
    when JsonError::ExpectedValue(_) then ErrorCode::InvalidArg
    when JsonError::Deserialize(_) then ErrorCode::InvalidArg
    when JsonError::MaxDepthExceeded(_) then ErrorCode::InvalidArg
    end
  end
end

# ———————————————————————————————————————————————————————————————
# JSON Parser
# ———————————————————————————————————————————————————————————————

# Maximum nesting depth to prevent stack overflow
const MAX_JSON_DEPTH: UInt = 128

struct JsonParser
  input: String
  pos: UInt
  line: UInt
  column: UInt
  # Track nesting depth
  depth: UInt
end

impl JsonParser
  pub def new(input: str) -> JsonParser
    JsonParser {
      input: input.to_string(),
      pos: 0,
      line: 1,
      column: 1,
      depth: 0
    }
  end

  def peek(self: JsonParser) -> Option[Char]
    if self.pos >= self.input.len() then
      Option::None
    else
      Option::Some(self.input.char_at(self.pos))
    end
  end
  
  def advance(inout self: JsonParser) -> Option[Char]
    match self.peek()
    when Option::Some(c) then
      self.pos = self.pos + 1
      if c == '\n' then
        self.line = self.line + 1
        self.column = 1
      else
        self.column = self.column + 1
      end
      Option::Some(c)
    when Option::None then Option::None
    end
  end
  
  def skip_whitespace(inout self: JsonParser) -> Unit
    loop
      match self.peek()
      when Option::Some(c) then
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' then
          self.advance()
        else
          break
        end
      when Option::None then break
      end
    end
  end
  
  def parse_value(inout self: JsonParser) -> Result[Value, JsonError]
    self.skip_whitespace()
    match self.peek()
    when Option::Some(c) then
      match c
      when '{' then self.parse_object()
      when '[' then self.parse_array()
      when '"' then self.parse_string()
      when 't' then self.parse_bool()
      when 'f' then self.parse_bool()
      when 'n' then self.parse_null()
      when '-' then self.parse_number()
      when '0' then self.parse_number()
      when '1' then self.parse_number()
      when '2' then self.parse_number()
      when '3' then self.parse_number()
      when '4' then self.parse_number()
      when '5' then self.parse_number()
      when '6' then self.parse_number()
      when '7' then self.parse_number()
      when '8' then self.parse_number()
      when '9' then self.parse_number()
      when _ then Result::Err(JsonError::UnexpectedChar(Error::new(ErrorCode::InvalidArg, "unexpected char", "json")))
      end
    when Option::None then Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
    end
  end
  
  def parse_object(inout self: JsonParser) -> Result[Value, JsonError]
    # Check depth limit to prevent stack overflow
    if self.depth >= MAX_JSON_DEPTH then
      return Result::Err(JsonError::MaxDepthExceeded(Error::new(ErrorCode::InvalidArg, "max depth exceeded", "json")))
    end
    self.depth = self.depth + 1
    
    self.advance()  # consume '{'
    self.skip_whitespace()
    
    let mut obj: Map[String, Value] = Map::new()
    
    match self.peek()
    when Option::Some('}') then
      self.advance()
      self.depth = self.depth - 1
      return Result::Ok(Value::Object(obj))
    when _ then ()
    end
    
    loop
      self.skip_whitespace()
      
      # Parse key
      match self.peek()
      when Option::Some('"') then ()
      when Option::Some(c) then return Result::Err(JsonError::UnexpectedChar(Error::new(ErrorCode::InvalidArg, "unexpected char", "json")))
      when Option::None then return Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
      end
      
      let key = match self.parse_string()
      when Result::Ok(Value::String(s)) then s
      when Result::Ok(_) then return Result::Err(JsonError::ExpectedValue(Error::new(ErrorCode::InvalidArg, "expected value", "json")))
      when Result::Err(e) then return Result::Err(e)
      end
      
      self.skip_whitespace()
      
      # Expect ':'
      match self.peek()
      when Option::Some(':') then self.advance()
      when _ then return Result::Err(JsonError::ExpectedColon(Error::new(ErrorCode::InvalidArg, "expected colon", "json")))
      end
      
      self.skip_whitespace()
      
      # Parse value
      let value = self.parse_value()?
      obj.insert(key, value)
      
      self.skip_whitespace()
      
      match self.peek()
      when Option::Some(',') then
        self.advance()
        self.skip_whitespace()
        # Check for trailing comma
        match self.peek()
        when Option::Some('}') then
          return Result::Err(JsonError::TrailingComma(Error::new(ErrorCode::InvalidArg, "trailing comma", "json")))
        when _ then ()
        end
      when Option::Some('}') then
        self.advance()
        self.depth = self.depth - 1
        return Result::Ok(Value::Object(obj))
      when Option::Some(c) then return Result::Err(JsonError::UnexpectedChar(Error::new(ErrorCode::InvalidArg, "unexpected char", "json")))
      when Option::None then return Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
      end
    end
  end
  
  def parse_array(inout self: JsonParser) -> Result[Value, JsonError]
    # Check depth limit to prevent stack overflow
    if self.depth >= MAX_JSON_DEPTH then
      return Result::Err(JsonError::MaxDepthExceeded(Error::new(ErrorCode::InvalidArg, "max depth exceeded", "json")))
    end
    self.depth = self.depth + 1
    
    self.advance()  # consume '['
    self.skip_whitespace()
    
    let mut arr: Vec[Value] = Vec::new()
    
    match self.peek()
    when Option::Some(']') then
      self.advance()
      self.depth = self.depth - 1
      return Result::Ok(Value::Array(arr))
    when _ then ()
    end
    
    loop
      self.skip_whitespace()
      let value = self.parse_value()?
      arr.push(value)
      
      self.skip_whitespace()
      
      match self.peek()
      when Option::Some(',') then
        self.advance()
        self.skip_whitespace()
        # Check for trailing comma
        match self.peek()
        when Option::Some(']') then
          return Result::Err(JsonError::TrailingComma(Error::new(ErrorCode::InvalidArg, "trailing comma", "json")))
        when _ then ()
        end
      when Option::Some(']') then
        self.advance()
        self.depth = self.depth - 1
        return Result::Ok(Value::Array(arr))
      when Option::Some(c) then return Result::Err(JsonError::UnexpectedChar(Error::new(ErrorCode::InvalidArg, "unexpected char", "json")))
      when Option::None then return Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
      end
    end
  end
  
  def parse_string(inout self: JsonParser) -> Result[Value, JsonError]
    self.advance()  # consume opening quote
    let mut result = String::new()
    
    loop
      match self.advance()
      when Option::Some('"') then
        return Result::Ok(Value::String(result))
      when Option::Some('\\') then
        match self.advance()
        when Option::Some('n') then result.push('\n')
        when Option::Some('r') then result.push('\r')
        when Option::Some('t') then result.push('\t')
        when Option::Some('\\') then result.push('\\')
        when Option::Some('"') then result.push('"')
        when Option::Some('/') then result.push('/')
        when Option::Some('b') then result.push('\x08')
        when Option::Some('f') then result.push('\x0C')
        when Option::Some('u') then
          let mut code: UInt = 0
          for i in 0..4 do
            match self.advance()
            when Option::Some(h) then
              if h >= '0' && h <= '9' then
                code = code * 16 + (h as UInt - '0' as UInt)
              elsif h >= 'a' && h <= 'f' then
                code = code * 16 + (h as UInt - 'a' as UInt + 10)
              elsif h >= 'A' && h <= 'F' then
                code = code * 16 + (h as UInt - 'A' as UInt + 10)
              else
                return Result::Err(JsonError::InvalidUnicode(Error::new(ErrorCode::InvalidArg, "invalid unicode hex", "json")))
              end
            when Option::None then
              return Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
            end
          end

          if code >= 0xD800 && code <= 0xDBFF then
            match self.peek()
            when Option::Some('\\') then
              self.advance()
              match self.advance()
              when Option::Some('u') then
                let mut low: UInt = 0
                for j in 0..4 do
                  match self.advance()
                  when Option::Some(h2) then
                    if h2 >= '0' && h2 <= '9' then
                      low = low * 16 + (h2 as UInt - '0' as UInt)
                    elsif h2 >= 'a' && h2 <= 'f' then
                      low = low * 16 + (h2 as UInt - 'a' as UInt + 10)
                    elsif h2 >= 'A' && h2 <= 'F' then
                      low = low * 16 + (h2 as UInt - 'A' as UInt + 10)
                    else
                      return Result::Err(JsonError::InvalidUnicode(Error::new(ErrorCode::InvalidArg, "invalid unicode hex", "json")))
                    end
                  when Option::None then
                    return Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
                  end
                end

                if low >= 0xDC00 && low <= 0xDFFF then
                  let codepoint = 0x10000 + (code - 0xD800) * 0x400 + (low - 0xDC00)
                  result.push(char_from_code(codepoint))
                else
                  return Result::Err(JsonError::InvalidUnicode(Error::new(ErrorCode::InvalidArg, "expected low surrogate", "json")))
                end
              when _ then
                return Result::Err(JsonError::InvalidUnicode(Error::new(ErrorCode::InvalidArg, "expected \\u after high surrogate", "json")))
              end
            when _ then
              return Result::Err(JsonError::InvalidUnicode(Error::new(ErrorCode::InvalidArg, "lone high surrogate", "json")))
            end
          elsif code >= 0xDC00 && code <= 0xDFFF then
            return Result::Err(JsonError::InvalidUnicode(Error::new(ErrorCode::InvalidArg, "unexpected low surrogate", "json")))
          else
            result.push(char_from_code(code))
          end
        when Option::Some(c) then
          return Result::Err(JsonError::InvalidEscape(Error::new(ErrorCode::InvalidArg, "invalid escape", "json")))
        when Option::None then return Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
        end
      when Option::Some(c) then
        if c < ' ' then
          return Result::Err(JsonError::InvalidEscape(Error::new(ErrorCode::InvalidArg, "control char", "json")))
        end
        result.push(c)
      when Option::None then return Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
      end
    end end
  end
  
  def parse_number(inout self: JsonParser) -> Result[Value, JsonError]
    let start = self.pos
    let mut is_float = false
    
    # Optional minus
    match self.peek()
    when Option::Some('-') then self.advance()
    when _ then ()
    end
    
    # Integer part
    match self.peek()
    when Option::Some('0') then self.advance()
    when Option::Some(c) then
      if c >= '1' && c <= '9' then
        self.advance()
        while match self.peek()
        when Option::Some(d) then d >= '0' && d <= '9'
        when Option::None then false
        end do
          self.advance()
        end
      else
        return Result::Err(JsonError::InvalidNumber(Error::new(ErrorCode::InvalidArg, "invalid number", "json")))
      end
    when Option::None then return Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
    end
    
    # Fractional part
    match self.peek()
    when Option::Some('.') then
      is_float = true
      self.advance()
      let mut has_digit = false
      while match self.peek()
      when Option::Some(d) then d >= '0' && d <= '9'
      when Option::None then false
      end do
        self.advance()
        has_digit = true
      end
      if !has_digit then
        return Result::Err(JsonError::InvalidNumber(Error::new(ErrorCode::InvalidArg, "no digits after decimal", "json")))
      end
    when _ then ()
    end
    
    # Exponent
    match self.peek()
    when Option::Some('e') | Option::Some('E') then
      is_float = true
      self.advance()
      match self.peek()
      when Option::Some('+') | Option::Some('-') then self.advance()
      when _ then ()
      end
      let mut has_digit = false
      while match self.peek()
      when Option::Some(d) then d >= '0' && d <= '9'
      when Option::None then false
      end do
        self.advance()
        has_digit = true
      end
      if !has_digit then
        return Result::Err(JsonError::InvalidNumber(Error::new(ErrorCode::InvalidArg, "no digits in exponent", "json")))
      end
    when _ then ()
    end
    
    let num_str = self.input.slice(start, self.pos)
    if is_float then
      match parse_float(&num_str)
      when Option::Some(f) then Result::Ok(Value::Float(f))
      when Option::None then Result::Err(JsonError::InvalidNumber(Error::new(ErrorCode::InvalidArg, "invalid float", "json")))
      end
    else
      match parse_int(&num_str)
      when Option::Some(i) then Result::Ok(Value::Int(i))
      when Option::None then Result::Err(JsonError::InvalidNumber(Error::new(ErrorCode::InvalidArg, "invalid int", "json")))
      end
    end
  end
  
  def parse_bool(inout self: JsonParser) -> Result[Value, JsonError]
    if self.matches("true") then
      Result::Ok(Value::Bool(true))
    elsif self.matches("false") then
      Result::Ok(Value::Bool(false))
    else
      match self.peek()
      when Option::Some(_) then Result::Err(JsonError::UnexpectedChar(Error::new(ErrorCode::InvalidArg, "expected bool", "json")))
      when Option::None then Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
      end
    end
  end
  
  def parse_null(inout self: JsonParser) -> Result[Value, JsonError]
    if self.matches("null") then
      Result::Ok(Value::Null)
    else
      match self.peek()
      when Option::Some(_) then Result::Err(JsonError::UnexpectedChar(Error::new(ErrorCode::InvalidArg, "expected null", "json")))
      when Option::None then Result::Err(JsonError::UnexpectedEof(Error::new(ErrorCode::IOError, "unexpected eof", "json")))
      end
    end
  end
  
  def matches(inout self: JsonParser, s: str) -> Bool
    let len = s.len()
    if self.pos + len > self.input.len() then
      return false
    end
    for i in 0..len do
      if self.input.char_at(self.pos + i) != s.char_at(i) then
        return false
      end
    end
    self.pos = self.pos + len
    self.column = self.column + len
    true
  end
end

# ———————————————————————————————————————————————————————————————
# JSON Stringifier
# ———————————————————————————————————————————————————————————————

struct JsonStringifier
  output: String
  pretty: Bool
  indent: UInt
  depth: UInt
end

impl JsonStringifier
  pub def new() -> JsonStringifier
    JsonStringifier { output: String::new(), pretty: false, indent: 0, depth: 0 }
  end

  pub def new_pretty(indent: UInt) -> JsonStringifier
    JsonStringifier { output: String::new(), pretty: true, indent: indent, depth: 0 }
  end

  def finish(self: JsonStringifier) -> String
    self.output.clone()
  end
  
  def write_value(inout self: JsonStringifier, v: Value) -> Unit
    match v
    when Value::Null then self.output.push_str("null")
    when Value::Bool(b) then
      if b then self.output.push_str("true")
      else self.output.push_str("false")
      end
    when Value::Int(i) then self.output.push_str(i.to_string().as_str())
    when Value::Float(f) then self.output.push_str(f.to_string().as_str())
    when Value::String(s) then self.write_string(&s)
    when Value::Array(arr) then self.write_array(&arr)
    when Value::Object(obj) then self.write_object(&obj)
    end
  end
  
  def write_string(inout self: JsonStringifier, s: String) -> Unit
    self.output.push('"')
    for c in s.chars() do
      match c
      when '"' then self.output.push_str("\\\"")
      when '\\' then self.output.push_str("\\\\")
      when '\n' then self.output.push_str("\\n")
      when '\r' then self.output.push_str("\\r")
      when '\t' then self.output.push_str("\\t")
      when _ then
        let cp = c as UInt
        if cp < 0x20 then
          self.output.push_str("\\u")
          self.output.push_str(format_hex4(cp).as_str())
        elsif cp > 0xFFFF then
          ## Supplementary plane: emit surrogate pair
          let adj = cp - 0x10000
          let high = 0xD800 + (adj >> 10)
          let low = 0xDC00 + (adj & 0x3FF)
          self.output.push_str("\\u")
          self.output.push_str(format_hex4(high).as_str())
          self.output.push_str("\\u")
          self.output.push_str(format_hex4(low).as_str())
        else
          self.output.push(c)
        end
      end
    end
    self.output.push('"')
  end
  
  def write_array(inout self: JsonStringifier, arr: Vec[Value]) -> Unit
    self.output.push('[')
    if self.pretty && !arr.is_empty() then
      self.depth = self.depth + 1
      self.write_newline()
    end
    
    for i in 0..arr.len() do
      if i > 0 then
        self.output.push(',')
        if self.pretty then self.write_newline() end
      end
      if self.pretty then self.write_indent() end
      match arr.get(i)
      when Option::Some(v) then self.write_value(&v)
      when Option::None then ()
      end
    end
    
    if self.pretty && !arr.is_empty() then
      self.depth = self.depth - 1
      self.write_newline()
      self.write_indent()
    end
    self.output.push(']')
  end
  
  def write_object(inout self: JsonStringifier, obj: Map[String, Value]) -> Unit
    self.output.push('{')
    if self.pretty && !obj.is_empty() then
      self.depth = self.depth + 1
      self.write_newline()
    end
    
    let mut first = true
    for entry in obj do
      let (k, v) = entry
      if !first then
        self.output.push(',')
        if self.pretty then self.write_newline() end
      end
      first = false
      if self.pretty then self.write_indent() end
      self.write_string(&k)
      self.output.push(':')
      if self.pretty then self.output.push(' ') end
      self.write_value(&v)
    end
    
    if self.pretty && !obj.is_empty() then
      self.depth = self.depth - 1
      self.write_newline()
      self.write_indent()
    end
    self.output.push('}')
  end
  
  def write_newline(inout self: JsonStringifier) -> Unit
    self.output.push('\n')
  end
  
  def write_indent(inout self: JsonStringifier) -> Unit
    for _ in 0..(self.depth * self.indent) do
      self.output.push(' ')
    end
  end
end

# ———————————————————————————————————————————————————————————————
# JSON Serializer (implements Serializer trait)
# ———————————————————————————————————————————————————————————————

struct JsonSerializer
  output: String
  pretty: Bool
  indent: UInt
  depth: UInt
  state: Vec[JsonSerState]
end

enum JsonSerState
  Root
  InArray(Bool)     # has_elements
  InObject(Bool)    # has_fields, expecting_value
end

impl JsonSerializer
  pub def new() -> JsonSerializer
    let mut state = Vec::new()
    state.push(JsonSerState::Root)
    JsonSerializer {
      output: String::new(),
      pretty: false,
      indent: 0,
      depth: 0,
      state: state
    }
  end

  pub def new_pretty(indent: UInt) -> JsonSerializer
    let mut state = Vec::new()
    state.push(JsonSerState::Root)
    JsonSerializer {
      output: String::new(),
      pretty: true,
      indent: indent,
      depth: 0,
      state: state
    }
  end

  def finish(self: JsonSerializer) -> String
    self.output.clone()
  end
  
  def pre_value(inout self: JsonSerializer) -> Unit
    match self.state.last()
    when Option::Some(JsonSerState::InArray(has)) then
      if has then
        self.output.push(',')
        if self.pretty then
          self.output.push('\n')
          self.write_indent()
        end
      else
        if self.pretty then
          self.output.push('\n')
          self.write_indent()
        end
      end
    when _ then ()
    end
  end
  
  def post_value(inout self: JsonSerializer) -> Unit
    match self.state.last_mut()
    when Option::Some(JsonSerState::InArray(has)) then
      *has = true
    when _ then ()
    end
  end
  
  def write_indent(inout self: JsonSerializer) -> Unit
    for _ in 0..(self.depth * self.indent) do
      self.output.push(' ')
    end
  end
  
  def write_string(inout self: JsonSerializer, s: str) -> Unit
    self.output.push('"')
    for c in s.chars() do
      match c
      when '"' then self.output.push_str("\\\"")
      when '\\' then self.output.push_str("\\\\")
      when '\n' then self.output.push_str("\\n")
      when '\r' then self.output.push_str("\\r")
      when '\t' then self.output.push_str("\\t")
      when _ then
        let cp = c as UInt
        if cp < 0x20 then
          self.output.push_str("\\u")
          self.output.push_str(format_hex4(cp).as_str())
        elsif cp > 0xFFFF then
          ## Supplementary plane: emit surrogate pair
          let adj = cp - 0x10000
          let high = 0xD800 + (adj >> 10)
          let low = 0xDC00 + (adj & 0x3FF)
          self.output.push_str("\\u")
          self.output.push_str(format_hex4(high).as_str())
          self.output.push_str("\\u")
          self.output.push_str(format_hex4(low).as_str())
        else
          self.output.push(c)
        end
      end
    end
    self.output.push('"')
  end
end

impl Serializer for JsonSerializer
  def serialize_bool(inout self: JsonSerializer, v: Bool) -> Result[Unit, SerError]
    self.pre_value()
    if v then self.output.push_str("true")
    else self.output.push_str("false")
    end
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_int(inout self: JsonSerializer, v: Int) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push_str(v.to_string().as_str())
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_float(inout self: JsonSerializer, v: Float) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push_str(v.to_string().as_str())
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_str(inout self: JsonSerializer, v: str) -> Result[Unit, SerError]
    self.pre_value()
    self.write_string(v)
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_bytes(inout self: JsonSerializer, v: [u8]) -> Result[Unit, SerError]
    # Encode as base64 string
    self.pre_value()
    self.output.push('"')
    self.output.push_str(base64::encode(v).as_str())
    self.output.push('"')
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_none(inout self: JsonSerializer) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push_str("null")
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_some(inout self: JsonSerializer, v: dyn Serialize) -> Result[Unit, SerError]
    v.serialize(self)
  end
  
  def serialize_seq_begin(inout self: JsonSerializer, len: Option[UInt]) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push('[')
    self.depth = self.depth + 1
    self.state.push(JsonSerState::InArray(false))
    Result::Ok(())
  end
  
  def serialize_seq_element(inout self: JsonSerializer, v: dyn Serialize) -> Result[Unit, SerError]
    v.serialize(self)
  end
  
  def serialize_seq_end(inout self: JsonSerializer) -> Result[Unit, SerError]
    self.state.pop()
    self.depth = self.depth - 1
    if self.pretty then
      self.output.push('\n')
      self.write_indent()
    end
    self.output.push(']')
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_map_begin(inout self: JsonSerializer, len: Option[UInt]) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push('{')
    self.depth = self.depth + 1
    self.state.push(JsonSerState::InObject(false))
    Result::Ok(())
  end
  
  def serialize_map_key(inout self: JsonSerializer, k: str) -> Result[Unit, SerError]
    match self.state.last_mut()
    when Option::Some(JsonSerState::InObject(has)) then
      if has then
        self.output.push(',')
      end
      *has = true
    when _ then ()
    end
    if self.pretty then
      self.output.push('\n')
      self.write_indent()
    end
    self.write_string(k)
    self.output.push(':')
    if self.pretty then self.output.push(' ') end
    Result::Ok(())
  end
  
  def serialize_map_value(inout self: JsonSerializer, v: dyn Serialize) -> Result[Unit, SerError]
    # Don't call pre/post_value since key already handled separator.
    # Keep serializer state intact even if value serialization fails.
    v.serialize(self)
  end
  
  def serialize_map_end(inout self: JsonSerializer) -> Result[Unit, SerError]
    self.state.pop()
    self.depth = self.depth - 1
    if self.pretty then
      self.output.push('\n')
      self.write_indent()
    end
    self.output.push('}')
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_struct_begin(inout self: JsonSerializer, name: str, len: UInt) -> Result[Unit, SerError]
    self.serialize_map_begin(Option::Some(len))
  end
  
  def serialize_struct_field(inout self: JsonSerializer, name: str, v: dyn Serialize) -> Result[Unit, SerError]
    self.serialize_map_key(name)?
    self.serialize_map_value(v)
  end
  
  def serialize_struct_end(inout self: JsonSerializer) -> Result[Unit, SerError]
    self.serialize_map_end()
  end
end

# ———————————————————————————————————————————————————————————————
# JSON Deserializer (implements Deserializer trait)
# ———————————————————————————————————————————————————————————————

struct JsonDeserializer
  value: Ptr[Value]
end

impl JsonDeserializer
  pub def new(v: Value) -> JsonDeserializer
    JsonDeserializer { value: address_of(&mut v) as Ptr[Value] }
  end
end

impl Deserializer for JsonDeserializer
  def deserialize_bool(inout self: JsonDeserializer) -> Result[Bool, SerError]
    match self.value.as_ref()
    when Value::Bool(b) then Result::Ok(b.clone())
    when _ then Result::Err(SerError::InvalidType("expected bool"))
    end
  end
  
  def deserialize_int(inout self: JsonDeserializer) -> Result[Int, SerError]
    match self.value.as_ref()
    when Value::Int(i) then Result::Ok(i.clone())
    when Value::Float(f) then Result::Ok(f.clone() as Int)
    when _ then Result::Err(SerError::InvalidType("expected int"))
    end
  end
  
  def deserialize_float(inout self: JsonDeserializer) -> Result[Float, SerError]
    match self.value.as_ref()
    when Value::Float(f) then Result::Ok(f.clone())
    when Value::Int(i) then Result::Ok(i.clone() as Float)
    when _ then Result::Err(SerError::InvalidType("expected float"))
    end
  end
  
  def deserialize_str(inout self: JsonDeserializer) -> Result[String, SerError]
    match self.value.as_ref()
    when Value::String(s) then Result::Ok(s.clone())
    when _ then Result::Err(SerError::InvalidType("expected string"))
    end
  end
  
  def deserialize_bytes(inout self: JsonDeserializer) -> Result[Vec[u8], SerError]
    match self.value.as_ref()
    when Value::String(s) then
      match base64::decode(&s)
      when Result::Ok(bytes) then Result::Ok(bytes)
      when Result::Err(_) then Result::Err(SerError::InvalidValue("invalid base64"))
      end
    when Value::Array(arr) then
      let mut bytes = Vec::new()
      for item in arr do
        match item
        when Value::Int(n) then
          if n >= 0 && n <= 255 then
            bytes.push(n as u8)
          else
            return Result::Err(SerError::InvalidValue("byte value out of range: " + n.to_string()))
          end
        when _ then
          return Result::Err(SerError::InvalidType("expected integer in byte array"))
        end
      end
      Result::Ok(bytes)
    when _ then Result::Err(SerError::InvalidType("expected string or array"))
    end
  end
  
  def deserialize_option[T: Deserialize](inout self: JsonDeserializer) -> Result[Option[T], SerError]
    match self.value.as_ref()
    when Value::Null then Result::Ok(Option::None)
    when _ then
      let inner = T::deserialize(self)?
      Result::Ok(Option::Some(inner))
    end
  end
  
  def deserialize_seq[T: Deserialize](inout self: JsonDeserializer) -> Result[Vec[T], SerError]
    match self.value.as_ref()
    when Value::Array(arr) then
      let mut result = Vec::new()
      for item in arr do
        let mut d = JsonDeserializer::new(&item)
        result.push(T::deserialize(&mut d)?)
      end
      Result::Ok(result)
    when _ then Result::Err(SerError::InvalidType("expected array"))
    end
  end
  
  def deserialize_map[K: Deserialize, V: Deserialize](inout self: JsonDeserializer) -> Result[Map[K, V], SerError]
    match self.value.as_ref()
    when Value::Object(obj) then
      let mut result = Map::new()
      for entry in obj do
        let (k, v) = entry
        let mut kd = JsonDeserializer::new(&Value::String(k.clone()))
        let mut vd = JsonDeserializer::new(&v)
        result.insert(K::deserialize(&mut kd)?, V::deserialize(&mut vd)?)
      end
      Result::Ok(result)
    when _ then Result::Err(SerError::InvalidType("expected object"))
    end
  end
  
  def deserialize_struct[T: Deserialize](inout self: JsonDeserializer,
      name: str, fields: [String]) -> Result[T, SerError]
    T::deserialize(self)
  end

  ## Deserialize any JSON value without knowing its type in advance.
  ## Dispatches on all 7 Value variants and returns the parsed Value.
  def deserialize_any(inout self: JsonDeserializer) -> Result[Value, SerError]
    match self.value.as_ref()
    when Value::Null then Result::Ok(Value::Null)
    when Value::Bool(b) then Result::Ok(Value::Bool(b.clone()))
    when Value::Int(n) then Result::Ok(Value::Int(n.clone()))
    when Value::Float(f) then Result::Ok(Value::Float(f.clone()))
    when Value::String(s) then Result::Ok(Value::String(s.clone()))
    when Value::Array(arr) then Result::Ok(Value::Array(arr.clone()))
    when Value::Object(obj) then Result::Ok(Value::Object(obj.clone()))
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Helper Functions
# ———————————————————————————————————————————————————————————————

def char_from_code(code: UInt) -> Char
  ## Convert unicode codepoint to char.
  ## Validates the codepoint is a valid Unicode scalar value (not a surrogate).
  if code <= 0x10FFFF && !(code >= 0xD800 && code <= 0xDFFF) then
    code as Char
  else
    '\u{FFFD}'  ## Replacement character for invalid codepoints
  end
end

def format_hex4(n: UInt) -> String
  let digits = "0123456789abcdef"
  let mut result = String::new()
  result.push(digits.char_at((n >> 12) & 0xF))
  result.push(digits.char_at((n >> 8) & 0xF))
  result.push(digits.char_at((n >> 4) & 0xF))
  result.push(digits.char_at(n & 0xF))
  result
end

def parse_int(s: String) -> Option[Int]
  let mut result: Int = 0
  let mut neg = false
  let mut i = 0
  
  if s.len() > 0 && s.char_at(0) == '-' then
    neg = true
    i = 1
  end
  
  while i < s.len() do
    let c = s.char_at(i)
    if c >= '0' && c <= '9' then
      result = result * 10 + (c as Int - '0' as Int)
    else
      return Option::None
    end
    i = i + 1
  end
  
  if neg then result = -result end
  Option::Some(result)
end

def parse_float(s: String) -> Option[Float]
  fmt::parse_float(s.clone())
end
