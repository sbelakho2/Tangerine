# Tangerine Standard Library — JSON
#
# JSON parsing and generation with full RFC 8259 compliance.
#
# Usage:
#   let obj = json::parse("{\"name\": \"Alice\"}")?
#   let str = json::stringify(&obj)
#   
#   let person = json::from_json[Person](json_str)?
#   let json_str = json::to_json(&person)

use std::core::{Option, Result, Vec, String, Bool, Int, Float, panic}
use std::collections::{Map}
use std::serde::{Value, Serialize, Deserialize, Serializer, Deserializer, SerError}

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

# Parse JSON string to Value
def parse(input: &str) -> Result[Value, JsonError]
  let mut parser = JsonParser::new(input)
  parser.parse_value()
end

# Stringify Value to JSON
def stringify(value: &Value) -> String
  let mut s = JsonStringifier::new()
  s.write_value(value)
  s.finish()
end

# Stringify with pretty-printing
def stringify_pretty(value: &Value, indent: UInt) -> String
  let mut s = JsonStringifier::new_pretty(indent)
  s.write_value(value)
  s.finish()
end

# Serialize any type to JSON string
def to_json[T: Serialize](v: &T) -> Result[String, SerError]
  let mut s = JsonSerializer::new()
  v.serialize(&mut s)?
  Result::Ok(s.finish())
end

# Serialize with pretty-printing
def to_json_pretty[T: Serialize](v: &T, indent: UInt) -> Result[String, SerError]
  let mut s = JsonSerializer::new_pretty(indent)
  v.serialize(&mut s)?
  Result::Ok(s.finish())
end

# Deserialize from JSON string
def from_json[T: Deserialize](input: &str) -> Result[T, JsonError]
  let value = parse(input)?
  let mut d = JsonDeserializer::new(&value)
  match T::deserialize(&mut d)
  when Result::Ok(v) then Result::Ok(v)
  when Result::Err(e) then Result::Err(JsonError::Deserialize(ser_error_message(&e)))
  end
end

# ———————————————————————————————————————————————————————————————
# Error Types
# ———————————————————————————————————————————————————————————————

enum JsonError
  UnexpectedChar(Char, UInt, UInt)    # char, line, column
  UnexpectedEof
  InvalidNumber(String)
  InvalidEscape(String)
  InvalidUnicode(String)
  TrailingComma(UInt, UInt)
  ExpectedColon(UInt, UInt)
  ExpectedValue(UInt, UInt)
  Deserialize(String)
end

def json_error_message(e: &JsonError) -> String
  match e
  when JsonError::UnexpectedChar(c, line, col) then
    "unexpected '" + c.to_string() + "' at " + line.to_string() + ":" + col.to_string()
  when JsonError::UnexpectedEof then "unexpected end of input"
  when JsonError::InvalidNumber(s) then "invalid number: " + s.clone()
  when JsonError::InvalidEscape(s) then "invalid escape: " + s.clone()
  when JsonError::InvalidUnicode(s) then "invalid unicode: " + s.clone()
  when JsonError::TrailingComma(line, col) then
    "trailing comma at " + line.to_string() + ":" + col.to_string()
  when JsonError::ExpectedColon(line, col) then
    "expected ':' at " + line.to_string() + ":" + col.to_string()
  when JsonError::ExpectedValue(line, col) then
    "expected value at " + line.to_string() + ":" + col.to_string()
  when JsonError::Deserialize(s) then "deserialize error: " + s.clone()
  end
end

impl Error for JsonError
  def message(&self) -> String
    json_error_message(self)
  end
end

# ———————————————————————————————————————————————————————————————
# JSON Parser
# ———————————————————————————————————————————————————————————————

struct JsonParser
  input: String
  pos: UInt
  line: UInt
  column: UInt
end

def JsonParser::new(input: &str) -> JsonParser
  JsonParser {
    input: input.to_string(),
    pos: 0,
    line: 1,
    column: 1
  }
end

impl JsonParser
  def peek(self: &JsonParser) -> Option[Char]
    if self.pos >= self.input.len() then
      Option::None
    else
      Option::Some(self.input.char_at(self.pos))
    end
  end
  
  def advance(self: &mut JsonParser) -> Option[Char]
    match self.peek()
    when Option::Some(c) then
      self.pos = self.pos + 1
      if c == '\n' then
        self.line = self.line + 1
        self.column = 1
      else
        self.column = self.column + 1
      end
      Option::Some(c)
    when Option::None then Option::None
    end
  end
  
  def skip_whitespace(self: &mut JsonParser) -> Unit
    loop
      match self.peek()
      when Option::Some(c) then
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' then
          self.advance()
        else
          break
        end
      when Option::None then break
      end
    end
  end
  
  def parse_value(self: &mut JsonParser) -> Result[Value, JsonError]
    self.skip_whitespace()
    match self.peek()
    when Option::Some(c) then
      if c == '{' then self.parse_object()
      else if c == '[' then self.parse_array()
      else if c == '"' then self.parse_string()
      else if c == 't' || c == 'f' then self.parse_bool()
      else if c == 'n' then self.parse_null()
      else if c == '-' || (c >= '0' && c <= '9') then self.parse_number()
      else Result::Err(JsonError::UnexpectedChar(c, self.line, self.column))
      end end end end end end
    when Option::None then Result::Err(JsonError::UnexpectedEof)
    end
  end
  
  def parse_object(self: &mut JsonParser) -> Result[Value, JsonError]
    self.advance()  # consume '{'
    self.skip_whitespace()
    
    let mut obj: Map[String, Value] = Map::new()
    
    match self.peek()
    when Option::Some('}') then
      self.advance()
      return Result::Ok(Value::Object(obj))
    when _ then ()
    end
    
    loop
      self.skip_whitespace()
      
      # Parse key
      match self.peek()
      when Option::Some('"') then ()
      when Option::Some(c) then return Result::Err(JsonError::UnexpectedChar(c, self.line, self.column))
      when Option::None then return Result::Err(JsonError::UnexpectedEof)
      end
      
      let key = match self.parse_string()
      when Result::Ok(Value::String(s)) then s
      when Result::Ok(_) then return Result::Err(JsonError::ExpectedValue(self.line, self.column))
      when Result::Err(e) then return Result::Err(e)
      end
      
      self.skip_whitespace()
      
      # Expect ':'
      match self.peek()
      when Option::Some(':') then self.advance()
      when _ then return Result::Err(JsonError::ExpectedColon(self.line, self.column))
      end
      
      self.skip_whitespace()
      
      # Parse value
      let value = self.parse_value()?
      obj.insert(key, value)
      
      self.skip_whitespace()
      
      match self.peek()
      when Option::Some(',') then
        self.advance()
        self.skip_whitespace()
        # Check for trailing comma
        match self.peek()
        when Option::Some('}') then
          return Result::Err(JsonError::TrailingComma(self.line, self.column))
        when _ then ()
        end
      when Option::Some('}') then
        self.advance()
        return Result::Ok(Value::Object(obj))
      when Option::Some(c) then return Result::Err(JsonError::UnexpectedChar(c, self.line, self.column))
      when Option::None then return Result::Err(JsonError::UnexpectedEof)
      end
    end
  end
  
  def parse_array(self: &mut JsonParser) -> Result[Value, JsonError]
    self.advance()  # consume '['
    self.skip_whitespace()
    
    let mut arr: Vec[Value] = Vec::new()
    
    match self.peek()
    when Option::Some(']') then
      self.advance()
      return Result::Ok(Value::Array(arr))
    when _ then ()
    end
    
    loop
      self.skip_whitespace()
      let value = self.parse_value()?
      arr.push(value)
      
      self.skip_whitespace()
      
      match self.peek()
      when Option::Some(',') then
        self.advance()
        self.skip_whitespace()
        # Check for trailing comma
        match self.peek()
        when Option::Some(']') then
          return Result::Err(JsonError::TrailingComma(self.line, self.column))
        when _ then ()
        end
      when Option::Some(']') then
        self.advance()
        return Result::Ok(Value::Array(arr))
      when Option::Some(c) then return Result::Err(JsonError::UnexpectedChar(c, self.line, self.column))
      when Option::None then return Result::Err(JsonError::UnexpectedEof)
      end
    end
  end
  
  def parse_string(self: &mut JsonParser) -> Result[Value, JsonError]
    self.advance()  # consume opening quote
    let mut result = String::new()
    
    loop
      match self.advance()
      when Option::Some('"') then
        return Result::Ok(Value::String(result))
      when Option::Some('\\') then
        match self.advance()
        when Option::Some('n') then result.push('\n')
        when Option::Some('r') then result.push('\r')
        when Option::Some('t') then result.push('\t')
        when Option::Some('\\') then result.push('\\')
        when Option::Some('"') then result.push('"')
        when Option::Some('/') then result.push('/')
        when Option::Some('b') then result.push('\x08')
        when Option::Some('f') then result.push('\x0C')
        when Option::Some('u') then
          # Parse 4 hex digits
          let mut code: UInt = 0
          for i in 0..4 do
            match self.advance()
            when Option::Some(h) then
              if h >= '0' && h <= '9' then
                code = code * 16 + (h as UInt - '0' as UInt)
              else if h >= 'a' && h <= 'f' then
                code = code * 16 + (h as UInt - 'a' as UInt + 10)
              else if h >= 'A' && h <= 'F' then
                code = code * 16 + (h as UInt - 'A' as UInt + 10)
              else
                return Result::Err(JsonError::InvalidUnicode(h.to_string()))
              end end end
            when Option::None then return Result::Err(JsonError::UnexpectedEof)
            end
          end
          result.push(char_from_code(code))
        when Option::Some(c) then
          return Result::Err(JsonError::InvalidEscape("\\" + c.to_string()))
        when Option::None then return Result::Err(JsonError::UnexpectedEof)
        end
      when Option::Some(c) then
        if c < ' ' then
          return Result::Err(JsonError::InvalidEscape("control char"))
        end
        result.push(c)
      when Option::None then return Result::Err(JsonError::UnexpectedEof)
      end
    end
  end
  
  def parse_number(self: &mut JsonParser) -> Result[Value, JsonError]
    let start = self.pos
    let mut is_float = false
    
    # Optional minus
    match self.peek()
    when Option::Some('-') then self.advance()
    when _ then ()
    end
    
    # Integer part
    match self.peek()
    when Option::Some('0') then self.advance()
    when Option::Some(c) then
      if c >= '1' && c <= '9' then
        self.advance()
        while match self.peek()
        when Option::Some(d) then d >= '0' && d <= '9'
        when Option::None then false
        end do
          self.advance()
        end
      else
        return Result::Err(JsonError::InvalidNumber(c.to_string()))
      end
    when Option::None then return Result::Err(JsonError::UnexpectedEof)
    end
    
    # Fractional part
    match self.peek()
    when Option::Some('.') then
      is_float = true
      self.advance()
      let mut has_digit = false
      while match self.peek()
      when Option::Some(d) then d >= '0' && d <= '9'
      when Option::None then false
      end do
        self.advance()
        has_digit = true
      end
      if !has_digit then
        return Result::Err(JsonError::InvalidNumber("no digits after decimal"))
      end
    when _ then ()
    end
    
    # Exponent
    match self.peek()
    when Option::Some('e') | Option::Some('E') then
      is_float = true
      self.advance()
      match self.peek()
      when Option::Some('+') | Option::Some('-') then self.advance()
      when _ then ()
      end
      let mut has_digit = false
      while match self.peek()
      when Option::Some(d) then d >= '0' && d <= '9'
      when Option::None then false
      end do
        self.advance()
        has_digit = true
      end
      if !has_digit then
        return Result::Err(JsonError::InvalidNumber("no digits in exponent"))
      end
    when _ then ()
    end
    
    let num_str = self.input.slice(start, self.pos)
    if is_float then
      match parse_float(&num_str)
      when Option::Some(f) then Result::Ok(Value::Float(f))
      when Option::None then Result::Err(JsonError::InvalidNumber(num_str))
      end
    else
      match parse_int(&num_str)
      when Option::Some(i) then Result::Ok(Value::Int(i))
      when Option::None then Result::Err(JsonError::InvalidNumber(num_str))
      end
    end
  end
  
  def parse_bool(self: &mut JsonParser) -> Result[Value, JsonError]
    if self.matches("true") then
      Result::Ok(Value::Bool(true))
    else if self.matches("false") then
      Result::Ok(Value::Bool(false))
    else
      match self.peek()
      when Option::Some(c) then Result::Err(JsonError::UnexpectedChar(c, self.line, self.column))
      when Option::None then Result::Err(JsonError::UnexpectedEof)
      end
    end end
  end
  
  def parse_null(self: &mut JsonParser) -> Result[Value, JsonError]
    if self.matches("null") then
      Result::Ok(Value::Null)
    else
      match self.peek()
      when Option::Some(c) then Result::Err(JsonError::UnexpectedChar(c, self.line, self.column))
      when Option::None then Result::Err(JsonError::UnexpectedEof)
      end
    end
  end
  
  def matches(self: &mut JsonParser, s: &str) -> Bool
    let len = s.len()
    if self.pos + len > self.input.len() then
      return false
    end
    for i in 0..len do
      if self.input.char_at(self.pos + i) != s.char_at(i) then
        return false
      end
    end
    self.pos = self.pos + len
    self.column = self.column + len
    true
  end
end

# ———————————————————————————————————————————————————————————————
# JSON Stringifier
# ———————————————————————————————————————————————————————————————

struct JsonStringifier
  output: String
  pretty: Bool
  indent: UInt
  depth: UInt
end

def JsonStringifier::new() -> JsonStringifier
  JsonStringifier { output: String::new(), pretty: false, indent: 0, depth: 0 }
end

def JsonStringifier::new_pretty(indent: UInt) -> JsonStringifier
  JsonStringifier { output: String::new(), pretty: true, indent: indent, depth: 0 }
end

impl JsonStringifier
  def finish(self: &JsonStringifier) -> String
    self.output.clone()
  end
  
  def write_value(self: &mut JsonStringifier, v: &Value) -> Unit
    match v
    when Value::Null then self.output.push_str("null")
    when Value::Bool(b) then
      if b then self.output.push_str("true")
      else self.output.push_str("false")
      end
    when Value::Int(i) then self.output.push_str(i.to_string().as_str())
    when Value::Float(f) then self.output.push_str(f.to_string().as_str())
    when Value::String(s) then self.write_string(&s)
    when Value::Array(arr) then self.write_array(&arr)
    when Value::Object(obj) then self.write_object(&obj)
    end
  end
  
  def write_string(self: &mut JsonStringifier, s: &String) -> Unit
    self.output.push('"')
    for c in s.chars() do
      match c
      when '"' then self.output.push_str("\\\"")
      when '\\' then self.output.push_str("\\\\")
      when '\n' then self.output.push_str("\\n")
      when '\r' then self.output.push_str("\\r")
      when '\t' then self.output.push_str("\\t")
      when _ then
        if c < ' ' then
          self.output.push_str("\\u")
          self.output.push_str(format_hex4(c as UInt).as_str())
        else
          self.output.push(c)
        end
      end
    end
    self.output.push('"')
  end
  
  def write_array(self: &mut JsonStringifier, arr: &Vec[Value]) -> Unit
    self.output.push('[')
    if self.pretty && !arr.is_empty() then
      self.depth = self.depth + 1
      self.write_newline()
    end
    
    for i in 0..arr.len() do
      if i > 0 then
        self.output.push(',')
        if self.pretty then self.write_newline() end
      end
      if self.pretty then self.write_indent() end
      match arr.get(i)
      when Option::Some(v) then self.write_value(&v)
      when Option::None then ()
      end
    end
    
    if self.pretty && !arr.is_empty() then
      self.depth = self.depth - 1
      self.write_newline()
      self.write_indent()
    end
    self.output.push(']')
  end
  
  def write_object(self: &mut JsonStringifier, obj: &Map[String, Value]) -> Unit
    self.output.push('{')
    if self.pretty && !obj.is_empty() then
      self.depth = self.depth + 1
      self.write_newline()
    end
    
    let mut first = true
    for entry in obj do
      let (k, v) = entry
      if !first then
        self.output.push(',')
        if self.pretty then self.write_newline() end
      end
      first = false
      if self.pretty then self.write_indent() end
      self.write_string(&k)
      self.output.push(':')
      if self.pretty then self.output.push(' ') end
      self.write_value(&v)
    end
    
    if self.pretty && !obj.is_empty() then
      self.depth = self.depth - 1
      self.write_newline()
      self.write_indent()
    end
    self.output.push('}')
  end
  
  def write_newline(self: &mut JsonStringifier) -> Unit
    self.output.push('\n')
  end
  
  def write_indent(self: &mut JsonStringifier) -> Unit
    for _ in 0..(self.depth * self.indent) do
      self.output.push(' ')
    end
  end
end

# ———————————————————————————————————————————————————————————————
# JSON Serializer (implements Serializer trait)
# ———————————————————————————————————————————————————————————————

struct JsonSerializer
  output: String
  pretty: Bool
  indent: UInt
  depth: UInt
  state: Vec[JsonSerState]
end

enum JsonSerState
  Root
  InArray(Bool)     # has_elements
  InObject(Bool)    # has_fields, expecting_value
end

def JsonSerializer::new() -> JsonSerializer
  let mut state = Vec::new()
  state.push(JsonSerState::Root)
  JsonSerializer {
    output: String::new(),
    pretty: false,
    indent: 0,
    depth: 0,
    state: state
  }
end

def JsonSerializer::new_pretty(indent: UInt) -> JsonSerializer
  let mut state = Vec::new()
  state.push(JsonSerState::Root)
  JsonSerializer {
    output: String::new(),
    pretty: true,
    indent: indent,
    depth: 0,
    state: state
  }
end

impl JsonSerializer
  def finish(self: &JsonSerializer) -> String
    self.output.clone()
  end
  
  def pre_value(self: &mut JsonSerializer) -> Unit
    match self.state.last()
    when Option::Some(JsonSerState::InArray(has)) then
      if has then
        self.output.push(',')
        if self.pretty then
          self.output.push('\n')
          self.write_indent()
        end
      else
        if self.pretty then
          self.output.push('\n')
          self.write_indent()
        end
      end
    when _ then ()
    end
  end
  
  def post_value(self: &mut JsonSerializer) -> Unit
    match self.state.last_mut()
    when Option::Some(JsonSerState::InArray(has)) then
      *has = true
    when _ then ()
    end
  end
  
  def write_indent(self: &mut JsonSerializer) -> Unit
    for _ in 0..(self.depth * self.indent) do
      self.output.push(' ')
    end
  end
  
  def write_string(self: &mut JsonSerializer, s: &str) -> Unit
    self.output.push('"')
    for c in s.chars() do
      match c
      when '"' then self.output.push_str("\\\"")
      when '\\' then self.output.push_str("\\\\")
      when '\n' then self.output.push_str("\\n")
      when '\r' then self.output.push_str("\\r")
      when '\t' then self.output.push_str("\\t")
      when _ then
        if c < ' ' then
          self.output.push_str("\\u")
          self.output.push_str(format_hex4(c as UInt).as_str())
        else
          self.output.push(c)
        end
      end
    end
    self.output.push('"')
  end
end

impl Serializer for JsonSerializer
  def serialize_bool(self: &mut JsonSerializer, v: Bool) -> Result[Unit, SerError]
    self.pre_value()
    if v then self.output.push_str("true")
    else self.output.push_str("false")
    end
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_int(self: &mut JsonSerializer, v: Int) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push_str(v.to_string().as_str())
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_float(self: &mut JsonSerializer, v: Float) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push_str(v.to_string().as_str())
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_str(self: &mut JsonSerializer, v: &str) -> Result[Unit, SerError]
    self.pre_value()
    self.write_string(v)
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_bytes(self: &mut JsonSerializer, v: &[u8]) -> Result[Unit, SerError]
    # Encode as base64 string
    self.pre_value()
    self.output.push('"')
    self.output.push_str(base64_encode(v).as_str())
    self.output.push('"')
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_none(self: &mut JsonSerializer) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push_str("null")
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_some(self: &mut JsonSerializer, v: &dyn Serialize) -> Result[Unit, SerError]
    v.serialize(self)
  end
  
  def serialize_seq_begin(self: &mut JsonSerializer, len: Option[UInt]) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push('[')
    self.depth = self.depth + 1
    self.state.push(JsonSerState::InArray(false))
    Result::Ok(())
  end
  
  def serialize_seq_element(self: &mut JsonSerializer, v: &dyn Serialize) -> Result[Unit, SerError]
    v.serialize(self)
  end
  
  def serialize_seq_end(self: &mut JsonSerializer) -> Result[Unit, SerError]
    self.state.pop()
    self.depth = self.depth - 1
    if self.pretty then
      self.output.push('\n')
      self.write_indent()
    end
    self.output.push(']')
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_map_begin(self: &mut JsonSerializer, len: Option[UInt]) -> Result[Unit, SerError]
    self.pre_value()
    self.output.push('{')
    self.depth = self.depth + 1
    self.state.push(JsonSerState::InObject(false))
    Result::Ok(())
  end
  
  def serialize_map_key(self: &mut JsonSerializer, k: &str) -> Result[Unit, SerError]
    match self.state.last_mut()
    when Option::Some(JsonSerState::InObject(has)) then
      if has then
        self.output.push(',')
      end
      *has = true
    when _ then ()
    end
    if self.pretty then
      self.output.push('\n')
      self.write_indent()
    end
    self.write_string(k)
    self.output.push(':')
    if self.pretty then self.output.push(' ') end
    Result::Ok(())
  end
  
  def serialize_map_value(self: &mut JsonSerializer, v: &dyn Serialize) -> Result[Unit, SerError]
    # Don't call pre/post_value since key already handled separator
    let old_state = self.state.pop()
    v.serialize(self)?
    match old_state
    when Option::Some(s) then self.state.push(s)
    when Option::None then ()
    end
    Result::Ok(())
  end
  
  def serialize_map_end(self: &mut JsonSerializer) -> Result[Unit, SerError]
    self.state.pop()
    self.depth = self.depth - 1
    if self.pretty then
      self.output.push('\n')
      self.write_indent()
    end
    self.output.push('}')
    self.post_value()
    Result::Ok(())
  end
  
  def serialize_struct_begin(self: &mut JsonSerializer, name: &str, len: UInt) -> Result[Unit, SerError]
    self.serialize_map_begin(Option::Some(len))
  end
  
  def serialize_struct_field(self: &mut JsonSerializer, name: &str, v: &dyn Serialize) -> Result[Unit, SerError]
    self.serialize_map_key(name)?
    self.serialize_map_value(v)
  end
  
  def serialize_struct_end(self: &mut JsonSerializer) -> Result[Unit, SerError]
    self.serialize_map_end()
  end
end

# ———————————————————————————————————————————————————————————————
# JSON Deserializer (implements Deserializer trait)
# ———————————————————————————————————————————————————————————————

struct JsonDeserializer
  value: &Value
end

def JsonDeserializer::new(v: &Value) -> JsonDeserializer
  JsonDeserializer { value: v }
end

impl Deserializer for JsonDeserializer
  def deserialize_bool(self: &mut JsonDeserializer) -> Result[Bool, SerError]
    match self.value
    when Value::Bool(b) then Result::Ok(b.clone())
    when _ then Result::Err(SerError::InvalidType("expected bool"))
    end
  end
  
  def deserialize_int(self: &mut JsonDeserializer) -> Result[Int, SerError]
    match self.value
    when Value::Int(i) then Result::Ok(i.clone())
    when Value::Float(f) then Result::Ok(f.clone() as Int)
    when _ then Result::Err(SerError::InvalidType("expected int"))
    end
  end
  
  def deserialize_float(self: &mut JsonDeserializer) -> Result[Float, SerError]
    match self.value
    when Value::Float(f) then Result::Ok(f.clone())
    when Value::Int(i) then Result::Ok(i.clone() as Float)
    when _ then Result::Err(SerError::InvalidType("expected float"))
    end
  end
  
  def deserialize_str(self: &mut JsonDeserializer) -> Result[String, SerError]
    match self.value
    when Value::String(s) then Result::Ok(s.clone())
    when _ then Result::Err(SerError::InvalidType("expected string"))
    end
  end
  
  def deserialize_bytes(self: &mut JsonDeserializer) -> Result[Vec[u8], SerError]
    match self.value
    when Value::String(s) then
      match base64_decode(&s)
      when Option::Some(bytes) then Result::Ok(bytes)
      when Option::None then Result::Err(SerError::InvalidValue("invalid base64"))
      end
    when _ then Result::Err(SerError::InvalidType("expected string"))
    end
  end
  
  def deserialize_option[T: Deserialize](self: &mut JsonDeserializer) -> Result[Option[T], SerError]
    match self.value
    when Value::Null then Result::Ok(Option::None)
    when _ then
      let inner = T::deserialize(self)?
      Result::Ok(Option::Some(inner))
    end
  end
  
  def deserialize_seq[T: Deserialize](self: &mut JsonDeserializer) -> Result[Vec[T], SerError]
    match self.value
    when Value::Array(arr) then
      let mut result = Vec::new()
      for item in arr do
        let mut d = JsonDeserializer::new(&item)
        result.push(T::deserialize(&mut d)?)
      end
      Result::Ok(result)
    when _ then Result::Err(SerError::InvalidType("expected array"))
    end
  end
  
  def deserialize_map[K: Deserialize, V: Deserialize](self: &mut JsonDeserializer) -> Result[Map[K, V], SerError]
    match self.value
    when Value::Object(obj) then
      let mut result = Map::new()
      for entry in obj do
        let (k, v) = entry
        let mut kd = JsonDeserializer::new(&Value::String(k.clone()))
        let mut vd = JsonDeserializer::new(&v)
        result.insert(K::deserialize(&mut kd)?, V::deserialize(&mut vd)?)
      end
      Result::Ok(result)
    when _ then Result::Err(SerError::InvalidType("expected object"))
    end
  end
  
  def deserialize_struct[T: Deserialize](self: &mut JsonDeserializer, name: &str, fields: &[&str]) -> Result[T, SerError]
    T::deserialize(self)
  end
end

# ———————————————————————————————————————————————————————————————
# Helper Functions
# ———————————————————————————————————————————————————————————————

def char_from_code(code: UInt) -> Char
  # Convert unicode codepoint to char (simplified for BMP)
  code as Char
end

def format_hex4(n: UInt) -> String
  let digits = "0123456789abcdef"
  let mut result = String::new()
  result.push(digits.char_at((n >> 12) & 0xF))
  result.push(digits.char_at((n >> 8) & 0xF))
  result.push(digits.char_at((n >> 4) & 0xF))
  result.push(digits.char_at(n & 0xF))
  result
end

def parse_int(s: &String) -> Option[Int]
  let mut result: Int = 0
  let mut neg = false
  let mut i = 0
  
  if s.len() > 0 && s.char_at(0) == '-' then
    neg = true
    i = 1
  end
  
  while i < s.len() do
    let c = s.char_at(i)
    if c >= '0' && c <= '9' then
      result = result * 10 + (c as Int - '0' as Int)
    else
      return Option::None
    end
    i = i + 1
  end
  
  if neg then result = -result end
  Option::Some(result)
end

def parse_float(s: &String) -> Option[Float]
  # Simple float parsing - delegate to compiler intrinsic
  string_to_float(s)
end

extern "Tangerine"
  def string_to_float(s: &String) -> Option[Float]
end

def base64_encode(data: &[u8]) -> String
  let chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  let mut result = String::new()
  let len = data.len()
  let mut i = 0
  
  while i + 2 < len do
    let n = (data[i] as UInt << 16) | (data[i + 1] as UInt << 8) | (data[i + 2] as UInt)
    result.push(chars.char_at((n >> 18) & 0x3F))
    result.push(chars.char_at((n >> 12) & 0x3F))
    result.push(chars.char_at((n >> 6) & 0x3F))
    result.push(chars.char_at(n & 0x3F))
    i = i + 3
  end
  
  if len - i == 2 then
    let n = (data[i] as UInt << 16) | (data[i + 1] as UInt << 8)
    result.push(chars.char_at((n >> 18) & 0x3F))
    result.push(chars.char_at((n >> 12) & 0x3F))
    result.push(chars.char_at((n >> 6) & 0x3F))
    result.push('=')
  else if len - i == 1 then
    let n = data[i] as UInt << 16
    result.push(chars.char_at((n >> 18) & 0x3F))
    result.push(chars.char_at((n >> 12) & 0x3F))
    result.push('=')
    result.push('=')
  end end
  
  result
end

def base64_decode(s: &String) -> Option[Vec[u8]]
  let mut result = Vec::new()
  let mut buf: UInt = 0
  let mut bits = 0
  
  for c in s.chars() do
    if c == '=' then break end
    
    let val = base64_char_value(c)
    if val == 255 then
      # Skip whitespace
      if c == ' ' || c == '\n' || c == '\r' || c == '\t' then
        continue
      end
      return Option::None
    end
    
    buf = (buf << 6) | val
    bits = bits + 6
    
    if bits >= 8 then
      bits = bits - 8
      result.push(((buf >> bits) & 0xFF) as u8)
    end
  end
  
  Option::Some(result)
end

def base64_char_value(c: Char) -> UInt
  if c >= 'A' && c <= 'Z' then
    c as UInt - 'A' as UInt
  else if c >= 'a' && c <= 'z' then
    c as UInt - 'a' as UInt + 26
  else if c >= '0' && c <= '9' then
    c as UInt - '0' as UInt + 52
  else if c == '+' then
    62
  else if c == '/' then
    63
  else
    255
  end end end end end
end
