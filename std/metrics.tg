# Tangerine Standard Library — tg::metrics
# Unified metrics collection and reporting.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 35.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec, Map}
use std::gfx_errors::{Error, ErrorCode}
use std::time::{instant_now, duration_nanos}
use std::ctx

# [METADATA]
# module: tg::metrics
# status: alpha
# effects: [Io]
# capabilities: []
# error_codes: [InvalidMetric, Internal]

enum MetricsError
  InvalidMetric(Error)
  Internal(Error)
end

impl MetricsError
  def message(self: MetricsError) -> String
    match self
    when MetricsError::InvalidMetric(e) then e.message.clone()
    when MetricsError::Internal(e) then e.message.clone()
    end
  end

  def code(self: MetricsError) -> ErrorCode
    match self
    when MetricsError::InvalidMetric(_) then ErrorCode::InvalidArg
    when MetricsError::Internal(_) then ErrorCode::Internal
    end
  end
end

enum MetricKind
  Counter
  Gauge
  Histogram
end

struct MetricValue
  kind: MetricKind
  value: f64
  labels: Map[String, String]
end

struct MetricsRegistry
  values: Map[String, MetricValue]
end

impl MetricsRegistry
  def new() -> MetricsRegistry
    MetricsRegistry { values: Map::new() }
  end

  def record(inout self: Self, name: String, value: f64, kind: MetricKind) -> Result[Unit, MetricsError]
    # The REAL std recording (the phantom __intrinsic_metrics_record
    # removed): the value lands in the registry, so dump_metrics reflects
    # every recorded metric.
    if name.is_empty() then
      return Result::Err(MetricsError::InvalidMetric(Error::new(ErrorCode::InvalidArg, "metric name must not be empty")))
    end
    self.values.insert(name.clone(), MetricValue {
      kind: kind,
      value: value,
      labels: Map::new()
    })
    _log_metrics_event(LogLevel::Info, "recorded metric " + name)
    Result::Ok(())
  end
end

def dump_metrics(registry: MetricsRegistry) -> String
  let mut s = "NAME,KIND,VALUE\n".to_string()
  let keys = registry.values.keys()
  let mut i = 0
  while i < keys.len() do
    let name = keys.get(i)
    let m = registry.values.get(name).unwrap()
    s.push_str(*name)
    s.push_str(",")
    match m.kind
    when MetricKind::Counter then s.push_str("counter")
    when MetricKind::Gauge then s.push_str("gauge")
    when MetricKind::Histogram then s.push_str("histogram")
    end
    s.push_str(",")
    s.push_str(m.value.fmt())
    s.push_str("\n")
    i = i + 1
  end
  s
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_metrics_event(level: LogLevel, msg: String) -> Unit
  match GLOBAL_LOGGER.as_mut()
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::App,
      message: "[METRICS] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then ()
  end
end
