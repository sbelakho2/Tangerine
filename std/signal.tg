## std::signal — POSIX signal handling
## Safe registration and dispatch of signal handlers with async-signal-safety.
## Spec: §stdlib.signal

module std::signal

use std::core::{Option, Result, Display}
use std::sync::{AtomicInt}
use std::collections::{Array}

# ─── Signal types ────────────────────────────────────────────────────

pub enum Signal
  HangUp        ## SIGHUP (1)
  Interrupt     ## SIGINT (2)
  Quit          ## SIGQUIT (3)
  Illegal       ## SIGILL (4)
  Trap          ## SIGTRAP (5)
  Abort         ## SIGABRT (6)
  Bus           ## SIGBUS (7)
  FloatingPoint ## SIGFPE (8)
  Kill          ## SIGKILL (9)  — cannot be caught
  User1         ## SIGUSR1 (10)
  Segfault      ## SIGSEGV (11)
  User2         ## SIGUSR2 (12)
  Pipe          ## SIGPIPE (13)
  Alarm         ## SIGALRM (14)
  Terminate     ## SIGTERM (15)
  Child         ## SIGCHLD (17)
  Continue      ## SIGCONT (18)
  Stop          ## SIGSTOP (19) — cannot be caught
  TermStop      ## SIGTSTP (20)
  TtyIn         ## SIGTTIN (21)
  TtyOut        ## SIGTTOU (22)
  Urgent        ## SIGURG (23)
  CpuLimit      ## SIGXCPU (24)
  FileLimit     ## SIGXFSZ (25)
  VirtualAlarm  ## SIGVTALRM (26)
  Profiling     ## SIGPROF (27)
  WindowChange  ## SIGWINCH (28)
  Io            ## SIGIO (29)
end

impl Signal
  pub def to_raw(self) -> Int
    match self
    when Signal.HangUp then 1
    when Signal.Interrupt then 2
    when Signal.Quit then 3
    when Signal.Illegal then 4
    when Signal.Trap then 5
    when Signal.Abort then 6
    when Signal.Bus then 7
    when Signal.FloatingPoint then 8
    when Signal.Kill then 9
    when Signal.User1 then 10
    when Signal.Segfault then 11
    when Signal.User2 then 12
    when Signal.Pipe then 13
    when Signal.Alarm then 14
    when Signal.Terminate then 15
    when Signal.Child then 17
    when Signal.Continue then 18
    when Signal.Stop then 19
    when Signal.TermStop then 20
    when Signal.TtyIn then 21
    when Signal.TtyOut then 22
    when Signal.Urgent then 23
    when Signal.CpuLimit then 24
    when Signal.FileLimit then 25
    when Signal.VirtualAlarm then 26
    when Signal.Profiling then 27
    when Signal.WindowChange then 28
    when Signal.Io then 29
    end
  end

  pub def from_raw(sig: Int) -> Option[Signal]
    match sig
    when 1 then Some(Signal.HangUp)
    when 2 then Some(Signal.Interrupt)
    when 3 then Some(Signal.Quit)
    when 4 then Some(Signal.Illegal)
    when 5 then Some(Signal.Trap)
    when 6 then Some(Signal.Abort)
    when 7 then Some(Signal.Bus)
    when 8 then Some(Signal.FloatingPoint)
    when 9 then Some(Signal.Kill)
    when 10 then Some(Signal.User1)
    when 11 then Some(Signal.Segfault)
    when 12 then Some(Signal.User2)
    when 13 then Some(Signal.Pipe)
    when 14 then Some(Signal.Alarm)
    when 15 then Some(Signal.Terminate)
    when 17 then Some(Signal.Child)
    when 18 then Some(Signal.Continue)
    when 19 then Some(Signal.Stop)
    when 20 then Some(Signal.TermStop)
    when 21 then Some(Signal.TtyIn)
    when 22 then Some(Signal.TtyOut)
    when 23 then Some(Signal.Urgent)
    when 24 then Some(Signal.CpuLimit)
    when 25 then Some(Signal.FileLimit)
    when 26 then Some(Signal.VirtualAlarm)
    when 27 then Some(Signal.Profiling)
    when 28 then Some(Signal.WindowChange)
    when 29 then Some(Signal.Io)
    else None
    end
  end

  pub def name(self) -> String
    match self
    when Signal.HangUp then "SIGHUP"
    when Signal.Interrupt then "SIGINT"
    when Signal.Quit then "SIGQUIT"
    when Signal.Illegal then "SIGILL"
    when Signal.Trap then "SIGTRAP"
    when Signal.Abort then "SIGABRT"
    when Signal.Bus then "SIGBUS"
    when Signal.FloatingPoint then "SIGFPE"
    when Signal.Kill then "SIGKILL"
    when Signal.User1 then "SIGUSR1"
    when Signal.Segfault then "SIGSEGV"
    when Signal.User2 then "SIGUSR2"
    when Signal.Pipe then "SIGPIPE"
    when Signal.Alarm then "SIGALRM"
    when Signal.Terminate then "SIGTERM"
    when Signal.Child then "SIGCHLD"
    when Signal.Continue then "SIGCONT"
    when Signal.Stop then "SIGSTOP"
    when Signal.TermStop then "SIGTSTP"
    when Signal.TtyIn then "SIGTTIN"
    when Signal.TtyOut then "SIGTTOU"
    when Signal.Urgent then "SIGURG"
    when Signal.CpuLimit then "SIGXCPU"
    when Signal.FileLimit then "SIGXFSZ"
    when Signal.VirtualAlarm then "SIGVTALRM"
    when Signal.Profiling then "SIGPROF"
    when Signal.WindowChange then "SIGWINCH"
    when Signal.Io then "SIGIO"
    end
  end
end

impl Display for Signal
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    f.write_str(self.name())
  end
end

# ─── Signal action ───────────────────────────────────────────────────

pub enum SignalAction
  Default        ## SIG_DFL
  Ignore         ## SIG_IGN
  Handle         ## Custom handler
end

# ─── FFI ─────────────────────────────────────────────────────────────

@ffi("c") extern def signal(sig: i32, handler: *def(i32)) -> *def(i32) end
@ffi("c") extern def raise(sig: i32) -> i32 end
@ffi("c") extern def kill(pid: i32, sig: i32) -> i32 end
@ffi("c") extern def getpid() -> i32 end
@ffi("c") extern def pause() -> i32 end
@ffi("c") extern def alarm(seconds: u32) -> u32 end

## sigaction structures — platform-specific
@repr(C)
struct Sigaction
  sa_handler: *def(i32)
  sa_mask: [u8; 128]  ## sigset_t (oversized for portability)
  sa_flags: i32
end

@ffi("c") extern def sigaction(sig: i32, act: *Sigaction, oldact: *mut Sigaction) -> i32 end
@ffi("c") extern def sigemptyset(set: *mut [u8; 128]) -> i32 end
@ffi("c") extern def sigaddset(set: *mut [u8; 128], signum: i32) -> i32 end
@ffi("c") extern def sigprocmask(how: i32, set: *[u8; 128], oldset: *mut [u8; 128]) -> i32 end

const SIG_DFL: *def(i32) = 0 as *def(i32)
const SIG_IGN: *def(i32) = 1 as *def(i32)
const SA_RESTART: i32 = 0x10000000
const SA_SIGINFO: i32 = 0x00000004
const SIG_BLOCK: i32 = 0
const SIG_UNBLOCK: i32 = 1
const SIG_SETMASK: i32 = 2

# ─── Atomic signal flags (async-signal-safe) ────────────────────────

## Per-signal atomic flags for safe signal notification.
## Signal handlers set these flags; main code polls them.
var _signal_flags: [AtomicInt; 32] = _init_signal_flags()

def _init_signal_flags() -> [AtomicInt; 32]
  var flags: [AtomicInt; 32] = unsafe { std::core::zeroed() }
  for i in 0..32 do
    flags[i] = AtomicInt.new(0)
  end
  flags
end

## Generic signal handler that sets the atomic flag.
def _generic_handler(sig: i32) -> Unit
  if sig >= 0 && sig < 32 then
    _signal_flags[sig as UInt].store(1, Ordering.Release)
  end
end

# ─── Public API ──────────────────────────────────────────────────────

pub enum SignalError
  InvalidSignal(Int)
  SystemError(Int)        ## errno
  UncatchableSignal(Signal)
end

impl Display for SignalError
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    match self
    when SignalError.InvalidSignal(s) then f.write_str("invalid signal: " + s.to_string())
    when SignalError.SystemError(e) then f.write_str("signal system error: errno " + e.to_string())
    when SignalError.UncatchableSignal(s) then f.write_str("cannot catch " + s.name())
    end
  end
end

## Register a handler for a signal using atomic flag notification.
## The signal sets an atomic flag; poll with `is_pending()` / `take_pending()`.
pub def trap(sig: Signal) -> Result[Unit, SignalError]
  if sig == Signal.Kill || sig == Signal.Stop then
    return Err(SignalError.UncatchableSignal(sig))
  end

  var act: Sigaction = unsafe { std::core::zeroed() }
  sigemptyset(&mut act.sa_mask)
  act.sa_handler = _generic_handler as *def(i32)
  act.sa_flags = SA_RESTART

  let ret = sigaction(sig.to_raw() as i32, &act, std::core::null_mut())
  if ret != 0 then
    return Err(SignalError.SystemError(_errno()))
  end
  Ok(())
end

## Ignore a signal.
pub def ignore(sig: Signal) -> Result[Unit, SignalError]
  if sig == Signal.Kill || sig == Signal.Stop then
    return Err(SignalError.UncatchableSignal(sig))
  end

  var act: Sigaction = unsafe { std::core::zeroed() }
  sigemptyset(&mut act.sa_mask)
  act.sa_handler = SIG_IGN
  act.sa_flags = 0

  let ret = sigaction(sig.to_raw() as i32, &act, std::core::null_mut())
  if ret != 0 then return Err(SignalError.SystemError(_errno())) end
  Ok(())
end

## Reset a signal to default behavior.
pub def reset(sig: Signal) -> Result[Unit, SignalError]
  var act: Sigaction = unsafe { std::core::zeroed() }
  sigemptyset(&mut act.sa_mask)
  act.sa_handler = SIG_DFL
  act.sa_flags = 0

  let ret = sigaction(sig.to_raw() as i32, &act, std::core::null_mut())
  if ret != 0 then return Err(SignalError.SystemError(_errno())) end
  Ok(())
end

## Check if a signal is pending (has been received since last check).
pub def is_pending(sig: Signal) -> Bool
  let raw = sig.to_raw()
  if raw < 0 || raw >= 32 then return false end
  _signal_flags[raw as UInt].load(Ordering.Acquire) != 0
end

## Take a pending signal (check and clear atomically).
pub def take_pending(sig: Signal) -> Bool
  let raw = sig.to_raw()
  if raw < 0 || raw >= 32 then return false end
  _signal_flags[raw as UInt].swap(0, Ordering.AcqRel) != 0
end

## Send a signal to the current process.
pub def raise_signal(sig: Signal) -> Result[Unit, SignalError]
  let ret = raise(sig.to_raw() as i32)
  if ret != 0 then Err(SignalError.SystemError(_errno()))
  else Ok(())
  end
end

## Send a signal to another process.
pub def kill_process(pid: Int, sig: Signal) -> Result[Unit, SignalError]
  let ret = kill(pid as i32, sig.to_raw() as i32)
  if ret != 0 then Err(SignalError.SystemError(_errno()))
  else Ok(())
  end
end

## Set an alarm (SIGALRM after `seconds`). Returns remaining seconds of previous alarm.
pub def set_alarm(seconds: Int) -> Int
  alarm(seconds as u32) as Int
end

## Block a set of signals.
pub def block(signals: &[Signal]) -> Result[Unit, SignalError]
  var mask: [u8; 128] = unsafe { std::core::zeroed() }
  sigemptyset(&mut mask)
  for sig in signals do
    sigaddset(&mut mask, sig.to_raw() as i32)
  end
  let ret = sigprocmask(SIG_BLOCK, &mask, std::core::null_mut())
  if ret != 0 then Err(SignalError.SystemError(_errno()))
  else Ok(())
  end
end

## Unblock a set of signals.
pub def unblock(signals: &[Signal]) -> Result[Unit, SignalError]
  var mask: [u8; 128] = unsafe { std::core::zeroed() }
  sigemptyset(&mut mask)
  for sig in signals do
    sigaddset(&mut mask, sig.to_raw() as i32)
  end
  let ret = sigprocmask(SIG_UNBLOCK, &mask, std::core::null_mut())
  if ret != 0 then Err(SignalError.SystemError(_errno()))
  else Ok(())
  end
end

## Wait for any pending signal (blocks the thread).
pub def wait_for_signal() -> Signal
  pause()
  ## Check all flags
  for i in 1..32 do
    if _signal_flags[i as UInt].swap(0, Ordering.AcqRel) != 0 then
      match Signal.from_raw(i)
      when Some(s) then return s
      when None then {}
      end
    end
  end
  Signal.Terminate  ## shouldn't reach here
end

## Convenience: trap SIGINT and SIGTERM for graceful shutdown.
pub def trap_shutdown() -> Result[Unit, SignalError]
  trap(Signal.Interrupt)?
  trap(Signal.Terminate)?
  Ok(())
end

## Convenience: check if shutdown was requested (SIGINT or SIGTERM received).
pub def shutdown_requested() -> Bool
  is_pending(Signal.Interrupt) || is_pending(Signal.Terminate)
end

@ffi("c") extern def __errno_location() -> *i32 end

def _errno() -> Int
  unsafe { *__errno_location() as Int }
end

end ## module std::signal
