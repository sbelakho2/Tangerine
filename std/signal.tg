# Tangerine Standard Library — tg::signal
# Unix Signal Handling

use std::core::{Option, Result, String, Vec, Unit, Bool, Int}

# [METADATA]
# module: tg::signal
# status: stable
# effects: [Signal]
# capabilities: [SignalHandling]

# ═══════════════════════════════════════════════════════════════
# Signal Constants (POSIX)
# ═══════════════════════════════════════════════════════════════

# Default signals
def SIGHUP() -> Int = 1      # Hangup
def SIGINT() -> Int = 2      # Interrupt (Ctrl+C)
def SIGQUIT() -> Int = 3     # Quit
def SIGILL() -> Int = 4      # Illegal instruction
def SIGTRAP() -> Int = 5     # Trace trap
def SIGABRT() -> Int = 6     # Abort
def SIGBUS() -> Int = 7      # Bus error
def SIGFPE() -> Int = 8      # Floating point exception
def SIGKILL() -> Int = 9     # Kill (cannot be caught)
def SIGUSR1() -> Int = 10    # User-defined signal 1
def SIGSEGV() -> Int = 11    # Segmentation fault
def SIGUSR2() -> Int = 12    # User-defined signal 2
def SIGPIPE() -> Int = 13    # Broken pipe
def SIGALRM() -> Int = 14    # Alarm clock
def SIGTERM() -> Int = 15    # Termination
def SIGSTKFLT() -> Int = 16  # Stack fault
def SIGCHLD() -> Int = 17    # Child status changed
def SIGCONT() -> Int = 18    # Continue
def SIGSTOP() -> Int = 19    # Stop (cannot be caught)
def SIGTSTP() -> Int = 20    # Stop from terminal (Ctrl+Z)
def SIGTTIN() -> Int = 21    # Terminal input for background
def SIGTTOU() -> Int = 22    # Terminal output for background
def SIGURG() -> Int = 23     # Urgent socket condition
def SIGXCPU() -> Int = 24    # CPU time limit exceeded
def SIGXFSZ() -> Int = 25    # File size limit exceeded
def SIGVTALRM() -> Int = 26  # Virtual alarm clock
def SIGPROF() -> Int = 27    # Profiling alarm clock
def SIGWINCH() -> Int = 28   # Window size change
def SIGIO() -> Int = 29      # I/O possible
def SIGPWR() -> Int = 30     # Power failure
def SIGSYS() -> Int = 31     # Bad system call

# ═══════════════════════════════════════════════════════════════
# Signal Handler Types
# ═══════════════════════════════════════════════════════════════

# Special handler values
def SIG_DFL() -> Int = 0     # Default action
def SIG_IGN() -> Int = 1     # Ignore signal
def SIG_ERR() -> Int = -1    # Error return

# ═══════════════════════════════════════════════════════════════
# sigaction struct (for FFI)
# ═══════════════════════════════════════════════════════════════

struct SigAction
  handler: Int               # Function pointer or SIG_DFL/SIG_IGN
  mask: Vec[Int]             # Signal mask (64 bits for Linux)
  flags: Int                 # sa_flags
end

# sa_flags values
def SA_NOCLDSTOP() -> Int = 1
def SA_NOCLDWAIT() -> Int = 2
def SA_SIGINFO() -> Int = 4
def SA_ONSTACK() -> Int = 0x08000000
def SA_RESTART() -> Int = 0x10000000
def SA_NODEFER() -> Int = 0x40000000
def SA_RESETHAND() -> Int = 0x80000000

# ═══════════════════════════════════════════════════════════════
# FFI to libc for signal operations
# ═══════════════════════════════════════════════════════════════

@ffi("c")
extern def signal(sig: Int, handler: Int) -> Int
end

@ffi("c")
extern def sigaction(sig: Int, act: Ptr[u8], oldact: Ptr[u8]) -> Int
end

@ffi("c")
extern def sigprocmask(how: Int, set: Ptr[u8], oldset: Ptr[u8]) -> Int
end

@ffi("c")
extern def sigpending(set: Ptr[u8]) -> Int
end

@ffi("c")
extern def sigsuspend(set: Ptr[u8]) -> Int
end

@ffi("c")
extern def kill(pid: Int, sig: Int) -> Int
end

@ffi("c")
extern def raise(sig: Int) -> Int
end

@ffi("c")
extern def killpg(pgrp: Int, sig: Int) -> Int
end

@ffi("c")
extern def alarm(seconds: UInt) -> UInt
end

@ffi("c")
extern def pause() -> Int
end

# sigprocmask how values
def SIG_BLOCK() -> Int = 0
def SIG_UNBLOCK() -> Int = 1
def SIG_SETMASK() -> Int = 2

# ═══════════════════════════════════════════════════════════════
# Signal Set Operations
# ═══════════════════════════════════════════════════════════════

struct SigSet
  # Use a 64-bit mask stored as two 32-bit values for portability
  low: UInt
  high: UInt
end

def SigSet::empty() -> SigSet
  SigSet { low: 0, high: 0 }
end

def SigSet::full() -> SigSet
  SigSet { low: 0xFFFFFFFF, high: 0xFFFFFFFF }
end

def SigSet::add(self: SigSet, sig: Int) -> SigSet
  var result = self
  if sig > 0 && sig <= 32 then
    result.low = result.low | (1 << (sig - 1))
  elsif sig > 32 && sig <= 64 then
    result.high = result.high | (1 << (sig - 33))
  end
  result
end

def SigSet::remove(self: SigSet, sig: Int) -> SigSet
  var result = self
  if sig > 0 && sig <= 32 then
    result.low = result.low & !(1 << (sig - 1))
  elsif sig > 32 && sig <= 64 then
    result.high = result.high & !(1 << (sig - 33))
  end
  result
end

def SigSet::contains(self: SigSet, sig: Int) -> Bool
  if sig > 0 && sig <= 32 then
    (self.low & (1 << (sig - 1))) != 0
  elsif sig > 32 && sig <= 64 then
    (self.high & (1 << (sig - 33))) != 0
  else
    false
  end
end

def SigSet::from_vec(signals: Vec[Int]) -> SigSet
  var set = SigSet::empty()
  for sig in signals do
    set = set.add(sig)
  end
  set
end

def SigSet::to_vec(self: SigSet) -> Vec[Int]
  var result: Vec[Int] = Vec::new()
  var sig = 1
  while sig <= 64 do
    if self.contains(sig) then
      result.push(sig)
    end
    sig = sig + 1
  end
  result
end

# ═══════════════════════════════════════════════════════════════
# High-Level Signal API
# ═══════════════════════════════════════════════════════════════

# Callback storage (simplified - in real impl would use proper callback registry)
var _signal_handlers: Vec[(Int, Int)] = Vec::new()

def ignore_signal(sig: Int) -> Result[Unit, String]
  let result = signal(sig, SIG_IGN())
  if result == SIG_ERR() then
    Result::Err("Failed to ignore signal".to_string())
  else
    Result::Ok(())
  end
end

def default_signal(sig: Int) -> Result[Unit, String]
  let result = signal(sig, SIG_DFL())
  if result == SIG_ERR() then
    Result::Err("Failed to reset signal to default".to_string())
  else
    Result::Ok(())
  end
end

# Note: Full callback support requires runtime registration
# This is a simplified version that stores handler info
def register_handler(sig: Int, handler_id: Int) -> Result[Unit, String]
  # Store the handler mapping
  _signal_handlers.push((sig, handler_id))
  
  # Register with kernel using a trampoline
  let result = signal(sig, handler_id)
  if result == SIG_ERR() then
    Result::Err("Failed to register signal handler".to_string())
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Signal Mask Operations
# ═══════════════════════════════════════════════════════════════

def block_signals(signals: Vec[Int]) -> Result[Unit, String]
  let set = SigSet::from_vec(signals)
  var set_bytes: Vec[u8] = Vec::with_capacity(8)
  set_bytes.resize(8, 0)
  
  # Pack the sigset into bytes (simplified)
  var i = 0
  while i < 4 do
    set_bytes[i] = ((set.low >> (i * 8)) & 0xFF) as u8
    i = i + 1
  end
  while i < 8 do
    set_bytes[i - 4] = ((set.high >> ((i - 4) * 8)) & 0xFF) as u8
    i = i + 1
  end
  
  let result = sigprocmask(SIG_BLOCK(), set_bytes.as_ptr(), Ptr::null())
  if result != 0 then
    Result::Err("Failed to block signals".to_string())
  else
    Result::Ok(())
  end
end

def unblock_signals(signals: Vec[Int]) -> Result[Unit, String]
  let set = SigSet::from_vec(signals)
  var set_bytes: Vec[u8] = Vec::with_capacity(8)
  set_bytes.resize(8, 0)
  
  var i = 0
  while i < 4 do
    set_bytes[i] = ((set.low >> (i * 8)) & 0xFF) as u8
    i = i + 1
  end
  while i < 8 do
    set_bytes[i - 4] = ((set.high >> ((i - 4) * 8)) & 0xFF) as u8
    i = i + 1
  end
  
  let result = sigprocmask(SIG_UNBLOCK(), set_bytes.as_ptr(), Ptr::null())
  if result != 0 then
    Result::Err("Failed to unblock signals".to_string())
  else
    Result::Ok(())
  end
end

def set_signal_mask(signals: Vec[Int]) -> Result[Unit, String]
  let set = SigSet::from_vec(signals)
  var set_bytes: Vec[u8] = Vec::with_capacity(8)
  set_bytes.resize(8, 0)
  
  var i = 0
  while i < 4 do
    set_bytes[i] = ((set.low >> (i * 8)) & 0xFF) as u8
    i = i + 1
  end
  while i < 8 do
    set_bytes[i - 4] = ((set.high >> ((i - 4) * 8)) & 0xFF) as u8
    i = i + 1
  end
  
  let result = sigprocmask(SIG_SETMASK(), set_bytes.as_ptr(), Ptr::null())
  if result != 0 then
    Result::Err("Failed to set signal mask".to_string())
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Send Signals
# ═══════════════════════════════════════════════════════════════

def send_signal(pid: Int, sig: Int) -> Result[Unit, String]
  let result = kill(pid, sig)
  if result != 0 then
    Result::Err("Failed to send signal".to_string())
  else
    Result::Ok(())
  end
end

def send_signal_to_group(pgrp: Int, sig: Int) -> Result[Unit, String]
  let result = killpg(pgrp, sig)
  if result != 0 then
    Result::Err("Failed to send signal to process group".to_string())
  else
    Result::Ok(())
  end
end

def raise_signal(sig: Int) -> Result[Unit, String]
  let result = raise(sig)
  if result != 0 then
    Result::Err("Failed to raise signal".to_string())
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Timer and Alarm
# ═══════════════════════════════════════════════════════════════

def set_alarm(seconds: UInt) -> UInt
  alarm(seconds)
end

def cancel_alarm() -> UInt
  alarm(0)
end

def wait_for_signal() -> Result[Unit, String]
  let result = pause()
  # pause always returns -1 with EINTR when interrupted
  Result::Ok(())
end

# ═══════════════════════════════════════════════════════════════
# Signal Information
# ═══════════════════════════════════════════════════════════════

def signal_name(sig: Int) -> String
  match sig
  when 1 then "SIGHUP"
  when 2 then "SIGINT"
  when 3 then "SIGQUIT"
  when 4 then "SIGILL"
  when 5 then "SIGTRAP"
  when 6 then "SIGABRT"
  when 7 then "SIGBUS"
  when 8 then "SIGFPE"
  when 9 then "SIGKILL"
  when 10 then "SIGUSR1"
  when 11 then "SIGSEGV"
  when 12 then "SIGUSR2"
  when 13 then "SIGPIPE"
  when 14 then "SIGALRM"
  when 15 then "SIGTERM"
  when 16 then "SIGSTKFLT"
  when 17 then "SIGCHLD"
  when 18 then "SIGCONT"
  when 19 then "SIGSTOP"
  when 20 then "SIGTSTP"
  when 21 then "SIGTTIN"
  when 22 then "SIGTTOU"
  when 23 then "SIGURG"
  when 24 then "SIGXCPU"
  when 25 then "SIGXFSZ"
  when 26 then "SIGVTALRM"
  when 27 then "SIGPROF"
  when 28 then "SIGWINCH"
  when 29 then "SIGIO"
  when 30 then "SIGPWR"
  when 31 then "SIGSYS"
  else "UNKNOWN"
  end
end

def signal_from_name(name: String) -> Option[Int]
  match name
  when "SIGHUP" then Option::Some(1)
  when "SIGINT" then Option::Some(2)
  when "SIGQUIT" then Option::Some(3)
  when "SIGILL" then Option::Some(4)
  when "SIGTRAP" then Option::Some(5)
  when "SIGABRT" then Option::Some(6)
  when "SIGBUS" then Option::Some(7)
  when "SIGFPE" then Option::Some(8)
  when "SIGKILL" then Option::Some(9)
  when "SIGUSR1" then Option::Some(10)
  when "SIGSEGV" then Option::Some(11)
  when "SIGUSR2" then Option::Some(12)
  when "SIGPIPE" then Option::Some(13)
  when "SIGALRM" then Option::Some(14)
  when "SIGTERM" then Option::Some(15)
  when "SIGSTKFLT" then Option::Some(16)
  when "SIGCHLD" then Option::Some(17)
  when "SIGCONT" then Option::Some(18)
  when "SIGSTOP" then Option::Some(19)
  when "SIGTSTP" then Option::Some(20)
  when "SIGTTIN" then Option::Some(21)
  when "SIGTTOU" then Option::Some(22)
  when "SIGURG" then Option::Some(23)
  when "SIGXCPU" then Option::Some(24)
  when "SIGXFSZ" then Option::Some(25)
  when "SIGVTALRM" then Option::Some(26)
  when "SIGPROF" then Option::Some(27)
  when "SIGWINCH" then Option::Some(28)
  when "SIGIO" then Option::Some(29)
  when "SIGPWR" then Option::Some(30)
  when "SIGSYS" then Option::Some(31)
  else Option::None
  end
end

def is_catchable(sig: Int) -> Bool
  # SIGKILL and SIGSTOP cannot be caught
  sig != SIGKILL() && sig != SIGSTOP()
end

def is_terminating(sig: Int) -> Bool
  # Signals that terminate by default
  match sig
  when 1 then true   # SIGHUP
  when 2 then true   # SIGINT
  when 3 then true   # SIGQUIT
  when 4 then true   # SIGILL
  when 5 then true   # SIGTRAP
  when 6 then true   # SIGABRT
  when 7 then true   # SIGBUS
  when 8 then true   # SIGFPE
  when 9 then true   # SIGKILL
  when 10 then true  # SIGUSR1
  when 11 then true  # SIGSEGV
  when 12 then true  # SIGUSR2
  when 13 then true  # SIGPIPE
  when 14 then true  # SIGALRM
  when 15 then true  # SIGTERM
  when 16 then true  # SIGSTKFLT
  when 24 then true  # SIGXCPU
  when 25 then true  # SIGXFSZ
  when 30 then true  # SIGPWR
  when 31 then true  # SIGSYS
  else false
  end
end

def is_stopping(sig: Int) -> Bool
  # Signals that stop by default
  match sig
  when 19 then true  # SIGSTOP
  when 20 then true  # SIGTSTP
  when 21 then true  # SIGTTIN
  when 22 then true  # SIGTTOU
  else false
  end
end

def is_continuing(sig: Int) -> Bool
  sig == SIGCONT()
end

# ═══════════════════════════════════════════════════════════════
# Convenience Functions for Common Patterns
# ═══════════════════════════════════════════════════════════════

def setup_interrupt_handler() -> Result[Unit, String]
  # Set up handler for SIGINT (Ctrl+C)
  ignore_signal(SIGINT())
end

def setup_termination_handler() -> Result[Unit, String]
  # Set up handler for SIGTERM
  ignore_signal(SIGTERM())
end

def setup_child_handler() -> Result[Unit, String]
  # Set up handler for SIGCHLD
  ignore_signal(SIGCHLD())
end

def setup_pipe_handler() -> Result[Unit, String]
  # Ignore SIGPIPE (handle EPIPE instead)
  ignore_signal(SIGPIPE())
end

# Block all signals for critical section
def block_all_signals() -> Result[Unit, String]
  let all = SigSet::full()
  var set_bytes: Vec[u8] = Vec::with_capacity(8)
  set_bytes.resize(8, 0)
  
  var i = 0
  while i < 4 do
    set_bytes[i] = ((all.low >> (i * 8)) & 0xFF) as u8
    i = i + 1
  end
  while i < 8 do
    set_bytes[i - 4] = ((all.high >> ((i - 4) * 8)) & 0xFF) as u8
    i = i + 1
  end
  
  let result = sigprocmask(SIG_BLOCK(), set_bytes.as_ptr(), Ptr::null())
  if result != 0 then
    Result::Err("Failed to block all signals".to_string())
  else
    Result::Ok(())
  end
end