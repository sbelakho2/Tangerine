## std::signal — POSIX signal handling
## Safe registration and dispatch of signal handlers with async-signal-safety.
## Spec: §stdlib.signal

use std::core::{Option, Result, Display, String, Int}
use std::sync::{AtomicInt, Ordering}
use std::collections::{Array}

# ─── Signal types ────────────────────────────────────────────────────

enum Signal
  HangUp        ## SIGHUP (1)
  Interrupt     ## SIGINT (2)
  Quit          ## SIGQUIT (3)
  Illegal       ## SIGILL (4)
  Trap          ## SIGTRAP (5)
  Abort         ## SIGABRT (6)
  Bus           ## SIGBUS (7)
  FloatingPoint ## SIGFPE (8)
  Kill          ## SIGKILL (9)  — cannot be caught
  User1         ## SIGUSR1 (10)
  Segfault      ## SIGSEGV (11)
  User2         ## SIGUSR2 (12)
  Pipe          ## SIGPIPE (13)
  Alarm         ## SIGALRM (14)
  Terminate     ## SIGTERM (15)
  Child         ## SIGCHLD (17)
  Continue      ## SIGCONT (18)
  Stop          ## SIGSTOP (19) — cannot be caught
  TermStop      ## SIGTSTP (20)
  TtyIn         ## SIGTTIN (21)
  TtyOut        ## SIGTTOU (22)
  Urgent        ## SIGURG (23)
  CpuLimit      ## SIGXCPU (24)
  FileLimit     ## SIGXFSZ (25)
  VirtualAlarm  ## SIGVTALRM (26)
  Profiling     ## SIGPROF (27)
  WindowChange  ## SIGWINCH (28)
  Io            ## SIGIO (29)
end

impl Signal
  def to_raw(self: &Self) -> Int
    match *self
    when Signal::HangUp then 1
    when Signal::Interrupt then 2
    when Signal::Quit then 3
    when Signal::Illegal then 4
    when Signal::Trap then 5
    when Signal::Abort then 6
    when Signal::Bus then 7
    when Signal::FloatingPoint then 8
    when Signal::Kill then 9
    when Signal::User1 then 10
    when Signal::Segfault then 11
    when Signal::User2 then 12
    when Signal::Pipe then 13
    when Signal::Alarm then 14
    when Signal::Terminate then 15
    when Signal::Child then 17
    when Signal::Continue then 18
    when Signal::Stop then 19
    when Signal::TermStop then 20
    when Signal::TtyIn then 21
    when Signal::TtyOut then 22
    when Signal::Urgent then 23
    when Signal::CpuLimit then 24
    when Signal::FileLimit then 25
    when Signal::VirtualAlarm then 26
    when Signal::Profiling then 27
    when Signal::WindowChange then 28
    when Signal::Io then 29
    end
  end

  def from_raw(sig: Int) -> Option[Signal]
    match sig
    when 1 then Option::Some(Signal::HangUp)
    when 2 then Option::Some(Signal::Interrupt)
    when 3 then Option::Some(Signal::Quit)
    when 4 then Option::Some(Signal::Illegal)
    when 5 then Option::Some(Signal::Trap)
    when 6 then Option::Some(Signal::Abort)
    when 7 then Option::Some(Signal::Bus)
    when 8 then Option::Some(Signal::FloatingPoint)
    when 9 then Option::Some(Signal::Kill)
    when 10 then Option::Some(Signal::User1)
    when 11 then Option::Some(Signal::Segfault)
    when 12 then Option::Some(Signal::User2)
    when 13 then Option::Some(Signal::Pipe)
    when 14 then Option::Some(Signal::Alarm)
    when 15 then Option::Some(Signal::Terminate)
    when 17 then Option::Some(Signal::Child)
    when 18 then Option::Some(Signal::Continue)
    when 19 then Option::Some(Signal::Stop)
    when 20 then Option::Some(Signal::TermStop)
    when 21 then Option::Some(Signal::TtyIn)
    when 22 then Option::Some(Signal::TtyOut)
    when 23 then Option::Some(Signal::Urgent)
    when 24 then Option::Some(Signal::CpuLimit)
    when 25 then Option::Some(Signal::FileLimit)
    when 26 then Option::Some(Signal::VirtualAlarm)
    when 27 then Option::Some(Signal::Profiling)
    when 28 then Option::Some(Signal::WindowChange)
    when 29 then Option::Some(Signal::Io)
    else Option::None
    end
  end

  def name(self: &Self) -> String
    match *self
    when Signal::HangUp then "SIGHUP"
    when Signal::Interrupt then "SIGINT"
    when Signal::Quit then "SIGQUIT"
    when Signal::Illegal then "SIGILL"
    when Signal::Trap then "SIGTRAP"
    when Signal::Abort then "SIGABRT"
    when Signal::Bus then "SIGBUS"
    when Signal::FloatingPoint then "SIGFPE"
    when Signal::Kill then "SIGKILL"
    when Signal::User1 then "SIGUSR1"
    when Signal::Segfault then "SIGSEGV"
    when Signal::User2 then "SIGUSR2"
    when Signal::Pipe then "SIGPIPE"
    when Signal::Alarm then "SIGALRM"
    when Signal::Terminate then "SIGTERM"
    when Signal::Child then "SIGCHLD"
    when Signal::Continue then "SIGCONT"
    when Signal::Stop then "SIGSTOP"
    when Signal::TermStop then "SIGTSTP"
    when Signal::TtyIn then "SIGTTIN"
    when Signal::TtyOut then "SIGTTOU"
    when Signal::Urgent then "SIGURG"
    when Signal::CpuLimit then "SIGXCPU"
    when Signal::FileLimit then "SIGXFSZ"
    when Signal::VirtualAlarm then "SIGVTALRM"
    when Signal::Profiling then "SIGPROF"
    when Signal::WindowChange then "SIGWINCH"
    when Signal::Io then "SIGIO"
    end
  end
end

impl Display for Signal
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    f.write_str(self.name())
  end
end

# ─── Signal action ───────────────────────────────────────────────────

enum SignalAction
  Default        ## SIG_DFL
  Ignore         ## SIG_IGN
  Handle         ## Custom handler
end

# ─── FFI ─────────────────────────────────────────────────────────────

@ffi("c") extern def signal(sig: Int, handler: fn(Int) -> Unit) -> fn(Int) -> Unit end
@ffi("c") extern def raise(sig: Int) -> Int end
@ffi("c") extern def kill(pid: Int, sig: Int) -> Int end
@ffi("c") extern def getpid() -> Int end
@ffi("c") extern def pause() -> Int end
@ffi("c") extern def alarm(seconds: Int) -> Int end

## sigaction structures — platform-specific
@repr(C)
struct Sigaction
  sa_handler: fn(Int) -> Unit
  sa_mask: [u8; 128]  ## sigset_t (oversized for portability)
  sa_flags: Int
end

@ffi("c") extern def sigaction(sig: Int, act: &Sigaction, oldact: &mut Sigaction) -> Int end
@ffi("c") extern def sigemptyset(set: &mut [u8; 128]) -> Int end
@ffi("c") extern def sigaddset(set: &mut [u8; 128], signum: Int) -> Int end
@ffi("c") extern def sigprocmask(how: Int, set: &[u8; 128], oldset: &mut [u8; 128]) -> Int end

const SA_RESTART: Int = 0x10000000
const SA_SIGINFO: Int = 0x00000004
const SIG_BLOCK: Int = 0
const SIG_UNBLOCK: Int = 1
const SIG_SETMASK: Int = 2

# ─── Atomic signal flags (async-signal-safe) ────────────────────────

## Per-signal atomic flags for safe signal notification.
## Signal handlers set these flags; main code polls them.
let mut _signal_flags: [AtomicInt; 32] = _init_signal_flags()

def _init_signal_flags() -> [AtomicInt; 32]
  let mut flags: [AtomicInt; 32] = unsafe { std::core::zeroed() }
  let mut i = 0
  while i < 32 do
    flags[i] = AtomicInt::new(0)
    i = i + 1
  end
  flags
end

## Generic signal handler that sets the atomic flag.
def _generic_handler(sig: Int) -> Unit
  if sig >= 0 && sig < 32 then
    _signal_flags[sig].store(1)
  end
end

# ─── Public API ──────────────────────────────────────────────────────

enum SignalError
  InvalidSignal(Int)
  SystemError(Int)        ## errno
  UncatchableSignal(Signal)
end

impl Display for SignalError
  def fmt(self: &Self, f: &mut fmt::Formatter) -> fmt::Result
    match *self
    when SignalError::InvalidSignal(s) then f.write_str("invalid signal: " + s.to_string())
    when SignalError::SystemError(e) then f.write_str("system error: " + e.to_string())
    when SignalError::UncatchableSignal(s) then f.write_str("uncatchable signal: " + s.name())
    end
  end
end

## Register a handler for a signal using atomic flag notification.
## The signal sets an atomic flag; poll with `is_pending()` / `take_pending()`.
def trap(sig: Signal) -> Result[Unit, SignalError]
  if sig == Signal::Kill || sig == Signal::Stop then
    return Result::Err(SignalError::UncatchableSignal(sig))
  end

  let mut act: Sigaction = unsafe { std::core::zeroed() }
  sigemptyset(&mut act.sa_mask)
  act.sa_handler = _generic_handler
  act.sa_flags = SA_RESTART

  let ret = sigaction(sig.to_raw(), &act, unsafe { std::core::zeroed() })
  if ret != 0 then
    return Result::Err(SignalError::SystemError(-1))
  end
  Result::Ok(())
end

## Ignore a signal.
def ignore(sig: Signal) -> Result[Unit, SignalError]
  if sig == Signal::Kill || sig == Signal::Stop then
    return Result::Err(SignalError::UncatchableSignal(sig))
  end

  let mut act: Sigaction = unsafe { std::core::zeroed() }
  sigemptyset(&mut act.sa_mask)
  # act.sa_handler = SIG_IGN
  act.sa_flags = 0

  let ret = sigaction(sig.to_raw(), &act, unsafe { std::core::zeroed() })
  if ret != 0 then return Result::Err(SignalError::SystemError(-1)) end
  Result::Ok(())
end

## Reset a signal to default behavior.
def reset(sig: Signal) -> Result[Unit, SignalError]
  let mut act: Sigaction = unsafe { std::core::zeroed() }
  sigemptyset(&mut act.sa_mask)
  # act.sa_handler = SIG_DFL
  act.sa_flags = 0

  let ret = sigaction(sig.to_raw(), &act, unsafe { std::core::zeroed() })
  if ret != 0 then return Result::Err(SignalError::SystemError(-1)) end
  Result::Ok(())
end

## Check if a signal is pending (has been received since last check).
def is_pending(sig: Signal) -> Bool
  let raw = sig.to_raw()
  if raw < 0 || raw >= 32 then return false end
  _signal_flags[raw].load() != 0
end

## Take a pending signal (check and clear atomically).
def take_pending(sig: Signal) -> Bool
  let raw = sig.to_raw()
  if raw < 0 || raw >= 32 then return false end
  # _signal_flags[raw as UInt].swap(0, Ordering.AcqRel) != 0
  let pending = _signal_flags[raw].load() != 0
  if pending then
    _signal_flags[raw].store(0)
  end
  pending
end

## Send a signal to the current process.
def raise_signal(sig: Signal) -> Result[Unit, SignalError]
  let ret = raise(sig.to_raw())
  if ret != 0 then Result::Err(SignalError::SystemError(-1))
  else Result::Ok(())
  end
end

## Send a signal to another process.
def kill_process(pid: Int, sig: Signal) -> Result[Unit, SignalError]
  let ret = kill(pid, sig.to_raw())
  if ret != 0 then Result::Err(SignalError::SystemError(-1))
  else Result::Ok(())
  end
end

## Set an alarm (SIGALRM after `seconds`). Returns remaining seconds of previous alarm.
def set_alarm(seconds: Int) -> Int
  alarm(seconds)
end

## Block a set of signals.
def block(signals: &[Signal]) -> Result[Unit, SignalError]
  let mut mask: [u8; 128] = unsafe { std::core::zeroed() }
  sigemptyset(&mut mask)
  for sig in signals do
    sigaddset(&mut mask, sig.to_raw())
  end
  let ret = sigprocmask(SIG_BLOCK, &mask, unsafe { std::core::zeroed() })
  if ret != 0 then Result::Err(SignalError::SystemError(-1))
  else Result::Ok(())
  end
end

## Unblock a set of signals.
def unblock(signals: &[Signal]) -> Result[Unit, SignalError]
  let mut mask: [u8; 128] = unsafe { std::core::zeroed() }
  sigemptyset(&mut mask)
  for sig in signals do
    sigaddset(&mut mask, sig.to_raw())
  end
  let ret = sigprocmask(SIG_UNBLOCK, &mask, unsafe { std::core::zeroed() })
  if ret != 0 then Result::Err(SignalError::SystemError(-1))
  else Result::Ok(())
  end
end

## Wait for any pending signal (blocks the thread).
def wait_for_signal() -> Signal
  pause()
  let mut i = 1
  while i < 32 do
    let sig = Signal::from_raw(i)
    match sig
    when Option::Some(s) then if take_pending(s) then return s end
    when Option::None then ()
    end
    i = i + 1
  end
  Signal::Terminate
end

## Convenience: trap SIGINT and SIGTERM for graceful shutdown.
def trap_shutdown() -> Result[Unit, SignalError]
  trap(Signal::Interrupt)?
  trap(Signal::Terminate)?
  Result::Ok(())
end

## Convenience: check if shutdown was requested (SIGINT or SIGTERM received).
def shutdown_requested() -> Bool
  is_pending(Signal::Interrupt) || is_pending(Signal::Terminate)
end

@ffi("c") extern def __errno_location() -> *i32 end

def _errno() -> Int
  unsafe { *__errno_location() as Int }
end

end ## module std::signal
