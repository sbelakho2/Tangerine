## std::wasm_js — JavaScript / Browser interop for WASM targets
## Provides JS value marshalling, DOM bindings, Web API access, and bindgen.
## Spec: §stdlib.wasm_js
##
## Only available when compiling with `--target wasm32-unknown-unknown` or
## `--target wasm32-wasi`. Host-side code should use std::wasm instead.

module std::wasm_js

use std::core::{Result, Option, Display, Clone, Drop}
use std::collections::{HashMap}

# ═══════════════════════════════════════════════════════════════════════
# §1  JS Value Representation
# ═══════════════════════════════════════════════════════════════════════

/// Opaque handle to a JavaScript value held across the FFI boundary.
/// Internally a u32 index into a slab in the JS glue code.
pub struct JsValue
  _handle: u32
end

pub enum JsType
  Undefined
  Null
  Boolean
  Number
  BigInt
  String
  Symbol
  Object
  Function
  Array
end

impl JsValue
  /// The JS `undefined` value.
  pub def undefined() -> JsValue
    JsValue { _handle: _js_undefined() }
  end

  /// The JS `null` value.
  pub def null() -> JsValue
    JsValue { _handle: _js_null() }
  end

  pub def from_bool(v: Bool) -> JsValue
    JsValue { _handle: _js_from_bool(v) }
  end

  pub def from_f64(v: f64) -> JsValue
    JsValue { _handle: _js_from_f64(v) }
  end

  pub def from_str(v: &str) -> JsValue
    JsValue { _handle: _js_from_str(v.as_ptr(), v.len() as u32) }
  end

  pub def from_i32(v: i32) -> JsValue
    JsValue { _handle: _js_from_f64(v as f64) }
  end

  /// Get the JS type of this value.
  pub def js_typeof(self) -> JsType
    match _js_typeof(self._handle)
    when 0 then JsType.Undefined
    when 1 then JsType.Null
    when 2 then JsType.Boolean
    when 3 then JsType.Number
    when 4 then JsType.BigInt
    when 5 then JsType.String
    when 6 then JsType.Symbol
    when 7 then JsType.Object
    when 8 then JsType.Function
    when 9 then JsType.Array
    when _ then JsType.Undefined
    end
  end

  /// Convert to Tangerine bool. Returns None if not a boolean.
  pub def as_bool(self) -> Option[Bool]
    if _js_is_bool(self._handle) then
      Some(_js_to_bool(self._handle))
    else None end
  end

  /// Convert to f64. Returns None if not a number.
  pub def as_f64(self) -> Option[f64]
    if _js_is_number(self._handle) then
      Some(_js_to_f64(self._handle))
    else None end
  end

  /// Convert to String. Returns None if not a string.
  pub def as_string(self) -> Option[String]
    if _js_is_string(self._handle) then
      let len = _js_string_len(self._handle)
      var buf: Vec[u8] = Vec.with_capacity(len as usize)
      _js_string_copy(self._handle, buf.as_mut_ptr(), len)
      unsafe { buf.set_len(len as usize) }
      Some(String.from_bytes(buf))
    else None end
  end

  pub def is_undefined(self) -> Bool = _js_typeof(self._handle) == 0
  pub def is_null(self) -> Bool = _js_typeof(self._handle) == 1
  pub def is_object(self) -> Bool = _js_typeof(self._handle) == 7
  pub def is_function(self) -> Bool = _js_typeof(self._handle) == 8
  pub def is_array(self) -> Bool = _js_typeof(self._handle) == 9

  /// Access a property: `obj.get("key")`
  pub def get(self, key: &str) -> JsValue
    JsValue { _handle: _js_get_prop(self._handle, key.as_ptr(), key.len() as u32) }
  end

  /// Set a property: `obj.set("key", value)`
  pub def set(self, key: &str, value: &JsValue)
    _js_set_prop(self._handle, key.as_ptr(), key.len() as u32, value._handle)
  end

  /// Call as function with given args.
  pub def call(self, args: &[JsValue]) -> Result[JsValue, JsError]
    let handles: Vec[u32] = args.iter().map(|v| v._handle).collect()
    let result = _js_call(self._handle, handles.as_ptr(), handles.len() as u32)
    if _js_is_exception(result) then
      Err(JsError.from_handle(result))
    else
      Ok(JsValue { _handle: result })
    end
  end

  /// Call a method on this object.
  pub def call_method(self, method: &str, args: &[JsValue]) -> Result[JsValue, JsError]
    let func = self.get(method)
    if func.is_function() then
      let handles: Vec[u32] = args.iter().map(|v| v._handle).collect()
      let result = _js_call_method(self._handle, method.as_ptr(), method.len() as u32,
        handles.as_ptr(), handles.len() as u32)
      if _js_is_exception(result) then
        Err(JsError.from_handle(result))
      else
        Ok(JsValue { _handle: result })
      end
    else
      Err(JsError.new("not a function: " + method))
    end
  end

  /// Construct (new) with arguments.
  pub def new_instance(self, args: &[JsValue]) -> Result[JsValue, JsError]
    let handles: Vec[u32] = args.iter().map(|v| v._handle).collect()
    let result = _js_construct(self._handle, handles.as_ptr(), handles.len() as u32)
    if _js_is_exception(result) then
      Err(JsError.from_handle(result))
    else
      Ok(JsValue { _handle: result })
    end
  end
end

impl Drop for JsValue
  def drop(mut self)
    _js_release(self._handle)
  end
end

impl Clone for JsValue
  def clone(self) -> JsValue
    JsValue { _handle: _js_clone(self._handle) }
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §2  JS Error
# ═══════════════════════════════════════════════════════════════════════

pub struct JsError
  pub message: String
  _handle: Option[u32]
end

impl JsError
  pub def new(msg: &str) -> JsError
    JsError { message: msg.to_string(), _handle: None }
  end

  fn from_handle(handle: u32) -> JsError
    let msg_handle = _js_get_prop(handle, "message".as_ptr(), 7)
    let len = _js_string_len(msg_handle)
    var buf: Vec[u8] = Vec.with_capacity(len as usize)
    _js_string_copy(msg_handle, buf.as_mut_ptr(), len)
    unsafe { buf.set_len(len as usize) }
    _js_release(msg_handle)
    JsError {
      message: String.from_utf8_lossy(&buf).to_string(),
      _handle: Some(handle),
    }
  end
end

impl Display for JsError
  def to_string(self) -> String = "JsError: " + &self.message
end

# ═══════════════════════════════════════════════════════════════════════
# §3  Global Objects & Browser APIs
# ═══════════════════════════════════════════════════════════════════════

/// Access the JS globalThis object.
pub def global_this() -> JsValue
  JsValue { _handle: _js_global_this() }
end

/// Access `window` (browser) or `globalThis` (node).
pub def window() -> JsValue = global_this()

/// Access `document` object.
pub def document() -> JsValue
  global_this().get("document")
end

/// Evaluate a JavaScript expression string.
pub def eval(code: &str) -> Result[JsValue, JsError]
  let result = _js_eval(code.as_ptr(), code.len() as u32)
  if _js_is_exception(result) then
    Err(JsError.from_handle(result))
  else
    Ok(JsValue { _handle: result })
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §4  DOM Bindings
# ═══════════════════════════════════════════════════════════════════════

/// Lightweight typed wrapper around a DOM Element.
pub struct Element
  _value: JsValue
end

impl Element
  pub def from_js(value: JsValue) -> Option[Element]
    if value.is_object() then
      Some(Element { _value: value })
    else None end
  end

  pub def query_selector(selector: &str) -> Option[Element]
    let doc = document()
    let result = doc.call_method("querySelector", &[JsValue.from_str(selector)])
    match result
    when Ok(v) then
      if v.is_null() then None else Some(Element { _value: v }) end
    when _ then None
    end
  end

  pub def query_selector_all(selector: &str) -> Vec[Element]
    let doc = document()
    let result = doc.call_method("querySelectorAll", &[JsValue.from_str(selector)])
    match result
    when Ok(node_list) then
      let len = node_list.get("length").as_f64().unwrap_or(0.0) as usize
      var elements = Vec.with_capacity(len)
      for i in 0..len do
        let item = node_list.call_method("item", &[JsValue.from_f64(i as f64)])
        if let Ok(v) = item then
          elements.push(Element { _value: v })
        end
      end
      elements
    when Err(_) then Vec.new()
    end
  end

  pub def create(tag: &str) -> Element
    let doc = document()
    let el = doc.call_method("createElement", &[JsValue.from_str(tag)]).unwrap()
    Element { _value: el }
  end

  pub def inner_html(self) -> String
    self._value.get("innerHTML").as_string().unwrap_or_default()
  end

  pub def set_inner_html(self, html: &str)
    self._value.set("innerHTML", &JsValue.from_str(html))
  end

  pub def text_content(self) -> String
    self._value.get("textContent").as_string().unwrap_or_default()
  end

  pub def set_text_content(self, text: &str)
    self._value.set("textContent", &JsValue.from_str(text))
  end

  pub def get_attribute(self, name: &str) -> Option[String]
    let result = self._value.call_method("getAttribute", &[JsValue.from_str(name)])
    match result
    when Ok(v) then v.as_string()
    when Err(_) then None
    end
  end

  pub def set_attribute(self, name: &str, value: &str)
    let _ = self._value.call_method("setAttribute",
      &[JsValue.from_str(name), JsValue.from_str(value)])
  end

  pub def remove_attribute(self, name: &str)
    let _ = self._value.call_method("removeAttribute", &[JsValue.from_str(name)])
  end

  pub def class_list_add(self, class: &str)
    let cl = self._value.get("classList")
    let _ = cl.call_method("add", &[JsValue.from_str(class)])
  end

  pub def class_list_remove(self, class: &str)
    let cl = self._value.get("classList")
    let _ = cl.call_method("remove", &[JsValue.from_str(class)])
  end

  pub def class_list_toggle(self, class: &str)
    let cl = self._value.get("classList")
    let _ = cl.call_method("toggle", &[JsValue.from_str(class)])
  end

  pub def append_child(self, child: &Element)
    let _ = self._value.call_method("appendChild", &[child._value.clone()])
  end

  pub def remove(self)
    let empty_args: Vec[JsValue] = Vec::new()
    let _ = self._value.call_method("remove", &empty_args)
  end

  pub def add_event_listener(self, event: &str, callback: JsClosure)
    let _ = self._value.call_method("addEventListener",
      &[JsValue.from_str(event), callback.as_js()])
  end

  pub def style(self) -> JsValue
    self._value.get("style")
  end

  pub def as_js(self) -> &JsValue = &self._value
end

# ═══════════════════════════════════════════════════════════════════════
# §5  JS Closures (Tangerine → JS callbacks)
# ═══════════════════════════════════════════════════════════════════════

/// A closure that can be passed to JS as a callback function.
/// Must be explicitly freed or leaked to prevent dangling references.
pub struct JsClosure
  _handle: u32
  _prevent_drop: Bool
end

impl JsClosure
  /// Create a JS-callable closure from a Tangerine closure.
  pub def new[F: FnMut(JsValue) + 'static](f: F) -> JsClosure
    let boxed = Box.new(f)
    let raw = Box.into_raw(boxed) as u32
    let handle = _js_create_closure(raw, _closure_invoke_trampoline as Ptr[u8])
    JsClosure { _handle: handle, _prevent_drop: false }
  end

  /// Create a closure that takes no arguments.
  pub def wrap0[F: FnMut() + 'static](f: F) -> JsClosure
    JsClosure.new(move |_| f())
  end

  /// Leak the closure so it lives forever. Used for permanent event handlers.
  pub def forget(mut self)
    self._prevent_drop = true
  end

  pub def as_js(self) -> JsValue
    JsValue { _handle: _js_closure_to_jsvalue(self._handle) }
  end
end

impl Drop for JsClosure
  def drop(mut self)
    if !self._prevent_drop then
      _js_release_closure(self._handle)
    end
  end
end

/// Trampoline called from JS to invoke the Tangerine closure.
@[export_name = "__tg_closure_invoke"]
pub def _closure_invoke_trampoline(data: u32, arg: u32) -> u32
  let closure = unsafe { &mut *(data as *mut Box[dyn FnMut(JsValue)]) }
  let js_arg = JsValue { _handle: arg }
  closure(js_arg)
  0  ## return undefined
end

# ═══════════════════════════════════════════════════════════════════════
# §6  Fetch API (WASM-native HTTP)
# ═══════════════════════════════════════════════════════════════════════

pub struct FetchRequest
  pub url: String
  pub method: String
  pub headers: HashMap[String, String]
  pub body: Option[String]
end

impl FetchRequest
  pub def get(url: &str) -> FetchRequest
    FetchRequest {
      url: url.to_string(),
      method: "GET".to_string(),
      headers: HashMap.new(),
      body: None,
    }
  end

  pub def post(url: &str) -> FetchRequest
    FetchRequest {
      url: url.to_string(),
      method: "POST".to_string(),
      headers: HashMap.new(),
      body: None,
    }
  end

  pub def with_header(mut self, key: &str, value: &str) -> FetchRequest
    self.headers.insert(key.to_string(), value.to_string())
    self
  end

  pub def with_json_body(mut self, json: &str) -> FetchRequest
    self.headers.insert("Content-Type".to_string(), "application/json".to_string())
    self.body = Some(json.to_string())
    self
  end

  /// Execute the fetch. Returns a Future that resolves to a FetchResponse.
  pub async def send(self) -> Result[FetchResponse, JsError]
    let g = global_this()
    let fetch_fn = g.get("fetch")

    let opts = eval("({})")?.clone()
    opts.set("method", &JsValue.from_str(&self.method))

    if !self.headers.is_empty() then
      let headers_args: Vec[JsValue] = Vec::new()
      let headers_obj = g.get("Headers").new_instance(&headers_args)?
      for (k, v) in self.headers.entries() do
        let _ = headers_obj.call_method("append",
          &[JsValue.from_str(k.as_str()), JsValue.from_str(v.as_str())])
      end
      opts.set("headers", &headers_obj)
    end

    if let Some(body) = &self.body then
      opts.set("body", &JsValue.from_str(body))
    end

    let promise = fetch_fn.call(&[JsValue.from_str(&self.url), opts])?
    let response = _await_js_promise(promise._handle).await?
    Ok(FetchResponse { _value: response })
  end
end

pub struct FetchResponse
  _value: JsValue
end

impl FetchResponse
  pub def status(self) -> u16
    self._value.get("status").as_f64().unwrap_or(0.0) as u16
  end

  pub def ok(self) -> Bool
    self._value.get("ok").as_bool().unwrap_or(false)
  end

  pub async def text(self) -> Result[String, JsError]
    let empty_args: Vec[JsValue] = Vec::new()
    let promise = self._value.call_method("text", &empty_args)?
    let result = _await_js_promise(promise._handle).await?
    result.as_string().ok_or(JsError.new("response is not text"))
  end

  pub async def json(self) -> Result[JsValue, JsError]
    let empty_args: Vec[JsValue] = Vec::new()
    let promise = self._value.call_method("json", &empty_args)?
    _await_js_promise(promise._handle).await
  end

  pub async def array_buffer(self) -> Result[Vec[u8], JsError]
    let empty_args: Vec[JsValue] = Vec::new()
    let promise = self._value.call_method("arrayBuffer", &empty_args)?
    let ab = _await_js_promise(promise._handle).await?
    let uint8 = global_this().get("Uint8Array").new_instance(&[ab])?
    let len = uint8.get("length").as_f64().unwrap_or(0.0) as usize
    var buf: Vec[u8] = Vec.with_capacity(len)
    _js_copy_typed_array(uint8._handle, buf.as_mut_ptr(), len as u32)
    unsafe { buf.set_len(len) }
    Ok(buf)
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §7  Console API
# ═══════════════════════════════════════════════════════════════════════

pub mod console
  use super::*

  pub def log(args: &[JsValue])
    let c = global_this().get("console")
    let _ = c.call_method("log", args)
  end

  pub def warn(args: &[JsValue])
    let c = global_this().get("console")
    let _ = c.call_method("warn", args)
  end

  pub def error(args: &[JsValue])
    let c = global_this().get("console")
    let _ = c.call_method("error", args)
  end

  pub def log_str(msg: &str)
    log(&[JsValue.from_str(msg)])
  end

  pub def time(label: &str)
    let c = global_this().get("console")
    let _ = c.call_method("time", &[JsValue.from_str(label)])
  end

  pub def time_end(label: &str)
    let c = global_this().get("console")
    let _ = c.call_method("timeEnd", &[JsValue.from_str(label)])
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §8  Timers
# ═══════════════════════════════════════════════════════════════════════

pub struct TimerId
  _id: i32
end

pub def set_timeout(ms: u32, callback: JsClosure) -> TimerId
  let g = global_this()
  let result = g.call_method("setTimeout",
    &[callback.as_js(), JsValue.from_f64(ms as f64)]).unwrap()
  callback.forget()
  TimerId { _id: result.as_f64().unwrap_or(0.0) as i32 }
end

pub def set_interval(ms: u32, callback: JsClosure) -> TimerId
  let g = global_this()
  let result = g.call_method("setInterval",
    &[callback.as_js(), JsValue.from_f64(ms as f64)]).unwrap()
  callback.forget()
  TimerId { _id: result.as_f64().unwrap_or(0.0) as i32 }
end

pub def clear_timeout(id: TimerId)
  let g = global_this()
  let _ = g.call_method("clearTimeout", &[JsValue.from_f64(id._id as f64)])
end

pub def clear_interval(id: TimerId)
  let g = global_this()
  let _ = g.call_method("clearInterval", &[JsValue.from_f64(id._id as f64)])
end

pub def request_animation_frame(callback: JsClosure) -> i32
  let g = global_this()
  let result = g.call_method("requestAnimationFrame", &[callback.as_js()]).unwrap()
  callback.forget()
  result.as_f64().unwrap_or(0.0) as i32
end

# ═══════════════════════════════════════════════════════════════════════
# §9  Promise Integration
# ═══════════════════════════════════════════════════════════════════════

/// Convert a Tangerine async function into a JS Promise.
pub def to_promise[F: Future[Output = Result[JsValue, JsError]] + 'static](future: F) -> JsValue
  let boxed = Box.new(future)
  let raw = Box.into_raw(boxed) as u32
  let handle = _js_create_promise(raw)
  JsValue { _handle: handle }
end

/// Await a JS Promise from Tangerine async code.
async def _await_js_promise(handle: u32) -> Result[JsValue, JsError]
  let result_handle = _js_await_promise(handle).await
  if _js_is_exception(result_handle) then
    Err(JsError.from_handle(result_handle))
  else
    Ok(JsValue { _handle: result_handle })
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §10 TypedArray / ArrayBuffer interop
# ═══════════════════════════════════════════════════════════════════════

/// Create a JS Uint8Array backed by WASM memory (zero-copy view).
pub def u8_slice_to_js(data: &[u8]) -> JsValue
  let handle = _js_create_uint8array_view(data.as_ptr() as u32, data.len() as u32)
  JsValue { _handle: handle }
end

/// Create a JS Float32Array backed by WASM memory.
pub def f32_slice_to_js(data: &[f32]) -> JsValue
  let handle = _js_create_float32array_view(
    data.as_ptr() as u32,
    (data.len() * 4) as u32,
  )
  JsValue { _handle: handle }
end

/// Copy a JS TypedArray into a Vec<u8>.
pub def js_to_u8_vec(typed_array: &JsValue) -> Vec[u8]
  let len = typed_array.get("byteLength").as_f64().unwrap_or(0.0) as usize
  var buf: Vec[u8] = Vec.with_capacity(len)
  _js_copy_typed_array(typed_array._handle, buf.as_mut_ptr(), len as u32)
  unsafe { buf.set_len(len) }
  buf
end

# ═══════════════════════════════════════════════════════════════════════
# §11 Bindgen Support
# ═══════════════════════════════════════════════════════════════════════

/// Attribute to auto-generate JS bindings for an exported function.
/// Usage:
///   @[wasm_bindgen]
///   pub def greet(name: &str) -> String
///     "Hello, " + name
///   end
///
/// The compiler generates:
/// - WASM export with appropriate marshalling
/// - JS glue code with correct types
/// - TypeScript .d.ts declarations
pub def wasm_bindgen() -> Unit
  @compiler_directive("wasm_bindgen")
end

/// Mark a struct to be automatically marshalled across the JS boundary.
/// Usage:
///   @[wasm_bindgen]
///   pub struct Point
///     pub x: f64
///     pub y: f64
///   end
///
/// Generates:
/// - JS class wrapper
/// - Getter/setter for each pub field
/// - TypeScript interface
pub def wasm_bindgen_struct() -> Unit
  @compiler_directive("wasm_bindgen_struct")
end

/// Import a JS module/function.
/// Usage:
///   @[js_import(module = "lodash", name = "cloneDeep")]
///   extern def clone_deep(obj: JsValue) -> JsValue
pub def js_import(module: &str, name: &str) -> Unit
  @compiler_directive("js_import", module, name)
end

/// Inline JS code for escape-hatch interop.
/// Usage:
///   let result = js_inline!("return document.title")
pub macro js_inline!(code: &str) -> JsValue
  eval(code).unwrap_or(JsValue.undefined())
end

# ═══════════════════════════════════════════════════════════════════════
# §12 Web Worker Support
# ═══════════════════════════════════════════════════════════════════════

pub struct Worker
  _value: JsValue
end

impl Worker
  pub def new(script_url: &str) -> Result[Worker, JsError]
    let g = global_this()
    let worker_cls = g.get("Worker")
    let w = worker_cls.new_instance(&[JsValue.from_str(script_url)])?
    Ok(Worker { _value: w })
  end

  pub def post_message(self, data: &JsValue)
    let _ = self._value.call_method("postMessage", &[data.clone()])
  end

  pub def on_message(self, callback: JsClosure)
    self._value.set("onmessage", &callback.as_js())
    callback.forget()
  end

  pub def terminate(self)
    let empty_args: Vec[JsValue] = Vec::new()
    let _ = self._value.call_method("terminate", &empty_args)
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §13 Internal FFI stubs (implemented by JS glue)
# ═══════════════════════════════════════════════════════════════════════

@[wasm_import(module = "__tg_js")]
extern def _js_undefined() -> u32
@[wasm_import(module = "__tg_js")]
