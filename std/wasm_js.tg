# ═══════════════════════════════════════════════════════════════════════
# §14 Tests
# ═══════════════════════════════════════════════════════════════════════

@test
def test_jsvalue_from_primitives() -> Unit
  let v = JsValue.from_f64(42.0)
  assert v.as_f64() == Some(42.0)

  let s = JsValue.from_str("hello")
  assert s.as_string() == Some("hello")

  let b = JsValue.from_bool(true)
  assert b.as_bool() == Some(true)
end

@test
def test_jsvalue_undefined_null() -> Unit
  let u = JsValue.undefined()
  assert u.is_undefined()
  let n = JsValue.null()
  assert n.is_null()
end

@test
def test_fetch_request_builder() -> Unit
  let req = FetchRequest.post("https://api.example.com/data")
    .with_header("Authorization", "Bearer token")
    .with_json_body("{\"key\": \"value\"}")
  assert req.method == "POST"
  assert req.headers.get("Content-Type") == Some(&"application/json".to_string())
end

end ## module std::wasm_js
