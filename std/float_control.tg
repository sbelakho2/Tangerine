## std::float_control — Deterministic Floating-Point Control
## Provides fine-grained control over IEEE 754 floating-point behavior,
## enabling deterministic results across platforms for multiplayer games,
## simulations, and scientific computing.
##
## Design goals:
##   - Per-scope floating-point mode control
##   - Fast-math opt-in (not default) with explicit flags
##   - Deterministic mode for cross-platform reproducibility
##   - Rounding mode control
##   - Denormal handling configuration
##   - Exception flag access
##   - Compile-time and runtime mode selection
##
## Spec: §stdlib.float_control

module std::float_control

use std::core::{Result, Option, Clone, Display}

# ═══════════════════════════════════════════════════════════════════════
# §1  Rounding Modes
# ═══════════════════════════════════════════════════════════════════════

/// IEEE 754 rounding modes.
pub enum RoundingMode
  /// Round to nearest, ties to even (default IEEE 754 behavior).
  NearestEven
  /// Round toward positive infinity.
  TowardPositiveInfinity
  /// Round toward negative infinity.
  TowardNegativeInfinity
  /// Round toward zero (truncation).
  TowardZero
  /// Round to nearest, ties away from zero.
  NearestAwayFromZero
end

/// Get the current hardware rounding mode.
pub def get_rounding_mode() -> RoundingMode
  let mode = _get_fpscr_rounding()
  if mode == 0 then
    RoundingMode.NearestEven
  elsif mode == 1 then
    RoundingMode.TowardPositiveInfinity
  elsif mode == 2 then
    RoundingMode.TowardNegativeInfinity
  elsif mode == 3 then
    RoundingMode.TowardZero
  else
    RoundingMode.NearestEven
  end
end

/// Set the hardware rounding mode. Returns the previous mode.
pub def set_rounding_mode(mode: RoundingMode) -> RoundingMode
  let prev = get_rounding_mode()
  let code = if mode == RoundingMode.NearestEven then
    0
  elsif mode == RoundingMode.TowardPositiveInfinity then
    1
  elsif mode == RoundingMode.TowardNegativeInfinity then
    2
  elsif mode == RoundingMode.TowardZero then
    3
  else
    0
  end
  _set_fpscr_rounding(code)
  prev
end

/// RAII guard that restores the rounding mode on drop.
pub struct RoundingModeGuard
  _previous: RoundingMode
end

impl RoundingModeGuard
  pub def new(mode: RoundingMode) -> RoundingModeGuard
    let prev = set_rounding_mode(mode)
    RoundingModeGuard { _previous: prev }
  end
end

impl Drop for RoundingModeGuard
  def drop(&mut self)
    set_rounding_mode(self._previous)
    ()
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §2  Denormal (Subnormal) Handling
# ═══════════════════════════════════════════════════════════════════════

pub enum DenormalMode
  /// IEEE 754 compliant: preserve denormals (slower on some hardware).
  Preserve
  /// Flush denormals to zero (FTZ) — faster, loses precision near zero.
  FlushToZero
  /// Denormals-are-zero (DAZ) — treat denormal inputs as zero.
  DenormalsAreZero
  /// Both FTZ and DAZ — maximum performance, least precision near zero.
  FlushAndDaz
end

pub def get_denormal_mode() -> DenormalMode
  let ftz = _get_ftz_flag()
  let daz = _get_daz_flag()
  match (ftz, daz)
    when (false, false) then DenormalMode.Preserve
    when (true, false) then DenormalMode.FlushToZero
    when (false, true) then DenormalMode.DenormalsAreZero
    else DenormalMode.FlushAndDaz
  end
end

pub def set_denormal_mode(mode: DenormalMode) -> DenormalMode
  let prev = get_denormal_mode()
  match mode
    when DenormalMode.Preserve then { _set_ftz_flag(false); _set_daz_flag(false) }
    when DenormalMode.FlushToZero then { _set_ftz_flag(true); _set_daz_flag(false) }
    when DenormalMode.DenormalsAreZero then { _set_ftz_flag(false); _set_daz_flag(true) }
    else { _set_ftz_flag(true); _set_daz_flag(true) }
  end
  prev
end

pub struct DenormalModeGuard
  _previous: DenormalMode
end

impl DenormalModeGuard
  pub def new(mode: DenormalMode) -> DenormalModeGuard
    let prev = set_denormal_mode(mode)
    DenormalModeGuard { _previous: prev }
  end
end

impl Drop for DenormalModeGuard
  def drop(&mut self)
    set_denormal_mode(self._previous)
    ()
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §3  Fast-Math Flags
# ═══════════════════════════════════════════════════════════════════════

/// Individual fast-math optimization flags.
/// These allow the compiler to apply IEEE-non-compliant optimizations.
/// Each flag must be explicitly opted into.
pub struct FastMathFlags
  /// Allow reassociation of float operations: (a+b)+c → a+(b+c)
  pub reassociate: Bool
  /// Allow reciprocal approximation: x/y → x * (1/y)
  pub reciprocal: Bool
  /// Assume no NaN values exist
  pub no_nans: Bool
  /// Assume no Inf values exist
  pub no_infs: Bool
  /// Assume no signed zeros: -0.0 == +0.0
  pub no_signed_zeros: Bool
  /// Allow contraction of mul+add into FMA
  pub contract: Bool
  /// Allow approximate functions (faster trig, sqrt, etc.)
  pub approximate_funcs: Bool
end

impl FastMathFlags
  /// Strict IEEE 754 compliance — no fast-math optimizations.
  pub const STRICT: FastMathFlags = FastMathFlags {
    reassociate: false, reciprocal: false, no_nans: false,
    no_infs: false, no_signed_zeros: false, contract: false,
    approximate_funcs: false,
  }

  /// Maximum performance — all fast-math flags enabled.
  /// WARNING: Can produce incorrect results with NaN/Inf/denormals.
  pub const FAST: FastMathFlags = FastMathFlags {
    reassociate: true, reciprocal: true, no_nans: true,
    no_infs: true, no_signed_zeros: true, contract: true,
    approximate_funcs: true,
  }

  /// Conservative fast-math: only contraction (FMA) and no-signed-zeros.
  /// Safe for most graphics workloads.
  pub const GRAPHICS: FastMathFlags = FastMathFlags {
    reassociate: false, reciprocal: false, no_nans: false,
    no_infs: false, no_signed_zeros: true, contract: true,
    approximate_funcs: false,
  }

  /// Physics simulation: FMA + reassociation but preserve NaN/Inf.
  pub const PHYSICS: FastMathFlags = FastMathFlags {
    reassociate: true, reciprocal: false, no_nans: false,
    no_infs: false, no_signed_zeros: true, contract: true,
    approximate_funcs: false,
  }
end

/// Apply fast-math flags to a block of code (compile-time annotation).
/// Usage:
///   @[fast_math(FastMathFlags.GRAPHICS)]
///   def render_frame() -> Unit { ... }
///
/// The attribute instructs the backend to emit relaxed float ops for the scope.
@comptime
pub def fast_math(flags: FastMathFlags) -> Attribute
  _compiler_set_fast_math_flags(flags)
end

# ═══════════════════════════════════════════════════════════════════════
# §4  Deterministic Mode
# ═══════════════════════════════════════════════════════════════════════

/// Deterministic floating-point configuration for cross-platform reproducibility.
/// When enabled, the compiler guarantees identical results for the same input
/// across x86_64, ARM64, and WASM targets.
pub struct DeterministicConfig
  /// Force operation ordering (prevent reassociation).
  pub strict_ordering: Bool
  /// Disable FMA contraction (mul+add stays as two ops).
  pub no_fma_contraction: Bool
  /// Force all intermediate results to the declared precision (no x87 80-bit).
  pub intermediate_precision_control: Bool
  /// Disable auto-vectorization that might change result order.
  pub no_auto_vectorize: Bool
  /// Explicit rounding mode for all operations.
  pub rounding: RoundingMode
  /// Denormal mode.
  pub denormals: DenormalMode
end

impl DeterministicConfig
  /// Full determinism: identical results on all platforms.
  /// Suitable for lockstep multiplayer, replay systems, physics simulations.
  pub const FULL: DeterministicConfig = DeterministicConfig {
    strict_ordering: true,
    no_fma_contraction: true,
    intermediate_precision_control: true,
    no_auto_vectorize: true,
    rounding: RoundingMode.NearestEven,
    denormals: DenormalMode.Preserve,
  }

  /// Relaxed determinism: allows FMA and vectorization.
  /// Results are consistent *within a single platform/build* but may
  /// differ between x86 and ARM.
  pub const PLATFORM_CONSISTENT: DeterministicConfig = DeterministicConfig {
    strict_ordering: true,
    no_fma_contraction: false,
    intermediate_precision_control: true,
    no_auto_vectorize: false,
    rounding: RoundingMode.NearestEven,
    denormals: DenormalMode.Preserve,
  }
end

/// Apply deterministic float mode to a module or function.
/// Usage:
///   @[deterministic_float(DeterministicConfig.FULL)]
///   module physics_simulation { ... }
@comptime
pub def deterministic_float(config: DeterministicConfig) -> Attribute
  _compiler_set_deterministic_config(config)
end

/// RAII guard to set deterministic mode at runtime.
pub struct DeterministicGuard
  _prev_rounding: RoundingMode
  _prev_denormal: DenormalMode
end

impl DeterministicGuard
  pub def new(config: &DeterministicConfig) -> DeterministicGuard
    let prev_r = set_rounding_mode(config.rounding)
    let prev_d = set_denormal_mode(config.denormals)
    DeterministicGuard { _prev_rounding: prev_r, _prev_denormal: prev_d }
  end
end

impl Drop for DeterministicGuard
  def drop(&mut self)
    set_rounding_mode(self._prev_rounding)
    set_denormal_mode(self._prev_denormal)
    ()
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §5  FP Exception Flags
# ═══════════════════════════════════════════════════════════════════════

/// IEEE 754 exception flags (sticky bits).
pub struct FpExceptionFlags
  pub invalid_operation: Bool    ## 0/0, sqrt(-1), etc.
  pub division_by_zero: Bool
  pub overflow: Bool
  pub underflow: Bool
  pub inexact: Bool              ## Rounding occurred
end

impl FpExceptionFlags
  pub def none() -> FpExceptionFlags
    FpExceptionFlags {
      invalid_operation: false, division_by_zero: false,
      overflow: false, underflow: false, inexact: false,
    }
  end
end

/// Read the current FP exception flags.
pub def get_exception_flags() -> FpExceptionFlags
  let raw = _get_fpscr_exceptions()
  FpExceptionFlags {
    invalid_operation: raw & 0x01 != 0,
    division_by_zero: raw & 0x02 != 0,
    overflow: raw & 0x04 != 0,
    underflow: raw & 0x08 != 0,
    inexact: raw & 0x10 != 0,
  }
end

/// Clear all FP exception flags.
pub def clear_exception_flags()
  _clear_fpscr_exceptions()
end

/// Run a closure and return which FP exceptions occurred.
pub def check_exceptions[T](f: fn() -> T) -> (T, FpExceptionFlags)
  clear_exception_flags()
  let result = f()
  let flags = get_exception_flags()
  (result, flags)
end

# ═══════════════════════════════════════════════════════════════════════
# §6  Precision Utilities
# ═══════════════════════════════════════════════════════════════════════

/// Units in last place (ULP) distance between two f32 values.
pub def ulp_distance_f32(a: f32, b: f32) -> u32
  if a.is_nan() || b.is_nan() then return u32.MAX end
  let ai = a.to_bits() as i32
  let bi = b.to_bits() as i32
  let ai = if ai < 0 then 0x80000000_i32 - ai else ai end
  let bi = if bi < 0 then 0x80000000_i32 - bi else bi end
  (ai - bi).abs() as u32
end

/// ULP distance for f64.
pub def ulp_distance_f64(a: f64, b: f64) -> u64
  if a.is_nan() || b.is_nan() then return u64.MAX end
  let ai = a.to_bits() as i64
  let bi = b.to_bits() as i64
  let ai = if ai < 0 then 0x8000000000000000_i64 - ai else ai end
  let bi = if bi < 0 then 0x8000000000000000_i64 - bi else bi end
  (ai - bi).abs() as u64
end

/// Approximate equality within N ULPs.
pub def approx_eq_ulp_f32(a: f32, b: f32, max_ulps: u32) -> Bool
  ulp_distance_f32(a, b) <= max_ulps
end

pub def approx_eq_ulp_f64(a: f64, b: f64, max_ulps: u64) -> Bool
  ulp_distance_f64(a, b) <= max_ulps
end

/// Machine epsilon for a given type.
pub const F32_EPSILON: f32 = 1.1920929e-7    ## 2^-23
pub const F64_EPSILON: f64 = 2.220446049250313e-16  ## 2^-52

/// Next representable float after x.
pub def next_after_f32(x: f32, toward: f32) -> f32
  if x == toward then return x end
  if x.is_nan() || toward.is_nan() then return f32.NAN end
  var bits = x.to_bits()
  if x == 0.0 then
    bits = 1
    if toward < 0.0 then bits = 0x80000001 end
  elsif (toward > x) == (x > 0.0) then
    bits += 1
  else
    bits -= 1
  end
  f32.from_bits(bits)
end

pub def next_after_f64(x: f64, toward: f64) -> f64
  if x == toward then return x end
  if x.is_nan() || toward.is_nan() then return f64.NAN end
  var bits = x.to_bits()
  if x == 0.0 then
    bits = 1
    if toward < 0.0 then bits = 0x8000000000000001 end
  elsif (toward > x) == (x > 0.0) then
    bits += 1
  else
    bits -= 1
  end
  f64.from_bits(bits)
end

# ═══════════════════════════════════════════════════════════════════════
# §7  Platform Intrinsics
# ═══════════════════════════════════════════════════════════════════════

@cfg(target_arch = "x86_64")
mod x86_impl
  use std::core

  @inline(always)
  pub def _get_fpscr_rounding() -> i32
    let csr = 0u32
    asm!("stmxcsr [rsp-4]; mov eax, [rsp-4]" : "=a"(csr) : : : "volatile")
    ((csr >> 13) & 0x3) as i32
  end

  @inline(always)
  pub def _set_fpscr_rounding(mode: i32)
    var csr = 0u32
    asm!("stmxcsr [rsp-4]; mov eax, [rsp-4]" : "=a"(csr) : : : "volatile")
    csr = (csr & !0x6000) | ((mode as u32 & 0x3) << 13)
    asm!("mov [rsp-4], eax; ldmxcsr [rsp-4]" : : "a"(csr) : : "volatile")
  end

  @inline(always)
  pub def _get_ftz_flag() -> Bool
    let csr = 0u32
    asm!("stmxcsr [rsp-4]; mov eax, [rsp-4]" : "=a"(csr) : : : "volatile")
    csr & 0x8000 != 0
  end

  @inline(always)
  pub def _set_ftz_flag(on: Bool)
    var csr = 0u32
    asm!("stmxcsr [rsp-4]; mov eax, [rsp-4]" : "=a"(csr) : : : "volatile")
    if on then csr = csr | 0x8000 else csr = csr & !0x8000 end
    asm!("mov [rsp-4], eax; ldmxcsr [rsp-4]" : : "a"(csr) : : "volatile")
  end

  @inline(always)
  pub def _get_daz_flag() -> Bool
    let csr = 0u32
    asm!("stmxcsr [rsp-4]; mov eax, [rsp-4]" : "=a"(csr) : : : "volatile")
    csr & 0x0040 != 0
  end

  @inline(always)
  pub def _set_daz_flag(on: Bool)
    var csr = 0u32
    asm!("stmxcsr [rsp-4]; mov eax, [rsp-4]" : "=a"(csr) : : : "volatile")
    if on then csr = csr | 0x0040 else csr = csr & !0x0040 end
    asm!("mov [rsp-4], eax; ldmxcsr [rsp-4]" : : "a"(csr) : : "volatile")
  end

  @inline(always)
  pub def _get_fpscr_exceptions() -> u32
    let csr = 0u32
    asm!("stmxcsr [rsp-4]; mov eax, [rsp-4]" : "=a"(csr) : : : "volatile")
    csr & 0x3F
  end

  @inline(always)
  pub def _clear_fpscr_exceptions()
    var csr = 0u32
    asm!("stmxcsr [rsp-4]; mov eax, [rsp-4]" : "=a"(csr) : : : "volatile")
    csr = csr & !0x3F
    asm!("mov [rsp-4], eax; ldmxcsr [rsp-4]" : : "a"(csr) : : "volatile")
  end
end

@cfg(target_arch = "aarch64")
mod arm_impl
  @inline(always)
  pub def _get_fpscr_rounding() -> i32
    let fpcr = 0u64
    asm!("mrs x0, fpcr" : "=r"(fpcr) : : : "volatile")
    ((fpcr >> 22) & 0x3) as i32
  end

  @inline(always)
  pub def _set_fpscr_rounding(mode: i32)
    var fpcr = 0u64
    asm!("mrs x0, fpcr" : "=r"(fpcr) : : : "volatile")
    fpcr = (fpcr & !0xC00000) | ((mode as u64 & 0x3) << 22)
    asm!("msr fpcr, x0" : : "r"(fpcr) : : "volatile")
  end

  @inline(always)
  pub def _get_ftz_flag() -> Bool
    let fpcr = 0u64
    asm!("mrs x0, fpcr" : "=r"(fpcr) : : : "volatile")
    fpcr & (1 << 24) != 0
  end

  @inline(always)
  pub def _set_ftz_flag(on: Bool)
    var fpcr = 0u64
    asm!("mrs x0, fpcr" : "=r"(fpcr) : : : "volatile")
    if on then fpcr = fpcr | (1 << 24) else fpcr = fpcr & !(1 << 24) end
    asm!("msr fpcr, x0" : : "r"(fpcr) : : "volatile")
  end

  @inline(always)
  pub def _get_daz_flag() -> Bool = false  ## ARM does not have separate DAZ

  @inline(always)
  pub def _set_daz_flag(_on: Bool) = ()   ## No-op on ARM

  @inline(always)
  pub def _get_fpscr_exceptions() -> u32
    let fpsr = 0u64
    asm!("mrs x0, fpsr" : "=r"(fpsr) : : : "volatile")
    (fpsr & 0x1F) as u32
  end

  @inline(always)
  pub def _clear_fpscr_exceptions()
    asm!("msr fpsr, xzr" : : : : "volatile")
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §8  Tests
# ═══════════════════════════════════════════════════════════════════════

@test
def test_rounding_mode_guard() -> Unit
  let original = get_rounding_mode()
  {
    let _guard = RoundingModeGuard.new(RoundingMode.TowardZero)
    assert get_rounding_mode() == RoundingMode.TowardZero
  }
  ## Guard dropped, mode should be restored
  assert get_rounding_mode() == original
end

@test
def test_ulp_distance() -> Unit
  assert ulp_distance_f32(1.0, 1.0) == 0
  assert ulp_distance_f32(1.0, 1.0 + F32_EPSILON) == 1
  assert ulp_distance_f32(0.0, f32.MIN_POSITIVE) > 0
end

@test
def test_next_after() -> Unit
  let next = next_after_f32(1.0, 2.0)
  assert next > 1.0
  assert ulp_distance_f32(1.0, next) == 1
end

@test
def test_exception_checking() -> Unit
  let (result, flags) = check_exceptions(|| do
    let a: f32 = 1.0
    let b: f32 = 0.0
    a / b
  end)
  assert flags.division_by_zero
end

@test
def test_approx_eq_ulp() -> Unit
  assert approx_eq_ulp_f32(1.0, 1.0, 0)
  let next = next_after_f32(1.0, 2.0)
  assert approx_eq_ulp_f32(1.0, next, 1)
  assert !approx_eq_ulp_f32(1.0, next, 0)
end

end ## module std::float_control
