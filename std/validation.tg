## std::validation — Data Validation Framework
## Provides composable, type-safe validation for web services, form data,
## API payloads, and configuration files.
##
## Design goals:
##   - Derive-based validation from struct annotations
##   - Composable validator combinators
##   - Rich error messages with field paths
##   - Integration with std::web for request validation
##   - Schema generation for OpenAPI/JSON Schema
##   - Zero-allocation for simple validations
##
## Spec: §stdlib.validation

module std::validation

use std::core::{Result, Option, Clone, Display}
use std::collections::{HashMap, Vec}
use std::fmt

# ═══════════════════════════════════════════════════════════════════════
# §1  Validation Errors
# ═══════════════════════════════════════════════════════════════════════

/// A single validation error with its field path.
pub struct ValidationError
  pub field: String        ## e.g. "user.email" or "items[0].quantity"
  pub code: String         ## Machine-readable code, e.g. "required", "min_length"
  pub message: String      ## Human-readable message
  pub params: HashMap[String, String]  ## Additional context (e.g. "min" => "3")
end

impl ValidationError
  pub def new(field: String, code: String, message: String) -> ValidationError
    ValidationError { field: field, code: code, message: message, params: HashMap.new() }
  end

  pub def with_param(mut self, key: String, value: String) -> ValidationError
    self.params.insert(key, value)
    self
  end
end

impl Display for ValidationError
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    f.write_str(self.field.clone() + ": " + self.message.clone())
  end
end

/// Collection of validation errors.
pub struct ValidationErrors
  pub errors: Vec[ValidationError]
end

impl ValidationErrors
  pub def new() -> ValidationErrors
    ValidationErrors { errors: Vec.new() }
  end

  pub def add(&mut self, error: ValidationError)
    self.errors.push(error)
  end

  pub def is_empty(self) -> Bool = self.errors.is_empty()
  pub def len(self) -> usize = self.errors.len()

  pub def merge(&mut self, other: ValidationErrors)
    self.errors.extend(other.errors)
  end

  /// Prefix all field paths with a parent path.
  pub def nest(&mut self, parent: String)
    for error in &mut self.errors do
      if error.field.is_empty() then
        error.field = parent.clone()
      else
        error.field = parent.clone() + "." + error.field.clone()
      end
    end
  end

  /// Get errors for a specific field.
  pub def for_field(self, field: &str) -> Vec[&ValidationError]
    self.errors.iter().filter(|e| e.field == field).collect()
  end

  /// Convert to Result.
  pub def into_result[T](self, value: T) -> Result[T, ValidationErrors]
    if self.is_empty() then Ok(value) else Err(self) end
  end

  /// Convert to JSON-compatible representation.
  pub def to_json(self) -> HashMap[String, Vec[String]]
    var map: HashMap[String, Vec[String]] = HashMap.new()
    for error in &self.errors do
      map.entry(error.field.clone())
        .or_insert_with(|| Vec.new())
        .push(error.message.clone())
    end
    map
  end
end

impl Display for ValidationErrors
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    for (i, error) in self.errors.iter().enumerate() do
      if i > 0 then f.write_str("; ")? end
      error.fmt(f)?
    end
    Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §2  Validate Trait
# ═══════════════════════════════════════════════════════════════════════

/// Trait for types that can validate themselves.
/// Implement this trait directly or derive it with @[derive(Validate)].
pub trait Validate
  def validate(self) -> ValidationErrors
end

/// Validate and return the value or errors.
pub def validated[T: Validate](value: T) -> Result[T, ValidationErrors]
  let errors = value.validate()
  errors.into_result(value)
end

# ═══════════════════════════════════════════════════════════════════════
# §3  Built-in Validators (Composable)
# ═══════════════════════════════════════════════════════════════════════

/// Trait for composable validators.
pub trait Validator[T]
  def check(self, value: &T, field: &str) -> Option[ValidationError]
end

// ─── String Validators ──────────────────────────────────────────────

pub struct Required end
impl Validator[String] for Required
  def check(self, value: &String, field: &str) -> Option[ValidationError]
    if value.is_empty() then
      Some(ValidationError.new(field.to_string(), "required", field.to_string() + " is required"))
    else None end
  end
end

impl Validator[Option[String]] for Required
  def check(self, value: &Option[String], field: &str) -> Option[ValidationError]
    match value
      None => Some(ValidationError.new(field.to_string(), "required", field.to_string() + " is required"))
      Some(s) if s.is_empty() => Some(ValidationError.new(field.to_string(), "required", field.to_string() + " is required"))
      _ => None
    end
  end
end

pub struct MinLength { pub min: usize }
impl Validator[String] for MinLength
  def check(self, value: &String, field: &str) -> Option[ValidationError]
    if value.len() < self.min then
      Some(ValidationError.new(field.to_string(), "min_length",
        field.to_string() + " must be at least " + self.min.to_string() + " characters")
        .with_param("min", self.min.to_string()))
    else None end
  end
end

pub struct MaxLength { pub max: usize }
impl Validator[String] for MaxLength
  def check(self, value: &String, field: &str) -> Option[ValidationError]
    if value.len() > self.max then
      Some(ValidationError.new(field.to_string(), "max_length",
        field.to_string() + " must be at most " + self.max.to_string() + " characters")
        .with_param("max", self.max.to_string()))
    else None end
  end
end

pub struct Pattern { pub regex: String, pub message: String }
impl Validator[String] for Pattern
  def check(self, value: &String, field: &str) -> Option[ValidationError]
    use std::regex::{Regex}
    let re = Regex.new(&self.regex).unwrap()
    if !re.is_match(value) then
      Some(ValidationError.new(field.to_string(), "pattern", self.message.clone()))
    else None end
  end
end

pub struct Email end
impl Validator[String] for Email
  def check(self, value: &String, field: &str) -> Option[ValidationError]
    ## Basic email validation: contains @ and domain part
    if !value.contains('@') || value.starts_with('@') || value.ends_with('@') then
      Some(ValidationError.new(field.to_string(), "email", field.to_string() + " must be a valid email"))
    else
      let parts: Vec[&str] = value.splitn(2, '@').collect()
      if parts.len() != 2 || parts[1].len() < 3 || !parts[1].contains('.') then
        Some(ValidationError.new(field.to_string(), "email", field.to_string() + " must be a valid email"))
      else None end
    end
  end
end

pub struct Url end
impl Validator[String] for Url
  def check(self, value: &String, field: &str) -> Option[ValidationError]
    if !value.starts_with("http://") && !value.starts_with("https://") then
      Some(ValidationError.new(field.to_string(), "url", field.to_string() + " must be a valid URL"))
    else None end
  end
end

// ─── Numeric Validators ─────────────────────────────────────────────

pub struct Min[T] { pub min: T }
impl Validator[i64] for Min[i64]
  def check(self, value: &i64, field: &str) -> Option[ValidationError]
    if *value < self.min then
      Some(ValidationError.new(field.to_string(), "min",
        field.to_string() + " must be at least " + self.min.to_string())
        .with_param("min", self.min.to_string()))
    else None end
  end
end

impl Validator[f64] for Min[f64]
  def check(self, value: &f64, field: &str) -> Option[ValidationError]
    if *value < self.min then
      Some(ValidationError.new(field.to_string(), "min",
        field.to_string() + " must be at least " + self.min.to_string())
        .with_param("min", self.min.to_string()))
    else None end
  end
end

pub struct Max[T] { pub max: T }
impl Validator[i64] for Max[i64]
  def check(self, value: &i64, field: &str) -> Option[ValidationError]
    if *value > self.max then
      Some(ValidationError.new(field.to_string(), "max",
        field.to_string() + " must be at most " + self.max.to_string())
        .with_param("max", self.max.to_string()))
    else None end
  end
end

pub struct Range[T] { pub min: T, pub max: T }
impl Validator[i64] for Range[i64]
  def check(self, value: &i64, field: &str) -> Option[ValidationError]
    if *value < self.min || *value > self.max then
      Some(ValidationError.new(field.to_string(), "range",
        field.to_string() + " must be between " + self.min.to_string() + " and " + self.max.to_string()))
    else None end
  end
end

// ─── Collection Validators ──────────────────────────────────────────

pub struct MinItems { pub min: usize }
impl[T] Validator[Vec[T]] for MinItems
  def check(self, value: &Vec[T], field: &str) -> Option[ValidationError]
    if value.len() < self.min then
      Some(ValidationError.new(field.to_string(), "min_items",
        field.to_string() + " must have at least " + self.min.to_string() + " items"))
    else None end
  end
end

pub struct MaxItems { pub max: usize }
impl[T] Validator[Vec[T]] for MaxItems
  def check(self, value: &Vec[T], field: &str) -> Option[ValidationError]
    if value.len() > self.max then
      Some(ValidationError.new(field.to_string(), "max_items",
        field.to_string() + " must have at most " + self.max.to_string() + " items"))
    else None end
  end
end

pub struct Unique end
impl[T: Eq + std::hash::Hash] Validator[Vec[T]] for Unique
  def check(self, value: &Vec[T], field: &str) -> Option[ValidationError]
    use std::collections::HashSet
    let mut seen = HashSet.new()
    for item in value do
      if !seen.insert(item) then
        return Some(ValidationError.new(field.to_string(), "unique",
          field.to_string() + " must contain unique items"))
      end
    end
    None
  end
end

// ─── Custom Validator ───────────────────────────────────────────────

pub struct Custom[T]
  pub check_fn: fn(&T, &str) -> Option[ValidationError]
end

impl[T] Validator[T] for Custom[T]
  def check(self, value: &T, field: &str) -> Option[ValidationError]
    (self.check_fn)(value, field)
  end
end

// ─── OneOf (enum values) ────────────────────────────────────────────

pub struct OneOf { pub values: Vec[String] }
impl Validator[String] for OneOf
  def check(self, value: &String, field: &str) -> Option[ValidationError]
    if !self.values.contains(value) then
      Some(ValidationError.new(field.to_string(), "one_of",
        field.to_string() + " must be one of: " + self.values.join(", ")))
    else None end
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §4  Validation Builder
# ═══════════════════════════════════════════════════════════════════════

/// Fluent builder for composing validations on a value.
pub struct FieldValidator[T]
  _field: String
  _validators: Vec[Box[dyn Validator[T]]]
end

impl[T] FieldValidator[T]
  pub def new(field: String) -> FieldValidator[T]
    FieldValidator { _field: field, _validators: Vec.new() }
  end

  pub def add(mut self, validator: Box[dyn Validator[T]]) -> FieldValidator[T]
    self._validators.push(validator)
    self
  end

  pub def run(self, value: &T) -> ValidationErrors
    var errors = ValidationErrors.new()
    for v in &self._validators do
      if let Some(err) = v.check(value, &self._field) then
        errors.add(err)
      end
    end
    errors
  end
end

/// Convenience: validate a string field.
pub def string_field(name: &str) -> StringFieldBuilder
  StringFieldBuilder { _field: name.to_string(), _errors: ValidationErrors.new() }
end

pub struct StringFieldBuilder
  _field: String
  _errors: ValidationErrors
end

impl StringFieldBuilder
  pub def required(mut self) -> StringFieldBuilder
    self._add(Box.new(Required {}))
  end

  pub def min_length(mut self, min: usize) -> StringFieldBuilder
    self._add(Box.new(MinLength { min: min }))
  end

  pub def max_length(mut self, max: usize) -> StringFieldBuilder
    self._add(Box.new(MaxLength { max: max }))
  end

  pub def email(mut self) -> StringFieldBuilder
    self._add(Box.new(Email {}))
  end

  pub def url(mut self) -> StringFieldBuilder
    self._add(Box.new(Url {}))
  end

  pub def pattern(mut self, regex: String, msg: String) -> StringFieldBuilder
    self._add(Box.new(Pattern { regex: regex, message: msg }))
  end

  pub def one_of(mut self, values: Vec[String]) -> StringFieldBuilder
    self._add(Box.new(OneOf { values: values }))
  end

  def _add(mut self, v: Box[dyn Validator[String]]) -> StringFieldBuilder
    self._validators.push(v)
    self
  end

  pub _validators: Vec[Box[dyn Validator[String]]]

  pub def validate(self, value: &String) -> ValidationErrors
    var errors = ValidationErrors.new()
    for v in &self._validators do
      if let Some(err) = v.check(value, &self._field) then
        errors.add(err)
      end
    end
    errors
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §5  Derive Support & Annotations
# ═══════════════════════════════════════════════════════════════════════

/// Annotation-based validation. When @[derive(Validate)] is used on a struct,
/// the compiler generates validate() based on field annotations:
///
///   @[derive(Validate)]
///   struct CreateUser
///     @[validate(required, min_length = 3, max_length = 50)]
///     name: String
///
///     @[validate(required, email)]
///     email: String
///
///     @[validate(min = 8, max = 128)]
///     age: i64
///
///     @[validate(min_items = 1, max_items = 10)]
///     tags: Vec[String]
///
///     @[validate(nested)]  ## Validate inner struct recursively
///     address: Address
///   end
///
/// Supported annotations:
///   - required: field must not be empty/None
///   - min_length = N: minimum string length
///   - max_length = N: maximum string length
///   - email: valid email format
///   - url: valid URL format
///   - pattern = "regex": match regex
///   - min = N: minimum numeric value
///   - max = N: maximum numeric value
///   - range = (min, max): numeric range
///   - min_items = N: minimum collection size
///   - max_items = N: maximum collection size
///   - unique: collection items must be unique
///   - one_of = ["a", "b"]: value must be one of listed
///   - nested: validate inner struct
///   - custom = fn_name: call custom validation function

# ═══════════════════════════════════════════════════════════════════════
# §6  Schema Generation
# ═══════════════════════════════════════════════════════════════════════

/// JSON Schema types for OpenAPI integration.
pub enum SchemaType
  String_
  Integer
  Number
  Boolean
  Array(Box[Schema])
  Object(Vec[(String, Schema)])
end

pub struct Schema
  pub ty: SchemaType
  pub required: Bool
  pub description: Option[String]
  pub min_length: Option[usize]
  pub max_length: Option[usize]
  pub minimum: Option[f64]
  pub maximum: Option[f64]
  pub pattern: Option[String]
  pub format: Option[String]      ## "email", "uri", "date-time", etc.
  pub enum_values: Option[Vec[String]]
  pub min_items: Option[usize]
  pub max_items: Option[usize]
  pub unique_items: Option[Bool]
end

impl Schema
  pub def string() -> Schema
    Schema {
      ty: SchemaType.String_, required: false, description: None,
      min_length: None, max_length: None, minimum: None, maximum: None,
      pattern: None, format: None, enum_values: None,
      min_items: None, max_items: None, unique_items: None,
    }
  end

  pub def integer() -> Schema
    Schema {
      ty: SchemaType.Integer, required: false, description: None,
      min_length: None, max_length: None, minimum: None, maximum: None,
      pattern: None, format: None, enum_values: None,
      min_items: None, max_items: None, unique_items: None,
    }
  end
end

/// Trait for types that can generate a validation schema.
pub trait HasSchema
  def schema() -> Schema
end

# ═══════════════════════════════════════════════════════════════════════
# §7  Tests
# ═══════════════════════════════════════════════════════════════════════

@test
def test_required_validator() -> Unit
  let v = Required {}
  assert v.check(&"hello".to_string(), "name").is_none()
  assert v.check(&"".to_string(), "name").is_some()
end

@test
def test_min_length_validator() -> Unit
  let v = MinLength { min: 3 }
  assert v.check(&"abc".to_string(), "name").is_none()
  assert v.check(&"ab".to_string(), "name").is_some()
end

@test
def test_email_validator() -> Unit
  let v = Email {}
  assert v.check(&"user@example.com".to_string(), "email").is_none()
  assert v.check(&"invalid".to_string(), "email").is_some()
  assert v.check(&"@example.com".to_string(), "email").is_some()
end

@test
def test_range_validator() -> Unit
  let v = Range[i64] { min: 1, max: 100 }
  assert v.check(&50, "age").is_none()
  assert v.check(&0, "age").is_some()
  assert v.check(&101, "age").is_some()
end

@test
def test_validation_errors_nesting() -> Unit
  var errors = ValidationErrors.new()
  errors.add(ValidationError.new("name".to_string(), "required", "name is required"))
  errors.nest("user".to_string())
  assert errors.errors[0].field == "user.name"
end

@test
def test_fluent_string_validation() -> Unit
  let validator = string_field("email")
    .required()
    .email()
    .max_length(255)
  let errors = validator.validate(&"not-an-email".to_string())
  assert !errors.is_empty()
end

end ## module std::validation
