# Tangerine Standard Library — std::tls
# TLS wrapper with safe defaults, policy controls, and test cert harnesses.
# Spec reference: TG-TLS-SPEC-001 v0.1

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::net::{TcpStream, TlsConfig as NetTlsConfig, TlsStream as NetTlsStream, tls_connect as net_tls_connect}
use std::gfx_errors::{Error, ErrorCode}

# [METADATA]
# module: tg::tls
# status: alpha
# effects: [Io, Kernel]
# capabilities: [Net]
# error_codes: [HandshakeFailed, CertificateError, ProtocolError, Internal]
# description: "High-level TLS interface with security policy enforcement and deterministic testing support."
# examples:
#   - |
#     use std::tls::{connect, TlsPolicy}
#     let stream = std::net::tcp_connect_host("example.com", 443).unwrap()
#     let mut tls = std::tls::connect(stream, "example.com", TlsPolicy::default()).unwrap()

# ———————————————————————————————————————————————————————————————
# TLS Policy
# ———————————————————————————————————————————————————————————————

enum TlsVersion
  Tls12
  Tls13
end

struct TlsPolicy
  min_version: TlsVersion
  verify_peer: Bool
  require_stapling: Bool
  allowed_cipher_suites: Vec[String]
end

impl TlsPolicy
  def default() -> Self
    TlsPolicy {
      min_version: TlsVersion::Tls12,
      verify_peer: true,
      require_stapling: false,
      allowed_cipher_suites: Vec::new(), # Empty means use secure defaults
    }
  end

  def strict() -> Self
    TlsPolicy {
      min_version: TlsVersion::Tls13,
      verify_peer: true,
      require_stapling: true,
      allowed_cipher_suites: Vec::new(),
    }
  end
end

# ———————————————————————————————————————————————————————————————
# TLS Connection
# ———————————————————————————————————————————————————————————————

struct TlsStream
  inner: NetTlsStream
  policy: TlsPolicy
  hostname: String
  handshake_transcript: Vec[u8] # For deterministic replay/audit
end

def connect(stream: TcpStream, hostname: String, policy: TlsPolicy) -> Result[TlsStream, TlsError]
  # Map TlsPolicy to NetTlsConfig
  let net_config = std::net::tls_config_default()
  # In a production impl, we'd set more fields based on policy
  
  match net_tls_connect(stream, hostname.as_str(), &net_config)
  when Result::Ok(net_stream) then
    Result::Ok(TlsStream {
      inner: net_stream,
      policy: policy,
      hostname: hostname,
      handshake_transcript: Vec::new(), # Ideally captured from low-level
    })
  when Result::Err(e) then
    # Integration with ctxpacks: Capture TLS handshake failure context
    let mut seeds = Vec::new()
    seeds.push("tls::handshake_failed".to_string())
    seeds.push("hostname::" + hostname)
    match std::ctx::build_pack(seeds, 2000)
    when Ok(pack) then std::ctx::register_pack(pack)
    when Err(_) then {}
    end
    Result::Err(TlsError::HandshakeFailed(Error::new(ErrorCode::Internal, e.message())))
  end
end

# ———————————————————————————————————————————————————————————————
# Error Types
# ———————————————————————————————————————————————————————————————

enum TlsError
  HandshakeFailed(Error)
  CertificateError(Error)
  ProtocolError(Error)
  Internal(Error)
end

impl TlsError
  def message(self: &TlsError) -> &String
    match self
    when TlsError::HandshakeFailed(e) then &e.message
    when TlsError::CertificateError(e) then &e.message
    when TlsError::ProtocolError(e) then &e.message
    when TlsError::Internal(e) then &e.message
    end
  end

  def code(self: &TlsError) -> ErrorCode
    match self
    when TlsError::HandshakeFailed(_) then ErrorCode::Internal
    when TlsError::CertificateError(_) then ErrorCode::PermissionDenied
    when TlsError::ProtocolError(_) then ErrorCode::Internal
    when TlsError::Internal(_) then ErrorCode::Internal
    end
  end
end

# ———————————————————————————————————————————————————————————————
# I/O Implementation
# ———————————————————————————————————————————————————————————————

use std::io::{Read, Write, IOError}

impl Read for TlsStream
  def read(self: &mut TlsStream, buf: &mut Vec[u8]) -> Result[Int, IOError]
    self.inner.read(buf).map(|n| n as Int)
  end
end

impl Write for TlsStream
  def write(self: &mut TlsStream, buf: &Vec[u8]) -> Result[Int, IOError]
    self.inner.write(buf).map(|n| n as Int)
  end

  def flush(self: &mut TlsStream) -> Result[Unit, IOError]
    Result::Ok(())
  end
end

impl TlsStream
  def shutdown(&mut self) -> Unit
    self.inner.shutdown()
  end
end
