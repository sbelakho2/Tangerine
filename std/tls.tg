## Tangerine Standard Library — std::tls
## TLS 1.3 Implementation
##
## Provides secure communications:
## - TLS 1.3 handshake protocol
## - Certificate verification
## - Cipher suites (AES-GCM, ChaCha20-Poly1305)
## - Session resumption
## - ALPN negotiation

use std::collections::{Vec, Map, SliceMut}
use std::ffi::{Ptr, CString}
use std::core::{Option, Result}
use std::io::{Read, Write}
use std::net::{TcpStream, SocketAddr, TcpListener}
use std::time::{Instant, Duration}

# ———————————————————————————————————————————————————————————————
# TLS Types and Constants
# ———————————————————————————————————————————————————————————————

type SslPtr = Ptr[u8]
type X509Ptr = Ptr[u8]
type EvpPkeyPtr = Ptr[u8]

pub const TLS_VERSION_1_2: u16 = 0x0303
pub const TLS_VERSION_1_3: u16 = 0x0304

# ———————————————————————————————————————————————————————————————
# Enums
# ———————————————————————————————————————————————————————————————

pub enum TlsVersion
  V1_2
  V1_3
end

pub enum CipherSuite
  AES_128_GCM_SHA256
  AES_256_GCM_SHA384
  CHACHA20_POLY1305_SHA256
  ECDHE_RSA_WITH_AES_128_GCM_SHA256
  ECDHE_RSA_WITH_AES_256_GCM_SHA384
end

pub enum TlsState
  Initial
  HandshakeInProgress
  Connected
  Closing
  Closed
  Error
end

pub enum TlsError
  HandshakeFailed
  CertificateVerifyFailed
  ProtocolVersionMismatch
  CipherSuiteMismatch
  InvalidRecord
  ConnectionClosed
  IoError(String)
  InvalidCertificate
end

# ———————————————————————————————————————————————————————————————
# TLS Configuration
# ———————————————————————————————————————————————————————————————

pub struct TlsConfig
  min_version: TlsVersion
  max_version: TlsVersion
  cipher_suites: Vec[CipherSuite]
  verify_peer: Bool
  verify_hostname: Bool
  use_sni: Bool
  alpn_protocols: Vec[String]
  certificate: Option[Certificate]
  private_key: Option[PrivateKey]
  ca_certs: Vec[Certificate]
end

impl TlsConfig
  pub fn default_client() -> TlsConfig
    let mut suites: Vec[CipherSuite] = Vec::new()
    suites.push(CipherSuite::AES_128_GCM_SHA256)
    suites.push(CipherSuite::AES_256_GCM_SHA384)
    suites.push(CipherSuite::CHACHA20_POLY1305_SHA256)
    
    TlsConfig {
      min_version: TlsVersion::V1_2,
      max_version: TlsVersion::V1_3,
      cipher_suites: suites,
      verify_peer: true,
      verify_hostname: true,
      use_sni: true,
      alpn_protocols: Vec::new(),
      certificate: Option::None,
      private_key: Option::None,
      ca_certs: Vec::new()
    }
  end
  
  pub fn default_server() -> TlsConfig
    let config = TlsConfig::default_client()
    TlsConfig {
      min_version: config.min_version,
      max_version: config.max_version,
      cipher_suites: config.cipher_suites,
      verify_peer: false,
      verify_hostname: false,
      use_sni: true,
      alpn_protocols: Vec::new(),
      certificate: Option::None,
      private_key: Option::None,
      ca_certs: Vec::new()
    }
  end
  
  # Consuming builders: `sink self` MOVES the config into the setter and the
  # setter returns it; `sink cert` / `sink key` / `sink protocols` MOVE the
  # values into the config. No Clone is ever taken of the Certificate /
  # PrivateKey wrappers, their native X509 / EVP_PKEY handles, or the
  # ca_certs vector: a bit-level clone would leave two owning wrappers over
  # the same native handle and the Drop impls would free it twice. The
  # consuming form is the correct ownership model — the config is moved into
  # the connection (TlsClient::new / TlsServer::new take it by value) and no
  # shared-config Clone path exists. If sharing a config across connections
  # is ever needed, the Clone must duplicate the native handles properly
  # (X509_dup / EVP_PKEY_dup, not a bit copy).
  pub fn with_alpn(sink self: TlsConfig, sink protocols: Vec[String]) -> TlsConfig
    self.alpn_protocols = protocols
    self
  end
  
  pub fn with_certificate(sink self: TlsConfig, sink cert: Certificate, sink key: PrivateKey) -> TlsConfig
    self.certificate = Option::Some(cert)
    self.private_key = Option::Some(key)
    self
  end
  
  pub fn with_verify_peer(sink self: TlsConfig, verify: Bool) -> TlsConfig
    self.verify_peer = verify
    self
  end
end

# ———————————————————————————————————————————————————————————————
# Certificate
# ———————————————————————————————————————————————————————————————

pub struct Certificate
  handle: X509Ptr
  der_data: Vec[u8]
end

impl Certificate
  pub fn from_pem(pem: String) -> Result[Certificate, String]
    let mut handle: X509Ptr = Ptr::null()
    let mut der_data: Vec[u8] = Vec::with_capacity(8192)
    
    unsafe "cert from pem" do
      handle = tls_x509_from_pem(pem.as_ptr(), pem.len())
      if handle.is_null() then
        return Result::Err("Failed to parse PEM certificate")
      end
      let der_len = tls_x509_to_der(handle, der_data.as_mut_ptr(), 8192)
      if der_len < 0 then
        # The X509 handle was created above but the Certificate wrapper is
        # never returned, so its Drop cannot cover the handle — free it
        # here or the native X509 leaks.
        tls_x509_free(handle)
        return Result::Err("Failed to serialize certificate to DER")
      end
      if der_len > der_data.capacity() as i32 then
        tls_x509_free(handle)
        return Result::Err("Certificate DER exceeds output buffer capacity")
      end
      der_data.set_len(der_len)
    end
    
    Result::Ok(Certificate { handle: handle, der_data: der_data })
  end
  
  pub fn from_file(path: String) -> Result[Certificate, String]
    let mut pem_data: String = String::new()
    unsafe "cert from file" do
      let mut buf: Vec[u8] = Vec::with_capacity(8192)
      let len = tls_load_file(path.as_ptr(), buf.as_mut_ptr(), 8192)
      if len <= 0 then return Result::Err("Failed to load certificate file") end
      if len > buf.capacity() as i32 then return Result::Err("Certificate file exceeds output buffer capacity") end
      buf.set_len(len)
      pem_data = String::from_utf8(buf).unwrap_or(String::new())
    end
    Certificate::from_pem(&pem_data)
  end
  
  pub fn subject_cn(self: Self) -> String
    let mut buf: Vec[u8] = Vec::with_capacity(256)
    unsafe "cert subject cn" do
      tls_x509_get_subject_cn(self.handle, buf.as_mut_ptr(), 256)
    end
    String::from_cstr(buf.as_ptr())
  end
  
  pub fn is_expired(self: Self) -> Bool
    unsafe "cert is expired" do
      tls_x509_is_expired(self.handle) != 0
    end
  end
  
  pub fn handle(self: Self) -> X509Ptr
    self.handle
  end
end

impl Drop for Certificate
  def drop(inout self: Certificate) -> Unit
    if !self.handle.is_null() then
      unsafe "free x509 cert" do
        tls_x509_free(self.handle)
      end
      self.handle = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Private Key
# ———————————————————————————————————————————————————————————————

pub struct PrivateKey
  handle: EvpPkeyPtr
  der_data: Vec[u8]
end

impl PrivateKey
  pub fn from_pem(pem: String, password: Option[String]) -> Result[PrivateKey, String]
    let mut handle: EvpPkeyPtr = Ptr::null()
    let mut der_data: Vec[u8] = Vec::with_capacity(4096)
    
    unsafe "key from pem" do
      let pass_ptr = match password
        when Option::Some(p) then p.as_ptr()
        when Option::None then Ptr::null()
      end
      handle = tls_pkey_from_pem(pem.as_ptr(), pem.len(), pass_ptr)
      if handle.is_null() then return Result::Err("Failed to parse PEM private key") end
      let der_len = tls_pkey_to_der(handle, der_data.as_mut_ptr(), 4096)
      if der_len < 0 then
        # The EVP_PKEY handle was created above but the PrivateKey wrapper
        # is never returned, so its Drop cannot cover the handle — free it
        # here or the native EVP_PKEY leaks.
        tls_pkey_free(handle)
        return Result::Err("Failed to serialize private key to DER")
      end
      if der_len > der_data.capacity() as i32 then
        tls_pkey_free(handle)
        return Result::Err("Private key DER exceeds output buffer capacity")
      end
      der_data.set_len(der_len)
    end
    
    Result::Ok(PrivateKey { handle: handle, der_data: der_data })
  end
  
  pub fn from_file(path: String, password: Option[String]) -> Result[PrivateKey, String]
    let mut pem_data: String = String::new()
    unsafe "key from file" do
      let mut buf: Vec[u8] = Vec::with_capacity(8192)
      let len = tls_load_file(path.as_ptr(), buf.as_mut_ptr(), 8192)
      if len <= 0 then return Result::Err("Failed to load private key file") end
      if len > buf.capacity() as i32 then return Result::Err("Private key file exceeds output buffer capacity") end
      buf.set_len(len)
      pem_data = String::from_utf8(buf)
    end
    PrivateKey::from_pem(&pem_data, password)
  end
  
  pub fn handle(self: Self) -> EvpPkeyPtr
    self.handle
  end
end

impl Drop for PrivateKey
  def drop(inout self: PrivateKey) -> Unit
    if !self.handle.is_null() then
      unsafe "free pkey" do
        tls_pkey_free(self.handle)
      end
      self.handle = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# TLS Connection
# ———————————————————————————————————————————————————————————————

pub struct TlsConnection
  handle: SslPtr
  stream: TcpStream
  state: TlsState
  negotiated_cipher: Option[CipherSuite]
  negotiated_version: Option[TlsVersion]
  server_name: Option[String]
  alpn_protocol: Option[String]
end

impl TlsConnection
  pub fn connect(stream: TcpStream, config: TlsConfig, hostname: Option[String]) -> Result[TlsConnection, TlsError]
    let mut handle: SslPtr = Ptr::null()
    
    unsafe "tls connect" do
      handle = tls_ssl_new()
      if handle.is_null() then return Result::Err(TlsError::HandshakeFailed) end
      
      tls_ssl_set_min_version(handle, match config.min_version when TlsVersion::V1_2 then 0x0303 when TlsVersion::V1_3 then 0x0304 end)
      tls_ssl_set_max_version(handle, match config.max_version when TlsVersion::V1_2 then 0x0303 when TlsVersion::V1_3 then 0x0304 end)
      
      if config.use_sni then
        match hostname
          when Option::Some(name) then tls_ssl_set_hostname(handle, name.as_ptr())
          when Option::None then
        end
      end
      
      match config.certificate
        when Option::Some(cert) then tls_ssl_set_certificate(handle, cert.handle)
        when Option::None then
      end
      
      match config.private_key
        when Option::Some(key) then tls_ssl_set_private_key(handle, key.handle)
        when Option::None then
      end
      
      tls_ssl_set_verify(handle, config.verify_peer, config.verify_hostname)
      
      let result = tls_ssl_connect(handle, stream.native_handle())
      if result != 0 then
        tls_ssl_free(handle)
        return Result::Err(TlsError::HandshakeFailed)
      end
    end
    
    Result::Ok(TlsConnection {
      handle: handle,
      stream: stream,
      state: TlsState::Connected,
      negotiated_cipher: Option::None,
      negotiated_version: Option::None,
      server_name: hostname.map(|h| h.clone()),
      alpn_protocol: Option::None
    })
  end
  
  pub fn accept(stream: TcpStream, config: TlsConfig) -> Result[TlsConnection, TlsError]
    let mut handle: SslPtr = Ptr::null()
    
    unsafe "tls accept" do
      handle = tls_ssl_new()
      if handle.is_null() then return Result::Err(TlsError::HandshakeFailed) end
      
      match config.certificate
        when Option::Some(cert) then tls_ssl_set_certificate(handle, cert.handle)
        when Option::None then
          tls_ssl_free(handle)
          return Result::Err(TlsError::HandshakeFailed)
      end
      
      match config.private_key
        when Option::Some(key) then tls_ssl_set_private_key(handle, key.handle)
        when Option::None then
          tls_ssl_free(handle)
          return Result::Err(TlsError::HandshakeFailed)
      end
      
      let result = tls_ssl_accept(handle, stream.native_handle())
      if result != 0 then
        tls_ssl_free(handle)
        return Result::Err(TlsError::HandshakeFailed)
      end
    end
    
    Result::Ok(TlsConnection {
      handle: handle,
      stream: stream,
      state: TlsState::Connected,
      negotiated_cipher: Option::None,
      negotiated_version: Option::None,
      server_name: Option::None,
      alpn_protocol: Option::None
    })
  end
  
  pub fn is_connected(self: Self) -> Bool
    match self.state
      when TlsState::Connected then true
      else false
    end
  end
end

impl Read for TlsConnection
  pub def read(inout self: Self, buf: SliceMut[u8]) -> Result[usize, TlsError]
    if !self.is_connected() then return Result::Err(TlsError::ConnectionClosed) end
    unsafe "tls read" do
      # buf.len is the writable extent — the SSL read count is the
      # view's len, never a zero-length request after a clear.
      let result = tls_ssl_read(self.handle, buf.ptr, buf.len as usize)
      if result < 0 then return Result::Err(TlsError::ConnectionClosed) end
      if (result as UInt) > buf.len then return Result::Err(TlsError::InvalidRecord) end
      Result::Ok(result as usize)
    end
  end
end

impl Write for TlsConnection
  pub def write(inout self: Self, buf: [u8]) -> Result[usize, TlsError]
    if !self.is_connected() then return Result::Err(TlsError::ConnectionClosed) end
    unsafe "tls write" do
      let result = tls_ssl_write(self.handle, buf.as_ptr(), buf.len())
      if result < 0 then return Result::Err(TlsError::ConnectionClosed) end
      Result::Ok(result as usize)
    end
  end
  
  pub def flush(inout self: Self) -> Result[Unit, TlsError]
    Result::Ok(())
  end
end

impl TlsConnection
  pub def close(inout self: Self) -> Result[Unit, TlsError]
    if !self.is_connected() then return Result::Ok(()) end
    unsafe "tls close" do
      tls_ssl_shutdown(self.handle)
    end
    self.state = TlsState::Closed
    Result::Ok(())
  end
end

impl Drop for TlsConnection
  def drop(inout self: TlsConnection) -> Unit
    if !self.handle.is_null() then
      unsafe "free tls ssl" do
        tls_ssl_free(self.handle)
      end
      self.handle = Ptr::null()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# TLS Client
# ———————————————————————————————————————————————————————————————

pub struct TlsClient
  config: TlsConfig
end

impl TlsClient
  pub fn new(config: TlsConfig) -> TlsClient
    TlsClient { config: config }
  end
  
  pub fn default() -> TlsClient
    TlsClient::new(TlsConfig::default_client())
  end
  
  pub fn with_alpn(sink protocols: Vec[String]) -> TlsClient
    TlsClient::new(TlsConfig::default_client().with_alpn(protocols))
  end
  
  pub def connect(inout self: Self, host: String, port: u16) -> Result[TlsConnection, TlsError]
    let addr = format!("{}:{}", host, port)
    let stream = match TcpStream::connect(&addr)
      when Result::Ok(s) then s
      when Result::Err(e) then return Result::Err(TlsError::IoError(e))
    end
    TlsConnection::connect(stream, &self.config, Option::Some(host))
  end
end

# ———————————————————————————————————————————————————————————————
# TLS Server
# ———————————————————————————————————————————————————————————————

pub struct TlsServer
  config: TlsConfig
  listener: Option[TcpListener]
end

impl TlsServer
  pub fn new(config: TlsConfig) -> TlsServer
    TlsServer { config: config, listener: Option::None }
  end
  
  pub fn with_certificate(sink cert: Certificate, sink key: PrivateKey) -> TlsServer
    TlsServer::new(TlsConfig::default_server().with_certificate(cert, key))
  end
  
  pub def bind(inout self: Self, addr: String, port: u16) -> Result[Unit, String]
    let bind_addr = format!("{}:{}", addr, port)
    match TcpListener::bind(&bind_addr)
      when Result::Ok(l) then
        self.listener = Option::Some(l)
        Result::Ok(())
      when Result::Err(e) then Result::Err(e)
    end
  end
  
  pub def accept(inout self: Self) -> Result[TlsConnection, TlsError]
    match self.listener
      when Option::Some(listener) then
        match listener.accept()
          when Result::Ok((stream, _addr)) then TlsConnection::accept(stream, &self.config)
          when Result::Err(e) then Result::Err(TlsError::IoError(e))
        end
      when Option::None then Result::Err(TlsError::IoError("Server not bound".to_string()))
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Native TLS FFI declarations
# ———————————————————————————————————————————————————————————————

extern "C" do
  def tls_ssl_new() -> SslPtr
  def tls_ssl_free(ssl: SslPtr) -> Unit
  def tls_ssl_set_min_version(ssl: SslPtr, version: u16) -> Unit
  def tls_ssl_set_max_version(ssl: SslPtr, version: u16) -> Unit
  def tls_ssl_set_hostname(ssl: SslPtr, hostname: Ptr[u8]) -> Unit
  def tls_ssl_set_certificate(ssl: SslPtr, cert: X509Ptr) -> Unit
  def tls_ssl_set_private_key(ssl: SslPtr, key: EvpPkeyPtr) -> Unit
  def tls_ssl_set_verify(ssl: SslPtr, verify_peer: Bool, verify_hostname: Bool) -> Unit
  def tls_ssl_connect(ssl: SslPtr, socket: i32) -> i32
  def tls_ssl_accept(ssl: SslPtr, socket: i32) -> i32
  def tls_ssl_read(ssl: SslPtr, buf: PtrMut[u8], len: usize) -> i32
  def tls_ssl_write(ssl: SslPtr, buf: Ptr[u8], len: usize) -> i32
  def tls_ssl_shutdown(ssl: SslPtr) -> i32
  
  def tls_x509_from_pem(pem: Ptr[u8], len: usize) -> X509Ptr
  def tls_x509_free(cert: X509Ptr) -> Unit
  def tls_x509_to_der(cert: X509Ptr, buf: PtrMut[u8], max_len: usize) -> i32
  def tls_x509_get_subject_cn(cert: X509Ptr, buf: PtrMut[u8], max_len: usize) -> Unit
  def tls_x509_is_expired(cert: X509Ptr) -> i32
  
  def tls_pkey_from_pem(pem: Ptr[u8], len: usize, password: Ptr[u8]) -> EvpPkeyPtr
  def tls_pkey_free(key: EvpPkeyPtr) -> Unit
  def tls_pkey_to_der(key: EvpPkeyPtr, buf: PtrMut[u8], max_len: usize) -> i32
  
  def tls_load_file(path: Ptr[u8], buf: PtrMut[u8], max_len: usize) -> i32
end