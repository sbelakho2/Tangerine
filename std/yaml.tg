# std::yaml — YAML 1.2 parser and emitter
# Supports YAML 1.2 Core Schema: maps, sequences, scalars, anchors/aliases.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec, Float}
use std::collections::{Map}
use std::fmt

# ─── Value ───────────────────────────────────────────────────────────

enum Value
  Null
  Bool(Bool)
  Int(Int)
  Float(Float)
  String(String)
  Sequence(Vec[Value])
  Mapping(Vec[(String, Value)])
end

impl Value
  def is_null(self: &Value) -> Bool
    match self
    when Value::Null then true
    else false
    end
  end

  def as_bool(self: &Value) -> Option[Bool]
    match self
    when Value::Bool(b) then Option::Some(b)
    else Option::None
    end
  end

  def as_int(self: &Value) -> Option[Int]
    match self
    when Value::Int(i) then Option::Some(i)
    else Option::None
    end
  end

  def as_float(self: &Value) -> Option[Float]
    match self
    when Value::Float(f) then Option::Some(f)
    when Value::Int(i) then Option::Some(i as Float)
    else Option::None
    end
  end

  def as_str(self: &Value) -> Option[String]
    match self
    when Value::String(s) then Option::Some(s.clone())
    else Option::None
    end
  end

  def as_sequence(self: &Value) -> Option[Vec[Value]]
    match self
    when Value::Sequence(seq) then Option::Some(seq.clone())
    else Option::None
    end
  end

  def as_mapping(self: &Value) -> Option[Vec[(String, Value)]]
    match self
    when Value::Mapping(map) then Option::Some(map.clone())
    else Option::None
    end
  end

  def get(self: &Value, key: &str) -> Option[Value]
    match self
    when Value::Mapping(entries) then
      for entry in entries do
        let (k, v) = entry
        if k.as_str() == key then return Option::Some(v.clone()) end
      end
      Option::None
    else Option::None
    end
  end

  def at(self: &Value, index: Int) -> Option[Value]
    match self
    when Value::Sequence(seq) then
      if index >= 0 && (index as UInt) < seq.len() then
        Option::Some(seq.get(index as UInt).clone())
      else
        Option::None
      end
    else Option::None
    end
  end
end

# ─── Error ───────────────────────────────────────────────────────────

enum YamlError
  ParseError(String, Int, Int)
  UnexpectedToken(String, Int)
  DuplicateAnchor(String, Int)
  UnknownAlias(String, Int)
  InvalidScalar(String, Int)
  IndentError(Int)
  IoError(String)
end

def yaml_error_message(e: &YamlError) -> String
  match e
  when YamlError::ParseError(msg, line, col) then
    "YAML error at line " + (line as Int).to_string() + ":" + (col as Int).to_string() + ": " + msg
  when YamlError::UnexpectedToken(desc, line) then
    "YAML unexpected token at line " + (line as Int).to_string() + ": " + desc
  when YamlError::DuplicateAnchor(name, line) then
    "YAML duplicate anchor &" + name + " at line " + (line as Int).to_string()
  when YamlError::UnknownAlias(name, line) then
    "YAML unknown alias *" + name + " at line " + (line as Int).to_string()
  when YamlError::InvalidScalar(val, line) then
    "YAML invalid scalar '" + val + "' at line " + (line as Int).to_string()
  when YamlError::IndentError(line) then
    "YAML indentation error at line " + (line as Int).to_string()
  when YamlError::IoError(msg) then
    "YAML I/O error: " + msg
  end
end

# ─── Parser ──────────────────────────────────────────────────────────

struct Parser
  input: String
  pos: Int
  line: Int
  col: Int
  anchors: Map[String, Value]
end

def parser_new(input: String) -> Parser
  Parser {
    input: input,
    pos: 0,
    line: 1,
    col: 1,
    anchors: Map::new()
  }
end

impl Parser
  def parse(self: &mut Parser) -> Result[Value, YamlError]
    self._skip_whitespace_and_comments()
    if self._peek_str("---") then
      self._advance(3)
      self._skip_to_eol()
    end
    let value = self._parse_value(0)?
    self._skip_whitespace_and_comments()
    if self._peek_str("...") then
      self._advance(3)
    end
    Result::Ok(value)
  end

  def parse_all(self: &mut Parser) -> Result[Vec[Value], YamlError]
    let mut docs = Vec::new()
    loop
      self._skip_whitespace_and_comments()
      if self._eof() then break end
      if self._peek_str("---") then
        self._advance(3)
        self._skip_to_eol()
      end
      let doc = self._parse_value(0)?
      docs.push(doc)
      self._skip_whitespace_and_comments()
      if self._peek_str("...") then
        self._advance(3)
        self._skip_to_eol()
      end
    end
    Result::Ok(docs)
  end

  def _parse_value(self: &mut Parser, min_indent: Int) -> Result[Value, YamlError]
    self._skip_whitespace_and_comments()
    if self._eof() then return Result::Ok(Value::Null) end

    let mut anchor_name: Option[String] = Option::None
    if self._peek() == '&' then
      self._advance(1)
      anchor_name = Option::Some(self._read_word())
      self._skip_inline_space()
    end

    if self._peek() == '*' then
      self._advance(1)
      let alias_name = self._read_word()
      match self.anchors.get(&alias_name)
      when Option::Some(v) then return Result::Ok(v.clone())
      when Option::None then return Result::Err(YamlError::UnknownAlias(alias_name, self.line))
      end
    end

    let value = if self._peek() == '-' && self._peek_offset(1) == ' ' then
      self._parse_sequence(self.col - 1)?
    elsif self._peek() == '[' then
      self._parse_flow_sequence()?
    elsif self._peek() == '{' then
      self._parse_flow_mapping()?
    elsif self._peek() == '"' then
      Value::String(self._parse_double_quoted()?)
    elsif self._peek() == '\'' then
      Value::String(self._parse_single_quoted()?)
    elsif self._peek() == '|' || self._peek() == '>' then
      Value::String(self._parse_block_scalar()?)
    else
      let saved_pos = self.pos
      let saved_line = self.line
      let saved_col = self.col
      let word = self._read_until_colon_or_eol()
      if !self._eof() && self._peek() == ':' && (self._peek_offset(1) == ' ' || self._peek_offset(1) == '\n' || self._eof_offset(1)) then
        self.pos = saved_pos
        self.line = saved_line
        self.col = saved_col
        self._parse_mapping(min_indent)?
      else
        self.pos = saved_pos
        self.line = saved_line
        self.col = saved_col
        self._parse_plain_scalar()?
      end
    end

    match anchor_name
    when Option::Some(name) then
      self.anchors.insert(name, value.clone())
    when Option::None then ()
    end

    Result::Ok(value)
  end

  def _parse_mapping(self: &mut Parser, min_indent: Int) -> Result[Value, YamlError]
    let mut entries = Vec::new()
    let map_indent = self.col - 1

    loop
      self._skip_whitespace_and_comments()
      if self._eof() then break end
      let current_indent = self.col - 1
      if current_indent < map_indent then break end
      if current_indent != map_indent then break end

      let key = if self._peek() == '"' then
        self._parse_double_quoted()?
      elsif self._peek() == '\'' then
        self._parse_single_quoted()?
      else
        self._read_until(':')
      end

      if self._eof() || self._peek() != ':' then
        return Result::Err(YamlError::UnexpectedToken("expected ':'".to_string(), self.line))
      end
      self._advance(1)
      self._skip_inline_space()

      let value = if self._peek() == '\n' || self._eof() then
        self._skip_to_eol()
        self._skip_whitespace_and_comments()
        if !self._eof() && (self.col - 1) > map_indent then
          self._parse_value(map_indent + 1)?
        else
          Value::Null
        end
      else
        self._parse_value(map_indent + 1)?
      end

      entries.push((key, value))
    end

    Result::Ok(Value::Mapping(entries))
  end

  def _parse_sequence(self: &mut Parser, min_indent: Int) -> Result[Value, YamlError]
    let mut items = Vec::new()
    let seq_indent = self.col - 1

    loop
      self._skip_whitespace_and_comments()
      if self._eof() then break end
      let current_indent = self.col - 1
      if current_indent != seq_indent then break end
      if self._peek() != '-' || self._peek_offset(1) != ' ' then break end

      self._advance(2)
      let item = self._parse_value(seq_indent + 2)?
      items.push(item)
    end

    Result::Ok(Value::Sequence(items))
  end

  def _parse_flow_sequence(self: &mut Parser) -> Result[Value, YamlError]
    self._advance(1)
    let mut items = Vec::new()
    self._skip_whitespace_and_comments()

    if !self._eof() && self._peek() != ']' then
      loop
        self._skip_whitespace_and_comments()
        let item = self._parse_flow_value()?
        items.push(item)
        self._skip_whitespace_and_comments()
        if self._eof() || self._peek() == ']' then break end
        if self._peek() == ',' then self._advance(1) end
      end
    end

    if self._eof() || self._peek() != ']' then
      return Result::Err(YamlError::UnexpectedToken("expected ']'".to_string(), self.line))
    end
    self._advance(1)
    Result::Ok(Value::Sequence(items))
  end

  def _parse_flow_mapping(self: &mut Parser) -> Result[Value, YamlError]
    self._advance(1)
    let mut entries = Vec::new()
    self._skip_whitespace_and_comments()

    if !self._eof() && self._peek() != '}' then
      loop
        self._skip_whitespace_and_comments()
        let key = if self._peek() == '"' then
          self._parse_double_quoted()?
        elsif self._peek() == '\'' then
          self._parse_single_quoted()?
        else
          self._read_until_any(":,}")
        end
        self._skip_whitespace_and_comments()
        if self._eof() || self._peek() != ':' then
          return Result::Err(YamlError::UnexpectedToken("expected ':'".to_string(), self.line))
        end
        self._advance(1)
        self._skip_inline_space()
        let value = self._parse_flow_value()?
        entries.push((key, value))
        self._skip_whitespace_and_comments()
        if self._eof() || self._peek() == '}' then break end
        if self._peek() == ',' then self._advance(1) end
      end
    end

    if self._eof() || self._peek() != '}' then
      return Result::Err(YamlError::UnexpectedToken("expected '}'".to_string(), self.line))
    end
    self._advance(1)
    Result::Ok(Value::Mapping(entries))
  end

  def _parse_flow_value(self: &mut Parser) -> Result[Value, YamlError]
    self._skip_whitespace_and_comments()
    if self._peek() == '[' then return self._parse_flow_sequence() end
    if self._peek() == '{' then return self._parse_flow_mapping() end
    if self._peek() == '"' then return Result::Ok(Value::String(self._parse_double_quoted()?)) end
    if self._peek() == '\'' then return Result::Ok(Value::String(self._parse_single_quoted()?)) end
    let s = self._read_until_any(",]}\n")
    Result::Ok(_resolve_scalar(s.trim()))
  end

  def _parse_double_quoted(self: &mut Parser) -> Result[String, YamlError]
    self._advance(1)
    let mut result = String::new()
    while !self._eof() do
      let ch = self._peek()
      self._advance(1)
      if ch == '"' then return Result::Ok(result) end
      if ch == '\\' then
        if self._eof() then break end
        let esc = self._peek()
        self._advance(1)
        match esc
        when 'n' then result.push('\n')
        when 't' then result.push('\t')
        when 'r' then result.push('\r')
        when '\\' then result.push('\\')
        when '"' then result.push('"')
        when '/' then result.push('/')
        when '0' then result.push('\0')
        else result.push(esc)
        end
      else
        result.push(ch)
      end
    end
    Result::Err(YamlError::ParseError("unterminated double-quoted string".to_string(), self.line, self.col))
  end

  def _parse_single_quoted(self: &mut Parser) -> Result[String, YamlError]
    self._advance(1)
    let mut result = String::new()
    while !self._eof() do
      let ch = self._peek()
      self._advance(1)
      if ch == '\'' then
        if !self._eof() && self._peek() == '\'' then
          result.push('\'')
          self._advance(1)
        else
          return Result::Ok(result)
        end
      else
        result.push(ch)
      end
    end
    Result::Err(YamlError::ParseError("unterminated single-quoted string".to_string(), self.line, self.col))
  end

  def _parse_block_scalar(self: &mut Parser) -> Result[String, YamlError]
    let style = self._peek()
    self._advance(1)
    let chomp = if !self._eof() && self._peek() == '-' then
      self._advance(1)
      '-'
    elsif !self._eof() && self._peek() == '+' then
      self._advance(1)
      '+'
    else
      ' '
    end
    self._skip_to_eol()

    self._skip_empty_lines()
    let block_indent = self.col - 1
    if block_indent == 0 then return Result::Ok("".to_string()) end

    let mut lines = Vec::new()
    loop
      if self._eof() then break end
      let current_indent = self._count_leading_spaces()
      if current_indent < block_indent && !self._is_empty_line() then break end
      let line_content = self._read_line()
      if current_indent >= block_indent then
        lines.push(line_content.slice(block_indent as UInt, line_content.len()))
      else
        lines.push("".to_string())
      end
    end

    let joiner = if style == '|' then "\n" else " " end
    let mut result = lines.join(joiner)

    match chomp
    when '-' then result = result.trim()
    when '+' then ()
    else
      result = result.trim()
      result = result + "\n"
    end

    Result::Ok(result)
  end

  def _parse_plain_scalar(self: &mut Parser) -> Result[Value, YamlError]
    let s = self._read_until_any("\n#:")
    Result::Ok(_resolve_scalar(s.trim()))
  end

  def _eof(self: &Parser) -> Bool
    self.pos >= self.input.len() as Int
  end

  def _eof_offset(self: &Parser, offset: Int) -> Bool
    self.pos + offset >= self.input.len() as Int
  end

  def _peek(self: &Parser) -> Char
    if self._eof() then '\0' else self.input.char_at(self.pos as UInt) end
  end

  def _peek_offset(self: &Parser, n: Int) -> Char
    let idx = self.pos + n
    if idx >= self.input.len() as Int || idx < 0 then '\0'
    else self.input.char_at(idx as UInt)
    end
  end

  def _peek_str(self: &Parser, s: &str) -> Bool
    let mut i = 0
    while i < s.len() do
      if self._eof_offset(i as Int) then return false end
      if self.input.char_at((self.pos + i as Int) as UInt) != s.char_at(i as UInt) then return false end
      i = i + 1
    end
    true
  end

  def _advance(self: &mut Parser, n: Int) -> Unit
    let mut i = 0
    while i < n do
      if !self._eof() then
        if self.input.char_at(self.pos as UInt) == '\n' then
          self.line = self.line + 1
          self.col = 1
        else
          self.col = self.col + 1
        end
        self.pos = self.pos + 1
      end
      i = i + 1
    end
  end

  def _skip_whitespace_and_comments(self: &mut Parser) -> Unit
    while !self._eof() do
      let ch = self._peek()
      if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' then
        self._advance(1)
      elsif ch == '#' then
        self._skip_to_eol()
      else
        break
      end
    end
  end

  def _skip_inline_space(self: &mut Parser) -> Unit
    while !self._eof() && (self._peek() == ' ' || self._peek() == '\t') do
      self._advance(1)
    end
  end

  def _skip_to_eol(self: &mut Parser) -> Unit
    while !self._eof() && self._peek() != '\n' do
      self._advance(1)
    end
    if !self._eof() then self._advance(1) end
  end

  def _skip_empty_lines(self: &mut Parser) -> Unit
    while !self._eof() && self._is_empty_line() do
      self._skip_to_eol()
    end
  end

  def _is_empty_line(self: &Parser) -> Bool
    let mut i = self.pos
    while i < self.input.len() as Int do
      let ch = self.input.char_at(i as UInt)
      if ch == '\n' then return true end
      if ch != ' ' && ch != '\t' && ch != '\r' then return false end
      i = i + 1
    end
    true
  end

  def _count_leading_spaces(self: &Parser) -> Int
    let mut count = 0
    let mut i = self.pos
    while i < self.input.len() as Int && self.input.char_at(i as UInt) == ' ' do
      count = count + 1
      i = i + 1
    end
    count
  end

  def _read_word(self: &mut Parser) -> String
    let mut result = String::new()
    while !self._eof() do
      let ch = self._peek()
      if ch == ' ' || ch == '\t' || ch == '\n' || ch == ':' || ch == ',' || ch == ']' || ch == '}' then break end
      result.push(ch)
      self._advance(1)
    end
    result
  end

  def _read_line(self: &mut Parser) -> String
    let mut result = String::new()
    while !self._eof() && self._peek() != '\n' do
      result.push(self._peek())
      self._advance(1)
    end
    if !self._eof() then self._advance(1) end
    result
  end

  def _read_until(self: &mut Parser, stop: Char) -> String
    let mut result = String::new()
    while !self._eof() && self._peek() != stop do
      result.push(self._peek())
      self._advance(1)
    end
    result.trim()
  end

  def _read_until_colon_or_eol(self: &mut Parser) -> String
    let mut result = String::new()
    while !self._eof() && self._peek() != ':' && self._peek() != '\n' do
      result.push(self._peek())
      self._advance(1)
    end
    result
  end

  def _read_until_any(self: &mut Parser, stops: &str) -> String
    let mut result = String::new()
    while !self._eof() do
      let ch = self._peek()
      let mut found = false
      let mut i = 0
      while i < stops.len() do
        if ch == stops.char_at(i as UInt) then
          found = true
          break
        end
        i = i + 1
      end
      if found then break end
      result.push(ch)
      self._advance(1)
    end
    result
  end
end

# ─── Scalar resolution (YAML 1.2 Core Schema) ───────────────────────

def _resolve_scalar(s: String) -> Value
  if s.len() == 0 || s == "null" || s == "Null" || s == "NULL" || s == "~" then
    return Value::Null
  end
  if s == "true" || s == "True" || s == "TRUE" then return Value::Bool(true) end
  if s == "false" || s == "False" || s == "FALSE" then return Value::Bool(false) end

  match Int::parse(&s)
  when Result::Ok(i) then return Value::Int(i)
  when Result::Err(_) then ()
  end

  match Float::parse(&s)
  when Result::Ok(f) then return Value::Float(f)
  when Result::Err(_) then ()
  end

  if s == ".inf" || s == ".Inf" || s == ".INF" then return Value::Float(1.0 / 0.0) end
  if s == "-.inf" || s == "-.Inf" || s == "-.INF" then return Value::Float(-1.0 / 0.0) end
  if s == ".nan" || s == ".NaN" || s == ".NAN" then return Value::Float(0.0 / 0.0) end

  Value::String(s)
end

# ─── Emitter ─────────────────────────────────────────────────────────

struct EmitConfig
  indent: Int
  flow_level: Int
  sort_keys: Bool
end

def emit_config_default() -> EmitConfig
  EmitConfig { indent: 2, flow_level: -1, sort_keys: false }
end

def yaml_emit(value: &Value) -> String
  emit_with_config(value, emit_config_default())
end

def emit_with_config(value: &Value, config: EmitConfig) -> String
  _emit_value(value, 0, &config)
end

def _emit_value(value: &Value, depth: Int, config: &EmitConfig) -> String
  if config.flow_level >= 0 && depth >= config.flow_level then
    return _emit_flow(value)
  end

  match value
  when Value::Null then "null".to_string()
  when Value::Bool(b) then if b then "true".to_string() else "false".to_string() end
  when Value::Int(i) then i.to_string()
  when Value::Float(f) then
    if f != f then ".nan".to_string()
    elsif f == 1.0 / 0.0 then ".inf".to_string()
    elsif f == -1.0 / 0.0 then "-.inf".to_string()
    else f.to_string()
    end
  when Value::String(s) then _emit_string(s)
  when Value::Sequence(items) then
    if items.len() == 0 then return "[]".to_string() end
    let mut result = String::new()
    let indent_str = _repeat(" ", config.indent * (depth + 1))
    let mut i = 0
    while i < items.len() do
      if i > 0 then result = result + "\n" end
      result = result + indent_str.clone() + "- "
      let item_str = _emit_value(&items.get(i), depth + 1, config)
      result = result + item_str
      i = i + 1
    end
    result
  when Value::Mapping(entries) then
    if entries.len() == 0 then return "{}".to_string() end
    let mut result = String::new()
    let indent_str = _repeat(" ", config.indent * (depth + 1))
    let mut i = 0
    while i < entries.len() do
      if i > 0 then result = result + "\n" end
      let entry = entries.get(i)
      let key = entry.0
      let val = entry.1
      result = result + indent_str.clone() + _emit_string(&key) + ":"
      match val
      when Value::Mapping(_) | Value::Sequence(_) then
        result = result + "\n" + _emit_value(&val, depth + 1, config)
      else
        result = result + " " + _emit_value(&val, depth + 1, config)
      end
      i = i + 1
    end
    result
  end
end

def _emit_flow(value: &Value) -> String
  match value
  when Value::Null then "null".to_string()
  when Value::Bool(b) then if b then "true".to_string() else "false".to_string() end
  when Value::Int(i) then i.to_string()
  when Value::Float(f) then f.to_string()
  when Value::String(s) then _emit_string(s)
  when Value::Sequence(items) then
    let mut parts = Vec::new()
    let mut i = 0
    while i < items.len() do
      parts.push(_emit_flow(&items.get(i)))
      i = i + 1
    end
    "[".to_string() + parts.join(", ") + "]"
  when Value::Mapping(entries) then
    let mut parts = Vec::new()
    let mut i = 0
    while i < entries.len() do
      let entry = entries.get(i)
      parts.push(_emit_string(&entry.0) + ": " + _emit_flow(&entry.1))
      i = i + 1
    end
    "{".to_string() + parts.join(", ") + "}"
  end
end

def _emit_string(s: &String) -> String
  let needs_quote = s.len() == 0
    || s.contains(':') || s.contains('#') || s.contains('[')
    || s.contains(']') || s.contains('{') || s.contains('}')
    || s.contains(',') || s.contains('&') || s.contains('*')
    || s.contains('!') || s.contains('|') || s.contains('>')
    || s.contains('\'') || s.contains('"') || s.contains('%')
    || s.contains('@') || s.contains('`')
    || s.starts_with("- ") || s.starts_with("? ")
    || s == "true" || s == "false" || s == "null"
    || s.contains('\n')

  if !needs_quote then return s.clone() end

  let mut result = "\"".to_string()
  for ch in s.chars() do
    match ch
    when '"' then result = result + "\\\""
    when '\\' then result = result + "\\\\"
    when '\n' then result = result + "\\n"
    when '\t' then result = result + "\\t"
    when '\r' then result = result + "\\r"
    else result.push(ch)
    end
  end
  result + "\""
end

def _repeat(s: &str, n: Int) -> String
  let mut result = String::new()
  let mut i = 0
  while i < n do
    result = result + s
    i = i + 1
  end
  result
end

# ─── Convenience functions ───────────────────────────────────────────

def yaml_parse(input: &str) -> Result[Value, YamlError]
  let mut parser = parser_new(input.to_string())
  parser.parse()
end

def yaml_parse_all(input: &str) -> Result[Vec[Value], YamlError]
  let mut parser = parser_new(input.to_string())
  parser.parse_all()
end

def yaml_to_string(value: &Value) -> String
  yaml_emit(value)
end