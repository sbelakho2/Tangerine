# Tangerine Standard Library — std::hash_tests
# Property-based tests for hash functions

use std::test::{assert_eq, assert_true, TestCase, TestSuite, run_all_tests}
use std::hash::{hash, Hash, SipHasher}
use std::collections::{Map, Set}

# ═══════════════════════════════════════════════════════════════
# Property: Determinism
# ═══════════════════════════════════════════════════════════════
# The same input should always produce the same output.

def test_determinism_string() -> Unit
  let input = "hello world"
  let h1 = hash(input.clone())
  let h2 = hash(input.clone())
  assert_eq(h1, h2, "hash should be deterministic for strings")
end

def test_determinism_int() -> Unit
  let input = 42
  let h1 = hash(input)
  let h2 = hash(input)
  assert_eq(h1, h2, "hash should be deterministic for integers")
end

def test_determinism_vec() -> Unit
  let input = Vec::from([1, 2, 3, 4, 5])
  let h1 = hash(input.clone())
  let h2 = hash(input.clone())
  assert_eq(h1, h2, "hash should be deterministic for vectors")
end

# ═══════════════════════════════════════════════════════════════
# Property: Uniform Distribution
# ═══════════════════════════════════════════════════════════════
# Hash values should be uniformly distributed across the output space.

def test_distribution() -> Unit
  mut buckets: Map[u64, Int] = Map::new()
  let num_samples = 10000
  let num_buckets = 100
  
  mut i = 0
  while i < num_samples do
    let h = hash(i)
    let bucket = h % num_buckets as u64
    match buckets.get(&bucket)
    when Option::Some(count) then
      buckets.insert(bucket, count + 1)
    when Option::None then
      buckets.insert(bucket, 1)
    end
    i = i + 1
  end
  
  # Each bucket should have roughly num_samples / num_buckets entries
  let expected = num_samples / num_buckets
  let tolerance = expected / 2  # Allow 50% variance
  
  for (bucket, count) in buckets.entries() do
    let diff = if count > expected then count - expected else expected - count end
    assert_true(diff < tolerance, 
      "bucket " + bucket.to_string() + " has " + count.to_string() + 
      " entries, expected ~" + expected.to_string())
  end
end

# ═══════════════════════════════════════════════════════════════
# Property: Avalanche Effect
# ═══════════════════════════════════════════════════════════════
# Small changes in input should cause large changes in output.

def count_bit_diff(a: u64, b: u64) -> Int
  let xor = a ^ b
  mut count = 0
  mut val = xor
  while val != 0 do
    count = count + (val & 1) as Int
    val = val >> 1
  end
  count
end

def test_avalanche_strings() -> Unit
  let inputs = [
    ("hello", "hello!"),
    ("test", "Test"),
    ("abc", "abd"),
    ("12345", "12346"),
    ("", " "),
    ("a", "b")
  ]
  
  for (a, b) in inputs do
    let ha = hash(a.to_string())
    let hb = hash(b.to_string())
    let bit_diff = count_bit_diff(ha, hb)
    # At least 25% of bits should differ (16 bits for u64)
    assert_true(bit_diff >= 16, 
      "avalanche: '" + a + "' vs '" + b + "' only differs by " + 
      bit_diff.to_string() + " bits")
  end
end

def test_avalanche_ints() -> Unit
  mut i = 0
  while i < 100 do
    let h1 = hash(i)
    let h2 = hash(i + 1)
    let bit_diff = count_bit_diff(h1, h2)
    assert_true(bit_diff >= 16, 
      "avalanche: " + i.to_string() + " vs " + (i + 1).to_string() + 
      " only differs by " + bit_diff.to_string() + " bits")
    i = i + 1
  end
end

# ═══════════════════════════════════════════════════════════════
# Property: Collision Resistance
# ═══════════════════════════════════════════════════════════════
# Different inputs should (almost always) produce different outputs.

def test_no_collisions_sequential() -> Unit
  mut seen: Set[u64] = Set::new()
  mut i = 0
  mut collisions = 0
  
  while i < 10000 do
    let h = hash(i)
    if seen.contains(&h) then
      collisions = collisions + 1
    else
      seen.insert(h)
    end
    i = i + 1
  end
  
  # Allow very few collisions (statistical tolerance)
  assert_true(collisions < 5, 
    "too many collisions (" + collisions.to_string() + ") in 10000 sequential integers")
end

def test_no_collisions_strings() -> Unit
  mut seen: Set[u64] = Set::new()
  mut collisions = 0
  
  # Generate strings like "str_0", "str_1", etc.
  mut i = 0
  while i < 10000 do
    let s = "str_" + i.to_string()
    let h = hash(s)
    if seen.contains(&h) then
      collisions = collisions + 1
    else
      seen.insert(h)
    end
    i = i + 1
  end
  
  assert_true(collisions < 5, 
    "too many collisions (" + collisions.to_string() + ") in 10000 strings")
end

# ═══════════════════════════════════════════════════════════════
# Property: Consistency with Hash trait
# ═══════════════════════════════════════════════════════════════

def test_hash_trait_consistency() -> Unit
  let values = [0, 1, -1, 42, 1000000, -999999]
  
  for v in values do
    let h1 = hash(v)
    let mut hasher = SipHasher::new()
    v.hash(&mut hasher)
    let h2 = hasher.finish()
    assert_eq(h1, h2, "hash() and Hash trait should produce same result for " + v.to_string())
  end
end

# ═══════════════════════════════════════════════════════════════
# Property: Empty input handling
# ═══════════════════════════════════════════════════════════════

def test_empty_string_hash() -> Unit
  let h = hash("".to_string())
  # Empty string should have a non-zero hash (good hash functions don't return 0)
  assert_true(h != 0, "empty string hash should not be zero")
end

def test_empty_vec_hash() -> Unit
  let empty: Vec[Int] = Vec::new()
  let h = hash(empty)
  assert_true(h != 0, "empty vec hash should not be zero")
end

# ═══════════════════════════════════════════════════════════════
# Property: Large input handling
# ═══════════════════════════════════════════════════════════════

def test_large_string_hash() -> Unit
  # Create a 1MB string
  mut s = ""
  mut i = 0
  while i < 100000 do
    s = s + "abcdefghij"
    i = i + 1
  end
  
  let h = hash(s.clone())
  assert_true(h != 0, "large string hash should not be zero")
  
  # Verify determinism
  let h2 = hash(s)
  assert_eq(h, h2, "large string hash should be deterministic")
end

# ═══════════════════════════════════════════════════════════════
# Test Suite Registration
# ═══════════════════════════════════════════════════════════════

def register_hash_tests(inout suite: TestSuite) -> Unit
  suite.register("test_determinism_string", "hash_tests", test_determinism_string)
  suite.register("test_determinism_int", "hash_tests", test_determinism_int)
  suite.register("test_determinism_vec", "hash_tests", test_determinism_vec)
  suite.register("test_distribution", "hash_tests", test_distribution)
  suite.register("test_avalanche_strings", "hash_tests", test_avalanche_strings)
  suite.register("test_avalanche_ints", "hash_tests", test_avalanche_ints)
  suite.register("test_no_collisions_sequential", "hash_tests", test_no_collisions_sequential)
  suite.register("test_no_collisions_strings", "hash_tests", test_no_collisions_strings)
  suite.register("test_hash_trait_consistency", "hash_tests", test_hash_trait_consistency)
  suite.register("test_empty_string_hash", "hash_tests", test_empty_string_hash)
  suite.register("test_empty_vec_hash", "hash_tests", test_empty_vec_hash)
  suite.register("test_large_string_hash", "hash_tests", test_large_string_hash)
end

def run_hash_tests() -> Bool
  mut suite = TestSuite::new()
  register_hash_tests(&mut suite)
  run_all_tests(&suite)
end