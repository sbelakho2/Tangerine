## Tangerine Standard Library — Secure Data Types
##
## §11: SqlQuery, HtmlSafe, SafeUrl, SafePath
## Impossible to pass a raw String where a structured type is required.
## Construction only through validated constructors — no implicit coercion.

use std::core::{Option, Result, panic, Eq, Hash, Display}
use std::fmt::{Formatter, format}

# [METADATA]
# module: tg::secure_types
# status: alpha
# effects: []
# capabilities: [Unsafe]
# error_codes: [AccessDenied, InvalidInput, Internal]

use std::ctx
use std::gfx_errors::{Error, ErrorCode}

enum SecureError
  AccessDenied(Error)
  InvalidInput(Error)
  Internal(Error)
end

impl SecureError
  def message(self: &SecureError) -> &String
    match self
    when SecureError::AccessDenied(e) then &e.message
    when SecureError::InvalidInput(e) then &e.message
    when SecureError::Internal(e) then &e.message
    end
  end

  def code(self: &SecureError) -> ErrorCode
    match self
    when SecureError::AccessDenied(_) then ErrorCode::PermissionDenied
    when SecureError::InvalidInput(_) then ErrorCode::InvalidArg
    when SecureError::Internal(_) then ErrorCode::Internal
    end
  end
end

struct Secret[T]
  # Wrapper that prevents accidental logging or leakage.
  # Production implementation: zero-on-drop, no Debug/Display impls.
  _inner: T
end

impl[T] Secret[T]
  def new(val: T) -> Secret[T]
    Secret { _inner: val }
  end

  def expose(self: &Self, cap: &std::capabilities::Capability) -> Result[&T, SecureError]
    if cap.name != "Unsafe" then
      return Result::Err(SecureError::AccessDenied(Error::new(ErrorCode::PermissionDenied, "Unsafe capability required to expose secret".to_string())))
    end
    Result::Ok(&self._inner)
  end
end

struct Pii[T]
  # Wrapper for Personally Identifiable Information.
  # Production implementation: marks memory as sensitive for audit tools.
  _inner: T
end

impl[T] Pii[T]
  def new(val: T) -> Pii[T]
    Pii { _inner: val }
  end
end

# ═══════════════════════════════════════════════════════════════
# §11.1 — SqlQuery: parameterized SQL
# ═══════════════════════════════════════════════════════════════

## A SQL query with parameterized placeholders.
## Cannot be constructed from arbitrary String — must use the
## `sql!` macro or `SqlQuery::new()` with compile-time parsing.
struct SqlQuery
  query: String           # Template with $1, $2, ... placeholders
  params: Vec[SqlParam]   # Bound parameters
  _sealed: _Seal          # Prevents construction outside this module
end

enum SqlParam
  Text(String)
  Int(Int)
  Float(Float)
  Bool(Bool)
  Null
  Bytes(Vec[Byte])
end

struct _Seal end  # Module-private: prevents external construction

## Construct a SqlQuery with compile-time syntax validation.
## Placeholders $1, $2, ... must match the number of params.
def sql_query(template: String, params: Vec[SqlParam]) -> Result[SqlQuery, String]
  # Validate template: count placeholders
  let placeholder_count = count_placeholders(template)
  if placeholder_count != params.len()
    return Result::Err(
      "SQL template has " + placeholder_count.to_string()
      + " placeholders but " + params.len().to_string() + " params provided"
    )
  end

  # Check for injection markers
  if contains_injection_risk(template)
    return Result::Err("SQL template contains potential injection pattern")
  end

  Result::Ok(SqlQuery { query: template, params: params, _sealed: _Seal {} })
end

## Get the rendered query text (for debugging only — never send to DB).
def sql_debug_string(q: &SqlQuery) -> String
  let mut s = q.query
  for i in 0..q.params.len() do
    let placeholder = "$" + (i + 1).to_string()
    let value = match &q.params[i]
      when SqlParam::Text(t) then "'" + escape_sql_string(t) + "'"
      when SqlParam::Int(n) then n.to_string()
      when SqlParam::Float(f) then f.to_string()
      when SqlParam::Bool(b) then if b then "TRUE" else "FALSE" end
      when SqlParam::Null then "NULL"
      when SqlParam::Bytes(_) then "<bytes>"
    end
    s = s.replace(placeholder, value)
  end
  s
end

def count_placeholders(template: String) -> Int
  let mut count = 0
  let mut i = 0
  while i < template.len() do
    if template.char_at(i) == '$' && i + 1 < template.len() && template.char_at(i + 1).is_digit() then
      count = count + 1
      i = i + 1
      while i < template.len() && template.char_at(i).is_digit() do
        i = i + 1
      end
    else
      i = i + 1
    end
  end
  count
end

def contains_injection_risk(template: String) -> Bool
  # Reject templates with unparameterized string concatenation patterns
  template.contains("' +") || template.contains("+ '")
    || template.contains("\" +") || template.contains("+ \"")
end

def escape_sql_string(s: &String) -> String
  s.replace("'", "''")
end

# ═══════════════════════════════════════════════════════════════
# §11.2 — HtmlSafe: XSS-safe HTML
# ═══════════════════════════════════════════════════════════════

## HTML content that has been sanitized. Cannot be constructed
## from raw String — must use `html_escape()` or `html_safe()`.
struct HtmlSafe
  content: String
  _sealed: _Seal
end

## Escape a raw string for safe HTML embedding.
def html_escape(raw: &String) -> HtmlSafe
  let escaped = raw
    .replace("&", "&amp;")
    .replace("<", "&lt;")
    .replace(">", "&gt;")
    .replace("\"", "&quot;")
    .replace("'", "&#x27;")
  HtmlSafe { content: escaped, _sealed: _Seal {} }
end

## Mark already-sanitized content as safe (trusted input only).
## @requires cap::Unsafe — This is a trusted boundary.
@capability(Unsafe)
def html_safe_trusted(content: String) -> HtmlSafe
  HtmlSafe { content: content, _sealed: _Seal {} }
end

## Concatenate two safe HTML fragments.
def html_concat(a: &HtmlSafe, b: &HtmlSafe) -> HtmlSafe
  HtmlSafe { content: a.content + b.content, _sealed: _Seal {} }
end

## Get the inner content (for rendering).
def html_to_string(h: &HtmlSafe) -> &String
  &h.content
end

# ═══════════════════════════════════════════════════════════════
# §11.3 — SafeUrl: validated URL (secure wrapper)
# ═══════════════════════════════════════════════════════════════

## A validated URL. Cannot contain javascript: or data: schemes
## unless explicitly allowed. Named SafeUrl to avoid collision with std::url::Url.
struct SafeUrl
  scheme: String
  host: Option[String]
  port: Option[Int]
  path: String
  query: Option[String]
  fragment: Option[String]
  _sealed: _Seal
end

## Parse and validate a URL string.
def safe_url_parse(raw: &String) -> Result[SafeUrl, String]
  let parts = split_url(raw)
  match parts
    when Option::None then
      Result::Err("Invalid URL: '" + raw + "'")
    when Option::Some(p) then
      # Block dangerous schemes by default
      if p.scheme == "javascript" || p.scheme == "vbscript"
        return Result::Err("Blocked scheme: " + p.scheme)
      end
      Result::Ok(SafeUrl {
        scheme: p.scheme,
        host: p.host,
        port: p.port,
        path: p.path,
        query: p.query,
        fragment: p.fragment,
        _sealed: _Seal {}
      })
  end
end

struct UrlParts
  scheme: String
  host: Option[String]
  port: Option[Int]
  path: String
  query: Option[String]
  fragment: Option[String]
end

def split_url(raw: &String) -> Option[UrlParts]
  # Basic URL parsing — real implementation delegates to RFC 3986 parser
  let scheme_end = raw.find("://")
  match scheme_end
    when Option::None then Option::None
    when Option::Some(idx) then
      let scheme = raw.slice(0, idx).to_lowercase()
      let rest = raw.slice(idx + 3, raw.len())

      # Split host/path
      let path_start = rest.find("/").unwrap_or(rest.len())
      let authority = rest.slice(0, path_start)
      let path = if path_start < rest.len()
        rest.slice(path_start, rest.len())
      else
        "/"
      end

      # Split host:port
      let host_port = authority.split(":")
      let host = Option::Some(host_port[0].to_string())
      let port = if host_port.len() > 1
        match host_port[1].parse_int()
          when Result::Ok(p) then Option::Some(p)
          when Result::Err(_) then Option::None
        end
      else
        Option::None
      end

      # Split path?query#fragment
      let mut query = Option::None
      let mut fragment = Option::None
      let q_idx = path.find("?")
      let f_idx = path.find("#")

      match q_idx
      when Option::Some(qi) then
        let q_end = match f_idx
        when Option::Some(fi) then fi
        when Option::None then path.len()
        end
        query = Option::Some(path.slice(qi + 1, q_end).to_string())
      when Option::None then ()
      end

      match f_idx
      when Option::Some(fi) then
        fragment = Option::Some(path.slice(fi + 1, path.len()).to_string())
      when Option::None then ()
      end

      Option::Some(UrlParts {
        scheme: scheme,
        host: host,
        port: port,
        path: path,
        query: query,
        fragment: fragment
      })
  end
end

## Reconstruct URL to string.
def safe_url_to_string(u: &SafeUrl) -> String
  let s = u.scheme + "://"
  match &u.host
    when Option::Some(h) then s = s + h
    when Option::None then ()
  end
  match u.port
    when Option::Some(p) then s = s + ":" + p.to_string()
    when Option::None then ()
  end
  s = s + u.path
  match &u.query
    when Option::Some(q) then s = s + "?" + q
    when Option::None then ()
  end
  match &u.fragment
    when Option::Some(f) then s = s + "#" + f
    when Option::None then ()
  end
  s
end

# ═══════════════════════════════════════════════════════════════
# §11.4 — SafePath: validated filesystem path
# ═══════════════════════════════════════════════════════════════

## A validated filesystem path. Cannot contain traversal sequences
## (../, null bytes, or control characters).
struct SafePath
  segments: Vec[String]
  is_absolute: Bool
  _sealed: _Seal
end

## Parse and validate a filesystem path.
def path_parse(raw: &String) -> Result[SafePath, String]
  # Reject null bytes
  if raw.contains("\0")
    return Result::Err("Path contains null byte")
  end

  # Reject control characters
  for ch in raw.chars() do
    if ch.is_control() && ch != '/'
      return Result::Err("Path contains control character: " + ch.to_string())
    end
  end

  let is_absolute = raw.starts_with("/")
  let segments = raw.split("/").filter(|s| !s.is_empty()).collect()

  # Reject path traversal
  for seg in &segments do
    if seg == ".."
      return Result::Err("Path contains traversal (..) segment: " + raw)
    end
  end

  Result::Ok(SafePath {
    segments: segments,
    is_absolute: is_absolute,
    _sealed: _Seal {}
  })
end

## Join two paths safely.
def path_join(base: &SafePath, child: &SafePath) -> Result[SafePath, String]
  if child.is_absolute
    return Result::Err("Cannot join absolute path as child")
  end
  let segments = base.segments.clone()
  segments.extend(child.segments.iter())
  Result::Ok(SafePath {
    segments: segments,
    is_absolute: base.is_absolute,
    _sealed: _Seal {}
  })
end

## Convert SafePath to string.
def path_to_string(p: &SafePath) -> String
  let prefix = if p.is_absolute then "/" else "" end
  prefix + p.segments.join("/")
end

## Get the file extension if present.
def path_extension(p: &SafePath) -> Option[String]
  if p.segments.is_empty()
    return Option::None
  end
  let last = &p.segments[p.segments.len() - 1]
  let dot = last.rfind(".")
  match dot
    when Option::Some(idx) then Option::Some(last.slice(idx + 1, last.len()))
    when Option::None then Option::None
  end
end

# ═══════════════════════════════════════════════════════════════
# §11.5 — HeaderValue: HTTP header (prevents header injection)
# ═══════════════════════════════════════════════════════════════

struct HeaderValue
  name: String
  value: String
  _sealed: _Seal
end

def header_new(name: &String, value: &String) -> Result[HeaderValue, String]
  # Reject newlines (HTTP header injection)
  if name.contains("\n") || name.contains("\r")
    return Result::Err("Header name contains newline")
  end
  if value.contains("\n") || value.contains("\r")
    return Result::Err("Header value contains newline")
  end
  # Reject non-ASCII in header name
  for ch in name.chars() do
    if !ch.is_ascii() || ch.is_control()
      return Result::Err("Header name contains invalid character")
    end
  end
  Result::Ok(HeaderValue {
    name: name.clone(),
    value: value.clone(),
    _sealed: _Seal {}
  })
end
