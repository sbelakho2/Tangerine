    end
  end
  
  pub def blit_image(self: Self, src: VkImage, src_layout: i32, dst: VkImage, dst_layout: i32, regions: Vec[ImageBlit], filter: Filter) -> Unit
    unsafe "vulkan cmd blit image" do
      vkCmdBlitImage(self.handle, src, src_layout, dst, dst_layout, regions.len(), regions.as_ptr(), filter as i32)
    end
  end
  
  pub def pipeline_barrier(self: Self, src_stage_mask: u32, dst_stage_mask: u32, dependency_flags: u32, memory_barriers: Vec[MemoryBarrier], buffer_barriers: Vec[BufferMemoryBarrier], image_barriers: Vec[ImageMemoryBarrier]) -> Unit
    unsafe "vulkan cmd pipeline barrier" do
      vkCmdPipelineBarrier(
        self.handle,
        src_stage_mask,
        dst_stage_mask,
        dependency_flags,
        memory_barriers.len(),
        memory_barriers.as_ptr(),
        buffer_barriers.len(),
        buffer_barriers.as_ptr(),
        image_barriers.len(),
        image_barriers.as_ptr()
      )
    end
  end
end

pub enum IndexType
  when UInt16
  when UInt32
end

impl IndexType
  pub def to_vk(self: Self) -> i32
    match self
      when IndexType::UInt16 then 0
      when IndexType::UInt32 then 1
    end
  end
end

