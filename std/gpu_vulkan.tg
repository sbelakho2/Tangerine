# ———————————————————————————————————————————————————————————————

pub struct Framebuffer
  device: VkDevice
  handle: VkFramebuffer
end

impl Device
  pub def create_framebuffer(self: Self, render_pass: VkRenderPass, attachments: Vec[VkImageView], width: u32, height: u32, layers: u32) -> Result[Framebuffer, String]
    let mut handle: VkFramebuffer = 0
    
    unsafe "vulkan create framebuffer" do
      let result = vkCreateFramebuffer(
        self.handle,
        render_pass,
        attachments.as_ptr(),
        attachments.len(),
        width,
        height,
        layers,
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create framebuffer")
      end
    end
    
    Result::Ok(Framebuffer {
      device: self.handle,
      handle: handle
    })
  end
end

impl Framebuffer
  pub fn handle(self: Self) -> VkFramebuffer
    self.handle
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy framebuffer" do
      vkDestroyFramebuffer(self.device, self.handle)
    end
    self.handle = 0
  end
end

# ———————————————————————————————————————————————————————————————
# Surface Creation
# ———————————————————————————————————————————————————————————————

pub def create_surface(instance: VkInstance, window: Window) -> Result[VkSurfaceKHR, String]
  let mut surface: VkSurfaceKHR = 0
  
  unsafe "vulkan create surface" do
    let result = vkCreateSurface(instance, window.native_handle(), &mut surface)
    
    if result != VK_SUCCESS then
      return Result::Err("Failed to create surface")
    end
  end
  
  Result::Ok(surface)
end

pub def destroy_surface(instance: VkInstance, surface: VkSurfaceKHR) -> Unit
  unsafe "vulkan destroy surface" do
    vkDestroySurfaceKHR(instance, surface)
  end
end

# ———————————————————————————————————————————————————————————————
# Native Vulkan FFI declarations
# ———————————————————————————————————————————————————————————————

extern "C" do
  # Instance functions
  def vkCreateInstance(app_name: Ptr[u8], app_version: u32, engine_name: Ptr[u8], engine_version: u32, api_version: u32, layers: Ptr[Ptr[u8]], layer_count: usize, extensions: Ptr[Ptr[u8]], ext_count: usize, p_instance: Ptr[VkInstance]) -> i32
  def vkDestroyInstance(instance: VkInstance) -> Unit
  def vkEnumeratePhysicalDevices(instance: VkInstance) -> Vec[u64]
  
  # Device functions
  def vkCreateDevice(physical_device: VkPhysicalDevice, extensions: Ptr[Ptr[u8]], ext_count: usize, features: Ptr[PhysicalDeviceFeatures], queue_infos: Ptr[DeviceQueueCreateInfo], queue_count: usize, p_device: Ptr[VkDevice]) -> i32
  def vkDestroyDevice(device: VkDevice) -> Unit
  def vkGetDeviceQueue(device: VkDevice, queue_family_index: u32, queue_index: u32) -> VkQueue
  def vkDeviceWaitIdle(device: VkDevice) -> Unit
  
  # Buffer functions
  def vkCreateBuffer(device: VkDevice, size: u64, usage: u32, sharing_mode: u32, p_buffer: Ptr[VkBuffer]) -> i32
  def vkDestroyBuffer(device: VkDevice, buffer: VkBuffer) -> Unit
  def vkAllocateBufferMemory(device: VkDevice, buffer: VkBuffer, memory_type_bits: u32, p_memory: Ptr[u64]) -> i32
  def vkBindBufferMemory(device: VkDevice, buffer: VkBuffer, memory: u64, offset: u64) -> Unit
  
  # Image functions
  def vkCreateImage(device: VkDevice, format: i32, width: u32, height: u32, depth: u32, mip_levels: u32, array_layers: u32, usage: u32, p_image: Ptr[VkImage]) -> i32
  def vkDestroyImage(device: VkDevice, image: VkImage) -> Unit
  def vkAllocateImageMemory(device: VkDevice, image: VkImage, memory_type_bits: u32, p_memory: Ptr[u64]) -> i32
  def vkBindImageMemory(device: VkDevice, image: VkImage, memory: u64, offset: u64) -> Unit
  def vkCreateImageView(device: VkDevice, image: VkImage, format: i32, aspect_mask: u32, base_mip: u32, mip_count: u32, base_layer: u32, layer_count: u32, p_view: Ptr[VkImageView]) -> i32
  def vkDestroyImageView(device: VkDevice, view: VkImageView) -> Unit
  
  # Memory functions
  def vkAllocateMemory(device: VkDevice, size: u64, memory_type_index: u32, p_memory: Ptr[u64]) -> i32
  def vkFreeMemory(device: VkDevice, memory: u64) -> Unit
  def vkMapMemory(device: VkDevice, memory: u64, offset: u64, size: u64, flags: u32, pp_data: Ptr[Ptr[u8]]) -> i32
  def vkUnmapMemory(device: VkDevice, memory: u64) -> Unit
  
  # Swapchain functions
  def vkCreateSwapchainKHR(device: VkDevice, surface: VkSurfaceKHR, min_image_count: u32, format: i32, color_space: i32, width: u32, height: u32, array_layers: u32, usage: u32, present_mode: i32, clipped: Bool, old_swapchain: VkSwapchainKHR, p_swapchain: Ptr[VkSwapchainKHR]) -> i32
  def vkDestroySwapchainKHR(device: VkDevice, swapchain: VkSwapchainKHR) -> Unit
  def vkGetSwapchainImagesKHR(device: VkDevice, swapchain: VkSwapchainKHR) -> Vec[VkImage]
  def vkAcquireNextImageKHR(device: VkDevice, swapchain: VkSwapchainKHR, timeout: u64, semaphore: VkSemaphore, fence: VkFence, p_image_index: Ptr[u32]) -> i32
  def vkQueuePresentKHR(queue: VkQueue, wait_semaphores: Ptr[VkSemaphore], wait_count: usize, swapchain: VkSwapchainKHR, image_index: u32) -> i32
  
  # Render pass functions
  def vkCreateRenderPass(device: VkDevice, attachments: Ptr[AttachmentDescription], attachment_count: usize, subpasses: Ptr[SubpassDescription], subpass_count: usize, p_render_pass: Ptr[VkRenderPass]) -> i32
  def vkDestroyRenderPass(device: VkDevice, render_pass: VkRenderPass) -> Unit
  
  # Shader functions
  def vkCreateShaderModule(device: VkDevice, code: Ptr[u8], code_size: usize, p_module: Ptr[u64]) -> i32
  def vkDestroyShaderModule(device: VkDevice, module: u64) -> Unit
  
  # Pipeline functions
  def vkCreatePipelineLayout(device: VkDevice, set_layouts: Ptr[VkDescriptorSetLayout], set_count: usize, push_constant_ranges: Ptr[PushConstantRange], push_count: usize, p_layout: Ptr[VkPipelineLayout]) -> i32
  def vkDestroyPipelineLayout(device: VkDevice, layout: VkPipelineLayout) -> Unit
  def vkCreateGraphicsPipelines(device: VkDevice, cache: u64, count: u32, p_create_infos: Ptr[u8], p_pipelines: Ptr[VkPipeline]) -> i32
  def vkDestroyPipeline(device: VkDevice, pipeline: VkPipeline) -> Unit
  
  # Command pool/buffer functions
  def vkCreateCommandPool(device: VkDevice, queue_family_index: u32, flags: u32, p_pool: Ptr[VkCommandPool]) -> i32
  def vkDestroyCommandPool(device: VkDevice, pool: VkCommandPool) -> Unit
  def vkAllocateCommandBuffers(device: VkDevice, pool: VkCommandPool, count: u32, p_buffers: Ptr[VkCommandBuffer]) -> i32
  def vkFreeCommandBuffers(device: VkDevice, pool: VkCommandPool, count: u32, p_buffers: Ptr[VkCommandBuffer]) -> Unit
  def vkBeginCommandBuffer(buffer: VkCommandBuffer, flags: u32) -> i32
  def vkEndCommandBuffer(buffer: VkCommandBuffer) -> i32
  def vkResetCommandBuffer(buffer: VkCommandBuffer, flags: u32) -> i32
  
  # Command buffer recording
  def vkCmdBeginRenderPass(buffer: VkCommandBuffer, render_pass: VkRenderPass, framebuffer: VkFramebuffer, x: i32, y: i32, width: u32, height: u32, clear_values: Ptr[ClearColorValue], clear_count: usize, depth_clear: u64) -> Unit
  def vkCmdEndRenderPass(buffer: VkCommandBuffer) -> Unit
  def vkCmdBindPipeline(buffer: VkCommandBuffer, pipeline_bind_point: u32, pipeline: VkPipeline) -> Unit
  def vkCmdBindVertexBuffers(buffer: VkCommandBuffer, first_binding: u32, binding_count: u32, buffers: Ptr[VkBuffer], offsets: Ptr[u64]) -> Unit
  def vkCmdBindIndexBuffer(buffer: VkCommandBuffer, buffer: VkBuffer, offset: u64, index_type: i32) -> Unit
  def vkCmdBindDescriptorSets(buffer: VkCommandBuffer, pipeline_bind_point: u32, layout: VkPipelineLayout, first_set: u32, set_count: u32, sets: Ptr[VkDescriptorSet], dynamic_offset_count: u32, dynamic_offsets: Ptr[u32]) -> Unit
  def vkCmdPushConstants(buffer: VkCommandBuffer, layout: VkPipelineLayout, stage_flags: u32, offset: u32, size: u32, data: Ptr[u8]) -> Unit
  def vkCmdSetViewport(buffer: VkCommandBuffer, first_viewport: u32, viewport_count: u32, viewports: Ptr[Viewport]) -> Unit
  def vkCmdSetScissor(buffer: VkCommandBuffer, first_scissor: u32, scissor_count: u32, scissors: Ptr[Rect2D]) -> Unit
  def vkCmdSetLineWidth(buffer: VkCommandBuffer, line_width: f32) -> Unit
  def vkCmdSetDepthBias(buffer: VkCommandBuffer, constant_factor: f32, clamp: f32, slope_factor: f32) -> Unit
  def vkCmdSetBlendConstants(buffer: VkCommandBuffer, constants: Ptr[f32]) -> Unit
  def vkCmdSetDepthBounds(buffer: VkCommandBuffer, min_bounds: f32, max_bounds: f32) -> Unit
  def vkCmdSetStencilCompareMask(buffer: VkCommandBuffer, face_mask: u32, compare_mask: u32) -> Unit
  def vkCmdSetStencilWriteMask(buffer: VkCommandBuffer, face_mask: u32, write_mask: u32) -> Unit
  def vkCmdSetStencilReference(buffer: VkCommandBuffer, face_mask: u32, reference: u32) -> Unit
  def vkCmdDraw(buffer: VkCommandBuffer, vertex_count: u32, instance_count: u32, first_vertex: u32, first_instance: u32) -> Unit
  def vkCmdDrawIndexed(buffer: VkCommandBuffer, index_count: u32, instance_count: u32, first_index: u32, vertex_offset: i32, first_instance: u32) -> Unit
  def vkCmdDrawIndirect(buffer: VkCommandBuffer, buffer: VkBuffer, offset: u64, draw_count: u32, stride: u32) -> Unit
  def vkCmdDrawIndexedIndirect(buffer: VkCommandBuffer, buffer: VkBuffer, offset: u64, draw_count: u32, stride: u32) -> Unit
  def vkCmdDispatch(buffer: VkCommandBuffer, x: u32, y: u32, z: u32) -> Unit
  def vkCmdDispatchIndirect(buffer: VkCommandBuffer, buffer: VkBuffer, offset: u64) -> Unit
  def vkCmdCopyBuffer(buffer: VkCommandBuffer, src: VkBuffer, dst: VkBuffer, region_count: u32, regions: Ptr[BufferCopy]) -> Unit
  def vkCmdCopyImage(buffer: VkCommandBuffer, src: VkImage, src_layout: i32, dst: VkImage, dst_layout: i32, region_count: u32, regions: Ptr[ImageCopy]) -> Unit
  def vkCmdCopyBufferToImage(buffer: VkCommandBuffer, src: VkBuffer, dst: VkImage, dst_layout: i32, region_count: u32, regions: Ptr[BufferImageCopy]) -> Unit
  def vkCmdCopyImageToBuffer(buffer: VkCommandBuffer, src: VkImage, src_layout: i32, dst: VkBuffer, region_count: u32, regions: Ptr[BufferImageCopy]) -> Unit
  def vkCmdBlitImage(buffer: VkCommandBuffer, src: VkImage, src_layout: i32, dst: VkImage, dst_layout: i32, region_count: u32, regions: Ptr[ImageBlit], filter: i32) -> Unit
  def vkCmdPipelineBarrier(buffer: VkCommandBuffer, src_stage_mask: u32, dst_stage_mask: u32, dependency_flags: u32, memory_barrier_count: u32, memory_barriers: Ptr[MemoryBarrier], buffer_barrier_count: u32, buffer_barriers: Ptr[BufferMemoryBarrier], image_barrier_count: u32, image_barriers: Ptr[ImageMemoryBarrier]) -> Unit
  
  # Synchronization functions
  def vkCreateFence(device: VkDevice, flags: u32, p_fence: Ptr[VkFence]) -> i32
  def vkDestroyFence(device: VkDevice, fence: VkFence) -> Unit
  def vkWaitForFences(device: VkDevice, fence_count: u32, p_fences: Ptr[VkFence], wait_all: Bool, timeout: u64) -> i32
  def vkResetFences(device: VkDevice, fence_count: u32, p_fences: Ptr[VkFence]) -> Unit
  def vkGetFenceStatus(device: VkDevice, fence: VkFence) -> i32
  def vkCreateSemaphore(device: VkDevice, p_semaphore: Ptr[VkSemaphore]) -> i32
  def vkDestroySemaphore(device: VkDevice, semaphore: VkSemaphore) -> Unit
  
  # Queue functions
  def vkQueueSubmit(queue: VkQueue, submit_count: u32, submits: Ptr[SubmitInfo], fence: VkFence) -> i32
  def vkQueueWaitIdle(queue: VkQueue) -> Unit
  
  # Descriptor functions
  def vkCreateDescriptorSetLayout(device: VkDevice, bindings: Ptr[DescriptorSetLayoutBinding], binding_count: usize, p_layout: Ptr[VkDescriptorSetLayout]) -> i32
  def vkDestroyDescriptorSetLayout(device: VkDevice, layout: VkDescriptorSetLayout) -> Unit
  def vkCreateDescriptorPool(device: VkDevice, pool_sizes: Ptr[DescriptorPoolSize], pool_size_count: usize, max_sets: u32, flags: u32, p_pool: Ptr[VkDescriptorPool]) -> i32
  def vkDestroyDescriptorPool(device: VkDevice, pool: VkDescriptorPool) -> Unit
  def vkAllocateDescriptorSets(device: VkDevice, pool: VkDescriptorPool, p_layouts: Ptr[VkDescriptorSetLayout], count: u32, p_sets: Ptr[VkDescriptorSet]) -> i32
  def vkFreeDescriptorSets(device: VkDevice, pool: VkDescriptorPool, count: u32, p_sets: Ptr[VkDescriptorSet]) -> Unit
  def vkUpdateDescriptorSets(device: VkDevice, write_count: u32, p_writes: Ptr[WriteDescriptorSet], copy_count: u32, p_copies: Ptr[u8]) -> Unit
  
  # Sampler functions
  def vkCreateSampler(device: VkDevice, mag_filter: i32, min_filter: i32, mipmap_mode: i32, address_u: i32, address_v: i32, address_w: i32, mip_lod_bias: f32, anisotropy_enable: Bool, max_anisotropy: f32, compare_enable: Bool, compare_op: i32, min_lod: f32, max_lod: f32, border_color: i32, unnormalized_coords: Bool, p_sampler: Ptr[VkSampler]) -> i32
  def vkDestroySampler(device: VkDevice, sampler: VkSampler) -> Unit
  
  # Framebuffer functions
  def vkCreateFramebuffer(device: VkDevice, render_pass: VkRenderPass, attachments: Ptr[VkImageView], attachment_count: usize, width: u32, height: u32, layers: u32, p_framebuffer: Ptr[VkFramebuffer]) -> i32
  def vkDestroyFramebuffer(device: VkDevice, framebuffer: VkFramebuffer) -> Unit
  
  # Surface functions
  def vkCreateSurface(instance: VkInstance, window_handle: Ptr[u8], p_surface: Ptr[VkSurfaceKHR]) -> i32
  def vkDestroySurfaceKHR(instance: VkInstance, surface: VkSurfaceKHR) -> Unit
  
  # Memory functions
  def memcpy(dst: Ptr[u8], src: Ptr[u8], size: u64) -> Unit
end