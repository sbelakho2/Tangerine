end

pub enum Filter
  when Nearest
  when Linear
  when CubicImage
end

# ———————————————————————————————————————————————————————————————
# Synchronization
# ———————————————————————————————————————————————————————————————

pub struct Fence
  device: VkDevice
  handle: VkFence
end

pub struct Semaphore
  device: VkDevice
  handle: VkSemaphore
end

impl Device
  pub def create_fence(self: Self, signaled: Bool) -> Result[Fence, String]
    let mut handle: VkFence = 0
    
    unsafe "vulkan create fence" do
      let flags = if signaled then 0x00000001 else 0  # SIGNALED_BIT
      let result = vkCreateFence(self.handle, flags, &mut handle)
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create fence")
      end
    end
    
    Result::Ok(Fence {
      device: self.handle,
      handle: handle
    })
  end
  
  pub def create_semaphore(self: Self) -> Result[Semaphore, String]
    let mut handle: VkSemaphore = 0
    
    unsafe "vulkan create semaphore" do
      let result = vkCreateSemaphore(self.handle, &mut handle)
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create semaphore")
      end
    end
    
    Result::Ok(Semaphore {
      device: self.handle,
      handle: handle
    })
  end
end

impl Fence
  pub fn handle(self: Self) -> VkFence
    self.handle
  end
  
  pub def wait(self: Self, timeout: u64) -> Bool
    unsafe "vulkan wait for fences" do
      vkWaitForFences(self.device, 1, &self.handle, true, timeout) == VK_SUCCESS
    end
  end
  
  pub def reset(self: Self) -> Unit
    unsafe "vulkan reset fences" do
      vkResetFences(self.device, 1, &self.handle)
    end
  end
  
  pub def is_signaled(self: Self) -> Bool
    unsafe "vulkan get fence status" do
      vkGetFenceStatus(self.device, self.handle) == VK_SUCCESS
    end
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy fence" do
      vkDestroyFence(self.device, self.handle)
    end
    self.handle = 0
  end
end

impl Semaphore
  pub fn handle(self: Self) -> VkSemaphore
    self.handle
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy semaphore" do
      vkDestroySemaphore(self.device, self.handle)
    end
    self.handle = 0
  end
end

# ———————————————————————————————————————————————————————————————
# Queue Submission
# ———————————————————————————————————————————————————————————————

pub struct SubmitInfo
  wait_semaphores: Vec[VkSemaphore]
  wait_dst_stage_mask: Vec[u32]
  command_buffers: Vec[VkCommandBuffer]
  signal_semaphores: Vec[VkSemaphore]
end

impl Device
  pub def queue_submit(self: Self, queue: VkQueue, submits: Vec[SubmitInfo], fence: VkFence) -> Result[Unit, String]
    unsafe "vulkan queue submit" do
      let result = vkQueueSubmit(
        queue,
        submits.len(),
        submits.as_ptr(),
        fence
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to submit to queue")
      end
    end
    Result::Ok(())
  end
  
  pub def queue_wait_idle(self: Self, queue: VkQueue) -> Unit
    unsafe "vulkan queue wait idle" do
      vkQueueWaitIdle(queue)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Descriptor Sets
# ———————————————————————————————————————————————————————————————

pub struct DescriptorSetLayout
  device: VkDevice
  handle: VkDescriptorSetLayout
end

pub struct DescriptorPool
  device: VkDevice
  handle: VkDescriptorPool
end

pub struct DescriptorSetLayoutBinding
  binding: u32
  descriptor_type: DescriptorType
  descriptor_count: u32
  stage_flags: u32
end

pub enum DescriptorType
  when Sampler
  when CombinedImageSampler
  when SampledImage
  when StorageImage
  when UniformTexelBuffer
  when StorageTexelBuffer
  when UniformBuffer
  when StorageBuffer
  when UniformBufferDynamic
  when StorageBufferDynamic
  when InputAttachment
end

pub struct DescriptorPoolSize
  ty: DescriptorType
  descriptor_count: u32
end

impl Device
  pub def create_descriptor_set_layout(self: Self, bindings: Vec[DescriptorSetLayoutBinding]) -> Result[DescriptorSetLayout, String]
    let mut handle: VkDescriptorSetLayout = 0
    
    unsafe "vulkan create descriptor set layout" do
      let result = vkCreateDescriptorSetLayout(
        self.handle,
        bindings.as_ptr(),
        bindings.len(),
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create descriptor set layout")
      end
    end
    
    Result::Ok(DescriptorSetLayout {
      device: self.handle,
      handle: handle
    })
  end
  
  pub def create_descriptor_pool(self: Self, pool_sizes: Vec[DescriptorPoolSize], max_sets: u32) -> Result[DescriptorPool, String]
    let mut handle: VkDescriptorPool = 0
    
    unsafe "vulkan create descriptor pool" do
      let result = vkCreateDescriptorPool(
        self.handle,
        pool_sizes.as_ptr(),
        pool_sizes.len(),
        max_sets,
        0,  # flags
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create descriptor pool")
      end
    end
    
    Result::Ok(DescriptorPool {
      device: self.handle,
      handle: handle
    })
  end
end

impl DescriptorSetLayout
  pub fn handle(self: Self) -> VkDescriptorSetLayout
    self.handle
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy descriptor set layout" do
      vkDestroyDescriptorSetLayout(self.device, self.handle)
    end
    self.handle = 0
  end
end

impl DescriptorPool
  pub fn handle(self: Self) -> VkDescriptorPool
    self.handle
  end
  
  pub def allocate(self: Self, layout: VkDescriptorSetLayout) -> Result[VkDescriptorSet, String]
    let mut handle: VkDescriptorSet = 0
    
    unsafe "vulkan allocate descriptor sets" do
      let result = vkAllocateDescriptorSets(self.device, self.handle, &layout, 1, &mut handle)
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to allocate descriptor set")
      end
    end
    
    Result::Ok(handle)
  end
  
  pub def free(self: Self, set: VkDescriptorSet) -> Unit
    unsafe "vulkan free descriptor sets" do
      vkFreeDescriptorSets(self.device, self.handle, 1, &set)
    end
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy descriptor pool" do
      vkDestroyDescriptorPool(self.device, self.handle)
    end
    self.handle = 0
  end
end

impl Device
  pub def update_descriptor_sets(self: Self, writes: Vec[WriteDescriptorSet]) -> Unit
    unsafe "vulkan update descriptor sets" do
      vkUpdateDescriptorSets(
        self.handle,
        writes.len(),
        writes.as_ptr(),
        0,
        Ptr::null()
      )
    end
  end
end

pub struct WriteDescriptorSet
  dst_set: VkDescriptorSet
  dst_binding: u32
  dst_array_element: u32
  descriptor_count: u32
  descriptor_type: DescriptorType
  image_info: Option[DescriptorImageInfo]
  buffer_info: Option[DescriptorBufferInfo]
  texel_buffer_view: Option[u64]
end

pub struct DescriptorImageInfo
  sampler: VkSampler
  image_view: VkImageView
  image_layout: i32
end

pub struct DescriptorBufferInfo
  buffer: VkBuffer
  offset: u64
  range: u64
end

# ———————————————————————————————————————————————————————————————
# Sampler
# ———————————————————————————————————————————————————————————————

pub struct Sampler
  device: VkDevice
  handle: VkSampler
end

pub struct SamplerCreateInfo
  mag_filter: Filter
  min_filter: Filter
  mipmap_mode: SamplerMipmapMode
  address_mode_u: SamplerAddressMode
  address_mode_v: SamplerAddressMode
  address_mode_w: SamplerAddressMode
  mip_lod_bias: f32
  anisotropy_enable: Bool
  max_anisotropy: f32
  compare_enable: Bool
  compare_op: CompareOp
  min_lod: f32
  max_lod: f32
  border_color: BorderColor
  unnormalized_coordinates: Bool
end

pub enum SamplerMipmapMode
  when Nearest
  when Linear
end

pub enum SamplerAddressMode
  when Repeat
  when MirroredRepeat
  when ClampToEdge
  when ClampToBorder
  when MirrorClampToEdge
end

pub enum BorderColor
  when FloatTransparentBlack
  when IntTransparentBlack
  when FloatOpaqueBlack
  when IntOpaqueBlack
  when FloatOpaqueWhite
  when IntOpaqueWhite
end

impl Device
  pub def create_sampler(self: Self, info: SamplerCreateInfo) -> Result[Sampler, String]
    let mut handle: VkSampler = 0
    
    unsafe "vulkan create sampler" do
      let result = vkCreateSampler(
        self.handle,
        info.mag_filter as i32,
        info.min_filter as i32,
        info.mipmap_mode as i32,
        info.address_mode_u as i32,
        info.address_mode_v as i32,
        info.address_mode_w as i32,
        info.mip_lod_bias,
        info.anisotropy_enable,
        info.max_anisotropy,
        info.compare_enable,
        info.compare_op as i32,
        info.min_lod,
        info.max_lod,
        info.border_color as i32,
        info.unnormalized_coordinates,
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create sampler")
      end
    end
    
    Result::Ok(Sampler {
      device: self.handle,
      handle: handle
    })
  end
end

impl Sampler
  pub fn handle(self: Self) -> VkSampler
    self.handle
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy sampler" do
      vkDestroySampler(self.device, self.handle)
    end
    self.handle = 0
  end
end

# ———————————————————————————————————————————————————————————————
