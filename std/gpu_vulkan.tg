  end
  
  pub fn set_stencil_reference(self: Self, face_mask: u32, reference: u32) -> Unit
    unsafe "vulkan cmd set stencil reference" do
      vkCmdSetStencilReference(self.handle, face_mask, reference)
    end
  end
  
  pub def draw(self: Self, vertex_count: u32, instance_count: u32, first_vertex: u32, first_instance: u32) -> Unit
    unsafe "vulkan cmd draw" do
      vkCmdDraw(self.handle, vertex_count, instance_count, first_vertex, first_instance)
    end
  end
  
  pub def draw_indexed(self: Self, index_count: u32, instance_count: u32, first_index: u32, vertex_offset: i32, first_instance: u32) -> Unit
    unsafe "vulkan cmd draw indexed" do
      vkCmdDrawIndexed(self.handle, index_count, instance_count, first_index, vertex_offset, first_instance)
    end
  end
  
  pub def draw_indirect(self: Self, buffer: VkBuffer, offset: u64, draw_count: u32, stride: u32) -> Unit
    unsafe "vulkan cmd draw indirect" do
      vkCmdDrawIndirect(self.handle, buffer, offset, draw_count, stride)
    end
  end
  
  pub def draw_indexed_indirect(self: Self, buffer: VkBuffer, offset: u64, draw_count: u32, stride: u32) -> Unit
    unsafe "vulkan cmd draw indexed indirect" do
      vkCmdDrawIndexedIndirect(self.handle, buffer, offset, draw_count, stride)
    end
  end
  
  pub def dispatch(self: Self, group_count_x: u32, group_count_y: u32, group_count_z: u32) -> Unit
    unsafe "vulkan cmd dispatch" do
      vkCmdDispatch(self.handle, group_count_x, group_count_y, group_count_z)
    end
  end
  
  pub def dispatch_indirect(self: Self, buffer: VkBuffer, offset: u64) -> Unit
    unsafe "vulkan cmd dispatch indirect" do
      vkCmdDispatchIndirect(self.handle, buffer, offset)
    end
  end
  
  pub def copy_buffer(self: Self, src: VkBuffer, dst: VkBuffer, regions: Vec[BufferCopy]) -> Unit
    unsafe "vulkan cmd copy buffer" do
      vkCmdCopyBuffer(self.handle, src, dst, regions.len(), regions.as_ptr())
    end
  end
  
  pub def copy_image(self: Self, src: VkImage, src_layout: i32, dst: VkImage, dst_layout: i32, regions: Vec[ImageCopy]) -> Unit
    unsafe "vulkan cmd copy image" do
      vkCmdCopyImage(self.handle, src, src_layout, dst, dst_layout, regions.len(), regions.as_ptr())
    end
  end
  
  pub def copy_buffer_to_image(self: Self, src: VkBuffer, dst: VkImage, dst_layout: i32, regions: Vec[BufferImageCopy]) -> Unit
    unsafe "vulkan cmd copy buffer to image" do
      vkCmdCopyBufferToImage(self.handle, src, dst, dst_layout, regions.len(), regions.as_ptr())
    end
  end
  
  pub def copy_image_to_buffer(self: Self, src: VkImage, src_layout: i32, dst: VkBuffer, regions: Vec[BufferImageCopy]) -> Unit
    unsafe "vulkan cmd copy image to buffer" do
