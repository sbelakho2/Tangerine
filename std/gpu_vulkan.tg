# ———————————————————————————————————————————————————————————————
# Instance Creation
# ———————————————————————————————————————————————————————————————

pub struct InstanceCreateInfo
  application_name: String
  application_version: u32
  engine_name: String
  engine_version: u32
  api_version: u32
  enabled_layers: Vec[String]
  enabled_extensions: Vec[String]
end

pub def default_instance_create_info() -> InstanceCreateInfo
  InstanceCreateInfo {
    application_name: "Tangerine Application",
    application_version: VK_MAKE_VERSION(1, 0, 0),
    engine_name: "Tangerine",
    engine_version: VK_MAKE_VERSION(1, 0, 0),
    api_version: VK_API_VERSION_1_2(),
    enabled_layers: Vec::new(),
    enabled_extensions: Vec::new()
  }
end

pub const fn VK_MAKE_VERSION(major: u32, minor: u32, patch: u32) -> u32
  (major << 22) | (minor << 12) | patch
end

pub const fn VK_API_VERSION_1_2() -> u32
  VK_MAKE_VERSION(1, 2, 0)
end

pub const fn VK_API_VERSION_1_1() -> u32
  VK_MAKE_VERSION(1, 1, 0)
end

pub const fn VK_API_VERSION_1_0() -> u32
  VK_MAKE_VERSION(1, 0, 0)
end

# ———————————————————————————————————————————————————————————————
# Vulkan Instance
# ———————————————————————————————————————————————————————————————

pub struct VulkanInstance
  handle: VkInstance
  physical_devices: Vec[PhysicalDevice]
  debug_messenger: u64
end

impl VulkanInstance
  pub def create(info: InstanceCreateInfo) -> Result[VulkanInstance, String]
    let mut handle: VkInstance = 0
    
    unsafe "vulkan create instance" do
      let result = vkCreateInstance(
        info.application_name.as_ptr(),
        info.application_version,
        info.engine_name.as_ptr(),
        info.engine_version,
        info.api_version,
        info.enabled_layers.as_ptr(),
        info.enabled_layers.len(),
        info.enabled_extensions.as_ptr(),
        info.enabled_extensions.len(),
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create Vulkan instance")
      end
    end
    
    let instance = VulkanInstance {
      handle: handle,
      physical_devices: Vec::new(),
      debug_messenger: 0
    }
    
    # Enumerate physical devices
    let mut inst = instance
    inst.enumerate_physical_devices()
    
    Result::Ok(inst)
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy instance" do
      vkDestroyInstance(self.handle)
    end
    self.handle = 0
  end
  
  pub def enumerate_physical_devices(inout self: Self) -> Unit
    unsafe "vulkan enumerate physical devices" do
      let devices = vkEnumeratePhysicalDevices(self.handle)
      for dev in devices do
        self.physical_devices.push(PhysicalDevice::from_native(self.handle, dev))
      end
    end
  end
  
  pub fn physical_devices(self: Self) -> Vec[PhysicalDevice]
    self.physical_devices.clone()
  end
  
  pub fn handle(self: Self) -> VkInstance
    self.handle
  end
end

