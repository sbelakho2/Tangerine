# ———————————————————————————————————————————————————————————————
# Enums
# ———————————————————————————————————————————————————————————————

pub enum Format
  when Undefined
  when R8G8B8A8UNorm
  when R8G8B8A8SRGB
  when B8G8R8A8UNorm
  when B8G8R8A8SRGB
  when D32SFloat
  when D24UNormS8UInt
  when R32SFloat
  when R32G32SFloat
  when R32G32B32SFloat
  when R32G32B32A32SFloat
  when R16G16B16A16SFloat
end

impl Format
  pub def to_vk_format(self: Self) -> i32
    match self
      when Format::Undefined then VK_FORMAT_UNDEFINED
      when Format::R8G8B8A8UNorm then VK_FORMAT_R8G8B8A8_UNORM
      when Format::R8G8B8A8SRGB then VK_FORMAT_R8G8B8A8_SRGB
      when Format::B8G8R8A8UNorm then VK_FORMAT_B8G8R8A8_UNORM
      when Format::B8G8R8A8SRGB then VK_FORMAT_B8G8R8A8_SRGB
      when Format::D32SFloat then VK_FORMAT_D32_SFLOAT
      when Format::D24UNormS8UInt then VK_FORMAT_D24_UNORM_S8_UINT
      when Format::R32SFloat then 100  # VK_FORMAT_R32_SFLOAT
      when Format::R32G32SFloat then 103  # VK_FORMAT_R32G32_SFLOAT
      when Format::R32G32B32SFloat then 106  # VK_FORMAT_R32G32B32_SFLOAT
      when Format::R32G32B32A32SFloat then 109  # VK_FORMAT_R32G32B32A32_SFLOAT
      when Format::R16G16B16A16SFloat then 97  # VK_FORMAT_R16G16B16A16_SFLOAT
    end
  end
  
  pub fn bytes_per_pixel(self: Self) -> u32
    match self
      when Format::Undefined then 0
      when Format::R8G8B8A8UNorm then 4
      when Format::R8G8B8A8SRGB then 4
      when Format::B8G8R8A8UNorm then 4
      when Format::B8G8R8A8SRGB then 4
      when Format::D32SFloat then 4
      when Format::D24UNormS8UInt then 4
      when Format::R32SFloat then 4
      when Format::R32G32SFloat then 8
      when Format::R32G32B32SFloat then 12
      when Format::R32G32B32A32SFloat then 16
      when Format::R16G16B16A16SFloat then 8
    end
  end
end

