pub struct QueueFamilyProperties
  index: u32
  queue_flags: u32
  queue_count: u32
  timestamp_valid_bits: u32
  min_image_transfer_granularity: Extent3D
  supports_present: Bool
end

impl Clone for PhysicalDeviceProperties
  def clone(self: Self) -> Self
    PhysicalDeviceProperties {
      api_version: self.api_version,
      driver_version: self.driver_version,
      vendor_id: self.vendor_id,
      device_id: self.device_id,
      device_name: self.device_name.clone(),
      device_type: self.device_type
    }
  end
end

impl Clone for PhysicalDevice
  def clone(self: Self) -> Self
    PhysicalDevice {
      instance: self.instance,
      handle: self.handle,
      properties: self.properties.clone(),
      features: self.features,
      queue_families: self.queue_families.clone(),
      memory_properties: self.memory_properties
    }
  end
end

impl Clone for QueueFamilyProperties
  def clone(self: Self) -> Self
    QueueFamilyProperties {
      index: self.index,
      queue_flags: self.queue_flags,
      queue_count: self.queue_count,
      timestamp_valid_bits: self.timestamp_valid_bits,
      min_image_transfer_granularity: self.min_image_transfer_granularity,
      supports_present: self.supports_present
    }
  end
end


pub struct PhysicalDeviceMemoryProperties
  memory_types: Vec[MemoryTypeInfo]
  memory_heaps: Vec[MemoryHeapInfo]
end

pub struct MemoryTypeInfo
  index: u32
  property_flags: u32
  heap_index: u32
end

pub struct MemoryHeapInfo
  size: u64
  flags: u32
end

impl PhysicalDevice
  pub fn handle(self: Self) -> VkPhysicalDevice
    self.handle
  end
  
  pub fn properties(self: Self) -> PhysicalDeviceProperties
    self.properties.clone()
  end
  
  pub fn features(self: Self) -> PhysicalDeviceFeatures
    self.features
  end
  
  pub fn queue_families(self: Self) -> Vec[QueueFamilyProperties]
    self.queue_families.clone()
  end
  
  pub def find_graphics_queue_family(self: Self) -> Option[u32]
    for family in self.queue_families do
      if (family.queue_flags & 1) != 0 then  # VK_QUEUE_GRAPHICS_BIT
        return Option::Some(family.index)
      end
    end
    Option::None
  end
  
  pub def find_present_queue_family(self: Self, surface: VkSurfaceKHR) -> Option[u32]
    for family in self.queue_families do
      if family.supports_present then
        return Option::Some(family.index)
      end
    end
    Option::None
  end
  
  pub def find_compute_queue_family(self: Self) -> Option[u32]
    for family in self.queue_families do
      if (family.queue_flags & 2) != 0 then  # VK_QUEUE_COMPUTE_BIT
        return Option::Some(family.index)
      end
    end
    Option::None
  end
  
  pub def find_transfer_queue_family(self: Self) -> Option[u32]
    for family in self.queue_families do
      if (family.queue_flags & 4) != 0 then  # VK_QUEUE_TRANSFER_BIT
        return Option::Some(family.index)
      end
    end
    Option::None
  end
  
  pub def create_device(self: Self, create_info: DeviceCreateInfo) -> Result[Device, String]
    Device::create(self, create_info)
  end
end

# ———————————————————————————————————————————————————————————————
# Device
# ———————————————————————————————————————————————————————————————

pub struct DeviceCreateInfo
  enabled_extensions: Vec[String]
  enabled_features: PhysicalDeviceFeatures
  queue_create_infos: Vec[DeviceQueueCreateInfo]
end

pub struct DeviceQueueCreateInfo
  queue_family_index: u32
  queue_priorities: Vec[f32]
end

pub struct Device
  physical_device: VkPhysicalDevice
  handle: VkDevice
  graphics_queue: VkQueue
  graphics_queue_family: u32
  present_queue: VkQueue
  present_queue_family: u32
  compute_queue: VkQueue
  compute_queue_family: u32
end

impl Device
  pub def create(physical_device: PhysicalDevice, info: DeviceCreateInfo) -> Result[Device, String]
    let mut handle: VkDevice = 0
    let mut graphics_queue: VkQueue = 0
    let mut present_queue: VkQueue = 0
    let mut compute_queue: VkQueue = 0
    let mut graphics_queue_family: u32 = 0
    let mut present_queue_family: u32 = 0
    let mut compute_queue_family: u32 = 0
    
    unsafe "vulkan create device" do
      let result = vkCreateDevice(
        physical_device.handle,
        info.enabled_extensions.as_ptr(),
        info.enabled_extensions.len(),
        &info.enabled_features,
        info.queue_create_infos.as_ptr(),
        info.queue_create_infos.len(),
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create Vulkan device")
      end
      
      # Get queue handles
      for queue_info in info.queue_create_infos do
        let queue = vkGetDeviceQueue(handle, queue_info.queue_family_index, 0)
        
        # Determine queue type based on family properties
        if let Some(family) = physical_device.queue_families.get(queue_info.queue_family_index as usize) then
          if (family.queue_flags & 1) != 0 then  # Graphics
            graphics_queue = queue
            graphics_queue_family = queue_info.queue_family_index
          end
          if family.supports_present then
            present_queue = queue
            present_queue_family = queue_info.queue_family_index
          end
          if (family.queue_flags & 2) != 0 && graphics_queue != queue then  # Compute (dedicated)
            compute_queue = queue
            compute_queue_family = queue_info.queue_family_index
          end
        end
      end
    end
    
    Result::Ok(Device {
      physical_device: physical_device.handle,
      handle: handle,
      graphics_queue: graphics_queue,
      graphics_queue_family: graphics_queue_family,
      present_queue: present_queue,
      present_queue_family: present_queue_family,
      compute_queue: compute_queue,
      compute_queue_family: compute_queue_family
    })
  end
  
  pub fn handle(self: Self) -> VkDevice
    self.handle
  end
  
  pub fn graphics_queue(self: Self) -> VkQueue
    self.graphics_queue
  end
  
  pub fn graphics_queue_family(self: Self) -> u32
    self.graphics_queue_family
  end
  
  pub def wait_idle(self: Self) -> Unit
    unsafe "vulkan device wait idle" do
      vkDeviceWaitIdle(self.handle)
    end
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy device" do
      vkDestroyDevice(self.handle)
    end
    self.handle = 0
  end
end

# ———————————————————————————————————————————————————————————————
# Buffer
# ———————————————————————————————————————————————————————————————

pub struct Buffer
  device: VkDevice
  handle: VkBuffer
  memory: u64
  size: u64
  usage: BufferUsage
  mapped_ptr: Ptr[u8]
end

pub struct BufferCreateInfo
  size: u64
  usage: BufferUsage
  memory_type: MemoryType
end

impl Device
  pub def create_buffer(self: Self, info: BufferCreateInfo) -> Result[Buffer, String]
    let mut handle: VkBuffer = 0
    let mut memory: u64 = 0
    let mut mapped_ptr: Ptr[u8] = Ptr::null()
    
    unsafe "vulkan create buffer" do
      let result = vkCreateBuffer(
        self.handle,
        info.size,
        info.usage.to_vk_usage(),
        0,  # sharing mode exclusive
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create buffer")
      end
      
      # Allocate memory
      let mem_result = vkAllocateBufferMemory(
        self.handle,
        handle,
        info.memory_type.to_vk_memory_property_flags(),
        &mut memory
      )
      
      if mem_result != VK_SUCCESS then
        vkDestroyBuffer(self.handle, handle)
        return Result::Err("Failed to allocate buffer memory")
      end
      
      # Bind memory
      vkBindBufferMemory(self.handle, handle, memory, 0)
      
      # Map if host visible
      if info.memory_type == MemoryType::HostVisible || info.memory_type == MemoryType::HostCoherent then
        vkMapMemory(self.handle, memory, 0, info.size, 0, &mut mapped_ptr)
      end
    end
    
    Result::Ok(Buffer {
      device: self.handle,
      handle: handle,
      memory: memory,
      size: info.size,
      usage: info.usage,
      mapped_ptr: mapped_ptr
    })
  end
end

impl Buffer
  pub def map(inout self: Self) -> Ptr[u8]
    if self.mapped_ptr.is_null() then
      unsafe "vulkan map memory" do
        vkMapMemory(self.device, self.memory, 0, self.size, 0, &mut self.mapped_ptr)
      end
    end
    self.mapped_ptr
  end
  
  pub def unmap(inout self: Self) -> Unit
    if !self.mapped_ptr.is_null() then
      unsafe "vulkan unmap memory" do
        vkUnmapMemory(self.device, self.memory)
      end
      self.mapped_ptr = Ptr::null()
    end
  end
  
  pub def write(inout self: Self, data: Ptr[u8], size: u64, offset: u64) -> Unit
    let ptr = self.map()
    unsafe "memory copy" do
      memcpy(ptr.add(offset), data, size)
    end
  end
  
  pub def read(self: Self, data: Ptr[u8], size: u64, offset: u64) -> Unit
    if !self.mapped_ptr.is_null() then
      unsafe "memory copy" do
        memcpy(data, self.mapped_ptr.add(offset), size)
      end
    end
  end
  
  pub def destroy(inout self: Self) -> Unit
    self.unmap()
    unsafe "vulkan destroy buffer" do
      vkFreeMemory(self.device, self.memory)
      vkDestroyBuffer(self.device, self.handle)
    end
    self.handle = 0
    self.memory = 0
  end
end

impl BufferUsage
  pub def to_vk_usage(self: Self) -> u32
    match self
      when BufferUsage::Vertex then 0x00000002  # VK_BUFFER_USAGE_VERTEX_BUFFER_BIT
      when BufferUsage::Index then 0x00000040   # VK_BUFFER_USAGE_INDEX_BUFFER_BIT
      when BufferUsage::Uniform then 0x00000010 # VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT
      when BufferUsage::Storage then 0x00000020 # VK_BUFFER_USAGE_STORAGE_BUFFER_BIT
      when BufferUsage::TransferSrc then 0x00000001  # VK_BUFFER_USAGE_TRANSFER_SRC_BIT
      when BufferUsage::TransferDst then 0x00000002  # VK_BUFFER_USAGE_TRANSFER_DST_BIT
      when BufferUsage::Indirect then 0x00000100    # VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT
    end
  end
end

impl MemoryType
  pub def to_vk_memory_property_flags(self: Self) -> u32
    match self
      when MemoryType::DeviceLocal then 0x00000001      # VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT
      when MemoryType::HostVisible then 0x00000002      # VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT
      when MemoryType::HostCoherent then 0x00000004     # VK_MEMORY_PROPERTY_HOST_COHERENT_BIT
      when MemoryType::HostCached then 0x00000008       # VK_MEMORY_PROPERTY_HOST_CACHED_BIT
      when MemoryType::LazilyAllocated then 0x00000010  # VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Image and ImageView
# ———————————————————————————————————————————————————————————————

pub struct Image
  device: VkDevice
  handle: VkImage
  memory: u64
  view: VkImageView
  format: Format
  extent: Extent3D
  mip_levels: u32
  array_layers: u32
end

pub struct ImageCreateInfo
  format: Format
  extent: Extent3D
  mip_levels: u32
  array_layers: u32
  usage: ImageUsage
  memory_type: MemoryType
end

pub enum ImageUsage
  when TransferSrc
  when TransferDst
  when Sampled
  when Storage
  when ColorAttachment
  when DepthStencilAttachment
  when InputAttachment
end

impl Device
  pub def create_image(self: Self, info: ImageCreateInfo) -> Result[Image, String]
    let mut handle: VkImage = 0
    let mut memory: u64 = 0
    let mut view: VkImageView = 0
    
    unsafe "vulkan create image" do
      let result = vkCreateImage(
        self.handle,
        info.format.to_vk_format(),
        info.extent.width,
        info.extent.height,
        info.extent.depth,
        info.mip_levels,
        info.array_layers,
        info.usage.to_vk_usage(),
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create image")
      end
      
      # Allocate memory
      let mem_result = vkAllocateImageMemory(
        self.handle,
        handle,
        info.memory_type.to_vk_memory_property_flags(),
        &mut memory
      )
      
      if mem_result != VK_SUCCESS then
        vkDestroyImage(self.handle, handle)
        return Result::Err("Failed to allocate image memory")
      end
      
      # Bind memory
      vkBindImageMemory(self.handle, handle, memory, 0)
      
      # Create image view
      let view_result = vkCreateImageView(
        self.handle,
        handle,
        info.format.to_vk_format(),
        0,  # aspect mask
        0,  # base mip level
        info.mip_levels,
        0,  # base array layer
        info.array_layers,
        &mut view
      )
      
      if view_result != VK_SUCCESS then
        vkFreeMemory(self.handle, memory)
        vkDestroyImage(self.handle, handle)
        return Result::Err("Failed to create image view")
      end
    end
    
    Result::Ok(Image {
      device: self.handle,
      handle: handle,
      memory: memory,
      view: view,
      format: info.format,
      extent: info.extent,
      mip_levels: info.mip_levels,
      array_layers: info.array_layers
    })
  end
end

impl Image
  pub fn handle(self: Self) -> VkImage
    self.handle
  end
  
  pub fn view(self: Self) -> VkImageView
    self.view
  end
  
  pub fn extent(self: Self) -> Extent3D
    self.extent
  end
  
  pub fn format(self: Self) -> Format
    self.format
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy image" do
      vkDestroyImageView(self.device, self.view)
      vkFreeMemory(self.device, self.memory)
      vkDestroyImage(self.device, self.handle)
    end
    self.handle = 0
    self.view = 0
    self.memory = 0
  end
end

impl ImageUsage
  pub def to_vk_usage(self: Self) -> u32
    match self
      when ImageUsage::TransferSrc then 0x00000001
      when ImageUsage::TransferDst then 0x00000002
      when ImageUsage::Sampled then 0x00000004
      when ImageUsage::Storage then 0x00000008
      when ImageUsage::ColorAttachment then 0x00000010
      when ImageUsage::DepthStencilAttachment then 0x00000020
      when ImageUsage::InputAttachment then 0x00000080
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Swapchain
# ———————————————————————————————————————————————————————————————

pub struct Swapchain
  device: VkDevice
  handle: VkSwapchainKHR
  surface: VkSurfaceKHR
  images: Vec[VkImage]
  image_views: Vec[VkImageView]
  format: Format
  extent: Extent2D
  current_frame: u32
  max_frames_in_flight: u32
end

pub struct SwapchainCreateInfo
  surface: VkSurfaceKHR
  min_image_count: u32
  format: Format
  extent: Extent2D
  present_mode: PresentMode
  old_swapchain: VkSwapchainKHR
end

pub enum PresentMode
  when Immediate
  when Fifo
  when FifoRelaxed
  when Mailbox
end

impl Device
  pub def create_swapchain(self: Self, info: SwapchainCreateInfo) -> Result[Swapchain, String]
    let mut handle: VkSwapchainKHR = 0
    let mut images: Vec[VkImage] = Vec::new()
    let mut image_views: Vec[VkImageView] = Vec::new()
    
    unsafe "vulkan create swapchain" do
      let result = vkCreateSwapchainKHR(
        self.handle,
        info.surface,
        info.min_image_count,
        info.format.to_vk_format(),
        VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,  # color space
        info.extent.width,
        info.extent.height,
        1,  # image array layers
        0x10,  # VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT
        info.present_mode.to_vk(),
        true,  # clipped
        info.old_swapchain,
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create swapchain")
      end
      
      # Get swapchain images
      images = vkGetSwapchainImagesKHR(self.handle, handle)
      
      # Create image views
      for image in images do
        let mut view: VkImageView = 0
        let view_result = vkCreateImageView(
          self.handle,
          *image,
          info.format.to_vk_format(),
          0x01,  # VK_IMAGE_ASPECT_COLOR_BIT
          0, 1, 0, 1,
          &mut view
        )
        if view_result == VK_SUCCESS then
          image_views.push(view)
        end
      end
    end
    
    Result::Ok(Swapchain {
      device: self.handle,
      handle: handle,
      surface: info.surface,
      images: images,
      image_views: image_views,
      format: info.format,
      extent: info.extent,
      current_frame: 0,
      max_frames_in_flight: 2
    })
  end
end

impl Swapchain
  pub fn handle(self: Self) -> VkSwapchainKHR
    self.handle
  end
  
  pub fn image_count(self: Self) -> u32
    self.images.len() as u32
  end
  
  pub fn image_view(self: Self, index: u32) -> VkImageView
    self.image_views[index as usize]
  end
  
  pub fn extent(self: Self) -> Extent2D
    self.extent
  end
  
  pub fn format(self: Self) -> Format
    self.format
  end
  
  pub def acquire_next_image(self: Self, semaphore: VkSemaphore, fence: VkFence) -> Result[u32, String]
    let mut image_index: u32 = 0
    
    unsafe "vulkan acquire next image" do
      let result = vkAcquireNextImageKHR(
        self.device,
        self.handle,
        u64::MAX,  # timeout
        semaphore,
        fence,
        &mut image_index
      )
      
      if result == VK_SUCCESS then
        Result::Ok(image_index)
      else if result == VK_SUBOPTIMAL_KHR then
        Result::Ok(image_index)
      else if result == VK_ERROR_OUT_OF_DATE_KHR then
        Result::Err("Swapchain out of date")
      else
        Result::Err("Failed to acquire swapchain image")
      end
    end
  end
  
  pub def present(self: Self, queue: VkQueue, wait_semaphores: Vec[VkSemaphore], image_index: u32) -> Result[Unit, String]
    unsafe "vulkan present" do
      let result = vkQueuePresentKHR(
        queue,
        wait_semaphores.as_ptr(),
        wait_semaphores.len(),
        self.handle,
        image_index
      )
      
      if result == VK_SUCCESS then
        Result::Ok(())
      else if result == VK_SUBOPTIMAL_KHR then
        Result::Ok(())
      else if result == VK_ERROR_OUT_OF_DATE_KHR then
        Result::Err("Swapchain out of date")
      else
        Result::Err("Failed to present")
      end
    end
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy swapchain" do
      for view in self.image_views do
        vkDestroyImageView(self.device, *view)
      end
      vkDestroySwapchainKHR(self.device, self.handle)
    end
    self.handle = 0
    self.images.clear()
    self.image_views.clear()
  end
end

impl PresentMode
  pub def to_vk(self: Self) -> i32
    match self
      when PresentMode::Immediate then 0
      when PresentMode::Fifo then 1
      when PresentMode::FifoRelaxed then 2
      when PresentMode::Mailbox then 3
    end
  end
end

pub const VK_SUBOPTIMAL_KHR: i32 = 1000001003
pub const VK_ERROR_OUT_OF_DATE_KHR: i32 = -1000001004

# ———————————————————————————————————————————————————————————————
# Render Pass
# ———————————————————————————————————————————————————————————————

pub struct RenderPass
  device: VkDevice
  handle: VkRenderPass
end

pub struct AttachmentDescription
  format: Format
  samples: u32
  load_op: AttachmentLoadOp
  store_op: AttachmentStoreOp
  stencil_load_op: AttachmentLoadOp
  stencil_store_op: AttachmentStoreOp
  initial_layout: i32
  final_layout: i32
end

pub enum AttachmentLoadOp
  when Load
  when Clear
  when DontCare
end

pub enum AttachmentStoreOp
  when Store
  when DontCare
end

pub struct SubpassDescription
  color_attachments: Vec[AttachmentReference]
  depth_stencil_attachment: Option[AttachmentReference]
end

pub struct AttachmentReference
  attachment: u32
  layout: i32
end

impl Device
  pub def create_render_pass(self: Self, attachments: Vec[AttachmentDescription], subpasses: Vec[SubpassDescription]) -> Result[RenderPass, String]
    let mut handle: VkRenderPass = 0
    
    unsafe "vulkan create render pass" do
      let result = vkCreateRenderPass(
        self.handle,
        attachments.as_ptr(),
        attachments.len(),
        subpasses.as_ptr(),
        subpasses.len(),
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create render pass")
      end
    end
    
    Result::Ok(RenderPass {
      device: self.handle,
      handle: handle
    })
  end
end

impl RenderPass
  pub fn handle(self: Self) -> VkRenderPass
    self.handle
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy render pass" do
      vkDestroyRenderPass(self.device, self.handle)
    end
    self.handle = 0
  end
end

# ———————————————————————————————————————————————————————————————
# Pipeline
# ———————————————————————————————————————————————————————————————

pub struct Pipeline
  device: VkDevice
  handle: VkPipeline
  layout: VkPipelineLayout
end

pub struct GraphicsPipelineCreateInfo
  vertex_shader: ShaderModule
  fragment_shader: ShaderModule
  vertex_input_state: VertexInputState
  input_assembly_state: InputAssemblyState
  viewport_state: ViewportState
  rasterization_state: RasterizationState
  multisample_state: MultisampleState
  depth_stencil_state: DepthStencilState
  color_blend_state: ColorBlendState
  render_pass: VkRenderPass
  subpass: u32
  layout: VkPipelineLayout
end

pub struct ShaderModule
  device: VkDevice
  handle: u64
end

pub struct VertexInputState
  bindings: Vec[VertexInputBindingDescription]
  attributes: Vec[VertexInputAttributeDescription]
end

pub struct VertexInputBindingDescription
  binding: u32
  stride: u32
  input_rate: VertexInputRate
end

pub struct VertexInputAttributeDescription
  location: u32
  binding: u32
  format: Format
  offset: u32
end

pub enum VertexInputRate
  when Vertex
  when Instance
end

pub struct InputAssemblyState
  topology: PrimitiveTopology
  primitive_restart_enable: Bool
end

pub struct ViewportState
  viewports: Vec[Viewport]
  scissors: Vec[Rect2D]
end

pub struct RasterizationState
  depth_clamp_enable: Bool
  rasterizer_discard_enable: Bool
  polygon_mode: PolygonMode
  cull_mode: CullMode
  front_face: FrontFace
  depth_bias_enable: Bool
  depth_bias_constant_factor: f32
  depth_bias_clamp: f32
  depth_bias_slope_factor: f32
  line_width: f32
end

pub enum PolygonMode
  when Fill
  when Line
  when Point
end

pub struct MultisampleState
  rasterization_samples: u32
  sample_shading_enable: Bool
  min_sample_shading: f32
  sample_masks: Vec[u32]
  alpha_to_coverage_enable: Bool
  alpha_to_one_enable: Bool
end

pub struct DepthStencilState
  depth_test_enable: Bool
  depth_write_enable: Bool
  depth_compare_op: CompareOp
  depth_bounds_test_enable: Bool
  stencil_test_enable: Bool
  front: StencilOpState
  back: StencilOpState
  min_depth_bounds: f32
  max_depth_bounds: f32
end

pub struct StencilOpState
  fail_op: StencilOp
  pass_op: StencilOp
  depth_fail_op: StencilOp
  compare_op: CompareOp
  compare_mask: u32
  write_mask: u32
  reference: u32
end

pub enum StencilOp
  when Keep
  when Zero
  when Replace
  when IncrementAndClamp
  when DecrementAndClamp
  when Invert
  when IncrementAndWrap
  when DecrementAndWrap
end

pub struct ColorBlendState
  logic_op_enable: Bool
  logic_op: LogicOp
  attachments: Vec[ColorBlendAttachmentState]
  blend_constants: Vec[f32]
end

pub struct ColorBlendAttachmentState
  blend_enable: Bool
  src_color_blend_factor: BlendFactor
  dst_color_blend_factor: BlendFactor
  color_blend_op: BlendOp
  src_alpha_blend_factor: BlendFactor
  dst_alpha_blend_factor: BlendFactor
  alpha_blend_op: BlendOp
  color_write_mask: u32
end

pub enum LogicOp
  when Clear
  when And
  when AndReverse
  when Copy
  when AndInverted
  when NoOp
  when Xor
  when Or
  when Nor
  when Equivalent
  when Invert
  when OrReverse
  when CopyInverted
  when OrInverted
  when Nand
  when Set
end

impl Device
  pub def create_shader_module(self: Self, code: Vec[u8]) -> Result[ShaderModule, String]
    let mut handle: u64 = 0
    
    unsafe "vulkan create shader module" do
      let result = vkCreateShaderModule(self.handle, code.as_ptr(), code.len(), &mut handle)
      if result != VK_SUCCESS then
        return Result::Err("Failed to create shader module")
      end
    end
    
    Result::Ok(ShaderModule {
      device: self.handle,
      handle: handle
    })
  end
  
  pub def create_pipeline_layout(self: Self, set_layouts: Vec[VkDescriptorSetLayout], push_constant_ranges: Vec[PushConstantRange]) -> Result[VkPipelineLayout, String]
    let mut handle: VkPipelineLayout = 0
    
    unsafe "vulkan create pipeline layout" do
      let result = vkCreatePipelineLayout(
        self.handle,
        set_layouts.as_ptr(),
        set_layouts.len(),
        push_constant_ranges.as_ptr(),
        push_constant_ranges.len(),
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create pipeline layout")
      end
    end
    
    Result::Ok(handle)
  end
  
  pub def create_graphics_pipeline(self: Self, info: GraphicsPipelineCreateInfo) -> Result[Pipeline, String]
    let mut handle: VkPipeline = 0
    
    unsafe "vulkan create graphics pipeline" do
      let result = vkCreateGraphicsPipelines(
        self.handle,
        0,  # pipeline cache
        1,  # create info count
        &info.vertex_shader.handle,
        &info.fragment_shader.handle,
        &info.vertex_input_state,
        &info.input_assembly_state,
        &info.viewport_state,
        &info.rasterization_state,
        &info.multisample_state,
        &info.depth_stencil_state,
        &info.color_blend_state,
        info.render_pass,
        info.subpass,
        info.layout,
        &mut handle
      )
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create graphics pipeline")
      end
    end
    
    Result::Ok(Pipeline {
      device: self.handle,
      handle: handle,
      layout: info.layout
    })
  end
end

impl ShaderModule
  pub fn handle(self: Self) -> u64
    self.handle
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy shader module" do
      vkDestroyShaderModule(self.device, self.handle)
    end
    self.handle = 0
  end
end

impl Pipeline
  pub fn handle(self: Self) -> VkPipeline
    self.handle
  end
  
  pub fn layout(self: Self) -> VkPipelineLayout
    self.layout
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy pipeline" do
      vkDestroyPipeline(self.device, self.handle)
    end
    self.handle = 0
  end
end

pub struct PushConstantRange
  stage_flags: u32
  offset: u32
  size: u32
end

# ———————————————————————————————————————————————————————————————
# Command Buffers
# ———————————————————————————————————————————————————————————————

pub struct CommandPool
  device: VkDevice
  handle: VkCommandPool
end

pub struct CommandBuffer
  device: VkDevice
  pool: VkCommandPool
  handle: VkCommandBuffer
end

impl Device
  pub def create_command_pool(self: Self, queue_family_index: u32, transient: Bool) -> Result[CommandPool, String]
    let mut handle: VkCommandPool = 0
    
    unsafe "vulkan create command pool" do
      let flags = if transient then 0x00000002 else 0x00000000  # TRANSIENT_BIT
      let result = vkCreateCommandPool(self.handle, queue_family_index, flags, &mut handle)
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to create command pool")
      end
    end
    
    Result::Ok(CommandPool {
      device: self.handle,
      handle: handle
    })
  end
end

impl CommandPool
  pub fn handle(self: Self) -> VkCommandPool
    self.handle
  end
  
  pub def allocate_command_buffer(self: Self) -> Result[CommandBuffer, String]
    let mut handle: VkCommandBuffer = 0
    
    unsafe "vulkan allocate command buffer" do
      let result = vkAllocateCommandBuffers(self.device, self.handle, 1, &mut handle)
      
      if result != VK_SUCCESS then
        return Result::Err("Failed to allocate command buffer")
      end
    end
    
    Result::Ok(CommandBuffer {
      device: self.device,
      pool: self.handle,
      handle: handle
    })
  end
  
  pub def free_command_buffer(self: Self, inout cmd: CommandBuffer) -> Unit
    unsafe "vulkan free command buffer" do
      vkFreeCommandBuffers(self.device, self.handle, 1, &cmd.handle)
    end
    cmd.handle = 0
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "vulkan destroy command pool" do
      vkDestroyCommandPool(self.device, self.handle)
    end
    self.handle = 0
  end
end

impl CommandBuffer
  pub fn handle(self: Self) -> VkCommandBuffer
    self.handle
  end
  
  pub def begin(self: Self, one_time_submit: Bool) -> Unit
    unsafe "vulkan begin command buffer" do
      let flags = if one_time_submit then 0x00000001 else 0  # ONE_TIME_SUBMIT_BIT
      vkBeginCommandBuffer(self.handle, flags)
    end
  end
  
  pub def end(self: Self) -> Unit
    unsafe "vulkan end command buffer" do
      vkEndCommandBuffer(self.handle)
    end
  end
  
  pub def reset(self: Self, release_resources: Bool) -> Unit
    unsafe "vulkan reset command buffer" do
      let flags = if release_resources then 0x00000001 else 0  # RELEASE_RESOURCES_BIT
      vkResetCommandBuffer(self.handle, flags)
    end
  end
  
  # Recording commands
  pub def begin_render_pass(self: Self, render_pass: VkRenderPass, framebuffer: VkFramebuffer, render_area: Rect2D, clear_values: Vec[ClearColorValue], depth_clear: Option[ClearDepthStencilValue]) -> Unit
    unsafe "vulkan cmd begin render pass" do
      vkCmdBeginRenderPass(
        self.handle,
        render_pass,
        framebuffer,
        render_area.x,
        render_area.y,
        render_area.width,
        render_area.height,
        clear_values.as_ptr(),
        clear_values.len(),
        depth_clear.as_ref().map_or(0, |d| d as *const _ as u64)
      )
    end
  end
  
  pub def end_render_pass(self: Self) -> Unit
    unsafe "vulkan cmd end render pass" do
      vkCmdEndRenderPass(self.handle)
    end
  end
  
  pub def bind_pipeline(self: Self, pipeline: VkPipeline) -> Unit
    unsafe "vulkan cmd bind pipeline" do
      vkCmdBindPipeline(self.handle, 0, pipeline)  # 0 = VK_PIPELINE_BIND_POINT_GRAPHICS
    end
  end
  
  pub def bind_vertex_buffers(self: Self, first_binding: u32, buffers: Vec[VkBuffer], offsets: Vec[u64]) -> Unit
    unsafe "vulkan cmd bind vertex buffers" do
      vkCmdBindVertexBuffers(self.handle, first_binding, buffers.len(), buffers.as_ptr(), offsets.as_ptr())
    end
  end
  
  pub def bind_index_buffer(self: Self, buffer: VkBuffer, offset: u64, index_type: IndexType) -> Unit
    unsafe "vulkan cmd bind index buffer" do
      vkCmdBindIndexBuffer(self.handle, buffer, offset, index_type.to_vk())
    end
  end
  
  pub def bind_descriptor_sets(self: Self, pipeline_layout: VkPipelineLayout, first_set: u32, sets: Vec[VkDescriptorSet], dynamic_offsets: Vec[u32]) -> Unit
    unsafe "vulkan cmd bind descriptor sets" do
      vkCmdBindDescriptorSets(
        self.handle,
        0,  # VK_PIPELINE_BIND_POINT_GRAPHICS
        pipeline_layout,
        first_set,
        sets.len(),
        sets.as_ptr(),
        dynamic_offsets.len(),
        dynamic_offsets.as_ptr()
      )
    end
  end
  
  pub def push_constants(self: Self, pipeline_layout: VkPipelineLayout, stage_flags: u32, offset: u32, size: u32, data: Ptr[u8]) -> Unit
    unsafe "vulkan cmd push constants" do
      vkCmdPushConstants(self.handle, pipeline_layout, stage_flags, offset, size, data)
    end
  end
  
