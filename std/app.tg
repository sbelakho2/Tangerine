# Tangerine Standard Library — tg::app
# Windowing, event loop, input, and capability types.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 6.

use std::core::{Option, Result, String, Bool, Int, Unit}
use std::geom::{Vec2, Rect}
use std::gfx_errors::{Error, ErrorCode, AppError, GfxError}

# [METADATA]
# module: tg::app
# status: alpha
# effects: [Display, Clipboard, Ime, DragDrop, Clock, Random, Fs]
# capabilities: [Display, Clipboard, Ime, DragDrop, Clock, Random, Fs]
# error_codes: [BackendUnavailable, InvalidArg, Unsupported, PermissionDenied, Internal]

# ═══════════════════════════════════════════════════════════════
# §6.1 Capabilities — opaque tokens gating side-effecting operations
# ═══════════════════════════════════════════════════════════════

use std::capabilities::{Capability, custom_cap}

def display_cap() -> Capability
  custom_cap("Display")
end

def clipboard_cap() -> Capability
  custom_cap("Clipboard")
end

def ime_cap() -> Capability
  custom_cap("Ime")
end

def drag_drop_cap() -> Capability
  custom_cap("DragDrop")
end

def clock_cap() -> Capability
  custom_cap("Clock")
end

def random_cap() -> Capability
  custom_cap("Random")
end

def fs_cap() -> Capability
  custom_cap("Fs")
end

struct DisplayCap
  _opaque: u64
end

# DisplayCap acquisition - creates a valid display capability token
def acquire_display_cap() -> DisplayCap
  DisplayCap { _opaque: 1 }
end

struct ClipboardCap
  _opaque: u64
end

struct ImeCap
  _opaque: u64
end

struct DragDropCap
  _opaque: u64
end

struct ClockCap
  _opaque: u64
end

struct RandomCap
  _opaque: u64
end

struct FsCap
  _opaque: u64
end

# ═══════════════════════════════════════════════════════════════
# §6.2 Input / event data types
# ═══════════════════════════════════════════════════════════════

enum MouseButton
  Left
  Right
  Middle
  Other(Int)
end

enum Key
  Enter
  Escape
  Backspace
  Tab
  Space
  ArrowUp
  ArrowDown
  ArrowLeft
  ArrowRight
  Home
  End
  PageUp
  PageDown
  Insert
  Delete
  Char(Char)
  F(Int)
end

struct KeyMods
  shift: Bool
  ctrl: Bool
  alt: Bool
  meta: Bool
end

impl KeyMods
  def none() -> KeyMods
    KeyMods { shift: false, ctrl: false, alt: false, meta: false }
  end

  def has_any(self: &KeyMods) -> Bool
    self.shift || self.ctrl || self.alt || self.meta
  end
end

enum ScrollMode
  Pixel
  Line
end

struct WindowId
  value: u64
end

struct TimerId
  value: u64
end

struct Dpi
  scale: f32
end

impl Dpi
  def default() -> Dpi
    Dpi { scale: 1.0 }
  end

  def hidpi() -> Dpi
    Dpi { scale: 2.0 }
  end
end

# ———————————————————————————————————————————————————————————————
# Event — all event variants per spec §6.2
# ———————————————————————————————————————————————————————————————

enum Event
  KeyDown(Key, KeyMods, repeat: Bool)
  KeyUp(Key, KeyMods)
  TextInput(String)
  ImeStart
  ImeUpdate(preedit: String, cursor: Int)
  ImeEnd
  MouseMove(x: f32, y: f32)
  MouseDown(MouseButton)
  MouseUp(MouseButton)
  Scroll(dx: f32, dy: f32, mode: ScrollMode)
  DragEnter
  DragOver(x: f32, y: f32)
  DragDrop(paths: Vec[String])
  DragLeave
  Resize(w: Int, h: Int)
  FocusGained
  FocusLost
  CloseRequested
  RedrawRequested
end

# ═══════════════════════════════════════════════════════════════
# §6.3 AppOpts + trait App
# ═══════════════════════════════════════════════════════════════

struct AppOpts
  backend: String
  vsync: Bool
  high_dpi: Bool
end

impl AppOpts
  def default() -> AppOpts
    AppOpts {
      backend: "auto".to_string(),
      vsync: true,
      high_dpi: true
    }
  end
end

trait App
  def window_new(self: &mut Self, title: String, w: Int, h: Int, display: DisplayCap) -> Result[Box[Window], AppError]
  def run(self: &mut Self, main: Fn(&mut Self) -> Unit) -> Result[Unit, AppError]
  def request_timer(self: &mut Self, ms: Int) -> TimerId
  def cancel_timer(self: &mut Self, id: TimerId) -> Unit

  # Optional recorder API for determinism/replay
  def recorder_start(self: &mut Self, path: String, fs: FsCap) -> Result[Unit, AppError]
  def recorder_stop(self: &mut Self) -> Result[Unit, AppError]
end

# ═══════════════════════════════════════════════════════════════
# §6.4 trait Window
# ═══════════════════════════════════════════════════════════════

trait Window
  def id(self: &Self) -> WindowId
  def size(self: &Self) -> (Int, Int)
  def dpi(self: &Self) -> Dpi
  def set_title(self: &mut Self, title: String) -> Unit
  def request_redraw(self: &mut Self) -> Unit
  def poll_event(self: &mut Self) -> Option[Event]

  # Graphics target — yields a Surface for drawing
  def surface(self: &mut Self) -> Result[Box[Surface], AppError]

  # Clipboard APIs (capability-gated)
  def clipboard_set(self: &mut Self, caps: ClipboardCap, text: String) -> Result[Unit, AppError]
  def clipboard_get(self: &mut Self, caps: ClipboardCap) -> Result[String, AppError]
end

# Forward-declare Surface trait (defined in tg::gfx)
# This is a trait reference that tg::gfx implements.
trait Surface
  def size(self: &Self) -> (Int, Int)
  def begin_frame(self: &mut Self) -> Result[Box[std::gfx::Canvas], GfxError]
  def end_frame(self: &mut Self) -> Result[Unit, GfxError]
  def present(self: &mut Self) -> Result[Unit, GfxError]
end

# ═══════════════════════════════════════════════════════════════
# Reference implementation — SoftwareApp
# A minimal software-rendered App for testing and fallback.
# ═══════════════════════════════════════════════════════════════

struct SoftwareApp
  opts: AppOpts
  windows: Vec[WindowId]
  next_window_id: u64
  next_timer_id: u64
  running: Bool
  recording: Bool
  record_path: Option[String]
  event_log: Vec[Event]
  timers: Map[u64, Int]
end

impl SoftwareApp
  def new(opts: AppOpts) -> SoftwareApp
    SoftwareApp {
      opts: opts,
      windows: Vec::new(),
      next_window_id: 1,
      next_timer_id: 1,
      running: false,
      recording: false,
      record_path: Option::None,
      event_log: Vec::new(),
      timers: Map::new()
    }
  end
end

impl App for SoftwareApp
  def window_new(self: &mut Self, title: String, w: Int, h: Int, display: DisplayCap) -> Result[Box[Window], AppError]
    let id = WindowId { value: self.next_window_id }
    self.next_window_id = self.next_window_id + 1

    let win = SoftwareWindow {
      win_id: id,
      title: title,
      width: w,
      height: h,
      dpi_scale: if self.opts.high_dpi then Dpi { scale: 2.0 } else Dpi { scale: 1.0 } end,
      event_queue: Vec::new(),
      closed: false,
      clipboard: "".to_string()
    }
    let boxed = Box::new(win)
    self.windows.push(WindowId { value: id.value })
    Result::Ok(boxed as Box[Window])
  end

  def run(self: &mut Self, main: Fn(&mut Self) -> Unit) -> Result[Unit, AppError]
    self.running = true
    main(self)
    self.running = false
    Result::Ok(())
  end

  def request_timer(self: &mut Self, ms: Int) -> TimerId
    let id = TimerId { value: self.next_timer_id }
    self.timers.insert(self.next_timer_id, ms)
    self.next_timer_id = self.next_timer_id + 1
    id
  end

  def cancel_timer(self: &mut Self, id: TimerId) -> Unit
    let _removed = self.timers.remove(id.value)
    ()
  end

  def recorder_start(self: &mut Self, path: String, fs: FsCap) -> Result[Unit, AppError]
    self.recording = true
    self.record_path = Option::Some(path)
    self.event_log.clear()
    Result::Ok(())
  end

  def recorder_stop(self: &mut Self) -> Result[Unit, AppError]
    self.recording = false
    Result::Ok(())
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

# ═══════════════════════════════════════════════════════════════
# §6.5 Global Runtime State (Production-grade)
# ═══════════════════════════════════════════════════════════════

# In a production environment, the logger and clock would be injected by the runtime.
# This global state allows decoupled logging across the application.
mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

# ═══════════════════════════════════════════════════════════════
# §6.6 Internal
# ═══════════════════════════════════════════════════════════════

use std::time::{instant_now, duration_nanos}
use std::ctx

def _log_event(event: &Event) -> Unit
  let msg = match event
  when Event::KeyDown(k, m, r) then "KeyDown"
  when Event::KeyUp(k, m) then "KeyUp"
  when Event::TextInput(s) then "TextInput"
  when Event::ImeStart then "ImeStart"
  when Event::ImeUpdate(p, c) then "ImeUpdate"
  when Event::ImeEnd then "ImeEnd"
  when Event::MouseMove(x, y) then "MouseMove"
  when Event::MouseDown(b) then "MouseDown"
  when Event::MouseUp(b) then "MouseUp"
  when Event::Scroll(dx, dy, m) then "Scroll"
  when Event::DragEnter then "DragEnter"
  when Event::DragOver(x, y) then "DragOver"
  when Event::DragDrop(p) then "DragDrop"
  when Event::DragLeave then "DragLeave"
  when Event::Resize(w, h) then "Resize"
  when Event::FocusGained then "FocusGained"
  when Event::FocusLost then "FocusLost"
  when Event::CloseRequested then "CloseRequested"
  when Event::RedrawRequested then "RedrawRequested"
  end

  let entry = LogEntry {
    timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
    level: LogLevel::Trace,
    category: LogCategory::Events,
    message: msg,
    correlation_id: "".to_string()
  }
  
  match &GLOBAL_LOGGER
  when Some(logger) then logger.log(entry)
  when None then Unit
  end

  # Integrate with ctxpacks: generate a pack for critical events
  match event
  when Event::CloseRequested then
    let seeds = Vec::new()
    seeds.push("app::close_requested".to_string())
    match std::ctx::build_pack(seeds, 1000)
    when Ok(pack) then
      std::ctx::register_pack(pack)
    when Err(_) then {}
    end
  else {}
  end
end

struct SoftwareWindow
  win_id: WindowId
  title: String
  width: Int
  height: Int
  dpi_scale: Dpi
  event_queue: Vec[Event]
  closed: Bool
  clipboard: String
end

impl Window for SoftwareWindow
  def id(self: &Self) -> WindowId
    self.win_id
  end

  def size(self: &Self) -> (Int, Int)
    (self.width, self.height)
  end

  def dpi(self: &Self) -> Dpi
    self.dpi_scale
  end

  def set_title(self: &mut Self, title: String) -> Unit
    self.title = title
  end

  def request_redraw(self: &mut Self) -> Unit
    let ev = Event::RedrawRequested
    _log_event(&ev)
    self.event_queue.push(ev)
  end

  def poll_event(self: &mut Self) -> Option[Event]
    if self.event_queue.is_empty() then
      Option::None
    else
      let ev = self.event_queue.remove(0)
      _log_event(&ev)
      Option::Some(ev)
    end
  end

  def surface(self: &mut Self) -> Result[Box[Surface], AppError]
    # Surface creation delegated to tg::gfx module
    # Create a DisplayCap for this surface
    let display = DisplayCap { _opaque: 1 }
    match std::gfx::surface_offscreen(self.width, self.height, display)
    when Result::Ok(surface) then
      Result::Ok(surface)
    when Result::Err(e) then
      Result::Err(AppError::Internal(
        Error::internal("Failed to create surface: " + match e
          when GfxError::OutOfMemory(err) then err.message
          when GfxError::BackendLost(err) then err.message
          when GfxError::Unsupported(err) then err.message
          when GfxError::InvalidArg(err) then err.message
          when GfxError::Internal(err) then err.message
        end)
      ))
    end
  end

  def clipboard_set(self: &mut Self, caps: ClipboardCap, text: String) -> Result[Unit, AppError]
    # In this reference implementation, we store the clipboard text in the window state.
    # The ClipboardCap token is required by the trait but its value is opaque.
    self.clipboard = text
    Result::Ok(())
  end

  def clipboard_get(self: &mut Self, caps: ClipboardCap) -> Result[String, AppError]
    Result::Ok(self.clipboard.clone())
  end
end
