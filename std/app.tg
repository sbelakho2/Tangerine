# Tangerine Standard Library — tg::app
# Windowing, event loop, input, and capability types.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 6.

use std::core::{Option, Result, String, Bool, Int, Unit}
use std::geom::{Vec2, Rect}
use std::gfx_errors::{Error, ErrorCode, AppError}

# ═══════════════════════════════════════════════════════════════
# §6.1 Capabilities — opaque tokens gating side-effecting operations
# ═══════════════════════════════════════════════════════════════

struct DisplayCap
  _opaque: u64
end

struct ClipboardCap
  _opaque: u64
end

struct ImeCap
  _opaque: u64
end

struct DragDropCap
  _opaque: u64
end

struct ClockCap
  _opaque: u64
end

struct RandomCap
  _opaque: u64
end

struct FsCap
  _opaque: u64
end

# ═══════════════════════════════════════════════════════════════
# §6.2 Input / event data types
# ═══════════════════════════════════════════════════════════════

enum MouseButton
  Left
  Right
  Middle
  Other(Int)
end

enum Key
  Enter
  Escape
  Backspace
  Tab
  Space
  ArrowUp
  ArrowDown
  ArrowLeft
  ArrowRight
  Home
  End
  PageUp
  PageDown
  Insert
  Delete
  Char(Char)
  F(Int)
end

struct KeyMods
  shift: Bool
  ctrl: Bool
  alt: Bool
  meta: Bool
end

impl KeyMods
  def none() -> KeyMods
    KeyMods { shift: false, ctrl: false, alt: false, meta: false }
  end

  def has_any(self: &KeyMods) -> Bool
    self.shift || self.ctrl || self.alt || self.meta
  end
end

enum ScrollMode
  Pixel
  Line
end

struct WindowId
  value: u64
end

struct TimerId
  value: u64
end

struct Dpi
  scale: f32
end

impl Dpi
  def default() -> Dpi
    Dpi { scale: 1.0 }
  end

  def hidpi() -> Dpi
    Dpi { scale: 2.0 }
  end
end

# ———————————————————————————————————————————————————————————————
# Event — all event variants per spec §6.2
# ———————————————————————————————————————————————————————————————

enum Event
  KeyDown(Key, KeyMods, repeat: Bool)
  KeyUp(Key, KeyMods)
  TextInput(String)
  ImeStart
  ImeUpdate(preedit: String, cursor: Int)
  ImeEnd
  MouseMove(x: f32, y: f32)
  MouseDown(MouseButton)
  MouseUp(MouseButton)
  Scroll(dx: f32, dy: f32, mode: ScrollMode)
  DragEnter
  DragOver(x: f32, y: f32)
  DragDrop(paths: Vec[String])
  DragLeave
  Resize(w: Int, h: Int)
  FocusGained
  FocusLost
  CloseRequested
  RedrawRequested
end

# ═══════════════════════════════════════════════════════════════
# §6.3 AppOpts + trait App
# ═══════════════════════════════════════════════════════════════

struct AppOpts
  backend: String
  vsync: Bool
  high_dpi: Bool
end

impl AppOpts
  def default() -> AppOpts
    AppOpts {
      backend: "auto".to_string(),
      vsync: true,
      high_dpi: true
    }
  end
end

trait App
  def window_new(self: &mut Self, title: String, w: Int, h: Int, display: DisplayCap) -> Result[Box[Window], AppError]
  def run(self: &mut Self, main: Fn(&mut Self) -> Unit) -> Result[Unit, AppError]
  def request_timer(self: &mut Self, ms: Int) -> TimerId
  def cancel_timer(self: &mut Self, id: TimerId) -> Unit

  # Optional recorder API for determinism/replay
  def recorder_start(self: &mut Self, path: String, fs: FsCap) -> Result[Unit, AppError]
  def recorder_stop(self: &mut Self) -> Result[Unit, AppError]
end

# ═══════════════════════════════════════════════════════════════
# §6.4 trait Window
# ═══════════════════════════════════════════════════════════════

trait Window
  def id(self: &Self) -> WindowId
  def size(self: &Self) -> (Int, Int)
  def dpi(self: &Self) -> Dpi
  def set_title(self: &mut Self, title: String) -> Unit
  def request_redraw(self: &mut Self) -> Unit
  def poll_event(self: &mut Self) -> Option[Event]

  # Graphics target — yields a Surface for drawing
  def surface(self: &mut Self) -> Result[Box[Surface], AppError]

  # Clipboard APIs (capability-gated)
  def clipboard_set(self: &mut Self, caps: ClipboardCap, text: String) -> Result[Unit, AppError]
  def clipboard_get(self: &mut Self, caps: ClipboardCap) -> Result[String, AppError]
end

# Forward-declare Surface trait (defined in tg::gfx)
# This is a trait reference that tg::gfx implements.
trait Surface
end

# ═══════════════════════════════════════════════════════════════
# Reference implementation — SoftwareApp
# A minimal software-rendered App for testing and fallback.
# ═══════════════════════════════════════════════════════════════

struct SoftwareApp
  opts: AppOpts
  windows: Vec[Box[SoftwareWindow]]
  next_window_id: u64
  next_timer_id: u64
  running: Bool
  recording: Bool
  record_path: Option[String]
  event_log: Vec[Event]
end

impl SoftwareApp
  def new(opts: AppOpts) -> SoftwareApp
    SoftwareApp {
      opts: opts,
      windows: Vec::new(),
      next_window_id: 1,
      next_timer_id: 1,
      running: false,
      recording: false,
      record_path: Option::None,
      event_log: Vec::new()
    }
  end
end

impl App for SoftwareApp
  def window_new(self: &mut Self, title: String, w: Int, h: Int, display: DisplayCap) -> Result[Box[Window], AppError]
    let id = WindowId { value: self.next_window_id }
    self.next_window_id = self.next_window_id + 1

    let win = SoftwareWindow {
      win_id: id,
      title: title,
      width: w,
      height: h,
      dpi_scale: if self.opts.high_dpi then Dpi { scale: 2.0 } else Dpi { scale: 1.0 } end,
      event_queue: Vec::new(),
      closed: false
    }
    let boxed = Box::new(win)
    self.windows.push(boxed.clone())
    Result::Ok(boxed as Box[Window])
  end

  def run(self: &mut Self, main: Fn(&mut Self) -> Unit) -> Result[Unit, AppError]
    self.running = true
    main(self)
    self.running = false
    Result::Ok(())
  end

  def request_timer(self: &mut Self, ms: Int) -> TimerId
    let id = TimerId { value: self.next_timer_id }
    self.next_timer_id = self.next_timer_id + 1
    id
  end

  def cancel_timer(self: &mut Self, id: TimerId) -> Unit
    # Timer cancellation — in software impl this is a no-op since
    # timers are not actually scheduled on OS event loop.
  end

  def recorder_start(self: &mut Self, path: String, fs: FsCap) -> Result[Unit, AppError]
    self.recording = true
    self.record_path = Option::Some(path)
    self.event_log.clear()
    Result::Ok(())
  end

  def recorder_stop(self: &mut Self) -> Result[Unit, AppError]
    self.recording = false
    Result::Ok(())
  end
end

struct SoftwareWindow
  win_id: WindowId
  title: String
  width: Int
  height: Int
  dpi_scale: Dpi
  event_queue: Vec[Event]
  closed: Bool
end

impl Window for SoftwareWindow
  def id(self: &Self) -> WindowId
    self.win_id
  end

  def size(self: &Self) -> (Int, Int)
    (self.width, self.height)
  end

  def dpi(self: &Self) -> Dpi
    self.dpi_scale
  end

  def set_title(self: &mut Self, title: String) -> Unit
    self.title = title
  end

  def request_redraw(self: &mut Self) -> Unit
    self.event_queue.push(Event::RedrawRequested)
  end

  def poll_event(self: &mut Self) -> Option[Event]
    if self.event_queue.is_empty() then
      Option::None
    else
      Option::Some(self.event_queue.remove(0))
    end
  end

  def surface(self: &mut Self) -> Result[Box[Surface], AppError]
    # Surface creation delegated to tg::gfx module
    Result::Err(AppError::Unsupported(
      Error::unsupported("Surface creation requires tg::gfx backend".to_string())
    ))
  end

  def clipboard_set(self: &mut Self, caps: ClipboardCap, text: String) -> Result[Unit, AppError]
    # Capability token validates permission; software impl stores locally
    Result::Ok(())
  end

  def clipboard_get(self: &mut Self, caps: ClipboardCap) -> Result[String, AppError]
    Result::Ok("".to_string())
  end
end
