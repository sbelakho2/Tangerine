# Tangerine Standard Library — tg::gfx_gpu
# Tier C explicit GPU resource management API with Vulkan/Metal backends.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 8.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::geom::{Rect}
use std::gfx_errors::{Error, ErrorCode}
use std::app::{DisplayCap}
use std::ctx

# [METADATA]
# module: tg::gfx_gpu
# status: alpha
# effects: [Gfx]
# capabilities: [Display]
# error_codes: [OutOfMemory, DeviceLost, Unsupported, InvalidArg, Internal]

# ═══════════════════════════════════════════════════════════════
# §8.1 Handle / resource types
# ═══════════════════════════════════════════════════════════════

## GPU backend selection
enum GpuBackend
  Vulkan
  Metal
  D3D12
  Auto
end

struct Instance
  id: u64
  backend: GpuBackend
end

struct Adapter
  id: u64
  name: String
  vendor_id: u32
  device_id: u32
  device_type: GpuDeviceType
  backend: GpuBackend
end

enum GpuDeviceType
  DiscreteGpu
  IntegratedGpu
  VirtualGpu
  Cpu
end

struct Device
  id: u64
  backend: GpuBackend
  features: DeviceFeatures
end

struct DeviceFeatures
  texture_compression_bc: Bool
  texture_compression_astc: Bool
  shader_float64: Bool
  compute_shader: Bool
  ray_tracing: Bool
end

struct Queue
  id: u64
  queue_family: u32
  queue_index: u32
  backend: GpuBackend
end

struct Buffer
  id: u64
  size: Int
  backend: GpuBackend
  memory: GpuMemory
end

enum GpuMemory
  DeviceLocal
  HostVisible
  HostCoherent
  Managed
end

struct Texture
  id: u64
  width: Int
  height: Int
  depth: Int
  mip_levels: u32
  format: TextureFormat
  usage: TextureUsage
  backend: GpuBackend
end

enum TextureUsage
  Sampled
  Storage
  RenderTarget
  DepthStencil
  TransferSrc
  TransferDst
end

struct TextureView
  id: u64
  texture: &Texture
  format: TextureFormat
  aspect: TextureAspect
end

enum TextureAspect
  Color
  Depth
  Stencil
end

struct Sampler
  id: u64
  backend: GpuBackend
end

struct Pipeline
  id: u64
  pipeline_type: PipelineType
  backend: GpuBackend
end

enum PipelineType
  Graphics
  Compute
  RayTracing
end

struct ShaderModule
  id: u64
  backend: GpuBackend
  stage: ShaderStage
end

enum ShaderStage
  Vertex
  Fragment
  Compute
  Geometry
end

struct CommandEncoder
  id: u64
  backend: GpuBackend
  encoder_type: EncoderType
end

enum EncoderType
  Graphics
  Compute
  Transfer
end

struct CommandBuffer
  id: u64
  backend: GpuBackend
end

struct Framebuffer
  id: u64
  width: Int
  height: Int
  attachments: Vec[TextureView]
  backend: GpuBackend
end

struct RenderPass
  id: u64
  backend: GpuBackend
end

struct Swapchain
  id: u64
  width: Int
  height: Int
  format: TextureFormat
  present_mode: PresentMode
  backend: GpuBackend
end

struct SurfaceGpu
  id: u64
  backend: GpuBackend
end

struct Fence
  id: u64
  signaled: Bool
  backend: GpuBackend
end

struct Semaphore
  id: u64
  backend: GpuBackend
end

# ═══════════════════════════════════════════════════════════════
# §8.2 Enums / errors
# ═══════════════════════════════════════════════════════════════

enum PresentMode
  VSync
  Immediate
  Fifo
  Mailbox
end

enum BufferUsage
  Vertex
  Index
  Uniform
  Storage
  Indirect
  CopySrc
  CopyDst
end

enum TextureFormat
  RGBA8
  BGRA8
  RGBA16F
  RGBA32F
  R8
  RG8
  RGBA8Srgb
  BGRA8Srgb
  Depth16
  Depth24Stencil8
  Depth32F
  BC1Unorm
  BC3Unorm
  BC7Unorm
end

enum GpuError
  OutOfMemory(Error)
  DeviceLost(Error)
  Unsupported(Error)
  InvalidArg(Error)
  Internal(Error)
end

impl GpuError
  def message(self: &GpuError) -> &String
    match self
    when GpuError::OutOfMemory(e) then &e.message
    when GpuError::DeviceLost(e) then &e.message
    when GpuError::Unsupported(e) then &e.message
    when GpuError::InvalidArg(e) then &e.message
    when GpuError::Internal(e) then &e.message
    end
  end

  def code(self: &GpuError) -> ErrorCode
    match self
    when GpuError::OutOfMemory(_) then ErrorCode::OutOfMemory
    when GpuError::DeviceLost(_) then ErrorCode::BackendLost
    when GpuError::Unsupported(_) then ErrorCode::Unsupported
    when GpuError::InvalidArg(_) then ErrorCode::InvalidArg
    when GpuError::Internal(_) then ErrorCode::Internal
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Vulkan Backend FFI Bindings
# ═══════════════════════════════════════════════════════════════

## Vulkan FFI bindings for explicit GPU control
extern "C" do
  # Instance functions
  def vkEnumerateInstanceVersion(version: *mut u32) -> i32
  def vkEnumerateInstanceExtensionProperties(layer_name: *const u8, pPropertyCount: *mut u32, pProperties: *mut VkExtensionProperties) -> i32
  def vkCreateInstance(pCreateInfo: *const VkInstanceCreateInfo, pAllocator: *const VkAllocationCallbacks, pInstance: *mut u64) -> i32
  def vkDestroyInstance(instance: u64, pAllocator: *const VkAllocationCallbacks) -> i32
  def vkEnumeratePhysicalDevices(instance: u64, pPhysicalDeviceCount: *mut u32, pPhysicalDevices: *mut u64) -> i32
  def vkGetPhysicalDeviceProperties(physicalDevice: u64, pProperties: *mut VkPhysicalDeviceProperties) -> Unit
  def vkGetPhysicalDeviceFeatures(physicalDevice: u64, pFeatures: *mut VkPhysicalDeviceFeatures) -> Unit
  def vkGetPhysicalDeviceMemoryProperties(physicalDevice: u64, pMemoryProperties: *mut VkPhysicalDeviceMemoryProperties) -> Unit
  def vkGetPhysicalDeviceQueueFamilyProperties(physicalDevice: u64, pQueueFamilyPropertyCount: *mut u32, pQueueFamilyProperties: *mut VkQueueFamilyProperties) -> Unit
  
  # Device functions
  def vkCreateDevice(physicalDevice: u64, pCreateInfo: *const VkDeviceCreateInfo, pAllocator: *const VkAllocationCallbacks, pDevice: *mut u64) -> i32
  def vkDestroyDevice(device: u64, pAllocator: *const VkAllocationCallbacks) -> i32
  def vkGetDeviceQueue(device: u64, queueFamilyIndex: u32, queueIndex: u32, pQueue: *mut u64) -> Unit
  def vkDeviceWaitIdle(device: u64) -> i32
  
  # Buffer functions
  def vkCreateBuffer(device: u64, pCreateInfo: *const VkBufferCreateInfo, pAllocator: *const VkAllocationCallbacks, pBuffer: *mut u64) -> i32
  def vkDestroyBuffer(device: u64, buffer: u64, pAllocator: *const VkAllocationCallbacks) -> i32
  def vkGetBufferMemoryRequirements(device: u64, buffer: u64, pMemoryRequirements: *mut VkMemoryRequirements) -> Unit
  def vkBindBufferMemory(device: u64, buffer: u64, memory: u64, memoryOffset: u64) -> i32
  def vkMapMemory(device: u64, memory: u64, offset: u64, size: u64, flags: u32, ppData: *mut *mut u8) -> i32
  def vkUnmapMemory(device: u64, memory: u64) -> Unit
  def vkFlushMappedMemoryRanges(device: u64, memoryRangeCount: u32, pMemoryRanges: *const VkMappedMemoryRange) -> i32
  def vkInvalidateMappedMemoryRanges(device: u64, memoryRangeCount: u32, pMemoryRanges: *const VkMappedMemoryRange) -> i32
  
  # Memory functions
  def vkAllocateMemory(device: u64, pAllocateInfo: *const VkMemoryAllocateInfo, pAllocator: *const VkAllocationCallbacks, pMemory: *mut u64) -> i32
  def vkFreeMemory(device: u64, memory: u64, pAllocator: *const VkAllocationCallbacks) -> i32
  
  # Image functions
  def vkCreateImage(device: u64, pCreateInfo: *const VkImageCreateInfo, pAllocator: *const VkAllocationCallbacks, pImage: *mut u64) -> i32
  def vkDestroyImage(device: u64, image: u64, pAllocator: *const VkAllocationCallbacks) -> i32
  def vkGetImageMemoryRequirements(device: u64, image: u64, pMemoryRequirements: *mut VkMemoryRequirements) -> Unit
  def vkBindImageMemory(device: u64, image: u64, memory: u64, memoryOffset: u64) -> i32
  def vkCreateImageView(device: u64, pCreateInfo: *const VkImageViewCreateInfo, pAllocator: *const VkAllocationCallbacks, pView: *mut u64) -> i32
  def vkDestroyImageView(device: u64, imageView: u64, pAllocator: *const VkAllocationCallbacks) -> i32
  
  # Sampler functions
  def vkCreateSampler(device: u64, pCreateInfo: *const VkSamplerCreateInfo, pAllocator: *const VkAllocationCallbacks, pSampler: *mut u64) -> i32
  def vkDestroySampler(device: u64, sampler: u64, pAllocator: *const VkAllocationCallbacks) -> i32
  
  # Shader functions
  def vkCreateShaderModule(device: u64, pCreateInfo: *const VkShaderModuleCreateInfo, pAllocator: *const VkAllocationCallbacks, pShaderModule: *mut u64) -> i32
  def vkDestroyShaderModule(device: u64, shaderModule: u64, pAllocator: *const VkAllocationCallbacks) -> i32
  
  # Pipeline functions
  def vkCreateGraphicsPipelines(device: u64, pipelineCache: u64, createInfoCount: u32, pCreateInfos: *const VkGraphicsPipelineCreateInfo, pAllocator: *const VkAllocationCallbacks, pPipelines: *mut u64) -> i32
  def vkCreateComputePipelines(device: u64, pipelineCache: u64, createInfoCount: u32, pCreateInfos: *const VkComputePipelineCreateInfo, pAllocator: *const VkAllocationCallbacks, pPipelines: *mut u64) -> i32
  def vkDestroyPipeline(device: u64, pipeline: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  
  # Pipeline layout
  def vkCreatePipelineLayout(device: u64, pCreateInfo: *const VkPipelineLayoutCreateInfo, pAllocator: *const VkAllocationCallbacks, pPipelineLayout: *mut u64) -> i32
  def vkDestroyPipelineLayout(device: u64, pipelineLayout: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  
  # Descriptor set
  def vkCreateDescriptorSetLayout(device: u64, pCreateInfo: *const VkDescriptorSetLayoutCreateInfo, pAllocator: *const VkAllocationCallbacks, pDescriptorSetLayout: *mut u64) -> i32
  def vkDestroyDescriptorSetLayout(device: u64, descriptorSetLayout: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  def vkCreateDescriptorPool(device: u64, pCreateInfo: *const VkDescriptorPoolCreateInfo, pAllocator: *const VkAllocationCallbacks, pDescriptorPool: *mut u64) -> i32
  def vkDestroyDescriptorPool(device: u64, descriptorPool: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  def vkAllocateDescriptorSets(device: u64, pAllocateInfo: *const VkDescriptorSetAllocateInfo, pDescriptorSets: *mut u64) -> i32
  def vkFreeDescriptorSets(device: u64, descriptorPool: u64, descriptorSetCount: u32, pDescriptorSets: *mut u64) -> i32
  def vkUpdateDescriptorSets(device: u64, descriptorWriteCount: u32, pDescriptorWrites: *const VkWriteDescriptorSet, descriptorCopyCount: u32, pDescriptorCopies: *const VkCopyDescriptorSet) -> Unit
  
  # Command buffer functions
  def vkCreateCommandPool(device: u64, pCreateInfo: *const VkCommandPoolCreateInfo, pAllocator: *const VkAllocationCallbacks, pCommandPool: *mut u64) -> i32
  def vkDestroyCommandPool(device: u64, commandPool: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  def vkAllocateCommandBuffers(device: u64, pAllocateInfo: *const VkCommandBufferAllocateInfo, pCommandBuffers: *mut u64) -> i32
  def vkFreeCommandBuffers(device: u64, commandPool: u64, commandBufferCount: u32, pCommandBuffers: *mut u64) -> Unit
  def vkBeginCommandBuffer(commandBuffer: u64, pBeginInfo: *const VkCommandBufferBeginInfo) -> i32
  def vkEndCommandBuffer(commandBuffer: u64) -> i32
  def vkResetCommandBuffer(commandBuffer: u32, flags: u32) -> i32
  
  # Render pass
  def vkCreateRenderPass(device: u64, pCreateInfo: *const VkRenderPassCreateInfo, pAllocator: *const VkAllocationCallbacks, pRenderPass: *mut u64) -> i32
  def vkDestroyRenderPass(device: u64, renderPass: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  
  # Framebuffer
  def vkCreateFramebuffer(device: u64, pCreateInfo: *const VkFramebufferCreateInfo, pAllocator: *const VkAllocationCallbacks, pFramebuffer: *mut u64) -> i32
  def vkDestroyFramebuffer(device: u64, framebuffer: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  
  # Synchronization
  def vkCreateFence(device: u64, pCreateInfo: *const VkFenceCreateInfo, pAllocator: *const VkAllocationCallbacks, pFence: *mut u64) -> i32
  def vkDestroyFence(device: u64, fence: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  def vkWaitForFences(device: u64, fenceCount: u32, pFences: *mut u64, waitAll: Bool, timeout: u64) -> i32
  def vkResetFences(device: u64, fenceCount: u32, pFences: *mut u64) -> i32
  def vkCreateSemaphore(device: u64, pCreateInfo: *const VkSemaphoreCreateInfo, pAllocator: *const VkAllocationCallbacks, pSemaphore: *mut u64) -> i32
  def vkDestroySemaphore(device: u64, semaphore: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  
  # Queue submission
  def vkQueueSubmit(queue: u64, submitCount: u32, pSubmits: *const VkSubmitInfo, fence: u64) -> i32
  def vkQueueWaitIdle(queue: u64) -> i32
  def vkQueuePresentKHR(queue: u64, pPresentInfo: *const VkPresentInfoKHR) -> i32
  
  # Swapchain
  def vkCreateSwapchainKHR(device: u64, pCreateInfo: *const VkSwapchainCreateInfoKHR, pAllocator: *const VkAllocationCallbacks, pSwapchain: *mut u64) -> i32
  def vkDestroySwapchainKHR(device: u64, swapchain: u64, pAllocator: *const VkAllocationCallbacks) -> Unit
  def vkGetSwapchainImagesKHR(device: u64, swapchain: u64, pSwapchainImageCount: *mut u32, pSwapchainImages: *mut u64) -> i32
  def vkAcquireNextImageKHR(device: u64, swapchain: u64, timeout: u64, semaphore: u64, fence: u64, pImageIndex: *mut u32) -> i32
end

# Vulkan constants
const VK_SUCCESS: i32 = 0
const VK_NOT_READY: i32 = 1
const VK_TIMEOUT: i32 = 2
const VK_ERROR_OUT_OF_DEVICE_MEMORY: i32 = -1
const VK_ERROR_OUT_OF_HOST_MEMORY: i32 = -2
const VK_ERROR_DEVICE_LOST: i32 = -4
const VK_ERROR_EXTENSION_NOT_PRESENT: i32 = -7

const VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO: u32 = 0
const VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO: u32 = 5
const VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO: u32 = 6
const VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO: u32 = 17
const VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO: u32 = 14
const VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO: u32 = 15
const VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO: u32 = 16
const VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO: u32 = 19
const VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO: u32 = 30
const VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO: u32 = 49
const VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO: u32 = 50

# Vulkan structures (simplified)
struct VkInstanceCreateInfo
  sType: u32
  pNext: *const u8
  flags: u32
  pApplicationInfo: *const VkApplicationInfo
  enabledLayerCount: u32
  ppEnabledLayerNames: *const *const u8
  enabledExtensionCount: u32
