  def MTLDevice_newRenderPipelineStateWithDescriptor(device: *mut u8, descriptor: *mut u8, error: *mut *mut u8) -> *mut u8
  def MTLDevice_newComputePipelineStateWithFunction(device: *mut u8, function: *mut u8, error: *mut *mut u8) -> *mut u8
  def MTLDevice_newDepthStencilStateWithDescriptor(device: *mut u8, descriptor: *mut u8) -> *mut u8
