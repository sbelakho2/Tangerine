struct SurfaceGpu
  id: u64
end

# ═══════════════════════════════════════════════════════════════
# §8.2 Enums / errors
# ═══════════════════════════════════════════════════════════════

enum PresentMode
  VSync
  Immediate
end

enum BufferUsage
  Vertex
  Index
  Uniform
  Storage
  CopySrc
  CopyDst
end

enum TextureFormat
  RGBA8
  BGRA8
  RGBA16F
end

enum GpuError
  OutOfMemory(Error)
  DeviceLost(Error)
  Unsupported(Error)
  InvalidArg(Error)
  Internal(Error)
end

impl GpuError
  def message(self: &GpuError) -> &String
    match self
    when GpuError::OutOfMemory(e) then &e.message
    when GpuError::DeviceLost(e) then &e.message
    when GpuError::Unsupported(e) then &e.message
    when GpuError::InvalidArg(e) then &e.message
    when GpuError::Internal(e) then &e.message
    end
  end

  def code(self: &GpuError) -> ErrorCode
    match self
    when GpuError::OutOfMemory(_) then ErrorCode::OutOfMemory
    when GpuError::DeviceLost(_) then ErrorCode::BackendLost
    when GpuError::Unsupported(_) then ErrorCode::Unsupported
    when GpuError::InvalidArg(_) then ErrorCode::InvalidArg
    when GpuError::Internal(_) then ErrorCode::Internal
    end
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}
use std::time::{instant_now, duration_nanos}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_gpu_event(level: LogLevel, msg: String) -> Unit
  match &GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::Gfx,
      message: "[GPU] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then {}
  end
end

# ═══════════════════════════════════════════════════════════════
# §8.3 Module API
# ═══════════════════════════════════════════════════════════════

mut NEXT_HANDLE_ID: u64 = 1u64

def instance_new() -> Result[Instance, GpuError]
  # Create a GPU instance. Production: probes for Vulkan/Metal/D3D12 via platform bridge.
  __intrinsic_gpu_instance_new()
end

def instance_adapters(i: &Instance) -> Vec[Adapter]
  # Enumerate physical adapters. Production: vkEnumeratePhysicalDevices, etc.
  __intrinsic_gpu_instance_adapters(i)
end

def adapter_request_device(a: &Adapter) -> Result[(Device, Queue), GpuError]
  # Create logical device. Production: vkCreateDevice, etc.
  __intrinsic_gpu_adapter_request_device(a)
end

def buffer_create(dev: &Device, size: Int, usage: Vec[BufferUsage]) -> Result[Buffer, GpuError]
  # Create GPU buffer. Production: vkCreateBuffer + VMA allocation.
  __intrinsic_gpu_buffer_create(dev, size, usage)
end

def texture_create(dev: &Device, w: Int, h: Int, fmt: TextureFormat) -> Result[Texture, GpuError]
  # Create GPU texture. Production: vkCreateImage + VMA allocation.
  __intrinsic_gpu_texture_create(dev, w, h, fmt)
end

def texture_view(tex: &Texture) -> Result[TextureView, GpuError]
  let id = NEXT_HANDLE_ID
  NEXT_HANDLE_ID = NEXT_HANDLE_ID + 1u64
  Result::Ok(TextureView { id: id })
end

def encoder_begin(dev: &Device) -> Result[CommandEncoder, GpuError]
  let id = NEXT_HANDLE_ID
  NEXT_HANDLE_ID = NEXT_HANDLE_ID + 1u64
  Result::Ok(CommandEncoder { id: id })
end

def encoder_finish(enc: CommandEncoder) -> Result[CommandBuffer, GpuError]
  let id = NEXT_HANDLE_ID
  NEXT_HANDLE_ID = NEXT_HANDLE_ID + 1u64
  Result::Ok(CommandBuffer { id: id })
end

def queue_submit(q: &Queue, cmds: Vec[CommandBuffer]) -> Result[Unit, GpuError]
  _log_gpu_event(LogLevel::Trace, "Gpu Commands submitted to queue " + q.id.fmt())
  Result::Ok(())
end
