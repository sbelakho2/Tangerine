  def MTLBlitCommandEncoder_copyFromBufferToTexture(encoder: *mut u8, sourceBuffer: *mut u8, sourceOffset: u64, sourceBytesPerRow: u64, sourceBytesPerImage: u64, sourceSize: MTLSize, destinationTexture: *mut u8, destinationSlice: u64, destinationLevel: u64, destinationOrigin: MTLOrigin)
  def MTLBlitCommandEncoder_endEncoding(encoder: *mut u8)
  
  # Render Command Encoder
