# Tangerine Standard Library — tg::gfx_gpu
# Tier C explicit GPU resource management API.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 8.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::geom::{Rect}
use std::gfx_errors::{Error, ErrorCode}
use std::app::{DisplayCap}
use std::ctx

# [METADATA]
# module: tg::gfx_gpu
# status: alpha
# effects: [Gfx]
# capabilities: [Display]
# error_codes: [OutOfMemory, DeviceLost, Unsupported, InvalidArg, Internal]

# ═══════════════════════════════════════════════════════════════
# §8.1 Handle / resource types
# ═══════════════════════════════════════════════════════════════

struct Instance
  id: u64
end

struct Adapter
  id: u64
  name: String
end

struct Device
  id: u64
end

struct Queue
  id: u64
end

struct Buffer
  id: u64
  size: Int
end

struct Texture
  id: u64
  width: Int
  height: Int
end

struct TextureView
  id: u64
end

struct CommandEncoder
  id: u64
end

struct CommandBuffer
  id: u64
end

struct Swapchain
  id: u64
