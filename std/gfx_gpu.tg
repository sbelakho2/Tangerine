def shader_from_wgsl(dev: &Device, src: String) -> Result[ShaderModule, GpuError]
  # WGSL is the baseline shader language for v0.1.
  Result::Err(GpuError::Unsupported(
    Error::unsupported("Shader compilation requires active GPU backend.".to_string())
