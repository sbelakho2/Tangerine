# Tangerine Standard Library — tg::gfx::gpu
# Tier C explicit GPU resource management API.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 8.

use std::core::{Option, Result, String, Bool, Int, Unit}
use std::geom::{Rect}
use std::gfx_errors::{Error, ErrorCode}
use std::app::{DisplayCap}

# ═══════════════════════════════════════════════════════════════
# §8.1 Handle / resource types — all opaque
# ═══════════════════════════════════════════════════════════════

struct Instance
  _opaque: u64
end

struct Adapter
  _opaque: u64
end

struct Device
  _opaque: u64
end

struct Queue
  _opaque: u64
end

struct Buffer
  _opaque: u64
end

struct Texture
  _opaque: u64
end

struct TextureView
  _opaque: u64
end

struct Sampler
  _opaque: u64
end

struct ShaderModule
  _opaque: u64
end

struct CommandEncoder
  _opaque: u64
end

struct CommandBuffer
  _opaque: u64
end

struct RenderPipeline
  _opaque: u64
end

struct BindGroupLayout
  _opaque: u64
end

struct BindGroup
  _opaque: u64
end

struct SurfaceGpu
  _opaque: u64
end

struct Swapchain
  _opaque: u64
end

# ═══════════════════════════════════════════════════════════════
# §8.2 Enums / errors
# ═══════════════════════════════════════════════════════════════

enum PresentMode
  VSync
  Immediate
end

enum BufferUsage
  Vertex
  Index
  Uniform
  Storage
  CopySrc
  CopyDst
end

enum TextureFormat
  RGBA8
  BGRA8
  RGBA16F
end

enum ShaderStage
  Vertex
  Fragment
  Compute
end

enum GpuError
  OutOfMemory(Error)
  DeviceLost(Error)
  Unsupported(Error)
  InvalidArg(Error)
  Internal(Error)
end

impl GpuError
  def message(self: &GpuError) -> &String
    match self
    when GpuError::OutOfMemory(e) then &e.message
    when GpuError::DeviceLost(e) then &e.message
    when GpuError::Unsupported(e) then &e.message
    when GpuError::InvalidArg(e) then &e.message
    when GpuError::Internal(e) then &e.message
    end
  end

  def code(self: &GpuError) -> ErrorCode
    match self
    when GpuError::OutOfMemory(_) then ErrorCode::OutOfMemory
    when GpuError::DeviceLost(_) then ErrorCode::BackendLost
    when GpuError::Unsupported(_) then ErrorCode::Unsupported
    when GpuError::InvalidArg(_) then ErrorCode::InvalidArg
    when GpuError::Internal(_) then ErrorCode::Internal
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# §8.3 Module API
# ═══════════════════════════════════════════════════════════════

def instance_new() -> Result[Instance, GpuError]
  # Create a GPU instance. Dispatches to backend GPU interface.
  # Returns Unsupported if no GPU backend is available.
  Result::Err(GpuError::Unsupported(
    Error::unsupported("No GPU backend loaded. Tier C requires tg.gpu.v1 interface.".to_string())
  ))
end

def instance_adapters(i: &Instance) -> Vec[Adapter]
  # Enumerate available GPU adapters (physical devices).
  Vec::new()
end

def adapter_request_device(a: &Adapter) -> Result[(Device, Queue), GpuError]
  Result::Err(GpuError::Unsupported(
    Error::unsupported("GPU device creation requires active GPU backend.".to_string())
  ))
end

def surface_from_window(i: &Instance, w: &std::app::Window) -> Result[SurfaceGpu, GpuError]
  Result::Err(GpuError::Unsupported(
    Error::unsupported("GPU surface requires active GPU backend.".to_string())
  ))
end

def swapchain_create(dev: &Device, surf: &SurfaceGpu, fmt: TextureFormat, mode: PresentMode) -> Result[Swapchain, GpuError]
  Result::Err(GpuError::Unsupported(
    Error::unsupported("Swapchain creation requires active GPU backend.".to_string())
  ))
end

