def encoder_begin(dev: &Device) -> Result[CommandEncoder, GpuError]
  let id = NEXT_HANDLE_ID
  NEXT_HANDLE_ID = NEXT_HANDLE_ID + 1u64
  
  Result::Ok(CommandEncoder {
    id: id,
    backend: dev.backend,
    encoder_type: EncoderType::Graphics,
  })
end

def encoder_finish(enc: CommandEncoder) -> Result[CommandBuffer, GpuError]
  let id = NEXT_HANDLE_ID
  NEXT_HANDLE_ID = NEXT_HANDLE_ID + 1u64
  
  Result::Ok(CommandBuffer {
    id: id,
    backend: enc.backend,
  })
end

# ═══════════════════════════════════════════════════════════════
# Queue Operations
# ═══════════════════════════════════════════════════════════════

def queue_submit(q: &Queue, cmds: Vec[CommandBuffer]) -> Result[Unit, GpuError]
  _log_gpu_event(LogLevel::Trace, "Submitting ".to_string() + cmds.len().to_string() + " commands")
  
  match q.backend
  when GpuBackend::Vulkan then
    _vulkan_queue_submit(q.id, cmds)
  when GpuBackend::Metal then
    Result::Ok(())
  when _ then
    Result::Err(GpuError::Unsupported(Error::unsupported("Unsupported backend".to_string())))
  end
end

def _vulkan_queue_submit(queue: u64, cmds: Vec[CommandBuffer]) -> Result[Unit, GpuError]
  # Simplified queue submission
  _log_gpu_event(LogLevel::Trace, "Vulkan queue submit")
  Result::Ok(())
end

# ═══════════════════════════════════════════════════════════════
# Synchronization Primitives
# ═══════════════════════════════════════════════════════════════

def fence_create(device: &Device, signaled: Bool) -> Result[Fence, GpuError]
  let id = NEXT_HANDLE_ID
  NEXT_HANDLE_ID = NEXT_HANDLE_ID + 1u64
  
  Result::Ok(Fence {
    id: id,
    signaled: signaled,
    backend: device.backend,
  })
end

def fence_wait(fence: &Fence, timeout_ns: u64) -> Result[Bool, GpuError]
  match fence.backend
  when GpuBackend::Vulkan then
    _vulkan_wait_for_fence(fence.id, timeout_ns)
  when _ then
    Result::Ok(true)
  end
end

def _vulkan_wait_for_fence(fence: u64, timeout: u64) -> Result[Bool, GpuError]
  # Would wait for fence here
  Result::Ok(true)
end

def semaphore_create(device: &Device) -> Result[Semaphore, GpuError]
  let id = NEXT_HANDLE_ID
  NEXT_HANDLE_ID = NEXT_HANDLE_ID + 1u64
  
  Result::Ok(Semaphore {
    id: id,
    backend: device.backend,
  })
end

# ═══════════════════════════════════════════════════════════════
# Swapchain
# ═══════════════════════════════════════════════════════════════

def swapchain_create(
  device: &Device,
  queue: &Queue,
  surface: &SurfaceGpu,
  width: Int,
  height: Int,
  fmt: TextureFormat,
  mode: PresentMode
) -> Result[Swapchain, GpuError]
  match device.backend
  when GpuBackend::Vulkan then
    _vulkan_create_swapchain(device.id, queue.id, width, height, fmt, mode)
  when GpuBackend::Metal then
    _metal_create_swapchain(width, height, fmt)
  when _ then
    Result::Err(GpuError::Unsupported(Error::unsupported("Unsupported backend".to_string())))
  end
end

def _vulkan_create_swapchain(device: u64, queue: u64, w: Int, h: Int, fmt: TextureFormat, mode: PresentMode) -> Result[Swapchain, GpuError]
  let id = NEXT_HANDLE_ID
  NEXT_HANDLE_ID = NEXT_HANDLE_ID + 1u64
  
  let present_mode = match mode
  when PresentMode::VSync then 1  # VK_PRESENT_MODE_FIFO_KHR
  when PresentMode::Immediate then 0  # VK_PRESENT_MODE_IMMEDIATE_KHR
  when PresentMode::Fifo then 1
  when PresentMode::Mailbox then 2  # VK_PRESENT_MODE_MAILBOX_KHR
  else 1
  end
  
  _log_gpu_event(LogLevel::Info, "Created Vulkan swapchain ".to_string() + w.to_string() + "x" + h.to_string())
  
  Result::Ok(Swapchain {
    id: id,
    width: w,
    height: h,
    format: fmt,
    present_mode: mode,
    backend: GpuBackend::Vulkan,
  })
end

def _metal_create_swapchain(w: Int, h: Int, fmt: TextureFormat) -> Result[Swapchain, GpuError]
  let id = NEXT_HANDLE_ID
  NEXT_HANDLE_ID = NEXT_HANDLE_ID + 1u64
  
  Result::Ok(Swapchain {
    id: id,
    width: w,
    height: h,
    format: fmt,
    present_mode: PresentMode::VSync,
    backend: GpuBackend::Metal,
  })
end

def swapchain_acquire_next(swapchain: &Swapchain, semaphore: &Semaphore, timeout_ns: u64) -> Result[u32, GpuError]
  # Would acquire next image
  Result::Ok(0)
end

def swapchain_present(swapchain: &Swapchain, queue: &Queue, image_index: u32, semaphores: Vec[Semaphore]) -> Result[Unit, GpuError]
  _log_gpu_event(LogLevel::Trace, "Presenting swapchain image ".to_string() + image_index.to_string())
  Result::Ok(())
end
