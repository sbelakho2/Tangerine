# ═══════════════════════════════════════════════════════════════════════
# §5  Shader Compilation & SPIR-V Pipeline
# ═══════════════════════════════════════════════════════════════════════

pub enum ShaderStage
  Vertex
  Fragment
  Compute
  Geometry
  TessControl
  TessEval
  Mesh
  Task
  RayGen
  RayMiss
  RayClosestHit
  RayAnyHit
  RayIntersect
end

pub enum ShaderSource
  SpirV(Vec[u32])          ## Pre-compiled SPIR-V bytecode
  Glsl(String, ShaderStage)## GLSL source + stage
  Hlsl(String, ShaderStage)## HLSL source + stage
  Msl(String)              ## Metal Shading Language source
  Wgsl(String)             ## WGSL source (WebGPU)
  TgShader(String)         ## Tangerine shader language (auto-transpile)
end

pub struct ShaderModuleDescriptor
  pub source: ShaderSource
  pub entry_point: String
  pub label: Option[String]
end

pub struct ShaderModule
  _backend: Backend
  _handle: u64
  _stage: ShaderStage
  _entry_point: String
end

## Compile a shader module.
pub def create_shader_module(device: &GpuDevice, desc: &ShaderModuleDescriptor) -> Result[ShaderModule, GpuError]
  ## Cross-compile source to backend-native format:
  ##   - Vulkan: SPIR-V (pass through or compile from GLSL/HLSL)
  ##   - Metal: MSL (transpile from SPIR-V via SPIRV-Cross)
  ##   - DirectX12: DXIL (compile from HLSL or transpile)
  ##   - OpenGL: GLSL (transpile from SPIR-V)
  ##   - WebGPU: WGSL (transpile from SPIR-V)
  let stage = match &desc.source
  when ShaderSource.Glsl(_, stage) then stage.clone()
  when ShaderSource.Hlsl(_, stage) then stage.clone()
  when _ then ShaderStage.Vertex
  end
  let handle = _backend_create_shader(device._backend, device._handle, desc)?
  Ok(ShaderModule {
    _backend: device._backend,
    _handle: handle,
    _stage: stage,
    _entry_point: desc.entry_point.clone(),
  })
end

## SPIR-V utilities.
pub mod spirv
  ## Compile GLSL to SPIR-V bytecode.
  pub def compile_glsl(source: &String, stage: ShaderStage) -> Result[Vec[u32], GpuError]
    _spirv_compile_glsl(source, stage)
  end

  ## Compile HLSL to SPIR-V bytecode.
  pub def compile_hlsl(source: &String, stage: ShaderStage, entry: &String) -> Result[Vec[u32], GpuError]
    _spirv_compile_hlsl(source, stage, entry)
  end

  ## Transpile SPIR-V to GLSL.
  pub def to_glsl(spirv: &[u32], version: u32) -> Result[String, GpuError]
    _spirv_cross_to_glsl(spirv, version)
  end

  ## Transpile SPIR-V to MSL (Metal).
  pub def to_msl(spirv: &[u32]) -> Result[String, GpuError]
    _spirv_cross_to_msl(spirv)
  end

  ## Transpile SPIR-V to HLSL.
  pub def to_hlsl(spirv: &[u32], model: u32) -> Result[String, GpuError]
    _spirv_cross_to_hlsl(spirv, model)
  end

  ## Transpile SPIR-V to WGSL.
  pub def to_wgsl(spirv: &[u32]) -> Result[String, GpuError]
    _spirv_cross_to_wgsl(spirv)
  end

  ## Validate SPIR-V bytecode.
  pub def validate(spirv: &[u32]) -> Result[Unit, GpuError]
    _spirv_validate(spirv)
  end

  ## Reflect SPIR-V module to extract binding information.
  pub def reflect(spirv: &[u32]) -> Result[ShaderReflection, GpuError]
    _spirv_reflect(spirv)
  end
end

