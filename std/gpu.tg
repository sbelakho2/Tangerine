  match dynload::load_library(&dynload::library_name(&"cudart".to_string()))
  when Result::Ok(_) then return true
  when Result::Err(_) then return false
  end
end

@ffi("cudart")
extern def cudaGetDeviceCount(count: PtrMut[Int]) -> Int
end

@ffi("cudart")
extern def cudaGetDeviceProperties(prop: Ptr, device: Int) -> Int
end

@ffi("cudart")
extern def cudaSetDevice(device: Int) -> Int
end

@ffi("cudart")
extern def cudaMalloc(ptr: PtrMut[Ptr], size: UInt) -> Int
end

@ffi("cudart")
extern def cudaFree(ptr: Ptr) -> Int
end

