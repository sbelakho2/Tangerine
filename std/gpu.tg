def enumerate_opencl_devices() -> Vec[GpuDevice]
  var devices = Vec::new()
  
  # Get platforms
  var num_platforms: UInt = 0
  let result = clGetPlatformIDs(0, Ptr::null(), &mut num_platforms as PtrMut[UInt])
  if result != 0 || num_platforms == 0 then return devices end
  
  var platforms: Vec[Ptr] = Vec::with_capacity(num_platforms as Int)
  platforms.resize(num_platforms as Int, Ptr::null())
  
  let _ = clGetPlatformIDs(num_platforms, platforms.as_mut_ptr(), &mut num_platforms as PtrMut[UInt])
  
  # Get GPU devices from each platform
  var device_id = 0
  for platform in platforms do
    var num_devices: UInt = 0
    let result = clGetDeviceIDs(platform, 2, 0, Ptr::null(), &mut num_devices as PtrMut[UInt])  # CL_DEVICE_TYPE_GPU = 2
    if result != 0 || num_devices == 0 then continue end
    
    var cl_devices: Vec[Ptr] = Vec::with_capacity(num_devices as Int)
    cl_devices.resize(num_devices as Int, Ptr::null())
    
    let _ = clGetDeviceIDs(platform, 2, num_devices, cl_devices.as_mut_ptr(), &mut num_devices as PtrMut[UInt])
    
    for cl_device in cl_devices do
      let device = get_opencl_device_info(device_id, cl_device)
      devices.push(device)
      device_id = device_id + 1
    end
  end
  
  devices
end

def get_opencl_device_info(device_id: Int, cl_device: Ptr) -> GpuDevice
  # Query device properties using clGetDeviceInfo
  # Simplified implementation
  
  var name_buf: [u8; 256] = [0; 256]
  var name_size: UInt = 0
  let _ = clGetDeviceInfo(cl_device, 0x102B, 256, name_buf.as_mut_ptr() as Ptr, &mut name_size as PtrMut[UInt])  # CL_DEVICE_NAME
  
  var name_str = String::new()
  for i in 0..name_size as Int do
    if name_buf[i] == 0 then break end
    name_str = name_str + (name_buf[i] as Char).to_string()
  end
  
  var global_mem: UInt = 0
  let _ = clGetDeviceInfo(cl_device, 0x101F, 8, &mut global_mem as Ptr, Ptr::null())  # CL_DEVICE_GLOBAL_MEM_SIZE
  
  var max_wg_size: Int = 0
  let _ = clGetDeviceInfo(cl_device, 0x1018, 4, &mut max_wg_size as Ptr, Ptr::null())  # CL_DEVICE_MAX_WORK_GROUP_SIZE
  
  var compute_units: Int = 0
  let _ = clGetDeviceInfo(cl_device, 0x1012, 4, &mut compute_units as Ptr, Ptr::null())  # CL_DEVICE_MAX_COMPUTE_UNITS
  
  var vendor_id: UInt = 0
  let _ = clGetDeviceInfo(cl_device, 0x1001, 4, &mut vendor_id as Ptr, Ptr::null())  # CL_DEVICE_VENDOR_ID
  
  GpuDevice {
    id: device_id,
    name: name_str,
    vendor: parse_vulkan_vendor(vendor_id),
    backend: GpuBackend::OpenCL,
    total_memory: global_mem,
    available_memory: global_mem,
    compute_units: compute_units,
    max_work_group_size: max_wg_size,
    max_work_group_dims: [max_wg_size, max_wg_size, max_wg_size],
    clock_frequency: 0,
    supports_fp16: false,
    supports_fp64: true,
    supports_int64: true,
    supports_subgroups: false,
    subgroup_size: 32,
    unified_memory: false
  }
end

# ═══════════════════════════════════════════════════════════════
# GPU Context Management
# ═══════════════════════════════════════════════════════════════

def create_gpu_context(device: GpuDevice) -> Result[GpuContext, GpuError]
  match device.backend
  when GpuBackend::Vulkan then create_vulkan_context(device)
  when GpuBackend::Metal then create_metal_context(device)
  when GpuBackend::CUDA then create_cuda_context(device)
  when GpuBackend::OpenCL then create_opencl_context(device)
  else Result::Err(GpuError::UnsupportedBackend(device.backend))
  end
end

@cfg(any(target_os = "linux", target_os = "windows", target_os = "android"))
def create_vulkan_context(device: GpuDevice) -> Result[GpuContext, GpuError]
  # Create Vulkan device and queues
  Result::Ok(GpuContext {
    backend: GpuBackend::Vulkan,
    device: device.clone(),
    buffers: Map::new(),
    images: Map::new(),
    samplers: Map::new(),
    pipelines: Map::new(),
    command_buffers: Map::new(),
    next_id: 0,
    vulkan_instance: Option::Some(Ptr::null()),
    vulkan_device: Option::Some(Ptr::null()),
    metal_device: Option::None,
    cuda_context: Option::None,
    opencl_context: Option::None
  })
end

@cfg(not(any(target_os = "linux", target_os = "windows", target_os = "android")))
def create_vulkan_context(device: GpuDevice) -> Result[GpuContext, GpuError]
  Result::Err(GpuError::UnsupportedBackend(GpuBackend::Vulkan))
end

@cfg(any(target_os = "macos", target_os = "ios"))
def create_metal_context(device: GpuDevice) -> Result[GpuContext, GpuError]
  let mtl_device = metal_create_default_device()
  if mtl_device.is_null() then
    return Result::Err(GpuError::NoDevice)
  end
  
  Result::Ok(GpuContext {
    backend: GpuBackend::Metal,
    device: device.clone(),
    buffers: Map::new(),
    images: Map::new(),
    samplers: Map::new(),
    pipelines: Map::new(),
    command_buffers: Map::new(),
    next_id: 0,
    vulkan_instance: Option::None,
    vulkan_device: Option::None,
    metal_device: Option::Some(mtl_device),
    cuda_context: Option::None,
    opencl_context: Option::None
  })
end

@cfg(not(any(target_os = "macos", target_os = "ios")))
def create_metal_context(device: GpuDevice) -> Result[GpuContext, GpuError]
  Result::Err(GpuError::UnsupportedBackend(GpuBackend::Metal))
end

def create_cuda_context(device: GpuDevice) -> Result[GpuContext, GpuError]
  let result = cudaSetDevice(device.id)
  if result != 0 then
    return Result::Err(GpuError::PlatformError("failed to set CUDA device"))
  end
  
  Result::Ok(GpuContext {
    backend: GpuBackend::CUDA,
    device: device.clone(),
    buffers: Map::new(),
    images: Map::new(),
    samplers: Map::new(),
    pipelines: Map::new(),
    command_buffers: Map::new(),
    next_id: 0,
    vulkan_instance: Option::None,
    vulkan_device: Option::None,
    metal_device: Option::None,
    cuda_context: Option::Some(Ptr::null()),
    opencl_context: Option::None
  })
end

def create_opencl_context(device: GpuDevice) -> Result[GpuContext, GpuError]
  Result::Ok(GpuContext {
    backend: GpuBackend::OpenCL,
    device: device.clone(),
    buffers: Map::new(),
    images: Map::new(),
    samplers: Map::new(),
    pipelines: Map::new(),
    command_buffers: Map::new(),
    next_id: 0,
    vulkan_instance: Option::None,
    vulkan_device: Option::None,
    metal_device: Option::None,
    cuda_context: Option::None,
    opencl_context: Option::Some(Ptr::null())
  })
end

def destroy_gpu_context(ctx: GpuContext) -> Unit
  # Free all resources
  for (_, buffer) in ctx.buffers do
    destroy_buffer(ctx, buffer)
  end
  
  for (_, image) in ctx.images do
    destroy_image(ctx, image)
  end
  
  for (_, sampler) in ctx.samplers do
    destroy_sampler(ctx, sampler)
  end
  
  for (_, pipeline) in ctx.pipelines do
    destroy_pipeline(ctx, pipeline)
  end
  
  # Destroy backend-specific context
  match ctx.backend
  when GpuBackend::Vulkan then
    match ctx.vulkan_device
    when Option::Some(device) then vkDestroyDevice(device, Ptr::null())
    when Option::None then ()
    end
    match ctx.vulkan_instance
    when Option::Some(instance) then vkDestroyInstance(instance, Ptr::null())
    when Option::None then ()
    end
  else ()
  end
end

# ═══════════════════════════════════════════════════════════════
# Buffer Management
# ═══════════════════════════════════════════════════════════════

def create_buffer(inout ctx: GpuContext, desc: BufferDesc) -> Result[GpuBuffer, GpuError]
  let id = ctx.next_id
  ctx.next_id = ctx.next_id + 1
  
  match ctx.backend
  when GpuBackend::Vulkan then create_vulkan_buffer(ctx, id, desc)
  when GpuBackend::Metal then create_metal_buffer(ctx, id, desc)
  when GpuBackend::CUDA then create_cuda_buffer(ctx, id, desc)
  when GpuBackend::OpenCL then create_opencl_buffer(ctx, id, desc)
  else Result::Err(GpuError::UnsupportedBackend(ctx.backend))
  end
end

@cfg(any(target_os = "linux", target_os = "windows", target_os = "android"))
def create_vulkan_buffer(inout ctx: GpuContext, id: Int, desc: BufferDesc) -> Result[GpuBuffer, GpuError]
  let buffer = GpuBuffer {
    id: id,
    device: ctx.device.id,
    size: desc.size,
    usage: desc.usage,
    location: desc.location,
    mapped_ptr: Option::None
  }
  
  # Create Vulkan buffer using vkCreateBuffer, vkAllocateMemory, vkBindBufferMemory
  ctx.buffers.insert(id, buffer.clone())
  Result::Ok(buffer)
end

@cfg(not(any(target_os = "linux", target_os = "windows", target_os = "android")))
def create_vulkan_buffer(inout ctx: GpuContext, id: Int, desc: BufferDesc) -> Result[GpuBuffer, GpuError]
  Result::Err(GpuError::UnsupportedBackend(GpuBackend::Vulkan))
end

@cfg(any(target_os = "macos", target_os = "ios"))
def create_metal_buffer(inout ctx: GpuContext, id: Int, desc: BufferDesc) -> Result[GpuBuffer, GpuError]
  let buffer = GpuBuffer {
    id: id,
    device: ctx.device.id,
    size: desc.size,
    usage: desc.usage,
    location: desc.location,
    mapped_ptr: Option::None
  }
  
  ctx.buffers.insert(id, buffer.clone())
  Result::Ok(buffer)
end

@cfg(not(any(target_os = "macos", target_os = "ios")))
def create_metal_buffer(inout ctx: GpuContext, id: Int, desc: BufferDesc) -> Result[GpuBuffer, GpuError]
  Result::Err(GpuError::UnsupportedBackend(GpuBackend::Metal))
end

def create_cuda_buffer(inout ctx: GpuContext, id: Int, desc: BufferDesc) -> Result[GpuBuffer, GpuError]
  var dev_ptr: Ptr = Ptr::null()
  let result = cudaMalloc(&mut dev_ptr as PtrMut[Ptr], desc.size)
  
  if result != 0 then
    return Result::Err(GpuError::OutOfMemory(desc.size))
  end
  
  let buffer = GpuBuffer {
    id: id,
    device: ctx.device.id,
    size: desc.size,
    usage: desc.usage,
    location: desc.location,
    mapped_ptr: Option::Some(dev_ptr)
  }
  
  ctx.buffers.insert(id, buffer.clone())
  Result::Ok(buffer)
end

def create_opencl_buffer(inout ctx: GpuContext, id: Int, desc: BufferDesc) -> Result[GpuBuffer, GpuError]
  let buffer = GpuBuffer {
    id: id,
    device: ctx.device.id,
    size: desc.size,
    usage: desc.usage,
    location: desc.location,
    mapped_ptr: Option::None
  }
  
  ctx.buffers.insert(id, buffer.clone())
  Result::Ok(buffer)
end

def destroy_buffer(ctx: GpuContext, buffer: GpuBuffer) -> Unit
  match ctx.backend
  when GpuBackend::CUDA then
    match buffer.mapped_ptr
    when Option::Some(ptr) then let _ = cudaFree(ptr)
    when Option::None then ()
    end
  else ()
  end
end

def map_buffer(inout ctx: GpuContext, inout buffer: GpuBuffer) -> Result[Ptr, GpuError]
  match ctx.backend
  when GpuBackend::Vulkan then
    # Use vkMapMemory
    Result::Ok(Ptr::null())
  when GpuBackend::Metal then
    # Metal buffers are always mapped (unified memory)
    match buffer.mapped_ptr
    when Option::Some(ptr) then Result::Ok(ptr)
    when Option::None then Result::Err(GpuError::InvalidBuffer)
    end
  when GpuBackend::CUDA then
    match buffer.mapped_ptr
    when Option::Some(ptr) then Result::Ok(ptr)
    when Option::None then Result::Err(GpuError::InvalidBuffer)
    end
  else Result::Err(GpuError::UnsupportedBackend(ctx.backend))
  end
end

def unmap_buffer(inout ctx: GpuContext, inout buffer: GpuBuffer) -> Unit
  match ctx.backend
  when GpuBackend::Vulkan then
    # Use vkUnmapMemory
    ()
  else ()
  end
end

def upload_to_buffer(inout ctx: GpuContext, buffer: GpuBuffer, data: Ptr, size: UInt, offset: UInt) -> Result[Unit, GpuError]
  if offset + size > buffer.size then
    return Result::Err(GpuError::InvalidBuffer)
  end
  
  match ctx.backend
  when GpuBackend::CUDA then
    match buffer.mapped_ptr
    when Option::Some(dst) then
      let result = cudaMemcpy((dst as UInt + offset) as Ptr, data, size, 1)  # cudaMemcpyHostToDevice = 1
      if result != 0 then
        return Result::Err(GpuError::PlatformError("cudaMemcpy failed"))
      end
      Result::Ok(())
    when Option::None then Result::Err(GpuError::InvalidBuffer)
    end
  else
    # Generic implementation using map/copy/unmap
    let mapped = map_buffer(ctx, buffer)?
    # memcpy would go here
    unmap_buffer(ctx, buffer)
    Result::Ok(())
  end
end

def download_from_buffer(inout ctx: GpuContext, buffer: GpuBuffer, data: Ptr, size: UInt, offset: UInt) -> Result[Unit, GpuError]
  if offset + size > buffer.size then
    return Result::Err(GpuError::InvalidBuffer)
  end
  
  match ctx.backend
  when GpuBackend::CUDA then
    match buffer.mapped_ptr
    when Option::Some(src) then
      let result = cudaMemcpy(data, (src as UInt + offset) as Ptr, size, 2)  # cudaMemcpyDeviceToHost = 2
      if result != 0 then
        return Result::Err(GpuError::PlatformError("cudaMemcpy failed"))
      end
      Result::Ok(())
    when Option::None then Result::Err(GpuError::InvalidBuffer)
    end
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Image Management
# ═══════════════════════════════════════════════════════════════

def create_image(inout ctx: GpuContext, desc: ImageDesc) -> Result[GpuImage, GpuError]
  let id = ctx.next_id
  ctx.next_id = ctx.next_id + 1
  
  let image = GpuImage {
    id: id,
    device: ctx.device.id,
    width: desc.width,
    height: desc.height,
    depth: desc.depth,
    format: desc.format,
    mip_levels: desc.mip_levels,
    array_layers: desc.array_layers
  }
  
  ctx.images.insert(id, image.clone())
  Result::Ok(image)
end

def destroy_image(ctx: GpuContext, image: GpuImage) -> Unit
  ctx.images.remove(image.id)
  ()
end

def create_sampler(inout ctx: GpuContext, filter: FilterMode, address_u: AddressMode, address_v: AddressMode) -> Result[GpuSampler, GpuError]
  let id = ctx.next_id
  ctx.next_id = ctx.next_id + 1
  
  let sampler = GpuSampler {
    id: id,
    device: ctx.device.id,
    filter: filter,
    address_u: address_u,
    address_v: address_v,
    address_w: AddressMode::ClampToEdge,
    mip_lod_bias: 0.0,
    max_anisotropy: 1.0,
    compare_op: Option::None,
    min_lod: 0.0,
    max_lod: 1000.0
  }
  
  ctx.samplers.insert(id, sampler.clone())
  Result::Ok(sampler)
end

def destroy_sampler(ctx: GpuContext, sampler: GpuSampler) -> Unit
  ctx.samplers.remove(sampler.id)
  ()
end

# ═══════════════════════════════════════════════════════════════
# Shader and Pipeline Management
# ═══════════════════════════════════════════════════════════════

def compile_shader(ctx: GpuContext, source: String, stage: ShaderStage, lang: ShaderLanguage, entry: String) -> Result[ShaderModule, GpuError]
  match ctx.backend
  when GpuBackend::Vulkan then compile_spirv_shader(ctx, source, stage, lang, entry)
  when GpuBackend::Metal then compile_msl_shader(ctx, source, stage, entry)
  when GpuBackend::CUDA then compile_cuda_shader(ctx, source, entry)
  when GpuBackend::OpenCL then compile_opencl_shader(ctx, source, entry)
  else Result::Err(GpuError::UnsupportedBackend(ctx.backend))
  end
end

def compile_spirv_shader(ctx: GpuContext, source: String, stage: ShaderStage, lang: ShaderLanguage, entry: String) -> Result[ShaderModule, GpuError]
  # Compile to SPIR-V using glslang or similar
  Result::Ok(ShaderModule {
    id: 0,
    stage: stage,
    language: ShaderLanguage::SPIRV,
    entry_point: entry
  })
end

def compile_msl_shader(ctx: GpuContext, source: String, stage: ShaderStage, entry: String) -> Result[ShaderModule, GpuError]
  # Metal shaders are compiled at runtime by the Metal framework
  Result::Ok(ShaderModule {
    id: 0,
    stage: stage,
    language: ShaderLanguage::MSL,
    entry_point: entry
  })
end

def compile_cuda_shader(ctx: GpuContext, source: String, entry: String) -> Result[ShaderModule, GpuError]
  # CUDA kernels are compiled with nvcc at build time
  Result::Ok(ShaderModule {
    id: 0,
    stage: ShaderStage::Compute,
    language: ShaderLanguage::PTX,
    entry_point: entry
  })
end

def compile_opencl_shader(ctx: GpuContext, source: String, entry: String) -> Result[ShaderModule, GpuError]
  # OpenCL kernels are compiled at runtime
  Result::Ok(ShaderModule {
    id: 0,
    stage: ShaderStage::Compute,
    language: ShaderLanguage::OpenCL_C,
    entry_point: entry
  })
end

def create_compute_pipeline(inout ctx: GpuContext, desc: ComputePipelineDesc) -> Result[GpuPipeline, GpuError]
  let id = ctx.next_id
  ctx.next_id = ctx.next_id + 1
  
  let pipeline = GpuPipeline {
    id: id,
    device: ctx.device.id,
    layout: PipelineLayout {
      descriptor_sets: desc.descriptor_sets,
      push_constant_range: Option::None
    }
  }
  
  ctx.pipelines.insert(id, pipeline.clone())
  Result::Ok(pipeline)
end

def destroy_pipeline(ctx: GpuContext, pipeline: GpuPipeline) -> Unit
  ctx.pipelines.remove(pipeline.id)
  ()
end

# ═══════════════════════════════════════════════════════════════
# Command Buffer Recording
# ═══════════════════════════════════════════════════════════════

def create_command_buffer(inout ctx: GpuContext) -> Result[CommandBuffer, GpuError]
  let id = ctx.next_id
  ctx.next_id = ctx.next_id + 1
  
  let cmd = CommandBuffer {
    id: id,
    device: ctx.device.id,
    queue: 0,
    recorded: false,
    commands: Vec::new()
  }
  
  ctx.command_buffers.insert(id, cmd.clone())
  Result::Ok(cmd)
end

def begin_command_buffer(inout cmd: CommandBuffer) -> Result[Unit, GpuError]
  cmd.recorded = false
  cmd.commands.clear()
  Result::Ok(())
end

def end_command_buffer(inout cmd: CommandBuffer) -> Result[Unit, GpuError]
  cmd.recorded = true
  Result::Ok(())
end

def cmd_dispatch(inout cmd: CommandBuffer, pipeline: GpuPipeline, x: UInt, y: UInt, z: UInt) -> Unit
  cmd.commands.push(GpuCommand::Dispatch(pipeline.id, x, y, z))
end

def cmd_dispatch_indirect(inout cmd: CommandBuffer, pipeline: GpuPipeline, buffer: GpuBuffer, offset: UInt) -> Unit
  cmd.commands.push(GpuCommand::DispatchIndirect(pipeline.id, buffer.id, offset))
end

def cmd_copy_buffer(inout cmd: CommandBuffer, src: GpuBuffer, dst: GpuBuffer, size: UInt) -> Unit
  cmd.commands.push(GpuCommand::CopyBuffer(src.id, dst.id, size))
end

def cmd_barrier(inout cmd: CommandBuffer, barrier: BarrierCmd) -> Unit
  cmd.commands.push(GpuCommand::Barrier(barrier))
end

# ═══════════════════════════════════════════════════════════════
# Synchronization
# ═══════════════════════════════════════════════════════════════

def create_fence(inout ctx: GpuContext) -> Result[Fence, GpuError]
  Result::Ok(Fence {
    id: ctx.next_id,
    device: ctx.device.id,
    signaled: false
  })
end

def wait_for_fence(ctx: GpuContext, fence: Fence, timeout_ns: UInt) -> Result[Bool, GpuError]
  # Wait for fence to be signaled
  Result::Ok(fence.signaled)
end

def reset_fence(inout ctx: GpuContext, inout fence: Fence) -> Result[Unit, GpuError]
  fence.signaled = false
  Result::Ok(())
end

def create_semaphore(inout ctx: GpuContext) -> Result[Semaphore, GpuError]
  Result::Ok(Semaphore {
    id: ctx.next_id,
    device: ctx.device.id
  })
end

# ═══════════════════════════════════════════════════════════════
# Queue Submission
# ═══════════════════════════════════════════════════════════════

def submit_command_buffer(ctx: GpuContext, cmd: CommandBuffer, fence: Option[Ptr[Fence]]) -> Result[Unit, GpuError]
  if !cmd.recorded then
    return Result::Err(GpuError::PlatformError("command buffer not recorded"))
  end
  
  match ctx.backend
  when GpuBackend::CUDA then
    let result = cudaDeviceSynchronize()
    if result != 0 then
      return Result::Err(GpuError::PlatformError("CUDA sync failed"))
    end
    Result::Ok(())
  else
    Result::Ok(())
  end
end

def wait_idle(ctx: GpuContext) -> Result[Unit, GpuError]
  match ctx.backend
  when GpuBackend::Vulkan then
    match ctx.vulkan_device
    when Option::Some(device) then
      let result = vkDeviceWaitIdle(device)
      if result != 0 then
        return Result::Err(GpuError::PlatformError("vkDeviceWaitIdle failed"))
      end
      Result::Ok(())
    when Option::None then Result::Err(GpuError::NoDevice)
    end
  when GpuBackend::CUDA then
    let result = cudaDeviceSynchronize()
    if result != 0 then
      return Result::Err(GpuError::PlatformError("cudaDeviceSynchronize failed"))
    end
    Result::Ok(())
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# High-Level Compute API
# ═══════════════════════════════════════════════════════════════

struct ComputeKernel
  pipeline: GpuPipeline
  buffers: Vec[GpuBuffer]
  push_constants: Vec[u8]
  workgroup_size: [UInt; 3]
end

def ComputeKernel::create(inout ctx: GpuContext, shader_source: String, entry: String, workgroup: [UInt; 3]) -> Result[ComputeKernel, GpuError]
  let shader = compile_shader(ctx, shader_source, ShaderStage::Compute, ShaderLanguage::SPIRV, entry)?
  
  let desc = ComputePipelineDesc {
    shader: shader,
    push_constant_size: 256,
    descriptor_sets: Vec::new()
  }
  
  let pipeline = create_compute_pipeline(ctx, desc)?
  
  Result::Ok(ComputeKernel {
    pipeline: pipeline,
    buffers: Vec::new(),
    push_constants: Vec::new(),
    workgroup_size: workgroup
  })
end

def ComputeKernel::set_buffer(inout self: ComputeKernel, binding: Int, buffer: GpuBuffer) -> Unit
  while self.buffers.len() <= binding do
    self.buffers.push(GpuBuffer { id: -1, device: -1, size: 0, usage: BufferUsage::Storage, location: MemoryLocation::DeviceLocal, mapped_ptr: Option::None })
  end
  self.buffers[binding] = buffer
end

def ComputeKernel::dispatch(self: ComputeKernel, inout ctx: GpuContext, global_size: [UInt; 3]) -> Result[Unit, GpuError]
  var cmd = create_command_buffer(ctx)?
  begin_command_buffer(&mut cmd)?
  
  let workgroups_x = (global_size[0] + self.workgroup_size[0] - 1) / self.workgroup_size[0]
  let workgroups_y = (global_size[1] + self.workgroup_size[1] - 1) / self.workgroup_size[1]
  let workgroups_z = (global_size[2] + self.workgroup_size[2] - 1) / self.workgroup_size[2]
  
  cmd_dispatch(&mut cmd, &self.pipeline, workgroups_x, workgroups_y, workgroups_z)
  
  end_command_buffer(&mut cmd)?
  submit_command_buffer(ctx, &cmd, Option::None)?;
  wait_idle(ctx)?;
  
  Result::Ok(())
end