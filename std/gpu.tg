# Metal Backend Implementation (macOS/iOS)
# ═══════════════════════════════════════════════════════════════

@cfg(any(target_os = "macos", target_os = "ios"))
def check_metal_available() -> Bool
  # Metal is always available on macOS 10.11+ and iOS 8+
  true
end

@cfg(not(any(target_os = "macos", target_os = "ios")))
def check_metal_available() -> Bool
  false
end

@cfg(any(target_os = "macos", target_os = "ios"))
def enumerate_metal_devices() -> Vec[GpuDevice]
  var devices = Vec::new()
  
  # Use Objective-C runtime to call Metal APIs
  # MTLCreateSystemDefaultDevice() and MTLCopyAllDevices()
  
  # This requires the Objective-C runtime bindings
  # Simplified implementation - would use msgSend to call Metal APIs
  
  let default_device = metal_create_default_device()
  if !default_device.is_null() then
    let device = metal_get_device_info(default_device)
    devices.push(device)
  end
  
  devices
end

@cfg(any(target_os = "macos", target_os = "ios"))
@ffi("c")
extern def MTLCreateSystemDefaultDevice() -> Ptr
end

@cfg(any(target_os = "macos", target_os = "ios"))
def metal_create_default_device() -> Ptr
  MTLCreateSystemDefaultDevice()
end

@cfg(any(target_os = "macos", target_os = "ios"))
def metal_get_device_info(device: Ptr) -> GpuDevice
  let obj = device as Object

  # Query device name: [device name] -> NSString -> UTF8String
  let name_sel = sel_registerName(CString::new("name").as_ptr())
  let ns_name = objc_msgSend(obj, name_sel)
  let utf8_sel = sel_registerName(CString::new("UTF8String").as_ptr())
  let cstr = objc_msgSend(ns_name, utf8_sel)
  let name = if cstr != Ptr::null() then
    String::from_cstr(cstr as Ptr[u8])
  else
    "Apple GPU".to_string()
  end

  # Query recommended max working set size: [device recommendedMaxWorkingSetSize] -> UInt
  let mem_sel = sel_registerName(CString::new("recommendedMaxWorkingSetSize").as_ptr())
  let total_mem = objc_msgSend(obj, mem_sel) as UInt

  # Query max threads per threadgroup: [device maxThreadsPerThreadgroup] -> MTLSize (w, h, d)
  let threads_sel = sel_registerName(CString::new("maxThreadsPerThreadgroup").as_ptr())
  let max_threads = objc_msgSend(obj, threads_sel) as Int

  # Query unified memory
  let unified_sel = sel_registerName(CString::new("hasUnifiedMemory").as_ptr())
  let is_unified = objc_msgSend(obj, unified_sel) as Int != 0

  GpuDevice {
    id: 0,
    name: name,
    vendor: GpuVendor::Apple,
    backend: GpuBackend::Metal,
    total_memory: total_mem,
    available_memory: total_mem,
    compute_units: 0,
    max_work_group_size: if max_threads > 0 then max_threads else 1024 end,
    max_work_group_dims: [1024, 1024, 1024],
    clock_frequency: 0,
    supports_fp16: true,
    supports_fp64: false,
    supports_int64: true,
    supports_subgroups: true,
    subgroup_size: 32,
    unified_memory: is_unified
  }
end

@cfg(not(any(target_os = "macos", target_os = "ios")))
def enumerate_metal_devices() -> Vec[GpuDevice]
  Vec::new()
end

