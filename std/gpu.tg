  Ok(CommandEncoder { _backend: device._backend, _handle: handle })
end

pub struct CommandBuffer
  _backend: Backend
  _handle: u64
end

impl CommandEncoder
  pub def finish(self) -> Result[CommandBuffer, GpuError]
    let handle = _backend_finish_command_encoder(self._backend, self._handle)?
    Ok(CommandBuffer { _backend: self._backend, _handle: handle })
  end

  pub def begin_render_pass(self, desc: &RenderPassDescriptor) -> RenderPassEncoder
    let handle = _backend_begin_render_pass(self._backend, self._handle, desc)
    RenderPassEncoder { _backend: self._backend, _handle: handle }
  end

  pub def begin_compute_pass(self) -> ComputePassEncoder
    let handle = _backend_begin_compute_pass(self._backend, self._handle)
    ComputePassEncoder { _backend: self._backend, _handle: handle }
  end

  pub def copy_buffer_to_buffer(self, src: &GpuBuffer, src_offset: u64,
                                 dst: &GpuBuffer, dst_offset: u64, size: u64)
    _backend_copy_buffer(self._backend, self._handle,
      src._handle, src_offset, dst._handle, dst_offset, size)
  end

  pub def copy_buffer_to_texture(self, src: &GpuBuffer, dst: &GpuTexture,
                                  offset: u64, bytes_per_row: u32, rows: u32)
    _backend_copy_buffer_to_texture(self._backend, self._handle,
      src._handle, offset, bytes_per_row, rows, dst._handle)
  end
end

pub enum LoadOp
  Clear
  Load
  DontCare
end

pub enum StoreOp
  Store
  Discard
end

pub struct Color
  pub r: f64
  pub g: f64
  pub b: f64
  pub a: f64
end

impl Color
  pub const BLACK: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  pub const WHITE: Color = Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }
  pub const TRANSPARENT: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
  pub const CORNFLOWER_BLUE: Color = Color { r: 0.392, g: 0.584, b: 0.929, a: 1.0 }
end

pub struct RenderPassColorAttachment
  pub view: &TextureView
  pub resolve_target: Option[&TextureView]
  pub load_op: LoadOp
  pub store_op: StoreOp
  pub clear_color: Color
end

pub struct RenderPassDepthAttachment
  pub view: &TextureView
  pub depth_load_op: LoadOp
  pub depth_store_op: StoreOp
  pub depth_clear_value: f32
  pub stencil_load_op: LoadOp
  pub stencil_store_op: StoreOp
  pub stencil_clear_value: u32
end

pub struct RenderPassDescriptor
  pub color_attachments: Vec[RenderPassColorAttachment]
  pub depth_stencil: Option[RenderPassDepthAttachment]
  pub label: Option[String]
end

pub struct RenderPassEncoder
  _backend: Backend
  _handle: u64
end

impl RenderPassEncoder
  pub def set_pipeline(&self, pipeline: &RenderPipeline)
    _backend_rp_set_pipeline(self._backend, self._handle, pipeline._handle)
  end

  pub def set_bind_group(&self, index: u32, group: &BindGroup, dynamic_offsets: &[u32])
    _backend_rp_set_bind_group(self._backend, self._handle, index, group._handle, dynamic_offsets)
  end

  pub def set_vertex_buffer(&self, slot: u32, buffer: &GpuBuffer, offset: u64)
    _backend_rp_set_vertex_buffer(self._backend, self._handle, slot, buffer._handle, offset)
  end

  pub def set_index_buffer(&self, buffer: &GpuBuffer, format: IndexFormat, offset: u64)
    _backend_rp_set_index_buffer(self._backend, self._handle, buffer._handle, format, offset)
  end

  pub def set_viewport(&self, x: f32, y: f32, w: f32, h: f32, min_depth: f32, max_depth: f32)
    _backend_rp_set_viewport(self._backend, self._handle, x, y, w, h, min_depth, max_depth)
  end

  pub def set_scissor(&self, x: u32, y: u32, w: u32, h: u32)
    _backend_rp_set_scissor(self._backend, self._handle, x, y, w, h)
  end

  pub def push_constants(&self, stage: ShaderStage, offset: u32, data: &[u8])
    _backend_rp_push_constants(self._backend, self._handle, stage, offset, data)
  end

  pub def draw(&self, vertex_count: u32, instance_count: u32, first_vertex: u32, first_instance: u32)
    _backend_rp_draw(self._backend, self._handle, vertex_count, instance_count, first_vertex, first_instance)
  end

  pub def draw_indexed(&self, index_count: u32, instance_count: u32, first_index: u32, vertex_offset: i32, first_instance: u32)
    _backend_rp_draw_indexed(self._backend, self._handle, index_count, instance_count, first_index, vertex_offset, first_instance)
  end

  pub def end_pass(&self)
    _backend_rp_end(self._backend, self._handle)
  end
end

pub enum IndexFormat
  Uint16
  Uint32
end

pub struct ComputePassEncoder
  _backend: Backend
  _handle: u64
end

impl ComputePassEncoder
  pub def set_pipeline(&self, pipeline: &ComputePipeline)
    _backend_cp_set_pipeline(self._backend, self._handle, pipeline._handle)
  end

  pub def set_bind_group(&self, index: u32, group: &BindGroup, dynamic_offsets: &[u32])
    _backend_cp_set_bind_group(self._backend, self._handle, index, group._handle, dynamic_offsets)
  end

  pub def dispatch(&self, x: u32, y: u32, z: u32)
    _backend_cp_dispatch(self._backend, self._handle, x, y, z)
  end

  pub def dispatch_indirect(&self, buffer: &GpuBuffer, offset: u64)
    _backend_cp_dispatch_indirect(self._backend, self._handle, buffer._handle, offset)
  end

  pub def end_pass(&self)
    _backend_cp_end(self._backend, self._handle)
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §9  Synchronization
# ═══════════════════════════════════════════════════════════════════════

pub struct Fence
  _backend: Backend
  _handle: u64
end

pub def create_fence(device: &GpuDevice, signaled: Bool) -> Result[Fence, GpuError]
  let handle = _backend_create_fence(device._backend, device._handle, signaled)?
  Ok(Fence { _backend: device._backend, _handle: handle })
end

impl Fence
  pub def wait(self, timeout_ns: u64) -> Result[Bool, GpuError]
    _backend_fence_wait(self._backend, self._handle, timeout_ns)
  end

  pub def reset(self) -> Result[Unit, GpuError]
    _backend_fence_reset(self._backend, self._handle)
  end

  pub def is_signaled(self) -> Bool
    _backend_fence_status(self._backend, self._handle)
  end
end

impl Drop for Fence
  def drop(&mut self)
    _backend_destroy_fence(self._backend, self._handle)
  end
end

pub struct Semaphore
  _backend: Backend
  _handle: u64
end

pub def create_semaphore(device: &GpuDevice) -> Result[Semaphore, GpuError]
  let handle = _backend_create_semaphore(device._backend, device._handle)?
  Ok(Semaphore { _backend: device._backend, _handle: handle })
end

# ═══════════════════════════════════════════════════════════════════════
# §10  Surface & Swapchain
# ═══════════════════════════════════════════════════════════════════════

pub enum PresentMode
  Immediate       ## No v-sync, tearing possible
  Fifo            ## V-sync, queue frames
  FifoRelaxed     ## V-sync with late frame allowance
  Mailbox         ## Triple-buffering, always presents latest
end

pub struct SwapchainConfig
  pub format: TextureFormat
  pub present_mode: PresentMode
  pub width: u32
  pub height: u32
  pub min_image_count: u32
end

pub struct Surface
  _backend: Backend
  _handle: u64
end

pub struct Swapchain
  _backend: Backend
  _handle: u64
  _config: SwapchainConfig
end

impl Swapchain
  pub def acquire_next_image(self, timeout_ns: u64) -> Result[(TextureView, u32), GpuError]
    _backend_swapchain_acquire(self._backend, self._handle, timeout_ns)
  end

  pub def present(self, image_index: u32) -> Result[Unit, GpuError]
    _backend_swapchain_present(self._backend, self._handle, image_index)
  end

  pub def resize(self, width: u32, height: u32) -> Result[Unit, GpuError]
    _backend_swapchain_resize(self._backend, self._handle, width, height)
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §11  Backend Detection
# ═══════════════════════════════════════════════════════════════════════

def _detect_best_backend() -> Backend
  @cfg(target_os = "macos")
  return Backend.Metal
  @cfg(target_os = "ios")
  return Backend.Metal
  @cfg(target_os = "windows")
  return if _vulkan_available() then Backend.Vulkan else Backend.DirectX12 end
  @cfg(target_os = "linux")
  return Backend.Vulkan
  @cfg(target_os = "android")
  return Backend.Vulkan
  @cfg(target_arch = "wasm")
  return Backend.WebGPU
end

pub def available_backends() -> Vec[Backend]
  var backends = Vec.new()
  @cfg(target_os = "linux")
  if _vulkan_available() then backends.push(Backend.Vulkan) end
  @cfg(target_os = "linux")
  if _opengl_available() then backends.push(Backend.OpenGL46) end
  @cfg(target_os = "macos")
  backends.push(Backend.Metal)
  @cfg(target_os = "macos")
  if _vulkan_available() then backends.push(Backend.Vulkan) end
  @cfg(target_os = "windows")
  backends.push(Backend.DirectX12)
  @cfg(target_os = "windows")
  if _vulkan_available() then backends.push(Backend.Vulkan) end
  @cfg(target_os = "windows")
  if _opengl_available() then backends.push(Backend.OpenGL46) end
  @cfg(target_arch = "wasm")
  backends.push(Backend.WebGPU)
  backends
end

# ═══════════════════════════════════════════════════════════════════════
# §12  Tests
# ═══════════════════════════════════════════════════════════════════════

@test
def test_instance_config_default() -> Unit
  let config = InstanceConfig.default()
  assert !config.validation_layers
  assert !config.debug_labels
end

@test
def test_backend_detection() -> Unit
  let backends = available_backends()
  if backends.len() < 1 then
    panic("at least one GPU backend should be available")
  end
end

@test
def test_sampler_descriptors() -> Unit
  let linear = SamplerDescriptor.linear()
  assert linear.max_anisotropy == 1
  let nearest = SamplerDescriptor.nearest()
  assert nearest.lod_max_clamp == 0.0
end

@test
def test_blend_states() -> Unit
  let alpha = BlendState.ALPHA_BLEND
  assert alpha.color_op == BlendOp.Add
end

end ## module std::gpu
