extern def cudaDeviceSynchronize() -> Int
end

def enumerate_cuda_devices() -> Vec[GpuDevice]
  var devices = Vec::new()
  
  var count: Int = 0
  let result = cudaGetDeviceCount(&mut count as PtrMut[Int])
  
  if result != 0 then return devices end
  
  for i in 0..count do
    let device = get_cuda_device_info(i)
    devices.push(device)
  end
  
  devices
end

struct CudaDeviceProp
  name: [u8; 256]
  uuid: [u8; 16]
  totalGlobalMem: UInt
  sharedMemPerBlock: UInt
  regsPerBlock: Int
  warpSize: Int
  memPitch: UInt
  maxThreadsPerBlock: Int
  maxThreadsDim: [Int; 3]
  maxGridSize: [Int; 3]
  clockRate: Int
  multiProcessorCount: Int
end

def get_cuda_device_info(device_id: Int) -> GpuDevice
  var prop: CudaDeviceProp = CudaDeviceProp {
    name: [0; 256],
    uuid: [0; 16],
    totalGlobalMem: 0,
    sharedMemPerBlock: 0,
    regsPerBlock: 0,
    warpSize: 32,
    memPitch: 0,
    maxThreadsPerBlock: 1024,
    maxThreadsDim: [1024, 1024, 64],
    maxGridSize: [2147483647, 65535, 65535],
    clockRate: 0,
    multiProcessorCount: 0
  }
  
  let result = cudaGetDeviceProperties(&mut prop as Ptr, device_id)
  
  if result != 0 then
    return GpuDevice {
      id: device_id,
      name: "Unknown CUDA Device".to_string(),
      vendor: GpuVendor::NVIDIA,
      backend: GpuBackend::CUDA,
      total_memory: 0,
      available_memory: 0,
      compute_units: 0,
      max_work_group_size: 1024,
      max_work_group_dims: [1024, 1024, 64],
      clock_frequency: 0,
      supports_fp16: true,
      supports_fp64: true,
      supports_int64: true,
      supports_subgroups: true,
      subgroup_size: 32,
      unified_memory: false
    }
  end
  
  # Extract name from fixed array
  var name_str = String::new()
  for i in 0..256 do
    if prop.name[i] == 0 then break end
    name_str = name_str + (prop.name[i] as Char).to_string()
  end
  
  GpuDevice {
    id: device_id,
    name: name_str,
    vendor: GpuVendor::NVIDIA,
    backend: GpuBackend::CUDA,
    total_memory: prop.totalGlobalMem,
    available_memory: prop.totalGlobalMem,
    compute_units: prop.multiProcessorCount,
    max_work_group_size: prop.maxThreadsPerBlock,
    max_work_group_dims: prop.maxThreadsDim,
    clock_frequency: prop.clockRate / 1000,
    supports_fp16: true,
    supports_fp64: true,
    supports_int64: true,
    supports_subgroups: true,
    subgroup_size: prop.warpSize,
    unified_memory: false
  }
end

