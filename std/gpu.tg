# Tangerine Standard Library — std::gpu
# GPU Compute Bindings - Vulkan Compute, Metal, CUDA, OpenCL
# Cross-platform GPU compute abstraction

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, Ptr, Float}
use std::collections::{Map, Array}
use std::dynload
use std::ffi::{CString}
use std::cocoa::{objc_msgSend, sel_registerName, Object, SEL}

# ═══════════════════════════════════════════════════════════════
# GPU Backend Selection
# ═══════════════════════════════════════════════════════════════

enum GpuBackend
  Vulkan      # Cross-platform (Windows, Linux, Android, macOS via MoltenVK)
  Metal       # Apple platforms (macOS, iOS)
  CUDA        # NVIDIA GPUs
  OpenCL      # Legacy cross-platform
  WGPU        # WebGPU native (cross-platform)
  Auto        # Auto-detect best available
end

enum GpuVendor
  NVIDIA
  AMD
  Intel
  Apple
  Qualcomm
  ARM
  Unknown
end

# ═══════════════════════════════════════════════════════════════
# GPU Device Information
# ═══════════════════════════════════════════════════════════════

struct GpuDevice
  id: Int
  name: String
  vendor: GpuVendor
  backend: GpuBackend
  total_memory: UInt          # Total VRAM in bytes
  available_memory: UInt      # Currently available VRAM
  compute_units: Int          # Number of compute units / SMs
  max_work_group_size: Int    # Max threads per workgroup
  max_work_group_dims: [Int; 3]  # Max dimensions
  clock_frequency: Int        # In MHz
  supports_fp16: Bool
  supports_fp64: Bool
  supports_int64: Bool
  supports_subgroups: Bool
  subgroup_size: Int
  unified_memory: Bool        # CPU/GPU shared memory
end

struct GpuCapabilities
  devices: Vec[GpuDevice]
  preferred_device: Int       # Index into devices
  supports_vulkan: Bool
  supports_metal: Bool
  supports_cuda: Bool
  supports_opencl: Bool
  supports_wgpu: Bool
end

# ═══════════════════════════════════════════════════════════════
# Memory Types
# ═══════════════════════════════════════════════════════════════

enum BufferUsage
  Storage           # General storage (read/write)
  Uniform           # Uniform buffer (read-only, small)
  Vertex            # Vertex buffer
  Index             # Index buffer
  Staging           # CPU-visible staging buffer
  Indirect          # Indirect dispatch arguments
end

enum MemoryLocation
  DeviceLocal       # GPU-only memory (fastest)
  HostVisible       # CPU-visible (slower, for staging)
  HostCoherent      # CPU-visible with automatic cache management
  Unified           # Shared CPU/GPU memory (Apple Silicon)
end

struct BufferDesc
  size: UInt
  usage: BufferUsage
  location: MemoryLocation
  initial_data: Option[Ptr]
end

struct ImageDesc
  width: UInt
  height: UInt
  depth: UInt
  format: ImageFormat
  usage: ImageUsage
  mip_levels: UInt
  array_layers: UInt
end

enum ImageFormat
  R8_UNORM
  R8_SNORM
  R8_UINT
  R8_SINT
  RG8_UNORM
  RG8_SNORM
  RG8_UINT
  RG8_SINT
  RGBA8_UNORM
  RGBA8_SNORM
  RGBA8_UINT
  RGBA8_SINT
  RGBA8_SRGB
  BGRA8_UNORM
  BGRA8_SRGB
  R16_UINT
  R16_SINT
  R16_FLOAT
  RG16_UINT
  RG16_SINT
  RG16_FLOAT
  RGBA16_UINT
  RGBA16_SINT
  RGBA16_FLOAT
  R32_UINT
  R32_SINT
  R32_FLOAT
  RG32_UINT
  RG32_SINT
  RG32_FLOAT
  RGBA32_UINT
  RGBA32_SINT
  RGBA32_FLOAT
  DEPTH16
  DEPTH24_STENCIL8
  DEPTH32_FLOAT
end

enum ImageUsage
  Sampled
  Storage
  ColorAttachment
  DepthStencilAttachment
  TransferSrc
  TransferDst
end

# ═══════════════════════════════════════════════════════════════
# Shader Types
# ═══════════════════════════════════════════════════════════════

enum ShaderStage
  Compute
  Vertex
  Fragment
  Geometry
  TessControl
  TessEval
  RayGen
  RayClosestHit
  RayMiss
  RayIntersection
end

enum ShaderLanguage
  SPIRV           # Vulkan
  MSL             # Metal Shading Language
  PTX             # CUDA
  HLSL            # DirectX / DirectX12
  WGSL            # WebGPU Shading Language
  OpenCL_C        # OpenCL C
end

struct ShaderModule
  id: Int
  stage: ShaderStage
  language: ShaderLanguage
  entry_point: String
end

struct ComputePipelineDesc
  shader: ShaderModule
  push_constant_size: UInt
  descriptor_sets: Vec[DescriptorSetLayout]
end

struct DescriptorSetLayout
  bindings: Vec[DescriptorBinding]
end

struct DescriptorBinding
  binding: Int
  type: DescriptorType
  count: Int
  stages: ShaderStage
end

enum DescriptorType
  UniformBuffer
  StorageBuffer
  SampledImage
  StorageImage
  Sampler
  CombinedImageSampler
  AccelerationStructure
end

# ═══════════════════════════════════════════════════════════════
# Command Types
# ═══════════════════════════════════════════════════════════════

struct DispatchCmd
  workgroups_x: UInt
  workgroups_y: UInt
  workgroups_z: UInt
end

struct DispatchIndirectCmd
  buffer: GpuBuffer
  offset: UInt
end

struct CopyBufferCmd
  src: GpuBuffer
  dst: GpuBuffer
  src_offset: UInt
  dst_offset: UInt
  size: UInt
end

struct CopyBufferToImageCmd
  src: GpuBuffer
  dst: GpuImage
  buffer_offset: UInt
  image_offset: [UInt; 3]
  image_extent: [UInt; 3]
  mip_level: UInt
  array_layer: UInt
end

struct BarrierCmd
  src_stage: PipelineStage
  dst_stage: PipelineStage
  memory_barriers: Vec[MemoryBarrier]
  buffer_barriers: Vec[BufferBarrier]
  image_barriers: Vec[ImageBarrier]
end

enum PipelineStage
  TopOfPipe
  DrawIndirect
  VertexInput
  VertexShader
  FragmentShader
  EarlyFragmentTests
  LateFragmentTests
  ColorAttachmentOutput
  ComputeShader
  Transfer
  BottomOfPipe
  Host
  AllGraphics
  AllCommands
end

struct MemoryBarrier
  src_access: AccessFlags
  dst_access: AccessFlags
end

struct BufferBarrier
  src_access: AccessFlags
  dst_access: AccessFlags
  src_queue: Int
  dst_queue: Int
  buffer: GpuBuffer
  offset: UInt
  size: UInt
end

struct ImageBarrier
  src_access: AccessFlags
  dst_access: AccessFlags
  old_layout: ImageLayout
  new_layout: ImageLayout
  src_queue: Int
  dst_queue: Int
  image: GpuImage
  subresource: ImageSubresource
end

enum ImageLayout
  Undefined
  General
  ColorAttachment
  DepthStencilAttachment
  DepthStencilReadOnly
  ShaderReadOnly
  TransferSrc
  TransferDst
  Preinitialized
  PresentSrc
end

struct ImageSubresource
  aspect: ImageAspect
  mip_level: UInt
  base_array_layer: UInt
  layer_count: UInt
end

enum ImageAspect
  Color
  Depth
  Stencil
  DepthStencil
end

struct AccessFlags
  indirect_command_read: Bool
  index_read: Bool
  vertex_attribute_read: Bool
  uniform_read: Bool
  input_attachment_read: Bool
  shader_read: Bool
  shader_write: Bool
  color_attachment_read: Bool
  color_attachment_write: Bool
  depth_stencil_attachment_read: Bool
  depth_stencil_attachment_write: Bool
  transfer_read: Bool
  transfer_write: Bool
  host_read: Bool
  host_write: Bool
  memory_read: Bool
  memory_write: Bool
end

# ═══════════════════════════════════════════════════════════════
# GPU Resource Handles
# ═══════════════════════════════════════════════════════════════

struct GpuBuffer
  id: Int
  device: Int
  size: UInt
  usage: BufferUsage
  location: MemoryLocation
  mapped_ptr: Option[Ptr]
end

struct GpuImage
  id: Int
  device: Int
  width: UInt
  height: UInt
  depth: UInt
  format: ImageFormat
  mip_levels: UInt
  array_layers: UInt
end

struct GpuSampler
  id: Int
  device: Int
  filter: FilterMode
  address_u: AddressMode
  address_v: AddressMode
  address_w: AddressMode
  mip_lod_bias: Float
  max_anisotropy: Float
  compare_op: Option[CompareOp]
  min_lod: Float
  max_lod: Float
end

enum FilterMode
  Nearest
  Linear
  Cubic
end

enum AddressMode
  Repeat
  MirroredRepeat
  ClampToEdge
  ClampToBorder
  MirrorClampToEdge
end

enum CompareOp
  Never
  Less
  Equal
  LessOrEqual
  Greater
  NotEqual
  GreaterOrEqual
  Always
end

struct GpuPipeline
  id: Int
  device: Int
  layout: PipelineLayout
end

struct PipelineLayout
  descriptor_sets: Vec[DescriptorSetLayout]
  push_constant_range: Option[PushConstantRange]
end

struct PushConstantRange
  offset: UInt
  size: UInt
  stages: ShaderStage
end

enum GpuCommand
  Dispatch(Int, UInt, UInt, UInt)
  DispatchIndirect(Int, Int, UInt)
  CopyBuffer(Int, Int, UInt)
  Barrier(BarrierCmd)
end

struct CommandBuffer
  id: Int
  device: Int
  queue: Int
  recorded: Bool
  commands: Vec[GpuCommand]
end

struct Fence
  id: Int
  device: Int
  signaled: Bool
end

struct Semaphore
  id: Int
  device: Int
end

struct Event
  id: Int
  device: Int
end

# ═══════════════════════════════════════════════════════════════
# GPU Context
# ═══════════════════════════════════════════════════════════════

struct GpuContext
  backend: GpuBackend
  device: GpuDevice
  buffers: Map[Int, GpuBuffer]
  images: Map[Int, GpuImage]
  samplers: Map[Int, GpuSampler]
  pipelines: Map[Int, GpuPipeline]
  command_buffers: Map[Int, CommandBuffer]
  next_id: Int
  # Backend-specific handles
  vulkan_instance: Option[Ptr]
  vulkan_device: Option[Ptr]
  metal_device: Option[Ptr]
  cuda_context: Option[Ptr]
  opencl_context: Option[Ptr]
end

# ═══════════════════════════════════════════════════════════════
# Error Handling
# ═══════════════════════════════════════════════════════════════

enum GpuError
  NoDevice
  OutOfMemory(UInt)
  DeviceLost
  InvalidBuffer
  InvalidImage
  InvalidPipeline
  InvalidShader(String)
  CompilationFailed(String)
  UnsupportedFormat(ImageFormat)
  UnsupportedBackend(GpuBackend)
  QueueFull
  Timeout
  OutOfDate
  PlatformError(String)
end

impl GpuError
  def message(self: GpuError) -> String
    match self
    when GpuError::NoDevice then "no GPU device available"
    when GpuError::OutOfMemory(size) then "out of memory (requested: " + size.to_string() + " bytes)"
    when GpuError::DeviceLost then "GPU device lost"
    when GpuError::InvalidBuffer then "invalid buffer handle"
    when GpuError::InvalidImage then "invalid image handle"
    when GpuError::InvalidPipeline then "invalid pipeline handle"
    when GpuError::InvalidShader(msg) then "invalid shader: " + msg.clone()
    when GpuError::CompilationFailed(msg) then "shader compilation failed: " + msg.clone()
    when GpuError::UnsupportedFormat(fmt) then "unsupported image format"
    when GpuError::UnsupportedBackend(b) then "unsupported GPU backend"
    when GpuError::QueueFull then "command queue full"
    when GpuError::Timeout then "operation timed out"
    when GpuError::OutOfDate then "resource out of date (e.g., swapchain needs recreation)"
    when GpuError::PlatformError(msg) then "platform error: " + msg.clone()
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# GPU Detection and Initialization
# ═══════════════════════════════════════════════════════════════

def detect_gpus() -> GpuCapabilities
  var caps = GpuCapabilities {
    devices: Vec::new(),
    preferred_device: 0,
    supports_vulkan: false,
    supports_metal: false,
    supports_cuda: false,
    supports_opencl: false,
    supports_wgpu: false
  }
  
  # Check Vulkan availability
  caps.supports_vulkan = check_vulkan_available()
  if caps.supports_vulkan then
    let vulkan_devices = enumerate_vulkan_devices()
    for device in vulkan_devices do
      caps.devices.push(device)
    end
  end
  
  # Check Metal availability (macOS/iOS only)
  @cfg(any(target_os = "macos", target_os = "ios"))
  {
    caps.supports_metal = check_metal_available()
    if caps.supports_metal then
      let metal_devices = enumerate_metal_devices()
      for device in metal_devices do
        caps.devices.push(device)
      end
    end
  }
  
  # Check CUDA availability
  caps.supports_cuda = check_cuda_available()
  if caps.supports_cuda then
    let cuda_devices = enumerate_cuda_devices()
    for device in cuda_devices do
      caps.devices.push(device)
    end
  end
  
  # Check OpenCL availability
  caps.supports_opencl = check_opencl_available()
  if caps.supports_opencl then
    let opencl_devices = enumerate_opencl_devices()
    for device in opencl_devices do
      caps.devices.push(device)
    end
  end
  
  # Select preferred device (first discrete GPU, or first available)
  caps.preferred_device = select_preferred_device(&caps.devices)
  
  caps
end

def select_preferred_device(devices: Vec[GpuDevice]) -> Int
  if devices.len() == 0 then return -1 end
  
  # Prefer discrete GPUs over integrated
  var best_idx = 0
  var best_score = 0
  
  for i in 0..devices.len() do
    let device = devices[i]
    var score = 0
    
    # Prefer discrete GPUs
    match device.vendor
    when GpuVendor::NVIDIA then score = score + 100
    when GpuVendor::AMD then score = score + 100
    when GpuVendor::Intel then score = score + 50
    when GpuVendor::Apple then score = score + 80
    else score = score + 10
    end
    
    # Prefer more VRAM
    score = score + (device.total_memory / (1024 * 1024 * 1024)) as Int
    
    # Prefer Vulkan over other backends
    match device.backend
    when GpuBackend::Vulkan then score = score + 20
    when GpuBackend::Metal then score = score + 15
    when GpuBackend::CUDA then score = score + 10
    else score = score + 5
    end
    
    if score > best_score then
      best_score = score
      best_idx = i
    end
  end
  
  best_idx
end

