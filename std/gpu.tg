## std::gpu — Multi-Backend GPU Abstraction Layer
## Provides safe, zero-cost abstractions over Vulkan, Metal, DirectX 12, and
## OpenGL 4.6+. Builds on std::gfx_gpu with full pipeline, shader, descriptor,
## and synchronization support.
##
## Design goals:
##   - Backend-agnostic API (write once, run on any GPU)
##   - Zero-copy buffer management with explicit lifetime control
##   - Shader compilation pipeline with SPIR-V as IR
##   - Descriptor set / bind group abstraction
##   - Safe synchronization primitives (fences, semaphores)
##   - Render graph for automatic barrier insertion
##
## Spec: §stdlib.gpu

module std::gpu

use std::core::{Result, Option, Drop, Clone, Display}
use std::alloc::{Layout}
use std::linalg::{Vec2, Vec3, Vec4, Mat4}
use std::mmap::{Mmap}
use std::sync::{Arc, Mutex}

# ═══════════════════════════════════════════════════════════════════════
# §1  Backend Selection
# ═══════════════════════════════════════════════════════════════════════

pub enum Backend
  Vulkan
  Metal
  DirectX12
  OpenGL46
  WebGPU
  Auto          ## Auto-detect best available backend
end

pub enum GpuError
  OutOfMemory(String)
  DeviceLost(String)
  Unsupported(String)
  ShaderCompilationError(String)
  PipelineError(String)
  SurfaceError(String)
  ValidationError(String)
  Timeout
end

impl Display for GpuError
  def fmt(self, f: &mut std::fmt::Formatter) -> std::fmt::Result
    match self
    when GpuError.OutOfMemory(msg) then f.write_str("GPU OOM: " + msg)
    when GpuError.DeviceLost(msg) then f.write_str("Device lost: " + msg)
    when GpuError.Unsupported(msg) then f.write_str("Unsupported: " + msg)
    when GpuError.ShaderCompilationError(msg) then f.write_str("Shader error: " + msg)
    when GpuError.PipelineError(msg) then f.write_str("Pipeline error: " + msg)
    when GpuError.SurfaceError(msg) then f.write_str("Surface error: " + msg)
    when GpuError.ValidationError(msg) then f.write_str("Validation: " + msg)
    when GpuError.Timeout then f.write_str("GPU timeout")
    end
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §2  Instance, Adapter, Device
# ═══════════════════════════════════════════════════════════════════════

pub struct InstanceConfig
  pub backend: Backend
  pub validation_layers: Bool
  pub debug_labels: Bool
  pub app_name: String
  pub app_version: (u32, u32, u32)
end

impl InstanceConfig
  pub def default() -> InstanceConfig
    InstanceConfig {
      backend: Backend.Auto,
      validation_layers: false,
      debug_labels: false,
      app_name: "Tangerine App".to_string(),
      app_version: (1, 0, 0),
    }
  end
end

pub struct GpuInstance
  _backend: Backend
  _handle: u64
end

impl GpuInstance
  pub def new(config: InstanceConfig) -> Result[GpuInstance, GpuError]
    let backend = if config.backend == Backend.Auto then
      _detect_best_backend()
    else
      config.backend
    end
    let handle = _backend_create_instance(backend, &config)?
    Ok(GpuInstance { _backend: backend, _handle: handle })
  end

  pub def enumerate_adapters(self) -> Result[Vec[GpuAdapter], GpuError]
    _backend_enumerate_adapters(self._backend, self._handle)
  end

  pub def backend(self) -> Backend = self._backend
end

impl Drop for GpuInstance
  def drop(&mut self)
    _backend_destroy_instance(self._backend, self._handle)
  end
end

pub struct AdapterInfo
  pub name: String
  pub vendor_id: u32
  pub device_id: u32
  pub device_type: DeviceType
  pub driver_version: String
  pub api_version: String
  pub dedicated_video_memory: u64
  pub dedicated_system_memory: u64
  pub shared_system_memory: u64
end

pub enum DeviceType
  DiscreteGpu
  IntegratedGpu
  VirtualGpu
  Cpu
  Other
end

pub struct GpuAdapter
  _backend: Backend
  _handle: u64
end

impl GpuAdapter
  pub def info(self) -> AdapterInfo
    _backend_adapter_info(self._backend, self._handle)
  end

  pub def request_device(self, features: DeviceFeatures) -> Result[GpuDevice, GpuError]
    let (dev_handle, queue_handle) = _backend_request_device(self._backend, self._handle, &features)?
    Ok(GpuDevice {
      _backend: self._backend,
      _handle: dev_handle,
      _queue: GpuQueue { _backend: self._backend, _handle: queue_handle },
      _features: features,
    })
  end
end

pub struct DeviceFeatures
  pub geometry_shader: Bool
  pub tessellation: Bool
  pub compute_shader: Bool
  pub multi_draw_indirect: Bool
  pub texture_compression_bc: Bool
  pub texture_compression_astc: Bool
  pub shader_float64: Bool
  pub shader_int16: Bool
  pub descriptor_indexing: Bool
  pub ray_tracing: Bool
  pub mesh_shading: Bool
  pub timeline_semaphore: Bool
end

impl DeviceFeatures
  pub def default() -> DeviceFeatures
    DeviceFeatures {
      geometry_shader: false, tessellation: false, compute_shader: true,
      multi_draw_indirect: false, texture_compression_bc: false,
      texture_compression_astc: false, shader_float64: false,
      shader_int16: false, descriptor_indexing: false,
      ray_tracing: false, mesh_shading: false, timeline_semaphore: false,
    }
  end
end

pub struct GpuDevice
  _backend: Backend
  _handle: u64
  _queue: GpuQueue
  _features: DeviceFeatures
end

impl GpuDevice
  pub def queue(self) -> &GpuQueue = &self._queue
  pub def features(self) -> &DeviceFeatures = &self._features

  pub def wait_idle(self) -> Result[Unit, GpuError]
    _backend_device_wait_idle(self._backend, self._handle)
  end
end

impl Drop for GpuDevice
  def drop(&mut self)
    let _ = self.wait_idle()
    _backend_destroy_device(self._backend, self._handle)
  end
end

pub struct GpuQueue
  _backend: Backend
  _handle: u64
end

impl GpuQueue
  pub def submit(self, commands: Vec[CommandBuffer]) -> Result[Unit, GpuError]
    _backend_queue_submit(self._backend, self._handle, &commands)
  end

  pub def submit_with_fence(self, commands: Vec[CommandBuffer], fence: &Fence) -> Result[Unit, GpuError]
    _backend_queue_submit_fence(self._backend, self._handle, &commands, fence._handle)
  end
end

# ═══════════════════════════════════════════════════════════════════════
# §3  Buffer Management
# ═══════════════════════════════════════════════════════════════════════

pub enum BufferUsage
  Vertex
  Index
  Uniform
  Storage
  Indirect
  TransferSrc
  TransferDst
end

pub enum MemoryLocation
  GpuOnly           ## Device-local, not host-visible
  CpuToGpu          ## Host-visible, host-coherent (staging/uniform)
  GpuToCpu          ## Host-visible, for readback
end

pub struct BufferDescriptor
  pub size: u64
  pub usage: Vec[BufferUsage]
  pub memory: MemoryLocation
  pub label: Option[String]
end

pub struct GpuBuffer
  _backend: Backend
  _handle: u64
  _size: u64
  _mapped: Option[*mut u8]
end

impl GpuBuffer
  pub def size(self) -> u64 = self._size

  ## Map buffer for CPU access. Returns a mutable byte slice.
  pub def map(self, offset: u64, size: u64) -> Result[&mut [u8], GpuError]
    pre offset + size <= self._size, "map region out of bounds"
    let ptr = _backend_buffer_map(self._backend, self._handle, offset, size)?
    Ok(unsafe { std::slice::from_raw_parts_mut(ptr, size as usize) })
  end

  /// Unmap a previously mapped buffer.
  pub def unmap(self)
    _backend_buffer_unmap(self._backend, self._handle)
  end

  /// Upload data from CPU memory to the buffer.
  pub def write(self, device: &GpuDevice, offset: u64, data: &[u8]) -> Result[Unit, GpuError]
    pre offset + data.len() as u64 <= self._size, "write out of bounds"
    _backend_buffer_write(self._backend, self._handle, offset, data)
  end

  /// Read data from buffer to CPU memory.
  pub def read(self, device: &GpuDevice, offset: u64, dest: &mut [u8]) -> Result[Unit, GpuError]
    pre offset + dest.len() as u64 <= self._size, "read out of bounds"
    _backend_buffer_read(self._backend, self._handle, offset, dest)
  end
end

impl Drop for GpuBuffer
  def drop(&mut self)
    _backend_destroy_buffer(self._backend, self._handle)
  end
end

## Create a GPU buffer.
pub def create_buffer(device: &GpuDevice, desc: &BufferDescriptor) -> Result[GpuBuffer, GpuError]
  let handle = _backend_create_buffer(device._backend, device._handle, desc)?
  Ok(GpuBuffer {
    _backend: device._backend,
    _handle: handle,
    _size: desc.size,
    _mapped: None,
  })
end

