end

pub struct PipelineLayout
  _backend: Backend
  _handle: u64
end

pub def create_pipeline_layout(device: &GpuDevice, bind_group_layouts: &[&BindGroupLayout], push_constants: &[PushConstantRange]) -> Result[PipelineLayout, GpuError]
  let handles: Vec[u64] = bind_group_layouts.iter().map(|l| l._handle).collect()
  let handle = _backend_create_pipeline_layout(device._backend, device._handle, &handles, push_constants)?
  Ok(PipelineLayout { _backend: device._backend, _handle: handle })
end

