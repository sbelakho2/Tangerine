  pub count: u32      ## Array count (1 for non-array)
end

pub struct BindGroupLayout
  _backend: Backend
  _handle: u64
end

pub def create_bind_group_layout(device: &GpuDevice, entries: &[BindGroupLayoutEntry]) -> Result[BindGroupLayout, GpuError]
  let handle = _backend_create_bind_group_layout(device._backend, device._handle, entries)?
  Ok(BindGroupLayout { _backend: device._backend, _handle: handle })
end

pub enum BindingResource
  BufferBinding { buffer: &GpuBuffer, offset: u64, size: u64 }
  TextureViewBinding(&TextureView)
  SamplerBinding(&GpuSampler)
end

pub struct BindGroupEntry
  pub binding: u32
