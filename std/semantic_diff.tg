# Tangerine Standard Library — std::semantic_diff
# Semantic comparison and diffing of Tangerine source code
#
# This module provides types and functions for computing meaningful
# diffs between code versions, focusing on semantic changes rather than
# just textual differences.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}

# ———————————————————————————————————————————————————————————————
# Core Types
# ———————————————————————————————————————————————————————————————

enum ChangeKind
  Added
  Removed
  Modified
  Renamed
  Moved
end

enum EntityKind
  Function
  Struct
  Enum
  Trait
  Impl
  Const
  Module
  Import
  Contract
  Capability
end

struct Entity
  kind: EntityKind
  name: String
  signature: String
  body_hash: Int
  line_start: Int
  line_end: Int
end

struct Change
  kind: ChangeKind
  entity_kind: EntityKind
  name: String
  old_signature: Option[String]
  new_signature: Option[String]
  description: String
end

struct SemanticDiff
  changes: Vec[Change]
  added_count: Int
  removed_count: Int
  modified_count: Int
end

enum DiffSeverity
  Breaking       # API-breaking change
  Compatible     # Backward-compatible change
  Internal       # Internal implementation change
  Cosmetic       # Formatting/comment only
end

struct AnnotatedChange
  change: Change
  severity: DiffSeverity
  impact: Option[String]
end

# ———————————————————————————————————————————————————————————————
# Entity Extraction
# ———————————————————————————————————————————————————————————————

def extract_entities(source: String) -> Vec[Entity]
  let mut entities = Vec::new()
  let lines = source.lines()
  let mut line_num = 0
  
  for line in lines
    line_num = line_num + 1
    let trimmed = line.trim()
    
    if trimmed.starts_with("def ")
      let entity = parse_function_entity(trimmed, line_num, source)
      entities.push(entity)
    elsif trimmed.starts_with("struct ")
      let entity = parse_struct_entity(trimmed, line_num, source)
      entities.push(entity)
    elsif trimmed.starts_with("enum ")
      let entity = parse_enum_entity(trimmed, line_num, source)
      entities.push(entity)
    elsif trimmed.starts_with("trait ")
      let entity = parse_trait_entity(trimmed, line_num, source)
      entities.push(entity)
    elsif trimmed.starts_with("impl ")
      let entity = parse_impl_entity(trimmed, line_num, source)
      entities.push(entity)
    elsif trimmed.starts_with("const ")
      let entity = parse_const_entity(trimmed, line_num)
      entities.push(entity)
    elsif trimmed.starts_with("cap ")
      let entity = parse_cap_entity(trimmed, line_num)
      entities.push(entity)
    end
  end
  
  entities
end

def parse_function_entity(line: String, start_line: Int, source: String) -> Entity
  let rest = line.slice(4, line.len())
  let paren_idx = rest.find("(").unwrap_or(rest.len())
  let name = rest.slice(0, paren_idx)
  let end_line = find_end_line(source, start_line)
  let body = extract_body(source, start_line, end_line)
  
  Entity {
    kind: EntityKind::Function,
    name: name,
    signature: line,
    body_hash: hash_string(body),
    line_start: start_line,
    line_end: end_line
  }
end

def parse_struct_entity(line: String, start_line: Int, source: String) -> Entity
  let rest = line.slice(7, line.len())
  let space_idx = rest.find_first_of(" [").unwrap_or(rest.len())
  let name = rest.slice(0, space_idx)
  let end_line = find_end_line(source, start_line)
  let body = extract_body(source, start_line, end_line)
  
  Entity {
    kind: EntityKind::Struct,
    name: name,
    signature: line,
    body_hash: hash_string(body),
    line_start: start_line,
    line_end: end_line
  }
end

def parse_enum_entity(line: String, start_line: Int, source: String) -> Entity
  let rest = line.slice(5, line.len())
  let space_idx = rest.find_first_of(" [").unwrap_or(rest.len())
  let name = rest.slice(0, space_idx)
  let end_line = find_end_line(source, start_line)
  let body = extract_body(source, start_line, end_line)
  
  Entity {
    kind: EntityKind::Enum,
    name: name,
    signature: line,
    body_hash: hash_string(body),
    line_start: start_line,
    line_end: end_line
  }
end

def parse_trait_entity(line: String, start_line: Int, source: String) -> Entity
  let rest = line.slice(6, line.len())
  let space_idx = rest.find_first_of(" [").unwrap_or(rest.len())
  let name = rest.slice(0, space_idx)
  let end_line = find_end_line(source, start_line)
  let body = extract_body(source, start_line, end_line)
  
  Entity {
    kind: EntityKind::Trait,
    name: name,
    signature: line,
    body_hash: hash_string(body),
    line_start: start_line,
    line_end: end_line
  }
end

def parse_impl_entity(line: String, start_line: Int, source: String) -> Entity
  let rest = line.slice(5, line.len())
  let end_line = find_end_line(source, start_line)
  let body = extract_body(source, start_line, end_line)
  
  Entity {
    kind: EntityKind::Impl,
    name: rest.trim(),
    signature: line,
    body_hash: hash_string(body),
    line_start: start_line,
    line_end: end_line
  }
end

def parse_const_entity(line: String, start_line: Int) -> Entity
  let rest = line.slice(6, line.len())
  let colon_idx = rest.find(":").unwrap_or(rest.find("=").unwrap_or(rest.len()))
  let name = rest.slice(0, colon_idx).trim()
  
  Entity {
    kind: EntityKind::Const,
    name: name,
    signature: line,
    body_hash: hash_string(line),
    line_start: start_line,
    line_end: start_line
  }
end

def parse_cap_entity(line: String, start_line: Int) -> Entity
  let rest = line.slice(4, line.len())
  let space_idx = rest.find(" ").unwrap_or(rest.len())
  let name = rest.slice(0, space_idx).trim()
  
  Entity {
    kind: EntityKind::Capability,
    name: name,
    signature: line,
    body_hash: hash_string(line),
    line_start: start_line,
    line_end: start_line
  }
end

def find_end_line(source: String, start_line: Int) -> Int
  let lines = source.lines()
  let mut depth = 0
  let mut line_num = 0
  let mut started = false
  
  for line in lines
    line_num = line_num + 1
    if line_num >= start_line
      let trimmed = line.trim()
      
      if !started
        started = true
        depth = 1
      else
        if trimmed == "end"
          depth = depth - 1
          if depth == 0
            return line_num
          end
        elsif trimmed.ends_with(" do") || 
                trimmed.starts_with("if ") || trimmed.starts_with("for ") ||
                trimmed.starts_with("while ") || trimmed.starts_with("match ") ||
                trimmed.starts_with("def ") || trimmed.starts_with("struct ") ||
                trimmed.starts_with("enum ") || trimmed.starts_with("trait ") ||
                trimmed.starts_with("impl ")
          depth = depth + 1
        end
      end
    end
  end
  
  line_num
end

def extract_body(source: String, start_line: Int, end_line: Int) -> String
  let lines = source.lines()
  let mut body = Vec::new()
  let mut line_num = 0
  
  for line in lines
    line_num = line_num + 1
    if line_num > start_line && line_num < end_line
      body.push(line)
    end
  end
  
  body.join("\n")
end

def hash_string(s: String) -> Int
  let mut hash = 0
  for c in s.chars()
    hash = hash * 31 + c.to_int()
  end
  hash
end

# ———————————————————————————————————————————————————————————————
# Diff Computation
# ———————————————————————————————————————————————————————————————

def compute_diff(old_source: String, new_source: String) -> SemanticDiff
  let old_entities = extract_entities(old_source)
  let new_entities = extract_entities(new_source)

  let mut old_by_name = Map::new()
  for e in &old_entities do
    old_by_name.insert(e.name.clone(), e.clone())
  end

  let mut new_by_name = Map::new()
  for e in &new_entities do
    new_by_name.insert(e.name.clone(), e.clone())
  end

  # Build index: (entity_kind, body_hash) → new entity name
  # for O(1) rename detection instead of O(n²)
  let mut new_by_hash: Map[String, Vec[Entity]] = Map::new()
  for e in &new_entities do
    if !old_by_name.contains_key(&e.name) then
      let key = entity_hash_key(&e)
      match new_by_hash.get_mut(&key)
      when Option::Some(list) then list.push(e.clone())
      when Option::None then new_by_hash.insert(key, vec![e.clone()])
      end
    end
  end

  let mut changes = Vec::new()
  mut renamed_targets: Map[String, Bool] = Map::new()
  let mut added = 0
  let mut removed = 0
  let mut modified = 0

  # Find removed and modified entities
  for old_e in &old_entities do
    match new_by_name.get(&old_e.name)
    when Option::Some(new_e) then
      if old_e.signature != new_e.signature then
        changes.push(Change {
          kind: ChangeKind::Modified,
          entity_kind: old_e.kind.clone(),
          name: old_e.name.clone(),
          old_signature: Option::Some(old_e.signature.clone()),
          new_signature: Option::Some(new_e.signature.clone()),
          description: "Signature changed"
        })
        modified = modified + 1
      elsif old_e.body_hash != new_e.body_hash then
        changes.push(Change {
          kind: ChangeKind::Modified,
          entity_kind: old_e.kind.clone(),
          name: old_e.name.clone(),
          old_signature: Option::Some(old_e.signature.clone()),
          new_signature: Option::Some(new_e.signature.clone()),
          description: "Implementation changed"
        })
        modified = modified + 1
      end
    when Option::None then
      # O(1) rename detection via hash index
      let key = entity_hash_key(&old_e)
      let mut found_rename = false
      match new_by_hash.get(&key)
      when Option::Some(candidates) then
        for cand in candidates do
          if !renamed_targets.contains_key(&cand.name) then
            changes.push(Change {
              kind: ChangeKind::Renamed,
              entity_kind: old_e.kind.clone(),
              name: old_e.name.clone(),
              old_signature: Option::Some(old_e.signature.clone()),
              new_signature: Option::Some(cand.signature.clone()),
              description: "Renamed to " + &cand.name
            })
            renamed_targets.insert(cand.name.clone(), true)
            found_rename = true
            break
          end
        end
      when Option::None then ()
      end

      if !found_rename then
        changes.push(Change {
          kind: ChangeKind::Removed,
          entity_kind: old_e.kind.clone(),
          name: old_e.name.clone(),
          old_signature: Option::Some(old_e.signature.clone()),
          new_signature: Option::None,
          description: "Removed"
        })
        removed = removed + 1
      end
    end
  end

  # Find added entities
  for new_e in &new_entities do
    if !old_by_name.contains_key(&new_e.name) then
      if !renamed_targets.contains_key(&new_e.name) then
        changes.push(Change {
          kind: ChangeKind::Added,
          entity_kind: new_e.kind.clone(),
          name: new_e.name.clone(),
          old_signature: Option::None,
          new_signature: Option::Some(new_e.signature.clone()),
          description: "Added"
        })
        added = added + 1
      end
    end
  end

  SemanticDiff {
    changes: changes,
    added_count: added,
    removed_count: removed,
    modified_count: modified
  }
end

def entity_hash_key(e: &Entity) -> String
  # Combine kind + body_hash for rename detection key
  e.kind.to_string() + ":" + e.body_hash.to_string()
end

# ———————————————————————————————————————————————————————————————
# Severity Analysis
# ———————————————————————————————————————————————————————————————

def classify_severity(change: Change) -> DiffSeverity
  match change.kind
    when ChangeKind::Removed then
      # Removing public API is breaking
      DiffSeverity::Breaking
    
    when ChangeKind::Added then
      # Adding is generally compatible
      DiffSeverity::Compatible
    
    when ChangeKind::Renamed then
      # Renaming public API is breaking
      DiffSeverity::Breaking
    
    when ChangeKind::Modified then
      # Check if signature changed (breaking) or just implementation (internal)
      match (change.old_signature, change.new_signature)
        when (Option::Some(old), Option::Some(new)) then
          if extract_api_signature(old) != extract_api_signature(new)
            DiffSeverity::Breaking
          else
            DiffSeverity::Internal
          end
        when _ then DiffSeverity::Internal
      end
    
    when ChangeKind::Moved then
      DiffSeverity::Compatible
  end
end

def extract_api_signature(sig: String) -> String
  # Extract just the parameter types and return type for comparison
  let paren_start = sig.find("(").unwrap_or(0)
  let paren_end = sig.find(")").unwrap_or(sig.len())
  let arrow_idx = sig.find("->").unwrap_or(sig.len())
  
  if arrow_idx < sig.len()
    sig.slice(paren_start, arrow_idx + 10)
  else
    sig.slice(paren_start, paren_end + 1)
  end
end

def annotate_changes(diff: SemanticDiff) -> Vec[AnnotatedChange]
  let mut annotated = Vec::new()
  
  for change in diff.changes
    let severity = classify_severity(change)
    let impact = match severity
      when DiffSeverity::Breaking then Option::Some("May break existing code")
      when DiffSeverity::Compatible then Option::Some("Safe to deploy")
      when DiffSeverity::Internal then Option::Some("No API impact")
      when DiffSeverity::Cosmetic then Option::None
    end
    
    annotated.push(AnnotatedChange {
      change: change,
      severity: severity,
      impact: impact
    })
  end
  
  annotated
end

# ———————————————————————————————————————————————————————————————
# Pretty Printing
# ———————————————————————————————————————————————————————————————

def format_entity_kind(kind: EntityKind) -> String
  match kind
    when EntityKind::Function then "function"
    when EntityKind::Struct then "struct"
    when EntityKind::Enum then "enum"
    when EntityKind::Trait then "trait"
    when EntityKind::Impl then "impl"
    when EntityKind::Const then "const"
    when EntityKind::Module then "module"
    when EntityKind::Import then "import"
    when EntityKind::Contract then "contract"
    when EntityKind::Capability then "capability"
  end
end

def format_change_kind(kind: ChangeKind) -> String
  match kind
    when ChangeKind::Added then "+"
    when ChangeKind::Removed then "-"
    when ChangeKind::Modified then "~"
    when ChangeKind::Renamed then "→"
    when ChangeKind::Moved then "↔"
  end
end

def format_severity(sev: DiffSeverity) -> String
  match sev
    when DiffSeverity::Breaking then "BREAKING"
    when DiffSeverity::Compatible then "compatible"
    when DiffSeverity::Internal then "internal"
    when DiffSeverity::Cosmetic then "cosmetic"
  end
end

def format_change(c: Change) -> String
  let kind_symbol = format_change_kind(c.kind)
  let entity = format_entity_kind(c.entity_kind)
  kind_symbol + " " + entity + " " + c.name + ": " + c.description
end

def format_annotated_change(ac: AnnotatedChange) -> String
  let base = format_change(ac.change)
  let sev = format_severity(ac.severity)
  "[" + sev + "] " + base
end

def format_diff(diff: SemanticDiff) -> String
  let mut lines = Vec::new()
  lines.push("=== Semantic Diff ===")
  lines.push("Added: " + diff.added_count.to_string())
  lines.push("Removed: " + diff.removed_count.to_string())
  lines.push("Modified: " + diff.modified_count.to_string())
  lines.push("")
  
  for change in diff.changes
    lines.push(format_change(change))
  end
  
  lines.join("\n")
end

def format_annotated_diff(changes: Vec[AnnotatedChange]) -> String
  let mut lines = Vec::new()
  lines.push("=== Annotated Diff ===")
  
  # Group by severity
  let mut breaking = Vec::new()
  let mut compatible = Vec::new()
  let mut internal = Vec::new()
  
  for ac in changes
    match ac.severity
      when DiffSeverity::Breaking then breaking.push(ac)
      when DiffSeverity::Compatible then compatible.push(ac)
      when DiffSeverity::Internal then internal.push(ac)
      when DiffSeverity::Cosmetic then ()
    end
  end
  
  if !breaking.is_empty()
    lines.push("\n⚠ Breaking Changes:")
    for ac in breaking
      lines.push("  " + format_annotated_change(ac))
    end
  end
  
  if !compatible.is_empty()
    lines.push("\n✓ Compatible Changes:")
    for ac in compatible
      lines.push("  " + format_annotated_change(ac))
    end
  end
  
  if !internal.is_empty()
    lines.push("\n○ Internal Changes:")
    for ac in internal
      lines.push("  " + format_annotated_change(ac))
    end
  end
  
  lines.join("\n")
end
