## std::semver — Semantic Versioning 2.0.0
## Full parser, comparison, and range matching per semver.org.
## Spec: §stdlib.semver

module std::semver

use std::core::{Option, Result, Ordering, Display, Eq, Ord, Hash, String, Int, UInt}
use std::fmt

# ─── Version ─────────────────────────────────────────────────────────

pub struct Version
  pub major: UInt
  pub minor: UInt
  pub patch: UInt
  pub pre: List[PreRelease]
  pub build: List[String]
end

pub enum PreRelease
  Num(UInt)
  Alpha(String)
end

impl Version
  pub def new(major: UInt, minor: UInt, patch: UInt) -> Version
    Version { major: major, minor: minor, patch: patch, pre: [], build: [] }
  end

  pub def parse(input: str) -> Result[Version, SemverError]
    let mut parser = SemverParser::new(input)
    parser.parse_version()
  end

  pub def is_prerelease(self) -> Bool
    !self.pre.is_empty()
  end

  ## Increment major (resets minor and patch to 0, clears pre/build).
  pub def increment_major(self) -> Version
    Version { major: self.major + 1, minor: 0, patch: 0, pre: [], build: [] }
  end

  ## Increment minor (resets patch to 0, clears pre/build).
  pub def increment_minor(self) -> Version
    Version { major: self.major, minor: self.minor + 1, patch: 0, pre: [], build: [] }
  end

  ## Increment patch (clears pre/build).
  pub def increment_patch(self) -> Version
    Version { major: self.major, minor: self.minor, patch: self.patch + 1, pre: [], build: [] }
  end

  ## Check if this version satisfies a requirement.
  pub def satisfies(self, req: Requirement) -> Bool
    req.matches(&self)
  end
end

impl Display for Version
  def to_string(self) -> String
    var s = self.major.to_string() + "." + self.minor.to_string() + "." + self.patch.to_string()
    if !self.pre.is_empty() then
      s = s + "-"
      for (i, p) in self.pre.iter().enumerate() do
        if i > 0 then s = s + "." end
        match p
        when Num(n) then s = s + n.to_string()
        when Alpha(a) then s = s + a
        end
      end
    end
    if !self.build.is_empty() then
      s = s + "+"
      for (i, b) in self.build.iter().enumerate() do
        if i > 0 then s = s + "." end
        s = s + b
      end
    end
    s
  end
end

impl Eq for Version
  def eq(self, other: Version) -> Bool
    ## Build metadata is IGNORED in equality per semver spec
    self.major == other.major &&
    self.minor == other.minor &&
    self.patch == other.patch &&
    self.pre == other.pre
  end
end

impl Hash for PreRelease
  def hash(self, inout state: Hasher) -> Unit
    match self
    when Num(n) then 0u8.hash(state); n.hash(state); ()
    when Alpha(a) then 1u8.hash(state); a.hash(state); ()
    end
  end
end

impl Ord for Version
  def cmp(self, other: Version) -> Ordering
    ## Compare major.minor.patch
    match self.major.cmp(&other.major)
    when Ordering::Less then return Ordering::Less
    when Ordering::Greater then return Ordering::Greater
    when Ordering::Equal then ()
    end

    match self.minor.cmp(&other.minor)
    when Ordering::Less then return Ordering::Less
    when Ordering::Greater then return Ordering::Greater
    when Ordering::Equal then ()
    end

    match self.patch.cmp(&other.patch)
    when Ordering::Less then return Ordering::Less
    when Ordering::Greater then return Ordering::Greater
    when Ordering::Equal then ()
    end

    ## Pre-release: having pre-release < not having pre-release
    match (self.pre.is_empty(), other.pre.is_empty())
    when (true, true) then return Ordering::Equal
    when (true, false) then return Ordering::Greater
    when (false, true) then return Ordering::Less
    when (false, false) then ()
    end

    ## Compare pre-release identifiers left-to-right
    let len = std::core::min(self.pre.len(), other.pre.len())
    for i in 0..len do
      match _cmp_pre(&self.pre[i], &other.pre[i])
      when Ordering::Equal then ()
      when let ord then return ord
      end
    end
    
    self.pre.len().cmp(&other.pre.len())
  end
end

impl Hash for Version
  def hash(self, inout state: Hasher) -> Unit
    self.major.hash(state)
    self.minor.hash(state)
    self.patch.hash(state)
    for p in self.pre.iter() do
      p.hash(state)
    end
  end
end

def _cmp_pre(a: PreRelease, b: PreRelease) -> Ordering
  match (a, b)
  when (Num(x), Num(y)) then x.cmp(y)
  when (Alpha(x), Alpha(y)) then x.cmp(y)
  when (Num(_), Alpha(_)) then Ordering::Less  ## numeric < alpha
  when (Alpha(_), Num(_)) then Ordering::Greater
  end
end

# ─── Version requirements & ranges ──────────────────────────────────

pub enum Comparator
  Exact(Version)       ## =1.2.3
  Greater(Version)     ## >1.2.3
  GreaterEq(Version)   ## >=1.2.3
  Less(Version)        ## <1.2.3
  LessEq(Version)      ## <=1.2.3
  Tilde(Version)       ## ~1.2.3 — patches only
  Caret(Version)       ## ^1.2.3 — compatible (default)
  Wildcard(UInt, Option[UInt])  ## 1.*, 1.2.*
end

pub struct Requirement
  pub comparators: List[List[Comparator]]  ## OR of AND groups (||)
end

impl Requirement
  pub def parse(input: str) -> Result[Requirement, SemverError]
    let mut parser = SemverParser::new(input)
    parser.parse_requirement()
  end

  pub def matches(self, version: Version) -> Bool
    ## Any OR group must match (all comparators in an AND group must match)
    for group_index in 0..self.comparators.len() do
      var all_match = true
      for comparator_index in 0..self.comparators[group_index].len() do
        if !_matches_comparator(&self.comparators[group_index][comparator_index], version) then
          all_match = false
          break
        end
      end
      if all_match then return true end
    end
    false
  end
end

impl Display for Requirement
  def to_string(self) -> String
    var groups: List[String] = List.new()
    for group_index in 0..self.comparators.len() do
      var parts: List[String] = List.new()
      for comparator_index in 0..self.comparators[group_index].len() do
        parts.push(_comparator_to_string(&self.comparators[group_index][comparator_index]))
      end
      groups.push(parts.join(", "))
    end
    groups.join(" || ")
  end
end

def _comparator_to_string(c: Comparator) -> String
  match c
  when Exact(v) then "=" + v.to_string()
  when Greater(v) then ">" + v.to_string()
  when GreaterEq(v) then ">=" + v.to_string()
  when Less(v) then "<" + v.to_string()
  when LessEq(v) then "<=" + v.to_string()
  when Tilde(v) then "~" + v.to_string()
  when Caret(v) then "^" + v.to_string()
  when Wildcard(major, minor) then
    match minor
    when Some(m) then major.to_string() + "." + m.to_string() + ".*"
    when None then major.to_string() + ".*"
    end
  end
end

def _matches_comparator(comp: Comparator, v: Version) -> Bool
  match comp
  when Exact(req) then v == req
  when Greater(req) then v > req
  when GreaterEq(req) then v >= req
  when Less(req) then v < req
  when LessEq(req) then v <= req
  when Tilde(req) then
    ## ~1.2.3 means >=1.2.3 && <1.3.0 (only patch-level changes)
    v >= req && v.major == req.major && v.minor == req.minor
  when Caret(req) then
    ## ^1.2.3 means >=1.2.3 && <2.0.0 (compatible with semver)
    ## ^0.2.3 means >=0.2.3 && <0.3.0
    ## ^0.0.3 means >=0.0.3 && <0.0.4
    if v < req then return false end
    if req.major != 0 then
      v.major == req.major
    else if req.minor != 0 then
      v.major == 0 && v.minor == req.minor
    else
      v.major == 0 && v.minor == 0 && v.patch == req.patch
    end
  when Wildcard(major, minor) then
    v.major == *major &&
    match minor
    when Some(m) then v.minor == *m
    when None then true
    end
  end
end

# ─── Parser ──────────────────────────────────────────────────────────

pub struct SemverError
  pub message: String
  pub position: UInt
end

impl Display for SemverError
  def to_string(self) -> String
    "semver error at position " + self.position.to_string() + ": " + self.message
  end
end

struct SemverParser
  input: String
  pos: UInt
end

impl SemverParser
  def new(input: str) -> SemverParser
    SemverParser { input: input.to_string(), pos: 0 }
  end

  def parse_version(inout self) -> Result[Version, SemverError]
    self.skip_whitespace()
    ## Optional leading 'v' or 'V'
    if self.peek() == Some('v') || self.peek() == Some('V') then
      self.advance()
    end

    let major = self.parse_num()?
    self.expect('.')?
    let minor = self.parse_num()?
    self.expect('.')?
    let patch = self.parse_num()?

    var pre: List[PreRelease] = List.new()
    if self.peek() == Some('-') then
      self.advance()
      pre = self.parse_pre_release()?
    end

    var build: List[String] = List.new()
    if self.peek() == Some('+') then
      self.advance()
      build = self.parse_build_metadata()?
    end

    Ok(Version { major: major, minor: minor, patch: patch, pre: pre, build: build })
  end

  def parse_requirement(inout self) -> Result[Requirement, SemverError]
    var or_groups: List[List[Comparator]] = List.new()
    loop
      let group = self.parse_and_group()?
      or_groups.push(group)
      self.skip_whitespace()
      if self.remaining().starts_with("||") then
        self.pos = self.pos + 2
      else
        break
      end
    end
    Ok(Requirement { comparators: or_groups })
  end

  def parse_and_group(inout self) -> Result[List[Comparator], SemverError]
    var comps: List[Comparator] = List.new()
    loop
      self.skip_whitespace()
      if self.is_eof() then break end
      if self.remaining().starts_with("||") then break end
      let comp = self.parse_comparator()?
      comps.push(comp)
      self.skip_whitespace()
      if self.peek() == Some(',') then
        self.advance()
      else if self.peek() == Some(' ') && !self.remaining().starts_with("||") then
        ## space-separated AND
      else
        break
      end
    end
    Ok(comps)
  end

  def parse_comparator(inout self) -> Result[Comparator, SemverError]
    self.skip_whitespace()
    if self.peek() == Some('^') then
      self.advance()
      let v = self.parse_version()?
      return Ok(Caret(v))
    end
    if self.peek() == Some('~') then
      self.advance()
      let v = self.parse_version()?
      return Ok(Tilde(v))
    end
    if self.remaining().starts_with(">=") then
      self.pos = self.pos + 2
      let v = self.parse_version()?
      return Ok(GreaterEq(v))
    end
    if self.remaining().starts_with("<=") then
      self.pos = self.pos + 2
      let v = self.parse_version()?
      return Ok(LessEq(v))
    end
    if self.peek() == Some('>') then
      self.advance()
      let v = self.parse_version()?
      return Ok(Greater(v))
    end
    if self.peek() == Some('<') then
      self.advance()
      let v = self.parse_version()?
      return Ok(Less(v))
    end
    if self.peek() == Some('=') then
      self.advance()
      let v = self.parse_version()?
      return Ok(Exact(v))
    end
    ## No operator: default to caret
    let v = self.parse_version()?
    Ok(Caret(v))
  end

  def parse_num(inout self) -> Result[UInt, SemverError]
    let start = self.pos
    while self.peek().map(|c| c.is_digit()).unwrap_or(false) do
      self.advance()
    end
    if self.pos == start then
      return Err(SemverError { message: "expected digit", position: self.pos })
    end
    let s = self.input.substring(start as Int, self.pos as Int)
    ## No leading zeros (except plain "0")
    if s.len() > 1 && s.starts_with("0") then
      return Err(SemverError { message: "leading zeros not allowed", position: start })
    end
    let mut value: UInt = 0
    for c in s.chars() do
      if c >= '0' && c <= '9' then
        value = value * 10 + (c as UInt - '0' as UInt)
      else
        return Err(SemverError { message: "invalid number", position: start })
      end
    end
    Ok(value)
  end

  def parse_pre_release(inout self) -> Result[List[PreRelease], SemverError]
    var identifiers: List[PreRelease] = List.new()
    loop
      let start = self.pos
      while self.peek().map(|c| c.is_alphanumeric() || c == '-').unwrap_or(false) do
        self.advance()
      end
      if self.pos == start then
        return Err(SemverError { message: "empty pre-release identifier", position: start })
      end
      let ident = self.input.substring(start as Int, self.pos as Int)
      ## Try to parse as number
      if ident.chars().all(|c| c.is_digit()) then
        if ident.len() > 1 && ident.starts_with("0") then
          return Err(SemverError { message: "leading zeros in numeric pre-release", position: start })
        end
        let mut value: UInt = 0
        for c in ident.chars() do
          value = value * 10 + (c as UInt - '0' as UInt)
        end
        identifiers.push(PreRelease::Num(value))
      else
        identifiers.push(PreRelease::Alpha(ident))
      end
      if self.peek() == Some('.') then
        self.advance()
      else
        break
      end
    end
    Ok(identifiers)
  end

  def parse_build_metadata(inout self) -> Result[List[String], SemverError]
    var identifiers: List[String] = List.new()
    loop
      let start = self.pos
      while self.peek().map(|c| c.is_alphanumeric() || c == '-').unwrap_or(false) do
        self.advance()
      end
      if self.pos == start then
        return Err(SemverError { message: "empty build identifier", position: start })
      end
      identifiers.push(self.input.substring(start as Int, self.pos as Int))
      if self.peek() == Some('.') then
        self.advance()
      else
        break
      end
    end
    Ok(identifiers)
  end

  def peek(self) -> Option[Char]
    if self.pos < self.input.len() as UInt then Some(self.input.char_at(self.pos)) else None end
  end

  def advance(inout self) -> Unit
    self.pos = self.pos + 1
  end

  def expect(inout self, ch: Char) -> Result[Unit, SemverError]
    if self.peek() == Some(ch) then
      self.advance()
      Ok(())
    else
      Err(SemverError { message: "expected '" + ch.to_string() + "'", position: self.pos })
    end
  end

  def skip_whitespace(inout self) -> Unit
    while self.peek() == Some(' ') || self.peek() == Some('\t') do
      self.advance()
    end
  end

  def remaining(self) -> String
    self.input.substring(self.pos as Int, self.input.len() as Int)
  end

  def is_eof(self) -> Bool
    self.pos >= self.input.len() as UInt
  end
end

# ─── Convenience ─────────────────────────────────────────────────────

## Parse a version string (sugar for Version.parse).
pub def parse(input: str) -> Result[Version, SemverError]
  Version.parse(input)
end

## Check if a version string satisfies a requirement string.
pub def satisfies(version: str, requirement: str) -> Result[Bool, SemverError]
  let v = Version.parse(version)?
  let r = Requirement.parse(requirement)?
  Ok(r.matches(&v))
end

## Find the maximum version from a list that satisfies a requirement.
pub def max_satisfying(versions: [String], requirement: str) -> Result[Option[Version], SemverError]
  let req = Requirement.parse(requirement)?
  var best: Option[Version] = None
  for vs in versions.iter() do
    match Version.parse(vs)
    when Ok(v) then
      if req.matches(&v) then
        match best
        when None then best = Some(v)
        when Some(b) then
          if v > b then best = Some(v) end
        end
      end
    when Err(_) then end  ## skip unparseable
  end
  Ok(best)
end

## Sort versions in ascending order.
pub def sort(inout versions: [Version]) -> Unit
  versions.sort_by(|a, b| a.cmp(b))
end

end ## module std::semver
