    0xb40bbe37u32, 0xc30c8ea1u32, 0x5a05df1bu32, 0x2d02ef8du32
  ]
end

def Crc32::new() -> Crc32
  Crc32 { state: 0xFFFFFFFFu32 }
end

def Crc32::update(self: &mut Crc32, bytes: &[u8]) -> Unit
  let table = CRC32_TABLE()
  for byte in bytes do
    let idx = ((self.state ^ (*byte as u32)) & 0xFF) as UInt
    self.state = table[idx] ^ (self.state >> 8)
  end
end

def Crc32::finish(self: &Crc32) -> u32
  self.state ^ 0xFFFFFFFFu32
end

def crc32(data: &[u8]) -> u32
  mut crc = Crc32::new()
  crc.update(data)
  crc.finish()
end

# ═══════════════════════════════════════════════════════════════
# CRC64
# ═══════════════════════════════════════════════════════════════

struct Crc64
  state: u64
end

def Crc64::new() -> Crc64
  Crc64 { state: 0xFFFFFFFFFFFFFFFFu64 }
end

def Crc64::update(self: &mut Crc64, bytes: &[u8]) -> Unit
  # CRC64-ECMA polynomial
  let poly = 0x42F0E1EBA9EA3693u64
  
  for byte in bytes do
    self.state = self.state ^ ((*byte as u64) << 56)
    mut i = 0
    while i < 8 do
      if (self.state & 0x8000000000000000u64) != 0 then
        self.state = (self.state << 1) ^ poly
      else
        self.state = self.state << 1
      end
      i = i + 1
    end
  end
end

def Crc64::finish(self: &Crc64) -> u64
  self.state ^ 0xFFFFFFFFFFFFFFFFu64
end

def crc64(data: &[u8]) -> u64
  mut crc = Crc64::new()
  crc.update(data)
  crc.finish()
end

# ═══════════════════════════════════════════════════════════════
# Adler-32
# ═══════════════════════════════════════════════════════════════

struct Adler32
  a: u16
  b: u16
end

def Adler32::new() -> Adler32
  Adler32 { a: 1, b: 0 }
end

def Adler32::update(self: &mut Adler32, bytes: &[u8]) -> Unit
  let mod_adler = 65521u32
  
  for byte in bytes do
    self.a = ((self.a as u32 + (*byte as u32)) % mod_adler) as u16
    self.b = ((self.b as u32 + (self.a as u32)) % mod_adler) as u16
  end
end

def Adler32::finish(self: &Adler32) -> u32
  ((self.b as u32) << 16) | (self.a as u32)
end

def adler32(data: &[u8]) -> u32
  mut adler = Adler32::new()
  adler.update(data)
  adler.finish()
end

# ═══════════════════════════════════════════════════════════════
# MD5 (Non-Cryptographic, for compatibility only)
# ═══════════════════════════════════════════════════════════════

struct Md5
  state: [u32; 4]
  count: u64
  buffer: [u8; 64]
  buffer_len: u8
end

def Md5::new() -> Md5
  Md5 {
    state: [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32],
    count: 0,
    buffer: [0u8; 64],
    buffer_len: 0
  }
end

def Md5::f(x: u32, y: u32, z: u32) -> u32
  (x & y) | ((!x) & z)
end

def Md5::g(x: u32, y: u32, z: u32) -> u32
  (x & z) | (y & (!z))
end

def Md5::h(x: u32, y: u32, z: u32) -> u32
  x ^ y ^ z
end

def Md5::i(x: u32, y: u32, z: u32) -> u32
  y ^ (x | (!z))
end

def Md5::rotate_left(x: u32, n: u32) -> u32
  (x << n) | (x >> (32 - n))
end

def Md5::ff(a: u32, b: u32, c: u32, d: u32, x: u32, s: u32, ac: u32) -> u32
  let a = a.wrapping_add(Md5::f(b, c, d)).wrapping_add(x).wrapping_add(ac)
  Md5::rotate_left(a, s).wrapping_add(b)
end

def Md5::gg(a: u32, b: u32, c: u32, d: u32, x: u32, s: u32, ac: u32) -> u32
  let a = a.wrapping_add(Md5::g(b, c, d)).wrapping_add(x).wrapping_add(ac)
  Md5::rotate_left(a, s).wrapping_add(b)
end

def Md5::hh(a: u32, b: u32, c: u32, d: u32, x: u32, s: u32, ac: u32) -> u32
  let a = a.wrapping_add(Md5::h(b, c, d)).wrapping_add(x).wrapping_add(ac)
  Md5::rotate_left(a, s).wrapping_add(b)
end

def Md5::ii(a: u32, b: u32, c: u32, d: u32, x: u32, s: u32, ac: u32) -> u32
  let a = a.wrapping_add(Md5::i(b, c, d)).wrapping_add(x).wrapping_add(ac)
  Md5::rotate_left(a, s).wrapping_add(b)
end

def Md5::transform(self: &mut Md5, block: &[u8; 64]) -> Unit
  # Decode block into 16 u32 values
  mut x: [u32; 16] = [0u32; 16]
  mut i = 0
  while i < 16 do
    x[i] = (block[i * 4] as u32) |
           ((block[i * 4 + 1] as u32) << 8) |
           ((block[i * 4 + 2] as u32) << 16) |
           ((block[i * 4 + 3] as u32) << 24)
    i = i + 1
  end
  
  mut a = self.state[0]
  mut b = self.state[1]
  mut c = self.state[2]
  mut d = self.state[3]
  
  # Round 1
  a = Md5::ff(a, b, c, d, x[0], 7, 0xd76aa478u32)
  d = Md5::ff(d, a, b, c, x[1], 12, 0xe8c7b756u32)
  c = Md5::ff(c, d, a, b, x[2], 17, 0x242070dbu32)
  b = Md5::ff(b, c, d, a, x[3], 22, 0xc1bdceeeu32)
  a = Md5::ff(a, b, c, d, x[4], 7, 0xf57c0fafu32)
  d = Md5::ff(d, a, b, c, x[5], 12, 0x4787c62au32)
  c = Md5::ff(c, d, a, b, x[6], 17, 0xa8304613u32)
  b = Md5::ff(b, c, d, a, x[7], 22, 0xfd469501u32)
  a = Md5::ff(a, b, c, d, x[8], 7, 0x698098d8u32)
  d = Md5::ff(d, a, b, c, x[9], 12, 0x8b44f7afu32)
  c = Md5::ff(c, d, a, b, x[10], 17, 0xffff5bb1u32)
  b = Md5::ff(b, c, d, a, x[11], 22, 0x895cd7beu32)
  a = Md5::ff(a, b, c, d, x[12], 7, 0x6b901122u32)
  d = Md5::ff(d, a, b, c, x[13], 12, 0xfd987193u32)
  c = Md5::ff(c, d, a, b, x[14], 17, 0xa679438eu32)
  b = Md5::ff(b, c, d, a, x[15], 22, 0x49b40821u32)
  
  # Round 2
  a = Md5::gg(a, b, c, d, x[1], 5, 0xf61e2562u32)
  d = Md5::gg(d, a, b, c, x[6], 9, 0xc040b340u32)
  c = Md5::gg(c, d, a, b, x[11], 14, 0x265e5a51u32)
  b = Md5::gg(b, c, d, a, x[0], 20, 0xe9b6c7aau32)
  a = Md5::gg(a, b, c, d, x[5], 5, 0xd62f105du32)
  d = Md5::gg(d, a, b, c, x[10], 9, 0x02441453u32)
  c = Md5::gg(c, d, a, b, x[15], 14, 0xd8a1e681u32)
  b = Md5::gg(b, c, d, a, x[4], 20, 0xe7d3fbc8u32)
  a = Md5::gg(a, b, c, d, x[9], 5, 0x21e1cde6u32)
  d = Md5::gg(d, a, b, c, x[14], 9, 0xc33707d6u32)
  c = Md5::gg(c, d, a, b, x[3], 14, 0xf4d50d87u32)
  b = Md5::gg(b, c, d, a, x[8], 20, 0x455a14edu32)
  a = Md5::gg(a, b, c, d, x[13], 5, 0xa9e3e905u32)
  d = Md5::gg(d, a, b, c, x[2], 9, 0xfcefa3f8u32)
  c = Md5::gg(c, d, a, b, x[7], 14, 0x676f02d9u32)
  b = Md5::gg(b, c, d, a, x[12], 20, 0x8d2a4c8au32)
  
  # Round 3
  a = Md5::hh(a, b, c, d, x[5], 4, 0xfffa3942u32)
  d = Md5::hh(d, a, b, c, x[8], 11, 0x8771f681u32)
  c = Md5::hh(c, d, a, b, x[11], 16, 0x6d9d6122u32)
  b = Md5::hh(b, c, d, a, x[14], 23, 0xfde5380cu32)
  a = Md5::hh(a, b, c, d, x[1], 4, 0xa4beea44u32)
  d = Md5::hh(d, a, b, c, x[4], 11, 0x4bdecfa9u32)
  c = Md5::hh(c, d, a, b, x[7], 16, 0xf6bb4b60u32)
  b = Md5::hh(b, c, d, a, x[10], 23, 0xbebfbc70u32)
  a = Md5::hh(a, b, c, d, x[13], 4, 0x289b7ec6u32)
  d = Md5::hh(d, a, b, c, x[0], 11, 0xeaa127fau32)
  c = Md5::hh(c, d, a, b, x[3], 16, 0xd4ef3085u32)
  b = Md5::hh(b, c, d, a, x[6], 23, 0x04881d05u32)
  a = Md5::hh(a, b, c, d, x[9], 4, 0xd9d4d039u32)
  d = Md5::hh(d, a, b, c, x[12], 11, 0xe6db99e5u32)
  c = Md5::hh(c, d, a, b, x[15], 16, 0x1fa27cf8u32)
  b = Md5::hh(b, c, d, a, x[2], 23, 0xc4ac5665u32)
  
  # Round 4
  a = Md5::ii(a, b, c, d, x[0], 6, 0xf4292244u32)
  d = Md5::ii(d, a, b, c, x[7], 10, 0x432aff97u32)
  c = Md5::ii(c, d, a, b, x[14], 15, 0xab9423a7u32)
  b = Md5::ii(b, c, d, a, x[5], 21, 0xfc93a039u32)
  a = Md5::ii(a, b, c, d, x[12], 6, 0x655b59c3u32)
  d = Md5::ii(d, a, b, c, x[3], 10, 0x8f0ccc92u32)
  c = Md5::ii(c, d, a, b, x[10], 15, 0xffeff47du32)
  b = Md5::ii(b, c, d, a, x[1], 21, 0x85845dd1u32)
  a = Md5::ii(a, b, c, d, x[8], 6, 0x6fa87e4fu32)
  d = Md5::ii(d, a, b, c, x[15], 10, 0xfe2ce6e0u32)
  c = Md5::ii(c, d, a, b, x[6], 15, 0xa3014314u32)
  b = Md5::ii(b, c, d, a, x[13], 21, 0x4e0811a1u32)
  a = Md5::ii(a, b, c, d, x[4], 6, 0xf7537e82u32)
  d = Md5::ii(d, a, b, c, x[11], 10, 0xbd3af235u32)
  c = Md5::ii(c, d, a, b, x[2], 15, 0x2ad7d2bbu32)
  b = Md5::ii(b, c, d, a, x[9], 21, 0xeb86d391u32)
  
  self.state[0] = self.state[0].wrapping_add(a)
  self.state[1] = self.state[1].wrapping_add(b)
  self.state[2] = self.state[2].wrapping_add(c)
  self.state[3] = self.state[3].wrapping_add(d)
end

def Md5::update(self: &mut Md5, bytes: &[u8]) -> Unit
  self.count = self.count + (bytes.len() as u64)
  
  mut offset = 0
  
  # Process buffered data first
  if self.buffer_len > 0 then
    let needed = 64 - (self.buffer_len as UInt)
    let available = if bytes.len() < needed then bytes.len() else needed end
    
    mut i = 0
    while i < available do
      self.buffer[(self.buffer_len as UInt) + i] = bytes[i]
      i = i + 1
    end
    
    self.buffer_len = (self.buffer_len as UInt + available) as u8
    offset = available
    
    if self.buffer_len == 64 then
      self.transform(&self.buffer)
      self.buffer_len = 0
    end
  end
  
  # Process full blocks
  while offset + 64 <= bytes.len() do
    mut block: [u8; 64] = [0u8; 64]
    mut i = 0
    while i < 64 do
      block[i] = bytes[offset + i]
      i = i + 1
    end
    self.transform(&block)
    offset = offset + 64
  end
  
  # Buffer remaining bytes
  while offset < bytes.len() do
    self.buffer[self.buffer_len as UInt] = bytes[offset]
    self.buffer_len = self.buffer_len + 1
    offset = offset + 1
  end
end

def Md5::finish(self: &Md5) -> [u8; 16]
  mut md5 = Md5 {
    state: self.state.clone(),
    count: self.count,
    buffer: self.buffer.clone(),
    buffer_len: self.buffer_len
  }
  
  # Pad message
  let pad_len = if (md5.count % 64) < 56 then 56 - (md5.count % 64) else 120 - (md5.count % 64) end
  
  mut padding: [u8; 72] = [0u8; 72]
  padding[0] = 0x80u8
  
  # Append length in bits (little-endian)
  let bit_len = md5.count * 8
  mut i = 0
  while i < 8 do
    padding[pad_len + i] = ((bit_len >> (i * 8)) & 0xFF) as u8
    i = i + 1
  end
  
  md5.update(&padding[0..pad_len + 8])
  
  # Output digest (little-endian)
  mut result: [u8; 16] = [0u8; 16]
  i = 0
  while i < 4 do
    result[i * 4] = (md5.state[i] & 0xFF) as u8
    result[i * 4 + 1] = ((md5.state[i] >> 8) & 0xFF) as u8
    result[i * 4 + 2] = ((md5.state[i] >> 16) & 0xFF) as u8
    result[i * 4 + 3] = ((md5.state[i] >> 24) & 0xFF) as u8
    i = i + 1
  end
  
  result
end

def md5(data: &[u8]) -> [u8; 16]
  mut hasher = Md5::new()
  hasher.update(data)
  hasher.finish()
end

def md5_hex(data: &[u8]) -> String
  let digest = md5(data)
  mut result = ""
  for byte in digest do
    result = result + byte.to_hex_string()
  end
  result
end

# ═══════════════════════════════════════════════════════════════
# SHA-256
# ═══════════════════════════════════════════════════════════════

struct Sha256
  state: [u32; 8]
  count: u64
  buffer: [u8; 64]
  buffer_len: u8
end

def Sha256::new() -> Sha256
  Sha256 {
    state: [
      0x6a09e667u32, 0xbb67ae85u32, 0x3c6ef372u32, 0xa54ff53au32,
      0x510e527fu32, 0x9b05688cu32, 0x1f83d9abu32, 0x5be0cd19u32
    ],
    count: 0,
    buffer: [0u8; 64],
    buffer_len: 0
  }
end

def Sha256::rotr(x: u32, n: u32) -> u32
  (x >> n) | (x << (32 - n))
end

def Sha256::ch(x: u32, y: u32, z: u32) -> u32
  (x & y) ^ ((!x) & z)
end

def Sha256::maj(x: u32, y: u32, z: u32) -> u32
  (x & y) ^ (x & z) ^ (y & z)
end

def Sha256::sigma0(x: u32) -> u32
  Sha256::rotr(x, 2) ^ Sha256::rotr(x, 13) ^ Sha256::rotr(x, 22)
end

def Sha256::sigma1(x: u32) -> u32
  Sha256::rotr(x, 6) ^ Sha256::rotr(x, 11) ^ Sha256::rotr(x, 25)
end

def Sha256::gamma0(x: u32) -> u32
  Sha256::rotr(x, 7) ^ Sha256::rotr(x, 18) ^ (x >> 3)
end

def Sha256::gamma1(x: u32) -> u32
  Sha256::rotr(x, 17) ^ Sha256::rotr(x, 19) ^ (x >> 10)
end

def Sha256::K() -> [u32; 64]
  [
    0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32,
    0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32,
    0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32,
    0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32,
    0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32,
    0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32,
    0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32,
    0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32,
    0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32,
    0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32,
    0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32,
    0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32,
    0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32,
    0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32,
    0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32,
    0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32
  ]
end

def Sha256::transform(self: &mut Sha256, block: &[u8; 64]) -> Unit
  let k = Sha256::K()
  
  mut w: [u32; 64] = [0u32; 64]
  
  # Prepare message schedule
  mut i = 0
  while i < 16 do
    w[i] = ((block[i * 4] as u32) << 24) |
           ((block[i * 4 + 1] as u32) << 16) |
           ((block[i * 4 + 2] as u32) << 8) |
           (block[i * 4 + 3] as u32)
    i = i + 1
  end
  
  i = 16
  while i < 64 do
    w[i] = Sha256::gamma1(w[i - 2]).wrapping_add(w[i - 7])
           .wrapping_add(Sha256::gamma0(w[i - 15]))
           .wrapping_add(w[i - 16])
    i = i + 1
  end
  
  mut a = self.state[0]
  mut b = self.state[1]
  mut c = self.state[2]
  mut d = self.state[3]
  mut e = self.state[4]
  mut f = self.state[5]
  mut g = self.state[6]
  mut h = self.state[7]
  
  i = 0
  while i < 64 do
    let t1 = h.wrapping_add(Sha256::sigma1(e))
             .wrapping_add(Sha256::ch(e, f, g))
             .wrapping_add(k[i])
             .wrapping_add(w[i])
    let t2 = Sha256::sigma0(a).wrapping_add(Sha256::maj(a, b, c))
    
    h = g
    g = f
    f = e
    e = d.wrapping_add(t1)
    d = c
    c = b
    b = a
    a = t1.wrapping_add(t2)
    
    i = i + 1
  end
  
  self.state[0] = self.state[0].wrapping_add(a)
  self.state[1] = self.state[1].wrapping_add(b)
  self.state[2] = self.state[2].wrapping_add(c)
  self.state[3] = self.state[3].wrapping_add(d)
  self.state[4] = self.state[4].wrapping_add(e)
  self.state[5] = self.state[5].wrapping_add(f)
  self.state[6] = self.state[6].wrapping_add(g)
  self.state[7] = self.state[7].wrapping_add(h)
end

def Sha256::update(self: &mut Sha256, bytes: &[u8]) -> Unit
  self.count = self.count + (bytes.len() as u64)
  
  mut offset = 0
  
  if self.buffer_len > 0 then
    let needed = 64 - (self.buffer_len as UInt)
    let available = if bytes.len() < needed then bytes.len() else needed end
    
    mut i = 0
    while i < available do
      self.buffer[(self.buffer_len as UInt) + i] = bytes[i]
      i = i + 1
    end
    
    self.buffer_len = (self.buffer_len as UInt + available) as u8
    offset = available
    
    if self.buffer_len == 64 then
      self.transform(&self.buffer)
      self.buffer_len = 0
    end
  end
  
  while offset + 64 <= bytes.len() do
    mut block: [u8; 64] = [0u8; 64]
    mut i = 0
    while i < 64 do
      block[i] = bytes[offset + i]
      i = i + 1
    end
    self.transform(&block)
    offset = offset + 64
  end
  
  while offset < bytes.len() do
    self.buffer[self.buffer_len as UInt] = bytes[offset]
    self.buffer_len = self.buffer_len + 1
    offset = offset + 1
  end
end

def Sha256::finish(self: &Sha256) -> [u8; 32]
  mut sha = Sha256 {
    state: self.state.clone(),
    count: self.count,
    buffer: self.buffer.clone(),
    buffer_len: self.buffer_len
  }
  
  let pad_len = if (sha.count % 64) < 56 then 56 - (sha.count % 64) else 120 - (sha.count % 64) end
  
  mut padding: [u8; 72] = [0u8; 72]
  padding[0] = 0x80u8
  
  let bit_len = sha.count * 8
  mut i = 0
  while i < 8 do
    padding[pad_len + 7 - i] = ((bit_len >> (i * 8)) & 0xFF) as u8
    i = i + 1
  end
  
  sha.update(&padding[0..pad_len + 8])
  
  mut result: [u8; 32] = [0u8; 32]
  i = 0
  while i < 8 do
    result[i * 4] = ((sha.state[i] >> 24) & 0xFF) as u8
    result[i * 4 + 1] = ((sha.state[i] >> 16) & 0xFF) as u8
    result[i * 4 + 2] = ((sha.state[i] >> 8) & 0xFF) as u8
    result[i * 4 + 3] = (sha.state[i] & 0xFF) as u8
    i = i + 1
  end
  
  result
end

def sha256(data: &[u8]) -> [u8; 32]
  mut hasher = Sha256::new()
  hasher.update(data)
  hasher.finish()
end

def sha256_hex(data: &[u8]) -> String
  let digest = sha256(data)
  mut result = ""
  for byte in digest do
    result = result + byte.to_hex_string()
  end
  result
end

# ═══════════════════════════════════════════════════════════════
# xxHash - Extremely Fast Non-Cryptographic Hash
# ═══════════════════════════════════════════════════════════════

struct XxHash32
  state: u32
  buffer: [u8; 16]
  buffer_len: u8
  total: u32
  seed: u32
end

def XxHash32::new() -> XxHash32
  XxHash32::with_seed(0)
end

def XxHash32::with_seed(seed: u32) -> XxHash32
  XxHash32 {
    state: 0,
    buffer: [0u8; 16],
    buffer_len: 0,
    total: 0,
    seed: seed
  }
end

def XxHash32::rotl(x: u32, r: u32) -> u32
  (x << r) | (x >> (32 - r))
end

def XxHash32::round(acc: u32, val: u32) -> u32
  let prime2 = 2246822519u32
  let prime3 = 3266489917u32
  
  let acc = acc.wrapping_add(val.wrapping_mul(prime2))
  XxHash32::rotl(acc, 13).wrapping_mul(prime3)
end

def XxHash32::update(self: &mut XxHash32, bytes: &[u8]) -> Unit
  self.total = self.total + (bytes.len() as u32)
  
  mut offset = 0
  
  if self.buffer_len > 0 then
    let needed = 16 - (self.buffer_len as UInt)
    let available = if bytes.len() < needed then bytes.len() else needed end
    
    mut i = 0
    while i < available do
      self.buffer[(self.buffer_len as UInt) + i] = bytes[i]
      i = i + 1
    end
    
    self.buffer_len = (self.buffer_len as UInt + available) as u8
    offset = available
    
    if self.buffer_len == 16 then
      let lane1 = u32::from_le_bytes(&self.buffer[0..4])
      let lane2 = u32::from_le_bytes(&self.buffer[4..8])
      let lane3 = u32::from_le_bytes(&self.buffer[8..12])
      let lane4 = u32::from_le_bytes(&self.buffer[12..16])
      
      self.state = XxHash32::round(self.state, lane1)
      self.state = XxHash32::round(self.state, lane2)
      self.state = XxHash32::round(self.state, lane3)
      self.state = XxHash32::round(self.state, lane4)
      
      self.buffer_len = 0
    end
  end
  
  while offset + 16 <= bytes.len() do
    let lane1 = u32::from_le_bytes(&bytes[offset..offset+4])
    let lane2 = u32::from_le_bytes(&bytes[offset+4..offset+8])
    let lane3 = u32::from_le_bytes(&bytes[offset+8..offset+12])
    let lane4 = u32::from_le_bytes(&bytes[offset+12..offset+16])
    
    self.state = XxHash32::round(self.state, lane1)
    self.state = XxHash32::round(self.state, lane2)
    self.state = XxHash32::round(self.state, lane3)
    self.state = XxHash32::round(self.state, lane4)
    
    offset = offset + 16
  end
  
  while offset < bytes.len() do
    self.buffer[self.buffer_len as UInt] = bytes[offset]
    self.buffer_len = self.buffer_len + 1
    offset = offset + 1
  end
end

def XxHash32::finish(self: &XxHash32) -> u32
  let prime1 = 2654435761u32
  let prime2 = 2246822519u32
  let prime3 = 3266489917u32
  let prime4 = 668265263u32
  let prime5 = 374761393u32
  
  mut h32 = if self.total >= 16 then
    self.state
  else
    self.seed.wrapping_add(prime5)
  end
  
  h32 = h32.wrapping_add(self.total)
  
  # Process remaining bytes in buffer
  mut offset = 0
  while offset + 4 <= (self.buffer_len as UInt) do
    let lane = u32::from_le_bytes(&self.buffer[offset..offset+4])
    h32 = h32.wrapping_add(lane.wrapping_mul(prime3))
    h32 = XxHash32::rotl(h32, 17).wrapping_mul(prime4)
    offset = offset + 4
  end
  
  while offset < (self.buffer_len as UInt) do
    h32 = h32.wrapping_add((self.buffer[offset] as u32).wrapping_mul(prime5))
    h32 = XxHash32::rotl(h32, 11).wrapping_mul(prime1)
    offset = offset + 1
  end
  
  # Final avalanche
  h32 = h32 ^ (h32 >> 15)
  h32 = h32.wrapping_mul(prime2)
  h32 = h32 ^ (h32 >> 13)
  h32 = h32.wrapping_mul(prime3)
  h32 = h32 ^ (h32 >> 16)
  
  h32
end

def xxhash32(data: &[u8]) -> u32
  xxhash32_with_seed(data, 0)
end

def xxhash32_with_seed(data: &[u8], seed: u32) -> u32
  mut hasher = XxHash32::with_seed(seed)
  hasher.update(data)
  hasher.finish()
end

# ═══════════════════════════════════════════════════════════════
# xxHash64
# ═══════════════════════════════════════════════════════════════

struct XxHash64
  state: u64
  v1: u64
  v2: u64
  v3: u64
  v4: u64
  buffer: [u8; 32]
  buffer_len: u8
  total: u64
  seed: u64
end

def XxHash64::new() -> XxHash64
  XxHash64::with_seed(0)
end

def XxHash64::with_seed(seed: u64) -> XxHash64
  let prime1 = 11400714785074694791u64
  let prime2 = 14029467366897019727u64
  
  XxHash64 {
    state: 0,
    v1: seed.wrapping_add(prime1).wrapping_add(prime2),
    v2: seed.wrapping_add(prime2),
    v3: seed,
    v4: seed.wrapping_sub(prime1),
    buffer: [0u8; 32],
    buffer_len: 0,
    total: 0,
    seed: seed
  }
end

def XxHash64::rotl(x: u64, r: u32) -> u64
  (x << r) | (x >> (64 - r))
end

def XxHash64::round(acc: u64, val: u64) -> u64
  let prime2 = 14029467366897019727u64
  let prime3 = 1609587929392839161u64
  
  let acc = acc.wrapping_add(val.wrapping_mul(prime2))
  XxHash64::rotl(acc, 31).wrapping_mul(prime3)
end

def XxHash64::merge_round(acc: u64, val: u64) -> u64
  let prime4 = 9650029242287828579u64
  let prime3 = 1609587929392839161u64
  
  let acc = acc.wrapping_add(XxHash64::round(0, val))
  XxHash64::rotl(acc, 17).wrapping_mul(prime4)
end

def XxHash64::update(self: &mut XxHash64, bytes: &[u8]) -> Unit
  self.total = self.total + (bytes.len() as u64)
  
  mut offset = 0
  
  if self.buffer_len > 0 then
    let needed = 32 - (self.buffer_len as UInt)
    let available = if bytes.len() < needed then bytes.len() else needed end
    
    mut i = 0
    while i < available do
      self.buffer[(self.buffer_len as UInt) + i] = bytes[i]
      i = i + 1
    end
    
    self.buffer_len = (self.buffer_len as UInt + available) as u8
    offset = available
    
    if self.buffer_len == 32 then
      self.v1 = XxHash64::round(self.v1, u64::from_le_bytes(&self.buffer[0..8]))
      self.v2 = XxHash64::round(self.v2, u64::from_le_bytes(&self.buffer[8..16]))
      self.v3 = XxHash64::round(self.v3, u64::from_le_bytes(&self.buffer[16..24]))
      self.v4 = XxHash64::round(self.v4, u64::from_le_bytes(&self.buffer[24..32]))
      
      self.buffer_len = 0
    end
  end
  
  while offset + 32 <= bytes.len() do
    self.v1 = XxHash64::round(self.v1, u64::from_le_bytes(&bytes[offset..offset+8]))
    self.v2 = XxHash64::round(self.v2, u64::from_le_bytes(&bytes[offset+8..offset+16]))
    self.v3 = XxHash64::round(self.v3, u64::from_le_bytes(&bytes[offset+16..offset+24]))
    self.v4 = XxHash64::round(self.v4, u64::from_le_bytes(&bytes[offset+24..offset+32]))
    
    offset = offset + 32
  end
  
  while offset < bytes.len() do
    self.buffer[self.buffer_len as UInt] = bytes[offset]
    self.buffer_len = self.buffer_len + 1
    offset = offset + 1
  end
end

def XxHash64::finish(self: &XxHash64) -> u64
  let prime1 = 11400714785074694791u64
  let prime2 = 14029467366897019727u64
  let prime3 = 1609587929392839161u64
  let prime4 = 9650029242287828579u64
  let prime5 = 2870177450012600261u64
  
  mut h64 = if self.total >= 32 then
    let h64 = XxHash64::rotl(self.v1, 1)
              .wrapping_add(XxHash64::rotl(self.v2, 7))
              .wrapping_add(XxHash64::rotl(self.v3, 12))
              .wrapping_add(XxHash64::rotl(self.v4, 18))
    
    let h64 = XxHash64::merge_round(h64, self.v1)
    let h64 = XxHash64::merge_round(h64, self.v2)
    let h64 = XxHash64::merge_round(h64, self.v3)
    XxHash64::merge_round(h64, self.v4)
  else
    self.seed.wrapping_add(prime5)
  end
  
  h64 = h64.wrapping_add(self.total)
  
  # Process remaining bytes
  mut offset = 0
  while offset + 8 <= (self.buffer_len as UInt) do
    h64 = h64.wrapping_add(XxHash64::round(0, u64::from_le_bytes(&self.buffer[offset..offset+8])))
    h64 = XxHash64::rotl(h64, 27).wrapping_mul(prime4)
    h64 = h64.wrapping_add(prime2)
    offset = offset + 8
  end
  
  while offset + 4 <= (self.buffer_len as UInt) do
    h64 = h64.wrapping_add((u32::from_le_bytes(&self.buffer[offset..offset+4]) as u64).wrapping_mul(prime1))
    h64 = XxHash64::rotl(h64, 23).wrapping_mul(prime2)
    h64 = h64.wrapping_add(prime3)
    offset = offset + 4
  end
  
  while offset < (self.buffer_len as UInt) do
    h64 = h64.wrapping_add((self.buffer[offset] as u64).wrapping_mul(prime5))
    h64 = XxHash64::rotl(h64, 11).wrapping_mul(prime1)
    offset = offset + 1
  end
  
  # Final avalanche
  h64 = h64 ^ (h64 >> 33)
  h64 = h64.wrapping_mul(prime2)
  h64 = h64 ^ (h64 >> 29)
  h64 = h64.wrapping_mul(prime3)
  h64 = h64 ^ (h64 >> 32)
  
  h64
end

def xxhash64(data: &[u8]) -> u64
  xxhash64_with_seed(data, 0)
end

def xxhash64_with_seed(data: &[u8], seed: u64) -> u64
  mut hasher = XxHash64::with_seed(seed)
  hasher.update(data)
  hasher.finish()
end

# ═══════════════════════════════════════════════════════════════
# WyHash - Fast High-Quality Hash
# ═══════════════════════════════════════════════════════════════

struct WyHash
  seed: u64
  buffer: [u8; 48]
  buffer_len: u8
  total: u64
end

def WyHash::new() -> WyHash
  WyHash::with_seed(0)
end

def WyHash::with_seed(seed: u64) -> WyHash
  WyHash {
    seed: seed,
    buffer: [0u8; 48],
    buffer_len: 0,
    total: 0
  }
end

def WyHash::wyr8(p: &[u8]) -> u64
  u64::from_le_bytes(p)
end

def WyHash::wyr4(p: &[u8]) -> u64
  (u32::from_le_bytes(p) as u64)
end

def WyHash::wyr3(p: &[u8], k: u64) -> u64
  ((p[0] as u64) << 16) | ((p[k as UInt >> 1] as u64) << 8) | (p[(k - 1) as UInt] as u64)
end

def WyHash::wymum(a: u64, b: u64) -> u64
  let r = (a as u128) * (b as u128)
  (r >> 64) ^ (r & 0xFFFFFFFFFFFFFFFFu128 as u64)
end

def WyHash::update(self: &mut WyHash, bytes: &[u8]) -> Unit
  self.total = self.total + (bytes.len() as u64)
  
  mut offset = 0
  
  if self.buffer_len > 0 then
    let needed = 48 - (self.buffer_len as UInt)
    let available = if bytes.len() < needed then bytes.len() else needed end
    
    mut i = 0
    while i < available do
      self.buffer[(self.buffer_len as UInt) + i] = bytes[i]
      i = i + 1
    end
    
    self.buffer_len = (self.buffer_len as UInt + available) as u8
    offset = available
    
    if self.buffer_len == 48 then
      self.buffer_len = 0
    end
  end
  
  while offset < bytes.len() do
    if self.buffer_len < 48 then
      self.buffer[self.buffer_len as UInt] = bytes[offset]
      self.buffer_len = self.buffer_len + 1
    end
    offset = offset + 1
  end
end

def WyHash::finish(self: &WyHash) -> u64
  let p0 = 0xa0761d6478bd642fu64
  let p1 = 0xe7037ed1a0b428dbu64
  let p2 = 0x8ebc6af09c88c6e3u64
  let p3 = 0x589965cc75374cc3u64
  let p4 = 0x1d8e4e27c47d124fu64
  
  let mut see1 = self.seed
  
  mut i = 0
  let len = self.buffer_len as UInt
  
  if len < 16 then
    if len < 4 then
      if len > 0 then
        see1 = WyHash::wymum(see1 ^ p0, WyHash::wyr3(&self.buffer[0..len], len as u64) ^ p1)
      else
        see1 = 0
      end
    else
      see1 = WyHash::wymum(see1 ^ p0, WyHash::wyr4(&self.buffer[0..4]) ^ WyHash::wyr4(&self.buffer[len-4..len]) ^ p1)
    end
  else
    let mut a = see1
    let mut b = see1
    
    while i + 16 <= len do
      a = a ^ WyHash::wymum(WyHash::wyr8(&self.buffer[i..i+8]), p1)
      b = b ^ WyHash::wymum(WyHash::wyr8(&self.buffer[i+8..i+16]), p2)
      i = i + 16
    end
    
    see1 = a ^ b
  end
  
  see1 = see1 ^ (self.total ^ p4)
  WyHash::wymum(see1 ^ p0, see1 ^ p3)
end

def wyhash(data: &[u8]) -> u64
  wyhash_with_seed(data, 0)
end

def wyhash_with_seed(data: &[u8], seed: u64) -> u64
  mut hasher = WyHash::with_seed(seed)
  hasher.update(data)
  hasher.finish()
end