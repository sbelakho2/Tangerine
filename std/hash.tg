# Tangerine Standard Library — tg::hash
# Hashing Algorithms and Hash Trait
#
# This module provides hashing support including:
#   - Hash and Hasher traits for custom hashable types
#   - SipHash 2-4 (default, cryptographically strong)
#   - SipHash 1-3 (faster variant)
#   - FxHash (very fast, non-cryptographic)
#   - xxHash32/64 (extremely fast)
#   - WyHash (fast, high quality)
#   - CRC32, CRC64, Adler-32 (checksums)
#   - MD5, SHA-256 (for compatibility, not recommended for security)
#
# Example:
#   use std::hash::{hash, DefaultHasher}
#   
#   let h = hash("hello world")
#   println("hash: " + h.to_string())
#
#   # Custom hasher
#   mut hasher = DefaultHasher::new()
#   hasher.write("hello".as_bytes())
#   let result = hasher.finish()

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, u8, u32, u64, i8, i16, i32, i64, f32, f64}
use std::ffi::{c_void, c_int}

# [METADATA]
# module: tg::hash
# status: stable
# effects: [Hash]
# capabilities: [hashing]

# ═══════════════════════════════════════════════════════════════
# Hash Trait
# ═══════════════════════════════════════════════════════════════

## A trait for types that can be hashed.
## 
## Implement this trait for custom types to enable them to be used
## as hash map keys or in hash sets.
## 
## Example:
##   impl Hash for MyStruct
##     def hash[H: Hasher](self: &MyStruct, state: &mut H) -> Unit
##       self.field1.hash(state)
##       self.field2.hash(state)
##     end
##   end
trait Hash
  def hash[H: Hasher](self: &Self, state: &mut H) -> Unit
end

## A trait for hashers.
## 
## Hashers accumulate bytes and produce a final u64 hash value.
## Implement this to create custom hashing algorithms.
trait Hasher
  ## Write bytes into the hasher state.
  def write(self: &mut Self, bytes: &[u8]) -> Unit
  
  ## Finish hashing and return the computed hash value.
  ## Consumes the hasher state.
  def finish(self: &Self) -> u64
end

# ═══════════════════════════════════════════════════════════════
# Default Hasher - SipHash 2-4
# ═══════════════════════════════════════════════════════════════

struct DefaultHasher
  # SipHash state
  v0: u64
  v1: u64
  v2: u64
  v3: u64
  # Buffer for partial blocks
  buffer: [u8; 8]
  buffer_len: u8
  # Total bytes processed
  total: u64
end

# SipHash constants
def SIPHASH_KEY0() -> u64 = 0x736f6d6570736575u64
def SIPHASH_KEY1() -> u64 = 0x646f72616e646f6du64
def SIPHASH_C() -> u64 = 0x7465646279746573u64

def DefaultHasher::new() -> DefaultHasher
  # Initialize with default keys (for reproducibility)
  let k0 = 0x0102030405060708u64
  let k1 = 0x090a0b0c0d0e0f10u64
  
  DefaultHasher {
    v0: k0 ^ SIPHASH_KEY0(),
    v1: k1 ^ SIPHASH_KEY1(),
    v2: k0 ^ SIPHASH_C(),
    v3: k1 ^ SIPHASH_KEY0(),
    buffer: [0u8; 8],
    buffer_len: 0,
    total: 0
  }
end

def DefaultHasher::with_keys(k0: u64, k1: u64) -> DefaultHasher
  DefaultHasher {
    v0: k0 ^ SIPHASH_KEY0(),
    v1: k1 ^ SIPHASH_KEY1(),
    v2: k0 ^ SIPHASH_C(),
    v3: k1 ^ SIPHASH_KEY0(),
    buffer: [0u8; 8],
    buffer_len: 0,
    total: 0
  }
end

def u64.rotl(self: u64, n: u32) -> u64
  (self << n) | (self >> (64 - n))
end

def DefaultHasher::sip_round(self: &mut DefaultHasher) -> Unit
  self.v0 = self.v0.wrapping_add(self.v1)
  self.v1 = self.v1.rotl(13)
  self.v1 = self.v1 ^ self.v0
  self.v0 = self.v0.rotl(32)
  
  self.v2 = self.v2.wrapping_add(self.v3)
  self.v3 = self.v3.rotl(16)
  self.v3 = self.v3 ^ self.v2
  
  self.v0 = self.v0.wrapping_add(self.v3)
  self.v3 = self.v3.rotl(21)
  self.v3 = self.v3 ^ self.v0
  
  self.v2 = self.v2.wrapping_add(self.v1)
  self.v1 = self.v1.rotl(17)
  self.v1 = self.v1 ^ self.v2
  self.v2 = self.v2.rotl(32)
end

def DefaultHasher::sip_round_2(self: &mut DefaultHasher) -> Unit
  self.sip_round()
  self.sip_round()
end

def DefaultHasher::sip_round_4(self: &mut DefaultHasher) -> Unit
  self.sip_round_2()
  self.sip_round_2()
end

def u64.from_le_bytes(bytes: &[u8]) -> u64
  (bytes[0] as u64) |
  ((bytes[1] as u64) << 8) |
  ((bytes[2] as u64) << 16) |
  ((bytes[3] as u64) << 24) |
  ((bytes[4] as u64) << 32) |
  ((bytes[5] as u64) << 40) |
  ((bytes[6] as u64) << 48) |
  ((bytes[7] as u64) << 56)
end

def DefaultHasher::process_block(self: &mut DefaultHasher, block: u64) -> Unit
  self.v3 = self.v3 ^ block
  self.sip_round_2()
  self.v0 = self.v0 ^ block
end

def DefaultHasher::write(self: &mut DefaultHasher, bytes: &[u8]) -> Unit
  self.total = self.total + (bytes.len() as u64)
  
  mut offset = 0
  
  # Handle buffered data first
  if self.buffer_len > 0 then
    let needed = 8 - (self.buffer_len as UInt)
    let available = if bytes.len() < needed then bytes.len() else needed end
    
    mut i = 0
    while i < available do
      self.buffer[(self.buffer_len as UInt) + i] = bytes[i]
      i = i + 1
    end
    
    self.buffer_len = (self.buffer_len as UInt + available) as u8
    offset = available
    
    if self.buffer_len == 8 then
      let block = u64::from_le_bytes(&self.buffer)
      self.process_block(block)
      self.buffer_len = 0
    end
  end
  
  # Process full 8-byte blocks
  while offset + 8 <= bytes.len() do
    let block = u64::from_le_bytes(&bytes[offset..offset+8])
    self.process_block(block)
    offset = offset + 8
  end
  
  # Buffer remaining bytes
  while offset < bytes.len() do
    self.buffer[self.buffer_len as UInt] = bytes[offset]
    self.buffer_len = self.buffer_len + 1
    offset = offset + 1
  end
end

def DefaultHasher::finish(self: &DefaultHasher) -> u64
  mut hasher = self.clone()
  
  # Build final block with length encoding
  mut final_block: [u8; 8] = [0u8; 8]
  mut i = 0
  while i < (self.buffer_len as UInt) do
    final_block[i] = self.buffer[i]
    i = i + 1
  end
  
  # Encode length in low bits
  let len_byte = ((self.total & 0xFF) << (self.buffer_len as u64 * 8)) as u8
  final_block[(self.buffer_len as UInt)] = len_byte
  
  let block = u64::from_le_bytes(&final_block)
  
  hasher.v3 = hasher.v3 ^ block
  hasher.sip_round_2()
  hasher.v0 = hasher.v0 ^ block
  
  # Finalization
  hasher.v2 = hasher.v2 ^ 0xFF
  
  hasher.sip_round_4()
  
  hasher.v0 ^ hasher.v1 ^ hasher.v2 ^ hasher.v3
end

def DefaultHasher::clone(self: &DefaultHasher) -> DefaultHasher
  DefaultHasher {
    v0: self.v0,
    v1: self.v1,
    v2: self.v2,
    v3: self.v3,
    buffer: self.buffer.clone(),
    buffer_len: self.buffer_len,
    total: self.total
  }
end

# ═══════════════════════════════════════════════════════════════
# FxHash - Fast Non-Cryptographic Hash
# ═══════════════════════════════════════════════════════════════

struct FxHasher
  hash: u64
end

def FxHasher::new() -> FxHasher
  FxHasher { hash: 0 }
end

def FxHasher::write(self: &mut FxHasher, bytes: &[u8]) -> Unit
  mut i = 0
  while i + 8 <= bytes.len() do
    let val = u64::from_le_bytes(&bytes[i..i+8])
    self.add_u64(val)
    i = i + 8
  end
  
  while i < bytes.len() do
    self.hash = self.hash ^ ((bytes[i] as u64) << ((i % 8) * 8))
    i = i + 1
  end
end

def FxHasher::add_u64(self: &mut FxHasher, val: u64) -> Unit
  self.hash = self.hash.rotate_left(5)
  self.hash = self.hash ^ val
  self.hash = self.hash.wrapping_mul(0x517cc1b727220a95u64)
end

def FxHasher::add_u32(self: &mut FxHasher, val: u32) -> Unit
  self.hash = self.hash.rotate_left(5)
  self.hash = self.hash ^ (val as u64)
  self.hash = self.hash.wrapping_mul(0x517cc1b727220a95u64)
end

def FxHasher::finish(self: &FxHasher) -> u64
  self.hash
end

# ═══════════════════════════════════════════════════════════════
# SipHash 1-3 (Faster variant)
# ═══════════════════════════════════════════════════════════════

struct SipHasher13
  v0: u64
  v1: u64
  v2: u64
  v3: u64
  buffer: [u8; 8]
  buffer_len: u8
  total: u64
end

def SipHasher13::new() -> SipHasher13
  SipHasher13::with_keys(0, 0)
end

def SipHasher13::with_keys(k0: u64, k1: u64) -> SipHasher13
  SipHasher13 {
    v0: k0 ^ SIPHASH_KEY0(),
    v1: k1 ^ SIPHASH_KEY1(),
    v2: k0 ^ SIPHASH_C(),
    v3: k1 ^ SIPHASH_KEY0(),
    buffer: [0u8; 8],
    buffer_len: 0,
    total: 0
  }
end

def SipHasher13::sip_round(self: &mut SipHasher13) -> Unit
  self.v0 = self.v0.wrapping_add(self.v1)
  self.v1 = self.v1.rotl(13)
  self.v1 = self.v1 ^ self.v0
  self.v0 = self.v0.rotl(32)
  
  self.v2 = self.v2.wrapping_add(self.v3)
  self.v3 = self.v3.rotl(16)
  self.v3 = self.v3 ^ self.v2
  
  self.v0 = self.v0.wrapping_add(self.v3)
  self.v3 = self.v3.rotl(21)
  self.v3 = self.v3 ^ self.v0
  
  self.v2 = self.v2.wrapping_add(self.v1)
  self.v1 = self.v1.rotl(17)
  self.v1 = self.v1 ^ self.v2
  self.v2 = self.v2.rotl(32)
end

def SipHasher13::write(self: &mut SipHasher13, bytes: &[u8]) -> Unit
  self.total = self.total + (bytes.len() as u64)
  
  mut offset = 0
  
  if self.buffer_len > 0 then
    let needed = 8 - (self.buffer_len as UInt)
    let available = if bytes.len() < needed then bytes.len() else needed end
    
    mut i = 0
    while i < available do
      self.buffer[(self.buffer_len as UInt) + i] = bytes[i]
      i = i + 1
    end
    
    self.buffer_len = (self.buffer_len as UInt + available) as u8
    offset = available
    
    if self.buffer_len == 8 then
      let block = u64::from_le_bytes(&self.buffer)
      self.v3 = self.v3 ^ block
      self.sip_round()
      self.v0 = self.v0 ^ block
      self.buffer_len = 0
    end
  end
  
  while offset + 8 <= bytes.len() do
    let block = u64::from_le_bytes(&bytes[offset..offset+8])
    self.v3 = self.v3 ^ block
    self.sip_round()
    self.v0 = self.v0 ^ block
    offset = offset + 8
  end
  
  while offset < bytes.len() do
    self.buffer[self.buffer_len as UInt] = bytes[offset]
    self.buffer_len = self.buffer_len + 1
    offset = offset + 1
  end
end

def SipHasher13::finish(self: &SipHasher13) -> u64
  mut hasher = SipHasher13 {
    v0: self.v0,
    v1: self.v1,
    v2: self.v2,
    v3: self.v3,
    buffer: self.buffer.clone(),
    buffer_len: self.buffer_len,
    total: self.total
  }
  
  mut final_block: [u8; 8] = [0u8; 8]
  mut i = 0
  while i < (self.buffer_len as UInt) do
    final_block[i] = self.buffer[i]
    i = i + 1
  end
  
  let len_byte = ((self.total & 0xFF) << (self.buffer_len as u64 * 8)) as u8
  final_block[(self.buffer_len as UInt)] = len_byte
  
  let block = u64::from_le_bytes(&final_block)
  
  hasher.v3 = hasher.v3 ^ block
  hasher.sip_round()
  hasher.v0 = hasher.v0 ^ block
  
  hasher.v2 = hasher.v2 ^ 0xFF
  
  hasher.sip_round()
  hasher.sip_round()
  hasher.sip_round()
  
  hasher.v0 ^ hasher.v1 ^ hasher.v2 ^ hasher.v3
end

# ═══════════════════════════════════════════════════════════════
# Hash Implementations for Primitive Types
# ═══════════════════════════════════════════════════════════════

impl Hash for u8
  def hash[H: Hasher](self: &u8, state: &mut H) -> Unit
    state.write(&[*self])
  end
end

impl Hash for u16
  def hash[H: Hasher](self: &u16, state: &mut H) -> Unit
    mut bytes: [u8; 2] = [0u8; 2]
    bytes[0] = (self & 0xFF) as u8
    bytes[1] = ((self >> 8) & 0xFF) as u8
    state.write(&bytes)
  end
end

impl Hash for u32
  def hash[H: Hasher](self: &u32, state: &mut H) -> Unit
    mut bytes: [u8; 4] = [0u8; 4]
    bytes[0] = (self & 0xFF) as u8
    bytes[1] = ((self >> 8) & 0xFF) as u8
    bytes[2] = ((self >> 16) & 0xFF) as u8
    bytes[3] = ((self >> 24) & 0xFF) as u8
    state.write(&bytes)
  end
end

impl Hash for u64
  def hash[H: Hasher](self: &u64, state: &mut H) -> Unit
    mut bytes: [u8; 8] = [0u8; 8]
    bytes[0] = (self & 0xFF) as u8
    bytes[1] = ((self >> 8) & 0xFF) as u8
    bytes[2] = ((self >> 16) & 0xFF) as u8
    bytes[3] = ((self >> 24) & 0xFF) as u8
    bytes[4] = ((self >> 32) & 0xFF) as u8
    bytes[5] = ((self >> 40) & 0xFF) as u8
    bytes[6] = ((self >> 48) & 0xFF) as u8
    bytes[7] = ((self >> 56) & 0xFF) as u8
    state.write(&bytes)
  end
end

impl Hash for i8
  def hash[H: Hasher](self: &i8, state: &mut H) -> Unit
    (*self as u8).hash(state)
  end
end

impl Hash for i16
  def hash[H: Hasher](self: &i16, state: &mut H) -> Unit
    (*self as u16).hash(state)
  end
end

impl Hash for i32
  def hash[H: Hasher](self: &i32, state: &mut H) -> Unit
    (*self as u32).hash(state)
  end
end

impl Hash for i64
  def hash[H: Hasher](self: &i64, state: &mut H) -> Unit
    (*self as u64).hash(state)
  end
end

impl Hash for Int
  def hash[H: Hasher](self: &Int, state: &mut H) -> Unit
    (*self as i64).hash(state)
  end
end

impl Hash for UInt
  def hash[H: Hasher](self: &UInt, state: &mut H) -> Unit
    (*self as u64).hash(state)
  end
end

impl Hash for Bool
  def hash[H: Hasher](self: &Bool, state: &mut H) -> Unit
    (if *self then 1u8 else 0u8 end).hash(state)
  end
end

impl Hash for f32
  def hash[H: Hasher](self: &f32, state: &mut H) -> Unit
    # Hash the bit representation
    let bits = std::mem::transmute::[f32, u32](*self)
    bits.hash(state)
  end
end

impl Hash for f64
  def hash[H: Hasher](self: &f64, state: &mut H) -> Unit
    let bits = std::mem::transmute::[f64, u64](*self)
    bits.hash(state)
  end
end

impl Hash for String
  def hash[H: Hasher](self: &String, state: &mut H) -> Unit
    let len = self.len()
    (len as u64).hash(state)

    let ptr = self.as_ptr()
    mut i = 0
    while i < len do
      let byte = *(ptr.offset(i))
      let chunk: [u8; 1] = [byte]
      state.write(&chunk)
      i = i + 1
    end
  end
end

impl[T: Hash] Hash for Vec[T]
  def hash[H: Hasher](self: &Vec[T], state: &mut H) -> Unit
    (self.len() as u64).hash(state)
    for item in self do
      item.hash(state)
    end
  end
end

impl[T: Hash] Hash for Option[T]
  def hash[H: Hasher](self: &Option[T], state: &mut H) -> Unit
    match self
    when Option::Some(val) then
      1u8.hash(state)
      val.hash(state)
    when Option::None then
      0u8.hash(state)
    end
  end
end

impl[K: Hash, V: Hash] Hash for std::collections::HashMap[K, V]
  def hash[H: Hasher](self: &std::collections::HashMap[K, V], state: &mut H) -> Unit
    (self.len() as u64).hash(state)
    # Hash entries in sorted order for determinism
    mut entries = self.iter().collect::[Vec[_]]()
    entries.sort_by(|a, b| a.0.cmp(b.0))
    for (k, v) in entries do
      k.hash(state)
      v.hash(state)
    end
  end
end

impl[T: Hash] Hash for std::collections::HashSet[T]
  def hash[H: Hasher](self: &std::collections::HashSet[T], state: &mut H) -> Unit
    (self.len() as u64).hash(state)
    mut items = self.iter().collect::[Vec[_]]()
    items.sort()
    for item in items do
      item.hash(state)
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# BuildHasher Trait
# ═══════════════════════════════════════════════════════════════

trait BuildHasher
  type Hasher: Hasher
  
  def build_hasher(self: &Self) -> Self::Hasher
end

struct RandomState
  k0: u64
  k1: u64
end

def RandomState::new() -> RandomState
  # Get random keys from system entropy
  mut bytes: [u8; 16] = [0u8; 16]
  match std::rand::system_random_bytes(&mut bytes)
  when Result::Ok(_) then ()
  when Result::Err(_) then
    # Fallback to deterministic keys
    bytes = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8,
             9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8]
  end
  
  let k0 = u64::from_le_bytes(&bytes[0..8])
  let k1 = u64::from_le_bytes(&bytes[8..16])
  
  RandomState { k0: k0, k1: k1 }
end

def RandomState::with_seeds(k0: u64, k1: u64) -> RandomState
  RandomState { k0: k0, k1: k1 }
end

impl BuildHasher for RandomState
  type Hasher = DefaultHasher
  
  def build_hasher(self: &RandomState) -> DefaultHasher
    DefaultHasher::with_keys(self.k0, self.k1)
  end
end

struct FxBuildHasher

def FxBuildHasher::new() -> FxBuildHasher
  FxBuildHasher
end

impl BuildHasher for FxBuildHasher
  type Hasher = FxHasher
  
  def build_hasher(self: &FxBuildHasher) -> FxHasher
    FxHasher::new()
  end
end

# ═══════════════════════════════════════════════════════════════
# Convenience Functions
# ═══════════════════════════════════════════════════════════════

def hash[T: Hash](value: &T) -> u64
  mut hasher = DefaultHasher::new()
  value.hash(&mut hasher)
  hasher.finish()
end

def hash_with_seed[T: Hash](value: &T, seed: u64) -> u64
  mut hasher = DefaultHasher::with_keys(seed, seed.wrapping_mul(0x517cc1b727220a95u64))
  value.hash(&mut hasher)
  hasher.finish()
end

def hash_bytes(bytes: &[u8]) -> u64
  mut hasher = DefaultHasher::new()
  hasher.write(bytes)
  hasher.finish()
end

# ═══════════════════════════════════════════════════════════════
# CRC32
# ═══════════════════════════════════════════════════════════════

struct Crc32
  state: u32
end

# CRC32 lookup table (IEEE 802.3 polynomial)
def CRC32_TABLE() -> [u32; 256]
  [
    0x00000000u32, 0x77073096u32, 0xee0e612cu32, 0x990951bau32,
    0x076dc419u32, 0x706af48fu32, 0xe963a535u32, 0x9e6495a3u32,
    0x0edb8832u32, 0x79dcb8a4u32, 0xe0d5e91eu32, 0x97d2d988u32,
    0x09b64c2bu32, 0x7eb17cbdu32, 0xe7b82d07u32, 0x90bf1d91u32,
    0x1db71064u32, 0x6ab020f2u32, 0xf3b97148u32, 0x84be41deu32,
    0x1adad47du32, 0x6ddde4ebu32, 0xf4d4b551u32, 0x83d385c7u32,
    0x136c9856u32, 0x646ba8c0u32, 0xfd62f97au32, 0x8a65c9ecu32,
    0x14015c4fu32, 0x63066cd9u32, 0xfa0f3d63u32, 0x8d080df5u32,
    0x3b6e20c8u32, 0x4c69105eu32, 0xd56041e4u32, 0xa2677172u32,
    0x3c03e4d1u32, 0x4b04d447u32, 0xd20d85fdu32, 0xa50ab56bu32,
    0x35b5a8fau32, 0x42b2986cu32, 0xdbbbc9d6u32, 0xacbcf940u32,
    0x32d86ce3u32, 0x45df5c75u32, 0xdcd60dcfu32, 0xabd13d59u32,
    0x26d930acu32, 0x51de003au32, 0xc8d75180u32, 0xbfd06116u32,
    0x21b4f4b5u32, 0x56b3c423u32, 0xcfba9599u32, 0xb8bda50fu32,
    0x2802b89eu32, 0x5f058808u32, 0xc60cd9b2u32, 0xb10be924u32,
    0x2f6f7c87u32, 0x58684c11u32, 0xc1611dabu32, 0xb6662d3du32,
    0x76dc4190u32, 0x01db7106u32, 0x98d220bcu32, 0xefd5102au32,
    0x71b18589u32, 0x06b6b51fu32, 0x9fbfe4a5u32, 0xe8b8d433u32,
    0x7807c9a2u32, 0x0f00f934u32, 0x9609a88eu32, 0xe10e9818u32,
