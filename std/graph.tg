# Tangerine Standard Library — tg::graph
# Persistent symbol/effect/contract/test graph with incremental indexing.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 32.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec, Map}
use std::gfx_errors::{Error, ErrorCode}
use std::ctx
use std::fs

# [METADATA]
# module: tg::graph
# status: alpha
# effects: [Io]
# capabilities: [Fs]
# error_codes: [NotFound, InvalidGraph, Internal]

enum GraphError
  NotFound(Error)
  InvalidGraph(Error)
  Internal(Error)
end

impl GraphError
  def message(self: GraphError) -> String
    match self
    when GraphError::NotFound(e) then e.message.clone()
    when GraphError::InvalidGraph(e) then e.message.clone()
    when GraphError::Internal(e) then e.message.clone()
    end
  end

  def code(self: GraphError) -> ErrorCode
    match self
    when GraphError::NotFound(_) then ErrorCode::InvalidArg
    when GraphError::InvalidGraph(_) then ErrorCode::InvalidArg
    when GraphError::Internal(_) then ErrorCode::Internal
    end
  end
end

struct Node 
  id: String
  kind: String
  metadata: Map[String, String]
end

struct Edge 
  source: String
  target: String
  kind: String
end

struct SymbolGraph 
  nodes: Map[String, Node]
  edges: Vec[Edge]
end

impl SymbolGraph
  def new() -> SymbolGraph
    SymbolGraph {
      nodes: Map::new(),
      edges: Vec::new()
    }
  end

  def add_node(inout self: SymbolGraph, node: Node) -> Unit
    self.nodes.insert(node.id.clone(), node)
  end

  def add_edge(inout self: SymbolGraph, sink edge: Edge) -> Unit
    self.edges.push(edge)
  end

  def query_dependencies(self: SymbolGraph, id: String) -> Vec[String]
    let mut deps = Vec::new()
    let mut i = 0
    while i < self.edges.len() do
      # Projected reads: `self.edges[i].source` / `.target` are the slot
      # places (never a raw by-value duplication of the whole Edge — a
      # non-Copy struct of owned Strings can never be bit-copied out of
      # shared storage); the target is CLONED directly from the place with
      # the concrete Clone instance (the read-then-clone shape).
      if self.edges[i].source == *id then
        deps.push(self.edges[i].target.clone())
      end
      i = i + 1
    end
    deps
  end
end

# THE ON-DISK FORMAT (versioned, strict):
#   GRAPH 1                       # the version header — REQUIRED first
#   NODE <id> <kind>              # one declaration per line
#   EDGE <source> <target> <kind>
# Blank lines are skipped. Any OTHER non-empty line is an error
# (InvalidGraph) — the parser never silently ignores a declaration it
# does not understand; a missing or unsupported version header is an
# error too.

const GRAPH_FORMAT_VERSION: Int = 1

def load_graph(path: String) -> Result[SymbolGraph, GraphError]
  # THE REAL std load (the phantom __intrinsic_graph_load removed): the
  # on-disk symbol graph format is one declaration per line under the
  # versioned header. A missing file is NotFound; a malformed
  # declaration, an unknown line, or an unsupported version is
  # InvalidGraph.
  _log_graph_event(LogLevel::Info, "Loading symbol graph: " + path)
  match std::fs::read_to_string(path.clone())
  when Result::Ok(content) then
    var graph = SymbolGraph::new()
    var saw_header = false
    let lines = content.split("\n")
    for line in lines do
      let trimmed = line.trim()
      if trimmed.is_empty() then
        ()  # blank lines are skipped
      elsif !saw_header then
        saw_header = true
        # THE VERSIONED HEADER: the first non-empty line must be
        # "GRAPH <version>"; anything else is a malformed graph.
        if trimmed.starts_with("GRAPH ") then
          let version = trimmed.slice(6, trimmed.len())
          if version != GRAPH_FORMAT_VERSION.to_string() then
            return Result::Err(GraphError::InvalidGraph(Error::new(ErrorCode::InvalidArg,
              "unsupported symbol graph version: " + version)))
          end
        else
          return Result::Err(GraphError::InvalidGraph(Error::new(ErrorCode::InvalidArg,
            "missing symbol graph version header: " + trimmed)))
        end
      elsif trimmed.starts_with("NODE ") then
        let parts = trimmed.slice(5, trimmed.len()).split(" ")
        if parts.len() >= 2 then
          graph.add_node(Node {
            id: parts.get(0).clone(),
            kind: parts.get(1).clone(),
            metadata: Map::new()
          })
        else
          return Result::Err(GraphError::InvalidGraph(Error::new(ErrorCode::InvalidArg, "malformed NODE line: " + trimmed)))
        end
      elsif trimmed.starts_with("EDGE ") then
        let parts = trimmed.slice(5, trimmed.len()).split(" ")
        if parts.len() >= 3 then
          graph.add_edge(Edge {
            source: parts.get(0).clone(),
            target: parts.get(1).clone(),
            kind: parts.get(2).clone()
          })
        else
          return Result::Err(GraphError::InvalidGraph(Error::new(ErrorCode::InvalidArg, "malformed EDGE line: " + trimmed)))
        end
      else
        # THE STRICT PARSER: an unknown non-empty line is the error,
        # never the silent ignore.
        return Result::Err(GraphError::InvalidGraph(Error::new(ErrorCode::InvalidArg,
          "unknown symbol graph line: " + trimmed)))
      end
    end
    if !saw_header then
      return Result::Err(GraphError::InvalidGraph(Error::new(ErrorCode::InvalidArg,
        "empty symbol graph: missing version header")))
    end
    Result::Ok(graph)
  when Result::Err(_) then
    Result::Err(GraphError::NotFound(Error::new(ErrorCode::InvalidArg, "symbol graph not found: " + path)))
  end
end

# THE VERSIONED SERIALIZATION: the canonical text of the graph (the
# version header + the sorted node declarations + the edge declarations
# in insertion order) — the round-trip identity: save_graph then
# load_graph reproduces the exact same text.
def serialize_graph(graph: SymbolGraph) -> String
  let mut out = String::new()
  out.push_str("GRAPH ")
  out.push_str(GRAPH_FORMAT_VERSION.to_string().as_str())
  out.push('\n')
  for entry in graph.nodes do
    let (id, node) = entry
    out.push_str("NODE ")
    out.push_str(id.as_str())
    out.push(' ')
    out.push_str(node.kind.as_str())
    out.push('\n')
  end
  for edge in graph.edges do
    out.push_str("EDGE ")
    out.push_str(edge.source.as_str())
    out.push(' ')
    out.push_str(edge.target.as_str())
    out.push(' ')
    out.push_str(edge.kind.as_str())
    out.push('\n')
  end
  out
end

def save_graph(path: String, graph: SymbolGraph) -> Result[Unit, GraphError]
  _log_graph_event(LogLevel::Info, "Saving symbol graph: " + path)
  let text = serialize_graph(graph)
  match std::fs::write_file_bytes(path, text.as_bytes())
  when Result::Ok(_) then Result::Ok(())
  when Result::Err(_) then
    Result::Err(GraphError::Internal(Error::new(ErrorCode::InvalidArg, "failed to write symbol graph: " + path)))
  end
end

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}
use std::time::{instant_now, duration_nanos}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit 
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_graph_event(level: LogLevel, msg: String) -> Unit
  match GLOBAL_LOGGER.as_mut()
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::App,
      message: "[GRAPH] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then ()
  end  end  end
end
