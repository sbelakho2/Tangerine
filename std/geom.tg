# Tangerine Standard Library — tg::geom
# Normative geometry types and functions for the Graphics & UI stack.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 5.
#
# All coordinates are in DIP (device-independent pixels).
# All color channels are f32 in [0.0, 1.0] range.

use std::core::{Option, Result, String, Bool, Int, Float}

# ═══════════════════════════════════════════════════════════════
# §5.1 Types
# ═══════════════════════════════════════════════════════════════

# ———————————————————————————————————————————————————————————————
# Vec2 — 2D vector / point
# ———————————————————————————————————————————————————————————————

struct Vec2
  x: f32
  y: f32
end

impl Vec2
  def new(x: f32, y: f32) -> Vec2
    Vec2 { x: x, y: y }
  end

  def zero() -> Vec2
    Vec2 { x: 0.0, y: 0.0 }
  end

  def add(self: &Vec2, other: &Vec2) -> Vec2
    Vec2 { x: self.x + other.x, y: self.y + other.y }
  end

  def sub(self: &Vec2, other: &Vec2) -> Vec2
    Vec2 { x: self.x - other.x, y: self.y - other.y }
  end

  def scale(self: &Vec2, s: f32) -> Vec2
    Vec2 { x: self.x * s, y: self.y * s }
  end

  def dot(self: &Vec2, other: &Vec2) -> f32
    self.x * other.x + self.y * other.y
  end

  def length(self: &Vec2) -> f32
    (self.x * self.x + self.y * self.y).sqrt()
  end

  def normalize(self: &Vec2) -> Vec2
    let len = self.length()
    if len > 0.0 then
      Vec2 { x: self.x / len, y: self.y / len }
    else
      Vec2::zero()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Vec3 — 3D vector (used for color math, optional 3D transforms)
# ———————————————————————————————————————————————————————————————

struct Vec3
  x: f32
  y: f32
  z: f32
end

impl Vec3
  def new(x: f32, y: f32, z: f32) -> Vec3
    Vec3 { x: x, y: y, z: z }
  end

  def zero() -> Vec3
    Vec3 { x: 0.0, y: 0.0, z: 0.0 }
  end

  def add(self: &Vec3, other: &Vec3) -> Vec3
    Vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z }
  end

  def sub(self: &Vec3, other: &Vec3) -> Vec3
    Vec3 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z }
  end

  def scale(self: &Vec3, s: f32) -> Vec3
    Vec3 { x: self.x * s, y: self.y * s, z: self.z * s }
  end

  def dot(self: &Vec3, other: &Vec3) -> f32
    self.x * other.x + self.y * other.y + self.z * other.z
  end

  def cross(self: &Vec3, other: &Vec3) -> Vec3
    Vec3 {
      x: self.y * other.z - self.z * other.y,
      y: self.z * other.x - self.x * other.z,
      z: self.x * other.y - self.y * other.x
    }
  end

  def length(self: &Vec3) -> f32
    (self.x * self.x + self.y * self.y + self.z * self.z).sqrt()
  end

  def normalize(self: &Vec3) -> Vec3
    let len = self.length()
    if len > 0.0 then
      Vec3 { x: self.x / len, y: self.y / len, z: self.z / len }
    else
      Vec3::zero()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Rect — axis-aligned rectangle
# ———————————————————————————————————————————————————————————————

struct Rect
  x: f32
  y: f32
  w: f32
  h: f32
end

impl Rect
  def new(x: f32, y: f32, w: f32, h: f32) -> Rect
    Rect { x: x, y: y, w: w, h: h }
  end

  def zero() -> Rect
    Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
  end

  def right(self: &Rect) -> f32
    self.x + self.w
  end

  def bottom(self: &Rect) -> f32
    self.y + self.h
  end

  def center(self: &Rect) -> Vec2
    Vec2 { x: self.x + self.w / 2.0, y: self.y + self.h / 2.0 }
  end
end

# ———————————————————————————————————————————————————————————————
# RRect — rounded rectangle
# ———————————————————————————————————————————————————————————————

struct RRect
  rect: Rect
  rx: f32
  ry: f32
end

impl RRect
  def new(rect: Rect, rx: f32, ry: f32) -> RRect
    RRect { rect: rect, rx: rx, ry: ry }
  end

  def from_rect(rect: Rect, radius: f32) -> RRect
    RRect { rect: rect, rx: radius, ry: radius }
  end
end

# ———————————————————————————————————————————————————————————————
# Color — linear f32 RGBA color
# ———————————————————————————————————————————————————————————————

struct Color
  r: f32
  g: f32
  b: f32
  a: f32
end

impl Color
  def new(r: f32, g: f32, b: f32, a: f32) -> Color
    Color { r: r, g: g, b: b, a: a }
  end

  def rgb(r: f32, g: f32, b: f32) -> Color
    Color { r: r, g: g, b: b, a: 1.0 }
  end

  def white() -> Color
    Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }
  end

  def black() -> Color
    Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  end

  def transparent() -> Color
    Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
  end

  def red() -> Color
    Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 }
  end

  def green() -> Color
    Color { r: 0.0, g: 1.0, b: 0.0, a: 1.0 }
  end

  def blue() -> Color
    Color { r: 0.0, g: 0.0, b: 1.0, a: 1.0 }
  end

  def with_alpha(self: &Color, a: f32) -> Color
    Color { r: self.r, g: self.g, b: self.b, a: a }
  end

  def blend(self: &Color, other: &Color, t: f32) -> Color
    let t = t.clamp(0.0, 1.0)
    Color {
      r: self.r * (1.0 - t) + other.r * t,
      g: self.g * (1.0 - t) + other.g * t,
      b: self.b * (1.0 - t) + other.b * t,
      a: self.a * (1.0 - t) + other.a * t
    }
  end

  # Convert from sRGB u8 [0,255] to linear f32 [0.0,1.0]
  def from_srgb8(r: u8, g: u8, b: u8, a: u8) -> Color
    Color {
      r: (r as f32) / 255.0,
      g: (g as f32) / 255.0,
      b: (b as f32) / 255.0,
      a: (a as f32) / 255.0
    }
  end

  # Convert to sRGB u8 [0,255]
  def to_srgb8(self: &Color) -> (u8, u8, u8, u8)
    (
      (self.r * 255.0).clamp(0.0, 255.0) as u8,
      (self.g * 255.0).clamp(0.0, 255.0) as u8,
      (self.b * 255.0).clamp(0.0, 255.0) as u8,
      (self.a * 255.0).clamp(0.0, 255.0) as u8
    )
  end
end

# ———————————————————————————————————————————————————————————————
# ColorSpace — color space tag
# ———————————————————————————————————————————————————————————————

enum ColorSpace
  SRGB
  DisplayP3
end

# ———————————————————————————————————————————————————————————————
# Transform2D — 2D affine transform matrix
# | m00  m01  m02 |
# | m10  m11  m12 |
# |  0    0    1  |
# ———————————————————————————————————————————————————————————————

struct Transform2D
  m00: f32
  m01: f32
  m02: f32
  m10: f32
  m11: f32
  m12: f32
end

impl Transform2D
  def new(m00: f32, m01: f32, m02: f32, m10: f32, m11: f32, m12: f32) -> Transform2D
    Transform2D { m00: m00, m01: m01, m02: m02, m10: m10, m11: m11, m12: m12 }
  end
end

# ———————————————————————————————————————————————————————————————
# Path — opaque path handle for complex shapes
# ———————————————————————————————————————————————————————————————

struct Path
  _opaque: u64
end

# ═══════════════════════════════════════════════════════════════
# §5.2 Module functions
# ═══════════════════════════════════════════════════════════════

def transform_identity() -> Transform2D
  Transform2D { m00: 1.0, m01: 0.0, m02: 0.0, m10: 0.0, m11: 1.0, m12: 0.0 }
end

def transform_translate(tx: f32, ty: f32) -> Transform2D
  Transform2D { m00: 1.0, m01: 0.0, m02: tx, m10: 0.0, m11: 1.0, m12: ty }
end

def transform_scale(sx: f32, sy: f32) -> Transform2D
  Transform2D { m00: sx, m01: 0.0, m02: 0.0, m10: 0.0, m11: sy, m12: 0.0 }
end

def transform_rotate(rad: f32) -> Transform2D
  let c = rad.cos()
  let s = rad.sin()
  Transform2D { m00: c, m01: -s, m02: 0.0, m10: s, m11: c, m12: 0.0 }
end

def transform_mul(a: Transform2D, b: Transform2D) -> Transform2D
  Transform2D {
    m00: a.m00 * b.m00 + a.m01 * b.m10,
    m01: a.m00 * b.m01 + a.m01 * b.m11,
    m02: a.m00 * b.m02 + a.m01 * b.m12 + a.m02,
    m10: a.m10 * b.m00 + a.m11 * b.m10,
    m11: a.m10 * b.m01 + a.m11 * b.m11,
    m12: a.m10 * b.m02 + a.m11 * b.m12 + a.m12
  }
end

def rect_contains(r: Rect, p: Vec2) -> Bool
  p.x >= r.x && p.x <= r.x + r.w && p.y >= r.y && p.y <= r.y + r.h
end

def rect_intersect(a: Rect, b: Rect) -> Option[Rect]
  let x0 = a.x.max(b.x)
  let y0 = a.y.max(b.y)
  let x1 = (a.x + a.w).min(b.x + b.w)
  let y1 = (a.y + a.h).min(b.y + b.h)
  if x1 > x0 && y1 > y0 then
    Option::Some(Rect { x: x0, y: y0, w: x1 - x0, h: y1 - y0 })
  else
    Option::None
  end
end

def rect_union(a: Rect, b: Rect) -> Rect
  let x0 = a.x.min(b.x)
  let y0 = a.y.min(b.y)
  let x1 = (a.x + a.w).max(b.x + b.w)
  let y1 = (a.y + a.h).max(b.y + b.h)
  Rect { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }
end

# ———————————————————————————————————————————————————————————————
# Path builder functions
# Path operations create/mutate Path objects via opaque handles.
# Actual path storage is backend-managed; these functions dispatch
# through the active backend's path implementation.
# ———————————————————————————————————————————————————————————————

# Internal path segment storage for software fallback
struct PathSegment
  kind: PathSegmentKind
  points: Vec[Vec2]
end

enum PathSegmentKind
  MoveTo
  LineTo
  QuadTo
  CubicTo
  Close
end

# Internal path data backing the opaque handle
struct PathData
  segments: Vec[PathSegment]
  current: Vec2
end

# Global path registry (maps _opaque handle → PathData)
mut _path_registry: Vec[PathData] = Vec::new()
mut _next_path_id: u64 = 1

def path_new() -> Path
  let id = _next_path_id
  _next_path_id = _next_path_id + 1
  _path_registry.push(PathData {
    segments: Vec::new(),
    current: Vec2::zero()
  })
  Path { _opaque: id }
end

def _path_data(p: &Path) -> &mut PathData
  &mut _path_registry[(p._opaque - 1) as Int]
end

def path_move_to(p: &mut Path, x: f32, y: f32) -> Unit
  let data = _path_data(p)
  let pt = Vec2::new(x, y)
  data.segments.push(PathSegment {
    kind: PathSegmentKind::MoveTo,
    points: [pt].to_vec()
  })
  data.current = pt
end

def path_line_to(p: &mut Path, x: f32, y: f32) -> Unit
  let data = _path_data(p)
  let pt = Vec2::new(x, y)
  data.segments.push(PathSegment {
    kind: PathSegmentKind::LineTo,
    points: [pt].to_vec()
  })
  data.current = pt
end

def path_quad_to(p: &mut Path, cx: f32, cy: f32, x: f32, y: f32) -> Unit
  let data = _path_data(p)
  let ctrl = Vec2::new(cx, cy)
  let pt = Vec2::new(x, y)
  data.segments.push(PathSegment {
    kind: PathSegmentKind::QuadTo,
    points: [ctrl, pt].to_vec()
  })
  data.current = pt
end

def path_cubic_to(p: &mut Path, c1x: f32, c1y: f32, c2x: f32, c2y: f32, x: f32, y: f32) -> Unit
  let data = _path_data(p)
  let c1 = Vec2::new(c1x, c1y)
  let c2 = Vec2::new(c2x, c2y)
  let pt = Vec2::new(x, y)
  data.segments.push(PathSegment {
    kind: PathSegmentKind::CubicTo,
    points: [c1, c2, pt].to_vec()
  })
  data.current = pt
end

def path_close(p: &mut Path) -> Unit
  let data = _path_data(p)
  data.segments.push(PathSegment {
    kind: PathSegmentKind::Close,
    points: Vec::new()
  })
end

def path_bounds(p: &Path) -> Rect
  let data = _path_data(p)
  if data.segments.is_empty() then
    return Rect::zero()
  end

  mut min_x: f32 = f32::MAX
  mut min_y: f32 = f32::MAX
  mut max_x: f32 = f32::MIN
  mut max_y: f32 = f32::MIN

  for seg in &data.segments do
    for pt in &seg.points do
      min_x = min_x.min(pt.x)
      min_y = min_y.min(pt.y)
      max_x = max_x.max(pt.x)
      max_y = max_y.max(pt.y)
    end
  end

  if min_x > max_x then
    Rect::zero()
  else
    Rect { x: min_x, y: min_y, w: max_x - min_x, h: max_y - min_y }
  end
end

# ═══════════════════════════════════════════════════════════════
# Geometric intersection & collision algorithms
# ═══════════════════════════════════════════════════════════════

struct Circle
  center: Vec2
  radius: f32
end

struct Ray2D
  origin: Vec2
  dir: Vec2
end

struct LineSegment
  a: Vec2
  b: Vec2
end

# Circle–circle intersection test
def circle_intersects(c1: &Circle, c2: &Circle) -> Bool
  let dx = c2.center.x - c1.center.x
  let dy = c2.center.y - c1.center.y
  let dist_sq = dx * dx + dy * dy
  let r_sum = c1.radius + c2.radius
  dist_sq <= r_sum * r_sum
end

# Circle containment test
def circle_contains(c: &Circle, p: Vec2) -> Bool
  let dx = p.x - c.center.x
  let dy = p.y - c.center.y
  dx * dx + dy * dy <= c.radius * c.radius
end

# Ray–Rect intersection (slab method). Returns parametric t or None.
def ray_rect_intersect(ray: &Ray2D, r: &Rect) -> Option[f32]
  mut t_min: f32 = -999999999.0
  mut t_max: f32 = 999999999.0

  # X slab
  if ray.dir.x.abs() < 0.000000000001 then
    if ray.origin.x < r.x || ray.origin.x > r.x + r.w then
      return Option::None
    end
  else
    let inv = 1.0 / ray.dir.x
    mut t1 = (r.x - ray.origin.x) * inv
    mut t2 = (r.x + r.w - ray.origin.x) * inv
    if t1 > t2 then
      let tmp = t1
      t1 = t2
      t2 = tmp
    end
    t_min = t_min.max(t1)
    t_max = t_max.min(t2)
    if t_min > t_max then
      return Option::None
    end
  end

  # Y slab
  if ray.dir.y.abs() < 0.000000000001 then
    if ray.origin.y < r.y || ray.origin.y > r.y + r.h then
      return Option::None
    end
  else
    let inv = 1.0 / ray.dir.y
    mut t1 = (r.y - ray.origin.y) * inv
    mut t2 = (r.y + r.h - ray.origin.y) * inv
    if t1 > t2 then
      let tmp = t1
      t1 = t2
      t2 = tmp
    end
    t_min = t_min.max(t1)
    t_max = t_max.min(t2)
    if t_min > t_max then
      return Option::None
    end
  end

  if t_max < 0.0 then
    Option::None
  else
    Option::Some(t_min.max(0.0))
  end
end

# Ray–Circle intersection. Returns nearest parametric t or None.
def ray_circle_intersect(ray: &Ray2D, c: &Circle) -> Option[f32]
  let oc_x = ray.origin.x - c.center.x
  let oc_y = ray.origin.y - c.center.y
  let a = ray.dir.x * ray.dir.x + ray.dir.y * ray.dir.y
  let b = 2.0 * (oc_x * ray.dir.x + oc_y * ray.dir.y)
  let cc = oc_x * oc_x + oc_y * oc_y - c.radius * c.radius
  let disc = b * b - 4.0 * a * cc
  if disc < 0.0 then
    return Option::None
  end
  let sqrt_disc = disc.sqrt()
  let t1 = (-b - sqrt_disc) / (2.0 * a)
  let t2 = (-b + sqrt_disc) / (2.0 * a)
  if t1 >= 0.0 then
    Option::Some(t1)
  else if t2 >= 0.0 then
    Option::Some(t2)
  else
    Option::None
  end
end

# Line segment–line segment intersection test
def segments_intersect(s1: &LineSegment, s2: &LineSegment) -> Bool
  let d1x = s1.b.x - s1.a.x
  let d1y = s1.b.y - s1.a.y
  let d2x = s2.b.x - s2.a.x
  let d2y = s2.b.y - s2.a.y
  let cross = d1x * d2y - d1y * d2x
  if cross.abs() < 0.000000000001 then
    return false
  end
  let dx = s2.a.x - s1.a.x
  let dy = s2.a.y - s1.a.y
  let t = (dx * d2y - dy * d2x) / cross
  let u = (dx * d1y - dy * d1x) / cross
  t >= 0.0 && t <= 1.0 && u >= 0.0 && u <= 1.0
end

# Point–line segment closest point
def segment_closest_point(seg: &LineSegment, p: Vec2) -> Vec2
  let dx = seg.b.x - seg.a.x
  let dy = seg.b.y - seg.a.y
  let len_sq = dx * dx + dy * dy
  if len_sq < 0.000000000001 then
    return seg.a
  end
  mut t = ((p.x - seg.a.x) * dx + (p.y - seg.a.y) * dy) / len_sq
  if t < 0.0 then
    t = 0.0
  else if t > 1.0 then
    t = 1.0
  end
  Vec2 { x: seg.a.x + t * dx, y: seg.a.y + t * dy }
end

# Point–line segment distance
def segment_distance(seg: &LineSegment, p: Vec2) -> f32
  let closest = segment_closest_point(seg, p)
  let dx = p.x - closest.x
  let dy = p.y - closest.y
  (dx * dx + dy * dy).sqrt()
end

# Circle–Rect overlap (Minkowski method)
def circle_rect_intersects(c: &Circle, r: &Rect) -> Bool
  let closest_x = c.center.x.max(r.x).min(r.x + r.w)
  let closest_y = c.center.y.max(r.y).min(r.y + r.h)
  let dx = c.center.x - closest_x
  let dy = c.center.y - closest_y
  dx * dx + dy * dy <= c.radius * c.radius
end
