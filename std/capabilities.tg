# Tangerine Standard Library — std::capabilities
# Capability-based security system for tracking and managing permissions
#
# This module provides types and functions for working with capability
# declarations and requirements at the source level.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}

# ———————————————————————————————————————————————————————————————
# Core Types
# ———————————————————————————————————————————————————————————————

enum CapKind
  IO
  Net
  File
  Env
  FFI
  Unsafe
  Custom(String)
end

struct Capability
  name: String
  kind: CapKind
  description: Option[String]
end

struct CapGrant
  cap: Capability
  source: String       # Where the capability was granted
  transitive: Bool     # Can be passed to callees
end

struct CapRequirement
  cap_name: String
  required_by: String  # Function name
  reason: Option[String]
end

struct CapContext
  grants: Map[String, CapGrant]
  requirements: Vec[CapRequirement]
end

struct CapabilitySet
  caps: Set[String]
end

enum CapCheckResult
  Satisfied
  Missing(Vec[String])
  Conflict(String)
end

# ———————————————————————————————————————————————————————————————
# Built-in Capabilities
# ———————————————————————————————————————————————————————————————

def io_cap() -> Capability
  Capability {
    name: "IO",
    kind: CapKind::IO,
    description: Option::Some("Read/write to standard streams")
  }
end

def net_cap() -> Capability
  Capability {
    name: "Net",
    kind: CapKind::Net,
    description: Option::Some("Network access")
  }
end

def file_cap() -> Capability
  Capability {
    name: "File",
    kind: CapKind::File,
    description: Option::Some("File system access")
  }
end

def env_cap() -> Capability
  Capability {
    name: "Env",
    kind: CapKind::Env,
    description: Option::Some("Environment variable access")
  }
end

def ffi_cap() -> Capability
  Capability {
    name: "FFI",
    kind: CapKind::FFI,
    description: Option::Some("Foreign function interface")
  }
end

def unsafe_cap() -> Capability
  Capability {
    name: "Unsafe",
    kind: CapKind::Unsafe,
    description: Option::Some("Unsafe operations")
  }
end

def custom_cap(name: String) -> Capability
  let kind = CapKind::Custom(name.clone())
  Capability {
    name: name,
    kind: kind,
    description: Option::None
  }
end

# ———————————————————————————————————————————————————————————————
# Capability Context Management
# ———————————————————————————————————————————————————————————————

def new_cap_context() -> CapContext
  CapContext {
    grants: Map::new(),
    requirements: Vec::new()
  }
end

impl CapabilitySet
  def empty() -> CapabilitySet
    CapabilitySet { caps: Set::new() }
  end

  def grant(self: &mut CapabilitySet, cap: Capability) -> Unit
    self.caps.insert(cap.name.clone())
  end

  def revoke(self: &mut CapabilitySet, cap: Capability) -> Unit
    self.caps.remove(&cap.name)
  end
end

def grant(ctx: &mut CapContext, cap: Capability, source: String) -> Unit
  ctx.grants.insert(cap.name.clone(), CapGrant {
    cap: cap,
    source: source,
    transitive: true
  })
end

def grant_restricted(ctx: &mut CapContext, cap: Capability, source: String) -> Unit
  ctx.grants.insert(cap.name.clone(), CapGrant {
    cap: cap,
    source: source,
    transitive: false
  })
end

def require(ctx: &mut CapContext, cap_name: String, fn_name: String) -> Unit
  ctx.requirements.push(CapRequirement {
    cap_name: cap_name,
    required_by: fn_name,
    reason: Option::None
  })
end

def require_with_reason(ctx: &mut CapContext, cap_name: String, fn_name: String, reason: String) -> Unit
  ctx.requirements.push(CapRequirement {
    cap_name: cap_name,
    required_by: fn_name,
    reason: Option::Some(reason)
  })
end

# ———————————————————————————————————————————————————————————————
# Capability Checking
# ———————————————————————————————————————————————————————————————

def has_cap(ctx: &CapContext, cap_name: String) -> Bool
  ctx.grants.contains_key(cap_name)
end

def check_capability(caps: &CapabilitySet, cap: Capability) -> Bool
  let cap_name = cap.name.clone()
  caps.caps.contains(&cap_name)
end

def check_requirements(ctx: &CapContext) -> CapCheckResult
  let missing = Vec::new()
  
  for req in ctx.requirements do
    if !ctx.grants.contains_key(req.cap_name) then
      missing.push(req.cap_name + " (required by " + req.required_by + ")")
    end
  end
  
  if missing.is_empty() then
    CapCheckResult::Satisfied
  else
    CapCheckResult::Missing(missing)
  end
end

def check_call(caller_ctx: &CapContext, callee_reqs: Vec[String]) -> CapCheckResult
  let missing = Vec::new()
  
  for req in callee_reqs do
    match caller_ctx.grants.get(req)
      when Option::Some(grant) then
        if !grant.transitive then
          missing.push(req + " (not transitive)")
        end
      when Option::None then
        missing.push(req)
    end
  end
  
  if missing.is_empty() then
    CapCheckResult::Satisfied
  else
    CapCheckResult::Missing(missing)
  end
end

# ———————————————————————————————————————————————————————————————
# Analysis API (for agentic tools)
# ———————————————————————————————————————————————————————————————

def extract_capabilities(source: String) -> Vec[Capability]
  # Parse source and extract all capability declarations
  let caps = Vec::new()
  let lines = source.lines()
  
  for line in lines do
    let trimmed = line.trim()
    if trimmed.starts_with("cap ") then
      let rest = trimmed.slice(4, trimmed.len())
      let name = rest.split_whitespace().first().unwrap_or(rest)
      caps.push(custom_cap(name))
    end
  end
  
  caps
end

def extract_requirements(source: String) -> Vec[CapRequirement]
  # Parse source and extract all requires clauses
  let reqs = Vec::new()
  let lines = source.lines()
  let mut current_fn = "unknown"
  
  for line in lines do
    let trimmed = line.trim()
    if trimmed.starts_with("def ") then
      # Extract function name: "def name(" -> "name"
      let rest = trimmed.slice(4, trimmed.len())
      let paren_idx = rest.find("(").unwrap_or(rest.len())
      current_fn = rest.slice(0, paren_idx)
    elsif trimmed.starts_with("requires ")
      let cap_name = trimmed.slice(9, trimmed.len()).trim()
      reqs.push(CapRequirement {
        cap_name: cap_name,
        required_by: current_fn,
        reason: Option::None
      })
    end
  end
  
  reqs
end

def analyze_program(caps: Vec[Capability], reqs: Vec[CapRequirement]) -> CapCheckResult
  let ctx = new_cap_context()
  
  for cap in caps
    grant(&mut ctx, cap, "program")
  end
  
  for req in reqs
    require(&mut ctx, req.cap_name, req.required_by)
  end
  
  check_requirements(&ctx)
end

# ———————————————————————————————————————————————————————————————
# Pretty Printing
# ———————————————————————————————————————————————————————————————

def format_cap(c: Capability) -> String
  let base = "cap " + c.name
  match c.description
    when Option::Some(desc) then base + " # " + desc
    when Option::None then base
  end
end

def format_grant(g: CapGrant) -> String
  let trans = if g.transitive then "" else " [restricted]" end
  g.cap.name + " (from " + g.source + ")" + trans
end

def format_result(r: CapCheckResult) -> String
  match r
    when CapCheckResult::Satisfied then
      "✓ All capability requirements satisfied"
    when CapCheckResult::Missing(caps) then
      "✗ Missing capabilities:\n  - " + caps.join("\n  - ")
    when CapCheckResult::Conflict(msg) then
      "⚠ Capability conflict: " + msg
  end
end

# ———————————————————————————————————————————————————————————————
# Runtime Enforcement
# ———————————————————————————————————————————————————————————————

def assert_cap(ctx: &CapContext, cap_name: String) -> Unit
  if !has_cap(ctx, cap_name)
    panic("Capability assertion failed: missing " + cap_name)
  end
end

# ———————————————————————————————————————————————————————————————
# §3 — Security Profiles
# ———————————————————————————————————————————————————————————————

## Pre-defined capability profiles for common application types.
## Each profile specifies which capabilities are allowed by default.

enum SecurityProfile
  Backend   # Server: Net, File, Env, IO allowed; no Unsafe
  Cli       # Command-line: File, Env, IO allowed; no Net by default
  Ui        # Frontend: IO allowed; everything else restricted
  Library   # Library: Pure by default; must declare all caps
  Custom(ProfileConfig)
end

struct ProfileConfig
  name: String
  allowed: Set[String]      # Capability names allowed by default
  denied: Set[String]       # Capability names always denied
  audit_required: Set[String] # Caps requiring explicit @audit annotation
end

def profile_allowed_caps(profile: &SecurityProfile) -> Set[String]
  match profile
    when SecurityProfile::Backend then
      Set::of_vec(vec!["IO", "Net", "File", "Env", "FFI"])
    when SecurityProfile::Cli then
      Set::of_vec(vec!["IO", "File", "Env"])
    when SecurityProfile::Ui then
      Set::of_vec(vec!["IO"])
    when SecurityProfile::Library then
      Set::new()  # Nothing by default — must declare
    when SecurityProfile::Custom(config) then
      config.allowed.clone()
  end
end

def profile_denied_caps(profile: &SecurityProfile) -> Set[String]
  match profile
    when SecurityProfile::Backend then
      Set::of_vec(vec!["Unsafe"])
    when SecurityProfile::Cli then
      Set::of_vec(vec!["Unsafe", "Net"])
    when SecurityProfile::Ui then
      Set::of_vec(vec!["Unsafe", "Net", "File", "Env", "FFI"])
    when SecurityProfile::Library then
      Set::of_vec(vec!["Unsafe"])
    when SecurityProfile::Custom(config) then
      config.denied.clone()
  end
end

## Check if a capability is allowed under a profile.
def profile_check(profile: &SecurityProfile, cap_name: &String) -> CapCheckResult
  let denied = profile_denied_caps(profile)
  if denied.contains(cap_name)
    return CapCheckResult::Conflict(
      "Capability '" + cap_name + "' is denied by security profile"
    )
  end
  let allowed = profile_allowed_caps(profile)
  if allowed.contains(cap_name)
    CapCheckResult::Satisfied
  else
    CapCheckResult::Missing(vec![cap_name.clone()])
  end
end

## Validate all requirements against a security profile.
def validate_against_profile(
  ctx: &CapContext,
  profile: &SecurityProfile
) -> Vec[String]
  let violations = Vec::new()
  let denied = profile_denied_caps(profile)

  for (name, _) in ctx.grants do
    if denied.contains(name)
      violations.push("Capability '" + name + "' is denied by security profile")
    end
  end

  for req in ctx.requirements do
    let cap_name = req.cap_name.clone()
    if denied.contains(&cap_name)
      violations.push("Requirement '" + req.cap_name
        + "' (from " + req.required_by + ") is denied by profile")
    end
  end

  violations
end

## Parse a profile name from config.
def parse_profile(name: &String) -> SecurityProfile
  match name.to_lowercase().as_str()
  when "backend" then SecurityProfile::Backend
  when "cli" then SecurityProfile::Cli
  when "ui" then SecurityProfile::Ui
  when "library" then SecurityProfile::Library
  when _ then SecurityProfile::Library
  end
end
