# Pipeline State
# ═══════════════════════════════════════════════════════════════

enum ShaderStage
  Vertex
  Fragment
  Geometry
  Compute
end

struct ShaderModule
  id: Int
  stage: ShaderStage
  entry: String
end

enum PrimitiveTopology
  TriangleList
  TriangleStrip
  LineList
  PointList
end

enum PolygonMode
  Fill
  Line
  Point
end

enum CullMode
  None
  Front
  Back
  FrontAndBack
end

enum FrontFace
  CounterClockwise
  Clockwise
end

enum CompareOp
  Never
  Less
  Equal
  LessOrEqual
  Greater
  NotEqual
  GreaterOrEqual
  Always
end

enum BlendOp
  Add
  Subtract
  ReverseSubtract
  Min
  Max
end

enum BlendFactor
  Zero
  One
  SrcColor
  OneMinusSrcColor
  DstColor
  OneMinusDstColor
  SrcAlpha
  OneMinusSrcAlpha
  DstAlpha
  OneMinusDstAlpha
  ConstantColor
  OneMinusConstantColor
end

# ═══════════════════════════════════════════════════════════════
# Pipeline Configuration
# ═══════════════════════════════════════════════════════════════

struct VertexInputState
  bindings: Vec[VertexBinding]
  attributes: Vec[VertexAttribute]
end

struct VertexBinding
  binding: Int
  stride: Int
end

struct VertexAttribute
  location: Int
  binding: Int
  format: VertexFormat
  offset: Int
end

enum VertexFormat
  R32_SFLOAT
  R32G32_SFLOAT
  R32G32B32_SFLOAT
  R32G32B32A32_SFLOAT
  R8G8B8A8_UNORM
  R8G8B8A8_UINT
  R16G16_SFLOAT
  R16G16B16A16_SFLOAT
end

def VertexFormat::size(self: VertexFormat) -> Int
  match self
  when VertexFormat::R32_SFLOAT then 4
  when VertexFormat::R32G32_SFLOAT then 8
  when VertexFormat::R32G32B32_SFLOAT then 12
  when VertexFormat::R32G32B32A32_SFLOAT then 16
  when VertexFormat::R8G8B8A8_UNORM then 4
  when VertexFormat::R8G8B8A8_UINT then 4
  when VertexFormat::R16G16_SFLOAT then 4
  when VertexFormat::R16G16B16A16_SFLOAT then 8
  end
end

struct InputAssemblyState
  topology: PrimitiveTopology
  restart_enable: Bool
end

struct RasterizationState
  depth_clamp: Bool
  discard: Bool
  polygon_mode: PolygonMode
  cull_mode: CullMode
  front_face: FrontFace
  depth_bias: Bool
  line_width: Float
end

struct DepthStencilState
  test_enable: Bool
  write_enable: Bool
  compare_op: CompareOp
end

struct ColorBlendAttachmentState
  blend_enable: Bool
  src_color: BlendFactor
  dst_color: BlendFactor
  color_op: BlendOp
  src_alpha: BlendFactor
  dst_alpha: BlendFactor
  alpha_op: BlendOp
end

struct ColorBlendState
  enable: Bool
  attachments: Vec[ColorBlendAttachmentState]
  constants: [Float; 4]
end

struct Viewport
  x: Float
  y: Float
  width: Float
  height: Float
  min_depth: Float
  max_depth: Float
end

struct Scissor
  x: Int
  y: Int
  width: Int
  height: Int
end

struct GraphicsPipelineDesc
  vertex_shader: ShaderModule
  fragment_shader: ShaderModule
  vertex_input: VertexInputState
  input_assembly: InputAssemblyState
  rasterization: RasterizationState
  depth_stencil: DepthStencilState
  color_blend: ColorBlendState
  viewports: Vec[Viewport]
  scissors: Vec[Scissor]
  layout: Int
  render_pass: Int
end

struct GraphicsPipeline
  id: Int
  layout: Int
end

