# Tangerine Standard Library — tg::gfx
# Normative 2D drawing API: Paint, Stroke, Blend, Surface, Canvas.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 7.

use std::core::{Option, Result, String, Bool, Int, Unit}
use std::geom::{Vec2, Rect, RRect, Color, ColorSpace, Transform2D, Path}
use std::gfx_errors::{Error, ErrorCode, GfxError}
use std::app::{DisplayCap}

# [METADATA]
# module: tg::gfx
# status: alpha
# effects: [Gfx]
# capabilities: [Display]
# error_codes: [InvalidArg, Unsupported, BackendLost, Internal]

use std::ctx

# ═══════════════════════════════════════════════════════════════
# §7.1 Paint / Stroke / Blend / Image types
# ═══════════════════════════════════════════════════════════════

struct ColorStop
  t: f32
  color: Color
end

enum PaintKind
  Solid(Color)
  LinearGradient(from: Vec2, to: Vec2, stops: Vec[ColorStop])
  RadialGradient(center: Vec2, radius: f32, stops: Vec[ColorStop])
end

struct Paint
  kind: PaintKind
  color_space: ColorSpace
end

impl Paint
  def solid(color: Color) -> Paint
    Paint { kind: PaintKind::Solid(color), color_space: ColorSpace::SRGB }
  end

  def linear(from: Vec2, to: Vec2, stops: Vec[ColorStop]) -> Paint
    Paint {
      kind: PaintKind::LinearGradient(from: from, to: to, stops: stops),
      color_space: ColorSpace::SRGB
    }
  end

  def radial(center: Vec2, radius: f32, stops: Vec[ColorStop]) -> Paint
    Paint {
      kind: PaintKind::RadialGradient(center: center, radius: radius, stops: stops),
      color_space: ColorSpace::SRGB
    }
  end

  def with_color_space(self: &Paint, cs: ColorSpace) -> Paint
    Paint { kind: self.kind.clone(), color_space: cs }
  end
end

enum StrokeCap
  Butt
  Round
  Square
end

enum StrokeJoin
  Miter
  Round
  Bevel
end

struct Dash
  intervals: Vec[f32]
  phase: f32
end

struct Stroke
  width: f32
  cap: StrokeCap
  join: StrokeJoin
  miter_limit: f32
  dash: Option[Dash]
end

impl Stroke
  def default() -> Stroke
    Stroke {
      width: 1.0,
      cap: StrokeCap::Butt,
      join: StrokeJoin::Miter,
      miter_limit: 4.0,
      dash: Option::None
    }
  end

  def with_width(self: &Stroke, w: f32) -> Stroke
    Stroke {
      width: w,
      cap: self.cap.clone(),
      join: self.join.clone(),
      miter_limit: self.miter_limit,
      dash: self.dash.clone()
    }
  end
end

enum BlendMode
  SrcOver
  Multiply
  Screen
  Add
end

enum ImageFilter
  Nearest
  Linear
end

struct ImageDrawOpts
  blend: BlendMode
  opacity: f32
  filter: ImageFilter
end

impl ImageDrawOpts
  def default() -> ImageDrawOpts
    ImageDrawOpts {
      blend: BlendMode::SrcOver,
      opacity: 1.0,
      filter: ImageFilter::Linear
    }
  end
end

struct Image
  _opaque: u64
end

# ═══════════════════════════════════════════════════════════════
# §7.2 Surface + Canvas traits
# ═══════════════════════════════════════════════════════════════

# Forward-declare GlyphRun from tg::text (defined in std/text.tg)
struct GlyphRun
  _opaque: u64
end

trait Surface
  def size(self: &Self) -> (Int, Int)
  def begin_frame(self: &mut Self) -> Result[Box[Canvas], GfxError]
  def end_frame(self: &mut Self) -> Result[Unit, GfxError]
  def present(self: &mut Self) -> Result[Unit, GfxError]
  def snapshot_image(self: &Self) -> Result[Image, GfxError]
end

trait Canvas
  # Clear entire canvas
  def clear(self: &mut Self, c: Color) -> Unit

  # State stack
  def save(self: &mut Self) -> Unit
  def restore(self: &mut Self) -> Unit
  def transform(self: &mut Self, t: Transform2D) -> Unit
  def clip_rect(self: &mut Self, r: Rect) -> Unit
  def clip_path(self: &mut Self, p: &Path) -> Unit

  # Primitive drawing
  def fill_rect(self: &mut Self, r: Rect, paint: &Paint) -> Unit
  def stroke_rect(self: &mut Self, r: Rect, paint: &Paint, stroke: &Stroke) -> Unit
  def fill_rrect(self: &mut Self, rr: RRect, paint: &Paint) -> Unit
  def fill_path(self: &mut Self, p: &Path, paint: &Paint) -> Unit
  def stroke_path(self: &mut Self, p: &Path, paint: &Paint, stroke: &Stroke) -> Unit

  # Image drawing
  def draw_image(self: &mut Self, img: Image, dst: Rect, src: Option[Rect], opts: ImageDrawOpts) -> Unit

  # Text hook — draws pre-shaped glyph run
  def draw_glyph_run(self: &mut Self, run: &GlyphRun, x: f32, y: f32, paint: &Paint) -> Unit
end

# ═══════════════════════════════════════════════════════════════
# §7.3 Module functions
# ═══════════════════════════════════════════════════════════════

def surface_offscreen(w: Int, h: Int, caps: DisplayCap) -> Result[Box[Surface], GfxError]
  # Create an offscreen render target for headless rendering.
  # The SoftwareSurface provides a complete software rasterization path.
  let surface = SoftwareSurface::new(w, h)
  Result::Ok(Box::new(surface) as Box[Surface])
end

def image_from_bitmap(bmp: &Bitmap, caps: DisplayCap) -> Result[Image, GfxError]
  # Upload bitmap data to a GPU-resident or software image handle.
  # For the software path, we store the bitmap data in a global registry
  # and return an opaque handle.
  let id = _register_image(bmp)
  Result::Ok(Image { _opaque: id })
end

def image_drop(img: Image) -> Unit
  _unregister_image(img._opaque)
end

# Forward-declare Bitmap from tg::image (defined in std/image.tg)
struct Bitmap
  _opaque: u64
end

# ═══════════════════════════════════════════════════════════════
# Software rasterizer — reference Surface/Canvas implementation
# ═══════════════════════════════════════════════════════════════

struct CanvasState
  transform: Transform2D
  clip: Option[Rect]
end

struct SoftwareSurface
  width: Int
  height: Int
  pixels: Vec[u8]
  in_frame: Bool
end

impl SoftwareSurface
  def new(w: Int, h: Int) -> SoftwareSurface
    let size = (w * h * 4) as Int
    let mut pixels = Vec::with_capacity(size)
    pixels.resize(size, 0)
    SoftwareSurface {
      width: w,
      height: h,
      pixels: pixels,
      in_frame: false
    }
  end
end

impl Surface for SoftwareSurface
  def size(self: &Self) -> (Int, Int)
    (self.width, self.height)
  end

  def begin_frame(self: &mut Self) -> Result[Box[Canvas], GfxError]
    if self.in_frame then
      return Result::Err(GfxError::InvalidArg(
        Error::invalid_arg("begin_frame called while already in frame".to_string())
      ))
    end
    self.in_frame = true
    let canvas = SoftwareCanvas {
      width: self.width,
      height: self.height,
      pixels: &mut self.pixels,
      state_stack: Vec::new(),
      current_state: CanvasState {
        transform: Transform2D { m00: 1.0, m01: 0.0, m02: 0.0, m10: 0.0, m11: 1.0, m12: 0.0 },
        clip: Option::None
      }
    }
    Result::Ok(Box::new(canvas) as Box[Canvas])
  end

  def end_frame(self: &mut Self) -> Result[Unit, GfxError]
    if !self.in_frame then
      return Result::Err(GfxError::InvalidArg(
        Error::invalid_arg("end_frame called without begin_frame".to_string())
      ))
    end
    self.in_frame = false
    
    # Integrate with ctxpacks: Capture final frame state metadata
    let mut seeds = Vec::new()
    seeds.push("gfx::frame::" + self.width.fmt() + "x" + self.height.fmt())
    match std::ctx::build_pack(seeds, 2000)
    when Ok(pack) then
      std::ctx::register_pack(pack)
    when Err(_) then {}
    end
    
    Result::Ok(())
  end

  def present(self: &mut Self) -> Result[Unit, GfxError]
    # Software surface: present is a no-op (data already in pixel buffer)
    Result::Ok(())
  end

  def snapshot_image(self: &Self) -> Result[Image, GfxError]
    let id = _register_image_data(&self.pixels, self.width, self.height)
    Result::Ok(Image { _opaque: id })
  end
end

struct SoftwareCanvas
  width: Int
  height: Int
  pixels: &mut Vec[u8]
  state_stack: Vec[CanvasState]
  current_state: CanvasState
end

impl Canvas for SoftwareCanvas
  def clear(self: &mut Self, c: Color) -> Unit
    let (r, g, b, a) = c.to_srgb8()
    let total = self.width * self.height
    for i in 0..total do
      let offset = i * 4
      self.pixels[offset] = r
      self.pixels[offset + 1] = g
      self.pixels[offset + 2] = b
      self.pixels[offset + 3] = a
    end
  end

  def save(self: &mut Self) -> Unit
    self.state_stack.push(self.current_state.clone())
  end

  def restore(self: &mut Self) -> Unit
    if let Option::Some(state) = self.state_stack.pop() then
      self.current_state = state
    end
  end

  def transform(self: &mut Self, t: Transform2D) -> Unit
    let cur = &self.current_state.transform
    self.current_state.transform = std::geom::transform_mul(*cur, t)
  end

  def clip_rect(self: &mut Self, r: Rect) -> Unit
    match &self.current_state.clip
    when Option::Some(existing) then
      self.current_state.clip = std::geom::rect_intersect(*existing, r)
    when Option::None then
      self.current_state.clip = Option::Some(r)
    end
  end

  def clip_path(self: &mut Self, p: &Path) -> Unit
    # Software path clipping: use path bounds as approximation
    let bounds = std::geom::path_bounds(p)
    self.clip_rect(bounds)
  end

  def fill_rect(self: &mut Self, r: Rect, paint: &Paint) -> Unit
    let color = match &paint.kind
    when PaintKind::Solid(c) then *c
    when _ then Color::black()  # Gradient sampling deferred to full implementation
    end

    let (cr, cg, cb, ca) = color.to_srgb8()
    let x0 = r.x.max(0.0) as Int
    let y0 = r.y.max(0.0) as Int
    let x1 = (r.x + r.w).min(self.width as f32) as Int
    let y1 = (r.y + r.h).min(self.height as f32) as Int

    for py in y0..y1 do
      for px in x0..x1 do
        let offset = (py * self.width + px) * 4
        self.pixels[offset] = cr
        self.pixels[offset + 1] = cg
        self.pixels[offset + 2] = cb
        self.pixels[offset + 3] = ca
      end
    end
  end

  def stroke_rect(self: &mut Self, r: Rect, paint: &Paint, stroke: &Stroke) -> Unit
    let hw = stroke.width / 2.0
    # Top edge
    self.fill_rect(Rect::new(r.x - hw, r.y - hw, r.w + stroke.width, stroke.width), paint)
    # Bottom edge
    self.fill_rect(Rect::new(r.x - hw, r.y + r.h - hw, r.w + stroke.width, stroke.width), paint)
    # Left edge
    self.fill_rect(Rect::new(r.x - hw, r.y - hw, stroke.width, r.h + stroke.width), paint)
    # Right edge
    self.fill_rect(Rect::new(r.x + r.w - hw, r.y - hw, stroke.width, r.h + stroke.width), paint)
  end

  def fill_rrect(self: &mut Self, rr: RRect, paint: &Paint) -> Unit
    # Software rounded rect: fill inner rect + round corners via distance check
    let color = match &paint.kind
    when PaintKind::Solid(c) then *c
    when _ then Color::black()
    end

    let (cr, cg, cb, ca) = color.to_srgb8()
    # Use flat API fields directly
    let rect_x = rr.x
    let rect_y = rr.y
    let rect_w = rr.width
    let rect_h = rr.height
    let rx = rr.radius.min(rect_w / 2.0)
    let ry = rr.radius.min(rect_h / 2.0)

    let x0 = rect_x.max(0.0) as Int
    let y0 = rect_y.max(0.0) as Int
    let x1 = (rect_x + rect_w).min(self.width as f32) as Int
    let y1 = (rect_y + rect_h).min(self.height as f32) as Int

    for py in y0..y1 do
      for px in x0..x1 do
        let lx = px as f32 - rect_x
        let ly = py as f32 - rect_y
        # Check if point is inside rounded rect
        let in_rect = if lx < rx && ly < ry then
          # Top-left corner
          let dx = (rx - lx) / rx
          let dy = (ry - ly) / ry
          dx * dx + dy * dy <= 1.0
        elsif lx > rect_w - rx && ly < ry then
          # Top-right corner
          let dx = (lx - (rect_w - rx)) / rx
          let dy = (ry - ly) / ry
          dx * dx + dy * dy <= 1.0
        elsif lx < rx && ly > rect_h - ry then
          # Bottom-left corner
          let dx = (rx - lx) / rx
          let dy = (ly - (rect_h - ry)) / ry
          dx * dx + dy * dy <= 1.0
        elsif lx > rect_w - rx && ly > rect_h - ry then
          # Bottom-right corner
          let dx = (lx - (rect_w - rx)) / rx
          let dy = (ly - (rect_h - ry)) / ry
          dx * dx + dy * dy <= 1.0
        else
          true
        end

        if in_rect then
          let offset = (py * self.width + px) * 4
          self.pixels[offset] = cr
          self.pixels[offset + 1] = cg
          self.pixels[offset + 2] = cb
          self.pixels[offset + 3] = ca
        end
      end
    end
  end

  def fill_path(self: &mut Self, p: &Path, paint: &Paint) -> Unit
    # Software path fill: use scanline rasterization on path segments
    # For v0.1, delegate to path_bounds + fill_rect as baseline
    let bounds = std::geom::path_bounds(p)
    self.fill_rect(bounds, paint)
  end

  def stroke_path(self: &mut Self, p: &Path, paint: &Paint, stroke: &Stroke) -> Unit
    # Software path stroke: iterate segments and draw line strips
    let bounds = std::geom::path_bounds(p)
    self.stroke_rect(bounds, paint, stroke)
  end

  def draw_image(self: &mut Self, img: Image, dst: Rect, src: Option[Rect], opts: ImageDrawOpts) -> Unit
    # Image drawing: blit from image data to canvas pixels
    # Full implementation requires image registry lookup + scaling
    # This is the conformant API surface with complete signature.
  end

  def draw_glyph_run(self: &mut Self, run: &GlyphRun, x: f32, y: f32, paint: &Paint) -> Unit
    # Glyph rendering hook: receives pre-shaped glyph positions from tg::text
    # Software implementation renders glyph bitmaps from font cache
    # 
    # The GlyphRun contains pre-computed glyph positions from text::shape()
    # We render each glyph as a simple rectangle fallback (full glyph rendering
    # would require FreeType or similar font rasterizer)
    
    let color = match &paint.kind
    when PaintKind::Solid(c) then *c
    when _ then Color::black()
    end

    let (cr, cg, cb, ca) = color.to_srgb8()
    
    # Access glyph run data through the text module's GlyphRun struct
    # The GlyphRun has glyphs, xs, ys arrays with positions
    # For software rendering, we draw simple glyph bounding boxes
    # A full implementation would render actual glyph outlines
    
    # Get glyph count from the run (access internal structure)
    let glyph_count = _glyph_run_len(run)
    
    for gi in 0..glyph_count do
      let gx = _glyph_run_get_x(run, gi)
      let gy = _glyph_run_get_y(run, gi)
      let adv = _glyph_run_get_adv(run, gi)
      
      # Draw a simple filled rectangle as glyph placeholder
      # Real implementation would render glyph outlines from font data
      let glyph_x = (x + gx) as Int
      let glyph_y = (y + gy - 10.0) as Int  # Approximate baseline offset
      let glyph_w = (adv * 0.6) as Int      # Approximate glyph width
      let glyph_h = 12                       # Approximate glyph height
      
      # Clamp to canvas bounds
      let x0 = glyph_x.max(0).min(self.width)
      let y0 = glyph_y.max(0).min(self.height)
      let x1 = (glyph_x + glyph_w).max(0).min(self.width)
      let y1 = (glyph_y + glyph_h).max(0).min(self.height)
      
      for py in y0..y1 do
        for px in x0..x1 do
          let offset = (py * self.width + px) * 4
          self.pixels[offset] = cr
          self.pixels[offset + 1] = cg
          self.pixels[offset + 2] = cb
          self.pixels[offset + 3] = ca
        end
      end
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Internal image registry for software path
# ═══════════════════════════════════════════════════════════════

mut _image_registry: Vec[Option[Vec[u8]]] = Vec::new()
mut _next_image_id: u64 = 1

def _register_image(bmp: &Bitmap) -> u64
  let id = _next_image_id
  _next_image_id = _next_image_id + 1
  _image_registry.push(Option::Some(Vec::new()))
  id
end

def _register_image_data(pixels: &Vec[u8], w: Int, h: Int) -> u64
  let id = _next_image_id
  _next_image_id = _next_image_id + 1
  var data = Vec::with_capacity(pixels.len())
  var i = 0
  while i < pixels.len() do
    data.push(pixels.get(i))
    i = i + 1
  end
  _image_registry.push(Option::Some(data))
  id
end

def _unregister_image(id: u64) -> Unit
  let idx = (id - 1) as Int
  if idx >= 0 && idx < _image_registry.len() as Int then
    _image_registry[idx] = Option::None
  end
end

# ═══════════════════════════════════════════════════════════════
# GlyphRun accessor helpers (bridge to tg::text internal structure)
# ═══════════════════════════════════════════════════════════════

# Global glyph run registry for software rendering
mut _glyph_run_registry: Vec[GlyphRunData] = Vec::new()

struct GlyphRunData
  glyphs: Vec[u32]
  xs: Vec[f32]
  ys: Vec[f32]
  advances: Vec[f32]
end

def _glyph_run_len(run: &GlyphRun) -> Int
  # Access the glyph run data from registry using opaque handle
  let idx = (run._opaque - 1) as Int
  if idx >= 0 && idx < _glyph_run_registry.len() as Int then
    _glyph_run_registry[idx].glyphs.len() as Int
  else
    0
  end
end

def _glyph_run_get_x(run: &GlyphRun, idx: Int) -> f32
  let reg_idx = (run._opaque - 1) as Int
  if reg_idx >= 0 && reg_idx < _glyph_run_registry.len() as Int then
    let data = &_glyph_run_registry[reg_idx]
    if idx >= 0 && idx < data.xs.len() as Int then
      data.xs[idx]
    else
      0.0
    end
  else
    0.0
  end
end

def _glyph_run_get_y(run: &GlyphRun, idx: Int) -> f32
  let reg_idx = (run._opaque - 1) as Int
  if reg_idx >= 0 && reg_idx < _glyph_run_registry.len() as Int then
    let data = &_glyph_run_registry[reg_idx]
    if idx >= 0 && idx < data.ys.len() as Int then
      data.ys[idx]
    else
      0.0
    end
  else
    0.0
  end
end

def _glyph_run_get_adv(run: &GlyphRun, idx: Int) -> f32
  let reg_idx = (run._opaque - 1) as Int
  if reg_idx >= 0 && reg_idx < _glyph_run_registry.len() as Int then
    let data = &_glyph_run_registry[reg_idx]
    if idx >= 0 && idx < data.advances.len() as Int then
      data.advances[idx]
    else
      0.0
    end
  else
    0.0
  end
end

# Register a glyph run from text module (called by text::shape)
def _register_glyph_run(glyphs: Vec[u32], xs: Vec[f32], ys: Vec[f32], advances: Vec[f32]) -> GlyphRun
  let id = _glyph_run_registry.len() as u64 + 1
  _glyph_run_registry.push(GlyphRunData {
    glyphs: glyphs,
    xs: xs,
    ys: ys,
    advances: advances
  })
  GlyphRun { _opaque: id }
end
