# Tangerine Standard Library — std::gfx
# Graphics API - Vulkan, Metal, OpenGL abstraction
# Full rendering pipeline support

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, Ptr, Float}
use std::collections::{Map}
use std::gpu
use std::app::{DisplayCap, Surface as AppSurface}
use std::geom::{Vec2, Color, ColorSpace, Rect, RRect, Path, Transform2D, transform_identity}
use std::gfx_errors::{Error, GfxError}
use std::text::{GlyphRun}

# ═══════════════════════════════════════════════════════════════
# Graphics Backend
# ═══════════════════════════════════════════════════════════════

enum GfxBackend
  Vulkan
  Metal
  OpenGL
  Direct3D11
  Direct3D12
end

# ═══════════════════════════════════════════════════════════════
# Window and Surface
# ═══════════════════════════════════════════════════════════════

struct WindowDesc
  title: String
  width: Int
  height: Int
  fullscreen: Bool
  vsync: Bool
  resizable: Bool
end

def WindowDesc::default() -> WindowDesc
  WindowDesc {
    title: "Tangerine".to_string(),
    width: 1280,
    height: 720,
    fullscreen: false,
    vsync: true,
    resizable: true
  }
end

struct Window
  id: Int
  handle: Ptr
  width: Int
  height: Int
  should_close: Bool
end

struct Surface
  id: Int
  window: Int
  format: gpu::ImageFormat
end

# ═══════════════════════════════════════════════════════════════
# 2D Paint and software surface API
# ═══════════════════════════════════════════════════════════════

struct ColorStop
  t: f32
  color: Color
end

enum PaintKind
  Solid(Color)
  Linear(Vec2, Vec2, Vec[ColorStop])
  Radial(Vec2, f32, Vec[ColorStop])
end

struct Paint
  kind: PaintKind
  color_space: ColorSpace
  stops: Vec[ColorStop]
  opacity: f32
end

impl Paint
  def solid(color: Color) -> Paint
    Paint {
      kind: PaintKind::Solid(color),
      color_space: ColorSpace::SRGB,
      stops: Vec::new(),
      opacity: color.a
    }
  end
end

def solid_paint(color: Color) -> Paint
  Paint::solid(color)
end

def linear_paint(start: Vec2, end_pt: Vec2, stops: Vec[ColorStop]) -> Paint
  Paint {
    kind: PaintKind::Linear(start, end_pt, stops.clone()),
    color_space: ColorSpace::SRGB,
    stops: stops,
    opacity: 1.0f32
  }
end

enum StrokeCap
  Butt
  Round
  Square
end

enum StrokeJoin
  Miter
  Round
  Bevel
end

struct Dash
  pattern: Vec[f32]
  phase: f32
end

struct Stroke
  width: f32
  cap: StrokeCap
  join: StrokeJoin
  miter_limit: f32
  dash: Option[Dash]
end

enum BlendMode
  SrcOver
  SrcIn
  SrcOut
  DstOver
  Clear
end

enum ImageFilter
  Nearest
  Bilinear
end

struct Image
  width: Int
  height: Int
  pixels: Vec[u8]
end

struct ImageDrawOpts
  blend: BlendMode
  opacity: f32
  filter: ImageFilter
end

enum DrawCommand
  Clear(Color)
  FillRect(Rect, Paint)
  FillRRect(RRect, Paint)
  FillPath(Path, Paint)
  StrokePath(Path, Paint, Stroke)
  DrawGlyphRun(u64, f32, f32, Paint)
  DrawImage(Image, Rect, f32)
  ClipRect(Rect)
  Save(Transform2D)
  Restore
  Transform(Transform2D)
end

struct Canvas
  width: Int
  height: Int
  commands: Vec[DrawCommand]
  transform_stack: Vec[Transform2D]
  clip_stack: Vec[Rect]
  current_transform: Transform2D
end

impl Canvas
  def new(width: Int, height: Int) -> Canvas
    Canvas {
      width: width,
      height: height,
      commands: Vec::new(),
      transform_stack: Vec::new(),
      clip_stack: Vec::new(),
      current_transform: transform_identity()
    }
  end

  def clear(inout self: Canvas, color: Color) -> Unit
    self.commands.push(DrawCommand::Clear(color))
  end

  def fill_rect(inout self: Canvas, rect: Rect, paint: Paint) -> Unit
    self.commands.push(DrawCommand::FillRect(rect, paint.clone()))
  end

  def fill_rrect(inout self: Canvas, rect: RRect, paint: Paint) -> Unit
    self.commands.push(DrawCommand::FillRRect(rect, paint.clone()))
  end

  def fill_path(inout self: Canvas, path: Path, paint: Paint) -> Unit
    self.commands.push(DrawCommand::FillPath(path, paint.clone()))
  end

  def stroke_path(inout self: Canvas, path: Path, paint: Paint, stroke: Stroke) -> Unit
    self.commands.push(DrawCommand::StrokePath(path, paint.clone(), stroke))
  end

  def draw_glyph_run(inout self: Canvas, run: GlyphRun, x: f32, y: f32, paint: Paint) -> Unit
    self.commands.push(DrawCommand::DrawGlyphRun(run._opaque, x, y, paint.clone()))
  end

  def draw_image(inout self: Canvas, image: Image, dst: Rect, opacity: f32) -> Unit
    self.commands.push(DrawCommand::DrawImage(image, dst, opacity))
  end

  def clip_rect(inout self: Canvas, rect: Rect) -> Unit
    self.clip_stack.push(rect)
    self.commands.push(DrawCommand::ClipRect(rect))
  end

  def save(inout self: Canvas) -> Unit
    self.transform_stack.push(self.current_transform)
    self.commands.push(DrawCommand::Save(self.current_transform))
  end

  def restore(inout self: Canvas) -> Unit
    if !self.transform_stack.is_empty() then
      self.current_transform = self.transform_stack.pop().unwrap()
    end
    self.commands.push(DrawCommand::Restore)
  end

  def transform(inout self: Canvas, transform: Transform2D) -> Unit
    self.current_transform = transform
    self.commands.push(DrawCommand::Transform(transform))
  end
end

struct SoftwareSurface
  width: Int
  height: Int
  frame_active: Bool
  last_frame: Vec[DrawCommand]
end

impl AppSurface for SoftwareSurface
  def size(self: Self) -> (Int, Int)
    (self.width, self.height)
  end

  def begin_frame(inout self: Self) -> Result[Box[Canvas], GfxError]
    if self.frame_active then
      return Result::Err(GfxError::InvalidArg(
        Error::invalid_arg("begin_frame called while a frame is already active".to_string())
      ))
    end
    self.frame_active = true
    Result::Ok(Box::new(Canvas::new(self.width, self.height)))
  end

  def end_frame(inout self: Self) -> Result[Unit, GfxError]
    if !self.frame_active then
      return Result::Err(GfxError::InvalidArg(
        Error::invalid_arg("end_frame called without an active frame".to_string())
      ))
    end
    self.frame_active = false
    Result::Ok(())
  end

  def present(inout self: Self) -> Result[Unit, GfxError]
    if self.frame_active then
      return Result::Err(GfxError::InvalidArg(
        Error::invalid_arg("present called before end_frame".to_string())
      ))
    end
    Result::Ok(())
  end
end

def surface_offscreen(width: Int, height: Int, display: DisplayCap) -> Result[Box[AppSurface], GfxError]
  if display._opaque == 0 then
    return Result::Err(GfxError::InvalidArg(
      Error::invalid_arg("surface_offscreen requires a valid DisplayCap".to_string())
    ))
  end
  if width <= 0 || height <= 0 then
    return Result::Err(GfxError::InvalidArg(
      Error::invalid_arg("surface_offscreen dimensions must be positive".to_string())
    ))
  end

  Result::Ok(Box::new(SoftwareSurface {
    width: width,
    height: height,
    frame_active: false,
    last_frame: Vec::new()
  }) as Box[AppSurface])
end

def create_software_surface(width: Int, height: Int) -> Box[AppSurface]
  let cap = DisplayCap { _opaque: 1 }
  surface_offscreen(width, height, cap).unwrap()
end

