# ═══════════════════════════════════════════════════════════════
# Core Graphics Structures
# ═══════════════════════════════════════════════════════════════

struct CGAffineTransform
  a: CGFloat
  b: CGFloat
  c: CGFloat
  d: CGFloat
  tx: CGFloat
  ty: CGFloat
end

def CGAffineTransform::identity() -> CGAffineTransform
  CGAffineTransform {
    a: 1.0,
    b: 0.0,
    c: 0.0,
    d: 1.0,
    tx: 0.0,
    ty: 0.0
  }
end

def CGAffineTransform::translation(tx: CGFloat, ty: CGFloat) -> CGAffineTransform
  CGAffineTransform {
    a: 1.0,
    b: 0.0,
    c: 0.0,
    d: 1.0,
    tx: tx,
    ty: ty
  }
end

def CGAffineTransform::scale(sx: CGFloat, sy: CGFloat) -> CGAffineTransform
  CGAffineTransform {
    a: sx,
    b: 0.0,
    c: 0.0,
    d: sy,
    tx: 0.0,
    ty: 0.0
  }
end

def CGAffineTransform::rotation(angle: CGFloat) -> CGAffineTransform
  let cos = angle.cos()
  let sin = angle.sin()
  CGAffineTransform {
    a: cos,
    b: sin,
    c: -sin,
    d: cos,
    tx: 0.0,
    ty: 0.0
  }
end

# ═══════════════════════════════════════════════════════════════
# ObjC Binding Helpers
# ═══════════════════════════════════════════════════════════════

def _cocoa_cls(name: String) -> Class
  let cs = CString::new(name)
  objc_getClass(cs.as_ptr())
end

def _cocoa_sel(name: String) -> SEL
  let cs = CString::new(name)
  sel_registerName(cs.as_ptr())
end

# ═══════════════════════════════════════════════════════════════
# High-Level Helpers
# ═══════════════════════════════════════════════════════════════

def get_nsstring(s: String) -> NSString
  let cls = _cocoa_cls("NSString")
  let sel = _cocoa_sel("stringWithUTF8String:")
  let cs = CString::new(s.clone())
  let obj = objc_msgSend(cls as Object, sel, cs.as_ptr())
  NSString { object: NSObject { isa: obj as Class } }
end

def nsstring_to_string(ns: NSString) -> String
  let sel = _cocoa_sel("UTF8String")
  let cstr = objc_msgSend(ns.object.isa as Object, sel)
  if cstr == Ptr::null() then
    return "".to_string()
  end
  String::from_cstr(cstr as Ptr[u8])
end

def get_nsnumber(n: Int) -> NSNumber
  let cls = _cocoa_cls("NSNumber")
  let sel = _cocoa_sel("numberWithLongLong:")
  let obj = objc_msgSend(cls as Object, sel, n)
  NSNumber { object: NSObject { isa: obj as Class } }
end

def nsnumber_to_int(ns: NSNumber) -> Int
  let sel = _cocoa_sel("longLongValue")
  objc_msgSend(ns.object.isa as Object, sel) as Int
end

def nsnumber_to_float(ns: NSNumber) -> Float
  # Get string representation and parse to avoid float-register ABI issues
  let sel = _cocoa_sel("stringValue")
  let str_obj = objc_msgSend(ns.object.isa as Object, sel)
  let ns_str = NSString { object: NSObject { isa: str_obj as Class } }
  let s = nsstring_to_string(&ns_str)
  s.parse_float().unwrap_or(0.0)
end

def get_nsarray() -> NSArray
  let cls = _cocoa_cls("NSArray")
  let sel = _cocoa_sel("array")
  let obj = objc_msgSend(cls as Object, sel)
  NSArray { object: NSObject { isa: obj as Class } }
end

def nsarray_len(arr: NSArray) -> UInt
  let sel = _cocoa_sel("count")
  objc_msgSend(arr.object.isa as Object, sel) as UInt
end

def nsarray_get(arr: NSArray, index: UInt) -> NSObject
  let sel = _cocoa_sel("objectAtIndex:")
  let obj = objc_msgSend(arr.object.isa as Object, sel, index)
  NSObject { isa: obj as Class }
end

def get_nsdictionary() -> NSDictionary
  let cls = _cocoa_cls("NSDictionary")
  let sel = _cocoa_sel("dictionary")
  let obj = objc_msgSend(cls as Object, sel)
  NSDictionary { object: NSObject { isa: obj as Class } }
end

def nsdictionary_get(dict: NSDictionary, key: NSString) -> NSObject
  let sel = _cocoa_sel("objectForKey:")
  let obj = objc_msgSend(dict.object.isa as Object, sel, key.object.isa as Object)
  NSObject { isa: obj as Class }
end

def nsdata_from_bytes(bytes: [u8]) -> NSData
  let cls = _cocoa_cls("NSData")
  let sel = _cocoa_sel("dataWithBytes:length:")
  let obj = objc_msgSend(cls as Object, sel, bytes.as_ptr(), bytes.len())
  NSData { object: NSObject { isa: obj as Class } }
end

def nsdata_to_bytes(data: NSData) -> Vec[u8]
  let bytes_sel = _cocoa_sel("bytes")
  let length_sel = _cocoa_sel("length")
  let ptr = objc_msgSend(data.object.isa as Object, bytes_sel)
  let len = objc_msgSend(data.object.isa as Object, length_sel) as UInt
  let mut result = Vec::with_capacity(len as Int)
  let mut i: UInt = 0
  let src = ptr as Ptr[u8]
  while i < len do
    result.push(*src.offset(i as Int))
    i = i + 1
  end
  result
end

# ═══════════════════════════════════════════════════════════════
# AppKit Helpers (macOS)
# ═══════════════════════════════════════════════════════════════

@cfg(target_os = "macos")
def create_ns_window(title: String, x: CGFloat, y: CGFloat, width: CGFloat, height: CGFloat) -> NSWindow
  let cls = _cocoa_cls("NSWindow")
  let alloc_sel = _cocoa_sel("alloc")
  let raw = objc_msgSend(cls as Object, alloc_sel)
  let init_sel = _cocoa_sel("initWithContentRect:styleMask:backing:defer:")
  let rect = CGRect { origin: CGPoint { x: x, y: y }, size: CGSize { width: width, height: height } }
  # styleMask: titled(1) | closable(2) | miniaturizable(4) | resizable(8) = 15
  let obj = objc_msgSend(raw, init_sel, rect, 15 as NSUInteger, 2 as NSUInteger, NO())
  let title_sel = _cocoa_sel("setTitle:")
  let ns_title = get_nsstring(title)
  objc_msgSend(obj, title_sel, ns_title.object.isa as Object)
  NSWindow { object: NSObject { isa: obj as Class } }
end

@cfg(target_os = "macos")
def nswindow_make_key_and_order_front(window: NSWindow) -> Unit
  let sel = _cocoa_sel("makeKeyAndOrderFront:")
  objc_msgSend(window.object.isa as Object, sel, nil())
  ()
end

@cfg(target_os = "macos")
def nsapplication_run() -> Unit
  let cls = _cocoa_cls("NSApplication")
  let shared_sel = _cocoa_sel("sharedApplication")
  let app = objc_msgSend(cls as Object, shared_sel)
  let run_sel = _cocoa_sel("run")
  objc_msgSend(app, run_sel)
  ()
end

@cfg(target_os = "macos")
def nsapplication_terminate(app: NSApplication) -> Unit
  let sel = _cocoa_sel("terminate:")
  objc_msgSend(app.object.isa as Object, sel, nil())
  ()
end

@cfg(target_os = "macos")
def create_ns_button(title: String, x: CGFloat, y: CGFloat, width: CGFloat, height: CGFloat) -> NSButton
  let cls = _cocoa_cls("NSButton")
  let alloc_sel = _cocoa_sel("alloc")
  let raw = objc_msgSend(cls as Object, alloc_sel)
  let frame = CGRect { origin: CGPoint { x: x, y: y }, size: CGSize { width: width, height: height } }
  let init_sel = _cocoa_sel("initWithFrame:")
  let obj = objc_msgSend(raw, init_sel, frame)
  let title_sel = _cocoa_sel("setTitle:")
  let ns_title = get_nsstring(title)
  objc_msgSend(obj, title_sel, ns_title.object.isa as Object)
  NSButton { view: NSView { object: NSObject { isa: obj as Class } } }
end

@cfg(target_os = "macos")
def create_ns_label(text: String, x: CGFloat, y: CGFloat, width: CGFloat, height: CGFloat) -> NSTextField
  let cls = _cocoa_cls("NSTextField")
  let alloc_sel = _cocoa_sel("alloc")
  let raw = objc_msgSend(cls as Object, alloc_sel)
  let frame = CGRect { origin: CGPoint { x: x, y: y }, size: CGSize { width: width, height: height } }
  let init_sel = _cocoa_sel("initWithFrame:")
  let obj = objc_msgSend(raw, init_sel, frame)
  let text_sel = _cocoa_sel("setStringValue:")
  let ns_text = get_nsstring(text)
  objc_msgSend(obj, text_sel, ns_text.object.isa as Object)
  let editable_sel = _cocoa_sel("setEditable:")
  objc_msgSend(obj, editable_sel, NO())
  let bordered_sel = _cocoa_sel("setBordered:")
  objc_msgSend(obj, bordered_sel, NO())
  let bg_sel = _cocoa_sel("setDrawsBackground:")
  objc_msgSend(obj, bg_sel, NO())
  NSTextField { view: NSView { object: NSObject { isa: obj as Class } } }
end

@cfg(target_os = "macos")
def nscolor_rgb(r: CGFloat, g: CGFloat, b: CGFloat) -> NSColor
  let cls = _cocoa_cls("NSColor")
  let sel = _cocoa_sel("colorWithRed:green:blue:alpha:")
  let obj = objc_msgSend(cls as Object, sel, r, g, b, 1.0 as CGFloat)
  NSColor { object: NSObject { isa: obj as Class } }
end

@cfg(target_os = "macos")
def nsfont_system(size: CGFloat) -> NSFont
  let cls = _cocoa_cls("NSFont")
  let sel = _cocoa_sel("systemFontOfSize:")
  let obj = objc_msgSend(cls as Object, sel, size)
  NSFont { object: NSObject { isa: obj as Class } }
end

# ═══════════════════════════════════════════════════════════════
# UIKit Helpers (iOS)
# ═══════════════════════════════════════════════════════════════

@cfg(target_os = "ios")
def create_ui_window(screen_bounds: CGRect) -> UIWindow
  let cls = _cocoa_cls("UIWindow")
  let alloc_sel = _cocoa_sel("alloc")
  let raw = objc_msgSend(cls as Object, alloc_sel)
  let init_sel = _cocoa_sel("initWithFrame:")
  let obj = objc_msgSend(raw, init_sel, screen_bounds)
  UIWindow { object: NSObject { isa: obj as Class } }
end

@cfg(target_os = "ios")
def uiwindow_make_key(window: UIWindow) -> Unit
  let sel = _cocoa_sel("makeKeyAndVisible")
  objc_msgSend(window.object.isa as Object, sel)
  ()
end

@cfg(target_os = "ios")
def uiapplication_main() -> Unit
  let cls = _cocoa_cls("UIApplication")
  let sel = _cocoa_sel("sharedApplication")
  let app = objc_msgSend(cls as Object, sel)
  let run_sel = _cocoa_sel("run")
  objc_msgSend(app, run_sel)
  ()
end

@cfg(target_os = "ios")
def create_ui_button(frame: CGRect) -> UIButton
  let cls = _cocoa_cls("UIButton")
  let sel = _cocoa_sel("buttonWithType:")
  let obj = objc_msgSend(cls as Object, sel, 0 as NSUInteger)
  let frame_sel = _cocoa_sel("setFrame:")
  objc_msgSend(obj, frame_sel, frame)
  UIButton { view: UIView { object: NSObject { isa: obj as Class } } }
end

@cfg(target_os = "ios")
def create_ui_label(frame: CGRect) -> UILabel
  let cls = _cocoa_cls("UILabel")
  let alloc_sel = _cocoa_sel("alloc")
  let raw = objc_msgSend(cls as Object, alloc_sel)
  let init_sel = _cocoa_sel("initWithFrame:")
  let obj = objc_msgSend(raw, init_sel, frame)
  UILabel { view: UIView { object: NSObject { isa: obj as Class } } }
end

@cfg(target_os = "ios")
def create_ui_view(frame: CGRect) -> UIView
  let cls = _cocoa_cls("UIView")
  let alloc_sel = _cocoa_sel("alloc")
  let raw = objc_msgSend(cls as Object, alloc_sel)
  let init_sel = _cocoa_sel("initWithFrame:")
  let obj = objc_msgSend(raw, init_sel, frame)
  UIView { object: NSObject { isa: obj as Class } }
end

@cfg(target_os = "ios")
def create_uiview_controller() -> UIViewController
  let cls = _cocoa_cls("UIViewController")
  let alloc_sel = _cocoa_sel("alloc")
  let raw = objc_msgSend(cls as Object, alloc_sel)
  let init_sel = _cocoa_sel("init")
  let obj = objc_msgSend(raw, init_sel)
  UIViewController { object: NSObject { isa: obj as Class } }
end

@cfg(target_os = "ios")
def uicolor_rgb(r: CGFloat, g: CGFloat, b: CGFloat) -> UIColor
  let cls = _cocoa_cls("UIColor")
  let sel = _cocoa_sel("colorWithRed:green:blue:alpha:")
  let obj = objc_msgSend(cls as Object, sel, r, g, b, 1.0 as CGFloat)
  UIColor { object: NSObject { isa: obj as Class } }
end

@cfg(target_os = "ios")
def uifont_system(size: CGFloat) -> UIFont
  let cls = _cocoa_cls("UIFont")
  let sel = _cocoa_sel("systemFontOfSize:")
  let obj = objc_msgSend(cls as Object, sel, size)
  UIFont { object: NSObject { isa: obj as Class } }
end

@cfg(target_os = "ios")
def uiview_add_subview(view: UIView, subview: UIView) -> Unit
  let sel = _cocoa_sel("addSubview:")
  objc_msgSend(view.object.isa as Object, sel, subview.object.isa as Object)
  ()
end

@cfg(target_os = "ios")
def uiapplication_shared() -> UIApplication
  let cls = _cocoa_cls("UIApplication")
  let sel = _cocoa_sel("sharedApplication")
  let obj = objc_msgSend(cls as Object, sel)
  UIApplication { object: NSObject { isa: obj as Class } }
end

# ═══════════════════════════════════════════════════════════════
# Common Constants
# ═══════════════════════════════════════════════════════════════

def nil() -> Object = Ptr::null()
def YES() -> BOOL = 1
def NO() -> BOOL = 0

def kCFBooleanTrue() -> Ptr
  let lib_path = CString::new("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
  let sym_name = CString::new("kCFBooleanTrue")
  let lib = dynload::dlopen(lib_path.as_ptr(), 0x1)
  let sym_ptr = dynload::dlsym(lib, sym_name.as_ptr())
  unsafe "loading CF global" do @ptr_read(sym_ptr as Ptr[Ptr], Ptr) end
end
def kCFBooleanFalse() -> Ptr
  let lib_path = CString::new("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
  let sym_name = CString::new("kCFBooleanFalse")
  let lib = dynload::dlopen(lib_path.as_ptr(), 0x1)
  let sym_ptr = dynload::dlsym(lib, sym_name.as_ptr())
  unsafe "loading CF global" do @ptr_read(sym_ptr as Ptr[Ptr], Ptr) end
end

def CGRectZero() -> CGRect = CGRect { origin: CGPoint { x: 0.0, y: 0.0 }, size: CGSize { width: 0.0, height: 0.0 } }
def CGPointZero() -> CGPoint = CGPoint { x: 0.0, y: 0.0 }
def CGSizeZero() -> CGSize = CGSize { width: 0.0, height: 0.0 }
