# Tangerine Standard Library — std::lsp
# Language Server Protocol 3.17 — the PROTOCOL + DELEGATION layer.
#
# The language analysis is owned by the COMPILER's language server: the
# driver's `tg ln` endpoint (tg_compiler/driver.tg — the ln_server_* /
# ln_main_loop surface), which consumes the compiler's own source
# lexer/parser/resolver/diagnostics/symbol graph. This module's internal
# lexer/parser fork (the removed mut/move/ref keyword era) is GONE: it
# never re-parses source text.
#
# What this module provides:
#   - the LSP wire types (Position, Range, Location, Diagnostic,
#     TextEdit, CompletionItem, DocumentSymbol, Hover, FoldingRange)
#     with their JSON encodings;
#   - the client-side document model (TextDocument: full/incremental
#     change application);
#   - the launcher: LanguageServer::run() hands the editor's stdio
#     connection to the compiler's language server (inherited stdio) and
#     waits — the delegation to the compiler's LSP endpoints.

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt}
use std::collections::{Map}
use std::json
use std::process::{Command}

# ═══════════════════════════════════════════════════════════════
# Core LSP Types
# ═══════════════════════════════════════════════════════════════

struct Position
  line: UInt
  character: UInt
end

def Position::to_json(self: Position) -> json::Value
  json::object({"line": self.line, "character": self.character})
end

def Position::from_json(v: json::Value) -> Result[Position, Unit]
  let line = match v.get("line") when Option::Some(l) => l.as_uint() when Option::None => return Result::Err(()) end
  let ch = match v.get("character") when Option::Some(c) => c.as_uint() when Option::None => return Result::Err(()) end
  Result::Ok(Position{line: line, character: ch})
end

# ═══════════════════════════════════════════════════════════════
# Position Encoding (the LSP 3.17 negotiated character units)
# ═══════════════════════════════════════════════════════════════
# LSP 3.17: a Position's `character` is expressed in the NEGOTIATED
# position encoding — UTF-16 code units by default, or UTF-8 / UTF-32
# when the client's initialize `positionEncodings` list is honored. The
# server picks the FIRST encoding of the client's offered list that it
# supports; an empty or all-unsupported list falls back to UTF-16 (the
# protocol default). The document model must convert the character unit
# to the BYTE offset the underlying String uses — the old
# position_to_offset added `pos.character` DIRECTLY to the byte offset,
# which is only correct for pure-ASCII UTF-8 documents and silently
# mis-maps every astral character under the UTF-16 default.

enum PositionEncoding
  Utf16
  Utf8
  Utf32
end

def PositionEncoding::kind_string(self: PositionEncoding) -> String
  match self
  when PositionEncoding::Utf16 then "utf-16".to_string()
  when PositionEncoding::Utf8 then "utf-8".to_string()
  when PositionEncoding::Utf32 then "utf-32".to_string()
  end
end

def PositionEncoding::from_kind_string(kind: String) -> Option[PositionEncoding]
  if kind == "utf-8" then Option::Some(PositionEncoding::Utf8)
  elsif kind == "utf-16" then Option::Some(PositionEncoding::Utf16)
  elsif kind == "utf-32" then Option::Some(PositionEncoding::Utf32)
  else Option::None
  end
end

## THE NEGOTIATION: the server's chosen encoding is the FIRST entry of
## the client's offered `positionEncodings` list that the server
## supports (this client library supports all three kinds); an empty
## list — or a list with no supported entry — falls back to UTF-16, the
## LSP 3.17 default.
def negotiate_position_encoding(client_supported: Vec[String]) -> PositionEncoding
  for enc in client_supported do
    match PositionEncoding::from_kind_string(enc.clone())
    when Option::Some(e) then return e
    when Option::None then ()
    end
  end
  PositionEncoding::Utf16
end

struct Range
  start: Position
  end_pos: Position
end

def Range::to_json(self: Range) -> json::Value
  json::object({"start": self.start.to_json(), "end": self.end_pos.to_json()})
end

def Range::from_json(v: json::Value) -> Result[Range, Unit]
  let start = Position::from_json(match v.get("start") when Option::Some(s) => s when Option::None => return Result::Err(()) end)?
  let end_pos = Position::from_json(match v.get("end") when Option::Some(e) => e when Option::None => return Result::Err(()) end)?
  Result::Ok(Range{start: start, end_pos: end_pos})
end

struct Location
  uri: String
  range: Range
end

def Location::to_json(self: Location) -> json::Value
  json::object({"uri": self.uri.clone(), "range": self.range.to_json()})
end

struct Diagnostic
  range: Range
  severity: Int
  code: String
  source: String
  message: String
end

def Diagnostic::to_json(self: Diagnostic) -> json::Value
  json::object({
    "range": self.range.to_json(),
    "severity": self.severity,
    "code": self.code.clone(),
    "source": self.source.clone(),
    "message": self.message.clone()
  })
end

struct TextEdit
  range: Range
  new_text: String
end

def TextEdit::to_json(self: TextEdit) -> json::Value
  json::object({"range": self.range.to_json(), "newText": self.new_text.clone()})
end

struct CompletionItem
  label: String
  kind: Int
  detail: String
  insert_text: String
end

def CompletionItem::to_json(self: CompletionItem) -> json::Value
  json::object({
    "label": self.label.clone(),
    "kind": self.kind,
    "detail": self.detail.clone(),
    "insertText": self.insert_text.clone()
  })
end

struct DocumentSymbol
  name: String
  kind: Int
  range: Range
  selection_range: Range
  children: Vec[DocumentSymbol]
end

def DocumentSymbol::to_json(self: DocumentSymbol) -> json::Value
  json::object({
    "name": self.name.clone(),
    "kind": self.kind,
    "range": self.range.to_json(),
    "selectionRange": self.selection_range.to_json(),
    "children": json::array(self.children.map(|c| c.to_json()))
  })
end

struct Hover
  contents: String
end

def Hover::to_json(self: Hover) -> json::Value
  json::object({"contents": json::object({"kind": "markdown", "value": self.contents.clone()})})
end

struct FoldingRange
  start_line: UInt
  end_line: UInt
  kind: String
end

def FoldingRange::to_json(self: FoldingRange) -> json::Value
  json::object({"startLine": self.start_line, "endLine": self.end_line, "kind": self.kind.clone()})
end

# ═══════════════════════════════════════════════════════════════
# Text Document Management (the client-side buffer model)
# ═══════════════════════════════════════════════════════════════
# The LSP client/embedding model: documents are tracked so the editor's
# buffer state is available to the compiler server when it is handed the
# connection. The ANALYSIS (tokens, symbols, diagnostics) is never
# derived here — it belongs to the compiler's server.

struct TextDocument
  uri: String
  version: Int
  text: String
  lines: Vec[String]
  position_encoding: PositionEncoding
end

def TextDocument::new(uri: String, version: Int, text: String) -> TextDocument
  # THE DEFAULT ENCODING: UTF-16 — the LSP 3.17 protocol default (the
  # client that did not negotiate an explicit positionEncoding gets
  # UTF-16 code units in every Position).
  TextDocument{uri: uri, version: version, text: text.clone(), lines: text.split("\n"), position_encoding: PositionEncoding::Utf16}
end

## Set the negotiated position encoding — the initialize handshake's
## result (the server's chosen entry from the client's positionEncodings
## list; see negotiate_position_encoding). Every subsequent
## position_to_offset conversion uses the chosen unit.
def TextDocument::set_position_encoding(inout self, enc: PositionEncoding) -> Unit
  self.position_encoding = enc
end

## THE CHARACTER-UNIT → BYTE-OFFSET CONVERSION (the reviewer's LSP-unit
## fix): the `character` is a count of the NEGOTIATED encoding's units
## (UTF-16 code units by default — an astral scalar is TWO units there —
## or UTF-8 bytes / UTF-32 scalars when negotiated), and the String
## offsets are BYTES. The conversion walks the line's UTF-8 code points,
## accumulating the chosen units per code point (1 for BMP/1-byte, 2 for
## an astral scalar under UTF-16), and returns the byte offset of the
## code-point boundary that reaches the target — a target inside a
## multi-unit code point CLAMPS to the code point's start (a position
## never splits a scalar), and a target beyond the line's end clamps to
## the line end (the LSP 3.17 line-length clamp). The CRLF case: the
## model splits on "\n" only, so the "\r" is line content and counts as
## one unit — exactly the LSP line semantics.
def TextDocument::position_to_offset(self: TextDocument, pos: Position) -> UInt
  if pos.line >= self.lines.len() then return self.text.len() end
  let mut offset = 0
  for i in 0..pos.line do
    offset += self.lines[i].len() + 1
  end
  offset + _line_character_to_byte(self.lines[pos.line as Int], pos.character, self.position_encoding)
end

## The UTF-8 byte length of the code point starting at the lead byte.
def _utf8_code_point_len(lead: u8) -> Int
  if lead < 0x80 then
    1
  elsif lead >= 0xC2 && lead <= 0xDF then
    2
  elsif lead >= 0xE0 && lead <= 0xEF then
    3
  elsif lead >= 0xF0 && lead <= 0xF4 then
    4
  else
    1
  end
end

## The per-line unit conversion: returns the byte offset within the line
## for the character count in the given encoding.
def _line_character_to_byte(line: String, character: UInt, enc: PositionEncoding) -> UInt
  let target = character as Int
  if target <= 0 then return 0 end
  let bytes = line.as_bytes()
  match enc
  when PositionEncoding::Utf8 then
    # A UTF-8 unit IS a byte: the character count is the byte offset
    # directly (clamped to the line length — the LSP 3.17 line-length
    # clamp).
    if target >= bytes.len() then
      bytes.len() as UInt
    else
      target as UInt
    end
  when PositionEncoding::Utf16 then
    _utf16_units_to_byte(&bytes, target)
  when PositionEncoding::Utf32 then
    _utf32_scalars_to_byte(&bytes, target)
  end
end

## The UTF-16 → byte conversion: walks the line's UTF-8 code points,
## accumulating the UTF-16 code units per code point (1 for every BMP
## scalar, 2 for an astral scalar — the surrogate pair), and returns the
## byte offset of the code-point boundary that reaches the target — a
## target inside a surrogate pair CLAMPS to the code point's start (a
## position never splits a scalar), and a target beyond the line's end
## clamps to the line end. The CRLF case: the model splits on "\n" only,
## so the "\r" is line content and counts as one unit — exactly the LSP
## line semantics.
def _utf16_units_to_byte(bytes: Vec[u8], target: Int) -> UInt
  var byte_pos = 0
  var units = 0
  while byte_pos < bytes.len() do
    let cp_len = _utf8_code_point_len(bytes[byte_pos])
    let width = if cp_len == 4 then 2 else 1 end
    if units + width > target then
      return byte_pos as UInt
    end
    units = units + width
    byte_pos = byte_pos + cp_len
    if units == target then
      return byte_pos as UInt
    end
  end
  bytes.len() as UInt
end

## The UTF-32 → byte conversion: one scalar = one unit; the walk returns
## the byte offset of the scalar boundary that reaches the target
## (clamped to the line end).
def _utf32_scalars_to_byte(bytes: Vec[u8], target: Int) -> UInt
  var byte_pos = 0
  var scalars = 0
  while byte_pos < bytes.len() do
    let cp_len = _utf8_code_point_len(bytes[byte_pos])
    if scalars + 1 > target then
      return byte_pos as UInt
    end
    scalars = scalars + 1
    byte_pos = byte_pos + cp_len
    if scalars == target then
      return byte_pos as UInt
    end
  end
  bytes.len() as UInt
end

def TextDocument::apply_full_change(inout self, text: String, version: Int)
  self.text = text.clone()
  self.lines = text.split("\n")
  self.version = version
end

def TextDocument::apply_incremental_change(inout self, range: Range, text: String, version: Int)
  let start_off = self.position_to_offset(&range.start)
  let end_off = self.position_to_offset(&range.end_pos)
  let before = self.text.slice(0, start_off)
  let after = self.text.slice(end_off, self.text.len())
  self.text = before + text + after
  self.lines = self.text.split("\n")
  self.version = version
end

# ═══════════════════════════════════════════════════════════════
# Language Server — the delegation launcher
# ═══════════════════════════════════════════════════════════════
# The compiler's language server (`tg ln` — the driver's LSP endpoints in
# tg_compiler/driver.tg) owns the whole analysis: the compiler's lexer,
# parser, ResolvedProgram/TypedProgram, diagnostics, and symbol graph.
# This module's in-process analysis fork was REMOVED (its keyword set
# predated the mut/move/ref removal); the only path to language analysis
# is the delegation below.

struct LanguageServer
  compiler_bin: String
  compiler_args: Vec[String]
end

def LanguageServer::new() -> LanguageServer
  LanguageServer {
    compiler_bin: "tg".to_string(),
    compiler_args: Vec::from(["ln".to_string()])
  }
end

## The exact delegation invocation: the compiler's LSP server binary and
## its arguments (the driver's `tg ln` endpoint).
def LanguageServer::compiler_invocation(self) -> (String, Vec[String])
  (self.compiler_bin.clone(), self.compiler_args.clone())
end

## Run the language server: the editor's stdio connection is handed to
## the compiler's LSP server (inherited stdin/stdout/stderr), which owns
## the analysis; the delegation returns when the compiler server exits.
def LanguageServer::run(self) -> Result[Unit, String]
  let (bin, args) = self.compiler_invocation()
  let mut cmd = Command::new(bin)
  for a in args do
    cmd = cmd.arg(a.as_str_view())
  end
  cmd = cmd.stdin_inherit()
  cmd = cmd.stdout_inherit()
  cmd = cmd.stderr_inherit()
  let child = match cmd.spawn()
  when Result::Ok(c) => c
  when Result::Err(e) => return Result::Err(e)
  end
  match child.wait()
  when Result::Ok(_) => Result::Ok(())
  when Result::Err(e) => Result::Err(e)
  end
end

def main() -> Int
  let server = LanguageServer::new()
  match server.run()
  when Result::Ok(_) => 0
  when Result::Err(_) => 1
  end
end
