# Tangerine Standard Library — Web Framework
#
# High-level web application framework with routing, templates, middleware.
#
# Usage:
#   let app = App::new()
#   app.get("/", handle_home)
#   app.get("/users/:id", handle_user)
#   app.middleware(logger)
#   app.listen("0.0.0.0:8080")?

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{Map, Set}
use std::sync::{Mutex}
use std::http::{HttpRequest, HttpResponse, HttpMethod, HttpServer, HttpStatus, HttpHeaders}
use std::json::{Json, JsonValue}
use std::serde::{Serialize, Deserialize}
use std::url

# ═══════════════════════════════════════════════════════════════
# PART 1: WEB APPLICATION
# ═══════════════════════════════════════════════════════════════

# ———————————————————————————————————————————————————————————————
# Context
# ———————————————————————————————————————————————————————————————

struct Context
  request: HttpRequest
  response: ResponseBuilder
  params: Map[String, String]
  query: Map[String, String]
  state: Map[String, String]
  locals: Map[String, String]
end

impl Context
  def new(request: HttpRequest) -> Context
    let query = parse_query_string(request.uri().query().unwrap_or(""))
    
    Context {
      request: request,
      response: ResponseBuilder::new(),
      params: Map::new(),
      query: query,
      state: Map::new(),
      locals: Map::new()
    }
  end
  
  # Request accessors
  def method(self: Context) -> HttpMethod
    self.request.method()
  end
  
  def path(self: Context) -> String
    self.request.uri().path().to_string()
  end
  
  def header(self: Context, name: str) -> Option[String]
    match self.request.headers().get(name)
    when Option::Some(v) then Option::Some(v.clone())
    when Option::None then Option::None
    end
  end
  
  def param(self: Context, name: str) -> Option[String]
    self.params.get_cloned(name)
  end
  
  def query_param(self: Context, name: str) -> Option[String]
    self.query.get_cloned(name)
  end
  
  def body(self: Context) -> Vec[u8]
    self.request.body()
  end
  
  def body_string(self: Context) -> Result[String, WebError]
    match String::from_utf8(self.body())
    when Result::Ok(s) then Result::Ok(s)
    when Result::Err(_) then Result::Err(WebError::InvalidBody("invalid UTF-8".to_string()))
    end
  end
  
  def json[T](self: Context) -> Result[T, WebError] where T: Deserialize
    let body = self.body_string()?
    match json::from_json[T](body.as_str())
    when Result::Ok(v) then Result::Ok(v)
    when Result::Err(e) then Result::Err(WebError::InvalidBody("JSON parse error: ".to_string() + e.to_string()))
    end
  end
  
  def form(self: Context) -> Result[Map[String, String], WebError]
    let body = self.body_string()?
    Result::Ok(parse_query_string(&body))
  end
  
  # Response builders
  def status(inout self: Context, code: HttpStatus) -> Unit
    self.response.status(code)
  end
  
  def set_header(inout self: Context, name: str, value: str) -> Unit
    self.response.header(name, value)
  end
  
  def content_type(inout self: Context, ct: str) -> Unit
    self.set_header("Content-Type", ct)
  end
  
  def text(inout self: Context, body: str) -> HttpResponse
    self.content_type("text/plain; charset=utf-8")
    self.response.body(body.as_bytes().to_vec())
    self.response.build()
  end
  
  def html(inout self: Context, body: str) -> HttpResponse
    self.content_type("text/html; charset=utf-8")
    self.response.body(body.as_bytes().to_vec())
    self.response.build()
  end
  
  def json_response[T](inout self: Context, value: T) -> HttpResponse where T: Serialize
    self.content_type("application/json")
    let json_str = Json::stringify(value)
    self.response.body(json_str.as_bytes().to_vec())
    self.response.build()
  end
  
  def redirect(inout self: Context, url: str) -> HttpResponse
    self.status(HttpStatus::new(302))
    self.set_header("Location", url)
    self.text("")
  end
  
  def redirect_permanent(inout self: Context, url: str) -> HttpResponse
    self.status(HttpStatus::new(301))
    self.set_header("Location", url)
    self.text("")
  end
  
  def not_found(inout self: Context) -> HttpResponse
    self.status(HttpStatus::new(404))
    self.text("Not Found")
  end
  
  def bad_request(inout self: Context, msg: str) -> HttpResponse
    self.status(HttpStatus::new(400))
    self.text(msg)
  end
  
  def internal_error(inout self: Context, msg: str) -> HttpResponse
    self.status(HttpStatus::new(500))
    self.text(msg)
  end
  
  def file(inout self: Context, path: str) -> Result[HttpResponse, WebError]
    let content = std::fs::read(path)
      .map_err(|e| WebError::IoError(e.to_string()))?
    
    let mime = guess_mime_type(path)
    self.content_type(mime)
    self.response.body(content)
    Result::Ok(self.response.build())
  end
  
  def set_cookie(inout self: Context, name: str, value: str, options: CookieOptions) -> Unit
    let cookie = format_cookie(name, value, options)
    self.set_header("Set-Cookie", &cookie)
  end
  
  def cookie(self: Context, name: str) -> Option[String]
    self.header("Cookie").and_then(|cookies| {
      parse_cookies(&cookies).get(name).cloned()
    })
  end
end

struct ResponseBuilder
  status: HttpStatus
  headers: HttpHeaders
  body: Vec[u8]
end

impl ResponseBuilder
  def new() -> ResponseBuilder
    ResponseBuilder {
      status: HttpStatus::new(200),
      headers: HttpHeaders::new(),
      body: Vec::new()
    }
  end
  
  def status(inout self: ResponseBuilder, code: HttpStatus) -> Unit
    self.status = code
  end
  
  def header(inout self: ResponseBuilder, name: str, value: str) -> Unit
    self.headers.set(name, value)
  end
  
  def body(inout self: ResponseBuilder, body: Vec[u8]) -> Unit
    self.body = body
  end
  
  def build(self: ResponseBuilder) -> HttpResponse
    HttpResponse::new(self.status.clone(), self.headers.clone(), self.body.clone())
  end
end

# ———————————————————————————————————————————————————————————————
# Error Type
# ———————————————————————————————————————————————————————————————

enum WebError
  RouteNotFound(String)   
  MethodNotAllowed
  InvalidBody(String)
  Unauthorized
  Forbidden
  IoError(String)
  Internal(String)
end

def web_error_status(e: WebError) -> HttpStatus
  match e
  when WebError::RouteNotFound(_) then HttpStatus::new(404)
  when WebError::MethodNotAllowed then HttpStatus::new(405)
  when WebError::InvalidBody(_) then HttpStatus::new(400)
  when WebError::Unauthorized then HttpStatus::new(401)
  when WebError::Forbidden then HttpStatus::new(403)
  when WebError::IoError(_) | WebError::Internal(_) then HttpStatus::new(500)
  end
end

## Returns a human-readable description of the web error.
def web_error_message(e: WebError) -> String
  match e
  when WebError::RouteNotFound(path) then "route not found: " + path.clone()
  when WebError::MethodNotAllowed then "method not allowed"
  when WebError::InvalidBody(msg) then "invalid body: " + msg.clone()
  when WebError::Unauthorized then "unauthorized"
  when WebError::Forbidden then "forbidden"
  when WebError::IoError(msg) then "IO error: " + msg.clone()
  when WebError::Internal(msg) then "internal error: " + msg.clone()
  end
end

impl Error for WebError
  def message(self) -> String
    web_error_message(self)
  end
end

# ———————————————————————————————————————————————————————————————
# Router
# ———————————————————————————————————————————————————————————————

type Handler = fn(inout Context) -> HttpResponse
type Middleware = fn(inout Context, fn(inout Context) -> HttpResponse) -> HttpResponse

struct Route
  method: HttpMethod
  pattern: RoutePattern
  handler: Handler
end

struct RoutePattern
  segments: Vec[RouteSegment]
  regex_pattern: Option[String]
end

enum RouteSegment
  Literal(String)
  Param(String)
  Wildcard
end

impl RoutePattern
  def parse(pattern: str) -> RoutePattern
    let mut segments = Vec::new()
    
    let parts = pattern.split("/")
    for part in parts do
      if part.is_empty() then
        continue
      end
      
      if part.starts_with(":") then
        segments.push(RouteSegment::Param(part.slice(1, part.len())))
      elsif part == "*" then
        segments.push(RouteSegment::Wildcard)
      else
        segments.push(RouteSegment::Literal(part))
      end
    end
    
    RoutePattern { segments: segments, regex_pattern: Option::None }
  end
  
  def matches(self: RoutePattern, path: str) -> Option[Map[String, String]]
    let mut params = Map::new()
    let mut i = 0
    
    let parts_raw = path.split("/")
    let mut parts = Vec::new()
    for p in parts_raw do
      if !p.is_empty() then
        parts.push(p)
      end
    end
    
    for segment in self.segments do
      match segment
      when RouteSegment::Literal(s) then
        if i >= parts.len() || parts[i] != s then
          return Option::None
        end
        i = i + 1
      when RouteSegment::Param(name) then
        if i >= parts.len() then
          return Option::None
        end
        params.insert(name.clone(), parts[i].clone())
        i = i + 1
      when RouteSegment::Wildcard then
        # Match rest of path
        let mut rest = "".to_string()
        let mut first = true
        let mut j = i
        while j < parts.len() do
          if !first then rest = rest + "/" end
          rest = rest + parts[j].clone()
          first = false
          j = j + 1
        end
        params.insert("*".to_string(), rest)
        return Option::Some(params)
      end
    end
    
    if i == parts.len() then
      Option::Some(params)
    else
      Option::None
    end
  end
end

struct Router
  routes: Vec[Route]
  # Fast-path index: (method, path) → route index for literal-only patterns
  literal_index: Map[String, UInt]
  middleware: Vec[Middleware]
  not_found_handler: Option[Handler]
  error_handler: Option[fn(WebError) -> HttpResponse]
end

impl Router
  def new() -> Router
    Router {
      routes: Vec::new(),
      literal_index: Map::new(),
      middleware: Vec::new(),
      not_found_handler: Option::None,
      error_handler: Option::None
    }
  end

  def add_route(inout self: Router, method: HttpMethod, pattern: str, handler: Handler) -> Unit
    let parsed = RoutePattern::parse(pattern)
    let idx = self.routes.len() as UInt
    let is_literal = parsed.segments.iter().all(|seg| match seg
      when RouteSegment::Literal(_) then true
      when _ then false
    end)
    self.routes.push(Route {
      method: method,
      pattern: parsed,
      handler: handler
    })
    # Index literal-only patterns for O(1) lookup
    if is_literal then
      let key = route_index_key(&method, pattern)
      self.literal_index.insert(key, idx)
    end
  end
  
  def get(inout self: Router, pattern: str, handler: Handler) -> Unit
    self.add_route(HttpMethod::Get, pattern, handler)
  end
  
  def post(inout self: Router, pattern: str, handler: Handler) -> Unit
    self.add_route(HttpMethod::Post, pattern, handler)
  end
  
  def put(inout self: Router, pattern: str, handler: Handler) -> Unit
    self.add_route(HttpMethod::Put, pattern, handler)
  end
  
  def delete(inout self: Router, pattern: str, handler: Handler) -> Unit
    self.add_route(HttpMethod::Delete, pattern, handler)
  end
  
  def patch(inout self: Router, pattern: str, handler: Handler) -> Unit
    self.add_route(HttpMethod::Patch, pattern, handler)
  end
  
  def options(inout self: Router, pattern: str, handler: Handler) -> Unit
    self.add_route(HttpMethod::Options, pattern, handler)
  end
  
  def head(inout self: Router, pattern: str, handler: Handler) -> Unit
    self.add_route(HttpMethod::Head, pattern, handler)
  end
  
  def middleware(inout self: Router, mw: Middleware) -> Unit
    self.middleware.push(mw)
  end
  
  def not_found(inout self: Router, handler: Handler) -> Unit
    self.not_found_handler = Option::Some(handler)
  end
  
  def error_handler(inout self: Router, handler: fn(WebError) -> HttpResponse) -> Unit
    self.error_handler = Option::Some(handler)
  end
  
  def route(self: Router, request: HttpRequest) -> Result[(Handler, Map[String, String]), WebError]
    let path = request.uri().path()
    let method = request.method()

    # Fast path: O(1) lookup for literal-only routes
    let key = route_index_key(method, path)
    match self.literal_index.get(&key)
    when Option::Some(idx) then
      return Result::Ok((self.routes[*idx as UInt].handler, Map::new()))
    when Option::None then ()
    end

    # Slow path: linear scan for parameterized/wildcard routes
    let mut method_matched = false

    for route in self.routes do
      match route.pattern.matches(path)
      when Option::Some(params) then
        method_matched = true
        if route.method == method then
          return Result::Ok((route.handler, params))
        end
      when Option::None then ()
      end
    end

    if method_matched then
      Result::Err(WebError::MethodNotAllowed)
    else
      Result::Err(WebError::RouteNotFound(path.clone()))
    end
  end
  
  def handle(self: Router, request: HttpRequest) -> HttpResponse
    let mut ctx = Context::new(request)
    
    match self.route(&ctx.request)
    when Result::Ok((handler, params)) then
      ctx.params = params
      
      # Apply middleware chain
      let final_handler = self.build_middleware_chain(handler)
      final_handler(&mut ctx)
    when Result::Err(e) then
      match self.not_found_handler
      when Option::Some(h) then h(&mut ctx)
      when Option::None then
        match self.error_handler
        when Option::Some(h) then h(&e)
        when Option::None then default_error_response(&e)
        end
      end
    end
  end
  
  def build_middleware_chain(self: Router, handler: Handler) -> Handler
    let mut chain = handler
    
    mut mi = self.middleware.len()
    while mi > 0 do
      mi = mi - 1
      let mw = self.middleware[mi]
      let prev = chain
      chain = |ctx| mw(ctx, prev)
    end
    
    chain
  end
end

def default_error_response(e: WebError) -> HttpResponse
  let status = web_error_status(e)
  let body = match e
  when WebError::RouteNotFound(path) then "Not Found: ".to_string() + path
  when WebError::MethodNotAllowed then "Method Not Allowed"
  when WebError::InvalidBody(msg) then "Bad Request: ".to_string() + msg
  when WebError::Unauthorized then "Unauthorized"
  when WebError::Forbidden then "Forbidden"
  when WebError::IoError(msg) then "Internal Error: ".to_string() + msg
  when WebError::Internal(msg) then "Internal Error: ".to_string() + msg
  end
  
  HttpResponse::new(status, HttpHeaders::new(), body.as_bytes().to_vec())
end

def route_index_key(method: HttpMethod, path: str) -> String
  method.to_string() + ":" + path
end

# ———————————————————————————————————————————————————————————————
# Application
# ———————————————————————————————————————————————————————————————

struct App
  router: Router
  static_dir: Option[String]
  static_prefix: String
end

impl App
  def new() -> App
    App {
      router: Router::new(),
      static_dir: Option::None,
      static_prefix: "/static".to_string()
    }
  end
  
  def get(inout self: App, pattern: str, handler: Handler) -> Unit
    self.router.get(pattern, handler)
  end
  
  def post(inout self: App, pattern: str, handler: Handler) -> Unit
    self.router.post(pattern, handler)
  end
  
  def put(inout self: App, pattern: str, handler: Handler) -> Unit
    self.router.put(pattern, handler)
  end
  
  def delete(inout self: App, pattern: str, handler: Handler) -> Unit
    self.router.delete(pattern, handler)
  end
  
  def middleware(inout self: App, mw: Middleware) -> Unit
    self.router.middleware(mw)
  end
  
  def static_files(inout self: App, prefix: str, dir: str) -> Unit
    self.static_prefix = prefix.to_string()
    self.static_dir = Option::Some(dir.to_string())
  end
  
  def listen(self: App, addr: str) -> Result[Unit, WebError]
    let server = HttpServer::bind(addr)
      .map_err(|e| WebError::IoError(e.to_string()))?
    
    loop
      let request = server.accept()
        .map_err(|e| WebError::IoError(e.to_string()))?
      
      let response = self.handle_request(request)
      server.respond(response)
        .map_err(|e| WebError::IoError(e.to_string()))?
    end
  end
  
  def handle_request(self: App, request: HttpRequest) -> HttpResponse
    # Check static files first
    if let Option::Some(dir) = self.static_dir then
      let path = request.uri().path()
      if path.starts_with(&self.static_prefix) then
        let file_path = path[self.static_prefix.len()..].trim_start_matches('/')
        let full_path = dir.clone() + "/" + file_path
        
        if let Result::Ok(content) = std::fs::read(&full_path) then
          let mime = guess_mime_type(&full_path)
          return HttpResponse::new(
            HttpStatus::new(200),
            {
              let mut h = HttpHeaders::new()
              h.set("Content-Type", mime)
              h
            },
            content
          )
        end
      end
    end
    
    self.router.handle(request)
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 2: MIDDLEWARE
# ═══════════════════════════════════════════════════════════════

mod middleware
  use std::log::{Logger, info}
  use std::time::{Instant}
  
  def logger(inout ctx: Context, next: fn(inout Context) -> HttpResponse) -> HttpResponse
    let start = Instant::now()
    let method = ctx.method().to_string()
    let path = ctx.path()
    
    let response = next(ctx)
    
    let elapsed = start.elapsed()
    info!("{} {} - {} ({:?})", method, path, response.status().as_u16(), elapsed)
    
    response
  end
  
  def cors(inout ctx: Context, next: fn(inout Context) -> HttpResponse) -> HttpResponse
    cors_with_config(ctx, next, CorsConfig::permissive())
  end
  
  def cors_with_config(inout ctx: Context, next: fn(inout Context) -> HttpResponse, config: CorsConfig) -> HttpResponse
    # Handle preflight
    if ctx.method() == HttpMethod::Options then
      ctx.status(HttpStatus::new(204))
      let mut response = ctx.response.build()
      add_cors_headers(&mut response, &config)
      return response
    end
    
    let mut response = next(ctx)
    add_cors_headers(&mut response, &config)
    response
  end
  
  struct CorsConfig
    allowed_origins: Vec[String]
    allowed_methods: Vec[String]
    allowed_headers: Vec[String]
    allow_credentials: Bool
    max_age: Option[u32]
  end
  
  impl CorsConfig
    def permissive() -> CorsConfig
      CorsConfig {
        allowed_origins: ["*".to_string()],
        allowed_methods: ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
        allowed_headers: ["*".to_string()],
        allow_credentials: false,
        max_age: Option::Some(86400)
      }
    end
    
    def strict() -> CorsConfig
      CorsConfig {
        allowed_origins: Vec::new(),
        allowed_methods: ["GET", "POST"],
        allowed_headers: Vec::new(),
        allow_credentials: false,
        max_age: Option::None
      }
    end
  end
  
  def add_cors_headers(inout response: HttpResponse, config: CorsConfig) -> Unit
    response.headers_mut().insert("Access-Control-Allow-Origin", config.allowed_origins.join(", "))
    response.headers_mut().insert("Access-Control-Allow-Methods", config.allowed_methods.join(", "))
    response.headers_mut().insert("Access-Control-Allow-Headers", config.allowed_headers.join(", "))
    
    if config.allow_credentials then
      response.headers_mut().insert("Access-Control-Allow-Credentials", "true")
    end
    
    if let Option::Some(age) = config.max_age then
      response.headers_mut().insert("Access-Control-Max-Age", &age.to_string())
    end
  end
  
  def recovery(inout ctx: Context, next: fn(inout Context) -> HttpResponse) -> HttpResponse
    # In a real implementation, this would catch panics
    # For now, just wrap in try-catch equivalent
    next(ctx)
  end
  
  def request_id(inout ctx: Context, next: fn(inout Context) -> HttpResponse) -> HttpResponse
    let id = generate_request_id()
    ctx.set_header("X-Request-ID", &id)
    ctx.locals.insert("request_id".to_string(), id)
    next(ctx)
  end
  
  def generate_request_id() -> String
    # Simple UUID-like ID
    let bytes = std::crypto::random_bytes(16)
    std::crypto::hex::encode(&bytes)
  end
  
  def compression(inout ctx: Context, next: fn(inout Context) -> HttpResponse) -> HttpResponse
    let mut response = next(ctx)
    
    let accept = ctx.header("Accept-Encoding").unwrap_or(String::new())
    
    if accept.contains("gzip") && response.body().len() > 1024 then
      if let Result::Ok(compressed) = std::compress::gzip::compress(response.body()) then
        if compressed.len() < response.body().len() then
          response.set_body(compressed)
          response.headers_mut().insert("Content-Encoding", "gzip")
        end
      end
    end
    
    response
  end
  
  def rate_limit(requests_per_minute: u32) -> Middleware
    let limiter = RateLimiter::new(requests_per_minute)
    let middleware = |ctx, next| do
      let forwarded = ctx.header("X-Forwarded-For")
      let real_ip = ctx.header("X-Real-IP")
      let ip = forwarded.or_else(|| real_ip).unwrap_or("unknown".to_string())
      
      if limiter.allow(&ip) then
        next(ctx)
      else
        ctx.status(HttpStatus::new(429))
        ctx.set_header("Retry-After", "60")
        ctx.text("Rate limit exceeded")
      end
    end
    middleware
  end
  
  struct RateLimiter
    requests_per_minute: u32
    requests: Mutex[Map[String, Vec[Instant]]]
  end
  
  impl RateLimiter
    def new(rpm: u32) -> RateLimiter
      RateLimiter {
        requests_per_minute: rpm,
        requests: Mutex::new(Map::new())
      }
    end
    
    def allow(self: RateLimiter, key: str) -> Bool
      let mut guard = self.requests.lock()
      let now = Instant::now()
      let window = std::time::Duration::from_secs(60)
      
      let requests = guard.entry(key.to_string()).or_insert(Vec::new())
      
      # Remove old requests (the retain-style filter — the element-wise
      # removal in place; the requests vec holds the timestamps).
      mut wi = 0
      while wi < requests.len() do
        if now.duration_since(requests[wi]) >= window then
          var wj = wi
          while wj < requests.len() - 1 do
            requests[wj] = requests[wj + 1]
            wj = wj + 1
          end
          requests.pop()
        else
          wi = wi + 1
        end
      end
      
      if requests.len() < self.requests_per_minute as UInt then
        requests.push(now)
        true
      else
        false
      end
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 3: TEMPLATES
# ═══════════════════════════════════════════════════════════════

struct Template
  source: String
  compiled: CompiledTemplate
end

enum TemplateNode
  Text(String)
  Variable(String)
  Block(String, Vec[TemplateNode])
  If(String, Vec[TemplateNode], Vec[TemplateNode])
  For(String, String, Vec[TemplateNode])
  Include(String)
end

struct CompiledTemplate
  nodes: Vec[TemplateNode]
end

enum TemplateError
  ParseError(String)
  RenderError(String)
  NotFound(String)
end

impl Template
  def parse(source: str) -> Result[Template, TemplateError]
    let mut parser = TemplateParser::new(source)
    let nodes = parser.parse()?
    
    Result::Ok(Template {
      source: source.to_string(),
      compiled: CompiledTemplate { nodes: nodes }
    })
  end
  
  def render(self: Template, data: Map[String, JsonValue]) -> Result[String, TemplateError]
    render_nodes(&self.compiled.nodes, data)
  end
end

struct TemplateParser
  source: Vec[char]
  pos: UInt
end

impl TemplateParser
  def new(source: str) -> TemplateParser
    TemplateParser {
      source: source.chars().collect(),
      pos: 0
    }
  end
  
  def parse(inout self: TemplateParser) -> Result[Vec[TemplateNode], TemplateError]
    let mut nodes = Vec::new()
    
    while self.pos < self.source.len() do
      if self.matches("{{") then
        self.advance_by(2)
        let var = self.parse_until("}}")?.trim()
        self.advance_by(2)
        nodes.push(TemplateNode::Variable(var.to_string()))
      elsif self.matches("{%") then
        self.advance_by(2)
        let tag = self.parse_until("%}")?.trim()
        self.advance_by(2)
        
        let parts: Vec[String] = tag.split_whitespace().collect()
        if parts.is_empty() then
          return Result::Err(TemplateError::ParseError("empty tag"))
        end
        
        match parts[0]
        when "if" then
          let condition = parts[1..].join(" ")
          let body = self.parse_block("endif")?
          nodes.push(TemplateNode::If(condition, body, Vec::new()))
        when "for" then
          if parts.len() < 4 || parts[2] != "in" then
            return Result::Err(TemplateError::ParseError("invalid for syntax"))
          end
          let item = parts[1].to_string()
          let collection = parts[3].to_string()
          let body = self.parse_block("endfor")?
          nodes.push(TemplateNode::For(item, collection, body))
        when "block" then
          let name = parts.get(1).unwrap_or(&"default").to_string()
          let body = self.parse_block("endblock")?
          nodes.push(TemplateNode::Block(name, body))
        when "include" then
          let path = parts.get(1).unwrap_or(&"").trim_matches('"').to_string()
          nodes.push(TemplateNode::Include(path))
        when _ then ()
        end
      else
        let mut text = String::new()
        while self.pos < self.source.len() && !self.matches("{{") && !self.matches("{%") do
          text.push(self.source[self.pos])
          self.pos = self.pos + 1
        end
        if !text.is_empty() then
          nodes.push(TemplateNode::Text(text))
        end
      end
    end
    
    Result::Ok(nodes)
  end
  
  def parse_block(inout self: TemplateParser, end_tag: str) -> Result[Vec[TemplateNode], TemplateError]
    let mut nodes = Vec::new()
    let end_marker = "{% ".to_string() + end_tag + " %}"
    
    while self.pos < self.source.len() do
      if self.matches(&end_marker) then
        self.advance_by(end_marker.len())
        return Result::Ok(nodes)
      elsif self.matches("{{") then
        self.advance_by(2)
        let var = self.parse_until("}}")?.trim()
        self.advance_by(2)
        nodes.push(TemplateNode::Variable(var.to_string()))
      elsif self.matches("{%") then
        self.advance_by(2)
        let tag = self.parse_until("%}")?.trim()
        self.advance_by(2)
        
        let parts: Vec[String] = tag.split_whitespace().collect()
        if parts.is_empty() then
          next
        end
        
        match parts[0]
        when "if" then
          let condition = parts[1..].join(" ")
          let body = self.parse_block("endif")?
          nodes.push(TemplateNode::If(condition, body, Vec::new()))
        when "for" then
          if parts.len() >= 4 then
            let item = parts[1].to_string()
            let collection = parts[3].to_string()
            let body = self.parse_block("endfor")?
            nodes.push(TemplateNode::For(item, collection, body))
          end
        when _ then ()
        end
      else
        let mut text = String::new()
        while self.pos < self.source.len() && !self.matches("{{") && !self.matches("{%") do
          text.push(self.source[self.pos])
          self.pos = self.pos + 1
        end
        if !text.is_empty() then
          nodes.push(TemplateNode::Text(text))
        end
      end
    end
    
    Result::Err(TemplateError::ParseError("unclosed block: ".to_string() + end_tag))
  end
  
  def matches(self: TemplateParser, s: str) -> Bool
    let chars: Vec[char] = s.chars().collect()
    if self.pos + chars.len() > self.source.len() then
      return false
    end
    for i in 0..chars.len() do
      if self.source[self.pos + i] != chars[i] then
        return false
      end
    end
    true
  end
  
  def advance_by(inout self: TemplateParser, n: UInt) -> Unit
    self.pos = (self.pos + n).min(self.source.len())
  end
  
  def parse_until(inout self: TemplateParser, end: str) -> Result[String, TemplateError]
    let end_chars: Vec[char] = end.chars().collect()
    let mut result = String::new()
    
    while self.pos < self.source.len() do
      if self.matches(end) then
        return Result::Ok(result)
      end
      result.push(self.source[self.pos])
      self.pos = self.pos + 1
    end
    
    Result::Err(TemplateError::ParseError("expected ".to_string() + end))
  end
end

def render_nodes(nodes: [TemplateNode], data: Map[String, JsonValue]) -> Result[String, TemplateError]
  let mut output = String::new()
  
  for node in nodes do
    match node
    when TemplateNode::Text(s) then
      output.push_str(s)
    when TemplateNode::Variable(name) then
      if let Option::Some(value) = get_value(data, name) then
        output.push_str(&value.to_string())
      end
    when TemplateNode::If(condition, then_nodes, else_nodes) then
      let is_true = evaluate_condition(data, condition)
      let branch = if is_true then then_nodes else else_nodes end
      output.push_str(&render_nodes(branch, data)?)
    when TemplateNode::For(item, collection, body) then
      if let Option::Some(JsonValue::Array(items)) = get_value(data, collection) then
        for val in items do
          let mut loop_data = data.clone()
          loop_data.insert(item.clone(), val.clone())
          output.push_str(&render_nodes(body, &loop_data)?)
        end
      end
    when TemplateNode::Block(_, body) then
      output.push_str(&render_nodes(body, data)?)
    when TemplateNode::Include(_) then
      # Would load external template
      ()
    end
  end
  
  Result::Ok(output)
end

def get_value(data: Map[String, JsonValue], path: str) -> Option[JsonValue]
  let parts: Vec[String] = path.split('.').collect()
  let mut current = data.get(parts[0])?
  
  for i in 1..parts.len() do
    current = std::serde::value_get(current, parts[i])?
  end
  
  Option::Some(current.clone())
end

def evaluate_condition(data: Map[String, JsonValue], condition: str) -> Bool
  # Simple truthy check
  if let Option::Some(value) = get_value(data, condition) then
    match value
    when JsonValue::Bool(b) then b
    when JsonValue::Null then false
    when JsonValue::Float(n) then n != 0.0
    when JsonValue::Int(n) then n != 0
    when JsonValue::String(s) then !s.is_empty()
    when JsonValue::Array(a) then !a.is_empty()
    when JsonValue::Object(o) then !o.is_empty()
    end
  else
    false
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 4: AUTHENTICATION
# ═══════════════════════════════════════════════════════════════

mod auth
  use std::crypto::{sha256, hmac_sha256, random_bytes, base64}
  use std::time::{SystemTime, Duration}
  
  # JWT
  struct Jwt
    header: JwtHeader
    payload: Map[String, JsonValue]
    signature: Vec[u8]
  end
  
  struct JwtHeader
    alg: String
    typ: String
  end

  def constant_time_eq_str(a: str, b: str) -> Bool
    if a.len() != b.len() then
      return false
    end

    let ab = a.as_bytes()
    let bb = b.as_bytes()
    mut diff: u8 = 0
    mut i = 0
    while i < ab.len() do
      diff = diff | (ab[i] ^ bb[i])
      i = i + 1
    end
    diff == 0
  end
  
  def create_jwt(payload: Map[String, JsonValue], secret: [u8]) -> String
    let header = JwtHeader {
      alg: "HS256".to_string(),
      typ: "JWT".to_string()
    }
    
    let header_json = Json::stringify(&header)
    let payload_json = Json::stringify(payload)
    
    let header_b64 = base64::encode_url_safe(header_json.as_bytes())
    let payload_b64 = base64::encode_url_safe(payload_json.as_bytes())
    
    let message = header_b64.clone() + "." + payload_b64.as_str()
    let signature = hmac_sha256(secret, message.as_bytes())
    let sig_b64 = base64::encode_url_safe(&signature)
    
    header_b64 + "." + payload_b64 + "." + sig_b64
  end
  
  def verify_jwt(token: str, secret: [u8]) -> Result[Map[String, JsonValue], WebError]
    let parts: Vec[String] = token.split('.').collect()
    if parts.len() != 3 then
      return Result::Err(WebError::Unauthorized)
    end
    
    let header_b64 = parts[0]
    let payload_b64 = parts[1]
    let sig_b64 = parts[2]
    
    # Verify signature
    let message = header_b64.to_string() + "." + payload_b64
    let expected_sig = hmac_sha256(secret, message.as_bytes())
    let expected_b64 = base64::encode_url_safe(&expected_sig)
    
    if !constant_time_eq_str(sig_b64, expected_b64.as_str()) then
      return Result::Err(WebError::Unauthorized)
    end
    
    # Decode payload
    let payload_bytes = base64::decode_url_safe(payload_b64)
      .map_err(|_| WebError::Unauthorized)?
    let payload_str = String::from_utf8(payload_bytes)
      .map_err(|_| WebError::Unauthorized)?
    
    let payload: Map[String, JsonValue] = json::from_json[Map[String, JsonValue]](payload_str.as_str())
      .map_err(|_| WebError::Unauthorized)?
    
    # Check expiration
    if let Option::Some(JsonValue::Float(exp)) = payload.get("exp") then
      let now = SystemTime::now().duration_since_epoch().as_secs() as f64
      if exp < now then
        return Result::Err(WebError::Unauthorized)
      end
    elsif let Option::Some(JsonValue::Int(exp)) = payload.get("exp") then
      let now = SystemTime::now().duration_since_epoch().as_secs() as Int
      if exp < now then
        return Result::Err(WebError::Unauthorized)
      end
    end
    
    Result::Ok(payload)
  end
  
  def jwt_middleware(secret: [u8]) -> Middleware
    let middleware = |ctx, next| do
      let auth_header = ctx.header("Authorization");
      
      match auth_header
      when Option::Some(h) then
        if h.starts_with("Bearer ") then
          let token = h[7..].trim()
          match verify_jwt(token, secret)
          when Result::Ok(claims) then
            ctx.locals.insert("user".to_string(), Json::stringify(&claims))
            next(ctx)
          when Result::Err(_) then
            ctx.status(HttpStatus::new(401))
            ctx.text("Invalid token")
          end
        else
          ctx.status(HttpStatus::new(401))
          ctx.text("Bearer token required")
        end
      when Option::None then
        ctx.status(HttpStatus::new(401))
        ctx.text("Authorization required")
      end
    end
    middleware
  end
  
  # Password hashing
  def hash_password(password: str) -> String
    let salt = random_bytes(16)
    let hash = std::crypto::pbkdf2_sha256(password.as_bytes(), &salt, 10000, 32)
    
    let mut result = Vec::new()
    result.extend(&salt)
    result.extend(&hash)
    
    base64::encode(&result)
  end
  
  def verify_password(password: str, encoded: str) -> Bool
    let decoded = match base64::decode(encoded)
    when Result::Ok(d) then d
    when Result::Err(_) then return false
    end
    
    if decoded.len() != 48 then
      return false
    end
    
    let salt = decoded[0..16]
    let stored_hash = decoded[16..48]
    
    let computed_hash = std::crypto::pbkdf2_sha256(password.as_bytes(), salt, 10000, 32)
    
    # Constant-time comparison
    let mut diff = 0u8
    for i in 0..32 do
      diff = diff | (stored_hash[i] ^ computed_hash[i])
    end
    
    diff == 0
  end
  
  # Session management
  struct Session
    id: String
    data: Map[String, String]
    expires_at: SystemTime
  end
  
  struct SessionStore
    sessions: Mutex[Map[String, Session]]
    max_age: Duration
  end
  
  impl SessionStore
    def new(max_age: Duration) -> SessionStore
      SessionStore {
        sessions: Mutex::new(Map::new()),
        max_age: max_age
      }
    end
    
    # Generate a new session and return its ID.
    # This is a factory method on an existing store, not a constructor.
    def generate_id(self: SessionStore) -> String
      let id = base64::encode_url_safe(&random_bytes(32))
      let session = Session {
        id: id.clone(),
        data: Map::new(),
        expires_at: SystemTime::now() + self.max_age
      }
      
      let mut guard = self.sessions.lock()
      guard.insert(id.clone(), session)
      id
    end
    
    def get(self: SessionStore, id: str) -> Option[Session]
      let mut guard = self.sessions.lock()
      
      if let Option::Some(session) = guard.get(id) then
        if session.expires_at > SystemTime::now() then
          return Option::Some(session.clone())
        else
          guard.remove(id)
        end
      end
      
      Option::None
    end
    
    def set(self: SessionStore, id: str, key: str, value: str) -> Bool
      let mut guard = self.sessions.lock()
      
      if let Option::Some(session) = guard.get_mut(id) then
        session.data.insert(key.to_string(), value.to_string())
        true
      else
        false
      end
    end
    
    def destroy(self: SessionStore, id: str) -> Unit
      let mut guard = self.sessions.lock()
      guard.remove(id)
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 5: UTILITIES
# ═══════════════════════════════════════════════════════════════

def parse_query_string(query: str) -> Map[String, String]
  url::parse_query_string(query)
end

def url_decode(s: str) -> String
  url::decode_uri_component(s)
end

def url_encode(s: str) -> String
  url::encode_uri_component(s)
end

struct CookieOptions
  max_age: Option[u32]
  domain: Option[String]
  path: String
  secure: Bool
  http_only: Bool
  same_site: SameSite
end

enum SameSite
  Strict
  Lax
  None
end

impl CookieOptions
  def default() -> CookieOptions
    CookieOptions {
      max_age: Option::None,
      domain: Option::None,
      path: "/".to_string(),
      secure: false,
      http_only: true,
      same_site: SameSite::Lax
    }
  end
end

def format_cookie(name: str, value: str, options: CookieOptions) -> String
  let mut cookie = url_encode(name) + "=" + url_encode(value)
  
  if let Option::Some(age) = options.max_age then
    cookie.push_str(&("; Max-Age=".to_string() + age.to_string()))
  end
  
  if let Option::Some(domain) = options.domain then
    cookie.push_str(&("; Domain=".to_string() + domain))
  end
  
  cookie.push_str(&("; Path=".to_string() + options.path.as_str()))
  
  if options.secure then
    cookie.push_str("; Secure")
  end
  
  if options.http_only then
    cookie.push_str("; HttpOnly")
  end
  
  match options.same_site
  when SameSite::Strict then cookie.push_str("; SameSite=Strict")
  when SameSite::Lax then cookie.push_str("; SameSite=Lax")
  when SameSite::None then cookie.push_str("; SameSite=None")
  end
  
  cookie
end

def parse_cookies(header: str) -> Map[String, String]
  let mut result = Map::new()
  
  for pair in header.split(';') do
    let pair = pair.trim()
    if let Option::Some(idx) = pair.find('=') then
      let key = pair[0..idx].to_string()
      let value = pair[idx + 1..].to_string()
      result.insert(key, value)
    end
  end
  
  result
end

def guess_mime_type(path: str) -> String
  let ext = path.rsplit('.').next().unwrap_or("")
  
  match ext.to_lowercase().as_str()
  when "html" | "htm" then "text/html".to_string()
  when "css" then "text/css".to_string()
  when "js" then "application/javascript".to_string()
  when "json" then "application/json".to_string()
  when "xml" then "application/xml".to_string()
  when "txt" then "text/plain".to_string()
  when "png" then "image/png".to_string()
  when "jpg" | "jpeg" then "image/jpeg".to_string()
  when "gif" then "image/gif".to_string()
  when "svg" then "image/svg+xml".to_string()
  when "ico" then "image/x-icon".to_string()
  when "webp" then "image/webp".to_string()
  when "pdf" then "application/pdf".to_string()
  when "zip" then "application/zip".to_string()
  when "woff" then "font/woff".to_string()
  when "woff2" then "font/woff2".to_string()
  when "ttf" then "font/ttf".to_string()
  when "mp3" then "audio/mpeg".to_string()
  when "mp4" then "video/mp4".to_string()
  when "webm" then "video/webm".to_string()
  when _ then "application/octet-stream".to_string()
  end
end
