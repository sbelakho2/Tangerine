# Tangerine Standard Library — TOML
#
# TOML v1.0 parser and generator for configuration files.
#
# Usage:
#   let config = toml::parse(toml_str)?
#   let name = config.get("package")?.get("name")?.as_str()?
#   
#   let toml_str = toml::stringify(&config)

use std::core::{Option, Result, Vec, String, Bool, Int, Float}
use std::collections::{Map}
use std::serde::{Value, Serialize, Deserialize, SerError}

# ———————————————————————————————————————————————————————————————
# Public API
# ———————————————————————————————————————————————————————————————

def parse(input: &str) -> Result[TomlValue, TomlError]
  let mut parser = TomlParser::new(input)
  parser.parse()
end

def toml_parse(input: &str) -> Result[TomlValue, TomlError]
  parse(input)
end

def stringify(value: &TomlValue) -> String
  let mut s = TomlStringifier::new()
  s.write_value(value, "")
  s.finish()
end

def toml_stringify(value: &TomlValue) -> String
  stringify(value)
end

def to_toml[T: Serialize](v: &T) -> Result[String, SerError]
  let value = std::serde::to_value(v)?
  Result::Ok(stringify(&toml_from_value(&value)))
end

def from_toml[T: Deserialize](input: &str) -> Result[T, TomlError]
  let toml_value = parse(input)?
  let value = toml_to_value(&toml_value)
  match std::serde::from_value[T](&value)
  when Result::Ok(v) then Result::Ok(v)
  when Result::Err(e) then Result::Err(TomlError::Deserialize(std::serde::ser_error_message(&e)))
  end
end

# ———————————————————————————————————————————————————————————————
# TOML Value Type
# ———————————————————————————————————————————————————————————————

enum TomlValue
  String(String)
  Integer(Int)
  Float(Float)
  Boolean(Bool)
  DateTime(TomlDateTime)
  Array(Vec[TomlValue])
  Table(Map[String, TomlValue])
end

struct TomlDateTime
  date: Option[TomlDate]
  time: Option[TomlTime]
  offset: Option[TomlOffset]
end

struct TomlDate
  year: Int
  month: Int
  day: Int
end

struct TomlTime
  hour: Int
  minute: Int
  second: Int
  nanosecond: Int
end

enum TomlOffset
  Utc
  Custom(Int, Int)  # hours, minutes
end

def toml_value_as_str(v: &TomlValue) -> Option[&String]
  match v
  when TomlValue::String(s) then Option::Some(&s)
  when _ then Option::None
  end
end

def toml_value_as_int(v: &TomlValue) -> Option[Int]
  match v
  when TomlValue::Integer(i) then Option::Some(i.clone())
  when _ then Option::None
  end
end

def toml_value_as_float(v: &TomlValue) -> Option[Float]
  match v
  when TomlValue::Float(f) then Option::Some(f.clone())
  when TomlValue::Integer(i) then Option::Some(i.clone() as Float)
  when _ then Option::None
  end
end

def toml_value_as_bool(v: &TomlValue) -> Option[Bool]
  match v
  when TomlValue::Boolean(b) then Option::Some(b.clone())
  when _ then Option::None
  end
end

def toml_value_as_array(v: &TomlValue) -> Option[&Vec[TomlValue]]
  match v
  when TomlValue::Array(arr) then Option::Some(&arr)
  when _ then Option::None
  end
end

def toml_value_as_table(v: &TomlValue) -> Option[&Map[String, TomlValue]]
  match v
  when TomlValue::Table(tbl) then Option::Some(&tbl)
  when _ then Option::None
  end
end

def toml_value_get(v: &TomlValue, key: &str) -> Option[&TomlValue]
  match v
  when TomlValue::Table(tbl) then tbl.get(key.to_string())
  when _ then Option::None
  end
end

# ———————————————————————————————————————————————————————————————
# Error Types
# ———————————————————————————————————————————————————————————————

enum TomlError
  UnexpectedChar(Char, UInt, UInt)
  UnexpectedEof
  InvalidKey(String)
  InvalidValue(String)
  InvalidNumber(String)
  InvalidDateTime(String)
  InvalidEscape(String)
  DuplicateKey(String)
  MixedArrayTypes(UInt, UInt)
  Deserialize(String)
end

def toml_error_message(e: &TomlError) -> String
  match e
  when TomlError::UnexpectedChar(c, line, col) then
    "unexpected '" + c.to_string() + "' at " + line.to_string() + ":" + col.to_string()
  when TomlError::UnexpectedEof then "unexpected end of input"
  when TomlError::InvalidKey(s) then "invalid key: " + s.clone()
  when TomlError::InvalidValue(s) then "invalid value: " + s.clone()
  when TomlError::InvalidNumber(s) then "invalid number: " + s.clone()
  when TomlError::InvalidDateTime(s) then "invalid datetime: " + s.clone()
  when TomlError::InvalidEscape(s) then "invalid escape: " + s.clone()
  when TomlError::DuplicateKey(s) then "duplicate key: " + s.clone()
  when TomlError::MixedArrayTypes(line, col) then
    "mixed array types at " + line.to_string() + ":" + col.to_string()
  when TomlError::Deserialize(s) then "deserialize error: " + s.clone()
  end
end

# ———————————————————————————————————————————————————————————————
# TOML Parser
# ———————————————————————————————————————————————————————————————

struct TomlParser
  input: String
  pos: UInt
  line: UInt
  column: UInt
end

impl TomlParser
  pub def new(input: &str) -> TomlParser
    TomlParser {
      input: input.to_string(),
      pos: 0,
      line: 1,
      column: 1
    }
  end

  def peek(self: &TomlParser) -> Option[Char]
    if self.pos >= self.input.len() then Option::None
    else Option::Some(self.input.char_at(self.pos))
    end
  end
  
  def peek_n(self: &TomlParser, n: UInt) -> Option[Char]
    if self.pos + n >= self.input.len() then Option::None
    else Option::Some(self.input.char_at(self.pos + n))
    end
  end
  
  def advance(self: &mut TomlParser) -> Option[Char]
    match self.peek()
    when Option::Some(c) then
      self.pos = self.pos + 1
      if c == '\n' then
        self.line = self.line + 1
        self.column = 1
      else
        self.column = self.column + 1
      end
      Option::Some(c)
    when Option::None then Option::None
    end
  end
  
  def skip_ws(self: &mut TomlParser) -> Unit
    loop
      match self.peek()
      when Option::Some(' ') | Option::Some('\t') then self.advance()
      when _ then break
      end
    end
  end
  
  def skip_ws_and_newlines(self: &mut TomlParser) -> Unit
    loop
      match self.peek()
      when Option::Some(' ') | Option::Some('\t') | Option::Some('\n') | Option::Some('\r') then
        self.advance()
      when Option::Some('#') then
        # Skip comment
        while match self.peek()
        when Option::Some('\n') then false
        when Option::None then false
        when _ then true
        end do
          self.advance()
        end
      when _ then break
      end
    end
  end
  
  def parse(self: &mut TomlParser) -> Result[TomlValue, TomlError]
    let mut root: Map[String, TomlValue] = Map::new()
    let mut current_table: Vec[String] = Vec::new()
    
    self.skip_ws_and_newlines()
    
    while self.pos < self.input.len() do
      match self.peek()
      when Option::Some('[') then
        # Table header
        self.advance()
        let is_array_of_tables = match self.peek()
        when Option::Some('[') then
          self.advance()
          true
        when _ then false
        end
        
        self.skip_ws()
        let key_path = self.parse_key_path()?
        self.skip_ws()
        
        if is_array_of_tables then
          self.expect_char(']')?
          self.expect_char(']')?
        else
          self.expect_char(']')?
        end
        
        current_table = key_path
        self.ensure_table_path(&mut root, &current_table, is_array_of_tables)?
      when Option::Some(_) then
        # Key-value pair - support dotted keys
        let key_path = self.parse_key_path()?
        self.skip_ws()
        self.expect_char('=')?
        self.skip_ws()
        let value = self.parse_value()?
        
        self.insert_value_path(&mut root, &current_table, &key_path, value)?
      when Option::None then break
      end
      
      self.skip_ws()
      # Expect newline or EOF
      match self.peek()
      when Option::Some('\n') | Option::Some('\r') then self.skip_ws_and_newlines()
      when Option::Some('#') then self.skip_ws_and_newlines()
      when Option::None then ()
      when Option::Some(c) then return Result::Err(TomlError::UnexpectedChar(c, self.line, self.column))
      end
    end
    
    Result::Ok(TomlValue::Table(root))
  end
  
  def expect_char(self: &mut TomlParser, expected: Char) -> Result[Unit, TomlError]
    match self.advance()
    when Option::Some(c) then
      if c == expected then Result::Ok(())
      else Result::Err(TomlError::UnexpectedChar(c, self.line, self.column))
      end
    when Option::None then Result::Err(TomlError::UnexpectedEof)
    end
  end
  
  def parse_key(self: &mut TomlParser) -> Result[String, TomlError]
    match self.peek()
    when Option::Some('"') then self.parse_basic_string()
    when Option::Some('\'') then self.parse_literal_string()
    when Option::Some(c) then
      if is_bare_key_char(c) then self.parse_bare_key()
      else Result::Err(TomlError::InvalidKey(c.to_string()))
      end
    when Option::None then Result::Err(TomlError::UnexpectedEof)
    end
  end
  
  def parse_key_path(self: &mut TomlParser) -> Result[Vec[String], TomlError]
    let mut path = Vec::new()
    path.push(self.parse_key()?)
    
    loop
      self.skip_ws()
      match self.peek()
      when Option::Some('.') then
        self.advance()
        self.skip_ws()
        path.push(self.parse_key()?)
      when _ then break
      end
    end
    
    Result::Ok(path)
  end
  
  def parse_bare_key(self: &mut TomlParser) -> Result[String, TomlError]
    let mut result = String::new()
    while match self.peek()
    when Option::Some(c) then is_bare_key_char(c)
    when Option::None then false
    end do
      match self.advance()
      when Option::Some(ch) then result.push(ch)
      when Option::None then break
      end
    end
    if result.is_empty() then
      Result::Err(TomlError::InvalidKey("empty key"))
    else
      Result::Ok(result)
    end
  end
  
  def parse_basic_string(self: &mut TomlParser) -> Result[String, TomlError]
    self.advance()  # consume opening quote
    
    # Check for multi-line
    let is_multiline = match (self.peek(), self.peek_n(1))
    when (Option::Some('"'), Option::Some('"')) then
      self.advance()
      self.advance()
      # Skip first newline if present
      match self.peek()
      when Option::Some('\n') then self.advance()
      when Option::Some('\r') then
        self.advance()
        match self.peek()
        when Option::Some('\n') then self.advance()
        when _ then ()
        end
      when _ then ()
      end
      true
    when _ then false
    end
    
    let mut result = String::new()
    
    loop
      match self.advance()
      when Option::Some('"') then
        if is_multiline then
          match (self.peek(), self.peek_n(1))
          when (Option::Some('"'), Option::Some('"')) then
            self.advance()
            self.advance()
            return Result::Ok(result)
          when _ then result.push('"')
          end
        else
          return Result::Ok(result)
        end
      when Option::Some('\\') then
        if is_multiline then
          match self.peek()
          when Option::Some('\n') | Option::Some('\r') then
            # Line ending backslash - skip whitespace
            self.skip_ws_and_newlines()
            next
          when _ then ()
          end
        end
        match self.advance()
        when Option::Some('n') then result.push('\n')
        when Option::Some('r') then result.push('\r')
        when Option::Some('t') then result.push('\t')
        when Option::Some('\\') then result.push('\\')
        when Option::Some('"') then result.push('"')
        when Option::Some('b') then result.push('\x08')
        when Option::Some('f') then result.push('\x0C')
        when Option::Some('u') then
          let code = self.parse_unicode_escape(4)?
          result.push(code as Char)
        when Option::Some('U') then
          let code = self.parse_unicode_escape(8)?
          result.push(code as Char)
        when Option::Some(c) then return Result::Err(TomlError::InvalidEscape("\\" + c.to_string()))
        when Option::None then return Result::Err(TomlError::UnexpectedEof)
        end
      when Option::Some(c) then
        if !is_multiline && (c == '\n' || c == '\r') then
          return Result::Err(TomlError::UnexpectedChar(c, self.line, self.column))
        end
        result.push(c)
      when Option::None then return Result::Err(TomlError::UnexpectedEof)
      end
    end
  end
  
  def parse_literal_string(self: &mut TomlParser) -> Result[String, TomlError]
    self.advance()  # consume opening quote
    
    # Check for multi-line
    let is_multiline = match (self.peek(), self.peek_n(1))
    when (Option::Some('\''), Option::Some('\'')) then
      self.advance()
      self.advance()
      # Skip first newline if present
      match self.peek()
      when Option::Some('\r') then
        self.advance()
        if self.peek() == Option::Some('\n') then
          self.advance()
        end
      when Option::Some('\n') then self.advance()
      when _ then ()
      end
      true
    when _ then false
    end
    
    let mut result = String::new()
    
    loop
      match self.advance()
      when Option::Some('\'') then
        if is_multiline then
          match (self.peek(), self.peek_n(1))
          when (Option::Some('\''), Option::Some('\'')) then
            self.advance()
            self.advance()
            return Result::Ok(result)
          when _ then result.push('\'')
          end
        else
          return Result::Ok(result)
        end
      when Option::Some(c) then
        if !is_multiline && (c == '\n' || c == '\r') then
          return Result::Err(TomlError::UnexpectedChar(c, self.line, self.column))
        end
        result.push(c)
      when Option::None then return Result::Err(TomlError::UnexpectedEof)
      end
    end
  end
  
  def parse_unicode_escape(self: &mut TomlParser, digits: UInt) -> Result[UInt, TomlError]
    let mut code: UInt = 0
    for _ in 0..digits do
      match self.advance()
      when Option::Some(c) then
        if c >= '0' && c <= '9' then
          code = code * 16 + (c as UInt - '0' as UInt)
        elsif c >= 'a' && c <= 'f' then
          code = code * 16 + (c as UInt - 'a' as UInt + 10)
        elsif c >= 'A' && c <= 'F' then
          code = code * 16 + (c as UInt - 'A' as UInt + 10)
        else
          return Result::Err(TomlError::InvalidEscape("invalid hex: " + c.to_string()))
        end
      when Option::None then return Result::Err(TomlError::UnexpectedEof)
      end
    end
    Result::Ok(code)
  end
  
  def parse_value(self: &mut TomlParser) -> Result[TomlValue, TomlError]
    match self.peek()
    when Option::Some('"') then
      let s = self.parse_basic_string()?
      Result::Ok(TomlValue::String(s))
    when Option::Some('\'') then
      let s = self.parse_literal_string()?
      Result::Ok(TomlValue::String(s))
    when Option::Some('[') then self.parse_array()
    when Option::Some('{') then self.parse_inline_table()
    when Option::Some('t') | Option::Some('f') then self.parse_bool()
    when Option::Some(c) then
      if c == '-' || c == '+' || (c >= '0' && c <= '9') then
        self.parse_number_or_datetime()
      else
        Result::Err(TomlError::InvalidValue(c.to_string()))
      end
    when Option::None then Result::Err(TomlError::UnexpectedEof)
    end
  end
  
  def parse_bool(self: &mut TomlParser) -> Result[TomlValue, TomlError]
    if self.matches("true") then
      Result::Ok(TomlValue::Boolean(true))
    elsif self.matches("false") then
      Result::Ok(TomlValue::Boolean(false))
    else
      Result::Err(TomlError::InvalidValue("expected boolean"))
    end
  end
  end
  
  def parse_array(self: &mut TomlParser) -> Result[TomlValue, TomlError]
    self.advance()  # consume '['
    let mut arr = Vec::new()
    
    self.skip_ws_and_newlines()
    
    match self.peek()
    when Option::Some(']') then
      self.advance()
      return Result::Ok(TomlValue::Array(arr))
    when _ then ()
    end
    
    loop
      self.skip_ws_and_newlines()
      arr.push(self.parse_value()?)
      self.skip_ws_and_newlines()
      
      match self.peek()
      when Option::Some(',') then
        self.advance()
        self.skip_ws_and_newlines()
        # Allow trailing comma
        match self.peek()
        when Option::Some(']') then
          self.advance()
          return Result::Ok(TomlValue::Array(arr))
        when _ then ()
        end
      when Option::Some(']') then
        self.advance()
        return Result::Ok(TomlValue::Array(arr))
      when Option::Some(c) then return Result::Err(TomlError::UnexpectedChar(c, self.line, self.column))
      when Option::None then return Result::Err(TomlError::UnexpectedEof)
      end
    end
  end

  def parse_inline_table(self: &mut TomlParser) -> Result[TomlValue, TomlError]
    self.advance()  # consume '{'
    let mut tbl: Map[String, TomlValue] = Map::new()
    
    self.skip_ws()
    
    match self.peek()
    when Option::Some('}') then
      self.advance()
      return Result::Ok(TomlValue::Table(tbl))
    when _ then ()
    end
    
    loop
      self.skip_ws()
      let key_path = self.parse_key_path()?
      self.skip_ws()
      self.expect_char('=')?
      self.skip_ws()
      let value = self.parse_value()?
      
      # Handle dotted keys by creating intermediate tables
      let mut target = &mut tbl
      let last_idx = key_path.len() - 1
      let mut i = 0
      while i < last_idx do
        let segment = key_path[i].clone()
        if !target.contains_key(&segment) then
          target.insert(segment.clone(), TomlValue::Table(Map::new()))
        end
        match target.get_mut(segment.clone())
        when Option::Some(TomlValue::Table(inner)) then target = inner
        when _ then return Result::Err(TomlError::InvalidKey(segment))
        end
        i = i + 1
      end
      
      let final_key = key_path[last_idx].clone()
      if target.contains_key(&final_key) then
        return Result::Err(TomlError::DuplicateKey(final_key))
      end
      target.insert(final_key, value)
      
      self.skip_ws()
      
      match self.peek()
      when Option::Some(',') then self.advance()
      when Option::Some('}') then
        self.advance()
        return Result::Ok(TomlValue::Table(tbl))
      when Option::Some(c) then return Result::Err(TomlError::UnexpectedChar(c, self.line, self.column))
      when Option::None then return Result::Err(TomlError::UnexpectedEof)
      end
    end
  end

  def parse_number_or_datetime(self: &mut TomlParser) -> Result[TomlValue, TomlError]
    let start = self.pos
    
    # Collect until whitespace, comma, bracket, or comment
    while match self.peek()
    when Option::Some(c) then
      c != ' ' && c != '\t' && c != '\n' && c != '\r' &&
      c != ',' && c != ']' && c != '}' && c != '#'
    when Option::None then false
    end do
      self.advance()
    end
    
    let text = self.input.slice(start, self.pos)
    
    # If text starts with a sign (+/-), it is a number, never a datetime
    let first_char = if text.len() > 0 then text.char_at(0) else '\0' end
    if first_char == '-' || first_char == '+' then
      if text == "+inf" || text == "-inf" || text == "+nan" || text == "-nan" then
        return self.parse_float_value(&text)
      end
      let rest = text.slice(1, text.len())
      if rest.contains(".") || rest.contains("e") || rest.contains("E") then
        return self.parse_float_value(&text)
      else
        return self.parse_int_value(&text)
      end
    end
    
    # Unsigned value: detect datetime by time separator or date pattern YYYY-
    if text.contains(":") || (text.len() >= 10 && text.char_at(4) == '-') then
      self.parse_datetime_value(&text)
    elsif text.contains(".") || text.contains("e") || text.contains("E") ||
            text == "inf" || text == "nan" then
      self.parse_float_value(&text)
    else
      self.parse_int_value(&text)
    end
  end

  def parse_int_value(self: &mut TomlParser, text: &String) -> Result[TomlValue, TomlError]
    let mut s = text.clone()
    s = s.replace("_", "")
    
    let (base, start) = if s.starts_with("0x") || s.starts_with("0X") then
      (16, 2)
    elsif s.starts_with("0o") || s.starts_with("0O") then
      (8, 2)
    elsif s.starts_with("0b") || s.starts_with("0B") then
      (2, 2)
    else
      (10, 0)
    end
    
    let mut neg = false
    let mut idx = start
    if idx < s.len() && s.char_at(idx) == '-' then
      neg = true
      idx = idx + 1
    elsif idx < s.len() && s.char_at(idx) == '+' then
      idx = idx + 1
    end
    
    let mut result: Int = 0
    while idx < s.len() do
      let c = s.char_at(idx)
      let digit = if c >= '0' && c <= '9' then
        c as Int - '0' as Int
      elsif c >= 'a' && c <= 'f' then
        c as Int - 'a' as Int + 10
      elsif c >= 'A' && c <= 'F' then
        c as Int - 'A' as Int + 10
      else
        return Result::Err(TomlError::InvalidNumber(text.clone()))
      end
      
      if digit >= base then
        return Result::Err(TomlError::InvalidNumber(text.clone()))
      end
      
      result = result * base + digit
      idx = idx + 1
    end
    
    if neg then result = -result end
    Result::Ok(TomlValue::Integer(result))
  end

  def parse_float_value(self: &mut TomlParser, text: &String) -> Result[TomlValue, TomlError]
    let mut s = text.clone()
    s = s.replace("_", "")
    
    if s == "inf" || s == "+inf" then
      return Result::Ok(TomlValue::Float(Float::infinity()))
    elsif s == "-inf" then
      return Result::Ok(TomlValue::Float(Float::neg_infinity()))
    elsif s == "nan" || s == "+nan" || s == "-nan" then
      return Result::Ok(TomlValue::Float(Float::nan()))
    end
    
    match std::json::parse_float(&s)
    when Option::Some(f) then Result::Ok(TomlValue::Float(f))
    when Option::None then Result::Err(TomlError::InvalidNumber(text.clone()))
    end
  end

  def parse_datetime_value(self: &mut TomlParser, text: &String) -> Result[TomlValue, TomlError]
    # Parse ISO 8601 / TOML datetime formats
    # Full: 1979-05-27T07:32:00Z  (also accepts 't', ' ' as separator)
    # Date only: 1979-05-27
    # Time only: 07:32:00
    
    let mut date: Option[TomlDate] = Option::None
    let mut time: Option[TomlTime] = Option::None
    let mut offset: Option[TomlOffset] = Option::None
    
    # TOML allows 'T', 't', or ' ' as date/time separator
    let parts = if text.contains('T') then
      text.split('T')
    elsif text.contains('t') then
      text.split('t')
    elsif text.contains(' ') && text.contains('-') && text.contains(':') then
      text.split(' ')
    else
      [text.clone()]
    end
    
    if parts.len() == 2 then
      date = Option::Some(self.parse_date_part(&parts[0])?)
      let (t, o) = self.parse_time_with_offset(&parts[1])?
      time = Option::Some(t)
      offset = o
    elsif text.contains(":") then
      let (t, o) = self.parse_time_with_offset(text)?
      time = Option::Some(t)
      offset = o
    else
      date = Option::Some(self.parse_date_part(text)?)
    end
    
    Result::Ok(TomlValue::DateTime(TomlDateTime { date: date, time: time, offset: offset }))
  end

  def parse_date_part(self: &TomlParser, s: &String) -> Result[TomlDate, TomlError]
    let parts = s.split('-')
    if parts.len() != 3 then
      return Result::Err(TomlError::InvalidDateTime(s.clone()))
    end
    
    match (parse_int_simple(&parts[0]), parse_int_simple(&parts[1]), parse_int_simple(&parts[2]))
    when (Option::Some(y), Option::Some(m), Option::Some(d)) then
      # Validate date ranges
      if m < 1 || m > 12 then
        return Result::Err(TomlError::InvalidDateTime("month out of range: " + m.to_string()))
      end
      if d < 1 || d > 31 then
        return Result::Err(TomlError::InvalidDateTime("day out of range: " + d.to_string()))
      end
      # Month-specific day limits with leap year validation for February
      let max_day = match m
      when 2 then
        if (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0) then 29 else 28 end
      when 4 then 30
      when 6 then 30
      when 9 then 30
      when 11 then 30
      when _ then 31
      end
      if d > max_day then
        return Result::Err(TomlError::InvalidDateTime("day " + d.to_string() + " out of range for month " + m.to_string()))
      end
      Result::Ok(TomlDate { year: y, month: m, day: d })
    when _ then Result::Err(TomlError::InvalidDateTime(s.clone()))
    end
  end

  def parse_time_with_offset(self: &TomlParser, s: &String) -> Result[(TomlTime, Option[TomlOffset]), TomlError]
    let mut time_str = s.clone()
    let mut offset: Option[TomlOffset] = Option::None
    
    if time_str.ends_with("Z") || time_str.ends_with("z") then
      offset = Option::Some(TomlOffset::Utc)
      time_str = time_str.slice(0, time_str.len() - 1).to_string()
    elsif time_str.contains("+") then
      let idx = match time_str.rfind('+')
      when Option::Some(value) then value
      when Option::None then return Result::Err(TomlError::InvalidDateTime(s.clone()))
      end
      let offset_str = time_str.slice(idx + 1, time_str.len())
      time_str = time_str.slice(0, idx).to_string()
      offset = Option::Some(self.parse_offset(&offset_str, false)?)
    elsif time_str.len() > 8 && time_str.char_at(time_str.len() - 6) == '-' then
      let idx = time_str.len() - 6
      let offset_str = time_str.slice(idx + 1, time_str.len())
      time_str = time_str.slice(0, idx).to_string()
      offset = Option::Some(self.parse_offset(&offset_str, true)?)
    end
    
    let time = self.parse_time_part(&time_str)?
    Result::Ok((time, offset))
  end

  def parse_time_part(self: &TomlParser, s: &String) -> Result[TomlTime, TomlError]
    let main_parts = s.split('.')
    let time_str = &main_parts[0]
    let nano = if main_parts.len() > 1 then
      parse_nanoseconds(&main_parts[1])
    else
      0
    end
    
    let parts = time_str.split(':')
    if parts.len() < 2 then
      return Result::Err(TomlError::InvalidDateTime(s.clone()))
    end
    
    let hour = parse_int_simple(&parts[0]).unwrap_or(0)
    let minute = parse_int_simple(&parts[1]).unwrap_or(0)
    let second = if parts.len() > 2 then parse_int_simple(&parts[2]).unwrap_or(0) else 0 end
    
    # Validate time ranges
    if hour < 0 || hour > 23 then
      return Result::Err(TomlError::InvalidDateTime("hour out of range: " + hour.to_string()))
    end
    if minute < 0 || minute > 59 then
      return Result::Err(TomlError::InvalidDateTime("minute out of range: " + minute.to_string()))
    end
    if second < 0 || second > 60 then  # 60 for leap second
      return Result::Err(TomlError::InvalidDateTime("second out of range: " + second.to_string()))
    end
    
    Result::Ok(TomlTime { hour: hour, minute: minute, second: second, nanosecond: nano })
  end

  def parse_offset(self: &TomlParser, s: &String, neg: Bool) -> Result[TomlOffset, TomlError]
    let parts = s.split(':')
    if parts.len() != 2 then
      return Result::Err(TomlError::InvalidDateTime(s.clone()))
    end
    let h = parse_int_simple(&parts[0]).unwrap_or(0)
    let m = parse_int_simple(&parts[1]).unwrap_or(0)
    if neg then
      Result::Ok(TomlOffset::Custom(-h, -m))
    else
      Result::Ok(TomlOffset::Custom(h, m))
    end
  end

  def matches(self: &mut TomlParser, s: &str) -> Bool
    let len = s.len()
    if self.pos + len > self.input.len() then return false end
    for i in 0..len do
      if self.input.char_at(self.pos + i) != s.char_at(i) then
        return false
      end
    end
    self.pos = self.pos + len
    self.column = self.column + len
    true
  end

  def ensure_table_path(self: &TomlParser, root: &mut Map[String, TomlValue], 
                        path: &Vec[String], is_array: Bool) -> Result[Unit, TomlError]
    let mut current = root
    for i in 0..path.len() do
      let key = &path[i]
      let is_last = i == path.len() - 1
      
      if !current.contains_key(key) then
        if is_last && is_array then
          let mut arr = Vec::new()
          arr.push(TomlValue::Table(Map::new()))
          current.insert(key.clone(), TomlValue::Array(arr))
        else
          current.insert(key.clone(), TomlValue::Table(Map::new()))
        end
      end
      
      match current.get_mut(key.clone())
      when Option::Some(v) then
        match v
        when TomlValue::Table(tbl) then current = tbl
        when TomlValue::Array(arr) then
          if is_last && is_array then
            arr.push(TomlValue::Table(Map::new()))
          end
          match arr.last_mut()
          when Option::Some(TomlValue::Table(tbl)) then current = tbl
          when _ then return Result::Err(TomlError::InvalidValue("expected table in array"))
          end
        when _ then return Result::Err(TomlError::InvalidValue("expected table"))
        end
      when Option::None then return Result::Err(TomlError::InvalidKey(key.clone()))
      end
    end
    Result::Ok(())
  end

  def insert_value(self: &TomlParser, root: &mut Map[String, TomlValue],
                   path: &Vec[String], key: String, value: TomlValue) -> Result[Unit, TomlError]
    let mut current = root
    
    for segment in path do
      match current.get_mut(segment.clone())
      when Option::Some(TomlValue::Table(tbl)) then current = tbl
      when Option::Some(TomlValue::Array(arr)) then
        match arr.last_mut()
        when Option::Some(TomlValue::Table(tbl)) then current = tbl
        when _ then return Result::Err(TomlError::InvalidValue("expected table"))
        end
      when _ then return Result::Err(TomlError::InvalidKey(segment.clone()))
      end
    end
    
    if current.contains_key(&key) then
      return Result::Err(TomlError::DuplicateKey(key))
    end
    current.insert(key, value)
    Result::Ok(())
  end

  # Insert value with dotted key path (e.g., physical.color = "orange")
  def insert_value_path(self: &TomlParser, root: &mut Map[String, TomlValue],
                        table_path: &Vec[String], key_path: &Vec[String], value: TomlValue) -> Result[Unit, TomlError]
    let mut current = root
    
    # Navigate to current table
    for segment in table_path do
      match current.get_mut(segment.clone())
      when Option::Some(TomlValue::Table(tbl)) then current = tbl
      when Option::Some(TomlValue::Array(arr)) then
        match arr.last_mut()
        when Option::Some(TomlValue::Table(tbl)) then current = tbl
        when _ then return Result::Err(TomlError::InvalidValue("expected table"))
        end
      when _ then return Result::Err(TomlError::InvalidKey(segment.clone()))
      end
    end
    
    # For dotted keys, create intermediate tables as needed
    let last_idx = key_path.len() - 1
    let mut i = 0
    while i < last_idx do
      let segment = key_path[i].clone()
      if !current.contains_key(&segment) then
        # Create implicit table for intermediate key
        current.insert(segment.clone(), TomlValue::Table(Map::new()))
      end
      match current.get_mut(segment.clone())
      when Option::Some(TomlValue::Table(tbl)) then current = tbl
      when _ then return Result::Err(TomlError::InvalidKey(segment))
      end
      i = i + 1
    end
    
    # Insert final key
    let final_key = key_path[last_idx].clone()
    if current.contains_key(&final_key) then
      return Result::Err(TomlError::DuplicateKey(final_key))
    end
    current.insert(final_key, value)
    Result::Ok(())
  end
end

# ———————————————————————————————————————————————————————————————
# TOML Stringifier
# ———————————————————————————————————————————————————————————————

struct TomlStringifier
  output: String
end

def TomlStringifier::new() -> TomlStringifier
  TomlStringifier { output: String::new() }
end

impl TomlStringifier
  def finish(self: &TomlStringifier) -> String
    self.output.clone()
  end
  
  def write_value(self: &mut TomlStringifier, v: &TomlValue, path: &str) -> Unit
    match v
    when TomlValue::Table(tbl) then self.write_table(&tbl, path)
    when _ then self.write_inline_value(v)
    end
  end
  
  def write_table(self: &mut TomlStringifier, tbl: &Map[String, TomlValue], path: &str) -> Unit
    # First write simple key-value pairs
    for entry in tbl do
      let (k, v) = entry
      match v
      when TomlValue::Table(_) | TomlValue::Array(_) then ()  # Handle later
      when _ then
        self.write_key(&k)
        self.output.push_str(" = ")
        self.write_inline_value(&v)
        self.output.push('\n')
      end
    end
    
    # Then write nested tables
    for entry in tbl do
      let (k, v) = entry
      match v
      when TomlValue::Table(nested) then
        self.output.push('\n')
        let new_path = if path.is_empty() then k.clone()
                       else path.to_string() + "." + k.clone()
                       end
        self.output.push('[')
        self.output.push_str(new_path.as_str())
        self.output.push_str("]\n")
        self.write_table(&nested, new_path.as_str())
      when TomlValue::Array(arr) then
        # Check if array of tables
        let is_table_array = match arr.get(0)
        when Option::Some(TomlValue::Table(_)) then true
        when _ then false
        end
        
        if is_table_array then
          let new_path = if path.is_empty() then k.clone()
                         else path.to_string() + "." + k.clone()
                         end
          for item in arr do
            self.output.push('\n')
            self.output.push_str("[[")
            self.output.push_str(new_path.as_str())
            self.output.push_str("]]\n")
            match item
            when TomlValue::Table(nested) then
              self.write_table(&nested, new_path.as_str())
            when _ then ()
            end
          end
        else
          self.write_key(&k)
          self.output.push_str(" = ")
          self.write_inline_value(&v)
          self.output.push('\n')
        end
      when _ then ()
      end
    end
  end
  
  def write_inline_value(self: &mut TomlStringifier, v: &TomlValue) -> Unit
    match v
    when TomlValue::String(s) then self.write_string(&s)
    when TomlValue::Integer(i) then self.output.push_str(i.to_string().as_str())
    when TomlValue::Float(f) then
      if f.is_infinite() then
        if f > 0.0 then self.output.push_str("inf")
        else self.output.push_str("-inf")
        end
      elsif f.is_nan() then
        self.output.push_str("nan")
      else
        self.output.push_str(f.to_string().as_str())
      end
    when TomlValue::Boolean(b) then
      if b then self.output.push_str("true")
      else self.output.push_str("false")
      end
    when TomlValue::DateTime(dt) then self.write_datetime(&dt)
    when TomlValue::Array(arr) then
      self.output.push('[')
      for i in 0..arr.len() do
        if i > 0 then self.output.push_str(", ") end
        match arr.get(i)
        when Option::Some(item) then self.write_inline_value(&item)
        when Option::None then ()
        end
      end
      self.output.push(']')
    when TomlValue::Table(tbl) then
      self.output.push_str("{ ")
      let mut first = true
      for entry in tbl do
        let (k, v) = entry
        if !first then self.output.push_str(", ") end
        first = false
        self.write_key(&k)
        self.output.push_str(" = ")
        self.write_inline_value(&v)
      end
      self.output.push_str(" }")
    end
  end
  
  def write_key(self: &mut TomlStringifier, k: &String) -> Unit
    let needs_quote = !k.chars().all(|c| is_bare_key_char(c))
    if needs_quote then
      self.write_string(k)
    else
      self.output.push_str(k.as_str())
    end
  end
  
  def write_string(self: &mut TomlStringifier, s: &String) -> Unit
    self.output.push('"')
    for c in s.chars() do
      match c
      when '"' then self.output.push_str("\\\"")
      when '\\' then self.output.push_str("\\\\")
      when '\n' then self.output.push_str("\\n")
      when '\r' then self.output.push_str("\\r")
      when '\t' then self.output.push_str("\\t")
      when _ then
        if c < ' ' then
          self.output.push_str("\\u")
          self.output.push_str(format_hex4(c as UInt).as_str())
        else
          self.output.push(c)
        end
      end
    end
    self.output.push('"')
  end
  
  def write_datetime(self: &mut TomlStringifier, dt: &TomlDateTime) -> Unit
    match dt.date
    when Option::Some(d) then
      self.output.push_str(format_int_pad(d.year, 4).as_str())
      self.output.push('-')
      self.output.push_str(format_int_pad(d.month, 2).as_str())
      self.output.push('-')
      self.output.push_str(format_int_pad(d.day, 2).as_str())
    when Option::None then ()
    end
    
    match (dt.date, dt.time)
    when (Option::Some(_), Option::Some(_)) then self.output.push('T')
    when _ then ()
    end
    
    match dt.time
    when Option::Some(t) then
      self.output.push_str(format_int_pad(t.hour, 2).as_str())
      self.output.push(':')
      self.output.push_str(format_int_pad(t.minute, 2).as_str())
      self.output.push(':')
      self.output.push_str(format_int_pad(t.second, 2).as_str())
      if t.nanosecond > 0 then
        self.output.push('.')
        self.output.push_str(format_int_pad(t.nanosecond, 9).as_str().trim_end_matches('0'))
      end
    when Option::None then ()
    end
    
    match dt.offset
    when Option::Some(TomlOffset::Utc) then self.output.push('Z')
    when Option::Some(TomlOffset::Custom(h, m)) then
      if h >= 0 then self.output.push('+')
      else self.output.push('-')
      end
      self.output.push_str(format_int_pad(h.abs(), 2).as_str())
      self.output.push(':')
      self.output.push_str(format_int_pad(m.abs(), 2).as_str())
    when Option::None then ()
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Helper Functions
# ———————————————————————————————————————————————————————————————

def is_bare_key_char(c: Char) -> Bool
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
  (c >= '0' && c <= '9') || c == '_' || c == '-'
end

def parse_int_simple(s: &String) -> Option[Int]
  let mut result: Int = 0
  let mut neg = false
  let mut i = 0
  
  if s.len() > 0 && s.char_at(0) == '-' then
    neg = true
    i = 1
  elsif s.len() > 0 && s.char_at(0) == '+' then
    i = 1
  end
  
  while i < s.len() do
    let c = s.char_at(i)
    if c >= '0' && c <= '9' then
      result = result * 10 + (c as Int - '0' as Int)
    else
      return Option::None
    end
    i = i + 1
  end
  
  if neg then result = -result end
  Option::Some(result)
end

def parse_nanoseconds(s: &String) -> Int
  let mut result: Int = 0
  let mut multiplier = 100000000  # Start at 10^8 for first digit
  
  for c in s.chars() do
    if c >= '0' && c <= '9' then
      result = result + (c as Int - '0' as Int) * multiplier
      multiplier = multiplier / 10
      if multiplier == 0 then break end
    else
      break
    end
  end
  
  result
end

def format_int_pad(n: Int, width: UInt) -> String
  let s = n.abs().to_string()
  let mut result = String::new()
  for _ in 0..(width - s.len()) do
    result.push('0')
  end
  result.push_str(s.as_str())
  result
end

def format_hex4(n: UInt) -> String
  let digits = "0123456789abcdef"
  let mut result = String::new()
  result.push(digits.char_at((n >> 12) & 0xF))
  result.push(digits.char_at((n >> 8) & 0xF))
  result.push(digits.char_at((n >> 4) & 0xF))
  result.push(digits.char_at(n & 0xF))
  result
end

# ———————————————————————————————————————————————————————————————
# Value Conversion
# ———————————————————————————————————————————————————————————————

def toml_to_value(tv: &TomlValue) -> Value
  match tv
  when TomlValue::String(s) then Value::String(s.clone())
  when TomlValue::Integer(i) then Value::Int(i.clone())
  when TomlValue::Float(f) then Value::Float(f.clone())
  when TomlValue::Boolean(b) then Value::Bool(b.clone())
  when TomlValue::DateTime(dt) then
    let mut tagged: Map[String, Value] = Map::new()
    tagged.insert("__toml_type".to_string(), Value::String("datetime".to_string()))
    tagged.insert("value".to_string(), Value::String(datetime_to_string(&dt)))
    Value::Object(tagged)
  when TomlValue::Array(arr) then
    let mut result = Vec::new()
    for item in arr do
      result.push(toml_to_value(&item))
    end
    Value::Array(result)
  when TomlValue::Table(tbl) then
    let mut result: Map[String, Value] = Map::new()
    for entry in tbl do
      let (k, v) = entry
      result.insert(k.clone(), toml_to_value(&v))
    end
    Value::Object(result)
  end
end

def toml_from_value(v: &Value) -> TomlValue
  match v
  when Value::Null then TomlValue::String("null".to_string())
  when Value::Bool(b) then TomlValue::Boolean(b.clone())
  when Value::Int(i) then TomlValue::Integer(i.clone())
  when Value::Float(f) then TomlValue::Float(f.clone())
  when Value::String(s) then TomlValue::String(s.clone())
  when Value::Array(arr) then
    let mut result = Vec::new()
    for item in arr do
      result.push(toml_from_value(&item))
    end
    TomlValue::Array(result)
  when Value::Object(obj) then
    match (obj.get("__toml_type"), obj.get("value"))
    when (Option::Some(Value::String(t)), Option::Some(Value::String(raw))) then
      if t == "datetime" then
        let mut p = TomlParser::new("")
        match p.parse_datetime_value(raw)
        when Result::Ok(dtv) then return dtv
        when Result::Err(_) then ()
        end
      end
    when _ then ()
    end

    let mut result: Map[String, TomlValue] = Map::new()
    for entry in obj do
      let (k, v) = entry
      result.insert(k.clone(), toml_from_value(&v))
    end
    TomlValue::Table(result)
  end
end

def datetime_to_string(dt: &TomlDateTime) -> String
  let mut s = TomlStringifier::new()
  s.write_datetime(dt)
  s.finish()
end