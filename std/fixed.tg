impl[T] SpscRx8[T]
  def capacity(self: Self) -> UInt
    8
  end

  def pop(inout self: Self) -> Option[T]
    let st = self._state.as_mut()
    let head = __sync_fetch_and_add(&st._head, 0)
    if head == self._tail then
      return Option::None
    end
    let item = st._data[(self._tail & 7)].take()
    self._tail = self._tail + 1
    __sync_fetch_and_add(&st._tail, 1)
    item
  end

  def len(self: Self) -> UInt
    let st = self._state.as_mut()
    let head = __sync_fetch_and_add(&st._head, 0)
    head - self._tail
  end
end

impl[T] Drop for SpscRx8[T]
  def drop(inout self: SpscRx8[T]) -> Unit
