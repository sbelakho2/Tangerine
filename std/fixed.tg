  _tail: UInt      # published consumer counter (consumer writes)
  _refs: UInt      # live endpoint count: 2 -> 1 -> 0 (drop protocol)
  _rx_alive: UInt  # 1 while the receiver endpoint lives; 0 once dropped
  _data: [Option[T]; 8]
end

