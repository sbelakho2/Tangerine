# ═══════════════════════════════════════════════════════════════════════
# RingBuffer — fixed-capacity circular buffer
# ═══════════════════════════════════════════════════════════════════════
# Power-of-two capacities ONLY: the ring indexes through the mask fast
# path ((i + 1) & (N - 1)) — no modulo division anywhere. push consumes
# the item (Result::Err(item) when full); pop transfers ownership; peek
# (T: Copy) copies the front element. The drop glue over the inline
# Option slots destructs exactly the occupied elements at end of life.

## Fixed-capacity ring, 4 elements (power of two).
struct RingBuffer4[T]
  _data: [Option[T]; 4]
  _head: UInt  # next write position
  _tail: UInt  # next read position
  _count: UInt
end

impl[T] RingBuffer4[T]
  def new() -> RingBuffer4[T]
    RingBuffer4 {
      _data: [
        Option::None, Option::None, Option::None, Option::None
      ],
      _head: 0,
      _tail: 0,
      _count: 0
    }
  end

  def len(self: Self) -> UInt
    self._count
  end

  def capacity(self: Self) -> UInt
    4
  end

  def is_empty(self: Self) -> Bool
    self._count == 0
  end

  def is_full(self: Self) -> Bool
    self._count == 4
  end

  # Ownership-taking push at the write position (vacant: the count
  # discipline guarantees the write slot holds None). Full: the item is
  # returned to the caller as Err(item).
  def push(inout self: Self, sink item: T) -> Result[Unit, T]
    if self.is_full() then
      return Result::Err(item)
    end
    self._data[self._head] = Option::Some(item)
    self._head = (self._head + 1) & 3
    self._count = self._count + 1
    Result::Ok(())
  end

  # Ownership-transferring pop from the read position (the slot resets to
  # None). Empty: None.
  def pop(inout self: Self) -> Option[T]
    if self.is_empty() then
      return Option::None
    end
    let item = self._data[self._tail].take()
    self._tail = (self._tail + 1) & 3
    self._count = self._count - 1
    item
  end

  def clear(inout self: Self) -> Unit
    while self._count > 0 do
      self.pop()
    end
  end
end

# By-value projected read of the front element (Copy only — sound
# duplication).
impl[T: Copy] RingBuffer4[T]
  def peek(self: Self) -> Option[T]
    if self.is_empty() then
      return Option::None
    end
    match self._data[self._tail]
    when Option::Some(v) then Option::Some(v)
    when Option::None then Option::None
    end
  end
end

