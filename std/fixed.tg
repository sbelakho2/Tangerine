    if !self._state.is_null() then
      let old = __sync_fetch_and_sub(&self._state.as_mut()._refs, 1)
      if old == 1 then
        self._state.drop_in_place()
        dealloc(self._state)
      end
      self._state = Ptr::null()
    end
  end
end

impl[T] UnsafeTransferable for SpscTx8[T]
  # Opt-in gate (the raw-pointer thread-safety contract in std::core):
  # the endpoint's pointer stays valid exactly as long as this endpoint
