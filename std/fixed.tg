# ═══════════════════════════════════════════════════════════════════════
# Const-generic views — ArrayVec[T, const N] / RingBuffer[T, const N]
# (the promoted surface; the concrete families above remain the engine —
# see the module header for the relationship, capacity validation and
# the construction contract)
# ═══════════════════════════════════════════════════════════════════════
# One declaration over the capacity parameter: ArrayVec[Int, 8] is the
# type the engine spells ArrayVec8[Int] — the SAME canonical body
# (direct inline [Option[T]; N] storage) with N as the const parameter.
# The field types are the §20 symbolic-size form (Type::FixedArraySym)
# while the body is generic and substitute to the concrete fixed arrays
# per instance; the const parameter reads as a per-instance VALUE in the
# bodies (capacity() returns N; is_full compares against N; the ring
# wraps through the computed (N - 1) mask — no literal mask constants).
# Method bodies mirror the concrete families' logic exactly, and the
# drop glue of a monomorphized view value is the same structural glue
# (Option-slot exactness: occupied Some slots destructed exactly once).
#
# new() IS declared on the views: an N-item Option::None fill is spelled
# through the [elem; count] REPEAT literal with the const parameter as the
# count ([Option::None; N] — see the module header, CONSTRUCTION); the
# concrete capacity sites may keep the §20 aggregate-literal bridge or the
# concrete engine family.

## Fixed-capacity vector over the const capacity parameter N.
struct ArrayVec[T, const N: UInt]
  _data: [Option[T]; N]
  _len: UInt
end

impl[T, const N: UInt] ArrayVec[T, N]
  # The N-independent empty constructor: every slot is the payload-less
  # None image ([Option::None; N] — the repeat fill; sound for every T).
  def new() -> ArrayVec[T, N]
    ArrayVec {
      _data: [Option::None; N],
      _len: 0
    }
  end

  def len(self: Self) -> UInt
    self._len
  end

  def capacity(self: Self) -> UInt
    N
  end

  def is_empty(self: Self) -> Bool
    self._len == 0
  end

  def is_full(self: Self) -> Bool
    self._len >= N
  end

  # Ownership-taking push: consumes the item into slot [_len] (vacant by
  # the len discipline). On a full vector the item was NOT consumed and is
  # returned to the caller as Err(item).
  def push(inout self: Self, sink item: T) -> Result[Unit, T]
    if self.is_full() then
      return Result::Err(item)
    end
    self._data[self._len] = Option::Some(item)
    self._len = self._len + 1
    Result::Ok(())
  end

  # Ownership-transferring pop: the last occupied slot's Option is taken
  # (the slot resets to None) and the element moves out to the caller.
  def pop(inout self: Self) -> Option[T]
    if self._len == 0 then
      return Option::None
    end
    self._len = self._len - 1
    self._data[self._len].take()
  end

  # Drains every occupied slot through pop (each element destructed by
  # its own drop as the returned Option is discarded — the VecDeque::clear
  # convention in std::collections.tg).
  def clear(inout self: Self) -> Unit
    while self._len > 0 do
      self.pop()
    end
  end
end

# By-value projected read of a Copy element (slot Option[T] is copied
# only under T: Copy — sound duplication).
impl[T: Copy, const N: UInt] ArrayVec[T, N]
  def get(self: Self, index: UInt) -> Option[T]
    if index >= self._len then
      return Option::None
    end
    match self._data[index]
    when Option::Some(v) then Option::Some(v)
    when Option::None then Option::None
    end
  end
end

## Fixed-capacity ring over the const capacity parameter N (power-of-two
## capacities ONLY — the mask (N - 1) is the wrap fast path; see the
## module header's CAPACITY VALIDATION).
struct RingBuffer[T, const N: UInt]
  _data: [Option[T]; N]
  _head: UInt  # next write position
  _tail: UInt  # next read position
  _count: UInt
end

impl[T, const N: UInt] RingBuffer[T, N]
  # The N-independent empty constructor (power-of-two capacities only —
  # the (N - 1) mask wrap fast path; the module header's CAPACITY
  # VALIDATION). The runtime guard asserts N is a power of two and panics
  # otherwise; the assert compiles away on the power-of-two instances the
  # ring contract admits.
  def new() -> RingBuffer[T, N]
    assert(N & (N - 1) == 0, "RingBuffer capacity must be a power of two (the mask wrap (i + 1) & (N - 1) requires it)")
    RingBuffer {
      _data: [Option::None; N],
      _head: 0,
      _tail: 0,
      _count: 0
    }
  end

  def len(self: Self) -> UInt
    self._count
  end

  def capacity(self: Self) -> UInt
    N
  end

  def is_empty(self: Self) -> Bool
    self._count == 0
  end

  def is_full(self: Self) -> Bool
    self._count == N
  end

  # Ownership-taking push at the write position (vacant: the count
  # discipline guarantees the write slot holds None). Full: the item is
  # returned to the caller as Err(item).
  def push(inout self: Self, sink item: T) -> Result[Unit, T]
    if self.is_full() then
      return Result::Err(item)
    end
    self._data[self._head] = Option::Some(item)
    self._head = (self._head + 1) & (N - 1)
    self._count = self._count + 1
    Result::Ok(())
  end

  # Ownership-transferring pop from the read position (the slot resets to
  # None). Empty: None.
  def pop(inout self: Self) -> Option[T]
    if self.is_empty() then
      return Option::None
    end
    let item = self._data[self._tail].take()
    self._tail = (self._tail + 1) & (N - 1)
    self._count = self._count - 1
    item
  end

  def clear(inout self: Self) -> Unit
    while self._count > 0 do
      self.pop()
    end
  end
end

# By-value projected read of the front element (Copy only — sound
# duplication).
impl[T: Copy, const N: UInt] RingBuffer[T, N]
  def peek(self: Self) -> Option[T]
    if self.is_empty() then
      return Option::None
    end
    match self._data[self._tail]
    when Option::Some(v) then Option::Some(v)
    when Option::None then Option::None
    end
  end
end

# ═══════════════════════════════════════════════════════════════════════
# Const-generic SPSC — SpscQueue[T, const N] / SpscTx[T, const N] /
# SpscRx[T, const N] (the promoted queue surface over the capacity
# parameter; the SpscQueueN engine families above remain the engine — the
# same split-endpoint design, the same close linearization, N as the const
# parameter; see the module header for the full contract)
# ═══════════════════════════════════════════════════════════════════════
# One declaration over the capacity parameter: SpscQueue[Int, 8] is the
# type the engine spells SpscQueue8[Int]. The queue's ONLY construction
# path writes the shared record — the N-item None fill through the
# [elem; count] repeat ([Option::None; N]) — then splits it into the two
# unique endpoints. The mask fast paths require a power-of-two N (the
# (N - 1) wrap); new() asserts it at runtime and panics otherwise, exactly
# like the generic RingBuffer view.

## Shared state + factory over the const capacity parameter N.
struct SpscQueue[T, const N: UInt]
  _head: UInt  # head STATE word: published producer counter (bits
               # [0, 63)) + the CLOSED bit at bit 63 — one atomic word
  _tail: UInt  # published consumer counter (consumer writes)
  _refs: UInt  # live endpoint count: 2 -> 1 -> 0 (drop protocol)
  _data: [Option[T]; N]
end

struct SpscTx[T, const N: UInt]
  _state: Ptr[SpscQueue[T, N]]
  _head: UInt  # producer-local counter shadow (never shared)
end

struct SpscRx[T, const N: UInt]
  _state: Ptr[SpscQueue[T, N]]
  _tail: UInt  # consumer-local counter shadow (never shared)
end

impl[T, const N: UInt] SpscQueue[T, N]
  # Creates the one shared state record (every slot the payload-less None
  # image) and splits it into the unique producer and consumer endpoints.
  def new() -> (SpscTx[T, N], SpscRx[T, N])
    assert(N & (N - 1) == 0, "SpscQueue capacity must be a power of two (the mask slot index (counter & (N - 1)) requires it)")
    let st = alloc[SpscQueue[T, N]]()
    if st.is_null() then
      panic("SpscQueue::new: out of memory")
    end
    st.write(SpscQueue[T, N] {
      _head: 0,
      _tail: 0,
      _refs: 2,
      _data: [Option::None; N]
    })
    (SpscTx[T, N] { _state: st, _head: 0 }, SpscRx[T, N] { _state: st, _tail: 0 })
  end
end

impl[T, const N: UInt] SpscTx[T, N]
  def capacity(self: Self) -> UInt
    N
  end

  # Ownership-taking publish. Rejected (Err(item), item NOT consumed)
  # when the queue is closed or full. Publication order: slot write,
  # THEN the full-barrier publish CAS (open, H) -> (open, H + 1) on the
  # head word — the CAS success is this push's linearization point; a
  # CAS failure means the receiver's close linearized first, so the
  # just-written slot is reclaimed and the item returns as Err (no
  # Ok-after-close window). The pre-probe below is a pure fast path for
  # the closed queue — it is NOT re-checked after the slot write (the
  # CAS result is the single authority).
  def push(inout self: Self, sink item: T) -> Result[Unit, T]
    let st = self._state.as_mut()
    let closed = (1 as UInt) << 63
    let head_state = __sync_fetch_and_add(&st._head, 0)
    if head_state >= closed then
      return Result::Err(item)
    end
    let tail = __sync_fetch_and_add(&st._tail, 0)
    if head_state - tail >= N then
      return Result::Err(item)
    end
    let slot_idx = head_state & (N - 1)
    st._data[slot_idx] = Option::Some(item)
    let old = __sync_val_compare_and_swap_uint(&st._head, head_state, head_state + 1)
    if old != head_state then
      ## the publish CAS failed: only the receiver's close writes the
      ## head word beside this producer, so the state now carries
      ## CLOSED — the slot was never observable; take the value back
      ## and return it unconsumed.
      match st._data[slot_idx].take()
      when Option::Some(v) then return Result::Err(v)
      when Option::None then panic("Spsc push reclaim: slot unexpectedly empty")
      end
    end
    self._head = head_state + 1
    Result::Ok(())
  end

  # Occupancy as published: the producer's own head minus the consumer's
  # published tail (exact at the load instant).
  def len(self: Self) -> UInt
    let st = self._state.as_mut()
    let tail = __sync_fetch_and_add(&st._tail, 0)
    self._head - tail
  end
end

impl[T, const N: UInt] Drop for SpscTx[T, N]
  def drop(inout self: SpscTx[T, N]) -> Unit
    if !self._state.is_null() then
      let old = __sync_fetch_and_sub(&self._state.as_mut()._refs, 1)
      if old == 1 then
        # Last endpoint: destruct every occupied slot through the record's
        # structural glue and release the allocation.
        self._state.drop_in_place()
        dealloc(self._state)
      end
      self._state = Ptr::null()
    end
  end
end

impl[T, const N: UInt] UnsafeTransferable for SpscTx[T, N]
  # Opt-in gate (the raw-pointer thread-safety contract in std::core):
  # the endpoint's pointer stays valid exactly as long as this endpoint
  # value lives — the shared record is freed only by the LAST endpoint's
  # drop, never while a tx or rx value that could push/pop is alive.
end

impl[T, const N: UInt] SpscRx[T, N]
  def capacity(self: Self) -> UInt
    N
  end

  # Ownership-transferring pop of the oldest published element. Empty
  # (published head == tail): None — pop never blocks, and a closed
  # queue drains exactly like an open one (the CLOSED bit is masked off
  # the far-side head load below). Consumption order: the slot take
  # happens BEFORE the tail counter's full-barrier RMW — the
  # producer's far-side tail read observes the freed slot.
  def pop(inout self: Self) -> Option[T]
    let st = self._state.as_mut()
    let closed_mask = ((1 as UInt) << 63) - 1
    let head = __sync_fetch_and_add(&st._head, 0)
    if (head & closed_mask) == self._tail then
      return Option::None
    end
    let item = st._data[(self._tail & (N - 1))].take()
    self._tail = self._tail + 1
    __sync_fetch_and_add(&st._tail, 1)
    item
  end

  # Occupancy as published: the producer's published head minus the
  # consumer's own tail (exact at the load instant; the far-side load
  # is masked to drop the CLOSED bit).
  def len(self: Self) -> UInt
    let st = self._state.as_mut()
    let head = __sync_fetch_and_add(&st._head, 0)
    (head & (((1 as UInt) << 63) - 1)) - self._tail
  end
end

impl[T, const N: UInt] Drop for SpscRx[T, N]
  def drop(inout self: SpscRx[T, N]) -> Unit
    if !self._state.is_null() then
      # Close the receive side FIRST: OR the CLOSED bit into the head
      # word with a CAS loop — the successful CAS IS the linearization
      # point of close (every publish CAS that won before it stays Ok;
      # every later one fails and reclaims). A head word that already
      # carries CLOSED is the idempotent case: close is done. The retry
      # covers the producer publish that won the CAS in between.
      let closed = (1 as UInt) << 63
      loop do
        let cur = __sync_fetch_and_add(&self._state.as_mut()._head, 0)
        if cur >= closed then
          break
        end
        let old = __sync_val_compare_and_swap_uint(
          &self._state.as_mut()._head, cur, (cur | closed)
        )
        if old == cur then
          break
        end
      end
      let old_refs = __sync_fetch_and_sub(&self._state.as_mut()._refs, 1)
      if old_refs == 1 then
        # Last endpoint: destruct every occupied slot through the record's
        # structural glue and release the allocation.
        self._state.drop_in_place()
        dealloc(self._state)
      end
      self._state = Ptr::null()
    end
  end
end

impl[T, const N: UInt] UnsafeTransferable for SpscRx[T, N]
  # Opt-in gate (the raw-pointer thread-safety contract in std::core):
  # the endpoint's pointer stays valid exactly as long as this endpoint
  # value lives — the shared record is freed only by the LAST endpoint's
  # drop, never while a tx or rx value that could push/pop is alive.
end

# ═══════════════════════════════════════════════════════════════════════
# Usage notes
# ═══════════════════════════════════════════════════════════════════════
#
#   use std::fixed
#
#   # ArrayVec (the concrete families or the const-generic view — see the
#   # module header for the compile-time-capacity design decision):
#   let mut v: ArrayVec8[String] = ArrayVec8::new()
#   match v.push("a".to_string())
#   when Result::Ok(_) then ()
#   when Result::Err(item) then ()  # full: the item returns to the caller
#   end
#   match v.pop()
#   when Option::Some(s) then ()
#   when Option::None then ()
#   end
#
#   # RingBuffer (power-of-two capacity — mask indexing):
#   let mut rb: RingBuffer16[Int] = RingBuffer16::new()
#
#   # Const-generic views (the promoted surface — same semantics as the
#   # engine families; the N-item None fill is spelled through the
#   # [elem; count] repeat literal, see the module header):
#   var vv: ArrayVec[Int, 8] = ArrayVec[Int, 8]::new()
#   # vv.capacity() == 8; push/pop/clear mirror ArrayVec8's contract.
#   var rv: RingBuffer[Int, 4] = RingBuffer[Int, 4]::new()
#
#   # SPSC split endpoints (the shared state record lives until BOTH
#   # endpoints drop; move the endpoints into the two threads):
#   let (tx, rx): (SpscTx8[Task], SpscRx8[Task]) = SpscQueue8::new()
#   # tx.push(task)   -> Result[Unit, Task]   (Err returns the item)
#   # rx.pop()        -> Option[Task]
#   # Dropping rx CLOSES the queue at a linearization point: every push
#   # that won its publish CAS before it stays Ok (observable), every
#   # later push returns Err(task); buffered items are destructed by the
#   # last endpoint's drop.
#   # The const-generic SPSC family spells the same contract over the
#   # capacity parameter: SpscQueue[Task, 8]::new() -> (SpscTx[Task, 8],
#   # SpscRx[Task, 8]).
