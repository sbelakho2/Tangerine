# ═══════════════════════════════════════════════════════════════════════
# SpscQueue — fixed-capacity lock-free SPSC queue (split endpoints)
# ═══════════════════════════════════════════════════════════════════════
# SpscQueueN[T] is the SHARED STATE record (head/tail publication
# counters + the inline slot array), constructed ONLY by new(), which
# returns the two unique endpoints: SpscTxN[T] (pushes only) and
# SpscRxN[T] (pops only). See the module header for the full design
# contract (state lifetime, __sync ordering surface, slot discipline).

## Shared state + factory, 4 elements.
struct SpscQueue4[T]
  _head: UInt      # published producer counter (producer writes)
  _tail: UInt      # published consumer counter (consumer writes)
  _refs: UInt      # live endpoint count: 2 -> 1 -> 0 (drop protocol)
  _rx_alive: UInt  # 1 while the receiver endpoint lives; 0 once dropped
  _data: [Option[T]; 4]
end

struct SpscTx4[T]
  _state: Ptr[SpscQueue4[T]]
  _head: UInt  # producer-local counter shadow (never shared)
end

struct SpscRx4[T]
  _state: Ptr[SpscQueue4[T]]
  _tail: UInt  # consumer-local counter shadow (never shared)
end

impl[T] SpscQueue4[T]
  # Creates the one shared state record and splits it into the unique
  # producer and consumer endpoints.
  def new() -> (SpscTx4[T], SpscRx4[T])
    let st = alloc[SpscQueue4[T]]()
    if st.is_null() then
      panic("SpscQueue4::new: out of memory")
    end
    st.write(SpscQueue4[T] {
      _head: 0,
      _tail: 0,
      _refs: 2,
      _rx_alive: 1,
      _data: [
        Option::None, Option::None, Option::None, Option::None
      ]
    })
    (SpscTx4[T] { _state: st, _head: 0 }, SpscRx4[T] { _state: st, _tail: 0 })
  end
end

impl[T] SpscTx4[T]
  def capacity(self: Self) -> UInt
    4
  end

  # Ownership-taking publish. Rejected (Err(item), item NOT consumed)
  # when the receiver endpoint has been dropped or the queue is full.
  # Publication order: slot write, THEN the head counter's full-barrier
  # RMW — the consumer's far-side head read observes the element.
  def push(inout self: Self, sink item: T) -> Result[Unit, T]
    let st = self._state.as_mut()
    if __sync_fetch_and_add(&st._rx_alive, 0) == 0 then
      return Result::Err(item)
    end
    let tail = __sync_fetch_and_add(&st._tail, 0)
    if self._head - tail >= 4 then
      return Result::Err(item)
    end
    st._data[(self._head & 3)] = Option::Some(item)
    self._head = self._head + 1
    if __sync_fetch_and_add(&st._rx_alive, 0) == 0 then
      ## the receiver endpoint dropped while this push was in
      ## flight: the slot was written but never published —
      ## revert it and return the item unconsumed (a closed
      ## queue accepts nothing).
      match st._data[(self._head & 3)].take()
      when Option::Some(v) then return Result::Err(v)
      when Option::None then panic("Spsc push revert: slot unexpectedly empty")
      end
    end
    __sync_fetch_and_add(&st._head, 1)
    Result::Ok(())
  end

  # Occupancy as published: the producer's own head minus the consumer's
  # published tail (exact at the load instant).
  def len(self: Self) -> UInt
    let st = self._state.as_mut()
    let tail = __sync_fetch_and_add(&st._tail, 0)
    self._head - tail
  end
end

impl[T] Drop for SpscTx4[T]
  def drop(inout self: SpscTx4[T]) -> Unit
    if !self._state.is_null() then
      let old = __sync_fetch_and_sub(&self._state.as_mut()._refs, 1)
      if old == 1 then
        # Last endpoint: destruct every occupied slot through the record's
        # structural glue and release the allocation.
        self._state.drop_in_place()
        dealloc(self._state)
      end
      self._state = Ptr::null()
    end
  end
end

impl[T] UnsafeTransferable for SpscTx4[T]
  # Opt-in gate (the raw-pointer thread-safety contract in std::core):
  # the endpoint's pointer stays valid exactly as long as this endpoint
  # value lives — the shared record is freed only by the LAST endpoint's
  # drop, never while a tx or rx value that could push/pop is alive.
end

impl[T] SpscRx4[T]
  def capacity(self: Self) -> UInt
    4
  end

  # Ownership-transferring pop of the oldest published element. Empty
  # (head == tail): None — pop never blocks. Consumption order: the slot
  # take happens BEFORE the tail counter's full-barrier RMW — the
  # producer's far-side tail read observes the freed slot.
  def pop(inout self: Self) -> Option[T]
    let st = self._state.as_mut()
    let head = __sync_fetch_and_add(&st._head, 0)
    if head == self._tail then
      return Option::None
    end
    let item = st._data[(self._tail & 3)].take()
    self._tail = self._tail + 1
    __sync_fetch_and_add(&st._tail, 1)
    item
  end

  # Occupancy as published: the producer's published head minus the
  # consumer's own tail (exact at the load instant).
  def len(self: Self) -> UInt
    let st = self._state.as_mut()
    let head = __sync_fetch_and_add(&st._head, 0)
    head - self._tail
  end
end

impl[T] Drop for SpscRx4[T]
  def drop(inout self: SpscRx4[T]) -> Unit
    if !self._state.is_null() then
      # Close the receive side FIRST: every later push returns Err
      # without touching the slots.
      __sync_fetch_and_sub(&self._state.as_mut()._rx_alive, 1)
      let old = __sync_fetch_and_sub(&self._state.as_mut()._refs, 1)
      if old == 1 then
        # Last endpoint: destruct every occupied slot through the record's
        # structural glue and release the allocation.
        self._state.drop_in_place()
        dealloc(self._state)
      end
      self._state = Ptr::null()
    end
  end
end

impl[T] UnsafeTransferable for SpscRx4[T]
  # Opt-in gate (the raw-pointer thread-safety contract in std::core):
  # the endpoint's pointer stays valid exactly as long as this endpoint
  # value lives — the shared record is freed only by the LAST endpoint's
  # drop, never while a tx or rx value that could push/pop is alive.
end

