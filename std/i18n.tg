## ---------------------------------------------------------------
## tg::i18n — Internationalization text validation
## Covers §25.1 of TG-GFX-UI-SPEC-001 v0.1
## ---------------------------------------------------------------

use std::text
use std::geom

## ---------------------------------------------------------------
## 25.1  Script direction support
## ---------------------------------------------------------------

enum ScriptDirection
  LeftToRight
  RightToLeft
  TopToBottom
end

## Determine dominant direction for a Unicode codepoint range.
def detect_direction(codepoint: u32) -> ScriptDirection
  ## Arabic: U+0600–U+06FF, Hebrew: U+0590–U+05FF
  if (codepoint >= 0x0590u32 && codepoint <= 0x05FFu32) ||
     (codepoint >= 0x0600u32 && codepoint <= 0x06FFu32) ||
     (codepoint >= 0xFB50u32 && codepoint <= 0xFDFFu32) ||
     (codepoint >= 0xFE70u32 && codepoint <= 0xFEFFu32)
    return ScriptDirection::RightToLeft
  end
  ## CJK vertical: handled by layout engine; default LTR for horizontal
  ScriptDirection::LeftToRight
end

## ---------------------------------------------------------------
## 25.1  Bidi text handling
## ---------------------------------------------------------------

struct BidiRun
  start: u64
  length: u64
  direction: ScriptDirection
  embedding_level: u32
end

def split_bidi_runs(text: String) -> List[BidiRun]
  ## Reference implementation: splits on direction changes.
  ## Full UAX #9 bidi algorithm would be in the shaping backend.
  let mut runs = List.new()
  if text.is_empty()
    return runs
  end
  let mut current_dir = detect_direction(text.codepoint_at(0))
  let mut run_start = 0u64
  let mut i = 0u64
  for cp in text.codepoints()
    let dir = detect_direction(cp)
    if dir != current_dir
      runs.push(BidiRun {
        start: run_start,
        length: i - run_start,
        direction: current_dir,
        embedding_level: 0u32,
      })
      run_start = i
      current_dir = dir
    end
    i = i + 1u64
  end
  runs.push(BidiRun {
    start: run_start,
    length: i - run_start,
    direction: current_dir,
    embedding_level: 0u32,
  })
  runs
end

## ---------------------------------------------------------------
## 25.1  Combining marks and grapheme clusters
## ---------------------------------------------------------------

## Check if a codepoint is a combining mark (general category M).
def is_combining_mark(cp: u32) -> Bool
  ## Combining Diacritical Marks: U+0300–U+036F
  ## Combining Marks Extension: U+1AB0–U+1AFF
  ## Combining Half Marks: U+FE20–U+FE2F
  (cp >= 0x0300u32 && cp <= 0x036Fu32) ||
  (cp >= 0x1AB0u32 && cp <= 0x1AFFu32) ||
  (cp >= 0xFE20u32 && cp <= 0xFE2Fu32)
end

## Check if a codepoint is a surrogate (these should never appear in valid UTF-8/32).
def is_surrogate(cp: u32) -> Bool
  cp >= 0xD800u32 && cp <= 0xDFFFu32
end

## Validate grapheme cluster boundary: a combining mark must follow a base character.
def validate_grapheme_sequence(codepoints: List[u32]) -> Bool
  if codepoints.is_empty()
    return true
  end
  ## First codepoint must not be a combining mark
  if is_combining_mark(codepoints.get(0))
    return false
  end
  for cp in codepoints
    if is_surrogate(cp)
      return false
    end
  end
  true
end

## ---------------------------------------------------------------
## 25.1  Line wrapping/justification edge cases
## ---------------------------------------------------------------

enum LineBreakOpportunity
  Mandatory      ## e.g., U+000A
  Allowed        ## soft break between words
  Prohibited     ## e.g., inside a word for most scripts
end

def classify_break(cp: u32) -> LineBreakOpportunity
  match cp
  when 0x000Au32  ## LF
    LineBreakOpportunity::Mandatory
  when 0x000Du32  ## CR
    LineBreakOpportunity::Mandatory
  when 0x0020u32  ## Space
    LineBreakOpportunity::Allowed
  when 0x00ADu32  ## Soft hyphen
    LineBreakOpportunity::Allowed
  when 0x200Bu32  ## Zero-width space
    LineBreakOpportunity::Allowed
  else
    LineBreakOpportunity::Prohibited
  end
end

## ---------------------------------------------------------------
## Tests
## ---------------------------------------------------------------

test "LTR detection for Latin" do
  let dir = detect_direction(0x0041u32)  ## 'A'
  assert dir == ScriptDirection::LeftToRight
end

test "RTL detection for Arabic" do
  let dir = detect_direction(0x0627u32)  ## Arabic Alef
  assert dir == ScriptDirection::RightToLeft
end

test "RTL detection for Hebrew" do
  let dir = detect_direction(0x05D0u32)  ## Hebrew Alef
  assert dir == ScriptDirection::RightToLeft
end

test "bidi run splitting" do
  ## "Hello" (LTR) + Arabic text (RTL) would produce 2 runs
  let runs = split_bidi_runs("Hello")
  assert runs.len() == 1
  assert runs.get(0).direction == ScriptDirection::LeftToRight
end

test "combining mark at start is invalid" do
  let cps = List.of(0x0301u32)  ## Combining acute accent alone
  assert !validate_grapheme_sequence(cps)
end

test "combining mark after base is valid" do
  let cps = List.of(0x0065u32, 0x0301u32)  ## e + combining acute
  assert validate_grapheme_sequence(cps)
end

test "surrogate codepoints are invalid" do
  let cps = List.of(0xD800u32)
  assert !validate_grapheme_sequence(cps)
end

test "line break classification" do
  assert classify_break(0x000Au32) == LineBreakOpportunity::Mandatory
  assert classify_break(0x0020u32) == LineBreakOpportunity::Allowed
  assert classify_break(0x0041u32) == LineBreakOpportunity::Prohibited
end
