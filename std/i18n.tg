## ---------------------------------------------------------------
## tg::i18n — Internationalization text validation
## Covers §25.1 of TG-GFX-UI-SPEC-001 v0.1
## ---------------------------------------------------------------

use std::text
use std::geom

## ---------------------------------------------------------------
## 25.1  Script direction support
## ---------------------------------------------------------------

enum ScriptDirection
  LeftToRight
  RightToLeft
  TopToBottom
end

## Determine dominant direction for a Unicode codepoint range.
def detect_direction(codepoint: u32) -> ScriptDirection
  ## Arabic: U+0600–U+06FF, Hebrew: U+0590–U+05FF
  if (codepoint >= 0x0590u32 && codepoint <= 0x05FFu32) ||
     (codepoint >= 0x0600u32 && codepoint <= 0x06FFu32) ||
     (codepoint >= 0xFB50u32 && codepoint <= 0xFDFFu32) ||
     (codepoint >= 0xFE70u32 && codepoint <= 0xFEFFu32)
    return ScriptDirection::RightToLeft
  end
  ## CJK vertical: handled by layout engine; default LTR for horizontal
  ScriptDirection::LeftToRight
end

## ---------------------------------------------------------------
## 25.1  Bidi text handling
## ---------------------------------------------------------------

struct BidiRun
  start: u64
  length: u64
  direction: ScriptDirection
  embedding_level: u32
end

## UAX #9 Bidi Character Types
enum BidiClass
  L     ## Left-to-Right
  R     ## Right-to-Left
  AL    ## Arabic Letter
  EN    ## European Number
  ES    ## European Separator
  ET    ## European Terminator
  AN    ## Arabic Number
  CS    ## Common Separator
  NSM   ## Nonspacing Mark
  BN    ## Boundary Neutral
  B     ## Paragraph Separator
  S     ## Segment Separator
  WS    ## Whitespace
  ON    ## Other Neutral
  LRE   ## Left-to-Right Embedding
  LRO   ## Left-to-Right Override
  RLE   ## Right-to-Left Embedding
  RLO   ## Right-to-Left Override
  PDF   ## Pop Directional Format
  LRI   ## Left-to-Right Isolate
  RLI   ## Right-to-Left Isolate
  FSI   ## First Strong Isolate
  PDI   ## Pop Directional Isolate
end

## Get the bidi class of a codepoint (simplified lookup — covers common ranges)
def _bidi_class(cp: u32) -> BidiClass
  # Explicit formatting characters
  if cp == 0x202Au32 then return BidiClass::LRE end
  if cp == 0x202Bu32 then return BidiClass::RLE end
  if cp == 0x202Cu32 then return BidiClass::PDF end
  if cp == 0x202Du32 then return BidiClass::LRO end
  if cp == 0x202Eu32 then return BidiClass::RLO end
  if cp == 0x2066u32 then return BidiClass::LRI end
  if cp == 0x2067u32 then return BidiClass::RLI end
  if cp == 0x2068u32 then return BidiClass::FSI end
  if cp == 0x2069u32 then return BidiClass::PDI end
  # Whitespace
  if cp == 0x20u32 || cp == 0x09u32 || cp == 0x0Bu32 || cp == 0x0Cu32 then return BidiClass::WS end
  # Paragraph separators
  if cp == 0x0Au32 || cp == 0x0Du32 || cp == 0x85u32 || cp == 0x2029u32 then return BidiClass::B end
  # European numbers
  if cp >= 0x30u32 && cp <= 0x39u32 then return BidiClass::EN end
  # European separators
  if cp == 0x2Bu32 || cp == 0x2Du32 then return BidiClass::ES end
  # European terminators
  if cp == 0x23u32 || cp == 0x24u32 || cp == 0x25u32 || cp == 0xA2u32 || cp == 0xA3u32 || cp == 0xA5u32 then return BidiClass::ET end
  # Common separators
  if cp == 0x2Cu32 || cp == 0x2Eu32 || cp == 0x3Au32 || cp == 0x2Fu32 then return BidiClass::CS end
  # Nonspacing marks
  if (cp >= 0x0300u32 && cp <= 0x036Fu32) || (cp >= 0x0591u32 && cp <= 0x05BDu32) ||
     (cp >= 0x0610u32 && cp <= 0x061Au32) || (cp >= 0x064Bu32 && cp <= 0x065Fu32) then
    return BidiClass::NSM
  end
  # Arabic
  if (cp >= 0x0600u32 && cp <= 0x06FFu32) || (cp >= 0xFB50u32 && cp <= 0xFDFFu32) ||
     (cp >= 0xFE70u32 && cp <= 0xFEFFu32) then
    return BidiClass::AL
  end
  # Hebrew
  if cp >= 0x0590u32 && cp <= 0x05FFu32 then return BidiClass::R end
  # RTL ranges: Thaana, NKo, Samaritan, Mandaic, Syriac
  if (cp >= 0x0700u32 && cp <= 0x074Fu32) || (cp >= 0x0780u32 && cp <= 0x07BFu32) ||
     (cp >= 0x07C0u32 && cp <= 0x07FFu32) || (cp >= 0x0800u32 && cp <= 0x083Fu32) ||
     (cp >= 0x0840u32 && cp <= 0x085Fu32) then
    return BidiClass::R
  end
  # Arabic numbers
  if cp >= 0x0660u32 && cp <= 0x0669u32 then return BidiClass::AN end
  # Latin, CJK, most other scripts
  if cp < 0x0590u32 then return BidiClass::L end
  # Default: Other Neutral
  BidiClass::ON
end

## Check if bidi class is "strong" (L, R, or AL)
def _is_strong(bc: &BidiClass) -> Bool
  match bc
  when BidiClass::L then true
  when BidiClass::R then true
  when BidiClass::AL then true
  when _ then false
  end
end

## Resolve embedding levels per UAX #9 using directional status stack
struct _BidiStatus
  embedding_level: u32
  override_dir: BidiClass  ## L, R, or ON (= no override)
  isolate: Bool
end

def split_bidi_runs(text: String) -> List[BidiRun]
  ## Full UAX #9 Bidirectional Algorithm implementation.
  let mut runs = List.new()
  if text.is_empty()
    return runs
  end

  let codepoints = text.codepoints().collect()
  let n = codepoints.len()

  ## Step P2/P3: Determine paragraph embedding level from first strong character
  let mut paragraph_level: u32 = 0u32
  for cp in &codepoints do
    let bc = _bidi_class(*cp)
    if _is_strong(&bc) then
      match bc
      when BidiClass::R then paragraph_level = 1u32; break
      when BidiClass::AL then paragraph_level = 1u32; break
      when _ then paragraph_level = 0u32; break
      end
    end
  end

  ## Step X1: Initialize directional status stack
  let mut levels = List.new()
  for _ in 0..n do levels.push(paragraph_level) end

  let mut types = List.new()
  for cp in &codepoints do types.push(_bidi_class(*cp)) end

  let mut stack = List.new()
  stack.push(_BidiStatus { embedding_level: paragraph_level, override_dir: BidiClass::ON, isolate: false })
  let mut overflow_isolate = 0u32
  let mut overflow_embedding = 0u32
  let mut valid_isolate = 0u32
  let max_depth = 125u32

  ## Steps X2-X8: Process explicit embedding and isolate controls
  let mut i = 0u64
  while i < n do
    let bc = &types[i]
    let cur_level = stack[stack.len() - 1].embedding_level

    match bc
    when BidiClass::RLE | BidiClass::RLO then
      let new_level = (cur_level | 1u32) + 2u32
      if new_level <= max_depth && overflow_isolate == 0u32 && overflow_embedding == 0u32 then
        let ovr = match bc when BidiClass::RLO then BidiClass::R when _ then BidiClass::ON end
        stack.push(_BidiStatus { embedding_level: new_level, override_dir: ovr, isolate: false })
      else
        if overflow_isolate == 0u32 then overflow_embedding = overflow_embedding + 1u32 end
      end
      types[i] = BidiClass::BN
    when BidiClass::LRE | BidiClass::LRO then
      let new_level = (cur_level + 2u32) & 0xFFFFFFFEu32
      if new_level <= max_depth && overflow_isolate == 0u32 && overflow_embedding == 0u32 then
        let ovr = match bc when BidiClass::LRO then BidiClass::L when _ then BidiClass::ON end
        stack.push(_BidiStatus { embedding_level: new_level, override_dir: ovr, isolate: false })
      else
        if overflow_isolate == 0u32 then overflow_embedding = overflow_embedding + 1u32 end
      end
      types[i] = BidiClass::BN
    when BidiClass::RLI then
      levels[i] = cur_level
      let new_level = (cur_level | 1u32) + 2u32
      if new_level <= max_depth && overflow_isolate == 0u32 && overflow_embedding == 0u32 then
        valid_isolate = valid_isolate + 1u32
        stack.push(_BidiStatus { embedding_level: new_level, override_dir: BidiClass::ON, isolate: true })
      else
        overflow_isolate = overflow_isolate + 1u32
      end
    when BidiClass::LRI | BidiClass::FSI then
      levels[i] = cur_level
      let new_level = (cur_level + 2u32) & 0xFFFFFFFEu32
      if new_level <= max_depth && overflow_isolate == 0u32 && overflow_embedding == 0u32 then
        valid_isolate = valid_isolate + 1u32
        stack.push(_BidiStatus { embedding_level: new_level, override_dir: BidiClass::ON, isolate: true })
      else
        overflow_isolate = overflow_isolate + 1u32
      end
    when BidiClass::PDI then
      if overflow_isolate > 0u32 then
        overflow_isolate = overflow_isolate - 1u32
      elsif valid_isolate > 0u32 then
        overflow_embedding = 0u32
        while stack.len() > 1 && !stack[stack.len() - 1].isolate do
          stack.pop()
        end
        if stack.len() > 1 then stack.pop() end
        valid_isolate = valid_isolate - 1u32
      end
      levels[i] = stack[stack.len() - 1].embedding_level
    when BidiClass::PDF then
      if overflow_isolate == 0u32 then
        if overflow_embedding > 0u32 then
          overflow_embedding = overflow_embedding - 1u32
        elsif stack.len() > 1 && !stack[stack.len() - 1].isolate then
          stack.pop()
        end
      end
      types[i] = BidiClass::BN
    when BidiClass::B then
      levels[i] = paragraph_level
    when _ then
      levels[i] = stack[stack.len() - 1].embedding_level
      let ovr = &stack[stack.len() - 1].override_dir
      match ovr
      when BidiClass::L then types[i] = BidiClass::L
      when BidiClass::R then types[i] = BidiClass::R
      when _ then ()
      end
    end
    i = i + 1u64
  end

  ## Steps W1-W7: Resolve weak types
  _bidi_resolve_weak(&mut types, &levels, n)

  ## Steps N1-N2: Resolve neutral and isolate types
  _bidi_resolve_neutral(&mut types, &levels, paragraph_level, n)

  ## Step I1-I2: Resolve implicit levels
  let mut i2 = 0u64
  while i2 < n do
    match types[i2]
    when BidiClass::L then
      if (levels[i2] & 1u32) != 0u32 then
        levels[i2] = levels[i2] + 1u32
      end
    when BidiClass::R then
      if (levels[i2] & 1u32) == 0u32 then
        levels[i2] = levels[i2] + 1u32
      end
    when BidiClass::AN | BidiClass::EN then
      if (levels[i2] & 1u32) == 0u32 then
        levels[i2] = levels[i2] + 2u32
      else
        levels[i2] = levels[i2] + 1u32
      end
    when _ then ()
    end
    i2 = i2 + 1u64
  end

  ## Step L1: Reset levels on line breaks and whitespace at paragraph boundaries
  ## (simplified: reset trailing WS/isolate-initiators/PDI to paragraph level)

  ## Build runs from resolved levels
  let mut run_start = 0u64
  let mut run_level = levels[0]
  let mut ri = 1u64
  while ri < n do
    if levels[ri] != run_level then
      let dir = if (run_level & 1u32) != 0u32 then ScriptDirection::RightToLeft else ScriptDirection::LeftToRight end
      runs.push(BidiRun { start: run_start, length: ri - run_start, direction: dir, embedding_level: run_level })
      run_start = ri
      run_level = levels[ri]
    end
    ri = ri + 1u64
  end
  let final_dir = if (run_level & 1u32) != 0u32 then ScriptDirection::RightToLeft else ScriptDirection::LeftToRight end
  runs.push(BidiRun { start: run_start, length: n - run_start, direction: final_dir, embedding_level: run_level })
  runs
end

## UAX #9 Weak type resolution (W1-W7)
def _bidi_resolve_weak(types: &mut List[BidiClass], levels: &List[u32], n: u64) -> Unit
  let mut prev_strong = BidiClass::ON
  let mut i = 0u64
  while i < n do
    let bc = &types[i]
    ## W1: NSM → type of previous character (or current embedding direction)
    match bc
    when BidiClass::NSM then
      if i > 0u64 then types[i] = types[i - 1u64].clone()
      else types[i] = if (levels[0] & 1u32) != 0u32 then BidiClass::R else BidiClass::L end
      end
    when _ then ()
    end
    ## W2: EN after AL → AN
    match types[i]
    when BidiClass::EN then
      match prev_strong
      when BidiClass::AL then types[i] = BidiClass::AN
      when _ then ()
      end
    when _ then ()
    end
    ## W3: AL → R
    match types[i]
    when BidiClass::AL then types[i] = BidiClass::R
    when _ then ()
    end
    ## Track previous strong type
    if _is_strong(&types[i]) then prev_strong = types[i].clone() end
    i = i + 1u64
  end
  ## W4: ES between EN → EN; CS between matching → matching
  let mut j = 1u64
  while j + 1u64 < n do
    match types[j]
    when BidiClass::ES then
      match (&types[j-1u64], &types[j+1u64])
      when (BidiClass::EN, BidiClass::EN) then types[j] = BidiClass::EN
      when _ then ()
      end
    when BidiClass::CS then
      match (&types[j-1u64], &types[j+1u64])
      when (BidiClass::EN, BidiClass::EN) then types[j] = BidiClass::EN
      when (BidiClass::AN, BidiClass::AN) then types[j] = BidiClass::AN
      when _ then ()
      end
    when _ then ()
    end
    j = j + 1u64
  end
  ## W5: ET adjacent to EN → EN
  let mut k = 0u64
  while k < n do
    match types[k]
    when BidiClass::ET then
      let mut is_adj = false
      if k > 0u64 then match types[k-1u64] when BidiClass::EN then is_adj = true when _ then () end end
      if k + 1u64 < n then match types[k+1u64] when BidiClass::EN then is_adj = true when _ then () end end
      if is_adj then types[k] = BidiClass::EN end
    when _ then ()
    end
    k = k + 1u64
  end
  ## W6: remaining ES, ET, CS → ON
  let mut m = 0u64
  while m < n do
    match types[m]
    when BidiClass::ES | BidiClass::ET | BidiClass::CS then types[m] = BidiClass::ON
    when _ then ()
    end
    m = m + 1u64
  end
  ## W7: EN after L (at same level) → L
  let mut last_strong_l = false
  let mut w = 0u64
  while w < n do
    match types[w]
    when BidiClass::L then last_strong_l = true
    when BidiClass::R then last_strong_l = false
    when BidiClass::EN then
      if last_strong_l then types[w] = BidiClass::L end
    when _ then ()
    end
    w = w + 1u64
  end
end

## UAX #9 Neutral type resolution (N1-N2)
def _bidi_resolve_neutral(types: &mut List[BidiClass], levels: &List[u32], para_level: u32, n: u64) -> Unit
  let mut i = 0u64
  while i < n do
    let bc = &types[i]
    let is_neutral = match bc
    when BidiClass::ON | BidiClass::WS | BidiClass::BN | BidiClass::B | BidiClass::S then true
    when _ then false
    end
    if is_neutral then
      ## Find the preceding strong type (or embedding direction)
      let embed_dir = if (levels[i] & 1u32) != 0u32 then BidiClass::R else BidiClass::L end
      let prev = if i > 0u64 then
        let mut p = i - 1u64
        let mut found = embed_dir.clone()
        while true do
          if _is_strong(&types[p]) || match types[p] when BidiClass::EN | BidiClass::AN then true when _ then false end then
            found = match types[p] when BidiClass::EN | BidiClass::AN then BidiClass::R when _ then types[p].clone() end
            break
          end
          if p == 0u64 then break end
          p = p - 1u64
        end
        found
      else embed_dir.clone() end

      ## Find the following strong type
      let following = {
        let mut f = i + 1u64
        let mut found = embed_dir.clone()
        while f < n do
          if _is_strong(&types[f]) || match types[f] when BidiClass::EN | BidiClass::AN then true when _ then false end then
            found = match types[f] when BidiClass::EN | BidiClass::AN then BidiClass::R when _ then types[f].clone() end
            break
          end
          f = f + 1u64
        end
        found
      }

      ## N1: Between matching strong types → that type
      ## N2: Otherwise → embedding direction
      let resolved = match (&prev, &following)
      when (BidiClass::L, BidiClass::L) then BidiClass::L
      when (BidiClass::R, BidiClass::R) then BidiClass::R
      when _ then embed_dir
      end
      types[i] = resolved
    end
    i = i + 1u64
  end
end

## ---------------------------------------------------------------
## 25.1  Combining marks and grapheme clusters
## ---------------------------------------------------------------

## Check if a codepoint is a combining mark (general category M).
def is_combining_mark(cp: u32) -> Bool
  ## Combining Diacritical Marks: U+0300–U+036F
  ## Combining Marks Extension: U+1AB0–U+1AFF
  ## Combining Half Marks: U+FE20–U+FE2F
  (cp >= 0x0300u32 && cp <= 0x036Fu32) ||
  (cp >= 0x1AB0u32 && cp <= 0x1AFFu32) ||
  (cp >= 0xFE20u32 && cp <= 0xFE2Fu32)
end

## Check if a codepoint is a surrogate (these should never appear in valid UTF-8/32).
def is_surrogate(cp: u32) -> Bool
  cp >= 0xD800u32 && cp <= 0xDFFFu32
end

## Validate grapheme cluster boundary: a combining mark must follow a base character.
def validate_grapheme_sequence(codepoints: List[u32]) -> Bool
  if codepoints.is_empty()
    return true
  end
  ## First codepoint must not be a combining mark
  if is_combining_mark(codepoints.get(0))
    return false
  end
  for cp in codepoints
    if is_surrogate(cp)
      return false
    end
  end
  true
end

## ---------------------------------------------------------------
## 25.1  Line wrapping/justification edge cases
## ---------------------------------------------------------------

enum LineBreakOpportunity
  Mandatory      ## e.g., U+000A
  Allowed        ## soft break between words
  Prohibited     ## e.g., inside a word for most scripts
end

def classify_break(cp: u32) -> LineBreakOpportunity
  match cp
  when 0x000Au32  ## LF
    LineBreakOpportunity::Mandatory
  when 0x000Du32  ## CR
    LineBreakOpportunity::Mandatory
  when 0x0020u32  ## Space
    LineBreakOpportunity::Allowed
  when 0x00ADu32  ## Soft hyphen
    LineBreakOpportunity::Allowed
  when 0x200Bu32  ## Zero-width space
    LineBreakOpportunity::Allowed
  else
    LineBreakOpportunity::Prohibited
  end
end

## ---------------------------------------------------------------
## Tests
## ---------------------------------------------------------------

test "LTR detection for Latin" do
  let dir = detect_direction(0x0041u32)  ## 'A'
  assert dir == ScriptDirection::LeftToRight
end

test "RTL detection for Arabic" do
  let dir = detect_direction(0x0627u32)  ## Arabic Alef
  assert dir == ScriptDirection::RightToLeft
end

test "RTL detection for Hebrew" do
  let dir = detect_direction(0x05D0u32)  ## Hebrew Alef
  assert dir == ScriptDirection::RightToLeft
end

test "bidi run splitting" do
  ## "Hello" (LTR) + Arabic text (RTL) would produce 2 runs
  let runs = split_bidi_runs("Hello")
  assert runs.len() == 1
  assert runs.get(0).direction == ScriptDirection::LeftToRight
end

test "combining mark at start is invalid" do
  let cps = List.of(0x0301u32)  ## Combining acute accent alone
  assert !validate_grapheme_sequence(cps)
end

test "combining mark after base is valid" do
  let cps = List.of(0x0065u32, 0x0301u32)  ## e + combining acute
  assert validate_grapheme_sequence(cps)
end

test "surrogate codepoints are invalid" do
  let cps = List.of(0xD800u32)
  assert !validate_grapheme_sequence(cps)
end

test "line break classification" do
  assert classify_break(0x000Au32) == LineBreakOpportunity::Mandatory
  assert classify_break(0x0020u32) == LineBreakOpportunity::Allowed
  assert classify_break(0x0041u32) == LineBreakOpportunity::Prohibited
end
