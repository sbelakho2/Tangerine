# Tangerine Standard Library — Snapshots and Replay
#
# Deterministic execution recording and replay for debugging.
# Part of the agent-first tooling for LLM-friendly debugging.
#
# Usage:
#   let recorder = Recorder::new("session.replay")
#   recorder.start()
#   # ... program execution ...
#   recorder.stop()
#
#   let player = Player::new("session.replay")
#   player.play()

use std::core::{Option, Result, Vec, String, Bool, Int, UInt}
use std::collections::{Map, Set}
use std::fs::{File, OpenOptions}
use std::io::{Read, Write, BufReader, BufWriter}
use std::time::{Instant, Duration, SystemTime}
use std::serde::{Serialize, Deserialize}
use std::json::{Json, JsonValue}

# ═══════════════════════════════════════════════════════════════
# PART 1: EVENTS
# ═══════════════════════════════════════════════════════════════

# ———————————————————————————————————————————————————————————————
# Event Types
# ———————————————————————————————————————————————————————————————

enum Event
  # Program flow
  FunctionEntry(FunctionEntryEvent)
  FunctionExit(FunctionExitEvent)
  
  # Memory operations
  Allocation(AllocationEvent)
  Deallocation(DeallocationEvent)
  MemoryWrite(MemoryWriteEvent)
  MemoryRead(MemoryReadEvent)
  
  # I/O operations
  FileOpen(FileOpenEvent)
  FileRead(FileReadEvent)
  FileWrite(FileWriteEvent)
  FileClose(FileCloseEvent)
  
  # Network operations
  NetConnect(NetConnectEvent)
  NetSend(NetSendEvent)
  NetRecv(NetRecvEvent)
  NetClose(NetCloseEvent)
  
  # System calls
  Syscall(SyscallEvent)
  
  # Randomness
  RandomBytes(RandomBytesEvent)
  
  # Timing
  ClockRead(ClockReadEvent)
  
  # Thread operations
  ThreadSpawn(ThreadSpawnEvent)
  ThreadJoin(ThreadJoinEvent)
  
  # User-defined checkpoints
  Checkpoint(CheckpointEvent)
  
  # Snapshot
  Snapshot(SnapshotEvent)
end

struct FunctionEntryEvent
  timestamp: u64
  thread_id: u64
  function_name: String
  module: String
  args: Vec[SerializedValue]
  source_loc: SourceLocation
end

struct FunctionExitEvent
  timestamp: u64
  thread_id: u64
  function_name: String
  return_value: Option[SerializedValue]
  duration_ns: u64
end

struct AllocationEvent
  timestamp: u64
  thread_id: u64
  address: u64
  size: UInt
  alignment: UInt
  backtrace: Vec[StackFrame]
end

struct DeallocationEvent
  timestamp: u64
  thread_id: u64
  address: u64
end

struct MemoryWriteEvent
  timestamp: u64
  thread_id: u64
  address: u64
  old_value: Vec[u8]
  new_value: Vec[u8]
end

struct MemoryReadEvent
  timestamp: u64
  thread_id: u64
  address: u64
  value: Vec[u8]
end

struct FileOpenEvent
  timestamp: u64
  thread_id: u64
  fd: i32
  path: String
  flags: u32
  mode: u32
end

struct FileReadEvent
  timestamp: u64
  thread_id: u64
  fd: i32
  data: Vec[u8]
  offset: i64
end

struct FileWriteEvent
  timestamp: u64
  thread_id: u64
  fd: i32
  data: Vec[u8]
  offset: i64
end

struct FileCloseEvent
  timestamp: u64
  thread_id: u64
  fd: i32
end

struct NetConnectEvent
  timestamp: u64
  thread_id: u64
  socket_id: u64
  remote_addr: String
  remote_port: u16
  local_port: u16
end

struct NetSendEvent
  timestamp: u64
  thread_id: u64
  socket_id: u64
  data: Vec[u8]
end

struct NetRecvEvent
  timestamp: u64
  thread_id: u64
  socket_id: u64
  data: Vec[u8]
end

struct NetCloseEvent
  timestamp: u64
  thread_id: u64
  socket_id: u64
end

struct SyscallEvent
  timestamp: u64
  thread_id: u64
  syscall_num: i32
  args: Vec[u64]
  result: i64
end

struct RandomBytesEvent
  timestamp: u64
  thread_id: u64
  bytes: Vec[u8]
end

struct ClockReadEvent
  timestamp: u64
  thread_id: u64
  clock_type: ClockType
  value: u64
end

enum ClockType
  Realtime
  Monotonic
  ProcessCpu
  ThreadCpu
end

struct ThreadSpawnEvent
  timestamp: u64
  parent_thread_id: u64
  child_thread_id: u64
  entry_point: String
end

struct ThreadJoinEvent
  timestamp: u64
  thread_id: u64
  joined_thread_id: u64
end

struct CheckpointEvent
  timestamp: u64
  thread_id: u64
  name: String
  data: Map[String, SerializedValue]
end

struct SnapshotEvent
  timestamp: u64
  thread_id: u64
  heap_snapshot: HeapSnapshot
  stack_snapshot: Vec[StackSnapshot]
  register_state: RegisterState
end

# ———————————————————————————————————————————————————————————————
# Support Types
# ———————————————————————————————————————————————————————————————

struct SourceLocation
  file: String
  line: u32
  column: u32
end

impl SourceLocation
  def unknown() -> SourceLocation
    SourceLocation { file: "<unknown>".to_string(), line: 0, column: 0 }
  end
end

struct StackFrame
  function_name: String
  module: String
  source_loc: SourceLocation
  address: u64
end

struct SerializedValue
  type_name: String
  data: Vec[u8]
  json_repr: Option[String]
end

impl SerializedValue
  def from_json(value: &JsonValue, type_name: &str) -> SerializedValue
    SerializedValue {
      type_name: type_name.to_string(),
      data: Vec::new(),
      json_repr: Option::Some(Json::stringify(value))
    }
  end
  
  def from_bytes(data: &[u8], type_name: &str) -> SerializedValue
    SerializedValue {
      type_name: type_name.to_string(),
      data: data.to_vec(),
      json_repr: Option::None
    }
  end
  
  def to_json(self: &SerializedValue) -> Option[JsonValue]
    self.json_repr.as_ref().and_then(|s| Json::parse_value(s).ok())
  end
end

struct HeapSnapshot
  allocations: Vec[AllocationRecord]
  total_allocated: UInt
  total_freed: UInt
end

struct AllocationRecord
  address: u64
  size: UInt
  data: Vec[u8]
  backtrace: Vec[StackFrame]
end

struct StackSnapshot
  thread_id: u64
  frames: Vec[StackFrameData]
end

struct StackFrameData
  function_name: String
  locals: Map[String, SerializedValue]
  source_loc: SourceLocation
end

struct RegisterState
  general_purpose: Map[String, u64]
  floating_point: Map[String, f64]
  flags: u64
end

# ═══════════════════════════════════════════════════════════════
# PART 2: RECORDING
# ═══════════════════════════════════════════════════════════════

enum RecorderError
  IoError(String)
  SerializationError(String)
  AlreadyRecording
  NotRecording
end

struct RecorderConfig
  output_path: String
  buffer_size: UInt
  compression: Bool
  record_memory: Bool
  record_syscalls: Bool
  sample_rate: f64
end

impl RecorderConfig
  def default(path: &str) -> RecorderConfig
    RecorderConfig {
      output_path: path.to_string(),
      buffer_size: 1024 * 1024,  # 1MB buffer
      compression: true,
      record_memory: false,       # Expensive, off by default
      record_syscalls: true,
      sample_rate: 1.0           # Record everything
    }
  end
  
  def with_memory(self: RecorderConfig) -> RecorderConfig
    RecorderConfig { record_memory: true, ..self }
  end
  
  def with_sampling(self: RecorderConfig, rate: f64) -> RecorderConfig
    RecorderConfig { sample_rate: rate.clamp(0.0, 1.0), ..self }
  end
end

struct Recorder
  config: RecorderConfig
  output: Option[BufWriter[File]]
  event_count: u64
  start_time: Option[Instant]
  is_recording: Bool
  buffer: Vec[Event]
end

impl Recorder
  def new(path: &str) -> Recorder
    Recorder::with_config(RecorderConfig::default(path))
  end
  
  def with_config(config: RecorderConfig) -> Recorder
    Recorder {
      config: config,
      output: Option::None,
      event_count: 0,
      start_time: Option::None,
      is_recording: false,
      buffer: Vec::with_capacity(1024)
    }
  end
  
  def start(self: &mut Recorder) -> Result[Unit, RecorderError]
    if self.is_recording then
      return Result::Err(RecorderError::AlreadyRecording)
    end
    
    let file = File::create(&self.config.output_path)
      .map_err(|e| RecorderError::IoError(e.to_string()))?
    
    self.output = Option::Some(BufWriter::new(file))
    self.start_time = Option::Some(Instant::now())
    self.is_recording = true
    self.event_count = 0
    
    # Write header
    self.write_header()?;
    
    Result::Ok(())
  end
  
  def stop(self: &mut Recorder) -> Result[RecordingStats, RecorderError]
    if !self.is_recording then
      return Result::Err(RecorderError::NotRecording)
    end
    
    # Flush remaining events
    self.flush()?;
    
    let stats = RecordingStats {
      event_count: self.event_count,
      duration: self.start_time.unwrap().elapsed(),
      file_size: std::fs::metadata(&self.config.output_path)
        .map(|m| m.len())
        .unwrap_or(0)
    }
    
    self.is_recording = false
    self.output = Option::None
    self.start_time = Option::None
    
    Result::Ok(stats)
  end
  
  def record(self: &mut Recorder, event: Event) -> Result[Unit, RecorderError]
    if !self.is_recording then
      return Result::Err(RecorderError::NotRecording)
    end
    
    # Sampling
    if self.config.sample_rate < 1.0 then
      let rand_val = (self.event_count as f64 * 31.415926) % 1.0
      if rand_val > self.config.sample_rate then
        return Result::Ok(())
      end
    end
    
    self.buffer.push(event)
    self.event_count = self.event_count + 1
    
    if self.buffer.len() >= self.config.buffer_size / 128 then
      self.flush()?
    end
    
    Result::Ok(())
  end
  
  def checkpoint(self: &mut Recorder, name: &str, data: Map[String, SerializedValue]) -> Result[Unit, RecorderError]
    let event = Event::Checkpoint(CheckpointEvent {
      timestamp: self.current_timestamp(),
      thread_id: current_thread_id(),
      name: name.to_string(),
      data: data
    })
    
    self.record(event)
  end
  
  def snapshot(self: &mut Recorder) -> Result[Unit, RecorderError]
    let heap_snapshot = capture_heap_snapshot()
    let stack_snapshot = capture_stack_snapshots()
    let register_state = capture_register_state()
    
    let event = Event::Snapshot(SnapshotEvent {
      timestamp: self.current_timestamp(),
      thread_id: current_thread_id(),
      heap_snapshot: heap_snapshot,
      stack_snapshot: stack_snapshot,
      register_state: register_state
    })
    
    self.record(event)
  end
  
  def record_function_entry(self: &mut Recorder, name: &str, module: &str,
      args: Vec[SerializedValue], loc: SourceLocation) -> Result[Unit, RecorderError]
    let event = Event::FunctionEntry(FunctionEntryEvent {
      timestamp: self.current_timestamp(),
      thread_id: current_thread_id(),
      function_name: name.to_string(),
      module: module.to_string(),
      args: args,
      source_loc: loc
    })
    
    self.record(event)
  end
  
  def record_function_exit(self: &mut Recorder, name: &str,
      ret: Option[SerializedValue], duration_ns: u64) -> Result[Unit, RecorderError]
    let event = Event::FunctionExit(FunctionExitEvent {
      timestamp: self.current_timestamp(),
      thread_id: current_thread_id(),
      function_name: name.to_string(),
      return_value: ret,
      duration_ns: duration_ns
    })
    
    self.record(event)
  end
  
  def record_file_read(self: &mut Recorder, fd: i32, data: &[u8], offset: i64) -> Result[Unit, RecorderError]
    let event = Event::FileRead(FileReadEvent {
      timestamp: self.current_timestamp(),
      thread_id: current_thread_id(),
      fd: fd,
      data: data.to_vec(),
      offset: offset
    })
    
    self.record(event)
  end
  
  def record_file_write(self: &mut Recorder, fd: i32, data: &[u8], offset: i64) -> Result[Unit, RecorderError]
    let event = Event::FileWrite(FileWriteEvent {
      timestamp: self.current_timestamp(),
      thread_id: current_thread_id(),
      fd: fd,
      data: data.to_vec(),
      offset: offset
    })
    
    self.record(event)
  end
  
  def record_random_bytes(self: &mut Recorder, bytes: &[u8]) -> Result[Unit, RecorderError]
    let event = Event::RandomBytes(RandomBytesEvent {
      timestamp: self.current_timestamp(),
      thread_id: current_thread_id(),
      bytes: bytes.to_vec()
    })
    
    self.record(event)
  end
  
  def record_net_recv(self: &mut Recorder, socket_id: u64, data: &[u8]) -> Result[Unit, RecorderError]
    let event = Event::NetRecv(NetRecvEvent {
      timestamp: self.current_timestamp(),
      thread_id: current_thread_id(),
      socket_id: socket_id,
      data: data.to_vec()
    })
    
    self.record(event)
  end
  
  fn flush(self: &mut Recorder) -> Result[Unit, RecorderError]
    if let Option::Some(ref mut writer) = self.output then
      for event in &self.buffer do
        let serialized = serialize_event(event)?
        writer.write_all(&serialized)
          .map_err(|e| RecorderError::IoError(e.to_string()))?
      end
      writer.flush()
        .map_err(|e| RecorderError::IoError(e.to_string()))?
    end
    
    self.buffer.clear()
    Result::Ok(())
  end
  
  fn write_header(self: &mut Recorder) -> Result[Unit, RecorderError]
    let header = RecordingHeader {
      magic: RECORDING_MAGIC,
      version: RECORDING_VERSION,
      timestamp: SystemTime::now().duration_since_epoch().as_secs(),
      config_json: Json::stringify(&self.config)
    }
    
    if let Option::Some(ref mut writer) = self.output then
      let serialized = serialize_header(&header)?
      writer.write_all(&serialized)
        .map_err(|e| RecorderError::IoError(e.to_string()))?
    end
    
    Result::Ok(())
  end
  
  fn current_timestamp(self: &Recorder) -> u64
    self.start_time
      .map(|t| t.elapsed().as_nanos() as u64)
      .unwrap_or(0)
  end
end

struct RecordingStats
  event_count: u64
  duration: Duration
  file_size: u64
end

const RECORDING_MAGIC: u32 = 0x54475250  # "TGRP" - Tangerine Replay
const RECORDING_VERSION: u32 = 1

struct RecordingHeader
  magic: u32
  version: u32
  timestamp: u64
  config_json: String
end

# ═══════════════════════════════════════════════════════════════
# PART 3: REPLAY
# ═══════════════════════════════════════════════════════════════

enum PlayerError
  IoError(String)
  InvalidFormat(String)
  VersionMismatch(u32, u32)
  EventMismatch(String)
  EndOfRecording
end

struct PlayerConfig
  input_path: String
  verify_determinism: Bool
  breakpoints: Vec[Breakpoint]
  skip_io: Bool
end

impl PlayerConfig
  def default(path: &str) -> PlayerConfig
    PlayerConfig {
      input_path: path.to_string(),
      verify_determinism: true,
      breakpoints: Vec::new(),
      skip_io: false
    }
  end
end

struct Breakpoint
  condition: BreakpointCondition
  action: BreakpointAction
end

enum BreakpointCondition
  EventCount(u64)
  Timestamp(u64)
  FunctionEntry(String)
  FunctionExit(String)
  Checkpoint(String)
  MemoryAddress(u64)
end

enum BreakpointAction
  Pause
  Snapshot
  Log
  Custom(fn(&Event) -> Unit)
end

struct Player
  config: PlayerConfig
  input: Option[BufReader[File]]
  header: Option[RecordingHeader]
  event_count: u64
  current_timestamp: u64
  state: PlayerState
  event_queue: Vec[Event]
  io_responses: Map[u64, Vec[u8]]
end

enum PlayerState
  Stopped
  Playing
  Paused
  Finished
end

impl Player
  # Convenience constructor that opens the recording file immediately.
  # Equivalent to `Player::with_config(PlayerConfig::default(path)).open()`.
  def new(path: &str) -> Result[Player, PlayerError]
    let mut player = Player::with_config(PlayerConfig::default(path))
    player.open()?
    Result::Ok(player)
  end
  
  def with_config(config: PlayerConfig) -> Player
    Player {
      config: config,
      input: Option::None,
      header: Option::None,
      event_count: 0,
      current_timestamp: 0,
      state: PlayerState::Stopped,
      event_queue: Vec::new(),
      io_responses: Map::new()
    }
  end
  
  def open(self: &mut Player) -> Result[Unit, PlayerError]
    let file = File::open(&self.config.input_path)
      .map_err(|e| PlayerError::IoError(e.to_string()))?
    
    let mut reader = BufReader::new(file)
    
    # Read header
    let header = read_header(&mut reader)?
    
    if header.magic != RECORDING_MAGIC then
      return Result::Err(PlayerError::InvalidFormat("invalid magic number"))
    end
    
    if header.version != RECORDING_VERSION then
      return Result::Err(PlayerError::VersionMismatch(header.version, RECORDING_VERSION))
    end
    
    self.header = Option::Some(header)
    self.input = Option::Some(reader)
    
    Result::Ok(())
  end
  
  def play(self: &mut Player) -> Result[Unit, PlayerError]
    self.state = PlayerState::Playing
    
    while self.state == PlayerState::Playing do
      match self.next_event()
      when Result::Ok(event) then
        self.process_event(&event)?
        self.check_breakpoints(&event)
      when Result::Err(PlayerError::EndOfRecording) then
        self.state = PlayerState::Finished
      when Result::Err(e) then
        return Result::Err(e)
      end
    end
    
    Result::Ok(())
  end
  
  def step(self: &mut Player) -> Result[Event, PlayerError]
    let event = self.next_event()?
    self.process_event(&event)?
    Result::Ok(event)
  end
  
  def step_over(self: &mut Player) -> Result[Event, PlayerError]
    # Step over function calls
    let event = self.next_event()?
    
    if let Event::FunctionEntry(ref entry) = event then
      let target_func = entry.function_name.clone()
      let mut depth = 1
      
      while depth > 0 do
        let next = self.next_event()?
        match &next
        when Event::FunctionEntry(e) then
          if e.function_name == target_func then
            depth = depth + 1
          end
        when Event::FunctionExit(e) then
          if e.function_name == target_func then
            depth = depth - 1
          end
        when _ then ()
        end
        self.process_event(&next)?
      end
    else
      self.process_event(&event)?
    end
    
    Result::Ok(event)
  end
  
  def seek_to_timestamp(self: &mut Player, target_ns: u64) -> Result[Unit, PlayerError]
    while self.current_timestamp < target_ns do
      match self.next_event()
      when Result::Ok(event) then
        self.process_event(&event)?
      when Result::Err(PlayerError::EndOfRecording) then
        return Result::Ok(())
      when Result::Err(e) then
        return Result::Err(e)
      end
    end
    
    Result::Ok(())
  end
  
  def seek_to_checkpoint(self: &mut Player, name: &str) -> Result[Unit, PlayerError]
    loop
      match self.next_event()
      when Result::Ok(Event::Checkpoint(ref cp)) then
        if cp.name == name then
          return Result::Ok(())
        end
      when Result::Ok(event) then
        self.process_event(&event)?
      when Result::Err(PlayerError::EndOfRecording) then
        return Result::Err(PlayerError::InvalidFormat("checkpoint '".to_string() + name + "' not found"))
      when Result::Err(e) then
        return Result::Err(e)
      end
    end
  end
  
  def pause(self: &mut Player) -> Unit
    self.state = PlayerState::Paused
  end
  
  def resume(self: &mut Player) -> Unit
    if self.state == PlayerState::Paused then
      self.state = PlayerState::Playing
    end
  end
  
  def get_recorded_io_response(self: &mut Player, event_id: u64) -> Option[Vec[u8]]
    self.io_responses.remove(&event_id)
  end
  
  fn next_event(self: &mut Player) -> Result[Event, PlayerError]
    if !self.event_queue.is_empty() then
      return Result::Ok(self.event_queue.remove(0))
    end
    
    if let Option::Some(ref mut reader) = self.input then
      read_event(reader)
    else
      Result::Err(PlayerError::IoError("player not opened"))
    end
  end
  
  fn process_event(self: &mut Player, event: &Event) -> Result[Unit, PlayerError]
    self.event_count = self.event_count + 1
    
    # Update timestamp
    let ts = event_timestamp(event)
    self.current_timestamp = ts
    
    # Store I/O responses for replay
    match event
    when Event::FileRead(e) then
      self.io_responses.insert(e.timestamp, e.data.clone())
    when Event::NetRecv(e) then
      self.io_responses.insert(e.timestamp, e.data.clone())
    when Event::RandomBytes(e) then
      self.io_responses.insert(e.timestamp, e.bytes.clone())
    when _ then ()
    end
    
    Result::Ok(())
  end
  
  fn check_breakpoints(self: &mut Player, event: &Event) -> Unit
    for bp in &self.config.breakpoints do
      let hit = match &bp.condition
      when BreakpointCondition::EventCount(n) then self.event_count == *n
      when BreakpointCondition::Timestamp(t) then self.current_timestamp >= *t
      when BreakpointCondition::FunctionEntry(name) then
        if let Event::FunctionEntry(e) = event then
          &e.function_name == name
        else
          false
        end
      when BreakpointCondition::FunctionExit(name) then
        if let Event::FunctionExit(e) = event then
          &e.function_name == name
        else
          false
        end
      when BreakpointCondition::Checkpoint(name) then
        if let Event::Checkpoint(e) = event then
          &e.name == name
        else
          false
        end
      when BreakpointCondition::MemoryAddress(addr) then
        if let Event::MemoryWrite(e) = event then
          e.address == *addr
        else
          false
        end
      end
      
      if hit then
        match &bp.action
        when BreakpointAction::Pause then self.pause()
        when BreakpointAction::Snapshot then ()  # Would trigger snapshot
        when BreakpointAction::Log then
          # Log the event
          ()
        when BreakpointAction::Custom(f) then f(event)
        end
      end
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 4: ANALYSIS
# ═══════════════════════════════════════════════════════════════

struct ReplayAnalyzer
  events: Vec[Event]
  call_graph: CallGraph
  memory_timeline: MemoryTimeline
  io_timeline: IoTimeline
end

impl ReplayAnalyzer
  def load(path: &str) -> Result[ReplayAnalyzer, PlayerError]
    let mut player = Player::new(path)
    player.open()?
    
    let mut events = Vec::new()
    
    loop
      match player.step()
      when Result::Ok(event) then events.push(event)
      when Result::Err(PlayerError::EndOfRecording) then break
      when Result::Err(e) then return Result::Err(e)
      end
    end
    
    let call_graph = build_call_graph(&events)
    let memory_timeline = build_memory_timeline(&events)
    let io_timeline = build_io_timeline(&events)
    
    Result::Ok(ReplayAnalyzer {
      events: events,
      call_graph: call_graph,
      memory_timeline: memory_timeline,
      io_timeline: io_timeline
    })
  end
  
  def find_events_by_function(self: &ReplayAnalyzer, name: &str) -> Vec[&Event]
    self.events.iter().filter(|e| {
      match e
      when Event::FunctionEntry(entry) then &entry.function_name == name
      when Event::FunctionExit(exit) then &exit.function_name == name
      when _ then false
      end
    }).collect()
  end
  
  def find_checkpoints(self: &ReplayAnalyzer) -> Vec[(&CheckpointEvent, u64)]
    let mut result = Vec::new()
    let mut idx = 0u64
    
    for event in &self.events do
      if let Event::Checkpoint(cp) = event then
        result.push((cp, idx))
      end
      idx = idx + 1
    end
    
    result
  end
  
  def hot_functions(self: &ReplayAnalyzer) -> Vec[(String, u64, Duration)]
    self.call_graph.hot_functions()
  end
  
  def memory_peak(self: &ReplayAnalyzer) -> (u64, UInt)
    self.memory_timeline.peak()
  end
  
  def io_summary(self: &ReplayAnalyzer) -> IoSummary
    self.io_timeline.summary()
  end
  
  def diff(self: &ReplayAnalyzer, other: &ReplayAnalyzer) -> ReplayDiff
    compare_replays(&self.events, &other.events)
  end
end

struct CallGraph
  nodes: Map[String, CallGraphNode]
  edges: Vec[(String, String, u64)]
end

struct CallGraphNode
  function_name: String
  call_count: u64
  total_time_ns: u64
  self_time_ns: u64
end

impl CallGraph
  def hot_functions(self: &CallGraph) -> Vec[(String, u64, Duration)]
    let mut funcs: Vec[_] = self.nodes.iter()
      .map(|(name, node)| (name.clone(), node.call_count, Duration::from_nanos(node.total_time_ns)))
      .collect()
    
    funcs.sort_by(|a, b| b.2.cmp(&a.2))
    funcs
  end
end

struct MemoryTimeline
  samples: Vec[(u64, UInt)]  # (timestamp, allocated bytes)
  peak_timestamp: u64
  peak_bytes: UInt
end

impl MemoryTimeline
  def peak(self: &MemoryTimeline) -> (u64, UInt)
    (self.peak_timestamp, self.peak_bytes)
  end
end

struct IoTimeline
  file_ops: Vec[IoOp]
  net_ops: Vec[IoOp]
end

struct IoOp
  timestamp: u64
  op_type: String
  bytes: UInt
end

struct IoSummary
  total_file_reads: UInt
  total_file_writes: UInt
  total_net_sends: UInt
  total_net_recvs: UInt
  total_bytes_read: UInt
  total_bytes_written: UInt
end

impl IoTimeline
  def summary(self: &IoTimeline) -> IoSummary
    let mut summary = IoSummary {
      total_file_reads: 0,
      total_file_writes: 0,
      total_net_sends: 0,
      total_net_recvs: 0,
      total_bytes_read: 0,
      total_bytes_written: 0
    }
    
    for op in &self.file_ops do
      match op.op_type.as_str()
      when "read" then
        summary.total_file_reads = summary.total_file_reads + 1
        summary.total_bytes_read = summary.total_bytes_read + op.bytes
      when "write" then
        summary.total_file_writes = summary.total_file_writes + 1
        summary.total_bytes_written = summary.total_bytes_written + op.bytes
      when _ then ()
      end
    end
    
    for op in &self.net_ops do
      match op.op_type.as_str()
      when "send" then
        summary.total_net_sends = summary.total_net_sends + 1
        summary.total_bytes_written = summary.total_bytes_written + op.bytes
      when "recv" then
        summary.total_net_recvs = summary.total_net_recvs + 1
        summary.total_bytes_read = summary.total_bytes_read + op.bytes
      when _ then ()
      end
    end
    
    summary
  end
end

struct ReplayDiff
  divergence_point: Option[u64]
  event_differences: Vec[EventDiff]
  call_graph_diff: CallGraphDiff
end

struct EventDiff
  index: u64
  expected: String
  actual: String
end

struct CallGraphDiff
  added_functions: Vec[String]
  removed_functions: Vec[String]
  changed_counts: Vec[(String, u64, u64)]
end

# ═══════════════════════════════════════════════════════════════
# PART 5: HELPER FUNCTIONS
# ═══════════════════════════════════════════════════════════════

def current_thread_id() -> u64
  # Platform-specific thread ID
  extern "C" def pthread_self() -> u64
  pthread_self()
end

def capture_heap_snapshot() -> HeapSnapshot
  # Would walk the heap and capture all allocations
  HeapSnapshot {
    allocations: Vec::new(),
    total_allocated: 0,
    total_freed: 0
  }
end

def capture_stack_snapshots() -> Vec[StackSnapshot]
  # Would capture stack state for all threads
  Vec::new()
end

def capture_register_state() -> RegisterState
  RegisterState {
    general_purpose: Map::new(),
    floating_point: Map::new(),
    flags: 0
  }
end

def serialize_event(event: &Event) -> Result[Vec[u8], RecorderError]
  let json = Json::stringify(event)
  let mut bytes = Vec::new()
  
  # Length-prefixed format
  let len = json.len() as u32
  bytes.extend(&len.to_le_bytes())
  bytes.extend(json.as_bytes())
  
  Result::Ok(bytes)
end

def serialize_header(header: &RecordingHeader) -> Result[Vec[u8], RecorderError]
  let mut bytes = Vec::new()
  
  bytes.extend(&header.magic.to_le_bytes())
  bytes.extend(&header.version.to_le_bytes())
  bytes.extend(&header.timestamp.to_le_bytes())
  
  let config_bytes = header.config_json.as_bytes()
  let config_len = config_bytes.len() as u32
  bytes.extend(&config_len.to_le_bytes())
  bytes.extend(config_bytes)
  
  Result::Ok(bytes)
end

def read_header(reader: &mut BufReader[File]) -> Result[RecordingHeader, PlayerError]
  let mut buf = [0u8; 4]
  
  reader.read_exact(&mut buf).map_err(|e| PlayerError::IoError(e.to_string()))?
  let magic = u32::from_le_bytes(buf)
  
  reader.read_exact(&mut buf).map_err(|e| PlayerError::IoError(e.to_string()))?
  let version = u32::from_le_bytes(buf)
  
  let mut buf8 = [0u8; 8]
  reader.read_exact(&mut buf8).map_err(|e| PlayerError::IoError(e.to_string()))?
  let timestamp = u64::from_le_bytes(buf8)
  
  reader.read_exact(&mut buf).map_err(|e| PlayerError::IoError(e.to_string()))?
  let config_len = u32::from_le_bytes(buf) as UInt
  
  let mut config_bytes = Vec::new()
  mut i = 0
  while i < config_len do
    config_bytes.push(0u8)
    i = i + 1
  end
  reader.read_exact(&mut config_bytes).map_err(|e| PlayerError::IoError(e.to_string()))?
  let config_json = String::from_utf8(config_bytes)
    .map_err(|_| PlayerError::InvalidFormat("invalid UTF-8 in config"))?
  
  Result::Ok(RecordingHeader {
    magic: magic,
    version: version,
    timestamp: timestamp,
    config_json: config_json
  })
end

def read_event(reader: &mut BufReader[File]) -> Result[Event, PlayerError]
  let mut len_buf = [0u8; 4]
  
  match reader.read_exact(&mut len_buf)
  when Result::Ok(_) then ()
  when Result::Err(_) then return Result::Err(PlayerError::EndOfRecording)
  end
  
  let len = u32::from_le_bytes(len_buf) as UInt
  
  let mut event_bytes = Vec::new()
  mut j = 0
  while j < len do
    event_bytes.push(0u8)
    j = j + 1
  end
  reader.read_exact(&mut event_bytes)
    .map_err(|e| PlayerError::IoError(e.to_string()))?
  
  let event_json = String::from_utf8(event_bytes)
    .map_err(|_| PlayerError::InvalidFormat("invalid UTF-8 in event"))?
  
  Json::parse::<Event>(&event_json)
    .map_err(|e| PlayerError::InvalidFormat("invalid event JSON: ".to_string() + e.to_string()))
end

def event_timestamp(event: &Event) -> u64
  match event
  when Event::FunctionEntry(e) then e.timestamp
  when Event::FunctionExit(e) then e.timestamp
  when Event::Allocation(e) then e.timestamp
  when Event::Deallocation(e) then e.timestamp
  when Event::MemoryWrite(e) then e.timestamp
  when Event::MemoryRead(e) then e.timestamp
  when Event::FileOpen(e) then e.timestamp
  when Event::FileRead(e) then e.timestamp
  when Event::FileWrite(e) then e.timestamp
  when Event::FileClose(e) then e.timestamp
  when Event::NetConnect(e) then e.timestamp
  when Event::NetSend(e) then e.timestamp
  when Event::NetRecv(e) then e.timestamp
  when Event::NetClose(e) then e.timestamp
  when Event::Syscall(e) then e.timestamp
  when Event::RandomBytes(e) then e.timestamp
  when Event::ClockRead(e) then e.timestamp
  when Event::ThreadSpawn(e) then e.timestamp
  when Event::ThreadJoin(e) then e.timestamp
  when Event::Checkpoint(e) then e.timestamp
  when Event::Snapshot(e) then e.timestamp
  end
end

def build_call_graph(events: &[Event]) -> CallGraph
  let mut nodes = Map::new()
  let mut edges = Vec::new()
  let mut call_stack: Vec[(String, u64)] = Vec::new()
  
  for event in events do
    match event
    when Event::FunctionEntry(e) then
      let node = nodes.entry(e.function_name.clone())
        .or_insert(CallGraphNode {
          function_name: e.function_name.clone(),
          call_count: 0,
          total_time_ns: 0,
          self_time_ns: 0
        })
      node.call_count = node.call_count + 1
      
      if let Option::Some((caller, _)) = call_stack.last() then
        edges.push((caller.clone(), e.function_name.clone(), e.timestamp))
      end
      
      call_stack.push((e.function_name.clone(), e.timestamp))
    when Event::FunctionExit(e) then
      if let Option::Some((name, start)) = call_stack.pop() then
        if let Option::Some(node) = nodes.get_mut(&name) then
          node.total_time_ns = node.total_time_ns + e.duration_ns
        end
      end
    when _ then ()
    end
  end
  
  CallGraph { nodes: nodes, edges: edges }
end

def build_memory_timeline(events: &[Event]) -> MemoryTimeline
  let mut samples = Vec::new()
  let mut current_allocated = 0usize
  let mut peak_bytes = 0usize
  let mut peak_timestamp = 0u64
  
  for event in events do
    match event
    when Event::Allocation(e) then
      current_allocated = current_allocated + e.size
      samples.push((e.timestamp, current_allocated))
      
      if current_allocated > peak_bytes then
        peak_bytes = current_allocated
        peak_timestamp = e.timestamp
      end
    when Event::Deallocation(e) then
      # Would need to track sizes by address
      samples.push((e.timestamp, current_allocated))
    when _ then ()
    end
  end
  
  MemoryTimeline {
    samples: samples,
    peak_timestamp: peak_timestamp,
    peak_bytes: peak_bytes
  }
end

def build_io_timeline(events: &[Event]) -> IoTimeline
  let mut file_ops = Vec::new()
  let mut net_ops = Vec::new()
  
  for event in events do
    match event
    when Event::FileRead(e) then
      file_ops.push(IoOp {
        timestamp: e.timestamp,
        op_type: "read".to_string(),
        bytes: e.data.len()
      })
    when Event::FileWrite(e) then
      file_ops.push(IoOp {
        timestamp: e.timestamp,
        op_type: "write".to_string(),
        bytes: e.data.len()
      })
    when Event::NetSend(e) then
      net_ops.push(IoOp {
        timestamp: e.timestamp,
        op_type: "send".to_string(),
        bytes: e.data.len()
      })
    when Event::NetRecv(e) then
      net_ops.push(IoOp {
        timestamp: e.timestamp,
        op_type: "recv".to_string(),
        bytes: e.data.len()
      })
    when _ then ()
    end
  end
  
  IoTimeline { file_ops: file_ops, net_ops: net_ops }
end

def compare_replays(a: &[Event], b: &[Event]) -> ReplayDiff
  let mut differences = Vec::new()
  let mut divergence = Option::None
  
  let len = a.len().min(b.len())
  
  for i in 0..len do
    let ts_a = event_timestamp(&a[i])
    let ts_b = event_timestamp(&b[i])
    
    # Simple comparison - could be more sophisticated
    if ts_a != ts_b then
      if divergence.is_none() then
        divergence = Option::Some(i as u64)
      end
      differences.push(EventDiff {
        index: i as u64,
        expected: Json::stringify(&a[i]),
        actual: Json::stringify(&b[i])
      })
    end
  end
  
  ReplayDiff {
    divergence_point: divergence,
    event_differences: differences,
    call_graph_diff: CallGraphDiff {
      added_functions: Vec::new(),
      removed_functions: Vec::new(),
      changed_counts: Vec::new()
    }
  }
end

# ═══════════════════════════════════════════════════════════════
# PART 6: GLOBAL RECORDER (for instrumentation)
# ═══════════════════════════════════════════════════════════════

static GLOBAL_RECORDER: std::thread::Mutex[Option[Recorder]] = std::thread::Mutex::new(Option::None)

def start_recording(path: &str) -> Result[Unit, RecorderError]
  let mut guard = GLOBAL_RECORDER.lock()
  if guard.is_some() then
    return Result::Err(RecorderError::AlreadyRecording)
  end
  
  let mut recorder = Recorder::new(path)
  recorder.start()?
  *guard = Option::Some(recorder)
  Result::Ok(())
end

def stop_recording() -> Result[RecordingStats, RecorderError]
  let mut guard = GLOBAL_RECORDER.lock()
  match guard.take()
  when Option::Some(mut r) then r.stop()
  when Option::None then Result::Err(RecorderError::NotRecording)
  end
end

def record_event(event: Event) -> Result[Unit, RecorderError]
  let mut guard = GLOBAL_RECORDER.lock()
  match &mut *guard
  when Option::Some(r) then r.record(event)
  when Option::None then Result::Ok(())  # Silently ignore if not recording
  end
end

# Convenience macros for instrumentation
macro checkpoint!(name: expr)
  record_event(Event::Checkpoint(CheckpointEvent {
    timestamp: 0,  # Filled by recorder
    thread_id: current_thread_id(),
    name: $name.to_string(),
    data: Map::new()
  }))
end

macro checkpoint_with_data!(name: expr, data: expr)
  record_event(Event::Checkpoint(CheckpointEvent {
    timestamp: 0,
    thread_id: current_thread_id(),
    name: $name.to_string(),
    data: $data
  }))
end
