impl DepthStencilDescriptor
  pub def new() -> DepthStencilDescriptor
    DepthStencilDescriptor {
      depth_compare_function: Option::None,
      depth_write_enabled: false,
      front_face_stencil: Option::None,
      back_face_stencil: Option::None
    }
  end
  
  pub fn with_depth(self: Self, compare: CompareFunction, write: Bool) -> DepthStencilDescriptor
    DepthStencilDescriptor {
      depth_compare_function: Option::Some(compare),
      depth_write_enabled: write,
      front_face_stencil: self.front_face_stencil,
      back_face_stencil: self.back_face_stencil
    }
  end
end

pub struct StencilDescriptor
  stencil_compare_function: CompareFunction
  stencil_failure_operation: StencilOperation
  depth_failure_operation: StencilOperation
  depth_stencil_pass_operation: StencilOperation
  read_mask: u32
  write_mask: u32
end

impl StencilDescriptor
  pub def new() -> StencilDescriptor
    StencilDescriptor {
      stencil_compare_function: CompareFunction::Always,
      stencil_failure_operation: StencilOperation::Keep,
      depth_failure_operation: StencilOperation::Keep,
      depth_stencil_pass_operation: StencilOperation::Keep,
      read_mask: u32::MAX,
      write_mask: u32::MAX
    }
  end
  
  pub def as_ptr(self: Self) -> Ptr[u8]
    unsafe "stencil descriptor as ptr" do
      self as Ptr[u8]
    end
  end
end

pub struct RenderPassDescriptor
  color_attachments: Vec[RenderPassColorAttachmentDescriptor]
  depth_attachment: Option[RenderPassDepthAttachmentDescriptor]
  stencil_attachment: Option[RenderPassStencilAttachmentDescriptor]
end

impl RenderPassDescriptor
  pub def new() -> RenderPassDescriptor
    RenderPassDescriptor {
      color_attachments: Vec::new(),
      depth_attachment: Option::None,
      stencil_attachment: Option::None
    }
  end
  
  pub fn add_color_attachment(inout self: Self, texture: MetalTexture, load: LoadAction, store: StoreAction, clear: ClearColor) -> Unit
    self.color_attachments.push(RenderPassColorAttachmentDescriptor {
      texture: texture.handle,
      level: 0,
      slice: 0,
      depth_plane: 0,
      load_action: load,
      store_action: store,
      clear_color: clear
    })
  end
  
  pub fn set_depth_attachment(inout self: Self, texture: MetalTexture, load: LoadAction, store: StoreAction, clear_depth: f64) -> Unit
    self.depth_attachment = Option::Some(RenderPassDepthAttachmentDescriptor {
      texture: texture.handle,
      level: 0,
      slice: 0,
      load_action: load,
      store_action: store,
      clear_depth: clear_depth
    })
  end
end

pub struct RenderPassColorAttachmentDescriptor
  texture: MTLTexture
  level: u32
  slice: u32
  depth_plane: u32
  load_action: LoadAction
  store_action: StoreAction
  clear_color: ClearColor
end

pub struct RenderPassDepthAttachmentDescriptor
  texture: MTLTexture
  level: u32
  slice: u32
  load_action: LoadAction
  store_action: StoreAction
  clear_depth: f64
end

pub struct RenderPassStencilAttachmentDescriptor
  texture: MTLTexture
  level: u32
  slice: u32
  load_action: LoadAction
  store_action: StoreAction
  clear_stencil: u32
end

