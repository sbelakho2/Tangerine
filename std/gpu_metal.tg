# ———————————————————————————————————————————————————————————————
# Library and Function
# ———————————————————————————————————————————————————————————————

pub struct MetalLibrary
  handle: MTLLibrary
end

impl MetalLibrary
  pub fn handle(self: Self) -> MTLLibrary
    self.handle
  end
  
  pub def new_function(self: Self, name: String) -> Option[MetalFunction]
    let mut handle: MTLFunction = Ptr::null()
    
    unsafe "metal new function" do
      handle = metal_library_new_function(self.handle, name.as_ptr())
    end
    
    if handle.is_null() then
      Option::None
    else
      Option::Some(MetalFunction { handle: handle })
    end
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "metal release library" do
      metal_release(self.handle)
    end
    self.handle = Ptr::null()
  end
end

pub struct MetalFunction
  handle: MTLFunction
end

impl MetalFunction
  pub fn handle(self: Self) -> MTLFunction
    self.handle
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "metal release function" do
      metal_release(self.handle)
    end
    self.handle = Ptr::null()
  end
end

