## Tangerine Standard Library — std::gpu_metal
## Metal Graphics API Backend for macOS/iOS
##
## Provides Apple Metal implementation for GPU access:
## - Device and command queue management
## - Render pipeline state objects
## - Buffer and texture management
## - Command buffer encoding
## - Synchronization

use std::collections::{Vec, Map}
use std::ffi::{Ptr, CString}
use std::core::{Option, Result}
use std::window::Window

# ———————————————————————————————————————————————————————————————
# Metal Types (Objective-C bridging)
# ———————————————————————————————————————————————————————————————

type MTLDevice = Ptr[u8]
type MTLCommandQueue = Ptr[u8]
type MTLCommandBuffer = Ptr[u8]
type MTLRenderCommandEncoder = Ptr[u8]
type MTLBlitCommandEncoder = Ptr[u8]
type MTLComputeCommandEncoder = Ptr[u8]
type MTLBuffer = Ptr[u8]
type MTLTexture = Ptr[u8]
type MTLSamplerState = Ptr[u8]
type MTLRenderPipelineState = Ptr[u8]
type MTLComputePipelineState = Ptr[u8]
type MTLDepthStencilState = Ptr[u8]
type MTLLibrary = Ptr[u8]
type MTLFunction = Ptr[u8]
type MTLRenderPassDescriptor = Ptr[u8]
type CAMetalLayer = Ptr[u8]
type MTLSharedEvent = Ptr[u8]
type MTLFence = Ptr[u8]

# ———————————————————————————————————————————————————————————————
# Enums
# ———————————————————————————————————————————————————————————————

pub enum PixelFormat
  Invalid
  # Color formats
  RGBA8Unorm
  RGBA8Snorm
  RGBA16Float
  RGBA32Float
  BGRA8Unorm
  BGRA8Unorm_sRGB
  R8Unorm
  R16Float
  R32Float
  RG8Unorm
  RG16Float
  RG32Float
  RGB10A2Unorm
  RGB9E5Float
  # Depth formats
  Depth16Unorm
  Depth32Float
  Depth24Unorm_Stencil8
  Depth32Float_Stencil8
  Stencil8
end

impl PixelFormat
  pub def to_mtl(self: Self) -> u32
    match self
      when PixelFormat::Invalid then 0
      when PixelFormat::RGBA8Unorm then 70
      when PixelFormat::RGBA8Snorm then 71
      when PixelFormat::RGBA16Float then 115
      when PixelFormat::RGBA32Float then 123
      when PixelFormat::BGRA8Unorm then 80
      when PixelFormat::BGRA8Unorm_sRGB then 82
      when PixelFormat::R8Unorm then 10
      when PixelFormat::R16Float then 25
      when PixelFormat::R32Float then 55
      when PixelFormat::RG8Unorm then 30
      when PixelFormat::RG16Float then 65
      when PixelFormat::RG32Float then 105
      when PixelFormat::RGB10A2Unorm then 77
      when PixelFormat::RGB9E5Float then 93
      when PixelFormat::Depth16Unorm then 250
      when PixelFormat::Depth32Float then 252
      when PixelFormat::Depth24Unorm_Stencil8 then 255
      when PixelFormat::Depth32Float_Stencil8 then 260
      when PixelFormat::Stencil8 then 253
    end
  end
  
  pub fn bytes_per_pixel(self: Self) -> u32
    match self
      when PixelFormat::Invalid then 0
      when PixelFormat::RGBA8Unorm then 4
      when PixelFormat::RGBA8Snorm then 4
      when PixelFormat::RGBA16Float then 8
      when PixelFormat::RGBA32Float then 16
      when PixelFormat::BGRA8Unorm then 4
      when PixelFormat::BGRA8Unorm_sRGB then 4
      when PixelFormat::R8Unorm then 1
      when PixelFormat::R16Float then 2
      when PixelFormat::R32Float then 4
      when PixelFormat::RG8Unorm then 2
      when PixelFormat::RG16Float then 4
      when PixelFormat::RG32Float then 8
      when PixelFormat::RGB10A2Unorm then 4
      when PixelFormat::RGB9E5Float then 4
      when PixelFormat::Depth16Unorm then 2
      when PixelFormat::Depth32Float then 4
      when PixelFormat::Depth24Unorm_Stencil8 then 4
      when PixelFormat::Depth32Float_Stencil8 then 8
      when PixelFormat::Stencil8 then 1
    end
  end
end

pub enum TextureType
  Texture1D
  Texture2D
  Texture3D
  TextureCube
  Texture2DMultisample
  Texture2DMultisampleArray
end

pub enum TextureUsage
  Unknown
  ShaderRead
  ShaderWrite
  RenderTarget
  PixelFormatView
  ShaderReadWrite
end

impl TextureUsage
  pub def to_mtl(self: Self) -> u32
    match self
      when TextureUsage::Unknown then 0
      when TextureUsage::ShaderRead then 1
      when TextureUsage::ShaderWrite then 2
      when TextureUsage::RenderTarget then 4
      when TextureUsage::PixelFormatView then 16
      when TextureUsage::ShaderReadWrite then 3
    end
  end
end

pub enum StorageMode
  Shared  # CPU and GPU accessible
  Managed  # CPU-GPU managed (macOS only)
  Private  # GPU only
  Memoryless  # Tile memory (iOS only)
end

impl StorageMode
  pub def to_mtl(self: Self) -> u32
    match self
      when StorageMode::Shared then 0
      when StorageMode::Managed then 1
      when StorageMode::Private then 2
      when StorageMode::Memoryless then 3
    end
  end
end

