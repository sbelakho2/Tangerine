pub struct MetalTexture
  handle: MTLTexture
  width: u32
  height: u32
  depth: u32
  pixel_format: PixelFormat
  mip_levels: u32
end

impl MetalTexture
  pub fn handle(self: Self) -> MTLTexture
    self.handle
  end
  
  pub fn width(self: Self) -> u32
    self.width
  end
  
  pub fn height(self: Self) -> u32
    self.height
  end
  
  pub fn pixel_format(self: Self) -> PixelFormat
    self.pixel_format
  end
  
  pub fn mip_levels(self: Self) -> u32
    self.mip_levels
  end
  
  pub def get_texture_view(self: Self, pixel_format: PixelFormat) -> MetalTexture
    let mut handle: MTLTexture = Ptr::null()
    
    unsafe "metal get texture view" do
      handle = metal_texture_new_texture_view(self.handle, pixel_format.to_mtl())
    end
    
    MetalTexture {
      handle: handle,
      width: self.width,
      height: self.height,
      depth: self.depth,
      pixel_format: pixel_format,
      mip_levels: self.mip_levels
    }
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "metal release texture" do
      metal_release(self.handle)
    end
    self.handle = Ptr::null()
  end
end

