end

impl MetalDrawable
  pub fn handle(self: Self) -> Ptr[u8]
    self.handle
  end
  
  pub fn texture(self: Self) -> MetalTexture
    let mut tex_handle: MTLTexture = Ptr::null()
    
    unsafe "metal drawable texture" do
      tex_handle = metal_drawable_get_texture(self.handle)
    end
    
    MetalTexture {
      handle: tex_handle,
      width: 0,
      height: 0,
      depth: 1,
      pixel_format: PixelFormat::BGRA8Unorm,
      mip_levels: 1
    }
  end
end

# ———————————————————————————————————————————————————————————————
# Descriptors
# ———————————————————————————————————————————————————————————————

pub struct TextureDescriptor
  texture_type: TextureType
  pixel_format: PixelFormat
  width: u32
  height: u32
  depth: u32
  mipmap_level_count: u32
  sample_count: u32
  array_length: u32
  usage: TextureUsage
  storage_mode: StorageMode
end

impl TextureDescriptor
  pub def new_2d(pixel_format: PixelFormat, width: u32, height: u32, usage: TextureUsage) -> TextureDescriptor
    TextureDescriptor {
      texture_type: TextureType::Texture2D,
      pixel_format: pixel_format,
      width: width,
      height: height,
      depth: 1,
      mipmap_level_count: 1,
      sample_count: 1,
      array_length: 1,
      usage: usage,
      storage_mode: StorageMode::Private
    }
  end
  
  pub fn with_mipmaps(self: Self, levels: u32) -> TextureDescriptor
    TextureDescriptor {
      texture_type: self.texture_type,
      pixel_format: self.pixel_format,
      width: self.width,
      height: self.height,
      depth: self.depth,
      mipmap_level_count: levels,
      sample_count: self.sample_count,
      array_length: self.array_length,
      usage: self.usage,
      storage_mode: self.storage_mode
    }
  end
  
  pub fn with_samples(self: Self, samples: u32) -> TextureDescriptor
    TextureDescriptor {
      texture_type: if samples > 1 then TextureType::Texture2DMultisample else self.texture_type,
      pixel_format: self.pixel_format,
      width: self.width,
      height: self.height,
      depth: self.depth,
      mipmap_level_count: self.mipmap_level_count,
      sample_count: samples,
      array_length: self.array_length,
      usage: self.usage,
      storage_mode: self.storage_mode
    }
  end
  
  pub fn with_storage_mode(self: Self, mode: StorageMode) -> TextureDescriptor
    TextureDescriptor {
      texture_type: self.texture_type,
      pixel_format: self.pixel_format,
      width: self.width,
      height: self.height,
      depth: self.depth,
      mipmap_level_count: self.mipmap_level_count,
      sample_count: self.sample_count,
      array_length: self.array_length,
      usage: self.usage,
      storage_mode: mode
    }
  end
end

pub struct SamplerDescriptor
  min_filter: SamplerMinMagFilter
  mag_filter: SamplerMinMagFilter
  mip_filter: SamplerMipFilter
  s_address_mode: SamplerAddressMode
  t_address_mode: SamplerAddressMode
  r_address_mode: SamplerAddressMode
  lod_min_clamp: f32
  lod_max_clamp: f32
  max_anisotropy: u32
  compare_function: Option[CompareFunction]
end

impl SamplerDescriptor
  pub def new() -> SamplerDescriptor
    SamplerDescriptor {
      min_filter: SamplerMinMagFilter::Nearest,
      mag_filter: SamplerMinMagFilter::Nearest,
      mip_filter: SamplerMipFilter::NotMipmapped,
      s_address_mode: SamplerAddressMode::ClampToEdge,
      t_address_mode: SamplerAddressMode::ClampToEdge,
      r_address_mode: SamplerAddressMode::ClampToEdge,
      lod_min_clamp: 0.0,
      lod_max_clamp: f32::MAX,
      max_anisotropy: 1,
      compare_function: Option::None
    }
  end
  
  pub fn with_filters(self: Self, min: SamplerMinMagFilter, mag: SamplerMinMagFilter, mip: SamplerMipFilter) -> SamplerDescriptor
    SamplerDescriptor {
      min_filter: min,
      mag_filter: mag,
      mip_filter: mip,
      s_address_mode: self.s_address_mode,
      t_address_mode: self.t_address_mode,
      r_address_mode: self.r_address_mode,
      lod_min_clamp: self.lod_min_clamp,
      lod_max_clamp: self.lod_max_clamp,
      max_anisotropy: self.max_anisotropy,
      compare_function: self.compare_function
    }
  end
  
  pub fn with_address_modes(self: Self, s: SamplerAddressMode, t: SamplerAddressMode, r: SamplerAddressMode) -> SamplerDescriptor
    SamplerDescriptor {
      min_filter: self.min_filter,
      mag_filter: self.mag_filter,
      mip_filter: self.mip_filter,
      s_address_mode: s,
      t_address_mode: t,
      r_address_mode: r,
      lod_min_clamp: self.lod_min_clamp,
      lod_max_clamp: self.lod_max_clamp,
      max_anisotropy: self.max_anisotropy,
      compare_function: self.compare_function
    }
  end
end

pub struct RenderPipelineDescriptor
  vertex_function: MetalFunction
  fragment_function: Option[MetalFunction]
  color_attachment_formats: Vec[PixelFormat]
  depth_attachment_format: Option[PixelFormat]
  stencil_attachment_format: Option[PixelFormat]
  sample_count: u32
  alpha_to_coverage_enabled: Bool
  alpha_to_one_enabled: Bool
  rasterization_enabled: Bool
end

impl RenderPipelineDescriptor
  pub def new(vertex: MetalFunction) -> RenderPipelineDescriptor
    RenderPipelineDescriptor {
      vertex_function: vertex,
      fragment_function: Option::None,
      color_attachment_formats: Vec::new(),
      depth_attachment_format: Option::None,
      stencil_attachment_format: Option::None,
      sample_count: 1,
      alpha_to_coverage_enabled: false,
      alpha_to_one_enabled: false,
      rasterization_enabled: true
    }
  end
  
  pub fn with_fragment(self: Self, fragment: MetalFunction) -> RenderPipelineDescriptor
    RenderPipelineDescriptor {
      vertex_function: self.vertex_function,
      fragment_function: Option::Some(fragment),
      color_attachment_formats: self.color_attachment_formats.clone(),
      depth_attachment_format: self.depth_attachment_format,
      stencil_attachment_format: self.stencil_attachment_format,
      sample_count: self.sample_count,
      alpha_to_coverage_enabled: self.alpha_to_coverage_enabled,
      alpha_to_one_enabled: self.alpha_to_one_enabled,
      rasterization_enabled: self.rasterization_enabled
    }
  end
  
  pub fn with_color_attachment(self: Self, format: PixelFormat) -> RenderPipelineDescriptor
    let mut formats = self.color_attachment_formats.clone()
    formats.push(format)
    RenderPipelineDescriptor {
      vertex_function: self.vertex_function,
      fragment_function: self.fragment_function,
      color_attachment_formats: formats,
      depth_attachment_format: self.depth_attachment_format,
      stencil_attachment_format: self.stencil_attachment_format,
      sample_count: self.sample_count,
      alpha_to_coverage_enabled: self.alpha_to_coverage_enabled,
      alpha_to_one_enabled: self.alpha_to_one_enabled,
      rasterization_enabled: self.rasterization_enabled
    }
  end
end

pub struct DepthStencilDescriptor
