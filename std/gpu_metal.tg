# ———————————————————————————————————————————————————————————————
# Buffer
# ———————————————————————————————————————————————————————————————

pub struct MetalBuffer
  handle: MTLBuffer
  length: u64
  contents: Ptr[u8]
  storage_mode: StorageMode
end

impl MetalBuffer
  pub fn handle(self: Self) -> MTLBuffer
    self.handle
  end
  
  pub fn length(self: Self) -> u64
    self.length
  end
  
  pub fn contents(self: Self) -> Ptr[u8]
    self.contents
  end
  
  pub def write(inout self: Self, data: Ptr[u8], size: u64, offset: u64) -> Unit
    if !self.contents.is_null() then
      unsafe "metal buffer write" do
        memcpy(self.contents.add(offset), data, size)
      end
    end
  end
  
  pub def read(self: Self, data: Ptr[u8], size: u64, offset: u64) -> Unit
    if !self.contents.is_null() then
      unsafe "metal buffer read" do
        memcpy(data, self.contents.add(offset), size)
      end
    end
  end
  
  pub def did_modify_range(self: Self, offset: u64, length: u64) -> Unit
    if self.storage_mode == StorageMode::Managed then
      unsafe "metal buffer did modify range" do
        metal_buffer_did_modify_range(self.handle, offset, length)
      end
    end
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "metal release buffer" do
      metal_release(self.handle)
    end
    self.handle = Ptr::null()
    self.contents = Ptr::null()
  end
end

