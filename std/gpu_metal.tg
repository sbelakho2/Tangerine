# ———————————————————————————————————————————————————————————————
# Blit Command Encoder
# ———————————————————————————————————————————————————————————————

pub struct MetalBlitCommandEncoder
  handle: MTLBlitCommandEncoder
  command_buffer: MTLCommandBuffer
end

impl MetalBlitCommandEncoder
  pub def copy_buffer_to_buffer(self: Self, src: MetalBuffer, src_offset: u64, dst: MetalBuffer, dst_offset: u64, size: u64) -> Unit
    unsafe "metal copy buffer to buffer" do
      metal_blit_copy_buffer_to_buffer(self.handle, src.handle, src_offset, dst.handle, dst_offset, size)
    end
  end
  
  pub def copy_buffer_to_texture(self: Self, src: MetalBuffer, src_offset: u64, dst: MetalTexture, dst_slice: u32, dst_level: u32, dst_origin: Origin, dst_size: Size, bytes_per_row: u32, bytes_per_image: u32) -> Unit
    unsafe "metal copy buffer to texture" do
      metal_blit_copy_buffer_to_texture(
        self.handle,
        src.handle,
        src_offset,
        dst.handle,
        dst_slice,
        dst_level,
        dst_origin.x,
        dst_origin.y,
        dst_origin.z,
        dst_size.width,
        dst_size.height,
        dst_size.depth,
        bytes_per_row,
        bytes_per_image
      )
    end
  end
  
  pub def copy_texture_to_buffer(self: Self, src: MetalTexture, src_slice: u32, src_level: u32, src_origin: Origin, src_size: Size, dst: MetalBuffer, dst_offset: u64, bytes_per_row: u32, bytes_per_image: u32) -> Unit
    unsafe "metal copy texture to buffer" do
      metal_blit_copy_texture_to_buffer(
        self.handle,
        src.handle,
        src_slice,
        src_level,
        src_origin.x,
        src_origin.y,
        src_origin.z,
        src_size.width,
        src_size.height,
        src_size.depth,
        dst.handle,
        dst_offset,
        bytes_per_row,
        bytes_per_image
      )
    end
  end
  
  pub def generate_mipmaps(self: Self, texture: MetalTexture) -> Unit
    unsafe "metal generate mipmaps" do
      metal_blit_generate_mipmaps(self.handle, texture.handle)
    end
  end
  
  pub def synchronize_resource(self: Self, resource: Ptr[u8]) -> Unit
    unsafe "metal synchronize resource" do
      metal_blit_synchronize_resource(self.handle, resource)
    end
  end
  
  pub def end_encoding(self: Self) -> Unit
    unsafe "metal end encoding" do
      metal_encoder_end_encoding(self.handle)
    end
  end
end

