  Point
  Line
  LineStrip
  Triangle
  TriangleStrip
end

impl PrimitiveType
  pub def to_mtl(self: Self) -> u32
    match self
      when PrimitiveType::Point then 0
      when PrimitiveType::Line then 1
      when PrimitiveType::LineStrip then 2
      when PrimitiveType::Triangle then 3
      when PrimitiveType::TriangleStrip then 4
    end
  end
end

pub enum IndexType
  UInt16
  UInt32
end

impl IndexType
  pub def to_mtl(self: Self) -> u32
    match self
      when IndexType::UInt16 then 0
      when IndexType::UInt32 then 1
    end
  end
  
  pub fn size(self: Self) -> u32
    match self
      when IndexType::UInt16 then 2
      when IndexType::UInt32 then 4
    end
  end
end

pub enum CompareFunction
  Never
  Less
  Equal
  LessEqual
  Greater
  NotEqual
  GreaterEqual
  Always
end

impl CompareFunction
  pub def to_mtl(self: Self) -> u32
    match self
      when CompareFunction::Never then 0
      when CompareFunction::Less then 1
      when CompareFunction::Equal then 2
      when CompareFunction::LessEqual then 3
      when CompareFunction::Greater then 4
      when CompareFunction::NotEqual then 5
      when CompareFunction::GreaterEqual then 6
      when CompareFunction::Always then 7
    end
  end
end

pub enum StencilOperation
  Keep
  Zero
  Replace
  IncrementClamp
  DecrementClamp
  Invert
  IncrementWrap
  DecrementWrap
end

impl StencilOperation
  pub def to_mtl(self: Self) -> u32
    match self
      when StencilOperation::Keep then 0
      when StencilOperation::Zero then 1
      when StencilOperation::Replace then 2
      when StencilOperation::IncrementClamp then 3
      when StencilOperation::DecrementClamp then 4
      when StencilOperation::Invert then 5
      when StencilOperation::IncrementWrap then 6
      when StencilOperation::DecrementWrap then 7
    end
  end
end

pub enum BlendFactor
  Zero
  One
  SourceColor
  OneMinusSourceColor
  SourceAlpha
  OneMinusSourceAlpha
  DestinationColor
  OneMinusDestinationColor
  DestinationAlpha
  OneMinusDestinationAlpha
  SourceAlphaSaturated
  BlendColor
  OneMinusBlendColor
  BlendAlpha
  OneMinusBlendAlpha
end

impl BlendFactor
  pub def to_mtl(self: Self) -> u32
    match self
      when BlendFactor::Zero then 0
      when BlendFactor::One then 1
      when BlendFactor::SourceColor then 2
      when BlendFactor::OneMinusSourceColor then 3
      when BlendFactor::SourceAlpha then 4
      when BlendFactor::OneMinusSourceAlpha then 5
      when BlendFactor::DestinationColor then 6
      when BlendFactor::OneMinusDestinationColor then 7
      when BlendFactor::DestinationAlpha then 8
      when BlendFactor::OneMinusDestinationAlpha then 9
      when BlendFactor::SourceAlphaSaturated then 10
      when BlendFactor::BlendColor then 11
      when BlendFactor::OneMinusBlendColor then 12
      when BlendFactor::BlendAlpha then 13
      when BlendFactor::OneMinusBlendAlpha then 14
    end
  end
end

