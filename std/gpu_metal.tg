pub struct ClearColor
  red: f64
  green: f64
  blue: f64
  alpha: f64
end

impl ClearColor
  pub def new(r: f64, g: f64, b: f64, a: f64) -> ClearColor
    ClearColor { red: r, green: g, blue: b, alpha: a }
  end
  
  pub fn black() -> ClearColor
    ClearColor::new(0.0, 0.0, 0.0, 1.0)
  end
  
  pub fn white() -> ClearColor
    ClearColor::new(1.0, 1.0, 1.0, 1.0)
  end
end

# ———————————————————————————————————————————————————————————————
# Device
# ———————————————————————————————————————————————————————————————

pub struct MetalDevice
  handle: MTLDevice
  command_queue: MTLCommandQueue
  name: String
  max_threads_per_threadgroup: u32
  recommended_max_working_set_size: u64
  has_unified_memory: Bool
  current_drawable: Ptr[u8]
  layer: CAMetalLayer
end

impl MetalDevice
  pub def create(window: Window) -> Result[MetalDevice, String]
    let mut handle: MTLDevice = Ptr::null()
    let mut command_queue: MTLCommandQueue = Ptr::null()
    let mut layer: CAMetalLayer = Ptr::null()
    let mut name: String = ""
    let mut max_threads: u32 = 0
    let mut max_working_set: u64 = 0
    let mut unified: Bool = false
    
    unsafe "metal create device" do
      # Create Metal layer for window
      layer = metal_create_layer(window.native_handle())
      if layer.is_null() then
        return Result::Err("Failed to create Metal layer")
      end
      
      # Get default device
      handle = metal_create_default_device()
      if handle.is_null() then
        return Result::Err("Failed to create Metal device")
      end
      
      # Set device on layer
      metal_layer_set_device(layer, handle)
      
      # Create command queue
      command_queue = metal_create_command_queue(handle)
      if command_queue.is_null() then
        return Result::Err("Failed to create command queue")
      end
      
      # Get device info
      name = String::from_cstr(metal_device_get_name(handle))
      max_threads = metal_device_get_max_threads_per_threadgroup(handle)
      max_working_set = metal_device_get_recommended_max_working_set_size(handle)
      unified = metal_device_has_unified_memory(handle)
    end
    
    Result::Ok(MetalDevice {
      handle: handle,
      command_queue: command_queue,
      name: name,
      max_threads_per_threadgroup: max_threads,
      recommended_max_working_set_size: max_working_set,
      has_unified_memory: unified,
      current_drawable: Ptr::null(),
      layer: layer
    })
  end
  
  pub fn handle(self: Self) -> MTLDevice
    self.handle
  end
  
  pub fn name(self: Self) -> String
    self.name.clone()
  end
  
  pub fn command_queue(self: Self) -> MTLCommandQueue
    self.command_queue
  end
  
  pub fn has_unified_memory(self: Self) -> Bool
    self.has_unified_memory
  end
  
  pub def create_command_buffer(self: Self) -> MetalCommandBuffer
    let mut handle: MTLCommandBuffer = Ptr::null()
    
    unsafe "metal create command buffer" do
      handle = metal_command_buffer_create(self.command_queue)
    end
    
    MetalCommandBuffer {
      device: self.handle,
      handle: handle,
      encoder: Ptr::null()
    }
  end
  
  pub def create_buffer(self: Self, length: u64, storage_mode: StorageMode) -> Result[MetalBuffer, String]
    let mut handle: MTLBuffer = Ptr::null()
    let mut contents: Ptr[u8] = Ptr::null()
    
    unsafe "metal create buffer" do
      handle = metal_buffer_create(self.handle, length, storage_mode.to_mtl())
      if handle.is_null() then
        return Result::Err("Failed to create buffer")
      end
      
      if storage_mode == StorageMode::Shared || storage_mode == StorageMode::Managed then
        contents = metal_buffer_get_contents(handle)
      end
    end
    
    Result::Ok(MetalBuffer {
      handle: handle,
      length: length,
      contents: contents,
      storage_mode: storage_mode
    })
  end
  
  pub def create_texture(self: Self, descriptor: TextureDescriptor) -> Result[MetalTexture, String]
    let mut handle: MTLTexture = Ptr::null()
    
    unsafe "metal create texture" do
      handle = metal_texture_create(
        self.handle,
        descriptor.texture_type.to_mtl(),
        descriptor.pixel_format.to_mtl(),
        descriptor.width,
        descriptor.height,
        descriptor.depth,
        descriptor.mipmap_level_count,
        descriptor.sample_count,
        descriptor.array_length,
        descriptor.usage.to_mtl(),
        descriptor.storage_mode.to_mtl()
      )
      
      if handle.is_null() then
        return Result::Err("Failed to create texture")
      end
    end
    
    Result::Ok(MetalTexture {
      handle: handle,
      width: descriptor.width,
      height: descriptor.height,
      depth: descriptor.depth,
      pixel_format: descriptor.pixel_format,
      mip_levels: descriptor.mipmap_level_count
    })
  end
  
  pub def create_sampler(self: Self, descriptor: SamplerDescriptor) -> Result[MetalSampler, String]
    let mut handle: MTLSamplerState = Ptr::null()
    
    unsafe "metal create sampler" do
      handle = metal_sampler_create(
        self.handle,
        descriptor.min_filter.to_mtl(),
        descriptor.mag_filter.to_mtl(),
        descriptor.mip_filter.to_mtl(),
        descriptor.s_address_mode.to_mtl(),
        descriptor.t_address_mode.to_mtl(),
        descriptor.r_address_mode.to_mtl(),
        descriptor.lod_min_clamp,
        descriptor.lod_max_clamp,
        descriptor.max_anisotropy,
        descriptor.compare_function.map_or(0, |f| f.to_mtl())
      )
      
      if handle.is_null() then
        return Result::Err("Failed to create sampler")
      end
    end
    
    Result::Ok(MetalSampler { handle: handle })
  end
  
  pub def create_render_pipeline_state(self: Self, descriptor: RenderPipelineDescriptor) -> Result[MetalRenderPipelineState, String]
    let mut handle: MTLRenderPipelineState = Ptr::null()
    
    unsafe "metal create render pipeline" do
      handle = metal_render_pipeline_create(
        self.handle,
        descriptor.vertex_function.handle,
        descriptor.fragment_function.handle_or_null(),
        descriptor.color_attachment_formats.as_ptr(),
        descriptor.color_attachment_formats.len(),
        descriptor.depth_attachment_format.map_or(0, |f| f.to_mtl()),
        descriptor.stencil_attachment_format.map_or(0, |f| f.to_mtl()),
        descriptor.sample_count,
        descriptor.alpha_to_coverage_enabled,
        descriptor.alpha_to_one_enabled,
        descriptor.rasterization_enabled
      )
      
      if handle.is_null() then
        return Result::Err("Failed to create render pipeline state")
      end
    end
    
    Result::Ok(MetalRenderPipelineState { handle: handle })
  end
  
  pub def create_depth_stencil_state(self: Self, descriptor: DepthStencilDescriptor) -> Result[MetalDepthStencilState, String]
    let mut handle: MTLDepthStencilState = Ptr::null()
    
    unsafe "metal create depth stencil state" do
      handle = metal_depth_stencil_create(
        self.handle,
        descriptor.depth_compare_function.map_or(0, |f| f.to_mtl()),
        descriptor.depth_write_enabled,
        descriptor.front_face_stencil.map_or_ptr(Ptr::null(), |s| s.as_ptr()),
        descriptor.back_face_stencil.map_or_ptr(Ptr::null(), |s| s.as_ptr())
      )
      
      if handle.is_null() then
        return Result::Err("Failed to create depth stencil state")
      end
    end
    
    Result::Ok(MetalDepthStencilState { handle: handle })
  end
  
  pub def create_library_from_source(self: Self, source: String) -> Result[MetalLibrary, String]
    let mut handle: MTLLibrary = Ptr::null()
    
    unsafe "metal create library from source" do
      handle = metal_library_create_from_source(self.handle, source.as_ptr(), source.len())
      if handle.is_null() then
        return Result::Err("Failed to create library from source")
      end
    end
    
    Result::Ok(MetalLibrary { handle: handle })
  end
  
  pub def create_library_from_file(self: Self, path: String) -> Result[MetalLibrary, String]
    let mut handle: MTLLibrary = Ptr::null()
    
    unsafe "metal create library from file" do
      handle = metal_library_create_from_file(self.handle, path.as_ptr())
      if handle.is_null() then
        return Result::Err("Failed to create library from file")
      end
    end
    
    Result::Ok(MetalLibrary { handle: handle })
  end
  
  pub def next_drawable(inout self: Self) -> Option[MetalDrawable]
    unsafe "metal next drawable" do
      let drawable = metal_layer_next_drawable(self.layer)
      if drawable.is_null() then
        Option::None
      else
        self.current_drawable = drawable
        Option::Some(MetalDrawable { handle: drawable })
      end
    end
  end
  
  pub def resize(inout self: Self, width: u32, height: u32) -> Unit
    unsafe "metal resize" do
      metal_layer_set_frame(self.layer, 0, 0, width as f64, height as f64)
    end
  end
  
  pub def destroy(inout self: Self) -> Unit
    unsafe "metal destroy device" do
      metal_release(self.command_queue)
      metal_release(self.handle)
    end
    self.handle = Ptr::null()
    self.command_queue = Ptr::null()
  end
end

# ———————————————————————————————————————————————————————————————
# Command Buffer
# ———————————————————————————————————————————————————————————————

pub struct MetalCommandBuffer
  device: MTLDevice
  handle: MTLCommandBuffer
  encoder: Ptr[u8]
end

impl MetalCommandBuffer
  pub fn handle(self: Self) -> MTLCommandBuffer
    self.handle
  end
  
  pub def begin_render_pass(inout self: Self, descriptor: RenderPassDescriptor) -> MetalRenderCommandEncoder
    let mut encoder: MTLRenderCommandEncoder = Ptr::null()
    
    unsafe "metal begin render pass" do
      encoder = metal_render_pass_create(
        self.handle,
        descriptor.color_attachments.as_ptr(),
        descriptor.color_attachments.len(),
        descriptor.depth_attachment.map_or_ptr(Ptr::null(), |a| a.as_ptr()),
        descriptor.stencil_attachment.map_or_ptr(Ptr::null(), |a| a.as_ptr())
      )
    end
    
    self.encoder = encoder
    
    MetalRenderCommandEncoder {
      handle: encoder,
      command_buffer: self.handle
    }
  end
  
  pub def begin_blit_pass(inout self: Self) -> MetalBlitCommandEncoder
    let mut encoder: MTLBlitCommandEncoder = Ptr::null()
    
    unsafe "metal begin blit pass" do
      encoder = metal_blit_encoder_create(self.handle)
    end
    
    self.encoder = encoder
    
    MetalBlitCommandEncoder {
      handle: encoder,
      command_buffer: self.handle
    }
  end
  
  pub def begin_compute_pass(inout self: Self) -> MetalComputeCommandEncoder
    let mut encoder: MTLComputeCommandEncoder = Ptr::null()
    
    unsafe "metal begin compute pass" do
      encoder = metal_compute_encoder_create(self.handle)
    end
    
    self.encoder = encoder
    
    MetalComputeCommandEncoder {
      handle: encoder,
      command_buffer: self.handle
    }
  end
  
  pub def commit(self: Self) -> Unit
    unsafe "metal commit command buffer" do
      metal_command_buffer_commit(self.handle)
    end
  end
  
  pub def wait_until_completed(self: Self) -> Unit
    unsafe "metal wait until completed" do
      metal_command_buffer_wait_until_completed(self.handle)
    end
  end
  
  pub def wait_until_scheduled(self: Self) -> Unit
    unsafe "metal wait until scheduled" do
      metal_command_buffer_wait_until_scheduled(self.handle)
    end
  end
  
  pub fn status(self: Self) -> CommandBufferStatus
    unsafe "metal command buffer status" do
      let status = metal_command_buffer_get_status(self.handle)
      match status
        when 0 then CommandBufferStatus::NotEnqueued
        when 1 then CommandBufferStatus::Enqueued
        when 2 then CommandBufferStatus::Committed
        when 3 then CommandBufferStatus::Scheduled
        when 4 then CommandBufferStatus::Completed
        when 5 then CommandBufferStatus::Error
      end
    end
  end
  
  pub def present_drawable(self: Self, drawable: MetalDrawable) -> Unit
    unsafe "metal present drawable" do
      metal_command_buffer_present_drawable(self.handle, drawable.handle)
    end
  end
end

pub enum CommandBufferStatus
  NotEnqueued
  Enqueued
  Committed
  Scheduled
  Completed
  Error
end

# ———————————————————————————————————————————————————————————————
# Render Command Encoder
# ———————————————————————————————————————————————————————————————

pub struct MetalRenderCommandEncoder
  handle: MTLRenderCommandEncoder
  command_buffer: MTLCommandBuffer
end

impl MetalRenderCommandEncoder
  pub def set_render_pipeline_state(self: Self, state: MetalRenderPipelineState) -> Unit
    unsafe "metal set render pipeline state" do
      metal_encoder_set_render_pipeline_state(self.handle, state.handle)
    end
  end
  
  pub def set_depth_stencil_state(self: Self, state: MetalDepthStencilState) -> Unit
    unsafe "metal set depth stencil state" do
      metal_encoder_set_depth_stencil_state(self.handle, state.handle)
    end
  end
  
  pub def set_vertex_buffer(self: Self, index: u32, buffer: MetalBuffer, offset: u64) -> Unit
    unsafe "metal set vertex buffer" do
      metal_encoder_set_vertex_buffer(self.handle, index, buffer.handle, offset)
    end
  end
  
