# Native Metal FFI declarations
# ———————————————————————————————————————————————————————————————

extern "C" do
  # Device functions
  def metal_create_layer(window_handle: Ptr[u8]) -> CAMetalLayer
  def metal_create_default_device() -> MTLDevice
  def metal_layer_set_device(layer: CAMetalLayer, device: MTLDevice) -> Unit
  def metal_layer_set_frame(layer: CAMetalLayer, x: f64, y: f64, width: f64, height: f64) -> Unit
  def metal_layer_next_drawable(layer: CAMetalLayer) -> Ptr[u8]
  def metal_device_get_name(device: MTLDevice) -> Ptr[u8]
  def metal_device_get_max_threads_per_threadgroup(device: MTLDevice) -> u32
  def metal_device_get_recommended_max_working_set_size(device: MTLDevice) -> u64
  def metal_device_has_unified_memory(device: MTLDevice) -> Bool
  
  # Command queue
  def metal_create_command_queue(device: MTLDevice) -> MTLCommandQueue
  
  # Command buffer
  def metal_command_buffer_create(queue: MTLCommandQueue) -> MTLCommandBuffer
  def metal_command_buffer_commit(buffer: MTLCommandBuffer) -> Unit
  def metal_command_buffer_wait_until_completed(buffer: MTLCommandBuffer) -> Unit
  def metal_command_buffer_wait_until_scheduled(buffer: MTLCommandBuffer) -> Unit
  def metal_command_buffer_get_status(buffer: MTLCommandBuffer) -> u32
  def metal_command_buffer_present_drawable(buffer: MTLCommandBuffer, drawable: Ptr[u8]) -> Unit
  
  # Buffer
  def metal_buffer_create(device: MTLDevice, length: u64, storage_mode: u32) -> MTLBuffer
  def metal_buffer_get_contents(buffer: MTLBuffer) -> Ptr[u8]
  def metal_buffer_did_modify_range(buffer: MTLBuffer, offset: u64, length: u64) -> Unit
  
  # Texture
  def metal_texture_create(device: MTLDevice, texture_type: u32, pixel_format: u32, width: u32, height: u32, depth: u32, mip_levels: u32, samples: u32, array_length: u32, usage: u32, storage_mode: u32) -> MTLTexture
  def metal_texture_new_texture_view(texture: MTLTexture, pixel_format: u32) -> MTLTexture
  
  # Sampler
  def metal_sampler_create(device: MTLDevice, min_filter: u32, mag_filter: u32, mip_filter: u32, s_mode: u32, t_mode: u32, r_mode: u32, lod_min: f32, lod_max: f32, max_aniso: u32, compare_func: u32) -> MTLSamplerState
  
  # Library and function
  def metal_library_create_from_source(device: MTLDevice, source: Ptr[u8], source_len: usize) -> MTLLibrary
  def metal_library_create_from_file(device: MTLDevice, path: Ptr[u8]) -> MTLLibrary
  def metal_library_new_function(library: MTLLibrary, name: Ptr[u8]) -> MTLFunction
  
  # Pipeline
  def metal_render_pipeline_create(device: MTLDevice, vertex_func: MTLFunction, fragment_func: MTLFunction, color_formats: Ptr[u32], color_count: usize, depth_format: u32, stencil_format: u32, sample_count: u32, alpha_to_coverage: Bool, alpha_to_one: Bool, rasterization: Bool) -> MTLRenderPipelineState
  def metal_depth_stencil_create(device: MTLDevice, depth_compare: u32, depth_write: Bool, front_stencil: Ptr[u8], back_stencil: Ptr[u8]) -> MTLDepthStencilState
  
  # Render pass
  def metal_render_pass_create(buffer: MTLCommandBuffer, color_attachments: Ptr[u8], color_count: usize, depth_attachment: Ptr[u8], stencil_attachment: Ptr[u8]) -> MTLRenderCommandEncoder
  
  # Blit encoder
  def metal_blit_encoder_create(buffer: MTLCommandBuffer) -> MTLBlitCommandEncoder
  def metal_blit_copy_buffer_to_buffer(encoder: MTLBlitCommandEncoder, src: MTLBuffer, src_offset: u64, dst: MTLBuffer, dst_offset: u64, size: u64) -> Unit
  def metal_blit_copy_buffer_to_texture(encoder: MTLBlitCommandEncoder, src: MTLBuffer, src_offset: u64, dst: MTLTexture, dst_slice: u32, dst_level: u32, dst_x: u32, dst_y: u32, dst_z: u32, width: u32, height: u32, depth: u32, bytes_per_row: u32, bytes_per_image: u32) -> Unit
  def metal_blit_copy_texture_to_buffer(encoder: MTLBlitCommandEncoder, src: MTLTexture, src_slice: u32, src_level: u32, src_x: u32, src_y: u32, src_z: u32, width: u32, height: u32, depth: u32, dst: MTLBuffer, dst_offset: u64, bytes_per_row: u32, bytes_per_image: u32) -> Unit
  def metal_blit_generate_mipmaps(encoder: MTLBlitCommandEncoder, texture: MTLTexture) -> Unit
  def metal_blit_synchronize_resource(encoder: MTLBlitCommandEncoder, resource: Ptr[u8]) -> Unit
  
  # Compute encoder
  def metal_compute_encoder_create(buffer: MTLCommandBuffer) -> MTLComputeCommandEncoder
  def metal_compute_set_pipeline_state(encoder: MTLComputeCommandEncoder, state: MTLComputePipelineState) -> Unit
  def metal_compute_set_buffer(encoder: MTLComputeCommandEncoder, index: u32, buffer: MTLBuffer, offset: u64) -> Unit
  def metal_compute_set_texture(encoder: MTLComputeCommandEncoder, index: u32, texture: MTLTexture) -> Unit
  def metal_compute_set_sampler_state(encoder: MTLComputeCommandEncoder, index: u32, sampler: MTLSamplerState) -> Unit
  def metal_compute_dispatch_threadgroups(encoder: MTLComputeCommandEncoder, tg_x: u32, tg_y: u32, tg_z: u32, t_x: u32, t_y: u32, t_z: u32) -> Unit
  def metal_compute_dispatch_threads(encoder: MTLComputeCommandEncoder, t_x: u32, t_y: u32, t_z: u32, tp_x: u32, tp_y: u32, tp_z: u32) -> Unit
  
  # Render encoder
  def metal_encoder_set_render_pipeline_state(encoder: MTLRenderCommandEncoder, state: MTLRenderPipelineState) -> Unit
  def metal_encoder_set_depth_stencil_state(encoder: MTLRenderCommandEncoder, state: MTLDepthStencilState) -> Unit
  def metal_encoder_set_vertex_buffer(encoder: MTLRenderCommandEncoder, index: u32, buffer: MTLBuffer, offset: u64) -> Unit
  def metal_encoder_set_fragment_buffer(encoder: MTLRenderCommandEncoder, index: u32, buffer: MTLBuffer, offset: u64) -> Unit
  def metal_encoder_set_vertex_texture(encoder: MTLRenderCommandEncoder, index: u32, texture: MTLTexture) -> Unit
  def metal_encoder_set_fragment_texture(encoder: MTLRenderCommandEncoder, index: u32, texture: MTLTexture) -> Unit
  def metal_encoder_set_vertex_sampler_state(encoder: MTLRenderCommandEncoder, index: u32, sampler: MTLSamplerState) -> Unit
  def metal_encoder_set_fragment_sampler_state(encoder: MTLRenderCommandEncoder, index: u32, sampler: MTLSamplerState) -> Unit
  def metal_encoder_set_viewport(encoder: MTLRenderCommandEncoder, x: f64, y: f64, width: f64, height: f64, znear: f64, zfar: f64) -> Unit
  def metal_encoder_set_scissor_rect(encoder: MTLRenderCommandEncoder, x: u32, y: u32, width: u32, height: u32) -> Unit
  def metal_encoder_set_cull_mode(encoder: MTLRenderCommandEncoder, mode: u32) -> Unit
  def metal_encoder_set_front_facing_winding(encoder: MTLRenderCommandEncoder, winding: u32) -> Unit
  def metal_encoder_set_triangle_fill_mode(encoder: MTLRenderCommandEncoder, mode: u32) -> Unit
  def metal_encoder_set_blend_color(encoder: MTLRenderCommandEncoder, r: f32, g: f32, b: f32, a: f32) -> Unit
  def metal_encoder_set_depth_bias(encoder: MTLRenderCommandEncoder, bias: f32, slope: f32, clamp: f32) -> Unit
  def metal_encoder_draw_primitives(encoder: MTLRenderCommandEncoder, primitive_type: u32, vertex_start: u32, vertex_count: u32) -> Unit
  def metal_encoder_draw_primitives_instanced(encoder: MTLRenderCommandEncoder, primitive_type: u32, vertex_start: u32, vertex_count: u32, instance_count: u32) -> Unit
  def metal_encoder_draw_indexed_primitives(encoder: MTLRenderCommandEncoder, primitive_type: u32, index_count: u32, index_type: u32, index_buffer: MTLBuffer, index_offset: u64) -> Unit
  def metal_encoder_draw_indexed_primitives_instanced(encoder: MTLRenderCommandEncoder, primitive_type: u32, index_count: u32, index_type: u32, index_buffer: MTLBuffer, index_offset: u64, instance_count: u32) -> Unit
  def metal_encoder_end_encoding(encoder: Ptr[u8]) -> Unit
  
  # Drawable
  def metal_drawable_get_texture(drawable: Ptr[u8]) -> MTLTexture
  
  # Memory
  def memcpy(dst: Ptr[u8], src: Ptr[u8], size: u64) -> Unit
  def metal_release(obj: Ptr[u8]) -> Unit
end