# ═══════════════════════════════════════════════════════════════
# EGL (Android Graphics)
# ═══════════════════════════════════════════════════════════════

type EGLDisplay = Ptr
type EGLSurface = Ptr
type EGLContext = Ptr
type EGLConfig = Ptr

struct EGLint
  value: Int32
end

# EGL Constants
def EGL_SUCCESS() -> Int32 = 0x3000
def EGL_NOT_INITIALIZED() -> Int32 = 0x3001
def EGL_BAD_ACCESS() -> Int32 = 0x3002
def EGL_BAD_ALLOC() -> Int32 = 0x3003
def EGL_BAD_ATTRIBUTE() -> Int32 = 0x3004
def EGL_BAD_CONFIG() -> Int32 = 0x3005
def EGL_BAD_CONTEXT() -> Int32 = 0x3006
def EGL_BAD_CURRENT_SURFACE() -> Int32 = 0x3007
def EGL_BAD_DISPLAY() -> Int32 = 0x3008
def EGL_BAD_MATCH() -> Int32 = 0x3009
def EGL_BAD_NATIVE_WINDOW() -> Int32 = 0x300A
def EGL_BAD_PARAMETER() -> Int32 = 0x300B
def EGL_BAD_SURFACE() -> Int32 = 0x300C

def EGL_DEFAULT_DISPLAY() -> EGLDisplay = Ptr::null()
def EGL_NO_DISPLAY() -> EGLDisplay = Ptr::null()
def EGL_NO_CONTEXT() -> EGLContext = Ptr::null()
def EGL_NO_SURFACE() -> EGLSurface = Ptr::null()

def EGL_OPENGL_ES_BIT() -> Int32 = 0x0001
def EGL_OPENGL_ES2_BIT() -> Int32 = 0x0004
def EGL_OPENGL_ES3_BIT() -> Int32 = 0x0008

