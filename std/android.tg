# Tangerine Standard Library — std::android
# Android NDK bindings
# Only available on Android targets

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, Ptr}
use std::collections::{Map}

# ═══════════════════════════════════════════════════════════════
# Android Basic Types
# ═══════════════════════════════════════════════════════════════

type JNIEnv = Ptr
type JavaVM = Ptr
type jobject = Ptr
type jclass = Ptr
type jstring = Ptr
type jarray = Ptr
type jobjectArray = Ptr
type jbooleanArray = Ptr
type jbyteArray = Ptr
type jcharArray = Ptr
type jshortArray = Ptr
type jintArray = Ptr
type jlongArray = Ptr
type jfloatArray = Ptr
type jdoubleArray = Ptr
type jthrowable = Ptr
type jmethodID = Ptr
type jfieldID = Ptr

type jboolean = UInt8
type jbyte = Int8
type jchar = UInt16
type jshort = Int16
type jint = Int32
type jlong = Int64
type jfloat = Float
type jdouble = Float

# ═══════════════════════════════════════════════════════════════
# JNI Types
# ═══════════════════════════════════════════════════════════════

struct JValue
  z: jboolean
  b: jbyte
  c: jchar
  s: jshort
  i: jint
  j: jlong
  f: jfloat
  d: jdouble
  l: jobject
end

# ═══════════════════════════════════════════════════════════════
# JNI Constants
# ═══════════════════════════════════════════════════════════════

def JNI_FALSE() -> jboolean = 0
def JNI_TRUE() -> jboolean = 1
def JNI_OK() -> Int32 = 0
def JNI_ERR() -> Int32 = -1
def JNI_COMMIT() -> Int32 = 1
def JNI_ABORT() -> Int32 = 2

def JNI_VERSION_1_1() -> Int32 = 0x00010001
def JNI_VERSION_1_2() -> Int32 = 0x00010002
def JNI_VERSION_1_4() -> Int32 = 0x00010004
def JNI_VERSION_1_6() -> Int32 = 0x00010006
def JNI_VERSION_1_8() -> Int32 = 0x00010008

