struct ANativeActivity
  callStack: ANativeActivity_onDestroy
  vm: JavaVM
  env: JNIEnv
  clazz: jobject
  internalDataPath: &Int8
  externalDataPath: &Int8
  sdkVersion: Int32
  instance: Ptr
  assetManager: jobject
end

struct AConfiguration
  ptr: Ptr
end

struct AInputQueue
  ptr: Ptr
end

struct AInputEvent
  ptr: Ptr
end

struct AKeyEvent
  ptr: Ptr
end

struct AMotionEvent
  ptr: Ptr
end

struct ALooper
  ptr: Ptr
end

struct AMessage
  ptr: Ptr
end

struct ALooperCallback
  fn: fn(fd: Int, events: Int, data: Ptr) -> Int
end

