## Tangerine Standard Library — std::locale
##
## Locale support for internationalized text processing.
## Uses CLDR (Common Locale Data Repository) data for locale-specific
## formatting, sorting, and text segmentation.
##
## Referenced by docs/unicode_policy.md §7.2.

use std::core::{Option, Result, Eq, Hash, Display}
use std::fmt::{Formatter, format}

# ═══════════════════════════════════════════════════════════════
# §1 — Locale Tag
# ═══════════════════════════════════════════════════════════════

## A BCP 47 locale tag (e.g. "en-US", "zh-Hans-CN", "ja-JP").
struct Locale
  tag: String
  language: String
  region: Option[String]
  script: Option[String]
end

## Parse a BCP 47 locale tag string.
def locale_from_tag(tag: String) -> Result[Locale, String]
  let parts = tag.split("-")
  if parts.is_empty() then
    return Result::Err("empty locale tag")
  end

  let language = parts[0].to_lowercase()
  if language.len() < 2 || language.len() > 3 then
    return Result::Err("invalid language subtag: " + language)
  end

  let mut script = Option::None
  let mut region = Option::None
  let mut idx = 1

  if idx < parts.len() && parts[idx].len() == 4 then
    script = Option::Some(to_titlecase_ascii(parts[idx]))
    idx = idx + 1
  end

  if idx < parts.len() && (parts[idx].len() == 2 || parts[idx].len() == 3) then
    region = Option::Some(parts[idx].to_uppercase())
    idx = idx + 1
  end

  Result::Ok(Locale {
    tag: tag,
    language: language,
    region: region,
    script: script
  })
end

## Get the system's current locale by reading POSIX environment variables.
@[FFI(lib: "c")]
extern def setlocale(category: Int, locale: *const u8) -> *const u8

def _locale_current() -> String
  ## Try LC_ALL, then LANG, then fall back to "en-US"
  match std::env::get_env("LC_ALL".to_string())
  when Option::Some(v) then
    if !v.is_empty() then return v end
  when Option::None then ()
  end
  match std::env::get_env("LANG".to_string())
  when Option::Some(v) then
    ## Strip encoding suffix (e.g. "en_US.UTF-8" → "en-US")
    let base = match v.find('.')
    when Option::Some(pos) then v.substring(0, pos)
    when Option::None then v
    end
    return base.replace("_", "-")
  when Option::None then ()
  end
  "en-US".to_string()
end

def current_locale() -> Locale
  let tag = _locale_current()
  match locale_from_tag(tag)
    when Result::Ok(loc) then loc
    when Result::Err(_) then en_US()
  end
end

# ═══════════════════════════════════════════════════════════════
# §2 — Well-Known Locales
# ═══════════════════════════════════════════════════════════════

def en_US() -> Locale
  Locale { tag: "en-US", language: "en", region: Option::Some("US"), script: Option::None }
end

def en_GB() -> Locale
  Locale { tag: "en-GB", language: "en", region: Option::Some("GB"), script: Option::None }
end

def de_DE() -> Locale
  Locale { tag: "de-DE", language: "de", region: Option::Some("DE"), script: Option::None }
end

def fr_FR() -> Locale
  Locale { tag: "fr-FR", language: "fr", region: Option::Some("FR"), script: Option::None }
end

def ja_JP() -> Locale
  Locale { tag: "ja-JP", language: "ja", region: Option::Some("JP"), script: Option::None }
end

def zh_Hans_CN() -> Locale
  Locale { tag: "zh-Hans-CN", language: "zh", region: Option::Some("CN"), script: Option::Some("Hans") }
end

def zh_Hant_TW() -> Locale
  Locale { tag: "zh-Hant-TW", language: "zh", region: Option::Some("TW"), script: Option::Some("Hant") }
end

def ko_KR() -> Locale
  Locale { tag: "ko-KR", language: "ko", region: Option::Some("KR"), script: Option::None }
end

def es_ES() -> Locale
  Locale { tag: "es-ES", language: "es", region: Option::Some("ES"), script: Option::None }
end

def pt_BR() -> Locale
  Locale { tag: "pt-BR", language: "pt", region: Option::Some("BR"), script: Option::None }
end

def ar_SA() -> Locale
  Locale { tag: "ar-SA", language: "ar", region: Option::Some("SA"), script: Option::None }
end

# ═══════════════════════════════════════════════════════════════
# §3 — Number Formatting
# ═══════════════════════════════════════════════════════════════

## Format an integer with locale-specific grouping separators.
def format_number(n: Int, locale: &Locale) -> String
  let negative = n < 0
  let abs_n = if negative then -n else n end
  let s = abs_n.to_string()
  let sep = grouping_separator(locale)
  let group_size = 3

  if s.len() <= group_size then
    if negative then
      return "-" + s
    else
      return s
    end
  end

  let mut result = Vec::new()
  let digits = s.chars()
  let remaining = digits.len()
  let mut idx = 0

  while idx < remaining do
    if idx > 0 && (remaining - idx) % group_size == 0 then
      result.push(sep)
    end
    result.push(digits[idx])
    idx = idx + 1
  end

  let body = String::from_chars(result)
  if negative then
    "-" + body
  else
    body
  end
end

## Get the locale-specific decimal separator.
def decimal_separator(locale: &Locale) -> Char
  match locale.language.as_str()
    when "de" then ','
    when "fr" then ','
    when "pt" then ','
    when "es" then ','
    when _ then '.'
  end
end

## Get the locale-specific digit grouping separator.
def grouping_separator(locale: &Locale) -> Char
  match locale.language.as_str()
    when "de" then '.'
    when "fr" then ' '
    when "pt" then '.'
    when "es" then '.'
    when _ then ','
  end
end

# ═══════════════════════════════════════════════════════════════
# §4 — Display Name
# ═══════════════════════════════════════════════════════════════

impl Display for Locale
  def to_string(self: &Locale) -> String
    self.tag.clone()
  end
end

impl Eq for Locale
  def eq(self: &Locale, other: &Locale) -> Bool
    self.tag == other.tag
  end
end

# ═══════════════════════════════════════════════════════════════
# Internal
# ═══════════════════════════════════════════════════════════════

def to_titlecase_ascii(s: String) -> String
  if s.is_empty() then return s end
  let chars = s.chars()
  let first = chars[0]
  let upper = if first >= 'a' && first <= 'z' then
    ((first as Int) - 32) as Char
  else
    first
  end
  let rest = s.slice(1, s.len()).to_lowercase()
  upper.to_string() + rest
end
