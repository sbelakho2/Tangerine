# Tangerine Standard Library — tg::args
# Command-Line Arguments

use std::core::{Option, Result, String, StrView, Vec, Unit, str_view_pin}

# [METADATA]
# module: tg::args
# status: stable
# effects: []

# ═══════════════════════════════════════════════════════════════
# FFI to C runtime for argc/argv
# ═══════════════════════════════════════════════════════════════

@ffi("c")
extern def tg_get_argc() -> Int
end

@ffi("c")
extern def tg_get_argv() -> Ptr[Ptr[u8]]
end

@ffi("c")
extern def _tg_arg(index: Int) -> Ptr[u8]
end

@ffi("c")
extern def _tg_arg_copy(index: Int) -> String
end

# ═══════════════════════════════════════════════════════════════
# Public API
# ═══════════════════════════════════════════════════════════════

def args() -> Vec[String]
  let argc = tg_get_argc()
  var result: Vec[String] = Vec::with_capacity(argc)

  var i = 0
  while i < argc do
    result.push(raw_arg_unchecked(i))
    i = i + 1
  end

  result
end

def raw_arg_count() -> Int
  tg_get_argc()
end

def raw_arg_unchecked(n: Int) -> String
  let arg_ptr: Ptr[u8] = _tg_arg(n)
  var arg_len: Int = 0
  while *(arg_ptr.offset(arg_len)) != 0 do
    arg_len = arg_len + 1
  end
  let arg_view = str_view_pin(arg_ptr, arg_len as UInt, 0)
  String::from_str_view(&arg_view)
end

def raw_arg_copy(n: Int) -> String
  _tg_arg_copy(n)
end

def raw_arg(n: Int) -> Option[String]
  let argc = tg_get_argc()
  if n < 0 || n >= argc then
    return Option::None
  end

  Option::Some(raw_arg_unchecked(n))
end

def arg(n: Int) -> Option[String]
  let all = args()
  if n >= 0 && n < all.len() then
    Option::Some(all[n].clone())
  else
    Option::None
  end
end

def arg_or(n: Int, default: String) -> String
  match arg(n)
  when Option::Some(s) then s
  when Option::None then default
  end  end  end
end

def arg_count() -> Int
  args().len()
end

def program_name() -> String
  arg_or(0, "tangerine".to_string())
end

def has_flag(flag: String) -> Bool
  let all = args()
  for arg in all do
    if arg == flag || arg.starts_with(flag + "=") then
      return true
    end
  end
  false
end

def has_flag_short(short: String, long: String) -> Bool
  let all = args()
  for arg in all do
    if arg == short || arg == long || arg.starts_with(short + "=") || arg.starts_with(long + "=") then
      return true
    end
  end
  false
end

def get_flag_value(flag: String) -> Option[String]
  let all = args()
  let prefix = flag + "="
  for arg in all do
    if arg.starts_with(prefix) then
      return Option::Some(arg.slice(prefix.len(), arg.len()))
    end
  end
  Option::None
end

def get_flag_value_or(flag: String, default: String) -> String
  match get_flag_value(flag)
  when Option::Some(s) then s
  when Option::None then default
  end  end
end

def flags_after_double_dash() -> Vec[String]
  let all = args()
  var found_double = false
  var result: Vec[String] = Vec::new()
  
  for arg in all do
    if found_double then
      result.push(arg)
    elsif arg == "--" then
      found_double = true
    end
  end
  
  result
end

def positional_args() -> Vec[String]
  let all = args()
  var result: Vec[String] = Vec::new()
  
  for arg in all do
    if !arg.starts_with("-") then
      result.push(arg)
    end
  end
  
  result
end

def first_positional_arg() -> Option[String]
  let pos = positional_args()
  if pos.len() > 0 then
    Option::Some(pos[0].clone())
  else
    Option::None
  end
end