## Tangerine Standard Library — std::io
## Reader/Writer traits, buffered I/O

enum IOError
  NotFound(String)
  PermissionDenied(String)
  EOF
  Interrupted
  TimedOut
  AlreadyExists(String)
  BrokenPipe
  ConnectionRefused
  Other(String)
end

impl Error for IOError
  def message(self: &IOError) -> String
    match self
    when IOError::NotFound(s) then "not found: " + s.clone()
    when IOError::PermissionDenied(s) then "permission denied: " + s.clone()
    when IOError::EOF then "unexpected end of file"
    when IOError::Interrupted then "operation interrupted"
    when IOError::TimedOut then "operation timed out"
    when IOError::AlreadyExists(s) then "already exists: " + s.clone()
    when IOError::BrokenPipe then "broken pipe"
    when IOError::ConnectionRefused then "connection refused"
    when IOError::Other(s) then s.clone()
    end
  end
end

trait Read
  def read(self: &mut Self, buf: &mut Vec[u8]) -> Result[Int, IOError]
end

trait Write
  def write(self: &mut Self, buf: &Vec[u8]) -> Result[Int, IOError]
end

trait Seek
  def seek(self: &mut Self, pos: Int) -> Result[Int, IOError]
end

struct Stdin
end

struct Stdout
end

struct Stderr
end

extern def __intrinsic_stdin() -> Stdin
extern def __intrinsic_stdout() -> Stdout
extern def __intrinsic_stderr() -> Stderr
extern def __intrinsic_read_line() -> Result[String, IOError]

def stdin() -> Stdin
  # Compiler intrinsic
  __intrinsic_stdin()
end

def stdout() -> Stdout
  # Compiler intrinsic
  __intrinsic_stdout()
end

def stderr() -> Stderr
  # Compiler intrinsic
  __intrinsic_stderr()
end

def read_line() -> Result[String, IOError]
  # Compiler intrinsic: read line from stdin
  __intrinsic_read_line()
end

# ———————————————————————————————————————————————————————————————
# Print/output free functions
# ———————————————————————————————————————————————————————————————

extern def __intrinsic_write_stdout(data: &Vec[u8]) -> Result[Int, IOError]
extern def __intrinsic_write_stderr(data: &Vec[u8]) -> Result[Int, IOError]

def print(s: String) -> Unit
  let bytes = s.as_bytes()
  let _ = __intrinsic_write_stdout(&bytes)
end

def println(s: String) -> Unit
  print(s)
  print("\n")
end

def eprint(s: String) -> Unit
  let bytes = s.as_bytes()
  let _ = __intrinsic_write_stderr(&bytes)
end

def eprintln(s: String) -> Unit
  eprint(s)
  eprint("\n")
end

# ———————————————————————————————————————————————————————————————
# Write trait implementations for Stdout/Stderr
# ———————————————————————————————————————————————————————————————

impl Write for Stdout
  def write(self: &mut Self, buf: &Vec[u8]) -> Result[Int, IOError]
    __intrinsic_write_stdout(buf)
  end
end

impl Write for Stderr
  def write(self: &mut Self, buf: &Vec[u8]) -> Result[Int, IOError]
    __intrinsic_write_stderr(buf)
  end
end

impl Read for Stdin
  def read(self: &mut Self, buf: &mut Vec[u8]) -> Result[Int, IOError]
    let line = __intrinsic_read_line()?
    let bytes = line.as_bytes()
    for b in bytes do
      buf.push(b)
    end
    Result::Ok(bytes.len())
  end
end

# ———————————————————————————————————————————————————————————————
# BufReader — Buffered reader wrapping any Read
# ———————————————————————————————————————————————————————————————

struct BufReader[R: Read]
  inner: R
  buf: Vec[u8]
  pos: Int
  cap: Int
end

def buf_reader_new[R: Read](inner: R) -> BufReader[R]
  BufReader {
    inner: inner,
    buf: Vec::with_capacity(8192),
    pos: 0,
    cap: 0,
  }
end

impl[R: Read] BufReader[R]
  def fill_buf(self: &mut Self) -> Result[&Vec[u8], IOError]
    if self.pos >= self.cap then
      self.buf.clear()
      self.pos = 0
      let n = self.inner.read(&mut self.buf)?
      self.cap = n
    end
    Result::Ok(&self.buf)
  end

  def read_line(self: &mut Self) -> Result[String, IOError]
    mut line = String::new()
    loop
      self.fill_buf()?
      if self.cap == 0 then
        if line.is_empty() then
          return Result::Err(IOError::EOF)
        end
        return Result::Ok(line)
      end
      while self.pos < self.cap do
        let ch = self.buf[self.pos] as Char
        self.pos = self.pos + 1
        if ch == '\n' then
          return Result::Ok(line)
        end
        line = line + ch.to_string()
      end
    end
  end

  def lines(self: &mut Self) -> LineIterator[R]
    LineIterator { reader: self }
  end
end

impl[R: Read] Read for BufReader[R]
  def read(self: &mut Self, buf: &mut Vec[u8]) -> Result[Int, IOError]
    self.inner.read(buf)
  end
end

struct LineIterator[R: Read]
  reader: &mut BufReader[R]
end

impl[R: Read] Iterator[Result[String, IOError]] for LineIterator[R]
  def advance(self: &mut Self) -> Option[Result[String, IOError]]
    match self.reader.read_line()
    when Result::Ok(line) then Option::Some(Result::Ok(line))
    when Result::Err(IOError::EOF) then Option::None
    when Result::Err(e) then Option::Some(Result::Err(e))
    end
  end
end

# ———————————————————————————————————————————————————————————————
# BufWriter — Buffered writer wrapping any Write
# ———————————————————————————————————————————————————————————————

struct BufWriter[W: Write]
  inner: W
  buf: Vec[u8]
end

def buf_writer_new[W: Write](inner: W) -> BufWriter[W]
  BufWriter {
    inner: inner,
    buf: Vec::with_capacity(8192),
  }
end

impl[W: Write] BufWriter[W]
  def flush(self: &mut Self) -> Result[Unit, IOError]
    if self.buf.len() > 0 then
      let _ = self.inner.write(&self.buf)?
      self.buf.clear()
    end
    Result::Ok(())
  end
end

impl[W: Write] Write for BufWriter[W]
  def write(self: &mut Self, buf: &Vec[u8]) -> Result[Int, IOError]
    for b in buf do
      self.buf.push(b)
    end
    if self.buf.len() >= 8192 then
      self.flush()?
    end
    Result::Ok(buf.len())
  end
end

impl[W: Write] Drop for BufWriter[W]
  def drop(self: &mut Self) -> Unit
    let _ = self.flush()
  end
end
