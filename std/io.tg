## Tangerine Standard Library — std::io
## Reader/Writer traits, buffered I/O

enum IOError
  NotFound(String)
  PermissionDenied(String)
  EOF
  WriteZero
  Interrupted
  TimedOut
  AlreadyExists(String)
  BrokenPipe
  ConnectionRefused
  Other(String)
end

impl Error for IOError
  def message(self: IOError) -> String
    match self
    when IOError::NotFound(s) then "not found: " + s.clone()
    when IOError::PermissionDenied(s) then "permission denied: " + s.clone()
    when IOError::EOF then "unexpected end of file"
    when IOError::WriteZero then "write returned zero bytes"
    when IOError::Interrupted then "operation interrupted"
    when IOError::TimedOut then "operation timed out"
    when IOError::AlreadyExists(s) then "already exists: " + s.clone()
    when IOError::BrokenPipe then "broken pipe"
    when IOError::ConnectionRefused then "connection refused"
    when IOError::Other(s) then s.clone()
    end
  end
end

trait Read
  def read(inout self: Self, inout buf: Vec[u8]) -> Result[Int, IOError]
end

trait Write
  def write(inout self: Self, buf: Vec[u8]) -> Result[Int, IOError]
  def flush(inout self: Self) -> Result[Unit, IOError]
end

trait Seek
  def seek(inout self: Self, pos: Int) -> Result[Int, IOError]
end

struct Stdin
  _fd: Int
end

struct Stdout
  _fd: Int
end

struct Stderr
  _fd: Int
end

def stdin() -> Stdin
  Stdin { _fd: 0 }
end

def stdout() -> Stdout
  Stdout { _fd: 1 }
end

def stderr() -> Stderr
  Stderr { _fd: 2 }
end

# POSIX read syscall
def SYS_READ() -> Int = 0

# POSIX open syscall
def SYS_OPEN() -> Int = 2

def read_line() -> Result[String, IOError]
  var bytes = Vec::new()
  var b = Vec::with_capacity(1)
  b.push(0)
  
  while true do
    let n = syscall3(SYS_READ(), 0, b.as_ptr() as Int, 1)
    if n <= 0 then
      if bytes.is_empty() then return Result::Err(IOError::EOF) else break end
    end
    let byte = b[0]
    if byte == 10 then break end # \n
    if byte == 13 then # \r
      # Peek next to see if it's \n
      let n2 = syscall3(SYS_READ(), 0, b.as_ptr() as Int, 1)
      if n2 > 0 && b[0] != 10 then
        # Not \n, push \r and the new byte (this is simplified)
        bytes.push(byte)
        bytes.push(b[0])
      end
      break 
    end
    bytes.push(byte)
  end
  Result::Ok(String::from_bytes(bytes))
end

# ———————————————————————————————————————————————————————————————
# Print/output free functions
# ———————————————————————————————————————————————————————————————

# POSIX write syscall
def SYS_WRITE() -> Int = 1

def syscall3(num: Int, arg1: Int, arg2: Int, arg3: Int) -> Int
  # Real syscall invocation - compiler emits proper syscall instruction
  __intrinsic_syscall3(num, arg1, arg2, arg3)
end

# Additional syscall wrappers for completeness
def syscall1(num: Int, arg1: Int) -> Int
  __intrinsic_syscall1(num, arg1)
end

def syscall2(num: Int, arg1: Int, arg2: Int) -> Int
  __intrinsic_syscall2(num, arg1, arg2)
end

def syscall4(num: Int, arg1: Int, arg2: Int, arg3: Int, arg4: Int) -> Int
  __intrinsic_syscall4(num, arg1, arg2, arg3, arg4)
end

def syscall5(num: Int, arg1: Int, arg2: Int, arg3: Int, arg4: Int, arg5: Int) -> Int
  __intrinsic_syscall5(num, arg1, arg2, arg3, arg4, arg5)
end

def syscall6(num: Int, arg1: Int, arg2: Int, arg3: Int, arg4: Int, arg5: Int, arg6: Int) -> Int
  __intrinsic_syscall6(num, arg1, arg2, arg3, arg4, arg5, arg6)
end

def print(s: String) -> Unit
  let _written = syscall3(SYS_WRITE(), 1, s.as_ptr() as Int, s.len() as Int)
  ()
end

def println(s: String) -> Unit
  print(s)
  print("\n")
end

def eprint(s: String) -> Unit
  let _written = syscall3(SYS_WRITE(), 2, s.as_ptr() as Int, s.len() as Int)
  ()
end

def eprintln(s: String) -> Unit
  eprint(s)
  eprint("\n")
end

# ———————————————————————————————————————————————————————————————
# Write trait implementations for Stdout/Stderr
# ———————————————————————————————————————————————————————————————

impl Write for Stdout
  def write(inout self: Self, buf: Vec[u8]) -> Result[Int, IOError]
    let n = syscall3(SYS_WRITE(), self._fd, buf.as_ptr() as Int, buf.len() as Int)
    if n < 0 then
      Result::Err(IOError::Other("write failed".to_string()))
    else
      Result::Ok(n)
    end
  end

  def flush(inout self: Self) -> Result[Unit, IOError]
    Result::Ok(())
  end
end

impl Write for Stderr
  def write(inout self: Self, buf: Vec[u8]) -> Result[Int, IOError]
    let n = syscall3(SYS_WRITE(), self._fd, buf.as_ptr() as Int, buf.len() as Int)
    if n < 0 then
      Result::Err(IOError::Other("write failed".to_string()))
    else
      Result::Ok(n)
    end
  end

  def flush(inout self: Self) -> Result[Unit, IOError]
    Result::Ok(())
  end
end

impl Read for Stdin
  def read(inout self: Self, inout buf: Vec[u8]) -> Result[Int, IOError]
    # Read one byte at a time until newline (line-buffered stdin)
    var total = 0
    var b = Vec[u8]::new()
    b.push(0u8)
    loop
      let n = syscall3(SYS_READ(), self._fd, b.as_ptr() as Int, 1)
      if n <= 0 then
        break
      end
      let byte = b[0]
      buf.push(byte)
      total = total + 1
      if byte == 10u8 then  # '\n'
        break
      end
    end
    Result::Ok(total)
  end
end

# ———————————————————————————————————————————————————————————————
# BufReader — Buffered reader wrapping any Read
# ———————————————————————————————————————————————————————————————

struct BufReader[R: Read]
  inner: R
  buf: Vec[u8]
  pos: Int
  cap: Int
end

def buf_reader_new[R: Read](inner: R) -> BufReader[R]
  BufReader {
    inner: inner,
    buf: Vec::with_capacity(8192),
    pos: 0,
    cap: 0,
  }
end

impl[R: Read] BufReader[R]
  def fill_buf(inout self: Self) -> Result[Vec[u8], IOError]
    if self.pos >= self.cap then
      self.buf.clear()
      self.pos = 0
      let _ = self.inner.read(&mut self.buf)?
      self.cap = self.buf.len()
    end
    Result::Ok(self.buf.clone())
  end

  def read_line(inout self: Self) -> Result[String, IOError]
    var line = String::new()
    loop
      self.fill_buf()?
      if self.cap == 0 then
        if line.is_empty() then
          return Result::Err(IOError::EOF)
        end
        return Result::Ok(line)
      end
      while self.pos < self.cap do
        let ch = self.buf[self.pos] as Char
        self.pos = self.pos + 1
        if ch == '\n' then
          return Result::Ok(line)
        end
        line = line + ch.to_string()
      end
    end
  end

  def lines(inout self: Self) -> LineIterator[R]
    LineIterator { reader: self }
  end
end

impl[R: Read] Read for BufReader[R]
  def read(inout self: Self, inout buf: Vec[u8]) -> Result[Int, IOError]
    # If buffer has unread data, serve from buffer first
    if self.pos < self.cap then
      var copied = 0
      while self.pos < self.cap && copied < buf.len() do
        buf[copied] = self.buf[self.pos]
        self.pos = self.pos + 1
        copied = copied + 1
      end
      return Result::Ok(copied)
    end
    
    # Buffer exhausted — if request is larger than buffer, pass through directly
    if buf.len() >= self.buf.len() then
      return self.inner.read(buf)
    end
    
    # Otherwise, refill the internal buffer and serve from it
    self.pos = 0
    self.cap = 0
    let read_result = self.inner.read(&mut self.buf)
    match read_result
    when Result::Ok(n) then
      self.cap = n
      var copied = 0
      while self.pos < self.cap && copied < buf.len() do
        buf[copied] = self.buf[self.pos]
        self.pos = self.pos + 1
        copied = copied + 1
      end
      Result::Ok(copied)
    when Result::Err(e) then Result::Err(e)
    end
  end
end

struct LineIterator[R: Read]
  reader: BufReader[R]
end

impl[R: Read] Iterator[Result[String, IOError]] for LineIterator[R]
  def advance(inout self: Self) -> Option[Result[String, IOError]]
    match self.reader.read_line()
    when Result::Ok(line) then Option::Some(Result::Ok(line))
    when Result::Err(IOError::EOF) then Option::None
    when Result::Err(e) then Option::Some(Result::Err(e))
    end
  end
end

# ———————————————————————————————————————————————————————————————
# BufWriter — Buffered writer wrapping any Write
# ———————————————————————————————————————————————————————————————

struct BufWriter[W: Write]
  inner: W
  buf: Vec[u8]
end

def buf_writer_new[W: Write](inner: W) -> BufWriter[W]
  BufWriter {
    inner: inner,
    buf: Vec::with_capacity(8192),
  }
end

impl[W: Write] BufWriter[W]
  def flush_buffer(inout self: Self) -> Result[Unit, IOError]
    if self.buf.len() > 0 then
      var written = 0
      while written < self.buf.len() do
        let remaining = self.buf.slice(written, self.buf.len())
        match self.inner.write(&remaining)
        when Result::Ok(n) then
          if n == 0 then
            return Result::Err(IOError::WriteZero)
          end
          written = written + n
        when Result::Err(e) then return Result::Err(e)
        end
      end
      self.buf.clear()
    end
    Result::Ok(())
  end
end

impl[W: Write] Write for BufWriter[W]
  def write(inout self: Self, buf: Vec[u8]) -> Result[Int, IOError]
    self.buf.extend(buf)
    if self.buf.len() >= 8192 then
      self.flush_buffer()?
    end
    Result::Ok(buf.len())
  end

  def flush(inout self: Self) -> Result[Unit, IOError]
    self.flush_buffer()
  end
end

impl[W: Write] Drop for BufWriter[W]
  def drop(inout self: Self) -> Unit
    let _ = self.flush_buffer()
  end
end
