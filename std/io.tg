## Tangerine Standard Library — std::io
## Reader/Writer traits, buffered I/O
##
## READ CONTRACT (the explicit mutable byte view): a systems Read takes an
## explicit SliceMut[u8] span whose `len` UNAMBIGUOUSLY means the WRITABLE
## EXTENT — the number of bytes the reader may fill. Every implementor
## requests exactly buf.len bytes, so a buffered read can never request
## zero bytes: BufReader::fill_buf clears its buffer and reads through the
## view onto the buffer's CAPACITY (the spare capacity is the writable
## extent). The old `inout buf: Vec[u8]` shape is gone — it made len mean
## "bytes already in the buffer" for the stdin accumulator and "writable
## capacity" for fill_buf simultaneously. The growth logic (appending into
## a Vec, line splitting) lives in the reader helpers read_to_end /
## read_line / read_exact, which own the Vec's growth via the view onto
## the exposed capacity and the resize commit.

enum IOError
  NotFound(String)
  PermissionDenied(String)
  EOF
  WriteZero
  Interrupted
  TimedOut
  AlreadyExists(String)
  BrokenPipe
  ConnectionRefused
  Other(String)
end

impl Error for IOError
  def message(self: IOError) -> String
    match self
    when IOError::NotFound(s) then "not found: " + s.clone()
    when IOError::PermissionDenied(s) then "permission denied: " + s.clone()
    when IOError::EOF then "unexpected end of file"
    when IOError::WriteZero then "write returned zero bytes"
    when IOError::Interrupted then "operation interrupted"
    when IOError::TimedOut then "operation timed out"
    when IOError::AlreadyExists(s) then "already exists: " + s.clone()
    when IOError::BrokenPipe then "broken pipe"
    when IOError::ConnectionRefused then "connection refused"
    when IOError::Other(s) then s.clone()
    end
  end
end

trait Read
  # buf is the explicit mutable byte view: buf.len is the writable
  # extent — the number of bytes this call may write into buf.ptr.
  # Returns the number of bytes written (0 = EOF; < 0 errors are
  # Result::Err). Implementors never see an ambiguous length: a view
  # onto a Vec's spare capacity has len = the capacity, so a cleared
  # buffer still requests its full capacity.
  def read(inout self: Self, buf: SliceMut[u8]) -> Result[Int, IOError]
end

trait Write
  def write(inout self: Self, buf: Vec[u8]) -> Result[Int, IOError]
  def flush(inout self: Self) -> Result[Unit, IOError]
end

trait Seek
  def seek(inout self: Self, pos: Int) -> Result[Int, IOError]
end

struct Stdin
  _fd: Int
end

struct Stdout
  _fd: Int
end

struct Stderr
  _fd: Int
end

def stdin() -> Stdin
  Stdin { _fd: 0 }
end

def stdout() -> Stdout
  Stdout { _fd: 1 }
end

def stderr() -> Stderr
  Stderr { _fd: 2 }
end

# POSIX read syscall
def SYS_READ() -> Int = 0

# POSIX open syscall
def SYS_OPEN() -> Int = 2

# ———————————————————————————————————————————————————————————————
# Read adapters — the growth logic, centralized
# ———————————————————————————————————————————————————————————————
# These helpers own ALL appending: a Read fills exactly the view's
# writable extent; the helpers grow the destination Vec by exposing
# capacity (resize exposes len onto the spare — the zero-fill is
# written over by the read), read through the sub-view onto the exposed
# region, and commit with a truncating resize (a pure len store — the
# bytes read are never re-touched). The writable extent is the SPARE
# CAPACITY (capacity - len), so after a partial read the next iteration
# exposes the remaining spare — a view is never constructed with a zero
# writable extent after a clear or a partial commit.

# Read until EOF into `out`, appending. On Err the Vec's length is
# restored to its pre-call length; on Ok the appended bytes are
# committed. Returns the total bytes appended.
#
# The writable extent is the buffer's SPARE CAPACITY: the logical length
# is exposed over the whole capacity (the zero-fill is written over by
# the read) and the view onto [start, capacity) is filled. After a
# partial read (len < capacity) the next iteration exposes the remaining
# capacity - len spare bytes, so the view is NEVER zero-length — a large
# stream that delivers short reads is accumulated until the true EOF
# instead of terminating after its first partial chunk.
def read_to_end[R: Read](inout r: R, inout out: Vec[u8]) -> Result[Int, IOError]
  var total = 0
  loop
    let start = out.len()
    if start == out.capacity() then
      out.resize(start + 4096, 0)
    end
    out.resize(out.capacity(), 0)
    let exposed = out.capacity() - start
    var view = out.as_mut_slice().sub(start, exposed as UInt)
    match r.read(view)
    when Result::Ok(n) then
      if n <= 0 then
        out.resize(start, 0)
        return Result::Ok(total)
      end
      total = total + n
      out.resize(start + n, 0)
    when Result::Err(e) then
      out.resize(start, 0)
      return Result::Err(e)
    end
  end
end

# Read one line (up to and including '\n'; a trailing '\r' is dropped)
# into an owned String. The line growth uses the same expose-read-commit
# pattern as read_to_end: the writable extent is the SPARE CAPACITY, so
# a line spanning many short reads is never truncated by a zero-length
# view after a partial chunk.
#
# OVER-CONSUMPTION CONTRACT: a generic Read has no reader-side buffer,
# so this free function CANNOT push back — when the newline falls in the
# middle of a chunk, the bytes after it have already been consumed from
# `r` and are LOST (unavailable to the next call). That is inherent to
# the free-function shape. For lossless line iteration (e.g. two
# consecutive lines delivered by one underlying read), use
# BufReader::read_line — the buffered variant retains the unread suffix
# in its internal buffer and is the sound path.
def read_line[R: Read](inout r: R) -> Result[String, IOError]
  var bytes = Vec[u8]::new()
  loop
    let start = bytes.len()
    if start == bytes.capacity() then
      bytes.resize(start + 256, 0)
    end
    bytes.resize(bytes.capacity(), 0)
    let exposed = bytes.capacity() - start
    var view = bytes.as_mut_slice().sub(start, exposed as UInt)
    let n = r.read(view)?
    if n <= 0 then
      bytes.resize(start, 0)
      if bytes.is_empty() then
        return Result::Err(IOError::EOF)
      end
      return Result::Ok(String::from_bytes(bytes))
    end
    bytes.resize(start + n, 0)
    var i = 0
    while i < n do
      let byte = bytes[start + i]
      if byte == 10u8 then # '\n'
        # The line is bytes[0 .. start+i): truncate the committed chunk
        # at the newline, then strip the '\r' that PRECEDES it — the byte
        # before the newline, not the last committed byte (which was the
        # '\n' itself).
        bytes.resize(start + i, 0)
        if !bytes.is_empty() && bytes[bytes.len() - 1] == 13u8 then
          let _ = bytes.pop()
        end
        return Result::Ok(String::from_bytes(bytes))
      end
      i = i + 1
    end
  end
end

# Read exactly `out.len` bytes into the view; EOF before the extent is
# filled is Result::Err(IOError::EOF).
def read_exact[R: Read](inout r: R, out: SliceMut[u8]) -> Result[Unit, IOError]
  var done = 0
  while done < out.len as Int do
    var view = out.sub(done, (out.len as Int - done) as UInt)
    let n = r.read(view)?
    if n <= 0 then
      return Result::Err(IOError::EOF)
    end
    done = done + n
  end
  Result::Ok(())
end

# ———————————————————————————————————————————————————————————————
# Print/output free functions
# ———————————————————————————————————————————————————————————————

# POSIX write syscall
def SYS_WRITE() -> Int = 1

# ———————————————————————————————————————————————————————————————
# Read/write syscall wrappers — pointer-typed
# ———————————————————————————————————————————————————————————————
# The wrappers take the BUFFER POINTERS, not Int addresses: sys_read
# writes into the caller's buffer (PtrMut[u8]), sys_write reads from
# the caller's buffer (Ptr[u8]). The Int-address reduction of the old
# call sites (`buf.as_ptr() as Int`) is removed — the caller passes
# `buf.as_mut_ptr()` / `buf.as_ptr()` directly.

# POSIX read syscall — the kernel WRITES into buf.
def sys_read(fd: Int, buf: PtrMut[u8], len: Int) -> Int
  __intrinsic_syscall3(SYS_READ(), fd, buf as Int, len)
end

# POSIX write syscall — the kernel READS from buf.
def sys_write(fd: Int, buf: Ptr[u8], len: Int) -> Int
  __intrinsic_syscall3(SYS_WRITE(), fd, buf as Int, len)
end

def syscall3(num: Int, arg1: Int, arg2: Int, arg3: Int) -> Int
  # Real syscall invocation - compiler emits proper syscall instruction
  __intrinsic_syscall3(num, arg1, arg2, arg3)
end

# Additional syscall wrappers for completeness
def syscall1(num: Int, arg1: Int) -> Int
  __intrinsic_syscall1(num, arg1)
end

def syscall2(num: Int, arg1: Int, arg2: Int) -> Int
  __intrinsic_syscall2(num, arg1, arg2)
end

def syscall4(num: Int, arg1: Int, arg2: Int, arg3: Int, arg4: Int) -> Int
  __intrinsic_syscall4(num, arg1, arg2, arg3, arg4)
end

def syscall5(num: Int, arg1: Int, arg2: Int, arg3: Int, arg4: Int, arg5: Int) -> Int
  __intrinsic_syscall5(num, arg1, arg2, arg3, arg4, arg5)
end

def syscall6(num: Int, arg1: Int, arg2: Int, arg3: Int, arg4: Int, arg5: Int, arg6: Int) -> Int
  __intrinsic_syscall6(num, arg1, arg2, arg3, arg4, arg5, arg6)
end

def print(s: String) -> Unit
  let _written = sys_write(1, s.as_ptr(), s.len())
end

def println(s: String) -> Unit
  print(s)
  print("\n")
end

def eprint(s: String) -> Unit
  let _written = sys_write(2, s.as_ptr(), s.len())
end

def eprintln(s: String) -> Unit
  eprint(s)
  eprint("\n")
end

# ———————————————————————————————————————————————————————————————
# Write trait implementations for Stdout/Stderr
# ———————————————————————————————————————————————————————————————

impl Write for Stdout
  def write(inout self: Self, buf: Vec[u8]) -> Result[Int, IOError]
    let n = sys_write(self._fd, buf.as_ptr(), buf.len())
    if n < 0 then
      Result::Err(IOError::Other("write failed".to_string()))
    else
      Result::Ok(n)
    end
  end

  def flush(inout self: Self) -> Result[Unit, IOError]
    Result::Ok(())
  end
end

impl Write for Stderr
  def write(inout self: Self, buf: Vec[u8]) -> Result[Int, IOError]
    let n = sys_write(self._fd, buf.as_ptr(), buf.len())
    if n < 0 then
      Result::Err(IOError::Other("write failed".to_string()))
    else
      Result::Ok(n)
    end
  end

  def flush(inout self: Self) -> Result[Unit, IOError]
    Result::Ok(())
  end
end

impl Read for Stdin
  def read(inout self: Self, buf: SliceMut[u8]) -> Result[Int, IOError]
    # The view's len IS the writable extent: request exactly that many
    # bytes. The line-buffered growth of the old accumulator lives in the
    # read_line / read_to_end helpers, which own the Vec growth.
    let n = sys_read(self._fd, buf.ptr, buf.len as Int)
    if n < 0 then
      Result::Err(IOError::Other("read from stdin failed".to_string()))
    else
      Result::Ok(n)
    end
  end
end

# ———————————————————————————————————————————————————————————————
# BufReader — Buffered reader wrapping any Read
# ———————————————————————————————————————————————————————————————

struct BufReader[R: Read]
  inner: R
  buf: Vec[u8]
  pos: Int
  cap: Int
end

def buf_reader_new[R: Read](inner: R) -> BufReader[R]
  BufReader {
    inner: inner,
    buf: Vec::with_capacity(8192),
    pos: 0,
    cap: 0,
  }
end

impl[R: Read] BufReader[R]
  # Refill the internal buffer when exhausted: clear, then expose the
  # buffer's CAPACITY as the writable extent (the resize grows the
  # logical length onto the spare; the zero-fill is written over by the
  # read), read through the view, and commit with a truncating resize
  # (a pure len store — never a zero-length read after the clear).
  def refill(inout self: Self) -> Result[Unit, IOError]
    self.buf.clear()
    self.pos = 0
    self.cap = 0
    let capacity = self.buf.capacity()
    if capacity > 0 then
      self.buf.resize(capacity, 0)
      let n = self.inner.read(self.buf.as_mut_slice())?
      self.buf.resize(n, 0)
      self.cap = n
    end
    Result::Ok(())
  end

  def fill_buf(inout self: Self) -> Result[Vec[u8], IOError]
    if self.pos >= self.cap then
      self.refill()?
    end
    Result::Ok(self.buf.clone())
  end

  # The buffered, lossless read_line — the sound path for line
  # iteration: the unread suffix AFTER the '\n' stays in the internal
  # buffer (pos..cap) and is served by the NEXT call, so two consecutive
  # lines from one underlying read are never lost. A trailing '\r'
  # before the '\n' is stripped from the returned line.
  def read_line(inout self: Self) -> Result[String, IOError]
    var line = Vec[u8]::new()
    loop
      self.fill_buf()?
      if self.cap == 0 then
        if line.is_empty() then
          return Result::Err(IOError::EOF)
        end
        return Result::Ok(String::from_bytes(line))
      end
      while self.pos < self.cap do
        let byte = self.buf[self.pos]
        self.pos = self.pos + 1
        if byte == 10u8 then # '\n'
          # The '\n' is never pushed into `line`, so line's last byte IS
          # the byte before the newline — drop a trailing '\r' there.
          if !line.is_empty() && line[line.len() - 1] == 13u8 then
            let _ = line.pop()
          end
          return Result::Ok(String::from_bytes(line))
        end
        line.push(byte)
      end
    end
  end

  def lines(inout self: Self) -> LineIterator[R]
    LineIterator { reader: self }
  end
end

impl[R: Read] Read for BufReader[R]
  def read(inout self: Self, buf: SliceMut[u8]) -> Result[Int, IOError]
    # If buffer has unread data, serve from buffer first
    if self.pos < self.cap then
      var copied = 0
      while self.pos < self.cap && copied < buf.len as Int do
        unsafe "buffered byte copy into the caller's view" do
          buf.write(copied, self.buf[self.pos])
        end
        self.pos = self.pos + 1
        copied = copied + 1
      end
      return Result::Ok(copied)
    end

    # Buffer exhausted — if the request is at least the buffer's
    # capacity, pass through directly (the view carries its own extent).
    if buf.len as Int >= self.buf.capacity() then
      return self.inner.read(buf)
    end

    # Otherwise refill the internal buffer and serve from it
    self.refill()?
    var copied = 0
    while self.pos < self.cap && copied < buf.len as Int do
      unsafe "buffered byte copy into the caller's view" do
        buf.write(copied, self.buf[self.pos])
      end
      self.pos = self.pos + 1
      copied = copied + 1
    end
    Result::Ok(copied)
  end
end

struct LineIterator[R: Read]
  reader: BufReader[R]
end

impl[R: Read] Iterator[Result[String, IOError]] for LineIterator[R]
  def advance(inout self: Self) -> Option[Result[String, IOError]]
    match self.reader.read_line()
    when Result::Ok(line) then Option::Some(Result::Ok(line))
    when Result::Err(IOError::EOF) then Option::None
    when Result::Err(e) then Option::Some(Result::Err(e))
    end
  end
end

# ———————————————————————————————————————————————————————————————
# BufWriter — Buffered writer wrapping any Write
# ———————————————————————————————————————————————————————————————

struct BufWriter[W: Write]
  inner: W
  buf: Vec[u8]
end

def buf_writer_new[W: Write](inner: W) -> BufWriter[W]
  BufWriter {
    inner: inner,
    buf: Vec::with_capacity(8192),
  }
end

impl[W: Write] BufWriter[W]
  def flush_buffer(inout self: Self) -> Result[Unit, IOError]
    if self.buf.len() > 0 then
      var written = 0
      while written < self.buf.len() do
        let remaining = self.buf.slice(written, self.buf.len())
        match self.inner.write(&remaining)
        when Result::Ok(n) then
          if n == 0 then
            return Result::Err(IOError::WriteZero)
          end
          written = written + n
        when Result::Err(e) then return Result::Err(e)
        end
      end
      self.buf.clear()
    end
    Result::Ok(())
  end
end

impl[W: Write] Write for BufWriter[W]
  def write(inout self: Self, buf: Vec[u8]) -> Result[Int, IOError]
    self.buf.extend(buf)
    if self.buf.len() >= 8192 then
      self.flush_buffer()?
    end
    Result::Ok(buf.len())
  end

  def flush(inout self: Self) -> Result[Unit, IOError]
    self.flush_buffer()
  end
end

impl[W: Write] Drop for BufWriter[W]
  def drop(inout self: Self) -> Unit
    let _ = self.flush_buffer()
  end
end
