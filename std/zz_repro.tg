enum TokenKind
  At
  Budget
end

def f(kind: TokenKind, p: Int) -> Int
  var budget_opt = 0
  while budget_opt < 10 do
    match kind
    when TokenKind::At then
      let saved_pos = p
      if at(p) then
        let bspan = p
        match Option::Some(bspan)
        when Option::Some(b) then
          budget_opt = b
        when Option::None then break
        end
      else
        budget_opt = saved_pos
        break
      end
    when _ then break
    end
  end
  budget_opt
end

def at(x: Int) -> Bool
  x > 0
end

def g() -> Int
  f(TokenKind::At, 1)
end
