## Tangerine Standard Library — std::fft
## Fast Fourier Transform
##
## The public API of this module (nothing more — the header lists the
## actual functions below; there are no optimizers, no ML/image/audio
## feature sets, no synthesis/filter-bank catalogs here):
##
##   Complex — the complex number type (new/zero/one/from_polar,
##       real/imag/abs/arg/conj/norm, add/sub/mul/div/scale/sqrt/exp/log)
##   fft / fft_complex / fft_in_place — the radix-2 DFT and its inverse
##       ifft / ifft_real
##   rfft / irfft — real-input FFT and its inverse
##   fft2d / ifft2d — separable two-dimensional transform
##   dct / idct / dst / idst — discrete cosine/sine transforms
##   hilbert — the analytic signal (Hilbert transform)
##   convolve / correlate / auto_correlate — convolution and correlation
##   psd / psd_frequencies — power spectral density estimation
##   STFTResult / stft / istft — the short-time Fourier transform
##   WindowType / create_window / create_window_with_params — windowing
##       (Hann, Hamming, Blackman, Bartlett, Kaiser, Gaussian, ...)
##   goertzel — the single-bin DFT (Goertzel algorithm)
##   chirp_z — the Chirp Z-transform (single-bin evaluation)
##   upsample / downsample / resample — sample-rate conversion
##   low_pass_filter / high_pass_filter / band_pass_filter / notch_filter
##       — the finite-impulse-response frequency filters
##   find_peaks / find_peaks_complex — peak detection
##   estimate_fundamental / estimate_frequency_fft — pitch/frequency
##       estimation via the FFT peak
##
## Scope: the transforms are scalar reference implementations (no SIMD
## acceleration); sizes are not restricted to powers of two (the
## radix-2 kernel pads internally where needed).
use std::collections::Vec
use std::math::{sin, cos, sqrt, PI}

use std::complex::Complex

# ———————————————————————————————————————————————————————————————
# Complex Number Operations
# ———————————————————————————————————————————————————————————————

pub struct Complex
  re: f64
  im: f64
end

impl Complex
  pub fn new(re: f64, im: f64) -> Complex
    Complex { re: re, im: im }
  end
  
  pub fn zero() -> Complex
    Complex { re: 0.0, im: 0.0 }
  end
  
  pub fn one() -> Complex
    Complex { re: 1.0, im: 0.0 }
  end
  
  pub fn from_polar(r: f64, theta: f64) -> Complex
    Complex { re: r * cos(theta), im: r * sin(theta) }
  end
  
  pub fn real(self: Self) -> f64
    self.re
  end
  
  pub fn imag(self: Self) -> f64
    self.im
  end
  
  pub fn abs(self: Self) -> f64
    sqrt(self.re * self.re + self.im * self.im)
  end
  
  pub fn arg(self: Self) -> f64
    std::math::atan2(self.im, self.re)
  end
  
  pub fn conj(self: Self) -> Complex
    Complex { re: self.re, im: -self.im }
  end
  
  pub fn norm(self: Self) -> f64
    self.re * self.re + self.im * self.im
  end
  
  pub fn add(self: Self, other: Complex) -> Complex
    Complex { re: self.re + other.re, im: self.im + other.im }
  end
  
  pub fn sub(self: Self, other: Complex) -> Complex
    Complex { re: self.re - other.re, im: self.im - other.im }
  end
  
  pub fn mul(self: Self, other: Complex) -> Complex
    Complex {
      re: self.re * other.re - self.im * other.im,
      im: self.re * other.im + self.im * other.re
    }
  end
  
  pub fn div(self: Self, other: Complex) -> Complex
    let denom = other.norm()
    Complex {
      re: (self.re * other.re + self.im * other.im) / denom,
      im: (self.im * other.re - self.re * other.im) / denom
    }
  end
  
  pub fn scale(self: Self, s: f64) -> Complex
    Complex { re: self.re * s, im: self.im * s }
  end
  
  pub fn sqrt(self: Self) -> Complex
    let r = self.abs()
    let a = self.arg() / 2.0
    Complex::from_polar(sqrt(r), a)
  end
  
  pub fn exp(self: Self) -> Complex
    let exp_re = std::math::exp(self.re)
    Complex {
      re: exp_re * cos(self.im),
      im: exp_re * sin(self.im)
    }
  end
  
  pub fn log(self: Self) -> Complex
    Complex {
      re: std::math::ln(self.abs()),
      im: self.arg()
    }
  end
end

# ———————————————————————————————————————————————————————————————
# 1D FFT
# ———————————————————————————————————————————————————————————————

pub fn fft(data: Vec[f64]) -> Vec[Complex]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let mut result: Vec[Complex] = Vec::with_capacity(n)
  for i in 0..n do
    result.push(Complex::new(data[i], 0.0))
  end
  
  fft_in_place(&mut result)
  result
end

pub fn fft_complex(data: Vec[Complex]) -> Vec[Complex]
  var result = Vec::new()
  for elem in data do
    result.push(elem.clone())
  end
  fft_in_place(&mut result)
  result
end

pub def fft_in_place(inout data: Vec[Complex])
  let n = data.len()
  if n <= 1 then return end
  
  # Bit-reversal permutation
  let mut j = 0
  for i in 0..n do
    if i < j then
      let temp = data[i]
      data[i] = data[j]
      data[j] = temp
    end
    
    let mut k = n >> 1
    while k != 0 && k <= j do
      j -= k
      k >>= 1
    end
    j += k
  end
  
  # Cooley-Tukey iterative FFT
  let mut len = 2
  while len <= n do
    let angle = -2.0 * PI / (len as f64)
    let wlen = Complex::from_polar(1.0, angle)
    
    let mut i = 0
    while i < n do
      let mut w = Complex::one()
      for j in 0..(len / 2) do
        let u = data[i + j]
        let v = data[i + j + len / 2].mul(&w)
        data[i + j] = u.add(&v)
        data[i + j + len / 2] = u.sub(&v)
        w = w.mul(&wlen)
      end
      i += len
    end
    
    len <<= 1
  end
end

# ———————————————————————————————————————————————————————————————
# Inverse FFT
# ———————————————————————————————————————————————————————————————

pub fn ifft(data: Vec[Complex]) -> Vec[Complex]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  var result = Vec::new()
  for elem in data do
    result.push(elem.clone())
  end
  
  # Conjugate
  for i in 0..n do
    result[i] = result[i].conj()
  end
  
  # Apply FFT
  fft_in_place(&mut result)
  
  # Conjugate and scale
  let scale = 1.0 / (n as f64)
  for i in 0..n do
    result[i] = result[i].conj().scale(scale)
  end
  
  result
end

pub fn ifft_real(data: Vec[Complex]) -> Vec[f64]
  let result = ifft(data)
  result.iter().map(|c| c.re).collect()
end

# ———————————————————————————————————————————————————————————————
# Real FFT (optimized for real input)
# ———————————————————————————————————————————————————————————————

pub fn rfft(data: Vec[f64]) -> Vec[Complex]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  # For real input, we only need n/2 + 1 complex output
  let output_len = n / 2 + 1
  let mut result: Vec[Complex] = Vec::with_capacity(output_len)
  
  # Use standard FFT and take advantage of conjugate symmetry
  let full_fft = fft(data)
  for i in 0..output_len do
    result.push(full_fft[i])
  end
  
  result
end

pub fn irfft(data: Vec[Complex], n: usize) -> Vec[f64]
  if data.len() == 0 then return Vec::new() end
  
  # Reconstruct full FFT from half
  let mut full: Vec[Complex] = Vec::with_capacity(n)
  for i in 0..data.len() do
    full.push(data[i])
  end
  
  for i in 1..(n - data.len() + 1) do
    full.push(data[data.len() - 1 - i].conj())
  end
  
  ifft_real(&full)
end

# ———————————————————————————————————————————————————————————————
# 2D FFT
# ———————————————————————————————————————————————————————————————

pub fn fft2d(data: Vec[Vec[f64]]) -> Vec[Vec[Complex]]
  let rows = data.len()
  if rows == 0 then return Vec::new() end
  let cols = data[0].len()
  if cols == 0 then return Vec::new() end
  
  let mut result: Vec[Vec[Complex]] = Vec::with_capacity(rows)
  for _ in 0..rows do
    result.push(Vec::with_capacity(cols))
  end
  
  # FFT on rows
  for i in 0..rows do
    result[i] = fft(&data[i])
  end
  
  # FFT on columns (transpose, FFT, transpose back)
  let mut col: Vec[Complex] = Vec::with_capacity(rows)
  for j in 0..cols do
    col.clear()
    for i in 0..rows do
      col.push(result[i][j])
    end
    fft_in_place(&mut col)
    for i in 0..rows do
      result[i][j] = col[i]
    end
  end
  
  result
end

pub fn ifft2d(data: Vec[Vec[Complex]]) -> Vec[Vec[f64]]
  let rows = data.len()
  if rows == 0 then return Vec::new() end
  let cols = data[0].len()
  if cols == 0 then return Vec::new() end
  
  var result: Vec[Vec[Complex]] = Vec::new()
  for row in data do
    var row_clone = Vec::new()
    for elem in row do
      row_clone.push(elem.clone())
    end
    result.push(row_clone)
  end
  
  # IFFT on columns
  let mut col: Vec[Complex] = Vec::with_capacity(rows)
  for j in 0..cols do
    col.clear()
    for i in 0..rows do
      col.push(result[i][j])
    end
    let col_ifft = ifft(&col)
    for i in 0..rows do
      result[i][j] = col_ifft[i]
    end
  end
  
  # IFFT on rows
  let mut real_result: Vec[Vec[f64]] = Vec::with_capacity(rows)
  for i in 0..rows do
    real_result.push(ifft_real(&result[i]))
  end
  
  real_result
end

# ———————————————————————————————————————————————————————————————
# Discrete Cosine Transform (DCT-II)
# ———————————————————————————————————————————————————————————————

pub fn dct(data: Vec[f64]) -> Vec[f64]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let mut result: Vec[f64] = Vec::with_capacity(n)
  let scale = sqrt(2.0 / (n as f64))
  
  for k in 0..n do
    let mut sum: f64 = 0.0
    for i in 0..n do
      let angle = PI * (k as f64) * ((2.0 * i as f64 + 1.0) / (2.0 * n as f64))
      sum += data[i] * cos(angle)
    end
    let k_scale = if k == 0 then 1.0 / sqrt(2.0) else 1.0
    result.push(sum * scale * k_scale)
  end
  
  result
end

pub fn idct(data: Vec[f64]) -> Vec[f64]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let mut result: Vec[f64] = Vec::with_capacity(n)
  let scale = sqrt(2.0 / (n as f64))
  
  for i in 0..n do
    let mut sum: f64 = 0.0
    for k in 0..n do
      let angle = PI * (k as f64) * ((2.0 * i as f64 + 1.0) / (2.0 * n as f64))
      let k_scale = if k == 0 then 1.0 / sqrt(2.0) else 1.0
      sum += k_scale * data[k] * cos(angle)
    end
    result.push(sum * scale)
  end
  
  result
end

# ———————————————————————————————————————————————————————————————
# Discrete Sine Transform (DST)
# ———————————————————————————————————————————————————————————————

pub fn dst(data: Vec[f64]) -> Vec[f64]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let mut result: Vec[f64] = Vec::with_capacity(n)
  let scale = sqrt(2.0 / (n as f64))
  
  for k in 0..n do
    let mut sum: f64 = 0.0
    for i in 0..n do
      let angle = PI * ((k + 1) as f64) * ((i + 1) as f64) / ((n + 1) as f64)
      sum += data[i] * sin(angle)
    end
    result.push(sum * scale)
  end
  
  result
end

pub fn idst(data: Vec[f64]) -> Vec[f64]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let mut result: Vec[f64] = Vec::with_capacity(n)
  let scale = 2.0 / ((n + 1) as f64)
  
  for i in 0..n do
    let mut sum: f64 = 0.0
    for k in 0..n do
      let angle = PI * ((k + 1) as f64) * ((i + 1) as f64) / ((n + 1) as f64)
      sum += data[k] * sin(angle)
    end
    result.push(sum * scale)
  end
  
  result
end

# ———————————————————————————————————————————————————————————————
# Hilbert Transform
# ———————————————————————————————————————————————————————————————

pub fn hilbert(data: Vec[f64]) -> Vec[Complex]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  # Compute FFT
  let mut freq = fft(data)
  
  # Multiply by -i * sign(omega)
  let half = n / 2
  for i in 1..half do
    freq[i] = freq[i].mul(&Complex::new(0.0, -1.0))
  end
  for i in (half + 1)..n do
    freq[i] = freq[i].mul(&Complex::new(0.0, 1.0))
  end
  
  # Inverse FFT
  ifft(&freq)
end

# ———————————————————————————————————————————————————————————————
# Convolution via FFT
# ———————————————————————————————————————————————————————————————

pub fn convolve(a: Vec[f64], b: Vec[f64]) -> Vec[f64]
  let len_a = a.len()
  let len_b = b.len()
  let result_len = len_a + len_b - 1
  
  # Find next power of 2
  let mut n = 1
  while n < result_len do
    n <<= 1
  end
  
  # Pad inputs
  let mut a_padded: Vec[Complex] = Vec::with_capacity(n)
  let mut b_padded: Vec[Complex] = Vec::with_capacity(n)
  
  for i in 0..len_a do
    a_padded.push(Complex::new(a[i], 0.0))
  end
  for i in len_a..n do
    a_padded.push(Complex::zero())
  end
  
  for i in 0..len_b do
    b_padded.push(Complex::new(b[i], 0.0))
  end
  for i in len_b..n do
    b_padded.push(Complex::zero())
  end
  
  # FFT both
  fft_in_place(&mut a_padded)
  fft_in_place(&mut b_padded)
  
  # Multiply in frequency domain
  for i in 0..n do
    a_padded[i] = a_padded[i].mul(&b_padded[i])
  end
  
  # Inverse FFT
  let result_complex = ifft(&a_padded)
  
  # Extract real part
  let mut result: Vec[f64] = Vec::with_capacity(result_len)
  for i in 0..result_len do
    result.push(result_complex[i].real())
  end
  
  result
end

# ———————————————————————————————————————————————————————————————
# Correlation via FFT
# ———————————————————————————————————————————————————————————————

pub fn correlate(a: Vec[f64], b: Vec[f64]) -> Vec[f64]
  let len_a = a.len()
  let len_b = b.len()
  let result_len = len_a + len_b - 1
  
  # Find next power of 2
  let mut n = 1
  while n < result_len do
    n <<= 1
  end
  
  # Pad inputs
  let mut a_padded: Vec[Complex] = Vec::with_capacity(n)
  let mut b_padded: Vec[Complex] = Vec::with_capacity(n)
  
  for i in 0..len_a do
    a_padded.push(Complex::new(a[i], 0.0))
  end
  for i in len_a..n do
    a_padded.push(Complex::zero())
  end
  
  for i in 0..len_b do
    b_padded.push(Complex::new(b[i], 0.0))
  end
  for i in len_b..n do
    b_padded.push(Complex::zero())
  end
  
  # FFT both
  fft_in_place(&mut a_padded)
  fft_in_place(&mut b_padded)
  
  # Multiply with conjugate in frequency domain
  for i in 0..n do
    a_padded[i] = a_padded[i].mul(&b_padded[i].conj())
  end
  
  # Inverse FFT
  let result_complex = ifft(&a_padded)
  
  # Extract real part
  let mut result: Vec[f64] = Vec::with_capacity(result_len)
  for i in 0..result_len do
    result.push(result_complex[i].real())
  end
  
  result
end

pub fn auto_correlate(data: Vec[f64]) -> Vec[f64]
  correlate(data, data)
end

# ———————————————————————————————————————————————————————————————
# Power Spectral Density
# ———————————————————————————————————————————————————————————————

pub fn psd(data: Vec[f64], sample_rate: f64) -> Vec[f64]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let freq = fft(data)
  let mut power: Vec[f64] = Vec::with_capacity(n / 2 + 1)
  
  for i in 0..=(n / 2) do
    power.push(freq[i].norm() / (n as f64))
  end
  
  power
end

pub fn psd_frequencies(n: usize, sample_rate: f64) -> Vec[f64]
  let mut freqs: Vec[f64] = Vec::with_capacity(n / 2 + 1)
  let df = sample_rate / (n as f64)
  
  for i in 0..=(n / 2) do
    freqs.push((i as f64) * df)
  end
  
  freqs
end

# ———————————————————————————————————————————————————————————————
# Short-Time Fourier Transform (STFT)
# ———————————————————————————————————————————————————————————————

pub struct STFTResult
  frames: Vec[Vec[Complex]]
  hop_size: usize
  window_size: usize
end

impl STFTResult
  pub fn frames(self: Self) -> Vec[Vec[Complex]]
    var out = Vec::new()
    for row in self.frames do
      var row_clone = Vec::new()
      for elem in row do
        row_clone.push(elem.clone())
      end
      out.push(row_clone)
    end
    out
  end
  
  pub fn hop_size(self: Self) -> usize
    self.hop_size
  end
  
  pub fn window_size(self: Self) -> usize
    self.window_size
  end
  
  pub fn num_frames(self: Self) -> usize
    self.frames.len()
  end
  
  pub fn num_bins(self: Self) -> usize
    if self.frames.is_empty() then 0 else self.frames[0].len()
  end
end

pub fn stft(data: Vec[f64], window_size: usize, hop_size: usize, window_type: WindowType) -> STFTResult
  let n = data.len()
  if n == 0 || window_size == 0 then
    return STFTResult {
      frames: Vec::new(),
      hop_size: hop_size,
      window_size: window_size
    }
  end
  
  let window = create_window(window_size, window_type)
  let mut frames: Vec[Vec[Complex]] = Vec::new()
  
  let mut start = 0
  while start + window_size <= n do
    let mut frame: Vec[f64] = Vec::with_capacity(window_size)
    for i in 0..window_size do
      frame.push(data[start + i] * window[i])
    end
    frames.push(fft(&frame))
    start += hop_size
  end
  
  STFTResult {
    frames: frames,
    hop_size: hop_size,
    window_size: window_size
  }
end

pub fn istft(stft_result: STFTResult, window_type: WindowType) -> Vec[f64]
  if stft_result.frames.is_empty() then return Vec::new() end
  
  let window_size = stft_result.window_size
  let hop_size = stft_result.hop_size
  let num_frames = stft_result.num_frames()
  
  # Calculate output length
  let output_len = window_size + (num_frames - 1) * hop_size
  let mut result: Vec[f64] = vec![0.0; output_len]
  let mut window_sum: Vec[f64] = vec![0.0; output_len]
  let window = create_window(window_size, window_type)
  
  for (frame_idx, frame) in stft_result.frames.iter().enumerate() do
    let time_data = ifft_real(frame)
    let start = frame_idx * hop_size
    
    for i in 0..window_size do
      result[start + i] += time_data[i] * window[i]
      window_sum[start + i] += window[i] * window[i]
    end
  end
  
  # Normalize by window sum
  for i in 0..output_len do
    if window_sum[i] > 1e-10 then
      result[i] /= window_sum[i]
    end
  end
  
  result
end

# ———————————————————————————————————————————————————————————————
# Window Functions
# ———————————————————————————————————————————————————————————————

pub enum WindowType
  Rectangular
  Hann
  Hamming
  Blackman
  BlackmanHarris
  Bartlett
  Welch
  Kaiser
  Gaussian
  Flattop
end

pub fn create_window(n: usize, window_type: WindowType) -> Vec[f64]
  create_window_with_params(n, window_type, 0.5, 2.0)
end

pub fn create_window_with_params(n: usize, window_type: WindowType, alpha: f64, beta: f64) -> Vec[f64]
  if n == 0 then return Vec::new() end
  
  let mut window: Vec[f64] = Vec::with_capacity(n)
  
  match window_type
    when WindowType::Rectangular then
      for _ in 0..n do
        window.push(1.0)
      end
    when WindowType::Hann then
      for i in 0..n do
        let val = 0.5 * (1.0 - cos(2.0 * PI * (i as f64) / ((n - 1) as f64)))
        window.push(val)
      end
    when WindowType::Hamming then
      for i in 0..n do
        let val = 0.54 - 0.46 * cos(2.0 * PI * (i as f64) / ((n - 1) as f64))
        window.push(val)
      end
    when WindowType::Blackman then
      for i in 0..n do
        let x = (i as f64) / ((n - 1) as f64)
        let val = 0.42 - 0.5 * cos(2.0 * PI * x) + 0.08 * cos(4.0 * PI * x)
        window.push(val)
      end
    when WindowType::BlackmanHarris then
      for i in 0..n do
        let x = (i as f64) / ((n - 1) as f64)
        let val = 0.35875 - 0.48829 * cos(2.0 * PI * x) + 0.14128 * cos(4.0 * PI * x) - 0.01168 * cos(6.0 * PI * x)
        window.push(val)
      end
    when WindowType::Bartlett then
      for i in 0..n do
        let val = if i <= (n - 1) / 2 then
          2.0 * (i as f64) / ((n - 1) as f64)
        else
          2.0 - 2.0 * (i as f64) / ((n - 1) as f64)
        window.push(val)
      end
    when WindowType::Welch then
      for i in 0..n do
        let x = ((i as f64) - ((n - 1) as f64) / 2.0) / (((n - 1) as f64) / 2.0)
        let val = 1.0 - x * x
        window.push(val)
      end
    when WindowType::Kaiser then
      for i in 0..n do
        let x = 2.0 * (i as f64) / ((n - 1) as f64) - 1.0
        let val = bessel_i0(beta * sqrt(1.0 - x * x)) / bessel_i0(beta)
        window.push(val)
      end
    when WindowType::Gaussian then
      let sigma_sq = 2.0 * 2.0
      let center = (n - 1) as f64 / 2.0
      for i in 0..n do
        let x = (i as f64) - center
        let val = std::math::exp(-0.5 * x * x / sigma_sq)
        window.push(val)
      end
    when WindowType::Flattop then
      let a0 = 0.21557895
      let a1 = 0.41663158
      let a2 = 0.277263158
      let a3 = 0.083578947
      let a4 = 0.006947368
      for i in 0..n do
        let x = 2.0 * PI * (i as f64) / ((n - 1) as f64)
        let val = a0 - a1 * cos(x) + a2 * cos(2.0 * x) - a3 * cos(3.0 * x) + a4 * cos(4.0 * x)
        window.push(val)
      end
  end
  
  window
end

# ———————————————————————————————————————————————————————————————
# Goertzel Algorithm (single bin DFT)
# ———————————————————————————————————————————————————————————————

pub fn goertzel(data: Vec[f64], target_freq: usize) -> Complex
  let n = data.len()
  if n == 0 then return Complex::zero() end
  
  let k = target_freq
  let omega = 2.0 * PI * (k as f64) / (n as f64)
  let coeff = Complex::from_polar(1.0, omega)
  
  let mut s0: f64 = 0.0
  let mut s1: f64 = 0.0
  let mut s2: f64 = 0.0
  
  for i in 0..n do
    s0 = data[i] + coeff.real() * s1 - s2
    s2 = s1
    s1 = s0
  end
  
  Complex::new(s1 - s2 * coeff.real(), s1 * coeff.imag())
end

# ———————————————————————————————————————————————————————————————
# Chirp Z-Transform
# ———————————————————————————————————————————————————————————————

pub fn chirp_z(data: Vec[f64], freq: f64, sample_rate: f64) -> Complex
  let n = data.len()
  if n == 0 then return Complex::zero() end
  
  let omega = 2.0 * PI * freq / sample_rate
  let mut result = Complex::zero()
  
  for k in 0..n do
    let angle = omega * (k as f64)
    let twiddle = Complex::from_polar(1.0, -angle)
    result = result.add(&Complex::new(data[k], 0.0).mul(&twiddle))
  end
  
  result
end

# ———————————————————————————————————————————————————————————————
# Resampling
# ———————————————————————————————————————————————————————————————

pub fn upsample(data: Vec[f64], factor: usize) -> Vec[f64]
  if factor == 0 then return Vec::new() end
  
  let n = data.len()
  let mut result: Vec[f64] = vec![0.0; n * factor]
  
  for i in 0..n do
    result[i * factor] = data[i]
  end
  
  # Apply low-pass filter to interpolate
  let filtered = low_pass_filter(&result, 0.5 / (factor as f64))
  filtered
end

pub fn downsample(data: Vec[f64], factor: usize) -> Vec[f64]
  if factor == 0 then return data.clone() end
  
  let n = data.len() / factor
  let mut result: Vec[f64] = Vec::with_capacity(n)
  
  # Apply anti-aliasing filter first
  let filtered = low_pass_filter(data, 0.5 / (factor as f64))
  
  for i in 0..n do
    result.push(filtered[i * factor])
  end
  
  result
end

pub fn resample(data: Vec[f64], from_rate: f64, to_rate: f64) -> Vec[f64]
  if from_rate == to_rate then return data.clone() end
  
  let ratio = to_rate / from_rate
  
  if ratio > 1.0 then
    # Upsampling
    let factor = ratio as usize
    upsample(data, factor)
  else
    # Downsampling
    let factor = (1.0 / ratio) as usize
    downsample(data, factor)
  end
end

# ———————————————————————————————————————————————————————————————
# Filtering
# ———————————————————————————————————————————————————————————————

pub fn low_pass_filter(data: Vec[f64], cutoff: f64) -> Vec[f64]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  # Design filter using FFT
  let mut freq = fft(data)
  
  # Apply frequency domain filter
  let half = n / 2
  for i in (half as f64 * cutoff as usize + 1)..half do
    freq[i] = Complex::zero()
  end
  for i in half..(n - (half as f64 * cutoff as usize)) do
    freq[i] = Complex::zero()
  end
  
  ifft_real(&freq)
end

pub fn high_pass_filter(data: Vec[f64], cutoff: f64) -> Vec[f64]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let mut freq = fft(data)
  
  let half = n / 2
  let cutoff_bin = (half as f64 * cutoff) as usize
  
  for i in 0..cutoff_bin do
    freq[i] = Complex::zero()
  end
  for i in (n - cutoff_bin)..n do
    freq[i] = Complex::zero()
  end
  
  ifft_real(&freq)
end

pub fn band_pass_filter(data: Vec[f64], low_cutoff: f64, high_cutoff: f64) -> Vec[f64]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let mut freq = fft(data)
  
  let half = n / 2
  let low_bin = (half as f64 * low_cutoff) as usize
  let high_bin = (half as f64 * high_cutoff) as usize
  
  for i in 0..low_bin do
    freq[i] = Complex::zero()
  end
  for i in high_bin..(n - low_bin) do
    freq[i] = Complex::zero()
  end
  for i in (n - low_bin + 1)..n do
    freq[i] = Complex::zero()
  end
  
  ifft_real(&freq)
end

pub fn notch_filter(data: Vec[f64], notch_freq: f64, bandwidth: f64) -> Vec[f64]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let mut freq = fft(data)
  
  let half = n / 2
  let center_bin = (half as f64 * notch_freq) as usize
  let half_band = (half as f64 * bandwidth / 2.0) as usize
  
  for i in (center_bin - half_band)..=(center_bin + half_band) do
    freq[i] = Complex::zero()
  end
  
  # Mirror around Nyquist
  for i in (n - center_bin - half_band)..=(n - center_bin + half_band) do
    freq[i] = Complex::zero()
  end
  
  ifft_real(&freq)
end

# ———————————————————————————————————————————————————————————————
# Peak Detection
# ———————————————————————————————————————————————————————————————

pub fn find_peaks(data: Vec[f64], threshold: f64, min_distance: usize) -> Vec[usize]
  let n = data.len()
  if n == 0 then return Vec::new() end
  
  let mut peaks: Vec[usize] = Vec::new()
  
  for i in 1..(n - 1) do
    # Local maximum
    if data[i] > data[i - 1] && data[i] > data[i + 1] && data[i] > threshold then
      # Check minimum distance from last peak
      let mut valid = true
      for last_peak in peaks do
        if i - last_peak < min_distance then
          valid = false
          break
        end
      end
      
      if valid then
        peaks.push(i)
      end
    end
  end
  
  peaks
end

pub fn find_peaks_complex(data: Vec[Complex], threshold: f64, min_distance: usize) -> Vec[usize]
  let magnitudes: Vec[f64] = data.iter().map(|c| c.abs()).collect()
  find_peaks(&magnitudes, threshold, min_distance)
end

# ———————————————————————————————————————————————————————————————
# Frequency Estimation
# ———————————————————————————————————————————————————————————————

pub fn estimate_fundamental(data: Vec[f64], sample_rate: f64) -> f64
  let n = data.len()
  if n == 0 then return 0.0 end
  
  # Autocorrelation method
  let autocorr = auto_correlate(data)
  
  # Find first significant peak after lag 0
  let mut best_lag = 1
  let mut best_val = 0.0
  
  # Skip first few samples
  for i in 10..autocorr.len() / 2 do
    if autocorr[i] > best_val then
      best_val = autocorr[i]
      best_lag = i
    end
  end
  
  sample_rate / (best_lag as f64)
end

pub fn estimate_frequency_fft(data: Vec[f64], sample_rate: f64) -> f64
  let n = data.len()
  if n == 0 then return 0.0 end
  
  let freq = fft(data)
  
  # Find peak in magnitude spectrum (skip DC)
  let mut max_mag = 0.0
  let mut max_bin = 1
  
  for i in 1..=(n / 2) do
    let mag = freq[i].abs()
    if mag > max_mag then
      max_mag = mag
      max_bin = i
    end
  end
  
  let df = sample_rate / (n as f64)
  (max_bin as f64) * df
end

# ———————————————————————————————————————————————————————————————
# Helper: Bessel function I0
# ———————————————————————————————————————————————————————————————

fn bessel_i0(x: f64) -> f64
  let mut sum: f64 = 1.0
  let mut term: f64 = 1.0
  
  for k in 1..25 do
    let k_f = k as f64
    term *= (x * x) / (4.0 * k_f * k_f)
    sum += term
    if term < 1e-10 then break end
  end
  
  sum
end