# capabilities: [Gpu, Window]
# error_codes: [InvalidDimensions, InvalidFormat, DecodeFailed, EncodeFailed, IOError, UnsupportedFormat]
# description: "Foundation for 2D graphics, windowing, image processing, and declarative UI primitives."
# examples:
#   - |
#     use std::ui::{Canvas, Color}
#     let mut canvas = Canvas::new(100, 100)
#     canvas.fill_rect(0.0, 0.0, 50.0, 50.0, Color::red())

use std::ctx
use std::gfx_errors::{Error, ErrorCode}
use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{Map}

# ═══════════════════════════════════════════════════════════════
# PART 1: COLOR & GEOMETRY
# ═══════════════════════════════════════════════════════════════

# ———————————————————————————————————————————————————————————————
# Color
# ———————————————————————————————————————————————————————————————

struct Color
  r: u8
  g: u8
  b: u8
  a: u8
end

impl Color
  def rgba(r: u8, g: u8, b: u8, a: u8) -> Color
    Color { r: r, g: g, b: b, a: a }
  end
  
  def rgb(r: u8, g: u8, b: u8) -> Color
    Color { r: r, g: g, b: b, a: 255 }
  end
  
  def from_hex(hex: u32) -> Color
    Color {
      r: ((hex >> 16) & 0xff) as u8,
      g: ((hex >> 8) & 0xff) as u8,
      b: (hex & 0xff) as u8,
      a: 255
    }
  end
  
  def from_hex_str(s: str) -> Option[Color]
    let s = if s.starts_with('#') then s.slice(1, s.len()) else s end
    
    if s.len() == 6 then
      match std::encoding::hex_decode(s)
      when Result::Ok(bytes) then
        Option::Some(Color { r: bytes[0] as u8, g: bytes[1] as u8, b: bytes[2] as u8, a: 255 })
      when Result::Err(_) then Option::None
      end
    elsif s.len() == 8 then
      match std::encoding::hex_decode(s)
      when Result::Ok(bytes) then
        Option::Some(Color { r: bytes[0] as u8, g: bytes[1] as u8, b: bytes[2] as u8, a: bytes[3] as u8 })
      when Result::Err(_) then Option::None
      end
    else
      Option::None
    end
  end
  
  def from_hsla(h: Float, s: Float, l: Float, a: Float) -> Color
    let c = (1.0 - (2.0 * l - 1.0).abs()) * s
    let hue_sector = h / 60.0
    let sector_phase = if hue_sector < 2.0 then hue_sector
    elsif hue_sector < 4.0 then hue_sector - 2.0
    else hue_sector - 4.0 end
    let x = c * (1.0 - (sector_phase - 1.0).abs())
    let m = l - c / 2.0
    
    let (r1, g1, b1) = if h < 60.0 then (c, x, 0.0)
    elsif h < 120.0 then (x, c, 0.0)
    elsif h < 180.0 then (0.0, c, x)
    elsif h < 240.0 then (0.0, x, c)
    elsif h < 300.0 then (x, 0.0, c)
    else (c, 0.0, x) end
    
    let r = ((r1 + m) * 255.0).clamp(0.0, 255.0) as u8
    let g = ((g1 + m) * 255.0).clamp(0.0, 255.0) as u8
    let b = ((b1 + m) * 255.0).clamp(0.0, 255.0) as u8
    let alpha = (a * 255.0).clamp(0.0, 255.0) as u8
    Color::rgba(r, g, b, alpha)
  end
  
  def to_hex(self: Color) -> u32
    ((self.r as u32) << 16) | ((self.g as u32) << 8) | (self.b as u32)
  end
  
  def to_rgba(self: Color) -> (u8, u8, u8, u8)
    (self.r, self.g, self.b, self.a)
  end
  
  def with_alpha(self: Color, a: u8) -> Color
    Color { r: self.r, g: self.g, b: self.b, a: a }
  end
  
  def blend(self: Color, other: Color, t: Float) -> Color
    let t = if t < 0.0 then 0.0 else if t > 1.0 then 1.0 else t end
    Color::rgba(
      (self.r as Float * (1.0 - t) + other.r as Float * t) as u8,
      (self.g as Float * (1.0 - t) + other.g as Float * t) as u8,
      (self.b as Float * (1.0 - t) + other.b as Float * t) as u8,
      (self.a as Float * (1.0 - t) + other.a as Float * t) as u8
    )
  end
  
  # Common colors
  def black() -> Color
    Color { r: 0, g: 0, b: 0, a: 255 }
  end
  def white() -> Color
    Color { r: 255, g: 255, b: 255, a: 255 }
  end
  def red() -> Color
    Color { r: 255, g: 0, b: 0, a: 255 }
  end
  def green() -> Color
    Color { r: 0, g: 255, b: 0, a: 255 }
  end
  def blue() -> Color
    Color { r: 0, g: 0, b: 255, a: 255 }
  end
  def yellow() -> Color
    Color { r: 255, g: 255, b: 0, a: 255 }
  end
  def cyan() -> Color
    Color { r: 0, g: 255, b: 255, a: 255 }
  end
  def magenta() -> Color
    Color { r: 255, g: 0, b: 255, a: 255 }
  end
  def transparent() -> Color
    Color::rgba(0, 0, 0, 0)
  end
  def gray(v: u8) -> Color
    Color { r: v, g: v, b: v, a: 255 }
  end
end

# ———————————————————————————————————————————————————————————————
# Geometry Types
# ———————————————————————————————————————————————————————————————

struct Point
  x: Float
  y: Float
end

impl Point
  def new(x: Float, y: Float) -> Point
    Point { x: x, y: y }
  end
  
  def zero() -> Point
    Point { x: 0.0, y: 0.0 }
  end
  
  def add(self: Point, other: Point) -> Point
    Point { x: self.x + other.x, y: self.y + other.y }
  end
  
  def sub(self: Point, other: Point) -> Point
    Point { x: self.x - other.x, y: self.y - other.y }
  end
  
  def scale(self: Point, s: Float) -> Point
    Point { x: self.x * s, y: self.y * s }
  end
  
  def length(self: Point) -> Float
    (self.x * self.x + self.y * self.y).sqrt()
  end
  
  def normalize(self: Point) -> Point
    let len = self.length()
    if len > 0.0 then
      Point { x: self.x / len, y: self.y / len }
    else
      Point::zero()
    end
  end
  
  def dot(self: Point, other: Point) -> Float
    self.x * other.x + self.y * other.y
  end
  
  def distance(self: Point, other: Point) -> Float
    self.sub(other).length()
  end
end

struct Size
  width: Float
  height: Float
end

impl Size
  def new(width: Float, height: Float) -> Size
    Size { width: width, height: height }
  end
  
  def zero() -> Size
    Size { width: 0.0, height: 0.0 }
  end
  
  def area(self: Size) -> Float
    self.width * self.height
  end
end

struct Rect
  x: Float
  y: Float
  width: Float
  height: Float
end

impl Rect
  def new(x: Float, y: Float, width: Float, height: Float) -> Rect
    Rect { x: x, y: y, width: width, height: height }
  end
  
  def from_points(p1: Point, p2: Point) -> Rect
    let x = p1.x.min(p2.x)
    let y = p1.y.min(p2.y)
    let w = (p1.x - p2.x).abs()
    let h = (p1.y - p2.y).abs()
    Rect::new(x, y, w, h)
  end
  
  def zero() -> Rect
    Rect { x: 0.0, y: 0.0, width: 0.0, height: 0.0 }
  end
  
  def origin(self: Rect) -> Point
    Point { x: self.x, y: self.y }
  end
  
  def size(self: Rect) -> Size
    Size { width: self.width, height: self.height }
  end
  
  def center(self: Rect) -> Point
    Point { x: self.x + self.width / 2.0, y: self.y + self.height / 2.0 }
  end
  
  def left(self: Rect) -> Float
    self.x
  end
  def right(self: Rect) -> Float
    self.x + self.width
  end
  def top(self: Rect) -> Float
    self.y
  end
  def bottom(self: Rect) -> Float
    self.y + self.height
  end
  
  def contains(self: Rect, p: Point) -> Bool
    p.x >= self.x && p.x <= self.right() &&
    p.y >= self.y && p.y <= self.bottom()
  end
  
  def intersects(self: Rect, other: Rect) -> Bool
    self.left() < other.right() && self.right() > other.left() &&
    self.top() < other.bottom() && self.bottom() > other.top()
  end
  
  def intersection(self: Rect, other: Rect) -> Option[Rect]
    if !self.intersects(other) then
      return Option::None
    end
    
    let x = self.x.max(other.x)
    let y = self.y.max(other.y)
    let r = self.right().min(other.right())
    let b = self.bottom().min(other.bottom())
    
    Option::Some(Rect::new(x, y, r - x, b - y))
  end
  
  def union(self: Rect, other: Rect) -> Rect
    let x = self.x.min(other.x)
    let y = self.y.min(other.y)
    let r = self.right().max(other.right())
    let b = self.bottom().max(other.bottom())
    
    Rect::new(x, y, r - x, b - y)
  end
  
  def inset(self: Rect, dx: Float, dy: Float) -> Rect
    Rect::new(self.x + dx, self.y + dy, self.width - 2.0 * dx, self.height - 2.0 * dy)
  end
  
  def offset(self: Rect, dx: Float, dy: Float) -> Rect
    Rect::new(self.x + dx, self.y + dy, self.width, self.height)
  end
end

# ———————————————————————————————————————————————————————————————
# Transform Matrix (2D affine)
# ———————————————————————————————————————————————————————————————

struct Transform
  # | a  c  tx |
  # | b  d  ty |
  # | 0  0  1  |
  a: Float
  b: Float
  c: Float
  d: Float
  tx: Float
  ty: Float
end

impl Transform
  def identity() -> Transform
    Transform { a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: 0.0, ty: 0.0 }
  end
  
  def translation(tx: Float, ty: Float) -> Transform
    Transform { a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: tx, ty: ty }
  end
  
  def scale(sx: Float, sy: Float) -> Transform
    Transform { a: sx, b: 0.0, c: 0.0, d: sy, tx: 0.0, ty: 0.0 }
  end
  
  def rotation(angle: Float) -> Transform
    let cos = angle.cos()
    let sin = angle.sin()
    Transform { a: cos, b: sin, c: -sin, d: cos, tx: 0.0, ty: 0.0 }
  end
  
  def skew(sx: Float, sy: Float) -> Transform
    Transform { a: 1.0, b: sy.tan(), c: sx.tan(), d: 1.0, tx: 0.0, ty: 0.0 }
  end
  
  def concat(self: Transform, other: Transform) -> Transform
    Transform {
      a: self.a * other.a + self.c * other.b,
      b: self.b * other.a + self.d * other.b,
      c: self.a * other.c + self.c * other.d,
      d: self.b * other.c + self.d * other.d,
      tx: self.a * other.tx + self.c * other.ty + self.tx,
      ty: self.b * other.tx + self.d * other.ty + self.ty
    }
  end
  
  def transform_point(self: Transform, p: Point) -> Point
    Point {
      x: self.a * p.x + self.c * p.y + self.tx,
      y: self.b * p.x + self.d * p.y + self.ty
    }
  end
  
  def invert(self: Transform) -> Option[Transform]
    let det = self.a * self.d - self.b * self.c
    if det.abs() < 0.0001 then
      return Option::None
    end
    
    let inv_det = 1.0 / det
    Option::Some(Transform {
      a: self.d * inv_det,
      b: -self.b * inv_det,
      c: -self.c * inv_det,
      d: self.a * inv_det,
      tx: (self.c * self.ty - self.d * self.tx) * inv_det,
      ty: (self.b * self.tx - self.a * self.ty) * inv_det
    })
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 2: IMAGE
# ═══════════════════════════════════════════════════════════════

enum PixelFormat
  Rgba8
  Rgb8
  Bgra8
  Grayscale8
  GrayscaleAlpha8
end

impl PixelFormat
  def bytes_per_pixel(self: PixelFormat) -> UInt
    match self
    when PixelFormat::Rgba8 | PixelFormat::Bgra8 then 4
    when PixelFormat::Rgb8 then 3
    when PixelFormat::Grayscale8 then 1
    when PixelFormat::GrayscaleAlpha8 then 2
    end
  end
end

struct Image
  width: UInt
  height: UInt
  format: PixelFormat
  data: Vec[u8]
end

enum ImageError
  InvalidDimensions
  InvalidFormat
  DecodeFailed(String)
  EncodeFailed(String)
  IoError(String)
  UnsupportedFormat
end

impl Image
  def new(width: UInt, height: UInt, format: PixelFormat) -> Image
    let size = width * height * format.bytes_per_pixel()
    let mut data = Vec::with_capacity(size)
    data.resize(size, 0)
    Image { width: width, height: height, format: format, data: data }
  end
  
  def from_raw(width: UInt, height: UInt, format: PixelFormat, data: Vec[u8]) -> Result[Image, ImageError]
    let expected = width * height * format.bytes_per_pixel()
    if data.len() != expected then
      return Result::Err(ImageError::InvalidDimensions)
    end
    Result::Ok(Image { width: width, height: height, format: format, data: data })
  end
  
  def filled(width: UInt, height: UInt, color: Color) -> Image
    let size = width * height * 4
    let mut data = Vec::with_capacity(size)
    for _ in 0..width * height do
      data.push(color.r)
      data.push(color.g)
      data.push(color.b)
      data.push(color.a)
    end
    Image { width: width, height: height, format: PixelFormat::Rgba8, data: data }
  end
  
  def get_pixel(self: Image, x: UInt, y: UInt) -> Color
    if x >= self.width || y >= self.height then
      return Color::transparent()
    end
    
    let bpp = self.format.bytes_per_pixel()
    let offset = (y * self.width + x) * bpp
    
    match self.format
    when PixelFormat::Rgba8 then
      Color { r: self.data[offset], g: self.data[offset + 1], b: self.data[offset + 2], a: self.data[offset + 3] }
    when PixelFormat::Rgb8 then
      Color { r: self.data[offset], g: self.data[offset + 1], b: self.data[offset + 2], a: 255 }
    when PixelFormat::Bgra8 then
      Color { r: self.data[offset + 2], g: self.data[offset + 1], b: self.data[offset], a: self.data[offset + 3] }
    when PixelFormat::Grayscale8 then
      let v = self.data[offset]
      Color { r: v, g: v, b: v, a: 255 }
    when PixelFormat::GrayscaleAlpha8 then
      let v = self.data[offset]
      Color { r: v, g: v, b: v, a: self.data[offset + 1] }
    end
  end
  
  def set_pixel(inout self: Image, x: UInt, y: UInt, color: Color) -> Unit
    if x >= self.width || y >= self.height then
      return
    end
    
    let bpp = self.format.bytes_per_pixel()
    let offset = (y * self.width + x) * bpp
    
    match self.format
    when PixelFormat::Rgba8 then
      self.data[offset] = color.r
      self.data[offset + 1] = color.g
      self.data[offset + 2] = color.b
      self.data[offset + 3] = color.a
    when PixelFormat::Rgb8 then
      self.data[offset] = color.r
      self.data[offset + 1] = color.g
      self.data[offset + 2] = color.b
    when PixelFormat::Bgra8 then
      self.data[offset] = color.b
      self.data[offset + 1] = color.g
      self.data[offset + 2] = color.r
      self.data[offset + 3] = color.a
    when PixelFormat::Grayscale8 then
      self.data[offset] = ((color.r as u16 + color.g as u16 + color.b as u16) / 3) as u8
    when PixelFormat::GrayscaleAlpha8 then
      self.data[offset] = ((color.r as u16 + color.g as u16 + color.b as u16) / 3) as u8
      self.data[offset + 1] = color.a
    end
  end
  
  def fill(inout self: Image, color: Color) -> Unit
    # Write directly into data buffer, avoiding per-pixel format dispatch
    let bpp = self.format.bytes_per_pixel()
    let total_pixels = self.width * self.height

    # Encode one pixel for this format
    mut pixel_bytes: Vec[u8] = Vec::with_capacity(bpp)
    match self.format
    when PixelFormat::Rgba8 then
      pixel_bytes.push(color.r)
      pixel_bytes.push(color.g)
      pixel_bytes.push(color.b)
      pixel_bytes.push(color.a)
    when PixelFormat::Rgb8 then
      pixel_bytes.push(color.r)
      pixel_bytes.push(color.g)
      pixel_bytes.push(color.b)
    when PixelFormat::Bgra8 then
      pixel_bytes.push(color.b)
      pixel_bytes.push(color.g)
      pixel_bytes.push(color.r)
      pixel_bytes.push(color.a)
    when PixelFormat::Grayscale8 then
      pixel_bytes.push(((color.r as u16 + color.g as u16 + color.b as u16) / 3) as u8)
    when PixelFormat::GrayscaleAlpha8 then
      pixel_bytes.push(((color.r as u16 + color.g as u16 + color.b as u16) / 3) as u8)
      pixel_bytes.push(color.a)
    end

    # Stamp the pixel pattern across the entire buffer
    mut offset: UInt = 0
    for _ in 0..total_pixels do
      for b in pixel_bytes do
        self.data[offset] = *b
        offset = offset + 1
      end
    end
  end
  
  def clear(inout self: Image) -> Unit
    self.fill(&Color::transparent())
  end
  
  def blit(inout self: Image, src: Image, x: Int, y: Int) -> Unit
    for sy in 0..src.height do
      for sx in 0..src.width do
        let dx = x + sx as Int
        let dy = y + sy as Int
        if dx >= 0 && dx < self.width as Int && dy >= 0 && dy < self.height as Int then
          let color = src.get_pixel(sx, sy)
          if color.a == 255 then
            self.set_pixel(dx as UInt, dy as UInt, &color)
          elsif color.a > 0 then
            # Alpha blending
            let dst = self.get_pixel(dx as UInt, dy as UInt)
            let blended = blend_colors(&color, &dst)
            self.set_pixel(dx as UInt, dy as UInt, &blended)
          end
        end
      end
    end
  end
  
  def crop(self: Image, x: UInt, y: UInt, w: UInt, h: UInt) -> Image
    let mut result = Image::new(w, h, self.format.clone())
    for dy in 0..h do
      for dx in 0..w do
        let color = self.get_pixel(x + dx, y + dy)
        result.set_pixel(dx, dy, &color)
      end
    end
    result
  end
  
  def resize(self: Image, new_width: UInt, new_height: UInt) -> Image
    let mut result = Image::new(new_width, new_height, self.format.clone())
    let x_ratio = self.width as Float / new_width as Float
    let y_ratio = self.height as Float / new_height as Float
    
    for y in 0..new_height do
      for x in 0..new_width do
        let src_x = (x as Float * x_ratio) as UInt
        let src_y = (y as Float * y_ratio) as UInt
        let color = self.get_pixel(src_x, src_y)
        result.set_pixel(x, y, &color)
      end
    end
    result
  end
  
  def flip_horizontal(inout self: Image) -> Unit
    for y in 0..self.height do
      for x in 0..self.width / 2 do
        let left = self.get_pixel(x, y)
        let right = self.get_pixel(self.width - 1 - x, y)
        self.set_pixel(x, y, &right)
        self.set_pixel(self.width - 1 - x, y, &left)
      end
    end
  end
  
  def flip_vertical(inout self: Image) -> Unit
    for y in 0..self.height / 2 do
      for x in 0..self.width do
        let top = self.get_pixel(x, y)
        let bottom = self.get_pixel(x, self.height - 1 - y)
        self.set_pixel(x, y, &bottom)
        self.set_pixel(x, self.height - 1 - y, &top)
      end
    end
  end
  
  def to_grayscale(self: Image) -> Image
    let mut result = Image::new(self.width, self.height, PixelFormat::Grayscale8)
    for y in 0..self.height do
      for x in 0..self.width do
        let c = self.get_pixel(x, y)
        let gray = (0.299 * c.r as Float + 0.587 * c.g as Float + 0.114 * c.b as Float) as u8
        result.data[y * self.width + x] = gray
      end
    end
    result
  end
end

def blend_colors(src: Color, dst: Color) -> Color
  let src_a = src.a as Float / 255.0
  let dst_a = dst.a as Float / 255.0
  let out_a = src_a + dst_a * (1.0 - src_a)
  
  if out_a < 0.001 then
    return Color::transparent()
  end
  
  Color::rgba(
    ((src.r as Float * src_a + dst.r as Float * dst_a * (1.0 - src_a)) / out_a) as u8,
    ((src.g as Float * src_a + dst.g as Float * dst_a * (1.0 - src_a)) / out_a) as u8,
    ((src.b as Float * src_a + dst.b as Float * dst_a * (1.0 - src_a)) / out_a) as u8,
    (out_a * 255.0) as u8
  )
end

# ———————————————————————————————————————————————————————————————
# PNG Encode/Decode (basic implementation)
# ———————————————————————————————————————————————————————————————

# png helpers
  const PNG_SIGNATURE: [u8; 8] = [137, 80, 78, 71, 13, 10, 26, 10]
  
  def decode(data: [u8]) -> Result[Image, ImageError]
    if data.len() < 8 then
      return Result::Err(ImageError::DecodeFailed("too short"))
    end
    
    # Verify signature
    for i in 0..8 do
      if data[i] != PNG_SIGNATURE[i] then
        return Result::Err(ImageError::InvalidFormat)
      end
    end
    
    let mut pos = 8
    let mut width = 0
    let mut height = 0
    let mut bit_depth = 0
    let mut color_type = 0
    let mut compressed_data = Vec::new()
    
    while pos + 12 <= data.len() do
      let chunk_len = read_u32_be(&data, pos) as UInt
      let chunk_type = data[pos + 4..pos + 8]
      let chunk_data = data[pos + 8..pos + 8 + chunk_len]
      
      if chunk_type == b"IHDR" then
        width = read_u32_be(chunk_data, 0) as UInt
        height = read_u32_be(chunk_data, 4) as UInt
        bit_depth = chunk_data[8]
        color_type = chunk_data[9]
        
        if bit_depth != 8 then
          return Result::Err(ImageError::UnsupportedFormat)
        end
      elsif chunk_type == b"IDAT" then
        for b in chunk_data do
          compressed_data.push(b)
        end
      elsif chunk_type == b"IEND" then
        break
      end
      
      pos = pos + 12 + chunk_len
    end
    
    if width == 0 || height == 0 then
      return Result::Err(ImageError::DecodeFailed("no IHDR chunk"))
    end
    
    # Decompress
    let decompressed = std::compress::deflate::decompress(&compressed_data)
      .map_err(|_| ImageError::DecodeFailed("decompression failed"))?
    
    # Determine format and bytes per pixel
    let (format, bpp) = match color_type
    when 0 then (PixelFormat::Grayscale8, 1)
    when 2 then (PixelFormat::Rgb8, 3)
    when 4 then (PixelFormat::GrayscaleAlpha8, 2)
    when 6 then (PixelFormat::Rgba8, 4)
    when _ then return Result::Err(ImageError::UnsupportedFormat)
    end
    
    # Unfilter
    let scanline_len = width * bpp + 1
    let expected_len = height * scanline_len
    
    if decompressed.len() < expected_len then
      return Result::Err(ImageError::DecodeFailed("incomplete data"))
    end
    
    let mut pixels = Vec::with_capacity(width * height * bpp)
    
    for y in 0..height do
      let line_start = y * scanline_len
      let filter = decompressed[line_start]
      let line_data = decompressed[line_start + 1..line_start + 1 + width * bpp]
      
      for x in 0..width * bpp do
        let raw = line_data[x]
        let a = if x >= bpp then pixels[pixels.len() - bpp] else 0 end
        let b = if y > 0 then pixels[(y - 1) * width * bpp + x] else 0 end
        let c = if x >= bpp && y > 0 then pixels[(y - 1) * width * bpp + x - bpp] else 0 end
        
        let unfiltered = match filter
        when 0 then raw
        when 1 then raw.wrapping_add(a)
        when 2 then raw.wrapping_add(b)
        when 3 then raw.wrapping_add(((a as u16 + b as u16) / 2) as u8)
        when 4 then raw.wrapping_add(paeth_predictor(a, b, c))
        when _ then raw
        end
        
        pixels.push(unfiltered)
      end
    end
    
    Image::from_raw(width, height, format, pixels)
  end
  
  def encode(image: Image) -> Result[Vec[u8], ImageError]
    let mut output = Vec::new()
    
    # Signature
    for b in PNG_SIGNATURE do
      output.push(b)
    end
    
    # IHDR
    let color_type = match image.format
    when PixelFormat::Grayscale8 then 0
    when PixelFormat::Rgb8 then 2
    when PixelFormat::GrayscaleAlpha8 then 4
    when PixelFormat::Rgba8 | PixelFormat::Bgra8 then 6
    end
    
    let mut ihdr = Vec::new()
    write_u32_be(&mut ihdr, image.width as u32)
    write_u32_be(&mut ihdr, image.height as u32)
    ihdr.push(8)  # bit depth
    ihdr.push(color_type)
    ihdr.push(0)  # compression
    ihdr.push(0)  # filter
    ihdr.push(0)  # interlace
    
    write_chunk(&mut output, b"IHDR", &ihdr)
    
    # IDAT - filter and compress pixels
    let bpp = image.format.bytes_per_pixel()
    let mut filtered = Vec::new()
    
    for y in 0..image.height do
      filtered.push(0)  # No filter
      for x in 0..image.width do
        let offset = (y * image.width + x) * bpp
        if image.format == PixelFormat::Bgra8 then
          # PNG expects RGBA ordering.
          filtered.push(image.data[offset + 2])
          filtered.push(image.data[offset + 1])
          filtered.push(image.data[offset + 0])
          filtered.push(image.data[offset + 3])
        else
          for i in 0..bpp do
            filtered.push(image.data[offset + i])
          end
        end
      end
    end
    
    let compressed: Vec[u8] = match std::compress::deflate::compress(&filtered)
    when Result::Ok(bytes) then bytes
    when Result::Err(_) then return Result::Err(ImageError::EncodeFailed("compression failed"))
    end
    
    write_chunk(&mut output, b"IDAT", &compressed)
    
    # IEND
    let empty_chunk: Vec[u8] = Vec::new()
    write_chunk(&mut output, b"IEND", &empty_chunk)
    
    Result::Ok(output)
  end
  
  def paeth_predictor(a: u8, b: u8, c: u8) -> u8
    let p = a as i16 + b as i16 - c as i16
    let pa = (p - a as i16).abs()
    let pb = (p - b as i16).abs()
    let pc = (p - c as i16).abs()
    
    if pa <= pb && pa <= pc then a
    elsif pb <= pc then b
    else c end
  end
  
  def read_u32_be(data: [u8], offset: UInt) -> u32
    ((data[offset] as u32) << 24) |
    ((data[offset + 1] as u32) << 16) |
    ((data[offset + 2] as u32) << 8) |
    (data[offset + 3] as u32)
  end
  
  def write_u32_be(inout data: Vec[u8], value: u32) -> Unit
    data.push(((value >> 24) & 0xff) as u8)
    data.push(((value >> 16) & 0xff) as u8)
    data.push(((value >> 8) & 0xff) as u8)
    data.push((value & 0xff) as u8)
  end
  
  def write_chunk(inout output: Vec[u8], chunk_type: [u8], data: [u8]) -> Unit
    write_u32_be(output, data.len() as u32)
    for b in chunk_type do
      output.push(b)
    end
    for b in data do
      output.push(b)
    end
    
    # CRC
    let mut crc_data = Vec::new()
    for b in chunk_type do
      crc_data.push(b)
    end
    for b in data do
      crc_data.push(b)
    end
    let crc = compute_crc32(&crc_data)
    write_u32_be(output, crc)
  end
  
  def compute_crc32(data: [u8]) -> u32
    std::compress::checksum::crc32(data)
  end

# ═══════════════════════════════════════════════════════════════
# PART 3: 2D CANVAS
# ═══════════════════════════════════════════════════════════════

enum LineCap
  Butt
  Round
  Square
end

enum LineJoin
  Miter
  Round
  Bevel
end

struct StrokeStyle
  width: Float
  color: Color
  cap: LineCap
  join: LineJoin
  miter_limit: Float
  dash_array: Vec[Float]
  dash_offset: Float
end

impl StrokeStyle
  def new() -> StrokeStyle
    StrokeStyle {
      width: 1.0,
      color: Color::black(),
      cap: LineCap::Butt,
      join: LineJoin::Miter,
      miter_limit: 10.0,
      dash_array: Vec::new(),
      dash_offset: 0.0
    }
  end
end

enum FillRule
  NonZero
  EvenOdd
end

struct Canvas
  image: Image
  transform: Transform
  clip: Option[Rect]
  stroke_style: StrokeStyle
  fill_color: Color
end

impl Canvas
  def new(width: UInt, height: UInt) -> Canvas
    Canvas {
      image: Image::new(width, height, PixelFormat::Rgba8),
      transform: Transform::identity(),
      clip: Option::None,
      stroke_style: StrokeStyle::new(),
      fill_color: Color::black()
    }
  end
  
  def from_image(image: Image) -> Canvas
    Canvas {
      image: image,
      transform: Transform::identity(),
      clip: Option::None,
      stroke_style: StrokeStyle::new(),
      fill_color: Color::black()
    }
  end
  
  def width(self: Canvas) -> UInt
    self.image.width
  end
  def height(self: Canvas) -> UInt
    self.image.height
  end
  
  def set_fill_color(inout self: Canvas, color: Color) -> Unit
    self.fill_color = color
  end
  
  def set_stroke_color(inout self: Canvas, color: Color) -> Unit
    self.stroke_style.color = color
  end
  
  def set_stroke_width(inout self: Canvas, width: Float) -> Unit
    self.stroke_style.width = width
  end
  
  def clear(inout self: Canvas, color: Color) -> Unit
    self.image.fill(color)
  end
  
  def fill_rect(inout self: Canvas, x: Float, y: Float, w: Float, h: Float) -> Unit
    let x0 = x.max(0.0) as UInt
    let y0 = y.max(0.0) as UInt
    let x1 = (x + w).min(self.image.width as Float) as UInt
    let y1 = (y + h).min(self.image.height as Float) as UInt
    
    for py in y0..y1 do
      for px in x0..x1 do
        self.image.set_pixel(px, py, &self.fill_color)
      end
    end
  end
  
  def stroke_rect(inout self: Canvas, x: Float, y: Float, w: Float, h: Float) -> Unit
    self.draw_line(x, y, x + w, y)
    self.draw_line(x + w, y, x + w, y + h)
    self.draw_line(x + w, y + h, x, y + h)
    self.draw_line(x, y + h, x, y)
  end
  
  def draw_line(inout self: Canvas, x0: Float, y0: Float, x1: Float, y1: Float) -> Unit
    # Bresenham's line algorithm
    let mut x0 = x0 as Int
    let mut y0 = y0 as Int
    let x1 = x1 as Int
    let y1 = y1 as Int
    
    let dx_delta = x1 - x0
    let dx = if dx_delta < 0 then -dx_delta else dx_delta end
    let dy_delta = y1 - y0
    let dy_abs = if dy_delta < 0 then -dy_delta else dy_delta end
    let dy = -dy_abs
    let sx = if x0 < x1 then 1 else -1 end
    let sy = if y0 < y1 then 1 else -1 end
    let mut err = dx + dy
    
    loop
      if x0 >= 0 && x0 < self.image.width as Int && y0 >= 0 && y0 < self.image.height as Int then
        self.image.set_pixel(x0 as UInt, y0 as UInt, &self.stroke_style.color)
      end
      
      if x0 == x1 && y0 == y1 then
        break
      end
      
      let e2 = 2 * err
      if e2 >= dy then
        err = err + dy
        x0 = x0 + sx
      end
      if e2 <= dx then
        err = err + dx
        y0 = y0 + sy
      end
    end
  end
  
  def fill_circle(inout self: Canvas, cx: Float, cy: Float, r: Float) -> Unit
    let x0 = (cx - r).max(0.0) as Int
    let y0 = (cy - r).max(0.0) as Int
    let x1 = (cx + r).min(self.image.width as Float - 1.0) as Int
    let y1 = (cy + r).min(self.image.height as Float - 1.0) as Int
    let r_sq = r * r
    
    for py in y0..=y1 do
      for px in x0..=x1 do
        let dx = px as Float - cx
        let dy = py as Float - cy
        if dx * dx + dy * dy <= r_sq then
          self.image.set_pixel(px as UInt, py as UInt, &self.fill_color)
        end
      end
    end
  end
  
  def stroke_circle(inout self: Canvas, cx: Float, cy: Float, r: Float) -> Unit
    # Midpoint circle algorithm
    let mut x = r as Int
    let mut y = 0
    let mut err = 0 as Int
    
    while x >= y do
      self.draw_circle_points(cx as Int, cy as Int, x, y)
      y = y + 1
      err = err + 1 + 2 * y
      if 2 * (err - x) + 1 > 0 then
        x = x - 1
        err = err + 1 - 2 * x
      end
    end
  end
  
  def draw_circle_points(inout self: Canvas, cx: Int, cy: Int, x: Int, y: Int) -> Unit
    let points = [
      (cx + x, cy + y), (cx - x, cy + y),
      (cx + x, cy - y), (cx - x, cy - y),
      (cx + y, cy + x), (cx - y, cy + x),
      (cx + y, cy - x), (cx - y, cy - x)
    ]
    
    for (px, py) in points do
      if px >= 0 && px < self.image.width as Int && py >= 0 && py < self.image.height as Int then
        self.image.set_pixel(*px as UInt, *py as UInt, &self.stroke_style.color)
      end
    end
  end
  
  def fill_ellipse(inout self: Canvas, cx: Float, cy: Float, rx: Float, ry: Float) -> Unit
    let x0 = (cx - rx).max(0.0) as Int
    let y0 = (cy - ry).max(0.0) as Int
    let x1 = (cx + rx).min(self.image.width as Float - 1.0) as Int
    let y1 = (cy + ry).min(self.image.height as Float - 1.0) as Int
    
    for py in y0..=y1 do
      for px in x0..=x1 do
        let dx = (px as Float - cx) / rx
        let dy = (py as Float - cy) / ry
        if dx * dx + dy * dy <= 1.0 then
          self.image.set_pixel(px as UInt, py as UInt, &self.fill_color)
        end
      end
    end
  end
  
  def fill_polygon(inout self: Canvas, points: [Point]) -> Unit
    if points.len() < 3 then
      return
    end
    
    # Find bounding box
    let mut min_y = points[0].y
    let mut max_y = points[0].y
    for p in points do
      min_y = min_y.min(p.y)
      max_y = max_y.max(p.y)
    end
    
    # Scanline fill
    for y in (min_y as Int)..(max_y as Int + 1) do
      let mut intersections = Vec::new()
      
      for i in 0..points.len() do
        let j = (i + 1) % points.len()
        let p1 = points[i]
        let p2 = points[j]
        
        if (p1.y <= y as Float && p2.y > y as Float) || (p2.y <= y as Float && p1.y > y as Float) then
          let x = p1.x + (y as Float - p1.y) / (p2.y - p1.y) * (p2.x - p1.x)
          intersections.push(x)
        end
      end
      
      intersections.sort()
      
        let mut i = 0
        while i + 1 < intersections.len() do
          let x0 = intersections[i].max(0.0) as UInt
          let x1 = intersections[i + 1].min(self.image.width as Float - 1.0) as UInt
          for x in x0..=x1 do
            if y >= 0 && y < self.image.height as Int then
              self.image.set_pixel(x, y as UInt, &self.fill_color)
            end
          end
          i = i + 2
        end
    end
  end
  
  def draw_image(inout self: Canvas, img: Image, x: Int, y: Int) -> Unit
    self.image.blit(img, x, y)
  end
  
  def draw_image_scaled(inout self: Canvas, img: Image, x: Int, y: Int, w: UInt, h: UInt) -> Unit
    let scaled = img.resize(w, h)
    self.image.blit(&scaled, x, y)
  end
  
  def save(self: Canvas) -> Image
    self.image.clone()
  end
  
  def get_image(self: Canvas) -> Image
    self.image.clone()
  end
  
  def get_image_mut(inout self: Canvas) -> PtrMut[Image]
    address_of_mut(&mut self.image)
  end
  
  def set_transform(inout self: Canvas, transform: Transform) -> Unit
    self.transform = transform
  end
  
  def reset_transform(inout self: Canvas) -> Unit
    self.transform = Transform::identity()
  end
  
  def translate(inout self: Canvas, tx: Float, ty: Float) -> Unit
    self.transform = self.transform.concat(&Transform::translation(tx, ty))
  end
  
  def scale(inout self: Canvas, sx: Float, sy: Float) -> Unit
    self.transform = self.transform.concat(&Transform::scale(sx, sy))
  end
  
  def rotate(inout self: Canvas, angle: Float) -> Unit
    self.transform = self.transform.concat(&Transform::rotation(angle))
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 4: FONT & TEXT
# ═══════════════════════════════════════════════════════════════

struct Glyph
  codepoint: char
  advance: Float
  bearing_x: Float
  bearing_y: Float
  width: UInt
  height: UInt
  bitmap: Vec[u8]
end

struct Font
  name: String
  size: Float
  glyphs: Map[char, Glyph]
  line_height: Float
  ascent: Float
  descent: Float
end

# Basic 8x8 bitmap font for fallback
# bitmap font helpers
  def get_char(c: char) -> Option[Vec[u8]]
    # Simple hardcoded glyphs for printable ASCII
    let data = match c
    when 'A' then [0x18, 0x24, 0x42, 0x7E, 0x42, 0x42, 0x42, 0x00]
    when 'B' then [0x7C, 0x42, 0x42, 0x7C, 0x42, 0x42, 0x7C, 0x00]
    when 'C' then [0x3C, 0x42, 0x40, 0x40, 0x40, 0x42, 0x3C, 0x00]
    when 'D' then [0x78, 0x44, 0x42, 0x42, 0x42, 0x44, 0x78, 0x00]
    when 'E' then [0x7E, 0x40, 0x40, 0x7C, 0x40, 0x40, 0x7E, 0x00]
    when 'F' then [0x7E, 0x40, 0x40, 0x7C, 0x40, 0x40, 0x40, 0x00]
    when 'G' then [0x3C, 0x42, 0x40, 0x4E, 0x42, 0x42, 0x3C, 0x00]
    when 'H' then [0x42, 0x42, 0x42, 0x7E, 0x42, 0x42, 0x42, 0x00]
    when 'I' then [0x3E, 0x08, 0x08, 0x08, 0x08, 0x08, 0x3E, 0x00]
    when 'J' then [0x1E, 0x04, 0x04, 0x04, 0x44, 0x44, 0x38, 0x00]
    when 'K' then [0x42, 0x44, 0x48, 0x70, 0x48, 0x44, 0x42, 0x00]
    when 'L' then [0x40, 0x40, 0x40, 0x40, 0x40, 0x40, 0x7E, 0x00]
    when 'M' then [0x42, 0x66, 0x5A, 0x42, 0x42, 0x42, 0x42, 0x00]
    when 'N' then [0x42, 0x62, 0x52, 0x4A, 0x46, 0x42, 0x42, 0x00]
    when 'O' then [0x3C, 0x42, 0x42, 0x42, 0x42, 0x42, 0x3C, 0x00]
    when 'P' then [0x7C, 0x42, 0x42, 0x7C, 0x40, 0x40, 0x40, 0x00]
    when 'Q' then [0x3C, 0x42, 0x42, 0x42, 0x4A, 0x44, 0x3A, 0x00]
    when 'R' then [0x7C, 0x42, 0x42, 0x7C, 0x48, 0x44, 0x42, 0x00]
    when 'S' then [0x3C, 0x42, 0x40, 0x3C, 0x02, 0x42, 0x3C, 0x00]
    when 'T' then [0x7F, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x00]
    when 'U' then [0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x3C, 0x00]
    when 'V' then [0x42, 0x42, 0x42, 0x42, 0x42, 0x24, 0x18, 0x00]
    when 'W' then [0x42, 0x42, 0x42, 0x42, 0x5A, 0x66, 0x42, 0x00]
    when 'X' then [0x42, 0x42, 0x24, 0x18, 0x24, 0x42, 0x42, 0x00]
    when 'Y' then [0x41, 0x22, 0x14, 0x08, 0x08, 0x08, 0x08, 0x00]
    when 'Z' then [0x7E, 0x02, 0x04, 0x08, 0x10, 0x20, 0x7E, 0x00]
    when '0' then [0x3C, 0x42, 0x46, 0x4A, 0x52, 0x62, 0x3C, 0x00]
    when '1' then [0x08, 0x18, 0x28, 0x08, 0x08, 0x08, 0x3E, 0x00]
    when '2' then [0x3C, 0x42, 0x02, 0x0C, 0x30, 0x40, 0x7E, 0x00]
    when '3' then [0x3C, 0x42, 0x02, 0x1C, 0x02, 0x42, 0x3C, 0x00]
    when '4' then [0x04, 0x0C, 0x14, 0x24, 0x7E, 0x04, 0x04, 0x00]
    when '5' then [0x7E, 0x40, 0x7C, 0x02, 0x02, 0x42, 0x3C, 0x00]
    when '6' then [0x1C, 0x20, 0x40, 0x7C, 0x42, 0x42, 0x3C, 0x00]
    when '7' then [0x7E, 0x02, 0x04, 0x08, 0x10, 0x20, 0x20, 0x00]
    when '8' then [0x3C, 0x42, 0x42, 0x3C, 0x42, 0x42, 0x3C, 0x00]
    when '9' then [0x3C, 0x42, 0x42, 0x3E, 0x02, 0x04, 0x38, 0x00]
    when ' ' then [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
    when '-' then [0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x00, 0x00]
    when '.' then [0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00]
    when ':' then [0x00, 0x18, 0x18, 0x00, 0x18, 0x18, 0x00, 0x00]
    when '!' then [0x08, 0x08, 0x08, 0x08, 0x08, 0x00, 0x08, 0x00]
    when '?' then [0x3C, 0x42, 0x02, 0x04, 0x08, 0x00, 0x08, 0x00]
    when _ then [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
    end
    
    # Expand 8x8 bitmap to grayscale
    let mut bitmap = Vec::with_capacity(64)
    for byte in data do
      for bit in (0..8).rev() do
        bitmap.push(if (byte >> bit) & 1 == 1 then 255 else 0 end)
      end
    end
    
    Option::Some(bitmap)
  end

impl Font
  def default() -> Font
    Font {
      name: "Bitmap".to_string(),
      size: 8.0,
      glyphs: Map::new(),
      line_height: 10.0,
      ascent: 8.0,
      descent: 2.0
    }
  end
  
  def measure_text(self: Font, text: str) -> Size
    let mut width = 0.0
    let char_width = 8.0  # For bitmap font
    
    for c in text.chars() do
      width = width + char_width
    end
    
    Size::new(width, self.line_height)
  end
end

impl Canvas
  def draw_text(inout self: Canvas, text: str, x: Float, y: Float) -> Unit
    let mut cursor_x = x as Int
    let cursor_y = y as Int
    
    for c in text.chars() do
      if let Option::Some(bitmap) = bitmap_font::get_char(c.to_uppercase()) then
        for row in 0..8 do
          for col in 0..8 do
            let alpha = bitmap[row * 8 + col]
            if alpha > 0 then
              let px = cursor_x + col as Int
              let py = cursor_y + row as Int
              if px >= 0 && px < self.image.width as Int && py >= 0 && py < self.image.height as Int then
                let color = Color::rgba(
                  self.fill_color.r,
                  self.fill_color.g,
                  self.fill_color.b,
                  ((self.fill_color.a as u16 * alpha as u16) / 255) as u8
                )
                self.image.set_pixel(px as UInt, py as UInt, &color)
              end
            end
          end
        end
      end
      cursor_x = cursor_x + 8
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 5: ANIMATION & EASING
# ═══════════════════════════════════════════════════════════════

# easing helpers
  def linear(t: Float) -> Float
    t
  end
  
  def ease_in_quad(t: Float) -> Float
    t * t
  end
  def ease_out_quad(t: Float) -> Float
    t * (2.0 - t)
  end
  def ease_in_out_quad(t: Float) -> Float
    if t < 0.5 then 2.0 * t * t else -1.0 + (4.0 - 2.0 * t) * t end
  end
  
  def ease_in_cubic(t: Float) -> Float
    t * t * t
  end
  def ease_out_cubic(t: Float) -> Float
    let t1 = t - 1.0
    t1 * t1 * t1 + 1.0
  end
  def ease_in_out_cubic(t: Float) -> Float
    if t < 0.5 then 4.0 * t * t * t else (t - 1.0) * (2.0 * t - 2.0) * (2.0 * t - 2.0) + 1.0 end
  end
  
  def ease_in_sine(t: Float) -> Float
    1.0 - (t * 3.141592653589793 / 2.0).cos()
  end
  def ease_out_sine(t: Float) -> Float
    (t * 3.141592653589793 / 2.0).sin()
  end
  def ease_in_out_sine(t: Float) -> Float
    -(((t * 3.141592653589793).cos() - 1.0) / 2.0)
  end
  
  def ease_in_expo(t: Float) -> Float
    if t == 0.0 then 0.0 else (2.0 as Float).powf(10.0 * (t - 1.0)) end
  end
  def ease_out_expo(t: Float) -> Float
    if t == 1.0 then 1.0 else 1.0 - (2.0 as Float).powf(-10.0 * t) end
  end
  
  def ease_in_elastic(t: Float) -> Float
    let c4 = (2.0 * std::math::PI) / 3.0
    if t == 0.0 then 0.0
    elsif t == 1.0 then 1.0
    else -(2.0 as Float).powf(10.0 * t - 10.0) * ((t * 10.0 - 10.75) * c4).sin()
    end
  end
  
  def ease_out_bounce(t: Float) -> Float
    let n1 = 7.5625
    let d1 = 2.75
    
    if t < 1.0 / d1 then
      n1 * t * t
    elsif t < 2.0 / d1 then
      let t = t - 1.5 / d1
      n1 * t * t + 0.75
    elsif t < 2.5 / d1 then
      let t = t - 2.25 / d1
      n1 * t * t + 0.9375
    else
      let t = t - 2.625 / d1
      n1 * t * t + 0.984375
    end
  end

struct Animation[T]
  start_value: T
  end_value: T
  duration: Float
  elapsed: Float
  easing: fn(Float) -> Float
  interpolate: fn(T, T, Float) -> T
end

impl[T] Animation[T]
  def new(start: T, end: T, duration: Float, interpolate: fn(T, T, Float) -> T) -> Animation[T]
    Animation {
      start_value: start,
      end_value: end,
      duration: duration,
      elapsed: 0.0,
      easing: easing::linear,
      interpolate: interpolate
    }
  end
  
  def with_easing(sink self: Animation[T], easing: fn(Float) -> Float) -> Animation[T]
    self.easing = easing
    self
  end
  
  def update(inout self: Animation[T], dt: Float) -> T
    self.elapsed = (self.elapsed + dt).min(self.duration)
    let t = if self.duration > 0.0 then self.elapsed / self.duration else 1.0 end
    let eased = (self.easing)(t)
    (self.interpolate)(&self.start_value, &self.end_value, eased)
  end
  
  def is_finished(self: Animation[T]) -> Bool
    self.elapsed >= self.duration
  end
  
  def reset(inout self: Animation[T]) -> Unit
    self.elapsed = 0.0
  end
end

# Common interpolators
def lerp_Float(a: Float, b: Float, t: Float) -> Float
  *a + (*b - *a) * t
end

def lerp_color(a: Color, b: Color, t: Float) -> Color
  a.blend(b, t)
end

def lerp_point(a: Point, b: Point, t: Float) -> Point
  Point::new(
    a.x + (b.x - a.x) * t,
    a.y + (b.y - a.y) * t
  )
end
