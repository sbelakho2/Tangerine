# Tangerine Standard Library — std::simd
# SIMD (Single Instruction Multiple Data) intrinsics
# Production-ready vector operations for performance-critical code
#
# Supports:
# - SSE2/SSE4.2 (x86-64)
# - AVX2/AVX-512 (x86-64 with feature detection)
# - NEON (ARM64)
# - Portable fallback implementations

use std::core::{Option, Result}

# ———————————————————————————————————————————————————————————————
# SIMD Vector Types
# ———————————————————————————————————————————————————————————————

# 128-bit SIMD vectors
struct Vec2[T]  # 2-element vector (f64, i64)
  x: T
  y: T
end

struct Vec4[T]  # 4-element vector (f32, i32)
  x: T
  y: T
  z: T
  w: T
end

# 256-bit SIMD vectors (AVX)
struct Vec8[T]  # 8-element vector
  e0: T
  e1: T
  e2: T
  e3: T
  e4: T
  e5: T
  e6: T
  e7: T
end

# 512-bit SIMD vectors (AVX-512)
struct Vec16[T]  # 16-element vector
  e0: T
  e1: T
  e2: T
  e3: T
  e4: T
  e5: T
  e6: T
  e7: T
  e8: T
  e9: T
  e10: T
  e11: T
  e12: T
  e13: T
  e14: T
  e15: T
end

# ———————————————————————————————————————————————————————————————
# Feature Detection
# ———————————————————————————————————————————————————————————————

struct SimdCaps
  has_sse2: Bool
  has_sse3: Bool
  has_ssse3: Bool
  has_sse41: Bool
  has_sse42: Bool
  has_avx: Bool
  has_avx2: Bool
  has_avx512f: Bool
  has_avx512vl: Bool
  has_neon: Bool
  has_fma: Bool
  has_popcnt: Bool
  has_bmi1: Bool
  has_bmi2: Bool
end

# Detect CPU SIMD capabilities at runtime
def detect_simd() -> SimdCaps
  SimdCaps {
    has_sse2: __cpuid_feature("sse2"),
    has_sse3: __cpuid_feature("sse3"),
    has_ssse3: __cpuid_feature("ssse3"),
    has_sse41: __cpuid_feature("sse4.1"),
    has_sse42: __cpuid_feature("sse4.2"),
    has_avx: __cpuid_feature("avx"),
    has_avx2: __cpuid_feature("avx2"),
    has_avx512f: __cpuid_feature("avx512f"),
    has_avx512vl: __cpuid_feature("avx512vl"),
    has_neon: __cpuid_feature("neon"),
    has_fma: __cpuid_feature("fma"),
    has_popcnt: __cpuid_feature("popcnt"),
    has_bmi1: __cpuid_feature("bmi1"),
    has_bmi2: __cpuid_feature("bmi2")
  }
end

# Platform-specific CPUID intrinsic
extern def __cpuid_feature(feature: String) -> Bool

# ———————————————————————————————————————————————————————————————
# Float32x4 SIMD Operations (SSE/NEON)
# ———————————————————————————————————————————————————————————————

impl Vec4[Float]
  # Factory: create from array
  def from_array(arr: &[Float; 4]) -> Vec4[Float]
    Vec4[Float] { x: arr[0], y: arr[1], z: arr[2], w: arr[3] }
  end

  # Factory: splat single value across all lanes
  def splat(val: Float) -> Vec4[Float]
    Vec4[Float] { x: val, y: val, z: val, w: val }
  end

  # Element-wise addition
  def add(self, other: Vec4[Float]) -> Vec4[Float]
    __simd_add_f32x4(self, other)
  end

  # Element-wise subtraction
  def sub(self, other: Vec4[Float]) -> Vec4[Float]
    __simd_sub_f32x4(self, other)
  end

  # Element-wise multiplication
  def mul(self, other: Vec4[Float]) -> Vec4[Float]
    __simd_mul_f32x4(self, other)
  end

  # Element-wise division
  def div(self, other: Vec4[Float]) -> Vec4[Float]
    __simd_div_f32x4(self, other)
  end

  # Horizontal sum (reduction)
  def hsum(self) -> Float
    __simd_hsum_f32x4(self)
  end

  # Dot product
  def dot(self, other: Vec4[Float]) -> Float
    (self * other).hsum()
  end

  # Fused multiply-add: self * other + acc
  def fma(self, other: Vec4[Float], acc: Vec4[Float]) -> Vec4[Float]
    __simd_fma_f32x4(self, other, acc)
  end

  # Square root
  def sqrt(self) -> Vec4[Float]
    __simd_sqrt_f32x4(self)
  end

  # Reciprocal (1/x) with Newton-Raphson refinement
  def rcp(self) -> Vec4[Float]
    __simd_rcp_f32x4(self)
  end

  # Reciprocal square root (1/sqrt(x))
  def rsqrt(self) -> Vec4[Float]
    __simd_rsqrt_f32x4(self)
  end

  # Min/Max
  def min(self, other: Vec4[Float]) -> Vec4[Float]
    __simd_min_f32x4(self, other)
  end

  def max(self, other: Vec4[Float]) -> Vec4[Float]
    __simd_max_f32x4(self, other)
  end

  # Compare: returns bitmask
  def cmp_eq(self, other: Vec4[Float]) -> u32
    __simd_cmpeq_f32x4(self, other)
  end

  def cmp_lt(self, other: Vec4[Float]) -> u32
    __simd_cmplt_f32x4(self, other)
  end

  def cmp_le(self, other: Vec4[Float]) -> u32
    __simd_cmple_f32x4(self, other)
  end

  # Blend/select based on mask
  def blend(self, other: Vec4[Float], mask: u32) -> Vec4[Float]
    __simd_blend_f32x4(self, other, mask)
  end

  # Gather from memory with index vector
  def gather(base: &Float, indices: Vec4[i32]) -> Vec4[Float]
    __simd_gather_f32x4(base, indices)
  end

  # Scatter to memory with index vector
  def scatter(self, base: &mut Float, indices: Vec4[i32]) -> Unit
    __simd_scatter_f32x4(self, base, indices)
  end

  # Load aligned (16-byte aligned address)
  def load_aligned(ptr: &Float) -> Vec4[Float]
    __simd_load_aligned_f32x4(ptr)
  end

  # Store aligned
  def store_aligned(self, ptr: &mut Float) -> Unit
    __simd_store_aligned_f32x4(self, ptr)
  end

  # Load unaligned
  def load_unaligned(ptr: &Float) -> Vec4[Float]
    __simd_load_unaligned_f32x4(ptr)
  end

  # Store unaligned
  def store_unaligned(self, ptr: &mut Float) -> Unit
    __simd_store_unaligned_f32x4(self, ptr)
  end

  # Length/magnitude
  def length(self) -> Float
    self.dot(self).sqrt()
  end

  # Normalize to unit vector
  def normalize(self) -> Vec4[Float]
    let len = self.length()
    if len > 0.00001 then
      self / Vec4[Float]::splat(len)
    else
      Vec4[Float]::splat(0.0)
    end
  end

  # Linear interpolation
  def lerp(self, other: Vec4[Float], t: Float) -> Vec4[Float]
    self + (other - self) * Vec4[Float]::splat(t)
  end

  # Clamp each element
  def clamp(self, lo: Vec4[Float], hi: Vec4[Float]) -> Vec4[Float]
    self.max(lo).min(hi)
  end

  # Absolute value
  def abs(self) -> Vec4[Float]
    __simd_abs_f32x4(self)
  end

  # Negate
  def neg(self) -> Vec4[Float]
    __simd_neg_f32x4(self)
  end

  # Convert to array
  def to_array(self) -> [Float; 4]
    [self.x, self.y, self.z, self.w]
  end
end

# Operator overloads for Vec4[Float]
def (self: Vec4[Float]) + (other: Vec4[Float]) -> Vec4[Float] = self.add(other)
def (self: Vec4[Float]) - (other: Vec4[Float]) -> Vec4[Float] = self.sub(other)
def (self: Vec4[Float]) * (other: Vec4[Float]) -> Vec4[Float] = self.mul(other)
def (self: Vec4[Float]) / (other: Vec4[Float]) -> Vec4[Float] = self.div(other)

# ———————————————————————————————————————————————————————————————
# Int32x4 SIMD Operations
# ———————————————————————————————————————————————————————————————

impl Vec4[i32]
  def splat(val: i32) -> Vec4[i32]
    Vec4[i32] { x: val, y: val, z: val, w: val }
  end

  def add(self, other: Vec4[i32]) -> Vec4[i32]
    __simd_add_i32x4(self, other)
  end

  def sub(self, other: Vec4[i32]) -> Vec4[i32]
    __simd_sub_i32x4(self, other)
  end

  def mul(self, other: Vec4[i32]) -> Vec4[i32]
    __simd_mul_i32x4(self, other)
  end

  # Bitwise operations
  def bitand(self, other: Vec4[i32]) -> Vec4[i32]
    __simd_and_i32x4(self, other)
  end

  def bitor(self, other: Vec4[i32]) -> Vec4[i32]
    __simd_or_i32x4(self, other)
  end

  def bitxor(self, other: Vec4[i32]) -> Vec4[i32]
    __simd_xor_i32x4(self, other)
  end

  def bitnot(self) -> Vec4[i32]
    __simd_not_i32x4(self)
  end

  # Shifts
  def shl(self, count: i32) -> Vec4[i32]
    __simd_shl_i32x4(self, count)
  end

  def shr(self, count: i32) -> Vec4[i32]
    __simd_shr_i32x4(self, count)
  end

  # Min/Max (signed)
  def min(self, other: Vec4[i32]) -> Vec4[i32]
    __simd_min_i32x4(self, other)
  end

  def max(self, other: Vec4[i32]) -> Vec4[i32]
    __simd_max_i32x4(self, other)
  end

  # Horizontal sum
  def hsum(self) -> i32
    __simd_hsum_i32x4(self)
  end
end

# ———————————————————————————————————————————————————————————————
# Float64x2 SIMD Operations (SSE2/NEON)
# ———————————————————————————————————————————————————————————————

impl Vec2[Float]
  def splat(val: Float) -> Vec2[Float]
    Vec2[Float] { x: val, y: val }
  end

  def add(self, other: Vec2[Float]) -> Vec2[Float]
    __simd_add_f64x2(self, other)
  end

  def sub(self, other: Vec2[Float]) -> Vec2[Float]
    __simd_sub_f64x2(self, other)
  end

  def mul(self, other: Vec2[Float]) -> Vec2[Float]
    __simd_mul_f64x2(self, other)
  end

  def div(self, other: Vec2[Float]) -> Vec2[Float]
    __simd_div_f64x2(self, other)
  end

  def sqrt(self) -> Vec2[Float]
    __simd_sqrt_f64x2(self)
  end

  def hsum(self) -> Float
    __simd_hsum_f64x2(self)
  end

  def dot(self, other: Vec2[Float]) -> Float
    (self * other).hsum()
  end
end

# ———————————————————————————————————————————————————————————————
# AVX2 Float32x8 Operations (256-bit)
# ———————————————————————————————————————————————————————————————

impl Vec8[Float]
  def splat(val: Float) -> Vec8[Float]
    Vec8[Float] { e0: val, e1: val, e2: val, e3: val, e4: val, e5: val, e6: val, e7: val }
  end

  def add(self, other: Vec8[Float]) -> Vec8[Float]
    __simd_add_f32x8(self, other)
  end

  def mul(self, other: Vec8[Float]) -> Vec8[Float]
    __simd_mul_f32x8(self, other)
  end

  def hsum(self) -> Float
    __simd_hsum_f32x8(self)
  end

  # Extract lower 128 bits as Vec4
  def extract_low(self) -> Vec4[Float]
    Vec4[Float] { x: self.e0, y: self.e1, z: self.e2, w: self.e3 }
  end

  # Extract upper 128 bits as Vec4
  def extract_high(self) -> Vec4[Float]
    Vec4[Float] { x: self.e4, y: self.e5, z: self.e6, w: self.e7 }
  end
end

# ———————————————————————————————————————————————————————————————
# Matrix Operations (4x4)
# ———————————————————————————————————————————————————————————————

struct Mat4
  rows: [Vec4[Float]; 4]
end

impl Mat4
  # Identity matrix
  def identity() -> Mat4
    Mat4 {
      rows: [
        Vec4[Float] { x: 1.0, y: 0.0, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 1.0, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: 1.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
      ]
    }
  end

  # Matrix multiplication (SIMD optimized)
  def mul(self, other: Mat4) -> Mat4
    __simd_mat4_mul(self, other)
  end

  # Matrix-vector multiplication
  def transform(self, v: Vec4[Float]) -> Vec4[Float]
    __simd_mat4_transform(self, v)
  end

  # Transpose
  def transpose(self) -> Mat4
    __simd_mat4_transpose(self)
  end

  # Determinant
  def det(self) -> Float
    __simd_mat4_det(self)
  end

  # Inverse (returns Option::None if singular)
  def inverse(self) -> Option[Mat4]
    __simd_mat4_inverse(self)
  end

  # Scale matrix
  def scale(sx: Float, sy: Float, sz: Float) -> Mat4
    Mat4 {
      rows: [
        Vec4[Float] { x: sx, y: 0.0, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: sy, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: sz, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
      ]
    }
  end

  # Translation matrix
  def translation(tx: Float, ty: Float, tz: Float) -> Mat4
    Mat4 {
      rows: [
        Vec4[Float] { x: 1.0, y: 0.0, z: 0.0, w: tx },
        Vec4[Float] { x: 0.0, y: 1.0, z: 0.0, w: ty },
        Vec4[Float] { x: 0.0, y: 0.0, z: 1.0, w: tz },
        Vec4[Float] { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
      ]
    }
  end

  # Rotation matrix around X axis
  def rotation_x(angle: Float) -> Mat4
    let c = angle.cos()
    let s = angle.sin()
    Mat4 {
      rows: [
        Vec4[Float] { x: 1.0, y: 0.0, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: c, z: -s, w: 0.0 },
        Vec4[Float] { x: 0.0, y: s, z: c, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
      ]
    }
  end

  # Look-at matrix (view matrix)
  def look_at(eye: Vec4[Float], target: Vec4[Float], up: Vec4[Float]) -> Mat4
    __simd_mat4_look_at(eye, target, up)
  end

  # Perspective projection matrix
  def perspective(fov: Float, aspect: Float, near: Float, far: Float) -> Mat4
    __simd_mat4_perspective(fov, aspect, near, far)
  end
end

# ———————————————————————————————————————————————————————————————
# SIMD Intrinsics (Compiler Builtins)
# ———————————————————————————————————————————————————————————————
# These are implemented by the codegen backend using platform-specific
# instructions (SSE/AVX/NEON) with portable fallbacks.

# Float32x4 intrinsics
extern def __simd_add_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
extern def __simd_sub_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
extern def __simd_mul_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
extern def __simd_div_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
extern def __simd_hsum_f32x4(v: Vec4[Float]) -> Float
extern def __simd_fma_f32x4(a: Vec4[Float], b: Vec4[Float], c: Vec4[Float]) -> Vec4[Float]
extern def __simd_sqrt_f32x4(v: Vec4[Float]) -> Vec4[Float]
extern def __simd_rcp_f32x4(v: Vec4[Float]) -> Vec4[Float]
extern def __simd_rsqrt_f32x4(v: Vec4[Float]) -> Vec4[Float]
extern def __simd_min_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
extern def __simd_max_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
extern def __simd_cmpeq_f32x4(a: Vec4[Float], b: Vec4[Float]) -> u32
extern def __simd_cmplt_f32x4(a: Vec4[Float], b: Vec4[Float]) -> u32
extern def __simd_cmple_f32x4(a: Vec4[Float], b: Vec4[Float]) -> u32
extern def __simd_blend_f32x4(a: Vec4[Float], b: Vec4[Float], mask: u32) -> Vec4[Float]
extern def __simd_gather_f32x4(base: &Float, indices: Vec4[i32]) -> Vec4[Float]
extern def __simd_scatter_f32x4(v: Vec4[Float], base: &mut Float, indices: Vec4[i32]) -> Unit
extern def __simd_load_aligned_f32x4(ptr: &Float) -> Vec4[Float]
extern def __simd_store_aligned_f32x4(v: Vec4[Float], ptr: &mut Float) -> Unit
extern def __simd_load_unaligned_f32x4(ptr: &Float) -> Vec4[Float]
extern def __simd_store_unaligned_f32x4(v: Vec4[Float], ptr: &mut Float) -> Unit
extern def __simd_abs_f32x4(v: Vec4[Float]) -> Vec4[Float]
extern def __simd_neg_f32x4(v: Vec4[Float]) -> Vec4[Float]

# Int32x4 intrinsics
extern def __simd_add_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
extern def __simd_sub_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
extern def __simd_mul_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
extern def __simd_and_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
extern def __simd_or_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
extern def __simd_xor_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
extern def __simd_not_i32x4(a: Vec4[i32]) -> Vec4[i32]
extern def __simd_shl_i32x4(a: Vec4[i32], count: i32) -> Vec4[i32]
extern def __simd_shr_i32x4(a: Vec4[i32], count: i32) -> Vec4[i32]
extern def __simd_min_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
extern def __simd_max_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
extern def __simd_hsum_i32x4(v: Vec4[i32]) -> i32

# Float64x2 intrinsics
extern def __simd_add_f64x2(a: Vec2[Float], b: Vec2[Float]) -> Vec2[Float]
extern def __simd_sub_f64x2(a: Vec2[Float], b: Vec2[Float]) -> Vec2[Float]
extern def __simd_mul_f64x2(a: Vec2[Float], b: Vec2[Float]) -> Vec2[Float]
extern def __simd_div_f64x2(a: Vec2[Float], b: Vec2[Float]) -> Vec2[Float]
extern def __simd_sqrt_f64x2(v: Vec2[Float]) -> Vec2[Float]
extern def __simd_hsum_f64x2(v: Vec2[Float]) -> Float

# Float32x8 intrinsics (AVX)
extern def __simd_add_f32x8(a: Vec8[Float], b: Vec8[Float]) -> Vec8[Float]
extern def __simd_mul_f32x8(a: Vec8[Float], b: Vec8[Float]) -> Vec8[Float]
extern def __simd_hsum_f32x8(v: Vec8[Float]) -> Float

# Matrix intrinsics
extern def __simd_mat4_mul(a: Mat4, b: Mat4) -> Mat4
extern def __simd_mat4_transform(m: Mat4, v: Vec4[Float]) -> Vec4[Float]
extern def __simd_mat4_transpose(m: Mat4) -> Mat4
extern def __simd_mat4_det(m: Mat4) -> Float
extern def __simd_mat4_inverse(m: Mat4) -> Option[Mat4]
extern def __simd_mat4_look_at(eye: Vec4[Float], target: Vec4[Float], up: Vec4[Float]) -> Mat4
extern def __simd_mat4_perspective(fov: Float, aspect: Float, near: Float, far: Float) -> Mat4

# ———————————————————————————————————————————————————————————————
# Portable Fallback Implementations
# ———————————————————————————————————————————————————————————————
# When SIMD is not available, use scalar fallbacks

def portable_add_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
  Vec4[Float] {
    x: a.x + b.x,
    y: a.y + b.y,
    z: a.z + b.z,
    w: a.w + b.w
  }
end

def portable_mul_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
  Vec4[Float] {
    x: a.x * b.x,
    y: a.y * b.y,
    z: a.z * b.z,
    w: a.w * b.w
  }
end

def portable_hsum_f32x4(v: Vec4[Float]) -> Float
  v.x + v.y + v.z + v.w
end

def portable_dot_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Float
  (a.x * b.x) + (a.y * b.y) + (a.z * b.z) + (a.w * b.w)
end

# ———————————————————————————————————————————————————————————————
# Batch Operations
# ———————————————————————————————————————————————————————————————

# Vectorized array addition
def vec_add_arrays(a: &[Float], b: &[Float], out: &mut [Float], len: Int) -> Unit
  let caps = detect_simd()
  
  if caps.has_sse2 && len >= 4 then
    # Process 4 elements at a time
    mut i = 0
    while i + 4 <= len do
      let va = Vec4[Float]::load_unaligned(&a[i])
      let vb = Vec4[Float]::load_unaligned(&b[i])
      let result = va + vb
      result.store_unaligned(&mut out[i])
      i = i + 4
    end
    # Handle remaining elements
    while i < len do
      out[i] = a[i] + b[i]
      i = i + 1
    end
  else
    # Scalar fallback
    mut i = 0
    while i < len do
      out[i] = a[i] + b[i]
      i = i + 1
    end
  end
end

# Vectorized array multiplication
def vec_mul_arrays(a: &[Float], b: &[Float], out: &mut [Float], len: Int) -> Unit
  let caps = detect_simd()
  
  if caps.has_sse2 && len >= 4 then
    mut i = 0
    while i + 4 <= len do
      let va = Vec4[Float]::load_unaligned(&a[i])
      let vb = Vec4[Float]::load_unaligned(&b[i])
      let result = va * vb
      result.store_unaligned(&mut out[i])
      i = i + 4
    end
    while i < len do
      out[i] = a[i] * b[i]
      i = i + 1
    end
  else
    mut i = 0
    while i < len do
      out[i] = a[i] * b[i]
      i = i + 1
    end
  end
end

# Vectorized dot product of two arrays
def vec_dot_product(a: &[Float], b: &[Float], len: Int) -> Float
  let caps = detect_simd()
  
  if caps.has_sse2 && len >= 4 then
    mut sum = Vec4[Float]::splat(0.0)
    mut i = 0
    while i + 4 <= len do
      let va = Vec4[Float]::load_unaligned(&a[i])
      let vb = Vec4[Float]::load_unaligned(&b[i])
      sum = sum + va * vb
      i = i + 4
    end
    mut result = sum.hsum()
    while i < len do
      result = result + a[i] * b[i]
      i = i + 1
    end
    result
  else
    mut result = 0.0
    mut i = 0
    while i < len do
      result = result + a[i] * b[i]
      i = i + 1
    end
    result
  end
end

# Vectorized FMA: out = a * b + c
def vec_fma_arrays(a: &[Float], b: &[Float], c: &[Float], out: &mut [Float], len: Int) -> Unit
  let caps = detect_simd()
  
  if caps.has_fma && len >= 4 then
    mut i = 0
    while i + 4 <= len do
      let va = Vec4[Float]::load_unaligned(&a[i])
      let vb = Vec4[Float]::load_unaligned(&b[i])
      let vc = Vec4[Float]::load_unaligned(&c[i])
      let result = va.fma(vb, vc)
      result.store_unaligned(&mut out[i])
      i = i + 4
    end
    while i < len do
      out[i] = a[i] * b[i] + c[i]
      i = i + 1
    end
  else
    mut i = 0
    while i < len do
      out[i] = a[i] * b[i] + c[i]
      i = i + 1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Memory Operations
# ———————————————————————————————————————————————————————————————

# Prefetch hint for cache optimization
extern def __simd_prefetch(ptr: &Unit, locality: Int) -> Unit  # locality: 0=nontemporal, 1=L1, 2=L2, 3=L3

# Streaming store (bypass cache)
extern def __simd_stream_store_f32x4(v: Vec4[Float], ptr: &mut Float) -> Unit

# Memory fence
extern def __simd_memory_fence() -> Unit

# ———————————————————————————————————————————————————————————————
# Trigonometry (approximate, SIMD)
# ———————————————————————————————————————————————————————————————

# Fast approximate sin for Vec4
def sin_approx(v: Vec4[Float]) -> Vec4[Float]
  __simd_sin_f32x4(v)
end

# Fast approximate cos for Vec4
def cos_approx(v: Vec4[Float]) -> Vec4[Float]
  __simd_cos_f32x4(v)
end

extern def __simd_sin_f32x4(v: Vec4[Float]) -> Vec4[Float]
extern def __simd_cos_f32x4(v: Vec4[Float]) -> Vec4[Float]