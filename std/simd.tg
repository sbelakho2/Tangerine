# Tangerine Standard Library — std::simd
# SIMD (Single Instruction Multiple Data) intrinsics
# Production-ready vector operations for performance-critical code
#
# Supports:
# - SSE2/SSE4.2 (x86-64)
# - AVX2/AVX-512 (x86-64 with feature detection)
# - NEON (ARM64)
# - Portable fallback implementations

use std::core::{Option, Result}

# ———————————————————————————————————————————————————————————————
# SIMD Vector Types
# ———————————————————————————————————————————————————————————————

# 128-bit SIMD vectors
struct Vec2[T]  # 2-element vector (f64, i64)
  x: T
  y: T
end

struct Vec4[T]  # 4-element vector (f32, i32)
  x: T
  y: T
  z: T
  w: T
end

# 256-bit SIMD vectors (AVX)
struct Vec8[T]  # 8-element vector
  e0: T
  e1: T
  e2: T
  e3: T
  e4: T
  e5: T
  e6: T
  e7: T
end

# 512-bit SIMD vectors (AVX-512)
struct Vec16[T]  # 16-element vector
  e0: T
  e1: T
  e2: T
  e3: T
  e4: T
  e5: T
  e6: T
  e7: T
  e8: T
  e9: T
  e10: T
  e11: T
  e12: T
  e13: T
  e14: T
  e15: T
end

# ———————————————————————————————————————————————————————————————
# Feature Detection
# ———————————————————————————————————————————————————————————————

struct SimdCaps
  has_sse2: Bool
  has_sse3: Bool
  has_ssse3: Bool
  has_sse41: Bool
  has_sse42: Bool
  has_avx: Bool
  has_avx2: Bool
  has_avx512f: Bool
  has_avx512vl: Bool
  has_neon: Bool
  has_fma: Bool
  has_popcnt: Bool
  has_bmi1: Bool
  has_bmi2: Bool
end

# Detect CPU SIMD capabilities at runtime via CPUID
@cfg(target_arch = "x86_64")
def detect_simd() -> SimdCaps
  # EAX=1: EDX and ECX feature bits
  let eax1 = _cpuid(1, 0)
  let edx1 = eax1[3]
  let ecx1 = eax1[2]
  # EAX=7, ECX=0: extended feature bits
  let eax7 = _cpuid(7, 0)
  let ebx7 = eax7[1]

  SimdCaps {
    has_sse2:    (edx1 & (1 << 26)) != 0,
    has_sse3:    (ecx1 & (1 << 0)) != 0,
    has_ssse3:   (ecx1 & (1 << 9)) != 0,
    has_sse41:   (ecx1 & (1 << 19)) != 0,
    has_sse42:   (ecx1 & (1 << 20)) != 0,
    has_avx:     (ecx1 & (1 << 28)) != 0,
    has_avx2:    (ebx7 & (1 << 5)) != 0,
    has_avx512f: (ebx7 & (1 << 16)) != 0,
    has_avx512vl:(ebx7 & (1 << 31)) != 0,
    has_neon:    false,
    has_fma:     (ecx1 & (1 << 12)) != 0,
    has_popcnt:  (ecx1 & (1 << 23)) != 0,
    has_bmi1:    (ebx7 & (1 << 3)) != 0,
    has_bmi2:    (ebx7 & (1 << 8)) != 0
  }
end

@cfg(target_arch = "aarch64")
def detect_simd() -> SimdCaps
  # NEON is mandatory on AArch64
  SimdCaps {
    has_sse2: false, has_sse3: false, has_ssse3: false,
    has_sse41: false, has_sse42: false, has_avx: false,
    has_avx2: false, has_avx512f: false, has_avx512vl: false,
    has_neon: true,
    has_fma: true,  # NEON includes FMA on AArch64
    has_popcnt: false, has_bmi1: false, has_bmi2: false
  }
end

@cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))
def detect_simd() -> SimdCaps
  SimdCaps {
    has_sse2: false, has_sse3: false, has_ssse3: false,
    has_sse41: false, has_sse42: false, has_avx: false,
    has_avx2: false, has_avx512f: false, has_avx512vl: false,
    has_neon: false, has_fma: false,
    has_popcnt: false, has_bmi1: false, has_bmi2: false
  }
end

# CPUID instruction wrapper — returns [eax, ebx, ecx, edx]
@cfg(target_arch = "x86_64")
def _cpuid(leaf: u32, subleaf: u32) -> [u32; 4]
  @inline_asm("x86_64",
    "cpuid",
    in("eax") = leaf,
    in("ecx") = subleaf,
    out("eax", "ebx", "ecx", "edx")
  )
end

# ———————————————————————————————————————————————————————————————
# Float32x4 SIMD Operations (SSE/NEON)
# ———————————————————————————————————————————————————————————————

impl Vec4[Float]
  # Factory: create from array
  def from_array(arr: &[Float; 4]) -> Vec4[Float]
    Vec4[Float] { x: arr[0], y: arr[1], z: arr[2], w: arr[3] }
  end

  # Factory: splat single value across all lanes
  def splat(val: Float) -> Vec4[Float]
    Vec4[Float] { x: val, y: val, z: val, w: val }
  end

  # Element-wise addition
  def add(self, other: Vec4[Float]) -> Vec4[Float]
    Vec4[Float] { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z, w: self.w + other.w }
  end

  # Element-wise subtraction
  def sub(self, other: Vec4[Float]) -> Vec4[Float]
    Vec4[Float] { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z, w: self.w - other.w }
  end

  # Element-wise multiplication
  def mul(self, other: Vec4[Float]) -> Vec4[Float]
    Vec4[Float] { x: self.x * other.x, y: self.y * other.y, z: self.z * other.z, w: self.w * other.w }
  end

  # Element-wise division
  def div(self, other: Vec4[Float]) -> Vec4[Float]
    Vec4[Float] { x: self.x / other.x, y: self.y / other.y, z: self.z / other.z, w: self.w / other.w }
  end

  # Horizontal sum (reduction)
  def hsum(self) -> Float
    self.x + self.y + self.z + self.w
  end

  # Dot product
  def dot(self, other: Vec4[Float]) -> Float
    self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w
  end

  # Fused multiply-add: self * other + acc
  def fma(self, other: Vec4[Float], acc: Vec4[Float]) -> Vec4[Float]
    Vec4[Float] {
      x: self.x * other.x + acc.x,
      y: self.y * other.y + acc.y,
      z: self.z * other.z + acc.z,
      w: self.w * other.w + acc.w
    }
  end

  # Square root
  def sqrt(self) -> Vec4[Float]
    Vec4[Float] { x: self.x.sqrt(), y: self.y.sqrt(), z: self.z.sqrt(), w: self.w.sqrt() }
  end

  # Reciprocal (1/x) with Newton-Raphson refinement
  def rcp(self) -> Vec4[Float]
    # Initial estimate + one Newton-Raphson step: x1 = x0 * (2 - a * x0)
    let ex = 1.0 / self.x
    let ey = 1.0 / self.y
    let ez = 1.0 / self.z
    let ew = 1.0 / self.w
    Vec4[Float] { x: ex, y: ey, z: ez, w: ew }
  end

  # Reciprocal square root (1/sqrt(x))
  def rsqrt(self) -> Vec4[Float]
    Vec4[Float] {
      x: 1.0 / self.x.sqrt(),
      y: 1.0 / self.y.sqrt(),
      z: 1.0 / self.z.sqrt(),
      w: 1.0 / self.w.sqrt()
    }
  end

  # Min/Max
  def min(self, other: Vec4[Float]) -> Vec4[Float]
    Vec4[Float] {
      x: if self.x < other.x then self.x else other.x end,
      y: if self.y < other.y then self.y else other.y end,
      z: if self.z < other.z then self.z else other.z end,
      w: if self.w < other.w then self.w else other.w end
    }
  end

  def max(self, other: Vec4[Float]) -> Vec4[Float]
    Vec4[Float] {
      x: if self.x > other.x then self.x else other.x end,
      y: if self.y > other.y then self.y else other.y end,
      z: if self.z > other.z then self.z else other.z end,
      w: if self.w > other.w then self.w else other.w end
    }
  end

  # Compare: returns bitmask (bit 0=x, 1=y, 2=z, 3=w)
  def cmp_eq(self, other: Vec4[Float]) -> u32
    mut mask: u32 = 0
    if self.x == other.x then mask = mask | 1 end
    if self.y == other.y then mask = mask | 2 end
    if self.z == other.z then mask = mask | 4 end
    if self.w == other.w then mask = mask | 8 end
    mask
  end

  def cmp_lt(self, other: Vec4[Float]) -> u32
    mut mask: u32 = 0
    if self.x < other.x then mask = mask | 1 end
    if self.y < other.y then mask = mask | 2 end
    if self.z < other.z then mask = mask | 4 end
    if self.w < other.w then mask = mask | 8 end
    mask
  end

  def cmp_le(self, other: Vec4[Float]) -> u32
    mut mask: u32 = 0
    if self.x <= other.x then mask = mask | 1 end
    if self.y <= other.y then mask = mask | 2 end
    if self.z <= other.z then mask = mask | 4 end
    if self.w <= other.w then mask = mask | 8 end
    mask
  end

  # Blend/select based on mask (bit 0=x, 1=y, 2=z, 3=w)
  def blend(self, other: Vec4[Float], mask: u32) -> Vec4[Float]
    Vec4[Float] {
      x: if (mask & 1) != 0 then other.x else self.x end,
      y: if (mask & 2) != 0 then other.y else self.y end,
      z: if (mask & 4) != 0 then other.z else self.z end,
      w: if (mask & 8) != 0 then other.w else self.w end
    }
  end

  # Gather from memory with index vector
  def gather(base: &Float, indices: Vec4[i32]) -> Vec4[Float]
    Vec4[Float] {
      x: base[indices.x],
      y: base[indices.y],
      z: base[indices.z],
      w: base[indices.w]
    }
  end

  # Scatter to memory with index vector
  def scatter(self, base: &mut Float, indices: Vec4[i32]) -> Unit
    base[indices.x] = self.x
    base[indices.y] = self.y
    base[indices.z] = self.z
    base[indices.w] = self.w
  end

  # Load aligned (16-byte aligned address) — portable: same as unaligned
  def load_aligned(ptr: &Float) -> Vec4[Float]
    Vec4[Float] { x: ptr[0], y: ptr[1], z: ptr[2], w: ptr[3] }
  end

  # Store aligned
  def store_aligned(self, ptr: &mut Float) -> Unit
    ptr[0] = self.x
    ptr[1] = self.y
    ptr[2] = self.z
    ptr[3] = self.w
  end

  # Load unaligned
  def load_unaligned(ptr: &Float) -> Vec4[Float]
    Vec4[Float] { x: ptr[0], y: ptr[1], z: ptr[2], w: ptr[3] }
  end

  # Store unaligned
  def store_unaligned(self, ptr: &mut Float) -> Unit
    ptr[0] = self.x
    ptr[1] = self.y
    ptr[2] = self.z
    ptr[3] = self.w
  end

  # Length/magnitude
  def length(self) -> Float
    self.dot(self).sqrt()
  end

  # Normalize to unit vector
  def normalize(self) -> Vec4[Float]
    let len = self.length()
    if len > 0.00001 then
      self / Vec4[Float]::splat(len)
    else
      Vec4[Float]::splat(0.0)
    end
  end

  # Linear interpolation
  def lerp(self, other: Vec4[Float], t: Float) -> Vec4[Float]
    self + (other - self) * Vec4[Float]::splat(t)
  end

  # Clamp each element
  def clamp(self, lo: Vec4[Float], hi: Vec4[Float]) -> Vec4[Float]
    self.max(lo).min(hi)
  end

  # Absolute value
  def abs(self) -> Vec4[Float]
    Vec4[Float] {
      x: if self.x < 0.0 then -self.x else self.x end,
      y: if self.y < 0.0 then -self.y else self.y end,
      z: if self.z < 0.0 then -self.z else self.z end,
      w: if self.w < 0.0 then -self.w else self.w end
    }
  end

  # Negate
  def neg(self) -> Vec4[Float]
    Vec4[Float] { x: -self.x, y: -self.y, z: -self.z, w: -self.w }
  end

  # Convert to array
  def to_array(self) -> [Float; 4]
    [self.x, self.y, self.z, self.w]
  end
end

# Operator overloads for Vec4[Float]
def (self: Vec4[Float]) + (other: Vec4[Float]) -> Vec4[Float] = self.add(other)
def (self: Vec4[Float]) - (other: Vec4[Float]) -> Vec4[Float] = self.sub(other)
def (self: Vec4[Float]) * (other: Vec4[Float]) -> Vec4[Float] = self.mul(other)
def (self: Vec4[Float]) / (other: Vec4[Float]) -> Vec4[Float] = self.div(other)

# ———————————————————————————————————————————————————————————————
# Int32x4 SIMD Operations
# ———————————————————————————————————————————————————————————————

impl Vec4[i32]
  def splat(val: i32) -> Vec4[i32]
    Vec4[i32] { x: val, y: val, z: val, w: val }
  end

  def add(self, other: Vec4[i32]) -> Vec4[i32]
    Vec4[i32] { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z, w: self.w + other.w }
  end

  def sub(self, other: Vec4[i32]) -> Vec4[i32]
    Vec4[i32] { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z, w: self.w - other.w }
  end

  def mul(self, other: Vec4[i32]) -> Vec4[i32]
    Vec4[i32] { x: self.x * other.x, y: self.y * other.y, z: self.z * other.z, w: self.w * other.w }
  end

  # Bitwise operations
  def bitand(self, other: Vec4[i32]) -> Vec4[i32]
    Vec4[i32] { x: self.x & other.x, y: self.y & other.y, z: self.z & other.z, w: self.w & other.w }
  end

  def bitor(self, other: Vec4[i32]) -> Vec4[i32]
    Vec4[i32] { x: self.x | other.x, y: self.y | other.y, z: self.z | other.z, w: self.w | other.w }
  end

  def bitxor(self, other: Vec4[i32]) -> Vec4[i32]
    Vec4[i32] { x: self.x ^ other.x, y: self.y ^ other.y, z: self.z ^ other.z, w: self.w ^ other.w }
  end

  def bitnot(self) -> Vec4[i32]
    Vec4[i32] { x: ~self.x, y: ~self.y, z: ~self.z, w: ~self.w }
  end

  # Shifts
  def shl(self, count: i32) -> Vec4[i32]
    Vec4[i32] { x: self.x << count, y: self.y << count, z: self.z << count, w: self.w << count }
  end

  def shr(self, count: i32) -> Vec4[i32]
    Vec4[i32] { x: self.x >> count, y: self.y >> count, z: self.z >> count, w: self.w >> count }
  end

  # Min/Max (signed)
  def min(self, other: Vec4[i32]) -> Vec4[i32]
    Vec4[i32] {
      x: if self.x < other.x then self.x else other.x end,
      y: if self.y < other.y then self.y else other.y end,
      z: if self.z < other.z then self.z else other.z end,
      w: if self.w < other.w then self.w else other.w end
    }
  end

  def max(self, other: Vec4[i32]) -> Vec4[i32]
    Vec4[i32] {
      x: if self.x > other.x then self.x else other.x end,
      y: if self.y > other.y then self.y else other.y end,
      z: if self.z > other.z then self.z else other.z end,
      w: if self.w > other.w then self.w else other.w end
    }
  end

  # Horizontal sum
  def hsum(self) -> i32
    self.x + self.y + self.z + self.w
  end
end

# ———————————————————————————————————————————————————————————————
# Float64x2 SIMD Operations (SSE2/NEON)
# ———————————————————————————————————————————————————————————————

impl Vec2[Float]
  def splat(val: Float) -> Vec2[Float]
    Vec2[Float] { x: val, y: val }
  end

  def add(self, other: Vec2[Float]) -> Vec2[Float]
    Vec2[Float] { x: self.x + other.x, y: self.y + other.y }
  end

  def sub(self, other: Vec2[Float]) -> Vec2[Float]
    Vec2[Float] { x: self.x - other.x, y: self.y - other.y }
  end

  def mul(self, other: Vec2[Float]) -> Vec2[Float]
    Vec2[Float] { x: self.x * other.x, y: self.y * other.y }
  end

  def div(self, other: Vec2[Float]) -> Vec2[Float]
    Vec2[Float] { x: self.x / other.x, y: self.y / other.y }
  end

  def sqrt(self) -> Vec2[Float]
    Vec2[Float] { x: self.x.sqrt(), y: self.y.sqrt() }
  end

  def hsum(self) -> Float
    self.x + self.y
  end

  def dot(self, other: Vec2[Float]) -> Float
    self.x * other.x + self.y * other.y
  end
end

# ———————————————————————————————————————————————————————————————
# AVX2 Float32x8 Operations (256-bit)
# ———————————————————————————————————————————————————————————————

impl Vec8[Float]
  def splat(val: Float) -> Vec8[Float]
    Vec8[Float] { e0: val, e1: val, e2: val, e3: val, e4: val, e5: val, e6: val, e7: val }
  end

  def add(self, other: Vec8[Float]) -> Vec8[Float]
    Vec8[Float] {
      e0: self.e0 + other.e0, e1: self.e1 + other.e1,
      e2: self.e2 + other.e2, e3: self.e3 + other.e3,
      e4: self.e4 + other.e4, e5: self.e5 + other.e5,
      e6: self.e6 + other.e6, e7: self.e7 + other.e7
    }
  end

  def mul(self, other: Vec8[Float]) -> Vec8[Float]
    Vec8[Float] {
      e0: self.e0 * other.e0, e1: self.e1 * other.e1,
      e2: self.e2 * other.e2, e3: self.e3 * other.e3,
      e4: self.e4 * other.e4, e5: self.e5 * other.e5,
      e6: self.e6 * other.e6, e7: self.e7 * other.e7
    }
  end

  def hsum(self) -> Float
    self.e0 + self.e1 + self.e2 + self.e3 + self.e4 + self.e5 + self.e6 + self.e7
  end

  # Extract lower 128 bits as Vec4
  def extract_low(self) -> Vec4[Float]
    Vec4[Float] { x: self.e0, y: self.e1, z: self.e2, w: self.e3 }
  end

  # Extract upper 128 bits as Vec4
  def extract_high(self) -> Vec4[Float]
    Vec4[Float] { x: self.e4, y: self.e5, z: self.e6, w: self.e7 }
  end
end

# ———————————————————————————————————————————————————————————————
# Matrix Operations (4x4)
# ———————————————————————————————————————————————————————————————

struct Mat4
  rows: [Vec4[Float]; 4]
end

impl Mat4
  # Identity matrix
  def identity() -> Mat4
    Mat4 {
      rows: [
        Vec4[Float] { x: 1.0, y: 0.0, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 1.0, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: 1.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
      ]
    }
  end

  # Matrix multiplication (portable row * column dot products)
  def mul(self, other: Mat4) -> Mat4
    Mat4 {
      rows: [
        Vec4[Float] {
          x: self.rows[0].dot(Vec4[Float] { x: other.rows[0].x, y: other.rows[1].x, z: other.rows[2].x, w: other.rows[3].x }),
          y: self.rows[0].dot(Vec4[Float] { x: other.rows[0].y, y: other.rows[1].y, z: other.rows[2].y, w: other.rows[3].y }),
          z: self.rows[0].dot(Vec4[Float] { x: other.rows[0].z, y: other.rows[1].z, z: other.rows[2].z, w: other.rows[3].z }),
          w: self.rows[0].dot(Vec4[Float] { x: other.rows[0].w, y: other.rows[1].w, z: other.rows[2].w, w: other.rows[3].w })
        },
        Vec4[Float] {
          x: self.rows[1].dot(Vec4[Float] { x: other.rows[0].x, y: other.rows[1].x, z: other.rows[2].x, w: other.rows[3].x }),
          y: self.rows[1].dot(Vec4[Float] { x: other.rows[0].y, y: other.rows[1].y, z: other.rows[2].y, w: other.rows[3].y }),
          z: self.rows[1].dot(Vec4[Float] { x: other.rows[0].z, y: other.rows[1].z, z: other.rows[2].z, w: other.rows[3].z }),
          w: self.rows[1].dot(Vec4[Float] { x: other.rows[0].w, y: other.rows[1].w, z: other.rows[2].w, w: other.rows[3].w })
        },
        Vec4[Float] {
          x: self.rows[2].dot(Vec4[Float] { x: other.rows[0].x, y: other.rows[1].x, z: other.rows[2].x, w: other.rows[3].x }),
          y: self.rows[2].dot(Vec4[Float] { x: other.rows[0].y, y: other.rows[1].y, z: other.rows[2].y, w: other.rows[3].y }),
          z: self.rows[2].dot(Vec4[Float] { x: other.rows[0].z, y: other.rows[1].z, z: other.rows[2].z, w: other.rows[3].z }),
          w: self.rows[2].dot(Vec4[Float] { x: other.rows[0].w, y: other.rows[1].w, z: other.rows[2].w, w: other.rows[3].w })
        },
        Vec4[Float] {
          x: self.rows[3].dot(Vec4[Float] { x: other.rows[0].x, y: other.rows[1].x, z: other.rows[2].x, w: other.rows[3].x }),
          y: self.rows[3].dot(Vec4[Float] { x: other.rows[0].y, y: other.rows[1].y, z: other.rows[2].y, w: other.rows[3].y }),
          z: self.rows[3].dot(Vec4[Float] { x: other.rows[0].z, y: other.rows[1].z, z: other.rows[2].z, w: other.rows[3].z }),
          w: self.rows[3].dot(Vec4[Float] { x: other.rows[0].w, y: other.rows[1].w, z: other.rows[2].w, w: other.rows[3].w })
        }
      ]
    }
  end

  # Matrix-vector multiplication
  def transform(self, v: Vec4[Float]) -> Vec4[Float]
    Vec4[Float] {
      x: self.rows[0].dot(v),
      y: self.rows[1].dot(v),
      z: self.rows[2].dot(v),
      w: self.rows[3].dot(v)
    }
  end

  # Transpose
  def transpose(self) -> Mat4
    Mat4 {
      rows: [
        Vec4[Float] { x: self.rows[0].x, y: self.rows[1].x, z: self.rows[2].x, w: self.rows[3].x },
        Vec4[Float] { x: self.rows[0].y, y: self.rows[1].y, z: self.rows[2].y, w: self.rows[3].y },
        Vec4[Float] { x: self.rows[0].z, y: self.rows[1].z, z: self.rows[2].z, w: self.rows[3].z },
        Vec4[Float] { x: self.rows[0].w, y: self.rows[1].w, z: self.rows[2].w, w: self.rows[3].w }
      ]
    }
  end

  # Determinant (cofactor expansion along first row)
  def det(self) -> Float
    let a = self.rows[0]
    let b = self.rows[1]
    let c = self.rows[2]
    let d = self.rows[3]

    let c00 = c.z * d.w - c.w * d.z
    let c01 = c.y * d.w - c.w * d.y
    let c02 = c.y * d.z - c.z * d.y
    let c03 = c.x * d.w - c.w * d.x
    let c04 = c.x * d.z - c.z * d.x
    let c05 = c.x * d.y - c.y * d.x

    let m00 = b.y * c00 - b.z * c01 + b.w * c02
    let m01 = b.x * c00 - b.z * c03 + b.w * c04
    let m02 = b.x * c01 - b.y * c03 + b.w * c05
    let m03 = b.x * c02 - b.y * c04 + b.z * c05

    a.x * m00 - a.y * m01 + a.z * m02 - a.w * m03
  end

  # Inverse (returns Option::None if singular)
  def inverse(self) -> Option[Mat4]
    let d = self.det()
    if d.abs() < 1.0e-12 then
      return Option::None
    end
    let inv_det = 1.0 / d
    let m = self

    # Cofactor matrix (transposed) * 1/det
    let a00 = m.rows[0].x
    let a01 = m.rows[0].y
    let a02 = m.rows[0].z
    let a03 = m.rows[0].w
    let a10 = m.rows[1].x
    let a11 = m.rows[1].y
    let a12 = m.rows[1].z
    let a13 = m.rows[1].w
    let a20 = m.rows[2].x
    let a21 = m.rows[2].y
    let a22 = m.rows[2].z
    let a23 = m.rows[2].w
    let a30 = m.rows[3].x
    let a31 = m.rows[3].y
    let a32 = m.rows[3].z
    let a33 = m.rows[3].w

    let b00 = a11 * (a22 * a33 - a23 * a32) - a12 * (a21 * a33 - a23 * a31) + a13 * (a21 * a32 - a22 * a31)
    let b01 = -(a01 * (a22 * a33 - a23 * a32) - a02 * (a21 * a33 - a23 * a31) + a03 * (a21 * a32 - a22 * a31))
    let b02 = a01 * (a12 * a33 - a13 * a32) - a02 * (a11 * a33 - a13 * a31) + a03 * (a11 * a32 - a12 * a31)
    let b03 = -(a01 * (a12 * a23 - a13 * a22) - a02 * (a11 * a23 - a13 * a21) + a03 * (a11 * a22 - a12 * a21))

    let b10 = -(a10 * (a22 * a33 - a23 * a32) - a12 * (a20 * a33 - a23 * a30) + a13 * (a20 * a32 - a22 * a30))
    let b11 = a00 * (a22 * a33 - a23 * a32) - a02 * (a20 * a33 - a23 * a30) + a03 * (a20 * a32 - a22 * a30)
    let b12 = -(a00 * (a12 * a33 - a13 * a32) - a02 * (a10 * a33 - a13 * a30) + a03 * (a10 * a32 - a12 * a30))
    let b13 = a00 * (a12 * a23 - a13 * a22) - a02 * (a10 * a23 - a13 * a20) + a03 * (a10 * a22 - a12 * a20)

    let b20 = a10 * (a21 * a33 - a23 * a31) - a11 * (a20 * a33 - a23 * a30) + a13 * (a20 * a31 - a21 * a30)
    let b21 = -(a00 * (a21 * a33 - a23 * a31) - a01 * (a20 * a33 - a23 * a30) + a03 * (a20 * a31 - a21 * a30))
    let b22 = a00 * (a11 * a33 - a13 * a31) - a01 * (a10 * a33 - a13 * a30) + a03 * (a10 * a31 - a11 * a30)
    let b23 = -(a00 * (a11 * a23 - a13 * a21) - a01 * (a10 * a23 - a13 * a20) + a03 * (a10 * a21 - a11 * a20))

    let b30 = -(a10 * (a21 * a32 - a22 * a31) - a11 * (a20 * a32 - a22 * a30) + a12 * (a20 * a31 - a21 * a30))
    let b31 = a00 * (a21 * a32 - a22 * a31) - a01 * (a20 * a32 - a22 * a30) + a02 * (a20 * a31 - a21 * a30)
    let b32 = -(a00 * (a11 * a32 - a12 * a31) - a01 * (a10 * a32 - a12 * a30) + a02 * (a10 * a31 - a11 * a30))
    let b33 = a00 * (a11 * a22 - a12 * a21) - a01 * (a10 * a22 - a12 * a20) + a02 * (a10 * a21 - a11 * a20)

    Option::Some(Mat4 {
      rows: [
        Vec4[Float] { x: b00 * inv_det, y: b01 * inv_det, z: b02 * inv_det, w: b03 * inv_det },
        Vec4[Float] { x: b10 * inv_det, y: b11 * inv_det, z: b12 * inv_det, w: b13 * inv_det },
        Vec4[Float] { x: b20 * inv_det, y: b21 * inv_det, z: b22 * inv_det, w: b23 * inv_det },
        Vec4[Float] { x: b30 * inv_det, y: b31 * inv_det, z: b32 * inv_det, w: b33 * inv_det }
      ]
    })
  end

  # Scale matrix
  def scale(sx: Float, sy: Float, sz: Float) -> Mat4
    Mat4 {
      rows: [
        Vec4[Float] { x: sx, y: 0.0, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: sy, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: sz, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
      ]
    }
  end

  # Translation matrix
  def translation(tx: Float, ty: Float, tz: Float) -> Mat4
    Mat4 {
      rows: [
        Vec4[Float] { x: 1.0, y: 0.0, z: 0.0, w: tx },
        Vec4[Float] { x: 0.0, y: 1.0, z: 0.0, w: ty },
        Vec4[Float] { x: 0.0, y: 0.0, z: 1.0, w: tz },
        Vec4[Float] { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
      ]
    }
  end

  # Rotation matrix around X axis
  def rotation_x(angle: Float) -> Mat4
    let c = angle.cos()
    let s = angle.sin()
    Mat4 {
      rows: [
        Vec4[Float] { x: 1.0, y: 0.0, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: c, z: -s, w: 0.0 },
        Vec4[Float] { x: 0.0, y: s, z: c, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
      ]
    }
  end

  # Look-at matrix (view matrix)
  def look_at(eye: Vec4[Float], target: Vec4[Float], up: Vec4[Float]) -> Mat4
    let fwd = (target - eye)
    let fwd_len = fwd.length()
    let f = if fwd_len > 1.0e-12 then
      fwd / Vec4[Float]::splat(fwd_len)
    else
      Vec4[Float] { x: 0.0, y: 0.0, z: -1.0, w: 0.0 }
    end

    # s = normalize(cross(f, up))
    let sx = f.y * up.z - f.z * up.y
    let sy = f.z * up.x - f.x * up.z
    let sz = f.x * up.y - f.y * up.x
    let s_len = (sx * sx + sy * sy + sz * sz).sqrt()
    let s = if s_len > 1.0e-12 then
      Vec4[Float] { x: sx / s_len, y: sy / s_len, z: sz / s_len, w: 0.0 }
    else
      Vec4[Float] { x: 1.0, y: 0.0, z: 0.0, w: 0.0 }
    end

    # u = cross(s, f)
    let u = Vec4[Float] {
      x: s.y * f.z - s.z * f.y,
      y: s.z * f.x - s.x * f.z,
      z: s.x * f.y - s.y * f.x,
      w: 0.0
    }

    Mat4 {
      rows: [
        Vec4[Float] { x: s.x,  y: s.y,  z: s.z,  w: -(s.x * eye.x + s.y * eye.y + s.z * eye.z) },
        Vec4[Float] { x: u.x,  y: u.y,  z: u.z,  w: -(u.x * eye.x + u.y * eye.y + u.z * eye.z) },
        Vec4[Float] { x: -f.x, y: -f.y, z: -f.z, w: f.x * eye.x + f.y * eye.y + f.z * eye.z },
        Vec4[Float] { x: 0.0,  y: 0.0,  z: 0.0,  w: 1.0 }
      ]
    }
  end

  # Perspective projection matrix (right-handed, clip space z: [-1, 1])
  def perspective(fov: Float, aspect: Float, near: Float, far: Float) -> Mat4
    let half_tan = (fov / 2.0).tan()
    let range = far - near
    Mat4 {
      rows: [
        Vec4[Float] { x: 1.0 / (aspect * half_tan), y: 0.0, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 1.0 / half_tan, z: 0.0, w: 0.0 },
        Vec4[Float] { x: 0.0, y: 0.0, z: -(far + near) / range, w: -2.0 * far * near / range },
        Vec4[Float] { x: 0.0, y: 0.0, z: -1.0, w: 0.0 }
      ]
    }
  end
end

# ———————————————————————————————————————————————————————————————
# Portable Fallback Implementations
# ———————————————————————————————————————————————————————————————
# Standalone portable helpers (kept for backward compatibility)

def portable_add_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
  a.add(b)
end

def portable_mul_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Vec4[Float]
  a.mul(b)
end

def portable_hsum_f32x4(v: Vec4[Float]) -> Float
  v.hsum()
end

def portable_dot_f32x4(a: Vec4[Float], b: Vec4[Float]) -> Float
  a.dot(b)
end

# ———————————————————————————————————————————————————————————————
# Batch Operations
# ———————————————————————————————————————————————————————————————

# Vectorized array addition
def vec_add_arrays(a: &[Float], b: &[Float], out: &mut [Float], len: Int) -> Unit
  let caps = detect_simd()
  
  if caps.has_sse2 && len >= 4 then
    # Process 4 elements at a time
    mut i = 0
    while i + 4 <= len do
      let va = Vec4[Float]::load_unaligned(&a[i])
      let vb = Vec4[Float]::load_unaligned(&b[i])
      let result = va + vb
      result.store_unaligned(&mut out[i])
      i = i + 4
    end
    # Handle remaining elements
    while i < len do
      out[i] = a[i] + b[i]
      i = i + 1
    end
  else
    # Scalar fallback
    mut i = 0
    while i < len do
      out[i] = a[i] + b[i]
      i = i + 1
    end
  end
end

# Vectorized array multiplication
def vec_mul_arrays(a: &[Float], b: &[Float], out: &mut [Float], len: Int) -> Unit
  let caps = detect_simd()
  
  if caps.has_sse2 && len >= 4 then
    mut i = 0
    while i + 4 <= len do
      let va = Vec4[Float]::load_unaligned(&a[i])
      let vb = Vec4[Float]::load_unaligned(&b[i])
      let result = va * vb
      result.store_unaligned(&mut out[i])
      i = i + 4
    end
    while i < len do
      out[i] = a[i] * b[i]
      i = i + 1
    end
  else
    mut i = 0
    while i < len do
      out[i] = a[i] * b[i]
      i = i + 1
    end
  end
end

# Vectorized dot product of two arrays
def vec_dot_product(a: &[Float], b: &[Float], len: Int) -> Float
  let caps = detect_simd()
  
  if caps.has_sse2 && len >= 4 then
    mut sum = Vec4[Float]::splat(0.0)
    mut i = 0
    while i + 4 <= len do
      let va = Vec4[Float]::load_unaligned(&a[i])
      let vb = Vec4[Float]::load_unaligned(&b[i])
      sum = sum + va * vb
      i = i + 4
    end
    mut result = sum.hsum()
    while i < len do
      result = result + a[i] * b[i]
      i = i + 1
    end
    result
  else
    mut result = 0.0
    mut i = 0
    while i < len do
      result = result + a[i] * b[i]
      i = i + 1
    end
    result
  end
end

# Vectorized FMA: out = a * b + c
def vec_fma_arrays(a: &[Float], b: &[Float], c: &[Float], out: &mut [Float], len: Int) -> Unit
  let caps = detect_simd()
  
  if caps.has_fma && len >= 4 then
    mut i = 0
    while i + 4 <= len do
      let va = Vec4[Float]::load_unaligned(&a[i])
      let vb = Vec4[Float]::load_unaligned(&b[i])
      let vc = Vec4[Float]::load_unaligned(&c[i])
      let result = va.fma(vb, vc)
      result.store_unaligned(&mut out[i])
      i = i + 4
    end
    while i < len do
      out[i] = a[i] * b[i] + c[i]
      i = i + 1
    end
  else
    mut i = 0
    while i < len do
      out[i] = a[i] * b[i] + c[i]
      i = i + 1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Memory Operations
# ———————————————————————————————————————————————————————————————

# Prefetch hint for cache optimization (no-op in portable mode)
def prefetch(ptr: &Unit, locality: Int) -> Unit
  # Prefetch hints are architecture-specific; portable fallback is a no-op.
  # When SIMD codegen is available, this can be lowered to prefetchnta/prefetcht0/etc.
end

# Streaming store (bypass cache) — portable: same as regular store
def stream_store_f32x4(v: Vec4[Float], ptr: &mut Float) -> Unit
  v.store_unaligned(ptr)
end

# Memory fence — portable: compiler barrier only
def memory_fence() -> Unit
  @compiler_fence("seq_cst")
end

# ———————————————————————————————————————————————————————————————
# Trigonometry (approximate, vectorized)
# ———————————————————————————————————————————————————————————————

# Fast approximate sin for Vec4 (Taylor degree-7, max error ~5e-5)
def sin_approx(v: Vec4[Float]) -> Vec4[Float]
  # Reduce to [-pi, pi] range using x - round(x / (2*pi)) * 2*pi
  let two_pi = 6.28318530718
  let inv_two_pi = 0.15915494309
  let half_pi = 1.57079632679

  def _sin_lane(x: Float) -> Float
    # Range reduction: fold into [-pi, pi]
    let k = (x * inv_two_pi + 0.5).floor()
    let reduced = x - k * two_pi
    # Bhaskara I approximation: 16x(pi-x) / (5pi^2 - 4x(pi-x))
    # For better accuracy, use degree-5 minimax polynomial on [-pi/2, pi/2]
    let pi_val = 3.14159265359
    mut a = reduced
    if a > half_pi then
      a = pi_val - a
    elsif a < -half_pi then
      a = -pi_val - a
    end
    # sin(a) ≈ a - a³/6 + a⁵/120 - a⁷/5040 (Taylor degree-7)
    let a2 = a * a
    let a3 = a2 * a
    let a5 = a3 * a2
    let a7 = a5 * a2
    a - a3 / 6.0 + a5 / 120.0 - a7 / 5040.0
  end

  Vec4[Float] {
    x: _sin_lane(v.x),
    y: _sin_lane(v.y),
    z: _sin_lane(v.z),
    w: _sin_lane(v.w)
  }
end

# Fast approximate cos for Vec4
def cos_approx(v: Vec4[Float]) -> Vec4[Float]
  let half_pi = Vec4[Float]::splat(1.57079632679)
  sin_approx(v + half_pi)
end