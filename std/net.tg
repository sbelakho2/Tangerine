# Tangerine Standard Library — Networking (TCP/UDP)
#
# Cross-platform networking using Berkeley sockets API.
# Supports:
#   - TCP streams (client and server)
#   - UDP datagrams
#   - IP address resolution
#   - Socket options

use std::core::{Option, Result, panic}
use std::collections::{Vec, SliceMut}
use std::io::{Read, Write, IOError}
use std::time::{TimeVal}
use std::alloc::{size_of}

# ———————————————————————————————————————————————————————————————
# Socket Types and Constants
# ———————————————————————————————————————————————————————————————

# Socket types (portable across Linux/macOS)
def SOCK_STREAM() -> Int = 1   # TCP
def SOCK_DGRAM()  -> Int = 2   # UDP

# Address families
def AF_INET()  -> Int = 2   # IPv4 (portable)

@cfg(target_os = "linux")
def AF_INET6() -> Int = 10
@cfg(target_os = "macos")
def AF_INET6() -> Int = 30

# Protocol (portable)
def IPPROTO_TCP() -> Int = 6
def IPPROTO_UDP() -> Int = 17

# Shutdown modes (portable)
def SHUT_RD()   -> Int = 0
def SHUT_WR()   -> Int = 1
def SHUT_RDWR() -> Int = 2

# Socket options
@cfg(target_os = "linux")
def SOL_SOCKET()    -> Int = 1
@cfg(target_os = "macos")
def SOL_SOCKET()    -> Int = 0xFFFF

@cfg(target_os = "linux")
def SO_REUSEADDR()  -> Int = 2
@cfg(target_os = "macos")
def SO_REUSEADDR()  -> Int = 4

@cfg(target_os = "linux")
def SO_KEEPALIVE()  -> Int = 9
@cfg(target_os = "macos")
def SO_KEEPALIVE()  -> Int = 8

@cfg(target_os = "linux")
def SO_RCVTIMEO()   -> Int = 20
@cfg(target_os = "macos")
def SO_RCVTIMEO()   -> Int = 0x1006

@cfg(target_os = "linux")
def SO_SNDTIMEO()   -> Int = 21
@cfg(target_os = "macos")
def SO_SNDTIMEO()   -> Int = 0x1005

def IPPROTO_TCP_OPT() -> Int = 6
def TCP_NODELAY()   -> Int = 1    # portable

# Error codes
@cfg(target_os = "linux")
def EAGAIN()      -> Int = 11
@cfg(target_os = "macos")
def EAGAIN()      -> Int = 35

@cfg(target_os = "linux")
def EWOULDBLOCK() -> Int = 11
@cfg(target_os = "macos")
def EWOULDBLOCK() -> Int = 35

@cfg(target_os = "linux")
def EINPROGRESS() -> Int = 115
@cfg(target_os = "macos")
def EINPROGRESS() -> Int = 36

@cfg(target_os = "linux")
def ECONNREFUSED() -> Int = 111
@cfg(target_os = "macos")
def ECONNREFUSED() -> Int = 61

# ———————————————————————————————————————————————————————————————
# C Socket API (extern) — exact ABI widths
# ———————————————————————————————————————————————————————————————
# The C-`int`-returning functions (socket/connect/bind/listen/close/
# shutdown/accept/setsockopt/getsockopt/getaddrinfo/inet_pton) declare
# the i32 return: C delivers `int` in the low 32 bits of the return
# register and the wrapper functions below widen with the explicit
# `as Int` sign-extension at the boundary, so the callers' `< 0` checks
# are sound. The ssize_t returns (send/recv/sendto/recvfrom — 64-bit on
# the LP64 targets) stay Int; the socklen_t lengths are u32.
extern "C"
  # Socket creation and closing
  def c_socket(domain: Int, type_: Int, protocol: Int) -> i32
  def c_close(fd: Int) -> i32
  def c_shutdown(fd: Int, how: Int) -> i32
  
  # Connection
  def c_connect(fd: Int, addr: Ptr[u8], addrlen: u32) -> i32
  def c_bind(fd: Int, addr: Ptr[u8], addrlen: u32) -> i32
  def c_listen(fd: Int, backlog: Int) -> i32
  def c_accept(fd: Int, addr: PtrMut[u8], addrlen: PtrMut[u32]) -> i32
  
  # Data transfer — ssize_t returns (64-bit signed on the LP64 targets)
  def send(fd: Int, buf: Ptr[u8], len: UInt, flags: Int) -> Int
  def recv(fd: Int, buf: PtrMut[u8], len: UInt, flags: Int) -> Int
  def sendto(fd: Int, buf: Ptr[u8], len: UInt, flags: Int, addr: Ptr[u8], addrlen: u32) -> Int
  def recvfrom(fd: Int, buf: PtrMut[u8], len: UInt, flags: Int, addr: PtrMut[u8], addrlen: PtrMut[u32]) -> Int
  
  # Socket options
  def c_setsockopt(fd: Int, level: Int, optname: Int, optval: Ptr[u8], optlen: u32) -> i32
  def c_getsockopt(fd: Int, level: Int, optname: Int, optval: PtrMut[u8], optlen: PtrMut[u32]) -> i32
  
  # Address info
  def gethostbyname(name: Ptr[u8]) -> Ptr[HostEnt]
  def c_getaddrinfo(node: Ptr[u8], service: Ptr[u8], hints: Ptr[AddrInfo], res: PtrMut[Ptr[AddrInfo]]) -> i32
  def freeaddrinfo(res: Ptr[AddrInfo]) -> Unit
  def gai_strerror(errcode: Int) -> Ptr[u8]
  
  # Byte order
  def htons(hostshort: u16) -> u16
  def htonl(hostlong: u32) -> u32
  def ntohs(netshort: u16) -> u16
  def ntohl(netlong: u32) -> u32
  
  # Address conversion
  def c_inet_pton(af: Int, src: Ptr[u8], dst: Ptr[u8]) -> i32
  def c_inet_ntop(af: Int, src: Ptr[u8], dst: Ptr[u8], size: u32) -> Ptr[u8]
end

# ———————————————————————————————————————————————————————————————
# Exact-ABI wrappers — the i32 C returns widened to Int
# ———————————————————————————————————————————————————————————————
# Each wrapper calls the c_-prefixed extern and converts the i32 result
# with the explicit `as Int` — the sign-extension at the ABI boundary.
# The public signatures match the former Int-typed API, so all callers
# keep their Int-typed values and their `< 0` checks stay sound.

def socket(domain: Int, type_: Int, protocol: Int) -> Int
  c_socket(domain as i32, type_ as i32, protocol as i32) as Int
end

def close(fd: Int) -> Int
  c_close(fd as i32) as Int
end

def shutdown(fd: Int, how: Int) -> Int
  c_shutdown(fd as i32, how as i32) as Int
end

def connect(fd: Int, addr: Ptr[u8], addrlen: u32) -> Int
  c_connect(fd as i32, addr, addrlen) as Int
end

def bind(fd: Int, addr: Ptr[u8], addrlen: u32) -> Int
  c_bind(fd as i32, addr, addrlen) as Int
end

def listen(fd: Int, backlog: Int) -> Int
  c_listen(fd as i32, backlog as i32) as Int
end

def accept(fd: Int, addr: PtrMut[u8], addrlen: PtrMut[u32]) -> Int
  c_accept(fd as i32, addr, addrlen) as Int
end

def setsockopt(fd: Int, level: Int, optname: Int, optval: Ptr[u8], optlen: u32) -> Int
  c_setsockopt(fd as i32, level as i32, optname as i32, optval, optlen) as Int
end

def getsockopt(fd: Int, level: Int, optname: Int, optval: PtrMut[u8], optlen: PtrMut[u32]) -> Int
  c_getsockopt(fd as i32, level as i32, optname as i32, optval, optlen) as Int
end

def getaddrinfo(node: Ptr[u8], service: Ptr[u8], hints: Ptr[AddrInfo], res: PtrMut[Ptr[AddrInfo]]) -> Int
  c_getaddrinfo(node, service, hints, res) as Int
end

def inet_pton(af: Int, src: Ptr[u8], dst: Ptr[u8]) -> Int
  c_inet_pton(af as i32, src, dst) as Int
end

def inet_ntop(af: Int, src: Ptr[u8], dst: Ptr[u8], size: u32) -> Ptr[u8]
  c_inet_ntop(af as i32, src, dst, size)
end

# ———————————————————————————————————————————————————————————————
# Low-level Structures (matching C layout)
# ———————————————————————————————————————————————————————————————

# sockaddr_in (IPv4)
@cfg(target_os = "macos")
struct SockAddrIn
  sin_len: u8
  sin_family: u8
  sin_port: u16
  sin_addr: u32
  sin_zero: [u8; 8]
end

@cfg(target_os = "linux")
struct SockAddrIn
  sin_family: u16
  sin_port: u16
  sin_addr: u32
  sin_zero: [u8; 8]
end

@cfg(target_os = "macos")
def sockaddr_in_new(family: u16, port: u16, addr: u32) -> SockAddrIn
  SockAddrIn {
    sin_len: 16,
    sin_family: family as u8,
    sin_port: port,
    sin_addr: addr,
    sin_zero: [0, 0, 0, 0, 0, 0, 0, 0]
  }
end

@cfg(target_os = "linux")
def sockaddr_in_new(family: u16, port: u16, addr: u32) -> SockAddrIn
  SockAddrIn {
    sin_family: family,
    sin_port: port,
    sin_addr: addr,
    sin_zero: [0, 0, 0, 0, 0, 0, 0, 0]
  }
end

def sockaddr_in_len() -> Int
  16
end

# sockaddr_in6 (IPv6)
# Darwin: sin6_len (u8) + sin6_family (u8) precede sin6_port; Linux: a
# single u16 sin6_family. The per-platform constructors below initialize
# EVERY field the variant declares (the shared call sites never hand-build
# the struct, so the Darwin len byte and the u8 family are always set).
@cfg(target_os = "macos")
struct SockAddrIn6
  sin6_len: u8
  sin6_family: u8
  sin6_port: u16
  sin6_flowinfo: u32
  sin6_addr: [u8; 16]
  sin6_scope_id: u32
end

@cfg(target_os = "linux")
struct SockAddrIn6
  sin6_family: u16
  sin6_port: u16
  sin6_flowinfo: u32
  sin6_addr: [u8; 16]
  sin6_scope_id: u32
end

@cfg(target_os = "macos")
def sockaddr_in6_new(family: u16, port: u16, addr: [u8; 16], scope_id: u32) -> SockAddrIn6
  SockAddrIn6 {
    sin6_len: 28,
    sin6_family: family as u8,
    sin6_port: port,
    sin6_flowinfo: 0,
    sin6_addr: addr,
    sin6_scope_id: scope_id
  }
end

@cfg(target_os = "linux")
def sockaddr_in6_new(family: u16, port: u16, addr: [u8; 16], scope_id: u32) -> SockAddrIn6
  SockAddrIn6 {
    sin6_family: family,
    sin6_port: port,
    sin6_flowinfo: 0,
    sin6_addr: addr,
    sin6_scope_id: scope_id
  }
end

struct HostEnt
  h_name: Ptr[u8]
  h_aliases: Ptr[Ptr[u8]]
  h_addrtype: i32
  h_length: i32
  h_addr_list: Ptr[Ptr[u8]]
end

# The scalar fields are the C widths: ai_flags/ai_family/ai_socktype/
# ai_protocol are C `int` (i32) and ai_addrlen is socklen_t (u32) on both
# Linux and macOS — the old 64-bit Int fields shifted every following
# pointer (C writes 4-byte fields; the kernel fills the layout below).
# Offsets (LP64): scalars at 0/4/8/12/16, pointers at 24/32/40.
@cfg(target_os = "linux")
struct AddrInfo
  ai_flags: i32
  ai_family: i32
  ai_socktype: i32
  ai_protocol: i32
  ai_addrlen: u32
  ai_addr: Ptr[u8]
  ai_canonname: Ptr[u8]
  ai_next: Ptr[AddrInfo]
end

# macOS: the C header (netdb.h) orders ai_canonname BEFORE ai_addr —
# the glibc order would swap the two pointer fields at offsets 24/32.
@cfg(target_os = "macos")
struct AddrInfo
  ai_flags: i32
  ai_family: i32
  ai_socktype: i32
  ai_protocol: i32
  ai_addrlen: u32
  ai_canonname: Ptr[u8]
  ai_addr: Ptr[u8]
  ai_next: Ptr[AddrInfo]
end

# The zeroed getaddrinfo hints — one constructor per platform, matching
# the variant's field ORDER and the i32/u32 scalar widths.
@cfg(target_os = "linux")
def addr_info_hints_zero() -> AddrInfo
  AddrInfo {
    ai_flags: 0,
    ai_family: AF_INET() as i32,
    ai_socktype: SOCK_STREAM() as i32,
    ai_protocol: 0,
    ai_addrlen: 0,
    ai_addr: Ptr::null(),
    ai_canonname: Ptr::null(),
    ai_next: Ptr::null()
  }
end

@cfg(target_os = "macos")
def addr_info_hints_zero() -> AddrInfo
  AddrInfo {
    ai_flags: 0,
    ai_family: AF_INET() as i32,
    ai_socktype: SOCK_STREAM() as i32,
    ai_protocol: 0,
    ai_addrlen: 0,
    ai_canonname: Ptr::null(),
    ai_addr: Ptr::null(),
    ai_next: Ptr::null()
  }
end

# ———————————————————————————————————————————————————————————————
# IP Address Types
# ———————————————————————————————————————————————————————————————

enum IpAddr
  V4(Ipv4Addr)
  V6(Ipv6Addr)
end

struct Ipv4Addr
  octets: [u8; 4]
end

struct Ipv6Addr
  segments: [u16; 8]
end

def ipv4_new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr
  Ipv4Addr { octets: [a, b, c, d] }
end

def ipv4_localhost() -> Ipv4Addr
  ipv4_new(127, 0, 0, 1)
end

def ipv4_any() -> Ipv4Addr
  ipv4_new(0, 0, 0, 0)
end

def ipv6_localhost() -> Ipv6Addr
  Ipv6Addr { segments: [0, 0, 0, 0, 0, 0, 0, 1] }
end

def ipv6_any() -> Ipv6Addr
  Ipv6Addr { segments: [0, 0, 0, 0, 0, 0, 0, 0] }
end

impl Ipv4Addr
  def to_u32(self: Ipv4Addr) -> u32
    ((self.octets[0] as u32) << 24) |
    ((self.octets[1] as u32) << 16) |
    ((self.octets[2] as u32) << 8) |
    (self.octets[3] as u32)
  end
  
  def from_u32(val: u32) -> Ipv4Addr
    Ipv4Addr {
      octets: [
        ((val >> 24) & 0xFF) as u8,
        ((val >> 16) & 0xFF) as u8,
        ((val >> 8) & 0xFF) as u8,
        (val & 0xFF) as u8
      ]
    }
  end
  
  def to_string(self: Ipv4Addr) -> String
    self.octets[0].to_string() + "." +
    self.octets[1].to_string() + "." +
    self.octets[2].to_string() + "." +
    self.octets[3].to_string()
  end
end

# ———————————————————————————————————————————————————————————————
# Socket Address
# ———————————————————————————————————————————————————————————————

struct SocketAddr
  ip: IpAddr
  port: u16
end

def socket_addr_v4(addr: Ipv4Addr, port: u16) -> SocketAddr
  SocketAddr {
    ip: IpAddr::V4(addr),
    port: port
  }
end

def socket_addr_v6(addr: Ipv6Addr, port: u16) -> SocketAddr
  SocketAddr {
    ip: IpAddr::V6(addr),
    port: port
  }
end

impl SocketAddr
  def to_string(self: SocketAddr) -> String
    match self.ip
    when IpAddr::V4(addr) then
      addr.to_string() + ":" + self.port.to_string()
    when IpAddr::V6(addr) then
      "[...]:" + self.port.to_string()  # Simplified
    end
  end
end

# ———————————————————————————————————————————————————————————————
# TCP Stream (Client)
# ———————————————————————————————————————————————————————————————

struct TcpStream
  fd: Int
  peer_addr: SocketAddr
end

def tcp_connect(addr: SocketAddr) -> Result[TcpStream, IOError]
  let family = match addr.ip
  when IpAddr::V4(_) then AF_INET()
  when IpAddr::V6(_) then AF_INET6()
  end
  
  let fd = socket(family, SOCK_STREAM(), IPPROTO_TCP())
  if fd < 0 then
    return Result::Err(IOError::Other("Failed to create socket".to_string()))
  end
  
  # Build sockaddr
  match addr.ip
  when IpAddr::V4(ipv4) then
    mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
    
    let result = connect(fd, (address_of(&mut sockaddr)) as Ptr[u8], sockaddr_in_len() as u32)
    if result < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to connect".to_string()))
    end
  when IpAddr::V6(ipv6) then
    # IPv6 support
    mut addr_bytes: [u8; 16] = [0; 16]
    mut i = 0
    while i < 8 do
      let seg = ipv6.segments[i]
      addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
      addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
      i = i + 1
    end
    
    mut sockaddr6 = sockaddr_in6_new(AF_INET6() as u16, htons(addr.port), addr_bytes, 0)
    
    let result = connect(fd, (address_of(&mut sockaddr6)) as Ptr[u8], 28 as u32)
    if result < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to connect".to_string()))
    end
  end
  
  Result::Ok(TcpStream { fd: fd, peer_addr: addr })
end

impl TcpStream
  def peer_addr(self: TcpStream) -> SocketAddr
    self.peer_addr.clone()
  end

  def raw_fd(self: TcpStream) -> Int
    self.fd
  end
  
  def shutdown(self: TcpStream, how: Int) -> Result[Unit, IOError]
    if std::net::shutdown(self.fd, how) < 0 then
      Result::Err(IOError::Other("Shutdown failed".to_string()))
    else
      Result::Ok(())
    end
  end
  
  def set_nodelay(self: TcpStream, nodelay: Bool) -> Result[Unit, IOError]
    let val: Int = if nodelay then 1 else 0 end
    if setsockopt(self.fd, IPPROTO_TCP_OPT(), TCP_NODELAY(), &val as Ptr[u8], 4 as u32) < 0 then
      Result::Err(IOError::Other("Failed to set TCP_NODELAY".to_string()))
    else
      Result::Ok(())
    end
  end
  
  def set_read_timeout(self: TcpStream, secs: Int, usecs: Int) -> Result[Unit, IOError]
    mut tv = TimeVal { tv_sec: secs as i64, tv_usec: usecs as i64 }
    let tv_size = size_of[TimeVal]() as UInt
    if setsockopt(self.fd, SOL_SOCKET(), SO_RCVTIMEO(), &tv as Ptr[u8], tv_size as u32) < 0 then
      Result::Err(IOError::Other("Failed to set read timeout".to_string()))
    else
      Result::Ok(())
    end
  end
end

impl Read for TcpStream
  def read(inout self: TcpStream, buf: SliceMut[u8]) -> Result[Int, IOError]
    # buf.len is the writable extent — the recv count is the view's len,
    # correct by construction (a buffered read can never request zero
    # bytes after a clear).
    let n = recv(self.fd, buf.ptr, buf.len, 0)
    if n < 0 then
      Result::Err(IOError::Other("Read failed".to_string()))
    else
      Result::Ok(n)
    end
  end
end

impl Write for TcpStream
  def write(inout self: TcpStream, buf: Vec[u8]) -> Result[Int, IOError]
    let n = send(self.fd, buf.as_ptr(), buf.len() as UInt, 0)
    if n < 0 then
      Result::Err(IOError::Other("Write failed".to_string()))
    else
      Result::Ok(n)
    end
  end

  def flush(inout self: TcpStream) -> Result[Unit, IOError]
    Result::Ok(())
  end
end

impl Drop for TcpStream
  def drop(inout self: TcpStream) -> Unit
    if self.fd >= 0 then
      close(self.fd)
      self.fd = -1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# TCP Listener (Server)
# ———————————————————————————————————————————————————————————————

struct TcpListener
  fd: Int
  local_addr: SocketAddr
end

def tcp_bind(addr: SocketAddr) -> Result[TcpListener, IOError]
  let family = match addr.ip
  when IpAddr::V4(_) then AF_INET()
  when IpAddr::V6(_) then AF_INET6()
  end
  
  let fd = socket(family, SOCK_STREAM(), IPPROTO_TCP())
  if fd < 0 then
    return Result::Err(IOError::Other("Failed to create socket".to_string()))
  end
  
  # Set SO_REUSEADDR
  let val: Int = 1
  setsockopt(fd, SOL_SOCKET(), SO_REUSEADDR(), &val as Ptr[u8], 4 as u32)
  
  # Bind
  match addr.ip
  when IpAddr::V4(ipv4) then
    mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
    
    if bind(fd, &sockaddr as Ptr[u8], sockaddr_in_len() as u32) < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to bind".to_string()))
    end
  when IpAddr::V6(ipv6) then
    # IPv6 support
    mut addr_bytes: [u8; 16] = [0; 16]
    mut i = 0
    while i < 8 do
      let seg = ipv6.segments[i]
      addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
      addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
      i = i + 1
    end
    
    mut sockaddr6 = sockaddr_in6_new(AF_INET6() as u16, htons(addr.port), addr_bytes, 0)
    
    if bind(fd, &sockaddr6 as Ptr[u8], 28 as u32) < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to bind".to_string()))
    end
  end
  
  # Listen
  if listen(fd, 128) < 0 then
    close(fd)
    return Result::Err(IOError::Other("Failed to listen".to_string()))
  end
  
  Result::Ok(TcpListener { fd: fd, local_addr: addr })
end

impl TcpListener
  def local_addr(self: TcpListener) -> SocketAddr
    self.local_addr.clone()
  end
  
  def accept(self: TcpListener) -> Result[TcpStream, IOError]
    mut client_addr = sockaddr_in_new(0, 0, 0)
    mut addrlen: u32 = sockaddr_in_len() as u32
    
    let client_fd = std::net::accept(self.fd, &client_addr as PtrMut[u8], &addrlen as PtrMut[u32])
    if client_fd < 0 then
      return Result::Err(IOError::Other("Accept failed".to_string()))
    end
    
    let peer_ip = Ipv4Addr::from_u32(ntohl(client_addr.sin_addr))
    let peer_port = ntohs(client_addr.sin_port)
    let peer_addr = socket_addr_v4(peer_ip, peer_port)
    
    Result::Ok(TcpStream { fd: client_fd, peer_addr: peer_addr })
  end
  
  def incoming(self: TcpListener) -> IncomingConnections
    IncomingConnections { listener: self as Ptr[TcpListener] }
  end
end

impl Drop for TcpListener
  def drop(inout self: TcpListener) -> Unit
    if self.fd >= 0 then
      close(self.fd)
      self.fd = -1
    end
  end
end

struct IncomingConnections
  listener: Ptr[TcpListener]
end

impl Iterator for IncomingConnections
  type Item = Result[TcpStream, IOError]
  
  def next(inout self: IncomingConnections) -> Option[Result[TcpStream, IOError]]
    Option::Some(self.listener.as_ref().accept())
  end
end

# ———————————————————————————————————————————————————————————————
# UDP Socket
# ———————————————————————————————————————————————————————————————

struct UdpSocket
  fd: Int
  local_addr: SocketAddr
end

def udp_bind(addr: SocketAddr) -> Result[UdpSocket, IOError]
  let family = match addr.ip
  when IpAddr::V4(_) then AF_INET()
  when IpAddr::V6(_) then AF_INET6()
  end
  
  let fd = socket(family, SOCK_DGRAM(), IPPROTO_UDP())
  if fd < 0 then
    return Result::Err(IOError::Other("Failed to create socket".to_string()))
  end
  
  # Bind
  match addr.ip
  when IpAddr::V4(ipv4) then
    mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
    
    if bind(fd, &sockaddr as Ptr[u8], sockaddr_in_len() as u32) < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to bind".to_string()))
    end
  when IpAddr::V6(ipv6) then
    # IPv6 support
    mut addr_bytes: [u8; 16] = [0; 16]
    mut i = 0
    while i < 8 do
      let seg = ipv6.segments[i]
      addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
      addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
      i = i + 1
    end
    
    mut sockaddr6 = sockaddr_in6_new(AF_INET6() as u16, htons(addr.port), addr_bytes, 0)
    
    if bind(fd, &sockaddr6 as Ptr[u8], 28 as u32) < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to bind".to_string()))
    end
  end
  
  Result::Ok(UdpSocket { fd: fd, local_addr: addr })
end

impl UdpSocket
  def local_addr(self: UdpSocket) -> SocketAddr
    self.local_addr.clone()
  end
  
  def send_to(self: UdpSocket, buf: [u8], addr: SocketAddr) -> Result[Int, IOError]
    match addr.ip
    when IpAddr::V4(ipv4) then
      mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
      
      let n = sendto(self.fd, buf.as_ptr(), buf.len() as UInt, 0, &sockaddr as Ptr[u8], sockaddr_in_len() as u32)
      if n < 0 then
        Result::Err(IOError::Other("Send failed".to_string()))
      else
        Result::Ok(n)
      end
    when IpAddr::V6(ipv6) then
      # IPv6 support
      mut addr_bytes: [u8; 16] = [0; 16]
      mut i = 0
      while i < 8 do
        let seg = ipv6.segments[i]
        addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
        addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
        i = i + 1
      end
      
      mut sockaddr6 = sockaddr_in6_new(AF_INET6() as u16, htons(addr.port), addr_bytes, 0)
      
      let n = sendto(self.fd, buf.as_ptr(), buf.len() as UInt, 0, &sockaddr6 as Ptr[u8], 28 as u32)
      if n < 0 then
        Result::Err(IOError::Other("Send failed".to_string()))
      else
        Result::Ok(n)
      end
    end
  end
  
  def recv_from(self: UdpSocket, inout buf: [u8]) -> Result[(Int, SocketAddr), IOError]
    mut addr_storage: [u8; 32] = [0; 32]
    mut addrlen: u32 = 32
    
    let n = recvfrom(self.fd, buf.as_mut_ptr(), buf.len() as UInt, 0, &addr_storage as PtrMut[u8], &addrlen as PtrMut[u32])
    if n < 0 then
      return Result::Err(IOError::Other("Receive failed".to_string()))
    end

    if addrlen >= 28 then
      let sockaddr6 = address_of(&mut addr_storage) as Ptr[SockAddrIn6]
      mut segments: [u16; 8] = [0; 8]
      mut i = 0
      while i < 8 do
        let hi = sockaddr6.sin6_addr[i * 2] as u16
        let lo = sockaddr6.sin6_addr[i * 2 + 1] as u16
        segments[i] = (hi << 8) | lo
        i = i + 1
      end

      let peer_ip = Ipv6Addr { segments: segments }
      let peer_port = ((addr_storage[2] as u16) << 8) | (addr_storage[3] as u16)
      Result::Ok((n, socket_addr_v6(peer_ip, peer_port)))
    else
      let peer_ip_raw = ((addr_storage[4] as u32) << 24) |
                        ((addr_storage[5] as u32) << 16) |
                        ((addr_storage[6] as u32) << 8) |
                        (addr_storage[7] as u32)
      let peer_ip = Ipv4Addr::from_u32(peer_ip_raw)
      let peer_port = ((addr_storage[2] as u16) << 8) | (addr_storage[3] as u16)
      Result::Ok((n, socket_addr_v4(peer_ip, peer_port)))
    end
  end
  
  def connect(self: UdpSocket, addr: SocketAddr) -> Result[Unit, IOError]
    match addr.ip
    when IpAddr::V4(ipv4) then
      mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
      
      if std::net::connect(self.fd, &sockaddr as Ptr[u8], sockaddr_in_len() as u32) < 0 then
        Result::Err(IOError::Other("Connect failed".to_string()))
      else
        Result::Ok(())
      end
    when IpAddr::V6(ipv6) then
      # IPv6 support
      mut addr_bytes: [u8; 16] = [0; 16]
      mut i = 0
      while i < 8 do
        let seg = ipv6.segments[i]
        addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
        addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
        i = i + 1
      end
      
      mut sockaddr6 = sockaddr_in6_new(AF_INET6() as u16, htons(addr.port), addr_bytes, 0)
      
      if std::net::connect(self.fd, &sockaddr6 as Ptr[u8], 28 as u32) < 0 then
        Result::Err(IOError::Other("Connect failed".to_string()))
      else
        Result::Ok(())
      end
    end
  end
  
  def send(self: UdpSocket, buf: [u8]) -> Result[Int, IOError]
    let n = std::net::send(self.fd, buf.as_ptr(), buf.len() as UInt, 0)
    if n < 0 then
      Result::Err(IOError::Other("Send failed".to_string()))
    else
      Result::Ok(n)
    end
  end
  
  def recv(self: UdpSocket, inout buf: [u8]) -> Result[Int, IOError]
    let n = std::net::recv(self.fd, buf.as_mut_ptr(), buf.len() as UInt, 0)
    if n < 0 then
      Result::Err(IOError::Other("Receive failed".to_string()))
    else
      Result::Ok(n)
    end
  end
  
  def set_broadcast(self: UdpSocket, broadcast: Bool) -> Result[Unit, IOError]
    let val: Int = if broadcast then 1 else 0 end
    if setsockopt(self.fd, SOL_SOCKET(), 6, &val as Ptr[u8], 4 as u32) < 0 then
      Result::Err(IOError::Other("Failed to set broadcast".to_string()))
    else
      Result::Ok(())
    end
  end
end

impl Drop for UdpSocket
  def drop(inout self: UdpSocket) -> Unit
    if self.fd >= 0 then
      close(self.fd)
      self.fd = -1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# DNS Resolution
# ———————————————————————————————————————————————————————————————

def gai_error_message(code: Int) -> String
  let ptr = gai_strerror(code)
  if ptr.is_null() then
    "unknown DNS error (code " + code.to_string() + ")"
  else
    unsafe "FFI string conversion" do String::from_cstr(ptr) end
  end
end

def resolve_host(hostname: String) -> Result[Vec[IpAddr], IOError]
  mut results: Vec[IpAddr] = Vec::new()
  
  mut hints = addr_info_hints_zero()
  
  mut res: Ptr[AddrInfo] = Ptr::null() as Ptr[AddrInfo]
  
  let hostname_cstr = hostname.to_cstring()
  let ret = getaddrinfo(hostname_cstr.as_ptr(), Ptr::null() as Ptr[u8], &hints as Ptr[AddrInfo], &res as PtrMut[Ptr[AddrInfo]])
  
  if ret != 0 then
    return Result::Err(IOError::Other("DNS resolution failed for '" + hostname + "': " + gai_error_message(ret)))
  end
  
  if !res.is_null() then
    let current_info = res[0]
    if current_info.ai_family == (AF_INET() as i32) then
      if current_info.ai_addr.is_null() == false then
        let addr_ptr = current_info.ai_addr as Ptr[u8]
        let addr = ((addr_ptr[4] as u32) << 24) |
                   ((addr_ptr[5] as u32) << 16) |
                   ((addr_ptr[6] as u32) << 8) |
                   (addr_ptr[7] as u32)
        results.push(IpAddr::V4(Ipv4Addr::from_u32(addr)))
      end
    end
  end
  
  freeaddrinfo(res)
  
  Result::Ok(results)
end

# ———————————————————————————————————————————————————————————————
# Convenience Functions
# ———————————————————————————————————————————————————————————————

def tcp_connect_host(host: String, port: u16) -> Result[TcpStream, IOError]
  match resolve_host(host)
  when Result::Ok(addrs) then
    if addrs.is_empty() then
      return Result::Err(IOError::Other("No addresses found for host '" + host + "'".to_string()))
    end
    
    # Try each resolved address (IPv4 or IPv6)
    match addrs[0]
    when IpAddr::V4(addr) then
      tcp_connect(socket_addr_v4(addr, port))
    when IpAddr::V6(addr) then
      tcp_connect(socket_addr_v6(addr, port))
    end
  when Result::Err(e) then
    Result::Err(e)
  end
end

# ———————————————————————————————————————————————————————————————
# Unix Domain Sockets
# ———————————————————————————————————————————————————————————————

@cfg(target_os = "linux")
def AF_UNIX() -> Int = 1
@cfg(target_os = "macos")
def AF_UNIX() -> Int = 1

@repr(C)
@cfg(target_os = "linux")
struct SockAddrUn
  sun_family: u16
  sun_path: [u8; 108]
end

@repr(C)
@cfg(target_os = "macos")
struct SockAddrUn
  sun_len: u8
  sun_family: u8
  sun_path: [u8; 104]
end

## Unix stream socket (connection-oriented)
struct UnixStream
  fd: Int
end

@cfg(target_os = "linux")
def _make_unix_addr(path: str) -> (SockAddrUn, Int)
  let mut addr = SockAddrUn { sun_family: AF_UNIX() as u16, sun_path: [0u8; 108] }
  let path_bytes = path.as_bytes()
  let len = if path_bytes.len() < 107 then path_bytes.len() else 107 end
  for i in 0..len do
    addr.sun_path[i] = path_bytes[i]
  end
  (addr, 2 + len + 1)
end

@cfg(target_os = "macos")
def _make_unix_addr(path: str) -> (SockAddrUn, Int)
  let mut addr = SockAddrUn { sun_len: 0, sun_family: AF_UNIX() as u8, sun_path: [0u8; 104] }
  let path_bytes = path.as_bytes()
  let len = if path_bytes.len() < 103 then path_bytes.len() else 103 end
  for i in 0..len do
    addr.sun_path[i] = path_bytes[i]
  end
  addr.sun_len = (2 + len + 1) as u8
  (addr, 2 + len + 1)
end

def unix_connect(path: str) -> Result[UnixStream, IOError]
  let fd = unsafe "FFI boundary" do socket(AF_UNIX(), SOCK_STREAM(), 0) end
  if fd < 0 then
    return Result::Err(IOError::Other("failed to create unix socket".to_string()))
  end

  let (addr, addr_len) = _make_unix_addr(path)
  let ret = unsafe "FFI boundary" do
    connect(fd, &addr as Ptr[SockAddrUn] as Ptr[u8], addr_len as u32)
  end
  if ret < 0 then
    unsafe "FFI boundary" do close(fd) end
    return Result::Err(IOError::Other("unix connect failed for path: ".to_string() + path.to_string()))
  end

  Result::Ok(UnixStream { fd: fd })
end

impl UnixStream
  def read(inout self: UnixStream, buf: SliceMut[u8]) -> Result[Int, IOError]
    let n = unsafe "FFI boundary" do recv(self.fd, buf.ptr, buf.len, 0) end
    if n < 0 then
      Result::Err(IOError::Other("unix read failed".to_string()))
    else
      Result::Ok(n)
    end
  end

  def write(inout self: UnixStream, data: [u8]) -> Result[UInt, IOError]
    let n = unsafe "FFI boundary" do send(self.fd, data.as_ptr(), data.len(), 0) end
    if n < 0 then
      Result::Err(IOError::Other("unix write failed".to_string()))
    else
      Result::Ok(n as UInt)
    end
  end

  def close(inout self: UnixStream) -> Unit
    unsafe "FFI boundary" do let _ = std::net::close(self.fd) end
  end
end

impl Read for UnixStream
  def read(inout self: UnixStream, buf: SliceMut[u8]) -> Result[Int, IOError]
    self.read(buf)
  end
end

impl Write for UnixStream
  def write(inout self: UnixStream, data: [u8]) -> Result[UInt, IOError]
    self.write(data)
  end
end

impl Drop for UnixStream
  def drop(inout self: UnixStream) -> Unit
    self.close()
  end
end

## Unix listener (accepts incoming connections)
struct UnixListener
  fd: Int
  path: String
end

def unix_listen(path: str) -> Result[UnixListener, IOError]
  let fd = unsafe "FFI boundary" do socket(AF_UNIX(), SOCK_STREAM(), 0) end
  if fd < 0 then
    return Result::Err(IOError::Other("failed to create unix listen socket".to_string()))
  end

  let (addr, addr_len) = _make_unix_addr(path)

  let ret = unsafe "FFI boundary" do
    bind(fd, &addr as Ptr[SockAddrUn] as Ptr[u8], addr_len as u32)
  end
  if ret < 0 then
    unsafe "FFI boundary" do close(fd) end
    return Result::Err(IOError::Other("unix bind failed for: ".to_string() + path.to_string()))
  end

  let ret = unsafe "FFI boundary" do listen(fd, 128) end
  if ret < 0 then
    unsafe "FFI boundary" do close(fd) end
    return Result::Err(IOError::Other("unix listen failed".to_string()))
  end

  Result::Ok(UnixListener { fd: fd, path: path.to_string() })
end

impl UnixListener
  def accept(self: UnixListener) -> Result[UnixStream, IOError]
    let client_fd = unsafe "FFI boundary" do
      std::net::accept(self.fd, Ptr::null() as PtrMut[u8], Ptr::null() as PtrMut[u32])
    end
    if client_fd < 0 then
      return Result::Err(IOError::Other("unix accept failed".to_string()))
    end
    Result::Ok(UnixStream { fd: client_fd })
  end

  def close(inout self: UnixListener) -> Unit
    unsafe "FFI boundary" do let _ = std::net::close(self.fd) end
    ## Remove the socket file
    let _ = std::fs::remove_file(self.path.clone())
  end
end

impl Drop for UnixListener
  def drop(inout self: UnixListener) -> Unit
    self.close()
  end
end

## Unix datagram socket (connectionless)
struct UnixDatagram
  fd: Int
  bound_path: Option[String]
end

def unix_datagram_bind(path: str) -> Result[UnixDatagram, IOError]
  let fd = unsafe "FFI boundary" do socket(AF_UNIX(), SOCK_DGRAM(), 0) end
  if fd < 0 then
    return Result::Err(IOError::Other("failed to create unix datagram socket".to_string()))
  end

  let (addr, addr_len) = _make_unix_addr(path)

  let ret = unsafe "FFI boundary" do
    bind(fd, &addr as Ptr[SockAddrUn] as Ptr[u8], addr_len as u32)
  end
  if ret < 0 then
    unsafe "FFI boundary" do close(fd) end
    return Result::Err(IOError::Other("unix datagram bind failed".to_string()))
  end

  Result::Ok(UnixDatagram { fd: fd, bound_path: Option::Some(path.to_string()) })
end

def unix_datagram_unbound() -> Result[UnixDatagram, IOError]
  let fd = unsafe "FFI boundary" do socket(AF_UNIX(), SOCK_DGRAM(), 0) end
  if fd < 0 then
    return Result::Err(IOError::Other("failed to create unix datagram socket".to_string()))
  end
  Result::Ok(UnixDatagram { fd: fd, bound_path: Option::None })
end

impl UnixDatagram
  def send_to(self: UnixDatagram, data: [u8], target_path: str) -> Result[UInt, IOError]
    let (addr, addr_len) = _make_unix_addr(target_path)
    let n = unsafe "FFI boundary" do
      sendto(self.fd, data.as_ptr(), data.len(), 0,
             &addr as Ptr[SockAddrUn] as Ptr[u8], addr_len as u32)
    end
    if n < 0 then
      Result::Err(IOError::Other("unix sendto failed".to_string()))
    else
      Result::Ok(n as UInt)
    end
  end

  def recv(self: UnixDatagram, inout buf: [u8]) -> Result[UInt, IOError]
    let n = unsafe "FFI boundary" do
      recvfrom(self.fd, buf.as_mut_ptr(), buf.len(), 0, Ptr::null() as PtrMut[u8], Ptr::null() as PtrMut[u32])
    end
    if n < 0 then
      Result::Err(IOError::Other("unix recv failed".to_string()))
    else
      Result::Ok(n as UInt)
    end
  end

  def close(inout self: UnixDatagram) -> Unit
    unsafe "FFI boundary" do let _ = std::net::close(self.fd) end
    if let Option::Some(path) = self.bound_path then
      let _ = std::fs::remove_file(path.clone())
    end
  end
end

impl Drop for UnixDatagram
  def drop(inout self: UnixDatagram) -> Unit
    self.close()
  end
end

# ———————————————————————————————————————————————————————————————
# Standalone TLS (via OpenSSL or LibreSSL FFI)
# The C `int` returns (SSL_library_init/SSL_connect/SSL_read/... — the
# 32-bit int) declare the i32 form; the wrappers below widen with the
# explicit `as Int`.
extern "C"
  def c_SSL_library_init() -> i32
  def SSL_load_error_strings() -> Unit
  def TLS_client_method() -> Ptr[Unit]
  def TLS_server_method() -> Ptr[Unit]
  def SSL_CTX_new(method: Ptr[Unit]) -> Ptr[Unit]
  def SSL_CTX_free(ctx: Ptr[Unit]) -> Unit
  def SSL_new(ctx: Ptr[Unit]) -> Ptr[Unit]
  def SSL_free(ssl: Ptr[Unit]) -> Unit
  def c_SSL_set_fd(ssl: Ptr[Unit], fd: Int) -> i32
  def c_SSL_connect(ssl: Ptr[Unit]) -> i32
  def c_SSL_accept(ssl: Ptr[Unit]) -> i32
  def c_SSL_read(ssl: Ptr[Unit], buf: PtrMut[u8], num: Int) -> i32
  def c_SSL_write(ssl: Ptr[Unit], buf: Ptr[u8], num: Int) -> i32
  def c_SSL_shutdown(ssl: Ptr[Unit]) -> i32
  def c_SSL_get_error(ssl: Ptr[Unit], ret: Int) -> i32
  def c_SSL_CTX_use_certificate_file(ctx: Ptr[Unit], file: Ptr[u8], type_: Int) -> i32
  def c_SSL_CTX_use_PrivateKey_file(ctx: Ptr[Unit], file: Ptr[u8], type_: Int) -> i32
  def SSL_CTX_set_verify(ctx: Ptr[Unit], mode: Int, callback: Ptr[Unit]) -> Unit
  def c_SSL_set_tlsext_host_name(ssl: Ptr[Unit], name: Ptr[u8]) -> i32
  def c_SSL_CTX_load_verify_locations(ctx: Ptr[Unit], ca_file: Ptr[u8], ca_path: Ptr[u8]) -> i32
end

def SSL_library_init() -> Int
  c_SSL_library_init() as Int
end

def SSL_set_fd(ssl: Ptr[Unit], fd: Int) -> Int
  c_SSL_set_fd(ssl, fd as i32) as Int
end

def SSL_connect(ssl: Ptr[Unit]) -> Int
  c_SSL_connect(ssl) as Int
end

def SSL_accept(ssl: Ptr[Unit]) -> Int
  c_SSL_accept(ssl) as Int
end

def SSL_read(ssl: Ptr[Unit], buf: PtrMut[u8], num: Int) -> Int
  c_SSL_read(ssl, buf, num as i32) as Int
end

def SSL_write(ssl: Ptr[Unit], buf: Ptr[u8], num: Int) -> Int
  c_SSL_write(ssl, buf, num as i32) as Int
end

def SSL_shutdown(ssl: Ptr[Unit]) -> Int
  c_SSL_shutdown(ssl) as Int
end

def SSL_get_error(ssl: Ptr[Unit], ret: Int) -> Int
  c_SSL_get_error(ssl, ret as i32) as Int
end

def SSL_CTX_use_certificate_file(ctx: Ptr[Unit], file: Ptr[u8], type_: Int) -> Int
  c_SSL_CTX_use_certificate_file(ctx, file, type_ as i32) as Int
end

def SSL_CTX_use_PrivateKey_file(ctx: Ptr[Unit], file: Ptr[u8], type_: Int) -> Int
  c_SSL_CTX_use_PrivateKey_file(ctx, file, type_ as i32) as Int
end

def SSL_set_tlsext_host_name(ssl: Ptr[Unit], name: Ptr[u8]) -> Int
  c_SSL_set_tlsext_host_name(ssl, name) as Int
end

def SSL_CTX_load_verify_locations(ctx: Ptr[Unit], ca_file: Ptr[u8], ca_path: Ptr[u8]) -> Int
  c_SSL_CTX_load_verify_locations(ctx, ca_file, ca_path) as Int
end

const SSL_FILETYPE_PEM: Int = 1
const SSL_VERIFY_PEER: Int = 0x01
const SSL_VERIFY_NONE: Int = 0x00

enum TlsError
  HandshakeFailed(String)
  CertificateError(String)
  ReadError(String)
  WriteError(String)
  Shutdown
  Internal(String)
end

impl Error for TlsError
  def message(self) -> String
    match self
    when TlsError::HandshakeFailed(s) then "TLS handshake failed: " + s.clone()
    when TlsError::CertificateError(s) then "TLS certificate error: " + s.clone()
    when TlsError::ReadError(s) then "TLS read error: " + s.clone()
    when TlsError::WriteError(s) then "TLS write error: " + s.clone()
    when TlsError::Shutdown then "TLS shutdown"
    when TlsError::Internal(s) then "TLS internal error: " + s.clone()
    end
  end
end

struct TlsConfig
  verify_peer: Bool
  cert_file: Option[String]
  key_file: Option[String]
  ca_file: Option[String]
end

def tls_config_default() -> TlsConfig
  TlsConfig {
    verify_peer: true,
    cert_file: Option::None,
    key_file: Option::None,
    ca_file: Option::None,
  }
end

struct TlsStream
  ssl: Ptr[Unit]
  ctx: Ptr[Unit]
  inner_fd: Int
end

def tls_connect(tcp: TcpStream, hostname: str, config: TlsConfig) -> Result[TlsStream, TlsError]
  unsafe "FFI boundary" do SSL_library_init() end
  unsafe "FFI boundary" do SSL_load_error_strings() end

  let method = unsafe "FFI boundary" do TLS_client_method() end
  let ctx = unsafe "FFI boundary" do SSL_CTX_new(method) end
  if ctx.is_null() then
    return Result::Err(TlsError::Internal("failed to create SSL context".to_string()))
  end

  if config.verify_peer then
    unsafe "FFI boundary" do SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, Ptr::null() as Ptr[Unit]) end
  else
    unsafe "FFI boundary" do SSL_CTX_set_verify(ctx, SSL_VERIFY_NONE, Ptr::null() as Ptr[Unit]) end
  end

  match config.cert_file
  when Option::Some(path) then
    let ret = unsafe "FFI boundary" do SSL_CTX_use_certificate_file(ctx, path.to_cstring().as_ptr(), SSL_FILETYPE_PEM) end
    if ret != 1 then
      unsafe "FFI boundary" do SSL_CTX_free(ctx) end
      return Result::Err(TlsError::CertificateError("failed to load certificate file".to_string()))
    end
  when Option::None then ()
  end

  match config.key_file
  when Option::Some(path) then
    let ret = unsafe "FFI boundary" do SSL_CTX_use_PrivateKey_file(ctx, path.to_cstring().as_ptr(), SSL_FILETYPE_PEM) end
    if ret != 1 then
      unsafe "FFI boundary" do SSL_CTX_free(ctx) end
      return Result::Err(TlsError::CertificateError("failed to load private key file".to_string()))
    end
  when Option::None then ()
  end

  match config.ca_file
  when Option::Some(path) then
      let ret = unsafe "FFI boundary" do SSL_CTX_load_verify_locations(ctx, path.to_cstring().as_ptr(), Ptr::null() as Ptr[u8]) end
    if ret != 1 then
      unsafe "FFI boundary" do SSL_CTX_free(ctx) end
      return Result::Err(TlsError::CertificateError("failed to load CA file".to_string()))
    end
  when Option::None then ()
  end

  let ssl = unsafe "FFI boundary" do SSL_new(ctx) end
  if ssl.is_null() then
    unsafe "FFI boundary" do SSL_CTX_free(ctx) end
    return Result::Err(TlsError::Internal("failed to create SSL object".to_string()))
  end

  let fd = tcp.fd()
  unsafe "FFI boundary" do SSL_set_fd(ssl, fd) end
  unsafe "FFI boundary" do SSL_set_tlsext_host_name(ssl, hostname.to_cstring().as_ptr()) end

  let ret = unsafe "FFI boundary" do SSL_connect(ssl) end
  if ret != 1 then
    let err = unsafe "FFI boundary" do SSL_get_error(ssl, ret) end
    unsafe "FFI boundary" do SSL_free(ssl) end
    unsafe "FFI boundary" do SSL_CTX_free(ctx) end
    return Result::Err(TlsError::HandshakeFailed("SSL_connect returned ".to_string() + err.to_string()))
  end

  Result::Ok(TlsStream { ssl: ssl, ctx: ctx, inner_fd: fd })
end

impl TlsStream
  def read(inout self: TlsStream, inout buf: [u8]) -> Result[UInt, TlsError]
    let n = unsafe "FFI boundary" do SSL_read(self.ssl, buf.as_mut_ptr(), buf.len() as Int) end
    if n <= 0 then
      Result::Err(TlsError::ReadError("SSL_read returned ".to_string() + n.to_string()))
    else
      Result::Ok(n as UInt)
    end
  end

  def write(inout self: TlsStream, data: [u8]) -> Result[UInt, TlsError]
    let n = unsafe "FFI boundary" do SSL_write(self.ssl, data.as_ptr(), data.len() as Int) end
    if n <= 0 then
      Result::Err(TlsError::WriteError("SSL_write returned ".to_string() + n.to_string()))
    else
      Result::Ok(n as UInt)
    end
  end

  def shutdown(inout self: TlsStream) -> Unit
    unsafe "FFI boundary" do let _ = SSL_shutdown(self.ssl) end
  end

  def fd(self: TlsStream) -> Int
    self.inner_fd
  end
end

impl Drop for TlsStream
  def drop(inout self: TlsStream) -> Unit
    self.shutdown()
    unsafe "FFI boundary" do SSL_free(self.ssl) end
    unsafe "FFI boundary" do SSL_CTX_free(self.ctx) end
  end
end
