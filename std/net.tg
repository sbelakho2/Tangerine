# Tangerine Standard Library — Networking (TCP/UDP)
#
# Cross-platform networking using Berkeley sockets API.
# Supports:
#   - TCP streams (client and server)
#   - UDP datagrams
#   - IP address resolution
#   - Socket options

use std::core::{Option, Result, panic}
use std::collections::{Vec}
use std::io::{Read, Write, IOError}
use std::time::{TimeVal}
use std::alloc::{size_of}

# ———————————————————————————————————————————————————————————————
# Socket Types and Constants
# ———————————————————————————————————————————————————————————————

# Socket types (portable across Linux/macOS)
def SOCK_STREAM() -> Int = 1   # TCP
def SOCK_DGRAM()  -> Int = 2   # UDP

# Address families
def AF_INET()  -> Int = 2   # IPv4 (portable)

#[cfg(target_os = "linux")]
def AF_INET6() -> Int = 10
#[cfg(target_os = "macos")]
def AF_INET6() -> Int = 30

# Protocol (portable)
def IPPROTO_TCP() -> Int = 6
def IPPROTO_UDP() -> Int = 17

# Shutdown modes (portable)
def SHUT_RD()   -> Int = 0
def SHUT_WR()   -> Int = 1
def SHUT_RDWR() -> Int = 2

# Socket options
#[cfg(target_os = "linux")]
def SOL_SOCKET()    -> Int = 1
#[cfg(target_os = "macos")]
def SOL_SOCKET()    -> Int = 0xFFFF

#[cfg(target_os = "linux")]
def SO_REUSEADDR()  -> Int = 2
#[cfg(target_os = "macos")]
def SO_REUSEADDR()  -> Int = 4

#[cfg(target_os = "linux")]
def SO_KEEPALIVE()  -> Int = 9
#[cfg(target_os = "macos")]
def SO_KEEPALIVE()  -> Int = 8

#[cfg(target_os = "linux")]
def SO_RCVTIMEO()   -> Int = 20
#[cfg(target_os = "macos")]
def SO_RCVTIMEO()   -> Int = 0x1006

#[cfg(target_os = "linux")]
def SO_SNDTIMEO()   -> Int = 21
#[cfg(target_os = "macos")]
def SO_SNDTIMEO()   -> Int = 0x1005

def IPPROTO_TCP_OPT() -> Int = 6
def TCP_NODELAY()   -> Int = 1    # portable

# Error codes
#[cfg(target_os = "linux")]
def EAGAIN()      -> Int = 11
#[cfg(target_os = "macos")]
def EAGAIN()      -> Int = 35

#[cfg(target_os = "linux")]
def EWOULDBLOCK() -> Int = 11
#[cfg(target_os = "macos")]
def EWOULDBLOCK() -> Int = 35

#[cfg(target_os = "linux")]
def EINPROGRESS() -> Int = 115
#[cfg(target_os = "macos")]
def EINPROGRESS() -> Int = 36

#[cfg(target_os = "linux")]
def ECONNREFUSED() -> Int = 111
#[cfg(target_os = "macos")]
def ECONNREFUSED() -> Int = 61

# ———————————————————————————————————————————————————————————————
# C Socket API (extern)
# ———————————————————————————————————————————————————————————————

extern "C"
  # Socket creation and closing
  def socket(domain: Int, type_: Int, protocol: Int) -> Int
  def close(fd: Int) -> Int
  def shutdown(fd: Int, how: Int) -> Int
  
  # Connection
  def connect(fd: Int, addr: Ptr[u8], addrlen: Int) -> Int
  def bind(fd: Int, addr: Ptr[u8], addrlen: Int) -> Int
  def listen(fd: Int, backlog: Int) -> Int
  def accept(fd: Int, addr: Ptr[u8], addrlen: Ptr[Int]) -> Int
  
  # Data transfer
  def send(fd: Int, buf: Ptr[u8], len: UInt, flags: Int) -> Int
  def recv(fd: Int, buf: Ptr[u8], len: UInt, flags: Int) -> Int
  def sendto(fd: Int, buf: Ptr[u8], len: UInt, flags: Int, addr: Ptr[u8], addrlen: Int) -> Int
  def recvfrom(fd: Int, buf: Ptr[u8], len: UInt, flags: Int, addr: Ptr[u8], addrlen: Ptr[Int]) -> Int
  
  # Socket options
  def setsockopt(fd: Int, level: Int, optname: Int, optval: Ptr[u8], optlen: Int) -> Int
  def getsockopt(fd: Int, level: Int, optname: Int, optval: Ptr[u8], optlen: Ptr[Int]) -> Int
  
  # Address info
  def gethostbyname(name: Ptr[u8]) -> Ptr[HostEnt]
  def getaddrinfo(node: Ptr[u8], service: Ptr[u8], hints: Ptr[AddrInfo], res: Ptr[Ptr[AddrInfo]]) -> Int
  def freeaddrinfo(res: Ptr[AddrInfo]) -> Unit
  def gai_strerror(errcode: Int) -> Ptr[u8]
  
  # Byte order
  def htons(hostshort: u16) -> u16
  def htonl(hostlong: u32) -> u32
  def ntohs(netshort: u16) -> u16
  def ntohl(netlong: u32) -> u32
  
  # Address conversion
  def inet_pton(af: Int, src: Ptr[u8], dst: Ptr[u8]) -> Int
  def inet_ntop(af: Int, src: Ptr[u8], dst: Ptr[u8], size: Int) -> Ptr[u8]
end

# ———————————————————————————————————————————————————————————————
# Low-level Structures (matching C layout)
# ———————————————————————————————————————————————————————————————

# sockaddr_in (IPv4)
#[cfg(target_os = "macos")]
struct SockAddrIn
  sin_len: u8
  sin_family: u8
  sin_port: u16
  sin_addr: u32
  sin_zero: [u8; 8]
end

#[cfg(target_os = "linux")]
struct SockAddrIn
  sin_family: u16
  sin_port: u16
  sin_addr: u32
  sin_zero: [u8; 8]
end

#[cfg(target_os = "macos")]
def sockaddr_in_new(family: u16, port: u16, addr: u32) -> SockAddrIn
  SockAddrIn {
    sin_len: 16,
    sin_family: family as u8,
    sin_port: port,
    sin_addr: addr,
    sin_zero: [0, 0, 0, 0, 0, 0, 0, 0]
  }
end

#[cfg(target_os = "linux")]
def sockaddr_in_new(family: u16, port: u16, addr: u32) -> SockAddrIn
  SockAddrIn {
    sin_family: family,
    sin_port: port,
    sin_addr: addr,
    sin_zero: [0, 0, 0, 0, 0, 0, 0, 0]
  }
end

def sockaddr_in_len() -> Int
  16
end

# sockaddr_in6 (IPv6)
struct SockAddrIn6
  sin6_family: u16
  sin6_port: u16
  sin6_flowinfo: u32
  sin6_addr: [u8; 16]
  sin6_scope_id: u32
end

struct HostEnt
  h_name: Ptr[u8]
  h_aliases: Ptr[Ptr[u8]]
  h_addrtype: Int
  h_length: Int
  h_addr_list: Ptr[Ptr[u8]]
end

struct AddrInfo
  ai_flags: Int
  ai_family: Int
  ai_socktype: Int
  ai_protocol: Int
  ai_addrlen: Int
  ai_addr: Ptr[u8]
  ai_canonname: Ptr[u8]
  ai_next: Ptr[AddrInfo]
end

# ———————————————————————————————————————————————————————————————
# IP Address Types
# ———————————————————————————————————————————————————————————————

enum IpAddr
  V4(Ipv4Addr)
  V6(Ipv6Addr)
end

struct Ipv4Addr
  octets: [u8; 4]
end

struct Ipv6Addr
  segments: [u16; 8]
end

def ipv4_new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr
  Ipv4Addr { octets: [a, b, c, d] }
end

def ipv4_localhost() -> Ipv4Addr
  ipv4_new(127, 0, 0, 1)
end

def ipv4_any() -> Ipv4Addr
  ipv4_new(0, 0, 0, 0)
end

def ipv6_localhost() -> Ipv6Addr
  Ipv6Addr { segments: [0, 0, 0, 0, 0, 0, 0, 1] }
end

def ipv6_any() -> Ipv6Addr
  Ipv6Addr { segments: [0, 0, 0, 0, 0, 0, 0, 0] }
end

impl Ipv4Addr
  def to_u32(self: &Ipv4Addr) -> u32
    ((self.octets[0] as u32) << 24) |
    ((self.octets[1] as u32) << 16) |
    ((self.octets[2] as u32) << 8) |
    (self.octets[3] as u32)
  end
  
  def from_u32(val: u32) -> Ipv4Addr
    Ipv4Addr {
      octets: [
        ((val >> 24) & 0xFF) as u8,
        ((val >> 16) & 0xFF) as u8,
        ((val >> 8) & 0xFF) as u8,
        (val & 0xFF) as u8
      ]
    }
  end
  
  def to_string(self: &Ipv4Addr) -> String
    self.octets[0].to_string() + "." +
    self.octets[1].to_string() + "." +
    self.octets[2].to_string() + "." +
    self.octets[3].to_string()
  end
end

# ———————————————————————————————————————————————————————————————
# Socket Address
# ———————————————————————————————————————————————————————————————

struct SocketAddr
  ip: IpAddr
  port: u16
end

def socket_addr_v4(addr: Ipv4Addr, port: u16) -> SocketAddr
  SocketAddr {
    ip: IpAddr::V4(addr),
    port: port
  }
end

def socket_addr_v6(addr: Ipv6Addr, port: u16) -> SocketAddr
  SocketAddr {
    ip: IpAddr::V6(addr),
    port: port
  }
end

impl SocketAddr
  def to_string(self: &SocketAddr) -> String
    match self.ip
    when IpAddr::V4(addr) then
      addr.to_string() + ":" + self.port.to_string()
    when IpAddr::V6(addr) then
      "[...]:" + self.port.to_string()  # Simplified
    end
  end
end

# ———————————————————————————————————————————————————————————————
# TCP Stream (Client)
# ———————————————————————————————————————————————————————————————

struct TcpStream
  fd: Int
  peer_addr: SocketAddr
end

def tcp_connect(addr: SocketAddr) -> Result[TcpStream, IOError]
  let family = match addr.ip
  when IpAddr::V4(_) then AF_INET()
  when IpAddr::V6(_) then AF_INET6()
  end
  
  let fd = socket(family, SOCK_STREAM(), IPPROTO_TCP())
  if fd < 0 then
    return Result::Err(IOError::Other("Failed to create socket".to_string()))
  end
  
  # Build sockaddr
  match addr.ip
  when IpAddr::V4(ipv4) then
    mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
    
    let result = connect(fd, &sockaddr as Ptr[u8], sockaddr_in_len())
    if result < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to connect".to_string()))
    end
  when IpAddr::V6(ipv6) then
    # IPv6 support
    mut addr_bytes: [u8; 16] = [0; 16]
    mut i = 0
    while i < 8 do
      let seg = ipv6.segments[i]
      addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
      addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
      i = i + 1
    end
    
    mut sockaddr6 = SockAddrIn6 {
      sin6_family: AF_INET6() as u16,
      sin6_port: htons(addr.port),
      sin6_flowinfo: 0,
      sin6_addr: addr_bytes,
      sin6_scope_id: 0
    }
    
    let result = connect(fd, &sockaddr6 as Ptr[u8], 28)
    if result < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to connect".to_string()))
    end
  end
  
  Result::Ok(TcpStream { fd: fd, peer_addr: addr })
end

impl TcpStream
  def peer_addr(self: &TcpStream) -> SocketAddr
    self.peer_addr.clone()
  end

  def raw_fd(self: &TcpStream) -> Int
    self.fd
  end
  
  def shutdown(self: &TcpStream, how: Int) -> Result[Unit, IOError]
    if shutdown(self.fd, how) < 0 then
      Result::Err(IOError::Other("Shutdown failed".to_string()))
    else
      Result::Ok(())
    end
  end
  
  def set_nodelay(self: &TcpStream, nodelay: Bool) -> Result[Unit, IOError]
    let val: Int = if nodelay then 1 else 0 end
    if setsockopt(self.fd, IPPROTO_TCP_OPT(), TCP_NODELAY(), &val as Ptr[u8], 4) < 0 then
      Result::Err(IOError::Other("Failed to set TCP_NODELAY".to_string()))
    else
      Result::Ok(())
    end
  end
  
  def set_read_timeout(self: &TcpStream, secs: Int, usecs: Int) -> Result[Unit, IOError]
    mut tv = TimeVal { tv_sec: secs as i64, tv_usec: usecs as i64 }
    let tv_size = size_of[TimeVal]() as UInt
    if setsockopt(self.fd, SOL_SOCKET(), SO_RCVTIMEO(), &tv as Ptr[u8], tv_size) < 0 then
      Result::Err(IOError::Other("Failed to set read timeout".to_string()))
    else
      Result::Ok(())
    end
  end
end

impl Read for TcpStream
  def read(self: &mut TcpStream, buf: &mut Vec[u8]) -> Result[Int, IOError]
    let n = recv(self.fd, buf.as_mut_ptr(), buf.len() as UInt, 0)
    if n < 0 then
      Result::Err(IOError::Other("Read failed".to_string()))
    else
      Result::Ok(n)
    end
  end
end

impl Write for TcpStream
  def write(self: &mut TcpStream, buf: &Vec[u8]) -> Result[Int, IOError]
    let n = send(self.fd, buf.as_ptr(), buf.len() as UInt, 0)
    if n < 0 then
      Result::Err(IOError::Other("Write failed".to_string()))
    else
      Result::Ok(n)
    end
  end

  def flush(self: &mut TcpStream) -> Result[Unit, IOError]
    Result::Ok(())
  end
end

impl Drop for TcpStream
  def drop(self: &mut TcpStream) -> Unit
    if self.fd >= 0 then
      close(self.fd)
      self.fd = -1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# TCP Listener (Server)
# ———————————————————————————————————————————————————————————————

struct TcpListener
  fd: Int
  local_addr: SocketAddr
end

def tcp_bind(addr: SocketAddr) -> Result[TcpListener, IOError]
  let family = match addr.ip
  when IpAddr::V4(_) then AF_INET()
  when IpAddr::V6(_) then AF_INET6()
  end
  
  let fd = socket(family, SOCK_STREAM(), IPPROTO_TCP())
  if fd < 0 then
    return Result::Err(IOError::Other("Failed to create socket".to_string()))
  end
  
  # Set SO_REUSEADDR
  let val: Int = 1
  setsockopt(fd, SOL_SOCKET(), SO_REUSEADDR(), &val as Ptr[u8], 4)
  
  # Bind
  match addr.ip
  when IpAddr::V4(ipv4) then
    mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
    
    if bind(fd, &sockaddr as Ptr[u8], sockaddr_in_len()) < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to bind".to_string()))
    end
  when IpAddr::V6(ipv6) then
    # IPv6 support
    mut addr_bytes: [u8; 16] = [0; 16]
    mut i = 0
    while i < 8 do
      let seg = ipv6.segments[i]
      addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
      addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
      i = i + 1
    end
    
    mut sockaddr6 = SockAddrIn6 {
      sin6_family: AF_INET6() as u16,
      sin6_port: htons(addr.port),
      sin6_flowinfo: 0,
      sin6_addr: addr_bytes,
      sin6_scope_id: 0
    }
    
    if bind(fd, &sockaddr6 as Ptr[u8], 28) < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to bind".to_string()))
    end
  end
  
  # Listen
  if listen(fd, 128) < 0 then
    close(fd)
    return Result::Err(IOError::Other("Failed to listen".to_string()))
  end
  
  Result::Ok(TcpListener { fd: fd, local_addr: addr })
end

impl TcpListener
  def local_addr(self: &TcpListener) -> SocketAddr
    self.local_addr.clone()
  end
  
  def accept(self: &TcpListener) -> Result[TcpStream, IOError]
    mut client_addr = sockaddr_in_new(0, 0, 0)
    mut addrlen: Int = sockaddr_in_len()
    
    let client_fd = accept(self.fd, &client_addr as Ptr[u8], &addrlen)
    if client_fd < 0 then
      return Result::Err(IOError::Other("Accept failed".to_string()))
    end
    
    let peer_ip = Ipv4Addr::from_u32(ntohl(client_addr.sin_addr))
    let peer_port = ntohs(client_addr.sin_port)
    let peer_addr = socket_addr_v4(peer_ip, peer_port)
    
    Result::Ok(TcpStream { fd: client_fd, peer_addr: peer_addr })
  end
  
  def incoming(self: &TcpListener) -> IncomingConnections
    IncomingConnections { listener: self }
  end
end

impl Drop for TcpListener
  def drop(self: &mut TcpListener) -> Unit
    if self.fd >= 0 then
      close(self.fd)
      self.fd = -1
    end
  end
end

struct IncomingConnections
  listener: &TcpListener
end

impl Iterator for IncomingConnections
  type Item = Result[TcpStream, IOError]
  
  def next(self: &mut IncomingConnections) -> Option[Result[TcpStream, IOError]]
    Option::Some(self.listener.accept())
  end
end

# ———————————————————————————————————————————————————————————————
# UDP Socket
# ———————————————————————————————————————————————————————————————

struct UdpSocket
  fd: Int
  local_addr: SocketAddr
end

def udp_bind(addr: SocketAddr) -> Result[UdpSocket, IOError]
  let family = match addr.ip
  when IpAddr::V4(_) then AF_INET()
  when IpAddr::V6(_) then AF_INET6()
  end
  
  let fd = socket(family, SOCK_DGRAM(), IPPROTO_UDP())
  if fd < 0 then
    return Result::Err(IOError::Other("Failed to create socket".to_string()))
  end
  
  # Bind
  match addr.ip
  when IpAddr::V4(ipv4) then
    mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
    
    if bind(fd, &sockaddr as Ptr[u8], sockaddr_in_len()) < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to bind".to_string()))
    end
  when IpAddr::V6(ipv6) then
    # IPv6 support
    mut addr_bytes: [u8; 16] = [0; 16]
    mut i = 0
    while i < 8 do
      let seg = ipv6.segments[i]
      addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
      addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
      i = i + 1
    end
    
    mut sockaddr6 = SockAddrIn6 {
      sin6_family: AF_INET6() as u16,
      sin6_port: htons(addr.port),
      sin6_flowinfo: 0,
      sin6_addr: addr_bytes,
      sin6_scope_id: 0
    }
    
    if bind(fd, &sockaddr6 as Ptr[u8], 28) < 0 then
      close(fd)
      return Result::Err(IOError::Other("Failed to bind".to_string()))
    end
  end
  
  Result::Ok(UdpSocket { fd: fd, local_addr: addr })
end

impl UdpSocket
  def local_addr(self: &UdpSocket) -> SocketAddr
    self.local_addr.clone()
  end
  
  def send_to(self: &UdpSocket, buf: &[u8], addr: SocketAddr) -> Result[Int, IOError]
    match addr.ip
    when IpAddr::V4(ipv4) then
      mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
      
      let n = sendto(self.fd, buf.as_ptr(), buf.len() as UInt, 0, &sockaddr as Ptr[u8], sockaddr_in_len())
      if n < 0 then
        Result::Err(IOError::Other("Send failed".to_string()))
      else
        Result::Ok(n)
      end
    when IpAddr::V6(ipv6) then
      # IPv6 support
      mut addr_bytes: [u8; 16] = [0; 16]
      mut i = 0
      while i < 8 do
        let seg = ipv6.segments[i]
        addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
        addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
        i = i + 1
      end
      
      mut sockaddr6 = SockAddrIn6 {
        sin6_family: AF_INET6() as u16,
        sin6_port: htons(addr.port),
        sin6_flowinfo: 0,
        sin6_addr: addr_bytes,
        sin6_scope_id: 0
      }
      
      let n = sendto(self.fd, buf.as_ptr(), buf.len() as UInt, 0, &sockaddr6 as Ptr[u8], 28)
      if n < 0 then
        Result::Err(IOError::Other("Send failed".to_string()))
      else
        Result::Ok(n)
      end
    end
  end
  
  def recv_from(self: &UdpSocket, buf: &mut [u8]) -> Result[(Int, SocketAddr), IOError]
    mut addr_storage: [u8; 32] = [0; 32]
    mut addrlen: Int = 32
    
    let n = recvfrom(self.fd, buf.as_ptr(), buf.len() as UInt, 0, &addr_storage as Ptr[u8], &addrlen)
    if n < 0 then
      return Result::Err(IOError::Other("Receive failed".to_string()))
    end

    if addrlen >= 28 then
      let sockaddr6 = &addr_storage as Ptr[SockAddrIn6]
      mut segments: [u16; 8] = [0; 8]
      mut i = 0
      while i < 8 do
        let hi = sockaddr6.sin6_addr[i * 2] as u16
        let lo = sockaddr6.sin6_addr[i * 2 + 1] as u16
        segments[i] = (hi << 8) | lo
        i = i + 1
      end

      let peer_ip = Ipv6Addr { segments: segments }
      let peer_port = ntohs(sockaddr6.sin6_port)
      Result::Ok((n, socket_addr_v6(peer_ip, peer_port)))
    else
      let sockaddr = &addr_storage as Ptr[SockAddrIn]
      let peer_ip = Ipv4Addr::from_u32(ntohl(sockaddr.sin_addr))
      let peer_port = ntohs(sockaddr.sin_port)
      Result::Ok((n, socket_addr_v4(peer_ip, peer_port)))
    end
  end
  
  def connect(self: &UdpSocket, addr: SocketAddr) -> Result[Unit, IOError]
    match addr.ip
    when IpAddr::V4(ipv4) then
      mut sockaddr = sockaddr_in_new(AF_INET() as u16, htons(addr.port), htonl(ipv4.to_u32()))
      
      if connect(self.fd, &sockaddr as Ptr[u8], sockaddr_in_len()) < 0 then
        Result::Err(IOError::Other("Connect failed".to_string()))
      else
        Result::Ok(())
      end
    when IpAddr::V6(ipv6) then
      # IPv6 support
      mut addr_bytes: [u8; 16] = [0; 16]
      mut i = 0
      while i < 8 do
        let seg = ipv6.segments[i]
        addr_bytes[i * 2] = ((seg >> 8) & 0xFF) as u8
        addr_bytes[i * 2 + 1] = (seg & 0xFF) as u8
        i = i + 1
      end
      
      mut sockaddr6 = SockAddrIn6 {
        sin6_family: AF_INET6() as u16,
        sin6_port: htons(addr.port),
        sin6_flowinfo: 0,
        sin6_addr: addr_bytes,
        sin6_scope_id: 0
      }
      
      if connect(self.fd, &sockaddr6 as Ptr[u8], 28) < 0 then
        Result::Err(IOError::Other("Connect failed".to_string()))
      else
        Result::Ok(())
      end
    end
  end
  
  def send(self: &UdpSocket, buf: &[u8]) -> Result[Int, IOError]
    let n = send(self.fd, buf.as_ptr(), buf.len() as UInt, 0)
    if n < 0 then
      Result::Err(IOError::Other("Send failed".to_string()))
    else
      Result::Ok(n)
    end
  end
  
  def recv(self: &UdpSocket, buf: &mut [u8]) -> Result[Int, IOError]
    let n = recv(self.fd, buf.as_ptr(), buf.len() as UInt, 0)
    if n < 0 then
      Result::Err(IOError::Other("Receive failed".to_string()))
    else
      Result::Ok(n)
    end
  end
  
  def set_broadcast(self: &UdpSocket, broadcast: Bool) -> Result[Unit, IOError]
    let val: Int = if broadcast then 1 else 0 end
    let SO_BROADCAST: Int = 6
    if setsockopt(self.fd, SOL_SOCKET(), SO_BROADCAST, &val as Ptr[u8], 4) < 0 then
      Result::Err(IOError::Other("Failed to set broadcast".to_string()))
    else
      Result::Ok(())
    end
  end
end

impl Drop for UdpSocket
  def drop(self: &mut UdpSocket) -> Unit
    if self.fd >= 0 then
      close(self.fd)
      self.fd = -1
    end
  end
end

# ———————————————————————————————————————————————————————————————
# DNS Resolution
# ———————————————————————————————————————————————————————————————

def gai_error_message(code: Int) -> String
  let ptr = gai_strerror(code)
  if ptr.is_null() then
    "unknown DNS error (code " + code.to_string() + ")"
  else
    unsafe "FFI string conversion" do String::from_c_str(ptr) end
  end
end

def resolve_host(hostname: String) -> Result[Vec[IpAddr], IOError]
  mut results: Vec[IpAddr] = Vec::new()
  
  mut hints = AddrInfo {
    ai_flags: 0,
    ai_family: AF_INET(),
    ai_socktype: SOCK_STREAM(),
    ai_protocol: 0,
    ai_addrlen: 0,
    ai_addr: Ptr::null(),
    ai_canonname: Ptr::null(),
    ai_next: Ptr::null()
  }
  
  mut res: Ptr[AddrInfo] = Ptr::null()
  
  let hostname_cstr = hostname.to_cstring()
  let ret = getaddrinfo(hostname_cstr.as_ptr(), Ptr::null(), &hints, &res)
  
  if ret != 0 then
    return Result::Err(IOError::Other("DNS resolution failed for '" + hostname + "': " + gai_error_message(ret)))
  end
  
  mut current = res
  while !current.is_null() do
    if current.ai_family == AF_INET() then
      if current.ai_addr.is_null() then
        current = current.ai_next
        next
      end
      let sockaddr = current.ai_addr as Ptr[SockAddrIn]
      let addr = ntohl(sockaddr.sin_addr)
      results.push(IpAddr::V4(Ipv4Addr::from_u32(addr)))
    end
    current = current.ai_next
  end
  
  freeaddrinfo(res)
  
  Result::Ok(results)
end

# ———————————————————————————————————————————————————————————————
# Convenience Functions
# ———————————————————————————————————————————————————————————————

def tcp_connect_host(host: String, port: u16) -> Result[TcpStream, IOError]
  match resolve_host(host)
  when Result::Ok(addrs) then
    if addrs.is_empty() then
      return Result::Err(IOError::Other("No addresses found for host '" + host + "'".to_string()))
    end
    
    # Try each resolved address (IPv4 or IPv6)
    match addrs[0]
    when IpAddr::V4(addr) then
      tcp_connect(socket_addr_v4(addr, port))
    when IpAddr::V6(addr) then
      tcp_connect(socket_addr_v6(addr, port))
    end
  when Result::Err(e) then
    Result::Err(e)
  end
end
