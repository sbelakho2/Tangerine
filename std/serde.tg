# Tangerine Standard Library — tg::serde
# Serialization and Deserialization

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, f32, f64}
use std::collections::HashMap

# [METADATA]
# module: tg::serde
# status: stable
# effects: []
# capabilities: []

# ═══════════════════════════════════════════════════════════════
# Serde Traits
# ═══════════════════════════════════════════════════════════════

trait Serialize
  def serialize[S: Serializer](self: Self, inout serializer: S) -> Result[Unit, String]
end

trait Deserialize
  def deserialize[D: Deserializer](inout deserializer: D) -> Result[Self, String]
end

trait Serializer
  def serialize_bool(inout self: Self, v: Bool) -> Result[Unit, String]
  def serialize_i8(inout self: Self, v: i8) -> Result[Unit, String]
  def serialize_i16(inout self: Self, v: i16) -> Result[Unit, String]
  def serialize_i32(inout self: Self, v: i32) -> Result[Unit, String]
  def serialize_i64(inout self: Self, v: i64) -> Result[Unit, String]
  def serialize_u8(inout self: Self, v: u8) -> Result[Unit, String]
  def serialize_u16(inout self: Self, v: u16) -> Result[Unit, String]
  def serialize_u32(inout self: Self, v: u32) -> Result[Unit, String]
  def serialize_u64(inout self: Self, v: u64) -> Result[Unit, String]
  def serialize_f32(inout self: Self, v: f32) -> Result[Unit, String]
  def serialize_f64(inout self: Self, v: f64) -> Result[Unit, String]
  def serialize_char(inout self: Self, v: char) -> Result[Unit, String]
  def serialize_str(inout self: Self, v: String) -> Result[Unit, String]
  def serialize_bytes(inout self: Self, v: [u8]) -> Result[Unit, String]
  def serialize_none(inout self: Self) -> Result[Unit, String]
  def serialize_some[T: Serialize](inout self: Self, v: T) -> Result[Unit, String]
  def serialize_unit(inout self: Self) -> Result[Unit, String]
  def serialize_seq_start(inout self: Self, len: Option[UInt]) -> Result[Unit, String]
  def serialize_seq_elem[T: Serialize](inout self: Self, v: T) -> Result[Unit, String]
  def serialize_seq_end(inout self: Self) -> Result[Unit, String]
  def serialize_map_start(inout self: Self, len: Option[UInt]) -> Result[Unit, String]
  def serialize_map_key[K: Serialize](inout self: Self, k: K) -> Result[Unit, String]
  def serialize_map_value[V: Serialize](inout self: Self, v: V) -> Result[Unit, String]
  def serialize_map_end(inout self: Self) -> Result[Unit, String]
end

trait Deserializer
  def deserialize_bool(inout self: Self) -> Result[Bool, String]
  def deserialize_i8(inout self: Self) -> Result[i8, String]
  def deserialize_i16(inout self: Self) -> Result[i16, String]
  def deserialize_i32(inout self: Self) -> Result[i32, String]
  def deserialize_i64(inout self: Self) -> Result[i64, String]
  def deserialize_u8(inout self: Self) -> Result[u8, String]
  def deserialize_u16(inout self: Self) -> Result[u16, String]
  def deserialize_u32(inout self: Self) -> Result[u32, String]
  def deserialize_u64(inout self: Self) -> Result[u64, String]
  def deserialize_f32(inout self: Self) -> Result[f32, String]
  def deserialize_f64(inout self: Self) -> Result[f64, String]
  def deserialize_char(inout self: Self) -> Result[char, String]
  def deserialize_str(inout self: Self) -> Result[String, String]
  def deserialize_bytes(inout self: Self) -> Result[Vec[u8], String]
  def deserialize_option[T: Deserialize](inout self: Self) -> Result[Option[T], String]
  def deserialize_unit(inout self: Self) -> Result[Unit, String]
  def deserialize_seq[T: Deserialize](inout self: Self) -> Result[Vec[T], String]
  def deserialize_map[K: Deserialize, V: Deserialize](inout self: Self) -> Result[HashMap[K, V], String]
end

# ═══════════════════════════════════════════════════════════════
# JSON Serializer
# ═══════════════════════════════════════════════════════════════

struct JsonSerializer
  output: String
  pretty: Bool
  indent: UInt
end

def JsonSerializer::new() -> JsonSerializer
  JsonSerializer { output: "", pretty: false, indent: 0 }
end

def JsonSerializer::pretty() -> JsonSerializer
  JsonSerializer { output: "", pretty: true, indent: 0 }
end

def JsonSerializer::write(inout self: JsonSerializer, s: String) -> Unit
  self.output = self.output + s
end

def JsonSerializer::write_indent(inout self: JsonSerializer) -> Unit
  if self.pretty then
    mut i = 0
    while i < self.indent do
      self.write("  ")
      i = i + 1
    end
  end
end

def JsonSerializer::write_newline(inout self: JsonSerializer) -> Unit
  if self.pretty then
    self.write("\n")
  end
end

def escape_json_string(s: String) -> String
  mut result = "\""
  for ch in s.chars() do
    match ch
    when '"' then result = result + "\\\""
    when '\\' then result = result + "\\\\"
    when '\n' then result = result + "\\n"
    when '\r' then result = result + "\\r"
    when '\t' then result = result + "\\t"
    when c then
      if (c as u32) < 0x20 then
        result = result + "\\u" + hex_escape(c as u32)
      else
        result = result + c.to_string()
      end
    end
  end
  result + "\""
end

def hex_escape(n: u32) -> String
  let hex = "0123456789abcdef"
  mut result = ""
  mut i = 0
  while i < 4 do
    let digit = (n >> ((3 - i) * 4)) & 0xF
    result = result + hex[digit as UInt].to_string()
    i = i + 1
  end
  result
end

impl Serializer for JsonSerializer
  def serialize_bool(inout self: JsonSerializer, v: Bool) -> Result[Unit, String]
    self.write(if v then "true" else "false" end)
    Result::Ok(())
  end
  
  def serialize_i8(inout self: JsonSerializer, v: i8) -> Result[Unit, String]
    self.write(v.to_string())
    Result::Ok(())
  end
  
  def serialize_i16(inout self: JsonSerializer, v: i16) -> Result[Unit, String]
    self.write(v.to_string())
    Result::Ok(())
  end
  
  def serialize_i32(inout self: JsonSerializer, v: i32) -> Result[Unit, String]
    self.write(v.to_string())
    Result::Ok(())
  end
  
  def serialize_i64(inout self: JsonSerializer, v: i64) -> Result[Unit, String]
    self.write(v.to_string())
    Result::Ok(())
  end
  
  def serialize_u8(inout self: JsonSerializer, v: u8) -> Result[Unit, String]
    self.write(v.to_string())
    Result::Ok(())
  end
  
  def serialize_u16(inout self: JsonSerializer, v: u16) -> Result[Unit, String]
    self.write(v.to_string())
    Result::Ok(())
  end
  
  def serialize_u32(inout self: JsonSerializer, v: u32) -> Result[Unit, String]
    self.write(v.to_string())
    Result::Ok(())
  end
  
  def serialize_u64(inout self: JsonSerializer, v: u64) -> Result[Unit, String]
    self.write(v.to_string())
    Result::Ok(())
  end
  
  def serialize_f32(inout self: JsonSerializer, v: f32) -> Result[Unit, String]
    if v.is_nan() then
      self.write("null")
    else if v.is_infinite() then
      self.write("null")
    else
      self.write(v.to_string())
    end
    Result::Ok(())
  end
  
  def serialize_f64(inout self: JsonSerializer, v: f64) -> Result[Unit, String]
    if v.is_nan() then
      self.write("null")
    else if v.is_infinite() then
      self.write("null")
    else
      self.write(v.to_string())
    end
    Result::Ok(())
  end
  
  def serialize_char(inout self: JsonSerializer, v: char) -> Result[Unit, String]
    self.write(escape_json_string(&v.to_string()))
    Result::Ok(())
  end
  
  def serialize_str(inout self: JsonSerializer, v: String) -> Result[Unit, String]
    self.write(escape_json_string(v))
    Result::Ok(())
  end
  
  def serialize_bytes(inout self: JsonSerializer, v: [u8]) -> Result[Unit, String]
    # Encode as base64
    self.write("\"")
    self.write(base64_encode(v))
    self.write("\"")
    Result::Ok(())
  end
  
  def serialize_none(inout self: JsonSerializer) -> Result[Unit, String]
    self.write("null")
    Result::Ok(())
  end
  
  def serialize_some[T: Serialize](inout self: JsonSerializer, v: T) -> Result[Unit, String]
    v.serialize(self)
  end
  
  def serialize_unit(inout self: JsonSerializer) -> Result[Unit, String]
    self.write("null")
    Result::Ok(())
  end
  
  def serialize_seq_start(inout self: JsonSerializer, _len: Option[UInt]) -> Result[Unit, String]
    self.write("[")
    self.indent = self.indent + 1
    self.write_newline()
    Result::Ok(())
  end
  
  def serialize_seq_elem[T: Serialize](inout self: JsonSerializer, v: T) -> Result[Unit, String]
    self.write_indent()
    v.serialize(self)
    Result::Ok(())
  end
  
  def serialize_seq_end(inout self: JsonSerializer) -> Result[Unit, String]
    self.indent = self.indent - 1
    self.write_newline()
    self.write_indent()
    self.write("]")
    Result::Ok(())
  end
  
  def serialize_map_start(inout self: JsonSerializer, _len: Option[UInt]) -> Result[Unit, String]
    self.write("{")
    self.indent = self.indent + 1
    self.write_newline()
    Result::Ok(())
  end
  
  def serialize_map_key[K: Serialize](inout self: JsonSerializer, k: K) -> Result[Unit, String]
    self.write_indent()
    k.serialize(self)
    self.write(":")
    if self.pretty then self.write(" ") end
    Result::Ok(())
  end
  
  def serialize_map_value[V: Serialize](inout self: JsonSerializer, v: V) -> Result[Unit, String]
    v.serialize(self)
    Result::Ok(())
  end
  
  def serialize_map_end(inout self: JsonSerializer) -> Result[Unit, String]
    self.indent = self.indent - 1
    self.write_newline()
    self.write_indent()
    self.write("}")
    Result::Ok(())
  end
end

def JsonSerializer::output(self: JsonSerializer) -> String
  self.output.clone()
end

# ═══════════════════════════════════════════════════════════════
# JSON Deserializer
# ═══════════════════════════════════════════════════════════════

struct JsonDeserializer
  input: String
  pos: UInt
end

def JsonDeserializer::new(input: String) -> JsonDeserializer
  JsonDeserializer { input: input, pos: 0 }
end

def JsonDeserializer::peek(self: JsonDeserializer) -> Option[char]
  if self.pos >= self.input.len() then
    Option::None
  else
    Option::Some(self.input[self.pos])
  end
end

def JsonDeserializer::next(inout self: JsonDeserializer) -> Option[char]
  match self.peek()
  when Option::Some(c) then
    self.pos = self.pos + 1
    Option::Some(c)
  when Option::None then Option::None
  end
end

def JsonDeserializer::skip_whitespace(inout self: JsonDeserializer) -> Unit
  loop
    match self.peek()
    when Option::Some(c) then
      if c == ' ' || c == '\t' || c == '\n' || c == '\r' then
        self.pos = self.pos + 1
      else
        return
      end
    when Option::None then return
    end
  end
end

def JsonDeserializer::expect(inout self: JsonDeserializer, expected: char) -> Result[Unit, String]
  self.skip_whitespace()
  match self.next()
  when Option::Some(c) then
    if c == expected then
      Result::Ok(())
    else
      Result::Err("Expected '" + expected.to_string() + "' but found '" + c.to_string() + "'")
    end
  when Option::None then
    Result::Err("Unexpected end of input, expected '" + expected.to_string() + "'")
  end
end

def JsonDeserializer::parse_string(inout self: JsonDeserializer) -> Result[String, String]
  self.skip_whitespace()
  self.expect('"')?
  
  mut result = ""
  loop
    match self.next()
    when Option::Some(c) then
      if c == '"' then
        return Result::Ok(result)
      else if c == '\\' then
        match self.next()
        when Option::Some(escaped) then
          match escaped
          when '"' then result = result + "\""
          when '\\' then result = result + "\\"
          when '/' then result = result + "/"
          when 'b' then result = result + "\x08"
          when 'f' then result = result + "\x0C"
          when 'n' then result = result + "\n"
          when 'r' then result = result + "\r"
          when 't' then result = result + "\t"
          when 'u' then
            # Parse \uXXXX
            mut code = 0u32
            mut i = 0
            while i < 4 do
              match self.next()
              when Option::Some(h) then
                code = (code << 4) | (hex_digit(h)? as u32)
              when Option::None then
                return Result::Err("Unexpected end of unicode escape")
              end
              i = i + 1
            end
            result = result + (code as char).to_string()
          when _ then
            return Result::Err("Invalid escape sequence: \\" + escaped.to_string())
          end
        when Option::None then
          return Result::Err("Unexpected end of string escape")
        end
      else
        result = result + c.to_string()
      end
    when Option::None then
      return Result::Err("Unexpected end of string")
    end
  end
end

def hex_digit(c: char) -> Result[u8, String]
  match c
  when '0' then Result::Ok(0)
  when '1' then Result::Ok(1)
  when '2' then Result::Ok(2)
  when '3' then Result::Ok(3)
  when '4' then Result::Ok(4)
  when '5' then Result::Ok(5)
  when '6' then Result::Ok(6)
  when '7' then Result::Ok(7)
  when '8' then Result::Ok(8)
  when '9' then Result::Ok(9)
  when 'a' then Result::Ok(10)
  when 'b' then Result::Ok(11)
  when 'c' then Result::Ok(12)
  when 'd' then Result::Ok(13)
  when 'e' then Result::Ok(14)
  when 'f' then Result::Ok(15)
  when 'A' then Result::Ok(10)
  when 'B' then Result::Ok(11)
  when 'C' then Result::Ok(12)
  when 'D' then Result::Ok(13)
  when 'E' then Result::Ok(14)
  when 'F' then Result::Ok(15)
  when _ then Result::Err("Invalid hex digit: " + c.to_string())
  end  end  end
end

def JsonDeserializer::parse_number(inout self: JsonDeserializer) -> Result[String, String]
  self.skip_whitespace()
  mut result = ""
  
  # Handle negative
  match self.peek()
  when Option::Some('-') then
    result = result + "-"
    self.pos = self.pos + 1
  when _ then ()
  end
  
  # Integer part
  match self.peek()
  when Option::Some('0') then
    result = result + "0"
    self.pos = self.pos + 1
  when Option::Some(c) then
    if c >= '1' && c <= '9' then
      loop
        match self.peek()
        when Option::Some(d) then
          if d >= '0' && d <= '9' then
            result = result + d.to_string()
            self.pos = self.pos + 1
          else
            break
          end
        when Option::None then break
        end
      end
    end
  when Option::None then return Result::Err("Unexpected end of number")
  end
  
  # Fractional part
  match self.peek()
  when Option::Some('.') then
    result = result + "."
    self.pos = self.pos + 1
    loop
      match self.peek()
      when Option::Some(d) then
        if d >= '0' && d <= '9' then
          result = result + d.to_string()
          self.pos = self.pos + 1
        else
          break
        end
      when Option::None then break
      end
    end
  when _ then ()
  end
  
  # Exponent
  match self.peek()
  when Option::Some('e') then
    result = result + "e"
    self.pos = self.pos + 1
  when Option::Some('E') then
    result = result + "e"
    self.pos = self.pos + 1
  when _ then return Result::Ok(result)
  end
  
  match self.peek()
  when Option::Some('+') then
    self.pos = self.pos + 1
  when Option::Some('-') then
    result = result + "-"
    self.pos = self.pos + 1
  when _ then ()
  end
  
  loop
    match self.peek()
    when Option::Some(d) then
      if d >= '0' && d <= '9' then
        result = result + d.to_string()
        self.pos = self.pos + 1
      else
        break
      end
    when Option::None then break
    end
  end
  
  Result::Ok(result)
end

impl Deserializer for JsonDeserializer
  def deserialize_bool(inout self: JsonDeserializer) -> Result[Bool, String]
    self.skip_whitespace()
    match self.peek()
    when Option::Some('t') then
      self.pos = self.pos + 4  # "true"
      Result::Ok(true)
    when Option::Some('f') then
      self.pos = self.pos + 5  # "false"
      Result::Ok(false)
    when Option::Some(c) then
      Result::Err("Expected boolean, got: " + c.to_string())
    when Option::None then
      Result::Err("Unexpected end of input")
    end
  end
  
  def deserialize_i8(inout self: JsonDeserializer) -> Result[i8, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<i8>())
  end
  
  def deserialize_i16(inout self: JsonDeserializer) -> Result[i16, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<i16>())
  end
  
  def deserialize_i32(inout self: JsonDeserializer) -> Result[i32, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<i32>())
  end
  
  def deserialize_i64(inout self: JsonDeserializer) -> Result[i64, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<i64>())
  end
  
  def deserialize_u8(inout self: JsonDeserializer) -> Result[u8, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<u8>())
  end
  
  def deserialize_u16(inout self: JsonDeserializer) -> Result[u16, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<u16>())
  end
  
  def deserialize_u32(inout self: JsonDeserializer) -> Result[u32, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<u32>())
  end
  
  def deserialize_u64(inout self: JsonDeserializer) -> Result[u64, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<u64>())
  end
  
  def deserialize_f32(inout self: JsonDeserializer) -> Result[f32, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<f32>())
  end
  
  def deserialize_f64(inout self: JsonDeserializer) -> Result[f64, String]
    let num = self.parse_number()?
    Result::Ok(num.parse::<f64>())
  end
  
  def deserialize_char(inout self: JsonDeserializer) -> Result[char, String]
    let s = self.parse_string()?
    if s.len() == 1 then
      Result::Ok(s[0])
    else
      Result::Err("Expected single character string")
    end
  end
  
  def deserialize_str(inout self: JsonDeserializer) -> Result[String, String]
    self.parse_string()
  end
  
  def deserialize_bytes(inout self: JsonDeserializer) -> Result[Vec[u8], String]
    let s = self.parse_string()?
    base64_decode(&s)
  end
  
  def deserialize_option[T: Deserialize](inout self: JsonDeserializer) -> Result[Option[T], String]
    self.skip_whitespace()
    match self.peek()
    when Option::Some('n') then
      self.pos = self.pos + 4  # "null"
      Result::Ok(Option::None)
    when _ then
      match T::deserialize(self)
      when Result::Ok(v) then Result::Ok(Option::Some(v))
      when Result::Err(e) then Result::Err(e)
      end
    end
  end
  
  def deserialize_unit(inout self: JsonDeserializer) -> Result[Unit, String]
    self.skip_whitespace()
    match self.peek()
    when Option::Some('n') then
      self.pos = self.pos + 4
      Result::Ok(())
    when _ then Result::Err("Expected null")
    end
  end
  
  def deserialize_seq[T: Deserialize](inout self: JsonDeserializer) -> Result[Vec[T], String]
    self.skip_whitespace()
    self.expect('[')?
    
    mut result = Vec::new()
    
    loop
      self.skip_whitespace()
      match self.peek()
      when Option::Some(']') then
        self.pos = self.pos + 1
        return Result::Ok(result)
      when Option::Some(',') then
        self.pos = self.pos + 1
      when _ then ()
      end
      
      match T::deserialize(self)
      when Result::Ok(v) then result.push(v)
      when Result::Err(e) then return Result::Err(e)
      end
    end
  end
  
  def deserialize_map[K: Deserialize, V: Deserialize](inout self: JsonDeserializer) -> Result[HashMap[K, V], String]
    self.skip_whitespace()
    self.expect('{')?
    
    mut result = HashMap::new()
    
    loop
      self.skip_whitespace()
      match self.peek()
      when Option::Some('}') then
        self.pos = self.pos + 1
        return Result::Ok(result)
      when Option::Some(',') then
        self.pos = self.pos + 1
      when _ then ()
      end
      
      let key = K::deserialize(self)?
      self.skip_whitespace()
      self.expect(':')?
      let value = V::deserialize(self)?
      result.insert(key, value)
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# JSON Convenience Functions
# ═══════════════════════════════════════════════════════════════

def to_json[T: Serialize](value: T) -> Result[String, String]
  mut serializer = JsonSerializer::new()
  value.serialize(&mut serializer)?
  Result::Ok(serializer.output())
end

def to_json_pretty[T: Serialize](value: T) -> Result[String, String]
  mut serializer = JsonSerializer::pretty()
  value.serialize(&mut serializer)?
  Result::Ok(serializer.output())
end

def from_json[T: Deserialize](json: String) -> Result[T, String]
  mut deserializer = JsonDeserializer::new(json)
  T::deserialize(&mut deserializer)
end

# ═══════════════════════════════════════════════════════════════
# JSON Value Type
# ═══════════════════════════════════════════════════════════════

enum JsonValue
  Null
  Bool(Bool)
  Number(f64)
  String(String)
  Array(Vec[JsonValue])
  Object(HashMap[String, JsonValue])
end

impl Clone for JsonValue
  def clone(self: Self) -> Self
    match self
    when JsonValue::Null then JsonValue::Null
    when JsonValue::Bool(b) then JsonValue::Bool(b)
    when JsonValue::Number(n) then JsonValue::Number(n)
    when JsonValue::String(s) then JsonValue::String(s.clone())
    when JsonValue::Array(a) then
      var out = Vec::new()
      for item in a do out.push(item.clone()) end
      JsonValue::Array(out)
    when JsonValue::Object(o) then JsonValue::Object(o.clone())
    end
  end
end

impl Serialize for JsonValue
  def serialize[S: Serializer](self: JsonValue, inout ser: S) -> Result[Unit, String]
    match self
    when JsonValue::Null then ser.serialize_unit()
    when JsonValue::Bool(b) then ser.serialize_bool(b)
    when JsonValue::Number(n) then ser.serialize_f64(n)
    when JsonValue::String(s) then ser.serialize_str(s)
    when JsonValue::Array(arr) then
      ser.serialize_seq_start(Option::Some(arr.len()))?
      for item in arr do
        item.serialize(ser)?
      end
      ser.serialize_seq_end()
    when JsonValue::Object(obj) then
      ser.serialize_map_start(Option::Some(obj.len()))?
      for (k, v) in obj do
        ser.serialize_map_key(&k)?
        v.serialize(ser)?
      end
      ser.serialize_map_end()
    end
  end
end

impl Deserialize for JsonValue
  def deserialize[D: Deserializer](inout de: D) -> Result[JsonValue, String]
    # Try each type in order
    de.skip_whitespace()
    match de.peek()
    when Option::Some('n') then
      de.deserialize_unit()?
      Result::Ok(JsonValue::Null)
    when Option::Some('t') then
      let b = de.deserialize_bool()?
      Result::Ok(JsonValue::Bool(b))
    when Option::Some('f') then
      let b = de.deserialize_bool()?
      Result::Ok(JsonValue::Bool(b))
    when Option::Some('"') then
      let s = de.deserialize_str()?
      Result::Ok(JsonValue::String(s))
    when Option::Some('[') then
      let arr = de.deserialize_seq::<JsonValue>()?
      Result::Ok(JsonValue::Array(arr))
    when Option::Some('{') then
      let obj = de.deserialize_map::<String, JsonValue>()?
      Result::Ok(JsonValue::Object(obj))
    when Option::Some(c) then
      if (c >= '0' && c <= '9') || c == '-' then
        let n = de.deserialize_f64()?
        Result::Ok(JsonValue::Number(n))
      else
        Result::Err("Unexpected character: " + c.to_string())
      end
    when Option::None then
      Result::Err("Unexpected end of input")
    end
  end
end

def JsonValue::as_bool(self: JsonValue) -> Option[Bool]
  match self when JsonValue::Bool(b) then Option::Some(b) when _ then Option::None end
end

def JsonValue::as_number(self: JsonValue) -> Option[f64]
  match self when JsonValue::Number(n) then Option::Some(n) when _ then Option::None end
end

def JsonValue::as_string(self: JsonValue) -> Option[String]
  match self when JsonValue::String(s) then Option::Some(s.clone()) when _ then Option::None end
end

def JsonValue::as_array(self: JsonValue) -> Option[Vec[JsonValue]]
  match self
  when JsonValue::Array(a) then
    var out = Vec::new()
    for item in a do out.push(item.clone()) end
    Option::Some(out)
  when _ then Option::None
  end
end

def JsonValue::as_object(self: JsonValue) -> Option[HashMap[String, JsonValue]]
  match self when JsonValue::Object(o) then Option::Some(o.clone()) when _ then Option::None end
end

def JsonValue::get(self: JsonValue, key: String) -> Option[JsonValue]
  match self
  when JsonValue::Object(obj) then
    match obj.get_cloned(key)
    when Option::Some(v) then Option::Some(v)
    when Option::None then Option::None
    end
  when _ then Option::None
  end
end

def JsonValue::index(self: JsonValue, idx: UInt) -> Option[JsonValue]
  match self
  when JsonValue::Array(arr) then
    if idx < arr.len() then Option::Some(arr[idx].clone()) else Option::None end
  when _ then Option::None
  end
end

# ═══════════════════════════════════════════════════════════════
# Base64 Encoding/Decoding
# ═══════════════════════════════════════════════════════════════

def BASE64_CHARS() -> String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

def base64_encode(data: [u8]) -> String
  let chars = BASE64_CHARS()
  mut result = ""
  mut i = 0
  
  while i < data.len() do
    let b0 = data[i] as u32
    i = i + 1
    
    if i < data.len() then
      let b1 = data[i] as u32
      i = i + 1
      
      if i < data.len() then
        let b2 = data[i] as u32
        i = i + 1
        
        let n = (b0 << 16) | (b1 << 8) | b2
        result = result + chars[((n >> 18) & 0x3F) as UInt].to_string()
        result = result + chars[((n >> 12) & 0x3F) as UInt].to_string()
        result = result + chars[((n >> 6) & 0x3F) as UInt].to_string()
        result = result + chars[(n & 0x3F) as UInt].to_string()
      else
        let n = (b0 << 16) | (b1 << 8)
        result = result + chars[((n >> 18) & 0x3F) as UInt].to_string()
        result = result + chars[((n >> 12) & 0x3F) as UInt].to_string()
        result = result + chars[((n >> 6) & 0x3F) as UInt].to_string()
        result = result + "="
      end
    else
      let n = b0 << 16
      result = result + chars[((n >> 18) & 0x3F) as UInt].to_string()
      result = result + chars[((n >> 12) & 0x3F) as UInt].to_string()
      result = result + "=="
    end
  end
  
  result
end

def base64_decode(data: String) -> Result[Vec[u8], String]
  let chars = BASE64_CHARS()
  mut result = Vec::new()
  mut buffer = 0u32
  mut bits = 0
  
  for c in data.chars() do
    if c == '=' then
      break
    end
    
    let idx = chars.find(c)
    match idx
    when Option::Some(pos) then
      buffer = (buffer << 6) | (pos as u32)
      bits = bits + 6
      
      if bits >= 8 then
        bits = bits - 8
        result.push(((buffer >> bits) & 0xFF) as u8)
      end
    when Option::None then
      if c != '\n' && c != '\r' && c != ' ' then
        return Result::Err("Invalid base64 character: " + c.to_string())
      end
    end
  end
  
  Result::Ok(result)
end

# ═══════════════════════════════════════════════════════════════
# MessagePack Serializer (Binary Format)
# ═══════════════════════════════════════════════════════════════

struct MessagePackSerializer
  output: Vec[u8]
end

def MessagePackSerializer::new() -> MessagePackSerializer
  MessagePackSerializer { output: Vec::new() }
end

def MessagePackSerializer::write_byte(inout self: MessagePackSerializer, b: u8) -> Unit
  self.output.push(b)
end

def MessagePackSerializer::write_bytes(inout self: MessagePackSerializer, bytes: [u8]) -> Unit
  for b in bytes do
    self.output.push(*b)
  end
end

impl Serializer for MessagePackSerializer
  def serialize_bool(inout self: MessagePackSerializer, v: Bool) -> Result[Unit, String]
    self.write_byte(if v then 0xC3 else 0xC2 end)
    Result::Ok(())
  end
  
  def serialize_i8(inout self: MessagePackSerializer, v: i8) -> Result[Unit, String]
    if v >= 0 then
      self.write_byte(v as u8)
    else if v >= -31 then
      self.write_byte(0xE0 | ((v + 32) as u8))
    else
      self.write_byte(0xD0)
      self.write_byte(v as u8)
    end
    Result::Ok(())
  end
  
  def serialize_i16(inout self: MessagePackSerializer, v: i16) -> Result[Unit, String]
    if v >= -32768 && v <= 32767 then
      self.write_byte(0xD1)
      self.write_byte(((v >> 8) & 0xFF) as u8)
      self.write_byte((v & 0xFF) as u8)
    else
      self.serialize_i32(v as i32)
    end
    Result::Ok(())
  end
  
  def serialize_i32(inout self: MessagePackSerializer, v: i32) -> Result[Unit, String]
    self.write_byte(0xD2)
    self.write_byte(((v >> 24) & 0xFF) as u8)
    self.write_byte(((v >> 16) & 0xFF) as u8)
    self.write_byte(((v >> 8) & 0xFF) as u8)
    self.write_byte((v & 0xFF) as u8)
    Result::Ok(())
  end
  
  def serialize_i64(inout self: MessagePackSerializer, v: i64) -> Result[Unit, String]
    self.write_byte(0xD3)
    self.write_byte(((v >> 56) & 0xFF) as u8)
    self.write_byte(((v >> 48) & 0xFF) as u8)
    self.write_byte(((v >> 40) & 0xFF) as u8)
    self.write_byte(((v >> 32) & 0xFF) as u8)
    self.write_byte(((v >> 24) & 0xFF) as u8)
    self.write_byte(((v >> 16) & 0xFF) as u8)
    self.write_byte(((v >> 8) & 0xFF) as u8)
    self.write_byte((v & 0xFF) as u8)
    Result::Ok(())
  end
  
  def serialize_u8(inout self: MessagePackSerializer, v: u8) -> Result[Unit, String]
    self.write_byte(v)
    Result::Ok(())
  end
  
  def serialize_u16(inout self: MessagePackSerializer, v: u16) -> Result[Unit, String]
    self.write_byte(0xCD)
    self.write_byte(((v >> 8) & 0xFF) as u8)
    self.write_byte((v & 0xFF) as u8)
    Result::Ok(())
  end
  
  def serialize_u32(inout self: MessagePackSerializer, v: u32) -> Result[Unit, String]
    self.write_byte(0xCE)
    self.write_byte(((v >> 24) & 0xFF) as u8)
    self.write_byte(((v >> 16) & 0xFF) as u8)
    self.write_byte(((v >> 8) & 0xFF) as u8)
    self.write_byte((v & 0xFF) as u8)
    Result::Ok(())
  end
  
  def serialize_u64(inout self: MessagePackSerializer, v: u64) -> Result[Unit, String]
    self.write_byte(0xCF)
    self.write_byte(((v >> 56) & 0xFF) as u8)
    self.write_byte(((v >> 48) & 0xFF) as u8)
    self.write_byte(((v >> 40) & 0xFF) as u8)
    self.write_byte(((v >> 32) & 0xFF) as u8)
    self.write_byte(((v >> 24) & 0xFF) as u8)
    self.write_byte(((v >> 16) & 0xFF) as u8)
    self.write_byte(((v >> 8) & 0xFF) as u8)
    self.write_byte((v & 0xFF) as u8)
    Result::Ok(())
  end
  
  def serialize_f32(inout self: MessagePackSerializer, v: f32) -> Result[Unit, String]
    self.write_byte(0xCA)
    let bits = v as u32
    self.write_byte(((bits >> 24) & 0xFF) as u8)
    self.write_byte(((bits >> 16) & 0xFF) as u8)
    self.write_byte(((bits >> 8) & 0xFF) as u8)
    self.write_byte((bits & 0xFF) as u8)
    Result::Ok(())
  end
  
  def serialize_f64(inout self: MessagePackSerializer, v: f64) -> Result[Unit, String]
    self.write_byte(0xCB)
    let bits = v as u64
    self.write_byte(((bits >> 56) & 0xFF) as u8)
    self.write_byte(((bits >> 48) & 0xFF) as u8)
    self.write_byte(((bits >> 40) & 0xFF) as u8)
    self.write_byte(((bits >> 32) & 0xFF) as u8)
    self.write_byte(((bits >> 24) & 0xFF) as u8)
    self.write_byte(((bits >> 16) & 0xFF) as u8)
    self.write_byte(((bits >> 8) & 0xFF) as u8)
    self.write_byte((bits & 0xFF) as u8)
    Result::Ok(())
  end
  
  def serialize_char(inout self: MessagePackSerializer, v: char) -> Result[Unit, String]
    let s = v.to_string()
    self.serialize_str(&s)
  end
  
  def serialize_str(inout self: MessagePackSerializer, v: String) -> Result[Unit, String]
    let len = v.len()
    if len < 32 then
      self.write_byte(0xA0 | (len as u8))
    else if len < 256 then
      self.write_byte(0xD9)
      self.write_byte(len as u8)
    else if len < 65536 then
      self.write_byte(0xDA)
      self.write_byte(((len >> 8) & 0xFF) as u8)
      self.write_byte((len & 0xFF) as u8)
    else
      self.write_byte(0xDB)
      self.write_byte(((len >> 24) & 0xFF) as u8)
      self.write_byte(((len >> 16) & 0xFF) as u8)
      self.write_byte(((len >> 8) & 0xFF) as u8)
      self.write_byte((len & 0xFF) as u8)
    end
    self.write_bytes(v.as_bytes())
    Result::Ok(())
  end
  
  def serialize_bytes(inout self: MessagePackSerializer, v: [u8]) -> Result[Unit, String]
    let len = v.len()
    if len < 256 then
      self.write_byte(0xC4)
      self.write_byte(len as u8)
    else if len < 65536 then
      self.write_byte(0xC5)
      self.write_byte(((len >> 8) & 0xFF) as u8)
      self.write_byte((len & 0xFF) as u8)
    else
      self.write_byte(0xC6)
      self.write_byte(((len >> 24) & 0xFF) as u8)
      self.write_byte(((len >> 16) & 0xFF) as u8)
      self.write_byte(((len >> 8) & 0xFF) as u8)
      self.write_byte((len & 0xFF) as u8)
    end
    self.write_bytes(v)
    Result::Ok(())
  end
  
  def serialize_none(inout self: MessagePackSerializer) -> Result[Unit, String]
    self.write_byte(0xC0)
    Result::Ok(())
  end
  
  def serialize_some[T: Serialize](inout self: MessagePackSerializer, v: T) -> Result[Unit, String]
    v.serialize(self)
  end
  
  def serialize_unit(inout self: MessagePackSerializer) -> Result[Unit, String]
    self.write_byte(0xC0)
    Result::Ok(())
  end
  
  def serialize_seq_start(inout self: MessagePackSerializer, len: Option[UInt]) -> Result[Unit, String]
    let n = match len when Option::Some(l) then l when Option::None then 0 end
    if n < 16 then
      self.write_byte(0x90 | (n as u8))
    else if n < 65536 then
      self.write_byte(0xDC)
      self.write_byte(((n >> 8) & 0xFF) as u8)
      self.write_byte((n & 0xFF) as u8)
    else
      self.write_byte(0xDD)
      self.write_byte(((n >> 24) & 0xFF) as u8)
      self.write_byte(((n >> 16) & 0xFF) as u8)
      self.write_byte(((n >> 8) & 0xFF) as u8)
      self.write_byte((n & 0xFF) as u8)
    end
    Result::Ok(())
  end
  
  def serialize_seq_elem[T: Serialize](inout self: MessagePackSerializer, v: T) -> Result[Unit, String]
    v.serialize(self)
  end
  
  def serialize_seq_end(inout self: MessagePackSerializer) -> Result[Unit, String]
    Result::Ok(())
  end
  
  def serialize_map_start(inout self: MessagePackSerializer, len: Option[UInt]) -> Result[Unit, String]
    let n = match len when Option::Some(l) then l when Option::None then 0 end
    if n < 16 then
      self.write_byte(0x80 | (n as u8))
    else if n < 65536 then
      self.write_byte(0xDE)
      self.write_byte(((n >> 8) & 0xFF) as u8)
      self.write_byte((n & 0xFF) as u8)
    else
      self.write_byte(0xDF)
      self.write_byte(((n >> 24) & 0xFF) as u8)
      self.write_byte(((n >> 16) & 0xFF) as u8)
      self.write_byte(((n >> 8) & 0xFF) as u8)
      self.write_byte((n & 0xFF) as u8)
    end
    Result::Ok(())
  end
  
  def serialize_map_key[K: Serialize](inout self: MessagePackSerializer, k: K) -> Result[Unit, String]
    k.serialize(self)
  end
  
  def serialize_map_value[V: Serialize](inout self: MessagePackSerializer, v: V) -> Result[Unit, String]
    v.serialize(self)
  end
  
  def serialize_map_end(inout self: MessagePackSerializer) -> Result[Unit, String]
    Result::Ok(())
  end
end

def MessagePackSerializer::output(self: MessagePackSerializer) -> Vec[u8]
  self.output.clone()
end

# ═══════════════════════════════════════════════════════════════
# Serialize Implementations for Primitives
# ═══════════════════════════════════════════════════════════════

impl Serialize for Bool
  def serialize[S: Serializer](self: Bool, inout ser: S) -> Result[Unit, String]
    ser.serialize_bool(self)
  end
end

impl Serialize for i32
  def serialize[S: Serializer](self: i32, inout ser: S) -> Result[Unit, String]
    ser.serialize_i32(self)
  end
end

impl Serialize for i64
  def serialize[S: Serializer](self: i64, inout ser: S) -> Result[Unit, String]
    ser.serialize_i64(self)
  end
end

impl Serialize for u32
  def serialize[S: Serializer](self: u32, inout ser: S) -> Result[Unit, String]
    ser.serialize_u32(self)
  end
end

impl Serialize for u64
  def serialize[S: Serializer](self: u64, inout ser: S) -> Result[Unit, String]
    ser.serialize_u64(self)
  end
end

impl Serialize for f64
  def serialize[S: Serializer](self: f64, inout ser: S) -> Result[Unit, String]
    ser.serialize_f64(self)
  end
end

impl Serialize for String
  def serialize[S: Serializer](self: String, inout ser: S) -> Result[Unit, String]
    ser.serialize_str(self)
  end
end

impl[T: Serialize] Serialize for Vec[T]
  def serialize[S: Serializer](self: Vec[T], inout ser: S) -> Result[Unit, String]
    ser.serialize_seq_start(Option::Some(self.len()))?
    for item in self do
      ser.serialize_seq_elem(item)?
    end
    ser.serialize_seq_end()
  end
end

impl[T: Serialize] Serialize for Option[T]
  def serialize[S: Serializer](self: Option[T], inout ser: S) -> Result[Unit, String]
    match self
    when Option::Some(v) then ser.serialize_some(v)
    when Option::None then ser.serialize_none()
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Deserialize Implementations for Primitives
# ═══════════════════════════════════════════════════════════════

impl Deserialize for Bool
  def deserialize[D: Deserializer](inout de: D) -> Result[Bool, String]
    de.deserialize_bool()
  end
end

impl Deserialize for i32
  def deserialize[D: Deserializer](inout de: D) -> Result[i32, String]
    de.deserialize_i32()
  end
end

impl Deserialize for i64
  def deserialize[D: Deserializer](inout de: D) -> Result[i64, String]
    de.deserialize_i64()
  end
end

impl Deserialize for u32
  def deserialize[D: Deserializer](inout de: D) -> Result[u32, String]
    de.deserialize_u32()
  end
end

impl Deserialize for u64
  def deserialize[D: Deserializer](inout de: D) -> Result[u64, String]
    de.deserialize_u64()
  end
end

impl Deserialize for f64
  def deserialize[D: Deserializer](inout de: D) -> Result[f64, String]
    de.deserialize_f64()
  end
end

impl Deserialize for String
  def deserialize[D: Deserializer](inout de: D) -> Result[String, String]
    de.deserialize_str()
  end
end

impl[T: Deserialize] Deserialize for Vec[T]
  def deserialize[D: Deserializer](inout de: D) -> Result[Vec[T], String]
    de.deserialize_seq::<T>()
  end
end

impl[T: Deserialize] Deserialize for Option[T]
  def deserialize[D: Deserializer](inout de: D) -> Result[Option[T], String]
    de.deserialize_option::<T>()
  end
end