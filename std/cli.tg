# Tangerine Standard Library — CLI Foundation
#
# Command-line argument parsing, terminal handling, and configuration.
#
# Usage:
#   let app = cli::App::new("myapp", "My application")
#     .version("1.0.0")
#     .arg(Arg::new("input").required(true).help("Input file"))
#     .flag(Flag::new("verbose").short('v').help("Verbose output"))
#   
#   let matches = app.parse()?
#   let input = matches.get_string("input")?

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{Map}
use std::env

# ———————————————————————————————————————————————————————————————
# CLI Application
# ———————————————————————————————————————————————————————————————

struct App
  name: String
  description: String
  version: Option[String]
  author: Option[String]
  args: Vec[Arg]
  flags: Vec[Flag]
  subcommands: Vec[Subcommand]
  help_flag: Bool
  version_flag: Bool
end

def App::new(name: &str, description: &str) -> App
  App {
    name: name.to_string(),
    description: description.to_string(),
    version: Option::None,
    author: Option::None,
    args: Vec::new(),
    flags: Vec::new(),
    subcommands: Vec::new(),
    help_flag: true,
    version_flag: true
  }
end

impl App
  def version(self: &mut App, v: &str) -> &mut App
    self.version = Option::Some(v.to_string())
    self
  end
  
  def author(self: &mut App, a: &str) -> &mut App
    self.author = Option::Some(a.to_string())
    self
  end
  
  def arg(self: &mut App, arg: Arg) -> &mut App
    self.args.push(arg)
    self
  end
  
  def flag(self: &mut App, flag: Flag) -> &mut App
    self.flags.push(flag)
    self
  end
  
  def subcommand(self: &mut App, cmd: Subcommand) -> &mut App
    self.subcommands.push(cmd)
    self
  end
  
  def disable_help(self: &mut App) -> &mut App
    self.help_flag = false
    self
  end
  
  def disable_version(self: &mut App) -> &mut App
    self.version_flag = false
    self
  end
  
  def parse(self: &App) -> Result[Matches, CliError]
    self.parse_from(&env::args())
  end
  
  def parse_from(self: &App, args: &[String]) -> Result[Matches, CliError]
    let mut matches = Matches::new()
    let mut positional_idx = 0
    let mut i = 1  # Skip program name
    
    while i < args.len() do
      let arg = &args[i]
      
      if arg == "--help" || arg == "-h" then
        if self.help_flag then
          self.print_help()
          return Result::Err(CliError::HelpDisplayed)
        end
      elsif arg == "--version" || arg == "-V" then
        if self.version_flag then
          self.print_version()
          return Result::Err(CliError::VersionDisplayed)
        end
      elsif arg.starts_with("--") then
        # Long flag/option
        let name = arg.slice(2, arg.len())
        
        # Check for --flag=value
        match name.find('=')
        when Option::Some(eq_pos) then
          let flag_name = name.slice(0, eq_pos)
          let value = name.slice(eq_pos + 1, name.len())
          
          match self.find_flag(&flag_name)
          when Option::Some(flag) then
            if !flag.takes_value then
              return Result::Err(CliError::UnexpectedValue(flag_name.to_string()))
            end
            matches.options.insert(flag.name.clone(), value.to_string())
          when Option::None then
            return Result::Err(CliError::UnknownFlag(flag_name.to_string()))
          end
        when Option::None then
          match self.find_flag(&name)
          when Option::Some(flag) then
            if flag.takes_value then
              i = i + 1
              if i >= args.len() then
                return Result::Err(CliError::MissingValue(name.to_string()))
              end
              matches.options.insert(flag.name.clone(), args[i].clone())
            else
              matches.flags.insert(flag.name.clone(), true)
            end
          when Option::None then
            return Result::Err(CliError::UnknownFlag(name.to_string()))
          end
        end
      elsif arg.starts_with("-") && arg.len() > 1 then
        # Short flag(s)
        let chars = arg.slice(1, arg.len())
        for j in 0..chars.len() do
          let c = chars.char_at(j)
          match self.find_flag_by_short(c)
          when Option::Some(flag) then
            if flag.takes_value then
              if j < chars.len() - 1 then
                # Value is rest of string
                let value = chars.slice(j + 1, chars.len())
                matches.options.insert(flag.name.clone(), value.to_string())
                break
              else
                # Value is next argument
                i = i + 1
                if i >= args.len() then
                  return Result::Err(CliError::MissingValue(flag.name.clone()))
                end
                matches.options.insert(flag.name.clone(), args[i].clone())
              end
            else
              matches.flags.insert(flag.name.clone(), true)
            end
          when Option::None then
            return Result::Err(CliError::UnknownFlag(c.to_string()))
          end
        end
      else
        # Check for subcommand
        if !self.subcommands.is_empty() && positional_idx == 0 then
          match self.find_subcommand(arg)
          when Option::Some(cmd) then
            matches.subcommand = Option::Some(cmd.name.clone())
            let sub_args = args[i..].to_vec()
            matches.subcommand_matches = Option::Some(Box::new(cmd.app.parse_from(&sub_args)?))
            return Result::Ok(matches)
          when Option::None then ()
          end
        end
        
        # Positional argument
        if positional_idx < self.args.len() then
          let pos_arg = &self.args[positional_idx]
          if pos_arg.multiple then
            let mut values = Vec::new()
            while i < args.len() && !args[i].starts_with("-") do
              values.push(args[i].clone())
              i = i + 1
            end
            matches.positional_multi.insert(pos_arg.name.clone(), values)
            i = i - 1  # Adjust for outer loop increment
          else
            matches.positional.insert(pos_arg.name.clone(), arg.clone())
          end
          positional_idx = positional_idx + 1
        else
          return Result::Err(CliError::UnexpectedArg(arg.clone()))
        end
      end
      
      i = i + 1
    end
    
    # Check required arguments
    for arg in &self.args do
      if arg.required && !matches.positional.contains_key(&arg.name) &&
         !matches.positional_multi.contains_key(&arg.name) then
        return Result::Err(CliError::MissingArg(arg.name.clone()))
      end
    end
    
    # Check required flags
    for flag in &self.flags do
      if flag.required && flag.takes_value && !matches.options.contains_key(&flag.name) then
        return Result::Err(CliError::MissingFlag(flag.name.clone()))
      end
    end
    
    Result::Ok(matches)
  end
  
  def find_flag(self: &App, name: &str) -> Option[&Flag]
    for flag in &self.flags do
      if flag.name == name || flag.long.as_ref().map(|l| l.as_str()) == Option::Some(name) then
        return Option::Some(&flag)
      end
    end
    Option::None
  end
  
  def find_flag_by_short(self: &App, c: char) -> Option[&Flag]
    for flag in &self.flags do
      if flag.short == Option::Some(c) then
        return Option::Some(&flag)
      end
    end
    Option::None
  end
  
  def find_subcommand(self: &App, name: &str) -> Option[&Subcommand]
    for cmd in &self.subcommands do
      if cmd.name == name then
        return Option::Some(&cmd)
      end
    end
    Option::None
  end
  
  def print_help(self: &App) -> Unit
    let mut output = String::new()
    
    # Name and description
    output.push_str(self.name.as_str())
    match self.version
    when Option::Some(v) then
      output.push(' ')
      output.push_str(v.as_str())
    when Option::None then ()
    end
    output.push('\n')
    output.push_str(self.description.as_str())
    output.push_str("\n\n")
    
    # Usage
    output.push_str("USAGE:\n    ")
    output.push_str(self.name.as_str())
    if !self.flags.is_empty() then
      output.push_str(" [OPTIONS]")
    end
    if !self.subcommands.is_empty() then
      output.push_str(" <COMMAND>")
    end
    for arg in &self.args do
      output.push(' ')
      if arg.required then
        output.push('<')
        output.push_str(arg.name.as_str())
        output.push('>')
      else
        output.push('[')
        output.push_str(arg.name.as_str())
        output.push(']')
      end
      if arg.multiple then
        output.push_str("...")
      end
    end
    output.push_str("\n\n")
    
    # Arguments
    if !self.args.is_empty() then
      output.push_str("ARGS:\n")
      for arg in &self.args do
        output.push_str("    <")
        output.push_str(arg.name.as_str())
        output.push('>')
        match arg.help
        when Option::Some(h) then
          output.push_str("    ")
          output.push_str(h.as_str())
        when Option::None then ()
        end
        output.push('\n')
      end
      output.push('\n')
    end
    
    # Options
    if !self.flags.is_empty() then
      output.push_str("OPTIONS:\n")
      for flag in &self.flags do
        output.push_str("    ")
        match flag.short
        when Option::Some(c) then
          output.push('-')
          output.push(c)
          output.push_str(", ")
        when Option::None then
          output.push_str("    ")
        end
        output.push_str("--")
        match flag.long
        when Option::Some(l) then output.push_str(l.as_str())
        when Option::None then output.push_str(flag.name.as_str())
        end
        if flag.takes_value then
          output.push_str(" <")
          output.push_str(flag.value_name.as_ref().unwrap_or(&flag.name).as_str())
          output.push('>')
        end
        match flag.help
        when Option::Some(h) then
          output.push_str("    ")
          output.push_str(h.as_str())
        when Option::None then ()
        end
        output.push('\n')
      end
      output.push('\n')
    end
    
    # Subcommands
    if !self.subcommands.is_empty() then
      output.push_str("COMMANDS:\n")
      for cmd in &self.subcommands do
        output.push_str("    ")
        output.push_str(cmd.name.as_str())
        match cmd.help
        when Option::Some(h) then
          output.push_str("    ")
          output.push_str(h.as_str())
        when Option::None then ()
        end
        output.push('\n')
      end
    end
    
    std::io::stdout().write_all(output.as_bytes())
  end
  
  def print_version(self: &App) -> Unit
    let mut output = String::new()
    output.push_str(self.name.as_str())
    output.push(' ')
    match self.version
    when Option::Some(v) then output.push_str(v.as_str())
    when Option::None then output.push_str("0.0.0")
    end
    output.push('\n')
    std::io::stdout().write_all(output.as_bytes())
  end
end

# ———————————————————————————————————————————————————————————————
# Argument
# ———————————————————————————————————————————————————————————————

struct Arg
  name: String
  help: Option[String]
  required: Bool
  multiple: Bool
  default: Option[String]
end

def Arg::new(name: &str) -> Arg
  Arg {
    name: name.to_string(),
    help: Option::None,
    required: false,
    multiple: false,
    default: Option::None
  }
end

impl Arg
  def help(self: &mut Arg, h: &str) -> &mut Arg
    self.help = Option::Some(h.to_string())
    self
  end
  
  def required(self: &mut Arg, r: Bool) -> &mut Arg
    self.required = r
    self
  end
  
  def multiple(self: &mut Arg, m: Bool) -> &mut Arg
    self.multiple = m
    self
  end
  
  def default_value(self: &mut Arg, v: &str) -> &mut Arg
    self.default = Option::Some(v.to_string())
    self
  end
end

# ———————————————————————————————————————————————————————————————
# Flag
# ———————————————————————————————————————————————————————————————

struct Flag
  name: String
  short: Option[char]
  long: Option[String]
  help: Option[String]
  takes_value: Bool
  value_name: Option[String]
  required: Bool
  default: Option[String]
  env_var: Option[String]
end

def Flag::new(name: &str) -> Flag
  Flag {
    name: name.to_string(),
    short: Option::None,
    long: Option::Some(name.to_string()),
    help: Option::None,
    takes_value: false,
    value_name: Option::None,
    required: false,
    default: Option::None,
    env_var: Option::None
  }
end

impl Flag
  def short(self: &mut Flag, c: char) -> &mut Flag
    self.short = Option::Some(c)
    self
  end
  
  def long(self: &mut Flag, l: &str) -> &mut Flag
    self.long = Option::Some(l.to_string())
    self
  end
  
  def help(self: &mut Flag, h: &str) -> &mut Flag
    self.help = Option::Some(h.to_string())
    self
  end
  
  def takes_value(self: &mut Flag) -> &mut Flag
    self.takes_value = true
    self
  end
  
  def value_name(self: &mut Flag, n: &str) -> &mut Flag
    self.value_name = Option::Some(n.to_string())
    self
  end
  
  def required(self: &mut Flag, r: Bool) -> &mut Flag
    self.required = r
    self
  end
  
  def default_value(self: &mut Flag, v: &str) -> &mut Flag
    self.default = Option::Some(v.to_string())
    self
  end
  
  def env(self: &mut Flag, var: &str) -> &mut Flag
    self.env_var = Option::Some(var.to_string())
    self
  end
end

# ———————————————————————————————————————————————————————————————
# Subcommand
# ———————————————————————————————————————————————————————————————

struct Subcommand
  name: String
  help: Option[String]
  app: App
end

def Subcommand::new(name: &str, app: App) -> Subcommand
  Subcommand {
    name: name.to_string(),
    help: Option::None,
    app: app
  }
end

impl Subcommand
  def help(self: &mut Subcommand, h: &str) -> &mut Subcommand
    self.help = Option::Some(h.to_string())
    self
  end
end

# ———————————————————————————————————————————————————————————————
# Matches
# ———————————————————————————————————————————————————————————————

struct Matches
  flags: Map[String, Bool]
  options: Map[String, String]
  positional: Map[String, String]
  positional_multi: Map[String, Vec[String]]
  subcommand: Option[String]
  subcommand_matches: Option[Box[Matches]]
end

def Matches::new() -> Matches
  Matches {
    flags: Map::new(),
    options: Map::new(),
    positional: Map::new(),
    positional_multi: Map::new(),
    subcommand: Option::None,
    subcommand_matches: Option::None
  }
end

impl Matches
  def is_present(self: &Matches, name: &str) -> Bool
    self.flags.get(name) == Option::Some(&true) ||
    self.options.contains_key(name) ||
    self.positional.contains_key(name)
  end
  
  def get_string(self: &Matches, name: &str) -> Option[&String]
    match self.options.get(name)
    when Option::Some(v) then return Option::Some(v)
    when Option::None then ()
    end
    match self.positional.get(name)
    when Option::Some(v) then return Option::Some(v)
    when Option::None then ()
    end
    Option::None
  end
  
  def get_strings(self: &Matches, name: &str) -> Option[&Vec[String]]
    self.positional_multi.get(name)
  end
  
  def get_int(self: &Matches, name: &str) -> Option[Int]
    match self.get_string(name)
    when Option::Some(s) then s.parse_int()
    when Option::None then Option::None
    end
  end
  
  def get_bool(self: &Matches, name: &str) -> Bool
    match self.flags.get(name)
    when Option::Some(v) then *v
    when Option::None then false
    end
  end
  
  def subcommand(self: &Matches) -> Option[(&String, &Matches)]
    match self.subcommand
    when Option::Some(name) then
      match self.subcommand_matches
      when Option::Some(m) then Option::Some((&name, m.as_ref()))
      when Option::None then Option::None
      end
    when Option::None then Option::None
    end
  end
end

# ———————————————————————————————————————————————————————————————
# CLI Error
# ———————————————————————————————————————————————————————————————

enum CliError
  HelpDisplayed
  VersionDisplayed
  UnknownFlag(String)
  UnexpectedValue(String)
  MissingValue(String)
  MissingArg(String)
  MissingFlag(String)
  UnexpectedArg(String)
  InvalidValue(String, String)
  Io(String)
end

def cli_error_message(e: &CliError) -> String
  match e
  when CliError::HelpDisplayed then "help displayed"
  when CliError::VersionDisplayed then "version displayed"
  when CliError::UnknownFlag(f) then "unknown flag: --" + f.clone()
  when CliError::UnexpectedValue(f) then "flag --" + f.clone() + " does not take a value"
  when CliError::MissingValue(f) then "flag --" + f.clone() + " requires a value"
  when CliError::MissingArg(a) then "missing required argument: " + a.clone()
  when CliError::MissingFlag(f) then "missing required flag: --" + f.clone()
  when CliError::UnexpectedArg(a) then "unexpected argument: " + a.clone()
  when CliError::InvalidValue(n, m) then "invalid value for " + n.clone() + ": " + m.clone()
  when CliError::Io(e) then "IO error: " + e.clone()
  end
end

# ———————————————————————————————————————————————————————————————
# Terminal — ANSI Colors and Styling
# ———————————————————————————————————————————————————————————————

module term
  # Check if stdout is a terminal
  extern "C"
    def isatty(fd: Int) -> Int
  end
  
  def is_terminal() -> Bool
    isatty(1) != 0
  end
  
  # ANSI escape codes
  const RESET: &str = "\x1b[0m"
  const BOLD: &str = "\x1b[1m"
  const DIM: &str = "\x1b[2m"
  const ITALIC: &str = "\x1b[3m"
  const UNDERLINE: &str = "\x1b[4m"
  const BLINK: &str = "\x1b[5m"
  const REVERSE: &str = "\x1b[7m"
  const HIDDEN: &str = "\x1b[8m"
  const STRIKETHROUGH: &str = "\x1b[9m"
  
  # Foreground colors
  const BLACK: &str = "\x1b[30m"
  const RED: &str = "\x1b[31m"
  const GREEN: &str = "\x1b[32m"
  const YELLOW: &str = "\x1b[33m"
  const BLUE: &str = "\x1b[34m"
  const MAGENTA: &str = "\x1b[35m"
  const CYAN: &str = "\x1b[36m"
  const WHITE: &str = "\x1b[37m"
  const DEFAULT: &str = "\x1b[39m"
  
  # Bright foreground colors
  const BRIGHT_BLACK: &str = "\x1b[90m"
  const BRIGHT_RED: &str = "\x1b[91m"
  const BRIGHT_GREEN: &str = "\x1b[92m"
  const BRIGHT_YELLOW: &str = "\x1b[93m"
  const BRIGHT_BLUE: &str = "\x1b[94m"
  const BRIGHT_MAGENTA: &str = "\x1b[95m"
  const BRIGHT_CYAN: &str = "\x1b[96m"
  const BRIGHT_WHITE: &str = "\x1b[97m"
  
  # Background colors
  const BG_BLACK: &str = "\x1b[40m"
  const BG_RED: &str = "\x1b[41m"
  const BG_GREEN: &str = "\x1b[42m"
  const BG_YELLOW: &str = "\x1b[43m"
  const BG_BLUE: &str = "\x1b[44m"
  const BG_MAGENTA: &str = "\x1b[45m"
  const BG_CYAN: &str = "\x1b[46m"
  const BG_WHITE: &str = "\x1b[47m"
  const BG_DEFAULT: &str = "\x1b[49m"
  
  # Styled text helper
  struct Style
    text: String
    codes: Vec[String]
  end
  
  def style(text: &str) -> Style
    Style {
      text: text.to_string(),
      codes: Vec::new()
    }
  end
  
  impl Style
    def bold(self: &mut Style) -> &mut Style
      self.codes.push(BOLD.to_string())
      self
    end
    
    def dim(self: &mut Style) -> &mut Style
      self.codes.push(DIM.to_string())
      self
    end
    
    def italic(self: &mut Style) -> &mut Style
      self.codes.push(ITALIC.to_string())
      self
    end
    
    def underline(self: &mut Style) -> &mut Style
      self.codes.push(UNDERLINE.to_string())
      self
    end
    
    def red(self: &mut Style) -> &mut Style
      self.codes.push(RED.to_string())
      self
    end
    
    def green(self: &mut Style) -> &mut Style
      self.codes.push(GREEN.to_string())
      self
    end
    
    def yellow(self: &mut Style) -> &mut Style
      self.codes.push(YELLOW.to_string())
      self
    end
    
    def blue(self: &mut Style) -> &mut Style
      self.codes.push(BLUE.to_string())
      self
    end
    
    def magenta(self: &mut Style) -> &mut Style
      self.codes.push(MAGENTA.to_string())
      self
    end
    
    def cyan(self: &mut Style) -> &mut Style
      self.codes.push(CYAN.to_string())
      self
    end
    
    def white(self: &mut Style) -> &mut Style
      self.codes.push(WHITE.to_string())
      self
    end
    
    def fg_rgb(self: &mut Style, r: u8, g: u8, b: u8) -> &mut Style
      self.codes.push(format!("\x1b[38;2;{};{};{}m", r, g, b))
      self
    end
    
    def bg_rgb(self: &mut Style, r: u8, g: u8, b: u8) -> &mut Style
      self.codes.push(format!("\x1b[48;2;{};{};{}m", r, g, b))
      self
    end
    
    def to_string(self: &Style) -> String
      if !is_terminal() || self.codes.is_empty() then
        return self.text.clone()
      end
      
      let mut result = String::new()
      for code in &self.codes do
        result.push_str(code.as_str())
      end
      result.push_str(self.text.as_str())
      result.push_str(RESET)
      result
    end
  end
  
  # Cursor control
  def move_up(n: UInt) -> Unit
    print(format!("\x1b[{}A", n))
  end
  
  def move_down(n: UInt) -> Unit
    print(format!("\x1b[{}B", n))
  end
  
  def move_right(n: UInt) -> Unit
    print(format!("\x1b[{}C", n))
  end
  
  def move_left(n: UInt) -> Unit
    print(format!("\x1b[{}D", n))
  end
  
  def move_to(row: UInt, col: UInt) -> Unit
    print(format!("\x1b[{};{}H", row, col))
  end
  
  def save_cursor() -> Unit
    print("\x1b[s")
  end
  
  def restore_cursor() -> Unit
    print("\x1b[u")
  end
  
  def hide_cursor() -> Unit
    print("\x1b[?25l")
  end
  
  def show_cursor() -> Unit
    print("\x1b[?25h")
  end
  
  # Screen control
  def clear_screen() -> Unit
    print("\x1b[2J")
    move_to(1, 1)
  end
  
  def clear_line() -> Unit
    print("\x1b[2K")
  end
  
  def clear_to_end() -> Unit
    print("\x1b[K")
  end
  
  # Terminal size
  extern "C"
    struct Winsize
      ws_row: u16
      ws_col: u16
      ws_xpixel: u16
      ws_ypixel: u16
    end
    
    def ioctl(fd: Int, request: UInt, arg: &mut Winsize) -> Int
  end
  
  #[cfg(target_os = "linux")]
  const TIOCGWINSZ: UInt = 0x5413
  #[cfg(target_os = "macos")]
  const TIOCGWINSZ: UInt = 0x40087468
  
  def size() -> (UInt, UInt)
    let mut ws = Winsize {
      ws_row: 0,
      ws_col: 0,
      ws_xpixel: 0,
      ws_ypixel: 0
    }
    
    if ioctl(1, TIOCGWINSZ, &mut ws) == 0 then
      (ws.ws_col as UInt, ws.ws_row as UInt)
    else
      (80, 24)  # Default
    end
  end
  
  def width() -> UInt
    let (w, _) = size()
    w
  end
  
  def height() -> UInt
    let (_, h) = size()
    h
  end
end

# ———————————————————————————————————————————————————————————————
# Progress Bar
# ———————————————————————————————————————————————————————————————

struct ProgressBar
  total: UInt
  current: UInt
  width: UInt
  message: String
  fill_char: char
  empty_char: char
  show_percent: Bool
  show_eta: Bool
  start_time: std::time::Instant
end

def ProgressBar::new(total: UInt) -> ProgressBar
  ProgressBar {
    total: total,
    current: 0,
    width: 40,
    message: String::new(),
    fill_char: '█',
    empty_char: '░',
    show_percent: true,
    show_eta: true,
    start_time: std::time::Instant::now()
  }
end

impl ProgressBar
  def message(self: &mut ProgressBar, msg: &str) -> &mut ProgressBar
    self.message = msg.to_string()
    self
  end
  
  def width(self: &mut ProgressBar, w: UInt) -> &mut ProgressBar
    self.width = w
    self
  end
  
  def set(self: &mut ProgressBar, value: UInt) -> Unit
    self.current = if value > self.total then self.total else value end
    self.render()
  end
  
  def inc(self: &mut ProgressBar, amount: UInt) -> Unit
    self.set(self.current + amount)
  end
  
  def finish(self: &mut ProgressBar) -> Unit
    self.set(self.total)
    println("")
  end
  
  def render(self: &ProgressBar) -> Unit
    let percent = if self.total > 0 then
      (self.current * 100) / self.total
    else 0 end
    
    let filled = (self.width * self.current) / self.total
    let empty = self.width - filled
    
    let mut bar = String::new()
    bar.push('\r')
    
    if !self.message.is_empty() then
      bar.push_str(self.message.as_str())
      bar.push(' ')
    end
    
    bar.push('[')
    for _ in 0..filled do
      bar.push(self.fill_char)
    end
    for _ in 0..empty do
      bar.push(self.empty_char)
    end
    bar.push(']')
    
    if self.show_percent then
      bar.push_str(format!(" {:3}%", percent).as_str())
    end
    
    if self.show_eta && self.current > 0 then
      let elapsed = std::time::Instant::now().duration_since(self.start_time)
      let rate = self.current as f64 / elapsed.as_secs_f64()
      if rate > 0.0 then
        let remaining = (self.total - self.current) as f64 / rate
        bar.push_str(format!(" ETA: {:.0}s", remaining).as_str())
      end
    end
    
    print(bar.as_str())
    std::io::stdout().flush()
  end
end

# ———————————————————————————————————————————————————————————————
# Spinner
# ———————————————————————————————————————————————————————————————

struct Spinner
  frames: Vec[String]
  current: UInt
  message: String
  running: Bool
end

def Spinner::new() -> Spinner
  Spinner {
    frames: vec!["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"],
    current: 0,
    message: String::new(),
    running: false
  }
end

impl Spinner
  def message(self: &mut Spinner, msg: &str) -> &mut Spinner
    self.message = msg.to_string()
    self
  end
  
  def frames(self: &mut Spinner, f: Vec[String]) -> &mut Spinner
    self.frames = f
    self
  end
  
  def spin(self: &mut Spinner) -> Unit
    print("\r")
    print(self.frames[self.current % self.frames.len()].as_str())
    print(" ")
    print(self.message.as_str())
    term::clear_to_end()
    std::io::stdout().flush()
    self.current = self.current + 1
  end
  
  def stop(self: &mut Spinner) -> Unit
    print("\r")
    term::clear_line()
    self.running = false
  end
  
  def success(self: &mut Spinner, msg: &str) -> Unit
    println(format!("\r{} {}", term::style("✔").green().to_string(), msg).as_str())
  end
  
  def error(self: &mut Spinner, msg: &str) -> Unit
    println(format!("\r{} {}", term::style("✖").red().to_string(), msg).as_str())
  end
end

# ———————————————————————————————————————————————————————————————
# Configuration File Loading
# ———————————————————————————————————————————————————————————————

module config
  use std::toml
  use std::json
  use std::fs
  use std::env
  
  struct Config
    values: Map[String, toml::TomlValue]
    env_prefix: Option[String]
  end
  
  def Config::new() -> Config
    Config {
      values: Map::new(),
      env_prefix: Option::None
    }
  end
  
  impl Config
    def with_env_prefix(self: &mut Config, prefix: &str) -> &mut Config
      self.env_prefix = Option::Some(prefix.to_string())
      self
    end
    
    def load_toml(self: &mut Config, path: &str) -> Result[&mut Config, String]
      let content = fs::read_to_string(path)?
      let table = toml::parse(content.as_str())?
      
      match table
      when toml::TomlValue::Table(t) then
        for (k, v) in t do
          self.values.insert(k, v)
        end
      when _ then ()
      end
      
      Result::Ok(self)
    end
    
    def load_json(self: &mut Config, path: &str) -> Result[&mut Config, String]
      let content = fs::read_to_string(path)?
      let value = json::parse(content.as_str())?
      
      match value
      when json::Value::Object(obj) then
        for (k, v) in obj do
          self.values.insert(k, json_to_toml(&v))
        end
      when _ then ()
      end
      
      Result::Ok(self)
    end
    
    def get_string(self: &Config, key: &str) -> Option[String]
      # Check environment first
      match self.env_prefix
      when Option::Some(prefix) then
        let env_key = prefix.clone() + "_" + key.to_uppercase().replace('.', "_")
        match env::var(env_key.as_str())
        when Option::Some(v) then return Option::Some(v)
        when Option::None then ()
        end
      when Option::None then ()
      end
      
      # Then check config values
      self.get_nested(key).and_then(|v| match v {
        when toml::TomlValue::String(s) then Option::Some(s.clone())
        when _ then Option::None
      })
    end
    
    def get_int(self: &Config, key: &str) -> Option[Int]
      self.get_nested(key).and_then(|v| match v {
        when toml::TomlValue::Integer(i) then Option::Some(*i)
        when _ then Option::None
      })
    end
    
    def get_bool(self: &Config, key: &str) -> Option[Bool]
      self.get_nested(key).and_then(|v| match v {
        when toml::TomlValue::Boolean(b) then Option::Some(*b)
        when _ then Option::None
      })
    end
    
    def get_array(self: &Config, key: &str) -> Option[&Vec[toml::TomlValue]]
      self.get_nested(key).and_then(|v| match v {
        when toml::TomlValue::Array(a) then Option::Some(a)
        when _ then Option::None
      })
    end
    
    def get_table(self: &Config, key: &str) -> Option[&Map[String, toml::TomlValue]]
      self.get_nested(key).and_then(|v| match v {
        when toml::TomlValue::Table(t) then Option::Some(t)
        when _ then Option::None
      })
    end
    
    def get_nested(self: &Config, key: &str) -> Option[&toml::TomlValue]
      let parts = key.split('.')
      let mut current = &self.values
      
      for (i, part) in parts.iter().enumerate() do
        match current.get(part)
        when Option::Some(v) then
          if i == parts.len() - 1 then
            return Option::Some(v)
          end
          match v
          when toml::TomlValue::Table(t) then current = t
          when _ then return Option::None
          end
        when Option::None then return Option::None
        end
      end
      
      Option::None
    end
  end
  
  def json_to_toml(v: &json::Value) -> toml::TomlValue
    match v
    when json::Value::Null then toml::TomlValue::String("null".to_string())
    when json::Value::Bool(b) then toml::TomlValue::Boolean(*b)
    when json::Value::Int(i) then toml::TomlValue::Integer(*i)
    when json::Value::Float(f) then toml::TomlValue::Float(*f)
    when json::Value::String(s) then toml::TomlValue::String(s.clone())
    when json::Value::Array(arr) then
      toml::TomlValue::Array(arr.iter().map(|x| json_to_toml(x)).collect())
    when json::Value::Object(obj) then
      let mut map = Map::new()
      for (k, v) in obj do
        map.insert(k.clone(), json_to_toml(v))
      end
      toml::TomlValue::Table(map)
    end
  end
  
  # Common config file search paths
  def default_config_paths(app_name: &str) -> Vec[String]
    let mut paths = Vec::new()
    
    # Current directory
    paths.push(format!("./{}.toml", app_name))
    paths.push(format!("./config.toml"))
    
    # User config
    match env::var("HOME")
    when Option::Some(home) then
      paths.push(format!("{}/.config/{}/config.toml", home, app_name))
      paths.push(format!("{}/.{}.toml", home, app_name))
    when Option::None then ()
    end
    
    # XDG config
    match env::var("XDG_CONFIG_HOME")
    when Option::Some(xdg) then
      paths.push(format!("{}/{}/config.toml", xdg, app_name))
    when Option::None then ()
    end
    
    # System config
    paths.push(format!("/etc/{}/config.toml", app_name))
    paths.push(format!("/etc/{}.toml", app_name))
    
    paths
  end
  
  def load_default(app_name: &str) -> Result[Config, String]
    let paths = default_config_paths(app_name)
    
    for path in &paths do
      if fs::exists(path.as_str()) then
        let mut config = Config::new()
        return config.load_toml(path.as_str()).map(|c| c.clone())
      end
    end
    
    Result::Ok(Config::new())
  end
end

# ———————————————————————————————————————————————————————————————
# Prompt/Input
# ———————————————————————————————————————————————————————————————

module prompt
  use std::io
  
  def input(prompt: &str) -> Result[String, String]
    print(prompt)
    io::stdout().flush()
    
    let mut line = String::new()
    match io::stdin().read_line(&mut line)
    when Result::Ok(_) then Result::Ok(line.trim().to_string())
    when Result::Err(e) then Result::Err(e.to_string())
    end
  end
  
  def confirm(prompt: &str, default: Bool) -> Result[Bool, String]
    let hint = if default then "[Y/n]" else "[y/N]" end
    let line = input(format!("{} {} ", prompt, hint).as_str())?
    
    if line.is_empty() then
      return Result::Ok(default)
    end
    
    let lower = line.to_lowercase()
    if lower == "y" || lower == "yes" then
      Result::Ok(true)
    elsif lower == "n" || lower == "no" then
      Result::Ok(false)
    else
      Result::Err("invalid input, expected y/n")
    end end
  end
  
  def password(prompt: &str) -> Result[String, String]
    print(prompt)
    io::stdout().flush()
    
    # Disable echo
    disable_echo()
    
    let mut line = String::new()
    let result = io::stdin().read_line(&mut line)
    
    # Re-enable echo
    enable_echo()
    println("")
    
    match result
    when Result::Ok(_) then Result::Ok(line.trim().to_string())
    when Result::Err(e) then Result::Err(e.to_string())
    end
  end
  
  def select(prompt: &str, options: &[&str]) -> Result[UInt, String]
    println(prompt)
    
    for (i, opt) in options.iter().enumerate() do
      println(format!("  {}. {}", i + 1, opt).as_str())
    end
    
    loop
      let line = input("> ")?
      match line.parse_uint()
      when Option::Some(n) then
        if n >= 1 && n <= options.len() then
          return Result::Ok(n - 1)
        end
      when Option::None then ()
      end
      println("Invalid selection, try again")
    end
  end
  
  extern "C"
    struct Termios
      c_iflag: UInt
      c_oflag: UInt
      c_cflag: UInt
      c_lflag: UInt
      c_cc: [u8; 32]
      c_ispeed: UInt
      c_ospeed: UInt
    end
    
    def tcgetattr(fd: Int, termios: &mut Termios) -> Int
    def tcsetattr(fd: Int, action: Int, termios: &Termios) -> Int
  end
  
  const ECHO: UInt = 8  # Echo flag
  const TCSANOW: Int = 0
  
  static mut ORIGINAL_TERMIOS: Option[Termios] = Option::None
  
  def disable_echo() -> Unit
    let mut t = Termios {
      c_iflag: 0, c_oflag: 0, c_cflag: 0, c_lflag: 0,
      c_cc: [0; 32], c_ispeed: 0, c_ospeed: 0
    }
    
    if tcgetattr(0, &mut t) == 0 then
      ORIGINAL_TERMIOS = Option::Some(t.clone())
      t.c_lflag = t.c_lflag & (!ECHO)
      tcsetattr(0, TCSANOW, &t)
    end
  end
  
  def enable_echo() -> Unit
    match ORIGINAL_TERMIOS
    when Option::Some(t) then
      tcsetattr(0, TCSANOW, &t)
      ORIGINAL_TERMIOS = Option::None
    when Option::None then ()
    end
  end
end
