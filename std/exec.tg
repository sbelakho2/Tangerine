# Tangerine Standard Library — std::exec
# Multi-threaded Executor for CPU-bound and I/O-bound Workloads
#
# This module provides a work-stealing thread pool executor with:
#   - Configurable thread pool size
#   - Work stealing for load balancing
#   - Task prioritization
#   - Graceful shutdown
#   - Async/await support (via std::async's runtime — the block_on delegation)
#
# Example:
#   use std::exec::{Executor, spawn, block_on}
#   
#   # Spawn a task
#   let handle = spawn(|| {
#     let result = expensive_computation()
#     result
#   })
#   
#   # Wait for result
#   let value = handle.join()
#   println("Result: " + value.to_string())
#
#   # Async block
#   block_on(async {
#     let a = async_fn1().await
#     let b = async_fn2().await
#     a + b
#   })

use std::core::{Option, Result, String, Bool, Int, UInt, Unit, panic}
use std::collections::{Vec, Map, Queue, RingBuffer}
use std::sync::{Mutex, Condvar, AtomicU32, AtomicBool, Arc}
use std::async::{Future}
use std::thread::{Thread, spawn}
use std::time::{Duration, Instant}

# ═══════════════════════════════════════════════════════════════
# Configuration Constants
# ═══════════════════════════════════════════════════════════════

def DEFAULT_THREAD_COUNT() -> Int = 4
def MAX_QUEUE_SIZE() -> Int = 4096
def SPIN_COUNT_BEFORE_YIELD() -> Int = 100
def STEAL_ATTEMPTS() -> Int = 3
def IDLE_TIMEOUT_MS() -> Int = 100
def WORKER_LOCAL_QUEUE_CAPACITY() -> Int = 256

# The executor lifecycle state codes (the inner.state field — the single
# shutdown authority). Running -> Draining -> Stopped is the graceful
# shutdown (the workers KEEP processing until the queues are empty AND
# the active count is 0); Running -> Cancelling -> Stopped is
# shutdown_now (the queued tasks are removed + cancelled, the running
# tasks complete). The old stop-flag-then-join abandoned queued work;
# the state machine is the fix.
def _exec_state_running() -> u32 = 0
def _exec_state_draining() -> u32 = 1
def _exec_state_cancelling() -> u32 = 2
def _exec_state_stopped() -> u32 = 3

# ═══════════════════════════════════════════════════════════════
# Task Types
# ═══════════════════════════════════════════════════════════════

## Task priority levels
enum TaskPriority
  Low     # Background tasks
  Normal  # Default priority
  High    # Time-sensitive tasks
  Realtime # Critical tasks (may starve others)
end

## Task state tracking
enum TaskState
  Pending
  Running
  Completed
  Failed(String)
  Cancelled
end

## A unit of work that can be scheduled on the executor
struct Task
  id: u64
  priority: TaskPriority
  state: AtomicU32  # TaskState as atomic
  func: Box[dyn FnOnce()]
  created_at: Instant
end

## Handle to a spawned task for joining or cancellation
struct JoinHandle[T]
  task_id: u64
  executor: Arc[ExecutorInner]
  result: Arc[Mutex[Option[T]]]
  completed: Arc[Condvar]
end

# ═══════════════════════════════════════════════════════════════
# Work Stealing Queue
# ═══════════════════════════════════════════════════════════════

## A lock-free work stealing queue based on Chase-Lev algorithm
struct WorkStealingQueue
  # Internal array-based deque
  buffer: Arc[Mutex[RingBuffer[Task]]]
  # Approximate size for fast checks
  size: AtomicU32
end

def WorkStealingQueue::new(capacity: Int) -> WorkStealingQueue
  WorkStealingQueue {
    buffer: Arc::new(Mutex::new(RingBuffer::new(capacity))),
    size: AtomicU32::new(0)
  }
end

def WorkStealingQueue::push(inout self: WorkStealingQueue, sink task: Task) -> Option[Task]
  # The sink consumes the task; when the queue is full the ring evicts the
  # oldest item — the EVICTED task is returned so the caller can retry it
  # elsewhere (never silently dropped, never reused after the move).
  var guard = self.buffer.lock()
  let result = guard.push_back(task)
  match result
  when Option::Some(evicted) then
    Option::Some(evicted)
  when Option::None then
    self.size.fetch_add(1)
    Option::None
  end
end

def WorkStealingQueue::pop(inout self: WorkStealingQueue) -> Option[Task]
  var guard = self.buffer.lock()
  match guard.pop_front()
  when Option::Some(task) then
    self.size.fetch_sub(1)
    Option::Some(task)
  when Option::None then Option::None
  end
end

def WorkStealingQueue::steal(inout self: WorkStealingQueue, count: Int) -> Vec[Task]
  var stolen: Vec[Task] = Vec::new()
  
  var guard = self.buffer.lock()
  var i = 0
  while i < count do
    match guard.pop_front()
    when Option::Some(task) then
      stolen.push(task)
      self.size.fetch_sub(1)
    when Option::None then break
    end
    i = i + 1
  end
  
  stolen
end

def WorkStealingQueue::len(self: WorkStealingQueue) -> Int
  self.size.load() as Int
end

def WorkStealingQueue::is_empty(self: WorkStealingQueue) -> Bool
  self.size.load() == 0
end

# ═══════════════════════════════════════════════════════════════
# Thread-local Worker State
# ═══════════════════════════════════════════════════════════════

struct WorkerState
  id: Int
  local_queue: WorkStealingQueue
  tasks_completed: AtomicU32
  tasks_stolen: AtomicU32
  is_active: AtomicBool
end

def WorkerState::new(id: Int) -> WorkerState
  WorkerState {
    id: id,
    local_queue: WorkStealingQueue::new(WORKER_LOCAL_QUEUE_CAPACITY()),
    tasks_completed: AtomicU32::new(0),
    tasks_stolen: AtomicU32::new(0),
    is_active: AtomicBool::new(false)
  }
end

# ═══════════════════════════════════════════════════════════════
# Executor Core
# ═══════════════════════════════════════════════════════════════

## THE CONTROL TOKEN (the public-owner/control-token lifecycle — the
## reviewer's drop-leak fix): a dedicated flag the WORKERS do NOT hold —
## the wrapper-visible owners hold it (the inner's own reference plus one
## per Executor wrapper), so its reference count tracks exactly the
## public owners and is independent of the worker clones. The last
## wrapper's Drop SETS the token — the shutdown initiation — and the
## worker threads read the token (through the inner's reference) and
## transition the lifecycle themselves.
struct ExecutorControl
  shutdown_token: AtomicBool
end

## The executor's shared state (the worker slots, the queues, the
## counters, the shutdown coordination) lives in a heap allocation owned
## by an Arc — std::sync's Arc, the same heap-stable shape the sync
## module's Mutex/Channel use. The worker threads each receive their OWN
## Arc clone at start: the state stays alive even if the Executor is
## dropped or moved while a worker thread lives. The old start_workers
## hand-off passed `address_of(&mut self.workers)` into the threads — a
## raw address of the caller's stack slot that dangled the moment the
## Executor moved — and the Executor itself was shared by value through
## the (nonexistent) `Arc::from(self)`.
struct ExecutorInner
  # Worker threads and their state
  workers: Vec[WorkerState]
  threads: Vec[JoinHandle[()]]
  
  # Global queue for tasks without affinity
  global_queue: Arc[Mutex[Queue[Task]]]
  
  # THE CONTROL TOKEN REFERENCE (the workers read the drop-initiated
  # shutdown signal through THIS — the workers hold no separate control
  # clone, so the token's count stays the wrapper-visible owner count).
  control: Arc[ExecutorControl]
  
  # THE LIFECYCLE STATE MACHINE (the single shutdown authority — the old
  # stop-flag-then-join abandoned queued work): Running -> Draining ->
  # Stopped (the graceful shutdown — the workers keep processing until
  # the queues are empty AND the active count is 0), or Running ->
  # Cancelling -> Stopped (shutdown_now — the queued tasks are drained
  # and marked Cancelled). The submit gate panics on every submission
  # after the Running state.
  state: Arc[AtomicU32]
  
  # The drain quiescence probe: the count of tasks CURRENTLY EXECUTING.
  # A worker loop (under Draining/Cancelling) exits only when its
  # find_task scan found no task AND this count is 0 — a running task
  # may still enqueue work, so an idle worker keeps re-scanning until
  # the quiescence.
  active_tasks: AtomicU32
  
  # Task notification
  task_available: Arc[Condvar]
  
  # THE ADMISSION MUTEX (the admission race): every
  # submit holds this mutex across its lifecycle check + enqueue, and the
  # shutdown's Running -> Draining/Cancelling transition happens under
  # the SAME mutex — a submit that acquired the lock after the transition
  # is rejected (nothing enqueued), a submit that acquired it before is
  # fully admitted and drained (the transition cannot interleave with its
  # enqueue). The old check-then-enqueue (no lock) let a submit pass the
  # check, get descheduled, and enqueue after the shutdown reached
  # quiescence — the task stranded after the join.
  admission: Mutex[Unit]
  
  # THE GATE U TEST-FREEZE BARRIER (the admission-freeze test hook — the
  # always-on debug instrumentation, the same spirit as the ledger): when
  # test_submit_freeze is set, a submit parks after its admission check
  # (the guard dropped — the shutdown can transition in between) until
  # test_submit_freeze_release is set; test_submit_freeze_reached is the
  # deterministic handshake (the submit parked at the barrier). The two
  # legal outcomes: the submit re-checks under the lock and is admitted
  # (drained) or rejected (panics) — never an enqueue after the
  # quiescence.
  test_submit_freeze: AtomicBool
  test_submit_freeze_reached: AtomicBool
  test_submit_freeze_release: AtomicBool
  
  # Statistics
  total_tasks_submitted: AtomicU32
  total_tasks_completed: AtomicU32
  
  # Next task ID
  next_task_id: AtomicU32
  
  # Task-conservation ledger (ALWAYS-ON debug instrumentation — the
  # dialect has no debug cfg key, so the ledger is unconditionally
  # active): task id -> state code (0 = Submitted, 1 = Queued,
  # 2 = Running, 3 = Completed, 4 = Cancelled, 5 = Failed). The ledger
  # is the single authority for the invariant
  #   submitted == completed + cancelled + failed + still_queued/running
  # checked at every quiescent point; a duplicate TaskId — a re-submit,
  # a second schedule, a second completion — is the internal fatal error.
  debug_task_states: Arc[Mutex[Map[u64, Int]]]
end

## The Executor is a thin Arc wrapper over the inner — the same
## { inner: Arc[ExecutorInner] } shape std::async's cooperative Executor
## uses — PLUS the wrapper's OWN handle to the executor's control token
## (the same Arc the inner references; the wrappers are the token's
## public owners). The wrapper can be copied/moved freely; the state
## never moves. The transient wrappers built around an existing inner
## (Executor::wrap — the convenience functions, the test harnesses)
## share the token, so their drops never initiate the shutdown (a
## longer-lived owner — or the global keeper — holds a reference); the
## LAST wrapper of an executor's public owners initiates it.
struct Executor
  inner: Arc[ExecutorInner]
  control: Arc[ExecutorControl]
end

## Global executor instance
var GLOBAL_EXECUTOR: Option[Arc[ExecutorInner]] = Option::None

## The global executor's PERMANENT control-token keeper: the convenience
## wrappers (spawn/par_*/spawn_with_result) share the global's token, and
## the keeper holds one reference for as long as the global lives — the
## transient wrappers' drops see the token count above the fire threshold
## and never tear the global executor down (the same protection the old
## strong_count gate gave the global's inner Arc).
var GLOBAL_EXECUTOR_CONTROL: Option[Arc[ExecutorControl]] = Option::None

def Executor::new(thread_count: Int) -> Result[Executor, String]
  if thread_count < 1 then
    return Result::Err("Thread count must be at least 1".to_string())
  end
  
  let state = Arc::new(AtomicU32::new(_exec_state_running()))
  let task_available = Arc::new(Condvar::new())
  let global_queue = Arc::new(Mutex::new(Queue::new()))
  # THE CONTROL TOKEN: the wrapper's Drop sets the shutdown_token when
  # the last public owner drops; the workers read it through the inner's
  # reference below.
  let control = Arc::new(ExecutorControl { shutdown_token: AtomicBool::new(false) })
  var workers: Vec[WorkerState] = Vec::with_capacity(thread_count)
  var i = 0
  while i < thread_count do
    workers.push(WorkerState::new(i))
    i = i + 1
  end
  
  var executor = Executor {
    inner: Arc::new(ExecutorInner {
      workers: workers,
      threads: Vec::new(),
      global_queue: global_queue,
      control: control.clone(),
      state: state,
      active_tasks: AtomicU32::new(0),
      task_available: task_available,
      admission: Mutex::new(()),
      test_submit_freeze: AtomicBool::new(false),
      test_submit_freeze_reached: AtomicBool::new(false),
      test_submit_freeze_release: AtomicBool::new(false),
      total_tasks_submitted: AtomicU32::new(0),
      total_tasks_completed: AtomicU32::new(0),
      next_task_id: AtomicU32::new(1),
      debug_task_states: Arc::new(Mutex::new(Map::new()))
    }),
    control: control
  }
  
  # Start worker threads — each thread receives its own Arc clone of the
  # inner (the state stays alive for as long as ANY clone references it).
  executor.start_workers()
  
  Result::Ok(executor)
end

## The TRANSIENT WRAPPER constructor: a wrapper around an EXISTING inner
## (the convenience functions' wrappers around global_executor(), the
## test harnesses' wrappers around a live executor). The wrapper shares
## the inner's control token, so it counts as a public owner — but the
## drop fires only when the LAST public owner drops (the token count is
## the inner's reference + this one), so a transient wrapper whose
## executor has a longer-lived owner never initiates the shutdown.
def Executor::wrap(inner: Arc[ExecutorInner]) -> Executor
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    Executor {
      inner: inner.clone(),
      control: inner.ptr.as_ref().control.clone()
    }
  end
end

## The validated default thread count: the CPU count when positive, the
## DEFAULT_THREAD_COUNT constant otherwise — NEVER 0 (Executor::new
## rejects a thread count below 1; the old global_executor lazy init
## called init_global_executor(0) — "use default" — which built an
## invalid zero-thread executor whose Err was ignored and whose unwrap
## panicked).
def _default_thread_count_validated() -> Int
  let cpu_count = std::env::cpu_count()
  if cpu_count > 0 then cpu_count else DEFAULT_THREAD_COUNT() end
end

def Executor::new_default() -> Result[Executor, String]
  Executor::new(_default_thread_count_validated())
end

def Executor::start_workers(inout self: Executor) -> Unit
  let inner = self.inner.clone()
  let worker_count = inner.ptr.as_ref().workers.len()
  var i = 0
  
  while i < worker_count do
    let worker_id = i
    let thread_inner = inner.clone()
    
    let thread = spawn(move || {
      worker_loop(thread_inner, worker_id)
    })
    
    unsafe "executor inner access — the Arc clone keeps the inner alive" do
      let inner_mut = inner.ptr.as_mut()
      inner_mut.threads.push(thread)
    end
    i = i + 1
  end
end

## Worker thread main loop — the worker holds its OWN Arc clone of the
## executor inner: every read (the queues, the lifecycle state, the
## active count) and every write (its own worker slot, the shared
## counters) goes through that clone, so the state can never dangle
## behind a moved Executor.
##
## THE DRAIN-ORIENTED LOOP: the loop exits ONLY when the lifecycle left
## Running AND the find_task scan found no task AND the active count is
## 0. The graceful shutdown (Draining) therefore NEVER abandons queued
## work: the workers KEEP PROCESSING until the queues are empty and no
## task is running, then exit (the shutdown's join returns). Under the
## Cancelling state a task the scan still finds is CANCELLED inline (the
## shutdown_now drain is the primary remover; the scan is the defense
## for a task enqueued concurrently with the drain) — it is never
## executed.
def worker_loop(executor: Arc[ExecutorInner], worker_id: Int) -> Unit
  unsafe "executor inner access — the worker's Arc clone keeps the inner alive" do
    let inner = executor.ptr.as_mut()
    inner.workers[worker_id].is_active.store(true)
    
    var consecutive_empty = 0
    
    while true do
      # Try to get a task
      let task = find_task(executor, worker_id)
      
      match task
      when Option::Some(t) then
        consecutive_empty = 0
        let st = inner.state.load()
        if st == _exec_state_cancelling() then
          # Under Cancelling: a task still found in the queues is
          # CANCELLED — the terminal ledger transition + the TaskState
          # signal — never executed (the closure drops with the Task).
          _cancel_queued_task(inner, t)
        else
          execute_task(t, executor, worker_id)
        end
      when Option::None then
        consecutive_empty = consecutive_empty + 1
        
        # THE CONTROL-TOKEN REACTION (the drop-initiated shutdown — the
        # reviewer's lifecycle fix): the wrapper's Drop SET the control
        # token (the shutdown initiation, independent of the inner's
        # strong count — the workers hold NO token clone, they read it
        # through the inner's reference). A worker that observes the
        # token performs the Running -> Draining transition under the
        # ADMISSION MUTEX (the same protocol as the explicit shutdown —
        # the first observer wins, the rest skip) and wakes the pool;
        # the queued work then DRAINS exactly like the explicit graceful
        # shutdown (the exit condition below still requires the
        # empty-scan + zero-active quiescence).
        if inner.control.shutdown_token.load() then
          let guard = inner.admission.lock()
          let old = inner.state.compare_and_swap(_exec_state_running(), _exec_state_draining())
          drop(guard)
          if old == _exec_state_running() then
            inner.task_available.notify_all()
          end
        end
        
        # THE DRAIN EXIT: the find_task scan found no task anywhere.
        # The worker exits only when the lifecycle left Running AND no
        # task is currently executing (a running task may still enqueue
        # work, so the idle worker keeps re-scanning until the
        # quiescence). The graceful drain never abandons a queued task:
        # the workers stop ONLY at the empty-queues + zero-active
        # quiescent point.
        let st = inner.state.load()
        if st != _exec_state_running() && inner.active_tasks.load() == 0 then
          break
        end
        
        if consecutive_empty > SPIN_COUNT_BEFORE_YIELD() then
          # Wait for task notification with timeout
          var guard = inner.global_queue.lock()
          let _ = inner.task_available.wait_timeout_ms(guard, IDLE_TIMEOUT_MS())
          consecutive_empty = 0
        else
          # Brief spin then yield
          std::thread::yield_now()
        end
      end
    end
    
    inner.workers[worker_id].is_active.store(false)
  end
end

## Find a task to execute using work stealing
def find_task(
  executor: Arc[ExecutorInner],
  worker_id: Int
) -> Option[Task]
  unsafe "executor inner access — the worker's Arc clone keeps the inner alive" do
    let inner = executor.ptr.as_mut()
    # First, try local queue
    match inner.workers[worker_id].local_queue.pop()
    when Option::Some(task) then return Option::Some(task)
    when Option::None then ()
    end
    
    # Then, try global queue
    var guard = inner.global_queue.lock()
    match guard.dequeue()
    when Option::Some(task) then return Option::Some(task)
    when Option::None then ()
    end
    
    # Finally, try to steal from other workers
    var steal_attempts = 0
    while steal_attempts < STEAL_ATTEMPTS() do
      # THE VICTIM RANGE (): random_range's upper bound
      # is EXCLUSIVE — the old (0, len - 1) never chose the LAST worker
      # (index len - 1). The full worker range (0, len) makes every
      # worker — the last one included — a possible victim.
      var victim_idx = std::rand::random_range(0, inner.workers.len() as Int)
      
      if victim_idx != worker_id then
        let stolen = inner.workers[victim_idx].local_queue.steal(2)
        
        if stolen.len() > 0 then
          inner.workers[worker_id].tasks_stolen.fetch_add(stolen.len() as u32)
          
          # Return first stolen task, put rest in local queue
          var iter = stolen.iter()
          let first = iter.next()
          
          for task in iter do
            match inner.workers[worker_id].local_queue.push(task)
            when Option::Some(evicted) then
              # The local queue filled while refilling from a steal — the
              # evicted task returns to the global queue through the
              # central insertion (the evicted's own priority).
              enqueue_global_by_priority(inner, evicted)
            when Option::None then ()
            end
          end
          
          return first
        end
      end
      
      steal_attempts = steal_attempts + 1
    end
    
    Option::None
  end
end

## Execute a single task
##
## THE PANIC TERMINALITY (the State-A
## choice): the task's closure may panic, and the panic can strike at any
## point between the active-count increment below and the completion
## bookkeeping. The dialect's panic state is ABORT-ONLY for a worker
## thread (a panic unwinds only through a catch_unwind frame on the SAME
## thread; the worker has none): a panicking task ABORTS THE PROCESS, so
## the ledger's consistency is irrelevant post-abort — there is no
## observable "task stuck at Running with the active count never
## decremented" state to recover. The executor deliberately does NOT
## catch-unwind and record a Failed ledger transition: the dialect's
## unwind path skips resource finalizers (the mutex guards would be left
## held), and the abort contract needs no recovery. The Failed ledger
## state remains the invariant hook for a future catch-panic execution
## path — never a live transition under the abort contract.
def execute_task(
  task: Task,
  executor: Arc[ExecutorInner],
  worker_id: Int
) -> Unit
  # The ledger first — the duplicate-scheduling detection: a task that
  # was already Running, or already left the runnable states
  # (completed/cancelled/failed), is the internal fatal error. The
  # active count is incremented BEFORE the ledger mark so the drain
  # quiescence probe (the worker exit condition) never sees zero while
  # this task runs.
  unsafe "executor inner access — the worker's Arc clone keeps the inner alive" do
    let inner = executor.ptr.as_mut()
    inner.active_tasks.fetch_add(1)
    _debug_ledger_running(inner, task.id)
  end
  
  # Set task state to running
  task.state.store(1)  # TaskState::Running
  
  # Execute the task — a panic ABORTS the process (the documented
  # State-A terminality above): no catch here, no ledger bookkeeping
  # after the abort.
  task.func.call()
  
  # Update statistics — through the worker's Arc clone (the inner's
  # total_tasks_completed field is the single authority for the count).
  # The active count is decremented AFTER the ledger completion mark so
  # the quiescence probe never sees zero while the completion bookkeeping
  # is in flight.
  unsafe "executor inner access — the worker's Arc clone keeps the inner alive" do
    let inner = executor.ptr.as_mut()
    inner.workers[worker_id].tasks_completed.fetch_add(1)
    # The ledger completion — the duplicate-completion detection — BEFORE
    # the observable completion counter (a test spinning on the counter
    # sees the ledger already settled).
    _debug_ledger_completed(inner, task.id)
    inner.total_tasks_completed.fetch_add(1)
    inner.active_tasks.fetch_sub(1)
  end
  
  # Set task state to completed
  task.state.store(2)  # TaskState::Completed
end

# ═══════════════════════════════════════════════════════════════
# TaskId Conservation Ledger (always-on debug instrumentation)
# ═══════════════════════════════════════════════════════════════
#
# The ledger (inner.debug_task_states) tracks every TaskId through its
# lifecycle — Submitted -> Queued -> Running -> Completed (or the
# Cancelled/Failed terminal states) — and enforces the conservation
# invariant
#   submitted == completed + cancelled + failed + still_queued/running
# at every quiescent point. Every transition is checked under the
# ledger's mutex; a duplicate TaskId — a re-submit of a live id, a
# second schedule of a task that already left the runnable states, a
# second completion — is the internal fatal error (panic). The
# instrumentation is ALWAYS-ON: the dialect has no debug cfg key
# (cfg_simple_holds supports only target_os/target_arch), and the
# conservation tests must observe the ledger unconditionally.

## The ledger state codes (the Int values stored per TaskId).
def _debug_state_submitted() -> Int = 0
def _debug_state_queued() -> Int = 1
def _debug_state_running() -> Int = 2
def _debug_state_completed() -> Int = 3
def _debug_state_cancelled() -> Int = 4
def _debug_state_failed() -> Int = 5

## Register a freshly allocated TaskId as Submitted. An id that already
## exists in the ledger is the internal fatal error — the submit must
## never re-use a live id.
def _debug_ledger_submit(inner: PtrMut[ExecutorInner], task_id: u64) -> Unit
  var guard = inner.debug_task_states.lock()
  match guard.get(task_id)
  when Option::Some(_) then
    panic("exec conservation violation: duplicate TaskId submitted: " + task_id.to_string())
  when Option::None then
    let _ = guard.insert(task_id, _debug_state_submitted())
  end
end

## Mark a TaskId as Queued — the task was placed into a queue (local or
## global). The re-route of an evicted task keeps the already-Queued
## state; a task that was never submitted, or already left the runnable
## states, is the internal fatal error.
def _debug_ledger_queued(inner: PtrMut[ExecutorInner], task_id: u64) -> Unit
  var guard = inner.debug_task_states.lock()
  match guard.get(task_id)
  when Option::None then
    panic("exec conservation violation: task scheduled without submit: " + task_id.to_string())
  when Option::Some(state) then
    if state == _debug_state_queued() then
      ()
    elsif state == _debug_state_submitted() then
      let _ = guard.insert(task_id, _debug_state_queued())
    else
      panic("exec conservation violation: duplicate scheduling of TaskId " + task_id.to_string())
    end
  end
end

## Mark a TaskId as Running — the duplicate-scheduling detection: a task
## that was already Running, or already left the runnable states
## (completed/cancelled/failed), is the internal fatal error.
def _debug_ledger_running(inner: PtrMut[ExecutorInner], task_id: u64) -> Unit
  var guard = inner.debug_task_states.lock()
  match guard.get(task_id)
  when Option::None then
    panic("exec conservation violation: executed task never submitted: " + task_id.to_string())
  when Option::Some(state) then
    if state == _debug_state_running() then
      panic("exec conservation violation: duplicate scheduling of TaskId " + task_id.to_string())
    elsif state == _debug_state_submitted() || state == _debug_state_queued() then
      let _ = guard.insert(task_id, _debug_state_running())
    else
      panic("exec conservation violation: duplicate execution of TaskId " + task_id.to_string())
    end
  end
end

## Mark a TaskId as Completed — the duplicate-completion detection: a
## second completion of the same id is the internal fatal error.
def _debug_ledger_completed(inner: PtrMut[ExecutorInner], task_id: u64) -> Unit
  var guard = inner.debug_task_states.lock()
  match guard.get(task_id)
  when Option::None then
    panic("exec conservation violation: completed task never submitted: " + task_id.to_string())
  when Option::Some(state) then
    if state == _debug_state_completed() then
      panic("exec conservation violation: duplicate completion of TaskId " + task_id.to_string())
    elsif state == _debug_state_running() then
      let _ = guard.insert(task_id, _debug_state_completed())
    else
      panic("exec conservation violation: TaskId " + task_id.to_string() + " completed from state " + state.to_string())
    end
  end
end

## Mark a TaskId as Cancelled — the terminal transition for a queued task
## cancelled before execution (the hook the cancellation paths use; no
## live cancellation exists today, the state is part of the invariant).
def _debug_ledger_cancelled(inner: PtrMut[ExecutorInner], task_id: u64) -> Unit
  var guard = inner.debug_task_states.lock()
  match guard.get(task_id)
  when Option::None then
    panic("exec conservation violation: cancelled task never submitted: " + task_id.to_string())
  when Option::Some(state) then
    if state == _debug_state_queued() then
      let _ = guard.insert(task_id, _debug_state_cancelled())
    else
      panic("exec conservation violation: TaskId " + task_id.to_string() + " cancelled from state " + state.to_string())
    end
  end
end

## Mark a TaskId as Failed — the terminal transition for a task that
## panicked during execution. Under the reviewer's State-A choice (the
## abort-only panic contract — see execute_task), a live task panic
## ABORTS the process, so the executor never records Failed at runtime;
## the state is the invariant hook for a future catch-panic execution
## path.
def _debug_ledger_failed(inner: PtrMut[ExecutorInner], task_id: u64) -> Unit
  var guard = inner.debug_task_states.lock()
  match guard.get(task_id)
  when Option::None then
    panic("exec conservation violation: failed task never submitted: " + task_id.to_string())
  when Option::Some(state) then
    if state == _debug_state_running() then
      let _ = guard.insert(task_id, _debug_state_failed())
    else
      panic("exec conservation violation: TaskId " + task_id.to_string() + " failed from state " + state.to_string())
    end
  end
end

## The ledger's live state code for one TaskId (-1 when the id was never
## registered) — the JoinHandle terminal-resolution probe.
def _debug_ledger_state_of(inner: PtrMut[ExecutorInner], task_id: u64) -> Int
  let guard = inner.debug_task_states.lock()
  match guard.get(task_id)
  when Option::Some(state) then state
  when Option::None then -1
  end
end

## Cancel a single queued task inline: the terminal ledger transition
## (Queued -> Cancelled) + the TaskState cancellation signal
## (TaskState::Cancelled = 4). The task never executes; the closure
## drops with the Task (the Task parameter is consumed by value).
def _cancel_queued_task(inner: PtrMut[ExecutorInner], task: Task) -> Unit
  _debug_ledger_cancelled(inner, task.id)
  task.state.store(4)  # TaskState::Cancelled
end

## The TaskId conservation invariant — every submitted id exists in the
## ledger exactly once, sits in exactly one state, and
##   submitted == completed + cancelled + failed + still_queued/running
## (the accounted ledger entries must match the submit counter, and the
## completed entries must match the completion counter). Invoked at the
## quiescent points (the graceful shutdown, the test queries).
def _debug_check_task_conservation(inner: PtrMut[ExecutorInner]) -> Bool
  let guard = inner.debug_task_states.lock()
  var submitted = 0
  var queued = 0
  var running = 0
  var completed = 0
  var cancelled = 0
  var failed = 0
  for (_, state) in guard.entries() do
    if state == _debug_state_submitted() then submitted = submitted + 1
    elsif state == _debug_state_queued() then queued = queued + 1
    elsif state == _debug_state_running() then running = running + 1
    elsif state == _debug_state_completed() then completed = completed + 1
    elsif state == _debug_state_cancelled() then cancelled = cancelled + 1
    elsif state == _debug_state_failed() then failed = failed + 1
    else return false
    end
  end
  let accounted = submitted + queued + running + completed + cancelled + failed
  accounted == inner.total_tasks_submitted.load() as Int
    && completed == inner.total_tasks_completed.load() as Int
end

## The single central global insertion: route a task into the global
## queue by ITS OWN priority (the priority match + the enqueue). The sink
## consumes the task exactly once — the eviction path passes the EVICTED
## task (with the evicted's priority, never the incoming task's), the
## non-worker submit path passes the incoming task; neither is ever
## scheduled twice.
def enqueue_global_by_priority(inner: PtrMut[ExecutorInner], sink task: Task) -> Unit
  let prio = task.priority
  var guard = inner.global_queue.lock()
  match prio
  when TaskPriority::Realtime then guard.push_front(task)
  when TaskPriority::High then guard.push_high_priority(task)
  when TaskPriority::Normal then guard.enqueue(task)
  when TaskPriority::Low then guard.enqueue_low_priority(task)
  end
end

# ═══════════════════════════════════════════════════════════════
# Task Submission
# ═══════════════════════════════════════════════════════════════

## Submit a task to the executor
def Executor::submit(self: Executor, func: Box[dyn FnOnce()], priority: TaskPriority) -> u64
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    # THE ADMISSION PROTOCOL (the admission race):
    # the lifecycle check AND the enqueue happen under the admission
    # mutex — the same lock the shutdown's Running -> Draining/Cancelling
    # transition takes. A submission that acquires the lock AFTER the
    # transition is REJECTED (the panic — before any TaskId is allocated
    # or the ledger is touched); a submission that acquired the lock
    # BEFORE the transition is fully admitted — the transition cannot
    # interleave with its enqueue, so the task is always drained. The old
    # check-then-enqueue (no lock) had the race: a submit could pass the
    # check, get descheduled, and enqueue after the shutdown reached
    # quiescence — the task stranded after the join. The rejection
    # panics AFTER the guard dropped (the decision is made under the
    # lock, and the state never returns to Running, so the rejection is
    # final) — the admission mutex is never poisoned by a reject-path
    # panic.
    var guard = inner.admission.lock()
    if inner.state.load() != _exec_state_running() then
      drop(guard)
      panic("executor is shutting down: submit rejected")
    end
    # THE GATE U TEST-FREEZE BARRIER (the admission-freeze test hook):
    # when armed, the submit drops the guard after its check and parks
    # until the release — the deterministic deschedule between the check
    # and the enqueue. The test places a shutdown in between; after the
    # release the submit re-acquires the lock and RE-CHECKS: a submit
    # that re-acquires first is admitted and drained, one that arrives
    # after the transition is rejected — only these two legal outcomes,
    # never an enqueue after the quiescence.
    if inner.test_submit_freeze.load() then
      drop(guard)
      inner.test_submit_freeze_reached.store(true)
      while !inner.test_submit_freeze_release.load() do
        std::thread::yield_now()
      end
      guard = inner.admission.lock()
      if inner.state.load() != _exec_state_running() then
        drop(guard)
        panic("executor is shutting down: submit rejected")
      end
    end
    let task_id = inner.next_task_id.fetch_add(1) as u64
    
    let task = Task {
      id: task_id,
      priority: priority,
      state: AtomicU32::new(0),  # TaskState::Pending
      func: func,
      created_at: Instant::now()
    }
    
    # The ledger FIRST: a task id that already exists is the internal
    # fatal error — checked before the task can reach any queue.
    _debug_ledger_submit(inner, task_id)
    
    inner.total_tasks_submitted.fetch_add(1)
    
    # Try to push to current thread's local queue first
    let current = Thread::current()
    var pushed = false
    
    # Check if we're a worker thread
    var i = 0
    while i < inner.workers.len() do
      if inner.threads[i].thread.id() == current.id() then
        # The push ACCEPTS the incoming task on BOTH outcomes: the
        # eviction of an older task does not undo the acceptance. Only
        # the EVICTED task is re-routed — with the EVICTED's own priority
        # (the central insertion) — and the incoming task is never
        # scheduled a second time (no fallthrough to the global path).
        _debug_ledger_queued(inner, task_id)
        match inner.workers[i].local_queue.push(task)
        when Option::Some(evicted) then
          pushed = true
          enqueue_global_by_priority(inner, evicted)
        when Option::None then
          pushed = true
        end
        break
      end
      i = i + 1
    end
    
    # Not a worker thread (no worker slot matched): the incoming task
    # goes to the global queue through the same central priority-routed
    # insertion the eviction path uses.
    if !pushed then
      _debug_ledger_queued(inner, task_id)
      enqueue_global_by_priority(inner, task)
    end
    
    # The enqueue is complete — the admission critical section ends (a
    # task admitted before the shutdown transition is already in a queue
    # when the transition happens); the notification follows.
    drop(guard)
    
    # Notify waiting workers
    inner.task_available.notify_one()
    
    task_id
  end
end

## Submit a task that returns a value
def Executor::submit_with_result[T: Transferable](self: Executor, func: fn() -> T, priority: TaskPriority) -> JoinHandle[T]
  let result = Arc::new(Mutex::new(Option::None[T]))
  let completed = Arc::new(Condvar::new())
  
  let result_clone = result.clone()
  let completed_clone = completed.clone()
  
  let wrapper = move || {
    let value = func()
    var guard = result_clone.lock()
    *guard = Option::Some(value)
    completed_clone.notify_all()
  end
  
  let task_id = unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    # THE ADMISSION PROTOCOL — the same rejection contract as submit: the
    # lifecycle check, the TaskId allocation, the ledger, and the enqueue
    # ALL run under the admission mutex — a submit that acquires the lock
    # after the shutdown transition is rejected (the panic — nothing
    # enqueued), a submit that acquired it before is fully admitted and
    # drained (the transition cannot interleave with its enqueue). The
    # old two-gap shape (a check, then a separate enqueue) let a
    # submission slip its enqueue past the transition. The rejection
    # panics AFTER the guard dropped — the mutex is never poisoned.
    var guard = inner.admission.lock()
    if inner.state.load() != _exec_state_running() then
      drop(guard)
      panic("executor is shutting down: submit rejected")
    end
    let id = inner.next_task_id.fetch_add(1) as u64
    
    let task = Task {
      id: id,
      priority: priority,
      state: AtomicU32::new(0),
      func: Box::new(wrapper),
      created_at: Instant::now()
    }
    
    # The ledger first — the duplicate-TaskId fatal before the task can
    # reach the queue.
    _debug_ledger_submit(inner, id)
    inner.total_tasks_submitted.fetch_add(1)
    
    # Add to global queue — under the admission mutex.
    _debug_ledger_queued(inner, id)
    var gq = inner.global_queue.lock()
    gq.enqueue(task)
    drop(gq)
    drop(guard)
    
    inner.task_available.notify_one()
    
    id
  end
  
  # The handle keeps the executor alive through its OWN Arc clone — the
  # real Arc construction (the old `Arc::from(self)` did not exist in the
  # Arc API).
  JoinHandle {
    task_id: task_id,
    executor: self.inner.clone(),
    result: result,
    completed: completed
  }
end

# ═══════════════════════════════════════════════════════════════
# JoinHandle Implementation
# ═══════════════════════════════════════════════════════════════

impl[T] JoinHandle[T]
  ## Wait for the task to complete and return the result
  ##
  ## THE TERMINAL RESOLUTION: under shutdown_now a queued task is
  ## cancelled BEFORE it can run — the result cell is never published,
  ## so the join polls the ledger: a task whose ledger state is
  ## Cancelled (or Failed) resolves to None. The same terminal
  ## resolution is the defense-in-depth for a task cancelled under the
  ## Cancelling drain (the admission protocol closed the old
  ## strand-after-quiescence race: a submit is either rejected before
  ## any TaskId allocation or fully admitted and drained). The wait is
  ## bounded (the 5ms ledger recheck) — every JoinHandle reaches the
  ## terminal state under either shutdown.
  def join(self: JoinHandle[T]) -> Option[T]
    var guard = self.result.lock()
    while guard.is_none() do
      unsafe "executor inner access — the handle's Arc clone keeps the executor alive" do
        let inner = self.executor.ptr.as_mut()
        let st = _debug_ledger_state_of(inner, self.task_id)
        if st == _debug_state_cancelled() then
          return Option::None
        end
        if inner.state.load() == _exec_state_stopped() && st != _debug_state_completed() && st != _debug_state_running() then
          return Option::None
        end
      end
      guard = self.completed.wait_timeout(guard, Duration::from_millis(5))
    end
    guard.take()
  end
  
  ## Wait with timeout
  def join_timeout(self: JoinHandle[T], timeout: Duration) -> Option[T]
    var guard = self.result.lock()
    let start = Instant::now()
    while guard.is_none() && start.elapsed() < timeout do
      guard = self.completed.wait_timeout(guard, timeout - start.elapsed())
    end
    guard.take()
  end
  
  ## Check if the task is complete
  def is_complete(self: JoinHandle[T]) -> Bool
    let guard = self.result.lock()
    guard.is_some()
  end
  
  ## Get the task ID
  def id(self: JoinHandle[T]) -> u64
    self.task_id
  end
end

# ═══════════════════════════════════════════════════════════════
# Shutdown
# ═══════════════════════════════════════════════════════════════

## Shutdown the executor gracefully — the Running -> Draining -> Stopped
## state machine. The transition is a SINGLE compare-and-swap under the
## ADMISSION MUTEX (the admission protocol): a
## concurrent second shutdown (or shutdown_now) loses the transition and
## returns immediately (the winner joins the threads), and no submit can
## slip an enqueue past the transition — a submit that acquired the lock
## before it has already enqueued (it is drained), a submit that acquires
## it after is rejected. Under Draining the workers KEEP PROCESSING — the
## worker loop exits only when the queues are empty AND the active count
## is 0 (every queued task runs — the graceful drain, never a stop-flag
## abandon) — then the workers are joined, the state reaches Stopped, and
## the TaskId conservation invariant is checked at the quiescence (a
## violation is the internal fatal error).
def Executor::shutdown(inout self: Executor) -> Unit
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    # The cheap early-out BEFORE the admission lock: a shut-down executor
    # returns without touching the lock (the Drop path never blocks).
    if inner.state.load() == _exec_state_stopped() then
      return
    end
    # THE ADMISSION PROTOCOL: the Running -> Draining transition happens
    # under the admission mutex — the same lock every submit holds across
    # its check-and-enqueue.
    let guard = inner.admission.lock()
    let old = inner.state.compare_and_swap(_exec_state_running(), _exec_state_draining())
    drop(guard)
    if old != _exec_state_running() then
      return
    end
    
    # Wake all workers — they drain the queues to the quiescent point.
    inner.task_available.notify_all()
    
    # Wait for all threads to complete (the join is on the JoinHandle,
    # never on the stored Thread value).
    for handle in inner.threads do
      let _ = handle.join()
    end
    
    inner.threads.clear()
    inner.state.store(_exec_state_stopped())
    
    # The quiescent point: every worker has joined and no queue is being
    # drained — the TaskId conservation invariant must hold. A violation
    # is the internal fatal error.
    if !_debug_check_task_conservation(inner) then
      panic("exec conservation violation: submitted != completed + cancelled + failed + still_queued/running")
    end
  end
end

## Shutdown the executor immediately — the Running -> Cancelling ->
## Stopped state machine. The single CAS transition under the ADMISSION
## MUTEX (the admission protocol, the same contract
## as shutdown: no submit can slip an enqueue past the transition). A
## concurrent second shutdown loses the transition and returns. The
## Cancelling state: the submit gate rejects every new submission; ALL
## queued tasks are removed from every queue (the global queue + each
## worker's local queue) and marked Cancelled in the ledger (the
## terminal transition — the closures drop with the Tasks); the running
## tasks — non-cooperative closures that cannot observe a mid-run
## cancellation signal — run to completion, and every JoinHandle reaches
## the terminal state under either shutdown (the join resolves a
## Cancelled task to None — see JoinHandle::join). The old stub comment
## ("we'd have cancellation support") is gone: the cancellation IS the
## ledger mark + the TaskState signal + the join's terminal resolution.
def Executor::shutdown_now(inout self: Executor) -> Unit
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    # The cheap early-out BEFORE the admission lock: a shut-down executor
    # returns without touching the lock.
    if inner.state.load() == _exec_state_stopped() then
      return
    end
    # THE ADMISSION PROTOCOL: the Running -> Cancelling transition
    # happens under the admission mutex.
    let guard = inner.admission.lock()
    let old = inner.state.compare_and_swap(_exec_state_running(), _exec_state_cancelling())
    drop(guard)
    if old != _exec_state_running() then
      return
    end
    
    # REMOVE ALL QUEUED TASKS + MARK THEM CANCELLED (the ledger): the
    # global queue first, then every worker's local queue. The tasks in
    # a worker's hand (popped before the transition) are not queued —
    # they run to completion.
    var gguard = inner.global_queue.lock()
    loop do
      match gguard.dequeue()
      when Option::Some(t) then _cancel_queued_task(inner, t)
      when Option::None then break
      end
    end
    drop(gguard)
    
    var w = 0
    while w < inner.workers.len() do
      loop do
        match inner.workers[w].local_queue.pop()
        when Option::Some(t) then _cancel_queued_task(inner, t)
        when Option::None then break
        end
      end
      w = w + 1
    end
    
    # Wake all workers: they exit at the quiescent point (the queues
    # empty + the active count 0 — the running tasks complete first); a
    # task still found in the queues under Cancelling is cancelled
    # inline by the worker (the drain's concurrent-submit defense).
    inner.task_available.notify_all()
    
    for handle in inner.threads do
      let _ = handle.join()
    end
    
    inner.threads.clear()
    inner.state.store(_exec_state_stopped())
    
    # The quiescent point: every task is terminal — Completed (the
    # running tasks) or Cancelled (the drained queue) — the conservation
    # invariant holds.
    if !_debug_check_task_conservation(inner) then
      panic("exec conservation violation: submitted != completed + cancelled + failed + still_queued/running")
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Statistics
# ═══════════════════════════════════════════════════════════════

struct ExecutorStats
  total_submitted: u32
  total_completed: u32
  pending: u32
  active_workers: u32
  tasks_per_worker: Vec[u32]
  steals_per_worker: Vec[u32]
end

def Executor::stats(self: Executor) -> ExecutorStats
  let inner = self.inner.ptr.as_ref()
  var tasks_per_worker: Vec[u32] = Vec::new()
  var steals_per_worker: Vec[u32] = Vec::new()
  var active = 0
  
  for worker in inner.workers do
    tasks_per_worker.push(worker.tasks_completed.load())
    steals_per_worker.push(worker.tasks_stolen.load())
    if worker.is_active.load() then
      active = active + 1
    end
  end
  
  let guard = inner.global_queue.lock()
  let pending = guard.len() as u32
  
  ExecutorStats {
    total_submitted: inner.total_tasks_submitted.load(),
    total_completed: inner.total_tasks_completed.load(),
    pending: pending,
    active_workers: active,
    tasks_per_worker: tasks_per_worker,
    steals_per_worker: steals_per_worker
  }
end

# ═══════════════════════════════════════════════════════════════
# Task Conservation Queries (always-on debug instrumentation)
# ═══════════════════════════════════════════════════════════════

## The conservation invariant at the caller's quiescent point — the same
## check the executor runs at graceful shutdown.
def Executor::conservation_ok(self: Executor) -> Bool
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    _debug_check_task_conservation(inner)
  end
end

## The observable completion counter — the O(1) quiescence probe, updated
## AFTER every ledger completion mark (a spin on this counter sees the
## ledger already settled).
def Executor::debug_completed_count(self: Executor) -> Int
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    inner.total_tasks_completed.load() as Int
  end
end

## The ledger's live count for one state code (0 = Submitted, 1 = Queued,
## 2 = Running, 3 = Completed, 4 = Cancelled, 5 = Failed).
def Executor::debug_task_count(self: Executor, state: Int) -> Int
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    let guard = inner.debug_task_states.lock()
    var count = 0
    for (_, s) in guard.entries() do
      if s == state then
        count = count + 1
      end
    end
    count
  end
end

## The negative-test hook: register a synthetic TaskId TWICE so the
## duplicate-TaskId internal fatal error can be exercised (production code
## never produces a duplicate — the ids come from the atomic counter and
## the eviction fix routes only the evicted task). The second
## registration panics with the fatal error.
def Executor::debug_inject_duplicate_submit(self: Executor, task_id: u64) -> Unit
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    _debug_ledger_submit(inner, task_id)
    _debug_ledger_submit(inner, task_id)
  end
end

## THE GATE U TEST-FREEZE CONTROLS (the admission
## freeze): arm the freeze — the next submit parks after its admission
## check (the guard dropped, so a shutdown can transition in between)
## until released; the reached probe is the deterministic handshake (the
## submit parked at the barrier).
def Executor::debug_freeze_submit(self: Executor) -> Unit
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    inner.test_submit_freeze.store(true)
    inner.test_submit_freeze_reached.store(false)
    inner.test_submit_freeze_release.store(false)
  end
end

## The handshake: true when the frozen submit has parked at the barrier
## (its admission check ran under the lock, the guard is dropped).
def Executor::debug_freeze_reached(self: Executor) -> Bool
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    inner.test_submit_freeze_reached.load()
  end
end

## Release the parked submitter (it re-acquires the admission lock and
## re-checks the lifecycle state).
def Executor::debug_release_submit_freeze(self: Executor) -> Unit
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    inner.test_submit_freeze_release.store(true)
  end
end

## Disarm the freeze (the release flag stays — only the arm is cleared).
def Executor::debug_unfreeze_submit(self: Executor) -> Unit
  unsafe "executor inner access — the Arc clone keeps the inner alive" do
    let inner = self.inner.ptr.as_mut()
    inner.test_submit_freeze.store(false)
  end
end

# ═══════════════════════════════════════════════════════════════
# Async/Await Support (the delegation to std::async's runtime)
# ═══════════════════════════════════════════════════════════════
#
# THE DUPLICATE PSEUDO-ASYNC RUNTIME IS GONE ():
# std::exec previously carried its OWN Future/Poll/Waker/Sleep/block_on
# family — a placeholder runtime whose poll loop never integrated with
# the executor (the block_on busy-yielded, the Sleep re-woke itself on
# every poll, the spawn_future awaited the future inside a plain
# closure). The async runtime is std::async's — the cooperative
# executor, the timer heap, the reactor, the Waker — and std::exec
# CONSUMES it: the block_on entrypoint delegates straight into
# std::async::block_on, so exec's API surface is preserved without a
# second runtime. The Task's waker slot (the exec-owned Waker) is gone
# with the family.

## Block on a future until completion — the delegation into std::async's
## runtime (the single async runtime in the standard library).
def block_on[F: Future](future: F) -> F::Output
  std::async::block_on(future)
end

# ═══════════════════════════════════════════════════════════════
# Convenience Functions
# ═══════════════════════════════════════════════════════════════

## Initialize the global executor
def init_global_executor(thread_count: Int) -> Result[Unit, String]
  match Executor::new(thread_count)
  when Result::Ok(exec) then
    GLOBAL_EXECUTOR = Option::Some(exec.inner.clone())
    # THE GLOBAL KEEPER: the permanent control-token reference — the
    # transient wrappers around global_executor() (spawn/par_*/...)
    # share the token, and the keeper keeps the token count above the
    # drop's fire threshold for as long as the global lives, so no
    # transient wrapper's drop ever initiates the global shutdown (the
    # same protection the old strong_count gate provided through the
    # global's inner Arc).
    GLOBAL_EXECUTOR_CONTROL = Option::Some(exec.control.clone())
    Result::Ok(())
  when Result::Err(e) then
    Result::Err(e)
  end  end  end
end

## Get or create the global executor
def global_executor() -> Arc[ExecutorInner]
  match GLOBAL_EXECUTOR.clone()
  when Option::Some(exec) then exec
  when Option::None then
    # THE VALIDATED DEFAULT (): the lazy init uses the
    # validated default size — never 0 (the old init_global_executor(0)
    # "use default" built an invalid zero-thread executor whose Err was
    # silently IGNORED, and the unwrap on the unset global panicked
    # without the error message). The init error now PROPAGATES as the
    # panic message; the unwrap is gone.
    match init_global_executor(_default_thread_count_validated())
    when Result::Ok(()) then
      match GLOBAL_EXECUTOR.clone()
      when Option::Some(exec) then exec
      when Option::None then
        panic("global executor: init reported success but no executor installed")
      end
    when Result::Err(e) then
      panic("global executor init failed: " + e)
    end
  end  end
end

## Spawn a closure on the global executor
def spawn(func: fn() -> Unit) -> u64
  let executor = Executor::wrap(global_executor())
  executor.submit(Box::new(func), TaskPriority::Normal)
end

## Spawn with priority
def spawn_with_priority(func: fn() -> Unit, priority: TaskPriority) -> u64
  let executor = Executor::wrap(global_executor())
  executor.submit(Box::new(func), priority)
end

## Spawn a closure that returns a value
def spawn_with_result[T: Transferable](func: fn() -> T) -> JoinHandle[T]
  let executor = Executor::wrap(global_executor())
  executor.submit_with_result(func, TaskPriority::Normal)
end

## Parallel for-each
def par_for_each[T](items: [T], func: fn(T) -> Unit) -> Unit
  let executor = Executor::wrap(global_executor())
  let count = items.len()
  
  if count == 0 then return end
  
  # THE PREDICATE MUTEX + CONDVAR PAIRING (): the
  # completed count lives UNDER the real Mutex — the predicate — and the
  # Condvar is only the signal. The old code used the Condvar itself as
  # the predicate mutex (all_done.lock() — a Condvar has no lock): the
  # waiter could not check the completion predicate under any mutex, so
  # the final notify could be lost. The correct pairing: the waiter
  # checks the predicate under the mutex and waits on the condvar only
  # when the predicate is false (the wait atomically releases the mutex
  # while blocked); the notifier increments under the mutex and signals
  # after releasing it — no lost wakeup.
  let done = Arc::new(Mutex::new(0))
  let all_done = Arc::new(Condvar::new())
  
  for item in items do
    let done_clone = done.clone()
    let all_done_clone = all_done.clone()
    
    executor.submit(Box::new(move || {
      func(item)
      var g = done_clone.lock()
      *g = *g + 1
      let finished = *g
      drop(g)
      if finished == count then
        all_done_clone.notify_all()
      end
    }), TaskPriority::Normal)
  end
  
  # Wait for all tasks to complete — the predicate under the mutex.
  var guard = done.lock()
  while *guard < count do
    guard = all_done.wait(guard)
  end
  drop(guard)
end

## Parallel map
def par_map[T: Transferable, U: Transferable](items: [T], func: fn(T) -> U) -> Vec[U]
  let executor = Executor::wrap(global_executor())
  let count = items.len()
  
  if count == 0 then
    return Vec::new()
  end
  
  let results: Arc[Mutex[Vec[Option[U]]]] = Arc::new(Mutex::new(Vec::new()))
  var rguard = results.lock()
  rguard.resize(count, Option::None)
  drop(rguard)
  
  # THE PREDICATE MUTEX + CONDVAR PAIRING () — the same
  # fix as par_for_each: the completed count under the real Mutex, the
  # Condvar as the signal only (the old all_done.lock() used the condvar
  # as a nonexistent predicate mutex).
  let done = Arc::new(Mutex::new(0))
  let all_done = Arc::new(Condvar::new())
  
  var i = 0
  for item in items do
    let idx = i
    let results_clone = results.clone()
    let done_clone = done.clone()
    let all_done_clone = all_done.clone()
    
    executor.submit(Box::new(move || {
      let value = func(item)
      var guard = results_clone.lock()
      guard[idx] = Option::Some(value)
      drop(guard)
      
      var g = done_clone.lock()
      *g = *g + 1
      let finished = *g
      drop(g)
      if finished == count then
        all_done_clone.notify_all()
      end
    }), TaskPriority::Normal)
    
    i = i + 1
  end
  
  # Wait for all tasks to complete — the predicate under the mutex.
  var guard = done.lock()
  while *guard < count do
    guard = all_done.wait(guard)
  end
  drop(guard)
  
  # Collect results
  var output: Vec[U] = Vec::with_capacity(count)
  let guard = results.lock()
  for opt in guard.iter() do
    match opt
    when Option::Some(v) then output.push(v)
    when Option::None then ()
    end
  end
  drop(guard)
  
  output
end

## Parallel fold
def par_fold[T: Transferable, U: Transferable + Clone](
  items: Vec[T],
  identity: U,
  combine: fn(U, T) -> U,
  merge: fn(U, U) -> U
) -> U
  let exec = global_executor()
  let executor = Executor::wrap(exec.clone())
  let count = items.len()
  
  if count == 0 then
    return identity
  end
  
  # Split into chunks
  let worker_count = exec.ptr.as_ref().workers.len()
  let chunk_size = (count + worker_count - 1) / worker_count
  let num_chunks = (count + chunk_size - 1) / chunk_size
  
  let partial_results: Arc[Mutex[Vec[Option[U]]]] = Arc::new(Mutex::new(Vec::new()))
  var pguard = partial_results.lock()
  pguard.resize(num_chunks, Option::None)
  drop(pguard)
  
  # THE PREDICATE MUTEX + CONDVAR PAIRING () — the same
  # fix as par_for_each/par_map: the completed chunk count under the real
  # Mutex, the Condvar as the signal only (the old all_done.lock() used
  # the condvar as a nonexistent predicate mutex).
  let done = Arc::new(Mutex::new(0))
  let all_done = Arc::new(Condvar::new())
  
  var chunk_start = 0
  var chunk_idx = 0
  
  while chunk_start < count do
    let start = chunk_start
    let end_idx = if chunk_start + chunk_size < count then chunk_start + chunk_size else count end
    let idx = chunk_idx
    
    let partial_results_clone = partial_results.clone()
    let done_clone = done.clone()
    let all_done_clone = all_done.clone()
    let identity_clone = identity.clone()
    
    executor.submit(Box::new(move || {
      var acc = identity_clone
      var i = start
      while i < end_idx do
        acc = combine(acc, &items[i])
        i = i + 1
      end
      
      var pguard = partial_results_clone.lock()
      pguard[idx] = Option::Some(acc)
      drop(pguard)
      
      var g = done_clone.lock()
      *g = *g + 1
      let finished = *g
      drop(g)
      if finished == num_chunks then
        all_done_clone.notify_all()
      end
    }), TaskPriority::Normal)
    
    chunk_start = end_idx
    chunk_idx = chunk_idx + 1
  end
  
  # Wait for all chunks to complete — the predicate under the mutex.
  var dguard = done.lock()
  while *dguard < num_chunks do
    dguard = all_done.wait(dguard)
  end
  drop(dguard)
  
  # Merge partial results
  var result = identity
  let pguard2 = partial_results.lock()
  for opt in pguard2.iter() do
    match opt
    when Option::Some(v) then result = merge(result, v)
    when Option::None then ()
    end
  end
  drop(pguard2)
  
  result
end

# ═══════════════════════════════════════════════════════════════
# CPU-bound Task Scheduling
# ═══════════════════════════════════════════════════════════════

## Schedule a CPU-intensive task with proper CPU affinity
def spawn_cpu_intensive[T: Transferable](func: fn() -> T) -> JoinHandle[T]
  let executor = Executor::wrap(global_executor())
  executor.submit_with_result(func, TaskPriority::High)
end

## Yield the current task to allow other tasks to run
def yield_now() -> Unit
  std::thread::yield_now()
end

## Check if we're currently on an executor thread
def is_executor_thread() -> Bool
  let current = Thread::current()
  match GLOBAL_EXECUTOR.clone()
  when Option::Some(exec) then
    let inner = exec.ptr.as_ref()
    for thread in inner.threads do
      if thread.id() == current.id() then
        return true
      end
    end
    false
  when Option::None then false
  end
end

# ═══════════════════════════════════════════════════════════════
# Drop Implementation
# ═══════════════════════════════════════════════════════════════

impl Drop for Executor
  def drop(inout self: Executor) -> Unit
    # THE CONTROL-TOKEN LIFECYCLE (the reviewer's drop-leak fix): the old
    # gate (self.inner.strong_count() == 1) could never fire for a RUNNING
    # executor — the worker threads hold their own inner Arc clones, so
    # the inner's count was >= 2 while they lived: the shutdown never
    # initiated, the workers blocked forever on the queues, and the inner
    # leaked. The CONTROL TOKEN is the separate public-owner authority:
    # the wrappers hold it, the workers do NOT — its count tracks exactly
    # the wrapper-visible owners (the inner's own reference + one per
    # wrapper), independent of the workers' clones. When the LAST wrapper
    # drops (the count is the inner's reference + this one), the token is
    # SET — the shutdown initiation — and the worker threads read the
    # token (through the inner's reference), transition the lifecycle
    # (Running -> Draining under the admission lock — the worker-side
    # reaction in worker_loop), drain to the quiescent point, and exit;
    # their Arc clones are released, and the FINAL Arc release completes
    # the teardown (the inner allocation is freed — no leak). A transient
    # wrapper around a longer-lived executor (a cloned owner, the global
    # keeper) never fires: its drop leaves the token count above 2.
    if self.control.strong_count() == 2 then
      self.control.shutdown_token.store(true)
      unsafe "executor inner access — the wrapper's Arc clone keeps the inner alive" do
        let inner = self.inner.ptr.as_mut()
        # Wake the workers so they observe the token promptly (the
        # transition itself is theirs — the admission-lock CAS in
        # worker_loop).
        inner.task_available.notify_all()
      end
    end
  end
end
