# Tangerine Standard Library — std::exec
# Multi-threaded Executor for CPU-bound and I/O-bound Workloads
#
# This module provides a work-stealing thread pool executor with:
#   - Configurable thread pool size
#   - Work stealing for load balancing
#   - Task prioritization
#   - Graceful shutdown
#   - Async/await support
#
# Example:
#   use std::exec::{Executor, spawn, block_on}
#   
#   # Spawn a task
#   let handle = spawn(|| {
#     let result = expensive_computation()
#     result
#   })
#   
#   # Wait for result
#   let value = handle.join()
#   println("Result: " + value.to_string())
#
#   # Async block
#   block_on(async {
#     let a = async_fn1().await
#     let b = async_fn2().await
#     a + b
#   })

use std::core::{Option, Result, String, Bool, Int, UInt, Unit}
use std::collections::{Vec, Map, Queue, RingBuffer}
use std::sync::{Mutex, Condvar, AtomicU32, AtomicBool, Arc}
use std::thread::{Thread, spawn_thread, current_thread}
use std::time::{Duration, Instant}

# ═══════════════════════════════════════════════════════════════
# Configuration Constants
# ═══════════════════════════════════════════════════════════════

def DEFAULT_THREAD_COUNT() -> Int = 4
def MAX_QUEUE_SIZE() -> Int = 4096
def SPIN_COUNT_BEFORE_YIELD() -> Int = 100
def STEAL_ATTEMPTS() -> Int = 3
def IDLE_TIMEOUT_MS() -> Int = 100

# ═══════════════════════════════════════════════════════════════
# Task Types
# ═══════════════════════════════════════════════════════════════

## Task priority levels
enum TaskPriority
  Low     # Background tasks
  Normal  # Default priority
  High    # Time-sensitive tasks
  Realtime # Critical tasks (may starve others)
end

## Task state tracking
enum TaskState
  Pending
  Running
  Completed
  Failed(String)
  Cancelled
end

## A unit of work that can be scheduled on the executor
struct Task
  id: u64
  priority: TaskPriority
  state: AtomicU32  # TaskState as atomic
  func: Box<dyn FnOnce() -> Unit + Send>
  waker: Option[Waker]
  created_at: Instant
end

## Handle to a spawned task for joining or cancellation
struct JoinHandle[T]
  task_id: u64
  executor: Arc[Executor]
  result: Arc[Mutex[Option[T]]]
  completed: Arc[Condvar]
end

# ═══════════════════════════════════════════════════════════════
# Work Stealing Queue
# ═══════════════════════════════════════════════════════════════

## A lock-free work stealing queue based on Chase-Lev algorithm
struct WorkStealingQueue
  # Internal array-based deque
  buffer: Arc[Mutex[RingBuffer[Task]]]
  # Approximate size for fast checks
  size: AtomicU32
end

def WorkStealingQueue::new(capacity: Int) -> WorkStealingQueue
  WorkStealingQueue {
    buffer: Arc::new(Mutex::new(RingBuffer::new(capacity))),
    size: AtomicU32::new(0)
  }
end

def WorkStealingQueue::push(self: &WorkStealingQueue, sink task: Task) -> Bool
  match self.buffer.lock()
  when Option::Some(var guard) then
    let result = guard.push_back(task)
    if result.is_some() then
      # Queue was full, item was evicted
      false
    else
      self.size.fetch_add(1)
      true
    end
  when Option::None then
    false
  end
end

def WorkStealingQueue::pop(self: &WorkStealingQueue) -> Option[Task]
  match self.buffer.lock()
  when Option::Some(var guard) then
    match guard.pop_front()
    when Option::Some(task) then
      self.size.fetch_sub(1)
      Option::Some(task)
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

def WorkStealingQueue::steal(self: &WorkStealingQueue, count: Int) -> Vec[Task]
  var stolen: Vec[Task] = Vec::new()
  
  match self.buffer.lock()
  when Option::Some(var guard) then
    var i = 0
    while i < count do
      match guard.pop_front()
      when Option::Some(task) then
        stolen.push(task)
        self.size.fetch_sub(1)
      when Option::None then break
      end
      i = i + 1
    end
  when Option::None then ()
  end
  
  stolen
end

def WorkStealingQueue::len(self: &WorkStealingQueue) -> Int
  self.size.load() as Int
end

def WorkStealingQueue::is_empty(self: &WorkStealingQueue) -> Bool
  self.size.load() == 0
end

# ═══════════════════════════════════════════════════════════════
# Thread-local Worker State
# ═══════════════════════════════════════════════════════════════

struct WorkerState
  id: Int
  local_queue: WorkStealingQueue
  tasks_completed: AtomicU32
  tasks_stolen: AtomicU32
  is_active: AtomicBool
end

def WorkerState::new(id: Int) -> WorkerState
  WorkerState {
    id: id,
    local_queue: WorkStealingQueue::new(256),
    tasks_completed: AtomicU32::new(0),
    tasks_stolen: AtomicU32::new(0),
    is_active: AtomicBool::new(false)
  }
end

# ═══════════════════════════════════════════════════════════════
# Executor Core
# ═══════════════════════════════════════════════════════════════

## The main executor struct managing the thread pool
struct Executor
  # Worker threads and their state
  workers: Vec[WorkerState]
  threads: Vec[Thread]
  
  # Global queue for tasks without affinity
  global_queue: Arc[Mutex[Queue[Task]]]
  
  # Shutdown coordination
  shutdown: Arc[AtomicBool]
  shutdown_complete: Arc[Condvar]
  
  # Task notification
  task_available: Arc[Condvar]
  
  # Statistics
  total_tasks_submitted: AtomicU32
  total_tasks_completed: AtomicU32
  
  # Next task ID
  next_task_id: AtomicU32
end

## Global executor instance
var GLOBAL_EXECUTOR: Option[Arc[Executor]] = Option::None

def Executor::new(thread_count: Int) -> Result[Executor, String]
  if thread_count < 1 then
    return Result::Err("Thread count must be at least 1".to_string())
  end
  
  let shutdown = Arc::new(AtomicBool::new(false))
  let task_available = Arc::new(Condvar::new())
  let global_queue = Arc::new(Mutex::new(Queue::new()))
  
  var workers: Vec[WorkerState] = Vec::with_capacity(thread_count)
  var i = 0
  while i < thread_count do
    workers.push(WorkerState::new(i))
    i = i + 1
  end
  
  var executor = Executor {
    workers: workers,
    threads: Vec::new(),
    global_queue: global_queue,
    shutdown: shutdown,
    shutdown_complete: Arc::new(Condvar::new()),
    task_available: task_available,
    total_tasks_submitted: AtomicU32::new(0),
    total_tasks_completed: AtomicU32::new(0),
    next_task_id: AtomicU32::new(1)
  }
  
  # Start worker threads
  executor.start_workers()
  
  Result::Ok(executor)
end

def Executor::new_default() -> Result[Executor, String]
  # Use number of CPU cores or default
  let cpu_count = std::env::cpu_count()
  let thread_count = if cpu_count > 0 then cpu_count else DEFAULT_THREAD_COUNT() end
  Executor::new(thread_count)
end

def Executor::start_workers(self: &mut Executor) -> Unit
  let worker_count = self.workers.len()
  var i = 0
  
  while i < worker_count do
    let worker_id = i
    let workers_ref = address_of(&mut self.workers)
    let global_queue_ref = self.global_queue.clone()
    let shutdown_ref = self.shutdown.clone()
    let task_available_ref = self.task_available.clone()
    let total_completed_ref = self.total_completed.clone()
    
    let thread = spawn_thread(move || {
      worker_loop(
        worker_id,
        &*workers_ref,
        global_queue_ref,
        shutdown_ref,
        task_available_ref,
        total_completed_ref
      )
    })
    
    self.threads.push(thread)
    i = i + 1
  end
end

## Worker thread main loop
def worker_loop(
  worker_id: Int,
  workers: &Vec[WorkerState],
  global_queue: &Arc[Mutex[Queue[Task]]],
  shutdown: &Arc[AtomicBool],
  task_available: &Arc[Condvar],
  total_completed: &Arc[AtomicU32]
) -> Unit
  let worker = workers[worker_id]
  worker.is_active.store(true)
  
  var consecutive_empty = 0
  
  while !shutdown.load() do
    # Try to get a task
    let task = find_task(worker, workers, global_queue)
    
    match task
    when Option::Some(t) then
      consecutive_empty = 0
      execute_task(t, worker, total_completed)
    when Option::None then
      consecutive_empty = consecutive_empty + 1
      
      if consecutive_empty > SPIN_COUNT_BEFORE_YIELD() then
        # Wait for task notification with timeout
        match global_queue.lock()
        when Option::Some(var guard) then
          let _ = task_available.wait_timeout_ms(guard, IDLE_TIMEOUT_MS())
        when Option::None then ()
        end
        consecutive_empty = 0
      else
        # Brief spin then yield
        std::thread::yield_now()
      end
    end
  end
  
  worker.is_active.store(false)
end

## Find a task to execute using work stealing
def find_task(
  worker: &WorkerState,
  workers: &Vec[WorkerState],
  global_queue: &Arc[Mutex[Queue[Task]]]
) -> Option[Task]
  # First, try local queue
  match worker.local_queue.pop()
  when Option::Some(task) then return Option::Some(task)
  when Option::None then ()
  end
  
  # Then, try global queue
  match global_queue.lock()
  when Option::Some(var guard) then
    match guard.dequeue()
    when Option::Some(task) then return Option::Some(task)
    when Option::None then ()
    end
  when Option::None then ()
  end
  
  # Finally, try to steal from other workers
  var steal_attempts = 0
  while steal_attempts < STEAL_ATTEMPTS() do
    var victim_idx = std::rand::random_range(0, workers.len() as Int - 1)
    
    if victim_idx != worker.id then
      let victim = workers[victim_idx]
      let stolen = victim.local_queue.steal(2)
      
      if stolen.len() > 0 then
        worker.tasks_stolen.fetch_add(stolen.len() as u32)
        
        # Return first stolen task, put rest in local queue
        var iter = stolen.iter()
        let first = iter.next()
        
        for task in iter do
          let _ = worker.local_queue.push(task)
        end
        
        return first
      end
    end
    
    steal_attempts = steal_attempts + 1
  end
  
  Option::None
end

## Execute a single task
def execute_task(
  task: Task,
  worker: &WorkerState,
  total_completed: &Arc[AtomicU32]
) -> Unit
  # Set task state to running
  task.state.store(1)  # TaskState::Running
  
  # Execute the task
  # Note: In a real implementation, we'd catch panics here
  task.func.call()
  
  # Update statistics
  worker.tasks_completed.fetch_add(1)
  total_completed.fetch_add(1)
  
  # Set task state to completed
  task.state.store(2)  # TaskState::Completed
end

# ═══════════════════════════════════════════════════════════════
# Task Submission
# ═══════════════════════════════════════════════════════════════

## Submit a task to the executor
def Executor::submit(self: &Executor, func: Box<dyn FnOnce() -> Unit + Send>, priority: TaskPriority) -> u64
  let task_id = self.next_task_id.fetch_add(1) as u64
  
  let task = Task {
    id: task_id,
    priority: priority,
    state: AtomicU32::new(0),  # TaskState::Pending
    func: func,
    waker: Option::None,
    created_at: Instant::now()
  }
  
  self.total_tasks_submitted.fetch_add(1)
  
  # Try to push to current thread's local queue first
  let current = current_thread()
  var pushed = false
  
  # Check if we're a worker thread
  var i = 0
  while i < self.workers.len() do
    if self.threads[i].id() == current.id() then
      pushed = self.workers[i].local_queue.push(task)
      break
    end
    i = i + 1
  end
  
  # If not a worker or local queue full, use global queue
  if !pushed then
    match self.global_queue.lock()
    when Option::Some(var guard) then
      # Priority ordering: higher priority first
      match priority
      when TaskPriority::Realtime then guard.push_front(task)
      when TaskPriority::High then guard.push_high_priority(task)
      when TaskPriority::Normal then guard.enqueue(task)
      when TaskPriority::Low then guard.enqueue_low_priority(task)
      end
    when Option::None then ()
    end
  end
  
  # Notify waiting workers
  self.task_available.notify_one()
  
  task_id
end

## Submit a task that returns a value
def Executor::submit_with_result[T: Send](self: &Executor, func: fn() -> T, priority: TaskPriority) -> JoinHandle[T]
  let task_id = self.next_task_id.fetch_add(1) as u64
  let result = Arc::new(Mutex::new(Option::None[T]))
  let completed = Arc::new(Condvar::new())
  
  let result_clone = result.clone()
  let completed_clone = completed.clone()
  
  let wrapper = move || {
    let value = func()
    match result_clone.lock()
    when Option::Some(var guard) then
      *guard = Option::Some(value)
    when Option::None then ()
    end
    completed_clone.notify_all()
  end
  
  let task = Task {
    id: task_id,
    priority: priority,
    state: AtomicU32::new(0),
    func: Box::new(wrapper),
    waker: Option::None,
    created_at: Instant::now()
  }
  
  self.total_tasks_submitted.fetch_add(1)
  
  # Add to global queue
  match self.global_queue.lock()
  when Option::Some(var guard) then
    guard.enqueue(task)
  when Option::None then ()
  end
  
  self.task_available.notify_one()
  
  JoinHandle {
    task_id: task_id,
    executor: Arc::from(self),
    result: result,
    completed: completed
  }
end

# ═══════════════════════════════════════════════════════════════
# JoinHandle Implementation
# ═══════════════════════════════════════════════════════════════

impl[T] JoinHandle[T]
  ## Wait for the task to complete and return the result
  def join(self: &JoinHandle[T]) -> Option[T]
    match self.result.lock()
    when Option::Some(var guard) then
      while guard.is_none() do
        guard = self.completed.wait(guard)
      end
      guard.take()
    when Option::None then Option::None
    end
  end
  
  ## Wait with timeout
  def join_timeout(self: &JoinHandle[T], timeout: Duration) -> Option[T]
    match self.result.lock()
    when Option::Some(var guard) then
      let start = Instant::now()
      while guard.is_none() && start.elapsed() < timeout do
        guard = self.completed.wait_timeout(guard, timeout - start.elapsed())
      end
      guard.take()
    when Option::None then Option::None
    end
  end
  
  ## Check if the task is complete
  def is_complete(self: &JoinHandle[T]) -> Bool
    match self.result.lock()
    when Option::Some(guard) then guard.is_some()
    when Option::None then false
    end
  end
  
  ## Get the task ID
  def id(self: &JoinHandle[T]) -> u64
    self.task_id
  end
end

# ═══════════════════════════════════════════════════════════════
# Shutdown
# ═══════════════════════════════════════════════════════════════

## Shutdown the executor gracefully
def Executor::shutdown(self: &mut Executor) -> Unit
  self.shutdown.store(true)
  
  # Wake all workers
  self.task_available.notify_all()
  
  # Wait for all threads to complete
  for thread in self.threads do
    thread.join()
  end
  
  self.threads.clear()
end

## Shutdown immediately (may leave tasks incomplete)
def Executor::shutdown_now(self: &mut Executor) -> Unit
  self.shutdown.store(true)
  
  # Wake all workers
  self.task_available.notify_all()
  
  # Give threads a short time to finish current tasks
  let timeout = Duration::from_millis(100)
  let start = Instant::now()
  
  while start.elapsed() < timeout do
    let all_inactive = true
    for worker in self.workers do
      if worker.is_active.load() then
        all_inactive = false
        break
      end
    end
    
    if all_inactive then break end
    std::thread::sleep_ms(10)
  end
  
  # Force terminate any remaining threads
  # (In a real implementation, we'd have cancellation support)
end

# ═══════════════════════════════════════════════════════════════
# Statistics
# ═══════════════════════════════════════════════════════════════

struct ExecutorStats
  total_submitted: u32
  total_completed: u32
  pending: u32
  active_workers: u32
  tasks_per_worker: Vec[u32]
  steals_per_worker: Vec[u32]
end

def Executor::stats(self: &Executor) -> ExecutorStats
  var tasks_per_worker: Vec[u32] = Vec::new()
  var steals_per_worker: Vec[u32] = Vec::new()
  var active = 0
  
  for worker in self.workers do
    tasks_per_worker.push(worker.tasks_completed.load())
    steals_per_worker.push(worker.tasks_stolen.load())
    if worker.is_active.load() then
      active = active + 1
    end
  end
  
  let pending = match self.global_queue.lock()
  when Option::Some(guard) then guard.len() as u32
  when Option::None then 0
  end
  
  ExecutorStats {
    total_submitted: self.total_tasks_submitted.load(),
    total_completed: self.total_tasks_completed.load(),
    pending: pending,
    active_workers: active,
    tasks_per_worker: tasks_per_worker,
    steals_per_worker: steals_per_worker
  }
end

# ═══════════════════════════════════════════════════════════════
# Async/Await Support
# ═══════════════════════════════════════════════════════════════

## Future trait for async operations
trait Future[T]
  def poll(self: &mut Self, cx: &mut Context) -> Poll[T]
end

enum Poll[T]
  Ready(T)
  Pending
end

struct Context
  waker: Waker
end

struct Waker
  task_id: u64
  executor: Arc[Executor]
end

impl Waker
  def wake(self: &Waker) -> Unit
    self.executor.task_available.notify_one()
  end
  
  def wake_by_ref(self: &Waker) -> Unit
    self.executor.task_available.notify_one()
  end
end

## A simple future that wraps a value
struct Ready[T]
  value: Option[T]
end

impl[T] Future[T] for Ready[T]
  def poll(self: &mut Ready[T], _cx: &mut Context) -> Poll[T]
    match self.value.take()
    when Option::Some(v) then Poll::Ready(v)
    when Option::None then Poll::Ready(Default::default())
    end
  end
end

def ready[T](value: T) -> Ready[T]
  Ready { value: Option::Some(value) }
end

## A future that completes after a duration
struct Sleep
  deadline: Instant
  completed: Bool
end

impl Future[Unit] for Sleep
  def poll(self: &mut Sleep, cx: &mut Context) -> Poll[Unit]
    if self.completed then
      return Poll::Ready(())
    end
    
    if Instant::now() >= self.deadline then
      self.completed = true
      Poll::Ready(())
    else
      # Register waker for later notification
      # In a real implementation, we'd use a timer wheel
      cx.waker.wake_by_ref()
      Poll::Pending
    end
  end
end

def sleep(duration: Duration) -> Sleep
  Sleep {
    deadline: Instant::now() + duration,
    completed: false
  }
end

## Spawn a future onto the executor
def spawn_future[T: Send](future: impl Future[T] + Send) -> JoinHandle[T]
  match GLOBAL_EXECUTOR
  when Option::Some(exec) then
    exec.submit_with_result(|| {
      # This would need a proper async runtime to work
      # For now, this is a placeholder
      future.await
    }, TaskPriority::Normal)
  when Option::None then
    # Create default executor if needed
    let exec = Executor::new_default()
    match exec
    when Result::Ok(e) then
      GLOBAL_EXECUTOR = Option::Some(Arc::new(e))
      spawn_future(future)
    when Result::Err(_) then
      panic("Failed to create executor")
    end
  end
end

## Block on a future until completion
def block_on[T](future: impl Future[T]) -> T
  # Create a simple single-threaded executor for blocking
  var f = future
  let waker = Waker { task_id: 0, executor: Arc::null() }
  var cx = Context { waker: waker }
  
  loop do
    match f.poll(&mut cx)
    when Poll::Ready(value) then return value
    when Poll::Pending then
      # In a real implementation, we'd wait for IO or timer events
      std::thread::yield_now()
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Convenience Functions
# ═══════════════════════════════════════════════════════════════

## Initialize the global executor
def init_global_executor(thread_count: Int) -> Result[Unit, String]
  match Executor::new(thread_count)
  when Result::Ok(exec) then
    GLOBAL_EXECUTOR = Option::Some(Arc::new(exec))
    Result::Ok(())
  when Result::Err(e) then
    Result::Err(e)
  end
end

## Get or create the global executor
def global_executor() -> Arc[Executor]
  match GLOBAL_EXECUTOR.clone()
  when Option::Some(exec) then exec
  when Option::None then
    init_global_executor(0)  # Use default
    GLOBAL_EXECUTOR.clone().unwrap()
  end
end

## Spawn a closure on the global executor
def spawn(func: fn() -> Unit) -> u64
  let exec = global_executor()
  exec.submit(Box::new(func), TaskPriority::Normal)
end

## Spawn with priority
def spawn_with_priority(func: fn() -> Unit, priority: TaskPriority) -> u64
  let exec = global_executor()
  exec.submit(Box::new(func), priority)
end

## Spawn a closure that returns a value
def spawn_with_result[T: Send](func: fn() -> T) -> JoinHandle[T]
  let exec = global_executor()
  exec.submit_with_result(func, TaskPriority::Normal)
end

## Parallel for-each
def par_for_each[T](items: &[T], func: fn(&T) -> Unit) -> Unit
  let exec = global_executor()
  let count = items.len()
  
  if count == 0 then return end
  
  let completed = Arc::new(AtomicU32::new(0))
  let all_done = Arc::new(Condvar::new())
  
  for item in items do
    let completed_clone = completed.clone()
    let all_done_clone = all_done.clone()
    
    exec.submit(Box::new(move || {
      func(item)
      let remaining = completed_clone.fetch_add(1) + 1
      if remaining == count as u32 then
        all_done_clone.notify_all()
      end
    }), TaskPriority::Normal)
  end
  
  # Wait for all tasks to complete
  match all_done.lock()
  when Option::Some(var guard) then
    while completed.load() < count as u32 do
      guard = all_done.wait(guard)
    end
  when Option::None then ()
  end
end

## Parallel map
def par_map[T: Send, U: Send](items: &[T], func: fn(&T) -> U) -> Vec[U]
  let exec = global_executor()
  let count = items.len()
  
  if count == 0 then
    return Vec::new()
  end
  
  let results: Arc[Mutex[Vec[Option[U]]]] = Arc::new(Mutex::new(Vec::new()))
  match results.lock()
  when Option::Some(var guard) then
    guard.resize(count, Option::None)
  when Option::None then ()
  end
  
  let completed = Arc::new(AtomicU32::new(0))
  let all_done = Arc::new(Condvar::new())
  
  var i = 0
  for item in items do
    let idx = i
    let results_clone = results.clone()
    let completed_clone = completed.clone()
    let all_done_clone = all_done.clone()
    
    exec.submit(Box::new(move || {
      let value = func(item)
      match results_clone.lock()
      when Option::Some(var guard) then
        guard[idx] = Option::Some(value)
      when Option::None then ()
      end
      
      let remaining = completed_clone.fetch_add(1) + 1
      if remaining == count as u32 then
        all_done_clone.notify_all()
      end
    }), TaskPriority::Normal)
    
    i = i + 1
  end
  
  # Wait for all tasks to complete
  match all_done.lock()
  when Option::Some(var guard) then
    while completed.load() < count as u32 do
      guard = all_done.wait(guard)
    end
  when Option::None then ()
  end
  
  # Collect results
  var output: Vec[U] = Vec::with_capacity(count)
  match results.lock()
  when Option::Some(guard) then
    for opt in guard.iter() do
      match opt
      when Option::Some(v) then output.push(v)
      when Option::None then ()
      end
    end
  when Option::None then ()
  end
  
  output
end

## Parallel fold
def par_fold[T: Send, U: Send + Clone>(
  items: &[T],
  identity: U,
  combine: fn(U, &T) -> U,
  merge: fn(U, U) -> U
) -> U
  let exec = global_executor()
  let count = items.len()
  
  if count == 0 then
    return identity
  end
  
  # Split into chunks
  let chunk_size = (count + exec.workers.len() - 1) / exec.workers.len()
  let num_chunks = (count + chunk_size - 1) / chunk_size
  
  let partial_results: Arc[Mutex[Vec[Option[U]]]] = Arc::new(Mutex::new(Vec::new()))
  match partial_results.lock()
  when Option::Some(var guard) then
    guard.resize(num_chunks, Option::None)
  when Option::None then ()
  end
  
  let completed = Arc::new(AtomicU32::new(0))
  let all_done = Arc::new(Condvar::new())
  
  var chunk_start = 0
  var chunk_idx = 0
  
  while chunk_start < count do
    let start = chunk_start
    let end_idx = if chunk_start + chunk_size < count then chunk_start + chunk_size else count end
    let idx = chunk_idx
    
    let partial_results_clone = partial_results.clone()
    let completed_clone = completed.clone()
    let all_done_clone = all_done.clone()
    let identity_clone = identity.clone()
    
    exec.submit(Box::new(move || {
      var acc = identity_clone
      var i = start
      while i < end_idx do
        acc = combine(acc, &items[i])
        i = i + 1
      end
      
      match partial_results_clone.lock()
      when Option::Some(var guard) then
        guard[idx] = Option::Some(acc)
      when Option::None then ()
      end
      
      let remaining = completed_clone.fetch_add(1) + 1
      if remaining == num_chunks as u32 then
        all_done_clone.notify_all()
      end
    }), TaskPriority::Normal)
    
    chunk_start = end_idx
    chunk_idx = chunk_idx + 1
  end
  
  # Wait for all chunks to complete
  match all_done.lock()
  when Option::Some(var guard) then
    while completed.load() < num_chunks as u32 do
      guard = all_done.wait(guard)
    end
  when Option::None then ()
  end
  
  # Merge partial results
  var result = identity
  match partial_results.lock()
  when Option::Some(guard) then
    for opt in guard.iter() do
      match opt
      when Option::Some(v) then result = merge(result, v)
      when Option::None then ()
      end
    end
  when Option::None then ()
  end
  
  result
end

# ═══════════════════════════════════════════════════════════════
# CPU-bound Task Scheduling
# ═══════════════════════════════════════════════════════════════

## Schedule a CPU-intensive task with proper CPU affinity
def spawn_cpu_intensive[T: Send](func: fn() -> T) -> JoinHandle[T]
  let exec = global_executor()
  exec.submit_with_result(func, TaskPriority::High)
end

## Yield the current task to allow other tasks to run
def yield_now() -> Unit
  std::thread::yield_now()
end

## Check if we're currently on an executor thread
def is_executor_thread() -> Bool
  let current = current_thread()
  match GLOBAL_EXECUTOR.clone()
  when Option::Some(exec) then
    for thread in exec.threads do
      if thread.id() == current.id() then
        return true
      end
    end
    false
  when Option::None then false
  end
end

# ═══════════════════════════════════════════════════════════════
# Drop Implementation
# ═══════════════════════════════════════════════════════════════

impl Drop for Executor
  def drop(self: &mut Executor) -> Unit
    if !self.shutdown.load() then
      self.shutdown()
    end
  end
end