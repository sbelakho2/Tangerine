# Tangerine Standard Library — std::fmt
# Formatting, printing, Display/Debug traits

# Note: Display trait is defined in std/core.tg with method `def fmt(self: &Self) -> String`
# Re-export it here for convenience
use std::core::{Display}

trait Debug
  def debug(self: &Self) -> String
end

# Compiler intrinsics for I/O
extern "Tangerine"
  def print(x: String) -> Unit
  def puts(x: String) -> Unit
  def eprint(x: String) -> Unit
  def eputs(x: String) -> Unit
end

def format(fmt: String, args: Array[String]) -> String
  # Replace {} placeholders with arguments in order.
  # Supports:
  #   {} — positional replacement (next argument)
  #   {0}, {1}, ... — indexed replacement
  #   {{ — literal left brace
  #   }} — literal right brace
  
  mut result = ""
  mut arg_idx = 0
  mut i = 0
  let chars = fmt.chars()
  let len = chars.len()
  
  while i < len do
    let ch = chars[i]
    
    if ch == '{' then
      if i + 1 < len && chars[i + 1] == '{' then
        # Escaped: {{ → literal {
        result = result + "{"
        i = i + 2
      else
        # Find closing }
        let start = i + 1
        mut end_idx = start
        while end_idx < len && chars[end_idx] != '}' do
          end_idx = end_idx + 1
        end
        
        if end_idx >= len then
          # No closing brace found — emit as-is
          result = result + "{"
          i = i + 1
        else
          let inner = fmt.slice(start, end_idx)
          if inner.is_empty() then
            # {} — use next positional argument
            if arg_idx < args.len() then
              result = result + args[arg_idx]
              arg_idx = arg_idx + 1
            else
              result = result + "{}"
            end
          else
            # {N} — indexed argument
            match parse_int(inner)
            when Option::Some(idx) then
              if idx >= 0 && idx < args.len() then
                result = result + args[idx]
              else
                result = result + "{" + inner + "}"
              end
            when Option::None then
              # Unknown format spec — pass through
              result = result + "{" + inner + "}"
            end
          end
          i = end_idx + 1
        end
      end
    elsif ch == '}' && i + 1 < len && chars[i + 1] == '}' then
      # Escaped: }} → literal }
      result = result + "}"
      i = i + 2
    else
      result = result + ch.to_string()
      i = i + 1
    end
  end
  
  result
end

def parse_int(s: String) -> Option[Int]
  if s.is_empty() then return Option::None end
  mut result = 0
  mut negative = false
  mut start = 0
  if s.char_at(0) == '-' then
    negative = true
    start = 1
  end
  mut i = start
  let chars = s.chars()
  while i < chars.len() do
    let ch = chars[i]
    if ch >= '0' && ch <= '9' then
      result = result * 10 + (ch.to_int() - '0'.to_int())
    else
      return Option::None
    end
    i = i + 1
  end
  if negative then result = -result end
  Option::Some(result)
end

# Compiler intrinsics for string conversion
extern "Tangerine"
  def int_to_string_intrinsic(x: Int) -> String
  def uint_to_string_intrinsic(x: UInt) -> String
  def float_to_string_intrinsic(x: Float) -> String
end

def to_string(x: Int) -> String
  int_to_string_intrinsic(x)
end

def int_to_string(x: Int) -> String
  int_to_string_intrinsic(x)
end

def bool_to_string(x: Bool) -> String
  if x
    "true"
  else
    "false"
  end
end

# Unicode display width (for terminal output)
# Returns the number of terminal columns needed to display a string
def display_width(s: &String) -> UInt
  mut width = 0u
  for ch in s.chars() do
    width = width + char_width(ch)
  end
  width
end

# Get display width of a single character
def char_width(ch: Char) -> UInt
  let cp = ch as u32
  
  # NUL and control characters
  if cp == 0 || (cp >= 0x01 && cp <= 0x1F) || cp == 0x7F then
    return 0u
  end
  
  # Common ASCII - fast path
  if cp >= 0x20 && cp < 0x7F then
    return 1u
  end
  
  # Combining characters (zero width)
  if is_combining(cp) then
    return 0u
  end
  
  # Fullwidth and wide characters (East Asian Width)
  if is_wide(cp) then
    return 2u
  end
  
  1u
end

# Check if codepoint is a combining character (zero-width)
def is_combining(cp: u32) -> Bool
  (cp >= 0x0300 && cp <= 0x036F) ||   # Combining Diacriticals
  (cp >= 0x1AB0 && cp <= 0x1AFF) ||   # Combining Diacriticals Extended
  (cp >= 0x1DC0 && cp <= 0x1DFF) ||   # Combining Diacriticals Supplement
  (cp >= 0x20D0 && cp <= 0x20FF) ||   # Combining for Symbols
  (cp >= 0xFE20 && cp <= 0xFE2F)      # Combining Half Marks
end

# Check if codepoint has East Asian Width = Wide or Fullwidth
def is_wide(cp: u32) -> Bool
  (cp >= 0x1100 && cp <= 0x115F) ||   # Hangul Jamo
  (cp >= 0x2E80 && cp <= 0x9FFF) ||   # CJK ranges
  (cp >= 0xAC00 && cp <= 0xD7A3) ||   # Hangul Syllables
  (cp >= 0xF900 && cp <= 0xFAFF) ||   # CJK Compatibility Ideographs
  (cp >= 0xFE10 && cp <= 0xFE1F) ||   # Vertical Forms
  (cp >= 0xFE30 && cp <= 0xFE6F) ||   # CJK Compatibility Forms
  (cp >= 0xFF00 && cp <= 0xFF60) ||   # Fullwidth Forms
  (cp >= 0xFFE0 && cp <= 0xFFE6) ||   # Fullwidth Symbols
  (cp >= 0x20000 && cp <= 0x2FFFF)    # CJK Extension B and beyond
end
