# Tangerine Standard Library — std::fmt
# Formatting, printing, Display/Debug traits

trait Display
  def display(self) -> String
end

trait Debug
  def debug(self) -> String
end

def print(x: String) -> Unit
  # Compiler intrinsic: write to stdout without newline
  print(x)
end

def puts(x: String) -> Unit
  # Compiler intrinsic: write to stdout with newline
  puts(x)
end

def format(fmt: String, args: Array[String]) -> String
  # Replace {} placeholders with arguments in order.
  # Supports:
  #   {} — positional replacement (next argument)
  #   {0}, {1}, ... — indexed replacement
  #   {{ — literal left brace
  #   }} — literal right brace
  
  mut result = ""
  mut arg_idx = 0
  mut i = 0
  let chars = fmt.chars()
  let len = chars.len()
  
  while i < len do
    let ch = chars[i]
    
    if ch == '{' then
      if i + 1 < len && chars[i + 1] == '{' then
        # Escaped: {{ → literal {
        result = result + "{"
        i = i + 2
      else
        # Find closing }
        let start = i + 1
        mut end_idx = start
        while end_idx < len && chars[end_idx] != '}' do
          end_idx = end_idx + 1
        end
        
        if end_idx >= len then
          # No closing brace found — emit as-is
          result = result + "{"
          i = i + 1
        else
          let inner = fmt.slice(start, end_idx)
          if inner.is_empty() then
            # {} — use next positional argument
            if arg_idx < args.len() then
              result = result + args[arg_idx]
              arg_idx = arg_idx + 1
            else
              result = result + "{}"
            end
          else
            # {N} — indexed argument
            match parse_int(inner)
            when Option::Some(idx) then
              if idx >= 0 && idx < args.len() then
                result = result + args[idx]
              else
                result = result + "{" + inner + "}"
              end
            when Option::None then
              # Unknown format spec — pass through
              result = result + "{" + inner + "}"
            end
          end
          i = end_idx + 1
        end
      end
    else if ch == '}' && i + 1 < len && chars[i + 1] == '}' then
      # Escaped: }} → literal }
      result = result + "}"
      i = i + 2
    else
      result = result + ch.to_string()
      i = i + 1
    end
  end
  
  result
end

def parse_int(s: String) -> Option[Int]
  if s.is_empty() then return Option::None end
  mut result = 0
  mut negative = false
  mut start = 0
  if s.char_at(0) == '-' then
    negative = true
    start = 1
  end
  mut i = start
  let chars = s.chars()
  while i < chars.len() do
    let ch = chars[i]
    if ch >= '0' && ch <= '9' then
      result = result * 10 + (ch.to_int() - '0'.to_int())
    else
      return Option::None
    end
    i = i + 1
  end
  if negative then result = -result end
  Option::Some(result)
end

def to_string(x: Int) -> String
  # Compiler intrinsic: integer to string conversion
  to_string(x)
end

def int_to_string(x: Int) -> String
  to_string(x)
end

def bool_to_string(x: Bool) -> String
  if x
    "true"
  else
    "false"
  end
end
