# Tangerine Standard Library — std::effects
# Effect tracking and analysis for algebraic effects and side-effect management
#
# This module provides types and functions for tracking, analyzing, and
# enforcing effect disciplines in Tangerine programs.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}

# ———————————————————————————————————————————————————————————————
# Core Effect Types
# ———————————————————————————————————————————————————————————————

enum EffectKind
  Pure          # No side effects
  IO            # Console/file I/O
  State         # Mutable state
  Exception     # May throw/panic
  Async         # Asynchronous operations
  Resource      # Resource acquisition/release
  Custom(String)
end

# Effect is the runtime representation for effect tracking and enforcement.
# It is distinct from tg_compiler::ast::EffectDecl, which is the AST node
# produced by the parser for `effect` declarations.
struct Effect
  kind: EffectKind
  name: String
  description: Option[String]
end

struct EffectSignature
  fn_name: String
  effects: Set[String]
  inferred: Bool
end

struct EffectViolation
  fn_name: String
  declared: Set[String]
  actual: Set[String]
  missing: Vec[String]
end

enum EffectCheckResult
  Clean
  Violations(Vec[EffectViolation])
end

# ———————————————————————————————————————————————————————————————
# Built-in Effects
# ———————————————————————————————————————————————————————————————

def pure_effect() -> Effect
  Effect {
    kind: EffectKind::Pure,
    name: "Pure",
    description: Option::Some("No side effects")
  }
end

def io_effect() -> Effect
  Effect {
    kind: EffectKind::IO,
    name: "IO",
    description: Option::Some("Input/output operations")
  }
end

def state_effect() -> Effect
  Effect {
    kind: EffectKind::State,
    name: "State",
    description: Option::Some("Mutable state modification")
  }
end

def exception_effect() -> Effect
  Effect {
    kind: EffectKind::Exception,
    name: "Exception",
    description: Option::Some("May panic or throw")
  }
end

def async_effect() -> Effect
  Effect {
    kind: EffectKind::Async,
    name: "Async",
    description: Option::Some("Asynchronous execution")
  }
end

def resource_effect() -> Effect
  Effect {
    kind: EffectKind::Resource,
    name: "Resource",
    description: Option::Some("Resource lifecycle management")
  }
end

def custom_effect(name: String) -> Effect
  Effect {
    kind: EffectKind::Custom(name),
    name: name,
    description: Option::None
  }
end

# ———————————————————————————————————————————————————————————————
# Effect Inference
# ———————————————————————————————————————————————————————————————

# STUB: This is a placeholder implementation using simple string matching.
# A production implementation should walk the AST and resolve effect annotations
# transitively through the call graph. See tg_compiler/resolver.tg for the
# planned AST-based inference pass.
def infer_effects_from_body(body: String) -> Set[String]
  let effects = Set::new()
  
  # Scan body for effect-inducing operations
  if body.contains("print") || body.contains("read") || body.contains("write")
    effects.insert("IO")
  end
  
  if body.contains("&mut ") || body.contains(".set(") || body.contains(" = ")
    effects.insert("State")
  end
  
  if body.contains("panic") || body.contains("unwrap") || body.contains("expect")
    effects.insert("Exception")
  end
  
  if body.contains("await") || body.contains("spawn") || body.contains("async")
    effects.insert("Async")
  end
  
  if body.contains("open(") || body.contains("close(") || body.contains("acquire")
    effects.insert("Resource")
  end
  
  if effects.is_empty()
    effects.insert("Pure")
  end
  
  effects
end

def extract_declared_effects(source: String, fn_name: String) -> Set[String]
  let effects = Set::new()
  let lines = source.lines()
  let in_function = false
  
  for line in lines
    let trimmed = line.trim()
    
    # Check if we're entering the target function
    if trimmed.starts_with("def " + fn_name)
      in_function = true
    else if in_function && trimmed.starts_with("def ")
      in_function = false
    end
    
    # Extract effect annotations within function
    if in_function && trimmed.starts_with("@")
      let effect_name = trimmed.slice(1, trimmed.len()).trim()
      effects.insert(effect_name)
    end
  end
  
  effects
end

# ———————————————————————————————————————————————————————————————
# Effect Checking
# ———————————————————————————————————————————————————————————————

def check_effect_soundness(declared: Set[String], actual: Set[String]) -> Option[Vec[String]]
  let missing = Vec::new()
  
  for eff in actual
    if eff != "Pure" && !declared.contains(eff)
      missing.push(eff)
    end
  end
  
  if missing.is_empty()
    Option::None
  else
    Option::Some(missing)
  end
end

def analyze_function(source: String, fn_name: String) -> EffectSignature
  let declared = extract_declared_effects(source, fn_name)
  let body = extract_function_body(source, fn_name)
  let inferred = infer_effects_from_body(body)
  
  # Merge declared and inferred
  let final_effects = if declared.is_empty()
    inferred
  else
    declared
  end
  
  EffectSignature {
    fn_name: fn_name,
    effects: final_effects,
    inferred: declared.is_empty()
  }
end

def extract_function_body(source: String, fn_name: String) -> String
  let lines = source.lines()
  let body = Vec::new()
  let in_function = false
  let depth = 0
  
  for line in lines
    let trimmed = line.trim()
    
    if trimmed.starts_with("def " + fn_name)
      in_function = true
      depth = 1
    else if in_function
      if trimmed == "end"
        depth = depth - 1
        if depth == 0
          in_function = false
        end
      else
        if trimmed.ends_with(" do") || trimmed.starts_with("if ") || 
           trimmed.starts_with("for ") || trimmed.starts_with("while ") ||
           trimmed.starts_with("match ")
          depth = depth + 1
        end
        body.push(line)
      end
    end
  end
  
  body.join("\n")
end

# ———————————————————————————————————————————————————————————————
# Program-Wide Analysis
# ———————————————————————————————————————————————————————————————

def analyze_program_effects(source: String) -> Vec[EffectSignature]
  let signatures = Vec::new()
  let fn_names = extract_function_names(source)
  
  for name in fn_names
    signatures.push(analyze_function(source, name))
  end
  
  signatures
end

def extract_function_names(source: String) -> Vec[String]
  let names = Vec::new()
  let lines = source.lines()
  
  for line in lines
    let trimmed = line.trim()
    if trimmed.starts_with("def ")
      let rest = trimmed.slice(4, trimmed.len())
      let paren_idx = rest.find("(").unwrap_or(rest.len())
      let name = rest.slice(0, paren_idx)
      names.push(name)
    end
  end
  
  names
end

def check_all_effects(source: String) -> EffectCheckResult
  let violations = Vec::new()
  let fn_names = extract_function_names(source)
  
  for name in fn_names
    let declared = extract_declared_effects(source, name)
    let body = extract_function_body(source, name)
    let actual = infer_effects_from_body(body)
    
    match check_effect_soundness(declared, actual)
      Option::Some(missing) =>
        violations.push(EffectViolation {
          fn_name: name,
          declared: declared,
          actual: actual,
          missing: missing
        })
      Option::None => ()
    end
  end
  
  if violations.is_empty()
    EffectCheckResult::Clean
  else
    EffectCheckResult::Violations(violations)
  end
end

# ———————————————————————————————————————————————————————————————
# Pretty Printing
# ———————————————————————————————————————————————————————————————

def format_effect(e: Effect) -> String
  let base = "@" + e.name
  match e.description
    Option::Some(desc) => base + " # " + desc
    Option::None => base
  end
end

def format_signature(sig: EffectSignature) -> String
  let inferred_marker = if sig.inferred then " (inferred)" else "" end
  let effects_str = sig.effects.to_vec().join(", ")
  sig.fn_name + ": {" + effects_str + "}" + inferred_marker
end

def format_violation(v: EffectViolation) -> String
  let declared_str = v.declared.to_vec().join(", ")
  let actual_str = v.actual.to_vec().join(", ")
  let missing_str = v.missing.join(", ")
  v.fn_name + ": declared {" + declared_str + "}, actual {" + actual_str + "}, missing: " + missing_str
end

def format_check_result(r: EffectCheckResult) -> String
  match r
    EffectCheckResult::Clean =>
      "✓ All effect annotations are sound"
    EffectCheckResult::Violations(vs) =>
      let lines = Vec::new()
      lines.push("✗ Effect violations found:")
      for v in vs
        lines.push("  - " + format_violation(v))
      end
      lines.join("\n")
  end
end
