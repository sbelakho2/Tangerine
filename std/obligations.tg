# Tangerine Standard Library — std::obligations
# Unified proof obligations framework across compiler and libraries.
# Spec reference: TG-OBL-SPEC-001 v0.1

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{Map, Set}
use std::gfx_errors::{Error, ErrorCode}
use std::contracts::{ContractKind, ProofObligation}

# [METADATA]
# module: tg::obligations
# status: alpha
# effects: []
# capabilities: []
# error_codes: [ObligationUnsatisfied, InvalidContext, Internal]
# description: "Unified proof obligations framework for static and dynamic verification."
# examples:
#   - |
#     use std::obligations::{ObligationRegistry, Context}
#     let mut reg = ObligationRegistry::new()
#     reg.add_obligation("my_func", ContractKind::Pre, "x > 0")

# ———————————————————————————————————————————————————————————————
# Core Types
# ———————————————————————————————————————————————————————————————

enum ObligationSeverity
  Informational
  Warning
  Error        # Must be verified/discharged
  Critical     # Hard safety requirement
end

struct ObligationContext
  id: String
  file: String
  line: Int
  column: Int
  function_name: String
  call_stack: Vec[String]
end

struct EnhancedObligation
  inner: ProofObligation
  severity: ObligationSeverity
  context: ObligationContext
  evidence: Option[String]
  discharged_by: Option[String] # ID of the proof or runtime check that discharged it
end

# ———————————————————————————————————————————————————————————————
# Obligation Registry
# ———————————————————————————————————————————————————————————————

struct ObligationRegistry
  obligations: Map[String, EnhancedObligation]
  pending_count: Int
  verified_count: Int
  failed_count: Int
end

impl ObligationRegistry
  def new() -> Self
    ObligationRegistry {
      obligations: Map::new(),
      pending_count: 0,
      verified_count: 0,
      failed_count: 0,
    }
  end

  def add_obligation(
    inout self,
    origin: String,
    kind: ContractKind,
    expr: String,
    ctx: ObligationContext,
    severity: ObligationSeverity
  ) -> String
    let id = "OBL-" + origin + "-" + self.obligations.len().to_string()
    let ob = EnhancedObligation {
      inner: ProofObligation {
        origin: origin,
        kind: kind,
        expr: expr,
        verified: false,
      },
      severity: severity,
      context: ctx,
      evidence: Option::None,
      discharged_by: Option::None,
    }
    self.obligations.insert(id.clone(), ob)
    self.pending_count = self.pending_count + 1
    id
  end

  def discharge(inout self, id: String, evidence: String, proof_id: String) -> Result[Unit, String]
    match self.obligations.get_mut(id)
    when Option::Some(mut ob) then
      if ob.inner.verified then
        return Result::Err("Obligation already discharged")
      end
      ob.inner.verified = true
      ob.evidence = Option::Some(evidence)
      ob.discharged_by = Option::Some(proof_id)
      self.pending_count = self.pending_count - 1
      self.verified_count = self.verified_count + 1
      Result::Ok(())
    when Option::None then
      Result::Err("Obligation not found")
    end
  end

  def fail(inout self, id: String, error_msg: String) -> Result[Unit, String]
    match self.obligations.get_mut(id)
    when Option::Some(mut ob) then
      if ob.inner.verified then
        return Result::Err("Cannot fail already verified obligation")
      end
      ob.evidence = Option::Some("FAILURE: " + error_msg)
      self.pending_count = self.pending_count - 1
      self.failed_count = self.failed_count + 1
      Result::Ok(())
    when Option::None then
      Result::Err("Obligation not found")
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Diagnostics & Integration
# ———————————————————————————————————————————————————————————————

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}
use std::time::{instant_now, duration_nanos}
use std::ctx

def emit_obligation_diagnostic(ob: EnhancedObligation) -> Unit
  let level = match ob.severity
    when ObligationSeverity::Informational then LogLevel::Info
    when ObligationSeverity::Warning then LogLevel::Warn
    when ObligationSeverity::Error then LogLevel::Error
    when ObligationSeverity::Critical then LogLevel::Error
  end

  let msg = "[OBLIGATION] " + ob.inner.origin + ": " + ob.inner.expr
  
  # Log via central diagnostics
  let entry = LogEntry {
    timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
    level: level,
    category: LogCategory::App,
    message: msg,
    correlation_id: "",
  }
  
  # Capture ctxpack evidence
  let mut seeds = Vec::new()
  seeds.push("obligation::" + ob.inner.origin)
  match std::ctx::build_pack(seeds, 1000)
  when Ok(pack) then
    std::ctx::register_pack(pack)
  when Err(_) then {}
  end
end

# ———————————————————————————————————————————————————————————————
# Global Registry (Singleton pattern for compiler/runtime)
# ———————————————————————————————————————————————————————————————

mut GLOBAL_REGISTRY: Option[ObligationRegistry] = Option::None

def get_global_registry() -> PtrMut[ObligationRegistry]
  match GLOBAL_REGISTRY
  when Option::Some(mut r) then r as PtrMut[ObligationRegistry]
  when Option::None then
    GLOBAL_REGISTRY = Option::Some(ObligationRegistry::new())
    get_global_registry()
  end
end
