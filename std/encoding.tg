# Tangerine Standard Library — tg::encoding
# Binary and text encodings (Base64, Hex).
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 30.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::gfx_errors::{Error, ErrorCode}

# [METADATA]
# module: tg::encoding
# status: alpha
# effects: []
# capabilities: []
# error_codes: [InvalidInput, BufferFull, Internal]

enum EncodingError
  InvalidInput(Error)
  BufferFull(Error)
  Internal(Error)
end

impl EncodingError
  def message(self: &EncodingError) -> &String
    match self
    when EncodingError::InvalidInput(e) then &e.message
    when EncodingError::BufferFull(e) then &e.message
    when EncodingError::Internal(e) then &e.message
    end
  end

  def code(self: &EncodingError) -> ErrorCode
    match self
    when EncodingError::InvalidInput(_) then ErrorCode::InvalidArg
    when EncodingError::BufferFull(_) then ErrorCode::OutOfMemory
    when EncodingError::Internal(_) then ErrorCode::Internal
    end
  end
end

def hex_encode(data: &[u8]) -> String
  let mut s = "".to_string()
  let hex_chars = "0123456789abcdef".to_string()
  let mut i = 0
  while i < data.len() do
    let b = data[i]
    let high = (b >> 4) as Int
    let low = (b & 0x0f) as Int
    s.push(hex_chars.as_bytes()[high] as Char)
    s.push(hex_chars.as_bytes()[low] as Char)
    i = i + 1
  end
  s
end

def hex_decode(s: &str) -> Result[Vec[u8], EncodingError]
  if s.len() % 2 != 0 then
    return Result::Err(EncodingError::InvalidInput(Error::new(ErrorCode::InvalidArg, "Hex string must have even length".to_string())))
  end
  
  let mut data = Vec[u8].new()
  let mut i = 0
  while i < s.len() do
    let high = _hex_val(s.as_bytes()[i])?
    let low = _hex_val(s.as_bytes()[i+1])?
    data.push(((high << 4) | low) as u8)
    i = i + 2
  end
  Result::Ok(data)
end

def _hex_val(c: u8) -> Result[Int, EncodingError]
  if c >= 48 && c <= 57 then # 0-9
    Result::Ok((c - 48) as Int)
  elsif c >= 97 && c <= 102 then # a-f
    Result::Ok((c - 97 + 10) as Int)
  elsif c >= 65 && c <= 70 then # A-F
    Result::Ok((c - 65 + 10) as Int)
  else
    Result::Err(EncodingError::InvalidInput(Error::new(ErrorCode::InvalidArg, "Invalid hex character".to_string())))
  end
end
