## ---------------------------------------------------------------
## tg::diagnostics — Runtime diagnostics and observability
## Covers §27 of TG-GFX-UI-SPEC-001 v0.1
## ---------------------------------------------------------------

use std::fmt
use std::collections
use std::time

# [METADATA]
# module: tg::diagnostics
# status: alpha
# effects: []
# capabilities: []
# error_codes: [InvalidArg, Internal]

use std::core::{Option, Result, String, Bool, Int, Unit, Vec, List, Map}
use std::gfx_errors::{Error, ErrorCode}

enum DiagnosticError
  InvalidArg(Error)
  Internal(Error)
end

impl DiagnosticError
  def message(self: &DiagnosticError) -> &String
    match self
    when DiagnosticError::InvalidArg(e) then &e.message
    when DiagnosticError::Internal(e) then &e.message
    end
  end

  def code(self: &DiagnosticError) -> ErrorCode
    match self
    when DiagnosticError::InvalidArg(_) then ErrorCode::InvalidArg
    when DiagnosticError::Internal(_) then ErrorCode::Internal
    end
  end
end

## ---------------------------------------------------------------
## 27.1  Structured logging categories
## ---------------------------------------------------------------

enum LogCategory
  App
  Events
  Gfx
  Text
  Ui
  Assets
  Abi
  Loader
  Accessibility
end

enum LogLevel
  Trace
  Debug
  Info
  Warn
  Error
end

struct LogEntry
  timestamp_ns: u64
  level: LogLevel
  category: LogCategory
  message: String
  correlation_id: String
end

trait Logger
  def log(entry: LogEntry) -> Nil
  def is_enabled(level: LogLevel, category: LogCategory) -> Bool
end

struct FilteredLogger
  min_level: LogLevel
  enabled_categories: List[LogCategory]
  entries: List[LogEntry]
  max_entries: u64
end

impl FilteredLogger
  def new(min_level: LogLevel, max_entries: u64) -> FilteredLogger
    FilteredLogger {
      min_level: min_level,
      enabled_categories: List.new(),
      entries: List.new(),
      max_entries: max_entries,
    }
  end

  def enable_all() -> Nil
    self.enabled_categories = List.of(
      LogCategory::App, LogCategory::Events, LogCategory::Gfx,
      LogCategory::Text, LogCategory::Ui, LogCategory::Assets,
      LogCategory::Abi, LogCategory::Loader,
    )
  end
end

impl Logger for FilteredLogger
  def log(entry: LogEntry) -> Nil
    if self.entries.len() as u64 >= self.max_entries
      self.entries.remove(0)
    end
    self.entries.push(entry)
  end

  def is_enabled(level: LogLevel, category: LogCategory) -> Bool
    true  ## simplified; full impl would check ordinal
  end
end

enum DiagnosticFixAction
  Insert(line: Int, col: Int, text: String)
  Delete(line: Int, col: Int, len: Int)
  Replace(line: Int, col: Int, len: Int, text: String)
end

struct FixIt
  title: String
  action: DiagnosticFixAction
end

struct Diagnostic
  code: String
  message: String
  span_start_line: Int
  span_start_col: Int
  span_end_line: Int
  span_end_col: Int
  fix_its: List[FixIt]
end

## ---------------------------------------------------------------
## 27.2  Startup diagnostics
## ---------------------------------------------------------------

struct StartupDiagnostics
  backend_name: String
  backend_version: String
  abi_version_major: u32
  abi_version_minor: u32
  deterministic_raster: Bool
  gpu_nondeterminism_possible: Bool
  capabilities: List[String]
  platform: String
  build_id: String
end

impl StartupDiagnostics
  def summary() -> String
    fmt::format(
      "Backend: {} v{}  ABI: {}.{}  Deterministic: {}  GPU-Nondet: {}  Platform: {}  Build: {}",
      self.backend_name,
      self.backend_version,
      self.abi_version_major,
      self.abi_version_minor,
      self.deterministic_raster,
      self.gpu_nondeterminism_possible,
      self.platform,
      self.build_id,
    )
  end

  def capability_list() -> String
    self.capabilities.join(", ")
  end
end

## ---------------------------------------------------------------
## 27.3  UI tree diagnostic dump
## ---------------------------------------------------------------

struct UiDiagNode
  widget_type: String
  rect_x: f32
  rect_y: f32
  rect_w: f32
  rect_h: f32
  focused: Bool
  visible: Bool
  children: List[UiDiagNode]
end

def dump_ui_tree(root: UiDiagNode, indent: u32) -> String
  let prefix = " ".repeat(indent * 2)
  let focus_marker = if root.focused then " [FOCUS]" else "" end
  let vis_marker = if root.visible then "" else " [HIDDEN]" end
  let mut out = fmt::format(
    "{}{} ({:.0},{:.0} {:.0}x{:.0}){}{}\n",
    prefix, root.widget_type,
    root.rect_x, root.rect_y, root.rect_w, root.rect_h,
    focus_marker, vis_marker,
  )
  for child in root.children
    out = out + dump_ui_tree(child, indent + 1u32)
  end
  out
end

## ---------------------------------------------------------------
## 27.4  Compositor diagnostic dump
## ---------------------------------------------------------------

struct LayerDiag
  layer_id: u64
  x: f32
  y: f32
  width: f32
  height: f32
  dirty: Bool
  opacity: f32
end

struct CompositorDiag
  layers: List[LayerDiag]
  damage_rects: List[String]
  full_redraw: Bool
end

impl CompositorDiag
  def dump() -> String
    let mut out = fmt::format("Compositor: {} layers, full_redraw={}\n", self.layers.len(), self.full_redraw)
    for layer in self.layers
      out = out + fmt::format(
        "  Layer {} ({:.0},{:.0} {:.0}x{:.0}) dirty={} opacity={:.2}\n",
        layer.layer_id, layer.x, layer.y, layer.width, layer.height,
        layer.dirty, layer.opacity,
      )
    end
    if !self.damage_rects.is_empty()
      out = out + "  Damage: " + self.damage_rects.join(", ") + "\n"
    end
    out
  end
end

## ---------------------------------------------------------------
## 27.5  Frame capture for troubleshooting
## ---------------------------------------------------------------

struct FrameCapture
  frame_id: u64
  width: u32
  height: u32
  pixel_data: List[u8]
  capture_time_ns: u64
end

impl FrameCapture
  def is_valid() -> Bool
    let expected = (self.width as u64) * (self.height as u64) * 4u64
    (self.pixel_data.len() as u64) == expected
  end

  def size_bytes() -> u64
    self.pixel_data.len() as u64
  end
end

## ---------------------------------------------------------------
## 27.6  Error codes and correlation IDs
## ---------------------------------------------------------------

struct RuntimeError
  code: u32
  category: LogCategory
  message: String
  correlation_id: String
  timestamp_ns: u64
  backend_id: String
  interface_version: String
end

## Stable error code ranges (non-overlapping)
let ERROR_RANGE_APP: u32       = 1000u32
let ERROR_RANGE_GFX: u32      = 2000u32
let ERROR_RANGE_TEXT: u32      = 3000u32
let ERROR_RANGE_IMAGE: u32    = 4000u32
let ERROR_RANGE_UI: u32       = 5000u32
let ERROR_RANGE_ABI: u32      = 6000u32
let ERROR_RANGE_PLATFORM: u32 = 7000u32
let ERROR_RANGE_GPU: u32      = 8000u32

impl RuntimeError
  def formatted() -> String
    fmt::format(
      "[TG-{:04}] {} (backend={}, iface={}, corr={})",
      self.code, self.message,
      self.backend_id, self.interface_version, self.correlation_id,
    )
  end
end

## ---------------------------------------------------------------
## 27.7  Consistency report metadata
## ---------------------------------------------------------------

struct ConsistencyReport
  build_id: String
  backend_id: String
  interface_versions: Map[String, String]
  platform_fingerprint: String
  test_run_id: String
  timestamp: String
end

impl ConsistencyReport
  def header() -> String
    fmt::format(
      "Consistency Report  build={}  backend={}  platform={}  run={}  ts={}",
      self.build_id, self.backend_id, self.platform_fingerprint,
      self.test_run_id, self.timestamp,
    )
  end
end

## ---------------------------------------------------------------
## 27.8  First-failure context capture
## ---------------------------------------------------------------

use std::ctx

struct FirstFailureContext
  error: RuntimeError
  ui_tree_dump: String
  compositor_dump: String
  frame_capture: Option[FrameCapture]
  recent_events: List[String]
  memory_snapshot: String
  ctx_pack: Option[std::ctx::CtxPack]
end

impl FirstFailureContext
  def dump_to_string() -> String
    let mut out = "=== FIRST FAILURE CONTEXT ===\n"
    out = out + "Error: " + self.error.formatted() + "\n"
    match &self.ctx_pack
    when Some(pack) then
      out = out + "CtxPack ID: " + pack.id + "\n"
    when None then {}
    end
    out = out + "--- UI Tree ---\n" + self.ui_tree_dump + "\n"
    out = out + "--- Compositor ---\n" + self.compositor_dump + "\n"
    out = out + "--- Recent Events ---\n"
    for evt in self.recent_events
      out = out + "  " + evt + "\n"
    end
    out = out + "--- Memory ---\n" + self.memory_snapshot + "\n"
    match self.frame_capture
    when Some(cap)
      out = out + fmt::format("--- Frame Capture: {}x{} ({} bytes) ---\n", cap.width, cap.height, cap.size_bytes())
    when None
      out = out + "--- No frame capture ---\n"
    end
    out
  end
end

## ---------------------------------------------------------------
## Tests
## ---------------------------------------------------------------

test "LogEntry creation" do
  let entry = LogEntry {
    timestamp_ns: 1000u64,
    level: LogLevel::Info,
    category: LogCategory::App,
    message: "App started",
    correlation_id: "abc-123",
  }
  assert entry.message == "App started"
end

test "StartupDiagnostics summary" do
  let diag = StartupDiagnostics {
    backend_name: "software",
    backend_version: "0.1.0",
    abi_version_major: 0u32,
    abi_version_minor: 1u32,
    deterministic_raster: true,
    gpu_nondeterminism_possible: false,
    capabilities: List.of("app", "gfx", "text"),
    platform: "macos-arm64",
    build_id: "build-001",
  }
  let s = diag.summary()
  assert s.contains("software")
  assert s.contains("0.1")
end

test "error code ranges are non-overlapping" do
  assert ERROR_RANGE_APP < ERROR_RANGE_GFX
  assert ERROR_RANGE_GFX < ERROR_RANGE_TEXT
  assert ERROR_RANGE_TEXT < ERROR_RANGE_IMAGE
  assert ERROR_RANGE_IMAGE < ERROR_RANGE_UI
  assert ERROR_RANGE_UI < ERROR_RANGE_ABI
  assert ERROR_RANGE_ABI < ERROR_RANGE_PLATFORM
  assert ERROR_RANGE_PLATFORM < ERROR_RANGE_GPU
end

test "FrameCapture validity check" do
  let cap = FrameCapture {
    frame_id: 1u64,
    width: 2u32,
    height: 2u32,
    pixel_data: List.of(0u8, 0u8, 0u8, 255u8, 0u8, 0u8, 0u8, 255u8,
                         0u8, 0u8, 0u8, 255u8, 0u8, 0u8, 0u8, 255u8),
    capture_time_ns: 0u64,
  }
  assert cap.is_valid()
  assert cap.size_bytes() == 16u64
end

test "RuntimeError formatting includes code and correlation" do
  let err = RuntimeError {
    code: 2001u32,
    category: LogCategory::Gfx,
    message: "Surface lost",
    correlation_id: "req-42",
    timestamp_ns: 0u64,
    backend_id: "vulkan",
    interface_version: "0.1",
  }
  let s = err.formatted()
  assert s.contains("TG-2001")
  assert s.contains("req-42")
end
