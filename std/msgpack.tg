# std::msgpack — MessagePack binary serialization
# Efficient binary format compatible with the MessagePack specification.

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::collections::{Map}
use std::gfx_errors::{Error, ErrorCode}

# ─── Value ───────────────────────────────────────────────────────────

enum Value
  Nil
  Bool(Bool)
  UInt(UInt)
  Int(Int)
  Float32(Float)
  Float64(Float)
  String(String)
  Binary(Vec[u8])
  Array(Vec[Value])
  Map(Vec[(Value, Value)])
  Extension(i8, Vec[u8])
end

impl Value
  def is_nil(self: Value) -> Bool
    match self
    when Value::Nil then true
    else false
    end
  end

  def as_bool(self: Value) -> Option[Bool]
    match self
    when Value::Bool(b) then Option::Some(b)
    else Option::None
    end
  end

  def as_int(self: Value) -> Option[Int]
    match self
    when Value::Int(i) then Option::Some(i)
    when Value::UInt(u) then Option::Some(u as Int)
    else Option::None
    end
  end

  def as_uint(self: Value) -> Option[UInt]
    match self
    when Value::UInt(u) then Option::Some(u)
    when Value::Int(i) then
      if i >= 0 then Option::Some(i as UInt) else Option::None end
    else Option::None
    end
  end

  def as_float(self: Value) -> Option[Float]
    match self
    when Value::Float32(f) then Option::Some(f)
    when Value::Float64(f) then Option::Some(f)
    when Value::Int(i) then Option::Some(i as Float)
    when Value::UInt(u) then Option::Some(u as Float)
    else Option::None
    end
  end

  def as_str(self: Value) -> Option[String]
    match self
    when Value::String(s) then Option::Some(s.clone())
    else Option::None
    end
  end

  def as_bytes(self: Value) -> Option[Vec[u8]]
    match self
    when Value::Binary(b) then Option::Some(b.clone())
    else Option::None
    end
  end

  def as_array(self: Value) -> Option[Vec[Value]]
    match self
    when Value::Array(a) then Option::Some(a.clone())
    else Option::None
    end
  end

  def as_map(self: Value) -> Option[Vec[(Value, Value)]]
    match self
    when Value::Map(m) then Option::Some(m.clone())
    else Option::None
    end
  end

  def get(self: Value, key: str) -> Option[Value]
    match self
    when Value::Map(entries) then
      for entry in entries do
        let (k, v) = entry
        match k
        when Value::String(s) then
          if s.as_str() == key then return Option::Some(v.clone()) end
        else ()
        end
      end
      Option::None
    else Option::None
    end
  end
end

# ─── Error ───────────────────────────────────────────────────────────

enum MsgPackError
  UnexpectedEof
  InvalidFormat(u8)
  InvalidUtf8
  NestedTooDeep
  DataTooLarge(UInt)
  TrailingData
  IoError(String)
end

def msgpack_error_message(e: MsgPackError) -> String
  match e
  when MsgPackError::UnexpectedEof then "MessagePack: unexpected end of input".to_string()
  when MsgPackError::InvalidFormat(b) then "MessagePack: invalid format byte 0x" + _hex_byte(b)
  when MsgPackError::InvalidUtf8 then "MessagePack: invalid UTF-8".to_string()
  when MsgPackError::NestedTooDeep then "MessagePack: nesting too deep".to_string()
  when MsgPackError::DataTooLarge(n) then "MessagePack: data too large: " + (n as Int).to_string()
  when MsgPackError::TrailingData then "MessagePack: trailing data".to_string()
  when MsgPackError::IoError(msg) then "MessagePack I/O: " + msg
  end  end  end
end

# ─── Encoder ─────────────────────────────────────────────────────────

struct Encoder
  output: Vec[u8]
end

def encoder_new() -> Encoder
  Encoder { output: Vec::new() }
end

impl Encoder
  def encode(inout self: Encoder, value: Value) -> Unit
    match value
    when Value::Nil then self.output.push(0xC0)
    when Value::Bool(b) then
      if b then self.output.push(0xC3) else self.output.push(0xC2) end
    when Value::UInt(u) then self._encode_uint(u)
    when Value::Int(i) then self._encode_int(i)
    when Value::Float32(f) then
      self.output.push(0xCA)
      self._write_f32(f)
    when Value::Float64(f) then
      self.output.push(0xCB)
      self._write_f64(f)
    when Value::String(s) then
      let bytes = s.as_bytes()
      self._encode_str_header(bytes.len() as UInt)
      for b in bytes do
        self.output.push(b)
      end
    when Value::Binary(data) then
      self._encode_bin_header(data.len() as UInt)
      for b in data do
        self.output.push(b)
      end
    when Value::Array(items) then
      self._encode_array_header(items.len() as UInt)
      for item in items do
        self.encode(&item)
      end
    when Value::Map(entries) then
      self._encode_map_header(entries.len() as UInt)
      for entry in entries do
        let (k, v) = entry
        self.encode(&k)
        self.encode(&v)
      end
    when Value::Extension(type_id, data) then
      self._encode_ext(type_id, &data)
    end
  end

  def into_bytes(self: Encoder) -> Vec[u8]
    self.output
  end

  def _encode_uint(inout self: Encoder, u: UInt) -> Unit
    if u <= 0x7F then
      self.output.push(u as u8)
    elsif u <= 0xFF then
      self.output.push(0xCC)
      self.output.push(u as u8)
    elsif u <= 0xFFFF then
      self.output.push(0xCD)
      self._write_u16(u)
    elsif u <= 0xFFFFFFFF then
      self.output.push(0xCE)
      self._write_u32(u)
    else
      self.output.push(0xCF)
      self._write_u64(u)
    end
  end

  def _encode_int(inout self: Encoder, i: Int) -> Unit
    if i >= 0 then
      self._encode_uint(i as UInt)
    elsif i >= -32 then
      self.output.push((i as u8) & 0xFF)
    elsif i >= -128 then
      self.output.push(0xD0)
      self.output.push((i as u8) & 0xFF)
    elsif i >= -32768 then
      self.output.push(0xD1)
      self._write_u16((i as UInt) & 0xFFFF)
    elsif i >= -2147483648 then
      self.output.push(0xD2)
      self._write_u32((i as UInt) & 0xFFFFFFFF)
    else
      self.output.push(0xD3)
      self._write_u64(i as UInt)
    end
  end

  def _encode_str_header(inout self: Encoder, len: UInt) -> Unit
    if len <= 31 then
      self.output.push(0xA0 | (len as u8))
    elsif len <= 0xFF then
      self.output.push(0xD9)
      self.output.push(len as u8)
    elsif len <= 0xFFFF then
      self.output.push(0xDA)
      self._write_u16(len)
    else
      self.output.push(0xDB)
      self._write_u32(len)
    end
  end

  def _encode_bin_header(inout self: Encoder, len: UInt) -> Unit
    if len <= 0xFF then
      self.output.push(0xC4)
      self.output.push(len as u8)
    elsif len <= 0xFFFF then
      self.output.push(0xC5)
      self._write_u16(len)
    else
      self.output.push(0xC6)
      self._write_u32(len)
    end
  end

  def _encode_array_header(inout self: Encoder, len: UInt) -> Unit
    if len <= 15 then
      self.output.push(0x90 | (len as u8))
    elsif len <= 0xFFFF then
      self.output.push(0xDC)
      self._write_u16(len)
    else
      self.output.push(0xDD)
      self._write_u32(len)
    end
  end

  def _encode_map_header(inout self: Encoder, len: UInt) -> Unit
    if len <= 15 then
      self.output.push(0x80 | (len as u8))
    elsif len <= 0xFFFF then
      self.output.push(0xDE)
      self._write_u16(len)
    else
      self.output.push(0xDF)
      self._write_u32(len)
    end
  end

  def _encode_ext(inout self: Encoder, type_id: i8, data: Vec[u8]) -> Unit
    let len = data.len() as UInt
    if len == 1 then
      self.output.push(0xD4)
    elsif len == 2 then
      self.output.push(0xD5)
    elsif len == 4 then
      self.output.push(0xD6)
    elsif len == 8 then
      self.output.push(0xD7)
    elsif len == 16 then
      self.output.push(0xD8)
    elsif len <= 0xFF then
      self.output.push(0xC7)
      self.output.push(len as u8)
    elsif len <= 0xFFFF then
      self.output.push(0xC8)
      self._write_u16(len)
    else
      self.output.push(0xC9)
      self._write_u32(len)
    end
    self.output.push(type_id as u8)
    for b in data do
      self.output.push(b)
    end
  end

  def _write_u16(inout self: Encoder, v: UInt) -> Unit
    self.output.push(((v >> 8) & 0xFF) as u8)
    self.output.push((v & 0xFF) as u8)
  end

  def _write_u32(inout self: Encoder, v: UInt) -> Unit
    let mut i = 0
    while i < 4 do
      self.output.push(((v >> ((3 - i) * 8)) & 0xFF) as u8)
      i = i + 1
    end
  end

  def _write_u64(inout self: Encoder, v: UInt) -> Unit
    let mut i = 0
    while i < 8 do
      self.output.push(((v >> ((7 - i) * 8)) & 0xFF) as u8)
      i = i + 1
    end
  end

  def _write_f32(inout self: Encoder, f: Float) -> Unit
    let bits = std::cbor::_float_to_f32_bits(f)
    self._write_u32(bits)
  end

  def _write_f64(inout self: Encoder, f: Float) -> Unit
    let bits = std::cbor::_float_to_f64_bits(f)
    self._write_u64(bits)
  end
end

# ─── Decoder ─────────────────────────────────────────────────────────

struct Decoder
  input: Vec[u8]
  pos: Int
  max_depth: Int
end

def decoder_new(input: Vec[u8]) -> Decoder
  Decoder { input: input, pos: 0, max_depth: 128 }
end

impl Decoder
  def decode(inout self: Decoder) -> Result[Value, MsgPackError]
    self._decode_value(0)
  end

  def _decode_value(inout self: Decoder, depth: Int) -> Result[Value, MsgPackError]
    if depth > self.max_depth then return Result::Err(MsgPackError::NestedTooDeep) end
    let b = self._read_byte()?

    # Positive fixint (0x00-0x7f)
    if b <= 0x7F then return Result::Ok(Value::UInt(b as UInt)) end
    # Negative fixint (0xe0-0xff)
    if b >= 0xE0 then return Result::Ok(Value::Int((b as i8) as Int)) end
    # Fixmap (0x80-0x8f)
    if b >= 0x80 && b <= 0x8F then
      let len = (b & 0x0F) as Int
      return self._read_map(len, depth)
    end
    # Fixarray (0x90-0x9f)
    if b >= 0x90 && b <= 0x9F then
      let len = (b & 0x0F) as Int
      return self._read_array(len, depth)
    end
    # Fixstr (0xa0-0xbf)
    if b >= 0xA0 && b <= 0xBF then
      let len = (b & 0x1F) as Int
      return self._read_string(len)
    end

    match b
    when 0xC0 then Result::Ok(Value::Nil)
    when 0xC2 then Result::Ok(Value::Bool(false))
    when 0xC3 then Result::Ok(Value::Bool(true))
    when 0xC4 then
      let len = self._read_byte()? as Int
      self._read_binary(len)
    when 0xC5 then
      let len = self._read_u16()? as Int
      self._read_binary(len)
    when 0xC6 then
      let len = self._read_u32()? as Int
      self._read_binary(len)
    when 0xC7 then
      let len = self._read_byte()? as Int
      let type_id = self._read_byte()? as i8
      let data = self._read_bytes(len)?
      Result::Ok(Value::Extension(type_id, data))
    when 0xC8 then
      let len = self._read_u16()? as Int
      let type_id = self._read_byte()? as i8
      let data = self._read_bytes(len)?
      Result::Ok(Value::Extension(type_id, data))
    when 0xC9 then
      let len = self._read_u32()? as Int
      let type_id = self._read_byte()? as i8
      let data = self._read_bytes(len)?
      Result::Ok(Value::Extension(type_id, data))
    when 0xCA then
      let bits = self._read_u32()?
      Result::Ok(Value::Float32(std::cbor::_f32_bits_to_float(bits)))
    when 0xCB then
      let bits = self._read_u64()?
      Result::Ok(Value::Float64(std::cbor::_f64_bits_to_float(bits)))
    when 0xCC then Result::Ok(Value::UInt(self._read_byte()? as UInt))
    when 0xCD then Result::Ok(Value::UInt(self._read_u16()?))
    when 0xCE then Result::Ok(Value::UInt(self._read_u32()?))
    when 0xCF then Result::Ok(Value::UInt(self._read_u64()?))
    when 0xD0 then Result::Ok(Value::Int((self._read_byte()? as i8) as Int))
    when 0xD1 then Result::Ok(Value::Int((self._read_u16()? as i16) as Int))
    when 0xD2 then Result::Ok(Value::Int((self._read_u32()? as i32) as Int))
    when 0xD3 then Result::Ok(Value::Int(self._read_u64()? as Int))
    when 0xD4 then
      let t = self._read_byte()? as i8
      let d = self._read_bytes(1)?
      Result::Ok(Value::Extension(t, d))
    when 0xD5 then
      let t = self._read_byte()? as i8
      let d = self._read_bytes(2)?
      Result::Ok(Value::Extension(t, d))
    when 0xD6 then
      let t = self._read_byte()? as i8
      let d = self._read_bytes(4)?
      Result::Ok(Value::Extension(t, d))
    when 0xD7 then
      let t = self._read_byte()? as i8
      let d = self._read_bytes(8)?
      Result::Ok(Value::Extension(t, d))
    when 0xD8 then
      let t = self._read_byte()? as i8
      let d = self._read_bytes(16)?
      Result::Ok(Value::Extension(t, d))
    when 0xD9 then
      let len = self._read_byte()? as Int
      self._read_string(len)
    when 0xDA then
      let len = self._read_u16()? as Int
      self._read_string(len)
    when 0xDB then
      let len = self._read_u32()? as Int
      self._read_string(len)
    when 0xDC then
      let len = self._read_u16()? as Int
      self._read_array(len, depth)
    when 0xDD then
      let len = self._read_u32()? as Int
      self._read_array(len, depth)
    when 0xDE then
      let len = self._read_u16()? as Int
      self._read_map(len, depth)
    when 0xDF then
      let len = self._read_u32()? as Int
      self._read_map(len, depth)
    else
      Result::Err(MsgPackError::InvalidFormat(b))
    end
  end

  def _read_byte(inout self: Decoder) -> Result[u8, MsgPackError]
    if self.pos >= self.input.len() as Int then return Result::Err(MsgPackError::UnexpectedEof) end
    let b = self.input.get(self.pos as UInt)
    self.pos = self.pos + 1
    Result::Ok(b)
  end

  def _read_bytes(inout self: Decoder, n: Int) -> Result[Vec[u8], MsgPackError]
    if self.pos + n > self.input.len() as Int then return Result::Err(MsgPackError::UnexpectedEof) end
    let mut result = Vec::with_capacity(n as UInt)
    let mut i = 0
    while i < n do
      result.push(self.input.get((self.pos + i) as UInt))
      i = i + 1
    end
    self.pos = self.pos + n
    Result::Ok(result)
  end

  def _read_u16(inout self: Decoder) -> Result[UInt, MsgPackError]
    let b0 = self._read_byte()? as UInt
    let b1 = self._read_byte()? as UInt
    Result::Ok((b0 << 8) | b1)
  end

  def _read_u32(inout self: Decoder) -> Result[UInt, MsgPackError]
    let mut v: UInt = 0
    let mut i = 0
    while i < 4 do
      v = (v << 8) | (self._read_byte()? as UInt)
      i = i + 1
    end
    Result::Ok(v)
  end

  def _read_u64(inout self: Decoder) -> Result[UInt, MsgPackError]
    let mut v: UInt = 0
    let mut i = 0
    while i < 8 do
      v = (v << 8) | (self._read_byte()? as UInt)
      i = i + 1
    end
    Result::Ok(v)
  end

  def _read_string(inout self: Decoder, len: Int) -> Result[Value, MsgPackError]
    let bytes = self._read_bytes(len)?
    match String::from_utf8(bytes)
    when Result::Ok(s) then Result::Ok(Value::String(s))
    when Result::Err(_) then Result::Err(MsgPackError::InvalidUtf8)
    end
  end

  def _read_binary(inout self: Decoder, len: Int) -> Result[Value, MsgPackError]
    let bytes = self._read_bytes(len)?
    Result::Ok(Value::Binary(bytes))
  end

  def _read_array(inout self: Decoder, len: Int, depth: Int) -> Result[Value, MsgPackError]
    let mut items = Vec::with_capacity(len as UInt)
    let mut i = 0
    while i < len do
      match self._decode_value(depth + 1)
      when Result::Ok(v) then items.push(v)
      when Result::Err(e) then return Result::Err(e)
      end
      i = i + 1
    end
    Result::Ok(Value::Array(items))
  end

  def _read_map(inout self: Decoder, len: Int, depth: Int) -> Result[Value, MsgPackError]
    let mut entries = Vec::with_capacity(len as UInt)
    let mut i = 0
    while i < len do
      let k = self._decode_value(depth + 1)?
      let v = self._decode_value(depth + 1)?
      entries.push((k, v))
      i = i + 1
    end
    Result::Ok(Value::Map(entries))
  end
end

def _hex_byte(b: u8) -> String
  let chars = "0123456789abcdef"
  let mut result = String::with_capacity(2)
  result.push(chars.char_at(((b >> 4) & 0x0F) as UInt))
  result.push(chars.char_at((b & 0x0F) as UInt))
  result
end

# ─── Convenience ─────────────────────────────────────────────────────

def msgpack_encode(value: Value) -> Vec[u8]
  let mut enc = encoder_new()
  enc.encode(value)
  enc.into_bytes()
end

def msgpack_decode(bytes: Vec[u8]) -> Result[Value, MsgPackError]
  let mut dec = decoder_new(bytes.clone())
  dec.decode()
end