## std::msgpack — MessagePack binary serialization
## Efficient binary format compatible with the MessagePack specification.
## Spec: §stdlib.msgpack

module std::msgpack

use std::core::{Option, Result, Display}
use std::collections::{Array, Map}

# ─── Value ───────────────────────────────────────────────────────────

pub enum Value
  Nil
  Bool(Bool)
  UInt(UInt)
  Int(Int)
  Float32(Float)
  Float64(Float)
  String(String)
  Binary(Vec[u8])
  Array(Vec[Value])
  Map(Vec[(Value, Value)])
  Extension(i8, Vec[u8])   ## type, data
end

impl Value
  pub def is_nil(self) -> Bool
    match self when Value.Nil then true else false end
  end

  pub def as_bool(self) -> Option[Bool]
    match self when Value.Bool(b) then Some(b) else None end
  end

  pub def as_int(self) -> Option[Int]
    match self
    when Value.Int(i) then Some(i)
    when Value.UInt(u) then Some(u as Int)
    else None
    end
  end

  pub def as_uint(self) -> Option[UInt]
    match self
    when Value.UInt(u) then Some(u)
    when Value.Int(i) then if i >= 0 then Some(i as UInt) else None end
    else None
    end
  end

  pub def as_float(self) -> Option[Float]
    match self
    when Value.Float32(f) then Some(f)
    when Value.Float64(f) then Some(f)
    when Value.Int(i) then Some(i as Float)
    when Value.UInt(u) then Some(u as Float)
    else None
    end
  end

  pub def as_str(self) -> Option[&String]
    match self when Value.String(ref s) then Some(s) else None end
  end

  pub def as_bytes(self) -> Option[&Vec[u8]]
    match self when Value.Binary(ref b) then Some(b) else None end
  end

  pub def as_array(self) -> Option[&Vec[Value]]
    match self when Value.Array(ref a) then Some(a) else None end
  end

  pub def as_map(self) -> Option[&Vec[(Value, Value)]>
    match self when Value.Map(ref m) then Some(m) else None end
  end

  ## Index into map by string key.
  pub def get(self, key: &str) -> Option[&Value]
    match self
    when Value.Map(ref entries) then
      for (k, v) in entries do
        match k
        when Value.String(ref s) then
          if s == key then return Some(v) end
        else {}
        end
      end
      None
    else None
    end
  end
end

# ─── Error ───────────────────────────────────────────────────────────

pub enum MsgPackError
  UnexpectedEof
  InvalidFormat(u8)
  InvalidUtf8
  NestedTooDeep
  DataTooLarge(UInt)
  TrailingData
  IoError(String)
end

impl Display for MsgPackError
  def fmt(self, f: &mut fmt::Formatter) -> fmt::Result
    match self
    when MsgPackError.UnexpectedEof then f.write_str("MessagePack: unexpected end of input")
    when MsgPackError.InvalidFormat(b) then f.write_str("MessagePack: invalid format byte 0x" + _hex_byte(b))
    when MsgPackError.InvalidUtf8 then f.write_str("MessagePack: invalid UTF-8")
    when MsgPackError.NestedTooDeep then f.write_str("MessagePack: nesting too deep")
    when MsgPackError.DataTooLarge(n) then f.write_str("MessagePack: data too large: " + n.to_string())
    when MsgPackError.TrailingData then f.write_str("MessagePack: trailing data")
    when MsgPackError.IoError(msg) then f.write_str("MessagePack I/O: " + msg)
    end
  end
end

# ─── Encoder ─────────────────────────────────────────────────────────

pub struct Encoder
  output: Vec[u8]
end

impl Encoder
  pub def new() -> Encoder
    Encoder { output: Vec[u8].new() }
  end

  pub def encode(&mut self, value: &Value) -> Unit
    match value
    when Value.Nil then self.output.push(0xc0)
    when Value.Bool(b) then self.output.push(if *b then 0xc3 else 0xc2 end)
    when Value.UInt(u) then self._encode_uint(*u)
    when Value.Int(i) then self._encode_int(*i)
    when Value.Float32(f) then
      self.output.push(0xca)
      self._write_f32(*f)
    when Value.Float64(f) then
      self.output.push(0xcb)
      self._write_f64(*f)
    when Value.String(ref s) then
      let bytes = s.as_bytes()
      self._encode_str_header(bytes.len() as UInt)
      self.output.extend(&bytes)
    when Value.Binary(ref data) then
      self._encode_bin_header(data.len() as UInt)
      self.output.extend(data)
    when Value.Array(ref items) then
      self._encode_array_header(items.len() as UInt)
      for item in items do self.encode(item) end
    when Value.Map(ref entries) then
      self._encode_map_header(entries.len() as UInt)
      for (k, v) in entries do
        self.encode(k)
        self.encode(v)
      end
    when Value.Extension(type_id, ref data) then
      self._encode_ext(*type_id, data)
    end
  end

  pub def into_bytes(self) -> Vec[u8] = self.output

  def _encode_uint(&mut self, u: UInt) -> Unit
    if u <= 0x7F then
      self.output.push(u as u8)
    elsif u <= 0xFF then
      self.output.push(0xcc)
      self.output.push(u as u8)
    elsif u <= 0xFFFF then
      self.output.push(0xcd)
      self._write_u16(u)
    elsif u <= 0xFFFFFFFF then
      self.output.push(0xce)
      self._write_u32(u)
    else
      self.output.push(0xcf)
      self._write_u64(u)
    end
  end

  def _encode_int(&mut self, i: Int) -> Unit
    if i >= 0 then
      self._encode_uint(i as UInt)
    elsif i >= -32 then
      self.output.push((i as u8) & 0xFF)  ## negative fixint
    elsif i >= -128 then
      self.output.push(0xd0)
      self.output.push((i as u8) & 0xFF)
    elsif i >= -32768 then
      self.output.push(0xd1)
      self._write_u16((i as UInt) & 0xFFFF)
    elsif i >= -2147483648 then
      self.output.push(0xd2)
      self._write_u32((i as UInt) & 0xFFFFFFFF)
    else
      self.output.push(0xd3)
      self._write_u64(i as UInt)
    end
  end

  def _encode_str_header(&mut self, len: UInt) -> Unit
    if len <= 31 then
      self.output.push(0xa0 | (len as u8))
    elsif len <= 0xFF then
      self.output.push(0xd9)
      self.output.push(len as u8)
    elsif len <= 0xFFFF then
      self.output.push(0xda)
      self._write_u16(len)
    else
      self.output.push(0xdb)
      self._write_u32(len)
    end
  end

  def _encode_bin_header(&mut self, len: UInt) -> Unit
    if len <= 0xFF then
      self.output.push(0xc4)
      self.output.push(len as u8)
    elsif len <= 0xFFFF then
      self.output.push(0xc5)
      self._write_u16(len)
    else
      self.output.push(0xc6)
      self._write_u32(len)
    end
  end

  def _encode_array_header(&mut self, len: UInt) -> Unit
    if len <= 15 then
      self.output.push(0x90 | (len as u8))
    elsif len <= 0xFFFF then
      self.output.push(0xdc)
      self._write_u16(len)
    else
      self.output.push(0xdd)
      self._write_u32(len)
    end
  end

  def _encode_map_header(&mut self, len: UInt) -> Unit
    if len <= 15 then
      self.output.push(0x80 | (len as u8))
    elsif len <= 0xFFFF then
      self.output.push(0xde)
      self._write_u16(len)
    else
      self.output.push(0xdf)
      self._write_u32(len)
    end
  end

  def _encode_ext(&mut self, type_id: i8, data: &Vec[u8]) -> Unit
    let len = data.len() as UInt
    match len
    when 1 then self.output.push(0xd4)
    when 2 then self.output.push(0xd5)
    when 4 then self.output.push(0xd6)
    when 8 then self.output.push(0xd7)
    when 16 then self.output.push(0xd8)
    else
      if len <= 0xFF then
        self.output.push(0xc7)
        self.output.push(len as u8)
      elsif len <= 0xFFFF then
        self.output.push(0xc8)
        self._write_u16(len)
      else
        self.output.push(0xc9)
        self._write_u32(len)
      end
    end
    self.output.push(type_id as u8)
    self.output.extend(data)
  end

  def _write_u16(&mut self, v: UInt) -> Unit
    self.output.push(((v >> 8) & 0xFF) as u8)
    self.output.push((v & 0xFF) as u8)
  end

  def _write_u32(&mut self, v: UInt) -> Unit
    for i in (0..4).rev() do
      self.output.push(((v >> (i * 8)) & 0xFF) as u8)
    end
  end

  def _write_u64(&mut self, v: UInt) -> Unit
    for i in (0..8).rev() do
      self.output.push(((v >> (i * 8)) & 0xFF) as u8)
    end
  end

  def _write_f32(&mut self, f: Float) -> Unit
    let bits = std::cbor::_float_to_f32_bits(f)
    self._write_u32(bits)
  end

  def _write_f64(&mut self, f: Float) -> Unit
    let bits = std::cbor::_float_to_f64_bits(f)
    self._write_u64(bits)
  end
end

# ─── Decoder ─────────────────────────────────────────────────────────

pub struct Decoder
  input: Vec[u8]
  pos: Int
  max_depth: Int
end

impl Decoder
  pub def new(input: Vec[u8]) -> Decoder
    Decoder { input: input, pos: 0, max_depth: 128 }
  end

  pub def decode(&mut self) -> Result[Value, MsgPackError]
    self._decode_value(0)
  end

  def _decode_value(&mut self, depth: Int) -> Result[Value, MsgPackError]
    if depth > self.max_depth then return Err(MsgPackError.NestedTooDeep) end
    let b = self._read_byte()?

    ## Positive fixint (0x00-0x7f)
    if b <= 0x7f then return Ok(Value.UInt(b as UInt)) end
    ## Negative fixint (0xe0-0xff)
    if b >= 0xe0 then return Ok(Value.Int(((b as i8) as Int))) end
    ## Fixmap (0x80-0x8f)
    if b >= 0x80 && b <= 0x8f then
      let len = (b & 0x0f) as Int
      return self._read_map(len, depth)
    end
    ## Fixarray (0x90-0x9f)
    if b >= 0x90 && b <= 0x9f then
      let len = (b & 0x0f) as Int
      return self._read_array(len, depth)
    end
    ## Fixstr (0xa0-0xbf)
    if b >= 0xa0 && b <= 0xbf then
      let len = (b & 0x1f) as Int
      return self._read_string(len)
    end

    match b
    when 0xc0 then Ok(Value.Nil)
    when 0xc2 then Ok(Value.Bool(false))
    when 0xc3 then Ok(Value.Bool(true))
    when 0xc4 then  ## bin 8
      let len = self._read_byte()? as Int
      self._read_binary(len)
    when 0xc5 then  ## bin 16
      let len = self._read_u16()? as Int
      self._read_binary(len)
    when 0xc6 then  ## bin 32
      let len = self._read_u32()? as Int
      self._read_binary(len)
    when 0xc7 then  ## ext 8
      let len = self._read_byte()? as Int
      let type_id = self._read_byte()? as i8
      let data = self._read_bytes(len)?
      Ok(Value.Extension(type_id, data))
    when 0xc8 then  ## ext 16
      let len = self._read_u16()? as Int
      let type_id = self._read_byte()? as i8
      let data = self._read_bytes(len)?
      Ok(Value.Extension(type_id, data))
    when 0xc9 then  ## ext 32
      let len = self._read_u32()? as Int
      let type_id = self._read_byte()? as i8
      let data = self._read_bytes(len)?
      Ok(Value.Extension(type_id, data))
    when 0xca then  ## float 32
      let bits = self._read_u32()?
      Ok(Value.Float32(std::cbor::_f32_bits_to_float(bits)))
    when 0xcb then  ## float 64
      let bits = self._read_u64()?
      Ok(Value.Float64(std::cbor::_f64_bits_to_float(bits)))
    when 0xcc then Ok(Value.UInt(self._read_byte()? as UInt))
    when 0xcd then Ok(Value.UInt(self._read_u16()?))
    when 0xce then Ok(Value.UInt(self._read_u32()?))
    when 0xcf then Ok(Value.UInt(self._read_u64()?))
    when 0xd0 then Ok(Value.Int((self._read_byte()? as i8) as Int))
    when 0xd1 then Ok(Value.Int((self._read_u16()? as i16) as Int))
    when 0xd2 then Ok(Value.Int((self._read_u32()? as i32) as Int))
    when 0xd3 then Ok(Value.Int(self._read_u64()? as Int))
    when 0xd4 then  ## fixext 1
      let t = self._read_byte()? as i8
      let d = self._read_bytes(1)?
      Ok(Value.Extension(t, d))
    when 0xd5 then  ## fixext 2
      let t = self._read_byte()? as i8
      let d = self._read_bytes(2)?
      Ok(Value.Extension(t, d))
    when 0xd6 then  ## fixext 4
      let t = self._read_byte()? as i8
      let d = self._read_bytes(4)?
      Ok(Value.Extension(t, d))
    when 0xd7 then  ## fixext 8
      let t = self._read_byte()? as i8
      let d = self._read_bytes(8)?
      Ok(Value.Extension(t, d))
    when 0xd8 then  ## fixext 16
      let t = self._read_byte()? as i8
      let d = self._read_bytes(16)?
      Ok(Value.Extension(t, d))
    when 0xd9 then  ## str 8
      let len = self._read_byte()? as Int
      self._read_string(len)
    when 0xda then  ## str 16
      let len = self._read_u16()? as Int
      self._read_string(len)
    when 0xdb then  ## str 32
      let len = self._read_u32()? as Int
      self._read_string(len)
    when 0xdc then  ## array 16
      let len = self._read_u16()? as Int
      self._read_array(len, depth)
    when 0xdd then  ## array 32
      let len = self._read_u32()? as Int
      self._read_array(len, depth)
    when 0xde then  ## map 16
      let len = self._read_u16()? as Int
      self._read_map(len, depth)
    when 0xdf then  ## map 32
      let len = self._read_u32()? as Int
      self._read_map(len, depth)
    else
      Err(MsgPackError.InvalidFormat(b))
    end
  end

  def _read_byte(&mut self) -> Result[u8, MsgPackError]
    if self.pos >= self.input.len() as Int then return Err(MsgPackError.UnexpectedEof) end
    let b = self.input[self.pos as UInt]
    self.pos = self.pos + 1
    Ok(b)
  end

  def _read_bytes(&mut self, n: Int) -> Result[Vec[u8], MsgPackError]
    if self.pos + n > self.input.len() as Int then return Err(MsgPackError.UnexpectedEof) end
    var result = Vec[u8].with_capacity(n as UInt)
    for i in 0..n do result.push(self.input[(self.pos + i) as UInt]) end
    self.pos = self.pos + n
    Ok(result)
  end

  def _read_u16(&mut self) -> Result[UInt, MsgPackError]
    let b0 = self._read_byte()? as UInt
    let b1 = self._read_byte()? as UInt
    Ok((b0 << 8) | b1)
  end

  def _read_u32(&mut self) -> Result[UInt, MsgPackError]
    var v: UInt = 0
    for _ in 0..4 do v = (v << 8) | (self._read_byte()? as UInt) end
    Ok(v)
  end

  def _read_u64(&mut self) -> Result[UInt, MsgPackError]
    var v: UInt = 0
    for _ in 0..8 do v = (v << 8) | (self._read_byte()? as UInt) end
    Ok(v)
  end

  def _read_string(&mut self, len: Int) -> Result[Value, MsgPackError]
    let bytes = self._read_bytes(len)?
    match String.from_utf8(bytes)
    when Ok(s) then Ok(Value.String(s))
    when Err(_) then Err(MsgPackError.InvalidUtf8)
    end
  end

  def _read_binary(&mut self, len: Int) -> Result[Value, MsgPackError]
    let bytes = self._read_bytes(len)?
    Ok(Value.Binary(bytes))
  end

  def _read_array(&mut self, len: Int, depth: Int) -> Result[Value, MsgPackError]
    var items = Vec[Value].with_capacity(len as UInt)
    for _ in 0..len do items.push(self._decode_value(depth + 1)?) end
    Ok(Value.Array(items))
  end

  def _read_map(&mut self, len: Int, depth: Int) -> Result[Value, MsgPackError]
    var entries = Vec[(Value, Value)].with_capacity(len as UInt)
    for _ in 0..len do
      let k = self._decode_value(depth + 1)?
      let v = self._decode_value(depth + 1)?
      entries.push((k, v))
    end
    Ok(Value.Map(entries))
  end
end

def _hex_byte(b: u8) -> String
  let chars = "0123456789abcdef"
  var result = String.with_capacity(2)
  result.push(chars.char_at((b >> 4) as UInt))
  result.push(chars.char_at((b & 0x0f) as UInt))
  result
end

# ─── Convenience ─────────────────────────────────────────────────────

pub def encode(value: &Value) -> Vec[u8]
  var enc = Encoder.new()
  enc.encode(value)
  enc.into_bytes()
end

pub def decode(bytes: &[u8]) -> Result[Value, MsgPackError]
  var dec = Decoder.new(bytes.to_vec())
  dec.decode()
end

end ## module std::msgpack
