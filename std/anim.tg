# Tangerine Standard Library — tg::anim
# Animation timeline and easing.
# Spec reference: TG-GFX-UI-SPEC-001 v0.1, Section 13.1.

use std::core::{Option, Result, String, Bool, Int, Unit}

# ═══════════════════════════════════════════════════════════════
# §13.1 Easing
# ═══════════════════════════════════════════════════════════════

enum Easing
  Linear
  InQuad
  OutQuad
  InOutQuad
  OutCubic
end

def ease(e: Easing, t: f32) -> f32
  match e
  when Easing::Linear then t
  when Easing::InQuad then t * t
  when Easing::OutQuad then t * (2.0f32 - t)
  when Easing::InOutQuad then
    if t < 0.5f32 then 2.0f32 * t * t
    else 0.0f32 - 1.0f32 + (4.0f32 - 2.0f32 * t) * t
    end
  when Easing::OutCubic then
    let t1 = t - 1.0f32
    t1 * t1 * t1 + 1.0f32
  end  end  end
end

# ═══════════════════════════════════════════════════════════════
# §13.1 Timeline
# ═══════════════════════════════════════════════════════════════

struct _AnimEntry
  target: u64          # Opaque reference to animated value
  from: f32
  to: f32
  elapsed_ms: f32
  duration_ms: f32
  easing: Easing
  done: Bool
end

struct Timeline
  _entries: Vec[_AnimEntry]
end

struct _AnimValueEntry
  target: u64
  value: f32
end

def timeline_new() -> Timeline
  Timeline { _entries: Vec::new() }
end

## Registry mapping target IDs to their current values.
@thread_local static mut _anim_values: Vec[_AnimValueEntry] = Vec::new()

def anim_set_value(target: u64, value: f32) -> Unit
  let mut i = 0
  while i < _anim_values.len() do
    let entry = _anim_values.get_mut(i)
    if entry.target == target then
      entry.value = value
      return
    end
    i = i + 1
  end
  _anim_values.push(_AnimValueEntry { target: target, value: value })
end

def anim_get_value(target: u64) -> f32
  let mut i = _anim_values.len()
  while i > 0 do
    i = i - 1
    let entry = _anim_values.get(i)
    if entry.target == target then
      return entry.value
    end
  end
  0.0f32
end

def animate_f32(inout tl: Timeline, target: u64, to: f32, ms: f32, easing: Easing) -> Unit
  let current = anim_get_value(target)
  let entry = _AnimEntry {
    target: target,
    from: current,
    to: to,
    elapsed_ms: 0.0f32,
    duration_ms: ms,
    easing: easing,
    done: false,
  }
  tl._entries.push(entry)
end

def tick(inout tl: Timeline, dt_ms: f32) -> Unit
  var i = 0
  while i < tl._entries.len() do
    let e = tl._entries.get_mut(i)
    if !e.done then
      e.elapsed_ms = e.elapsed_ms + dt_ms
      if e.elapsed_ms >= e.duration_ms then
        e.elapsed_ms = e.duration_ms
        e.done = true
      end
      let t = (e.elapsed_ms as f32) / (e.duration_ms as f32)
      let value = e.from + (e.to - e.from) * ease(e.easing, t)
      anim_set_value(e.target, value)
    end
    i = i + 1
  end

  # Prune completed animations.
  let live = Vec::new()
  var j = 0
  while j < tl._entries.len() do
    if !tl._entries.get(j).done then
      live.push(tl._entries.get(j))
    end
    j = j + 1
  end
  tl._entries = live
end
