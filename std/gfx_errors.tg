  FontNotFound(Error)
  InvalidFont(Error)
  IOError(Error)
  OutOfMemory(Error)
  Unsupported(Error)
  Internal(Error)
end

impl TextError
  def message(self: &TextError) -> &String
    match self
    when TextError::FontNotFound(e) then &e.message
    when TextError::InvalidFont(e) then &e.message
    when TextError::IOError(e) then &e.message
    when TextError::OutOfMemory(e) then &e.message
    when TextError::Unsupported(e) then &e.message
    when TextError::Internal(e) then &e.message
    end
  end

  def code(self: &TextError) -> ErrorCode
    match self
    when TextError::FontNotFound(_) then ErrorCode::InvalidArg
    when TextError::InvalidFont(_) then ErrorCode::InvalidArg
    when TextError::IOError(_) then ErrorCode::IOError
    when TextError::OutOfMemory(_) then ErrorCode::OutOfMemory
    when TextError::Unsupported(_) then ErrorCode::Unsupported
    when TextError::Internal(_) then ErrorCode::Internal
    end
  end
end

