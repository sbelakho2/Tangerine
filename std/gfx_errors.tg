# Tangerine Standard Library — tg::gfx_errors
# Common error model for the Graphics & UI stack (TG-GFX-UI-SPEC-001 v0.1)
#
# This module defines the shared ErrorCode + Error types and all module-specific
# error enums used throughout sections 4–14 of the specification.

use std::core::{Option, Result, String, Bool, Int}

# ═══════════════════════════════════════════════════════════════
# §4.1 Common ErrorCode + Error
# ═══════════════════════════════════════════════════════════════

enum ErrorCode
  InvalidArg
  Unsupported
  OutOfMemory
  IOError
  BackendLost
  BackendUnavailable
  PermissionDenied
  Internal
end

struct Error
  code: ErrorCode
  message: String
  cause: Option[Box[Error]]
end

impl Error
  def new(code: ErrorCode, message: String) -> Error
    Error { code: code, message: message, cause: Option::None }
  end

  def with_cause(code: ErrorCode, message: String, cause: Error) -> Error
    Error { code: code, message: message, cause: Option::Some(Box::new(cause)) }
  end

  def invalid_arg(message: String) -> Error
    Error::new(ErrorCode::InvalidArg, message)
  end

  def unsupported(message: String) -> Error
    Error::new(ErrorCode::Unsupported, message)
  end

  def out_of_memory(message: String) -> Error
    Error::new(ErrorCode::OutOfMemory, message)
  end

  def io_error(message: String) -> Error
    Error::new(ErrorCode::IOError, message)
  end

  def backend_lost(message: String) -> Error
    Error::new(ErrorCode::BackendLost, message)
  end

  def backend_unavailable(message: String) -> Error
    Error::new(ErrorCode::BackendUnavailable, message)
  end

  def permission_denied(message: String) -> Error
    Error::new(ErrorCode::PermissionDenied, message)
  end

  def internal(message: String) -> Error
    Error::new(ErrorCode::Internal, message)
  end
end

# ═══════════════════════════════════════════════════════════════
# §4.2 Module-specific error enums
# ═══════════════════════════════════════════════════════════════

# ———————————————————————————————————————————————————————————————
# AppError — used by tg::app for windowing/event operations
# ———————————————————————————————————————————————————————————————

enum AppError
  BackendUnavailable(Error)
  InvalidArg(Error)
  Unsupported(Error)
  PermissionDenied(Error)
  Internal(Error)
end

impl AppError
  def message(self: &AppError) -> &String
    match self
    when AppError::BackendUnavailable(e) then &e.message
    when AppError::InvalidArg(e) then &e.message
    when AppError::Unsupported(e) then &e.message
    when AppError::PermissionDenied(e) then &e.message
    when AppError::Internal(e) then &e.message
    end
  end

  def code(self: &AppError) -> ErrorCode
    match self
    when AppError::BackendUnavailable(_) then ErrorCode::BackendUnavailable
    when AppError::InvalidArg(_) then ErrorCode::InvalidArg
    when AppError::Unsupported(_) then ErrorCode::Unsupported
    when AppError::PermissionDenied(_) then ErrorCode::PermissionDenied
    when AppError::Internal(_) then ErrorCode::Internal
    end
  end
end

# ———————————————————————————————————————————————————————————————
# GfxError — used by tg::gfx for 2D drawing operations
# ———————————————————————————————————————————————————————————————

enum GfxError
  OutOfMemory(Error)
  BackendLost(Error)
  Unsupported(Error)
  InvalidArg(Error)
  Internal(Error)
end

impl GfxError
  def message(self: &GfxError) -> &String
    match self
    when GfxError::OutOfMemory(e) then &e.message
    when GfxError::BackendLost(e) then &e.message
    when GfxError::Unsupported(e) then &e.message
    when GfxError::InvalidArg(e) then &e.message
    when GfxError::Internal(e) then &e.message
    end
  end

  def code(self: &GfxError) -> ErrorCode
    match self
    when GfxError::OutOfMemory(_) then ErrorCode::OutOfMemory
    when GfxError::BackendLost(_) then ErrorCode::BackendLost
    when GfxError::Unsupported(_) then ErrorCode::Unsupported
    when GfxError::InvalidArg(_) then ErrorCode::InvalidArg
    when GfxError::Internal(_) then ErrorCode::Internal
    end
  end
end

