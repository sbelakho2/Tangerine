# ———————————————————————————————————————————————————————————————
# BackendError — used by plugin loader / ABI boundary
# ———————————————————————————————————————————————————————————————

enum BackendError
  AbiMismatch(Error)
  SymbolMissing(Error)
  InitFailed(Error)
  Internal(Error)
end

impl BackendError
  def message(self: &BackendError) -> &String
    match self
    when BackendError::AbiMismatch(e) then &e.message
    when BackendError::SymbolMissing(e) then &e.message
    when BackendError::InitFailed(e) then &e.message
    when BackendError::Internal(e) then &e.message
    end
  end

  def code(self: &BackendError) -> ErrorCode
    match self
    when BackendError::AbiMismatch(_) then ErrorCode::Unsupported
    when BackendError::SymbolMissing(_) then ErrorCode::BackendUnavailable
    when BackendError::InitFailed(_) then ErrorCode::BackendUnavailable
    when BackendError::Internal(_) then ErrorCode::Internal
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# §4.3 Consistency helpers
# ═══════════════════════════════════════════════════════════════

# Format an error message consistently: "[MODULE] CODE: message"
def format_error(module: &str, code: ErrorCode, message: &str) -> String
  let code_str = match code
  when ErrorCode::InvalidArg then "InvalidArg"
  when ErrorCode::Unsupported then "Unsupported"
  when ErrorCode::OutOfMemory then "OutOfMemory"
  when ErrorCode::IOError then "IOError"
  when ErrorCode::BackendLost then "BackendLost"
  when ErrorCode::BackendUnavailable then "BackendUnavailable"
  when ErrorCode::PermissionDenied then "PermissionDenied"
  when ErrorCode::Internal then "Internal"
  end
  "[" + module + "] " + code_str + ": " + message
end
