# UiError — used by tg::ui for widget tree operations
# ———————————————————————————————————————————————————————————————

enum UiError
  InvalidTree(Error)
  Unsupported(Error)
  Internal(Error)
end

impl UiError
  def message(self: &UiError) -> &String
    match self
    when UiError::InvalidTree(e) then &e.message
    when UiError::Unsupported(e) then &e.message
    when UiError::Internal(e) then &e.message
    end
  end

  def code(self: &UiError) -> ErrorCode
    match self
