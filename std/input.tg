## Tangerine Standard Library — std::input
## Input device handling for keyboard, mouse, gamepad, and touch
##
## Provides a unified input abstraction layer:
## - Keyboard state tracking and key binding
## - Mouse position, buttons, and scroll wheel
## - Gamepad/controller support with dead zones
## - Touch input for mobile platforms
## - Input action mapping system

use std::collections::{Vec, Map, Set}
use std::core::{Option, Result}
use std::time::{Duration, Instant}
use std::window::{KeyCode, KeyMods, MouseButton, GamepadButton, GamepadAxis}

# ———————————————————————————————————————————————————————————————
# Input State
# ———————————————————————————————————————————————————————————————

pub struct InputState
  keyboard: KeyboardState
  mouse: MouseState
  gamepads: Map[u32, GamepadState]
  touch: TouchState
end

impl InputState
  pub def new() -> InputState
    InputState {
      keyboard: KeyboardState::new(),
      mouse: MouseState::new(),
      gamepads: Map::new(),
      touch: TouchState::new()
    }
  end
  
  # Update input state (call at start of frame)
  pub def update(self: &mut Self) -> Unit
    self.keyboard.update()
    self.mouse.update()
    for (_, gamepad) in &mut self.gamepads do
      gamepad.update()
    end
    self.touch.update()
  end
  
  # Process a key event
  pub def process_key_event(self: &mut Self, key: KeyCode, pressed: Bool, mods: KeyMods) -> Unit
    self.keyboard.process_event(key, pressed, mods)
  end
  
  # Process a mouse button event
  pub def process_mouse_button(self: &mut Self, button: MouseButton, pressed: Bool, mods: KeyMods) -> Unit
    self.mouse.process_button(button, pressed, mods)
  end
  
  # Process mouse movement
  pub def process_mouse_move(self: &mut Self, x: f64, y: f64) -> Unit
    self.mouse.process_move(x, y)
  end
  
  # Process scroll wheel
  pub def process_scroll(self: &mut Self, dx: f64, dy: f64) -> Unit
    self.mouse.process_scroll(dx, dy)
  end
end

# ———————————————————————————————————————————————————————————————
# Keyboard State
# ———————————————————————————————————————————————————————————————

pub struct KeyboardState
  keys_down: Set[KeyCode]
  keys_pressed_this_frame: Set[KeyCode]
  keys_released_this_frame: Set[KeyCode]
  current_mods: KeyMods
  text_input: String
end

impl KeyboardState
  pub def new() -> KeyboardState
    KeyboardState {
      keys_down: Set::new(),
      keys_pressed_this_frame: Set::new(),
      keys_released_this_frame: Set::new(),
      current_mods: key_mods_none(),
      text_input: ""
    }
  end
  
  # Check if key is currently held down
  pub def is_key_down(self: &Self, key: KeyCode) -> Bool
    self.keys_down.contains(&key)
  end
  
  # Check if key was pressed this frame
  pub def is_key_pressed(self: &Self, key: KeyCode) -> Bool
    self.keys_pressed_this_frame.contains(&key)
  end
  
  # Check if key was released this frame
  pub def is_key_released(self: &Self, key: KeyCode) -> Bool
    self.keys_released_this_frame.contains(&key)
  end
  
  # Get current key modifiers
  pub def modifiers(self: &Self) -> KeyMods
    self.current_mods.clone()
  end
  
  # Check if any key is pressed
  pub def any_key_pressed(self: &Self) -> Bool
    !self.keys_pressed_this_frame.is_empty()
  end
  
  # Get text input from this frame
  pub def text_input(self: &Self) -> String
    self.text_input.clone()
  end
  
  # Process a key event
  pub def process_event(self: &mut Self, key: KeyCode, pressed: Bool, mods: KeyMods) -> Unit
    self.current_mods = mods
    
    if pressed then
      if !self.keys_down.contains(&key) then
        self.keys_down.insert(key.clone())
        self.keys_pressed_this_frame.insert(key)
      end
    else
      if self.keys_down.contains(&key) then
        self.keys_down.remove(&key)
        self.keys_released_this_frame.insert(key)
      end
    end
  end
  
  # Add text input character
  pub fn add_text_input(self: &mut Self, ch: u32) -> Unit
    # Convert Unicode codepoint to string
    let s = String::from_unicode_codepoint(ch)
    self.text_input = self.text_input.clone() + s
  end
  
  # Update (clear per-frame state)
  pub def update(self: &mut Self) -> Unit
    self.keys_pressed_this_frame.clear()
    self.keys_released_this_frame.clear()
    self.text_input = ""
  end
end

# ———————————————————————————————————————————————————————————————
# Mouse State
# ———————————————————————————————————————————————————————————————

pub struct MouseState
  x: f64
  y: f64
  dx: f64
  dy: f64
  scroll_x: f64
  scroll_y: f64
  buttons_down: Set[MouseButton]
  buttons_pressed_this_frame: Set[MouseButton]
  buttons_released_this_frame: Set[MouseButton]
  inside_window: Bool
end

impl MouseState
  pub def new() -> MouseState
    MouseState {
      x: 0.0,
      y: 0.0,
      dx: 0.0,
      dy: 0.0,
      scroll_x: 0.0,
      scroll_y: 0.0,
      buttons_down: Set::new(),
      buttons_pressed_this_frame: Set::new(),
      buttons_released_this_frame: Set::new(),
      inside_window: true
    }
  end
  
  # Get mouse position
  pub def position(self: &Self) -> (f64, f64)
    (self.x, self.y)
  end
  
  # Get mouse delta (movement since last frame)
  pub def delta(self: &Self) -> (f64, f64)
    (self.dx, self.dy)
  end
  
  # Get scroll delta
  pub def scroll_delta(self: &Self) -> (f64, f64)
    (self.scroll_x, self.scroll_y)
  end
  
  # Check if button is currently held down
  pub def is_button_down(self: &Self, button: MouseButton) -> Bool
    self.buttons_down.contains(&button)
  end
  
  # Check if button was pressed this frame
  pub def is_button_pressed(self: &Self, button: MouseButton) -> Bool
    self.buttons_pressed_this_frame.contains(&button)
  end
  
  # Check if button was released this frame
  pub def is_button_released(self: &Self, button: MouseButton) -> Bool
    self.buttons_released_this_frame.contains(&button)
  end
  
  # Check if mouse is inside window
  pub def is_inside_window(self: &Self) -> Bool
    self.inside_window
  end
  
  # Process mouse movement
  pub def process_move(self: &mut Self, x: f64, y: f64) -> Unit
    self.dx = x - self.x
    self.dy = y - self.y
    self.x = x
    self.y = y
  end
  
  # Process mouse button
  pub def process_button(self: &mut Self, button: MouseButton, pressed: Bool, _mods: KeyMods) -> Unit
    if pressed then
      if !self.buttons_down.contains(&button) then
        self.buttons_down.insert(button.clone())
        self.buttons_pressed_this_frame.insert(button)
      end
    else
      if self.buttons_down.contains(&button) then
        self.buttons_down.remove(&button)
        self.buttons_released_this_frame.insert(button)
      end
    end
  end
  
  # Process scroll wheel
  pub def process_scroll(self: &mut Self, dx: f64, dy: f64) -> Unit
    self.scroll_x = dx
    self.scroll_y = dy
  end
  
  # Set inside window state
  pub def set_inside_window(self: &mut Self, inside: Bool) -> Unit
    self.inside_window = inside
  end
  
  # Update (clear per-frame state)
  pub def update(self: &mut Self) -> Unit
    self.dx = 0.0
    self.dy = 0.0
    self.scroll_x = 0.0
    self.scroll_y = 0.0
    self.buttons_pressed_this_frame.clear()
    self.buttons_released_this_frame.clear()
  end
end

# ———————————————————————————————————————————————————————————————
# Gamepad State
# ———————————————————————————————————————————————————————————————

pub const GAMEPAD_AXIS_LEFT_DEADZONE: f32 = 0.15
pub const GAMEPAD_AXIS_RIGHT_DEADZONE: f32 = 0.15
pub const GAMEPAD_TRIGGER_DEADZONE: f32 = 0.1

pub struct GamepadState
  id: u32
  name: String
  connected: Bool
  axes: Vec[f32]
  buttons_down: Set[GamepadButton]
  buttons_pressed_this_frame: Set[GamepadButton]
  buttons_released_this_frame: Set[GamepadButton]
  left_deadzone: f32
  right_deadzone: f32
  trigger_deadzone: f32
end

impl GamepadState
  pub def new(id: u32, name: String) -> GamepadState
    mut axes = Vec::with_capacity(6)
    axes.resize(6, 0.0)
    
    GamepadState {
      id: id,
      name: name,
      connected: true,
      axes: axes,
      buttons_down: Set::new(),
      buttons_pressed_this_frame: Set::new(),
      buttons_released_this_frame: Set::new(),
      left_deadzone: GAMEPAD_AXIS_LEFT_DEADZONE,
      right_deadzone: GAMEPAD_AXIS_RIGHT_DEADZONE,
      trigger_deadzone: GAMEPAD_TRIGGER_DEADZONE
    }
  end
  
  # Get left stick X axis (-1 to 1)
  pub def left_x(self: &Self) -> f32
    apply_deadzone(self.get_axis(0), self.left_deadzone)
  end
  
  # Get left stick Y axis (-1 to 1)
  pub def left_y(self: &Self) -> f32
    apply_deadzone(self.get_axis(1), self.left_deadzone)
  end
  
  # Get right stick X axis (-1 to 1)
  pub def right_x(self: &Self) -> f32
    apply_deadzone(self.get_axis(2), self.right_deadzone)
  end
  
  # Get right stick Y axis (-1 to 1)
  pub def right_y(self: &Self) -> f32
    apply_deadzone(self.get_axis(3), self.right_deadzone)
  end
  
  # Get left trigger (0 to 1)
  pub def left_trigger(self: &Self) -> f32
    let val = self.get_axis(4)
    if val < self.trigger_deadzone then 0.0 else val
  end
  
  # Get right trigger (0 to 1)
  pub def right_trigger(self: &Self) -> f32
    let val = self.get_axis(5)
    if val < self.trigger_deadzone then 0.0 else val
  end
  
  # Get raw axis value
  pub def get_axis(self: &Self, axis: u32) -> f32
    if (axis as usize) < self.axes.len() then
      self.axes[axis as usize]
    else
      0.0
    end
  end
  
  # Check if button is currently held down
  pub def is_button_down(self: &Self, button: GamepadButton) -> Bool
    self.buttons_down.contains(&button)
  end
  
  # Check if button was pressed this frame
  pub def is_button_pressed(self: &Self, button: GamepadButton) -> Bool
    self.buttons_pressed_this_frame.contains(&button)
  end
  
  # Check if button was released this frame
  pub def is_button_released(self: &Self, button: GamepadButton) -> Bool
    self.buttons_released_this_frame.contains(&button)
  end
  
  # Set axis value
  pub def set_axis(self: &mut Self, axis: GamepadAxis, value: f32) -> Unit
    let idx = match axis
      when GamepadAxis::LeftX then 0
      when GamepadAxis::LeftY then 1
      when GamepadAxis::RightX then 2
      when GamepadAxis::RightY then 3
      when GamepadAxis::LeftTrigger then 4
      when GamepadAxis::RightTrigger then 5
    end
    if (idx as usize) < self.axes.len() then
      self.axes[idx as usize] = value.clamp(-1.0, 1.0)
    end
  end
  
  # Process button event
  pub def process_button(self: &mut Self, button: GamepadButton, pressed: Bool) -> Unit
    if pressed then
      if !self.buttons_down.contains(&button) then
        self.buttons_down.insert(button.clone())
        self.buttons_pressed_this_frame.insert(button)
      end
    else
      if self.buttons_down.contains(&button) then
        self.buttons_down.remove(&button)
        self.buttons_released_this_frame.insert(button)
      end
    end
  end
  
  # Update (clear per-frame state)
  pub def update(self: &mut Self) -> Unit
    self.buttons_pressed_this_frame.clear()
    self.buttons_released_this_frame.clear()
  end
  
  # Set dead zones
  pub def set_deadzones(self: &mut Self, left: f32, right: f32, trigger: f32) -> Unit
    self.left_deadzone = left
    self.right_deadzone = right
    self.trigger_deadzone = trigger
  end
end

# Apply deadzone to axis value
def apply_deadzone(value: f32, deadzone: f32) -> f32
  if value.abs() < deadzone then
    0.0
  else
    # Rescale to full range
    let sign = if value < 0.0 then -1.0 else 1.0
    sign * ((value.abs() - deadzone) / (1.0 - deadzone))
  end
end

# ———————————————————————————————————————————————————————————————
# Touch State
# ———————————————————————————————————————————————————————————————

pub struct TouchPoint
  id: u32
  x: f64
  y: f64
  start_x: f64
  start_y: f64
  start_time: Instant
  pressure: f32
end

impl TouchPoint
  pub def new(id: u32, x: f64, y: f64) -> TouchPoint
    TouchPoint {
      id: id,
      x: x,
      y: y,
      start_x: x,
      start_y: y,
      start_time: Instant::now(),
      pressure: 1.0
    }
  end
  
  # Get touch delta from start
  pub def delta_from_start(self: &Self) -> (f64, f64)
    (self.x - self.start_x, self.y - self.start_y)
  end
  
  # Get touch duration
  pub def duration(self: &Self) -> Duration
    self.start_time.elapsed()
  end
  
  # Check if this is a tap (short touch with minimal movement)
  pub def is_tap(self: &Self, max_duration: Duration, max_distance: f64) -> Bool
    let (dx, dy) = self.delta_from_start()
    let distance = (dx * dx + dy * dy).sqrt()
    self.duration() < max_duration && distance < max_distance
  end
end

pub struct TouchState
  active_touches: Map[u32, TouchPoint]
  taps_this_frame: Vec[TouchPoint]
end

impl TouchState
  pub def new() -> TouchState
    TouchState {
      active_touches: Map::new(),
      taps_this_frame: Vec::new()
    }
  end
  
  # Get number of active touches
  pub fn touch_count(self: &Self) -> u32
    self.active_touches.len() as u32
  end
  
  # Check if any touches are active
  pub def has_touches(self: &Self) -> Bool
    !self.active_touches.is_empty()
  end
  
  # Get touch by ID
  pub fn get_touch(self: &Self, id: u32) -> Option[&TouchPoint]
    self.active_touches.get(&id)
  end
  
  # Get all active touches
  pub fn touches(self: &Self) -> Vec[&TouchPoint]
    self.active_touches.values().collect()
  end
  
  # Get taps detected this frame
  pub fn taps(self: &Self) -> &Vec[TouchPoint]
    &self.taps_this_frame
  end
  
  # Start a new touch
  pub def start_touch(self: &mut Self, id: u32, x: f64, y: f64) -> Unit
    let touch = TouchPoint::new(id, x, y)
    self.active_touches.insert(id, touch)
  end
  
  # Move an existing touch
  pub def move_touch(self: &mut Self, id: u32, x: f64, y: f64) -> Unit
    if let Some(touch) = self.active_touches.get_mut(&id) then
      touch.x = x
      touch.y = y
    end
  end
  
  # End a touch
  pub def end_touch(self: &mut Self, id: u32, x: f64, y: f64) -> Unit
    if let Some(touch) = self.active_touches.get_mut(&id) then
      touch.x = x
      touch.y = y
      
      # Check if this was a tap
      let max_tap_duration = Duration::from_millis(300)
      let max_tap_distance = 30.0
      if touch.is_tap(max_tap_duration, max_tap_distance) then
        self.taps_this_frame.push(touch.clone())
      end
    end
    self.active_touches.remove(&id)
  end
  
  # Update (clear per-frame state)
  pub def update(self: &mut Self) -> Unit
    self.taps_this_frame.clear()
  end
end

# ———————————————————————————————————————————————————————————————
# Input Action Mapping System
# ———————————————————————————————————————————————————————————————

pub enum InputSource
  when Key(key: KeyCode)
  when MouseButton(button: MouseButton)
  when GamepadButton(button: GamepadButton)
  when GamepadAxis(axis: GamepadAxis, positive: Bool)
  when Touch
end

pub struct InputBinding
  sources: Vec[InputSource]
  scale: f32
end

impl InputBinding
  pub def new() -> InputBinding
    InputBinding {
      sources: Vec::new(),
      scale: 1.0
    }
  end
  
  pub def key(key: KeyCode) -> InputBinding
    mut binding = InputBinding::new()
    binding.sources.push(InputSource::Key(key))
    binding
  end
  
  pub def mouse_button(button: MouseButton) -> InputBinding
    mut binding = InputBinding::new()
    binding.sources.push(InputSource::MouseButton(button))
    binding
  end
  
  pub def gamepad_button(button: GamepadButton) -> InputBinding
    mut binding = InputBinding::new()
    binding.sources.push(InputSource::GamepadButton(button))
    binding
  end
  
  pub fn add_key(self: &mut Self, key: KeyCode) -> &mut Self
    self.sources.push(InputSource::Key(key))
    self
  end
  
  pub fn add_mouse_button(self: &mut Self, button: MouseButton) -> &mut Self
    self.sources.push(InputSource::MouseButton(button))
    self
  end
  
  pub fn add_gamepad_button(self: &mut Self, button: GamepadButton) -> &mut Self
    self.sources.push(InputSource::GamepadButton(button))
    self
  end
  
  pub fn set_scale(self: &mut Self, scale: f32) -> &mut Self
    self.scale = scale
    self
  end
end

pub struct InputMap
  bindings: Map[String, InputBinding]
end

impl InputMap
  pub def new() -> InputMap
    InputMap {
      bindings: Map::new()
    }
  end
  
  # Add a named action binding
  pub fn bind(self: &mut Self, name: String, binding: InputBinding) -> &mut Self
    self.bindings.insert(name, binding)
    self
  end
  
  # Get the value of an action (0.0 to 1.0 for buttons, -1.0 to 1.0 for axes)
  pub def get_value(self: &Self, name: &String, state: &InputState) -> f32
    if let Some(binding) = self.bindings.get(name) then
      let mut max_value = 0.0
      for source in &binding.sources do
        let value = match source
          when InputSource::Key(key) then
            if state.keyboard.is_key_down(key.clone()) then 1.0 else 0.0
          when InputSource::MouseButton(button) then
            if state.mouse.is_button_down(button.clone()) then 1.0 else 0.0
          when InputSource::GamepadButton(button) then
            # Check all connected gamepads
            let mut v = 0.0
            for (_, gp) in &state.gamepads do
              if gp.is_button_down(button.clone()) then
                v = 1.0
              end
            end
            v
          when InputSource::GamepadAxis(axis, positive) then
            let mut v = 0.0
            for (_, gp) in &state.gamepads do
              let axis_val = gp.get_axis(match axis
                when GamepadAxis::LeftX then 0
                when GamepadAxis::LeftY then 1
                when GamepadAxis::RightX then 2
                when GamepadAxis::RightY then 3
                when GamepadAxis::LeftTrigger then 4
                when GamepadAxis::RightTrigger then 5
              end as u32)
              if positive then
                if axis_val > v then v = axis_val
              else
                if -axis_val > v then v = -axis_val
              end
            end
            v
          when InputSource::Touch then
            if state.touch.has_touches() then 1.0 else 0.0
        end
        if value.abs() > max_value.abs() then
          max_value = value
        end
      end
      max_value * binding.scale
    else
      0.0
    end
  end
  
  # Check if action is active (non-zero value)
  pub def is_active(self: &Self, name: &String, state: &InputState) -> Bool
    self.get_value(name, state).abs() > 0.01
  end
  
  # Check if action was triggered this frame
  pub def is_pressed(self: &Self, name: &String, state: &InputState) -> Bool
    if let Some(binding) = self.bindings.get(name) then
      for source in &binding.sources do
        let pressed = match source
          when InputSource::Key(key) then
            state.keyboard.is_key_pressed(key.clone())
          when InputSource::MouseButton(button) then
            state.mouse.is_button_pressed(button.clone())
          when InputSource::GamepadButton(button) then
            let mut p = false
            for (_, gp) in &state.gamepads do
              if gp.is_button_pressed(button.clone()) then
                p = true
              end
            end
            p
          when InputSource::GamepadAxis(_, _) then false
          when InputSource::Touch then
            !state.touch.taps().is_empty()
        end
        if pressed then return true
      end
    end
    false
  end
end

# ———————————————————————————————————————————————————————————————
# Common Input Maps
# ———————————————————————————————————————————————————————————————

pub def default_game_input_map() -> InputMap
  mut map = InputMap::new()
  
  # Movement
  map.bind("move_left", InputBinding::key(KeyCode::A)
    .add_key(KeyCode::Left)
    .add_gamepad_button(GamepadButton::DPadLeft))
  map.bind("move_right", InputBinding::key(KeyCode::D)
    .add_key(KeyCode::Right)
    .add_gamepad_button(GamepadButton::DPadRight))
  map.bind("move_up", InputBinding::key(KeyCode::W)
    .add_key(KeyCode::Up)
    .add_gamepad_button(GamepadButton::DPadUp))
  map.bind("move_down", InputBinding::key(KeyCode::S)
    .add_key(KeyCode::Down)
    .add_gamepad_button(GamepadButton::DPadDown))
  
  # Actions
  map.bind("jump", InputBinding::key(KeyCode::Space)
    .add_gamepad_button(GamepadButton::A))
  map.bind("attack", InputBinding::mouse_button(MouseButton::Left)
    .add_gamepad_button(GamepadButton::X))
  map.bind("interact", InputBinding::key(KeyCode::E)
    .add_gamepad_button(GamepadButton::Y))
  map.bind("pause", InputBinding::key(KeyCode::Escape)
    .add_gamepad_button(GamepadButton::Start))
  
  map
end

pub fn key_mods_none() -> KeyMods
  KeyMods { shift: false, ctrl: false, alt: false, super_: false, caps_lock: false, num_lock: false }
end