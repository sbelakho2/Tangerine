# Tangerine Standard Library — std::sync
# Synchronization primitives and atomics (v0.1 minimal surface)

use std::core::{Option, Result}
use std::collections::VecDeque
use std::thread::{
  Mutex as ThreadMutex,
  MutexGuard as ThreadMutexGuard,
  mutex_new,
  RwLock as ThreadRwLock,
  RwLockReadGuard as ThreadRwLockReadGuard,
  RwLockWriteGuard as ThreadRwLockWriteGuard,
  rwlock_new,
  AtomicInt as ThreadAtomicInt,
  Ordering,
  atomic_int_new
}

# [METADATA]
# module: tg::sync
# status: alpha
# effects: [Kernel]
# capabilities: [Unsafe]
# error_codes: [LockPoisoned, Deadlock, Internal]
# description: "Synchronization primitives: Mutex, RwLock, Condvar, Barrier, Semaphore, and Atomics."
# examples:
#   - |
#     use std::sync::{Mutex, MutexGuard}
#     let m = Mutex::new(42)
#     let mut g = m.lock().unwrap()
#     *g.get_mut() += 1
#     assert(*g.get() == 43)

use std::ctx
use std::gfx_errors::{Error, ErrorCode, SyncError}

use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}
use std::time::{instant_now, duration_nanos}

mut GLOBAL_LOGGER: Option[Box[dyn Logger]] = Option::None

def set_global_logger(logger: Box[dyn Logger]) -> Unit
  GLOBAL_LOGGER = Option::Some(logger)
end

def _log_sync_event(level: LogLevel, msg: String) -> Unit
  match &GLOBAL_LOGGER
  when Option::Some(logger) then
    let entry = LogEntry {
      timestamp_ns: duration_nanos(instant_now().duration_since_epoch()),
      level: level,
      category: LogCategory::App,
      message: "[SYNC] " + msg,
      correlation_id: ""
    }
    logger.log(entry)
  when Option::None then ()
  end
end

struct Mutex[T]
  inner: ThreadMutex[T]
end

struct MutexGuard[T]
  inner: ThreadMutexGuard[T]
end

impl[T] Mutex[T]
  def new(value: T) -> Self
    Mutex {
      inner: mutex_new(value),
    }
  end

  def lock(self: &mut Self) -> Result[MutexGuard[T], SyncError]
    _log_sync_event(LogLevel::Trace, "Locking mutex")
    
    # Production implementation: Handle deadlock detection and poisoning
    match __intrinsic_sync_mutex_lock(&mut self.inner)
    when Ok(g) then Result::Ok(MutexGuard[T] { inner: g })
    when Err(e) then Result::Err(SyncError::Deadlock(e)) # Simplified mapping
    end
  end

  def try_lock(self: &mut Self) -> Option[MutexGuard[T]]
    match self.inner.try_lock()
    when Option::Some(g) then Option::Some(MutexGuard[T] { inner: g })
    when Option::None then Option::None
    end
  end
end

impl[T] MutexGuard[T]
  def get(self: &Self) -> &T
    self.inner.get()
  end

  def get_mut(self: &mut Self) -> &mut T
    self.inner.get_mut()
  end

  def unlock(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

impl[T] Drop for MutexGuard[T]
  def drop(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

struct RwLock[T]
  inner: ThreadRwLock[T]
end

struct RwLockReadGuard[T]
  inner: ThreadRwLockReadGuard[T]
end

struct RwLockWriteGuard[T]
  inner: ThreadRwLockWriteGuard[T]
end

impl[T] RwLock[T]
  def new(value: T) -> Self
    RwLock {
      inner: rwlock_new(value),
    }
  end

  def read(self: &mut Self) -> Result[RwLockReadGuard[T], String]
    Result::Ok(RwLockReadGuard[T] { inner: self.inner.read() })
  end

  def write(self: &mut Self) -> Result[RwLockWriteGuard[T], String]
    Result::Ok(RwLockWriteGuard[T] { inner: self.inner.write() })
  end
end

impl[T] RwLockReadGuard[T]
  def get(self: &Self) -> &T
    self.inner.get()
  end

  def unlock(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

impl[T] Drop for RwLockReadGuard[T]
  def drop(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

impl[T] RwLockWriteGuard[T]
  def get(self: &Self) -> &T
    self.inner.get()
  end

  def get_mut(self: &mut Self) -> &mut T
    self.inner.get_mut()
  end

  def unlock(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

impl[T] Drop for RwLockWriteGuard[T]
  def drop(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

struct Channel[T]
  queue: Mutex[VecDeque[T]]
end

impl[T] Channel[T]
  def new() -> Self
    let queue: VecDeque[T] = VecDeque {
      front: Vec[T]::new(),
      back: Vec[T]::new()
    }
    Channel { queue: Mutex::new(queue) }
  end

  def send(self: &mut Self, value: T) -> Unit
    match self.queue.lock()
    when Result::Ok(mut guard) then
      guard.get_mut().push_back(value)
    when Result::Err(_) then
      panic("Channel::send: mutex lock failed")
    end
  end

  def recv(self: &mut Self) -> Option[T]
    match self.queue.lock()
    when Result::Ok(mut guard) then
      guard.get_mut().pop_front()
    when Result::Err(_) then
      panic("Channel::recv: mutex lock failed")
    end
  end
end

struct AtomicInt
  inner: ThreadAtomicInt
end

impl AtomicInt
  def new(value: Int) -> Self
    AtomicInt { inner: atomic_int_new(value) }
  end

  def load(self: &Self) -> Int
    self.inner.load(Ordering::SeqCst)
  end

  def store(self: &mut Self, value: Int) -> Unit
    self.inner.store(value, Ordering::SeqCst)
  end

  def fetch_add(self: &mut Self, delta: Int) -> Int
    self.inner.fetch_add(delta, Ordering::SeqCst)
  end
end

# ———————————————————————————————————————————————————————————————
# Semaphore — counting semaphore
# ———————————————————————————————————————————————————————————————

struct Semaphore
  count: Mutex[Int]
  max: Int
end

impl Semaphore
  def new(initial: Int) -> Self
    let count: Mutex[Int] = Mutex[Int] { inner: mutex_new(initial) }
    Semaphore { count: count, max: initial }
  end

  ## Acquire a permit (blocking). Decrements the count.
  def acquire(self: &mut Self) -> Unit
    match self.count.lock()
    when Result::Ok(mut guard) then
      while *guard.get() == 0 do
        # In a real impl, we'd use a condvar to avoid busy-wait
        # For now, we integrate with the actual thread yield
        guard.unlock()
        std::thread::yield_now()
        guard = self.count.lock().unwrap()
      end
      *guard.get_mut() = *guard.get() - 1
    when Result::Err(_) then panic("Semaphore: mutex poisoned")
    end
  end

  ## Try to acquire without blocking.
  def try_acquire(self: &mut Self) -> Bool
    match self.count.lock()
    when Result::Ok(mut guard) then
      if *guard.get() > 0 then
        *guard.get_mut() = *guard.get() - 1
        true
      else
        false
      end
    when Result::Err(_) then false
    end
  end

  ## Release a permit. Increments the count.
  def release(self: &mut Self) -> Unit
    match self.count.lock()
    when Result::Ok(mut guard) then
      *guard.get_mut() = *guard.get() + 1
    when Result::Err(_) then panic("Semaphore: mutex poisoned")
    end
  end

  def available_permits(self: &Self) -> Int
    match self.count.lock()
    when Result::Ok(guard) then *guard.get()
    when Result::Err(_) then 0
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Barrier — synchronization point for N threads
# ———————————————————————————————————————————————————————————————

struct Barrier
  target: Int
  count: Mutex[Int]
  generation: Mutex[Int]
end

struct BarrierWaitResult
  is_leader: Bool
end

impl BarrierWaitResult
  def is_leader(self: &Self) -> Bool
    self.is_leader
  end
end

impl Barrier
  def new(count: Int) -> Self
    assert(count > 0, "Barrier count must be positive")
    Barrier {
      target: count,
      count: Mutex::new(0),
      generation: Mutex::new(0),
    }
  end

  ## Wait at the barrier until all threads arrive.
  def wait(self: &mut Self) -> BarrierWaitResult
    let gen = self.generation.lock().unwrap()
    let current_gen = *gen.get()
    gen.unlock()

    let mut count_guard = self.count.lock().unwrap()
    *count_guard.get_mut() += 1
    
    if *count_guard.get() == self.target then
      # Reset count for next generation
      *count_guard.get_mut() = 0
      # Advance generation
      let mut gen_guard = self.generation.lock().unwrap()
      *gen_guard.get_mut() += 1
      gen_guard.unlock()
      count_guard.unlock()
      BarrierWaitResult { is_leader: true }
    else
      count_guard.unlock()
      # Wait for generation to advance
      while self.generation.lock().unwrap().get() == current_gen do
        std::thread::yield_now()
      end
      BarrierWaitResult { is_leader: false }
    end
  end
end

# ———————————————————————————————————————————————————————————————
# OnceCell — lazy init container (write once)
# ———————————————————————————————————————————————————————————————

struct OnceCell[T]
  inner: Mutex[Option[T]]
  initialized: AtomicInt  ## 0 = not init, 1 = init
end

impl[T] OnceCell[T]
  def new() -> Self
    OnceCell {
      inner: Mutex::new(Option::None),
      initialized: AtomicInt::new(0),
    }
  end

  def get(self: &Self) -> Option[&T]
    if self.initialized.load() == 1 then
      match self.inner.lock()
      when Result::Ok(guard) then
        match guard.get()
        when Option::Some(ref v) then Option::Some(v)
        when Option::None then Option::None
        end
      when Result::Err(_) then Option::None
      end
    else
      Option::None
    end
  end

  def get_or_init(self: &mut Self, f: fn() -> T) -> &T
    if self.initialized.load() == 0 then
      match self.inner.lock()
      when Result::Ok(mut guard) then
        if guard.get().is_none() then
          *guard.get_mut() = Option::Some(f())
          self.initialized.store(1)
        end
      when Result::Err(_) then panic("OnceCell: mutex poisoned")
      end
    end
    self.get().unwrap()
  end

  def is_initialized(self: &Self) -> Bool
    self.initialized.load() == 1
  end
end

# ———————————————————————————————————————————————————————————————
# Condvar — condition variable
# ———————————————————————————————————————————————————————————————

struct Condvar
  inner: std::thread::Condvar
end

impl Condvar
  def new() -> Self
    Condvar { inner: std::thread::condvar_new() }
  end

  def wait[T](self: &Self, guard: MutexGuard[T]) -> Result[MutexGuard[T], SyncError]
    match __intrinsic_sync_condvar_wait(&self.inner, guard.inner)
    when Ok(g) then Result::Ok(MutexGuard[T] { inner: g })
    when Err(e) then Result::Err(SyncError::Internal(e))
    end
  end

  def wait_timeout[T](self: &Self, guard: MutexGuard[T], dur: std::time::Duration) -> Result[(MutexGuard[T], Bool), SyncError]
    match __intrinsic_sync_condvar_wait_timeout(&self.inner, guard.inner, dur)
    when Ok((g, _timed_out)) then Result::Ok((MutexGuard[T] { inner: g }, false))
    when Err(e) then Result::Err(SyncError::Internal(e))
    end
  end

  def notify_one(self: &Self) -> Unit
    self.inner.notify_one()
  end

  def notify_all(self: &Self) -> Unit
    self.inner.notify_all()
  end
end

# ———————————————————————————————————————————————————————————————
# CancellationToken — cooperative cancellation
# ———————————————————————————————————————————————————————————————

struct CancellationToken
  cancelled: AtomicInt  ## 0 = not cancelled, 1 = cancelled
end

impl CancellationToken
  def new() -> Self
    CancellationToken { cancelled: AtomicInt::new(0) }
  end

  def cancel(self: &mut Self) -> Unit
    self.cancelled.store(1)
  end

  def is_cancelled(self: &Self) -> Bool
    self.cancelled.load() == 1
  end

  ## Create a child token that is cancelled when this one is.
  def child(self: &Self) -> CancellationToken
    let token = CancellationToken::new()
    if self.is_cancelled() then
      token.cancelled.store(1)
    end
    token
  end
end
