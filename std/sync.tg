# Tangerine Standard Library — std::sync
# Synchronization Primitives for Concurrent Programming
#
# This module provides thread-safe primitives:
#   - Mutex: Mutual exclusion lock
#   - Condvar: Condition variable for signaling
#   - Atomic types: Lock-free atomic operations
#   - Arc: Atomically reference-counted smart pointer
#   - RwLock: Reader-writer lock
#   - Barrier: Synchronization barrier
#   - Channel: Multi-producer multi-consumer channels
#
# Example:
#   use std::sync::{Mutex, Arc}
#   
#   let data = Arc::new(Mutex::new(0))
#   let data_clone = data.clone()
#   
#   spawn_thread(move || {
#     let mut guard = data_clone.lock()
#     *(guard.get_mut()) = *(guard.get()) + 1
#   })

use std::core::{Option, Result, String, Bool, Int, UInt, Unit}
use std::collections::{Vec, Queue}
use std::time::{Duration, Instant}
use std::ffi::{c_int}

# ═══════════════════════════════════════════════════════════════
# The atomic intrinsics — the ONE atomic primitive layer
# ═══════════════════════════════════════════════════════════════
# The compiler emits these inline on BOTH arches (codegen's
# try_emit_atomic_builtin -> emit_atomic_intrinsic — the same authority
# std::atomic uses). The atomic types below call THIS layer for every
# operation: an atomic load/store/exchange/CAS is the intrinsic's inline
# instruction, never a fence around an ordinary access. Order codes:
# 5 = SeqCst (the strongest form; the emitters are correct for every
# ordering).
#
# ABI: load(ptr, order) -> value; store(ptr, value, order);
# exchange(ptr, value, order) -> old; compare_exchange(ptr,
# &expected, desired, weak, success_order, failure_order) -> Bool
# (the expected slot is updated with the current value on failure);
# fetch_add/fetch_sub(ptr, value, order) -> old.
extern def __intrinsic_atomic_load_u8(ptr: Ptr[u8], order: c_int) -> u8
extern def __intrinsic_atomic_store_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> Unit
extern def __intrinsic_atomic_exchange_u8(ptr: PtrMut[u8], value: u8, order: c_int) -> u8
extern def __intrinsic_atomic_compare_exchange_u8(ptr: PtrMut[u8], expected: PtrMut[u8], desired: u8, weak: Bool, success_order: c_int, failure_order: c_int) -> Bool

extern def __intrinsic_atomic_load_u32(ptr: Ptr[u32], order: c_int) -> u32
extern def __intrinsic_atomic_store_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> Unit
extern def __intrinsic_atomic_exchange_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_compare_exchange_u32(ptr: PtrMut[u32], expected: PtrMut[u32], desired: u32, weak: Bool, success_order: c_int, failure_order: c_int) -> Bool
extern def __intrinsic_atomic_fetch_add_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32
extern def __intrinsic_atomic_fetch_sub_u32(ptr: PtrMut[u32], value: u32, order: c_int) -> u32

extern def __intrinsic_atomic_load_u64(ptr: Ptr[u64], order: c_int) -> u64
extern def __intrinsic_atomic_store_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> Unit
extern def __intrinsic_atomic_exchange_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64
extern def __intrinsic_atomic_compare_exchange_u64(ptr: PtrMut[u64], expected: PtrMut[u64], desired: u64, weak: Bool, success_order: c_int, failure_order: c_int) -> Bool
extern def __intrinsic_atomic_fetch_add_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64
extern def __intrinsic_atomic_fetch_sub_u64(ptr: PtrMut[u64], value: u64, order: c_int) -> u64

# ═══════════════════════════════════════════════════════════════
# Atomic Types
# ═══════════════════════════════════════════════════════════════

## Atomic boolean with lock-free operations
struct AtomicBool
  value: u8  # 1-byte storage for the width-1 atomic intrinsics
end

def AtomicBool::new(val: Bool) -> AtomicBool
  AtomicBool { value: if val then 1 else 0 end }
end

def AtomicBool::load(self: AtomicBool) -> Bool
  __intrinsic_atomic_load_u8(&self.value as Ptr[u8], 5) != 0
end

def AtomicBool::store(inout self: AtomicBool, val: Bool) -> Unit
  __intrinsic_atomic_store_u8(&self.value as PtrMut[u8], if val then 1 else 0 end, 5)
end

def AtomicBool::swap(inout self: AtomicBool, val: Bool) -> Bool
  let old = __intrinsic_atomic_exchange_u8(&self.value as PtrMut[u8], if val then 1 else 0 end, 5)
  old != 0
end

def AtomicBool::compare_and_swap(inout self: AtomicBool, expected: Bool, new_val: Bool) -> Bool
  mut exp: u8 = if expected then 1 else 0 end
  let _ = __intrinsic_atomic_compare_exchange_u8(&self.value as PtrMut[u8], &mut exp as PtrMut[u8], if new_val then 1 else 0 end, false, 5, 5)
  exp != 0
end

## Atomic 32-bit unsigned integer
struct AtomicU32
  value: u32
end

def AtomicU32::new(val: u32) -> AtomicU32
  AtomicU32 { value: val }
end

def AtomicU32::load(self: AtomicU32) -> u32
  __intrinsic_atomic_load_u32(&self.value as Ptr[u32], 5)
end

def AtomicU32::store(inout self: AtomicU32, val: u32) -> Unit
  __intrinsic_atomic_store_u32(&self.value as PtrMut[u32], val, 5)
end

def AtomicU32::fetch_add(inout self: AtomicU32, val: u32) -> u32
  __intrinsic_atomic_fetch_add_u32(&self.value as PtrMut[u32], val, 5)
end

def AtomicU32::fetch_sub(inout self: AtomicU32, val: u32) -> u32
  __intrinsic_atomic_fetch_sub_u32(&self.value as PtrMut[u32], val, 5)
end

def AtomicU32::swap(inout self: AtomicU32, val: u32) -> u32
  __intrinsic_atomic_exchange_u32(&self.value as PtrMut[u32], val, 5)
end

def AtomicU32::compare_and_swap(inout self: AtomicU32, expected: u32, new_val: u32) -> u32
  mut exp = expected
  let _ = __intrinsic_atomic_compare_exchange_u32(&self.value as PtrMut[u32], &mut exp as PtrMut[u32], new_val, false, 5, 5)
  exp
end

## Atomic 64-bit unsigned integer
struct AtomicU64
  value: u64
end

def AtomicU64::new(val: u64) -> AtomicU64
  AtomicU64 { value: val }
end

def AtomicU64::load(self: AtomicU64) -> u64
  __intrinsic_atomic_load_u64(&self.value as Ptr[u64], 5)
end

def AtomicU64::store(inout self: AtomicU64, val: u64) -> Unit
  __intrinsic_atomic_store_u64(&self.value as PtrMut[u64], val, 5)
end

def AtomicU64::fetch_add(inout self: AtomicU64, val: u64) -> u64
  __intrinsic_atomic_fetch_add_u64(&self.value as PtrMut[u64], val, 5)
end

def AtomicU64::fetch_sub(inout self: AtomicU64, val: u64) -> u64
  __intrinsic_atomic_fetch_sub_u64(&self.value as PtrMut[u64], val, 5)
end

def AtomicU64::swap(inout self: AtomicU64, val: u64) -> u64
  __intrinsic_atomic_exchange_u64(&self.value as PtrMut[u64], val, 5)
end

def AtomicU64::compare_and_swap(inout self: AtomicU64, expected: u64, new_val: u64) -> u64
  mut exp = expected
  let _ = __intrinsic_atomic_compare_exchange_u64(&self.value as PtrMut[u64], &mut exp as PtrMut[u64], new_val, false, 5, 5)
  exp
end

## Atomic pointer (size_t)
struct AtomicPtr[T]
  value: PtrMut[T]
end

def AtomicPtr::new[T](ptr: PtrMut[T]) -> AtomicPtr[T]
  AtomicPtr { value: ptr }
end

def AtomicPtr::load[T](self: AtomicPtr[T]) -> Ptr[T]
  let v = __intrinsic_atomic_load_u64(&self.value as Ptr[u64], 5)
  unsafe { v as Ptr[T] }
end

def AtomicPtr::store[T](inout self: AtomicPtr[T], ptr: PtrMut[T]) -> Unit
  __intrinsic_atomic_store_u64(&self.value as PtrMut[u64], (ptr as Int) as u64, 5)
end

def AtomicPtr::swap[T](inout self: AtomicPtr[T], ptr: PtrMut[T]) -> Ptr[T]
  let old = __intrinsic_atomic_exchange_u64(&self.value as PtrMut[u64], (ptr as Int) as u64, 5)
  unsafe { old as Ptr[T] }
end

# ═══════════════════════════════════════════════════════════════
# Mutex
# ═══════════════════════════════════════════════════════════════

## A mutual exclusion lock for protecting shared data
##
## The lock state lives in a heap allocation owned by an Arc (the real
## allocator). Mutex::lock clones the Arc into the guard, so the guard KEEPS
## THE STATE ALIVE: the Mutex can be dropped or moved while the guard lives.
## The lock acquisition is an atomic swap on the inner's AtomicBool; the
## guard's Drop releases the lock with an atomic store and the compiler's
## deinit plan drops the guard's Arc clone (the last clone releases the
## allocation). No guard ever holds a raw pointer into a caller-owned Mutex.
struct Mutex[T]
  inner: Arc[MutexInner[T]]
end

struct MutexInner[T]
  locked: AtomicBool
  value: T
end

## Guard returned by Mutex::lock() that releases the lock on drop.
## The guard holds its own Arc clone of the inner state.
struct MutexGuard[T]
  inner: Arc[MutexInner[T]]
end

def Mutex::new[T](value: T) -> Mutex[T]
  Mutex {
    inner: Arc::new(MutexInner {
      locked: AtomicBool::new(false),
      value: value
    })
  }
end

def Mutex::lock[T](self: Mutex[T]) -> MutexGuard[T]
  let inner = self.inner.clone()
  while inner.ptr.as_ref().locked.swap(true) do
    std::thread::yield_now()
  end
  MutexGuard { inner: inner }
end

def Mutex::try_lock[T](self: Mutex[T]) -> Option[MutexGuard[T]]
  let inner = self.inner.clone()
  if inner.ptr.as_ref().locked.swap(true) then
    return Option::None
  end
  Option::Some(MutexGuard { inner: inner })
end

def Mutex::is_locked[T](self: Mutex[T]) -> Bool
  self.inner.ptr.as_ref().locked.load()
end

# MutexGuard operations
impl[T] MutexGuard[T]
  def get(self: MutexGuard[T]) -> Ptr[T]
    # The value access goes through the Arc the guard keeps alive — the
    # Arc's deref (the inner's value lives in the Arc's allocation).
    address_of(&mut self.inner.ptr.as_ref().value) as Ptr[T]
  end
  
  def get_mut(inout self: MutexGuard[T]) -> PtrMut[T]
    # The unconditional PtrMut through the Arc is intentional HERE: the
    # guard holds the lock (no reader or writer can touch the inner
    # concurrently) — uniqueness comes from the LOCK PROTOCOL, not the
    # refcount (the guard's Arc clone is never unique: the Mutex itself
    # holds a second clone, so Arc::get_mut would always be None). This
    # raw path is the explicitly-unsafe primitive the Arc surface no
    # longer exposes unconditionally.
    unsafe { address_of_mut(&mut (*self.inner.ptr).value) }
  end
  
  def deref(self: MutexGuard[T]) -> Ptr[T]
    self.get()
  end
  
  def deref_mut(inout self: MutexGuard[T]) -> PtrMut[T]
    self.get_mut()
  end
end

impl[T] Drop for MutexGuard[T]
  def drop(inout self: MutexGuard[T]) -> Unit
    # Release the lock (the atomic store). The guard's Arc clone is then
    # dropped by the deinit plan — the inner allocation stays alive as long
    # as ANY Arc clone (the Mutex's or a guard's) still references it.
    self.inner.ptr.as_ref().locked.store(false)
  end
end

# ═══════════════════════════════════════════════════════════════
# Condvar (Condition Variable)
# ═══════════════════════════════════════════════════════════════

## A condition variable for signaling between threads.
##
## The notification state lives behind an Arc. Condvar::wait drops the
## MutexGuard (its Drop runs — the atomic store releases the lock and the
## guard's Arc clone is released), polls the notification state until a
## notify advances it, then re-acquires the lock through the Arc the guard
## kept alive — the mutex state can never dangle while the wait is in
## flight.
##
## THE TICKET DESIGN (notify_one vs notify_all): CondvarInner carries TWO
## counters — `notified` (the generation, advanced on EVERY notify) and
## `waiting` (the registered-waiter ticket counter). A waiter snapshots
## the generation FIRST, then registers (waiting += 1 — its ticket is
## fetch_add's old value): the snapshot predates the registration, so a
## notify that consumes this waiter's membership (its generation advance
## follows the consumed registration) is always visible to the waiter's
## generation check. notify_one consumes ONE membership and advances the
## generation exactly once: if the waiting count is > 0 it decrements the
## waiting count and increments the generation — the ONE waiter whose
## ticket matches the NEW waiting count (and whose generation snapshot is
## stale) proceeds; every other waiter's snapshot is stale but its
## membership is not revoked, so it stays blocked. notify_all advances the
## generation and ZEROES the waiting count — every registered waiter's
## membership is revoked at once, so all of them proceed. A waiter's poll
## loop therefore checks BOTH the generation against its snapshot AND the
## waiting-count membership (waiting <= ticket): notify_one wakes exactly
## one waiter, notify_all wakes every remaining waiter. A notify that
## races a registration is never lost (the snapshot precedes the
## registration, so the notify's generation advance is visible) and the
## counters' monotonicity makes the wait re-check before blocking.
struct Condvar
  inner: Arc[CondvarInner]
end

struct CondvarInner
  notified: AtomicU32
  waiting: AtomicU32
end

def Condvar::new() -> Condvar
  Condvar { inner: Arc::new(CondvarInner { notified: AtomicU32::new(0), waiting: AtomicU32::new(0) }) }
end

def Condvar::wait[T](self: Condvar, guard: MutexGuard[T]) -> MutexGuard[T]
  # Snapshot the generation FIRST, then register: the snapshot predates
  # the registration, so any notify that consumes THIS waiter's
  # membership (the notify's generation advance follows the consumed
  # registration) is visible to the generation check — the waiter never
  # sleeps through its own wakeup. A notify that fires before the
  # registration is either a no-op (no waiters) or consumed an earlier
  # waiter — the membership check (waiting <= ticket) disambiguates.
  let inner = self.inner.ptr.as_ref()
  let seen = inner.notified.load()
  let ticket = inner.waiting.fetch_add(1)
  let inner_arc = guard.inner.clone()
  drop(guard)
  while inner.notified.load() == seen || inner.waiting.load() > ticket do
    std::thread::yield_now()
  end
  let mutex = Mutex { inner: inner_arc }
  let result = mutex.lock()
  drop(mutex)
  result
end

def Condvar::wait_timeout[T](self: Condvar, guard: MutexGuard[T], timeout: Duration) -> MutexGuard[T]
  let start = Instant::now()
  let inner = self.inner.ptr.as_ref()
  let seen = inner.notified.load()
  let ticket = inner.waiting.fetch_add(1)
  let inner_arc = guard.inner.clone()
  drop(guard)
  mut timed_out = false
  loop do
    if inner.notified.load() != seen && inner.waiting.load() <= ticket then
      break
    end
    if start.elapsed() >= timeout then
      timed_out = true
      break
    end
    std::thread::yield_now()
  end
  if timed_out then
    # The timeout exits without a notify: reclaim the registration IF it
    # is still live (waiting > ticket — the membership was not consumed).
    # A racing notify_one's decrement may land between the load and the
    # fetch_sub; the count then drops one extra, which can only cause a
    # spurious wakeup, never a lost one.
    if inner.waiting.load() > ticket then
      inner.waiting.fetch_sub(1)
    end
  end
  let mutex = Mutex { inner: inner_arc }
  let result = mutex.lock()
  drop(mutex)
  result
end

def Condvar::wait_timeout_ms[T](self: Condvar, guard: MutexGuard[T], ms: Int) -> MutexGuard[T]
  self.wait_timeout(guard, Duration::from_millis(ms))
end

def Condvar::notify_one(self: Condvar) -> Unit
  let inner = self.inner.ptr.as_ref()
  # Consume exactly ONE membership (the decrement FIRST, then the
  # generation advance): the consumed waiter's snapshot predates its
  # registration, which predates the decrement, so its generation check
  # fires — no lost wakeup. A waiter registering between the two steps
  # may wake spuriously (legal), never lost.
  loop do
    let w = inner.waiting.load()
    if w == 0 then
      break
    end
    if inner.waiting.compare_and_swap(w, w - 1) == w then
      inner.notified.fetch_add(1)
      break
    end
  end
end

def Condvar::notify_all(self: Condvar) -> Unit
  let inner = self.inner.ptr.as_ref()
  # Advance the generation (every registered waiter's snapshot goes
  # stale) and ZERO the waiting count (every waiter's membership is
  # revoked — the remaining waiters all proceed).
  inner.notified.fetch_add(1)
  loop do
    let w = inner.waiting.load()
    if w == 0 then
      break
    end
    if inner.waiting.compare_and_swap(w, 0) == w then
      break
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# RwLock (Reader-Writer Lock)
# ═══════════════════════════════════════════════════════════════

## A reader-writer lock allowing multiple readers or one writer.
##
## The lock state (the reader count + the writer flag) lives in a heap
## allocation owned by an Arc. The guards hold their own Arc clones — the
## state stays alive even if the RwLock is dropped or moved while a guard
## lives. read() increments the reader count; write() sets the writer flag
## with an atomic swap; each guard's Drop undoes its side of the state and
## the deinit plan releases the guard's Arc clone.
struct RwLock[T]
  inner: Arc[RwLockInner[T]]
end

struct RwLockInner[T]
  readers: AtomicU32
  writer: AtomicBool
  value: T
end

struct RwLockReadGuard[T]
  inner: Arc[RwLockInner[T]]
end

struct RwLockWriteGuard[T]
  inner: Arc[RwLockInner[T]]
end

def RwLock::new[T](value: T) -> RwLock[T]
  RwLock {
    inner: Arc::new(RwLockInner {
      readers: AtomicU32::new(0),
      writer: AtomicBool::new(false),
      value: value
    })
  }
end

def RwLock::read[T](self: RwLock[T]) -> RwLockReadGuard[T]
  let inner = self.inner.clone()
  loop do
    if !inner.ptr.as_ref().writer.load() then
      inner.ptr.as_ref().readers.fetch_add(1)
      if !inner.ptr.as_ref().writer.load() then
        break
      end
      # A writer won between the check and the increment — back off
      inner.ptr.as_ref().readers.fetch_sub(1)
    end
    std::thread::yield_now()
  end
  RwLockReadGuard { inner: inner }
end

def RwLock::try_read[T](self: RwLock[T]) -> Option[RwLockReadGuard[T]]
  let inner = self.inner.clone()
  if inner.ptr.as_ref().writer.load() then
    return Option::None
  end
  inner.ptr.as_ref().readers.fetch_add(1)
  if inner.ptr.as_ref().writer.load() then
    inner.ptr.as_ref().readers.fetch_sub(1)
    return Option::None
  end
  Option::Some(RwLockReadGuard { inner: inner })
end

def RwLock::write[T](self: RwLock[T]) -> RwLockWriteGuard[T]
  let inner = self.inner.clone()
  loop do
    if !inner.ptr.as_ref().writer.swap(true) then
      if inner.ptr.as_ref().readers.load() == 0 then
        break
      end
      # Readers are still active — release the writer flag and retry
      inner.ptr.as_ref().writer.store(false)
    end
    std::thread::yield_now()
  end
  RwLockWriteGuard { inner: inner }
end

def RwLock::try_write[T](self: RwLock[T]) -> Option[RwLockWriteGuard[T]]
  let inner = self.inner.clone()
  if inner.ptr.as_ref().writer.swap(true) then
    return Option::None
  end
  if inner.ptr.as_ref().readers.load() != 0 then
    inner.ptr.as_ref().writer.store(false)
    return Option::None
  end
  Option::Some(RwLockWriteGuard { inner: inner })
end

impl[T] RwLockReadGuard[T]
  def get(self: RwLockReadGuard[T]) -> Ptr[T]
    address_of(&mut self.inner.ptr.as_ref().value) as Ptr[T]
  end
  
  def deref(self: RwLockReadGuard[T]) -> Ptr[T]
    self.get()
  end
end

impl[T] Drop for RwLockReadGuard[T]
  def drop(inout self: RwLockReadGuard[T]) -> Unit
    self.inner.ptr.as_ref().readers.fetch_sub(1)
  end
end

impl[T] RwLockWriteGuard[T]
  def get(self: RwLockWriteGuard[T]) -> Ptr[T]
    address_of(&mut self.inner.ptr.as_ref().value) as Ptr[T]
  end
  
  def get_mut(inout self: RwLockWriteGuard[T]) -> PtrMut[T]
    # Same lock-exclusive justification as MutexGuard::get_mut: a write
    # guard holds the writer flag (readers cannot be concurrent), so the
    # inner is unique BY THE LOCK — the guard's Arc clone is never
    # refcount-unique (the RwLock holds a second clone) and Arc::get_mut
    # cannot be used here. The raw path is the explicitly-unsafe
    # primitive.
    unsafe { address_of_mut(&mut (*self.inner.ptr).value) }
  end
  
  def deref(self: RwLockWriteGuard[T]) -> Ptr[T]
    self.get()
  end
  
  def deref_mut(inout self: RwLockWriteGuard[T]) -> PtrMut[T]
    self.get_mut()
  end
end

impl[T] Drop for RwLockWriteGuard[T]
  def drop(inout self: RwLockWriteGuard[T]) -> Unit
    self.inner.ptr.as_ref().writer.store(false)
  end
end

# ═══════════════════════════════════════════════════════════════
# Arc (Atomically Reference Counted)
# ═══════════════════════════════════════════════════════════════

## A thread-safe reference-counting pointer
struct Arc[T]
  ptr: Ptr[ArcInner[T]]
end

struct ArcInner[T]
  ref_count: AtomicU32
  data: T
end

def Arc::new[T](value: T) -> Arc[T]
  # Allocate on heap
  let ptr = alloc[ArcInner[T]]()
  if ptr.is_null() then
    panic("Arc::new: out of memory")
  end
  
  # Initialize ref count to 1
  ptr.write(ArcInner[T] {
    ref_count: AtomicU32::new(1),
    data: value
  })
  
  Arc { ptr: ptr }
end

def Arc::null[T]() -> Arc[T]
  Arc { ptr: Ptr::null() }
end

def Arc::is_null[T](self: Arc[T]) -> Bool
  self.ptr.is_null()
end

def Arc::clone[T](self: Arc[T]) -> Arc[T]
  if !self.ptr.is_null() then
    # The refcount OVERFLOW GUARD: an increment must never wrap the count
    # to zero (a wrapped count would let a fresh clone share a block whose
    # last-release is already past — a dangling owner). The increment
    # checks the current count first and TRAPS when it is at u32::MAX; the
    # compare-and-swap retry loop makes the check-and-increment atomic
    # (two racing clones re-read the count after a failed CAS instead of
    # both passing the pre-check) — the same loop shape WeakArc::upgrade
    # uses for its refcount increment.
    loop do
      let current = self.ptr.as_ref().ref_count.load()
      if current == 0xFFFFFFFF then
        panic("Arc::clone: reference count overflow")
      end
      let old = self.ptr.as_ref().ref_count.compare_and_swap(current, current + 1)
      if old == current then
        break
      end
    end
  end
  Arc { ptr: self.ptr }
end

def Arc::deref[T](self: Arc[T]) -> Ptr[T]
  address_of(&mut self.ptr.as_ref().data) as Ptr[T]
end

def Arc::strong_count[T](self: Arc[T]) -> u32
  if self.ptr.is_null() then
    return 0
  end
  self.ptr.as_ref().ref_count.load()
end

## The UNIQUE-ONLY mutable access: Some exactly while this Arc is the sole
## owner (the strong count is one — the load == 1 check). At that point no
## other clone, and therefore no other thread, can observe the inner, so
## the returned PtrMut is a race-free exclusive view. The unconditional
## mutation through a shared Arc is UNAVAILABLE: callers that need the raw
## path take it explicitly inside `unsafe` (the guards' lock-exclusive raw
## access elsewhere in this module is that primitive).
def Arc::get_mut[T](inout self: Arc[T]) -> Option[PtrMut[T]]
  if self.ptr.as_ref().ref_count.load() == 1 then
    Option::Some(unsafe { address_of_mut(&mut (*self.ptr).data) })
  else
    Option::None
  end
end

## The CONSUMING try_unwrap: sink self is MOVED — the caller's Arc is
## consumed on BOTH outcomes. Success (the count is exactly one): the data
## is moved OUT of the control block (the raw place read transfers the
## bytes; the stale block copy is never destructed — the block is freed
## WITHOUT drop glue on purpose, the same raw move Rc::try_unwrap uses),
## the block is freed, and the consumed Arc's ptr is NULLED so its
## destructor (the sink param's finalize at scope end) is a no-op — the
## freed allocation is never touched again (no double-free). Failure: the
## caller's own reference comes back (Err(self)); the refcount is
## untouched — try_unwrap never releases, and the caller drops it once.
def Arc::try_unwrap[T](sink self: Arc[T]) -> Result[T, Arc[T]]
  if !self.ptr.is_null() && self.ptr.as_ref().ref_count.load() == 1 then
    let value = unsafe { (*self.ptr).data }
    dealloc[ArcInner[T]](self.ptr)
    self.ptr = Ptr::null()
    Result::Ok(value)
  else
    Result::Err(self)
  end
end

impl[T] Drop for Arc[T]
  def drop(inout self: Arc[T]) -> Unit
    if self.ptr.is_null() then
      return
    end
    
    let old_count = self.ptr.as_ref().ref_count.fetch_sub(1)
    
    if old_count == 1 then
      # Last reference: the atomic fetch_sub just established the zero
      # count (old_count == 1 — THIS thread is the last releaser). Destroy
      # the inner's data FIRST — drop_in_place is the compiler's typed
      # destruction glue (the deinit plan for the concrete ArcInner[T]:
      # the refcount is a trivial atomic, the data is the only owning
      # field, so the glue runs T's destructor exactly once) — THEN
      # release the storage. A bare dealloc would leak the contained
      # destructor (Arc[String]/Arc[Mutex[Resource]] would never free
      # their owned state).
      self.ptr.drop_in_place()
      dealloc[ArcInner[T]](self.ptr)
      self.ptr = Ptr::null()
    end
  end
end

## A sender end of a channel
struct Sender[T]
  inner: Arc[ChannelInner[T]]
end

## A receiver end of a channel
struct Receiver[T]
  inner: Arc[ChannelInner[T]]
end

struct ChannelInner[T]
  queue: Mutex[Queue[T]]
  condvar: Condvar
  closed: AtomicBool
end

## Create a new channel
def channel[T]() -> (Sender[T], Receiver[T])
  let inner = Arc::new(ChannelInner {
    queue: Mutex::new(Queue::new()),
    condvar: Condvar::new(),
    closed: AtomicBool::new(false)
  })
  
  (
    Sender { inner: inner.clone() },
    Receiver { inner: inner }
  )
end

impl[T] Sender[T]
  def send(self: Sender[T], value: T) -> Result[Unit, String]
    if self.inner.closed.load() then
      return Result::Err("Channel is closed".to_string())
    end
    
    let mut guard = self.inner.queue.lock()
    guard.enqueue(value)
    self.inner.condvar.notify_one()
    Result::Ok(())
  end
  
  def close(self: Sender[T]) -> Unit
    self.inner.closed.store(true)
    self.inner.condvar.notify_all()
  end
  
  def is_closed(self: Sender[T]) -> Bool
    self.inner.closed.load()
  end
end

impl[T] Clone for Sender[T]
  def clone(self: Sender[T]) -> Sender[T]
    Sender { inner: self.inner.clone() }
  end
end

impl[T] Receiver[T]
  def recv(self: Receiver[T]) -> Option[T]
    let mut guard = self.inner.queue.lock()
    loop do
      match guard.dequeue()
      when Option::Some(v) then return Option::Some(v)
      when Option::None then
        if self.inner.closed.load() then
          return Option::None
        end
        guard = self.inner.condvar.wait(guard)
      end
    end
  end
  
  def try_recv(self: Receiver[T]) -> Option[T]
    let mut guard = self.inner.queue.lock()
    guard.dequeue()
  end
  
  def recv_timeout(self: Receiver[T], timeout: Duration) -> Option[T]
    let mut guard = self.inner.queue.lock()
    let start = Instant::now()
    loop do
      match guard.dequeue()
      when Option::Some(v) then return Option::Some(v)
      when Option::None then
        if self.inner.closed.load() then
          return Option::None
        end
        
        let elapsed = start.elapsed()
        if elapsed >= timeout then
          return Option::None
        end
        
        guard = self.inner.condvar.wait_timeout(guard, timeout - elapsed)
      end
    end
  end
  
  def is_empty(self: Receiver[T]) -> Bool
    let guard = self.inner.queue.lock()
    guard.is_empty()
  end
end

impl[T] Clone for Receiver[T]
  def clone(self: Receiver[T]) -> Receiver[T]
    Receiver { inner: self.inner.clone() }
  end
end

# ═══════════════════════════════════════════════════════════════
# Once (One-time Initialization)
# ═══════════════════════════════════════════════════════════════

## A synchronization primitive for one-time initialization
struct Once
  state: AtomicU32
end

def ONCE_NOT_DONE() -> u32 = 0
def ONCE_IN_PROGRESS() -> u32 = 1
def ONCE_DONE() -> u32 = 2

def Once::new() -> Once
  Once { state: AtomicU32::new(ONCE_NOT_DONE()) }
end

def Once::call_once(self: Once, f: fn() -> Unit) -> Unit
  # Try to transition from NOT_DONE to IN_PROGRESS
  let old = self.state.compare_and_swap(ONCE_NOT_DONE(), ONCE_IN_PROGRESS())
  
  if old == ONCE_DONE() then
    # Already done, nothing to do
    return
  end
  
  if old == ONCE_IN_PROGRESS() then
    # Another thread is doing it, spin wait
    while self.state.load() != ONCE_DONE() do
      std::thread::yield_now()
    end
    return
  end
  
  # We got the lock, execute the function
  f()
  
  # Mark as done
  self.state.store(ONCE_DONE())
end

def Once::is_completed(self: Once) -> Bool
  self.state.load() == ONCE_DONE()
end

# ═══════════════════════════════════════════════════════════════
# Lazy (Lazy Initialization)
# ═══════════════════════════════════════════════════════════════

## Lazily initialized value
struct Lazy[T]
  once: Once
  value: Mutex[Option[T]]
  init: fn() -> T
end

def Lazy::new[T](init: fn() -> T) -> Lazy[T]
  Lazy {
    once: Once::new(),
    value: Mutex::new(Option::None),
    init: init
  }
end

def Lazy::get[T](self: Lazy[T]) -> Ptr[T]
  self.once.call_once(|| {
    let mut guard = self.value.lock()
    *(guard.deref_mut()) = Option::Some((self.init)())
  })
  
  let guard = self.value.lock()
  # Safe because we know the value is Some after initialization
  guard.deref() as Ptr[T]
end

# ═══════════════════════════════════════════════════════════════
# SpinLock (Simple spin lock for short critical sections)
# ═══════════════════════════════════════════════════════════════

## A simple spin lock - use only for very short critical sections
struct SpinLock
  locked: AtomicBool
end

def SpinLock::new() -> SpinLock
  SpinLock { locked: AtomicBool::new(false) }
end

def SpinLock::lock(inout self: SpinLock) -> Unit
  while self.locked.swap(true) do
    # Spin until we acquire the lock
    while self.locked.load() do
      std::thread::yield_now()
    end
  end
end

def SpinLock::try_lock(inout self: SpinLock) -> Bool
  !self.locked.swap(true)
end

def SpinLock::unlock(inout self: SpinLock) -> Unit
  self.locked.store(false)
end

def SpinLock::is_locked(self: SpinLock) -> Bool
  self.locked.load()
end

# ═══════════════════════════════════════════════════════════════
# Scope Guard (RAII for cleanup)
# ═══════════════════════════════════════════════════════════════

## A guard that runs a cleanup function when dropped
struct ScopeGuard[F: fn() -> Unit]
  cleanup: Option[F]
  dismissed: Bool
end

def ScopeGuard::new[F: fn() -> Unit](cleanup: F) -> ScopeGuard[F]
  ScopeGuard { cleanup: Option::Some(cleanup), dismissed: false }
end

def ScopeGuard::dismiss(inout self: ScopeGuard[F]) -> Unit
  self.dismissed = true
end

impl[F: fn() -> Unit] Drop for ScopeGuard[F]
  def drop(inout self: ScopeGuard[F]) -> Unit
    if !self.dismissed then
      match self.cleanup
      when Option::Some(f) then f()
      when Option::None then ()
      end
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Convenience Macros
# ═══════════════════════════════════════════════════════════════

# Note: These would be macros in a real implementation

def defer(cleanup: fn() -> Unit) -> ScopeGuard[fn() -> Unit]
  ScopeGuard::new(cleanup)
end
# ═══════════════════════════════════════════════════════════════
# Transferable / Shareable marker impls (access + resource model)
# ═══════════════════════════════════════════════════════════════

impl[T] Transferable for Mutex[T] {}
impl[T] Shareable for Mutex[T] {}

impl[T] Transferable for RwLock[T] {}
impl[T] Shareable for RwLock[T] {}

impl Transferable for Condvar {}
impl Shareable for Condvar {}

impl[T] Transferable for Sender[T] {}
impl[T] Shareable for Sender[T] {}

impl[T] Transferable for Receiver[T] {}
impl[T] Shareable for Receiver[T] {}

impl[T] Transferable for Arc[T] {}
impl[T] Shareable for Arc[T] {}

impl Transferable for AtomicBool {}
impl Shareable for AtomicBool {}

impl Transferable for AtomicU32 {}
impl Shareable for AtomicU32 {}

impl Transferable for AtomicU64 {}
impl Shareable for AtomicU64 {}

impl[T] Transferable for AtomicPtr[T] {}
impl[T] Shareable for AtomicPtr[T] {}

impl Transferable for Once {}
impl Shareable for Once {}
