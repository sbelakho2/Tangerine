# Tangerine Standard Library — std::sync
# Synchronization primitives and atomics (v0.1 minimal surface)

use std::core::{Option, Result}
use std::collections::VecDeque
use std::thread::{
  Mutex as ThreadMutex,
  MutexGuard as ThreadMutexGuard,
  mutex_new,
  RwLock as ThreadRwLock,
  RwLockReadGuard as ThreadRwLockReadGuard,
  RwLockWriteGuard as ThreadRwLockWriteGuard,
  rwlock_new,
  AtomicInt as ThreadAtomicInt,
  Ordering,
  atomic_int_new
}

struct Mutex[T]
  inner: ThreadMutex[T]
end

struct MutexGuard[T]
  inner: ThreadMutexGuard[T]
end

impl[T] Mutex[T]
  def new(value: T) -> Self
    Mutex {
      inner: mutex_new(value),
    }
  end

  def lock(self: &mut Self) -> Result[MutexGuard[T], String]
    Result::Ok(MutexGuard { inner: self.inner.lock() })
  end

  def try_lock(self: &mut Self) -> Option[MutexGuard[T]]
    match self.inner.try_lock()
    when Option::Some(g) then Option::Some(MutexGuard { inner: g })
    when Option::None then Option::None
    end
  end
end

impl[T] MutexGuard[T]
  def get(self: &Self) -> &T
    self.inner.get()
  end

  def get_mut(self: &mut Self) -> &mut T
    self.inner.get_mut()
  end

  def unlock(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

impl[T] Drop for MutexGuard[T]
  def drop(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

struct RwLock[T]
  inner: ThreadRwLock[T]
end

struct RwLockReadGuard[T]
  inner: ThreadRwLockReadGuard[T]
end

struct RwLockWriteGuard[T]
  inner: ThreadRwLockWriteGuard[T]
end

impl[T] RwLock[T]
  def new(value: T) -> Self
    RwLock {
      inner: rwlock_new(value),
    }
  end

  def read(self: &mut Self) -> Result[RwLockReadGuard[T], String]
    Result::Ok(RwLockReadGuard { inner: self.inner.read() })
  end

  def write(self: &mut Self) -> Result[RwLockWriteGuard[T], String]
    Result::Ok(RwLockWriteGuard { inner: self.inner.write() })
  end
end

impl[T] RwLockReadGuard[T]
  def get(self: &Self) -> &T
    self.inner.get()
  end

  def unlock(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

impl[T] Drop for RwLockReadGuard[T]
  def drop(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

impl[T] RwLockWriteGuard[T]
  def get(self: &Self) -> &T
    self.inner.get()
  end

  def get_mut(self: &mut Self) -> &mut T
    self.inner.get_mut()
  end

  def unlock(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

impl[T] Drop for RwLockWriteGuard[T]
  def drop(self: &mut Self) -> Unit
    drop(&mut self.inner)
  end
end

struct Channel[T]
  queue: Mutex[VecDeque[T]]
end

impl[T] Channel[T]
  def new() -> Self
    Channel { queue: Mutex::new(VecDeque::new()) }
  end

  def send(self: &mut Self, value: T) -> Unit
    match self.queue.lock()
    when Result::Ok(mut guard) then
      guard.get_mut().push_back(value)
    when Result::Err(_) then
      panic("Channel::send: mutex lock failed")
    end
  end

  def recv(self: &mut Self) -> Option[T]
    match self.queue.lock()
    when Result::Ok(mut guard) then
      guard.get_mut().pop_front()
    when Result::Err(_) then
      panic("Channel::recv: mutex lock failed")
    end
  end
end

struct AtomicInt
  inner: ThreadAtomicInt
end

impl AtomicInt
  def new(value: Int) -> Self
    AtomicInt { inner: atomic_int_new(value) }
  end

  def load(self: &Self) -> Int
    self.inner.load(Ordering::SeqCst)
  end

  def store(self: &mut Self, value: Int) -> Unit
    self.inner.store(value, Ordering::SeqCst)
  end

  def fetch_add(self: &mut Self, delta: Int) -> Int
    self.inner.fetch_add(delta, Ordering::SeqCst)
  end
end

# ———————————————————————————————————————————————————————————————
# Semaphore — counting semaphore
# ———————————————————————————————————————————————————————————————

struct Semaphore
  count: Mutex[Int]
  max: Int
end

impl Semaphore
  def new(initial: Int) -> Self
    Semaphore { count: Mutex::new(initial), max: initial }
  end

  ## Acquire a permit (blocking). Decrements the count.
  def acquire(self: &mut Self) -> Unit
    loop
      match self.count.lock()
      when Result::Ok(mut guard) then
        if *guard.get() > 0 then
          *guard.get_mut() = *guard.get() - 1
          return
        end
      when Result::Err(_) then panic("Semaphore: mutex poisoned")
      end
      ## Busy-wait (a real impl would use futex/condvar)
      std::thread::yield_now()
    end
  end

  ## Try to acquire without blocking.
  def try_acquire(self: &mut Self) -> Bool
    match self.count.lock()
    when Result::Ok(mut guard) then
      if *guard.get() > 0 then
        *guard.get_mut() = *guard.get() - 1
        true
      else
        false
      end
    when Result::Err(_) then false
    end
  end

  ## Release a permit. Increments the count.
  def release(self: &mut Self) -> Unit
    match self.count.lock()
    when Result::Ok(mut guard) then
      *guard.get_mut() = *guard.get() + 1
    when Result::Err(_) then panic("Semaphore: mutex poisoned")
    end
  end

  def available_permits(self: &Self) -> Int
    match self.count.lock()
    when Result::Ok(guard) then *guard.get()
    when Result::Err(_) then 0
    end
  end
end

# ———————————————————————————————————————————————————————————————
# Barrier — synchronization point for N threads
# ———————————————————————————————————————————————————————————————

struct Barrier
  target: Int
  count: Mutex[Int]
  generation: Mutex[Int]
end

struct BarrierWaitResult
  is_leader: Bool
end

impl BarrierWaitResult
  def is_leader(self: &Self) -> Bool
    self.is_leader
  end
end

impl Barrier
  def new(count: Int) -> Self
    assert(count > 0, "Barrier count must be positive")
    Barrier {
      target: count,
      count: Mutex::new(0),
      generation: Mutex::new(0),
    }
  end

  ## Wait at the barrier until all threads arrive.
  def wait(self: &mut Self) -> BarrierWaitResult
    let gen = match self.generation.lock()
    when Result::Ok(g) then *g.get()
    when Result::Err(_) then panic("Barrier: mutex poisoned")
    end

    let is_leader = match self.count.lock()
    when Result::Ok(mut guard) then
      *guard.get_mut() = *guard.get() + 1
      if *guard.get() == self.target then
        *guard.get_mut() = 0
        match self.generation.lock()
        when Result::Ok(mut g) then *g.get_mut() = *g.get() + 1
        when Result::Err(_) then ()
        end
        true
      else
        false
      end
    when Result::Err(_) then panic("Barrier: mutex poisoned")
    end

    if !is_leader then
      ## Wait for generation to advance
      loop
        match self.generation.lock()
        when Result::Ok(g) then
          if *g.get() != gen then break end
        when Result::Err(_) then break
        end
        std::thread::yield_now()
      end
    end

    BarrierWaitResult { is_leader: is_leader }
  end
end

# ———————————————————————————————————————————————————————————————
# OnceCell — lazy init container (write once)
# ———————————————————————————————————————————————————————————————

struct OnceCell[T]
  inner: Mutex[Option[T]]
  initialized: AtomicInt  ## 0 = not init, 1 = init
end

impl[T] OnceCell[T]
  def new() -> Self
    OnceCell {
      inner: Mutex::new(Option::None),
      initialized: AtomicInt::new(0),
    }
  end

  def get(self: &Self) -> Option[&T]
    if self.initialized.load() == 1 then
      match self.inner.lock()
      when Result::Ok(guard) then
        match guard.get()
        when Option::Some(ref v) then Option::Some(v)
        when Option::None then Option::None
        end
      when Result::Err(_) then Option::None
      end
    else
      Option::None
    end
  end

  def get_or_init(self: &mut Self, f: fn() -> T) -> &T
    if self.initialized.load() == 0 then
      match self.inner.lock()
      when Result::Ok(mut guard) then
        if guard.get().is_none() then
          *guard.get_mut() = Option::Some(f())
          self.initialized.store(1)
        end
      when Result::Err(_) then panic("OnceCell: mutex poisoned")
      end
    end
    self.get().unwrap()
  end

  def is_initialized(self: &Self) -> Bool
    self.initialized.load() == 1
  end
end

# ———————————————————————————————————————————————————————————————
# CancellationToken — cooperative cancellation
# ———————————————————————————————————————————————————————————————

struct CancellationToken
  cancelled: AtomicInt  ## 0 = not cancelled, 1 = cancelled
end

impl CancellationToken
  def new() -> Self
    CancellationToken { cancelled: AtomicInt::new(0) }
  end

  def cancel(self: &mut Self) -> Unit
    self.cancelled.store(1)
  end

  def is_cancelled(self: &Self) -> Bool
    self.cancelled.load() == 1
  end

  ## Create a child token that is cancelled when this one is.
  def child(self: &Self) -> CancellationToken
    let token = CancellationToken::new()
    if self.is_cancelled() then
      token.cancelled.store(1)
    end
    token
  end
end
