# Tangerine Standard Library — std::sync
# Synchronization Primitives for Concurrent Programming
#
# This module provides thread-safe primitives:
#   - Mutex: Mutual exclusion lock
#   - Condvar: Condition variable for signaling
#   - Atomic types: Lock-free atomic operations
#   - Arc: Atomically reference-counted smart pointer
#   - RwLock: Reader-writer lock
#   - Barrier: Synchronization barrier
#   - Channel: Multi-producer multi-consumer channels
#
# Example:
#   use std::sync::{Mutex, Arc}
#   
#   let data = Arc::new(Mutex::new(0))
#   let data_clone = data.clone()
#   
#   spawn_thread(move || {
#     match data_clone.lock()
#     when Option::Some(mut guard) then
#       *guard = *guard + 1
#     when Option::None then ()
#     end
#   })

use std::core::{Option, Result, String, Bool, Int, UInt, Unit}
use std::collections::{Vec, Queue}
use std::thread::{Thread, current_thread}
use std::time::{Duration, Instant}

# ═══════════════════════════════════════════════════════════════
# FFI to pthreads for synchronization primitives
# ═══════════════════════════════════════════════════════════════

extern "C"
  # pthread mutex
  def pthread_mutex_init(inout mutex: PthreadMutex, attr: u8) -> Int
  def pthread_mutex_destroy(inout mutex: PthreadMutex) -> Int
  def pthread_mutex_lock(inout mutex: PthreadMutex) -> Int
  def pthread_mutex_trylock(inout mutex: PthreadMutex) -> Int
  def pthread_mutex_unlock(inout mutex: PthreadMutex) -> Int
  
  # pthread condition variable
  def pthread_cond_init(inout cond: PthreadCond, attr: u8) -> Int
  def pthread_cond_destroy(inout cond: PthreadCond) -> Int
  def pthread_cond_signal(inout cond: PthreadCond) -> Int
  def pthread_cond_broadcast(inout cond: PthreadCond) -> Int
  def pthread_cond_wait(inout cond: PthreadCond, inout mutex: PthreadMutex) -> Int
  def pthread_cond_timedwait(inout cond: PthreadCond, inout mutex: PthreadMutex, abstime: Timespec) -> Int
  
  # pthread read-write lock
  def pthread_rwlock_init(inout rwlock: PthreadRwlock, attr: u8) -> Int
  def pthread_rwlock_destroy(inout rwlock: PthreadRwlock) -> Int
  def pthread_rwlock_rdlock(inout rwlock: PthreadRwlock) -> Int
  def pthread_rwlock_tryrdlock(inout rwlock: PthreadRwlock) -> Int
  def pthread_rwlock_wrlock(inout rwlock: PthreadRwlock) -> Int
  def pthread_rwlock_trywrlock(inout rwlock: PthreadRwlock) -> Int
  def pthread_rwlock_unlock(inout rwlock: PthreadRwlock) -> Int
  
  # pthread barrier
  def pthread_barrier_init(inout barrier: PthreadBarrier, attr: u8, count: UInt) -> Int
  def pthread_barrier_destroy(inout barrier: PthreadBarrier) -> Int
  def pthread_barrier_wait(inout barrier: PthreadBarrier) -> Int
  
  # atomic operations (compiler builtins)
  def __sync_fetch_and_add_4(inout ptr: u32, val: u32) -> u32
  def __sync_fetch_and_sub_4(inout ptr: u32, val: u32) -> u32
  def __sync_val_compare_and_swap_4(inout ptr: u32, oldval: u32, newval: u32) -> u32
  def __sync_lock_test_and_set_4(inout ptr: u32, val: u32) -> u32
  def __sync_fetch_and_add_8(inout ptr: u64, val: u64) -> u64
  def __sync_fetch_and_sub_8(inout ptr: u64, val: u64) -> u64
  def __sync_val_compare_and_swap_8(inout ptr: u64, oldval: u64, newval: u64) -> u64
  def __sync_lock_test_and_set_8(inout ptr: u64, val: u64) -> u64
  
  # memory fence
  def __sync_synchronize() -> Unit
end

# Platform-specific structures
@repr(C)
struct PthreadMutex
  # Opaque - size varies by platform
  data: [u8; 40]
end

@repr(C)
struct PthreadCond
  data: [u8; 48]
end

@repr(C)
struct PthreadRwlock
  data: [u8; 56]
end

@repr(C)
struct PthreadBarrier
  data: [u8; 32]
end

@repr(C)
struct Timespec
  tv_sec: i64
  tv_nsec: i64
end

# ═══════════════════════════════════════════════════════════════
# Atomic Types
# ═══════════════════════════════════════════════════════════════

## Atomic boolean with lock-free operations
struct AtomicBool
  value: u32  # Use u32 for atomic compatibility
end

def AtomicBool::new(val: Bool) -> AtomicBool
  AtomicBool { value: if val then 1 else 0 end }
end

def AtomicBool::load(self: AtomicBool) -> Bool
  __sync_synchronize()
  self.value != 0
end

def AtomicBool::store(inout self: AtomicBool, val: Bool) -> Unit
  self.value = if val then 1 else 0 end
  __sync_synchronize()
end

def AtomicBool::swap(inout self: AtomicBool, val: Bool) -> Bool
  let new_val = if val then 1u32 else 0u32 end
  let old = __sync_lock_test_and_set_4(&mut self.value, new_val)
  old != 0
end

def AtomicBool::compare_and_swap(inout self: AtomicBool, expected: Bool, new_val: Bool) -> Bool
  let exp_u32 = if expected then 1u32 else 0u32 end
  let new_u32 = if new_val then 1u32 else 0u32 end
  let old = __sync_val_compare_and_swap_4(&mut self.value, exp_u32, new_u32)
  old != 0
end

## Atomic 32-bit unsigned integer
struct AtomicU32
  value: u32
end

def AtomicU32::new(val: u32) -> AtomicU32
  AtomicU32 { value: val }
end

def AtomicU32::load(self: AtomicU32) -> u32
  __sync_synchronize()
  self.value
end

def AtomicU32::store(inout self: AtomicU32, val: u32) -> Unit
  self.value = val
  __sync_synchronize()
end

def AtomicU32::fetch_add(inout self: AtomicU32, val: u32) -> u32
  __sync_fetch_and_add_4(&mut self.value, val)
end

def AtomicU32::fetch_sub(inout self: AtomicU32, val: u32) -> u32
  __sync_fetch_and_sub_4(&mut self.value, val)
end

def AtomicU32::swap(inout self: AtomicU32, val: u32) -> u32
  __sync_lock_test_and_set_4(&mut self.value, val)
end

def AtomicU32::compare_and_swap(inout self: AtomicU32, expected: u32, new_val: u32) -> u32
  __sync_val_compare_and_swap_4(&mut self.value, expected, new_val)
end

## Atomic 64-bit unsigned integer
struct AtomicU64
  value: u64
end

def AtomicU64::new(val: u64) -> AtomicU64
  AtomicU64 { value: val }
end

def AtomicU64::load(self: AtomicU64) -> u64
  __sync_synchronize()
  self.value
end

def AtomicU64::store(inout self: AtomicU64, val: u64) -> Unit
  self.value = val
  __sync_synchronize()
end

def AtomicU64::fetch_add(inout self: AtomicU64, val: u64) -> u64
  __sync_fetch_and_add_8(&mut self.value, val)
end

def AtomicU64::fetch_sub(inout self: AtomicU64, val: u64) -> u64
  __sync_fetch_and_sub_8(&mut self.value, val)
end

def AtomicU64::swap(inout self: AtomicU64, val: u64) -> u64
  __sync_lock_test_and_set_8(&mut self.value, val)
end

def AtomicU64::compare_and_swap(inout self: AtomicU64, expected: u64, new_val: u64) -> u64
  __sync_val_compare_and_swap_8(&mut self.value, expected, new_val)
end

## Atomic pointer (size_t)
struct AtomicPtr[T]
  value: PtrMut[T]
end

def AtomicPtr::new[T](ptr: PtrMut[T]) -> AtomicPtr[T]
  AtomicPtr { value: ptr }
end

def AtomicPtr::load[T](self: AtomicPtr[T]) -> Ptr[T]
  __sync_synchronize()
  self.value as Ptr[T]
end

def AtomicPtr::store[T](inout self: AtomicPtr[T], ptr: PtrMut[T]) -> Unit
  self.value = ptr
  __sync_synchronize()
end

def AtomicPtr::swap[T](inout self: AtomicPtr[T], ptr: PtrMut[T]) -> Ptr[T]
  let old = self.value
  self.value = ptr
  __sync_synchronize()
  old as Ptr[T]
end

# ═══════════════════════════════════════════════════════════════
# Mutex
# ═══════════════════════════════════════════════════════════════

## A mutual exclusion lock for protecting shared data
struct Mutex[T]
  inner: PthreadMutex
  data: T
  locked: AtomicBool
end

## Guard returned by Mutex::lock() that releases the lock on drop
struct MutexGuard[T]
  mutex: PtrMut[Mutex[T]]
end

def Mutex::new[T](value: T) -> Result[Mutex[T], String]
  mut mutex = Mutex {
    inner: PthreadMutex { data: [0u8; 40] },
    data: value,
    locked: AtomicBool::new(false)
  }
  
  let ret = pthread_mutex_init(&mut mutex.inner, Ptr::null())
  if ret != 0 then
    return Result::Err("Failed to initialize mutex".to_string())
  end
  
  Result::Ok(mutex)
end

def Mutex::lock[T](inout self: Mutex[T]) -> Option[MutexGuard[T]]
  let ret = pthread_mutex_lock(&mut self.inner)
  if ret != 0 then
    return Option::None
  end
  
  self.locked.store(true)
  
  Option::Some(MutexGuard { mutex: self as PtrMut[Mutex[T]] })
end

def Mutex::try_lock[T](inout self: Mutex[T]) -> Option[MutexGuard[T]]
  let ret = pthread_mutex_trylock(&mut self.inner)
  if ret != 0 then
    return Option::None
  end
  
  self.locked.store(true)
  
  Option::Some(MutexGuard { mutex: self as PtrMut[Mutex[T]] })
end

def Mutex::unlock[T](inout self: Mutex[T]) -> Unit
  self.locked.store(false)
  pthread_mutex_unlock(&mut self.inner)
end

def Mutex::is_locked[T](self: Mutex[T]) -> Bool
  self.locked.load()
end

def Mutex::get_mut[T](inout self: Mutex[T]) -> PtrMut[T]
  # Only safe if we have exclusive access (no other references)
  address_of_mut(&mut self.data)
end

def Mutex::into_inner[T](self: Mutex[T]) -> T
  pthread_mutex_destroy(&mut self.inner)
  self.data
end

# MutexGuard operations
impl[T] MutexGuard[T]
  def deref(self: MutexGuard[T]) -> Ptr[T]
    address_of(&mut self.mutex.as_ref().data) as Ptr[T]
  end
  
  def deref_mut(inout self: MutexGuard[T]) -> PtrMut[T]
    unsafe { address_of_mut(&mut (*self.mutex).data) }
  end
end

impl[T] Drop for MutexGuard[T]
  def drop(inout self: MutexGuard[T]) -> Unit
    self.mutex.locked.store(false)
    pthread_mutex_unlock(&mut self.mutex.inner)
  end
end

impl[T] Drop for Mutex[T]
  def drop(inout self: Mutex[T]) -> Unit
    pthread_mutex_destroy(&mut self.inner)
  end
end

# ═══════════════════════════════════════════════════════════════
# Condvar (Condition Variable)
# ═══════════════════════════════════════════════════════════════

## A condition variable for signaling between threads
struct Condvar
  inner: PthreadCond
end

def Condvar::new() -> Result[Condvar, String]
  mut cond = Condvar {
    inner: PthreadCond { data: [0u8; 48] }
  }
  
  let ret = pthread_cond_init(&mut cond.inner, Ptr::null())
  if ret != 0 then
    return Result::Err("Failed to initialize condition variable".to_string())
  end
  
  Result::Ok(cond)
end

def Condvar::wait[T](self: Condvar, guard: MutexGuard[T]) -> MutexGuard[T]
  # The guard's mutex is unlocked during wait, then re-locked before returning
  pthread_cond_wait(&self.inner, guard.mutex.as_ref().inner)
  guard
end

def Condvar::wait_timeout[T](self: Condvar, guard: MutexGuard[T], timeout: Duration) -> MutexGuard[T]
  # Calculate absolute timeout
  let now = Instant::now()
  let deadline = now + timeout
  
  mut ts = Timespec {
    tv_sec: deadline.secs(),
    tv_nsec: deadline.subsec_nanos() as i64
  }
  
  pthread_cond_timedwait(&self.inner, guard.mutex.as_ref().inner, &ts)
  guard
end

def Condvar::wait_timeout_ms[T](self: Condvar, guard: MutexGuard[T], ms: Int) -> MutexGuard[T]
  self.wait_timeout(guard, Duration::from_millis(ms))
end

def Condvar::notify_one(self: Condvar) -> Unit
  pthread_cond_signal(&self.inner)
end

def Condvar::notify_all(self: Condvar) -> Unit
  pthread_cond_broadcast(&self.inner)
end

impl Drop for Condvar
  def drop(inout self: Condvar) -> Unit
    pthread_cond_destroy(&mut self.inner)
  end
end

# ═══════════════════════════════════════════════════════════════
# RwLock (Reader-Writer Lock)
# ═══════════════════════════════════════════════════════════════

## A reader-writer lock allowing multiple readers or one writer
struct RwLock[T]
  inner: PthreadRwlock
  data: T
end

struct RwLockReadGuard[T]
  lock: Ptr[RwLock[T]]
end

struct RwLockWriteGuard[T]
  lock: PtrMut[RwLock[T]]
end

def RwLock::new[T](value: T) -> Result[RwLock[T], String]
  mut rwlock = RwLock {
    inner: PthreadRwlock { data: [0u8; 56] },
    data: value
  }
  
  let ret = pthread_rwlock_init(&mut rwlock.inner, Ptr::null())
  if ret != 0 then
    return Result::Err("Failed to initialize rwlock".to_string())
  end
  
  Result::Ok(rwlock)
end

def RwLock::read[T](self: RwLock[T]) -> Option[RwLockReadGuard[T]]
  let ret = pthread_rwlock_rdlock(&self.inner)
  if ret != 0 then
    return Option::None
  end
  
  Option::Some(RwLockReadGuard { lock: self as Ptr[RwLock[T]] })
end

def RwLock::try_read[T](self: RwLock[T]) -> Option[RwLockReadGuard[T]]
  let ret = pthread_rwlock_tryrdlock(&self.inner)
  if ret != 0 then
    return Option::None
  end
  
  Option::Some(RwLockReadGuard { lock: self as Ptr[RwLock[T]] })
end

def RwLock::write[T](inout self: RwLock[T]) -> Option[RwLockWriteGuard[T]]
  let ret = pthread_rwlock_wrlock(&mut self.inner)
  if ret != 0 then
    return Option::None
  end
  
  Option::Some(RwLockWriteGuard { lock: self as PtrMut[RwLock[T]] })
end

def RwLock::try_write[T](inout self: RwLock[T]) -> Option[RwLockWriteGuard[T]]
  let ret = pthread_rwlock_trywrlock(&mut self.inner)
  if ret != 0 then
    return Option::None
  end
  
  Option::Some(RwLockWriteGuard { lock: self as PtrMut[RwLock[T]] })
end

impl[T] RwLockReadGuard[T]
  def deref(self: RwLockReadGuard[T]) -> Ptr[T]
    address_of(&mut self.lock.as_ref().data) as Ptr[T]
  end
end

impl[T] Drop for RwLockReadGuard[T]
  def drop(inout self: RwLockReadGuard[T]) -> Unit
    pthread_rwlock_unlock(self.lock.as_ref().inner)
  end
end

impl[T] RwLockWriteGuard[T]
  def deref(self: RwLockWriteGuard[T]) -> Ptr[T]
    address_of(&mut self.lock.as_ref().data) as Ptr[T]
  end
  
  def deref_mut(inout self: RwLockWriteGuard[T]) -> PtrMut[T]
    unsafe { address_of_mut(&mut (*self.lock).data) }
  end
end

impl[T] Drop for RwLockWriteGuard[T]
  def drop(inout self: RwLockWriteGuard[T]) -> Unit
    pthread_rwlock_unlock(self.lock.as_ref().inner)
  end
end

impl[T] Drop for RwLock[T]
  def drop(inout self: RwLock[T]) -> Unit
    pthread_rwlock_destroy(&mut self.inner)
  end
end

# ═══════════════════════════════════════════════════════════════
# Barrier
# ═══════════════════════════════════════════════════════════════

## A synchronization point where multiple threads must all arrive before proceeding
struct Barrier
  inner: PthreadBarrier
  count: Int
end

struct BarrierWaitResult
  is_leader: Bool
end

def Barrier::new(count: Int) -> Result[Barrier, String]
  mut barrier = Barrier {
    inner: PthreadBarrier { data: [0u8; 32] },
    count: count
  }
  
  let ret = pthread_barrier_init(&mut barrier.inner, Ptr::null(), count as UInt)
  if ret != 0 then
    return Result::Err("Failed to initialize barrier".to_string())
  end
  
  Result::Ok(barrier)
end

def Barrier::wait(self: Barrier) -> BarrierWaitResult
  let ret = pthread_barrier_wait(&self.inner)
  # PTHREAD_BARRIER_SERIAL_THREAD is a special return value for the "leader" thread
  BarrierWaitResult { is_leader: ret == -1 }  # -1 is PTHREAD_BARRIER_SERIAL_THREAD on some systems
end

impl Drop for Barrier
  def drop(inout self: Barrier) -> Unit
    pthread_barrier_destroy(&mut self.inner)
  end
end

# ═══════════════════════════════════════════════════════════════
# Arc (Atomically Reference Counted)
# ═══════════════════════════════════════════════════════════════

## A thread-safe reference-counting pointer
struct Arc[T]
  ptr: Ptr[ArcInner[T]]
end

struct ArcInner[T]
  ref_count: AtomicU32
  data: T
end

def Arc::new[T](value: T) -> Arc[T]
  # Allocate on heap
  let ptr = alloc[ArcInner[T]]()
  if ptr.is_null() then
    panic("Arc::new: out of memory")
  end
  
  # Initialize ref count to 1
  ptr.write(ArcInner[T] {
    ref_count: AtomicU32::new(1),
    data: value
  })
  
  Arc { ptr: ptr }
end

def Arc::null[T]() -> Arc[T]
  Arc { ptr: Ptr::null() }
end

def Arc::is_null[T](self: Arc[T]) -> Bool
  self.ptr.is_null()
end

def Arc::clone[T](self: Arc[T]) -> Arc[T]
  if !self.ptr.is_null() then
    self.ptr.as_ref().ref_count.fetch_add(1)
  end
  Arc { ptr: self.ptr }
end

def Arc::deref[T](self: Arc[T]) -> Ptr[T]
  address_of(&mut self.ptr.as_ref().data) as Ptr[T]
end

def Arc::deref_mut[T](inout self: Arc[T]) -> PtrMut[T]
  unsafe { address_of_mut(&mut (*self.ptr).data) }
end

def Arc::strong_count[T](self: Arc[T]) -> u32
  if self.ptr.is_null() then
    return 0
  end
  self.ptr.as_ref().ref_count.load()
end

def Arc::get_mut[T](inout self: Arc[T]) -> Option[PtrMut[T]]
  if self.ptr.as_ref().ref_count.load() == 1 then
    Option::Some(unsafe { address_of_mut(&mut (*self.ptr).data) })
  else
    Option::None
  end
end

def Arc::try_unwrap[T](self: Arc[T]) -> Result[T, Arc[T]]
  if self.ptr.as_ref().ref_count.load() == 1 then
    let data = unsafe { (*self.ptr).data }
    dealloc[ArcInner[T]](self.ptr)
    Result::Ok(data)
  else
    Result::Err(self)
  end
end

impl[T] Drop for Arc[T]
  def drop(inout self: Arc[T]) -> Unit
    if self.ptr.is_null() then
      return
    end
    
    let old_count = self.ptr.as_ref().ref_count.fetch_sub(1)
    
    if old_count == 1 then
      # Last reference, deallocate
      dealloc[ArcInner[T]](self.ptr)
      self.ptr = Ptr::null()
    end
  end
end

## A sender end of a channel
struct Sender[T]
  inner: Arc[ChannelInner[T]]
end

## A receiver end of a channel
struct Receiver[T]
  inner: Arc[ChannelInner[T]]
end

struct ChannelInner[T]
  queue: Mutex[Queue[T]]
  condvar: Condvar
  closed: AtomicBool
end

## Create a new channel
def channel[T]() -> (Sender[T], Receiver[T])
  let inner = Arc::new(ChannelInner {
    queue: Mutex::new(Queue::new()).unwrap(),
    condvar: Condvar::new().unwrap(),
    closed: AtomicBool::new(false)
  })
  
  (
    Sender { inner: inner.clone() },
    Receiver { inner: inner }
  )
end

impl[T] Sender[T]
  def send(self: Sender[T], value: T) -> Result[Unit, String]
    if self.inner.closed.load() then
      return Result::Err("Channel is closed".to_string())
    end
    
    match self.inner.queue.lock()
    when Option::Some(mut guard) then
      guard.enqueue(value)
      self.inner.condvar.notify_one()
      Result::Ok(())
    when Option::None then
      Result::Err("Failed to lock channel queue".to_string())
    end
  end
  
  def close(self: Sender[T]) -> Unit
    self.inner.closed.store(true)
    self.inner.condvar.notify_all()
  end
  
  def is_closed(self: Sender[T]) -> Bool
    self.inner.closed.load()
  end
end

impl[T] Clone for Sender[T]
  def clone(self: Sender[T]) -> Sender[T]
    Sender { inner: self.inner.clone() }
  end
end

impl[T] Receiver[T]
  def recv(self: Receiver[T]) -> Option[T]
    match self.inner.queue.lock()
    when Option::Some(mut guard) then
      loop do
        match guard.dequeue()
        when Option::Some(v) then return Option::Some(v)
        when Option::None then
          if self.inner.closed.load() then
            return Option::None
          end
          guard = self.inner.condvar.wait(guard)
        end
      end
    when Option::None then Option::None
    end
  end
  
  def try_recv(self: Receiver[T]) -> Option[T]
    match self.inner.queue.lock()
    when Option::Some(mut guard) then
      guard.dequeue()
    when Option::None then Option::None
    end
  end
  
  def recv_timeout(self: Receiver[T], timeout: Duration) -> Option[T]
    match self.inner.queue.lock()
    when Option::Some(mut guard) then
      let start = Instant::now()
      loop do
        match guard.dequeue()
        when Option::Some(v) then return Option::Some(v)
        when Option::None then
          if self.inner.closed.load() then
            return Option::None
          end
          
          let elapsed = start.elapsed()
          if elapsed >= timeout then
            return Option::None
          end
          
          guard = self.inner.condvar.wait_timeout(guard, timeout - elapsed)
        end
      end
    when Option::None then Option::None
    end
  end
  
  def is_empty(self: Receiver[T]) -> Bool
    match self.inner.queue.lock()
    when Option::Some(guard) then guard.is_empty()
    when Option::None then true
    end
  end
end

impl[T] Clone for Receiver[T]
  def clone(self: Receiver[T]) -> Receiver[T]
    Receiver { inner: self.inner.clone() }
  end
end

# ═══════════════════════════════════════════════════════════════
# Once (One-time Initialization)
# ═══════════════════════════════════════════════════════════════

## A synchronization primitive for one-time initialization
struct Once
  state: AtomicU32
end

def ONCE_NOT_DONE() -> u32 = 0
def ONCE_IN_PROGRESS() -> u32 = 1
def ONCE_DONE() -> u32 = 2

def Once::new() -> Once
  Once { state: AtomicU32::new(ONCE_NOT_DONE()) }
end

def Once::call_once(self: Once, f: fn() -> Unit) -> Unit
  # Try to transition from NOT_DONE to IN_PROGRESS
  let old = self.state.compare_and_swap(ONCE_NOT_DONE(), ONCE_IN_PROGRESS())
  
  if old == ONCE_DONE() then
    # Already done, nothing to do
    return
  end
  
  if old == ONCE_IN_PROGRESS() then
    # Another thread is doing it, spin wait
    while self.state.load() != ONCE_DONE() do
      std::thread::yield_now()
    end
    return
  end
  
  # We got the lock, execute the function
  f()
  
  # Mark as done
  self.state.store(ONCE_DONE())
end

def Once::is_completed(self: Once) -> Bool
  self.state.load() == ONCE_DONE()
end

# ═══════════════════════════════════════════════════════════════
# Lazy (Lazy Initialization)
# ═══════════════════════════════════════════════════════════════

## Lazily initialized value
struct Lazy[T]
  once: Once
  value: Mutex[Option[T]]
  init: fn() -> T
end

def Lazy::new[T](init: fn() -> T) -> Lazy[T]
  Lazy {
    once: Once::new(),
    value: Mutex::new(Option::None).unwrap(),
    init: init
  }
end

def Lazy::get[T](self: Lazy[T]) -> Ptr[T]
  self.once.call_once(|| {
    match self.value.lock()
    when Option::Some(mut guard) then
      *(guard.deref_mut()) = Option::Some((self.init)())
    when Option::None then ()
    end
  })
  
  match self.value.lock()
  when Option::Some(guard) then
    # Safe because we know the value is Some after initialization
    guard.deref() as Ptr[T]
  when Option::None then
    panic("Lazy value lock failed")
  end
end

# ═══════════════════════════════════════════════════════════════
# SpinLock (Simple spin lock for short critical sections)
# ═══════════════════════════════════════════════════════════════

## A simple spin lock - use only for very short critical sections
struct SpinLock
  locked: AtomicBool
end

def SpinLock::new() -> SpinLock
  SpinLock { locked: AtomicBool::new(false) }
end

def SpinLock::lock(self: SpinLock) -> Unit
  while self.locked.swap(true) do
    # Spin until we acquire the lock
    while self.locked.load() do
      std::thread::yield_now()
    end
  end
end

def SpinLock::try_lock(self: SpinLock) -> Bool
  !self.locked.swap(true)
end

def SpinLock::unlock(self: SpinLock) -> Unit
  self.locked.store(false)
end

def SpinLock::is_locked(self: SpinLock) -> Bool
  self.locked.load()
end

# ═══════════════════════════════════════════════════════════════
# Scope Guard (RAII for cleanup)
# ═══════════════════════════════════════════════════════════════

## A guard that runs a cleanup function when dropped
struct ScopeGuard[F: fn() -> Unit]
  cleanup: Option[F]
  dismissed: Bool
end

def ScopeGuard::new[F: fn() -> Unit](cleanup: F) -> ScopeGuard[F]
  ScopeGuard { cleanup: Option::Some(cleanup), dismissed: false }
end

def ScopeGuard::dismiss(inout self: ScopeGuard[F]) -> Unit
  self.dismissed = true
end

impl[F: fn() -> Unit] Drop for ScopeGuard[F]
  def drop(inout self: ScopeGuard[F]) -> Unit
    if !self.dismissed then
      match self.cleanup
      when Option::Some(f) then f()
      when Option::None then ()
      end
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# Convenience Macros
# ═══════════════════════════════════════════════════════════════

# Note: These would be macros in a real implementation

def defer(cleanup: fn() -> Unit) -> ScopeGuard[fn() -> Unit]
  ScopeGuard::new(cleanup)
end
# ═══════════════════════════════════════════════════════════════
# Transferable / Shareable marker impls (access + resource model)
# ═══════════════════════════════════════════════════════════════

impl[T] Transferable for Mutex[T] {}
impl[T] Shareable for Mutex[T] {}

impl[T] Transferable for Sender[T] {}
impl[T] Shareable for Sender[T] {}

impl[T] Transferable for Receiver[T] {}
impl[T] Shareable for Receiver[T] {}

impl[T] Transferable for Arc[T] {}
impl[T] Shareable for Arc[T] {}

impl Transferable for AtomicBool {}
impl Shareable for AtomicBool {}

impl Transferable for AtomicU32 {}
impl Shareable for AtomicU32 {}

impl Transferable for AtomicU64 {}
impl Shareable for AtomicU64 {}

impl[T] Transferable for AtomicPtr[T] {}
impl[T] Shareable for AtomicPtr[T] {}

impl Transferable for Once {}
impl Shareable for Once {}
