# Tangerine Standard Library — Cryptography & Encoding
#
# Cryptographic primitives and binary encoding utilities.
#
# Usage:
#   let hash = crypto::sha256(data)
#   let encrypted = crypto::aes_encrypt(&key, &plaintext)?
#   let encoded = encoding::hex::encode(data)

use std::core::{Option, Result, Vec, String, Bool, Int, min}

# ———————————————————————————————————————————————————————————————
# Hash Functions
# ———————————————————————————————————————————————————————————————

# MD5 (for legacy compatibility only - DO NOT use for security)
struct Md5
  state: [u32; 4]
  buffer: [u8; 64]
  buffer_len: UInt
  total_len: u64
end

def Md5::new() -> Md5
  Md5 {
    state: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476],
    buffer: [0; 64],
    buffer_len: 0,
    total_len: 0
  }
end

impl Md5
  def update(self: &mut Md5, data: &[u8]) -> &mut Md5
    let mut offset = 0
    self.total_len = self.total_len + data.len() as u64
    
    # Fill buffer
    while offset < data.len() do
      let remaining = 64 - self.buffer_len
      let to_copy = min(remaining, data.len() - offset)
      copy_bytes(&data[offset..offset+to_copy], &mut self.buffer[self.buffer_len..])
      self.buffer_len = self.buffer_len + to_copy
      offset = offset + to_copy
      
      if self.buffer_len == 64 then
        self.process_block()
        self.buffer_len = 0
      end
    end
    self
  end
  
  def finalize(self: &mut Md5) -> [u8; 16]
    # Padding
    let bit_len = self.total_len * 8
    self.buffer[self.buffer_len] = 0x80
    self.buffer_len = self.buffer_len + 1
    
    if self.buffer_len > 56 then
      # Fill with zeros and process
      for i in self.buffer_len..64 do
        self.buffer[i] = 0
      end
      self.process_block()
      self.buffer_len = 0
    end
    
    for i in self.buffer_len..56 do
      self.buffer[i] = 0
    end
    
    # Append length (little-endian)
    for i in 0..8 do
      self.buffer[56 + i] = ((bit_len >> (i * 8)) & 0xff) as u8
    end
    self.process_block()
    
    # Output
    let mut result = [0u8; 16]
    for i in 0..4 do
      result[i*4] = (self.state[i] & 0xff) as u8
      result[i*4+1] = ((self.state[i] >> 8) & 0xff) as u8
      result[i*4+2] = ((self.state[i] >> 16) & 0xff) as u8
      result[i*4+3] = ((self.state[i] >> 24) & 0xff) as u8
    end
    result
  end
  
  def process_block(self: &mut Md5) -> Unit
    let mut m = [0u32; 16]
    for i in 0..16 do
      m[i] = (self.buffer[i*4] as u32) |
             ((self.buffer[i*4+1] as u32) << 8) |
             ((self.buffer[i*4+2] as u32) << 16) |
             ((self.buffer[i*4+3] as u32) << 24)
    end
    
    let mut a = self.state[0]
    let mut b = self.state[1]
    let mut c = self.state[2]
    let mut d = self.state[3]
    
    # MD5 rounds
    for i in 0..64 do
      let (f, g) = if i < 16 then
        ((b & c) | ((!b) & d), i)
      elsif i < 32 then
        ((d & b) | ((!d) & c), (5*i + 1) % 16)
      elsif i < 48 then
        (b ^ c ^ d, (3*i + 5) % 16)
      else
        (c ^ (b | (!d)), (7*i) % 16)
      end end end end
      
      let temp = d
      d = c
      c = b
      b = b + left_rotate(a + f + MD5_K[i] + m[g], MD5_S[i])
      a = temp
    end
    
    self.state[0] = self.state[0] + a
    self.state[1] = self.state[1] + b
    self.state[2] = self.state[2] + c
    self.state[3] = self.state[3] + d
  end
end

const MD5_K: [u32; 64] = [
  0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
  0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
  0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
  0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
  0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
  0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
  0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
  0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
  0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
  0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
  0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
  0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
  0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
  0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
  0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
  0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
]

const MD5_S: [u32; 64] = [
  7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
  5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
  4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
  6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

def md5(data: &[u8]) -> [u8; 16]
  let mut hasher = Md5::new()
  hasher.update(data).finalize()
end

# ———————————————————————————————————————————————————————————————
# SHA-1 (for legacy compatibility - DO NOT use for security)
# ———————————————————————————————————————————————————————————————

struct Sha1
  state: [u32; 5]
  buffer: [u8; 64]
  buffer_len: UInt
  total_len: u64
end

def Sha1::new() -> Sha1
  Sha1 {
    state: [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0],
    buffer: [0; 64],
    buffer_len: 0,
    total_len: 0
  }
end

impl Sha1
  def update(self: &mut Sha1, data: &[u8]) -> &mut Sha1
    let mut offset = 0
    self.total_len = self.total_len + data.len() as u64
    
    while offset < data.len() do
      let remaining = 64 - self.buffer_len
      let to_copy = min(remaining, data.len() - offset)
      copy_bytes(&data[offset..offset+to_copy], &mut self.buffer[self.buffer_len..])
      self.buffer_len = self.buffer_len + to_copy
      offset = offset + to_copy
      
      if self.buffer_len == 64 then
        self.process_block()
        self.buffer_len = 0
      end
    end
    self
  end
  
  def finalize(self: &mut Sha1) -> [u8; 20]
    let bit_len = self.total_len * 8
    self.buffer[self.buffer_len] = 0x80
    self.buffer_len = self.buffer_len + 1
    
    if self.buffer_len > 56 then
      for i in self.buffer_len..64 do
        self.buffer[i] = 0
      end
      self.process_block()
      self.buffer_len = 0
    end
    
    for i in self.buffer_len..56 do
      self.buffer[i] = 0
    end
    
    # Append length (big-endian)
    for i in 0..8 do
      self.buffer[56 + i] = ((bit_len >> ((7-i) * 8)) & 0xff) as u8
    end
    self.process_block()
    
    let mut result = [0u8; 20]
    for i in 0..5 do
      result[i*4] = ((self.state[i] >> 24) & 0xff) as u8
      result[i*4+1] = ((self.state[i] >> 16) & 0xff) as u8
      result[i*4+2] = ((self.state[i] >> 8) & 0xff) as u8
      result[i*4+3] = (self.state[i] & 0xff) as u8
    end
    result
  end
  
  def process_block(self: &mut Sha1) -> Unit
    let mut w = [0u32; 80]
    
    for i in 0..16 do
      w[i] = ((self.buffer[i*4] as u32) << 24) |
             ((self.buffer[i*4+1] as u32) << 16) |
             ((self.buffer[i*4+2] as u32) << 8) |
             (self.buffer[i*4+3] as u32)
    end
    
    for i in 16..80 do
      w[i] = left_rotate(w[i-3] ^ w[i-8] ^ w[i-14] ^ w[i-16], 1)
    end
    
    let mut a = self.state[0]
    let mut b = self.state[1]
    let mut c = self.state[2]
    let mut d = self.state[3]
    let mut e = self.state[4]
    
    for i in 0..80 do
      let (f, k) = if i < 20 then
        ((b & c) | ((!b) & d), 0x5A827999u32)
      elsif i < 40 then
        (b ^ c ^ d, 0x6ED9EBA1u32)
      elsif i < 60 then
        ((b & c) | (b & d) | (c & d), 0x8F1BBCDCu32)
      else
        (b ^ c ^ d, 0xCA62C1D6u32)
      end end end end
      
      let temp = left_rotate(a, 5) + f + e + k + w[i]
      e = d
      d = c
      c = left_rotate(b, 30)
      b = a
      a = temp
    end
    
    self.state[0] = self.state[0] + a
    self.state[1] = self.state[1] + b
    self.state[2] = self.state[2] + c
    self.state[3] = self.state[3] + d
    self.state[4] = self.state[4] + e
  end
end

def sha1(data: &[u8]) -> [u8; 20]
  let mut hasher = Sha1::new()
  hasher.update(data).finalize()
end

# ———————————————————————————————————————————————————————————————
# SHA-256
# ———————————————————————————————————————————————————————————————

struct Sha256
  state: [u32; 8]
  buffer: [u8; 64]
  buffer_len: UInt
  total_len: u64
end

def Sha256::new() -> Sha256
  Sha256 {
    state: [
      0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
      0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ],
    buffer: [0; 64],
    buffer_len: 0,
    total_len: 0
  }
end

impl Sha256
  def update(self: &mut Sha256, data: &[u8]) -> &mut Sha256
    let mut offset = 0
    self.total_len = self.total_len + data.len() as u64
    
    while offset < data.len() do
      let remaining = 64 - self.buffer_len
      let to_copy = min(remaining, data.len() - offset)
      copy_bytes(&data[offset..offset+to_copy], &mut self.buffer[self.buffer_len..])
      self.buffer_len = self.buffer_len + to_copy
      offset = offset + to_copy
      
      if self.buffer_len == 64 then
        self.process_block()
        self.buffer_len = 0
      end
    end
    self
  end
  
  def finalize(self: &mut Sha256) -> [u8; 32]
    let bit_len = self.total_len * 8
    self.buffer[self.buffer_len] = 0x80
    self.buffer_len = self.buffer_len + 1
    
    if self.buffer_len > 56 then
      for i in self.buffer_len..64 do
        self.buffer[i] = 0
      end
      self.process_block()
      self.buffer_len = 0
    end
    
    for i in self.buffer_len..56 do
      self.buffer[i] = 0
    end
    
    for i in 0..8 do
      self.buffer[56 + i] = ((bit_len >> ((7-i) * 8)) & 0xff) as u8
    end
    self.process_block()
    
    let mut result = [0u8; 32]
    for i in 0..8 do
      result[i*4] = ((self.state[i] >> 24) & 0xff) as u8
      result[i*4+1] = ((self.state[i] >> 16) & 0xff) as u8
      result[i*4+2] = ((self.state[i] >> 8) & 0xff) as u8
      result[i*4+3] = (self.state[i] & 0xff) as u8
    end
    result
  end
  
  def process_block(self: &mut Sha256) -> Unit
    let mut w = [0u32; 64]
    
    for i in 0..16 do
      w[i] = ((self.buffer[i*4] as u32) << 24) |
             ((self.buffer[i*4+1] as u32) << 16) |
             ((self.buffer[i*4+2] as u32) << 8) |
             (self.buffer[i*4+3] as u32)
    end
    
    for i in 16..64 do
      let s0 = right_rotate(w[i-15], 7) ^ right_rotate(w[i-15], 18) ^ (w[i-15] >> 3)
      let s1 = right_rotate(w[i-2], 17) ^ right_rotate(w[i-2], 19) ^ (w[i-2] >> 10)
      w[i] = w[i-16] + s0 + w[i-7] + s1
    end
    
    let mut a = self.state[0]
    let mut b = self.state[1]
    let mut c = self.state[2]
    let mut d = self.state[3]
    let mut e = self.state[4]
    let mut f = self.state[5]
    let mut g = self.state[6]
    let mut h = self.state[7]
    
    for i in 0..64 do
      let s1 = right_rotate(e, 6) ^ right_rotate(e, 11) ^ right_rotate(e, 25)
      let ch = (e & f) ^ ((!e) & g)
      let temp1 = h + s1 + ch + SHA256_K[i] + w[i]
      let s0 = right_rotate(a, 2) ^ right_rotate(a, 13) ^ right_rotate(a, 22)
      let maj = (a & b) ^ (a & c) ^ (b & c)
      let temp2 = s0 + maj
      
      h = g
      g = f
      f = e
      e = d + temp1
      d = c
      c = b
      b = a
      a = temp1 + temp2
    end
    
    self.state[0] = self.state[0] + a
    self.state[1] = self.state[1] + b
    self.state[2] = self.state[2] + c
    self.state[3] = self.state[3] + d
    self.state[4] = self.state[4] + e
    self.state[5] = self.state[5] + f
    self.state[6] = self.state[6] + g
    self.state[7] = self.state[7] + h
  end
end

const SHA256_K: [u32; 64] = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

def sha256(data: &[u8]) -> [u8; 32]
  let mut hasher = Sha256::new()
  hasher.update(data).finalize()
end

# ———————————————————————————————————————————————————————————————
# SHA-512
# ———————————————————————————————————————————————————————————————

struct Sha512
  state: [u64; 8]
  buffer: [u8; 128]
  buffer_len: UInt
  total_len: u128
end

def Sha512::new() -> Sha512
  Sha512 {
    state: [
      0x6a09e667f3bcc908, 0xbb67ae8584caa73b,
      0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
      0x510e527fade682d1, 0x9b05688c2b3e6c1f,
      0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
    ],
    buffer: [0; 128],
    buffer_len: 0,
    total_len: 0
  }
end

impl Sha512
  def update(self: &mut Sha512, data: &[u8]) -> &mut Sha512
    let mut offset = 0
    self.total_len = self.total_len + data.len() as u128
    
    while offset < data.len() do
      let remaining = 128 - self.buffer_len
      let to_copy = min(remaining, data.len() - offset)
      copy_bytes(&data[offset..offset+to_copy], &mut self.buffer[self.buffer_len..])
      self.buffer_len = self.buffer_len + to_copy
      offset = offset + to_copy
      
      if self.buffer_len == 128 then
        self.process_block()
        self.buffer_len = 0
      end
    end
    self
  end
  
  def finalize(self: &mut Sha512) -> [u8; 64]
    let bit_len = self.total_len * 8
    self.buffer[self.buffer_len] = 0x80
    self.buffer_len = self.buffer_len + 1
    
    if self.buffer_len > 112 then
      for i in self.buffer_len..128 do
        self.buffer[i] = 0
      end
      self.process_block()
      self.buffer_len = 0
    end
    
    for i in self.buffer_len..112 do
      self.buffer[i] = 0
    end
    
    for i in 0..16 do
      self.buffer[112 + i] = ((bit_len >> ((15-i) * 8)) & 0xff) as u8
    end
    self.process_block()
    
    let mut result = [0u8; 64]
    for i in 0..8 do
      for j in 0..8 do
        result[i*8+j] = ((self.state[i] >> ((7-j) * 8)) & 0xff) as u8
      end
    end
    result
  end
  
  def process_block(self: &mut Sha512) -> Unit
    let mut w = [0u64; 80]
    
    for i in 0..16 do
      w[i] = 0
      for j in 0..8 do
        w[i] = w[i] | ((self.buffer[i*8+j] as u64) << ((7-j) * 8))
      end
    end
    
    for i in 16..80 do
      let s0 = right_rotate64(w[i-15], 1) ^ right_rotate64(w[i-15], 8) ^ (w[i-15] >> 7)
      let s1 = right_rotate64(w[i-2], 19) ^ right_rotate64(w[i-2], 61) ^ (w[i-2] >> 6)
      w[i] = w[i-16] + s0 + w[i-7] + s1
    end
    
    let mut a = self.state[0]
    let mut b = self.state[1]
    let mut c = self.state[2]
    let mut d = self.state[3]
    let mut e = self.state[4]
    let mut f = self.state[5]
    let mut g = self.state[6]
    let mut h = self.state[7]
    
    for i in 0..80 do
      let s1 = right_rotate64(e, 14) ^ right_rotate64(e, 18) ^ right_rotate64(e, 41)
      let ch = (e & f) ^ ((!e) & g)
      let temp1 = h + s1 + ch + SHA512_K[i] + w[i]
      let s0 = right_rotate64(a, 28) ^ right_rotate64(a, 34) ^ right_rotate64(a, 39)
      let maj = (a & b) ^ (a & c) ^ (b & c)
      let temp2 = s0 + maj
      
      h = g
      g = f
      f = e
      e = d + temp1
      d = c
      c = b
      b = a
      a = temp1 + temp2
    end
    
    self.state[0] = self.state[0] + a
    self.state[1] = self.state[1] + b
    self.state[2] = self.state[2] + c
    self.state[3] = self.state[3] + d
    self.state[4] = self.state[4] + e
    self.state[5] = self.state[5] + f
    self.state[6] = self.state[6] + g
    self.state[7] = self.state[7] + h
  end
end

const SHA512_K: [u64; 80] = [
  0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
  0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
  0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
  0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
  0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
  0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
  0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
  0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
  0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
  0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
  0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
  0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
  0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
  0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
  0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
  0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
  0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
  0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
  0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
  0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
]

def sha512(data: &[u8]) -> [u8; 64]
  let mut hasher = Sha512::new()
  hasher.update(data).finalize()
end

# ———————————————————————————————————————————————————————————————
# HMAC
# ———————————————————————————————————————————————————————————————

struct HmacSha256
  inner: Sha256
  outer_key: [u8; 64]
end

def HmacSha256::new(key: &[u8]) -> HmacSha256
  let mut key_block = [0u8; 64]
  
  if key.len() > 64 then
    let hash = sha256(key)
    copy_bytes(&hash, &mut key_block)
  else
    copy_bytes(key, &mut key_block)
  end
  
  let mut inner_key = [0u8; 64]
  let mut outer_key = [0u8; 64]
  
  for i in 0..64 do
    inner_key[i] = key_block[i] ^ 0x36
    outer_key[i] = key_block[i] ^ 0x5c
  end
  
  let mut inner = Sha256::new()
  inner.update(&inner_key)
  
  HmacSha256 {
    inner: inner,
    outer_key: outer_key
  }
end

impl HmacSha256
  def update(self: &mut HmacSha256, data: &[u8]) -> &mut HmacSha256
    self.inner.update(data)
    self
  end
  
  def finalize(self: &mut HmacSha256) -> [u8; 32]
    let inner_hash = self.inner.finalize()
    let mut outer = Sha256::new()
    outer.update(&self.outer_key)
    outer.update(&inner_hash)
    outer.finalize()
  end
end

def hmac_sha256(key: &[u8], data: &[u8]) -> [u8; 32]
  let mut hmac = HmacSha256::new(key)
  hmac.update(data).finalize()
end

# ———————————————————————————————————————————————————————————————
# PBKDF2
# ———————————————————————————————————————————————————————————————

const PBKDF2_MIN_ITERATIONS: UInt = 210000

def pbkdf2_sha256(password: &[u8], salt: &[u8], iterations: UInt, dk_len: UInt) -> Vec[u8]
  let effective_iterations = if iterations < PBKDF2_MIN_ITERATIONS then
    PBKDF2_MIN_ITERATIONS
  else
    iterations
  end

  let mut result = Vec::new()
  let mut block_num = 1u32
  
  while result.len() < dk_len do
    let mut u = Vec::new()
    u.extend(salt)
    u.push(((block_num >> 24) & 0xff) as u8)
    u.push(((block_num >> 16) & 0xff) as u8)
    u.push(((block_num >> 8) & 0xff) as u8)
    u.push((block_num & 0xff) as u8)
    
    let mut prev = hmac_sha256(password, u.as_slice())
    let mut dk_block = prev.clone()
    
    for _ in 1..effective_iterations do
      prev = hmac_sha256(password, &prev)
      for j in 0..32 do
        dk_block[j] = dk_block[j] ^ prev[j]
      end
    end
    
    result.extend(&dk_block)
    block_num = block_num + 1
  end
  
  result.truncate(dk_len)
  result
end

# ———————————————————————————————————————————————————————————————
# AES
# ———————————————————————————————————————————————————————————————

struct Aes
  key_schedule: Vec[u32]
  key_len: UInt
end

