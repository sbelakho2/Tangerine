# Tangerine Standard Library — Regex & Parser Combinators
#
# Regular expression engine and parser combinator library.
#
# Usage:
#   let re = Regex::new(r"\d+")
#   if re.is_match("42") then ...
#   
#   let parser = digit().many1().map(|ds| ds.join(""))
#   let result = parser.parse("123abc")?

use std::core::{Option, Result, Vec, String, Bool, Int}
use std::collections::{Map, Set}

# ═══════════════════════════════════════════════════════════════
# PART 1: REGULAR EXPRESSIONS
# ═══════════════════════════════════════════════════════════════

# ———————————————————————————————————————————————————————————————
# Regex Types
# ———————————————————————————————————————————————————————————————

struct Regex
  pattern: String
  nfa: Nfa
  flags: RegexFlags
  capture_group_cache: Vec[String]
end

struct RegexFlags
  case_insensitive: Bool
  multiline: Bool
  dot_all: Bool
  unicode: Bool
end

def RegexFlags::default() -> RegexFlags
  RegexFlags {
    case_insensitive: false,
    multiline: false,
    dot_all: false,
    unicode: false
  }
end

enum RegexError
  InvalidEscape(UInt, char)
  UnmatchedParen(UInt)
  InvalidQuantifier(UInt)
  InvalidCharClass(UInt)
  InvalidRepetition(UInt)
  EmptyPattern
  InternalError(String)
end

def regex_error_message(e: &RegexError) -> String
  match e
  when RegexError::InvalidEscape(pos, c) then
    "invalid escape '\\" + c.to_string() + "' at position " + pos.to_string()
  when RegexError::UnmatchedParen(pos) then
    "unmatched parenthesis at position " + pos.to_string()
  when RegexError::InvalidQuantifier(pos) then
    "invalid quantifier at position " + pos.to_string()
  when RegexError::InvalidCharClass(pos) then
    "invalid character class at position " + pos.to_string()
  when RegexError::InvalidRepetition(pos) then
    "invalid repetition at position " + pos.to_string()
  when RegexError::EmptyPattern then "empty pattern"
  when RegexError::InternalError(s) then "internal error: " + s.clone()
  end
end

# ———————————————————————————————————————————————————————————————
# NFA (Thompson's Construction)
# ———————————————————————————————————————————————————————————————

struct Nfa
  states: Vec[NfaState]
  start: UInt
  accept: UInt
end

struct NfaState
  transitions: Vec[(NfaTransition, UInt)]
  is_accept: Bool
end

enum NfaTransition
  Epsilon
  Char(char)
  CharRange(char, char)
  CharClass(CharClass)
  Any
  AnyNotNewline
  StartOfLine
  EndOfLine
  StartOfString
  EndOfString
  WordBoundary
  NotWordBoundary
end

struct CharClass
  ranges: Vec[(char, char)]
  negated: Bool
end

impl CharClass
  def new() -> CharClass
    CharClass { ranges: Vec::new(), negated: false }
  end
  
  def add_char(self: &mut CharClass, c: char) -> Unit
    self.ranges.push((c, c))
  end
  
  def add_range(self: &mut CharClass, start: char, end_char: char) -> Unit
    self.ranges.push((start, end_char))
  end
  
  def negate(self: &mut CharClass) -> Unit
    self.negated = true
  end
  
  def matches(self: &CharClass, c: char) -> Bool
    let mut found = false
    for (start, end_char) in &self.ranges do
      if c >= *start && c <= *end_char then
        found = true
        break
      end
    end
    if self.negated then !found else found end
  end
end

# ———————————————————————————————————————————————————————————————
# Regex Compilation
# ———————————————————————————————————————————————————————————————

def Regex::new(pattern: &str) -> Result[Regex, RegexError]
  Regex::with_flags(pattern, RegexFlags::default())
end

def Regex::with_flags(pattern: &str, flags: RegexFlags) -> Result[Regex, RegexError]
  if pattern.is_empty() then
    return Result::Err(RegexError::EmptyPattern)
  end
  
  let mut compiler = RegexCompiler::new(pattern, &flags)
  let nfa = compiler.compile()?
  let capture_group_cache = parse_capture_group_patterns(pattern)
  
  Result::Ok(Regex {
    pattern: pattern.to_string(),
    nfa: nfa,
    flags: flags,
    capture_group_cache: capture_group_cache
  })
end

def parse_capture_group_patterns(pattern: &str) -> Vec[String]
  let pattern_chars: Vec[char] = pattern.chars().collect()
  let mut stack: Vec[UInt] = Vec::new()
  let mut ordered: Vec[(UInt, String)] = Vec::new()
  let mut escaped = false
  let mut in_char_class = false

  let mut i: UInt = 0
  while i < pattern_chars.len() do
    let ch = pattern_chars[i]
    if escaped then
      escaped = false
    else
      if ch == '\\' then
        escaped = true
      elsif in_char_class then
        if ch == ']' then
          in_char_class = false
        end
      elsif ch == '[' then
        in_char_class = true
      elsif ch == '(' then
        if i + 2 < pattern_chars.len() && pattern_chars[i + 1] == '?' && pattern_chars[i + 2] == ':' then
          ()
        else
          stack.push(i)
        end
      elsif ch == ')' then
        if !stack.is_empty() then
          let open_idx = stack.pop().unwrap()
          if open_idx + 1 <= i then
            let content: String = pattern_chars[open_idx + 1..i].iter().collect()
            let mut insert_at = ordered.len()
            let mut j: UInt = 0
            while j < ordered.len() do
              if open_idx < ordered[j].0 then
                insert_at = j
                break
              end
              j = j + 1
            end
            ordered.insert(insert_at, (open_idx, content))
          end
        end
      end
    end
    i = i + 1
  end

  let mut groups: Vec[String] = Vec::new()
  for (_, content) in ordered do
    groups.push(content)
  end
  groups
end

struct RegexCompiler
  pattern: Vec[char]
  pos: UInt
  flags: RegexFlags
  state_count: UInt
end

def _add_unicode_ranges(cc: &mut CharClass, name: &str) -> Unit
  if name == "Lu" || name == "Uppercase_Letter" then
    cc.add_range('A', 'Z')
    cc.add_range('\u{00C0}', '\u{00D6}')
    cc.add_range('\u{00D8}', '\u{00DE}')
    cc.add_range('\u{0100}', '\u{0100}')
    cc.add_range('\u{0391}', '\u{03A9}')
    cc.add_range('\u{0410}', '\u{042F}')
  elsif name == "Ll" || name == "Lowercase_Letter" then
    cc.add_range('a', 'z')
    cc.add_range('\u{00DF}', '\u{00F6}')
    cc.add_range('\u{00F8}', '\u{00FF}')
    cc.add_range('\u{03B1}', '\u{03C9}')
    cc.add_range('\u{0430}', '\u{044F}')
  elsif name == "L" || name == "Letter" then
    cc.add_range('A', 'Z')
    cc.add_range('a', 'z')
    cc.add_range('\u{00C0}', '\u{00FF}')
    cc.add_range('\u{0100}', '\u{024F}')
    cc.add_range('\u{0370}', '\u{03FF}')
    cc.add_range('\u{0400}', '\u{04FF}')
    cc.add_range('\u{0500}', '\u{052F}')
    cc.add_range('\u{1E00}', '\u{1EFF}')
    cc.add_range('\u{4E00}', '\u{9FFF}')
    cc.add_range('\u{AC00}', '\u{D7AF}')
  elsif name == "N" || name == "Number" then
    cc.add_range('0', '9')
    cc.add_range('\u{0660}', '\u{0669}')
    cc.add_range('\u{06F0}', '\u{06F9}')
    cc.add_range('\u{0966}', '\u{096F}')
    cc.add_range('\u{2070}', '\u{2079}')
    cc.add_range('\u{2080}', '\u{2089}')
  elsif name == "Nd" || name == "Decimal_Number" then
    cc.add_range('0', '9')
    cc.add_range('\u{0660}', '\u{0669}')
    cc.add_range('\u{06F0}', '\u{06F9}')
    cc.add_range('\u{0966}', '\u{096F}')
  elsif name == "P" || name == "Punctuation" then
    cc.add_range('!', '/')
    cc.add_range(':', '@')
    cc.add_range('[', '`')
    cc.add_range('{', '~')
    cc.add_range('\u{2000}', '\u{206F}')
  elsif name == "S" || name == "Symbol" then
    cc.add_range('$', '$')
    cc.add_range('+', '+')
    cc.add_range('\u{00A2}', '\u{00A5}')
    cc.add_range('\u{2200}', '\u{22FF}')
    cc.add_range('\u{2600}', '\u{26FF}')
    cc.add_range('\u{2700}', '\u{27BF}')
    cc.add_range('\u{1F600}', '\u{1F64F}')
  elsif name == "Z" || name == "Separator" then
    cc.add_char(' ')
    cc.add_char('\u{00A0}')
    cc.add_char('\u{2028}')
    cc.add_char('\u{2029}')
    cc.add_range('\u{2000}', '\u{200A}')
  elsif name == "Cc" || name == "Control" then
    cc.add_range('\u{0000}', '\u{001F}')
    cc.add_range('\u{007F}', '\u{009F}')
  elsif name == "Latin" then
    cc.add_range('A', 'Z')
    cc.add_range('a', 'z')
    cc.add_range('\u{00C0}', '\u{024F}')
    cc.add_range('\u{1E00}', '\u{1EFF}')
  elsif name == "Greek" then
    cc.add_range('\u{0370}', '\u{03FF}')
    cc.add_range('\u{1F00}', '\u{1FFF}')
  elsif name == "Cyrillic" then
    cc.add_range('\u{0400}', '\u{04FF}')
    cc.add_range('\u{0500}', '\u{052F}')
  elsif name == "Arabic" then
    cc.add_range('\u{0600}', '\u{06FF}')
    cc.add_range('\u{0750}', '\u{077F}')
  elsif name == "Han" || name == "CJK" then
    cc.add_range('\u{4E00}', '\u{9FFF}')
    cc.add_range('\u{3400}', '\u{4DBF}')
  elsif name == "Hangul" then
    cc.add_range('\u{AC00}', '\u{D7AF}')
    cc.add_range('\u{1100}', '\u{11FF}')
  elsif name == "Hiragana" then
    cc.add_range('\u{3040}', '\u{309F}')
  elsif name == "Katakana" then
    cc.add_range('\u{30A0}', '\u{30FF}')
  elsif name == "Emoji" then
    cc.add_range('\u{1F600}', '\u{1F64F}')
    cc.add_range('\u{1F300}', '\u{1F5FF}')
    cc.add_range('\u{1F680}', '\u{1F6FF}')
    cc.add_range('\u{2600}', '\u{26FF}')
  else
    # Unknown property — match nothing (silently)
    ()
  end
end

impl RegexCompiler
  def new(pattern: &str, flags: &RegexFlags) -> RegexCompiler
    RegexCompiler {
      pattern: pattern.chars().collect(),
      pos: 0,
      flags: flags.clone(),
      state_count: 0
    }
  end
  
  def compile(self: &mut RegexCompiler) -> Result[Nfa, RegexError]
    let (nfa, _) = self.parse_expr()?
    Result::Ok(nfa)
  end
  
  def new_state(self: &mut RegexCompiler) -> UInt
    let id = self.state_count
    self.state_count = self.state_count + 1
    id
  end
  
  def peek(self: &RegexCompiler) -> Option[char]
    if self.pos < self.pattern.len() then
      Option::Some(self.pattern[self.pos])
    else
      Option::None
    end
  end
  
  def advance(self: &mut RegexCompiler) -> Option[char]
    if self.pos < self.pattern.len() then
      let c = self.pattern[self.pos]
      self.pos = self.pos + 1
      Option::Some(c)
    else
      Option::None
    end
  end
  
  def parse_expr(self: &mut RegexCompiler) -> Result[(Nfa, UInt), RegexError]
    let initial = self.parse_concat()?
    var nfa = initial.0
    var end_state = initial.1
    
    while self.peek() == Option::Some('|') do
      self.advance()  # consume '|'
      let (alt_nfa, alt_end) = self.parse_concat()?
      # Create alternation
      let new_start = self.new_state()
      let new_end = self.new_state()
      
      let mut states = Vec::new()
      
      # New start state with epsilon to both branches
      states.push(NfaState {
        transitions: vec![
          (NfaTransition::Epsilon, nfa.start + 1),
          (NfaTransition::Epsilon, alt_nfa.start + 1 + nfa.states.len())
        ],
        is_accept: false
      })
      
      # Add states from first branch
      for state in nfa.states do
        let mut s = state
        for (t, target) in &mut s.transitions do
          *target = *target + 1
        end
        if s.is_accept then
          s.is_accept = false
          s.transitions.push((NfaTransition::Epsilon, new_end + 1))
        end
        states.push(s)
      end
      
      # Add states from second branch
      let offset = nfa.states.len() + 1
      for state in alt_nfa.states do
        let mut s = state
        for (t, target) in &mut s.transitions do
          *target = *target + offset
        end
        if s.is_accept then
          s.is_accept = false
          s.transitions.push((NfaTransition::Epsilon, new_end + offset))
        end
        states.push(s)
      end
      
      # New accept state
      states.push(NfaState {
        transitions: Vec::new(),
        is_accept: true
      })
      
      nfa = Nfa {
        states: states,
        start: 0,
        accept: states.len() - 1
      }
      end_state = nfa.accept
    end
    
    Result::Ok((nfa, end_state))
  end
  
  def parse_concat(self: &mut RegexCompiler) -> Result[(Nfa, UInt), RegexError]
    let mut fragments = Vec::new()
    
    while self.pos < self.pattern.len() do
      match self.peek()
      when Option::Some('|') | Option::Some(')') then break
      when _ then ()
      end
      
      let (frag, _) = self.parse_quantified()?
      fragments.push(frag)
    end
    
    if fragments.is_empty() then
      # Empty concatenation = epsilon
      let mut states = Vec::new()
      states.push(NfaState {
        transitions: Vec::new(),
        is_accept: true
      })
      return Result::Ok((Nfa { states: states, start: 0, accept: 0 }, 0))
    end
    
    # Concatenate all fragments
    let mut result = fragments.remove(0)
    
    for frag in fragments do
      result = concatenate_nfa(result, frag)
    end
    
    Result::Ok((result, result.accept))
  end
  
  def parse_quantified(self: &mut RegexCompiler) -> Result[(Nfa, UInt), RegexError]
    let (base, _) = self.parse_atom()?
    
    match self.peek()
    when Option::Some('*') then
      self.advance()
      let greedy = self.peek() != Option::Some('?')
      if !greedy then self.advance() end
      Result::Ok((apply_star(base, greedy), 0))
    when Option::Some('+') then
      self.advance()
      let greedy = self.peek() != Option::Some('?')
      if !greedy then self.advance() end
      Result::Ok((apply_plus(base, greedy), 0))
    when Option::Some('?') then
      self.advance()
      let greedy = self.peek() != Option::Some('?')
      if !greedy then self.advance() end
      Result::Ok((apply_optional(base, greedy), 0))
    when Option::Some('{') then
      self.advance()
      let (min, max) = self.parse_repetition()?
      if self.advance() != Option::Some('}') then
        return Result::Err(RegexError::InvalidRepetition(self.pos))
      end
      Result::Ok((apply_repetition(base, min, max), 0))
    when _ then Result::Ok((base, 0))
    end
  end
  
  def parse_repetition(self: &mut RegexCompiler) -> Result[(UInt, Option[UInt]), RegexError]
    let mut min_str = String::new()
    while self.peek().map(|c| c.is_digit()).unwrap_or(false) do
      min_str.push(self.advance().unwrap())
    end
    
    let min = min_str.parse_uint().unwrap_or(0)
    
    if self.peek() == Option::Some(',') then
      self.advance()
      if self.peek() == Option::Some('}') then
        return Result::Ok((min, Option::None))  # {n,}
      end
      
      let mut max_str = String::new()
      while self.peek().map(|c| c.is_digit()).unwrap_or(false) do
        max_str.push(self.advance().unwrap())
      end
      let max = max_str.parse_uint().unwrap_or(min)
      Result::Ok((min, Option::Some(max)))  # {n,m}
    else
      Result::Ok((min, Option::Some(min)))  # {n}
    end
  end
  
  def parse_atom(self: &mut RegexCompiler) -> Result[(Nfa, UInt), RegexError]
    match self.peek()
    when Option::Some('(') then
      self.advance()
      let (nfa, end_pos) = self.parse_expr()?
      if self.advance() != Option::Some(')') then
        return Result::Err(RegexError::UnmatchedParen(self.pos))
      end
      Result::Ok((nfa, end_pos))
    when Option::Some('[') then
      self.parse_char_class()
    when Option::Some('.') then
      self.advance()
      let transition = if self.flags.dot_all then
        NfaTransition::Any
      else
        NfaTransition::AnyNotNewline
      end
      Result::Ok((single_transition(transition), 0))
    when Option::Some('^') then
      self.advance()
      let transition = if self.flags.multiline then
        NfaTransition::StartOfLine
      else
        NfaTransition::StartOfString
      end
      Result::Ok((single_transition(transition), 0))
    when Option::Some('$') then
      self.advance()
      let transition = if self.flags.multiline then
        NfaTransition::EndOfLine
      else
        NfaTransition::EndOfString
      end
      Result::Ok((single_transition(transition), 0))
    when Option::Some('\\') then
      self.parse_escape()
    when Option::Some(c) then
      if c == '*' || c == '+' || c == '?' || c == '{' || c == '|' || c == ')' then
        return Result::Err(RegexError::InvalidQuantifier(self.pos))
      end
      self.advance()
      let ch = if self.flags.case_insensitive then c.to_lowercase() else c end
      Result::Ok((single_transition(NfaTransition::Char(ch)), 0))
    when Option::None then
      Result::Err(RegexError::EmptyPattern)
    end
  end
  
  def parse_escape(self: &mut RegexCompiler) -> Result[(Nfa, UInt), RegexError]
    self.advance()  # consume '\'
    
    match self.advance()
    when Option::Some('d') then
      let mut cc = CharClass::new()
      cc.add_range('0', '9')
      Result::Ok((single_transition(NfaTransition::CharClass(cc)), 0))
    when Option::Some('D') then
      let mut cc = CharClass::new()
      cc.add_range('0', '9')
      cc.negate()
      Result::Ok((single_transition(NfaTransition::CharClass(cc)), 0))
    when Option::Some('w') then
      let mut cc = CharClass::new()
      cc.add_range('a', 'z')
      cc.add_range('A', 'Z')
      cc.add_range('0', '9')
      cc.add_char('_')
      Result::Ok((single_transition(NfaTransition::CharClass(cc)), 0))
    when Option::Some('W') then
      let mut cc = CharClass::new()
      cc.add_range('a', 'z')
      cc.add_range('A', 'Z')
      cc.add_range('0', '9')
      cc.add_char('_')
      cc.negate()
      Result::Ok((single_transition(NfaTransition::CharClass(cc)), 0))
    when Option::Some('s') then
      let mut cc = CharClass::new()
      cc.add_char(' ')
      cc.add_char('\t')
      cc.add_char('\n')
      cc.add_char('\r')
      cc.add_char('\x0c')  # form feed
      Result::Ok((single_transition(NfaTransition::CharClass(cc)), 0))
    when Option::Some('S') then
      let mut cc = CharClass::new()
      cc.add_char(' ')
      cc.add_char('\t')
      cc.add_char('\n')
      cc.add_char('\r')
      cc.add_char('\x0c')
      cc.negate()
      Result::Ok((single_transition(NfaTransition::CharClass(cc)), 0))
    when Option::Some('p') then
      self._parse_unicode_property(false)
    when Option::Some('P') then
      self._parse_unicode_property(true)
    when Option::Some('b') then
      Result::Ok((single_transition(NfaTransition::WordBoundary), 0))
    when Option::Some('B') then
      Result::Ok((single_transition(NfaTransition::NotWordBoundary), 0))
    when Option::Some('n') then
      Result::Ok((single_transition(NfaTransition::Char('\n')), 0))
    when Option::Some('r') then
      Result::Ok((single_transition(NfaTransition::Char('\r')), 0))
    when Option::Some('t') then
      Result::Ok((single_transition(NfaTransition::Char('\t')), 0))
    when Option::Some('0') then
      Result::Ok((single_transition(NfaTransition::Char('\0')), 0))
    when Option::Some(c) then
      # Escaped literal
      if c == '\\' || c == '.' || c == '*' || c == '+' || c == '?' ||
         c == '[' || c == ']' || c == '(' || c == ')' || c == '{' ||
         c == '}' || c == '|' || c == '^' || c == '$' then
        Result::Ok((single_transition(NfaTransition::Char(c)), 0))
      else
        Result::Err(RegexError::InvalidEscape(self.pos - 1, c))
      end
    when Option::None then
      Result::Err(RegexError::InvalidEscape(self.pos, '\\'))
    end
  end

  def _parse_unicode_property(self: &mut RegexCompiler, negated: Bool) -> Result[(Nfa, UInt), RegexError]
    if self.peek() != Option::Some('{') then
      return Result::Err(RegexError::InvalidEscape(self.pos, 'p'))
    end
    self.advance()
    var name = String::new()
    while self.peek() != Option::Some('}') do
      match self.advance()
      when Option::Some(c) then
        name = name + c.to_string()
      when Option::None then
        return Result::Err(RegexError::InvalidCharClass(self.pos))
      end
    end
    self.advance()
    let mut cc = CharClass::new()
    _add_unicode_ranges(&mut cc, &name)
    if negated then
      cc.negate()
    end
    Result::Ok((single_transition(NfaTransition::CharClass(cc)), 0))
  end
  
  def parse_char_class(self: &mut RegexCompiler) -> Result[(Nfa, UInt), RegexError]
    self.advance()  # consume '['
    
    let mut cc = CharClass::new()
    
    if self.peek() == Option::Some('^') then
      self.advance()
      cc.negate()
    end
    
    while self.peek() != Option::Some(']') && self.pos < self.pattern.len() do
      let c1 = match self.advance()
      when Option::Some('\\') then self.parse_char_class_escape()?
      when Option::Some(c) then c
      when Option::None then return Result::Err(RegexError::InvalidCharClass(self.pos))
      end
      
      if self.peek() == Option::Some('-') && self.pos + 1 < self.pattern.len() &&
         self.pattern[self.pos + 1] != ']' then
        self.advance()  # consume '-'
        let c2 = match self.advance()
        when Option::Some('\\') then self.parse_char_class_escape()?
        when Option::Some(c) then c
        when Option::None then return Result::Err(RegexError::InvalidCharClass(self.pos))
        end
        cc.add_range(c1, c2)
      else
        cc.add_char(c1)
      end
    end
    
    if self.advance() != Option::Some(']') then
      return Result::Err(RegexError::InvalidCharClass(self.pos))
    end
    
    Result::Ok((single_transition(NfaTransition::CharClass(cc)), 0))
  end
  
  def parse_char_class_escape(self: &mut RegexCompiler) -> Result[char, RegexError]
    match self.advance()
    when Option::Some('n') then Result::Ok('\n')
    when Option::Some('r') then Result::Ok('\r')
    when Option::Some('t') then Result::Ok('\t')
    when Option::Some('\\') then Result::Ok('\\')
    when Option::Some(']') then Result::Ok(']')
    when Option::Some('-') then Result::Ok('-')
    when Option::Some('^') then Result::Ok('^')
    when Option::Some(c) then Result::Ok(c)
    when Option::None then Result::Err(RegexError::InvalidEscape(self.pos, '\\'))
    end
  end
end

# NFA construction helpers
def single_transition(t: NfaTransition) -> Nfa
  let mut states = Vec::new()
  states.push(NfaState {
    transitions: vec![(t, 1)],
    is_accept: false
  })
  states.push(NfaState {
    transitions: Vec::new(),
    is_accept: true
  })
  Nfa { states: states, start: 0, accept: 1 }
end

def concatenate_nfa(a: Nfa, b: Nfa) -> Nfa
  let mut states = Vec::new()
  let b_offset = a.states.len()
  
  # Add states from a, adjusting transitions
  for (i, state) in a.states.iter().enumerate() do
    let mut s = state.clone()
    if i == a.accept then
      s.is_accept = false
      s.transitions.push((NfaTransition::Epsilon, b.start + b_offset))
    end
    states.push(s)
  end
  
  # Add states from b, adjusting transitions
  for state in b.states do
    let mut s = state
    for (t, target) in &mut s.transitions do
      *target = *target + b_offset
    end
    states.push(s)
  end
  
  Nfa {
    states: states,
    start: a.start,
    accept: b.accept + b_offset
  }
end

def apply_star(nfa: Nfa, greedy: Bool) -> Nfa
  let mut states = Vec::new()
  let offset = 1
  
  # New start state
  let new_start_transitions = if greedy then
    vec![(NfaTransition::Epsilon, nfa.start + offset), (NfaTransition::Epsilon, nfa.states.len() + offset)]
  else
    vec![(NfaTransition::Epsilon, nfa.states.len() + offset), (NfaTransition::Epsilon, nfa.start + offset)]
  end
  
  states.push(NfaState {
    transitions: new_start_transitions,
    is_accept: false
  })
  
  # Original states
  for (i, state) in nfa.states.iter().enumerate() do
    let mut s = state.clone()
    for (t, target) in &mut s.transitions do
      *target = *target + offset
    end
    if i == nfa.accept then
      s.is_accept = false
      let loop_transitions = if greedy then
        vec![(NfaTransition::Epsilon, nfa.start + offset), (NfaTransition::Epsilon, nfa.states.len() + offset)]
      else
        vec![(NfaTransition::Epsilon, nfa.states.len() + offset), (NfaTransition::Epsilon, nfa.start + offset)]
      end
      s.transitions.extend(loop_transitions)
    end
    states.push(s)
  end
  
  # New accept state
  states.push(NfaState {
    transitions: Vec::new(),
    is_accept: true
  })
  
  Nfa {
    states: states,
    start: 0,
    accept: states.len() - 1
  }
end

def apply_plus(nfa: Nfa, greedy: Bool) -> Nfa
  let mut states = Vec::new()
  
  # Original states
  for (i, state) in nfa.states.iter().enumerate() do
    let mut s = state.clone()
    if i == nfa.accept then
      s.is_accept = false
      let loop_transitions = if greedy then
        vec![(NfaTransition::Epsilon, nfa.start), (NfaTransition::Epsilon, nfa.states.len())]
      else
        vec![(NfaTransition::Epsilon, nfa.states.len()), (NfaTransition::Epsilon, nfa.start)]
      end
      s.transitions.extend(loop_transitions)
    end
    states.push(s)
  end
  
  # New accept state
  states.push(NfaState {
    transitions: Vec::new(),
    is_accept: true
  })
  
  Nfa {
    states: states,
    start: nfa.start,
    accept: states.len() - 1
  }
end

def apply_optional(nfa: Nfa, greedy: Bool) -> Nfa
  let mut states = Vec::new()
  let offset = 1
  
  let new_start_transitions = if greedy then
    vec![(NfaTransition::Epsilon, nfa.start + offset), (NfaTransition::Epsilon, nfa.states.len() + offset)]
  else
    vec![(NfaTransition::Epsilon, nfa.states.len() + offset), (NfaTransition::Epsilon, nfa.start + offset)]
  end
  
  states.push(NfaState {
    transitions: new_start_transitions,
    is_accept: false
  })
  
  for (i, state) in nfa.states.iter().enumerate() do
    let mut s = state.clone()
    for (t, target) in &mut s.transitions do
      *target = *target + offset
    end
    if i == nfa.accept then
      s.is_accept = false
      s.transitions.push((NfaTransition::Epsilon, nfa.states.len() + offset))
    end
    states.push(s)
  end
  
  states.push(NfaState {
    transitions: Vec::new(),
    is_accept: true
  })
  
  Nfa {
    states: states,
    start: 0,
    accept: states.len() - 1
  }
end

def apply_repetition(nfa: Nfa, min: UInt, max: Option[UInt]) -> Nfa
  # {n,m} = n required copies + (m-n) optional copies
  let mut result = nfa.clone()
  
  for _ in 1..min do
    result = concatenate_nfa(result, nfa.clone())
  end
  
  match max
  when Option::Some(m) then
    for _ in min..m do
      result = concatenate_nfa(result, apply_optional(nfa.clone(), true))
    end
  when Option::None then
    result = concatenate_nfa(result, apply_star(nfa.clone(), true))
  end
  
  result
end

# ———————————————————————————————————————————————————————————————
# Regex Matching (NFA Simulation)
# ———————————————————————————————————————————————————————————————

struct Match
  start: UInt
  end_pos: UInt
  text: String
  groups: Vec[Option[String]]
end

impl Regex
  def is_match(self: &Regex, text: &str) -> Bool
    self.find(text).is_some()
  end
  
  def find(self: &Regex, text: &str) -> Option[Match]
    let chars: Vec[char] = text.chars().collect()
    
    # Try matching at each position
    for start in 0..=chars.len() do
      match self.match_at(&chars, start)
      when Option::Some((end_pos, groups)) then
        return Option::Some(Match {
          start: start,
          end_pos: end_pos,
          text: chars[start..end_pos].iter().collect(),
          groups: groups
        })
      when Option::None then ()
      end
    end
    
    Option::None
  end
  
  def find_all(self: &Regex, text: &str) -> Vec[Match]
    let chars: Vec[char] = text.chars().collect()
    let mut matches = Vec::new()
    let mut pos = 0
    
    while pos <= chars.len() do
      match self.match_at(&chars, pos)
      when Option::Some((end_pos, groups)) then
        matches.push(Match {
          start: pos,
          end_pos: end_pos,
          text: chars[pos..end_pos].iter().collect(),
          groups: groups
        })
        pos = if end_pos > pos then end_pos else pos + 1 end
      when Option::None then
        pos = pos + 1
      end
    end
    
    matches
  end
  
  def replace(self: &Regex, text: &str, replacement: &str) -> String
    self.replace_n(text, replacement, 0)
  end
  
  def replace_n(self: &Regex, text: &str, replacement: &str, n: UInt) -> String
    let chars: Vec[char] = text.chars().collect()
    let mut result = String::new()
    let mut pos = 0
    let mut count = 0
    
    while pos <= chars.len() do
      if n > 0 && count >= n then
        break
      end
      
      match self.match_at(&chars, pos)
      when Option::Some((end_pos, _)) then
        result.push_str(replacement)
        pos = if end_pos > pos then end_pos else pos + 1 end
        count = count + 1
      when Option::None then
        if pos < chars.len() then
          result.push(chars[pos])
        end
        pos = pos + 1
      end
    end
    
    # Append remaining
    for i in pos..chars.len() do
      result.push(chars[i])
    end
    
    result
  end
  
  def split(self: &Regex, text: &str) -> Vec[String]
    let chars: Vec[char] = text.chars().collect()
    let mut parts = Vec::new()
    let mut pos = 0
    let mut last_end = 0
    
    while pos <= chars.len() do
      match self.match_at(&chars, pos)
      when Option::Some((end_pos, _)) then
        parts.push(chars[last_end..pos].iter().collect())
        last_end = end_pos
        pos = if end_pos > pos then end_pos else pos + 1 end
      when Option::None then
        pos = pos + 1
      end
    end
    
    parts.push(chars[last_end..].iter().collect())
    parts
  end
  
  def match_at(self: &Regex, chars: &[char], start: UInt) -> Option[(UInt, Vec[Option[String]])]
    let mut current_states = Set::new()
    self.epsilon_closure(self.nfa.start, &mut current_states)
    self.apply_zero_width_assertions(&mut current_states, chars, start)
    
    let mut pos = start
    let mut last_accept = Option::None
    
    # Check if any initial state is accepting
    if self.has_accept_state(&current_states) then
      last_accept = Option::Some(pos)
    end
    
    while pos < chars.len() && !current_states.is_empty() do
      let c = chars[pos]
      let mut next_states = Set::new()
      
      for state_id in &current_states do
        let state = &self.nfa.states[*state_id]
        for (transition, target) in &state.transitions do
          if self.transition_matches(transition, c, chars, pos) then
            self.epsilon_closure(*target, &mut next_states)
          end
        end
      end
      
      current_states = next_states
      pos = pos + 1
      self.apply_zero_width_assertions(&mut current_states, chars, pos)
      
      if self.has_accept_state(&current_states) then
        last_accept = Option::Some(pos)
      end
    end
    
    match last_accept
    when Option::Some(end_pos) then
      Option::Some((end_pos, self.extract_groups_for_match(chars, start, end_pos)))
    when Option::None then Option::None
    end
  end

  def extract_groups_for_match(self: &Regex, chars: &[char], start: UInt, end_pos: UInt) -> Vec[Option[String]]
    let matched_text: String = chars[start..end_pos].iter().collect()
    let group_patterns = self.capture_group_patterns()

    let mut groups: Vec[Option[String]] = Vec::new()
    groups.push(Option::Some(matched_text.clone()))

    let mut cursor: UInt = 0
    for gp in group_patterns do
      let (cap, next_cursor) = self.capture_subgroup_heuristic(&matched_text, gp.as_str(), cursor)
      groups.push(cap)
      cursor = next_cursor
    end

    groups
  end

  def capture_group_patterns(self: &Regex) -> Vec[String]
    self.capture_group_cache.clone()
  end

  def capture_subgroup_heuristic(self: &Regex, text: &String, group_pattern: &str, cursor: UInt) -> (Option[String], UInt)
    if group_pattern.is_empty() then
      return (Option::Some("".to_string()), cursor)
    end

    match self.capture_simple_class_group(text, group_pattern, cursor, true)
    when Option::Some((cap, next_cursor)) then
      return (Option::Some(cap), next_cursor)
    when Option::None then ()
    end

    match self.capture_group_via_nested_regex(text, group_pattern, cursor, true)
    when Option::Some((cap, next_cursor)) then
      return (Option::Some(cap), next_cursor)
    when Option::None then ()
    end

    if self.is_plain_literal_group(group_pattern) then
      let literal_prefix = self.unescape_literal_group(group_pattern)
      if !literal_prefix.is_empty() && cursor + literal_prefix.len() <= text.len() then
        if text.slice(cursor, cursor + literal_prefix.len()) == literal_prefix then
          return (Option::Some(literal_prefix), cursor + literal_prefix.len())
        end
      end
    end

    match self.capture_simple_class_group(text, group_pattern, cursor, false)
    when Option::Some((cap, next_cursor)) then
      return (Option::Some(cap), next_cursor)
    when Option::None then ()
    end

    match self.capture_group_via_nested_regex(text, group_pattern, cursor, false)
    when Option::Some((cap, next_cursor)) then
      return (Option::Some(cap), next_cursor)
    when Option::None then ()
    end

    if !self.is_plain_literal_group(group_pattern) then
      return (Option::None, cursor)
    end

    let literal = self.unescape_literal_group(group_pattern)
    if literal.is_empty() || cursor > text.len() then
      return (Option::None, cursor)
    end

    let tail = text.slice(cursor, text.len())
    match tail.find(literal.as_str())
    when Option::Some(idx) then
      let start = cursor + idx
      let end_pos = start + literal.len()
      (Option::Some(text.slice(start, end_pos).to_string()), end_pos)
    when Option::None then
      (Option::None, cursor)
    end
  end

  def capture_simple_class_group(self: &Regex, text: &String, pattern: &str, cursor: UInt, anchored_only: Bool) -> Option[(String, UInt)]
    if cursor >= text.len() then
      if pattern == "\\d*" || pattern == "\\d?" || pattern == "\\w*" || pattern == "\\w?" || pattern == "\\s*" || pattern == "\\s?" then
        return Option::Some(("".to_string(), cursor))
      end
      return Option::None
    end

    let mut starts = Vec::new()
    if anchored_only then
      starts.push(cursor)
    else
      let mut s = cursor
      while s <= text.len() do
        starts.push(s)
        s = s + 1
      end
    end

    for start in starts do
      let mut i = start

      if pattern == "\\d+" || pattern == "\\d*" || pattern == "\\d?" then
        while i < text.len() && text.char_at(i).is_digit() do
          i = i + 1
        end
        if pattern == "\\d+" then
          if i > start then return Option::Some((text.slice(start, i).to_string(), i)) end
        elsif pattern == "\\d*" then
          return Option::Some((text.slice(start, i).to_string(), i))
        else
          if i > start then
            return Option::Some((text.slice(start, start + 1).to_string(), start + 1))
          else
            return Option::Some(("".to_string(), start))
          end
        end
      end

      if pattern == "\\w+" || pattern == "\\w*" || pattern == "\\w?" then
        while i < text.len() do
          let c = text.char_at(i)
          if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' then
            i = i + 1
          else
            break
          end
        end
        if pattern == "\\w+" then
          if i > start then return Option::Some((text.slice(start, i).to_string(), i)) end
        elsif pattern == "\\w*" then
          return Option::Some((text.slice(start, i).to_string(), i))
        else
          if i > start then
            return Option::Some((text.slice(start, start + 1).to_string(), start + 1))
          else
            return Option::Some(("".to_string(), start))
          end
        end
      end

      if pattern == "\\s+" || pattern == "\\s*" || pattern == "\\s?" then
        while i < text.len() do
          let c = text.char_at(i)
          if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\x0c' then
            i = i + 1
          else
            break
          end
        end
        if pattern == "\\s+" then
          if i > start then return Option::Some((text.slice(start, i).to_string(), i)) end
        elsif pattern == "\\s*" then
          return Option::Some((text.slice(start, i).to_string(), i))
        else
          if i > start then
            return Option::Some((text.slice(start, start + 1).to_string(), start + 1))
          else
            return Option::Some(("".to_string(), start))
          end
        end
      end
    end

    Option::None
  end

  def capture_group_via_nested_regex(self: &Regex, text: &String, pattern: &str, cursor: UInt, anchored_only: Bool) -> Option[(String, UInt)]
    if pattern.is_empty() || cursor > text.len() then
      return Option::None
    end

    let tail = text.slice(cursor, text.len())
    let nested = match Regex::with_flags(pattern, self.flags.clone())
    when Result::Ok(r) then r
    when Result::Err(_) then return Option::None
    end

    if anchored_only then
      let tail_chars: Vec[char] = tail.chars().collect()
      match nested.match_at(&tail_chars, 0)
      when Option::Some((end_pos, _)) then
        let captured = tail.slice(0, end_pos).to_string()
        Option::Some((captured, cursor + end_pos))
      when Option::None then Option::None
      end
    else
      match nested.find(tail)
      when Option::Some(m) then
        let captured = tail.slice(m.start as Int, m.end_pos as Int).to_string()
        Option::Some((captured, cursor + m.end_pos))
      when Option::None then Option::None
      end
    end
  end

  def is_plain_literal_group(self: &Regex, pattern: &str) -> Bool
    let chars: Vec[char] = pattern.chars().collect()
    let mut escaped = false
    let mut i: UInt = 0
    while i < chars.len() do
      let ch = chars[i]
      if escaped then
        escaped = false
      else
        if ch == '\\' then
          escaped = true
        elsif ch == '.' || ch == '*' || ch == '+' || ch == '?' || ch == '(' || ch == ')' ||
              ch == '[' || ch == ']' || ch == '{' || ch == '}' || ch == '^' || ch == '$' || ch == '|' then
          return false
        end
      end
      i = i + 1
    end
    !escaped
  end

  def unescape_literal_group(self: &Regex, pattern: &str) -> String
    let chars: Vec[char] = pattern.chars().collect()
    let mut out = String::new()
    let mut escaped = false
    let mut i: UInt = 0
    while i < chars.len() do
      let ch = chars[i]
      if escaped then
        out.push(ch)
        escaped = false
      else
        if ch == '\\' then
          escaped = true
        else
          out.push(ch)
        end
      end
      i = i + 1
    end
    out
  end

  def apply_zero_width_assertions(self: &Regex, states: &mut Set[UInt], chars: &[char], pos: UInt) -> Unit
    let mut changed = true
    while changed do
      changed = false

      let mut snapshot = Vec::new()
      for state_id in states do
        snapshot.push(*state_id)
      end

      for state_id in snapshot do
        let state = &self.nfa.states[state_id]
        for (transition, target) in &state.transitions do
          let should_advance = match transition
          when NfaTransition::StartOfString then pos == 0
          when NfaTransition::EndOfString then pos == chars.len()
          when NfaTransition::StartOfLine then pos == 0 || (pos > 0 && chars[pos - 1] == '\n')
          when NfaTransition::EndOfLine then pos == chars.len() || chars[pos] == '\n'
          when NfaTransition::WordBoundary then self.is_word_boundary(chars, pos)
          when NfaTransition::NotWordBoundary then !self.is_word_boundary(chars, pos)
          when _ then false
          end

          if should_advance && !states.contains(target) then
            self.epsilon_closure(*target, states)
            changed = true
          end
        end
      end
    end
  end

  def is_word_char(self: &Regex, c: char) -> Bool
    (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '_'
  end

  def is_word_boundary(self: &Regex, chars: &[char], pos: UInt) -> Bool
    let prev_is_word = if pos > 0 then self.is_word_char(chars[pos - 1]) else false end
    let next_is_word = if pos < chars.len() then self.is_word_char(chars[pos]) else false end
    prev_is_word != next_is_word
  end
  
  def epsilon_closure(self: &Regex, state_id: UInt, states: &mut Set[UInt]) -> Unit
    if states.contains(&state_id) then
      return
    end
    
    states.insert(state_id)
    
    let state = &self.nfa.states[state_id]
    for (transition, target) in &state.transitions do
      match transition
      when NfaTransition::Epsilon then
        self.epsilon_closure(*target, states)
      when _ then ()
      end
    end
  end
  
  def has_accept_state(self: &Regex, states: &Set[UInt]) -> Bool
    for state_id in states do
      if self.nfa.states[*state_id].is_accept then
        return true
      end
    end
    false
  end
  
  def transition_matches(self: &Regex, t: &NfaTransition, c: char, chars: &[char], pos: UInt) -> Bool
    let c: char = c
    
    match t
    when NfaTransition::Epsilon then false  # handled separately
    when NfaTransition::Char(expected) then
      let expected_char = *expected
      c == expected_char
    when NfaTransition::CharRange(start, end_pos) then c >= *start && c <= *end_pos
    when NfaTransition::CharClass(cc) then cc.matches(c)
    when NfaTransition::Any then true
    when NfaTransition::AnyNotNewline then c != '\n'
    when NfaTransition::StartOfLine | NfaTransition::StartOfString then false  # zero-width
    when NfaTransition::EndOfLine | NfaTransition::EndOfString then false  # zero-width
    when NfaTransition::WordBoundary then false  # zero-width
    when NfaTransition::NotWordBoundary then false  # zero-width
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# PART 2: PARSER COMBINATORS
# ═══════════════════════════════════════════════════════════════

# ———————————————————————————————————————————————————————————————
# Parser Types
# ———————————————————————————————————————————————————————————————

struct ParseState
  input: String
  pos: UInt
  line: UInt
  col: UInt
end

def ParseState::new(input: &str) -> ParseState
  ParseState {
    input: input.to_string(),
    pos: 0,
    line: 1,
    col: 1
  }
end

impl ParseState
  def peek(self: &ParseState) -> Option[char]
    if self.pos < self.input.len() then
      Option::Some(self.input.char_at(self.pos))
    else
      Option::None
    end
  end
  
  def advance(self: &mut ParseState) -> Option[char]
    match self.peek()
    when Option::Some(c) then
      self.pos = self.pos + 1
      if c == '\n' then
        self.line = self.line + 1
        self.col = 1
      else
        self.col = self.col + 1
      end
      Option::Some(c)
    when Option::None then Option::None
    end
  end
  
  def remaining(self: &ParseState) -> &str
    self.input.slice(self.pos, self.input.len())
  end
  
  def is_eof(self: &ParseState) -> Bool
    self.pos >= self.input.len()
  end
end

enum ParseError
  Expected(String, UInt, UInt)
  UnexpectedEof
  Custom(String)
end

def parse_error_message(e: &ParseError) -> String
  match e
  when ParseError::Expected(msg, line, col) then
    "expected " + msg.clone() + " at line " + line.to_string() + ":" + col.to_string()
  when ParseError::UnexpectedEof then "unexpected end of input"
  when ParseError::Custom(msg) then msg.clone()
  end
end

type ParseResult[T] = Result[(T, ParseState), ParseError]

# Parser is a function from ParseState to ParseResult[T]
struct Parser[T]
  run: fn(ParseState) -> ParseResult[T]
end

impl[T] Parser[T]
  def parse(self: &Parser[T], input: &str) -> Result[T, ParseError]
    let state = ParseState::new(input)
    match (self.run)(state)
    when Result::Ok((value, _)) then Result::Ok(value)
    when Result::Err(e) then Result::Err(e)
    end
  end
  
  def map[U](self: Parser[T], f: fn(T) -> U) -> Parser[U]
    Parser {
      run: |state| {
        match (self.run)(state)
        when Result::Ok((value, next)) then Result::Ok((f(value), next))
        when Result::Err(e) then Result::Err(e)
        end
      }
    }
  end
  
  def flat_map[U](self: Parser[T], f: fn(T) -> Parser[U]) -> Parser[U]
    Parser {
      run: |state| {
        match (self.run)(state)
        when Result::Ok((value, next)) then (f(value).run)(next)
        when Result::Err(e) then Result::Err(e)
        end
      }
    }
  end
  
  def pair_with[U](self: Parser[T], other: Parser[U]) -> Parser[(T, U)]
    Parser {
      run: |state| {
        match (self.run)(state)
        when Result::Ok((v1, next)) then
          match (other.run)(next)
          when Result::Ok((v2, final_state)) then Result::Ok(((v1, v2), final_state))
          when Result::Err(e) then Result::Err(e)
          end
        when Result::Err(e) then Result::Err(e)
        end
      }
    }
  end
  
  def or_else(self: Parser[T], other: Parser[T]) -> Parser[T]
    Parser {
      run: |state| {
        match (self.run)(state.clone())
        when Result::Ok(result) then Result::Ok(result)
        when Result::Err(_) then (other.run)(state)
        end
      }
    }
  end
  
  def optional(self: Parser[T]) -> Parser[Option[T]]
    Parser {
      run: |state| {
        match (self.run)(state.clone())
        when Result::Ok((value, next)) then Result::Ok((Option::Some(value), next))
        when Result::Err(_) then Result::Ok((Option::None, state))
        end
      }
    }
  end
  
  def many(self: Parser[T]) -> Parser[Vec[T]]
    Parser {
      run: |state| {
        let mut results = Vec::new()
        let mut current = state
        
        loop
          match (self.run)(current.clone())
          when Result::Ok((value, next)) then
            results.push(value)
            current = next
          when Result::Err(_) then break
          end
        end
        
        Result::Ok((results, current))
      }
    }
  end
  
  def many1(self: Parser[T]) -> Parser[Vec[T]]
    Parser {
      run: |state| {
        match (self.run)(state)
        when Result::Ok((first, next)) then
          let mut results = vec![first]
          let mut current = next
          
          loop
            match (self.run)(current.clone())
            when Result::Ok((value, next_state)) then
              results.push(value)
              current = next_state
            when Result::Err(_) then break
            end
          end
          
          Result::Ok((results, current))
        when Result::Err(e) then Result::Err(e)
        end
      }
    }
  end
  
  def skip[U](self: Parser[T], other: Parser[U]) -> Parser[T]
    self.pair_with(other).map(|pair| {
      let (t, _) = pair
      t
    })
  end
  
  def followed_by[U](self: Parser[T], other: Parser[U]) -> Parser[U]
    self.pair_with(other).map(|pair| {
      let (_, u) = pair
      u
    })
  end
  
  def between[L, R](self: Parser[T], left: Parser[L], right: Parser[R]) -> Parser[T]
    left.followed_by(self).skip(right)
  end
  
  def sep_by[S](self: Parser[T], sep: Parser[S]) -> Parser[Vec[T]]
    self.sep_by1(sep).or_else(pure(Vec::new()))
  end
  
  def sep_by1[S](self: Parser[T], sep: Parser[S]) -> Parser[Vec[T]]
    self.pair_with(sep.followed_by(self.clone()).many()).map(|pair| {
      let (first, rest) = pair
      let mut results = vec![first]
      results.extend(rest)
      results
    })
  end
  
  def label(self: Parser[T], name: &str) -> Parser[T]
    let name = name.to_string()
    Parser {
      run: |state| {
        match (self.run)(state.clone())
        when Result::Ok(result) then Result::Ok(result)
        when Result::Err(_) then
          Result::Err(ParseError::Expected(name.clone(), state.line, state.col))
        end
      }
    }
  end
end

# ———————————————————————————————————————————————————————————————
# Basic Parsers
# ———————————————————————————————————————————————————————————————

def pure[T](value: T) -> Parser[T]
  Parser {
    run: |state| Result::Ok((value, state))
  }
end

def fail[T](msg: &str) -> Parser[T]
  let msg = msg.to_string()
  Parser {
    run: |_| Result::Err(ParseError::Custom(msg.clone()))
  }
end

def any_char() -> Parser[char]
  Parser {
    run: |mut state| {
      match state.advance()
      when Option::Some(c) then Result::Ok((c, state))
      when Option::None then Result::Err(ParseError::UnexpectedEof)
      end
    }
  }
end

def char_p(expected: char) -> Parser[char]
  Parser {
    run: |mut state| {
      match state.peek()
      when Option::Some(c) then
        if c == expected then
          state.advance()
          Result::Ok((c, state))
        else
          Result::Err(ParseError::Expected("'" + expected.to_string() + "'", state.line, state.col))
        end
      when Option::None then Result::Err(ParseError::UnexpectedEof)
      end
    }
  }
end

def satisfy(pred: fn(char) -> Bool) -> Parser[char]
  Parser {
    run: |mut state| {
      match state.peek()
      when Option::Some(c) then
        if pred(c) then
          state.advance()
          Result::Ok((c, state))
        else
          Result::Err(ParseError::Expected("character matching predicate", state.line, state.col))
        end
      when Option::None then Result::Err(ParseError::UnexpectedEof)
      end
    }
  }
end

def one_of(chars: &str) -> Parser[char]
  let char_set: Set[char] = chars.chars().collect()
  satisfy(|c| char_set.contains(&c))
end

def none_of(chars: &str) -> Parser[char]
  let char_set: Set[char] = chars.chars().collect()
  satisfy(|c| !char_set.contains(&c))
end

def string_p(expected: &str) -> Parser[String]
  let expected = expected.to_string()
  Parser {
    run: |mut state| {
      let chars: Vec[char] = expected.chars().collect()
      for c in &chars do
        match state.peek()
        when Option::Some(actual) then
          if actual == *c then
            state.advance()
          else
            return Result::Err(ParseError::Expected("\"" + expected.clone() + "\"", state.line, state.col))
          end
        when Option::None then
          return Result::Err(ParseError::UnexpectedEof)
        end
      end
      Result::Ok((expected.clone(), state))
    }
  }
end

def digit() -> Parser[char]
  satisfy(|c| c >= '0' && c <= '9').label("digit")
end

def letter() -> Parser[char]
  satisfy(|c| (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')).label("letter")
end

def alphanumeric() -> Parser[char]
  digit().or_else(letter()).label("alphanumeric")
end

def whitespace() -> Parser[char]
  satisfy(|c| c == ' ' || c == '\t' || c == '\n' || c == '\r').label("whitespace")
end

def spaces() -> Parser[Vec[char]]
  whitespace().many()
end

def spaces1() -> Parser[Vec[char]]
  whitespace().many1()
end

def newline() -> Parser[char]
  char_p('\n').label("newline")
end

def eof() -> Parser[Unit]
  Parser {
    run: |state| {
      if state.is_eof() then
        Result::Ok(((), state))
      else
        Result::Err(ParseError::Expected("end of input", state.line, state.col))
      end
    }
  }
end

# ———————————————————————————————————————————————————————————————
# Number Parsers
# ———————————————————————————————————————————————————————————————

def integer() -> Parser[Int]
  let sign = char_p('-').optional()
  let digits = digit().many1()
  
  sign.pair_with(digits).map(|pair| {
    let (s, ds) = pair
    let _ = ds
    let value: Int = 0
    match s
    when Option::Some(_) then -value
    when Option::None then value
    end
  }).label("integer")
end

def unsigned_integer() -> Parser[UInt]
  digit().many1().map(|ds| {
    let num_str: String = ds.iter().collect()
    num_str.parse_uint().unwrap_or(0)
  }).label("unsigned integer")
end

def float_p() -> Parser[f64]
  let sign = char_p('-').optional()
  let integer_part = digit().many1()
  let decimal_part = char_p('.').followed_by(digit().many1()).optional()
  let exponent = one_of("eE").followed_by(one_of("+-").optional()).pair_with(digit().many1()).optional()
  
  sign.pair_with(integer_part).pair_with(decimal_part).pair_with(exponent).map(|parts| {
    match parts
    when (((s, int_ds), dec), exp) then
      let mut num_str = String::new()
      match s
      when Option::Some(_) then num_str.push('-')
      when Option::None then ()
      end
      
      for c in int_ds do
        num_str.push(c)
      end
      
      match dec
      when Option::Some(ds) then
        num_str.push('.')
        for c in ds do
          num_str.push(c)
        end
      when Option::None then ()
      end
      
      match exp
      when Option::Some((sign, ds)) then
        num_str.push('e')
        match sign
        when Option::Some(s) then num_str.push(s)
        when Option::None then ()
        end
        for c in ds do
          num_str.push(c)
        end
      when Option::None then ()
      end
      
      num_str.parse_f64().unwrap_or(0.0)
    end
  }).label("float")
end

# ———————————————————————————————————————————————————————————————
# String Parsers
# ———————————————————————————————————————————————————————————————

def quoted_string() -> Parser[String]
  let content = none_of("\"\\")
  
  char_p('"').followed_by(content.many()).skip(char_p('"')).map(|cs| cs.iter().collect())
end

def identifier() -> Parser[String]
  let first = letter().or_else(char_p('_'))
  let rest = alphanumeric().or_else(char_p('_')).many()
  
  first.pair_with(rest).map(|pair| {
    let (f, rs) = pair
    let mut s = String::new()
    s.push(f)
    for c in rs do
      s.push(c)
    end
    s
  }).label("identifier")
end

def take_while(pred: fn(char) -> Bool) -> Parser[String]
  satisfy(pred).many().map(|cs| cs.iter().collect())
end

def take_while1(pred: fn(char) -> Bool) -> Parser[String]
  satisfy(pred).many1().map(|cs| cs.iter().collect())
end

def take_until(terminator: &str) -> Parser[String]
  let term = terminator.to_string()
  Parser {
    run: |mut state| {
      let mut result = String::new()
      while !state.is_eof() do
        if state.remaining().starts_with(term.as_str()) then
          break
        end
        result.push(state.advance().unwrap())
      end
      Result::Ok((result, state))
    }
  }
end

# ———————————————————————————————————————————————————————————————
# Combinator Utilities
# ———————————————————————————————————————————————————————————————

def choice[T](parsers: Vec[Parser[T]]) -> Parser[T]
  if parsers.is_empty() then
    return fail("empty choice")
  end
  
  let mut result = parsers[0].clone()
  for i in 1..parsers.len() do
    result = result.or_else(parsers[i].clone())
  end
  result
end

def sequence[T](parsers: Vec[Parser[T]]) -> Parser[Vec[T]]
  Parser {
    run: |state| {
      let mut results = Vec::new()
      let mut current = state
      
      for parser in &parsers do
        match (parser.run)(current)
        when Result::Ok((value, next)) then
          results.push(value)
          current = next
        when Result::Err(e) then return Result::Err(e)
        end
      end
      
      Result::Ok((results, current))
    }
  }
end

def lazy[T](thunk: fn() -> Parser[T]) -> Parser[T]
  Parser {
    run: |state| (thunk().run)(state)
  }
end

def not_followed_by[T](parser: Parser[T]) -> Parser[Unit]
  Parser {
    run: |state| {
      match (parser.run)(state.clone())
      when Result::Ok(_) then
        Result::Err(ParseError::Expected("not to match", state.line, state.col))
      when Result::Err(_) then Result::Ok(((), state))
      end
    }
  }
end

def lookahead[T](parser: Parser[T]) -> Parser[T]
  Parser {
    run: |state| {
      match (parser.run)(state.clone())
      when Result::Ok((value, _)) then Result::Ok((value, state))
      when Result::Err(e) then Result::Err(e)
      end
    }
  }
end

# ———————————————————————————————————————————————————————————————
# Expression Parsing
# ———————————————————————————————————————————————————————————————

enum Assoc
  Left
  Right
end

struct Operator[T]
  symbol: String
  precedence: UInt
  assoc: Assoc
  apply: fn(T, T) -> T
end

def expr_parser[T](atom: Parser[T], operators: Vec[Operator[T]]) -> Parser[T]
  let mut ops_by_prec: Map[UInt, Vec[&Operator[T]]] = Map::new()
  let mut max_prec = 0
  
  for op in &operators do
    if op.precedence > max_prec then
      max_prec = op.precedence
    end
    match ops_by_prec.get(&op.precedence)
    when Option::Some(existing) then
      let mut updated = existing.clone()
      updated.push(op)
      ops_by_prec.insert(op.precedence, updated)
    when Option::None then
      ops_by_prec.insert(op.precedence, vec![op])
    end
  end
  
  let mut current = atom
  
  for prec in 1..=max_prec do
    match ops_by_prec.get(&prec)
    when Option::Some(ops) then
      let left_assoc = ops.iter().any(|op| matches!(&op.assoc, Assoc::Left))
      
      if left_assoc then
        current = left_assoc_expr(current, ops.clone())
      else
        current = right_assoc_expr(current, ops.clone())
      end
    when Option::None then ()
    end
  end
  
  current
end

def left_assoc_expr[T](operand: Parser[T], ops: Vec[&Operator[T]]) -> Parser[T]
  let op_parsers: Vec[Parser[(&Operator[T], T)]] = ops.iter().map(|op| {
    spaces().followed_by(string_p(op.symbol.as_str())).followed_by(spaces()).followed_by(operand.clone())
      .map(|t| (op, t))
  }).collect()
  
  operand.pair_with(choice(op_parsers).many()).map(|pair| {
    let (first, rest) = pair
    let _ = rest
    first
  })
end

def right_assoc_expr[T](operand: Parser[T], ops: Vec[&Operator[T]]) -> Parser[T]
  lazy(|| {
    operand.clone().pair_with(
      spaces().followed_by(
        choice(ops.iter().map(|op| string_p(op.symbol.as_str()).map(|_| op)).collect())
      ).skip(spaces()).pair_with(right_assoc_expr(operand.clone(), ops.clone())).optional()
    ).map(|pair| {
      let (first, rest) = pair
      match rest
      when Option::Some((op, right)) then (op.apply)(first, right)
      when Option::None then first
      end
    })
  })
end
