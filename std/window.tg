end

pub enum GamepadButton
  # Face buttons (Sony: Cross, Circle, Square, Triangle)
  A
  B
  X
  Y
  LeftBumper
  RightBumper
  # Select, Menu, Home/Logo
  Back
  Start
  Guide
  LeftThumb
  RightThumb
  DPadUp
  DPadDown
  DPadLeft
  DPadRight
end

pub enum GamepadAxis
  LeftX
  LeftY
  RightX
  RightY
  LeftTrigger
  RightTrigger
end

pub struct GamepadState
  connected: Bool
  name: String
  axes: Vec[f32]
  buttons: Vec[Bool]
end

# ———————————————————————————————————————————————————————————————
# Window Handle
# ———————————————————————————————————————————————————————————————

pub struct Window
  id: u64
  native_handle: Ptr[u8]
  config: WindowConfig
  should_close: Bool
  scale_factor: f64  # For HiDPI
end

impl Window
  # Get window size in pixels
  pub def size(self: Self) -> Vec2[u32]
    Vec2 { x: self.config.width, y: self.config.height }
  end
  
  # Get window size in screen coordinates (may differ on HiDPI)
  pub def framebuffer_size(self: Self) -> Vec2[u32]
    # On HiDPI displays, framebuffer size > window size
    Vec2 { 
      x: (self.config.width as f64 * self.scale_factor) as u32,
      y: (self.config.height as f64 * self.scale_factor) as u32
    }
  end
  
  # Get window position
  pub def position(self: Self) -> Vec2[i32]
    # Query native window for position
    unsafe "native window position query" do
      native_get_window_position(self.native_handle)
    end
  end
  
  # Set window title
  pub def set_title(inout self: Self, title: String) -> Unit
    self.config.title = title.clone()
    unsafe "native window set title" do
      native_set_window_title(self.native_handle, cstring_as_ptr(&cstring_new(title)))
    end
  end
  
  # Set window size
  pub def set_size(inout self: Self, width: u32, height: u32) -> Unit
    self.config.width = width
    self.config.height = height
    unsafe "native window set size" do
      native_set_window_size(self.native_handle, width, height)
    end
  end
  
  # Set window position
  pub def set_position(inout self: Self, x: i32, y: i32) -> Unit
    unsafe "native window set position" do
      native_set_window_position(self.native_handle, x, y)
    end
  end
  
  # Request window close
  pub fn close(inout self: Self) -> Unit
    self.should_close = true
  end
  
  # Check if window should close
  pub def should_close(self: Self) -> Bool
    self.should_close
  end
  
  # Minimize window
  pub def minimize(inout self: Self) -> Unit
    unsafe "native window minimize" do
      native_minimize_window(self.native_handle)
    end
  end
  
  # Maximize window
  pub def maximize(inout self: Self) -> Unit
    unsafe "native window maximize" do
      native_maximize_window(self.native_handle)
    end
  end
  
  # Restore window
  pub def restore(inout self: Self) -> Unit
    unsafe "native window restore" do
      native_restore_window(self.native_handle)
    end
  end
  
  # Set fullscreen mode
  pub def set_fullscreen(inout self: Self, fullscreen: Bool) -> Unit
    self.config.fullscreen = fullscreen
    unsafe "native window set fullscreen" do
      native_set_window_fullscreen(self.native_handle, fullscreen)
    end
  end
  
  # Get native handle for graphics API interop
  pub def native_handle(self: Self) -> Ptr[u8]
    self.native_handle
  end
  
  # Get scale factor for HiDPI
  pub def scale_factor(self: Self) -> f64
    self.scale_factor
  end
  
  # Request attention (flash taskbar, etc.)
  pub def request_attention(self: Self) -> Unit
    unsafe "native window request attention" do
      native_request_attention(self.native_handle)
    end
  end
  
  # Set cursor visibility
  pub def set_cursor_visible(self: Self, visible: Bool) -> Unit
    unsafe "native window set cursor visible" do
      native_set_cursor_visible(self.native_handle, visible)
    end
  end
  
  # Set cursor position (relative to window)
  pub def set_cursor_pos(self: Self, x: f64, y: f64) -> Unit
    unsafe "native window set cursor pos" do
      native_set_cursor_pos(self.native_handle, x, y)
    end
  end
  
  # Set cursor shape
  pub def set_cursor_shape(self: Self, shape: CursorShape) -> Unit
    unsafe "native window set cursor shape" do
      native_set_cursor_shape(self.native_handle, shape as i32)
    end
  end
end

pub enum CursorShape
  Arrow
  IBeam  # Text input
  Crosshair
  Hand  # Link/interactive
  HResize  # Horizontal resize
  VResize  # Vertical resize
  ResizeAll  # All directions
  NotAllowed  # Forbidden
  Hidden
end

# ———————————————————————————————————————————————————————————————
# Event Loop
# ———————————————————————————————————————————————————————————————

pub struct EventLoop
  windows: Map[u64, Window]
  gamepads: Map[u32, GamepadState]
  running: Bool
  next_window_id: u64
end

impl EventLoop
  pub def new() -> EventLoop
    unsafe "native event loop init" do
      native_init_event_loop()
    end
    EventLoop {
      windows: Map::new(),
      gamepads: Map::new(),
      running: false,
      next_window_id: 1
    }
  end
  
  # Create a new window
  pub def create_window(inout self: Self, config: WindowConfig) -> Result[Window, String]
    let cs_title = cstring_new(config.title.clone())
    
    mut native_handle: Ptr[u8] = Ptr::null()
    mut scale_factor: f64 = 1.0
    
    unsafe "native window creation" do
      let result = native_create_window(
        cstring_as_ptr(&cs_title),
        config.width,
        config.height,
        config.resizable,
        config.fullscreen,
        config.borderless,
        config.transparent,
        config.decorated,
        config.visible
      )
      if result.status != 0 then
        return Result::Err("Failed to create window: " + result.error_message)
      end
      native_handle = result.handle
      scale_factor = result.scale_factor
    end
    
    let window = Window {
      id: self.next_window_id,
      native_handle: native_handle,
      config: config,
      should_close: false,
      scale_factor: scale_factor
    }
    
    self.next_window_id = self.next_window_id + 1
    self.windows.insert(window.id, window.clone())
    
    Result::Ok(window)
  end
  
  # Run the event loop
  pub def run(inout self: Self, callback: fn(inout Self, WindowEvent, inout Window) -> Unit) -> Unit
    self.running = true
    
    while self.running do
      # Poll for events
      unsafe "native event polling" do
        native_poll_events()
      end
      
      # Process events for each window
      for (id, window) in self.windows do
        if window.should_close then
          callback(self, WindowEvent::Closed, window)
          self.windows.remove(&id)
        else
          # Process pending events for this window
          unsafe "native get events" do
            let events = native_get_window_events(window.native_handle)
            for event in events do
              callback(self, event, window)
            end
          end
        end
      end
      
      # Check if all windows are closed
      if self.windows.is_empty() then
        self.running = false
      end
      
      # Yield to OS
      unsafe "native yield" do
        native_yield()
      end
    end
  end
  
  # Stop the event loop
  pub def stop(inout self: Self) -> Unit
    self.running = false
  end
  
  # Get gamepad state
  pub def gamepad_state(self: Self, id: u32) -> Option[GamepadState]
    self.gamepads.get(&id).cloned()
  end
end

# ———————————————————————————————————————————————————————————————
# Monitor Support
# ———————————————————————————————————————————————————————————————

pub struct Monitor
  id: u32
  name: String
  x: i32
  y: i32
  width: u32
  height: u32
  refresh_rate: u32
  scale_factor: f64
  primary: Bool
end

pub def get_monitors() -> Vec[Monitor]
  unsafe "native get monitors" do
    native_get_monitors()
  end
end

pub def get_primary_monitor() -> Option[Monitor]
  let monitors = get_monitors()
  for m in monitors do
    if m.primary then
      return Option::Some(m)
    end
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# Native FFI declarations (platform-specific implementations)
# ———————————————————————————————————————————————————————————————

extern "C" do
  # Initialization
  def native_init_event_loop() -> Unit
  
  # Window management
  def native_create_window(
    title: Ptr[u8],
    width: u32,
    height: u32,
    resizable: Bool,
    fullscreen: Bool,
    borderless: Bool,
    transparent: Bool,
    decorated: Bool,
    visible: Bool
  ) -> NativeWindowResult
  
  def native_destroy_window(handle: Ptr[u8]) -> Unit
  def native_set_window_title(handle: Ptr[u8], title: Ptr[u8]) -> Unit
  def native_set_window_size(handle: Ptr[u8], width: u32, height: u32) -> Unit
  def native_set_window_position(handle: Ptr[u8], x: i32, y: i32) -> Unit
  def native_get_window_position(handle: Ptr[u8]) -> Vec2[i32]
  def native_minimize_window(handle: Ptr[u8]) -> Unit
  def native_maximize_window(handle: Ptr[u8]) -> Unit
  def native_restore_window(handle: Ptr[u8]) -> Unit
  def native_set_window_fullscreen(handle: Ptr[u8], fullscreen: Bool) -> Unit
  def native_request_attention(handle: Ptr[u8]) -> Unit
  def native_set_cursor_visible(handle: Ptr[u8], visible: Bool) -> Unit
  def native_set_cursor_pos(handle: Ptr[u8], x: f64, y: f64) -> Unit
  def native_set_cursor_shape(handle: Ptr[u8], shape: i32) -> Unit
  
  # Event handling
  def native_poll_events() -> Unit
  def native_get_window_events(handle: Ptr[u8]) -> Vec[WindowEvent]
  def native_yield() -> Unit
  
  # Monitor support
  def native_get_monitors() -> Vec[Monitor]
end

struct NativeWindowResult
  status: i32
  handle: Ptr[u8]
  scale_factor: f64
  error_message: Ptr[u8]
end

# ———————————————————————————————————————————————————————————————
# Clipboard Support
# ———————————————————————————————————————————————————————————————

pub def get_clipboard_text() -> Option[String]
  unsafe "native clipboard get" do
    let ptr = native_get_clipboard_text()
    if ptr.is_null() then
      Option::None
    else
      Option::Some(String::from_cstr(ptr))
    end
  end
end

pub def set_clipboard_text(text: String) -> Unit
  let cs = cstring_new(text)
  unsafe "native clipboard set" do
    native_set_clipboard_text(cstring_as_ptr(&cs))
  end
end

extern "C" do
  def native_get_clipboard_text() -> Ptr[u8]
  def native_set_clipboard_text(text: Ptr[u8]) -> Unit
end