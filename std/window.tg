## Tangerine Standard Library — std::window
## Native window creation and event loop management
## 
## Provides cross-platform window creation similar to GLFW/SDL:
## - Window creation with configurable properties
## - Event loop with keyboard/mouse/window events
## - OpenGL/Vulkan/Metal context creation
## - Multi-monitor support
## - High DPI handling

use std::collections::{Vec, Map}
use std::ffi::{Ptr, CString, cstring_new, cstring_as_ptr}
use std::core::{Option, Result}
use std::time::{Duration, Instant}
use std::geom::{Vec2, Vec4, Rect}

# ———————————————————————————————————————————————————————————————
# Window Configuration
# ———————————————————————————————————————————————————————————————

pub struct WindowConfig
  title: String
  width: u32
  height: u32
  resizable: Bool
  fullscreen: Bool
  borderless: Bool
  vsync: Bool
  samples: u32          # MSAA samples (0 = disabled)
  transparent: Bool
  always_on_top: Bool
  decorated: Bool
  visible: Bool
  min_width: u32
  min_height: u32
  max_width: u32
  max_height: u32
end

pub def window_config_default() -> WindowConfig
  WindowConfig {
    title: "Tangerine Window",
    width: 800,
    height: 600,
    resizable: true,
    fullscreen: false,
    borderless: false,
    vsync: true,
    samples: 0,
    transparent: false,
    always_on_top: false,
    decorated: true,
    visible: true,
    min_width: 0,
    min_height: 0,
    max_width: 0,
    max_height: 0
  }
end

# ———————————————————————————————————————————————————————————————
# Window Events
# ———————————————————————————————————————————————————————————————

pub enum WindowEvent
  # Window lifecycle
  when Created
  when Closed
  when Resized(width: u32, height: u32)
  when Moved(x: i32, y: i32)
  when Focused(focused: Bool)
  when Minimized(minimized: Bool)
  when Maximized(maximized: Bool)
  when Restored
  
  # Input events
  when KeyPressed(key: KeyCode, scancode: u32, mods: KeyMods)
  when KeyReleased(key: KeyCode, scancode: u32, mods: KeyMods)
  when KeyRepeated(key: KeyCode, scancode: u32, mods: KeyMods)
  when CharTyped(char: u32)  # Unicode codepoint
  
  when MouseMoved(x: f64, y: f64)
  when MouseEntered
  when MouseExited
  when MouseButtonPressed(button: MouseButton, mods: KeyMods)
  when MouseButtonReleased(button: MouseButton, mods: KeyMods)
  when MouseScrolled(dx: f64, dy: f64)
  
  when TouchStarted(id: u32, x: f64, y: f64)
  when TouchMoved(id: u32, x: f64, y: f64)
  when TouchEnded(id: u32, x: f64, y: f64)
  
  when GamepadConnected(id: u32, name: String)
  when GamepadDisconnected(id: u32)
  when GamepadButtonPressed(id: u32, button: GamepadButton)
  when GamepadButtonReleased(id: u32, button: GamepadButton)
  when GamepadAxisMoved(id: u32, axis: GamepadAxis, value: f32)
  
  # File events
  when FileDropped(paths: Vec[String])
  
  # Custom event
  when Custom(data: Ptr[u8])
end

# ———————————————————————————————————————————————————————————————
# Key Codes (matches GLFW/standard USB HID)
# ———————————————————————————————————————————————————————————————

pub enum KeyCode
  # Numbers
  when Num0, Num1, Num2, Num3, Num4
  when Num5, Num6, Num7, Num8, Num9
  
  # Letters
  when A, B, C, D, E, F, G, H, I, J, K, L, M
  when N, O, P, Q, R, S, T, U, V, W, X, Y, Z
  
  # Function keys
  when F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12
  when F13, F14, F15, F16, F17, F18, F19, F20, F21, F22, F23, F24, F25
  
  # Navigation
  when Up, Down, Left, Right
  when Home, End, PageUp, PageDown
  when Insert, Delete
  
  # Modifiers
  when LeftShift, RightShift
  when LeftCtrl, RightCtrl
  when LeftAlt, RightAlt
  when LeftSuper, RightSuper  # Windows/Command/Logo key
  
  # Symbols
  when Space, Tab, Enter, Escape, Backspace
  when Minus, Equal, LeftBracket, RightBracket
  when Backslash, Semicolon, Apostrophe, Comma, Period, Slash
  when Grave  # Backtick
  
  # Keypad
  when KP0, KP1, KP2, KP3, KP4, KP5, KP6, KP7, KP8, KP9
  when KPDecimal, KPDivide, KPMultiply, KPSubtract, KPAdd, KPEnter, KPEqual
  
  # Other
  when CapsLock, NumLock, ScrollLock, PrintScreen, Pause, Menu
  when Unknown(code: u32)
end

pub struct KeyMods
  shift: Bool
  ctrl: Bool
  alt: Bool
  super_: Bool
  caps_lock: Bool
  num_lock: Bool
end

pub def key_mods_none() -> KeyMods
  KeyMods { shift: false, ctrl: false, alt: false, super_: false, caps_lock: false, num_lock: false }
end

pub def key_mods_ctrl() -> KeyMods
  KeyMods { shift: false, ctrl: true, alt: false, super_: false, caps_lock: false, num_lock: false }
end

pub def key_mods_shift() -> KeyMods
  KeyMods { shift: true, ctrl: false, alt: false, super_: false, caps_lock: false, num_lock: false }
end

pub def key_mods_alt() -> KeyMods
  KeyMods { shift: false, ctrl: false, alt: true, super_: false, caps_lock: false, num_lock: false }
end

# ———————————————————————————————————————————————————————————————
# Mouse and Gamepad
# ———————————————————————————————————————————————————————————————

pub enum MouseButton
  when Left
  when Right
  when Middle
  when Button4
  when Button5
  when Button6
  when Button7
  when Button8
  when Unknown(id: u32)
end

pub enum GamepadButton
  when A, B, X, Y            # Face buttons (Sony: Cross, Circle, Square, Triangle)
  when LeftBumper, RightBumper
  when Back, Start, Guide    # Select, Menu, Home/Logo
  when LeftThumb, RightThumb
  when DPadUp, DPadDown, DPadLeft, DPadRight
end

pub enum GamepadAxis
  when LeftX, LeftY
  when RightX, RightY
  when LeftTrigger, RightTrigger
end

pub struct GamepadState
  connected: Bool
  name: String
  axes: Vec[f32]
  buttons: Vec[Bool]
end

# ———————————————————————————————————————————————————————————————
# Window Handle
# ———————————————————————————————————————————————————————————————

pub struct Window
  id: u64
  native_handle: Ptr[u8]
  config: WindowConfig
  should_close: Bool
  scale_factor: f64  # For HiDPI
end

impl Window
  # Get window size in pixels
  pub def size(self: Self) -> Vec2[u32]
    Vec2 { x: self.config.width, y: self.config.height }
  end
  
  # Get window size in screen coordinates (may differ on HiDPI)
  pub def framebuffer_size(self: Self) -> Vec2[u32]
    # On HiDPI displays, framebuffer size > window size
    Vec2 { 
      x: (self.config.width as f64 * self.scale_factor) as u32,
      y: (self.config.height as f64 * self.scale_factor) as u32
    }
  end
  
  # Get window position
  pub def position(self: Self) -> Vec2[i32]
    # Query native window for position
    unsafe "native window position query" do
      native_get_window_position(self.native_handle)
    end
  end
  
  # Set window title
  pub def set_title(inout self: Self, title: String) -> Unit
    self.config.title = title.clone()
    unsafe "native window set title" do
      native_set_window_title(self.native_handle, cstring_as_ptr(&cstring_new(title)))
    end
  end
  
  # Set window size
  pub def set_size(inout self: Self, width: u32, height: u32) -> Unit
    self.config.width = width
    self.config.height = height
    unsafe "native window set size" do
      native_set_window_size(self.native_handle, width, height)
    end
  end
  
  # Set window position
  pub def set_position(inout self: Self, x: i32, y: i32) -> Unit
    unsafe "native window set position" do
      native_set_window_position(self.native_handle, x, y)
    end
  end
  
  # Request window close
  pub fn close(inout self: Self) -> Unit
    self.should_close = true
  end
  
  # Check if window should close
  pub def should_close(self: Self) -> Bool
    self.should_close
  end
  
  # Minimize window
  pub def minimize(inout self: Self) -> Unit
    unsafe "native window minimize" do
      native_minimize_window(self.native_handle)
    end
  end
  
  # Maximize window
  pub def maximize(inout self: Self) -> Unit
    unsafe "native window maximize" do
      native_maximize_window(self.native_handle)
    end
  end
  
  # Restore window
  pub def restore(inout self: Self) -> Unit
    unsafe "native window restore" do
      native_restore_window(self.native_handle)
    end
  end
  
  # Set fullscreen mode
  pub def set_fullscreen(inout self: Self, fullscreen: Bool) -> Unit
    self.config.fullscreen = fullscreen
    unsafe "native window set fullscreen" do
      native_set_window_fullscreen(self.native_handle, fullscreen)
    end
  end
  
  # Get native handle for graphics API interop
  pub def native_handle(self: Self) -> Ptr[u8]
    self.native_handle
  end
  
  # Get scale factor for HiDPI
  pub def scale_factor(self: Self) -> f64
    self.scale_factor
  end
  
  # Request attention (flash taskbar, etc.)
  pub def request_attention(self: Self) -> Unit
    unsafe "native window request attention" do
      native_request_attention(self.native_handle)
    end
  end
  
  # Set cursor visibility
  pub def set_cursor_visible(self: Self, visible: Bool) -> Unit
    unsafe "native window set cursor visible" do
      native_set_cursor_visible(self.native_handle, visible)
    end
  end
  
  # Set cursor position (relative to window)
  pub def set_cursor_pos(self: Self, x: f64, y: f64) -> Unit
    unsafe "native window set cursor pos" do
      native_set_cursor_pos(self.native_handle, x, y)
    end
  end
  
  # Set cursor shape
  pub def set_cursor_shape(self: Self, shape: CursorShape) -> Unit
    unsafe "native window set cursor shape" do
      native_set_cursor_shape(self.native_handle, shape as i32)
    end
  end
end

pub enum CursorShape
  when Arrow
  when IBeam       # Text input
  when Crosshair
  when Hand        # Link/interactive
  when HResize     # Horizontal resize
  when VResize     # Vertical resize
  when ResizeAll   # All directions
  when NotAllowed  # Forbidden
  when Hidden
end

# ———————————————————————————————————————————————————————————————
# Event Loop
# ———————————————————————————————————————————————————————————————

pub struct EventLoop
  windows: Map[u64, Window]
  gamepads: Map[u32, GamepadState]
  running: Bool
  next_window_id: u64
end

impl EventLoop
  pub def new() -> EventLoop
    unsafe "native event loop init" do
      native_init_event_loop()
    end
    EventLoop {
      windows: Map::new(),
      gamepads: Map::new(),
      running: false,
      next_window_id: 1
    }
  end
  
  # Create a new window
  pub def create_window(inout self: Self, config: WindowConfig) -> Result[Window, String]
    let cs_title = cstring_new(config.title.clone())
    
    mut native_handle: Ptr[u8] = Ptr::null()
    mut scale_factor: f64 = 1.0
    
    unsafe "native window creation" do
      let result = native_create_window(
        cstring_as_ptr(&cs_title),
        config.width,
        config.height,
        config.resizable,
        config.fullscreen,
        config.borderless,
        config.transparent,
        config.decorated,
        config.visible
      )
      if result.status != 0 then
        return Result::Err("Failed to create window: " + result.error_message)
      end
      native_handle = result.handle
      scale_factor = result.scale_factor
    end
    
    let window = Window {
      id: self.next_window_id,
      native_handle: native_handle,
      config: config,
      should_close: false,
      scale_factor: scale_factor
    }
    
    self.next_window_id = self.next_window_id + 1
    self.windows.insert(window.id, window.clone())
    
    Result::Ok(window)
  end
  
  # Run the event loop
  pub def run(inout self: Self, callback: fn(inout Self, WindowEvent, inout Window) -> Unit) -> Unit
    self.running = true
    
    while self.running do
      # Poll for events
      unsafe "native event polling" do
        native_poll_events()
      end
      
      # Process events for each window
      for (id, window) in self.windows do
        if window.should_close then
          callback(self, WindowEvent::Closed, window)
          self.windows.remove(&id)
        else
          # Process pending events for this window
          unsafe "native get events" do
            let events = native_get_window_events(window.native_handle)
            for event in events do
              callback(self, event, window)
            end
          end
        end
      end
      
      # Check if all windows are closed
      if self.windows.is_empty() then
        self.running = false
      end
      
      # Yield to OS
      unsafe "native yield" do
        native_yield()
      end
    end
  end
  
  # Stop the event loop
  pub def stop(inout self: Self) -> Unit
    self.running = false
  end
  
  # Get gamepad state
  pub def gamepad_state(self: Self, id: u32) -> Option[GamepadState]
    self.gamepads.get(&id).cloned()
  end
end

# ———————————————————————————————————————————————————————————————
# Monitor Support
# ———————————————————————————————————————————————————————————————

pub struct Monitor
  id: u32
  name: String
  x: i32
  y: i32
  width: u32
  height: u32
  refresh_rate: u32
  scale_factor: f64
  primary: Bool
end

pub def get_monitors() -> Vec[Monitor]
  unsafe "native get monitors" do
    native_get_monitors()
  end
end

pub def get_primary_monitor() -> Option[Monitor]
  let monitors = get_monitors()
  for m in monitors do
    if m.primary then
      return Option::Some(m)
    end
  end
  Option::None
end

# ———————————————————————————————————————————————————————————————
# Native FFI declarations (platform-specific implementations)
# ———————————————————————————————————————————————————————————————

extern "C" do
  # Initialization
  def native_init_event_loop() -> Unit
  
  # Window management
  def native_create_window(
    title: Ptr[u8],
    width: u32,
    height: u32,
    resizable: Bool,
    fullscreen: Bool,
    borderless: Bool,
    transparent: Bool,
    decorated: Bool,
    visible: Bool
  ) -> NativeWindowResult
  
  def native_destroy_window(handle: Ptr[u8]) -> Unit
  def native_set_window_title(handle: Ptr[u8], title: Ptr[u8]) -> Unit
  def native_set_window_size(handle: Ptr[u8], width: u32, height: u32) -> Unit
  def native_set_window_position(handle: Ptr[u8], x: i32, y: i32) -> Unit
  def native_get_window_position(handle: Ptr[u8]) -> Vec2[i32]
  def native_minimize_window(handle: Ptr[u8]) -> Unit
  def native_maximize_window(handle: Ptr[u8]) -> Unit
  def native_restore_window(handle: Ptr[u8]) -> Unit
  def native_set_window_fullscreen(handle: Ptr[u8], fullscreen: Bool) -> Unit
  def native_request_attention(handle: Ptr[u8]) -> Unit
  def native_set_cursor_visible(handle: Ptr[u8], visible: Bool) -> Unit
  def native_set_cursor_pos(handle: Ptr[u8], x: f64, y: f64) -> Unit
  def native_set_cursor_shape(handle: Ptr[u8], shape: i32) -> Unit
  
  # Event handling
  def native_poll_events() -> Unit
  def native_get_window_events(handle: Ptr[u8]) -> Vec[WindowEvent]
  def native_yield() -> Unit
  
  # Monitor support
  def native_get_monitors() -> Vec[Monitor]
end

struct NativeWindowResult
  status: i32
  handle: Ptr[u8]
  scale_factor: f64
  error_message: Ptr[u8]
end

# ———————————————————————————————————————————————————————————————
# Clipboard Support
# ———————————————————————————————————————————————————————————————

pub def get_clipboard_text() -> Option[String]
  unsafe "native clipboard get" do
    let ptr = native_get_clipboard_text()
    if ptr.is_null() then
      Option::None
    else
      Option::Some(String::from_cstr(ptr))
    end
  end
end

pub def set_clipboard_text(text: String) -> Unit
  let cs = cstring_new(text)
  unsafe "native clipboard set" do
    native_set_clipboard_text(cstring_as_ptr(&cs))
  end
end

extern "C" do
  def native_get_clipboard_text() -> Ptr[u8]
  def native_set_clipboard_text(text: Ptr[u8]) -> Unit
end