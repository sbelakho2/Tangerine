## Tangerine Standard Library — std::window
## Native window creation and event loop management
## 
## Provides cross-platform window creation similar to GLFW/SDL:
## - Window creation with configurable properties
## - Event loop with keyboard/mouse/window events
## - OpenGL/Vulkan/Metal context creation
## - Multi-monitor support
## - High DPI handling

use std::collections::{Vec, Map}
use std::ffi::{Ptr, CString, cstring_new, cstring_as_ptr}
use std::core::{Option, Result}
use std::time::{Duration, Instant}
use std::geom::{Vec2, Vec4, Rect}

# ———————————————————————————————————————————————————————————————
# Window Configuration
# ———————————————————————————————————————————————————————————————

pub struct WindowConfig
  title: String
  width: u32
  height: u32
  resizable: Bool
  fullscreen: Bool
  borderless: Bool
  vsync: Bool
  samples: u32          # MSAA samples (0 = disabled)
  transparent: Bool
  always_on_top: Bool
  decorated: Bool
  visible: Bool
  min_width: u32
  min_height: u32
  max_width: u32
  max_height: u32
end

pub def window_config_default() -> WindowConfig
  WindowConfig {
    title: "Tangerine Window",
    width: 800,
    height: 600,
    resizable: true,
    fullscreen: false,
    borderless: false,
    vsync: true,
    samples: 0,
    transparent: false,
    always_on_top: false,
    decorated: true,
    visible: true,
    min_width: 0,
    min_height: 0,
    max_width: 0,
    max_height: 0
  }
end

# ———————————————————————————————————————————————————————————————
# Window Events
# ———————————————————————————————————————————————————————————————

pub enum WindowEvent
  # Window lifecycle
  Created
  Closed
  Resized(width: u32, height: u32)
  Moved(x: i32, y: i32)
  Focused(focused: Bool)
  Minimized(minimized: Bool)
  Maximized(maximized: Bool)
  Restored
  
  # Input events
  KeyPressed(key: KeyCode, scancode: u32, mods: KeyMods)
  KeyReleased(key: KeyCode, scancode: u32, mods: KeyMods)
  KeyRepeated(key: KeyCode, scancode: u32, mods: KeyMods)
  CharTyped(char: u32)  # Unicode codepoint
  
  MouseMoved(x: f64, y: f64)
  MouseEntered
  MouseExited
  MouseButtonPressed(button: MouseButton, mods: KeyMods)
  MouseButtonReleased(button: MouseButton, mods: KeyMods)
  MouseScrolled(dx: f64, dy: f64)
  
  TouchStarted(id: u32, x: f64, y: f64)
  TouchMoved(id: u32, x: f64, y: f64)
  TouchEnded(id: u32, x: f64, y: f64)
  
  GamepadConnected(id: u32, name: String)
  GamepadDisconnected(id: u32)
  GamepadButtonPressed(id: u32, button: GamepadButton)
  GamepadButtonReleased(id: u32, button: GamepadButton)
  GamepadAxisMoved(id: u32, axis: GamepadAxis, value: f32)
  
  # File events
  FileDropped(paths: Vec[String])
  
  # Custom event
  Custom(data: Ptr[u8])
end

