pub struct KeyMods
  shift: Bool
  ctrl: Bool
  alt: Bool
  super_: Bool
  caps_lock: Bool
  num_lock: Bool
end

pub def key_mods_none() -> KeyMods
  KeyMods { shift: false, ctrl: false, alt: false, super_: false, caps_lock: false, num_lock: false }
end

pub def key_mods_ctrl() -> KeyMods
  KeyMods { shift: false, ctrl: true, alt: false, super_: false, caps_lock: false, num_lock: false }
end

pub def key_mods_shift() -> KeyMods
  KeyMods { shift: true, ctrl: false, alt: false, super_: false, caps_lock: false, num_lock: false }
end

pub def key_mods_alt() -> KeyMods
  KeyMods { shift: false, ctrl: false, alt: true, super_: false, caps_lock: false, num_lock: false }
end

