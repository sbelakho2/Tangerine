# Tangerine Standard Library — std::budget
# Resource budget tracking and enforcement
#
# This module provides types and functions for tracking computational
# resources, enforcing budgets, and analyzing resource usage.

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map}

# ———————————————————————————————————————————————————————————————
# Core Types
# ———————————————————————————————————————————————————————————————

enum ResourceKind
  Time          # CPU time in milliseconds
  Memory        # Memory in bytes
  Iterations    # Loop iterations
  Calls         # Function call depth
  Allocations   # Heap allocations
  Custom(String)
end

struct Budget
  kind: ResourceKind
  limit: Int
  consumed: Int
  unit: String
end

struct BudgetViolation
  fn_name: String
  budget: Budget
  exceeded_by: Int
end

struct BudgetContext
  budgets: Map[String, Budget]
  call_stack: Vec[String]
  violations: Vec[BudgetViolation]
end

enum BudgetCheckResult
  WithinBudget
  Exceeded(Vec[BudgetViolation])
end

struct BudgetReport
  fn_name: String
  declared: Option[Budget]
  estimated: Budget
  status: String
end

# ———————————————————————————————————————————————————————————————
# Budget Creation
# ———————————————————————————————————————————————————————————————

def time_budget(limit_ms: Int) -> Budget
  Budget {
    kind: ResourceKind::Time,
    limit: limit_ms,
    consumed: 0,
    unit: "ms"
  }
end

def memory_budget(limit_bytes: Int) -> Budget
  Budget {
    kind: ResourceKind::Memory,
    limit: limit_bytes,
    consumed: 0,
    unit: "bytes"
  }
end

def iteration_budget(limit: Int) -> Budget
  Budget {
    kind: ResourceKind::Iterations,
    limit: limit,
    consumed: 0,
    unit: "iterations"
  }
end

def call_budget(limit: Int) -> Budget
  Budget {
    kind: ResourceKind::Calls,
    limit: limit,
    consumed: 0,
    unit: "calls"
  }
end

def allocation_budget(limit: Int) -> Budget
  Budget {
    kind: ResourceKind::Allocations,
    limit: limit,
    consumed: 0,
    unit: "allocations"
  }
end

def custom_budget(name: String, limit: Int, unit: String) -> Budget
  Budget {
    kind: ResourceKind::Custom(name),
    limit: limit,
    consumed: 0,
    unit: unit
  }
end

# ———————————————————————————————————————————————————————————————
# Budget Context Management
# ———————————————————————————————————————————————————————————————

def new_context() -> BudgetContext
  BudgetContext {
    budgets: Map::new(),
    call_stack: Vec::new(),
    violations: Vec::new()
  }
end

def set_budget(ctx: &mut BudgetContext, name: String, budget: Budget) -> Unit
  ctx.budgets.insert(name, budget)
end

def enter_function(ctx: &mut BudgetContext, fn_name: String) -> Unit
  ctx.call_stack.push(fn_name)
  
  # Check call depth budget
  match ctx.budgets.get("calls")
    Option::Some(budget) =>
      if ctx.call_stack.len() > budget.limit
        ctx.violations.push(BudgetViolation {
          fn_name: fn_name,
          budget: budget,
          exceeded_by: ctx.call_stack.len() - budget.limit
        })
      end
    Option::None => ()
  end
end

def exit_function(ctx: &mut BudgetContext) -> Unit
  ctx.call_stack.pop()
end

def consume(ctx: &mut BudgetContext, resource_name: String, amount: Int) -> Unit
  match ctx.budgets.get_mut(resource_name)
    Option::Some(budget) =>
      budget.consumed = budget.consumed + amount
      if budget.consumed > budget.limit
        let current_fn = ctx.call_stack.last().unwrap_or("unknown")
        ctx.violations.push(BudgetViolation {
          fn_name: current_fn,
          budget: budget.clone(),
          exceeded_by: budget.consumed - budget.limit
        })
      end
    Option::None => ()
  end
end

def check_budget(ctx: &BudgetContext) -> BudgetCheckResult
  if ctx.violations.is_empty()
    BudgetCheckResult::WithinBudget
  else
    BudgetCheckResult::Exceeded(ctx.violations.clone())
  end
end

# ———————————————————————————————————————————————————————————————
# Static Budget Analysis
# ———————————————————————————————————————————————————————————————

def extract_budget_annotations(source: String, fn_name: String) -> Option[Budget]
  let lines = source.lines()
  let in_function = false
  
  for line in lines
    let trimmed = line.trim()
    
    if trimmed.starts_with("def " + fn_name)
      in_function = true
    else if in_function && trimmed.starts_with("budget ")
      let rest = trimmed.slice(7, trimmed.len()).trim()
      return Option::Some(parse_budget_annotation(rest))
    else if in_function && !trimmed.starts_with("#") && !trimmed.starts_with("pre ") && 
            !trimmed.starts_with("post ") && !trimmed.starts_with("requires ") && trimmed.len() > 0
      # Body started, no budget annotation
      return Option::None
    end
  end
  
  Option::None
end

def parse_budget_annotation(annotation: String) -> Budget
  # Parse annotations like "time: 100ms" or "iterations: 1000"
  let colon_idx = annotation.find(":").unwrap_or(annotation.len())
  let kind_str = annotation.slice(0, colon_idx).trim()
  let value_str = annotation.slice(colon_idx + 1, annotation.len()).trim()
  
  let limit = parse_int(value_str.filter(|c| c.is_digit()))
  let unit = value_str.filter(|c| !c.is_digit()).trim()
  
  match kind_str
    "time" => Budget {
      kind: ResourceKind::Time,
      limit: limit,
      consumed: 0,
      unit: if unit.len() > 0 then unit else "ms" end
    }
    "memory" => Budget {
      kind: ResourceKind::Memory,
      limit: limit,
      consumed: 0,
      unit: if unit.len() > 0 then unit else "bytes" end
    }
    "iterations" => Budget {
      kind: ResourceKind::Iterations,
      limit: limit,
      consumed: 0,
      unit: "iterations"
    }
    "calls" => Budget {
      kind: ResourceKind::Calls,
      limit: limit,
      consumed: 0,
      unit: "calls"
    }
    _ => custom_budget(kind_str, limit, unit)
  end
end

def parse_int(s: String) -> Int
  let result = 0
  for c in s.chars()
    if c.is_digit()
      result = result * 10 + c.digit_value()
    end
  end
  result
end

def estimate_iterations(source: String, fn_name: String) -> Int
  let body = extract_function_body(source, fn_name)
  let lines = body.lines()
  let estimate = 0
  
  for line in lines
    let trimmed = line.trim()
    
    # Count loop constructs
    if trimmed.starts_with("for ") || trimmed.starts_with("while ")
      # Estimate based on common patterns
      if trimmed.contains("0..100") || trimmed.contains("range(100)")
        estimate = estimate + 100
      else if trimmed.contains("0..1000") || trimmed.contains("range(1000)")
        estimate = estimate + 1000
      else
        # Default estimate for unbounded loops
        estimate = estimate + 100
      end
    end
  end
  
  if estimate == 0 then 1 else estimate end
end

def extract_function_body(source: String, fn_name: String) -> String
  let lines = source.lines()
  let body = Vec::new()
  let in_function = false
  let depth = 0
  
  for line in lines
    let trimmed = line.trim()
    
    if trimmed.starts_with("def " + fn_name)
      in_function = true
      depth = 1
    else if in_function
      if trimmed == "end"
        depth = depth - 1
        if depth == 0
          in_function = false
        end
      else
        if trimmed.ends_with(" do") || trimmed.starts_with("if ") || 
           trimmed.starts_with("for ") || trimmed.starts_with("while ") ||
           trimmed.starts_with("match ")
          depth = depth + 1
        end
        body.push(line)
      end
    end
  end
  
  body.join("\n")
end

def estimate_complexity(source: String, fn_name: String) -> String
  let body = extract_function_body(source, fn_name)
  let loop_depth = 0
  let max_depth = 0
  
  for line in body.lines()
    let trimmed = line.trim()
    if trimmed.starts_with("for ") || trimmed.starts_with("while ")
      loop_depth = loop_depth + 1
      if loop_depth > max_depth
        max_depth = loop_depth
      end
    else if trimmed == "end"
      if loop_depth > 0
        loop_depth = loop_depth - 1
      end
    end
  end
  
  match max_depth
    0 => "O(1)"
    1 => "O(n)"
    2 => "O(n²)"
    3 => "O(n³)"
    _ => "O(n^" + max_depth.to_string() + ")"
  end
end

# ———————————————————————————————————————————————————————————————
# Budget Report Generation
# ———————————————————————————————————————————————————————————————

def generate_budget_report(source: String, fn_name: String) -> BudgetReport
  let declared = extract_budget_annotations(source, fn_name)
  let estimated_iters = estimate_iterations(source, fn_name)
  let complexity = estimate_complexity(source, fn_name)
  
  let estimated = iteration_budget(estimated_iters)
  
  let status = match declared
    Option::Some(d) =>
      if estimated_iters <= d.limit
        "✓ Within budget"
      else
        "✗ May exceed budget (estimated " + estimated_iters.to_string() + " > limit " + d.limit.to_string() + ")"
      end
    Option::None =>
      "? No budget declared (complexity: " + complexity + ")"
  end
  
  BudgetReport {
    fn_name: fn_name,
    declared: declared,
    estimated: estimated,
    status: status
  }
end

def generate_all_reports(source: String) -> Vec[BudgetReport]
  let reports = Vec::new()
  let fn_names = extract_function_names(source)
  
  for name in fn_names
    reports.push(generate_budget_report(source, name))
  end
  
  reports
end

def extract_function_names(source: String) -> Vec[String]
  let names = Vec::new()
  let lines = source.lines()
  
  for line in lines
    let trimmed = line.trim()
    if trimmed.starts_with("def ")
      let rest = trimmed.slice(4, trimmed.len())
      let paren_idx = rest.find("(").unwrap_or(rest.len())
      names.push(rest.slice(0, paren_idx))
    end
  end
  
  names
end

# ———————————————————————————————————————————————————————————————
# Pretty Printing
# ———————————————————————————————————————————————————————————————

def format_budget(b: Budget) -> String
  let kind_name = match b.kind
    ResourceKind::Time => "time"
    ResourceKind::Memory => "memory"
    ResourceKind::Iterations => "iterations"
    ResourceKind::Calls => "calls"
    ResourceKind::Allocations => "allocations"
    ResourceKind::Custom(name) => name
  end
  kind_name + ": " + b.consumed.to_string() + "/" + b.limit.to_string() + " " + b.unit
end

def format_violation(v: BudgetViolation) -> String
  v.fn_name + ": " + format_budget(v.budget) + " (exceeded by " + v.exceeded_by.to_string() + ")"
end

def format_report(r: BudgetReport) -> String
  let declared_str = match r.declared
    Option::Some(b) => format_budget(b)
    Option::None => "none declared"
  end
  r.fn_name + ": " + declared_str + " | " + r.status
end

def format_all_reports(reports: Vec[BudgetReport]) -> String
  let lines = Vec::new()
  lines.push("=== Budget Analysis Report ===")
  lines.push("")
  
  for r in reports
    lines.push(format_report(r))
  end
  
  lines.join("\n")
end

def format_check_result(r: BudgetCheckResult) -> String
  match r
    BudgetCheckResult::WithinBudget =>
      "✓ All operations within budget"
    BudgetCheckResult::Exceeded(violations) =>
      let lines = Vec::new()
      lines.push("✗ Budget violations:")
      for v in violations
        lines.push("  - " + format_violation(v))
      end
      lines.join("\n")
  end
end
