  dwY: DWORD
  dwXSize: DWORD
  dwYSize: DWORD
  dwXCountChars: DWORD
  dwYCountChars: DWORD
  dwFillAttribute: DWORD
  dwFlags: DWORD
  wShowWindow: WORD
  cbReserved2: WORD
  lpReserved2: &mut BYTE
  hStdInput: HANDLE
  hStdOutput: HANDLE
  hStdError: HANDLE
end

struct PROCESS_INFORMATION
  hProcess: HANDLE
  hThread: HANDLE
  dwProcessId: DWORD
  dwThreadId: DWORD
end

struct SYSTEMTIME
  wYear: WORD
  wMonth: WORD
  wDayOfWeek: WORD
  wDay: WORD
  wHour: WORD
  wMinute: WORD
  wSecond: WORD
  wMilliseconds: WORD
end

struct TIME_ZONE_INFORMATION
  Bias: LONG
  StandardName: [WCHAR; 32]
  StandardDate: SYSTEMTIME
  StandardBias: LONG
  DaylightName: [WCHAR; 32]
  DaylightDate: SYSTEMTIME
  DaylightBias: LONG
end

struct BLENDFUNCTION
  BlendOp: BYTE
  BlendFlags: BYTE
  SourceConstantAlpha: BYTE
  AlphaFormat: BYTE
end

# Type aliases
type ATOM = WORD
type COLORREF = DWORD
type LRESULT = LONG
type WPARAM = UINT
type LPARAM = LONG

# ═══════════════════════════════════════════════════════════════
# Message Box Types
# ═══════════════════════════════════════════════════════════════

def MB_OK() -> UINT = 0x00000000
def MB_OKCANCEL() -> UINT = 0x00000001
def MB_ABORTRETRYIGNORE() -> UINT = 0x00000002
def MB_YESNOCANCEL() -> UINT = 0x00000003
def MB_YESNO() -> UINT = 0x00000004
def MB_RETRYCANCEL() -> UINT = 0x00000005
def MB_CANCELTRYCONTINUE() -> UINT = 0x00000006
def MB_ICONHAND() -> UINT = 0x00000010
def MB_ICONQUESTION() -> UINT = 0x00000020
def MB_ICONEXCLAMATION() -> UINT = 0x00000030
def MB_ICONASTERISK() -> UINT = 0x00000040

# ═══════════════════════════════════════════════════════════════
# Window Styles
# ═══════════════════════════════════════════════════════════════

def WS_OVERLAPPED() -> DWORD = 0x00000000
def WS_POPUP() -> DWORD = 0x80000000
def WS_CHILD() -> DWORD = 0x40000000
def WS_MINIMIZE() -> DWORD = 0x20000000
def WS_VISIBLE() -> DWORD = 0x10000000
def WS_DISABLED() -> DWORD = 0x08000000
def WS_CLIPSIBLINGS() -> DWORD = 0x04000000
def WS_CLIPCHILDREN() -> DWORD = 0x02000000
def WS_MAXIMIZE() -> DWORD = 0x01000000
def WS_CAPTION() -> DWORD = 0x00C00000
def WS_BORDER() -> DWORD = 0x00800000
def WS_DLGFRAME() -> DWORD = 0x00400000
def WS_VSCROLL() -> DWORD = 0x00200000
def WS_HSCROLL() -> DWORD = 0x00100000
def WS_SYSMENU() -> DWORD = 0x00080000
def WS_THICKFRAME() -> DWORD = 0x00040000
def WS_GROUP() -> DWORD = 0x00020000
def WS_TABSTOP() -> DWORD = 0x00010000

def WS_MINIMIZEBOX() -> DWORD = 0x00020000
def WS_MAXIMIZEBOX() -> DWORD = 0x00010000

def WS_EX_TOPMOST() -> DWORD = 0x00000008
def WS_EX_TOOLWINDOW() -> DWORD = 0x00000080
def WS_EX_APPWINDOW() -> DWORD = 0x00040000
def WS_EX_WINDOWEDGE() -> DWORD = 0x00000100
def WS_EX_CLIENTEDGE() -> DWORD = 0x00000200

# ═══════════════════════════════════════════════════════════════
# Show Window Commands
# ═══════════════════════════════════════════════════════════════

def SW_HIDE() -> INT = 0
def SW_SHOWNORMAL() -> INT = 1
def SW_NORMAL() -> INT = 1
def SW_SHOWMINIMIZED() -> INT = 2
def SW_SHOWMAXIMIZED() -> INT = 3
def SW_MAXIMIZE() -> INT = 3
def SW_SHOWNOACTIVATE() -> INT = 4
def SW_SHOW() -> INT = 5
def SW_MINIMIZE() -> INT = 6
def SW_SHOWMINNOACTIVE() -> INT = 7
def SW_SHOWNA() -> INT = 8
def SW_RESTORE() -> INT = 9
def SW_SHOWDEFAULT() -> INT = 10
def SW_FORCEMINIMIZE() -> INT = 11

# ═══════════════════════════════════════════════════════════════
# High-Level Helpers
# ═══════════════════════════════════════════════════════════════

def message_box(text: &String, caption: &String) -> INT
  @cfg(target_os = "windows")
  {
    let wtext = to_wide_string(text)
    let wcaption = to_wide_string(caption)
    MessageBoxW(NULL(), wtext.as_ptr(), wcaption.as_ptr(), MB_OK())
  }
  
  @cfg(not(target_os = "windows"))
  0
end

def message_box_error(text: &String, caption: &String) -> INT
  @cfg(target_os = "windows")
  {
    let wtext = to_wide_string(text)
    let wcaption = to_wide_string(caption)
    MessageBoxW(NULL(), wtext.as_ptr(), wcaption.as_ptr(), MB_OK() | MB_ICONHAND())
  }
  
  @cfg(not(target_os = "windows"))
  0
end

def get_windows_version() -> String
  @cfg(target_os = "windows")
  "Windows"
  
  @cfg(not(target_os = "windows"))
  ""
end
