  lpszClassName: &WCHAR
end

struct STARTUPINFOA
  cb: DWORD
  lpReserved: &CHAR
  lpDesktop: &CHAR
  lpTitle: &CHAR
  dwX: DWORD
  dwY: DWORD
  dwXSize: DWORD
  dwYSize: DWORD
  dwXCountChars: DWORD
  dwYCountChars: DWORD
  dwFillAttribute: DWORD
  dwFlags: DWORD
  wShowWindow: WORD
  cbReserved2: WORD
  lpReserved2: &mut BYTE
