# The Win32 last-error wrapper (the fs/dynload gated helpers' error path).
# Its own @cfg gate covers its callers: the fs/dynload windows variants
# are the only callers, and they are eliminated on the other targets.
@cfg(target_os = "windows")
def get_last_error() -> UInt
  GetLastError()
end

