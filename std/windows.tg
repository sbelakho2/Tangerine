type BOOL = Int32
type INT = Int32
type UINT = UInt32
type LONG = Int32
type ULONG = UInt32
type LONGLONG = Int64
type ULONGLONG = UInt64
type FLOAT = Float
type DOUBLE = Float
type WCHAR = UInt16
type CHAR = Int8

# ═══════════════════════════════════════════════════════════════
# Common Windows Constants
# ═══════════════════════════════════════════════════════════════

def INVALID_HANDLE_VALUE() -> Ptr = Ptr::null()
def NULL() -> Ptr = Ptr::null()
def TRUE() -> Int32 = 1
def FALSE() -> Int32 = 0

def MAX_PATH() -> Int = 260
def MAXDWORD() -> UInt32 = 0xFFFFFFFF
def INFINITE() -> UInt32 = 0xFFFFFFFF

# ═══════════════════════════════════════════════════════════════
# Windows Handles
# ═══════════════════════════════════════════════════════════════

struct Handle
  value: Ptr
end

def Handle::invalid() -> Handle
  Handle { value: INVALID_HANDLE_VALUE() }
end

def Handle::is_valid(self: Handle) -> Bool
  self.value != NULL() && self.value != INVALID_HANDLE_VALUE()
end

# ═══════════════════════════════════════════════════════════════
# String Conversions
# ═══════════════════════════════════════════════════════════════

def to_wide_string(s: String) -> Vec[WCHAR]
  let mut result = Vec::new()
  for ch in s.chars() do
    result.push(ch as WCHAR)
  end
  result.push(0)
  result
end

def from_wide_string(ptr: WCHAR) -> String
  let mut result = String::new()
  let mut i = 0
  while ptr[i] != 0 do
    result.push(ptr[i] as Char)
    i = i + 1
  end
  result
end

