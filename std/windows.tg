# Tangerine Standard Library — std::windows
# Windows API bindings (Win32)
# Only available on Windows targets

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt, Ptr}
use std::collections::{Map}

# ═══════════════════════════════════════════════════════════════
# Windows Basic Types
# ═══════════════════════════════════════════════════════════════

type HANDLE = Ptr
type HWND = Ptr
