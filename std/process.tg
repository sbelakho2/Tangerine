# Tangerine Standard Library — tg::process
# Process Management and Subprocess Spawning

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt}
use std::fs::{OpenMode}

# [METADATA]
# module: tg::process
# status: stable
# effects: [Io, Process]
# capabilities: [ProcessControl]

# ═══════════════════════════════════════════════════════════════
# Process ID Types
# ═══════════════════════════════════════════════════════════════

typealias Pid = Int
typealias ExitCode = Int
typealias Signal = Int
typealias FileHandle = Int

# ═══════════════════════════════════════════════════════════════
# Standard File Descriptors
# ═══════════════════════════════════════════════════════════════

def STDIN_FD() -> Int = 0
def STDOUT_FD() -> Int = 1
def STDERR_FD() -> Int = 2

# ═══════════════════════════════════════════════════════════════
# FFI to libc for process operations
# ═══════════════════════════════════════════════════════════════

@ffi("c")
extern def fork() -> Pid
end

@ffi("c")
extern def execvp(path: &u8, argv: &&u8) -> Int
end

@ffi("c")
extern def execv(path: &u8, argv: &&u8) -> Int
end

@ffi("c")
extern def execve(path: &u8, argv: &&u8, envp: &&u8) -> Int
end

@ffi("c")
extern def waitpid(pid: Pid, status: &Int, options: Int) -> Pid
end

@ffi("c")
extern def wait(status: &Int) -> Pid
end

@ffi("c")
extern def getpid() -> Pid
end

@ffi("c")
extern def getppid() -> Pid
end

@ffi("c")
extern def kill(pid: Pid, sig: Int) -> Int
end

@ffi("c")
extern def raise(sig: Int) -> Int
end

@ffi("c")
extern def _exit(code: Int) -> Never
end

@ffi("c")
extern def exit(code: Int) -> Unit
end

@ffi("c")
extern def pipe(fds: &Int) -> Int
end

@ffi("c")
extern def dup(fd: Int) -> Int
end

@ffi("c")
extern def dup2(oldfd: Int, newfd: Int) -> Int
end

# Note: close, read, write are provided by std/fs.tg to avoid duplicate symbols
# These libc_ prefixed versions are for internal process module use only
@ffi("c")
extern def libc_close(fd: Int) -> Int
end

@ffi("c")
extern def libc_read(fd: Int, buf: &u8, count: UInt) -> Int
end

@ffi("c")
extern def libc_write(fd: Int, buf: &u8, count: UInt) -> Int
end

@ffi("c")
extern def getuid() -> UInt
end

@ffi("c")
extern def getgid() -> UInt
end

@ffi("c")
extern def geteuid() -> UInt
end

@ffi("c")
extern def getegid() -> UInt
end

@ffi("c")
extern def setuid(uid: UInt) -> Int
end

@ffi("c")
extern def setgid(gid: UInt) -> Int
end

@ffi("c")
extern def chdir(path: &u8) -> Int
end

@ffi("c")
extern def getcwd(buf: &u8, size: UInt) -> &u8
end

# ═══════════════════════════════════════════════════════════════
# Wait Options
# ═══════════════════════════════════════════════════════════════

def WNOHANG() -> Int = 1
def WUNTRACED() -> Int = 2
def WCONTINUED() -> Int = 8

# Macro implementations for wait status
def WIFEXITED(status: Int) -> Bool
  (status & 0x7F) == 0
end

def WEXITSTATUS(status: Int) -> ExitCode
  (status >> 8) & 0xFF
end

def WIFSIGNALED(status: Int) -> Bool
  ((status & 0x7F) != 0) && ((status & 0x7F) != 0x7F)
end

def WTERMSIG(status: Int) -> Signal
  status & 0x7F
end

def WIFSTOPPED(status: Int) -> Bool
  (status & 0xFF) == 0x7F
end

def WSTOPSIG(status: Int) -> Signal
  (status >> 8) & 0xFF
end

# ═══════════════════════════════════════════════════════════════
# Process Result
# ═══════════════════════════════════════════════════════════════

enum ProcessResult
  case Exited(code: ExitCode)
  case Signaled(sig: Signal)
  case Stopped(sig: Signal)
  case StillRunning
end

# ═══════════════════════════════════════════════════════════════
# Stdio Configuration for Child Process
# ═══════════════════════════════════════════════════════════════

enum Stdio
  case Inherit    # Inherit from parent
  case Null       # Redirect to /dev/null
  case Pipe       # Create a pipe
  case File(path: String, mode: OpenMode)
end

# ═══════════════════════════════════════════════════════════════
# Child Process Configuration
# ═══════════════════════════════════════════════════════════════

struct Command
  program: String
  args: Vec[String]
  env: Option[Vec[(String, String)]]
  cwd: Option[String]
  stdin: Stdio
  stdout: Stdio
  stderr: Stdio
end

def Command::new(program: String) -> Command
  Command {
    program: program,
    args: Vec::new(),
    env: Option::None,
    cwd: Option::None,
    stdin: Stdio::Inherit,
    stdout: Stdio::Inherit,
    stderr: Stdio::Inherit
  }
end

def Command::arg(self: Command, arg: String) -> Command
  var result = self
  var args_ref = result.args
  args_ref.push(arg)
  result.args = args_ref
  result
end

def Command::args_vec(self: Command, args: Vec[String]) -> Command
  var result = self
  for a in args do
    var args_vec_ref = result.args
    args_vec_ref.push(a)
    result.args = args_vec_ref
  end
  result
end

def Command::env(self: Command, key: String, value: String) -> Command
  var result = self
  match result.env
  when Option::Some(var env_vec) then
    env_vec.push((key, value))
    result.env = Option::Some(env_vec)
  when Option::None then
    var env_vec: Vec[(String, String)] = Vec::new()
    env_vec.push((key, value))
    result.env = Option::Some(env_vec)
  end
  result
end

def Command::env_clear(self: Command) -> Command
  var result = self
  result.env = Option::Some(Vec::new())
  result
end

def Command::current_dir(self: Command, dir: String) -> Command
  var result = self
  result.cwd = Option::Some(dir)
  result
end

def Command::stdin_inherit(self: Command) -> Command
  var result = self
  result.stdin = Stdio::Inherit
  result
end

def Command::stdin_null(self: Command) -> Command
  var result = self
  result.stdin = Stdio::Null
  result
end

def Command::stdin_pipe(self: Command) -> Command
  var result = self
  result.stdin = Stdio::Pipe
  result
end

def Command::stdout_inherit(self: Command) -> Command
  var result = self
  result.stdout = Stdio::Inherit
  result
end

def Command::stdout_null(self: Command) -> Command
  var result = self
  result.stdout = Stdio::Null
  result
end

def Command::stdout_pipe(self: Command) -> Command
  var result = self
  result.stdout = Stdio::Pipe
  result
end

def Command::stderr_inherit(self: Command) -> Command
  var result = self
  result.stderr = Stdio::Inherit
  result
end

def Command::stderr_null(self: Command) -> Command
  var result = self
  result.stderr = Stdio::Null
  result
end

def Command::stderr_pipe(self: Command) -> Command
  var result = self
  result.stderr = Stdio::Pipe
  result
end

def Command::stderr_to_stdout(self: Command) -> Command
  # Will be handled specially in spawn
  var result = self
  result.stderr = Stdio::Inherit  # Placeholder, actual merge happens in spawn
  result
end

# ═══════════════════════════════════════════════════════════════
# Child Process Handle
# ═══════════════════════════════════════════════════════════════

struct Child
  pid: Pid
  stdin: Option[FileHandle]
  stdout: Option[FileHandle]
  stderr: Option[FileHandle]
end

# ═══════════════════════════════════════════════════════════════
# Helper: String to C String
# ═══════════════════════════════════════════════════════════════

def to_c_string(s: String) -> Vec[u8]
  var bytes = s.bytes()
  bytes.push(0)
  bytes
end

def string_vec_to_argv(strings: Vec[String]) -> Vec[&u8]
  var argv: Vec[&u8] = Vec::with_capacity(strings.len() + 1)
  var c_strings: Vec[Vec[u8]] = Vec::with_capacity(strings.len())
  
  for s in strings do
    let c_str = to_c_string(s)
    c_strings.push(c_str)
  end
  
  var i = 0
  while i < c_strings.len() do
    argv.push(c_strings[i].as_ptr())
    i = i + 1
  end
  
  argv.push(0 as &u8)  # NULL terminator
  argv
end

# ═══════════════════════════════════════════════════════════════
# Spawn Implementation
# ═══════════════════════════════════════════════════════════════

def Command::spawn(self: Command) -> Result[Child, String]
  let program = self.program.clone()
  let args = self.args.clone()
  let env = self.env.clone()
  let cwd = self.cwd.clone()
  let stdin_cfg = self.stdin.clone()
  let stdout_cfg = self.stdout.clone()
  let stderr_cfg = self.stderr.clone()

  match env
  when Option::Some(_) then
    return Result::Err("Custom process environments are not supported yet".to_string())
  when Option::None then ()
  end

  match cwd
  when Option::Some(_) then
    return Result::Err("Custom process working directories are not supported yet".to_string())
  when Option::None then ()
  end

  match stdin_cfg
  when Stdio::File(_, _) then
    return Result::Err("File-backed stdin is not supported yet".to_string())
  when _ then ()
  end

  match stdout_cfg
  when Stdio::File(_, _) then
    return Result::Err("File-backed stdout is not supported yet".to_string())
  when _ then ()
  end

  match stderr_cfg
  when Stdio::File(_, _) then
    return Result::Err("File-backed stderr is not supported yet".to_string())
  when _ then ()
  end

  # Create pipes as needed
  var stdin_pipe_fds: Vec[Int] = Vec::with_capacity(2)
  var stdout_pipe_fds: Vec[Int] = Vec::with_capacity(2)
  var stderr_pipe_fds: Vec[Int] = Vec::with_capacity(2)
  
  # Setup stdin pipe
  match stdin_cfg
  when Stdio::Pipe then
    var fds: Vec[Int] = Vec::with_capacity(2)
    fds.resize(2, 0)
    if pipe(fds.as_mut_ptr()) != 0 then
      return Result::Err("Failed to create stdin pipe".to_string())
    end
    stdin_pipe_fds = fds
  else ()
  end
  
  # Setup stdout pipe
  match stdout_cfg
  when Stdio::Pipe then
    var fds: Vec[Int] = Vec::with_capacity(2)
    fds.resize(2, 0)
    if pipe(fds.as_mut_ptr()) != 0 then
      # Close stdin pipe if created
      if stdin_pipe_fds.len() == 2 then
        libc_close(stdin_pipe_fds[0])
        libc_close(stdin_pipe_fds[1])
      end
      return Result::Err("Failed to create stdout pipe".to_string())
    end
    stdout_pipe_fds = fds
  else ()
  end
  
  # Setup stderr pipe
  match stderr_cfg
  when Stdio::Pipe then
    var fds: Vec[Int] = Vec::with_capacity(2)
    fds.resize(2, 0)
    if pipe(fds.as_mut_ptr()) != 0 then
      # Close previously created pipes
      if stdin_pipe_fds.len() == 2 then
        libc_close(stdin_pipe_fds[0])
        libc_close(stdin_pipe_fds[1])
      end
      if stdout_pipe_fds.len() == 2 then
        libc_close(stdout_pipe_fds[0])
        libc_close(stdout_pipe_fds[1])
      end
      return Result::Err("Failed to create stderr pipe".to_string())
    end
    stderr_pipe_fds = fds
  else ()
  end
  
  # Fork
  let pid = fork()
  
  if pid < 0 then
    # Fork failed - close all pipes
    if stdin_pipe_fds.len() == 2 then
      libc_close(stdin_pipe_fds[0])
      libc_close(stdin_pipe_fds[1])
    end
    if stdout_pipe_fds.len() == 2 then
      libc_close(stdout_pipe_fds[0])
      libc_close(stdout_pipe_fds[1])
    end
    if stderr_pipe_fds.len() == 2 then
      libc_close(stderr_pipe_fds[0])
      libc_close(stderr_pipe_fds[1])
    end
    return Result::Err("Failed to fork process".to_string())
  end
  
  if pid == 0 then
    # Child process
    
    # Handle stdin
    match stdin_cfg
    when Stdio::Inherit then ()
    when Stdio::Null then
      libc_close(STDIN_FD())
      let devnull_path = to_c_string("/dev/null".to_string())
      let devnull = libc_open(devnull_path.as_ptr(), 0)  # O_RDONLY = 0
      if devnull >= 0 then
        dup2(devnull, STDIN_FD())
        libc_close(devnull)
      end
    when Stdio::Pipe then
      libc_close(stdin_pipe_fds[1])  # Close write end
      dup2(stdin_pipe_fds[0], STDIN_FD())
      libc_close(stdin_pipe_fds[0])
    when Stdio::File(_, _) then
      _exit(127)
    end
    
    # Handle stdout
    match stdout_cfg
    when Stdio::Inherit then ()
    when Stdio::Null then
      libc_close(STDOUT_FD())
      let devnull_path = to_c_string("/dev/null".to_string())
      let devnull = libc_open(devnull_path.as_ptr(), 1)  # O_WRONLY = 1
      if devnull >= 0 then
        dup2(devnull, STDOUT_FD())
        libc_close(devnull)
      end
    when Stdio::Pipe then
      libc_close(stdout_pipe_fds[0])  # Close read end
      dup2(stdout_pipe_fds[1], STDOUT_FD())
      libc_close(stdout_pipe_fds[1])
    when Stdio::File(_, _) then
      _exit(127)
    end
    
    # Handle stderr
    match stderr_cfg
    when Stdio::Inherit then ()
    when Stdio::Null then
      libc_close(STDERR_FD())
      let devnull_path = to_c_string("/dev/null".to_string())
      let devnull = libc_open(devnull_path.as_ptr(), 1)
      if devnull >= 0 then
        dup2(devnull, STDERR_FD())
        libc_close(devnull)
      end
    when Stdio::Pipe then
      libc_close(stderr_pipe_fds[0])  # Close read end
      dup2(stderr_pipe_fds[1], STDERR_FD())
      libc_close(stderr_pipe_fds[1])
    when Stdio::File(_, _) then
      _exit(127)
    end
    
    # Build argv
    var full_args: Vec[String] = Vec::with_capacity(args.len() + 1)
    full_args.push(program.clone())
    for a in args do
      full_args.push(a.clone())
    end
    
    let argv_ptrs = string_vec_to_argv(full_args)
    let program_cstr = to_c_string(program.clone())
    
    # Execute
    execvp(program_cstr.as_ptr(), argv_ptrs.as_ptr())
    
    # If exec returns, it failed
    _exit(127)
  else
    # Parent process
    var child = Child {
      pid: pid,
      stdin: Option::None,
      stdout: Option::None,
      stderr: Option::None
    }
    
    # Close appropriate pipe ends and save handles
    if stdin_pipe_fds.len() == 2 then
      libc_close(stdin_pipe_fds[0])  # Close read end
      child.stdin = Option::Some(stdin_pipe_fds[1])
    end
    
    if stdout_pipe_fds.len() == 2 then
      libc_close(stdout_pipe_fds[1])  # Close write end
      child.stdout = Option::Some(stdout_pipe_fds[0])
    end
    
    if stderr_pipe_fds.len() == 2 then
      libc_close(stderr_pipe_fds[1])  # Close write end
      child.stderr = Option::Some(stderr_pipe_fds[0])
    end
    
    Result::Ok(child)
  end
end

# ═══════════════════════════════════════════════════════════════
# Process Status
# ═══════════════════════════════════════════════════════════════

def Child::wait(self: Child) -> Result[ProcessResult, String]
  var status: Int = 0
  let result = waitpid(self.pid, &status, 0)
  
  if result < 0 then
    return Result::Err("Failed to wait for process".to_string())
  end
  
  if WIFEXITED(status) then
    Result::Ok(ProcessResult::Exited(WEXITSTATUS(status)))
  elsif WIFSIGNALED(status) then
    Result::Ok(ProcessResult::Signaled(WTERMSIG(status)))
  elsif WIFSTOPPED(status) then
    Result::Ok(ProcessResult::Stopped(WSTOPSIG(status)))
  else
    Result::Ok(ProcessResult::Exited(-1))
  end
end

def Child::try_wait(self: Child) -> Result[Option[ProcessResult], String]
  var status: Int = 0
  let result = waitpid(self.pid, &status, WNOHANG())
  
  if result < 0 then
    return Result::Err("Failed to check process status".to_string())
  end
  
  if result == 0 then
    return Result::Ok(Option::None)  # Still running
  end
  
  if WIFEXITED(status) then
    Result::Ok(Option::Some(ProcessResult::Exited(WEXITSTATUS(status))))
  elsif WIFSIGNALED(status) then
    Result::Ok(Option::Some(ProcessResult::Signaled(WTERMSIG(status))))
  elsif WIFSTOPPED(status) then
    Result::Ok(Option::Some(ProcessResult::Stopped(WSTOPSIG(status))))
  else
    Result::Ok(Option::Some(ProcessResult::Exited(-1)))
  end
end

def Child::kill(self: Child) -> Result[Unit, String]
  let result = kill(self.pid, 15)  # SIGTERM
  if result < 0 then
    Result::Err("Failed to kill process".to_string())
  else
    Result::Ok(())
  end
end

def Child::kill_signal(self: Child, sig: Signal) -> Result[Unit, String]
  let result = kill(self.pid, sig)
  if result < 0 then
    Result::Err("Failed to send signal to process".to_string())
  else
    Result::Ok(())
  end
end

def Child::pid(self: Child) -> Pid
  self.pid
end

# ═══════════════════════════════════════════════════════════════
# Convenience Functions
# ═══════════════════════════════════════════════════════════════

def Command::status(self: Command) -> Result[ExitCode, String]
  match self.spawn()
  when Result::Ok(child) then
    match child.wait()
    when Result::Ok(ProcessResult::Exited(code)) then Result::Ok(code)
    when Result::Ok(ProcessResult::Signaled(sig)) then Result::Ok(128 + sig)
    when Result::Ok(ProcessResult::Stopped(sig)) then Result::Ok(128 + sig)
    when Result::Ok(ProcessResult::StillRunning) then Result::Err("Process still running".to_string())
    when Result::Err(e) then Result::Err(e)
    end
  when Result::Err(e) then Result::Err(e)
  end
end

def Command::output(self: Command) -> Result[ProcessOutput, String]
  var cmd = self
  cmd.stdout = Stdio::Pipe
  cmd.stderr = Stdio::Pipe
  cmd.stdin = Stdio::Null
  
  match cmd.spawn()
  when Result::Ok(child) then
    var stdout_bytes: Vec[u8] = Vec::new()
    var stderr_bytes: Vec[u8] = Vec::new()
    
    # Read stdout
    match child.stdout
    when Option::Some(fd) then
      var buf: Vec[u8] = Vec::with_capacity(4096)
      buf.resize(4096, 0)
      loop do
        let n = libc_read(fd, buf.as_mut_ptr(), 4096)
        if n <= 0 then break end
        var i = 0
        while i < n do
          stdout_bytes.push(buf[i])
          i = i + 1
        end
      end
      libc_close(fd)
    when Option::None then ()
    end
    
    # Read stderr
    match child.stderr
    when Option::Some(fd) then
      var buf: Vec[u8] = Vec::with_capacity(4096)
      buf.resize(4096, 0)
      loop do
        let n = libc_read(fd, buf.as_mut_ptr(), 4096)
        if n <= 0 then break end
        var i = 0
        while i < n do
          stderr_bytes.push(buf[i])
          i = i + 1
        end
      end
      libc_close(fd)
    when Option::None then ()
    end
    
    # Wait for process
    let exit_code = match child.wait()
    when Result::Ok(ProcessResult::Exited(code)) then code
    when Result::Ok(ProcessResult::Signaled(sig)) then 128 + sig
    when Result::Ok(_) then -1
    when Result::Err(_) then -1
    end
    
    Result::Ok(ProcessOutput {
      status: exit_code,
      stdout: stdout_bytes,
      stderr: stderr_bytes
    })
  when Result::Err(e) then Result::Err(e)
  end
end

# ═══════════════════════════════════════════════════════════════
# Process Output
# ═══════════════════════════════════════════════════════════════

struct ProcessOutput
  status: ExitCode
  stdout: Vec[u8]
  stderr: Vec[u8]
end

def ProcessOutput::success(self: ProcessOutput) -> Bool
  self.status == 0
end

def ProcessOutput::stdout_string(self: ProcessOutput) -> String
  String::from_utf8(self.stdout)
end

def ProcessOutput::stderr_string(self: ProcessOutput) -> String
  String::from_utf8(self.stderr)
end

# ═══════════════════════════════════════════════════════════════
# Current Process Functions
# ═══════════════════════════════════════════════════════════════

def id() -> Pid
  getpid()
end

def parent_id() -> Pid
  getppid()
end

def exit(code: ExitCode) -> Unit
  exit(code)
end

def abort() -> Unit
  raise(6)  # SIGABRT
end

# ═══════════════════════════════════════════════════════════════
# User/Group IDs
# ═══════════════════════════════════════════════════════════════

def uid() -> UInt
  getuid()
end

def gid() -> UInt
  getgid()
end

def euid() -> UInt
  geteuid()
end

def egid() -> UInt
  getegid()
end

def set_uid(uid: UInt) -> Result[Unit, String]
  if setuid(uid) == 0 then
    Result::Ok(())
  else
    Result::Err("Failed to set uid".to_string())
  end
end

def set_gid(gid: UInt) -> Result[Unit, String]
  if setgid(gid) == 0 then
    Result::Ok(())
  else
    Result::Err("Failed to set gid".to_string())
  end
end

# ═══════════════════════════════════════════════════════════════
# Working Directory
# ═══════════════════════════════════════════════════════════════

def current_dir() -> Result[String, String]
  var buf: Vec[u8] = Vec::with_capacity(4096)
  buf.resize(4096, 0)
  
  let result = getcwd(buf.as_mut_ptr(), 4096)
  if result.is_null() then
    Result::Err("Failed to get current directory".to_string())
  else
    var len = 0
    while len < buf.len() && buf[len] != 0 do
      len = len + 1
    end
    buf.truncate(len)
    Result::Ok(String::from_utf8(buf))
  end
end

def set_current_dir(path: String) -> Result[Unit, String]
  let c_path = to_c_string(path)
  if chdir(c_path.as_ptr()) == 0 then
    Result::Ok(())
  else
    Result::Err("Failed to change directory".to_string())
  end
end

# ═══════════════════════════════════════════════════════════════
# Wait for Any Child
# ═══════════════════════════════════════════════════════════════

def wait_any() -> Result[(Pid, ProcessResult), String]
  var status: Int = 0
  let pid = wait(&status)
  
  if pid < 0 then
    return Result::Err("Failed to wait for child".to_string())
  end
  
  if WIFEXITED(status) then
    Result::Ok((pid, ProcessResult::Exited(WEXITSTATUS(status))))
  elsif WIFSIGNALED(status) then
    Result::Ok((pid, ProcessResult::Signaled(WTERMSIG(status))))
  elsif WIFSTOPPED(status) then
    Result::Ok((pid, ProcessResult::Stopped(WSTOPSIG(status))))
  else
    Result::Ok((pid, ProcessResult::Exited(-1)))
  end
end

def wait_pid(pid: Pid) -> Result[ProcessResult, String]
  var status: Int = 0
  let result = waitpid(pid, &status, 0)
  
  if result < 0 then
    return Result::Err("Failed to wait for process".to_string())
  end
  
  if WIFEXITED(status) then
    Result::Ok(ProcessResult::Exited(WEXITSTATUS(status)))
  elsif WIFSIGNALED(status) then
    Result::Ok(ProcessResult::Signaled(WTERMSIG(status)))
  elsif WIFSTOPPED(status) then
    Result::Ok(ProcessResult::Stopped(WSTOPSIG(status)))
  else
    Result::Ok(ProcessResult::Exited(-1))
  end
end

# Note: open is provided by std/fs.tg to avoid duplicate symbols
# This libc_open is for internal process module use only
@ffi("c")
extern def libc_open(path: &u8, flags: Int) -> Int
end

# Convenience wrapper: run a command, capture stdout, return Result
def run_command(program: String, args: Vec[String]) -> Result[String, String]
  let cmd = Command::new(program).args_vec(args)
  match cmd.output()
  when Result::Ok(output) then
    if output.status == 0 then
      Result::Ok(output.stdout_string())
    else
      Result::Err(output.stderr_string())
    end
  when Result::Err(e) then Result::Err(e)
  end
end