# Tangerine Standard Library — std::process
# Process spawning and execution helpers (v0.1 minimal surface)

use std::core::{Option, Result, Vec, String, Bool, Int, panic}
use std::env
use std::fs

extern "C"
  def system(cmd: Ptr[u8]) -> Int
  def getpid() -> Int
  def waitpid(pid: Int, status: Ptr[Int], options: Int) -> Int
  def kill(pid: Int, sig: Int) -> Int
end

def WNOHANG() -> Int = 1
def SIGTERM() -> Int = 15

struct ExitStatus
  code: Int
  success: Bool
end

struct Command
  program: String
  args: Vec[String]
  cwd: Option[String]
  env_overrides: Vec[(String, String)]
end

struct Output
  status: ExitStatus
  stdout: String
  stderr: String
end

impl Command
  def new(program: String) -> Self
    Command {
      program: program,
      args: Vec::new(),
      cwd: Option::None,
      env_overrides: Vec::new(),
    }
  end

  def arg(self: &mut Self, value: String) -> &mut Self
    self.args.push(value)
    self
  end

  def args(self: &mut Self, values: Vec[String]) -> &mut Self
    for v in values do
      self.args.push(v)
    end
    self
  end

  def current_dir(self: &mut Self, dir: String) -> &mut Self
    self.cwd = Option::Some(dir)
    self
  end

  def env(self: &mut Self, key: String, value: String) -> &mut Self
    if !is_valid_env_key(&key) then
      panic("Command::env: invalid environment variable name")
    end
    self.env_overrides.push((key, value))
    self
  end

  def status(self: &Self) -> Result[ExitStatus, String]
    let cmd = build_shell_command(self)
    let rc = unsafe "FFI boundary" do system(cmd.to_cstring().as_ptr()) end
    let code = if rc >= 0 then rc / 256 else rc end
    Result::Ok(ExitStatus { code: code, success: code == 0 })
  end

  def output(self: &Self) -> Result[Output, String]
    let pid = unsafe "FFI boundary" do getpid() end
    let base = "/tmp/tg_process_" + pid.to_string() + "_" + self.program.len().to_string() + "_" + self.args.len().to_string()
    let out_path = base.clone() + ".out"
    let err_path = base.clone() + ".err"

    let cmd = build_shell_command(self) + " 1>" + shell_quote(&out_path) + " 2>" + shell_quote(&err_path)
    let rc = unsafe "FFI boundary" do system(cmd.to_cstring().as_ptr()) end
    let code = if rc >= 0 then rc / 256 else rc end
    let status = ExitStatus { code: code, success: code == 0 }

    let stdout = match fs::read_to_string(out_path.clone())
    when Result::Ok(s) then s
    when Result::Err(_) then "".to_string()
    end

    let stderr = match fs::read_to_string(err_path.clone())
    when Result::Ok(s) then s
    when Result::Err(_) then "".to_string()
    end

    let _ = fs::remove_file(out_path)
    let _ = fs::remove_file(err_path)

    Result::Ok(Output {
      status: status,
      stdout: stdout,
      stderr: stderr,
    })
  end

  def spawn(self: &Self) -> Result[Child, String]
    let host_pid = unsafe "FFI boundary" do getpid() end
    let pid_path = "/tmp/tg_spawn_pid_" + host_pid.to_string() + "_" + self.program.len().to_string() + "_" + self.args.len().to_string()
    let inner = build_shell_command(self) + " >/dev/null 2>&1 & echo $! > " + shell_quote(&pid_path)
    let outer = "sh -c " + shell_quote(&inner)
    let rc = unsafe "FFI boundary" do system(outer.to_cstring().as_ptr()) end
    if rc < 0 then
      return Result::Err("failed to spawn process".to_string())
    end

    let child_pid = match fs::read_to_string(pid_path.clone())
    when Result::Ok(s) then s.trim().parse_int().unwrap_or(0)
    when Result::Err(_) then 0
    end

    let _ = fs::remove_file(pid_path)

    Result::Ok(Child {
      pid: child_pid,
      program: self.program.clone(),
      exited: false,
      status_code: Option::None,
    })
  end
end

struct Child
  pid: Int
  program: String
  exited: Bool
  status_code: Option[Int]
end

impl Child
  def id(self: &Self) -> Int
    self.pid
  end

  def try_wait(self: &Self) -> Option[ExitStatus]
    match self.status_code
    when Option::Some(code) then
      Option::Some(ExitStatus { code: code, success: code == 0 })
    when Option::None then
      if self.pid <= 0 then
        Option::None
      else
        let raw = 0
        let rc = unsafe "FFI boundary" do waitpid(self.pid, &raw, WNOHANG()) end
        if rc <= 0 then
          Option::None
        else
          let code = if raw >= 0 then raw / 256 else raw end
          Option::Some(ExitStatus { code: code, success: code == 0 })
        end
      end
    end
  end

  def wait(self: &mut Self) -> ExitStatus
    let code = match self.status_code
    when Option::Some(c) then c
    when Option::None then
      if self.pid > 0 then
        let raw = 0
        let rc = unsafe "FFI boundary" do waitpid(self.pid, &raw, 0) end
        if rc < 0 then 1 else if raw >= 0 then raw / 256 else raw end end
      else
        0
      end
    end
    self.exited = true
    self.status_code = Option::Some(code)
    ExitStatus { code: code, success: code == 0 }
  end

  def kill(self: &mut Self) -> Result[Unit, String]
    if self.pid > 0 then
      let rc = unsafe "FFI boundary" do kill(self.pid, SIGTERM()) end
      if rc < 0 then
        return Result::Err("failed to send SIGTERM".to_string())
      end
    end
    self.exited = true
    self.status_code = Option::Some(143)
    Result::Ok(())
  end
end

def current_exe() -> Result[String, String]
  match env::exe_path()
  when Result::Ok(path) then Result::Ok(path)
  when Result::Err(e) then Result::Err(e)
  end
end

def shell_quote(s: &String) -> String
  "'" + s.replace("'", "'\"'\"'") + "'"
end

def build_shell_command(cmd: &Command) -> String
  let mut parts: Vec[String] = Vec::new()

  for (k, v) in &cmd.env_overrides do
    if !is_valid_env_key(k) then
      panic("build_shell_command: invalid environment variable name")
    end
    parts.push(k.clone() + "=" + shell_quote(v))
  end

  match cmd.cwd
  when Option::Some(dir) then
    parts.push("cd " + shell_quote(&dir) + " &&")
  when Option::None then ()
  end

  parts.push(shell_quote(&cmd.program))
  for a in &cmd.args do
    parts.push(shell_quote(a))
  end

  parts.join(" ")
end

def is_valid_env_key(key: &String) -> Bool
  if key.len() == 0 then
    return false
  end

  let first = key.char_at(0)
  if !((first >= 'A' && first <= 'Z') || (first >= 'a' && first <= 'z') || first == '_') then
    return false
  end

  let mut i = 1
  while i < key.len() do
    let c = key.char_at(i)
    if !((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') then
      return false
    end
    i = i + 1
  end

  true
end
