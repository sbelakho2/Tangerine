# Tangerine Standard Library — tg::mmap
# Memory-Mapped File Operations

use std::core::{Option, Result, String, Vec, Unit, Bool, Int, UInt}
use std::fs::File

# [METADATA]
# module: tg::mmap
# status: stable
# effects: [Io, Memory]
# capabilities: [MemoryMapping]

# ═══════════════════════════════════════════════════════════════
# mmap Protection Flags
# ═══════════════════════════════════════════════════════════════

def PROT_NONE() -> Int = 0
def PROT_READ() -> Int = 1
def PROT_WRITE() -> Int = 2
def PROT_EXEC() -> Int = 4

# ═══════════════════════════════════════════════════════════════
# mmap Flags
# ═══════════════════════════════════════════════════════════════

def MAP_SHARED() -> Int = 1
def MAP_PRIVATE() -> Int = 2
def MAP_FIXED() -> Int = 16
def MAP_ANONYMOUS() -> Int = 32
def MAP_ANON() -> Int = 32        # Alias for MAP_ANONYMOUS
def MAP_GROWSDOWN() -> Int = 256
def MAP_DENYWRITE() -> Int = 2048
def MAP_EXECUTABLE() -> Int = 4096
def MAP_LOCKED() -> Int = 8192
def MAP_NORESERVE() -> Int = 16384
def MAP_POPULATE() -> Int = 32768
def MAP_NONBLOCK() -> Int = 65536
def MAP_STACK() -> Int = 131072
def MAP_HUGETLB() -> Int = 262144

# macOS specific
def MAP_JIT() -> Int = 0x800

# ═══════════════════════════════════════════════════════════════
# msync Flags
# ═══════════════════════════════════════════════════════════════

def MS_ASYNC() -> Int = 1
def MS_SYNC() -> Int = 4
def MS_INVALIDATE() -> Int = 2

# ═══════════════════════════════════════════════════════════════
# madvise Flags
# ═══════════════════════════════════════════════════════════════

def MADV_NORMAL() -> Int = 0
def MADV_RANDOM() -> Int = 1
def MADV_SEQUENTIAL() -> Int = 2
def MADV_WILLNEED() -> Int = 3
def MADV_DONTNEED() -> Int = 4
def MADV_FREE() -> Int = 8
def MADV_REMOVE() -> Int = 9
def MADV_DONTFORK() -> Int = 10
def MADV_DOFORK() -> Int = 11
def MADV_MERGEABLE() -> Int = 12
def MADV_UNMERGEABLE() -> Int = 13
def MADV_HUGEPAGE() -> Int = 14
def MADV_NOHUGEPAGE() -> Int = 15
def MADV_DONTDUMP() -> Int = 16
def MADV_DODUMP() -> Int = 17
def MADV_HWPOISON() -> Int = 100

# ═══════════════════════════════════════════════════════════════
# mlock/munlock Constants
# ═══════════════════════════════════════════════════════════════

def MCL_CURRENT() -> Int = 1
def MCL_FUTURE() -> Int = 2
def MCL_ONFAULT() -> Int = 4

# ═══════════════════════════════════════════════════════════════
# FFI to libc for mmap operations
# ═══════════════════════════════════════════════════════════════

@ffi("c")
extern def mmap(addr: &u8, length: UInt, prot: Int, flags: Int, fd: Int, offset: Int) -> &u8
end

@ffi("c")
extern def munmap(addr: &u8, length: UInt) -> Int
end

@ffi("c")
extern def msync(addr: &u8, length: UInt, flags: Int) -> Int
end

@ffi("c")
extern def madvise(addr: &u8, length: UInt, advice: Int) -> Int
end

@ffi("c")
extern def mprotect(addr: &u8, length: UInt, prot: Int) -> Int
end

@ffi("c")
extern def mlock(addr: &u8, length: UInt) -> Int
end

@ffi("c")
extern def munlock(addr: &u8, length: UInt) -> Int
end

@ffi("c")
extern def mlockall(flags: Int) -> Int
end

@ffi("c")
extern def munlockall() -> Int
end

@ffi("c")
extern def mincore(addr: &u8, length: UInt, vec: &u8) -> Int
end

@ffi("c")
extern def remap_file_pages(addr: &u8, size: UInt, prot: Int, pgoff: UInt, flags: Int) -> Int
end

# Page size - typically 4096, but we can query it
@ffi("c")
extern def sysconf(name: Int) -> Int
end

def _SC_PAGESIZE() -> Int = 30

# ═══════════════════════════════════════════════════════════════
# Page Size
# ═══════════════════════════════════════════════════════════════

mut _page_size_cache: Option[Int] = Option::None

def page_size() -> Int
  match _page_size_cache
  when Option::Some(size) then size
  when Option::None then
    let size = sysconf(_SC_PAGESIZE())
    _page_size_cache = Option::Some(size)
    size
  end
end

def page_align_up(size: Int) -> Int
  let ps = page_size()
  ((size + ps - 1) / ps) * ps
end

def page_align_down(size: Int) -> Int
  let ps = page_size()
  (size / ps) * ps
end

def is_page_aligned(ptr: &u8) -> Bool
  let ps = page_size()
  (ptr as Int) % ps == 0
end

# ═══════════════════════════════════════════════════════════════
# Memory Mapping Handle
# ═══════════════════════════════════════════════════════════════

struct Mmap
  ptr: &u8
  length: UInt
  prot: Int
  flags: Int
end

def Mmap::ptr(self: Mmap) -> &u8
  self.ptr
end

def Mmap::len(self: Mmap) -> UInt
  self.length
end

def Mmap::is_valid(self: Mmap) -> Bool
  self.ptr != (-1 as &u8) && self.ptr != 0 as &u8
end

def Mmap::as_slice(self: Mmap) -> &[u8]
  self.ptr as &[u8]
end

def Mmap::as_mut_slice(self: Mmap) -> &mut [u8]
  self.ptr as &mut [u8]
end

# ═══════════════════════════════════════════════════════════════
# Anonymous Memory Mapping
# ═══════════════════════════════════════════════════════════════

def anonymous_map(size: UInt, prot: Int) -> Result[Mmap, String]
  let aligned_size = page_align_up(size as Int) as UInt
  let ptr = mmap(0 as &u8, aligned_size, prot, MAP_PRIVATE() | MAP_ANONYMOUS(), -1, 0)
  
  if ptr == (-1 as &u8) then
    Result::Err("Failed to create anonymous mapping".to_string())
  else
    Result::Ok(Mmap { ptr: ptr, length: aligned_size, prot: prot, flags: MAP_PRIVATE() | MAP_ANONYMOUS() })
  end
end

def anonymous_map_read_write(size: UInt) -> Result[Mmap, String]
  anonymous_map(size, PROT_READ() | PROT_WRITE())
end

def anonymous_map_read_write_exec(size: UInt) -> Result[Mmap, String]
  anonymous_map(size, PROT_READ() | PROT_WRITE() | PROT_EXEC())
end

def anonymous_map_read_exec(size: UInt) -> Result[Mmap, String]
  anonymous_map(size, PROT_READ() | PROT_EXEC())
end

def anonymous_map_executable(size: UInt) -> Result[Mmap, String]
  # On macOS with hardened runtime, use MAP_JIT for executable memory
  let aligned_size = page_align_up(size as Int) as UInt
  let flags = MAP_PRIVATE() | MAP_ANONYMOUS() | MAP_JIT()
  let ptr = mmap(0 as &u8, aligned_size, PROT_READ() | PROT_WRITE() | PROT_EXEC(), flags, -1, 0)
  
  if ptr == (-1 as &u8) then
    Result::Err("Failed to create executable mapping".to_string())
  else
    Result::Ok(Mmap { ptr: ptr, length: aligned_size, prot: PROT_READ() | PROT_WRITE() | PROT_EXEC(), flags: flags })
  end
end

# ═══════════════════════════════════════════════════════════════
# File-Based Memory Mapping
# ═══════════════════════════════════════════════════════════════

def file_map(fd: Int, size: UInt, prot: Int, flags: Int, offset: Int) -> Result[Mmap, String]
  let aligned_size = page_align_up(size as Int) as UInt
  let ptr = mmap(0 as &u8, aligned_size, prot, flags, fd, offset)
  
  if ptr == (-1 as &u8) then
    Result::Err("Failed to map file".to_string())
  else
    Result::Ok(Mmap { ptr: ptr, length: aligned_size, prot: prot, flags: flags })
  end
end

def file_map_read(fd: Int, size: UInt, offset: Int) -> Result[Mmap, String]
  file_map(fd, size, PROT_READ(), MAP_PRIVATE(), offset)
end

def file_map_read_write(fd: Int, size: UInt, offset: Int) -> Result[Mmap, String]
  file_map(fd, size, PROT_READ() | PROT_WRITE(), MAP_SHARED(), offset)
end

def file_map_copy_on_write(fd: Int, size: UInt, offset: Int) -> Result[Mmap, String]
  file_map(fd, size, PROT_READ() | PROT_WRITE(), MAP_PRIVATE(), offset)
end

def file_map_shared(fd: Int, size: UInt, offset: Int) -> Result[Mmap, String]
  file_map(fd, size, PROT_READ() | PROT_WRITE(), MAP_SHARED(), offset)
end

# ═══════════════════════════════════════════════════════════════
# Unmapping
# ═══════════════════════════════════════════════════════════════

def Mmap::unmap(self: Mmap) -> Result[Unit, String]
  if self.is_valid() then
    let result = munmap(self.ptr, self.length)
    if result != 0 then
      Result::Err("Failed to unmap memory".to_string())
    else
      Result::Ok(())
    end
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Synchronization
# ═══════════════════════════════════════════════════════════════

def Mmap::sync(self: Mmap) -> Result[Unit, String]
  self.sync_flags(MS_SYNC())
end

def Mmap::sync_async(self: Mmap) -> Result[Unit, String]
  self.sync_flags(MS_ASYNC())
end

def Mmap::sync_flags(self: Mmap, flags: Int) -> Result[Unit, String]
  if !self.is_valid() then
    return Result::Err("Invalid mapping".to_string())
  end
  
  let result = msync(self.ptr, self.length, flags)
  if result != 0 then
    Result::Err("Failed to sync mapping".to_string())
  else
    Result::Ok(())
  end
end

def Mmap::sync_invalidate(self: Mmap) -> Result[Unit, String]
  self.sync_flags(MS_SYNC() | MS_INVALIDATE())
end

# ═══════════════════════════════════════════════════════════════
# Protection Changes
# ═══════════════════════════════════════════════════════════════

def Mmap::protect(self: Mmap, prot: Int) -> Result[Unit, String]
  if !self.is_valid() then
    return Result::Err("Invalid mapping".to_string())
  end
  
  let result = mprotect(self.ptr, self.length, prot)
  if result != 0 then
    Result::Err("Failed to change protection".to_string())
  else
    Result::Ok(())
  end
end

def Mmap::make_read_only(self: Mmap) -> Result[Unit, String]
  self.protect(PROT_READ())
end

def Mmap::make_read_write(self: Mmap) -> Result[Unit, String]
  self.protect(PROT_READ() | PROT_WRITE())
end

def Mmap::make_read_write_exec(self: Mmap) -> Result[Unit, String]
  self.protect(PROT_READ() | PROT_WRITE() | PROT_EXEC())
end

def Mmap::make_none(self: Mmap) -> Result[Unit, String]
  self.protect(PROT_NONE())
end

# ═══════════════════════════════════════════════════════════════
# Locking (prevent swapping)
# ═══════════════════════════════════════════════════════════════

def Mmap::lock(self: Mmap) -> Result[Unit, String]
  if !self.is_valid() then
    return Result::Err("Invalid mapping".to_string())
  end
  
  let result = mlock(self.ptr, self.length)
  if result != 0 then
    Result::Err("Failed to lock memory".to_string())
  else
    Result::Ok(())
  end
end

def Mmap::unlock(self: Mmap) -> Result[Unit, String]
  if !self.is_valid() then
    return Result::Err("Invalid mapping".to_string())
  end
  
  let result = munlock(self.ptr, self.length)
  if result != 0 then
    Result::Err("Failed to unlock memory".to_string())
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Advice
# ═══════════════════════════════════════════════════════════════

def Mmap::advise(self: Mmap, advice: Int) -> Result[Unit, String]
  if !self.is_valid() then
    return Result::Err("Invalid mapping".to_string())
  end
  
  let result = madvise(self.ptr, self.length, advice)
  if result != 0 then
    Result::Err("Failed to advise mapping".to_string())
  else
    Result::Ok(())
  end
end

def Mmap::advise_sequential(self: Mmap) -> Result[Unit, String]
  self.advise(MADV_SEQUENTIAL())
end

def Mmap::advise_random(self: Mmap) -> Result[Unit, String]
  self.advise(MADV_RANDOM())
end

def Mmap::advise_will_need(self: Mmap) -> Result[Unit, String]
  self.advise(MADV_WILLNEED())
end

def Mmap::advise_dont_need(self: Mmap) -> Result[Unit, String]
  self.advise(MADV_DONTNEED())
end

def Mmap::advise_normal(self: Mmap) -> Result[Unit, String]
  self.advise(MADV_NORMAL())
end

def Mmap::advise_free(self: Mmap) -> Result[Unit, String]
  self.advise(MADV_FREE())
end

def Mmap::advise_hugepage(self: Mmap) -> Result[Unit, String]
  self.advise(MADV_HUGEPAGE())
end

def Mmap::advise_no_hugepage(self: Mmap) -> Result[Unit, String]
  self.advise(MADV_NOHUGEPAGE())
end

# ═══════════════════════════════════════════════════════════════
# Memory Access
# ═══════════════════════════════════════════════════════════════

def Mmap::read_byte(self: Mmap, offset: UInt) -> Result[u8, String]
  if offset >= self.length then
    return Result::Err("Offset out of bounds".to_string())
  end
  Result::Ok(self.ptr.offset(offset as Int).read())
end

def Mmap::write_byte(self: Mmap, offset: UInt, value: u8) -> Result[Unit, String]
  if offset >= self.length then
    return Result::Err("Offset out of bounds".to_string())
  end
  
  if (self.prot & PROT_WRITE()) == 0 then
    return Result::Err("Mapping is not writable".to_string())
  end
  
  self.ptr.offset(offset as Int).write(value)
  Result::Ok(())
end

def Mmap::read_slice(self: Mmap, offset: UInt, len: UInt) -> Result[Vec[u8], String]
  if offset + len > self.length then
    return Result::Err("Read range out of bounds".to_string())
  end
  
  mut result: Vec[u8] = Vec::with_capacity(len as Int)
  mut i = 0
  while i < len do
    result.push(self.ptr.offset((offset + i) as Int).read())
    i = i + 1
  end
  
  Result::Ok(result)
end

def Mmap::write_slice(self: Mmap, offset: UInt, data: Vec[u8]) -> Result[Unit, String]
  if offset + data.len() as UInt > self.length then
    return Result::Err("Write range out of bounds".to_string())
  end
  
  if (self.prot & PROT_WRITE()) == 0 then
    return Result::Err("Mapping is not writable".to_string())
  end
  
  mut i = 0
  while i < data.len() do
    self.ptr.offset((offset + i as UInt) as Int).write(data[i])
    i = i + 1
  end
  
  Result::Ok(())
end

def Mmap::copy_to(self: Mmap, dest: &mut u8, len: UInt) -> Result[Unit, String]
  if len > self.length then
    return Result::Err("Copy length exceeds mapping size".to_string())
  end
  
  mut i = 0
  while i < len do
    dest.offset(i as Int).write(self.ptr.offset(i as Int).read())
    i = i + 1
  end
  
  Result::Ok(())
end

def Mmap::copy_from(self: Mmap, src: &u8, len: UInt) -> Result[Unit, String]
  if len > self.length then
    return Result::Err("Copy length exceeds mapping size".to_string())
  end
  
  if (self.prot & PROT_WRITE()) == 0 then
    return Result::Err("Mapping is not writable".to_string())
  end
  
  mut i = 0
  while i < len do
    self.ptr.offset(i as Int).write(src.offset(i as Int).read())
    i = i + 1
  end
  
  Result::Ok(())
end

# ═══════════════════════════════════════════════════════════════
# Check Residency (which pages are in memory)
# ═══════════════════════════════════════════════════════════════

def Mmap::check_residency(self: Mmap) -> Result[Vec[Bool], String]
  if !self.is_valid() then
    return Result::Err("Invalid mapping".to_string())
  end
  
  let ps = page_size()
  let num_pages = (self.length as Int + ps - 1) / ps
  
  mut vec: Vec[u8] = Vec::with_capacity(num_pages)
  vec.resize(num_pages, 0)
  
  let result = mincore(self.ptr, self.length, vec.as_mut_ptr())
  if result != 0 then
    return Result::Err("Failed to check residency".to_string())
  end
  
  mut bools: Vec[Bool] = Vec::with_capacity(num_pages)
  for i in 0..num_pages do
    # Least significant bit indicates residency
    bools.push((vec[i] & 1) != 0)
  end
  
  Result::Ok(bools)
end

# ═══════════════════════════════════════════════════════════════
# Global Memory Locking
# ═══════════════════════════════════════════════════════════════

def lock_all_current() -> Result[Unit, String]
  let result = mlockall(MCL_CURRENT())
  if result != 0 then
    Result::Err("Failed to lock all current memory".to_string())
  else
    Result::Ok(())
  end
end

def lock_all_future() -> Result[Unit, String]
  let result = mlockall(MCL_FUTURE())
  if result != 0 then
    Result::Err("Failed to lock all future memory".to_string())
  else
    Result::Ok(())
  end
end

def lock_all() -> Result[Unit, String]
  let result = mlockall(MCL_CURRENT() | MCL_FUTURE())
  if result != 0 then
    Result::Err("Failed to lock all memory".to_string())
  else
    Result::Ok(())
  end
end

def unlock_all() -> Result[Unit, String]
  let result = munlockall()
  if result != 0 then
    Result::Err("Failed to unlock all memory".to_string())
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Fixed Mapping (at specific address)
# ═══════════════════════════════════════════════════════════════

def map_fixed(addr: &u8, size: UInt, prot: Int, flags: Int) -> Result[Mmap, String]
  let aligned_size = page_align_up(size as Int) as UInt
  let ptr = mmap(addr, aligned_size, prot, flags | MAP_FIXED(), -1, 0)
  
  if ptr == (-1 as &u8) then
    Result::Err("Failed to create fixed mapping".to_string())
  else
    Result::Ok(Mmap { ptr: ptr, length: aligned_size, prot: prot, flags: flags | MAP_FIXED() })
  end
end

# ═══════════════════════════════════════════════════════════════
# Stack Allocation Helper
# ═══════════════════════════════════════════════════════════════

def allocate_stack(size: UInt) -> Result[Mmap, String]
  let aligned_size = page_align_up(size as Int) as UInt
  # MAP_STACK is a hint that this will be used for a stack
  # On some systems it also grows downward
  let ptr = mmap(0 as &u8, aligned_size, PROT_READ() | PROT_WRITE(), 
                 MAP_PRIVATE() | MAP_ANONYMOUS() | MAP_STACK(), -1, 0)
  
  if ptr == (-1 as &u8) then
    Result::Err("Failed to allocate stack".to_string())
  else
    Result::Ok(Mmap { ptr: ptr, length: aligned_size, prot: PROT_READ() | PROT_WRITE(), 
                      flags: MAP_PRIVATE() | MAP_ANONYMOUS() | MAP_STACK() })
  end
end

# ═══════════════════════════════════════════════════════════════
# Guard Page
# ═══════════════════════════════════════════════════════════════

def create_guard_page() -> Result[Mmap, String]
  let ps = page_size()
  let ptr = mmap(0 as &u8, ps as UInt, PROT_NONE(), MAP_PRIVATE() | MAP_ANONYMOUS(), -1, 0)
  
  if ptr == (-1 as &u8) then
    Result::Err("Failed to create guard page".to_string())
  else
    Result::Ok(Mmap { ptr: ptr, length: ps as UInt, prot: PROT_NONE(), 
                      flags: MAP_PRIVATE() | MAP_ANONYMOUS() })
  end
end