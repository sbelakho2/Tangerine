# Tangerine Standard Library — std::fs
# File system operations
#
# On POSIX systems (macOS, Linux), these are implemented via libc syscalls.
# On Windows, they use the Win32 API.
# The compiler intrinsic mechanism can override these with optimized versions.

use std::core::{Option, Result}
use std::io::{IOError}

# POSIX syscall numbers
def SYS_OPEN()   -> Int = 2
def SYS_CLOSE()  -> Int = 3
def SYS_READ()   -> Int = 0
def SYS_WRITE()  -> Int = 1
def SYS_LSEEK()  -> Int = 8
def SYS_UNLINK() -> Int = 87
def SYS_MKDIR()  -> Int = 83
def SYS_RMDIR()  -> Int = 84
def SYS_STAT()   -> Int = 4
def SYS_ACCESS() -> Int = 21
def SYS_RENAME() -> Int = 82

def syscall1(num: Int, arg1: Int) -> Int
  # Assembly implementation provided by compiler intrinsic
  0
end

def syscall2(num: Int, arg1: Int, arg2: Int) -> Int
  # Assembly implementation provided by compiler intrinsic
  0
end

def syscall3(num: Int, arg1: Int, arg2: Int, arg3: Int) -> Int
  # Assembly implementation provided by compiler intrinsic
  0
end

def open(path: Ptr[u8], flags: Int, mode: Int) -> Int
  syscall3(SYS_OPEN(), path as Int, flags, mode)
end

def close(fd: Int) -> Int
  syscall1(SYS_CLOSE(), fd)
end

def read(fd: Int, buf: Ptr[u8], count: Int) -> Int
  syscall3(SYS_READ(), fd, buf as Int, count)
end

def write(fd: Int, buf: Ptr[u8], count: Int) -> Int
  syscall3(SYS_WRITE(), fd, buf as Int, count)
end

def lseek(fd: Int, offset: Int, whence: Int) -> Int
  syscall3(SYS_LSEEK(), fd, offset, whence)
end

def unlink(path: Ptr[u8]) -> Int
  syscall1(SYS_UNLINK(), path as Int)
end

def mkdir(path: Ptr[u8], mode: Int) -> Int
  syscall2(SYS_MKDIR(), path as Int, mode)
end

def rmdir(path: Ptr[u8]) -> Int
  syscall1(SYS_RMDIR(), path as Int)
end

def stat(path: Ptr[u8], buf: Ptr[u8]) -> Int
  syscall2(SYS_STAT(), path as Int, buf as Int)
end

def access(path: Ptr[u8], mode: Int) -> Int
  syscall2(SYS_ACCESS(), path as Int, mode)
end

def rename(old: Ptr[u8], new_: Ptr[u8]) -> Int
  syscall2(SYS_RENAME(), old as Int, new_ as Int)
end

# POSIX open flags (platform-specific)

# These are the same on all POSIX platforms
def O_RDONLY()   -> Int = 0
def O_WRONLY()   -> Int = 1
def O_RDWR()     -> Int = 2

# These differ between Linux and macOS
@cfg(target_os = "linux")
def O_CREAT()    -> Int = 0x40      # 64
@cfg(target_os = "linux")
def O_TRUNC()    -> Int = 0x200     # 512
@cfg(target_os = "linux")
def O_APPEND()   -> Int = 0x400     # 1024
@cfg(target_os = "linux")
def O_EXCL()     -> Int = 0x80      # 128

@cfg(target_os = "macos")
def O_CREAT()    -> Int = 0x200     # 512
@cfg(target_os = "macos")
def O_TRUNC()    -> Int = 0x400     # 1024
@cfg(target_os = "macos")
def O_APPEND()   -> Int = 0x8       # 8
@cfg(target_os = "macos")
def O_EXCL()     -> Int = 0x800     # 2048

# POSIX access modes
def F_OK() -> Int = 0
def R_OK() -> Int = 4
def W_OK() -> Int = 2
def X_OK() -> Int = 1

# Default file permissions: rw-r--r-- (0644)
def DEFAULT_MODE() -> Int = 420

# lseek whence
def SEEK_SET() -> Int = 0
def SEEK_CUR() -> Int = 1
def SEEK_END() -> Int = 2

struct File
  fd: Int
  path: String
  is_open: Bool
end

struct Path
  value: String
end

# ——————————————————————————————————————————————————————————————
# Core file operations
# ——————————————————————————————————————————————————————————————

def file_open(path: String) -> Result[File, IOError]
  let cs = path_to_cstr(path)
  let fd = open(cs.as_ptr(), O_RDONLY(), 0)
  if fd < 0 then
    Result::Err(IOError::NotFound("Cannot open file: " + path))
  else
    Result::Ok(File { fd: fd, path: path, is_open: true })
  end
end

def file_create(path: String) -> Result[File, IOError]
  let cs = path_to_cstr(path)
  let fd = open(cs.as_ptr(), O_WRONLY() | O_CREAT() | O_TRUNC(), DEFAULT_MODE())
  if fd < 0 then
    Result::Err(IOError::PermissionDenied("Cannot create file: " + path))
  else
    Result::Ok(File { fd: fd, path: path, is_open: true })
  end
end

def file_open_append(path: String) -> Result[File, IOError]
  let cs = path_to_cstr(path)
  let fd = open(cs.as_ptr(), O_WRONLY() | O_CREAT() | O_APPEND(), DEFAULT_MODE())
  if fd < 0 then
    Result::Err(IOError::PermissionDenied("Cannot open file for appending: " + path))
  else
    Result::Ok(File { fd: fd, path: path, is_open: true })
  end
end

def file_close(f: &mut File) -> Unit
  if f.is_open then
    close(f.fd)
    f.is_open = false
  end
end

impl Drop for File
  def drop(self: &mut File) -> Unit
    file_close(self)
  end
end

def file_read(f: &File, buf: &mut Vec[u8], max_bytes: Int) -> Result[Int, IOError]
  if !f.is_open then
    return Result::Err(IOError::Other("File is not open"))
  end
  # Read directly into the output buffer — avoid intermediate copy
  let start = buf.len()
  # Extend buf with zero bytes to create space for the read
  mut i = 0
  while i < max_bytes do
    buf.push(0)
    i = i + 1
  end
  let n = read(f.fd, buf.as_ptr().offset(start), max_bytes)
  if n < 0 then
    # Roll back the zeroed space
    buf.truncate(start)
    Result::Err(IOError::Other("Read error on: " + f.path))
  else
    # Trim unused capacity (we extended by max_bytes but only read n)
    buf.truncate(start + n as UInt)
    Result::Ok(n)
  end
end

def file_write(f: &mut File, data: &Vec[u8]) -> Result[Int, IOError]
  if !f.is_open then
    return Result::Err(IOError::Other("File is not open"))
  end
  let n = write(f.fd, data.as_ptr(), data.len())
  if n < 0 then
    Result::Err(IOError::Other("Write error on: " + f.path))
  else
    Result::Ok(n)
  end
end

def file_seek(f: &File, offset: Int, whence: Int) -> Result[Int, IOError]
  if !f.is_open then
    return Result::Err(IOError::Other("File is not open"))
  end 
  let pos = lseek(f.fd, offset, whence)
  if pos < 0 then
    Result::Err(IOError::Other("Seek error on: " + f.path))
  else
    Result::Ok(pos)
  end
end

# ——————————————————————————————————————————————————————————————
# High-level convenience functions
# ——————————————————————————————————————————————————————————————

def read_to_string(path: String) -> Result[String, IOError]
  match file_open(path)
  when Result::Ok(mut f) then
    # Read in chunks until EOF
    mut all_bytes = Vec::new()
    let chunk_size = 4096
    mut done = false
    while !done do
      let mut chunk = Vec::new()
      match file_read(&f, &mut chunk, chunk_size)
      when Result::Ok(n) then
        if n == 0 then
          done = true
        else
          for b in chunk do
            all_bytes.push(b)
          end
        end
      when Result::Err(e) then
        file_close(&mut f)
        return Result::Err(e)
      end
    end
    file_close(&mut f)
    Result::Ok(String::from_bytes(all_bytes))
  when Result::Err(e) then Result::Err(e)
  end
end

def write_string(path: String, data: String) -> Result[Unit, IOError]
  match file_create(path)
  when Result::Ok(mut f) then
    let bytes = data.bytes()
    match file_write(&mut f, &bytes)
    when Result::Ok(_) then
      file_close(&mut f)
      Result::Ok(())
    when Result::Err(e) then
      file_close(&mut f)
      Result::Err(e)
    end
  when Result::Err(e) then Result::Err(e)
  end
end

def append_string(path: String, data: String) -> Result[Unit, IOError]
  match file_open_append(path)
  when Result::Ok(mut f) then
    let bytes = data.bytes()
    match file_write(&mut f, &bytes)
    when Result::Ok(_) then
      file_close(&mut f)
      Result::Ok(())
    when Result::Err(e) then
      file_close(&mut f)
      Result::Err(e)
    end
  when Result::Err(e) then Result::Err(e)
  end
end

# ——————————————————————————————————————————————————————————————
# Path operations
# ——————————————————————————————————————————————————————————————

def path_join(base: String, other: String) -> String
  if base.is_empty() then return other end
  if other.is_empty() then return base end
  @cfg(target_family = "unix")
  let sep = "/"
  @cfg(target_os = "windows")
  let sep = "\\"
  # Strip trailing separators from base to avoid double separators
  mut clean_base = base
  while clean_base.len() > 1 do
    let last_byte = clean_base.as_bytes()[clean_base.len() - 1]
    if last_byte == '/' as u8 || last_byte == '\\' as u8 then
      clean_base = clean_base.slice(0, clean_base.len() - 1)
    else
      break
    end
  end
  clean_base + sep + other
end

def path_exists(path: String) -> Bool
  let cs = path_to_cstr(path)
  access(cs.as_ptr(), F_OK()) == 0
end

# Platform-specific stat struct offsets
@cfg(target_os = "linux")
def ST_MODE_OFFSET() -> Int = 24  # Linux x86_64: st_mode at offset 24

@cfg(target_os = "macos")
def ST_MODE_OFFSET() -> Int = 4   # macOS: st_mode at offset 4

def path_is_file(path: String) -> Bool
  # Use stat to check if path is a regular file
  let cs = path_to_cstr(path)
  @cfg(target_os = "macos")
  let stat_size = 144
  @cfg(target_os = "linux")
  let stat_size = 128
  mut buf = Vec::with_capacity(stat_size)
  mut i = 0
  while i < stat_size do buf.push(0); i = i + 1 end
  let rc = stat(cs.as_ptr(), buf.as_ptr())
  if rc != 0 then return false end
  # S_ISREG check: (mode & 0xF000) == 0x8000
  let offset = ST_MODE_OFFSET()
  let mode_lo = buf[offset] as Int | ((buf[offset + 1] as Int) << 8)
  (mode_lo & 0xF000) == 0x8000
end

def path_is_dir(path: String) -> Bool
  let cs = path_to_cstr(path)
  @cfg(target_os = "macos")
  let stat_size = 144
  @cfg(target_os = "linux")
  let stat_size = 128
  mut buf = Vec::with_capacity(stat_size)
  mut i = 0
  while i < stat_size do buf.push(0); i = i + 1 end
  let rc = stat(cs.as_ptr(), buf.as_ptr())
  if rc != 0 then return false end
  let offset = ST_MODE_OFFSET()
  let mode_lo = buf[offset] as Int | ((buf[offset + 1] as Int) << 8)
  (mode_lo & 0xF000) == 0x4000  # S_ISDIR
end

def path_extension(path: String) -> Option[String]
  mut last_dot = -1
  mut last_sep = -1
  let bytes = path.as_bytes()
  mut i = 0
  while i < bytes.len() do
    if bytes[i] == '/' as u8 || bytes[i] == '\\' as u8 then last_sep = i end
    if bytes[i] == '.' as u8 then last_dot = i end
    i = i + 1
  end
  if last_dot > last_sep + 1 then
    Option::Some(path.slice(last_dot + 1, path.len()))
  else
    Option::None
  end
end

def path_stem(path: String) -> String
  let filename = path_filename(path)
  let bytes = filename.as_bytes()
  mut last_dot = -1
  mut i = 0
  while i < bytes.len() do
    if bytes[i] == '.' as u8 then last_dot = i end
    i = i + 1
  end
  if last_dot > 0 then
    filename.slice(0, last_dot)
  else
    filename
  end
end

def path_filename(path: String) -> String
  let bytes = path.as_bytes()
  mut last_sep = -1
  mut i = 0
  while i < bytes.len() do
    if bytes[i] == '/' as u8 || bytes[i] == '\\' as u8 then last_sep = i end
    i = i + 1
  end
  if last_sep >= 0 then
    path.slice(last_sep + 1, path.len())
  else
    path
  end
end

def path_parent(path: String) -> Option[String]
  let bytes = path.as_bytes()
  mut last_sep = -1
  mut i = 0
  while i < bytes.len() do
    if bytes[i] == '/' as u8 || bytes[i] == '\\' as u8 then last_sep = i end
    i = i + 1
  end
  if last_sep > 0 then
    Option::Some(path.slice(0, last_sep))
  elsif last_sep == 0 then
    Option::Some("/")
  else
    Option::None
  end
end

# ——————————————————————————————————————————————————————————————
# Directory operations
# ——————————————————————————————————————————————————————————————

def create_dir(path: String) -> Result[Unit, IOError]
  let cs = path_to_cstr(path)
  let rc = mkdir(cs.as_ptr(), 493)  # 0755
  if rc < 0 then
    Result::Err(IOError::PermissionDenied("Cannot create directory: " + path))
  else
    Result::Ok(())
  end
end

def create_dir_all(path: String) -> Result[Unit, IOError]
  # Recursively create parent directories
  if path_exists(path) then return Result::Ok(()) end
  match path_parent(path)
  when Option::Some(parent) then
    if !path_exists(parent) then
      match create_dir_all(parent)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    end
  when Option::None then ()
  end
  create_dir(path)
end

def remove_file(path: String) -> Result[Unit, IOError]
  let cs = path_to_cstr(path)
  let rc = unlink(cs.as_ptr())
  if rc < 0 then
    Result::Err(IOError::NotFound("Cannot remove file: " + path))
  else
    Result::Ok(())
  end
end

def remove_dir(path: String) -> Result[Unit, IOError]
  let cs = path_to_cstr(path)
  let rc = rmdir(cs.as_ptr())
  if rc < 0 then
    Result::Err(IOError::Other("Cannot remove directory: " + path))
  else
    Result::Ok(())
  end
end

def rename_path(old_path: String, new_path: String) -> Result[Unit, IOError]
  let cs_old = path_to_cstr(old_path)
  let cs_new = path_to_cstr(new_path)
  let rc = rename(cs_old.as_ptr(), cs_new.as_ptr())
  if rc < 0 then
    Result::Err(IOError::Other("Cannot rename: " + old_path + " -> " + new_path))
  else
    Result::Ok(())
  end
end

def read_file(path: String) -> Result[String, IOError]
  read_to_string(path)
end

def write_file(path: String, data: String) -> Result[Unit, IOError]
  write_string(path, data)
end

def write_file_bytes(path: String, data: Vec[u8]) -> Result[Unit, IOError]
  match file_create(path)
  when Result::Ok(mut f) then
    match file_write(&mut f, &data)
    when Result::Ok(_) then
      file_close(&mut f)
      Result::Ok(())
    when Result::Err(e) then
      file_close(&mut f)
      Result::Err(e)
    end
  when Result::Err(e) then Result::Err(e)
  end
end

def write_str(fd: Int, s: String) -> Unit
  let bytes = s.bytes()
  write(fd, bytes.as_ptr(), bytes.len())
  ()
end

# ——————————————————————————————————————————————————————————————
# Internal helpers
# ——————————————————————————————————————————————————————————————

# Convert a Tangerine String to a NUL-terminated byte vector for C interop
def path_to_cstr(s: String) -> Vec[u8]
  mut v = Vec::new()
  for b in s.bytes() do
    v.push(b)
  end
  v.push(0)
  v
end

# ——————————————————————————————————————————————————————————————
# Extended filesystem operations
# ——————————————————————————————————————————————————————————————

# POSIX syscall numbers
def SYS_SYMLINK()  -> Int = 88
def SYS_READLINK() -> Int = 89
def SYS_CHMOD()    -> Int = 90
def SYS_CHOWN()    -> Int = 92
def SYS_FSTAT()    -> Int = 5
def SYS_GETDENTS() -> Int = 78 # Linux getdents
def SYS_LINK()     -> Int = 86

def symlink(target: Ptr[u8], linkpath: Ptr[u8]) -> Int
  syscall2(SYS_SYMLINK(), target as Int, linkpath as Int)
end

def readlink(path: Ptr[u8], buf: Ptr[u8], bufsiz: Int) -> Int
  syscall3(SYS_READLINK(), path as Int, buf as Int, bufsiz)
end

def chmod(path: Ptr[u8], mode: Int) -> Int
  syscall2(SYS_CHMOD(), path as Int, mode)
end

def chown(path: Ptr[u8], uid: Int, gid: Int) -> Int
  syscall3(SYS_CHOWN(), path as Int, uid, gid)
end

def fstat(fd: Int, buf: Ptr[u8]) -> Int
  syscall2(SYS_FSTAT(), fd, buf as Int)
end

def link(existing: Ptr[u8], new_link: Ptr[u8]) -> Int
  syscall2(SYS_LINK(), existing as Int, new_link as Int)
end

# ——————————————————————————————————————————————————————————————
# File metadata
# ——————————————————————————————————————————————————————————————

struct FileMetadata
  size: Int
  mode: Int
  is_file: Bool
  is_dir: Bool
  is_symlink: Bool
  modified_secs: Int
  accessed_secs: Int
  created_secs: Int
end

def metadata(path: String) -> Result[FileMetadata, IOError]
  let cs = path_to_cstr(path)
  @cfg(target_os = "macos")
  let stat_size = 144
  @cfg(target_os = "linux")
  let stat_size = 128
  mut buf = Vec::with_capacity(stat_size)
  mut i = 0
  while i < stat_size do buf.push(0); i = i + 1 end
  let rc = stat(cs.as_ptr(), buf.as_ptr())
  if rc != 0 then
    return Result::Err(IOError::NotFound("Cannot stat: " + path))
  end
  let offset = ST_MODE_OFFSET()
  let mode_lo = buf[offset] as Int | ((buf[offset + 1] as Int) << 8)
  let is_f = (mode_lo & 0xF000) == 0x8000
  let is_d = (mode_lo & 0xF000) == 0x4000
  let is_l = (mode_lo & 0xF000) == 0xA000

  ## Size is at different offsets per platform
  @cfg(target_os = "linux")
  let size_offset = 48
  @cfg(target_os = "macos")
  let size_offset = 96

  let mut file_size = 0
  let mut j = 0
  while j < 8 do
    file_size = file_size | ((buf[size_offset + j] as Int) << (j * 8))
    j = j + 1
  end

  Result::Ok(FileMetadata {
    size: file_size,
    mode: mode_lo,
    is_file: is_f,
    is_dir: is_d,
    is_symlink: is_l,
    modified_secs: 0,
    accessed_secs: 0,
    created_secs: 0,
  })
end

# ——————————————————————————————————————————————————————————————
# Symlink operations
# ——————————————————————————————————————————————————————————————

def create_symlink(target: String, link_path: String) -> Result[Unit, IOError]
  let cs_target = path_to_cstr(target)
  let cs_link = path_to_cstr(link_path)
  let rc = symlink(cs_target.as_ptr(), cs_link.as_ptr())
  if rc < 0 then
    Result::Err(IOError::Other("Cannot create symlink: " + link_path + " -> " + target))
  else
    Result::Ok(())
  end
end

def read_link(path: String) -> Result[String, IOError]
  let cs = path_to_cstr(path)
  let buf_size = 4096
  mut buf = Vec::with_capacity(buf_size)
  mut i = 0
  while i < buf_size do buf.push(0); i = i + 1 end
  let n = readlink(cs.as_ptr(), buf.as_ptr(), buf_size)
  if n < 0 then
    Result::Err(IOError::NotFound("Cannot read symlink: " + path))
  else
    Result::Ok(String::from_bytes(buf.slice(0, n as Int)))
  end
end

def create_hard_link(existing: String, new_link: String) -> Result[Unit, IOError]
  let cs_existing = path_to_cstr(existing)
  let cs_new = path_to_cstr(new_link)
  let rc = link(cs_existing.as_ptr(), cs_new.as_ptr())
  if rc < 0 then
    Result::Err(IOError::Other("Cannot create hard link: " + new_link))
  else
    Result::Ok(())
  end
end

# ——————————————————————————————————————————————————————————————
# Permissions (chmod / chown)
# ——————————————————————————————————————————————————————————————

def set_permissions(path: String, mode: Int) -> Result[Unit, IOError]
  let cs = path_to_cstr(path)
  let rc = chmod(cs.as_ptr(), mode)
  if rc < 0 then
    Result::Err(IOError::PermissionDenied("Cannot chmod: " + path))
  else
    Result::Ok(())
  end
end

def set_owner(path: String, uid: Int, gid: Int) -> Result[Unit, IOError]
  let cs = path_to_cstr(path)
  let rc = chown(cs.as_ptr(), uid, gid)
  if rc < 0 then
    Result::Err(IOError::PermissionDenied("Cannot chown: " + path))
  else
    Result::Ok(())
  end
end

# ——————————————————————————————————————————————————————————————
# Temporary files and directories
# ——————————————————————————————————————————————————————————————

def temp_dir() -> String
  ## Check TMPDIR, then fallback to /tmp
  match std::env::var("TMPDIR".to_string())
  when Option::Some(d) then d
  when Option::None then "/tmp"
  end
end

def create_temp_file(prefix: String) -> Result[File, IOError]
  ## Atomic O_EXCL creation with retry loop for unique temp file names.
  let dir = temp_dir()
  let base_time = current_time()
  let mut attempt = 0
  while attempt < 256 do
    let name = dir + "/" + prefix + "tmp_" + (base_time + attempt).to_string() + "_" + attempt.to_string()
    let cs = path_to_cstr(name)
    let fd = open(cs.as_ptr(), O_WRONLY() | O_CREAT() | O_EXCL(), DEFAULT_MODE())
    if fd >= 0 then
      return Result::Ok(File { fd: fd, path: name })
    end
    attempt = attempt + 1
  end
  Result::Err(IOError::AlreadyExists("Unable to create unique temp file"))
end

def create_temp_dir(prefix: String) -> Result[String, IOError]
  ## Atomic creation retry loop for unique temp directory names.
  let dir = temp_dir()
  let base_time = current_time()
  let mut attempt = 0
  while attempt < 256 do
    let path = dir + "/" + prefix + "tmpdir_" + (base_time + attempt).to_string() + "_" + attempt.to_string()
    match create_dir(path)
    when Result::Ok(_) then return Result::Ok(path)
    when Result::Err(IOError::AlreadyExists(_)) then ()
    when Result::Err(e) then return Result::Err(e)
    end
    attempt = attempt + 1
  end
  Result::Err(IOError::AlreadyExists("Unable to create unique temp directory"))
end

# POSIX gettimeofday syscall
def SYS_GETTIMEOFDAY() -> Int = 96

def current_time() -> Int
  # Use gettimeofday syscall to get seconds since epoch
  # struct timeval { long tv_sec; long tv_usec; }
  mut tv = Vec::with_capacity(16)
  mut i = 0
  while i < 16 do tv.push(0); i = i + 1 end
  let rc = syscall2(SYS_GETTIMEOFDAY(), tv.as_ptr() as Int, 0)
  if rc < 0 then return 0 end
  
  # Unpack tv_sec (first 8 bytes on 64-bit)
  mut sec = 0
  mut j = 0
  while j < 8 do
    sec = sec | ((tv[j] as Int) << (j * 8))
    j = j + 1
  end
  sec
end

def copy_file(src: String, dst: String) -> Result[Int, IOError]
  ## Copy file contents from src to dst. Returns bytes copied.
  match file_open(src)
  when Result::Ok(mut src_file) then
    match file_create(dst)
    when Result::Ok(mut dst_file) then
      let chunk_size = 8192
      mut total = 0
      mut done = false
      while !done do
        let mut buf = Vec::new()
        match file_read(&src_file, &mut buf, chunk_size)
        when Result::Ok(n) then
          if n == 0 then
            done = true
          else
            match file_write(&mut dst_file, &buf)
            when Result::Ok(written) then total = total + written
            when Result::Err(e) then
              file_close(&mut src_file)
              file_close(&mut dst_file)
              return Result::Err(e)
            end
          end
        when Result::Err(e) then
          file_close(&mut src_file)
          file_close(&mut dst_file)
          return Result::Err(e)
        end
      end
      file_close(&mut src_file)
      file_close(&mut dst_file)
      Result::Ok(total)
    when Result::Err(e) then
      file_close(&mut src_file)
      Result::Err(e)
    end
  when Result::Err(e) then Result::Err(e)
  end
end

# ——————————————————————————————————————————————————————————————
# Atomic replace (write to temp, then rename)
# ——————————————————————————————————————————————————————————————

def atomic_write(path: String, data: String) -> Result[Unit, IOError]
  let parent = match path_parent(path)
  when Option::Some(p) then p
  when Option::None then "."
  end
  let tmp_path = parent + "/.tg_atomic_XXXXXX"
  mut cs = path_to_cstr(tmp_path)
  let fd = mkstemp(cs.as_ptr())
  if fd < 0 then
    return Result::Err(IOError::Other("Cannot create atomic temp file"))
  end
  let actual_tmp = String::from_bytes(cs.slice(0, cs.len() - 1))
  let bytes = data.bytes()
  let n = write(fd, bytes.as_ptr(), bytes.len())
  close(fd)
  if n < 0 then
    unlink(path_to_cstr(actual_tmp).as_ptr())
    return Result::Err(IOError::Other("Write error during atomic write"))
  end
  ## Rename temp -> target (atomic on POSIX)
  rename_path(actual_tmp, path)
end

# ——————————————————————————————————————————————————————————————
# Directory listing / walk
# ——————————————————————————————————————————————————————————————

struct DirEntry
  name: String
  path: String
  is_file: Bool
  is_dir: Bool
end

def read_dir(path: String) -> Result[Vec[DirEntry], IOError]
  let cs = path_to_cstr(path)
  let dirp = opendir(cs.as_ptr())
  if dirp.is_null() then
    return Result::Err(IOError::NotFound("Cannot open directory: " + path))
  end
  mut entries = Vec::new()
  loop
    let entry = readdir(dirp)
    if entry.is_null() then break end
    ## Extract d_name from struct dirent (offset 0 after d_ino, etc.)
    ## Platform-specific, simplified here
    let name = _dirent_name(entry)
    if name == "." || name == ".." then continue end
    let full = path_join(path, name)
    entries.push(DirEntry {
      name: name,
      path: full.clone(),
      is_file: path_is_file(full.clone()),
      is_dir: path_is_dir(full),
    })
  end
  closedir(dirp)
  Result::Ok(entries)
end

## Recursively walk a directory tree.
def walk_dir(
  path: String,
  callback: fn(&DirEntry) -> Unit
) -> Result[Unit, IOError]
  match read_dir(path)
  when Result::Ok(entries) then
    for entry in entries do
      callback(&entry)
      if entry.is_dir then
        walk_dir(entry.path, callback)?
      end
    end
    Result::Ok(())
  when Result::Err(e) then Result::Err(e)
  end
end

## Canonical / absolute path
def canonicalize(path: String) -> Result[String, IOError]
  let cs = path_to_cstr(path)
  let buf_size = 4096
  mut buf = Vec::with_capacity(buf_size)
  mut i = 0
  while i < buf_size do buf.push(0); i = i + 1 end
  let result = realpath(cs.as_ptr(), buf.as_ptr())
  if result.is_null() then
    Result::Err(IOError::NotFound("Cannot resolve path: " + path))
  else
    ## Find NUL terminator
    mut len = 0
    while len < buf_size && buf[len] != 0 do len = len + 1 end
    Result::Ok(String::from_bytes(buf.slice(0, len)))
  end
end

def _dirent_name(entry: Ptr[u8]) -> String
  ## Platform-specific extraction of d_name from struct dirent
  @cfg(target_os = "macos")
  let name_offset = 21  ## __darwin_dirent d_name offset
  @cfg(target_os = "linux")
  let name_offset = 19  ## struct dirent64 d_name offset
  let ptr = entry.offset(name_offset)
  ## Read until NUL
  mut len = 0
  while unsafe { *ptr.offset(len) } != 0 do len = len + 1 end
  String::from_raw_parts(ptr, len)
end
