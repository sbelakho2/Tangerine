@cfg(target_os = "windows")
extern "system"
  def CreateFileW(lpFileName: Ptr[u16], dwDesiredAccess: UInt, dwShareMode: UInt,
                  lpSecurityAttributes: Ptr[u8], dwCreationDisposition: UInt,
                  dwFlagsAndAttributes: UInt, hTemplateFile: Int) -> Int
