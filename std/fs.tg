end

# Windows FIND_DATA structure for directory listing
@cfg(target_os = "windows")
@repr(C)
struct Win32FindData
  dwFileAttributes: UInt
  ftCreationTime: u64
  ftLastAccessTime: u64
  ftLastWriteTime: u64
  nFileSizeHigh: UInt
  nFileSizeLow: UInt
  dwReserved0: UInt
  dwReserved1: UInt
  cFileName: [u16; 260]
  cAlternateFileName: [u16; 14]
end

# ═══════════════════════════════════════════════════════════════
# Low-level Syscall Wrappers
# ═══════════════════════════════════════════════════════════════

# Syscall wrappers are defined in std/io.tg
# They use __intrinsic_syscall* functions

# Raw syscall wrappers with errno handling
def raw_open_fd(path: String, flags: Int, mode: UInt) -> Int
  let path_ptr = path.as_ptr() as Int

  let sys_num = if is_linux() then SYS_OPEN() else SYS_OPEN_MAC() end
  syscall3(sys_num, path_ptr, flags, mode as Int)
end

def raw_open(path: String, flags: Int, mode: UInt) -> Result[Int, IoError]
  let result = raw_open_fd(path.clone(), flags, mode)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, path.clone()))
  else
    Result::Ok(result)
  end
end

def raw_close(fd: Int) -> Result[Unit, IoError]
  let sys_num = if is_linux() then SYS_CLOSE() else SYS_CLOSE_MAC() end
  let result = syscall1(sys_num, fd)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, "close"))
  else
    Result::Ok(())
  end
end

def raw_read(fd: Int, buf: &mut Vec[u8], count: UInt) -> Result[UInt, IoError]
  let result = _tg_read_vec_u8(fd, buf, count)

  if result < 0 then
    eprintln("[FS-READ-ERR] errno=" + (-result).to_string() + " fd=" + fd.to_string() + " count=" + count.to_string())
    Result::Err(IoError::InvalidInput("read failed: errno=" + (-result).to_string() + " fd=" + fd.to_string() + " count=" + count.to_string()))
  else
    Result::Ok(result as UInt)
  end
end

def raw_write(fd: Int, buf: &Vec[u8], count: UInt) -> Result[UInt, IoError]
  let result = _tg_write_vec_u8(fd, buf, count)

  if result < 0 then
    Result::Err(IoError::from_errno(-result, "write"))
  else
    Result::Ok(result as UInt)
  end
end

def raw_lseek(fd: Int, offset: i64, whence: Int) -> Result[i64, IoError]
  let sys_num = if is_linux() then SYS_LSEEK() else SYS_LSEEK_MAC() end
  let result = syscall3(sys_num, fd, offset as Int, whence)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, "lseek"))
  else
    Result::Ok(result as i64)
  end
end

# ═══════════════════════════════════════════════════════════════
# stat structure (platform-dependent size)
# ═══════════════════════════════════════════════════════════════

struct StatBuf
  # This is a simplified stat buffer
  # Real implementation would have platform-specific layout
  st_dev: u64
  st_ino: u64
  st_mode: u32
  st_nlink: u32
  st_uid: u32
  st_gid: u32
  st_rdev: u64
  st_size: i64
  st_atime: i64
  st_mtime: i64
  st_ctime: i64
  st_blksize: i64
  st_blocks: i64
end

struct StatLayout
  st_dev: Int
  st_ino: Int
  st_mode: Int
  st_nlink: Int
  st_uid: Int
  st_gid: Int
  st_rdev: Int
  st_size: Int
  st_atime: Int
  st_mtime: Int
  st_ctime: Int
  st_birthtime: Int
  st_blksize: Int
  st_blocks: Int
end

def stat_layout() -> StatLayout
  if is_linux() then
    StatLayout {
      st_dev: 0,
      st_ino: 8,
      st_mode: 24,
      st_nlink: 16,
      st_uid: 28,
      st_gid: 32,
      st_rdev: 40,
      st_size: 48,
      st_atime: 72,
      st_mtime: 88,
      st_ctime: 104,
      st_birthtime: 104,
      st_blksize: 56,
      st_blocks: 64
    }
  else
    StatLayout {
      st_dev: 0,
      st_ino: 8,
      st_mode: 4,
      st_nlink: 6,
      st_uid: 16,
      st_gid: 20,
      st_rdev: 24,
      st_size: 96,
      st_atime: 32,
      st_mtime: 48,
      st_ctime: 64,
      st_birthtime: 80,
      st_blksize: 112,
      st_blocks: 104
    }
  end
end

def stat_buffer_size() -> Int
  # Darwin's struct stat is 144 bytes on the current LP64 ABI; keep a little
  # headroom so both Linux and macOS layouts fit safely.
  160
end

def raw_stat(path: String) -> Result[StatBuf, IoError]
  var buf: Vec[u8] = Vec::with_capacity(stat_buffer_size())
  buf.resize(stat_buffer_size(), 0)
  let buf_ptr = buf.as_mut_ptr() as Int

  let path_ptr = path.as_ptr() as Int
  
  let sys_num = if is_linux() then SYS_STAT() else SYS_STAT_MAC() end
  let result = syscall2(sys_num, path_ptr, buf_ptr)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, path.clone()))
  else
    let layout = stat_layout()
    let st_mode = if is_linux() then parse_u32_le(&buf, layout.st_mode) else parse_u16_le(&buf, layout.st_mode) as u32 end
    let st_nlink = if is_linux() then parse_u64_le(&buf, layout.st_nlink) as u32 else parse_u16_le(&buf, layout.st_nlink) as u32 end
    let st_size = parse_i64_le(&buf, layout.st_size)
    let st_atime = parse_i64_le(&buf, layout.st_atime)
    let st_mtime = parse_i64_le(&buf, layout.st_mtime)
    let st_ctime = parse_i64_le(&buf, layout.st_ctime)
    
    Result::Ok(StatBuf {
      st_dev: parse_u64_le(&buf, layout.st_dev),
      st_ino: parse_u64_le(&buf, layout.st_ino),
      st_mode: st_mode,
      st_nlink: st_nlink,
      st_uid: parse_u32_le(&buf, layout.st_uid),
      st_gid: parse_u32_le(&buf, layout.st_gid),
      st_rdev: parse_u64_le(&buf, layout.st_rdev),
      st_size: st_size,
      st_atime: st_atime,
      st_mtime: st_mtime,
      st_ctime: st_ctime,
      st_blksize: parse_i64_le(&buf, layout.st_blksize),
      st_blocks: parse_i64_le(&buf, layout.st_blocks)
    })
  end
end

def parse_u16_le(buf: &Vec[u8], offset: Int) -> u16
  (buf[offset] as u16) | ((buf[offset + 1] as u16) << 8)
end

def parse_u64_le(buf: &Vec[u8], offset: Int) -> u64
  var result: u64 = 0
  var i = 0
  while i < 8 do
    result = result | ((buf[offset + i] as u64) << (i * 8))
    i = i + 1
  end
  result
end

def parse_i64_le(buf: &Vec[u8], offset: Int) -> i64
  parse_u64_le(buf, offset) as i64
end

# ═══════════════════════════════════════════════════════════════
# High-level File Operations
# ═══════════════════════════════════════════════════════════════

## Open a file with the specified mode.
##
## ## Example
## ```tg
## match fs::open("data.txt", OpenMode::Read) then
##   when Result::Ok(file) then
##     # Read from file...
##     fs::close(&mut file)
##   when Result::Err(e) then
##     println("Failed to open: " + e.message())
## end
## ```
def open(path: String, mode: OpenMode) -> Result[File, IoError]
  # Windows implementation using Win32 API
  if is_windows() then
    return open_windows(&path, mode)
  end
  
  # Unix implementation using syscalls
  let flags = match mode
  when OpenMode::Read then
    O_RDONLY()
  when OpenMode::Write then O_WRONLY()
  when OpenMode::ReadWrite then O_RDWR()
  when OpenMode::Append then O_WRONLY() | O_APPEND()
  when OpenMode::Create then O_WRONLY() | O_CREAT()
  when OpenMode::CreateReadWrite then O_RDWR() | O_CREAT()
  when OpenMode::Truncate then O_WRONLY() | O_CREAT() | O_TRUNC()
  end
  
  match raw_open(path.clone(), flags, S_DEFAULT())
  when Result::Ok(fd) then
    Result::Ok(File { fd: fd, path: path, is_open: true })
  when Result::Err(e) then
    Result::Err(e)
  end
end

# Windows-specific file open implementation
@cfg(target_os = "windows")
def open_windows(path: &String, mode: OpenMode) -> Result[File, IoError]
  # Convert path to wide string (UTF-16)
  let wide_path = path.to_wide_string()
  
  let (access, share, disposition) = match mode
  when OpenMode::Read then
    (GENERIC_READ(), FILE_SHARE_READ(), OPEN_EXISTING())
  when OpenMode::Write then
    (GENERIC_WRITE(), 0u, CREATE_ALWAYS())
  when OpenMode::ReadWrite then
    (GENERIC_READ() | GENERIC_WRITE(), 0u, OPEN_EXISTING())
  when OpenMode::Append then
    (GENERIC_WRITE(), 0u, OPEN_ALWAYS())
  when OpenMode::Create then
    (GENERIC_WRITE(), 0u, CREATE_NEW())
  when OpenMode::CreateReadWrite then
    (GENERIC_READ() | GENERIC_WRITE(), 0u, CREATE_NEW())
  when OpenMode::Truncate then
    (GENERIC_WRITE(), 0u, TRUNCATE_EXISTING())
  end
  
  let handle = CreateFileW(
    wide_path.as_ptr(),
    access,
    share,
    Ptr::null(),  # Default security attributes
    disposition,
    FILE_ATTRIBUTE_NORMAL(),
    0  # No template file
  )
  
  if handle < 0 then
    let err = std::windows::get_last_error()
    Result::Err(IoError::from_win32_error(err, path.clone()))
  else
    Result::Ok(File { fd: handle, path: path.clone(), is_open: true })
  end
end

def close(file: &mut File) -> Result[Unit, IoError]
  if !file.is_open then
    return Result::Ok(())
  end
  
  match raw_close(file.fd)
  when Result::Ok(_) then
    file.is_open = false
    Result::Ok(())
  when Result::Err(e) then
    Result::Err(e)
  end
end

def read(file: &File, buf: &mut Vec[u8], count: UInt) -> Result[UInt, IoError]
  if !file.is_open then
    return Result::Err(IoError::InvalidInput("File is not open".to_string()))
  end
  
  raw_read(file.fd, buf, count)
end

def write(file: &File, buf: &Vec[u8], count: UInt) -> Result[UInt, IoError]
  if !file.is_open then
    return Result::Err(IoError::InvalidInput("File is not open".to_string()))
  end
  
  raw_write(file.fd, buf, count)
end

def seek(file: &File, pos: SeekFrom) -> Result[i64, IoError]
  if !file.is_open then
    return Result::Err(IoError::InvalidInput("File is not open".to_string()))
  end
  
  let (offset, whence) = match pos
  when SeekFrom::Start(n) then (n as i64, 0)      # SEEK_SET
  when SeekFrom::Current(n) then (n, 1)           # SEEK_CUR
  when SeekFrom::End(n) then (n, 2)               # SEEK_END
  end
  
  raw_lseek(file.fd, offset, whence)
end

def tell(file: &File) -> Result[i64, IoError]
  seek(file, SeekFrom::Current(0))
end

# ═══════════════════════════════════════════════════════════════
# Convenience Functions
# ═══════════════════════════════════════════════════════════════

def read_to_vec(path: String) -> Result[Vec[u8], IoError]
  match open(path.clone(), OpenMode::Read)
  when Result::Ok(var file) then
    var result: Vec[u8] = Vec::with_capacity(4096)
    var buf: Vec[u8] = Vec::with_capacity(4096)
    buf.resize(4096, 0)
    loop do
      match read(&file, &mut buf, 4096 as UInt)
      when Result::Ok(n) then
        if n == 0 as UInt then
          let _ = close(&mut file)
          return Result::Ok(result)
        end
        let read_len = n as Int
        let start = result.len()
        result.resize(start + read_len, 0)
        var i = 0
        while i < read_len do
          result[start + i] = buf[i]
          i = i + 1
        end
      when Result::Err(e) then
        let _ = close(&mut file)
        return Result::Err(e)
      end
    end
  when Result::Err(e) then
    Result::Err(e)
  end
end

def read_to_string(path: String) -> Result[String, IoError]
  match read_to_vec(path)
  when Result::Ok(data) then
    Result::Ok(String::from_bytes(data))
  when Result::Err(e) then
    Result::Err(e)
  end
end

def write_file_bytes(path: String, data: &Vec[u8]) -> Result[Unit, IoError]
  if is_windows() then
    match open(path.clone(), OpenMode::Create)
    when Result::Ok(var file) then
      match write(&file, data, data.len() as UInt)
      when Result::Ok(_) then
        let _ = close(&mut file)
        Result::Ok(())
      when Result::Err(e) then
        let _ = close(&mut file)
        Result::Err(e)
      end
    when Result::Err(e) then
      Result::Err(e)
    end
  else
    let flags = O_WRONLY() | O_CREAT() | O_TRUNC()
    let fd = raw_open_fd(path.clone(), flags, S_DEFAULT())
    if fd < 0 then
      return Result::Err(IoError::from_errno(-fd, path))
    end

    # raw_write clamps to the actual Vec length; avoid calling len() on this
    # &Vec parameter until the collection-ref lowering bug is fixed globally.
    match raw_write(fd, data, 2147483647 as UInt)
    when Result::Ok(_) then
      let _ = raw_close(fd)
      Result::Ok(())
    when Result::Err(e) then
      let _ = raw_close(fd)
      Result::Err(e)
    end
  end
end

def write_file_bytes_owned(path: String, data: Vec[u8]) -> Result[Unit, IoError]
  if is_windows() then
    write_file_bytes(path, &data)
  else
    let flags = O_WRONLY() | O_CREAT() | O_TRUNC()
    let fd = raw_open_fd(path.clone(), flags, S_DEFAULT())
    if fd < 0 then
      return Result::Err(IoError::from_errno(-fd, path))
    end

    let wrote = libc_write(fd, data.as_ptr(), data.len() as UInt)
    let _ = raw_close(fd)
    if wrote < 0 then
      Result::Err(IoError::from_errno(-wrote, path))
    else
      Result::Ok(())
    end
  end
end

def write_file(path: String, content: String) -> Result[Unit, IoError]
  let bytes = content.bytes()
  write_file_bytes(path, &bytes)
end

# Compat aliases used by the compiler driver
def read_file(path: String) -> Result[String, IoError]
  read_to_string(path)
end

def write_file_string(path: String, content: String) -> Result[Unit, IoError]
  write_file(path, content)
end

def file_exists(path: String) -> Bool
  exists(path)
end

def mkdir_p(path: String) -> Result[Unit, IoError]
  create_dir_all(path)
end

def delete_file(path: String) -> Result[Unit, IoError]
  remove_file(path)
end

def list_directory(path: String) -> Result[Vec[String], IoError]
  match read_dir(path)
  when Result::Ok(entries) then
    var names = Vec::new()
    for entry in entries do
      names.push(entry.name.clone())
    end
    Result::Ok(names)
  when Result::Err(e) then Result::Err(e)
  end
end

def append_file(path: String, content: String) -> Result[Unit, IoError]
  match open(path.clone(), OpenMode::Append)
  when Result::Ok(var file) then
    let bytes = content.bytes()
    if is_windows() then
      match write(&file, &bytes, bytes.len() as UInt)
      when Result::Ok(_) then
        let _ = close(&mut file)
        Result::Ok(())
      when Result::Err(e) then
        let _ = close(&mut file)
        Result::Err(e)
      end
    else
      match raw_write(file.fd, &bytes, bytes.len() as UInt)
      when Result::Ok(_) then
        let _ = raw_close(file.fd)
        Result::Ok(())
      when Result::Err(e) then
        let _ = raw_close(file.fd)
        Result::Err(e)
      end
    end
  when Result::Err(e) then
    Result::Err(e)
  end
end

# ═══════════════════════════════════════════════════════════════
# File Metadata
# ═══════════════════════════════════════════════════════════════

def metadata(file: &File) -> Result[FileMetadata, IoError]
  # Use fstat syscall
  var buf: Vec[u8] = Vec::with_capacity(stat_buffer_size())
  buf.resize(stat_buffer_size(), 0)
  let buf_ptr = buf.as_mut_ptr() as Int
  
  let sys_num = if is_linux() then SYS_FSTAT() else SYS_FSTAT_MAC() end
  let result = syscall2(sys_num, file.fd, buf_ptr)
  
  if result < 0 then
    return Result::Err(IoError::from_errno(-result, "fstat"))
  end

  let layout = stat_layout()
  
  let st_mode = if is_linux() then parse_u32_le(&buf, layout.st_mode) else parse_u16_le(&buf, layout.st_mode) as u32 end
  let st_size = parse_u64_le(&buf, layout.st_size)
  let st_mtime = parse_i64_le(&buf, layout.st_mtime)
  let st_atime = parse_i64_le(&buf, layout.st_atime)
  let st_ctime = parse_i64_le(&buf, layout.st_ctime)
  let st_birth = parse_i64_le(&buf, layout.st_birthtime)
  
  # S_ISDIR: (mode & 0o170000) == 0o040000
  # S_ISREG: (mode & 0o170000) == 0o100000
  # S_ISLNK: (mode & 0o170000) == 0o120000
  let type_bits = st_mode & 0o170000
  let is_dir = type_bits == 0o040000
  let is_file = type_bits == 0o100000
  let is_symlink = type_bits == 0o120000
  let read_only = (st_mode & 0o200) == 0
  
  Result::Ok(FileMetadata {
    size: st_size,
    is_dir: is_dir,
    is_file: is_file,
    is_symlink: is_symlink,
    read_only: read_only,
    modified_time: st_mtime,
    accessed_time: st_atime,
    created_time: if is_linux() then st_ctime else st_birth end
  })
end

def path_metadata(path: String) -> Result[FileMetadata, IoError]
  match raw_stat(path.clone())
  when Result::Ok(stat) then
    let type_bits = stat.st_mode & 0o170000
    let is_dir = type_bits == 0o040000
    let is_file = type_bits == 0o100000
    let is_symlink = type_bits == 0o120000
    let read_only = (stat.st_mode & 0o200) == 0
    
    Result::Ok(FileMetadata {
      size: stat.st_size as UInt,
      is_dir: is_dir,
      is_file: is_file,
      is_symlink: is_symlink,
      read_only: read_only,
      modified_time: stat.st_mtime,
      accessed_time: stat.st_atime,
      created_time: stat.st_ctime
    })
  when Result::Err(e) then
    Result::Err(e)
  end
end

def exists(path: String) -> Bool
  match path_metadata(path)
  when Result::Ok(_) then true
  when Result::Err(_) then false
  end
end

def is_file(path: String) -> Bool
  match path_metadata(path)
  when Result::Ok(meta) then meta.is_file
  when Result::Err(_) then false
  end
end

def is_dir(path: String) -> Bool
  match path_metadata(path)
  when Result::Ok(meta) then meta.is_dir
  when Result::Err(_) then false
  end
end

def file_size(path: String) -> Option[UInt]
  match path_metadata(path)
  when Result::Ok(meta) then Option::Some(meta.size)
  when Result::Err(_) then Option::None
  end
end

# ═══════════════════════════════════════════════════════════════
# Directory Operations
# ═══════════════════════════════════════════════════════════════

## Create a directory at the specified path.
##
## ## Example
## ```tg
## match fs::create_dir("my_new_dir") then
##   when Result::Ok(_) then println("Directory created")
##   when Result::Err(e) then println("Failed: " + e.message())
## end
## ```
def create_dir(path: String) -> Result[Unit, IoError]
  # Windows implementation
  if is_windows() then
    return create_dir_windows(&path)
  end
  
  # Unix implementation
  let path_ptr = path.as_ptr() as Int
  
  let sys_num = if is_linux() then SYS_MKDIR() else SYS_MKDIR_MAC() end
  let result = syscall2(sys_num, path_ptr, S_DEFAULT() as Int | 0o111 as Int)  # rwxr-xr-x
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, path))
  else
    Result::Ok(())
  end
end

# Windows-specific directory creation
@cfg(target_os = "windows")
def create_dir_windows(path: &String) -> Result[Unit, IoError]
  let wide_path = path.to_wide_string()
  
  let success = CreateDirectoryW(
    wide_path.as_ptr(),
    Ptr::null()  # Default security attributes
  )
  
  if !success then
    let err = std::windows::get_last_error()
    Result::Err(IoError::from_win32_error(err, path.clone()))
  else
    Result::Ok(())
  end
end

# Windows-specific directory removal
@cfg(target_os = "windows")
def remove_dir_windows(path: &String) -> Result[Unit, IoError]
  let wide_path = path.to_wide_string()
  let success = RemoveDirectoryW(wide_path.as_ptr())
  if !success then
    let err = std::windows::get_last_error()
    Result::Err(IoError::from_win32_error(err, path.clone()))
  else
    Result::Ok(())
  end
end

# Windows-specific file removal
@cfg(target_os = "windows")
def remove_file_windows(path: &String) -> Result[Unit, IoError]
  let wide_path = path.to_wide_string()
  let success = DeleteFileW(wide_path.as_ptr())
  if !success then
    let err = std::windows::get_last_error()
    Result::Err(IoError::from_win32_error(err, path.clone()))
  else
    Result::Ok(())
  end
end

# Windows-specific rename
@cfg(target_os = "windows")
def rename_windows(from: &String, to: &String) -> Result[Unit, IoError]
  let from_wide = from.to_wide_string()
  let to_wide = to.to_wide_string()
  let success = MoveFileW(from_wide.as_ptr(), to_wide.as_ptr())
  if !success then
    let err = std::windows::get_last_error()
    Result::Err(IoError::from_win32_error(err, from.clone() + " -> " + to.clone()))
  else
    Result::Ok(())
  end
end

def create_dir_all(path: String) -> Result[Unit, IoError]
  # Create all parent directories
  let parts = path.split("/")
  var current = ""
  
  for part in parts do
    if part == "" then continue end
    
    current = if current == "" then "/" + part else current + "/" + part end
    
    if !exists(current.clone()) then
      match create_dir(current.clone())
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    end
  end
  
  Result::Ok(())
end

def remove_dir(path: String) -> Result[Unit, IoError]
  if is_windows() then
    return remove_dir_windows(&path)
  end
  
  let path_ptr = path.as_ptr() as Int
  
  let sys_num = if is_linux() then SYS_RMDIR() else SYS_RMDIR_MAC() end
  let result = syscall1(sys_num, path_ptr)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, path))
  else
    Result::Ok(())
  end
end

def remove_dir_all(path: String) -> Result[Unit, IoError]
  # Recursively remove directory and contents
  match read_dir(path.clone())
  when Result::Ok(entries) then
    for entry in entries do
      let entry_path = entry.path
      if entry.metadata.is_dir then
        match remove_dir_all(entry_path)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      else
        match remove_file(entry_path)
        when Result::Err(e) then return Result::Err(e)
        when Result::Ok(_) then ()
        end
      end
    end
    remove_dir(path)
  when Result::Err(e) then
    Result::Err(e)
  end
end

# Linux getdents64 directory entry structure
# struct linux_dirent64 {
#   u64        d_ino;    /* 64-bit inode number */
#   u64        d_off;    /* 64-bit offset to next structure */
#   unsigned short d_reclen; /* Size of this dirent */
#   unsigned char  d_type;   /* File type */
#   char           d_name[]; /* Filename (null-terminated) */
# };

# Directory entry type constants
def DT_UNKNOWN() -> u8 = 0
def DT_FIFO() -> u8 = 1
def DT_CHR() -> u8 = 2
def DT_DIR() -> u8 = 4
def DT_BLK() -> u8 = 6
def DT_REG() -> u8 = 8
def DT_LNK() -> u8 = 10
def DT_SOCK() -> u8 = 12
def DT_WHT() -> u8 = 14

def read_dir(path: String) -> Result[Vec[DirEntry], IoError]
  # Use getdents64 on Linux, getdirentries on macOS
  # Open directory using O_DIRECTORY flag if available
  let flags = if is_linux() then O_RDONLY() | O_DIRECTORY() else O_RDONLY() end
  let fd_result = raw_open(path.clone(), flags, 0)
  
  let dir_fd = match fd_result
  when Result::Ok(fd) then fd
  when Result::Err(e) then return Result::Err(e)
  end
  
  var entries: Vec[DirEntry] = Vec::new()
  var buf: Vec[u8] = Vec::with_capacity(8192)
  buf.resize(8192, 0)
  
  if is_linux() then
    # Use getdents64 syscall on Linux
    loop do
      let buf_ptr = buf.as_mut_ptr() as Int
      let nread = syscall3(SYS_GETDENTS64(), dir_fd, buf_ptr, 8192)
      
      if nread < 0 then
        let _ = raw_close(dir_fd)
        return Result::Err(IoError::from_errno(-nread, path))
      end
      
      if nread == 0 then
        break
      end
      
      # Parse directory entries
      var pos = 0
      while pos < nread do
        # Read dirent64 structure
        # d_ino: 8 bytes (offset 0)
        # d_off: 8 bytes (offset 8)
        # d_reclen: 2 bytes (offset 16)
        # d_type: 1 byte (offset 18)
        # d_name: null-terminated string (offset 19)
        
        let d_ino = parse_u64_le(&buf, pos)
        let d_off = parse_u64_le(&buf, pos + 8)
        let d_reclen = (buf[pos + 16] as UInt) | ((buf[pos + 17] as UInt) << 8)
        let d_type = buf[pos + 18]
        
        # Extract filename (null-terminated)
        var name_start = pos + 19
        var name_end = name_start
        while name_end < pos + d_reclen as Int && buf[name_end] != 0 do
          name_end = name_end + 1
        end
        
        let name = String::from_utf8_range(&buf, name_start, name_end - name_start)
        
        # Skip "." and ".." entries
        if name != "." && name != ".." then
          let entry_path = if path.ends_with("/") then
            path.clone() + name.clone()
          else
            path.clone() + "/" + name.clone()
          end
          
          # Determine file type from d_type
          let (is_dir, is_file, is_symlink) = match d_type
          when DT_DIR() then (true, false, false)
          when DT_REG() then (false, true, false)
          when DT_LNK() then (false, false, true)
          when DT_UNKNOWN() then
            # Fall back to stat if type is unknown
            match path_metadata(entry_path.clone())
            when Result::Ok(m) then (m.is_dir, m.is_file, m.is_symlink)
            when Result::Err(_) then (false, false, false)
            end
          when _ then (false, false, false)
          end
          
          # Get full metadata
          let meta = match path_metadata(entry_path.clone())
          when Result::Ok(m) then m
          when Result::Err(_) then
            # Create minimal metadata from d_type
            FileMetadata {
              size: 0,
              is_dir: is_dir,
              is_file: is_file,
              is_symlink: is_symlink,
              read_only: false,
              modified_time: 0,
              accessed_time: 0,
              created_time: 0
            }
          end
          
          entries.push(DirEntry {
            name: name,
            path: entry_path,
            metadata: meta
          })
        end
        
        pos = pos + d_reclen as Int
      end
    end
  else
    # macOS: Use getdirentries syscall
    # The getdirentries syscall has a different structure
    # We'll use a simpler approach with a larger buffer
    loop do
      let buf_ptr = buf.as_mut_ptr() as Int
      var basep: u64 = 0
      
      # getdirentries on macOS (actual BSD syscall 196, stored as 193 here)
      let nread = syscall4(193, dir_fd, buf_ptr, 8192, address_of(&mut basep) as Int)
      
      if nread < 0 then
        let _ = raw_close(dir_fd)
        return Result::Err(IoError::from_errno(-nread, path))
      end
      
      if nread == 0 then
        break
      end
      
      # Parse BSD dirent structure
      # d_fileno: u32 (4 bytes)
      # d_reclen: u16 (2 bytes, offset 4)
      # d_type: u8 (1 byte, offset 6)
      # d_namlen: u8 (1 byte, offset 7)
      # d_name: char[] (offset 8)
      
      var pos = 0
      while pos < nread do
        let d_fileno = parse_u32_le(&buf, pos)
        let d_reclen = (buf[pos + 4] as UInt) | ((buf[pos + 5] as UInt) << 8)
        let d_type = buf[pos + 6]
        let d_namlen = buf[pos + 7] as Int
        
        # Extract filename
        let name = String::from_utf8_range(&buf, pos + 8, d_namlen)
        
        # Skip "." and ".." entries
        if name != "." && name != ".." then
          let entry_path = if path.ends_with("/") then
            path.clone() + name.clone()
          else
            path.clone() + "/" + name.clone()
          end
          
          # Determine file type
          let (is_dir, is_file, is_symlink) = match d_type
          when DT_DIR() then (true, false, false)
          when DT_REG() then (false, true, false)
          when DT_LNK() then (false, false, true)
          when _ then
            match path_metadata(entry_path.clone())
            when Result::Ok(m) then (m.is_dir, m.is_file, m.is_symlink)
            when Result::Err(_) then (false, false, false)
            end
          end
          
          let meta = match path_metadata(entry_path.clone())
          when Result::Ok(m) then m
          when Result::Err(_) then
            FileMetadata {
              size: 0,
              is_dir: is_dir,
              is_file: is_file,
              is_symlink: is_symlink,
              read_only: false,
              modified_time: 0,
              accessed_time: 0,
              created_time: 0
            }
          end
          
          entries.push(DirEntry {
            name: name,
            path: entry_path,
            metadata: meta
          })
        end
        
        pos = pos + d_reclen as Int
      end
    end
  end
  
  let _ = raw_close(dir_fd)
  Result::Ok(entries)
end

def parse_u32_le(buf: &Vec[u8], offset: Int) -> u32
  (buf[offset] as u32) |
  ((buf[offset + 1] as u32) << 8) |
  ((buf[offset + 2] as u32) << 16) |
  ((buf[offset + 3] as u32) << 24)
end

# ═══════════════════════════════════════════════════════════════
# File Operations
# ═══════════════════════════════════════════════════════════════

def remove_file(path: String) -> Result[Unit, IoError]
  if is_windows() then
    return remove_file_windows(&path)
  end
  
  let path_ptr = path.as_ptr() as Int
  
  let sys_num = if is_linux() then SYS_UNLINK() else SYS_UNLINK_MAC() end
  let result = syscall1(sys_num, path_ptr)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, path))
  else
    Result::Ok(())
  end
end

def rename(from: String, to: String) -> Result[Unit, IoError]
  if is_windows() then
    return rename_windows(&from, &to)
  end
  
  let from_ptr = from.as_ptr() as Int
  let to_ptr = to.as_ptr() as Int
  
  let sys_num = if is_linux() then SYS_RENAME() else SYS_RENAME_MAC() end
  let result = syscall2(sys_num, from_ptr, to_ptr)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, from + " -> " + to))
  else
    Result::Ok(())
  end
end

def copy(from: String, to: String) -> Result[Unit, IoError]
  match read_to_vec(from.clone())
  when Result::Ok(data) then
    write_file_bytes(to, &data)
  when Result::Err(e) then
    Result::Err(e)
  end
end

def chmod(path: String, mode: UInt) -> Result[Unit, IoError]
  if is_windows() then
    # Windows has no chmod syscall (SetFileAttributesW covers only a subset
    # of modes). Fail closed with an explicit error instead of using the
    # macOS syscall number on Windows.
    return Result::Err(IoError::Internal("chmod: not supported on Windows".to_string()))
  end
  
  let path_ptr = path.as_ptr() as Int
  
  let sys_num = if is_linux() then SYS_CHMOD() else SYS_CHMOD_MAC() end
  let result = syscall2(sys_num, path_ptr, mode as Int)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, path))
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# Symlink Operations
# ═══════════════════════════════════════════════════════════════

def create_symlink(original: String, link: String) -> Result[Unit, IoError]
  let orig_ptr = original.as_ptr() as Int
  let link_ptr = link.as_ptr() as Int
  
  let sys_num = if is_linux() then SYS_SYMLINK() else SYS_SYMLINK_MAC() end
  let result = syscall2(sys_num, orig_ptr, link_ptr)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, original + " -> " + link))
  else
    Result::Ok(())
  end
end

def read_link(path: String) -> Result[String, IoError]
  # Allocate buffer for link target
  var buf: Vec[u8] = Vec::with_capacity(256)
  buf.resize(256, 0)
  let buf_ptr = buf.as_mut_ptr() as Int

  let path_ptr = path.as_ptr() as Int
  
  let sys_num = if is_linux() then SYS_READLINK() else SYS_READLINK_MAC() end
  let result = syscall3(sys_num, path_ptr, buf_ptr, 256)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, path))
  else
    buf.truncate(result)
    Result::Ok(String::from_bytes(buf))
  end
end

# ═══════════════════════════════════════════════════════════════
# Path Manipulation
# ═══════════════════════════════════════════════════════════════

## Get the platform-specific path separator.
## Returns "/" on Unix, "\\" on Windows.
def path_separator() -> String
  if is_windows() then "\\" else "/" end
end

## Join two path components with the appropriate separator.
##
## ## Example
## ```tg
## let full_path = fs::path_join("/home/user", "documents/file.txt")
## # Returns "/home/user/documents/file.txt"
## ```
def path_join(a: String, b: String) -> String
  if a == "" then return b end
  if b == "" then return a end
  
  # Use appropriate separator for platform
  let sep = if is_windows() then "\\" else "/" end
  
  # Normalize separators in both paths
  let normalized_a = if is_windows() then a.replace("/", "\\") else a end
  let normalized_b = if is_windows() then b.replace("/", "\\") else b end
  
  let a_ends_sep = normalized_a.ends_with(sep)
  let b_starts_sep = normalized_b.starts_with(sep)
  
  if a_ends_sep && b_starts_sep then
    normalized_a + normalized_b.slice(1, normalized_b.len())
  elsif !a_ends_sep && !b_starts_sep then
    normalized_a + sep + normalized_b
  else
    normalized_a + normalized_b
  end
end

def path_parent(path: String) -> Option[String]
  if path == "" || path == "/" then return Option::None end
  
  # Remove trailing slashes
  var trimmed = path
  while trimmed.len() > 1 && trimmed.ends_with("/") do
    trimmed = trimmed.slice(0, trimmed.len() - 1)
  end
  
  # Find last separator
  let idx = trimmed.rfind("/")
  match idx
  when Option::Some(i) then
    if i == 0 then
      Option::Some("/".to_string())
    else
      Option::Some(trimmed.slice(0, i))
    end
  when Option::None then
    Option::None
  end
end

def path_filename(path: String) -> Option[String]
  if path == "" || path == "/" then return Option::None end
  
  # Remove trailing slashes
  var trimmed = path
  while trimmed.len() > 1 && trimmed.ends_with("/") do
    trimmed = trimmed.slice(0, trimmed.len() - 1)
  end
  
  let idx = trimmed.rfind("/")
  match idx
  when Option::Some(i) then
    Option::Some(trimmed.slice(i + 1, trimmed.len()))
  when Option::None then
    Option::Some(trimmed)
  end
end

def path_extension(path: String) -> Option[String]
  match path_filename(path)
  when Option::Some(name) then
    let idx = name.rfind(".")
    match idx
    when Option::Some(i) then
      if i > 0 then  # Don't treat .foo as having extension
        return Option::Some(name.slice(i + 1, name.len()))
      end
      Option::None
    when Option::None then Option::None
    end
  when Option::None then Option::None
  end
end

def path_is_absolute(path: String) -> Bool
  path.starts_with("/")
end

def path_canonicalize(path: String) -> Result[String, IoError]
  # Resolve. and.. components
  let parts = path.split("/")
  var result: Vec[String] = Vec::new()
  
  for part in parts do
    if part == "" || part == "." then
      continue
    elsif part == ".." then
      if result.len() > 0 then
        result.pop()
      end
    else
      result.push(part)
    end
  end
  
  var canonical = ""
  for part in result do
    if canonical == "" then
      canonical = if path_is_absolute(path) then "/" + part else part end
    else
      canonical = canonical + "/" + part
    end
  end
  
  if canonical == "" then
    canonical = if path_is_absolute(path) then "/" else "." end
  end
  
  Result::Ok(canonical)
end

# ═══════════════════════════════════════════════════════════════
# Current Directory
# ═══════════════════════════════════════════════════════════════

def current_dir() -> Result[String, IoError]
  var buf: Vec[u8] = Vec::with_capacity(4096)
  buf.resize(4096, 0)
  let buf_ptr = buf.as_mut_ptr() as Int
  
  let sys_num = if is_linux() then SYS_GETCWD() else SYS_GETCWD_MAC() end
  let result = syscall2(sys_num, buf_ptr, 4096)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, "getcwd"))
  else
    # Find null terminator
    var len = 0
    while len < buf.len() && buf[len] != 0 do
      len = len + 1
    end
    buf.truncate(len)
    Result::Ok(String::from_bytes(buf))
  end
end

def set_current_dir(path: String) -> Result[Unit, IoError]
  let path_ptr = path.as_ptr() as Int
  
  let sys_num = if is_linux() then SYS_CHDIR() else SYS_CHDIR_MAC() end
  let result = syscall1(sys_num, path_ptr)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, path))
  else
    Result::Ok(())
  end
end

# ═══════════════════════════════════════════════════════════════
# File Descriptor Operations
# ═══════════════════════════════════════════════════════════════

def file_dup(file: &File) -> Result[File, IoError]
  let sys_num = if is_linux() then SYS_DUP() else 32 end  # dup on macOS
  let result = syscall1(sys_num, file.fd)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, "dup"))
  else
    Result::Ok(File { fd: result, path: file.path.clone(), is_open: true })
  end
end

def file_dup2(file: &File, new_fd: Int) -> Result[File, IoError]
  let sys_num = if is_linux() then SYS_DUP2() else 90 end  # dup2 on macOS
  let result = syscall2(sys_num, file.fd, new_fd)
  
  if result < 0 then
    Result::Err(IoError::from_errno(-result, "dup2"))
  else
    Result::Ok(File { fd: result, path: file.path.clone(), is_open: true })
  end
end

# Standard file descriptors
def stdin() -> File
  File { fd: 0, path: "/dev/stdin".to_string(), is_open: true }
end

def stdout() -> File
  File { fd: 1, path: "/dev/stdout".to_string(), is_open: true }
end

def stderr() -> File
  File { fd: 2, path: "/dev/stderr".to_string(), is_open: true }
end

# ═══════════════════════════════════════════════════════════════
# Temporary Files
# ═══════════════════════════════════════════════════════════════

var _temp_counter: Int = 0

def temp_dir() -> String
  match std::env::get_env("TMPDIR")
  when Option::Some(dir) then dir
  when Option::None then "/tmp".to_string()
  end
end

def temp_file() -> Result[File, IoError]
  _temp_counter = _temp_counter + 1
  # NOTE: PID is intentionally omitted here to keep std::fs bootstrap-profile
  # compliant (no std::process import). Uniqueness is provided by the monotonic
  # counter plus the O_EXCL flag below; callers needing per-process isolation
  # should wrap this with their own namespace.
  let name = temp_dir() + "/tg_temp_" + _temp_counter.to_string()
  
  # Create with O_EXCL to ensure uniqueness
  let flags = O_RDWR() | O_CREAT() | O_EXCL()
  match raw_open(name.clone(), flags, 0o600)
  when Result::Ok(fd) then
    Result::Ok(File { fd: fd, path: name, is_open: true })
  when Result::Err(e) then
    Result::Err(e)
  end
end

# ═══════════════════════════════════════════════════════════════
# FsBufReader/FsBufWriter for buffered I/O
# ═══════════════════════════════════════════════════════════════

struct FsBufReader
  file: File
  buf: Vec[u8]
  pos: Int
  len: Int
end

def buf_reader_new(file: File, capacity: Int) -> FsBufReader
  FsBufReader {
    file: file,
    buf: Vec::with_capacity(capacity),
    pos: 0,
    len: 0
  }
end

def buf_reader_read(reader: &mut FsBufReader, out: &mut Vec[u8], count: Int) -> Result[Int, IoError]
  if reader.pos >= reader.len then
    # Refill buffer
    reader.buf.resize(reader.buf.capacity(), 0)
    match read(&reader.file, &mut reader.buf, reader.buf.capacity() as UInt)
    when Result::Ok(n) then
      reader.len = n as Int
      reader.pos = 0
    when Result::Err(e) then
      return Result::Err(e)
    end
  end
  
  let available = reader.len - reader.pos
  let to_copy = if count < available then count else available end
  
  var i = 0
  while i < to_copy do
    out.push(reader.buf[reader.pos + i])
    i = i + 1
  end
  
  reader.pos = reader.pos + to_copy
  Result::Ok(to_copy)
end

def buf_reader_read_line(reader: &mut FsBufReader) -> Result[String, IoError]
  var line: Vec[u8] = Vec::new()
  
  loop do
    if reader.pos >= reader.len then
      match reader.file.read_byte()
      when Result::Ok(b) then
        line.push(b)
        if b == 10 then  # '\n'
          return Result::Ok(String::from_bytes(line))
        end
      when Result::Err(e) then
        if line.len() > 0 then
          return Result::Ok(String::from_bytes(line))
        else
          return Result::Err(e)
        end
      end
    else
      let b = reader.buf[reader.pos]
      reader.pos = reader.pos + 1
      line.push(b)
      if b == 10 then
        return Result::Ok(String::from_bytes(line))
      end
    end
  end
end

struct FsBufWriter
  file: File
  buf: Vec[u8]
end

def buf_writer_new(file: File, capacity: Int) -> FsBufWriter
  FsBufWriter {
    file: file,
    buf: Vec::with_capacity(capacity)
  }
end

def buf_writer_write(writer: &mut FsBufWriter, data: &Vec[u8]) -> Result[Unit, IoError]
  for b in data do
    writer.buf.push(b)
    if writer.buf.len() >= writer.buf.capacity() then
      match flush(writer)
      when Result::Err(e) then return Result::Err(e)
      when Result::Ok(_) then ()
      end
    end
  end
  Result::Ok(())
end

def buf_writer_write_str(writer: &mut FsBufWriter, s: String) -> Result[Unit, IoError]
  let bytes = s.bytes()
  buf_writer_write(writer, &bytes)
end

def flush(writer: &mut FsBufWriter) -> Result[Unit, IoError]
  if writer.buf.len() == 0 then
    return Result::Ok(())
  end
  
  match write(&writer.file, &writer.buf, writer.buf.len() as UInt)
  when Result::Ok(_) then
    writer.buf.clear()
    Result::Ok(())
  when Result::Err(e) then
    Result::Err(e)
  end
end

# ═══════════════════════════════════════════════════════════════
# File Impl - methods
# ═══════════════════════════════════════════════════════════════

impl File
  def open(path: String, mode: OpenMode) -> Result[File, IoError]
    open(path, mode)
  end
  
  def read_byte(self: &File) -> Result[u8, IoError]
    var buf: Vec[u8] = Vec::with_capacity(1)
    buf.resize(1, 0)
    match read(self, &mut buf, 1)
    when Result::Ok(n) then
      if n == 0 then
        Result::Err(IoError::UnexpectedEof("read_byte".to_string()))
      else
        Result::Ok(buf[0])
      end
    when Result::Err(e) then
      Result::Err(e)
    end
  end
  
  def write_byte(self: &File, b: u8) -> Result[Unit, IoError]
    let buf = Vec::from([b])
    match write(self, &buf, 1)
    when Result::Ok(_) then Result::Ok(())
    when Result::Err(e) then Result::Err(e)
    end
  end
  
  def read_all(self: &File) -> Result[Vec[u8], IoError]
    let meta = metadata(self)
    let initial_size = match meta
    when Result::Ok(m) then (m.size + 1024) as Int
    when Result::Err(_) then 4096
    end
    
    var result: Vec[u8] = Vec::with_capacity(initial_size)
    var buf: Vec[u8] = Vec::with_capacity(4096)
    buf.resize(4096, 0)
    
    loop do
      match read(self, &mut buf, 4096)
      when Result::Ok(n) then
        if n == 0 then
          return Result::Ok(result)
        end
        var i = 0
        while i < n as Int do
          result.push(buf[i])
          i = i + 1
        end
      when Result::Err(e) then
        return Result::Err(e)
      end
    end
  end
  
  def write_all(self: &File, data: &Vec[u8]) -> Result[Unit, IoError]
    var offset = 0
    while offset < data.len() do
      let remaining = data.len() - offset
      let chunk = data.slice(offset, data.len())
      match write(self, &chunk, remaining as UInt)
      when Result::Ok(n) then
        offset = offset + n as Int
      when Result::Err(e) then
        return Result::Err(e)
      end
    end
    Result::Ok(())
  end
end

impl Drop for File
  def drop(self: &mut File) -> Unit
    if self.is_open then
      let _ = close(self)
    end
  end
end