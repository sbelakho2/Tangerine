  def ReadFile(hFile: Int, lpBuffer: Ptr[u8], nNumberOfBytesToRead: UInt,
               lpNumberOfBytesRead: Ptr[UInt], lpOverlapped: Ptr[u8]) -> Bool
  def WriteFile(hFile: Int, lpBuffer: Ptr[u8], nNumberOfBytesToWrite: UInt,
                lpNumberOfBytesWritten: Ptr[UInt], lpOverlapped: Ptr[u8]) -> Bool
  def SetFilePointer(hFile: Int, lDistanceToMove: i64, lpDistanceToMoveHigh: Ptr[i64],
                     dwMoveMethod: UInt) -> UInt
  def GetFileSize(hFile: Int, lpFileSizeHigh: Ptr[UInt]) -> UInt
