# ═══════════════════════════════════════════════════════════════
# Platform Detection
# ═══════════════════════════════════════════════════════════════
#
# Platform is resolved at compile time via @cfg so each build sees exactly
# one definition of is_macos/is_linux/is_windows. This avoids the runtime
# env-var heuristic (the old __CF_USER_TEXT_ENCODING probe) which gave
# wrong answers whenever the parent process stripped that variable.

@cfg(target_os = "macos")
def is_macos() -> Bool = true
@cfg(target_os = "macos")
def is_linux() -> Bool = false
@cfg(target_os = "macos")
def is_windows() -> Bool = false

@cfg(target_os = "linux")
def is_macos() -> Bool = false
@cfg(target_os = "linux")
def is_linux() -> Bool = true
@cfg(target_os = "linux")
def is_windows() -> Bool = false

@cfg(target_os = "windows")
def is_macos() -> Bool = false
@cfg(target_os = "windows")
def is_linux() -> Bool = false
@cfg(target_os = "windows")
def is_windows() -> Bool = true

