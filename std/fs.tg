# Tangerine Standard Library — tg::fs
# File System Operations
# Complete implementation using syscalls directly
#
# ## Overview
#
# This module provides cross-platform file system operations including:
# - File I/O (read, write, seek)
# - Directory operations (create, remove, list)
# - Path manipulation (join, parent, extension)
# - Metadata queries (size, type, permissions)
# - Buffered I/O (FsBufReader, FsBufWriter)
#
# ## Example Usage
#
# ```tg
# # Reading a file
# match fs::read_to_string("config.json") then
#   when Result::Ok(content) then
#     println("Config: " + content)
#   when Result::Err(e) then
#     println("Error: " + e.message())
# end
#
# # Writing a file
# fs::write_file("output.txt", "Hello, World!")
#
# # Listing a directory
# match fs::read_dir("/home/user") then
#   when Result::Ok(entries) then
#     for entry in entries do
#       println(entry.name)
#     end
#   when Result::Err(e) then
#     println("Error: " + e.message())
# end
#
# # Buffered I/O for large files
# let file = fs::open("large.log", OpenMode::Read)
# let reader = fs::buf_reader_new(file, 8192)
# loop do
#   match fs::buf_reader_read_line(&mut reader) then
#     when Result::Ok(line) then process_line(line)
#     when Result::Err(_) then break
#   end
# end
# ```
#
# ## Platform Support
#
# - Linux: Full support via syscalls
# - macOS: Full support via BSD syscalls
# - Windows: Full support via Win32 API

use std::core::{Option, Result, String, Bool, Int, Unit, Vec}
use std::gfx_errors::{ErrorCode}
use std::io::{syscall1, syscall2, syscall3, syscall4}
use std::ffi::{address_of}

@ffi("c")
extern def _tg_read_vec_u8(fd: Int, buf: &mut Vec[u8], count: UInt) -> Int
end

@ffi("c")
extern def _tg_write_vec_u8(fd: Int, buf: &Vec[u8], count: UInt) -> Int
end

@ffi("c")
extern def libc_write(fd: Int, buf: Ptr[u8], count: UInt) -> Int
end

# [METADATA]
# module: tg::fs
# status: stable
# effects: [Io]
# capabilities: [Fs]
# error_codes: [NotFound, PermissionDenied, AlreadyExists, InvalidInput, Internal]

enum IoError
  NotFound(String)
  PermissionDenied(String)
  AlreadyExists(String)
  InvalidInput(String)
  UnexpectedEof(String)
  TimedOut(String)
  Internal(String)
end

impl IoError
  def message(self: &IoError) -> String
    match self
    when IoError::NotFound(s) then "not found: " + s.clone()
    when IoError::PermissionDenied(s) then "permission denied: " + s.clone()
    when IoError::AlreadyExists(s) then "already exists: " + s.clone()
    when IoError::InvalidInput(s) then "invalid input: " + s.clone()
    when IoError::UnexpectedEof(s) then "unexpected EOF: " + s.clone()
    when IoError::TimedOut(s) then "timed out: " + s.clone()
    when IoError::Internal(s) then s.clone()
    end
  end

  def code(self: &IoError) -> ErrorCode
    match self
    when IoError::NotFound(_) then ErrorCode::IOError
    when IoError::PermissionDenied(_) then ErrorCode::PermissionDenied
    when IoError::AlreadyExists(_) then ErrorCode::IOError
    when IoError::InvalidInput(_) then ErrorCode::InvalidArg
    when IoError::UnexpectedEof(_) then ErrorCode::IOError
    when IoError::TimedOut(_) then ErrorCode::IOError
    when IoError::Internal(_) then ErrorCode::Internal
    end
  end

  def from_errno(errno: Int, context: String) -> IoError
    if errno == 2 then
      IoError::NotFound(context)
    elsif errno == 13 then
      IoError::PermissionDenied(context)
    elsif errno == 17 then
      IoError::AlreadyExists(context)
    elsif errno == 22 then
      IoError::InvalidInput(context)
    elsif errno == 60 || errno == 110 then
      IoError::TimedOut(context)
    else
      IoError::Internal(context + ": errno=" + errno.to_string())
    end
  end

  def from_win32_error(err: Int, context: String) -> IoError
    if err == 2 || err == 3 then
      IoError::NotFound(context)
    elsif err == 5 then
      IoError::PermissionDenied(context)
    elsif err == 80 || err == 183 then
      IoError::AlreadyExists(context)
    elsif err == 87 then
      IoError::InvalidInput(context)
    elsif err == 1460 then
      IoError::TimedOut(context)
    else
      IoError::Internal(context + ": win32=" + err.to_string())
    end
  end
end

# ═══════════════════════════════════════════════════════════════
# File Types and Constants
# ═══════════════════════════════════════════════════════════════

struct File
  fd: Int
  path: String
  is_open: Bool
end

struct FileMetadata
  size: UInt
  is_dir: Bool
  is_file: Bool
  is_symlink: Bool
  read_only: Bool
  modified_time: i64
  accessed_time: i64
  created_time: i64
end

struct DirEntry
  name: String
  path: String
  metadata: FileMetadata
end

enum OpenMode
  Read           # O_RDONLY
  Write          # O_WRONLY
  ReadWrite      # O_RDWR
  Append         # O_WRONLY | O_APPEND
  Create         # O_WRONLY | O_CREAT
  CreateReadWrite # O_RDWR | O_CREAT
  Truncate       # O_WRONLY | O_CREAT | O_TRUNC
end

enum SeekFrom
  Start(UInt)
  Current(i64)
  End(i64)
end

# File permissions
def S_IRUSR() -> UInt = 0o400
def S_IWUSR() -> UInt = 0o200
def S_IXUSR() -> UInt = 0o100
def S_IRGRP() -> UInt = 0o040
def S_IWGRP() -> UInt = 0o020
def S_IXGRP() -> UInt = 0o010
def S_IROTH() -> UInt = 0o004
def S_IWOTH() -> UInt = 0o002
def S_IXOTH() -> UInt = 0o001
def S_DEFAULT() -> UInt = 0o644  # rw-r--r--

# Syscall constants - platform specific
# Linux x86_64 syscall numbers
def SYS_READ() -> Int = 0
def SYS_WRITE() -> Int = 1
def SYS_OPEN() -> Int = 2
def SYS_CLOSE() -> Int = 3
def SYS_STAT() -> Int = 4
def SYS_FSTAT() -> Int = 5
def SYS_LSTAT() -> Int = 6
def SYS_LSEEK() -> Int = 8
def SYS_MMAP() -> Int = 9
def SYS_MUNMAP() -> Int = 11
def SYS_IOCTL() -> Int = 16
def SYS_DUP() -> Int = 32
def SYS_DUP2() -> Int = 33
def SYS_GETCWD() -> Int = 79
def SYS_CHDIR() -> Int = 80
def SYS_MKDIR() -> Int = 83
def SYS_RMDIR() -> Int = 84
def SYS_UNLINK() -> Int = 87
def SYS_SYMLINK() -> Int = 88
def SYS_READLINK() -> Int = 89
def SYS_CHMOD() -> Int = 90
def SYS_RENAME() -> Int = 82
def SYS_GETDENTS64() -> Int = 217

# macOS syscall numbers, stored in the compiler's pre-adjusted form.
# Native AArch64 syscall lowering adds +3 before issuing SVC.
def SYS_READ_MAC() -> Int = 0
def SYS_WRITE_MAC() -> Int = 1
def SYS_OPEN_MAC() -> Int = 2
def SYS_CLOSE_MAC() -> Int = 3
def SYS_STAT_MAC() -> Int = 188
def SYS_FSTAT_MAC() -> Int = 186
def SYS_LSTAT_MAC() -> Int = 187
def SYS_LSEEK_MAC() -> Int = 196
def SYS_MMAP_MAC() -> Int = 197
def SYS_MUNMAP_MAC() -> Int = 70
def SYS_MKDIR_MAC() -> Int = 133
def SYS_RMDIR_MAC() -> Int = 134
def SYS_UNLINK_MAC() -> Int = 7
def SYS_SYMLINK_MAC() -> Int = 54
def SYS_READLINK_MAC() -> Int = 55
def SYS_CHMOD_MAC() -> Int = 12
def SYS_RENAME_MAC() -> Int = 125
def SYS_GETCWD_MAC() -> Int = 310
def SYS_CHDIR_MAC() -> Int = 9

# Open flags - Unix
def O_RDONLY() -> Int = 0
def O_WRONLY() -> Int = 1
def O_RDWR() -> Int = 2
def O_CREAT() -> Int = if is_linux() then 64 else 512 end
def O_TRUNC() -> Int = if is_linux() then 512 else 1024 end
def O_APPEND() -> Int = if is_linux() then 1024 else 8 end
def O_DIRECTORY() -> Int = 65536
def O_CLOEXEC() -> Int = 524288
def O_EXCL() -> Int = if is_linux() then 128 else 2048 end  # Linux 0x80, macOS 0x800

