  def CreateDirectoryW(lpPathName: Ptr[u16], lpSecurityAttributes: Ptr[u8]) -> Bool
  def RemoveDirectoryW(lpPathName: Ptr[u16]) -> Bool
  def DeleteFileW(lpPathName: Ptr[u16]) -> Bool
  def MoveFileW(lpExistingFileName: Ptr[u16], lpNewFileName: Ptr[u16]) -> Bool
