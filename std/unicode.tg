# Compiler Intrinsics
# ═══════════════════════════════════════════════════════════════

extern def __intrinsic_unicode_is_alphabetic(cp: Int) -> Bool
extern def __intrinsic_unicode_is_numeric(cp: Int) -> Bool
extern def __intrinsic_unicode_is_uppercase(cp: Int) -> Bool
extern def __intrinsic_unicode_is_lowercase(cp: Int) -> Bool
extern def __intrinsic_unicode_is_xid_start(cp: Int) -> Bool
extern def __intrinsic_unicode_is_xid_continue(cp: Int) -> Bool
extern def __intrinsic_unicode_is_combining(cp: Int) -> Bool
extern def __intrinsic_unicode_is_emoji_presentation(cp: Int) -> Bool
extern def __intrinsic_unicode_to_uppercase(cp: Int) -> Vec[Char]
extern def __intrinsic_unicode_to_lowercase(cp: Int) -> Vec[Char]
extern def __intrinsic_unicode_to_titlecase(cp: Int) -> Vec[Char]
extern def __intrinsic_unicode_next_grapheme_break(s: String, offset: Int) -> Int
extern def __intrinsic_unicode_canonical_decompose(s: String) -> String
extern def __intrinsic_unicode_compatibility_decompose(s: String) -> String
extern def __intrinsic_unicode_canonical_compose(s: String) -> String
extern def __intrinsic_unicode_sort_key(s: String, locale_tag: String) -> Vec[UInt]
