## Tangerine Standard Library — std::unicode
##
## Unicode normalization, character properties, grapheme iteration,
## display width, and collation.
##
## Tracks Unicode version 15.0, as specified in docs/unicode_policy.md §8.
## Uses ICU-derived data tables for normalization and grapheme break.

use std::core::{Option, Result, panic, Ordering}
use std::collections::{Vec}

# ═══════════════════════════════════════════════════════════════
# §7.1.1 — Normalization Forms
# ═══════════════════════════════════════════════════════════════

## Normalize a string to Unicode NFC (Canonical Decomposition, then Canonical Composition).
## Identifiers are compared in NFC form (see unicode_policy.md §3).
def nfc(s: String) -> String
  let decomposed = canonical_decompose(s)
  canonical_compose(decomposed)
end

## Normalize a string to Unicode NFD (Canonical Decomposition).
def nfd(s: String) -> String
  canonical_decompose(s)
end

## Normalize a string to Unicode NFKC (Compatibility Decomposition, then Canonical Composition).
def nfkc(s: String) -> String
  let decomposed = compatibility_decompose(s)
  canonical_compose(decomposed)
end

## Normalize a string to Unicode NFKD (Compatibility Decomposition).
def nfkd(s: String) -> String
  compatibility_decompose(s)
end

## Check if a string is already in NFC form (avoids allocation if so).
def is_nfc(s: String) -> Bool
  nfc(s) == s
end

# ═══════════════════════════════════════════════════════════════
# §7.1.2 — Character Properties
# ═══════════════════════════════════════════════════════════════

## Returns true if the character has the Unicode Alphabetic property.
def is_alphabetic(c: Char) -> Bool
  let cp = c as Int
  # Basic Latin letters
  if (cp >= 0x41 && cp <= 0x5A) || (cp >= 0x61 && cp <= 0x7A) then
    return true
  end
  # Latin-1 Supplement letters
  if (cp >= 0xC0 && cp <= 0xD6) || (cp >= 0xD8 && cp <= 0xF6) ||
     (cp >= 0xF8 && cp <= 0xFF) then
    return true
  end
  # Extended ranges — delegate to intrinsic for full Unicode tables
  __intrinsic_unicode_is_alphabetic(cp)
end

## Returns true if the character has the Unicode Numeric_Type property.
def is_numeric(c: Char) -> Bool
  let cp = c as Int
  if cp >= 0x30 && cp <= 0x39 then return true end
  __intrinsic_unicode_is_numeric(cp)
end

## Returns true if alphabetic or numeric.
def is_alphanumeric(c: Char) -> Bool
  is_alphabetic(c) || is_numeric(c)
end

## Returns true if the character has the White_Space property.
def is_whitespace(c: Char) -> Bool
  let cp = c as Int
  cp == 0x20 || cp == 0x09 || cp == 0x0A || cp == 0x0D ||
  cp == 0x0C || cp == 0x0B ||
  cp == 0xA0 || cp == 0x1680 ||
  (cp >= 0x2000 && cp <= 0x200A) ||
  cp == 0x2028 || cp == 0x2029 || cp == 0x202F ||
  cp == 0x205F || cp == 0x3000 || cp == 0xFEFF
end

## Returns true if the character has the Uppercase property.
def is_uppercase(c: Char) -> Bool
  let cp = c as Int
  if cp >= 0x41 && cp <= 0x5A then return true end
  __intrinsic_unicode_is_uppercase(cp)
end

## Returns true if the character has the Lowercase property.
def is_lowercase(c: Char) -> Bool
  let cp = c as Int
  if cp >= 0x61 && cp <= 0x7A then return true end
  __intrinsic_unicode_is_lowercase(cp)
end

## Returns true if the codepoint is a valid XID_Start character (for identifiers).
def is_xid_start(cp: Int) -> Bool
  if (cp >= 0x41 && cp <= 0x5A) || (cp >= 0x61 && cp <= 0x7A) || cp == 0x5F then
    return true
  end
  __intrinsic_unicode_is_xid_start(cp)
end

## Returns true if the codepoint is a valid XID_Continue character.
def is_xid_continue(cp: Int) -> Bool
  if (cp >= 0x30 && cp <= 0x39) ||
     (cp >= 0x41 && cp <= 0x5A) || (cp >= 0x61 && cp <= 0x7A) || cp == 0x5F then
    return true
  end
  __intrinsic_unicode_is_xid_continue(cp)
end

# ═══════════════════════════════════════════════════════════════
# §7.1.3 — Case Mapping
# ═══════════════════════════════════════════════════════════════

## Convert a string to uppercase using full Unicode case mapping.
def to_uppercase(s: String) -> String
  let result = Vec::new()
  for c in s.chars() do
    let cp = c as Int
    if cp >= 0x61 && cp <= 0x7A then
      result.push((cp - 32) as Char)
    else
      let mapped = __intrinsic_unicode_to_uppercase(cp)
      for mc in mapped do
        result.push(mc)
      end
    end
  end
  String::from_chars(result)
end

## Convert a string to lowercase using full Unicode case mapping.
def to_lowercase(s: String) -> String
  let result = Vec::new()
  for c in s.chars() do
    let cp = c as Int
    if cp >= 0x41 && cp <= 0x5A then
      result.push((cp + 32) as Char)
    else
      let mapped = __intrinsic_unicode_to_lowercase(cp)
      for mc in mapped do
        result.push(mc)
      end
    end
  end
  String::from_chars(result)
end

## Convert a string to titlecase (first letter of each word).
def to_titlecase(s: String) -> String
  let result = Vec::new()
  let at_word_start = true
  for c in s.chars() do
    if is_whitespace(c) then
      result.push(c)
      at_word_start = true
    else if at_word_start then
      let mapped = __intrinsic_unicode_to_titlecase(c as Int)
      for mc in mapped do
        result.push(mc)
      end
      at_word_start = false
    else
      result.push(c)
      at_word_start = false
    end
  end
  String::from_chars(result)
end

# ═══════════════════════════════════════════════════════════════
# §7.1.4 — Grapheme Iteration
# ═══════════════════════════════════════════════════════════════

## Iterate over extended grapheme clusters in a string.
## A grapheme cluster is what humans perceive as a single "character",
## e.g. flag emoji (🇺🇸), skin-tone modified emoji, Hangul syllables.
## Uses UAX#29 extended grapheme cluster rules.
struct GraphemeIterator
  source: String
  byte_offset: Int
end

def graphemes(s: String) -> GraphemeIterator
  GraphemeIterator { source: s, byte_offset: 0 }
end

impl Iterator[String] for GraphemeIterator
  def next(self: &mut GraphemeIterator) -> Option[String]
    if self.byte_offset >= self.source.len() then
      return Option::None
    end
    let start = self.byte_offset
    let end_offset = __intrinsic_unicode_next_grapheme_break(self.source, start)
    if end_offset <= start then
      return Option::None
    end
    self.byte_offset = end_offset
    Option::Some(self.source.slice(start, end_offset))
  end
end

## Count the number of grapheme clusters in a string.
def grapheme_count(s: String) -> Int
  let count = 0
  let iter = graphemes(s)
  while iter.next().is_some() do
    count = count + 1
  end
  count
end

# ═══════════════════════════════════════════════════════════════
# §7.1.5 — Display Width (East Asian Width + Emoji)
# ═══════════════════════════════════════════════════════════════

## Calculate the terminal display width of a string in columns.
## Uses UAX#11 East Asian Width for CJK characters (2 columns),
## and emoji properties for wide emoji (2 columns).
## Zero-width characters (combining marks, ZWJ, etc.) contribute 0 columns.
def display_width(s: String) -> UInt
  let width: UInt = 0
  let iter = graphemes(s)
  match iter.next()
    when Option::Some(cluster) then
      width = width + grapheme_width(cluster)
    when Option::None then ()
  end
  width
end

## Get the display width of a single grapheme cluster.
def grapheme_width(cluster: String) -> UInt
  if cluster.is_empty() then return 0 end
  let first_cp = cluster.char_at(0) as Int
  # Control characters
  if first_cp < 0x20 || (first_cp >= 0x7F && first_cp < 0xA0) then
    return 0
  end
  # Combining marks (general category M)
  if __intrinsic_unicode_is_combining(first_cp) then
    return 0
  end
  # Zero-width characters: ZWJ, ZWNJ, soft hyphen, etc.
  if first_cp == 0x200B || first_cp == 0x200C || first_cp == 0x200D ||
     first_cp == 0xFEFF || first_cp == 0x00AD then
    return 0
  end
  # East Asian Wide and Fullwidth (W, F)
  if is_east_asian_wide(first_cp) then return 2 end
  # Emoji presentation
  if __intrinsic_unicode_is_emoji_presentation(first_cp) then return 2 end
  # Default: single column
  1
end

## Check if a codepoint has East Asian Width W (Wide) or F (Fullwidth).
def is_east_asian_wide(cp: Int) -> Bool
  # CJK Unified Ideographs range
  (cp >= 0x4E00 && cp <= 0x9FFF) ||
  # CJK Extension A
  (cp >= 0x3400 && cp <= 0x4DBF) ||
  # CJK Compatibility Ideographs
  (cp >= 0xF900 && cp <= 0xFAFF) ||
  # Fullwidth Forms
  (cp >= 0xFF01 && cp <= 0xFF60) ||
  (cp >= 0xFFE0 && cp <= 0xFFE6) ||
  # Hangul Syllables
  (cp >= 0xAC00 && cp <= 0xD7AF) ||
  # CJK Radicals Supplement through CJK Strokes
  (cp >= 0x2E80 && cp <= 0x303E) ||
  # Katakana, Hiragana
  (cp >= 0x3040 && cp <= 0x30FF) ||
  # Bopomofo
  (cp >= 0x3100 && cp <= 0x312F) ||
  # Enclosed CJK
  (cp >= 0x3200 && cp <= 0x33FF) ||
  # CJK Extension B and beyond
  (cp >= 0x20000 && cp <= 0x2FA1F)
end

# ═══════════════════════════════════════════════════════════════
# §7.1.6 — Collation
# ═══════════════════════════════════════════════════════════════

## Compare two strings using locale-aware Unicode collation (UCA).
## Uses CLDR collation tailoring for the given locale.
def collate(a: String, b: String, locale: Locale) -> Ordering
  let keys_a = collation_sort_key(a, locale)
  let keys_b = collation_sort_key(b, locale)
  compare_sort_keys(keys_a, keys_b)
end

## Generate a sort key for a string under a given locale.
def collation_sort_key(s: String, locale: Locale) -> Vec[UInt]
  __intrinsic_unicode_sort_key(s, locale.tag)
end

## Compare two sort key vectors lexicographically.
def compare_sort_keys(a: Vec[UInt], b: Vec[UInt]) -> Ordering
  let len = if a.len() < b.len() then a.len() else b.len() end
  for i in 0..len do
    if a[i] < b[i] then return Ordering::Less end
    if a[i] > b[i] then return Ordering::Greater end
  end
  if a.len() < b.len() then Ordering::Less
  else if a.len() > b.len() then Ordering::Greater
  else Ordering::Equal
  end
end

# ═══════════════════════════════════════════════════════════════
# Internal — Normalization Engine
# ═══════════════════════════════════════════════════════════════

def canonical_decompose(s: String) -> String
  __intrinsic_unicode_canonical_decompose(s)
end

def compatibility_decompose(s: String) -> String
  __intrinsic_unicode_compatibility_decompose(s)
end

def canonical_compose(s: String) -> String
  __intrinsic_unicode_canonical_compose(s)
end

