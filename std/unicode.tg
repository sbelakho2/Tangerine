# ═══════════════════════════════════════════════════════════════
# §7.1.2 — Character Properties (the shared UCD tables above)
# ═══════════════════════════════════════════════════════════════

## Returns true if the character has the Unicode Alphabetic property
## (the shared UCD XID_Start BMP table; the underscore is excluded).
def is_alphabetic(c: Char) -> Bool
  let cp = c as Int
  (cp >= 0x41 && cp <= 0x5A) || (cp >= 0x61 && cp <= 0x7A) || xid_start_range(cp)
end

## Returns true if the character has the Unicode Numeric_Type property
## (the ASCII class plus the UCD Nd digit ranges below).
def is_numeric(c: Char) -> Bool
  let cp = c as Int
  if cp >= 0x30 && cp <= 0x39 then return true end
  # Extended digit ranges (Arabic-Indic, Devanagari, etc.) — the UCD Nd
  # ranges this module carries (derived from the same UCD 16.0.0 data)
  (cp >= 0x0660 && cp <= 0x0669) || (cp >= 0x06F0 && cp <= 0x06F9) ||
  (cp >= 0x0966 && cp <= 0x096F) || (cp >= 0x09E6 && cp <= 0x09EF) ||
  (cp >= 0xFF10 && cp <= 0xFF19)
end

## The ASCII digit class (the dialect's numeric-literal class — the
## same fast path the lexer's is_digit uses).
def is_digit(c: Char) -> Bool
  c >= '0' && c <= '9'
end

## Returns true if alphabetic or numeric.
def is_alphanumeric(c: Char) -> Bool
  is_alphabetic(c) || is_numeric(c)
end

## Returns true if the character has the White_Space property (the UCD
## White_Space BMP set).
def is_whitespace(c: Char) -> Bool
  let cp = c as Int
  cp == 0x20 || cp == 0x09 || cp == 0x0A || cp == 0x0D ||
  cp == 0x0C || cp == 0x0B ||
  cp == 0xA0 || cp == 0x1680 ||
  (cp >= 0x2000 && cp <= 0x200A) ||
  cp == 0x2028 || cp == 0x2029 || cp == 0x202F ||
  cp == 0x205F || cp == 0x3000 || cp == 0xFEFF
end

## Returns true if the character has the Uppercase property (the
## documented BMP ranges — NOT the full UCD Uppercase table).
def is_uppercase(c: Char) -> Bool
  let cp = c as Int
  if cp >= 0x41 && cp <= 0x5A then return true end
  # Extended uppercase: Latin Extended, Greek, Cyrillic
  (cp >= 0xC0 && cp <= 0xD6) || (cp >= 0xD8 && cp <= 0xDE) ||
  (cp >= 0x100 && cp <= 0x24E && (cp & 1) == 0) ||
  (cp >= 0x0391 && cp <= 0x03A9 && cp != 0x03A2) ||
  (cp >= 0x0410 && cp <= 0x042F)
end

## Returns true if the character has the Lowercase property (the
## documented BMP ranges — NOT the full UCD Lowercase table).
def is_lowercase(c: Char) -> Bool
  let cp = c as Int
  if cp >= 0x61 && cp <= 0x7A then return true end
  (cp >= 0xDF && cp <= 0xF6) || (cp >= 0xF8 && cp <= 0xFF) ||
  (cp >= 0x101 && cp <= 0x24F && (cp & 1) == 1) ||
  (cp >= 0x03B1 && cp <= 0x03C9) ||
  (cp >= 0x0430 && cp <= 0x044F)
end

## Returns true if the codepoint is a valid XID_Start character — the
## SHARED table (the same predicate the lexer's is_xid_start_scalar
## computes: the ASCII fast path plus the shared BMP ranges).
def is_xid_start(cp: Int) -> Bool
  (cp >= 0x41 && cp <= 0x5A) || (cp >= 0x61 && cp <= 0x7A) || cp == 0x5F || xid_start_range(cp)
end

## Returns true if the codepoint is a valid XID_Continue character —
## the SHARED table (the same predicate the lexer's
## is_xid_continue_scalar computes).
def is_xid_continue(cp: Int) -> Bool
  (cp >= 0x30 && cp <= 0x39) ||
  (cp >= 0x41 && cp <= 0x5A) || (cp >= 0x61 && cp <= 0x7A) || cp == 0x5F ||
  xid_start_range(cp) || xid_continue_range(cp)
end

# ═══════════════════════════════════════════════════════════════
# §7.1.1 — Normalization Forms (the documented SUBSET)
# ═══════════════════════════════════════════════════════════════
# The normalization below implements the precomposed Latin-1 /
# Latin Extended-A pairs and the Hangul syllables listed in the tables
# (the compatibility set: ﬁ ﬂ ² ³ ¹, fullwidth ASCII). Codepoints
# outside the tables pass through unchanged. The lexer's identifier_nfc
# (tg_compiler/lexer.tg) is the COMPLETE NFC oracle; the pinning suite
# tests/unicode_shared_data_test.tg verifies this subset agrees with it.

## Normalize a string to NFC — the documented subset above.
def nfc(s: String) -> String
  let decomposed = canonical_decompose(s)
  canonical_compose(decomposed)
end

## Normalize a string to NFD — the documented subset above.
def nfd(s: String) -> String
  canonical_decompose(s)
end

## Normalize a string to NFKC — the documented subset above.
def nfkc(s: String) -> String
  let decomposed = compatibility_decompose(s)
  canonical_compose(decomposed)
end

## Normalize a string to NFKD — the documented subset above.
def nfkd(s: String) -> String
  compatibility_decompose(s)
end

## Check if a string is already in NFC form (avoids allocation if so).
def is_nfc(s: String) -> Bool
  nfc(s) == s
end

# ═══════════════════════════════════════════════════════════════
# §7.1.3 — Case Mapping
# ═══════════════════════════════════════════════════════════════

## Convert a string to uppercase — the documented BMP ranges (NOT
## full Unicode case mapping: no special-cased or multi-char expansions).
def to_uppercase(s: String) -> String
  let result = Vec::new()
  for c in s.chars() do
    let cp = c as Int
    if cp >= 0x61 && cp <= 0x7A then
      result.push((cp - 32) as Char)
    elsif cp >= 0xE0 && cp <= 0xF6 then
      result.push((cp - 32) as Char)
    elsif cp >= 0xF8 && cp <= 0xFE then
      result.push((cp - 32) as Char)
    elsif cp >= 0x03B1 && cp <= 0x03C9 then
      result.push((cp - 32) as Char)
    elsif cp >= 0x0430 && cp <= 0x044F then
      result.push((cp - 32) as Char)
    else
      result.push(c)
    end
  end
  String::from_chars(result)
end

## Convert a string to lowercase — the documented BMP ranges (NOT
## full Unicode case mapping: no special-cased or multi-char expansions).
def to_lowercase(s: String) -> String
  let result = Vec::new()
  for c in s.chars() do
    let cp = c as Int
    if cp >= 0x41 && cp <= 0x5A then
      result.push((cp + 32) as Char)
    elsif cp >= 0xC0 && cp <= 0xD6 then
      result.push((cp + 32) as Char)
    elsif cp >= 0xD8 && cp <= 0xDE then
      result.push((cp + 32) as Char)
    elsif cp >= 0x0391 && cp <= 0x03A9 && cp != 0x03A2 then
      result.push((cp + 32) as Char)
    elsif cp >= 0x0410 && cp <= 0x042F then
      result.push((cp + 32) as Char)
    else
      result.push(c)
    end
  end
  String::from_chars(result)
end

## Convert a string to titlecase (first letter of each word).
def to_titlecase(s: String) -> String
  let mut result = Vec::new()
  let mut at_word_start = true
  for c in s.chars() do
    if is_whitespace(c) then
      result.push(c)
      at_word_start = true
    elsif at_word_start then
      let cp = c as Int
      if cp >= 0x61 && cp <= 0x7A then
        result.push((cp - 32) as Char)
      elsif cp >= 0xE0 && cp <= 0xF6 then
        result.push((cp - 32) as Char)
      elsif cp >= 0x03B1 && cp <= 0x03C9 then
        result.push((cp - 32) as Char)
      elsif cp >= 0x0430 && cp <= 0x044F then
        result.push((cp - 32) as Char)
      else
        result.push(c)
      end
      at_word_start = false
    else
      result.push(c)
      at_word_start = false
    end
  end
  String::from_chars(result)
end

# ═══════════════════════════════════════════════════════════════
# §7.1.4 — Grapheme Iteration
# ═══════════════════════════════════════════════════════════════

## Iterate over grapheme clusters in a string — the SIMPLIFIED UAX#29
## subset: combining marks, ZWJ sequences (emoji), and variation
## selectors extend the cluster. Regional-indicator pairs (flag emoji)
## and the full break rules are NOT implemented.
struct GraphemeIterator
  source: String
  byte_offset: Int
end

def graphemes(s: String) -> GraphemeIterator
  GraphemeIterator { source: s, byte_offset: 0 }
end

impl Iterator[String] for GraphemeIterator
  def next(inout self: GraphemeIterator) -> Option[String]
    if self.byte_offset >= self.source.len() then
      return Option::None
    end
    let start = self.byte_offset
    let end_offset = _next_grapheme_break(self.source, start)
    if end_offset <= start then
      return Option::None
    end
    self.byte_offset = end_offset
    Option::Some(self.source.slice(start, end_offset))
  end
end

## Count the number of grapheme clusters in a string.
def grapheme_count(s: String) -> Int
  let mut count = 0
  let mut iter = graphemes(s)
  while iter.next().is_some() do
    count = count + 1
  end
  count
end

# ═══════════════════════════════════════════════════════════════
# §7.1.5 — Display Width (East Asian Width + Emoji)
# ═══════════════════════════════════════════════════════════════

## Calculate the terminal display width of a string in columns — the
## UAX#11 East Asian Width W/F ranges and the emoji-presentation ranges
## listed below (2 columns); zero-width characters (combining marks,
## ZWJ, etc.) contribute 0 columns.
def display_width(s: String) -> UInt
  let mut width: UInt = 0
  let mut iter = graphemes(s)
  loop
    match iter.next()
    when Option::Some(cluster) then
      width = width + grapheme_width(cluster)
    when Option::None then
      break
    end
  end
  width
end

## Get the display width of a single grapheme cluster.
def grapheme_width(cluster: String) -> UInt
  if cluster.is_empty() then return 0 end
  let mut has_visible = false
  let mut has_wide = false
  let mut has_emoji = false

  for ch in cluster.chars() do
    let cp = ch as Int

    # Control characters are non-printing.
    if cp < 0x20 || (cp >= 0x7F && cp < 0xA0) then
      continue
    end

    # Combining marks and zero-width controls contribute no width.
    if _is_combining_mark(cp) then
      continue
    end
    if cp == 0x200B || cp == 0x200C || cp == 0x200D ||
       cp == 0xFEFF || cp == 0x00AD then
      continue
    end

    has_visible = true
    if is_east_asian_wide(cp) then has_wide = true end
    if _is_emoji_presentation(cp) then has_emoji = true end
  end

  if !has_visible then
    0
  elsif has_wide || has_emoji then
    2
  else
    1
  end
end

## Check if a codepoint has East Asian Width W (Wide) or F (Fullwidth).
def is_east_asian_wide(cp: Int) -> Bool
  # CJK Unified Ideographs range
  (cp >= 0x4E00 && cp <= 0x9FFF) ||
  # CJK Extension A
  (cp >= 0x3400 && cp <= 0x4DBF) ||
  # CJK Compatibility Ideographs
  (cp >= 0xF900 && cp <= 0xFAFF) ||
  # Fullwidth Forms
  (cp >= 0xFF01 && cp <= 0xFF60) ||
  (cp >= 0xFFE0 && cp <= 0xFFE6) ||
  # Hangul Syllables
  (cp >= 0xAC00 && cp <= 0xD7AF) ||
  # CJK Radicals Supplement through CJK Strokes
  (cp >= 0x2E80 && cp <= 0x303E) ||
  # Katakana, Hiragana
  (cp >= 0x3040 && cp <= 0x30FF) ||
  # Bopomofo
  (cp >= 0x3100 && cp <= 0x312F) ||
  # Enclosed CJK
  (cp >= 0x3200 && cp <= 0x33FF) ||
  # CJK Extension B and beyond
  (cp >= 0x20000 && cp <= 0x2FA1F)
end

# ═══════════════════════════════════════════════════════════════
# §7.1.6 — Collation
# ═══════════════════════════════════════════════════════════════

## Compare two strings using the simple case-insensitive codepoint
## sort key below (NOT the full UCA/DUCET collation; the locale is
## accepted for API compatibility and does not tailor the weights).
def collate(a: String, b: String, locale: Locale) -> Ordering
  let keys_a = collation_sort_key(a, locale)
  let keys_b = collation_sort_key(b, locale)
  compare_sort_keys(keys_a, keys_b)
end

## Generate a sort key for a string (the simple primary/secondary
## codepoint key — NOT DUCET-based; the locale is accepted for API
## compatibility and does not tailor the weights).
def collation_sort_key(s: String, locale: Locale) -> Vec[UInt]
  ## Assigns primary weight = codepoint for basic ordering.
  let mut keys = Vec::new()
  for c in s.chars() do
    let cp = c as UInt
    ## Primary weight: map to collation element
    if cp >= 0x61 && cp <= 0x7A then
      keys.push(cp - 0x61 + 0x0E00)  ## lowercase -> base CE
    elsif cp >= 0x41 && cp <= 0x5A then
      keys.push(cp - 0x41 + 0x0E00)  ## uppercase -> same base CE
    elsif cp >= 0x30 && cp <= 0x39 then
      keys.push(cp - 0x30 + 0x0200)  ## digits
    else
      keys.push(cp + 0x1000)  ## other codepoints
    end
  end
  ## Append separator, then secondary weights (case level)
  keys.push(0)
  for c in s.chars() do
    let cp = c as UInt
    if cp >= 0x41 && cp <= 0x5A then
      keys.push(0x08)  ## uppercase secondary weight
    else
      keys.push(0x02)  ## lowercase/other secondary weight
    end
  end
  keys
end

## Compare two sort key vectors lexicographically.
def compare_sort_keys(a: Vec[UInt], b: Vec[UInt]) -> Ordering
  let len = if a.len() < b.len() then a.len() else b.len() end
  for i in 0..len do
    if a[i] < b[i] then return Ordering::Less end
    if a[i] > b[i] then return Ordering::Greater end
  end
  if a.len() < b.len() then Ordering::Less
  elsif a.len() > b.len() then Ordering::Greater
  else Ordering::Equal
  end
end

# ═══════════════════════════════════════════════════════════════
# Internal — Normalization Engine
# ═══════════════════════════════════════════════════════════════

def canonical_decompose(s: String) -> String
  ## Canonical decomposition (NFD): decompose each character to its canonical
  ## decomposition, then sort combining marks by Canonical Combining Class.
  let mut result = Vec::new()
  for c in s.chars() do
    let decomp = _get_canonical_decomposition(c as Int)
    for d in decomp do
      result.push(d)
    end
  end
  ## Sort combining marks by canonical combining class (bubble sort on adjacent marks)
  _sort_combining_marks(&mut result)
  String::from_chars(result)
end

def compatibility_decompose(s: String) -> String
  ## Compatibility decomposition (NFKD): like canonical but also applies
  ## compatibility mappings (e.g. ﬁ → fi, ² → 2).
  let mut result = Vec::new()
  for c in s.chars() do
    let decomp = _get_compatibility_decomposition(c as Int)
    for d in decomp do
      result.push(d)
    end
  end
  _sort_combining_marks(&mut result)
  String::from_chars(result)
end

def canonical_compose(s: String) -> String
  ## Canonical composition: combine decomposed characters back into
  ## precomposed forms where a canonical mapping exists.
  let chars = s.chars().collect()
  let mut result = Vec::new()
  let mut i = 0
  while i < chars.len() do
    let mut starter = chars[i]
    let mut j = i + 1
    while j < chars.len() && _is_combining_mark(chars[j] as Int) do
      let composed = _try_compose(starter as Int, chars[j] as Int)
      match composed
      when Option::Some(c) then starter = c
      when Option::None then result.push(chars[j])
      end
      j = j + 1
    end
    result.push(starter)
    i = j
    if j == i then i = i + 1 end
  end
  String::from_chars(result)
end

# ═══════════════════════════════════════════════════════════════
# Internal Helper Functions (replacing intrinsics)
# ═══════════════════════════════════════════════════════════════

## Check if codepoint is a combining mark (General Category M).
def _is_combining_mark(cp: Int) -> Bool
  # Combining Diacritical Marks
  (cp >= 0x0300 && cp <= 0x036F) ||
  # Hebrew accents and points
  (cp >= 0x0591 && cp <= 0x05BD) || cp == 0x05BF ||
  (cp >= 0x05C1 && cp <= 0x05C2) || cp == 0x05C4 || cp == 0x05C5 || cp == 0x05C7 ||
  # Arabic combining marks
  (cp >= 0x0610 && cp <= 0x061A) ||
  (cp >= 0x064B && cp <= 0x065F) || cp == 0x0670 ||
  (cp >= 0x06D6 && cp <= 0x06DC) || (cp >= 0x06DF && cp <= 0x06E4) ||
  # Devanagari combining marks
  (cp >= 0x093A && cp <= 0x094F) || (cp >= 0x0951 && cp <= 0x0957) ||
  # Combining Diacritical Marks Extended
  (cp >= 0x1AB0 && cp <= 0x1AFF) ||
  # Combining Diacritical Marks Supplement
  (cp >= 0x1DC0 && cp <= 0x1DFF) ||
  # Combining Diacritical Marks for Symbols
  (cp >= 0x20D0 && cp <= 0x20FF) ||
  # Combining Half Marks
  (cp >= 0xFE20 && cp <= 0xFE2F)
end

## Check if codepoint has Emoji_Presentation property.
def _is_emoji_presentation(cp: Int) -> Bool
  # Common emoji with default emoji presentation
  (cp >= 0x1F600 && cp <= 0x1F64F) ||  # Emoticons
  (cp >= 0x1F300 && cp <= 0x1F5FF) ||  # Misc Symbols and Pictographs
  (cp >= 0x1F680 && cp <= 0x1F6FF) ||  # Transport and Map
  (cp >= 0x1F900 && cp <= 0x1F9FF) ||  # Supplemental Symbols
  (cp >= 0x1FA00 && cp <= 0x1FA6F) ||  # Chess, extended-A
  (cp >= 0x1FA70 && cp <= 0x1FAFF) ||  # Symbols extended-A
  (cp >= 0x2600 && cp <= 0x26FF) ||    # Misc Symbols
  (cp >= 0x2700 && cp <= 0x27BF) ||    # Dingbats
  cp == 0x231A || cp == 0x231B ||      # Watch, Hourglass
  cp == 0x23E9 || cp == 0x23EA || cp == 0x23EB || cp == 0x23EC ||
  cp == 0x23F0 || cp == 0x23F3 ||
  cp == 0x25AA || cp == 0x25AB || cp == 0x25B6 || cp == 0x25C0 ||
  cp == 0x25FB || cp == 0x25FC || cp == 0x25FD || cp == 0x25FE
end

## Find next grapheme cluster break position using simplified UAX#29 rules.
def _next_grapheme_break(s: String, offset: Int) -> Int
  let bytes = s.as_bytes()
  if offset >= bytes.len() then return offset end
  ## Decode one codepoint and advance past it
  let mut pos = offset
  pos = _skip_one_codepoint(bytes, pos)
  ## Extend the cluster to include combining marks, ZWJ sequences, and regional indicators
  while pos < bytes.len() do
    let cp = _peek_codepoint(bytes, pos)
    ## Extend through combining marks (Mn, Mc, Me)
    if _is_combining_mark(cp) then
      pos = _skip_one_codepoint(bytes, pos)
      continue
    end
    ## Extend through ZWJ sequences (for emoji)
    if cp == 0x200D then
      let next_pos = _skip_one_codepoint(bytes, pos)
      if next_pos < bytes.len() then
        pos = _skip_one_codepoint(bytes, next_pos)
        continue
      end
    end
    ## Extend through variation selectors
    if (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0xE0100 && cp <= 0xE01EF) then
      pos = _skip_one_codepoint(bytes, pos)
      continue
    end
    break
  end
  pos
end

## Decode the codepoint at byte offset without advancing (UTF-8).
def _peek_codepoint(bytes: [u8], offset: Int) -> Int
  if offset >= bytes.len() then return 0 end
  let b0 = bytes[offset] as Int
  if b0 < 0x80 then return b0 end
  if b0 < 0xE0 && offset + 1 < bytes.len() then
    return ((b0 & 0x1F) << 6) | (bytes[offset + 1] as Int & 0x3F)
  end
  if b0 < 0xF0 && offset + 2 < bytes.len() then
    return ((b0 & 0x0F) << 12) | ((bytes[offset + 1] as Int & 0x3F) << 6) |
           (bytes[offset + 2] as Int & 0x3F)
  end
  if offset + 3 < bytes.len() then
    return ((b0 & 0x07) << 18) | ((bytes[offset + 1] as Int & 0x3F) << 12) |
           ((bytes[offset + 2] as Int & 0x3F) << 6) | (bytes[offset + 3] as Int & 0x3F)
  end
  0xFFFD
end

## Skip one UTF-8 encoded codepoint, returning the new byte offset.
def _skip_one_codepoint(bytes: [u8], offset: Int) -> Int
  if offset >= bytes.len() then return offset end
  let b0 = bytes[offset] as Int
  if b0 < 0x80 then offset + 1
  elsif b0 < 0xE0 then offset + 2
  elsif b0 < 0xF0 then offset + 3
  else offset + 4
  end
end

## Get canonical combining class for a codepoint.
def _combining_class(cp: Int) -> Int
  ## Common combining classes for frequently used marks
  if cp >= 0x0300 && cp <= 0x0314 then return 230 end  ## Above
  if cp >= 0x0315 && cp <= 0x0315 then return 232 end
  if cp >= 0x0316 && cp <= 0x0319 then return 220 end  ## Below
  if cp >= 0x031A && cp <= 0x031A then return 232 end
  if cp >= 0x031B && cp <= 0x031B then return 216 end
  if cp >= 0x0327 && cp <= 0x0328 then return 202 end  ## Attached below
  if cp >= 0x0334 && cp <= 0x0338 then return 1 end    ## Overlay
  if cp >= 0x0591 && cp <= 0x05BD then return 220 end  ## Hebrew below
  if cp >= 0x064B && cp <= 0x065F then return 230 end  ## Arabic above
  0
end

## Sort combining marks by canonical combining class (stable bubble sort).
def _sort_combining_marks(inout chars: Vec[Char]) -> Unit
  let n = chars.len()
  let mut i = 1
  while i < n do
    let cc_i = _combining_class(chars[i] as Int)
    if cc_i > 0 then
      let mut j = i
      while j > 0 do
        let cc_j = _combining_class(chars[j - 1] as Int)
        if cc_j > cc_i && cc_j > 0 then
          let tmp = chars[j]
          chars[j] = chars[j - 1]
          chars[j - 1] = tmp
          j = j - 1
        else
          break
        end
      end
    end
    i = i + 1
  end
end

## Get canonical decomposition of a codepoint (returns Vec of chars).
def _get_canonical_decomposition(cp: Int) -> Vec[Char]
  ## Common precomposed Latin characters
  if cp == 0xC0 then return Vec::from([0x41 as Char, 0x0300 as Char]) end  ## À
  if cp == 0xC1 then return Vec::from([0x41 as Char, 0x0301 as Char]) end  ## Á
  if cp == 0xC2 then return Vec::from([0x41 as Char, 0x0302 as Char]) end  ## Â
  if cp == 0xC3 then return Vec::from([0x41 as Char, 0x0303 as Char]) end  ## Ã
  if cp == 0xC4 then return Vec::from([0x41 as Char, 0x0308 as Char]) end  ## Ä
  if cp == 0xC7 then return Vec::from([0x43 as Char, 0x0327 as Char]) end  ## Ç
  if cp == 0xC8 then return Vec::from([0x45 as Char, 0x0300 as Char]) end  ## È
  if cp == 0xC9 then return Vec::from([0x45 as Char, 0x0301 as Char]) end  ## É
  if cp == 0xCA then return Vec::from([0x45 as Char, 0x0302 as Char]) end  ## Ê
  if cp == 0xCB then return Vec::from([0x45 as Char, 0x0308 as Char]) end  ## Ë
  if cp == 0xCC then return Vec::from([0x49 as Char, 0x0300 as Char]) end  ## Ì
  if cp == 0xCD then return Vec::from([0x49 as Char, 0x0301 as Char]) end  ## Í
  if cp == 0xD1 then return Vec::from([0x4E as Char, 0x0303 as Char]) end  ## Ñ
  if cp == 0xD2 then return Vec::from([0x4F as Char, 0x0300 as Char]) end  ## Ò
  if cp == 0xD3 then return Vec::from([0x4F as Char, 0x0301 as Char]) end  ## Ó
  if cp == 0xD9 then return Vec::from([0x55 as Char, 0x0300 as Char]) end  ## Ù
  if cp == 0xDA then return Vec::from([0x55 as Char, 0x0301 as Char]) end  ## Ú
  if cp == 0xE0 then return Vec::from([0x61 as Char, 0x0300 as Char]) end  ## à
  if cp == 0xE1 then return Vec::from([0x61 as Char, 0x0301 as Char]) end  ## á
  if cp == 0xE8 then return Vec::from([0x65 as Char, 0x0300 as Char]) end  ## è
  if cp == 0xE9 then return Vec::from([0x65 as Char, 0x0301 as Char]) end  ## é
  if cp == 0xF1 then return Vec::from([0x6E as Char, 0x0303 as Char]) end  ## ñ
  if cp == 0xF2 then return Vec::from([0x6F as Char, 0x0300 as Char]) end  ## ò
  if cp == 0xF3 then return Vec::from([0x6F as Char, 0x0301 as Char]) end  ## ó
  if cp == 0xFC then return Vec::from([0x75 as Char, 0x0308 as Char]) end  ## ü
  ## Hangul syllable decomposition (algorithmic)
  if cp >= 0xAC00 && cp <= 0xD7A3 then
    let s_idx = cp - 0xAC00
    let l = 0x1100 + s_idx / 588  ## leading consonant
    let v = 0x1161 + (s_idx % 588) / 28  ## vowel
    let t = s_idx % 28  ## trailing consonant
    let mut result = Vec::from([l as Char, v as Char])
    if t != 0 then result.push((0x11A7 + t) as Char) end
    return result
  end
  ## No decomposition — return the character itself
  Vec::from([cp as Char])
end

## Get compatibility decomposition of a codepoint.
def _get_compatibility_decomposition(cp: Int) -> Vec[Char]
  ## Ligatures
  if cp == 0xFB01 then return Vec::from(['f', 'i']) end  ## ﬁ
  if cp == 0xFB02 then return Vec::from(['f', 'l']) end  ## ﬂ
  ## Superscripts/subscripts
  if cp == 0xB2 then return Vec::from(['2']) end  ## ²
  if cp == 0xB3 then return Vec::from(['3']) end  ## ³
  if cp == 0xB9 then return Vec::from(['1']) end  ## ¹
  ## Fullwidth ASCII
  if cp >= 0xFF01 && cp <= 0xFF5E then
    return Vec::from([(cp - 0xFEE0) as Char])
  end
  ## Halfwidth Katakana
  if cp >= 0xFF65 && cp <= 0xFF9F then
    return Vec::from([cp as Char])
  end
  ## Fall back to canonical decomposition
  _get_canonical_decomposition(cp)
end

## Try to compose two codepoints into one (canonical composition).
def _try_compose(starter: Int, combining: Int) -> Option[Char]
  ## Common compositions (reverse of canonical decomposition)
  if starter == 0x41 && combining == 0x0300 then return Option::Some(0xC0 as Char) end
  if starter == 0x41 && combining == 0x0301 then return Option::Some(0xC1 as Char) end
  if starter == 0x41 && combining == 0x0302 then return Option::Some(0xC2 as Char) end
  if starter == 0x41 && combining == 0x0303 then return Option::Some(0xC3 as Char) end
  if starter == 0x41 && combining == 0x0308 then return Option::Some(0xC4 as Char) end
  if starter == 0x45 && combining == 0x0300 then return Option::Some(0xC8 as Char) end
  if starter == 0x45 && combining == 0x0301 then return Option::Some(0xC9 as Char) end
  if starter == 0x49 && combining == 0x0300 then return Option::Some(0xCC as Char) end
  if starter == 0x49 && combining == 0x0301 then return Option::Some(0xCD as Char) end
  if starter == 0x4E && combining == 0x0303 then return Option::Some(0xD1 as Char) end
  if starter == 0x4F && combining == 0x0300 then return Option::Some(0xD2 as Char) end
  if starter == 0x4F && combining == 0x0301 then return Option::Some(0xD3 as Char) end
  if starter == 0x55 && combining == 0x0300 then return Option::Some(0xD9 as Char) end
  if starter == 0x55 && combining == 0x0301 then return Option::Some(0xDA as Char) end
  if starter == 0x61 && combining == 0x0300 then return Option::Some(0xE0 as Char) end
  if starter == 0x61 && combining == 0x0301 then return Option::Some(0xE1 as Char) end
  if starter == 0x65 && combining == 0x0300 then return Option::Some(0xE8 as Char) end
  if starter == 0x65 && combining == 0x0301 then return Option::Some(0xE9 as Char) end
  if starter == 0x6E && combining == 0x0303 then return Option::Some(0xF1 as Char) end
  if starter == 0x6F && combining == 0x0300 then return Option::Some(0xF2 as Char) end
  if starter == 0x6F && combining == 0x0301 then return Option::Some(0xF3 as Char) end
  if starter == 0x75 && combining == 0x0308 then return Option::Some(0xFC as Char) end
  ## Hangul LV + T composition
  if starter >= 0xAC00 && starter <= 0xD7A3 && combining >= 0x11A8 && combining <= 0x11C2 then
    let s_idx = starter - 0xAC00
    if s_idx % 28 == 0 then
      let composed = starter + (combining - 0x11A7)
      if composed <= 0xD7A3 then return Option::Some(composed as Char) end
    end
  end
  ## Hangul L + V composition
  if starter >= 0x1100 && starter <= 0x1112 && combining >= 0x1161 && combining <= 0x1175 then
    let composed = 0xAC00 + (starter - 0x1100) * 588 + (combining - 0x1161) * 28
    return Option::Some(composed as Char)
  end
  Option::None
end
