# Tangerine Compiler Kernel Archive
#
# Files REMOVED from the bootstrap compiler closure (the kernel).
# These files are part of the FULL compiler only: they are referenced by
# tg_compiler/lib.tg for users embedding the full compiler, but they are
# NOT compiled by the self-hosting bootstrap. Keeping them out of the kernel
# shrinks the bootstrap closure and avoids loading tooling that the kernel
# does not need.
#
# To promote a file back into the kernel, move it to compiler_kernel.manifest
# AND ensure it does not pull in any non-kernel dependency.

# Archived (non-bootstrap) tg_compiler/ modules:
archived: agentic.tg
archived: bindgen.tg
archived: cap_baseline.tg
archived: context_pack.tg
archived: coverage.tg
archived: cqs.tg
archived: cross_compile.tg
archived: debugger.tg
archived: main.tg
archived: pkg_manager.tg
archived: refactor.tg
archived: registry.tg
archived: resolver.tg
archived: symbol_graph.tg
archived: template.tg
archived: util.tg
archived: wasm_target.tg

# lib.tg is the FULL library entry point (kernel + archived modules). It is
# intentionally archived out of the kernel; the bootstrap uses lib_kernel.tg.
archived: lib.tg

# ---------------------------------------------------------------------------
# The following are scratch/test artifacts, not compiler modules, and are
# excluded from the kernel unconditionally:
#   driver.tg.chunk6_v2, empty.tg, hello.tg, hello_minimal.tg, return0.tg
# ---------------------------------------------------------------------------
