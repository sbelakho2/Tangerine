# Tangerine Compiler Kernel Manifest
#
# Single source of truth for the bootstrap compiler closure.
# The self-hosting bootstrap (stage0 OCaml seed and stage1+ native) compiles
# ONLY the files listed here. Everything else under tg_compiler/ is part of
# the FULL compiler and is excluded from the kernel (see
# compiler_kernel.archive).
#
# Adding a file to the kernel grows the bootstrap closure; files must only be
# added when they are actually required to self-host the bootstrap entry
# (bootstrap_main.tg).
#
# Format: one entry per line, "<kind>: <relative/path.tg>". Blank lines and
# lines starting with '#' are ignored.

version: 1

# ---------------------------------------------------------------------------
# Bootstrap stdlib — the minimal stdlib the compiler kernel is closed under.
# Relative to std/. These must remain free of imports outside this set.
# ---------------------------------------------------------------------------
std: alloc.tg
std: collections.tg
std: core.tg
std: ffi.tg
std: fmt.tg
std: fs.tg
std: io.tg
std: taint.tg
std: args.tg
std: env.tg
std: bench.tg
std: process.tg
std: gfx_errors.tg
std: time.tg

# ---------------------------------------------------------------------------
# Compiler kernel modules — the minimal self-hostable subset of tg_compiler/.
# Relative to tg_compiler/. This is the transitive dependency closure of the
# bootstrap entry bootstrap_main.tg (front-end + lowering + codegen + object +
# link, plus compiler_core.tg which supplies the compile/check implementation
# it dispatches to) plus lib_kernel.tg which re-exports only these modules.
#
# lib.tg (the FULL library) and all non-bootstrap tooling modules (agentic,
# bindgen, coverage, cqs, context_pack, cap_baseline, cross_compile, debugger,
# docgen, driver, formatter, linter, pkg_manager, refactor, registry,
# symbol_graph, template, util, wasm_target, main) are intentionally NOT part
# of the kernel; resolver IS part of the kernel (listed below).
# ---------------------------------------------------------------------------
compiler: access_check.tg
compiler: resource_check.tg
compiler: asm.tg
compiler: ast.tg
compiler: bootstrap_main.tg
compiler: codegen.tg
compiler: compiler_core.tg
compiler: ids.tg
compiler: layout_engine.tg
compiler: lexer.tg
compiler: lib_kernel.tg
compiler: linker.tg
compiler: mir.tg
compiler: mode.tg
compiler: mono.tg
compiler: object.tg
compiler: parser.tg
compiler: resolver.tg
compiler: runtime.tg
# stable_ids.tg supplies the persistent semantic identities (StableDeclId,
# StableHirNodeId, StableMirNodeId, StableMirBlockId, StructuralInstanceId,
# ...) that mir.tg/mono.tg import for the P0-4/P0-6/P0-7 identity model.
compiler: stable_ids.tg
# target_desc.tg is required by codegen.tg (and now by layout_engine.tg's
# ABI call plan) — it is a std-only leaf (std::core + std::collections).
compiler: target_desc.tg
compiler: token.tg
compiler: trait_resolve.tg
compiler: types.tg
compiler: version.tg
# ---------------------------------------------------------------------------
# LIR code-generation route closure (fourth-audit P0-21: codegen_default()
# returns CodegenRoute::Lir, so the canonical codegen route is lir.tg).
# lir.tg imports coverage_graph.tg (P0-8 re-keyed the coverage plan onto the
# semantic MIR ids); coverage_graph.tg in turn imports semantic_model.tg and
# semantic_delta.tg, whose closure pulls semantic_index.tg and
# semantic_slice.tg. Listed in dependency order (each module before its
# first importer): semantic_model -> semantic_slice -> semantic_index ->
# semantic_delta -> coverage_graph -> lir.
compiler: semantic_model.tg
compiler: semantic_slice.tg
compiler: semantic_index.tg
compiler: semantic_delta.tg
compiler: coverage_graph.tg
compiler: lir.tg
