# Tangerine Compiler Kernel Manifest
#
# Single source of truth for the bootstrap compiler closure.
# The self-hosting bootstrap (stage0 Swift and stage1+ native) compiles ONLY
# the files listed here. Everything else under tg_compiler/ is part of the
# FULL compiler and is excluded from the kernel (see compiler_kernel.archive).
#
# Adding a file to the kernel grows the bootstrap closure; files must only be
# added when they are actually required to self-host driver.tg.
#
# Format: one entry per line, "<kind>: <relative/path.tg>". Blank lines and
# lines starting with '#' are ignored.

version: 1

# ---------------------------------------------------------------------------
# Bootstrap stdlib — the minimal stdlib the compiler kernel is closed under.
# Relative to std/. These must remain free of imports outside this set.
# ---------------------------------------------------------------------------
std: alloc.tg
std: collections.tg
std: core.tg
std: ffi.tg
std: fmt.tg
std: fs.tg
std: io.tg
std: taint.tg
std: args.tg
std: env.tg
std: bench.tg
std: process.tg
std: gfx_errors.tg
std: time.tg

# ---------------------------------------------------------------------------
# Compiler kernel modules — the minimal self-hostable subset of tg_compiler/.
# Relative to tg_compiler/. This is the transitive dependency closure of
# driver.tg (front-end + lowering + codegen + object + link + tooling) plus
# lib_kernel.tg which re-exports only these modules.
#
# lib.tg (the FULL library) and all non-bootstrap tooling modules (agentic,
# bindgen, coverage, cqs, context_pack, cap_baseline, cross_compile, debugger,
# pkg_manager, refactor, registry, resolver, symbol_graph, template, util,
# wasm_target, main) are intentionally NOT part of the kernel.
# ---------------------------------------------------------------------------
compiler: access_check.tg
compiler: resource_check.tg
compiler: asm.tg
compiler: ast.tg
compiler: codegen.tg
compiler: docgen.tg
compiler: driver.tg
compiler: formatter.tg
compiler: layout_engine.tg
compiler: lexer.tg
compiler: lib_kernel.tg
compiler: linker.tg
compiler: linter.tg
compiler: mir.tg
compiler: mode.tg
compiler: object.tg
compiler: parser.tg
compiler: resolver.tg
compiler: runtime.tg
compiler: token.tg
compiler: trait_resolve.tg
compiler: types.tg
compiler: version.tg
