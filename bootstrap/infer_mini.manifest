# Mini manifest for the kernel-checker infer probe.
#
# (impl-conformance reproduction): the probe's merged mode mirrors the
# REAL compile path's canonical preparation — apply_cfg_elimination +
# prepare_parsed (macro expansion + node-id assignment) — before
# resolve_names/type_check_typed, because the in-VM kernel's impl
# conformance divergences (E0229/E0226/E0224) only reproduce after the
# canonical preparation has run (the real pipeline always expands
# macros; the std's `macro vec!` in collections.tg makes the expansion
# pass rewrite every impl item). compiler_core.tg and its full
# dependency closure (asm/codegen/linker/object/runtime/mono/
# layout_engine/target_desc) are therefore part of this closure.
version: 1
std: alloc.tg
std: core.tg
std: collections.tg
std: taint.tg
std: ffi.tg
std: gfx_errors.tg
std: fmt.tg
std: args.tg
std: env.tg
std: io.tg
std: time.tg
std: fs.tg
std: process.tg
std: bench.tg
compiler: token.tg
compiler: lexer.tg
compiler: parser.tg
compiler: ast.tg
compiler: types.tg
compiler: ids.tg
compiler: stable_ids.tg
compiler: resolver.tg
compiler: access_check.tg
compiler: resource_check.tg
compiler: mir.tg
compiler: layout_engine.tg
compiler: target_desc.tg
compiler: asm.tg
compiler: object.tg
compiler: linker.tg
compiler: runtime.tg
compiler: mode.tg
compiler: codegen.tg
compiler: mono.tg
compiler: compiler_core.tg
compiler: infer_probe.tg
