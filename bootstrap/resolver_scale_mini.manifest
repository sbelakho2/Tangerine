# resolver_scale_mini.manifest — focused resolver bare-name scaling closure.
#
# The kernel front end (lexer + parser + resolver) plus
# tg_compiler/resolver_scale_probe.tg, whose entry generates a synthetic
# single-module program with N functions and Q bare call references, parses it
# with the REAL kernel parser and resolves it with the REAL kernel resolver.
#
# This is the pre-ladder gate for the bare-name resolution scan: before the
# module_symbols bare-name index, every reference scanned the whole symbol map
# (symbols x references VM steps) and the probe exceeded the calibrated seed
# VM step budget; with the index the probe completes with a large margin. The
# closure is the parser/resolver transitive import set; it intentionally omits
# the codegen/MIR modules the resolver probe never touches.
version: 1
std: alloc.tg
std: core.tg
std: collections.tg
std: taint.tg
std: ffi.tg
std: gfx_errors.tg
std: fmt.tg
std: args.tg
std: env.tg
std: io.tg
std: time.tg
std: fs.tg
std: process.tg
compiler: token.tg
compiler: lexer.tg
compiler: ast.tg
compiler: types.tg
compiler: ids.tg
compiler: stable_ids.tg
compiler: resolver.tg
compiler: access_check.tg
compiler: resource_check.tg
compiler: parser.tg
compiler: resolver_scale_probe.tg
