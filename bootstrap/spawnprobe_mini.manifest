# Fast micro-repro closure for the child-process/exec/stderr boundary
# (stage0_ocaml/selfcheck/spawnprobe.tg).  std_only: the probe imports the
# REAL std::process run_command surface, so no copy of the lowering or
# host-binding target is involved.
version: 1
std: alloc.tg
std: core.tg
std: collections.tg
std: taint.tg
std: ffi.tg
std: gfx_errors.tg
std: fmt.tg
std: args.tg
std: env.tg
std: io.tg
std: time.tg
std: fs.tg
std: process.tg
std: bench.tg
selfcheck: spawnprobe.tg
