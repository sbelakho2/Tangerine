# resolution_parity_mini.manifest — the mini closure for the kernel
# resolution-parity lane: the kernel front end (lexer/parser/ast/ids/
# resolver + its transitive imports) plus the resolution probe. The probe
# reads the FULL closure sources (bootstrap/compiler_kernel.manifest) from
# disk and runs the kernel resolver over the merged program, so this
# manifest stays small while the gate covers every closure file.
version: 1
std: alloc.tg
std: core.tg
std: collections.tg
std: taint.tg
std: ffi.tg
std: gfx_errors.tg
std: fmt.tg
std: args.tg
std: env.tg
std: io.tg
std: time.tg
std: fs.tg
std: process.tg
compiler: token.tg
compiler: lexer.tg
compiler: ast.tg
compiler: types.tg
compiler: ids.tg
compiler: stable_ids.tg
compiler: resolver.tg
compiler: access_check.tg
compiler: resource_check.tg
compiler: parser.tg
compiler: resolution_parity_probe.tg
