# parse_parity_mini.manifest — focused kernel parse-parity closure.
#
# The kernel front end (lexer + parser) plus tg_compiler/parse_parity_probe.tg,
# whose entry runs the REAL kernel parser over every source of
# bootstrap/compiler_kernel.manifest (the paths arrive as kernel args from the
# tg_parse_parity selfcheck lane) and reports every file whose parse records
# error diagnostics. This is the pre-ladder gate for seed/kernel grammar
# divergence: the seed parses the mini closure with the OCaml parser, the probe
# runs the kernel parser inside the seed VM.
#
# The closure is the parser's transitive import set (types/resolver/
# resource_check via ids.tg); it intentionally omits the codegen/MIR modules
# the parse-parity lane never touches.
version: 1
std: alloc.tg
std: core.tg
std: collections.tg
std: taint.tg
std: ffi.tg
std: gfx_errors.tg
std: fmt.tg
std: args.tg
std: env.tg
std: io.tg
std: time.tg
std: fs.tg
std: process.tg
compiler: token.tg
compiler: lexer.tg
compiler: ast.tg
compiler: types.tg
compiler: ids.tg
compiler: stable_ids.tg
compiler: resolver.tg
compiler: access_check.tg
compiler: resource_check.tg
compiler: parser.tg
compiler: parse_parity_probe.tg
