# Fast micro-repro closure for the address_of/address_of_mut inout
# pointer boundary (stage0_ocaml/selfcheck/addrprobe.tg).  std_only: the
# probe imports the REAL std::ffi address_of_mut + std::process waitpid,
# so no copy of the lowering target is involved.
version: 1
std: alloc.tg
std: core.tg
std: collections.tg
std: taint.tg
std: ffi.tg
std: gfx_errors.tg
std: fmt.tg
std: args.tg
std: env.tg
std: io.tg
std: time.tg
std: fs.tg
std: process.tg
std: bench.tg
selfcheck: addrprobe.tg
