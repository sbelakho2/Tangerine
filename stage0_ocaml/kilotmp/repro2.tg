enum Effect
  Read
  Modify
  Consume
end

struct Acc
  total: Int
end

def map_insert(inout a: Acc, sink k: Int, sink v: Effect) -> Int
  a.total = a.total + k
  0
end

def strength(e: Effect) -> Int
  match e
  when Effect::Consume then 2
  when Effect::Modify then 1
  when Effect::Read then 0
  end
end

def reg(sink e: Effect) -> Int
  mut a = Acc { total: 0 }
  let s = strength(e)
  let n = map_insert(a, 1, e)
  let c = if e == Effect::Consume then 10 else 0 end
  let d = map_insert(a, 2, e)
  let s2 = strength(e)
  n + s + c + d + s2
end

def main() -> Int
  reg(Effect::Modify)
end
