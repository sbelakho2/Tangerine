enum Maybe
  Yes(Int)
  No
end

struct Rec
  lit: Int
end

struct Store
  items: Int
end

def store_insert(inout s: Store, k: Int, v: Rec) -> Maybe
  s.items = s.items + 1
  Maybe::Yes(k)
end

def lookup(s: Store, k: Int) -> Maybe
  if k > 0 then Maybe::Yes(k) else Maybe::No end
end

def f(inout s: Store, k: Int) -> Int
  let _ = 0
  match lookup(s, k)
  when Maybe::Yes(bottom) then
    match lookup(s, bottom)
    when Maybe::Yes(rec) then
      store_insert(s, bottom, Rec { lit: rec })
    when Maybe::No then ()
    end
  when Maybe::No then ()
  end
  0
end

def main() -> Int
  mut s = Store { items: 0 }
  f(s, 1)
end
