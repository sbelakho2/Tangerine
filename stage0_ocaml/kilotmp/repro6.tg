enum K
  A(Int)
  B(Int, Int)
end

def f(k: K, x: Int) -> Int
  match k
  when K::A(a) then
    a
  when K::B(b, c) then
    b + c + x
  end
end

def g(k: K, x: Int) -> Int
  match k
  when K::A(a) then
    a + 1
  when K::B(b, c) then
    b + c + a
  end
end

def main() -> Int
  f(K::B(3, 4), 1) + g(K::B(3, 4), 1)
end
