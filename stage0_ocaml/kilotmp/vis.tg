enum TokenKind
  Ident(String)
  Pub
  Priv
  Star
end

struct Parser
  toks: Vec[TokenKind]
  pos: Int
end

def peek_kind(p: Parser) -> TokenKind
  p.toks[p.pos]
end

def parse_visibility(p: Parser) -> Visibility
  match peek_kind(p)
  when TokenKind::Pub then
    return Visibility::Public
  when TokenKind::Priv then
    return Visibility::Private
  when _ then
    return Visibility::Default
  end
end

enum Visibility
  Public
  Private
  Default
end

def main() -> Int
  var p = Parser { toks: [TokenKind::Pub], pos: 0 }
  match parse_visibility(p)
  when Visibility::Public then 1
  when Visibility::Private then 2
  when _ then 3
  end
end
