enum K
  KCall(String)
  KMacro(String, Int)
end

def use_s(v: String) -> Int
  if v == "x" then 1 else 2 end
end

def probe(k: K, n: Int) -> Int
  match k
  when K::KCall(name) then
    use_s(name)
  when K::KMacro(name, cnt) then
    var i = 0
    while i < cnt do
      i = i + 1
    end
    use_s(name) + n
  end
end

def main() -> Int
  probe(K::KMacro("m", 2), 3)
end
