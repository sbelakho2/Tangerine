enum Maybe
  Yes(Int)
  No
end

def lookup(k: Int) -> Maybe
  if k > 0 then Maybe::Yes(k) else Maybe::No end
end

def bump() -> Int
  0
end

def f(inout m: Int, k: Int) -> Int
  match lookup(k)
  when Maybe::Yes(bottom) then
    match lookup(bottom)
    when Maybe::Yes(rec) then
      m = m + rec
    when Maybe::No then ()
    end
  when Maybe::No then ()
  end
  m
end

def main() -> Int
  mut m = 0
  f(m, 1)
end
