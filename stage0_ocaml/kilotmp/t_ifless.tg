def helper(v: Int) -> Option[Int]
  Option::Some(v)
end

def probe(flag: Bool, v: Int) -> Int
  var acc = 1
  match helper(v)
  when Option::Some(x) then
    if flag then
      acc = acc + 1
      acc
    else
      if x > 0 then
        acc = acc + x
        acc
      end
    end
  when Option::None then
    0
  end
end

def main() -> Int
  probe(true, 5)
end
