struct Span
  file: String
  start: Int
  end_pos: Int
end

struct Expr
  kind: ExprKind
  span: Span
end

struct Boxed
  v: Expr
end

def box_new(sink value: Expr) -> Boxed
  Boxed { v: value }
end

enum ExprKind
  EUnary(UnOp, Boxed)
  EInt(Int)
end

enum UnOp
  Not
  BitNot
end

def make_expr(kind: ExprKind, span: Span) -> Expr
  Expr { kind: kind, span: span }
end

def span_merge(a: Span, b: Span) -> Span
  Span { file: b.file, start: b.start, end_pos: b.end_pos }
end

def mk_inline(sink e: Expr, start: Span) -> Expr
  make_expr(ExprKind::EUnary(UnOp::Not, box_new(e)), e.span)
end

def mk_hoist(sink e: Expr, start: Span) -> Expr
  let sp = span_merge(start, e.span)
  make_expr(ExprKind::EUnary(UnOp::Not, box_new(e)), sp)
end

def mk_bind(sink e: Expr, start: Span) -> Expr
  let sp = e.span
  make_expr(ExprKind::EUnary(UnOp::Not, box_new(e)), sp)
end

def mk_tail(sink e: Expr, start: Span) -> Expr
  let b = box_new(e)
  make_expr(ExprKind::EUnary(UnOp::Not, b), e.span)
end

def kind_of(e: Expr) -> Int
  match e.kind
  when ExprKind::EUnary(_, _) then 1
  when ExprKind::EInt(_) then 0
  end
end

def main() -> Int
  let sp = Span { file: "x", start: 0, end_pos: 1 }
  let e = make_expr(ExprKind::EInt(5), sp)
  let e2 = mk_hoist(e, sp)
  kind_of(e2)
end
