enum A
  X1
  X2
end

enum B
  K1
  K2
end

def f(a: A, b: B) -> u16
  match a
  when A::X1 then
    match b
    when B::K1 then 1
    when B::K2 then 4
    end
  when A::X2 then
    match b
    when B::K1 then 7
    when B::K2 then 0
    end
  end
end

def main() -> Int
  let x: u16 = f(A::X1, B::K1)
  x as Int
end
