enum MyType
  Unit
  FixedArr(MyType, Int)
  Ptr(MyType)
  VecT(MyVec)
end

struct MyVec
  items: Vec[MyType]
end

def mk(t: MyType) -> MyType
  MyType::Ptr(t)
end

def main() -> Int
  let t = MyType::Unit
  let t2 = mk(t)
  match t2
  when MyType::Unit then 0
  when MyType::Ptr(_) then 1
  when _ then 2
  end
end
