enum K
  A(Int)
  B(Int, Int)
end

enum J
  X(K)
  Y(Int, Int)
end

def f(j: J, p: Int) -> Int
  match j
  when J::X(k) then
    match k
    when K::A(a) then a + p
    when K::B(b, c) then b + c + p
    end
  when J::Y(p, q) then
    p + q
  end
end

def main() -> Int
  f(J::X(K::A(3)), 5) + f(J::Y(1, 2), 5)
end
