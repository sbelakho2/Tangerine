use std::core
use std::collections

# Move a by-value owning parameter into a local and mutate it, then
# return it. If the checker accepts this, the callee's mutation aliases
# the caller's value (the caller's Read arg keeps the caller's binding
# live), which is the aliasing case an in-place array set must not
# observe.

def move_and_mutate(v: Vec[u8]) -> Vec[u8]
  var w = v
  w[0] = 99 as u8
  w
end

def mutate_only(v: Vec[u8]) -> Unit
  var w = v
  w.push(7 as u8)
end

def main() -> Int
  let mut a = Vec[u8]::new()
  a.push(1 as u8)
  let b = move_and_mutate(a)
  let c = mutate_only(a)
  let _ = b
  let _ = c
  a[0] as Int
end
