# addrprobe.tg — the host-pointer boundary micro-repro for the
# `address_of`/`address_of_mut` inout lowering.
#
# `address_of_mut(&mut st)` must yield a reference to the CALLER's place
# (`st`), never the value read out of the callee's by-value copy of the
# inout parameter.  The seed VM crosses a real reference to a host extern
# as an arena pointer (with copy-out), so the call below must succeed and
# the host must observe a writable slot:
#
#   * correct: waitpid(-1, ...) sees a valid PtrMut, catches ECHILD
#     (no children) and returns -10; `st` stays 0 (the binding only
#     writes the status word on a real wait result).
#   * broken: the PtrMut handle is `Ptr { address: 0 }` built from the
#     deref-read value, and the host boundary traps with
#     `expected Ptr (found Struct, ... not an arena address)`.
#
# main returns 0 ONLY on r == -10 (the host call accepted the pointer and
# reported ECHILD), so tg_hostptr's `bs_vm_code = Some 0` assertion is the
# CI gate; the printed marker carries the observed value for the logs.

use std::ffi::{address_of_mut}
use std::process::{waitpid}
use std::io::{println}

def main() -> Int
  var st: Int = 0
  let r = waitpid(-1, address_of_mut(&mut st), 0)
  if r == -10 then
    println("ADDRPROBE ok r=" + r.to_string())
    0
  else
    println("ADDRPROBE bad r=" + r.to_string())
    1
  end
end
