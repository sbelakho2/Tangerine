## ---------------------------------------------------------------
## calculator_app/calculator.tg — Enhanced Calculator UI in Tangerine
## 
## Features:
## - Full Float arithmetic (decimal support)
## - Decimal point input
## - Additional operators: √ (square root), 1/x (reciprocal), % (percent)
## - Memory functions: MC, MR, M+, M- 
## - Clear (C) and Clear Entry (CE)
## - Sign toggle (±)
## - 6x5 button grid with hover and press effects
## - Keyboard support (digits, operators, Enter, Backspace, Escape, Delete)
## ---------------------------------------------------------------

use std::app
use std::gfx
use std::geom
use std::text
use std::math
use std::thread

struct HitPos
  row: Int
  col: Int
end

# Extended operator enum with more operations
enum Operator
  None
  Add
  Sub
  Mul
  Div
  Percent
  Sqrt
  Reciprocal
end

# Button action types - covers all calculator operations
enum ButtonAction
  None
  Digit(Int)
  Decimal
  Operator(Operator)
  Equals
  Clear
  ClearEntry
  SignToggle
  PercentOp
  SqrtOp
  ReciprocalOp
  MemoryClear
  MemoryRecall
  MemoryAdd
  MemorySubtract
end

# Main Calculator application state
struct CalculatorApp
  done: Bool
  mouse_x: f32
  mouse_y: f32
  display_text: String
  
  # Float for decimal support
  current_value: Float
  stored_value: Float
  memory_value: Float
  pending_op: Operator
  
  # State tracking
  entering_new: Bool
  has_decimal: Bool
  has_error: Bool
  error_message: String
  
  # Visual feedback
  pressed_button: Option[HitPos]
  
  # API objects
  font_db: text::FontDb
  text_style: text::TextStyle
  shaping_opts: text::ShapingOpts
end

impl CalculatorApp
  # Create new calculator instance
  def new() -> CalculatorApp
    CalculatorApp {
      done: false,
      mouse_x: 0.0,
      mouse_y: 0.0,
      display_text: "0".to_string(),
      current_value: 0.0,
      stored_value: 0.0,
      memory_value: 0.0,
      pending_op: Operator::None,
      entering_new: true,
      has_decimal: false,
      has_error: false,
      error_message: "".to_string(),
      pressed_button: Option::None,
      font_db: text::font_db_new(),
      text_style: text::TextStyle { 
        size: 28.0, 
        font: Option::None, 
        color: geom::Color { r: 0.95, g: 0.95, b: 0.98, a: 1.0 } 
      },
      shaping_opts: text::default_shaping_opts()
    }
  end

  # Format Float value for display - handles trailing zeros, scientific notation, errors
  def format_display(&self, value: Float) -> String
    if self.has_error then
      return self.error_message.clone()
    end
    
    if value.is_nan() then
      return "Error".to_string()
    end
    
    # Large/small numbers - use scientific
    if value > 10000000000.0 || (value != 0.0 && value < 0.000001) then
      return value.to_string()
    end
    
    # Essentially integer - no .0
    if value == value.floor() && value.abs() < 10000000000.0 then
      return (value as Int).to_string()
    end
    
    # Remove trailing zeros
    let formatted = value.to_string()
    if formatted.contains(".") then
      let parts = formatted.split(".")
      if parts.len() == 2 then
        let int_part = parts[0]
        let mut frac_part = parts[1]
        let mut i = frac_part.len() - 1
        while i >= 0 && frac_part.char_at(i) == '0' do
          i = i - 1
        end
        if i < 0 then
          return int_part
        else
          return int_part + "." + frac_part.slice(0, i + 1)
        end
      end
    end
    
    formatted
  end

  # Clear all - reset everything
  def clear_all(&mut self) -> Unit
    self.display_text = "0".to_string()
    self.current_value = 0.0
    self.stored_value = 0.0
    self.memory_value = 0.0
    self.pending_op = Operator::None
    self.entering_new = true
    self.has_decimal = false
    self.has_error = false
    self.error_message = "".to_string()
    self.pressed_button = Option::None
  end

  # Clear entry - just current value (not memory or pending op)
  def clear_entry(&mut self) -> Unit
    self.current_value = 0.0
    self.display_text = "0".to_string()
    self.entering_new = true
    self.has_decimal = false
  end

  # Append a digit to current value
  def append_digit(&mut self, d: Int) -> Unit
    if self.has_error then
      self.clear_all()
    end

    if self.entering_new then
      self.current_value = d as Float
      self.entering_new = false
    else
      self.current_value = self.current_value * 10.0 + (d as Float)
    end

    self.display_text = self.format_display(self.current_value)
  end

  # Append decimal point
  def append_decimal(&mut self) -> Unit
    if self.has_error then
      self.clear_all()
    end
    
    if self.entering_new then
      self.current_value = 0.0
      self.entering_new = false
    end
    
    self.has_decimal = true
    self.display_text = self.format_display(self.current_value) + "."
  end

  # Toggle positive/negative
  def toggle_sign(&mut self) -> Unit
    if self.has_error then
      self.clear_all()
      return
    end
    
    self.current_value = -self.current_value
    self.display_text = self.format_display(self.current_value)
    self.entering_new = false
  end

  # Apply pending operation
  def apply_pending(&mut self, next_value: Float) -> Float
    match self.pending_op
    when Operator::Add then self.stored_value + next_value
    when Operator::Sub then self.stored_value - next_value
    when Operator::Mul then self.stored_value * next_value
    when Operator::Div
      if next_value == 0.0 then
        self.has_error = true
        self.error_message = "Cannot divide by zero".to_string()
        0.0
      else
        self.stored_value / next_value
      end
    when Operator::Percent
      (self.stored_value * next_value) / 100.0
    else
      next_value
    end
  end

  # Calculate square root
  def calculate_sqrt(&mut self) -> Unit
    if self.current_value < 0.0 then
      self.has_error = true
      self.error_message = "Cannot compute square root of negative number".to_string()
      self.display_text = "Error".to_string()
      return
    end
    
    self.current_value = math::sqrt(self.current_value)
    self.display_text = self.format_display(self.current_value)
    self.entering_new = true
  end

  # Calculate reciprocal (1/x)
  def calculate_reciprocal(&mut self) -> Unit
    if self.current_value == 0.0 then
      self.has_error = true
      self.error_message = "Cannot compute reciprocal of zero".to_string()
      self.display_text = "Error".to_string()
      return
    end
    
    self.current_value = 1.0 / self.current_value
    self.display_text = self.format_display(self.current_value)
    self.entering_new = true
  end

  # Calculate percentage
  def calculate_percent(&mut self) -> Unit
    if self.stored_value != 0.0 then
      self.current_value = (self.stored_value * self.current_value) / 100.0
    else
      self.current_value = self.current_value / 100.0
    end
    self.display_text = self.format_display(self.current_value)
    self.entering_new = true
  end

  # Choose an operator
  def choose_operator(&mut self, op: Operator) -> Unit
    if self.has_error then
      self.clear_all()
    end

    if self.pending_op == Operator::None then
      self.stored_value = self.current_value
    else
      self.stored_value = self.apply_pending(self.current_value)
      if self.has_error then
        self.display_text = "Error".to_string()
        self.pending_op = Operator::None
        self.entering_new = true
        return
      end
      self.display_text = self.format_display(self.stored_value)
    end

    self.pending_op = op
    self.current_value = self.stored_value
    self.entering_new = true
    self.has_decimal = false
  end

  # Equals - compute result
  def equals(&mut self) -> Unit
    if self.has_error then
      self.clear_all()
      return
    end

    if self.pending_op == Operator::None then
      self.display_text = self.format_display(self.current_value)
      return
    end

    let result = self.apply_pending(self.current_value)
    if self.has_error then
      self.display_text = "Error".to_string()
      self.pending_op = Operator::None
      self.entering_new = true
      return
    end

    self.current_value = result
    self.stored_value = result
    self.pending_op = Operator::None
    self.entering_new = true
    self.has_decimal = false
    self.display_text = self.format_display(result)
  end

  # Memory operations
  def memory_clear(&mut self) -> Unit
    self.memory_value = 0.0
  end

  def memory_recall(&mut self) -> Unit
    self.current_value = self.memory_value
    self.display_text = self.format_display(self.current_value)
    self.entering_new = true
  end

  def memory_add(&mut self) -> Unit
    self.memory_value = self.memory_value + self.current_value
  end

  def memory_subtract(&mut self) -> Unit
    self.memory_value = self.memory_value - self.current_value
  end

  # Backspace - remove last digit
  def backspace(&mut self) -> Unit
    if self.has_error then
      self.clear_all()
      return
    end
    
    if self.entering_new then
      return
    end
    
    self.current_value = (self.current_value * 10.0).floor() / 10.0
    self.display_text = self.format_display(self.current_value)
  end

  # Convert (row, col) to button action
  def button_action_at(&self, row: Int, col: Int) -> ButtonAction
    if row < 0 || row >= 6 || col < 0 || col >= 5 then
      return ButtonAction::None
    end
    
    match row
    when 0
      match col
      when 0 then ButtonAction::MemoryClear
      when 1 then ButtonAction::MemoryRecall
      when 2 then ButtonAction::MemoryAdd
      when 3 then ButtonAction::MemorySubtract
      when 4 then ButtonAction::Clear
      else ButtonAction::None
      end
    when 1
      match col
      when 0 then ButtonAction::SqrtOp
      when 1 then ButtonAction::PercentOp
      when 2 then ButtonAction::SignToggle
      when 3 then ButtonAction::Operator(Operator::Div)
      when 4 then ButtonAction::ReciprocalOp
      else ButtonAction::None
      end
    when 2
      match col
      when 0 then ButtonAction::Digit(7)
      when 1 then ButtonAction::Digit(8)
      when 2 then ButtonAction::Digit(9)
      when 3 then ButtonAction::Operator(Operator::Mul)
      when 4 then ButtonAction::Clear
      else ButtonAction::None
      end
    when 3
      match col
      when 0 then ButtonAction::Digit(4)
      when 1 then ButtonAction::Digit(5)
      when 2 then ButtonAction::Digit(6)
      when 3 then ButtonAction::Operator(Operator::Sub)
      when 4 then ButtonAction::ClearEntry
      else ButtonAction::None
      end
    when 4
      match col
      when 0 then ButtonAction::Digit(1)
      when 1 then ButtonAction::Digit(2)
      when 2 then ButtonAction::Digit(3)
      when 3 then ButtonAction::Operator(Operator::Add)
      when 4 then ButtonAction::Equals
      else ButtonAction::None
      end
    when 5
      match col
      when 0 then ButtonAction::Digit(0)
      when 1 then ButtonAction::Decimal
      when 2 then ButtonAction::SignToggle
      when 3 then ButtonAction::PercentOp
      when 4 then ButtonAction::Equals
      else ButtonAction::None
      end
    else
      ButtonAction::None
    end
  end

  # Hit test - find which button is at position
  def hit_test(&self, x: f32, y: f32) -> HitPos
    let origin_x = 20.0
    let origin_y = 120.0
    let button_w = 68.0
    let button_h = 56.0
    let gap = 6.0

    let total_w = button_w * 5.0 + gap * 4.0
    let total_h = button_h * 6.0 + gap * 5.0

    if x < origin_x || y < origin_y || x > origin_x + total_w || y > origin_y + total_h then
      return HitPos { row: -1, col: -1 }
    end

    let cell_w = button_w + gap
    let cell_h = button_h + gap
    let col = ((x - origin_x) / cell_w) as Int
    let row = ((y - origin_y) / cell_h) as Int

    HitPos { row: row, col: col }
  end

  # Handle button press
  def handle_button(&mut self, action: ButtonAction) -> Unit
    match action
    when ButtonAction::Digit(d) then self.append_digit(d)
    when ButtonAction::Decimal then self.append_decimal()
    when ButtonAction::Operator(op) then self.choose_operator(op)
    when ButtonAction::Equals then self.equals()
    when ButtonAction::Clear then self.clear_all()
    when ButtonAction::ClearEntry then self.clear_entry()
    when ButtonAction::SignToggle then self.toggle_sign()
    when ButtonAction::PercentOp then self.calculate_percent()
    when ButtonAction::SqrtOp then self.calculate_sqrt()
    when ButtonAction::ReciprocalOp then self.calculate_reciprocal()
    when ButtonAction::MemoryClear then self.memory_clear()
    when ButtonAction::MemoryRecall then self.memory_recall()
    when ButtonAction::MemoryAdd then self.memory_add()
    when ButtonAction::MemorySubtract then self.memory_subtract()
    else ()
    end
  end

  # Handle keyboard input
  def handle_key(&mut self, key: app::Key) -> Unit
    match key
    when app::Key::Char(c) then
      if c >= '0' && c <= '9' then
        self.append_digit((c as Int) - ('0' as Int))
      elsif c == '.' then
        self.append_decimal()
      elsif c == '+' then
        self.choose_operator(Operator::Add)
      elsif c == '-' then
        self.choose_operator(Operator::Sub)
      elsif c == '*' then
        self.choose_operator(Operator::Mul)
      elsif c == '/' then
        self.choose_operator(Operator::Div)
      elsif c == '%' then
        self.calculate_percent()
      elsif c == '=' then
        self.equals()
      end
    when app::Key::Enter then self.equals()
    when app::Key::Backspace then self.backspace()
    when app::Key::Escape then self.clear_all()
    when app::Key::Delete then self.clear_entry()
    else ()
    end
  end

  # Get button color based on position and state
  def get_button_color(&self, row: Int, col: Int, is_pressed: Bool) -> geom::Color
    let base = if is_pressed then
      geom::Color { r: 0.18, g: 0.18, b: 0.22, a: 1.0 }
    else
      geom::Color { r: 0.22, g: 0.22, b: 0.27, a: 1.0 }
    end
    
    match row
    when 0
      if col == 4 then
        geom::Color { r: 0.75, g: 0.30, b: 0.32, a: 1.0 }
      else
        base
      end
    when 1
      if col >= 0 && col <= 3 then
        geom::Color { r: 0.45, g: 0.45, b: 0.50, a: 1.0 }
      else
        base
      end
    when 2
      if col == 3 then
        geom::Color { r: 0.95, g: 0.66, b: 0.22, a: 1.0 }
      elsif col == 4 then
        geom::Color { r: 0.75, g: 0.30, b: 0.32, a: 1.0 }
      else
        base
      end
    when 3
      if col == 3 then
        geom::Color { r: 0.95, g: 0.66, b: 0.22, a: 1.0 }
      elsif col == 4 then
        geom::Color { r: 0.75, g: 0.30, b: 0.32, a: 1.0 }
      else
        base
      end
    when 4
      if col == 3 then
        geom::Color { r: 0.95, g: 0.66, b: 0.22, a: 1.0 }
      elsif col == 4 then
        geom::Color { r: 0.28, g: 0.58, b: 0.93, a: 1.0 }
      else
        base
      end
    when 5
      if col == 3 then
        geom::Color { r: 0.45, g: 0.45, b: 0.50, a: 1.0 }
      elsif col == 4 then
        geom::Color { r: 0.28, g: 0.58, b: 0.93, a: 1.0 }
      else
        base
      end
    else
      base
    end
  end

  # Get button label text
  def get_button_label(&self, row: Int, col: Int) -> String
    match row
    when 0
      match col
      when 0 then "MC"
      when 1 then "MR"
      when 2 then "M+"
      when 3 then "M-"
      when 4 then "C"
      else ""
      end
    when 1
      match col
      when 0 then "√"
      when 1 then "%"
      when 2 then "±"
      when 3 then "÷"
      when 4 then "1/x"
      else ""
      end
    when 2
      match col
      when 0 then "7"
      when 1 then "8"
      when 2 then "9"
      when 3 then "×"
      when 4 then "C"
      else ""
      end
    when 3
      match col
      when 0 then "4"
      when 1 then "5"
      when 2 then "6"
      when 3 then "-"
      when 4 then "CE"
      else ""
      end
    when 4
      match col
      when 0 then "1"
      when 1 then "2"
      when 2 then "3"
      when 3 then "+"
      when 4 then "="
      else ""
      end
    when 5
      match col
      when 0 then "0"
      when 1 then "."
      when 2 then "±"
      when 3 then "%"
      when 4 then "="
      else ""
      end
    else
      ""
    end
  end

  # Main render function - draw entire calculator UI
  def on_redraw(&mut self, window: &mut dyn app::Window) -> Unit
    match window.surface()
    when Result::Ok(mut surface) then
      match surface.begin_frame()
      when Result::Ok(mut canvas) then
        # Background
        canvas.clear(geom::Color { r: 0.12, g: 0.12, b: 0.15, a: 1.0 })

        # Display panel
        let panel = gfx::Paint::solid(geom::Color { r: 0.06, g: 0.06, b: 0.09, a: 1.0 })
        canvas.fill_rrect(geom::RRect::from_xywh(20.0, 20.0, 364.0, 84.0, 10.0), &panel)

        # Memory indicator
        if self.memory_value != 0.0 then
          let mem_style = text::TextStyle {
            size: 18.0,
            font: Option::None,
            color: geom::Color { r: 0.95, g: 0.66, b: 0.22, a: 1.0 }
          }
          match text::shape(&self.font_db, "M".to_string(), mem_style, self.shaping_opts)
          when Result::Ok(run) then
            let paint = gfx::Paint::solid(mem_style.color)
            canvas.draw_glyph_run(&run, 30.0, 45.0, &paint)
          when Result::Err(_) then ()
          end
        end

        # Display text (right-aligned)
        let text_paint = gfx::Paint::solid(geom::Color { r: 0.95, g: 0.95, b: 0.98, a: 1.0 })
        match text::shape(&self.font_db, self.display_text.clone(), self.text_style, self.shaping_opts)
        when Result::Ok(run) then
          canvas.draw_glyph_run(&run, 170.0, 72.0, &text_paint)
        when Result::Err(_) then
          canvas.fill_rect(geom::Rect { x: 170.0, y: 54.0, w: 200.0, h: 10.0 }, &text_paint)
        end

        # Button grid - 6 rows x 5 columns
        let origin_x = 20.0
        let origin_y = 120.0
        let button_w = 68.0
        let button_h = 56.0
        let gap = 6.0

        for row in 0..6 do
          for col in 0..5 do
            let x = origin_x + (col as f32) * (button_w + gap)
            let y = origin_y + (row as f32) * (button_h + gap)
            
            # Check pressed state
            let is_pressed = match self.pressed_button
            when Option::Some(pos) then pos.row == row && pos.col == col
            when Option::None then false
            end
            
            # Check hover state
            let hit = self.hit_test(self.mouse_x, self.mouse_y)
            let is_hovered = hit.row == row && hit.col == col
            
            # Calculate color with hover effect using simple statements.
            let mut color = self.get_button_color(row, col, false)
            if is_pressed then
              color = self.get_button_color(row, col, true)
            elsif is_hovered then
              let base = self.get_button_color(row, col, false)
              let mut hover_r = base.r * 0.9
              let mut hover_g = base.g * 0.9
              let mut hover_b = base.b * 0.9
              if hover_r > 1.0 then
                hover_r = 1.0
              end
              if hover_g > 1.0 then
                hover_g = 1.0
              end
              if hover_b > 1.0 then
                hover_b = 1.0
              end
              color = geom::Color {
                r: hover_r,
                g: hover_g,
                b: hover_b,
                a: base.a
              }
            end

            let paint = gfx::Paint::solid(color)
            canvas.fill_rrect(geom::RRect::from_xywh(x, y, button_w, button_h, 8.0), &paint)

            # Button label
            let label = self.get_button_label(row, col)
            let label_style = text::TextStyle {
              size: if label.len() > 2 then 18.0 else 24.0,
              font: Option::None,
              color: geom::Color { r: 0.98, g: 0.98, b: 1.0, a: 1.0 }
            }
            match text::shape(&self.font_db, label.to_string(), label_style, self.shaping_opts)
            when Result::Ok(run) then
              let label_paint = gfx::Paint::solid(label_style.color)
              let offset_x = if label.len() == 1 then 28.0 else if label.len() == 2 then 20.0 else 12.0 end
              canvas.draw_glyph_run(&run, x + offset_x, y + 36.0, &label_paint)
            when Result::Err(_) then ()
            end
          end
        end

        surface.end_frame()
        surface.present()
      when Result::Err(_) then ()
      end
    when Result::Err(_) then ()
    end
  end
end

# Main entry point
def main() -> Unit
  let opts = app::AppOpts::default()
  let mut sa = app::SoftwareApp::new(opts)
  
  let cap = app::acquire_display_cap()
  
  # Window: 380x520 for 5 columns * 68px + margins
  match sa.window_new("TG Calculator".to_string(), 380, 520, cap)
  when Result::Ok(mut window) then
    let mut calc = CalculatorApp::new()
    
    # Event loop
    while !calc.done do
      match window.poll_event()
      when Option::Some(event) then
        match event
        when app::Event::MouseMove(x, y) then
          calc.mouse_x = x as f32
          calc.mouse_y = y as f32
          window.request_redraw()
        when app::Event::MouseDown(button) then
          if button == app::MouseButton::Left then
            let hit = calc.hit_test(calc.mouse_x, calc.mouse_y)
            calc.pressed_button = Option::Some(hit)
            
            if hit.row >= 0 && hit.col >= 0 then
              let action = calc.button_action_at(hit.row, hit.col)
              calc.handle_button(action)
              window.request_redraw()
            end
          end
        when app::Event::MouseUp(button) then
          if button == app::MouseButton::Left then
            calc.pressed_button = Option::None
            window.request_redraw()
          end
        when app::Event::KeyDown(key, _mods, _repeat) then
          calc.handle_key(key)
          window.request_redraw()
        when app::Event::RedrawRequested then
          calc.on_redraw(&mut *window)
        when app::Event::CloseRequested then
          calc.done = true
        when _ then ()
        end
      when Option::None then
        std::thread::yield_now()
      end
    end
  when Result::Err(_) then ()
  end
end