## ---------------------------------------------------------------
## calculator_app/calculator.tg — Calculator UI built entirely in TG
## ---------------------------------------------------------------

use std::app
use std::gfx
use std::geom
use std::text
use std::fmt

enum Operator
  None
  Add
  Sub
  Mul
  Div
end

enum ButtonAction
  None
  Digit(Int)
  Operator(Operator)
  Equals
  Clear
end

struct CalculatorApp
  done: Bool
  mouse_x: f32
  mouse_y: f32
  display_text: String
  current_value: Int
  stored_value: Int
  pending_op: Operator
  entering_new: Bool
  has_error: Bool
end

impl CalculatorApp
  def clear_all() -> Nil
    self.display_text = "0".to_string()
    self.current_value = 0
    self.stored_value = 0
    self.pending_op = Operator::None
    self.entering_new = true
    self.has_error = false
  end

  def append_digit(d: Int) -> Nil
    if self.has_error then
      self.clear_all()
    end

    if self.entering_new then
      self.current_value = d
      self.entering_new = false
    else
      let next = self.current_value * 10 + d
      # Clamp to prevent overflow on very large inputs
      if next / 10 != self.current_value then
        return
      end
      self.current_value = next
    end

    self.display_text = fmt::format("{}", self.current_value)
  end

  def apply_pending(next_value: Int) -> Int
    match self.pending_op
    when Operator::Add then self.stored_value + next_value
    when Operator::Sub then self.stored_value - next_value
    when Operator::Mul then self.stored_value * next_value
    when Operator::Div
      if next_value == 0 then
        self.has_error = true
        0
      else
        self.stored_value / next_value
      end
    else
      next_value
    end
  end

  def choose_operator(op: Operator) -> Nil
    if self.has_error then
      self.clear_all()
    end

    if self.pending_op == Operator::None then
      self.stored_value = self.current_value
    else
      self.stored_value = self.apply_pending(self.current_value)
      if self.has_error then
        self.display_text = "Error".to_string()
        self.pending_op = Operator::None
        self.entering_new = true
        return
      end
      self.display_text = fmt::format("{}", self.stored_value)
    end

    self.pending_op = op
    self.current_value = self.stored_value
    self.entering_new = true
  end

  def equals() -> Nil
    if self.has_error then
      self.clear_all()
      return
    end

    if self.pending_op == Operator::None then
      self.display_text = fmt::format("{}", self.current_value)
      return
    end

    let result = self.apply_pending(self.current_value)
    if self.has_error then
      self.display_text = "Error".to_string()
      self.pending_op = Operator::None
      self.entering_new = true
      return
    end

    self.current_value = result
    self.stored_value = result
    self.pending_op = Operator::None
    self.entering_new = true
    self.display_text = fmt::format("{}", result)
  end

  def button_action_at(x: f32, y: f32) -> ButtonAction
    let origin_x = 20.0
    let origin_y = 120.0
    let button_w = 80.0
    let button_h = 56.0
    let gap = 8.0

    let total_w = button_w * 4.0 + gap * 3.0
    let total_h = button_h * 4.0 + gap * 3.0

    if x < origin_x || y < origin_y || x > origin_x + total_w || y > origin_y + total_h then
      return ButtonAction::None
    end

    let cell_w = button_w + gap
    let cell_h = button_h + gap
    let col = ((x - origin_x) / cell_w) as Int
    let row = ((y - origin_y) / cell_h) as Int

    match row
    when 0
      match col
      when 0 then ButtonAction::Clear
      when 1 then ButtonAction::Digit(0)
      when 2 then ButtonAction::Operator(Operator::Div)
      when 3 then ButtonAction::Operator(Operator::Mul)
      else ButtonAction::None
      end
    when 1
      match col
      when 0 then ButtonAction::Digit(7)
      when 1 then ButtonAction::Digit(8)
      when 2 then ButtonAction::Digit(9)
      when 3 then ButtonAction::Operator(Operator::Sub)
      else ButtonAction::None
      end
    when 2
      match col
      when 0 then ButtonAction::Digit(4)
      when 1 then ButtonAction::Digit(5)
      when 2 then ButtonAction::Digit(6)
      when 3 then ButtonAction::Operator(Operator::Add)
      else ButtonAction::None
      end
    when 3
      match col
      when 0 then ButtonAction::Digit(1)
      when 1 then ButtonAction::Digit(2)
      when 2 then ButtonAction::Digit(3)
      when 3 then ButtonAction::Equals
      else ButtonAction::None
      end
    else
      ButtonAction::None
    end
  end

  def handle_button(action: ButtonAction) -> Nil
    match action
    when ButtonAction::Digit(d) then self.append_digit(d)
    when ButtonAction::Operator(op) then self.choose_operator(op)
    when ButtonAction::Equals then self.equals()
    when ButtonAction::Clear then self.clear_all()
    else
      ## no-op
    end
  end

  def handle_key(key: Key) -> Nil
    match key
    when Key::Char('0') then self.append_digit(0)
    when Key::Char('1') then self.append_digit(1)
    when Key::Char('2') then self.append_digit(2)
    when Key::Char('3') then self.append_digit(3)
    when Key::Char('4') then self.append_digit(4)
    when Key::Char('5') then self.append_digit(5)
    when Key::Char('6') then self.append_digit(6)
    when Key::Char('7') then self.append_digit(7)
    when Key::Char('8') then self.append_digit(8)
    when Key::Char('9') then self.append_digit(9)
    when Key::Char('+') then self.choose_operator(Operator::Add)
    when Key::Char('-') then self.choose_operator(Operator::Sub)
    when Key::Char('*') then self.choose_operator(Operator::Mul)
    when Key::Char('/') then self.choose_operator(Operator::Div)
    when Key::Enter then self.equals()
    when Key::Backspace
      self.current_value = self.current_value / 10
      self.display_text = fmt::format("{}", self.current_value)
      self.entering_new = false
    when Key::Escape then self.clear_all()
    else
      ## ignore other keys
    end
  end
end

impl App for CalculatorApp
  def on_event(window: Window, event: Event) -> Nil
    match event
    when Event::MouseMove(x, y)
      self.mouse_x = x
      self.mouse_y = y

    when Event::MouseDown(MouseButton::Left)
      let action = self.button_action_at(self.mouse_x, self.mouse_y)
      self.handle_button(action)
      window.request_redraw()

    when Event::KeyDown(key, _mods, _repeat)
      self.handle_key(key)
      window.request_redraw()

    when Event::RedrawRequested
      let surface = window.surface()
      let canvas = surface.begin()

      ## Background
      canvas.clear(Color { r: 0.12, g: 0.12, b: 0.15, a: 1.0 })

      ## Display panel
      let panel = Paint::solid(Color { r: 0.06, g: 0.06, b: 0.09, a: 1.0 })
      canvas.draw_rrect(RRect { x: 20.0, y: 20.0, width: 344.0, height: 84.0, radius: 10.0 }, panel)

      ## Render display text
      let db = FontDb.new()
      let text_paint = Paint::solid(Color { r: 0.95, g: 0.95, b: 0.98, a: 1.0 })
      match db.load("sans-serif", 28.0)
      when Ok(font)
        let run = shape(font, self.display_text)
        let layout = layout(run, 320.0)
        canvas.draw_text(layout, 34.0, 72.0, text_paint)
      when Err(_)
        ## fallback if font is unavailable
        canvas.draw_rect(Rect { x: 30.0, y: 54.0, width: 220.0, height: 10.0 }, text_paint)
      end

      ## Button grid rendering (4x4)
      let origin_x = 20.0
      let origin_y = 120.0
      let button_w = 80.0
      let button_h = 56.0
      let gap = 8.0

      for row in 0..3 do
        for col in 0..3 do
          let x = origin_x + (col as f32) * (button_w + gap)
          let y = origin_y + (row as f32) * (button_h + gap)

          let mut label = "".to_string()
          let mut color = Color { r: 0.22, g: 0.22, b: 0.27, a: 1.0 }

          if row == 0 && col == 0 then
            label = "C".to_string()
            color = Color { r: 0.75, g: 0.30, b: 0.32, a: 1.0 }
          elsif row == 0 && col == 1 then
            label = "0".to_string()
          elsif row == 0 && col == 2 then
            label = "/".to_string()
            color = Color { r: 0.95, g: 0.66, b: 0.22, a: 1.0 }
          elsif row == 0 && col == 3 then
            label = "*".to_string()
            color = Color { r: 0.95, g: 0.66, b: 0.22, a: 1.0 }
          elsif row == 1 && col == 0 then
            label = "7".to_string()
          elsif row == 1 && col == 1 then
            label = "8".to_string()
          elsif row == 1 && col == 2 then
            label = "9".to_string()
          elsif row == 1 && col == 3 then
            label = "-".to_string()
            color = Color { r: 0.95, g: 0.66, b: 0.22, a: 1.0 }
          elsif row == 2 && col == 0 then
            label = "4".to_string()
          elsif row == 2 && col == 1 then
            label = "5".to_string()
          elsif row == 2 && col == 2 then
            label = "6".to_string()
          elsif row == 2 && col == 3 then
            label = "+".to_string()
            color = Color { r: 0.95, g: 0.66, b: 0.22, a: 1.0 }
          elsif row == 3 && col == 0 then
            label = "1".to_string()
          elsif row == 3 && col == 1 then
            label = "2".to_string()
          elsif row == 3 && col == 2 then
            label = "3".to_string()
          elsif row == 3 && col == 3 then
            label = "=".to_string()
            color = Color { r: 0.28, g: 0.58, b: 0.93, a: 1.0 }
          end

          let paint = Paint::solid(color)
          canvas.draw_rrect(RRect { x: x, y: y, width: button_w, height: button_h, radius: 8.0 }, paint)

          match db.load("sans-serif", 24.0)
          when Ok(font)
            let run = shape(font, label)
            let layout = layout(run, 32.0)
            let label_paint = Paint::solid(Color { r: 0.98, g: 0.98, b: 1.0, a: 1.0 })
            canvas.draw_text(layout, x + 30.0, y + 36.0, label_paint)
          when Err(_)
            ## no-op fallback
          end
        end
      end

      surface.present()

    when Event::CloseRequested
      self.done = true

    else
      ## ignore all other events
    end
  end
end

def main() -> Nil
  let opts = AppOpts {
    title: "TG Calculator",
    width: 384u32,
    height: 392u32,
    resizable: false,
  }

  let app = CalculatorApp {
    done: false,
    mouse_x: 0.0,
    mouse_y: 0.0,
    display_text: "0".to_string(),
    current_value: 0,
    stored_value: 0,
    pending_op: Operator::None,
    entering_new: true,
    has_error: false,
  }

  let sw = SoftwareApp.new()
  sw.run(opts, app)
end

test "calculator_app smoke" do
  let app = CalculatorApp {
    done: false,
    mouse_x: 0.0,
    mouse_y: 0.0,
    display_text: "0".to_string(),
    current_value: 0,
    stored_value: 0,
    pending_op: Operator::None,
    entering_new: true,
    has_error: false,
  }
  assert app.display_text == "0"
end
