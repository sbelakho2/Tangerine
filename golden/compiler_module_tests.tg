## Golden Tests — Compiler Module Coverage
## TEST-002: Tests for lexer, parser, resolver, formatter, linter, docgen, object, linker

use std::test::assert

# ——————————————————————————————————————————————————
# tg_compiler::lexer
# ——————————————————————————————————————————————————

@test
def test_lexer_basic_tokens()
  use tg_compiler::lexer::{lexer_new, tokenize}
  use tg_compiler::token::TokenKind

  let result = tokenize("def main() -> Int\n  42\nend")
  assert result.errors.len() == 0
  assert result.tokens.len() > 0

  # First token should be 'def' keyword
  assert result.tokens[0].kind == TokenKind::Keyword
  assert result.tokens[0].text == "def"
end

@test
def test_lexer_string_literal()
  use tg_compiler::lexer::tokenize
  use tg_compiler::token::TokenKind

  let result = tokenize("\"hello world\"")
  assert result.errors.len() == 0
  # Should have a StringLiteral token
  mut found = false
  for tok in result.tokens do
    if tok.kind == TokenKind::StringLiteral then
      found = true
    end
  end
  assert found == true
end

@test
def test_lexer_number_literal()
  use tg_compiler::lexer::tokenize
  use tg_compiler::token::TokenKind

  let result = tokenize("0xFF 3.14 42 0b1010")
  assert result.errors.len() == 0
  mut num_count = 0
  for tok in result.tokens do
    if tok.kind == TokenKind::NumberLiteral then
      num_count = num_count + 1
    end
  end
  assert num_count == 4
end

@test
def test_lexer_error_recovery()
  use tg_compiler::lexer::tokenize
  use tg_compiler::token::TokenKind

  # Unterminated string should produce error but continue lexing
  let result = tokenize("\"unclosed\ndef foo() end")
  assert result.errors.len() > 0
  # Should still have tokens after the bad string
  assert result.tokens.len() > 1
end

@test
def test_lexer_comments()
  use tg_compiler::lexer::tokenize
  use tg_compiler::token::TokenKind

  let result = tokenize("# this is a comment\ndef foo() end")
  assert result.errors.len() == 0
  # Comment token should be present
  mut has_comment = false
  for tok in result.tokens do
    if tok.kind == TokenKind::Comment then
      has_comment = true
    end
  end
  assert has_comment == true
end

# ——————————————————————————————————————————————————
# tg_compiler::parser
# ——————————————————————————————————————————————————

@test
def test_parser_function_decl()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parser_new, parse_module}
  use tg_compiler::ast::ASTKind

  let tokens = tokenize("def add(a: Int, b: Int) -> Int\n  a + b\nend").tokens
  mut parser = parser_new(tokens)
  let module = parse_module(&mut parser)
  assert parser.diag.diagnostics.len() == 0
  assert module.items.len() == 1
end

@test
def test_parser_struct_decl()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parser_new, parse_module}

  let tokens = tokenize("struct Point\n  x: Float\n  y: Float\nend").tokens
  mut parser = parser_new(tokens)
  let module = parse_module(&mut parser)
  assert parser.diag.diagnostics.len() == 0
  assert module.items.len() == 1
end

@test
def test_parser_error_recovery()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parser_new, parse_module, diag_has_errors}

  # Missing 'end' keyword should trigger error but parser should recover
  let tokens = tokenize("def broken(\ndef second() -> Int\n  1\nend").tokens
  mut parser = parser_new(tokens)
  let module = parse_module(&mut parser)
  assert diag_has_errors(&parser.diag) == true
  # Should have recovered to parse `second`
  assert module.items.len() >= 1
end

@test
def test_parser_match_expression()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parser_new, parse_module}

  let src = "def classify(x: Int) -> String\n  match x\n  when 0 then \"zero\"\n  when 1 then \"one\"\n  when _ then \"other\"\n  end\nend"
  let tokens = tokenize(src).tokens
  mut parser = parser_new(tokens)
  let module = parse_module(&mut parser)
  assert parser.diag.diagnostics.len() == 0
end

# ——————————————————————————————————————————————————
# tg_compiler::resolver
# ——————————————————————————————————————————————————

@test
def test_resolver_unresolved_name()
  use tg_compiler::resolver::{SymbolTable, resolve_module, ResolutionErrorKind}

  # Construct a minimal AST referencing an undefined variable
  # and check that the resolver catches it
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parser_new, parse_module}

  let tokens = tokenize("def test_fn() -> Int\n  undefined_var\nend").tokens
  mut parser = parser_new(tokens)
  let module = parse_module(&mut parser)
  mut table = SymbolTable::new()
  resolve_module(&mut table, &module)
  # Should have at least one UnresolvedName error
  mut found = false
  for err in table.errors do
    if err.kind == ResolutionErrorKind::UnresolvedName then
      found = true
    end
  end
  assert found == true
end

@test
def test_resolver_duplicate_definition()
  use tg_compiler::resolver::{SymbolTable, resolve_module, ResolutionErrorKind}
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parser_new, parse_module}

  let tokens = tokenize("def dup() -> Int\n  1\nend\ndef dup() -> Int\n  2\nend").tokens
  mut parser = parser_new(tokens)
  let module = parse_module(&mut parser)
  mut table = SymbolTable::new()
  resolve_module(&mut table, &module)
  mut found = false
  for err in table.errors do
    if err.kind == ResolutionErrorKind::DuplicateDefinition then
      found = true
    end
  end
  assert found == true
end

# ——————————————————————————————————————————————————
# tg_compiler::formatter
# ——————————————————————————————————————————————————

@test
def test_formatter_default_config()
  use tg_compiler::formatter::{default_format_config, FormatConfig, TrailingComma}

  let cfg = default_format_config()
  assert cfg.indent_width == 2
  assert cfg.max_line_width == 100
  assert cfg.trailing_comma == TrailingComma::Multi
end

@test
def test_formatter_idempotent()
  use tg_compiler::formatter::{default_format_config, format_source}

  let src = "def foo()\n  42\nend\n"
  let cfg = default_format_config()
  let formatted_once = format_source(src, &cfg)
  let formatted_twice = format_source(&formatted_once, &cfg)
  assert formatted_once == formatted_twice
end

# ——————————————————————————————————————————————————
# tg_compiler::linter
# ——————————————————————————————————————————————————

@test
def test_linter_count_name_occurrences()
  use tg_compiler::linter::count_name_occurrences

  assert count_name_occurrences("let x = x + 1", "x") == 2
  assert count_name_occurrences("foo bar foo_bar foobar", "foo") == 1
  assert count_name_occurrences("abc", "xyz") == 0
end

@test
def test_linter_diagnostics()
  use tg_compiler::linter::{LintConfig, lint_source, LintLevel}

  let cfg = LintConfig
    denied: Vec::new()
    warned: Vec::new()
    allowed: Vec::new()
    json_output: false
  end
  let src = "def unusedFunction()\n  let unused_variable = 42\nend"
  let diagnostics = lint_source(src, &cfg)
  # Should detect unused variable or function
  assert diagnostics.len() > 0
end

# ——————————————————————————————————————————————————
# tg_compiler::docgen
# ——————————————————————————————————————————————————

@test
def test_docgen_default_config()
  use tg_compiler::docgen::{default_doc_config, DocFormat}

  let cfg = default_doc_config()
  assert cfg.format == DocFormat::Html
  assert cfg.include_private == false
end

@test
def test_docgen_extract_doc_comments()
  use tg_compiler::docgen::{extract_doc_module, DocModule}
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parser_new, parse_module}

  let src = "## This is a doc comment\ndef documented_fn() -> Int\n  42\nend"
  let tokens = tokenize(src).tokens
  mut parser = parser_new(tokens)
  let module = parse_module(&mut parser)
  let doc = extract_doc_module(&module, "test_module")
  assert doc.functions.len() == 1
  assert doc.functions[0].doc_comment.contains("doc comment")
end

# ——————————————————————————————————————————————————
# tg_compiler::object
# ——————————————————————————————————————————————————

@test
def test_object_new()
  use tg_compiler::object::{object_new, ObjectFile}

  let obj = object_new("aarch64-macos")
  assert obj.text.len() == 0
  assert obj.data.len() == 0
  assert obj.symbols.len() == 0
  assert obj.relocations.len() == 0
end

@test
def test_object_string_table()
  use tg_compiler::object::{object_new, obj_add_string}

  mut obj = object_new("x86_64-linux")
  let off1 = obj_add_string(&mut obj, "main")
  let off2 = obj_add_string(&mut obj, "helper")
  assert off1 != off2
  # Same string should return same offset (interning)
  let off3 = obj_add_string(&mut obj, "main")
  assert off1 == off3
end

# ——————————————————————————————————————————————————
# tg_compiler::linker
# ——————————————————————————————————————————————————

@test
def test_linker_resolve_symbols_basic()
  use tg_compiler::linker::{resolve_symbols, LinkerSymbol}
  use tg_compiler::object::{object_new, ObjectFile}

  mut obj1 = object_new("x86_64-linux")
  obj1.symbols.push(LinkerSymbol
    name: "main"
    value: 0
    section: 0
    is_defined: true
  end)

  mut obj2 = object_new("x86_64-linux")
  obj2.symbols.push(LinkerSymbol
    name: "helper"
    value: 0
    section: 0
    is_defined: true
  end)

  let result = resolve_symbols(Vec::from([obj1, obj2]))
  match result
  when Result::Ok(syms) then
    assert syms.contains_key("main")
    assert syms.contains_key("helper")
  when Result::Err(e) then
    assert false
  end
end

@test
def test_linker_duplicate_symbol_error()
  use tg_compiler::linker::{resolve_symbols, LinkerSymbol}
  use tg_compiler::object::{object_new}

  mut obj1 = object_new("x86_64-linux")
  obj1.symbols.push(LinkerSymbol
    name: "dup_sym"
    value: 0
    section: 0
    is_defined: true
  end)

  mut obj2 = object_new("x86_64-linux")
  obj2.symbols.push(LinkerSymbol
    name: "dup_sym"
    value: 0
    section: 0
    is_defined: true
  end)

  let result = resolve_symbols(Vec::from([obj1, obj2]))
  match result
  when Result::Err(msg) then
    assert msg.contains("dup_sym")
  when Result::Ok(_) then
    assert false
  end
end
