## Golden test: Capability declarations and unsafe blocks
## Tests parsing of cap declarations, requires clauses, and unsafe blocks.
# expect: ok

cap FileCap end
cap NetCap end

def read_config() -> Int
  requires FileCap
  42
end

def fetch_data() -> Int
  requires NetCap
  100
end

def safe_wrapper() -> Int
  unsafe "accessing file system for configuration"
    let cfg = read_config()
    cfg
  end
end

def main() -> Int
  let x = safe_wrapper()
  x
end
