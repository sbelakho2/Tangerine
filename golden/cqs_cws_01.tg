## Golden test: CQS scoring, coverage, capability baseline, CWS
## Covers: §23-59, §60-79, §68-74, §83-103

# ——————————————————————————————————————————————————
# §23-35 — CQS Core: Surface Classification & Scoring
# ——————————————————————————————————————————————————

@test
def test_surface_classification()
  use tg_compiler::cqs::{
    Symbol, SymbolKind, SurfaceClass, classify_surface
  }

  let pub_fn = Symbol {
    name: "process",
    module: "app",
    kind: SymbolKind::Function,
    is_pub: true,
    is_stable: true,
    is_test: false,
    is_generated: false,
    is_extern: false
  }
  assert classify_surface(&pub_fn) == SurfaceClass::PublicStable

  let test_fn = Symbol {
    name: "test_process",
    module: "app",
    kind: SymbolKind::Function,
    is_pub: false,
    is_stable: false,
    is_test: true,
    is_generated: false,
    is_extern: false
  }
  assert classify_surface(&test_fn) == SurfaceClass::Test
end

@test
def test_penalty_computation()
  use tg_compiler::cqs::{
    SignalKind, SignalParams, compute_penalty, default_signal_params
  }

  # CF_1 (uncovered branch): severity=1.0, binary
  let params = default_signal_params(SignalKind::CF_1)
  let p = compute_penalty(params.weight, 1.0, 1, params.beta, params.alpha, params.cap, 0.0)
  assert p > 0.0
  assert p <= params.cap

  # With suppression = 1.0 → penalty should be 0
  let p_supp = compute_penalty(params.weight, 1.0, 1, params.beta, params.alpha, params.cap, 1.0)
  assert p_supp == 0.0
end

@test
def test_score_computation()
  use tg_compiler::cqs::{compute_score}

  # No penalties → score = 100
  let score_perfect = compute_score(&Vec::new())
  assert score_perfect == 100.0

  # Some penalties → score < 100
  let score_with = compute_score(&vec![10.0, 5.0, 3.0])
  assert score_with == 82.0  # 100 - 18
end

# ——————————————————————————————————————————————————
# §36-37 — Mode-Dependent Thresholds
# ——————————————————————————————————————————————————

@test
def test_thresholds()
  use tg_compiler::mode::Mode
  use tg_compiler::cqs::{
    SurfaceClass, min_score_threshold, branch_coverage_threshold
  }

  # Production + PublicStable → min 85
  let t = min_score_threshold(Mode::Production, SurfaceClass::PublicStable)
  assert t == 85

  # Dev → no threshold (0)
  let t_dev = min_score_threshold(Mode::Dev, SurfaceClass::PublicStable)
  assert t_dev == 0

  # Production branch coverage for PublicStable → 0.75
  let bc = branch_coverage_threshold(Mode::Production, SurfaceClass::PublicStable)
  assert bc == 0.75
end

# ——————————————————————————————————————————————————
# §27 — Enforcement Matrix
# ——————————————————————————————————————————————————

@test
def test_enforcement_actions()
  use tg_compiler::mode::Mode
  use tg_compiler::cqs::{
    SurfaceClass, enforcement_action, EnforcementAction
  }

  # Dev mode: always log
  assert enforcement_action(Mode::Dev, SurfaceClass::PublicStable)
    == EnforcementAction::Log

  # Strict mode + PublicStable: warn
  assert enforcement_action(Mode::Strict, SurfaceClass::PublicStable)
    == EnforcementAction::Warn

  # Production + PublicStable: gate fail
  assert enforcement_action(Mode::Production, SurfaceClass::PublicStable)
    == EnforcementAction::GateFail

  # Production + Internal: warn
  assert enforcement_action(Mode::Production, SurfaceClass::Internal)
    == EnforcementAction::Warn
end

# ——————————————————————————————————————————————————
# §38-40 — Signal Parameters
# ——————————————————————————————————————————————————

@test
def test_signal_defaults()
  use tg_compiler::cqs::{SignalKind, default_signal_params}

  let cf1 = default_signal_params(SignalKind::CF_1)
  assert cf1.weight == 8.0
  assert cf1.beta > 0.0
  assert cf1.cap > 0.0

  let eh1 = default_signal_params(SignalKind::EH_1)
  assert eh1.weight == 12.0
end

# ——————————————————————————————————————————————————
# §60-67 — Coverage Artifacts
# ——————————————————————————————————————————————————

@test
def test_coverage_stable_ids()
  use tg_compiler::coverage::{
    compute_symbol_id, compute_stable_branch_id, compute_stable_arm_id
  }

  let sid = compute_symbol_id("mod::func", "Function")
  assert !sid.is_empty()

  # Same input → same ID (deterministic)
  let sid2 = compute_symbol_id("mod::func", "Function")
  assert sid == sid2

  let bid = compute_stable_branch_id("mod::func", "match", 42)
  assert !bid.is_empty()

  let aid = compute_stable_arm_id(&bid, "Some(_)")
  assert !aid.is_empty()
end

@test
def test_tgcov_roundtrip()
  use tg_compiler::coverage::{
    CoverageHeader, CoverageRecord, CoverageArtifact,
    default_header, serialize_tgcov, parse_tgcov
  }

  let artifact = CoverageArtifact {
    header: default_header(),
    records: vec![CoverageRecord {
      symbol_id: "test_id",
      branch_id: "branch_1",
      arm_id: "arm_a",
      hits: 5,
      source_file: "test.tg",
      line: 10
    }]
  }

  let jsonl = serialize_tgcov(&artifact)
  let parsed = parse_tgcov(&jsonl)
  assert parsed.is_ok()
  let restored = parsed.unwrap()
  assert restored.records.len() == 1
  assert restored.records[0].hits == 5
end

@test
def test_coverage_merge()
  use tg_compiler::coverage::{
    CoverageArtifact, CoverageRecord, CoverageHeader,
    default_header, merge_artifacts
  }

  let a = CoverageArtifact {
    header: default_header(),
    records: vec![CoverageRecord {
      symbol_id: "fn1", branch_id: "b1", arm_id: "a1",
      hits: 3, source_file: "a.tg", line: 1
    }]
  }
  let b = CoverageArtifact {
    header: default_header(),
    records: vec![CoverageRecord {
      symbol_id: "fn1", branch_id: "b1", arm_id: "a1",
      hits: 7, source_file: "a.tg", line: 1
    }]
  }

  let merged = merge_artifacts(&vec![a, b])
  assert merged.is_ok()
  let m = merged.unwrap()
  assert m.records[0].hits == 10  # 3 + 7
end

# ——————————————————————————————————————————————————
# §68-74 — Capability Drift Baseline
# ——————————————————————————————————————————————————

@test
def test_capability_extraction()
  use tg_compiler::cap_baseline::{
    extract_direct_caps, CapBaseline, detect_drift
  }

  let caps1 = extract_direct_caps("fn_a", &vec!["Net", "IO"])
  assert caps1.caps.contains("Net")
  assert caps1.caps.contains("IO")
end

@test
def test_drift_detection()
  use tg_compiler::cap_baseline::{
    SymbolCaps, CapBaseline, ModuleCaps, detect_drift, DriftResult
  }

  let baseline = CapBaseline {
    version: 1,
    modules: vec![ModuleCaps {
      module: "app",
      symbols: vec![SymbolCaps {
        symbol: "fetch",
        caps: vec!["Net", "IO"].into_iter().collect()
      }]
    }]
  }

  let current = CapBaseline {
    version: 2,
    modules: vec![ModuleCaps {
      module: "app",
      symbols: vec![SymbolCaps {
        symbol: "fetch",
        caps: vec!["Net", "IO", "File"].into_iter().collect()  # Added File
      }]
    }]
  }

  let drift = detect_drift(&baseline, &current)
  assert !drift.added.is_empty()  # File was added
  assert drift.added.iter().any(|d| d.symbol == "fetch" && d.cap == "File")
end

# ——————————————————————————————————————————————————
# §75-79 — Branch Stability & Anchors
# ——————————————————————————————————————————————————

@test
def test_branch_anchors()
  use tg_compiler::coverage::{
    BranchAnchor, compute_anchor_branch_id, arm_discriminant
  }

  let anchor = BranchAnchor {
    origin_kind: "match",
    origin_span: "fn::process:42",
    path: vec!["fn", "process", "match"]
  }

  let id = compute_anchor_branch_id(&anchor)
  assert !id.is_empty()

  # Same anchor → same ID
  let id2 = compute_anchor_branch_id(&anchor)
  assert id == id2

  let disc = arm_discriminant("Some(x)")
  assert !disc.is_empty()
end

# ——————————————————————————————————————————————————
# §83-90 — Symbol Graph & CWS
# ——————————————————————————————————————————————————

@test
def test_symbol_graph_basic()
  use tg_compiler::symbol_graph::{
    SymbolGraph, GraphKind, GraphNode, GraphEdge
  }

  let graph = SymbolGraph {
    nodes: vec![
      GraphNode { id: 0, symbol: "main", module: "app", kind: "Function" },
      GraphNode { id: 1, symbol: "helper", module: "app", kind: "Function" }
    ],
    edges: vec![
      GraphEdge { from: 0, to: 1, kind: GraphKind::Call, weight: 1.0 }
    ]
  }

  let callees = graph.query_callees(0)
  assert callees.len() == 1
  assert callees[0] == 1

  let callers = graph.query_callers(1)
  assert callers.len() == 1
  assert callers[0] == 0
end

@test
def test_seed_set_construction()
  use tg_compiler::symbol_graph::{build_seed_set, SeedEntry}

  let seeds = build_seed_set(
    &vec!["main", "process"],
    &vec![("main", 10.0), ("process", 5.0)]
  )
  assert seeds.seeds.len() == 2
  # Sorted by priority descending
  assert seeds.seeds[0].symbol_id == "main"
end

# ——————————————————————————————————————————————————
# §91-103 — Context Pack
# ——————————————————————————————————————————————————

@test
def test_ctxpack_item_cost()
  use tg_compiler::context_pack::{item_cost_cu}

  # "{}" = 2 bytes → ceil(2/4) + 10 = 11
  let cost = item_cost_cu("{}")
  assert cost == 11

  # "a"*100 = 100 bytes → ceil(100/4) + 10 = 35
  let cost2 = item_cost_cu("a".repeat(100))
  assert cost2 == 35
end

@test
def test_compliance_level()
  use tg_compiler::context_pack::{
    Ctxpack, check_compliance, ComplianceLevel,
    ToolchainInfo, PackIdentity, DeterminismInfo,
    PackInputs, PackQuery, IndexRefs, PackBudgets, BudgetUsed,
    GraphMetadata, EdgeCosts, GraphLimits, default_edge_costs, default_limits,
    SelectionModel, Artifacts, CtxItem, ItemWhy, SeedDistanceInfo,
    SliceMembership, MarginalGain, SpanEntry, Proof, NeedEntry,
    ObjectiveValue, GreedyTraceEntry, TruncationInfo
  }

  let toolchain = ToolchainInfo {
    edition: "2025", tgc_version: "0.1.0",
    tg_version: "0.1.0", target: "aarch64-apple-darwin"
  }
  let identity = PackIdentity {
    pack_id: "abc123", created_utc: "2025-01-01T00:00:00Z",
    profile: "backend", mode: "Production",
    determinism: DeterminismInfo {
      sort_order: "lexicographic", hash_scheme: "sha256",
      branch_id_scheme: "v2", arm_id_scheme: "v2"
    }
  }
  let inputs = PackInputs {
    query: PackQuery { kind: "compile_error", value: "E0001", primary_spans: Vec::new() },
    seed_symbols: Vec::new(),
    index: IndexRefs {
      symbol_graph_id: Option::None, sdg_id: Option::None,
      coverage_id: Option::None, caps_baseline_id: Option::None
    }
  }
  let budgets = PackBudgets {
    unit: "CU", total: 1000, summaries: 500, code: 500,
    used: BudgetUsed { total: 0, summaries: 0, code: 0 }
  }
  let graphs = GraphMetadata {
    edge_costs: default_edge_costs(),
    radius_caps: Map::new(),
    limits: default_limits()
  }
  let selection = SelectionModel {
    algorithm: "submodular_greedy_knapsack",
    objective: "weighted_need_coverage",
    alpha: 0.5, k: 50, needs_profile: "backend",
    weights: Map::new()
  }
  let artifacts = Artifacts {
    quality_report_path: Option::None,
    merged_coverage_path: Option::None
  }
  let no_sdg_slice = SliceMembership {
    in_backward_slice: false, in_forward_slice: false,
    sdg_available: false, sdg_nodes: Vec::new()
  }
  let sdg_slice = SliceMembership {
    in_backward_slice: true, in_forward_slice: false,
    sdg_available: true, sdg_nodes: vec![1, 2]
  }
  let default_why = ItemWhy {
    seed_distance: SeedDistanceInfo { min: 1.0, avg: 1.5, sources: Vec::new() },
    slice_membership: no_sdg_slice.clone(),
    marginal_gain: MarginalGain { delta_f: 0.1, delta_per_cu: 0.01 },
    priority_tags: Vec::new()
  }
  let empty_proof = Proof {
    needs_universe: Vec::new(),
    candidates_considered: 0,
    selected_count: 0,
    objective_value: ObjectiveValue { f_selected: 0.0, f_upper_bound: 0.0 },
    greedy_trace: Vec::new(),
    trace_truncated: false,
    f_upper_bound: 0.0,
    truncation: TruncationInfo {
      candidate_cap_hit: false, edge_cap_hit: false, seed_cap_hit: false
    }
  }

  # Test Level 1: empty pack (no summaries, no spans, no proof work)
  let pack_l1 = Ctxpack {
    schema_version: "ctxpack.v0.2", tangerine: toolchain.clone(),
    pack: identity.clone(), inputs: inputs.clone(),
    budgets: budgets.clone(), graphs: graphs.clone(),
    selection: selection.clone(), artifacts: artifacts.clone(),
    items: Vec::new(), spans: Vec::new(), proof: empty_proof.clone()
  }
  let level1 = check_compliance(&pack_l1)
  assert level1 == ComplianceLevel::Level1

  # Test Level 2: has summaries + spans + proof + SDG slicing
  let summary_item = CtxItem {
    item_id: "sym_001", tier: "S", kind: "symbol_summary",
    cost_cu: 15, covers: vec!["need_001"],
    why: ItemWhy {
      seed_distance: SeedDistanceInfo { min: 1.0, avg: 1.0, sources: Vec::new() },
      slice_membership: sdg_slice.clone(),
      marginal_gain: MarginalGain { delta_f: 0.5, delta_per_cu: 0.033 },
      priority_tags: Vec::new()
    },
    payload: "{\"name\": \"foo\"}"
  }
  let span_entry = SpanEntry {
    span_ref: "sp_001", file: "main.tg", start: 0, end_pos: 50,
    hash: "deadbeef", language: "tangerine", text: "def foo() -> Int\n  42\nend"
  }
  let active_proof = Proof {
    needs_universe: vec![NeedEntry { id: "need_001", weight: 1.0, category: "error" }],
    candidates_considered: 5,
    selected_count: 1,
    objective_value: ObjectiveValue { f_selected: 0.5, f_upper_bound: 1.0 },
    greedy_trace: vec![GreedyTraceEntry {
      step: 1, picked_item_id: "sym_001", cost_cu: 15,
      delta_f: 0.5, delta_per_cu: 0.033, budget_remaining_cu: 985
    }],
    trace_truncated: false,
    f_upper_bound: 1.0,
    truncation: TruncationInfo {
      candidate_cap_hit: false, edge_cap_hit: false, seed_cap_hit: false
    }
  }
  let pack_l2 = Ctxpack {
    schema_version: "ctxpack.v0.2", tangerine: toolchain.clone(),
    pack: identity.clone(), inputs: inputs.clone(),
    budgets: budgets.clone(), graphs: graphs.clone(),
    selection: selection.clone(), artifacts: artifacts.clone(),
    items: vec![summary_item.clone()],
    spans: vec![span_entry.clone()],
    proof: active_proof.clone()
  }
  let level2 = check_compliance(&pack_l2)
  assert level2 == ComplianceLevel::Level2

  # Test Level 3: SDG + taint_flow + capability bundles
  let taint_item = CtxItem {
    item_id: "taint_001", tier: "L", kind: "taint_flow_bundle",
    cost_cu: 20, covers: vec!["need_002"],
    why: ItemWhy {
      seed_distance: SeedDistanceInfo { min: 2.0, avg: 2.5, sources: Vec::new() },
      slice_membership: sdg_slice.clone(),
      marginal_gain: MarginalGain { delta_f: 0.3, delta_per_cu: 0.015 },
      priority_tags: Vec::new()
    },
    payload: "{\"flow\": \"src_to_sink\"}"
  }
  let pack_l3 = Ctxpack {
    schema_version: "ctxpack.v0.2", tangerine: toolchain.clone(),
    pack: identity.clone(), inputs: inputs.clone(),
    budgets: budgets.clone(), graphs: graphs.clone(),
    selection: selection.clone(), artifacts: artifacts.clone(),
    items: vec![summary_item.clone(), taint_item],
    spans: vec![span_entry],
    proof: active_proof
  }
  let level3 = check_compliance(&pack_l3)
  assert level3 == ComplianceLevel::Level3
end

# ——————————————————————————————————————————————————
# §15 — Semantic Refactor
# ——————————————————————————————————————————————————

@test
def test_refactor_kinds()
  use tg_compiler::refactor::{
    RefactorKind, RefactorResult, RefactorDiagnostic, RefactorSeverity
  }

  # Verify enum values exist and are distinct
  let r = RefactorKind::Rename
  let e = RefactorKind::ExtractFunction
  let i = RefactorKind::InlineVariable

  assert r != e
  assert e != i
end
