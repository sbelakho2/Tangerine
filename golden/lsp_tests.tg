## Golden Tests — LSP Implementation
## TEST-009: Tests for LSP hover, completion, goto-definition

use std::test::assert
use tg_compiler::driver::{
  LspServer, lsp_server_new, lsp_did_open,
  lsp_hover, lsp_completion, lsp_goto_definition,
  LspPosition, LspHoverResult, LspCompletionItem, LspLocation
}

# ——————————————————————————————————————————————————
# Test: LSP document open and indexing
# ——————————————————————————————————————————————————

@test
def test_lsp_did_open_indexes_symbols()
  mut server = lsp_server_new()
  let uri = "file:///test/sample.tg"
  let content = "def add(a: Int, b: Int) -> Int\n  a + b\nend\n\nstruct Point\n  x: Float\n  y: Float\nend\n"
  lsp_did_open(&mut server, uri.to_string(), content.to_string())

  # Document should be tracked
  assert server.documents.contains_key(&uri)
  # Symbols should be indexed
  assert server.symbol_tables.contains_key(&uri)
  let symbols = server.symbol_tables.get(&uri).unwrap()
  assert symbols.len() >= 2  # at least `add` and `Point`
end

# ——————————————————————————————————————————————————
# Test: LSP hover — function signature
# ——————————————————————————————————————————————————

@test
def test_lsp_hover_on_function()
  mut server = lsp_server_new()
  let uri = "file:///test/hover.tg"
  let content = "## Adds two integers.\ndef add(a: Int, b: Int) -> Int\n  a + b\nend\n"
  lsp_did_open(&mut server, uri.to_string(), content.to_string())

  # Hover on line 1 (0-indexed), character 4 — should be `add`
  let pos = LspPosition { line: 1, character: 4 }
  let result = lsp_hover(&server, uri.to_string(), pos)
  match result
  when Option::Some(hover) then
    assert hover.contents.contains("add")
    assert hover.contents.contains("Int")
  when Option::None then
    assert false
  end
end

# ——————————————————————————————————————————————————
# Test: LSP hover — no result on whitespace
# ——————————————————————————————————————————————————

@test
def test_lsp_hover_on_whitespace()
  mut server = lsp_server_new()
  let uri = "file:///test/hover2.tg"
  let content = "def foo() -> Int\n  42\nend\n\n\n"
  lsp_did_open(&mut server, uri.to_string(), content.to_string())

  # Hover on empty line 4 — should return None
  let pos = LspPosition { line: 4, character: 0 }
  let result = lsp_hover(&server, uri.to_string(), pos)
  match result
  when Option::None then ()
  when Option::Some(_) then assert false
  end
end

# ——————————————————————————————————————————————————
# Test: LSP completion — keywords and symbols
# ——————————————————————————————————————————————————

@test
def test_lsp_completion_suggests_symbols()
  mut server = lsp_server_new()
  let uri = "file:///test/complete.tg"
  let content = "def helper() -> Int\n  42\nend\n\ndef main()\n  hel\nend\n"
  lsp_did_open(&mut server, uri.to_string(), content.to_string())

  # Completion at "hel" position (line 5, char 5)
  let pos = LspPosition { line: 5, character: 5 }
  let items = lsp_completion(&server, uri.to_string(), pos)
  # Should suggest `helper`
  mut found_helper = false
  for item in items do
    if item.label == "helper" then
      found_helper = true
    end
  end
  assert found_helper == true
end

# ——————————————————————————————————————————————————
# Test: LSP goto definition
# ——————————————————————————————————————————————————

@test
def test_lsp_goto_definition()
  mut server = lsp_server_new()
  let uri = "file:///test/goto.tg"
  let content = "def target() -> Int\n  42\nend\n\ndef caller() -> Int\n  target()\nend\n"
  lsp_did_open(&mut server, uri.to_string(), content.to_string())

  # Goto definition on `target()` call at line 5, char 2
  let pos = LspPosition { line: 5, character: 2 }
  let result = lsp_goto_definition(&server, uri.to_string(), pos)
  match result
  when Option::Some(loc) then
    assert loc.uri == uri
    # Definition should be at line 0 (where `def target` is)
    assert loc.range.start.line == 0
  when Option::None then
    assert false
  end
end

# ——————————————————————————————————————————————————
# Test: LSP diagnostics on open
# ——————————————————————————————————————————————————

@test
def test_lsp_diagnostics_on_error()
  mut server = lsp_server_new()
  let uri = "file:///test/diag.tg"
  let content = "def bad() -> Int\n  \"not an int\"\nend\n"
  lsp_did_open(&mut server, uri.to_string(), content.to_string())

  # Should have diagnostics for the type mismatch
  match server.diagnostics.get(&uri)
  when Option::Some(diags) then
    assert diags.len() > 0
  when Option::None then
    assert false
  end
end
