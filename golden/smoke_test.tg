# Tangerine Stage1 self-compile smoke test program
# This is the first .tg program compiled by the Stage0 (Rust) compiler.
# It exercises: functions, structs, enums, match, if/else, while, arithmetic.

struct Point
  x: Int
  y: Int
end

enum Shape
  Circle(Int)
  Rectangle(Int, Int)
end

def add(a: Int, b: Int) -> Int
  a + b
end

def multiply(a: Int, b: Int) -> Int
  a * b
end

def factorial(n: Int) -> Int
  if n <= 1
    1
  else
    n * factorial(n - 1)
  end
end

def area(s: Shape) -> Int
  match s
  when Circle(r) then
    multiply(multiply(r, r), 3)
  when Rectangle(w, h) then
    multiply(w, h)
  end
end

def distance_sq(p: Point) -> Int
  add(multiply(p.x, p.x), multiply(p.y, p.y))
end

def sum_to(n: Int) -> Int
  mut total: Int = 0
  mut i: Int = 1
  while i <= n
    total = total + i
    i = i + 1
  end
  total
end

def main() -> Int
  let x: Int = add(10, 32)
  let f: Int = factorial(5)
  let s: Int = sum_to(10)
  let p: Point = Point(3, 4)
  let d: Int = distance_sq(p)
  add(x, add(f, add(s, d)))
end
