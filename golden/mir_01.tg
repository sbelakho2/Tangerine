## Golden test: MIR — basic lowering, CFG, branches
## Directives: # expect: mir_contains "pattern" asserts MIR output includes pattern

# expect: mir_contains "call fib"
# expect: mir_contains "branch_if"
def fib(n: Int) -> Int
  if n <= 1
    n
  else
    fib(n - 1) + fib(n - 2)
  end
end

# expect: mir_contains "loop_header"
# expect: mir_contains "back_edge"
def factorial(n: Int) -> Int
  mut result: Int = 1
  mut i: Int = 1
  while i <= n
    result = result * i
    i = i + 1
  end
  result
end

# ——— Additional MIR optimization pass coverage ———

# Test: constant folding — arithmetic on constants
# expect: mir_contains "const 30"
# expect: mir_contains "const 85"
def constant_folding_arith() -> Int
  let a: Int = 10 + 20
  let b: Int = a * 3
  let c: Int = b - 5
  let d: Int = c / 5
  d
end

# Test: constant folding — boolean expressions
# expect: mir_contains "const true"
def constant_folding_bool() -> Bool
  let x: Bool = true && false
  let y: Bool = !x || true
  y
end

# Test: dead code elimination — unused variables
# expect: mir_not_contains "unused1"
# expect: mir_not_contains "unused2"
def dead_code_unused_vars() -> Int
  let used: Int = 42
  let unused1: Int = 999
  let unused2: String = "waste"
  used
end

# Test: dead code elimination — unreachable branch
def dead_code_unreachable_branch() -> Int
  if true then
    return 1
  else
    return 2
  end
end

# Test: dead code elimination — code after return
# expect: mir_not_contains "let x"
def dead_code_after_return() -> Int
