  let x: Int = 20
  x
end

# Test: copy propagation — chain of simple copies
# expect: mir_contains "const 42"
# expect: mir_not_contains "copy b"
def copy_propagation_chain() -> Int
  let a: Int = 42
  let b: Int = a
  let c: Int = b
  let d: Int = c
  d
end

# Test: loop-invariant code motion
# expect: mir_contains "hoist"
def loop_invariant_hoist(n: Int, base: Int) -> Int
  mut sum: Int = 0
  let multiplier: Int = base * 3
  mut i: Int = 0
  while i < n do
    let offset: Int = base + 1
    sum = sum + offset + i
    i = i + 1
  end
  sum
end

# Test: function inlining candidate
def add(a: Int, b: Int) -> Int
  a + b
end

def inline_candidate() -> Int
  let x: Int = add(1, 2)
  let y: Int = add(x, 3)
  y
end

# Test: global value numbering — redundant computation
# expect: mir_contains "add"
# expect: mir_not_contains "redundant_add"
def redundant_computation(a: Int, b: Int) -> Int
  let x: Int = a + b
  let y: Int = a + b
  x + y
end

# Test: bounds check elimination after length check
def bounds_check_elim(arr: Array[Int]) -> Int
  if arr.len() > 0 then
    arr[0]
  else
    -1
  end
end

# Test: match lowering into CFG switch
# expect: mir_contains "switch"
def match_lowering(x: Int) -> String
  match x
  when 0 then "zero"
  when 1 then "one"
  when 2 then "two"
  when _ then "other"
  end
end

# Test: nested control flow CFG structure
def nested_cfg(n: Int) -> Int
  mut total: Int = 0
  mut i: Int = 0
  while i < n do
    if i % 2 == 0 then
      total = total + i
    else
      if i % 3 == 0 then
        total = total + i * 2
      end
    end
    i = i + 1
  end
  total
end

# Test: for-in loop lowering
# expect: mir_contains "iterator"
# expect: mir_contains "loop_header"
def for_loop_sum(items: Array[Int]) -> Int
  mut sum: Int = 0
  for item in items do
    sum = sum + item
  end
  sum
end
