## Golden Tests — ABI / FFI Bindgen
## TEST-010: Tests for FFI binding generation and ABI compatibility

use std::test::assert

# ——————————————————————————————————————————————————
# FFI Bindgen — C header generation
# ——————————————————————————————————————————————————

@test
def test_bindgen_c_exported_function()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parse, diag_has_errors}
  use tg_compiler::driver::{is_ffi_exported, generate_c_prototype}
  use tg_compiler::ast::{Annotation, FunctionDecl, ItemKind}

  let src = "@export\ndef add(a: Int, b: Int) -> Int\n  a + b\nend"
  let tokens = tokenize(src)
  let (ast, diags) = parse(tokens)
  assert !diag_has_errors(&diags)
  assert ast.items.len() == 1

  match ast.items[0].kind
  when ItemKind::Function(f) then
    assert is_ffi_exported(&f, &ast.items[0].annotations) == true
    let proto = generate_c_prototype(&f)
    assert proto.contains("tg_int")
    assert proto.contains("add")
  when _ then assert false
  end
end

@test
def test_bindgen_c_non_exported_function()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parse, diag_has_errors}
  use tg_compiler::driver::is_ffi_exported
  use tg_compiler::ast::ItemKind

  let src = "def internal(x: Int) -> Int\n  x\nend"
  let tokens = tokenize(src)
  let (ast, diags) = parse(tokens)
  assert !diag_has_errors(&diags)

  match ast.items[0].kind
  when ItemKind::Function(f) then
    assert is_ffi_exported(&f, &ast.items[0].annotations) == false
  when _ then assert false
  end
end

@test
def test_bindgen_c_repr_c_struct()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parse, diag_has_errors}
  use tg_compiler::driver::{is_repr_c, generate_c_struct}
  use tg_compiler::ast::ItemKind

  let src = "@repr(c)\nstruct Point\n  x: Float\n  y: Float\nend"
  let tokens = tokenize(src)
  let (ast, diags) = parse(tokens)
  assert !diag_has_errors(&diags)

  match ast.items[0].kind
  when ItemKind::Struct(s) then
    assert is_repr_c(&ast.items[0].annotations) == true
    let c_struct = generate_c_struct(&s)
    assert c_struct.contains("typedef struct")
    assert c_struct.contains("Point")
    assert c_struct.contains("tg_float")
  when _ then assert false
  end
end

@test
def test_bindgen_c_non_repr_c_struct()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parse, diag_has_errors}
  use tg_compiler::driver::is_repr_c
  use tg_compiler::ast::ItemKind

  let src = "struct Internal\n  data: String\nend"
  let tokens = tokenize(src)
  let (ast, diags) = parse(tokens)
  assert !diag_has_errors(&diags)

  match ast.items[0].kind
  when ItemKind::Struct(s) then
    assert is_repr_c(&ast.items[0].annotations) == false
  when _ then assert false
  end
end

# ——————————————————————————————————————————————————
# Type mapping — Tangerine → C
# ——————————————————————————————————————————————————

@test
def test_tangerine_type_to_c_mapping()
  use tg_compiler::driver::tangerine_type_to_c

  assert tangerine_type_to_c("Int") == "tg_int"
  assert tangerine_type_to_c("UInt") == "tg_uint"
  assert tangerine_type_to_c("Float") == "tg_float"
  assert tangerine_type_to_c("Bool") == "bool"
  assert tangerine_type_to_c("U8") == "tg_u8"
  assert tangerine_type_to_c("Char") == "tg_char"
  assert tangerine_type_to_c("String") == "tg_str"
end

# ——————————————————————————————————————————————————
# ABI — struct layout
# ——————————————————————————————————————————————————

@test
def test_abi_struct_alignment()
  # Verify that @repr(c) structs follow C ABI layout rules
  # Int = 8 bytes, Float = 8 bytes, Bool = 1 byte
  use tg_compiler::codegen::{compute_struct_layout, StructField}

  let fields = Vec::from([
    StructField { name: "a", type_size: 8, type_align: 8 },
    StructField { name: "b", type_size: 1, type_align: 1 },
    StructField { name: "c", type_size: 8, type_align: 8 },
  ])
  let layout = compute_struct_layout(&fields, true)  # repr_c = true
  # 'b' at offset 8 should be padded to align 'c' at offset 16
  assert layout.offsets[0] == 0   # a
  assert layout.offsets[1] == 8   # b
  assert layout.offsets[2] == 16  # c (aligned to 8)
  assert layout.total_size == 24
end

# ——————————————————————————————————————————————————
# FFI — extern function linkage
# ——————————————————————————————————————————————————

@test
def test_extern_function_parsed()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parse, diag_has_errors}
  use tg_compiler::ast::ItemKind

  let src = "extern def puts(s: &U8) -> Int"
  let tokens = tokenize(src)
  let (ast, diags) = parse(tokens)
  assert !diag_has_errors(&diags)
  assert ast.items.len() == 1

  match ast.items[0].kind
  when ItemKind::Function(f) then
    assert f.name == "puts"
    assert f.is_extern == true
  when _ then assert false
  end
end

# ——————————————————————————————————————————————————
# Bindgen — enum to C
# ——————————————————————————————————————————————————

@test
def test_bindgen_c_repr_c_enum()
  use tg_compiler::lexer::tokenize
  use tg_compiler::parser::{parse, diag_has_errors}
  use tg_compiler::driver::{is_repr_c, generate_c_enum}
  use tg_compiler::ast::ItemKind

  let src = "@repr(c)\nenum Color\n  Red\n  Green\n  Blue\nend"
  let tokens = tokenize(src)
  let (ast, diags) = parse(tokens)
  assert !diag_has_errors(&diags)

  match ast.items[0].kind
  when ItemKind::Enum(e) then
    assert is_repr_c(&ast.items[0].annotations) == true
    let c_enum = generate_c_enum(&e)
    assert c_enum.contains("enum")
    assert c_enum.contains("Red")
    assert c_enum.contains("Green")
    assert c_enum.contains("Blue")
  when _ then assert false
  end
end
