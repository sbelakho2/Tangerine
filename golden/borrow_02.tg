## Golden test: borrow checker — error rejection cases
## Tests double mutable borrows, dangling references, and use-after-move.
# expect: error

# Test: double mutable borrow (should be rejected)
def double_mut_borrow_error() -> Int
  let mut s: String = "hello"
  let r1: &mut String = &mut s
  let r2: &mut String = &mut s   # ERROR: second mutable borrow while r1 alive
  0
end

# Test: mutable borrow while immutably borrowed
def mut_borrow_while_shared() -> Int
  let mut s: String = "hello"
  let r1: &String = &s
  let r2: &mut String = &mut s   # ERROR: mutable borrow while shared borrow alive
  0
end

# Test: immutable borrow while mutably borrowed
def shared_borrow_while_mut() -> Int
  let mut s: String = "hello"
  let r1: &mut String = &mut s
  let r2: &String = &s           # ERROR: shared borrow while mutable borrow alive
  0
end

# Test: use after move (dangling use)
def use_after_move() -> Int
  let s: String = "hello"
  take_ownership(s)
  let len: Int = s.len()         # ERROR: use of moved value `s`
  len
end

def take_ownership(s: String) -> Int
  42
end

# Test: borrow of moved value (dangling reference)
def borrow_after_move() -> Int
  let s: String = "hello"
  take_ownership(s)
  let r: &String = &s            # ERROR: cannot borrow moved value `s`
  0
end

# Test: dangling reference — returning a borrow to a local
def dangling_ref() -> &String
  let s: String = "local"
  &s                              # ERROR: `s` does not live long enough
end

# Test: move out of borrowed context
def move_while_borrowed() -> String
  let mut s: String = "hello"
  let r: &String = &s
  let moved: String = s           # ERROR: cannot move `s` while borrowed
  moved
end

# Test: double mutable borrow through struct field
struct Container
  data: String
end

def double_mut_borrow_field() -> Int
  let mut c: Container = Container { data: "value" }
  let r1: &mut String = &mut c.data
  let r2: &mut String = &mut c.data   # ERROR: double mutable borrow of c.data
  0
end
