## Golden test: type system — basic inference, generics, trait bounds
# expect: ok

def id[T](x: T) -> T
  x
end

def first[T](a: T, b: T) -> T
  a
end

struct Box[T]
  value: T
end

def unbox[T](b: Box[T]) -> T
  b.value
end

trait Eq
  def eq(self, other: Self) -> Bool
end

# ——— Additional type system coverage ———

# Test: trait with multiple methods
trait Printable
  def to_string(self) -> String
  def debug_string(self) -> String
end

# Test: basic trait implementation for a concrete type
struct Point
  x: Int
  y: Int
end

impl Eq for Point
  def eq(self, other: Point) -> Bool
    self.x == other.x && self.y == other.y
  end
end

impl Printable for Point
  def to_string(self) -> String
    "Point"
  end

  def debug_string(self) -> String
    "Point(debug)"
  end
end

# Test: trait implementation for a generic type
impl[T: Eq] Eq for Box[T]
  def eq(self, other: Box[T]) -> Bool
    self.value.eq(other.value)
  end
end

# Test: trait with associated type
trait Iterator
  type Item
  def next(self) -> Option[Self::Item]
end

# Test: associated type in impl
struct Counter
  current: Int
  max: Int
end

impl Iterator for Counter
  type Item = Int
  def next(self) -> Option[Int]
    if self.current < self.max then
      let val: Int = self.current
      self.current = self.current + 1
      Option::Some(val)
    else
      Option::None
    end
  end
end

# Test: trait with associated type and constraint
trait Collection
  type Element
  def len(self) -> Int
  def get(self, index: Int) -> Option[Self::Element]
end

struct IntArray
  items: Array[Int]
end

impl Collection for IntArray
  type Element = Int
  def len(self) -> Int
    self.items.len()
  end
  def get(self, index: Int) -> Option[Int]
    if index >= 0 && index < self.items.len() then
      Option::Some(self.items[index])
    else
      Option::None
    end
  end
end

# Test: trait bound on function
def are_equal[T: Eq](a: T, b: T) -> Bool
  a.eq(b)
end

# Test: multiple trait bounds
def print_and_compare[T: Eq + Printable](a: T, b: T) -> Bool
  let _ : String = a.to_string()
  a.eq(b)
end

# Test: nested generic types
struct Pair[A, B]
  first: A
  second: B
end

def swap[A, B](p: Pair[A, B]) -> Pair[B, A]
  Pair { first: p.second, second: p.first }
end

# Test: default trait method (trait with provided implementation)
trait Describable
  def name(self) -> String
  def description(self) -> String
    "No description for: " + self.name()
  end
end

impl Describable for Point
  def name(self) -> String
    "Point"
  end
  # description() uses the default implementation
end
