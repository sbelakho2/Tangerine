## Golden test: unless keyword, until keyword, default parameters
## Covers: parser desugaring of unless/until, default param syntax

# ——————————————————————————————————————————————————
# §1 — unless (sugar for if !cond)
# ——————————————————————————————————————————————————

def check_positive(n: Int) -> String
  unless n > 0
    return "not positive"
  end
  "positive"
end

def check_with_else(n: Int) -> String
  unless n > 0 then
    "non-positive"
  else
    "positive"
  end
end

# unless as expression
def classify(n: Int) -> String
  let label = unless n == 0 then "nonzero" else "zero" end
  label
end

# ——————————————————————————————————————————————————
# §2 — until (sugar for while !cond)
# ——————————————————————————————————————————————————

def count_up_to(limit: Int) -> Int
  mut i = 0
  until i >= limit do
    i = i + 1
  end
  i
end

def sum_until(limit: Int) -> Int
  mut total = 0
  mut n = 1
  until n > limit
    total = total + n
    n = n + 1
  end
  total
end

# ——————————————————————————————————————————————————
# §3 — Default Parameters
# ——————————————————————————————————————————————————

def greet(name: String = "World") -> String
  "Hello, " + name + "!"
end

def power(base: Int, exp: Int = 2) -> Int
  mut result = 1
  mut i = 0
  while i < exp do
    result = result * base
    i = i + 1
  end
  result
end

def make_point(x: Int = 0, y: Int = 0) -> (Int, Int)
  (x, y)
end

# ——————————————————————————————————————————————————
# §4 — Combined usage
# ——————————————————————————————————————————————————

def process_items(items: Vec[Int], min_val: Int = 0) -> Vec[Int]
  mut result = Vec::new()
  mut i = 0
  until i >= items.len() do
    let item = items[i]
    unless item < min_val then
      result.push(item)
    end
    i = i + 1
  end
  result
end
