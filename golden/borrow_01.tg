## Golden test: access checker — valid read accesses accepted
# expect: ok

def read_sum(a: Int, b: Int) -> Int
  a + b
end

def read_both(x: Int, y: Int) -> Int
  x + y
end

def caller() -> Int
  let v: Int = 5
  let w: Int = 6
  let s: Int = read_sum(v, w)
  let t: Int = read_both(v, v)
  s + t
end
