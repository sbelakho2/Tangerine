## Golden test: borrow checker — ownership, moves, borrows
# expect: ok

def take_ownership(s: String) -> Int
  42
end

def borrow_immut(s: &String) -> Int
  0
end

def borrow_mut(s: &mut String) -> Int
  1
end

struct Container
  data: String
end

def move_field(c: Container) -> String
  c.data
end

# ——— Additional valid borrow patterns ———

# Test: multiple immutable borrows (should be allowed)
def multiple_immut_borrows() -> Int
  let s: String = "hello"
  let r1: &String = &s
  let r2: &String = &s
  0
end

# Test: mutable borrow then use (single mut borrow — valid)
def single_mut_borrow() -> Int
  let mut s: String = "hello"
  let r: &mut String = &mut s
  1
end

# Test: reborrow after original borrow scope ends
def sequential_borrows() -> Int
  let mut s: String = "hello"
  let r1: &mut String = &mut s
  # r1 scope ends, so r2 is valid
  let r2: &String = &s
  0
end
