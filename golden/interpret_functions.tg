def factorial(n: Int) -> Int
  if n <= 1
    return 1
  end
  return n * factorial(n - 1)
end

def fibonacci(n: Int) -> Int
  if n <= 0
    return 0
  end
  if n == 1
    return 1
  end
  return fibonacci(n - 1) + fibonacci(n - 2)
end

def main()
  println!("=== Tangerine MIR Interpreter ===")
  let fact5: Int = factorial(5)
  println!(fact5)
  let fib7: Int = fibonacci(7)
  println!(fib7)
  let sum: Int = fact5 + fib7
  println!(sum)
end

