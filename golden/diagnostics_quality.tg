## Diagnostics Quality Tests
#
# Each test case verifies that the compiler emits the correct
# diagnostic message, help text, and notes for specific errors.

# ———————————————————————————————————————————————————————————————
# E0200: Type mismatch
# ———————————————————————————————————————————————————————————————

# expect: error
# expect-diagnostic: "type mismatch"
# expect-help: "expected `Int`, found `String`"
def type_mismatch_basic() -> Int
  let x: Int = "hello"
  x
end

# ———————————————————————————————————————————————————————————————
# E0300: Use of moved value
# ———————————————————————————————————————————————————————————————

# expect: error
# expect-diagnostic: "use of moved value"
# expect-note: "value moved here"
def use_after_move() -> Unit
  let s = "hello".to_string()
  let t = s       # moves s
  println(s)      # error: s was moved
end

# ———————————————————————————————————————————————————————————————
# E0301: Cannot borrow as mutable
# ———————————————————————————————————————————————————————————————

# expect: error
# expect-diagnostic: "cannot borrow"
# expect-help: "consider changing this to `mut`"
def borrow_immutable() -> Unit
  let x = 42
  let r = &mut x   # error: x is not mutable
end

# ———————————————————————————————————————————————————————————————
# E0100: Undefined variable
# ———————————————————————————————————————————————————————————————

# expect: error
# expect-diagnostic: "undefined"
# expect-help: "did you mean"
def undefined_variable() -> Int
  let count = 10
  coutn + 1         # typo — expect "did you mean `count`?"
end

# ———————————————————————————————————————————————————————————————
# E0400: Missing match arm
# ———————————————————————————————————————————————————————————————

# expect: error
# expect-diagnostic: "non-exhaustive"
# expect-help: "missing"
enum Color
  Red
  Green
  Blue
end

def incomplete_match(c: Color) -> Int
  match c
  when Color::Red then 1
  when Color::Green then 2
  # missing Blue arm
  end
end

# ———————————————————————————————————————————————————————————————
# E0500: Return type mismatch
# ———————————————————————————————————————————————————————————————

# expect: error
# expect-diagnostic: "type mismatch"
# expect-note: "expected `Bool`"
def return_wrong_type() -> Bool
  42
end

# ———————————————————————————————————————————————————————————————
# E0150: Duplicate definition
# ———————————————————————————————————————————————————————————————

# expect: error
# expect-diagnostic: "duplicate"
# expect-note: "previously defined"
def dup_func() -> Unit
  ()
end

def dup_func() -> Unit
  ()
end

# ———————————————————————————————————————————————————————————————
# Parse error: missing end
# NOTE: This test is intentionally placed last in its section and uses
# a recovery sentinel comment so the parser can recover before the next test.
# ———————————————————————————————————————————————————————————————

# expect: parse_error
# expect-diagnostic: "expected `end`"
def unclosed_block() -> Unit
  if true then
    println("hi")
  # missing end — parser should recover at the next `def` keyword
end
# ^^^ recovery: explicit `end` added so subsequent tests are not broken.
# The diagnostic expectation above still fires because the `if` block
# is missing its own `end` before the function-level `end`.

# ———————————————————————————————————————————————————————————————
# Warning: unused variable
# ———————————————————————————————————————————————————————————————

# expect: warning
# expect-diagnostic: "unused variable"
# expect-help: "prefix with `_`"
def unused_var() -> Int
  let unused = 42
  0
end

# ———————————————————————————————————————————————————————————————
# E0302: Mutable borrow while shared borrow alive
# ———————————————————————————————————————————————————————————————

# expect: error
# expect-diagnostic: "cannot borrow"
# expect-note: "shared borrow"
def conflicting_borrows() -> Unit
  mut v = Vec::new()
  v.push(1)
  let r = &v          # shared borrow
  v.push(2)           # mutable borrow while r is alive
  println(r.len().to_string())
end

# ———————————————————————————————————————————————————————————————
# E0201: Mismatched argument count
# ———————————————————————————————————————————————————————————————

# expect: error
# expect-diagnostic: "argument"
# expect-help: "expected 2"
def takes_two(a: Int, b: Int) -> Int
  a + b
end

def wrong_arg_count() -> Int
  takes_two(1)    # only 1 arg
end
