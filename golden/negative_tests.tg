## Golden Tests — Negative / Rejection / Error Cases
## TEST-004: Tests that must fail (contracts, capabilities, budget, hardened mode)

use std::test::{assert, assert_panics, assert_contains}

# ——————————————————————————————————————————————————
# std::contracts — violations
# ——————————————————————————————————————————————————

@test
def test_contract_requires_violation()
  use std::contracts::requires

  @requires(x > 0, "x must be positive")
  def safe_sqrt(x: Float) -> Float
    __intrinsic_sqrt(x)
  end

  # Negative input violates the precondition — should panic with expected reason
  let panic_msg = assert_panics(|| safe_sqrt(-1.0))
  assert_contains(panic_msg, "x must be positive")
end

@test
def test_contract_ensures_violation()
  use std::contracts::ensures

  @ensures(result > 0, "result must be positive")
  def broken_abs(x: Int) -> Int
    x  # Deliberately wrong: negative input returns negative
  end

  let panic_msg = assert_panics(|| broken_abs(-5))
  assert_contains(panic_msg, "result must be positive")
end

@test
def test_contract_invariant_holds()
  use std::contracts::{invariant, ContractError}

  struct BoundedCounter
    count: Int
    max: Int
  end

  @invariant(self.count >= 0 && self.count <= self.max)
  impl BoundedCounter
    def new(max: Int) -> BoundedCounter
      BoundedCounter { count: 0, max: max }
    end

    def increment(&mut self) -> Result[(), ContractError]
      if self.count >= self.max then
        return Result::Err(ContractError::new("counter at max"))
      end
      self.count = self.count + 1
      Result::Ok(())
    end
  end

  mut c = BoundedCounter::new(3)
  assert c.increment().is_ok()
  assert c.increment().is_ok()
  assert c.increment().is_ok()
  # Fourth increment should fail
  assert c.increment().is_err()
end

# ——————————————————————————————————————————————————
# std::capabilities — denied access
# ——————————————————————————————————————————————————

@test
def test_capability_denied_without_grant()
  use std::capabilities::{CapabilitySet, check_capability, file_cap}

  let caps = CapabilitySet::empty()

  # Without FileSystem capability, file access should be denied
  let result = check_capability(&caps, file_cap())
  assert result == false
end

@test
def test_capability_granted()
  use std::capabilities::{CapabilitySet, check_capability, file_cap, net_cap, custom_cap}

  mut caps = CapabilitySet::empty()
  caps.grant(file_cap())
  caps.grant(net_cap())

  assert check_capability(&caps, file_cap()) == true
  assert check_capability(&caps, net_cap()) == true
  assert check_capability(&caps, custom_cap("ProcessSpawn")) == false
end

@test
def test_capability_revoke()
  use std::capabilities::{CapabilitySet, check_capability, net_cap}

  mut caps = CapabilitySet::empty()
  caps.grant(net_cap())
  assert check_capability(&caps, net_cap()) == true

  caps.revoke(net_cap())
  assert check_capability(&caps, net_cap()) == false
end

# ——————————————————————————————————————————————————
# std::budget — resource exhaustion
# ——————————————————————————————————————————————————

@test
def test_budget_exceeded()
  use std::budget::{Budget, BudgetError, budget_new}

  let mut b = budget_new(100)  # 100 units total
  let r1 = b.spend(50)
  assert r1.is_ok()
  let r2 = b.spend(30)
  assert r2.is_ok()
  # Only 20 left, trying to spend 30 should fail
  let r3 = b.spend(30)
  assert r3.is_err()
end

@test
def test_budget_zero_remaining()
  use std::budget::{budget_new}

  let mut b = budget_new(10)
  let _ = b.spend(10)
  assert b.remaining() == 0
  let r = b.spend(1)
  assert r.is_err()
end

# ——————————————————————————————————————————————————
# Hardened mode — unsafe blocks rejected
# ——————————————————————————————————————————————————

# expect: compile_error "unsafe not allowed in hardened mode"
# mode: hardened
# This test verifies that the compiler rejects unsafe blocks in hardened mode.
# The conformance runner should detect the compile_error directive.
#
# def test_hardened_rejects_unsafe()
#   unsafe "testing" do
#     let ptr = __intrinsic_null_ptr()
#   end
# end

@test
def test_hardened_mode_flag_recognized()
  # Verify the compiler recognizes hardened mode configuration
  use tg_compiler::mode::{Mode, config_for_mode}

  let mode = Mode::Hardened
  let hardened_cfg = config_for_mode(mode)
  assert hardened_cfg.forbid_all_unsafe == true

  let normal = Mode::Production
  let normal_cfg = config_for_mode(normal)
  assert normal_cfg.forbid_all_unsafe == false
end

# ——————————————————————————————————————————————————
# Type system — rejection of invalid code
# ——————————————————————————————————————————————————

@test
def test_type_mismatch_detection()
  let src = "def bad() -> Int\n  \"not an int\"\nend"
  let (module, parse_diags) = tg_compiler::parser::parse(tg_compiler::tokenize(src))
  assert tg_compiler::parser::diag_has_errors(&parse_diags) == false
  let type_errors = tg_compiler::types::type_check(&module)
  assert type_errors.len() > 0
end

# ——————————————————————————————————————————————————
# Borrow checker — use-after-move rejection
# ——————————————————————————————————————————————————

@test
def test_borrow_use_after_move()
  let src = "def moved() -> Vec[Int]\n  let v = Vec::new()\n  let w = v\n  v.len()\nend"
  let (module, parse_diags) = tg_compiler::parser::parse(tg_compiler::tokenize(src))
  assert tg_compiler::parser::diag_has_errors(&parse_diags) == false
  let errors = tg_compiler::borrow_check::borrow_check(&module)
  # Should detect use of moved value `v`
  mut found_move_error = false
  for err in errors do
    if err.kind == BorrowErrorKind::UseAfterMove then
      found_move_error = true
    end
  end
  assert found_move_error == true
end
