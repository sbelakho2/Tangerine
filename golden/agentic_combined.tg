## Golden test: Combined agentic features
## Exercises contracts, capabilities, budget, rationale, unsafe — all together.

edition "2026"

rationale "Full agentic demo"
  "This file tests that all agentic features can coexist."
end

cap FileCap end

def guarded_read() -> Int
  requires FileCap
  pre 1 > 0
  post result >= 0
  @budget time_p95 < "5ms"
  42
end

def process(x: Int) -> Int
  pre x >= 0
  post result >= 0
  x * 2
end

def main() -> Int
  unsafe "bootstrap: need file access"
    let data = guarded_read()
    let result = process(data)
    result
  end
end
