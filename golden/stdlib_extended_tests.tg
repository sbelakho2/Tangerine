@test
def test_serde_serialize_deserialize()
  use std::serde::{Serialize, Deserialize}
  # Basic round-trip test with primitives
  let val = 42
  let serialized = serde_to_json(&val)
  assert serialized == "42"
end

# ——————————————————————————————————————————————————
# std::secure_types
# ——————————————————————————————————————————————————

@test
def test_secret_string()
  use std::secure_types::{SecretString}
  let secret = SecretString::new("password123")
  # SecretString should not leak contents via Display/Debug
  assert secret.expose_secret() == "password123"
end

# ——————————————————————————————————————————————————
# std::supply_chain
# ——————————————————————————————————————————————————

@test
def test_lockfile_round_trip()
  use std::supply_chain::{lockfile_parse, lockfile_serialize, Lockfile}
  let toml_str = "[metadata]\nformat_version = \"1\"\nintegrity_hash = \"abc\"\n\n[[packages]]\nname = \"foo\"\nversion = \"1.0.0\"\nsource = \"registry\"\ndeps = []\n"
  let parsed = lockfile_parse(&toml_str)
  match parsed
  when Result::Ok(lockfile) then
    assert lockfile.packages.len() == 1
    assert lockfile.packages[0].name == "foo"
    let re_serialized = lockfile_serialize(&lockfile)
    assert re_serialized.contains("foo")
  when Result::Err(e) then assert false
  end
end

# ——————————————————————————————————————————————————
# std::effects
# ——————————————————————————————————————————————————

@test
def test_effect_inference()
  use std::effects::{infer_effects_from_body, EffectSet}
  # A body with IO call should infer IO effect
  let body_with_io = "std::fs::read_file(path)"
  let effects = infer_effects_from_body(body_with_io)
  assert effects.has_io == true
end

# ——————————————————————————————————————————————————
# std::semantic_diff
# ——————————————————————————————————————————————————

@test
def test_semantic_diff_add_remove()
  use std::semantic_diff::{compute_diff, ChangeKind}
  let old_src = "def foo() -> Int\n  42\nend\n"
  let new_src = "def bar() -> Int\n  42\nend\n"
  let diff = compute_diff(old_src, new_src)
  # foo removed/renamed, bar added/rename target
  assert diff.changes.len() > 0
end

