## Golden Tests — Extended stdlib Coverage
## TEST-001: Tests for modules with zero prior golden test coverage

use std::test::assert

# ——————————————————————————————————————————————————
# std::collections
# ——————————————————————————————————————————————————

@test
def test_vec_deque()
  use std::collections::VecDeque
  mut dq = VecDeque::new()
  dq.push_back(1)
  dq.push_back(2)
  dq.push_front(0)
  assert dq.len() == 3
  assert dq.pop_front() == Option::Some(0)
  assert dq.pop_back() == Option::Some(2)
  assert dq.len() == 1
end

@test
def test_btree_map()
  use std::collections::BTreeMap
  mut m = BTreeMap::new()
  m.insert(3, "three")
  m.insert(1, "one")
  m.insert(2, "two")
  assert m.get(&1) == Option::Some(&"one")
  assert m.get(&2) == Option::Some(&"two")
  assert m.len() == 3
  m.remove(&2)
  assert m.get(&2) == Option::None
  assert m.len() == 2
end

@test
def test_linked_list()
  use std::collections::LinkedList
  mut ll = LinkedList::new()
  ll.push_front(1)
  ll.push_front(2)
  ll.push_back(3)
  assert ll.len() == 3
  assert ll.pop_front() == Option::Some(2)
  assert ll.pop_back() == Option::Some(3)
end

# ——————————————————————————————————————————————————
# std::json
# ——————————————————————————————————————————————————

@test
def test_json_parse_object()
  use std::json::{json_parse, Value}
  let result = json_parse("{\"key\": 42, \"flag\": true}")
  match result
  when Result::Ok(Value::Object(obj)) then
    match obj.get("key")
    when Option::Some(Value::Number(n)) then assert n == 42.0
    when _ then assert false
    end
    match obj.get("flag")
    when Option::Some(Value::Bool(b)) then assert b == true
    when _ then assert false
    end
  when _ then assert false
  end
end

@test
def test_json_parse_array()
  use std::json::{json_parse, Value}
  let result = json_parse("[1, 2, 3]")
  match result
  when Result::Ok(Value::Array(arr)) then
    assert arr.len() == 3
  when _ then assert false
  end
end

@test
def test_json_depth_limit()
  use std::json::{json_parse}
  # Build a deeply nested JSON string (200 levels of arrays)
  mut s = ""
  for _ in 0..200 do
    s = s + "["
  end
  for _ in 0..200 do
    s = s + "]"
  end
  let result = json_parse(&s)
  # Should fail with depth exceeded, not stack overflow
  match result
  when Result::Err(_) then assert true
  when Result::Ok(_) then assert false
  end
end

# ——————————————————————————————————————————————————
# std::io
# ——————————————————————————————————————————————————

@test
def test_io_error_variants()
  use std::io::IOError
  let e1 = IOError::NotFound
  let e2 = IOError::PermissionDenied
  let e3 = IOError::EOF
  let e4 = IOError::TimedOut
  let e5 = IOError::BrokenPipe
  assert e1 != e2
  assert e3 != e4
  assert e4 != e5
end

# ——————————————————————————————————————————————————
# std::env
# ——————————————————————————————————————————————————

@test
def test_env_set_and_get()
  use std::env::{set_var, var, remove_var}
  set_var("TG_TEST_VAR_001", "hello")
  let v = var("TG_TEST_VAR_001")
  assert v == Option::Some("hello")
  remove_var("TG_TEST_VAR_001")
  let v2 = var("TG_TEST_VAR_001")
  assert v2 == Option::None
end

@test
def test_env_temp_dir()
  use std::env::temp_dir
  let t = temp_dir()
  assert t.len() > 0
end

# ——————————————————————————————————————————————————
# std::time
# ——————————————————————————————————————————————————

@test
def test_time_instant()
  use std::time::{instant_now, Instant}
  let a = instant_now()
  let b = instant_now()
  # b should be >= a
  assert b.nanos >= a.nanos
end

# ——————————————————————————————————————————————————
# std::alloc (Rc/WeakRc)
# ——————————————————————————————————————————————————

@test
def test_rc_basic()
  use std::alloc::{rc_new, Rc}
  let rc1 = rc_new(42)
  assert *rc1.get() == 42
  assert rc1.strong_count() == 1

  let rc2 = rc1.clone()
  assert rc1.strong_count() == 2
  assert rc2.strong_count() == 2

  drop(rc2)
  assert rc1.strong_count() == 1
end

@test
def test_rc_weak()
  use std::alloc::{rc_new, Rc, WeakRc}
  let rc1 = rc_new(100)
  let weak = rc1.downgrade()
  assert weak.strong_count() == 1

  let upgraded = weak.upgrade()
  match upgraded
  when Option::Some(rc2) then
    assert *rc2.get() == 100
    assert rc2.strong_count() == 2
  when Option::None then assert false
  end
end

# ——————————————————————————————————————————————————
# std::regex
# ——————————————————————————————————————————————————

@test
def test_regex_match()
  use std::regex::{Regex}
  let re = Regex::new("^[a-z]+$")
  assert re.is_match("hello") == true
  assert re.is_match("Hello") == false
  assert re.is_match("123") == false
end

# ——————————————————————————————————————————————————
# std::url
# ——————————————————————————————————————————————————

@test
def test_url_parse()
  use std::url::{Url, url_parse}
  let result = url_parse("https://example.com:8080/path?q=1")
  match result
  when Result::Ok(u) then
    assert u.scheme == "https"
    assert u.host == "example.com"
    assert u.port == Option::Some(8080)
    assert u.path == "/path"
    assert u.query == Option::Some("q=1")
  when Result::Err(_) then assert false
  end
end

# ——————————————————————————————————————————————————
# std::toml
# ——————————————————————————————————————————————————

@test
def test_toml_parse()
  use std::toml::{toml_parse, TomlValue}
  let input = "[section]\nkey = \"value\"\nnum = 42"
  let result = toml_parse(input)
  match result
  when Result::Ok(doc) then
    match doc.get("section")
    when Option::Some(TomlValue::Table(t)) then
      match t.get("key")
      when Option::Some(TomlValue::String(s)) then assert s == "value"
      when _ then assert false
      end
    when _ then assert false
    end
  when Result::Err(_) then assert false
  end
end

