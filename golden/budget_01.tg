## Golden test: Budget annotations
## Tests parsing of @budget annotations on functions.
# expect: ok

def fast_sort(arr: Int) -> Int
  budget time_p95 < "10ms", alloc_bytes < "1MiB"
  arr
end

def lookup(key: Int) -> Int
  budget time_p50 < "100us"
  key * 2
end

def main() -> Int
  let a = fast_sort(5)
  let b = lookup(3)
  a + b
end
