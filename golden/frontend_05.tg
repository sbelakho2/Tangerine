## Golden test: frontend milestone 5 — expressions, closures, arrays
# Tests: array literals, closures, method calls, string literals, tuple

def make_array() -> Array[Int]
  [1, 2, 3, 4, 5]
end

def square(x: Int) -> Int = x * x

def greet(name: String) -> String
  "Hello, " + name
end

# Additional: closure captured variable
def make_adder(n: Int) -> fn(Int) -> Int
  |x| x + n
end

# Additional: closure as argument
def apply(f: fn(Int) -> Int, x: Int) -> Int
  f(x)
end

def use_closure() -> Int
  let double = |x| x * 2
  apply(double, 21)
end

# Additional: tuple creation and destructuring
def swap(a: Int, b: Int) -> (Int, Int)
  (b, a)
end

def tuple_access() -> Int
  let pair = (10, 20)
  let (first, second) = pair
  first + second
end

# Additional: multi-line closure
def transform_all(items: Array[Int]) -> Array[Int]
  items.map(|x| do
    let doubled = x * 2
    doubled + 1
  end)
end

# Additional: array methods
def array_ops() -> Int
  let arr = [3, 1, 4, 1, 5, 9]
  let filtered = arr.filter(|x| x > 3)
  let sum = filtered.fold(0, |acc, x| acc + x)
  sum
end
