## Simple test without while loops

struct Point
  x: Int
  y: Int
end

def add(a: Int, b: Int) -> Int
  a + b
end

def multiply(a: Int, b: Int) -> Int
  a * b
end

def distance_sq(p: Point) -> Int
  add(multiply(p.x, p.x), multiply(p.y, p.y))
end

def main() -> Int
  let x: Int = add(10, 32)
  let p: Point = Point(3, 4)
  let d: Int = distance_sq(p)
  add(x, d)
end
