# ———————————————————————————————————————————————————————————————
## Standard Library Tests
# ———————————————————————————————————————————————————————————————
# expect: ok

use std::test::*
use std::collections::*
use std::fmt::*

# Helper: approximate floating-point equality (used by geometry tests below)
def assert_approx_eq(actual: Float, expected: Float, epsilon: Float)
  let diff = actual - expected
  let abs_diff = if diff < 0.0 then 0.0 - diff else diff end
  assert abs_diff < epsilon
end

# ———————————————————————————————————————————————————————————————
# Core Primitives Tests
# ———————————————————————————————————————————————————————————————

@test
def test_integer_arithmetic() -> Unit
  assert_eq(2 + 3, 5)
  assert_eq(10 - 7, 3)
  assert_eq(4 * 6, 24)
  assert_eq(15 / 3, 5)
  assert_eq(17 % 5, 2)
  assert_eq(-1 + 1, 0)
  assert_eq(0 * 999, 0)
end

@test
def test_integer_comparison() -> Unit
  assert_true(1 < 2)
  assert_true(2 <= 2)
  assert_true(3 > 2)
  assert_true(3 >= 3)
  assert_true(5 == 5)
  assert_true(5 != 6)
end

@test
def test_boolean_logic() -> Unit
  assert_true(true && true)
  assert_false(true && false)
  assert_true(true || false)
  assert_false(false || false)
  assert_true(!false)
  assert_false(!true)
end

@test
def test_string_operations() -> Unit
  let s = "hello"
  assert_eq(s.len(), 5)
  assert_true(s.starts_with("hel"))
  assert_true(s.ends_with("llo"))
  assert_true(s.contains("ell"))
  assert_eq(s + " world", "hello world")
end

@test
def test_string_methods() -> Unit
  assert_eq("  hello  ".trim(), "hello")
  assert_eq("Hello".to_lowercase(), "hello")
  assert_eq("hello".to_uppercase(), "HELLO")
  assert_eq("hello world".replace("world", "tangerine"), "hello tangerine")
  
  let parts = "a,b,c".split(",")
  assert_eq(parts.len(), 3)
  assert_eq(parts[0], "a")
  assert_eq(parts[1], "b")
  assert_eq(parts[2], "c")
end

@test
def test_char_properties() -> Unit
  assert_true('a'.is_alphabetic())
  assert_true('5'.is_numeric())
  assert_true(' '.is_whitespace())
  assert_false('!'.is_alphanumeric())
end

# ———————————————————————————————————————————————————————————————
# Option Tests
# ———————————————————————————————————————————————————————————————

@test
def test_option_some() -> Unit
  let x: Option[Int] = Option::Some(42)
  assert_true(x.is_some())
  assert_false(x.is_none())
  assert_eq(x.unwrap(), 42)
end

@test
def test_option_none() -> Unit
  let x: Option[Int] = Option::None
  assert_true(x.is_none())
  assert_false(x.is_some())
end

@test
def test_option_unwrap_or() -> Unit
  let some: Option[Int] = Option::Some(10)
  let none: Option[Int] = Option::None
  assert_eq(some.unwrap_or(0), 10)
  assert_eq(none.unwrap_or(0), 0)
end

@test
def test_option_map() -> Unit
  let x: Option[Int] = Option::Some(5)
  let y = x.map(|v| v * 2)
  assert_eq(y.unwrap(), 10)
  
  let z: Option[Int] = Option::None
  let w = z.map(|v| v * 2)
  assert_true(w.is_none())
end

# ———————————————————————————————————————————————————————————————
# Result Tests
# ———————————————————————————————————————————————————————————————

@test
def test_result_ok() -> Unit
  let r: Result[Int, String] = Result::Ok(42)
  assert_true(r.is_ok())
  assert_false(r.is_err())
  assert_eq(r.unwrap(), 42)
end

@test
def test_result_err() -> Unit
  let r: Result[Int, String] = Result::Err("oops".to_string())
  assert_true(r.is_err())
  assert_false(r.is_ok())
  assert_eq(r.unwrap_err(), "oops")
end

@test
def test_result_map() -> Unit
  let r: Result[Int, String] = Result::Ok(10)
  let mapped = r.map(|v| v + 5)
  assert_eq(mapped.unwrap(), 15)
end

# ———————————————————————————————————————————————————————————————
# Vec Tests
# ———————————————————————————————————————————————————————————————

@test
def test_vec_new() -> Unit
  let v: Vec[Int] = Vec::new()
  assert_true(v.is_empty())
  assert_eq(v.len(), 0)
end

@test
def test_vec_push_pop() -> Unit
  mut v = Vec::new()
  v.push(1)
  v.push(2)
  v.push(3)
  assert_eq(v.len(), 3)
  assert_eq(v.pop().unwrap(), 3)
  assert_eq(v.len(), 2)
end

@test
def test_vec_indexing() -> Unit
  let v = vec![10, 20, 30, 40]
  assert_eq(v[0], 10)
  assert_eq(v[1], 20)
  assert_eq(v[3], 40)
end

@test
def test_vec_contains() -> Unit
  let v = vec![1, 2, 3, 4, 5]
  assert_true(v.contains(&3))
  assert_false(v.contains(&6))
end

@test
def test_vec_iter() -> Unit
  let v = vec![1, 2, 3]
  mut sum = 0
  for x in v do
    sum = sum + x
  end
  assert_eq(sum, 6)
end

@test
def test_vec_map() -> Unit
  let v = vec![1, 2, 3]
  let doubled = v.iter().map(|x| x * 2).collect()
  assert_eq(doubled, vec![2, 4, 6])
end

@test
def test_vec_filter() -> Unit
  let v = vec![1, 2, 3, 4, 5, 6]
  let evens: Vec[Int] = v.iter().filter(|x| x % 2 == 0).collect()
  assert_eq(evens, vec![2, 4, 6])
end

@test
def test_vec_sort() -> Unit
  mut v = vec![3, 1, 4, 1, 5, 9, 2, 6]
  v.sort()
  assert_eq(v, vec![1, 1, 2, 3, 4, 5, 6, 9])
end

# ———————————————————————————————————————————————————————————————
# Map Tests
# ———————————————————————————————————————————————————————————————

@test
def test_map_new() -> Unit
  let m: Map[String, Int] = Map::new()
  assert_true(m.is_empty())
  assert_eq(m.len(), 0)
end

@test
def test_map_insert_get() -> Unit
  mut m = Map::new()
  m.insert("one".to_string(), 1)
  m.insert("two".to_string(), 2)
  m.insert("three".to_string(), 3)
  
  assert_eq(m.len(), 3)
  assert_eq(m.get("one").unwrap(), &1)
  assert_eq(m.get("two").unwrap(), &2)
  assert_true(m.get("four").is_none())
end

@test
def test_map_contains() -> Unit
  mut m = Map::new()
  m.insert("key".to_string(), 42)
  assert_true(m.contains_key("key"))
  assert_false(m.contains_key("other"))
end

@test
def test_map_remove() -> Unit
  mut m = Map::new()
  m.insert("a".to_string(), 1)
  m.insert("b".to_string(), 2)
  m.remove("a")
  assert_eq(m.len(), 1)
  assert_false(m.contains_key("a"))
end

# ———————————————————————————————————————————————————————————————
# Set Tests
# ———————————————————————————————————————————————————————————————

@test
def test_set_operations() -> Unit
  mut s: Set[Int] = Set::new()
  s.insert(1)
  s.insert(2)
  s.insert(3)
  s.insert(2)  # duplicate
  
  assert_eq(s.len(), 3)
  assert_true(s.contains(&1))
  assert_false(s.contains(&4))
end

@test
def test_set_union() -> Unit
  mut a: Set[Int] = Set::new()
  a.insert(1)
  a.insert(2)
  
  mut b: Set[Int] = Set::new()
  b.insert(2)
  b.insert(3)
  
  let c = a.union(&b)
  assert_eq(c.len(), 3)
  assert_true(c.contains(&1))
  assert_true(c.contains(&2))
  assert_true(c.contains(&3))
end

@test
def test_set_intersection() -> Unit
  mut a: Set[Int] = Set::new()
  a.insert(1)
  a.insert(2)
  a.insert(3)
  
  mut b: Set[Int] = Set::new()
  b.insert(2)
  b.insert(3)
  b.insert(4)
  
  let c = a.intersection(&b)
  assert_eq(c.len(), 2)
  assert_true(c.contains(&2))
  assert_true(c.contains(&3))
end

# ———————————————————————————————————————————————————————————————
# Formatting Tests
# ———————————————————————————————————————————————————————————————

@test
def test_int_to_string() -> Unit
  assert_eq(42.to_string(), "42")
  assert_eq(0.to_string(), "0")
  assert_eq((-1).to_string(), "-1")
end

@test
def test_bool_to_string() -> Unit
  assert_eq(true.to_string(), "true")
  assert_eq(false.to_string(), "false")
end

@test
def test_float_to_string() -> Unit
  assert_eq(3.14.to_string(), "3.14")
end

# ———————————————————————————————————————————————————————————————
# Pattern Matching Tests
# ———————————————————————————————————————————————————————————————

enum Shape
  Circle(radius: Float)
  Rectangle(w: Float, h: Float)
  Triangle(a: Float, b: Float, c: Float)
end

@test
def test_enum_matching() -> Unit
  let s = Shape::Circle(5.0)
  let area = match s
  when Shape::Circle(r) then 3.14159 * r * r
  when Shape::Rectangle(w, h) then w * h
  when Shape::Triangle(a, b, c) then
    let s = (a + b + c) / 2.0
    (s * (s - a) * (s - b) * (s - c)).sqrt()
  end
  assert_approx_eq(area, 78.53975, 0.001)
end

@test
def test_nested_match() -> Unit
  let x: Option[Result[Int, String]] = Option::Some(Result::Ok(42))
  let val = match x
  when Option::Some(Result::Ok(v)) then v
  when Option::Some(Result::Err(_)) then -1
  when Option::None then 0
  end
  assert_eq(val, 42)
end

# ———————————————————————————————————————————————————————————————
# Ownership & Borrowing Tests
# ———————————————————————————————————————————————————————————————

@test
def test_move_semantics() -> Unit
  let v = vec![1, 2, 3]
  let v2 = v  # Move
  assert_eq(v2.len(), 3)
  # v is no longer usable here (moved)
end

@test
def test_shared_borrow() -> Unit
  let v = vec![1, 2, 3]
  let r1 = &v
  let r2 = &v  # Multiple shared borrows OK
  assert_eq(r1.len(), 3)
  assert_eq(r2.len(), 3)
end

@test
def test_mutable_borrow() -> Unit
  mut v = vec![1, 2, 3]
  let r = &mut v
  r.push(4)
  assert_eq(r.len(), 4)
end

# ———————————————————————————————————————————————————————————————
# Closure Tests
# ———————————————————————————————————————————————————————————————

@test
def test_closure_capture() -> Unit
  let x = 10
  let add_x = |y| x + y
  assert_eq(add_x(5), 15)
  assert_eq(add_x(20), 30)
end

@test
def test_closure_as_argument() -> Unit
  let nums = vec![1, 2, 3, 4, 5]
  let sum = nums.iter().fold(0, |acc, x| acc + x)
  assert_eq(sum, 15)
end

@test
def test_higher_order_functions() -> Unit
  def apply(f: fn(Int) -> Int, x: Int) -> Int
    f(x)
  end
  
  let double = |x| x * 2
  let square = |x| x * x
  
  assert_eq(apply(double, 5), 10)
  assert_eq(apply(square, 5), 25)
end

# ———————————————————————————————————————————————————————————————
# Struct & Trait Tests
# ———————————————————————————————————————————————————————————————

struct Point
  x: Int
  y: Int
end

trait Describable
  def describe(self) -> String
end

impl Describable for Point
  def describe(self) -> String
    "Point(" + self.x.to_string() + ", " + self.y.to_string() + ")"
  end
end

@test
def test_struct_creation() -> Unit
  let p = Point { x: 3, y: 4 }
  assert_eq(p.x, 3)
  assert_eq(p.y, 4)
end

@test
def test_trait_dispatch() -> Unit
  let p = Point { x: 1, y: 2 }
  assert_eq(p.describe(), "Point(1, 2)")
end

# ———————————————————————————————————————————————————————————————
# Error Handling Tests
# ———————————————————————————————————————————————————————————————

def divide(a: Int, b: Int) -> Result[Int, String]
  if b == 0 then
    Result::Err("division by zero".to_string())
  else
    Result::Ok(a / b)
  end
end

@test
def test_result_propagation() -> Unit
  def chain_divide() -> Result[Int, String]
    let x = divide(100, 5)?
    let y = divide(x, 4)?
    Result::Ok(y)
  end
  
  assert_eq(chain_divide().unwrap(), 5)
end

@test
def test_result_error_propagation() -> Unit
  def will_fail() -> Result[Int, String]
    let x = divide(10, 0)?
    Result::Ok(x)  # Never reached
  end
  
  assert_true(will_fail().is_err())
end

# ———————————————————————————————————————————————————————————————
# Loop & Control Flow Tests
# ———————————————————————————————————————————————————————————————

@test
def test_while_loop() -> Unit
  mut sum = 0
  mut i = 1
  while i <= 10 do
    sum = sum + i
    i = i + 1
  end
  assert_eq(sum, 55)
end

@test
def test_for_range() -> Unit
  mut sum = 0
  for i in 0..5 do
    sum = sum + i
  end
  assert_eq(sum, 10)  # 0+1+2+3+4
end

@test
def test_break_in_loop() -> Unit
  mut count = 0
  mut i = 0
  while true do
    if i >= 5 then break end
    count = count + 1
    i = i + 1
  end
  assert_eq(count, 5)
end

@test
def test_next_in_loop() -> Unit
  mut sum = 0
  for i in 0..10 do
    if i % 2 != 0 then next end
    sum = sum + i
  end
  assert_eq(sum, 20)  # 0+2+4+6+8
end

@test
def test_early_return() -> Unit
  def find_first_negative(nums: &Vec[Int]) -> Option[Int]
    for n in nums do
      if *n < 0 then
        return Option::Some(*n)
      end
    end
    Option::None
  end
  
  let nums = vec![1, 2, -3, 4, -5]
  assert_eq(find_first_negative(&nums), Option::Some(-3))
  
  let positive = vec![1, 2, 3]
  assert_true(find_first_negative(&positive).is_none())
end

# ———————————————————————————————————————————————————————————————
# Generic Function Tests
# ———————————————————————————————————————————————————————————————

def identity[T](x: T) -> T
  x
end

def max_of[T: Ord](a: T, b: T) -> T
  if a >= b then a else b end
end

@test
def test_generic_identity() -> Unit
  assert_eq(identity(42), 42)
  assert_eq(identity("hello"), "hello")
  assert_eq(identity(true), true)
end

@test
def test_generic_max() -> Unit
  assert_eq(max_of(3, 7), 7)
  assert_eq(max_of(10, 2), 10)
end

# ———————————————————————————————————————————————————————————————
# Recursion Tests
# ———————————————————————————————————————————————————————————————

@test
def test_fibonacci() -> Unit
  def fib(n: Int) -> Int
    if n <= 1 then n
    else fib(n - 1) + fib(n - 2)
    end
  end
  
  assert_eq(fib(0), 0)
  assert_eq(fib(1), 1)
  assert_eq(fib(10), 55)
end

@test
def test_mutual_recursion() -> Unit
  def is_even(n: Int) -> Bool
    if n == 0 then true else is_odd(n - 1) end
  end
  
  def is_odd(n: Int) -> Bool
    if n == 0 then false else is_even(n - 1) end
  end
  
  assert_true(is_even(10))
  assert_true(is_odd(7))
  assert_false(is_even(3))
end
