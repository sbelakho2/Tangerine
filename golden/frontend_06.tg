## Golden test: frontend milestones 6-10 — advanced features
# Tests: use, module, generics, where clause, pattern matching

module math
  def abs(x: Int) -> Int
    if x < 0
      0 - x
    else
      x
    end
  end

  def max(a: Int, b: Int) -> Int
    if a > b
      a
    else
      b
    end
  end
end

enum Result[T, E]
  Ok(T)
  Err(E)
end

def unwrap_or(r: Result[Int, String], default: Int) -> Int
  match r
  when Ok(v) then
    v
  when Err(e) then
    default
  end
end

# Additional: use statement with aliasing
use std::collections::Map as HashMap

def use_alias() -> Int
  let m = HashMap::new()
  m.len()
end

# Additional: where clause on generic function
def stringify[T](value: T) -> String where T: Display
  value.to_string()
end

# Additional: where clause with multiple bounds
def compare_and_display[T](a: T, b: T) -> String where T: Ord + Display
  if a < b then
    a.to_string()
  else
    b.to_string()
  end
end

# Additional: nested pattern matching on enums
enum Tree[T]
  Leaf(T)
  Node(Tree[T], T, Tree[T])
end

def tree_sum(tree: Tree[Int]) -> Int
  match tree
  when Tree::Leaf(v) then v
  when Tree::Node(left, v, right) then
    tree_sum(left) + v + tree_sum(right)
  end
end

# Additional: module with pub visibility
module string_utils
  pub def repeat(s: String, n: Int) -> String
    mut result = ""
    for _ in 0..n do
      result = result + s
    end
    result
  end

  def internal_helper() -> Bool
    true
  end
end

# Additional: generic struct with where clause
struct Container[T] where T: Clone
  value: T
  count: Int
end

impl[T] Container[T] where T: Clone
  def replicate(&self) -> Array[T]
    mut result = Array::new()
    for _ in 0..self.count do
      result.push(self.value.clone())
    end
    result
  end
end
