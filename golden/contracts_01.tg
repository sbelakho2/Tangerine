## Golden test: Formal contracts (pre/post/invariant)
## Tests parsing of contract clauses on functions.

def abs(x: Int) -> Int
  pre x > -2147483648
  post result >= 0
  if x < 0
    0 - x
  else
    x
  end
end

def divide(a: Int, b: Int) -> Int
  pre b != 0, "divisor must not be zero"
  post result * b <= a
  a / b
end

def clamp(val: Int, lo: Int, hi: Int) -> Int
  pre lo <= hi, "lo must be <= hi"
  post result >= lo
  post result <= hi
  if val < lo
    lo
  else
    if val > hi
      hi
    else
      val
    end
  end
end

def main() -> Int
  let a = abs(0 - 42)
  let b = divide(10, 3)
  let c = clamp(100, 0, 50)
  a + b + c
end
