## Golden test: SSA — optimization candidates
## Directives: # expect: ssa_contains "pattern" asserts SSA output includes pattern

# expect: ssa_contains "const 5"
# expect: ssa_contains "const 20"
def constant_fold() -> Int
  let x: Int = 2 + 3
  let y: Int = x * 4
  y
end

# expect: ssa_not_contains "use b"
def dead_code() -> Int
  let a: Int = 10
  let b: Int = 20
  a
end

# expect: ssa_contains "phi"
# expect: ssa_contains "loop_header"
def simple_loop(n: Int) -> Int
  mut sum: Int = 0
  mut i: Int = 0
  while i < n
    sum = sum + i
    i = i + 1
  end
  sum
end

# ——— Additional SSA / phi node insertion coverage ———

# Test: diamond CFG — phi node at join point
# expect: ssa_contains "phi"
# expect: ssa_contains "branch_if"
def diamond_phi(cond: Bool) -> Int
  let mut result: Int = 0
  if cond then
    result = 1
  else
    result = 2
  end
  result
end

# Test: nested diamonds — phi at multiple join points
# expect: ssa_contains "phi"
def nested_diamond_phi(a: Bool, b: Bool) -> Int
  let mut x: Int = 0
  if a then
    if b then
      x = 10
    else
      x = 20
    end
  else
    x = 30
  end
  x
end

# Test: loop with conditional update — phi at loop header
# expect: ssa_contains "phi"
def loop_conditional_phi(n: Int) -> Int
  let mut sum: Int = 0
  let mut i: Int = 0
  while i < n do
    if i % 2 == 0 then
      sum = sum + i
    end
    i = i + 1
  end
  sum
end

# Test: multiple variables needing phi at the same join point
# expect: ssa_contains "phi"
def multi_var_phi(cond: Bool) -> Int
  let mut a: Int = 0
  let mut b: Int = 0
  let mut c: Int = 0
  if cond then
    a = 1
    b = 2
    c = 3
  else
    a = 4
    b = 5
    c = 6
  end
  a + b + c
end

# Test: phi with many predecessors (match/when)
# expect: ssa_contains "phi"
# expect: ssa_contains "switch"
def multi_arm_phi(x: Int) -> String
  let mut label: String = ""
  match x
  when 0 then label = "zero"
  when 1 then label = "one"
  when 2 then label = "two"
  when 3 then label = "three"
  when _ then label = "other"
  end
  label
end

# Test: chain of loops — phi at each loop header
# expect: ssa_contains "phi"
# expect: ssa_contains "back_edge"
def chained_loops(n: Int) -> Int
  let mut sum: Int = 0
  let mut i: Int = 0
  while i < n do
    sum = sum + i
    i = i + 1
  end
  let mut j: Int = 0
  while j < n do
    sum = sum * 2
    j = j + 1
  end
  sum
end

# Test: variable assigned only in one branch (partial assignment)
def partial_assign_phi(flag: Bool) -> Int
  let mut val: Int = 100
  if flag then
    val = 200
  end
  val
end

# Test: nested loop with multiple phi sites
def nested_loop_phi(n: Int, m: Int) -> Int
  let mut result: Int = 0
  let mut i: Int = 0
  while i < n do
    let mut j: Int = 0
    while j < m do
      result = result + i * m + j
      j = j + 1
    end
    i = i + 1
  end
  result
end

# Test: zero-trip loop — phi must handle case where loop never executes
# expect: ssa_contains "phi"
def zero_trip_loop_phi(n: Int) -> Int
  let mut x: Int = 42
  let mut i: Int = 0
  while i < n do
    x = x + 1
    i = i + 1
  end
  x
end

# Test: deeply nested if-else chain
# expect: ssa_contains "phi"
# expect: ssa_contains "branch_if"
def deep_nesting_phi(a: Bool, b: Bool, c: Bool) -> Int
  let mut v: Int = 0
  if a then
    if b then
      if c then
        v = 1
      else
        v = 2
      end
    else
      v = 3
    end
  else
    v = 4
  end
  v
end
