# Golden test: SSA — optimization candidates

def constant_fold() -> Int
  let x: Int = 2 + 3
  let y: Int = x * 4
  y
end

def dead_code() -> Int
  let a: Int = 10
  let b: Int = 20
  a
end

def simple_loop(n: Int) -> Int
  mut sum: Int = 0
  mut i: Int = 0
  while i < n
    sum = sum + i
    i = i + 1
  end
  sum
end
