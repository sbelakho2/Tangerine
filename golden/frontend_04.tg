## Golden test: frontend milestone 4 — control flow
# Tests: if/elsif/else, while, for..in, match/when

def classify(x: Int) -> String
  if x > 100
    "large"
  elsif x > 10
    "medium"
  else
    "small"
  end
end

def sum_to(n: Int) -> Int
  mut total: Int = 0
  mut i: Int = 0
  while i < n
    i = i + 1
    total = total + i
  end
  total
end

def describe(x: Int) -> String
  match x
  when 0 then
    "zero"
  when 1 then
    "one"
  when n then
    "other"
  end
end

# Additional: for-in loop with range
def sum_range(start: Int, stop: Int) -> Int
  mut total: Int = 0
  for i in start..stop do
    total = total + i
  end
  total
end

# Additional: for-in loop with array
def count_positive(items: Array[Int]) -> Int
  mut count: Int = 0
  for item in items do
    if item > 0 then
      count = count + 1
    end
  end
  count
end

# Additional: nested control flow
def fizzbuzz(n: Int) -> String
  if n % 15 == 0 then
    "fizzbuzz"
  elsif n % 3 == 0 then
    "fizz"
  elsif n % 5 == 0 then
    "buzz"
  else
    n.to_string()
  end
end

# Additional: early return in loop
def find_first_negative(items: Array[Int]) -> Option[Int]
  for item in items do
    if item < 0 then
      return Option::Some(item)
    end
  end
  Option::None
end
