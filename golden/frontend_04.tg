# Golden test: frontend milestone 4 — control flow
# Tests: if/elsif/else, while, for..in, match/when

def classify(x: Int) -> String
  if x > 100
    "large"
  elsif x > 10
    "medium"
  else
    "small"
  end
end

def sum_to(n: Int) -> Int
  mut total: Int = 0
  mut i: Int = 0
  while i < n
    i = i + 1
    total = total + i
  end
  total
end

def describe(x: Int) -> String
  match x
  when 0 then
    "zero"
  when 1 then
    "one"
  when n then
    "other"
  end
end
