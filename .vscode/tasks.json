{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tangerine: Bootstrap Full",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--release", "--manifest-path", "stage0_rs/Cargo.toml"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tangerine"]
    },
    {
      "label": "Tangerine: Strict Check Compiler",
      "type": "shell",
      "command": "./stage0_rs/target/release/stage0_rs",
      "args": ["scan", "tg_compiler"],
      "problemMatcher": ["$tangerine"]
    },
    {
      "label": "Tangerine: Parse Golden Suite",
      "type": "shell",
      "command": "for f in golden/*.tg; do ./stage0_rs/target/release/stage0_rs parse \"$f\" || exit 1; done",
      "problemMatcher": ["$tangerine"]
    }
  ]
}
