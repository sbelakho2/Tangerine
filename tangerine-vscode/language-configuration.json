{
  "comments": {
    "lineComment": "#",
    "blockComment": ["#|", "|#"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["do", "end"]
  ],
  "autoClosingPairs": [
    {"open": "{", "close": "}"},
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "\"", "close": "\""},
    {"open": "'", "close": "'"},
    {"open": "#|", "close": "|#"}
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["#|", "|#"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(def|struct|enum|trait|impl|module|if|while|for|match|do|unsafe|loop|try)\\b",
      "end": "^\\s*end\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(def|struct|enum|trait|impl|module|if|elsif|else|while|for|match|when|do|unsafe|loop|try|catch|finally)\\b.*$",
    "decreaseIndentPattern": "^\\s*(end|else|elsif|when|catch|finally)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(def|struct|enum|trait|impl|module|if|elsif|else|while|for|match|when|do|unsafe|loop|try|catch|finally)\\b.*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*#.*$",
      "action": {
        "indent": "none",
        "appendText": "# "
      }
    }
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*[!?]?"
}
