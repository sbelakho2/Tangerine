{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tangerine",
  "scopeName": "source.tangerine",
  "patterns": [
    {"include": "#attributes"},
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#chars"},
    {"include": "#numbers"},
    {"include": "#block-closure"},
    {"include": "#closure-params"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#functions"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tangerine",
          "begin": "#\\|",
          "end": "\\|#"
        },
        {
          "name": "comment.line.number-sign.tangerine",
          "begin": "#(?!\\[)",
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tangerine",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {"name": "constant.character.escape.tangerine", "match": "\\\\."}
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.tangerine",
          "match": "'(?:\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tangerine",
          "match": "\\b(?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0b[01](?:_?[01])*|0o[0-7](?:_?[0-7])*|\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d(?:_?\\d)*)?)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.tangerine",
          "match": "#\\[[^\\]]+\\]|@[A-Za-z_][A-Za-z0-9_]*(?:\\([^\\)]*\\))?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tangerine",
          "match": "\\b(def|end|if|unless|then|else|elsif|match|when|while|until|for|in|do|break|next|return|async|await|handle|with|loop|guard|try|catch|finally|let|mut|move|self|Self|where|as)\\b"
        },
        {
          "name": "keyword.declaration.tangerine",
          "match": "\\b(struct|enum|trait|impl|use|module|extern|unsafe|cap|effect|rationale|requires|budget|pre|post|invariant|const|static|type|pub|comptime|macro|pure|inline|edition)\\b"
        },
        {
          "name": "constant.language.tangerine",
          "match": "\\b(true|false|None|Some|Ok|Err)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.tangerine",
          "match": "\\b(Int|UInt|Float|Bool|String|Char|Unit|Array|Vec|Map|Set|Option|Result|Box|Rc|Arc|Future)\\b"
        },
        {
          "name": "entity.name.type.tangerine",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.tangerine",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    },
    "block-closure": {
      "patterns": [
        {
          "name": "meta.block-closure.tangerine",
          "match": "(\\|)([a-zA-Z_][A-Za-z0-9_:&\\s,]*)(\\|)\\s+\\bdo\\b",
          "captures": {
            "1": { "name": "punctuation.definition.parameters.begin.tangerine" },
            "2": { "name": "variable.parameter.tangerine" },
            "3": { "name": "punctuation.definition.parameters.end.tangerine" }
          }
        }
      ]
    },
    "closure-params": {
      "patterns": [
        {
          "name": "meta.closure.tangerine",
          "match": "(\\|)([a-zA-Z_][A-Za-z0-9_:&\\s,]*)(\\|)",
          "captures": {
            "1": { "name": "punctuation.definition.parameters.begin.tangerine" },
            "2": { "name": "variable.parameter.tangerine" },
            "3": { "name": "punctuation.definition.parameters.end.tangerine" }
          }
        }
      ]
    }
  }
}
