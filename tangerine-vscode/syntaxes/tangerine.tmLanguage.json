{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tangerine",
  "scopeName": "source.tangerine",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#functions"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tangerine",
          "begin": "#\\|",
          "end": "\\|#"
        },
        {
          "name": "comment.line.number-sign.tangerine",
          "begin": "#",
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tangerine",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {"name": "constant.character.escape.tangerine", "match": "\\\\."}
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tangerine",
          "match": "\\b(0x[0-9A-Fa-f]+|0b[01]+|\\d+)(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tangerine",
          "match": "\\b(def|end|if|then|else|elsif|match|when|while|for|in|do|break|next|return|async|await|handle|with|loop|guard|try|catch|finally)\\b"
        },
        {
          "name": "keyword.declaration.tangerine",
          "match": "\\b(struct|enum|trait|impl|use|module|extern|unsafe|cap|effect|rationale|requires|budget|pre|post|invariant|const|static|type|pub|comptime|macro|pure|inline)\\b"
        },
        {
          "name": "constant.language.tangerine",
          "match": "\\b(true|false|nil|None|Some|Ok|Err)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.tangerine",
          "match": "\\b(Int|UInt|Float|Bool|String|Char|Unit|Array|Vec|Map|Set|Option|Result|Box|Rc|Arc|Future)\\b"
        },
        {
          "name": "entity.name.type.tangerine",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.tangerine",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    }
  }
}
