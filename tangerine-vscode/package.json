{
  "name": "tangerine-language",
  "displayName": "Tangerine Language",
  "description": "Syntax highlighting for the Tangerine language",
  "version": "0.0.1",
  "publisher": "tangerine",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "tangerine",
        "aliases": ["Tangerine", "tangerine"],
        "extensions": [".tg"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tangerine",
        "scopeName": "source.tangerine",
        "path": "./syntaxes/tangerine.tmLanguage.json"
      }
    ]
  }
}
