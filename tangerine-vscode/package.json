{
  "name": "tangerine-language",
  "displayName": "Tangerine Language",
  "description": "Full language support for Tangerine: syntax highlighting, diagnostics, completion, go-to-definition, and more",
  "version": "0.2.7",
  "publisher": "tangerine",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangerine-lang/tangerine"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "tangerine",
    "tg",
    "language",
    "programming",
    "systems"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.tg",
    "workspaceContains:Tangerine.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tangerine",
        "aliases": [
          "Tangerine",
          "tangerine"
        ],
        "extensions": [
          ".tg"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "tangerine",
        "scopeName": "source.tangerine",
        "path": "./syntaxes/tangerine.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tangerine",
        "path": "./snippets/tangerine.code-snippets"
      }
    ],
    "iconThemes": [
      {
        "id": "tangerine",
        "label": "Tangerine",
        "path": "./tangerine-icon-theme.json"
      }
    ],
    "configuration": {
      "title": "Tangerine",
      "properties": {
        "tangerine.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Tangerine compiler executable (tg). Leave empty to auto-detect."
        },
        "tangerine.mode": {
          "type": "string",
          "enum": [
            "Dev",
            "Strict",
            "Production",
            "Hardened"
          ],
          "default": "Dev",
          "description": "Compilation mode for diagnostics"
        },
        "tangerine.edition": {
          "type": "string",
          "enum": [
            "2026",
            "2027"
          ],
          "default": "2026",
          "description": "Language edition to use"
        },
        "tangerine.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run full type checking when saving files"
        },
        "tangerine.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Format files when saving"
        },
        "tangerine.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time diagnostics"
        },
        "tangerine.diagnostics.level": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info",
            "hint"
          ],
          "default": "warning",
          "description": "Minimum severity level to show"
        },
        "tangerine.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints"
        },
        "tangerine.inlayHints.typeHints": {
          "type": "boolean",
          "default": true,
          "description": "Show type hints for variables"
        },
        "tangerine.inlayHints.parameterHints": {
          "type": "boolean",
          "default": true,
          "description": "Show parameter name hints in function calls"
        }
      }
    },
    "commands": [
      {
        "command": "tangerine.restartServer",
        "title": "Restart Language Server",
        "category": "Tangerine"
      },
      {
        "command": "tangerine.showVersion",
        "title": "Show Version",
        "category": "Tangerine"
      },
      {
        "command": "tangerine.runFile",
        "title": "Run Current File",
        "category": "Tangerine",
        "icon": "$(play)"
      },
      {
        "command": "tangerine.checkFile",
        "title": "Check Current File",
        "category": "Tangerine",
        "icon": "$(check)"
      },
      {
        "command": "tangerine.formatFile",
        "title": "Format Current File",
        "category": "Tangerine"
      },
      {
        "command": "tangerine.runTests",
        "title": "Run Tests",
        "category": "Tangerine",
        "icon": "$(beaker)"
      },
      {
        "command": "tangerine.build",
        "title": "Build Project",
        "category": "Tangerine",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "tangerine.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == tangerine"
      },
      {
        "command": "tangerine.checkFile",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorLangId == tangerine"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tangerine.runFile",
          "when": "editorLangId == tangerine",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "tangerine.runFile",
          "when": "editorLangId == tangerine",
          "group": "tangerine"
        },
        {
          "command": "tangerine.checkFile",
          "when": "editorLangId == tangerine",
          "group": "tangerine"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "tangerine",
        "owner": "tangerine",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning|info|hint):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "tangerine",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "build",
              "check",
              "test",
              "run",
              "fmt"
            ],
            "description": "The Tangerine task to execute"
          },
          "file": {
            "type": "string",
            "description": "Optional file to operate on"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext ts",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3"
  }
}
