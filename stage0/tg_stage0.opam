# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Tangerine Stage0 Bootstrap Compiler"
description:
  "Bootstrap compiler for Tangerine, written in OCaml. Used to compile the self-hosting Tangerine compiler."
maintainer: ["team@tangerine-lang.org"]
authors: ["Tangerine Team"]
license: "MIT"
homepage: "https://github.com/tangerine-lang/tangerine"
bug-reports: "https://github.com/tangerine-lang/tangerine/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "menhir"
  "yojson"
  "cmdliner"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tangerine-lang/tangerine.git"
