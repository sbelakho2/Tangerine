opam-version: "2.0"
name: "tangerine"
version: "0.1.0"
synopsis: "Stage 0 bootstrap compiler for the Tangerine programming language"
description: """
A minimal OCaml implementation of the Tangerine compiler used to bootstrap
the self-hosted compiler.
"""
maintainer: ["tangerine@example.com"]
authors: ["Tangerine Team"]
license: "MIT"
homepage: "https://github.com/tangerine-lang/tangerine"
bug-reports: "https://github.com/tangerine-lang/tangerine/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "menhir" {>= "20220210"}
  "ppx_deriving" {>= "5.0"}
  "cmdliner" {>= "1.1"}
  "fmt" {>= "0.9"}
  "logs" {>= "0.7"}
  "alcotest" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
