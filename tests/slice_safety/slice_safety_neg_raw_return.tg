# tests/slice_safety/slice_safety_neg_raw_return.tg
# Negative (P0-SL, kept): the RAW {ptr,len} view (UnsafeSlice[T] — the
# compiler's UnsafeSlice builtin) must not be RETURNED from a function. The
# channel-(a) check (check_no_escaping_slice) rejects the declared return
# type at every callable declaration. The SAFE shared/pinned form
# (the source-spelled Slice / StrView) passes freely — this rejection is
# the RAW view's rule only.
#
# Expected error: "the raw Slice view (UnsafeSlice[T]) cannot be returned
# from a function"

use std::core

def raw_return_escape() -> UnsafeSlice[Char]
  let s = "abc".to_string()
  s.chars()
end

def main() -> Int
  0
end
