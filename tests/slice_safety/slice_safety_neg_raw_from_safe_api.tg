# tests/slice_safety/slice_safety_neg_raw_from_safe_api.tg
# Negative (NEW canary): the RAW view from a safe API is IMPOSSIBLE.
# The safe APIs return the SHARED/pinned forms — Vec::as_slice returns
# the source-spelled Slice[T] (the shared form), String::as_str_view
# returns the shared StrView — so a
# raw UnsafeSlice[T] annotation over a safe API result is a TYPE
# MISMATCH, and the opaque builtin has no constructor for a struct
# literal (safe code cannot produce a raw {ptr,len} view at all).
#
# Expected error: type mismatch / cannot construct

use std::core
use std::collections

def raw_from_safe_api_impossible() -> Int
  var v: Vec[Int] = Vec::new()
  v.push(1)
  # as_slice returns the SHARED/pinned form — typing it as the raw view
  # is rejected (the safe API can never hand out a raw {ptr,len} view).
  let raw: UnsafeSlice[Int] = v.as_slice()
  0
end

def raw_construct_impossible() -> Int
  # The opaque raw-view builtin cannot be constructed in safe code.
  let raw = UnsafeSlice { ptr: Ptr::null(), len: 0 }
  0
end

def main() -> Int
  raw_from_safe_api_impossible()
end
