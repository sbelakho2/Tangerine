# tests/slice_safety/slice_safety_neg_raw_backing_mutation.tg
# Negative (P0-SL, kept): the RAW {ptr,len} view's BACKING cannot be
# mutated/reallocated while a raw-view local is live (channel d — the
# resource checker's live-view registry + the IterationPlan mutation
# scan, check_slice_view_backing_mutation). The let-bound raw view is
# registered under its backing place; the statement that mutates the
# backing is rejected. (The SAFE shared/pinned form is never registered —
# the pinned backing is unaffected by the owner's mutations.)
#
# Expected error: "cannot mutate the backing buffer of `s`: the local
# holds a live raw Slice view (UnsafeSlice)"

use std::core
use std::collections

def raw_backing_mutation() -> Int
  var v: Vec[Int] = Vec::new()
  v.push(1)
  let s = v.iter()
  v.push(2)
  0
end

def main() -> Int
  raw_backing_mutation()
end
