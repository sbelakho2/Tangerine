# tests/slice_safety/slice_safety_neg_raw_const_static.tg
# Negative (P0-SL, kept): the RAW {ptr,len} view must not live in
# program-lifetime state — consts and statics (channel b). The declared
# type is (or contains) the raw view, so the declaration is rejected
# regardless of the initializer. The SAFE shared/pinned forms are
# ordinary owning values and pass freely.
#
# Expected error: "the raw Slice view (UnsafeSlice[T]) cannot be stored
# in a const" / "stored in a static"

use std::core

const RAW_VIEW_CONST: Slice[Int] = empty_raw_view()
static RAW_VIEW_STATIC: Slice[Int] = empty_raw_view()

# An empty raw view via the compiler's loop-consumed form (chars on an
# empty String) — the const/static channels reject the declarations
# above before this initializer is even accepted.
def empty_raw_view() -> Slice[Char]
  let s = String::new()
  s.chars()
end

def main() -> Int
  0
end
