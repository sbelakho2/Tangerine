# tests/slice_safety/slice_safety_pos_view_across_realloc.tg
# Positive: the SAFE Slice (the shared/pinned form) is used across the
# owner's CAPACITY-CHANGING mutation. The backing is the separate pinned
# allocation — the mutation allocates a fresh pinned backing for the new
# buffer, and the views keep the old one alive: the pinned backing is
# unaffected, so the view stays valid and still reads its pinned window.
#
# Also positive: the owner's in-place growth while a shared view exists
# is ALLOWED (the shared forms need no escape tracking — the registry
# only polices the RAW views).
#
# Failure class: SAFE_VIEW_MODEL (P0 — the reviewer's safe-view closure)

use std::core
use std::collections

def view_across_realloc() -> Int
  var v: Vec[Int] = Vec::new()
  v.push(1)
  v.push(2)
  v.push(3)
  let s = v.as_slice()
  if s.len() != 3 then
    return 1
  end
  # Capacity-changing mutations of the owner while the shared view is
  # live: allowed (the pinned backing is a separate allocation).
  var i = 0
  while i < 200 do
    v.push(1000 + i)
    i = i + 1
  end
  if v.len() != 203 then
    return 1
  end
  # The pinned backing is unaffected by the reallocations.
  if s.len() != 3 then
    return 1
  end
  if s.get(0) != 1 || s.get(2) != 3 then
    return 1
  end
  # The sub-view re-pins its own window (a fresh pinned backing).
  let sub = s.sub(1, 2)
  if sub.len() != 2 then
    return 1
  end
  if sub.get(0) != 2 then
    return 1
  end
  drop(v)
  if sub.get(1) != 3 then
    return 1
  end
  0
end

def main() -> Int
  view_across_realloc()
end
