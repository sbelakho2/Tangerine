# tests/slice_safety/slice_safety_pos_shared_escapes.tg
# Positive: the SAFE shared/pinned views ESCAPE FREELY — they are
# ordinary OWNING values (the Arc keeps the pinned backing alive), so
# the checker allows them to be stored in struct fields, returned from
# functions, and captured. The P0-SL escape machinery (the raw-view
# return/store/capture channels in types.tg + the live-view registry in
# resource_check.tg) polices ONLY the RAW {ptr,len} views (UnsafeSlice).
#
# Failure class: SAFE_VIEW_MODEL (P0 — the reviewer's safe-view closure)

use std::core
use std::collections

struct ViewHolder
  view: SharedSlice[Int]
end

def make_holder() -> ViewHolder
  var v: Vec[Int] = Vec::new()
  v.push(7)
  v.push(8)
  # The shared view is stored into the struct field and RETURNED — the
  # owner `v` dies here; the pinned backing keeps the view valid.
  ViewHolder { view: v.as_slice() }
end

def shared_view_stored_and_returned() -> Int
  let h = make_holder()
  if h.view.len() != 2 then
    return 1
  end
  if h.view.get(0) != 7 || h.view.get(1) != 8 then
    return 1
  end
  0
end

def shared_view_in_closure() -> Int
  var v: Vec[Int] = Vec::new()
  v.push(5)
  let s = v.as_slice()
  # The shared view is captured into a closure (escaping) — allowed.
  let f = || { s.len() }
  if f() != 1 then
    return 1
  end
  0
end

def main() -> Int
  if shared_view_stored_and_returned() != 0 then
    return 1
  end
  if shared_view_in_closure() != 0 then
    return 2
  end
  0
end
