# tests/slice_safety/slice_safety_pos_view_after_owner_drop.tg
# Positive: the SOURCE-spelled Slice[Int] — the SAFE Slice (the
# shared/pinned form — Slice[T] {
# inner: Arc[SliceBacking[T]] }, the Arc-class {ptr,len}) is used AFTER
# the original owner's drop. The Arc keeps the pinned backing alive — the
# view survives the owner's drop (no lifetime inference; the backing owns).
#
# The safe API (Vec::as_slice) returns the SHARED form (the source-spelled
# Slice — NOT the SharedSlice spelling); the pinned
# backing holds a snapshot of the window, so the view can never dangle.
#
# Failure class: SAFE_VIEW_MODEL (P0 — the reviewer's safe-view closure)

use std::core
use std::collections

def view_after_owner_drop() -> Int
  var v: Vec[Int] = Vec::new()
  v.push(10)
  v.push(20)
  v.push(30)
  # The ordinary language spelling: Slice[Int] IS the shared/pinned form.
  let s: Slice[Int] = v.as_slice()
  drop(v)
  if s.len() != 3 then
    return 1
  end
  if s.get(0) != 10 then
    return 1
  end
  if s.get(2) != 30 then
    return 1
  end
  match s.first()
  when Option::Some(x) then if x != 10 then return 1 end
  when Option::None then return 1
  end
  match s.last()
  when Option::Some(x) then if x != 30 then return 1 end
  when Option::None then return 1
  end
  0
end

def main() -> Int
  view_after_owner_drop()
end
