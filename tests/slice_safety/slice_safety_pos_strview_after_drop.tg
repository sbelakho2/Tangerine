# tests/slice_safety/slice_safety_pos_strview_after_drop.tg
# Positive: the SAFE StrView (the shared/pinned form — StrView {
# inner: Arc[StrViewBacking] }, the pinned byte backing + the offset/len)
# is used AFTER its source String's drop. The Arc keeps the pinned byte
# backing alive — the view survives the source's drop and its growth.
#
# The safe API (String::as_str_view) returns the SHARED form; the pin
# copies the bytes into the pinned allocation, so the view never dangles.
#
# Failure class: SAFE_VIEW_MODEL (P0 — the reviewer's safe-view closure)

use std::core
use std::collections

def strview_after_owner_drop() -> Int
  var s = String::new()
  s.push('h')
  s.push('i')
  let sv = s.as_str_view()
  if sv.len() != 2 then
    return 1
  end
  drop(s)
  # The view survives the String's drop (the pinned byte backing).
  let cloned = String::from_str_view(&sv)
  if cloned.len() != 2 then
    return 1
  end
  let sub = sv.sub(1, 1)
  let sub_cloned = String::from_str_view(&sub)
  if sub_cloned != "i" then
    return 1
  end
  0
end

def main() -> Int
  strview_after_owner_drop()
end
