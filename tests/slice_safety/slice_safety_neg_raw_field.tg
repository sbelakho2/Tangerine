# tests/slice_safety/slice_safety_neg_raw_field.tg
# Negative (P0-SL, kept): the RAW {ptr,len} view (UnsafeSlice[T]) must
# not be stored into longer-lived state — a struct field holding the raw
# view is longer-lived state holding a view (channel b,
# check_no_escaping_slice). The SAFE shared/pinned form (the
# source-spelled Slice)
# is an ordinary owning value and passes freely.
#
# Expected error: "the raw Slice view (UnsafeSlice[T]) cannot be stored
# in a struct field"

use std::core

struct RawViewHolder
  view: UnsafeSlice[Int]
end

def main() -> Int
  0
end
