# tests/pthread_abi_test.tg — the pthread opaque ABI (size AND alignment)
#
# The std::thread pthread opaques are the [u8; N] FFI forms: the byte
# count is the native SIZE, but a byte array's own alignment is 1 while
# the native C types demand the pointer alignment (Darwin's
# pthread_mutex_t { long __sig; char __opaque[56]; }, glibc's __align
# union member — both 8). The layout engine's FFI-opaque recognition
# (ffi_opaque_native_align) must report the native ALIGNMENT for the
# known pthread names so a PthreadMutexT local can never land at a
# misaligned stack offset (the C functions write through the pointer and
# a misaligned write is UB). This suite pins the sizes AND the
# alignments for both targets, plus the enclosing-aggregate propagation.

use std::test::*
use std::collections::{Vec}
use tg_compiler::layout_engine::{
  LayoutEngine, aarch64_target, x86_64_target,
  layout_engine_new, layout_engine_register_types, compute_all_layouts,
  size_of, align_of, stride_of
}
use tg_compiler::mir::{MirTypeDef, MirTypeDefKind, MirFieldDef, MirId}
use tg_compiler::types::{Type, TypeId}

# Register one byte-array struct (the opaque form) under the given name.
def register_opaque(inout engine: LayoutEngine, name: String, id: Int, bytes: Int) -> Unit
  mut fields = Vec::new()
  fields.push(MirFieldDef { name: "opaque".to_string(), ty: Type::FixedArray(Type::U8, bytes) })
  mut type_defs = Vec::new()
  type_defs.push(MirTypeDef {
    id: MirId { id: id },
    name: name,
    kind: MirTypeDefKind::Struct(fields),
    generics: Vec::new()
  })
  layout_engine_register_types(&mut engine, &type_defs)
end

# Register the full pthread table; returns the type ids by name position.
def register_pthread_table(inout engine: LayoutEngine, base_id: Int,
                           t_size: Int, attr_size: Int, mutex_size: Int,
                           cond_size: Int, barrier_size: Int) -> Unit
  register_opaque(&mut engine, "PthreadT".to_string(), base_id + 0, t_size)
  register_opaque(&mut engine, "PthreadAttrT".to_string(), base_id + 1, attr_size)
  register_opaque(&mut engine, "PthreadMutexT".to_string(), base_id + 2, mutex_size)
  register_opaque(&mut engine, "PthreadCondT".to_string(), base_id + 3, cond_size)
  register_opaque(&mut engine, "PthreadBarrierT".to_string(), base_id + 4, barrier_size)
end

def assert_opaque_abi(inout engine: LayoutEngine, name: String, id: Int, expected_size: Int) -> Unit
  let ty = Type::Adt(TypeId { id: id }, Vec::new())
  assert_eq(size_of(&mut engine, &ty), expected_size)
  # The native C alignment: pointer alignment (8) on both supported
  # targets — the FFI-opaque override.
  assert_eq(align_of(&mut engine, &ty), 8)
  # All pthread opaque sizes are multiples of 8: stride == size.
  assert_eq(stride_of(&mut engine, &ty), expected_size)
end

@test
def test_pthread_abi_aarch64_linux_sizes() -> Unit
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  register_pthread_table(&mut engine, 100, 8, 56, 40, 48, 32)
  compute_all_layouts(&mut engine)

  assert_opaque_abi(&mut engine, "PthreadT", 100, 8)
  assert_opaque_abi(&mut engine, "PthreadAttrT", 101, 56)
  assert_opaque_abi(&mut engine, "PthreadMutexT", 102, 40)
  assert_opaque_abi(&mut engine, "PthreadCondT", 103, 48)
  assert_opaque_abi(&mut engine, "PthreadBarrierT", 104, 32)
end

@test
def test_pthread_abi_aarch64_macos_sizes() -> Unit
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  register_pthread_table(&mut engine, 200, 8, 64, 64, 48, 64)
  compute_all_layouts(&mut engine)

  assert_opaque_abi(&mut engine, "PthreadT", 200, 8)
  assert_opaque_abi(&mut engine, "PthreadAttrT", 201, 64)
  assert_opaque_abi(&mut engine, "PthreadMutexT", 202, 64)
  assert_opaque_abi(&mut engine, "PthreadCondT", 203, 48)
  assert_opaque_abi(&mut engine, "PthreadBarrierT", 204, 64)
end

@test
def test_pthread_abi_x86_64_linux_sizes() -> Unit
  let target = x86_64_target()
  mut engine = layout_engine_new(target)
  register_pthread_table(&mut engine, 300, 8, 56, 40, 48, 32)
  compute_all_layouts(&mut engine)

  assert_opaque_abi(&mut engine, "PthreadT", 300, 8)
  assert_opaque_abi(&mut engine, "PthreadAttrT", 301, 56)
  assert_opaque_abi(&mut engine, "PthreadMutexT", 302, 40)
  assert_opaque_abi(&mut engine, "PthreadCondT", 303, 48)
  assert_opaque_abi(&mut engine, "PthreadBarrierT", 304, 32)
end

@test
def test_pthread_abi_x86_64_macos_sizes() -> Unit
  let target = x86_64_target()
  mut engine = layout_engine_new(target)
  register_pthread_table(&mut engine, 400, 8, 64, 64, 48, 64)
  compute_all_layouts(&mut engine)

  assert_opaque_abi(&mut engine, "PthreadT", 400, 8)
  assert_opaque_abi(&mut engine, "PthreadAttrT", 401, 64)
  assert_opaque_abi(&mut engine, "PthreadMutexT", 402, 64)
  assert_opaque_abi(&mut engine, "PthreadCondT", 403, 48)
  assert_opaque_abi(&mut engine, "PthreadBarrierT", 404, 64)
end

@test
def test_pthread_opaque_alignment_propagates_into_enclosing_struct() -> Unit
  # A struct whose only field is a PthreadMutexT must take the opaque's
  # native alignment (8), not the byte-array alignment (1): a stack local
  # of the enclosing type is then 8-aligned too, and the C function
  # writing through &mutex.m sees an aligned address.
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  register_opaque(&mut engine, "PthreadMutexT".to_string(), 500, 40)

  mut fields = Vec::new()
  fields.push(MirFieldDef { name: "m".to_string(), ty: Type::Adt(TypeId { id: 500 }, Vec::new()) })
  mut type_defs = Vec::new()
  type_defs.push(MirTypeDef {
    id: MirId { id: 501 },
    name: "MutexHolder".to_string(),
    kind: MirTypeDefKind::Struct(fields),
    generics: Vec::new()
  })
  layout_engine_register_types(&mut engine, &type_defs)
  compute_all_layouts(&mut engine)

  let holder = Type::Adt(TypeId { id: 501 }, Vec::new())
  assert_eq(size_of(&mut engine, &holder), 40)
  assert_eq(align_of(&mut engine, &holder), 8)
end

@test
def test_byte_array_struct_keeps_native_alignment() -> Unit
  # The FFI-opaque recognition is name-scoped: an ordinary byte-array
  # struct (e.g. the Md5-style { buffer: [u8; 64] } form) keeps the byte
  # alignment 1 — only the known pthread opaque names get the override.
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  register_opaque(&mut engine, "ByteBlob".to_string(), 600, 64)
  compute_all_layouts(&mut engine)

  let blob = Type::Adt(TypeId { id: 600 }, Vec::new())
  assert_eq(size_of(&mut engine, &blob), 64)
  assert_eq(align_of(&mut engine, &blob), 1)
end
