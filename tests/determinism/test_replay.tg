# tests/determinism/test_replay.tg — Determinism/replay tests §21.4
use std::test
use std::app
use std::gfx
use std::geom

# --- Record/replay event streams ---
# These tests verify that replaying the same event sequence with the same
# assets and config produces identical output.

struct RecordedFrame
  events: Vec[Event]
  pixel_hash: u64
end

def simple_hash(data: Vec[u8]) -> u64
  let h: u64 = 5381u64
  let i = 0
  while i < data.len()
    h = h * 33u64 + data[i] as u64
    i = i + 1
  end
  h
end

# --- Replay determinism test ---

test "Replay determinism: identical events produce identical frames" do
  let events = [
    Event::Resize(100, 100),
    Event::Redraw
  ]

  # Run 1
  let surface1 = gfx::create_software_surface(100, 100)
  let canvas1 = surface1.begin_frame()
  canvas1.clear(Color { r: 0.5, g: 0.5, b: 0.5, a: 1.0 })
  let paint = gfx::solid_paint(Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 })
  canvas1.fill_rect(Rect { x: 10.0, y: 10.0, w: 30.0, h: 30.0 }, paint)
  surface1.end_frame()
  let bmp1 = surface1.to_bitmap()
  let hash1 = simple_hash(bmp1.data)

  # Run 2 — exact same operations
  let surface2 = gfx::create_software_surface(100, 100)
  let canvas2 = surface2.begin_frame()
  canvas2.clear(Color { r: 0.5, g: 0.5, b: 0.5, a: 1.0 })
  let paint2 = gfx::solid_paint(Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 })
  canvas2.fill_rect(Rect { x: 10.0, y: 10.0, w: 30.0, h: 30.0 }, paint2)
  surface2.end_frame()
  let bmp2 = surface2.to_bitmap()
  let hash2 = simple_hash(bmp2.data)

  assert_eq(hash1, hash2)
end

# --- Deterministic transform ordering ---

test "Transform order determinism" do
  let surface1 = gfx::create_software_surface(50, 50)
  let canvas1 = surface1.begin_frame()
  canvas1.clear(Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 })
  canvas1.save()
  canvas1.transform(geom::transform_translate(10.0, 10.0))
  canvas1.transform(geom::transform_scale(2.0, 2.0))
  let p = gfx::solid_paint(Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 })
  canvas1.fill_rect(Rect { x: 0.0, y: 0.0, w: 5.0, h: 5.0 }, p)
  canvas1.restore()
  surface1.end_frame()
  let h1 = simple_hash(surface1.to_bitmap().data)

  # Repeat
  let surface2 = gfx::create_software_surface(50, 50)
  let canvas2 = surface2.begin_frame()
  canvas2.clear(Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 })
  canvas2.save()
  canvas2.transform(geom::transform_translate(10.0, 10.0))
  canvas2.transform(geom::transform_scale(2.0, 2.0))
  let p2 = gfx::solid_paint(Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 })
  canvas2.fill_rect(Rect { x: 0.0, y: 0.0, w: 5.0, h: 5.0 }, p2)
  canvas2.restore()
  surface2.end_frame()
  let h2 = simple_hash(surface2.to_bitmap().data)

  assert_eq(h1, h2)
end

# --- Fixed assets/config ---

test "Same PNG encode produces identical bytes" do
  use std::image

  let bmp = Bitmap {
    info: ImageInfo { width: 2, height: 2, format: PixelFormat::RGBA8, color_space: ColorSpace::SRGB, stride: 8 },
    data: [255u8, 0u8, 0u8, 255u8, 0u8, 255u8, 0u8, 255u8,
           0u8, 0u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8]
  }
  let opts = EncodeOpts { quality: 100 }

  let enc1 = image::encode_png(bmp, opts)
  let enc2 = image::encode_png(bmp, opts)

  match (enc1, enc2)
  when (Ok(bytes1), Ok(bytes2))
    assert_eq(bytes1.len(), bytes2.len())
    let i = 0
    while i < bytes1.len()
      assert_eq(bytes1[i], bytes2[i])
      i = i + 1
    end
  else
    assert(false)
  end
end

# --- Backend skip for non-deterministic modes ---
# When a backend declares gpu_nondeterminism_possible=true,
# determinism tests should be skipped or use backend-specific tolerance.

test "GPU non-determinism flag check" do
  use std::backend_abi
  # Verify the flag exists in manifest template
  let manifest = _example_manifest()
  assert(manifest.contains("gpu_nondeterminism_possible"))
end
