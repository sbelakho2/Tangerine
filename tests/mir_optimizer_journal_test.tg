# ———————————————————————————————————————————————————————————————
# tests/mir_optimizer_journal_test.tg — audit order item 8: the optimizer
# provenance journal and the perf introspection derived from it.
#
# The self-checking lane rows build minimal MirFunctions BY HAND (the
# mir_slp_lane_check / mir_alias_facts_lane_check construction style):
#
#   mir_opt_journal_lane_check (mir.tg):
#     J1 bounds-check elimination records "bounds-check-removed" with the
#        constant-index PROOF WITNESS at the assert's semantic site key;
#     J2 a check with no range fact records "bounds-check-retained" with
#        the proof-gap evidence;
#     J3 the inliner records "inline-applied" with the callee size counts
#        and the active threshold pair (the cost-model evidence);
#     J4 an @noinline callee records "inline-rejected" naming the hint;
#     J5 escape analysis records "escape-promoted" with the recognized
#        allocation callee and the NoEscape + value-flow-closure proof;
#     J6 an allocation destination read outside its call records
#        "escape-rejected" naming the closure gap;
#     J7 LICM records "licm-hoisted" with the loop-invariance fact (the
#        operand locals defined outside the loop header) and
#        "licm-rejected" for a consuming statement that can never move;
#     J8 the SLP vectorizer records "slp-vectorize-rejected" with the
#        real blocker (the aliasing window).
#
#   perf_journal_lane_check (perf_report.tg):
#     P1 bounds_checks_removed / inline_decisions are Some(count) with the
#        journal rows' stable P0-7 sites (decoys excluded); the labeled
#        fact rows carry the same records;
#     P2 a program with NO journal yields None / "unknown" — never a
#        fabricated zero;
#     P3 a journal with no matching row is a recorded Some(0), distinct
#        from P2;
#     P4 the compiler-owned vector property returns true for a registered
#        lane-uniform 16-byte Vec4[I32]-shaped SIMD definition and false
#        for the name-alike user types ("Vec4Like", and a 12-byte "Vec4").
#
# Run with the repo root as the working directory:
#   tg test tests/mir_optimizer_journal_test.tg

use std::test::assert

use tg_compiler::mir::{mir_opt_journal_lane_check}
use tg_compiler::perf_report::{perf_journal_lane_check}

@test
def test_mir_opt_journal_lane() -> Unit
  let rows = mir_opt_journal_lane_check()
  assert(rows.len() == 0, "optimizer journal lane mismatches: " + rows.join("; "))
end

@test
def test_perf_journal_lane() -> Unit
  let rows = perf_journal_lane_check()
  assert(rows.len() == 0, "perf journal lane mismatches: " + rows.join("; "))
end
