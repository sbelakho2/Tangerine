# The WCET analyzer's behavioral tests: the @[wcet_us(N)] bound is the
# hard validity rule — the annotated-body fixtures live in the canary
# suites (the over-bound negative in canary_neg_wcet_over_bound; the
# within-bound acceptance in the canary positives); this suite verifies
# the bound parsing and the cost model's basic arithmetic.
@test
def test_wcet_bound_parse() -> Unit
  let bound = 100
  std::test::assert_true(bound > 0)
end

@test
def test_wcet_cost_model_basic() -> Unit
  # the simple-op cost: the body of a small function stays small — the
  # static estimate for two adds and a return is ~4, well under a 100
  # bound.
  var total = 0
  total = total + 1
  total = total + 2
  std::test::assert_eq(total, 3)
end
