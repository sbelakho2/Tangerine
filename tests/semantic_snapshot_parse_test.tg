# tests/semantic_snapshot_parse_test.tg — the OFFLINE-ARTIFACT parser lanes
# (the serializer's exact inverse + the loaded-artifact session):
#
# Module lanes live in semantic_snapshot.tg:
#   semantic_snapshot_parse_lane_check — a hand-built FULL snapshot (every
#     row family non-empty, adversarial values: quote/backslash/newline
#     escaping, nested-paren contract text, comma/semicolon-carrying list
#     elements, full-range UInt digest words, negative Ints, Some/None
#     optionals) is serialized, parsed back and re-serialized; the lane
#     asserts BYTE identity plus per-family counts, header words, optionals
#     and the digest->key hydration of digest-only rows.
# This suite drives that lane, the fail-closed malformed-row probes
# (missing field, malformed digest, unknown tag, row before the header,
# quoted/raw type mismatch) and the loaded-artifact session query
# (snapshot_only_session over the parsed record answers the callers op with
# the hydrated canonical key).
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_snapshot_parse_test.tg

use std::core::{Option, Result, Unit}
use std::collections::{Vec}
use std::test::*

use tg_compiler::semantic_server::{
  SEMANTIC_PROTOCOL_VERSION, SemanticRequest, snapshot_only_session, session_handle_request
}
use tg_compiler::semantic_snapshot::{
  semantic_snapshot_parse, semantic_snapshot_serialize,
  semantic_snapshot_parse_lane_check, snapshot_parse_lane_snapshot
}

@test
def test_snapshot_parse_round_trip_lane() -> Unit
  let bad = semantic_snapshot_parse_lane_check()
  assert(bad.len() == 0, "snapshot parse lane mismatches: " + bad.join("; "))
end

@test
def test_snapshot_parse_malformed_rows_fail_closed() -> Unit
  var seed = snapshot_parse_lane_snapshot()
  let header_text = semantic_snapshot_serialize(&mut seed)

  # A symbol row missing its documented fields.
  let missing = header_text.clone() + "{\"s\":\"symbol\",\"i\":\"1-2\",\"key\":\"k\"}\n"
  match semantic_snapshot_parse(missing)
  when Result::Ok(_) then
    assert(false, "a symbol row missing fields must fail closed")
  when Result::Err(e) then
    assert(e.contains("row 'symbol'"), "the error must name the row tag: " + e)
    assert(e.contains("missing field 'kind'"), "the error must name the missing field: " + e)
  end

  # A malformed digest word.
  let bad_digest = header_text.clone() +
    "{\"s\":\"call\",\"from\":\"not-a-digest\",\"to\":\"1-2\",\"ekind\":\"Direct\"}\n"
  match semantic_snapshot_parse(bad_digest)
  when Result::Ok(_) then
    assert(false, "a malformed digest must fail closed")
  when Result::Err(e) then
    assert(e.contains("'hi-lo' digest"), "the bad-digest error must name the grammar: " + e)
  end

  # An unknown row tag.
  let unknown = header_text.clone() + "{\"s\":\"bogus\"}\n"
  match semantic_snapshot_parse(unknown)
  when Result::Ok(_) then
    assert(false, "an unknown row tag must fail closed")
  when Result::Err(e) then
    assert(e.contains("unknown row tag"), "the unknown-tag error must name the reason: " + e)
  end

  # A row before the header.
  let early = "{\"s\":\"mir\",\"f\":\"1-2\"}\n" + header_text.clone()
  match semantic_snapshot_parse(early)
  when Result::Ok(_) then
    assert(false, "a row before the header must fail closed")
  when Result::Err(e) then
    assert(e.contains("before the header"), "the ordering error must name the reason: " + e)
  end

  # A quoted scalar where the serializer writes a raw integer.
  let wrong_type = header_text.clone() +
    "{\"s\":\"capability\",\"f\":\"1-2\",\"cap\":\"1\",\"dir\":\"Requires\"}\n"
  match semantic_snapshot_parse(wrong_type)
  when Result::Ok(_) then
    assert(false, "a quoted integer must fail closed")
  when Result::Err(e) then
    assert(e.contains("unquoted scalar"), "the type error must name the expectation: " + e)
  end

  # An unsupported header version.
  let bad_version = "{\"s\":\"header\",\"v\":2,\"format\":\"tg-semantic-snapshot/v1\"}\n"
  match semantic_snapshot_parse(bad_version)
  when Result::Ok(_) then
    assert(false, "an unsupported header version must fail closed")
  when Result::Err(e) then
    assert(e.contains("unsupported snapshot version"), "the version error must name the reason: " + e)
  end
end

@test
def test_snapshot_offline_artifact_serves_queries() -> Unit
  var seed = snapshot_parse_lane_snapshot()
  let text = semantic_snapshot_serialize(&mut seed)
  match semantic_snapshot_parse(text)
  when Result::Err(e) then
    assert(false, "the serialized artifact must parse: " + e)
  when Result::Ok(snapshot) then
    let session = snapshot_only_session(&snapshot)
    let resp = session_handle_request(&session, SemanticRequest {
      protocol_version: SEMANTIC_PROTOCOL_VERSION,
      request_id: 1,
      operation: "callers".to_string(),
      payload: "lane::g#fn(i64)->i64".to_string()
    })
    assert(resp.ok, "callers must answer ok from the offline artifact: " + resp.error.clone())
    assert(resp.kind == "callers", "callers kind: " + resp.kind.clone())
    var found_caller = false
    for row in resp.keys do
      if row == "caller:lane::f#fn(i64)->i64" then
        found_caller = true
      end
    end
    assert(found_caller, "the hydrated caller key must answer from the parsed artifact: " + resp.keys.join("; "))
  end
end
