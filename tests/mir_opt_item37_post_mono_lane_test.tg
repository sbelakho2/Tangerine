# tests/mir_opt_item37_post_mono_lane_test.tg — third-audit item 37's next
# pieces: post-mono devirtualization, post-mono inlining wiring, the
# interprocedural escape extension and tail-call recognition.
#
# The engine lives in tg_compiler/mir.tg:
#   (a) devirtualize_calls_impl / mir_devirt_rewrite_function — an indirect
#       call whose callee operand reads a proven-unique function value
#       (single MirFnItem store, never reassigned, never address-taken,
#       never projected, store block dominates the call) is rewritten to a
#       direct MirFnItem call;
#   (b) post-mono inlining — the optimizer invokes the inliner after
#       monomorphization (twice: on the raw instances and again after the
#       scalar batches shrink them), with applied/rejected decision rows;
#   (c) interprocedural escape summaries — per-parameter/return exit states
#       classify direct-call arguments (a scalar argument to a callee whose
#       parameter provably does not escape stays NoEscape; unknown callees
#       keep the blanket ArgEscape);
#   (d) tail-call recognition — mark_tail_calls_impl marks a direct call in
#       the return place whose success block is a bare return, with the
#       same return type identity and extern_abi; a trailing MirDeinit in
#       the success path blocks the mark.
#
# The self-checking lane rows (mir_opt_item37_next_lane_check) build
# minimal MirFunctions BY HAND and assert:
#   D1 an indirect single-target call is rewritten direct ("devirt" row);
#   D2 the negative: two stores disqualify the holder;
#   D3 the negative: an address-taken holder disqualifies the target;
#   T1 a direct self-call in tail position is marked ("tail-marked" row);
#   T2 the negative: a trailing MirDeinit blocks the mark;
#   E1 a scalar argument to a calm direct callee stays NoEscape;
#   E2 the negative: the same argument to an unknown callee is ArgEscape.
#
# Run with the repo root as the working directory:
#   tg test tests/mir_opt_item37_post_mono_lane_test.tg

use std::test::assert

use tg_compiler::mir::{mir_opt_item37_next_lane_check}
use tg_compiler::codegen::{codegen_tail_eligible}

@test
def test_mir_opt_item37_post_mono_lane() -> Unit
  let rows = mir_opt_item37_next_lane_check()
  assert(rows.len() == 0, "mir optimizer item-37 post-mono lane mismatches: " + rows.join("; "))
end

# The direct route's tail-jump emission gate, pinned as a shape-level row:
# a marker on a direct compiled callee with register-resident args and the
# return place eligible for a frame-restoring jump; a stacked-arg call, an
# sret call, a closure dispatch and a non-return-place destination each
# fall back to the ordinary call.
@test
def test_codegen_tail_emission_shape() -> Unit
  assert(codegen_tail_eligible(true, true, 0, 3, 8, false, true),
    "a tail-marked direct call with register args must be jump-eligible")
  assert(!codegen_tail_eligible(true, true, 0, 9, 8, false, true),
    "stack arguments must block the tail jump (the frame restore discards them)")
  assert(!codegen_tail_eligible(true, true, 0, 3, 8, true, true),
    "an sret call must block the tail jump (the copy-out is skipped)")
  assert(!codegen_tail_eligible(true, true, 1, 0, 8, false, true),
    "a closure dispatch must block the tail jump (the pushed pair is discarded)")
  assert(!codegen_tail_eligible(true, true, 0, 1, 8, false, false),
    "a destination that is not the return place must block the tail jump")
end
