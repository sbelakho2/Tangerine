# Canonical structural Type equality (types.tg::type_structural_eq).
# These pin the payload-sensitive cases the verifier's former fast path
# collapsed: Var identity, Const values, symbolic const trees, and effect sets.
use std::core::{Option, Result, Unit, Bool, Int}
use std::test::assert
use tg_compiler::types::{Type, TypeVarId, ConstExprT, type_structural_eq}
use tg_compiler::ids::EffectId

@test
def test_var_identity_is_part_of_equality() -> Unit
  let a = Type::Var(TypeVarId { id: 1 })
  let b = Type::Var(TypeVarId { id: 2 })
  assert(!type_structural_eq(a.clone(), b.clone()), "distinct Var ids must not compare equal")
  assert(type_structural_eq(a.clone(), a.clone()), "same Var id must compare equal")
end

@test
def test_const_value_is_part_of_equality() -> Unit
  let a = Type::Const(4)
  let b = Type::Const(8)
  assert(!type_structural_eq(a.clone(), b.clone()), "Const(4) != Const(8)")
  assert(type_structural_eq(a.clone(), a.clone()), "Const(4) == Const(4)")
end

@test
def test_const_sym_tree_is_structural_and_ordered() -> Unit
  let a = Type::ConstSym(ConstExprT::ConstAdd(ConstExprT::ConstLit(1), ConstExprT::ConstLit(2)))
  let b = Type::ConstSym(ConstExprT::ConstAdd(ConstExprT::ConstLit(2), ConstExprT::ConstLit(1)))
  let c = Type::ConstSym(ConstExprT::ConstLit(1))
  let d = Type::ConstSym(ConstExprT::ConstLit(2))
  assert(!type_structural_eq(a.clone(), b.clone()), "order-sensitive const trees must differ")
  assert(!type_structural_eq(c.clone(), d.clone()), "distinct const literals must differ")
  assert(type_structural_eq(a.clone(), a.clone()), "identical const trees must compare equal")
end

@test
def test_effect_set_is_part_of_equality() -> Unit
  let io = Vec::from([EffectId { id: 1 }])
  let io_net = Vec::from([EffectId { id: 1 }, EffectId { id: 2 }])
  let a = Type::Effect(io.clone(), Type::Int)
  let b = Type::Effect(io_net.clone(), Type::Int)
  let c = Type::Effect(io.clone(), Type::String)
  assert(!type_structural_eq(a.clone(), b.clone()), "different effect sets must differ")
  assert(!type_structural_eq(a.clone(), c.clone()), "different effect inner types must differ")
  assert(type_structural_eq(a.clone(), a.clone()), "same effect type must compare equal")
end
