## The non-kernel stdlib behavior suite (the mandate's
## non-kernel-stdlib-behavior row): real @test suites over the pure,
## OS-independent public surfaces of the parse-clean modules (semver /
## url / csv / unicode / hash) — the parse-clean modules' behavior
## suites. Every assertion exercises a committed std module's real
## implementation on the host (no platform target required).

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::semver::{Version}
use std::csv::{Record}
use std::hash::{DefaultHasher}
use std::test::*

@test
def test_semver_parse_ok() -> Unit
  match Version::parse("1.2.3")
  when Result::Ok(v) then
    if v.to_string() != "1.2.3" then
      panic("semver parse round trip failed: got " + v.to_string())
    end
  when Result::Err(_) then panic("a well-formed version must parse")
  end
end

@test
def test_semver_parse_invalid() -> Unit
  match Version::parse("not-a-version")
  when Result::Ok(_) then panic("an invalid version string must fail parse")
  when Result::Err(_) then ()
  end
end

@test
def test_semver_satisfies() -> Unit
  match std::semver::satisfies("1.2.3", "1.2.3")
  when Result::Ok(b) then
    if !b then panic("1.2.3 must satisfy the exact requirement 1.2.3") end
  when Result::Err(_) then panic("the requirement must parse")
  end
  match std::semver::satisfies("1.2.4", "1.2.3")
  when Result::Ok(b) then
    if b then panic("1.2.4 must not satisfy the exact requirement 1.2.3") end
  when Result::Err(_) then panic("the requirement must parse")
  end
end

@test
def test_semver_max_satisfying() -> Unit
  match std::semver::max_satisfying(["1.0.0", "1.5.0", "2.0.0"], ">=1.0.0")
  when Result::Ok(opt) then
    match opt
    when Option::Some(v) then
      if v.to_string() != "2.0.0" then
        panic("max_satisfying must pick 2.0.0, got " + v.to_string())
      end
    when Option::None then panic(">=1.0.0 must match a listed version")
    end
  when Result::Err(_) then panic("the requirement must parse")
  end
end

@test
def test_url_percent_round_trip() -> Unit
  let encoded = std::url::percent_encode("a b", "a")
  if encoded != "a%20%62" then
    panic("percent_encode mismatch: got " + encoded)
  end
  let decoded = std::url::percent_decode(encoded)
  if decoded != "a b" then
    panic("percent_decode round trip failed: got " + decoded)
  end
end

@test
def test_csv_parse_basic() -> Unit
  match std::csv::parse("a,b,c\n1,2,3")
  when Result::Ok(records) then
    if records.len() != 2 then
      panic("csv parse must yield two records, got " + records.len().to_string())
    end
    var checked = 0
    for rec in records do
      match rec.get(0)
      when Option::Some(f) then
        if checked == 0 && f != "a" then panic("csv header mismatch: got " + f) end
        if checked == 1 && f != "1" then panic("csv row mismatch: got " + f) end
      when Option::None then panic("csv field missing")
      end
      checked = checked + 1
    end
  when Result::Err(_) then panic("a basic csv must parse")
  end
end

@test
def test_unicode_char_classes() -> Unit
  if !std::unicode::is_digit('5') then panic("'5' must be a digit") end
  if std::unicode::is_digit('a') then panic("'a' must not be a digit") end
  if !std::unicode::is_whitespace(' ') then panic("a space must be whitespace") end
  if !std::unicode::is_uppercase('A') then panic("'A' must be uppercase") end
  if !std::unicode::is_lowercase('z') then panic("'z' must be lowercase") end
end

@test
def test_hash_determinism() -> Unit
  var h1 = DefaultHasher::new()
  h1.write([1, 2, 3])
  let f1 = h1.finish()
  var h2 = DefaultHasher::new()
  h2.write([1, 2, 3])
  let f2 = h2.finish()
  if f1 != f2 then
    panic("the fixed-key hasher must be deterministic")
  end
  var h3 = DefaultHasher::new()
  h3.write([1, 2, 4])
  let f3 = h3.finish()
  if f1 == f3 then
    panic("different inputs must produce different hashes")
  end
end
