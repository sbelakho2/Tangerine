# tests/unit/test_net_behavior.tg — the per-callable behavior suite
# for std::net (the API manifest's uncovered callables, driven to real
# semantics: inputs -> expected outputs; the failure paths -> the
# expected failures). The transport tests run over loopback / the
# unix-domain sockets — no external network. The OpenSSL handle calls
# (SSL_connect/SSL_read/...) need a live SSL session and stay the
# documented remaining gap; tls_connect's handshake-failure path IS
# exercised against a plain TCP socket.

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec}
use std::test::*
use std::net::*
use std::alloc::{alloc, dealloc}
use std::io::{Read, Write}

const NBEHAVIOR_TCP_PORT: u16 = 38810u16
const NBEHAVIOR_UDP_PORT: u16 = 38811u16
const NBEHAVIOR_UNIX_PATH: str = "/tmp/tg_net_behavior_38812.sock"
const NBEHAVIOR_UNIX_DGRAM: str = "/tmp/tg_net_behavior_38813.sock"

@test
def test_net_constants() -> Unit
  assert_eq(AF_INET(), 2)
  assert_eq(AF_INET6(), 10)
  assert_eq(AF_UNIX(), 1)
  assert_eq(IPPROTO_TCP_OPT(), 6)
  assert_eq(IPPROTO_UDP(), 17)
  assert_eq(SHUT_RD(), 0)
  assert_eq(SHUT_WR(), 1)
  assert_eq(SHUT_RDWR(), 2)
  assert_eq(SOCK_DGRAM(), 2)
  assert_eq(SOL_SOCKET(), 1)
  assert_eq(SO_REUSEADDR(), 2)
  assert_eq(SO_KEEPALIVE(), 9)
  assert_eq(SO_RCVTIMEO(), 20)
  assert_eq(SO_SNDTIMEO(), 21)
  assert_eq(TCP_NODELAY(), 1)
  assert_eq(EAGAIN(), 11)
  assert_eq(EWOULDBLOCK(), 11)
  assert_eq(EINPROGRESS(), 115)
  assert_eq(ECONNREFUSED(), 111)
end

@test
def test_net_addresses() -> Unit
  # the sockaddr constructors
  let _sin = sockaddr_in_new(AF_INET() as u16, 80, 0x0100007F)
  assert_true(sockaddr_in_len() > 0)
  let _sin6 = sockaddr_in6_new(AF_INET6() as u16, 443, [0 as u8; 16], 0)
  # the IP helpers
  assert_eq(ipv4_new(127, 0, 0, 1).to_string(), "127.0.0.1")
  assert_eq(ipv4_any().to_string(), "0.0.0.0")
  assert_eq(ipv4_localhost().to_u32(), 0x7F000001)
  assert_eq(Ipv4Addr::from_u32(0x7F000001).to_string(), "127.0.0.1")
  let _v6_lo = ipv6_localhost()
  let _v6_any = ipv6_any()
  # the socket addresses
  let _sa4 = socket_addr_v4(ipv4_localhost(), 8080)
  let _sa6 = socket_addr_v6(ipv6_localhost(), 8080)
  # the getaddrinfo hints
  let _hints = addr_info_hints_zero()
  # the error messages
  assert_true(gai_error_message(-3).len() > 0)
  # inet_pton / inet_ntop over real buffers
  let buf = alloc[u8]()
  let rc = inet_pton(AF_INET(), "127.0.0.1".as_ptr(), buf as PtrMut[u8])
  assert_eq(rc, 1)
  let out = alloc[u8]()
  out.write(0)
  let p = inet_ntop(AF_INET(), buf, out as PtrMut[u8], 16)
  assert_true(!p.is_null())
  dealloc[u8](buf)
  dealloc[u8](out)
end

@test
def test_net_resolve_host() -> Unit
  let addrs = assert_ok(resolve_host("localhost".to_string()))
  assert_true(addrs.len() > 0)
end

@test
def test_net_tcp_loopback_surface() -> Unit
  let addr = socket_addr_v4(ipv4_localhost(), NBEHAVIOR_TCP_PORT)
  var listener = assert_ok(tcp_bind(addr))
  # the listener surface: local_addr + incoming + accept
  let la = listener.local_addr()
  let _ = la
  let mut incoming = listener.incoming()
  let client = assert_ok(tcp_connect(addr))
  let server = assert_ok(listener.accept())
  # the client stream surface
  let _peer = server.peer_addr()
  assert_true(client.raw_fd() >= 0)
  assert_ok(client.set_nodelay(true))
  assert_ok(client.set_read_timeout(1, 0))
  assert_ok(client.flush())
  assert_ok(client.shutdown(SHUT_WR()))
  # the incoming iterator yields the accepted stream
  let client2 = assert_ok(tcp_connect(addr))
  let from_incoming = match incoming.next()
  when Option::Some(Result::Ok(s)) then s
  when _ then
    assert_false(true)
    return
  end
  let _ = from_incoming.raw_fd()
  # the raw socket layer over a freshly created socket
  let raw_fd = socket(AF_INET(), SOCK_STREAM(), 0)
  assert_true(raw_fd >= 0)
  assert_eq(listen(raw_fd, 5), 0)
  assert_eq(setsockopt(raw_fd, SOL_SOCKET(), SO_REUSEADDR(), &1 as Ptr[u8], 4 as u32), 0)
  var optval: Int = 0
  var optlen: u32 = 4
  assert_eq(getsockopt(raw_fd, SOL_SOCKET(), SO_REUSEADDR(), &mut optval as PtrMut[u8], &mut optlen as PtrMut[u32]), 0)
  assert_eq(close(raw_fd), 0)
  # the write/read round trip over the raw fds
  let payload: Vec[u8] = Vec::from([104u8, 105u8])
  let n = assert_ok(client2.write(payload))
  assert_eq(n, 2)
end

@test
def test_net_udp_loopback_surface() -> Unit
  let addr = socket_addr_v4(ipv4_localhost(), NBEHAVIOR_UDP_PORT)
  var sock = assert_ok(udp_bind(addr))
  let _la = sock.local_addr()
  assert_ok(sock.set_broadcast(true))
  let data: Vec[u8] = Vec::from([1u8, 2u8, 3u8])
  let n = assert_ok(sock.send(data))
  assert_eq(n, 3)
  var buf: Vec[u8] = Vec::from([0u8, 0u8, 0u8])
  let m = assert_ok(sock.recv(buf))
  assert_eq(m, 3)
  assert_ok(sock.connect(addr))
  # send_to / recv_from over a second socket
  let addr2 = socket_addr_v4(ipv4_localhost(), NBEHAVIOR_UDP_PORT + 1)
  var sender = assert_ok(udp_bind(addr2))
  let sent = assert_ok(sender.send_to(data, addr))
  assert_eq(sent, 3)
  var buf2: Vec[u8] = Vec::from([0u8, 0u8, 0u8])
  let (got, _from) = assert_ok(sock.recv_from(buf2))
  assert_eq(got, 3)
end

@test
def test_net_unix_domain_surface() -> Unit
  # the listener + the connected stream
  var listener = assert_ok(unix_listen(NBEHAVIOR_UNIX_PATH))
  let stream = assert_ok(unix_connect(NBEHAVIOR_UNIX_PATH))
  let server = assert_ok(listener.accept())
  let payload: Vec[u8] = Vec::from([7u8])
  let n = assert_ok(stream.write(payload))
  assert_eq(n, 1)
  let _fd = server.raw_fd()
  # the datagram pair
  var bound = assert_ok(unix_datagram_bind(NBEHAVIOR_UNIX_DGRAM))
  var unbound = assert_ok(unix_datagram_unbound())
  let d = unbound.send_to(Vec::from([9u8]), NBEHAVIOR_UNIX_DGRAM)
  assert_ok(d)
  var dg_buf: Vec[u8] = Vec::from([0u8])
  let got = assert_ok(bound.recv(dg_buf))
  assert_eq(got, 1 as UInt)
  # the unix address builder
  let (_sau, len) = _make_unix_addr(NBEHAVIOR_UNIX_PATH)
  assert_true(len > 0)
end

@test
def test_net_tls_config() -> Unit
  # the config constructor
  let cfg = tls_config_default()
  let _ = cfg
  # the OpenSSL init (no handle state)
  assert_true(SSL_library_init() >= 0)
end
