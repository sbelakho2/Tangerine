# tests/unit/test_capability.tg — Capability rejection & error mapping §21.1
use std::test::*
use std::platform
use std::gfx_gpu

# --- Clipboard capability rejection ---

@test
def test_clipboard_set_text_without_cap_returns_error() -> Unit
  # Without a real ClipboardCap, the function should return Unsupported
  # In the type system, you cannot call set_text without a ClipboardCap parameter
  # This test validates the error enum itself
  let err = PlatformError::Unsupported("Clipboard not available")
  assert_eq(err.message(), "Clipboard not available")
  assert_eq(err.code(), -1)
end

@test
def test_clipboard_get_text_without_cap_returns_error() -> Unit
  let err = PlatformError::Unsupported("No backend loaded")
  assert_eq(err.message(), "No backend loaded")
end

# --- IME capability rejection ---

@test
def test_ime_error_mapping() -> Unit
  let err = PlatformError::Unsupported("IME not supported")
  assert_eq(err.code(), -1)
end

# --- DragDrop capability rejection ---

@test
def test_dragdrop_error_mapping() -> Unit
  let err = PlatformError::Unsupported("DragDrop not available")
  assert_eq(err.code(), -1)
end

# --- GPU capability rejection ---

@test
def test_gpu_instance_create_returns_unsupported() -> Unit
  let result = gfx_gpu::instance_create()
  match result
  when Err(e)
    assert_eq(e, GpuError::Unsupported)
  when Ok(_)
    assert_false(true)  # Should not succeed without backend
  end
end

@test
def test_gpu_device_request_returns_unsupported() -> Unit
  let adapter = Adapter { _opaque: 0u64 }
  let result = gfx_gpu::device_request(adapter)
  match result
  when Err(e)
    assert_eq(e, GpuError::Unsupported)
  when Ok(_)
    assert_false(true)
  end
end

@test
def test_gpu_buffer_create_returns_unsupported() -> Unit
  let device = Device { _opaque: 0u64 }
  let result = gfx_gpu::buffer_create(device, 1024u64, BufferUsage::Vertex)
  match result
  when Err(e)
    assert_eq(e, GpuError::Unsupported)
  when Ok(_)
    assert_false(true)
  end
end

# --- Error code consistency ---

@test
def test_platformerror_code_mapping() -> Unit
  assert_eq(PlatformError::Unsupported("").code(), -1)
  assert_eq(PlatformError::BackendFailure("").code(), -2)
  assert_eq(PlatformError::PermissionDenied("").code(), -3)
  assert_eq(PlatformError::IOError("").code(), -4)
end

@test
def test_gpuerror_message() -> Unit
  assert_eq(GpuError::Unsupported.message(), "GPU not supported: no backend loaded")
  assert_eq(GpuError::DeviceLost.message(), "GPU device lost")
  assert_eq(GpuError::OutOfMemory.message(), "GPU out of memory")
end
