use std::url
use std::url::{Url, UrlError, percent_encode, percent_decode, encode_uri_component, decode_uri_component}
use std::core::{Result, Option, String}

test "Golden: Parse simple https URL" do
  let url = Url::parse("https://example.com/path").unwrap()
  assert url.scheme == "https"
  assert url.host.unwrap() == "example.com"
  assert url.path == "/path"
end

test "Oracle: Percent encode reserved chars" do
  let encoded = encode_uri_component("hello world")
  assert encoded == "hello%20world"
end

test "Oracle: Percent encode special chars" do
  let encoded = encode_uri_component("a/b?c=d")
  assert encoded == "a%2Fb%3Fc%3Dd"
end

test "Metamorphic: Percent encode/decode roundtrip (ASCII safe)" do
  let s = "HelloWorld-._~"
  let enc = encode_uri_component(s)
  assert enc == s
  let dec = decode_uri_component(&enc)
  assert dec == s
end

test "Metamorphic: Percent encode/decode roundtrip (special)" do
  let s = "foo bar/baz"
  let enc = encode_uri_component(s)
  let dec = decode_uri_component(&enc)
  assert dec == s
end

test "Negative: Empty input is error" do
  let res = Url::parse("")
  match res
  when Result::Err(e) then
    match e
    when UrlError::EmptyInput then assert true
    when _ then assert false
    end
  when Result::Ok(_) then assert false
  end
end

test "Lifecycle: Parse URL with port and query" do
  let url = Url::parse("http://example.com:8080/api?k=v").unwrap()
  assert url.scheme == "http"
  assert url.port.unwrap() == 8080
  assert url.query.unwrap() == "k=v"
end

test "Lifecycle: Parse URL with fragment" do
  let url = Url::parse("https://example.com/p#section").unwrap()
  assert url.fragment.unwrap() == "section"
end
use std::url

