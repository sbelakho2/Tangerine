# tests/unit/test_sql_rigor.tg — the facade SQL contract (P1.6): the
# PreparedStatement binding is 1-based and recorded; the prepared
# statement EXECUTE is the explicit Err(Unsupported) — never the silent
# Ok(ResultSet { rows: [] }) — because the facade carries no driver
# execution path (the concrete driver's Connection::execute is the
# execution surface).

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec}
use std::test::*
use std::sql::{PreparedStatement, SqlError}
use std::gfx_errors::ErrorCode
use std::secure_types::SqlParam

@test
def test_sql_bind_is_one_based_and_recorded() -> Unit
  var stmt = PreparedStatement {
    sql: "SELECT $1".to_string(),
    _handle: 0,
    binds: Vec::new()
  }
  # 0 is an invalid parameter index (the params are 1-based).
  let err0 = assert_err(stmt.bind(0, SqlParam::Int(7)))
  let _ = err0
  assert_ok(stmt.bind(1, SqlParam::Int(7)))
  assert_eq(stmt.binds.len(), 1)
  let err2 = assert_err(stmt.bind(-1, SqlParam::Text("x".to_string())))
  let _ = err2
  assert_eq(stmt.binds.len(), 1)
end

@test
def test_sql_prepared_execute_never_returns_ok_empty() -> Unit
  # The P0.3 contract: the facade's PreparedStatement::execute must
  # produce the explicit Err(Unsupported) — the empty Ok(ResultSet)
  # is gone. A statement prepared on the concrete driver executes
  # through the driver's Connection::execute; the facade statement
  # itself carries no execution path.
  var stmt = PreparedStatement {
    sql: "SELECT 1".to_string(),
    _handle: 0,
    binds: Vec::new()
  }
  let res = stmt.execute()
  let err = assert_err(res)
  assert_true(err.code() == ErrorCode::Unsupported)
end

@test
def test_sql_result_set_shape() -> Unit
  # ResultSet/Row stay usable by the concrete drivers: a driver-built
  # result set carries its rows.
  var rs = std::sql::ResultSet { rows: Vec::new() }
  assert_eq(rs.rows.len(), 0)
end
