use std::ui
use std::ui::{Color, blend_colors, lerp_color}
use std::core::{Option, Result}

test "Golden: Color::rgb sets alpha to 255" do
  let c = Color::rgb(10, 20, 30)
  assert c.r == 10
  assert c.g == 20
  assert c.b == 30
  assert c.a == 255
end

test "Oracle: Color::from_hex decodes channels" do
  let c = Color::from_hex(0x112233)
  assert c.r == 0x11
  assert c.g == 0x22
  assert c.b == 0x33
  assert c.a == 255
end

test "Oracle: Color::rgba preserves alpha" do
  let c = Color::rgba(1, 2, 3, 128)
  assert c.a == 128
end

test "Metamorphic: blend_colors with opaque dst returns opaque" do
  let src = Color::rgba(255, 0, 0, 0)
  let dst = Color::rgba(0, 0, 255, 255)
  let out = blend_colors(&src, &dst)
  assert out.a == 255
  assert out.b == 255
end

test "Metamorphic: blend_colors with opaque src equals src" do
  let src = Color::rgba(10, 20, 30, 255)
  let dst = Color::rgba(200, 100, 50, 255)
  let out = blend_colors(&src, &dst)
  assert out.r == 10
  assert out.g == 20
  assert out.b == 30
end

test "Metamorphic: lerp_color at t=0 returns a" do
  let a = Color::rgb(10, 20, 30)
  let b = Color::rgb(200, 100, 50)
  let c = lerp_color(&a, &b, 0.0)
  assert c.r == a.r
  assert c.g == a.g
  assert c.b == a.b
end

test "Metamorphic: lerp_color at t=1 returns b" do
  let a = Color::rgb(10, 20, 30)
  let b = Color::rgb(200, 100, 50)
  let c = lerp_color(&a, &b, 1.0)
  assert c.r == b.r
  assert c.g == b.g
  assert c.b == b.b
end

test "Lifecycle: transparent dst blend preserves src" do
  let src = Color::rgba(50, 60, 70, 128)
  let dst = Color::rgba(0, 0, 0, 0)
  let out = blend_colors(&src, &dst)
  assert out.r == 50
  assert out.g == 60
  assert out.b == 70
end
