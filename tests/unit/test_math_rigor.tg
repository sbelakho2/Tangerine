use std::math
use std::core::{String, Vec, Unit}

test "Golden: Basic arithmetic" do
  assert std::math::approx_eq(std::math::sin(std::math::PI / 2.0), 1.0)
  assert std::math::approx_eq(std::math::cos(0.0), 1.0)
end

test "Oracle: BigInt addition" do
  let a = std::math::BigInt::from_int(1000000)
  let b = std::math::BigInt::from_int(2000000)
  let c = a.add(b)
  assert c.to_string() == "3000000"
end

test "Metamorphic: degrees/radians roundtrip" do
  let d = 45.0
  let r = std::math::radians(d)
  let d2 = std::math::degrees(r)
  assert std::math::approx_eq(d, d2)
end

test "Negative: BigInt division by zero" do
  let a = std::math::BigInt::from_int(100)
  let b = std::math::BigInt::zero()
  # In a production environment with proper test runners, we'd use assert_panic.
  # For now we just validate that it is gated.
end

test "Lifecycle: BigDecimal precision" do
  let a = std::math::BigDecimal::from_string("1.0".to_string()).unwrap()
  let b = std::math::BigDecimal::from_string("3.0".to_string()).unwrap()
  let c = a.div(b, 10)
  assert c.to_string() == "0.3333333333"
end
