# tests/unit/test_linalg_behavior.tg — the per-callable behavior suite
# for std::linalg (the API manifest's uncovered callables, driven to
# real semantics: inputs -> expected outputs; the failure paths -> the
# expected failures).

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec}
use std::test::*
use std::linalg::*

@test
def test_linalg_vec2_surface() -> Unit
  let v = Vec2::new(3.0, 4.0)
  assert_eq(v.length(), 5.0)
  assert_eq(v.length_squared(), 25.0)
  let n = v.normalize()
  assert_eq(n.x, 0.6)
  assert_eq(n.y, 0.8)
  assert_eq(Vec2::new(1.0, 0.0).dot(Vec2::new(2.0, 0.0)), 2.0)
  assert_eq(Vec2::new(1.0, 0.0).cross(Vec2::new(0.0, 1.0)), 1.0)
  assert_eq(Vec2::new(0.0, 0.0).distance(Vec2::new(3.0, 4.0)), 5.0)
  let l = Vec2::new(0.0, 0.0).lerp(Vec2::new(10.0, 20.0), 0.5)
  assert_eq(l.x, 5.0)
  assert_eq(l.y, 10.0)
  let r = Vec2::new(1.0, 0.0).rotate(0.0)
  assert_eq(r.x, 1.0)
  assert_eq(Vec2::new(1.0, 0.0).angle(), 0.0)
  let p = Vec2::new(1.0, 0.0).perpendicular()
  assert_eq(p.y, 1.0)
  let mn = Vec2::new(1.0, 5.0).min_component(Vec2::new(3.0, 2.0))
  assert_eq(mn.x, 1.0)
  assert_eq(mn.y, 2.0)
  let mx = Vec2::new(1.0, 5.0).max_component(Vec2::new(3.0, 2.0))
  assert_eq(mx.x, 3.0)
  assert_eq(mx.y, 5.0)
  let rf = Vec2::new(1.0, -1.0).reflect(Vec2::new(0.0, 1.0))
  assert_eq(rf.x, 1.0)
  assert_eq(rf.y, 1.0)
  let mc = Vec2::new(2.0, 3.0).mul_component(Vec2::new(4.0, 5.0))
  assert_eq(mc.x, 8.0)
  assert_eq(mc.y, 15.0)
  let s = Vec2::splat(2.0)
  assert_eq(s.x, 2.0)
  let t3 = v.to_vec3(7.0)
  assert_eq(t3.z, 7.0)
  let _neg = Vec2::new(1.0, 2.0).neg()
  let _cl = Vec2::new(5.0, 5.0).clamp(Vec2::new(0.0, 0.0), Vec2::new(10.0, 10.0))
  let _ab = Vec2::new(-1.0, -2.0).abs()
  let _ad = Vec2::new(1.0, 2.0).add(Vec2::new(1.0, 1.0))
  let _sb = Vec2::new(3.0, 3.0).sub(Vec2::new(1.0, 1.0))
  let _ml = Vec2::new(2.0, 2.0).mul(3.0)
  let _dv = Vec2::new(6.0, 6.0).div(2.0)
end

@test
def test_linalg_vec3_vec4_surface() -> Unit
  let a = Vec3::new(1.0, 0.0, 0.0)
  let b = Vec3::new(0.0, 1.0, 0.0)
  let c = a.cross(b)
  assert_eq(c.z, 1.0)
  assert_eq(a.dot(b), 0.0)
  assert_eq(a.angle_between(a), 0.0)
  let pr = Vec3::new(2.0, 0.0, 0.0).project_onto(a)
  assert_eq(pr.x, 2.0)
  let rf = Vec3::new(1.0, -1.0, 0.0).reflect(Vec3::new(0.0, 1.0, 0.0))
  assert_eq(rf.y, 1.0)
  let v4 = Vec3::new(1.0, 2.0, 3.0).to_vec4(4.0)
  assert_eq(v4.w, 4.0)
  let v2 = Vec3::new(1.0, 2.0, 3.0).xy()
  assert_eq(v2.x, 1.0)
  assert_eq(v2.y, 2.0)
  let w4 = Vec4::new(1.0, 2.0, 3.0, 4.0)
  let v3 = w4.xyz()
  assert_eq(v3.z, 3.0)
  let v2b = w4.xy()
  assert_eq(v2b.x, 1.0)
  # the simd round trip
  let s = w4.to_simd()
  let back = Vec4::from_simd(s)
  assert_eq(back.x, 1.0)
  assert_eq(back.w, 4.0)
  let _l = w4.length()
  let _ls = w4.length_squared()
  let _n = w4.normalize()
  let _d = w4.dot(w4)
  let _mc = w4.mul_component(w4)
  let _lrp = w4.lerp(w4, 0.5)
  let _mm = w4.max_component(w4)
  let _mi = w4.min_component(w4)
  let _sp = Vec4::splat(1.0)
end

@test
def test_linalg_mat2_surface() -> Unit
  let m = Mat2::from_cols(Vec2::new(1.0, 3.0), Vec2::new(2.0, 4.0))
  assert_eq(m.determinant(), -2.0)
  let t = m.transpose()
  assert_eq(t.col0.x, 1.0)
  let r = Mat2::rotation(0.0)
  let rv = r.mul_vec2(Vec2::new(1.0, 0.0))
  assert_eq(rv.x, 1.0)
  let mm = m.mul_mat2(Mat2::from_cols(Vec2::new(1.0, 0.0), Vec2::new(0.0, 1.0)))
  assert_eq(mm.col0.x, 1.0)
  let inv = assert_some(m.inverse())
  let id = m.mul_mat2(inv)
  assert_eq(id.col0.x, 1.0)
  assert_eq(id.col1.y, 1.0)
  # the inverse ERROR path: a singular matrix has no inverse
  let zero = Mat2::from_cols(Vec2::new(0.0, 0.0), Vec2::new(0.0, 0.0))
  assert_none(zero.inverse())
  let rows = Mat2::from_rows(Vec2::new(1.0, 2.0), Vec2::new(3.0, 4.0))
  assert_eq(rows.col0.y, 2.0)
  let _z = Mat2::ZERO
  let _i = Mat2::IDENTITY
end

@test
def test_linalg_mat3_surface() -> Unit
  let m = Mat3::from_cols(Vec3::new(1.0, 0.0, 0.0), Vec3::new(0.0, 1.0, 0.0), Vec3::new(0.0, 0.0, 1.0))
  assert_eq(m.determinant(), 1.0)
  let t = m.transpose()
  assert_eq(t.col0.x, 1.0)
  let mv = m.mul_vec3(Vec3::new(2.0, 3.0, 4.0))
  assert_eq(mv.z, 4.0)
  let mm = m.mul_mat3(m)
  assert_eq(mm.col0.x, 1.0)
  let inv = assert_some(m.inverse())
  let id = m.mul_mat3(inv)
  assert_eq(id.col0.x, 1.0)
  let zero = Mat3::from_cols(Vec3::new(0.0, 0.0, 0.0), Vec3::new(0.0, 0.0, 0.0), Vec3::new(0.0, 0.0, 0.0))
  assert_none(zero.inverse())
  let _i = Mat3::IDENTITY
  let _z = Mat3::ZERO
  let m3_from_m4 = Mat3::from_mat4(Mat4::IDENTITY)
  assert_eq(m3_from_m4.col0.x, 1.0)
end

@test
def test_linalg_mat4_surface() -> Unit
  let id = Mat4::IDENTITY
  assert_eq(id.determinant(), 1.0)
  let t = id.transpose()
  assert_eq(t.col0.x, 1.0)
  let mv = id.mul_vec4(Vec4::new(1.0, 2.0, 3.0, 4.0))
  assert_eq(mv.w, 4.0)
  let mm = id.mul_mat4(id)
  assert_eq(mm.col0.x, 1.0)
  let inv = assert_some(id.inverse())
  assert_eq(inv.col0.x, 1.0)
  let zero = Mat4::from_cols(Vec4::new(0.0, 0.0, 0.0, 0.0), Vec4::new(0.0, 0.0, 0.0, 0.0), Vec4::new(0.0, 0.0, 0.0, 0.0), Vec4::new(0.0, 0.0, 0.0, 0.0))
  assert_none(zero.inverse())
  let _z = Mat4::ZERO
  # the affine constructors
  let tr = Mat4::translation(Vec3::new(1.0, 2.0, 3.0))
  let tp = tr.get_translation()
  assert_eq(tp.x, 1.0)
  assert_eq(tp.z, 3.0)
  let sc = Mat4::scaling(Vec3::new(2.0, 3.0, 4.0))
  let sp = sc.get_scale()
  assert_eq(sp.y, 3.0)
  let rx = Mat4::rotation_x(0.0)
  assert_eq(rx.mul_vec4(Vec4::new(1.0, 0.0, 0.0, 1.0)).x, 1.0)
  let ry = Mat4::rotation_y(0.0)
  assert_eq(ry.mul_vec4(Vec4::new(0.0, 0.0, 1.0, 1.0)).z, 1.0)
  let rz = Mat4::rotation_z(0.0)
  assert_eq(rz.mul_vec4(Vec4::new(1.0, 0.0, 0.0, 1.0)).y, 0.0)
  let ra = Mat4::rotation_axis(Vec3::new(0.0, 0.0, 1.0), 0.0)
  assert_eq(ra.mul_vec4(Vec4::new(1.0, 0.0, 0.0, 1.0)).x, 1.0)
  let _per = Mat4::perspective(1.0, 1.5, 0.1, 100.0)
  let _per_gl = Mat4::perspective_gl(1.0, 1.5, 0.1, 100.0)
  let _ort = Mat4::ortho(-1.0, 1.0, -1.0, 1.0, 0.1, 100.0)
  let _lk = Mat4::look_at(Vec3::new(0.0, 0.0, 5.0), Vec3::new(0.0, 0.0, 0.0), Vec3::new(0.0, 1.0, 0.0))
  let cols = Mat4::from_cols(Vec4::new(1.0, 0.0, 0.0, 0.0), Vec4::new(0.0, 1.0, 0.0, 0.0), Vec4::new(0.0, 0.0, 1.0, 0.0), Vec4::new(0.0, 0.0, 0.0, 1.0))
  assert_eq(cols.col0.x, 1.0)
end

@test
def test_linalg_quat_surface() -> Unit
  let q = Quat::new(0.0, 0.0, 0.0, 1.0)
  let rv = q.rotate_vec3(Vec3::new(1.0, 0.0, 0.0))
  assert_eq(rv.x, 1.0)
  let c = q.conjugate()
  assert_eq(c.w, 1.0)
  let sl = q.slerp(q, 0.5)
  assert_eq(sl.w, 1.0)
  let m3 = q.to_mat3()
  assert_eq(m3.col0.x, 1.0)
  let m4 = q.to_mat4()
  assert_eq(m4.col0.x, 1.0)
  let (axis, ang) = q.to_axis_angle()
  let _ = axis
  assert_eq(ang, 0.0)
  let qa = Quat::from_axis_angle(Vec3::new(0.0, 0.0, 1.0), 0.0)
  assert_eq(qa.rotate_vec3(Vec3::new(1.0, 0.0, 0.0)).x, 1.0)
  let qe = Quat::from_euler(0.0, 0.0, 0.0)
  assert_eq(qe.rotate_vec3(Vec3::new(0.0, 1.0, 0.0)).y, 1.0)
  let qm = Quat::from_mat3(Mat3::IDENTITY)
  assert_eq(qm.w, 1.0)
  let _l = q.length()
  let _ls = q.length_squared()
  let _n = q.normalize()
  let _dd = q.dot(q)
  let _aa = q.angle_between(q)
end

@test
def test_linalg_transform_surface() -> Unit
  let t = Transform::new(Vec3::new(0.0, 0.0, 0.0), Quat::new(0.0, 0.0, 0.0, 1.0), Vec3::new(1.0, 1.0, 1.0))
  let m4 = t.to_mat4()
  assert_eq(m4.col0.x, 1.0)
  let tp = t.transform_point(Vec3::new(1.0, 2.0, 3.0))
  assert_eq(tp.x, 1.0)
  assert_eq(tp.z, 3.0)
  let td = t.transform_direction(Vec3::new(1.0, 0.0, 0.0))
  assert_eq(td.x, 1.0)
end
