# tests/unit/test_collections_clone_semantics.tg — the generic Clone
# contract for the runtime Map/Set stores (bootstrap P0 regression).
#
# The removed O(1) "pure-data" Clone fast path shared a Map/Set store
# whenever no runtime Ref(Region) ownership was found in its members.
# That heuristic says nothing about K::clone/V::clone/T::clone: a
# pure-data type can have a nontrivial custom Clone. Counter below is
# exactly that class (an Int-only field, no Ref(Region), so the old
# heuristic shared it) and its Clone is additive: clone({n}) = {n + 1}.
#
# The assertions are DISCRIMINATING, not count-independent:
#   0 clones  -> the clone reads 1   FAIL
#   1 clone   -> the clone reads 2   PASS
#   2 clones  -> the clone reads 3   FAIL
# so the tests prove the exact "every element cloned exactly once"
# contract on Map values, Map KEYS, and Set elements, while the original
# store keeps Counter{1} throughout.

use std::collections::{Map, Set}
use std::core::{Bool, Eq, Int, Option, String, Unit}
use std::hash::{Hash, Hasher}
use std::test::*

struct Counter
  value: Int
end

impl Clone for Counter
  def clone(self: Self) -> Counter
    Counter { value: self.value + 1 }
  end
end

impl Eq for Counter
  def eq(self: Self, other: Self) -> Bool
    self.value == other.value
  end
end

impl Hash for Counter
  def hash[H: Hasher](self: Counter, inout state: H) -> Unit
    state.write(&[(self.value & 0xFF) as u8])
  end
end

@test
def test_map_clone_invokes_each_value_clone_exactly_once() -> Unit
  var m: Map[String, Counter] = Map::new()
  m.insert("k".to_string(), Counter { value: 1 })
  let cloned = m.clone()
  match cloned.get("k".to_string())
  when Option::Some(v) then assert_eq(v.value, 2)
  when Option::None then assert_true(false)
  end
  match m.get("k".to_string())
  when Option::Some(v) then assert_eq(v.value, 1)
  when Option::None then assert_true(false)
  end
end

@test
def test_map_clone_invokes_each_key_clone_exactly_once() -> Unit
  var m: Map[Counter, String] = Map::new()
  m.insert(Counter { value: 10 }, "v".to_string())
  let cloned = m.clone()
  # the cloned map's key is Counter{11} — exactly one key clone
  assert_true(cloned.contains(Counter { value: 11 }))
  assert_true(!cloned.contains(Counter { value: 10 }))
  # the original key is untouched
  assert_true(m.contains(Counter { value: 10 }))
  assert_true(!m.contains(Counter { value: 11 }))
end

@test
def test_set_clone_invokes_each_element_clone_exactly_once() -> Unit
  var s: Set[Counter] = Set::new()
  s.insert(Counter { value: 1 })
  let cloned = s.clone()
  assert_eq(cloned.len(), 1)
  assert_true(cloned.contains(Counter { value: 2 }))
  assert_true(!cloned.contains(Counter { value: 1 }))
  assert_true(s.contains(Counter { value: 1 }))
  assert_true(!s.contains(Counter { value: 2 }))
end
