use std::taint
use std::core::{Vec, String, Unit}

test "Golden: Taint introduction and validation" do
  let raw = "untrusted".to_string()
  let t = std::taint::taint(raw, std::taint::TaintLabel::UserInput)
  
  let validator = std::taint::MaxLengthValidator { max_len: 10 }
  let res = std::taint::validate(&t, &validator)
  assert res.is_ok()
  assert res.unwrap() == "untrusted"
end

test "Oracle: Taint propagation through map" do
  let t1 = std::taint::taint(10, std::taint::TaintLabel::FfiInput)
  let t2 = std::taint::taint_map(&t1, |x| x * 2)
  assert t2.value == 20
  # Check label preserved
  assert t2.labels.contains(std::taint::TaintLabel::FfiInput)
end

test "Metamorphic: Taint label union" do
  let t1 = std::taint::taint(1, std::taint::TaintLabel::NetworkRead)
  let t2 = std::taint::taint(2, std::taint::TaintLabel::FileRead)
  
  let mut sources = Vec::new()
  sources.push(&t1)
  sources.push(&t2)
  
  let combined = std::taint::taint_merge(3, &sources)
  assert combined.labels.contains(std::taint::TaintLabel::NetworkRead)
  assert combined.labels.contains(std::taint::TaintLabel::FileRead)
end

test "Negative: Validation failure" do
  let t = std::taint::taint("too long string".to_string(), std::taint::TaintLabel::UserInput)
  let validator = std::taint::MaxLengthValidator { max_len: 5 }
  let res = std::taint::validate(&t, &validator)
  assert res.is_err()
end

test "Lifecycle: Static analysis data" do
  # Verify that the types used for static analysis are valid
  let source = std::taint::TaintSource {
    label: std::taint::TaintLabel::UserInput,
    span: std::taint::Span { start: 0, end_pos: 10 },
    symbol: "main".to_string()
  }
  assert source.symbol == "main"
end
