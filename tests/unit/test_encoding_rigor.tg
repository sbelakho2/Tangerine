use std::encoding
use std::core::{Vec, String, Unit}

test "Golden: Hex roundtrip" do
  let data = "hello".to_string().as_bytes()
  let encoded = std::encoding::hex_encode(data)
  assert encoded == "68656c6c6f"
  
  let decoded = std::encoding::hex_decode(&encoded).unwrap()
  assert decoded.len() == 5
  assert decoded.get(0) == 0x68
end

test "Oracle: Hex fixed values" do
  let data = [0x00u8, 0xffu8, 0x12u8, 0x34u8]
  let encoded = std::encoding::hex_encode(&data)
  assert encoded == "00ff1234"
end

test "Metamorphic: Case insensitivity in decode" do
  let s1 = "abcdef"
  let s2 = "ABCDEF"
  let d1 = std::encoding::hex_decode(s1).unwrap()
  let d2 = std::encoding::hex_decode(s2).unwrap()
  assert d1 == d2
end

test "Negative: Invalid hex length" do
  let res = std::encoding::hex_decode("abc")
  match res
  when Err(e) then
    assert e.code() == std::gfx_errors::ErrorCode::InvalidArg
  when Ok(_) then
    assert false
  end
end

test "Lifecycle: Empty input" do
  let encoded = std::encoding::hex_encode(&[])
  assert encoded == ""
  let decoded = std::encoding::hex_decode("").unwrap()
  assert decoded.len() == 0
end
