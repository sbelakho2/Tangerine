# tests/unit/test_encoding_rigor.tg — Known-value tests for std::encoding (hex)
# All round-trips assert full values, not lengths or prefixes.

use std::encoding
use std::gfx_errors
use std::test::*
use std::core::{Vec, String, Unit, Result}

@test
def test_hex_golden_roundtrip() -> Unit
  let data = "hello".to_string().as_bytes()
  let encoded = std::encoding::hex_encode(data)
  assert_eq(encoded, "68656c6c6f")

  let decoded = std::encoding::hex_decode(&encoded).unwrap()
  assert_eq(std::encoding::hex_encode(decoded.as_slice()), "68656c6c6f")
end

@test
def test_hex_fixed_values() -> Unit
  let data = [0x00u8, 0xffu8, 0x12u8, 0x34u8]
  let encoded = std::encoding::hex_encode(&data)
  assert_eq(encoded, "00ff1234")
  let decoded = std::encoding::hex_decode(&encoded).unwrap()
  assert_eq(std::encoding::hex_encode(decoded.as_slice()), "00ff1234")
end

@test
def test_hex_case_insensitive_decode() -> Unit
  let d1 = std::encoding::hex_decode("abcdef").unwrap()
  let d2 = std::encoding::hex_decode("ABCDEF").unwrap()
  assert_eq(std::encoding::hex_encode(d1.as_slice()), "abcdef")
  assert_eq(std::encoding::hex_encode(d2.as_slice()), "abcdef")
end

@test
def test_hex_negative_odd_length() -> Unit
  let res = std::encoding::hex_decode("abc")
  let is_invalid_arg = match res
  when Result::Err(e) then e.code() == std::gfx_errors::ErrorCode::InvalidArg
  when Result::Ok(_) then false
  end
  assert_true(is_invalid_arg)
end

@test
def test_hex_negative_invalid_digit() -> Unit
  let res = std::encoding::hex_decode("0g12")
  let is_err = match res
  when Result::Err(_) then true
  when Result::Ok(_) then false
  end
  assert_true(is_err)
end

@test
def test_hex_empty_input() -> Unit
  let encoded = std::encoding::hex_encode(&[])
  assert_eq(encoded, "")
  let decoded = std::encoding::hex_decode("").unwrap()
  assert_true(decoded.is_empty())
end
