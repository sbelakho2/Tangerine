# tests/unit/test_events.tg — Unit tests for event translation §21.1
use std::test::*
use std::app

# --- Event variant construction ---

@test
def test_keydown_event() -> Unit
  let evt = Event::KeyDown(Key::A, KeyMods { shift: false, ctrl: false, alt: false, meta: false })
  match evt
  when Event::KeyDown(key, mods)
    assert_eq(key, Key::A)
    assert_eq(mods.shift, false)
  else
    assert_false(true)
  end
end

@test
def test_keyup_event() -> Unit
  let evt = Event::KeyUp(Key::Escape, KeyMods { shift: false, ctrl: false, alt: false, meta: false })
  match evt
  when Event::KeyUp(key, _mods)
    assert_eq(key, Key::Escape)
  else
    assert_false(true)
  end
end

@test
def test_mousedown_event() -> Unit
  let evt = Event::MouseDown(MouseButton::Left, 100.0, 200.0)
  match evt
  when Event::MouseDown(btn, x, y)
    assert_eq(btn, MouseButton::Left)
    assert_eq(x, 100.0)
    assert_eq(y, 200.0)
  else
    assert_false(true)
  end
end

@test
def test_mousemove_event() -> Unit
  let evt = Event::MouseMove(50.0, 75.0)
  match evt
  when Event::MouseMove(x, y)
    assert_eq(x, 50.0)
    assert_eq(y, 75.0)
  else
    assert_false(true)
  end
end

@test
def test_scroll_event_discrete_mode() -> Unit
  let evt = Event::Scroll(0.0, -3.0, ScrollMode::Discrete)
  match evt
  when Event::Scroll(dx, dy, mode)
    assert_eq(dx, 0.0)
    assert_eq(dy, -3.0)
    assert_eq(mode, ScrollMode::Discrete)
  else
    assert_false(true)
  end
end

@test
def test_resize_event() -> Unit
  let evt = Event::Resize(800, 600)
  match evt
  when Event::Resize(w, h)
    assert_eq(w, 800)
    assert_eq(h, 600)
  else
    assert_false(true)
  end
end

@test
def test_textinput_event() -> Unit
  let evt = Event::TextInput("hello")
  match evt
  when Event::TextInput(txt)
    assert_eq(txt, "hello")
  else
    assert_false(true)
  end
end

# --- Key modifier combinations ---

@test
def test_keymods_shift_ctrl() -> Unit
  let mods = KeyMods { shift: true, ctrl: true, alt: false, meta: false }
  assert_true(mods.shift)
  assert_true(mods.ctrl)
  assert_false(mods.alt)
  assert_false(mods.meta)
end

@test
def test_key_enum_coverage() -> Unit
  # Verify all 19 key variants exist
  let keys = [
    Key::A, Key::B, Key::C, Key::D, Key::E, Key::F, Key::G,
    Key::H, Key::I, Key::J, Key::K, Key::L, Key::M, Key::N,
    Key::O, Key::P, Key::Q, Key::R, Key::S
  ]
  assert_eq(keys.len(), 19)
end

# --- Close, Focus, Redraw events ---

@test
def test_close_event() -> Unit
  let evt = Event::Close
  match evt
  when Event::Close
    assert_true(true)
  else
    assert_false(true)
  end
end

@test
def test_focus_event() -> Unit
  let evt = Event::Focus(true)
  match evt
  when Event::Focus(focused)
    assert_true(focused)
  else
    assert_false(true)
  end
end

@test
def test_redraw_event() -> Unit
  let evt = Event::Redraw
  match evt
  when Event::Redraw
    assert_true(true)
  else
    assert_false(true)
  end
end
