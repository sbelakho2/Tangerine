# tests/unit/test_events.tg — Unit tests for event translation §21.1
use std::test
use std::app

# --- Event variant construction ---

test "KeyDown event" do
  let evt = Event::KeyDown(Key::A, KeyMods { shift: false, ctrl: false, alt: false, meta: false })
  match evt
  when Event::KeyDown(key, mods)
    assert_eq(key, Key::A)
    assert_eq(mods.shift, false)
  else
    assert(false)
  end
end

test "KeyUp event" do
  let evt = Event::KeyUp(Key::Escape, KeyMods { shift: false, ctrl: false, alt: false, meta: false })
  match evt
  when Event::KeyUp(key, _mods)
    assert_eq(key, Key::Escape)
  else
    assert(false)
  end
end

test "MouseDown event" do
  let evt = Event::MouseDown(MouseButton::Left, 100.0, 200.0)
  match evt
  when Event::MouseDown(btn, x, y)
    assert_eq(btn, MouseButton::Left)
    assert_eq(x, 100.0)
    assert_eq(y, 200.0)
  else
    assert(false)
  end
end

test "MouseMove event" do
  let evt = Event::MouseMove(50.0, 75.0)
  match evt
  when Event::MouseMove(x, y)
    assert_eq(x, 50.0)
    assert_eq(y, 75.0)
  else
    assert(false)
  end
end

test "Scroll event discrete mode" do
  let evt = Event::Scroll(0.0, -3.0, ScrollMode::Discrete)
  match evt
  when Event::Scroll(dx, dy, mode)
    assert_eq(dx, 0.0)
    assert_eq(dy, -3.0)
    assert_eq(mode, ScrollMode::Discrete)
  else
    assert(false)
  end
end

test "Resize event" do
  let evt = Event::Resize(800, 600)
  match evt
  when Event::Resize(w, h)
    assert_eq(w, 800)
    assert_eq(h, 600)
  else
    assert(false)
  end
end

test "TextInput event" do
  let evt = Event::TextInput("hello")
  match evt
  when Event::TextInput(txt)
    assert_eq(txt, "hello")
  else
    assert(false)
  end
end

# --- Key modifier combinations ---

test "KeyMods shift+ctrl" do
  let mods = KeyMods { shift: true, ctrl: true, alt: false, meta: false }
  assert(mods.shift)
  assert(mods.ctrl)
  assert(!mods.alt)
  assert(!mods.meta)
end

test "Key enum coverage" do
  # Verify all 19 key variants exist
  let keys = [
    Key::A, Key::B, Key::C, Key::D, Key::E, Key::F, Key::G,
    Key::H, Key::I, Key::J, Key::K, Key::L, Key::M, Key::N,
    Key::O, Key::P, Key::Q, Key::R, Key::S
  ]
  assert_eq(keys.len(), 19)
end

# --- Close, Focus, Redraw events ---

test "Close event" do
  let evt = Event::Close
  match evt
  when Event::Close
    assert(true)
  else
    assert(false)
  end
end

test "Focus event" do
  let evt = Event::Focus(true)
  match evt
  when Event::Focus(focused)
    assert(focused)
  else
    assert(false)
  end
end

test "Redraw event" do
  let evt = Event::Redraw
  match evt
  when Event::Redraw
    assert(true)
  else
    assert(false)
  end
end
