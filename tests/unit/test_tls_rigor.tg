# TLS Rigor Tests
use std::tls::{TlsPolicy, TlsVersion}
use std::test::{assert_eq, assert_true}

test "Golden: Policy creation" do
  let p = TlsPolicy::default()
  assert p.verify_peer == true
  assert p.min_version == TlsVersion::Tls12
  
  let s = TlsPolicy::strict()
  assert s.min_version == TlsVersion::Tls13
  assert s.require_stapling == true
end

test "Negative: Handshake failure context" do
  # Simulation of connection to non-TLS port
  let stream_res = std::net::tcp_connect_host("google.com".to_string(), 80)
  if stream_res.is_ok() then
    let res = std::tls::connect(stream_res.unwrap(), "google.com".to_string(), TlsPolicy::default())
    # Should fail as port 80 is HTTP
    assert res.is_err()
  end
end
