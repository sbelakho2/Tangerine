# tests/unit/test_cbor_rigor.tg — the RFC 8949 vector suite (P1.8):
# the Appendix A vectors (definite AND indefinite-length forms) decode
# to the exact values; the indefinite forms (additional info 31 + the
# 0xFF break) round-trip; the strict decode rejects trailing data and a
# top-level break.

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec}
use std::test::*
use std::cbor::{cbor_decode, cbor_decode_strict, cbor_encode, cbor_value_eq, Value, CborError}

def hex_to_bytes(hex: str) -> Vec[u8]
  var out = Vec::new()
  var i = 0
  while i < hex.len() do
    let hi = hex_digit(hex.char_at(i))
    let lo = hex_digit(hex.char_at(i + 1))
    out.push(((hi * 16) + lo) as u8)
    i = i + 2
  end
  out
end

def hex_digit(c: Char) -> Int
  if c >= '0' && c <= '9' then
    (c as Int) - ('0' as Int)
  elsif c >= 'a' && c <= 'f' then
    (c as Int) - ('a' as Int) + 10
  elsif c >= 'A' && c <= 'F' then
    (c as Int) - ('A' as Int) + 10
  else
    0
  end
end

def assert_decodes(hex: str, expected: Value) -> Unit
  let bytes = hex_to_bytes(hex)
  let got = assert_ok(cbor_decode_strict(bytes))
  assert_true(cbor_value_eq(got, expected))
end

def bytes_of(items: [Int]) -> Vec[u8]
  var out = Vec::new()
  var i = 0
  while i < items.len() do
    out.push(items[i] as u8)
    i = i + 1
  end
  out
end

def vec_of_values(items: Vec[Value]) -> Vec[Value]
  items
end

@test
def test_cbor_rfc8949_definite_vectors() -> Unit
  assert_decodes("00", Value::UnsignedInt(0))
  assert_decodes("01", Value::UnsignedInt(1))
  assert_decodes("0A", Value::UnsignedInt(10))
  assert_decodes("17", Value::UnsignedInt(23))
  assert_decodes("1818", Value::UnsignedInt(24))
  assert_decodes("1864", Value::UnsignedInt(100))
  assert_decodes("1903E8", Value::UnsignedInt(1000))
  assert_decodes("1A000F4240", Value::UnsignedInt(1000000))
  assert_decodes("1B000000E8D4A51000", Value::UnsignedInt(1000000000000))
  assert_decodes("1BFFFFFFFFFFFFFFFF", Value::UnsignedInt(18446744073709551615))
  assert_decodes("20", Value::NegativeInt(-1))
  assert_decodes("21", Value::NegativeInt(-2))
  assert_decodes("3863", Value::NegativeInt(-100))
  assert_decodes("3903E7", Value::NegativeInt(-1000))
  assert_decodes("3BFFFFFFFFFFFFFFFF", Value::NegativeInt(-18446744073709551616))
end

@test
def test_cbor_rfc8949_string_array_map_vectors() -> Unit
  assert_decodes("4401020304", Value::ByteString(bytes_of([1, 2, 3, 4])))
  assert_decodes("60", Value::TextString("".to_string()))
  assert_decodes("6161", Value::TextString("a".to_string()))
  assert_decodes("6449455446", Value::TextString("IETF".to_string()))
  assert_decodes("62225C", Value::TextString("\"\\".to_string()))
  assert_decodes("62C3BC", Value::TextString("ü".to_string()))
  assert_decodes("63E6B0B4", Value::TextString("水".to_string()))
  assert_decodes("80", Value::Array(vec_of_values(Vec::new())))
  assert_decodes("83010203", Value::Array(vec_of_values(Vec::from([Value::UnsignedInt(1), Value::UnsignedInt(2), Value::UnsignedInt(3)]))))
  var nested = Vec::new()
  var two = Vec::new()
  two.push(Value::UnsignedInt(2))
  two.push(Value::UnsignedInt(3))
  var four_five = Vec::new()
  four_five.push(Value::UnsignedInt(4))
  four_five.push(Value::UnsignedInt(5))
  nested.push(Value::UnsignedInt(1))
  nested.push(Value::Array(two))
  nested.push(Value::Array(four_five))
  assert_decodes("8301820203820405", Value::Array(nested))
end

@test
def test_cbor_rfc8949_map_simple_float_vectors() -> Unit
  assert_decodes("A0", Value::Map(Vec::new()))
  assert_decodes("A201020304", Value::Map(Vec::from([
    (Value::UnsignedInt(1), Value::UnsignedInt(2)),
    (Value::UnsignedInt(3), Value::UnsignedInt(4))
  ])))
  assert_decodes("F4", Value::SimpleValue(20))
  assert_decodes("F5", Value::SimpleValue(21))
  assert_decodes("F6", Value::SimpleValue(22))
  assert_decodes("F7", Value::SimpleValue(23))
  assert_decodes("F0", Value::SimpleValue(16))
  assert_decodes("F818", Value::SimpleValue(24))
  assert_decodes("F90000", Value::Float16(0.0))
  assert_decodes("F9C400", Value::Float16(-4.0))
  assert_decodes("F93C00", Value::Float16(1.0))
  assert_decodes("FB3FF199999999999A", Value::Float64(1.1))
  assert_decodes("FBC010666666666666", Value::Float64(-4.1))
end

@test
def test_cbor_rfc8949_indefinite_vectors() -> Unit
  # The indefinite-length forms (RFC 8949 Appendix A): 0x5F/0x7F chunked
  # strings, 0x9F arrays, 0xBF maps, all terminated by the 0xFF break.
  assert_decodes("9FFF", Value::Array(Vec::new()))
  assert_decodes("5F42010243030405FF", Value::ByteString(bytes_of([1, 2, 3, 4, 5])))
  assert_decodes("7F657374726561646D696E67FF", Value::TextString("streaming".to_string()))
  assert_decodes("9F018202039F0405FFFF", Value::Array(_nested_1_2_3_4_5()))
  assert_decodes("83018202039F0405FF", Value::Array(_nested_1_2_3_4_5()))
  assert_decodes("83019F0203FF820405", Value::Array(_nested_1_2_3_4_5()))
  var fun_map = Vec::new()
  fun_map.push((Value::TextString("Fun".to_string()), Value::SimpleValue(21)))
  fun_map.push((Value::TextString("Amt".to_string()), Value::NegativeInt(-2)))
  assert_decodes("BF6346756EF563416D7421FF", Value::Map(fun_map))
  var b_map = Vec::new()
  b_map.push((Value::TextString("a".to_string()), Value::UnsignedInt(1)))
  var b_arr = Vec::new()
  b_arr.push(Value::UnsignedInt(2))
  b_arr.push(Value::UnsignedInt(3))
  b_map.push((Value::TextString("b".to_string()), Value::Array(b_arr)))
  assert_decodes("BF61610161629F0203FFFF", Value::Map(b_map))
end

def _nested_1_2_3_4_5() -> Vec[Value]
  var outer = Vec::new()
  var inner = Vec::new()
  inner.push(Value::UnsignedInt(2))
  inner.push(Value::UnsignedInt(3))
  var inner2 = Vec::new()
  inner2.push(Value::UnsignedInt(4))
  inner2.push(Value::UnsignedInt(5))
  outer.push(Value::UnsignedInt(1))
  outer.push(Value::Array(inner))
  outer.push(Value::Array(inner2))
  outer
end

@test
def test_cbor_indefinite_encode_round_trip() -> Unit
  var chunks = Vec::new()
  chunks.push(bytes_of([1, 2]))
  chunks.push(bytes_of([3, 4, 5]))
  var enc = std::cbor::encoder_new()
  enc.encode_indefinite_bytes(chunks)
  let enc_bytes = enc.into_bytes()
  # 0x5F 0x42 0102 0x43 030405 0xFF
  assert_eq(enc_bytes.len(), 8)
  assert_eq(enc_bytes[0], 0x5F as u8)
  assert_eq(enc_bytes[7], 0xFF as u8)
  let back = assert_ok(cbor_decode_strict(enc_bytes))
  assert_true(cbor_value_eq(back, Value::ByteString(bytes_of([1, 2, 3, 4, 5]))))

  var text_chunks = Vec::new()
  text_chunks.push("stre".to_string())
  text_chunks.push("aming".to_string())
  var enc2 = std::cbor::encoder_new()
  enc2.encode_indefinite_text(text_chunks)
  let back2 = assert_ok(cbor_decode_strict(enc2.into_bytes()))
  assert_true(cbor_value_eq(back2, Value::TextString("streaming".to_string())))

  var items = Vec::new()
  items.push(Value::UnsignedInt(1))
  items.push(Value::UnsignedInt(2))
  var enc3 = std::cbor::encoder_new()
  enc3.encode_indefinite_array(items)
  let back3 = assert_ok(cbor_decode_strict(enc3.into_bytes()))
  assert_true(cbor_value_eq(back3, Value::Array(Vec::from([Value::UnsignedInt(1), Value::UnsignedInt(2)]))))
end

@test
def test_cbor_definite_indefinite_value_equivalence() -> Unit
  # The decoded VALUE of an indefinite form equals the decoded value of
  # the equivalent definite form (the length form is not part of the
  # value per RFC 8949).
  let indefinite = assert_ok(cbor_decode_strict(hex_to_bytes("9F010203FF")))
  let definite = assert_ok(cbor_decode_strict(hex_to_bytes("83010203")))
  assert_true(cbor_value_eq(indefinite, definite))
end

@test
def test_cbor_encode_decode_round_trip() -> Unit
  var m = Vec::new()
  m.push((Value::TextString("k".to_string()), Value::UnsignedInt(1)))
  let v = Value::Map(m)
  let encoded = cbor_encode(v)
  let back = assert_ok(cbor_decode_strict(encoded))
  assert_true(cbor_value_eq(back, v))
end

@test
def test_cbor_strict_rejects_trailing_data_and_top_level_break() -> Unit
  # decode (non-strict) allows trailing data; decode_strict rejects it.
  let loose = assert_ok(cbor_decode(hex_to_bytes("0102")))
  assert_true(cbor_value_eq(loose, Value::UnsignedInt(1)))
  let strict = cbor_decode_strict(hex_to_bytes("0102"))
  match strict
  when Result::Ok(_) then assert false
  when Result::Err(e) then
    match e
    when CborError::TrailingData then ()
    when _ then assert false
    end
  end
  # The 0xFF break outside any indefinite-length context is an error.
  let brk = cbor_decode_strict(hex_to_bytes("FF"))
  match brk
  when Result::Ok(_) then assert false
  when Result::Err(e) then
    match e
    when CborError::UnexpectedBreak then ()
    when _ then assert false
    end
  end
  # A text-string indefinite form with an invalid chunk is an error.
  let bad_chunk = cbor_decode_strict(hex_to_bytes("7F0102FF"))
  match bad_chunk
  when Result::Ok(_) then assert false
  when Result::Err(e) then
    match e
    when CborError::InvalidIndefiniteChunk then ()
    when _ then assert false
    end
  end
end
