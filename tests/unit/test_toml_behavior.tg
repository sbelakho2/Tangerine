# tests/unit/test_toml_behavior.tg — the per-callable behavior suite
# for std::toml (the API manifest's uncovered callables, driven to
# real semantics: inputs -> expected outputs; the failure paths -> the
# expected failures).

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec, Map}
use std::test::*
use std::toml::*

@test
def test_toml_parser_scanner_surface() -> Unit
  var p = TomlParser::new("  key = 1")
  assert_eq(assert_some(p.peek()), ' ')
  p.skip_ws()
  assert_eq(assert_some(p.peek()), 'k')
  p.skip_ws_and_newlines()
  assert_true(p.matches("key"))
  assert_eq(assert_some(p.peek_n(1)), 'e')
  assert_eq(assert_some(p.advance()), 'k')
  assert_eq(assert_some(p.advance()), 'e')
  assert_ok(p.expect_char('y'))
  assert_err(p.expect_char('z'))
  var pe = TomlParser::new("")
  assert_none(pe.advance())
end

@test
def test_toml_parser_token_surface() -> Unit
  # parse_key: the bare form + the quoted form
  var p1 = TomlParser::new("bare_key = 1")
  assert_eq(assert_ok(p1.parse_key()), "bare_key")
  var p2 = TomlParser::new("\"quoted key\" = 1")
  assert_eq(assert_ok(p2.parse_key()), "quoted key")
  # parse_bare_key: the success + the error path
  var p3 = TomlParser::new("bare = 1")
  assert_eq(assert_ok(p3.parse_bare_key()), "bare")
  var p4 = TomlParser::new("= 1")
  assert_err(p4.parse_bare_key())
  # parse_key_path
  var p5 = TomlParser::new("a.b.c = 1")
  let path = assert_ok(p5.parse_key_path())
  assert_eq(path.len(), 3)
  # parse_basic_string: the escapes + the error path
  var p6 = TomlParser::new("\"hello\\nworld\"")
  assert_eq(assert_ok(p6.parse_basic_string()), "hello\nworld")
  var p7 = TomlParser::new("\"unterminated")
  assert_err(p7.parse_basic_string())
  # parse_literal_string
  var p8 = TomlParser::new("'literal'")
  assert_eq(assert_ok(p8.parse_literal_string()), "literal")
  # parse_unicode_escape
  var p9 = TomlParser::new("u0041")
  assert_eq(assert_ok(p9.parse_unicode_escape(4)), 0x41 as UInt)
  # parse_int_simple + the digit helpers
  assert_eq(assert_some(parse_int_simple("123".to_string())), 123)
  assert_eq(assert_some(parse_int_simple("-7".to_string())), -7)
  assert_none(parse_int_simple("abc".to_string()))
  assert_eq(parse_nanoseconds("123456789"), 123456789)
  assert_eq(format_int_pad(7, 3), "007")
  assert_eq(format_hex4(0x41 as UInt), "0041")
  assert_true(is_bare_key_char('a'))
  assert_true(is_bare_key_char('9'))
  assert_false(is_bare_key_char(' '))
  assert_false(is_bare_key_char('.'))
end

@test
def test_toml_parser_value_surface() -> Unit
  # parse_bool
  var p1 = TomlParser::new("true")
  match assert_ok(p1.parse_bool())
  when TomlValue::Boolean(b) then assert_true(b)
  when _ then assert_false(true)
  end
  var p2 = TomlParser::new("false")
  match assert_ok(p2.parse_bool())
  when TomlValue::Boolean(b) then assert_false(b)
  when _ then assert_false(true)
  end
  # parse_value: the scalar forms
  var p3 = TomlParser::new("42")
  match assert_ok(p3.parse_value())
  when TomlValue::Integer(i) then assert_eq(i, 42)
  when _ then assert_false(true)
  end
  var p4 = TomlParser::new("3.5")
  match assert_ok(p4.parse_value())
  when TomlValue::Float(f) then assert_eq(f, 3.5)
  when _ then assert_false(true)
  end
  # parse_number_or_datetime: the int path
  var p5 = TomlParser::new("17")
  match assert_ok(p5.parse_number_or_datetime())
  when TomlValue::Integer(i) then assert_eq(i, 17)
  when _ then assert_false(true)
  end
  # parse_int_value / parse_float_value
  var p6 = TomlParser::new("x")
  match assert_ok(p6.parse_int_value("255".to_string()))
  when TomlValue::Integer(i) then assert_eq(i, 255)
  when _ then assert_false(true)
  end
  var p7 = TomlParser::new("x")
  match assert_ok(p7.parse_float_value("2.25".to_string()))
  when TomlValue::Float(f) then assert_eq(f, 2.25)
  when _ then assert_false(true)
  end
  # parse_array: the success + the error path
  var p8 = TomlParser::new("[1, 2, 3]")
  match assert_ok(p8.parse_array())
  when TomlValue::Array(a) then assert_eq(a.len(), 3)
  when _ then assert_false(true)
  end
  var p9 = TomlParser::new("[1, 2")
  assert_err(p9.parse_array())
  # parse_inline_table
  var pa = TomlParser::new("{ a = 1 }")
  match assert_ok(pa.parse_inline_table())
  when TomlValue::Table(t) then assert_eq(t.len(), 1)
  when _ then assert_false(true)
  end
  # parse_datetime_value
  var pb = TomlParser::new("x")
  match assert_ok(pb.parse_datetime_value("1979-05-27T07:32:00Z".to_string()))
  when TomlValue::DateTime(_) then ()
  when _ then assert_false(true)
  end
  # the date/time component parsers
  var pc = TomlParser::new("x")
  let date = assert_ok(pc.parse_date_part("1979-05-27".to_string()))
  let _ = date
  let t = assert_ok(pc.parse_time_part("07:32:00".to_string()))
  let _ = t
  let (tw, off) = assert_ok(pc.parse_time_with_offset("07:32:00Z".to_string()))
  let _ = tw
  assert_some(off)
  let off2 = assert_ok(pc.parse_offset("07:00".to_string(), false))
  let _ = off2
  var pd = TomlParser::new("x")
  assert_err(pd.parse_date_part("not-a-date".to_string()))
end

@test
def test_toml_parser_table_paths() -> Unit
  var root: Map[String, TomlValue] = Map::new()
  var p = TomlParser::new("x")
  var segs: Vec[String] = Vec::new()
  let _ = segs.push("t".to_string())
  assert_ok(p.ensure_table_path(&mut root, segs, false))
  var root2: Map[String, TomlValue] = Map::new()
  var key_path: Vec[String] = Vec::new()
  let _ = key_path.push("k".to_string())
  assert_ok(p.insert_value(&mut root2, key_path, "k".to_string(), TomlValue::Integer(9)))
  var root3: Map[String, TomlValue] = Map::new()
  var table_path: Vec[String] = Vec::new()
  let _ = table_path.push("t".to_string())
  var key_path2: Vec[String] = Vec::new()
  let _ = key_path2.push("k".to_string())
  assert_ok(p.insert_value_path(&mut root3, table_path, key_path2, TomlValue::Integer(1)))
  assert_eq(root3.len(), 1)
end

@test
def test_toml_stringifier_surface() -> Unit
  var s = TomlStringifier::new()
  s.write_key("name".to_string())
  s.write_string("value".to_string())
  var s2 = TomlStringifier::new()
  s2.write_inline_value(TomlValue::Integer(5))
  var s3 = TomlStringifier::new()
  var tbl: Map[String, TomlValue] = Map::new()
  tbl.insert("a".to_string(), TomlValue::Integer(1))
  s3.write_value(TomlValue::Table(tbl), "".to_string())
  let out = s3.finish()
  assert_true(out.contains("a = 1"))
  # write_datetime over a parsed datetime
  var pd = TomlParser::new("x")
  let dt = assert_ok(pd.parse_datetime_value("1979-05-27T07:32:00Z".to_string()))
  match dt
  when TomlValue::DateTime(dtv) then
    var s4 = TomlStringifier::new()
    s4.write_datetime(dtv)
    assert_true(s4.finish().contains("1979"))
  when _ then assert_false(true)
  end
  # write_table over the parsed document
  let parsed = assert_ok(parse("a = 1\nb = \"x\"\n".to_string()))
  var s5 = TomlStringifier::new()
  s5.write_table(assert_some(toml_value_as_table(parsed)), "".to_string())
  assert_true(s5.finish().contains("a = 1"))
end

@test
def test_toml_value_accessors() -> Unit
  let parsed = assert_ok(parse("s = \"hi\"\ni = 5\nf = 1.5\nb = true\na = [1, 2]\nt = { x = 1 }\n".to_string()))
  assert_eq(assert_some(toml_value_as_str(assert_some(toml_value_get(parsed.clone(), "s")))), "hi")
  assert_eq(assert_some(toml_value_as_int(assert_some(toml_value_get(parsed.clone(), "i")))), 5)
  assert_eq(assert_some(toml_value_as_float(assert_some(toml_value_get(parsed.clone(), "f")))), 1.5)
  assert_true(assert_some(toml_value_as_bool(assert_some(toml_value_get(parsed.clone(), "b")))))
  assert_eq(assert_some(toml_value_as_array(assert_some(toml_value_get(parsed.clone(), "a")))).len(), 2)
  assert_eq(assert_some(toml_value_as_table(assert_some(toml_value_get(parsed.clone(), "t")))).len(), 1)
  assert_none(toml_value_get(parsed.clone(), "missing"))
  # toml_to_value / toml_from_value round trip
  let value = toml_to_value(assert_some(toml_value_get(parsed.clone(), "i")))
  let back = toml_from_value(value)
  match back
  when TomlValue::Integer(i) then assert_eq(i, 5)
  when _ then assert_false(true)
  end
  # to_toml / from_toml round trips
  let enc = assert_ok(to_toml(7 as i64))
  assert_true(enc.len() > 0)
  let dec: i64 = assert_ok(from_toml("7".to_string()))
  assert_eq(dec, 7)
  # stringify: the value text form
  let st = stringify(assert_some(toml_value_get(parsed.clone(), "i")))
  assert_eq(st, "5")
  let enc2 = assert_ok(to_toml("txt".to_string()))
  let dec2: String = assert_ok(from_toml(enc2))
  assert_eq(dec2, "txt")
  # datetime_to_string round trip
  var pd = TomlParser::new("x")
  let dtv = assert_ok(pd.parse_datetime_value("1979-05-27T07:32:00Z".to_string()))
  match dtv
  when TomlValue::DateTime(dtv2) then
    assert_eq(datetime_to_string(dtv2), "1979-05-27T07:32:00Z")
  when _ then assert_false(true)
  end
  # the error surface
  let bad = assert_err(parse("x = [1, 2".to_string()))
  assert_true(toml_error_message(bad).len() > 0)
  # the value clone
  let v = assert_some(toml_value_get(parsed.clone(), "s"))
  let c = v.clone()
  match c
  when TomlValue::String(sv) then assert_eq(sv, "hi")
  when _ then assert_false(true)
  end
end
