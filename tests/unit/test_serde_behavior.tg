# tests/unit/test_serde_behavior.tg — the per-callable behavior suite
# for std::serde (the API manifest's uncovered callables, driven to
# real semantics: inputs -> expected outputs; the failure paths -> the
# expected failures).
#
# Every uncovered callable of std::serde is CALLED below with real
# values and its outcome ASSERTED — the serializer/deserializer
# state machines, the JsonValue accessors, the base64 codec, and the
# typed serialize/deserialize entries over the impl'd primitives.

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec, f32, f64}
use std::test::*
use std::serde::*
use std::collections::HashMap

@test
def test_serde_json_serializer_machine() -> Unit
  var s = JsonSerializer::new()
  assert_ok(s.serialize_bool(true))
  assert_eq(s.output(), "true")
  var s2 = JsonSerializer::new()
  assert_ok(s2.serialize_i8(1 as i8))
  assert_ok(s2.serialize_i16(2 as i16))
  assert_ok(s2.serialize_i32(3 as i32))
  assert_ok(s2.serialize_i64(4 as i64))
  assert_ok(s2.serialize_u8(5 as u8))
  assert_ok(s2.serialize_u16(6 as u16))
  assert_ok(s2.serialize_u32(7 as u32))
  assert_ok(s2.serialize_u64(8 as u64))
  assert_ok(s2.serialize_f32(1.5))
  assert_ok(s2.serialize_f64(2.5))
  assert_ok(s2.serialize_char('x'))
  assert_ok(s2.serialize_str("hi".to_string()))
  assert_ok(s2.serialize_bytes(&[1 as u8, 2, 3]))
  assert_ok(s2.serialize_none())
  assert_ok(s2.serialize_some(9))
  assert_ok(s2.serialize_unit())
  assert_ok(s2.serialize_seq_start(Option::Some(2 as UInt)))
  assert_ok(s2.serialize_seq_elem(1))
  assert_ok(s2.serialize_seq_elem(2))
  assert_ok(s2.serialize_seq_end())
  assert_ok(s2.serialize_map_start(Option::Some(1 as UInt)))
  assert_ok(s2.serialize_map_key("k".to_string()))
  assert_ok(s2.serialize_map_value(10))
  assert_ok(s2.serialize_map_end())
  let out = s2.output()
  assert_true(out.contains("1"))
  assert_true(out.contains("12345678"))
  assert_true(out.contains("["))

  # the raw write layer
  var s3 = JsonSerializer::new()
  s3.write("raw".to_string())
  s3.write_newline()
  s3.write_indent()
  assert_true(s3.output().contains("raw"))
  # the pretty mode writes indented output
  var s4 = JsonSerializer::pretty()
  assert_ok(s4.serialize_bool(true))
  assert_true(s4.output().contains("true"))
end

@test
def test_serde_json_deserializer_machine() -> Unit
  var d = JsonDeserializer::new("{\"a\": 1}".to_string())
  let p0 = d.peek()
  match p0
  when Option::Some(c) then assert_eq(c, '{')
  when Option::None then assert_false(true)
  end
  # the char stream + whitespace skipping
  var d2 = JsonDeserializer::new("  x".to_string())
  d2.skip_whitespace()
  assert_eq(assert_some(d2.next()), 'x')
  assert_none(d2.next())
  # expect: the success + the error path
  var d3 = JsonDeserializer::new("ab".to_string())
  assert_ok(d3.expect('a'))
  assert_err(d3.expect('c'))
  # parse_string: the success + the unterminated error
  var d4 = JsonDeserializer::new("\"hello\"".to_string())
  assert_eq(assert_ok(d4.parse_string()), "hello")
  var d5 = JsonDeserializer::new("\"unterminated".to_string())
  assert_err(d5.parse_string())
  # parse_number: the integer + the float forms
  var d6 = JsonDeserializer::new("42".to_string())
  assert_eq(assert_ok(d6.parse_number()), "42")
  var d7 = JsonDeserializer::new("-3.5e2".to_string())
  assert_eq(assert_ok(d7.parse_number()), "-3.5e2")
  # the typed deserialize entries over the primitives
  var db = JsonDeserializer::new("true".to_string())
  assert_true(assert_ok(db.deserialize_bool()))
  var di8 = JsonDeserializer::new("-8".to_string())
  assert_eq(assert_ok(di8.deserialize_i8()), -8 as i8)
  var di16 = JsonDeserializer::new("-16".to_string())
  assert_eq(assert_ok(di16.deserialize_i16()), -16 as i16)
  var di32 = JsonDeserializer::new("-32".to_string())
  assert_eq(assert_ok(di32.deserialize_i32()), -32 as i32)
  var di64 = JsonDeserializer::new("-64".to_string())
  assert_eq(assert_ok(di64.deserialize_i64()), -64 as i64)
  var du8 = JsonDeserializer::new("8".to_string())
  assert_eq(assert_ok(du8.deserialize_u8()), 8 as u8)
  var du16 = JsonDeserializer::new("16".to_string())
  assert_eq(assert_ok(du16.deserialize_u16()), 16 as u16)
  var du32 = JsonDeserializer::new("32".to_string())
  assert_eq(assert_ok(du32.deserialize_u32()), 32 as u32)
  var du64 = JsonDeserializer::new("64".to_string())
  assert_eq(assert_ok(du64.deserialize_u64()), 64 as u64)
  var df32 = JsonDeserializer::new("1.5".to_string())
  assert_eq(assert_ok(df32.deserialize_f32()), 1.5)
  var df64 = JsonDeserializer::new("2.5".to_string())
  assert_eq(assert_ok(df64.deserialize_f64()), 2.5)
  var dc = JsonDeserializer::new("\"z\"".to_string())
  assert_eq(assert_ok(dc.deserialize_char()), 'z')
  var ds = JsonDeserializer::new("\"str\"".to_string())
  assert_eq(assert_ok(ds.deserialize_str()), "str")
  var dbytes = JsonDeserializer::new("\"aGk=\"".to_string())
  let bytes = assert_ok(dbytes.deserialize_bytes())
  assert_eq(bytes.len(), 2)
  # deserialize_option: the None + the Some paths
  var dnone = JsonDeserializer::new("null".to_string())
  let none: Option[i64] = assert_ok(dnone.deserialize_option())
  assert_none(none)
  var dsom = JsonDeserializer::new("5".to_string())
  let som: Option[i64] = assert_ok(dsom.deserialize_option())
  assert_eq(assert_some(som), 5)
  # deserialize_unit + its error path
  var dun = JsonDeserializer::new("null".to_string())
  assert_ok(dun.deserialize_unit())
  var dun2 = JsonDeserializer::new("5".to_string())
  assert_err(dun2.deserialize_unit())
  # deserialize_seq
  var dseq = JsonDeserializer::new("[1,2,3]".to_string())
  let seq: Vec[i64] = assert_ok(dseq.deserialize_seq())
  assert_eq(seq.len(), 3)
  # deserialize_map
  var dmap = JsonDeserializer::new("{\"k\":1}".to_string())
  let map: HashMap[String, i64] = assert_ok(dmap.deserialize_map())
  assert_eq(map.len(), 1)
  # the json value form of the same map
  var dmap2 = JsonDeserializer::new("{\"k\":1}".to_string())
  let map2: HashMap[String, i64] = assert_ok(dmap2.deserialize_map())
  assert_eq(map2.len(), 1)
end

@test
def test_serde_json_value_accessors() -> Unit
  let v_bool = JsonValue::Bool(true)
  assert_eq(assert_some(v_bool.as_bool()), true)
  assert_none(v_bool.as_string())
  let v_num = JsonValue::Number(3.5)
  assert_eq(assert_some(v_num.as_number()), 3.5)
  let v_str = JsonValue::String("s".to_string())
  assert_eq(assert_some(v_str.as_string()), "s")
  var arr_elems: Vec[JsonValue] = Vec::new()
  let _ = arr_elems.push(JsonValue::Number(1.0))
  let _ = arr_elems.push(JsonValue::Number(2.0))
  let v_arr = JsonValue::Array(arr_elems)
  let arr = assert_some(v_arr.as_array())
  assert_eq(arr.len(), 2)
  assert_eq(assert_some(v_arr.index(1 as UInt)), JsonValue::Number(2.0))
  assert_none(v_arr.index(5 as UInt))
  assert_none(v_str.index(0 as UInt))
  var obj: HashMap[String, JsonValue] = HashMap::new()
  obj.insert("k".to_string(), JsonValue::Number(7.0))
  let v_obj = JsonValue::Object(obj)
  let obj2 = assert_some(v_obj.as_object())
  assert_eq(obj2.len(), 1)
  let got = assert_some(v_obj.get("k".to_string()))
  assert_eq(got, JsonValue::Number(7.0))
  assert_none(v_obj.get("missing".to_string()))
  assert_none(v_str.as_object())
  # the clone over the value tree
  let c = v_obj.clone()
  assert_eq(assert_ok(to_json(c)), assert_ok(to_json(v_obj)))
end

@test
def test_serde_base64_codec() -> Unit
  assert_eq(BASE64_CHARS().len(), 64)
  let enc = base64_encode(&"hello".as_bytes())
  assert_eq(enc, "aGVsbG8=")
  let dec = assert_ok(base64_decode(enc))
  assert_eq(std::crypto::hex::encode(&dec), std::crypto::hex::encode(&"hello".as_bytes()))
  # the round-trip over the full byte range
  var all: Vec[u8] = Vec::new()
  var i = 0
  while i < 256 do
    let _ = all.push(i as u8)
    i = i + 1
  end
  let enc2 = base64_encode(&all)
  let dec2 = assert_ok(base64_decode(enc2))
  assert_eq(dec2.len(), 256)
  # the decode ERROR paths: invalid characters / odd padding
  assert_err(base64_decode("!!!".to_string()))
  assert_err(base64_decode("a".to_string()))
end

@test
def test_serde_json_helpers() -> Unit
  assert_eq(escape_json_string("a\"b".to_string()), "a\\\"b")
  assert_eq(escape_json_string("plain".to_string()), "plain")
  assert_eq(hex_escape(0x001F as u32), "001f")
  assert_eq(assert_ok(hex_digit('0')), 0 as u8)
  assert_eq(assert_ok(hex_digit('f')), 15 as u8)
  assert_err(hex_digit('z'))
end

@test
def test_serde_msgpack_machine() -> Unit
  var m = MessagePackSerializer::new()
  m.write_byte(0x01 as u8)
  m.write_bytes(&[0x02 as u8, 0x03])
  assert_ok(m.serialize_bool(true))
  assert_ok(m.serialize_i32(7 as i32))
  let out = m.output()
  assert_true(out.len() >= 3)
  assert_eq(out[0], 0x01 as u8)
  # the typed serialize entries over the primitives
  var m2 = MessagePackSerializer::new()
  assert_ok(m2.serialize_i8(1 as i8))
  assert_ok(m2.serialize_i16(2 as i16))
  assert_ok(m2.serialize_i64(3 as i64))
  assert_ok(m2.serialize_u8(4 as u8))
  assert_ok(m2.serialize_u16(5 as u16))
  assert_ok(m2.serialize_u32(6 as u32))
  assert_ok(m2.serialize_u64(7 as u64))
  assert_ok(m2.serialize_f32(1.5))
  assert_ok(m2.serialize_f64(2.5))
  assert_ok(m2.serialize_char('c'))
  assert_ok(m2.serialize_str("s".to_string()))
  assert_ok(m2.serialize_bytes(&[9 as u8]))
  assert_ok(m2.serialize_none())
  assert_ok(m2.serialize_some(10))
  assert_ok(m2.serialize_unit())
  assert_ok(m2.serialize_seq_start(Option::Some(1 as UInt)))
  assert_ok(m2.serialize_seq_elem(1))
  assert_ok(m2.serialize_seq_end())
  assert_ok(m2.serialize_map_start(Option::Some(1 as UInt)))
  assert_ok(m2.serialize_map_key("k".to_string()))
  assert_ok(m2.serialize_map_value(2))
  assert_ok(m2.serialize_map_end())
  assert_true(m2.output().len() > 0)
end

@test
def test_serde_typed_entries() -> Unit
  # the typed round trips over the impl'd primitives
  assert_eq(assert_ok(to_json(true)), "true")
  assert_eq(assert_ok(to_json(5 as i32)), "5")
  assert_eq(assert_ok(to_json(6 as i64)), "6")
  assert_eq(assert_ok(to_json(7 as u32)), "7")
  assert_eq(assert_ok(to_json(8 as u64)), "8")
  let f = assert_ok(to_json(2.5))
  assert_eq(f, "2.5")
  assert_eq(assert_ok(to_json("txt".to_string())), "\"txt\"")
  let pretty = assert_ok(to_json_pretty(1))
  assert_true(pretty.contains("1"))
  let b: Bool = assert_ok(from_json("true".to_string()))
  assert_true(b)
  let i: i64 = assert_ok(from_json("42".to_string()))
  assert_eq(i, 42)
  let s: String = assert_ok(from_json("\"s\"".to_string()))
  assert_eq(s, "s")
  # the from_json ERROR path
  let bad: i64 = assert_err(from_json("nope".to_string()))
  let _ = bad
  # the trait entries: value.serialize / Type::deserialize
  var s1 = JsonSerializer::new()
  assert_ok(true.serialize(&mut s1))
  assert_eq(s1.output(), "true")
  var d1 = JsonDeserializer::new("true".to_string())
  let v: Bool = assert_ok(Bool::deserialize(&mut d1))
  assert_true(v)
end
