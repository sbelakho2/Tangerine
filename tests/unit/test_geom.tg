# tests/unit/test_geom.tg — Unit tests for geometry math §21.1
use std::test
use std::geom

# --- Vec2 tests ---

test "Vec2 addition" do
  let a = Vec2 { x: 1.0, y: 2.0 }
  let b = Vec2 { x: 3.0, y: 4.0 }
  let c = Vec2 { x: a.x + b.x, y: a.y + b.y }
  assert_eq(c.x, 4.0)
  assert_eq(c.y, 6.0)
end

test "Vec2 zero" do
  let z = Vec2 { x: 0.0, y: 0.0 }
  assert_eq(z.x, 0.0)
  assert_eq(z.y, 0.0)
end

# --- Vec3 tests ---

test "Vec3 construction" do
  let v = Vec3 { x: 1.0, y: 2.0, z: 3.0 }
  assert_eq(v.z, 3.0)
end

# --- Rect tests ---

test "Rect contains point" do
  let r = Rect { x: 10.0, y: 10.0, w: 100.0, h: 50.0 }
  # Point inside
  assert(r.x <= 50.0 && 50.0 <= r.x + r.w)
  assert(r.y <= 30.0 && 30.0 <= r.y + r.h)
  # Point outside
  assert(!(r.x <= 200.0 && 200.0 <= r.x + r.w))
end

test "Rect zero size is valid" do
  let r = Rect { x: 5.0, y: 5.0, w: 0.0, h: 0.0 }
  assert_eq(r.w, 0.0)
  assert_eq(r.h, 0.0)
end

test "Rect intersection" do
  let a = Rect { x: 0.0, y: 0.0, w: 100.0, h: 100.0 }
  let b = Rect { x: 50.0, y: 50.0, w: 100.0, h: 100.0 }
  let ix = if a.x > b.x then a.x else b.x end
  let iy = if a.y > b.y then a.y else b.y end
  let ax2 = a.x + a.w
  let bx2 = b.x + b.w
  let iw = (if ax2 < bx2 then ax2 else bx2 end) - ix
  let ay2 = a.y + a.h
  let by2 = b.y + b.h
  let ih = (if ay2 < by2 then ay2 else by2 end) - iy
  assert(iw > 0.0)
  assert(ih > 0.0)
  assert_eq(ix, 50.0)
  assert_eq(iy, 50.0)
  assert_eq(iw, 50.0)
  assert_eq(ih, 50.0)
end

# --- RRect tests ---

test "RRect corner radius clamping" do
  let rr = RRect { x: 0.0, y: 0.0, w: 20.0, h: 20.0, rx: 50.0, ry: 50.0 }
  # Corner radius should not exceed half dimensions
  let max_rx = rr.w / 2.0
  let max_ry = rr.h / 2.0
  let clamped_rx = if rr.rx > max_rx then max_rx else rr.rx end
  let clamped_ry = if rr.ry > max_ry then max_ry else rr.ry end
  assert_eq(clamped_rx, 10.0)
  assert_eq(clamped_ry, 10.0)
end

# --- Color tests ---

test "Color f32 range" do
  let c = Color { r: 1.0, g: 0.5, b: 0.0, a: 1.0 }
  assert(c.r >= 0.0 && c.r <= 1.0)
  assert(c.g >= 0.0 && c.g <= 1.0)
  assert(c.b >= 0.0 && c.b <= 1.0)
  assert(c.a >= 0.0 && c.a <= 1.0)
end

test "Color transparent" do
  let c = Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
  assert_eq(c.a, 0.0)
end

# --- Transform2D tests ---

test "Transform2D identity" do
  let t = geom::transform_identity()
  assert_eq(t.m11, 1.0)
  assert_eq(t.m12, 0.0)
  assert_eq(t.m21, 0.0)
  assert_eq(t.m22, 1.0)
  assert_eq(t.tx, 0.0)
  assert_eq(t.ty, 0.0)
end

test "Transform2D translate" do
  let t = geom::transform_translate(10.0, 20.0)
  assert_eq(t.tx, 10.0)
  assert_eq(t.ty, 20.0)
  assert_eq(t.m11, 1.0)
end

test "Transform2D scale" do
  let t = geom::transform_scale(2.0, 3.0)
  assert_eq(t.m11, 2.0)
  assert_eq(t.m22, 3.0)
  assert_eq(t.tx, 0.0)
end

# --- Path tests ---

test "Path creation" do
  let p = geom::path_new()
  # Path is an opaque handle; just verify it was created
  assert(p._opaque != 0u64)
end

# --- Edge cases ---

test "Rect negative dimensions treated as zero" do
  let r = Rect { x: 0.0, y: 0.0, w: -10.0, h: -5.0 }
  let w = if r.w < 0.0 then 0.0 else r.w end
  let h = if r.h < 0.0 then 0.0 else r.h end
  assert_eq(w, 0.0)
  assert_eq(h, 0.0)
end

test "Transform multiply identity preserves" do
  let a = geom::transform_identity()
  let b = geom::transform_translate(5.0, 10.0)
  let c = geom::transform_multiply(a, b)
  assert_eq(c.tx, 5.0)
  assert_eq(c.ty, 10.0)
end
