use std::serde
use std::json
use std::core::{Map, String, Vec, Unit}

test "Golden: JSON roundtrip" do
  let mut obj = Map::new()
  obj.insert("name".to_string(), std::serde::Value::String("Alice".to_string()))
  obj.insert("age".to_string(), std::serde::Value::Int(30))
  let v = std::serde::Value::Object(obj)
  
  let s = std::json::stringify(&v)
  let v2 = std::json::parse(&s).unwrap()
  
  assert v2.get("name").unwrap().as_string().unwrap() == "Alice"
  assert v2.get("age").unwrap().as_int().unwrap() == 30
end

test "Negative: Invalid JSON" do
  let res = std::json::parse("{invalid}")
  match res
  when Err(e) then
    assert e.code() == std::gfx_errors::ErrorCode::InvalidArg
  when Ok(_) then
    assert false
  end
end

test "Oracle: Value to JSON" do
  let v = std::serde::Value::Int(123)
  assert std::json::stringify(&v) == "123"
end

test "Metamorphic: Pretty vs Compact JSON" do
  let mut obj = Map::new()
  obj.insert("x".to_string(), std::serde::Value::Int(1))
  let v = std::serde::Value::Object(obj)
  
  let s1 = std::json::stringify(&v)
  let s2 = std::json::stringify_pretty(&v, 2)
  
  let v1 = std::json::parse(&s1).unwrap()
  let v2 = std::json::parse(&s2).unwrap()
  
  assert v1.get("x").unwrap().as_int().unwrap() == 1
  assert v2.get("x").unwrap().as_int().unwrap() == 1
end

test "Lifecycle: Large nesting depth" do
  let mut v = std::serde::Value::Int(1)
  for i in 0..10 do
    let mut next = Vec::new()
    next.push(v)
    v = std::serde::Value::Array(next)
  end
  
  let s = std::json::stringify(&v)
  let v2 = std::json::parse(&s).unwrap()
  assert v2.as_array().unwrap().len() == 1
end
