# tests/unit/test_serde_rigor.tg — JSON value round-trips and known outputs

use std::serde
use std::json
use std::gfx_errors
use std::test::*
use std::core::{Map, String, Vec, Unit, Result, Option}

@test
def test_json_golden_roundtrip() -> Unit
  let mut obj = Map::new()
  obj.insert("name".to_string(), std::serde::Value::String("Alice".to_string()))
  obj.insert("age".to_string(), std::serde::Value::Int(30))
  let v = std::serde::Value::Object(obj)

  let s = std::json::stringify(&v)
  let v2 = std::json::parse(&s).unwrap()

  assert_eq(v2.get("name").unwrap().as_string().unwrap(), "Alice")
  assert_eq(v2.get("age").unwrap().as_int().unwrap(), 30)
end

@test
def test_json_negative_invalid() -> Unit
  let res = std::json::parse("{invalid}")
  let is_invalid_arg = match res
  when Result::Err(e) then e.code() == std::gfx_errors::ErrorCode::InvalidArg
  when Result::Ok(_) then false
  end
  assert_true(is_invalid_arg)
end

@test
def test_json_oracle_int_to_json() -> Unit
  let v = std::serde::Value::Int(123)
  assert_eq(std::json::stringify(&v), "123")
end

@test
def test_json_pretty_vs_compact_parse_equivalence() -> Unit
  let mut obj = Map::new()
  obj.insert("x".to_string(), std::serde::Value::Int(1))
  let v = std::serde::Value::Object(obj)

  let s1 = std::json::stringify(&v)
  let s2 = std::json::stringify_pretty(&v, 2)

  let v1 = std::json::parse(&s1).unwrap()
  let v2 = std::json::parse(&s2).unwrap()

  assert_eq(v1.get("x").unwrap().as_int().unwrap(), 1)
  assert_eq(v2.get("x").unwrap().as_int().unwrap(), 1)
end

@test
def test_json_deep_nesting_exact_output() -> Unit
  # 10 nested arrays around the integer 1 stringify deterministically in
  # compact mode — the full string is asserted, not just the depth.
  let mut v = std::serde::Value::Int(1)
  for _ in 0..10 do
    let mut next = Vec::new()
    next.push(v)
    v = std::serde::Value::Array(next)
  end

  let s = std::json::stringify(&v)
  assert_eq(s, "[[[[[[[[[[1]]]]]]]]]]")

  let v2 = std::json::parse(&s).unwrap()
  let is_array = match v2.as_array()
  when Option::Some(_) then true
  when Option::None then false
  end
  assert_true(is_array)
end
