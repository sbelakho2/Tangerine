# tests/unit/test_slice_noncopy_clone_drop.tg — audit item 1 (the Slice
# ownership split): the OWNING persistent window (cloned_slice, T: Clone)
# clones every element into independently owned pinned storage (the
# read-then-clone shape — never a raw byte copy), and the backing's
# per-element deinit destroys each clone EXACTLY ONCE, at the final
# destruction of the last view. The source's own elements are destroyed
# separately by the source: N logical objects cloned into a window of N
# yield exactly 2N registered drops over the full lifetime (a missing
# per-element deinit would leak the N backing clones; a double
# destruction would count N extra and — for String images — would
# double-free the same buffer).
#
# Counting mechanism (the tests/thread_spawn_failure_test.tg / audit §21
# convention): a module-level drop counter incremented by the element
# type's registered Drop. Each @test resets it and asserts the exact
# per-phase totals.

use std::collections
use std::core
use std::test::{assert_eq, assert_true}

mut drop_counter: Int = 0

struct TrackedItem
  id: Int
end

impl Clone for TrackedItem
  def clone(self: Self) -> TrackedItem
    TrackedItem { id: self.id }
  end
end

impl Drop for TrackedItem
  def drop(inout self: TrackedItem) -> Unit
    drop_counter = drop_counter + 1
  end
end

def track(n: Int) -> TrackedItem
  TrackedItem { id: n }
end

@test
def test_cloned_slice_strings_independent_of_source_lifetime() -> Unit
  var v = Vec[String]::new()
  v.push("alpha" + "")
  v.push("beta" + "")
  v.push("gamma" + "")
  let s = cloned_slice(v, 0, 3)
  assert_eq(s.len(), 3)
  # The source dies FIRST: the window's clones stay owned by the pinned
  # backing — independent storage, the backing owns its own copies.
  drop(v)
  assert_eq(s.len(), 3)
  assert_true(!s.is_empty())
end

@test
def test_cloned_slice_resource_drops_staged_exactly_once() -> Unit
  drop_counter = 0
  var v = Vec[TrackedItem]::new()
  v.push(track(1))
  v.push(track(2))
  v.push(track(3))
  v.push(track(4))
  assert_eq(drop_counter, 0)
  # The window [1, 4) clones items 2..4 into the fresh pinned backing.
  let s = cloned_slice(v, 1, 3)
  assert_eq(s.len(), 3)
  assert_eq(drop_counter, 0)
  # The SOURCE's four items die with the source.
  drop(v)
  assert_eq(drop_counter, 4)
  # The backing deinit destroys the three clones exactly once each.
  drop(s)
  assert_eq(drop_counter, 7)
end

def window_scope_ends_after_source_drop() -> Unit
  var v = Vec[TrackedItem]::new()
  v.push(track(10))
  v.push(track(20))
  let s = cloned_slice(v, 0, 2)
  drop(v)
  let _ = s.len()
  # The last view (s) dies when this scope ends: the backing deinit runs
  # the per-element drop glue over the pinned clones — exactly once each,
  # BEFORE the pinned allocation is released.
end

@test
def test_cloned_slice_final_destruction_runs_per_element_glue() -> Unit
  drop_counter = 0
  window_scope_ends_after_source_drop()
  # 2 source items + 2 backing clones = 4 registered drops total; the
  # backing's two clones were destroyed exactly once, at final
  # destruction (a leak would leave the total at 2).
  assert_eq(drop_counter, 4)
end

@test
def test_cloned_slice_untouched_by_source_mutation() -> Unit
  drop_counter = 0
  var v = Vec[TrackedItem]::new()
  v.push(track(1))
  v.push(track(2))
  let s = cloned_slice(v, 0, 2)
  assert_eq(s.len(), 2)
  # A capacity-changing mutation of the source after the window exists:
  # the window's pinned clones are unaffected (no aliasing with the
  # source buffer — the backing is the separate pinned allocation).
  v.push(track(3))
  assert_eq(s.len(), 2)
  drop(s)
  assert_eq(drop_counter, 2)
  drop(v)
  assert_eq(drop_counter, 5)
end
