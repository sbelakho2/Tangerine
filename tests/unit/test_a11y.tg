## ---------------------------------------------------------------
## tests/unit/test_a11y.tg — Accessibility completeness tests
## Covers §25.2 of TG-GFX-UI-SPEC-001 v0.1
## ---------------------------------------------------------------

use std::accessibility
use std::ui_toolkit
use std::geom

## ---------------------------------------------------------------
## 25.2  Widget → a11y node mapping
## ---------------------------------------------------------------

test "Button emits correct a11y role and label" do
  let node = A11yNode {
    role: Role::Button,
    label: "Submit",
    rect: Rect { x: 10.0, y: 10.0, width: 80.0, height: 30.0 },
    focusable: true,
    children: List.new(),
  }
  assert node.role == Role::Button
  assert node.label == "Submit"
  assert node.focusable == true
end

test "TextInput emits correct a11y role" do
  let node = A11yNode {
    role: Role::TextField,
    label: "Username",
    rect: Rect { x: 10.0, y: 50.0, width: 200.0, height: 30.0 },
    focusable: true,
    children: List.new(),
  }
  assert node.role == Role::TextField
  assert node.focusable == true
end

test "Checkbox emits correct a11y role" do
  let node = A11yNode {
    role: Role::CheckBox,
    label: "Accept terms",
    rect: Rect { x: 10.0, y: 90.0, width: 20.0, height: 20.0 },
    focusable: true,
    children: List.new(),
  }
  assert node.role == Role::CheckBox
end

test "Label is not focusable" do
  let node = A11yNode {
    role: Role::StaticText,
    label: "Welcome",
    rect: Rect { x: 10.0, y: 130.0, width: 100.0, height: 20.0 },
    focusable: false,
    children: List.new(),
  }
  assert !node.focusable
end

test "ScrollView emits Group role with children" do
  let child1 = A11yNode {
    role: Role::StaticText,
    label: "Item 1",
    rect: Rect { x: 0.0, y: 0.0, width: 100.0, height: 20.0 },
    focusable: false,
    children: List.new(),
  }
  let child2 = A11yNode {
    role: Role::Button,
    label: "Action",
    rect: Rect { x: 0.0, y: 20.0, width: 100.0, height: 30.0 },
    focusable: true,
    children: List.new(),
  }
  let scroll = A11yNode {
    role: Role::Group,
    label: "Content list",
    rect: Rect { x: 0.0, y: 0.0, width: 100.0, height: 300.0 },
    focusable: false,
    children: List.of(child1, child2),
  }
  assert scroll.children.len() == 2
end

## ---------------------------------------------------------------
## 25.2  Rect and label updates on layout change
## ---------------------------------------------------------------

test "a11y rect updates with layout" do
  let mut node = A11yNode {
    role: Role::Button,
    label: "OK",
    rect: Rect { x: 0.0, y: 0.0, width: 60.0, height: 30.0 },
    focusable: true,
    children: List.new(),
  }
  ## Simulate layout change
  node.rect = Rect { x: 100.0, y: 200.0, width: 80.0, height: 40.0 }
  assert node.rect.x == 100.0
  assert node.rect.y == 200.0
  assert node.rect.width == 80.0
end

## ---------------------------------------------------------------
## 25.2  Keyboard-only navigation
## ---------------------------------------------------------------

test "focus traversal collects focusable nodes in order" do
  let nodes = List.of(
    A11yNode { role: Role::Button, label: "A", rect: Rect { x: 0.0, y: 0.0, width: 50.0, height: 30.0 }, focusable: true, children: List.new() },
    A11yNode { role: Role::StaticText, label: "B", rect: Rect { x: 0.0, y: 30.0, width: 50.0, height: 20.0 }, focusable: false, children: List.new() },
    A11yNode { role: Role::TextField, label: "C", rect: Rect { x: 0.0, y: 50.0, width: 50.0, height: 30.0 }, focusable: true, children: List.new() },
    A11yNode { role: Role::CheckBox, label: "D", rect: Rect { x: 0.0, y: 80.0, width: 20.0, height: 20.0 }, focusable: true, children: List.new() },
  )
  let mut focusable = List.new()
  for n in nodes
    if n.focusable
      focusable.push(n.label.clone())
    end
  end
  assert focusable.len() == 3
  assert focusable.get(0) == "A"
  assert focusable.get(1) == "C"
  assert focusable.get(2) == "D"
end

## ---------------------------------------------------------------
## 25.2  Focus consistency
## ---------------------------------------------------------------

test "focus index stays within bounds" do
  let focusable_count = 3
  let mut focus_idx = 0
  ## Tab forward wraps
  focus_idx = (focus_idx + 1) % focusable_count
  assert focus_idx == 1
  focus_idx = (focus_idx + 1) % focusable_count
  assert focus_idx == 2
  focus_idx = (focus_idx + 1) % focusable_count
  assert focus_idx == 0
end

## ---------------------------------------------------------------
## 25.2  Accessibility tree snapshot
## ---------------------------------------------------------------

test "a11y tree snapshot for representative UI" do
  let root = A11yNode {
    role: Role::Window,
    label: "Main Window",
    rect: Rect { x: 0.0, y: 0.0, width: 800.0, height: 600.0 },
    focusable: false,
    children: List.of(
      A11yNode {
        role: Role::Group,
        label: "Toolbar",
        rect: Rect { x: 0.0, y: 0.0, width: 800.0, height: 40.0 },
        focusable: false,
        children: List.of(
          A11yNode { role: Role::Button, label: "New", rect: Rect { x: 5.0, y: 5.0, width: 60.0, height: 30.0 }, focusable: true, children: List.new() },
          A11yNode { role: Role::Button, label: "Open", rect: Rect { x: 70.0, y: 5.0, width: 60.0, height: 30.0 }, focusable: true, children: List.new() },
        ),
      },
      A11yNode {
        role: Role::Group,
        label: "Content",
        rect: Rect { x: 0.0, y: 40.0, width: 800.0, height: 560.0 },
        focusable: false,
        children: List.of(
          A11yNode { role: Role::TextField, label: "Editor", rect: Rect { x: 10.0, y: 50.0, width: 780.0, height: 500.0 }, focusable: true, children: List.new() },
        ),
      },
    ),
  }
  assert root.role == Role::Window
  assert root.children.len() == 2
  let toolbar = root.children.get(0)
  assert toolbar.children.len() == 2
  let content = root.children.get(1)
  assert content.children.len() == 1
end
