use std::config
use std::core::{Map, String, Vec, Unit}

test "Golden: Config builder with defaults and inline" do
  let mut defs = Map::new()
  defs.insert("port".to_string(), std::config::Value::Int(8080))
  
  let config = std::config::ConfigBuilder::new()
    .defaults(defs)
    .set("host", std::config::Value::String("localhost".to_string()))
    .build()
    .unwrap()
    
  assert config.get_int("port").unwrap() == 8080
  assert config.get_string("host").unwrap() == "localhost"
end

test "Negative: Missing config key" do
  let config = std::config::Config::new()
  let res = config.get_int("missing")
  match res
  when Err(e) then
    assert e.code() == std::gfx_errors::ErrorCode::InvalidArg
  when Ok(_) then
    assert false
  end
end

test "Oracle: Layered merge priority" do
  let mut low = Map::new()
  low.insert("a".to_string(), std::config::Value::Int(1))
  low.insert("b".to_string(), std::config::Value::Int(1))
  
  let mut high = Map::new()
  high.insert("b".to_string(), std::config::Value::Int(2))
  
  let config = std::config::ConfigBuilder::new()
    .defaults(low)
    .set_all(high)
    .build()
    .unwrap()
    
  assert config.get_int("a").unwrap() == 1
  assert config.get_int("b").unwrap() == 2
end

test "Metamorphic: Flattened vs Nested Access" do
  # This tests the internal _set_nested and get logic consistency
  let mut builder = std::config::ConfigBuilder::new()
  builder.set("database.host", std::config::Value::String("db".to_string()))
  let config = builder.build().unwrap()
  
  assert config.get_string("database.host").unwrap() == "db"
  
  let table = config.get_table("database").unwrap()
  match table.get("host")
  when Some(v) then
    assert v.as_str().unwrap() == "db"
  when None then
    assert false
  end
end

test "Lifecycle: Config re-build" do
  let mut builder = std::config::ConfigBuilder::new()
  builder.set("x", std::config::Value::Int(1))
  let c1 = builder.build().unwrap()
  assert c1.get_int("x").unwrap() == 1
  
  builder.set("x", std::config::Value::Int(2))
  let c2 = builder.build().unwrap()
  assert c2.get_int("x").unwrap() == 2
end
