use std::core::{assert, Result, Vec}
use std::sync::{Mutex, RwLock, AtomicInt, Semaphore, Barrier, OnceCell, Condvar}
use std::thread::{spawn, yield_now}

def test_mutex_rigor()
  let mut m = Mutex::new(0)
  {
    let mut g = m.lock().unwrap()
    *g.get_mut() += 1
  }
  assert(*m.lock().unwrap().get() == 1)
end

def test_atomic_rigor()
  let mut a = AtomicInt::new(10)
  a.fetch_add(5)
  assert(a.load() == 15)
  a.store(20)
  assert(a.load() == 20)
end

def test_once_cell_rigor()
  let mut cell = OnceCell::new()
  assert(!cell.is_initialized())
  let val = cell.get_or_init(|| 42)
  assert(*val == 42)
  assert(cell.is_initialized())
  let val2 = cell.get_or_init(|| 100) # Should not change
  assert(*val2 == 42)
end

def test_semaphore_rigor()
  let mut sem = Semaphore::new(2)
  assert(sem.available_permits() == 2)
  sem.acquire()
  assert(sem.available_permits() == 1)
  assert(sem.try_acquire())
  assert(sem.available_permits() == 0)
  assert(!sem.try_acquire())
  sem.release()
  assert(sem.available_permits() == 1)
end

def test_barrier_rigor()
  # Simplified since we can't easily spawn threads in this unit test without a proper runner
  # but we can test the structure.
  let mut b = Barrier::new(1)
  let res = b.wait()
  assert(res.is_leader())
end

def main()
  test_mutex_rigor()
  test_atomic_rigor()
  test_once_cell_rigor()
  test_semaphore_rigor()
  test_barrier_rigor()
  println("tg-sync rigor tests passed")
end
