use std::cli
use std::core::{Vec, String, Unit}

test "Golden: Simple argument parsing" do
  let mut app = std::cli::App::new("test", "test app")
  app.arg(std::cli::Arg::new("input").required(true))
  app.flag(std::cli::Flag::new("verbose").short('v'))
  
  let args = ["test".to_string(), "--verbose".to_string(), "file.txt".to_string()]
  let matches = app.parse_from(&args).unwrap()
  
  assert matches.get_bool("verbose")
  assert matches.get_string("input").unwrap() == "file.txt"
end

test "Oracle: Command routing" do
  let mut sub = std::cli::App::new("sub", "subcommand")
  sub.flag(std::cli::Flag::new("force").short('f'))
  
  let mut app = std::cli::App::new("main", "main app")
  app.subcommand(std::cli::Subcommand::new("sub", sub))
  
  let args = ["main".to_string(), "sub".to_string(), "-f".to_string()]
  let matches = app.parse_from(&args).unwrap()
  
  match matches.subcommand()
  when Some(tuple) then
    let name = tuple.0
    let sub_matches = tuple.1
    assert *name == "sub"
    assert sub_matches.get_bool("force")
  when None then
    assert false
  end
end

test "Metamorphic: Option order invariance" do
  let mut app = std::cli::App::new("test", "test app")
  app.flag(std::cli::Flag::new("a").takes_value())
  app.flag(std::cli::Flag::new("b").takes_value())
  
  let args1 = ["test".to_string(), "--a".to_string(), "1".to_string(), "--b".to_string(), "2".to_string()]
  let args2 = ["test".to_string(), "--b".to_string(), "2".to_string(), "--a".to_string(), "1".to_string()]
  
  let m1 = app.parse_from(&args1).unwrap()
  let m2 = app.parse_from(&args2).unwrap()
  
  assert m1.get_string("a").unwrap() == m2.get_string("a").unwrap()
  assert m1.get_string("b").unwrap() == m2.get_string("b").unwrap()
end

test "Negative: Missing required argument" do
  let mut app = std::cli::App::new("test", "test app")
  app.arg(std::cli::Arg::new("input").required(true))
  
  let args = ["test".to_string()]
  let res = app.parse_from(&args)
  assert res.is_err()
end

test "Lifecycle: Cli instance re-use" do
  let mut app = std::cli::App::new("test", "test app")
  app.flag(std::cli::Flag::new("v"))
  
  let args1 = ["test".to_string(), "-v".to_string()]
  let m1 = app.parse_from(&args1).unwrap()
  assert m1.get_bool("v")
  
  let args2 = ["test".to_string()]
  let m2 = app.parse_from(&args2).unwrap()
  assert !m2.get_bool("v")
end
