use std::random
use std::core::{Vec, String, Unit}

test "Golden: PRNG from seed" do
  let mut rng = std::random::Xoshiro256StarStar::from_seed(42u64)
  let val1 = rng.next_u64()
  let val2 = rng.next_u64()
  assert val1 != val2
  
  # Determinism check
  let mut rng2 = std::random::Xoshiro256StarStar::from_seed(42u64)
  assert val1 == rng2.next_u64()
end

test "Oracle: Uniform distribution" do
  let mut rng = std::random::Xoshiro256StarStar::from_seed(123u64)
  for _ in 0..100 do
    let val = rng.next_int_range(1, 10)
    assert val >= 1
    assert val <= 10
  end
end

test "Metamorphic: next_float range" do
  let mut rng = std::random::Xoshiro256StarStar::from_seed(7u64)
  for _ in 0..100 do
    let f = rng.next_float()
    assert f >= 0.0
    assert f < 1.0
  end
end

test "Negative: WeightedIndex invalid weights" do
  let weights = [1.0, -1.0]
  let res = std::random::WeightedIndex::new(&weights)
  assert res.is_err()
end

test "Lifecycle: Shuffle" do
  let mut items = [1, 2, 3, 4, 5]
  let mut rng = std::random::Xoshiro256StarStar::from_seed(99u64)
  rng.shuffle(&mut items)
  # Statistically very likely to be different, but not guaranteed.
  # For a rigor test, we'd use a fixed seed and check the exact outcome.
end
