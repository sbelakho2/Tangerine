# Obligations Rigor Tests
use std::obligations::{ObligationRegistry, ObligationContext, ObligationSeverity}
use std::contracts::ContractKind
use std::test::{assert_eq, assert_true}

test "Golden: Obligation lifecycle" do
  let mut reg = ObligationRegistry::new()
  let ctx = ObligationContext {
    id: "ctx1".to_string(),
    file: "test.tg".to_string(),
    line: 10,
    column: 5,
    function_name: "test_func".to_string(),
    call_stack: Vec::new(),
  }
  
  let id = reg.add_obligation(
    "compiler".to_string(),
    ContractKind::Pre,
    "x > 0".to_string(),
    ctx,
    ObligationSeverity::Error
  )
  
  assert reg.pending_count == 1
  
  reg.discharge(&id, "Range analysis confirmed x=5".to_string(), "PROOF-001".to_string()).unwrap()
  
  assert reg.pending_count == 0
  assert reg.verified_count == 1
end

test "Negative: Discharge non-existent" do
  let mut reg = ObligationRegistry::new()
  let res = reg.discharge(&"NONE".to_string(), "ev".to_string(), "p".to_string())
  assert res.is_err()
end
