use std::audit
use std::core::{Vec, String, Unit}
use std::fs

test "Golden: Real audit scan finds stubs" do
  # The REAL audit (the reviewer's false-success fix): the scope resolves
  # to a real source file and the scan READS its data — a stub marker in
  # the file is a real finding with a real location. The old stub audit
  # reported zero findings for every input.
  let path = "/tmp/tg_audit_rigor_stub.tg".to_string()
  let _ = fs::remove_file(path.clone())
  match fs::write_file_bytes(path.clone(), "def main() -> Int\n  # TODO: implement this\n  0\nend\n".as_bytes().to_vec())
  when Ok(_) then ()
  when Err(_) then assert false
  end
  let res = std::audit::run_audit(path.clone())
  match res
  when Ok(report) then
    assert report.id.starts_with("AUDIT")
    assert report.findings.len() > 0
    # the stub finding carries a real code, a real severity and a REAL
    # location (path:line) — never the empty location.
    let finding = report.findings.get(0)
    assert finding.code == "MNT-001"
    assert finding.location.contains(":2")
  when Err(_) then
    assert false
  end
  let _ = fs::remove_file(path.clone())
end

test "Negative: Empty scope is the explicit InvalidArg error" do
  # The old neutral stub returned Ok for the empty scope — the explicit
  # error is the honest contract (never the empty success).
  let res = std::audit::run_audit("".to_string())
  match res
  when Ok(_) then assert false
  when Err(e) then
    assert e.code() == std::gfx_errors::ErrorCode::InvalidArg
  end
end

test "Negative: Unresolvable scope is the explicit InvalidArg error" do
  let res = std::audit::run_audit("/nonexistent/tg_audit_scope_xyz".to_string())
  match res
  when Ok(_) then assert false
  when Err(e) then
    assert e.code() == std::gfx_errors::ErrorCode::InvalidArg
  end
end

test "Unsupported: The deep audit is the explicit Unsupported error" do
  # The genuinely-future half of the split (the compiler-integrated
  # dataflow/capability-closure analysis) is the EXPLICIT Unsupported —
  # never an empty success.
  let res = std::audit::run_audit_deep("std/".to_string())
  match res
  when Ok(_) then assert false
  when Err(e) then
    assert e.code() == std::gfx_errors::ErrorCode::Unsupported
    assert e.message().contains("not implemented")
  end
end

test "Oracle: Finding structure" do
  let finding = std::audit::AuditFinding {
    code: "BUG-001".to_string(),
    severity: std::audit::Severity::Critical,
    message: "Test".to_string(),
    location: "file.tg:1".to_string(),
    repro: std::core::Option::None
  }
  assert finding.code == "BUG-001"
end

test "Metamorphic: Severity ordering" do
  # Verify enum variants are distinct
  assert std::audit::Severity::Critical != std::audit::Severity::Major
end

test "Lifecycle: Report identity" do
  let path = "/tmp/tg_audit_rigor_ts.tg".to_string()
  let _ = fs::remove_file(path.clone())
  match fs::write_file_bytes(path.clone(), "def main() -> Int\n  0\nend\n".as_bytes().to_vec())
  when Ok(_) then ()
  when Err(_) then assert false
  end
  let report = std::audit::run_audit(path.clone()).unwrap()
  assert report.id.starts_with("AUDIT")
  let _ = fs::remove_file(path.clone())
end
