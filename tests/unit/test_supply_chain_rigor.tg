use std::core::{assert, Result, Vec, Map}
use std::supply_chain::{
  semver_parse, semver_to_string, SemVer,
  PackageSignature, SignerIdentity, TrustLevel, verify_package_signature,
  Lockfile, LockedPackage, PackageId, PackageSource, lockfile_verify
}
use std::crypto::{PublicKey, Signature}

def test_semver_rigor()
  # Golden vectors for semver
  let cases = [
    ("1.2.3", true),
    ("1.2.3-alpha.1", true),
    ("1.2.3+20260307", true),
    ("1.2.3-beta.2+build.99", true),
    ("1.2", false),
    ("v1.2.3", false),
    ("1.2.3.4", false)
  ]
  
  for (input, expected_success) in cases do
    let res = semver_parse(input)
    assert(res.is_ok() == expected_success, "Semver parse mismatch for: " + input)
    if res.is_ok() then
      let v = res.unwrap()
      let s = semver_to_string(&v)
      assert(s == input, "Semver roundtrip failed: " + input + " -> " + s)
    end
  end
  
  # Independent Oracle: check parts of a complex one
  let v = semver_parse("1.2.3-alpha.1+build.1").unwrap()
  assert(v.major == 1)
  assert(v.minor == 2)
  assert(v.patch == 3)
  assert(v.pre.unwrap() == "alpha.1")
  assert(v.build.unwrap() == "build.1")
end

def test_signature_rigor()
  let pkg_hash = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855".to_string() # sha256("")
  
  let dummy_pubkey = PublicKey::from_bytes([0u8; 32])
  let dummy_sig = Signature::from_bytes([0u8; 64])
  
  let signer = SignerIdentity {
    name: "Test Signer".to_string(),
    public_key: dummy_pubkey,
    trust_level: TrustLevel::Owner
  }
  
  let sig = PackageSignature {
    signer: signer,
    signature: dummy_sig,
    signed_hash: pkg_hash.clone(),
    timestamp: "2026-03-07T15:00:00Z".to_string(),
    algorithm: "ed25519".to_string()
  }
  
  # Negative: hash mismatch
  let wrong_hash = "wrong".to_string()
  let res1 = verify_package_signature(&wrong_hash, &sig)
  assert(res1.is_err(), "Should fail for hash mismatch")
  
  # Negative: invalid signature (dummy sig won't verify against dummy pubkey usually, unless it's a specific test case)
  # ed25519_verify is an intrinsic, it will definitely fail for all zeros.
  let res2 = verify_package_signature(&pkg_hash, &sig)
  assert(res2.is_err(), "Should fail for invalid signature")
end

def test_lockfile_rigor()
  let lock = Lockfile {
    format_version: "tg.lock.v1".to_string(),
    integrity_hash: "invalid".to_string(),
    packages: Vec::new()
  }
  
  # Negative: integrity mismatch
  let res = lockfile_verify(&lock)
  assert(res.is_err(), "Should fail for integrity mismatch")
end

def main()
  test_semver_rigor()
  test_signature_rigor()
  test_lockfile_rigor()
  println("tg-supply-chain rigor tests passed")
end
