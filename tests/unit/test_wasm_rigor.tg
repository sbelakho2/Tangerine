use std::wasm
use std::wasm::{ValType, Val, FuelConfig, _validate_wasm}
use std::core::{Result, Option}

test "Golden: FuelConfig::default has sensible values" do
  let cfg = FuelConfig::default()
  assert cfg.initial_fuel == 1000000
  assert cfg.fuel_per_instruction == 1
  assert cfg.fuel_per_memory_page == 1000
end

test "Oracle: _validate_wasm accepts valid magic + version" do
  let bytes: [u8; 8] = [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00]
  let res = _validate_wasm(&bytes)
  match res
  when Result::Ok(_) then assert true
  when Result::Err(_) then assert false
  end
end

test "Negative: _validate_wasm rejects short input" do
  let bytes: [u8; 4] = [0x00, 0x61, 0x73, 0x6D]
  let res = _validate_wasm(&bytes)
  match res
  when Result::Err(_) then assert true
  when Result::Ok(_) then assert false
  end
end

test "Negative: _validate_wasm rejects bad magic" do
  let bytes: [u8; 8] = [0xFF, 0xFF, 0xFF, 0xFF, 0x01, 0x00, 0x00, 0x00]
  let res = _validate_wasm(&bytes)
  match res
  when Result::Err(_) then assert true
  when Result::Ok(_) then assert false
  end
end

test "Metamorphic: Val::I32 preserves value" do
  let v = Val::I32(42i32)
  match v
  when Val::I32(n) then assert n == 42i32
  when _ then assert false
  end
end

test "Metamorphic: Val::I64 preserves value" do
  let v = Val::I64(1234567890123i64)
  match v
  when Val::I64(n) then assert n == 1234567890123i64
  when _ then assert false
  end
end

test "Lifecycle: Empty bytes fails validation" do
  let bytes: [u8; 0] = []
  let res = _validate_wasm(&bytes)
  match res
  when Result::Err(_) then assert true
  when Result::Ok(_) then assert false
  end
end
