# tests/unit/test_toml_rigor.tg — Known-value parse/stringify/round-trip tests for std::toml

use std::toml
use std::test::*
use std::core::{Map, String, Vec, Unit, Result}

@test
def test_toml_parse_known_values() -> Unit
  let doc = std::toml::toml_parse("title = \"TOML Example\"\ncount = 42\nenabled = true\n").unwrap()
  assert_eq(std::toml::toml_value_as_str(std::toml::toml_value_get(&doc, "title").unwrap()).unwrap(), "TOML Example")
  assert_eq(std::toml::toml_value_as_int(std::toml::toml_value_get(&doc, "count").unwrap()).unwrap(), 42)
  let enabled = std::toml::toml_value_as_bool(std::toml::toml_value_get(&doc, "enabled").unwrap()).unwrap()
  assert_true(enabled)
end

@test
def test_toml_parse_nested_table() -> Unit
  let doc = std::toml::toml_parse("[database]\nport = 5432\n").unwrap()
  let db = std::toml::toml_value_get(&doc, "database").unwrap()
  assert_eq(std::toml::toml_value_as_int(std::toml::toml_value_get(&db, "port").unwrap()).unwrap(), 5432)
end

@test
def test_toml_stringify_known_outputs() -> Unit
  # Single-key tables stringify deterministically: `key = "value"\n`.
  let mut m = Map::new()
  m.insert("title".to_string(), std::toml::TomlValue::String("hello".to_string()))
  let table = std::toml::TomlValue::Table(m)
  assert_eq(std::toml::toml_stringify(&table), "title = \"hello\"\n")

  # Arrays stringify as `[1, 2, 3]` (comma-space separated).
  let mut items = Vec::new()
  items.push(std::toml::TomlValue::Integer(1))
  items.push(std::toml::TomlValue::Integer(2))
  items.push(std::toml::TomlValue::Integer(3))
  let arr = std::toml::TomlValue::Array(items)
  assert_eq(std::toml::toml_stringify(&arr), "[1, 2, 3]")
end

@test
def test_toml_roundtrip_single_key() -> Unit
  let mut m = Map::new()
  m.insert("title".to_string(), std::toml::TomlValue::String("hello".to_string()))
  let table = std::toml::TomlValue::Table(m)

  let s = std::toml::toml_stringify(&table)
  let parsed = std::toml::toml_parse(s.as_str()).unwrap()
  assert_eq(std::toml::toml_value_as_str(std::toml::toml_value_get(&parsed, "title").unwrap()).unwrap(), "hello")
end

@test
def test_toml_negative_invalid_input() -> Unit
  # A stray character after a complete key-value pair is an UnexpectedChar error.
  let res = std::toml::toml_parse("key = 1 !")
  let is_err = match res
  when Result::Err(_) then true
  when Result::Ok(_) then false
  end
  assert_true(is_err)
end
