use std::secure_types
use std::core::{Vec, String, Unit}

test "Golden: SqlQuery with placeholders" do
  let mut params = Vec[std::secure_types::SqlParam].new()
  params.push(std::secure_types::SqlParam::Text("Alice".to_string()))
  
  let q = std::secure_types::sql_query("SELECT * FROM users WHERE name = $1".to_string(), params).unwrap()
  assert q.query.contains("$1")
end

test "Oracle: HTML escaping" do
  let raw = "<script>alert('xss')</script>".to_string()
  let safe = std::secure_types::html_escape(&raw)
  let s = std::secure_types::html_to_string(&safe)
  assert !s.contains("<script>")
  assert s.contains("&lt;script&gt;")
end

test "Metamorphic: Path join safety" do
  let base = std::secure_types::path_parse(&"/var/www".to_string()).unwrap()
  let child = std::secure_types::path_parse(&"images".to_string()).unwrap()
  let joined = std::secure_types::path_join(&base, &child).unwrap()
  assert std::secure_types::path_to_string(&joined) == "/var/www/images"
end

test "Negative: SQL injection rejection" do
  let mut params = Vec::new()
  # Attempting to use concatenation in template
  let res = std::secure_types::sql_query("SELECT * FROM users WHERE name = ' + name + '".to_string(), params)
  assert res.is_err()
end

test "Lifecycle: Secret exposure with capability" do
  let secret = std::secure_types::Secret::new(42)
  let cap = std::capabilities::custom_cap("Unsafe")
  let val = secret.expose(&cap).unwrap()
  assert *val == 42
end
