# tests/unit/test_paint.tg — Unit tests for paint/state stack §21.1
use std::test::*
use std::gfx
use std::geom

# --- Paint construction ---

@test
def test_solid_paint() -> Unit
  let c = Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 }
  let p = gfx::solid_paint(c)
  match p.kind
  when PaintKind::Solid(color)
    assert_eq(color.r, 1.0)
    assert_eq(color.g, 0.0)
  else
    assert_false(true)
  end
end

@test
def test_linear_gradient_paint() -> Unit
  let stops = [
    ColorStop { t: 0.0, color: Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 } },
    ColorStop { t: 1.0, color: Color { r: 0.0, g: 0.0, b: 1.0, a: 1.0 } }
  ]
  let start = Vec2 { x: 0.0, y: 0.0 }
  let end_pt = Vec2 { x: 100.0, y: 0.0 }
  let p = gfx::linear_paint(start, end_pt, stops)
  match p.kind
  when PaintKind::Linear(_, _, _)
    assert_true(true)
  else
    assert_false(true)
  end
end

# --- Stroke construction ---

@test
def test_stroke_defaults() -> Unit
  let s = Stroke {
    width: 1.0,
    cap: StrokeCap::Butt,
    join: StrokeJoin::Miter,
    miter_limit: 4.0,
    dash: None
  }
  assert_eq(s.width, 1.0)
  assert_eq(s.miter_limit, 4.0)
end

@test
def test_stroke_with_dash() -> Unit
  let d = Dash { pattern: [5.0, 3.0], phase: 0.0 }
  let s = Stroke {
    width: 2.0,
    cap: StrokeCap::Round,
    join: StrokeJoin::Round,
    miter_limit: 4.0,
    dash: Some(d)
  }
  assert_eq(s.width, 2.0)
  match s.dash
  when Some(dash)
    assert_eq(dash.phase, 0.0)
  else
    assert_false(true)
  end
end

# --- BlendMode coverage ---

@test
def test_blendmode_variants() -> Unit
  let modes = [
    BlendMode::SrcOver,
    BlendMode::SrcIn,
    BlendMode::SrcOut,
    BlendMode::DstOver,
    BlendMode::Clear
  ]
  assert_true(modes.len() >= 5)
end

# --- SoftwareCanvas state stack ---

@test
def test_softwarecanvas_save_restore() -> Unit
  let surface = gfx::create_software_surface(100, 100)
  let canvas = surface.begin_frame()

  # Save initial state
  canvas.save()

  # Apply transform
  let t = geom::transform_translate(10.0, 20.0)
  canvas.transform(t)

  # Restore should revert transform
  canvas.restore()

  # Verify by drawing at origin — pixel should be at (0,0) not (10,20)
  let white = gfx::solid_paint(Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 })
  let rect = Rect { x: 0.0, y: 0.0, w: 1.0, h: 1.0 }
  canvas.fill_rect(rect, white)

  surface.end_frame()
  assert_true(true)  # No crash = pass
end

@test
def test_softwarecanvas_clear() -> Unit
  let surface = gfx::create_software_surface(50, 50)
  let canvas = surface.begin_frame()
  let black = Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  canvas.clear(black)
  surface.end_frame()
  assert_true(true)
end

@test
def test_softwarecanvas_clip_rect() -> Unit
  let surface = gfx::create_software_surface(100, 100)
  let canvas = surface.begin_frame()
  let clip = Rect { x: 10.0, y: 10.0, w: 50.0, h: 50.0 }
  canvas.save()
  canvas.clip_rect(clip)
  # Draw outside clip — should be rejected
  let paint = gfx::solid_paint(Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 })
  canvas.fill_rect(Rect { x: 0.0, y: 0.0, w: 5.0, h: 5.0 }, paint)
  canvas.restore()
  surface.end_frame()
  assert_true(true)
end

# --- ImageDrawOpts ---

@test
def test_imagedrawopts_defaults() -> Unit
  let opts = ImageDrawOpts {
    blend: BlendMode::SrcOver,
    opacity: 1.0,
    filter: ImageFilter::Bilinear
  }
  assert_eq(opts.opacity, 1.0)
end

# --- Error handling ---

@test
def test_capability_rejection_for_canvas() -> Unit
  # SoftwareCanvas always works — no capability rejection
  # This validates the positive path
  let surface = gfx::create_software_surface(10, 10)
  let canvas = surface.begin_frame()
  canvas.save()
  canvas.restore()
  surface.end_frame()
  assert_true(true)
end
