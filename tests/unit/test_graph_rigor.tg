use std::graph
use std::core::{Vec, String, Unit, Map, Option, Result, Int}
use std::hash

test "Golden: Symbol graph node and edge creation" do
  let mut g = std::graph::SymbolGraph::new()
  g.add_node(std::graph::Node { id: "A".to_string(), kind: "mod".to_string(), metadata: Map::new() })
  g.add_node(std::graph::Node { id: "B".to_string(), kind: "fn".to_string(), metadata: Map::new() })
  g.add_edge(std::graph::Edge { source: "A".to_string(), target: "B".to_string(), kind: "contains".to_string() })
  
  let deps = g.query_dependencies(&"A".to_string())
  assert_true(deps.len() == 1)
  assert_true(deps.get(0) == "B")
end

test "Golden: load_graph parses the versioned on-disk format" do
  # The versioned serialization (the phantom __intrinsic_graph_load
  # removed): the file opens with the REQUIRED "GRAPH 1" header, then the
  # NODE / EDGE declarations.
  let path = "/tmp/tg_graph_rigor.tg".to_string()
  let w = std::fs::write_file_bytes(path.clone(), "GRAPH 1\nNODE A mod\nNODE B fn\nEDGE A B contains\n".as_bytes().to_vec())
  assert_true(w.is_ok())
  let res = std::graph::load_graph(path.clone())
  match res
  when Ok(g) then
    assert_true(g.nodes.len() == 2)
    assert_true(g.edges.len() == 1)
    let deps = g.query_dependencies(&"A".to_string())
    assert_true(deps.len() == 1)
    assert_true(deps.get(0) == "B")
  when Err(_) then
    assert_false(true)
  end
end

test "Golden: blank lines are skipped between declarations" do
  let path = "/tmp/tg_graph_rigor_blank.tg".to_string()
  let w = std::fs::write_file_bytes(path.clone(), "GRAPH 1\n\nNODE A mod\n\nEDGE A B contains\n\n".as_bytes().to_vec())
  assert_true(w.is_ok())
  let res = std::graph::load_graph(path.clone())
  match res
  when Ok(g) then
    assert_true(g.nodes.len() == 1)
    assert_true(g.edges.len() == 1)
  when Err(_) then
    assert_false(true)
  end
end

test "Strict: an unknown non-empty line is InvalidGraph (never silently ignored)" do
  let path = "/tmp/tg_graph_rigor_unknown.tg".to_string()
  let w = std::fs::write_file_bytes(path.clone(), "GRAPH 1\nNODE A mod\nFOO bar baz\n".as_bytes().to_vec())
  assert_true(w.is_ok())
  let res = std::graph::load_graph(path.clone())
  match res
  when Ok(_) then
    assert_false(true)
  when Err(e) then
    assert_true(e.code() == std::gfx_errors::ErrorCode::InvalidArg)
  end
end

test "Strict: a missing version header is InvalidGraph" do
  let path = "/tmp/tg_graph_rigor_no_header.tg".to_string()
  let w = std::fs::write_file_bytes(path.clone(), "NODE A mod\n".as_bytes().to_vec())
  assert_true(w.is_ok())
  let res = std::graph::load_graph(path.clone())
  assert_true(res.is_err())
end

test "Strict: an unsupported graph version is InvalidGraph" do
  let path = "/tmp/tg_graph_rigor_bad_version.tg".to_string()
  let w = std::fs::write_file_bytes(path.clone(), "GRAPH 2\nNODE A mod\n".as_bytes().to_vec())
  assert_true(w.is_ok())
  let res = std::graph::load_graph(path.clone())
  assert_true(res.is_err())
end

test "Negative: Missing graph file is NotFound" do
  let res = std::graph::load_graph("definitely_missing_graph_file.tg".to_string())
  assert_true(res.is_err())
end

test "Negative: Request non-existent node" do
  let g = std::graph::SymbolGraph::new()
  let deps = g.query_dependencies(&"Missing".to_string())
  assert_true(deps.len() == 0)
end

test "Round-trip: save_graph -> load_graph reproduces the identical serialization" do
  var g1 = std::graph::SymbolGraph::new()
  g1.add_node(std::graph::Node { id: "A".to_string(), kind: "mod".to_string(), metadata: Map::new() })
  g1.add_node(std::graph::Node { id: "B".to_string(), kind: "fn".to_string(), metadata: Map::new() })
  g1.add_edge(std::graph::Edge { source: "A".to_string(), target: "B".to_string(), kind: "contains".to_string() })
  let text1 = std::graph::serialize_graph(g1)
  assert_true(text1 == "GRAPH 1\nNODE A mod\nNODE B fn\nEDGE A B contains\n")

  var g2 = std::graph::SymbolGraph::new()
  g2.add_node(std::graph::Node { id: "A".to_string(), kind: "mod".to_string(), metadata: Map::new() })
  g2.add_node(std::graph::Node { id: "B".to_string(), kind: "fn".to_string(), metadata: Map::new() })
  g2.add_edge(std::graph::Edge { source: "A".to_string(), target: "B".to_string(), kind: "contains".to_string() })
  let path = "/tmp/tg_graph_rigor_roundtrip.tg".to_string()
  assert_true(std::graph::save_graph(path.clone(), g2).is_ok())
  match std::graph::load_graph(path.clone())
  when Ok(g3) then
    let text2 = std::graph::serialize_graph(g3)
    assert_true(text2 == text1)
  when Err(_) then
    assert_false(true)
  end
end

test "Hash: equal graphs hash equal; different graphs hash different" do
  var g1 = std::graph::SymbolGraph::new()
  g1.add_node(std::graph::Node { id: "A".to_string(), kind: "mod".to_string(), metadata: Map::new() })
  g1.add_edge(std::graph::Edge { source: "A".to_string(), target: "B".to_string(), kind: "contains".to_string() })
  var g2 = std::graph::SymbolGraph::new()
  g2.add_node(std::graph::Node { id: "A".to_string(), kind: "mod".to_string(), metadata: Map::new() })
  g2.add_edge(std::graph::Edge { source: "A".to_string(), target: "B".to_string(), kind: "contains".to_string() })
  # A graph lacking the edge must NOT hash equal to the graph carrying it.
  var g3 = std::graph::SymbolGraph::new()
  g3.add_node(std::graph::Node { id: "A".to_string(), kind: "mod".to_string(), metadata: Map::new() })

  let s1 = std::graph::serialize_graph(g1)
  let s2 = std::graph::serialize_graph(g2)
  let s3 = std::graph::serialize_graph(g3)
  let h1 = std::hash::hash_bytes(s1.as_bytes())
  let h2 = std::hash::hash_bytes(s2.as_bytes())
  let h3 = std::hash::hash_bytes(s3.as_bytes())
  assert_true(h1 == h2)
  assert_true(h1 != h3)
end

test "Lifecycle: Context pack registration on graph load" do
  let res = std::graph::load_graph("definitely_missing_graph_file.tg".to_string())
  assert_true(res.is_err())
end
