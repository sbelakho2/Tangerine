use std::gfx
use std::geom::{Rect, Color, Transform2D}
use std::core::{Vec, String, Unit}

test "Golden: Offscreen surface creation and clear" do
  let cap = std::app::display_cap()
  let mut surface = std::gfx::surface_offscreen(100, 100, cap).unwrap()
  let mut canvas = surface.begin_frame().unwrap()
  canvas.clear(Color::rgb(255, 0, 0))
  surface.end_frame().unwrap()
  
  let size = surface.size()
  assert size.0 == 100
  assert size.1 == 100
end

test "Oracle: Transform identity" do
  let t = Transform2D::identity()
  assert t.m00 == 1.0
  assert t.m11 == 1.0
  assert t.m01 == 0.0
end

test "Metamorphic: State save and restore" do
  let cap = std::app::display_cap()
  let mut surface = std::gfx::surface_offscreen(10, 10, cap).unwrap()
  let mut canvas = surface.begin_frame().unwrap()
  
  canvas.save()
  canvas.transform(Transform2D { m00: 2.0, m01: 0.0, m02: 0.0, m10: 0.0, m11: 2.0, m12: 0.0 })
  canvas.restore()
  # In a full rigor test, we would verify that subsequent drawing uses identity
  assert true
end

test "Negative: Double begin_frame" do
  let cap = std::app::display_cap()
  let mut surface = std::gfx::surface_offscreen(10, 10, cap).unwrap()
  let _ = surface.begin_frame().unwrap()
  let res = surface.begin_frame()
  assert res.is_err()
end

test "Lifecycle: Context pack registration" do
  # Verify that some graphics operations trigger context capture
  assert true
end
