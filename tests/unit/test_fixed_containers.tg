# tests/unit/test_fixed_containers.tg — behavior suite for std::fixed
# (the fixed-capacity collections): the ownership-transferring
# push/pop semantics, the full-queue rejection that returns the item
# unconsumed, the ring wrap through the mask fast path, and the SPSC
# split-endpoint round trip.

use std::fixed
use std::core::{Option, Result, Unit}

test "Oracle: ArrayVec4 push/pop ordering and capacity" do
  ## ArrayVec pop is last-pushed-first (the top of the vector, exactly
  ## like Vec::pop), not a FIFO queue — FIFO is RingBuffer's contract.
  var v = std::fixed::ArrayVec4[Int].new()
  assert v.len() == 0
  assert v.capacity() == 4
  assert v.is_empty()
  let _ = v.push(10)
  let _ = v.push(20)
  let _ = v.push(30)
  assert v.len() == 3
  assert !v.is_full()
  match v.pop()
  when Option::Some(x) then assert x == 30
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 20
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 10
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
  assert v.len() == 0
end

test "Negative: ArrayVec4 full queue rejects without consuming" do
  var v = std::fixed::ArrayVec4[Int].new()
  let _ = v.push(1)
  let _ = v.push(2)
  let _ = v.push(3)
  let _ = v.push(4)
  assert v.is_full()
  match v.push(9)
  when Err(x) then
    assert x == 9
  when Ok(_) then
    assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 4
  when Option::None then assert false
  end
end

test "Oracle: RingBuffer4 FIFO order across the wrap point" do
  var r = std::fixed::RingBuffer4[Int].new()
  let _ = r.push(1)
  let _ = r.push(2)
  let _ = r.push(3)
  let _ = r.push(4)
  assert r.is_full()
  let _ = r.pop()
  let _ = r.push(5)
  assert r.len() == 4
  match r.pop()
  when Option::Some(x) then assert x == 2
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 3
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 4
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 5
  when Option::None then assert false
  end
  assert r.is_empty()
  match r.pop()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
end

test "Oracle: SpscQueue4 split-endpoint round trip" do
  let pair = std::fixed::SpscQueue4[Int].new()
  var tx = pair.0
  var rx = pair.1
  assert tx.capacity() == 4
  assert rx.capacity() == 4
  match tx.push(7)
  when Ok(_) then
    assert true
  when Err(_) then
    assert false
  end
  assert tx.len() == 1
  match rx.pop()
  when Option::Some(x) then assert x == 7
  when Option::None then assert false
  end
  assert rx.len() == 0
end

test "Oracle: ArrayVec4 get and clear" do
  var v = std::fixed::ArrayVec4[Int].new()
  let _ = v.push(5)
  let _ = v.push(6)
  match v.get(0)
  when Option::Some(x) then assert x == 5
  when Option::None then assert false
  end
  match v.get(1)
  when Option::Some(x) then assert x == 6
  when Option::None then assert false
  end
  match v.get(2)
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
  v.clear()
  assert v.is_empty()
  assert v.len() == 0
end

test "Oracle: RingBuffer4 peek and clear" do
  var r = std::fixed::RingBuffer4[Int].new()
  let _ = r.push(7)
  let _ = r.push(8)
  match r.peek()
  when Option::Some(x) then assert x == 7
  when Option::None then assert false
  end
  r.clear()
  assert r.is_empty()
  match r.peek()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
end
