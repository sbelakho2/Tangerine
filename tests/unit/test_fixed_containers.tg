# tests/unit/test_fixed_containers.tg — behavior suite for std::fixed
# (the fixed-capacity collections): the ownership-transferring
# push/pop semantics, the full-queue rejection that returns the item
# unconsumed, the ring wrap through the mask fast path, and the SPSC
# split-endpoint round trip plus the CLOSED-bit close linearization
# (push-before-close Ok, push-after-close Err with the item back, the
# buffered items that survive the close intact).
#
# The const-generic view rows (ArrayVec[Int, 4] / ArrayVec[Int, 8] /
# RingBuffer[Int, 4] / SpscQueue[Int, 4]) mirror the concrete-family
# rows: the views are the promoted surface (see std/fixed.tg's module
# header) and construct EMPTY values through their generic new() — the
# [Option::None; N] repeat-array fill with N the const parameter. The
# helper defs below build the same empty values through the §20
# aggregate-literal bridge (the older construction spelling, still
# legal) and drive the rows that predate the repeat lowering.
#
# RingBuffer[SpscQueue] new() runs the power-of-two construction guard
# (assert N & (N - 1) == 0) on every instance; a non-power-of-two
# capacity (RingBuffer[Int, 3]::new()) trips the assert and panics. The
# panic cannot be observed in a unit row — the stable panic strategy is
# ABORT-ONLY (std::core catch_panic is the experimental unwind surface),
# and a panicking row process would fail the runner — so the guard is
# documented here and in std/fixed.tg (CAPACITY VALIDATION), and the
# power-of-two rows below exercise the passing assert lane.

use std::fixed
use std::fixed::{ArrayVec, RingBuffer}
use std::core::{Option, Result, Unit, drop}

test "Oracle: ArrayVec4 push/pop ordering and capacity" do
  ## ArrayVec pop is last-pushed-first (the top of the vector, exactly
  ## like Vec::pop), not a FIFO queue — FIFO is RingBuffer's contract.
  var v = std::fixed::ArrayVec4[Int].new()
  assert v.len() == 0
  assert v.capacity() == 4
  assert v.is_empty()
  let _ = v.push(10)
  let _ = v.push(20)
  let _ = v.push(30)
  assert v.len() == 3
  assert !v.is_full()
  match v.pop()
  when Option::Some(x) then assert x == 30
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 20
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 10
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
  assert v.len() == 0
end

test "Negative: ArrayVec4 full queue rejects without consuming" do
  var v = std::fixed::ArrayVec4[Int].new()
  let _ = v.push(1)
  let _ = v.push(2)
  let _ = v.push(3)
  let _ = v.push(4)
  assert v.is_full()
  match v.push(9)
  when Err(x) then
    assert x == 9
  when Ok(_) then
    assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 4
  when Option::None then assert false
  end
end

test "Oracle: RingBuffer4 FIFO order across the wrap point" do
  var r = std::fixed::RingBuffer4[Int].new()
  let _ = r.push(1)
  let _ = r.push(2)
  let _ = r.push(3)
  let _ = r.push(4)
  assert r.is_full()
  let _ = r.pop()
  let _ = r.push(5)
  assert r.len() == 4
  match r.pop()
  when Option::Some(x) then assert x == 2
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 3
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 4
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 5
  when Option::None then assert false
  end
  assert r.is_empty()
  match r.pop()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
end

test "Oracle: SpscQueue4 split-endpoint round trip" do
  let pair = std::fixed::SpscQueue4[Int].new()
  var tx = pair.0
  var rx = pair.1
  assert tx.capacity() == 4
  assert rx.capacity() == 4
  match tx.push(7)
  when Ok(_) then
    assert true
  when Err(_) then
    assert false
  end
  assert tx.len() == 1
  match rx.pop()
  when Option::Some(x) then assert x == 7
  when Option::None then assert false
  end
  assert rx.len() == 0
end

test "Oracle: SpscQueue4 push before close returns Ok and the item is observable" do
  let pair = std::fixed::SpscQueue4[Int].new()
  var tx = pair.0
  var rx = pair.1
  match tx.push(11)
  when Ok(_) then assert true
  when Err(_) then assert false
  end
  match tx.push(12)
  when Ok(_) then assert true
  when Err(_) then assert false
  end
  assert tx.len() == 2
  assert rx.len() == 2
  match rx.pop()
  when Option::Some(x) then assert x == 11
  when Option::None then assert false
  end
  drop(rx)
  # The queue is closed, but the buffered item (published before the
  # close linearization point) is still counted on the tx side.
  assert tx.len() == 1
end

test "Negative: SpscQueue4 push after receiver drop returns the item" do
  let pair = std::fixed::SpscQueue4[Int].new()
  var tx = pair.0
  let rx = pair.1
  drop(rx)
  assert tx.len() == 0
  match tx.push(21)
  when Ok(_) then assert false
  when Err(x) then assert x == 21
  end
  match tx.push(22)
  when Ok(_) then assert false
  when Err(x) then assert x == 22
  end
  assert tx.len() == 0
end

test "Oracle: SpscQueue4 receiver close keeps buffered items queued" do
  let pair = std::fixed::SpscQueue4[Int].new()
  var tx = pair.0
  let rx = pair.1
  match tx.push(1)
  when Ok(_) then assert true
  when Err(_) then assert false
  end
  match tx.push(2)
  when Ok(_) then assert true
  when Err(_) then assert false
  end
  match tx.push(3)
  when Ok(_) then assert true
  when Err(_) then assert false
  end
  assert tx.len() == 3
  drop(rx)
  # Close does not drain: the buffered items stay queued (they are
  # destructed exactly once by the record glue when the last endpoint
  # — tx here — drops).
  assert tx.len() == 3
  match tx.push(9)
  when Ok(_) then assert false
  when Err(x) then assert x == 9
  end
  assert tx.len() == 3
end

test "Oracle: ArrayVec4 get and clear" do
  var v = std::fixed::ArrayVec4[Int].new()
  let _ = v.push(5)
  let _ = v.push(6)
  match v.get(0)
  when Option::Some(x) then assert x == 5
  when Option::None then assert false
  end
  match v.get(1)
  when Option::Some(x) then assert x == 6
  when Option::None then assert false
  end
  match v.get(2)
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
  v.clear()
  assert v.is_empty()
  assert v.len() == 0
end

test "Oracle: RingBuffer4 peek and clear" do
  var r = std::fixed::RingBuffer4[Int].new()
  let _ = r.push(7)
  let _ = r.push(8)
  match r.peek()
  when Option::Some(x) then assert x == 7
  when Option::None then assert false
  end
  r.clear()
  assert r.is_empty()
  match r.peek()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
end

# ───────────────────────────────────────────────────────────────────────
# Const-generic view rows (std/fixed.tg's promoted surface): ONE generic
# declaration per container over the capacity parameter, so the N=4 and
# N=8 spellings below are two instances of one declaration. The view
# types construct EMPTY values through their generic new() — the
# [Option::None; N] repeat-array fill whose count is the const parameter
# read as a per-instance value (std/fixed.tg's module header,
# CONSTRUCTION). The helper defs below build the same empty values at
# concrete capacity sites through the §20 aggregate-literal bridge
# (the pre-repeat construction spelling, still legal — the bridge rows
# above and the new()-driven rows below must agree).
# ───────────────────────────────────────────────────────────────────────

test "Oracle: const-generic ArrayVec[Int, 4].new() push/pop ordering and capacity" do
  ## The repeat-array construction path: new() fills the [Option[Int]; 4]
  ## storage through [Option::None; 4] (a concrete-site literal count).
  var v = ArrayVec[Int, 4]::new()
  assert v.len() == 0
  assert v.capacity() == 4
  assert v.is_empty()
  let _ = v.push(10)
  let _ = v.push(20)
  let _ = v.push(30)
  assert v.len() == 3
  assert !v.is_full()
  match v.pop()
  when Option::Some(x) then assert x == 30
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 20
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 10
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
  assert v.len() == 0
  assert v.capacity() == 4
end

test "Oracle: const-generic ArrayVec[Int, 8].new() capacity and LIFO (a second instance of one declaration)" do
  ## ArrayVec[Int, 8] is the SAME declaration as ArrayVec[Int, 4] at a
  ## different capacity — the repeat count is the per-instance N.
  var v = ArrayVec[Int, 8]::new()
  assert v.capacity() == 8
  assert v.len() == 0
  assert v.is_empty()
  assert !v.is_full()
  let _ = v.push(1)
  let _ = v.push(2)
  let _ = v.push(3)
  let _ = v.push(4)
  let _ = v.push(5)
  let _ = v.push(6)
  assert v.len() == 6
  assert !v.is_full()
  let _ = v.push(7)
  let _ = v.push(8)
  assert v.is_full()
  match v.push(9)
  when Result::Err(item) then assert item == 9
  when Result::Ok(_) then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 8
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 7
  when Option::None then assert false
  end
  v.clear()
  assert v.is_empty()
  assert v.len() == 0
  assert v.capacity() == 8
end

test "Oracle: const-generic RingBuffer[Int, 4].new() FIFO order across the wrap point" do
  ## The power-of-two guard (N & (N - 1) == 0) passes for N = 4 and the
  ## repeat fill gives the empty ring.
  var r = RingBuffer[Int, 4]::new()
  assert r.capacity() == 4
  assert r.is_empty()
  let _ = r.push(1)
  let _ = r.push(2)
  let _ = r.push(3)
  let _ = r.push(4)
  assert r.is_full()
  let _ = r.pop()
  let _ = r.push(5)
  assert r.len() == 4
  match r.pop()
  when Option::Some(x) then assert x == 2
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 3
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 4
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 5
  when Option::None then assert false
  end
  assert r.is_empty()
  match r.pop()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
end

test "Oracle: const-generic SpscQueue[Int, 4].new() split-endpoint round trip" do
  ## The SPSC generic family: the shared record is allocated with the
  ## N-item None repeat fill and split into the two endpoints; push/pop
  ## and the close linearization mirror SpscQueue4's contract.
  let pair = std::fixed::SpscQueue[Int, 4]::new()
  var tx = pair.0
  var rx = pair.1
  assert tx.capacity() == 4
  assert rx.capacity() == 4
  assert tx.len() == 0
  let _ = tx.push(1)
  let _ = tx.push(2)
  assert tx.len() == 2
  match rx.pop()
  when Option::Some(x) then assert x == 1
  when Option::None then assert false
  end
  let _ = tx.push(3)
  let _ = tx.push(4)
  let _ = tx.push(5)
  assert tx.len() == 4
  ## full queue: push returns the item unconsumed.
  match tx.push(9)
  when Result::Err(item) then assert item == 9
  when Result::Ok(_) then assert false
  end
  match rx.pop()
  when Option::Some(x) then assert x == 2
  when Option::None then assert false
  end
  match rx.pop()
  when Option::Some(x) then assert x == 3
  when Option::None then assert false
  end
  match rx.pop()
  when Option::Some(x) then assert x == 4
  when Option::None then assert false
  end
  match rx.pop()
  when Option::Some(x) then assert x == 5
  when Option::None then assert false
  end
  match rx.pop()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
  ## dropping the receiver closes the queue at a linearization point.
  drop(rx)
  match tx.push(11)
  when Result::Err(item) then assert item == 11
  when Result::Ok(_) then assert false
  end
  drop(tx)
end

def _av_view4() -> ArrayVec[Int, 4]
  ArrayVec {
    _data: [Option::None, Option::None, Option::None, Option::None],
    _len: 0
  }
end

def _av_view8() -> ArrayVec[Int, 8]
  ArrayVec {
    _data: [
      Option::None, Option::None, Option::None, Option::None,
      Option::None, Option::None, Option::None, Option::None
    ],
    _len: 0
  }
end

def _rb_view4() -> RingBuffer[Int, 4]
  RingBuffer {
    _data: [Option::None, Option::None, Option::None, Option::None],
    _head: 0,
    _tail: 0,
    _count: 0
  }
end

# Drop accounting: a module-level counter incremented by the element
# type's registered Drop (the test_fixed_spsc_drop.tg convention) — the
# monomorphized [Option[TrackedItem]; N] glue must destruct exactly the
# occupied slots, once each.
mut drop_counter: Int = 0

struct TrackedItem
  id: Int
end

impl Drop for TrackedItem
  def drop(inout self: TrackedItem) -> Unit
    drop_counter = drop_counter + 1
  end
end

def _av_view4_tracked() -> ArrayVec[TrackedItem, 4]
  ArrayVec {
    _data: [Option::None, Option::None, Option::None, Option::None],
    _len: 0
  }
end

test "Oracle: const-generic ArrayVec[Int, 4] push/pop ordering and capacity" do
  ## ArrayVec pop is last-pushed-first (the top of the vector, exactly
  ## like Vec::pop), not a FIFO queue — FIFO is RingBuffer's contract.
  var v = _av_view4()
  assert v.len() == 0
  assert v.capacity() == 4
  assert v.is_empty()
  let _ = v.push(10)
  let _ = v.push(20)
  let _ = v.push(30)
  assert v.len() == 3
  assert !v.is_full()
  match v.pop()
  when Option::Some(x) then assert x == 30
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 20
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 10
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
  assert v.len() == 0
  assert v.capacity() == 4
end

test "Oracle: const-generic ArrayVec[Int, 8] capacity and LIFO (a second instance of the same declaration)" do
  ## ArrayVec[Int, 8] is the SAME declaration as ArrayVec[Int, 4] at a
  ## different capacity — one impl with N read as a per-instance value.
  var v = _av_view8()
  assert v.capacity() == 8
  assert v.len() == 0
  assert v.is_empty()
  assert !v.is_full()
  let _ = v.push(1)
  let _ = v.push(2)
  let _ = v.push(3)
  let _ = v.push(4)
  let _ = v.push(5)
  let _ = v.push(6)
  assert v.len() == 6
  assert !v.is_full()
  match v.pop()
  when Option::Some(x) then assert x == 6
  when Option::None then assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 5
  when Option::None then assert false
  end
  assert v.len() == 4
  v.clear()
  assert v.is_empty()
  assert v.len() == 0
end

test "Negative: const-generic ArrayVec[Int, 4] full queue rejects without consuming" do
  var v = _av_view4()
  let _ = v.push(1)
  let _ = v.push(2)
  let _ = v.push(3)
  let _ = v.push(4)
  assert v.is_full()
  match v.push(9)
  when Err(x) then
    assert x == 9
  when Ok(_) then
    assert false
  end
  match v.pop()
  when Option::Some(x) then assert x == 4
  when Option::None then assert false
  end
end

test "Oracle: const-generic RingBuffer[Int, 4] FIFO order across the wrap point" do
  var r = _rb_view4()
  assert r.capacity() == 4
  let _ = r.push(1)
  let _ = r.push(2)
  let _ = r.push(3)
  let _ = r.push(4)
  assert r.is_full()
  let _ = r.pop()
  let _ = r.push(5)
  assert r.len() == 4
  match r.pop()
  when Option::Some(x) then assert x == 2
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 3
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 4
  when Option::None then assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 5
  when Option::None then assert false
  end
  assert r.is_empty()
  match r.pop()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
end

test "Negative: const-generic RingBuffer[Int, 4] full ring rejects without consuming" do
  var r = _rb_view4()
  let _ = r.push(1)
  let _ = r.push(2)
  let _ = r.push(3)
  let _ = r.push(4)
  assert r.is_full()
  match r.push(9)
  when Err(x) then
    assert x == 9
  when Ok(_) then
    assert false
  end
  match r.pop()
  when Option::Some(x) then assert x == 1
  when Option::None then assert false
  end
  assert r.len() == 3
end

test "Oracle: const-generic ArrayVec[Int, 4] get and clear" do
  var v = _av_view4()
  let _ = v.push(5)
  let _ = v.push(6)
  match v.get(0)
  when Option::Some(x) then assert x == 5
  when Option::None then assert false
  end
  match v.get(1)
  when Option::Some(x) then assert x == 6
  when Option::None then assert false
  end
  match v.get(2)
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
  v.clear()
  assert v.is_empty()
  assert v.len() == 0
end

test "Oracle: const-generic RingBuffer[Int, 4] peek and clear" do
  var r = _rb_view4()
  let _ = r.push(7)
  let _ = r.push(8)
  match r.peek()
  when Option::Some(x) then assert x == 7
  when Option::None then assert false
  end
  r.clear()
  assert r.is_empty()
  match r.peek()
  when Option::Some(_) then assert false
  when Option::None then assert true
  end
end

test "Oracle: const-generic ArrayVec drop glue destructs occupied slots exactly once" do
  drop_counter = 0
  var v = _av_view4_tracked()
  let _ = v.push(TrackedItem { id: 1 })
  let _ = v.push(TrackedItem { id: 2 })
  assert drop_counter == 0
  # pop transfers ownership: the caller destroys the popped item exactly
  # once, and the vacated slot resets to None.
  match v.pop()
  when Option::Some(item) then
    assert item.id == 2
    drop(item)
  when Option::None then assert false
  end
  assert drop_counter == 1
  # The view value's monomorphized [Option[TrackedItem]; 4] glue runs at
  # drop: the one remaining occupied slot destructed exactly once, the
  # vacant None slots glue-trivial.
  drop(v)
  assert drop_counter == 2
end
