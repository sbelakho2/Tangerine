# Postgres Rigor Tests
use std::postgres::{connect, Config}
use std::test::{assert_eq, assert_true}

test "Golden: Config defaults" do
  let c = Config::default()
  assert c.port == 5432
  assert c.user == "postgres"
end

test "Negative: Connection failure context" do
  # Connection to an unlikely host/port
  let c = Config {
    host: "127.0.0.1".to_string(),
    port: 9999,
    user: "postgres".to_string(),
    password: Option::None,
    database: "postgres".to_string(),
    pool_size: 1,
  }
  let res = connect(c)
  assert res.is_err()
end
