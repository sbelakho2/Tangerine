# Postgres rigor tests — the CANONICAL driver surface (reviewer item 18:
# the fake std::postgres facade is DELETED; std::db::Postgres is the one
# Postgres driver — the real PQconnectdb + the ? -> $n translation).
use std::db::{PostgresConfig, Postgres, DbError}
use std::core::{Option, String}
use std::test::{assert_eq, assert_true}

test "Golden: Config defaults" do
  let c = PostgresConfig::new()
  assert c.port == 5432
  assert c.user == "postgres"
end

test "Negative: Connection failure context" do
  # A connection to an unlikely host/port must fail through the canonical
  # driver's Result — never a fake success.
  let c = PostgresConfig::new().host("127.0.0.1").port(9999)
  let res = c.connect()
  assert res.is_err()
end

test "Golden: Connection string shape" do
  let c = PostgresConfig::new().host("db.example.com").port(5433).database("app")
  let s = c.to_connection_string()
  assert s.contains("host=db.example.com")
  assert s.contains("port=5433")
  assert s.contains("dbname=app")
end
