# tests/unit/test_sync_behavior.tg — the per-callable behavior suite
# for std::sync (the API manifest's uncovered callables, driven to
# real semantics: inputs -> expected outputs; the failure paths -> the
# expected failures).

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec}
use std::test::*
use std::sync::*
use std::time::{Duration}
use std::ffi::{Ptr, PtrMut}

@test
def test_sync_atomics_surface() -> Unit
  # AtomicBool: swap + compare_and_swap
  var ab = AtomicBool::new(false)
  assert_true(ab.swap(true))
  assert_true(ab.load())
  assert_eq(ab.compare_and_swap(true, false), 1)
  assert_false(ab.load())
  # AtomicU32: fetch_add / fetch_sub / swap / compare_and_swap
  var a32 = AtomicU32::new(10)
  assert_eq(a32.fetch_add(5), 10)
  assert_eq(a32.load(), 15)
  assert_eq(a32.fetch_sub(3), 15)
  assert_eq(a32.load(), 12)
  assert_eq(a32.swap(99), 12)
  assert_eq(a32.load(), 99)
  assert_eq(a32.compare_and_swap(99, 1), 99)
  assert_eq(a32.load(), 1)
  assert_eq(a32.compare_and_swap(99, 2), 1)
  assert_eq(a32.load(), 1)
  # AtomicU64: the full surface
  var a64 = AtomicU64::new(100)
  assert_eq(a64.load(), 100)
  assert_eq(a64.fetch_add(7), 100)
  assert_eq(a64.fetch_sub(7), 107)
  assert_eq(a64.swap(5), 100)
  assert_eq(a64.load(), 5)
  assert_eq(a64.compare_and_swap(5, 6), 5)
  assert_eq(a64.store(9), ())
  assert_eq(a64.load(), 9)
  # the Once state constants
  assert_eq(ONCE_UNINITIALIZED(), 0)
  assert_eq(ONCE_RUNNING(), 1)
  assert_eq(ONCE_COMPLETE(), 2)
end

@test
def test_sync_atomic_ptr_surface() -> Unit
  var v = 41
  var w = 42
  var ap = AtomicPtr::new(&mut v)
  let p0 = ap.load()
  assert_eq(p0.read(), 41)
  let old = ap.swap(&mut w)
  assert_eq(old.read(), 41)
  let p1 = ap.load()
  assert_eq(p1.read(), 42)
  ap.store(&mut v)
  assert_eq(ap.load().read(), 41)
end

@test
def test_sync_intrinsics_surface() -> Unit
  var b = 7 as u8
  assert_eq(__intrinsic_atomic_fetch_add_u8(&mut b as PtrMut[u8], 1, 0), 7 as u8)
  assert_eq(__intrinsic_atomic_fetch_sub_u8(&mut b as PtrMut[u8], 2, 0), 8 as u8)
  assert_eq(b, 6 as u8)
  assert_eq(__intrinsic_atomic_load_u8(&b as Ptr[u8], 0), 6 as u8)
  let _ = __intrinsic_atomic_store_u8(&mut b as PtrMut[u8], 9, 0)
  assert_eq(b, 9 as u8)
  assert_eq(__intrinsic_atomic_exchange_u8(&mut b as PtrMut[u8], 3, 0), 9 as u8)
  var e8 = 3 as u8
  assert_true(__intrinsic_atomic_compare_exchange_u8(&mut b as PtrMut[u8], &mut e8 as PtrMut[u8], 4, false, 0, 0))
  assert_eq(b, 4 as u8)
  var c32 = 10
  assert_eq(__intrinsic_atomic_fetch_add_u32(&mut c32 as PtrMut[u32], 5, 0), 10)
  assert_eq(__intrinsic_atomic_fetch_sub_u32(&mut c32 as PtrMut[u32], 5, 0), 15)
  assert_eq(c32, 10)
  assert_eq(__intrinsic_atomic_load_u32(&c32 as Ptr[u32], 0), 10)
  let _ = __intrinsic_atomic_store_u32(&mut c32 as PtrMut[u32], 20, 0)
  assert_eq(__intrinsic_atomic_exchange_u32(&mut c32 as PtrMut[u32], 30, 0), 20)
  var e32 = 30
  assert_true(__intrinsic_atomic_compare_exchange_u32(&mut c32 as PtrMut[u32], &mut e32 as PtrMut[u32], 40, false, 0, 0))
  assert_eq(c32, 40)
  var c64 = 100
  assert_eq(__intrinsic_atomic_fetch_add_u64(&mut c64 as PtrMut[u64], 1, 0), 100)
  assert_eq(__intrinsic_atomic_fetch_sub_u64(&mut c64 as PtrMut[u64], 1, 0), 101)
  assert_eq(c64, 100)
  assert_eq(__intrinsic_atomic_load_u64(&c64 as Ptr[u64], 0), 100)
  let _ = __intrinsic_atomic_store_u64(&mut c64 as PtrMut[u64], 200, 0)
  assert_eq(__intrinsic_atomic_exchange_u64(&mut c64 as PtrMut[u64], 300, 0), 200)
  var e64 = 300
  assert_true(__intrinsic_atomic_compare_exchange_u64(&mut c64 as PtrMut[u64], &mut e64 as PtrMut[u64], 400, false, 0, 0))
  assert_eq(c64, 400)
end

@test
def test_sync_mutex_surface() -> Unit
  let am = Arc::new(Mutex::new(5))
  assert_false(am.ptr.as_ref().is_locked())
  let g = assert_some(am.ptr.as_ref().try_lock())
  assert_true(am.ptr.as_ref().is_locked())
  assert_eq(g.deref().read(), 5)
  drop(g)
  assert_false(am.ptr.as_ref().is_locked())
  let g2 = am.ptr.as_ref().lock()
  let pm = g2.deref_mut()
  pm.write(9)
  drop(g2)
  let g3 = am.ptr.as_ref().lock()
  assert_none(am.ptr.as_ref().try_lock())
  drop(g3)
  let g4 = assert_some(am.ptr.as_ref().try_lock())
  assert_eq(g4.deref().read(), 9)
  drop(g4)
end

@test
def test_sync_rwlock_surface() -> Unit
  let ar = Arc::new(RwLock::new(7))
  let rg = ar.ptr.as_ref().read()
  assert_eq(rg.deref().read(), 7)
  drop(rg)
  let trg = assert_some(ar.ptr.as_ref().try_read())
  drop(trg)
  let wg = ar.ptr.as_ref().write()
  let pm = wg.deref_mut()
  pm.write(11)
  drop(wg)
  let twg = assert_some(ar.ptr.as_ref().try_write())
  drop(twg)
  let rg2 = ar.ptr.as_ref().read()
  assert_eq(rg2.deref().read(), 11)
  drop(rg2)
end

@test
def test_sync_condvar_timeouts() -> Unit
  # wait_timeout: nobody notifies — the wait returns after the timeout
  let ac = Arc::new(Condvar::new())
  let am = Arc::new(Mutex::new(0))
  let g = am.ptr.as_ref().lock()
  let g2 = ac.ptr.as_ref().wait_timeout(g, Duration::from_millis(5))
  drop(g2)
  let g3 = am.ptr.as_ref().lock()
  let g4 = ac.ptr.as_ref().wait_timeout_ms(g3, 5)
  drop(g4)
end

@test
def test_sync_arc_surface() -> Unit
  let a = Arc::new(1)
  let a2 = a.clone()
  assert_eq(a2.strong_count(), 2)
  let a3 = a.clone()
  assert_false(a3.is_null())
  let null_arc = Arc::null()
  assert_true(null_arc.is_null())
  let deref_p = a.deref()
  assert_eq(deref_p.read(), 1)
end

@test
def test_sync_lazy_surface() -> Unit
  let lazy = Lazy::new(|| 42)
  let p = lazy.get()
  assert_eq(p.read(), 42)
end

@test
def test_sync_spinlock_surface() -> Unit
  var sl = SpinLock::new()
  assert_false(sl.is_locked())
  assert_true(sl.try_lock())
  assert_true(sl.is_locked())
  assert_false(sl.try_lock())
  sl.unlock()
  assert_false(sl.is_locked())
  sl.lock()
  assert_true(sl.is_locked())
  sl.unlock()
end

@test
def test_sync_scope_guard() -> Unit
  var g = ScopeGuard::new(|| ())
  g.dismiss()
  var g2 = ScopeGuard::new(|| ())
  let _ = g2
  assert_true(true)
end

@test
def test_sync_channel_timeout() -> Unit
  let (tx, rx) = channel()
  assert_false(tx.is_closed())
  let v = rx.recv_timeout(Duration::from_millis(2))
  assert_none(v)
  let _ = tx.send(3)
  let got = rx.recv_timeout(Duration::from_millis(2))
  match got
  when Option::Some(x) then assert_eq(x, 3)
  when Option::None then assert_false(true)
  end
end
