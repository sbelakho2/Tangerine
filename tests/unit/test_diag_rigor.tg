use std::diagnostics
use std::core::{String, Vec, Unit}

test "Golden: LogEntry creation" do
  let entry = std::diagnostics::LogEntry {
    timestamp_ns: 1000u64,
    level: std::diagnostics::LogLevel::Info,
    category: std::diagnostics::LogCategory::App,
    message: "App started".to_string(),
    correlation_id: "abc-123".to_string(),
  }
  assert entry.message == "App started"
end

test "Oracle: StartupDiagnostics summary content" do
  let diag = std::diagnostics::StartupDiagnostics {
    backend_name: "software".to_string(),
    backend_version: "0.1.0".to_string(),
    abi_version_major: 0u32,
    abi_version_minor: 1u32,
    deterministic_raster: true,
    gpu_nondeterminism_possible: false,
    capabilities: std::core::List::of("app".to_string(), "gfx".to_string()),
    platform: "macos-arm64".to_string(),
    build_id: "build-001".to_string(),
  }
  let s = diag.summary()
  assert s.contains("software")
  assert s.contains("0.1")
end

test "Metamorphic: FilteredLogger limits" do
  let mut logger = std::diagnostics::FilteredLogger::new(std::diagnostics::LogLevel::Info, 2u64)
  
  let entry1 = std::diagnostics::LogEntry {
    timestamp_ns: 1, level: std::diagnostics::LogLevel::Info,
    category: std::diagnostics::LogCategory::App, message: "1".to_string(), correlation_id: "".to_string()
  }
  let entry2 = std::diagnostics::LogEntry {
    timestamp_ns: 2, level: std::diagnostics::LogLevel::Info,
    category: std::diagnostics::LogCategory::App, message: "2".to_string(), correlation_id: "".to_string()
  }
  let entry3 = std::diagnostics::LogEntry {
    timestamp_ns: 3, level: std::diagnostics::LogLevel::Info,
    category: std::diagnostics::LogCategory::App, message: "3".to_string(), correlation_id: "".to_string()
  }
  
  logger.log(entry1)
  logger.log(entry2)
  assert logger.entries.len() == 2
  
  logger.log(entry3)
  assert logger.entries.len() == 2
  assert logger.entries.get(0).message == "2"
  assert logger.entries.get(1).message == "3"
end

test "Negative: Invalid FrameCapture" do
  let cap = std::diagnostics::FrameCapture {
    frame_id: 1u64,
    width: 2u32,
    height: 2u32,
    pixel_data: std::core::List::of(0u8), # too small
    capture_time_ns: 0u64,
  }
  assert !cap.is_valid()
end

test "Lifecycle: FirstFailureContext dump" do
  let err = std::diagnostics::RuntimeError {
    code: 2001u32,
    category: std::diagnostics::LogCategory::Gfx,
    message: "Surface lost".to_string(),
    correlation_id: "req-42".to_string(),
    timestamp_ns: 0u64,
    backend_id: "vulkan".to_string(),
    interface_version: "0.1".to_string(),
  }
  
  let ctx = std::diagnostics::FirstFailureContext {
    error: err,
    ui_tree_dump: "tree".to_string(),
    compositor_dump: "comp".to_string(),
    frame_capture: std::core::Option::None,
    recent_events: std::core::List::new(),
    memory_snapshot: "mem".to_string(),
  }
  
  let s = ctx.dump_to_string()
  assert s.contains("FIRST FAILURE CONTEXT")
  assert s.contains("TG-2001")
end
