use std::hal
use std::core::{Vec, String, Unit}

test "Golden: HAL initialization" do
  let config = std::hal::HalConfig {
    preferred_backend: std::core::Option::Some(std::hal::BackendKind::Software),
    enable_validation: true
  }
  let res = std::hal::init_hal(config)
  match res
  when Ok(instance) then
    assert instance.device_count > 0
  when Err(_) then
    assert false
  end
end

test "Oracle: Backend kind equality" do
  assert std::hal::BackendKind::Vulkan != std::hal::BackendKind::Metal
end

test "Metamorphic: Default backend" do
  let config = std::hal::HalConfig {
    preferred_backend: std::core::Option::None,
    enable_validation: false
  }
  let instance = std::hal::init_hal(config).unwrap()
  assert instance.backend == std::hal::BackendKind::Software
end

test "Negative: Device lost error code" do
  let err = std::hal::HalError::DeviceLost(std::gfx_errors::Error::backend_lost("lost".to_string()))
  assert err.code() == std::gfx_errors::ErrorCode::BackendLost
end

test "Lifecycle: Context pack registration on init" do
  let config = std::hal::HalConfig {
    preferred_backend: std::core::Option::None,
    enable_validation: false
  }
  let _ = std::hal::init_hal(config).unwrap()
  # In a full test, verify pack exists in registry
  assert true
end
