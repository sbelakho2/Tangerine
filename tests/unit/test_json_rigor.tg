# tests/unit/test_json_rigor.tg — the RFC 8259 document contract (P1.7):
# parse_document = value + optional whitespace + REQUIRED end of input.
# The JSONTestSuite-style n_* class is rejected with the explicit policy:
# trailing garbage, a second value, and the leading-zero number prefix
# are parse errors — never a silent success.

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec}
use std::test::*
use std::json

@test
def test_json_document_rejects_trailing_garbage() -> Unit
  assert_err(std::json::parse("{} garbage"))
  assert_err(std::json::parse("true x"))
  assert_err(std::json::parse("null null"))
  assert_err(std::json::parse("[1] junk"))
  assert_err(std::json::parse("\"abc\" xyz"))
end

@test
def test_json_document_rejects_second_value() -> Unit
  assert_err(std::json::parse("1 2"))
  assert_err(std::json::parse("true false"))
  assert_err(std::json::parse("[1] [2]"))
  assert_err(std::json::parse("{} {}"))
end

@test
def test_json_document_rejects_leading_zero_prefix() -> Unit
  # "01" parses the "0" and must then fail on the "1" residue — the
  # leading-zero prefix acceptance is closed by the EOF requirement.
  assert_err(std::json::parse("01"))
  assert_err(std::json::parse("-01"))
  assert_err(std::json::parse("0123"))
  assert_err(std::json::parse("01.5"))
  assert_err(std::json::parse("00"))
end

@test
def test_json_document_rejects_invalid_tokens() -> Unit
  assert_err(std::json::parse(""))
  assert_err(std::json::parse("   "))
  assert_err(std::json::parse("tru"))
  assert_err(std::json::parse("nul"))
  assert_err(std::json::parse("undefined"))
  assert_err(std::json::parse("NaN"))
  assert_err(std::json::parse("+1"))
  assert_err(std::json::parse("1e"))
  assert_err(std::json::parse("1."))
  assert_err(std::json::parse("-"))
  assert_err(std::json::parse("{\"a\":}"))
  assert_err(std::json::parse("[1,]"))
end

@test
def test_json_document_accepts_trailing_whitespace() -> Unit
  # The document grammar allows interceding whitespace AFTER the value.
  let v1 = assert_ok(std::json::parse("  true  \n\t "))
  let ok1 = match v1
  when std::serde::Value::Bool(b) then b
  when _ then false
  end
  assert_true(ok1)
  let v2 = assert_ok(std::json::parse("[1, 2] "))
  let _ = v2
  let v3 = assert_ok(std::json::parse("{}"))
  let _ = v3
end

@test
def test_json_document_round_trip() -> Unit
  let v = assert_ok(std::json::parse("{\"a\": [1, 2, {\"b\": null}]}"))
  let s = std::json::stringify(&v)
  let v2 = assert_ok(std::json::parse(&s))
  let _ = v2
end
