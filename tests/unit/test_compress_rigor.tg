# tests/unit/test_compress_rigor.tg — zlib (std::compress::deflate) round-trip tests

use std::compress
use std::crypto
use std::test::*
use std::core::{Vec, String, Unit, Result}

@test
def test_zlib_roundtrip_text() -> Unit
  let data = "The quick brown fox jumps over the lazy dog".to_string().as_bytes()
  let compressed = std::compress::deflate::compress(data).unwrap()
  let decompressed = std::compress::deflate::decompress(&compressed).unwrap()
  assert_eq(std::crypto::hex::encode(decompressed.as_slice()), std::crypto::hex::encode(data))
end

@test
def test_zlib_roundtrip_repetitive_binary() -> Unit
  let mut data = Vec::with_capacity(4096)
  var i = 0
  while i < 4096 do
    data.push((i % 251) as u8)
    i = i + 1
  end
  let compressed = std::compress::deflate::compress(&data).unwrap()
  # Repetitive data must actually shrink.
  assert_true(compressed.len() < data.len())
  let decompressed = std::compress::deflate::decompress(&compressed).unwrap()
  assert_eq(std::crypto::hex::encode(decompressed.as_slice()), std::crypto::hex::encode(&data))
end

@test
def test_zlib_roundtrip_empty() -> Unit
  let data: Vec[u8] = Vec::new()
  let compressed = std::compress::deflate::compress(&data).unwrap()
  let decompressed = std::compress::deflate::decompress(&compressed).unwrap()
  assert_true(decompressed.is_empty())
end

@test
def test_zlib_negative_corrupt_input() -> Unit
  # 0xde is not a valid zlib CMF (CM must be 8) — uncompress must fail.
  let mut garbage = Vec::new()
  garbage.push(0xde)
  garbage.push(0xad)
  garbage.push(0xbe)
  garbage.push(0xef)
  let res = std::compress::deflate::decompress(&garbage)
  let is_err = match res
  when Result::Err(_) then true
  when Result::Ok(_) then false
  end
  assert_true(is_err)
end
