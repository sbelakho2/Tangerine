use std::core::{assert, Result, Vec}
use std::tensor::{Tensor, DType, TensorError}

def test_tensor_alloc()
  let shape = [2, 3]
  # Mock behavior for intrinsics in tests is usually handled by the test runner
  # For now we test the API surface.
  let t = Tensor::new(shape, DType::F32)
  match t
  when Result::Ok(tensor) then
    assert(tensor.shape()[0] == 2)
    assert(tensor.shape()[1] == 3)
    assert(tensor.dtype() == DType::F32)
  when Result::Err(_) then () # In some environments this might fail if no backend
  end
end

def test_tensor_matmul_negative()
  # Test shape verification
  let a = Tensor::new([2, 3], DType::F32).unwrap()
  let b = Tensor::new([4, 2], DType::F32).unwrap()
  
  let res = a.matmul(&b)
  match res
  when Result::Err(TensorError::ShapeMismatch(_)) then ()
  when _ then assert(false, "Should have failed with ShapeMismatch")
  end
end

def main()
  test_tensor_alloc()
  test_tensor_matmul_negative()
  println("tg-tensor rigor tests passed")
end
