use std::embed_trace
use std::core::{Vec, String, Unit}

test "Golden: Trace recording" do
  let mut buffer = std::embed_trace::TraceBuffer::new(10)
  buffer.record(1u32, [0u8; 8]).unwrap()
  assert buffer.entries.len() == 1
end

test "Oracle: Transcript CSV format" do
  let mut buffer = std::embed_trace::TraceBuffer::new(10)
  buffer.record(1u32, [0u8; 8]).unwrap()
  let csv = std::embed_trace::create_transcript(&buffer)
  assert csv.contains("TIMESTAMP_NS,EVENT_ID,DATA")
  assert csv.contains("1")
end

test "Metamorphic: Deterministic ordering" do
  let mut buffer = std::embed_trace::TraceBuffer::new(10)
  buffer.record(1u32, [0u8; 8]).unwrap()
  buffer.record(2u32, [0u8; 8]).unwrap()
  
  assert buffer.entries.get(0).event_id == 1u32
  assert buffer.entries.get(1).event_id == 2u32
end

test "Negative: Buffer overflow" do
  let mut buffer = std::embed_trace::TraceBuffer::new(1)
  buffer.record(1u32, [0u8; 8]).unwrap()
  let res = buffer.record(2u32, [0u8; 8])
  match res
  when Err(e) then
    assert e.code() == std::gfx_errors::ErrorCode::OutOfMemory
  when Ok(_) then
    assert false
  end
end

test "Lifecycle: Buffer clear" do
  let mut buffer = std::embed_trace::TraceBuffer::new(10)
  buffer.record(1u32, [0u8; 8]).unwrap()
  buffer.clear()
  assert buffer.entries.len() == 0
end
