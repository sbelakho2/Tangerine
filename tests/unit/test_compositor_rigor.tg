use std::compositor
use std::geom::{Rect, Transform2D}
use std::core::{Vec, String, Unit}

test "Golden: Create layer tree and add layer" do
  let mut tree = std::compositor::layer_tree_new()
  let id = std::compositor::add_layer(&mut tree, Rect { x: 0.0, y: 0.0, width: 100.0, height: 100.0 }, 1.0, Transform2D::identity())
  assert tree.layers.len() == 1
  assert id.value == 1u64
end

test "Oracle: Damage region tracking" do
  let mut tree = std::compositor::layer_tree_new()
  std::compositor::mark_dirty(&mut tree, Rect { x: 10.0, y: 10.0, width: 50.0, height: 50.0 })
  assert tree.damage.rects.len() == 1
  std::compositor::clear_damage(&mut tree)
  assert tree.damage.rects.len() == 0
end

test "Metamorphic: Visible vs Hidden layers" do
  let mut tree = std::compositor::layer_tree_new()
  let id = std::compositor::add_layer(&mut tree, Rect { x: 0.0, y: 0.0, width: 100.0, height: 100.0 }, 1.0, Transform2D::identity())
  
  # Manually hide layer
  tree.layers.get_mut(0).visible = false
  
  # In a full rigor test, we would mock the Canvas and verify draw calls
  assert !tree.layers.get(0).visible
end

test "Negative: Invalid layer access" do
  let tree = std::compositor::layer_tree_new()
  # Standard out of bounds check
  # assert_panic { tree.layers.get(0) }
end

test "Lifecycle: Layer ID increment" do
  let mut tree = std::compositor::layer_tree_new()
  let id1 = std::compositor::add_layer(&mut tree, Rect::default(), 1.0, Transform2D::identity())
  let id2 = std::compositor::add_layer(&mut tree, Rect::default(), 1.0, Transform2D::identity())
  assert id2.value == id1.value + 1u64
end
