# tests/unit/test_assets_rigor.tg — AssetId content-hash and error-path tests

use std::assets
use std::app
use std::crypto
use std::gfx_errors
use std::test::*
use std::core::{Vec, String, Unit, Result}

@test
def test_asset_id_hash_known_digest() -> Unit
  let data = "asset data".to_string().as_bytes().to_vec()
  let aid = std::assets::_compute_hash(&data)
  # SHA-256("asset data") — full digest asserted.
  assert_eq(std::crypto::hex::encode(aid.hash.as_slice()), "66995764fee5102ef37e594b85710c2c630f3e3308dcde06ed959c7c4bc797f6")
end

@test
def test_asset_id_hash_equals_crypto_sha256() -> Unit
  let data = "asset data".to_string().as_bytes().to_vec()
  let aid = std::assets::_compute_hash(&data)
  let direct = std::crypto::sha256(&data)
  assert_eq(std::crypto::hex::encode(aid.hash.as_slice()), std::crypto::hex::encode(&direct))
end

@test
def test_asset_load_image_without_backend() -> Unit
  let fs = std::app::FsCap { _opaque: 0u64 }
  let res = std::assets::load_image("test.png".to_string(), &fs)
  let is_io_error = match res
  when Result::Err(e) then e.code() == std::gfx_errors::ErrorCode::IOError
  when Result::Ok(_) then false
  end
  assert_true(is_io_error)
end

@test
def test_asset_hash_deterministic() -> Unit
  let data = "consistent".to_string().as_bytes().to_vec()
  let aid1 = std::assets::_compute_hash(&data)
  let aid2 = std::assets::_compute_hash(&data)
  assert_eq(std::crypto::hex::encode(aid1.hash.as_slice()), std::crypto::hex::encode(aid2.hash.as_slice()))
end

@test
def test_asset_hash_sensitivity() -> Unit
  let d1 = "data1".to_string().as_bytes().to_vec()
  let d2 = "data2".to_string().as_bytes().to_vec()
  let aid1 = std::assets::_compute_hash(&d1)
  let aid2 = std::assets::_compute_hash(&d2)
  assert_true(std::crypto::hex::encode(aid1.hash.as_slice()) != std::crypto::hex::encode(aid2.hash.as_slice()))
end

@test
def test_asset_error_code_consistency() -> Unit
  let err = std::assets::AssetError::Unsupported(std::gfx_errors::Error::unsupported("test".to_string()))
  assert_eq(err.code(), std::gfx_errors::ErrorCode::Unsupported)
end
