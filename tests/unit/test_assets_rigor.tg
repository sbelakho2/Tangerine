use std::assets
use std::core::{Vec, String, Unit}

test "Golden: AssetId hashing" do
  let data = "asset data".to_string().as_bytes()
  let aid = std::assets::_compute_hash(&data)
  assert aid.hash.len() == 32
end

test "Negative: Load image without backend" do
  let fs = std::app::FsCap { _opaque: 0u64 }
  let res = std::assets::load_image("test.png".to_string(), &fs)
  match res
  when Err(e) then
    assert e.code() == std::gfx_errors::ErrorCode::IOError
  when Ok(_) then
    assert false
  end
end

test "Oracle: Deterministic hashing" do
  let data = "consistent".to_string().as_bytes()
  let aid1 = std::assets::_compute_hash(&data)
  let aid2 = std::assets::_compute_hash(&data)
  assert aid1.hash == aid2.hash
end

test "Metamorphic: Hash sensitivity" do
  let d1 = "data1".to_string().as_bytes()
  let d2 = "data2".to_string().as_bytes()
  let aid1 = std::assets::_compute_hash(&d1)
  let aid2 = std::assets::_compute_hash(&d2)
  assert aid1.hash != aid2.hash
end

test "Lifecycle: Error enum consistency" do
  let err = std::assets::AssetError::Unsupported(std::gfx_errors::Error::unsupported("test".to_string()))
  assert err.code() == std::gfx_errors::ErrorCode::Unsupported
end
