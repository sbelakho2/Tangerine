# tests/unit/test_exec_behavior.tg — the per-callable behavior suite
# for std::exec (the API manifest's uncovered callables, driven to
# real semantics: inputs -> expected outputs; the failure paths -> the
# expected failures). The executor paths run over real worker threads;
# the PtrMut[ExecutorInner]-taking internals are documented as the
# honest remaining gap.

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec}
use std::test::*
use std::exec::*
use std::time::{Duration}

@test
def test_exec_constants() -> Unit
  assert_eq(DEFAULT_THREAD_COUNT(), 4)
  assert_eq(MAX_QUEUE_SIZE(), 4096)
  assert_eq(SPIN_COUNT_BEFORE_YIELD(), 100)
  assert_eq(STEAL_ATTEMPTS(), 3)
  assert_eq(IDLE_TIMEOUT_MS(), 100)
  assert_eq(WORKER_LOCAL_QUEUE_CAPACITY(), 256)
  assert_eq(_exec_state_running(), 0)
  assert_eq(_exec_state_draining(), 1)
  assert_eq(_exec_state_cancelling(), 2)
  assert_eq(_exec_state_stopped(), 3)
  assert_eq(_debug_state_submitted(), 0)
  assert_eq(_debug_state_queued(), 1)
  assert_eq(_debug_state_running(), 2)
  assert_eq(_debug_state_completed(), 3)
  assert_eq(_debug_state_cancelled(), 4)
  assert_eq(_debug_state_failed(), 5)
  assert_true(_default_thread_count_validated() > 0)
end

@test
def test_exec_worker_state() -> Unit
  let ws = WorkerState::new(3)
  let _ = ws
end

@test
def test_exec_debug_ledger() -> Unit
  var exec = assert_ok(Executor::new(1))
  let pm = exec.inner.ptr.as_mut()
  _debug_ledger_submit(pm, 99)
  assert_eq(_debug_ledger_state_of(pm, 99), _debug_state_submitted())
  _debug_ledger_queued(pm, 99)
  assert_eq(_debug_ledger_state_of(pm, 99), _debug_state_queued())
  _debug_ledger_running(pm, 99)
  assert_eq(_debug_ledger_state_of(pm, 99), _debug_state_running())
  _debug_ledger_completed(pm, 99)
  assert_eq(_debug_ledger_state_of(pm, 99), _debug_state_completed())
  _debug_ledger_cancelled(pm, 100)
  assert_eq(_debug_ledger_state_of(pm, 100), _debug_state_cancelled())
  _debug_ledger_failed(pm, 101)
  assert_eq(_debug_ledger_state_of(pm, 101), _debug_state_failed())
  assert_true(_debug_check_task_conservation(pm))
  # find_task: the worker's local queue is empty (a fresh worker)
  let _found = find_task(pm, 0)
  exec.shutdown()
end

@test
def test_exec_executor_lifecycle() -> Unit
  var exec = assert_ok(Executor::new(2))
  let id = exec.submit(Box::new(|| ()), TaskPriority::Normal)
  assert_true(id >= 1)
  let id2 = exec.submit(Box::new(|| ()), TaskPriority::High)
  assert_true(id2 > id)
  let id3 = exec.submit(Box::new(|| ()), TaskPriority::Low)
  assert_true(id3 > id2)
  let id4 = exec.submit(Box::new(|| ()), TaskPriority::Realtime)
  assert_true(id4 > id3)
  # the wrapped executor: the global executor via wrap
  let wrapped = Executor::wrap(global_executor())
  let wid = wrapped.submit(Box::new(|| ()), TaskPriority::Normal)
  assert_true(wid >= 1)
  # the default constructor
  var dflt = assert_ok(Executor::new_default())
  let _ = dflt.submit(Box::new(|| ()), TaskPriority::Normal)
  # start_workers: a fresh executor's worker threads are started
  var sw = assert_ok(Executor::new(1))
  sw.start_workers()
  let _ = sw.submit(Box::new(|| ()), TaskPriority::Normal)
  sw.shutdown()
  # the stats + conservation surface
  let stats = exec.stats()
  assert_true(stats.total_submitted >= 4)
  assert_true(exec.conservation_ok())
  let _ = exec.debug_completed_count()
  let _ = exec.debug_task_count(_debug_state_completed())
  # shutdown drains the submitted work
  exec.shutdown()
  dflt.shutdown()
end

@test
def test_exec_submit_with_result() -> Unit
  let exec = assert_ok(Executor::new(1))
  let handle = exec.submit_with_result(|| 42, TaskPriority::Normal)
  let got = assert_some(handle.join_timeout(Duration::from_millis(5000)))
  assert_eq(got, 42)
  assert_true(handle.is_complete())
  exec.shutdown()
end

@test
def test_exec_global_spawn_surface() -> Unit
  let _ = spawn(|| ())
  let _ = spawn_with_priority(|| (), TaskPriority::Normal)
  let h = spawn_with_result(|| 7)
  let got = assert_some(h.join_timeout(Duration::from_millis(5000)))
  assert_eq(got, 7)
  let h2 = spawn_cpu_intensive(|| 9)
  let got2 = assert_some(h2.join_timeout(Duration::from_millis(5000)))
  assert_eq(got2, 9)
  let _ = is_executor_thread()
  yield_now()
  let _ = global_executor()
end

@test
def test_exec_block_on() -> Unit
  let v = block_on(async { 1 + 2 })
  assert_eq(v, 3)
end
