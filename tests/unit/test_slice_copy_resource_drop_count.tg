# tests/unit/test_slice_copy_resource_drop_count.tg — audit item 1 (the
# Slice ownership split): the explicit COPY window (copied_slice,
# T: Copy) raw-copies a window into independently owned pinned storage;
# the window's contents equal the source at copy time and stay readable
# across the source's capacity-changing mutations AND its drop; the
# sub-views re-pin their own windows; and the backing's per-element
# deinit discipline never touches state the copy does not own.
#
# The drop-count rows of the owning lane live in
# test_slice_noncopy_clone_drop.tg: a counter-backed destructor element
# (registered Drop) is by construction NOT Copy (the type-property
# engine's bit-copy set excludes registered-Drop types — the
# canary_neg_copy_slab_pool lane), so it can never enter the RAW-copy
# constructor; the exact-once destruction of owning elements is
# exercised through cloned_slice (the owning twin of this constructor),
# which shares the same backing and the same per-element deinit.
# Counting mechanism: the tests/thread_spawn_failure_test.tg convention
# (module-level counter; each @test resets it).

use std::collections
use std::core
use std::test::{assert_eq, assert_true, assert_false, assert_some, catch_panic}

def make_copy_window() -> Slice[Int]
  var v = Vec[Int]::new()
  v.push(10)
  v.push(20)
  v.push(30)
  v.push(40)
  copied_slice(v, 0, 4)
end

@test
def test_copied_slice_contents_match_source() -> Unit
  var v = Vec[Int]::new()
  v.push(10)
  v.push(20)
  v.push(30)
  v.push(40)
  let s = copied_slice(v, 0, 4)
  assert_eq(s.len(), 4)
  assert_eq(s.get(0), 10)
  assert_eq(s.get(1), 20)
  assert_eq(s.get(2), 30)
  assert_eq(s.get(3), 40)
  let f = assert_some(s.first())
  assert_eq(f, 10)
  let l = assert_some(s.last())
  assert_eq(l, 40)
end

@test
def test_copied_slice_independent_of_source_mutation_and_drop() -> Unit
  var v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  v.push(3)
  let s = copied_slice(v, 0, 3)
  assert_eq(s.len(), 3)
  # Capacity-changing mutations of the source never move the pinned
  # window (the backing is the separate pinned allocation).
  var i = 0
  while i < 200 do
    v.push(1000 + i)
    i = i + 1
  end
  assert_eq(s.len(), 3)
  assert_eq(s.get(0), 1)
  assert_eq(s.get(2), 3)
  drop(v)
  # The window survives the source's drop and still reads its window.
  assert_eq(s.len(), 3)
  assert_eq(s.get(1), 2)
  # The sub-view re-pins its own window from the parent's pinned window.
  let sub = s.sub(1, 2)
  assert_eq(sub.len(), 2)
  assert_eq(sub.get(0), 2)
  assert_eq(sub.get(1), 3)
end

@test
def test_copied_slice_window_and_empty_rows() -> Unit
  var v = Vec[Int]::new()
  v.push(10)
  v.push(20)
  v.push(30)
  v.push(40)
  # A middle window: [1, 1 + 2) = items 20, 30.
  let mid = copied_slice(v, 1, 2)
  assert_eq(mid.len(), 2)
  assert_eq(mid.get(0), 20)
  assert_eq(mid.get(1), 30)
  let f = assert_some(mid.first())
  assert_eq(f, 20)
  # The empty window is legal and reads as empty.
  let empty = copied_slice(v, 0, 0)
  assert_eq(empty.len(), 0)
  assert_true(empty.is_empty())
  match empty.first()
  when Option::Some(_) then assert_false(true)
  when Option::None then ()
  end
  match empty.last()
  when Option::Some(_) then assert_false(true)
  when Option::None then ()
  end
  # An out-of-range read TRAPS (the std OOB policy).
  let whole = make_copy_window()
  let trapped = catch_panic(|| get_oob(whole))
  assert_some(trapped)
end

def get_oob(s: Slice[Int]) -> Unit
  let _ = s.get(4)
end
