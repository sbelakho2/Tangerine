use std::crypto
use std::core::{Vec, String, Unit}

test "Golden: SHA-256 hash" do
  # This is a representative test from std/crypto.tg
  let data = "hello".to_string().as_bytes()
  let hash = std::crypto::sha256(data)
  # Standard hex for "hello" SHA-256
  # 2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824
  assert hash.len() == 32
end

test "Negative: Invalid key for AES" do
  let key = [0u8; 10] # Invalid length (AES needs 16, 24, or 32)
  let data = [0u8; 16]
  let res = std::crypto::aes_encrypt(&key, &data)
  match res
  when Err(e) then
    assert e.code() == std::gfx_errors::ErrorCode::InvalidArg
  when Ok(_) then
    assert false
  end
end

test "Oracle: MD5 legacy compatibility" do
  # Test MD5 against known value
  let mut m = std::crypto::Md5::new()
  m.update("abc".to_string().as_bytes())
  let digest = m.finalize()
  # MD5("abc") = 900150983cd24fb0d6963f7d28e17f72
  assert digest[0] == 0x90
  assert digest[1] == 0x01
end

test "Metamorphic: Multi-part vs Single-part update" do
  let data = "this is a test".to_string().as_bytes()
  
  let h1 = std::crypto::sha256(data)
  
  let mut hasher = std::crypto::Sha256::new()
  hasher.update(data.slice(0, 4))
  hasher.update(data.slice(4, data.len()))
  let h2 = hasher.finalize()
  
  assert h1 == h2
end

test "Lifecycle: Hasher reuse/reset" do
  # Some hashers support reset, or just creating a new one
  let mut hasher = std::crypto::Sha256::new()
  hasher.update("1".to_string().as_bytes())
  let res1 = hasher.finalize()
  
  # New hasher for same input
  let mut hasher2 = std::crypto::Sha256::new()
  hasher2.update("1".to_string().as_bytes())
  let res2 = hasher2.finalize()
  
  assert res1 == res2
end
