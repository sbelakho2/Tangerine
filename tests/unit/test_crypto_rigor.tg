@test
def test_sha1_fips180_1_vectors() -> Unit
  let empty: Vec[u8] = Vec::new()
  let d_empty = std::crypto::sha1(&empty)
  assert_eq(std::crypto::hex::encode(&d_empty), "da39a3ee5e6b4b0d3255bfef95601890afd80709")

  let abc = "abc".to_string().as_bytes()
  let d_abc = std::crypto::sha1(abc)
  assert_eq(std::crypto::hex::encode(&d_abc), "a9993e364706816aba3e25717850c26c9cd0d89d")

  let two_block = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_string().as_bytes()
  let d_two = std::crypto::sha1(two_block)
  assert_eq(std::crypto::hex::encode(&d_two), "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
end

# ———————————————————————————————————————————————————————————————
# MD5 (RFC 1321 §A.5 — full test suite)
# ———————————————————————————————————————————————————————————————

@test
def test_md5_rfc1321_suite() -> Unit
  let empty: Vec[u8] = Vec::new()
  let d_empty = std::crypto::md5(&empty)
  assert_eq(std::crypto::hex::encode(&d_empty), "d41d8cd98f00b204e9800998ecf8427e")

  let a = "a".to_string().as_bytes()
  let d_a = std::crypto::md5(a)
  assert_eq(std::crypto::hex::encode(&d_a), "0cc175b9c0f1b6a831c399e269772661")

  let abc = "abc".to_string().as_bytes()
  let d_abc = std::crypto::md5(abc)
  assert_eq(std::crypto::hex::encode(&d_abc), "900150983cd24fb0d6963f7d28e17f72")

  let msg = "message digest".to_string().as_bytes()
  let d_msg = std::crypto::md5(msg)
  assert_eq(std::crypto::hex::encode(&d_msg), "f96b697d7cb7938d525a2f31aaf161d0")

  let alpha = "abcdefghijklmnopqrstuvwxyz".to_string().as_bytes()
  let d_alpha = std::crypto::md5(alpha)
  assert_eq(std::crypto::hex::encode(&d_alpha), "c3fcd3d76192e4007dfb496cca67e13b")

  let mixed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".to_string().as_bytes()
  let d_mixed = std::crypto::md5(mixed)
  assert_eq(std::crypto::hex::encode(&d_mixed), "d174ab98d277d9f5a5611c2c9f419d9f")

  let digits = "12345678901234567890123456789012345678901234567890123456789012345678901234567890".to_string().as_bytes()
  let d_digits = std::crypto::md5(digits)
  assert_eq(std::crypto::hex::encode(&d_digits), "57edf4a22be3c955ac49da2e2107b67a")
end

# ———————————————————————————————————————————————————————————————
# SHA-3 / SHAKE (FIPS 202)
# ———————————————————————————————————————————————————————————————

@test
def test_sha3_fips202_vectors() -> Unit
  let empty: Vec[u8] = Vec::new()
  let s3_256_empty = std::crypto::sha3_256(&empty)
  assert_eq(std::crypto::hex::encode(&s3_256_empty), "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")

  let abc = "abc".to_string().as_bytes()
  let s3_256_abc = std::crypto::sha3_256(abc)
  assert_eq(std::crypto::hex::encode(&s3_256_abc), "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")

  let s3_512_empty = std::crypto::sha3_512(&empty)
  assert_eq(std::crypto::hex::encode(&s3_512_empty), "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26")

  let s3_512_abc = std::crypto::sha3_512(abc)
  assert_eq(std::crypto::hex::encode(&s3_512_abc), "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0")

  let sk128 = std::crypto::shake128(&empty, 32)
  assert_eq(std::crypto::hex::encode(sk128.as_slice()), "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26")

  let sk256 = std::crypto::shake256(&empty, 32)
  assert_eq(std::crypto::hex::encode(sk256.as_slice()), "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f")
end

# ———————————————————————————————————————————————————————————————
# HMAC-SHA256 (RFC 4231 — Test Cases 1, 2, 3, 4, 6, 7)
# ———————————————————————————————————————————————————————————————

@test
def test_hmac_sha256_rfc4231_vectors() -> Unit
  # Test Case 1: 20-byte key 0x0b, data "Hi There"
  let k1 = _bytes_of(0x0b, 20)
  let d1 = std::crypto::hmac_sha256(&k1, "Hi There".to_string().as_bytes())
  assert_eq(std::crypto::hex::encode(&d1), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")

  # Test Case 2: key "Jefe", data "what do ya want for nothing?"
  let k2 = "Jefe".to_string().as_bytes()
  let d2 = std::crypto::hmac_sha256(k2, "what do ya want for nothing?".to_string().as_bytes())
  assert_eq(std::crypto::hex::encode(&d2), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")

  # Test Case 3: 20-byte key 0xaa, 50-byte data 0xdd
  let k3 = _bytes_of(0xaa, 20)
  let data3 = _bytes_of(0xdd, 50)
  let d3 = std::crypto::hmac_sha256(&k3, &data3)
  assert_eq(std::crypto::hex::encode(&d3), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")

  # Test Case 4: 25-byte key 0x01..0x19, 50-byte data 0xcd
  let k4 = _bytes_from_hex("0102030405060708090a0b0c0d0e0f10111213141516171819")
  let data4 = _bytes_of(0xcd, 50)
  let d4 = std::crypto::hmac_sha256(&k4, &data4)
  assert_eq(std::crypto::hex::encode(&d4), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")

  # Test Case 6: 131-byte key 0xaa, "Test Using Larger Than Block-Size Key - Hash Key First"
  let k6 = _bytes_of(0xaa, 131)
  let d6 = std::crypto::hmac_sha256(&k6, "Test Using Larger Than Block-Size Key - Hash Key First".to_string().as_bytes())
  assert_eq(std::crypto::hex::encode(&d6), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")

  # Test Case 7: 131-byte key 0xaa, long data (larger than block size on both)
  let d7 = std::crypto::hmac_sha256(&k6, "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.".to_string().as_bytes())
  assert_eq(std::crypto::hex::encode(&d7), "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")
end

@test
def test_hmac_sha256_empty_key_behavior() -> Unit
  # An empty key zero-fills the 64-byte key block (defined behavior; the
  # digest equals HMAC with a 64-byte zero key, verified against a
  # reference implementation).
  let k: Vec[u8] = Vec::new()
  let d = std::crypto::hmac_sha256(&k, "abc".to_string().as_bytes())
  assert_eq(std::crypto::hex::encode(&d), "fd7adb152c05ef80dccf50a1fa4c05d5a3ec6da95575fc312ae7c5d091836351")
end

# ———————————————————————————————————————————————————————————————
# PBKDF2-HMAC-SHA256 (RFC 7914 §11 — the published SHA-256 vectors;
# RFC 6070 vectors are PBKDF2-HMAC-SHA1 and do not apply to this module)
# ———————————————————————————————————————————————————————————————

@test
def test_pbkdf2_sha256_rfc7914_vectors() -> Unit
  let pw = "passwd".to_string().as_bytes()
  let salt = "salt".to_string().as_bytes()

  let dk1 = std::crypto::pbkdf2_sha256_core(pw, salt, 1, 64)
  assert_eq(std::crypto::hex::encode(dk1.as_slice()), "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783")

  let dk2 = std::crypto::pbkdf2_sha256_core(pw, salt, 2, 64)
  assert_eq(std::crypto::hex::encode(dk2.as_slice()), "2d412f896e76685e30df569f0a740634e31f031f749d607d9e44210bffb91a6ab670f500c78862001959f7d7b9f96afb3605700298acb14427e0239463c66f20")

  let dk4096 = std::crypto::pbkdf2_sha256_core(pw, salt, 4096, 64)
  assert_eq(std::crypto::hex::encode(dk4096.as_slice()), "21943fd5b7a10905c38fad60157ff498e1e81df1e03254325682a74dca3b2be8f3ab1ccb49d0a5095e69792ba334c6fdaf55d266a9922c760d3c5f5c3ec22c52")
end

@test
def test_pbkdf2_sha256_iteration_floor_and_zero() -> Unit
  let pw = "passwd".to_string().as_bytes()
  let salt = "salt".to_string().as_bytes()

  # The public wrapper raises sub-floor counts to PBKDF2_MIN_ITERATIONS
  # (210000): iterations = 1 (and 0) must yield the 210000-iteration digest.
  let clamped = std::crypto::pbkdf2_sha256(pw, salt, 1, 32)
  assert_eq(std::crypto::hex::encode(clamped.as_slice()), "62a1542e270dad75a0e593ec0ff5701d9d1cffb80004be8155ef02a8a518cf62")

  let zero = std::crypto::pbkdf2_sha256(pw, salt, 0, 32)
  assert_eq(std::crypto::hex::encode(zero.as_slice()), "62a1542e270dad75a0e593ec0ff5701d9d1cffb80004be8155ef02a8a518cf62")

  # The raw core has no floor: c = 0 collapses to the single U1 block
  # (identical to c = 1) — a defined, deterministic behavior.
  let c0 = std::crypto::pbkdf2_sha256_core(pw, salt, 0, 20)
  let c1 = std::crypto::pbkdf2_sha256_core(pw, salt, 1, 20)
  assert_eq(std::crypto::hex::encode(c0.as_slice()), std::crypto::hex::encode(c1.as_slice()))
  assert_eq(std::crypto::hex::encode(c1.as_slice()), "55ac046e56e3089fec1691c22544b605f9418521")
end

# ———————————————————————————————————————————————————————————————
# AES (FIPS 197 Appendix C) + round trips
# ———————————————————————————————————————————————————————————————

@test
def test_aes_fips197_vectors() -> Unit
  # Appendix C.1 — AES-128: key 000102...0f, plaintext 001122...eeff
  let key128 = _fixed16("000102030405060708090a0b0c0d0e0f")
  let plaintext = _fixed16("00112233445566778899aabbccddeeff")
  let aes128 = std::crypto::Aes::new_128(&key128)
  let ct128 = aes128.encrypt_block(&plaintext)
  assert_eq(std::crypto::hex::encode(&ct128), "69c4e0d86a7b0430d8cdb78070b4c55a")
  let rt128 = aes128.decrypt_block(&ct128)
  assert_eq(std::crypto::hex::encode(&rt128), "00112233445566778899aabbccddeeff")

  # Appendix C.3 — AES-256: key 000102...1f
  let key256 = _fixed32("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
  let aes256 = std::crypto::Aes::new_256(&key256)
  let ct256 = aes256.encrypt_block(&plaintext)
  assert_eq(std::crypto::hex::encode(&ct256), "8ea2b7ca516745bfeafc49904b496089")
  let rt256 = aes256.decrypt_block(&ct256)
  assert_eq(std::crypto::hex::encode(&rt256), "00112233445566778899aabbccddeeff")
end

@test
def test_aes_block_round_trip_extra_vectors() -> Unit
  # Extra fixed blocks exercised through both key sizes (round-trip + fixed
  # ciphertext for a second known plaintext).
  let key128 = _fixed16("2b7e151628aed2a6abf7158809cf4f3c")
  let pt_a = _fixed16("6bc1bee22e409f96e93d7e117393172a")
  let aes128 = std::crypto::Aes::new_128(&key128)
  let ct_a = aes128.encrypt_block(&pt_a)
  assert_eq(std::crypto::hex::encode(&ct_a), "3ad77bb40d7a3660a89ecaf32466ef97")
  assert_eq(std::crypto::hex::encode(aes128.decrypt_block(&ct_a)), "6bc1bee22e409f96e93d7e117393172a")

  let key256 = _fixed32("603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4")
  let aes256 = std::crypto::Aes::new_256(&key256)
  let ct_b = aes256.encrypt_block(&pt_a)
  assert_eq(std::crypto::hex::encode(&ct_b), "f3eed1bdb5d2a03c064b5a7e3db181f8")
  assert_eq(std::crypto::hex::encode(aes256.decrypt_block(&ct_b)), "6bc1bee22e409f96e93d7e117393172a")
end

@test
def test_aes_cbc_round_trip() -> Unit
  let key = _fixed16("2b7e151628aed2a6abf7158809cf4f3c")
  let iv = _fixed16("000102030405060708090a0b0c0d0e0f")
  let plaintext = _bytes_from_hex("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51")

  let ciphertext = std::crypto::aes_cbc_encrypt(&key, &iv, &plaintext).unwrap()
  let recovered = std::crypto::aes_cbc_decrypt(&key, &iv, &ciphertext).unwrap()
  assert_eq(std::crypto::hex::encode(recovered.as_slice()), std::crypto::hex::encode(plaintext.as_slice()))
end

@test
def test_aes_gcm_round_trip_and_tamper() -> Unit
  let key = _fixed32("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
  let nonce = _fixed12("000000000000000000000001")
  let aad = _bytes_from_hex("aabbccdd")
  let plaintext = _bytes_from_hex("00112233445566778899aabbccddeeff")

  let gcm = std::crypto::AesGcm::new(&key).unwrap()
  let (ciphertext, tag) = gcm.encrypt(&nonce, &plaintext, &aad)

  let gcm2 = std::crypto::AesGcm::new(&key).unwrap()
  let recovered = gcm2.decrypt(&nonce, &ciphertext, &aad, &tag).unwrap()
  assert_eq(std::crypto::hex::encode(recovered.as_slice()), std::crypto::hex::encode(plaintext.as_slice()))

  # A tampered tag must fail authentication deterministically.
  let gcm3 = std::crypto::AesGcm::new(&key).unwrap()
  var bad_tag = tag
  bad_tag[0] = bad_tag[0] ^ 1
  let tampered = gcm3.decrypt(&nonce, &ciphertext, &aad, &bad_tag)
  assert_true(_is_err(tampered))
end

# ———————————————————————————————————————————————————————————————
# AES malformed inputs (defined behaviors)
# ———————————————————————————————————————————————————————————————

@test
def test_aes_cbc_key_length_validation() -> Unit
  let iv = _fixed16("000102030405060708090a0b0c0d0e0f")
  let msg = _bytes_from_hex("00112233445566778899aabbccddeeff")

  let k0: Vec[u8] = Vec::new()
  let k10 = _bytes_of(0x00, 10)
  let k24 = _bytes_of(0x00, 24)
  assert_true(_is_err(std::crypto::aes_cbc_encrypt(&k0, &iv, &msg)))
  assert_true(_is_err(std::crypto::aes_cbc_encrypt(&k10, &iv, &msg)))
  assert_true(_is_err(std::crypto::aes_cbc_encrypt(&k24, &iv, &msg)))

  # 16- and 32-byte keys are accepted.
  let k16 = _fixed16("000102030405060708090a0b0c0d0e0f")
  let k32 = _fixed32("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
  assert_true(!_is_err(std::crypto::aes_cbc_encrypt(&k16, &iv, &msg)))
  assert_true(!_is_err(std::crypto::aes_cbc_encrypt(&k32, &iv, &msg)))

  # GCM rejects wrong-length keys too.
  let bad_gcm = std::crypto::AesGcm::new(&k10)
  assert_true(_is_err(bad_gcm))
end

@test
def test_aes_cbc_invalid_ciphertext_length() -> Unit
  let key = _fixed16("2b7e151628aed2a6abf7158809cf4f3c")
  let iv = _fixed16("000102030405060708090a0b0c0d0e0f")
  let short_ct = _pattern_bytes(15)
  assert_true(_is_err(std::crypto::aes_cbc_decrypt(&key, &iv, &short_ct)))
end

@test
def test_aes_cbc_tampered_first_block() -> Unit
  let key = _fixed16("2b7e151628aed2a6abf7158809cf4f3c")
  let iv = _fixed16("000102030405060708090a0b0c0d0e0f")
  let plaintext = _bytes_from_hex("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e51")

  let ciphertext = std::crypto::aes_cbc_encrypt(&key, &iv, &plaintext).unwrap()

  # Corrupting the FIRST block leaves the final padding block intact, so
  # decryption succeeds but the recovered plaintext differs from the input.
  var tampered = ciphertext
  tampered[0] = tampered[0] ^ 0xff
  let recovered = std::crypto::aes_cbc_decrypt(&key, &iv, &tampered).unwrap()
  assert_true(std::crypto::hex::encode(recovered.as_slice()) != std::crypto::hex::encode(plaintext.as_slice()))
end

