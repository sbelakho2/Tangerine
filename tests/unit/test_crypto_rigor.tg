@test
def test_chacha20_rfc8439_block_vector() -> Unit
  let key = _fixed32("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
  let nonce = _fixed12("000000090000004a00000000")
  let block = std::crypto::chacha20_block(&key, &nonce, 1)
  assert_eq(std::crypto::hex::encode(&block), "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e")
end

