# tests/unit/test_crypto_rigor.tg — Known-Answer Tests for std::crypto
#
# Every primitive in std/crypto.tg is exercised against its published KAT
# vectors with FULL digests asserted (no length-only or prefix-only checks):
#
#   SHA-256   FIPS 180-4 (NIST)         empty, "abc", 448-bit two-block,
#                                       million-'a', "hello"
#   SHA-512   FIPS 180-4 (NIST)         empty, "abc", 448-bit two-block,
#                                       million-'a'
#   SHA-1     FIPS 180-1                 empty, "abc", 448-bit two-block
#   MD5       RFC 1321 §A.5              full 7-vector test suite
#   SHA-3     FIPS 202                   SHA3-256 / SHA3-512 (empty, "abc"),
#                                       SHAKE128 / SHAKE256 (empty, 32 bytes)
#   HMAC      RFC 4231 (HMAC-SHA256)     Test Cases 1, 2, 3, 4, 6, 7
#                                       + empty-key defined behavior
#   PBKDF2    RFC 7914 §11 (SHA-256)     c = 1, 2, 4096, dkLen = 64
#                                       + iteration-floor defined behavior
#   AES       FIPS 197 Appendix C        C.1 (AES-128), C.3 (AES-256)
#                                       + block/CBC/GCM round trips
#   ChaCha20  RFC 8439 §2.3.2            counter-1 keystream block
#   hex       module hex::encode/decode  known encodings + malformed inputs
#   base64    RFC 4648 §10               all padding classes + URL-safe forms
#
# Boundary-length tests assert incremental (byte-by-byte) vs one-shot
# equivalence at the SHA padding boundaries (55/56/64/65 for 64-byte blocks,
# 111/112/128/129 for 128-byte blocks), plus empty and single-byte messages.
# Malformed-input tests pin the defined behaviors: wrong-length AES keys,
# invalid ciphertext lengths, tampered tags, invalid hex/base64 input, and
# zero-iteration PBKDF2.

use std::crypto
use std::test::*
use std::core::{Vec, String, Unit, Result, Option}

# ———————————————————————————————————————————————————————————————
# Helpers
# ———————————————————————————————————————————————————————————————

def _bytes_from_hex(s: str) -> Vec[u8]
  std::crypto::hex::decode(s).unwrap()
end

def _pattern_bytes(len: UInt) -> Vec[u8]
  let mut v = Vec::with_capacity(len)
  var i: UInt = 0
  while i < len do
    v.push((i % 251) as u8)
    i = i + 1
  end
  v
end

def _bytes_of(value: u8, len: UInt) -> Vec[u8]
  let mut v = Vec::with_capacity(len)
  var i: UInt = 0
  while i < len do
    v.push(value)
    i = i + 1
  end
  v
end

def _fixed16(s: str) -> [u8; 16]
  let bytes = _bytes_from_hex(s)
  var out = [0u8; 16]
  var i = 0
  while i < 16 do
    out[i] = bytes[i]
    i = i + 1
  end
  out
end

def _fixed32(s: str) -> [u8; 32]
  let bytes = _bytes_from_hex(s)
  var out = [0u8; 32]
  var i = 0
  while i < 32 do
    out[i] = bytes[i]
    i = i + 1
  end
  out
end

def _fixed12(s: str) -> [u8; 12]
  let bytes = _bytes_from_hex(s)
  var out = [0u8; 12]
  var i = 0
  while i < 12 do
    out[i] = bytes[i]
    i = i + 1
  end
  out
end

def _is_err[T, E](result: Result[T, E]) -> Bool
  match result
  when Result::Err(_) then true
  when Result::Ok(_) then false
  end
end

def _check_sha256_incremental(len: UInt) -> Unit
  let msg = _pattern_bytes(len)
  let one_shot = std::crypto::sha256(&msg)
  let mut hasher = std::crypto::Sha256::new()
  let s = msg.as_slice()
  var i = 0
  while i < s.len() do
    hasher.update(s.slice(i, i + 1))
    i = i + 1
  end
  let incremental = hasher.finalize()
  assert_eq(std::crypto::hex::encode(&one_shot), std::crypto::hex::encode(&incremental))
end

def _check_sha512_incremental(len: UInt) -> Unit
  let msg = _pattern_bytes(len)
  let one_shot = std::crypto::sha512(&msg)
  let mut hasher = std::crypto::Sha512::new()
  let s = msg.as_slice()
  var i = 0
  while i < s.len() do
    hasher.update(s.slice(i, i + 1))
    i = i + 1
  end
  let incremental = hasher.finalize()
  assert_eq(std::crypto::hex::encode(&one_shot), std::crypto::hex::encode(&incremental))
end

def _check_sha1_incremental(len: UInt) -> Unit
  let msg = _pattern_bytes(len)
  let one_shot = std::crypto::sha1(&msg)
  let mut hasher = std::crypto::Sha1::new()
  let s = msg.as_slice()
  var i = 0
  while i < s.len() do
    hasher.update(s.slice(i, i + 1))
    i = i + 1
  end
  let incremental = hasher.finalize()
  assert_eq(std::crypto::hex::encode(&one_shot), std::crypto::hex::encode(&incremental))
end

def _check_md5_incremental(len: UInt) -> Unit
  let msg = _pattern_bytes(len)
  let one_shot = std::crypto::md5(&msg)
  let mut hasher = std::crypto::Md5::new()
  let s = msg.as_slice()
  var i = 0
  while i < s.len() do
    hasher.update(s.slice(i, i + 1))
    i = i + 1
  end
  let incremental = hasher.finalize()
  assert_eq(std::crypto::hex::encode(&one_shot), std::crypto::hex::encode(&incremental))
end

# ———————————————————————————————————————————————————————————————
# SHA-256 (FIPS 180-4)
# ———————————————————————————————————————————————————————————————

@test
def test_sha256_fips180_4_vectors() -> Unit
  let empty: Vec[u8] = Vec::new()
  let d_empty = std::crypto::sha256(&empty)
  assert_eq(std::crypto::hex::encode(&d_empty), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

  let abc = "abc".to_string().as_bytes()
  let d_abc = std::crypto::sha256(abc)
  assert_eq(std::crypto::hex::encode(&d_abc), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

  let two_block = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_string().as_bytes()
  let d_two = std::crypto::sha256(two_block)
  assert_eq(std::crypto::hex::encode(&d_two), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")

  let hello = "hello".to_string().as_bytes()
  let d_hello = std::crypto::sha256(hello)
  assert_eq(std::crypto::hex::encode(&d_hello), "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824")
end

@test
def test_sha256_million_a_vector() -> Unit
  let msg = _bytes_of('a' as u8, 1000000)
  let digest = std::crypto::sha256(&msg)
  assert_eq(std::crypto::hex::encode(&digest), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
end

# ———————————————————————————————————————————————————————————————
# SHA-512 (FIPS 180-4)
# ———————————————————————————————————————————————————————————————

@test
def test_sha512_fips180_4_vectors() -> Unit
  let empty: Vec[u8] = Vec::new()
  let d_empty = std::crypto::sha512(&empty)
  assert_eq(std::crypto::hex::encode(&d_empty), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")

  let abc = "abc".to_string().as_bytes()
  let d_abc = std::crypto::sha512(abc)
  assert_eq(std::crypto::hex::encode(&d_abc), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")

  let two_block = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_string().as_bytes()
  let d_two = std::crypto::sha512(two_block)
  assert_eq(std::crypto::hex::encode(&d_two), "204a8fc6dda82f0a0ced7beb8e08a41657c16ef468b228a8279be331a703c33596fd15c13b1b07f9aa1d3bea57789ca031ad85c7a71dd70354ec631238ca3445")
end

@test
def test_sha512_million_a_vector() -> Unit
  let msg = _bytes_of('a' as u8, 1000000)
  let digest = std::crypto::sha512(&msg)
  assert_eq(std::crypto::hex::encode(&digest), "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b")
end

# ———————————————————————————————————————————————————————————————
