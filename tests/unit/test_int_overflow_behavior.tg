# tests/unit/test_int_overflow_behavior.tg — audit §24: the ordinary
# integer arithmetic semantics (overflow / shifts / narrowing) asserted
# at RUNTIME through the std surface.
#
# The language rules under test (see docs/current/language.md
# "Integer Arithmetic Semantics (P1-5 / §24)" and the P1-5 insertion
# point in tg_compiler/mir.tg):
#   1. signed `+` `-` `*` (Int/i8..i64) TRAP on overflow — a trap is a
#      machine-level fault (UD2/UDF), NOT a catchable panic, so the
#      trapping rows are asserted on the lowered MIR (the trap guard's
#      presence at every optimization level — see
#      tests/mir_int_arith_semantics_test.tg) and by the exit-code trap
#      lane (tests/run_int_arith_trap_lane.sh). Nothing in this file
#      may execute a trapping operation.
#   2. unsigned arithmetic (UInt/u8..u64) WRAPS modulo 2^W — plain
#      operators are safe to execute and assert here.
#   3. the explicit std::core families on Int/UInt — wrapping_* /
#      checked_* / saturating_* (impl Int and impl UInt in
#      std/core.tg) — spell the semantics explicitly; the sized widths
#      spell the wrap through the same-width unsigned view (the exact
#      idiom std::core's own wrapping_* bodies use).
#   4. unary negation is raw two's-complement: -MIN == MIN (wrap) on
#      every width.
#   5. shift counts mask to the SHIFTED value's width: a << b ==
#      a << (b & (W-1)); counts >= W and negative counts are defined.
#   6. narrowing `as` casts truncate modulo 2^W in two's complement.
#   7. signed division truncates toward zero on the common in-range
#      values, and the raw `/` `%` edges — divisor zero on every kind
#      and the signed MIN/-1 pair (the quotient step the remainder
#      shares) — TRAP deterministically on every target and route at
#      the emitters' explicit guard (audit item 30). The trapping edges
#      are asserted by the exit-code trap lane
#      (tests/run_int_arith_trap_lane.sh) and are NOT executed here.
#
# Every row is written so that the same file runs identically under
# `tg test -O0 .. -O3` (tests/run_behavior_suites.sh loops the levels)
# — no row depends on constant folding, and no row can trap.

use std::core::{Bool, Int, UInt, Unit, Option, Result, String}
use std::test::*

# The Int/UInt boundary values, spelled without out-of-range literals.
def int_min() -> Int
  -9223372036854775807 - 1
end

def int_max() -> Int
  9223372036854775807
end

def uint_max() -> UInt
  (0 as UInt) - 1
end

# ———————————————————————————————————————————————————————————————
# 1. the std::core explicit families on Int — the wrap VALUES
# ———————————————————————————————————————————————————————————————

@test
def test_int_wrapping_add_max_plus_one() -> Unit
  # MAX + 1 wraps to MIN through the explicit family on Int.
  assert_eq(int_max().wrapping_add(1), int_min())
end

@test
def test_int_wrapping_sub_min_minus_one() -> Unit
  # MIN - 1 wraps to MAX through the explicit family on Int.
  assert_eq(int_min().wrapping_sub(1), int_max())
end

@test
def test_int_wrapping_mul_min_times_minus_one() -> Unit
  # MIN * -1 wraps to MIN (two's complement) on Int.
  assert_eq(int_min().wrapping_mul(-1), int_min())
end

@test
def test_int_wrapping_mul_max_times_two() -> Unit
  # MAX * 2 wraps to -2 (MAX*2 = 2^64 - 2 in the unsigned view).
  assert_eq(int_max().wrapping_mul(2), -2)
end

# ———————————————————————————————————————————————————————————————
# 2. the std::core explicit families on Int — checked_* (None on
#    overflow, Some(value) otherwise)
# ———————————————————————————————————————————————————————————————

@test
def test_int_checked_add_overflow_rows() -> Unit
  match int_max().checked_add(1)
  when Option::Some(_) then panic("checked_add(MAX, 1) must be None")
  when Option::None then ()
  end
  match int_min().checked_add(-1)
  when Option::Some(_) then panic("checked_add(MIN, -1) must be None")
  when Option::None then ()
  end
  match int_max().checked_add(0)
  when Option::Some(v) then assert_eq(v, int_max())
  when Option::None then panic("checked_add(MAX, 0) must be Some")
  end
end

@test
def test_int_checked_sub_overflow_rows() -> Unit
  match int_min().checked_sub(1)
  when Option::Some(_) then panic("checked_sub(MIN, 1) must be None")
  when Option::None then ()
  end
  match int_max().checked_sub(-1)
  when Option::Some(_) then panic("checked_sub(MAX, -1) must be None")
  when Option::None then ()
  end
  match int_min().checked_sub(0)
  when Option::Some(v) then assert_eq(v, int_min())
  when Option::None then panic("checked_sub(MIN, 0) must be Some")
  end
end

@test
def test_int_checked_mul_overflow_rows() -> Unit
  # MIN * -1 overflows (the result 2^63 does not fit Int).
  match int_min().checked_mul(-1)
  when Option::Some(_) then panic("checked_mul(MIN, -1) must be None")
  when Option::None then ()
  end
  # MAX * 2 overflows.
  match int_max().checked_mul(2)
  when Option::Some(_) then panic("checked_mul(MAX, 2) must be None")
  when Option::None then ()
  end
  # MIN * 1 is exact (MIN is in range) — Some.
  match int_min().checked_mul(1)
  when Option::Some(v) then assert_eq(v, int_min())
  when Option::None then panic("checked_mul(MIN, 1) must be Some")
  end
end

# ———————————————————————————————————————————————————————————————
# 3. the std::core explicit families — saturating_* clamps
# ———————————————————————————————————————————————————————————————

@test
def test_int_saturating_rows() -> Unit
  assert_eq(int_max().saturating_add(1), int_max())
  assert_eq(int_min().saturating_add(-1), int_min())
  assert_eq(int_min().saturating_sub(1), int_min())
  assert_eq(int_max().saturating_sub(-1), int_max())
  assert_eq(int_max().saturating_mul(2), int_max())
  assert_eq(int_min().saturating_mul(-1), int_max())
  assert_eq(int_min().saturating_mul(1), int_min())
end

# ———————————————————————————————————————————————————————————————
# 4. the std::core explicit families on UInt — wrap + clamp + check
#    (UInt arithmetic is the mod-2^64 domain by definition)
# ———————————————————————————————————————————————————————————————

@test
def test_uint_wrapping_rows() -> Unit
  # MAX + 1 == 0, 0 - 1 == MAX, MAX * 2 == MAX * 2 mod 2^64.
  assert_eq(uint_max().wrapping_add(1), 0 as UInt)
  assert_eq((0 as UInt).wrapping_sub(1), uint_max())
  let max_times_two = uint_max().wrapping_mul(2)
  assert_eq(max_times_two, uint_max() - 1)
end

@test
def test_uint_checked_rows() -> Unit
  match uint_max().checked_add(1)
  when Option::Some(_) then panic("checked_add(MAX, 1) on UInt must be None")
  when Option::None then ()
  end
  match (0 as UInt).checked_sub(1)
  when Option::Some(_) then panic("checked_sub(0, 1) on UInt must be None")
  when Option::None then ()
  end
  match uint_max().checked_mul(2)
  when Option::Some(_) then panic("checked_mul(MAX, 2) on UInt must be None")
  when Option::None then ()
  end
  match (0 as UInt).checked_sub(0)
  when Option::Some(v) then assert_eq(v, 0 as UInt)
  when Option::None then panic("checked_sub(0, 0) on UInt must be Some")
  end
end

@test
def test_uint_saturating_rows() -> Unit
  assert_eq(uint_max().saturating_add(1), uint_max())
  assert_eq((0 as UInt).saturating_sub(1), 0 as UInt)
  assert_eq(uint_max().saturating_mul(2), uint_max())
end

# ———————————————————————————————————————————————————————————————
# 5. plain operators per width — the unsigned plain rule IS wrap; the
#    sized signed wrap is spelled through the same-width unsigned view
#    (the std::core wrapping_* bodies' own idiom), so every width has
#    an executable wrap row without ever trapping.
# ———————————————————————————————————————————————————————————————

@test
def test_plain_unsigned_wrap_rows() -> Unit
  assert_eq((255 as u8) + (1 as u8), 0 as u8)
  assert_eq((0 as u8) - (1 as u8), 255 as u8)
  assert_eq((65535 as u16) + (1 as u16), 0 as u16)
  assert_eq((4294967295 as u32) + (1 as u32), 0 as u32)
  let u64_max = (0 as u64) - (1 as u64)
  assert_eq(u64_max + (1 as u64), 0 as u64)
  assert_eq(u64_max * u64_max, 1 as u64)
  assert_eq((0 as UInt) - (1 as UInt), uint_max())
end

@test
def test_sized_signed_wrap_rows() -> Unit
  # i8: 127 + 1 == -128 through the unsigned 8-bit view.
  let i8_max: i8 = 127
  let i8_wrap: i8 = ((i8_max as u8) + (1 as u8)) as i8
  assert_eq(i8_wrap, -128 as i8)
  # i8: -128 - 1 == 127.
  let i8_min: i8 = -128
  let i8_under: i8 = ((i8_min as u8) - (1 as u8)) as i8
  assert_eq(i8_under, 127 as i8)
  # i16: 32767 + 1 == -32768.
  let i16_max: i16 = 32767
  let i16_wrap: i16 = ((i16_max as u16) + (1 as u16)) as i16
  assert_eq(i16_wrap, -32768 as i16)
  # i32: 2^31 - 1 + 1 == -2^31.
  let i32_max: i32 = 2147483647
  let i32_wrap: i32 = ((i32_max as u32) + (1 as u32)) as i32
  let i32_min_value: i32 = -2147483647 - 1
  assert_eq(i32_wrap, i32_min_value)
  # i64: the u64-view wrap equals the Int wrap row bit-for-bit.
  let i64_max: i64 = 9223372036854775807
  let i64_wrap: i64 = ((i64_max as u64) + (1 as u64)) as i64
  let i64_min_value: i64 = -9223372036854775807 - 1
  let i64_max_value: i64 = 9223372036854775807
  assert_eq(i64_wrap, i64_min_value)
  let i64_under: i64 = ((i64_min_value as u64) - (1 as u64)) as i64
  assert_eq(i64_under, i64_max_value)
  # MIN * -1 through the unsigned view == MIN (the wrapping_mul row).
  let i64_mul: i64 = ((i64_min_value as u64) * ((-1 as i64) as u64)) as i64
  assert_eq(i64_mul, i64_min_value)
end

# ———————————————————————————————————————————————————————————————
# 6. negate MIN — raw two's-complement: -MIN == MIN on every width
# ———————————————————————————————————————————————————————————————

@test
def test_negate_min_wraps() -> Unit
  let imin: Int = int_min()
  assert_eq(-imin, int_min())
  let i8_min: i8 = -128
  assert_eq(-i8_min, -128 as i8)
  let i16_min: i16 = -32768
  assert_eq(-i16_min, -32768 as i16)
  let i32_min: i32 = -2147483647 - 1
  let i32_neg_min: i32 = -i32_min
  assert_eq(i32_neg_min, i32_min)
  let i64_min: i64 = -9223372036854775807 - 1
  let i64_neg_min: i64 = -i64_min
  assert_eq(i64_neg_min, i64_min)
end

# ———————————————————————————————————————————————————————————————
# 7. shifts — the §24 count rule: count & (W-1) on the SHIFTED value's
#    width; counts >= W and negative counts are defined and
#    target-independent.
# ———————————————————————————————————————————————————————————————

@test
def test_shift_count_masking_64_bit_rows() -> Unit
  # 1 << 64 == 1 << (64 & 63) == 1.
  assert_eq((1 as u64) << 64, 1 as u64)
  assert_eq((1 as UInt) << 64, 1 as UInt)
  assert_eq((1 as Int) << 64, 1 as Int)
  # 1 << 70 == 1 << 6 == 64.
  assert_eq((1 as u64) << 70, 64 as u64)
  # A negative count is the two's-complement low bits: -1 == 63.
  let shl_m1 = (1 as Int) << -1
  let shl_63 = (1 as Int) << 63
  assert_eq(shl_m1, shl_63)
  # >> by >= width: -1 >> 64 == -1 >> 0 == -1 (arithmetic shift).
  assert_eq((-1 as Int) >> 64, -1 as Int)
  assert_eq((-1 as Int) >> -1, -1 as Int)
  assert_eq((-1 as Int) >> 63, -1 as Int)
end

@test
def test_shift_count_masking_small_width_rows() -> Unit
  # u8/i8: count & 7.
  assert_eq((1 as u8) << 8, 1 as u8)
  assert_eq((1 as i8) << 8, 1 as i8)
  assert_eq((255 as u8) >> 8, 255 as u8)
  assert_eq((1 as u8) << 15, 128 as u8)
  # u16/i16: count & 15.
  assert_eq((1 as u16) << 16, 1 as u16)
  assert_eq((1 as i16) << 16, 1 as i16)
  # u32/i32: count & 31.
  assert_eq((1 as u32) << 32, 1 as u32)
  assert_eq((1 as i32) << 32, 1 as i32)
  # In-range counts keep the pre-rule values (the mask is the identity
  # below W): the canonical power-of-two byte walk.
  assert_eq((1 as u64) << 40, 1099511627776 as u64)
  assert_eq((255 as u8) >> 4, 15 as u8)
  assert_eq((-128 as i8) >> 7, -1 as i8)
end

# ———————————————————————————————————————————————————————————————
# 8. narrowing conversions — two's-complement truncation modulo 2^W
# ———————————————————————————————————————————————————————————————

@test
def test_narrow_conversions_rows() -> Unit
  # Int -> u8: 300 mod 256 == 44; -1 -> 255.
  assert_eq(300 as u8, 44 as u8)
  assert_eq((-1 as Int) as u8, 255 as u8)
  # Int -> i8: 128 -> -128; -129 -> 127; 127 stays.
  assert_eq(128 as i8, -128 as i8)
  assert_eq(-129 as i8, 127 as i8)
  assert_eq(127 as i8, 127 as i8)
  # Int -> u16: 65537 -> 1.
  assert_eq(65537 as u16, 1 as u16)
  assert_eq(65537 as i16, 1 as i16)
  # Int -> i32: 2^31 -> MIN; -(2^31 + 1) -> MAX.
  let two_pow_31 = 2147483648
  let i32_min_value: i32 = -2147483647 - 1
  assert_eq(two_pow_31 as i32, i32_min_value)
  let neg_two_pow_31_minus_1 = -2147483649
  let i32_max_value: i32 = 2147483647
  assert_eq(neg_two_pow_31_minus_1 as i32, i32_max_value)
  # Int -> u32: 2^32 -> 0; -1 -> 2^32 - 1.
  assert_eq(4294967296 as u32, 0 as u32)
  assert_eq((-1 as Int) as u32, 4294967295 as u32)
  # Same-width bit reinterpretation: -1 as u64 == 2^64 - 1.
  assert_eq((-1 as Int) as u64, (0 as u64) - (1 as u64))
  # u64 -> u8 narrows modulo 256.
  assert_eq(((0 as u64) - (1 as u64)) as u8, 255 as u8)
end

# ———————————————————————————————————————————————————————————————
# 9. division sanity — the in-range rows (x86 idiv and AArch64 sdiv/udiv
#    truncate toward zero), including the boundary rows around the trap
#    edges (the divisor-zero and signed MIN/-1 edges themselves TRAP at
#    the emitters' explicit guard — see the file header and
#    tests/run_int_arith_trap_lane.sh — and are absent here).
# ———————————————————————————————————————————————————————————————

@test
def test_division_common_rows() -> Unit
  assert_eq(84 / 12, 7)
  assert_eq(-84 / 12, -7)
  assert_eq(84 / -12, -7)
  assert_eq(-84 / -12, 7)
  assert_eq(-7 / 2, -3)
  assert_eq(7 % 2, 1)
  assert_eq(-7 % 2, -1)
  assert_eq(7 % -2, 1)
  assert_eq(-7 % -2, -1)
  # The MIN boundary rows that must NOT trap (only the divisor-zero and
  # MIN/-1 edges trap, for `/` and `%` alike): MIN / 1 is exact, MIN / 2
  # truncates toward zero, and both remainders against 1/2 are 0.
  assert_eq(int_min() / 1, int_min())
  assert_eq(int_min() / 2, -4611686018427387904)
  assert_eq(int_max() / 2, 4611686018427387903)
  assert_eq(int_min() % 1, 0)
  assert_eq(int_min() % 2, 0)
  let u64_max = (0 as u64) - (1 as u64)
  assert_eq(u64_max / 2, 9223372036854775807 as u64)
  assert_eq((0 as UInt) / 2, 0 as UInt)
end
