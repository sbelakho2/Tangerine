# tests/unit/test_slice_sub_oob.tg — audit item 1 (Slice::sub): the
# sub-view validates its range BEFORE any pointer arithmetic. Every
# out-of-bounds shape TRAPS with the std OOB policy (panic) instead of
# computing the copy-source address out of the pinned allocation:
#   - a negative start;
#   - a length beyond the parent window;
#   - a window that starts past the parent's end.
# The valid sub-window rows keep working (the range checks are a gate,
# not a behavior change). The panic is observed through catch_panic (the
# runner's single destruction/unwind surface).

use std::collections
use std::core::{Option, Unit, Int, Vec}
use std::test::{assert_eq, assert_false, assert_some, assert_contains, catch_panic}

def make_slice() -> Slice[Int]
  var v = Vec[Int]::new()
  v.push(10)
  v.push(20)
  v.push(30)
  copied_slice(v, 0, 3)
end

def sub_negative_start(s: Slice[Int]) -> Unit
  let _ = s.sub(-1, 1)
end

def sub_length_too_long(s: Slice[Int]) -> Unit
  let _ = s.sub(0, 4)
end

def sub_start_past_end(s: Slice[Int]) -> Unit
  let _ = s.sub(3, 1)
end

def sub_end_past_end(s: Slice[Int]) -> Unit
  let _ = s.sub(2, 2)
end

def sub_valid(s: Slice[Int]) -> Unit
  let _ = s.sub(1, 2)
end

@test
def test_sub_negative_start_traps_before_pointer_math() -> Unit
  let s = make_slice()
  let msg = catch_panic(|| sub_negative_start(s))
  let m = assert_some(msg)
  assert_contains(m, "negative start index")
end

@test
def test_sub_length_beyond_window_traps() -> Unit
  let s = make_slice()
  let msg = catch_panic(|| sub_length_too_long(s))
  let m = assert_some(msg)
  assert_contains(m, "length exceeds the slice length")
end

@test
def test_sub_start_past_window_end_traps() -> Unit
  let s = make_slice()
  let msg = catch_panic(|| sub_start_past_end(s))
  let m = assert_some(msg)
  assert_contains(m, "window starts past the slice end")
end

@test
def test_sub_window_ending_past_window_end_traps() -> Unit
  let s = make_slice()
  let msg = catch_panic(|| sub_end_past_end(s))
  let m = assert_some(msg)
  assert_contains(m, "window starts past the slice end")
end

@test
def test_sub_valid_window_still_works() -> Unit
  let s = make_slice()
  let sub = s.sub(1, 2)
  assert_eq(sub.len(), 2)
  assert_eq(sub.get(0), 20)
  assert_eq(sub.get(1), 30)
  # The parent window is unaffected by the valid sub above.
  assert_eq(s.len(), 3)
  # The valid sub never panics (its own slice — the capture consumes it).
  let s2 = make_slice()
  let ok = catch_panic(|| sub_valid(s2))
  match ok
  when Option::None then ()
  when Option::Some(_) then assert_false(true)
  end
end
