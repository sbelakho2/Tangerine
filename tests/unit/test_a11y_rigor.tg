use std::test
use std::accessibility::{A11yNode, Role, tree_emit, accessibility_cap}
use std::geom::{Rect}
use std::core::{Result, Unit, Vec, String}
use std::gfx_errors::{AccessibilityError, ErrorCode}
use std::capabilities::{custom_cap}

# ═══════════════════════════════════════════════════════════════
# GOLDEN VECTOR SUITE
# ═══════════════════════════════════════════════════════════════

test "Golden: single button tree" do
  let cap = accessibility_cap()
  let node = A11yNode {
    id: 1,
    role: Role::Button,
    label: "Golden Button",
    rect: Rect { x: 0.0, y: 0.0, width: 100.0, height: 40.0 },
    focusable: true,
    children: Vec::new(),
  }
  
  let res = tree_emit(&node, &cap)
  assert res.is_ok()
end

# ═══════════════════════════════════════════════════════════════
# NEGATIVE SUITE
# ═══════════════════════════════════════════════════════════════

test "Negative: missing capability" do
  let invalid_cap = custom_cap("WrongCap")
  let node = A11yNode {
    id: 1,
    role: Role::Window,
    label: "No Cap Window",
    rect: Rect { x: 0.0, y: 0.0, width: 800.0, height: 600.0 },
    focusable: false,
    children: Vec::new(),
  }
  
  let res = tree_emit(&node, &invalid_cap)
  assert res.is_err()
  
  match res
  when Result::Err(AccessibilityError::PermissionDenied(e)) then
    assert e.code == ErrorCode::PermissionDenied
  else
    assert false
  end
end

# ═══════════════════════════════════════════════════════════════
# METAMORPHIC SUITE
# ═══════════════════════════════════════════════════════════════

test "Metamorphic: position invariant" do
  let cap = accessibility_cap()
  let node1 = A11yNode {
    id: 1,
    role: Role::Button,
    label: "B",
    rect: Rect { x: 0.0, y: 0.0, width: 100.0, height: 40.0 },
    focusable: true,
    children: Vec::new(),
  }
  
  let node2 = A11yNode {
    id: 1,
    role: Role::Button,
    label: "B",
    rect: Rect { x: 100.0, y: 100.0, width: 100.0, height: 40.0 },
    focusable: true,
    children: Vec::new(),
  }
  
  # Both should emit successfully regardless of absolute position
  assert tree_emit(&node1, &cap).is_ok()
  assert tree_emit(&node2, &cap).is_ok()
end

# ═══════════════════════════════════════════════════════════════
# INDEPENDENT ORACLE SUITE (Simulated)
# ═══════════════════════════════════════════════════════════════

test "Oracle: tree depth validation" do
  # Independent check of tree depth
  def get_depth(node: &A11yNode) -> i32
    let max_child_depth = 0
    let i = 0
    while i < node.children.len() do
      let d = get_depth(&node.children.get(i))
      if d > max_child_depth then
        max_child_depth = d
      end
      i = i + 1
    end
    1 + max_child_depth
  end

  let root = A11yNode {
    id: 1, role: Role::Window, label: "R", rect: Rect::default(), focusable: false,
    children: Vec::of(
      A11yNode { id: 2, role: Role::Button, label: "B", rect: Rect::default(), focusable: true, children: Vec::new() }
    )
  }
  
  assert get_depth(&root) == 2
end
