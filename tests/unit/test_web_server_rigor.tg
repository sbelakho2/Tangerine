# Web Server Rigor Tests
use std::web_server::{Router, HttpServer}
use std::http::{HttpRequest, HttpResponse, HttpMethod, HttpStatus}
use std::url::Url
use std::test::{assert_eq, assert_true}

test "Golden: Routing logic" do
  let mut router = Router::new()
  router.get("/hello".to_string(), |req| {
    HttpResponse::ok("world".to_string())
  })
  
  let url = Url::parse("http://localhost/hello").unwrap()
  let req = HttpRequest {
    method: HttpMethod::Get,
    url: url,
    headers: Map::new(),
    body: Vec::new(),
  }
  
  let resp = router.handle(req)
  assert resp.status.code == 200
  assert String::from_utf8_lossy(&resp.body) == "world"
end

test "Negative: 404 handling" do
  let mut router = Router::new()
  let url = Url::parse("http://localhost/notfound").unwrap()
  let req = HttpRequest {
    method: HttpMethod::Get,
    url: url,
    headers: Map::new(),
    body: Vec::new(),
  }
  
  let resp = router.handle(req)
  assert resp.status.code == 404
end
