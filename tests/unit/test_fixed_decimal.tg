use std::math
use std::core::{String, Vec, Unit}

test "Golden: Fixed64 parse/format round trip" do
  let v = std::math::Fixed64::from_string("1234.5678".to_string()).unwrap()
  assert v.scale() == 4
  assert v.to_string() == "1234.5678"
end

test "Golden: Fixed64 negative fraction formatting" do
  let v = std::math::Fixed64::from_string("-0.50".to_string()).unwrap()
  assert v.to_string() == "-0.50"
end

test "Oracle: Fixed64 same-scale addition" do
  let a = std::math::Fixed64::from_string("1.25".to_string()).unwrap()
  let b = std::math::Fixed64::from_string("2.75".to_string()).unwrap()
  assert a.add(b).unwrap().to_string() == "4.00"
end

test "Oracle: Fixed64 cross-scale addition aligns to the larger scale" do
  let a = std::math::Fixed64::from_string("1.5".to_string()).unwrap()
  let b = std::math::Fixed64::from_string("2.25".to_string()).unwrap()
  assert a.add(b).unwrap().to_string() == "3.75"
end

test "Oracle: Fixed64 subtraction stays exact" do
  let a = std::math::Fixed64::from_string("1.00".to_string()).unwrap()
  let b = std::math::Fixed64::from_string("0.05".to_string()).unwrap()
  assert a.sub(b).unwrap().to_string() == "0.95"
end

test "Oracle: Fixed64 exact product keeps the summed scale" do
  let a = std::math::Fixed64::from_string("1.25".to_string()).unwrap()
  let b = std::math::Fixed64::from_string("2.00".to_string()).unwrap()
  assert a.mul(b).unwrap().to_string() == "2.5000"
end

test "Golden: Fixed64 division with explicit half-up rounding" do
  let one = std::math::Fixed64::from_int(1)
  let three = std::math::Fixed64::from_int(3)
  let q = one.div(three, 6, std::math::RoundingMode::HalfUp).unwrap()
  assert q.to_string() == "0.333333"
end

test "Golden: Fixed64 division rounds half to even" do
  let v = std::math::Fixed64::from_string("2.5".to_string()).unwrap()
  let one = std::math::Fixed64::from_int(1)
  let even = v.div(one, 0, std::math::RoundingMode::HalfEven).unwrap()
  assert even.to_string() == "2"
  let up = v.div(one, 0, std::math::RoundingMode::HalfUp).unwrap()
  assert up.to_string() == "3"
end

test "Golden: Fixed64 division Floor/Ceiling on negatives" do
  let v = std::math::Fixed64::from_string("-1.5".to_string()).unwrap()
  let one = std::math::Fixed64::from_int(1)
  assert v.div(one, 0, std::math::RoundingMode::Floor).unwrap().to_string() == "-2"
  assert v.div(one, 0, std::math::RoundingMode::Ceiling).unwrap().to_string() == "-1"
end

test "Golden: Fixed64 rescale rounds half to even" do
  let a = std::math::Fixed64::from_string("1234.55".to_string()).unwrap()
  assert a.rescale(1, std::math::RoundingMode::HalfEven).unwrap().to_string() == "1234.6"
  let b = std::math::Fixed64::from_string("1234.45".to_string()).unwrap()
  assert b.rescale(1, std::math::RoundingMode::HalfEven).unwrap().to_string() == "1234.4"
end

test "Oracle: Fixed64 rescale half-up" do
  let v = std::math::Fixed64::from_string("1234.56".to_string()).unwrap()
  assert v.rescale(1, std::math::RoundingMode::HalfUp).unwrap().to_string() == "1234.6"
  assert v.rescale(0, std::math::RoundingMode::HalfEven).unwrap().to_string() == "1235"
end

test "Metamorphic: Fixed64 comparison is scale-independent" do
  let a = std::math::Fixed64::from_string("1.50".to_string()).unwrap()
  let b = std::math::Fixed64::from_string("1.5".to_string()).unwrap()
  assert a.compare(b) == 0
  let c = std::math::Fixed64::from_string("0.10".to_string()).unwrap()
  let d = std::math::Fixed64::from_string("0.2".to_string()).unwrap()
  let e = std::math::Fixed64::from_string("0.3".to_string()).unwrap()
  assert c.add(d).unwrap().compare(e) == 0
end

test "Negative: Fixed64 overflow is an error result" do
  let big = std::math::Fixed64::from_string("9223372036854775807".to_string()).unwrap()
  let two = std::math::Fixed64::from_int(2)
  let res = big.mul(two)
  match res
  when Err(e) then
    assert e == std::math::FixedError::Overflow
  when Ok(_) then
    assert false
  end
end

test "Negative: Fixed64 division by zero is an error result" do
  let a = std::math::Fixed64::from_string("1.5".to_string()).unwrap()
  let zero = std::math::Fixed64::zero()
  let res = a.div(zero, 2, std::math::RoundingMode::HalfUp)
  match res
  when Err(e) then
    assert e == std::math::FixedError::DivideByZero
  when Ok(_) then
    assert false
  end
end

test "Golden: Fixed128 wide parse/format round trip" do
  let v = std::math::Fixed128::from_string("12345678901234567890.1234".to_string()).unwrap()
  assert v.scale() == 4
  assert v.to_string() == "12345678901234567890.1234"
end

test "Oracle: Fixed128 tenths add exactly" do
  let a = std::math::Fixed128::from_string("0.1".to_string()).unwrap()
  let b = std::math::Fixed128::from_string("0.2".to_string()).unwrap()
  let c = std::math::Fixed128::from_string("0.3".to_string()).unwrap()
  assert a.add(b).unwrap().compare(c) == 0
end

test "Golden: Fixed128 long division half-up" do
  let one = std::math::Fixed128::from_int(1)
  let three = std::math::Fixed128::from_int(3)
  let q = one.div(three, 25, std::math::RoundingMode::HalfUp).unwrap()
  assert q.to_string() == "0.3333333333333333333333333"
end

test "Negative: Fixed128 out-of-range digits are rejected" do
  let res = std::math::Fixed128::from_string("9999999999999999999999999999999999999999".to_string())
  match res
  when Err(e) then
    assert e.len() > 0
  when Ok(_) then
    assert false
  end
end

test "Oracle: Fixed64 BigInt conversions round trip exactly" do
  let v = std::math::Fixed64::from_string("2.00".to_string()).unwrap()
  assert v.to_bigint().unwrap().to_string() == "2"
  let n = std::math::Fixed64::from_string("-4.00".to_string()).unwrap()
  assert n.to_bigint().unwrap().to_string() == "-4"
  let back = std::math::Fixed64::from_bigint(std::math::BigInt::from_string("123456789".to_string()).unwrap()).unwrap()
  assert back.to_string() == "123456789"
end

test "Negative: Fixed64 to_bigint rejects a nonzero fraction" do
  let v = std::math::Fixed64::from_string("2.50".to_string()).unwrap()
  match v.to_bigint()
  when Err(e) then
    assert e == std::math::FixedError::NotIntegral
  when Ok(_) then
    assert false
  end
end

test "Oracle: Fixed128 negative scale folds into the integer" do
  let v = std::math::Fixed128::from_parts(12345, -2)
  assert v.to_bigint().unwrap().to_string() == "1234500"
  let w = std::math::Fixed128::from_string("12.0000".to_string()).unwrap()
  assert w.to_bigint().unwrap().to_string() == "12"
end

test "Oracle: Fixed128 BigInt round trip at wide magnitudes" do
  let big = std::math::BigInt::from_string("123456789012345678901234567890".to_string()).unwrap()
  let fx = std::math::Fixed128::from_bigint(big).unwrap()
  assert fx.to_bigint().unwrap().to_string() == "123456789012345678901234567890"
end

test "Oracle: Fixed64 negate, abs and the round alias" do
  let v = std::math::Fixed64::from_string("-12.34".to_string()).unwrap()
  assert v.negate().to_string() == "12.34"
  assert v.abs().to_string() == "12.34"
  let w = std::math::Fixed64::from_string("12.3456".to_string()).unwrap()
  assert w.round(2, std::math::RoundingMode::HalfUp).unwrap().to_string() == "12.35"
  assert w.abs().to_string() == "12.3456"
end

test "Oracle: Fixed64 BigDecimal bridge round trips" do
  let v = std::math::Fixed64::from_string("3.14".to_string()).unwrap()
  let bd = v.to_bigdecimal()
  assert bd.to_string() == "3.14"
  let back = std::math::Fixed64::from_bigdecimal(bd).unwrap()
  assert back.compare(v) == 0
end

test "Oracle: Fixed128 negate and abs" do
  let v = std::math::Fixed128::from_string("-0.25".to_string()).unwrap()
  assert v.negate().to_string() == "0.25"
  assert v.abs().to_string() == "0.25"
end
