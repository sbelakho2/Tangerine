# tests/unit/test_formatter_gate.tg — the reviewer item 6 gate: the
# formatter's semantic-equivalence + idempotence invariants asserted over
# the compiler/std/test tree.
#
# For every parseable .tg file under tg_compiler/, std/ and tests/:
#   parse(original)                       — must succeed (else skipped)
#   parse(format(original))               — must succeed
#   gate_sig(parse(original))
#       == gate_sig(parse(format(original)))   — SEMANTIC EQUIVALENCE
#          (the formatter's structural signature walk: order-sensitive,
#          span/node_id-insensitive — a dropped or altered construct
#          changes the re-parsed program's signature)
#   format(format(original)) == format(original) — IDEMPOTENCE
#
# The gate API is tg_compiler::formatter::format_invariant_check (the
# tool-proof shape: the same function `tg fmt`/the LSP call, gated over
# the tree).
#
# Run with the repo root as the working directory:
#   tg test tests/unit/test_formatter_gate.tg
# (tests/run_formatter_gate.sh wraps this for CI.)

use std::collections::{Vec}
use std::fs::{read_dir, read_to_string}
use std::test::*
use tg_compiler::formatter::{format_invariant_check}

mut gate_checked = 0
mut gate_failures: Vec[String] = Vec::new()

def gate_walk_dir(dir: String) -> Unit
  match read_dir(dir)
  when Result::Err(e) then
    gate_failures.push("cannot list " + dir + ": " + e.to_string())
  when Result::Ok(entries) then
    for entry in entries do
      if entry.is_dir && !entry.name.starts_with(".") then
        gate_walk_dir(entry.path.clone())
      elsif entry.name.ends_with(".tg") then
        let path = entry.path.clone()
        match read_to_string(path.clone())
        when Result::Err(e) then
          gate_failures.push("cannot read " + path + ": " + e.to_string())
        when Result::Ok(source) then
          match format_invariant_check(source)
          when Result::Ok(_) then
            gate_checked = gate_checked + 1
          when Result::Err(reason) then
            gate_failures.push(path + ": " + reason)
          end
        end
      end
    end
  end
end

@test
def test_formatter_gate_over_compiler_std_tests() -> Unit
  gate_walk_dir("tg_compiler")
  gate_walk_dir("std")
  gate_walk_dir("tests")
  let checked = gate_checked
  assert(checked > 100,
    "the formatter gate must sweep a meaningful share of the tree (checked=" + checked.to_string() + ")")
  var msg = ""
  var i = 0
  while i < gate_failures.len() && i < 20 do
    msg = msg + "\n  " + gate_failures[i]
    i = i + 1
  end
  assert(gate_failures.is_empty(), "formatter gate violations:" + msg)
end
