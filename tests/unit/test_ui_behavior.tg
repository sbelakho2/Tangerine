# tests/unit/test_ui_behavior.tg — the per-callable behavior suite
# for std::ui (the API manifest's uncovered callables, driven to real
# semantics: inputs -> expected outputs; the failure paths -> the
# expected failures).

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec, Float}
use std::test::*
use std::ui::*

def identity_ease(t: Float) -> Float
  t
end

@test
def test_ui_color_surface() -> Unit
  # the constructors + the named colors
  let c = Color::rgba(10, 20, 30, 40)
  let (r, g, b, a) = c.to_rgba()
  assert_eq(r, 10 as u8)
  assert_eq(g, 20 as u8)
  assert_eq(b, 30 as u8)
  assert_eq(a, 40 as u8)
  let c2 = Color::rgb(1, 2, 3)
  assert_eq(c2.to_rgba().3, 255 as u8)
  assert_eq(Color::from_hex(0xFF8040).to_hex(), 0xFF8040)
  assert_eq(Color::black().to_hex(), 0x000000)
  assert_eq(Color::white().to_hex(), 0xFFFFFF)
  assert_eq(Color::red().to_hex(), 0xFF0000)
  assert_eq(Color::green().to_hex(), 0x00FF00)
  assert_eq(Color::blue().to_hex(), 0x0000FF)
  assert_eq(Color::yellow().to_hex(), 0xFFFF00)
  assert_eq(Color::cyan().to_hex(), 0x00FFFF)
  assert_eq(Color::magenta().to_hex(), 0xFF00FF)
  assert_eq(Color::gray(128).to_hex(), 0x808080)
  assert_eq(Color::transparent().to_rgba().3, 0 as u8)
  # from_hex_str: the #RRGGBB + the #RRGGBBAA forms + the error path
  let parsed = assert_some(Color::from_hex_str("#00ff00"))
  assert_eq(parsed.to_hex(), 0x00FF00)
  let parsed8 = assert_some(Color::from_hex_str("#10203040"))
  assert_eq(parsed8.to_rgba().3, 0x40 as u8)
  assert_none(Color::from_hex_str("#xyz"))
  assert_none(Color::from_hex_str(""))
  # from_hsla: the red hue at full saturation/lightness
  let hsla = Color::from_hsla(0.0, 1.0, 0.5, 1.0)
  assert_eq(hsla.to_hex(), 0xFF0000)
  # with_alpha + blend
  let wa = c.with_alpha(99)
  assert_eq(wa.to_rgba().3, 99 as u8)
  let blended = Color::black().blend(Color::white(), 0.5)
  assert_eq(blended.to_hex(), 0x7F7F7F)
end

@test
def test_ui_point_size_rect_surface() -> Unit
  # Point: the vector algebra
  let p = Point::new(3.0, 4.0)
  assert_eq(p.length(), 5.0)
  let n = p.normalize()
  assert_eq(n.x, 0.6)
  assert_eq(n.y, 0.8)
  let z = Point::zero()
  assert_eq(z.x, 0.0)
  assert_eq(p.add(Point::new(1.0, 1.0)).x, 4.0)
  assert_eq(p.sub(Point::new(1.0, 1.0)).x, 2.0)
  assert_eq(p.scale(2.0).y, 8.0)
  assert_eq(p.dot(Point::new(1.0, 0.0)), 3.0)
  assert_eq(p.distance(Point::new(0.0, 0.0)), 5.0)
  # Size
  let s = Size::new(4.0, 5.0)
  assert_eq(s.area(), 20.0)
  let sz = Size::zero()
  assert_eq(sz.area(), 0.0)
  # Rect: the geometry queries
  let r = Rect::new(10.0, 20.0, 100.0, 50.0)
  assert_eq(r.left(), 10.0)
  assert_eq(r.right(), 110.0)
  assert_eq(r.top(), 20.0)
  assert_eq(r.bottom(), 70.0)
  assert_eq(r.center().x, 60.0)
  assert_eq(r.center().y, 45.0)
  assert_eq(r.origin().x, 10.0)
  assert_eq(r.size().area(), 5000.0)
  assert_true(r.contains(Point::new(60.0, 45.0)))
  assert_false(r.contains(Point::new(0.0, 0.0)))
  let r2 = Rect::new(50.0, 40.0, 30.0, 30.0)
  assert_true(r.intersects(r2))
  let isect = assert_some(r.intersection(r2))
  assert_eq(isect.left(), 50.0)
  assert_false(r.intersects(Rect::new(0.0, 0.0, 5.0, 5.0)))
  assert_none(r.intersection(Rect::new(0.0, 0.0, 5.0, 5.0)))
  let u = r.union(r2)
  assert_eq(u.left(), 10.0)
  assert_eq(u.right(), 110.0)
  let ins = r.inset(5.0, 10.0)
  assert_eq(ins.left(), 15.0)
  assert_eq(ins.top(), 30.0)
  let off = r.offset(1.0, 2.0)
  assert_eq(off.left(), 11.0)
  # from_points + zero
  let fp = Rect::from_points(Point::new(1.0, 2.0), Point::new(4.0, 6.0))
  assert_eq(fp.right() - fp.left(), 3.0)
  assert_eq(fp.bottom() - fp.top(), 4.0)
  let rz = Rect::zero()
  assert_eq(rz.area(), 0.0)
end

@test
def test_ui_transform_surface() -> Unit
  let t = Transform::translation(10.0, 20.0)
  let p = t.transform_point(Point::new(1.0, 2.0))
  assert_eq(p.x, 11.0)
  assert_eq(p.y, 22.0)
  let inv = assert_some(t.invert())
  let back = inv.transform_point(p)
  assert_eq(back.x, 1.0)
  assert_eq(back.y, 2.0)
  let sc = Transform::scale(2.0, 3.0)
  let sp = sc.transform_point(Point::new(2.0, 2.0))
  assert_eq(sp.x, 4.0)
  assert_eq(sp.y, 6.0)
  let rot = Transform::rotation(0.0)
  let rp = rot.transform_point(Point::new(1.0, 0.0))
  assert_eq(rp.x, 1.0)
  let sk = Transform::skew(0.0, 0.0)
  assert_eq(sk.transform_point(Point::new(1.0, 1.0)).x, 1.0)
  let id = Transform::identity()
  let cat = t.concat(sc)
  let cp = cat.transform_point(Point::new(1.0, 1.0))
  assert_eq(cp.x, 12.0)
  assert_eq(cp.y, 23.0)
  assert_eq(id.transform_point(Point::new(5.0, 6.0)).x, 5.0)
end

@test
def test_ui_pixel_format() -> Unit
  assert_eq(PixelFormat::Rgba8.bytes_per_pixel(), 4 as UInt)
  assert_eq(PixelFormat::Rgb8.bytes_per_pixel(), 3 as UInt)
  assert_eq(PixelFormat::Bgra8.bytes_per_pixel(), 4 as UInt)
  assert_eq(PixelFormat::Grayscale8.bytes_per_pixel(), 1 as UInt)
  assert_eq(PixelFormat::GrayscaleAlpha8.bytes_per_pixel(), 2 as UInt)
end

@test
def test_ui_image_surface() -> Unit
  let img = Image::new(4 as UInt, 4 as UInt, PixelFormat::Rgba8)
  let black = img.get_pixel(0, 0)
  assert_eq(black.to_hex(), 0x000000)
  var img2 = Image::new(4 as UInt, 4 as UInt, PixelFormat::Rgba8)
  img2.set_pixel(1, 2, Color::red())
  let px = img2.get_pixel(1, 2)
  assert_eq(px.to_hex(), 0xFF0000)
  img2.fill(Color::green())
  assert_eq(img2.get_pixel(3, 3).to_hex(), 0x00FF00)
  img2.clear()
  assert_eq(img2.get_pixel(0, 0).to_hex(), 0x000000)
  # from_raw: the success + the size-mismatch error
  var raw: Vec[u8] = Vec::new()
  let _ = raw.push(255 as u8)
  let _ = raw.push(0 as u8)
  let _ = raw.push(0 as u8)
  let _ = raw.push(255 as u8)
  let ok_img = assert_ok(Image::from_raw(1 as UInt, 1 as UInt, PixelFormat::Rgba8, raw))
  assert_eq(ok_img.get_pixel(0, 0).to_hex(), 0xFF0000)
  var short: Vec[u8] = Vec::new()
  let _ = short.push(1 as u8)
  let err: ImageError = assert_err(Image::from_raw(4 as UInt, 4 as UInt, PixelFormat::Rgba8, short))
  let _ = err
  # filled + the transforms
  let filled = Image::filled(2 as UInt, 2 as UInt, Color::blue())
  assert_eq(filled.get_pixel(1, 1).to_hex(), 0x0000FF)
  let cropped = filled.crop(0, 0, 1 as UInt, 1 as UInt)
  assert_eq(cropped.get_pixel(0, 0).to_hex(), 0x0000FF)
  let resized = filled.resize(4 as UInt, 4 as UInt)
  assert_eq(resized.get_pixel(0, 0).to_hex(), 0x0000FF)
  var flip = Image::filled(2 as UInt, 2 as UInt, Color::blue())
  flip.flip_horizontal()
  assert_eq(flip.get_pixel(1, 0).to_hex(), 0x0000FF)
  flip.flip_vertical()
  assert_eq(flip.get_pixel(1, 1).to_hex(), 0x0000FF)
  let gray = filled.to_grayscale()
  assert_eq(gray.get_pixel(0, 0).to_hex(), 0x000000)
  # blit: a source image copies into the target
  var dst = Image::new(4 as UInt, 4 as UInt, PixelFormat::Rgba8)
  dst.blit(filled, 0, 0)
  assert_eq(dst.get_pixel(1, 1).to_hex(), 0x0000FF)
  # blend_colors
  let b = blend_colors(Color::black(), Color::white())
  assert_eq(b.to_hex(), 0x808080)
end

@test
def test_ui_canvas_surface() -> Unit
  var cv = Canvas::new(16 as UInt, 16 as UInt)
  assert_eq(cv.width(), 16 as UInt)
  assert_eq(cv.height(), 16 as UInt)
  cv.set_fill_color(Color::red())
  cv.set_stroke_color(Color::blue())
  cv.set_stroke_width(1.0)
  cv.fill_rect(0.0, 0.0, 16.0, 16.0)
  cv.stroke_rect(1.0, 1.0, 8.0, 8.0)
  cv.draw_line(0.0, 0.0, 15.0, 15.0)
  cv.fill_circle(4.0, 4.0, 2.0)
  cv.stroke_circle(12.0, 12.0, 2.0)
  cv.draw_circle_points(8, 8, 1, 1)
  cv.fill_ellipse(8.0, 8.0, 3.0, 2.0)
  var pts: Vec[Point] = Vec::new()
  let _ = pts.push(Point::new(0.0, 0.0))
  let _ = pts.push(Point::new(8.0, 0.0))
  let _ = pts.push(Point::new(4.0, 8.0))
  cv.fill_polygon(&pts)
  let saved = cv.save()
  let _ = saved.get_pixel(0, 0)
  let got = cv.get_image()
  assert_eq(got.get_pixel(0, 0).to_hex(), 0xFF0000)
  cv.set_transform(Transform::translation(1.0, 1.0))
  cv.reset_transform()
  cv.translate(0.0, 0.0)
  cv.scale(1.0, 1.0)
  cv.rotate(0.0)
  cv.clear(Color::white())
  assert_eq(cv.get_image().get_pixel(0, 0).to_hex(), 0xFFFFFF)
  # from_image + the image accessors
  var img = Image::new(8 as UInt, 8 as UInt, PixelFormat::Rgba8)
  img.fill(Color::magenta())
  var cv2 = Canvas::from_image(img)
  var img_src = Image::new(8 as UInt, 8 as UInt, PixelFormat::Rgba8)
  img_src.fill(Color::magenta())
  cv2.draw_image(img_src, 0, 0)
  var img_src2 = Image::new(8 as UInt, 8 as UInt, PixelFormat::Rgba8)
  img_src2.fill(Color::magenta())
  cv2.draw_image_scaled(img_src2, 0, 0, 8 as UInt, 8 as UInt)
  let pm = cv2.get_image_mut()
  assert_true((pm as Int) != 0)
  # the text layer
  let font = Font::default()
  let m = font.measure_text("hi")
  assert_true(m.area() > 0.0)
  let glyph = assert_some(Font::get_char('A'))
  assert_eq(glyph.len(), 8)
  cv2.draw_text("hi", 0.0, 0.0)
end

@test
def test_ui_animation_surface() -> Unit
  var anim = Animation::new(0.0, 10.0, 2.0, lerp_Float)
  assert_false(anim.is_finished())
  let v1 = anim.update(1.0)
  assert_eq(v1, 5.0)
  assert_false(anim.is_finished())
  let v2 = anim.update(1.0)
  assert_eq(v2, 10.0)
  assert_true(anim.is_finished())
  # the update clamp: the elapsed never exceeds the duration
  let v3 = anim.update(5.0)
  assert_eq(v3, 10.0)
  anim.reset()
  assert_false(anim.is_finished())
  let v4 = anim.update(1.0)
  assert_eq(v4, 5.0)
  # with_easing: the identity easing keeps the linear result
  let eased = anim.with_easing(identity_ease)
  let ve = eased.update(0.5)
  assert_eq(ve, 7.5)
  # lerp helpers
  assert_eq(lerp_Float(0.0, 10.0, 0.5), 5.0)
  assert_eq(lerp_point(Point::new(0.0, 0.0), Point::new(10.0, 20.0), 0.5).x, 5.0)
  assert_eq(lerp_color(Color::black(), Color::white(), 0.5).to_hex(), 0x808080)
end
