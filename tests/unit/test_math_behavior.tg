# tests/unit/test_math_behavior.tg — the per-callable behavior suite
# for std::math (the API manifest's uncovered callables, driven to
# real semantics: inputs -> expected outputs; the failure paths -> the
# expected failures).

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec, Float}
use std::test::*
use std::math::*
use std::diagnostics::{LogCategory, LogLevel, LogEntry, Logger}

struct MathMockLogger
  entries: Vec[LogEntry]
end

impl Logger for MathMockLogger
  def log(self: &mut Self, entry: LogEntry) -> Unit
    self.entries.push(entry)
  end

  def is_enabled(self: &Self, level: LogLevel, category: LogCategory) -> Bool
    true
  end
end

@test
def test_math_logger_layer() -> Unit
  let logger = Box::new(MathMockLogger { entries: Vec::new() })
  set_global_logger(logger)
  _log_math_event(LogLevel::Info, "math behavior probe".to_string())
  _log_math_event(LogLevel::Warn, "math behavior probe 2".to_string())
end

@test
def test_math_float_functions() -> Unit
  assert_eq(sqrt(9.0), 3.0)
  assert_eq(ceil(1.2), 2.0)
  assert_eq(floor(1.8), 1.0)
  assert_eq(round(1.5), 2.0)
  assert_eq(trunc(1.9), 1.0)
  assert_eq(fabs(-3.5), 3.5)
  assert_eq(fmod(7.0, 3.0), 1.0)
  assert_eq(fmin(2.0, 3.0), 2.0)
  assert_eq(fmax(2.0, 3.0), 3.0)
  assert_eq(copysign(3.0, -1.0), -3.0)
  assert_eq(exp(0.0), 1.0)
  assert_eq(exp2(2.0), 4.0)
  assert_eq(log2(8.0), 3.0)
  assert_eq(log10(100.0), 2.0)
  assert_eq(cbrt(8.0), 2.0)
  assert_eq(hypot(3.0, 4.0), 5.0)
  assert_eq(pow(2.0, 10.0), 1024.0)
  # the trig/hyperbolic family at the known points
  assert_eq(acos(1.0), 0.0)
  assert_eq(acosh(1.0), 0.0)
  assert_eq(asin(0.0), 0.0)
  assert_eq(asinh(0.0), 0.0)
  assert_eq(atan(0.0), 0.0)
  assert_eq(atan2(0.0, 1.0), 0.0)
  assert_eq(atanh(0.0), 0.0)
  assert_eq(cosh(0.0), 1.0)
  assert_eq(sinh(0.0), 0.0)
  assert_eq(tanh(0.0), 0.0)
  assert_eq(tan(0.0), 0.0)
  # the special functions at simple points
  assert_true(erf(0.0) == 0.0)
  assert_true(erfc(0.0) > 0.0)
  assert_true(lgamma(1.0) == 0.0)
  assert_true(tgamma(1.0) == 1.0)
  # the float classification predicates
  assert_true(is_nan(0.0 / 0.0))
  assert_false(is_nan(1.0))
  assert_false(is_finite(1.0 / 0.0))
  assert_true(is_finite(1.0))
  assert_true(is_infinite(1.0 / 0.0))
  assert_false(is_infinite(2.0))
  # lerp: the endpoints + the midpoint
  assert_eq(lerp(0.0, 10.0, 0.0), 0.0)
  assert_eq(lerp(0.0, 10.0, 0.5), 5.0)
  assert_eq(lerp(0.0, 10.0, 1.0), 10.0)
end

@test
def test_math_integer_functions() -> Unit
  assert_eq(gcd(12, 18), 6)
  assert_eq(gcd(7, 13), 1)
  assert_eq(lcm(4, 6), 12)
  assert_eq(lcm(3, 5), 15)
  assert_eq(pow_int(2, 10), 1024)
  assert_eq(pow_int(3, 0), 1)
  assert_true(is_prime(2))
  assert_true(is_prime(17))
  assert_false(is_prime(1))
  assert_false(is_prime(15))
end

@test
def test_math_bigint_surface() -> Unit
  let zero = BigInt.zero()
  assert_true(zero.is_zero())
  let one = BigInt.one()
  assert_true(one.to_string() == "1")
  let a = BigInt.from_int(42)
  assert_true(a.to_string() == "42")
  assert_true(a.negate().to_string() == "-42")
  assert_true(a.abs().to_string() == "42")
  assert_true(BigInt.from_int(-7).abs().to_string() == "7")
  # the arithmetic
  assert_true(a.add(BigInt.from_int(8)).to_string() == "50")
  assert_true(a.sub(BigInt.from_int(2)).to_string() == "40")
  assert_true(a.mul(BigInt.from_int(2)).to_string() == "84")
  assert_true(a.div(BigInt.from_int(6)).to_string() == "7")
  assert_true(a.modulo(BigInt.from_int(10)).to_string() == "2")
  assert_true(a.pow(2).to_string() == "1764")
  # the ordering: compare + cmp + eq
  assert_true(a.compare(BigInt.from_int(42)) == 0)
  assert_true(a.compare(BigInt.from_int(1)) > 0)
  assert_true(a.compare(BigInt.from_int(100)) < 0)
  assert_true(a.eq(BigInt.from_int(42)))
  assert_true(a.cmp(BigInt.from_int(42)) == 0)
  # from_string: the success + the error path
  let parsed = assert_ok(BigInt.from_string("123456789".to_string()))
  assert_true(parsed.to_string() == "123456789")
  let bad: BigInt = assert_err(BigInt.from_string("not-a-number".to_string()))
  let _ = bad
end

@test
def test_math_bigdecimal_surface() -> Unit
  let zero = BigDecimal.zero()
  let one = BigDecimal.one()
  let _ = zero
  let _ = one
  let from_parts = BigDecimal.from_parts(BigInt.from_int(123), 2)
  let _ = from_parts
  let from_int = BigDecimal.from_int(7)
  let _ = from_int
  let parsed = assert_ok(BigDecimal.from_string("3.14".to_string()))
  let _ = parsed
  let bad: BigDecimal = assert_err(BigDecimal.from_string("oops".to_string()))
  let _ = bad
end

@test
def test_math_bigint_internal_helpers() -> Unit
  # the limb helpers: the unsigned arithmetic on digit vectors
  let a = _uvec([1, 2])
  let b = _uvec([3, 4])
  let s = _add_unsigned(a, b)
  assert_eq(s.len(), 2)
  let d = _sub_unsigned(_uvec([5, 5]), _uvec([1, 1]))
  assert_eq(d[0], 4)
  let m = _mul_unsigned(_uvec([2]), _uvec([3]))
  assert_eq(m[0], 6)
  assert_eq(_cmp_unsigned(_uvec([1, 2]), _uvec([1, 2])), 0)
  assert_eq(_cmp_unsigned(_uvec([2, 2]), _uvec([1, 2])), 1)
  let (q, r) = _div_mod_unsigned(_uvec([7]), _uvec([2]))
  assert_eq(q[0], 3)
  assert_eq(r[0], 1)
  let sh = _shr1(_uvec([4]))
  assert_eq(sh[0], 2)
  # the scale alignment
  let (x, y) = _align_scales(BigDecimal.from_parts(BigInt.from_int(1), 0),
                             BigDecimal.from_parts(BigInt.from_int(2), 1))
  let _ = x
  let _ = y
  # the MathError surface
  let e = MathError::InvalidArg(Error::new(ErrorCode::InvalidArg, "m".to_string()))
  assert_true(e.message().len() > 0)
  assert_true(e.code() == ErrorCode::InvalidArg)
end

def _uvec(vals: [Int]) -> Vec[UInt]
  var out: Vec[UInt] = Vec::new()
  var i = 0
  while i < vals.len() do
    let _ = out.push(vals[i] as UInt)
    i = i + 1
  end
  out
end

@test
def test_math_statistics() -> Unit
  var values: Vec[Float] = Vec::new()
  let _ = values.push(2.0)
  let _ = values.push(4.0)
  let _ = values.push(4.0)
  let _ = values.push(4.0)
  let _ = values.push(5.0)
  let _ = values.push(5.0)
  let _ = values.push(7.0)
  let _ = values.push(9.0)
  assert_eq(mean(&values), 5.0)
  assert_eq(variance(&values), 4.0)
  assert_eq(stddev(&values), 2.0)
  assert_eq(median(&mut values), 4.5)
end
