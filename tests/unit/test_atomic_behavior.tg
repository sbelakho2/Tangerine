# tests/unit/test_atomic_behavior.tg — the per-callable behavior suite
# for std::atomic (the API manifest's uncovered callables, driven to
# real semantics: inputs -> expected outputs; the failure paths -> the
# expected failures).
#
# Every uncovered callable of std::atomic is CALLED below with real
# values and its outcome is ASSERTED (assert_eq / assert_true /
# assert_false / assert_some / assert_none / assert_ok / assert_err —
# the strengthened oracle's reference + call + assertion attribution).
# The panic-abort error paths (SeqLock double-write) are documented,
# not executed: under the stable policy a panic aborts the process
# (std/core.tg), so an in-process abort test would kill the runner.

use std::core::{Bool, Int, UInt, Unit, Option, Result, String}
use std::test::*
use std::atomic::*
use std::alloc::{alloc, dealloc, size_of}
use std::ffi::{c_int, Ptr, PtrMut}

# ———————————————————————————————————————————————————————————————
# AtomicBool — every operation's semantics + the CAS failure path
# ———————————————————————————————————————————————————————————————

@test
def test_atomic_bool_semantics() -> Unit
  var b = AtomicBool::new(true)
  assert_true(b.load(Ordering::SeqCst))
  b.store(false, Ordering::Release)
  assert_false(b.load(Ordering::Acquire))
  let old = b.exchange(true, Ordering::AcqRel)
  assert_false(old)
  assert_true(b.load(Ordering::Relaxed))
  # compare_exchange: the success path (expected matches -> true, value set)
  var exp = true
  assert_true(b.compare_exchange(&mut exp, false, Ordering::SeqCst, Ordering::Relaxed))
  assert_false(b.load(Ordering::Relaxed))
  # compare_exchange: the FAILURE path (expected written back with the
  # current value, false returned)
  var exp2 = true
  assert_false(b.compare_exchange(&mut exp2, true, Ordering::SeqCst, Ordering::Relaxed))
  assert_false(exp2)
  assert_false(b.load(Ordering::Relaxed))
  # compare_exchange_weak: success + failure
  var wexp = false
  assert_true(b.compare_exchange_weak(&mut wexp, true, Ordering::AcqRel, Ordering::Relaxed))
  assert_true(b.load(Ordering::Relaxed))
  var wexp2 = false
  assert_false(b.compare_exchange_weak(&mut wexp2, false, Ordering::AcqRel, Ordering::Relaxed))
  assert_true(wexp2)
  # fetch_and / fetch_or / fetch_xor / fetch_not: the OLD value returned
  var x = AtomicBool::new(true)
  assert_true(x.fetch_and(true, Ordering::Relaxed))
  assert_true(x.load(Ordering::Relaxed))
  assert_true(x.fetch_and(false, Ordering::Relaxed))
  assert_false(x.load(Ordering::Relaxed))
  assert_false(x.fetch_or(true, Ordering::Relaxed))
  assert_true(x.load(Ordering::Relaxed))
  assert_true(x.fetch_xor(true, Ordering::Relaxed))
  assert_false(x.load(Ordering::Relaxed))
  assert_false(x.fetch_not(Ordering::Relaxed))
  assert_true(x.load(Ordering::Relaxed))
  # get_mut: the mutable accessor returns the value's address
  let pm = x.get_mut()
  assert_true((pm as Int) != 0)
  # into_inner: the value is extracted
  let inner = x.into_inner()
  assert_true(inner)
end

# ———————————————————————————————————————————————————————————————
# AtomicInt — the arithmetic/bitwise family + fetch_update + the
# max/min boundaries
# ———————————————————————————————————————————————————————————————

@test
def test_atomic_int_semantics() -> Unit
  var a = AtomicInt::new(10)
  assert_eq(a.load(Ordering::SeqCst), 10)
  a.store(20, Ordering::Release)
  assert_eq(a.load(Ordering::Acquire), 20)
  let old = a.exchange(30, Ordering::AcqRel)
  assert_eq(old, 20)
  assert_eq(a.load(Ordering::Relaxed), 30)
  # compare_exchange success + failure (the expected slot on failure)
  var exp = 30
  assert_true(a.compare_exchange(&mut exp, 40, Ordering::SeqCst, Ordering::Relaxed))
  assert_eq(a.load(Ordering::Relaxed), 40)
  var exp2 = 0
  assert_false(a.compare_exchange(&mut exp2, 50, Ordering::SeqCst, Ordering::Relaxed))
  assert_eq(exp2, 40)
  var wexp = 40
  assert_true(a.compare_exchange_weak(&mut wexp, 50, Ordering::AcqRel, Ordering::Relaxed))
  assert_eq(a.load(Ordering::Relaxed), 50)
  # fetch_*: the old value; the operation applied
  assert_eq(a.fetch_add(5, Ordering::Relaxed), 50)
  assert_eq(a.load(Ordering::Relaxed), 55)
  assert_eq(a.fetch_sub(10, Ordering::Relaxed), 55)
  assert_eq(a.load(Ordering::Relaxed), 45)
  assert_eq(a.fetch_and(0xF0, Ordering::Relaxed), 45)
  assert_eq(a.load(Ordering::Relaxed), 45 & 0xF0)
  assert_eq(a.fetch_or(0x0F, Ordering::Relaxed), 45 & 0xF0)
  assert_eq(a.load(Ordering::Relaxed), (45 & 0xF0) | 0x0F)
  assert_eq(a.fetch_xor(0xFF, Ordering::Relaxed), (45 & 0xF0) | 0x0F)
  assert_eq(a.load(Ordering::Relaxed), 208)
  # *_fetch: the NEW value
  assert_eq(a.add_fetch(1, Ordering::Relaxed), 209)
  assert_eq(a.sub_fetch(1, Ordering::Relaxed), 208)
  assert_eq(a.and_fetch(0xFF, Ordering::Relaxed), 208)
  assert_eq(a.or_fetch(0, Ordering::Relaxed), 208)
  assert_eq(a.xor_fetch(0, Ordering::Relaxed), 208)
  # fetch_max / fetch_min: the old value; the extreme wins
  var m = AtomicInt::new(5)
  assert_eq(m.fetch_max(9, Ordering::Relaxed), 5)
  assert_eq(m.load(Ordering::Relaxed), 9)
  assert_eq(m.fetch_max(3, Ordering::Relaxed), 9)
  assert_eq(m.load(Ordering::Relaxed), 9)
  assert_eq(m.fetch_min(4, Ordering::Relaxed), 9)
  assert_eq(m.load(Ordering::Relaxed), 4)
  assert_eq(m.fetch_min(7, Ordering::Relaxed), 4)
  assert_eq(m.load(Ordering::Relaxed), 4)
  # fetch_update: Ok(old) on Some, Err(current) on None (the error path)
  var u = AtomicInt::new(100)
  let ok_upd = u.fetch_update(Ordering::SeqCst, Ordering::Relaxed, |cur| Option::Some(cur + 1))
  assert_eq(assert_ok(ok_upd), 100)
  assert_eq(u.load(Ordering::Relaxed), 101)
  let err_upd = u.fetch_update(Ordering::SeqCst, Ordering::Relaxed, |_cur| Option::None)
  assert_eq(assert_err(err_upd), 101)
  assert_eq(u.load(Ordering::Relaxed), 101)
  # get_mut / into_inner
  let pm = a.get_mut()
  assert_true((pm as Int) != 0)
  let inner = a.into_inner()
  assert_eq(inner, 208)
end

# ———————————————————————————————————————————————————————————————
# AtomicU8 / AtomicU64 / AtomicUInt — the width-specific families
# (the same operation set over the width types)
# ———————————————————————————————————————————————————————————————

@test
def test_atomic_u8_semantics() -> Unit
  var a = AtomicU8::new(1 as u8)
  assert_eq(a.load(Ordering::SeqCst), 1 as u8)
  a.store(2 as u8, Ordering::Release)
  assert_eq(a.load(Ordering::Acquire), 2 as u8)
  assert_eq(a.exchange(3 as u8, Ordering::AcqRel), 2 as u8)
  var exp = 3 as u8
  assert_true(a.compare_exchange(&mut exp, 4 as u8, Ordering::SeqCst, Ordering::Relaxed))
  assert_eq(a.load(Ordering::Relaxed), 4 as u8)
  var wexp = 4 as u8
  assert_true(a.compare_exchange_weak(&mut wexp, 5 as u8, Ordering::AcqRel, Ordering::Relaxed))
  assert_eq(a.fetch_add(1 as u8, Ordering::Relaxed), 5 as u8)
  assert_eq(a.load(Ordering::Relaxed), 6 as u8)
  assert_eq(a.fetch_sub(2 as u8, Ordering::Relaxed), 6 as u8)
  assert_eq(a.load(Ordering::Relaxed), 4 as u8)
  assert_eq(a.fetch_and(0x0F as u8, Ordering::Relaxed), 4 as u8)
  assert_eq(a.load(Ordering::Relaxed), 4 as u8)
  assert_eq(a.fetch_or(0xF0 as u8, Ordering::Relaxed), 4 as u8)
  assert_eq(a.load(Ordering::Relaxed), 0xF4 as u8)
  assert_eq(a.fetch_xor(0xFF as u8, Ordering::Relaxed), 0xF4 as u8)
  assert_eq(a.load(Ordering::Relaxed), 0x0B as u8)
  assert_eq(a.add_fetch(1 as u8, Ordering::Relaxed), 0x0C as u8)
  assert_eq(a.sub_fetch(2 as u8, Ordering::Relaxed), 0x0A as u8)
  assert_eq(a.and_fetch(0x0F as u8, Ordering::Relaxed), 0x0A as u8)
  assert_eq(a.or_fetch(0x05 as u8, Ordering::Relaxed), 0x0F as u8)
  assert_eq(a.xor_fetch(0x0F as u8, Ordering::Relaxed), 0x00 as u8)
end

@test
def test_atomic_u64_semantics() -> Unit
  var a = AtomicU64::new(10)
  assert_eq(a.load(Ordering::SeqCst), 10)
  a.store(20, Ordering::Release)
  assert_eq(a.exchange(30, Ordering::AcqRel), 20)
  var exp = 30
  assert_true(a.compare_exchange(&mut exp, 40, Ordering::SeqCst, Ordering::Relaxed))
  var wexp = 40
  assert_true(a.compare_exchange_weak(&mut wexp, 50, Ordering::AcqRel, Ordering::Relaxed))
  assert_eq(a.fetch_add(5, Ordering::Relaxed), 50)
  assert_eq(a.fetch_sub(3, Ordering::Relaxed), 55)
  assert_eq(a.fetch_and(0xF0, Ordering::Relaxed), 52)
  assert_eq(a.fetch_or(0x0F, Ordering::Relaxed), 48)
  assert_eq(a.fetch_xor(0xFF, Ordering::Relaxed), 63)
  assert_eq(a.add_fetch(1, Ordering::Relaxed), 191)
  assert_eq(a.sub_fetch(1, Ordering::Relaxed), 191)
  assert_eq(a.and_fetch(0xFF, Ordering::Relaxed), 190)
  assert_eq(a.or_fetch(0, Ordering::Relaxed), 190)
  assert_eq(a.xor_fetch(0, Ordering::Relaxed), 190)
  assert_eq(a.load(Ordering::Relaxed), 190)
end

@test
def test_atomic_uint_semantics() -> Unit
  var a = AtomicUInt::new(10)
  assert_eq(a.load(Ordering::SeqCst), 10)
  a.store(20, Ordering::Release)
  assert_eq(a.exchange(30, Ordering::AcqRel), 20)
  var exp = 30
  assert_true(a.compare_exchange(&mut exp, 40, Ordering::SeqCst, Ordering::Relaxed))
  var wexp = 40
  assert_true(a.compare_exchange_weak(&mut wexp, 50, Ordering::AcqRel, Ordering::Relaxed))
  assert_eq(a.fetch_add(5, Ordering::Relaxed), 50)
  assert_eq(a.fetch_sub(3, Ordering::Relaxed), 55)
  assert_eq(a.fetch_and(0xF0, Ordering::Relaxed), 52)
  assert_eq(a.fetch_or(0x0F, Ordering::Relaxed), 48)
  assert_eq(a.fetch_xor(0xFF, Ordering::Relaxed), 63)
  assert_eq(a.add_fetch(1, Ordering::Relaxed), 191)
  assert_eq(a.sub_fetch(1, Ordering::Relaxed), 191)
  assert_eq(a.and_fetch(0xFF, Ordering::Relaxed), 190)
  assert_eq(a.or_fetch(0, Ordering::Relaxed), 190)
  assert_eq(a.xor_fetch(0, Ordering::Relaxed), 190)
  assert_eq(a.load(Ordering::Relaxed), 190)
  # the unsigned max/min boundaries
  var m = AtomicUInt::new(5)
  assert_eq(m.fetch_max(9, Ordering::Relaxed), 5)
  assert_eq(m.load(Ordering::Relaxed), 9)
  assert_eq(m.fetch_min(4, Ordering::Relaxed), 9)
  assert_eq(m.load(Ordering::Relaxed), 4)
  let pm = a.get_mut()
  assert_true((pm as Int) != 0)
  assert_eq(a.into_inner(), 190)
end

# ———————————————————————————————————————————————————————————————
# AtomicIsize / AtomicUsize — the sized-integer constructors
# ———————————————————————————————————————————————————————————————

@test
def test_atomic_isize_usize_constructors() -> Unit
  # The sized-integer constructors: the value is wrapped (constructed),
  # and the sized-int widths equal the machine word width.
  let _i = AtomicIsize::new(7 as isize)
  let _u = AtomicUsize::new(9 as usize)
  assert_true(size_of[AtomicIsize]() == size_of[Int]())
  assert_true(size_of[AtomicUsize]() == size_of[Int]())
end

# ———————————————————————————————————————————————————————————————
# AtomicPtr — the pointer operations (null seed + the CAS failure
# path over real addresses)
# ———————————————————————————————————————————————————————————————

@test
def test_atomic_ptr_semantics() -> Unit
  var a = AtomicPtr::new(Ptr::null() as Ptr[Int])
  assert_true(a.load(Ordering::SeqCst).is_null())
  let p1 = alloc[Int]()
  a.store(p1, Ordering::Release)
  assert_true((a.load(Ordering::Acquire) as Int) == (p1 as Int))
  let old = a.exchange(Ptr::null() as Ptr[Int], Ordering::AcqRel)
  assert_true((old as Int) == (p1 as Int))
  # compare_exchange success + failure over the null/non-null transition
  var exp = Ptr::null() as Ptr[Int]
  assert_true(a.compare_exchange(&mut exp, p1, Ordering::SeqCst, Ordering::Relaxed))
  assert_true((a.load(Ordering::Relaxed) as Int) == (p1 as Int))
  var exp2 = Ptr::null() as Ptr[Int]
  assert_false(a.compare_exchange(&mut exp2, Ptr::null() as Ptr[Int], Ordering::SeqCst, Ordering::Relaxed))
  assert_true((exp2 as Int) == (p1 as Int))
  var wexp = p1
  assert_true(a.compare_exchange_weak(&mut wexp, Ptr::null() as Ptr[Int], Ordering::AcqRel, Ordering::Relaxed))
  assert_true(a.load(Ordering::Relaxed).is_null())
  let pm = a.get_mut()
  assert_true((pm as Int) != 0)
  let inner = a.into_inner()
  assert_true(inner.is_null())
  dealloc[Int](p1)
end

# ———————————————————————————————————————————————————————————————
# RcuPtr — read / update / synchronize over a real pointer
# ———————————————————————————————————————————————————————————————

@test
def test_rcu_ptr_semantics() -> Unit
  let p1 = alloc[Int]()
  p1.write(41)
  let p2 = alloc[Int]()
  p2.write(42)
  var rp = RcuPtr::new(p1)
  let r0 = rp.read()
  assert_eq(r0.read(), 41)
  let old = rp.update(p2)
  assert_true((old as Int) == (p1 as Int))
  let r1 = rp.read()
  assert_eq(r1.read(), 42)
  rp.synchronize()
  dealloc[Int](p1)
  dealloc[Int](p2)
end

# ———————————————————————————————————————————————————————————————
# SeqLock — the sequence protocol (begin/retry/write + opt_read)
# ———————————————————————————————————————————————————————————————
# The double-write_lock panic path is documented, not executed (the
# stable panic policy aborts the process — std/core.tg).

@test
def test_seq_lock_semantics() -> Unit
  var sl = SeqLock::new()
  let s0 = sl.read_begin()
  assert_eq(s0, 0 as UInt)
  assert_false(sl.read_retry(s0))
  sl.write_lock()
  sl.write_unlock()
  let s1 = sl.read_begin()
  assert_eq(s1, 2 as UInt)
  assert_true(sl.read_retry(s0))
  assert_false(sl.read_retry(s1))
  let v = sl.opt_read(|| 41)
  assert_eq(v, 41)
  let w = sl.opt_read(|| 41 + 1)
  assert_eq(w, 42)
end

# ———————————————————————————————————————————————————————————————
# SpinLock — the acquisition protocol + the try-lock failure path
# ———————————————————————————————————————————————————————————————

@test
def test_spin_lock_semantics() -> Unit
  var sl = SpinLock::new()
  assert_false(sl.is_locked())
  assert_true(sl.try_lock())
  assert_true(sl.is_locked())
  # the try-lock FAILURE path: the lock is held -> false
  assert_false(sl.try_lock())
  sl.unlock()
  assert_false(sl.is_locked())
  sl.lock()
  assert_true(sl.is_locked())
  sl.unlock()
end

# ———————————————————————————————————————————————————————————————
# TicketLock — the FIFO ticket protocol + the try-lock failure path
# ———————————————————————————————————————————————————————————————

@test
def test_ticket_lock_semantics() -> Unit
  var tl = TicketLock::new()
  let t0 = tl.try_lock()
  assert_eq(assert_some(t0), 0 as UInt)
  tl.unlock()
  # the try-lock FAILURE path: the ticket counter is ahead of the
  # serving counter (a waiter holds the queue position) -> None
  let t1 = tl.lock()
  assert_eq(t1, 1 as UInt)
  assert_none(tl.try_lock())
  tl.unlock()
end

# ———————————————————————————————————————————————————————————————
# fence / compiler_fence / ordering_to_c — the ordering layer
# ———————————————————————————————————————————————————————————————

@test
def test_atomic_fence_layer() -> Unit
  fence(Ordering::SeqCst)
  fence(Ordering::Acquire)
  fence(Ordering::Release)
  fence(Ordering::AcqRel)
  fence(Ordering::Relaxed)
  compiler_fence(Ordering::SeqCst)
  compiler_fence(Ordering::Acquire)
  compiler_fence(Ordering::Release)
  compiler_fence(Ordering::AcqRel)
  compiler_fence(Ordering::Relaxed)
  assert_eq(ordering_to_c(Ordering::Relaxed) as Int, 0)
  assert_eq(ordering_to_c(Ordering::Acquire) as Int, 2)
  assert_eq(ordering_to_c(Ordering::Release) as Int, 3)
  assert_eq(ordering_to_c(Ordering::AcqRel) as Int, 4)
  assert_eq(ordering_to_c(Ordering::SeqCst) as Int, 5)
end

# ———————————————————————————————————————————————————————————————
# The __intrinsic_atomic_* primitive layer — every width/op called
# directly with real values (the ONE atomic authority: the module
# routes through it, so the behavior tests exercise it)
# ———————————————————————————————————————————————————————————————

@test
def test_atomic_intrinsics_u8() -> Unit
  var b = 10 as u8
  let old_add = __intrinsic_atomic_fetch_add_u8(&mut b as PtrMut[u8], 5, 0)
  assert_eq(old_add, 10 as u8)
  assert_eq(b, 15 as u8)
  let old_sub = __intrinsic_atomic_fetch_sub_u8(&mut b as PtrMut[u8], 3, 0)
  assert_eq(old_sub, 15 as u8)
  assert_eq(b, 12 as u8)
  let old_and = __intrinsic_atomic_fetch_and_u8(&mut b as PtrMut[u8], 0x0F, 0)
  assert_eq(old_and, 12 as u8)
  assert_eq(b, 12 as u8)
  let old_or = __intrinsic_atomic_fetch_or_u8(&mut b as PtrMut[u8], 0xF0, 0)
  assert_eq(old_or, 12 as u8)
  assert_eq(b, 0xFC as u8)
  let old_xor = __intrinsic_atomic_fetch_xor_u8(&mut b as PtrMut[u8], 0xFF, 0)
  assert_eq(old_xor, 0xFC as u8)
  assert_eq(b, 0x03 as u8)
  let new_add = __intrinsic_atomic_add_fetch_u8(&mut b as PtrMut[u8], 1, 0)
  assert_eq(new_add, 0x04 as u8)
  let new_sub = __intrinsic_atomic_sub_fetch_u8(&mut b as PtrMut[u8], 1, 0)
  assert_eq(new_sub, 0x03 as u8)
  let new_and = __intrinsic_atomic_and_fetch_u8(&mut b as PtrMut[u8], 0x0F, 0)
  assert_eq(new_and, 0x03 as u8)
  let new_or = __intrinsic_atomic_or_fetch_u8(&mut b as PtrMut[u8], 0x08, 0)
  assert_eq(new_or, 0x0B as u8)
  let new_xor = __intrinsic_atomic_xor_fetch_u8(&mut b as PtrMut[u8], 0x0B, 0)
  assert_eq(new_xor, 0x00 as u8)
  let _ = __intrinsic_atomic_store_u8(&mut b as PtrMut[u8], 0x2A, 0)
  assert_eq(__intrinsic_atomic_load_u8(&b as Ptr[u8], 0), 0x2A as u8)
  let ex = __intrinsic_atomic_exchange_u8(&mut b as PtrMut[u8], 0x3B, 0)
  assert_eq(ex, 0x2A as u8)
  assert_eq(b, 0x3B as u8)
  var exp = 0x3B as u8
  let won = __intrinsic_atomic_compare_exchange_u8(&mut b as PtrMut[u8], &mut exp as PtrMut[u8], 0x4C, false, 0, 0)
  assert_true(won)
  assert_eq(b, 0x4C as u8)
  var exp2 = 0x00 as u8
  let lost = __intrinsic_atomic_compare_exchange_u8(&mut b as PtrMut[u8], &mut exp2 as PtrMut[u8], 0x5D, false, 0, 0)
  assert_false(lost)
  assert_eq(exp2, 0x4C as u8)
end

@test
def test_atomic_intrinsics_u16() -> Unit
  var b = 100 as u16
  assert_eq(__intrinsic_atomic_fetch_add_u16(&mut b as PtrMut[u16], 50, 0), 100 as u16)
  assert_eq(b, 150 as u16)
  assert_eq(__intrinsic_atomic_fetch_sub_u16(&mut b as PtrMut[u16], 50, 0), 150 as u16)
  assert_eq(__intrinsic_atomic_fetch_and_u16(&mut b as PtrMut[u16], 0x0FFF, 0), 100 as u16)
  assert_eq(b, 100 as u16)
  assert_eq(__intrinsic_atomic_fetch_or_u16(&mut b as PtrMut[u16], 0xF000, 0), 100 as u16)
  assert_eq(b, 0xF064 as u16)
  assert_eq(__intrinsic_atomic_fetch_xor_u16(&mut b as PtrMut[u16], 0xFFFF, 0), 0xF064 as u16)
  assert_eq(b, 0x0F9B as u16)
  assert_eq(__intrinsic_atomic_add_fetch_u16(&mut b as PtrMut[u16], 1, 0), 0x0F9C as u16)
  assert_eq(__intrinsic_atomic_sub_fetch_u16(&mut b as PtrMut[u16], 1, 0), 0x0F9B as u16)
  assert_eq(__intrinsic_atomic_and_fetch_u16(&mut b as PtrMut[u16], 0xFFFF, 0), 0x0F9B as u16)
  assert_eq(__intrinsic_atomic_or_fetch_u16(&mut b as PtrMut[u16], 0, 0), 0x0F9B as u16)
  assert_eq(__intrinsic_atomic_xor_fetch_u16(&mut b as PtrMut[u16], 0, 0), 0x0F9B as u16)
  let _ = __intrinsic_atomic_store_u16(&mut b as PtrMut[u16], 0x1234, 0)
  assert_eq(__intrinsic_atomic_load_u16(&b as Ptr[u16], 0), 0x1234 as u16)
  assert_eq(__intrinsic_atomic_exchange_u16(&mut b as PtrMut[u16], 0x5678, 0), 0x1234 as u16)
  var exp = 0x5678 as u16
  assert_true(__intrinsic_atomic_compare_exchange_u16(&mut b as PtrMut[u16], &mut exp as PtrMut[u16], 0x9ABC, false, 0, 0))
  var exp2 = 0 as u16
  assert_false(__intrinsic_atomic_compare_exchange_u16(&mut b as PtrMut[u16], &mut exp2 as PtrMut[u16], 0, false, 0, 0))
  assert_eq(exp2, 0x9ABC as u16)
end

@test
def test_atomic_intrinsics_u32() -> Unit
  var b = 1000
  assert_eq(__intrinsic_atomic_fetch_add_u32(&mut b as PtrMut[u32], 500, 0), 1000)
  assert_eq(b, 1500)
  assert_eq(__intrinsic_atomic_fetch_sub_u32(&mut b as PtrMut[u32], 500, 0), 1500)
  assert_eq(b, 1000)
  assert_eq(__intrinsic_atomic_fetch_and_u32(&mut b as PtrMut[u32], 0xFF, 0), 1000)
  assert_eq(b, 232)
  assert_eq(__intrinsic_atomic_fetch_or_u32(&mut b as PtrMut[u32], 0x100, 0), 232)
  assert_eq(b, 488)
  assert_eq(__intrinsic_atomic_fetch_xor_u32(&mut b as PtrMut[u32], 0x1F0, 0), 488)
  assert_eq(b, 24)
  assert_eq(__intrinsic_atomic_add_fetch_u32(&mut b as PtrMut[u32], 1, 0), 25)
  assert_eq(__intrinsic_atomic_sub_fetch_u32(&mut b as PtrMut[u32], 1, 0), 24)
  assert_eq(__intrinsic_atomic_and_fetch_u32(&mut b as PtrMut[u32], 0xFFFFFFFF, 0), 24)
  assert_eq(__intrinsic_atomic_or_fetch_u32(&mut b as PtrMut[u32], 0, 0), 24)
  assert_eq(__intrinsic_atomic_xor_fetch_u32(&mut b as PtrMut[u32], 0, 0), 24)
  let _ = __intrinsic_atomic_store_u32(&mut b as PtrMut[u32], 0xDEADBEEF, 0)
  assert_eq(__intrinsic_atomic_load_u32(&b as Ptr[u32], 0), 0xDEADBEEF)
  assert_eq(__intrinsic_atomic_exchange_u32(&mut b as PtrMut[u32], 0xCAFEBABE, 0), 0xDEADBEEF)
  var exp = 0xCAFEBABE
  assert_true(__intrinsic_atomic_compare_exchange_u32(&mut b as PtrMut[u32], &mut exp as PtrMut[u32], 1, false, 0, 0))
  var exp2 = 0
  assert_false(__intrinsic_atomic_compare_exchange_u32(&mut b as PtrMut[u32], &mut exp2 as PtrMut[u32], 2, false, 0, 0))
  assert_eq(exp2, 1)
end

@test
def test_atomic_intrinsics_u64() -> Unit
  var b = 1000
  assert_eq(__intrinsic_atomic_fetch_add_u64(&mut b as PtrMut[u64], 500, 0), 1000)
  assert_eq(b, 1500)
  assert_eq(__intrinsic_atomic_fetch_sub_u64(&mut b as PtrMut[u64], 500, 0), 1500)
  assert_eq(b, 1000)
  assert_eq(__intrinsic_atomic_fetch_and_u64(&mut b as PtrMut[u64], 0xFF, 0), 1000)
  assert_eq(b, 232)
  assert_eq(__intrinsic_atomic_fetch_or_u64(&mut b as PtrMut[u64], 0x100, 0), 232)
  assert_eq(b, 488)
  assert_eq(__intrinsic_atomic_fetch_xor_u64(&mut b as PtrMut[u64], 0x1F0, 0), 488)
  assert_eq(b, 24)
  assert_eq(__intrinsic_atomic_add_fetch_u64(&mut b as PtrMut[u64], 1, 0), 25)
  assert_eq(__intrinsic_atomic_sub_fetch_u64(&mut b as PtrMut[u64], 1, 0), 24)
  assert_eq(__intrinsic_atomic_and_fetch_u64(&mut b as PtrMut[u64], 0xFFFFFFFFFFFFFFFF, 0), 24)
  assert_eq(__intrinsic_atomic_or_fetch_u64(&mut b as PtrMut[u64], 0, 0), 24)
  assert_eq(__intrinsic_atomic_xor_fetch_u64(&mut b as PtrMut[u64], 0, 0), 24)
  let _ = __intrinsic_atomic_store_u64(&mut b as PtrMut[u64], 0x1122334455667788, 0)
  assert_eq(__intrinsic_atomic_load_u64(&b as Ptr[u64], 0), 0x1122334455667788)
  assert_eq(__intrinsic_atomic_exchange_u64(&mut b as PtrMut[u64], 0x8877665544332211, 0), 0x1122334455667788)
  var exp = 0x8877665544332211
  assert_true(__intrinsic_atomic_compare_exchange_u64(&mut b as PtrMut[u64], &mut exp as PtrMut[u64], 1, false, 0, 0))
  var exp2 = 0
  assert_false(__intrinsic_atomic_compare_exchange_u64(&mut b as PtrMut[u64], &mut exp2 as PtrMut[u64], 2, false, 0, 0))
  assert_eq(exp2, 1)
  # the fence intrinsic: every ordering code compiles and is served per
  # the §16.8 tables (Relaxed = no instruction; Acquire = DMB ISHLD /
  # none on TSO; Release/AcqRel/SeqCst = DMB ISH / MFENCE-on-SeqCst)
  __intrinsic_atomic_fence(0)
  __intrinsic_atomic_fence(2)
  __intrinsic_atomic_fence(3)
  __intrinsic_atomic_fence(4)
  __intrinsic_atomic_fence(5)
end
