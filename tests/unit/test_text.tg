# tests/unit/test_text.tg — Unit tests for text shaping/layout §21.1
use std::test::*
use std::text

# --- FontDb ---

@test
def test_fontdb_creation() -> Unit
  let db = text::font_db_new()
  assert_true(true)  # No crash = pass
end

@test
def test_fontdb_add_bytes_valid_truetype() -> Unit
  let db = text::font_db_new()
  # Minimal valid TrueType header: 0x00010000
  let data: Vec[u8] = [0u8, 1u8, 0u8, 0u8]  # Minimal header
  let result = text::font_db_add_bytes(db, data)
  # Should succeed (header validation passes for 0x00010000)
  match result
  when Ok(font_id)
    assert_true(font_id.id >= 0)
  when Err(e)
    # May fail if more bytes required, but header check should pass
    assert_true(true)
  end
end

@test
def test_fontdb_add_bytes_invalid_header() -> Unit
  let db = text::font_db_new()
  let data: Vec[u8] = [0u8, 0u8, 0u8, 0u8]  # Invalid header
  let result = text::font_db_add_bytes(db, data)
  match result
  when Err(e)
    assert_eq(e.message(), "Invalid font data: unrecognized header")
  when Ok(_)
    assert_false(true)  # Should have failed
  end
end

# --- Shape ---

@test
def test_shape_produces_glyphs() -> Unit
  let db = text::font_db_new()
  let font = FontId { id: 0 }
  let opts = ShapingOpts {
    font: font,
    size: 16.0,
    direction: Direction::LTR,
    script: "Latn"
  }
  let run = text::shape("Hello", opts)
  # Monospace shaper: one glyph per character
  assert_eq(run.glyphs.len(), 5)
end

@test
def test_shape_empty_string() -> Unit
  let db = text::font_db_new()
  let font = FontId { id: 0 }
  let opts = ShapingOpts {
    font: font,
    size: 16.0,
    direction: Direction::LTR,
    script: "Latn"
  }
  let run = text::shape("", opts)
  assert_eq(run.glyphs.len(), 0)
end

@test
def test_shape_rtl_direction() -> Unit
  let db = text::font_db_new()
  let font = FontId { id: 0 }
  let opts = ShapingOpts {
    font: font,
    size: 16.0,
    direction: Direction::RTL,
    script: "Arab"
  }
  let run = text::shape("abc", opts)
  assert_eq(run.glyphs.len(), 3)
end

# --- Layout ---

@test
def test_layout_single_line() -> Unit
  let opts = LayoutOpts {
    max_width: 1000.0,
    align: TextAlign::Left,
    line_height: 1.2
  }
  let style = TextStyle {
    font: FontId { id: 0 },
    size: 16.0,
    color: Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    direction: Direction::LTR
  }
  let layout = text::layout("Short text", style, opts)
  assert_eq(layout.lines.len(), 1)
end

@test
def test_layout_word_wrap() -> Unit
  let opts = LayoutOpts {
    max_width: 50.0,  # Very narrow — force wrapping
    align: TextAlign::Left,
    line_height: 1.2
  }
  let style = TextStyle {
    font: FontId { id: 0 },
    size: 16.0,
    color: Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    direction: Direction::LTR
  }
  let layout = text::layout("Hello World This Wraps", style, opts)
  assert_true(layout.lines.len() > 1)
end

# --- Hit test ---

@test
def test_hit_test_basic() -> Unit
  let opts = LayoutOpts {
    max_width: 500.0,
    align: TextAlign::Left,
    line_height: 1.2
  }
  let style = TextStyle {
    font: FontId { id: 0 },
    size: 16.0,
    color: Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    direction: Direction::LTR
  }
  let layout = text::layout("Hello", style, opts)
  let pos = text::hit_test(layout, 0.0, 0.0)
  assert_eq(pos.line, 0)
  assert_eq(pos.offset, 0)
end

@test
def test_hit_test_end_of_text() -> Unit
  let opts = LayoutOpts {
    max_width: 500.0,
    align: TextAlign::Left,
    line_height: 1.2
  }
  let style = TextStyle {
    font: FontId { id: 0 },
    size: 16.0,
    color: Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    direction: Direction::LTR
  }
  let layout = text::layout("Hello", style, opts)
  # Click far right — should give offset at end
  let pos = text::hit_test(layout, 999.0, 0.0)
  assert_true(pos.offset >= 4)  # Near or at end
end

# --- Selection rects ---

@test
def test_selection_rects() -> Unit
  let opts = LayoutOpts {
    max_width: 500.0,
    align: TextAlign::Left,
    line_height: 1.2
  }
  let style = TextStyle {
    font: FontId { id: 0 },
    size: 16.0,
    color: Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    direction: Direction::LTR
  }
  let layout = text::layout("Hello", style, opts)
  let rects = text::selection_rects(layout, 0, 3)
  assert_true(rects.len() >= 1)
  # First rect should start at x=0
  assert_eq(rects[0].x, 0.0)
end

# --- Capability rejection ---

@test
def test_error_types() -> Unit
  let err = TextError::ShapingFailed("test error")
  assert_eq(err.message(), "test error")
end
