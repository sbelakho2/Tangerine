# tests/unit/test_slice_sub_overflow.tg — audit item 1 (Slice::sub): the
# sub-view validates its range BEFORE the element-scaled pointer
# arithmetic. A start (or length) magnitude that would overflow the
# address computation — astronomically large indices that cannot alias
# any real window — must TRAP on the range checks (start past the
# parent's end / length beyond the parent) and never reach the
# `(b.ptr as Int + start * elem)` address arithmetic (a wrapped address
# would read out of the pinned allocation). The panic is observed
# through catch_panic (the runner's single destruction/unwind surface).

use std::collections
use std::core::{Option, Unit, Int, Vec}
use std::test::{assert_eq, assert_some, assert_contains, catch_panic}

def make_slice() -> Slice[Int]
  var v = Vec[Int]::new()
  v.push(10)
  v.push(20)
  v.push(30)
  copied_slice(v, 0, 3)
end

def sub_huge_start(s: Slice[Int]) -> Unit
  let huge_start = 1 << 62
  let _ = s.sub(huge_start, 1)
end

def sub_max_int_start(s: Slice[Int]) -> Unit
  let _ = s.sub(9223372036854775807, 1)
end

def sub_huge_length(s: Slice[Int]) -> Unit
  let huge_len = (1 << 40) as UInt
  let _ = s.sub(0, huge_len)
end

@test
def test_sub_astronomical_start_traps_before_address_math() -> Unit
  let s = make_slice()
  let msg = catch_panic(|| sub_huge_start(s))
  let m = assert_some(msg)
  assert_contains(m, "window starts past the slice end")
end

@test
def test_sub_max_int_start_traps_before_address_math() -> Unit
  let s = make_slice()
  let msg = catch_panic(|| sub_max_int_start(s))
  let m = assert_some(msg)
  assert_contains(m, "window starts past the slice end")
end

@test
def test_sub_huge_length_traps_before_address_math() -> Unit
  let s = make_slice()
  let msg = catch_panic(|| sub_huge_length(s))
  let m = assert_some(msg)
  assert_contains(m, "length exceeds the slice length")
end

@test
def test_sub_valid_small_window_after_overflow_rows() -> Unit
  let s = make_slice()
  # The panics above never ran address arithmetic; the parent window is
  # intact and a small valid window still works.
  assert_eq(s.len(), 3)
  let sub = s.sub(1, 1)
  assert_eq(sub.len(), 1)
  assert_eq(sub.get(0), 20)
end
