# tests/unit/test_mmap_behavior.tg — the per-callable behavior suite
# for std::mmap (the API manifest's uncovered callables, driven to real
# semantics: inputs -> expected outputs; the failure paths -> the
# expected failures).
#
# Every uncovered callable of std::mmap is CALLED below with real
# values and its outcome ASSERTED. The platform-dependent paths
# (MADV_HUGEPAGE / remap_file_pages — the madvise/remap syscalls
# return EINVAL on kernels without the feature) are exercised without
# asserting the specific result, and the mapping state machine
# (make_none -> no touch) never dereferences inaccessible pages.

use std::core::{Bool, Int, UInt, Unit, Option, Result, String, Vec}
use std::test::*
use std::mmap::*
use std::alloc::{alloc, dealloc}

@test
def test_mmap_flag_constants() -> Unit
  assert_eq(PROT_NONE(), 0)
  assert_eq(PROT_READ(), 1)
  assert_eq(PROT_WRITE(), 2)
  assert_eq(PROT_EXEC(), 4)
  assert_eq(MAP_SHARED(), 1)
  assert_eq(MAP_PRIVATE(), 2)
  assert_eq(MAP_FIXED(), 16)
  assert_eq(MAP_ANONYMOUS(), 32)
  assert_eq(MAP_ANON(), 32)
  assert_eq(MAP_GROWSDOWN(), 256)
  assert_eq(MAP_DENYWRITE(), 2048)
  assert_eq(MAP_EXECUTABLE(), 4096)
  assert_eq(MAP_LOCKED(), 8192)
  assert_eq(MAP_NORESERVE(), 16384)
  assert_eq(MAP_POPULATE(), 32768)
  assert_eq(MAP_NONBLOCK(), 65536)
  assert_eq(MAP_STACK(), 131072)
  assert_eq(MAP_HUGETLB(), 262144)
  assert_eq(MAP_JIT(), 0x800)
  assert_eq(MS_ASYNC(), 1)
  assert_eq(MS_SYNC(), 4)
  assert_eq(MS_INVALIDATE(), 2)
  assert_eq(MADV_NORMAL(), 0)
  assert_eq(MADV_RANDOM(), 1)
  assert_eq(MADV_SEQUENTIAL(), 2)
  assert_eq(MADV_WILLNEED(), 3)
  assert_eq(MADV_DONTNEED(), 4)
  assert_eq(MADV_FREE(), 8)
  assert_eq(MADV_REMOVE(), 9)
  assert_eq(MADV_DONTFORK(), 10)
  assert_eq(MADV_DOFORK(), 11)
  assert_eq(MADV_MERGEABLE(), 12)
  assert_eq(MADV_UNMERGEABLE(), 13)
  assert_eq(MADV_HUGEPAGE(), 14)
  assert_eq(MADV_NOHUGEPAGE(), 15)
  assert_eq(MADV_DONTDUMP(), 16)
  assert_eq(MADV_DODUMP(), 17)
  assert_eq(MADV_HWPOISON(), 100)
  assert_eq(MCL_CURRENT(), 1)
  assert_eq(MCL_FUTURE(), 2)
  assert_eq(MCL_ONFAULT(), 4)
  assert_eq(_SC_PAGESIZE(), 30)
end

@test
def test_mmap_page_geometry() -> Unit
  let ps = page_size()
  assert_true(ps > 0)
  assert_eq(sysconf(_SC_PAGESIZE()), ps)
  assert_eq(page_align_up(1), ps)
  assert_eq(page_align_up(ps), ps)
  assert_eq(page_align_up(ps + 1), ps * 2)
  assert_eq(page_align_down(ps * 3), ps * 3)
  assert_eq(page_align_down(ps * 3 + 7), ps * 3)
  assert_true(is_page_aligned(Ptr::null() as Ptr[u8]))
end

@test
def test_mmap_anonymous_lifecycle() -> Unit
  let m: Mmap = assert_ok(anonymous_map(4096 as UInt, PROT_READ() | PROT_WRITE()))
  assert_true(m.is_valid())
  assert_true(m.len() >= 4096)
  assert_true(is_page_aligned(m.ptr()))
  # the view accessors
  let _slice = m.as_slice()
  let pm = m.as_mut_slice()
  assert_true((pm as Int) != 0)
  # byte access: the normal path
  assert_ok(m.write_byte(0, 0xAB))
  assert_eq(assert_ok(m.read_byte(0)), 0xAB as u8)
  assert_eq(assert_ok(m.read_byte(1)), 0 as u8)
  # the byte-access ERROR paths: the offset is out of bounds
  assert_err(m.read_byte(m.len()))
  assert_err(m.write_byte(m.len(), 1))
  # the slice paths: write then read back
  var payload: Vec[u8] = Vec::new()
  let p1 = 0x11
  let _ = payload.push(p1 as u8)
  let _ = payload.push(0x22 as u8)
  assert_ok(m.write_slice(8, payload))
  let back = assert_ok(m.read_slice(8, 2))
  assert_eq(back.len(), 2)
  assert_eq(back[0], 0x11 as u8)
  assert_eq(back[1], 0x22 as u8)
  # the slice ERROR paths: the range is out of bounds
  var big: Vec[u8] = Vec::new()
  let _ = big.push(1 as u8)
  assert_err(m.write_slice(m.len(), big))
  assert_err(m.read_slice(m.len(), 1))
  # copy_to / copy_from over a real buffer
  let buf = alloc[u8]()
  assert_ok(m.copy_to(buf, 2))
  assert_eq(buf.read(), 0xAB as u8)
  buf.write(0x42)
  assert_ok(m.copy_from(buf, 2))
  assert_eq(assert_ok(m.read_byte(0)), 0x42 as u8)
  dealloc[u8](buf)
  # the copy ERROR path: the length exceeds the mapping
  assert_err(m.copy_to(buf2(), m.len() + 4096 as UInt))
  # the residency check: the touched page is resident
  let resid = assert_ok(m.check_residency())
  assert_true(resid.len() > 0)
  # the lock/unlock round-trip
  assert_ok(m.lock())
  assert_ok(m.unlock())
  # the protection state machine
  assert_ok(m.make_read_only())
  assert_err(m.write_byte(0, 1))
  assert_ok(m.make_read_write())
  assert_ok(m.write_byte(0, 2))
  assert_ok(m.make_read_write_exec())
  assert_ok(m.write_byte(0, 3))
  assert_ok(m.protect(PROT_READ() | PROT_WRITE()))
  assert_ok(m.write_byte(0, 4))
  assert_ok(m.make_none())
  assert_ok(m.make_read_write())
  # the sync family
  assert_ok(m.sync())
  assert_ok(m.sync_async())
  assert_ok(m.sync_flags(MS_SYNC()))
  assert_ok(m.sync_invalidate())
  # the advise family (MADV_HUGEPAGE / NOHUGEPAGE are kernel-
  # dependent: exercised, not asserted)
  assert_ok(m.advise(MADV_SEQUENTIAL()))
  assert_ok(m.advise_sequential())
  assert_ok(m.advise(MADV_RANDOM()))
  assert_ok(m.advise_random())
  assert_ok(m.advise(MADV_WILLNEED()))
  assert_ok(m.advise_will_need())
  assert_ok(m.advise(MADV_NORMAL()))
  assert_ok(m.advise_normal())
  let _huge = m.advise_hugepage()
  let _no_huge = m.advise_no_hugepage()
  let _dont_need = m.advise_dont_need()
  let _free = m.advise_free()
  assert_ok(m.unmap())
end

def buf2() -> Ptr[u8]
  alloc[u8]()
end

@test
def test_mmap_variants() -> Unit
  # the anonymous-map convenience constructors (the prot variants)
  let rw: Mmap = assert_ok(anonymous_map_read_write(4096 as UInt))
  assert_ok(rw.write_byte(0, 7))
  let re: Mmap = assert_ok(anonymous_map_read_exec(4096 as UInt))
  assert_true(re.is_valid())
  let rwe: Mmap = assert_ok(anonymous_map_read_write_exec(4096 as UInt))
  assert_ok(rwe.write_byte(0, 8))
  let ex: Mmap = assert_ok(anonymous_map_executable(4096 as UInt))
  assert_true(ex.is_valid())
  assert_ok(rw.unmap())
  assert_ok(re.unmap())
  assert_ok(rwe.unmap())
  assert_ok(ex.unmap())
end

@test
def test_mmap_global_locking() -> Unit
  assert_ok(lock_all_current())
  assert_eq(mlockall(MCL_CURRENT()), 0)
  assert_eq(munlockall(), 0)
  assert_ok(unlock_all())
  assert_ok(lock_all_future())
  assert_ok(unlock_all())
  assert_ok(lock_all())
  assert_ok(unlock_all())
end

@test
def test_mmap_file_map_error_paths() -> Unit
  # an invalid descriptor with a non-anonymous mapping fails
  assert_err(file_map(-1, 4096 as UInt, PROT_READ(), MAP_PRIVATE(), 0))
  assert_err(file_map_read(-1, 4096 as UInt, 0))
  assert_err(file_map_read_write(-1, 4096 as UInt, 0))
  assert_err(file_map_copy_on_write(-1, 4096 as UInt, 0))
  assert_err(file_map_shared(-1, 4096 as UInt, 0))
end

@test
def test_mmap_stack_and_guard() -> Unit
  let stack: Mmap = assert_ok(allocate_stack(4096 as UInt))
  assert_true(stack.is_valid())
  assert_ok(stack.unmap())
  let guard: Mmap = assert_ok(create_guard_page())
  assert_true(guard.is_valid())
  assert_ok(guard.unmap())
end

@test
def test_mmap_fixed_and_primitive_layer() -> Unit
  # map_fixed: a fresh anonymous mapping replaced at its own address
  let base: Mmap = assert_ok(anonymous_map(4096 as UInt, PROT_READ() | PROT_WRITE()))
  let fixed: Mmap = assert_ok(map_fixed(base.ptr(), 4096 as UInt, PROT_READ() | PROT_WRITE(),
                                  MAP_PRIVATE() | MAP_ANONYMOUS() | MAP_FIXED()))
  assert_true(fixed.is_valid())
  assert_true((fixed.ptr() as Int) == (base.ptr() as Int))
  assert_ok(fixed.unmap())
  # the raw wrapper layer over the same region (munmap'd afterwards)
  let raw: Mmap = assert_ok(anonymous_map(4096 as UInt, PROT_READ() | PROT_WRITE()))
  let addr = raw.ptr()
  let len = raw.len()
  assert_eq(mprotect(addr, len, PROT_READ() | PROT_WRITE()), 0)
  assert_eq(mlock(addr, len), 0)
  assert_eq(munlock(addr, len), 0)
  assert_eq(msync(addr, len, MS_SYNC()), 0)
  assert_eq(madvise(addr, len, MADV_NORMAL()), 0)
  let vec = alloc[u8]()
  vec.write(0)
  assert_eq(mincore(addr, len, vec), 0)
  dealloc[u8](vec)
  let _rfp = remap_file_pages(addr, len, PROT_READ(), 0, MAP_PRIVATE())
  assert_eq(munmap(addr, len), 0)
  # the c_* extern layer directly (the same calls, the i32 returns)
  let raw2: Mmap = assert_ok(anonymous_map(4096 as UInt, PROT_READ() | PROT_WRITE()))
  let addr2 = raw2.ptr()
  let len2 = raw2.len()
  assert_eq(c_mprotect(addr2, len2, (PROT_READ() | PROT_WRITE()) as i32) as Int, 0)
  assert_eq(c_mlock(addr2, len2) as Int, 0)
  assert_eq(c_munlock(addr2, len2) as Int, 0)
  assert_eq(c_msync(addr2, len2, MS_SYNC() as i32) as Int, 0)
  assert_eq(c_madvise(addr2, len2, MADV_NORMAL() as i32) as Int, 0)
  let vec2 = alloc[u8]()
  vec2.write(0)
  assert_eq(c_mincore(addr2, len2, vec2) as Int, 0)
  dealloc[u8](vec2)
  let _rfp2 = c_remap_file_pages(addr2, len2, PROT_READ() as i32, 0, MAP_PRIVATE() as i32)
  assert_eq(c_munmap(addr2, len2) as Int, 0)
  assert_eq(c_mlockall(MCL_CURRENT() as i32) as Int, 0)
  assert_eq(c_munlockall() as Int, 0)
  # the raw mmap syscall wrapper
  let ps = page_size()
  let ptr = mmap(Ptr { address: 0 }, (ps * 2) as UInt, PROT_READ() | PROT_WRITE(),
                 MAP_PRIVATE() | MAP_ANONYMOUS(), -1, 0)
  assert_true(!ptr.is_null())
  assert_true((ptr as Int) != (-1 as Int))
  assert_eq(munmap(ptr, (ps * 2) as UInt), 0)
end
