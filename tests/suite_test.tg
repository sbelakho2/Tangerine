use std::io::{print}

def fib(n: Int) -> Int
  if n <= 1 then
    n
  else
    fib(n - 1) + fib(n - 2)
  end
end

def factorial(n: Int) -> Int
  if n <= 1 then
    1
  else
    n * factorial(n - 1)
  end
end

def main() -> Int
  print("Tangerine Native Compiler Test Suite\n")
  print("====================================\n")

  let f10 = fib(10)
  let f6 = factorial(6)

  # fib(10) = 55, factorial(6) = 720
  # Return 0 if both correct, non-zero otherwise
  if f10 == 55 then
    if f6 == 720 then
      print("All tests passed!\n")
      0
    else
      print("FAIL: factorial\n")
      1
    end
  else
    print("FAIL: fibonacci\n")
    2
  end
end
