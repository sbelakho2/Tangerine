# tests/coverage_emission_test.tg — third-audit item 34: the runtime
# producer lane (the compile-time emission plan + the dump-writer
# contract).
#
# The executable rows live in tg_compiler/coverage_graph.tg
# (coverage_emission_lane_check — the per-function counter table attach
# with global bases, the pre-rendered trace row blob, the embedded
# tg.cov.table.v1 text, and coverage_trace_render over a synthetic
# counter array: the exact text the LIR-route runtime dump writes).
#
# Run with the repo root as the working directory:
#   tg test tests/coverage_emission_test.tg

use std::test::assert

use tg_compiler::coverage_graph::{coverage_emission_lane_check}

@test
def test_coverage_emission_lane() -> Unit
  let rows = coverage_emission_lane_check()
  assert(rows.len() == 0, "coverage emission lane mismatches: " + rows.join("; "))
end
