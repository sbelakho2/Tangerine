# tests/allocator_oom_test.tg — Simulated mmap/OOM failure.
#
# Fault injection: _tg_alloc_fail_next() arms the single-shot runtime flag
# that makes the next LARGE-path _tg_mem_alloc return 0 without calling
# mmap — the deterministic OOM simulation (the flag lives in .data; the
# allocator clears it when consumed). The test also drives the REAL
# MAP_FAILED path with an absurd-size request (0x7FFF...F0): the kernel
# rejects the mapping and the allocator's MAP_FAILED check (the sign bit)
# returns 0 BEFORE any header write.
#
# OOM policy: _tg_mem_alloc returns 0; the runtime String emitters check
# the result and trap (brk/ud2). Direct callers observe the 0.
#
# The strengthened lane: the ALLOCATOR-STATE assertion after EVERY failure
# path — a failed request must leave the outstanding-bytes counter
# EXACTLY where it was (the failure paths return before any accounting),
# and the single-shot hook must not leak state into the next request.

use std::core

extern def _tg_mem_alloc(size: UInt) -> Ptr[u8]
extern def _tg_mem_free(ptr: Ptr[u8], size: UInt) -> Unit
extern def _tg_alloc_fail_next() -> Unit
extern def tg_allocator_outstanding_bytes() -> Int

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  let before = tg_allocator_outstanding_bytes()

  # 1) Hook-driven failure: the armed flag forces a 0 return.
  _tg_alloc_fail_next()
  let p1 = _tg_mem_alloc(70000 as UInt)
  if !p1.is_null() then
    println("allocator_oom: fail-next returned a live block")
    return 1
  end
  # State assertion after the failure path: nothing was accounted — the
  # counter is untouched.
  let after_fail1 = tg_allocator_outstanding_bytes()
  if after_fail1 != before then
    println("allocator_oom: outstanding after fail-next = " + after_fail1.to_string() + " expected " + before.to_string())
    return 2
  end

  # 2) The hook is single-shot: the next large allocation succeeds.
  let p2 = _tg_mem_alloc(70000 as UInt)
  if p2.is_null() then
    println("allocator_oom: allocation after fail-next failed")
    return 3
  end
  # The large path accounts align8(70000 + 23) = 70024 bytes.
  let after_ok = tg_allocator_outstanding_bytes()
  if after_ok != before + 70024 then
    println("allocator_oom: outstanding after success = " + after_ok.to_string() + " expected " + (before + 70024).to_string())
    return 4
  end
  _tg_mem_free(p2, 70000 as UInt)
  let after_free = tg_allocator_outstanding_bytes()
  if after_free != before then
    println("allocator_oom: outstanding after free = " + after_free.to_string() + " expected " + before.to_string())
    return 5
  end

  # 3) Absurd-size request: the kernel rejects the mapping, the
  #    MAP_FAILED check (sign-bit test, before any header write) returns 0.
  let p3 = _tg_mem_alloc(0x7FFFFFFFFFFFFFF0 as UInt)
  if !p3.is_null() then
    println("allocator_oom: absurd-size request returned a live block")
    return 6
  end
  # State assertion after the real-failure path: untouched.
  let after_fail3 = tg_allocator_outstanding_bytes()
  if after_fail3 != before then
    println("allocator_oom: outstanding after absurd-size = " + after_fail3.to_string() + " expected " + before.to_string())
    return 7
  end

  # 4) The hook still works after the real failures: arm it again, the
  #    next large request fails, the one after succeeds.
  _tg_alloc_fail_next()
  let p5 = _tg_mem_alloc(70000 as UInt)
  if !p5.is_null() then
    println("allocator_oom: re-armed fail-next returned a live block")
    return 8
  end
  let p6 = _tg_mem_alloc(70000 as UInt)
  if p6.is_null() then
    println("allocator_oom: allocation after re-armed fail-next failed")
    return 9
  end
  _tg_mem_free(p6, 70000 as UInt)
  let after_all = tg_allocator_outstanding_bytes()
  if after_all != before then
    println("allocator_oom: outstanding at the end = " + after_all.to_string() + " expected " + before.to_string())
    return 10
  end
  0
end
