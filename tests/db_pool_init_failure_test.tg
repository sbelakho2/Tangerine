# tests/db_pool_init_failure_test.tg — the blocking pool's
# MINIMUM-WORKER-COUNT CONTRACT (reviewer item 12): the pool
# initialization returns the Result and the pool creation FAILS when a
# worker cannot start — never a swallowed Err(_) => a None worker slot,
# never a partial pool. The fault-injection hook (std::thread's
# __tg_spawn_fail_create) makes the FIRST worker's pthread_create report
# EAGAIN deterministically (no resource exhaustion needed), and the
# failed creation is surfaced through blocking_pool_get's Result.
#
# THIS FILE IS ITS OWN PROCESS: the failed creation is cached by the
# pool's Once guard (a failed init is never retried), so this test must
# not share a binary with the pool's successful tests — the
# init-failure assertion runs here, the successful pool tests run in
# tests/db_async_pool_test.tg.

use std::core::{String, Result, Option}
use std::test::*
use std::db::{blocking_pool_get}
use std::thread::{__tg_spawn_fail_create}

@test
def test_blocking_pool_init_fails_when_worker_spawn_fails() -> Unit
  # The injected spawn failure: the first worker's pthread_create
  # reports EAGAIN — the pool creation must FAIL (the Result), never a
  # partial pool with a swallowed Err slot.
  __tg_spawn_fail_create = true
  let result = blocking_pool_get()
  __tg_spawn_fail_create = false
  
  match result
  when Result::Err(_) then assert_true(true)
  when Result::Ok(_) then assert_false(true)
  end
end
