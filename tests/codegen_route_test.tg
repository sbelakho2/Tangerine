# tests/codegen_route_test.tg — audit item 31 + fourth-audit P0-21: the
# codegen-route option surface (fundamental codegen selection is a
# COMPILER OPTION, not an environment variable; TANGERINE_LIR is the
# deprecated alias).
#
# The rows pin:
#   - the DEFAULT route (CodegenRoute::Lir via codegen_default() and
#     default_options().codegen) — the ONE-LINE flip point landed at
#     fourth-audit P0-21, after P0-20 unified the enum representation
#     and verify_lir became the mandatory post-allocation gate;
#   - the explicit-direct fallback row: --codegen=direct is the
#     documented debug/bootstrap spelling and stays parseable/canonical;
#   - the exact --codegen value rows (direct / lir) and their canonical
#     spellings;
#   - fail-closed unknown values: no silent normalization, no fallback;
#   - the fail-closed gap-hint row (codegen_route_gap_hint): a known
#     LIR-gap refusal names --codegen=direct, an already-hinted message
#     is not doubled, and a non-gap error is returned unchanged.
#
# The CLI token extraction (parse_codegen_flag in driver.tg) shares this
# value parser; the driver route gates read the resolved option.
#
# Run with: tg test tests/codegen_route_test.tg

use std::test::*
use tg_compiler::compiler_core::{
  default_options, codegen_default, codegen_route_name,
  parse_codegen_route, codegen_route_gap_hint, CodegenRoute
}

@test
def test_codegen_default_is_lir() -> Unit
  # fourth-audit P0-21: the LIR route is the canonical default — the
  # direct emitter is reached only through an explicit --codegen=direct.
  assert_true(codegen_default() == CodegenRoute::Lir)
  let opts = default_options()
  assert_true(opts.codegen == CodegenRoute::Lir)
  # No explicit --codegen flag: the deprecated TANGERINE_LIR alias may
  # still map onto the route at the parser boundary (now a no-op).
  assert_false(opts.codegen_explicit)
end

@test
def test_explicit_direct_fallback_row() -> Unit
  # The direct emitter stays the documented debug/bootstrap fallback:
  # the explicit spelling parses to CodegenRoute::Direct, keeps its
  # canonical name, and is no longer the default.
  assert_true(assert_ok(parse_codegen_route("direct")) == CodegenRoute::Direct)
  assert_true(codegen_route_name(CodegenRoute::Direct) == "direct")
  assert_true(codegen_default() != CodegenRoute::Direct)
end

@test
def test_codegen_value_rows() -> Unit
  assert_true(assert_ok(parse_codegen_route("direct")) == CodegenRoute::Direct)
  assert_true(assert_ok(parse_codegen_route("lir")) == CodegenRoute::Lir)
  assert_true(codegen_route_name(CodegenRoute::Direct) == "direct")
  assert_true(codegen_route_name(CodegenRoute::Lir) == "lir")
end

@test
def test_unknown_codegen_value_rejected_fail_closed() -> Unit
  # An unknown value names the accepted spellings and is a hard error —
  # never a silent fallback to a route.
  let e = assert_err(parse_codegen_route("bogus"))
  assert_contains(e, "Unknown codegen route")
  assert_contains(e, "--codegen=direct")
  assert_contains(e, "--codegen=lir")
  # The empty value (e.g. `--codegen=`) and case variants are unknown too.
  assert_contains(assert_err(parse_codegen_route("")), "Unknown codegen route")
  assert_contains(assert_err(parse_codegen_route("LIR")), "Unknown codegen route")
  assert_contains(assert_err(parse_codegen_route("Direct")), "Unknown codegen route")
end

@test
def test_lir_gap_refusal_carries_direct_fallback_hint() -> Unit
  # fourth-audit P0-21 fail-closed UX: a known LIR-gap refusal (one of
  # the rule-naming markers of lir.tg's fail-closed lowering contract)
  # gets the explicit --codegen=direct fallback hint appended.
  let gap = codegen_route_gap_hint(
    "lir: struct S field x is not a scalar word of this slice (nested aggregates are not implemented)")
  assert_contains(gap, "not implemented")
  assert_contains(gap, "known LIR-route gap")
  assert_contains(gap, "--codegen=direct")

  let gap2 = codegen_route_gap_hint(
    "lir: function f returns a SIMD vector (v128); vector return values are not in the stage-1 vector slice — fail-closed)")
  assert_contains(gap2, "--codegen=direct")
end

@test
def test_gap_hint_is_not_doubled_and_spares_non_gap_errors() -> Unit
  # A message that already names the fallback keeps its single hint.
  let already = "the LIR pipeline requires exactly one input file (use --codegen=direct for the direct debug/bootstrap emitter)"
  assert_true(codegen_route_gap_hint(already) == already)

  # Frontend/MIR/verifier errors carry no LIR-gap marker and stay
  # unchanged: the hint never claims a route gap that is not one.
  let mir_err = "MIR verification failed before monomorphization (2 error(s))"
  assert_true(codegen_route_gap_hint(mir_err) == mir_err)
  let parse_err = "error[E0100]: expected `)`"
  assert_true(codegen_route_gap_hint(parse_err) == parse_err)

  # A joined semantic diagnostic and the shared MIR-lowering wrapper can
  # carry the same rule-naming words without being LIR-route gaps (the
  # direct route fails on them too): the hint stays away.
  let diag = "error at prog.tg:3: [E0142] unsupported: `string_chars` is not implemented as an intrinsic"
  assert_true(codegen_route_gap_hint(diag) == diag)
  let mir_lower = "MIR lowering failed: trait bound is not implemented for this shape (fail-closed)"
  assert_true(codegen_route_gap_hint(mir_lower) == mir_lower)
end
