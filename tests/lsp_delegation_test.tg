# tests/lsp_delegation_test.tg — the std::lsp delegation contract (the
# reviewer's item 22).
#
# The internal lexer/parser fork is GONE: std::lsp never re-parses source
# text. The language analysis is delegated to the COMPILER's language
# server (`tg ln` — the driver's LSP endpoints in tg_compiler/driver.tg,
# which consume the compiler's own lexer/parser/diagnostics/symbol
# graph). This suite pins the delegation invocation and the protocol
# layer that survives (the wire types + the client-side document model).
#
# Run with: tg run tests/lsp_delegation_test.tg

use std::test::*
use std::core::{Option, Result, String, Unit, Bool, Int, UInt}
use std::json
use std::lsp::{LanguageServer, Position, Range, TextDocument, Hover}

# ─── The delegation: the compiler's `tg ln` server owns the analysis ─

@test
def test_lsp_delegates_to_compiler_server() -> Unit
  let server = LanguageServer::new()
  let (bin, args) = server.compiler_invocation()
  assert_eq(bin, "tg")
  assert_eq(args.len(), 1)
  assert_eq(args[0], "ln")
end

@test
def test_lsp_run_hands_stdio_to_the_compiler_server() -> Unit
  # run() spawns the compiler's LSP server with the inherited stdio —
  # the delegation path is the spawned command, not an in-process
  # analysis. The invocation is pinned above; this test pins that the
  # server structure carries exactly the delegation fields.
  let server = LanguageServer::new()
  let (bin, args) = server.compiler_invocation()
  assert(bin.len() > 0, "the compiler binary must be named")
  assert(args.len() > 0, "the ln endpoint must be requested")
end

# ─── The protocol wire types (JSON round-trips) ────────────────────

@test
def test_lsp_position_json_roundtrip() -> Unit
  let pos = Position { line: 3, character: 7 }
  let back = assert_ok(Position::from_json(pos.to_json()))
  assert_true(back.line == 3)
  assert_true(back.character == 7)
end

@test
def test_lsp_position_from_json_rejects_missing_fields() -> Unit
  let bad = Position::from_json(json::object({"line": 1}))
  assert(bad.is_err(), "a position without character must be rejected")
end

@test
def test_lsp_range_json_roundtrip() -> Unit
  let range = Range {
    start: Position { line: 1, character: 2 },
    end_pos: Position { line: 3, character: 4 }
  }
  let back = assert_ok(Range::from_json(range.to_json()))
  assert_true(back.start.line == 1)
  assert_true(back.start.character == 2)
  assert_true(back.end_pos.line == 3)
  assert_true(back.end_pos.character == 4)
end

@test
def test_lsp_hover_json_shape() -> Unit
  let hover = Hover { contents: "the docs".to_string() }
  let v = hover.to_json()
  let contents = v.get("contents")
  match contents
  when Option::Some(c) =>
    let kind = c.get("kind")
    match kind
    when Option::Some(k) => assert_eq(k.as_string(), "markdown")
    when Option::None => assert(false, "hover must carry the markdown kind")
    end
  when Option::None => assert(false, "hover must carry contents")
  end
end

# ─── The client-side document model (buffer tracking only) ─────────

@test
def test_lsp_text_document_full_change() -> Unit
  let mut doc = TextDocument::new("file:///a.tg".to_string(), 1, "let x = 1\nlet y = 2".to_string())
  assert_true(doc.lines.len() == 2)
  doc.apply_full_change("let z = 3".to_string(), 2)
  assert_eq(doc.version, 2)
  assert_eq(doc.text, "let z = 3")
end

@test
def test_lsp_text_document_incremental_change() -> Unit
  let mut doc = TextDocument::new("file:///a.tg".to_string(), 1, "let z = 3".to_string())
  doc.apply_incremental_change(
    Range {
      start: Position { line: 0, character: 4 },
      end_pos: Position { line: 0, character: 9 }
    },
    "q".to_string(),
    3)
  assert_eq(doc.text, "let q = 3")
  assert_eq(doc.version, 3)
end

@test
def test_lsp_position_to_offset() -> Unit
  let doc = TextDocument::new("file:///a.tg".to_string(), 1, "ab\ncd\nef".to_string())
  assert_true(doc.position_to_offset(Position { line: 0, character: 1 }) == 1)
  assert_true(doc.position_to_offset(Position { line: 1, character: 1 }) == 4)
  assert_true(doc.position_to_offset(Position { line: 2, character: 0 }) == 6)
end

# ———————————————————————————————————————————————————————————————
# The STRENGTHENED lane (the adversarial audit): the astral Unicode
# positions (the UTF-8/UTF-16/scalar offsets DIFFER for the same
# character index), the CRLF line semantics, and the incremental changes
# across line boundaries and astral characters.
# ———————————————————————————————————————————————————————————————

@test
def test_lsp_astral_unicode_offsets_differ() -> Unit
  # "a\u{1F600}b\nc": the astral scalar U+1F600 is 4 UTF-8 bytes, 2
  # UTF-16 code units, 1 Unicode scalar. The document model is
  # BYTE-based (String::len is the byte length; the line split is byte-
  # oriented), so for the same `character` index the byte offset differs
  # from the UTF-16 offset: character 1 is byte 1 (inside the emoji) in
  # this model but would be byte 2 in a UTF-16 model and byte 1 in a
  # scalar model. The test pins the BYTE contract — a future UTF-16
  # conversion cannot pass silently (its offsets would disagree here).
  let doc = TextDocument::new("file:///a.tg".to_string(), 1, "a\u{1F600}b\nc".to_string())
  # The 'a' is byte 0; the emoji occupies bytes 1..4; the 'b' is byte 5.
  assert_true(doc.position_to_offset(Position { line: 0, character: 1 }) == 1)
  assert_true(doc.position_to_offset(Position { line: 0, character: 2 }) == 2)
  assert_true(doc.position_to_offset(Position { line: 0, character: 4 }) == 4)
  assert_true(doc.position_to_offset(Position { line: 0, character: 5 }) == 5)
  # Line 1 starts after "a<emoji>b" (6 bytes) + the newline = 7.
  assert_true(doc.position_to_offset(Position { line: 1, character: 0 }) == 7)
  # The byte-based line length counts the emoji as 4 bytes.
  assert_true(doc.lines[0].len() == 6)
end

@test
def test_lsp_crlf_line_semantics() -> Unit
  # "ab\r\ncd": the model splits on "\n" ONLY, so the "\r" is line
  # CONTENT — the offset math treats it as part of line 0. A position at
  # line 0 character 3 lands ON the "\r": the boundary class between the
  # LF-only model and a CRLF-aware model.
  let doc = TextDocument::new("file:///a.tg".to_string(), 1, "ab\r\ncd".to_string())
  assert_true(doc.lines.len() == 2)
  assert_true(doc.lines[0].len() == 3)  # "ab\r" — the CR is counted
  assert_true(doc.position_to_offset(Position { line: 0, character: 2 }) == 2)
  assert_true(doc.position_to_offset(Position { line: 0, character: 3 }) == 3)
  assert_true(doc.position_to_offset(Position { line: 1, character: 0 }) == 4)
  assert_true(doc.position_to_offset(Position { line: 1, character: 2 }) == 6)
end

@test
def test_lsp_incremental_change_crosses_line_boundary() -> Unit
  let mut doc = TextDocument::new("file:///a.tg".to_string(), 1, "let x = 1\nlet y = 2\nlet z = 3".to_string())
  # Replace the range that SPANS the newline and the whole second line:
  # (0,9) is the '1' at the end of line 0, (2,0) is the start of line 2.
  # The before/after splice must cut exactly at the byte offsets and the
  # lines array must be rebuilt from the new text.
  doc.apply_incremental_change(
    Range {
      start: Position { line: 0, character: 9 },
      end_pos: Position { line: 2, character: 0 }
    },
    "X".to_string(),
    4)
  assert_eq(doc.text, "let x = Xlet z = 3")
  assert_eq(doc.version, 4)
  assert_true(doc.lines.len() == 1)
end

@test
def test_lsp_incremental_change_inserts_lines() -> Unit
  let mut doc = TextDocument::new("file:///a.tg".to_string(), 1, "let x = 1\nlet y = 2\nlet z = 3".to_string())
  # An insertion at the END of line 0 (character 10 == the byte after
  # the line's 10 bytes — the position of the '\n') that itself carries
  # newlines: the document must grow by one line.
  doc.apply_incremental_change(
    Range {
      start: Position { line: 0, character: 10 },
      end_pos: Position { line: 0, character: 10 }
    },
    "let mid = 2\n".to_string(),
    5)
  assert_eq(doc.text, "let x = 1let mid = 2\nlet y = 2\nlet z = 3")
  assert_true(doc.lines.len() == 3)
end

@test
def test_lsp_incremental_change_on_astral_and_crlf() -> Unit
  # The byte-range replacement of an ASTRAL character: the emoji occupies
  # bytes 1..4 — replacing (0,1)..(0,5) with the same scalar leaves the
  # text identical (the byte model replaces the whole 4-byte scalar).
  let mut doc1 = TextDocument::new("file:///a.tg".to_string(), 1, "a\u{1F600}b".to_string())
  doc1.apply_incremental_change(
    Range {
      start: Position { line: 0, character: 1 },
      end_pos: Position { line: 0, character: 5 }
    },
    "\u{1F600}".to_string(),
    2)
  assert_eq(doc1.text, "a\u{1F600}b")
  # The CRLF document: a range that removes the "\r\n" terminator by
  # cutting (0,2)..(1,0) — the byte offsets 2..4 — splices the two lines
  # together and leaves NO stray CR.
  let mut doc2 = TextDocument::new("file:///a.tg".to_string(), 1, "ab\r\ncd".to_string())
  doc2.apply_incremental_change(
    Range {
      start: Position { line: 0, character: 2 },
      end_pos: Position { line: 1, character: 0 }
    },
    "".to_string(),
    2)
  assert_eq(doc2.text, "abcd")
  assert_true(doc2.lines.len() == 1)
end
