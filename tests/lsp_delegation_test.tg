# tests/lsp_delegation_test.tg — the std::lsp delegation contract (the
# reviewer's item 22).
#
# The internal lexer/parser fork is GONE: std::lsp never re-parses source
# text. The language analysis is delegated to the COMPILER's language
# server (`tg ln` — the driver's LSP endpoints in tg_compiler/driver.tg,
# which consume the compiler's own lexer/parser/diagnostics/symbol
# graph). This suite pins the delegation invocation and the protocol
# layer that survives (the wire types + the client-side document model).
#
# Run with: tg run tests/lsp_delegation_test.tg

use std::test::*
use std::core::{Option, Result, String, Unit, Bool, Int, UInt}
use std::json
use std::lsp::{LanguageServer, Position, Range, TextDocument, Hover}

# ─── The delegation: the compiler's `tg ln` server owns the analysis ─

@test
def test_lsp_delegates_to_compiler_server() -> Unit
  let server = LanguageServer::new()
  let (bin, args) = server.compiler_invocation()
  assert_eq(bin, "tg")
  assert_eq(args.len(), 1)
  assert_eq(args[0], "ln")
end

@test
def test_lsp_run_hands_stdio_to_the_compiler_server() -> Unit
  # run() spawns the compiler's LSP server with the inherited stdio —
  # the delegation path is the spawned command, not an in-process
  # analysis. The invocation is pinned above; this test pins that the
  # server structure carries exactly the delegation fields.
  let server = LanguageServer::new()
  let (bin, args) = server.compiler_invocation()
  assert(bin.len() > 0, "the compiler binary must be named")
  assert(args.len() > 0, "the ln endpoint must be requested")
end

# ─── The protocol wire types (JSON round-trips) ────────────────────

@test
def test_lsp_position_json_roundtrip() -> Unit
  let pos = Position { line: 3, character: 7 }
  let back = assert_ok(Position::from_json(pos.to_json()))
  assert_true(back.line == 3)
  assert_true(back.character == 7)
end

@test
def test_lsp_position_from_json_rejects_missing_fields() -> Unit
  let bad = Position::from_json(json::object({"line": 1}))
  assert(bad.is_err(), "a position without character must be rejected")
end

@test
def test_lsp_range_json_roundtrip() -> Unit
  let range = Range {
    start: Position { line: 1, character: 2 },
    end_pos: Position { line: 3, character: 4 }
  }
  let back = assert_ok(Range::from_json(range.to_json()))
  assert_true(back.start.line == 1)
  assert_true(back.start.character == 2)
  assert_true(back.end_pos.line == 3)
  assert_true(back.end_pos.character == 4)
end

@test
def test_lsp_hover_json_shape() -> Unit
  let hover = Hover { contents: "the docs".to_string() }
  let v = hover.to_json()
  let contents = v.get("contents")
  match contents
  when Option::Some(c) =>
    let kind = c.get("kind")
    match kind
    when Option::Some(k) => assert_eq(k.as_string(), "markdown")
    when Option::None => assert(false, "hover must carry the markdown kind")
    end
  when Option::None => assert(false, "hover must carry contents")
  end
end

# ─── The client-side document model (buffer tracking only) ─────────

@test
def test_lsp_text_document_full_change() -> Unit
  let mut doc = TextDocument::new("file:///a.tg".to_string(), 1, "let x = 1\nlet y = 2".to_string())
  assert_true(doc.lines.len() == 2)
  doc.apply_full_change("let z = 3".to_string(), 2)
  assert_eq(doc.version, 2)
  assert_eq(doc.text, "let z = 3")
end

@test
def test_lsp_text_document_incremental_change() -> Unit
  let mut doc = TextDocument::new("file:///a.tg".to_string(), 1, "let z = 3".to_string())
  doc.apply_incremental_change(
    Range {
      start: Position { line: 0, character: 4 },
      end_pos: Position { line: 0, character: 9 }
    },
    "q".to_string(),
    3)
  assert_eq(doc.text, "let q = 3")
  assert_eq(doc.version, 3)
end

@test
def test_lsp_position_to_offset() -> Unit
  let doc = TextDocument::new("file:///a.tg".to_string(), 1, "ab\ncd\nef".to_string())
  assert_true(doc.position_to_offset(Position { line: 0, character: 1 }) == 1)
  assert_true(doc.position_to_offset(Position { line: 1, character: 1 }) == 4)
  assert_true(doc.position_to_offset(Position { line: 2, character: 0 }) == 6)
end
