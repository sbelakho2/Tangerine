# tests/thread_spawn_failure_test.tg — the spawn failure path runs the
# placed closure's drop glue exactly once.
#
# Fault mechanism: std::thread's `__tg_spawn_fail_create` fault-injection
# flag. When set, ThreadBuilder::spawn reports the pthread_create failure
# (EAGAIN, errno 11) WITHOUT invoking the libc function — deterministic
# on every platform, no resource exhaustion needed. The test captures a
# tracked resource into the closure, forces the failure, and asserts:
#   (1) spawn returns Err;
#   (2) the captured resource's destructor fired EXACTLY ONCE (the drop
#       glue ran on the failure path before the closure storage was
#       freed). A bare dealloc (the pre-fix behavior) would leave the
#       counter at 0.

use std::core::{Result, String, Unit}
use std::test::*
use std::thread::{thread_builder, __tg_spawn_fail_create}

mut drop_counter = 0

struct TrackedResource
  id: Int
end

impl Drop for TrackedResource
  def drop(inout self: TrackedResource) -> Unit
    drop_counter = drop_counter + 1
  end
end

@test
def test_spawn_failure_runs_closure_drop_glue() -> Unit
  drop_counter = 0
  let payload = TrackedResource { id: 7 }

  __tg_spawn_fail_create = true
  let result = thread_builder().spawn(move || {
    let _ = payload.id
    42
  })
  __tg_spawn_fail_create = false

  match result
  when Result::Err(_) then assert_true(true)
  when Result::Ok(_) then assert_false(true)
  end

  # The closure's drop glue ran on the failure path: the captured
  # resource's destructor fired exactly once.
  assert_eq(drop_counter, 1)
end

@test
def test_spawn_success_path_unaffected_by_flag_default() -> Unit
  # The flag defaults to false: a normal spawn never sees the injected
  # failure (the flag's false default is the contract).
  assert_false(__tg_spawn_fail_create)
end
