# Map::values() must lower through its SOURCE body (entries + value
# extraction), never the MapValues intrinsic whose direct-runtime helper
# does not exist. Reaching that intrinsic is a codegen panic.
use std::core::{Option, Unit, Int}
use std::collections::Map
use std::test::assert

@test
def test_map_values_uses_source_body() -> Unit
  var m: Map[Int, Int] = Map::new()
  m.insert(1, 10)
  m.insert(2, 20)
  let vals = m.values()
  assert(vals.len() == 2, "Map::values must return both values")
end
