# tests/allocator_alignment_test.tg — The allocator's alignment contract.
#
# The runtime allocator guarantees a 16-byte-aligned PAYLOAD: every
# block carries a 16-byte header (marker + size), the block base is
# 16-byte aligned (small blocks: the 16-aligned bump arena / the free
# lists; large blocks: mmap/VirtualAlloc/HeapAlloc), so
# payload = base + 16 is 16-aligned. This test asserts the ACTUAL
# alignment of every returned address across the raw runtime path, the
# SystemAllocator path (align 1..16) and the arena path — the payload
# the caller receives is 16-aligned in every case.
#
# The contract's validation side (SystemAllocator::allocate rejects
# non-power-of-two and over-aligned align with an explicit panic) is a
# compile-time-verified property; this file asserts the positive side:
# every in-contract request is honored with a 16-aligned address.

use std::core
use std::alloc::{Allocator, SystemAllocator, system_allocator, arena_new, arena_destroy, pool_new}

extern def _tg_mem_alloc(size: UInt) -> Ptr[u8]
extern def _tg_mem_free(ptr: Ptr[u8], size: UInt) -> Unit

def is_16_aligned(p: Ptr[u8]) -> Bool
  (p as Int) & 15 == 0
end

# Raw runtime path: one allocation per size class plus the large
# (mmap) path — every returned payload must be 16-aligned.
def check_raw(size: Int) -> Int
  let p = _tg_mem_alloc(size as UInt)
  if p.is_null() then
    println("allocator_alignment: _tg_mem_alloc(" + size.to_string() + ") failed")
    return 1
  end
  if !is_16_aligned(p) then
    println("allocator_alignment: _tg_mem_alloc(" + size.to_string() + ") returned " + (p as Int).to_string() + " — not 16-aligned")
    return 2
  end
  _tg_mem_free(p, size as UInt)
  0
end

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  # 1) The raw runtime authority — small classes and the large path.
  var sizes = Vec[Int]::new()
  sizes.push(16)
  sizes.push(32)
  sizes.push(64)
  sizes.push(128)
  sizes.push(256)
  sizes.push(512)
  sizes.push(1024)
  sizes.push(4096)
  sizes.push(16384)
  sizes.push(65536)
  sizes.push(70000)
  var i = 0
  while i < sizes.len() do
    let rc = check_raw(sizes[i])
    if rc != 0 then
      return rc
    end
    i = i + 1
  end

  # 2) The SystemAllocator path: every in-contract alignment
  #    (1, 2, 4, 8, 16 — the powers of two the contract accepts) is
  #    honored with a 16-aligned address.
  var sys = system_allocator()
  var aligns = Vec[UInt]::new()
  aligns.push(1 as UInt)
  aligns.push(2 as UInt)
  aligns.push(4 as UInt)
  aligns.push(8 as UInt)
  aligns.push(16 as UInt)
  i = 0
  while i < aligns.len() do
    let p = sys.allocate(128, aligns[i])
    if p.is_null() then
      println("allocator_alignment: SystemAllocator::allocate(128, " + aligns[i].to_string() + ") failed")
      return 3
    end
    if !is_16_aligned(p) then
      println("allocator_alignment: SystemAllocator::allocate(128, " + aligns[i].to_string() + ") returned " + (p as Int).to_string() + " — not 16-aligned")
      return 4
    end
    sys.deallocate(p, 128, aligns[i])
    i = i + 1
  end

  # 3) The arena path: the backing buffer comes from SystemAllocator
  #    (16-aligned) and the aligned-offset math keeps every payload on
  #    a 16-byte boundary.
  var arena = arena_new(4096 as UInt)
  let a1 = arena.allocate(64, 16)
  if a1.is_null() then
    println("allocator_alignment: arena allocate 1 failed")
    return 5
  end
  if !is_16_aligned(a1) then
    println("allocator_alignment: arena payload 1 not 16-aligned")
    return 6
  end
  let a2 = arena.allocate(64, 16)
  if a2.is_null() then
    println("allocator_alignment: arena allocate 2 failed")
    return 7
  end
  if !is_16_aligned(a2) then
    println("allocator_alignment: arena payload 2 not 16-aligned")
    return 8
  end
  arena_destroy(&mut arena)

  # 4) The pool path: a pool with the fixed alignment 16. The pool
  #    divides its 16-aligned backing buffer into strides of
  #    round_up(max(block_size, 8), 16) bytes, so EVERY returned block —
  #    including the first block of an 8-byte pool — is 16-aligned (the
  #    old stride was max(block_size, 8): an 8-byte pool handed out
  #    8-aligned blocks).
  var pool = pool_new(8 as UInt, 64 as UInt)
  var last_block: Ptr[u8] = Ptr::null()
  i = 0
  while i < 64 do
    let b = pool.allocate(8, 16)
    if b.is_null() then
      println("allocator_alignment: pool allocate " + i.to_string() + " failed")
      return 9
    end
    if !is_16_aligned(b) then
      println("allocator_alignment: pool block " + i.to_string() + " not 16-aligned")
      return 10
    end
    last_block = b
    i = i + 1
  end

  # The pool is now exhausted; the free-list reuse re-issues a
  # deallocated block, still 16-aligned.
  let ex = pool.allocate(8, 16)
  if !ex.is_null() then
    println("allocator_alignment: pool should be exhausted after 64 allocates")
    return 11
  end
  pool.deallocate(last_block, 8, 16)
  let r = pool.allocate(8, 16)
  if r.is_null() then
    println("allocator_alignment: pool free-list reuse failed")
    return 12
  end
  if !is_16_aligned(r) then
    println("allocator_alignment: pool recycled block not 16-aligned")
    return 13
  end
  drop(pool)

  0
end
