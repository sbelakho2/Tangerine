# tests/semantic_snapshot_lineage_test.tg — third-audit item 11 (the
# persistent declaration lineage) end-to-end lane.
#
# The lineage model lives in tg_compiler/stable_ids.tg (StablePackageId /
# StableModuleId / DeclLineageId / DeclLineageStore, stable_decl_stamp and
# the unique-match rename rebinding), and the snapshot builder's store seam
# lives in tg_compiler/semantic_snapshot.tg (snapshot_stamp_decls — the def
# walk's declaration-stamping stage). This test drives
# snapshot_lineage_lane_check: ONE DeclLineageStore threaded across three
# builds of the builder's stamping stage —
#   build 1: a, b
#   build 2: a, x, b   (an unrelated insertion before b: every surviving
#                       StableDeclId is byte-identical)
#   build 3: a, x, c   (b renamed to c: the rebind rule preserves b's
#                       lineage under the new name)
# plus the unique-match and signature guards and a save/load persistence
# round-trip. The helper returns mismatch rows (empty = the whole lane
# verifies), the sibling lane-check convention.
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_snapshot_lineage_test.tg

use std::test::assert

use tg_compiler::semantic_snapshot::{snapshot_lineage_lane_check}

@test
def test_snapshot_lineage_continuity_lane() -> Unit
  let rows = snapshot_lineage_lane_check()
  assert(rows.len() == 0, "snapshot lineage lane mismatches: " + rows.join("; "))
end
