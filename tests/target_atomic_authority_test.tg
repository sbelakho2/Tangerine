# tests/target_atomic_authority_test.tg — audit item 43: THE ONE atomic
# authority's row answers.
#
# Every width/op/order decision of the atomic consumers (the LIR
# atomic-call lowering's route caps, the ARMv7-M validator, the RISC-V
# surface and the direct emitter's aarch64/x86 dispatch) is made by
# asking ONE target-side question — target_desc.atomic_support(desc,
# width, op_kind, order_word) -> Native | Emulated | Unsupported over
# the description's width classes — with the MMIO legality a SEPARATE
# question (mmio_atomic_support over mmio_atomic_widths: an EMULATED
# sub-word RMW reads and writes the WHOLE surrounding word and may
# touch a neighbouring MMIO register, so the emulated widths are never
# MMIO-legal). This suite pins the authority's row answers per
# canonical description, so the class data and the fail-closed rules
# cannot silently drift.

use std::test::*
use std::collections::{Vec}
use tg_compiler::target_desc::{
  TargetDesc, AtomicSupport, atomic_support, mmio_atomic_support,
  thumbv7em_cortex_m4f_desc, riscv64imac_desc, riscv32imac_desc
}

# A zabha-style riscv64 description (the extension token documented in
# target_desc.tg; no canonical instance carries it this slice): Zabha's
# true sub-word AMOs move the widths 1/2 from the EMULATED class into
# the NATIVE class (and, being single-register accesses, into the MMIO
# class too), leaving the emulated class empty — the authority answers
# must DIFFER from the plain riscv64ima rows below.
def zabha_style_desc() -> TargetDesc
  var d = riscv64imac_desc()
  d.name = "riscv64imazabha"
  d.isa_features = Vec::from(["i", "m", "a", "c", "zabha"])
  d.native_atomic_widths = Vec::from([1, 2, 4, 8])
  d.emulated_atomic_widths = Vec::new()
  d.mmio_atomic_widths = Vec::from([1, 2, 4, 8])
  d
end

# ———————————————————————————————————————————————————————————————
# ARMv7-M (the cortex-m4f instance) rows
# ———————————————————————————————————————————————————————————————

@test
def test_armv7m_m4f_atomic_support_rows() -> Unit
  let d = thumbv7em_cortex_m4f_desc()
  # Native class [1, 2, 4] — the LDREX/STREX (and byte/halfword
  # exclusive) surface of the M3/M4 class.
  assert_true(atomic_support(d, 1, "rmw", "seq_cst") == AtomicSupport::Native)
  assert_true(atomic_support(d, 2, "fetch_add", "acq_rel") == AtomicSupport::Native)
  assert_true(atomic_support(d, 4, "compare_exchange", "relaxed") == AtomicSupport::Native)
  # Width 8 is in NO class on ARMv7-M (no LDREXD/STREXD-class
  # exclusives, no doubleword atomic form): the authority's Unsupported
  # is the 8-byte fail-closed of the lowering and the validator.
  assert_true(atomic_support(d, 8, "rmw", "seq_cst") == AtomicSupport::Unsupported)
  assert_true(atomic_support(d, 8, "load", "seq_cst") == AtomicSupport::Unsupported)
  assert_true(atomic_support(d, 8, "compare_exchange", "seq_cst") == AtomicSupport::Unsupported)
  # The emulated class is empty on ARMv7-M: no width answers Emulated.
  assert_true(atomic_support(d, 1, "rmw", "seq_cst") != AtomicSupport::Emulated)
end

@test
def test_armv7m_m4f_order_and_op_gates() -> Unit
  let d = thumbv7em_cortex_m4f_desc()
  # An out-of-domain order word fails closed even for a native width;
  # an empty op token fails closed too (never silently consulted
  # away).
  assert_true(atomic_support(d, 4, "rmw", "not_an_ordering") == AtomicSupport::Unsupported)
  assert_true(atomic_support(d, 4, "rmw", "") == AtomicSupport::Unsupported)
  assert_true(atomic_support(d, 4, "", "seq_cst") == AtomicSupport::Unsupported)
end

# ———————————————————————————————————————————————————————————————
# riscv64ima rows (native [4, 8], emulated [1, 2], mmio == native)
# ———————————————————————————————————————————————————————————————

@test
def test_riscv64ima_atomic_support_rows() -> Unit
  let d = riscv64imac_desc()
  # The A extension's LR/SC word/doubleword surface.
  assert_true(atomic_support(d, 4, "rmw", "seq_cst") == AtomicSupport::Native)
  assert_true(atomic_support(d, 8, "compare_exchange", "seq_cst") == AtomicSupport::Native)
  # The sub-word widths 1/2 are the EMULATED class (no byte/halfword
  # LR/SC without Zabha; backend_rv.tg serves them on NORMAL memory by
  # the masked word-width loops of audit item 43).
  assert_true(atomic_support(d, 1, "rmw", "seq_cst") == AtomicSupport::Emulated)
  assert_true(atomic_support(d, 2, "compare_exchange", "relaxed") == AtomicSupport::Emulated)
  # A width in neither class (3 bytes) fails closed.
  assert_true(atomic_support(d, 3, "rmw", "seq_cst") == AtomicSupport::Unsupported)
end

@test
def test_riscv64ima_mmio_rows() -> Unit
  let d = riscv64imac_desc()
  # mmio_atomic_widths == the native set: 4/8 are single-register
  # accesses, MMIO-legal.
  assert_true(mmio_atomic_support(d, 4, "rmw") == AtomicSupport::Native)
  assert_true(mmio_atomic_support(d, 8, "rmw") == AtomicSupport::Native)
  # The EMULATED sub-word widths never appear in mmio_atomic_widths:
  # mmio_atomic_support answers Unsupported for them (an emulated word
  # LR/SC loop touches the WHOLE surrounding word — a neighbouring MMIO
  # side register would be corrupted; Emulated is never an MMIO
  # answer).
  assert_true(atomic_support(d, 1, "rmw", "seq_cst") == AtomicSupport::Emulated)
  assert_true(mmio_atomic_support(d, 1, "rmw") == AtomicSupport::Unsupported)
  assert_true(mmio_atomic_support(d, 2, "compare_exchange") == AtomicSupport::Unsupported)
end

# ———————————————————————————————————————————————————————————————
# riscv32ima rows (native [4], emulated [1, 2]; width 8 in no class)
# ———————————————————————————————————————————————————————————————

@test
def test_riscv32ima_atomic_support_rows() -> Unit
  let d = riscv32imac_desc()
  # The RV32 word is the A extension's only native LR/SC width.
  assert_true(atomic_support(d, 4, "rmw", "seq_cst") == AtomicSupport::Native)
  # Sub-word 1/2: EMULATED (the masked word-width loops on NORMAL
  # memory).
  assert_true(atomic_support(d, 1, "rmw", "seq_cst") == AtomicSupport::Emulated)
  assert_true(atomic_support(d, 2, "compare_exchange", "seq_cst") == AtomicSupport::Emulated)
  # Width 8 is in NEITHER class on riscv32 (no LR.D/SC.D): the
  # authority's Unsupported is the riscv32 8-byte fail-closed of the
  # lowering (the _u64 intrinsic) and the validator — no bare-xlen
  # conditional anywhere.
  assert_true(atomic_support(d, 8, "rmw", "seq_cst") == AtomicSupport::Unsupported)
  assert_true(atomic_support(d, 8, "load", "seq_cst") == AtomicSupport::Unsupported)
end

@test
def test_riscv32ima_mmio_rows() -> Unit
  let d = riscv32imac_desc()
  # mmio == native ([4]) on riscv32.
  assert_true(mmio_atomic_support(d, 4, "rmw") == AtomicSupport::Native)
  assert_true(mmio_atomic_support(d, 8, "rmw") == AtomicSupport::Unsupported)
  # The emulated widths 1/2 are never MMIO-legal (see the riscv64
  # rows).
  assert_true(mmio_atomic_support(d, 1, "rmw") == AtomicSupport::Unsupported)
  assert_true(mmio_atomic_support(d, 2, "compare_exchange") == AtomicSupport::Unsupported)
end

# ———————————————————————————————————————————————————————————————
# The zabha-style desc rows (native += [1, 2]) — the authority must
# DIFFER from the plain riscv64ima answers
# ———————————————————————————————————————————————————————————————

@test
def test_zabha_style_desc_differs() -> Unit
  let plain = riscv64imac_desc()
  let zabha = zabha_style_desc()
  # 1/2 move from Emulated to Native under Zabha's true sub-word AMOs.
  assert_true(atomic_support(plain, 1, "rmw", "seq_cst") == AtomicSupport::Emulated)
  assert_true(atomic_support(zabha, 1, "rmw", "seq_cst") == AtomicSupport::Native)
  assert_true(atomic_support(zabha, 2, "fetch_add", "acq_rel") == AtomicSupport::Native)
  # The word/doubleword surface is unchanged.
  assert_true(atomic_support(zabha, 4, "rmw", "seq_cst") == AtomicSupport::Native)
  assert_true(atomic_support(zabha, 8, "rmw", "seq_cst") == AtomicSupport::Native)
  # Zabha's sub-word AMOs access exactly the addressed byte/halfword,
  # so 1/2 join the MMIO class (single-register accesses): the MMIO
  # answer differs from the plain desc too.
  assert_true(mmio_atomic_support(plain, 1, "rmw") == AtomicSupport::Unsupported)
  assert_true(mmio_atomic_support(zabha, 1, "rmw") == AtomicSupport::Native)
  assert_true(mmio_atomic_support(zabha, 2, "rmw") == AtomicSupport::Native)
  # The emulated class is empty under Zabha: no width answers Emulated.
  assert_true(atomic_support(zabha, 1, "rmw", "seq_cst") != AtomicSupport::Emulated)
  assert_true(atomic_support(zabha, 2, "rmw", "seq_cst") != AtomicSupport::Emulated)
end
