# Test: match on &ExprKind (reference) vs match on ExprKind (value)
use tg_compiler::ast::ExprKind
use tg_compiler::ast::AstPath

# Match on a reference (like expr_kind_name does)
def test_match_ref(kind: &ExprKind) -> String
  match kind
  when ExprKind::ExprIntLit(_) then "int"
  when ExprKind::ExprMethodCall(_, _, _, _) then "method_call"
  when ExprKind::ExprEnumVariant(_, _) then "enum_variant"
  when _ then "other"
  end
end

# Match on a value (like lower_expr_to_rvalue does)
def test_match_val(kind: ExprKind) -> String
  match kind
  when ExprKind::ExprIntLit(_) then "int"
  when ExprKind::ExprMethodCall(_, _, _, _) then "method_call"
  when ExprKind::ExprEnumVariant(_, _) then "enum_variant"
  when _ then "other"
  end
end

def main() -> Int
  let int_val: ExprKind = ExprKind::ExprIntLit(42)
  println("ref: " + test_match_ref(&int_val))
  0
end
