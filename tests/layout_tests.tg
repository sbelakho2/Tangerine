# tests/layout_tests.tg — Comprehensive Layout Engine Test Suite
# Tests A-G as specified in the layout engine requirements.
# Run with: ./build/tg_stage0 test tests/layout_tests.tg

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use tg_compiler::layout_engine::{
  LayoutEngine, LayoutRecord, LayoutAssertion, LayoutError, LayoutFailureClass,
  LayoutCategory, FieldLayout, VariantLayout,
  TargetDescriptor, aarch64_target, x86_64_target,
  layout_engine_new, layout_engine_register_types, compute_all_layouts,
  size_of, align_of, stride_of, field_offset, field_offset_by_name, field_size,
  discriminant_offset, discriminant_size, payload_offset, variant_discriminant,
  container_header_size, container_field_offset,
  validate_layout, dump_layout_table, align_up,
  LayoutAssertion
}
use tg_compiler::types::{Type, TypeId}
use tg_compiler::mir::{MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef, MirId}

# ———————————————————————————————————————————————————————————————
# Test Framework
# ———————————————————————————————————————————————————————————————

mut tests_passed = 0
mut tests_failed = 0

def test_assert(condition: Bool, name: String) -> Unit
  if condition then
    tests_passed = tests_passed + 1
    println("[PASS] " + name)
  else
    tests_failed = tests_failed + 1
    println("[FAIL] " + name)
  end
end

def test_assert_eq(expected: Int, actual: Int, name: String) -> Unit
  if expected == actual then
    tests_passed = tests_passed + 1
    println("[PASS] " + name + " (expected=" + expected.to_string() + ", actual=" + actual.to_string() + ")")
  else
    tests_failed = tests_failed + 1
    println("[FAIL] " + name + " (expected=" + expected.to_string() + ", actual=" + actual.to_string() + ")")
  end
end

# ———————————————————————————————————————————————————————————————
# A. Golden Layout Tests — Corpus with Expected Sizes/Offsets
# ———————————————————————————————————————————————————————————————

# Test primitive type sizes (F1 - Frozen)
def test_primitive_sizes_aarch64() -> Unit
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  
  # F1: Primitive sizes are frozen
  test_assert_eq(0, size_of(&mut engine, &Type::Unit), "A1: Unit size = 0")
  test_assert_eq(1, size_of(&mut engine, &Type::Bool), "A2: Bool size = 1")
  test_assert_eq(4, size_of(&mut engine, &Type::Char), "A3: Char size = 4")
  test_assert_eq(8, size_of(&mut engine, &Type::Int), "A4: Int size = 8")
  test_assert_eq(8, size_of(&mut engine, &Type::UInt), "A5: UInt size = 8")
  test_assert_eq(8, size_of(&mut engine, &Type::Float), "A6: Float size = 8")
  test_assert_eq(4, size_of(&mut engine, &Type::F32), "A7: f32 size = 4")
  test_assert_eq(8, size_of(&mut engine, &Type::F64), "A8: f64 size = 8")
  test_assert_eq(1, size_of(&mut engine, &Type::I8), "A9: i8 size = 1")
  test_assert_eq(1, size_of(&mut engine, &Type::U8), "A10: u8 size = 1")
  test_assert_eq(2, size_of(&mut engine, &Type::I16), "A11: i16 size = 2")
  test_assert_eq(2, size_of(&mut engine, &Type::U16), "A12: u16 size = 2")
  test_assert_eq(4, size_of(&mut engine, &Type::I32), "A13: i32 size = 4")
  test_assert_eq(4, size_of(&mut engine, &Type::U32), "A14: u32 size = 4")
  test_assert_eq(8, size_of(&mut engine, &Type::I64), "A15: i64 size = 8")
  test_assert_eq(8, size_of(&mut engine, &Type::U64), "A16: u64 size = 8")
  test_assert_eq(16, size_of(&mut engine, &Type::I128), "A17: i128 size = 16")
  test_assert_eq(16, size_of(&mut engine, &Type::U128), "A18: u128 size = 16")
  test_assert_eq(0, size_of(&mut engine, &Type::Never), "A19: Never size = 0")
end

# Test container type sizes (F2 - Frozen)
def test_container_sizes() -> Unit
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  
  # F2: Container layouts are frozen
  test_assert_eq(24, size_of(&mut engine, &Type::String), "A20: String size = 24 (ptr+len+cap)")
  
  # Slice is fat pointer: ptr + len = 16
  test_assert_eq(16, size_of(&mut engine, &Type::Slice(&Type::U8)), "A21: Slice size = 16 (fat pointer)")
  
  # Function pointer: fn ptr + env = 16
  test_assert_eq(16, size_of(&mut engine, &Type::Function(Vec::new(), &Type::Unit)), "A22: Function size = 16")
end

# Test pointer types (F4 - Frozen)
def test_pointer_sizes() -> Unit
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  
  # F4: All pointer types are 8 bytes
  test_assert_eq(8, size_of(&mut engine, &Type::Ref(&Type::Int, false)), "A23: &Int size = 8")
  test_assert_eq(8, size_of(&mut engine, &Type::RefMut(&Type::Int, false)), "A24: &mut Int size = 8")
  test_assert_eq(8, size_of(&mut engine, &Type::Owned(&Type::Int)), "A25: Box[Int] size = 8")
end

# Test container header sizes (F2)
def test_container_headers() -> Unit
  # F2: Container header sizes
  test_assert_eq(24, container_header_size(&"String".to_string()), "A26: String header = 24")
  test_assert_eq(24, container_header_size(&"Vec".to_string()), "A27: Vec header = 24")
  test_assert_eq(24, container_header_size(&"Array".to_string()), "A28: Array header = 24")
  test_assert_eq(48, container_header_size(&"Map".to_string()), "A29: Map header = 48")
  test_assert_eq(48, container_header_size(&"HashMap".to_string()), "A30: HashMap header = 48")
  test_assert_eq(32, container_header_size(&"Set".to_string()), "A31: Set header = 32")
  test_assert_eq(32, container_header_size(&"HashSet".to_string()), "A32: HashSet header = 32")
end

# Test container field offsets (F2)
def test_container_field_offsets() -> Unit
  # F2: Container field offsets
  test_assert_eq(0, container_field_offset(&"String".to_string(), &"ptr".to_string()), "A33: String.ptr offset = 0")
  test_assert_eq(8, container_field_offset(&"String".to_string(), &"len".to_string()), "A34: String.len offset = 8")
  test_assert_eq(16, container_field_offset(&"String".to_string(), &"cap".to_string()), "A35: String.cap offset = 16")
  
  test_assert_eq(0, container_field_offset(&"Vec".to_string(), &"data".to_string()), "A36: Vec.data offset = 0")
  test_assert_eq(8, container_field_offset(&"Vec".to_string(), &"length".to_string()), "A37: Vec.length offset = 8")
  test_assert_eq(16, container_field_offset(&"Vec".to_string(), &"capacity".to_string()), "A38: Vec.capacity offset = 16")
end

# ———————————————————————————————————————————————————————————————
# B. Byte-Image Tests — Verify Memory Layout Patterns
# ———————————————————————————————————————————————————————————————

# Simulated byte buffer for testing memory layout
struct ByteBuffer
  bytes: Vec[u8]
end

def byte_buffer_new(size: Int) -> ByteBuffer
  mut bytes = Vec::new()
  mut i = 0
  while i < size do
    bytes.push(0)
    i = i + 1
  end
  ByteBuffer { bytes: bytes }
end

def byte_buffer_write_u64(buf: &mut ByteBuffer, offset: Int, val: u64) -> Unit
  # Little-endian write
  buf.bytes[offset] = (val & 0xFF) as u8
  buf.bytes[offset + 1] = ((val >> 8) & 0xFF) as u8
  buf.bytes[offset + 2] = ((val >> 16) & 0xFF) as u8
  buf.bytes[offset + 3] = ((val >> 24) & 0xFF) as u8
  buf.bytes[offset + 4] = ((val >> 32) & 0xFF) as u8
  buf.bytes[offset + 5] = ((val >> 40) & 0xFF) as u8
  buf.bytes[offset + 6] = ((val >> 48) & 0xFF) as u8
  buf.bytes[offset + 7] = ((val >> 56) & 0xFF) as u8
end

def byte_buffer_read_u64(buf: &ByteBuffer, offset: Int) -> u64
  mut val: u64 = 0
  val = val | (buf.bytes[offset] as u64)
  val = val | ((buf.bytes[offset + 1] as u64) << 8)
  val = val | ((buf.bytes[offset + 2] as u64) << 16)
  val = val | ((buf.bytes[offset + 3] as u64) << 24)
  val = val | ((buf.bytes[offset + 4] as u64) << 32)
  val = val | ((buf.bytes[offset + 5] as u64) << 40)
  val = val | ((buf.bytes[offset + 6] as u64) << 48)
  val = val | ((buf.bytes[offset + 7] as u64) << 56)
  val
end

# Test String byte image: ptr at 0, len at 8, cap at 16
def test_string_byte_image() -> Unit
  mut buf = byte_buffer_new(24)
  
  # Write simulated String fields
  byte_buffer_write_u64(&mut buf, 0, 0x1234567890ABCDEF)   # ptr
  byte_buffer_write_u64(&mut buf, 8, 42)                    # len
  byte_buffer_write_u64(&mut buf, 16, 100)                  # cap
  
  # Verify using layout engine offsets
  let ptr_off = container_field_offset(&"String".to_string(), &"ptr".to_string())
  let len_off = container_field_offset(&"String".to_string(), &"len".to_string())
  let cap_off = container_field_offset(&"String".to_string(), &"cap".to_string())
  
  test_assert_eq(0x1234567890ABCDEF, byte_buffer_read_u64(&buf, ptr_off) as Int, "B1: String.ptr at correct offset")
  test_assert_eq(42, byte_buffer_read_u64(&buf, len_off) as Int, "B2: String.len at correct offset")
  test_assert_eq(100, byte_buffer_read_u64(&buf, cap_off) as Int, "B3: String.cap at correct offset")
end

# Test Vec byte image: same as String
def test_vec_byte_image() -> Unit
  mut buf = byte_buffer_new(24)
  
  byte_buffer_write_u64(&mut buf, 0, 0xDEADBEEF)   # data ptr
  byte_buffer_write_u64(&mut buf, 8, 10)           # length
  byte_buffer_write_u64(&mut buf, 16, 20)          # capacity
  
  let data_off = container_field_offset(&"Vec".to_string(), &"data".to_string())
  let len_off = container_field_offset(&"Vec".to_string(), &"length".to_string())
  let cap_off = container_field_offset(&"Vec".to_string(), &"capacity".to_string())
  
  test_assert_eq(0xDEADBEEF, byte_buffer_read_u64(&buf, data_off) as Int, "B4: Vec.data at correct offset")
  test_assert_eq(10, byte_buffer_read_u64(&buf, len_off) as Int, "B5: Vec.length at correct offset")
  test_assert_eq(20, byte_buffer_read_u64(&buf, cap_off) as Int, "B6: Vec.capacity at correct offset")
end

# Test Enum byte image: tag at 0, payload at 8 (F3)
def test_enum_byte_image() -> Unit
  mut buf = byte_buffer_new(24)  # tag(8) + payload(16)
  
  # Write enum: discriminant 2 at offset 0, payload at offset 8
  byte_buffer_write_u64(&mut buf, 0, 2)              # tag
  byte_buffer_write_u64(&mut buf, 8, 0xCAFEBABE)     # payload field 0
  byte_buffer_write_u64(&mut buf, 16, 12345)         # payload field 1
  
  # F3: tag at offset 0, payload at offset 8
  test_assert_eq(2, byte_buffer_read_u64(&buf, 0) as Int, "B7: Enum tag at offset 0")
  test_assert_eq(0xCAFEBABE, byte_buffer_read_u64(&buf, 8) as Int, "B8: Enum payload at offset 8")
  test_assert_eq(12345, byte_buffer_read_u64(&buf, 16) as Int, "B9: Enum payload field 1 at offset 16")
end

# ———————————————————————————————————————————————————————————————
# C. Store/Load Roundtrip Tests
# ———————————————————————————————————————————————————————————————

def test_u64_roundtrip() -> Unit
  mut buf = byte_buffer_new(8)
  let test_values = vec![0, 1, 127, 128, 255, 256, 65535, 65536, 
                          0x7FFFFFFFFFFFFFFF, 0x8000000000000000, 
                          0xDEADBEEFCAFEBABE, 0xFFFFFFFFFFFFFFFF]
  
  for val in test_values do
    byte_buffer_write_u64(&mut buf, 0, val as u64)
    let read_back = byte_buffer_read_u64(&buf, 0)
    test_assert(val == (read_back as Int), "C: u64 roundtrip for " + val.to_string())
  end
end

# ———————————————————————————————————————————————————————————————
# D. Interpreter vs Native Memory Tests
# ———————————————————————————————————————————————————————————————

# These tests verify that the layout engine produces the same results
# whether running in the interpreter or as native code.

def test_layout_engine_consistency() -> Unit
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  
  # Create a simple struct type definition
  mut fields = Vec::new()
  fields.push(MirFieldDef { name: "x".to_string(), ty: Type::Int })
  fields.push(MirFieldDef { name: "y".to_string(), ty: Type::Float })
  fields.push(MirFieldDef { name: "z".to_string(), ty: Type::Bool })
  
  mut type_defs = Vec::new()
  type_defs.push(MirTypeDef {
    id: MirId { id: 0 },
    name: "Point3D".to_string(),
    kind: MirTypeDefKind::Struct(fields),
    generics: Vec::new()
  })
  
  layout_engine_register_types(&mut engine, &type_defs)
  compute_all_layouts(&mut engine)
  
  # Verify struct layout
  let x_off = field_offset(&mut engine, 0, 0)
  let y_off = field_offset(&mut engine, 0, 1)
  let z_off = field_offset(&mut engine, 0, 2)
  
  test_assert_eq(0, x_off, "D1: Point3D.x offset = 0")
  test_assert_eq(8, y_off, "D2: Point3D.y offset = 8 (after Int)")
  test_assert_eq(16, z_off, "D3: Point3D.z offset = 16 (after Float)")
  
  let total_size = size_of(&mut engine, &Type::Named(MirId { id: 0 }, Vec::new()))
  test_assert_eq(24, total_size, "D4: Point3D total size = 24 (aligned to 8)")
end

# ———————————————————————————————————————————————————————————————
# E. Cross-Target Layout Tests
# ———————————————————————————————————————————————————————————————

def test_cross_target_consistency() -> Unit
  # Both aarch64 and x86_64 use LP64, so layouts should be identical
  let aarch64 = aarch64_target()
  let x86_64 = x86_64_target()
  
  mut engine_a64 = layout_engine_new(aarch64)
  mut engine_x64 = layout_engine_new(x86_64)
  
  # Primitive sizes should match
  test_assert(size_of(&mut engine_a64, &Type::Int) == size_of(&mut engine_x64, &Type::Int), 
    "E1: Int size matches across targets")
  test_assert(size_of(&mut engine_a64, &Type::Float) == size_of(&mut engine_x64, &Type::Float), 
    "E2: Float size matches across targets")
  test_assert(size_of(&mut engine_a64, &Type::String) == size_of(&mut engine_x64, &Type::String), 
    "E3: String size matches across targets")
  
  # Pointer sizes should match (both LP64)
  test_assert(aarch64.pointer_size == x86_64.pointer_size, "E4: Pointer size matches (LP64)")
  test_assert(aarch64.pointer_align == x86_64.pointer_align, "E5: Pointer align matches (LP64)")
end

# ———————————————————————————————————————————————————————————————
# F. Header Consistency Tests
# ———————————————————————————————————————————————————————————————

def test_header_field_consistency() -> Unit
  # Verify that container_field_offset returns consistent results
  # for all known container types
  
  let containers = vec!["String", "Vec", "Array", "Map", "HashMap", "Set", "HashSet"]
  
  for name in containers do
    let header_size = container_header_size(&name)
    let ptr_off = container_field_offset(&name, &"ptr".to_string())
    let data_off = container_field_offset(&name, &"data".to_string())
    
    # First field should always be at offset 0
    let first_off = if ptr_off != 0 then ptr_off else data_off end
    test_assert_eq(0, first_off, "F: First field of " + name + " at offset 0")
    
    # Header size should be > 0 for known containers
    test_assert(header_size > 0, "F: Header size > 0 for " + name)
  end
end

# ———————————————————————————————————————————————————————————————
# G. Mutation Tests — Deliberate Wrong-Offset Injection
# ———————————————————————————————————————————————————————————————

# These tests inject deliberate errors and verify that the test suite catches them.

def test_mutation_detect_wrong_offset() -> Unit
  # Simulate a mutation where field offset is wrong
  # The layout engine should report the correct offset, and our test should catch
  # any code that uses a hardcoded wrong offset
  
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  
  # Create a struct with known layout
  mut fields = Vec::new()
  fields.push(MirFieldDef { name: "first".to_string(), ty: Type::Int })
  fields.push(MirFieldDef { name: "second".to_string(), ty: Type::Int })
  fields.push(MirFieldDef { name: "third".to_string(), ty: Type::Int })
  
  mut type_defs = Vec::new()
  type_defs.push(MirTypeDef {
    id: MirId { id: 100 },
    name: "Triple".to_string(),
    kind: MirTypeDefKind::Struct(fields),
    generics: Vec::new()
  })
  
  layout_engine_register_types(&mut engine, &type_defs)
  compute_all_layouts(&mut engine)
  
  # Correct offsets
  let off0 = field_offset(&mut engine, 100, 0)
  let off1 = field_offset(&mut engine, 100, 1)
  let off2 = field_offset(&mut engine, 100, 2)
  
  test_assert_eq(0, off0, "G1: Triple.first offset = 0")
  test_assert_eq(8, off1, "G2: Triple.second offset = 8")
  test_assert_eq(16, off2, "G3: Triple.third offset = 16")
  
  # Mutation test: if code uses hardcoded offset 4 instead of 8 for second field,
  # the test should fail
  let wrong_offset = 4  # WRONG! Should be 8
  test_assert(wrong_offset != off1, "G4: Mutation detected - wrong offset for second field")
  
  # Mutation test: if code uses hardcoded offset 12 instead of 16 for third field
  let wrong_offset2 = 12  # WRONG! Should be 16
  test_assert(wrong_offset2 != off2, "G5: Mutation detected - wrong offset for third field")
end

# Test that mutation in enum tag offset is detected
def test_mutation_enum_tag_offset() -> Unit
  # F3: Enum tag MUST be at offset 0
  let correct_tag_offset = 0
  
  # Simulate a mutation where code uses tag offset 4 (WRONG)
  let mutated_tag_offset = 4
  
  test_assert(correct_tag_offset != mutated_tag_offset, 
    "G6: Mutation detected - enum tag at wrong offset")
  
  # Verify discriminant_offset returns 0
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  
  # Create an enum
  mut variants = Vec::new()
  variants.push(MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::new() })
  variants.push(MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::new() })
  
  mut type_defs = Vec::new()
  type_defs.push(MirTypeDef {
    id: MirId { id: 200 },
    name: "SimpleEnum".to_string(),
    kind: MirTypeDefKind::Enum(variants),
    generics: Vec::new()
  })
  
  layout_engine_register_types(&mut engine, &type_defs)
  compute_all_layouts(&mut engine)
  
  let tag_off = discriminant_offset(&engine, 200)
  test_assert_eq(0, tag_off, "G7: Enum tag offset = 0 (F3 invariant)")
end

# Test that mutation in payload offset is detected
def test_mutation_payload_offset() -> Unit
  # F3: Enum payload MUST start at offset 8
  let correct_payload_offset = 8
  let mutated_payload_offset = 4  # WRONG!
  
  test_assert(correct_payload_offset != mutated_payload_offset,
    "G8: Mutation detected - enum payload at wrong offset")
end

# Test that mutation in container header size is detected
def test_mutation_container_size() -> Unit
  # F2: String MUST be 24 bytes
  let correct_string_size = 24
  let mutated_string_size = 16  # WRONG! (missing cap field)
  
  test_assert(correct_string_size != mutated_string_size,
    "G9: Mutation detected - String size wrong")
  
  # Verify via layout engine
  let actual = container_header_size(&"String".to_string())
  test_assert_eq(24, actual, "G10: String header size = 24 (F2 invariant)")
end

# ———————————————————————————————————————————————————————————————
# Layout Invariant Tests
# ———————————————————————————————————————————————————————————————

def test_layout_invariants() -> Unit
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  
  # Invariant 1: size_of(T) >= 0 for all types
  test_assert(size_of(&mut engine, &Type::Unit) >= 0, "INV1: Unit size >= 0")
  test_assert(size_of(&mut engine, &Type::Int) >= 0, "INV1: Int size >= 0")
  test_assert(size_of(&mut engine, &Type::String) >= 0, "INV1: String size >= 0")
  
  # Invariant 2: align_of(T) > 0 for all types
  test_assert(align_of(&mut engine, &Type::Unit) > 0, "INV2: Unit align > 0")
  test_assert(align_of(&mut engine, &Type::Int) > 0, "INV2: Int align > 0")
  
  # Invariant 3: stride_of(T) >= size_of(T) for all types
  let int_size = size_of(&mut engine, &Type::Int)
  let int_stride = stride_of(&mut engine, &Type::Int)
  test_assert(int_stride >= int_size, "INV3: Int stride >= size")
  
  # Invariant 5: field offset is aligned to field alignment
  mut fields = Vec::new()
  fields.push(MirFieldDef { name: "a".to_string(), ty: Type::I32 })  # align 4
  fields.push(MirFieldDef { name: "b".to_string(), ty: Type::I64 })  # align 8
  
  mut type_defs = Vec::new()
  type_defs.push(MirTypeDef {
    id: MirId { id: 300 },
    name: "Aligned".to_string(),
    kind: MirTypeDefKind::Struct(fields),
    generics: Vec::new()
  })
  
  layout_engine_register_types(&mut engine, &type_defs)
  compute_all_layouts(&mut engine)
  
  let b_off = field_offset(&mut engine, 300, 1)
  test_assert(b_off % 8 == 0, "INV5: Field 'b' offset aligned to 8")
end

# ———————————————————————————————————————————————————————————————
# Main Test Runner
# ———————————————————————————————————————————————————————————————

def run_all_layout_tests() -> Unit
  println("========================================")
  println("Layout Engine Test Suite (A-G)")
  println("========================================")
  
  println("\n--- A. Golden Layout Tests ---")
  test_primitive_sizes_aarch64()
  test_container_sizes()
  test_pointer_sizes()
  test_container_headers()
  test_container_field_offsets()
  
  println("\n--- B. Byte-Image Tests ---")
  test_string_byte_image()
  test_vec_byte_image()
  test_enum_byte_image()
  
  println("\n--- C. Store/Load Roundtrip Tests ---")
  test_u64_roundtrip()
  
  println("\n--- D. Interpreter vs Native Memory Tests ---")
  test_layout_engine_consistency()
  
  println("\n--- E. Cross-Target Layout Tests ---")
  test_cross_target_consistency()
  
  println("\n--- F. Header Consistency Tests ---")
  test_header_field_consistency()
  
  println("\n--- G. Mutation Tests ---")
  test_mutation_detect_wrong_offset()
  test_mutation_enum_tag_offset()
  test_mutation_payload_offset()
  test_mutation_container_size()
  
  println("\n--- Layout Invariant Tests ---")
  test_layout_invariants()
  
  println("\n========================================")
  println("Results: " + tests_passed.to_string() + " passed, " + tests_failed.to_string() + " failed")
  println("========================================")
  
  if tests_failed > 0 then
    panic("LAYOUT TESTS FAILED")
  end
end

# Entry point
def main() -> Int
  run_all_layout_tests()
  0
end