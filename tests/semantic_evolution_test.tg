# tests/semantic_evolution_test.tg — third-audit item 48, evolution-plan
# family: the plan builders of tg_compiler/semantic_evolution.tg.
#
# The model (the four plan records and their documented verdict rules, the
# before-set carriers the enum plan reads, the typed ABI mirrors the
# signature plan prefers, the TraitImplEdge / TraitSelectionEdge obligations
# the trait plan walks, the call-graph capability propagation and the §36
# budget constraint mapping) lives in tg_compiler/semantic_evolution.tg.
# This suite drives its self-checking lane rows; the lane builds small
# snapshot pairs through the semantic_delta.tg lane fixtures, diffs them
# through the REAL semantic_delta_of, and returns the mismatch rows
# (empty = the lane verifies).
#
#   semantic_evolution_lane_check — EN (enum plans E1-E8), SG (signature
#     plans S1-S10), TR (trait plans T1-T5), CP (capability propagation
#     C1-C2) and BD (the budget mapping + the end-to-end round trip
#     B1-B5).
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_evolution_test.tg

use std::test::assert

use tg_compiler::semantic_evolution::{
  semantic_evolution_lane_check
}

@test
def test_semantic_evolution_lane() -> Unit
  let rows = semantic_evolution_lane_check()
  assert(rows.len() == 0, "semantic evolution lane mismatches: " + rows.join("; "))
end
