# tests/executor_clock_test.tg — the ExecutorClock: the SleepFuture and
# the TimeoutFuture fix their deadlines at the FIRST poll from the
# executor's clock (the deterministic mode's virtual_time, the wall clock
# otherwise) — never at construction and never from the raw wall clock.
# The deterministic run advances virtual_time and the sleeps/timeouts
# complete against that advance (the wall clock never moves there).

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::time::{Duration}

@test
def test_deterministic_sleep_completes_on_virtual_time() -> Unit
  mut exec = std::async::executor_new()
  exec.set_deterministic(1u64)
  let handle = exec.spawn(async {
    std::async::sleep_millis(50).await
  })
  exec.run()
  # the virtual time was advanced to the sleep's deadline and the sleep
  # completed — the wall clock never moved in the deterministic run
  assert_true(handle.is_finished())
end

@test
def test_deterministic_nested_timeout_sleep() -> Unit
  mut exec = std::async::executor_new()
  exec.set_deterministic(1u64)
  let mut events = Vec::new()
  # the inner sleep (20ms) completes BEFORE the timeout (100ms) — Ok; the
  # timeout's deadline is fixed at its first poll from the same clock
  let h1 = exec.spawn(async {
    let r = std::async::timeout(Duration::from_millis(100), std::async::sleep_millis(20)).await
    match r
    when Result::Ok(_) then events.push(1)
    when Result::Err(_) then events.push(2)
    end
  })
  # the timeout (10ms) fires BEFORE the inner sleep (1000ms) — Err
  let h2 = exec.spawn(async {
    let r = std::async::timeout(Duration::from_millis(10), std::async::sleep_millis(1000)).await
    match r
    when Result::Ok(_) then events.push(3)
    when Result::Err(_) then events.push(4)
    end
  })
  exec.run()
  assert_true(h1.is_finished())
  assert_true(h2.is_finished())
  assert_eq(events.len(), 2)
  assert_true(events.contains(1))
  assert_true(events.contains(4))
end
