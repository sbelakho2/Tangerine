# tests/integration/test_window_lifecycle.tg — Window lifecycle + event loop §21.2
use std::test::*
use std::app
use std::gfx
use std::geom

# --- Window lifecycle ---

@test
def test_softwareapp_create_and_drop() -> Unit
  let opts = AppOpts {
    title: "Test App",
    width: 320,
    height: 240,
    resizable: true,
    vsync: true,
    high_dpi: true,
    transparent: false
  }
  let app = SoftwareApp::new(opts)
  # App created successfully
  assert_true(true)
  # Drop is implicit
end

# --- Frame lifecycle ---

@test
def test_full_frame_lifecycle_begin_draw_end_present() -> Unit
  let surface = gfx::create_software_surface(100, 100)

  # Begin frame
  let canvas = surface.begin_frame()

  # Clear
  let bg = Color { r: 0.1, g: 0.1, b: 0.1, a: 1.0 }
  canvas.clear(bg)

  # Draw rect
  let paint = gfx::solid_paint(Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 })
  canvas.fill_rect(Rect { x: 10.0, y: 10.0, w: 50.0, h: 30.0 }, paint)

  # Draw with transform
  canvas.save()
  canvas.transform(geom::transform_translate(20.0, 20.0))
  canvas.fill_rect(Rect { x: 0.0, y: 0.0, w: 10.0, h: 10.0 }, paint)
  canvas.restore()

  # End frame
  surface.end_frame()

  # Present
  surface.present()

  assert_true(true)
end

# --- Image pipeline ---

@test
def test_image_decode_upload_draw_pipeline() -> Unit
  use std::image

  # Create a minimal 1x1 PNG in memory
  let bitmap = Bitmap {
    info: ImageInfo {
      width: 2,
      height: 2,
      format: PixelFormat::RGBA8,
      color_space: ColorSpace::SRGB,
      stride: 8
    },
    data: [255u8, 0u8, 0u8, 255u8, 0u8, 255u8, 0u8, 255u8,
           0u8, 0u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8]
  }

  # Encode to PNG
  let opts = EncodeOpts { quality: 100 }
  let encoded = image::encode_png(bitmap, opts)
  match encoded
  when Ok(png_bytes)
    # Decode back
    let decoded = image::decode_png(png_bytes, DecodeOpts {})
    match decoded
    when Ok(bmp)
      assert_eq(bmp.info.width, 2)
      assert_eq(bmp.info.height, 2)
    when Err(e)
      assert_false(true)
    end
  when Err(e)
    assert_false(true)
  end
end

# --- Text pipeline ---

@test
def test_text_layout_glyph_draw_pipeline() -> Unit
  use std::text

  let db = text::font_db_new()
  let style = TextStyle {
    font: FontId { id: 0 },
    size: 16.0,
    color: Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    direction: Direction::LTR
  }
  let layout_opts = LayoutOpts {
    max_width: 200.0,
    align: TextAlign::Left,
    line_height: 1.2
  }
  let layout = text::layout("Hello World", style, layout_opts)
  assert_true(layout.lines.len() >= 1)

  # Draw on a canvas
  let surface = gfx::create_software_surface(200, 50)
  let canvas = surface.begin_frame()
  # Would call canvas.draw_glyph_run for each line's run
  for line in layout.lines
    canvas.draw_glyph_run(line.run, style.color)
  end
  surface.end_frame()
  assert_true(true)
end

# --- UI tree pipeline ---

@test
def test_ui_tree_measure_layout_paint_event() -> Unit
  use std::ui_toolkit

  let theme = Theme {
    bg: Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 },
    fg: Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    accent: Color { r: 0.2, g: 0.5, b: 1.0, a: 1.0 },
    font_size: 14.0,
    rounding: 4.0,
    spacing: 8.0
  }

  let label = Label { text: "Hello", style: None }
  let constraints = Constraints { min_w: 0.0, min_h: 0.0, max_w: 200.0, max_h: 50.0 }

  # Measure
  let measure = label.measure(constraints, theme)
  assert_true(measure.w > 0.0)
  assert_true(measure.h > 0.0)

  # Layout (set position)
  label.layout(Rect { x: 0.0, y: 0.0, w: measure.w, h: measure.h }, theme)

  # Event
  let ctx = EventCtx { redraw_requested: false, focus_id: None }
  let evt = UiEvent::None
  label.event(evt, ctx, theme)

  # Paint
  let cmds = PaintList::new()
  label.paint(cmds, theme)
  assert_true(true)  # No crash = full pipeline works
end

# --- Clipboard integration ---

@test
def test_clipboard_integration_with_capability() -> Unit
  use std::platform
  # Without actual capability, just verify error types work
  let err = PlatformError::Unsupported("No clipboard backend")
  assert_eq(err.code(), -1)
end
