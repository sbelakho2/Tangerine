# tests/lir_schedule_lane_test.tg — the LIR machine-scheduling lane (the
# bounded list scheduler between the peephole and the register
# allocator).
#
# The engine lives in tg_compiler/lir.tg (the machine scheduling section:
# lir_schedule_function / lir_schedule_function_capture); the ordering
# cost data lives in tg_compiler/target_desc.tg (SchedModel: the
# approximate per-class latencies and the dual-issue flag). The lane rows
# (see lir_schedule_lane_check's doc):
#   S0 the model data is carried by the descriptors;
#   S1 two independent loads: the long-chain load hoists (order changes),
#      chains stay grouped, verify_lir green;
#   S2 a store and a potentially-aliasing load keep their order;
#   S3 statements around a call keep their order (the push barrier and
#      the post-call block), verify_lir green;
#   S4 deterministic output (same input -> same order);
#   S5 semantics preservation on a small computation (evaluated before
#      and after scheduling), with verify_lir green;
#   S6 the opt-level gate (O0/O1 unchanged + "schedule-skipped"; O2
#      records "scheduled").
#
# Run with the repo root as the working directory:
#   tg test tests/lir_schedule_lane_test.tg

use std::test::assert

use tg_compiler::lir::{lir_schedule_lane_check}

@test
def test_lir_schedule_lane() -> Unit
  let rows = lir_schedule_lane_check()
  assert(rows.len() == 0, "lir schedule lane mismatches: " + rows.join("; "))
end
