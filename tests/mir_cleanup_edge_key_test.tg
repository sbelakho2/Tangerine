# The lowering CleanupEdge cache key must be TOTAL over CfgEdgeKind: the
# cache replaces a predicate that compares BOTH kind and source, so distinct
# kinds at the same source may never collide.  (A wildcard key previously
# collapsed True/False/Backedge/Propagate onto "?:<source>".)
use std::core::{Option, Result, Unit, Bool, Int}
use std::test::assert
use tg_compiler::mir::mir_cleanup_edge_key
use tg_compiler::resource_check::CfgEdgeKind

def key_for(kind: CfgEdgeKind, source: Int) -> String
  mir_cleanup_edge_key(kind, source)
end

@test
def test_every_edge_kind_has_a_distinct_key_at_one_source() -> Unit
  let source = 4242
  let kinds = [
    CfgEdgeKind::Normal,
    CfgEdgeKind::True,
    CfgEdgeKind::False,
    CfgEdgeKind::Break,
    CfgEdgeKind::Continue,
    CfgEdgeKind::Return,
    CfgEdgeKind::Backedge,
    CfgEdgeKind::GuardElse,
    CfgEdgeKind::Propagate
  ]
  var i = 0
  while i < kinds.len() do
    var j = i + 1
    while j < kinds.len() do
      assert(key_for(kinds[i], source) != key_for(kinds[j], source),
        "CfgEdgeKind keys collide at the same source: " + key_for(kinds[i], source) + " / " + key_for(kinds[j], source))
      j = j + 1
    end
    i = i + 1
  end
end

@test
def test_key_preserves_source() -> Unit
  assert(key_for(CfgEdgeKind::Propagate, 7) != key_for(CfgEdgeKind::Propagate, 8),
    "the source must remain part of the key")
end
