# tests/semantic_edit_test.tg — audit item 53 (the semantic edit protocol),
# audit item 54 (typed holes) and third-audit item 30 (the source rewrite
# engine) end-to-end lanes.
#
# The protocol/constraint model itself lives in tg_compiler/semantic_edit.tg
# and tg_compiler/types.tg; these tests drive the self-checking lane
# helpers:
#   semantic_edit_lane_check — resolve_edit over constructed index/snapshot
#     fixtures (Rename target + affected callers, ambiguous bare names,
#     ChangeContract target + the REAL snapshot apply with its §31 delta,
#     ReplaceCall/InsertStatement targets, FillHole target resolution, the
#     canonical hole-key round-trip, and the snapshot-level apply for the
#     edits whose real application is the source engine).
#   typed_hole_lane_check — parser + checker end to end: `???` in hole mode
#     checks with constraints (expected type resolved) and records the
#     TypedExprKind::Hole node; in non-hole mode the checker rejects it
#     naming the hole; apply_fill_hole replaces the recorded typed node.
#   semantic_source_edit_lane_check — third-audit item 30 and fourth-audit
#     P0-13/P0-14/P0-15: Rename / ReplaceCall / InsertStatement /
#     ChangeSignature apply on the parsed AST through RESOLVER IDENTITY
#     (registration keys / call targets, never spelling), render through
#     the canonical formatter, re-validate (parse/resolve/type/access/
#     ownership), compute the ACTUAL reachable delta and reject an edit
#     whose delta exceeds the plan (UnexpectedDelta). The lane carries the
#     shadowed same-name rename (two modules + a nested local binder), the
#     ReplaceCall with a same-named unrelated function present, the HIR-
#     anchored insert and the desugared for-loop MIR-origin ambiguity; the
#     fail-closed cases return PreconditionFailed / AmbiguousSource.
#
# All helpers return mismatch rows (empty = the whole lane verifies).
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_edit_test.tg

use std::test::assert

use tg_compiler::semantic_edit::{
  semantic_edit_lane_check, typed_hole_lane_check, semantic_source_edit_lane_check
}

@test
def test_semantic_edit_resolve_and_apply_lane() -> Unit
  let rows = semantic_edit_lane_check()
  assert(rows.len() == 0, "semantic edit lane mismatches: " + rows.join("; "))
end

@test
def test_typed_hole_front_end_lane() -> Unit
  let rows = typed_hole_lane_check()
  assert(rows.len() == 0, "typed hole lane mismatches: " + rows.join("; "))
end

@test
def test_semantic_source_edit_engine_lane() -> Unit
  let rows = semantic_source_edit_lane_check()
  assert(rows.len() == 0, "semantic source edit lane mismatches: " + rows.join("; "))
end
