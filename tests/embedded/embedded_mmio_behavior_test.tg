## The embedded surface behavioral suite — the volatile/MMIO contract
## (the Register abstraction over host memory), the bitfield helpers, the
## allocator-free collections (ArrayVec / RingBuffer) and the atomicity
## availability report — all host-testable without hardware.

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::embedded::*
use std::test::*

@test
def test_register_read_write() -> Unit
  var scratch: u32 = 0
  let reg = unsafe { Register[u32, ReadWriteMode].from_address(RawAddress::from_uint(&mut scratch as UInt)) }
  reg.write(0xDEADBEEF)
  let v = reg.read()
  if v != 0xDEADBEEF then
    panic("MMIO register read-back failed")
  end
  if scratch != 0xDEADBEEF then
    panic("MMIO register write did not reach the backing memory")
  end
end

@test
def test_volatile_read_write_bits() -> Unit
  var scratch: u32 = 0
  let reg = unsafe { Register[u32, ReadWriteMode].from_address(RawAddress::from_uint(&mut scratch as UInt)) }
  volatile_set_bits(&mut scratch as PtrMut[u32], 0xF0)
  if scratch != 0xF0 then
    panic("volatile_set_bits failed")
  end
  volatile_clear_bits(&mut scratch as PtrMut[u32], 0x30)
  if scratch != 0xC0 then
    panic("volatile_clear_bits failed")
  end
  volatile_toggle_bits(&mut scratch as PtrMut[u32], 0xC0)
  if scratch != 0x00 then
    panic("volatile_toggle_bits failed")
  end
  let _ = reg.read()
end

@test
def test_bitfield_extract_insert() -> Unit
  let field = Bitfield::new(8, 4)
  let value: u32 = 0x0000AB00
  let extracted = field.extract(value)
  if extracted != 0xA then
    panic("bitfield extract failed: got " + extracted.to_string())
  end
  let inserted = field.insert(0x000000FF, 0x5)
  if inserted != 0x000005FF then
    panic("bitfield insert failed")
  end
end

@test
def test_arrayvec_capacity() -> Unit
  var v = ArrayVec[Int, 4].new()
  if !v.is_empty() then
    panic("new ArrayVec must be empty")
  end
  match v.push(10)
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("ArrayVec push failed")
  end
  match v.push(20)
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("ArrayVec push failed")
  end
  match v.push(30)
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("ArrayVec push failed")
  end
  match v.push(40)
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("ArrayVec push failed")
  end
  if !v.is_full() then
    panic("ArrayVec must be full after four pushes")
  end
  match v.push(50)
  when Result::Ok(_) then panic("ArrayVec accepted an overflow push")
  when Result::Err(value) then
    if value != 50 then
      panic("ArrayVec overflow must return the rejected value")
    end
  end
  match v.pop()
  when Option::Some(x) then
    if x != 40 then panic("ArrayVec pop order failed") end
  when Option::None then panic("ArrayVec pop failed")
  end
end

@test
def test_ringbuffer_roundtrip() -> Unit
  var rb = RingBuffer[u8, 3].new()
  match rb.push(1u8)
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("ring push failed")
  end
  match rb.push(2u8)
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("ring push failed")
  end
  match rb.push(3u8)
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("ring push failed")
  end
  if !rb.is_full() then
    panic("ring must be full")
  end
  match rb.pop()
  when Option::Some(x) then
    if x != 1u8 then panic("ring pop order failed") end
  when Option::None then panic("ring pop failed")
  end
  match rb.push(4u8)
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("ring push after pop failed")
  end
  match rb.pop()
  when Option::Some(x) then
    if x != 2u8 then panic("ring wrap-around failed") end
  when Option::None then panic("ring pop failed")
  end
  match rb.pop()
  when Option::Some(x) then
    if x != 3u8 then panic("ring pop order failed") end
  when Option::None then panic("ring pop failed")
  end
  match rb.pop()
  when Option::Some(x) then
    if x != 4u8 then panic("ring pop order failed") end
  when Option::None then panic("ring pop failed")
  end
end

@test
def test_target_atomicity_availability() -> Unit
  ## On the host (aarch64/x86_64) the max atomic width is 64.
  let width = target_max_atomic_width()
  if width != 64u32 then
    panic("host max atomic width must be 64, got " + width.to_string())
  end
end

@test
def test_interrupt_vector_table() -> Unit
  let handlers = ["timer_isr", "uart_isr"]
  let table = interrupt_vector_table("_reset_handler", &handlers)
  if table[0].handler != "_reset_handler" then
    panic("vector slot 0 must be the reset handler")
  end
  if table[1].handler != "timer_isr" then
    panic("vector slot 1 must be the first @interrupt handler")
  end
  if table[2].handler != "uart_isr" then
    panic("vector slot 2 must be the second @interrupt handler")
  end
end
