## The embedded bare-metal program (the mandate's embedded-targets row):
## the reset/startup contract (std::embedded's `_reset_handler` — the
## .bss zeroing, the .data copy, the user `main` call), the @interrupt
## handlers (the vector table), the link_section placements and the
## abort-only panic contract.
##
## The embedded route (--target thumbv7em-none-eabihf / ...) compiles
## this program to the bare-metal ELF image whose entry is
## `_reset_handler` and emits the target spec JSON, the linker script and
## the startup artifact next to it.

@no_std

use std::core::{Unit, Bool, Int, UInt, panic}
use std::embedded::{volatile_write32, volatile_read32, link_section, interrupt, PanicStrategy}

## The user main: called by the reset handler after the .bss/.data
## initialization. The embedded contract is never-returning.
def main() -> !
  ## The MMIO smoke: the scratch register write/read-back.
  var scratch: u32 = 0
  volatile_write32(0xE0000000, 0xCAFEBABE)
  scratch = volatile_read32(0xE0000000)
  loop { }
end

## An interrupt handler (the vector table slot 1).
@interrupt
def timer_isr() -> Unit
  loop { }
end

## A second interrupt handler (the vector table slot 2).
@interrupt
def uart_isr() -> Unit
  loop { }
end

@link_section(".text.reset")
def _reset_vector() -> Unit
  ()
end
