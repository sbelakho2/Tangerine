# tests/atomic_litmus_cas_pub_test.tg — CAS publication litmus.
#
# Publication through a compare_exchange (release-store of the flag,
# acquire-CAS on the reader), run over ITERATIONS independent slots:
#   Thread 1: data[i] = 42 (Relaxed);  flag[i] = 1 (Release)
#   Thread 2: exp = 1;
#             ok[i] = CAS(flag[i], exp -> 2, Acquire, Relaxed);
#             if ok[i] then r[i] = data[i] (Relaxed) else r[i] = 0
# A CAS that OBSERVES the published value 1 (and succeeds) is an
# acquire-read of the flag, so it synchronizes-with the release-store:
# the payload must be visible. The forbidden outcome is
# ok[i] == 1 && r[i] != 42.

use std::core
use std::atomic::{AtomicInt, Ordering}
use std::thread::{spawn}

extern def _tg_mem_alloc(size: UInt) -> Ptr[u8]
extern def _tg_mem_free(ptr: Ptr[u8], size: UInt) -> Unit

const ITERATIONS: Int = 20000

struct Slot
  v: AtomicInt
end

def cas_writer(data: Ptr[Slot], flag: Ptr[Slot]) -> Int
  var i = 0
  while i < ITERATIONS do
    let dp = data.offset(i)
    dp.as_ref().v.store(42, Ordering::Relaxed)
    let fp = flag.offset(i)
    fp.as_ref().v.store(1, Ordering::Release)
    i = i + 1
  end
  0
end

def cas_reader(data: Ptr[Slot], flag: Ptr[Slot], ok: Ptr[Int], r: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    let fp = flag.offset(i)
    var exp = 1
    let won = fp.as_ref().v.compare_exchange(&mut exp, 2, Ordering::Acquire, Ordering::Relaxed)
    let op = ok.offset(i)
    op.write(if won then 1 else 0 end)
    let dp = data.offset(i)
    let v = if won then dp.as_ref().v.load(Ordering::Relaxed) else 0 end
    let rp = r.offset(i)
    rp.write(v)
    i = i + 1
  end
  0
end

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  let bytes = (ITERATIONS * 8) as UInt
  let db = _tg_mem_alloc(bytes)
  let fb = _tg_mem_alloc(bytes)
  let ob = _tg_mem_alloc(bytes)
  let rb = _tg_mem_alloc(bytes)
  if db.is_null() || fb.is_null() || ob.is_null() || rb.is_null() then
    println("atomic_litmus_cas_pub: allocation failed")
    return 1
  end
  let data = db.cast[Slot]()
  let flag = fb.cast[Slot]()
  let ok = ob.cast[Int]()
  let r = rb.cast[Int]()

  var i = 0
  while i < ITERATIONS do
    data.offset(i).write(Slot { v: AtomicInt::new(0) })
    flag.offset(i).write(Slot { v: AtomicInt::new(0) })
    i = i + 1
  end

  let d1 = data
  let f1 = flag
  let d2 = data
  let f2 = flag
  let o2 = ok
  let r2 = r
  let h0 = spawn(move || cas_writer(d1, f1))
  let h1 = spawn(move || cas_reader(d2, f2, o2, r2))

  match h0.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_cas_pub: writer failed with code " + code.to_string())
      return 10
    end
  when Result::Err(e) then
    println("atomic_litmus_cas_pub: writer join failed: " + e)
    return 11
  end

  match h1.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_cas_pub: reader failed with code " + code.to_string())
      return 12
    end
  when Result::Err(e) then
    println("atomic_litmus_cas_pub: reader join failed: " + e)
    return 13
  end

  # Forbidden: the acquire-CAS published the flag but the payload read
  # came back stale.
  var forbidden = 0
  var published = 0
  i = 0
  while i < ITERATIONS do
    let o = ok.offset(i).read()
    if o == 1 then
      published = published + 1
      let v = r.offset(i).read()
      if v != 42 then
        forbidden = forbidden + 1
      end
    end
    i = i + 1
  end

  _tg_mem_free(db, bytes)
  _tg_mem_free(fb, bytes)
  _tg_mem_free(ob, bytes)
  _tg_mem_free(rb, bytes)

  if forbidden != 0 then
    println("atomic_litmus_cas_pub: forbidden stale payload observed " + forbidden.to_string() + " times of " + published.to_string() + " publications")
    return 2
  end
  # The vacuous-pass guard (the statistical bound): a run where the
  # reader's CAS never succeeded (it read the flag before any
  # release-store) observed zero publications — the acquire-CAS edge
  # was never exercised and the run must fail.
  if published == 0 then
    println("atomic_litmus_cas_pub: vacuous run — the CAS never published over " + ITERATIONS.to_string() + " slots (the reader never saw the writer)")
    return 3
  end
  0
end
