# tests/allocator_threaded_test.tg — Multi-threaded allocator stress.
#
# Worker threads churn the SAME size classes through _tg_mem_alloc/
# _tg_mem_free (the runtime allocator's per-class LIFO free lists). The
# per-size-class locks (_tg_alloc_lock/_tg_alloc_unlock — one byte per
# class in _tg_alloc_locks) serialize the free-list head pop/push, so
# two threads allocating/freeing the same class never race the same
# head slot. After every thread joins, the live-byte counter
# (tg_allocator_outstanding_bytes) must return EXACTLY to its baseline:
# a lost head update (double-pop or lost push) would leak blocks or
# corrupt the counter.

use std::core
use std::thread::{spawn}

extern def _tg_mem_alloc(size: UInt) -> Ptr[u8]
extern def _tg_mem_free(ptr: Ptr[u8], size: UInt) -> Unit
extern def tg_allocator_outstanding_bytes() -> Int

const ITERATIONS: Int = 4000

# Churn the 16-byte AND 64-byte classes: each iteration allocs one
# block of each class, stamps the payload byte, and frees it — the same
# LIFO head is raced by every thread.
def churn(seed: Int, iterations: Int) -> Int
  mut i = 0
  while i < iterations do
    let p = _tg_mem_alloc(64 as UInt)
    if p.is_null() then
      return 1
    end
    p.write((seed + i) as u8)
    _tg_mem_free(p, 64 as UInt)

    let q = _tg_mem_alloc(16 as UInt)
    if q.is_null() then
      return 2
    end
    q.write((seed + i) as u8)
    _tg_mem_free(q, 16 as UInt)

    i = i + 1
  end
  0
end

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  let before = tg_allocator_outstanding_bytes()

  # Spawn every thread first (they run concurrently), then join each.
  let h0 = spawn(move || churn(0, ITERATIONS))
  let h1 = spawn(move || churn(1, ITERATIONS))
  let h2 = spawn(move || churn(2, ITERATIONS))
  let h3 = spawn(move || churn(3, ITERATIONS))

  match h0.join()
  when Result::Ok(code) then
    if code != 0 then
      println("allocator_threaded: worker 0 failed with code " + code.to_string())
      return 10
    end
  when Result::Err(e) then
    println("allocator_threaded: join 0 failed: " + e)
    return 11
  end

  match h1.join()
  when Result::Ok(code) then
    if code != 0 then
      println("allocator_threaded: worker 1 failed with code " + code.to_string())
      return 12
    end
  when Result::Err(e) then
    println("allocator_threaded: join 1 failed: " + e)
    return 13
  end

  match h2.join()
  when Result::Ok(code) then
    if code != 0 then
      println("allocator_threaded: worker 2 failed with code " + code.to_string())
      return 14
    end
  when Result::Err(e) then
    println("allocator_threaded: join 2 failed: " + e)
    return 15
  end

  match h3.join()
  when Result::Ok(code) then
    if code != 0 then
      println("allocator_threaded: worker 3 failed with code " + code.to_string())
      return 16
    end
  when Result::Err(e) then
    println("allocator_threaded: join 3 failed: " + e)
    return 17
  end

  # The per-class locks must have kept the free-list heads and the
  # outstanding counter consistent: every alloc is paired with a free,
  # so the counter returns exactly to the baseline.
  let after = tg_allocator_outstanding_bytes()
  if after != before then
    println("allocator_threaded: outstanding leak: before=" + before.to_string() + " after=" + after.to_string())
    return 1
  end

  0
end
