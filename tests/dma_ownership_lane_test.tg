# tests/dma_ownership_lane_test.tg — audit item 16 (next tier): the DMA
# ownership semantic domain.
#
# The engine lives in tg_compiler/resource_check.tg (the DMA ownership
# domain section): the per-place DmaState lattice
# (NotPinned / PinnedRead / PinnedWrite / PinnedReadWrite / Returns), the
# canonical std::embedded dma_* op table (module-qualified resolved
# identity) and the ONE transition rule apply_dma_call commits. The lane
# rows (dma_ownership_lane_check) exercise the pure decisions: op-name
# recognition, the pin/await/unpin transition matrix and the conservative
# flow join.
#
# The snapshot/query side is covered by the semantic_query explain lane
# (explain_lane_check's E4 rows) and the semantic_snapshot parse lane
# (the dma-roundtrip row); this test pins the checker-side lattice.
#
# Run with the repo root as the working directory:
#   tg test tests/dma_ownership_lane_test.tg

use std::test::assert

use tg_compiler::{dma_ownership_lane_check}

@test
def test_dma_ownership_lane() -> Unit
  let rows = dma_ownership_lane_check()
  assert(rows.len() == 0, "DMA ownership lane mismatches: " + rows.join("; "))
end
