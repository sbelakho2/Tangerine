# tests/semantic_rationale_test.tg — Tier-4 end-to-end lanes: the
# compiler-grounded persistent rationale history and the dynamic
# semantic-tool discovery surface of tg_compiler/semantic_rationale.tg.
#
# The module lanes live in the compiler module itself:
#   rationale_lane_check — R1-R5: the five grounded source constructors
#     over the TYPED fields (RationaleKind / RationaleSubject /
#     RationaleEvidence / RationaleDependency), add + digest idempotency
#     and determinism, the order-independent history digest, the typed
#     subject query, the v2 save/load round-trip (legacy v1 reading) and
#     the snapshot-relative state (Valid / Stale / Invalidated).
#   semantic_tools_lane_check — T1-T3: the deterministic sorted enumeration,
#     the §39 registry coverage (62 names), the audited 80-tool count, the
#     named ops' flags (mir.dominators requires_mir, coverage.affected
#     requires_coverage, symbol_get requires nothing, the retained-store
#     ops require the store) and the filter views.
# This suite drives those lanes and adds the public-API round trip (store
# add -> save -> load -> typed subject query + state) and the discovery
# surface's tool_for lookup.
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_rationale_test.tg

use std::collections::{Vec}
use std::test::*

use tg_compiler::ids::{StableDigest}
use tg_compiler::semantic_model::{SemanticSnapshot, StableTargetId}
use tg_compiler::semantic_rationale::{
  RationaleRecord, RationaleKind, rationale_store_new, rationale_store_add,
  rationale_store_save, rationale_store_load, rationale_store_len,
  rationale_for_subject, rationale_subject_of_decl_key, rationale_subject_of_text,
  rationale_dependency, rationale_stale, rationale_state_of, rationale_state_word,
  semantic_tools, tool_for,
  rationale_lane_check, semantic_tools_lane_check,
  semantic_rationale_lane_check
}

def rationale_test_target() -> StableTargetId
  StableTargetId {
    triple: "test-none".to_string(),
    arch: "test".to_string(),
    cpu: "test".to_string(),
    pointer_width: 64,
    endian: "little".to_string(),
    abi: "sysv".to_string(),
    float_abi: "hard".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def rationale_test_snapshot() -> SemanticSnapshot
  SemanticSnapshot {
    revision: StableDigest { hi: 0, lo: 0 },
    compiler_version: "test".to_string(),
    target: rationale_test_target(),
    public_api_hash: StableDigest { hi: 0, lo: 0 },
    abi_hash: StableDigest { hi: 0, lo: 0 },
    unsafe_hash: StableDigest { hi: 0, lo: 0 }
  }
end

def rationale_test_record(origin_revision: String, subject: String) -> RationaleRecord
  let dep = rationale_dependency("symbol".to_string(), subject.clone())
  RationaleRecord {
    origin_revision: origin_revision,
    kind: RationaleKind::Budget,
    subject: rationale_subject_of_text(subject),
    decision: "budget-verified".to_string(),
    reason: "no violations".to_string(),
    evidence: Vec::new(),
    supporting_dependency_hashes: Vec::from([dep])
  }
end

@test
def test_rationale_lane() -> Unit
  let rows = rationale_lane_check()
  assert(rows.len() == 0, "rationale lane mismatches: " + rows.join("; "))
end

@test
def test_semantic_tools_lane() -> Unit
  let rows = semantic_tools_lane_check()
  assert(rows.len() == 0, "semantic tools lane mismatches: " + rows.join("; "))
end

@test
def test_semantic_rationale_aggregate_lane() -> Unit
  let rows = semantic_rationale_lane_check()
  assert(rows.len() == 0, "semantic rationale lane mismatches: " + rows.join("; "))
end

@test
def test_rationale_store_round_trip_api() -> Unit
  var store = rationale_store_new()
  let r1 = rationale_test_record("rev-a".to_string(), "m::f#fn()->unit".to_string())
  let r2 = rationale_test_record("rev-b".to_string(), "m::f#fn()->unit".to_string())
  let d1 = rationale_store_add(&mut store, r1.clone())
  let d2 = rationale_store_add(&mut store, r2.clone())
  assert(d1.hi != d2.hi || d1.lo != d2.lo, "distinct records need distinct digests")
  let text = rationale_store_save(store.clone())
  let loaded = rationale_store_load(text.clone())
  assert(rationale_store_len(loaded.clone()) == 2, "load must restore both records")
  assert(rationale_store_save(loaded.clone()) == text, "save(load(text)) must be the text")
  let found = rationale_for_subject(loaded.clone(),
    rationale_subject_of_decl_key("m::f#fn()->unit".to_string()), rationale_test_snapshot())
  assert(found.len() == 2, "subject query must find both records")
  assert(found[0].record.origin_revision == "rev-a" && found[1].record.origin_revision == "rev-b",
    "subject query order")
  assert(found[0].record.supporting_dependency_hashes.len() == 1,
    "the typed dependency rows must round-trip")
  # The state is snapshot-relative: the subject is absent from the empty
  # test snapshot, so the query reports Invalidated.
  assert(rationale_state_word(found[0].state.clone()) == "invalidated",
    "an absent subject must report invalidated")
  assert(rationale_stale(loaded.clone(), found[0].record.clone(), rationale_test_snapshot()),
    "an invalidated record is stale")
  let state = rationale_state_of(loaded.clone(), found[0].record.clone(), rationale_test_snapshot())
  assert(rationale_state_word(state) == "invalidated", "rationale_state_of must agree with the query")
end

@test
def test_semantic_tools_discovery_api() -> Unit
  let tools = semantic_tools()
  assert(tools.len() == 80, "the audited tool count")
  var saw_mir_dominators = false
  var saw_coverage = false
  for t in tools do
    if t.name == "mir.dominators" then
      saw_mir_dominators = t.requires_mir
    end
    if t.name == "coverage.affected" then
      saw_coverage = t.requires_coverage
    end
  end
  assert(saw_mir_dominators, "mir.dominators must require MIR")
  assert(saw_coverage, "coverage.affected must require coverage")
  match tool_for("symbol_get".to_string())
  when Option::Some(t) then
    assert(!t.requires_mir && !t.requires_coverage && !t.requires_store,
      "symbol_get requires nothing")
  when Option::None then
    assert(false, "symbol_get must be discoverable")
  end
end
