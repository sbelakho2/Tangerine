# tests/semantic_rationale_test.tg — Tier-4 end-to-end lanes: the
# compiler-grounded persistent rationale history and the dynamic
# semantic-tool discovery surface of tg_compiler/semantic_rationale.tg.
#
# The module lanes live in the compiler module itself:
#   rationale_lane_check — R1-R5: the five grounded source constructors
#     over the TYPED fields (RationaleKind / RationaleSubject /
#     RationaleEvidence / RationaleDependency), add + digest idempotency
#     and determinism, the order-independent history digest, the typed
#     subject query, the v2 save/load round-trip (legacy v1 reading) and
#     the snapshot-relative state (Valid / Stale / Invalidated).
#   semantic_tools_lane_check — T1-T5: the deterministic sorted enumeration,
#     the §39 registry schema coverage (64 names after service.describe +
#     edit.apply_verified), the item-4 typed-schema count (82 = 64 registry
#     + 18 net supplement), the named ops' typed artifact flags
#     (mir.dominators requires_mir, coverage.affected requires_coverage,
#     symbol_get requires nothing, the retained-store ops require the store),
#     the filter views, the schema well-formedness and the service.describe
#     bootstrap list.
# This suite drives those lanes and adds the public-API round trip (store
# add -> save -> load -> typed subject query + state), the discovery
# surface's tool_for lookup, the service.describe bootstrap answer and the
# row-text -> typed request round trip of the mir_slice / MIR-graph ops.
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_rationale_test.tg

use std::collections::{Vec}
use std::test::*

use tg_compiler::ids::{StableDigest}
use tg_compiler::semantic_model::{SemanticSnapshot, StableTargetId}
use tg_compiler::semantic_rationale::{
  RationaleRecord, RationaleKind, rationale_store_new, rationale_store_add,
  rationale_store_save, rationale_store_load, rationale_store_len,
  rationale_for_subject, rationale_subject_of_decl_key, rationale_subject_of_text,
  rationale_dependency, rationale_stale, rationale_state_of, rationale_state_word,
  semantic_tools, tool_for,
  rationale_lane_check, semantic_tools_lane_check,
  semantic_rationale_lane_check
}
# (audit item 4) the service.describe bootstrap + the typed request round
# trip the suite drives directly.
use tg_compiler::semantic_server::{
  SEMANTIC_PROTOCOL_VERSION, SemanticRequest, new_compiler_session,
  session_handle_request, server_operations, service_describe_schemas
}
use tg_compiler::semantic_query::{
  mir_slice, mir_slice_request_of_text, mir_slice_request_text,
  query_mir_slice_typed, mir_graph_request_of_text, mir_graph_query_typed
}
use tg_compiler::semantic_slice::{MirSliceKind}

def rationale_test_target() -> StableTargetId
  StableTargetId {
    triple: "test-none".to_string(),
    arch: "test".to_string(),
    cpu: "test".to_string(),
    pointer_width: 64,
    endian: "little".to_string(),
    abi: "sysv".to_string(),
    float_abi: "hard".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def rationale_test_snapshot() -> SemanticSnapshot
  SemanticSnapshot {
    revision: StableDigest { hi: 0, lo: 0 },
    compiler_version: "test".to_string(),
    target: rationale_test_target(),
    public_api_hash: StableDigest { hi: 0, lo: 0 },
    abi_hash: StableDigest { hi: 0, lo: 0 },
    unsafe_hash: StableDigest { hi: 0, lo: 0 }
  }
end

def rationale_test_record(origin_revision: String, subject: String) -> RationaleRecord
  let dep = rationale_dependency("symbol".to_string(), subject.clone())
  RationaleRecord {
    origin_revision: origin_revision,
    kind: RationaleKind::Budget,
    subject: rationale_subject_of_text(subject),
    decision: "budget-verified".to_string(),
    reason: "no violations".to_string(),
    evidence: Vec::new(),
    supporting_dependency_hashes: Vec::from([dep])
  }
end

@test
def test_rationale_lane() -> Unit
  let rows = rationale_lane_check()
  assert(rows.len() == 0, "rationale lane mismatches: " + rows.join("; "))
end

@test
def test_semantic_tools_lane() -> Unit
  let rows = semantic_tools_lane_check()
  assert(rows.len() == 0, "semantic tools lane mismatches: " + rows.join("; "))
end

@test
def test_semantic_rationale_aggregate_lane() -> Unit
  let rows = semantic_rationale_lane_check()
  assert(rows.len() == 0, "semantic rationale lane mismatches: " + rows.join("; "))
end

@test
def test_rationale_store_round_trip_api() -> Unit
  var store = rationale_store_new()
  let r1 = rationale_test_record("rev-a".to_string(), "m::f#fn()->unit".to_string())
  let r2 = rationale_test_record("rev-b".to_string(), "m::f#fn()->unit".to_string())
  let d1 = rationale_store_add(&mut store, r1.clone())
  let d2 = rationale_store_add(&mut store, r2.clone())
  assert(d1.hi != d2.hi || d1.lo != d2.lo, "distinct records need distinct digests")
  let text = rationale_store_save(store.clone())
  let loaded = rationale_store_load(text.clone())
  assert(rationale_store_len(loaded.clone()) == 2, "load must restore both records")
  assert(rationale_store_save(loaded.clone()) == text, "save(load(text)) must be the text")
  let found = rationale_for_subject(loaded.clone(),
    rationale_subject_of_decl_key("m::f#fn()->unit".to_string()), rationale_test_snapshot())
  assert(found.len() == 2, "subject query must find both records")
  assert(found[0].record.origin_revision == "rev-a" && found[1].record.origin_revision == "rev-b",
    "subject query order")
  assert(found[0].record.supporting_dependency_hashes.len() == 1,
    "the typed dependency rows must round-trip")
  # The state is snapshot-relative: the subject is absent from the empty
  # test snapshot, so the query reports Invalidated.
  assert(rationale_state_word(found[0].state.clone()) == "invalidated",
    "an absent subject must report invalidated")
  assert(rationale_stale(loaded.clone(), found[0].record.clone(), rationale_test_snapshot()),
    "an invalidated record is stale")
  let state = rationale_state_of(loaded.clone(), found[0].record.clone(), rationale_test_snapshot())
  assert(rationale_state_word(state) == "invalidated", "rationale_state_of must agree with the query")
end

@test
def test_semantic_tools_discovery_api() -> Unit
  let tools = semantic_tools()
  # (audit item 4) 82 = 64 registry schemas (62 pre-item-4 ops +
  # service.describe + edit.apply_verified) + 18 net supplement rows (19
  # names, mir.block deduped by the registry). The pre-item-4 count was 80.
  assert(tools.len() == 82, "the audited typed-schema count")
  var saw_mir_dominators = false
  var saw_coverage = false
  for t in tools do
    if t.name == "mir.dominators" then
      saw_mir_dominators = t.required_artifacts.mir_program
    end
    if t.name == "coverage.affected" then
      saw_coverage = t.required_artifacts.coverage_rows
    end
  end
  assert(saw_mir_dominators, "mir.dominators must require MIR")
  assert(saw_coverage, "coverage.affected must require coverage")
  match tool_for("symbol_get".to_string())
  when Option::Some(t) then
    assert(!t.required_artifacts.mir_program && !t.required_artifacts.coverage_rows &&
      !t.required_artifacts.diagnostic_store && !t.required_artifacts.rationale_store,
      "symbol_get requires nothing")
  when Option::None then
    assert(false, "symbol_get must be discoverable")
  end
end

@test
def test_service_describe_bootstrap() -> Unit
  # (audit item 4a) service.describe returns ONE typed schema per registry
  # operation, in registry (dense operation id) order, itself included.
  let schemas = service_describe_schemas()
  let registry = server_operations()
  assert(schemas.len() == registry.len(), "one schema per registry op")
  var saw_self = false
  var i = 0
  while i < schemas.len() do
    assert(schemas[i].name == registry[i].name,
      "registry order at " + i.to_string() + ": " + schemas[i].name.clone())
    if schemas[i].name == "service.describe" then
      saw_self = true
    end
    i = i + 1
  end
  assert(saw_self, "service.describe must describe itself")
  # The v1 dispatch answers the same schema list as canonical render rows.
  let session = new_compiler_session(rationale_test_snapshot())
  let resp = session_handle_request(&session, SemanticRequest {
    protocol_version: SEMANTIC_PROTOCOL_VERSION,
    request_id: 1,
    operation: "service.describe".to_string(),
    payload: "".to_string()
  })
  assert(resp.ok, "service.describe must answer ok")
  assert(resp.kind == "service.describe", "service.describe kind")
  assert(resp.keys.len() == registry.len(), "one rendered schema row per registry op")
  assert(resp.keys[0].starts_with("tool=callers;"), "the first registry op renders")
end

@test
def test_typed_request_round_trip() -> Unit
  # (audit item 4c) A previously row-text request parses ONCE into the typed
  # §33 record and renders back byte-identically; the typed entry and the
  # text boundary answer identically (no program rides either).
  let text = "backward|f|f#B0#S0".to_string()
  match mir_slice_request_of_text(text.clone())
  when Option::None then
    assert(false, "the row-text slice request must parse")
  when Option::Some(request) then
    assert(request.kind.clone() == MirSliceKind::BackwardDataflow, "slice kind")
    assert(request.function_key == "f", "slice function key")
    assert(request.anchor == "f#B0#S0", "slice anchor")
    assert(mir_slice_request_text(request.clone()) == text, "slice render round trip")
    let typed = query_mir_slice_typed(request, Option::None)
    let boundary = mir_slice(text.clone(), Option::None)
    assert(typed.kind == "mir_slice_unavailable", "typed slice kind")
    assert(boundary.kind == typed.kind, "the boundary and typed answers agree")
  end
  # The MIR-graph boundary parses into the typed record; the typed node is
  # the stable statement id (never re-split).
  match mir_graph_request_of_text("mir.path".to_string(), "f|f#B0#S0".to_string())
  when Option::None then
    assert(false, "the row-text graph request must parse")
  when Option::Some(request) then
    assert(request.function_key == "f", "graph function key")
    match request.node.clone()
    when Option::Some(node) then
      assert(node.stable_key == "f#B0#S0", "graph node key")
    when Option::None then
      assert(false, "the graph node must be typed")
    end
    let typed = mir_graph_query_typed("mir.path".to_string(), request, Option::None)
    assert(typed.kind == "mir.path_unavailable", "typed graph kind")
  end
end
