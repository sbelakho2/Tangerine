# tests/semantic_rationale_test.tg — Tier-4 end-to-end lanes: the
# compiler-grounded persistent rationale history and the dynamic
# semantic-tool discovery surface of tg_compiler/semantic_rationale.tg.
#
# The module lanes live in the compiler module itself:
#   rationale_lane_check — R1-R4: the five grounded source constructors
#     (optimization / diagnostic / delta / budget / equivalence), add +
#     digest idempotency and determinism, the order-independent history
#     digest, the subject query and the total save/load text round-trip
#     (separators, newlines and empty evidence rows included).
#   semantic_tools_lane_check — T1-T3: the deterministic sorted enumeration,
#     the §39 registry coverage (59 names), the audited 77-tool count, the
#     named ops' flags (mir.dominators requires_mir, coverage.affected
#     requires_coverage, symbol_get requires nothing, the retained-store
#     ops require the store) and the filter views.
# This suite drives those lanes and adds the public-API round trip (store
# add -> save -> load -> subject query) and the discovery surface's
# tool_for lookup.
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_rationale_test.tg

use std::collections::{Vec}
use std::test::*

use tg_compiler::semantic_rationale::{
  RationaleRecord, rationale_store_new, rationale_store_add,
  rationale_store_save, rationale_store_load, rationale_store_len,
  rationale_for_subject, semantic_tools, tool_for,
  rationale_lane_check, semantic_tools_lane_check,
  semantic_rationale_lane_check
}

def rationale_test_record(revision: String, subject: String) -> RationaleRecord
  RationaleRecord {
    revision: revision,
    kind: "budget".to_string(),
    subject: subject,
    decision: "budget-verified".to_string(),
    reason: "no violations".to_string(),
    evidence: Vec::new()
  }
end

@test
def test_rationale_lane() -> Unit
  let rows = rationale_lane_check()
  assert(rows.len() == 0, "rationale lane mismatches: " + rows.join("; "))
end

@test
def test_semantic_tools_lane() -> Unit
  let rows = semantic_tools_lane_check()
  assert(rows.len() == 0, "semantic tools lane mismatches: " + rows.join("; "))
end

@test
def test_semantic_rationale_aggregate_lane() -> Unit
  let rows = semantic_rationale_lane_check()
  assert(rows.len() == 0, "semantic rationale lane mismatches: " + rows.join("; "))
end

@test
def test_rationale_store_round_trip_api() -> Unit
  var store = rationale_store_new()
  let r1 = rationale_test_record("rev-a".to_string(), "m::f#fn()->unit".to_string())
  let r2 = rationale_test_record("rev-b".to_string(), "m::f#fn()->unit".to_string())
  let d1 = rationale_store_add(&mut store, r1.clone())
  let d2 = rationale_store_add(&mut store, r2.clone())
  assert(d1.hi != d2.hi || d1.lo != d2.lo, "distinct records need distinct digests")
  let text = rationale_store_save(store.clone())
  let loaded = rationale_store_load(text.clone())
  assert(rationale_store_len(loaded.clone()) == 2, "load must restore both records")
  assert(rationale_store_save(loaded.clone()) == text, "save(load(text)) must be the text")
  let found = rationale_for_subject(loaded.clone(), "m::f#fn()->unit".to_string())
  assert(found.len() == 2, "subject query must find both records")
  assert(found[0].revision == "rev-a" && found[1].revision == "rev-b", "subject query order")
end

@test
def test_semantic_tools_discovery_api() -> Unit
  let tools = semantic_tools()
  assert(tools.len() == 77, "the audited tool count")
  var saw_mir_dominators = false
  var saw_coverage = false
  for t in tools do
    if t.name == "mir.dominators" then
      saw_mir_dominators = t.requires_mir
    end
    if t.name == "coverage.affected" then
      saw_coverage = t.requires_coverage
    end
  end
  assert(saw_mir_dominators, "mir.dominators must require MIR")
  assert(saw_coverage, "coverage.affected must require coverage")
  match tool_for("symbol_get".to_string())
  when Option::Some(t) then
    assert(!t.requires_mir && !t.requires_coverage && !t.requires_store,
      "symbol_get requires nothing")
  when Option::None then
    assert(false, "symbol_get must be discoverable")
  end
end
