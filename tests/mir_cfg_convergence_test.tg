# The definitely-consumed dataflow must converge on an empty cyclic CFG.
# The previous dense rewrite used OUT.len() == 0 as an "uninitialized"
# sentinel, so empty loop-carried sets never converged.
use std::core::{Bool, Unit}
use std::test::assert
use tg_compiler::mir::mir_cfg_convergence_selftest

@test
def test_empty_two_block_cycle_converges() -> Unit
  assert(mir_cfg_convergence_selftest(), "empty cyclic CFG did not converge to empty consumed sets")
end
