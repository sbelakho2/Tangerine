## The no_std NEGATIVE canary: a program that violates the core-only
## surface (it imports std::collections) must FAIL the no_std compile.
## The lane compiles this file with --no-std and requires a nonzero exit
## with the no_std surface diagnostic.

@no_std

use std::core::{Unit, Bool, Int, UInt}
use std::collections::Vec

def _start() -> !
  var v: Vec[Int] = Vec::new()
  v.push(1)
  let _ = v.len()
  loop { }
end
