# tests/gui_setters_test.tg — the GUI setter honesty suite (the
# reviewer's item 24).
#
# The contract under test: EVERY setter's Ok means the change is stored
# and the corresponding getter observes it — there are no no-op setters
# in std::gui anymore. Behavior the widget type does not support
# returns Err(GuiError::Unsupported) — never a false Ok.
#
# Run with: tg run tests/gui_setters_test.tg

use std::test::*
use std::core::{Option, Result, String, Unit, Bool, Int, Float}
use std::gui::{create_application, WidgetType, GuiError, ButtonStyle, TextAlignment}

# ─── Text field: placeholder / password / multiline / text ─────────

@test
def test_gui_text_field_placeholder_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let tf = assert_ok(app.create_text_field(Option::None, "hint".to_string()))
  let wid = tf.base.id
  assert_eq(assert_ok(app.get_text_field_placeholder(wid)), "hint")
  assert_ok(app.set_text_field_placeholder(wid, "new hint".to_string()))
  assert_eq(assert_ok(app.get_text_field_placeholder(wid)), "new hint")
end

@test
def test_gui_text_field_password_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let tf = assert_ok(app.create_text_field(Option::None, "".to_string()))
  let wid = tf.base.id
  assert_false(assert_ok(app.is_text_field_password(wid)))
  assert_ok(app.set_text_field_password(wid, true))
  assert_true(assert_ok(app.is_text_field_password(wid)))
end

@test
def test_gui_text_field_multiline_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let tf = assert_ok(app.create_text_field(Option::None, "".to_string()))
  let wid = tf.base.id
  assert_false(assert_ok(app.is_text_field_multiline(wid)))
  assert_ok(app.set_text_field_multiline(wid, true))
