@test
def test_gui_text_field_text_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let tf = assert_ok(app.create_text_field(Option::None, "".to_string()))
  let wid = tf.base.id
  assert_eq(assert_ok(app.get_text_field_text(wid)), "")
  assert_ok(app.set_text_field_text(wid, "hello".to_string()))
