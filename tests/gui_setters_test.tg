# ─── Button / label ────────────────────────────────────────────────

@test
def test_gui_button_style_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let btn = assert_ok(app.create_button(Option::None, "go".to_string()))
  let wid = btn.base.id
  assert_ok(app.set_button_style(wid, ButtonStyle::Primary))
  let style = assert_ok(app.get_button_style(wid))
  match style
  when ButtonStyle::Primary => ()
  else => assert(false, "the getter must observe the stored style")
  end
end

@test
def test_gui_label_alignment_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let label = assert_ok(app.create_label(Option::None, "hi".to_string()))
  let wid = label.base.id
  assert_ok(app.set_label_alignment(wid, TextAlignment::Center))
  let align = assert_ok(app.get_label_alignment(wid))
  match align
  when TextAlignment::Center => ()
  else => assert(false, "the getter must observe the stored alignment")
  end
end

# ─── Checkbox ──────────────────────────────────────────────────────

@test
def test_gui_checkbox_checked_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let cb = assert_ok(app.create_checkbox(Option::None, "opt".to_string(), false))
  let wid = cb.base.id
  assert_false(assert_ok(app.is_checkbox_checked(wid)))
  assert_ok(app.set_checkbox_checked(wid, true))
  assert_true(assert_ok(app.is_checkbox_checked(wid)))
end

# ─── Slider ────────────────────────────────────────────────────────

@test
def test_gui_slider_value_range_step_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let slider = assert_ok(app.create_slider(Option::None, 0.0, 10.0, 3.0))
  let wid = slider.base.id
  assert_approx_eq(assert_ok(app.get_slider_value(wid)), 3.0, 1e-9)
  assert_ok(app.set_slider_value(wid, 7.5))
  assert_approx_eq(assert_ok(app.get_slider_value(wid)), 7.5, 1e-9)

  assert_ok(app.set_slider_range(wid, -5.0, 5.0))
  let (min_v, max_v) = assert_ok(app.get_slider_range(wid))
  assert_approx_eq(min_v, -5.0, 1e-9)
  assert_approx_eq(max_v, 5.0, 1e-9)

  assert_ok(app.set_slider_step(wid, 0.5))
  assert_approx_eq(assert_ok(app.get_slider_step(wid)), 0.5, 1e-9)
end

# ─── Progress bar ──────────────────────────────────────────────────

@test
def test_gui_progress_bar_value_range_indeterminate_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let pb = assert_ok(app.create_progress_bar(Option::None))
  let wid = pb.base.id
  assert_approx_eq(assert_ok(app.get_progress_bar_value(wid)), 0.0, 1e-9)
  assert_ok(app.set_progress_bar_value(wid, 42.0))
  assert_approx_eq(assert_ok(app.get_progress_bar_value(wid)), 42.0, 1e-9)

  assert_ok(app.set_progress_bar_range(wid, 0.0, 200.0))
  let (min_v, max_v) = assert_ok(app.get_progress_bar_range(wid))
  assert_approx_eq(min_v, 0.0, 1e-9)
  assert_approx_eq(max_v, 200.0, 1e-9)

  assert_false(assert_ok(app.is_progress_bar_indeterminate(wid)))
  assert_ok(app.set_progress_bar_indeterminate(wid, true))
  assert_true(assert_ok(app.is_progress_bar_indeterminate(wid)))
end

# ─── List view ─────────────────────────────────────────────────────

@test
def test_gui_list_items_and_selection_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let lv = assert_ok(app.create_list_view(Option::None))
  let wid = lv.base.id
  assert_ok(app.add_list_item(wid, "a".to_string()))
  assert_ok(app.add_list_item(wid, "b".to_string()))
  let items = assert_ok(app.get_list_items(wid))
  assert_eq(items.len(), 2)
  assert_eq(items[0], "a")
  assert_eq(items[1], "b")

  assert_ok(app.set_list_selected_index(wid, 1))
  assert_eq(assert_ok(app.get_list_selected_index(wid)), 1)

  assert_ok(app.remove_list_item(wid, 0))
  let items2 = assert_ok(app.get_list_items(wid))
  assert_eq(items2.len(), 1)
  assert_eq(items2[0], "b")

  assert_ok(app.clear_list_items(wid))
  assert_eq(assert_ok(app.get_list_items(wid)).len(), 0)
end

# ─── Combo box ─────────────────────────────────────────────────────

@test
def test_gui_combo_items_and_selection_roundtrip() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let cb = assert_ok(app.create_combo_box(Option::None))
  let wid = cb.base.id
  assert_ok(app.add_combo_item(wid, "x".to_string()))
  assert_ok(app.add_combo_item(wid, "y".to_string()))
  let items = assert_ok(app.get_combo_items(wid))
  assert_eq(items.len(), 2)

  assert_ok(app.set_combo_selected_index(wid, 0))
  assert_eq(assert_ok(app.get_combo_selected_index(wid)), 0)

  assert_ok(app.remove_combo_item(wid, 1))
  assert_ok(app.clear_combo_items(wid))
  assert_eq(assert_ok(app.get_combo_items(wid)).len(), 0)
end

# ─── Menu bar ──────────────────────────────────────────────────────

@test
def test_gui_menu_bar_stores_and_validates() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  # The window creation depends on a native backend (Err(NoBackend) when
  # the host has none — e.g. GTK on a headless Linux runner); the menu
  # contract is tested whenever a window can be created.
  let window = app.create_window("w".to_string(), 100.0, 100.0)
  match window
  when Result::Ok(win) =>
    let menu = assert_ok(app.create_menu())
    assert_ok(app.set_menu_bar(win.id, menu.id))
    let missing = app.set_menu_bar(win.id, 9999)
    match missing
    when Result::Err(e) =>
      match e
      when GuiError::InvalidMenu => ()
      else => assert(false, "a missing menu must be InvalidMenu")
      end
    when Result::Ok(_) => assert(false, "a missing menu must NOT return Ok")
    end
  when Result::Err(_) => ()  # NoBackend host: the menu contract is not reachable
  end
end

# ─── Type mismatches and invalid ids are never false Ok ────────────

@test
def test_gui_type_mismatch_returns_unsupported() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let tf = assert_ok(app.create_text_field(Option::None, "".to_string()))
  let wid = tf.base.id
  let slider_err = app.set_slider_value(wid, 1.0)
  match slider_err
  when Result::Err(e) =>
    match e
    when GuiError::Unsupported => ()
    else => assert(false, "a slider setter on a text field must be Unsupported")
    end
  when Result::Ok(_) => assert(false, "a slider setter on a text field must NOT return Ok")
  end

  let list_err = app.add_list_item(wid, "x".to_string())
  match list_err
  when Result::Err(e) =>
    match e
    when GuiError::Unsupported => ()
    else => assert(false, "a list setter on a text field must be Unsupported")
    end
  when Result::Ok(_) => assert(false, "a list setter on a text field must NOT return Ok")
  end
end

@test
def test_gui_invalid_widget_id_returns_invalid_widget() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let missing = app.set_slider_value(424242, 1.0)
  match missing
  when Result::Err(e) =>
    match e
    when GuiError::InvalidWidget => ()
    else => assert(false, "an unknown widget id must be InvalidWidget")
    end
  when Result::Ok(_) => assert(false, "an unknown widget id must NOT return Ok")
  end
end

@test
def test_gui_out_of_range_index_returns_invalid_index() -> Unit
  let mut app = assert_ok(create_application("gui-test".to_string()))
  let lv = assert_ok(app.create_list_view(Option::None))
  let wid = lv.base.id
  assert_ok(app.add_list_item(wid, "a".to_string()))
  let bad = app.remove_list_item(wid, 5)
  match bad
  when Result::Err(e) =>
    match e
    when GuiError::InvalidIndex => ()
    else => assert(false, "an out-of-range index must be InvalidIndex")
    end
  when Result::Ok(_) => assert(false, "an out-of-range index must NOT return Ok")
  end
  let bad_sel = app.set_list_selected_index(wid, 7)
  match bad_sel
  when Result::Err(e) =>
    match e
    when GuiError::InvalidIndex => ()
    else => assert(false, "an out-of-range selection must be InvalidIndex")
    end
  when Result::Ok(_) => assert(false, "an out-of-range selection must NOT return Ok")
  end
end
