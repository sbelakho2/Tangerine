# tests/mir_slp_lane_test.tg — audit item 34: the bounded SLP
# vectorization slice (the first auto-vectorization pass).
#
# The pass lives in tg_compiler/mir.tg (slp_vectorize, wired into
# optimize_mir_impl at opt_level >= 2 after the SROA/range and
# bounds-elimination batches, before move simplification and final DCE).
# It rewrites straight-line same-op groups of fixed-array element
# accesses into explicit __intrinsic_simd_* load/op/store chains through
# the EXISTING explicit SIMD surface — no new machine layer.
#
# The self-checking lane rows (mir_slp_lane_check) build minimal
# MirFunctions BY HAND and assert:
#   V1 the 4-lane i32 add straight line is vectorized (three address
#      temps + the load/load/add/store call chain), with one
#      "slp-vectorized" decision row and the scalar run gone;
#   V2 the f32 strict case uses the f32x4 intrinsic and never touches
#      MirFunction.fp_fast (same-op groups only, no reordering);
#   V3 the shifted-window alias case stays scalar with a rejected row
#      naming the aliased window;
#   V4 the odd count (3 lanes of a 4-lane class) stays scalar with the
#      divisibility reject row;
#   V5 the mixed-op run stays scalar with the mixed-class reject row;
#   V6 the TARGET-CAPABILITY GATE (audit item 34 residual): the same
#      candidate run with MirProgram.slp_vector_facility = false (a
#      desc without a vector facility) is NOT vectorized, emits no
#      __intrinsic_simd_* call, and records exactly one
#      "slp-vectorize-skipped" row. V1..V5 stamp the flag true.
# The second test pins the stamp seam itself (the desc -> flag mapping
# the routes rely on):
#   C1 the aarch64 (AdvSIMD) and x86-64 (SSE2) descs — through BOTH
#      stamp spellings (arch and desc) — enable the facility;
#   C2 the M-profile and RISC-V descs (scalar FPUs) leave it FALSE:
#      with such a desc the pass does not vectorize (V6);
#   C3 a fresh MirProgram defaults to FALSE (the fail-closed default
#      every route that forgets to stamp keeps).
#
# Run with the repo root as the working directory:
#   tg test tests/mir_slp_lane_test.tg

use std::core::{Option, panic}
use std::test::assert

use tg_compiler::asm::Arch
use tg_compiler::target_desc::{aarch64_desc, x86_64_desc, target_desc_of_triple}
use tg_compiler::codegen::{stamp_slp_vector_facility, stamp_slp_vector_facility_desc}
use tg_compiler::mir::{mir_slp_lane_check, mir_origin_lane_program, MirFunction}

@test
def test_mir_slp_lane() -> Unit
  let rows = mir_slp_lane_check()
  assert(rows.len() == 0, "mir SLP lane mismatches: " + rows.join("; "))
end

@test
def test_slp_target_capability_stamp() -> Unit
  let empty_fns: Vec[MirFunction] = Vec::new()
  # C3: the fail-closed default.
  let fresh = mir_origin_lane_program(empty_fns.clone())
  assert(!fresh.slp_vector_facility, "a fresh MirProgram must default slp_vector_facility = false")
  # C1: the vector-capable targets, through both stamp spellings.
  var p_arch_a = mir_origin_lane_program(empty_fns.clone())
  stamp_slp_vector_facility(&mut p_arch_a, Arch::AArch64)
  assert(p_arch_a.slp_vector_facility, "the aarch64 arch stamp must enable the SLP facility")
  var p_arch_x = mir_origin_lane_program(empty_fns.clone())
  stamp_slp_vector_facility(&mut p_arch_x, Arch::X86_64)
  assert(p_arch_x.slp_vector_facility, "the x86_64 arch stamp must enable the SLP facility")
  var p_desc_a = mir_origin_lane_program(empty_fns.clone())
  stamp_slp_vector_facility_desc(&mut p_desc_a, aarch64_desc())
  assert(p_desc_a.slp_vector_facility, "the aarch64 desc stamp must enable the SLP facility")
  var p_desc_x = mir_origin_lane_program(empty_fns.clone())
  stamp_slp_vector_facility_desc(&mut p_desc_x, x86_64_desc())
  assert(p_desc_x.slp_vector_facility, "the x86_64 desc stamp must enable the SLP facility")
  # C2: the vector-less descs, resolved through the ONE triple table.
  match target_desc_of_triple("thumbv7m-none-eabi".to_string())
  when Option::Some(d) then
    var p_m = mir_origin_lane_program(empty_fns.clone())
    stamp_slp_vector_facility_desc(&mut p_m, d)
    assert(!p_m.slp_vector_facility, "the M-profile desc must NOT enable the SLP facility")
  when Option::None then panic("thumbv7m-none-eabi must resolve through target_desc_of_triple")
  end
  match target_desc_of_triple("riscv64gc-unknown-none-elf".to_string())
  when Option::Some(d) then
    var p_r = mir_origin_lane_program(empty_fns.clone())
    stamp_slp_vector_facility_desc(&mut p_r, d)
    assert(!p_r.slp_vector_facility, "the RISC-V desc must NOT enable the SLP facility")
  when Option::None then panic("riscv64gc-unknown-none-elf must resolve through target_desc_of_triple")
  end
end
