# tests/doc_gen_consumption_test.tg — the doc generator's compiler
# consumption (the reviewer's item 25).
#
# The source-text PARSING fork in std::doc_gen is GONE: std::doc_gen is
# the data model + renderers, and tg_compiler/docgen.tg fills the model
# from the compiler's OWN AST (tokenize + parse + the parsed Program).
# This suite pins (a) the assembly + render path and (b) the compiler
# extraction feeding the same renderers.
#
# Run with: tg run tests/doc_gen_consumption_test.tg

use std::test::*
use std::core::{Option, Result, String, Unit, Bool, Int, UInt}
use std::doc_gen::{DocModule, DocItem, DocKind, DocParam, DocConfig, OutputFormat,
                   generate_docs, generate_json, extract_examples}
use tg_compiler::docgen::{extract_module}

# ─── (a) The model assembly + render path (no source text involved) ─

@test
def test_docgen_renders_assembled_module_html() -> Unit
  var doc_module = DocModule::new("demo".to_string(), Option::Some("The demo module".to_string()))
  let item = DocItem::new("add".to_string(), DocKind::Function,
    "def add(a: Int, b: Int) -> Int".to_string(),
    Option::Some("Adds two integers".to_string()),
    Vec::from([DocParam::new("a".to_string(), Option::Some("Int".to_string()))]),
    Option::Some("Int".to_string()),
    "std/demo.tg".to_string(), 7)
  doc_module.add_item(item)

  let html = generate_docs(&doc_module, DocConfig::default())
  assert(html.contains("add"), "the rendered HTML must contain the item name")
  assert(html.contains("Adds two integers"), "the rendered HTML must contain the doc string")
  assert(html.contains("Defined in std/demo.tg:7"), "the rendered HTML must carry the source anchor")
end

@test
def test_docgen_renders_assembled_module_markdown_and_json() -> Unit
  var doc_module = DocModule::new("demo".to_string(), Option::None)
  let item = DocItem::new("run".to_string(), DocKind::Function,
    "def run() -> Unit".to_string(), Option::None,
    Vec::new(), Option::None, "std/demo.tg".to_string(), 3)
  doc_module.add_item(item)

  let md = generate_docs(&doc_module, DocConfig {
    output_dir: "docs".to_string(),
    format: OutputFormat::Markdown,
    include_private: false,
    include_examples: true,
    include_source_links: true,
    base_url: Option::None,
    theme: "light".to_string(),
    generate_index: true,
    generate_search: true
  })
  assert(md.contains("## `run`"), "the rendered markdown must contain the item heading")

  let json = generate_json(&doc_module)
  assert(json.contains("\"name\": \"demo\""), "the JSON must carry the doc_module name")
  assert(json.contains("\"kind\": \"function\""), "the JSON must carry the item kind")
end

@test
def test_docgen_doc_comment_helpers() -> Unit
  let doc = "@example\n```\nadd(1, 2)\n```\n@deprecated use sub instead\n@since 1.2.0".to_string()
  let examples = extract_examples(doc.clone())
  assert_true(examples.len() == 1)
  assert(examples[0].code.contains("add(1, 2)"), "the example body must be extracted")
end

# ─── (b) The compiler extraction feeds the same renderers ──────────

@test
def test_docgen_consumes_compiler_ast() -> Unit
  let source = "# The demo\n\ndef add(a: Int, b: Int) -> Int\n  a + b\nend\n\nstruct Point\n  x: Int\nend\n".to_string()
  let doc_module = assert_ok(extract_module("std/demo.tg".to_string(), source, false))
  assert_eq(doc_module.name, "demo")
  assert_true(doc_module.items.len() == 2)

  let html = generate_docs(&doc_module, DocConfig::default())
  assert(html.contains("add"), "the AST-extracted function must render")
  assert(html.contains("Point"), "the AST-extracted struct must render")
end

@test
def test_docgen_extraction_reports_parse_errors() -> Unit
  let source = "end\n".to_string()
  let res = extract_module("std/broken.tg".to_string(), source, false)
  assert(res.is_err(), "a source that fails the compiler's parser must be an Err")
end
