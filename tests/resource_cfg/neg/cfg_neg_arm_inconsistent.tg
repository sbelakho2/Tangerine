# Negative shape: arm-inconsistent resource state at the match/if join —
# one arm moves the resource into a fresh local, the other consumes it,
# and the resource is used after the join (the divergence is
# maybe-live-unresolved). The oracle (shape neg_arm_inconsistent) predicts
# REJECT; the runner verifies `tg check` rejects this file.
use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def main() -> Int
  let r = R { a: 1 }
  if r.a > 0 then
    let r2 = r
    r2.a
  else
    consume_r(r)
  end
  r.a
end
