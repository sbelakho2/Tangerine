# Negative shape: deinit-after-consume (an explicit drop after the value
# was transferred to a sink). The oracle (shape neg_deinit_after_consume)
# predicts REJECT; the runner verifies `tg check` rejects this file.
use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def main() -> Int
  let r = R { a: 1 }
  consume_r(r)
  drop(r)
  0
end
