# Negative shape: consumed-twice (two sinks of the same local).
# The oracle (shape neg_double_consume) predicts REJECT; the runner
# verifies `tg check` rejects this file.
use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def main() -> Int
  let r = R { a: 1 }
  consume_r(r)
  consume_r(r)
  0
end
