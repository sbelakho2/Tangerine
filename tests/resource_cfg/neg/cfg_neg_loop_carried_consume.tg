# Negative shape: loop-carried consumption — an entering local is consumed
# inside the loop body; the back-edge state diverges from the head state
# (the second iteration would read a consumed resource). The oracle (shape
# neg_loop_carried_consume) predicts REJECT; the runner verifies `tg check`
# rejects this file.
use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def main() -> Int
  let r = R { a: 1 }
  loop
    consume_r(r)
  end
  0
end
