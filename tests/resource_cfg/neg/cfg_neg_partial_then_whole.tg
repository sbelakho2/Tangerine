# Negative shape: partial-then-whole — a field is consumed (partial move)
# and the whole value is then dropped/read. The oracle (shape
# neg_partial_then_whole) predicts REJECT; the runner verifies `tg check`
# rejects this file.
use std::core

resource Probe
  id: Int
end

resource Pair
  a: Probe
  b: Probe
end

def consume_probe(sink r: Probe) -> Unit
end

def main() -> Int
  let p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  consume_probe(p.a)
  drop(p)
  0
end
