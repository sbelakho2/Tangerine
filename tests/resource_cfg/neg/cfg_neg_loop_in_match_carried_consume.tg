# Negative shape: loop-in-match carried consumption — the entering local
# is sunk on ONE arm of a match inside the loop body; the other arm
# leaves it live (maybe-live-unresolved at the match join) and the
# back-edge state diverges from the head state (the next iteration would
# read a consumed resource). The oracle (shape
# neg_loop_in_match_carried_consume) predicts REJECT; the runner verifies
# `tg check` rejects this file.
use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def main() -> Int
  let r = R { a: 1 }
  loop
    let b = 1
    match b
    when 1 then
      consume_r(r)
    when _ then
      ()
    end
    break
  end
  0
end
