# Negative shape: defer-after-consume — a defer for a local that was
# already transferred to a sink; at the edge the defer would finalize the
# local a second time. The oracle (shape neg_defer_after_consume) predicts
# REJECT; the runner verifies `tg check` rejects this file.
use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def main() -> Int
  let r = R { a: 1 }
  consume_r(r)
  defer
    drop(r)
  end
  0
end
