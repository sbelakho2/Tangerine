# Negative shape: maybe-live-unresolved at the join — one arm consumes,
# the other does not, and the value is used after the join.
# The oracle (shape neg_maybe_live_join) predicts REJECT; the runner
# verifies `tg check` rejects this file.
use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def maybe_consume(c: Bool) -> R
  let r = R { a: 1 }
  if c then
    consume_r(r)
  else
    ()
  end
  return r
end

def main() -> Int
  maybe_consume(true)
  0
end
