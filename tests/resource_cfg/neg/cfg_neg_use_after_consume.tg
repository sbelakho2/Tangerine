# Negative shape: use-after-consume (the oracle's consumed-twice class).
# The oracle (cfg_oracle_test.tg, shape neg_use_after_consume) predicts
# REJECT; the runner (run_cfg_oracle.sh) verifies `tg check` rejects this
# file.
use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def main() -> Int
  let r = R { a: 1 }
  consume_r(r)
  r.a
end
