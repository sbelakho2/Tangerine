# tests/proof_patch_test.tg — third-audit items 29 (the first-class evidence
# deltas: SourceDelta / DropPlanDelta / ObligationResults / AllocationDelta /
# CoverageDelta / PerformanceDelta / EquivalenceResult) and 32 (the
# refactor-equivalence gate) end-to-end lane, plus the fourth-audit items
# P0-16 (typed verification statuses), P0-17 (the typed drop-plan diff) and
# P0-18 (delta_status / the missing-old-snapshot refusal) lanes.
#
# The model itself lives in tg_compiler/proof_patch.tg (ProofCarryingPatch,
# PatchEvidenceBundle, SourceDelta, AllocationDelta, VerificationStatus,
# DeltaStatus, proof_patch_of_delta / proof_patch_between /
# proof_patch_of_status, proof_patch_lane_check,
# drop_plan_delta_lane_check, delta_status_lane_check) with the §36 gate in
# tg_compiler/change_budget.tg (EquivalenceRequirement,
# budget_verify_with_equivalence, budget_refactor_default /
# budget_refactor_with_level) and the gating ladder in
# tg_compiler/equivalence.tg (equivalence_level_rank,
# equivalence_result_satisfies). This test drives the self-checking lane
# rows:
#   proof_patch_lane_check — P1 the claim-nothing patch defaults every new
#     evidence surface empty and every status Unavailable; P2 the
#     delta-derived alloc-class row and the typed drop-plan row (the
#     ownership-only delta emits no drop-plan row); P3 the full evidence
#     bundle is carried verbatim and the caller allocation rows append; P4
#     the refactor budget reports the missing equivalence result and a
#     proven result clears it; P5/P6 TestedNoCounterexample violates under
#     the default proof demand and passes when the budget does not demand a
#     proof; P7 the typed statuses (driver-route post-opt/abi Unavailable,
#     all-verified requires Verified); P8/P9 the missing-old-delta refusal.
#   drop_plan_delta_lane_check — a cleanup moved between CFG branches with
#     an UNCHANGED sink convention reports the drop-plan change (P0-17).
#   delta_status_lane_check — the missing-old-snapshot status is
#     Unavailable, never an empty delta (P0-18).
#
# The helpers return mismatch rows (empty = the whole lane verifies).
#
# Run with the repo root as the working directory:
#   tg test tests/proof_patch_test.tg

use std::test::assert

use tg_compiler::proof_patch::{proof_patch_lane_check}
use tg_compiler::semantic_delta::{drop_plan_delta_lane_check, delta_status_lane_check}

@test
def test_proof_patch_evidence_deltas_and_equivalence_gate_lane() -> Unit
  let rows = proof_patch_lane_check()
  assert(rows.len() == 0, "proof patch lane mismatches: " + rows.join("; "))
end

@test
def test_drop_plan_delta_lane() -> Unit
  let rows = drop_plan_delta_lane_check()
  assert(rows.len() == 0, "drop plan delta lane mismatches: " + rows.join("; "))
end

@test
def test_delta_status_lane() -> Unit
  let rows = delta_status_lane_check()
  assert(rows.len() == 0, "delta status lane mismatches: " + rows.join("; "))
end
