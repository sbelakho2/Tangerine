# tests/coverage_graph_test.tg — third-audit item 34 plus the audit-order
# item 1 closeout and the audit-order item 5 semantic-test-graph rows: the
# §40 coverage ingest + index lane.
#
# The executable rows live in tg_compiler/coverage_graph.tg
# (coverage_graph_lane_check — id grammar, the compile-time coverage table
# over an ORIGIN-STAMPED hand-built MirFunction with typed-keyed point maps,
# the tg.cov.trace.v1 ingest with the typed-keys round trip, the point/
# symbol indexes, TestCoverage records, uncovered_paths over a hand-built
# delta, the availability gate, the origin-less untracked-artifact results,
# the legacy string-only point row AND (audit order item 5) the discovery
# table driving the fn-level index, the runtime-name -> stable-test-key
# binding + trace normalization, the typed targeted verification
# (test_targeted_for_delta: affected tests + uncovered path constraints)
# and the mutation kill mapping with its honest Unavailable case — plus
# (audit order item 5 closeout) the per-suite identifier contract: the
# multi-suite/per-test identifier rows resolve through the discovery
# table and the crash/build markers land in `unmapped` unresolved) and
# tg_compiler/semantic_query.tg (coverage_query_lane_check — the §38
# test.affected / coverage.affected answers over an ingested snapshot plus
# the <op>_unavailable gates).
# Both lanes return one row per mismatch; empty = the lanes verify.
#
# Run with the repo root as the working directory:
#   tg test tests/coverage_graph_test.tg

use std::test::assert

use tg_compiler::coverage_graph::{coverage_graph_lane_check}
use tg_compiler::semantic_query::{coverage_query_lane_check}

@test
def test_coverage_graph_lane() -> Unit
  let rows = coverage_graph_lane_check()
  assert(rows.len() == 0, "coverage graph lane mismatches: " + rows.join("; "))
end

@test
def test_coverage_query_lane() -> Unit
  let rows = coverage_query_lane_check()
  assert(rows.len() == 0, "coverage query lane mismatches: " + rows.join("; "))
end
