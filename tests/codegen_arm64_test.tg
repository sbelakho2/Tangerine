    println("[FAIL] integer_overflow")
  end
  
  if test_empty_function() then
    passed = passed + 1
    println("[PASS] empty_function")
  else
    failed = failed + 1
    println("[FAIL] empty_function")
  end
  
  println("")
  println("ARM64 Codegen Tests: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  
  failed
end

def main() -> Int
  run_arm64_tests()
end