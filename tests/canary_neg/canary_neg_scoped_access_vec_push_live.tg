# Negative scoped-access canary (audit §12 — the container-mutation
# exclusion): while a scoped element access into a Vec is LIVE, mutating
# the parent storage (Vec::push — an inout-self receiver on the accessed
# vector) is rejected: the push may reallocate the buffer and invalidate
# the accessed element's storage.
use std::core
use std::collections

def main() -> Int
  mut v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  with v[0] as let e
    v.push(3)
    if e != 1 then
      return 1
    end
  end
  0
end
