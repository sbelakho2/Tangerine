# Negative conformance canary (e): the impl method's parameter types must
# unify against the instantiated trait signature (E0224).
use std::core

trait ConvParamType
  def m(self: Self, a: Int) -> Int
end

struct ParamTypeImpl
  v: Int
end

impl ConvParamType for ParamTypeImpl
  def m(self: ParamTypeImpl, a: String) -> Int
    0
  end
end

def main() -> Int
  0
end
