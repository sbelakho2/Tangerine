# Negative scoped-access canary (audit §12): an OWNING with-scoped access
# value cannot be STORED INTO A Vec — Vec::push takes its element as a
# sink (takes-ownership) parameter, and a block-bound place access is not
# an owned value.
use std::core
use std::collections

struct Doc
  title: String
  qty: Int
end

def main() -> Int
  mut d = Doc { title: "x" + "", qty: 0 }
  mut v = Vec[String]::new()
  with d.title as let s
    v.push(s)
  end
  0
end
