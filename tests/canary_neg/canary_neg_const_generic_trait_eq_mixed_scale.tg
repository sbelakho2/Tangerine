# Negative canary (§23): a trait impl generic over a const parameter
# (`impl[const SCALE: Int] Eq for Dec64[SCALE]`) instantiates SCALE from
# the RECEIVER's const argument, so the trait method's other-parameter is
# the SAME instance: `.eq` across Dec64[2] and Dec64[4] values is rejected
# (the impl's eq is instantiated at SCALE=2 from the receiver and the
# Dec64[4] argument cannot unify — the canonical const identity Const(4)
# != Const(2)). The same-scale enforcement that keeps Eq sound at one
# instance is the whole point of the const-typed trait impl.
use std::core

struct Dec64[const SCALE: Int]
  unscaled: Int
end

impl[const SCALE: Int] Eq for Dec64[SCALE]
  def eq(self, other: Dec64[SCALE]) -> Bool
    self.unscaled == other.unscaled
  end
end

def run() -> Int
  let a2: Dec64[2] = Dec64 { unscaled: 5 }
  let b4: Dec64[4] = Dec64 { unscaled: 5 }
  if a2.eq(b4) then
    return 1
  end
  0
end

def main() -> Int
  run()
end
