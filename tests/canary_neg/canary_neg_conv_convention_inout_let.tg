# Negative conformance canary (f1): the access conventions must match the
# trait contract EXACTLY — the reviewer's key case: the trait declares
# `inout x: Int`, the impl declares `let x: Int` — rejected (E0225).
use std::core

trait ConvConvention
  def m(inout self: Self, inout x: Int) -> Int
end

struct ConventionImpl
  v: Int
end

impl ConvConvention for ConventionImpl
  def m(inout self: ConventionImpl, x: Int) -> Int
    0
  end
end

def main() -> Int
  0
end
