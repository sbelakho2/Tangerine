# Negative effect-class canary (audit §11): @no_alloc FAILS CLOSED on an
# indirect call through a function-pointer VALUE — the callee's behavior
# is unknowable at the site, so the MIR summary cannot rule allocation
# out (E0232).
def main() -> Int
  0
end

@no_alloc
def call_cb(cb: fn(Int) -> Int) -> Int
  cb(7)
end
