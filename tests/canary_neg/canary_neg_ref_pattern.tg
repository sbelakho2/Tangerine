# Negative canary: a `ref v` pattern binder is a HARD migration error — the
# parser previously consumed `ref` and silently returned the ordinary inner
# pattern (a semantic no-op that manufactures ownership from a shared
# projection: `when Option::Some(ref v) then Option::Some(v)` yields an
# owned T by projection for every T). Tangerine has no first-class
# references; the syntax must be rejected, never erased.
# Expected error: "ref patterns are not supported: Tangerine has no
# first-class references; bind by value or use the access model"
use std::core

struct Box[T]
  v: T
end

def main() -> Int
  let b = Box { v: 42 }
  let x = match b
    when Box(ref v) then v
  end
  x
end
