# Negative canary (§20 const generics, slice 4 — declared range
# constraints): Decimal64's declared scale range is 0..=18, so forming
# the concrete type Decimal64[19] is the compile error — not a later
# method call. The diagnostic names the parameter, its declared range and
# the offending value.
use std::core
use std::math::Decimal64

def run() -> Int
  let bad: Decimal64[19] = Decimal64[19]::from_string("1.0".to_string()).unwrap()
  bad.unscaled()
end

def main() -> Int
  run()
end
