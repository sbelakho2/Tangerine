# Negative canary (§20 slice 2 — SYMBOLIC CONST-EXPRESSION type arguments):
# a const-generic type-argument slot whose expression is NOT a constant is
# rejected with the ONE const-argument diagnostic ("const generic argument
# must be a constant expression"). The symbolic Type::ConstSym form exists
# ONLY for arithmetic over IN-SCOPE const parameters — an unknown name
# (UNKNOWN_CONST), a division by a concrete zero, or a TYPE parameter (a
# type is never a compile-time value) all keep the pre-symbolic diagnostic.
struct P[const A: Int]
  v: Int
end

impl[const A: Int] P[A]
  # UNKNOWN_CONST is neither a module const nor an in-scope parameter.
  def bad_unknown(self: Self) -> P[UNKNOWN_CONST + 1]
    self
  end

  # Division by a concrete zero is never a constant.
  def bad_divzero(self: Self) -> P[A / 0]
    self
  end

  # A type parameter cannot participate in const arithmetic.
  def bad_type_param[T](self: Self) -> P[A + T]
    self
  end
end

def main() -> Int
  0
end
