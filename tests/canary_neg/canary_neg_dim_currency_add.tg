# Negative canary (audit §23 part C): adding Money[USD, 2] + Money[EUR, 2]
# must NOT typecheck — the currency is a phantom type argument, so the
# two amounts are different types and Money[C, SCALE]::add only accepts
# the SAME instance (mirror of the std::math Money shape; canaries
# cannot import std::math).  The rejected argument unification reports
# the Adt-vs-Adt mismatch.
use std::core

struct USD
end

struct EUR
end

struct Money[C, const SCALE: Int]
  unscaled: Int
end

impl[C, const SCALE: Int] Money[C, SCALE]
  def from_minor(minor: Int) -> Money[C, SCALE]
    Money[C, SCALE] { unscaled: minor }
  end

  def add(self, other: Money[C, SCALE]) -> Money[C, SCALE]
    Money[C, SCALE] { unscaled: self.unscaled + other.unscaled }
  end
end

def run() -> Int
  let usd: Money[USD, 2] = Money[USD, 2]::from_minor(100)
  let eur: Money[EUR, 2] = Money[EUR, 2]::from_minor(100)
  usd.add(eur)
  0
end

def main() -> Int
  run()
end
