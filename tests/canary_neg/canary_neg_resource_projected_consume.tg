# Negative canary: consuming a PROJECTED place outside a finalizer is
# rejected until partial-move state exists — the MIR would consume the
# field while semantic state keeps the root live, double-finalizing it.
# Expected error: "cannot consume a projected place"
use std::core

resource Probe
  id: Int
end

resource Pair
  a: Probe
  b: Probe
end

def consume_probe(sink r: Probe) -> Unit
end

def main() -> Int
  let p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  consume_probe(p.a)
  0
end
