# Negative concurrency canary (reviewer item 28 — test a): the thread
# closure capturing a NON-TRANSFERABLE value is rejected. Thread holds the
# execution-context-affine native handle (the std-marked AffineHandle
# inside PthreadT): the transferable walk derives NOT Transferable (no
# explicit opt-in), so the closure cannot move into another execution
# context.
use std::core
use std::thread

def main() -> Int
  let t = thread::current()
  let h = spawn(|| t.id())
  0
end
