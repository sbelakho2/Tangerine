# Negative canary (the reviewer's P0 checker-pair — the generic-T-
# returning-Unit construct): `def f[T](x: T) -> T` whose body returns ()
# is NOT a generic body — the concrete Unit is smuggled under the
# arbitrary T (the exact shape of the old generic JoinHandle[T] whose
# poll produced the ()-result for any T). The checker's current rule
# (tg_compiler/types.tg — the strict Param arm of unify): a generic
# parameter NEVER unifies with a concrete type at the generic definition
# ("each occurrence of T must resolve to the SAME instantiated type,
# decided at the generic call site, never here"), so the tail unification
# of the ()-typed body against Param(T) fails with the type mismatch —
# the checker rejects the Unit-as-arbitrary-T at the generic definition,
# the sound behavior the canary pins.

def f[T](x: T) -> T
  ()
end

def main() -> Int
  let v = f(5)
  0
end
