# Negative conformance canary (b): an impl declaring the SAME method twice
# must be rejected — duplicate trait-impl members (E0221).
use std::core

trait ConvDup
  def dup(self: Self) -> Int
end

struct DupImpl
  v: Int
end

impl ConvDup for DupImpl
  def dup(self: DupImpl) -> Int
    0
  end

  def dup(self: DupImpl) -> Int
    1
  end
end

def main() -> Int
  0
end
