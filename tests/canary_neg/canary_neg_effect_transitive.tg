# Negative effect canary — the TRANSITIVE case: main -> mid -> leaf, the
# effectful leaf declares Io, mid declares it too, main declares NOTHING.
# The per-function computed effect sets close transitively over the
# recorded call graph, so main's missing declaration is reported even
# though it never calls the effectful function directly — the transitive
# checking is the language semantics (the source-text analyzer in
# std::effects is tooling only).
def leaf() -> Int effect Io
  0
end

def mid() -> Int effect Io
  leaf()
end

def main() -> Int
  mid()
end
