# Negative conformance canary (d): the impl method's parameter count must
# be EXACT after the Self / trait-argument substitution (E0223).
use std::core

trait ConvArity
  def m(self: Self, a: Int) -> Int
end

struct ArityImpl
  v: Int
end

impl ConvArity for ArityImpl
  def m(self: ArityImpl, a: Int, b: Int) -> Int
    0
  end
end

def main() -> Int
  0
end
