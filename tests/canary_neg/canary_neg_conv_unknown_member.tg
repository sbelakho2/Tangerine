# Negative conformance canary (c): an impl member that is not a method of
# the declared trait is an unknown member — inherent-extension methods are
# permitted ONLY in inherent impls, never in a trait impl (E0222).
use std::core

trait ConvUnknown
  def known(self: Self) -> Int
end

struct UnknownImpl
  v: Int
end

impl ConvUnknown for UnknownImpl
  def known(self: UnknownImpl) -> Int
    0
  end

  def helper(self: UnknownImpl) -> Int
    1
  end
end

def main() -> Int
  0
end
