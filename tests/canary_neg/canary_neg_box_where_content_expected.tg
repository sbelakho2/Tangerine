# Negative canary: Box[Int] is NOT Int (exact nominal identity) — passing a
# box where its content is expected is a type error. The explicit forms are
# `*b.get()` (raw deref through the box's own pointer) or `b.into_inner()`.
use std::alloc

def take_int(x: Int) -> Int
  x
end

def main() -> Int
  let b = box_new(7)
  take_int(b)
end
