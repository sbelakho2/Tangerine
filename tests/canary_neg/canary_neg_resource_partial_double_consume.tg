# Negative canary: consuming the same field twice (the mandate's canary
# (d)) — the second consume sees the chain's Consumed effective state.
# Expected error: "consumed twice"
use std::core

resource Probe
  id: Int
end

resource Pair
  a: Probe
  b: Probe
end

def consume_probe(sink r: Probe) -> Unit
end

def main() -> Int
  let p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  consume_probe(p.a)
  consume_probe(p.a)
  0
end
