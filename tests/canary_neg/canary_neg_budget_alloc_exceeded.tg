# Negative budget canary: the @budget ALLOCATION metric, EXCEEDED. The
# annotated function declares `alloc: "1"` but its body performs TWO
# intrinsic allocations (the classified builtin-container method calls —
# ArrayPush). The lowering's fail-closed static-exceed check
# (check_budget_static_exceed) counts the MirBudgetConsume("alloc", _)
# statements against the declared limit and rejects the compile with
# "budget exceeded" — the deterministic compile-time surface of the trap
# the runtime would hit on entry (the counter would exceed the limit at
# the second allocation). `tg check` MUST reject this file and the output
# MUST contain the expected substring.
def budgeted() -> Int @budget alloc: "1"
  let v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  0
end

def main() -> Int
  budgeted()
end
