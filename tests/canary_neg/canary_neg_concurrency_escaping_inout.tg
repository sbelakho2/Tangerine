# Negative concurrency canary (reviewer item 35 — test b): the ESCAPING
# INOUT CAPTURE is rejected — a closure that mutates a captured local
# (the lexical inout state) cannot be passed to a thread spawn: the
# inout state cannot cross into another execution context.
use std::core
use std::thread

def main() -> Int
  mut x = 0
  let h = spawn(do |_| x = x + 1 end)
  0
end
