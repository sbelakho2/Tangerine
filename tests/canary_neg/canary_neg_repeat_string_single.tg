# Negative canary (audit item 50(b)): [s; 1] — an OWNING String element in
# a SINGLE-element repeat. The single-slot store of an owning value would
# need an ownership-correct one-element MOVE (source invalidation plus the
# full multi-word image); the MirRepeat fill (one element image per slot,
# a register-sized scalar or a tag word) cannot express that move in this
# slice, so count 1 rejects owning elements exactly like every larger count
# — the Copy-element gate applies uniformly.
# Expected error: array repeat requires Copy elements
use std::core

def main() -> Int
  let s = String::new()
  let a = [s; 1]
  0
end
