# Negative scoped-access canary (audit §12): a with-scoped access value
# cannot be SENT TO ANOTHER THREAD — the spawn closure would capture the
# block-bound access across the execution-context boundary.
use std::core
use std::thread

struct Doc
  title: String
  qty: Int
end

def main() -> Int
  mut d = Doc { title: "x" + "", qty: 0 }
  with d.title as let s
    let h = spawn(do |_| s.len() end)
  end
  0
end
