# Negative effect-class canary (audit item 42): the interrupt-context
# proof is TRANSITIVE — every call edge out of the handler must satisfy
# the restrictions itself (a handler is only as safe as its callees).
# isr_alloc -> alloc_helper, and alloc_helper's Vec::push allocates, so
# the handler's final semantic summary carries the allocation class
# (E0232 naming the handler; the effect_trace rows render the
# `isr_alloc` -> `alloc_helper` evidence path).
def main() -> Int
  0
end

def alloc_helper() -> Int
  let v = Vec[Int]::new()
  v.push(1)
  v.len()
end

@interrupt
def isr_alloc() -> Int
  alloc_helper()
end
