# Negative conformance canary (i): the method generic bounds must satisfy
# the trait contract — the trait declares `m[H: ConvHash]`, the impl
# declares the parameter WITHOUT the bound (E0228).
use std::core

trait ConvHash
end

trait ConvBounds
  def m[H: ConvHash](self: Self) -> Int
end

struct BoundsImpl
  v: Int
end

impl ConvBounds for BoundsImpl
  def m[H](self: BoundsImpl) -> Int
    0
  end
end

def main() -> Int
  0
end
