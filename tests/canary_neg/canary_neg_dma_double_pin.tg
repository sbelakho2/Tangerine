# Negative DMA-ownership canary (audit item 16, next tier): a second
# dma_pin_* on a place that is still DMA-owned is rejected (double pin).
# The buffer's place is pinned-read after the first pin; only dma_await
# (completion) and dma_unpin (release) may close that pin before a new
# pin may open.
use std::core
use std::embedded::{dma_pin_read, dma_pin_write}

def double_pin() -> Int
  var buf: [u8; 16] = [0u8; 16]
  let a = dma_pin_read(buf)
  let b = dma_pin_write(buf)
  a.raw() as Int + b.raw() as Int
end

def main() -> Int
  0
end
