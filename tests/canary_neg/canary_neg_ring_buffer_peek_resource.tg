# Negative canary: RingBuffer[File].peek_front must be REJECTED — peek_front
# is the by-value projected read under `impl[T: Copy] RingBuffer[T]`, and a
# resource element can never be duplicated by a shared read (that would
# create a second owner while the buffer stays live). Method resolution
# consults the inherent impl's bounds, so the candidate is not applicable
# for RingBuffer[File]; resources are extracted with the consuming inout
# APIs (pop_front) only.
# Expected error: "method `peek_front` requires `T: Copy`"
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let mut rb = RingBuffer::new(4)
  rb.push_back(File { fd: 1 })
  let front = rb.peek_front()
  0
end
