# Negative canary: RingBuffer[File].peek_front must be REJECTED — peek_front
# is the by-value projected read under `impl[T: Copy] RingBuffer[T]`, and a
# resource element can never be duplicated by a shared read (that would
# create a second owner while the buffer stays live). Resources are
# extracted with the consuming inout APIs (pop_front) only.
# Expected error: "cannot extract resource element from shared container;
# use an inout/consuming access"
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let mut rb = RingBuffer::new(4)
  rb.push_back(File { fd: 1 })
  let front = rb.peek_front()
  0
end
