# Negative DMA-ownership canary (audit item 16, next tier): a CPU write
# into a place the DMA engine still owns is rejected. dma_pin_read moves
# the buffer's place to pinned-read in the resource checker's DmaState
# lattice; the ordinary store `buf[0] = 7` is concurrent CPU mutation and
# must wait for the sanctioned dma_await (completion) + dma_unpin
# (release) transitions (the diagnostic names them).
use std::core
use std::embedded::{dma_pin_read}

def cpu_write_while_pinned() -> Int
  var buf: [u8; 16] = [0u8; 16]
  let pin = dma_pin_read(buf)
  buf[0] = 7
  pin.raw() as Int
end

def main() -> Int
  0
end
