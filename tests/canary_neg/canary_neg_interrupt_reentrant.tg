# Negative effect-class canary (audit item 42): the interrupt-context
# proof rejects REENTRANCY — a handler that can call back into itself
# through a call path (isr_re -> helper -> isr_re) would nest ISR
# activations and make the handler's stack unbounded (the bounded-stack
# rule: no allocation + no reentrancy keeps the handler frame depth
# static). The E0232 reports the handler with effect_trace rows naming
# the violating cycle.
def main() -> Int
  0
end

def helper() -> Int
  isr_re()
end

@interrupt
def isr_re() -> Int
  helper()
end
