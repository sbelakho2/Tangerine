# Negative scoped-access canary (audit §12 — the conflict matrix): a READ
# access and a MODIFY access on the SAME place cannot be live at once
# (read+modify on one place fails).
use std::core

struct Doc
  title: String
  qty: Int
end

def main() -> Int
  mut d = Doc { title: "x" + "", qty: 0 }
  with d.title as let s
    with d.title as inout t
      t.push('!')
    end
    if s.len() != 1 then
      return 1
    end
  end
  0
end
