# Negative canary: BumpArena must be classified NON-COPY by the
# type-property engine. BumpArena owns its backing through a registered
# `impl Drop`, and a registered Drop excludes a type from the
# structural bit-copy set (tg_compiler/types.tg
# is_named_trivially_copyable) — the same mechanism that makes
# Vec/Box/String non-Copy. The Copy-gated position below proves it:
# SlabPool[BumpArena].get is applicable only when the element type
# satisfies `T: Copy` (impl[T: Copy] SlabPool[T]), and Copy(BumpArena)
# is unsatisfiable — so method resolution must fail with the
# blocked-method diagnostic. If the engine ever classified BumpArena
# Copy (a bit-copied arena would double-free at Drop — field nulling
# in copy A never reaches copy B), this canary would COMPILE and the
# gate fails.
# Expected error: "method `get` requires `T: Copy`"
use std::core
use std::alloc_policy::{SlabPool, BumpArena}

def main() -> Int
  var pool = SlabPool[BumpArena].new(2)
  let _ = pool.get(0)
  0
end
