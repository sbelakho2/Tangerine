# Negative concurrency canary (reviewer item 35 — the raw stack-pointer
# escape): a closure capturing a RAW POINTER (Ptr[Int]) is passed to a
# thread spawn — the Read capture of a raw pointer type must be
# rejected: a stack address must not escape into another execution
# context (the capture would dangle once the defining frame ends).
# This is the ONLY negative pinning the type_is_raw_pointer branch of
# check_async_closure_captures — the other concurrency negatives pin the
# Modify capture (escaping inout) and the non-Shareable aggregate read.
# Expected error: "raw stack-pointer escaping into a task/thread"
use std::core
use std::thread

def main() -> Int
  let p: Ptr[Int] = Ptr::null()
  let h = spawn(|| p)
  0
end
