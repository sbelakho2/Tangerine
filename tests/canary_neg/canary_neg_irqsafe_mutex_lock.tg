# Negative effect-class canary (audit §11): @irq_safe rejects a function
# that takes a Mutex lock — the lock path yields the scheduler
# (sched_yield) while the atomic swap spins, so the transitive summary
# over the lowered program carries the Block class (E0232).
use std::sync::Mutex

@irq_safe
def locked(m: Mutex[Int]) -> Int
  let _g = m.lock()
  0
end

def main() -> Int
  let m = Mutex::new(0)
  locked(m)
  0
end
