# Negative canary: SlabPool[T] must itself be classified NON-COPY by
# the type-property engine. SlabPool releases its init-time allocations
# (slot arena + metadata) through a registered `impl Drop`, and a
# registered Drop excludes a type from the structural bit-copy set
# (tg_compiler/types.tg is_named_trivially_copyable) — the same
# mechanism that makes Vec/Box/String non-Copy. The Copy-gated position
# below proves it: SlabPool[SlabPool[Int]].get is applicable only when
# the element type satisfies `T: Copy` (impl[T: Copy] SlabPool[T]), and
# Copy(SlabPool[Int]) is unsatisfiable — so method resolution must
# fail with the blocked-method diagnostic. If the engine ever
# classified SlabPool Copy (a bit-copied pool would double-free its
# arenas at Drop), this canary would COMPILE and the gate fails.
# Expected error: "method `get` requires `T: Copy`"
use std::core
use std::alloc_policy::{SlabPool}

def main() -> Int
  var pool = SlabPool[SlabPool[Int]].new(2)
  let _ = pool.get(0)
  0
end
