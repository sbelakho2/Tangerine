# Negative canary (§20 slice 3): an OUT-OF-SCOPE runtime VALUE read of a
# const generic parameter still FAILS CLOSED at the checker. An IN-SCOPE
# read (the body of the item that declares the parameter — a function
# body, an impl-method body with the impl's merged parameters) is now a
# per-instance compile-time value (see the positive value canaries); a
# read from a CLOSURE body is still rejected: the closure lowers as its
# own NON-GENERIC synthesized function, which has no per-instance
# substitution for the enclosing item's parameter — its value exists only
# per instantiation of the item that declares it.
use std::core

def capacity_of[T, const N: UInt](x: T) -> UInt
  let read_n = do |_|
    N
  end
  read_n(0)
end

def run() -> Int
  capacity_of(0)
end

def main() -> Int
  run()
end
