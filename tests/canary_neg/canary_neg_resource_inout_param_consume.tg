# Negative canary: a let (read-only) resource parameter must never be
# consumed by a sink operation inside the callee.
# Expected error: cannot consume resource ... let parameter is read-only
use std::core

resource File
  fd: Int
end

def destroy(sink x: File) -> Unit
end

def inspect(x: File) -> Unit
  destroy(x)
end

def main() -> Int
  0
end
