# Negative canary: an INOUT resource parameter is borrowed caller storage —
# it may be modified but never consumed by a sink operation inside the
# callee.
#
# (The by-value `let` parameter of an OWNING type is owned by the callee,
# not read-only: the seed's convention rule lowers a non-Copy owning let
# argument as a place read and binds the callee's parameter as a fresh
# owned local, so consuming it inside the body is accepted — the shape
# `def wrap(message: String) -> Error { Error { message: message } }` in
# std's error constructors, and `destroy(x)` for `x: File`.)
# Expected error: inout parameter may be modified but not consumed
use std::core

resource File
  fd: Int
end

def destroy(sink x: File) -> Unit
end

def inspect(inout x: File) -> Unit
  destroy(x)
end

def main() -> Int
  var f = File { fd: 1 }
  inspect(f)
  0
end
