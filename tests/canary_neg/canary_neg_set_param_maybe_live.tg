# Negative canary: a `set` parameter consumed on ONE branch only is left
# MaybeLive (Consumed on one arm, still Uninitialized on the other) at the
# join — the function exit postcondition requires every set param to be
# EXACTLY Live (entry Uninitialized, exit Live), so the divergence is
# rejected. Expected error: set parameter ... must be exactly Live on
# every return edge.
use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def branch_consumes_set_param(set r: R) -> Int
  let c = true
  if c then
    consume_r(r)
  else
    ()
  end
  0
end

def main() -> Int
  0
end
