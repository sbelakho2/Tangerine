# Negative conformance canary (g): the impl method's return type must
# unify against the instantiated trait signature (E0226).
use std::core

trait ConvReturn
  def m(self: Self) -> Int
end

struct ReturnImpl
  v: Int
end

impl ConvReturn for ReturnImpl
  def m(self: ReturnImpl) -> String
    "wrong"
  end
end

def main() -> Int
  0
end
