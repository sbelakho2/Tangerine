# Negative canary (audit item 1 — the scoped-access determination): a
# window view of a collection cannot be RETURNED out of a with-scoped
# access block. The with-machinery sources a block-bound access from a
# PLACE (`with v[i] as let/inout e` — the zero-copy element access) or
# from the two REGISTERED Map-entry accessors (get_read / get_modify);
# a slice() accessor returning a first-class view struct fits neither
# shape, and the persistent constructors return the OWNING Slice
# (Arc-backed) — an owning non-place value source is rejected by the
# with-site gate, and the bound value can never escape the block
# (returning it is the escape channel gate).
# Expected error: "cannot return the with-scoped access value"
use std::core
use std::collections

def escape_window() -> Slice[Int]
  var v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  v.push(3)
  with copied_slice(v, 0, 2) as let w
    return w
  end
  copied_slice(v, 0, 2)
end

def main() -> Int
  escape_window()
  0
end
