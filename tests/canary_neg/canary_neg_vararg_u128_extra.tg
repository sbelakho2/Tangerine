# Negative canary: a U128 extra argument of a variadic extern call is
# rejected by the type checker (the C default argument promotions admit
# the <= 64-bit integer scalars only — a 128-bit integer crosses the C
# ABI as two GP words / memory, never the vararg extra's one slot).
# Expected error: "variadic extern argument 2 has type `U128`: the
# vararg subset is the C-promotable scalars"
use std::core

extern def vararg_sink(tag: Int, ...) -> Int

def main() -> Int
  let big: U128 = 1
  let r = vararg_sink(0, big)
  0
end
