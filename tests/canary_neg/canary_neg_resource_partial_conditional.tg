# Negative canary: a path-CONDITIONAL partial move (the field consumed on
# one path only) cannot be masked by the unconditional scope-exit cleanup
# — the joined chain state is MaybeLive and the scope boundary rejects it
# (mirroring the root-level rule).
# Expected error: "may be consumed on one path"
use std::core

resource Probe
  id: Int
end

resource Pair
  a: Probe
  b: Probe
end

def consume_probe(sink r: Probe) -> Unit
end

def main() -> Int
  let p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  if p.b.id > 0 then
    consume_probe(p.a)
  end
  0
end
