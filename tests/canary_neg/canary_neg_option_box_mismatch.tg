# Negative canary: Option[Box[Int]] is not Option[Int] — there is no
# reconciliation through the Box wrapper, so the two canonical instances are
# distinct types and the call must be rejected without an explicit
# conversion (e.g. pattern-matching the Box out with into_inner).
use std::core
use std::alloc

def take_opt(x: Option[Int]) -> Int
  match x
  when Option::Some(v) then v
  when Option::None then 0
  end
end

def main() -> Int
  let b: Option[Box[Int]] = Option::Some(box_new(7))
  take_opt(b)
end
