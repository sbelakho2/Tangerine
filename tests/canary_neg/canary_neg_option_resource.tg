# Negative canary: a resource stored in an Option must not be extractable
# twice — Option::unwrap takes `sink self` (a consuming extraction), so
# using the option again afterwards is a use-after-consume of the resource.
# Expected error: resource checker reports use of a consumed resource
use std::core

resource File
  fd: Int
end

def main() -> Int
  let f = Option::Some(File { fd: 1 })
  let g = f.unwrap()
  let h = f.unwrap()
  0
end
