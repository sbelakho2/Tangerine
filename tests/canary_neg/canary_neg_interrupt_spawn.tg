# Negative effect-class canary (audit item 42): @interrupt enforces the
# no-spawn rule of the interrupt context — a handler must never create
# or schedule tasks/threads (may_spawn=false — the Spawn class, the
# interrupt-only fourth class; no attribute spells it, so the
# interrupt-context arm alone forbids it). A call through a
# function-pointer VALUE fails closed — the callee's behavior is
# unknowable at the site, so the summary cannot rule spawning out — and
# the handler summary therefore carries the Spawn class (E0232 naming
# the handler: "@interrupt handler ... may spawn").
def main() -> Int
  0
end

@interrupt
def isr_spawn(schedule: fn(Int) -> Int) -> Int
  schedule(1)
end
