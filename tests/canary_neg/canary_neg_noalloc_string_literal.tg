# Negative effect-class canary (audit §11): @no_alloc rejects a function
# whose body materializes an OWNED String from a string literal. The MIR
# lowering converts the static literal through the string_from_static
# intrinsic at every owned-String demand site (the let-binding's String
# destination), so the transitive semantic summary over the LOWERED
# program sees the implicit compiler-generated heap allocation — the
# blind spot of the old source-syntax scan (a literal expression scans
# as effect-free).
def main() -> Int
  0
end

@no_alloc
def lit() -> String
  let s = "hello"
  s
end
