# Negative canary: higher-order arity mismatch — passing a fn(Int) -> Int
# where fn(Int, String) -> Int is required must be rejected by the type
# checker (function-type unification requires identical arity).
# Expected error: "function arity mismatch: cannot unify 1-parameter and
# 2-parameter function types"
use std::core

def apply(f: fn(Int, String) -> Int, a: Int, b: String) -> Int
  f(a, b)
end

def inc(x: Int) -> Int
  x + 1
end

def main() -> Int
  apply(inc, 1, "x")
  0
end
