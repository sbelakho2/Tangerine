# Negative canary: shared Map.get() must not extract a resource value by
# value (that would duplicate ownership while the map stays live).
# Expected error: "cannot extract resource element from shared container;
# use an inout/consuming access"
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let files = Map[String, File]::new()
  let f = files.get("a")
  0
end
