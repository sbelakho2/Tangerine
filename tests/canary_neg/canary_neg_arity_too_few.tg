# Negative canary: calling a function with too few arguments must be
# rejected by the type checker (exact-arity rule for non-variadic
# callables). Expected error: "wrong number of arguments: expected 2, found 1"
use std::core

def add(a: Int, b: Int) -> Int
  a + b
end

def main() -> Int
  let x = add(1)
  0
end
