# Negative canary (audit item 50(a)): [box_new(7); 2] — an OWNING Box[Int]
# element repeated twice (the Box::new(...) shape of the audit). Box is
# never Copy (a bit-copy would manufacture a second owner of the pointee),
# so the repeat is rejected at the checker's Copy-element gate.
# Expected error: array repeat requires Copy elements
use std::core
use std::alloc

def main() -> Int
  let a = [box_new(7); 2]
  0
end
