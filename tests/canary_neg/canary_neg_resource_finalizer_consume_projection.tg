# Negative canary: a user finalizer must not consume a PROJECTED field of
# its subject — `consume_inner(self.inner)` is a consuming projection that
# would let the compiler-owned structural field cleanup finalize `inner` a
# second time (until partial-drop tracking exists).
# Expected error: "cannot consume resource `self`"
use std::core

resource Inner
  x: Int
end

def consume_inner(sink r: Inner) -> Unit
end

resource Outer
  inner: Inner
  def deinit(sink self: Self) -> Unit
    consume_inner(self.inner)
  end
end

def main() -> Int
  let o = Outer { inner: Inner { x: 1 } }
  0
end
