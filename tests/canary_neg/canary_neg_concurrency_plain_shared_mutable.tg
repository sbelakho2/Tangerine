# Negative concurrency canary (reviewer item 35 — test d): the concurrent
# closure using a PLAIN SHARED MUTABLE VALUE is rejected — a read capture
# of a non-Shareable (plain owned) struct in a thread closure. The shared
# mutable state must go through Arc/Mutex/RwLock/atomics/channels: the
# plain struct is Transferable but NOT Shareable, so the concurrent
# closure may not use it; the Arc[Mutex] wrapping is the accepted form.
use std::core
use std::thread
use std::collections::Vec

struct Counter
  value: Vec[Int]   # owned state — NOT Shareable (Transferable only)
end

def main() -> Int
  let counter = Counter { value: Vec::new() }
  let h = spawn(|| counter.value.len())
  0
end
