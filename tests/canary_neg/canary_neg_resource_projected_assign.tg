# Negative canary: assigning over an OWNING PROJECTED place is rejected
# until exact-place replacement exists (dropping the whole root would
# destroy sibling fields).
# Expected error: "cannot assign over an owning projected place"
use std::core

resource Probe
  id: Int
end

resource Pair
  a: Probe
  b: Probe
end

def main() -> Int
  let mut p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  p.a = Probe { id: 3 }
  0
end
