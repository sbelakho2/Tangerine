# Negative canary: Map::keys/values on a resource-valued map must be
# rejected even with a mutable receiver (copied entry storage duplicates
# resource values; Copyable constraint).
# Expected error: cannot extract resource element from shared container;
# use an inout/consuming access
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let mut m = Map[String, File]::new()
  let ks = m.keys()
  0
end
