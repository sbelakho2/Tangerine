# Negative canary (audit item 50(a)): [String::new(); 2] — an OWNING
# String element repeated twice. Array repeat requires Copy elements (the
# element expression's value is written into every slot, and a String can
# never be bit-copied — the repeat would duplicate the heap buffer), so the
# checker rejects the repeat at the element gate.
# Expected error: array repeat requires Copy elements
use std::core

def main() -> Int
  let a = [String::new(); 2]
  0
end
