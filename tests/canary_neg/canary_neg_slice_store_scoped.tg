# Negative canary (audit item 1 — the scoped-access determination): a
# window view of a collection cannot be STORED — bound into a
# longer-lived aggregate local/field — inside a with-scoped access
# block. Window views over live storage are not first-class values on
# this snapshot (the with-machinery binds places or the registered Map
# accessors only), and the owning persistent Slice is rejected as a with
# source; storing the bound value into an owned holder would move it out
# of the block, which is the storage channel gate.
# Expected error: "cannot bind the with-scoped access value"
use std::core
use std::collections

struct ViewHolder
  view: Slice[Int]
end

def store_window() -> Int
  var v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  v.push(3)
  with copied_slice(v, 0, 2) as let w
    let holder = ViewHolder { view: w }
    if holder.view.len() == 0 then
      return 1
    end
  end
  0
end

def main() -> Int
  store_window()
  0
end
