# Negative scoped-access canary (audit §12): a with-scoped access value
# cannot be CAPTURED into a closure — the bound value must not escape its
# block.
use std::core

struct Doc
  title: String
  qty: Int
end

def run_cb(f: fn() -> Int) -> Int
  f()
end

def main() -> Int
  mut d = Doc { title: "x" + "", qty: 0 }
  with d.title as let s
    let cb = do |_| s.len() end
    run_cb(cb)
  end
  0
end
