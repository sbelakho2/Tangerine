# Negative canary: `m[k]` index extraction of a resource VALUE is a
# shared read that returns the element by value — it would duplicate
# ownership while the map stays live — rejected. The sanctioned
# extraction is the ownership-taking inout operation Map::remove(key)
# (Option[V]) or an inout element binding.
# Expected error: "cannot extract resource element from shared container;
# use an inout/consuming access"
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let mut m = Map[Int, File]::new()
  m.insert(1, File { fd: 1 })
  let f = m[1]
  0
end
