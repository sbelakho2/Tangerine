# Negative canary (§20 slice 2): const-argument RANGE validation against
# the const parameter's DECLARED scalar type — `const N: u8` accepts
# 0..255; the argument 300 is out of range (the literal machinery's
# signedness/bounds decision through the exact decimal bounds).
use std::core

struct Tiny[T, const N: u8]
  _data: [T; N]
end

def run() -> Int
  let bad: Tiny[Int, 300] = Tiny { _data: [1, 2, 3] }
  bad._data[0]
end

def main() -> Int
  run()
end
