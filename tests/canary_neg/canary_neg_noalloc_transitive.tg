# Negative effect-class canary (audit §11): the @no_alloc proof is
# TRANSITIVE over the lowered program — f -> g -> h, and h's Vec.push
# allocates, so f's final semantic summary contains the allocation class
# (E0232, with the evidence chain into h).
def main() -> Int
  0
end

def h() -> Int
  let v = Vec[Int]::new()
  v.push(1)
  v.len()
end

def g() -> Int
  h()
end

@no_alloc
def f() -> Int
  g()
end
