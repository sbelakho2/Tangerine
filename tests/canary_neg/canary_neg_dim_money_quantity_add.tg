# Negative canary (audit §23 part C): adding Money[USD, 2] + Quantity
# must NOT typecheck — money and quantity are different dimensions (an
# Adt-vs-Adt mismatch), so no `add` signature accepts the other
# dimension without a conversion (mirror of the std::math
# Money/Quantity shapes; canaries cannot import std::math).
use std::core

struct USD
end

struct Share
end

struct Money[C, const SCALE: Int]
  unscaled: Int
end

impl[C, const SCALE: Int] Money[C, SCALE]
  def from_minor(minor: Int) -> Money[C, SCALE]
    Money[C, SCALE] { unscaled: minor }
  end

  def add(self, other: Money[C, SCALE]) -> Money[C, SCALE]
    Money[C, SCALE] { unscaled: self.unscaled + other.unscaled }
  end
end

struct Quantity[U, const SCALE: Int]
  unscaled: Int
end

impl[U, const SCALE: Int] Quantity[U, SCALE]
  def from_parts(unscaled: Int) -> Quantity[U, SCALE]
    Quantity[U, SCALE] { unscaled: unscaled }
  end
end

def run() -> Int
  let usd: Money[USD, 2] = Money[USD, 2]::from_minor(100)
  let shares: Quantity[Share, 0] = Quantity[Share, 0]::from_parts(10)
  usd.add(shares)
  0
end

def main() -> Int
  run()
end
