# Negative canary: indexing a resource container is a shared read that
# returns the element by value and must be rejected.
# Expected error: "cannot extract resource element from shared container;
# use an inout/consuming access"
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let files = [File { fd: 1 }]
  let f = files[0]
  0
end
