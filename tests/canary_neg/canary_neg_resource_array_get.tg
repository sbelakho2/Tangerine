# Negative canary: shared Array.get() must not extract a resource element
# by value (that would duplicate ownership while the container stays live).
# Expected error: "cannot extract resource element from shared container;
# use an inout/consuming access"
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let files = [File { fd: 1 }]
  let f = files.get(0)
  0
end
