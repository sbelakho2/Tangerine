# Negative scoped-access canary (audit §12 — the conflict matrix): two
# MODIFY accesses on the SAME place cannot be live at once (modify+modify
# on one place fails; disjoint fields coexist).
use std::core

struct Doc
  title: String
  qty: Int
end

def main() -> Int
  mut d = Doc { title: "x" + "", qty: 0 }
  with d.title as inout t
    with d.title as inout t2
      t2.push('!')
    end
    t.push('?')
  end
  0
end
