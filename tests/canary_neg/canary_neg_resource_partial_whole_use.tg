# Negative canary: a WHOLE-value use of a partially-moved root is
# conservative-rejected — a whole-value read/copy of the root would
# include the dead chains' storage (the closure-capture rule extends to
# every whole-value use).
# Expected error: "cannot use resource `p` as a whole"
use std::core

resource Probe
  id: Int
end

resource Pair
  a: Probe
  b: Probe
end

def consume_probe(sink r: Probe) -> Unit
end

def read_pair(let p: Pair) -> Int
  p.a.id
end

def main() -> Int
  let p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  consume_probe(p.a)
  read_pair(p)
  0
end
