# Negative purity canary (third-audit item 25): a `pure` function that
# calls a @no_alloc-but-I/O function is Impure — the transitive purity
# theorem reaches the I/O site through the caller -> callee edge and the
# E0234 enforcement rejects the annotation rather than trusting it. The
# callee is @no_alloc-clean (the libc_write record is block+I/O, never
# allocation), so the only annotation in play is the purity one.
@no_alloc
def report() -> Int
  libc_write(1, Ptr::null() as Ptr[u8], 0)
end

pure def observed() -> Int
  report()
end

def main() -> Int
  0
end
