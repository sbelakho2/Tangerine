# Negative effect-class canary (audit item 42): @interrupt rejects a
# handler that takes a normal Mutex lock — the std Mutex::lock path
# spins on the atomic flag and yields the scheduler while contended
# (sched_yield — the seeded may_block extern record), so the handler's
# transitive summary over the lowered program carries the Block class
# of the interrupt context (E0232: "@interrupt handler ... may block").
use std::sync::Mutex

@interrupt
def isr_locked(m: Mutex[Int]) -> Int
  let _g = m.lock()
  0
end

def main() -> Int
  let m = Mutex::new(0)
  isr_locked(m)
  0
end
