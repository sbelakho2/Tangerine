# Negative canary (§20 const generics, slice 4 — declared range
# constraints): Decimal64's declared scale range is 0..=18, so forming
# the concrete type Decimal64[-1] (a negative scale) is the compile error
# — not a later method call. The diagnostic names the parameter, its
# declared range and the offending value.
use std::core
use std::math::Decimal64

def run() -> Int
  let bad: Decimal64[-1] = Decimal64[-1]::from_string("1".to_string()).unwrap()
  bad.unscaled()
end

def main() -> Int
  run()
end
