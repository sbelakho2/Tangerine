# Negative canary: RingBuffer[String].peek_front must be REJECTED —
# peek_front is the by-value projected read under `impl[T: Copy]
# RingBuffer[T]`, and String is not Copy (owned: moves transfer, clone()
# allocates). Returning the front element by value out of the shared slot
# would manufacture a second owner of the String. Method resolution
# consults the inherent impl's bounds, so the candidate is not applicable
# for RingBuffer[String]; non-Copy elements are read through
# peek_front_cloned (T: Clone) or extracted with the consuming pop_front.
# Expected error: "method `peek_front` requires `T: Copy`"
use std::core
use std::collections

def main() -> Int
  let mut rb = RingBuffer::new(4)
  rb.push_back("hello".to_string())
  let front = rb.peek_front()
  0
end
