# Negative canary (§20 slice 2): argument-KIND validation at instantiation
# sites — a TYPE argument cannot fill a CONST generic parameter slot: the
# second argument of ArrayVec[Int, String] is a type (String), not an
# integer constant.
use std::core

struct ArrayVec[T, const N: UInt]
  _data: [T; N]
  _len: UInt
end

def run() -> Int
  let bad: ArrayVec[Int, String] = ArrayVec { _data: [1, 2, 3, 4], _len: 4 }
  bad._data[0]
end

def main() -> Int
  run()
end
