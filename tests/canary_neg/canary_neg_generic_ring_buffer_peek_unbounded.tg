# Negative canary: a GENERIC caller with an unconstrained T must NOT be able
# to select the bounded peek_front. `impl[T: Copy] RingBuffer[T]` is
# applicable only when the receiver's type args satisfy the impl's bounds,
# and an unconstrained T satisfies nothing (the caller's generic context has
# no Copy bound on T). This is the generic path the RingBuffer concrete
# special case never covered: method resolution consults the inherent impl's
# bounds (resolve_method_type's impl-bound gate), so the candidate is not
# applicable and the call is rejected with the specific bound diagnostic.
# Expected error: "method `peek_front` requires `T: Copy`"
use std::core
use std::collections

def peek_unbounded[T](rb: RingBuffer[T]) -> Option[T]
  rb.peek_front()
end

def main() -> Int
  0
end
