# Negative canary (audit: replace_same_field_from_itself — the REJECTION
# arm): `p.a = p.a` moves the replaced value out of itself. The exact
# drop-before-store runs before the RHS materializes, so an RHS operand
# whose storage OVERLAPS the replaced chain (the target chain itself, a
# sub-value of it, or an ancestor containing it) would be destroyed
# before its source is read — rejected. (A disjoint sibling-chain RHS —
# a read or a move of another field of the same root — is accepted: see
# the positive canaries replace_rhs_reads_sibling / replace_rhs_moves_sibling.)
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Pair
  a: Probe
  b: Probe
end

def run() -> Int
  let mut p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  p.a = p.a
  p.a.id
end

def main() -> Int
  run()
end
