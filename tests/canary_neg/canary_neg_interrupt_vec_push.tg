# Negative effect-class canary (audit item 42): @interrupt rejects a
# handler that heap-allocates — the Vec::push growth path lowers to the
# heap-allocating ArrayPush intrinsic, so the handler's summary carries
# the allocation class of the interrupt context (E0232: "@interrupt
# handler ... may heap-allocate"). @interrupt is a compile-time
# semantic claim, never codegen metadata alone.
def main() -> Int
  0
end

@interrupt
def isr_push() -> Int
  let v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  0
end
