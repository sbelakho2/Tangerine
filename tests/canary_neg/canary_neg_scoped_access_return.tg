# Negative scoped-access canary (audit §12): an OWNING with-scoped access
# value cannot be RETURNED — the block-bound name is a compiler-only place
# access that may not outlive its with-block.
use std::core

struct Doc
  title: String
  qty: Int
end

def give_title() -> String
  mut d = Doc { title: "x" + "", qty: 0 }
  with d.title as let s
    return s
  end
  ""
end

def main() -> Int
  give_title()
  0
end
