# Negative canary — the ESCAPING INOUT capture at the DIRECT `async`
# marker boundary (the is_async_marker prefix family — spawn/schedule/
# poll/async — this file pins the `async` prefix branch, which the other
# negatives never touch: canary_neg_closure_async_inout.tg pins `schedule`,
# canary_neg_concurrency_inout_await.tg pins `schedule`/`spawn`, and
# canary_neg_concurrency_escaping_inout.tg pins `spawn`).
#
# The program is the BOUNDARY shape: a closure that mutates a captured
# local (the lexical inout Modify capture) passed as the argument of a
# call whose callee name starts with `async`. The rejection fires in
# check_async_closure_captures (tg_compiler/types.tg) — a Modify capture
# cannot cross the async-marked boundary. The callee here is a plain
# synchronous function — the marker is the NAME — so the diagnostic pins
# exactly the name-prefix trigger, with nothing else in the program.
# Expected error: "escaping inout capture: inout capture cannot cross
# await (the lexical inout state cannot leave its defining execution
# context)"
use std::core

def async_apply(f: fn(Int) -> Unit) -> Unit
  f(0)
end

def main() -> Int
  mut x = 0
  async_apply(do |_|
    x = x + 1
  end)
  0
end
