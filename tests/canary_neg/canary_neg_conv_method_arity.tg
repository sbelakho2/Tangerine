# Negative conformance canary (h): the method generic arity must be exact —
# the trait declares `m[T]`, the impl declares `m` (E0227).
use std::core

trait ConvMethodArity
  def m[T](self: Self) -> Int
end

struct MethodArityImpl
  v: Int
end

impl ConvMethodArity for MethodArityImpl
  def m(self: MethodArityImpl) -> Int
    0
  end
end

def main() -> Int
  0
end
