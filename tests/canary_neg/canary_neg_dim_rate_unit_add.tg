# Negative canary (audit §23 part C): adding Rate[BasisPoint, 0] +
# Rate[Percent, 0] (bps plus percent) must NOT typecheck — the rate
# unit is a phantom type argument, so the two rates are different types
# and Rate[RU, SCALE]::add only accepts the SAME instance (mirror of
# the std::math Rate shape; canaries cannot import std::math).  The
# rejected argument unification reports the Adt-vs-Adt mismatch.
use std::core

struct BasisPoint
end

struct Percent
end

struct Rate[RU, const SCALE: Int]
  unscaled: Int
end

impl[RU, const SCALE: Int] Rate[RU, SCALE]
  def from_parts(unscaled: Int) -> Rate[RU, SCALE]
    Rate[RU, SCALE] { unscaled: unscaled }
  end

  def add(self, other: Rate[RU, SCALE]) -> Rate[RU, SCALE]
    Rate[RU, SCALE] { unscaled: self.unscaled + other.unscaled }
  end
end

def run() -> Int
  let bps: Rate[BasisPoint, 0] = Rate[BasisPoint, 0]::from_parts(500)
  let pct: Rate[Percent, 0] = Rate[Percent, 0]::from_parts(5)
  bps.add(pct)
  0
end

def main() -> Int
  run()
end
