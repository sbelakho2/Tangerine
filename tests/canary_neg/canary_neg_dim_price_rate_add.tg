# Negative canary (audit §23 part C): adding Price[USD, Share, 4] +
# Rate[BasisPoint, 0] must NOT typecheck — a price and a rate are
# different dimensions (Adt-vs-Adt mismatch), so no `add` signature
# accepts the other dimension without a conversion (mirror of the
# std::math Price/Rate shapes; canaries cannot import std::math).
use std::core

struct USD
end

struct Share
end

struct BasisPoint
end

struct Price[C, U, const SCALE: Int]
  unscaled: Int
end

impl[C, U, const SCALE: Int] Price[C, U, SCALE]
  def from_parts(unscaled: Int) -> Price[C, U, SCALE]
    Price[C, U, SCALE] { unscaled: unscaled }
  end

  def add(self, other: Price[C, U, SCALE]) -> Price[C, U, SCALE]
    Price[C, U, SCALE] { unscaled: self.unscaled + other.unscaled }
  end
end

struct Rate[RU, const SCALE: Int]
  unscaled: Int
end

impl[RU, const SCALE: Int] Rate[RU, SCALE]
  def from_parts(unscaled: Int) -> Rate[RU, SCALE]
    Rate[RU, SCALE] { unscaled: unscaled }
  end
end

def run() -> Int
  let p: Price[USD, Share, 4] = Price[USD, Share, 4]::from_parts(123456)
  let r: Rate[BasisPoint, 0] = Rate[BasisPoint, 0]::from_parts(500)
  p.add(r)
  0
end

def main() -> Int
  run()
end
