# Negative purity canary (third-audit item 25): a `pure` function reading
# a volatile/MMIO register is Impure — the _tg_volatile_read32 extern's
# record carries the MMIO (hardware-register) capability (may_io=false),
# and a capability disqualifies purity, so E0234 rejects the annotation.
use std::core
use std::embedded::volatile_read32

pure def peek() -> u32
  volatile_read32(0x40000000)
end

def main() -> Int
  0
end
