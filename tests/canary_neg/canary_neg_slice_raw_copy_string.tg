# Negative canary (audit item 1 — the Slice ownership split): a RAW
# (byte) copy of a window containing OWNING elements is REJECTED. The
# raw pin surface (slice_pin / Array::as_slice / copied_slice) carries
# the `T: Copy` bound — a raw byte copy of a String image would
# manufacture a second owner of the String's buffer inside the pinned
# window (the source String and the window image would both destroy the
# same buffer), so Vec[String].as_slice must fail method resolution
# with the impl-bound diagnostic. Owning windows are built with
# cloned_slice (per-element clones — the backing deinit destroys each
# clone exactly once).
# Expected error: "method `as_slice` requires `T: Copy`"
use std::core
use std::collections

def main() -> Int
  var v = Vec[String]::new()
  v.push("a" + "")
  v.push("b" + "")
  let s = v.as_slice()
  0
end
