# Negative canary: matching a resource-containing scrutinee by value moves
# ownership into the arm bindings — using the scrutinee afterwards is a
# use-after-consume.
# Expected error: resource checker reports use of a consumed resource
use std::core

resource File
  fd: Int
end

def main() -> Int
  let f = Option::Some(File { fd: 1 })
  match f
  when Option::Some(r) then r.fd
  when Option::None then 0
  end
  f.fd
end
