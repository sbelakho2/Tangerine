# Negative effect canary: calling the std's effectful println (the Io
# seed — the effectful std functions' declared effects wired into the
# checker) WITHOUT declaring the effect is rejected by the checker's
# effect discipline: the caller's computed effect set (the callees'
# declared effects, transitively) is compared against its declared set at
# the end of the check, and a performed-but-undeclared effect is an error.
use std::io::{println}

def main() -> Int
  println("undeclared Io effect")
  0
end
