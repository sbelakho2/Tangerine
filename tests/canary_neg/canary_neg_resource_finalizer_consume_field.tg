# Negative canary: a user finalizer must not CONSUME compiler-owned resource
# fields. `self.inner` is a projected field; consuming it would let the
# structural field cleanup deinit `inner` a second time.
# Expected error: "cannot consume resource `self`"
use std::core

resource Inner
  x: Int
end

resource Outer
  inner: Inner
  def deinit(sink self: Self) -> Unit
    let stolen = self.inner
  end
end

def main() -> Int
  let o = Outer { inner: Inner { x: 1 } }
  0
end
