# Negative canary (audit item 1 — the scoped-access determination): a
# window view of a collection cannot be CAPTURED into a closure inside a
# with-scoped access block. Window views over live storage are not
# first-class values on this snapshot (the with-machinery binds places
# or the registered Map accessors only), and the owning persistent Slice
# is rejected as a with source; capturing the bound value into an
# escaping closure would let it outlive the block, which is the capture
# channel gate.
# Expected error: "cannot capture the with-scoped access value"
use std::core
use std::collections

def run_cb(f: fn() -> Int) -> Int
  f()
end

def capture_window() -> Int
  var v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  v.push(3)
  with copied_slice(v, 0, 2) as let w
    let cb = || w.len() as Int
    run_cb(cb)
  end
  0
end

def main() -> Int
  capture_window()
  0
end
