# Negative canary: a String extra argument of a variadic extern call is
# rejected by the type checker (the C default argument promotions admit
# the F32/F64 and integer/pointer scalars only — Strings are owned
# object handles, never C scalars, and the language's vararg surface
# does not implement the C aggregate/crossing rules).
# Expected error: "variadic extern argument 2 has type `String`: the
# vararg subset is the C-promotable scalars"
use std::core

extern def vararg_sink(tag: Int, ...) -> Int

def main() -> Int
  let s = "not a C scalar"
  let r = vararg_sink(0, s)
  0
end
