# Negative conformance canary (j): the impl must state the FULL TraitRef —
# trait `ConvTraitArgs[T]` declares ONE trait-level type argument, the
# impl provides NONE (a head-only impl) — rejected (E0229).
use std::core

trait ConvTraitArgs[T]
  def m(self: Self) -> T
end

struct TraitArgsImpl
  v: Int
end

impl ConvTraitArgs for TraitArgsImpl
  def m(self: TraitArgsImpl) -> Int
    0
  end
end

def main() -> Int
  0
end
