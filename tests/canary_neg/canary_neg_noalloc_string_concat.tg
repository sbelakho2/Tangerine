# Negative effect-class canary (audit §11): @no_alloc rejects the owned
# String concatenation — `+` on String operands lowers to the
# heap-allocating str_concat intrinsic operation (E0232).
def main() -> Int
  0
end

@no_alloc
def concat() -> String
  let a = "hello"
  let b = " world"
  a + b
end
