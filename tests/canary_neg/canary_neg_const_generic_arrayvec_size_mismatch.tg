# Negative canary (§20 slice 2): a generic STRUCT instanced at N=4 and at
# N=8 are DIFFERENT types — assigning an ArrayVec[Int, 8] value into an
# ArrayVec[Int, 4] binding is rejected by the const-generic argument
# mismatch (canonical identity is the value: Const(4) != Const(8)).
use std::core

struct ArrayVec[T, const N: UInt]
  _data: [T; N]
  _len: UInt
end

def run() -> Int
  mut a4: ArrayVec[Int, 4] = ArrayVec { _data: [10, 20, 30, 40], _len: 4 }
  let b8: ArrayVec[Int, 8] = ArrayVec { _data: [1, 2, 3, 4, 5, 6, 7, 8], _len: 8 }
  a4 = b8
  0
end

def main() -> Int
  run()
end
