# Negative canary (§20 const generics, slice 4 — declared range
# constraints): Decimal128's declared scale range is 0..=38, so forming
# the concrete type Decimal128[39] is the compile error — not a later
# method call. The diagnostic names the parameter, its declared range and
# the offending value.
use std::core
use std::math::Decimal128

def run() -> Int
  let bad: Decimal128[39] = Decimal128[39]::from_string("1.0".to_string()).unwrap()
  bad.unscaled()
end

def main() -> Int
  run()
end
