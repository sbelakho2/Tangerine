# Negative canary (audit §23 part C): adding Money[USD, 2] + Money[USD, 4]
# must NOT typecheck — the const SCALE is part of the type (as in
# Decimal64[SCALE]), so add only accepts the SAME instance; the scale
# bridge is the checked rescale[T], never a silent operand conversion
# (mirror of the std::math Money shape; canaries cannot import
# std::math).  The rejected const argument reports "const generic
# argument mismatch".
use std::core

struct USD
end

struct Money[C, const SCALE: Int]
  unscaled: Int
end

impl[C, const SCALE: Int] Money[C, SCALE]
  def from_minor(minor: Int) -> Money[C, SCALE]
    Money[C, SCALE] { unscaled: minor }
  end

  def add(self, other: Money[C, SCALE]) -> Money[C, SCALE]
    Money[C, SCALE] { unscaled: self.unscaled + other.unscaled }
  end
end

def run() -> Int
  let cents: Money[USD, 2] = Money[USD, 2]::from_minor(100)
  let mills: Money[USD, 4] = Money[USD, 4]::from_minor(100)
  cents.add(mills)
  0
end

def main() -> Int
  run()
end
