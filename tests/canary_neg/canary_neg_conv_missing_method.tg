# Negative conformance canary (a): an impl of a trait that is missing a
# REQUIRED (non-defaulted) method must be rejected BEFORE the impl enters
# env.impls — the solver must never see the incomplete impl. Expected:
# "missing required method" (E0220).
use std::core

trait ConvMissing
  def required(self: Self) -> Int
  def present(self: Self) -> Int
end

struct MissingImpl
  v: Int
end

impl ConvMissing for MissingImpl
  def present(self: MissingImpl) -> Int
    0
  end
end

def main() -> Int
  0
end
