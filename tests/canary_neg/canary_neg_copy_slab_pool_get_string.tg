# Negative canary: the Copy-gated by-value read of a slab occupant.
# `get` lives under `impl[T: Copy] SlabPool[T]` (std/alloc_policy.tg),
# so a read-through-get on SlabPool[String] must be REJECTED — String
# is not Copy (owned: moves transfer, clone() allocates); returning the
# occupant by value out of the shared slot would manufacture a second
# owner. Method resolution consults the inherent impl's bounds, so the
# candidate is not applicable and the blocked-method diagnostic names
# the bound — the SAME machinery that rejects RingBuffer[String].
# peek_front (canary_neg_ring_buffer_peek_string.tg), now pinning this
# module's read surface.
# Expected error: "method `get` requires `T: Copy`"
use std::core
use std::alloc_policy::{SlabPool}

def main() -> Int
  var pool = SlabPool[String].new(4)
  let _ = pool.get(0)
  0
end
