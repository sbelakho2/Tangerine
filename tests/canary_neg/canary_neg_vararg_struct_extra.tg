# Negative canary: a STRUCT extra argument of a variadic extern call is
# rejected by the type checker (the C default argument promotions admit
# the F32/F64 and integer/pointer scalars only — aggregates cross the C
# ABI by reference, which the language's vararg surface does not
# implement). Expected error: "variadic extern argument 2 has type
# `Point`: the vararg subset is the C-promotable scalars"
use std::core

struct Point
  x: Int
  y: Int
end

extern def vararg_sink(tag: Int, ...) -> Int

def main() -> Int
  let p = Point { x: 1, y: 2 }
  let r = vararg_sink(0, p)
  0
end
