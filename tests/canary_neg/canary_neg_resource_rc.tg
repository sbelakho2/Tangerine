# Negative canary: Rc[Resource] is an unsupported combination — a linear
# resource cannot be shared through reference counting. The policy must be
# enforced, not just documented.
# Expected error: "Rc[Resource] is unsupported"
use std::core
use std::alloc

resource Probe
  id: Int
end

def main() -> Int
  let r: Rc[Probe] = rc_new(Probe { id: 1 })
  0
end
