# Negative scoped-access canary (audit §12): an OWNING with-scoped access
# value cannot be bound into a new owned local — the access value may not
# be moved out of the accessed place.
use std::core

struct Doc
  title: String
  qty: Int
end

def main() -> Int
  mut d = Doc { title: "x" + "", qty: 0 }
  with d.title as let s
    let copy = s
    if copy.len() != 1 then
      return 1
    end
  end
  0
end
