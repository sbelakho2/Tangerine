# Negative DMA-ownership canary (audit item 16, next tier): dma_unpin on a
# place that is not DMA-owned is rejected (unpin without pin). The place's
# lattice state is not-pinned — no dma_pin_* opened a device pin, so the
# release has nothing to close.
use std::core
use std::embedded::{dma_unpin}

def unpin_without_pin() -> Int
  var buf: [u8; 16] = [0u8; 16]
  dma_unpin(buf)
  0
end

def main() -> Int
  0
end
