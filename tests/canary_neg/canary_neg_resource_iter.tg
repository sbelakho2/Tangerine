# Negative canary: iterating a resource container must be rejected even with
# a MUTABLE receiver — iterators copy element storage, which would duplicate
# ownership of every resource element (Copyable constraint).
# Expected error: cannot extract resource element from shared container;
# use an inout/consuming access
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let mut files = [File { fd: 1 }]
  let it = files.iter()
  0
end
