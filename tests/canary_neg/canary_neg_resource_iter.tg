# Negative canary: building an iterator from a resource container must not
# happen through a shared/immutable receiver — iter() now requires an inout
# receiver (iterating a shared container would copy element storage and
# duplicate linear resources). Expected error: inout receiver requires a
# mutable binding (or the checker's shared-extraction rejection).
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let files = [File { fd: 1 }]
  let it = files.iter()
  0
end
