use std::io::{print, println}

def int_to_string(n: Int) -> String
  if n == 0 then
    return "0"
  end
  mut val = n
  mut result = ""
  if val < 0 then
    result = "-"
    val = 0 - val
  end
  mut digits = ""
  while val > 0 do
    let digit = val - ((val / 10) * 10)
    val = val / 10
    let ch = match digit
      when 0 then "0"
      when 1 then "1"
      when 2 then "2"
      when 3 then "3"
      when 4 then "4"
      when 5 then "5"
      when 6 then "6"
      when 7 then "7"
      when 8 then "8"
      when 9 then "9"
      else "?"
    end
    digits = ch + digits
  end
  result + digits
end

def apply_op(op: Int, stored: Int, current: Int) -> Int
  match op
  when 1 then stored + current
  when 2 then stored - current
  when 3 then stored * current
  when 4 then
    if current == 0 then
      -999999
    else
      stored / current
    end
  else current
  end
end

def op_name(op: Int) -> String
  match op
  when 1 then "+"
  when 2 then "-"
  when 3 then "*"
  when 4 then "/"
  else "?"
  end
end

def test_calc(desc: String, op: Int, a: Int, b: Int, expected: Int) -> Int
  let result = apply_op(op, a, b)
  let pass_str = if result == expected then "PASS" else "FAIL" end
  print("  ")
  print(pass_str)
  print(": ")
  print(int_to_string(a))
  print(" ")
  print(op_name(op))
  print(" ")
  print(int_to_string(b))
  print(" = ")
  print(int_to_string(result))
  if result != expected then
    print(" (expected ")
    print(int_to_string(expected))
    print(")")
  end
  println("")
  if result == expected then 0 else 1 end
end

def main() -> Int
  println("--- Basic Arithmetic ---")
  mut fails = 0
  fails = fails + test_calc("add", 1, 5, 3, 8)
  fails = fails + test_calc("sub", 2, 100, 42, 58)
  fails = fails + test_calc("mul", 3, 10, 7, 70)
  fails = fails + test_calc("div", 4, 84, 12, 7)
  println("")

  println("--- Chained ---")
  let chain1 = apply_op(1, 10, 20)
  print("  10 [+] 20 [=] = ")
  println(int_to_string(chain1))

  let chain2_s1 = apply_op(1, 10, 20)
  let chain2 = apply_op(3, chain2_s1, 3)
  println("  10 [+] 20 [*] 3 [=] = " + int_to_string(chain2))

  println("")
  print("fails = ")
  println(int_to_string(fails))

  if fails == 0 then
    println("ALL PASSED!")
  end
  fails
end
