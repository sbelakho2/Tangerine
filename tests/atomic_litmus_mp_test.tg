# tests/atomic_litmus_mp_test.tg — Message Passing (MP) litmus.
#
# The classic release-store / acquire-load publication pattern, run over
# ITERATIONS independent slots:
#   Thread 1: data[i] = 42 (Relaxed);  flag[i] = 1 (Release)
#   Thread 2: seen[i] = flag[i] (Acquire);  if seen[i] == 1 then
#             r[i] = data[i] (Relaxed) else r[i] = 0
# The forbidden outcome is seen[i] == 1 && r[i] != 42: once the
# acquire-load observes the release-store's value, the relaxed payload
# store MUST be visible (release/acquire synchronizes-with). A build
# whose Release store was only a plain MOV on x86-64 would still pass
# here (TSO gives the plain store release semantics) — this test pins
# the release/acquire contract on the AArch64 STLR/LDAR path and on any
# weaker emitters.

use std::core
use std::atomic::{AtomicInt, Ordering}
use std::thread::{spawn}

extern def _tg_mem_alloc(size: UInt) -> Ptr[u8]
extern def _tg_mem_free(ptr: Ptr[u8], size: UInt) -> Unit

const ITERATIONS: Int = 20000

struct Slot
  v: AtomicInt
end

def mp_writer(data: Ptr[Slot], flag: Ptr[Slot]) -> Int
  var i = 0
  while i < ITERATIONS do
    let dp = data.offset(i)
    dp.as_ref().v.store(42, Ordering::Relaxed)
    let fp = flag.offset(i)
    fp.as_ref().v.store(1, Ordering::Release)
    i = i + 1
  end
  0
end

def mp_reader(data: Ptr[Slot], flag: Ptr[Slot], seen: Ptr[Int], r: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    let fp = flag.offset(i)
    let f = fp.as_ref().v.load(Ordering::Acquire)
    let sp = seen.offset(i)
    sp.write(f)
    let dp = data.offset(i)
    let v = if f == 1 then dp.as_ref().v.load(Ordering::Relaxed) else 0 end
    let rp = r.offset(i)
    rp.write(v)
    i = i + 1
  end
  0
end

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  let bytes = (ITERATIONS * 8) as UInt
  let db = _tg_mem_alloc(bytes)
  let fb = _tg_mem_alloc(bytes)
  let sb = _tg_mem_alloc(bytes)
  let rb = _tg_mem_alloc(bytes)
  if db.is_null() || fb.is_null() || sb.is_null() || rb.is_null() then
    println("atomic_litmus_mp: allocation failed")
    return 1
  end
  let data = db.cast[Slot]()
  let flag = fb.cast[Slot]()
  let seen = sb.cast[Int]()
  let r = rb.cast[Int]()

  var i = 0
  while i < ITERATIONS do
    data.offset(i).write(Slot { v: AtomicInt::new(0) })
    flag.offset(i).write(Slot { v: AtomicInt::new(0) })
    i = i + 1
  end

  let d1 = data
  let f1 = flag
  let d2 = data
  let f2 = flag
  let s2 = seen
  let r2 = r
  let h0 = spawn(move || mp_writer(d1, f1))
  let h1 = spawn(move || mp_reader(d2, f2, s2, r2))

  match h0.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_mp: writer failed with code " + code.to_string())
      return 10
    end
  when Result::Err(e) then
    println("atomic_litmus_mp: writer join failed: " + e)
    return 11
  end

  match h1.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_mp: reader failed with code " + code.to_string())
      return 12
    end
  when Result::Err(e) then
    println("atomic_litmus_mp: reader join failed: " + e)
    return 13
  end

  # Forbidden: the acquire-load observed the release-store's flag value
  # but the relaxed payload read came back stale.
  var forbidden = 0
  var published = 0
  i = 0
  while i < ITERATIONS do
    let s = seen.offset(i).read()
    if s == 1 then
      published = published + 1
      let v = r.offset(i).read()
      if v != 42 then
        forbidden = forbidden + 1
      end
    end
    i = i + 1
  end

  _tg_mem_free(db, bytes)
  _tg_mem_free(fb, bytes)
  _tg_mem_free(sb, bytes)
  _tg_mem_free(rb, bytes)

  if forbidden != 0 then
    println("atomic_litmus_mp: forbidden stale payload observed " + forbidden.to_string() + " times of " + published.to_string() + " publications")
    return 2
  end
  # The vacuous-pass guard (the statistical bound): a run where the
  # reader finished before the writer's first release-store observed
  # ZERO publications — the litmus exercised nothing and must fail. The
  # reader races the writer's stores over ITERATIONS slots; a zero-
  # publication run means the threads never overlapped.
  if published == 0 then
    println("atomic_litmus_mp: vacuous run — zero publications observed over " + ITERATIONS.to_string() + " slots (the reader never saw the writer)")
    return 3
  end
  0
end
