# tests/repl_contract_test.tg — the REPL contract tests (the bounded
# REPL's session behavior).
#
# The REPL (tg repl — the driver's cmd_repl) is the bounded session:
#   - every entry compiles AND runs through the driver's REAL machinery
#     as its own process (parse -> type-check -> resource check -> MIR
#     -> codegen -> link -> execute) — the language's actual evaluation
#     path, never a hand-rolled interpreter;
#   - the MULTI-LINE BUFFERING: an entry accumulates until its block
#     structure balances (repl_buffer_complete), then evaluates as one
#     unit;
#   - the STATE PRESERVATION: the buffer is cleared after every
#     completed entry, so a runtime/compile failure of one entry never
#     leaks into the next;
#   - expression entries print their result as `=> <code>` (the exit
#     code of the wrapped `def main() -> Int`).
#
# The lib.tg Repl struct is the SAME session shape the CLI drives — the
# contract tests pin its state machine; the piped-session CLI behavior
# (including `:quit` and the EOF flush) is pinned by
# tests/run_tool_contract_tests.sh.
#
# Run with: tg run tests/repl_contract_test.tg

use std::test::*
use std::core::{Option, Result, String, Unit, Bool, Int, UInt}

use tg_compiler::lib::{Repl}

@test
def test_repl_help_and_quit_commands() -> Unit
  var repl = Repl::new()
  let help = repl.eval(":help")
  assert_contains(help, ":help")
  let quit = repl.eval(":quit")
  assert_eq(quit, "Goodbye!")
end

@test
def test_repl_expression_entry_prints_result() -> Unit
  var repl = Repl::new()
  let result = repl.eval("1 + 2")
  assert_contains(result, "=> 3")
end

@test
def test_repl_multiline_entry_buffers_until_balanced() -> Unit
  var repl = Repl::new()
  # The opening lines alone are incomplete (the blocks are not
  # balanced) — the session must NOT evaluate them yet.
  let first = repl.eval("def double_it(x: Int) -> Int")
  assert_eq(first, "")
  let second = repl.eval("  x * 2")
  assert_eq(second, "")
  let third = repl.eval("end")
  assert_eq(third, "")
  # The entry is still incomplete (the program needs a main).
  let fourth = repl.eval("def main() -> Int")
  assert_eq(fourth, "")
  let fifth = repl.eval("  double_it(3)")
  assert_eq(fifth, "")
  # The final `end` balances the whole program — the entry evaluates
  # as ONE unit (a full program entry: it runs and prints no result
  # line).
  let sixth = repl.eval("end")
  assert_eq(sixth, "")
end

@test
def test_repl_error_does_not_leak_into_the_next_entry() -> Unit
  var repl = Repl::new()
  # A failing entry: the compile error text is returned (non-empty) and
  # the buffer is CLEARED — the next entry evaluates in a fresh state.
  let failed = repl.eval("let = ")
  assert_true(failed.len() > 0)
  let next = repl.eval("1 + 1")
  assert_contains(next, "=> 2")
end

@test
def test_repl_error_then_continue_after_runtime_failure() -> Unit
  var repl = Repl::new()
  # A runtime failure (the wrapped entry aborts): the failure is
  # reported, the session continues, and the following entry evaluates
  # normally — the runtime-error state never corrupts the session.
  let failed = repl.eval("panic(\"boom\")")
  assert_true(failed.len() > 0)
  let next = repl.eval("2 + 2")
  assert_contains(next, "=> 4")
end

@test
def test_repl_session_state_accumulates_history() -> Unit
  var repl = Repl::new()
  let _ = repl.eval("1 + 1")
  let _ = repl.eval("2 + 2")
  assert_true(repl.history.len() == 2)
  assert_eq(repl.history[0], "1 + 1")
  assert_eq(repl.history[1], "2 + 2")
end

@test
def test_repl_eof_flush_evaluates_pending_buffer() -> Unit
  var repl = Repl::new()
  # The incomplete entry stays pending; the EOF flush (the empty line
  # the piped session sends at the end of input) evaluates the pending
  # buffer — the unterminated entry's compile error is reported.
  let _ = repl.eval("def main() -> Int")
  let flushed = repl.eval("")
  assert_true(flushed.len() > 0)
end
