# Positive canary: OrderedMap[String, Resource] — the insertion-order-
# preserving map holds OWNED (K, V) pairs (the entries array) plus the
# key-position index; scope-end cleanup drops the resource VALUES exactly
# once each (the entries array's pairs) and the index's key copies.
use std::core
use std::collections

static mut v_drops: Int = 0

resource Value
  v: Int
  def deinit(sink self: Self) -> Unit
    v_drops = v_drops + 1
  end
end

def do_test() -> Int
  let mut om = OrderedMap[String, Value]::new()
  let v1 = Value { v: 1 }
  let v2 = Value { v: 2 }
  om.insert("one", v1)
  om.insert("two", v2)
  if om.len() != 2 then
    return 1
  end
  if !om.contains_key(&"one".to_string()) then
    return 2
  end
  0
end

def main() -> Int
  let ok = do_test()
  if ok == 0 && v_drops == 2 then
    0
  else
    println("canary_pos_ordered_map_resource: FAIL ok=" + ok.to_string() + " v_drops=" + v_drops.to_string())
    1
  end
end
