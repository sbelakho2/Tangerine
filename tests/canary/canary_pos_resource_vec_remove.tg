# Positive canary: the POSITIONAL take on a dynamic container —
# Vec::remove(index) — extracts an owning element through the sanctioned
# ownership-safe operation (the paired positive of the dynamic-index
# rejections: canary_neg_resource_index rejects the raw vec[i] sink
# extraction; this is the sanctioned form). The removed element moves out
# of the container and the container keeps the remaining elements.
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let mut files = [File { fd: 1 }, File { fd: 2 }]
  let first = files.remove(0)
  if first.fd == 1 && files.len() == 1 then 0 else 1 end
end
