# Positive canary (audit: replace_rhs_moves_sibling): the exact-place
# replacement with a RHS that MOVES a disjoint sibling chain of the same
# root — `p.a = p.b`. The exact drop destroys only p.a's old value (the
# moved sibling's storage is never touched by the drop); the sibling's
# value moves into the replaced field and finalizes there at the scope
# exit. Deinit counts: old p.a at the replacement; the replacement (the
# moved p.b value) at the scope exit — exactly 2; p.a's old value is
# dropped exactly once, the moved value is dropped exactly once.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Pair
  a: Probe
  b: Probe
end

def run() -> Int
  let mut p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  p.a = p.b
  if p.a.id == 2 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 2 then
    0
  else
    println("canary_pos_replace_rhs_moves_sibling: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
