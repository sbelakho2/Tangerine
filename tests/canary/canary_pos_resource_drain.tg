# Positive canary: the DESTRUCTIVE map_drain_one primitive — the actual
# (K, V) entry is transferred out of the map (no snapshot copy), and the
# drained value plus the remaining entries are deinitialized exactly once
# each at scope end.
use std::core
use std::collections

resource Value
  v: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

static mut deinit_count: Int = 0

def use_map() -> Int
  let mut m = Map[String, Value]::new()
  m.insert("a", Value { v: 1 })
  m.insert("b", Value { v: 2 })
  let first = m.drain_one()
  if first.is_some() then 1 else 0 end
end

def main() -> Int
  let ok = use_map()
  if ok == 1 && deinit_count == 2 then
    0
  else
    println("canary_pos_resource_drain: FAIL ok=" + ok.to_string() + " deinit_count=" + deinit_count.to_string())
    1
  end
end
