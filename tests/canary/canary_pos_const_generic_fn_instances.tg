# Positive canary (§20 slice 2): a generic FUNCTION whose const parameter
# is inferred at the CALL SITE from an argument whose type carries the
# parameter's size — `def arr_copy[T, const N: UInt](src: [T; N]) -> [T; N]`
# called with a [Int; 4] argument instantiates the callee at N=4 (substs
# [Int, Const(4)]) and called with a [Int; 8] argument at N=8 ([Int,
# Const(8)]) — two DISTINCT instances of one generic function coexist in
# the same program. The symbolic [T; N] signature folds to the concrete
# fixed-array type at the call through the const-parameter presolve.
use std::core

def arr_copy[T, const N: UInt](src: [T; N]) -> [T; N]
  src
end

def run() -> Int
  let a4: [Int; 4] = [1, 2, 3, 4]
  let b4: [Int; 4] = arr_copy(a4)
  if b4[0] + b4[3] != 5 then
    return 1
  end
  let a8: [Int; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
  let b8: [Int; 8] = arr_copy(a8)
  if b8[7] != 8 then
    return 2
  end
  # the same instance (same N) unifies again: N=4 already solved
  let c4: [Int; 4] = arr_copy(b4)
  if c4[2] != 3 then
    return 3
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_const_generic_fn_instances: FAIL " + ok.to_string())
    1
  end
end
