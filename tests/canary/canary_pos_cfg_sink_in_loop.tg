# Positive canary — the SINK-IN-LOOP boundary: a resource transferred
# into a sink INSIDE the loop body, per iteration. The per-iteration
# transfer consumes each construction exactly once; the back-edge must
# never finalize the already-sunk local (it is Consumed, not Live), and
# the loop-exit edge adds nothing. 3 iterations, exactly 3 destructor
# calls (all in the callee).
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def consume_probe(sink r: Probe) -> Unit
end

def main() -> Int
  var i = 0
  while i < 3 do
    let p = Probe { id: i }
    consume_probe(p)
    i = i + 1
  end
  if deinit_count == 3 then
    0
  else
    println("canary_pos_cfg_sink_in_loop: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
