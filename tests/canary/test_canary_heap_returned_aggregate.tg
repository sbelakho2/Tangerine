# tests/canary/test_canary_heap_returned_aggregate.tg
# Native canary: a heap-returned aggregate. A function allocates and
# builds a large aggregate (a wide struct and a large Vec) and returns it
# by value; the caller must receive the full aggregate intact. Catches
# broken hidden-return-pointer / aggregate-return lowering.
#
# Failure class: AGGREGATE_RETURN_BUG / MIR_PLACE_BUG

use std::core

struct WideAgg
  a: Int
  b: Int
  c: Int
  d: Int
  e: Int
  f: Int
  g: Int
  h: Int
  i: Int
  j: Int
end

def build_wide(seed: Int) -> WideAgg
  WideAgg {
    a: seed,      b: seed + 1,  c: seed + 2,  d: seed + 3,  e: seed + 4,
    f: seed + 5,  g: seed + 6,  h: seed + 7,  i: seed + 8,  j: seed + 9
  }
end

def build_big_vec() -> Vec[Int]
  mut v: Vec[Int] = Vec::new()
  mut i = 0
  while i < 100 do
    v.push(i * i)
    i = i + 1
  end
  v
end

def check_wide_aggregate_return() -> Bool
  let w = build_wide(10)
  w.a == 10 && w.b == 11 && w.c == 12 && w.d == 13 && w.e == 14 &&
  w.f == 15 && w.g == 16 && w.h == 17 && w.i == 18 && w.j == 19
end

def check_vec_aggregate_return() -> Bool
  let v = build_big_vec()
  if v.len() != 100 then
    return false
  end
  v[0] == 0 && v[10] == 100 && v[50] == 2500 && v[99] == 9801
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_wide_aggregate_return() then
    passed = passed + 1
    println("[PASS] wide_aggregate_return")
  else
    failed = failed + 1
    println("[FAIL] wide_aggregate_return")
  end

  if check_vec_aggregate_return() then
    passed = passed + 1
    println("[PASS] vec_aggregate_return")
  else
    failed = failed + 1
    println("[FAIL] vec_aggregate_return")
  end

  println("canary_heap_returned_aggregate: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
