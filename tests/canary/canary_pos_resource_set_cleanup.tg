# Positive canary: a Set holding RESOURCE elements — insert consumes each
# element into the set's storage, and the scope-end cleanup drains and
# drops every live element exactly once (the set mirror of
# canary_pos_resource_map_cleanup.tg). Shared reads of resource elements
# stay rejected (canary_neg_resource_iter.tg); this exercises the
# ownership-taking insert + destructive cleanup path only.
use std::core
use std::collections

static mut file_drops: Int = 0

resource File
  fd: Int
  def deinit(sink self: Self) -> Unit
    file_drops = file_drops + 1
  end
end

def do_test() -> Unit
  let mut s = Set[File]::new()
  let f1 = File { fd: 1 }
  let f2 = File { fd: 2 }
  s.insert(f1)
  s.insert(f2)
  if s.len() != 2 then
    println("canary_pos_resource_set_cleanup: FAIL len=" + s.len().to_string())
  end
end

def main() -> Int
  do_test()
  if file_drops == 2 then
    0
  else
    println("canary_pos_resource_set_cleanup: FAIL file_drops=" + file_drops.to_string())
    1
  end
end
