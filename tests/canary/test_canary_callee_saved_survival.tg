# tests/canary/test_canary_callee_saved_survival.tg
# Native canary: callee-saved register survival. A callee performs heavy
# register-clobbering work; the caller's values held across the call
# (which must live in x19-x28, the ARM64 callee-saved registers) must
# survive. Exercises both the "hold value across many clobbers" pattern
# and nested calls.
#
# Failure class: ARM64_CALLING_CONVENTION_BUG / CALLEE_SAVED_BUG

use std::core

def clobber_heavy(seed: Int) -> Int
  mut acc = seed
  mut i = 0
  while i < 64 do
    acc = acc + i
    acc = acc ^ 0x5A5A
    acc = acc * 3
    acc = acc - i
    i = i + 1
  end
  acc
end

def check_survives_across_clobber() -> Bool
  let keep = 987654321
  let noise = clobber_heavy(1)
  # noise is used, then keep must still be intact.
  let keep_again = keep
  keep_again == 987654321
end

def check_multiple_values_survive() -> Bool
  let a = 111
  let b = 222
  let c = 333
  let d = 444
  let junk1 = clobber_heavy(2)
  let junk2 = clobber_heavy(3)
  a == 111 && b == 222 && c == 333 && d == 444
end

def check_nested_call_preserves() -> Bool
  let sentinel = 555
  let inner = clobber_heavy(clobber_heavy(4))
  let outer = sentinel
  outer == 555
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_survives_across_clobber() then
    passed = passed + 1
    println("[PASS] callee_saved_survival")
  else
    failed = failed + 1
    println("[FAIL] callee_saved_survival")
  end

  if check_multiple_values_survive() then
    passed = passed + 1
    println("[PASS] multiple_values_survive")
  else
    failed = failed + 1
    println("[FAIL] multiple_values_survive")
  end

  if check_nested_call_preserves() then
    passed = passed + 1
    println("[PASS] nested_call_preserves")
  else
    failed = failed + 1
    println("[FAIL] nested_call_preserves")
  end

  println("canary_callee_saved_survival: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
