# Positive canary: Box[T] and T specialize generics as DISTINCT instances —
# Wrap[Box[{u8;16}]] carries the 8-byte wrapper layout while Wrap[{u8;16}]
# carries the 16-byte content layout, and Vec[Box[Int]] / Vec[Int] coexist
# as separate monomorphizations.
use std::core
use std::alloc
use std::collections

struct Wrap[T]
  value: T
end

def main() -> Int
  let boxed = size_of[Wrap[Box[[u8; 16]]]]()
  let plain = size_of[Wrap[[u8; 16]]]()
  let mut boxes: Vec[Box[Int]] = Vec::new()
  boxes.push(box_new(7))
  let mut ints: Vec[Int] = Vec::new()
  ints.push(7)
  if boxed == 8 && plain == 16 && boxes.len() == 1 && ints.len() == 1 then
    0
  else
    1
  end
end
