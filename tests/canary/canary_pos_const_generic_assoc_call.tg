# Positive canary (§23): a GENERIC-TYPED ASSOCIATED call —
# `Dec64[2]::from_parts(...)` — types its own instance from the PATH's
# const arguments. The parser previously dropped the owner type arguments
# of `Name[Args]::method` (the instance was solvable only from an
# annotated binding type); they now reach the callee resolution, resolve
# into the concrete owner Adt (Dec64[Type::Const(2)]), and unify against
# the impl HEAD (`impl[const SCALE: Int] Dec64[SCALE]` instantiated with
# the candidate's fresh variables) — the impl's const parameter binds at
# the call site, so the method's return type instantiates directly and the
# recorded substitution carries the solved Const. Every `let` below is
# UN-ANNOTATED: the path's args alone must type the call.
use std::core

struct Dec64[const SCALE: Int]
  unscaled: Int
end

impl[const SCALE: Int] Dec64[SCALE]
  def from_parts(unscaled: Int) -> Dec64[SCALE]
    Dec64[SCALE] { unscaled: unscaled }
  end

  def zero() -> Dec64[SCALE]
    Dec64[SCALE] { unscaled: 0 }
  end

  def scale(self) -> Int
    SCALE
  end
end

def run() -> Int
  let a2 = Dec64[2]::from_parts(5)
  let b4 = Dec64[4]::from_parts(60)
  let z2 = Dec64[2]::zero()
  let z4 = Dec64[4]::zero()
  if a2.unscaled != 5 then
    return 1
  end
  if b4.unscaled != 60 then
    return 2
  end
  if z2.unscaled != 0 then
    return 3
  end
  if z4.unscaled != 0 then
    return 4
  end
  # The per-instance const parameter also substituted into the METHOD
  # BODY (the symbolic SCALE value read lowers once and is substituted per
  # instance — the two instances coexist in one program).
  if a2.scale() != 2 then
    return 5
  end
  if b4.scale() != 4 then
    return 6
  end
  if z4.scale() != 4 then
    return 7
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_const_generic_assoc_call: FAIL " + ok.to_string())
    1
  end
end
