use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def check_consume() -> Bool
  let r = R { a: 1 }
  consume_r(r)
  true
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_consume() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] consume")
  end

  println("canary_access_sink: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
