# Positive canary: Map cleanup is destructive and per-entry — each live value
# is finalized exactly once; a resource KEY is finalized exactly once too.
use std::core
use std::collections

static mut value_count: Int = 0
static mut key_count: Int = 0

resource Key
  id: Int
  def deinit(sink self: Self) -> Unit
    key_count = key_count + 1
  end
end

resource Value
  id: Int
  def deinit(sink self: Self) -> Unit
    value_count = value_count + 1
  end
end

def main() -> Int
  let mut m: Map[Key, Value] = Map::new()
  let k1 = Key { id: 1 }
  let v1 = Value { id: 2 }
  let k2 = Key { id: 3 }
  let v2 = Value { id: 4 }
  m.insert(k1, v1)
  m.insert(k2, v2)
  if key_count == 2 && value_count == 2 then
    0
  else
    println("canary_pos_resource_map_cleanup: FAIL keys=" + key_count.to_string() + " values=" + value_count.to_string())
    1
  end
end
