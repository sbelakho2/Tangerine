# Positive canary (audit item 50(a)): [Option::None; 100] — a QUALIFIED
# payload-less enum variant value repeated one hundred times. The slot type
# Option[String] owns resources, but the repeated image is the TAG WORD (a
# None slot's payload area is never read and the slot's drop glue is
# tag-trivial), so the fill is legal under ANY element type — the
# Copy-element rule's compiler-recognized zero-payload exception. The slots
# are never read out (Option[String] is not Copy); the scope-exit drop of
# the arrays runs the array drop glue, whose every slot drop is
# tag-trivial.
use std::core

def repeat_none_run() -> Int
  let a: [Option[String]; 100] = [Option::None; 100]
  let b: [Option[String]; 1] = [Option::None; 1]
  let c: [Option[String]; 0] = [Option::None; 0]
  # len() on a fixed array is the compile-time constant carried in the type
  # (never a payload read); the runtime exercise here is the fill itself
  # and the tag-trivial scope-exit drop of every None slot.
  let total = a.len() + b.len() + c.len()
  if total != 101 then
    return 1
  end
  0
end

def main() -> Int
  let ok = repeat_none_run()
  if ok == 0 then
    0
  else
    println("canary_pos_repeat_option_none_100: FAIL " + ok.to_string())
    1
  end
end
