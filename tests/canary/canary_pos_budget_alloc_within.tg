# Positive budget canary: the @budget ALLOCATION metric, WITHIN the
# declared limit. budgeted() annotates `alloc: "8"` and performs two
# intrinsic allocations in its body (the classified builtin-container
# method calls — ArrayPush — each pushes the __tg_budget_alloc
# consumed-units counter up by one; the counter stays under the limit, so
# no trap fires). The canary RUNS the real enforcement path: the
# __tg_budget_alloc data slot is defined (emit_budget_runtime_data), the
# lowering emitted the MirBudgetConsume statements, and the codegen arms
# execute the increment + limit check at runtime — exit 0 is required.
def budgeted() -> Int @budget alloc: "8"
  let v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  0
end

def main() -> Int
  budgeted()
end
