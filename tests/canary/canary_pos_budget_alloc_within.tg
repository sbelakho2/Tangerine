# Positive budget canary: the @budget ALLOCATION metric, WITHIN the
# declared limit. budgeted() annotates `alloc: "8"` and performs two
# intrinsic allocations in its body (the classified builtin-container
# method calls — ArrayPush — each increments THIS invocation's frame-slot
# counter — FrameInfo.budget_alloc_offset, reserved by allocate_locals
# and zeroed by the prologue — by one; the counter stays under the limit,
# so no trap fires). The canary RUNS the real enforcement path: the
# lowering emitted the MirBudgetConsume statements, and the codegen arms
# execute the frame-slot increment + limit check at runtime — exit 0 is
# required.
def budgeted() -> Int @budget alloc: "8"
  let v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  0
end

def main() -> Int
  budgeted()
end
