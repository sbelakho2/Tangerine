# Positive DMA-ownership canary (audit item 16, next tier): the canonical
# std::embedded DMA ownership surface is accepted in its sanctioned
# lifecycle — dma_pin_read (the engine owns the buffer: the resource
# checker records pinned-read) -> dma_await (completion: ownership returns
# — the place moves to the `returns` state, so CPU access is legal again)
# -> CPU write on the returned buffer -> dma_unpin (release — not-pinned)
# -> ordinary CPU use. The host runtime stubs make the calls executable; the
# compile-time ownership rule is the artifact this canary pins by
# ACCEPTANCE (the negative canaries pin each rejection).
use std::core
use std::embedded::{dma_pin_read, dma_await, dma_unpin}

def dma_lifecycle() -> Int
  var buf: [u8; 16] = [0u8; 16]
  let pin = dma_pin_read(buf)
  dma_await(buf)
  buf[0] = 7
  dma_unpin(buf)
  buf[1] = 9
  pin.raw() as Int
end

def main() -> Int
  if dma_lifecycle() != 0 then
    return 1
  end
  0
end
