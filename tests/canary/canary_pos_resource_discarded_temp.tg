# Positive canary: discarded resource-typed call results are cleaned by the
# full-expression temporary cleanup — `m.insert(...)` and `m.remove(...)`
# as statements return Option[Value] that is dropped (never duplicated,
# never leaked).
use std::core
use std::collections

resource Value
  v: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

static mut deinit_count: Int = 0

def main() -> Int
  let m = Map[String, Value]::new()
  m.insert("a", Value { v: 1 })
  m.insert("b", Value { v: 2 })
  let replaced = m.insert("a", Value { v: 3 })
  m.remove("a")
  # replaced (an Option holding the previous value for "a") is bound here,
  # so it is finalized at scope end like any owned local; the discarded
  # insert/remove results are cleaned at their statement ends.
  if replaced.is_some() then 0 else 1 end
end
