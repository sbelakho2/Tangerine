# Positive scoped-access canary (audit §12): two simultaneous READ
# accesses to one place coexist (read+read is allowed), reading through
# an owning String element access works without moving the value, and an
# early return from an `as inout` with-block over an OWNING place source
# is sound (the zero-copy address binding has no write-back to skip — the
# access ends before the exit edge's cleanup).
use std::core

struct Doc
  title: String
  qty: Int
end

def read_len(s: String) -> Int
  s.len()
end

def check_two_simultaneous_reads() -> Bool
  mut d = Doc { title: "hello" + "", qty: 3 }
  with d.title as let a
    with d.title as let b
      if read_len(a) != 5 then
        return false
      end
      if read_len(b) != 5 then
        return false
      end
    end
  end
  true
end

def check_read_access_no_move() -> Bool
  mut d = Doc { title: "world" + "", qty: 3 }
  with d.title as let s
    if read_len(s) != 5 then
      return false
    end
  end
  with d.title as let check
    read_len(check) == 5
  end
end

def check_early_return_inout() -> Bool
  mut d = Doc { title: "abc" + "", qty: 7 }
  with d.title as inout t
    t.push('!')
    if d.qty > 5 then
      return t.len() == 4
    end
  end
  true
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_two_simultaneous_reads() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] two_simultaneous_reads")
  end

  if check_read_access_no_move() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] read_access_no_move")
  end

  if check_early_return_inout() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] early_return_inout")
  end

  println("canary_pos_scoped_access_nested_reads: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
