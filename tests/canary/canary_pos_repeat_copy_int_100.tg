# Positive canary (audit item 50(a)): [1; 100] — a SCALAR element (Int,
# Copy) repeated one hundred times is accepted by the checker's
# repeat-element gate (the Rust-style Copy rule) and the fixed-array fill
# stores the element image into every slot.
use std::core

def repeat_run() -> Int
  let a = [1; 100]
  if a[0] != 1 then
    return 1
  end
  if a[50] != 1 then
    return 2
  end
  if a[99] != 1 then
    return 3
  end
  let b = [7; 1]
  if b[0] != 7 then
    return 4
  end
  0
end

def main() -> Int
  let ok = repeat_run()
  if ok == 0 then
    0
  else
    println("canary_pos_repeat_copy_int_100: FAIL " + ok.to_string())
    1
  end
end
