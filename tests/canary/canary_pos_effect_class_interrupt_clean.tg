# Positive effect-class canary (audit item 42): a plain @interrupt
# handler whose body has no effects satisfies the interrupt-context
# proof — the marker's compile-time claim (no allocation, no blocking,
# no sleep, no uncontrolled I/O, no reentrancy) holds over an empty
# body, so the annotated handler compiles and the program runs
# (main returns 0).
use std::core

@interrupt
def tick_isr() -> Unit
end

def main() -> Int
  0
end
