# Positive canary: Set[String] iteration and set algebra — the clone-aware
# traversal (iter/entries_cloned) yields owned String elements, and
# union/intersection/difference/subset build new sets from cloned elements.
# Iteration is driven with the explicit SetIterator.advance() loop (the
# for-in form is restricted to Slice/Array/String/Vec/Map receivers).
use std::core
use std::collections

def run() -> Int
  let mut s = Set[String]::new()
  s.insert("x")
  s.insert("y")
  s.insert("z")
  let mut t = Set[String]::new()
  t.insert("z")
  t.insert("w")
  let u = s.union(t)
  if u.len() != 4 then
    return 1
  end
  let w = "w".to_string()
  if !u.contains(&w) then
    return 2
  end
  let inter = s.intersection(t)
  if inter.len() != 1 then
    return 3
  end
  let z = "z".to_string()
  if !inter.contains(&z) then
    return 4
  end
  let diff = s.difference(t)
  if diff.len() != 2 then
    return 5
  end
  if !s.is_subset(u) then
    return 6
  end
  if !u.is_superset(s) then
    return 7
  end
  let mut it = s.iter()
  var count = 0
  loop
    match it.advance()
    when Option::Some(item) then
      if item.len() != 1 then
        return 8
      end
      count = count + 1
    when Option::None then break
    end
  end
  if count != 3 then
    return 9
  end
  # entries_cloned on the set — the same clone-aware traversal.
  let elems = s.entries_cloned()
  if elems.len() != 3 then
    return 10
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_set_string_iter_union: FAIL " + ok.to_string())
    1
  end
end
