use std::core

resource R
  a: Int
end

def init_r(set r: R) -> Unit
  r = R { a: 1 }
end

# The read-after-set boundary: reading a set parameter AFTER the
# assignment is the closest accepted program to the read-before-set
# rejection (canary_neg_access_set_read_before.tg) — the set
# initializes the caller's buffer, the read consumes the Live state.
def read_after_set(set r: R) -> Int
  r = R { a: 2 }
  r.a
end

def run() -> Int
  println("canary_access_set: init + read-after-set OK")
  0
end

def main() -> Int
  run()
end
