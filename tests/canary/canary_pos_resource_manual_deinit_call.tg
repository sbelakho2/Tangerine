# Positive canary: an EXPLICIT manual o.deinit() call — the deinit special
# path itself, not sink-parameter finalization. The user finalizer runs
# exactly once; the compiler-owned structural field cleanup runs the inner
# resource's deinit exactly once (the o.deinit() call path in MIR).
use std::core

static mut outer_deinit_count: Int = 0
static mut inner_deinit_count: Int = 0

resource Inner
  x: Int
  def deinit(sink self: Self) -> Unit
    inner_deinit_count = inner_deinit_count + 1
  end
end

resource Outer
  inner: Inner
  tag: Int
  def deinit(sink self: Self) -> Unit
    outer_deinit_count = outer_deinit_count + 1
  end
end

def main() -> Int
  let o = Outer { inner: Inner { x: 1 }, tag: 5 }
  o.deinit()
  if outer_deinit_count == 1 && inner_deinit_count == 1 then
    0
  else
    println("canary_pos_resource_manual_deinit_call: FAIL outer=" + outer_deinit_count.to_string() + " inner=" + inner_deinit_count.to_string())
    1
  end
end
