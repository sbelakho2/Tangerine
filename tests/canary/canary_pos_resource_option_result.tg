# Positive canary: Option[Probe] and Result[Probe, String] destruction —
# discriminant-driven cleanup runs the payload's finalizer exactly once.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def use_option() -> Int
  do
    let p: Option[Probe] = Option::Some(Probe { id: 1 })
    if p.is_some() then 1 else 0 end
  end
  deinit_count
end

def use_result() -> Int
  do
    let r: Result[Probe, String] = Result::Ok(Probe { id: 2 })
    if r.is_ok() then 1 else 0 end
  end
  deinit_count
end

def main() -> Int
  let o = use_option()
  let r = use_result()
  if o == 1 && r == 2 && deinit_count == 2 then
    0
  else
    println("canary_pos_resource_option_result: FAIL o=" + o.to_string() + " r=" + r.to_string() + " deinit_count=" + deinit_count.to_string())
    1
  end
end
