# Positive canary: x86-64 REGISTER-ALLOCATION POLICY under real pressure.
#
# The allocator may only keep locals in CALLEE-SAVED registers (it has no
# call-crossing save pass), so spill behavior, call-argument preservation
# and ABI alignment are bootstrap-critical.  These checks pin:
#   * 4/5/6/8/12/16 live integers across an inner call (no-spill boundary,
#     first spill, multiple spills);
#   * nested-call argument preservation (a first argument materialized
#     before an inner call must not be clobbered by that call);
#   * reload after a spill victim is itself spilled;
#   * recursion with several values live across the recursive edge;
#   * callee-saved pressure at 1..5 registers with prologue/epilogue
#     symmetry;
#   * the MXCSR float prologue interacting with integer frames and nested
#     calls (the 8-byte `push imm32` / `add rsp,8` correction).
#
# Every failure returns a distinct nonzero code.

def inner(x: Int) -> Int
  x + 1
end

def add3(a: Int, b: Int, c: Int) -> Int
  a + b + c
end

def four_live() -> Int
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = inner(10)
  a + b + c + d + e
end

def five_live() -> Int
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = inner(0)
  a + b + c + d + e + f
end

def six_live() -> Int
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = 6
  let g = inner(1)
  a + b + c + d + e + f + g
end

def eight_live() -> Int
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = 6
  let g = 7
  let h = 8
  let i = inner(2)
  a + b + c + d + e + f + g + h + i
end

def twelve_live() -> Int
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = 6
  let g = 7
  let h = 8
  let i = 9
  let j = 10
  let k = 11
  let l = 12
  let m = inner(3)
  a + b + c + d + e + f + g + h + i + j + k + l + m
end

def spill_reload() -> Int
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let f = 6
  let g = 7
  let h = 8
  let i = 9
  let j = 10
  let k = 11
  let l = 12
  let m = 13
  let n = 14
  let o = 15
  let p = 16
  let q = inner(0)
  let r = inner(q)
  a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q * 10 + r * 100
end

def nested_args() -> Int
  let a = 3
  let b = 5
  let c = 7
  let d = 11
  let e = 13
  let f = add3(inner(100), inner(200), a + b + c + d + e)
  f + a + b + c + d + e
end

def rec_keep(n: Int) -> Int
  let a = 1
  let b = 2
  if n <= 0 then
    a + b
  else
    a + b + rec_keep(n - 1)
  end
end

def pressure1() -> Int
  let a = 1
  let z = inner(9)
  a + z
end

def pressure2() -> Int
  let a = 1
  let b = 2
  let z = inner(9)
  a + b + z
end

def pressure3() -> Int
  let a = 1
  let b = 2
  let c = 3
  let z = inner(9)
  a + b + c + z
end

def pressure4() -> Int
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let z = inner(9)
  a + b + c + d + z
end

def pressure5() -> Int
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let z = inner(9)
  a + b + c + d + e + z
end

def fp_double(x: Float) -> Float
  x * 2.0
end

def fp_path() -> Bool
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let e = 5
  let p = fp_double(1.5) + fp_double(0.5)
  let q = fp_double(3.5)
  a + b + c + d + e == 15 && p == 4.0 && q == 7.0
end

def main() -> Int
  if four_live() != 21 then return 1 end
  if five_live() != 16 then return 2 end
  if six_live() != 23 then return 3 end
  if eight_live() != 39 then return 4 end
  if twelve_live() != 82 then return 5 end
  if nested_args() != 380 then return 6 end
  if spill_reload() != 346 then return 7 end
  if rec_keep(5) != 18 then return 8 end
  if pressure1() != 11 then return 9 end
  if pressure2() != 13 then return 10 end
  if pressure3() != 16 then return 11 end
  if pressure4() != 20 then return 12 end
  if pressure5() != 25 then return 13 end
  if !fp_path() then return 14 end
  0
end
