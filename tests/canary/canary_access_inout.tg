use std::core

struct P
  a: Int
  b: Int
end

def inc(inout x: Int) -> Int
  x + 1
end

def add_fields(inout a: Int, inout b: Int) -> Int
  a + b
end

def check_single_mut() -> Bool
  mut x = 0
  inc(x) == 1
end

def check_disjoint_fields_mut() -> Bool
  mut p = P { a: 1, b: 2 }
  add_fields(p.a, p.b) == 3
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_single_mut() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] single_mut")
  end

  if check_disjoint_fields_mut() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] disjoint_fields_mut")
  end

  println("canary_access_inout: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
