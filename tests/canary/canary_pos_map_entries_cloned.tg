# Positive canary: Map[String, String] entries_cloned — the clone-aware
# traversal materializes an owned (K, V) snapshot in which every key and
# value is an explicit clone out of the LIVE hash-table slots (never the
# raw byte-copy image intrinsic). The snapshot is independent of later
# mutations of the map, and the cloned pairs are genuinely owned.
use std::core
use std::collections

def run() -> Int
  let mut m = Map[String, String]::new()
  m.insert("a", "1")
  m.insert("b", "2")
  m.insert("c", "3")
  let pairs = m.entries_cloned()
  if pairs.len() != 3 then
    return 1
  end
  var seen = 0
  for (k, v) in pairs do
    if k == "a" && v == "1" then
      seen = seen + 1
    elsif k == "b" && v == "2" then
      seen = seen + 1
    elsif k == "c" && v == "3" then
      seen = seen + 1
    end
  end
  if seen != 3 then
    return 2
  end
  # The snapshot is a detached copy: a later mutation of the live map must
  # not change the already-materialized pairs.
  m.insert("d", "4")
  if pairs.len() != 3 then
    return 3
  end
  if m.len() != 4 then
    return 4
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_map_entries_cloned: FAIL " + ok.to_string())
    1
  end
end
