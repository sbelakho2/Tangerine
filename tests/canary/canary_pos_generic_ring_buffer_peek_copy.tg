# Positive canary: a GENERIC caller with a `[T: Copy]` bound CAN call
# peek_front. Method resolution consults the inherent impl's bounds, and the
# caller's generic context (env.param_bounds — the generic-scope bound
# registry) proves T: Copy, so `impl[T: Copy] RingBuffer[T]` is applicable:
# the by-value projected read resolves and returns Option[T]. The generic
# path with the Copy bound passes exactly where the unconstrained generic
# path (canary_neg_generic_ring_buffer_peek_unbounded) is closed.
use std::core
use std::collections

def peek_copy[T: Copy](rb: RingBuffer[T]) -> Option[T]
  rb.peek_front()
end

def main() -> Int
  let mut rb: RingBuffer[Int] = RingBuffer::new(4)
  rb.push_back(42)
  match peek_copy(&rb)
  when Option::Some(v) then
    if v == 42 then 0 else 1 end
  when Option::None then
    1
  end
end
