# Positive canary: needs_drop is VIRAL through ordinary Value aggregates —
# Wrapper { values: Vec[Int] } inherits destruction requirements from its
# field even though neither the nominal kind nor a name list says so.
use std::core
use std::collections

struct Wrapper
  values: Vec[Int]
end

def use_wrapper() -> Int
  do
    let w = Wrapper { values: Vec[Int]::new() }
    w.values.push(1)
    w.values.push(2)
  end
  0
end

def main() -> Int
  let ok = use_wrapper()
  if ok == 0 then
    0
  else
    println("canary_pos_wrapper_viral_destroy: FAIL")
    1
  end
end
