# Positive canary: an UNCONSTRAINED generic parameter T instantiated with a
# resource — the sink parameter's drop is decided at the CONCRETE instance
# (T=Probe carries its deinit; T=Int is trivial), and the deferred T
# position in the template never fabricates a destructor. The two
# instances run the same generic body; the resource instance's drop runs
# exactly once.
use std::core

static mut probe_drops: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_drops = probe_drops + 1
  end
end

def pass_through[T](sink x: T) -> Int
  0
end

def run() -> Int
  let a = pass_through(5)
  let b = pass_through(Probe { id: 7 })
  if a != 0 || b != 0 then
    return 1
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_drops == 1 then
    0
  else
    println("canary_pos_generic_unconstrained_resource: FAIL probe_drops=" + probe_drops.to_string())
    1
  end
end
