# Positive budget canary — the PER-INVOCATION allocation counter: a
# budgeted function called TWICE. Each invocation's counter lives in its
# own STACK FRAME slot (FrameInfo.budget_alloc_offset — reserved by
# allocate_locals, zeroed by the prologue), so `step()`'s single
# allocation stays within its `alloc: "1"` limit on every call. Under the
# old global counter the two calls would share one counter and the second
# call would trap — the frame-slot semantics are the fix. Exit 0 required.
def step() -> Int @budget alloc: "1"
  let v = Vec[Int]::new()
  v.push(1)
  0
end

def main() -> Int
  let a = step()
  let b = step()
  a + b
end
