# Positive canary: a while loop whose condition is false BEFORE the first
# iteration executes ZERO finalizers — the exit edge must never clean body
# locals that were never initialized.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def main() -> Int
  var i = 0
  while i < 0 do
    let p = Probe { id: i }
    i = i + 1
  end
  if deinit_count == 0 then
    0
  else
    println("canary_pos_resource_while_zero_iter: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
