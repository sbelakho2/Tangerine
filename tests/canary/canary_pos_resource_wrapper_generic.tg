# Positive canary: a generic resource wrapper must clean its field only when
# the concrete argument is a resource (Wrapper[Int] trivial; Wrapper[Probe]
# finalizes the field exactly once). Factory functions carry the concrete
# type args through their result types.
use std::core

static mut deinit_count: Int = 0

resource Wrapper[T]
  item: T
end

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def make_wi() -> Wrapper[Int]
  Wrapper[Int] { item: 5 }
end

def make_wp() -> Wrapper[Probe]
  Wrapper[Probe] { item: Probe { id: 2 } }
end

def do_test() -> Unit
  let wi = make_wi()
  let wp = make_wp()
end

def main() -> Int
  do_test()
  if deinit_count == 1 then
    0
  else
    println("canary_pos_resource_wrapper: FAIL count=" + deinit_count.to_string())
    1
  end
end
