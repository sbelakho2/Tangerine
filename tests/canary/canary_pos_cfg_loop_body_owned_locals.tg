# The loop body's owned locals: each iteration creates the owned values;
# the per-iteration cleanup drops them at the backedge; the loop-exit
# cleanup handles the final iteration's locals.
def main() -> Int
  var total = 0
  var i = 0
  while i < 4 do
    let buf = Vec::with_capacity(8)
    let _ = buf.len()
    let msg = "owned".to_string()
    total = total + msg.len()
    i = i + 1
  end
  return total
end
