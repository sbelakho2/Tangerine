# Positive canary (audit: replace_fixed_array_constant_element): the
# fixed-array element replacement at a constant index is the exact-place
# replacement — `items[0] = ...` destroys only the old element 0; the
# sibling elements stay live and readable after the store. Deinit
# counts: old items[0] at the replacement; the new items[0], items[1]
# and items[2] at the scope exit — exactly 4 deinitializations.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

def run() -> Int
  let mut items = [Probe { id: 1 }, Probe { id: 2 }, Probe { id: 3 }]
  items[0] = Probe { id: 4 }
  # the sibling elements survived the replacement — still live
  if items[0].id == 4 && items[1].id == 2 && items[2].id == 3 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 4 then
    0
  else
    println("canary_pos_replace_fixed_array_constant_element: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
