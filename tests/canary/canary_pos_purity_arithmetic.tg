# Positive purity canary (third-audit item 25): a `pure` declaration over
# arithmetic with INTERIOR LOCAL mutation — the compiler's purity theorem
# proves ProvenPure (arithmetic is an intrinsic/rvalue operation and the
# local stores cannot escape the call), so the E0234 enforcement accepts
# the annotation and the function runs.
pure def scale(n: Int) -> Int
  mut acc = n * 2
  acc = acc + 3
  acc
end

def main() -> Int
  if scale(4) == 11 then
    0
  else
    1
  end
end
