# A loop inside a match arm: the arm's loop-join records coexist with the
# match-join; the arm body's owned locals drop at the arm's scope exit.
def main() -> Int
  let mode = 1
  var total = 0
  match mode
  when 0 then total = 1
  when 1 then
    var i = 0
    while i < 3 do
      let s = "arm".to_string()
      total = total + s.len()
      i = i + 1
    end
  when _ then total = 9
  end
  return total
end
