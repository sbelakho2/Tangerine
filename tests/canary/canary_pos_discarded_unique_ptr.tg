# Positive canary: a DISCARDED UniquePtr expression is an owning temporary —
# the full-expression cleanup uses the canonical ownership predicate and
# runs the registered UniquePtr__drop (payload drop observable).
use std::core
use std::alloc

static mut payload_drops: Int = 0

struct Payload
  id: Int
end

impl Drop for Payload
  def drop(self: &mut Payload) -> Unit
    payload_drops = payload_drops + 1
  end
end

def main() -> Int
  unique_ptr_new(Payload { id: 1 })
  if payload_drops == 1 then
    0
  else
    println("canary_pos_discarded_unique_ptr: FAIL payload_drops=" + payload_drops.to_string())
    1
  end
end
