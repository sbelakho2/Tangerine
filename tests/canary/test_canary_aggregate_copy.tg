# tests/canary/test_canary_aggregate_copy.tg
# Native canary: structural copy/clone integrity for aggregates and enum
# payloads, especially structures resembling compiler data (MirFunction with
# consecutive Bool fields mixed with larger values).
#
# Failure class: MEMORY_SAFETY / CODE_GEN_BUG (aggregate copy/clone corruption)

use std::core

# MirFunction-like structure: many consecutive Bool fields + various sizes.
struct FuncLike
  name: String
  params: Int
  ret_type: Int
  locals: Int
  blocks: Int
  entry_block: Int
  is_async: Bool
  is_unsafe: Bool
  is_extern: Bool
  extern_abi: Int
  contracts: Int
  span: Int
end

def make_func() -> FuncLike
  FuncLike {
    span: 900,
    contracts: 7,
    extern_abi: 5,
    is_extern: true,
    is_unsafe: true,
    is_async: false,
    entry_block: 100,
    blocks: 50,
    locals: 40,
    ret_type: 3,
    params: 2,
    name: "clone_me"
  }
end

def check_func(f: &FuncLike) -> Bool
  f.name == "clone_me" && f.params == 2 && f.ret_type == 3 && f.locals == 40 &&
  f.blocks == 50 && f.entry_block == 100 && f.is_async == false &&
  f.is_unsafe == true && f.is_extern == true && f.extern_abi == 5 &&
  f.contracts == 7 && f.span == 900
end

enum Payload
  Int(Int)
  Str(String)
  Pair(Int, Bool)
  None
end

struct Item
  id: Int
  tag: Payload
  flag: Bool
end

struct Inner
  x: Int
  y: Bool
end

struct Outer
  a: Int
  inner: Inner
  b: Int
end

# AstPath-shaped structure: a path with String segments, used by the compiler
# in TypeExprKind::Path / PatternKind::Variant payloads.
struct PathLike
  segments: Vec[String]
end

enum PathPayload
  TypePath(PathLike)
  Value(Int)
  None
end

def make_path() -> PathLike
  mut segs: Vec[String] = Vec::new()
  segs.push("std")
  segs.push("collections")
  segs.push("Vec")
  PathLike { segments: segs }
end

def check_path(p: &PathLike) -> Bool
  p.segments.len() == 3 &&
  p.segments[0] == "std" &&
  p.segments[1] == "collections" &&
  p.segments[2] == "Vec"
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  # Whole MirFunction-like struct COPY: assign the source to a new binding,
  # then mutate the source and verify the copy retains every original value.
  mut src = make_func()
  let copied = src
  src.is_extern = false
  src.is_async = true
  src.span = 123
  src.name = "mutated"
  if check_func(&copied) then
    passed = passed + 1
    println("[PASS] funclike_copy")
  else
    failed = failed + 1
    println("[FAIL] funclike_copy")
  end

  # Mutate source after construction: the separate binding must not be affected.
  let tgt = make_func()
  if check_func(&tgt) then
    passed = passed + 1
    println("[PASS] funclike_independent")
  else
    failed = failed + 1
    println("[FAIL] funclike_independent")
  end

  # Enum payload copy (Int)
  let e1 = Payload::Int(-123456789)
  match e1
  when Payload::Int(v) then
    if v == -123456789 then
      passed = passed + 1
    else
      failed = failed + 1
      println("[FAIL] enum_int_payload")
    end
  when _ then
    failed = failed + 1
    println("[FAIL] enum_int_payload")
  end

  # Enum payload copy (Pair)
  let e2 = Payload::Pair(42, true)
  match e2
  when Payload::Pair(a, b) then
    if a == 42 && b == true then
      passed = passed + 1
    else
      failed = failed + 1
      println("[FAIL] enum_pair_payload")
    end
  when _ then
    failed = failed + 1
    println("[FAIL] enum_pair_payload")
  end

  # Struct containing enum payload + Bool
  let it1 = Item { id: 77, tag: Payload::Str("hello"), flag: true }
  let it2 = it1
  if it2.id == 77 && it2.flag == true then
    match it2.tag
    when Payload::Str(s) then
      if s == "hello" then
        passed = passed + 1
      else
        failed = failed + 1
        println("[FAIL] item_copy_str")
      end
    when _ then
      failed = failed + 1
      println("[FAIL] item_copy_str")
    end
  else
    failed = failed + 1
    println("[FAIL] item_copy_fields")
  end

  # Nested struct clone
  let o = Outer { a: 1, inner: Inner { x: 2, y: true }, b: 3 }
  let oc = o
  if oc.a == 1 && oc.inner.x == 2 && oc.inner.y == true && oc.b == 3 then
    passed = passed + 1
    println("[PASS] nested_clone")
  else
    failed = failed + 1
    println("[FAIL] nested_clone")
  end

  # AstPath-shaped: construction, copy, clone-in-enum, pass/return by value.
  let p1 = make_path()
  if check_path(&p1) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] path_construct")
  end

  let p2 = p1
  if check_path(&p2) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] path_copy")
  end

  # Path nested in an enum payload, copied out and verified.
  let pe = PathPayload::TypePath(p1)
  match pe
  when PathPayload::TypePath(inner_path) then
    if check_path(&inner_path) then
      passed = passed + 1
    else
      failed = failed + 1
      println("[FAIL] path_enum_payload")
    end
  when _ then
    failed = failed + 1
    println("[FAIL] path_enum_payload")
  end

  # Pass by value into a helper and return by value.
  let p3 = check_path_by_value(p1)
  if p3 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] path_pass_by_value")
  end

  let p4 = identity_path(p1)
  if check_path(&p4) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] path_return_by_value")
  end

  println("canary_aggregate_copy: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def check_path_by_value(p: PathLike) -> Bool
  check_path(&p)
end

def identity_path(p: PathLike) -> PathLike
  p
end

def main() -> Int
  run()
end
