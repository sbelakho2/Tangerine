# tests/canary/test_canary_nested_map_receiver.tg
# Native canary: a struct whose field is a Map, mutated through a
# &mut self receiver method (nested map receiver). Verifies that
# (1) a method can mutate a nested Map field in place, and
# (2) lookups through the nested map receiver see the mutations.
#
# Failure class: MIR_PLACE_PROJECTION_BUG / COLLECTION_BUG

use std::core

struct Counter
  totals: Map[String, Int]
end

impl Counter
  def new() -> Counter
    Counter { totals: Map::new() }
  end

  def bump(&mut self, key: String, delta: Int) -> Unit
    let cur = match self.totals.get(&key)
    when Option::Some(v) then v
    when Option::None then 0
    end
    self.totals.insert(key, cur + delta)
  end

  def total(&self, key: String) -> Int
    match self.totals.get(&key)
    when Option::Some(v) then v
    when Option::None then 0
    end
  end

  def size(&self) -> Int
    self.totals.len()
  end
end

def check_nested_receiver() -> Bool
  mut c = Counter::new()
  c.bump("alpha", 5)
  c.bump("alpha", 3)
  c.bump("beta", 2)
  c.total("alpha") == 8 && c.total("beta") == 2 && c.size() == 2
end

def check_receiver_isolated() -> Bool
  mut a = Counter::new()
  mut b = Counter::new()
  a.bump("x", 1)
  b.bump("x", 100)
  a.total("x") == 1 && b.total("x") == 100
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_nested_receiver() then
    passed = passed + 1
    println("[PASS] nested_map_receiver")
  else
    failed = failed + 1
    println("[FAIL] nested_map_receiver")
  end

  if check_receiver_isolated() then
    passed = passed + 1
    println("[PASS] receiver_isolation")
  else
    failed = failed + 1
    println("[FAIL] receiver_isolation")
  end

  println("canary_nested_map_receiver: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
