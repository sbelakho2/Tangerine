use std::core

resource R
  a: Int
  def use(&self) -> Int
    self.a
  end
  def deinit(sink x: Int) -> Unit
  end
end

def make_r() -> R
  R { a: 7 }
end

def check_method() -> Bool
  let r = make_r()
  r.use() == 7
end

def run() -> Int
  if check_method() then
    println("canary_resource_method: OK")
    0
  else
    println("canary_resource_method: FAIL")
    1
  end
end

def main() -> Int
  run()
end
