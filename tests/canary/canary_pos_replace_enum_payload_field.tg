# Positive canary (audit: replace_enum_payload_field / the masked
# whole-root replace): an enum value's OWNING payload position is the
# whole-value boundary in the native lane (the seed-MIR lattice tracks
# the Downcast payload chain exactly — see the tg_placechain (m) row);
# the source-level replacement of the payload of a LIVE enum value is
# the whole-value masked replace: the old payload's own values drop
# exactly once at the store (the payload-position replacement), and the
# new payload's values finalize at the scope exit. Deinit counts: the
# old payload's two Probe values at the replacement; the new payload's
# two Probe values at the scope exit — exactly 4, no double drop.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Inner
  a: Probe
  b: Probe
end

enum E
  A(Inner)
end

def run() -> Int
  do
    let mut e: E = E::A(Inner { a: Probe { id: 1 }, b: Probe { id: 2 } })
    # the live payload position is replaced: the old payload's values
    # drop at the store (masked whole-value replace)
    e = E::A(Inner { a: Probe { id: 3 }, b: Probe { id: 4 } })
    match e
    when E::A(inner) then
      # the by-value payload binding reads the new payload; the payload's
      # values finalize at the match-arm scope exit
      if inner.a.id == 3 && inner.b.id == 4 then 0 else 1 end
    end
  end
  probe_deinit_count
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 4 then
    0
  else
    println("canary_pos_replace_enum_payload_field: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
