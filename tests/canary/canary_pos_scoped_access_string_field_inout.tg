# Positive scoped-access canary (audit §12): `with <place> as inout NAME`
# over an OWNING String field binds ZERO-COPY through the field's storage
# (the ScopedPlaceAccess model — no snapshot, no write-back, no clone):
# the inout body's mutations (String::push — an inout-self receiver on the
# access name, which crosses as the field's address) modify the SAME
# underlying value the struct owns, so the field's content changes in
# place and stays visible after the block.
use std::core

struct Doc
  title: String
  qty: Int
end

def read_len(s: String) -> Int
  s.len()
end

def check_string_field_inout() -> Bool
  mut d = Doc { title: "hello" + "", qty: 0 }
  let orig_len = read_len(d.title)
  with d.title as inout t
    t.push('!')
    t.push('!')
  end
  with d.title as let check
    read_len(check) == orig_len + 2
  end
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_string_field_inout() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] string_field_inout")
  end

  println("canary_pos_scoped_access_string_field_inout: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
