# Positive canary: a resource created inside a nested block that ENDS with a
# return is finalized EXACTLY ONCE — by the return edge. The block-exit
# obligation must not wrap the return chain a second time (drop p -> drop p).
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def nested_return(cond: Bool) -> Int
  if cond then
    let p = Probe { id: 1 }
    return 7
  end
  0
end

def main() -> Int
  let code = nested_return(true)
  if code == 7 && deinit_count == 1 then
    0
  else
    println("canary_pos_resource_nested_return: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
