use std::core

resource R
  a: Int
end

def make_r() -> R
  R { a: 9 }
end

def pass_r(r: sink R) -> R
  return r
end

def check_return_transfer() -> Bool
  let r = make_r()
  let r2 = pass_r(r)
  let r3 = make_r()
  r2.a == 9 && r3.a == 9
end

def run() -> Int
  if check_return_transfer() then
    println("canary_resource_return: OK")
    0
  else
    println("canary_resource_return: FAIL")
    1
  end
end

def main() -> Int
  run()
end
