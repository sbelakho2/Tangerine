# tests/canary/test_canary_borrowed_enum.tg
# Native canary: matching on a borrowed enum field.
#
# The compiler previously avoided `match &term.kind` in codegen_terminator
# because native codegen mis-derefs a reference to an already-borrowed enum
# field by one indirection level (garbage tag -> wrong arm). This canary
# exercises the ordinary source forms so that workaround can be removed:
#
#   match x.kind
#   match &x.kind
#   let r = &x.kind; match r
#   nested borrowed struct
#   enum field behind two borrows
#
# Failure class: MEMORY_SAFETY / CODE_GEN_BUG (borrowed enum mis-dereference)

use std::core

enum K
  A(Int)
  B(Int)
end

struct Wrapper
  kind: K
end

struct Outer2
  w: Wrapper
end

def inspect_value(x: &Wrapper) -> Int
  match x.kind
  when K::A(v) then v
  when K::B(v) then v
  end
end

def inspect_borrowed(x: &Wrapper) -> Int
  match &x.kind
  when K::A(v) then v
  when K::B(v) then v
  end
end

def inspect_let_borrowed(x: &Wrapper) -> Int
  let r = &x.kind
  match r
  when K::A(v) then v
  when K::B(v) then v
  end
end

def inspect_two_borrows(o: &Outer2) -> Int
  match &o.w.kind
  when K::A(v) then v
  when K::B(v) then v
  end
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  let w_a = Wrapper { kind: K::A(42) }
  let w_b = Wrapper { kind: K::B(-7) }

  if inspect_value(&w_a) == 42 && inspect_value(&w_b) == -7 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] match_value")
  end

  if inspect_borrowed(&w_a) == 42 && inspect_borrowed(&w_b) == -7 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] match_borrowed")
  end

  if inspect_let_borrowed(&w_a) == 42 && inspect_let_borrowed(&w_b) == -7 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] match_let_borrowed")
  end

  let o_a = Outer2 { w: Wrapper { kind: K::A(99) } }
  let o_b = Outer2 { w: Wrapper { kind: K::B(1234) } }
  if inspect_two_borrows(&o_a) == 99 && inspect_two_borrows(&o_b) == 1234 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] match_two_borrows")
  end

  println("canary_borrowed_enum: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
