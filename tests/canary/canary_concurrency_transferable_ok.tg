# Positive concurrency canary (reviewer items 28/35): the compiler-derived
# Transferable/Shareable properties accept the legal concurrency shapes —
# (e) Transferable values accepted: the scalar closures, the owned values
# moved by SINK into the thread closure, the Arc/Mutex/atomic-synchronized
# state shared through the recognized representations; (d-pos) the plain
# mutable struct (owned state, NOT Shareable) shared through Arc[Mutex] is
# accepted — the shared mutable state goes through the synchronized
# representation.
use std::core
use std::thread::{spawn, channel}
use std::sync::{Arc, Mutex}
use std::collections::Vec

struct Counter
  value: Vec[Int]   # owned state — Transferable, NOT Shareable
end

def main() -> Int
  mut passed = 0
  mut failed = 0

  # (e) a capture-free closure: the scalar result moves across threads.
  let h1 = spawn(|| 42)
  if h1.join().unwrap() == 42 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] scalar transfer")
  end

  # (e) an owned value moved by SINK into the thread closure (the
  # escaping ownership -> sink capture; the String is Transferable).
  let owned = "thread-owned".to_string()
  let h2 = spawn(|| { let len = owned.len(); drop(owned); len })
  if h2.join().unwrap() == 13 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] sink capture")
  end

  # (d-pos) the plain mutable struct shared through Arc[Mutex]: the
  # synchronized representation is accepted.
  let shared = Arc::new(Mutex::new(Counter { value: Vec::new() }))
  let shared2 = shared.clone()
  let h3 = spawn(|| {
    let mut guard = shared2.lock()
    let c = guard.get_mut()
    (*c).value.push(7)
    drop(guard)
  })
  h3.join()
  let guard = shared.lock()
  if (*guard.get()).value.len() == 1 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] Arc/Mutex share")
  end
  drop(guard)

  # (e) the channel endpoints move across threads (the Arc-synchronized
  # representation).
  let (tx, rx) = channel[Int]()
  let h4 = spawn(|| { let r = tx.send(42); drop(r) })
  h4.join()
  match rx.recv()
  when Result::Ok(v) then
    if v == 42 then
      passed = passed + 1
    else
      failed = failed + 1
      println("[FAIL] channel value")
    end
  when Result::Err(_) then
    failed = failed + 1
    println("[FAIL] channel recv")
  end

  println("canary_concurrency_transferable: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end
