# The loop body with the defer + the break/continue: the per-iteration
# defer chain runs at the backedge (the continue) and at the break exit.
def main() -> Int
  var total = 0
  for i in 0..5 do
    defer
      total = total + 100
    end
    if i % 2 == 0 then
      continue
    end
    total = total + i
  end
  return total
end
