# Positive canary: ordinary non-resource containers still receive
# destruction obligations — Vec[Int], Map[String, Int], and Set[Int] own
# heap backing storage and must release it (the destroy primitives are
# scheduled even though no element is a resource).
use std::core
use std::collections

def use_vec() -> Int
  do
    let v = Vec[Int]::new()
    v.push(1)
    v.push(2)
  end
  0
end

def use_map() -> Int
  do
    let mut m = Map[String, Int]::new()
    m.insert("a", 1)
  end
  0
end

def use_set() -> Int
  do
    let mut s = Set[Int]::new()
    s.insert(1)
  end
  0
end

def main() -> Int
  let a = use_vec()
  let b = use_map()
  let c = use_set()
  if a == 0 && b == 0 && c == 0 then
    0
  else
    println("canary_pos_container_destroy: FAIL")
    1
  end
end
