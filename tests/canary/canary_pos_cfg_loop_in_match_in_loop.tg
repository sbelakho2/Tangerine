# Positive canary — the NESTED CFG combination: a LOOP inside a MATCH
# ARM inside a LOOP. The arm's loop-join records coexist with the
# match-join and the outer loop's back-edge; every per-iteration
# resource is finalized exactly once by its innermost back-edge, and the
# outer loop's back-edge adds nothing. The instrumented counter proves
# 2 outer iterations x 2 inner iterations = exactly 4 destructor calls.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def main() -> Int
  var i = 0
  while i < 2 do
    let mode = 1
    match mode
    when 1 then
      var j = 0
      while j < 2 do
        let p = Probe { id: 100 + i * 10 + j }
        drop(p)
        j = j + 1
      end
    when _ then ()
    end
    i = i + 1
  end
  if deinit_count == 4 then
    0
  else
    println("canary_pos_cfg_loop_in_match_in_loop: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
