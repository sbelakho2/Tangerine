# Positive canary: a recursive type stays layout-finite through Box
# indirection — Node { next: Option[Box[Node]] } lays out because Box[Node]
# is a pointer-sized wrapper (its own Ptr[Node] field breaks the inline
# cycle), never because identity erases the wrapper.
use std::core
use std::alloc

struct Node
  value: Int
  next: Option[Box[Node]]
end

def make(n: Int) -> Node
  if n == 0 then
    Node { value: 0, next: Option::None }
  else
    Node { value: n, next: Option::Some(box_new(make(n - 1))) }
  end
end

def sum_list(sink node: Node) -> Int
  match node.next
  when Option::Some(b) then
    let inner = b.into_inner()
    node.value + sum_list(inner)
  when Option::None then node.value
  end
end

def main() -> Int
  let head = make(4)
  let total = sum_list(head)
  if total == 10 then 0 else 1 end
end
