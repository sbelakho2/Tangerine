# Positive effect/budget canary: the typed effect representation and the
# declared-budget typed record.
#   - effectful() declares `effect Io` and performs it (println — the
#     std's seeded Io effectful function): declared == computed;
#   - run() calls effectful() and declares the effect (the computed
#     transitive set matches the declared set);
#   - main() declares the effect it performs transitively;
#   - budgeted() carries the @budget annotation — the typed record (the
#     parsed limit "5ms" on the "time" metric) carried on the typed
#     function signature.
use std::io::{print, println}

def effectful() -> Int effect Io
  println("canary_pos_effect_declared: declared Io")
  0
end

def run() -> Int effect Io
  effectful()
end

def budgeted() -> Int @budget time <= "5ms"
  0
end

def main() -> Int effect Io
  run()
  budgeted()
end
