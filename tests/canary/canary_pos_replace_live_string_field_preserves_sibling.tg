# Positive canary (audit: replace_live_string_field_preserves_sibling):
# replacing a live OWNING String field is the exact-place replacement —
# the old value of s.a drops at the store, and the sibling s.b (an owning
# Probe) is NEVER destroyed by the replacement: it stays live, is read
# after the store, and finalizes exactly once at the scope exit.
# Deinit counts: s.b at the scope exit — exactly 1; the String values'
# drops are structural (silent).
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource S
  a: String
  b: Probe
end

def run() -> Int
  do
    let mut s = S { a: "first", b: Probe { id: 2 } }
    s.a = "second"
    # the sibling b was not consumed by the replacement — still live
    if s.a.len() == 6 && s.b.id == 2 then 0 else 1 end
  end
  probe_deinit_count
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 1 then
    0
  else
    println("canary_pos_replace_live_string_field_preserves_sibling: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
