# Positive canary: a sink resource parameter is owned by the callee — when
# the callee neither forwards nor consumes it, the callee must FINALIZE it.
# This is observable: the deinit runs exactly once (the caller transferred
# ownership; the callee's exit cleanup destroys the resource).
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def consume(sink r: Probe) -> Unit
  # r is finalized by the callee at exit — nothing to do here.
end

def main() -> Int
  let p = Probe { id: 1 }
  consume(p)
  if deinit_count == 1 then
    0
  else
    println("canary_pos_resource_sink_param: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
