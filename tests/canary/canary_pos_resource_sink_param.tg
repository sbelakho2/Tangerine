# Positive canary: a sink resource parameter is owned by the callee — when
# the callee neither forwards nor consumes it, the callee finalizes it
# (plan-driven cleanup). The caller has transferred ownership, so this
# must compile and run.
use std::core

resource File
  fd: Int
end

def consume(sink r: File) -> Unit
  # r is finalized by the callee at exit
end

def main() -> Int
  let f = File { fd: 1 }
  consume(f)
  0
end
