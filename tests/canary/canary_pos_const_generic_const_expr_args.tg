# Positive canary (§20 slice 2 — SYMBOLIC CONST-EXPRESSION type arguments):
# a const-generic type-argument slot whose expression ARITHMETICALLY
# COMBINES in-scope const generic parameters — `Pair[A + B, B + A]` in a
# generic method's parameter/return signature — resolves to the SYMBOLIC
# Type::ConstSym tree at the declaration and FOLDS per instance at the call:
# Pair[1, 2].widen(Pair[3, 3]) returns a Pair[3, 3] (A + B = B + A = 3),
# Pair[4, 6].widen(Pair[10, 10]) returns a Pair[10, 10] — TWO instances of
# ONE generic method whose symbolic type-argument arithmetic folded to the
# canonical value before any identity comparison, so the REVERSED spelling
# (B + A vs A + B) and the caller-side concrete spellings (literal `1 + 2`,
# module-const `FOUR + 6`) all land on the SAME Const. A method-level const
# parameter combines with the impl-level ones the same way
# (`rebase[S2]` -> Pair[A + S2, B - S2]), mirroring the std::math
# `Decimal128::mul_exact[const S2: Int]() -> Decimal128[SCALE + S2]` shape
# with LOCAL types (canaries cannot import std::math).
use std::core

# FOUR doubles as a module-const leaf inside a symbolic expression.
const FOUR: Int = 4

struct Pair[const A: Int, const B: Int]
  v: Int
end

impl[const A: Int, const B: Int] Pair[A, B]
  # Impl-level arithmetic: the A + B / B + A slots fold to ONE value per
  # instance; the reversed spelling must unify with the canonical fold.
  def widen(self: Self, other: Pair[A + B, B + A]) -> Pair[A + B, B + A]
    other
  end

  # The mul_exact shape: a method-level const parameter combined with the
  # impl's parameters in the same type-argument expression.
  def rebase[const S2: Int](self: Self, other: Pair[A + S2, B - S2]) -> Pair[A + S2, B - S2]
    other
  end

  # Value-level const-param reads (slice 3) coexist with the type-level
  # trees: the SAME A/B that shape the signature read as per-instance
  # runtime values in the body.
  def combined(self: Self, other: Pair[A + B, B + A]) -> Int
    self.v + other.v + A + B
  end
end

def run() -> Int
  let p12: Pair[1, 2] = Pair { v: 10 }
  # The caller-side concrete spellings: literal arithmetic (1 + 2) and a
  # module-const arithmetic (FOUR + 6) fold at RESOLVE to Const(3) and
  # Const(10) — the same canonical values the symbolic slots fold to per
  # instance, so every spelling unifies after the fold.
  let q3a: Pair[3, 3] = Pair { v: 30 }
  let q3b: Pair[1 + 2, 2 + 1] = Pair { v: 31 }
  let w12: Pair[3, 3] = p12.widen(q3a)
  if w12.v != 30 then
    return 1
  end
  let w12b: Pair[3, 3] = p12.widen(q3b)
  if w12b.v != 31 then
    return 2
  end
  if p12.combined(q3a) != 10 + 30 + 1 + 2 then
    return 3
  end

  let p46: Pair[4, 6] = Pair { v: 40 }
  let q10a: Pair[10, 10] = Pair { v: 100 }
  let q10b: Pair[FOUR + 6, 10] = Pair { v: 101 }
  let w46: Pair[10, 10] = p46.widen(q10a)
  if w46.v != 100 then
    return 4
  end
  let w46b: Pair[10, 10] = p46.widen(q10b)
  if w46b.v != 101 then
    return 5
  end
  if p46.combined(q10a) != 40 + 100 + 4 + 6 then
    return 6
  end

  # rebase combines the method-level S2 (explicit at the call) with the
  # impl-level A and B: (A, B) = (1, 2), S2 = 5 -> Pair[6, -3]...
  let q6n3: Pair[6, -3] = Pair { v: 60 }
  let r1: Pair[6, -3] = p12.rebase[5](q6n3)
  if r1.v != 60 then
    return 7
  end
  # ...and (A, B) = (4, 6), S2 = 5 -> Pair[9, 1] — a second instance.
  let q91: Pair[9, 1] = Pair { v: 90 }
  let r2: Pair[9, 1] = p46.rebase[5](q91)
  if r2.v != 90 then
    return 8
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_const_generic_const_expr_args: FAIL " + ok.to_string())
    1
  end
end
