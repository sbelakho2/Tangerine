use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def schedule_tasks(f: fn(Int) -> Unit) -> Unit
  f(0)
end

def check_let_capture() -> Bool
  mut x = 0
  let cl = do |_|
    x
  end
  cl(0) == 0
end

def check_nonescaping_inout_capture() -> Bool
  mut x = 0
  let cl = do |_|
    x = x + 1
  end
  cl(0)
  x == 1
end

def check_sink_capture() -> Bool
  let r = R { a: 1 }
  let cl = do |_|
    consume_r(r)
  end
  cl(0)
  true
end

def check_coro_sink_across_await() -> Bool
  let r = R { a: 1 }
  schedule_tasks(do |_|
    consume_r(r)
  end)
  true
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_let_capture() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] let_capture")
  end

  if check_nonescaping_inout_capture() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] nonescaping_inout_capture")
  end

  if check_sink_capture() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] sink_capture")
  end

  if check_coro_sink_across_await() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] coro_sink_across_await")
  end

  println("canary_closure_async: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
