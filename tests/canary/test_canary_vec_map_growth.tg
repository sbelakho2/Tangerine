# tests/canary/test_canary_vec_map_growth.tg
# Native canary: Vec and Map growth. Pushes far past the initial
# capacity and inserts many map keys to force reallocation / resizing;
# contents must survive growth intact and ordering/length must hold.
#
# Failure class: COLLECTION_BUG / BUMP_ALLOC_BUG

use std::core

def check_vec_growth() -> Bool
  mut v: Vec[Int] = Vec::new()
  let seed = 7
  mut i = 0
  while i < 1000 do
    v.push(seed * i)
    i = i + 1
  end
  if v.len() != 1000 then
    return false
  end
  # Spot-check first, middle, and last elements.
  v[0] == seed * 0 && v[500] == seed * 500 && v[999] == seed * 999
end

def check_map_growth() -> Bool
  mut m: Map[Int, Int] = Map::new()
  mut i = 0
  while i < 500 do
    m.insert(i, i * 3)
    i = i + 1
  end
  if m.len() != 500 then
    return false
  end
  mut j = 0
  while j < 500 do
    let expected = j * 3
    let actual = match m.get(&j)
    when Option::Some(v) then v
    when Option::None then -1
    end
    if actual != expected then
      return false
    end
    j = j + 1
  end
  true
end

def check_vec_map_interplay() -> Bool
  mut v: Vec[String] = Vec::new()
  v.push("alpha")
  v.push("beta")
  v.push("gamma")
  mut m: Map[String, Int] = Map::new()
  m.insert(v[0], 1)
  m.insert(v[1], 2)
  m.insert(v[2], 3)
  match m.get(&"beta")
  when Option::Some(val) then val == 2
  when Option::None then false
  end
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_vec_growth() then
    passed = passed + 1
    println("[PASS] vec_growth_1000")
  else
    failed = failed + 1
    println("[FAIL] vec_growth_1000")
  end

  if check_map_growth() then
    passed = passed + 1
    println("[PASS] map_growth_500")
  else
    failed = failed + 1
    println("[FAIL] map_growth_500")
  end

  if check_vec_map_interplay() then
    passed = passed + 1
    println("[PASS] vec_map_interplay")
  else
    failed = failed + 1
    println("[FAIL] vec_map_interplay")
  end

  println("canary_vec_map_growth: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
