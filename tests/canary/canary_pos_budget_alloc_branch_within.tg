# Positive budget canary — the PATH-INSENSITIVE static rejection REMOVED:
# an `if` with one allocation per branch has TWO allocation sites while
# every path allocates ONCE. The former check-time static-exceed rejection
# (check_budget_static_exceed — the site count vs the declared limit)
# rejected this body; the runtime enforcement (the per-invocation
# frame-slot counter — the prologue zeroes it, the MirBudgetConsume arms
# increment it along the TAKEN path) decides the dynamic behavior: the
# taken branch's single allocation stays within `alloc: "1"`. Exit 0
# required — the compile-time surface is only the annotated function's
# enforcement statements.
def budgeted(c: Bool) -> Int @budget alloc: "1"
  let v = Vec[Int]::new()
  if c then
    v.push(1)
  else
    v.push(2)
  end
  0
end

def main() -> Int
  let a = budgeted(true)
  let b = budgeted(false)
  a + b
end
