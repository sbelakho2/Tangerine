# Positive canary (§23): a trait impl generic over a CONST parameter —
# `impl[const SCALE: Int] Eq for Dec64[SCALE]`. The impl DECLARES its own
# const parameter (a headerless `impl Eq for Dec64[SCALE]` cannot bind
# SCALE: impl generics derive only from the trait's type arguments), and
# the arity-0 trait (Eq/Ord/Hash/Display/Clone-style core traits declare
# no type parameters) accepts the const-param impl WITHOUT explicit trait
# arguments: the trait reference stays empty and the impl HEAD carries the
# const slot, so Eq on Dec64[2] AND Dec64[4] match ONE registered impl
# with SCALE instantiated per receiver — method dispatch binds the
# impl-level const parameter from the receiver's const argument, the same
# shape the §23 std::math Decimal64 follow-up needs
# (`impl[const SCALE: Int] Eq for Decimal64[SCALE]`).
use std::core

struct Dec64[const SCALE: Int]
  unscaled: Int
end

# std::core's Eq — the arity-0 builtin trait (re-declared by std::core
# under the builtin TraitId) the trait-impl follow-up targets.
impl[const SCALE: Int] Eq for Dec64[SCALE]
  def eq(self, other: Dec64[SCALE]) -> Bool
    self.unscaled == other.unscaled
  end
end

# A LOCAL arity-0 trait — the self-contained mirror of the Eq shape (a
# source-declared contract in this file, no builtin registration).
trait ScaleEq
  def same_scale(self: Self, other: Self) -> Bool
end

impl[const SCALE: Int] ScaleEq for Dec64[SCALE]
  def same_scale(self, other: Dec64[SCALE]) -> Bool
    self.unscaled == other.unscaled
  end
end

def run() -> Int
  let a2: Dec64[2] = Dec64 { unscaled: 5 }
  let b2: Dec64[2] = Dec64 { unscaled: 5 }
  let c2: Dec64[2] = Dec64 { unscaled: 7 }
  let a4: Dec64[4] = Dec64 { unscaled: 5 }
  let b4: Dec64[4] = Dec64 { unscaled: 6 }
  # The Eq trait-impl method dispatches on the Dec64[2] instance...
  if !a2.eq(b2) then
    return 1
  end
  if a2.eq(c2) then
    return 2
  end
  # ...and on the Dec64[4] instance (SCALE=4) in the same program.
  if !a4.eq(a4) then
    return 3
  end
  if b4.eq(a4) then
    return 4
  end
  # The local arity-0 trait follows the same const-param impl shape.
  if !a2.same_scale(b2) then
    return 5
  end
  if a2.same_scale(c2) then
    return 6
  end
  if !a4.same_scale(a4) then
    return 7
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_const_generic_trait_impl: FAIL " + ok.to_string())
    1
  end
end
