# Positive canary: a resource created in a nested lexical scope is finalized
# exactly once at scope exit (block-exit obligation), before the function
# returns.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def do_scope() -> Unit
  {
    let q = Probe { id: 1 }
  }
end

def main() -> Int
  do_scope()
  if deinit_count == 1 then
    0
  else
    println("canary_pos_resource_nested_scope: FAIL count=" + deinit_count.to_string())
    1
  end
end
