# Positive canary: NESTED Map/Set cleanup — a Map whose values are Maps and
# a Set whose elements are Sets: the destructive cleanup recurses through
# the container tree (each live map value drained and dropped, each set
# element drained and dropped). Contents are verified before the lexical
# scope ends; the cleanup itself runs at scope exit.
use std::core
use std::collections

def use_nested_maps() -> Int
  let mut outer = Map[String, Map[String, Int]]::new()
  let mut inner = Map[String, Int]::new()
  inner.insert("x", 1)
  inner.insert("y", 2)
  outer.insert("a", inner)
  let mut inner2 = Map[String, Int]::new()
  inner2.insert("z", 3)
  outer.insert("b", inner2)
  if outer.len() != 2 then
    return 1
  end
  0
end

def use_nested_sets() -> Int
  let mut outer = Set[Set[Int]]::new()
  let mut s1 = Set[Int]::new()
  s1.insert(1)
  s1.insert(2)
  outer.insert(s1)
  let mut s2 = Set[Int]::new()
  s2.insert(3)
  outer.insert(s2)
  if outer.len() != 2 then
    return 1
  end
  0
end

def main() -> Int
  let a = use_nested_maps()
  let b = use_nested_sets()
  if a == 0 && b == 0 then
    0
  else
    println("canary_pos_nested_map_set_cleanup: FAIL a=" + a.to_string() + " b=" + b.to_string())
    1
  end
end
