# Positive canary (audit: replace_nested_owned_field): the NESTED
# exact-place replacement — `o.inner.a = ...` destroys ONLY the old
# value of the chain o.inner.a; the sibling chain o.inner.b stays live
# and readable after the store, and every live value drops exactly once
# (old inner.a at the replacement; the new inner.a and inner.b at the
# scope exit — exactly 3 deinitializations).
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Inner
  a: Probe
  b: Probe
end

resource Outer
  inner: Inner
  tag: Int
end

def run() -> Int
  let mut o = Outer { inner: Inner { a: Probe { id: 1 }, b: Probe { id: 2 } }, tag: 7 }
  o.inner.a = Probe { id: 3 }
  # the nested sibling b survived the exact-place replacement
  if o.inner.a.id == 3 && o.inner.b.id == 2 && o.tag == 7 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 3 then
    0
  else
    println("canary_pos_replace_nested_owned_field: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
