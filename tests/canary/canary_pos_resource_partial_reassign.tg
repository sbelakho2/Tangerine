# Positive canary: the re-assignment of a consumed field (the mandate's
# canary (b)). After `let old = s.a` the a field's storage is dead; the
# store `s.a = File { fd: 3 }` re-lives the field WITHOUT a drop (the
# dead storage needs no drop-before-store), and the scope exit drops the
# re-stored a and the extracted old — exactly 2 deinitializations.
use std::core

static mut file_deinit_count: Int = 0

resource File
  fd: Int
  def deinit(sink self: Self) -> Unit
    file_deinit_count = file_deinit_count + 1
  end
end

resource S
  a: File
  b: Int
end

def run() -> Int
  let mut s = S { a: File { fd: 1 }, b: 2 }
  let old = s.a
  s.a = File { fd: 3 }
  if s.a.fd == 3 && old.fd == 1 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && file_deinit_count == 2 then
    0
  else
    println("canary_pos_resource_partial_reassign: FAIL ok=" + ok.to_string() + " deinit_count=" + file_deinit_count.to_string())
    1
  end
end
