# The loop after a partial move: a struct field is extracted (the per-field
# consume), the remaining field stays live, and the loop runs on the
# partially-consumed frame.
cap Probe
  def new() -> Probe
    Probe
  end
end

struct Pair
  a: Probe
  b: Probe
end

def main() -> Int
  let p = Pair { a: Probe::new(), b: Probe::new() }
  let a = p.a
  use_probe(a)
  var total = 0
  for i in 0..3 do
    total = total + i
  end
  # p.b is still live — the scope-exit partial drop deinitializes it.
  return total
end

def use_probe(pr: Probe) -> Unit
  ()
end
