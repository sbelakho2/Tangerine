# Positive canary (P1 — FixedArray const sizes): the [T; N] annotation's
# size expression is evaluated through the compiler's constant evaluator
# BEFORE FixedArray(Type, N) identity forms — the const-reference form
# `[T; CONST]` resolves to its value and the arithmetic const forms
# `[T; CONST * 2]` / `[T; CONST + 1]` evaluate — so the const spellings
# produce the same fixed-array type identity as the literal spellings.
use std::core

const ARR_N: Int = 4
const ARR_M: Int = 3

def run() -> Int
  let a: [Int; ARR_N] = [10, 20, 30, 40]
  let b: [Int; ARR_N * 2] = [1, 2, 3, 4, 5, 6, 7, 8]
  let c: [Int; ARR_M + 1] = [7, 8, 9, 10]
  let d: [Int; 4] = [0, 0, 0, 0]
  if a[0] + a[3] != 50 then
    return 1
  end
  if b[7] != 8 then
    return 2
  end
  if c[3] != 10 then
    return 3
  end
  if d[2] != 0 then
    return 4
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_fixed_array_const_size: FAIL " + ok.to_string())
    1
  end
end
