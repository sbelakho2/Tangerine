# Positive canary: loop-created resources are cleaned automatically — the
# backedge finalizes the previous iteration's `p` before the next iteration,
# and the loop-exit edge finalizes the last iteration's `p`. The programmer
# never consumes p explicitly.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def main() -> Int
  var i = 0
  loop
    i = i + 1
    let p = Probe { id: i }
    if i >= 3 then
      break
    end
  end
  if deinit_count == 3 then
    0
  else
    println("canary_pos_resource_loop_auto_clean: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
