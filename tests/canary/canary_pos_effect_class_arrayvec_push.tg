# Positive effect-class canary (audit §11): @no_alloc PROVES the
# fixed-capacity ArrayVec push — std::fixed::ArrayVec4's inline
# [Option[T]; 4] storage never heap-allocates (the element store routes
# to no allocating intrinsic), the mirror image of Vec.push
# (canary_neg_noalloc_vec_push.tg, which must FAIL). The canary runs the
# real path: the annotated functions are called from main and exit 0.
use std::core
use std::fixed::ArrayVec4

@no_alloc
def fill_av() -> Int
  var av = ArrayVec4[Int]::new()
  match av.push(10)
  when Result::Ok(_) then ()
  when Result::Err(_) then return 1
  end
  match av.push(20)
  when Result::Ok(_) then ()
  when Result::Err(_) then return 2
  end
  if av.len() != 2 then
    return 3
  end
  var out = 0
  let first = av.pop()
  match first
  when Option::Some(v) then out = out + v
  when Option::None then return 4
  end
  let second = av.pop()
  match second
  when Option::Some(v2) then out = out + v2
  when Option::None then return 5
  end
  out
end

@no_alloc
def sum_fixed() -> Int
  let a: [Int; 4] = [1, 2, 3, 4]
  a[0] + a[1] + a[2] + a[3]
end

def main() -> Int
  if fill_av() != 30 then
    return 1
  end
  if sum_fixed() != 10 then
    return 2
  end
  0
end
