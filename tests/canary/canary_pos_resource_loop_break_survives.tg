# Positive canary: a resource that predates a loop must SURVIVE a break edge.
# `outer` is created before the loop; the break exits the loop — the break
# edge cleanup must finalize only loop-created locals, never `outer`.
# deinit_count is checked AFTER the loop but the break itself must not have
# finalized outer (checked via outer.id read after the break).
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def main() -> Int
  let outer = Probe { id: 42 }
  var i = 0
  loop
    i = i + 1
    if i >= 2 then
      break
    end
  end
  if outer.id == 42 && deinit_count == 0 then
    0
  else
    println("canary_pos_resource_loop_break_survives: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
