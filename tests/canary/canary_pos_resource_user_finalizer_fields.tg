# Positive canary: explicit user finalizer PLUS a resource field — the user
# finalizer runs once and the child field is finalized exactly once (the
# compiler-owned structural cleanup composes with the user finalizer).
use std::core

static mut deinit_count: Int = 0
static mut outer_count: Int = 0

resource Inner
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

resource Outer
  inner: Inner
  def deinit(sink self: Self) -> Unit
    outer_count = outer_count + 1
  end
end

def do_test() -> Unit
  let o = Outer { inner: Inner { id: 1 } }
end

def main() -> Int
  do_test()
  if outer_count == 1 && deinit_count == 1 then
    0
  else
    println("canary_pos_resource_user_finalizer: FAIL outer=" + outer_count.to_string() + " inner=" + deinit_count.to_string())
    1
  end
end
