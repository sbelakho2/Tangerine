# Positive canary: the extracted-field pattern (the mandate's canary (a)).
# `let a = s.a` moves the a field out while s.b stays live; the scope-exit
# cleanup drops s with the partial-drop chain (the mask with only the live
# b field). Deinit counts: the extracted a finalizes at the scope exit
# (its own binding), the b field is Int (no deinit) and the consumed a's
# storage is never re-dropped — exactly 1 deinitialization.
use std::core

static mut file_deinit_count: Int = 0

resource File
  fd: Int
  def deinit(sink self: Self) -> Unit
    file_deinit_count = file_deinit_count + 1
  end
end

resource S
  a: File
  b: Int
end

def use_b(b: Int) -> Int
  b
end

def run() -> Int
  let s = S { a: File { fd: 1 }, b: 2 }
  let a = s.a
  use_b(s.b)
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 && file_deinit_count == 1 then
    0
  else
    println("canary_pos_resource_partial_extract: FAIL ok=" + ok.to_string() + " deinit_count=" + file_deinit_count.to_string())
    1
  end
end
