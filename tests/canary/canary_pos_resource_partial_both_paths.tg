# Positive canary — the PATH-CONDITIONAL PARTIAL MOVE consumed on BOTH
# paths (the paired positive of canary_neg_resource_partial_conditional.
# tg). The field consumed on ONE path only is MaybeLive at the join and
# rejected; the same field consumed on EVERY path joins to Consumed and
# is the closest accepted program to that rejection: the sibling field
# stays live and is finalized by the partial-drop chain at scope exit.
# Deinit counts: the moved-out `a` finalizes inside the sink, the live
# `b` at the scope exit — exactly 2 deinitializations.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Pair
  a: Probe
  b: Probe
end

def consume_probe(sink r: Probe) -> Unit
end

def run() -> Int
  let p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  if p.b.id > 0 then
    consume_probe(p.a)
  else
    consume_probe(p.a)
  end
  if p.b.id == 2 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 2 then
    0
  else
    println("canary_pos_resource_partial_both_paths: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
