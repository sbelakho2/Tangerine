# Positive scoped-access canary (audit §12): the Copy-valued read side of
# the scoped-access surface — `as let` binds a value snapshot of a Copy
# struct field; a Copy value may be read out of the access into let
# bindings, and the source place keeps its value after the block.
use std::core

struct Point
  x: Int
  y: Int
end

def check_copy_field_let() -> Bool
  mut p = Point { x: 1, y: 2 }
  with p.x as let n
    let m = n
    if m != 1 then
      return false
    end
  end
  p.x == 1
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_copy_field_let() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] copy_field_let")
  end

  println("canary_pos_scoped_access_copy_field: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
