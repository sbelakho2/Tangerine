# Positive canary: a for-range loop's iteration resources are finalized
# exactly once per iteration (backedge); the condition-false exit adds none.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def main() -> Int
  for i in 0..3 do
    let p = Probe { id: i }
  end
  if deinit_count == 3 then
    0
  else
    println("canary_pos_resource_for_auto_clean: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
