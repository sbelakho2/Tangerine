# Positive canary: an early return must finalize live owned locals exactly
# once (the lexical block knows the resource must die; the return edge carries
# the cleanup obligation).
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def f(cond: Bool) -> Unit
  let p = Probe { id: 1 }
  if cond then
    return
  end
end

def main() -> Int
  f(true)
  if deinit_count == 1 then
    0
  else
    println("canary_pos_resource_early_return: FAIL count=" + deinit_count.to_string())
    1
  end
end
