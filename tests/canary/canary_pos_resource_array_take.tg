# Positive canary: extracting a resource from an array via the consuming
# inout API (pop) must compile and run — the paired positive of the
# shared-get/index/iter resource negatives.
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let mut files = [File { fd: 1 }]
  let f = files.pop()
  match f
  when Option::Some(_) then 0
  when Option::None then 1
  end
end
