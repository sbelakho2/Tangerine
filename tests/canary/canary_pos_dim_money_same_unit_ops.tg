# Positive canary (audit §23 part C): the phantom-dimension Money shape
# with LOCAL types (canaries cannot import std::math — the std::math
# Money/Price/Quantity/Rate surface is exercised by the unit lane).  The
# dimension marker types (USD / EUR) are LOCAL payload-less markers used
# as TYPE ARGUMENTS ONLY — no value of either ever exists at runtime:
# Money[USD, 2] and Money[EUR, 2] are different types over the same
# one-word layout, and the phantom `C` never appears in a field or in
# codegen.  The mirror surface below is the std::math shape: the const
# SCALE is the type (add/sub need no runtime scale), scale() reads the
# const parameter per instance, from_minor is the word constructor, and
# a different currency or scale never typechecks (see the
# canary_neg_dim_* files for the rejections).
use std::core

struct USD
end

struct EUR
end

struct Money[C, const SCALE: Int]
  unscaled: Int
end

impl[C, const SCALE: Int] Money[C, SCALE]
  def zero() -> Money[C, SCALE]
    Money[C, SCALE] { unscaled: 0 }
  end

  def from_minor(minor: Int) -> Money[C, SCALE]
    Money[C, SCALE] { unscaled: minor }
  end

  def scale(self) -> Int
    SCALE
  end

  def unscaled(self) -> Int
    self.unscaled
  end

  # Checked add over the same (C, SCALE) instance: word overflow is
  # Option::None, never a silent wrap (the std surface reports
  # Result[Money[C, SCALE], FixedError]).
  def add(self, other: Money[C, SCALE]) -> Option[Money[C, SCALE]]
    let a = self.unscaled as u64
    let b = other.unscaled as u64
    let s = a + b
    let lim = (~(0 as u64)) >> 1
    let a_neg = a > lim
    let b_neg = b > lim
    let s_neg = s > lim
    if (a_neg && b_neg && !s_neg) || (!a_neg && !b_neg && s_neg) then
      return Option::None
    end
    Option::Some(Money[C, SCALE] { unscaled: s as Int })
  end

  def compare(self, other: Money[C, SCALE]) -> Int
    if self.unscaled < other.unscaled then return -1 end
    if self.unscaled > other.unscaled then return 1 end
    0
  end
end

def run() -> Int
  # The audit's Money[USD, 2] example: minor units at scale 2.
  let usd: Money[USD, 2] = Money[USD, 2]::from_minor(1234)
  let eur: Money[EUR, 2] = Money[EUR, 2]::from_minor(9900)
  if usd.scale() != 2 then
    return 1
  end
  if eur.scale() != 2 then
    return 2
  end
  if usd.unscaled() != 1234 then
    return 3
  end
  # Same-currency, same-instance arithmetic.
  let paid: Money[USD, 2] = Money[USD, 2]::from_minor(100)
  match paid.add(usd)
  when Option::Some(sum) then
    if sum.unscaled() != 1334 then
      return 4
    end
  when Option::None then
    return 5
  end
  # A second currency instance coexists with the first in ONE program:
  # the const SCALE is substituted per instance.
  match eur.add(eur)
  when Option::Some(sum) then
    if sum.unscaled() != 19800 then
      return 6
    end
  when Option::None then
    return 7
  end
  # Word-overflow is an error result at the SAME type.
  let big: Money[USD, 0] = Money[USD, 0]::from_minor(9223372036854775807)
  let one: Money[USD, 0] = Money[USD, 0]::from_minor(1)
  match big.add(one)
  when Option::Some(_) then
    return 8
  when Option::None then
    ()
  end
  # Compare follows the word order at one instance.
  let lo: Money[USD, 2] = Money[USD, 2]::from_minor(100)
  if lo.compare(paid) != -1 then
    return 9
  end
  let zero: Money[USD, 2] = Money[USD, 2]::zero()
  if zero.compare(zero) != 0 then
    return 10
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_dim_money_same_unit_ops: FAIL " + ok.to_string())
    1
  end
end
