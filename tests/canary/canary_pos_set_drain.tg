# Positive canary: the DESTRUCTIVE set_drain_one primitive — the actual
# element is transferred out of the set; the remaining elements are drained
# and released by the scope-end cleanup.
use std::core
use std::collections

def use_set() -> Int
  let mut s = Set[Int]::new()
  s.insert(1)
  s.insert(2)
  let first = s.drain_one()
  if first.is_some() then 1 else 0 end
end

def main() -> Int
  let ok = use_set()
  if ok == 1 then
    0
  else
    println("canary_pos_set_drain: FAIL ok=" + ok.to_string())
    1
  end
end
