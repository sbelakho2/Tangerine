use std::core

resource R
  a: Int
end

def apply_cb(cb: fn(R) -> Unit) -> Int
  1
end

def check_fn_value_ordinary() -> Bool
  let f = do |x: R|
    ()
  end
  apply_cb(f) == 1
end

def run() -> Int
  if check_fn_value_ordinary() then
    println("canary_fn_value_not_resource: OK")
    0
  else
    println("canary_fn_value_not_resource: FAIL")
    1
  end
end

def main() -> Int
  run()
end
