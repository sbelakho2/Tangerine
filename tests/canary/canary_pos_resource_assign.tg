# Positive canary: assigning over a LIVE owning place drops the previous
# value first (drop old -> store new): the old Probe is finalized by the
# assignment, the new one at scope end — exactly 2 deinitializations.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def use_assign() -> Int
  var r = Probe { id: 1 }
  r = Probe { id: 2 }
  if r.id == 2 then 0 else 1 end
end

def main() -> Int
  let ok = use_assign()
  if ok == 0 && deinit_count == 2 then
    0
  else
    println("canary_pos_resource_assign: FAIL ok=" + ok.to_string() + " deinit_count=" + deinit_count.to_string())
    1
  end
end
