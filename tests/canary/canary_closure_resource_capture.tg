use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def check_resource_capture() -> Bool
  let r = R { a: 1 }
  let cl = do |_|
    consume_r(r)
  end
  cl(0)
  true
end

def run() -> Int
  if check_resource_capture() then
    println("canary_closure_resource_capture: OK")
    0
  else
    println("canary_closure_resource_capture: FAIL")
    1
  end
end

def main() -> Int
  run()
end
