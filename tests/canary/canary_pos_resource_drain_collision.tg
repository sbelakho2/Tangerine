# Positive canary: map_drain_one traverses OVERFLOW CHAINS. 300 keys into a
# 256-bucket table force collisions (pigeonhole), so entries live in
# mmap'ed overflow buckets; every value must still be drained and
# finalized exactly once before the table is destroyed.
use std::core
use std::collections

resource Value
  v: Int
  def deinit(sink self: Self) -> Unit
    value_count = value_count + 1
  end
end

static mut value_count: Int = 0

def use_map() -> Int
  let mut m = Map[Int, Value]::new()
  var i = 0
  while i < 300 do
    m.insert(i, Value { v: i })
    i = i + 1
  end
  0
end

def main() -> Int
  let ok = use_map()
  if ok == 0 && value_count == 300 then
    0
  else
    println("canary_pos_resource_drain_collision: FAIL ok=" + ok.to_string() + " value_count=" + value_count.to_string())
    1
  end
end
