# tests/canary/canary_narrow_signed_canon.tg
# Native canary: the audit item 27 CANONICAL NARROW-SIGNED register
# invariant — a narrow SIGNED value's full word is its sign-extended
# image at every producer, so (-1 as I8) compares/div/mod/shift-rights
# as -1 and never as 255.
#
# Every operand that must exercise the runtime narrowing path is
# produced by the n8/n16/n32 canonicalizers below: the low w bits come
# from a RUNTIME parameter (255 as u8 -> as i8 must deliver -1, not the
# masked 255 image), so no row can be constant-folded away and no row
# depends on the optimizer. The boundary values the audit lists
# (-128, -127, -1, 0, 1, 127) are covered across compare, div, mod,
# arithmetic shift-right, call/return, spill/reload (a value live
# across several calls), storage round trips and the widening/
# narrowing casts. MIN/-1 and /0 edges are never executed (the
# documented cross-target gap).
#
# Failure class: CODE_GEN_BUG (narrow signed canonicalization)

use std::core

# The runtime canonicalizers: the low w bits of a runtime word, then
# the width-changing cast to the SIGNED type. The cast chain is the
# producer the invariant governs.
def n8(v: Int) -> i8
  (v as u8) as i8
end

def n16(v: Int) -> i16
  (v as u16) as i16
end

def n32(v: Int) -> i32
  (v as u32) as i32
end

# The signed comparisons under test.
def i8_lt(x: i8, y: i8) -> Bool
  x < y
end

def i8_gt(x: i8, y: i8) -> Bool
  x > y
end

def i8_eq(x: i8, y: i8) -> Bool
  x == y
end

def i8_le(x: i8, y: i8) -> Bool
  x <= y
end

def i8_ge(x: i8, y: i8) -> Bool
  x >= y
end

def i8_ne(x: i8, y: i8) -> Bool
  x != y
end

def i8_lt0(x: i8) -> Bool
  x < 0
end

def i16_lt0(x: i16) -> Bool
  x < 0
end

def i32_lt0(x: i32) -> Bool
  x < 0
end

# div/mod/arithmetic-shift consumers (signed narrow operands).
def i8_div2(x: i8) -> i8
  x / 2
end

def i8_mod7(x: i8) -> i8
  x % 7
end

def i8_shr1(x: i8) -> i8
  x >> 1
end

def i8_shr7(x: i8) -> i8
  x >> 7
end

# call/return round trips.
def i8_echo(x: i8) -> i8
  x
end

# A value live across several register-clobbering calls: the allocation
# spills it to its slot before the first call and reloads it after the
# last (or rides a callee-saved register) — the word must survive the
# round trip byte-exact, canonical image included.
def busy(a: Int, b: Int) -> Int
  var acc = a + b
  acc = acc + 1
  var t = a - b
  if t < 0 then
    acc = acc - t
  else
    acc = acc + t
  end
  acc
end

def i8_spill_lt0(x: i8) -> Bool
  let t1 = busy(11, 22)
  let t2 = busy(t1, 33)
  let t3 = busy(t2, 44)
  let t4 = busy(t3, 55)
  if t4 == 0 then
    false
  else
    x < 0
  end
end

# A storage round trip: the canonical full word stores its low byte;
# the signed reload sign-extends it back to the canonical image.
struct NarrowSignedCell
  v: i8
  tag: Int
end

def cell_neg(c: &NarrowSignedCell) -> Bool
  c.v < 0
end

def run() -> Int
  var passed = 0
  var failed = 0

  # ── compare rows over the boundary set {-128, -127, -1, 0, 1, 127}
  # (byte words 128, 129, 255, 0, 1, 127) ──
  var cmp_bad = 0
  var cmp_rows: Vec[(Int, Int, Bool, Bool, Bool)] = Vec::new()
  cmp_rows.push((255, 0, true, false, false))    # -1 < 0
  cmp_rows.push((255, 1, true, false, false))    # -1 < 1
  cmp_rows.push((255, 127, true, false, false))  # -1 < 127
  cmp_rows.push((255, 255, false, false, true))  # -1 == -1
  cmp_rows.push((128, 129, true, false, false))  # -128 < -127
  cmp_rows.push((128, 0, true, false, false))    # -128 < 0
  cmp_rows.push((129, 127, true, false, false))  # -127 < 127
  cmp_rows.push((127, 255, false, true, false))  # 127 > -1
  cmp_rows.push((0, 255, false, true, false))    # 0 > -1
  cmp_rows.push((0, 1, true, false, false))      # 0 < 1
  cmp_rows.push((1, 128, false, true, false))    # 1 > -128
  cmp_rows.push((129, 128, false, false, true))  # -127 == -127
  cmp_rows.push((0, 0, false, false, true))      # 0 == 0
  var li = 0
  while li < cmp_rows.len() do
    let a = cmp_rows[li].0
    let b = cmp_rows[li].1
    let want_lt = cmp_rows[li].2
    let want_gt = cmp_rows[li].3
    let want_eq = cmp_rows[li].4
    let ok = i8_lt(n8(a), n8(b)) == want_lt &&
             i8_gt(n8(a), n8(b)) == want_gt &&
             i8_eq(n8(a), n8(b)) == want_eq &&
             i8_le(n8(a), n8(b)) == (want_lt || want_eq) &&
             i8_ge(n8(a), n8(b)) == (want_gt || want_eq) &&
             i8_ne(n8(a), n8(b)) == !want_eq
    if ok then
      passed = passed + 1
    else
      failed = failed + 1
      cmp_bad = cmp_bad + 1
      println("[FAIL] narrow_signed_cmp row (" + a.to_string() + ", " + b.to_string() + ")")
    end
    li = li + 1
  end
  if cmp_bad == 0 then
    println("[PASS] narrow_signed_cmp")
  end

  # The explicit negative-boundary sign checks (the audit's headline
  # row: (-1 as I8) compared as signed must be -1, not 255).
  var neg_ok = true
  if !i8_lt0(n8(255)) then
    neg_ok = false
    println("[FAIL] -1 (i8) < 0 is false (masked 255 compared as signed)")
  end
  if !i16_lt0(n16(65535)) then
    neg_ok = false
    println("[FAIL] -1 (i16) < 0 is false (masked 65535 compared as signed)")
  end
  if !i32_lt0(n32(4294967295)) then
    neg_ok = false
    println("[FAIL] -1 (i32) < 0 is false (masked 4294967295 compared as signed)")
  end
  if neg_ok then
    passed = passed + 1
    println("[PASS] narrow_signed_negative_zero")
  else
    failed = failed + 1
  end

  # ── div rows (signed narrow division of the boundary values) ──
  var div_bad = 0
  var div_rows: Vec[(Int, Int)] = Vec::new()
  div_rows.push((255, 0))   # -1 / 2 == 0
  div_rows.push((254, -1))  # -2 / 2 == -1
  div_rows.push((128, -64)) # -128 / 2 == -64
  div_rows.push((127, 63))  # 127 / 2 == 63
  div_rows.push((1, 0))     # 1 / 2 == 0
  div_rows.push((129, -63)) # -127 / 2 == -63
  var di = 0
  while di < div_rows.len() do
    if i8_eq(i8_div2(n8(div_rows[di].0)), div_rows[di].1 as i8) then
      passed = passed + 1
    else
      failed = failed + 1
      div_bad = div_bad + 1
      println("[FAIL] narrow_signed_div2 of byte " + div_rows[di].0.to_string() + " (got " + (i8_div2(n8(div_rows[di].0)) as Int).to_string() + ")")
    end
    di = di + 1
  end
  if div_bad == 0 then
    println("[PASS] narrow_signed_div")
  end

  # ── mod rows (the remainder carries the dividend's sign) ──
  var mod_bad = 0
  var mod_rows: Vec[(Int, Int)] = Vec::new()
  mod_rows.push((255, -1))  # -1 % 7 == -1
  mod_rows.push((254, -2))  # -2 % 7 == -2
  mod_rows.push((128, -2))  # -128 % 7 == -2
  mod_rows.push((127, 1))   # 127 % 7 == 1
  mod_rows.push((1, 1))     # 1 % 7 == 1
  mod_rows.push((129, -1))  # -127 % 7 == -1
  var mi = 0
  while mi < mod_rows.len() do
    if i8_eq(i8_mod7(n8(mod_rows[mi].0)), mod_rows[mi].1 as i8) then
      passed = passed + 1
    else
      failed = failed + 1
      mod_bad = mod_bad + 1
      println("[FAIL] narrow_signed_mod7 of byte " + mod_rows[mi].0.to_string() + " (got " + (i8_mod7(n8(mod_rows[mi].0)) as Int).to_string() + ")")
    end
    mi = mi + 1
  end
  if mod_bad == 0 then
    println("[PASS] narrow_signed_mod")
  end

  # ── arithmetic shift-right rows (signed >> on the boundary values);
  # each row is (byte word, shift count, expected result) ──
  var shr_bad = 0
  var shr_rows: Vec[(Int, Int, Int)] = Vec::new()
  shr_rows.push((255, 1, -1))   # -1 >> 1 == -1
  shr_rows.push((254, 1, -1))   # -2 >> 1 == -1
  shr_rows.push((128, 1, -64))  # -128 >> 1 == -64
  shr_rows.push((127, 1, 63))   # 127 >> 1 == 63
  shr_rows.push((1, 1, 0))      # 1 >> 1 == 0
  shr_rows.push((128, 7, -1))   # -128 >> 7 == -1
  shr_rows.push((255, 7, -1))   # -1 >> 7 == -1
  shr_rows.push((127, 7, 0))    # 127 >> 7 == 0
  var si = 0
  while si < shr_rows.len() do
    let got = if shr_rows[si].1 == 7 then
      i8_shr7(n8(shr_rows[si].0))
    else
      i8_shr1(n8(shr_rows[si].0))
    end
    if i8_eq(got, shr_rows[si].2 as i8) then
      passed = passed + 1
    else
      failed = failed + 1
      shr_bad = shr_bad + 1
      println("[FAIL] narrow_signed_shr of byte " + shr_rows[si].0.to_string() + " by " + shr_rows[si].1.to_string() + " (got " + (got as Int).to_string() + ")")
    end
    si = si + 1
  end
  if shr_bad == 0 then
    println("[PASS] narrow_signed_shr")
  end

  # ── call/return rows ──
  var call_bad = 0
  if !i8_lt0(i8_echo(n8(255))) then
    call_bad = call_bad + 1
    println("[FAIL] i8 echo return of -1 compares as positive")
  end
  if !i8_lt0(i8_echo(i8_echo(i8_echo(n8(255))))) then
    call_bad = call_bad + 1
    println("[FAIL] i8 double echo return of -1 compares as positive")
  end
  if !i8_eq(i8_echo(i8_div2(n8(254))), -1 as i8) then
    call_bad = call_bad + 1
    println("[FAIL] i8 echo of -1 (div result) differs")
  end
  if call_bad == 0 then
    passed = passed + 1
    println("[PASS] narrow_signed_call_return")
  else
    failed = failed + call_bad
  end

  # ── spill/reload rows (live across several clobbering calls) ──
  var spill_bad = 0
  if !i8_spill_lt0(n8(255)) then
    spill_bad = spill_bad + 1
    println("[FAIL] i8 -1 live across calls compares as positive after spill/reload")
  end
  if i8_spill_lt0(n8(1)) then
    spill_bad = spill_bad + 1
    println("[FAIL] i8 1 live across calls compares as negative after spill/reload")
  end
  if spill_bad == 0 then
    passed = passed + 1
    println("[PASS] narrow_signed_spill_reload")
  else
    failed = failed + spill_bad
  end

  # ── storage round-trip rows (the canonical word's low byte stores,
  # the signed reload sign-extends) ──
  var store_bad = 0
  mut c = NarrowSignedCell { v: n8(255), tag: 7 }
  if !cell_neg(&c) || c.v != (-1 as i8) || c.tag != 7 then
    store_bad = store_bad + 1
    println("[FAIL] narrow signed cell round trip of -1")
  end
  c.v = n8(128)
  if !cell_neg(&c) || c.v != (-128 as i8) then
    store_bad = store_bad + 1
    println("[FAIL] narrow signed cell round trip of -128")
  end
  c.v = n8(127)
  if cell_neg(&c) || c.v != (127 as i8) then
    store_bad = store_bad + 1
    println("[FAIL] narrow signed cell round trip of 127")
  end
  c.v = n8(0)
  if cell_neg(&c) || c.v != (0 as i8) then
    store_bad = store_bad + 1
    println("[FAIL] narrow signed cell round trip of 0")
  end
  if store_bad == 0 then
    passed = passed + 1
    println("[PASS] narrow_signed_storage")
  else
    failed = failed + store_bad
  end

  # ── cast rows: widening keeps the canonical image; narrow-to-narrow
  # casts sign-extend; the unsigned view sees the masked low bits ──
  var cast_bad = 0
  if (n8(255) as Int) != -1 then
    cast_bad = cast_bad + 1
    println("[FAIL] i8 -1 widens to Int -1 (got " + (n8(255) as Int).to_string() + ")")
  end
  if !i16_lt0(n8(255) as i16) then
    cast_bad = cast_bad + 1
    println("[FAIL] i8 -1 cast to i16 compares as negative")
  end
  if !i32_lt0(n8(255) as i32) then
    cast_bad = cast_bad + 1
    println("[FAIL] i8 -1 cast to i32 compares as negative")
  end
  if !i8_lt0(n16(65535) as i8) then
    cast_bad = cast_bad + 1
    println("[FAIL] i16 -1 cast to i8 compares as negative")
  end
  if (n8(255) as u8) != (255 as u8) then
    cast_bad = cast_bad + 1
    println("[FAIL] i8 -1's low byte read through the u8 view is not 255")
  end
  if !i8_eq(n8(127), 127 as i8) || !i8_eq(n8(1), 1 as i8) || !i8_eq(n8(0), 0 as i8) then
    cast_bad = cast_bad + 1
    println("[FAIL] i8 positive boundary casts differ")
  end
  if !i8_eq((n8(128) as u8) as i8, -128 as i8) then
    cast_bad = cast_bad + 1
    println("[FAIL] u8 128 viewed as i8 is not -128")
  end
  if !i8_lt0(n8(129) as i8) then
    cast_bad = cast_bad + 1
    println("[FAIL] -127 (i8) after round-trip cast compares as positive")
  end
  if cast_bad == 0 then
    passed = passed + 1
    println("[PASS] narrow_signed_cast")
  else
    failed = failed + cast_bad
  end

  println("canary_narrow_signed_canon: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
