# Positive canary — the SET-PARAMETER BOTH-BRANCHES boundary (the paired
# positive of canary_neg_set_param_maybe_live.tg). A `set` parameter's
# contract is entry Uninitialized, exit EXACTLY Live on every return
# edge. Consuming it on ONE branch only leaves MaybeLive at the join
# (rejected); initializing it on BOTH branches joins to Live — the
# closest accepted program to that rejection. The checker accepts the
# both-branches shape and the function compiles into this canary (the
# same compile-time authority as canary_access_set.tg's init_r, which is
# likewise never called — the set-convention call path is exercised by
# the checker on the definitions themselves).
use std::core

resource R
  a: Int
end

def branch_sets_set_param(set r: R, flag: Bool) -> Int
  if flag then
    r = R { a: 1 }
  else
    r = R { a: 2 }
  end
  r.a
end

def main() -> Int
  println("canary_pos_set_param_both_branches: both-branch set init accepted")
  0
end
