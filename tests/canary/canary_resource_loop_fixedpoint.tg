use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def check_loop_fixed_point() -> Bool
  mut n = 0
  loop do
    let r = R { a: 1 }
    consume_r(r)
    n = n + 1
    if n >= 3 then
      break
    end
  end
  n == 3
end

def run() -> Int
  if check_loop_fixed_point() then
    println("canary_resource_loop_fixedpoint: OK")
    0
  else
    println("canary_resource_loop_fixedpoint: FAIL")
    1
  end
end

def main() -> Int
  run()
end
