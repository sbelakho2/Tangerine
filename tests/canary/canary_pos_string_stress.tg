# Positive canary: String create/grow/clone stress — the owned-String ABI
# under churn: repeated construction, buffer growth (push/push_str),
# deep clone, slicing, and concatenation must all yield correct contents
# and lengths, exercising the object header + buffer paths repeatedly.
# Clones are verified through the consuming pop() read (no by-value
# indexing of String elements).
use std::core

def run() -> Int
  var s = String::new()
  var i = 0
  while i < 200 do
    s.push('a')
    i = i + 1
  end
  if s.len() != 200 then
    return 1
  end
  let c = s.clone()
  if c.len() != 200 then
    return 2
  end
  let t = c.slice(0, 100)
  if t.len() != 100 then
    return 3
  end
  var s2 = "base".to_string()
  var j = 0
  while j < 50 do
    s2 = s2 + "x"
    j = j + 1
  end
  if s2.len() != 54 then
    return 4
  end
  var clones = Vec[String]::new()
  var k = 0
  while k < 20 do
    clones.push(s2.clone())
    k = k + 1
  end
  if clones.len() != 20 then
    return 5
  end
  var pops = 0
  loop
    match clones.pop()
    when Option::Some(item) then
      if item.len() != 54 then
        return 6
      end
      pops = pops + 1
    when Option::None then break
    end
  end
  if pops != 20 then
    return 7
  end
  s.push_str("bbb")
  if s.len() != 203 then
    return 8
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_string_stress: FAIL " + ok.to_string())
    1
  end
end
