# Positive canary: the KEYED take on a dynamic container —
# Map::remove(key) — extracts an owning value through the sanctioned
# ownership-safe operation (indexing a Map[K, V] with a resource V is
# rejected — canary_neg_resource_map_index — remove(key) is the
# ownership-transferring form: the removed value moves out as
# Option::Some(v) and the record's key is destroyed).
use std::core
use std::collections

resource File
  fd: Int
end

def main() -> Int
  let mut m = Map[Int, File]::new()
  m.insert(1, File { fd: 1 })
  m.insert(2, File { fd: 2 })
  match m.remove(1)
  when Option::Some(f) then
    if f.fd == 1 && m.len() == 1 then 0 else 1 end
  when Option::None then 2
  end
end
