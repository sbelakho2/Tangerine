# The P0 CFG collision class: the `for` as the FIRST statement of the
# function body — the lexical block key and the for-join key both derive
# from the for statement. The disjoint synthetic block-id allocator keeps
# the frames distinct: the body's per-iteration locals drop at the
# backedge, the continuation runs on the join's frame.
def main() -> Int
  for i in 0..4 do
    let s = "iter".to_string() + i.to_string()
    let _ = s.len()
  end
  let total = 10
  return total
end
