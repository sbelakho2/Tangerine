# Positive canary (audit §23 part C): the CROSS-DIMENSION products of
# the phantom-dimension const-scale decimals with LOCAL types (canaries
# cannot import std::math).  The mirrors are the std::math shapes:
# Quantity[U, S1].mul_price(p) and Price[C, U, S2].mul_quantity(q)
# return the SAME Money[C, S1 + S2] (the quantity's unit is the price's
# own U by construction — a Quantity[Barrel, ...] argument never
# typechecks against a Price[_, Share, _]), Money[C, S].mul_rate(r)
# returns Money[C, S + RS], and every product is exact up to the
# 64-bit word (Option::None on overflow — never a wrap).  The method
# generics mirror the std machinery: mul_quantity carries a method-level
# const QS; mul_price carries a method-level TYPE param C2 (solved from
# the price argument) plus a const PS — the same shape std::math uses.
use std::core

struct USD
end

struct EUR
end

struct Share
end

struct Barrel
end

struct BasisPoint
end

struct Percent
end

struct Money[C, const SCALE: Int]
  unscaled: Int
end

struct Price[C, U, const SCALE: Int]
  unscaled: Int
end

struct Quantity[U, const SCALE: Int]
  unscaled: Int
end

struct Rate[RU, const SCALE: Int]
  unscaled: Int
end

# Exact checked word product (the std _fx_mul64_word shape): magnitudes
# through the unsigned 64-bit view, product in u128, the 2^63 word bound
# applied to the exact result; Option::None is the overflow report.
def mul_word(a: Int, b: Int) -> Option[Int]
  if a == 0 || b == 0 then return Option::Some(0) end
  let ma: u128 = if a < 0 then ((0 as u64) - (a as u64)) as u128 else (a as u64) as u128 end
  let mb: u128 = if b < 0 then ((0 as u64) - (b as u64)) as u128 else (b as u64) as u128 end
  let p = ma * mb
  let neg = (a < 0) != (b < 0)
  let lim_neg = (((~(0 as u64)) >> 1) as u128) + 1
  if p > lim_neg then return Option::None end
  if !neg && p == lim_neg then return Option::None end
  var w: Int = if p == 0 then 0 else (if neg then ((0 as u64) - (p as u64)) as Int else (p as u64) as Int end) end
  Option::Some(w)
end

impl[C, U, const SCALE: Int] Price[C, U, SCALE]
  def from_parts(unscaled: Int) -> Price[C, U, SCALE]
    Price[C, U, SCALE] { unscaled: unscaled }
  end

  def mul_quantity[const QS: Int](self, q: Quantity[U, QS]) -> Option[Money[C, SCALE + QS]]
    match mul_word(self.unscaled, q.unscaled)
    when Option::Some(w) then Option::Some(Money[C, SCALE + QS] { unscaled: w })
    when Option::None then Option::None
    end
  end
end

impl[U, const SCALE: Int] Quantity[U, SCALE]
  def from_parts(unscaled: Int) -> Quantity[U, SCALE]
    Quantity[U, SCALE] { unscaled: unscaled }
  end

  def mul_price[C2, const PS: Int](self, price: Price[C2, U, PS]) -> Option[Money[C2, SCALE + PS]]
    match mul_word(self.unscaled, price.unscaled)
    when Option::Some(w) then Option::Some(Money[C2, SCALE + PS] { unscaled: w })
    when Option::None then Option::None
    end
  end
end

impl[C, const SCALE: Int] Money[C, SCALE]
  def from_minor(minor: Int) -> Money[C, SCALE]
    Money[C, SCALE] { unscaled: minor }
  end

  def scale(self) -> Int
    SCALE
  end

  def unscaled(self) -> Int
    self.unscaled
  end

  def mul_rate[RU2, const RS: Int](self, rate: Rate[RU2, RS]) -> Option[Money[C, SCALE + RS]]
    match mul_word(self.unscaled, rate.unscaled)
    when Option::Some(w) then Option::Some(Money[C, SCALE + RS] { unscaled: w })
    when Option::None then Option::None
    end
  end
end

impl[RU, const SCALE: Int] Rate[RU, SCALE]
  def from_parts(unscaled: Int) -> Rate[RU, SCALE]
    Rate[RU, SCALE] { unscaled: unscaled }
  end

  def scale(self) -> Int
    SCALE
  end
end

def run() -> Int
  # 100 shares at 12.3456 USD/share = 1234.5600 USD (Money at scale 4):
  # the audit's summed-scale product, both spellings.
  let q: Quantity[Share, 0] = Quantity[Share, 0]::from_parts(100)
  let p: Price[USD, Share, 4] = Price[USD, Share, 4]::from_parts(123456)
  match q.mul_price(p)
  when Option::Some(v) then
    if v.unscaled() != 12345600 then
      return 1
    end
    if v.scale() != 4 then
      return 2
    end
  when Option::None then
    return 3
  end
  match p.mul_quantity(q)
  when Option::Some(v) then
    if v.unscaled() != 12345600 then
      return 4
    end
    if v.scale() != 4 then
      return 5
    end
  when Option::None then
    return 6
  end
  # A negative quantity product carries the sign through the same type.
  let nq: Quantity[Share, 0] = Quantity[Share, 0]::from_parts(-100)
  match nq.mul_price(p)
  when Option::Some(v) then
    if v.unscaled() != -12345600 then
      return 7
    end
  when Option::None then
    return 8
  end
  # Money * decimal rate: 12.34 USD * (500 bps as 0.0500 at scale 4) =
  # 0.617000 USD at scale 6; and 12.34 * 5% (0.05 at scale 2) =
  # 0.6170 USD at scale 4.
  let usd: Money[USD, 2] = Money[USD, 2]::from_minor(1234)
  let bps: Rate[BasisPoint, 4] = Rate[BasisPoint, 4]::from_parts(500)
  if bps.scale() != 4 then
    return 9
  end
  match usd.mul_rate(bps)
  when Option::Some(v) then
    if v.unscaled() != 617000 then
      return 10
    end
    if v.scale() != 6 then
      return 11
    end
  when Option::None then
    return 12
  end
  let pct: Rate[Percent, 2] = Rate[Percent, 2]::from_parts(5)
  match usd.mul_rate(pct)
  when Option::Some(v) then
    if v.unscaled() != 6170 then
      return 13
    end
    if v.scale() != 4 then
      return 14
    end
  when Option::None then
    return 15
  end
  # A zero operand product still carries the summed const scale (3 + 2).
  let q0: Quantity[Share, 3] = Quantity[Share, 3]::from_parts(0)
  let p2: Price[USD, Share, 2] = Price[USD, Share, 2]::from_parts(1234)
  match q0.mul_price(p2)
  when Option::Some(v) then
    if v.unscaled() != 0 then
      return 16
    end
    if v.scale() != 5 then
      return 17
    end
  when Option::None then
    return 18
  end
  # Word overflow is Option::None: (10^10) * (10^9) = 10^19 > 2^63 - 1.
  let huge: Quantity[Share, 0] = Quantity[Share, 0]::from_parts(10000000000)
  let p3: Price[USD, Share, 0] = Price[USD, Share, 0]::from_parts(1000000000)
  match huge.mul_price(p3)
  when Option::Some(_) then
    return 19
  when Option::None then
    ()
  end
  match p3.mul_quantity(huge)
  when Option::Some(_) then
    return 20
  when Option::None then
    ()
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_dim_price_quantity_rate: FAIL " + ok.to_string())
    1
  end
end
