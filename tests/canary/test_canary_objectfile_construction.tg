# tests/canary/test_canary_objectfile_construction.tg
# Native canary: ObjectFile construction. Exercises the native object
# writer: build an ObjectFile, verify its empty section accounting, then
# serialize it to Mach-O and confirm the image starts with the Mach-O 64
# magic (CF FA ED FE). Catches broken object-file struct layout.
#
# Failure class: OBJECT_FILE_BUG / TARGET_DESCRIPTOR_BUG

use std::core
use tg_compiler::asm::{Arch, OsAbi, asm_target}
use tg_compiler::object::{object_new, object_text_len, object_data_len,
                          object_rodata_len, object_bss_size, build_object}

def check_empty_object_accounting() -> Bool
  let obj = object_new(asm_target(Arch::AArch64, OsAbi::MacOS))
  object_text_len(&obj) == 0 && object_data_len(&obj) == 0 &&
  object_rodata_len(&obj) == 0 && object_bss_size(&obj) == 0
end

def check_macho_magic_from_object() -> Bool
  let obj = object_new(asm_target(Arch::AArch64, OsAbi::MacOS))
  let bytes = build_object(&obj)
  if bytes.len() < 4 then
    return false
  end
  # Mach-O 64-bit magic: 0xCF 0xFA 0xED 0xFE
  bytes[0] == (0xCF as u8) && bytes[1] == (0xFA as u8) &&
  bytes[2] == (0xED as u8) && bytes[3] == (0xFE as u8)
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_empty_object_accounting() then
    passed = passed + 1
    println("[PASS] object_accounting")
  else
    failed = failed + 1
    println("[FAIL] object_accounting")
  end

  if check_macho_magic_from_object() then
    passed = passed + 1
    println("[PASS] object_macho_magic")
  else
    failed = failed + 1
    println("[FAIL] object_macho_magic")
  end

  println("canary_objectfile_construction: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
