use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def check_auto_deinit_once() -> Bool
  let r = R { a: 1 }
  r.a == 1
end

def check_every_arm_consumes() -> Bool
  let r = R { a: 1 }
  if r.a > 0 then
    let ra = r
    let va = ra.a
  else
    let rb = r
    let vb = rb.a
  end
  true
end

def check_loop_created_consumed_per_iteration() -> Bool
  mut n = 0
  loop do
    let rl = R { a: 1 }
    consume_r(rl)
    n = n + 1
    if n >= 3 then
      break
    end
  end
  n == 3
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_auto_deinit_once() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] auto_deinit_once")
  end

  if check_every_arm_consumes() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] every_arm_consumes")
  end

  if check_loop_created_consumed_per_iteration() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] loop_created_consumed_per_iteration")
  end

  println("canary_resource: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
