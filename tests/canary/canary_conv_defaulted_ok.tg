# Positive conformance canary (l): a missing method is allowed ONLY when
# the trait provides a DEFAULT body for it — the impl of `ConvDefaulted`
# provides only `required` and omits the defaulted `defaulted`, which must
# be ACCEPTED (the conformance validation admits the impl).
use std::core

trait ConvDefaulted
  def required(self: Self) -> Int

  def defaulted(self: Self) -> Int
    42
  end
end

struct DefaultedImpl
  v: Int
end

impl ConvDefaulted for DefaultedImpl
  def required(self: DefaultedImpl) -> Int
    self.v
  end
end

def main() -> Int
  let x = DefaultedImpl { v: 7 }
  x.required()
end
