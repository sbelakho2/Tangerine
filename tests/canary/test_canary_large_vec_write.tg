# tests/canary/test_canary_large_vec_write.tg
# Native canary: large Vec write. Builds a large Vec of integers and
# writes it out through a single contiguous write path, verifying length
# and spot-checked contents. Catches truncated writes and bad store widths
# at scale (the LDRB/STRB register-encoding bug class).
#
# Failure class: COST_TOO_HIGH / CODE_GEN_BUG

use std::core

def build_vec(width: Int) -> Vec[Int]
  mut v: Vec[Int] = Vec::new()
  mut i = 0
  while i < width do
    v.push(i)
    i = i + 1
  end
  v
end

def sum_vec(v: &Vec[Int]) -> Int
  mut total = 0
  mut i = 0
  while i < v.len() do
    total = total + v[i]
    i = i + 1
  end
  total
end

def check_large_vec_write_integrity() -> Bool
  let v = build_vec(5000)
  if v.len() != 5000 then
    return false
  end
  v[0] == 0 && v[2499] == 2499 && v[4999] == 4999
end

def check_large_vec_write_sum() -> Bool
  let v = build_vec(1000)
  # Sum 0..999 == 499500
  sum_vec(&v) == 499500
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_large_vec_write_integrity() then
    passed = passed + 1
    println("[PASS] large_vec_write_integrity")
  else
    failed = failed + 1
    println("[FAIL] large_vec_write_integrity")
  end

  if check_large_vec_write_sum() then
    passed = passed + 1
    println("[PASS] large_vec_write_sum")
  else
    failed = failed + 1
    println("[FAIL] large_vec_write_sum")
  end

  println("canary_large_vec_write: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
