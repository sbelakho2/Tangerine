# Positive canary: a closure capturing a UniquePtr (an owning VALUE, not a
# resource kind) receives the same ownership semantics as a plain move:
# the capture is a Consume capture lowered as MirConsume, and the payload
# is dropped exactly once when the closure dies.
use std::core
use std::alloc

static mut payload_drops: Int = 0

struct Payload
  id: Int
end

impl Drop for Payload
  def drop(self: &mut Payload) -> Unit
    payload_drops = payload_drops + 1
  end
end

def main() -> Int
  do
    let a = system_allocator()
    let p = unique_ptr_new(Payload { id: 1 }, &a)
    let c = || p
    c()
  end
  if payload_drops == 1 then
    0
  else
    println("canary_pos_closure_capture_owner: FAIL payload_drops=" + payload_drops.to_string())
    1
  end
end
