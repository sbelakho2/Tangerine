# Positive canary: Rc[Int] participates in finalization. The registered Drop
# impl decrements the strong count and destroys/deallocs at zero. Cloning
# shares one allocation; strong_count must observe 2 while both live. The
# exactly-once release is the scope-end drop of both clones (a double-drop
# would corrupt the count and crash the destructor at zero).
use std::core
use std::alloc

def main() -> Int
  let r = rc_new(42)
  let r2 = r.clone()
  let count = r.strong_count()
  if count == 2 then
    0
  else
    println("canary_pos_smart_rc: FAIL strong_count=" + count.to_string())
    1
  end
end
