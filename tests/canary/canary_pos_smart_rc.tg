# Positive canary: Rc destruction is OBSERVABLE — the strong count drops from
# 2 to 1 when the inner clone's scope ends, and the final release (count 1 ->
# 0) destroys the payload through its registered Drop. A no-op destructor
# would leave the count at 2 and payload_drops at 0.
use std::core
use std::alloc

static mut payload_drops: Int = 0

struct Payload
  id: Int
end

impl Drop for Payload
  def drop(self: &mut Payload) -> Unit
    payload_drops = payload_drops + 1
  end
end

def rc_scope() -> Int
  # Separate the STATUS result from the payload-drop counter: rc_scope
  # returns the status (0 = the nested release behaved), while main()
  # inspects the global payload_drops counter for the final release.
  let status = do
    let r = rc_new(Payload { id: 1 })
    do
      let r2 = r.clone()
    end
    let c1 = r.strong_count()
    if c1 != 1 then
      println("canary_pos_smart_rc: strong_count=" + c1.to_string())
      1
    else
      0
    end
  end
  status
end

def main() -> Int
  let ok = rc_scope()
  if ok == 0 && payload_drops == 1 then
    0
  else
    println("canary_pos_smart_rc: FAIL ok=" + ok.to_string() + " payload_drops=" + payload_drops.to_string())
    1
  end
end
