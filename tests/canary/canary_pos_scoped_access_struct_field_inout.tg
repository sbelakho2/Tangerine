# Positive scoped-access canary (audit §12): a with-scoped access over an
# OWNING STRUCT field mutates the struct's own storage in place through
# projected stores under `as inout` (the zero-copy place-access model) —
# the field's qty changes are visible after the block, and a nested pair
# of with-blocks over the TWO DISJOINT struct fields (both `as inout`)
# coexists (the audit conflict matrix: modify of different fields is
# allowed).
use std::core

def read_len(s: String) -> Int
  s.len()
end

struct Level
  qty: Int
  label: String
end

struct Book
  level: Level
  name: String
end

def check_struct_field_inout() -> Bool
  mut b = Book { level: Level { qty: 1, label: "a" + "" }, name: "n" + "" }
  with b.level as inout lv
    lv.qty = lv.qty + 41
    lv.label.push('!')
  end
  if b.level.qty != 42 then
    return false
  end
  with b.level.label as let check
    read_len(check) == 2
  end
end

def check_disjoint_field_modifies() -> Bool
  mut b = Book { level: Level { qty: 1, label: "a" + "" }, name: "n" + "" }
  with b.level as inout lv
    with b.name as inout nm
      lv.qty = lv.qty + 40
      nm.push('x')
    end
  end
  if b.level.qty != 41 then
    return false
  end
  with b.name as let check
    read_len(check) == 2
  end
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_struct_field_inout() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] struct_field_inout")
  end

  if check_disjoint_field_modifies() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] disjoint_field_modifies")
  end

  println("canary_pos_scoped_access_struct_field_inout: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
