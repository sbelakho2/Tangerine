# Positive canary: the NESTED chain (the mandate's canary (c)).
# `let f = o.inner.a` moves the nested field out — the registry records
# the semantic chain inner.a and the scope-exit drop recurses: o's field
# inner is dropped through its own glue with the inner mask {b} (a's dead
# storage skipped). Deinit counts: the extracted f finalizes at the scope
# exit, and o.inner.b finalizes through the nested partial chain — exactly
# 2 deinitializations.
use std::core

static mut file_deinit_count: Int = 0

resource File
  fd: Int
  def deinit(sink self: Self) -> Unit
    file_deinit_count = file_deinit_count + 1
  end
end

resource Inner
  a: File
  b: File
end

resource Outer
  inner: Inner
  tag: Int
end

def run() -> Int
  let o = Outer { inner: Inner { a: File { fd: 1 }, b: File { fd: 2 } }, tag: 7 }
  let f = o.inner.a
  if f.fd == 1 && o.inner.b.fd == 2 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && file_deinit_count == 2 then
    0
  else
    println("canary_pos_resource_partial_nested: FAIL ok=" + ok.to_string() + " deinit_count=" + file_deinit_count.to_string())
    1
  end
end
