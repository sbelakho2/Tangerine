# tests/canary/test_canary_file_io.tg
# Native canary: file I/O. Writes a payload to disk and reads it back,
# verifying byte-for-byte round-trip. Catches FS-call ABI errors and
# wrong write sizes in the runtime linkage.
#
# Failure class: FFI_BUG / RUNTIME_FS_BUG

use std::core
use std::fs

def roundtrip(path: String, payload: String) -> Bool
  match fs::write_file(path, payload)
  when Result::Err(_) then
    println("[io] write failed for " + path)
    return false
  when Result::Ok(_) then ()
  end

  let back = match fs::read_file(path)
  when Result::Err(_) then
    println("[io] read failed for " + path)
    return false
  when Result::Ok(text) then
    text
  end

  back == payload
end

def check_write_read_roundtrip() -> Bool
  roundtrip("build/canary_file_io.txt", "canary file io payload")
end

def check_roundtrip_preserves_length() -> Bool
  roundtrip("build/canary_file_io_len.txt", "abcdefghijklmnopqrstuvwxyz0123456789")
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_write_read_roundtrip() then
    passed = passed + 1
    println("[PASS] file_io_roundtrip")
  else
    failed = failed + 1
    println("[FAIL] file_io_roundtrip")
  end

  if check_roundtrip_preserves_length() then
    passed = passed + 1
    println("[PASS] file_io_length")
  else
    failed = failed + 1
    println("[FAIL] file_io_length")
  end

  println("canary_file_io: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
