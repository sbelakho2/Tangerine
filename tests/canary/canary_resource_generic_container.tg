use std::core

resource Box[T]
  item: T
  def deinit(sink x: Int) -> Unit
  end
end

resource R
  a: Int
end

def make_box() -> Box[R]
  let r = R { a: 5 }
  Box { item: r }
end

def check_containment() -> Bool
  let b = make_box()
  b.item.a == 5
end

def run() -> Int
  if check_containment() then
    println("canary_resource_generic_container: OK")
    0
  else
    println("canary_resource_generic_container: FAIL")
    1
  end
end

def main() -> Int
  run()
end
