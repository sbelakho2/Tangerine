# Positive canary (§20 slice 3): a const generic parameter's per-instance
# VALUE used in BODY ARITHMETIC — `N` as a loop bound inside the generic
# body, `def sum_to[const N: UInt]()` instantiated explicitly at 4 and at
# 8 (sums 1..4 = 10 and 1..8 = 36). The parameter's declared scalar type
# is UInt; the read types as UInt and the loop bound crosses to the Int
# counter through an explicit cast, keeping the declared-type range
# semantics of the parameter's value.
use std::core

def sum_to[const N: UInt]() -> Int
  var total = 0
  var i: Int = 0
  while i < N as Int do
    total = total + i + 1
    i = i + 1
  end
  total
end

def run() -> Int
  if sum_to[4]() != 10 then
    return 1
  end
  if sum_to[8]() != 36 then
    return 2
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_const_generic_value_loop_bound: FAIL " + ok.to_string())
    1
  end
end
