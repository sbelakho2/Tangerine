# Positive budget canary — NESTED budgeted calls: `outer()` (budget
# alloc: "2", two allocations of its own) calls `inner()` (budget alloc:
# "1", one allocation). Each invocation enforces its OWN frame-slot
# counter: inner's frame counts 1 (within 1), outer's frame counts its
# own 2 (within 2 — the call into inner() consumes nothing in outer's
# frame). Under the old GLOBAL counters the inner call would have shared
# outer's counter (and overwritten the shared time stamp); the per-frame
# slots make nesting natural — the inner invocation's frame is separate.
# Exit 0 required.
def inner() -> Int @budget alloc: "1"
  let v = Vec[Int]::new()
  v.push(1)
  0
end

def outer() -> Int @budget alloc: "2"
  let v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  let _ = inner()
  0
end

def main() -> Int
  outer()
end
