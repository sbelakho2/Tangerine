# Positive canary: a sink resource parameter with an EXPLICIT early return.
# The callee must finalize the sink param on the return EDGE (the pre-return
# cleanup obligation "return::<stmt id>"), not only on fallthrough exit.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def consume_early(sink r: Probe, trigger: Bool) -> Int
  if trigger then
    return 1
  end
  0
end

def main() -> Int
  let p = Probe { id: 1 }
  let code = consume_early(p, true)
  if code == 1 && deinit_count == 1 then
    0
  else
    println("canary_pos_resource_sink_explicit_return: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
