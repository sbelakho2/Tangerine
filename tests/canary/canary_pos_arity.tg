# Positive canary: correct-arity calls (including higher-order) must compile
# and run — the paired positive of the arity negative canaries.
use std::core

def add(a: Int, b: Int) -> Int
  a + b
end

def apply(f: fn(Int, Int) -> Int, a: Int, b: Int) -> Int
  f(a, b)
end

def main() -> Int
  let x = add(1, 2)
  let y = apply(add, 3, 4)
  if x != 3 || y != 7 then
    1
  else
    0
  end
end
