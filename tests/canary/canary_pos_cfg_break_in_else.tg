# Positive canary — the BREAK-IN-ELSE boundary: a resource created in
# the ELSE arm of an if inside a loop is finalized EXACTLY ONCE by the
# break edge (the arm's break exits the loop; the break-edge cleanup
# must finalize only the else-arm's local — never the pre-loop frame,
# never twice). The closest program to the double-finalization failure
# mode: the resource is NOT dropped in the arm — the break edge alone
# owns its finalization.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def main() -> Int
  var i = 0
  loop
    i = i + 1
    if i < 2 then
      ()
    else
      let p = Probe { id: i }
      break
    end
  end
  if deinit_count == 1 then
    0
  else
    println("canary_pos_cfg_break_in_else: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
