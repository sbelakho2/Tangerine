# Positive canary (§20 const generics, slice 4 — declared range
# constraints): the IN-RANGE boundary scales of the std::math const-scale
# decimals FORM and work — Decimal64[18] (declared range 0..=18) and
# Decimal128[38] (declared range 0..=38) parse, format and construct, and
# Decimal64[0] coexists as a distinct in-range instance. The out-of-range
# instantiations are the negative canaries: Decimal64[19], Decimal64[-1]
# and Decimal128[39] are rejected at TYPE FORMATION (the
# `const SCALE: Int in ...` clause on the struct parameter is enforced
# when the concrete type is written), never at a later method call.
use std::core
use std::math::{Decimal64, Decimal128}

def run() -> Int
  let d18: Decimal64[18] = Decimal64[18]::from_string("1.0".to_string()).unwrap()
  if d18.scale() != 18 then
    return 1
  end
  if d18.to_string() != "1.000000000000000000" then
    return 2
  end
  let d18b: Decimal64[18] = Decimal64[18]::from_parts(123456789012345678)
  let sum = d18.add(d18b).unwrap()
  if sum.scale() != 18 then
    return 3
  end
  if sum.to_string() != "1.123456789012345678" then
    return 4
  end
  let d0: Decimal64[0] = Decimal64[0]::from_int(7)
  if d0.scale() != 0 then
    return 5
  end
  if d0.to_string() != "7" then
    return 6
  end
  let w38: Decimal128[38] = Decimal128[38]::from_string("1.0".to_string()).unwrap()
  if w38.scale() != 38 then
    return 7
  end
  if w38.to_string() != "1.00000000000000000000000000000000000000" then
    return 8
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_decimal_scale_range: FAIL " + ok.to_string())
    1
  end
end
