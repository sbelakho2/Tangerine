# Positive canary: while-loop iteration resources are finalized EXACTLY once
# per completed iteration — by the backedge. The condition-false exit runs
# NO additional cleanup (the last iteration's resource was already finalized
# before the header re-check), so the count is exactly 3, not 6.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def main() -> Int
  var i = 0
  while i < 3 do
    let p = Probe { id: i }
    i = i + 1
  end
  if deinit_count == 3 then
    0
  else
    println("canary_pos_resource_while_auto_clean: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
