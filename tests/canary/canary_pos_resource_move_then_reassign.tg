# Positive canary — the WHOLE-VALUE move-then-reassign boundary (the
# paired positive of canary_neg_resource_use_after_consume.tg / the
# whole-root mirror of canary_pos_resource_partial_reassign.tg). After
# `let r2 = r` the whole local's storage is Consumed; the assignment
# `r = R { ... }` re-lives the slot WITHOUT a drop-before-store (dead
# storage never drops — the checker's assign transition), and the scope
# exit finalizes the re-stored r and the moved-out r2 — exactly 2
# deinitializations, the consumed storage never re-dropped.
use std::core

static mut deinit_count: Int = 0

resource R
  a: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def run() -> Int
  var r = R { a: 1 }
  let r2 = r
  r = R { a: 2 }
  if r.a == 2 && r2.a == 1 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && deinit_count == 2 then
    0
  else
    println("canary_pos_resource_move_then_reassign: FAIL ok=" + ok.to_string() + " deinit_count=" + deinit_count.to_string())
    1
  end
end
