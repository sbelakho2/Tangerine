# Positive canary: a resource created in a nested block that ends with a
# break is finalized EXACTLY ONCE — by the break edge (never also by the
# block-exit obligation).
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def main() -> Int
  var i = 0
  loop
    i = i + 1
    if i == 1 then
      let p = Probe { id: 1 }
      break
    end
  end
  if deinit_count == 1 then
    0
  else
    println("canary_pos_resource_nested_break: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
