# Positive canary (access matrix — the seed's Consume-of-Copy rule): a
# SINK argument whose value is Copy is a COPY — the recorded access effect
# downgrades Consume to Read, so `take_copy(x, x)` (a sink and a read of
# the same Copy-typed local in one statement group) must NOT be an access
# conflict. And an unresolved enum-constructor path (`Option::None`) is an
# rvalue with NO place (the seed records none), so it never pairs with a
# receiver's `modify` — the `buf.push(Option::None)` false-positive shape.
use std::core

def fill(inout slot: Option[Int], sink val: Option[Int]) -> Unit
  slot = val
end

def take_copy(sink a: Int, b: Int) -> Int
  a + b
end

def main() -> Int
  var slot: Option[Int] = Option::Some(1)
  fill(slot, Option::None)
  match slot
  when Option::Some(_) then
    return 1
  when Option::None then ()
  end
  if take_copy(41, 41) != 82 then
    return 1
  end
  let x = 21
  if take_copy(x, x) != 42 then
    return 1
  end
  0
end
