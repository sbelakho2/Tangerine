# Positive canary: UniquePtr[Payload] destruction is OBSERVABLE — the
# registered UniquePtr__drop runs drop_in_place() on the pointee (Payload's
# own Drop) and deallocates through the allocator.
use std::core
use std::alloc

static mut payload_drops: Int = 0

struct Payload
  id: Int
end

impl Drop for Payload
  def drop(self: &mut Payload) -> Unit
    payload_drops = payload_drops + 1
  end
end

def unique_scope() -> Int
  do
    let a = system_allocator()
    let u = unique_ptr_new(Payload { id: 1 }, &a)
  end
  0
end

def main() -> Int
  let ok = unique_scope()
  if ok == 0 && payload_drops == 1 then
    0
  else
    println("canary_pos_smart_unique_ptr: FAIL payload_drops=" + payload_drops.to_string())
    1
  end
end
