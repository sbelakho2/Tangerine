# Positive canary: UniquePtr[Int] — a named smart pointer with a registered
# Drop — participates in finalization even though Int is not a resource.
# The drop runs drop_in_place + deallocate via the allocator at scope end.
use std::core
use std::alloc

def main() -> Int
  let a = system_allocator()
  let u = unique_ptr_new(7, &a)
  # the registered UniquePtr__deinit runs at scope end: drop_in_place on the
  # pointee and deallocate through the allocator
  0
end
