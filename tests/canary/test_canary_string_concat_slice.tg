# tests/canary/test_canary_string_concat_slice.tg
# Native canary: String concatenation and slicing.
# Verifies + builds valid content, slice bounds are honored, and
# concatenation does not clobber the source strings (the historical
# str_concat / str_slice crash class on ARM64).
#
# Failure class: STRING_BUG / RUNTIME_STRING_BUG

use std::core

def check_concat() -> Bool
  let a = "hello"
  let b = " "
  let c = "world"
  let joined = a + b + c
  joined == "hello world" && joined.len() == 11
end

def check_slice() -> Bool
  let s = "TangerineCompiler"
  s.slice(0, 5) == "Tange" &&
  s.slice(5, 10) == "rine" &&
  s.slice(10, 18) == "Compiler"
end

def check_slice_prefix_suffix() -> Bool
  let s = "prefix-middle-suffix"
  s.starts_with("prefix") && s.ends_with("suffix") && !s.starts_with("nope")
end

def check_concat_preserves_sources() -> Bool
  let x = "alpha"
  let y = "beta"
  let z = x + y
  x == "alpha" && y == "beta" && z == "alphabeta"
end

def check_repeated_concat_growth() -> Bool
  mut s = ""
  mut i = 0
  while i < 100 do
    s = s + "x"
    i = i + 1
  end
  s.len() == 100 && s.starts_with("xxx") && s.ends_with("xxx")
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_concat() then
    passed = passed + 1
    println("[PASS] concat")
  else
    failed = failed + 1
    println("[FAIL] concat")
  end

  if check_slice() then
    passed = passed + 1
    println("[PASS] slice")
  else
    failed = failed + 1
    println("[FAIL] slice")
  end

  if check_slice_prefix_suffix() then
    passed = passed + 1
    println("[PASS] slice_prefix_suffix")
  else
    failed = failed + 1
    println("[FAIL] slice_prefix_suffix")
  end

  if check_concat_preserves_sources() then
    passed = passed + 1
    println("[PASS] concat_preserves_sources")
  else
    failed = failed + 1
    println("[FAIL] concat_preserves_sources")
  end

  if check_repeated_concat_growth() then
    passed = passed + 1
    println("[PASS] repeated_concat_growth")
  else
    failed = failed + 1
    println("[FAIL] repeated_concat_growth")
  end

  println("canary_string_concat_slice: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
