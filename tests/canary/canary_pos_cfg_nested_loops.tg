# Nested loops: the outer and inner loop bodies each carry per-iteration
# owned locals (the Strings); the per-iteration drops attach to the
# backedge plans; the frames stay distinct across the nesting.
def main() -> Int
  var total = 0
  for i in 0..3 do
    for j in 0..3 do
      let tag = "ij".to_string()
      total = total + i + j + tag.len()
    end
  end
  return total
end
