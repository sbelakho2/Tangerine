# Positive canary (the reviewer's P0 checker-pair — the generic-T
# returning side): a GENUINELY generic body. `def id[T](x: T) -> T` is
# generic in the honest sense: the body returns the parameter itself, so
# the tail unification is Param(T) vs Param(T) — never a concrete type
# smuggled under the arbitrary T (the Unit-as-T construct is the paired
# canary_neg_generic_body_unit_as_t). Two instances (T=Int, T=String)
# run the same generic body; each returns its own concrete value.
use std::core

def id[T](x: T) -> T
  x
end

def run() -> Int
  let a = id(5)
  if a != 5 then return 1 end
  let b = id(7)
  if b != 7 then return 1 end
  let s = id("generic body, genuinely generic")
  if s.len() != 31 then return 1 end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_generic_body_identity: FAIL")
    1
  end
end
