# Positive purity canary (third-audit item 25): a `pure` function calling
# another PROVEN-PURE function — the transitive fixed point extends the
# proof through the in-program call edge, so both functions are
# ProvenPure and the E0234 enforcement accepts the annotations.
pure def double(n: Int) -> Int
  n + n
end

pure def quadruple(n: Int) -> Int
  double(double(n))
end

def main() -> Int
  if quadruple(3) == 12 then
    0
  else
    1
  end
end
