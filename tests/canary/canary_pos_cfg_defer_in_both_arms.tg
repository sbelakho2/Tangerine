# Positive canary — the DEFER-IN-BOTH-ARMS boundary: the same `defer
# drop(r)` registered on BOTH arms of an if. Each arm's defer runs at
# its arm's scope exit; the joined state must NOT double-register or
# double-finalize the resource — the finalizer runs EXACTLY ONCE per
# call (one call with flag true, one with flag false: exactly 2
# destructor calls total). A defer implementation that ran the arm
# defer AND the scope-exit chain would double-drop — the counter pins
# the single finalization.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def defer_both_arms(flag: Bool) -> Unit
  let p = Probe { id: 7 }
  if flag then
    defer
      drop(p)
    end
  else
    defer
      drop(p)
    end
  end
end

def main() -> Int
  defer_both_arms(true)
  defer_both_arms(false)
  if deinit_count == 2 then
    0
  else
    println("canary_pos_cfg_defer_in_both_arms: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
