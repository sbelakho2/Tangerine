use std::core

resource R
  a: Int
end

def consume_r(sink r: R) -> Unit
end

def check_every_arm_consumes() -> Bool
  let r = R { a: 1 }
  if r.a > 0 then
    consume_r(r)
  else
    consume_r(r)
  end
  let s = R { a: 2 }
  s.a == 2
end

def run() -> Int
  if check_every_arm_consumes() then
    println("canary_resource_branch_consume: OK")
    0
  else
    println("canary_resource_branch_consume: FAIL")
    1
  end
end

def main() -> Int
  run()
end
