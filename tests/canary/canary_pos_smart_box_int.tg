# Positive canary: Box[Payload] destruction is OBSERVABLE — the registered
# Box__drop runs drop_in_place() on the pointee (which invokes Payload's own
# Drop) and deallocates. The payload-drop counter proves the release ran.
use std::core
use std::alloc

static mut payload_drops: Int = 0

struct Payload
  id: Int
end

impl Drop for Payload
  def drop(self: &mut Payload) -> Unit
    payload_drops = payload_drops + 1
  end
end

def box_scope() -> Int
  do
    let b = box_new(Payload { id: 1 })
    let v = *b.get()
    if v.id != 1 then
      return 1
    end
  end
  0
end

def main() -> Int
  let ok = box_scope()
  if ok == 0 && payload_drops == 1 then
    0
  else
    println("canary_pos_smart_box_int: FAIL ok=" + ok.to_string() + " payload_drops=" + payload_drops.to_string())
    1
  end
end
