# Positive canary: Box[Int] — an owning allocation with NO resource inside —
# still participates in finalization. The registered Drop impl (drop_in_place
# + dealloc) runs when the box goes out of scope; the box value is readable
# before that. This exercises the unconditional smart-pointer registration
# (Box locals are finalized even when the pointee is not a resource).
use std::core
use std::alloc

def main() -> Int
  let b = box_new(42)
  let v = b.get()
  if v == 42 then
    0
  else
    println("canary_pos_smart_box_int: FAIL v=" + v.to_string())
    1
  end
end
