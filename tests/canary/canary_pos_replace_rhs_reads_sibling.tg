# Positive canary (audit: replace_rhs_reads_sibling): the exact-place
# replacement with a RHS that READS a disjoint sibling chain of the same
# root — `p.a = ... p.b ...`. The exact drop destroys only p.a's old
# value; the sibling read (p.b.id — an Int read out of the live sibling)
# is unaffected and the sibling stays live. Deinit counts: old p.a at
# the replacement; the new p.a and p.b at the scope exit — exactly 3.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Pair
  a: Probe
  b: Probe
end

def run() -> Int
  let mut p = Pair { a: Probe { id: 1 }, b: Probe { id: 5 } }
  # the RHS reads the sibling chain (p.b) while p.a is being replaced —
  # the drop-before-store destroys only p.a's own storage
  p.a = Probe { id: p.b.id + 1 }
  if p.a.id == 6 && p.b.id == 5 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 3 then
    0
  else
    println("canary_pos_replace_rhs_reads_sibling: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
