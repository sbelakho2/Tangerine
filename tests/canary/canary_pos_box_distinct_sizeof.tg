# Positive canary: size_of[Box[T]] is the WRAPPER's pointer size, distinct
# from the content's size — Box[{u8;16}] is 8 bytes, [{u8;16}] is 16.
use std::alloc

def main() -> Int
  let box_size = size_of[Box[[u8; 16]]]()
  let raw_size = size_of[[u8; 16]]()
  if box_size == 8 && raw_size == 16 && box_size != raw_size then
    0
  else
    1
  end
end
