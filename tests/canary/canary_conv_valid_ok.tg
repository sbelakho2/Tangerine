# Positive conformance canary (m): a fully conformant trait impl — every
# required method present, no unknown members, exact parameter counts,
# exact access conventions, unifying parameter and return types — must be
# ACCEPTED and registered (the conformance validation admits the impl).
use std::core

trait ConvValid
  def get(self: Self) -> Int
  def set(inout self: Self, v: Int) -> Unit
end

struct ValidImpl
  v: Int
end

impl ConvValid for ValidImpl
  def get(self: ValidImpl) -> Int
    self.v
  end

  def set(inout self: ValidImpl, v: Int) -> Unit
    self.v = v
  end
end

def main() -> Int
  mut x = ValidImpl { v: 0 }
  x.set(41)
  x.get() + 1
end
