# Positive canary (audit: replace_live_field_drops_old_exactly_once):
# assigning over a LIVE OWNING projected place is the EXACT-PLACE
# replacement — the assign-drop chain destroys ONLY the old value of the
# target place itself (old p.a); the sibling p.b is never touched by the
# replacement: it stays live and is READ AFTER the store, then finalizes
# at the scope exit. Deinit counts: p.a_old at the replacement, p.b and
# the new p.a at the scope exit — exactly 3 deinitializations, every
# sibling drops exactly once, no double drop.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Pair
  a: Probe
  b: Probe
end

def run() -> Int
  let mut p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  p.a = Probe { id: 3 }
  # the sibling b survived the replacement — still live and readable
  if p.a.id == 3 && p.b.id == 2 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 3 then
    0
  else
    println("canary_pos_resource_projected_assign: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
