# Positive canary: assigning over a LIVE OWNING projected place is the
# whole-root drop-before-store case — the assign-drop chain destroys the
# whole root (the old a and the sibling b), the store re-lives a, and the
# scope-exit partial drop (masked to the re-stored a only) finalizes the
# new value. Deinit counts: a_old + b via the assign-drop chain, the new a
# at the scope exit — exactly 3 deinitializations, no double drop.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Pair
  a: Probe
  b: Probe
end

def run() -> Int
  let mut p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  p.a = Probe { id: 3 }
  if p.a.id == 3 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 3 then
    0
  else
    println("canary_pos_resource_projected_assign: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
