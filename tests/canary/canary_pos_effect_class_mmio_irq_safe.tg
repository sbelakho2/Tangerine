# Positive effect-class canary (audit §11): @irq_safe PROVES a volatile
# MMIO register read — the _tg_volatile_read32 extern is a width-exact
# volatile memory access (never allocation/blocking/OS I/O); its effect
# record carries the MMIO (hardware-register) capability instead of the
# Io class, so the P1-16 interrupt-handler checklist's permitted MMIO
# access stays permitted under the irq-safe proof. The canary compiles
# the annotated handler-shaped function and runs main (exit 0) — the
# peek is never executed at runtime.
use std::core
use std::embedded::volatile_read32

@irq_safe
def peek_uart() -> u32
  volatile_read32(0x40000000)
end

def main() -> Int
  0
end
