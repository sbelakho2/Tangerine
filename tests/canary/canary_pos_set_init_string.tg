# Positive canary: Set[String] initialization — the FIRST style (Set::new()
# plus per-item insert) and the SECOND style (a set built by consuming the
# elements of an existing collection), plus the base Set surface
# (contains/len/remove/drain_one/clear) that is legal for String elements
# without any Clone/Hash/Eq bound on the std side.
use std::core
use std::collections

def first_init() -> Int
  let mut s = Set[String]::new()
  s.insert("alpha")
  s.insert("beta")
  s.insert("gamma")
  if s.len() != 3 then
    return 1
  end
  let alpha = "alpha".to_string()
  let omega = "omega".to_string()
  let beta = "beta".to_string()
  if !s.contains(&alpha) then
    return 2
  end
  if s.contains(&omega) then
    return 3
  end
  # remove transfers the element out (ownership-taking) and returns
  # whether the key existed; a later contains must report absence.
  let had = s.remove(&beta)
  if !had then
    return 4
  end
  if s.contains(&beta) then
    return 5
  end
  let d = s.drain_one()
  if d.is_none() then
    return 6
  end
  0
end

def second_init() -> Int
  # A set initialized by consuming the elements of a scratch array into it.
  let scratch = vec!["x".to_string(), "y".to_string(), "z".to_string()]
  let mut s = Set[String]::new()
  for item in scratch do
    s.insert(item)
  end
  if s.len() != 3 then
    return 1
  end
  s.clear()
  if s.len() != 0 then
    return 2
  end
  0
end

def main() -> Int
  let a = first_init()
  if a != 0 then
    println("canary_pos_set_init_string: FAIL first_init=" + a.to_string())
    return 1
  end
  let b = second_init()
  if b != 0 then
    println("canary_pos_set_init_string: FAIL second_init=" + b.to_string())
    return 1
  end
  0
end
