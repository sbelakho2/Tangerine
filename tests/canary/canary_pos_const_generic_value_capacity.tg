# Positive canary (§20 slice 3): a const generic parameter read as a
# RUNTIME VALUE inside the body of the item that declares it — the value
# level of the parameter, in the generic body, substituted per instance.
# The generic method body lowers ONCE: the MIR carries the read as the
# symbolic MirConstParamValue placeholder, and monomorphization
# substitutes the instance's concrete value — the SAME
# `def capacity(self) -> UInt = N` returns 4 for an ArrayVec[Int, 4]
# value and 8 for an ArrayVec[Int, 8] value (two instances of one generic
# method coexisting in one program), and the bounds comparison
# `self._len == N` compares against the concrete per-instance value.
use std::core

struct ArrayVec[T, const N: UInt]
  _data: [T; N]
  _len: UInt
end

impl[T, const N: UInt] ArrayVec[T, N]
  def capacity(self: Self) -> UInt
    N
  end

  def is_full(self: Self) -> Bool
    self._len == N
  end
end

def run() -> Int
  let v4: ArrayVec[Int, 4] = ArrayVec { _data: [10, 20, 30, 40], _len: 4 }
  if v4.capacity() != 4 then
    return 1
  end
  let p4: ArrayVec[Int, 4] = ArrayVec { _data: [1, 2, 3, 4], _len: 2 }
  if p4.is_full() then
    return 2
  end
  let f4: ArrayVec[Int, 4] = ArrayVec { _data: [1, 2, 3, 4], _len: 4 }
  if !f4.is_full() then
    return 3
  end
  let v8: ArrayVec[Int, 8] = ArrayVec { _data: [1, 2, 3, 4, 5, 6, 7, 8], _len: 8 }
  if v8.capacity() != 8 then
    return 4
  end
  let p8: ArrayVec[Int, 8] = ArrayVec { _data: [1, 2, 3, 4, 5, 6, 7, 8], _len: 6 }
  if p8.is_full() then
    return 5
  end
  let f8: ArrayVec[Int, 8] = ArrayVec { _data: [1, 2, 3, 4, 5, 6, 7, 8], _len: 8 }
  if !f8.is_full() then
    return 6
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_const_generic_value_capacity: FAIL " + ok.to_string())
    1
  end
end
