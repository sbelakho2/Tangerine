# Positive canary: consuming a PROJECTED place outside a finalizer is the
# expression-level partial move — the per-field tracking makes it legal.
# `consume_probe(p.a)` moves the a field out while p.b stays live; the
# scope-exit cleanup drops p with the partial-drop chain (the mask with
# only the live b field). Deinit counts: the moved-out a finalizes inside
# consume_probe's sink parameter; the live b finalizes at the scope exit —
# exactly 2 deinitializations, the consumed a's storage never re-dropped.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Pair
  a: Probe
  b: Probe
end

def consume_probe(sink r: Probe) -> Unit
end

def run() -> Int
  let p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  consume_probe(p.a)
  if p.b.id == 2 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 2 then
    0
  else
    println("canary_pos_resource_projected_consume: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
