# Positive canary: a resource created in a nested block that ends with a
# continue is finalized EXACTLY ONCE per iteration — by the continue edge.
use std::core

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def main() -> Int
  var i = 0
  loop
    i = i + 1
    if i < 3 then
      let p = Probe { id: i }
      continue
    end
    if i >= 3 then
      break
    end
  end
  if deinit_count == 2 then
    0
  else
    println("canary_pos_resource_nested_continue: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
