use std::core

def read2(a: Int, b: Int) -> Int
  a + b
end

def read1(a: Int) -> Int
  a
end

def check_multiple_reads_same_place() -> Bool
  mut x = 0
  let s = read2(x, x)
  s == 0
end

def check_nested_read_calls() -> Bool
  mut x = 0
  let n = read2(read1(x), read1(x))
  n == 0
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_multiple_reads_same_place() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] multiple_reads_same_place")
  end

  if check_nested_read_calls() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] nested_read_calls")
  end

  println("canary_access_read: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
