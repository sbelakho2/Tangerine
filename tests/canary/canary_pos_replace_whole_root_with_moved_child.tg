# Positive canary (audit: whole-root replace with a moved child): the
# whole-root replacement of a partially-moved local is the ONE remaining
# whole-value masked-drop form — assigning the whole new value over a
# root whose child was moved out drops exactly the LIVE children (the
# dead child's storage is skipped — its value already left through the
# RHS move). `p = Pair { a: p.a, b: Probe{3} }` moves p.a into the new
# value (0 drops at the store), drops the old p.b (1), and the scope
# exit finalizes the new p.a and p.b (2) — exactly 3 deinitializations.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

resource Pair
  a: Probe
  b: Probe
end

def run() -> Int
  let mut p = Pair { a: Probe { id: 1 }, b: Probe { id: 2 } }
  # the RHS moves the child p.a out of the root while the rest of the
  # old root (p.b) is destroyed by the masked whole-root drop
  p = Pair { a: p.a, b: Probe { id: 3 } }
  if p.a.id == 1 && p.b.id == 3 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 3 then
    0
  else
    println("canary_pos_replace_whole_root_with_moved_child: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
