# Positive scoped-access canary (audit §12): a CONTAINER ELEMENT source.
# `with v[i] as inout s` over a Vec[String] element binds the element's
# slot zero-copy: String::push through the access mutates the SAME string
# object the vector stores (the element's content grows in place), and a
# Vec[Int] element under `as let` reads a Copy value out of the slot.
# Mutating the Vec's STORAGE (push/reserve/...) inside the block is
# rejected elsewhere (the container-mutation exclusion negatives).
use std::core
use std::collections

def read_len(s: String) -> Int
  s.len()
end

def check_vec_string_element_inout() -> Bool
  mut v = Vec[String]::new()
  v.push("hi" + "")
  with v[0] as inout s
    s.push('!')
  end
  if v.len() != 1 then
    return false
  end
  with v[0] as let chk
    if read_len(chk) != 3 then
      return false
    end
  end
  true
end

def check_vec_copy_element_read() -> Bool
  mut v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  v.push(3)
  with v[1] as let e
    if e != 2 then
      return false
    end
  end
  true
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_vec_string_element_inout() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] vec_string_element_inout")
  end

  if check_vec_copy_element_read() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] vec_copy_element_read")
  end

  println("canary_pos_scoped_access_vec_element: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
