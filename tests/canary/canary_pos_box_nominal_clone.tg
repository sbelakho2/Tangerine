# Positive canary: Box[T] is a NOMINAL type with its own registered
# `impl[T: Clone] Box[T]`. `b.clone()` duplicates the pointee into a FRESH
# allocation through that impl — it never clones the content in place
# through a transparent wrapper, and it never consumes the source box:
# the source survives any number of clones and its own into_inner still
# reads the original value (the pre-fix body routed the source through
# into_inner, so a second clone/source read hit a freed region).
use std::core
use std::alloc

def main() -> Int
  let b = box_new(21 * 2)
  let c = b.clone()
  let d = b.clone()
  let v = c.into_inner()
  let w = d.into_inner()
  let x = b.into_inner()
  if v == 42 && w == 42 && x == 42 then 0 else 1 end
end
