# tests/canary/test_canary_bump_alloc_boundary.tg
# Native canary: _tg_bump_alloc boundary coverage.
#
# Verifies that the bump allocator maps enough memory for requests at and
# beyond the default 4 MiB arena and that every byte of each allocation is
# writable and readable. The old slow path mmap'd exactly 0x400000 bytes
# regardless of the requested size but set the bump pointer to base+requested,
# so requests over 4 MiB overran the mapping.
#
# Boundary sizes (bytes):
#   4 MiB - 16, 4 MiB, 4 MiB + 1, 4 MiB + 16, 8 MiB, 16 MiB, 64 MiB
#
# Failure class: MEMORY_SAFETY / CODE_GEN_BUG

use std::core

# Direct access to the runtime bump allocator.
extern def _tg_bump_alloc(size: UInt) -> Ptr[u8]

def probe(size: UInt) -> Bool
  let ptr = _tg_bump_alloc(size)
  if ptr.is_null() then
    println("[FAIL] _tg_bump_alloc returned null for " + size.to_string())
    return false
  end
  # Write every byte, then read it back.
  mut i: UInt = 0
  while i < size do
    let byte = (i % 256 as UInt) as u8
    ptr.offset(i as Int).write(byte)
    i = i + 1
  end
  mut j: UInt = 0
  while j < size do
    let expected = (j % 256 as UInt) as u8
    if ptr.offset(j as Int).read() != expected then
      println("[FAIL] byte mismatch at " + j.to_string() + " in size " + size.to_string())
      return false
    end
    j = j + 1
  end
  println("[PASS] bump alloc boundary " + size.to_string())
  true
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  mut cases: Vec[UInt] = Vec::new()
  cases.push((4 * 1024 * 1024 - 16) as UInt)
  cases.push((4 * 1024 * 1024) as UInt)
  cases.push((4 * 1024 * 1024 + 1) as UInt)
  cases.push((4 * 1024 * 1024 + 16) as UInt)
  cases.push((8 * 1024 * 1024) as UInt)
  cases.push((16 * 1024 * 1024) as UInt)
  cases.push((64 * 1024 * 1024) as UInt)

  mut ci = 0
  while ci < cases.len() do
    if probe(cases[ci]) then
      passed = passed + 1
    else
      failed = failed + 1
    end
    ci = ci + 1
  end

  println("canary_bump_alloc_boundary: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
