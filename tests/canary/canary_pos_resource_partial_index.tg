cap Probe
  def new() -> Probe
    Probe
  end
end

struct Triple
  a: Probe
  b: Probe
  c: Probe
end

# The per-index partial move over a fixed array of resources: extracting
# one element consumes ONLY that index; the sibling elements stay live and
# are dropped by the partial-drop chain at scope exit (2 deinits — the
# extracted element is moved out, the two live siblings deinit).
def main() -> Int
  let items = [Probe::new(), Probe::new(), Probe::new()]
  let first = items[0]
  use(first)
  # items[1] and items[2] are still live — the scope-exit partial drop
  # deinitializes exactly those two.
  return 0
end

def use(p: Probe) -> Unit
  ()
end
