# Positive canary: ZERO-SIZED STATICS OCCUPY NO BYTES AND DO NOT SHIFT OR
# CORRUPT THE DATA IMAGE AROUND THEM.
#
# The zero-width scalar-storage fix: emit_scalar_constant_for_storage emits
# nothing for width 0.  A payload-less struct-literal static initializer
# must not write an 8-byte slot.  This canary pins the observable
# consequences:
#   1. every scalar static around zero-sized statics reads back its EXACT
#      bytes (a shifted or zero-filled image corrupts the value);
#   2. a zero-sized static's address equals the next static's address
#      (adjacency: ZST, scalar / ZST, ZST, scalar / scalar, ZST, scalar);
#   3. zero-sized FIELDS consume no bytes in a surrounding struct and a
#      zero-sized type with Drop still runs its destructor exactly once
#      (storage size 0 never implies "no drop").

struct Zst
end

use std::ffi::{address_of}

struct NestedZst
  inner: Zst
  tag: UInt
end

struct WrapZst[T]
  payload: T
  tag: UInt
end

struct ZstDroppable
  marker: Zst
end

static mut ZST_DROPS: Int = 0

impl Drop for ZstDroppable
  def drop(inout self: ZstDroppable) -> Unit
    ZST_DROPS = ZST_DROPS + 1
  end
end

static ZST_A: Zst = Zst {}
static VALUE_B: UInt = 0x1122334455667788

static ZST_C: Zst = Zst {}
static ZST_D: Zst = Zst {}
static VALUE_E: UInt = 0x8877665544332211

static VALUE_F: UInt = 0x0102030405060708
static ZST_G: Zst = Zst {}
static VALUE_H: UInt = 0x0f0e0d0c0b0a0908

def main() -> Int
  if size_of[Zst]() != 0 then return 1 end
  if size_of[ZstDroppable]() != 0 then return 17 end
  if VALUE_B != 0x1122334455667788 then return 2 end
  if VALUE_E != 0x8877665544332211 then return 3 end
  if VALUE_H != 0x0f0e0d0c0b0a0908 then return 4 end

  # ZST then scalar: the scalar starts at the ZST's (zero-byte) address.
  let pa = address_of(&mut ZST_A) as UInt
  let pb = address_of(&mut VALUE_B) as UInt
  if pa != pb then return 5 end

  # ZST, ZST, scalar: all three share one address.
  let pc = address_of(&mut ZST_C) as UInt
  let pd = address_of(&mut ZST_D) as UInt
  let pe = address_of(&mut VALUE_E) as UInt
  if pc != pd || pd != pe then return 6 end

  # scalar, ZST, scalar: the trailing scalar follows the 8-byte scalar.
  let pf = address_of(&mut VALUE_F) as UInt
  let pg = address_of(&mut ZST_G) as UInt
  let ph = address_of(&mut VALUE_H) as UInt
  if pf != pg || pg != ph then return 7 end
  if ph != pf + 8 then return 8 end

  # zero-sized fields absorb no bytes: the tag starts at the wrapper's base.
  let nested = NestedZst { inner: Zst {}, tag: 0x3333333344444444 }
  if size_of[NestedZst]() != 8 then return 9 end
  if nested.tag != 0x3333333344444444 then return 10 end
  if (address_of(&mut nested.tag) as UInt) != (address_of(&mut nested) as UInt) then return 11 end

  let wrapped: WrapZst[Zst] = WrapZst { payload: Zst {}, tag: 0x1111111122222222 }
  if size_of[WrapZst[Zst]]() != 8 then return 12 end
  if wrapped.tag != 0x1111111122222222 then return 13 end
  if (address_of(&mut wrapped.tag) as UInt) != (address_of(&mut wrapped) as UInt) then return 14 end

  let zst_array: [Zst; 4] = [Zst {}, Zst {}, Zst {}, Zst {}]
  if size_of[[Zst; 4]]() != 0 then return 15 end
  let _ = zst_array

  # a zero-sized type with cleanup semantics drops exactly once
  do
    let d = ZstDroppable { marker: Zst {} }
    let _ = d
  end
  if ZST_DROPS != 1 then return 16 end

  0
end
