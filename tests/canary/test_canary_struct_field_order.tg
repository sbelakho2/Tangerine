# tests/canary/test_canary_struct_field_order.tg
# Native canary: struct field ORDER and offsets must be honored exactly.
# Fields are declared in a specific, non-trivial order; a wrong offset
# computation (e.g. packing, reordering) surfaces as wrong values.
#
# Failure class: LAYOUT_CONSUMER_BUG / TARGET_DESCRIPTOR_BUG

use std::core

struct FieldOrderRec
  a: Int
  pad: Bool
  b: Int
  c: Int
end

struct Mixed
  head: Int
  name: String
  tail: Int
end

def check_field_order() -> Bool
  let r = FieldOrderRec { a: 11, pad: true, b: 22, c: 33 }
  r.a == 11 && r.b == 22 && r.c == 33 && r.pad == true
end

def check_mixed_layout() -> Bool
  let m = Mixed { head: 100, name: "canary", tail: 200 }
  m.head == 100 && m.name == "canary" && m.tail == 200
end

def check_writes_do_not_clobber_siblings() -> Bool
  mut r = FieldOrderRec { a: 1, pad: false, b: 2, c: 3 }
  r.b = 999
  r.a == 1 && r.b == 999 && r.c == 3
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_field_order() then
    passed = passed + 1
    println("[PASS] field_order")
  else
    failed = failed + 1
    println("[FAIL] field_order")
  end

  if check_mixed_layout() then
    passed = passed + 1
    println("[PASS] mixed_layout")
  else
    failed = failed + 1
    println("[FAIL] mixed_layout")
  end

  if check_writes_do_not_clobber_siblings() then
    passed = passed + 1
    println("[PASS] write_sibling_isolation")
  else
    failed = failed + 1
    println("[FAIL] write_sibling_isolation")
  end

  println("canary_struct_field_order: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
