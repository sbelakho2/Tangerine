# Positive canary: Map remove/insert CHURN — removing entries REAL-unlinks
# their records (bucket-head promotion / chain re-link / tail empty-mark)
# and links displaced overflow nodes into the header free list; later
# inserts reuse that list. The language surface cannot read the header's
# free-list word, so the canary asserts the observable contract: after
# remove/re-insert churn the map is functionally intact (lengths, lookups,
# removals) — the free-list path is exercised by the churn itself.
use std::core
use std::collections

def run() -> Int
  let mut m = Map[String, Int]::new()
  m.insert("k1", 1)
  m.insert("k2", 2)
  m.insert("k3", 3)
  m.insert("k4", 4)
  m.insert("k5", 5)
  if m.len() != 5 then
    return 1
  end
  let k1 = "k1".to_string()
  let k3 = "k3".to_string()
  let k5 = "k5".to_string()
  match m.remove(&k1)
  when Option::Some(v) then
    if v != 1 then
      return 2
    end
  when Option::None then return 3
  end
  match m.remove(&k3)
  when Option::Some(v) then
    if v != 3 then
      return 4
    end
  when Option::None then return 5
  end
  match m.remove(&k5)
  when Option::Some(v) then
    if v != 5 then
      return 6
    end
  when Option::None then return 7
  end
  if m.len() != 2 then
    return 8
  end
  # Re-insert into the freed slots (the free-list reuse path).
  m.insert("k1", 10)
  m.insert("k3", 30)
  m.insert("k5", 50)
  if m.len() != 5 then
    return 9
  end
  if !m.contains_key(&"k1".to_string()) then
    return 10
  end
  if !m.contains_key(&"k2".to_string()) then
    return 11
  end
  if !m.contains_key(&"k5".to_string()) then
    return 12
  end
  # One more full churn round: remove everything, re-insert everything.
  m.clear()
  if m.len() != 0 then
    return 13
  end
  m.insert("a", 1)
  m.insert("b", 2)
  if m.len() != 2 then
    return 14
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_map_free_list_reuse: FAIL " + ok.to_string())
    1
  end
end
