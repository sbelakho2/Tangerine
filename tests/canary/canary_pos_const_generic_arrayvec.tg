# Positive canary (§20 slice 2): generic STRUCTS with const parameters —
# ArrayVec-style `[T; N]` bodies instantiated at concrete sizes. A struct
# instanced at N=4 and a struct instanced at N=8 are the SAME declaration
# but DIFFERENT types (the assignability rejection lives in the neg
# canary), and every spelling of the SAME size — the literal `4`, a module
# const reference `AV_CAP`, const arithmetic `AV_TWO * 2`, the folded
# expression `2 + 2` — is ONE canonical type (Type::Const compares by
# value). Field data: [T; N] substitutes to concrete [T; 4]/[T; 8] under
# the annotation; array-literal field values initialize the symbolic-size
# field through the literal bridge and the count is enforced at the
# concrete destination.
use std::core

const AV_CAP: Int = 4
const AV_TWO: Int = 2

struct ArrayVec[T, const N: UInt]
  _data: [T; N]
  _len: UInt
end

def run() -> Int
  # Four spellings of ArrayVec[Int, Const(4)] — literal, module-const
  # reference, const arithmetic, folded expression — all one type.
  let v1: ArrayVec[Int, 4] = ArrayVec { _data: [10, 20, 30, 40], _len: 4 }
  let v2: ArrayVec[Int, AV_CAP] = ArrayVec { _data: [11, 21, 31, 41], _len: 4 }
  let v3: ArrayVec[Int, AV_TWO * 2] = ArrayVec { _data: [12, 22, 32, 42], _len: 4 }
  let v4: ArrayVec[Int, 2 + 2] = ArrayVec { _data: [13, 23, 33, 43], _len: 4 }
  let v5: ArrayVec[Int, 4] = v4
  if v1._data[0] + v1._data[3] != 50 then
    return 1
  end
  if v2._data[1] != 21 then
    return 2
  end
  if v3._data[2] != 32 then
    return 3
  end
  if v5._data[3] != 43 then
    return 4
  end
  # N=8 is a DIFFERENT instantiation of the same declaration — usable in
  # the same program, never assignable to the N=4 type (neg canary).
  let w1: ArrayVec[Int, 8] = ArrayVec { _data: [10, 20, 30, 40, 50, 60, 70, 80], _len: 8 }
  let w2: ArrayVec[Int, AV_CAP * 2] = ArrayVec { _data: [5, 6, 7, 8, 9, 10, 11, 12], _len: 8 }
  if w1._data[7] != 80 then
    return 5
  end
  if w2._data[0] != 5 then
    return 6
  end
  0
end

def main() -> Int
  let ok = run()
  if ok == 0 then
    0
  else
    println("canary_pos_const_generic_arrayvec: FAIL " + ok.to_string())
    1
  end
end
