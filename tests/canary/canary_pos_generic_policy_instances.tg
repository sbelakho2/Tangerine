# Positive canary (P1 — the generic ownership policy, CONCRETE instances):
# the ownership decisions at the concrete instances of generic types are
# correct. The generic wrapper Wrapper[T] is instantiated with a resource
# (Probe), with Box[Probe], with Rc[Payload], with a Drop-impl composite
# (Payload), with a nested generic composite (Wrapper[Wrapper[Probe]]) and
# with String — every owning value's destruction runs exactly once
# (deinit-count observations), and the String wrapper needs no per-value
# drop (the arena reclaims — requires_drop_glue=false).
use std::core
use std::alloc

static mut probe_drops: Int = 0
static mut payload_drops: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_drops = probe_drops + 1
  end
end

struct Payload
  id: Int
end

impl Drop for Payload
  def drop(self: &mut Payload) -> Unit
    payload_drops = payload_drops + 1
  end
end

struct Wrapper[T]
  item: T
end

def make_wp() -> Wrapper[Probe]
  Wrapper[Probe] { item: Probe { id: 1 } }
end

def make_wb() -> Wrapper[Box[Probe]]
  Wrapper[Box[Probe]] { item: box_new(Probe { id: 2 }) }
end

def make_wr() -> Wrapper[Rc[Payload]]
  Wrapper[Rc[Payload]] { item: rc_new(Payload { id: 3 }) }
end

def make_wd() -> Wrapper[Payload]
  Wrapper[Payload] { item: Payload { id: 4 } }
end

def make_wn() -> Wrapper[Wrapper[Probe]]
  Wrapper[Wrapper[Probe]] { item: Wrapper[Probe] { item: Probe { id: 5 } } }
end

def make_ws() -> Wrapper[String]
  Wrapper[String] { item: "hello" }
end

def run() -> Int
  do
    let wp = make_wp()
    let wb = make_wb()
    let wr = make_wr()
    let wd = make_wd()
    let wn = make_wn()
    let ws = make_ws()
    # Projected reads only (the established resource-field read pattern);
    # the String wrapper is constructed and destroyed without reads.
    if wp.item.id != 1 then
      return 1
    end
    if wn.item.item.id != 5 then
      return 2
    end
  end
  0
end

def main() -> Int
  let ok = run()
  # probe_drops: wp's Probe (1) + wb's Box[Probe] pointee (2, via the
  # registered Box drop -> drop_in_place) + wn's nested Probe (3).
  # payload_drops: wr's Rc release at count 0 (1) + wd's Drop-impl field (2).
  if ok == 0 && probe_drops == 3 && payload_drops == 2 then
    0
  else
    println("canary_pos_generic_policy_instances: FAIL probe_drops=" + probe_drops.to_string() + " payload_drops=" + payload_drops.to_string())
    1
  end
end
