# Positive canary (audit: replace_tuple_owned_element): the tuple
# POSITION replacement is the exact-place replacement — `p.0 = ...`
# destroys only the old value of the tuple element 0; the sibling element
# p.1 stays live and readable after the store. Deinit counts: old p.0 at
# the replacement; the new p.0 and the untouched p.1 at the scope exit —
# exactly 3 deinitializations.
use std::core

static mut probe_deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_deinit_count = probe_deinit_count + 1
  end
end

def run() -> Int
  let mut p = (Probe { id: 1 }, Probe { id: 2 })
  p.0 = Probe { id: 3 }
  # the sibling element survived the replacement — still live
  if p.0.id == 3 && p.1.id == 2 then 0 else 1 end
end

def main() -> Int
  let ok = run()
  if ok == 0 && probe_deinit_count == 3 then
    0
  else
    println("canary_pos_replace_tuple_owned_element: FAIL ok=" + ok.to_string() + " deinit_count=" + probe_deinit_count.to_string())
    1
  end
end
