# tests/canary/canary_vararg_promotions.tg
# The audit §26 C-default-promotion behavior lane: EXTRA (anonymous)
# arguments of a variadic extern call are marshalled as their promoted
# C images. The callee here is the REAL libc snprintf (the macOS host
# lane links the undefined extern through the dyld import against
# libSystem), which reads the extras with va_arg exactly like any C
# variadic callee:
#   - an i8/i16 extra must arrive sign-extended to the int width (an i8
#     -2 read as %d must print "-2" — a zero-extended byte image would
#     print "254");
#   - a u8/u16 extra must arrive value-preserving (%u of u16 65535 must
#     print "65535");
#   - a Bool extra promotes to int 0/1; i32 passes unchanged;
#   - a pointer extra crosses as the C pointer slot (%s);
#   - an F32 extra is admitted and widened to the F64 double image at
#     the call boundary (the fcvt runs; the uniform GP-slot model's
#     float-vararg interop limitation — a REAL C callee's va_arg(double)
#     reads its FP register save area — is documented at the emitter, so
#     the float slots here sit AFTER every format-read argument);
#   - the register/stack boundary keeps its 8-byte slots (a u16 65535
#     as the 8th of 8 format-read extras lands on the stack on x86-64
#     and in x7 on aarch64, and must print "65535" on both).

use std::core
use std::collections

extern def _tg_bump_alloc(size: UInt) -> Ptr[u8]
extern def snprintf(buf: Ptr[u8], size: UInt, fmt: Ptr[u8], ...) -> I32

def put_bytes(ptr: Ptr[u8], cs: Vec[Int]) -> Unit
  mut i = 0
  while i < cs.len() do
    ptr.offset(i).write(cs[i] as u8)
    i = i + 1
  end
  ptr.offset(cs.len()).write(0 as u8)
end

# Parse a NUL-terminated [-]digits C string at `buf` as an Int.
def read_int(buf: Ptr[u8]) -> Int
  mut i = 0
  mut neg = false
  mut v = 0
  let c0 = buf.offset(0).read()
  if c0 == (45 as u8) then
    neg = true
    i = 1
  end
  loop
    let c = buf.offset(i).read()
    if c == (0 as u8) then break end
    v = v * 10 + ((c as Int) - 48)
    i = i + 1
  end
  if neg then -v else v end
end

def eq_bytes(buf: Ptr[u8], want: Vec[Int]) -> Bool
  var i = 0
  while i < want.len() do
    if buf.offset(i).read() != (want[i] as u8) then
      return false
    end
    i = i + 1
  end
  buf.offset(want.len()).read() == (0 as u8)
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  let buf = _tg_bump_alloc(256)
  let fmt = _tg_bump_alloc(64)
  let fmt_pct_d = vec![37 as Int, 100 as Int]
  let fmt_pct_u = vec![37 as Int, 117 as Int]
  let fmt_pct_s = vec![37 as Int, 115 as Int]
  let fmt_d8 = vec![37 as Int, 100 as Int, 32 as Int, 37 as Int, 100 as Int, 32 as Int, 37 as Int, 100 as Int, 32 as Int, 37 as Int, 100 as Int, 32 as Int, 37 as Int, 100 as Int, 32 as Int, 37 as Int, 100 as Int, 32 as Int, 37 as Int, 100 as Int, 32 as Int, 37 as Int, 100 as Int]

  # i8 extra: -2 sign-extends to the int image.
  put_bytes(fmt, fmt_pct_d)
  let r1 = snprintf(buf, 256 as UInt, fmt, -2 as I8)
  if r1 == 2 && read_int(buf) == -2 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] i8 -2 promoted vararg (got " + read_int(buf).to_string() + ")")
  end

  # i16 extra: -12345 sign-extends to the int image.
  put_bytes(fmt, fmt_pct_d)
  let r2 = snprintf(buf, 256 as UInt, fmt, -12345 as I16)
  if r2 == 6 && read_int(buf) == -12345 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] i16 -12345 promoted vararg (got " + read_int(buf).to_string() + ")")
  end

  # u8 extra: 200 zero-extends to the int image.
  put_bytes(fmt, fmt_pct_u)
  let r3 = snprintf(buf, 256 as UInt, fmt, 200 as U8)
  if r3 == 3 && read_int(buf) == 200 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] u8 200 promoted vararg (got " + read_int(buf).to_string() + ")")
  end

  # u16 extra: 65535 zero-extends to the int image.
  put_bytes(fmt, fmt_pct_u)
  let r4 = snprintf(buf, 256 as UInt, fmt, 65535 as U16)
  if r4 == 5 && read_int(buf) == 65535 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] u16 65535 promoted vararg (got " + read_int(buf).to_string() + ")")
  end

  # Bool extra promotes to int 1.
  put_bytes(fmt, fmt_pct_d)
  let r5 = snprintf(buf, 256 as UInt, fmt, true)
  if r5 == 1 && read_int(buf) == 1 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] Bool true promoted vararg (got " + read_int(buf).to_string() + ")")
  end

  # i32 extra passes unchanged (the int width needs no conversion).
  put_bytes(fmt, fmt_pct_d)
  let r6 = snprintf(buf, 256 as UInt, fmt, -100000 as I32)
  if r6 == 7 && read_int(buf) == -100000 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] i32 -100000 vararg (got " + read_int(buf).to_string() + ")")
  end

  # Pointer extra crosses as the C pointer slot (%s).
  let text = _tg_bump_alloc(16)
  put_bytes(text, vec![104 as Int, 105 as Int])
  put_bytes(fmt, fmt_pct_s)
  let r7 = snprintf(buf, 256 as UInt, fmt, text)
  if r7 == 2 && eq_bytes(buf, vec![104 as Int, 105 as Int]) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] pointer %s vararg")
  end

  # Eight %d reads: the narrow extras at the tail cross the register/
  # stack boundary (x86-64: extras 4.. stack 8-byte slots; aarch64:
  # extras up to x7, then the 8-byte [sp+0] stream) and must arrive as
  # their promoted int images — the 8th extra is a u16 65535.
  put_bytes(fmt, fmt_d8)
  let r8 = snprintf(buf, 256 as UInt, fmt,
    -1 as I8, 2 as I8, -3 as I16, 4 as U8, 5 as I32, 6 as I32, 7 as I32, 65535 as U16)
  if r8 == 21 && eq_bytes(buf, vec![45 as Int, 49 as Int, 32 as Int, 50 as Int, 32 as Int, 45 as Int, 51 as Int, 32 as Int, 52 as Int, 32 as Int, 53 as Int, 32 as Int, 54 as Int, 32 as Int, 55 as Int, 32 as Int, 54 as Int, 53 as Int, 53 as Int, 51 as Int, 53 as Int]) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] register/stack boundary promoted varargs")
  end

  # F64 (double) extra: admitted, rides its 8-byte slot AFTER the read
  # int (the uniform GP-slot float-vararg interop limitation — the slot
  # is never read by %d).
  put_bytes(fmt, fmt_pct_d)
  let f64x = 2.5
  let r9 = snprintf(buf, 256 as UInt, fmt, 42, f64x)
  if r9 == 2 && read_int(buf) == 42 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] trailing F64 extra disturbed the int vararg")
  end

  # F32 extra: admitted and auto-promoted (the f32 literal suffix types
  # the extra F32 at the checker, whose promotion is the F64 double
  # image; the promoted slot rides AFTER the read int).
  put_bytes(fmt, fmt_pct_d)
  let r10 = snprintf(buf, 256 as UInt, fmt, 42, 1.5f32)
  if r10 == 2 && read_int(buf) == 42 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] trailing F32 (promoted) extra disturbed the int vararg")
  end

  println("canary_vararg_promotions: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
