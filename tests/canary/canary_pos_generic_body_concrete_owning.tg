# Positive canary (P1 — the generic ownership policy): a GENERIC function
# body holding CONCRETE owning values (a resource local and a Box[Probe]
# local) — the ownership decisions at the concrete instances are correct:
# each monomorphized instance destroys its concrete owning locals exactly
# once (the concrete drop glue, carried through the instance's
# function-end cleanup). Two instances (T=Int, T=String) run the same
# generic body; the deferred T positions themselves carry no concrete
# destructor in the template (the deferred contract — the concrete glue
# after substitution governs concrete values).
use std::core
use std::alloc

static mut probe_drops: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    probe_drops = probe_drops + 1
  end
end

def generic_with_concrete_owns[T](sink x: T) -> Int
  let p = Probe { id: 9 }
  let b = box_new(Probe { id: 10 })
  let v = *b.get()
  if p.id != 9 || v.id != 10 then
    return 1
  end
  0
end

def run() -> Int
  let r1 = generic_with_concrete_owns(5)
  let r2 = generic_with_concrete_owns("s")
  if r1 != 0 || r2 != 0 then
    return 1
  end
  0
end

def main() -> Int
  let ok = run()
  # Two instances x (2 bodies) each destroy p and the boxed Probe: 4 deinits.
  if ok == 0 && probe_drops == 4 then
    0
  else
    println("canary_pos_generic_body_concrete_owning: FAIL probe_drops=" + probe_drops.to_string())
    1
  end
end
