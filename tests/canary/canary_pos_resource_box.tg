# Positive canary: Box[Probe] — owning allocation — is released when the box
# goes out of scope. box_new allocates; the box's drop runs drop_in_place on
# the pointee (Probe deinit) and deallocates the allocation.
use std::core
use std::alloc

static mut deinit_count: Int = 0

resource Probe
  id: Int
  def deinit(sink self: Self) -> Unit
    deinit_count = deinit_count + 1
  end
end

def use_box() -> Int
  let b = box_new(Probe { id: 7 })
  b.get().id
end

def main() -> Int
  let id = use_box()
  if id == 7 && deinit_count == 1 then
    0
  else
    println("canary_pos_resource_box: FAIL deinit_count=" + deinit_count.to_string())
    1
  end
end
