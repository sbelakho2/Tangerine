use std::core

extern def _tg_bump_alloc(size: UInt) -> Ptr[u8]

def check_raw_read_write() -> Bool
  let p = _tg_bump_alloc(16 as UInt)
  if p.is_null() then
    return false
  end
  mut ok = false
  unsafe "raw read/write" do
    let q = p as Ptr[Int]
    *q = 42
    if *q == 42 then
      ok = true
    end
  end
  ok
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_raw_read_write() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] raw_read_write")
  end

  println("canary_ffi: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
