# Positive canary: concrete RingBuffer[Int].peek_front is ACCEPTED and runs —
# Int satisfies the `T: Copy` bound of `impl[T: Copy] RingBuffer[T]`, so the
# by-value projected read is applicable (the impl-bound gate passes and the
# element is returned by value out of the shared slot).
use std::core
use std::collections

def main() -> Int
  let mut rb: RingBuffer[Int] = RingBuffer::new(4)
  rb.push_back(42)
  match rb.peek_front()
  when Option::Some(v) then
    if v == 42 then 0 else 1 end
  when Option::None then
    1
  end
end
