# tests/canary/test_canary_narrow_storage.tg
# Native canary: packed narrow field storage integrity.
#
# Verifies that each narrow field (Bool, u8, i8, u16, i16, u32, i32) is stored
# and loaded at exactly its storage width. Adjacent narrow fields must not be
# corrupted by an 8-byte load/store. Every field is given a recognizable
# non-default value, then each field is mutated in turn while verifying all
# other fields remain intact.
#
# Failure class: MEMORY_SAFETY / CODE_GEN_BUG (narrow field corruption)

use std::core

struct NarrowPack
  a: Bool
  b: Bool
  c: u8
  d: i8
  e: u16
  f: i16
  g: u32
  h: i32
  z: Bool
end

def make_pack() -> NarrowPack
  NarrowPack {
    z: false,
    h: -1234567,
    g: 0xdeadbeef,
    f: -1234,
    e: 54321,
    d: -100,
    c: 201,
    b: false,
    a: true
  }
end

def check_pack(p: &NarrowPack) -> Bool
  p.a == true &&
  p.b == false &&
  p.c == 201 &&
  p.d == -100 &&
  p.e == 54321 &&
  p.f == -1234 &&
  p.g == 0xdeadbeef &&
  p.h == -1234567 &&
  p.z == false
end

def check_field_pack(p: &NarrowPack) -> Bool
  # Same as check_pack but used after each single-field mutation to confirm the
  # other eight fields survive.
  check_pack(p)
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  let x = make_pack()
  if check_pack(&x) then
    passed = passed + 1
    println("[PASS] narrow_pack_initial")
  else
    failed = failed + 1
    println("[FAIL] narrow_pack_initial")
  end

  # Mutate one field at a time, verify the other eight after each mutation.
  mut m = make_pack()
  m.a = false
  if check_field_pack(&m) then passed = passed + 1 else failed = failed + 1; println("[FAIL] mutate a") end

  m = make_pack()
  m.b = true
  if check_field_pack(&m) then passed = passed + 1 else failed = failed + 1; println("[FAIL] mutate b") end

  m = make_pack()
  m.c = 7
  if check_field_pack(&m) then passed = passed + 1 else failed = failed + 1; println("[FAIL] mutate c") end

  m = make_pack()
  m.d = 55
  if check_field_pack(&m) then passed = passed + 1 else failed = failed + 1; println("[FAIL] mutate d") end

  m = make_pack()
  m.e = 1234
  if check_field_pack(&m) then passed = passed + 1 else failed = failed + 1; println("[FAIL] mutate e") end

  m = make_pack()
  m.f = 777
  if check_field_pack(&m) then passed = passed + 1 else failed = failed + 1; println("[FAIL] mutate f") end

  m = make_pack()
  m.g = 0x12345678
  if check_field_pack(&m) then passed = passed + 1 else failed = failed + 1; println("[FAIL] mutate g") end

  m = make_pack()
  m.h = 999
  if check_field_pack(&m) then passed = passed + 1 else failed = failed + 1; println("[FAIL] mutate h") end

  m = make_pack()
  m.z = true
  if check_field_pack(&m) then passed = passed + 1 else failed = failed + 1; println("[FAIL] mutate z") end

  # NarrowPack inside another struct
  struct Outer
    tag: Int
    pack: NarrowPack
    tag2: Int
  end
  let o = Outer { tag: 111, pack: make_pack(), tag2: 222 }
  if o.tag == 111 && check_pack(&o.pack) && o.tag2 == 222 then
    passed = passed + 1
    println("[PASS] narrow_in_struct")
  else
    failed = failed + 1
    println("[FAIL] narrow_in_struct")
  end

  # Vec[NarrowPack]
  mut v: Vec[NarrowPack] = Vec::new()
  v.push(make_pack())
  v.push(make_pack())
  if v.len() == 2 && check_pack(&v[0]) && check_pack(&v[1]) then
    passed = passed + 1
    println("[PASS] narrow_vec")
  else
    failed = failed + 1
    println("[FAIL] narrow_vec")
  end

  # Array of NarrowPack
  mut arr: [NarrowPack] = [make_pack(), make_pack(), make_pack()]
  if check_pack(&arr[0]) && check_pack(&arr[1]) && check_pack(&arr[2]) then
    passed = passed + 1
    println("[PASS] narrow_array")
  else
    failed = failed + 1
    println("[FAIL] narrow_array")
  end

  # Whole struct copy
  let cp = make_pack()
  if check_pack(&cp) then
    passed = passed + 1
    println("[PASS] narrow_copy")
  else
    failed = failed + 1
    println("[FAIL] narrow_copy")
  end

  println("canary_narrow_storage: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
