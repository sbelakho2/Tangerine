# tests/canary/test_canary_narrow_storage.tg
# Native canary: packed narrow field storage integrity.
#
# Verifies that each narrow field (Bool, u8, i8, u16, i16, u32, i32) is stored
# and loaded at exactly its storage width. Adjacent narrow fields must not be
# corrupted by an 8-byte load/store. After mutating exactly one field, every
# OTHER field must retain its original value.
#
# Failure class: MEMORY_SAFETY / CODE_GEN_BUG (narrow field corruption)

use std::core

struct NarrowPack
  a: Bool
  b: Bool
  c: u8
  d: i8
  e: u16
  f: i16
  g: u32
  h: i32
  z: Bool
end

# Originals
const ORIG_A: Bool = true
const ORIG_B: Bool = false
const ORIG_C: u8 = 201
const ORIG_D: i8 = -100
const ORIG_E: u16 = 54321
const ORIG_F: i16 = -1234
const ORIG_G: u32 = 0xdeadbeef
const ORIG_H: i32 = -1234567
const ORIG_Z: Bool = false

def make_pack() -> NarrowPack
  NarrowPack {
    z: ORIG_Z,
    h: ORIG_H,
    g: ORIG_G,
    f: ORIG_F,
    e: ORIG_E,
    d: ORIG_D,
    c: ORIG_C,
    b: ORIG_B,
    a: ORIG_A
  }
end

# Check every field against explicit expected values.
def check_pack(p: &NarrowPack, ea: Bool, eb: Bool, ec: u8, ed: i8, ee: u16, ef: i16, eg: u32, eh: i32, ez: Bool) -> Bool
  p.a == ea &&
  p.b == eb &&
  p.c == ec &&
  p.d == ed &&
  p.e == ee &&
  p.f == ef &&
  p.g == eg &&
  p.h == eh &&
  p.z == ez
end

struct Outer
  tag: Int
  pack: NarrowPack
  tag2: Int
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  let x = make_pack()
  if check_pack(&x, ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
    println("[PASS] narrow_pack_initial")
  else
    failed = failed + 1
    println("[FAIL] narrow_pack_initial")
  end

  # Mutate one field at a time; every OTHER field must keep its original value.
  mut m = make_pack()
  m.a = false
  if check_pack(&m, false, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mutate a")
  end

  m = make_pack()
  m.b = true
  if check_pack(&m, ORIG_A, true, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mutate b")
  end

  m = make_pack()
  m.c = 7
  if check_pack(&m, ORIG_A, ORIG_B, 7, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mutate c")
  end

  m = make_pack()
  m.d = 55
  if check_pack(&m, ORIG_A, ORIG_B, ORIG_C, 55, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mutate d")
  end

  m = make_pack()
  m.e = 1234
  if check_pack(&m, ORIG_A, ORIG_B, ORIG_C, ORIG_D, 1234, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mutate e")
  end

  m = make_pack()
  m.f = 777
  if check_pack(&m, ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, 777, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mutate f")
  end

  m = make_pack()
  m.g = 0x12345678
  if check_pack(&m, ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, 0x12345678, ORIG_H, ORIG_Z) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mutate g")
  end

  m = make_pack()
  m.h = 999
  if check_pack(&m, ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, 999, ORIG_Z) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mutate h")
  end

  m = make_pack()
  m.z = true
  if check_pack(&m, ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, true) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mutate z")
  end

  # NarrowPack inside another struct
  let o = Outer { tag: 111, pack: make_pack(), tag2: 222 }
  if o.tag == 111 && check_pack(&o.pack, ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) && o.tag2 == 222 then
    passed = passed + 1
    println("[PASS] narrow_in_struct")
  else
    failed = failed + 1
    println("[FAIL] narrow_in_struct")
  end

  # Vec[NarrowPack]
  mut v: Vec[NarrowPack] = Vec::new()
  v.push(make_pack())
  v.push(make_pack())
  if v.len() == 2 && check_pack(&v[0], ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) &&
     check_pack(&v[1], ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
    println("[PASS] narrow_vec")
  else
    failed = failed + 1
    println("[FAIL] narrow_vec")
  end

  # Array of NarrowPack
  mut arr: [NarrowPack] = [make_pack(), make_pack(), make_pack()]
  if check_pack(&arr[0], ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) &&
     check_pack(&arr[1], ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) &&
     check_pack(&arr[2], ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
    println("[PASS] narrow_array")
  else
    failed = failed + 1
    println("[FAIL] narrow_array")
  end

  # Whole struct copy: mutate the source after copying; the copy must be intact.
  mut cp = make_pack()
  let copied = cp
  cp.a = false
  cp.z = true
  if check_pack(&copied, ORIG_A, ORIG_B, ORIG_C, ORIG_D, ORIG_E, ORIG_F, ORIG_G, ORIG_H, ORIG_Z) then
    passed = passed + 1
    println("[PASS] narrow_copy")
  else
    failed = failed + 1
    println("[FAIL] narrow_copy")
  end

  println("canary_narrow_storage: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
