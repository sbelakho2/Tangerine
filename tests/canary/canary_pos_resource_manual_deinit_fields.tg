# Positive canary: a user finalizer on a resource with RESOURCE FIELDS.
# The finalizer runs once; the compiler-owned structural field cleanup runs
# the inner resource's deinit exactly once.
use std::core

static mut outer_deinit_count: Int = 0
static mut inner_deinit_count: Int = 0

resource Inner
  x: Int
  def deinit(sink self: Self) -> Unit
    inner_deinit_count = inner_deinit_count + 1
  end
end

resource Outer
  inner: Inner
  tag: Int
  def deinit(sink self: Self) -> Unit
    outer_deinit_count = outer_deinit_count + 1
  end
end

def consume_outer(sink o: Outer) -> Int
  o.tag
end

def main() -> Int
  let o = Outer { inner: Inner { x: 1 }, tag: 5 }
  let tag = consume_outer(o)
  if tag == 5 && outer_deinit_count == 1 && inner_deinit_count == 1 then
    0
  else
    println("canary_pos_resource_manual_deinit_fields: FAIL outer=" + outer_deinit_count.to_string() + " inner=" + inner_deinit_count.to_string())
    1
  end
end
