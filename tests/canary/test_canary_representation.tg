# tests/canary/test_canary_representation.tg
# Native canary: compiler-representation-shaped structures.
#
# Exercises exactly the shapes the compiler itself relies on:
#   - adjacent Bool/u8/u16/u32 packs
#   - a CompilerOptions-like record (String + enum + many Bools + Option +
#     u8/u16/u32 + String + Bool)
#   - narrow-payload enums (A(Bool), B(u8), C(u16, Bool, u32))
#   - non-8-byte-multiple aggregate returns
#
# For every structure: construct, read every field, mutate one field and
# verify every OTHER field, copy, and return by value.
#
# Failure class: MEMORY_SAFETY / CODE_GEN_BUG (narrow representation corruption)

use std::core

struct Pack4B
  a: Bool
  b: Bool
  c: Bool
  d: Bool
end

struct Pack4U8
  a: u8
  b: u8
  c: u8
  d: u8
end

struct Pack2U16
  a: u16
  b: u16
end

struct Pack2U32
  a: u32
  b: u32
end

struct MixedPack
  a: Bool
  b: u8
  c: Bool
  d: u16
  e: Bool
  f: u32
  g: Bool
end

enum Level
  Low
  High
end

struct OptionsLike
  name: String
  level: Level
  verbose: Bool
  quiet: Bool
  debug: Bool
  optimize: Bool
  profile: Bool
  threshold: u8
  width: u16
  depth: u32
  hook: Option[Int]
  label: String
  final: Bool
end

enum NarrowE
  A(Bool)
  B(u8)
  C(u16, Bool, u32)
  None
end

struct Sret7
  a: u8
  b: u16
  c: u32
end

struct Sret12
  a: u32
  b: u32
  c: u32
end

struct Sret17
  a: u32
  b: u32
  c: u32
  d: u32
  e: u8
end

def check_pack4b(p: &Pack4B, ea: Bool, eb: Bool, ec: Bool, ed: Bool) -> Bool
  p.a == ea && p.b == eb && p.c == ec && p.d == ed
end

def check_pack4u8(p: &Pack4U8, ea: u8, eb: u8, ec: u8, ed: u8) -> Bool
  p.a == ea && p.b == eb && p.c == ec && p.d == ed
end

def check_options(o: &OptionsLike) -> Bool
  let hook_ok = match o.hook
  when Option::Some(v) then v == 42
  when Option::None then false
  end
  let base_ok = o.name == "driver" && o.level == Level::High &&
    o.verbose == true && o.quiet == false && o.debug == true &&
    o.optimize == false && o.profile == true && o.threshold == 200 &&
    o.width == 0xabcd && o.depth == 0x12345678
  base_ok && hook_ok && o.label == "compiler" && o.final == false
end

def make_options() -> OptionsLike
  OptionsLike {
    final: false,
    label: "compiler",
    hook: Option::Some(42),
    depth: 0x12345678,
    width: 0xabcd,
    threshold: 200,
    profile: true,
    optimize: false,
    debug: true,
    quiet: false,
    verbose: true,
    level: Level::High,
    name: "driver"
  }
end

def sret7() -> Sret7
  Sret7 { a: 1, b: 2, c: 3 }
end

def sret12() -> Sret12
  Sret12 { a: 0x11111111, b: 0x22222222, c: 0x33333333 }
end

def sret17() -> Sret17
  Sret17 { a: 1, b: 2, c: 3, d: 4, e: 5 }
end

def test_enum_a() -> Bool
  let e = NarrowE::A(true)
  match e
  when NarrowE::A(v) then v == true
  when _ then false
  end
end

def test_enum_b() -> Bool
  let e = NarrowE::B(255)
  match e
  when NarrowE::B(v) then v == 255
  when _ then false
  end
end

def test_enum_c() -> Bool
  let e = NarrowE::C(0xbeef, true, 0xdeadbeef)
  match e
  when NarrowE::C(a, b, c) then
    a == 0xbeef && b == true && c == 0xdeadbeef
  when _ then false
  end
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  mut p4b = Pack4B { a: true, b: false, c: true, d: false }
  if check_pack4b(&p4b, true, false, true, false) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] pack4b_init")
  end
  p4b.a = false
  if check_pack4b(&p4b, false, false, true, false) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] pack4b_mutate_a")
  end
  p4b.c = false
  if check_pack4b(&p4b, false, false, false, false) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] pack4b_mutate_c")
  end

  mut p4u8 = Pack4U8 { a: 1, b: 2, c: 3, d: 4 }
  p4u8.b = 200
  if check_pack4u8(&p4u8, 1, 200, 3, 4) then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] pack4u8")
  end

  mut p2u16 = Pack2U16 { a: 0x1111, b: 0x2222 }
  p2u16.a = 0xffff
  if p2u16.a == 0xffff && p2u16.b == 0x2222 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] pack2u16")
  end

  mut p2u32 = Pack2U32 { a: 0x11111111, b: 0x22222222 }
  p2u32.b = 0xdeadbeef
  if p2u32.a == 0x11111111 && p2u32.b == 0xdeadbeef then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] pack2u32")
  end

  mut mp = MixedPack { a: true, b: 77, c: false, d: 0x1234, e: true, f: 0xdeadbeef, g: false }
  mp.c = true
  if mp.a == true && mp.b == 77 && mp.c == true && mp.d == 0x1234 &&
     mp.e == true && mp.f == 0xdeadbeef && mp.g == false then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] mixed_pack")
  end

  mut opts = make_options()
  let opts_copy = opts
  opts.verbose = false
  opts.depth = 1
  opts.name = "changed"
  if check_options(&opts_copy) then
    passed = passed + 1
    println("[PASS] options_copy")
  else
    failed = failed + 1
    println("[FAIL] options_copy")
  end

  if test_enum_a() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] enum_a")
  end
  if test_enum_b() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] enum_b")
  end
  if test_enum_c() then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] enum_c")
  end

  let r7 = sret7()
  if r7.a == 1 && r7.b == 2 && r7.c == 3 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] sret7")
  end

  let r12 = sret12()
  if r12.a == 0x11111111 && r12.b == 0x22222222 && r12.c == 0x33333333 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] sret12")
  end

  let r17 = sret17()
  if r17.a == 1 && r17.b == 2 && r17.c == 3 && r17.d == 4 && r17.e == 5 then
    passed = passed + 1
  else
    failed = failed + 1
    println("[FAIL] sret17")
  end

  println("canary_representation: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
