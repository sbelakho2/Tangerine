# Positive effect-class canary (audit item 42): @interrupt is a
# compile-time interrupt-context claim, not just codegen metadata — the
# MIR-side enforcement (check_effect_class_annotations_mir) proves the
# handler's transitive summary against the interrupt-context rules. A
# volatile MMIO register read is CLEAN in a handler: the
# _tg_volatile_read32 extern is a width-exact volatile memory access
# (never allocation/blocking/OS I/O), recorded with may_io = false and
# the MMIO (hardware-register) capability — the interrupt-context
# no-uncontrolled-I/O carve-out that permits exactly the hardware
# effect. The canary compiles the annotated handler and runs main
# (exit 0) — the read is never executed at runtime.
use std::core
use std::embedded::volatile_read32

@interrupt
def uart_isr() -> u32
  volatile_read32(0x40000000)
end

def main() -> Int
  0
end
