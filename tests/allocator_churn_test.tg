# tests/allocator_churn_test.tg — Small-allocation reclamation churn.
#
# The runtime allocator's small path (payload <= 65536) serves a per-class
# LIFO free list (classes 16..65536) and the bump arena is only the
# free-list seed. A String value allocates its 32-byte object AND its data
# buffer through _tg_mem_alloc, and _tg_string_drop frees both through
# _tg_mem_free, so String create/drop cycles must reclaim through the free
# list: after the warm-up the allocator's outstanding bytes (total
# allocated minus freed; free-list blocks count as freed at the moment
# they are linked in) must NOT grow.
#
# Loop bound: 200,000 iterations of String::new() + push + drop (800,000
# allocator operations after warm-up) — well within the canary harness
# limits while being large enough that the old never-reclaiming bump
# policy would have grown outstanding bytes by ~48 bytes per iteration
# (~9.6 MB, 32 bytes object + 16 bytes class-16 data buffer).

use std::core

extern def tg_allocator_outstanding_bytes() -> Int

def churn_strings(n: Int) -> Int
  var i = 0
  while i < n do
    var s = String::new()
    s.push('x')
    i = i + 1
  end
  0
end

def main() -> Int
  # Warm-up: establish the steady-state free-list pools.
  let warm_rc = churn_strings(10000)
  if warm_rc != 0 then
    return 1
  end
  let baseline = tg_allocator_outstanding_bytes()

  # Churn: after the warm-up the outstanding bytes must stay flat — the
  # freed blocks are re-issued from the free list, never re-seeded.
  let churn_rc = churn_strings(200000)
  if churn_rc != 0 then
    return 2
  end
  let final = tg_allocator_outstanding_bytes()

  if final != baseline then
    println("allocator_churn: outstanding grew baseline=" + baseline.to_string() + " final=" + final.to_string())
    return 3
  end
  0
end
