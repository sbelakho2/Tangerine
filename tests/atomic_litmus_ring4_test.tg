# tests/atomic_litmus_ring4_test.tg — the N-THREAD store-buffering ring
# (the strengthened SB family — the reviewer's N-thread variant).
#
# Four threads on a ring, all operations SeqCst, run over ITERATIONS
# independent slots:
#   Thread i: x[i][s] = 1;  r[i][s] = x[(i + 1) % 4][s]
# Under sequentially consistent semantics the forbidden outcome
# r[0][s] == 0 && r[1][s] == 0 && r[2][s] == 0 && r[3][s] == 0 (EVERY
# load observing the pre-store value of its ring neighbor) can never
# occur: the four stores are totally ordered, so at least one load must
# read the store of the thread that follows it in the total order. The
# 2-thread SB pins the single pair; the ring pins the same
# total-order property with FOUR writers — a store that is only a plain
# MOV on x86-64 lets every load in the ring be served from the store
# buffers, and the 4-way forbidden outcome appears.
#
# Each slot s is an independent execution: no cross-slot reset, no
# barriers — the ordering comes from the atomic operations themselves.

use std::core
use std::atomic::{AtomicInt, Ordering}
use std::thread::{spawn}

extern def _tg_mem_alloc(size: UInt) -> Ptr[u8]
extern def _tg_mem_free(ptr: Ptr[u8], size: UInt) -> Unit

const ITERATIONS: Int = 20000

struct Slot
  v: AtomicInt
end

def ring_t0(x0: Ptr[Slot], x1: Ptr[Slot], r0: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    x0.offset(i).as_ref().v.store(1, Ordering::SeqCst)
    let v = x1.offset(i).as_ref().v.load(Ordering::SeqCst)
    r0.offset(i).write(v)
    i = i + 1
  end
  0
end

def ring_t1(x1: Ptr[Slot], x2: Ptr[Slot], r1: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    x1.offset(i).as_ref().v.store(1, Ordering::SeqCst)
    let v = x2.offset(i).as_ref().v.load(Ordering::SeqCst)
    r1.offset(i).write(v)
    i = i + 1
  end
  0
end

def ring_t2(x2: Ptr[Slot], x3: Ptr[Slot], r2: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    x2.offset(i).as_ref().v.store(1, Ordering::SeqCst)
    let v = x3.offset(i).as_ref().v.load(Ordering::SeqCst)
    r2.offset(i).write(v)
    i = i + 1
  end
  0
end

def ring_t3(x3: Ptr[Slot], x0: Ptr[Slot], r3: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    x3.offset(i).as_ref().v.store(1, Ordering::SeqCst)
    let v = x0.offset(i).as_ref().v.load(Ordering::SeqCst)
    r3.offset(i).write(v)
    i = i + 1
  end
  0
end

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  let bytes = (ITERATIONS * 8) as UInt
  let x0b = _tg_mem_alloc(bytes)
  let x1b = _tg_mem_alloc(bytes)
  let x2b = _tg_mem_alloc(bytes)
  let x3b = _tg_mem_alloc(bytes)
  let r0b = _tg_mem_alloc(bytes)
  let r1b = _tg_mem_alloc(bytes)
  let r2b = _tg_mem_alloc(bytes)
  let r3b = _tg_mem_alloc(bytes)
  if x0b.is_null() || x1b.is_null() || x2b.is_null() || x3b.is_null() ||
     r0b.is_null() || r1b.is_null() || r2b.is_null() || r3b.is_null() then
    println("atomic_litmus_ring4: allocation failed")
    return 1
  end
  let x0 = x0b.cast[Slot]()
  let x1 = x1b.cast[Slot]()
  let x2 = x2b.cast[Slot]()
  let x3 = x3b.cast[Slot]()
  let r0 = r0b.cast[Int]()
  let r1 = r1b.cast[Int]()
  let r2 = r2b.cast[Int]()
  let r3 = r3b.cast[Int]()

  var i = 0
  while i < ITERATIONS do
    x0.offset(i).write(Slot { v: AtomicInt::new(0) })
    x1.offset(i).write(Slot { v: AtomicInt::new(0) })
    x2.offset(i).write(Slot { v: AtomicInt::new(0) })
    x3.offset(i).write(Slot { v: AtomicInt::new(0) })
    i = i + 1
  end

  let h0 = spawn(move || ring_t0(x0, x1, r0))
  let h1 = spawn(move || ring_t1(x1, x2, r1))
  let h2 = spawn(move || ring_t2(x2, x3, r2))
  let h3 = spawn(move || ring_t3(x3, x0, r3))

  match h0.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_ring4: worker 0 failed with code " + code.to_string())
      return 10
    end
  when Result::Err(e) then
    println("atomic_litmus_ring4: join 0 failed: " + e)
    return 11
  end

  match h1.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_ring4: worker 1 failed with code " + code.to_string())
      return 12
    end
  when Result::Err(e) then
    println("atomic_litmus_ring4: join 1 failed: " + e)
    return 13
  end

  match h2.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_ring4: worker 2 failed with code " + code.to_string())
      return 14
    end
  when Result::Err(e) then
    println("atomic_litmus_ring4: join 2 failed: " + e)
    return 15
  end

  match h3.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_ring4: worker 3 failed with code " + code.to_string())
      return 16
    end
  when Result::Err(e) then
    println("atomic_litmus_ring4: join 3 failed: " + e)
    return 17
  end

  # The forbidden 4-way SB outcome: every load observed the pre-store
  # value of its ring neighbor.
  var forbidden = 0
  var observed = 0
  i = 0
  while i < ITERATIONS do
    let a = r0.offset(i).read()
    let b = r1.offset(i).read()
    let c = r2.offset(i).read()
    let d = r3.offset(i).read()
    if a == 1 then observed = observed + 1 end
    if b == 1 then observed = observed + 1 end
    if c == 1 then observed = observed + 1 end
    if d == 1 then observed = observed + 1 end
    if a == 0 && b == 0 && c == 0 && d == 0 then
      forbidden = forbidden + 1
    end
    i = i + 1
  end

  _tg_mem_free(x0b, bytes)
  _tg_mem_free(x1b, bytes)
  _tg_mem_free(x2b, bytes)
  _tg_mem_free(x3b, bytes)
  _tg_mem_free(r0b, bytes)
  _tg_mem_free(r1b, bytes)
  _tg_mem_free(r2b, bytes)
  _tg_mem_free(r3b, bytes)

  if forbidden != 0 then
    println("atomic_litmus_ring4: forbidden 4-way r==0 observed " + forbidden.to_string() + " times of " + ITERATIONS.to_string())
    return 2
  end
  # The vacuous-pass guard: the ring must actually exchange stores —
  # a run where NO load observed its neighbor's store exercised nothing.
  if observed == 0 then
    println("atomic_litmus_ring4: vacuous run — no ring store was observed over " + ITERATIONS.to_string() + " slots")
    return 3
  end
  0
end
