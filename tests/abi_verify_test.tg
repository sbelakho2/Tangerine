    name: "ext_f64".to_string(),
    params: Vec::from([Type::F64]),
    ret: Type::F64,
    variadic: false,
    is_extern: true,
    lir: lf,
    alloc: alloc
  })
  assert(rows.len() == 0, "the scalar extern declaration must verify clean; first: " + av_first(rows))
end

@test
def test_extern_c_scalar_boundary_passes() -> Unit
  let defs = Map::new()
  # caller(p: Ptr[Int]) calls extern `puts(p)`: the scalar pointer
  # crossing agrees between the internal and C classifications.
  let f = av_fn("extern_scalar_caller".to_string(),
    Vec::from([av_local(1, "p", Type::Ptr(Type::Int), false)]),
    Type::Unit,
    Vec::from([
      av_local(0, "ret", Type::Unit, false),
      av_local(1, "p", Type::Ptr(Type::Int), false),
      av_local(2, "dest", Type::Unit, false)
    ]),
    Vec::from([
      av_block(0, Vec::new(), av_call_term(av_place(2), "puts".to_string(), Vec::from([av_value_arg(1)]), 1)),
      av_block(1, Vec::new(), av_ret_term())
    ]))
  let lf = av_lower_a64(f, defs.clone())
  let alloc = lir_alloc_registers_a64(lf.clone())
  let sig = av_callee("puts".to_string(), Vec::from([Type::Ptr(Type::Int)]), Type::Unit, false, true)
  let rows = av_verify(aarch64_desc(), LirVerifyRoute::LirVerifyA64, defs.clone(), av_sig_map(sig),
    "extern_scalar_caller".to_string(), Vec::from([Type::Ptr(Type::Int)]), Type::Unit, false, lf, alloc)
  assert(rows.len() == 0, "the agreeing extern scalar boundary must verify clean; first: " + av_first(rows))
end

@test
def test_internal_call_boundary_passes_and_batch_forms() -> Unit
  let defs = Map::new()
  # callee(a: Int) and caller() calling it — the callee's plan drives the
  # caller's pre-call move positions.
  let callee = av_callee("takes_int".to_string(), Vec::from([Type::Int]), Type::Unit, false, false)
  let f = av_fn("internal_caller".to_string(),
    Vec::from([av_local(1, "x", Type::Int, false)]),
    Type::Unit,
    Vec::from([
      av_local(0, "ret", Type::Unit, false),
      av_local(1, "x", Type::Int, false),
      av_local(2, "dest", Type::Unit, false)
    ]),
    Vec::from([
      av_block(0, Vec::new(), av_call_term(av_place(2), "takes_int".to_string(), Vec::from([av_value_arg(1)]), 1)),
      av_block(1, Vec::new(), av_ret_term())
    ]))
  let lf = av_lower_a64(f, defs.clone())
  let alloc = lir_alloc_registers_a64(lf.clone())
  let ctx = abi_verify_ctx(aarch64_desc(), LirVerifyRoute::LirVerifyA64, defs.clone(), av_sig_map(callee))
  let vf = AbiVerifyFn {
    name: "internal_caller".to_string(),
    params: Vec::from([Type::Int]),
    ret: Type::Unit,
    variadic: false,
    is_extern: false,
    lir: lf,
    alloc: alloc
  }
  assert(abi_verified(ctx.clone(), Vec::from([vf.clone()])), "the internal call boundary must verify")
  assert(verify_abi(ctx, Vec::from([vf])).len() == 0, "verify_abi and abi_verified agree")
end

# ———————————————————————————————————————————————————————————————
# 5. Evidence: the driver route captures the real abi stage.
# ———————————————————————————————————————————————————————————————

def av_evidence(abi: Bool) -> VerifiedCompilationEvidence
  verified_compilation_evidence_stages(
    "rev-abi".to_string(),
    true, true, true, true, true, true, false, true, true, abi, true,
    verification_stage_names_driver_route())
end

@test
def test_driver_route_captures_abi_stage_for_real() -> Unit
  let ev = av_evidence(true)
  assert(evidence_stage_available(ev.clone(), "abi".to_string()), "the driver route captures the abi stage")
  assert(verification_status_is_verified(proof_evidence_status(ev, "abi".to_string(), true)), "a true abi flag is Verified")
  let bad = av_evidence(false)
  match proof_evidence_status(bad, "abi".to_string(), false)
  when VerificationStatus::Failed then ()
  when VerificationStatus::Unavailable then panic("a false abi flag on a CAPTURED stage must be Failed, never Unavailable")
  when VerificationStatus::Verified then panic("a false abi flag can never be Verified")
  end
end
