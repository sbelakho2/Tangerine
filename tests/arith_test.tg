def add(a: Int, b: Int) -> Int
  a + b
end

def mul(a: Int, b: Int) -> Int
  a * b
end

def fib(n: Int) -> Int
  if n <= 1 then
    n
  else
    add(fib(n - 1), fib(n - 2))
  end
end

def main() -> Unit
  let x = add(3, 4)
  let y = mul(x, 2)
  let z = fib(5)
  let result = add(y, z)
  # result should be 19 (7*2 + 5 = 19)
end
