# Runs the server side of one handshake: accept, then echo the client's
# 5-byte message back. Returns 0 on the full success path; 1 when the
# accept (handshake) fails — which the failure tests EXPECT; 2..4 on the
# echo-path failures.
def run_tls_echo_server(server: TlsServer) -> Int
  let mut srv = server
  let conn_res = srv.accept()
  match conn_res
  when Result::Err(_) then 1
  when Result::Ok(c) then
    let mut conn = c
    let mut buf: Vec[u8] = Vec::from([0u8, 0u8, 0u8, 0u8, 0u8])
    let read_res = conn.read(buf.as_mut_slice())
    match read_res
    when Result::Err(_) then 2
    when Result::Ok(nr) then
      if nr != 5 then
        3
      else
        let echo: Vec[u8] = Vec::from([104u8, 101u8, 108u8, 108u8, 111u8])  # "hello"
        let write_res = conn.write(echo)
        match write_res
        when Result::Err(_) then 4
        when Result::Ok(_) then 0
        end
      end
    end
  end
end

# Binds the listener on the main thread (no bind/accept race), moves the
# bound server into a worker thread, and returns the join handle.
def start_tls_server(server_cfg: TlsConfig) -> JoinHandle[Int]
  let mut server = TlsServer::new(server_cfg)
  assert_ok(server.bind("127.0.0.1", HANDSHAKE_PORT))
  spawn(move || run_tls_echo_server(server))
end

def client_cfg_with_ca(ca_cert: Certificate) -> TlsConfig
  var certs: Vec[Certificate] = Vec::new()
  certs.push(ca_cert)
  TlsConfig::default_client().with_ca_certs(certs)
end

def connect_client(client_cfg: TlsConfig, hostname: String) -> Result[TlsConnection, TlsError]
  let addr = socket_addr_v4(ipv4_localhost(), HANDSHAKE_PORT)
  let stream = match tcp_connect(addr)
  when Result::Ok(s) then s
  when Result::Err(e) then return Result::Err(TlsError::IoError(e.message()))
  end
  TlsConnection::connect(stream, client_cfg, Option::Some(hostname))
end

@test
def test_tls_handshake_trusted_ca_succeeds() -> Unit
  let cert = assert_ok(Certificate::from_pem(fixed_cert_pem()))
  let no_password: Option[String] = Option::None
  let key = assert_ok(PrivateKey::from_pem(fixed_key_pem(), no_password))
  let server_cfg = TlsConfig::default_server().with_certificate(cert, key)
  let mut handle = start_tls_server(server_cfg)

  let ca_cert = assert_ok(Certificate::from_pem(fixed_cert_pem()))
  let client_cfg = client_cfg_with_ca(ca_cert)
  let mut conn = assert_ok(connect_client(client_cfg, server_host()))
  assert_true(conn.is_connected())

  # Echo round trip over the live TLS session.
  let payload: Vec[u8] = Vec::from([104u8, 101u8, 108u8, 108u8, 111u8])  # "hello"
  let nw = assert_ok(conn.write(payload))
  assert_eq(nw, 5)
  let mut buf: Vec[u8] = Vec::from([0u8, 0u8, 0u8, 0u8, 0u8])
  let nr = assert_ok(conn.read(buf.as_mut_slice()))
  assert_eq(nr, 5)
  assert_eq(buf[0], 104u8)
  assert_eq(buf[1], 101u8)
  assert_eq(buf[2], 108u8)
  assert_eq(buf[3], 108u8)
  assert_eq(buf[4], 111u8)

  let server_rc = assert_ok(handle.join())
  assert_eq(server_rc, 0)
end

@test
def test_tls_handshake_untrusted_ca_fails() -> Unit
  let cert = assert_ok(Certificate::from_pem(fixed_cert_pem()))
  let no_password: Option[String] = Option::None
  let key = assert_ok(PrivateKey::from_pem(fixed_key_pem(), no_password))
  let server_cfg = TlsConfig::default_server().with_certificate(cert, key)
  let mut handle = start_tls_server(server_cfg)

  # The client verifies the peer but holds NO CA: the self-signed server
  # certificate fails the chain check and the handshake must fail.
  let client_cfg = TlsConfig::default_client()
  match connect_client(client_cfg, server_host())
  when Result::Err(_) then assert_true(true)
  when Result::Ok(_) then assert_false(true)
  end

  # The server side observes the aborted handshake (accept fails) — that
  # is the expected outcome here.
  let _ = assert_ok(handle.join())
  assert_true(true)
end

@test
def test_tls_handshake_wrong_hostname_fails() -> Unit
  let cert = assert_ok(Certificate::from_pem(fixed_cert_pem()))
  let no_password: Option[String] = Option::None
  let key = assert_ok(PrivateKey::from_pem(fixed_key_pem(), no_password))
  let server_cfg = TlsConfig::default_server().with_certificate(cert, key)
  let mut handle = start_tls_server(server_cfg)

  # The client TRUSTS the CA but connects under a hostname that does not
  # match the certificate CN: the hostname verification must fail.
  let ca_cert = assert_ok(Certificate::from_pem(fixed_cert_pem()))
  let client_cfg = client_cfg_with_ca(ca_cert)
  match connect_client(client_cfg, "wrong.example.com".to_string())
  when Result::Err(_) then assert_true(true)
  when Result::Ok(_) then assert_false(true)
  end

  let _ = assert_ok(handle.join())
  assert_true(true)
end

@test
def test_tls_handshake_alpn_h2_negotiated() -> Unit
  let cert = assert_ok(Certificate::from_pem(fixed_cert_pem()))
  let no_password: Option[String] = Option::None
  let key = assert_ok(PrivateKey::from_pem(fixed_key_pem(), no_password))

  var protocols: Vec[String] = Vec::new()
  protocols.push("h2".to_string())
  let server_cfg = TlsConfig::default_server()
    .with_certificate(cert, key)
    .with_alpn(protocols.clone())
  let mut handle = start_tls_server(server_cfg)

  let ca_cert = assert_ok(Certificate::from_pem(fixed_cert_pem()))
  let client_cfg = client_cfg_with_ca(ca_cert).with_alpn(protocols)
  let conn = assert_ok(connect_client(client_cfg, server_host()))
  assert_true(conn.is_connected())

  # The negotiated protocol must be the h2 both sides offered.
  match conn.negotiated_alpn()
  when Option::Some(p) then assert_eq(p, "h2")
  when Option::None then assert_false(true)
  end

  let _ = assert_ok(handle.join())
  assert_true(true)
end
