# tests/tls_handshake_test.tg — TLS handshake over loopback sockets.
#
# The full connection setup — the shim's SSL_accept/SSL_connect over
# loopback TCP — driven through std::tls:
#   (1) TRUSTED CA: the client's ca_certs trusts the server's self-signed
#       certificate and the SNI hostname matches the certificate CN — the
#       handshake succeeds and an echo round trip proves the session is
#       live.
#   (2) UNTRUSTED: the client verifies the peer WITHOUT any CA — the
#       self-signed certificate fails the chain check — the handshake
#       fails.
#   (3) WRONG HOSTNAME: the client trusts the CA but connects under a
#       hostname that does not match the certificate CN — the hostname
#       verification fails the handshake.
#   (4) ALPN: the client offers h2 and the server selects it — the
#       negotiated protocol must be h2.
#
# The fixed self-signed RSA-2048 certificate (CN=tangerine-interop.test,
# SAN DNS:tangerine-interop.test, valid 2026-08-21 .. 2046-08-21) and its
# matching PKCS#8 key are embedded so the suite never depends on external
# fixture files (same PEMs as
# tls_interop_test.tg). Each @test runs as its own process (the `tg test`
# per-test harness), so the fixed port is safe across the suite.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::tls::{Certificate, PrivateKey, TlsConfig, TlsConnection, TlsServer, TlsError}
use std::net::{tcp_connect, socket_addr_v4, ipv4_localhost}
use std::thread::{spawn, JoinHandle}

const HANDSHAKE_PORT: u16 = 38770u16

def server_host() -> String
  "tangerine-interop.test"
end

