use std::io::{print, println}

def int_to_string(n: Int) -> String
  if n == 0 then
    return "0"
  end
  mut val = n
  mut digits = ""
  if val < 0 then
    val = 0 - val
  end
  while val > 0 do
    let digit = val - ((val / 10) * 10)
    val = val / 10
    let ch = match digit
      when 0 then "0"
      when 1 then "1"
      when 2 then "2"
      when 3 then "3"
      when 4 then "4"
      when 5 then "5"
      when 6 then "6"
      when 7 then "7"
      when 8 then "8"
      when 9 then "9"
      else "?"
    end
    digits = ch + digits
  end
  digits
end

def test_op(desc: String, result: Int, expected: Int) -> Int
  print("  ")
  if result == expected then
    print("PASS")
  else
    print("FAIL")
  end
  print(": ")
  print(desc)
  print(" = ")
  println(int_to_string(result))
  if result == expected then 0 else 1 end
end

def add(a: Int, b: Int) -> Int
  a + b
end

def sub(a: Int, b: Int) -> Int
  a - b
end

def mul(a: Int, b: Int) -> Int
  a * b
end

def main() -> Int
  println("=== Test ===")
  mut fails = 0
  fails = fails + test_op("5+3", add(5, 3), 8)
  fails = fails + test_op("100-42", sub(100, 42), 58)
  fails = fails + test_op("10*7", mul(10, 7), 70)

  println("")
  print("fails = ")
  println(int_to_string(fails))

  if fails == 0 then
    println("ALL PASSED!")
  else
    println("SOME FAILED")
  end
  fails
end
