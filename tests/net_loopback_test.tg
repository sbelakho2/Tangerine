# tests/net_loopback_test.tg — TCP loopback integration: listener + client echo.
#
# Binds a TcpListener on 127.0.0.1:<fixed port>, connects a TcpStream client,
# accepts on the server side, writes an echo payload from the client and
# verifies the server reads the exact bytes back. The listener socket is
# bound with SO_REUSEADDR (tcp_bind) so a prior run's TIME_WAIT sockets never
# block rebinding. Each @test runs as its own process (the `tg test`
# per-test harness), so the fixed port is safe across the suite's tests.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::net::{tcp_bind, tcp_connect, socket_addr_v4, ipv4_localhost, IpAddr}
use std::io::{Read, Write}

const LOOPBACK_PORT: u16 = 38765u16

@test
def test_tcp_loopback_client_server_echo() -> Unit
  let addr = socket_addr_v4(ipv4_localhost(), LOOPBACK_PORT)
  let listener = assert_ok(tcp_bind(addr))

  let client = assert_ok(tcp_connect(addr))
  let server = assert_ok(listener.accept())

  let payload: Vec[u8] = Vec::from([104u8, 105u8, 33u8])  # "hi!"
  let n_written = assert_ok(client.write(payload))
  assert_eq(n_written, 3)

  let mut buf: Vec[u8] = Vec::from([0u8, 0u8, 0u8])
  let n_read = assert_ok(server.read(buf))
  assert_eq(n_read, 3)
  assert_eq(buf[0], 104u8)
  assert_eq(buf[1], 105u8)
  assert_eq(buf[2], 33u8)
end

@test
def test_tcp_loopback_localhost_addr_round_trip() -> Unit
  let addr = socket_addr_v4(ipv4_localhost(), LOOPBACK_PORT)
  let listener = assert_ok(tcp_bind(addr))
  let client = assert_ok(tcp_connect(addr))
  let server = assert_ok(listener.accept())

  # Server-side peer address must be the loopback client (127.0.0.1).
  let peer = server.peer_addr()
  match peer.ip
  when IpAddr::V4(ipv4)
    assert_eq(ipv4.to_string(), "127.0.0.1")
  when IpAddr::V6(_)
    assert_false(true)
  end
end
