use std::collections::{Vec}

struct Item
  name: String
end

struct LocalId
  id: Int
end

struct Span
  file: String
  start: Int
  end_pos: Int
end

enum TypeTag
  IntTy
end

struct MirLocal
  id: LocalId
  name: String
  ty: TypeTag
  is_mut: Bool
  span: Span
end

struct Func
  name: String
  params: Vec[MirLocal]
  ret_type: TypeTag
  locals: Vec[MirLocal]
  blocks: Vec[Int]
  entry_block: Int
  is_async: Bool
  is_unsafe: Bool
  is_extern: Bool
  extern_abi: String
  contracts: Vec[Int]
  span: Span
end

struct Builder
  current_fn: MaybeFunc
end

enum MaybeFunc
  Some(Func)
  None
end

def dummy_span() -> Span
  Span {
    file: "tests/field_push_repro.tg",
    start: 0,
    end_pos: 0
  }
end

def make_item() -> MirLocal
  MirLocal {
    id: LocalId { id: 0 },
    name: "_ret",
    ty: TypeTag::IntTy,
    is_mut: true,
    span: dummy_span()
  }
end

def push_local(b: &mut Builder) -> Unit
  let ret_local = make_item()
  match b.current_fn
  when MaybeFunc::Some(f) then
    f.locals.push(ret_local)
  when _ then ()
  end
end

def main() -> Int
  mut b = Builder {
    current_fn: MaybeFunc::Some(Func {
      name: "main",
      params: Vec::new(),
      ret_type: TypeTag::IntTy,
      locals: Vec::new(),
      blocks: Vec::new(),
      entry_block: 0,
      is_async: false,
      is_unsafe: false,
      is_extern: false,
      extern_abi: "",
      contracts: Vec::new(),
      span: dummy_span()
    })
  }
  push_local(&mut b)
  0
end