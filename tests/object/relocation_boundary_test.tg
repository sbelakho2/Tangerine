# tests/object/relocation_boundary_test.tg — The relocation boundary suite
# (the reviewer's item 13).
#
# The width-aware validator contract under test:
#   - a relocation PATCHES `width` bytes at its offset, so the last legal
#     site is len - width (offset == len and offset in (len - width, len)
#     are REJECTED — the patch would write past the section);
#   - the bounds arithmetic is OVERFLOW-SAFE (the check is
#     width > len - offset after offset <= len — never offset + width);
#   - every relocation names a symbol the object carries (unknown symbol =
#     reject);
#   - the AArch64 ADRP/ADD pair invariants: ADR_PREL_PG_HI21 at O requires
#     ADD_ABS_LO12_NC at O + 4 for the SAME symbol, and vice versa (and
#     the Mach-O PAGE21/PAGEOFF12 family under the same rule).
#
# Run with: tg run tests/object/relocation_boundary_test.tg

use std::core::{Option, Result, Int, String, Unit, Bool, panic}
use std::collections::{Vec, Map, Set}
use tg_compiler::object::{object_new, object_text_len, object_data_len, validate_object_file, ObjectFile}
use tg_compiler::asm::{asm_target, AsmTarget, Arch, OsAbi, Relocation, RelocKind, AsmSymbol, SymBinding, SymKind, Section}

mut tests_passed = 0
mut tests_failed = 0

def check(cond: Bool, name: String) -> Unit
  if cond then
    tests_passed = tests_passed + 1
    println("[PASS] " + name)
  else
    tests_failed = tests_failed + 1
    println("[FAIL] " + name)
  end
end

def a64_target() -> AsmTarget
  asm_target(Arch::AArch64, OsAbi::MacOS)
end

def x64_target() -> AsmTarget
  asm_target(Arch::X86_64, OsAbi::MacOS)
end

# An object with `text_len` bytes of text and one text relocation.
def obj_with_reloc(target: AsmTarget, text_len: Int, reloc: Relocation, sym_name: String) -> ObjectFile
  var obj = object_new(target)
  var text = Vec::new()
  var i = 0
  while i < text_len do
    text.push(0)
    i = i + 1
  end
  obj.text = text
  obj.relocations.push(reloc)
  obj.symbols.push(AsmSymbol {
    name: sym_name,
    section: Section::Extern,
    offset: 0,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })
  obj
end

def validator_accepts(obj: ObjectFile, target: AsmTarget) -> Bool
  match validate_object_file(obj, target, "")
  when Result::Ok(_) then true
  when Result::Err(_) then false
  end
end

def validator_error(obj: ObjectFile, target: AsmTarget) -> String
  match validate_object_file(obj, target, "")
  when Result::Ok(_) then "".to_string()
  when Result::Err(e) then e
  end
end

def test_width_bounds() -> Unit
  let target = a64_target()
  # 1. offset == len: a 4-byte relocation at the very end of the text.
  let r1 = Relocation { offset: 16, kind: RelocKind::R_AARCH64_CALL26, symbol: "s".to_string(), addend: 0 }
  check(!validator_accepts(obj_with_reloc(target, 16, r1, "s".to_string()), target), "offset == len rejected (4-byte patch at the section end)")
  # 2. offset == len - 1: the last byte cannot host a 4-byte patch.
  let r2 = Relocation { offset: 15, kind: RelocKind::R_AARCH64_CALL26, symbol: "s".to_string(), addend: 0 }
  check(!validator_accepts(obj_with_reloc(target, 16, r2, "s".to_string()), target), "offset == len - 1 rejected (4-byte patch crosses the end)")
  # 3. offset == len - 4: the patch ends exactly at the boundary — legal.
  let r3 = Relocation { offset: 12, kind: RelocKind::R_AARCH64_CALL26, symbol: "s".to_string(), addend: 0 }
  check(validator_accepts(obj_with_reloc(target, 16, r3, "s".to_string()), target), "offset == len - 4 accepted (patch ends exactly at the boundary)")
  # 4. A huge offset (the UINT_MAX / Int-max class): must be rejected
  # WITHOUT overflow in the width computation.
  let r4 = Relocation { offset: 9223372036854775807, kind: RelocKind::R_AARCH64_CALL26, symbol: "s".to_string(), addend: 0 }
  check(!validator_accepts(obj_with_reloc(target, 16, r4, "s".to_string()), target), "UINT_MAX-class offset rejected")
  # 5. Negative offset.
  let r5 = Relocation { offset: -1, kind: RelocKind::R_AARCH64_CALL26, symbol: "s".to_string(), addend: 0 }
  check(!validator_accepts(obj_with_reloc(target, 16, r5, "s".to_string()), target), "negative offset rejected")
  # 6. 8-byte relocations: R_AARCH64_ABS64 at len - 4 must be rejected
  # (width 8 > 4 remaining), at len - 8 accepted.
  let r6a = Relocation { offset: 12, kind: RelocKind::R_AARCH64_ABS64, symbol: "s".to_string(), addend: 0 }
  check(!validator_accepts(obj_with_reloc(target, 16, r6a, "s".to_string()), target), "8-byte relocation at len - 4 rejected (width-aware)")
  let r6b = Relocation { offset: 8, kind: RelocKind::R_AARCH64_ABS64, symbol: "s".to_string(), addend: 0 }
  check(validator_accepts(obj_with_reloc(target, 16, r6b, "s".to_string()), target), "8-byte relocation at len - 8 accepted")
  # 7. The x86_64 side: R_X86_64_64 (8 bytes) at len - 4 rejected.
  let xt = x64_target()
  let r7 = Relocation { offset: 12, kind: RelocKind::R_X86_64_64, symbol: "s".to_string(), addend: 0 }
  check(!validator_accepts(obj_with_reloc(xt, 16, r7, "s".to_string()), xt), "x86_64 8-byte relocation at len - 4 rejected (width-aware)")
  # 8. Data-section relocations under the same rule.
  let r8 = Relocation { offset: 15, kind: RelocKind::R_AARCH64_CALL26, symbol: "s".to_string(), addend: 0 }
  var obj8 = obj_with_reloc(target, 16, r8, "s".to_string())
  obj8.relocations = Vec::new()
  obj8.data_relocations.push(r8)
  obj8.symbols[0].section = Section::Data
  check(!validator_accepts(obj8, target), "data relocation at len - 1 rejected (width-aware)")
  let r8b = Relocation { offset: 12, kind: RelocKind::R_AARCH64_CALL26, symbol: "s".to_string(), addend: 0 }
  var obj8b = obj_with_reloc(target, 16, r8b, "s".to_string())
  obj8b.relocations = Vec::new()
  obj8b.data_relocations.push(r8b)
  obj8b.symbols[0].section = Section::Data
  check(validator_accepts(obj8b, target), "data relocation at len - 4 accepted")
  # 9. Unknown symbol: the relocation names a symbol the object carries no
  # entry for.
  let r9 = Relocation { offset: 0, kind: RelocKind::R_AARCH64_CALL26, symbol: "ghost".to_string(), addend: 0 }
  let err9 = validator_error(obj_with_reloc(target, 16, r9, "s".to_string()), target)
  check(err9.contains("unknown symbol"), "relocation naming an unknown symbol rejected")
  # 10. The wrong-kind class: any relocation in a section too small for
  # even its minimum width.
  let r10 = Relocation { offset: 0, kind: RelocKind::R_AARCH64_CALL26, symbol: "s".to_string(), addend: 0 }
  check(!validator_accepts(obj_with_reloc(target, 2, r10, "s".to_string()), target), "relocation in a 2-byte text rejected (wrong-kind/fail-closed width)")
end

# An object with 32 bytes of text and the given text relocations (the
# pair-invariant fixture).
def make_pair_obj(target: AsmTarget, relocs: Vec[Relocation]) -> ObjectFile
  var obj = object_new(target)
  var text = Vec::new()
  var i = 0
  while i < 32 do
    text.push(0)
    i = i + 1
  end
  obj.text = text
  obj.relocations = relocs.clone()
  obj.symbols.push(AsmSymbol {
    name: "s".to_string(),
    section: Section::Extern,
    offset: 0,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })
  obj
end

def test_adrp_add_pairs() -> Unit
  let target = a64_target()
  # 1. A valid ADRP + ADD pair (O and O + 4, same symbol).
  var ok_pair = Vec::new()
  ok_pair.push(Relocation { offset: 0, kind: RelocKind::R_AARCH64_ADR_PREL_PG_HI21, symbol: "s".to_string(), addend: 0 })
  ok_pair.push(Relocation { offset: 4, kind: RelocKind::R_AARCH64_ADD_ABS_LO12_NC, symbol: "s".to_string(), addend: 0 })
  check(validator_accepts(make_pair_obj(ok_pair), target), "valid ADRP/ADD pair accepted")
  # 2. ADRP without its lo12 partner.
  var no_pair = Vec::new()
  no_pair.push(Relocation { offset: 0, kind: RelocKind::R_AARCH64_ADR_PREL_PG_HI21, symbol: "s".to_string(), addend: 0 })
  check(!validator_accepts(make_pair_obj(no_pair), target), "ADRP without its lo12 partner rejected")
  # 3. ADD without its preceding ADRP.
  var no_adrp = Vec::new()
  no_adrp.push(Relocation { offset: 4, kind: RelocKind::R_AARCH64_ADD_ABS_LO12_NC, symbol: "s".to_string(), addend: 0 })
  check(!validator_accepts(make_pair_obj(no_adrp), target), "lo12 without its preceding ADRP rejected")
  # 4. The pair split by an unrelated relocation (ADRP at 0, CALL26 at 4,
  # ADD at 8): the ADD is not the ADRP's immediate successor.
  var split_pair = Vec::new()
  split_pair.push(Relocation { offset: 0, kind: RelocKind::R_AARCH64_ADR_PREL_PG_HI21, symbol: "s".to_string(), addend: 0 })
  split_pair.push(Relocation { offset: 4, kind: RelocKind::R_AARCH64_CALL26, symbol: "s".to_string(), addend: 0 })
  split_pair.push(Relocation { offset: 8, kind: RelocKind::R_AARCH64_ADD_ABS_LO12_NC, symbol: "s".to_string(), addend: 0 })
  check(!validator_accepts(make_pair_obj(split_pair), target), "ADRP/ADD pair split by an unrelated relocation rejected")
  # 5. The pair with the WRONG symbol on the lo12 half.
  var wrong_sym = Vec::new()
  wrong_sym.push(Relocation { offset: 0, kind: RelocKind::R_AARCH64_ADR_PREL_PG_HI21, symbol: "s".to_string(), addend: 0 })
  wrong_sym.push(Relocation { offset: 4, kind: RelocKind::R_AARCH64_ADD_ABS_LO12_NC, symbol: "t".to_string(), addend: 0 })
  var ws_obj = make_pair_obj(wrong_sym)
  ws_obj.symbols.push(AsmSymbol {
    name: "t".to_string(),
    section: Section::Extern,
    offset: 0,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })
  check(!validator_accepts(ws_obj, target), "ADRP/ADD pair with mismatched symbols rejected")
  # 6. The pair with a WRONG offset delta (ADRP at 0, ADD at 8).
  var wrong_off = Vec::new()
  wrong_off.push(Relocation { offset: 0, kind: RelocKind::R_AARCH64_ADR_PREL_PG_HI21, symbol: "s".to_string(), addend: 0 })
  wrong_off.push(Relocation { offset: 8, kind: RelocKind::R_AARCH64_ADD_ABS_LO12_NC, symbol: "s".to_string(), addend: 0 })
  check(!validator_accepts(make_pair_obj(wrong_off), target), "ADRP/ADD pair with a wrong offset delta rejected")
  # 7. The Mach-O family under the same rule.
  var macho_pair = Vec::new()
  macho_pair.push(Relocation { offset: 0, kind: RelocKind::ARM64_RELOC_PAGE21, symbol: "s".to_string(), addend: 0 })
  macho_pair.push(Relocation { offset: 4, kind: RelocKind::ARM64_RELOC_PAGEOFF12, symbol: "s".to_string(), addend: 0 })
  check(validator_accepts(make_pair_obj(macho_pair), target), "valid Mach-O PAGE21/PAGEOFF12 pair accepted")
  var macho_lone = Vec::new()
  macho_lone.push(Relocation { offset: 0, kind: RelocKind::ARM64_RELOC_PAGE21, symbol: "s".to_string(), addend: 0 })
  check(!validator_accepts(make_pair_obj(macho_lone), target), "lone Mach-O PAGE21 rejected")
  # 8. Multiple independent valid pairs.
  var two_pairs = Vec::new()
  two_pairs.push(Relocation { offset: 0, kind: RelocKind::R_AARCH64_ADR_PREL_PG_HI21, symbol: "s".to_string(), addend: 0 })
  two_pairs.push(Relocation { offset: 4, kind: RelocKind::R_AARCH64_ADD_ABS_LO12_NC, symbol: "s".to_string(), addend: 0 })
  two_pairs.push(Relocation { offset: 8, kind: RelocKind::R_AARCH64_ADR_PREL_PG_HI21, symbol: "s".to_string(), addend: 0 })
  two_pairs.push(Relocation { offset: 12, kind: RelocKind::R_AARCH64_ADD_ABS_LO12_NC, symbol: "s".to_string(), addend: 0 })
  check(validator_accepts(make_pair_obj(two_pairs), target), "two independent ADRP/ADD pairs accepted")
  # 9. The x86_64 target does not apply the AArch64 pair rule (its text
  # relocations are single-site).
  let xt = x64_target()
  var x_relocs = Vec::new()
  x_relocs.push(Relocation { offset: 0, kind: RelocKind::R_X86_64_PC32, symbol: "s".to_string(), addend: 0 })
  var x_obj = object_new(xt)
  var x_text = Vec::new()
  var i2 = 0
  while i2 < 16 do
    x_text.push(0)
    i2 = i2 + 1
  end
  x_obj.text = x_text
  x_obj.relocations = x_relocs
  x_obj.symbols.push(AsmSymbol {
    name: "s".to_string(),
    section: Section::Extern,
    offset: 0,
    size: 0,
    binding: SymBinding::Global,
    kind: SymKind::Func
  })
  check(validator_accepts(x_obj, xt), "x86_64 single-site relocation accepted (no pair rule)")
end

def main() -> Int
  println("========================================")
  println("Relocation Boundary Suite (item 13)")
  println("========================================")
  println("\n--- width-aware section bounds ---")
  test_width_bounds()
  println("\n--- AArch64 ADRP/ADD pair invariants ---")
  test_adrp_add_pairs()
  println("\n========================================")
  println("Results: " + tests_passed.to_string() + " passed, " + tests_failed.to_string() + " failed")
  println("========================================")
  if tests_failed > 0 then
    panic("RELOCATION BOUNDARY TESTS FAILED")
  end
  0
end
