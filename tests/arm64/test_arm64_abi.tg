# tests/arm64/test_arm64_abi.tg
# ARM64 ABI / encoder instruction-level tests.
#
# Encodes real ARM64 instructions through the encoder into a CodeBuffer
# and asserts the exact emitted little-endian bytes. These assertions are
# the regression net for the historical register-discriminant bug that
# mis-encoded X11/X19 (and thus broke LDR/STR on the wrong register).
#
# Failure class: ARM64_ENCODER_BUG / TARGET_DESCRIPTOR_BUG

use std::core
use tg_compiler::asm::{A64, a64_code, a64_arg_reg, a64_callee_saved,
                       buf_new, code_buffer_bytes_clone,
                       a64_movz, a64_add_rrr, a64_sub_rri, a64_ldr, a64_str}

def byte_at(b: &Vec[u8], i: Int) -> u8
  b[i]
end

def check_movz_x11_encoding() -> Bool
  let buf = buf_new()
  # MOVZ X11, #7, LSL #0  => 0xD28000EB (LE: EB 00 80 D2)
  a64_movz(&buf, A64::X11, 7, 0)
  let bytes = code_buffer_bytes_clone(&buf)
  bytes.len() == 4 &&
  byte_at(&bytes, 0) == (0xEB as u8) && byte_at(&bytes, 1) == (0x00 as u8) &&
  byte_at(&bytes, 2) == (0x80 as u8) && byte_at(&bytes, 3) == (0xD2 as u8)
end

def check_movz_x19_encoding() -> Bool
  let buf = buf_new()
  # MOVZ X19, #5, LSL #0  => 0xD28000B3 (LE: B3 00 80 D2)
  a64_movz(&buf, A64::X19, 5, 0)
  let bytes = code_buffer_bytes_clone(&buf)
  bytes.len() == 4 &&
  byte_at(&bytes, 0) == (0xB3 as u8) && byte_at(&bytes, 1) == (0x00 as u8) &&
  byte_at(&bytes, 2) == (0x80 as u8) && byte_at(&bytes, 3) == (0xD2 as u8)
end

def check_add_rrr_encoding() -> Bool
  let buf = buf_new()
  # ADD X0, X1, X2  => 0x8B020020 (LE: 20 00 02 8B)
  a64_add_rrr(&buf, A64::X0, A64::X1, A64::X2)
  let bytes = code_buffer_bytes_clone(&buf)
  byte_at(&bytes, 0) == (0x20 as u8) && byte_at(&bytes, 1) == (0x00 as u8) &&
  byte_at(&bytes, 2) == (0x02 as u8) && byte_at(&bytes, 3) == (0x8B as u8)
end

def check_sub_rri_encoding() -> Bool
  let buf = buf_new()
  # SUB X0, X1, #8  => 0xD1002020 (LE: 20 20 00 D1)
  a64_sub_rri(&buf, A64::X0, A64::X1, 8)
  let bytes = code_buffer_bytes_clone(&buf)
  byte_at(&bytes, 0) == (0x20 as u8) && byte_at(&bytes, 1) == (0x20 as u8) &&
  byte_at(&bytes, 2) == (0x00 as u8) && byte_at(&bytes, 3) == (0xD1 as u8)
end

def check_ldr_x11_base_x19_encoding() -> Bool
  let buf = buf_new()
  # LDR X11, [X19, #8]  => 0xF940066B (LE: 6B 06 40 F9)
  a64_ldr(&buf, A64::X11, A64::X19, 8)
  let bytes = code_buffer_bytes_clone(&buf)
  byte_at(&bytes, 0) == (0x6B as u8) && byte_at(&bytes, 1) == (0x06 as u8) &&
  byte_at(&bytes, 2) == (0x40 as u8) && byte_at(&bytes, 3) == (0xF9 as u8)
end

def check_str_x11_base_x19_encoding() -> Bool
  let buf = buf_new()
  # STR X11, [X19, #8]  => 0xF900066B (LE: 6B 06 00 F9)
  a64_str(&buf, A64::X11, A64::X19, 8)
  let bytes = code_buffer_bytes_clone(&buf)
  byte_at(&bytes, 0) == (0x6B as u8) && byte_at(&bytes, 1) == (0x06 as u8) &&
  byte_at(&bytes, 2) == (0x00 as u8) && byte_at(&bytes, 3) == (0xF9 as u8)
end

def check_x19_is_not_x10() -> Bool
  # The historical bug mapped X19 -> 10. Assert the real value is 19.
  a64_code(A64::X19) == 19 && a64_code(A64::X11) == 11
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_movz_x11_encoding() then
    passed = passed + 1
    println("[PASS] movz_x11_encoding")
  else
    failed = failed + 1
    println("[FAIL] movz_x11_encoding")
  end

  if check_movz_x19_encoding() then
    passed = passed + 1
    println("[PASS] movz_x19_encoding")
  else
    failed = failed + 1
    println("[FAIL] movz_x19_encoding")
  end

  if check_add_rrr_encoding() then
    passed = passed + 1
    println("[PASS] add_rrr_encoding")
  else
    failed = failed + 1
    println("[FAIL] add_rrr_encoding")
  end

  if check_sub_rri_encoding() then
    passed = passed + 1
    println("[PASS] sub_rri_encoding")
  else
    failed = failed + 1
    println("[FAIL] sub_rri_encoding")
  end

  if check_ldr_x11_base_x19_encoding() then
    passed = passed + 1
    println("[PASS] ldr_x11_base_x19")
  else
    failed = failed + 1
    println("[FAIL] ldr_x11_base_x19")
  end

  if check_str_x11_base_x19_encoding() then
    passed = passed + 1
    println("[PASS] str_x11_base_x19")
  else
    failed = failed + 1
    println("[FAIL] str_x11_base_x19")
  end

  if check_x19_is_not_x10() then
    passed = passed + 1
    println("[PASS] x19_is_not_x10")
  else
    failed = failed + 1
    println("[FAIL] x19_is_not_x10")
  end

  println("arm64_abi_encoder: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
