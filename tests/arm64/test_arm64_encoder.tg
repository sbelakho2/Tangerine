# tests/arm64/test_arm64_encoder.tg
# ARM64 encoder / register-encoding regression tests.
#
# This is the regression surface for the historical discriminant bug where
# A64::X11 encoded as 10 instead of 11, A64::X19 as 10 instead of 19, etc.
# Every register's encoded value MUST equal its ARM64 architectural number.
#
# Failure class: TARGET_DESCRIPTOR_BUG / ARM64_ENCODER_BUG

use tg_compiler::asm::{A64, A64V, a64_code, a64v_code, a64_arg_reg, a64_callee_saved}

def check_x_register_encodings() -> Bool
  # The whole X0..X28 range must encode to its own index.
  a64_code(A64::X0) == 0  && a64_code(A64::X1) == 1  &&
  a64_code(A64::X2) == 2  && a64_code(A64::X3) == 3  &&
  a64_code(A64::X4) == 4  && a64_code(A64::X5) == 5  &&
  a64_code(A64::X6) == 6  && a64_code(A64::X7) == 7  &&
  a64_code(A64::X8) == 8  && a64_code(A64::X9) == 9  &&
  a64_code(A64::X10) == 10 && a64_code(A64::X11) == 11 &&
  a64_code(A64::X12) == 12 && a64_code(A64::X13) == 13 &&
  a64_code(A64::X14) == 14 && a64_code(A64::X15) == 15 &&
  a64_code(A64::X16) == 16 && a64_code(A64::X17) == 17 &&
  a64_code(A64::X18) == 18 && a64_code(A64::X19) == 19 &&
  a64_code(A64::X20) == 20 && a64_code(A64::X21) == 21 &&
  a64_code(A64::X22) == 22 && a64_code(A64::X23) == 23 &&
  a64_code(A64::X24) == 24 && a64_code(A64::X25) == 25 &&
  a64_code(A64::X26) == 26 && a64_code(A64::X27) == 27 &&
  a64_code(A64::X28) == 28
end

def check_special_encodings() -> Bool
  a64_code(A64::FP) == 29 && a64_code(A64::LR) == 30 &&
  a64_code(A64::SP) == 31 && a64_code(A64::XZR) == 31
end

def check_v_register_encodings() -> Bool
  a64v_code(A64V::V0) == 0  && a64v_code(A64V::V10) == 10 &&
  a64v_code(A64V::V19) == 19 && a64v_code(A64V::V31) == 31
end

def check_arg_register_map() -> Bool
  match a64_arg_reg(0)
  when Option::Some(A64::X0) then ()
  when _ then return false
  end
  match a64_arg_reg(7)
  when Option::Some(A64::X7) then ()
  when _ then return false
  end
  match a64_arg_reg(8)
  when Option::Some(_) then return false
  when Option::None then ()
  end
  true
end

def check_callee_saved_set() -> Bool
  let saved = a64_callee_saved()
  if saved.len() != 10 then
    return false
  end
  # Every callee-saved register must be in X19..X28.
  let codes = [a64_code(saved[0]), a64_code(saved[1]), a64_code(saved[2]),
               a64_code(saved[3]), a64_code(saved[4]), a64_code(saved[5]),
               a64_code(saved[6]), a64_code(saved[7]), a64_code(saved[8]),
               a64_code(saved[9])]
  mut i = 0
  while i < codes.len() do
    if codes[i] != 19 + i then
      return false
    end
    i = i + 1
  end
  true
end

def run() -> Int
  mut passed = 0
  mut failed = 0

  if check_x_register_encodings() then
    passed = passed + 1
    println("[PASS] x_register_encodings")
  else
    failed = failed + 1
    println("[FAIL] x_register_encodings")
  end

  if check_special_encodings() then
    passed = passed + 1
    println("[PASS] special_encodings")
  else
    failed = failed + 1
    println("[FAIL] special_encodings")
  end

  if check_v_register_encodings() then
    passed = passed + 1
    println("[PASS] v_register_encodings")
  else
    failed = failed + 1
    println("[FAIL] v_register_encodings")
  end

  if check_arg_register_map() then
    passed = passed + 1
    println("[PASS] arg_register_map")
  else
    failed = failed + 1
    println("[FAIL] arg_register_map")
  end

  if check_callee_saved_set() then
    passed = passed + 1
    println("[PASS] callee_saved_set")
  else
    failed = failed + 1
    println("[FAIL] callee_saved_set")
  end

  println("arm64_encoder: " + passed.to_string() + " passed, " + failed.to_string() + " failed")
  failed
end

def main() -> Int
  run()
end
