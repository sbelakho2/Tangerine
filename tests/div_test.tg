use std::io::{print, println}

def int_to_string(n: Int) -> String
  if n == 0 then
    return "0"
  end
  mut val = n
  mut digits = ""
  while val > 0 do
    let digit = val - ((val / 10) * 10)
    val = val / 10
    let ch = match digit
      when 0 then "0"
      when 1 then "1"
      when 2 then "2"
      when 3 then "3"
      when 4 then "4"
      when 5 then "5"
      when 6 then "6"
      when 7 then "7"
      when 8 then "8"
      when 9 then "9"
      else "?"
    end
    digits = ch + digits
  end
  digits
end

def main() -> Int
  let a = 84
  let b = 12
  let r = a / b
  print("84 / 12 = ")
  println(int_to_string(r))

  let c = 100
  let d = 3
  let r2 = c / d
  print("100 / 3 = ")
  println(int_to_string(r2))

  let r3 = 42 / 6
  print("42 / 6 = ")
  println(int_to_string(r3))

  0
end
