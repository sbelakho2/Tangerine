# tests/layout/test_header_consistency.tg — Header consistency tests (Test F)
# Verifies that built-in type headers (Vec, String, Map, Set, Option, Result)
# have the expected field count, field names, and field offsets as defined
# by the layout engine. These are the "golden header definitions."
#
# Failure class: HEADER_MODEL_BUG
#
# If these fail, MirFieldDef or MirVariantDef definitions are inconsistent
# with what the codegen and runtime expect.

use std::test
use std::mem

# ———————————————————————————————————————————————————————————————
# §F.1 Vec[T] header — golden definition
#   Field 0: ptr  (Ptr[T])  offset=0   size=8
#   Field 1: len  (Int)     offset=8   size=8
#   Field 2: cap  (Int)     offset=16  size=8
#   Total size: 24
# ———————————————————————————————————————————————————————————————

test "Vec[Int] has 3 fields (ptr, len, cap)" do
  let v: Vec[Int] = Vec::new()
  assert_eq(field_count_of(v), 3)
end

test "Vec field names are ptr, len, cap" do
  assert_eq(field_name_of[Vec[Int]](0), "ptr")
  assert_eq(field_name_of[Vec[Int]](1), "len")
  assert_eq(field_name_of[Vec[Int]](2), "cap")
end

test "Vec field offsets golden" do
  assert_eq(field_offset_of[Vec[Int]](0), 0)   # ptr
  assert_eq(field_offset_of[Vec[Int]](1), 8)   # len
  assert_eq(field_offset_of[Vec[Int]](2), 16)  # cap
end

# ———————————————————————————————————————————————————————————————
# §F.2 String header — golden definition
#   Same layout as Vec[u8]:
#   Field 0: ptr  (Ptr[u8]) offset=0   size=8
#   Field 1: len  (Int)     offset=8   size=8
#   Field 2: cap  (Int)     offset=16  size=8
#   Total size: 24
# ———————————————————————————————————————————————————————————————

test "String has 3 fields (ptr, len, cap)" do
  let s = ""
  assert_eq(field_count_of(s), 3)
end

test "String total size is 24" do
  assert_eq(size_of[String](), 24)
end

test "String field offsets golden" do
  assert_eq(field_offset_of[String](0), 0)   # ptr
  assert_eq(field_offset_of[String](1), 8)   # len
  assert_eq(field_offset_of[String](2), 16)  # cap
end

# ———————————————————————————————————————————————————————————————
# §F.3 Option[T] header — golden definition
#   Field 0: tag   (Int) offset=0  size=8
#   Field 1: value (T)   offset=8  size=8
#   Total size: 16
# ———————————————————————————————————————————————————————————————

test "Option[Int] total size is 16" do
  assert_eq(size_of[Option[Int]](), 16)
end

test "Option discriminant: None=0, Some=1" do
  assert_eq(discriminant_of(Option::None as Option[Int]), 0)
  assert_eq(discriminant_of(Option::Some(42)), 1)
end

# ———————————————————————————————————————————————————————————————
# §F.4 Result[T,E] header — golden definition
#   Field 0: tag   (Int) offset=0  size=8
#   Field 1: value (T)   offset=8  size=8
#   Field 2: error (E)   offset=16 size=8
#   Total size: 24
# ———————————————————————————————————————————————————————————————

test "Result[Int, String] total size is 24" do
  assert_eq(size_of[Result[Int, String]](), 24)
end

# ———————————————————————————————————————————————————————————————
# §F.5 TgStr ABI header — golden definition
#   Field 0: ptr  (u64) offset=0  size=8
#   Field 1: len  (u64) offset=8  size=8
#   Total size: 16
# ———————————————————————————————————————————————————————————————

struct TgStrVerify
  ptr: u64
  len: u64
end

test "TgStr header size is 16" do
  assert_eq(size_of[TgStrVerify](), 16)
end

test "TgStr field offsets" do
  let s = TgStrVerify { ptr: 0u64, len: 0u64 }
  assert_eq(offset_of(s, "ptr"), 0)
  assert_eq(offset_of(s, "len"), 8)
end

# ———————————————————————————————————————————————————————————————
# §F.6 TgSlice ABI header — golden definition
#   Field 0: ptr  (u64) offset=0  size=8
#   Field 1: len  (u64) offset=8  size=8
#   Total size: 16
# ———————————————————————————————————————————————————————————————

struct TgSliceVerify
  ptr: u64
  len: u64
end

test "TgSlice header size is 16" do
  assert_eq(size_of[TgSliceVerify](), 16)
end

# ———————————————————————————————————————————————————————————————
# §F.7 TgInterfaceHeader ABI header — golden definition
#   Field 0: abi_major  (u32) offset=0   size=4
#   Field 1: abi_minor  (u32) offset=4   size=4
#   Field 2: size_bytes (u32) offset=8   size=4
#   Total size: 12
# ———————————————————————————————————————————————————————————————

struct TgInterfaceHeaderVerify
  abi_major: u32
  abi_minor: u32
  size_bytes: u32
end

test "TgInterfaceHeader size is 12" do
  assert_eq(size_of[TgInterfaceHeaderVerify](), 12)
end

test "TgInterfaceHeader field offsets" do
  let h = TgInterfaceHeaderVerify { abi_major: 0u32, abi_minor: 0u32, size_bytes: 0u32 }
  assert_eq(offset_of(h, "abi_major"), 0)
  assert_eq(offset_of(h, "abi_minor"), 4)
  assert_eq(offset_of(h, "size_bytes"), 8)
end
