# tests/layout/test_store_load_roundtrip.tg — Store/load roundtrip tests (Test C)
# Verifies that storing a value to memory and loading it back produces
# the identical value, with byte-level oracle verification.
#
# Failure class: LAYOUT_CONSUMER_BUG

use std::test
use std::mem

# ———————————————————————————————————————————————————————————————
# §C.1 Primitive roundtrip
# ———————————————————————————————————————————————————————————————

test "Int roundtrip through raw pointer" do
  let original: Int = 0x123456789ABCDEF0
  let buf = alloc(8)
  store_int(buf, original)
  let loaded = load_int(buf)
  assert_eq(loaded, original)
  free(buf)
end

test "Bool roundtrip" do
  let buf = alloc(1)
  store_bool(buf, true)
  assert_eq(load_bool(buf), true)
  store_bool(buf, false)
  assert_eq(load_bool(buf), false)
  free(buf)
end

test "u8 roundtrip" do
  let buf = alloc(1)
  store_u8(buf, 0xFFu8)
  assert_eq(load_u8(buf), 0xFFu8)
  store_u8(buf, 0x00u8)
  assert_eq(load_u8(buf), 0x00u8)
  free(buf)
end

test "u32 roundtrip" do
  let buf = alloc(4)
  store_u32(buf, 0xDEADBEEFu32)
  assert_eq(load_u32(buf), 0xDEADBEEFu32)
  free(buf)
end

# ———————————————————————————————————————————————————————————————
# §C.2 Struct roundtrip with field-by-field verification
# ———————————————————————————————————————————————————————————————

struct RtPair
  x: Int
  y: Int
end

test "RtPair roundtrip preserves both fields" do
  let original = RtPair { x: 100, y: 200 }
  let buf = alloc(16)
  store_raw(buf, &original, 16)
  let loaded = load_raw[RtPair](buf, 16)
  assert_eq(loaded.x, 100)
  assert_eq(loaded.y, 200)
  free(buf)
end

test "RtPair byte-level oracle: field x at [0..8), field y at [8..16)" do
  let original = RtPair { x: 1, y: 2 }
  let buf = alloc(16)
  store_raw(buf, &original, 16)
  # Read bytes individually at known offsets
  assert_eq(load_u8_at(buf, 0), 0x01u8)   # x low byte
  assert_eq(load_u8_at(buf, 8), 0x02u8)   # y low byte
  free(buf)
end

struct RtMixed
  flag: Bool
  count: Int
  name: String
end

test "RtMixed roundtrip with alignment gaps" do
  let original = RtMixed { flag: true, count: 42, name: "hello" }
  let buf = alloc(40)
  store_raw(buf, &original, 40)
  let loaded = load_raw[RtMixed](buf, 40)
  assert_eq(loaded.flag, true)
  assert_eq(loaded.count, 42)
  assert_eq(loaded.name, "hello")
  free(buf)
end

# ———————————————————————————————————————————————————————————————
# §C.3 Enum roundtrip
# ———————————————————————————————————————————————————————————————

enum RtResult
  RtOk(Int)
  RtErr(String)
end

test "RtResult::RtOk roundtrip" do
  let original = RtResult::RtOk(42)
  let buf = alloc(32)
  store_raw(buf, &original, 32)
  let loaded = load_raw[RtResult](buf, 32)
  match loaded
  when RtResult::RtOk(v) then assert_eq(v, 42)
  when RtResult::RtErr(_) then panic("expected RtOk")
  end
  free(buf)
end

# ———————————————————————————————————————————————————————————————
# §C.4 Vec header roundtrip
# ———————————————————————————————————————————————————————————————

test "Vec[Int] header roundtrip" do
  mut v: Vec[Int] = Vec::new()
  v.push(10)
  v.push(20)
  v.push(30)
  # Verify fields survived through layout
  assert_eq(v.len(), 3)
  assert_eq(v[0], 10)
  assert_eq(v[1], 20)
  assert_eq(v[2], 30)
end

# ———————————————————————————————————————————————————————————————
# §C.5 Cross-field interference test
# ———————————————————————————————————————————————————————————————

struct RtFourFields
  a: Int
  b: Int
  c: Int
  d: Int
end

test "Writing to one field does not corrupt adjacent fields" do
  mut s = RtFourFields { a: 1, b: 2, c: 3, d: 4 }
  s.b = 999
  assert_eq(s.a, 1)    # must not be corrupted
  assert_eq(s.b, 999)  # changed
  assert_eq(s.c, 3)    # must not be corrupted
  assert_eq(s.d, 4)    # must not be corrupted
end

test "Writing all fields in sequence" do
  mut s = RtFourFields { a: 0, b: 0, c: 0, d: 0 }
  s.a = 0x1111111111111111
  s.b = 0x2222222222222222
  s.c = 0x3333333333333333
  s.d = 0x4444444444444444
  assert_eq(s.a, 0x1111111111111111)
  assert_eq(s.b, 0x2222222222222222)
  assert_eq(s.c, 0x3333333333333333)
  assert_eq(s.d, 0x4444444444444444)
end
