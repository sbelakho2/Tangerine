# tests/layout/packed_align_test.tg — The attributed-layout RUNTIME suite
# (@repr(C) / @align(N) / @packed through the full pipeline: parser ->
# checker -> MIR -> codegen -> the native binary).
#
# These tests exercise the source-level attributes end-to-end:
#   - the @packed EpollEvent { u32 events @ 0, UInt data @ 4 } — the
#     kernel x86-64 epoll_event shape: size 12, align 1 — field reads
#     and writes through the byte-wise UNALIGNED load/store lowering
#     (a direct 8-byte mov at offset 4 would be misaligned);
#   - the @align(N) struct — the declared alignment, the max-rule field
#     offsets and the tail padding (queried through size_of/align_of);
#   - the @repr(C) struct — the natural C layout and the C-ABI
#     classification.
#
# Run with: tg test tests/layout/packed_align_test.tg

use std::core::{Bool, Int, UInt, Unit, Option, Result, String}
use std::test::*
use std::alloc::{size_of, align_of}

# ———————————————————————————————————————————————————————————————
# @packed — the kernel epoll_event shape
# ———————————————————————————————————————————————————————————————
# The Linux x86-64 `struct epoll_event` is PACKED: { u32 events @ 0,
# u64 data @ 4 } — size 12, alignment 4 (the kernel's own layout). The
# Tangerine @packed spelling produces EXACTLY the kernel offsets: the
# data field sits at byte 4, never the padded offset 8.
@packed
struct EpollEvent
  events: u32
  data: UInt
end

@test
def test_packed_epoll_layout() -> Unit
  assert_eq(size_of[EpollEvent](), 12)
  assert_eq(align_of[EpollEvent](), 1)
end

@test
def test_packed_field_access_roundtrip() -> Unit
  mut ev = EpollEvent { events: 0x1234u32, data: 0xDEADBEEFCAFEBABE }
  # The u64 at offset 4: a misaligned read/write through the byte-wise
  # lowering (never a direct 8-byte mov).
  assert_eq(ev.events, 0x1234u32)
  assert_eq(ev.data, 0xDEADBEEFCAFEBABE)
  ev.data = 42
  assert_eq(ev.data, 42)
  ev.events = 7u32
  assert_eq(ev.events, 7u32)
end

@test
def test_packed_neighbor_fields_do_not_overlap() -> Unit
  mut ev = EpollEvent { events: 0xFFFFFFFFu32, data: 0 }
  # Writing the narrow field must not corrupt the packed neighbor (the
  # u64's low 4 bytes sit right after events at offset 4 — a too-wide
  # store would clobber them).
  ev.events = 5u32
  assert_eq(ev.events, 5u32)
  assert_eq(ev.data, 0)
  ev.data = 0x0102030405060708
  assert_eq(ev.data, 0x0102030405060708)
  assert_eq(ev.events, 5u32)
end

# A packed struct with an odd-offset u32: { u8 @ 0, u32 @ 1 } — the u32
# read/write is UNALIGNED (1 % 4 != 0).
@packed
struct PackedOdd
  tag: u8
  word: u32
end

@test
def test_packed_odd_offset_access() -> Unit
  mut p = PackedOdd { tag: 0xAAu8, word: 0xCAFEBABEu32 }
  assert_eq(p.tag, 0xAAu8)
  assert_eq(p.word, 0xCAFEBABEu32)
  p.word = 0xDEADBEEFu32
  assert_eq(p.word, 0xDEADBEEFu32)
  assert_eq(p.tag, 0xAAu8)
  assert_eq(size_of[PackedOdd](), 5)
  assert_eq(align_of[PackedOdd](), 1)
end

# A @packed struct nested inside a natural (aligned) struct: the inner
# keeps its packed offsets; the outer places it per its align-1 record.
struct OuterNatural
  a: u32
  inner: PackedOdd
  b: UInt
end

@test
def test_nested_packed_access() -> Unit
  mut o = OuterNatural { a: 11, inner: PackedOdd { tag: 0xBBu8, word: 99 }, b: 1000 }
  assert_eq(o.a, 11)
  assert_eq(o.inner.tag, 0xBBu8)
  assert_eq(o.inner.word, 99)
  assert_eq(o.b, 1000)
  o.inner.word = 12345
  assert_eq(o.inner.word, 12345)
  assert_eq(o.a, 11)
  assert_eq(o.b, 1000)
  # The inner sits at offset 4 (align 1) and its word at 4 + 1 = 5 — an
  # unaligned absolute offset (5 % 4 != 0).
  assert_eq(size_of[OuterNatural](), 16)
end

# ———————————————————————————————————————————————————————————————
# @align(N) — the declared alignment, the max-rule offsets, the tail
# padding
# ———————————————————————————————————————————————————————————————
@align(16)
struct Aligned16
  a: u8
  b: u32
end

@test
def test_align_n_layout() -> Unit
  assert_eq(align_of[Aligned16](), 16)
  assert_eq(size_of[Aligned16](), 32)
end

@test
def test_align_n_field_access() -> Unit
  mut s = Aligned16 { a: 0x55u8, b: 0x11223344u32 }
  assert_eq(s.a, 0x55u8)
  assert_eq(s.b, 0x11223344u32)
  s.b = 0x44332211u32
  assert_eq(s.b, 0x44332211u32)
  assert_eq(s.a, 0x55u8)
end

# ———————————————————————————————————————————————————————————————
# @repr(C) — the natural C layout
# ———————————————————————————————————————————————————————————————
@repr(C)
struct CRepr
  a: u8
  b: u32
  c: UInt
end

@test
def test_repr_c_layout_and_access() -> Unit
  assert_eq(size_of[CRepr](), 16)
  assert_eq(align_of[CRepr](), 8)
  mut s = CRepr { a: 1u8, b: 2u32, c: 3 }
  assert_eq(s.a, 1u8)
  assert_eq(s.b, 2u32)
  assert_eq(s.c, 3)
  s.c = 4
  assert_eq(s.c, 4)
end
