# tests/layout/test_byte_image.tg — Byte-image layout tests (Test B)
# Verifies that writing a value and reading raw bytes produces the
# exact expected byte pattern.  Detects silent endianness, padding,
# and field-ordering miscompilations.
#
# Failure class: LAYOUT_COMPUTATION_BUG or LAYOUT_CONSUMER_BUG

use std::test
use std::mem

# ———————————————————————————————————————————————————————————————
# §B.1 Primitive byte images
# ———————————————————————————————————————————————————————————————

test "Bool true byte image" do
  let val: Bool = true
  let bytes = to_bytes(&val, 1)
  assert_eq(bytes[0], 1u8)
end

test "Bool false byte image" do
  let val: Bool = false
  let bytes = to_bytes(&val, 1)
  assert_eq(bytes[0], 0u8)
end

test "u8 byte image" do
  let val: u8 = 0xABu8
  let bytes = to_bytes(&val, 1)
  assert_eq(bytes[0], 0xABu8)
end

test "Int(42) little-endian byte image" do
  let val: Int = 42
  let bytes = to_bytes(&val, 8)
  # 42 = 0x2A little-endian: 2A 00 00 00 00 00 00 00
  assert_eq(bytes[0], 0x2Au8)
  assert_eq(bytes[1], 0x00u8)
  assert_eq(bytes[2], 0x00u8)
  assert_eq(bytes[3], 0x00u8)
  assert_eq(bytes[4], 0x00u8)
  assert_eq(bytes[5], 0x00u8)
  assert_eq(bytes[6], 0x00u8)
  assert_eq(bytes[7], 0x00u8)
end

test "Int(-1) little-endian byte image" do
  let val: Int = -1
  let bytes = to_bytes(&val, 8)
  # -1 = 0xFFFFFFFFFFFFFFFF little-endian
  assert_eq(bytes[0], 0xFFu8)
  assert_eq(bytes[1], 0xFFu8)
  assert_eq(bytes[2], 0xFFu8)
  assert_eq(bytes[3], 0xFFu8)
  assert_eq(bytes[4], 0xFFu8)
  assert_eq(bytes[5], 0xFFu8)
  assert_eq(bytes[6], 0xFFu8)
  assert_eq(bytes[7], 0xFFu8)
end

test "u32(0xDEADBEEF) byte image" do
  let val: u32 = 0xDEADBEEFu32
  let bytes = to_bytes(&val, 4)
  # little-endian: EF BE AD DE
  assert_eq(bytes[0], 0xEFu8)
  assert_eq(bytes[1], 0xBEu8)
  assert_eq(bytes[2], 0xADu8)
  assert_eq(bytes[3], 0xDEu8)
end

# ———————————————————————————————————————————————————————————————
# §B.2 Struct byte images
# ———————————————————————————————————————————————————————————————

struct ByteImgPair
  a: Int
  b: Int
end

test "ByteImgPair field a at bytes [0..8)" do
  let p = ByteImgPair { a: 1, b: 2 }
  let bytes = to_bytes(&p, 16)
  # a = 1 at offset 0: 01 00 00 00 00 00 00 00
  assert_eq(bytes[0], 0x01u8)
  assert_eq(bytes[1], 0x00u8)
  # b = 2 at offset 8: 02 00 00 00 00 00 00 00
  assert_eq(bytes[8], 0x02u8)
  assert_eq(bytes[9], 0x00u8)
end

struct ByteImgMixed
  flag: Bool
  value: Int
end

test "ByteImgMixed padding between flag and value" do
  let m = ByteImgMixed { flag: true, value: 0xFF }
  let bytes = to_bytes(&m, 16)
  # flag at offset 0: 01
  assert_eq(bytes[0], 0x01u8)
  # value at offset 8 (aligned): FF 00 00 00 00 00 00 00
  assert_eq(bytes[8], 0xFFu8)
  assert_eq(bytes[9], 0x00u8)
end

# ———————————————————————————————————————————————————————————————
# §B.3 Enum byte images (tag + payload)
# ———————————————————————————————————————————————————————————————

enum ByteImgOption
  BNone
  BSome(Int)
end

test "ByteImgOption::BNone tag is 0" do
  let o = ByteImgOption::BNone
  let bytes = to_bytes(&o, 8)
  # discriminant tag at offset 0 = 0
  assert_eq(bytes[0], 0x00u8)
end

test "ByteImgOption::BSome(42) tag is 1, payload is 42" do
  let o = ByteImgOption::BSome(42)
  let bytes = to_bytes(&o, 16)
  # discriminant tag at offset 0 = 1
  assert_eq(bytes[0], 0x01u8)
  # payload at offset 8 = 42 (0x2A)
  assert_eq(bytes[8], 0x2Au8)
end

# ———————————————————————————————————————————————————————————————
# §B.4 Vec header byte image
# ———————————————————————————————————————————————————————————————

test "Empty Vec header bytes" do
  let v: Vec[Int] = Vec::new()
  let bytes = to_bytes(&v, 24)
  # ptr at offset 0: may be null or heap address — skip exact value
  # len at offset 8: should be 0
  assert_eq(bytes[8], 0x00u8)
  assert_eq(bytes[9], 0x00u8)
  assert_eq(bytes[10], 0x00u8)
  assert_eq(bytes[11], 0x00u8)
  assert_eq(bytes[12], 0x00u8)
  assert_eq(bytes[13], 0x00u8)
  assert_eq(bytes[14], 0x00u8)
  assert_eq(bytes[15], 0x00u8)
end
