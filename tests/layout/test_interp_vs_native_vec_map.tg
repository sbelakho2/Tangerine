# tests/layout/test_interp_vs_native_vec_map.tg — Vec/Map differential tests
# Companion to test_interp_vs_native.tg: verifies that the interpreter
# (stage0) and the native compiler/runtime (stage1) produce IDENTICAL
# observable behaviour for Vec and Map operations, including the
# nested-Map-receiver case (a Map value retrieved from an outer Map and
# used as the receiver for further Map methods).
#
# The test deliberately uses well-defined operations that agree across both
# engines: indexing, len, push, contains_key, and match-based get. It does
# NOT depend on the return value of `Vec.pop`, `Map.insert`/`Map.remove`
# (whose ABI differs) or on `Map.is_empty`, so the outputs can be diffed
# byte-for-byte.
#
# Failure class: LAYOUT_CONSUMER_BUG, HEADER_MODEL_BUG or ABI_BOUNDARY_BUG
#
# Usage:
#   ./stage0_swift/.build/release/tg_stage0 interpret tests/layout/test_interp_vs_native_vec_map.tg > interp_out.txt
#   ./build/tg_stage1 run tests/layout/test_interp_vs_native_vec_map.tg > native_out.txt
#   diff interp_out.txt native_out.txt

use std::io

# ———————————————————————————————————————————————————————————————
# §V.1 Vec operations — growth, indexing, pop
# ———————————————————————————————————————————————————————————————

def report_vec_ops() -> Unit
  mut v: Vec[Int] = Vec::new()
  println("vec.empty_len=" + v.len().to_string())
  v.push(10)
  v.push(20)
  v.push(30)
  v.push(40)
  v.push(50)
  println("vec.len=" + v.len().to_string())
  println("vec.at0=" + v[0].to_string())
  println("vec.at1=" + v[1].to_string())
  println("vec.at2=" + v[2].to_string())
  println("vec.at4=" + v[4].to_string())
  v.pop()
  println("vec.len_after_pop=" + v.len().to_string())
  println("vec.at0_after_pop=" + v[0].to_string())
end

# ———————————————————————————————————————————————————————————————
# §V.2 Vec of Map — containers nested inside Vec
# ———————————————————————————————————————————————————————————————

def report_vec_of_maps() -> Unit
  mut list: Vec[Map[String, Int]] = Vec::new()
  mut m1: Map[String, Int] = Map::new()
  m1.insert("x", 1)
  list.push(m1)
  mut m2: Map[String, Int] = Map::new()
  m2.insert("y", 2)
  m2.insert("z", 3)
  list.push(m2)
  println("vecofmap.len=" + list.len().to_string())
  match list[0].get("x")
  when Option::Some(v) then println("vecofmap.first_x=" + v.to_string())
  when Option::None then println("vecofmap.first_x=none")
  end
  println("vecofmap.first_has_x=" + list[0].contains_key("x").to_string())
  match list[1].get("z")
  when Option::Some(v) then println("vecofmap.second_z=" + v.to_string())
  when Option::None then println("vecofmap.second_z=none")
  end
  println("vecofmap.second_has_y=" + list[1].contains_key("y").to_string())
end

# ———————————————————————————————————————————————————————————————
# §V.3 Map operations — insert/get/contains_key/len/remove
# ———————————————————————————————————————————————————————————————

def report_map_ops() -> Unit
  mut m: Map[String, Int] = Map::new()
  println("map.empty_len=" + m.len().to_string())
  m.insert("one", 1)
  m.insert("two", 2)
  m.insert("three", 3)
  println("map.len=" + m.len().to_string())
  println("map.has_one=" + m.contains_key("one").to_string())
  println("map.has_four=" + m.contains_key("four").to_string())
  match m.get("one")
  when Option::Some(v) then println("map.one=" + v.to_string())
  when Option::None then println("map.one=none")
  end
  match m.get("three")
  when Option::Some(v) then println("map.three=" + v.to_string())
  when Option::None then println("map.three=none")
  end
  match m.get("four")
  when Option::Some(v) then println("map.four=" + v.to_string())
  when Option::None then println("map.four=none")
  end

  m.insert("one", 111)
  match m.get("one")
  when Option::Some(v) then println("map.one_after_replace=" + v.to_string())
  when Option::None then println("map.one_after_replace=none")
  end
  println("map.len_after_replace=" + m.len().to_string())

  m.remove("two")
  println("map.len_after_remove=" + m.len().to_string())
  println("map.has_two_after=" + m.contains_key("two").to_string())
  println("map.has_one_after=" + m.contains_key("one").to_string())
end

# ———————————————————————————————————————————————————————————————
# §V.4 Nested-Map-receiver case — a Map retrieved from an outer Map
#      is used as the receiver for further Map method calls.
# ———————————————————————————————————————————————————————————————

def report_nested_map_receiver() -> Unit
  mut outer: Map[String, Map[String, Int]] = Map::new()
  mut inner: Map[String, Int] = Map::new()
  inner.insert("alpha", 10)
  inner.insert("beta", 20)
  inner.insert("gamma", 30)
  println("nested.inner_before_len=" + inner.len().to_string())
  outer.insert("group", inner)
  println("nested.outer_len=" + outer.len().to_string())

  match outer.get("group")
  when Option::Some(nested) then
    # `nested` is &Map[String, Int]; the nested map is the receiver.
    println("nested.has_alpha=" + nested.contains_key("alpha").to_string())
    println("nested.has_delta=" + nested.contains_key("delta").to_string())
    println("nested.len=" + nested.len().to_string())
    match nested.get("alpha")
    when Option::Some(v) then println("nested.alpha=" + v.to_string())
    when Option::None then println("nested.alpha=none")
    end
    match nested.get("beta")
    when Option::Some(v) then println("nested.beta=" + v.to_string())
    when Option::None then println("nested.beta=none")
    end
    match nested.get("delta")
    when Option::Some(v) then println("nested.delta=" + v.to_string())
    when Option::None then println("nested.delta=none")
    end
  when Option::None then
    println("nested.group_missing=yes")
  end

  match outer.get("nope")
  when Option::Some(_) then println("nested.nope=present")
  when Option::None then println("nested.nope=none")
  end
end

# ———————————————————————————————————————————————————————————————
# Main: produce a deterministic fingerprint of Vec/Map operations
# ———————————————————————————————————————————————————————————————

def main() -> Int
  println("=== Interpreter vs Native Vec/Map Comparison ===")
  report_vec_ops()
  report_vec_of_maps()
  report_map_ops()
  report_nested_map_receiver()
  println("=== END ===")
  0
end
