# tests/layout/test_mutation.tg — Mutation / injected-offset tests (Test G)
# Verifies that deliberately wrong offsets DETECTABLY produce wrong results.
# This validates that the test suite itself has sufficient sensitivity to
# catch real layout bugs — if these tests pass, the harness is effective.
#
# Failure class: (meta) — validates test harness sensitivity
#
# Strategy: Write known values at correct offsets, then read at
# INTENTIONALLY wrong offsets and verify the read returns garbage (not
# the expected value). If reading at a wrong offset returns the correct
# value, the test harness is too weak.

use std::test
use std::mem

# ———————————————————————————————————————————————————————————————
# §G.1 Wrong-offset detection for Int pair
# ———————————————————————————————————————————————————————————————

struct MutPair
  a: Int
  b: Int
end

test "Reading field a at wrong offset detects corruption" do
  let p = MutPair { a: 0x1111111111111111, b: 0x2222222222222222 }
  let bytes = to_bytes(&p, 16)
  # Correct: a is at offset 0
  let correct_a = read_int_at(bytes, 0)
  assert_eq(correct_a, 0x1111111111111111)
  # Wrong: reading a at offset 1 must NOT produce the correct value
  let wrong_a = read_int_at(bytes, 1)
  assert(wrong_a != 0x1111111111111111)
end

test "Reading field b at wrong offset detects corruption" do
  let p = MutPair { a: 0x1111111111111111, b: 0x2222222222222222 }
  let bytes = to_bytes(&p, 16)
  # Correct: b is at offset 8
  let correct_b = read_int_at(bytes, 8)
  assert_eq(correct_b, 0x2222222222222222)
  # Wrong: reading b at offset 0 returns field a's value
  let wrong_b = read_int_at(bytes, 0)
  assert(wrong_b != 0x2222222222222222)
end

# ———————————————————————————————————————————————————————————————
# §G.2 Off-by-one field offset detection
# ———————————————————————————————————————————————————————————————

struct MutTriple
  x: Int
  y: Int
  z: Int
end

test "Off-by-8 offset gives wrong field" do
  let t = MutTriple { x: 100, y: 200, z: 300 }
  # Accessing y via the correct field
  assert_eq(t.y, 200)
  # If layout were wrong and y was at offset 0 instead of 8,
  # we'd get x's value. Verify the fields are distinct:
  assert(t.x != t.y)
  assert(t.y != t.z)
  assert(t.x != t.z)
end

# ———————————————————————————————————————————————————————————————
# §G.3 Enum tag corruption detection
# ———————————————————————————————————————————————————————————————

enum MutColor
  Red
  Green
  Blue
end

test "Distinct discriminant values are actually distinct" do
  let r = discriminant_of(MutColor::Red)
  let g = discriminant_of(MutColor::Green)
  let b = discriminant_of(MutColor::Blue)
  # All three must be different
  assert(r != g)
  assert(g != b)
  assert(r != b)
end

test "Discriminants are sequential 0,1,2" do
  assert_eq(discriminant_of(MutColor::Red), 0)
  assert_eq(discriminant_of(MutColor::Green), 1)
  assert_eq(discriminant_of(MutColor::Blue), 2)
end

# ———————————————————————————————————————————————————————————————
# §G.4 Padding corruption detection
# ———————————————————————————————————————————————————————————————

struct MutPadded
  flag: Bool    # 1 byte, followed by 7 bytes padding
  value: Int    # 8 bytes at offset 8
end

test "Padding bytes do not affect field value" do
  let m = MutPadded { flag: true, value: 0xDEADBEEF }
  # If the compiler incorrectly puts value at offset 1 instead of 8,
  # this test catches it because the flag byte (0x01) would overlap.
  assert_eq(m.flag, true)
  assert_eq(m.value, 0xDEADBEEF)
end

test "Bool field does not bleed into padding" do
  let m1 = MutPadded { flag: false, value: 0 }
  let m2 = MutPadded { flag: true, value: 0 }
  # Both must have value=0 regardless of flag
  assert_eq(m1.value, 0)
  assert_eq(m2.value, 0)
end

# ———————————————————————————————————————————————————————————————
# §G.5 Cross-field write isolation
# ———————————————————————————————————————————————————————————————

struct MutIsolation
  a: Int
  b: Int
  c: Int
  d: Int
end

test "Mutating one field does not corrupt others (sentinel pattern)" do
  mut s = MutIsolation {
    a: 0xAAAAAAAAAAAAAAAA,
    b: 0xBBBBBBBBBBBBBBBB,
    c: 0xCCCCCCCCCCCCCCCC,
    d: 0xDDDDDDDDDDDDDDDD
  }
  # Mutate only field b
  s.b = 0x0000000000000000
  # Verify sentinels are intact
  assert_eq(s.a, 0xAAAAAAAAAAAAAAAA)
  assert_eq(s.b, 0x0000000000000000)
  assert_eq(s.c, 0xCCCCCCCCCCCCCCCC)
  assert_eq(s.d, 0xDDDDDDDDDDDDDDDD)
end

test "Mutating last field does not corrupt others" do
  mut s = MutIsolation {
    a: 0x1111111111111111,
    b: 0x2222222222222222,
    c: 0x3333333333333333,
    d: 0x4444444444444444
  }
  s.d = 0xFFFFFFFFFFFFFFFF
  assert_eq(s.a, 0x1111111111111111)
  assert_eq(s.b, 0x2222222222222222)
  assert_eq(s.c, 0x3333333333333333)
  assert_eq(s.d, 0xFFFFFFFFFFFFFFFF)
end

test "Mutating first field does not corrupt others" do
  mut s = MutIsolation {
    a: 0x1111111111111111,
    b: 0x2222222222222222,
    c: 0x3333333333333333,
    d: 0x4444444444444444
  }
  s.a = 0x0000000000000000
  assert_eq(s.a, 0x0000000000000000)
  assert_eq(s.b, 0x2222222222222222)
  assert_eq(s.c, 0x3333333333333333)
  assert_eq(s.d, 0x4444444444444444)
end
