# tests/layout/test_golden_layout.tg — Golden layout corpus (Test A)
# Verifies expected size, alignment, stride, and field offsets
# for all primitive, aggregate, and user-defined types.
#
# This is the single authoritative oracle for layout correctness.
# If any of these assertions fail, LAYOUT_COMPUTATION_BUG is indicated.

use std::test
use std::mem

# ———————————————————————————————————————————————————————————————
# §A.1 Primitive type sizes
# ———————————————————————————————————————————————————————————————

test "Bool size is 1" do
  assert_eq(size_of[Bool](), 1)
end

test "u8 size is 1" do
  assert_eq(size_of[u8](), 1)
end

test "i8 size is 1" do
  assert_eq(size_of[i8](), 1)
end

test "u16 size is 2" do
  assert_eq(size_of[u16](), 2)
end

test "i16 size is 2" do
  assert_eq(size_of[i16](), 2)
end

test "Char size is 4" do
  assert_eq(size_of[Char](), 4)
end

test "u32 size is 4" do
  assert_eq(size_of[u32](), 4)
end

test "i32 size is 4" do
  assert_eq(size_of[i32](), 4)
end

test "f32 size is 4" do
  assert_eq(size_of[f32](), 4)
end

test "Int size is 8" do
  assert_eq(size_of[Int](), 8)
end

test "UInt size is 8" do
  assert_eq(size_of[UInt](), 8)
end

test "u64 size is 8" do
  assert_eq(size_of[u64](), 8)
end

test "i64 size is 8" do
  assert_eq(size_of[i64](), 8)
end

test "Float size is 8" do
  assert_eq(size_of[Float](), 8)
end

test "f64 size is 8" do
  assert_eq(size_of[f64](), 8)
end

# ———————————————————————————————————————————————————————————————
# §A.2 Aggregate type sizes
# ———————————————————————————————————————————————————————————————

test "String size is 24" do
  assert_eq(size_of[String](), 24)
end

test "Vec[Int] size is 24" do
  assert_eq(size_of[Vec[Int]](), 24)
end

test "Vec[u8] size is 24" do
  assert_eq(size_of[Vec[u8]](), 24)
end

test "Box[Int] size is 8" do
  assert_eq(size_of[Box[Int]](), 8)
end

test "Ptr[u8] size is 8" do
  assert_eq(size_of[Ptr[u8]](), 8)
end

test "Option[Int] size is 16" do
  assert_eq(size_of[Option[Int]](), 16)
end

test "Result[Int, String] size is 24" do
  assert_eq(size_of[Result[Int, String]](), 24)
end

# ———————————————————————————————————————————————————————————————
# §A.3 Vec[T] field offsets  — { ptr: 0, len: 8, cap: 16 }
# ———————————————————————————————————————————————————————————————

test "Vec ptr field at offset 0" do
  let v: Vec[Int] = Vec::new()
  assert_eq(offset_of(v, "ptr"), 0)
end

test "Vec len field at offset 8" do
  let v: Vec[Int] = Vec::new()
  assert_eq(offset_of(v, "len"), 8)
end

test "Vec cap field at offset 16" do
  let v: Vec[Int] = Vec::new()
  assert_eq(offset_of(v, "cap"), 16)
end

# ———————————————————————————————————————————————————————————————
# §A.4 String field offsets  — { ptr: 0, len: 8, cap: 16 }
# ———————————————————————————————————————————————————————————————

test "String ptr field at offset 0" do
  let s = ""
  assert_eq(offset_of(s, "ptr"), 0)
end

test "String len field at offset 8" do
  let s = ""
  assert_eq(offset_of(s, "len"), 8)
end

test "String cap field at offset 16" do
  let s = ""
  assert_eq(offset_of(s, "cap"), 16)
end

# ———————————————————————————————————————————————————————————————
# §A.5 Option[T] field offsets  — { tag: 0, value: 8 }
# ———————————————————————————————————————————————————————————————

test "Option tag field at offset 0" do
  let o: Option[Int] = Option::Some(42)
  assert_eq(offset_of(o, "tag"), 0)
end

test "Option value field at offset 8" do
  let o: Option[Int] = Option::Some(42)
  assert_eq(offset_of(o, "value"), 8)
end

# ———————————————————————————————————————————————————————————————
# §A.6 User-defined struct layout
# ———————————————————————————————————————————————————————————————

struct LayoutTestPair
  first: Int
  second: Int
end

test "LayoutTestPair size is 16" do
  assert_eq(size_of[LayoutTestPair](), 16)
end

test "LayoutTestPair.first at offset 0" do
  let p = LayoutTestPair { first: 10, second: 20 }
  assert_eq(offset_of(p, "first"), 0)
end

test "LayoutTestPair.second at offset 8" do
  let p = LayoutTestPair { first: 10, second: 20 }
  assert_eq(offset_of(p, "second"), 8)
end

struct LayoutTestMixed
  flag: Bool
  count: Int
  name: String
end

test "LayoutTestMixed.flag at offset 0" do
  let m = LayoutTestMixed { flag: true, count: 5, name: "hello" }
  assert_eq(offset_of(m, "flag"), 0)
end

test "LayoutTestMixed.count aligned to 8 (offset 8)" do
  let m = LayoutTestMixed { flag: true, count: 5, name: "hello" }
  # Bool(1) padded to align(8) = 8
  assert_eq(offset_of(m, "count"), 8)
end

test "LayoutTestMixed.name at offset 16" do
  let m = LayoutTestMixed { flag: true, count: 5, name: "hello" }
  assert_eq(offset_of(m, "name"), 16)
end

struct LayoutTestTriple
  x: Int
  y: Int
  z: Int
end

test "LayoutTestTriple size is 24" do
  assert_eq(size_of[LayoutTestTriple](), 24)
end

test "LayoutTestTriple.x at 0, .y at 8, .z at 16" do
  let t = LayoutTestTriple { x: 1, y: 2, z: 3 }
  assert_eq(offset_of(t, "x"), 0)
  assert_eq(offset_of(t, "y"), 8)
  assert_eq(offset_of(t, "z"), 16)
end

# ———————————————————————————————————————————————————————————————
# §A.7 Enum discriminant layout
# ———————————————————————————————————————————————————————————————

enum LayoutTestColor
  Red
  Green
  Blue
end

test "LayoutTestColor discriminant values" do
  assert_eq(discriminant_of(LayoutTestColor::Red), 0)
  assert_eq(discriminant_of(LayoutTestColor::Green), 1)
  assert_eq(discriminant_of(LayoutTestColor::Blue), 2)
end

enum LayoutTestShape
  Circle(Int)
  Rect(Int, Int)
  Empty
end

test "LayoutTestShape discriminant values" do
  assert_eq(discriminant_of(LayoutTestShape::Circle(5)), 0)
  assert_eq(discriminant_of(LayoutTestShape::Rect(3, 4)), 1)
  assert_eq(discriminant_of(LayoutTestShape::Empty), 2)
end

test "LayoutTestShape tag at offset 0, payload at offset 8" do
  let s = LayoutTestShape::Circle(42)
  assert_eq(offset_of(s, "tag"), 0)
  # payload starts at offset 8 (past the 8-byte discriminant tag)
end
