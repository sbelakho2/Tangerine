# tests/layout/test_cross_target_layout.tg — Cross-target layout tests (Test E)
# Verifies that layout decisions are consistent between AArch64 and x86-64
# targets for the same type definitions. Golden values below are the
# canonical expected values for BOTH architectures (LP64 model).
#
# Failure class: TARGET_DESCRIPTOR_BUG
#
# These values must be the same on both arm64 and x86_64 since Tangerine
# uses an LP64 data model (8-byte pointers, 8-byte Int) on both targets.

use std::test
use std::mem

# ———————————————————————————————————————————————————————————————
# §E.1 Golden size table — must match on all LP64 targets
# ———————————————————————————————————————————————————————————————

# Primitive sizes (target-independent)
test "cross-target: Bool is 1 byte on all targets" do
  assert_eq(size_of[Bool](), 1)
end

test "cross-target: Int is 8 bytes on all LP64 targets" do
  assert_eq(size_of[Int](), 8)
end

test "cross-target: u32 is 4 bytes on all targets" do
  assert_eq(size_of[u32](), 4)
end

test "cross-target: f64 is 8 bytes on all targets" do
  assert_eq(size_of[f64](), 8)
end

# Aggregate sizes (layout-dependent)
test "cross-target: String is 8 bytes (raw pointer ABI) on all LP64 targets" do
  assert_eq(size_of[String](), 8)
end

test "cross-target: Vec[Int] is 24 bytes on all LP64 targets" do
  assert_eq(size_of[Vec[Int]](), 24)
end

test "cross-target: Option[Int] is 16 bytes on all LP64 targets" do
  assert_eq(size_of[Option[Int]](), 16)
end

test "cross-target: Box[Int] is 8 bytes on all LP64 targets" do
  assert_eq(size_of[Box[Int]](), 8)
end

# ———————————————————————————————————————————————————————————————
# §E.2 Golden field offset table — shared across both architectures
# ———————————————————————————————————————————————————————————————

struct CrossTargetVecHeader
  ptr: Ptr[u8]
  len: Int
  cap: Int
end

test "cross-target: Vec header field offsets" do
  let v = CrossTargetVecHeader { ptr: null_ptr(), len: 0, cap: 0 }
  assert_eq(offset_of(v, "ptr"), 0)
  assert_eq(offset_of(v, "len"), 8)
  assert_eq(offset_of(v, "cap"), 16)
end

struct CrossTargetStringHeader
  ptr: Ptr[u8]
  len: Int
  cap: Int
end

# NOTE: String VALUES use the raw-pointer ABI (8 bytes, no inline header).
# This struct models the internal char-Vec buffer produced by str.chars(),
# which is laid out like Vec[u8]. It is NOT the String value ABI.
test "cross-target: String char-buffer (Vec-like) field offsets" do
  let s = CrossTargetStringHeader { ptr: null_ptr(), len: 0, cap: 0 }
  assert_eq(offset_of(s, "ptr"), 0)
  assert_eq(offset_of(s, "len"), 8)
  assert_eq(offset_of(s, "cap"), 16)
end

# ———————————————————————————————————————————————————————————————
# §E.3 Alignment golden table
# ———————————————————————————————————————————————————————————————

test "cross-target: Int alignment is 8" do
  assert_eq(align_of[Int](), 8)
end

test "cross-target: Bool alignment is 1" do
  assert_eq(align_of[Bool](), 1)
end

test "cross-target: u32 alignment is 4" do
  assert_eq(align_of[u32](), 4)
end

test "cross-target: Ptr alignment is 8" do
  assert_eq(align_of[Ptr[u8]](), 8)
end

# ———————————————————————————————————————————————————————————————
# §E.4 Struct padding golden table
# ———————————————————————————————————————————————————————————————

struct CrossPadded
  a: Bool  # 1 byte + 7 padding
  b: Int   # 8 bytes
end

test "cross-target: Bool+Int struct size includes padding" do
  # Bool(1) + 7 padding + Int(8) = 16
  assert_eq(size_of[CrossPadded](), 16)
end

struct CrossPacked
  a: Int
  b: Int
  c: Int
end

test "cross-target: three-Int struct has no padding" do
  assert_eq(size_of[CrossPacked](), 24)
end
