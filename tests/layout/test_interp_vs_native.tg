# tests/layout/test_interp_vs_native.tg — Interpreter vs Native layout tests (Test D)
# Verifies that the interpreter and native codegen produce identical
# memory representations for the same types. Run this test under BOTH
# the interpreter (stage0) and the native binary (stage1); the outputs
# must match byte-for-byte.
#
# Failure class: LAYOUT_CONSUMER_BUG or TARGET_DESCRIPTOR_BUG
#
# Usage:
#   ./stage0_swift/.build/release/tg_stage0 run tests/layout/test_interp_vs_native.tg > interp_out.txt
#   ./build/tg_stage1 run tests/layout/test_interp_vs_native.tg > native_out.txt
#   diff interp_out.txt native_out.txt

use std::io

# ———————————————————————————————————————————————————————————————
# §D.1 Struct field access — print computed values
# Results MUST be identical between interpreter and native.
# ———————————————————————————————————————————————————————————————

struct IvsNPair
  x: Int
  y: Int
end

struct IvsNMixed
  flag: Bool
  count: Int
  name: String
end

struct IvsNTriple
  a: Int
  b: Int
  c: Int
end

def report_pair() -> Unit
  let p = IvsNPair { x: 100, y: 200 }
  println("pair.x=" + p.x.to_string())
  println("pair.y=" + p.y.to_string())
end

def report_mixed() -> Unit
  let m = IvsNMixed { flag: true, count: 42, name: "hello" }
  println("mixed.flag=" + m.flag.to_string())
  println("mixed.count=" + m.count.to_string())
  println("mixed.name=" + m.name)
end

def report_triple() -> Unit
  let t = IvsNTriple { a: 11, b: 22, c: 33 }
  println("triple.a=" + t.a.to_string())
  println("triple.b=" + t.b.to_string())
  println("triple.c=" + t.c.to_string())
end

# ———————————————————————————————————————————————————————————————
# §D.2 Vec operations — observable behaviour must match
# ———————————————————————————————————————————————————————————————

def report_vec() -> Unit
  mut v: Vec[Int] = Vec::new()
  println("vec.len_empty=" + v.len().to_string())
  v.push(10)
  v.push(20)
  v.push(30)
  println("vec.len_3=" + v.len().to_string())
  println("vec[0]=" + v[0].to_string())
  println("vec[1]=" + v[1].to_string())
  println("vec[2]=" + v[2].to_string())
end

# ———————————————————————————————————————————————————————————————
# §D.3 Enum discriminants — must agree
# ———————————————————————————————————————————————————————————————

enum IvsNColor
  Red
  Green
  Blue
end

enum IvsNShape
  Circle(Int)
  Rect(Int, Int)
  Empty
end

def report_enum() -> Unit
  let r = IvsNColor::Red
  let g = IvsNColor::Green
  let b = IvsNColor::Blue
  match r when IvsNColor::Red then println("color.red=Red")
          when _ then println("color.red=WRONG") end
  match g when IvsNColor::Green then println("color.green=Green")
          when _ then println("color.green=WRONG") end
  match b when IvsNColor::Blue then println("color.blue=Blue")
          when _ then println("color.blue=WRONG") end

  let c = IvsNShape::Circle(5)
  let rect = IvsNShape::Rect(3, 4)
  let e = IvsNShape::Empty
  match c
  when IvsNShape::Circle(r) then println("shape.circle.r=" + r.to_string())
  when _ then println("shape.circle=WRONG")
  end
  match rect
  when IvsNShape::Rect(w, h) then
    println("shape.rect.w=" + w.to_string())
    println("shape.rect.h=" + h.to_string())
  when _ then println("shape.rect=WRONG")
  end
  match e
  when IvsNShape::Empty then println("shape.empty=Empty")
  when _ then println("shape.empty=WRONG")
  end
end

# ———————————————————————————————————————————————————————————————
# §D.4 Option/Result — must agree on tag and payload
# ———————————————————————————————————————————————————————————————

def report_option() -> Unit
  let some_val: Option[Int] = Option::Some(42)
  let none_val: Option[Int] = Option::None
  match some_val
  when Option::Some(v) then println("opt.some=" + v.to_string())
  when Option::None then println("opt.some=WRONG")
  end
  match none_val
  when Option::None then println("opt.none=None")
  when Option::Some(_) then println("opt.none=WRONG")
  end
end

# ———————————————————————————————————————————————————————————————
# §D.5 String — construction and indexing
# ———————————————————————————————————————————————————————————————

def report_string() -> Unit
  let s = "hello, world"
  println("str.len=" + s.len().to_string())
  println("str.val=" + s)
  let s2 = s + "!"
  println("str2.len=" + s2.len().to_string())
  println("str2.val=" + s2)
end

# ———————————————————————————————————————————————————————————————
# Main: produce fingerprint of all layout-dependent operations
# ———————————————————————————————————————————————————————————————

def main() -> Int
  println("=== Interpreter vs Native Layout Comparison ===")
  report_pair()
  report_mixed()
  report_triple()
  report_vec()
  report_enum()
  report_option()
  report_string()
  println("=== END ===")
  0
end
