# tests/simd/simd_layout_test.tg — the SIMD vector-row layout assertions
# (the mandate's SIMD (e): the layout assertions).
#
# THE VECTOR ROW: the std Vec2/Vec4/Vec8/Vec16 family — the real vector
# type — lays out as N lanes of the lane type with ALIGNMENT = the vector
# WIDTH (16/32/64 bytes):
#   Vec4[f32]  -> 16 bytes, align 16   (f32x4)
#   Vec2[Float]-> 16 bytes, align 16   (f64x2)
#   Vec4[i32]  -> 16 bytes, align 16   (i32x4)
#   Vec8[f32]  -> 32 bytes, align 32   (f32x8, AVX width)
#   Vec16[i8]  -> 16 bytes, align 16   (i8x16)
# Ordinary fixed arrays keep the element-aligned inline layout ([f64; 2]
# stays 16/8 — the differential suite's C-convention shape), and a
# non-vector width (Vec2[f32] — 8 bytes) is NOT a vector row (16/8).
#
# Run with: tg run tests/simd/simd_layout_test.tg

use std::core::{Option, Result, Unit, Bool, panic}
use std::collections::{Vec}
use std::test::*
use tg_compiler::layout_engine::{
  LayoutEngine, FieldLayout, TargetDescriptor, MirTypeDef,
  aarch64_target, layout_engine_new, layout_engine_register_types,
  compute_all_layouts, size_of, align_of, stride_of,
  is_simd_vector_type,
}
use tg_compiler::types::{Type, TypeId}
use tg_compiler::mir::{MirTypeDefKind, MirFieldDef}
use tg_compiler::ast::{layout_attrs_plain}
use tg_compiler::token::{span_dummy}

def make_vec_def(tid: Int, name: String, lane: Type, lanes: Int) -> MirTypeDef
  var fields = Vec::new()
  var i = 0
  while i < lanes do
    fields.push(MirFieldDef { name: ("e" + i.to_string()).to_string(), ty: lane.clone() })
    i = i + 1
  end
  MirTypeDef {
    id: TypeId { id: tid },
    name: name.to_string(),
    kind: MirTypeDefKind::Struct(fields),
    generics: Vec::new(),
    layout: layout_attrs_plain(span_dummy())
  }
end

def check_layout(engine: LayoutEngine, ty: Type, expected_size: Int, expected_align: Int, what: String) -> Unit
  check_eq(size_of(&mut engine, &ty), expected_size, "size of " + what.clone())
  check_eq(align_of(&mut engine, &ty), expected_align, "align of " + what.clone())
  check_eq(stride_of(&mut engine, &ty), expected_size, "stride of " + what.clone())
end

def test_vector_rows() -> Unit
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  var defs = Vec::new()
  defs.push(make_vec_def(1, "Vec2", Type::Float, 2))
  defs.push(make_vec_def(2, "Vec4", Type::F32, 4))
  defs.push(make_vec_def(3, "Vec8", Type::F32, 8))
  defs.push(make_vec_def(4, "Vec16", Type::I8, 16))
  defs.push(make_vec_def(5, "Vec2", Type::I64, 2))
  defs.push(make_vec_def(6, "Vec4", Type::I32, 4))
  layout_engine_register_types(&mut engine, &defs)
  compute_all_layouts(&mut engine)

  # The VECTOR ROW: size = N lanes × lane size, align = the vector width.
  check_layout(&mut engine, Type::Adt(TypeId { id: 2 }, vec![Type::F32]), 16, 16, "Vec4[f32] (f32x4)")
  check_layout(&mut engine, Type::Adt(TypeId { id: 1 }, vec![Type::Float]), 16, 16, "Vec2[Float] (f64x2)")
  check_layout(&mut engine, Type::Adt(TypeId { id: 5 }, vec![Type::I64]), 16, 16, "Vec2[i64] (i64x2)")
  check_layout(&mut engine, Type::Adt(TypeId { id: 6 }, vec![Type::I32]), 16, 16, "Vec4[i32] (i32x4)")
  check_layout(&mut engine, Type::Adt(TypeId { id: 3 }, vec![Type::F32]), 32, 32, "Vec8[f32] (f32x8, AVX width)")
  check_layout(&mut engine, Type::Adt(TypeId { id: 4 }, vec![Type::I8]), 16, 16, "Vec16[i8] (i8x16)")

  # The gate: these ARE vector types.
  check(is_simd_vector_type(&mut engine, &Type::Adt(TypeId { id: 2 }, vec![Type::F32])), "Vec4[f32] is a vector type")
  check(is_simd_vector_type(&mut engine, &Type::Adt(TypeId { id: 3 }, vec![Type::F32])), "Vec8[f32] is a vector type")

  # The NON-vector shapes: an ordinary fixed array [f64; 2] keeps the
  # element-aligned inline layout (16/8 — the C array convention), and a
  # non-vector width (Vec2[f32] — 8 bytes) is NOT a vector row.
  check_layout(&mut engine, Type::FixedArray(Type::F64, 2), 16, 8, "[f64; 2] (ordinary fixed array)")
  check_layout(&mut engine, Type::FixedArray(Type::U8, 16), 16, 1, "[u8; 16] (ordinary fixed array)")
  check_layout(&mut engine, Type::Adt(TypeId { id: 1 }, vec![Type::F32]), 8, 4, "Vec2[f32] (8 bytes — not a vector width)")
  check(!is_simd_vector_type(&mut engine, &Type::Adt(TypeId { id: 1 }, vec![Type::F32])), "Vec2[f32] is not a vector type")
  check(!is_simd_vector_type(&mut engine, &Type::FixedArray(Type::F32, 4)), "a plain fixed array is not a vector type")
end

def main() -> Int
  var suite = test_suite_new()
  suite.add(test_case_new("vector_rows", "simd_layout", || -> Unit { test_vector_rows() }))
  let ok = run_tests(suite, test_runner_config_new())
  if ok then 0 else 1 end
end
