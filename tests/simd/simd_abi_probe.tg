# tests/simd/simd_abi_probe.tg — the SIMD ABI probe (the mandate's SIMD
# (e): the ABI probe).
#
# THE VECTOR CASES of the ABI classifier:
#   - the 16-byte vector (Vec4[f32], Vec2[Float], Vec4[i32]) classifies
#     ValueCategory::Vector(16) — THROUGH THE REGISTERS (never sret);
#   - the 32/64-byte vectors (Vec8[f32], Vec16[i8] 64-byte form...)
#     classify ByAddress(width) — MEMORY (sret);
#   - classify_argument maps the vector case to the explicit
#     AbiArg::Vector slot (the register-slot crossing);
#   - category_uses_sret(Vector) = false (the register class), while the
#     ByAddress 32/64-byte vectors use sret = true (memory).
#
# Run with: tg run tests/simd/simd_abi_probe.tg

use std::core::{Option, Result, Unit, Bool, panic}
use std::collections::{Vec}
use std::test::*
use tg_compiler::layout_engine::{
  LayoutEngine, TargetDescriptor, MirTypeDef,
  aarch64_target, layout_engine_new, layout_engine_register_types,
  compute_all_layouts, classify_value_category, ValueCategory,
}
use tg_compiler::types::{Type, TypeId}
use tg_compiler::mir::{MirTypeDefKind, MirFieldDef}
use tg_compiler::ast::{layout_attrs_plain}
use tg_compiler::token::{span_dummy}

def make_vec_def(tid: Int, name: String, lane: Type, lanes: Int) -> MirTypeDef
  var fields = Vec::new()
  var i = 0
  while i < lanes do
    fields.push(MirFieldDef { name: ("e" + i.to_string()).to_string(), ty: lane.clone() })
    i = i + 1
  end
  MirTypeDef {
    id: TypeId { id: tid },
    name: name.to_string(),
    kind: MirTypeDefKind::Struct(fields),
    generics: Vec::new(),
    layout: layout_attrs_plain(span_dummy())
  }
end

def cat_of(engine: LayoutEngine, ty: Type) -> ValueCategory
  match classify_value_category(&mut engine, ty)
  when Result::Ok(cat) then cat
  when Result::Err(e) then panic("ABI probe: classification failed closed: " + e.message)
  end
end

def check_vector_case(engine: LayoutEngine, ty: Type, what: String) -> Unit
  match cat_of(&mut engine, ty)
  when ValueCategory::Vector(w) then
    check_eq(w, 16, "the 16-byte vector width of " + what.clone())
  when _ then
    check(false, "the 16-byte vector " + what.clone() + " must classify as the vector case (registers), not another category")
  end
end

def check_by_address_case(engine: LayoutEngine, ty: Type, expected_width: Int, what: String) -> Unit
  match cat_of(&mut engine, ty)
  when ValueCategory::ByAddress(w) then
    check_eq(w, expected_width, "the by-address width of " + what.clone())
  when _ then
    check(false, "the " + expected_width.to_string() + "-byte vector " + what.clone() + " must classify ByAddress (memory)")
  end
end

def test_vector_abi() -> Unit
  let target = aarch64_target()
  mut engine = layout_engine_new(target)
  var defs = Vec::new()
  defs.push(make_vec_def(1, "Vec2", Type::Float, 2))
  defs.push(make_vec_def(2, "Vec4", Type::F32, 4))
  defs.push(make_vec_def(3, "Vec8", Type::F32, 8))
  defs.push(make_vec_def(4, "Vec16", Type::I8, 16))
  defs.push(make_vec_def(5, "Vec16", Type::F32, 16))
  layout_engine_register_types(&mut engine, &defs)
  compute_all_layouts(&mut engine)

  # The 16-byte vectors: the REGISTER case.
  check_vector_case(&mut engine, Type::Adt(TypeId { id: 2 }, vec![Type::F32]), "Vec4[f32]")
  check_vector_case(&mut engine, Type::Adt(TypeId { id: 1 }, vec![Type::Float]), "Vec2[Float]")
  check_vector_case(&mut engine, Type::Adt(TypeId { id: 4 }, vec![Type::I8]), "Vec16[i8]")

  # The 32/64-byte vectors: MEMORY (ByAddress).
  check_by_address_case(&mut engine, Type::Adt(TypeId { id: 3 }, vec![Type::F32]), 32, "Vec8[f32]")
  check_by_address_case(&mut engine, Type::Adt(TypeId { id: 5 }, vec![Type::F32]), 64, "Vec16[f32]")

  # The 16-byte vector never uses sret (the register class); the 32/64
  # byte forms cross by address (memory).
  let v16 = cat_of(&mut engine, Type::Adt(TypeId { id: 2 }, vec![Type::F32]))
  check_eq(tg_compiler::codegen::category_uses_sret(&v16), false, "16-byte vector: no sret (through the registers)")
  let v32 = cat_of(&mut engine, Type::Adt(TypeId { id: 3 }, vec![Type::F32]))
  check_eq(tg_compiler::codegen::category_uses_sret(&v32), true, "32-byte vector: sret (memory)")
end

def main() -> Int
  var suite = test_suite_new()
  suite.add(test_case_new("vector_abi", "simd_abi", || -> Unit { test_vector_abi() }))
  let ok = run_tests(suite, test_runner_config_new())
  if ok then 0 else 1 end
end
