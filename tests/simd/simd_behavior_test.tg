# tests/simd/simd_behavior_test.tg — the SIMD behavior suite (the
# mandate's SIMD (e): the vector add/shuffle/load-store vs the SCALAR
# REFERENCE).
#
# Every SIMD intrinsic below is lowered by the compiler to the aarch64
# NEON / x86 SSE/AVX machine instructions (the codegen's SIMD arms); the
# test compares each vector result against the scalar lane-wise
# reference — the portable implementation of the same operation.
#
# Run with: tg run tests/simd/simd_behavior_test.tg

use std::core::{Option, Result, Unit, Bool, f32}
use std::collections::{Vec}
use std::test::*
use std::simd::{
  Vec2, Vec4, Vec8, Vec16,
  __intrinsic_simd_add_f32x4, __intrinsic_simd_sub_f32x4, __intrinsic_simd_mul_f32x4,
  __intrinsic_simd_and_f32x4, __intrinsic_simd_or_f32x4, __intrinsic_simd_xor_f32x4,
  __intrinsic_simd_add_i32x4, __intrinsic_simd_sub_i32x4, __intrinsic_simd_mul_i32x4,
  __intrinsic_simd_and_i32x4, __intrinsic_simd_or_i32x4, __intrinsic_simd_xor_i32x4,
  __intrinsic_simd_add_f64x2, __intrinsic_simd_sub_f64x2, __intrinsic_simd_mul_f64x2,
  __intrinsic_simd_add_i64x2, __intrinsic_simd_sub_i64x2,
  __intrinsic_simd_load_f32x4, __intrinsic_simd_store_f32x4,
  __intrinsic_simd_load_i32x4, __intrinsic_simd_store_i32x4,
  __intrinsic_simd_shuffle_f32x4, __intrinsic_simd_shuffle_i32x4,
  __intrinsic_simd_shuffle_i16x8,
  __intrinsic_simd_add_f32x8, __intrinsic_simd_sub_f32x8, __intrinsic_simd_mul_f32x8,
  __intrinsic_simd_andnot_i32x4,
  __intrinsic_simd_eq_i32x4, __intrinsic_simd_lt_i32x4, __intrinsic_simd_gt_i32x4,
  __intrinsic_simd_le_i32x4, __intrinsic_simd_ge_i32x4, __intrinsic_simd_eq_i64x2,
  __intrinsic_simd_shl_imm_i32x4, __intrinsic_simd_shr_imm_i32x4, __intrinsic_simd_sar_imm_i32x4,
  __intrinsic_simd_shl_i32x4, __intrinsic_simd_shr_i32x4, __intrinsic_simd_sar_i32x4,
  __intrinsic_simd_splat_i32x4, __intrinsic_simd_splat_f32x4, __intrinsic_simd_splat_f64x2,
  __intrinsic_simd_extract_i32x4, __intrinsic_simd_insert_i32x4,
  __intrinsic_simd_pack_i32x4, __intrinsic_simd_unpacklo_i16x8, __intrinsic_simd_unpackhi_i16x8,
  shuffle_mask_f32x4, shuffle_mask_i32x4, shuffle_mask_i16x8,
  detect_simd,
}

# ———————————————————————————————————————————————————————————————
# the scalar references (the portable lane-wise implementations)
# ———————————————————————————————————————————————————————————————

def scalar_add_f32x4(a: Vec4[f32], b: Vec4[f32]) -> Vec4[f32]
  Vec4[f32] { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w }
end

def scalar_sub_f32x4(a: Vec4[f32], b: Vec4[f32]) -> Vec4[f32]
  Vec4[f32] { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w }
end

def scalar_mul_f32x4(a: Vec4[f32], b: Vec4[f32]) -> Vec4[f32]
  Vec4[f32] { x: a.x * b.x, y: a.y * b.y, z: a.z * b.z, w: a.w * b.w }
end

def scalar_add_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w }
end

def scalar_sub_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w }
end

def scalar_mul_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] { x: a.x * b.x, y: a.y * b.y, z: a.z * b.z, w: a.w * b.w }
end

def scalar_and_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] { x: a.x & b.x, y: a.y & b.y, z: a.z & b.z, w: a.w & b.w }
end

def scalar_or_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] { x: a.x | b.x, y: a.y | b.y, z: a.z | b.z, w: a.w | b.w }
end

def scalar_xor_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] { x: a.x ^ b.x, y: a.y ^ b.y, z: a.z ^ b.z, w: a.w ^ b.w }
end

def scalar_add_f64x2(a: Vec2[Float], b: Vec2[Float]) -> Vec2[Float]
  Vec2[Float] { x: a.x + b.x, y: a.y + b.y }
end

def scalar_sub_f64x2(a: Vec2[Float], b: Vec2[Float]) -> Vec2[Float]
  Vec2[Float] { x: a.x - b.x, y: a.y - b.y }
end

def scalar_mul_f64x2(a: Vec2[Float], b: Vec2[Float]) -> Vec2[Float]
  Vec2[Float] { x: a.x * b.x, y: a.y * b.y }
end

def scalar_add_i64x2(a: Vec2[i64], b: Vec2[i64]) -> Vec2[i64]
  Vec2[i64] { x: a.x + b.x, y: a.y + b.y }
end

def scalar_sub_i64x2(a: Vec2[i64], b: Vec2[i64]) -> Vec2[i64]
  Vec2[i64] { x: a.x - b.x, y: a.y - b.y }
end

def scalar_add_f32x8(a: Vec8[f32], b: Vec8[f32]) -> Vec8[f32]
  Vec8[f32] {
    e0: a.e0 + b.e0, e1: a.e1 + b.e1, e2: a.e2 + b.e2, e3: a.e3 + b.e3,
    e4: a.e4 + b.e4, e5: a.e5 + b.e5, e6: a.e6 + b.e6, e7: a.e7 + b.e7
  }
end

def scalar_sub_f32x8(a: Vec8[f32], b: Vec8[f32]) -> Vec8[f32]
  Vec8[f32] {
    e0: a.e0 - b.e0, e1: a.e1 - b.e1, e2: a.e2 - b.e2, e3: a.e3 - b.e3,
    e4: a.e4 - b.e4, e5: a.e5 - b.e5, e6: a.e6 - b.e6, e7: a.e7 - b.e7
  }
end

def scalar_mul_f32x8(a: Vec8[f32], b: Vec8[f32]) -> Vec8[f32]
  Vec8[f32] {
    e0: a.e0 * b.e0, e1: a.e1 * b.e1, e2: a.e2 * b.e2, e3: a.e3 * b.e3,
    e4: a.e4 * b.e4, e5: a.e5 * b.e5, e6: a.e6 * b.e6, e7: a.e7 * b.e7
  }
end

def vec4_f32_eq(a: Vec4[f32], b: Vec4[f32]) -> Bool
  a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w
end

def vec4_i32_eq(a: Vec4[i32], b: Vec4[i32]) -> Bool
  a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w
end

def vec2_f64_eq(a: Vec2[Float], b: Vec2[Float]) -> Bool
  a.x == b.x && a.y == b.y
end

def vec2_i64_eq(a: Vec2[i64], b: Vec2[i64]) -> Bool
  a.x == b.x && a.y == b.y
end

def vec8_f32_eq(a: Vec8[f32], b: Vec8[f32]) -> Bool
  a.e0 == b.e0 && a.e1 == b.e1 && a.e2 == b.e2 && a.e3 == b.e3 &&
  a.e4 == b.e4 && a.e5 == b.e5 && a.e6 == b.e6 && a.e7 == b.e7
end

# ———————————————————————————————————————————————————————————————
# the tests
# ———————————————————————————————————————————————————————————————

def test_f32x4_arith() -> Unit
  let a = Vec4[f32] { x: 1.5f32, y: -2.25f32, z: 3.0f32, w: 0.5f32 }
  let b = Vec4[f32] { x: 2.0f32, y: 4.5f32, z: -1.0f32, w: 1.25f32 }
  check(vec4_f32_eq(&__intrinsic_simd_add_f32x4(a, b), &scalar_add_f32x4(a, b)), "f32x4 add matches the scalar reference")
  check(vec4_f32_eq(&__intrinsic_simd_sub_f32x4(a, b), &scalar_sub_f32x4(a, b)), "f32x4 sub matches the scalar reference")
  check(vec4_f32_eq(&__intrinsic_simd_mul_f32x4(a, b), &scalar_mul_f32x4(a, b)), "f32x4 mul matches the scalar reference")
  # the bitwise arms on float lanes (the bit patterns; identical
  # operands make the identity laws exact)
  let na = Vec4[f32] { x: 1.5f32, y: 2.5f32, z: 3.5f32, w: 4.5f32 }
  let nb = Vec4[f32] { x: 0.5f32, y: 0.25f32, z: 0.125f32, w: 0.0625f32 }
  check(vec4_f32_eq(&__intrinsic_simd_and_f32x4(na, na), &na), "f32x4 and with itself is the identity")
  check(vec4_f32_eq(&__intrinsic_simd_or_f32x4(na, na), &na), "f32x4 or with itself is the identity")
  check(vec4_f32_eq(&__intrinsic_simd_xor_f32x4(na, na), &Vec4[f32] { x: 0.0f32, y: 0.0f32, z: 0.0f32, w: 0.0f32 }), "f32x4 xor with itself is zero")
  check(vec4_f32_eq(&__intrinsic_simd_xor_f32x4(na, nb), &__intrinsic_simd_xor_f32x4(nb, na)), "f32x4 xor is commutative")
end

def test_i32x4_arith() -> Unit
  let a = Vec4[i32] { x: 7, y: -3, z: 1024, w: -2048 }
  let b = Vec4[i32] { x: 3, y: 11, z: -512, w: 4 }
  check(vec4_i32_eq(&__intrinsic_simd_add_i32x4(a, b), &scalar_add_i32x4(a, b)), "i32x4 add matches the scalar reference")
  check(vec4_i32_eq(&__intrinsic_simd_sub_i32x4(a, b), &scalar_sub_i32x4(a, b)), "i32x4 sub matches the scalar reference")
  check(vec4_i32_eq(&__intrinsic_simd_mul_i32x4(a, b), &scalar_mul_i32x4(a, b)), "i32x4 mul matches the scalar reference")
  check(vec4_i32_eq(&__intrinsic_simd_and_i32x4(a, b), &scalar_and_i32x4(a, b)), "i32x4 and matches the scalar reference")
  check(vec4_i32_eq(&__intrinsic_simd_or_i32x4(a, b), &scalar_or_i32x4(a, b)), "i32x4 or matches the scalar reference")
  check(vec4_i32_eq(&__intrinsic_simd_xor_i32x4(a, b), &scalar_xor_i32x4(a, b)), "i32x4 xor matches the scalar reference")
end

def test_f64x2_arith() -> Unit
  let a = Vec2[Float] { x: 1.25, y: -4.5 }
  let b = Vec2[Float] { x: 3.75, y: 2.0 }
  check(vec2_f64_eq(&__intrinsic_simd_add_f64x2(a, b), &scalar_add_f64x2(a, b)), "f64x2 add matches the scalar reference")
  check(vec2_f64_eq(&__intrinsic_simd_sub_f64x2(a, b), &scalar_sub_f64x2(a, b)), "f64x2 sub matches the scalar reference")
  check(vec2_f64_eq(&__intrinsic_simd_mul_f64x2(a, b), &scalar_mul_f64x2(a, b)), "f64x2 mul matches the scalar reference")
end

def test_i64x2_arith() -> Unit
  let a = Vec2[i64] { x: 1000000007, y: -9000000007 }
  let b = Vec2[i64] { x: 7, y: 1000000007 }
  check(vec2_i64_eq(&__intrinsic_simd_add_i64x2(a, b), &scalar_add_i64x2(a, b)), "i64x2 add matches the scalar reference")
  check(vec2_i64_eq(&__intrinsic_simd_sub_i64x2(a, b), &scalar_sub_i64x2(a, b)), "i64x2 sub matches the scalar reference")
end

def test_f32x8_arith() -> Unit
  let a = Vec8[f32] { e0: 1.0f32, e1: 2.0f32, e2: 3.0f32, e3: 4.0f32, e4: 5.0f32, e5: 6.0f32, e6: 7.0f32, e7: 8.0f32 }
  let b = Vec8[f32] { e0: 8.0f32, e1: 7.0f32, e2: 6.0f32, e3: 5.0f32, e4: 4.0f32, e5: 3.0f32, e6: 2.0f32, e7: 1.0f32 }
  check(vec8_f32_eq(&__intrinsic_simd_add_f32x8(a, b), &scalar_add_f32x8(a, b)), "f32x8 add matches the scalar reference")
  check(vec8_f32_eq(&__intrinsic_simd_sub_f32x8(a, b), &scalar_sub_f32x8(a, b)), "f32x8 sub matches the scalar reference")
  check(vec8_f32_eq(&__intrinsic_simd_mul_f32x8(a, b), &scalar_mul_f32x8(a, b)), "f32x8 mul matches the scalar reference")
end

def test_load_store() -> Unit
  # the load/store round-trip through a raw buffer
  var buf: [f32; 4] = [1.0f32, 2.0f32, 3.0f32, 4.0f32]
  let v = __intrinsic_simd_load_f32x4(&buf[0] as Ptr[f32])
  check(vec4_f32_eq(&v, &Vec4[f32] { x: 1.0f32, y: 2.0f32, z: 3.0f32, w: 4.0f32 }), "f32x4 load reads the four lanes")
  let w = Vec4[f32] { x: 9.0f32, y: 8.0f32, z: 7.0f32, w: 6.0f32 }
  __intrinsic_simd_store_f32x4(w, &mut buf[0] as PtrMut[f32])
  check(buf[0] == 9.0f32 && buf[1] == 8.0f32 && buf[2] == 7.0f32 && buf[3] == 6.0f32, "f32x4 store writes the four lanes")
  # the i32 lane form
  var ibuf: [i32; 4] = [1, 2, 3, 4]
  let iv = __intrinsic_simd_load_i32x4(&ibuf[0] as Ptr[i32])
  check(vec4_i32_eq(&iv, &Vec4[i32] { x: 1, y: 2, z: 3, w: 4 }), "i32x4 load reads the four lanes")
  __intrinsic_simd_store_i32x4(Vec4[i32] { x: -1, y: -2, z: -3, w: -4 }, &mut ibuf[0] as PtrMut[i32])
  check(ibuf[0] == -1 && ibuf[1] == -2 && ibuf[2] == -3 && ibuf[3] == -4, "i32x4 store writes the four lanes")
end

def test_shuffle() -> Unit
  # the lane-reversal shuffle: [3, 2, 1, 0]
  let a = Vec4[f32] { x: 1.0f32, y: 2.0f32, z: 3.0f32, w: 4.0f32 }
  let mask = shuffle_mask_f32x4([3, 2, 1, 0])
  let s = __intrinsic_simd_shuffle_f32x4(a, mask)
  check(vec4_f32_eq(&s, &Vec4[f32] { x: 4.0f32, y: 3.0f32, z: 2.0f32, w: 1.0f32 }), "f32x4 shuffle reverses the lanes")
  # the identity shuffle
  let id_mask = shuffle_mask_f32x4([0, 1, 2, 3])
  let id = __intrinsic_simd_shuffle_f32x4(a, id_mask)
  check(vec4_f32_eq(&id, &a), "f32x4 identity shuffle is the identity")
  # the i32 lane shuffle
  let ia = Vec4[i32] { x: 10, y: 20, z: 30, w: 40 }
  let imask = shuffle_mask_i32x4([1, 0, 3, 2])
  let ish = __intrinsic_simd_shuffle_i32x4(ia, imask)
  check(vec4_i32_eq(&ish, &Vec4[i32] { x: 20, y: 10, z: 40, w: 30 }), "i32x4 shuffle swaps the lane pairs")
  # the i16 lane shuffle (the 8-lane form)
  let h = Vec8[i16] { e0: 1, e1: 2, e2: 3, e3: 4, e4: 5, e5: 6, e6: 7, e7: 8 }
  let hmask = shuffle_mask_i16x8([7, 6, 5, 4, 3, 2, 1, 0])
  let hsh = __intrinsic_simd_shuffle_i16x8(h, hmask)
  check(hsh.e0 == 8 && hsh.e1 == 7 && hsh.e2 == 6 && hsh.e3 == 5 &&
        hsh.e4 == 4 && hsh.e5 == 3 && hsh.e6 == 2 && hsh.e7 == 1, "i16x8 shuffle reverses the 8 lanes")
end

def test_feature_detection() -> Unit
  let caps = detect_simd()
  # THE CONTRACT: NEON is mandatory on aarch64; SSE2 is the x86-64
  # baseline. Exactly one of the two baselines is present on a supported
  # target — the portable fallback target (none) is the third state.
  check(caps.has_neon || caps.has_sse2, "the SIMD feature contract: NEON (aarch64) or SSE2 (x86-64) is the baseline")
end

# ———————————————————————————————————————————————————————————————
# the explicit-op extension rows (andnot / compares / shifts / splat /
# lane moves / pack-unpack vs the scalar references)
# ———————————————————————————————————————————————————————————————

def scalar_andnot_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] { x: a.x & ~b.x, y: a.y & ~b.y, z: a.z & ~b.z, w: a.w & ~b.w }
end

def mask_eq_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] {
    x: if a.x == b.x then -1 else 0 end,
    y: if a.y == b.y then -1 else 0 end,
    z: if a.z == b.z then -1 else 0 end,
    w: if a.w == b.w then -1 else 0 end
  }
end

def mask_lt_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] {
    x: if a.x < b.x then -1 else 0 end,
    y: if a.y < b.y then -1 else 0 end,
    z: if a.z < b.z then -1 else 0 end,
    w: if a.w < b.w then -1 else 0 end
  }
end

def mask_gt_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] {
    x: if a.x > b.x then -1 else 0 end,
    y: if a.y > b.y then -1 else 0 end,
    z: if a.z > b.z then -1 else 0 end,
    w: if a.w > b.w then -1 else 0 end
  }
end

def mask_le_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] {
    x: if a.x <= b.x then -1 else 0 end,
    y: if a.y <= b.y then -1 else 0 end,
    z: if a.z <= b.z then -1 else 0 end,
    w: if a.w <= b.w then -1 else 0 end
  }
end

def mask_ge_i32x4(a: Vec4[i32], b: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] {
    x: if a.x >= b.x then -1 else 0 end,
    y: if a.y >= b.y then -1 else 0 end,
    z: if a.z >= b.z then -1 else 0 end,
    w: if a.w >= b.w then -1 else 0 end
  }
end

def scalar_shl_imm_i32x4(v: Vec4[i32], amount: i32) -> Vec4[i32]
  Vec4[i32] { x: v.x << amount, y: v.y << amount, z: v.z << amount, w: v.w << amount }
end

def scalar_shr_imm_i32x4(v: Vec4[i32], amount: i32) -> Vec4[i32]
  Vec4[i32] { x: v.x >> amount, y: v.y >> amount, z: v.z >> amount, w: v.w >> amount }
end

def scalar_shl_vec_i32x4(v: Vec4[i32], c: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] { x: v.x << c.x, y: v.y << c.y, z: v.z << c.z, w: v.w << c.w }
end

def scalar_shr_vec_i32x4(v: Vec4[i32], c: Vec4[i32]) -> Vec4[i32]
  Vec4[i32] { x: v.x >> c.x, y: v.y >> c.y, z: v.z >> c.z, w: v.w >> c.w }
end

def sat_i16(x: i32) -> i16
  if x > 32767 then
    32767
  elsif x < -32768 then
    -32768
  else
    x as i16
  end
end

def test_explicit_ops() -> Unit
  # andnot: a & !b.
  let a = Vec4[i32] { x: 0x0F0F, y: -1, z: 123456, w: -456 }
  let b = Vec4[i32] { x: 0x00FF, y: 0, z: 0xFF00, w: -1 }
  check(vec4_i32_eq(&__intrinsic_simd_andnot_i32x4(a, b), &scalar_andnot_i32x4(a, b)), "i32x4 andnot matches a & !b")
  # the lane-mask compares: all-ones where the predicate holds.
  let c = Vec4[i32] { x: 5, y: -5, z: 0, w: 2147483647 }
  check(vec4_i32_eq(&__intrinsic_simd_eq_i32x4(a, a), &mask_eq_i32x4(a, a)), "i32x4 eq produces the equal-lane mask")
  check(vec4_i32_eq(&__intrinsic_simd_lt_i32x4(a, c), &mask_lt_i32x4(a, c)), "i32x4 lt produces the less-than mask")
  check(vec4_i32_eq(&__intrinsic_simd_gt_i32x4(a, c), &mask_gt_i32x4(a, c)), "i32x4 gt produces the greater-than mask")
  check(vec4_i32_eq(&__intrinsic_simd_le_i32x4(a, c), &mask_le_i32x4(a, c)), "i32x4 le produces the less-or-equal mask")
  check(vec4_i32_eq(&__intrinsic_simd_ge_i32x4(a, c), &mask_ge_i32x4(a, c)), "i32x4 ge produces the greater-or-equal mask")
  # the 64-bit integer compare is equality only.
  let la = Vec2[i64] { x: 1000000007, y: -7 }
  let lb = Vec2[i64] { x: 1000000007, y: 7 }
  check(vec2_i64_eq(&__intrinsic_simd_eq_i64x2(la, lb), &Vec2[i64] { x: -1, y: 0 }), "i64x2 eq produces the equal-lane mask")
  # the per-lane shifts (immediate and vector counts).
  let s = Vec4[i32] { x: 1, y: 2, z: 4, w: 8 }
  check(vec4_i32_eq(&__intrinsic_simd_shl_imm_i32x4(s, 2), &scalar_shl_imm_i32x4(s, 2)), "i32x4 shl_imm matches the scalar shift")
  check(vec4_i32_eq(&__intrinsic_simd_shr_imm_i32x4(Vec4[i32] { x: 16, y: 8, z: 4, w: 2 }, 2), &scalar_shr_imm_i32x4(Vec4[i32] { x: 16, y: 8, z: 4, w: 2 }, 2)), "i32x4 shr_imm matches the scalar shift")
  check(vec4_i32_eq(&__intrinsic_simd_sar_imm_i32x4(Vec4[i32] { x: -16, y: -8, z: 4, w: -2 }, 2), &scalar_shr_imm_i32x4(Vec4[i32] { x: -16, y: -8, z: 4, w: -2 }, 2)), "i32x4 sar_imm matches the scalar arithmetic shift")
  let counts = Vec4[i32] { x: 1, y: 2, z: 3, w: 0 }
  check(vec4_i32_eq(&__intrinsic_simd_shl_i32x4(s, counts), &scalar_shl_vec_i32x4(s, counts)), "i32x4 shl by vector counts matches the scalar shift")
  let rcounts = Vec4[i32] { x: 0, y: 1, z: 2, w: 3 }
  let r = Vec4[i32] { x: 8, y: 16, z: 32, w: 64 }
  check(vec4_i32_eq(&__intrinsic_simd_shr_i32x4(r, rcounts), &scalar_shr_vec_i32x4(r, rcounts)), "i32x4 shr by vector counts matches the scalar shift")
  check(vec4_i32_eq(&__intrinsic_simd_sar_i32x4(Vec4[i32] { x: -8, y: -16, z: 32, w: -64 }, rcounts), &scalar_shr_vec_i32x4(Vec4[i32] { x: -8, y: -16, z: 32, w: -64 }, rcounts)), "i32x4 sar by vector counts matches the scalar arithmetic shift")
  # Out-of-range counts follow the UNSIGNED-count rule: a count >= the
  # 32-bit lane width — including a count whose sign bit is set — shifts
  # every bit out (zero for shl/shr, sign fill for sar), never the
  # opposite direction.
  let at_width = Vec4[i32] { x: 32, y: 32, z: 32, w: 32 }
  let over_width = Vec4[i32] { x: 33, y: 100, z: 1000, w: 2147483647 }
  let sign_bit = Vec4[i32] { x: -1, y: -2, z: -2147483647, w: -2147483647 }
  let zeros = Vec4[i32] { x: 0, y: 0, z: 0, w: 0 }
  let ones = Vec4[i32] { x: -1, y: -1, z: -1, w: -1 }
  check(vec4_i32_eq(&__intrinsic_simd_shl_i32x4(s, at_width), &zeros), "i32x4 shl at the width boundary shifts every bit out")
  check(vec4_i32_eq(&__intrinsic_simd_shl_i32x4(s, over_width), &zeros), "i32x4 shl above the width shifts every bit out")
  check(vec4_i32_eq(&__intrinsic_simd_shl_i32x4(s, sign_bit), &zeros), "i32x4 shl by sign-bit-set counts shifts every bit out (no reverse direction)")
  check(vec4_i32_eq(&__intrinsic_simd_shr_i32x4(ones, at_width), &zeros), "i32x4 shr at the width boundary shifts every bit out")
  check(vec4_i32_eq(&__intrinsic_simd_shr_i32x4(ones, over_width), &zeros), "i32x4 shr above the width shifts every bit out")
  check(vec4_i32_eq(&__intrinsic_simd_shr_i32x4(ones, sign_bit), &zeros), "i32x4 shr by sign-bit-set counts shifts every bit out (no reverse direction)")
  check(vec4_i32_eq(&__intrinsic_simd_sar_i32x4(ones, at_width), &ones), "i32x4 sar at the width boundary sign-fills")
  check(vec4_i32_eq(&__intrinsic_simd_sar_i32x4(ones, over_width), &ones), "i32x4 sar above the width sign-fills")
  check(vec4_i32_eq(&__intrinsic_simd_sar_i32x4(ones, sign_bit), &ones), "i32x4 sar by sign-bit-set counts sign-fills (no reverse direction)")
  # splat (integer and float lanes).
  check(vec4_i32_eq(&__intrinsic_simd_splat_i32x4(7), &Vec4[i32] { x: 7, y: 7, z: 7, w: 7 }), "i32x4 splat broadcasts the scalar")
  check(vec4_f32_eq(&__intrinsic_simd_splat_f32x4(2.5f32), &Vec4[f32] { x: 2.5f32, y: 2.5f32, z: 2.5f32, w: 2.5f32 }), "f32x4 splat broadcasts the scalar")
  check(vec2_f64_eq(&__intrinsic_simd_splat_f64x2(1.5), &Vec2[Float] { x: 1.5, y: 1.5 }), "f64x2 splat broadcasts the scalar")
  # lane extract/insert.
  let e = Vec4[i32] { x: 10, y: 20, z: 30, w: 40 }
  check(__intrinsic_simd_extract_i32x4(e, 2) == 30, "i32x4 extract reads lane 2")
  check(vec4_i32_eq(&__intrinsic_simd_insert_i32x4(e, 99, 2), &Vec4[i32] { x: 10, y: 20, z: 99, w: 40 }), "i32x4 insert writes lane 2 and preserves the others")
  # packed conversions (saturating narrow + signed widening).
  let p = __intrinsic_simd_pack_i32x4(
    Vec4[i32] { x: 1, y: 70000, z: -3, w: -70000 },
    Vec4[i32] { x: 4, y: 5, z: 6, w: 7 })
  check(p.e0 == 1 && p.e1 == 32767 && p.e2 == -3 && p.e3 == -32768 && p.e4 == 4 && p.e5 == 5 && p.e6 == 6 && p.e7 == 7, "i32x4 pack saturates and fills low/high halves")
  let wide = Vec8[i16] { e0: 1, e1: -2, e2: 3, e3: -4, e4: 5, e5: -6, e6: 7, e7: -8 }
  check(vec4_i32_eq(&__intrinsic_simd_unpacklo_i16x8(wide), &Vec4[i32] { x: 1, y: -2, z: 3, w: -4 }), "i16x8 unpacklo widens the low half")
  check(vec4_i32_eq(&__intrinsic_simd_unpackhi_i16x8(wide), &Vec4[i32] { x: 5, y: -6, z: 7, w: -8 }), "i16x8 unpackhi widens the high half")
end

def main() -> Int
  var suite = test_suite_new()
  suite.add(test_case_new("f32x4_arith", "simd_behavior", || -> Unit { test_f32x4_arith() }))
  suite.add(test_case_new("i32x4_arith", "simd_behavior", || -> Unit { test_i32x4_arith() }))
  suite.add(test_case_new("f64x2_arith", "simd_behavior", || -> Unit { test_f64x2_arith() }))
  suite.add(test_case_new("i64x2_arith", "simd_behavior", || -> Unit { test_i64x2_arith() }))
  suite.add(test_case_new("f32x8_arith", "simd_behavior", || -> Unit { test_f32x8_arith() }))
  suite.add(test_case_new("load_store", "simd_behavior", || -> Unit { test_load_store() }))
  suite.add(test_case_new("shuffle", "simd_behavior", || -> Unit { test_shuffle() }))
  suite.add(test_case_new("explicit_ops", "simd_behavior", || -> Unit { test_explicit_ops() }))
  suite.add(test_case_new("feature_detection", "simd_behavior", || -> Unit { test_feature_detection() }))
  let ok = run_tests(suite, test_runner_config_new())
  if ok then 0 else 1 end
end
