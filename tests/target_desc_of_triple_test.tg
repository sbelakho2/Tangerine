# tests/target_desc_of_triple_test.tg — audit item 39: the ONE
# triple -> TargetDesc lookup's row answers.
#
# The compiler's target-identity universe is target_desc.tg's
# target_desc_of_triple table, keyed by the --target triples: every
# canonical descriptor instance is mapped by its canonical triple, and
# the legacy route names (the old TANGERINE_LIR_TARGET values) are
# alias keys of the SAME table. This suite pins the row answers per
# key — pointer width / stack alignment / FPU / float ABI / the atomic
# width classes / the family predicates — so the table and the
# instance data cannot silently drift, and pins the fail-closed None
# answers for the triples with no descriptor (thumbv6m / thumbv8m.main
# / riscv32imc — no fabricated target).
#
# Run with: tg test tests/target_desc_of_triple_test.tg

use std::test::*
use tg_compiler::target_desc::{
  target_desc_of_triple, target_desc_is_thumb_family, target_desc_is_riscv_family,
  Fpu, FloatAbi
}

# ———————————————————————————————————————————————————————————————
# ARMv7-M rows (thumbv7m/thumbv7em triples + the legacy aliases)
# ———————————————————————————————————————————————————————————————

@test
def test_thumbv7m_m3_triple_row() -> Unit
  let d = assert_some(target_desc_of_triple("thumbv7m-none-eabi"))
  assert_true(d.name == "cortex-m3")
  assert_eq(d.pointer_width, 4)
  assert_eq(d.stack_alignment, 8)
  assert_true(d.fpu == Fpu::None)
  assert_true(d.float_abi == FloatAbi::Soft)
  # The ARMv7-M LDREX/STREX class: 1/2/4 native, nothing emulated,
  # mmio == native.
  assert_eq(d.native_atomic_widths.len(), 3)
  assert_true(d.native_atomic_widths.contains(1))
  assert_true(d.native_atomic_widths.contains(2))
  assert_true(d.native_atomic_widths.contains(4))
  assert_eq(d.emulated_atomic_widths.len(), 0)
  assert_eq(d.mmio_atomic_widths.len(), 3)
  # The modeled NVIC handler ABI is data on every ARMv7-M instance.
  assert_true(d.interrupt_abi.is_some())
end

@test
def test_thumbv7em_m4_triple_row_has_no_fpu() -> Unit
  # thumbv7em-none-eabi is the bare M4: the FPU is OPTIONAL on the
  # core, and this key models the no-FPU part (a float program must
  # name thumbv7em-none-eabihf).
  let d = assert_some(target_desc_of_triple("thumbv7em-none-eabi"))
  assert_true(d.name == "cortex-m4")
  assert_true(d.fpu == Fpu::None)
  assert_true(d.float_abi == FloatAbi::Soft)
  assert_eq(d.fpu_register_width, 0)
  assert_true(d.native_atomic_widths.contains(4))
end

@test
def test_thumbv7em_m4f_triple_row() -> Unit
  let d = assert_some(target_desc_of_triple("thumbv7em-none-eabihf"))
  assert_true(d.name == "cortex-m4f")
  assert_true(d.fpu == Fpu::FPv4SP)
  assert_true(d.float_abi == FloatAbi::Hard)
  assert_eq(d.fpu_register_width, 64)
  assert_true(d.native_atomic_widths.contains(4))
end

@test
def test_legacy_cortex_keys_resolve_through_the_table() -> Unit
  # "cortex-m" is the legacy alias of cortex-m4f (the least-breaking
  # mapping — the pre-slice cortex_m instance implied the VFP unit);
  # the per-CPU names are keys of the same table.
  assert_true(assert_some(target_desc_of_triple("cortex-m")).name == "cortex-m4f")
  assert_true(assert_some(target_desc_of_triple("cortex-m3")).name == "cortex-m3")
  assert_true(assert_some(target_desc_of_triple("cortex-m4")).name == "cortex-m4")
  assert_true(assert_some(target_desc_of_triple("cortex-m4f")).name == "cortex-m4f")
  # cortex-m7 has no canonical rustc-style triple; its desc-name key is
  # the table's entry and carries the FPv5-D16 class (the double-
  # precision VFP data processing the m4f instance lacks).
  let m7 = assert_some(target_desc_of_triple("cortex-m7"))
  assert_true(m7.name == "cortex-m7")
  assert_true(m7.fpu == Fpu::FPv5D16)
  assert_true(m7.float_abi == FloatAbi::Hard)
  assert_true(m7.isa_features.contains("vfp-dp"))
end

# ———————————————————————————————————————————————————————————————
# RISC-V rows (the canonical triples + the legacy aliases)
# ———————————————————————————————————————————————————————————————

@test
def test_riscv32imac_triple_row() -> Unit
  let d = assert_some(target_desc_of_triple("riscv32imac-unknown-none-elf"))
  assert_true(d.name == "riscv32imac")
  assert_eq(d.pointer_width, 4)
  assert_eq(d.stack_alignment, 16)
  assert_true(d.fpu == Fpu::None)
  # The A extension at RV32: [4] native, [1, 2] emulated (the masked
  # word-width RMW class), mmio == native.
  assert_eq(d.native_atomic_widths.len(), 1)
  assert_true(d.native_atomic_widths.contains(4))
  assert_eq(d.emulated_atomic_widths.len(), 2)
  assert_true(d.emulated_atomic_widths.contains(1))
  assert_true(d.emulated_atomic_widths.contains(2))
  assert_eq(d.mmio_atomic_widths.len(), 1)
  assert_true(d.mmio_atomic_widths.contains(4))
end

@test
def test_riscv_float_instance_rows() -> Unit
  let afc = assert_some(target_desc_of_triple("riscv32imafc-unknown-none-elf"))
  assert_true(afc.name == "riscv32imafc")
  assert_true(afc.fpu == Fpu::RVF)
  assert_eq(afc.fpu_register_width, 32)
  assert_true(afc.float_abi == FloatAbi::Hard)
  let afdc = assert_some(target_desc_of_triple("riscv32imafdc-unknown-none-elf"))
  assert_true(afdc.name == "riscv32imafdc")
  assert_true(afdc.fpu == Fpu::RVD)
  assert_eq(afdc.fpu_register_width, 64)
end

@test
def test_riscv64_rows() -> Unit
  let imac = assert_some(target_desc_of_triple("riscv64imac-unknown-none-elf"))
  assert_true(imac.name == "riscv64imac")
  assert_eq(imac.pointer_width, 8)
  assert_eq(imac.stack_alignment, 16)
  assert_true(imac.fpu == Fpu::None)
  # The RV64 A extension: the word AND the doubleword are native; the
  # sub-word widths stay emulated-class.
  assert_true(imac.native_atomic_widths.contains(4))
  assert_true(imac.native_atomic_widths.contains(8))
  assert_true(imac.emulated_atomic_widths.contains(1))
  assert_true(imac.mmio_atomic_widths.contains(8))
  let gc = assert_some(target_desc_of_triple("riscv64gc-unknown-none-elf"))
  assert_true(gc.name == "riscv64gc")
  assert_true(gc.fpu == Fpu::RVD)
  assert_eq(gc.pointer_width, 8)
  # The legacy aliases map to the imac instances of their xlen.
  assert_true(assert_some(target_desc_of_triple("riscv32")).name == "riscv32imac")
  assert_true(assert_some(target_desc_of_triple("riscv64")).name == "riscv64imac")
end

# ———————————————————————————————————————————————————————————————
# The host instances (the table is the whole desc universe, not only
# the embedded families)
# ———————————————————————————————————————————————————————————————

@test
def test_aarch64_and_x86_64_rows() -> Unit
  let a = assert_some(target_desc_of_triple("aarch64-unknown-none"))
  assert_true(a.name == "aarch64")
  assert_eq(a.pointer_width, 8)
  assert_true(a.fpu == Fpu::AdvSimdA64)
  assert_eq(a.native_atomic_widths.len(), 4)
  assert_true(a.native_atomic_widths.contains(8))
  # The host triples resolve to the same instances.
  assert_true(assert_some(target_desc_of_triple("aarch64-apple-darwin")).name == "aarch64")
  assert_true(assert_some(target_desc_of_triple("aarch64-unknown-linux-gnu")).name == "aarch64")
  assert_true(assert_some(target_desc_of_triple("aarch64")).name == "aarch64")
  let x = assert_some(target_desc_of_triple("x86_64-unknown-linux-gnu"))
  assert_true(x.name == "x86_64")
  assert_true(x.fpu == Fpu::Sse2)
  assert_true(assert_some(target_desc_of_triple("x86_64-apple-darwin")).name == "x86_64")
end

# ———————————————————————————————————————————————————————————————
# The fail-closed rows: no desc instance -> None (never a fabricated
# target), and the family predicates read the desc's own data.
# ———————————————————————————————————————————————————————————————

@test
def test_desc_less_triples_fail_closed() -> Unit
  # The ARMv6-M and IMC profiles are not modeled by target_desc.tg.
  assert_none(target_desc_of_triple("thumbv6m-none-eabi"))
  assert_none(target_desc_of_triple("thumbv8m.main-none-eabihf"))
  assert_none(target_desc_of_triple("riscv32imc-unknown-none-elf"))
  assert_none(target_desc_of_triple("not-a-target-triple"))
end

@test
def test_family_predicates() -> Unit
  let m3 = assert_some(target_desc_of_triple("thumbv7m-none-eabi"))
  let m4f = assert_some(target_desc_of_triple("thumbv7em-none-eabihf"))
  let rv32 = assert_some(target_desc_of_triple("riscv32imac-unknown-none-elf"))
  let rv64 = assert_some(target_desc_of_triple("riscv64gc-unknown-none-elf"))
  let a64 = assert_some(target_desc_of_triple("aarch64-unknown-none"))
  let x64 = assert_some(target_desc_of_triple("x86_64-unknown-linux-gnu"))
  assert_true(target_desc_is_thumb_family(m3))
  assert_true(target_desc_is_thumb_family(m4f))
  assert_true(target_desc_is_riscv_family(rv32))
  assert_true(target_desc_is_riscv_family(rv64))
  assert_true(!target_desc_is_thumb_family(a64))
  assert_true(!target_desc_is_riscv_family(a64))
  assert_true(!target_desc_is_thumb_family(x64))
  assert_true(!target_desc_is_riscv_family(x64))
end
