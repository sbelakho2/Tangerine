# tests/unicode_gate_d_test.tg — Gate D: the normative Unicode source model
# (the lexer's UTF-8 entry validation, the BOM policy, the line semantics,
# the XID identifiers, the NFC identity, the bidi policy, the char-literal
# scalar gates).
#
# The Gate D table (each input -> the exact expected behavior):
#   [0x43, 0xC0, 0xAF]                    -> "invalid UTF-8 byte sequence at byte 1"
#                                          (the overlong C0 AF), ZERO tokens
#   [0x61, 0x80]                          -> "invalid UTF-8 byte sequence at byte 1"
#                                          (the isolated 80), ZERO tokens
#   [0xE2, 0x82]                          -> "invalid UTF-8 byte sequence at byte 0"
#                                          (the truncated E2 82), ZERO tokens
#   BOM + "let x = 1"                     -> VALID; the first token starts at byte 3
#   "let " + BOM + "x"                    -> the "BOM inside the source" diagnostic,
#                                          ZERO tokens (the mid-source BOM is REJECTED)
#   "a\nb\r\nc\rd"                        -> THREE Newline tokens; LF, CRLF, and CR
#                                          alone each advance the line (b:2, c:3, d:4)
#   "café" (U+00E9)                       -> Ident "café"
#   "caf" + U+0065 + U+0301 (NFD)         -> Ident "café" (the NFC identity); the
#                                          original spelling lives in the span (6 bytes)
#   "한글" / its decomposed jamo spelling -> Ident "한글" (the Hangul L+V / LV+T
#                                          composition is algorithmic)
#   "αβγ" / "变量" / "ひらがな"            -> single XID identifiers
#   "def"                                 -> the Def keyword (never an Ident)
#   "let evil" + U+202E + "foo = 1"       -> the "bidirectional override" diagnostic,
#                                          ZERO tokens (the bidi policy)
#   '\\u{D800}' / '\\u{DFFF}'             -> the "surrogate" invalid-scalar diagnostic,
#                                          NO CharLit token
#   '\\u{10FFFF}'                         -> VALID CharLit (the scalar value 0x10FFFF)
#   '\\u{110000}'                         -> the "out of range" diagnostic
#   '\\u{}'                               -> the "empty unicode escape" diagnostic
#   '\\uD800' (4-digit)                   -> the "surrogate" diagnostic
#   "'é'" (raw multi-byte)                -> VALID CharLit (the scalar value 0xE9)
#   "\"\\u{D800}\"" (the string path)     -> the "surrogate" diagnostic
#
# The table data authority: UCD 16.0.0 (DerivedCoreProperties.txt for
# XID_Start/XID_Continue, UnicodeData.txt + CompositionExclusions.txt for
# NFC), verified against Python's unicodedata NFC on every BMP scalar.

use std::collections::{Vec}
use std::test::*
use tg_compiler::lexer::{tokenize, LexResult}
use tg_compiler::token::{TokenKind, Span, span_dummy, span_to_line_col}

# ———————————————————————————————————————————————————————————————
# Harness helpers
# ———————————————————————————————————————————————————————————————

def source_from_bytes(bs: Vec[u8]) -> String
  String::from_bytes(bs)
end

def messages_of(r: LexResult) -> Vec[String]
  mut msgs = Vec::new()
  for e in r.errors do
    let (msg, _span) = e
    msgs.push(msg)
  end
  msgs
end

def lex_errors(spelling: String) -> Vec[String]
  let r = tokenize(spelling, "gate_d.tg")
  messages_of(r)
end

def errors_contain(errs: Vec[String], needle: String) -> Bool
  for e in errs do
    if e.contains(&needle) then
      return true
    end
  end
  false
end

def first_ident(src: String) -> Option[String]
  let r = tokenize(src, "gate_d.tg")
  for t in r.tokens do
    match t.kind
    when TokenKind::Ident(s) then return Option::Some(s)
    when _ then ()
    end
  end
  Option::None
end

def first_ident_span(src: String) -> Option[Span]
  let r = tokenize(src, "gate_d.tg")
  for t in r.tokens do
    match t.kind
    when TokenKind::Ident(_) then return Option::Some(t.span)
    when _ then ()
    end
  end
  Option::None
end

def first_char_lit(src: String) -> Option[Int]
  let r = tokenize(src, "gate_d.tg")
  for t in r.tokens do
    match t.kind
    when TokenKind::CharLit(c) then return Option::Some(c as Int)
    when _ then ()
    end
  end
  Option::None
end

def span_of_ident(src: String, name: String) -> Span
  let r = tokenize(src, "gate_d.tg")
  for t in r.tokens do
    match t.kind
    when TokenKind::Ident(s) then
      if s == name then
        return t.span
      end
    when _ then ()
    end
  end
  span_dummy()
end

# ———————————————————————————————————————————————————————————————
# Gate D — the strict UTF-8 validation (the entry pass)
# ———————————————————————————————————————————————————————————————

@test
def test_gate_d_malformed_utf8() -> Unit
  # the overlong C0 AF (0xC0 0xAF encodes '/' in the 1-byte range)
  let overlong = source_from_bytes(Vec::from([0x43u8, 0xC0u8, 0xAFu8]))
  let r1 = tokenize(overlong, "gate_d.tg")
  assert_eq(r1.tokens.len(), 0)
  assert(errors_contain(messages_of(r1), "invalid UTF-8 byte sequence at byte 1"),
    "the overlong C0 AF must be the hard lexical error at byte 1")
  # the isolated continuation byte 80
  let isolated = source_from_bytes(Vec::from([0x61u8, 0x80u8]))
  let r2 = tokenize(isolated, "gate_d.tg")
  assert_eq(r2.tokens.len(), 0)
  assert(errors_contain(messages_of(r2), "invalid UTF-8 byte sequence at byte 1"),
    "the isolated 80 must be the hard lexical error at byte 1")
  # the truncated E2 82 (a 3-byte sequence with only 2 bytes)
  let truncated = source_from_bytes(Vec::from([0xE2u8, 0x82u8]))
  let r3 = tokenize(truncated, "gate_d.tg")
  assert_eq(r3.tokens.len(), 0)
  assert(errors_contain(messages_of(r3), "invalid UTF-8 byte sequence at byte 0"),
    "the truncated E2 82 must be the hard lexical error at byte 0")
  # a lead byte beyond the scalar range (F5)
  let beyond = source_from_bytes(Vec::from([0xF5u8, 0x80u8, 0x80u8, 0x80u8]))
  let r4 = tokenize(beyond, "gate_d.tg")
  assert_eq(r4.tokens.len(), 0)
  assert(errors_contain(messages_of(r4), "invalid UTF-8"), "the F5 lead must be rejected")
  # a valid multi-byte source is unaffected by the pass
  let ok = tokenize("café = 1", "gate_d.tg")
  assert_eq(ok.errors.len(), 0)
end

# ———————————————————————————————————————————————————————————————
# Gate D — the BOM policy
# ———————————————————————————————————————————————————————————————

@test
def test_gate_d_bom_policy() -> Unit
  # the leading BOM is accepted: the first token starts AFTER it
  let with_bom = source_from_bytes(Vec::from([
    0xEFu8, 0xBBu8, 0xBFu8,   # the UTF-8 BOM
    0x6Cu8, 0x65u8, 0x74u8,   # "let"
    0x20u8,                    # " "
    0x78u8,                    # "x"
    0x20u8, 0x3Du8, 0x20u8, 0x31u8  # " = 1"
  ]))
  let r = tokenize(with_bom, "gate_d.tg")
  assert_eq(r.errors.len(), 0)
  assert_true(r.tokens.len() > 0)
  assert_eq(r.tokens[0].span.start, 3)
  # the mid-source BOM is REJECTED (the explicit policy: only the leading
  # BOM is permitted — the zero-AST outcome)
  let mid_bom = source_from_bytes(Vec::from([
    0x6Cu8, 0x65u8, 0x74u8, 0x20u8,   # "let "
    0xEFu8, 0xBBu8, 0xBFu8,            # the BOM in the middle
    0x78u8                             # "x"
  ]))
  let r2 = tokenize(mid_bom, "gate_d.tg")
  assert_eq(r2.tokens.len(), 0)
  assert(errors_contain(messages_of(r2), "BOM inside the source"),
    "the mid-source BOM must be rejected with the BOM diagnostic")
end

# ———————————————————————————————————————————————————————————————
# Gate D — the line semantics (LF / CRLF / CR alone)
# ———————————————————————————————————————————————————————————————

@test
def test_gate_d_line_semantics() -> Unit
  let src = "a\nb\r\nc\rd"
  let r = tokenize(src, "gate_d.tg")
  var newlines = 0
  for t in r.tokens do
    match t.kind
    when TokenKind::Newline then newlines = newlines + 1
    when _ then ()
    end
  end
  # LF, CRLF, and CR alone each produce exactly ONE Newline token
  assert_eq(newlines, 3)
  assert_eq(r.errors.len(), 0)
  # LF -> line+1; CRLF -> line+1 (not +2); CR alone -> line+1
  let (lb, cb, _eb, _ecb) = span_to_line_col(span_of_ident(src, "b"), src)
  assert_eq(lb, 2)
  assert_eq(cb, 1)
  let (lc, cc, _ec, _ecc) = span_to_line_col(span_of_ident(src, "c"), src)
  assert_eq(lc, 3)
  assert_eq(cc, 1)
  let (ld, cd, _ed, _ecd) = span_to_line_col(span_of_ident(src, "d"), src)
  assert_eq(ld, 4)
  assert_eq(cd, 1)
end

# ———————————————————————————————————————————————————————————————
# Gate D — the XID identifiers and the NFC-normalized identity
# ———————————————————————————————————————————————————————————————

@test
def test_gate_d_xid_identifiers() -> Unit
  let greek = assert_some(first_ident("αβγ"))
  assert_eq(greek, "αβγ")
  let cjk = assert_some(first_ident("变量"))
  assert_eq(cjk, "变量")
  let hira = assert_some(first_ident("ひらがな"))
  assert_eq(hira, "ひらがな")
  # the combining mark continues the identifier: a + U+0301 is the
  # identifier 'á' (the NFC composition inside the identifier)
  let acc = assert_some(first_ident("a\u{0301}"))
  assert_eq(acc, "á")
  # the keywords stay keywords (the ASCII fast path is unaffected)
  let r = tokenize("def", "gate_d.tg")
  assert_eq(r.errors.len(), 0)
  match r.tokens[0].kind
  when TokenKind::Def then ()
  when _ then assert(false, "def must stay a keyword")
  end
  assert_eq(lex_errors("αβγ").len(), 0)
  assert_eq(lex_errors("变量").len(), 0)
end

@test
def test_gate_d_nfc_identifier_identity() -> Unit
  # café (the precomposed U+00E9) vs caf + U+0065 + U+0301 (the NFD
  # spelling): BOTH normalize to the SAME Ident payload — the symbol
  # identity is the normalized form
  let pre = assert_some(first_ident("café"))
  assert_eq(pre, "café")
  let nfd = assert_some(first_ident("caf\u{0065}\u{0301}"))
  assert_eq(nfd, "café")
  # the ORIGINAL spelling is preserved through the token's span (the
  # diagnostics print the original bytes): 5 bytes vs 6 bytes
  let sp_pre = assert_some(first_ident_span("café"))
  let sp_nfd = assert_some(first_ident_span("caf\u{0065}\u{0301}"))
  assert_eq(sp_pre.end_pos - sp_pre.start, 5)
  assert_eq(sp_nfd.end_pos - sp_nfd.start, 6)
  assert_eq(lex_errors("café").len(), 0)
  assert_eq(lex_errors("caf\u{0065}\u{0301}").len(), 0)
  # Hangul: the syllable and its decomposed jamo spelling are the SAME
  # identifier (the algorithmic L+V / LV+T composition)
  let hangul = assert_some(first_ident("한글"))
  assert_eq(hangul, "한글")
  let jamo = assert_some(first_ident("\u{1112}\u{1161}\u{11AB}\u{1100}\u{1173}\u{11AF}"))
  assert_eq(jamo, "한글")
end

# ———————————————————————————————————————————————————————————————
# Gate D — the bidi policy
# ———————————————————————————————————————————————————————————————

@test
def test_gate_d_bidi_rejection() -> Unit
  # an identifier containing U+202E (RLO) — the hard bidi-security
  # diagnostic, ZERO tokens
  let src = "let evil\u{202E}foo = 1"
  let r = tokenize(src, "gate_d.tg")
  assert_eq(r.tokens.len(), 0)
  assert(errors_contain(messages_of(r), "bidirectional override character U+202E"),
    "U+202E must be the hard bidi-security diagnostic")
  # any bidi control in the source is rejected (U+2066 LRI)
  let r2 = tokenize("x = \u{2066}1", "gate_d.tg")
  assert_eq(r2.tokens.len(), 0)
  assert(errors_contain(messages_of(r2), "bidirectional override character U+2066"),
    "U+2066 must be rejected by the bidi policy")
end

# ———————————————————————————————————————————————————————————————
# Gate D — the char-literal scalar gates
# ———————————————————————————————————————————————————————————————

@test
def test_gate_d_char_surrogate_rejection() -> Unit
  let e1 = lex_errors("'\\u{D800}'")
  assert(errors_contain(e1, "surrogate"), "\\u{D800} must be the invalid-scalar diagnostic")
  assert_true(first_char_lit("'\\u{D800}'").is_none())
  let e2 = lex_errors("'\\u{DFFF}'")
  assert(errors_contain(e2, "surrogate"), "\\u{DFFF} must be rejected")
  let e3 = lex_errors("'\\uD800'")
  assert(errors_contain(e3, "surrogate"), "the 4-digit \\uD800 must be rejected")
end

@test
def test_gate_d_char_scalar_range() -> Unit
  # \u{10FFFF} is the maximum scalar value — VALID
  let max = assert_some(first_char_lit("'\\u{10FFFF}'"))
  assert_eq(max, 0x10FFFF)
  # \u{110000} is beyond the scalar range — rejected
  let e1 = lex_errors("'\\u{110000}'")
  assert(errors_contain(e1, "out of range"), "\\u{110000} must be rejected")
  # \u{} is rejected (the empty escape)
  let e2 = lex_errors("'\\u{}'")
  assert(errors_contain(e2, "empty unicode escape"), "\\u{} must be rejected")
  # a plain escape still works
  let a = assert_some(first_char_lit("'\\u{41}'"))
  assert_eq(a, 0x41)
  # a raw multi-byte character literal decodes the full scalar
  let eacute = assert_some(first_char_lit("'é'"))
  assert_eq(eacute, 0xE9)
  # the string-literal path shares the scalar gate
  let e3 = lex_errors("\"\\u{D800}\"")
  assert(errors_contain(e3, "surrogate"), "a string must reject the surrogate escape")
end
