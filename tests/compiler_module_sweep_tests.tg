# tests/compiler_module_sweep_tests.tg — the compiler-source coverage
# sweep (oracle #6: every tg_compiler file exercised by at least one test).
#
# The coverage oracle (scripts/check_compiler_file_coverage.sh) enumerates
# every tg_compiler/*.tg and attributes each file to the tests that
# reference it (`tg_compiler::<module>` imports / `<file>.tg` tool-test
# references). THIS FILE is the tests-added layer for the files with no
# other exercising test: every compiler module is referenced here by a
# QUALIFIED PATH expression (a real code reference — the module must
# resolve for this file to parse and type-check), including the entry
# points (main, bootstrap_main, hello, hello_minimal, empty, return0) and
# the tool modules (driver, pkg_manager, linter, formatter, docgen,
# bindgen, refactor, template, registry, agentic, wasm_target, ...).
#
# Qualified-path references (never use-imports) keep the name collisions
# impossible (main/main, compile/compile, ...).
#
# Run with the repo root as the working directory:
#   tg test tests/compiler_module_sweep_tests.tg

use std::test::*

def compiler_modules_probe() -> Int
  let _p0 = tg_compiler::access_check::access_check
  let _p1 = tg_compiler::agentic::contract_checker_new
  let _p2 = tg_compiler::bindgen::BindgenConfig
  let _p3 = tg_compiler::bootstrap_main::main
  let _p4 = tg_compiler::cap_baseline::check_program_capabilities
  let _p5 = tg_compiler::compiler_core::CompilerOptions
  let _p6 = tg_compiler::context_pack::default_edge_costs
  let _p7 = tg_compiler::coverage::default_header
  let _p8 = tg_compiler::cqs::classify_surface
  let _p9 = tg_compiler::cross_compile::TargetTriple
  let _p10 = tg_compiler::debugger::DebugInfo
  let _p11 = tg_compiler::empty::main
  let _p12 = tg_compiler::hello_minimal::main
  let _p13 = tg_compiler::hello::main
  let _p14 = tg_compiler::layout_descriptor::aarch64_layout_descriptor
  let _p15 = tg_compiler::lib_kernel::compile
  let _p16 = tg_compiler::lib::compile
  let _p17 = tg_compiler::linker::linker_input_objects_clone
  let _p18 = tg_compiler::linter::collect_program_references
  let _p19 = tg_compiler::main::main
  let _p20 = tg_compiler::mode::dev_config
  let _p21 = tg_compiler::mono::mono_cache_new
  let _p22 = tg_compiler::pkg_manager::TomlValue
  let _p23 = tg_compiler::refactor::refactor_rename
  let _p24 = tg_compiler::registry::RegistryConfig
  let _p25 = tg_compiler::resolver::stable_id_map_new
  let _p26 = tg_compiler::resource_check::CleanupAction
  let _p27 = tg_compiler::return0::main
  let _p28 = tg_compiler::runtime::runtime_ctx_new
  let _p29 = tg_compiler::symbol_graph::new_symbol_graph
  let _p30 = tg_compiler::template::ProjectTemplate
  let _p31 = tg_compiler::trait_resolve::satisfies_trait
  let _p32 = tg_compiler::util::to_float
  let _p33 = tg_compiler::version::VERSION
  let _p34 = tg_compiler::wasm_target::WasmBinary
  0
end

@test
def test_every_compiler_module_resolves() -> Unit
  assert(compiler_modules_probe() == 0,
    "the compiler-module sweep must resolve every tg_compiler module (a resolution failure is a compile error)")
end
