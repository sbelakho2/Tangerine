# tests/join_cancel_test.tg — the single finish_task terminal path: the
# normal completion AND the cancellation both route through it, and the
# cancellation wakes the pending join waiter exactly once. A spawned
# task cancelled while its JoinHandle is awaited → the join waiter is
# woken and the join completes with the Result::Err("task cancelled")
# (the Result[(), String] form — the typed JoinError enum is the
# documented future work).

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*

@test
def test_join_cancel_returns_error_and_wakes_waiter() -> Unit
  # The body's join waiter is REGISTERED before the cancellation (the
  # body polls the child's handle and goes Pending first; only then does
  # the canceller task run). If the cancellation did not wake the waiter,
  # the body would hang forever and the block_on would never return.
  let mut events = Vec::new()
  std::async::block_on(async {
    # the child never completes on its own (a 60s sleep — cancelled long
    # before the timer can fire)
    let handle = std::async::spawn(async {
      std::async::sleep_millis(60000).await
    })
    let child_id = handle.task_id
    # the canceller runs after the body's join waiter is registered
    let canceller = std::async::spawn(async {
      let cancelled = std::async::cancel_task(child_id)
      if cancelled then
        events.push(3)
      end
    })
    # the join completes on the Cancelled terminal state, not only on
    # task_results — with the "task cancelled" error
    let r = handle.await
    match r
    when Result::Err(msg) then
      if msg == "task cancelled" then
        events.push(1)
      else
        events.push(9)
      end
    when Result::Ok(_) then events.push(2)
    end
    let _ = canceller.await
  })
  # the join returned the error and the cancellation was acknowledged
  assert_eq(events.len(), 2)
  assert_true(events.contains(1))
  assert_true(events.contains(3))
end
