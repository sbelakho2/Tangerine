@test
def test_tls_certificate_pem_parse_round_trip() -> Unit
  let cert1 = Certificate::from_pem(fixed_cert_pem())
  let c1 = assert_ok(cert1)
  assert_eq(c1.subject_cn(), "tangerine-interop.test")
  assert_false(c1.is_expired())

  # Re-parse the same fixed PEM: the round trip must yield the same subject.
  let cert2 = Certificate::from_pem(fixed_cert_pem())
  let c2 = assert_ok(cert2)
  assert_eq(c2.subject_cn(), "tangerine-interop.test")
  assert_eq(c1.subject_cn(), c2.subject_cn())
end

@test
def test_tls_certificate_rejects_garbage_pem() -> Unit
  let bad = Certificate::from_pem("not a pem at all".to_string())
  match bad
  when Result::Err(_)
    assert_true(true)
  when Result::Ok(_)
    assert_false(true)
  end
end

@test
def test_tls_private_key_pem_parse() -> Unit
  let no_password: Option[String] = Option::None
  let key = PrivateKey::from_pem(fixed_key_pem(), no_password)
  let k = assert_ok(key)
  # The parsed key must survive a non-null native handle.
  assert_true(!k.handle().is_null())
end

@test
def test_tls_config_consuming_builders_move_ownership() -> Unit
  let cert = assert_ok(Certificate::from_pem(fixed_cert_pem()))
  let no_password: Option[String] = Option::None
  let key = assert_ok(PrivateKey::from_pem(fixed_key_pem(), no_password))

  # The consuming builder (sink self / sink cert / sink key) MOVES the
  # certificate and the private key into the config: the native X509 /
  # EVP_PKEY handles now have exactly one owning wrapper, so the Drop impls
  # cannot double-free them. A clone-based builder would leave two owning
  # wrappers over the same native handle — the ownership bug this test
  # guards against (the pre-fix builders cloned the certificate and
  # private-key options and the ca_certs vector).
  let cfg = TlsConfig::default_server().with_certificate(cert, key)

  # The consumed config moves by value into the client (TlsClient::new
  # takes it by value): no clone path exists between the builder and the
  # connection. Dropping the client releases each native handle exactly
  # once.
  TlsClient::new(cfg)
  assert_true(true)
end

@test
def test_tls_config_builder_chain_consumes() -> Unit
  let mut protocols: Vec[String] = Vec::new()
  protocols.push("h2".to_string())
  protocols.push("http/1.1".to_string())

  let cert = assert_ok(Certificate::from_pem(fixed_cert_pem()))
  let no_password: Option[String] = Option::None
  let key = assert_ok(PrivateKey::from_pem(fixed_key_pem(), no_password))

  # Every with_* step consumes the previous config (sink self) and returns
  # it; the certificate/private-key options, the alpn vector, and the
  # ca_certs vector are moved, never cloned. The chain runs the
  # certificate-holding config through with_alpn and with_verify_peer — the
  # exact operations that cloned the certificate option before the fix —
  # and drops the resulting server: a clone anywhere in the chain would
  # double-free the native handles at that drop.
  let cfg = TlsConfig::default_client()
    .with_certificate(cert, key)
    .with_alpn(protocols)
    .with_verify_peer(false)

  TlsServer::new(cfg)
  assert_true(true)
end
