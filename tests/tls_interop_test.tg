# tests/tls_interop_test.tg — TLS certificate parse round-trip via std::tls.
#
# A fixed self-signed RSA-2048 certificate (CN=tangerine-interop.test,
# valid 2026-08-20 .. 2046-08-15) is parsed through the TLS module's X509
# stack (tls_x509_from_pem -> DER serialization -> subject extraction) and
# re-parsed: the parse round-trip must yield the identical subject CN and a
# non-expired validity window. The PEM is embedded so the suite never
# depends on external fixture files.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::tls::Certificate

def fixed_cert_pem() -> String
  "-----BEGIN CERTIFICATE-----\n" +
  "MIIDIzCCAgugAwIBAgIUC8jsCeY5AmaJ5Bs3LmgBF9ddVUgwDQYJKoZIhvcNAQEL\n" +
  "BQAwITEfMB0GA1UEAwwWdGFuZ2VyaW5lLWludGVyb3AudGVzdDAeFw0yNjA4MjAx\n" +
  "OTQ2MDBaFw00NjA4MTUxOTQ2MDBaMCExHzAdBgNVBAMMFnRhbmdlcmluZS1pbnRl\n" +
  "cm9wLnRlc3QwggEiMA0GCSqGSIb3DQEBAQUAA4IBDwAwggEKAoIBAQCdxv8Toh1R\n" +
  "yyVNh6HsJETjlnGoEFpgsdvIqqeM6+7sQEzLIm6jX4sSOPHGu4PXf/8sR0TesBfr\n" +
  "0c4SJAoawSYwrQ8JNFvtOX34Wj+2F/fZqg7egJcrpzJdGelkKVzRRFvqUEYBc+Bi\n" +
  "yFOyX4FTLiWzZSB7C6XXwO43+7zm3PT5aVCbEd64WldJlgnX57aCHeIzIpOZF8JX\n" +
  "QV/KDzcES58lyyeToiYQPTQwtxsPFuhOktQf6Xwp0Ntm70t9eo9KD8wNfEbHk3EW\n" +
  "l8ayjW6FhGZadwfn8kDliWaGCdgL7A7C5Ve5HXHWnGvEpFKaZWSD2ilTsjKVIsDE\n" +
  "uHdZMqyiqqYJAgMBAAGjUzBRMB0GA1UdDgQWBBRk3OIpHz4pynE5L0dVEznrCBoC\n" +
  "rTAfBgNVHSMEGDAWgBRk3OIpHz4pynE5L0dVEznrCBoCrTAPBgNVHRMBAf8EBTAD\n" +
  "AQH/MA0GCSqGSIb3DQEBCwUAA4IBAQBZN3Lecfs7saq+102WjhaLarzmrFj0pT+e\n" +
  "sznVVfaqQv+LN7+1eIyQM18Yg7PT3EbtTm2Fs/o21BE2AM3H/YgkFPdA/svcoGo3\n" +
  "mdWdxrMKX0oG7DmK61JAr7Ob6RCC4QkxPX24Y6XnqMC5adGLzMsSeHFiiFQvtWIP\n" +
  "+R2H6FZd7ElMTgrPMh2k1Vq78aRA+7NKQ+Xt+eePtkhfZYof4SZZBTqaqmR3Yj67\n" +
  "srgJn1f+L5QHyswuVeFsZXIq/OK9MlPEkPlGLN2us2JlsAOZ/fXaGYc9RI58jI8Q\n" +
  "f9nmsHtChA5zFwBrHOu88cgaz8cLSbNuQ+QjKW/kpKOwEGMIaLcm\n" +
  "-----END CERTIFICATE-----\n"
end

@test
def test_tls_certificate_pem_parse_round_trip() -> Unit
  let cert1 = Certificate::from_pem(fixed_cert_pem())
  let c1 = assert_ok(cert1)
  assert_eq(c1.subject_cn(), "tangerine-interop.test")
  assert_false(c1.is_expired())

  # Re-parse the same fixed PEM: the round trip must yield the same subject.
  let cert2 = Certificate::from_pem(fixed_cert_pem())
  let c2 = assert_ok(cert2)
  assert_eq(c2.subject_cn(), "tangerine-interop.test")
  assert_eq(c1.subject_cn(), c2.subject_cn())
end

@test
def test_tls_certificate_rejects_garbage_pem() -> Unit
  let bad = Certificate::from_pem("not a pem at all".to_string())
  match bad
  when Result::Err(_)
    assert_true(true)
  when Result::Ok(_)
    assert_false(true)
  end
end
