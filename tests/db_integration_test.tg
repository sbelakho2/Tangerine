# tests/db_integration_test.tg — SQLite in-memory integration.
#
# Exercises the std::db Sqlite driver through the Connection trait against
# an in-memory database (sqlite3_open(":memory:") via Sqlite::open_memory):
# open -> CREATE TABLE -> INSERT -> SELECT, asserting the row content.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::db::{Sqlite, Connection, ToSqlParam}

@test
def test_sqlite_memory_open_create_insert_select() -> Unit
  let db = Sqlite::open_memory()
  match db
  when Result::Ok(conn) then
    let mut c = conn

    # Create
    let rc = c.execute("CREATE TABLE kv (id INTEGER PRIMARY KEY, value TEXT)", &[])
    assert_ok(rc)

    # Insert
    let ri = c.execute("INSERT INTO kv (value) VALUES (?)", &[Box::new("hello".to_string()) as Box[dyn ToSqlParam]])
    assert_ok(ri)

    # Select
    let rows = c.query("SELECT value FROM kv", &[])
    let r = assert_ok(rows)
    assert_eq(r.row_count(), 1)

    let row = r.into_iter().next()
    match row
    when Option::Some(row) then
      let v: String = row.get(0).ok().unwrap_or("".to_string())
      assert_eq(v, "hello")
    when Option::None then
      assert_false(true)
    end
  when Result::Err(e) then
    assert_false(true)
  end
end
