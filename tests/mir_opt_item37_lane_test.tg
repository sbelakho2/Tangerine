# tests/mir_opt_item37_lane_test.tg — third-audit item 37: the bounded
# optimizer pieces.
#
# The engine lives in tg_compiler/mir.tg:
#   (a) memory-aware GVN — global_value_numbering's place-keyed load cache
#       gates bare scalar-slot reads on the item-38 convention-derived
#       MutationRegion (a let-only call preserves the load fact; an inout
#       call kills it and re-keys the root's value number);
#   (b) struct-field SROA — promote_scalar_locals resolves FieldId ->
#       declared field type through the program's MirTypeDef table, which
#       optimize_mir_impl builds once and threads into the pass (the
#       documented per-function-table gap);
#   (c) redundant retain/release elimination — no-op by fact: MIR has no
#       retain/release construct (Arc/Rc refcount traffic is ordinary
#       MirCall/atomic field operations in std/sync.tg), so no node is
#       rewritten and no row is asserted about one.
#
# The self-checking lane rows (mir_opt_item37_lane_check) build minimal
# MirFunctions BY HAND and assert:
#   G1 a load is CSE'd across a let-only call on the same root;
#   G2 the negative: an inout call on the same root prevents the fold;
#   S1 struct-field SROA promotes the aggregate to per-field temps (name
#      resolution to declaration indices, declared field types);
#   S2 the negative: an empty type table leaves the struct arm inert;
#   S3 the tuple dialect still promotes (regression).
#
# Run with the repo root as the working directory:
#   tg test tests/mir_opt_item37_lane_test.tg

use std::test::assert

use tg_compiler::mir::{mir_opt_item37_lane_check}

@test
def test_mir_opt_item37_lane() -> Unit
  let rows = mir_opt_item37_lane_check()
  assert(rows.len() == 0, "mir optimizer item-37 lane mismatches: " + rows.join("; "))
end
