enum Cmd
  A
  B
  C
end

def handle_a() -> Int
  10
end

def handle_b() -> Int
  20
end

def handle_c() -> Int
  30
end

def dispatch(cmd: Cmd) -> Int
  match cmd
  when Cmd::A then handle_a()
  when Cmd::B then handle_b()
  when Cmd::C then handle_c()
  end
end

def main() -> Int
  dispatch(Cmd::B)
end
