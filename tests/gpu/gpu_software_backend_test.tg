## The software/reference GPU backend behavioral suite — the CPU
## evaluation of the compute kernels (the implementable backend).
##
## Exercises: the device enumeration, the buffer create/upload/download
## path, the kernel compile (the opcode parse), and the CPU dispatch of
## an elementwise kernel (out[i] = in[i] + 1) over host buffers.

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::gpu::*
use std::test::*

@test
def test_software_device_enumeration() -> Unit
  let devices = enumerate_software_devices()
  if devices.len() != 1 then
    panic("software enumeration must report exactly one device")
  end
  if devices[0].backend != GpuBackend::Software then
    panic("software device must carry the Software backend tag")
  end
  if !devices[0].unified_memory then
    panic("software device must be unified-memory (the CPU store)")
  end
end

@test
def test_software_context_and_buffer() -> Unit
  let device = software_device()
  let mut ctx = match create_software_context(device)
  when Result::Ok(c) then c
  when Result::Err(e) then panic("software context failed: " + e.message())
  end
  let desc = BufferDesc {
    size: 16,
    usage: BufferUsage::Storage,
    location: MemoryLocation::HostVisible,
    initial_data: Option::None
  }
  let buffer = match create_buffer(&mut ctx, desc)
  when Result::Ok(b) then b
  when Result::Err(e) then panic("software buffer failed: " + e.message())
  end
  if buffer.size != 16 then
    panic("software buffer size mismatch")
  end
  match buffer.mapped_ptr
  when Option::Some(ptr) then
    ptr.offset(0).write(0x41u8)
    let v = ptr.offset(0).read()
    if v != 0x41u8 then
      panic("software buffer memory write/read failed")
    end
  when Option::None then
    panic("software buffer must expose the mapped host pointer")
  end
  destroy_buffer(&ctx, buffer)
end

@test
def test_software_kernel_dispatch() -> Unit
  let device = software_device()
  let mut ctx = match create_software_context(device)
  when Result::Ok(c) then c
  when Result::Err(e) then panic("software context failed: " + e.message())
  end

  ## in buffer: [10, 20, 30, 40] as u32
  let in_desc = BufferDesc {
    size: 16,
    usage: BufferUsage::Storage,
    location: MemoryLocation::HostVisible,
    initial_data: Option::None
  }
  let in_buf = match create_buffer(&mut ctx, in_desc)
  when Result::Ok(b) then b
  when Result::Err(e) then panic("in buffer failed: " + e.message())
  end
  match in_buf.mapped_ptr
  when Option::Some(ptr) then
    ptr.offset(0).write(10u8)
    ptr.offset(1).write(0u8)
    ptr.offset(2).write(0u8)
    ptr.offset(3).write(0u8)
    ptr.offset(4).write(20u8)
    ptr.offset(5).write(0u8)
    ptr.offset(6).write(0u8)
    ptr.offset(7).write(0u8)
    ptr.offset(8).write(30u8)
    ptr.offset(9).write(0u8)
    ptr.offset(10).write(0u8)
    ptr.offset(11).write(0u8)
    ptr.offset(12).write(40u8)
    ptr.offset(13).write(0u8)
    ptr.offset(14).write(0u8)
    ptr.offset(15).write(0u8)
  when Option::None then
    panic("in buffer has no mapped pointer")
  end

  let out_desc = BufferDesc {
    size: 16,
    usage: BufferUsage::Storage,
    location: MemoryLocation::HostVisible,
    initial_data: Option::None
  }
  let out_buf = match create_buffer(&mut ctx, out_desc)
  when Result::Ok(b) then b
  when Result::Err(e) then panic("out buffer failed: " + e.message())
  end

  ## The kernel program: out[i] = in[i] + 1 for every work item.
  ##   item r0        ; r0 = work item index
  ##   load 0 r1      ; r1 = in[i]
  ##   const r2 1     ; r2 = 1
  ##   add r3 r1 r2   ; r3 = in[i] + 1
  ##   store 1 r3     ; out[i] = r3
  let source = "item r0\nload 0 r1\nconst r2 1\nadd r3 r1 r2\nstore 1 r3\n"
  let kernel = match ComputeKernel::create(&mut ctx, source, "main", [1, 1, 1])
  when Result::Ok(k) then k
  when Result::Err(e) then panic("kernel create failed: " + e.message())
  end

  ## The bindings: the in buffer is binding 0, the out buffer binding 1.
  let mut k = kernel
  let mut bound = k
  bound.set_buffer(0, in_buf)
  bound.set_buffer(1, out_buf)

  match bound.dispatch(&mut ctx, [4, 1, 1])
  when Result::Ok(_) then ()
  when Result::Err(e) then panic("software dispatch failed: " + e.message())
  end

  ## Verify out[i] = in[i] + 1.
  match out_buf.mapped_ptr
  when Option::Some(ptr) then
    var i: Int = 0
    while i < 4 do
      let expected = (10 + i * 10 + 1)
      let got = ptr.offset(i * 4).read() as Int
      if got != expected then
        panic("software dispatch result mismatch at " + i.to_string() + ": got " + got.to_string() + " expected " + expected.to_string())
      end
      i = i + 1
    end
  when Option::None then
    panic("out buffer has no mapped pointer")
  end
  destroy_buffer(&ctx, in_buf)
  destroy_buffer(&ctx, out_buf)
end

@test
def test_software_shader_compile_rejects_empty() -> Unit
  let device = software_device()
  let mut ctx = match create_software_context(device)
  when Result::Ok(c) then c
  when Result::Err(e) then panic("software context failed: " + e.message())
  end
  let result = compile_shader(&ctx, "# only a comment\n".to_string(), ShaderStage::Compute, ShaderLanguage::SPIRV, "main")
  match result
  when Result::Ok(_) then panic("empty software shader must fail compilation")
  when Result::Err(e) then
    match e
    when GpuError::InvalidShader(_) then ()
    when _ then panic("empty shader must produce InvalidShader, got a different error")
    end
  end
end
