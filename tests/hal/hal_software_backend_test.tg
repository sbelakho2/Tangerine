## The HAL software backend behavioral suite — the always-available
## backend: the support probe reports the software backend present, the
## device enumeration reports exactly one device, and the auto-detection
## falls back to the software backend when no hardware backend is
## installed.

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::hal::*
use std::test::*

@test
def test_hal_software_backend_supported() -> Unit
  if !_is_backend_supported(BackendKind::Software) then
    panic("the software backend must always be supported")
  end
end

@test
def test_hal_software_device_count() -> Unit
  let count = _probe_device_count(BackendKind::Software)
  if count != 1 then
    panic("the software backend must enumerate exactly one device, got " + count.to_string())
  end
end

@test
def test_hal_init_software() -> Unit
  let config = HalConfig {
    preferred_backend: Option::Some(BackendKind::Software),
    enable_validation: false
  }
  match init_hal(config)
  when Result::Ok(instance) then
    if instance.device_count != 1 then
      panic("the software instance must report one device")
    end
  when Result::Err(e) then
    panic("init_hal with the software backend failed: " + e.message())
  end
end

@test
def test_hal_auto_detection_falls_back_to_software() -> Unit
  let config = HalConfig {
    preferred_backend: Option::None,
    enable_validation: false
  }
  match init_hal(config)
  when Result::Ok(instance) then
    ## The auto path either finds a hardware backend (a host with
    ## Vulkan/Metal libraries) or the software fallback — both valid.
    if instance.device_count < 1 then
      panic("the auto-detected instance must report at least one device")
    end
  when Result::Err(e) then
    panic("init_hal auto-detection failed: " + e.message())
  end
end
