# tests/db_mysql_integration_test.tg — the std::db MySQL driver
# against the CI mysql service container.
#
# The MySQL lane: mysql_config_new() defaults (port 3306, charset
# utf8mb4) with the host/user/password/database supplied to match the
# GitHub Actions mysql:8 service container (127.0.0.1:3306, root/root,
# database test). The lane is gated behind the service container
# (ci.yml db-integration-mysql job) and preloads libmysqlclient into the
# tg-compiled test process — the same DYLD_INSERT_LIBRARIES /
# DYLD_FORCE_FLAT_NAMESPACE mechanism as the TLS shim and Postgres
# lanes, because the in-house Mach-O linker emits a single LC_LOAD_DYLIB
# and records the mysql_* externs as dyld imports.
#
# The assertions mirror the SQLite/Postgres lanes: open -> CREATE TABLE
# -> INSERT (the ? placeholder interpolated via mysql_interpolate ->
# mysql_real_query) -> SELECT (mysql_store_result ->
# mysql_result_to_rows) through the shared Connection trait / Rows API.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::db::{mysql_config_new, mysql_open, Connection, ToSqlParam}

@test
def test_mysql_service_create_insert_select() -> Unit
  let cfg = mysql_config_new("127.0.0.1", "root", "root", "test")
  let db = mysql_open(cfg)
  match db
  when Result::Ok(conn) then
    let mut c = conn

    # Create
    let rc = c.execute("CREATE TABLE kv (id INT AUTO_INCREMENT PRIMARY KEY, value TEXT)", &[])
    assert_ok(rc)

    # Insert
    let ri = c.execute("INSERT INTO kv (value) VALUES (?)", &[Box::new("hello".to_string()) as Box[dyn ToSqlParam]])
    assert_ok(ri)

    # Select
    let rows = c.query("SELECT value FROM kv", &[])
    let r = assert_ok(rows)
    assert_eq(r.row_count(), 1)

    let row = r.into_iter().next()
    match row
    when Option::Some(row) then
      let v: String = row.get(0).ok().unwrap_or("".to_string())
      assert_eq(v, "hello")
    when Option::None then
      assert_false(true)
    end
  when Result::Err(e) then
    assert_false(true)
  end
end
