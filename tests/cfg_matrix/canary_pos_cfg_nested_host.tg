use std::core

# Matrix case (n+): NESTED inline-module member elimination.  Compiled for
# the host target, the windows-gated declaration INSIDE the nested item list
# is eliminated; the un-gated sibling resolves and the file checks clean.
# This guards the one-pass apply_cfg_elimination: the filtered nested item
# list must be produced directly (a rebuild-by-span implementation could
# keep or drop the wrong nested members) and the crate.modules remap must
# preserve the surviving top-level item indices.
mod helpers
  @cfg(target_os = "windows")
  def cfg_windows_nested() -> Int = 0

  def shared_nested() -> Int = 1
end

def main() -> Int
  helpers::shared_nested()
end
