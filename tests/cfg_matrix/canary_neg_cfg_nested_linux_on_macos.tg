use std::core

# Matrix case (n-): NESTED inline-module member elimination is FINAL.  The
# linux-gated declaration inside the nested item list is eliminated for the
# darwin target, so the un-gated reference MUST fail the standard
# unresolved-name resolution — a nested unavailable-platform declaration
# can never become legal merely because something references it.
mod helpers
  @cfg(target_os = "linux")
  def cfg_linux_nested() -> Int = 0
end

def main() -> Int
  helpers::cfg_linux_nested()
end
