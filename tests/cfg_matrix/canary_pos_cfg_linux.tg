use std::core

# Matrix case (a+): compiled with --target x86_64-linux-gnu the linux
# member of the family EXISTS — the un-gated reference resolves and the
# file checks clean (the @cfg evaluation is a compile-time pass; the
# driver's --target flag selects the SAME TargetSpec
# resolve_codegen_target feeds apply_cfg_elimination).
@cfg(target_os = "linux")
def cfg_linux_marker() -> Int = 0

def main() -> Int
  cfg_linux_marker()
end
