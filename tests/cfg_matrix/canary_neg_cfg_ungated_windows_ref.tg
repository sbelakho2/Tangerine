use std::core

# Matrix case (c): an UNGATED reference to an unavailable symbol MUST
# fail. The windows-only declaration does not exist on ANY non-windows
# target (the runner checks this file for both non-windows triples) and
# nothing — no reference, no import, no retention — may resurrect it.
@cfg(target_os = "windows")
def cfg_windows_marker() -> Int = 0

def main() -> Int
  cfg_windows_marker()
end
