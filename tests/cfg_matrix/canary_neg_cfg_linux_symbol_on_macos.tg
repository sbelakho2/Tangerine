use std::core

# Matrix case (b-): compiled with --target aarch64-apple-darwin the
# linux-only declaration was ELIMINATED for this target — it does not
# exist. The UNGATED reference below MUST fail the standard
# unresolved-name resolution.
@cfg(target_os = "linux")
def cfg_linux_marker() -> Int = 0

def main() -> Int
  cfg_linux_marker()
end
