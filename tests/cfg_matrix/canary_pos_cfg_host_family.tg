use std::core

# The mutually-exclusive @cfg family: for EVERY target exactly one member
# survives the elimination (the contradicting members do not exist for
# this target). The un-gated reference below must resolve to the target's
# kept member — on any host this canary compiles and runs, returning 0.
#
# This is the HOST-agnostic positive of the cross-target matrix
# (tests/run_cfg_matrix_tests.sh): it proves "the target's member of the
# family exists" without naming a specific platform.
@cfg(target_os = "macos")
def cfg_platform_marker() -> Int = 0

@cfg(target_os = "linux")
def cfg_platform_marker() -> Int = 0

def main() -> Int
  cfg_platform_marker()
end
