use std::core

# Matrix case (a-): compiled with --target x86_64-linux-gnu the macos-only
# declaration was ELIMINATED for this target — it does not exist. The
# UNGATED reference below MUST fail the standard unresolved-name
# resolution: an unavailable-platform declaration must never become legal
# merely because something references it (the reference-based resurrection
# is deleted from apply_cfg_elimination).
@cfg(target_os = "macos")
def cfg_macos_marker() -> Int = 0

def main() -> Int
  cfg_macos_marker()
end
