# tests/unicode_shared_data_test.tg — the unicode data authority (the
# reviewer's item 21).
#
# The sharing design: std::unicode's character-property functions
# delegate to the SAME generated UCD tables the lexer consumes (Unicode
# 16.0.0 DerivedCoreProperties.txt XID_Start / XID_Continue BMP ranges).
# The lexer's tables live in the bootstrap kernel closure, which cannot
# import a std data module, so the generated ranges are compiled into
# BOTH modules; THIS suite pins the copies to identical behavior on
# EVERY BMP scalar — a drift between the lexer and std::unicode fails
# CI. The NFC subset is pinned against the lexer's complete oracle.
#
# Run with: tg run tests/unicode_shared_data_test.tg

use std::test::*
use std::core::{Option, Result, String, Unit, Bool, Int, UInt}
use std::unicode::{is_xid_start, is_xid_continue, is_alphabetic, is_numeric, nfc}
use tg_compiler::lexer::{is_xid_start_scalar, is_xid_continue_scalar, identifier_nfc}

# ─── The full BMP pin: std::unicode ≡ the lexer's shared tables ─────

@test
def test_unicode_xid_start_matches_lexer_on_every_bmp_scalar() -> Unit
  var cp = 0
  while cp <= 0xFFFF do
    if is_xid_start(cp) != is_xid_start_scalar(cp) then
      assert(false, "XID_Start mismatch at U+" + cp.to_string() + " (std::unicode vs the lexer's shared table)")
    end
    cp = cp + 1
  end
end

@test
def test_unicode_xid_continue_matches_lexer_on_every_bmp_scalar() -> Unit
  var cp = 0
  while cp <= 0xFFFF do
    if is_xid_continue(cp) != is_xid_continue_scalar(cp) then
      assert(false, "XID_Continue mismatch at U+" + cp.to_string() + " (std::unicode vs the lexer's shared table)")
    end
    cp = cp + 1
  end
end

@test
def test_unicode_alphabetic_matches_lexer_on_every_bmp_scalar() -> Unit
  # is_alphabetic = the shared XID_Start table minus the underscore
  # (U+005F is XID_Start but not Alphabetic).
  var cp = 0
  while cp <= 0xFFFF do
    let lexer_alpha = is_xid_start_scalar(cp) && cp != 0x5F
    if is_alphabetic(cp as Char) != lexer_alpha then
      assert(false, "Alphabetic mismatch at U+" + cp.to_string())
    end
    cp = cp + 1
  end
end

@test
def test_unicode_numeric_follows_the_documented_nd_ranges() -> Unit
  # is_numeric = the ASCII digits + the Nd ranges this module carries.
  # The delegation coherence: every numeric scalar is also an
  # XID_Continue scalar in the lexer's shared table (the digit classes
  # live inside the shared data).
  var cp = 0
  while cp <= 0xFFFF do
    let nd = (cp >= 0x30 && cp <= 0x39) || (cp >= 0x0660 && cp <= 0x0669) ||
             (cp >= 0x06F0 && cp <= 0x06F9) || (cp >= 0x0966 && cp <= 0x096F) ||
             (cp >= 0x09E6 && cp <= 0x09EF) || (cp >= 0xFF10 && cp <= 0xFF19)
    if is_numeric(cp as Char) != nd then
      assert(false, "Numeric mismatch at U+" + cp.to_string())
    end
    if is_numeric(cp as Char) && !is_xid_continue_scalar(cp) then
      assert(false, "Numeric scalar U+" + cp.to_string() + " must be inside the lexer's shared XID_Continue table")
    end
    cp = cp + 1
  end
end

# ─── The NFC subset pin against the lexer's complete oracle ─────────

@test
def test_unicode_nfc_subset_matches_lexer_oracle() -> Unit
  let cases = Vec::from([
    "café".to_string(),
    "cafe\u{301}".to_string(),
    "ñ".to_string(),
    "n\u{303}".to_string(),
    "ü".to_string(),
    "u\u{308}".to_string(),
    "à".to_string(),
    "a\u{300}".to_string(),
    "ç".to_string(),
    "c\u{327}".to_string(),
    "가".to_string(),
    "\u{1100}\u{1161}".to_string(),
    "한글".to_string(),
    "\u{1112}\u{1161}\u{11AB}\u{1100}\u{1161}".to_string(),
    "ﬁ".to_string(),
    "hello".to_string(),
    "".to_string()
  ])
  for s in cases do
    let std_norm = nfc(s.clone())
    let lexer_norm = identifier_nfc(s.clone())
    assert(std_norm == lexer_norm, "NFC mismatch on '" + s + "': std::unicode vs the lexer oracle")
  end
end
