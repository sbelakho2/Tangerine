@test
def aligned_enum_construction_and_downcast_lower() -> Unit
  let defs = ar_type_defs()
  let c = ar_lower(ar_aligned_enum_construct_fn(), defs)
  ar_verify_clean(c, "the @align(16) enum construction function")
  assert(ar_has_store(ar_ptr_stores(c), 16, 8), "the @align(16) payload stores width 8 at byte 16")
  let d = ar_lower(ar_aligned_enum_down_fn(), defs)
  ar_verify_clean(d, "the @align(16) enum downcast function")
  assert(ar_has_load(ar_ptr_loads(d), 16, 8, true), "the @align(16) payload reads sign-extended from byte 16")
end

def ar_aligned_enum_construct_fn() -> MirFunction
  let ty = ar_aligned_enum_decl_ty()
  ar_mk_fn("aligned_enum_construct", Vec::new(), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "e", ty, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(1), ar_agg_rvalue(
        AggregateKind::Struct(TypeId { id: 415 }, Vec::from(["A".to_string(), "B".to_string()])),
        Vec::from([ar_int_operand(0, Type::Int), ar_int_operand(9, Type::Int)])))
    ]), ar_ret_term())
  ]))
end

