# tests/lir_aggregate_residual_test.tg — THE AGGREGATE-RESIDUAL SLICE of
# the LIR route: the aggregate-layout model (P0-21) plus the enum
# value-word model and the deinit-plan consumer (P0-21) admit the four
# shapes the earlier slices kept fail-closed:
#   1. NESTED ENUM FIELDS (structs/tuples/arrays): the field is ONE
#      canonical value word (raw discriminant / heap pointer / niched
#      payload) at the engine's field offset; construction copies the
#      source enum's value word, a discriminant read normalizes that
#      word exactly like a whole enum local's (the tagged threshold
#      switch / the niched compare), and a downcast payload access goes
#      through the field's word (LirPlaceEnumHeapField with the field's
#      base word);
#   2. HEAP-HANDLE FIELDS (String/Vec/Box/... pointer words): admitted
#      as one opaque word — storage/move are whole-word operations and
#      destruction is the plan's leaf (the String runtime destructor on
#      the field address here), never a deref through the field type;
#   3. NESTED-AGGREGATE PROJECTIONS THROUGH A POINTER: p.inner.x and
#      p.e.Variant(v).Field(pf) resolve through the pointed-to image's
#      admitted shapes to the accumulated layout offset (LirPtrLoad at
#      that offset, with the enum's value word loaded first for a
#      payload);
#   4. SUB-WORD FLOAT FIELDS: an F32 at a 4-byte offset is admitted and
#      read/written by the width-sized (4-byte) field access with the
#      marked GP<->FP bit move — a mixed 8-byte image stays a general
#      word;
#   plus the unknown-layout boundary (an unregistered named type still
#   fails closed), the PACKED-PLACEMENT SLICE (8-11: a String handle, an
#   opaque-pointer (FnPtr) field and an enum-typed field at non-8-byte
#   (packed) offsets: the field's ONE word — the handle/opaque pointer
#   word, the enum's canonical value word — stored/read by the byte-mode
#   width-sized access at the layout byte offset, the enum's tag still
#   reading at offset 0 of the value word, destruction through the
#   plan's byte-offset field address), the ENGINE-ENUMLAYOUT SLICE (12:
#   the declaration-level @packed/@align enum attributes, sub-word
#   payload fields and mixed-class / float-width union words all place
#   at the concrete EnumLayout's absolute byte offsets — construction,
#   discriminant, downcast, copy and drop read/write at the field's own
#   storage width and class), and the SIMD VECTOR-FIELD SLICE (13: a
#   vector-typed aggregate field is a whole 16-byte lane image at the
#   engine's field byte offset — construction/read/write through the
#   marked whole-image LirVecLoad/LirVecStore, whole-aggregate copies,
#   and the route desc's width gate), with verify_lir on every admitted
#   row.
#
# Run with: tg test tests/lir_aggregate_residual_test.tg

use std::core::{Option, Result, Int, UInt, Unit, Bool, Float, panic}
use std::collections::{Vec, Map, Set}
use std::test::*
use tg_compiler::ast::{LayoutAttrs, layout_attrs_plain}
use tg_compiler::ids::{
  TypeId, VariantId, FieldId, ModuleId, DefId, CallableId, InstanceId,
  IntrinsicId, def_id_numeric
}
use tg_compiler::mir::{
  MirFunction, MirLocal, MirLocalId, MirBlock, MirBlockId, MirStatement,
  MirStatementKind, MirRvalue, MirRvalueKind, MirOperand, MirOperandKind,
  MirConstant, MirConstantKind, MirTerminator, MirTerminatorKind,
  MirCallArg, MirCallValue,
  MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef,
  AggregateKind, Place, Projection, place_local, mir_type_identity_key
}
use tg_compiler::token::span_dummy
use tg_compiler::target_desc::aarch64_desc
use tg_compiler::types::{Type, DeinitPlan, AccessEffect}
use tg_compiler::lir::{
  LirFunction, LirVerifyRoute, LirTermKind, LirAggShape, LirAggShapeKind,
  LirEnumShape, LirPtrOp, LirBitMoveOp, LirVecOp, LirStmtKind, LirBinOp,
  LirValue,
  lir_plain_struct_shape, lir_check_agg_class_plan,
  lower_mir_fn_to_lir_prog, lir_alloc_registers_a64,
  verify_lir
}

# ———————————————————————————————————————————————————————————————
# Fixture: the residual type universe.
#   400 enum E { A(Int), B(Int) }   tagged + payloaded (image 16 bytes)
#   401 enum P { A, B }             tagged, payload-less (one tag word)
#   402 struct HasE { e: E }
#   403 struct HasP { p: P, y: Int }
#   404 struct HasStr { s: String, x: Int }
#   405 struct HasF32 { a: U32, f: F32 }
#   406 struct Outer2 { inner: Inner2, c: Int }
#   407 struct Inner2 { x: Int, y: Int }
#   408 struct HasE2 { c: Int, e: E }
#   409 struct HasMissing { m: 999 } — the unknown-layout boundary.
# ———————————————————————————————————————————————————————————————

def ar_struct_def(id: Int, name: String, fields: Vec[(String, Type)]) -> MirTypeDef
  var fs: Vec[MirFieldDef] = Vec::new()
  var i = 0
  while i < fields.len() do
    fs.push(MirFieldDef { name: fields[i].0.clone(), ty: fields[i].1.clone() })
    i = i + 1
  end
  MirTypeDef {
    id: TypeId { id: id },
    name: name,
    kind: MirTypeDefKind::Struct(fs),
    generic_params: Vec::new(),
    layout: layout_attrs_plain(span_dummy())
  }
end

def ar_enum_def(id: Int, name: String, variants: Vec[MirVariantDef]) -> MirTypeDef
  MirTypeDef {
    id: TypeId { id: id },
    name: name,
    kind: MirTypeDefKind::Enum(variants),
    generic_params: Vec::new(),
    layout: layout_attrs_plain(span_dummy())
  }
end

def ar_packed_attrs() -> LayoutAttrs
  LayoutAttrs { is_repr_c: false, is_packed: true, align: Option::None, span: span_dummy() }
end

def ar_aligned_attrs(n: Int) -> LayoutAttrs
  LayoutAttrs { is_repr_c: false, is_packed: false, align: Option::Some(n), span: span_dummy() }
end

def ar_struct_def_attrs(id: Int, name: String, fields: Vec[(String, Type)], layout: LayoutAttrs) -> MirTypeDef
  var fs: Vec[MirFieldDef] = Vec::new()
  var i = 0
  while i < fields.len() do
    fs.push(MirFieldDef { name: fields[i].0.clone(), ty: fields[i].1.clone() })
    i = i + 1
  end
  MirTypeDef {
    id: TypeId { id: id },
    name: name,
    kind: MirTypeDefKind::Struct(fs),
    generic_params: Vec::new(),
    layout: layout
  }
end

def ar_enum_def_attrs(id: Int, name: String, variants: Vec[MirVariantDef], layout: LayoutAttrs) -> MirTypeDef
  MirTypeDef {
    id: TypeId { id: id },
    name: name,
    kind: MirTypeDefKind::Enum(variants),
    generic_params: Vec::new(),
    layout: layout
  }
end

def ar_vec_def(tid: Int, name: String, lane: Type, lanes: Int) -> MirTypeDef
  var fields: Vec[MirFieldDef] = Vec::new()
  var i = 0
  while i < lanes do
    fields.push(MirFieldDef { name: "e" + i.to_string(), ty: lane.clone() })
    i = i + 1
  end
  MirTypeDef {
    id: TypeId { id: tid },
    name: name,
    kind: MirTypeDefKind::Struct(fields),
    generic_params: Vec::new(),
    layout: layout_attrs_plain(span_dummy())
  }
end

def ar_type_defs() -> Map[Int, MirTypeDef]
  var defs: Map[Int, MirTypeDef] = Map::new()
  defs.insert(400, ar_enum_def(400, "E", Vec::from([
    MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::from([Type::Int]) },
    MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::from([Type::Int]) }
  ])))
  defs.insert(401, ar_enum_def(401, "P", Vec::from([
    MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::new() },
    MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::new() }
  ])))
  defs.insert(402, ar_struct_def(402, "HasE", Vec::from([
    ("e".to_string(), ar_e_ty())
  ])))
  defs.insert(403, ar_struct_def(403, "HasP", Vec::from([
    ("p".to_string(), ar_p_ty()),
    ("y".to_string(), Type::Int)
  ])))
  defs.insert(404, ar_struct_def(404, "HasStr", Vec::from([
    ("s".to_string(), Type::String),
    ("x".to_string(), Type::Int)
  ])))
  defs.insert(405, ar_struct_def(405, "HasF32", Vec::from([
    ("a".to_string(), Type::U32),
    ("f".to_string(), Type::F32)
  ])))
  defs.insert(406, ar_struct_def(406, "Outer2", Vec::from([
    ("inner".to_string(), ar_inner2_ty()),
    ("c".to_string(), Type::Int)
  ])))
  defs.insert(407, ar_struct_def(407, "Inner2", Vec::from([
    ("x".to_string(), Type::Int),
    ("y".to_string(), Type::Int)
  ])))
  defs.insert(408, ar_struct_def(408, "HasE2", Vec::from([
    ("c".to_string(), Type::Int),
    ("e".to_string(), ar_e_ty())
  ])))
  defs.insert(409, ar_struct_def(409, "HasMissing", Vec::from([
    ("m".to_string(), Type::Adt(TypeId { id: 999 }, Vec::new()))
  ])))
  # The packed-placement slice's shapes: an 8-byte-aligned sibling
  # (U8) forces the one-word field to a non-8-byte (packed) offset.
  defs.insert(410, ar_struct_def_attrs(410, "PackedStr", Vec::from([
    ("a".to_string(), Type::U8),
    ("s".to_string(), Type::String)
  ]), ar_packed_attrs()))
  defs.insert(411, ar_struct_def_attrs(411, "HasFn", Vec::from([
    ("a".to_string(), Type::U8),
    ("f".to_string(), Type::FnPtr(Vec::new(), Type::Unit, Vec::new()))
  ]), ar_packed_attrs()))
  defs.insert(412, ar_struct_def_attrs(412, "PackedE", Vec::from([
    ("x".to_string(), Type::U8),
    ("e".to_string(), ar_e_ty())
  ]), ar_packed_attrs()))
  # The engine-EnumLayout slice's declarations (413-418): each admits
  # with its payload offsets taken from the concrete EnumLayout, so the
  # @packed/@align attribute rules, sub-word payload fields and
  # mixed-class/float-width union words all lower.
  defs.insert(413, ar_enum_def_attrs(413, "PackedEnumDecl", Vec::from([
    MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::from([Type::Int]) },
    MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::new() }
  ]), ar_packed_attrs()))
  defs.insert(414, ar_enum_def(414, "SubwordEnum", Vec::from([
    MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::from([Type::U8, Type::U8]) },
    MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::from([Type::U8]) }
  ])))
  defs.insert(415, ar_enum_def_attrs(415, "AlignedEnumDecl", Vec::from([
    MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::from([Type::Int]) },
    MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::new() }
  ]), ar_aligned_attrs(16)))
  # The engine-EnumLayout slice: a genuinely PACKED sub-word declaration
  # (@packed A(U8, Int), B — the Int payload lands at byte 9, inside the
  # word), a mixed-class union word (A(F64) / B(Int) at the same byte 8)
  # and a float-width union word (A(F32) / B(F64) at the same byte 8).
  defs.insert(416, ar_enum_def_attrs(416, "PackedSubwordDecl", Vec::from([
    MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::from([Type::U8, Type::Int]) },
    MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::new() }
  ]), ar_packed_attrs()))
  defs.insert(417, ar_enum_def(417, "MixedClassUnion", Vec::from([
    MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::from([Type::F64]) },
    MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::from([Type::Int]) }
  ])))
  defs.insert(418, ar_enum_def(418, "FloatWidthUnion", Vec::from([
    MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::from([Type::F32]) },
    MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::from([Type::F64]) }
  ])))
  # The vector-field slice: Vec4 = v128 (420) and a struct carrying one
  # at the engine's 16-byte field offset (421); Vec8 = v256 (422) and
  # its host (423) for the route's desc-width gate.
  defs.insert(420, ar_vec_def(420, "Vec4", Type::F32, 4))
  defs.insert(421, ar_struct_def(421, "HasVec", Vec::from([
    ("a".to_string(), Type::U8),
    ("v".to_string(), ar_vec4_ty())
  ])))
  defs.insert(422, ar_vec_def(422, "Vec8", Type::F32, 8))
  defs.insert(423, ar_struct_def(423, "HasVec8", Vec::from([
    ("a".to_string(), Type::U8),
    ("v".to_string(), ar_vec8_ty())
  ])))
  # The dynamic-offset element slice: an array-typed field host (424), an
  # F32-array host (425) and an aggregate-element array (426) whose
  # element leaf is a whole sub-image (a kept fail-closed rule).
  defs.insert(424, ar_struct_def(424, "HasArr", Vec::from([
    ("a".to_string(), Type::FixedArray(Type::Int, 4))
  ])))
  defs.insert(425, ar_struct_def(425, "HasFArr", Vec::from([
    ("a".to_string(), Type::FixedArray(Type::F32, 2))
  ])))
  defs.insert(426, ar_struct_def(426, "ArrOfInner", Vec::from([
    ("a".to_string(), Type::FixedArray(ar_inner2_ty(), 2))
  ])))
  defs.insert(427, ar_struct_def(427, "HasU8Arr", Vec::from([
    ("a".to_string(), Type::FixedArray(Type::U8, 4))
  ])))
  # The heap-collection runtime-index slice: a Vec/Array-named zero-field
  # Adt is the HeapVecHeader HANDLE (its layout is one pointer word,
  # exactly like std's `struct Vec[T]`), and a struct carrying one tests
  # the field-offset handle word.
  defs.insert(430, ar_struct_def(430, "Vec", Vec::new()))
  defs.insert(431, ar_struct_def(431, "HasVecField", Vec::from([
    ("v".to_string(), ar_vec_int_ty())
  ])))
  defs
end

