end

@test
def vector_field_of_an_unmodelled_width_stays_fail_closed() -> Unit
  let defs = ar_type_defs()
  let f = ar_ret_fn("vec8_host", Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "s", ar_has_vec8_ty(), true)
  ]), Vec::new())
  match lower_mir_fn_to_lir_prog(f, defs, Map::new(), Map::new(), Set::new(), Map::new(), Map::new())
  when Result::Ok(_) then panic("a v256 vector field must fail closed on the aarch64 route")
  when Result::Err(e) then
    assert(e.contains("does not model"), "the vector-width refusal names the descriptor rule, got: " + e)
  end
end

# ———————————————————————————————————————————————————————————————
# 13. THE DYNAMIC-OFFSET ELEMENT SLICE (the runtime-index element
#     place) and THE COPY-THROUGH-POINTER SLICE (the whole-image deref
#     of a pointed-to aggregate). The place shape carries a runtime
#     index vreg: the element address is
#     base + static_off + index * stride, the stride from the admitted
#     layout's element spacing; the access rides the existing marked
#     pointer memory ops at the leaf's width/class. The whole-image
#     deref copies between the pointed image and a frame image through
#     the shared address-image loop.
#
#     BOUNDS BEHAVIOR (mirroring the direct route exactly): the direct
#     emitter's ProjIndex arm scales the index by the element stride,
#     adds the base and performs the width-sized load/store with NO
#     bounds assertion of its own (its bounds guards are separate MIR
#     MirAssert/BoundsCheck terminators, which lower through
#     lir_lower_assert like every other guard). This slice emits the
#     same — no compare and no trap come from the element access (the
#     rows below assert the absence).
# ———————————————————————————————————————————————————————————————

def ar_index_place(id: Int, index_id: Int) -> Place
  var p = ar_place(id)
  p.projections.push(Projection::ProjIndex(MirLocalId { id: index_id }))
  p
end

def ar_index_field_place(id: Int, index_id: Int, owner: Int, field: Int) -> Place
  var p = ar_index_place(id, index_id)
  p.projections.push(Projection::Field(FieldId { owner: TypeId { id: owner }, index: field }))
  p
end

# Count the LirBinop statements whose RIGHT operand is the given
# immediate (the index*stride multiply and the base+offset add of the
# dynamic-address emission).
def ar_binop_imm_count(f: LirFunction, op: LirBinOp, imm: Int) -> Int
  var count = 0
  var bi = 0
  while bi < f.blocks.len() do
    var si = 0
    while si < f.blocks[bi].stmts.len() do
      match f.blocks[bi].stmts[si].kind
      when LirStmtKind::LirBinop(opk, _, _, rhs) then
        match rhs
        when LirValue::LirImm(v) then
          if opk == op && v == imm then count = count + 1 end
        when LirValue::LirReg(_) then ()
        end
      when _ then ()
      end
      si = si + 1
    end
    bi = bi + 1
  end
  count
end

# Count the LirBinop statements whose right operand is a REGISTER (the
# dynamic base + scaled-index add).
def ar_binop_reg_count(f: LirFunction, op: LirBinOp) -> Int
  var count = 0
  var bi = 0
  while bi < f.blocks.len() do
    var si = 0
    while si < f.blocks[bi].stmts.len() do
      match f.blocks[bi].stmts[si].kind
      when LirStmtKind::LirBinop(opk, _, _, rhs) then
        match rhs
        when LirValue::LirReg(_) then
          if opk == op then count = count + 1 end
        when LirValue::LirImm(_) then ()
        end
      when _ then ()
      end
      si = si + 1
    end
    bi = bi + 1
  end
  count
end

def ar_has_lea(f: LirFunction) -> Bool
  var found = false
  var bi = 0
  while bi < f.blocks.len() do
    var si = 0
    while si < f.blocks[bi].stmts.len() do
      match f.blocks[bi].stmts[si].ptr
      when Option::Some(pop) then
        match pop
        when LirPtrOp::LirPtrLea(_, _) then found = true
        when _ then ()
        end
      when Option::None then ()
      end
      si = si + 1
    end
    bi = bi + 1
  end
  found
end

# The marked static byte offsets the dynamic-address emission folds into
# the base (LirPtrAddr) — the array-field / tail offsets that ride the
# address rather than the access.
def ar_ptr_addrs(f: LirFunction) -> Vec[Int]
  var out: Vec[Int] = Vec::new()
  var bi = 0
  while bi < f.blocks.len() do
    var si = 0
    while si < f.blocks[bi].stmts.len() do
      match f.blocks[bi].stmts[si].ptr
      when Option::Some(pop) then
        match pop
        when LirPtrOp::LirPtrAddr(_, _, off) then out.push(off)
        when _ then ()
        end
      when Option::None then ()
      end
      si = si + 1
    end
    bi = bi + 1
  end
  out
end

def ar_has_addr(addrs: Vec[Int], want: Int) -> Bool
  var found = false
  var i = 0
  while i < addrs.len() do
    if addrs[i] == want then found = true end
    i = i + 1
  end
  found
end

# The element access's BOUNDS BEHAVIOR: no compare and no trap come from
# it (the direct route's ProjIndex arm is unchecked too).
def ar_cmp_count(f: LirFunction) -> Int
  var count = 0
  var bi = 0
  while bi < f.blocks.len() do
    var si = 0
    while si < f.blocks[bi].stmts.len() do
      match f.blocks[bi].stmts[si].kind
      when LirStmtKind::LirCmp(_, _) then count = count + 1
      when _ then ()
      end
      si = si + 1
    end
    bi = bi + 1
  end
  count
end

def ar_trap_count(f: LirFunction) -> Int
  var count = 0
  var bi = 0
  while bi < f.blocks.len() do
    match f.blocks[bi].term.kind
    when LirTermKind::LirTrap then count = count + 1
    when _ then ()
    end
    bi = bi + 1
  end
  count
end

# `t = a[i]; a[i] = t` over a whole fixed-array local: the frame
# dynamic-offset form (LirPlaceIndex).
def ar_rt_index_frame_fn() -> MirFunction
  ar_mk_fn("rt_index_frame", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "a", Type::FixedArray(Type::Int, 4), true),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_place(1, 2)))),
      ar_assign_stmt(ar_index_place(1, 2), ar_move_rvalue(ar_copy_operand(ar_place(3))))
    ]), ar_ret_term())
  ]))
end

@test
def runtime_index_frame_element_read_write_lower() -> Unit
  let defs = ar_type_defs()
  let f = ar_lower(ar_rt_index_frame_fn(), defs)
  ar_verify_clean(f, "the frame runtime-index element read/write function")
  # The addressing shape: the frame LEA, the index*8 multiply (the
  # element stride the admitted [Int;4] shape carries) and the
  # base+scaled-index register add.
  assert(ar_has_lea(f), "the dynamic element address starts from the aggregate local's frame LEA")
  assert(ar_binop_imm_count(f, LirBinOp::LirMul, 8) >= 2, "each access scales the runtime index by the element stride 8")
  assert(ar_binop_reg_count(f, LirBinOp::LirAdd) >= 2, "each access adds the scaled index to the base")
  # The widths: an Int element reads/writes as the width-8 signed word
  # at the computed address (a static offset of 0 relative to it).
  let loads = ar_ptr_loads(f)
  let stores = ar_ptr_stores(f)
  assert(ar_has_load(loads, 0, 8, false), "the element read is a width-8 load at the computed address")
  assert(ar_has_store(stores, 0, 8), "the element write is a width-8 store at the computed address")
  # The direct route's ProjIndex arm is unchecked; so is this access.
  assert(ar_cmp_count(f) == 0, "the element access emits no bounds compare of its own (the direct route's ProjIndex arm is unchecked)")
  assert(ar_trap_count(f) == 0, "the element access emits no trap of its own (bounds guards are separate MIR MirAssert terms)")
end

# `t = s.a[i]` over an array-typed field: the static tail before the
# index accumulates the field's layout offset (here 0 — the sole field),
# the element is an Int (its stride-8 scaling).
def ar_rt_index_field_fn() -> MirFunction
  let sy = ar_has_arr_ty()
  ar_mk_fn("rt_index_field", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "s", sy, false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_field_place(1, 2, 424, 0))))
    ]), ar_ret_term())
  ]))
end

@test
def runtime_index_field_element_lowers() -> Unit
  let defs = ar_type_defs()
  let shape = ar_shape(defs, ar_has_arr_ty(), "HasArr")
  assert(shape.size == 16 && shape.fields.len() == 1 && shape.fields[0].byte_off == 0, "the array field sits at byte 0 of the 16-byte host")
  let f = ar_lower(ar_rt_index_field_fn(), defs)
  ar_verify_clean(f, "the field runtime-index element read function")
  assert(ar_binop_imm_count(f, LirBinOp::LirMul, 8) >= 1, "the array field's element stride 8 drives the scaling")
  let loads = ar_ptr_loads(f)
  assert(ar_has_load(loads, 0, 8, false), "the Int element reads as a width-8 word (the static array-field offset is folded into the base add)")
end

# `t = s.a[i]` over a [U8; 4] field: a unit element stride skips the
# multiply and the sub-word width (1) drives the access.
def ar_rt_index_u8_fn() -> MirFunction
  let sy = ar_has_u8_arr_ty()
  ar_mk_fn("rt_index_u8", Vec::new(), Type::U8, Vec::from([
    ar_local(0, "_ret", Type::U8, true),
    ar_local(1, "s", sy, false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::U8, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_field_place(1, 2, 427, 0))))
    ]), ar_ret_term())
  ]))
end

@test
def runtime_index_unit_stride_sub_word_element_lowers() -> Unit
  let defs = ar_type_defs()
  let f = ar_lower(ar_rt_index_u8_fn(), defs)
  ar_verify_clean(f, "the U8-array runtime-index element read function")
  assert(ar_binop_imm_count(f, LirBinOp::LirMul, 1) == 0, "a unit element stride emits no multiply")
  assert(ar_binop_reg_count(f, LirBinOp::LirAdd) >= 1, "the base + raw index add is still emitted")
  assert(ar_has_load(ar_ptr_loads(f), 0, 1, false), "the U8 element reads as a width-1 unsigned word")
end

# `t = s.a[i]` over an F32 array: the sub-word float element path (the
# width-4 bit image into a GP temporary plus the marked GP->FP move).
def ar_rt_index_farr_fn() -> MirFunction
  let sy = ar_has_farr_ty()
  ar_mk_fn("rt_index_farr", Vec::new(), Type::F32, Vec::from([
    ar_local(0, "_ret", Type::F32, true),
    ar_local(1, "s", sy, false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::F32, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_field_place(1, 2, 425, 0)))),
      ar_assign_stmt(ar_index_field_place(1, 2, 425, 0), ar_move_rvalue(ar_copy_operand(ar_place(3))))
    ]), ar_ret_term())
  ]))
end

@test
def runtime_index_float_element_lowers() -> Unit
  let defs = ar_type_defs()
  let f = ar_lower(ar_rt_index_farr_fn(), defs)
  ar_verify_clean(f, "the F32-array runtime-index element read/write function")
  assert(ar_binop_imm_count(f, LirBinOp::LirMul, 4) >= 2, "an F32 element's stride is 4")
  let loads = ar_ptr_loads(f)
  let stores = ar_ptr_stores(f)
  assert(ar_has_load(loads, 0, 4, false), "the F32 element read is a width-4 bit-image load")
  assert(ar_has_store(stores, 0, 4), "the F32 element write is a width-4 bit-image store")
  assert(ar_has_bitmove(f, LirBitMoveOp::LirBitsGpToFp), "the F32 read crosses GP->FP through the marked move")
  assert(ar_has_bitmove(f, LirBitMoveOp::LirBitsFpToGp), "the F32 write crosses FP->GP through the marked move")
end

# `t = r[i]` where r is a RefInternal to a [Int;4]: the deref chain's
# fixed-array sub-image (the [ProjDeref, ProjIndex] MIR form) — the
# same LirPlaceDerefIndex shape based at the pointer word.
def ar_rt_index_ref_fn() -> MirFunction
  let ry = Type::RefInternal(Type::FixedArray(Type::Int, 4), false)
  var p = ar_place(1)
  p.projections.push(Projection::ProjDeref)
  p.projections.push(Projection::ProjIndex(MirLocalId { id: 2 }))
  ar_mk_fn("rt_index_ref", Vec::from([ar_local(1, "r", ry, false)]), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "r", ry, false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(p)))
    ]), ar_ret_term())
  ]))
end

# `t = a[i]` where a is a Ptr[Int]: the RAW pointer-indexing form the
# MIR emits with no explicit deref projection (the unsafe indexing API
# the direct emitter's ProjIndex arm admits by scaling the index with
# the POINTEE's own storage size).
def ar_rt_ptr_index_fn() -> MirFunction
  ar_mk_fn("rt_ptr_index", Vec::from([ar_local(1, "p", Type::Ptr(Type::Int), false)]), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "p", Type::Ptr(Type::Int), false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_place(1, 2))))
    ]), ar_ret_term())
  ]))
end

# `t = p[i].y` where p is a Ptr[Inner2]: the raw pointer-index's element
# is the whole aggregate image (stride = its admitted size 16) and the
# static tail resolves y at the element's byte 8.
def ar_rt_ptr_index_tail_fn() -> MirFunction
  ar_mk_fn("rt_ptr_index_tail", Vec::from([ar_local(1, "p", Type::Ptr(ar_inner2_ty()), false)]), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "p", Type::Ptr(ar_inner2_ty()), false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_field_place(1, 2, 407, 1))))
    ]), ar_ret_term())
  ]))
end

@test
def runtime_index_pointer_forms_lower() -> Unit
  let defs = ar_type_defs()
  # The ref-to-array deref chain form: base word + index*8.
  let rf = ar_lower(ar_rt_index_ref_fn(), defs)
  ar_verify_clean(rf, "the ref-to-array runtime-index read function")
  assert(ar_binop_imm_count(rf, LirBinOp::LirMul, 8) >= 1, "the deref chain's [Int;4] element scales by 8")
  assert(ar_has_load(ar_ptr_loads(rf), 0, 8, false), "the ref element read is a width-8 load at the computed address")
  assert(ar_cmp_count(rf) == 0 && ar_trap_count(rf) == 0, "the deref-chain element access is unchecked like the direct route's")
  # The raw pointer-index form (no deref projection): the pointee's own
  # storage size 8 is the stride, and the pointer value is the base.
  let pf = ar_lower(ar_rt_ptr_index_fn(), defs)
  ar_verify_clean(pf, "the raw pointer-index read function")
  assert(ar_binop_imm_count(pf, LirBinOp::LirMul, 8) >= 1, "a Ptr[Int] index scales by the pointee size 8")
  assert(ar_binop_reg_count(pf, LirBinOp::LirAdd) >= 1, "the pointer word + scaled index add is emitted")
  assert(ar_has_load(ar_ptr_loads(pf), 0, 8, false), "the pointer element read is a width-8 load at the computed address")
  assert(!ar_has_lea(pf), "the raw pointer-index form needs no frame LEA (the base is the pointer word)")
  # The pointer-index + static tail form: stride 16 (Inner2's admitted
  # size), the leaf at the element's byte 8 — the static offset rides
  # the marked address add before the width-8 load.
  let tf = ar_lower(ar_rt_ptr_index_tail_fn(), defs)
  ar_verify_clean(tf, "the raw pointer-index + static tail read function")
  assert(ar_binop_imm_count(tf, LirBinOp::LirMul, 16) >= 1, "a Ptr[Inner2] index scales by the aggregate's admitted size 16")
  assert(ar_has_addr(ar_ptr_addrs(tf), 8), "the element's tail byte 8 folds into the marked address add")
  assert(ar_has_load(ar_ptr_loads(tf), 0, 8, false), "the tail's width-8 load reads at the computed address")
end

# `d = *p` then `*p = d` over p: Ptr[Inner2]: the WHOLE-IMAGE DEREF
# copy-through-pointer round trip (the pointed image and the frame
# image copied through the shared 8/4/2/1 address-image loop).
def ar_whole_deref_round_trip_fn() -> MirFunction
  ar_mk_fn("whole_deref_round_trip", Vec::from([ar_local(1, "p", Type::Ptr(ar_inner2_ty()), false)]), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "p", Type::Ptr(ar_inner2_ty()), false),
    ar_local(2, "d", ar_inner2_ty(), true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(2), ar_move_rvalue(ar_copy_operand(ar_deref_place(1)))),
      ar_assign_stmt(ar_deref_place(1), ar_move_rvalue(ar_copy_operand(ar_place(2))))
    ]), ar_ret_term())
  ]))
end

@test
def whole_image_deref_copy_through_pointer_round_trip() -> Unit
  let defs = ar_type_defs()
  let shape = ar_shape(defs, ar_inner2_ty(), "Inner2")
  assert(shape.size == 16, "the pointed-to Inner2 image is 16 bytes")
  let f = ar_lower(ar_whole_deref_round_trip_fn(), defs)
  ar_verify_clean(f, "the whole-image deref copy-through-pointer round trip")
  let loads = ar_ptr_loads(f)
  let stores = ar_ptr_stores(f)
  # The read half: the pointed image's two 8-byte words load into the
  # destination local's frame image; the write half stores the local's
  # two words back through the pointer.
  assert(ar_has_load(loads, 0, 8, false) && ar_has_load(loads, 8, 8, false), "the pointed image loads both 8-byte words")
  assert(ar_has_store(stores, 0, 8) && ar_has_store(stores, 8, 8), "the pointed image stores both 8-byte words")
  assert(ar_cmp_count(f) == 0 && ar_trap_count(f) == 0, "the copy-through-pointer walk emits no compare and no trap")
end

# The WHOLE-IMAGE DEREF of a pointed-to TAGGED ENUM: its ONE canonical
# value word (a whole-enum copy through the pointer is the one-word
# move/store).
def ar_whole_deref_enum_fn() -> MirFunction
  ar_mk_fn("whole_deref_enum", Vec::from([ar_local(1, "p", Type::Ptr(ar_e_ty()), false)]), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "p", Type::Ptr(ar_e_ty()), false),
    ar_local(2, "e", ar_e_ty(), true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(2), ar_move_rvalue(ar_copy_operand(ar_deref_place(1)))),
      ar_assign_stmt(ar_deref_place(1), ar_move_rvalue(ar_copy_operand(ar_place(2))))
    ]), ar_ret_term())
  ]))
end

@test
def whole_image_deref_of_a_pointed_enum_is_one_word() -> Unit
  let defs = ar_type_defs()
  let f = ar_lower(ar_whole_deref_enum_fn(), defs)
  ar_verify_clean(f, "the whole-enum deref read/write function")
  assert(ar_has_load(ar_ptr_loads(f), 0, 8, false), "the whole-enum deref read is the one width-8 value word")
  assert(ar_has_store(ar_ptr_stores(f), 0, 8), "the whole-enum deref write is the one width-8 value word")
  assert(ar_binop_imm_count(f, LirBinOp::LirMul, 8) == 0, "no element scaling is involved in a whole-enum deref")
end

# ———————————————————————————————————————————————————————————————
# 13b. The still-fail-closed rules of the slice, each named.
# ———————————————————————————————————————————————————————————————

@test
def runtime_index_outside_a_fixed_array_image_stays_fail_closed() -> Unit
  let defs = ar_type_defs()
  let f = ar_mk_fn("rt_index_struct", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "s", ar_inner2_ty(), false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_place(1, 2))))
    ]), ar_ret_term())
  ]))
  match lower_mir_fn_to_lir_prog(f, defs, Map::new(), Map::new(), Set::new(), Map::new(), Map::new())
  when Result::Ok(_) then panic("a runtime index over a non-array aggregate image must stay fail-closed")
  when Result::Err(e) then
    assert(e.contains("FIXED-ARRAY image only"), "the rule names the admitted array image, got: " + e)
  end
end

@test
def runtime_index_with_a_non_integer_index_stays_fail_closed() -> Unit
  let defs = ar_type_defs()
  let f = ar_mk_fn("rt_index_float_idx", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "a", Type::FixedArray(Type::Int, 4), true),
    ar_local(2, "i", Type::F32, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_place(1, 2))))
    ]), ar_ret_term())
  ]))
  match lower_mir_fn_to_lir_prog(f, defs, Map::new(), Map::new(), Set::new(), Map::new(), Map::new())
  when Result::Ok(_) then panic("a non-integer runtime index must stay fail-closed")
  when Result::Err(e) then
    assert(e.contains("integer word"), "the rule names the integer-word admission, got: " + e)
  end
end

@test
def runtime_index_of_a_whole_element_sub_image_stays_fail_closed() -> Unit
  let defs = ar_type_defs()
  # `[Inner2; 2]`: the element leaf is a whole aggregate sub-image, which
  # is not a scalar element access (copy-through-pointer element images
  # are not implemented).
  let f = ar_mk_fn("rt_index_subimage", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "s", ar_arr_of_inner_ty(), false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "d", ar_inner2_ty(), true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_field_place(1, 2, 426, 0))))
    ]), ar_ret_term())
  ]))
  match lower_mir_fn_to_lir_prog(f, defs, Map::new(), Map::new(), Set::new(), Map::new(), Map::new())
  when Result::Ok(_) then panic("a runtime-index element that is a whole sub-image must stay fail-closed")
  when Result::Err(e) then
    assert(e.contains("whole aggregate sub-image"), "the rule names the sub-image leaf, got: " + e)
  end
end

@test
def whole_image_deref_size_mismatch_stays_fail_closed() -> Unit
  let defs = ar_type_defs()
  # p points at a 16-byte Inner2 image; the destination is a 24-byte
  # Outer2 local: the copy-through-pointer layouts disagree.
  let f = ar_mk_fn("whole_deref_mismatch", Vec::from([ar_local(1, "p", Type::Ptr(ar_inner2_ty()), false)]), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "p", Type::Ptr(ar_inner2_ty()), false),
    ar_local(2, "o", ar_outer2_ty(), true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(2), ar_move_rvalue(ar_copy_operand(ar_deref_place(1))))
    ]), ar_ret_term())
  ]))
  match lower_mir_fn_to_lir_prog(f, defs, Map::new(), Map::new(), Set::new(), Map::new(), Map::new())
  when Result::Ok(_) then panic("a whole-image deref with a layout size mismatch must stay fail-closed")
  when Result::Err(e) then
    assert(e.contains("16 byte(s)") && e.contains("24 byte(s)"), "the rule names both sizes, got: " + e)
  end
end

# ———————————————————————————————————————————————————————————————
# 14. HEAP-COLLECTION RUNTIME INDEXING (the heap-collection
#     runtime-index slice): Vec[T]/Array[T] element places through the
#     32-byte runtime header, the header length read, and the checked
#     Array accessor calls. Fixture: type 430 is a zero-field Vec-named
#     Adt whose layout is the HeapVecHeader handle word (exactly like
#     std's `struct Vec[T]`); the accessor receiver is the checker's
#     re-borrow reference word (RefInternal).
# ———————————————————————————————————————————————————————————————

def ar_vec_int_ty() -> Type
  Type::Adt(TypeId { id: 430 }, Vec::from([Type::Int]))
end

def ar_vec_string_ty() -> Type
  Type::Adt(TypeId { id: 430 }, Vec::from([Type::String]))
end

def ar_has_vec_field_ty() -> Type
  Type::Adt(TypeId { id: 431 }, Vec::new())
end

def ar_vec_ref_ty() -> Type
  Type::RefInternal(ar_vec_int_ty(), false)
end

def ar_call_arg_read(p: Place) -> MirCallArg
  MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(ar_copy_operand(p)) }
end

def ar_call_arg_modify(p: Place) -> MirCallArg
  MirCallArg { effect: AccessEffect::Modify, value: MirCallValue::Value(ar_copy_operand(p)) }
end

def ar_call_term(dest: Place, target: String, args: Vec[MirCallArg], intrinsic: Option[IntrinsicId], success: Int) -> MirTerminator
  MirTerminator {
    kind: MirTerminatorKind::MirCall {
      dest: dest,
      func: MirOperand { kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirFnItem(target),
        ty: Type::Unit,
        instance: Option::None
      }) },
      args: args,
      success: MirBlockId { id: success },
      unwind: Option::None,
      intrinsic: intrinsic,
      tail: false
    },
    span: span_dummy()
  }
end

def ar_len_rvalue(p: Place) -> MirRvalue
  MirRvalue { kind: MirRvalueKind::MirLen(p), span: span_dummy() }
end

def ar_has_move_imm(f: LirFunction, imm: Int) -> Bool
  var found = false
  var bi = 0
  while bi < f.blocks.len() do
    var si = 0
    while si < f.blocks[bi].stmts.len() do
      match f.blocks[bi].stmts[si].kind
      when LirStmtKind::LirMove(_, v) then
        match v
        when LirValue::LirImm(n) then
          if n == imm then found = true end
        when _ then ()
        end
      when _ then ()
      end
      si = si + 1
    end
    bi = bi + 1
  end
  found
end

# `t = v[i]` / `v[i] = t` over a whole Vec[Int] local: the handle word
# from the frame image, the header's data pointer through it, and the
# stride-8 dynamic element access — the inline ProjIndex heap arm.
def ar_heap_index_frame_fn() -> MirFunction
  ar_mk_fn("heap_index_frame", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "v", ar_vec_int_ty(), false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_place(1, 2)))),
      ar_assign_stmt(ar_index_place(1, 2), ar_move_rvalue(ar_copy_operand(ar_place(3))))
    ]), ar_ret_term())
  ]))
end

@test
def heap_vec_index_frame_read_write_lowers() -> Unit
  let defs = ar_type_defs()
  # The Vec handle image: a zero-field 8-byte aggregate (HeapVecHeader
  # pointer layout), so a whole Vec local is admitted.
  let shape = ar_shape(defs, ar_vec_int_ty(), "Vec[Int]")
  assert(shape.size == 8 && shape.fields.len() == 0, "the Vec handle image is one 8-byte word")
  let f = ar_lower(ar_heap_index_frame_fn(), defs)
  ar_verify_clean(f, "the heap Vec frame runtime-index read/write function")
  assert(ar_has_lea(f), "the heap element address starts from the frame LEA")
  assert(ar_binop_imm_count(f, LirBinOp::LirMul, 8) >= 2, "each access scales the index by the stride-8 element")
  assert(ar_binop_reg_count(f, LirBinOp::LirAdd) >= 2, "each access adds the scaled index to the header's data pointer")
  let loads = ar_ptr_loads(f)
  assert(loads.len() >= 4, "each access loads the handle word AND the header data pointer before the element access")
  assert(ar_has_load(loads, 0, 8, false), "the handle word and the data pointer load as width-8 words at displacement 0")
  assert(ar_has_store(ar_ptr_stores(f), 0, 8), "the element write is a width-8 store at the computed address")
  assert(ar_cmp_count(f) == 0, "the heap element place emits no bounds compare (the direct ProjIndex heap arm is unchecked)")
  assert(ar_trap_count(f) == 0, "the heap element place emits no trap of its own")
  assert(!ar_has_call(f, "_tg_array_get"), "the place form accesses the element inline, never through the accessor helper")
end

# `t = s.v[i]` over a struct field of type Vec[Int]: the handle word at
# the FIELD's layout byte offset (its own frame slot).
def ar_heap_index_field_fn() -> MirFunction
  let sy = ar_has_vec_field_ty()
  ar_mk_fn("heap_index_field", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "s", sy, false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_field_place(1, 2, 431, 0))))
    ]), ar_ret_term())
  ]))
end

@test
def heap_vec_field_index_lowers() -> Unit
  let defs = ar_type_defs()
  let shape = ar_shape(defs, ar_has_vec_field_ty(), "HasVecField")
  assert(shape.size == 8 && shape.fields.len() == 1 && shape.fields[0].byte_off == 0, "the Vec handle field is one word at byte 0")
  let f = ar_lower(ar_heap_index_field_fn(), defs)
  ar_verify_clean(f, "the heap Vec field runtime-index read function")
  assert(ar_binop_imm_count(f, LirBinOp::LirMul, 8) >= 1, "the field's Vec element stride 8 drives the scaling")
  assert(ar_has_load(ar_ptr_loads(f), 0, 8, false), "the handle word and the data pointer load as width-8 words")
end

# `t = len(v)` (MirLen over the whole handle) and `t = len(*r)` (MirLen
# over a RefInternal — the glue/iterator form): the header's len field.
def ar_heap_len_fn() -> MirFunction
  ar_mk_fn("heap_len", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "v", ar_vec_int_ty(), false),
    ar_local(2, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(2), ar_len_rvalue(ar_place(1)))
    ]), ar_ret_term())
  ]))
end

def ar_heap_len_ref_fn() -> MirFunction
  ar_mk_fn("heap_len_ref", Vec::from([ar_local(1, "r", ar_vec_ref_ty(), false)]), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "r", ar_vec_ref_ty(), false),
    ar_local(2, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(2), ar_len_rvalue(ar_deref_place(1)))
    ]), ar_ret_term())
  ]))
end

@test
def heap_vec_len_reads_lower() -> Unit
  let defs = ar_type_defs()
  let f = ar_lower(ar_heap_len_fn(), defs)
  ar_verify_clean(f, "the heap Vec length-read function")
  assert(ar_has_load(ar_ptr_loads(f), 8, 8, false), "the whole-local length read loads the header len field (the layout authority's offset 8)")
  assert(ar_cmp_count(f) == 0 && ar_trap_count(f) == 0, "the length read carries neither compare nor trap")
  let g = ar_lower(ar_heap_len_ref_fn(), defs)
  ar_verify_clean(g, "the heap Vec length-through-reference function")
  assert(ar_has_load(ar_ptr_loads(g), 8, 8, false), "the reference form derefs to the handle first, then reads len at offset 8")
  assert(ar_ptr_loads(g).len() >= 2, "the reference form loads the handle through the ref word before the len field")
end

# A fixed inline collection ([Int; 4] field, the ArrayVecN/RingBufferN
# shape) stays on the dynamic-offset IMAGE slice: no heap helper call.
def ar_fixed_collection_index_fn() -> MirFunction
  let sy = ar_has_arr_ty()
  ar_mk_fn("fixed_collection_index", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "s", sy, false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_index_field_place(1, 2, 424, 0)))),
      ar_assign_stmt(ar_index_field_place(1, 2, 424, 0), ar_move_rvalue(ar_copy_operand(ar_place(3))))
    ]), ar_ret_term())
  ]))
end

# A fixed inline array's MirLen is its compile-time count (the direct
# emitter's constant move), never a header read.
def ar_fixed_len_fn() -> MirFunction
  let sy = ar_has_arr_ty()
  ar_mk_fn("fixed_len", Vec::new(), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "s", sy, false),
    ar_local(2, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(2), ar_len_rvalue(ar_field_place(1, 424, 0)))
    ]), ar_ret_term())
  ]))
end

@test
def fixed_collection_len_read_is_the_static_count() -> Unit
  let f = ar_lower(ar_fixed_len_fn(), ar_type_defs())
  ar_verify_clean(f, "the fixed array length-read function")
  assert(ar_has_move_imm(f, 4), "MirLen over a fixed array lowers as the compile-time element count (4)")
end

# `t = v.len()` — the __intrinsic_array_len call: the receiver derefs to
# the handle and the header len field loads (no runtime call).
def ar_heap_len_call_fn() -> MirFunction
  ar_mk_fn("heap_len_call", Vec::from([ar_local(1, "r", ar_vec_ref_ty(), false)]), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "r", ar_vec_ref_ty(), false)
  ]), Vec::from([
    ar_block(0, Vec::new(), ar_call_term(
      ar_place(0),
      "__intrinsic_array_len".to_string(),
      Vec::from([ar_call_arg_read(ar_place(1))]),
      Option::Some(IntrinsicId::ArrayLen),
      1
    )),
    ar_block(1, Vec::new(), ar_ret_term())
  ]))
end

@test
def heap_array_len_call_lowers() -> Unit
  let f = ar_lower(ar_heap_len_call_fn(), ar_type_defs())
  ar_verify_clean(f, "the ArrayLen call function")
  assert(ar_ptr_loads(f).len() >= 2, "the receiver derefs to the handle word before the field load")
  assert(ar_has_load(ar_ptr_loads(f), 8, 8, false), "the len call reads the header len field at the layout offset 8")
end

@test
def fixed_collection_field_index_stays_on_the_image_slice() -> Unit
  let f = ar_lower(ar_fixed_collection_index_fn(), ar_type_defs())
  ar_verify_clean(f, "the fixed-collection field index function")
  assert(!ar_has_call(f, "_tg_array_get") && !ar_has_call(f, "_tg_array_set"), "a fixed inline collection's element access is the dynamic-offset IMAGE place, never a heap helper call")
  assert(ar_has_load(ar_ptr_loads(f), 0, 8, false), "the Int element reads as a width-8 image word")
  assert(ar_binop_imm_count(f, LirBinOp::LirMul, 8) >= 2, "the fixed array's stride-8 scaling is still emitted")
end

# `t = v.get(i)` — the __intrinsic_array_get call with the checked arm:
# the signed index < len compare, the OOB trap, the runtime address
# helper and the width-matched element load.
def ar_heap_get_call_fn() -> MirFunction
  ar_mk_fn("heap_get_call", Vec::from([ar_local(1, "r", ar_vec_ref_ty(), false)]), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "r", ar_vec_ref_ty(), false),
    ar_local(2, "i", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::new(), ar_call_term(
      ar_place(0),
      "__intrinsic_array_get".to_string(),
      Vec::from([
        ar_call_arg_read(ar_place(1)),
        ar_call_arg_read(ar_place(2))
      ]),
      Option::Some(IntrinsicId::ArrayGet),
      1
    )),
    ar_block(1, Vec::new(), ar_ret_term())
  ]))
end

@test
def heap_array_get_call_lowers_checked() -> Unit
  let f = ar_lower(ar_heap_get_call_fn(), ar_type_defs())
  ar_verify_clean(f, "the checked ArrayGet call function")
  assert(ar_has_call(f, "_tg_array_get"), "the checked get calls the runtime address primitive")
  assert(ar_cmp_count(f) >= 1, "the checked arm compares the index against the header length")
  assert(ar_trap_count(f) >= 1, "an out-of-range index reaches a trap (the defined std OOB policy)")
  assert(ar_has_load(ar_ptr_loads(f), 8, 8, false), "the length guard reads the header len field")
  assert(ar_has_load(ar_ptr_loads(f), 0, 8, false), "the returned element address materializes through a width-8 element load")
end

# `v.set(i, t)` — __intrinsic_array_set: the runtime write helper with
# no bounds guard of its own (the direct route's unchecked write).
def ar_heap_set_call_fn() -> MirFunction
  ar_mk_fn("heap_set_call", Vec::from([
    ar_local(1, "r", ar_vec_ref_ty(), false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "r", ar_vec_ref_ty(), false),
    ar_local(2, "i", Type::Int, true),
    ar_local(3, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::new(), ar_call_term(
      ar_place(0),
      "__intrinsic_array_set".to_string(),
      Vec::from([
        ar_call_arg_modify(ar_place(1)),
        ar_call_arg_read(ar_place(2)),
        ar_call_arg_read(ar_place(3))
      ]),
      Option::Some(IntrinsicId::ArraySet),
      1
    )),
    ar_block(1, Vec::new(), ar_ret_term())
  ]))
end

@test
def heap_array_set_call_lowers() -> Unit
  let f = ar_lower(ar_heap_set_call_fn(), ar_type_defs())
  ar_verify_clean(f, "the ArraySet call function")
  assert(ar_has_call(f, "_tg_array_set"), "the set call targets the runtime element-write helper")
  assert(ar_cmp_count(f) == 0 && ar_trap_count(f) == 0, "the unchecked set arm carries no bounds guard (the direct codegen_array_set arm has none)")
end

# `let v = Vec.new()` — __intrinsic_array_new: the runtime header
# constructor with the destination element's stride.
def ar_heap_new_call_fn() -> MirFunction
  ar_mk_fn("heap_new_call", Vec::new(), ar_vec_int_ty(), Vec::from([
    ar_local(0, "_ret", ar_vec_int_ty(), true)
  ]), Vec::from([
    ar_block(0, Vec::new(), ar_call_term(
      ar_place(0),
      "__intrinsic_array_new".to_string(),
      Vec::new(),
      Option::Some(IntrinsicId::ArrayNew),
      1
    )),
    ar_block(1, Vec::new(), ar_ret_term())
  ]))
end

@test
def heap_array_new_call_lowers() -> Unit
  let f = ar_lower(ar_heap_new_call_fn(), ar_type_defs())
  ar_verify_clean(f, "the ArrayNew call function")
  assert(ar_has_call(f, "_tg_array_new"), "the constructor calls the runtime header allocator")
end

# `v.push(t)` — __intrinsic_array_push: the runtime append helper.
def ar_heap_push_call_fn() -> MirFunction
  ar_mk_fn("heap_push_call", Vec::from([
    ar_local(1, "r", ar_vec_ref_ty(), false),
    ar_local(2, "t", Type::Int, true)
  ]), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "r", ar_vec_ref_ty(), false),
    ar_local(2, "t", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::new(), ar_call_term(
      ar_place(0),
      "__intrinsic_array_push".to_string(),
      Vec::from([
        ar_call_arg_modify(ar_place(1)),
        ar_call_arg_read(ar_place(2))
      ]),
      Option::Some(IntrinsicId::ArrayPush),
      1
    )),
    ar_block(1, Vec::new(), ar_ret_term())
  ]))
end

@test
def heap_array_push_call_lowers() -> Unit
  let f = ar_lower(ar_heap_push_call_fn(), ar_type_defs())
  ar_verify_clean(f, "the ArrayPush call function")
  assert(ar_has_call(f, "_tg_array_push"), "the append call targets the runtime helper")
end

# The element DROP over a heap element place: the plan consumer's String
# leaf runs its destructor on the SAME dynamic element address the
# accesses form (the ownership half of an owning-element write).
def ar_heap_string_drop_fn() -> MirFunction
  ar_mk_fn("heap_string_drop", Vec::new(), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "v", ar_vec_string_ty(), true),
    ar_local(2, "i", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::new(), ar_deinit_term(ar_index_place(1, 2), ar_inst(9), 1)),
    ar_block(1, Vec::new(), ar_ret_term())
  ]))
end

@test
def heap_vec_string_element_drop_lowers() -> Unit
  let defs = ar_type_defs()
  var plans: Map[String, DeinitPlan] = Map::new()
  plans.insert(mir_type_identity_key(Type::String), DeinitPlan::String)
  let d = ar_lower_with_plans(ar_heap_string_drop_fn(), defs, plans)
  ar_verify_clean(d, "the heap String-element drop function")
  assert(ar_has_call(d, "_tg_string_drop"), "the element's String plan calls the runtime destructor on the element address")
  assert(ar_binop_imm_count(d, LirBinOp::LirMul, 8) >= 1, "the drop address scales the index by the handle's element stride")
  assert(ar_has_load(ar_ptr_loads(d), 0, 8, false), "the drop address chain loads the handle and data words first")
end

# The refusal rows: the accessor families the slice does not carry keep
# their NAMED fail-closed rules.
def ar_map_get_call_fn() -> MirFunction
  ar_mk_fn("map_get_call", Vec::from([
    ar_local(1, "r", ar_vec_ref_ty(), false),
    ar_local(2, "k", Type::Int, true)
  ]), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "r", ar_vec_ref_ty(), false),
    ar_local(2, "k", Type::Int, true)
  ]), Vec::from([
    ar_block(0, Vec::new(), ar_call_term(
      ar_place(0),
      "__intrinsic_map_get".to_string(),
      Vec::from([
        ar_call_arg_read(ar_place(1)),
        ar_call_arg_read(ar_place(2))
      ]),
      Option::Some(IntrinsicId::MapGet),
      1
    )),
    ar_block(1, Vec::new(), ar_ret_term())
  ]))
end

@test
def map_get_intrinsic_stays_fail_closed() -> Unit
  let f = ar_map_get_call_fn()
  match lower_mir_fn_to_lir_prog(f, ar_type_defs(), Map::new(), Map::new(), Set::new(), Map::new(), Map::new())
  when Result::Ok(_) then panic("a Map::get intrinsic call must stay fail-closed (hash/eq function addresses are not carryable)")
  when Result::Err(e) then
    assert(e.contains("hash/eq function addresses"), "the rule names the missing hash/eq address operands, got: " + e)
  end
end

def ar_pop_call_fn() -> MirFunction
  ar_mk_fn("pop_call", Vec::from([ar_local(1, "r", ar_vec_ref_ty(), false)]), Type::Int, Vec::from([
    ar_local(0, "_ret", Type::Int, true),
    ar_local(1, "r", ar_vec_ref_ty(), false)
  ]), Vec::from([
    ar_block(0, Vec::new(), ar_call_term(
      ar_place(0),
      "__intrinsic_array_pop".to_string(),
      Vec::from([ar_call_arg_modify(ar_place(1))]),
      Option::Some(IntrinsicId::ArrayPop),
      1
    )),
    ar_block(1, Vec::new(), ar_ret_term())
  ]))
end

@test
def array_pop_option_result_stays_fail_closed() -> Unit
  let f = ar_pop_call_fn()
  match lower_mir_fn_to_lir_prog(f, ar_type_defs(), Map::new(), Map::new(), Set::new(), Map::new(), Map::new())
  when Result::Ok(_) then panic("the Option-returning Array::pop must stay fail-closed (its Option image construction is not carried)")
  when Result::Err(e) then
    assert(e.contains("Option"), "the rule names the Option result boundary, got: " + e)
  end
end
