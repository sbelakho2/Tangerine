@test
def mixed_class_union_word_lowers_per_class() -> Unit
  let defs = ar_type_defs()
  # B(Int 5): an integer store at byte 8, no bit move.
  let ci = ar_lower(ar_mixed_union_int_construct_fn(), defs)
  ar_verify_clean(ci, "the mixed-class union's Int construction function")
  assert(ar_has_store(ar_ptr_stores(ci), 8, 8), "B's Int stores width 8 at byte 8")
  assert(!ar_has_bitmove(ci, LirBitMoveOp::LirBitsFpToGp), "an integer payload stores without a bit move")
  let di = ar_lower(ar_mixed_union_int_down_fn(), defs)
  ar_verify_clean(di, "the mixed-class union's Int downcast function")
  assert(ar_has_load(ar_ptr_loads(di), 8, 8, true), "B's Int downcast reads sign-extended from byte 8")
  # A(F64 1.5): the same word stores the float bit image through the
  # marked FP->GP move.
  let cf = ar_lower(ar_mixed_union_f64_construct_fn(), defs)
  ar_verify_clean(cf, "the mixed-class union's F64 construction function")
  assert(ar_has_store(ar_ptr_stores(cf), 8, 8), "A's F64 stores width 8 at byte 8")
  assert(ar_has_bitmove(cf, LirBitMoveOp::LirBitsFpToGp), "the float payload crosses FP->GP with the marked bit move")
  let df = ar_lower(ar_mixed_union_f64_down_fn(), defs)
  ar_verify_clean(df, "the mixed-class union's F64 downcast function")
  assert(ar_has_load(ar_ptr_loads(df), 8, 8, false), "A's F64 downcast loads its 8-byte image at byte 8")
  assert(ar_has_bitmove(df, LirBitMoveOp::LirBitsGpToFp), "the float payload read crosses GP->FP with the marked bit move")
end

