def ar_packed_subword_copy_fn() -> MirFunction
  let ty = ar_packed_subword_enum_decl_ty()
  ar_mk_fn("packed_subword_copy", Vec::from([ar_local(1, "e", ty, false)]), Type::Unit, Vec::from([
