@test
def packed_subword_enum_drop_plan_consumes_engine_offsets() -> Unit
  let defs = ar_type_defs()
  var plans: Map[String, DeinitPlan] = Map::new()
  var vmap: Map[Int, (VariantId, Vec[DeinitPlan])] = Map::new()
  vmap.insert(0, (VariantId { owner: TypeId { id: 416 }, index: 0 }, Vec::from([
    DeinitPlan::Call(ar_inst(1))
  ])))
  vmap.insert(1, (VariantId { owner: TypeId { id: 416 }, index: 1 }, Vec::from([
    DeinitPlan::Trivial
  ])))
  plans.insert(mir_type_identity_key(ar_packed_subword_enum_decl_ty()), DeinitPlan::Enum(vmap))
  let f = ar_lower_with_deinit(ar_deinit_fn("packed_subword_drop", ar_packed_subword_enum_decl_ty()), defs, plans, ar_finalizer_names())
  ar_verify_clean(f, "the @packed sub-word enum drop function")
  let (arm0, arm1) = ar_find_disc_switch(f)
  assert(arm0 >= 0 && arm1 >= 0, "the packed enum's drop plan switches on the value word")
  let chain_a = ar_follow_call_order(f, arm0)
  assert(chain_a.len() == 1 && chain_a[0] == "drop_a", "variant A's arm carries its payload finalizer, got " + chain_a.len().to_string())
  assert(ar_has_load(ar_ptr_loads(f), 8, 1, false), "the sub-word payload receiver reads its width-1 image at byte 8")
end

# ———————————————————————————————————————————————————————————————
# 12. THE SIMD VECTOR-FIELD SLICE — a vector-typed aggregate field is
#     a whole 16-byte lane image at the engine's field byte offset
#     (HasVec { a: U8, v: Vec4 } places v at 16). Construction and
#     whole-field reads/writes lower through the marked whole-image
#     LirVecLoad/LirVecStore at the field's frame byte address; a
#     whole-aggregate copy carries the image; a width the route's desc
#     does not model (v256 on aarch64) fails closed at the hosting
#     local.
# ———————————————————————————————————————————————————————————————

@test
def simd_vector_field_admits_and_lowers_whole_image() -> Unit
  let defs = ar_type_defs()
  let shape = ar_shape(defs, ar_has_vec_ty(), "HasVec")
  assert(shape.size == 32, "HasVec { a: U8, v: Vec4 } is 32 bytes, got " + shape.size.to_string())
  assert(shape.fields[1].byte_off == 16 && shape.fields[1].size == 16, "the v128 field sits at the engine's 16-byte offset")
  assert(shape.fields[1].enum_nested == Option::None, "a vector field carries no enum shape")
  # Construction: the vector operand stores its whole image at the
  # field's frame byte address through ONE marked 128-bit LirVecStore.
  let c = ar_lower(ar_vec_field_construct_fn(), defs)
  ar_verify_clean(c, "the vector-field construction function")
  assert(ar_has_bits(ar_vec_stores(c), 128), "the vector field stores ONE 128-bit whole image")
  assert(ar_has_bits(ar_ptr_addrs(c), 16), "the vector field's frame address is base + 16")
  # A whole-field read loads the same image into the destination vector
  # local through ONE marked 128-bit LirVecLoad.
  let r = ar_lower(ar_vec_field_read_fn(), defs)
  ar_verify_clean(r, "the vector-field read function")
  assert(ar_has_bits(ar_vec_loads(r), 128), "the vector field read is ONE 128-bit whole image")
  # A whole-aggregate copy carries the vector field's bytes with the
  # rest of the image.
  let cp = ar_lower(ar_vec_field_copy_fn(), defs)
  ar_verify_clean(cp, "the vector-field aggregate copy function")
end

def ar_vec_field_construct_fn() -> MirFunction
  let vy = ar_vec4_ty()
  let sy = ar_has_vec_ty()
  ar_mk_fn("vec_field_construct", Vec::from([ar_local(1, "v", vy, false)]), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "v", vy, false),
    ar_local(2, "s", sy, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(2), ar_agg_rvalue(
        AggregateKind::Struct(TypeId { id: 421 }, Vec::from(["a".to_string(), "v".to_string()])),
        Vec::from([ar_int_operand(3, Type::U8), ar_copy_operand(ar_place(1))])))
    ]), ar_ret_term())
  ]))
end

def ar_vec_field_read_fn() -> MirFunction
  let vy = ar_vec4_ty()
  let sy = ar_has_vec_ty()
  ar_mk_fn("vec_field_read", Vec::from([ar_local(1, "s", sy, false)]), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "s", sy, false),
    ar_local(2, "w", vy, true),
    ar_local(3, "t", vy, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(2), ar_move_rvalue(ar_copy_operand(ar_field_place(1, 421, 1)))),
      ar_assign_stmt(ar_place(3), ar_move_rvalue(ar_copy_operand(ar_place(2))))
    ]), ar_ret_term())
  ]))
end

def ar_vec_field_copy_fn() -> MirFunction
  let sy = ar_has_vec_ty()
  ar_mk_fn("vec_field_copy", Vec::from([ar_local(1, "s", sy, false)]), Type::Unit, Vec::from([
    ar_local(0, "_ret", Type::Unit, true),
    ar_local(1, "s", sy, false),
    ar_local(2, "t", sy, true)
  ]), Vec::from([
    ar_block(0, Vec::from([
      ar_assign_stmt(ar_place(2), ar_move_rvalue(ar_copy_operand(ar_place(1))))
    ]), ar_ret_term())
