## The GUI software rendering backend behavioral suite — the CPU
## rasterizer (the always-available rendering path): clear, put_pixel,
## fill_rect, frame_rect and blit over the 0xRRGGBBAA pixel buffer.

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::gui::*
use std::test::*

@test
def test_canvas_clear_and_put_pixel() -> Unit
  var canvas = CanvasBuffer::new(8, 8)
  canvas.clear(rgb(255, 0, 0))
  if canvas.pixel_at(0, 0) != rgb(255, 0, 0) then
    panic("clear must fill every pixel")
  end
  if canvas.pixel_at(7, 7) != rgb(255, 0, 0) then
    panic("clear must fill the last pixel too")
  end
  let blue = rgb(0, 0, 255)
  if !canvas.put_pixel(3, 4, blue) then
    panic("put_pixel must succeed in bounds")
  end
  if canvas.pixel_at(3, 4) != blue then
    panic("put_pixel read-back failed")
  end
  if canvas.put_pixel(8, 4, blue) then
    panic("put_pixel must fail out of bounds")
  end
end

@test
def test_canvas_fill_and_frame_rect() -> Unit
  var canvas = CanvasBuffer::new(10, 10)
  let white = rgb(255, 255, 255)
  canvas.fill_rect(2, 2, 6, 6, white)
  if canvas.pixel_at(2, 2) != white then
    panic("fill_rect corner missing")
  end
  if canvas.pixel_at(5, 5) != white then
    panic("fill_rect interior missing")
  end
  if canvas.pixel_at(6, 6) != 0x00000000u32 then
    panic("fill_rect must be exclusive of x1/y1")
  end
  var framed = CanvasBuffer::new(10, 10)
  let red = rgb(255, 0, 0)
  framed.frame_rect(1, 1, 4, 4, red)
  if framed.pixel_at(1, 1) != red then
    panic("frame_rect corner missing")
  end
  if framed.pixel_at(3, 3) != 0x00000000u32 then
    panic("frame_rect must not fill the interior")
  end
end

@test
def test_canvas_blit() -> Unit
  var src = CanvasBuffer::new(2, 2)
  src.clear(rgb(0, 255, 0))
  var dst = CanvasBuffer::new(8, 8)
  dst.blit(&src, 2, 2)
  if dst.pixel_at(2, 2) != rgb(0, 255, 0) then
    panic("blit destination pixel missing")
  end
  if dst.pixel_at(0, 0) != 0x00000000u32 then
    panic("blit must not touch the rest of the destination")
  end
end

@test
def test_rgb_word() -> Unit
  if rgb(0x12, 0x34, 0x56) != 0x123456FFu32 then
    panic("the rgb word must be 0xRRGGBBAA with the alpha set")
  end
end
