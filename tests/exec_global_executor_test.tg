# tests/exec_global_executor_test.tg — the global-executor lazy-init suite
# (reviewer item 15).
#
# THE INVALID DEFAULT (the fix in std/exec.tg): the old
# global_executor() lazy path called init_global_executor(0) — "use
# default" — which built an INVALID zero-thread executor (Executor::new
# rejects a thread count below 1), IGNORED the returned Err, and then
# unwrap()'d the unset global. The fix: the lazy init uses the validated
# default size (the CPU count when positive, the DEFAULT_THREAD_COUNT
# constant otherwise — never 0), the init error PROPAGATES (the panic
# carries the message), and the unwrap is gone.
#
# This file is its own test binary: the module-level GLOBAL_EXECUTOR
# starts None in a fresh process, so the lazy-init path below is
# deterministic.

use std::core::{Option, Result, String, Int, Bool, Unit}
use std::test::*
use std::exec::{spawn_with_result, init_global_executor}

@test
def test_init_global_executor_rejects_zero_threads() -> Unit
  # The invalid size (0) is rejected with the error — the same
  # validation every Executor::new applies (the old global_executor
  # "default" of 0 was invalid, and its Err was ignored).
  let err = assert_err(init_global_executor(0))
  assert_contains(err, "at least 1")
end

@test
def test_global_executor_lazy_init_valid_default_runs_tasks() -> Unit
  # The lazy init uses the validated default size — never 0 — and the
  # spawned task really runs to completion on the global executor (the
  # join is terminal).
  let handle = spawn_with_result(move || { 42 })
  match handle.join()
  when Option::Some(v) then assert_eq(v, 42)
  when Option::None then panic("global executor: the task did not complete")
  end
end
