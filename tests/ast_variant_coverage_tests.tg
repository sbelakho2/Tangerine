# tests/ast_variant_coverage_tests.tg — the AST variant coverage suite
# (the coverage oracle for tg_compiler/ast.tg's StmtKind / ExprKind /
# TypeExprKind variant universes — oracle #3).
#
# EVERY variant is exercised by a POSITIVE specimen:
#   - the source-producible variants live INLINE in this file as real,
#     type-correct specimen functions (the `# ast-variant: <Name>` markers
#     sit immediately above the construct that produces the variant, and
#     `tg check` on this file is the compile-positive proof);
#   - the parse-only statements (StmtTry / StmtWith / StmtHandleWith —
#     they parse and the AST keeps them, but the pipeline REJECTS them at
#     MIR lowering by design: "exceptions are not supported — no throwing
#     path may bypass teardown") are exercised at the parse level (a
#     snippet with zero parse errors whose AST contains the variant);
#   - the variants with NO source producer (ExprAssign and ExprError —
#     macro-expansion-only AST forms; TypeExprKind::Never and
#     TypeExprKind::Effect — no parser construction site) are CONSTRUCTED
#     by hand and round-tripped through the kind-name functions.
#
# The in-process oracle test (test_ast_variants_present_in_own_source)
# reads THIS file's own source, parses it (asserting zero parse errors and
# zero type errors — the compile-positive proof IN PROCESS), walks the AST
# with the collector below, and asserts every source-producible variant of
# the three enums appears. The kind-name functions are EXHAUSTIVE (no
# default arm): a variant missing from them is a compile error, so the
# enumeration can never drift from tg_compiler/ast.tg.
#
# The coverage oracle (scripts/check_variant_coverage.sh --domain ast)
# scans this file for the marker + construct fingerprints per variant.
#
# Run with the repo root as the working directory:
#   tg test tests/ast_variant_coverage_tests.tg

use std::core::Option
use std::collections::{Vec}
use std::test::*
use std::fs::{read_to_string}
use std::async::{Executor, Duration, sleep}

use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse}
use tg_compiler::token::{span_dummy}
use tg_compiler::ast::{
  Program, Item, ItemKind, FnBody, ExternItem, Block, Stmt, StmtKind,
  Expr, ExprKind, TypeExpr, TypeExprKind, IfStmt, ForStmt, MatchExpr,
  MatchArm, CatchArm
}
use tg_compiler::types::{type_check}

# ———————————————————————————————————————————————————————————————
# The exhaustive kind-name functions — every arm names the variant it
# handles; the compiler's exhaustiveness check fails the build if any
# variant is missing, so the enumeration IS tg_compiler/ast.tg's.
# ———————————————————————————————————————————————————————————————

def stmt_kind_name(kind: StmtKind) -> String
  match kind
  when StmtKind::StmtLet(_, _, _, _) then "StmtLet"
  when StmtKind::StmtAssign(_, _) then "StmtAssign"
  when StmtKind::StmtCompoundAssign(_, _, _) then "StmtCompoundAssign"
  when StmtKind::StmtIf(_) then "StmtIf"
  when StmtKind::StmtMatch(_) then "StmtMatch"
  when StmtKind::StmtWhile(_, _) then "StmtWhile"
  when StmtKind::StmtFor(_) then "StmtFor"
  when StmtKind::StmtLoop(_) then "StmtLoop"
  when StmtKind::StmtReturn(_) then "StmtReturn"
  when StmtKind::StmtBreak(_) then "StmtBreak"
  when StmtKind::StmtContinue then "StmtContinue"
  when StmtKind::StmtExpr(_) then "StmtExpr"
  when StmtKind::StmtUnsafe(_, _) then "StmtUnsafe"
  when StmtKind::StmtDefer(_) then "StmtDefer"
  when StmtKind::StmtGuard(_, _) then "StmtGuard"
  when StmtKind::StmtTry(_, _, _) then "StmtTry"
  when StmtKind::StmtWith(_, _, _) then "StmtWith"
  when StmtKind::StmtHandleWith(_, _) then "StmtHandleWith"
  end
end

def expr_kind_name(kind: ExprKind) -> String
  match kind
  when ExprKind::ExprIntLit(_) then "ExprIntLit"
  when ExprKind::ExprFloatLit(_) then "ExprFloatLit"
  when ExprKind::ExprStringLit(_) then "ExprStringLit"
  when ExprKind::ExprCharLit(_) then "ExprCharLit"
  when ExprKind::ExprBoolLit(_) then "ExprBoolLit"
  when ExprKind::ExprNilLit then "ExprNilLit"
  when ExprKind::ExprArrayLit(_) then "ExprArrayLit"
  when ExprKind::ExprTupleLit(_) then "ExprTupleLit"
  when ExprKind::ExprStructLit(_, _) then "ExprStructLit"
  when ExprKind::ExprMapLit(_) then "ExprMapLit"
  when ExprKind::ExprIdent(_) then "ExprIdent"
  when ExprKind::ExprPath(_) then "ExprPath"
  when ExprKind::ExprSelfRef then "ExprSelfRef"
  when ExprKind::ExprBinaryOp(_, _, _) then "ExprBinaryOp"
  when ExprKind::ExprUnaryOp(_, _) then "ExprUnaryOp"
  when ExprKind::ExprFieldAccess(_, _) then "ExprFieldAccess"
  when ExprKind::ExprMethodCall(_, _, _, _) then "ExprMethodCall"
  when ExprKind::ExprIndex(_, _) then "ExprIndex"
  when ExprKind::ExprCall(_, _) then "ExprCall"
  when ExprKind::ExprClosure(_, _, _) then "ExprClosure"
  when ExprKind::ExprAccess(_) then "ExprAccess"
  when ExprKind::ExprRawDeref(_) then "ExprRawDeref"
  when ExprKind::ExprIf(_) then "ExprIf"
  when ExprKind::ExprMatch(_) then "ExprMatch"
  when ExprKind::ExprBlock(_) then "ExprBlock"
  when ExprKind::ExprUnsafe(_, _) then "ExprUnsafe"
  when ExprKind::ExprAsync(_) then "ExprAsync"
  when ExprKind::ExprAwait(_) then "ExprAwait"
  when ExprKind::ExprTry(_) then "ExprTry"
  when ExprKind::ExprRange(_, _, _) then "ExprRange"
  when ExprKind::ExprCast(_, _) then "ExprCast"
  when ExprKind::ExprTypeCheck(_, _) then "ExprTypeCheck"
  when ExprKind::ExprComptime(_) then "ExprComptime"
  when ExprKind::ExprEnumVariant(_, _) then "ExprEnumVariant"
  when ExprKind::ExprAssign(_, _) then "ExprAssign"
  when ExprKind::ExprPipe(_, _) then "ExprPipe"
  when ExprKind::ExprMacroCall(_, _) then "ExprMacroCall"
  when ExprKind::ExprError(_) then "ExprError"
  end
end

def type_expr_kind_name(kind: TypeExprKind) -> String
  match kind
  when TypeExprKind::Named(_, _) then "Named"
  when TypeExprKind::Unit then "Unit"
  when TypeExprKind::Never then "Never"
  when TypeExprKind::Tuple(_) then "Tuple"
  when TypeExprKind::Array(_, _) then "Array"
  when TypeExprKind::Slice(_) then "Slice"
  when TypeExprKind::Ptr(_) then "Ptr"
  when TypeExprKind::PtrMut(_) then "PtrMut"
  when TypeExprKind::Ref(_, _) then "Ref"
  when TypeExprKind::Fn(_, _) then "Fn"
  when TypeExprKind::Async(_) then "Async"
  when TypeExprKind::Effect(_, _) then "Effect"
  when TypeExprKind::Path(_) then "Path"
  when TypeExprKind::Infer then "Infer"
  end
end

# ———————————————————————————————————————————————————————————————
# The AST collector — walks a parsed Program and collects the kind name of
# every Stmt / Expr / TypeExpr node (the walk mirrors the compiler's
# assign_node_ids traversal, ast.tg).
# ———————————————————————————————————————————————————————————————

def collect_type_expr(inout te: TypeExpr, inout out: Vec[String]) -> Unit
  out.push(type_expr_kind_name(te.kind))
  match te.kind
  when TypeExprKind::Named(_, args) then
    mut i = 0
    while i < args.len() do
      collect_type_expr(&mut args[i], out)
      i = i + 1
    end
  when TypeExprKind::Tuple(ts) then
    mut i = 0
    while i < ts.len() do
      collect_type_expr(&mut ts[i], out)
      i = i + 1
    end
  when TypeExprKind::Array(inner, _) then
    collect_type_expr(&mut inner, out)
  when TypeExprKind::Slice(inner) then
    collect_type_expr(&mut inner, out)
  when TypeExprKind::Ptr(inner) then
    collect_type_expr(&mut inner, out)
  when TypeExprKind::PtrMut(inner) then
    collect_type_expr(&mut inner, out)
  when TypeExprKind::Ref(inner, _) then
    collect_type_expr(&mut inner, out)
  when TypeExprKind::Fn(params, ret) then
    mut i = 0
    while i < params.len() do
      collect_type_expr(&mut params[i].ty, out)
      i = i + 1
    end
    collect_type_expr(&mut ret, out)
  when TypeExprKind::Async(inner) then
    collect_type_expr(&mut inner, out)
  when TypeExprKind::Effect(_, inner) then
    collect_type_expr(&mut inner, out)
  when _ then ()
  end
end

def collect_opt_type(inout ty: Option[TypeExpr], inout out: Vec[String]) -> Unit
  match ty
  when Option::Some(te) then collect_type_expr(&mut te, out)
  when Option::None then ()
  end
end

def collect_expr(inout e: Expr, inout out: Vec[String]) -> Unit
  out.push(expr_kind_name(e.kind))
  match e.kind
  when ExprKind::ExprArrayLit(elems) then
    mut i = 0
    while i < elems.len() do
      collect_expr(&mut elems[i], out)
      i = i + 1
    end
  when ExprKind::ExprTupleLit(elems) then
    mut i = 0
    while i < elems.len() do
      collect_expr(&mut elems[i], out)
      i = i + 1
    end
  when ExprKind::ExprStructLit(_, fields) then
    mut i = 0
    while i < fields.len() do
      collect_expr(&mut fields[i].1, out)
      i = i + 1
    end
  when ExprKind::ExprMapLit(entries) then
    mut i = 0
    while i < entries.len() do
      collect_expr(&mut entries[i].0, out)
      collect_expr(&mut entries[i].1, out)
      i = i + 1
    end
  when ExprKind::ExprBinaryOp(_, lhs, rhs) then
    collect_expr(&mut lhs, out)
    collect_expr(&mut rhs, out)
  when ExprKind::ExprUnaryOp(_, operand) then
    collect_expr(&mut operand, out)
  when ExprKind::ExprFieldAccess(base, _) then
    collect_expr(&mut base, out)
  when ExprKind::ExprMethodCall(recv, _, _, args) then
    collect_expr(&mut recv, out)
    mut i = 0
    while i < args.len() do
      collect_expr(&mut args[i], out)
      i = i + 1
    end
  when ExprKind::ExprIndex(base, index) then
    collect_expr(&mut base, out)
    collect_expr(&mut index, out)
  when ExprKind::ExprCall(callee, args) then
    collect_expr(&mut callee, out)
    mut i = 0
    while i < args.len() do
      collect_expr(&mut args[i], out)
      i = i + 1
    end
  when ExprKind::ExprClosure(params, _, body) then
    mut i = 0
    while i < params.len() do
      collect_opt_type(&mut params[i].ty, out)
      i = i + 1
    end
    collect_expr(&mut body, out)
  when ExprKind::ExprAccess(inner) then
    collect_expr(&mut inner, out)
  when ExprKind::ExprRawDeref(inner) then
    collect_expr(&mut inner, out)
  when ExprKind::ExprIf(if_stmt) then
    collect_if(if_stmt, out)
  when ExprKind::ExprMatch(m) then
    collect_match(m, out)
  when ExprKind::ExprBlock(block) then
    collect_block(block, out)
  when ExprKind::ExprUnsafe(_, block) then
    collect_block(block, out)
  when ExprKind::ExprAsync(block) then
    collect_block(block, out)
  when ExprKind::ExprAwait(inner) then
    collect_expr(&mut inner, out)
  when ExprKind::ExprTry(inner) then
    collect_expr(&mut inner, out)
  when ExprKind::ExprRange(start, end_, _) then
    match start
    when Option::Some(s) then collect_expr(&mut s, out)
    when Option::None then ()
    end
    match end_
    when Option::Some(e) then collect_expr(&mut e, out)
    when Option::None then ()
    end
  when ExprKind::ExprCast(inner, ty) then
    collect_expr(&mut inner, out)
    collect_type_expr(&mut ty, out)
  when ExprKind::ExprTypeCheck(inner, ty) then
    collect_expr(&mut inner, out)
    collect_type_expr(&mut ty, out)
  when ExprKind::ExprComptime(block) then
    collect_block(block, out)
  when ExprKind::ExprEnumVariant(_, args) then
    mut i = 0
    while i < args.len() do
      collect_expr(&mut args[i], out)
      i = i + 1
    end
  when ExprKind::ExprAssign(target, value) then
    collect_expr(&mut target, out)
    collect_expr(&mut value, out)
  when ExprKind::ExprPipe(lhs, rhs) then
    collect_expr(&mut lhs, out)
    collect_expr(&mut rhs, out)
  when ExprKind::ExprMacroCall(_, args) then
    mut i = 0
    while i < args.len() do
      collect_expr(&mut args[i], out)
      i = i + 1
    end
  when _ then ()
  end
end

def collect_if(inout if_stmt: IfStmt, inout out: Vec[String]) -> Unit
  collect_expr(&mut if_stmt.cond, out)
  collect_block(&mut if_stmt.then_block, out)
  mut i = 0
  while i < if_stmt.elsif_branches.len() do
    collect_expr(&mut if_stmt.elsif_branches[i].0, out)
    collect_block(&mut if_stmt.elsif_branches[i].1, out)
    i = i + 1
  end
  match if_stmt.else_block
  when Option::Some(b) then collect_block(&mut b, out)
  when Option::None then ()
  end
end

def collect_match(inout m: MatchExpr, inout out: Vec[String]) -> Unit
  collect_expr(&mut m.scrutinee, out)
  mut i = 0
  while i < m.arms.len() do
    match m.arms[i].guard_expr
    when Option::Some(g) then collect_expr(&mut g, out)
    when Option::None then ()
    end
    collect_block(&mut m.arms[i].body, out)
    i = i + 1
  end
end

def collect_stmt(inout stmt: Stmt, inout out: Vec[String]) -> Unit
  out.push(stmt_kind_name(stmt.kind))
  match stmt.kind
  when StmtKind::StmtLet(_, ty, value, _) then
    collect_opt_type(&mut ty, out)
    collect_expr(&mut value, out)
  when StmtKind::StmtAssign(target, value) then
    collect_expr(&mut target, out)
    collect_expr(&mut value, out)
  when StmtKind::StmtCompoundAssign(_, target, value) then
    collect_expr(&mut target, out)
    collect_expr(&mut value, out)
  when StmtKind::StmtIf(if_stmt) then
    collect_if(if_stmt, out)
  when StmtKind::StmtMatch(m) then
    collect_match(m, out)
  when StmtKind::StmtWhile(cond, body) then
    collect_expr(&mut cond, out)
    collect_block(body, out)
  when StmtKind::StmtFor(for_stmt) then
    collect_expr(&mut for_stmt.iter, out)
    collect_block(&mut for_stmt.body, out)
  when StmtKind::StmtLoop(body) then
    collect_block(body, out)
  when StmtKind::StmtReturn(val_opt) then
    match val_opt
    when Option::Some(v) then collect_expr(&mut v, out)
    when Option::None then ()
    end
  when StmtKind::StmtBreak(val_opt) then
    match val_opt
    when Option::Some(v) then collect_expr(&mut v, out)
    when Option::None then ()
    end
  when StmtKind::StmtContinue then ()
  when StmtKind::StmtExpr(e) then
    collect_expr(&mut e, out)
  when StmtKind::StmtUnsafe(_, block) then
    collect_block(block, out)
  when StmtKind::StmtDefer(block) then
    collect_block(block, out)
  when StmtKind::StmtGuard(cond, _) then
    collect_expr(&mut cond, out)
  when StmtKind::StmtTry(body, catches, finally_opt) then
    collect_block(body, out)
    mut i = 0
    while i < catches.len() do
      collect_block(&mut catches[i].body, out)
      i = i + 1
    end
    match finally_opt
    when Option::Some(b) then collect_block(&mut b, out)
    when Option::None then ()
    end
  when StmtKind::StmtWith(expr, _, body) then
    collect_expr(&mut expr, out)
    collect_block(body, out)
  when StmtKind::StmtHandleWith(expr, _) then
    collect_expr(&mut expr, out)
  end
end

def collect_block(inout block: Block, inout out: Vec[String]) -> Unit
  mut i = 0
  while i < block.stmts.len() do
    collect_stmt(&mut block.stmts[i], out)
    i = i + 1
  end
end

def collect_fn_params(inout f: FunctionDecl, inout out: Vec[String]) -> Unit
  mut i = 0
  while i < f.params.len() do
    collect_opt_type(&mut f.params[i].ty, out)
    i = i + 1
  end
end

def collect_fn(inout f: FunctionDecl, inout out: Vec[String]) -> Unit
  collect_fn_params(f, out)
  match f.ret_type
  when Option::Some(ty) then collect_type_expr(&mut ty, out)
  when Option::None then ()
  end
  match f.body
  when FnBody::FnBlock(b) then collect_block(b, out)
  when FnBody::FnExpr(e) then collect_expr(e, out)
  when _ then ()
  end
end

def collect_item(inout item: Item, inout out: Vec[String]) -> Unit
  match item.kind
  when ItemKind::ItemFunction(f) then
    collect_fn(f, out)
  when ItemKind::ItemStruct(s) then
    mut i = 0
    while i < s.fields.len() do
      collect_type_expr(&mut s.fields[i].ty, out)
      i = i + 1
    end
    i = 0
    while i < s.methods.len() do
      collect_fn(&mut s.methods[i], out)
      i = i + 1
    end
  when ItemKind::ItemEnum(e) then
    mut i = 0
    while i < e.variants.len() do
      mut j = 0
      while j < e.variants[i].fields.len() do
        collect_type_expr(&mut e.variants[i].fields[j], out)
        j = j + 1
      end
      i = i + 1
    end
  when ItemKind::ItemTrait(t) then
    mut i = 0
    while i < t.methods.len() do
      match t.methods[i].sig.ret_type
      when Option::Some(ty) then collect_type_expr(&mut ty, out)
      when Option::None then ()
      end
      match t.methods[i].default_body
      when FnBody::FnBlock(b) then collect_block(b, out)
      when FnBody::FnExpr(e) then collect_expr(e, out)
      when _ then ()
      end
      i = i + 1
    end
  when ItemKind::ItemImpl(im) then
    collect_type_expr(&mut im.for_type, out)
    collect_type_expr(&mut im.self_type, out)
    mut i = 0
    while i < im.methods.len() do
      collect_fn(&mut im.methods[i], out)
      i = i + 1
    end
  when ItemKind::ItemModule(m) then
    mut i = 0
    while i < m.items.len() do
      collect_item(&mut m.items[i], out)
      i = i + 1
    end
  when ItemKind::ItemMacro(mac) then
    collect_block(&mut mac.body, out)
  when ItemKind::ItemConst(c) then
    collect_expr(&mut c.value, out)
  when ItemKind::ItemStatic(s) then
    collect_expr(&mut s.value, out)
  when ItemKind::ItemExternBlock(ext) then
    mut i = 0
    while i < ext.items.len() do
      match ext.items[i]
      when ExternItem::Function(ef) then
        mut j = 0
        while j < ef.params.len() do
          collect_opt_type(&mut ef.params[j].ty, out)
          j = j + 1
        end
      when ExternItem::Static(_) then ()
      end
      i = i + 1
    end
  when _ then ()
  end
end

def collect_program(inout program: Program, inout out: Vec[String]) -> Unit
  mut i = 0
  while i < program.items.len() do
    collect_item(&mut program.items[i], out)
    i = i + 1
  end
end

def kinds_contain(kinds: Vec[String], needle: String) -> Bool
  for k in kinds do
    if k == needle then
      return true
    end
  end
  false
end

def missing_kinds(kinds: Vec[String], expected: Vec[String]) -> Vec[String]
  var missing: Vec[String] = Vec::new()
  for e in expected do
    if !kinds_contain(kinds, e) then
      missing.push(e)
    end
  end
  missing
end

# ———————————————————————————————————————————————————————————————
# The inline specimen functions — the positive programs that PRODUCE the
# variants. The `# ast-variant: <Name>` marker sits directly above the
# construct that produces it (the fingerprint the oracle scans for).
# ———————————————————————————————————————————————————————————————

def observe(x: Int) -> Int
  x
end

# ast-variant: ExprIntLit
# ast-variant: ExprFloatLit
# ast-variant: ExprStringLit
# ast-variant: ExprCharLit
# ast-variant: ExprBoolLit
# ast-variant: ExprNilLit
def specimen_literals() -> Int
  let a = 42
  let b = 3.5
  let c = "abc"
  let d = 'x'
  let e = true
  let f = nil
  if e then a else 0 end
end

# ast-variant: ExprArrayLit
# ast-variant: ExprTupleLit
# ast-variant: ExprMapLit
def specimen_collections() -> Int
  let arr = [1, 2, 3]
  let tup = (1, "a")
  let mp = { "k" => 1 }
  arr[0] + tup.0 + mp.len()
end

struct Point
  x: Int
  y: Int
end

impl Point
  # ast-variant: ExprSelfRef
  def double(self: Point) -> Int
    self.x * 2
  end
end

# ast-variant: ExprStructLit
# ast-variant: ExprFieldAccess
# ast-variant: ExprMethodCall
# ast-variant: ExprIndex
def specimen_members() -> Int
  let p = Point { x: 1, y: 2 }
  let fx = p.x
  let items = [10, 20]
  let ix = items[1]
  let s = "hello".to_string()
  let ln = s.len()
  fx + ix + ln
end

module probe_mod
  def probe_fn(x: Int) -> Int
    x
  end
end

# ast-variant: ExprIdent
# ast-variant: ExprBinaryOp
# ast-variant: ExprUnaryOp
# ast-variant: ExprCall
# ast-variant: ExprPath
def specimen_ops() -> Int
  let base = 5
  let sum = base + 2
  let neg = -base
  let inv = !false
  let bits = ~3
  let called = observe(4)
  let f = probe_mod::probe_fn
  let via_path = f(3)
  if inv then sum + neg + bits + called + via_path else 0 end
end

# ast-variant: ExprClosure
# ast-variant: ExprPipe
def specimen_closure_pipe() -> Int
  let f = |x: Int| x * 2
  let v = 3 |> f
  v
end

# ast-variant: ExprAccess
# ast-variant: ExprRawDeref
def specimen_access_deref() -> Int
  var counter = 3
  let via_marker = observe(&counter)
  let p = Ptr::null()
  let raw = *p
  via_marker + raw
end

# ast-variant: ExprIf
# ast-variant: ExprMatch
# ast-variant: ExprBlock
def specimen_control_values() -> Int
  let a = if true then 1 else 2 end
  let b = match a
    when 1 then 10
    when _ then 20
  end
  let c = do 3 end
  a + b + c
end

# ast-variant: ExprUnsafe
# ast-variant: ExprAsync
# ast-variant: ExprAwait
# ast-variant: ExprComptime
def specimen_blocks() -> Int
  let u = unsafe do 1 end
  let c = comptime do 2 end
  let e = Executor::new(1)
  e.spawn(async {
    sleep(Duration::from_millis(1)).await
    7
  })
  e.run()
  u + c
end

# ast-variant: ExprTry
def specimen_try() -> Int
  let v = observe(3)?
  v
end

# ast-variant: ExprCast
# ast-variant: ExprTypeCheck
# ast-variant: ExprEnumVariant
# ast-variant: ExprMacroCall
def specimen_type_ops() -> Int
  let f = 3.5 as Int
  let ok = f is Int
  let o = Option::Some(1)
  let m = mtwo!(5)
  if ok then f + o + m else 0 end
end

# ast-variant: StmtLet
# ast-variant: ExprRange
def specimen_let() -> Int
  let a = 1
  var b = 2
  let mut c = 3
  let d: Int = 4
  a + b + c + d
end

# ast-variant: StmtAssign
def specimen_assign() -> Int
  var x = 0
  x = 5
  x
end

# ast-variant: StmtCompoundAssign
def specimen_compound_assign() -> Int
  var x = 1
  x += 2
  x *= 2
  x
end

# ast-variant: StmtIf
def specimen_if(x: Int) -> Int
  var out = 0
  if x > 0 then
    out = 1
  elsif x < -1 then
    out = 2
  else
    out = 3
  end
  out
end

# ast-variant: StmtMatch
def specimen_match(n: Int) -> Int
  var out = 0
  match n
  when 0 then out = 10
  when _ then out = 20
  end
  out
end

# ast-variant: StmtWhile
def specimen_while() -> Int
  var i = 0
  while i < 3 do
    i = i + 1
  end
  i
end

# ast-variant: StmtFor
def specimen_for() -> Int
  var total = 0
  for i in 0..3 do
    total = total + i
  end
  total
end

# ast-variant: StmtLoop
def specimen_loop() -> Int
  var i = 0
  loop do
    i = i + 1
    if i >= 3 then break end
  end
  i
end

# ast-variant: StmtReturn
def specimen_return(x: Int) -> Int
  return x
end

# ast-variant: StmtBreak
# ast-variant: StmtContinue
def specimen_break_next() -> Int
  var total = 0
  var i = 0
  loop do
    i = i + 1
    if i == 2 then next end
    if i > 3 then break end
    total = total + i
  end
  total
end

# ast-variant: StmtExpr
def specimen_expr_stmt() -> Int
  observe(1)
  0
end

# ast-variant: StmtUnsafe
def specimen_unsafe() -> Int
  unsafe do
    1
  end
  0
end

# ast-variant: StmtDefer
def specimen_defer() -> Int
  var x = 0
  defer do
    x = x + 1
  end
  x
end

# ast-variant: StmtGuard
def specimen_guard(x: Int) -> Int
  guard x > 0 else return 0
  guard x < 100 else panic("bad")
  x
end

# ast-variant: Named
# ast-variant: Unit
# ast-variant: Tuple
# ast-variant: Slice
# ast-variant: Ptr
# ast-variant: PtrMut
# ast-variant: Fn
# ast-variant: Async
# ast-variant: Path
# ast-variant: Infer
def specimen_types(p: (Int, Int), q: [Int], r: *Int, s: *mut Int,
                   g: fn(Int) -> Int, a: async Int, t: probe_mod::ProbeStruct) -> ()
  let named: Int = 1
  let inferred: _ = 2
  let fixed: [Int; 3] = [1, 2, 3]
  ()
end

extern def __intrinsic_ast_probe(x: &Int) -> Int end

# ast-variant: TypeExprRef
def specimen_ref() -> Int
  __intrinsic_ast_probe(&1)
end

macro mtwo(x: Expr)
  (x + 1)
end

# ———————————————————————————————————————————————————————————————
# The oracle tests
# ———————————————————————————————————————————————————————————————

# The 63 source-producible variant names (the full enumeration minus the
# parse-only statements and the no-source-producer forms, which have their
# own tests below). The exhaustive name functions keep this list pinned to
# tg_compiler/ast.tg's enums: a variant added to an enum but missing from
# the name function is a compile error, and a variant in the name function
# but not in this list fails this assertion.
@test
def test_ast_variants_present_in_own_source() -> Unit
  let expected = [
    # StmtKind (15 source-producible)
    "StmtLet", "StmtAssign", "StmtCompoundAssign", "StmtIf", "StmtMatch",
    "StmtWhile", "StmtFor", "StmtLoop", "StmtReturn", "StmtBreak",
    "StmtContinue", "StmtExpr", "StmtUnsafe", "StmtDefer", "StmtGuard",
    # ExprKind (36 source-producible)
    "ExprIntLit", "ExprFloatLit", "ExprStringLit", "ExprCharLit",
    "ExprBoolLit", "ExprNilLit", "ExprArrayLit", "ExprTupleLit",
    "ExprStructLit", "ExprMapLit", "ExprIdent", "ExprPath", "ExprSelfRef",
    "ExprBinaryOp", "ExprUnaryOp", "ExprFieldAccess", "ExprMethodCall",
    "ExprIndex", "ExprCall", "ExprClosure", "ExprAccess", "ExprRawDeref",
    "ExprIf", "ExprMatch", "ExprBlock", "ExprUnsafe", "ExprAsync",
    "ExprAwait", "ExprTry", "ExprRange", "ExprCast", "ExprTypeCheck",
    "ExprComptime", "ExprEnumVariant", "ExprPipe", "ExprMacroCall",
    # TypeExprKind (12 source-producible)
    "Named", "Unit", "Tuple", "Array", "Slice", "Ptr", "PtrMut", "Ref",
    "Fn", "Async", "Path", "Infer"
  ]
  match read_to_string("tests/ast_variant_coverage_tests.tg")
  when Result::Ok(content) then
    let lexed = tokenize(content, "ast_variant_coverage_tests.tg")
    let parsed = parse(lexed)
    assert(parsed.diagnostics.len() == 0,
      "the specimen file must parse cleanly: " + parsed.diagnostics.len().to_string() + " diagnostics")
    var program = parsed.program
    let errs = type_check(program)
    assert(errs.len() == 0,
      "the specimen file must type-check cleanly (the compile-positive proof): " + errs.len().to_string() + " errors")
    var kinds: Vec[String] = Vec::new()
    collect_program(&mut program, &mut kinds)
    let missing = missing_kinds(kinds, expected)
    assert(missing.is_empty(),
      "the AST of this file is missing variants: " + missing.join(", "))
  when Result::Err(e) then
    assert(false, "cannot read tests/ast_variant_coverage_tests.tg: " + e.to_string())
  end
end

# The parse-only statements — they parse and the AST keeps them (positive
# at the parse level), while the pipeline REJECTS them at MIR lowering by
# design (no throwing path may bypass teardown). Each snippet must parse
# with zero diagnostics and contain the variant.
def parse_snippet(body: String, file: String) -> Vec[String]
  let src = "def main() -> Int\n  " + body + "\n  0\nend\n"
  let lexed = tokenize(src, file)
  let parsed = parse(lexed)
  var program = parsed.program
  var kinds: Vec[String] = Vec::new()
  collect_program(&mut program, &mut kinds)
  kinds
end

@test
def test_parse_only_statement_variants() -> Unit
  let try_kinds = parse_snippet(
    "try do\n    1\n  catch _ do\n    2\n  finally do\n    3\n  end\n", "ast_try.tg")
  assert(kinds_contain(try_kinds, "StmtTry"),
    "StmtTry must appear in the parsed AST of a try/catch/finally program")

  let with_kinds = parse_snippet(
    "with 1 do x\n    x\n  end\n", "ast_with.tg")
  assert(kinds_contain(with_kinds, "StmtWith"),
    "StmtWith must appear in the parsed AST of a with program")

  let handle_kinds = parse_snippet(
    "handle 1 with op do\n    x\n  end\n", "ast_handle.tg")
  assert(kinds_contain(handle_kinds, "StmtHandleWith"),
    "StmtHandleWith must appear in the parsed AST of a handle program")
end

# The no-source-producer forms — constructed by hand and round-tripped
# through the kind-name functions (a value of the variant BUILT by the
# test, named, and matched).
@test
def test_unit_constructed_variants() -> Unit
  # ExprAssign — the macro-expansion-only assignment expression form.
  let lhs = Expr { kind: ExprKind::ExprIntLit(1), span: span_dummy(), node_id: 0 }
  let rhs = Expr { kind: ExprKind::ExprIntLit(2), span: span_dummy(), node_id: 0 }
  let assign = Expr {
    kind: ExprKind::ExprAssign(Box::new(lhs), Box::new(rhs)),
    span: span_dummy(),
    node_id: 0
  }
  assert(expr_kind_name(assign.kind) == "ExprAssign", "ExprAssign kind identity")

  # ExprError — the macro-expansion failure sentinel.
  let err = Expr { kind: ExprKind::ExprError("probe".to_string()), span: span_dummy(), node_id: 0 }
  assert(expr_kind_name(err.kind) == "ExprError", "ExprError kind identity")

  # TypeExprKind::Never — no parser construction site (types.tg resolves
  # it to Type::Never; driver.tg/formatter.tg render it).
  let never = TypeExpr { kind: TypeExprKind::Never, span: span_dummy() }
  assert(type_expr_kind_name(never.kind) == "Never", "TypeExprKind::Never identity")

  # TypeExprKind::Effect — no parser construction site (the checker
  # resolves the effect-type expression from the registry).
  let inner = TypeExpr { kind: TypeExprKind::Named("Int".to_string(), Vec::new()), span: span_dummy() }
  let effect = TypeExpr { kind: TypeExprKind::Effect("Io".to_string(), inner), span: span_dummy() }
  assert(type_expr_kind_name(effect.kind) == "Effect", "TypeExprKind::Effect identity")
end
