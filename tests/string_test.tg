use std::io::{print, println}

def greet(name: String) -> String
  "Hello, " + name + "!"
end

def main() -> Int
  let msg = greet("Tangerine")
  println(msg)
  
  let a = "foo"
  let b = "bar"
  let c = a + b
  println(c)
  
  print("3 + 4 = ")
  let sum = 3 + 4
  if sum == 7 then
    println("7")
  else
    println("wrong")
  end
  
  0
end
