use std::io::{print, println}

enum Color
  Red
  Green
  Blue
end

struct Point
  x: Int
  y: Int
end

struct Rect
  origin: Point
  width: Int
  height: Int
end

impl Point
  def manhattan(&self) -> Int
    self.x + self.y
  end

  def add(&self, other: &Point) -> Point
    Point { x: self.x + other.x, y: self.y + other.y }
  end
end

impl Rect
  def area(&self) -> Int
    self.width * self.height
  end
end

def color_name(c: Color) -> String
  match c
  when Color::Red then "Red"
  when Color::Green then "Green"
  when Color::Blue then "Blue"
  end
end

def main() -> Int
  # Test struct creation
  let p = Point { x: 3, y: 4 }
  let q = Point { x: 10, y: 20 }

  # Test field access
  print("p.x = ")
  println(p.x.to_string())
  print("p.y = ")
  println(p.y.to_string())

  # Test method call
  let m = p.manhattan()
  print("manhattan = ")
  println(m.to_string())

  # Test method returning struct
  let r = p.add(&q)
  print("r.x = ")
  println(r.x.to_string())
  print("r.y = ")
  println(r.y.to_string())

  # Test nested struct
  let rect = Rect { origin: p, width: 5, height: 10 }
  let a = rect.area()
  print("area = ")
  println(a.to_string())

  # Test enum
  let c = Color::Green
  print("color = ")
  println(color_name(c))

  # Test result via exit code
  if m == 7 && a == 50 then
    0
  else
    1
  end
end
