# tests/channel_stream_wake_test.tg — the ChannelStream's wake
# registration (reviewer item 9): the poll_next's Pending delegates to
# the real RecvFuture STORED in the stream state — the future's poll
# registers the waker in the channel's receiver-waiter list exactly
# once (the waiter_id guard). A poll_next NEVER returns Pending without
# a live registration, and a repeated Pending poll never duplicates it.
# The data arrives: the send wakes the registered waiter (the entry is
# popped), and the stream's next poll delivers the item.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::async::{AsyncIterator, Future, Waker, Context, Poll}

@test
def test_channel_stream_pending_registers_recv_waiter() -> Unit
  mut exec = std::async::executor_new()
  let (tx, rx) = std::async::channel(2)
  let mut stream = std::async::channel_stream(rx)
  let waker = Waker { task_id: 303, executor: exec.inner.clone() }
  let mut cx = Context { waker: waker }

  # THE REGISTRATION: the Pending went through the stream's stored
  # RecvFuture — exactly one recv waiter, carrying the poll's waker
  match stream.poll_next(&mut cx)
  when Poll::Pending then ()
  when _ then assert_false(true)
  end
  let ch = tx.inner.ptr.as_ref()
  assert_eq(ch.recv_waiters.len(), 1)
  assert_eq(ch.recv_waiters[0].waker.task_id, 303)

  # a second Pending poll (an unrelated re-poll) never duplicates the
  # registration — the stored RecvFuture's waiter_id guard holds
  match stream.poll_next(&mut cx)
  when Poll::Pending then ()
  when _ then assert_false(true)
  end
  assert_eq(tx.inner.ptr.as_ref().recv_waiters.len(), 1)

  # the data arrives: the send wakes the registered waiter (the entry
  # is popped from the receiver-waiter list)
  let mut send_fut = tx.send(42)
  match send_fut.poll(&mut cx)
  when Poll::Ready(r) then
    match r
    when Result::Ok(_) then ()
    when Result::Err(_) then assert_false(true)
    end
  when Poll::Pending then assert_false(true)
  end
  assert_eq(tx.inner.ptr.as_ref().recv_waiters.len(), 0)

  # the stream's next poll delivers the data
  match stream.poll_next(&mut cx)
  when Poll::Ready(opt) then
    match opt
    when Option::Some(v) then assert_eq(v, 42)
    when Option::None then assert_false(true)
    end
  when Poll::Pending then assert_false(true)
  end

  # the send side closes (the last sender drops): the exhausted stream
  # completes with None — the fresh RecvFuture sees the closed state
  # before any registration
  drop(tx)
  match stream.poll_next(&mut cx)
  when Poll::Ready(opt) then
    match opt
    when Option::Some(_) then assert_false(true)
    when Option::None then ()
    end
  when Poll::Pending then assert_false(true)
  end
end
