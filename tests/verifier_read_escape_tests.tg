# ———————————————————————————————————————————————————————————————
# MIR verifier unit tests — the Read-escape ownership gate
# (audit P0 Read parity with stage0_ocaml/src/mir_verify.ml).
#
# MirRead is a SHARED READ.  A Read of a non-Copy, non-shareable value
# that CROSSES a container/pointee boundary (dynamic index, constant
# index, or deref) may not be installed into an independent owning
# destination: that would create a second owner without a Clone or Move.
# A whole-place Read (calls, joins, same-storage writebacks) keeps the
# shared-read convention; a Read of a Copy value or a shareable value
# (String, the COW Vec/Map/Set and Option/Result of shareable values) is
# legal.
#
# These cases pin the KERNEL verifier to the seed's rule.  The seed's
# check_read_escapes (mir_verify.ml) defines the same set; the shared
# cases are asserted against both verifiers by
# scripts/check_verifier_read_escape_parity.sh.
#
# Run: tg test tests/verifier_read_escape_tests.tg
# ———————————————————————————————————————————————————————————————

use std::core::{Option, Result}
use std::collections::Vec
use std::test::assert

use tg_compiler::mir::{
  verify_mir, MirProgram, MirFunction, MirLocal, MirLocalId, MirBlock,
  MirBlockId, MirStatement, MirStatementKind, MirRvalue, MirRvalueKind,
  MirOperand, MirOperandKind, MirConstant, MirConstantKind, MirTerminator,
  MirTerminatorKind, Projection, LangItems, AggregateKind, Place, place_local,
  operand_read, operand_constant
}
use tg_compiler::ids::TypeId
use tg_compiler::types::Type
use tg_compiler::token::span_dummy

def box_tid() -> TypeId
  TypeId { id: 9001 }
end

def option_tid() -> TypeId
  TypeId { id: 9002 }
end

def box_ty() -> Type
  Type::Adt(box_tid(), Vec::from([Type::Int]))
end

def option_box_ty() -> Type
  Type::Adt(option_tid(), Vec::from([box_ty()]))
end

def read_escape_lang() -> LangItems
  LangItems {
    option: 9002,
    result: -1,
    vec: -1,
    map: -1,
    set: -1,
    box_: 9001,
    rc: -1,
    array: -1,
    slice: -1,
    string: -1,
    str_view: -1,
    unique_ptr: -1,
    arc_strong: -1,
    weak_rc: -1,
    weak_arc: -1,
    affine_handle: -1,
    ptr: -1,
    ptr_mut: -1,
    drop_trait: -1,
    clone_trait: -1,
    copy_trait: -1,
    eq_trait: -1,
    hash_trait: -1,
    transferable_trait: -1,
    shareable_trait: -1
  }
end

# A one-block function whose single statement stores `rvalue` into
# `dest_place`; _0 (source) and _1 (destination) are parameters, so
# definite-init and storage-liveness never add noise.
def read_escape_fn(name: String, src_ty: Type, dest_ty: Type, src_projs: Vec[Projection], dest_projs: Vec[Projection], rvalue: MirRvalue) -> MirFunction
  let p0 = MirLocal { id: MirLocalId { id: 0 }, name: "_0", ty: src_ty, is_mut: false, span: span_dummy() }
  let p1 = MirLocal { id: MirLocalId { id: 1 }, name: "_1", ty: dest_ty, is_mut: false, span: span_dummy() }
  var src = place_local(MirLocalId { id: 0 })
  var si = 0
  while si < src_projs.len() do
    src.projections.push(src_projs[si])
    si = si + 1
  end
  var dest = place_local(MirLocalId { id: 1 })
  var di = 0
  while di < dest_projs.len() do
    dest.projections.push(dest_projs[di])
    di = di + 1
  end
  let assign = MirStatement { kind: MirStatementKind::MirAssign(dest, rvalue), span: span_dummy() }
  let block0 = MirBlock {
    id: MirBlockId { id: 0 },
    statements: Vec::from([assign]),
    terminator: MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() }
  }
  MirFunction {
    name: name,
    params: Vec::from([p0, p1]),
    ret_type: Type::Unit,
    locals: Vec::new(),
    blocks: Vec::from([block0]),
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "",
    contracts: Vec::new(),
    span: span_dummy()
  }
end

def read_escape_program(f: MirFunction) -> MirProgram
  MirProgram { functions: Vec::from([f]), statics: Vec::new(), types: Vec::new(), lang_items: read_escape_lang() }
end

def src_place(projs: Vec[Projection]) -> Place
  var p = place_local(MirLocalId { id: 0 })
  var i = 0
  while i < projs.len() do
    p.projections.push(projs[i])
    i = i + 1
  end
  p
end

def first_error(errors: Vec[String]) -> String
  if errors.len() > 0 then errors[0] else "" end
end

def has_read_escape(errors: Vec[String]) -> Bool
  for e in errors do
    if e.contains("read of non-Copy non-shareable value") then
      return true
    end
  end
  false
end

# Case 1 — deref read of a Copy pointee: Ptr[Int] -> Int. ACCEPT.
@test
def test_accept_copy_pointee() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let f = read_escape_fn("accept_copy_pointee".to_string(), Type::Ptr(Type::Int), Type::Int, projs.clone(), Vec::new(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(src_place(projs))) })
  let errors = verify_mir(&read_escape_program(f))
  assert(!has_read_escape(errors), "copy pointee must not be a Read escape, got: " + first_error(errors))
end

# Case 2 — deref read of a unique handle: Ptr[Box[Int]] -> Box[Int]. REJECT.
@test
def test_reject_noncopy_handle_pointee() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let f = read_escape_fn("reject_box_pointee".to_string(), Type::Ptr(box_ty()), box_ty(), projs.clone(), Vec::new(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(src_place(projs))) })
  let errors = verify_mir(&read_escape_program(f))
  assert(has_read_escape(errors), "Box pointee read must be a Read escape, got: " + first_error(errors))
end

# Case 3 — String is shareable: Ptr[String] -> String. ACCEPT.
@test
def test_accept_string_pointee() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let f = read_escape_fn("accept_string_pointee".to_string(), Type::Ptr(Type::String), Type::String, projs.clone(), Vec::new(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(src_place(projs))) })
  let errors = verify_mir(&read_escape_program(f))
  assert(!has_read_escape(errors), "String is shareable, got: " + first_error(errors))
end

# Case 4 — same-place writeback _0.* = Read(_0.*). ACCEPT (no second owner).
@test
def test_accept_same_place_writeback() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let f = read_escape_fn("same_place".to_string(), Type::Ptr(box_ty()), box_ty(), projs.clone(), projs.clone(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(src_place(projs))) })
  let errors = verify_mir(&read_escape_program(f))
  assert(!has_read_escape(errors), "same-place read must not escape, got: " + first_error(errors))
end

# Case 5 — constant-index read of a non-shareable element:
# [_; 2] of Box -> Box. REJECT (a container boundary).
@test
def test_reject_constant_index_handle() -> Unit
  let projs = Vec::from([Projection::ProjConstantIndex(0)])
  let f = read_escape_fn("reject_const_index".to_string(), Type::FixedArray(box_ty(), 2), box_ty(), projs.clone(), Vec::new(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(src_place(projs))) })
  let errors = verify_mir(&read_escape_program(f))
  assert(has_read_escape(errors), "fixed-array Box element read must be a Read escape, got: " + first_error(errors))
end

# Case 6 — constant-index read of a Copy element: [_; 2] of Int -> Int. ACCEPT.
@test
def test_accept_constant_index_copy() -> Unit
  let projs = Vec::from([Projection::ProjConstantIndex(0)])
  let f = read_escape_fn("accept_const_index".to_string(), Type::FixedArray(Type::Int, 2), Type::Int, projs.clone(), Vec::new(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(src_place(projs))) })
  let errors = verify_mir(&read_escape_program(f))
  assert(!has_read_escape(errors), "fixed-array Int element read is a copy, got: " + first_error(errors))
end

# Case 7 — Option[Box] inherits non-shareability through the container:
# Ptr[Option[Box]] -> Option[Box]. REJECT.
@test
def test_reject_option_of_handle() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let f = read_escape_fn("reject_option_box".to_string(), Type::Ptr(option_box_ty()), option_box_ty(), projs.clone(), Vec::new(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(src_place(projs))) })
  let errors = verify_mir(&read_escape_program(f))
  assert(has_read_escape(errors), "Option[Box] must inherit non-shareability, got: " + first_error(errors))
end

# Case 8 — an aggregate operand that installs a boundary Read is an escape:
# _1 = (Read(_0.*)); _1: (Box,). REJECT.
@test
def test_reject_aggregate_read_escape() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let agg = MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Tuple, Vec::from([operand_read(src_place(projs))])) }
  let f = read_escape_fn("reject_aggregate".to_string(), Type::Ptr(box_ty()), Type::Tuple(Vec::from([box_ty()])), projs, Vec::new(), agg)
  let errors = verify_mir(&read_escape_program(f))
  assert(has_read_escape(errors), "aggregate Read of a handle must escape, got: " + first_error(errors))
end
