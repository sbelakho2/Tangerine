def index_local(id: Int) -> MirLocal
  MirLocal { id: MirLocalId { id: id }, name: "_idx", ty: Type::Int, is_mut: false, span: span_dummy() }
end

# _0: [Box; 2], _1: Int (index), _2: Box destination.
# _2 = Read(_0[_1]) — a dynamic-index owning extraction. REJECT.
@test
def test_reject_dynamic_index_handle() -> Unit
  let f = read_escape_fn_full("reject_dynamic_index".to_string(), Type::FixedArray(box_ty(), 2), box_ty(), Vec::from([Projection::ProjIndex(MirLocalId { id: 2 })]), Vec::new(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(place_with_index(0, 2))) }, Vec::from([index_local(2)]))
  let errors = verify_mir(&read_escape_program(f))
  assert(errors.len() == 1, "dynamic-index Box extraction must be exactly one Read escape, got " + errors.len().to_string() + ": " + first_error(errors))
  assert(errors[0].contains("read of non-Copy non-shareable value"), "unexpected diagnostic: " + errors[0])
end

# _0[idxA] = Read(_0[idxA]) — exact same dynamic place. ACCEPT.
@test
def test_accept_same_dynamic_index() -> Unit
  let f = read_escape_fn_full("same_dynamic_index".to_string(), Type::FixedArray(box_ty(), 2), box_ty(), Vec::new(), Vec::new(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(place_with_index(0, 2))) }, Vec::from([index_local(2)]))
  # rewrite the single assignment's destination to the same dynamic place
  var stmts = Vec::new()
  stmts.push(MirStatement { kind: MirStatementKind::MirAssign(place_with_index(0, 2), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(place_with_index(0, 2))) }), span: span_dummy() })
  let block0 = MirBlock { id: MirBlockId { id: 0 }, statements: stmts, terminator: MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() } }
  var fixed_f = f
  fixed_f.blocks = Vec::from([block0])
  let errors = verify_mir(&read_escape_program(fixed_f))
  assert(errors.len() == 0, "same dynamic-index writeback must be clean, got: " + first_error(errors))
end

# _0[idxB] = Read(_0[idxA]) with idxA != idxB — distinct dynamic places. REJECT.
@test
def test_reject_distinct_dynamic_index() -> Unit
  let f = read_escape_fn_full("distinct_dynamic_index".to_string(), Type::FixedArray(box_ty(), 2), box_ty(), Vec::new(), Vec::new(), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(place_with_index(0, 2))) }, Vec::from([index_local(2), index_local(3)]))
  var stmts = Vec::new()
  stmts.push(MirStatement { kind: MirStatementKind::MirAssign(place_with_index(0, 3), MirRvalue { kind: MirRvalueKind::MirMove(operand_read(place_with_index(0, 2))) }), span: span_dummy() })
  let block0 = MirBlock { id: MirBlockId { id: 0 }, statements: stmts, terminator: MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() } }
  var fixed_f = f
  fixed_f.blocks = Vec::from([block0])
  let errors = verify_mir(&read_escape_program(fixed_f))
  assert(errors.len() == 1, "distinct dynamic indexes must be exactly one Read escape, got " + errors.len().to_string() + ": " + first_error(errors))
  assert(errors[0].contains("read of non-Copy non-shareable value"), "unexpected diagnostic: " + errors[0])
end


# Nested COW types are finite: the recursion identity is the FULL nominal
# instance (TypeId + args), so Vec[Vec[String]] is shareable and
# Vec[Vec[Box]] is not.
@test
def test_accept_nested_vec_string() -> Unit
  let projs = Vec::from([Projection::ProjConstantIndex(0)])
  let f = read_escape_fn("accept_nested_vec".to_string(), vec_ty(vec_ty(Type::String)), vec_ty(Type::String), projs.clone(), Vec::new(), read_from(projs))
  let errors = verify_mir(&read_escape_program(f))
  assert(errors.len() == 0, "Vec[Vec[String]] is shareable, got: " + first_error(errors))
end

@test
def test_accept_nested_option_string() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let nested = Type::Adt(option_tid(), Vec::from([Type::Adt(option_tid(), Vec::from([Type::String]))]))
  let f = read_escape_fn("accept_nested_option".to_string(), Type::Ptr(nested), Type::Adt(option_tid(), Vec::from([Type::String])), projs.clone(), Vec::new(), read_from(projs))
  let errors = verify_mir(&read_escape_program(f))
  assert(errors.len() == 0, "Option[Option[String]] is shareable, got: " + first_error(errors))
end

@test
def test_reject_nested_vec_box() -> Unit
  let projs = Vec::from([Projection::ProjConstantIndex(0)])
  let f = read_escape_fn("reject_nested_vec_box".to_string(), vec_ty(vec_ty(box_ty())), vec_ty(box_ty()), projs.clone(), Vec::new(), read_from(projs))
  let errors = verify_mir(&read_escape_program(f))
  assert(errors.len() == 1, "Vec[Vec[Box]] must be exactly one Read escape, got " + errors.len().to_string() + ": " + first_error(errors))
  assert(errors[0].contains("read of non-Copy non-shareable value"), "unexpected diagnostic: " + errors[0])
end

@test
def test_reject_aggregate_read_escape() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let agg = MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Tuple, Vec::from([operand_read(deref_place(0))])) }
  let f = read_escape_fn("reject_aggregate".to_string(), Type::Ptr(box_ty()), Type::Tuple(Vec::from([box_ty()])), projs, Vec::new(), agg)
  let errors = verify_mir(&read_escape_program(f))
  assert(errors.len() == 1, "aggregate Read of a handle must be exactly one Read escape, got " + errors.len().to_string() + ": " + first_error(errors))
  assert(errors[0].contains("read of non-Copy non-shareable value"), "unexpected diagnostic: " + errors[0])
end
