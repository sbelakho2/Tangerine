    Projection::Field(FieldId { owner: outer_tid(), index: 0 }),
    Projection::Field(FieldId { owner: holder_tid(), index: 0 })
  ])
  let f = read_escape_fn("reject_nested_field_box".to_string(), outer_ty(), box_ty(), projs.clone(), Vec::new(), read_from(projs))
  let errors = verify_mir(&read_escape_program(f))
  assert(errors.len() == 1, "nested owning field extraction must be exactly one Read escape, got " + errors.len().to_string() + ": " + first_error(errors))
  assert(errors[0].contains("read of non-Copy non-shareable value"), "unexpected diagnostic: " + errors[0])
end

