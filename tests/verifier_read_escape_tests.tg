# ———————————————————————————————————————————————————————————————
# MIR verifier unit tests — the Read-escape ownership gate
# (audit P0 Read parity with stage0_ocaml/src/mir_verify.ml).
#
# MirRead is a SHARED READ.  A Read of a non-Copy, non-shareable value
# that is installed into an INDEPENDENT owning destination may not come
# from ANY projected place (field, tuple, enum payload, constant/dynamic
# index, deref): that would create a second owner without a Clone or
# Move.  A whole-place Read (calls, joins, same-storage writebacks) keeps
# the shared-read convention; a Read of a Copy value or a shareable value
# (String, the COW Vec/Map/Set and Option/Result of shareable values) is
# legal.
#
# The seed's check_read_escapes (mir_verify.ml) defines the same set.
# scripts/check_verifier_read_escape_parity.sh runs BOTH batteries (the
# seed tg_verify m5-m7 cases and this suite) and requires both to pass;
# the per-case assertions below are the expected semantic outcomes.
#
# Run: tg test tests/verifier_read_escape_tests.tg
# ———————————————————————————————————————————————————————————————

use std::core::{Option, Result}
use std::collections::Vec
use std::test::assert

use tg_compiler::mir::{
  verify_mir, MirProgram, MirFunction, MirLocal, MirLocalId, MirBlock,
  MirBlockId, MirStatement, MirStatementKind, MirRvalue, MirRvalueKind,
  MirOperand, MirOperandKind, MirConstant, MirConstantKind, MirTerminator,
  MirTerminatorKind, Projection, LangItems, AggregateKind, Place, MirTypeDef,
  MirTypeDefKind, MirFieldDef, place_local, operand_read, operand_constant
}
use tg_compiler::ids::{FieldId, TypeId}
use tg_compiler::types::Type
use tg_compiler::token::span_dummy

def box_tid() -> TypeId
  TypeId { id: 9001 }
end

def option_tid() -> TypeId
  TypeId { id: 9002 }
end

def result_tid() -> TypeId
  TypeId { id: 9003 }
end

def holder_tid() -> TypeId
  TypeId { id: 9004 }
end

def holder_string_tid() -> TypeId
  TypeId { id: 9005 }
end

def outer_tid() -> TypeId
  TypeId { id: 9006 }
end

def box_ty() -> Type
  Type::Adt(box_tid(), Vec::from([Type::Int]))
end

def option_box_ty() -> Type
  Type::Adt(option_tid(), Vec::from([box_ty()]))
end

def vec_tid() -> TypeId
  TypeId { id: 9010 }
end

def vec_ty(elem: Type) -> Type
  Type::Adt(vec_tid(), Vec::from([elem]))
end

def result_box_ty() -> Type
  Type::Adt(result_tid(), Vec::from([Type::Int, box_ty()]))
end

def holder_ty() -> Type
  Type::Adt(holder_tid(), Vec::new())
end

def holder_string_ty() -> Type
  Type::Adt(holder_string_tid(), Vec::new())
end

def outer_ty() -> Type
  Type::Adt(outer_tid(), Vec::new())
end

def read_escape_lang() -> LangItems
  LangItems {
    option: 9002,
    result: 9003,
    vec: 9010,
    map: 9011,
    set: 9012,
    box_: 9001,
    rc: 9013,
    array: 9014,
    slice: 9015,
    string: -1,
    str_view: -1,
    unique_ptr: 9016,
    arc_strong: 9017,
    weak_rc: 9018,
    weak_arc: 9019,
    affine_handle: -1,
    ptr: -1,
    ptr_mut: -1,
    drop_trait: -1,
    clone_trait: -1,
    copy_trait: -1,
    eq_trait: -1,
    hash_trait: -1,
    transferable_trait: -1,
    shareable_trait: -1
  }
end

def test_defs() -> Vec[MirTypeDef]
  Vec::from([
    MirTypeDef {
      id: holder_tid(),
      name: "Holder".to_string(),
      kind: MirTypeDefKind::Struct(Vec::from([
        MirFieldDef { name: "value".to_string(), ty: box_ty() }
      ])),
      generic_params: Vec::new()
    },
    MirTypeDef {
      id: holder_string_tid(),
      name: "StringHolder".to_string(),
      kind: MirTypeDefKind::Struct(Vec::from([
        MirFieldDef { name: "value".to_string(), ty: Type::String }
      ])),
      generic_params: Vec::new()
    },
    MirTypeDef {
      id: outer_tid(),
      name: "Outer".to_string(),
      kind: MirTypeDefKind::Struct(Vec::from([
        MirFieldDef { name: "inner".to_string(), ty: holder_ty() }
      ])),
      generic_params: Vec::new()
    }
  ])
end

# A one-block function storing `rvalue` into `_1` (a parameter); `_0` is
# the source.  extra_params are appended after _1 (for index locals).
def read_escape_fn_full(name: String, src_ty: Type, dest_ty: Type, src_projs: Vec[Projection], dest_projs: Vec[Projection], rvalue: MirRvalue, extra_params: Vec[MirLocal]) -> MirFunction
  let p0 = MirLocal { id: MirLocalId { id: 0 }, name: "_0", ty: src_ty, is_mut: false, span: span_dummy() }
  let p1 = MirLocal { id: MirLocalId { id: 1 }, name: "_1", ty: dest_ty, is_mut: false, span: span_dummy() }
  var params = Vec::from([p0, p1])
  var ei = 0
  while ei < extra_params.len() do
    params.push(extra_params[ei])
    ei = ei + 1
  end
  var src = place_local(MirLocalId { id: 0 })
  var si = 0
  while si < src_projs.len() do
    src.projections.push(src_projs[si])
    si = si + 1
  end
  var dest = place_local(MirLocalId { id: 1 })
  var di = 0
  while di < dest_projs.len() do
    dest.projections.push(dest_projs[di])
    di = di + 1
  end
  let assign = MirStatement { kind: MirStatementKind::MirAssign(dest, rvalue), span: span_dummy() }
  let block0 = MirBlock {
    id: MirBlockId { id: 0 },
    statements: Vec::from([assign]),
    terminator: MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() }
  }
  MirFunction {
    name: name,
    params: params,
    ret_type: Type::Unit,
    locals: Vec::new(),
    blocks: Vec::from([block0]),
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "",
    contracts: Vec::new(),
    span: span_dummy()
  }
end

def read_escape_fn(name: String, src_ty: Type, dest_ty: Type, src_projs: Vec[Projection], dest_projs: Vec[Projection], rvalue: MirRvalue) -> MirFunction
  read_escape_fn_full(name, src_ty, dest_ty, src_projs, dest_projs, rvalue, Vec::new())
end

def read_escape_program(f: MirFunction) -> MirProgram
  MirProgram { functions: Vec::from([f]), statics: Vec::new(), types: test_defs(), lang_items: read_escape_lang() }
end

def read_from(projs: Vec[Projection]) -> MirRvalue
  var p = place_local(MirLocalId { id: 0 })
  var i = 0
  while i < projs.len() do
    p.projections.push(projs[i])
    i = i + 1
  end
  MirRvalue { kind: MirRvalueKind::MirMove(operand_read(p)) }
end

def first_error(errors: Vec[String]) -> String
  if errors.len() > 0 then errors[0] else "" end
end

def place_with_index(root: Int, idx: Int) -> Place
  Place { local: MirLocalId { id: root }, projections: Vec::from([Projection::ProjIndex(MirLocalId { id: idx })]) }
end

def deref_place(root: Int) -> Place
  Place { local: MirLocalId { id: root }, projections: Vec::from([Projection::ProjDeref]) }
end

# The exact-count assertion: an acceptance case must be COMPLETELY clean;
# a rejection case must carry exactly the Read-escape diagnostic (no
# unrelated structural noise can hide behind the substring check).
@test
def test_accept_copy_pointee() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let f = read_escape_fn("accept_copy_pointee".to_string(), Type::Ptr(Type::Int), Type::Int, projs.clone(), Vec::new(), read_from(projs))
  let errors = verify_mir(&read_escape_program(f))
  assert(errors.len() == 0, "copy pointee must be clean, got: " + first_error(errors))
end

@test
def test_reject_noncopy_handle_pointee() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let f = read_escape_fn("reject_box_pointee".to_string(), Type::Ptr(box_ty()), box_ty(), projs.clone(), Vec::new(), read_from(projs))
  let errors = verify_mir(&read_escape_program(f))
  assert(errors.len() == 1, "expected exactly one Read-escape error, got " + errors.len().to_string() + ": " + first_error(errors))
  assert(errors[0].contains("read of non-Copy non-shareable value"), "unexpected diagnostic: " + errors[0])
end

@test
def test_accept_string_pointee() -> Unit
  let projs = Vec::from([Projection::ProjDeref])
  let f = read_escape_fn("accept_string_pointee".to_string(), Type::Ptr(Type::String), Type::String, projs.clone(), Vec::new(), read_from(projs))
  let errors = verify_mir(&read_escape_program(f))
  assert(errors.len() == 0, "String is shareable, got: " + first_error(errors))
end

