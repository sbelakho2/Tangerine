# tests/mono_arity_test.tg — the monomorphization EXACT-ARITY fail-closed
# unit suite (tg_compiler/mono.tg).
#
# Purpose: specialize_function_named must reject a substitution whose
# concrete type arguments do not match the declaration-order generic
# parameter ids EXACTLY, BEFORE a substitution map is built. The former
# min-length loop in type_subst_new silently TRUNCATED to the shorter
# list:
#   - TOO FEW args: a declaration-order parameter is left unbound; the
#     residual-param verification catches it only when the specialized
#     body mentions the parameter — a parameter unused in the signature
#     would specialize silently under the truncated map.
#   - TOO MANY args: the excess arguments are silently dropped — the case
#     residual-param detection cannot expose by construction.
# Both directions must abort with the internal "monomorphization arity
# error", and the equal-length case must still specialize (the loop
# semantics are unchanged there).
#
# The checker records every instance at the DECLARED arity, so these
# mismatches cannot be produced through a source-level program today;
# they are compiler-internal contract breaks, and this suite drives the
# public mono boundary (mono_cache_new / specialize_function_named)
# directly with hand-built MIR to prove the guard in both directions.
#
# Run with the repo root as the working directory:
#   tg test tests/mono_arity_test.tg

use std::core::{Option, Result}
use std::collections::{Vec, Map}
use std::test::assert

use tg_compiler::mono::{mono_cache_new, specialize_function_named, MonoCache}
use tg_compiler::ast::{Program, Crate}
use tg_compiler::resolver::{ResolvedNames, stable_id_map_new}
use tg_compiler::mir::{MirFunction, MirBlockId}
use tg_compiler::ids::{GenericParamId, DefId, ModuleId}
use tg_compiler::types::Type
use tg_compiler::token::span_dummy

# A generic template with TWO declared type parameters (declaration
# order T, U) and a concrete (non-generic) body.
def two_param_template() -> MirFunction
  MirFunction {
    name: "arity_two_params".to_string(),
    params: Vec::new(),
    ret_type: Type::Int,
    generic_params: Vec::from([
      GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 0 },
      GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 1 }
    ]),
    locals: Vec::new(),
    blocks: Vec::new(),
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "".to_string(),
    contracts: Vec::new(),
    span: span_dummy()
  }
end

# A generic template with ONE declared type parameter.
def one_param_template() -> MirFunction
  MirFunction {
    name: "arity_one_param".to_string(),
    params: Vec::new(),
    ret_type: Type::Int,
    generic_params: Vec::from([
      GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 0 }
    ]),
    locals: Vec::new(),
    blocks: Vec::new(),
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "".to_string(),
    contracts: Vec::new(),
    span: span_dummy()
  }
end

def fresh_cache() -> MonoCache
  mono_cache_new(
    Program { items: Vec::new(), crate: Crate { root: ModuleId { id: 0 }, modules: Map::new() }, span: span_dummy() },
    ResolvedNames {
      expr_resolutions: Map::new(),
      type_resolutions: Map::new(),
      pattern_resolutions: Map::new(),
      call_targets: Map::new(),
      type_def_ids: Map::new(),
      intrinsic_ids: Map::new(),
      item_defs: Map::new(),
      module_symbols: Map::new(),
      def_kinds: Map::new(),
      stable_ids: stable_id_map_new()
    }
  )
end

def expects_arity_error(result: Result[Unit, String], case: String) -> Unit
  match result
  when Result::Ok(()) then
    assert(false, case + ": specialization must NOT succeed on an arity mismatch")
  when Result::Err(msg) then
    assert(msg.contains("monomorphization arity error"), case + ": expected the internal monomorphization arity error, got: " + msg)
  end
end

# TOO FEW: two declared parameters, one concrete argument. The old
# min-length loop left U unbound; the arity guard must fire instead.
@test
def test_arity_too_few() -> Unit
  mut cache = fresh_cache()
  let result = specialize_function_named(
    inout cache,
    two_param_template(),
    Vec::from([GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 0 }, GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 1 }]),
    Vec::from([Type::Int]),
    "arity_too_few$int".to_string()
  )
  expects_arity_error(result, "too-few")
end

# TOO MANY: one declared parameter, three concrete arguments. The old
# min-length loop silently dropped the excess; the arity guard must fire
# (residual-param detection cannot expose this direction).
@test
def test_arity_too_many() -> Unit
  mut cache = fresh_cache()
  let result = specialize_function_named(
    inout cache,
    one_param_template(),
    Vec::from([GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 0 }]),
    Vec::from([Type::Int, Type::String, Type::Bool]),
    "arity_too_many$int$string$bool".to_string()
  )
  expects_arity_error(result, "too-many")
end

# EQUAL LENGTH (sanity): one declared parameter, one concrete argument —
# the substitution map is built with the unchanged min-length loop and
# the specialization must succeed and be cached.
@test
def test_arity_equal_ok() -> Unit
  mut cache = fresh_cache()
  let result = specialize_function_named(
    inout cache,
    one_param_template(),
    Vec::from([GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 0 }]),
    Vec::from([Type::Int]),
    "arity_equal_ok$int".to_string()
  )
  match result
  when Result::Ok(()) then
    assert(cache.instances.contains_key("arity_equal_ok$int"), "equal-arity specialization must be cached")
  when Result::Err(msg) then
    assert(false, "equal-arity specialization must succeed, got: " + msg)
  end
end
