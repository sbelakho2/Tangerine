use std::io::{print, println}

def int_to_string(n: Int) -> String
  if n == 0 then
    return "0"
  end

  mut val = n
  mut result = ""
  
  if val < 0 then
    result = "-"
    val = 0 - val
  end

  # Build digits in reverse
  mut digits = ""
  while val > 0 do
    let digit = val - ((val / 10) * 10)
    val = val / 10
    let ch = match digit
      when 0 then "0"
      when 1 then "1"
      when 2 then "2"
      when 3 then "3"
      when 4 then "4"
      when 5 then "5"
      when 6 then "6"
      when 7 then "7"
      when 8 then "8"
      when 9 then "9"
      else "?"
    end
    digits = ch + digits
  end

  result + digits
end

def main() -> Int
  println("=== Number printing test ===")
  
  let s1 = int_to_string(42)
  print("42 = ")
  println(s1)
  
  let s2 = int_to_string(0)
  print("0 = ")
  println(s2)
  
  let s3 = int_to_string(12345)
  print("12345 = ")
  println(s3)
  
  let fib10 = int_to_string(55)
  println("fib(10) = " + fib10)
  
  println("Done!")
  0
end
