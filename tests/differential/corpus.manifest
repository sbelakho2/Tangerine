# Tangerine differential corpus manifest — the bootstrap-subset corpus.
#
# Machine-readable manifest consumed by `tg_stage0 diff` (the stage0-vs-
# stage3 differential harness) and scripts/run_differential.sh. Every
# `file` is relative to this directory. The `coverage` tags name the
# bootstrap constructs the file exercises (the vocabulary is documented in
# tests/differential/README.md and stage0_swift/README.md). The `parity`
# list names the phases the file participates in: `tokens` (normalized
# --dump-tokens vs `lex`) and `ast` (normalized --dump-ast vs `dump`).
#
# Every corpus file MUST pass the stage0 corpus gate (E9029 UTF-8 gate,
# parse, V0001 span verifier, E9xxx subset checker) — the harness fails on
# any gate violation. Negative cases live in negative/ and are exercised
# by the gate + the Swift test runner, not by the parity comparison.

[case]
file = corpus/01_defs_arith.tg
coverage = "defs, arith, params, returns, calls, recursion, literals"
parity = "tokens, ast"

[case]
file = corpus/02_strings.tg
coverage = "strings, chars, escapes, concatenation, comparison"
parity = "tokens, ast"

[case]
file = corpus/03_structs.tg
coverage = "structs, fields, struct-literals, field-access, pub, rest-syntax"
parity = "tokens, ast"

[case]
file = corpus/04_enums_matches.tg
coverage = "enums, variants, discriminants, matches, patterns, or-patterns, ranges"
parity = "tokens, ast"

[case]
file = corpus/05_loops.tg
coverage = "loops, while, for, loop, break, next, nested-loops, control-flow"
parity = "tokens, ast"

[case]
file = corpus/06_generics.tg
coverage = "generics, type-params, generic-structs, generic-enums, generic-methods"
parity = "tokens, ast"

[case]
file = corpus/07_closures.tg
coverage = "closures, capture, higher-order, fn-types, hof-params"
parity = "tokens, ast"

[case]
file = corpus/08_collections.tg
coverage = "collections, vec, map, set, use, method-calls, indexing, iteration"
parity = "tokens, ast"

[case]
file = corpus/09_impls_traits.tg
coverage = "impls, traits, self, receivers, default-bodies, associated-methods"
parity = "tokens, ast"

[case]
file = corpus/10_consts_statics_aliases.tg
coverage = "consts, statics, type-aliases, const-exprs, fixed-arrays, literal-forms"
parity = "tokens, ast"

[case]
file = corpus/11_modules.tg
coverage = "modules, nested-modules, qualified-paths, use"
parity = "tokens, ast"

[case]
file = corpus/12_options_results.tg
coverage = "options, results, option-sugar, pattern-nesting, match"
parity = "tokens, ast"

[case]
file = corpus/13_control_flow.tg
coverage = "if-elsif-else, blocks, early-returns, compound-assign, assignment, boolean-ops"
parity = "tokens, ast"

[case]
file = corpus/14_extern_unsafe.tg
coverage = "extern, unsafe, pointers, casts, unsafe-blocks"
parity = "tokens, ast"

[case]
file = corpus/15_arrays_tuples_slices.tg
coverage = "arrays, fixed-arrays, tuples, tuple-patterns, ranges, slices"
parity = "tokens, ast"

# ---------------------------------------------------------------------------
# Negative cases — rejected by the stage0 gates (never parity-compared).
# Each row's `expect` is the exact diagnostic code the gate must produce.
# ---------------------------------------------------------------------------

[case]
file = negative/neg_async.tg
coverage = "neg-async"
expect = "E9007"
parity = ""

[case]
file = negative/neg_effect.tg
coverage = "neg-effect"
expect = "E9002"
parity = ""

[case]
file = negative/neg_comptime.tg
coverage = "neg-comptime"
expect = "E9006"
parity = ""

[case]
file = negative/neg_dyn_trait.tg
coverage = "neg-dyn"
expect = "E9032"
parity = ""

[case]
file = negative/neg_impl_trait.tg
coverage = "neg-impl-trait"
expect = "E9032"
parity = ""

[case]
file = negative/neg_contracts.tg
coverage = "neg-contracts"
expect = "E9011"
parity = ""

[case]
file = negative/neg_int_overflow.tg
coverage = "neg-int-overflow"
expect = "E9030"
parity = ""

[case]
file = negative/neg_int_overflow_hex.tg
coverage = "neg-int-overflow-hex"
expect = "E9030"
parity = ""

[case]
file = negative/not_utf8.tg
coverage = "neg-utf8"
expect = "E9029"
parity = ""
