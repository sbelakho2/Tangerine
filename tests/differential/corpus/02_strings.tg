# Differential corpus 02: strings and chars.
# Exercises: string literals, escape sequences, string concatenation via +,
# char literals, string comparison, string indexing/length via method calls.

def greet(name: String) -> String
  "Hello, " + name + "!"
end

def escapes() -> String
  "tab\tnewline\nquote\"backslash\\null\0cr\r"
end

def char_ops() -> Bool
  let c = 'A'
  let d = 'z'
  c != d
end

def string_compare() -> Bool
  let a = "abc"
  let b = "abd"
  a == b
end

def char_escape() -> Char
  '\n'
end

def empty() -> String
  ""
end

def main() -> Int
  let s = greet("Tangerine")
  let e = escapes()
  if string_compare() then
    -1
  else
    s.len() + e.len() + char_ops().to_int()
  end
end
