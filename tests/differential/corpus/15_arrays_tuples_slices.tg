# Differential corpus 15: arrays, tuples, ranges, slices.
# Exercises: fixed arrays [T; N], array literals, array indexing, tuple
# literals, tuple element access, tuple patterns in let bindings, range
# expressions (.. and ..=), array repeats, slice types in signatures.

def fixed_len() -> Int
  let arr = [1, 2, 3, 4, 5]
  arr.len()
end

def fixed_typed() -> Int
  let arr: [Int; 4] = [0, 0, 0, 0]
  arr[0] + arr[3]
end

def repeat_array() -> Int
  let arr = [7; 3]
  arr[0] + arr[1] + arr[2]
end

def array_index(arr: [Int; 3], i: Int) -> Int
  arr[i]
end

def tuple_ops() -> Int
  let t = (1, "two", 3.0)
  let (a, b, c) = t
  a + b.len() + c.to_int()
end

def tuple_first(t: (Int, String)) -> Int
  t.0
end

def range_exclusive() -> Int
  let r = 0..5
  r.len()
end

def range_inclusive() -> Int
  let r = 0..=5
  r.len()
end

def slice_param(s: [Int]) -> Int
  s.len()
end

def main() -> Int
  fixed_len() + fixed_typed() + repeat_array() + array_index([9, 8, 7], 1)
    + tuple_ops() + tuple_first((4, "x")) + range_exclusive() + range_inclusive() + slice_param([1, 2])
end
