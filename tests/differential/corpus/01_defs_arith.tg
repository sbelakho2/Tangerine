# Differential corpus 01: defs, parameters, returns, arithmetic, calls.
# Exercises: function declarations, parameter lists, return types, integer
# and float literals, binary/unary operators, function calls, tail
# expressions, recursion.

def add(a: Int, b: Int) -> Int
  a + b
end

def sub(a: Int, b: Int) -> Int
  a - b
end

def mul(a: Int, b: Int) -> Int
  a * b
end

def div(a: Int, b: Int) -> Int
  a / b
end

def mod(a: Int, b: Int) -> Int
  a % b
end

def neg(a: Int) -> Int
  -a
end

def bitwise(a: Int, b: Int) -> Int
  (a & b) | (a ^ b) << 1
end

def comparisons(a: Int, b: Int) -> Bool
  a == b || a != b && a < b || a <= b && a > b || a >= b
end

def factorial(n: Int) -> Int
  if n <= 1 then
    1
  else
    n * factorial(n - 1)
  end
end

def main() -> Int
  let x = add(1, 2)
  let y = sub(10, x)
  let z = mul(y, div(8, 2))
  let pi = 3.14159
  let neg_pi = -pi
  let total = x + y * 2 - z / 2 + mod(17, 5)
  let flag = comparisons(total, 0)
  if flag then
    factorial(6) + total
  else
    0
  end
end
