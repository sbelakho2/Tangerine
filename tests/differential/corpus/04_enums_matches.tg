# Differential corpus 04: enums and matches.
# Exercises: enum declarations with and without payloads, explicit
# discriminants, match expressions with variant/literal/wildcard/tuple/or
# patterns, else arms, match as an expression value.

enum Color
  Red
  Green
  Blue
end

enum Shape
  Circle(Int)
  Rectangle(Int, Int)
  Point2
end

enum Op
  Add
  Sub
  Mul
  Div
end

enum Weekday
  Mon
  Tue
  Wed
end

def color_name(c: Color) -> String
  match c
  when Red => "red"
  when Green => "green"
  when Blue => "blue"
  end
end

def shape_area(s: Shape) -> Int
  match s
  when Circle(r) => r * r
  when Rectangle(w, h) => w * h
  when Point2 => 0
  end
end

def apply(op: Op, a: Int, b: Int) -> Int
  match op
  when Add => a + b
  when Sub => a - b
  when Mul => a * b
  when Div => a / b
  end
end

def or_pattern(x: Int) -> Int
  match x
  when 1 | 2 | 3 => 10
  when 4..6 => 20
  else => 0
  end
end

def tuple_pattern(p: (Int, Int)) -> Int
  match p
  when (0, 0) => 1
  when (x, y) => x + y
  end
end

def main() -> Int
  let c = Color::Green
  let s = Shape::Rectangle(3, 4)
  let r = apply(Op::Mul, 6, 7)
  color_name(c).len() + shape_area(s) + r + or_pattern(5) + tuple_pattern((2, 3))
end
