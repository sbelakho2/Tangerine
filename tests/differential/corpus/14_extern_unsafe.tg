# Differential corpus 14: extern blocks, unsafe functions, raw pointers.
# Exercises: extern "C" blocks with function declarations, unsafe functions,
# Ptr/PtrMut types, pointer casts, integer casts, unsafe blocks.

extern "C"
  def strlen(s: Ptr[u8]) -> Int
  def abs(x: Int) -> Int
end

unsafe def raw_length(p: Ptr[u8]) -> Int
  strlen(p)
end

def cast_ops() -> Int
  let x = 65
  let c = x as Char
  let back = c as Int
  back
end

def ptr_type_test(p: PtrMut[Int]) -> Int
  unsafe
    p
    let v = *p
    v
  end
end

def main() -> Int
  let ptr = 0 as Ptr[u8]
  cast_ops() + abs(-7)
end
