# Differential corpus 06: generics.
# Exercises: generic function parameters, generic structs, generic enums,
# multiple type parameters, generic methods in impl blocks, type arguments
# at call sites, monomorphic instantiation sites.

def identity[T](x: T) -> T
  x
end

def swap[A, B](a: A, b: B) -> (B, A)
  (b, a)
end

struct Box[T]
  value: T
end

struct Pair[A, B]
  first: A
  second: B
end

enum Maybe[T]
  Nothing
  Just(T)
end

impl[T] Box[T]
  def get(self: Self) -> T
    self.value
  end

  def set(inout self: Self, value: T) -> Unit
    self.value = value
  end
end

def first_of[A, B](p: Pair[A, B]) -> A
  p.first
end

def maybe_unwrap[T](m: Maybe[T], fallback: T) -> T
  match m
  when Nothing => fallback
  when Just(v) => v
  end
end

def main() -> Int
  let a = identity[Int](42)
  let b = identity[String]("hi")
  let (x, y) = swap[Int, String](1, "one")
  let box = Box[Int] { value: 7 }
  let p = Pair[Int, Bool] { first: 1, second: true }
  let m = Maybe[Int]::Just(5)
  box.get() + first_of[Int, Bool](p) + maybe_unwrap[Int](m, 0) + x + a + y.len() + b.len()
end
