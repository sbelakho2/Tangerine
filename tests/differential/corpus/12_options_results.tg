# Differential corpus 12: options and results.
# Exercises: Option/Result usage, Some/None/Ok/Err construction, match over
# options and results, option sugar (T?), unwrap-style matching, if-let
# style guards via match, nested options.

def safe_div(a: Int, b: Int) -> Option[Int]
  if b == 0 then
    None
  else
    Some(a / b)
  end
end

def parse_pair(a: Int, b: Int) -> Result[Int, String]
  if a < 0 || b < 0 then
    Err("negative")
  else
    Ok(a + b)
  end
end

def opt_or(x: Option[Int], fallback: Int) -> Int
  match x
  when Some(v) => v
  when None => fallback
  end
end

def res_unwrap(r: Result[Int, String]) -> Int
  match r
  when Ok(v) => v
  when Err(msg) => msg.len()
  end
end

def nested_option(x: Option[Option[Int]]) -> Int
  match x
  when Some(Some(v)) => v
  when Some(None) => 0
  when None => -1
  end
end

def option_sugar() -> Int
  let x: Int? = Some(9)
  opt_or(x, 0)
end

def main() -> Int
  let a = safe_div(10, 2)
  let b = safe_div(1, 0)
  let r = parse_pair(2, 3)
  let e = parse_pair(-1, 3)
  opt_or(a, 0) + opt_or(b, 7) + res_unwrap(r) + res_unwrap(e) + nested_option(Some(Some(4))) + option_sugar()
end
