# Differential corpus 13: control flow and blocks.
# Exercises: if/elsif/else chains, block expressions with tail values,
# nested blocks, early returns, if-as-expression, compound assignment,
# assignment expressions, boolean short-circuit evaluation.

def classify(n: Int) -> String
  if n < 0 then
    "negative"
  elsif n == 0 then
    "zero"
  elsif n < 10 then
    "small"
  else
    "large"
  end
end

def clamp(x: Int, lo: Int, hi: Int) -> Int
  if x < lo then
    lo
  elsif x > hi then
    hi
  else
    x
  end
end

def block_value(x: Int) -> Int
  let y = {
    let inner = x * 2
    inner + 1
  }
  y
end

def early_returns(x: Int) -> Int
  if x == 0 then
    return 0
  end
  if x < 0 then
    return -x
  end
  x * 2
end

def compound(x: Int) -> Int
  mut v = x
  v += 1
  v -= 2
  v *= 3
  v /= 4
  v
end

def assignment_value() -> Int
  let mut a = 1
  let mut b = 2
  a = b
  a + b
end

def short_circuit() -> Bool
  let mut called = false
  let result = false && called
  result || true
end

def main() -> Int
  classify(-5).len() + classify(0).len() + classify(5).len() + classify(50).len()
    + clamp(3, 0, 10) + clamp(-1, 0, 10) + clamp(20, 0, 10)
    + block_value(4) + early_returns(0) + early_returns(-3) + early_returns(5)
    + compound(10) + assignment_value() + short_circuit().to_int()
end
