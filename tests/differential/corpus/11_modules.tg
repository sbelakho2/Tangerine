# Differential corpus 11: modules.
# Exercises: inline module declarations, nested modules, module-qualified
# item access, functions inside modules, use of a module's items.

module geometry
  module shapes
    struct Circle
      radius: Int
    end

    def circumference(c: Circle) -> Int
      2 * c.radius
    end
  end

  def pi() -> Float
    3.14159
  end
end

module math_ops
  def square(x: Int) -> Int
    x * x
  end

  def cube(x: Int) -> Int
    x * x * x
  end
end

def main() -> Int
  let c = geometry::shapes::Circle { radius: 5 }
  geometry::shapes::circumference(c) + math_ops::square(3) + math_ops::cube(2)
end
