# Differential corpus 05: loops.
# Exercises: while loops, for loops over ranges and vectors, loop with
# break/next, nested loops, loop-carried accumulators, break with value.

def count_up(limit: Int) -> Int
  mut i = 0
  while i < limit do
    i = i + 1
  end
  i
end

def sum_range(n: Int) -> Int
  mut total = 0
  for i in 0..n do
    total = total + i
  end
  total
end

def sum_inclusive(n: Int) -> Int
  mut total = 0
  for i in 0..=n do
    total = total + i
  end
  total
end

def skip_evens(n: Int) -> Int
  mut total = 0
  mut i = 0
  while i < n do
    i = i + 1
    if i % 2 == 0 then
      next
    end
    total = total + i
  end
  total
end

def early_exit(limit: Int) -> Int
  mut i = 0
  loop do
    i = i + 1
    if i >= limit then
      break
    end
  end
  i
end

def nested(n: Int) -> Int
  mut total = 0
  mut i = 0
  while i < n do
    mut j = 0
    while j < n do
      total = total + 1
      j = j + 1
    end
    i = i + 1
  end
  total
end

def main() -> Int
  count_up(10) + sum_range(10) + sum_inclusive(5) + skip_evens(10) + early_exit(7) + nested(3)
end
