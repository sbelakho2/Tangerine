use std::ffi::{Ptr, PtrMut, null_ptr, read_ptr, write_ptr}
use std::core::{String}

def probe_addr(p: Ptr[u8]) -> Int
  let q = p.offset(3)
  q.address
end

def probe_is_null(p: Ptr[u8]) -> Bool
  p.is_null()
end

def probe_as_ptr(s: String) -> Ptr[u8]
  s.as_ptr()
end

def probe_arr(v: Vec[u8]) -> Ptr[u8]
  v.as_ptr()
end

def probe_slice_addr(v: Vec[u8]) -> Int
  let mut w = v
  let sl = w.as_mut_slice()
  sl.ptr as Int
end
