# Differential corpus 08: collections.
# Exercises: use declarations, Vec/Array/Map/Set type names, constructor
# calls, method calls on collections, indexing, iteration, size queries,
# map insert/get, set insert/contains, generics over collection elements.

use std::core
use std::collections

def build_vec() -> Vec[Int]
  let mut v = Vec[Int]::new()
  v.push(1)
  v.push(2)
  v.push(3)
  v
end

def vec_sum(v: Vec[Int]) -> Int
  mut total = 0
  for x in v do
    total = total + x
  end
  total
end

def index_access(v: Vec[Int], i: Int) -> Int
  v[i]
end

def map_ops() -> Int
  let mut m = Map[String, Int]::new()
  m.insert("one", 1)
  m.insert("two", 2)
  m.insert("three", 3)
  let mut total = 0
  for (k, v) in m.entries() do
    total = total + v
  end
  total + m.len()
end

def set_ops() -> Int
  let mut s = Set[Int]::new()
  s.insert(10)
  s.insert(20)
  s.insert(10)
  let mut count = 0
  if s.contains(20) then
    count = count + 1
  end
  count + s.len()
end

def main() -> Int
  let v = build_vec()
  vec_sum(v) + index_access(v, 1) + map_ops() + set_ops()
end
