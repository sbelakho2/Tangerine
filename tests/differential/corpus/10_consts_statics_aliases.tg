# Differential corpus 10: consts, statics, type aliases.
# Exercises: const declarations with constant expressions, static
# declarations (immutable and mutable), type aliases, aliased types used in
# signatures, const expressions in fixed-array sizes.

const MAX_SIZE: Int = 1024
const NAME: String = "tangerine"
const RATIO: Float = 0.5
const FLAGS: Int = 0b1010
const HEX_MASK: Int = 0xFF00

static LIMIT: Int = 100
static mut COUNTER: Int = 0

type IntList = Vec[Int]
type Name = String
type Coordinate = (Int, Int)
type Lookup = Map[String, Int]

const BUFFER: Int = 8 * MAX_SIZE

def bump() -> Int
  COUNTER = COUNTER + 1
  COUNTER
end

def fixed_array() -> Int
  let buf = [0; MAX_SIZE]
  buf.len()
end

def typed(x: Name) -> Name
  x + "!"
end

def pair_sum(p: Coordinate) -> Int
  p.0 + p.1
end

def main() -> Int
  let v: IntList = IntList::new()
  let l: Lookup = Lookup::new()
  bump() + fixed_array() + typed(NAME).len() + pair_sum((2, 3)) + LIMIT + v.len() + l.len()
end
