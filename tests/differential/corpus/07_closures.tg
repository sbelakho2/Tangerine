# Differential corpus 07: closures.
# Exercises: closure literals, typed closure parameters, closure calls,
# closures passed as function arguments, closures capturing surrounding
# locals, block-body closures, higher-order use.

def apply_twice(f: fn(Int) -> Int, x: Int) -> Int
  f(f(x))
end

def compose[A, B, C](f: fn(B) -> C, g: fn(A) -> B, x: A) -> C
  f(g(x))
end

def call_it(f: fn() -> Int) -> Int
  f()
end

def main() -> Int
  let double = |x: Int| x * 2
  let add_ten = |x: Int| x + 10
  let capture = 100
  let add_capture = |x: Int| x + capture
  let square = |x: Int| do
    x * x
  end
  let combine = |a: Int, b: Int| a + b
  let five = |()| do
    5
  end
  apply_twice(double, 3)
    + apply_twice(add_ten, 1)
    + add_capture(1)
    + square(4)
    + combine(2, 3)
    + call_it(five)
    + compose[Int, Int, Int](double, add_ten, 5)
end
