# Differential corpus 03: structs.
# Exercises: struct declarations, pub visibility, fields with primitive and
# compound types, struct literals, field access, nested structs, mutable
# field binding, struct rest syntax, struct update.

struct Point
  x: Int
  y: Int
end

pub struct Line
  start: Point
  end: Point
end

struct Labeled
  name: String
  coords: Point
end

struct WithRest
  a: Int
  b: Int
  c: Int
end

def origin() -> Point
  Point { x: 0, y: 0 }
end

def translate(p: Point, dx: Int, dy: Int) -> Point
  Point { x: p.x + dx, y: p.y + dy }
end

def line_len(line: Line) -> Int
  let dx = line.end.x - line.start.x
  let dy = line.end.y - line.start.y
  dx * dx + dy * dy
end

def shorthand(p: Point) -> Point
  let x = p.x + 1
  let y = p.y + 1
  Point { x, y }
end

def main() -> Int
  let a = Point { x: 1, y: 2 }
  let b = translate(a, 10, 20)
  let line = Line { start: a, end: b }
  let l = Labeled { name: "origin", coords: origin() }
  let rest = WithRest { a: 1, b: 2, c: 3 }
  let updated = WithRest { a: 9, ..rest }
  line_len(line) + l.coords.x + updated.c
end
