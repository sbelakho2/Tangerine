# Differential corpus 09: impls and traits.
# Exercises: trait declarations with method signatures, impl blocks on
# concrete types, impl Trait for Type, Self type, method receivers
# (self / inout self), default bodies, method calls, associated methods.

trait Shape
  def area(self: Self) -> Int
  def name(self: Self) -> String
end

trait Named
  def display_name(self: Self) -> String
end

struct Square
  side: Int
end

struct Rectangle
  width: Int
  height: Int
end

impl Shape for Square
  def area(self: Self) -> Int
    self.side * self.side
  end

  def name(self: Self) -> String
    "square"
  end
end

impl Shape for Rectangle
  def area(self: Self) -> Int
    self.width * self.height
  end

  def name(self: Self) -> String
    "rectangle"
  end
end

impl Named for Square
  def display_name(self: Self) -> String
    self.name() + "!"
  end
end

impl Square
  def new(side: Int) -> Square
    Square { side: side }
  end

  def scale(inout self: Self, factor: Int) -> Unit
    self.side = self.side * factor
  end

  def side_length(self: Self) -> Int
    self.side
  end
end

def total_area(s: Square, r: Rectangle) -> Int
  s.area() + r.area()
end

def main() -> Int
  let mut sq = Square::new(4)
  let rect = Rectangle { width: 3, height: 5 }
  sq.scale(2)
  total_area(sq, rect) + sq.side_length() + sq.display_name().len()
end
