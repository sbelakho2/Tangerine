# Negative differential case: TYPE-position impl Trait is removed from the
# bootstrap callable (E9032 — same scoping action as neg_dyn_trait.tg).
# Parameter-position impl-trait is ACCEPTED (the kernel's own taint.tg uses
# it) — this case pins the type-position rejection.

trait Iterator[T]
  def next_item(self: Self) -> Option[T]
end

def consume() -> impl Iterator[Int]
  Iterator[Int] {}
end

def main() -> Int
  0
end
