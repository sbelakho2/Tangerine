# Negative differential case: trait-object types (dyn Trait in type
# position) are removed from the bootstrap callable (E9032 — the scoping
# action for INV-TYPE-010 / INV-ABI-007).

trait Display
  def show(self: Self) -> String
end

def render(x: dyn Display) -> String
  x.show()
end

def main() -> Int
  0
end
