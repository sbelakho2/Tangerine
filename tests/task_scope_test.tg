# tests/task_scope_test.tg — the structured-concurrency TaskScope: the
# typed ScopedTaskHandle children, the ASYNC join_all (the executor's
# cooperative scheduling — no synchronous spin), and the error strategies
# (CancelAll cancels the remaining children after the first failure;
# CollectErrors waits for every child and aggregates; IgnoreErrors waits
# but suppresses). The scoped exit returns only when every child reaches
# a terminal state.
#
# The child failure signal: the scoped children are ()-output executor
# tasks, so a child's terminal result is Ok (completed) or Err (cancelled
# — the handle resolves Err "task cancelled"). A test cancels a child via
# its ScopedTaskHandle; join_all observes the Err and runs the strategy.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*

@test
def test_task_scope_children_complete_before_exit() -> Unit
  let mut completed = Vec::new()
  let result = std::async::block_on(std::async::scoped(|scope| {
    scope.spawn(async {
      std::async::sleep_millis(5).await
      completed.push(1)
    })
    scope.spawn(async {
      std::async::sleep_millis(2).await
      completed.push(2)
    })
  }))
  # both children reached the terminal state before the scope exited
  assert_true(result.is_ok())
  assert_eq(completed.len(), 2)
  assert_true(completed.contains(1))
  assert_true(completed.contains(2))
end

@test
def test_task_scope_cancel_all_cancels_remaining_children() -> Unit
  let mut ran = Vec::new()
  let result = std::async::block_on(std::async::scoped(|scope| {
    # the first child completes quickly; the second is cancelled (the
    # failure signal); the third is a long runner the CancelAll strategy
    # must cancel after the first failure.
    scope.spawn(async {
      std::async::sleep_millis(1).await
      ran.push(1)
    })
    let failing = scope.spawn(async {
      std::async::sleep_millis(1000).await
      ran.push(2)
    })
    scope.spawn(async {
      std::async::sleep_millis(1000).await
      ran.push(3)
    })
    failing.cancel()
  }))
  # the scope failed (the cancelled child's terminal result), the first
  # child ran, and the REMAINING child was cancelled before it ran
  assert_true(result.is_err())
  assert_eq(ran.len(), 1)
  assert_true(ran.contains(1))
  assert_false(ran.contains(3))
end

@test
def test_task_scope_collect_errors_aggregates() -> Unit
  let result = std::async::block_on(std::async::scoped(|scope| {
    scope.with_error_strategy(std::async::ScopeErrorStrategy::CollectErrors)
    # one completing child (no error) plus two cancelled children (errors)
    scope.spawn(async {
      std::async::sleep_millis(1).await
    })
    let h2 = scope.spawn(async {
      std::async::sleep_millis(1000).await
    })
    let h3 = scope.spawn(async {
      std::async::sleep_millis(1000).await
    })
    h2.cancel()
    h3.cancel()
  }))
  # every child was awaited; the two cancellations were aggregated
  match result
  when Result::Err(errs) then assert_eq(errs.len(), 2)
  when Result::Ok(_) then assert_false(true)
  end
end

@test
def test_task_scope_ignore_errors_suppresses() -> Unit
  let result = std::async::block_on(std::async::scoped(|scope| {
    scope.with_error_strategy(std::async::ScopeErrorStrategy::IgnoreErrors)
    let h = scope.spawn(async {
      std::async::sleep_millis(1000).await
    })
    h.cancel()
  }))
  # the child error was awaited and suppressed — the scope succeeds
  assert_true(result.is_ok())
end
