# tests/task_scope_test.tg — the structured-concurrency TaskScope: the
# typed ScopedTaskHandle children, the ASYNC join_all (the executor's
# cooperative scheduling — no synchronous spin), and the error strategies
# (CancelAll cancels the remaining children after the first failure;
# CollectErrors waits for every child and aggregates; IgnoreErrors waits
# but suppresses). The scoped exit returns only when every child reaches
# a terminal state.
#
# The child failure signal: the scoped children are ()-output executor
# tasks, so a child's terminal result is Ok (completed) or Err (cancelled
# — the handle resolves Err "task cancelled"). A test cancels a child via
# its ScopedTaskHandle; join_all observes the Err and runs the strategy.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*

@test
def test_task_scope_children_complete_before_exit() -> Unit
  let mut completed = Vec::new()
  let result = std::async::block_on(std::async::scoped(|scope| {
    scope.spawn(async {
      std::async::sleep_millis(5).await
      completed.push(1)
    })
    scope.spawn(async {
      std::async::sleep_millis(2).await
      completed.push(2)
    })
  }))
  # both children reached the terminal state before the scope exited
  assert_true(result.is_ok())
  assert_eq(completed.len(), 2)
  assert_true(completed.contains(1))
  assert_true(completed.contains(2))
end

@test
def test_task_scope_cancel_all_cancels_remaining_children() -> Unit
  let mut ran = Vec::new()
  let result = std::async::block_on(std::async::scoped(|scope| {
    # the first child completes quickly; the second is cancelled (the
    # failure signal); the third is a long runner the CancelAll strategy
    # must cancel after the first failure.
    scope.spawn(async {
      std::async::sleep_millis(1).await
      ran.push(1)
    })
    let failing = scope.spawn(async {
      std::async::sleep_millis(1000).await
      ran.push(2)
    })
    scope.spawn(async {
      std::async::sleep_millis(1000).await
      ran.push(3)
    })
    failing.cancel()
  }))
  # the scope failed (the cancelled child's terminal result), the first
  # child ran, and the REMAINING child was cancelled before it ran
  assert_true(result.is_err())
  assert_eq(ran.len(), 1)
  assert_true(ran.contains(1))
  assert_false(ran.contains(3))
end

@test
def test_task_scope_collect_errors_aggregates() -> Unit
  let result = std::async::block_on(std::async::scoped(|scope| {
    scope.with_error_strategy(std::async::ScopeErrorStrategy::CollectErrors)
    # one completing child (no error) plus two cancelled children (errors)
    scope.spawn(async {
      std::async::sleep_millis(1).await
    })
    let h2 = scope.spawn(async {
      std::async::sleep_millis(1000).await
    })
    let h3 = scope.spawn(async {
      std::async::sleep_millis(1000).await
    })
    h2.cancel()
    h3.cancel()
  }))
  # every child was awaited; the two cancellations were aggregated
  match result
  when Result::Err(errs) then assert_eq(errs.len(), 2)
  when Result::Ok(_) then assert_false(true)
  end
end

@test
def test_task_scope_ignore_errors_suppresses() -> Unit
  let result = std::async::block_on(std::async::scoped(|scope| {
    scope.with_error_strategy(std::async::ScopeErrorStrategy::IgnoreErrors)
    let h = scope.spawn(async {
      std::async::sleep_millis(1000).await
    })
    h.cancel()
  }))
  # the child error was awaited and suppressed — the scope succeeds
  assert_true(result.is_ok())
end

@test
def test_task_scope_two_handles_same_child_both_complete() -> Unit
  # The multi-join-waiter regression: the scope's tracked copy of the
  # child handle AND the caller's returned handle are BOTH awaited — the
  # scope's join_all and an independent awaiter task await the SAME
  # child. The old join_waiters Map[UInt, Waker] last-poller-wins shape
  # overwrote one waiter's registration (the other awaiter slept
  # forever); the Vec-valued map detaches the child's ENTIRE waiter
  # vector on completion and wakes every member exactly once — both
  # awaits complete.
  let mut awaited = Vec::new()
  let result = std::async::block_on(std::async::scoped(|scope| {
    let returned = scope.spawn(async {
      std::async::sleep_millis(5).await
    })
    # the caller's returned handle is awaited by an independent task;
    # the scope's tracked copy is awaited by the join_all after the body
    # returns — two registered waiters on the same child task.
    std::async::spawn(async {
      match returned.await
      when Result::Ok(()) then awaited.push(1)
      when Result::Err(_) then awaited.push(9)
      end
    })
  }))
  # the scope's join_all completed (Ok) AND the caller's returned handle
  # completed (Ok) — both waiters were woken by the child's completion
  assert_true(result.is_ok())
  assert_eq(awaited.len(), 1)
  assert_true(awaited.contains(1))
end

@test
def test_task_scope_spawn_clone_returned_handles_usable() -> Unit
  # The sink-after-push canary: TaskScope::spawn returns the SAME handle
  # it tracks via the intentional clone (self.tasks.push(handle.clone());
  # handle) — the deliberate ownership split: the scope owns its copy
  # (the join_all drains it), the caller owns the returned handle. The
  # sink form (push then use) would move the handle into the scope's Vec
  # and leave the returned value a use-after-move (the ScopedTaskHandle
  # owns an Arc — not a harmless copy). The returned handles are awaited
  # while the scope's copies are awaited by the join_all — every copy
  # reaches the terminal state and completes.
  let mut observed = Vec::new()
  let result = std::async::block_on(std::async::scoped(|scope| {
    let h1 = scope.spawn(async {
      std::async::sleep_millis(1).await
    })
    let h2 = scope.spawn(async {
      std::async::sleep_millis(2).await
    })
    # the caller's returned handles, awaited sequentially by an
    # independent task (the scope's tracked copies are awaited by the
    # join_all after the body returns)
    std::async::spawn(async {
      match h1.await
      when Result::Ok(()) then ()
      when Result::Err(_) then observed.push(9)
      end
      match h2.await
      when Result::Ok(()) then observed.push(1)
      when Result::Err(_) then observed.push(9)
      end
    })
  }))
  assert_true(result.is_ok())
  assert_eq(observed.len(), 1)
  assert_true(observed.contains(1))
end
