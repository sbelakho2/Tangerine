# tests/syscall_translation_test.tg — the per-target syscall identity table
#
# The std's syscall wrappers pass the TG CANONICAL (x86-64) numbers
# (read=0, write=1, open=2, close=3, ...). The codegen's Linux AArch64
# emission translates them through the per-target table
# (linux_aarch64_syscall_number / linux_aarch64_syscall_layout) because
# the AArch64 Linux table differs (read=63, write=64, openat=56, ...)
# and its path-syscall surface is the *at family. This suite pins every
# row of the table and the argument layouts of the *at rewrites; unknown
# numbers must pass through raw.

use std::test::*
use tg_compiler::codegen::{
  linux_aarch64_syscall_number, linux_aarch64_syscall_layout,
  linux_aarch64_syscall_canonicals, A64SyscallArgLayout
}

@test
def test_aarch64_syscall_number_table() -> Unit
  # The std's used set (std/io.tg, std/fs.tg) plus mmap/munmap/exit.
  assert_eq(linux_aarch64_syscall_number(0), 63)    # read
  assert_eq(linux_aarch64_syscall_number(1), 64)    # write
  assert_eq(linux_aarch64_syscall_number(2), 56)    # open -> openat
  assert_eq(linux_aarch64_syscall_number(3), 57)    # close
  assert_eq(linux_aarch64_syscall_number(4), 79)    # stat -> fstatat
  assert_eq(linux_aarch64_syscall_number(5), 80)    # fstat
  assert_eq(linux_aarch64_syscall_number(8), 62)    # lseek
  assert_eq(linux_aarch64_syscall_number(9), 222)   # mmap
  assert_eq(linux_aarch64_syscall_number(11), 215)  # munmap
  assert_eq(linux_aarch64_syscall_number(32), 23)   # dup
  assert_eq(linux_aarch64_syscall_number(33), 24)   # dup2
  assert_eq(linux_aarch64_syscall_number(60), 93)   # exit
  assert_eq(linux_aarch64_syscall_number(79), 17)   # getcwd
  assert_eq(linux_aarch64_syscall_number(80), 49)   # chdir
  assert_eq(linux_aarch64_syscall_number(82), 38)   # rename -> renameat
  assert_eq(linux_aarch64_syscall_number(83), 34)   # mkdir -> mkdirat
  assert_eq(linux_aarch64_syscall_number(84), 35)   # rmdir -> unlinkat
  assert_eq(linux_aarch64_syscall_number(87), 35)   # unlink -> unlinkat
  assert_eq(linux_aarch64_syscall_number(88), 36)   # symlink -> symlinkat
  assert_eq(linux_aarch64_syscall_number(89), 37)   # readlink -> readlinkat
  assert_eq(linux_aarch64_syscall_number(90), 53)   # chmod -> fchmodat
  assert_eq(linux_aarch64_syscall_number(217), 61)  # getdents64
end

@test
def test_aarch64_syscall_layout_table() -> Unit
  # The number-only mappings keep the args as-is.
  assert_true(linux_aarch64_syscall_layout(0) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(1) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(3) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(5) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(8) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(9) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(11) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(32) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(33) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(60) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(79) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(80) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(217) == A64SyscallArgLayout::Direct)

  # The *at rewrites insert the AT_FDCWD dirfd.
  assert_true(linux_aarch64_syscall_layout(2) == A64SyscallArgLayout::PrependFdcwd)
  assert_true(linux_aarch64_syscall_layout(83) == A64SyscallArgLayout::PrependFdcwd)
  assert_true(linux_aarch64_syscall_layout(87) == A64SyscallArgLayout::PrependFdcwd)
  assert_true(linux_aarch64_syscall_layout(89) == A64SyscallArgLayout::PrependFdcwd)
  assert_true(linux_aarch64_syscall_layout(90) == A64SyscallArgLayout::PrependFdcwd)

  # fstatat needs the extra flags argument (0 for stat).
  assert_true(linux_aarch64_syscall_layout(4) == A64SyscallArgLayout::PrependFdcwdFlags0)

  # AArch64 has no rmdir: unlinkat + AT_REMOVEDIR.
  assert_true(linux_aarch64_syscall_layout(84) == A64SyscallArgLayout::RmdirToUnlinkat)

  # renameat takes two dirfds; symlinkat takes the dirfd in the middle.
  assert_true(linux_aarch64_syscall_layout(82) == A64SyscallArgLayout::RenameToRenameat)
  assert_true(linux_aarch64_syscall_layout(88) == A64SyscallArgLayout::SymlinkToSymlinkat)
end

@test
def test_aarch64_syscall_unknown_passes_through_raw() -> Unit
  # A number outside the table is emitted raw (the caller supplies a
  # target-native number directly) and keeps the Direct argument layout.
  assert_eq(linux_aarch64_syscall_number(193), 193)  # e.g. the macOS getdirentries
  assert_eq(linux_aarch64_syscall_number(999), 999)
  assert_eq(linux_aarch64_syscall_number(1024), 1024)
  assert_true(linux_aarch64_syscall_layout(193) == A64SyscallArgLayout::Direct)
  assert_true(linux_aarch64_syscall_layout(999) == A64SyscallArgLayout::Direct)
end

@test
def test_aarch64_syscall_canonicals_cover_the_std_used_set() -> Unit
  # The enumerated canonical set must contain every identity the std
  # passes (std/io.tg: read, write; std/fs.tg: open, close, stat, fstat,
  # lseek, dup, dup2, getcwd, chdir, rename, mkdir, rmdir, unlink,
  # symlink, readlink, chmod, getdents64).
  let cs = linux_aarch64_syscall_canonicals()
  let expected = [0, 1, 2, 3, 4, 5, 8, 9, 11, 32, 33, 60, 79, 80, 82, 83, 84, 87, 88, 89, 90, 217]
  assert_eq(cs.len(), 22)
  var i = 0
  while i < 22 do
    var found = false
    var j = 0
    while j < cs.len() do
      if cs[j] == expected[i] then
        found = true
      end
      j = j + 1
    end
    assert_true(found)
    i = i + 1
  end
end
