## The algebraic-effects behavioral suite — the async-effect discipline
## (the pure analysis surface of std::effects): the inference reports
## the Async effect for an await/spawn/async-bearing body, and the
## soundness check accepts a declared Async effect.

use std::core::{Option, Result, Unit, Bool, Int}
use std::collections::{Set}
use std::effects::{infer_effects_from_body, check_effect_soundness}
use std::test::*

@test
def test_async_effect_detected() -> Unit
  let body = "let future = async { 1 }\n"
  let effects = infer_effects_from_body(body)
  if !effects.contains("Async") then
    panic("an async body must infer the Async effect")
  end
end

@test
def test_spawn_effect_detected() -> Unit
  let body = "spawn(worker)\n"
  let effects = infer_effects_from_body(body)
  if !effects.contains("Async") then
    panic("a spawn call must infer the Async effect")
  end
end

@test
def test_async_effect_sound_when_declared() -> Unit
  let mut declared: Set[String] = Set::new()
  declared.insert("Async")
  let mut actual: Set[String] = Set::new()
  actual.insert("Async")
  match check_effect_soundness(declared, actual)
  when Option::Some(_) then panic("a declared Async effect must be sound")
  when Option::None then ()
  end
end
