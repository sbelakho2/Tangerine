## The algebraic-effects behavioral suite — the unhandled-effect
## discipline (the pure analysis surface of std::effects): a program
## whose function performs an effect it never declares is reported as a
## violation by the program-wide check.

use std::core::{Option, Result, Unit, Bool, Int}
use std::effects::{check_all_effects, EffectCheckResult}
use std::test::*

@test
def test_unhandled_effect_violation() -> Unit
  let source = "def foo() -> Int\n  print(\"hello\")\n  0\nend\n"
  match check_all_effects(source)
  when EffectCheckResult::Clean then
    panic("an undeclared IO effect must be reported as a violation")
  when EffectCheckResult::Violations(vs) then
    if vs.len() != 1 then
      panic("exactly one violation expected")
    end
  end
end

@test
def test_handled_effect_is_clean() -> Unit
  let source = "@Pure\ndef foo() -> Int\n  0\nend\n"
  match check_all_effects(source)
  when EffectCheckResult::Clean then ()
  when EffectCheckResult::Violations(vs) then
    panic("a pure function must check clean, got " + vs.len().to_string() + " violation(s)")
  end
end
