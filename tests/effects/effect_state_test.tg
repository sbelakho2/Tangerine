## The algebraic-effects behavioral suite — the State-effect discipline
## (the pure analysis surface of std::effects): the inference reports the
## State effect for a mutation-bearing body, and the soundness check
## accepts a declared State effect.

use std::core::{Option, Result, Unit, Bool, Int}
use std::collections::{Set}
use std::effects::{infer_effects_from_body, check_effect_soundness}
use std::test::*

@test
def test_state_effect_detected() -> Unit
  let body = "var x = 1\nx = 2\n"
  let effects = infer_effects_from_body(body)
  if !effects.contains("State") then
    panic("an assignment-bearing body must infer the State effect")
  end
end

@test
def test_state_effect_sound_when_declared() -> Unit
  let mut declared: Set[String] = Set::new()
  declared.insert("State")
  let mut actual: Set[String] = Set::new()
  actual.insert("State")
  match check_effect_soundness(declared, actual)
  when Option::Some(_) then panic("a declared State effect must be sound")
  when Option::None then ()
  end
end

@test
def test_state_effect_unsound_when_undeclared() -> Unit
  let declared: Set[String] = Set::new()
  let mut actual: Set[String] = Set::new()
  actual.insert("State")
  match check_effect_soundness(declared, actual)
  when Option::Some(missing) then
    if missing.len() != 1 then
      panic("exactly one missing effect expected")
    end
  when Option::None then panic("an undeclared State effect must be reported")
  end
end
