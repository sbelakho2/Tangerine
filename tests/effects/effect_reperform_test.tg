## The algebraic-effects behavioral suite — the re-perform discipline
## (the pure analysis surface of std::effects): the soundness check
## re-verifies a declared effect (the handler re-performance analog —
## an effect carried by an inner scope must be re-declared by the outer
## scope, and the checker reports the missing re-declaration).

use std::core::{Option, Result, Unit, Bool, Int}
use std::collections::{Set}
use std::effects::{check_effect_soundness}
use std::test::*

@test
def test_redeclared_effect_is_sound() -> Unit
  let mut declared: Set[String] = Set::new()
  declared.insert("IO")
  let mut actual: Set[String] = Set::new()
  actual.insert("IO")
  actual.insert("State")
  ## The outer scope re-declares both carried effects.
  declared.insert("State")
  match check_effect_soundness(declared, actual)
  when Option::Some(_) then panic("re-declared effects must be sound")
  when Option::None then ()
  end
end

@test
def test_missing_redeclaration_reported() -> Unit
  let mut declared: Set[String] = Set::new()
  declared.insert("IO")
  let mut actual: Set[String] = Set::new()
  actual.insert("IO")
  actual.insert("State")
  ## The inner State effect is NOT re-declared by the outer scope.
  match check_effect_soundness(declared, actual)
  when Option::Some(missing) then
    if missing.len() != 1 then
      panic("exactly one missing re-declaration expected")
    end
    if missing[0] != "State" then
      panic("the missing re-declaration must be the State effect, got " + missing[0])
    end
  when Option::None then panic("the missing re-declaration must be reported")
  end
end
