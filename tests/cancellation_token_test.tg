# tests/cancellation_token_test.tg — the CancellationToken: the
# heap-stable Arc[CancellationState] with the atomic cancelled flag and
# the synchronized children list. The parent-cancel propagates to the
# descendants; the child-cancel does NOT cancel the parent; the clone
# observes the same state; the cancellation is idempotent; and the
# concurrent-registration race is closed — a child registered during the
# parent's cancellation always observes the cancelled state (the
# registration checks the flag under the same synchronization the cancel
# uses to detach-and-propagate).

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::sync::{Arc, Mutex}
use std::thread::{spawn, JoinHandle}

@test
def test_cancellation_token_parent_cancel_propagates() -> Unit
  let parent = std::async::cancellation_token_new()
  let child = parent.child()
  let grandchild = child.child()
  parent.cancel()
  assert_true(parent.is_cancelled())
  assert_true(child.is_cancelled())
  assert_true(grandchild.is_cancelled())
end

@test
def test_cancellation_token_child_cancel_does_not_cancel_parent() -> Unit
  let parent = std::async::cancellation_token_new()
  let child = parent.child()
  child.cancel()
  assert_true(child.is_cancelled())
  assert_false(parent.is_cancelled())
end

@test
def test_cancellation_token_cancel_is_idempotent() -> Unit
  let token = std::async::cancellation_token_new()
  token.cancel()
  token.cancel()
  assert_true(token.is_cancelled())
end

@test
def test_cancellation_token_clone_observes_same_state() -> Unit
  let token = std::async::cancellation_token_new()
  let clone = token.clone()
  token.cancel()
  assert_true(clone.is_cancelled())
end

@test
def test_cancellation_token_concurrent_registration_race() -> Unit
  # the two deterministic interleavings of the registration/cancellation
  # race:
  # (1) the registration AFTER the cancellation observes the cancelled
  #     state at registration — the flag check under the children lock;
  let parent = std::async::cancellation_token_new()
  parent.cancel()
  let late = parent.child()
  assert_true(late.is_cancelled())
  # (2) the registration BEFORE the cancellation is detached and
  #     cancelled by the propagation.
  let parent2 = std::async::cancellation_token_new()
  let early = parent2.child()
  parent2.cancel()
  assert_true(early.is_cancelled())

  # the THREADED race: children registered concurrently with the parent's
  # cancellation must ALL end cancelled — a registration that linearizes
  # before the cancel's flag swap is reached by the propagation; one that
  # linearizes after is created already cancelled. No child escapes.
  let shared = Arc::new(std::async::cancellation_token_new())
  let children = Arc::new(Mutex::new(Vec::new()))
  let registered = Arc::new(Mutex::new(0))
  var handles: Vec[JoinHandle[Int]] = Vec::new()
  var t = 0
  while t < 4 do
    let s = shared.clone()
    let ch = children.clone()
    let reg = registered.clone()
    let h = spawn(move || {
      var i = 0
      while i < 50 do
        let c = s.ptr.as_ref().child()
        let mut g = ch.lock()
        g.push(c)
        drop(g)
        let mut rg = reg.lock()
        *rg = *rg + 1
        drop(rg)
        i = i + 1
      end
      0
    })
    handles.push(h)
    t = t + 1
  end

  # wait until the workers have started registering, then cancel mid-race
  var spins = 0
  while spins < 1000000 do
    let rg = registered.lock()
    let n = *rg
    drop(rg)
    if n >= 10 then
      break
    end
    spins = spins + 1
    std::thread::yield_now()
  end

  shared.ptr.as_ref().cancel()

  loop do
    match handles.pop()
    when Option::Some(mut h) then assert_ok(h.join())
    when Option::None then break
    end
  end

  # every registered child — before OR after the cancellation — observed
  # the cancelled state
  let g = children.lock()
  while g.len() > 0 do
    let c = g.remove(0)
    assert_true(c.is_cancelled())
  end
end
