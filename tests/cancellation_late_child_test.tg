# tests/cancellation_late_child_test.tg — the late CancellationToken
# child (reviewer item 16): a child registered AFTER the parent's
# cancellation is created ALREADY CANCELLED and is NOT inserted into the
# parent's children vector — the insertion would be a leak (the
# cancelled parent's detach-and-propagate already ran, so the dead child
# would sit in the vector forever, and the idempotent next cancel()
# would never reach it).

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*

# THE LATE CHILD: parent cancelled FIRST, child registered after — the
# child observes the cancelled state (the flag check under the children
# lock) and the parent's children vector stays EMPTY (no leaked
# insertion).
@test
def test_cancellation_late_child_cancelled_and_not_inserted() -> Unit
  let parent = std::async::cancellation_token_new()
  parent.cancel()

  let late = parent.child()
  assert_true(late.is_cancelled())

  # THE LEAK GUARD: the late child is NOT in the parent's children
  # vector.
  let children_len = unsafe "read the parent's children list" do
    parent.inner.ptr.as_ref().children.lock().len()
  end
  assert_eq(children_len, 0)
end

# THE NORMAL REGISTRATION: a child registered while the parent is live
# IS inserted (the propagation reaches it when the parent cancels).
@test
def test_cancellation_child_before_cancel_registered() -> Unit
  let parent = std::async::cancellation_token_new()
  let early = parent.child()
  assert_false(early.is_cancelled())

  let children_len = unsafe "read the parent's children list" do
    parent.inner.ptr.as_ref().children.lock().len()
  end
  assert_eq(children_len, 1)

  parent.cancel()
  assert_true(early.is_cancelled())
end

# THE RACE INTERLEAVINGS: the child created DURING the parent's
# cancellation is cancelled in EITHER interleaving — created before the
# propagation reaches it (detached + cancelled by the propagation) or
# created after the flag swap (cancelled at creation, never inserted).
@test
def test_cancellation_concurrent_registration_no_leak() -> Unit
  # Interleaving (1): the flag swap first, the child second — cancelled
  # at creation, not inserted.
  let parent1 = std::async::cancellation_token_new()
  parent1.cancel()
  let late1 = parent1.child()
  assert_true(late1.is_cancelled())
  let len1 = unsafe "read the parent's children list" do
    parent1.inner.ptr.as_ref().children.lock().len()
  end
  assert_eq(len1, 0)

  # Interleaving (2): the child first, the cancel second — the child is
  # registered and the propagation cancels it, then the detach empties
  # the vector.
  let parent2 = std::async::cancellation_token_new()
  let early2 = parent2.child()
  parent2.cancel()
  assert_true(early2.is_cancelled())
  let len2 = unsafe "read the parent's children list" do
    parent2.inner.ptr.as_ref().children.lock().len()
  end
  assert_eq(len2, 0)
end
