# tests/wasm/wasm_canary.tg — the wasm canary (the mandate's wasm (d):
# a simple program compiled to the wasm binary — the driver route
# `--target wasm32-unknown-unknown` — and executed by the wasmtime
# runner in the conformance script when the runtime is installed; the
# structural section validation is the always-on conformance).
#
# The canary computes a fixed point: add(a, b) is exported and the
# binary carries the HELLO string static (the data-section closure) and
# the producer record. The structural validator in
# tests/wasm/wasm_conformance_test.tg validates the emission; the runner
# script additionally executes this module under wasmtime (when
# available) and checks the exported add function's result.
#
# (third-audit item 45) budgeted_add carries an INSTRUCTIONS budget: the
# driver-route compile proves the wasm budget frame-slot mechanism (the
# per-invocation wasm-local counter, the per-statement increments and the
# MirReturn exit check) end to end on the wasm32-unknown-unknown target.
# A time_us budget is NOT exercised here: its clock import only exists on
# the WASI target (see wasm_target.tg's clock_time_get wiring and the
# run_wasi_conformance lane).

def add(a: Int, b: Int) -> Int
  a + b
end

def budgeted_add(a: Int, b: Int) -> Int @budget(instructions = 1000)
  a + b
end

def main() -> Int
  add(40, 2)
end

