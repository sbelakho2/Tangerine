use std::io::{print, println}

def int_to_string(n: Int) -> String
  if n == 0 then
    return "0"
  end
  mut val = n
  mut digits = ""
  while val > 0 do
    let digit = val - ((val / 10) * 10)
    val = val / 10
    let ch = match digit
      when 0 then "0"
      when 1 then "1"
      when 2 then "2"
      when 3 then "3"
      when 4 then "4"
      when 5 then "5"
      when 6 then "6"
      when 7 then "7"
      when 8 then "8"
      when 9 then "9"
      else "?"
    end
    digits = ch + digits
  end
  digits
end

def returns_zero() -> Int
  0
end

def returns_one() -> Int
  1
end

def main() -> Int
  mut x = 0
  x = x + returns_zero()
  print("after first: x = ")
  println(int_to_string(x))

  x = x + returns_zero()
  print("after second: x = ")
  println(int_to_string(x))

  x = x + returns_one()
  print("after third: x = ")
  println(int_to_string(x))

  x
end
