# Regression test: mutating method receiver on a nested (multi-level) field.
#
# `o.mid.inner.bump(5)` takes `&mut o.mid.inner` through emit_place_address
# and writes through it. The subsequent `sum()` read must observe the write,
# proving the mutable receiver reached the same nested Inner object.

struct Inner
  x: Int
end

impl Inner
  def bump(&mut self, by: Int) -> Unit
    self.x = self.x + by
  end
  def get(&self) -> Int
    self.x
  end
end

struct Mid
  inner: Inner
  label: String
end

struct Outer
  mid: Mid
  tag: Int
end

def main() -> Int
  mut o = Outer {
    mid: Mid {
      inner: Inner { x: 10 },
      label: "mid"
    },
    tag: 3
  }
  o.mid.inner.bump(5)
  o.mid.inner.bump(20)
  let v = o.mid.inner.get()
  if v != 35 then
    return 1
  end
  0
end
