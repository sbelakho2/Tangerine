    MirTypeDef {
      id: TypeId { id: 143 },
      name: "Outer".to_string(),
      kind: MirTypeDefKind::Struct(Vec::from([
        MirFieldDef { name: "e".to_string(), ty: Type::Adt(TypeId { id: 142 }, Vec::new()) }
      ])),
      generic_params: Vec::new()
    }
  ])
  let proj = Vec::from([
    Projection::Field(FieldId { owner: TypeId { id: 143 }, index: 0 }),
    Projection::Variant(VariantId { owner: TypeId { id: 142 }, index: 0 }),
    Projection::Field(FieldId { owner: TypeId { id: 142 }, index: 0 })
  ])
  let f = verifier_copy_fn("neg_nested_enum_payload_string".to_string(), Type::Adt(TypeId { id: 143 }, Vec::new()), proj, Type::String, string_const())
  let errors = verifier_verify(f, defs)
  assert(errors.len() == 1, "test_neg_nested_enum_payload_string: expected exactly one error, got " + errors.len().to_string())
  assert(errors[0].contains("MirCopy of non-trivially-copyable type string"), "test_neg_nested_enum_payload_string: expected the MirCopy error, got: " + errors[0])
end

# Test 17 — Vec ELEMENT then field, Copy leaf: MirCopy(_0[i].x) where
# _0: Vec[Inner] and Inner { x: Int, y: String } — the ProjIndex advances
# to the concrete element type, the Field to the Int — ACCEPTED.
@test
def test_pos_vec_element_field_int() -> Unit
  let defs = Vec::from([
    MirTypeDef {
      id: TypeId { id: 140 },
      name: "Inner".to_string(),
      kind: MirTypeDefKind::Struct(Vec::from([
        MirFieldDef { name: "x".to_string(), ty: Type::Int },
        MirFieldDef { name: "y".to_string(), ty: Type::String }
      ])),
      generic_params: Vec::new()
    },
    MirTypeDef {
      id: TypeId { id: 120 },
      name: "Vec".to_string(),
      kind: MirTypeDefKind::Struct(Vec::new()),
      generic_params: Vec::new()
    }
  ])
  let proj = Vec::from([
    Projection::ProjIndex(MirLocalId { id: 9 }),
    Projection::Field(FieldId { owner: TypeId { id: 140 }, index: 0 })
  ])
  let f = verifier_copy_fn("pos_vec_element_field_int".to_string(), Type::Adt(TypeId { id: 120 }, Vec::from([Type::Adt(TypeId { id: 140 }, Vec::new())])), proj, Type::Int, int_const())
  let errors = verifier_verify(f, defs)
  assert(errors.len() == 0, "test_pos_vec_element_field_int: expected no errors, got " + errors.len().to_string() + (if errors.len() > 0 then ": " + errors[0] else "" end))
end

