# ———————————————————————————————————————————————————————————————
# The CROSS-BLOCK MOVED STATES (the projection-aware moved lattice across
# blocks): block0 moves a field out via MirMovePlace(_0.<move>), a later
# block copies a place — the copy's legality is decided by the moved state
# that flowed through the MirGoto edge.
# ———————————————————————————————————————————————————————————————

# Build a multi-block function: block0 assigns the moved field value into
# the _2 temp (MirMovePlace — legal for ANY type, and it marks the chain
# moved), then (optionally reinit) re-initializes the copy projection with
# a constant store in its own block, then the final block runs the
# MirCopy binop exactly like verifier_copy_fn.
def verifier_cross_block_fn(name: String, root_ty: Type, move_proj: Vec[Projection], copy_proj: Vec[Projection], dest_ty: Type, rhs: MirOperand, reinit: Bool) -> MirFunction
  let param0 = MirLocal { id: MirLocalId { id: 0 }, name: "_0".to_string(), ty: root_ty, is_mut: false, span: span_dummy() }
  let param1 = MirLocal { id: MirLocalId { id: 1 }, name: "_1".to_string(), ty: dest_ty, is_mut: false, span: span_dummy() }
  let temp2 = MirLocal { id: MirLocalId { id: 2 }, name: "_2".to_string(), ty: Type::Int, is_mut: true, span: span_dummy() }

  var move_place = place_local(MirLocalId { id: 0 })
  for p in move_proj do
    move_place.projections.push(p)
  end
  let move_stmt = MirStatement {
    kind: MirStatementKind::MirAssign(place_local(MirLocalId { id: 2 }),
      MirRvalue { kind: MirRvalueKind::MirMove(operand_move_place(move_place)), span: span_dummy() }),
    span: span_dummy()
  }
  var blocks = Vec::new()
  blocks.push(MirBlock {
    id: MirBlockId { id: 0 },
    statements: Vec::from([move_stmt]),
    terminator: MirTerminator { kind: MirTerminatorKind::MirGoto(MirBlockId { id: 1 }), span: span_dummy() }
  })

  var copy_place = place_local(MirLocalId { id: 0 })
  for p in copy_proj do
    copy_place.projections.push(p)
  end
  let copy_rvalue = MirRvalue { kind: MirRvalueKind::MirBinOp(MirBinOp::Eq, operand_copy(copy_place), rhs), span: span_dummy() }
  let copy_stmt = MirStatement {
    kind: MirStatementKind::MirAssign(place_local(MirLocalId { id: 1 }), copy_rvalue),
    span: span_dummy()
  }

  if reinit then
    var re_place = place_local(MirLocalId { id: 0 })
    for p in copy_proj do
      re_place.projections.push(p)
    end
    let re_stmt = MirStatement {
      kind: MirStatementKind::MirAssign(re_place,
        MirRvalue { kind: MirRvalueKind::MirMove(operand_constant(MirConstant { kind: MirConstantKind::MirInt(0), ty: Type::Int, instance: Option::None })), span: span_dummy() }),
      span: span_dummy()
    }
    blocks.push(MirBlock {
      id: MirBlockId { id: 1 },
      statements: Vec::from([re_stmt]),
      terminator: MirTerminator { kind: MirTerminatorKind::MirGoto(MirBlockId { id: 2 }), span: span_dummy() }
    })
    blocks.push(MirBlock {
      id: MirBlockId { id: 2 },
      statements: Vec::from([copy_stmt]),
      terminator: MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() }
    })
  else
    blocks.push(MirBlock {
      id: MirBlockId { id: 1 },
      statements: Vec::from([copy_stmt]),
      terminator: MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() }
    })
  end

  MirFunction {
    name: name,
    params: Vec::from([param0, param1]),
    ret_type: Type::Unit,
    locals: Vec::from([temp2]),
    blocks: blocks,
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "",
    contracts: Vec::new(),
    span: span_dummy()
  }
end

# Test 21 — cross-block SIBLING copy: block0 moves _0.a (Int) out, the
# final block copies _0.b (Int) — the sibling chain is NOT moved — the
# copy is legal — ACCEPTED.
@test
def test_pos_cross_block_move_sibling_copy() -> Unit
  let defs = Vec::from([MirTypeDef {
    id: TypeId { id: 150 },
    name: "S".to_string(),
    kind: MirTypeDefKind::Struct(Vec::from([
      MirFieldDef { name: "a".to_string(), ty: Type::Int },
      MirFieldDef { name: "b".to_string(), ty: Type::Int }
    ])),
    generic_params: Vec::new()
  }])
  let move_proj = Vec::from([Projection::Field(FieldId { owner: TypeId { id: 150 }, index: 0 })])
  let copy_proj = Vec::from([Projection::Field(FieldId { owner: TypeId { id: 150 }, index: 1 })])
  let f = verifier_cross_block_fn("pos_cross_block_move_sibling_copy".to_string(), Type::Adt(TypeId { id: 150 }, Vec::new()), move_proj, copy_proj, Type::Int, operand_read(place_local(MirLocalId { id: 2 })), false)
  let errors = verifier_verify(f, defs)
  assert(errors.len() == 0, "test_pos_cross_block_move_sibling_copy: expected no errors, got " + errors.len().to_string() + (if errors.len() > 0 then ": " + errors[0] else "" end))
end

# Test 22 — cross-block copy of the MOVED field: block0 moves _0.a out,
# the final block copies _0.a — the moved chain flowed through the
# MirGoto edge — "copy of previously moved place" — REJECTED (exactly one
# error: the moved-state check fires, and the Int leaf keeps the
# ownership check quiet — the boundary is the moved state, not the type).
@test
def test_neg_cross_block_copy_moved_field() -> Unit
  let defs = Vec::from([MirTypeDef {
    id: TypeId { id: 150 },
    name: "S".to_string(),
    kind: MirTypeDefKind::Struct(Vec::from([
      MirFieldDef { name: "a".to_string(), ty: Type::Int },
      MirFieldDef { name: "b".to_string(), ty: Type::Int }
    ])),
    generic_params: Vec::new()
  }])
  let move_proj = Vec::from([Projection::Field(FieldId { owner: TypeId { id: 150 }, index: 0 })])
  let copy_proj = Vec::from([Projection::Field(FieldId { owner: TypeId { id: 150 }, index: 0 })])
  let f = verifier_cross_block_fn("neg_cross_block_copy_moved_field".to_string(), Type::Adt(TypeId { id: 150 }, Vec::new()), move_proj, copy_proj, Type::Int, operand_read(place_local(MirLocalId { id: 2 })), false)
  let errors = verifier_verify(f, defs)
  assert(errors.len() == 1, "test_neg_cross_block_copy_moved_field: expected exactly one error, got " + errors.len().to_string())
  assert(errors[0].contains("copy of previously moved place"), "test_neg_cross_block_copy_moved_field: expected the moved-place error, got: " + errors[0])
end

# Test 23 — cross-block WHOLE-ROOT copy after a partial move: block0
# moves _0.a out, the final block copies the WHOLE root _0 — the root's
# "" key is moved by the partial move (the partial root is not fully
# live) — REJECTED.
@test
def test_neg_cross_block_whole_root_copy_after_partial_move() -> Unit
  let defs = Vec::from([MirTypeDef {
