# Test 9 — Vec index projection, Copy element: MirCopy(_0[i]) where
# _0: Vec[Int] — the ProjIndex element type is the Vec's concrete arg —
# ACCEPTED.
@test
def test_pos_vec_index_int() -> Unit
  let defs = Vec::from([MirTypeDef {
    id: TypeId { id: 120 },
    name: "Vec".to_string(),
    kind: MirTypeDefKind::Struct(Vec::new()),
    generic_params: Vec::new()
