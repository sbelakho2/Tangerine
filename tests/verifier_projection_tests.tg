  let proj = Vec::from([Projection::ProjIndex(MirLocalId { id: 9 })])
  let f = verifier_copy_fn("pos_vec_index_int".to_string(), Type::Adt(TypeId { id: 120 }, Vec::from([Type::Int])), proj, Type::Int, int_const())
  let errors = verifier_verify(f, defs)
  assert(errors.len() == 0, "test_pos_vec_index_int: expected no errors, got " + errors.len().to_string() + (if errors.len() > 0 then ": " + errors[0] else "" end))
end

