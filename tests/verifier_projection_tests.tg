# Test 24 — cross-block REINITIALIZE then copy: block0 moves _0.a out,
# block1 STORES a constant back into _0.a (the store re-lives the chain —
# the checker's reinitialization of a moved-out slot), the final block
# copies _0.a — the re-lived chain makes the copy legal — ACCEPTED.
@test
def test_pos_cross_block_reinit_then_copy() -> Unit
  let defs = Vec::from([MirTypeDef {
    id: TypeId { id: 150 },
    name: "S".to_string(),
    kind: MirTypeDefKind::Struct(Vec::from([
      MirFieldDef { name: "a".to_string(), ty: Type::Int },
      MirFieldDef { name: "b".to_string(), ty: Type::Int }
    ])),
    generic_params: Vec::new()
  }])
  let move_proj = Vec::from([Projection::Field(FieldId { owner: TypeId { id: 150 }, index: 0 })])
  let copy_proj = Vec::from([Projection::Field(FieldId { owner: TypeId { id: 150 }, index: 0 })])
  let f = verifier_cross_block_fn("pos_cross_block_reinit_then_copy".to_string(), Type::Adt(TypeId { id: 150 }, Vec::new()), move_proj, copy_proj, Type::Int, operand_read(place_local(MirLocalId { id: 2 })), true)
  let errors = verifier_verify(f, defs)
  assert(errors.len() == 0, "test_pos_cross_block_reinit_then_copy: expected no errors, got " + errors.len().to_string() + (if errors.len() > 0 then ": " + errors[0] else "" end))
end
