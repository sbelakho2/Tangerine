# Test 11 — generic field becoming String after substitution: the wrapper
# def here is the POST-MONO concrete view (the layout engine's
# substitute_mir_fields output — the field is the CONCRETE String), and the
# local's type is the concrete instantiation Wrapper[String]. The post-mono
# verifier sees the concrete String in the projected field and rejects the
# bitwise copy.
@test
def test_neg_generic_field_string_after_substitution() -> Unit
  let defs = Vec::from([MirTypeDef {
    id: TypeId { id: 130 },
    name: "Wrapper".to_string(),
    kind: MirTypeDefKind::Struct(Vec::from([
      MirFieldDef { name: "item".to_string(), ty: Type::String }
    ])),
    generic_params: Vec::new()
  }])
  let proj = Vec::from([Projection::Field(FieldId { owner: TypeId { id: 130 }, index: 0 })])
  let f = verifier_copy_fn("neg_generic_field_string_after_substitution".to_string(), Type::Adt(TypeId { id: 130 }, Vec::from([Type::String])), proj, Type::String, string_const())
  let errors = verifier_verify(f, defs)
  assert(errors.len() == 1, "test_neg_generic_field_string_after_substitution: expected exactly one error, got " + errors.len().to_string())
  assert(errors[0].contains("MirCopy of non-trivially-copyable type string"), "test_neg_generic_field_string_after_substitution: expected the MirCopy error, got: " + errors[0])
end

# Test 12 — ProjDeref projection, Copy pointee: MirCopy(*_0) where
# _0: Ptr[Int] — ACCEPTED.
@test
def test_pos_deref_ptr_int() -> Unit
  let root_ty = Type::Ptr(Type::Int)
  let proj = Vec::from([Projection::ProjDeref])
  let f = verifier_copy_fn("pos_deref_ptr_int".to_string(), root_ty, proj, Type::Int, int_const())
  let errors = verifier_verify(f, Vec::new())
  assert(errors.len() == 0, "test_pos_deref_ptr_int: expected no errors, got " + errors.len().to_string() + (if errors.len() > 0 then ": " + errors[0] else "" end))
end

# Test 13 — ProjDeref through a COPYABLE root onto a non-Copy pointee:
# MirCopy(*_0) where _0: Ptr[String]. The ROOT (Ptr[String]) is bit-copyable
# (a raw pointer), but the projected VALUE is the String — REJECTED. This is
# the exact false-negative shape the root-only typing produced (the old
# check accepted the copy because the root is copyable).
@test
def test_neg_deref_ptr_string() -> Unit
  let root_ty = Type::Ptr(Type::String)
  let proj = Vec::from([Projection::ProjDeref])
  let f = verifier_copy_fn("neg_deref_ptr_string".to_string(), root_ty, proj, Type::String, string_const())
  let errors = verifier_verify(f, Vec::new())
  assert(errors.len() == 1, "test_neg_deref_ptr_string: expected exactly one error, got " + errors.len().to_string())
  assert(errors[0].contains("MirCopy of non-trivially-copyable type string"), "test_neg_deref_ptr_string: expected the MirCopy error, got: " + errors[0])
end
