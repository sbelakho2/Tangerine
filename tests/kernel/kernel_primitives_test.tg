## The kernel-primitives behavioral suite — the real implementations:
## the round-robin scheduler table, the CAS-backed mutex, the counting
## semaphore and the process control block table.

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::kernel::*
use std::test::*

@test
def test_scheduler_round_robin() -> Unit
  var sched = Scheduler::new()
  match sched.add_task(TaskControlBlock::new(1, "idle".to_string(), 0))
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("task registration failed")
  end
  match sched.add_task(TaskControlBlock::new(2, "worker".to_string(), 1))
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("task registration failed")
  end
  match sched.add_task(TaskControlBlock::new(3, "irq".to_string(), 2))
  when Result::Ok(_) then ()
  when Result::Err(_) then panic("task registration failed")
  end
  if sched.task_count() != 3 then
    panic("scheduler task count mismatch")
  end
  ## Advance: after the initial slice (10 ticks) the running task rotates.
  var current = sched.tick()
  if current < 0 then panic("tick must elect a running task") end
  match sched.running_task()
  when Option::Some(task) then
    if task.state != TaskState::Running then
      panic("tick must mark the running task")
    end
  when Option::None then panic("tick must elect a task")
  end
  ## The slice expiry rotates to the next task.
  var i = 0
  while i < 10 do
    current = sched.tick()
    i = i + 1
  end
  match sched.running_task()
  when Option::Some(task) then
    if task.id != 1 then
      panic("round robin must rotate back to task 1")
    end
  when Option::None then panic("scheduler lost the running task")
  end
end

@test
def test_mutex_acquire_release() -> Unit
  var m = Mutex::new()
  if m.is_locked() then
    panic("a new mutex must be unlocked")
  end
  let _ = m.lock()
  if !m.is_locked() then
    panic("lock must mark the mutex locked")
  end
  if !m.try_lock() then
    panic("try_lock must report the held lock")
  end
  m.unlock()
  if m.is_locked() then
    panic("unlock must release the mutex")
  end
  if !m.try_lock() then
    panic("try_lock must succeed after unlock")
  end
  m.unlock()
end

@test
def test_semaphore_counting() -> Unit
  var s = Semaphore::new(2, 4)
  if s.available() != 2 then
    panic("semaphore initial count mismatch")
  end
  if !s.try_acquire() then
    panic("semaphore acquire must succeed while the count is positive")
  end
  if !s.try_acquire() then
    panic("semaphore second acquire must succeed")
  end
  if s.try_acquire() then
    panic("semaphore must be exhausted at zero")
  end
  s.release()
  if s.available() != 1 then
    panic("semaphore release must restore one permit")
  end
end

@test
def test_process_table() -> Unit
  let pid = ProcessId::new(7)
  let pcb = ProcessControlBlock::new(pid.raw(), "demo".to_string(), 1)
  match register_process(pcb)
  when Result::Ok(registered) then
    if registered.raw() != 7 then
      panic("process registration pid mismatch")
    end
  when Result::Err(_) then panic("process registration failed")
  end
  match lookup_process(7)
  when Option::Some(found) then
    if found.name != "demo" then
      panic("process lookup name mismatch")
    end
  when Option::None then panic("process lookup failed")
  end
  if !set_process_state(7, ProcessState::Running) then
    panic("set_process_state must succeed for a registered pid")
  end
  match lookup_process(7)
  when Option::Some(found) then
    match found.state
    when ProcessState::Running then ()
    when _ then panic("process state update failed")
    end
  when Option::None then panic("process lookup failed after the state update")
  end
end

@test
def test_kernel_info() -> Unit
  let info = get_kernel_info()
  if info.version.len() == 0 then
    panic("kernel version must be non-empty")
  end
  if info.active_processes < 1 then
    panic("the idle process must always be registered")
  end
end
