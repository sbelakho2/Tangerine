# tests/allocator_large_test.tg — 64 KiB String grow/drop crossing the
# bump threshold.
#
# A String grown past 65536 bytes crosses the allocator's small/large
# boundary: the growth path allocates the new buffer through the large
# (mmap) path with the {marker = 1, total} header and releases the OLD
# buffer through _tg_mem_free (the 32768-byte buffer returns to the small
# free list; the 65536-byte buffer is munmap'd). The drop then munmaps
# the final large buffer and returns the object to the free list. The
# outstanding-bytes counter must return exactly to the baseline.

use std::core

extern def tg_allocator_outstanding_bytes() -> Int

# Grows a String to 65536 bytes and returns the allocator's outstanding
# bytes measured WHILE the string is still live (the large-path mapping
# is still outstanding). The String drops on the return edge, so the
# caller observes the post-drop accounting.
def grow_string() -> Int
  var s = String::new()
  var i = 0
  while i < 65536 do
    s.push('x')
    i = i + 1
  end
  if s.len() != 65536 then
    println("allocator_large: len = " + s.len().to_string())
    return -1
  end
  # Still live here: the buffer is the 131072-byte large-path mapping.
  let live = tg_allocator_outstanding_bytes()
  live
end

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  let before = tg_allocator_outstanding_bytes()

  let live = grow_string()
  if live == -1 then
    return 1
  end
  # While live, outstanding must be >= 65536 + the object — proof that
  # the large path (and its accounting) engaged.
  if live < before + 65536 then
    println("allocator_large: live outstanding = " + live.to_string() + " below the 64 KiB large-path floor")
    return 2
  end

  # The drop already ran on grow_string's return edge: the large buffer
  # was munmap'd, the object returned to the free list — the outstanding
  # counter must return exactly to the baseline.
  let after_drop = tg_allocator_outstanding_bytes()
  if after_drop != before then
    println("allocator_large: outstanding after drop = " + after_drop.to_string() + " expected " + before.to_string())
    return 3
  end
  0
end
