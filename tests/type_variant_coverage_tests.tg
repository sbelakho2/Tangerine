# tests/type_variant_coverage_tests.tg — the Type variant coverage suite
# (the coverage oracle for tg_compiler/types.tg's Type variant universe —
# oracle #4).
#
# EVERY Type variant is exercised:
#   - the source-producible variants live INLINE in this file as real,
#     type-correct specimen functions (the `# type-variant: <Name>` marker
#     sits directly above the construct whose checked type is the variant;
#     `tg check` on this file is the compile-positive proof);
#   - the checker-internal / MIR-internal variants with no source producer
#     (StaticStrPtr, Never, IntLiteral, Effect, Var, Param, Error) are
#     CONSTRUCTED by hand in the unit test and round-tripped through the
#     exhaustive kind-name function.
#
# The kind-name function is EXHAUSTIVE (no default arm): a variant missing
# from it is a compile error, so the enumeration can never drift from
# tg_compiler/types.tg. The unit test below constructs ALL 33 variants —
# the layout tests (tests/layout/ + tests/layout_tests.tg) exercise the
# same universe from the layout engine's side.
#
# The coverage oracle (scripts/check_variant_coverage.sh --domain type)
# scans this file for the marker + construct + construction fingerprints.
#
# Run with the repo root as the working directory:
#   tg test tests/type_variant_coverage_tests.tg

use std::core::Option
use std::collections::{Vec, Map, Set}
use std::test::*
use std::fs::{read_to_string}

use tg_compiler::lexer::{tokenize}
use tg_compiler::parser::{parse}
use tg_compiler::ast::{AccessConvention}
use tg_compiler::types::{Type, ParamType, TypeVarId, type_check}
use tg_compiler::ids::{TypeId, EffectId, ClosureId, GenericParamId, DefId, ModuleId}

# ———————————————————————————————————————————————————————————————
# The exhaustive kind-name function — every arm names the variant it
# handles; the compiler's exhaustiveness check fails the build if any
# variant is missing, so the enumeration IS tg_compiler/types.tg's.
# ———————————————————————————————————————————————————————————————

def type_kind_name(ty: Type) -> String
  match ty
  when Type::Unit then "Unit"
  when Type::Bool then "Bool"
  when Type::Int then "Int"
  when Type::UInt then "UInt"
  when Type::Float then "Float"
  when Type::Char then "Char"
  when Type::String then "String"
  when Type::StaticStrPtr then "StaticStrPtr"
  when Type::Never then "Never"
  when Type::I8 then "I8"
  when Type::I16 then "I16"
  when Type::I32 then "I32"
  when Type::I64 then "I64"
  when Type::I128 then "I128"
  when Type::U8 then "U8"
  when Type::U16 then "U16"
  when Type::U32 then "U32"
  when Type::U64 then "U64"
  when Type::U128 then "U128"
  when Type::ISize then "ISize"
  when Type::USize then "USize"
  when Type::F32 then "F32"
  when Type::F64 then "F64"
  when Type::IntLiteral(_) then "IntLiteral"
  when Type::Adt(_, _) then "Adt"
  when Type::FixedArray(_, _) then "FixedArray"
  when Type::FnPtr(_, _, _) then "FnPtr"
  when Type::Closure(_, _, _, _, _) then "Closure"
  when Type::RefInternal(_, _) then "RefInternal"
  when Type::Ptr(_) then "Ptr"
  when Type::PtrMut(_) then "PtrMut"
  when Type::Dyn(_) then "Dyn"
  when Type::Effect(_, _) then "Effect"
  when Type::Tuple(_) then "Tuple"
  when Type::Var(_) then "Var"
  when Type::Param(_) then "Param"
  when Type::Error then "Error"
  end
end

# ———————————————————————————————————————————————————————————————
# The inline specimen functions — the positive programs whose checked
# types are the variants. The `# type-variant: <Name>` marker sits
# directly above the construct (the fingerprint the oracle scans for).
# ———————————————————————————————————————————————————————————————

# type-variant: Unit
def t_unit() -> Unit
  ()
end

# type-variant: Bool
def t_bool(b: Bool) -> Bool
  b
end

# type-variant: Int
# type-variant: UInt
# type-variant: Float
# type-variant: Char
# type-variant: String
def t_primitives(a: Int, b: UInt, c: Float, d: Char, e: String) -> Int
  a
end

# type-variant: I8
# type-variant: I16
# type-variant: I32
# type-variant: I64
# type-variant: I128
# type-variant: U8
# type-variant: U16
# type-variant: U32
# type-variant: U64
# type-variant: U128
# type-variant: ISize
# type-variant: USize
# type-variant: F32
# type-variant: F64
def t_sized(a: i8, b: i16, c: i32, d: i64, e: i128,
            f: u8, g: u16, h: u32, i: u64, j: u128,
            k: isize, l: usize, m: f32, n: f64) -> Int
  a as Int
end

# type-variant: Adt
def t_adt(a: Vec[Int], b: Option[Int], c: Map[String, Int], d: Set[Int],
          e: Box[Int], f: Rc[Int], g: Slice[Int]) -> Int
  a.len()
end

# type-variant: FixedArray
def t_fixed(a: [Int; 3]) -> Int
  a[0]
end

# type-variant: FnPtr
def t_fnptr(g: fn(Int) -> Int) -> Int
  g(1)
end

# type-variant: Closure
def t_closure() -> Int
  let f = |x: Int| x * 2
  f(3)
end

# type-variant: RefInternal
extern def __intrinsic_type_probe(x: &Int) -> Int end

def t_refinternal() -> Int
  __intrinsic_type_probe(&1)
end

# type-variant: Ptr
# type-variant: PtrMut
def t_ptrs(a: *Int, b: *mut Int) -> Int
  let v = *a
  v
end

trait Drawable
  def draw(self: Drawable) -> Int
end

# type-variant: Dyn
def t_dyn(x: dyn Drawable) -> Int
  x.draw()
end

# type-variant: Tuple
def t_tuple(p: (Int, String)) -> Int
  p.0
end

# ———————————————————————————————————————————————————————————————
# The oracle tests
# ———————————————————————————————————————————————————————————————

# The in-process compile-positive proof: the specimen file parses and
# type-checks cleanly (every inline construct is a REAL positive program).
@test
def test_type_specimens_compile_cleanly() -> Unit
  match read_to_string("tests/type_variant_coverage_tests.tg")
  when Result::Ok(content) then
    let lexed = tokenize(content, "type_variant_coverage_tests.tg")
    let parsed = parse(lexed)
    assert(parsed.diagnostics.len() == 0,
      "the specimen file must parse cleanly: " + parsed.diagnostics.len().to_string() + " diagnostics")
    let errs = type_check(parsed.program)
    assert(errs.len() == 0,
      "the specimen file must type-check cleanly (the compile-positive proof): " + errs.len().to_string() + " errors")
  when Result::Err(e) then
    assert(false, "cannot read tests/type_variant_coverage_tests.tg: " + e.to_string())
  end
end

# The unit layer — EVERY Type variant constructed by hand and named (the
# checker-internal / MIR-internal forms: StaticStrPtr, Never, IntLiteral,
# Effect, Var, Param, Error — and the source-producible ones, pinned
# regardless of the resolution route).
@test
def test_all_type_variants_constructed() -> Unit
  let types = Vec::from([
    Type::Unit, Type::Bool, Type::Int, Type::UInt, Type::Float,
    Type::Char, Type::String,
    Type::StaticStrPtr, Type::Never,
    Type::I8, Type::I16, Type::I32, Type::I64, Type::I128,
    Type::U8, Type::U16, Type::U32, Type::U64, Type::U128,
    Type::ISize, Type::USize, Type::F32, Type::F64,
    Type::IntLiteral(7),
    Type::Adt(TypeId { id: 1 }, Vec::new()),
    Type::FixedArray(Type::Int, 3),
    Type::FnPtr(
      Vec::from([ParamType { ty: Type::Int, convention: AccessConvention::Let }]),
      Type::Int,
      Vec::new()),
    Type::Closure(ClosureId { id: 1 }, Vec::new(), Type::Unit, Type::Unit, Vec::new()),
    Type::RefInternal(Type::Int, false),
    Type::Ptr(Type::Int),
    Type::PtrMut(Type::Int),
    Type::Dyn(TypeId { id: 2 }),
    Type::Effect(Vec::from([EffectId { id: 1 }]), Type::Int),
    Type::Tuple(Vec::from([Type::Int, Type::String])),
    Type::Var(TypeVarId { id: 3 }),
    Type::Param(GenericParamId {
      owner: DefId { module: ModuleId { id: 0 }, index: 0 },
      index: 0
    }),
    Type::Error
  ])
  let expected = [
    "Unit", "Bool", "Int", "UInt", "Float", "Char", "String",
    "StaticStrPtr", "Never",
    "I8", "I16", "I32", "I64", "I128",
    "U8", "U16", "U32", "U64", "U128",
    "ISize", "USize", "F32", "F64",
    "IntLiteral", "Adt", "FixedArray", "FnPtr", "Closure", "RefInternal",
    "Ptr", "PtrMut", "Dyn", "Effect", "Tuple", "Var", "Param", "Error"
  ]
  assert(types.len() == 33, "all 33 Type variants must be constructed (got " + types.len().to_string() + ")")
  var seen: Vec[String] = Vec::new()
  for t in types do
    let name = type_kind_name(t)
    seen.push(name)
  end
  var missing: Vec[String] = Vec::new()
  for e in expected do
    var found = false
    for s in seen do
      if s == e then
        found = true
      end
    end
    if !found then
      missing.push(e)
    end
  end
  assert(missing.is_empty(), "Type variants never constructed/named: " + missing.join(", "))
end
