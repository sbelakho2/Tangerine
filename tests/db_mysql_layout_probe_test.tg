# tests/db_mysql_layout_probe_test.tg — the MySQL ABI probe (reviewer
# P0-17): the native shim (native/mysql_shims.c) prints and returns the
# C-side sizeof/_Alignof/offsetof facts of the real MYSQL_BIND, of
# MYSQL_FIELD, and of the two Tangerine-facing shim descriptors
# (tg_mysql_param / tg_mysql_result_cell); this test asserts the
# Tangerine @repr(C) layouts (MysqlParam / MysqlResultCell / MysqlField)
# against those facts. The MYSQL_BIND facts pin the LP64 layout the shim
# relies on internally. The probe is pure layout — it does not need the
# server, only the preloaded shim.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::alloc::{size_of, align_of}
use std::db::{MysqlParam, MysqlResultCell, MysqlField}

extern "C"
  def tg_mysql_layout_probe(out: PtrMut[i64], out_len: UInt) -> i32
end

# The probe's fact indices (the C side writes exactly 23 entries).
const PROBE_BIND_SIZE: UInt = 0
const PROBE_BIND_ALIGN: UInt = 1
const PROBE_BIND_LENGTH: UInt = 2
const PROBE_BIND_IS_NULL: UInt = 3
const PROBE_BIND_BUFFER: UInt = 4
const PROBE_BIND_BUFFER_LENGTH: UInt = 5
const PROBE_BIND_BUFFER_TYPE: UInt = 6
const PROBE_BIND_IS_UNSIGNED: UInt = 7
const PROBE_PARAM_SIZE: UInt = 8
const PROBE_PARAM_ALIGN: UInt = 9
const PROBE_PARAM_TYPE: UInt = 10
const PROBE_PARAM_DATA: UInt = 11
const PROBE_PARAM_LEN: UInt = 12
const PROBE_CELL_SIZE: UInt = 13
const PROBE_CELL_ALIGN: UInt = 14
const PROBE_CELL_BUFFER: UInt = 15
const PROBE_CELL_CAPACITY: UInt = 16
const PROBE_CELL_LENGTH: UInt = 17
const PROBE_CELL_IS_NULL: UInt = 18
const PROBE_CELL_TYPE: UInt = 19
const PROBE_FIELD_SIZE: UInt = 20
const PROBE_FIELD_NAME: UInt = 21
const PROBE_FIELD_TYPE: UInt = 22
const PROBE_COUNT: UInt = 23

def mysql_param_offset(type_: i32) -> i64
  var p = MysqlParam { type_: type_, data: null_ptr(), len: 0 }
  (address_of(&mut p.type_) as Int - address_of(&mut p) as Int) as i64
end

def mysql_param_data_offset() -> i64
  var p = MysqlParam { type_: 0, data: null_ptr(), len: 0 }
  (address_of(&mut p.data) as Int - address_of(&mut p) as Int) as i64
end

def mysql_param_len_offset() -> i64
  var p = MysqlParam { type_: 0, data: null_ptr(), len: 0 }
  (address_of(&mut p.len) as Int - address_of(&mut p) as Int) as i64
end

def mysql_cell_buffer_offset() -> i64
  var c = MysqlResultCell { buffer: null_ptr(), capacity: 0, length: null_ptr(), is_null: null_ptr(), type_: 0 }
  (address_of(&mut c.buffer) as Int - address_of(&mut c) as Int) as i64
end

def mysql_cell_capacity_offset() -> i64
  var c = MysqlResultCell { buffer: null_ptr(), capacity: 0, length: null_ptr(), is_null: null_ptr(), type_: 0 }
  (address_of(&mut c.capacity) as Int - address_of(&mut c) as Int) as i64
end

def mysql_cell_length_offset() -> i64
  var c = MysqlResultCell { buffer: null_ptr(), capacity: 0, length: null_ptr(), is_null: null_ptr(), type_: 0 }
  (address_of(&mut c.length) as Int - address_of(&mut c) as Int) as i64
end

def mysql_cell_is_null_offset() -> i64
  var c = MysqlResultCell { buffer: null_ptr(), capacity: 0, length: null_ptr(), is_null: null_ptr(), type_: 0 }
  (address_of(&mut c.is_null) as Int - address_of(&mut c) as Int) as i64
end

def mysql_cell_type_offset() -> i64
  var c = MysqlResultCell { buffer: null_ptr(), capacity: 0, length: null_ptr(), is_null: null_ptr(), type_: 0 }
  (address_of(&mut c.type_) as Int - address_of(&mut c) as Int) as i64
end

def mysql_field_name_offset() -> i64
  var f = MysqlField { name: null_ptr(), org_name: null_ptr(), table: null_ptr(), org_table: null_ptr(), db: null_ptr(), catalog: null_ptr(), def_: null_ptr(), length: 0, max_length: 0, name_length: 0, org_name_length: 0, table_length: 0, org_table_length: 0, db_length: 0, catalog_length: 0, def_length: 0, flags: 0, decimals: 0, charsetnr: 0, type_: 0 }
  (address_of(&mut f.name) as Int - address_of(&mut f) as Int) as i64
end

def mysql_field_type_offset() -> i64
  var f = MysqlField { name: null_ptr(), org_name: null_ptr(), table: null_ptr(), org_table: null_ptr(), db: null_ptr(), catalog: null_ptr(), def_: null_ptr(), length: 0, max_length: 0, name_length: 0, org_name_length: 0, table_length: 0, org_table_length: 0, db_length: 0, catalog_length: 0, def_length: 0, flags: 0, decimals: 0, charsetnr: 0, type_: 0 }
  (address_of(&mut f.type_) as Int - address_of(&mut f) as Int) as i64
end

@test
def test_mysql_shim_layout_probe_matches_tangerine_layouts() -> Unit
  var facts = Vec::new()
  var i: UInt = 0
  while i < PROBE_COUNT do
    facts.push(0i64)
    i = i + 1
  end
  let rc = unsafe "FFI boundary" do tg_mysql_layout_probe(facts.as_mut_ptr(), PROBE_COUNT) end
  assert_eq(rc as UInt, PROBE_COUNT)

  # The tg_mysql_param descriptor: the Tangerine @repr(C) layout must
  # match the C typedef exactly.
  assert_eq(size_of[MysqlParam]() as i64, facts[PROBE_PARAM_SIZE])
  assert_eq(align_of[MysqlParam]() as i64, facts[PROBE_PARAM_ALIGN])
  assert_eq(mysql_param_offset(0), facts[PROBE_PARAM_TYPE])
  assert_eq(mysql_param_data_offset(), facts[PROBE_PARAM_DATA])
  assert_eq(mysql_param_len_offset(), facts[PROBE_PARAM_LEN])

  # The tg_mysql_result_cell descriptor: same assertion.
  assert_eq(size_of[MysqlResultCell]() as i64, facts[PROBE_CELL_SIZE])
  assert_eq(align_of[MysqlResultCell]() as i64, facts[PROBE_CELL_ALIGN])
  assert_eq(mysql_cell_buffer_offset(), facts[PROBE_CELL_BUFFER])
  assert_eq(mysql_cell_capacity_offset(), facts[PROBE_CELL_CAPACITY])
  assert_eq(mysql_cell_length_offset(), facts[PROBE_CELL_LENGTH])
  assert_eq(mysql_cell_is_null_offset(), facts[PROBE_CELL_IS_NULL])
  assert_eq(mysql_cell_type_offset(), facts[PROBE_CELL_TYPE])

  # The hand-written MYSQL_FIELD mirror (the read-only metadata the
  # driver consumes) must match the real MYSQL_FIELD.
  assert_eq(size_of[MysqlField]() as i64, facts[PROBE_FIELD_SIZE])
  assert_eq(mysql_field_name_offset(), facts[PROBE_FIELD_NAME])
  assert_eq(mysql_field_type_offset(), facts[PROBE_FIELD_TYPE])

  # The real MYSQL_BIND facts — the LP64 layout the shim builds
  # internally: length@0, is_null@8, buffer@16, buffer_length@64,
  # buffer_type@96, is_unsigned@101, sizeof 128.
  assert_eq(facts[PROBE_BIND_LENGTH], 0)
  assert_eq(facts[PROBE_BIND_IS_NULL], 8)
  assert_eq(facts[PROBE_BIND_BUFFER], 16)
  assert_eq(facts[PROBE_BIND_BUFFER_LENGTH], 64)
  assert_eq(facts[PROBE_BIND_BUFFER_TYPE], 96)
  assert_eq(facts[PROBE_BIND_IS_UNSIGNED], 101)
  assert_eq(facts[PROBE_BIND_SIZE], 128)
  assert_eq(facts[PROBE_BIND_ALIGN], 8)
end
