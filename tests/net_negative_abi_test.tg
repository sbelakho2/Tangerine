# tests/net_negative_abi_test.tg — the 32-bit C-return ABI boundary.
#
# Every socket-family extern (socket/connect/close/recv/...) declares its
# C `int` return as i32; the std::net wrappers widen with the explicit
# `as Int`. A C -1 arrives in the LOW 32 bits of the return register
# (eax/w0) — the codegen normalizes (sign-extends) it at the extern
# boundary, so the wrapper's `< 0` error checks see the true -1. Without
# that sign-extension, -1 would read as +4294967295 (AArch64 zero-extends
# w0 into x0) and every error path below would silently pass a positive
# "count". These tests pin the negative return through the real libc.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::net
use std::net::{socket_addr_v4, ipv4_localhost, tcp_bind, tcp_connect}

@test
def test_socket_invalid_domain_sign_extends_negative() -> Unit
  # domain -1 is not a valid address family: the kernel answers
  # EAFNOSUPPORT, i.e. the C int -1 in the 32-bit result register. The
  # wrapper must deliver the sign-extended Int -1 — the `< 0` check is
  # the soundness assertion.
  let fd = std::net::socket(-1, std::net::SOCK_STREAM(), std::net::IPPROTO_TCP())
  assert_true(fd < 0)
  assert_eq(fd, -1)
end

@test
def test_close_on_invalid_fd_returns_negative() -> Unit
  # close(-1) → EBADF → -1 through the c_close wrapper.
  let ret = std::net::close(-1)
  assert_true(ret < 0)
  assert_eq(ret, -1)
end

@test
def test_recv_on_closed_socket_returns_negative() -> Unit
  # recv on a descriptor that was never opened → EBADF → -1. The ssize_t
  # return is the full 64-bit -1; the wrapper's `n < 0` error path must
  # fire.
  var buf: Vec[u8] = Vec::from([0u8])
  let n = std::net::recv(999999, buf.as_mut_ptr(), 1, 0)
  assert_true(n < 0)
  assert_eq(n, -1)
end

@test
def test_connect_on_invalid_fd_returns_negative() -> Unit
  # connect(-1, ...) → EBADF → -1 through the c_connect wrapper.
  let ret = std::net::connect(-1, Ptr::null() as Ptr[u8], 0)
  assert_true(ret < 0)
  assert_eq(ret, -1)
end

@test
def test_tcp_connect_refused_takes_wrapper_err_path() -> Unit
  # End-to-end wrapper Err path: bind a listener on a fixed loopback port,
  # close it (the OS sends RST for later connects), then connect — the
  # kernel answers ECONNREFUSED (-1), the wrapper's `result < 0` check
  # fires, and tcp_connect reports Result::Err instead of a bogus stream.
  let addr = socket_addr_v4(ipv4_localhost(), 38766u16)
  let listener = assert_ok(tcp_bind(addr))
  drop(listener)
  match tcp_connect(addr)
  when Result::Ok(_) then
    assert_false(true)
  when Result::Err(_) then
    assert_true(true)
  end
end
