# Regression test: multi-level (nested) field-address projection for method
# receivers.
#
# A method call borrows its receiver place (`&o.mid.inner`). The receiver
# address is computed by the canonical emit_place_address primitive, which
# must follow pointer-typed intermediate fields (mid, inner) and apply the
# final field offset so the method's `&self` reaches the correct object.
# If nested field addressing is wrong, sum() reads garbage instead of 42.

struct Inner
  x: Int
  y: Int
end

impl Inner
  def sum(&self) -> Int
    self.x + self.y
  end
end

struct Mid
  inner: Inner
  label: String
end

struct Outer
  mid: Mid
  tag: Int
end

def main() -> Int
  let o = Outer {
    mid: Mid {
      inner: Inner { x: 30, y: 12 },
      label: "mid"
    },
    tag: 7
  }
  let total = o.mid.inner.sum()
  if total != 42 then
    return 1
  end
  0
end
