# tests/riscv_float_rows_test.tg — the stage-2 riscv float slice's row
# pinning (NO gate: this suite is a documentation + regression pin of
# the hand-verified encoder bytes, the psABI float ABI geometry, the
# descriptor FP gate and the NaN-boxing boundaries — it does not compile
# or execute riscv programs).
#
# Every encoder row below is derived from the RISC-V F/D bit layouts
# documented in tg_compiler/backend_rv.tg (the same hand-verified
# comments the pure encoder set carries) and cross-checked against the
# already-verified RNE twins (a rounding/funct3 change is a single
# encoding field). The ABI rows pin the psABI flattening shared by
# lir.tg's lowering stream (lir_riscv_stack_mode) and backend_rv.tg's
# LirLoadFrame/LirPushArg arms:
#   - fa0..fa7 = f10..f17 for float arguments (independent per-class
#     numbering), scalar returns in fa0 = f10;
#   - float stack arguments after eight float positions, FIFO: one
#     8-byte slot on riscv64 with the F32 single in its low 4 bytes,
#     one 4-byte slot on riscv32; an F64 on riscv32 reserves its
#     even-based TWO 4-byte units and stores with fsd (the D unit is
#     present exactly where an F64 can exist — riscv32imafdc), with
#     the odd-unit alignment pad emitted as its own 4-byte push by the
#     marked lir.tg seam;
#   - the soft-float decision per descriptor (fpu None -> the
#     integer-convention seam rule; RVF -> S only; RVD -> S+D);
#   - F32 constants: the host-double payload is rounded to the
#     canonical single at COMPILE time (integer bit arithmetic only,
#     rv_f64_bits_to_f32_bits) and materialized with li32 + fmv.w.x on
#     every float-capable description — RVF (F only, FLEN 32) has no D
#     unit, so fcvt.s.d is never used for an F32 constant;
#   - the FLEN=64 NaN-boxing boundaries: F32 register moves/returns/
#     call captures use fsgnj.s (the boxing copy), FLW boxes on load,
#     fmv.w.x boxes its result.
#
# Two-float AGGREGATE returns (psABI fa0+fa1) are NOT expressible on
# this route: the LIR call/return shape carries ONE result vreg, the
# fixed float vreg 8 = fa0, and the riscv shape gate rejects aggregate
# locals — the two-register aggregate return is a shape-gate seam, not
# a backend gap (see the rows pinning the scalar return register).
#
# Run with: tg test tests/riscv_float_rows_test.tg

use std::core::{Option, Result, Unit, Bool, Int, panic}
use std::collections::{Vec, Map}
use std::test::*
use tg_compiler::asm::{buf_new, emit32_le}
use tg_compiler::lir::{
  LirAlloc, LirSeg, LirFpWidth, LirFpBinOp, LirStmtKind,
  lir_fixed_fp_base,
  lir_riscv_stack_mode, lir_riscv_stack_slot_bytes,
  lir_riscv_stack_slots_per16, lir_stack_stream_offset
}
use tg_compiler::target_desc::{
  riscv32imac_desc, riscv32imafc_desc, riscv32imafdc_desc,
  riscv64imac_desc, riscv64gc_desc, Fpu
}
use tg_compiler::backend_rv::{
  rv_fixed_fp_phys, rv_fp_phys_of, rv_fp_def_scratch, rv_fp_use_scratch,
  rv_nan_box_required, rv_float_desc_reject, rv_fp_mov_word,
  rv_phys_of, rv_f64_bits_to_f32_bits,
  rv_emit_new, rv_emit_stmt_kind,
  rv_fcvt_w_s_rtz, rv_fcvt_wu_s_rtz, rv_fcvt_l_s_rtz, rv_fcvt_lu_s_rtz,
  rv_fcvt_w_d_rtz, rv_fcvt_wu_d_rtz, rv_fcvt_l_d_rtz, rv_fcvt_lu_d_rtz,
  rv_fcvt_s_w, rv_fcvt_s_wu, rv_fcvt_s_l, rv_fcvt_s_lu,
  rv_fcvt_d_w, rv_fcvt_d_wu, rv_fcvt_d_l, rv_fcvt_d_lu,
  rv_emit_ftoi_nan_fixup
}

def rv_row_bytes_eq(a: Vec[u8], b: Vec[u8]) -> Bool
  if a.len() != b.len() then return false end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then return false end
    i = i + 1
  end
  true
end

def rv_row_check(what: String, actual: Vec[u8], expected: Vec[u8]) -> Unit
  if !rv_row_bytes_eq(actual, expected) then
    panic("riscv float row `" + what + "` mismatches the hand-verified bytes")
  end
end

def rv_row_words_eq(a: Vec[u32], b: Vec[u32]) -> Bool
  if a.len() != b.len() then return false end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then return false end
    i = i + 1
  end
  true
end

def rv_row_word_check(what: String, actual: Vec[u32], expected: Vec[u32]) -> Unit
  if !rv_row_words_eq(actual, expected) then
    panic("riscv float row `" + what + "` mismatches the documented words")
  end
end

def rv_row_alloc_fp(fp_widths: Map[Int, LirFpWidth], segs: Map[Int, Vec[LirSeg]], slots: Int) -> LirAlloc
  LirAlloc {
    slots: slots,
    frame_bytes: 16 * (slots + 1),
    segs_of: segs,
    spills: Vec::new(),
    reloads: Vec::new(),
    fp_widths: fp_widths
  }
end

def rv_row_reg_seg(vreg: Int, phys: Int) -> LirSeg
  LirSeg { start: 0, end: 0, vreg: vreg, phys: phys, slot: -1, needs_reload: false }
end

def rv_row_mem_seg(vreg: Int, slot: Int) -> LirSeg
  LirSeg { start: 0, end: 0, vreg: vreg, phys: -1, slot: slot, needs_reload: false }
end

def rv_row_fp_widths(pairs: Vec[(Int, LirFpWidth)]) -> Map[Int, LirFpWidth]
  var m: Map[Int, LirFpWidth] = Map::new()
  for p in pairs do
    m.insert(p.0, p.1)
  end
  m
end

def rv_row_segs(pairs: Vec[(Int, LirSeg)]) -> Map[Int, Vec[LirSeg]]
  var m: Map[Int, Vec[LirSeg]] = Map::new()
  for p in pairs do
    m.insert(p.0, Vec::from([p.1]))
  end
  m
end

# The desc-driven general pool rv_mdl_pool builds for the riscv
# descriptors: the callee-saved registers minus s0/fp, first six
# (s1..s6 = x9, x18..x22). The allocator's pool ids 9..14 index it.
def rv_row_mdl_pool() -> Vec[Int]
  Vec::from([9, 18, 19, 20, 21, 22])
end

def rv_row_desc_reject_is_none(o: Option[String]) -> Bool
  match o
  when Option::Some(_) then false
  when Option::None then true
  end
end

# The little-endian bytes of one u32 word (the emitter's wire order).
def rv_row_le(w: u32) -> Vec[u8]
  var b = buf_new()
  emit32_le(&mut b, w)
  b.bytes.clone()
end

# The little-endian bytes of a word sequence.
def rv_row_le_words(words: Vec[u32]) -> Vec[u8]
  var b = buf_new()
  for w in words do
    emit32_le(&mut b, w)
  end
  b.bytes.clone()
end

def rv_row_emit_words(kind: LirStmtKind, alloc: LirAlloc, mdl_pool: Vec[Int], pos: Int, xlen: Int, desc_name: String) -> Vec[u8]
  let desc = match desc_name
  when "riscv64gc" then riscv64gc_desc()
  when "riscv32imafdc" then riscv32imafdc_desc()
  when "riscv32imafc" then riscv32imafc_desc()
  when "riscv64imac" then riscv64imac_desc()
  when "riscv32imac" then riscv32imac_desc()
  when _ then panic("row: unknown desc " + desc_name)
  end
  var re = rv_emit_new()
  match rv_emit_stmt_kind(&mut re, alloc, mdl_pool, kind, pos, xlen, desc)
  when Result::Err(e) then panic("row: emit failed: " + e)
  when Result::Ok(_) then ()
  end
  re.buf.bytes.clone()
end

# ———————————————————————————————————————————————————————————————
# Encoder rows: the truncating (rm = RTZ) float -> int forms
# ———————————————————————————————————————————————————————————————

@test
def test_rv_fcvt_to_int_rtz_rows() -> Unit
  # The RNE twins are the verified set (fcvt.w.s = 0xC00100D3 etc.);
  # RTZ sets funct3 = 001, i.e. +0x1000.
  assert_true(rv_fcvt_w_s_rtz(1, 2) == 0xC00110D3)
  assert_true(rv_fcvt_wu_s_rtz(1, 2) == 0xC01110D3)
  assert_true(rv_fcvt_l_s_rtz(1, 2) == 0xC02110D3)
  assert_true(rv_fcvt_lu_s_rtz(1, 2) == 0xC03110D3)
  assert_true(rv_fcvt_w_d_rtz(1, 2) == 0xC20110D3)
  assert_true(rv_fcvt_wu_d_rtz(1, 2) == 0xC21110D3)
  assert_true(rv_fcvt_l_d_rtz(1, 2) == 0xC22110D3)
  assert_true(rv_fcvt_lu_d_rtz(1, 2) == 0xC23110D3)
end

# ———————————————————————————————————————————————————————————————
# Encoder rows: the int -> float forms (funct7 0x68 from S, 0x69 from
# D; rs2 selects w/wu/l/lu; rm = RNE)
# ———————————————————————————————————————————————————————————————

@test
def test_rv_fcvt_from_int_rows() -> Unit
  assert_true(rv_fcvt_s_w(1, 2) == 0xD00100D3)
  assert_true(rv_fcvt_s_wu(1, 2) == 0xD01100D3)
  assert_true(rv_fcvt_s_l(1, 2) == 0xD02100D3)
  assert_true(rv_fcvt_s_lu(1, 2) == 0xD03100D3)
  assert_true(rv_fcvt_d_w(1, 2) == 0xD20100D3)
  assert_true(rv_fcvt_d_wu(1, 2) == 0xD21100D3)
  assert_true(rv_fcvt_d_l(1, 2) == 0xD22100D3)
  assert_true(rv_fcvt_d_lu(1, 2) == 0xD23100D3)
end

# ———————————————————————————————————————————————————————————————
# The fa0..fa7 register model (independent float numbering) and the
# NaN-boxing boundaries
# ———————————————————————————————————————————————————————————————

@test
def test_rv_float_register_model_rows() -> Unit
  # Fixed float vreg 8..15 -> fa0..fa7 = f10..f17.
  assert_eq(lir_fixed_fp_base(), 8)
  assert_true(rv_fixed_fp_phys(8) == 10)
  assert_true(rv_fixed_fp_phys(9) == 11)
  assert_true(rv_fixed_fp_phys(15) == 17)
  # The allocatable pool phys ids are 100 + the f-register code.
  assert_true(rv_fp_phys_of(100) == 0)
  assert_true(rv_fp_phys_of(128) == 28)
  # The reserved statement temps.
  assert_true(rv_fp_def_scratch() == 30)
  assert_true(rv_fp_use_scratch() == 31)
end

@test
def test_rv_nan_box_boundary_rows() -> Unit
  # FLEN = 64 (RVD) boxes narrower values; FLEN = 32 (RVF) does not;
  # F64 needs no boxing anywhere.
  assert_true(rv_nan_box_required(riscv64gc_desc(), LirFpWidth::LirF32))
  assert_true(rv_nan_box_required(riscv32imafdc_desc(), LirFpWidth::LirF32))
  assert_true(!rv_nan_box_required(riscv32imafc_desc(), LirFpWidth::LirF32))
  assert_true(!rv_nan_box_required(riscv64gc_desc(), LirFpWidth::LirF64))
  # The F32 boxing copy is fsgnj.s (there is no fmov.s); the F64 copy
  # is a plain fsgnj.d. These are the register-move/return/capture
  # words: fsgnj.s f0,f0,f0 and fsgnj.d f0,f0,f0.
  assert_true(rv_fp_mov_word(LirFpWidth::LirF32, 0, 0) == 0x20000053)
  assert_true(rv_fp_mov_word(LirFpWidth::LirF64, 0, 0) == 0x22000053)
  # The float RETURN register (fixed id 8) boxing move: fsgnj.s
  # f10,f0,f0.
  assert_true(rv_fp_mov_word(LirFpWidth::LirF32, rv_fixed_fp_phys(8), 0) == 0x20000553)
end

# ———————————————————————————————————————————————————————————————
# The soft-float / RVF / RVD descriptor decision
# ———————————————————————————————————————————————————————————————

@test
def test_rv_float_desc_decision_rows() -> Unit
  # The S+D instances accept the full float surface.
  assert_true(rv_row_desc_reject_is_none(rv_float_desc_reject(riscv64gc_desc(), true)))
  assert_true(rv_row_desc_reject_is_none(rv_float_desc_reject(riscv64gc_desc(), false)))
  assert_true(rv_row_desc_reject_is_none(rv_float_desc_reject(riscv32imafdc_desc(), true)))
  # RVF admits the S surface only: an F64 value fails closed.
  assert_true(rv_row_desc_reject_is_none(rv_float_desc_reject(riscv32imafc_desc(), false)))
  let rvf_f64 = rv_float_desc_reject(riscv32imafc_desc(), true)
  match rvf_f64
  when Option::Some(msg) then assert_true(msg.contains("RVF"))
  when Option::None then panic("riscv32imafc + F64 must fail closed")
  end
  # The Soft descriptions (fpu None) fail closed with the psABI
  # integer-convention seam rule on ANY float value.
  let soft64 = rv_float_desc_reject(riscv64imac_desc(), false)
  match soft64
  when Option::Some(msg) then assert_true(msg.contains("soft-float"))
  when Option::None then panic("riscv64imac + floats must fail closed")
  end
  let soft32 = rv_float_desc_reject(riscv32imac_desc(), true)
  match soft32
  when Option::Some(msg) then assert_true(msg.contains("INTEGER BIT PATTERNS"))
  when Option::None then panic("riscv32imac + floats must fail closed")
  end
  # Descriptor data sanity (the fpu token the decision reads).
  assert_true(riscv64gc_desc().fpu == Fpu::RVD)
  assert_true(riscv32imafc_desc().fpu == Fpu::RVF)
  assert_true(riscv64imac_desc().fpu == Fpu::None)
end

# ———————————————————————————————————————————————————————————————
# The riscv psABI stack stream (float params 9.. and beyond)
# ———————————————————————————————————————————————————————————————

@test
def test_rv_stack_stream_rows() -> Unit
  # The mode decision: the riscv entries (rv_atomics, never
  # param_stack_mode) select the psABI stream.
  assert_true(lir_riscv_stack_mode(true, false))
  assert_true(!lir_riscv_stack_mode(true, true))
  assert_true(!lir_riscv_stack_mode(false, false))
  # Slot units: 8 bytes on riscv64, 4 on riscv32.
  assert_true(lir_riscv_stack_slot_bytes(true) == 8)
  assert_true(lir_riscv_stack_slot_bytes(false) == 4)
  # The 16-byte-SP pad targets.
  assert_true(lir_riscv_stack_slots_per16(true) == 2)
  assert_true(lir_riscv_stack_slots_per16(false) == 4)
  # The stack-argument byte offsets (incoming-SP-relative): the ninth
  # FLOAT parameter (stack index 0 after eight fa registers) sits at
  # byte 0 of the stream, and the (8+k)-th stacked argument at 8*k on
  # riscv64 / 4*k on riscv32.
  assert_true(lir_stack_stream_offset(false, true, true, 0) == 0)
  assert_true(lir_stack_stream_offset(false, true, true, 1) == 8)
  assert_true(lir_stack_stream_offset(false, true, true, 8) == 64)
  assert_true(lir_stack_stream_offset(false, true, false, 8) == 32)
  # The aarch64/cortex-m formulas are unchanged.
  assert_true(lir_stack_stream_offset(false, false, false, 0) == 16)
  assert_true(lir_stack_stream_offset(true, false, false, 0) == 8)
end

# ———————————————————————————————————————————————————————————————
# Opened emitter arms: the F32/F64 move boxing, arithmetic, negate,
# the float-to-int NaN fixup and the memory-operand reloads
# ———————————————————————————————————————————————————————————————

@test
def test_rv_fmove_emits_boxing_copy_rows() -> Unit
  # LirFMove(F32) register -> register uses fsgnj.s (the boxing copy).
  let alloc = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(16, LirFpWidth::LirF32), (17, LirFpWidth::LirF32)])),
    rv_row_segs(Vec::from([(16, rv_row_reg_seg(16, 100)), (17, rv_row_reg_seg(17, 101))])),
    4
  )
  rv_row_check(
    "fmove f32 r,r",
    rv_row_emit_words(LirStmtKind::LirFMove(17, 16), alloc, Vec::new(), 0, 8, "riscv64gc"),
    rv_row_le(0x200000D3)
  )
  # LirFMove(F64) uses fsgnj.d.
  let alloc64 = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(16, LirFpWidth::LirF64), (17, LirFpWidth::LirF64)])),
    rv_row_segs(Vec::from([(16, rv_row_reg_seg(16, 100)), (17, rv_row_reg_seg(17, 101))])),
    4
  )
  rv_row_check(
    "fmove f64 r,r",
    rv_row_emit_words(LirStmtKind::LirFMove(17, 16), alloc64, Vec::new(), 0, 8, "riscv64gc"),
    rv_row_le(0x220000D3)
  )
end

@test
def test_rv_fbinop_and_fneg_arm_rows() -> Unit
  # fadd.s f0, f0, f0 and fneg.s f0, f0 on register operands (the one
  # allocated F32 vreg 16 -> pool phys 100 = f0 serves as dst and both
  # operands).
  let alloc = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(16, LirFpWidth::LirF32)])),
    rv_row_segs(Vec::from([(16, rv_row_reg_seg(16, 100))])),
    4
  )
  rv_row_check(
    "fadd.s r,r,r",
    rv_row_emit_words(LirStmtKind::LirFBinop(LirFpBinOp::LirFAdd, LirFpWidth::LirF32, 16, 16, 16), alloc, Vec::new(), 0, 8, "riscv64gc"),
    rv_row_le(0x00000053)
  )
  rv_row_check(
    "fneg.s r,r",
    rv_row_emit_words(LirStmtKind::LirFNeg(LirFpWidth::LirF32, 16, 16), alloc, Vec::new(), 0, 8, "riscv64gc"),
    rv_row_le(0x20001053)
  )
  # fsub.d f0, f0, f0: funct7 0000101 (0x05), rs2 = rs1 = rd = f0.
  let alloc64 = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(16, LirFpWidth::LirF64)])),
    rv_row_segs(Vec::from([(16, rv_row_reg_seg(16, 100))])),
    4
  )
  rv_row_check(
    "fsub.d r,r,r",
    rv_row_emit_words(LirStmtKind::LirFBinop(LirFpBinOp::LirFSub, LirFpWidth::LirF64, 16, 16, 16), alloc64, Vec::new(), 0, 8, "riscv64gc"),
    rv_row_le(0x0A000053)
  )
end

@test
def test_rv_memory_operand_reload_rows() -> Unit
  # A memory-resident F32 operand reloads with FLW from its spill slot
  # (8 bytes per slot on riscv64 — slot 1 = [s0 + 8]) and the def is
  # register-resident: flw f30, 8(s0); fsgnj.s f1, f30, f30.
  let alloc = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(16, LirFpWidth::LirF32), (17, LirFpWidth::LirF32)])),
    rv_row_segs(Vec::from([(16, rv_row_mem_seg(16, 1)), (17, rv_row_reg_seg(17, 101))])),
    4
  )
  var expected: Vec[u8] = rv_row_le_words(Vec::from([0x00842F07, 0x21EF00D3]))
  rv_row_check(
    "fmove f32 mem,r (flw reload)",
    rv_row_emit_words(LirStmtKind::LirFMove(17, 16), alloc, Vec::new(), 0, 8, "riscv64gc"),
    expected
  )
end

@test
def test_rv_float_to_int_nan_fixup_row() -> Unit
  # LirFloatToInt(F32): fcvt.w.s.rtz x9, f0; feq.s t0, f0, f0; sub t0,
  # x0, t0; and x9, x9, t0 — the §25 NaN -> 0 fixup (the dst is the
  # general pool register: rv_phys_of maps pool id 9 to mdl_pool[0] =
  # x9 = s1; the mask scratch avoids the dst and lands in t0).
  let alloc = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(16, LirFpWidth::LirF32)])),
    rv_row_segs(Vec::from([
      (16, rv_row_reg_seg(16, 100)),
      (18, rv_row_reg_seg(18, 9))
    ])),
    4
  )
  var expected: Vec[u8] = rv_row_le_words(Vec::from([
    0xC00014D3, 0xA00022D3, 0x405002B3, 0x0054F4B3
  ]))
  rv_row_check(
    "float-to-int f32 + NaN fixup",
    rv_row_emit_words(LirStmtKind::LirFloatToInt(LirFpWidth::LirF32, 18, 16), alloc, rv_row_mdl_pool(), 0, 8, "riscv64gc"),
    expected
  )
end

@test
def test_rv_fcvt_and_int_to_float_arm_rows() -> Unit
  # LirFcvt(F32 -> F64) is fcvt.d.s f1, f0.
  let alloc = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(16, LirFpWidth::LirF32), (17, LirFpWidth::LirF64)])),
    rv_row_segs(Vec::from([(16, rv_row_reg_seg(16, 100)), (17, rv_row_reg_seg(17, 101))])),
    4
  )
  rv_row_check(
    "fcvt.d.s r,r",
    rv_row_emit_words(LirStmtKind::LirFcvt(LirFpWidth::LirF32, 17, 16), alloc, Vec::new(), 0, 8, "riscv64gc"),
    rv_row_le(0x420000D3)
  )
  # LirIntToFloat(F64, unsigned) from the pool register x9 (pool id 9
  # -> mdl_pool[0] = s1 = x9): fcvt.d.lu f1, x9.
  let alloc_i2f = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(17, LirFpWidth::LirF64)])),
    rv_row_segs(Vec::from([
      (16, rv_row_reg_seg(16, 9)),
      (17, rv_row_reg_seg(17, 101))
    ])),
    4
  )
  rv_row_check(
    "fcvt.d.lu r,r",
    rv_row_emit_words(LirStmtKind::LirIntToFloat(LirFpWidth::LirF64, 17, 16, true), alloc_i2f, rv_row_mdl_pool(), 0, 8, "riscv64gc"),
    rv_row_le(0xD23480D3)
  )
  # On riscv32 the 32-bit-source forms are the width-correct mapping:
  # fcvt.s.w f1, x9.
  let alloc_rv32 = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(17, LirFpWidth::LirF32)])),
    rv_row_segs(Vec::from([
      (16, rv_row_reg_seg(16, 9)),
      (17, rv_row_reg_seg(17, 101))
    ])),
    4
  )
  rv_row_check(
    "fcvt.s.w r,r (rv32 word model)",
    rv_row_emit_words(LirStmtKind::LirIntToFloat(LirFpWidth::LirF32, 17, 16, false), alloc_rv32, rv_row_mdl_pool(), 0, 4, "riscv32imafdc"),
    rv_row_le(0xD00480D3)
  )
end

@test
def test_rv_stack_argument_push_rows() -> Unit
  # LirPushArg of an F32 value (register-resident f0): sub sp, 8; fsw
  # f0, 0(sp) — the psABI flattening (the single in the slot's low 4
  # bytes), one 8-byte slot on riscv64.
  let alloc = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(16, LirFpWidth::LirF32)])),
    rv_row_segs(Vec::from([(16, rv_row_reg_seg(16, 100))])),
    4
  )
  var expected: Vec[u8] = rv_row_le_words(Vec::from([0xFF810113, 0x00012027]))
  rv_row_check(
    "push f32 (rv64 slot)",
    rv_row_emit_words(LirStmtKind::LirPushArg(16), alloc, Vec::new(), 0, 8, "riscv64gc"),
    expected
  )
  # On riscv32 the same statement pushes a 4-byte slot: sub sp, 4; fsw
  # f0, 0(sp).
  var expected32: Vec[u8] = rv_row_le_words(Vec::from([0xFFC10113, 0x00012027]))
  rv_row_check(
    "push f32 (rv32 word slot)",
    rv_row_emit_words(LirStmtKind::LirPushArg(16), alloc, Vec::new(), 0, 4, "riscv32imafdc"),
    expected32
  )
end

@test
def test_rv_f64_stack_push_rv32_rows() -> Unit
  # An F64 stack-argument push on riscv32 reserves the psABI pair's TWO
  # 4-byte units (sub sp, sp, 8) and stores the one 8-byte double image
  # with fsd — a RISC-V D f-register is a single 64-bit register (the S
  # forms read only its low 32 bits; there is no high-half s(2k+1)
  # view), and fsd is available exactly where an F64 can exist
  # (riscv32imafdc). The lowering's odd-unit alignment pad below the
  # pair is emitted as its own 4-byte push (the marked lir.tg seam), so
  # the push statements' unit count still equals the terminator's
  # stack_args.
  let alloc = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(16, LirFpWidth::LirF64)])),
    rv_row_segs(Vec::from([(16, rv_row_reg_seg(16, 100))])),
    4
  )
  var expected: Vec[u8] = rv_row_le_words(Vec::from([0xFF810113, 0x00013027]))
  rv_row_check(
    "push f64 (rv32 two-unit slot)",
    rv_row_emit_words(LirStmtKind::LirPushArg(16), alloc, Vec::new(), 0, 4, "riscv32imafdc"),
    expected
  )
end

@test
def test_rv_general_pool_phys_mapping_rows() -> Unit
  # The allocator's general pool ids 9..14 INDEX mdl_pool (s1..s6 =
  # x9, x18..x22) — the exact registers rv_saved_regs(mdl_pool) saves,
  # so every allocated register is callee-preserved. (The pre-fix
  # fixed-vreg fall-through mapped id 9 to x19 = s3 and 12..14 to
  # x22..x24 = s6..s8: s7/s8 were never saved — the audit residue.)
  assert_true(rv_phys_of(rv_row_mdl_pool(), 9) == 9)
  assert_true(rv_phys_of(rv_row_mdl_pool(), 10) == 18)
  assert_true(rv_phys_of(rv_row_mdl_pool(), 11) == 19)
  assert_true(rv_phys_of(rv_row_mdl_pool(), 12) == 20)
  assert_true(rv_phys_of(rv_row_mdl_pool(), 13) == 21)
  assert_true(rv_phys_of(rv_row_mdl_pool(), 14) == 22)
end

@test
def test_rv_f64_bits_to_f32_bits_rows() -> Unit
  # The compile-time RNE double -> single narrowing (integer bit
  # arithmetic only — the compiler performs no host-side float math).
  # Exact and borderline values, including the subnormal single range
  # and the ties-to-even rule.
  assert_true(rv_f64_bits_to_f32_bits(0x3FF0000000000000) == 0x3F800000)   # 1.0
  assert_true(rv_f64_bits_to_f32_bits(0x3FB999999999999A) == 0x3DCCCCCD)   # 0.1, RNE
  # -0.0's double bits are INT64_MIN (the wrapped host pattern).
  assert_true(rv_f64_bits_to_f32_bits(-9223372036854775807 - 1) == 0x80000000)   # -0.0
  assert_true(rv_f64_bits_to_f32_bits(0x0000000000000001) == 0x00000000)   # min double subnormal -> +0
  assert_true(rv_f64_bits_to_f32_bits(0x3FF0000010000000) == 0x3F800000)   # 1 + 2^-24 tie -> even
  assert_true(rv_f64_bits_to_f32_bits(0x3FF0000030000000) == 0x3F800002)   # 1 + 3*2^-24 tie -> even
  assert_true(rv_f64_bits_to_f32_bits(0x36A0000000000000) == 0x00000001)   # 2^-149, min single subnormal
  assert_true(rv_f64_bits_to_f32_bits(0x3690000000000000) == 0x00000000)   # 2^-150, halfway -> even zero
  assert_true(rv_f64_bits_to_f32_bits(0x47EFFFFFE0000000) == 0x7F7FFFFF)   # f32 max
end

@test
def test_rv_f32_const_f_only_li_fmv_rows() -> Unit
  # The F-only F32-constant path (the RVF residue): no D unit, so no
  # fcvt.s.d — the compile-time-rounded single pattern is built with
  # rv_emit_li32 (t0) and moved by fmv.w.x (F includes fmv.w.x at both
  # xlens; on FLEN 64 it NaN-boxes). 1.0: single 0x3F800000 -> lui t0,
  # 0x3F800; fmv.w.x f1, t0.
  let alloc = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(17, LirFpWidth::LirF32)])),
    rv_row_segs(Vec::from([(17, rv_row_reg_seg(17, 101))])),
    4
  )
  rv_row_check(
    "fconst f32 rvf (1.0)",
    rv_row_emit_words(LirStmtKind::LirFConst(LirFpWidth::LirF32, 17, 0x3FF0000000000000), alloc, Vec::new(), 0, 4, "riscv32imafc"),
    rv_row_le_words(Vec::from([0x3F8002B7, 0xF00280D3]))
  )
  # 0.1's host double (0x3FB999999999999A) rounds RNE to the single
  # 0x3DCCCCCD: lui t0, 0x3DCCD; addi t0, t0, -0x333; fmv.w.x f1, t0.
  rv_row_check(
    "fconst f32 rvf (0.1, RNE rounding)",
    rv_row_emit_words(LirStmtKind::LirFConst(LirFpWidth::LirF32, 17, 0x3FB999999999999A), alloc, Vec::new(), 0, 4, "riscv32imafc"),
    rv_row_le_words(Vec::from([0x3DCCD2B7, 0xCCD28293, 0xF00280D3]))
  )
  # -0.0f32: the single pattern 0x80000000 (the high lui field carries
  # the sign bit, so the literal's signed-field value is -0x80000):
  # lui t0, -0x80000; fmv.w.x f1, t0. The double payload is INT64_MIN.
  rv_row_check(
    "fconst f32 rvf (-0.0, signed hi20)",
    rv_row_emit_words(LirStmtKind::LirFConst(LirFpWidth::LirF32, 17, -9223372036854775807 - 1), alloc, Vec::new(), 0, 4, "riscv32imafc"),
    rv_row_le_words(Vec::from([0x800002B7, 0xF00280D3]))
  )
  # The same li32 + fmv.w.x path on the FLEN 64 descriptions (fmv.w.x
  # NaN-boxes the result there).
  rv_row_check(
    "fconst f32 rvd (1.0)",
    rv_row_emit_words(LirStmtKind::LirFConst(LirFpWidth::LirF32, 17, 0x3FF0000000000000), alloc, Vec::new(), 0, 8, "riscv64gc"),
    rv_row_le_words(Vec::from([0x3F8002B7, 0xF00280D3]))
  )
end

@test
def test_rv_fconst_rv32_transit_row() -> Unit
  # RV32 F64 constant: the host-double pattern (1.0 =
  # 0x3FF0000000000000) is built in t0/t1, stored to the reserved
  # transit word at [s0 + 16] and loaded with fld — the RV32 GP -> FPR
  # transit (RV32D has no fmv.d.x). Words: lui t0, 0; lui t1, 0x3FF00;
  # sw t0, 16(s0); sw t1, 20(s0); fld f1, 16(s0). (F32 constants no
  # longer use the transit: they take the li32 + fmv.w.x path above.)
  let alloc = rv_row_alloc_fp(
    rv_row_fp_widths(Vec::from([(17, LirFpWidth::LirF64)])),
    rv_row_segs(Vec::from([(17, rv_row_reg_seg(17, 101))])),
    4
  )
  var re = rv_emit_new()
  re.fp_transit = 16
  match rv_emit_stmt_kind(&mut re, alloc, Vec::new(), LirStmtKind::LirFConst(LirFpWidth::LirF64, 17, 0x3FF0000000000000), 0, 4, riscv32imafdc_desc())
  when Result::Err(e) then panic("row: RV32 F64 constant emit failed: " + e)
  when Result::Ok(_) then ()
  end
  rv_row_check(
    "fconst f64 (rv32 transit)",
    re.buf.bytes.clone(),
    rv_row_le_words(Vec::from([
      0x000002B7, 0x3FF00337, 0x00542823, 0x00642A23, 0x01043087
    ]))
  )
end
