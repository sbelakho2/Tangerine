# tests/mono_instance_key_test.tg — the structured generic-instance keys
# unit suite (audit item 49; fourth-audit P0-5/P0-6):
# tg_compiler/stable_ids.tg section 9 (CanonicalTypeKey /
# CanonicalConstValue / CanonicalGenericArg / StructuralInstanceId —
# digest-word identity, never a "$"-joined text), the documented ConstSym
# identity-normalization model in tg_compiler/types.tg
# (const_sym_tree_fold_identities through const_sym_fold_type), the
# P0-5 CROSS-KIND ORDER guarantee (the args live in ONE vector in declared
# position order: [Type A, Const 3] != [Const 3, Type A]) and the mono
# instance-identity boundary's structural re-key
# (MonoCache.instances: Map[StructuralInstanceId, MirFunction]).
#
# The normalization contract under test (the ONLY declared equivalences):
#   N + 0 -> N    0 + N -> N    N * 1 -> N
# Commutativity is NOT normalized: `2 * N` vs `N * 2` (and the
# literal-left `1 * N`) stay DIFFERENT symbolic trees — the audit's
# syntax==semantic-conflation warning: no algebraic rewrite exists beyond
# the documented identity rules.
#
# Run with the repo root as the working directory:
#   tg test tests/mono_instance_key_test.tg

use std::core::{Option}
use std::collections::{Vec, Map}
use std::test::assert

use tg_compiler::mono::{
  mono_cache_new, mono_cache_bind_stable_callable, mono_specialize_function,
  structured_instance_key, type_to_mangled, MonoCache
}
use tg_compiler::ast::{Program, Crate, Module}
use tg_compiler::resolver::{ResolvedNames, stable_id_map_new}
use tg_compiler::mir::{MirFunction, MirBlockId, MirProgram}
use tg_compiler::ids::{DefKind, GenericParamId, CallableId, InstanceId, DefId, ModuleId}
use tg_compiler::types::{
  Type, ConstExprT, const_sym_tree_fold_identities, const_sym_fold_type,
  const_sym_tree_eq
}
use tg_compiler::stable_ids::{
  instance_key_of, instance_key_of_renders, instance_key_to_text,
  instance_key_eq, canonical_const_value_of, canonical_const_of_segment,
  canonical_type_key_of, canonical_generic_arg_text,
  stable_decl_id_of_lineage_texts_named,
  structural_instance_mangle_text,
  CanonicalGenericArg
}
use tg_compiler::token::span_dummy

# The const-parameter leaf of THIS suite: one parameter (owner DefId
# { module 0, index 0 }, parameter index 0 — the same hand-built identity
# shape the mono_arity suite uses).
def p0() -> ConstExprT
  ConstExprT::ConstParamRef(GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 0 })
end

# The canonical fn-owner-style callable key text of the suite's instances.
def callable_key() -> String
  "audit49::3::fn".to_string()
end

# A one-element render list.
def one_render(render: String) -> Vec[String]
  Vec::from([render])
end

def fresh_cache() -> MonoCache
  mono_cache_new(
    Program { items: Vec::new(), crate: Crate { root: ModuleId { id: 0 }, modules: Map::new() }, span: span_dummy() },
    ResolvedNames {
      expr_resolutions: Map::new(),
      type_resolutions: Map::new(),
      pattern_resolutions: Map::new(),
      call_targets: Map::new(),
      type_def_ids: Map::new(),
      intrinsic_ids: Map::new(),
      item_defs: Map::new(),
      module_symbols: Map::new(),
      def_kinds: Map::new(),
      stable_ids: stable_id_map_new()
    }
  )
end

# ———— The documented identity normalization (types.tg fold helpers) ————

# N + 0 -> N and 0 + N -> N: both spellings fold to the bare parameter
# tree.
@test
def test_fold_add_zero_right() -> Unit
  let n = p0()
  let expr = ConstExprT::ConstAdd(p0(), ConstExprT::ConstLit(0))
  let folded = const_sym_tree_fold_identities(&expr)
  assert(const_sym_tree_eq(&folded, &n), "N + 0 must fold to N (the documented identity rule)")
end

@test
def test_fold_add_zero_left() -> Unit
  let n = p0()
  let expr = ConstExprT::ConstAdd(ConstExprT::ConstLit(0), p0())
  let folded = const_sym_tree_fold_identities(&expr)
  assert(const_sym_tree_eq(&folded, &n), "0 + N must fold to N (the documented identity rule)")
end

# N * 1 -> N (the documented multiplication identity).
@test
def test_fold_mul_one_right() -> Unit
  let n = p0()
  let expr = ConstExprT::ConstMul(p0(), ConstExprT::ConstLit(1))
  let folded = const_sym_tree_fold_identities(&expr)
  assert(const_sym_tree_eq(&folded, &n), "N * 1 must fold to N (the documented identity rule)")
end

# The literal-LEFT multiplication spelling `1 * N` is NOT folded
# (commutativity is not normalized — the model is exactly N * 1).
@test
def test_fold_mul_one_left_not_normalized() -> Unit
  let n = p0()
  let expr = ConstExprT::ConstMul(ConstExprT::ConstLit(1), p0())
  let folded = const_sym_tree_fold_identities(&expr)
  assert(!const_sym_tree_eq(&folded, &n), "1 * N must NOT fold to N (commutativity is not normalized)")
end

# 2 * N vs N * 2 stay DIFFERENT trees (commutativity is not normalized).
@test
def test_fold_mul_commute_not_normalized() -> Unit
  let expr_a = ConstExprT::ConstMul(ConstExprT::ConstLit(2), p0())
  let expr_b = ConstExprT::ConstMul(p0(), ConstExprT::ConstLit(2))
  let two_left = const_sym_tree_fold_identities(&expr_a)
  let two_right = const_sym_tree_fold_identities(&expr_b)
  assert(!const_sym_tree_eq(&two_left, &two_right), "2 * N and N * 2 must stay DIFFERENT symbolic trees (commutativity is not normalized)")
end

# The fold is value-preserving when the tree is fully bound: a bound
# `4 + 0` folds to Const(4) through const_sym_fold_type exactly like `4`.
@test
def test_fold_type_bound_identity_value() -> Unit
  let expr_a = ConstExprT::ConstAdd(ConstExprT::ConstLit(4), ConstExprT::ConstLit(0))
  let expr_b = ConstExprT::ConstLit(4)
  let a = const_sym_fold_type(&expr_a)
  let b = const_sym_fold_type(&expr_b)
  assert(type_to_mangled(a) == type_to_mangled(b), "a fully-bound N + 0 spelling must fold to the same Const(4) value as the bare literal")
end

# ———— Instance identity: N+0 vs N at call sites ————

# Two call-site spellings the model equates (`N + 0` vs `N`) fold to the
# SAME symbolic type argument (the fold applies at the symbolic-argument
# record site), so the mangled renders agree and the structured instance
# keys are EQUAL — one instance.
@test
def test_instance_key_spelling_add_zero_same_instance() -> Unit
  let expr_a = ConstExprT::ConstAdd(p0(), ConstExprT::ConstLit(0))
  let expr_b = p0()
  let t_a = const_sym_fold_type(&expr_a)
  let t_b = const_sym_fold_type(&expr_b)
  let r_a = type_to_mangled(t_a)
  let r_b = type_to_mangled(t_b)
  assert(r_a == r_b, "the folded N + 0 spelling must render exactly like N")
  let key_a = instance_key_of_renders(callable_key(), one_render(r_a))
  let key_b = instance_key_of_renders(callable_key(), one_render(r_b))
  let text_a = instance_key_to_text(key_a.clone())
  let text_b = instance_key_to_text(key_b.clone())
  assert(text_a == text_b, "the diagnostics texts of the equated spellings must agree, got: " + text_a + " vs " + text_b)
  assert(instance_key_eq(key_a, key_b), "the N + 0 and N call-site spellings must yield the SAME structured instance key")
end

# The same-instance guarantee across the separate constructor paths: the
# positional-render constructor and the explicit arg-vector constructor
# agree on the same (callable, arg) input.
@test
def test_instance_key_constructors_agree() -> Unit
  let renders_key = instance_key_of_renders(callable_key(), Vec::from(["int".to_string(), "c4".to_string()]))
  let audit_key = instance_key_of(
    callable_key(),
    Vec::from([
      CanonicalGenericArg::Type(canonical_type_key_of("int".to_string())),
      CanonicalGenericArg::Const(canonical_const_value_of("unsigned".to_string(), 4))
    ])
  )
  assert(instance_key_eq(renders_key, audit_key), "the arg-vector constructor and the positional parse must build the SAME key for the same instance")
end

# ———— Spellings the model does NOT equate stay DIFFERENT ————

# 2 * N vs N * 2: different symbolic trees, different renders, DIFFERENT
# structured instance keys (documented — commutativity is not normalized).
@test
def test_instance_key_two_n_commute_stays_different() -> Unit
  let expr_a = ConstExprT::ConstMul(ConstExprT::ConstLit(2), p0())
  let expr_b = ConstExprT::ConstMul(p0(), ConstExprT::ConstLit(2))
  let two_left = const_sym_fold_type(&expr_a)
  let two_right = const_sym_fold_type(&expr_b)
  let key_left = instance_key_of_renders(callable_key(), one_render(type_to_mangled(two_left)))
  let key_right = instance_key_of_renders(callable_key(), one_render(type_to_mangled(two_right)))
  assert(!instance_key_eq(key_left, key_right), "2 * N and N * 2 must stay DIFFERENT instance keys (commutativity is not normalized)")
end

# Concrete const arguments 4 vs 8: value-based const rows, DIFFERENT keys.
@test
def test_instance_key_const_values_4_vs_8_differ() -> Unit
  let key_4 = instance_key_of_renders(callable_key(), Vec::from(["c4".to_string()]))
  let key_8 = instance_key_of_renders(callable_key(), Vec::from(["c8".to_string()]))
  assert(!instance_key_eq(key_4, key_8), "const args 4 and 8 must yield DIFFERENT instance keys")
end

# A negative const value round-trips through the segment grammar ("c-3").
@test
def test_instance_key_const_negative_value() -> Unit
  let parsed_key = instance_key_of_renders(callable_key(), Vec::from(["c-3".to_string()]))
  let built_key = instance_key_of(callable_key(), Vec::from([
    CanonicalGenericArg::Const(canonical_const_value_of("signed".to_string(), -3))
  ]))
  assert(instance_key_eq(parsed_key.clone(), built_key.clone()), "the c-3 segment and the signed -3 value row must build the SAME key")
  let text = instance_key_to_text(built_key)
  assert(text == callable_key() + "$c-3", "the diagnostics render must keep the const value text, got: " + text)
end

# ———— P0-5: the cross-kind ORDER is identity ————

# [Type A, Const 3] and [Const 3, Type A] are DIFFERENT instances. The
# second is built directly through the arg-vector constructor (an invalid
# producer may build any interleaving; identity must still separate them).
@test
def test_instance_key_cross_kind_order_differs() -> Unit
  let type_then_const = instance_key_of(callable_key(), Vec::from([
    CanonicalGenericArg::Type(canonical_type_key_of("A".to_string())),
    CanonicalGenericArg::Const(canonical_const_value_of("signed".to_string(), 3))
  ]))
  let const_then_type = instance_key_of(callable_key(), Vec::from([
    CanonicalGenericArg::Const(canonical_const_value_of("signed".to_string(), 3)),
    CanonicalGenericArg::Type(canonical_type_key_of("A".to_string()))
  ]))
  assert(!instance_key_eq(type_then_const.clone(), const_then_type.clone()), "[Type A, Const 3] and [Const 3, Type A] must never compare equal (P0-5)")
  let text_a = instance_key_to_text(type_then_const)
  let text_b = instance_key_to_text(const_then_type)
  assert(text_a == callable_key() + "$A$c3", "the diagnostics render must preserve declared cross-kind order, got: " + text_a)
  assert(text_b == callable_key() + "$c3$A", "the diagnostics render must preserve declared cross-kind order, got: " + text_b)
end

# The cross-kind order also survives the POSITIONAL parse: the render list
# ["A", "c3"] and ["c3", "A"] classify in position and stay different.
@test
def test_instance_key_cross_kind_order_positional() -> Unit
  let type_then_const = instance_key_of_renders(callable_key(), Vec::from(["A".to_string(), "c3".to_string()]))
  let const_then_type = instance_key_of_renders(callable_key(), Vec::from(["c3".to_string(), "A".to_string()]))
  assert(!instance_key_eq(type_then_const, const_then_type), "the positional parse must never regroup type and const args (P0-5)")
end

# A forwarded const-parameter row ("constparam5") parses and re-renders.
@test
def test_instance_key_constparam_segment() -> Unit
  let key = instance_key_of_renders(callable_key(), Vec::from(["constparam5".to_string()]))
  let text = instance_key_to_text(key)
  assert(text == callable_key() + "$constparam5", "the diagnostics render must keep the forwarded-parameter text, got: " + text)
  match canonical_const_of_segment("constparam5".to_string())
  when Option::Some(row) then
    assert(row.value == 5, "the constparam segment must parse its numeric parameter id")
    assert(row.kind == "constparam", "the constparam segment must classify as the constparam symbolic marker")
  when Option::None then
    assert(false, "constparam5 must parse as a canonical const segment")
  end
end

# A symbolic const-EXPRESSION segment ("constsym(...)") classifies as a
# const row and a plain type render does not.
@test
def test_instance_key_segment_classification() -> Unit
  match canonical_const_of_segment("constsym(((2)*(param0)))".to_string())
  when Option::Some(row) then
    assert(row.kind == "constsym", "a constsym segment must classify as the constsym symbolic marker")
  when Option::None then
    assert(false, "constsym(((2)*(param0))) must parse as a canonical const segment")
  end
  match canonical_const_of_segment("int".to_string())
  when Option::Some(_) then
    assert(false, "a plain type render must NOT classify as a const segment")
  when Option::None then ()
  end
  let mixed = instance_key_of_renders(callable_key(), Vec::from(["int".to_string(), "c4".to_string(), "t3[int]".to_string()]))
  let text = instance_key_to_text(mixed)
  assert(text == callable_key() + "$int$c4$t3[int]", "type/const arg texts must render in DECLARED order (P0-5 — never regrouped), got: " + text)
end

# Different callables never share a key: the callable key text digests.
@test
def test_instance_key_callable_differ() -> Unit
  let key_a = instance_key_of_renders(callable_key(), Vec::from(["int".to_string()]))
  let key_b = instance_key_of_renders("audit49::4::method".to_string(), Vec::from(["int".to_string()]))
  assert(!instance_key_eq(key_a, key_b), "two instances of DIFFERENT callables must yield DIFFERENT keys")
end

# ———— The mono threading: the structured MonoCache.instances key ————

# A generic template with ONE declared type parameter and a concrete
# (non-generic) body — the mono_arity suite's template shape, named for
# the name-API path.
def audit49_template() -> MirFunction
  MirFunction {
    name: "audit49_tpl".to_string(),
    params: Vec::new(),
    ret_type: Type::Int,
    generic_params: Vec::from([
      GenericParamId { owner: DefId { module: ModuleId { id: 0 }, index: 0 }, index: 0 }
    ]),
    locals: Vec::new(),
    blocks: Vec::new(),
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "".to_string(),
    contracts: Vec::new(),
    span: span_dummy()
  }
end

# mono_specialize_function computes the StructuralInstanceId ONCE per
# specialization request and caches the specialized body UNDER IT:
# MonoCache.instances is Map[StructuralInstanceId, MirFunction] (audit
# item 49 migration; P0-5/P0-6) — the emission text survives only as the
# body's `name`.
@test
def test_mono_cache_structured_key_threading() -> Unit
  mut cache = fresh_cache()
  mut program = MirProgram {
    functions: Vec::from([audit49_template()]),
    statics: Vec::new(),
    types: Vec::new()
  }
  let name = mono_specialize_function(inout cache, inout program, "audit49_tpl".to_string(), Vec::from([Type::Int]))
  match name
  when Option::Some(mangled) then
    assert(mangled == "audit49_tpl$int", "the name-API mangled emission key must be the template name + the mangle suffix")
    let expected = instance_key_of_renders("audit49_tpl".to_string(), Vec::from(["int".to_string()]))
    match cache.instances.get(&expected)
    when Option::Some(body) then
      assert(body.name == mangled, "the cached body's name field must keep the emission text label")
      let text = instance_key_to_text(expected.clone())
      assert(text == "audit49_tpl$int", "the structured key's diagnostics text must keep the emission text, got: " + text)
    when Option::None then
      assert(false, "the specialized body must be cached under the StructuralInstanceId (never the text key)")
    end
  when Option::None then
    assert(false, "the name-API specialization must succeed")
  end
end

# ———— P0-6: insertion stability of the structural callable identity ————

# A one-module program whose `module_symbols` registers `foo` at the given
# per-module definition index (and an unrelated `bar` at index 0 when
# `with_unrelated` is true) — the shape of "insert an unrelated function
# before foo": the INDEX shifts, the registration key "m::foo" does not.
def p0_6_cache(foo_index: UInt, with_unrelated: Bool) -> MonoCache
  let module = ModuleId { id: 0 }
  var modules: Map[ModuleId, Module] = Map::new()
  modules.insert(module.clone(), Module {
    id: module.clone(),
    path: Vec::from(["m".to_string()]),
    items: Vec::new(),
    imports: Vec::new()
  })
  var def_kinds: Map[String, DefKind] = Map::new()
  def_kinds.insert("0::" + foo_index.to_string(), DefKind::Function)
  var module_symbols: Map[String, DefId] = Map::new()
  module_symbols.insert("m::foo".to_string(), DefId { module: module.clone(), index: foo_index })
  if with_unrelated then
    def_kinds.insert("0::0".to_string(), DefKind::Function)
    module_symbols.insert("m::bar".to_string(), DefId { module: module.clone(), index: 0 })
  end
  mono_cache_new(
    Program {
      items: Vec::new(),
      crate: Crate { root: module, modules: modules },
      span: span_dummy()
    },
    ResolvedNames {
      expr_resolutions: Map::new(),
      type_resolutions: Map::new(),
      pattern_resolutions: Map::new(),
      call_targets: Map::new(),
      type_def_ids: Map::new(),
      intrinsic_ids: Map::new(),
      item_defs: Map::new(),
      module_symbols: module_symbols,
      def_kinds: def_kinds,
      stable_ids: stable_id_map_new()
    }
  )
end

# Insert an unrelated function BEFORE generic foo (foo's per-module index
# shifts 5 -> 6): every foo[Int] / foo[String] structural instance id
# stays byte-identical, because the callable identity is the index-free
# registration scope "m::foo" (P0-6), not the fn-owner render.
@test
def test_p0_6_insertion_keeps_instance_ids() -> Unit
  let cache_before = p0_6_cache(5, false)
  let cache_after = p0_6_cache(6, true)
  let foo_before = DefId { module: ModuleId { id: 0 }, index: 5 }
  let foo_after = DefId { module: ModuleId { id: 0 }, index: 6 }

  let int_before = structured_instance_key(cache_before.clone(), InstanceId {
    def: CallableId { def: foo_before.clone() },
    substs: Vec::from([Type::Int])
  })
  let int_after = structured_instance_key(cache_after.clone(), InstanceId {
    def: CallableId { def: foo_after.clone() },
    substs: Vec::from([Type::Int])
  })
  assert(instance_key_eq(int_before.clone(), int_after.clone()), "inserting an unrelated function before foo must leave foo[Int]'s structural instance id byte-identical")
  assert(int_before.digest_hi == int_after.digest_hi && int_before.digest_lo == int_after.digest_lo, "foo[Int]'s identity digest words must be byte-identical across the insertion")

  let str_before = structured_instance_key(cache_before.clone(), InstanceId {
    def: CallableId { def: foo_before },
    substs: Vec::from([Type::String])
  })
  let str_after = structured_instance_key(cache_after.clone(), InstanceId {
    def: CallableId { def: foo_after },
    substs: Vec::from([Type::String])
  })
  assert(instance_key_eq(str_before.clone(), str_after.clone()), "inserting an unrelated function before foo must leave foo[String]'s structural instance id byte-identical")

  assert(!instance_key_eq(int_before, str_before), "foo[Int] and foo[String] must stay DIFFERENT instances")
  assert(!instance_key_eq(int_after, str_after), "sanity: the post-insert build keeps the two instances distinct")
end

# The same insertion guarantee with the STORE-BACKED binding installed
# (the persistent StableDeclId is the authority; the emission base render
# may even change shape and the instance id does not move).
@test
def test_p0_6_store_binding_keeps_instance_ids() -> Unit
  let store_decl = stable_decl_id_of_lineage_texts_named(
    "main".to_string(), "m".to_string(), 7, "fn".to_string(), "m::foo".to_string()
  )
  mut cache_before = p0_6_cache(5, false)
  mut cache_after = p0_6_cache(6, true)
  mono_cache_bind_stable_callable(inout cache_before, "m::foo".to_string(), store_decl.clone())
  mono_cache_bind_stable_callable(inout cache_after, "m::foo".to_string(), store_decl.clone())
  let key_before = structured_instance_key(cache_before, InstanceId {
    def: CallableId { def: DefId { module: ModuleId { id: 0 }, index: 5 } },
    substs: Vec::from([Type::Int])
  })
  let key_after = structured_instance_key(cache_after, InstanceId {
    def: CallableId { def: DefId { module: ModuleId { id: 0 }, index: 6 } },
    substs: Vec::from([Type::Int])
  })
  assert(instance_key_eq(key_before, key_after), "the store-backed callable binding must make insertion stability hold for foo[Int]")
end

# The emitted symbol bytes are DERIVED from the record and keep the
# current textual shape (base + "$" + args in declared order): foo[Int]
# renders "m::5::fn$int" in the before build and "m::6::fn$int" after —
# the ID is stable, the display base may move (P0-6).
@test
def test_p0_6_mangled_render_derives_from_record() -> Unit
  let cache_before = p0_6_cache(5, false)
  let key = structured_instance_key(cache_before, InstanceId {
    def: CallableId { def: DefId { module: ModuleId { id: 0 }, index: 5 } },
    substs: Vec::from([Type::Int])
  })
  let text = structural_instance_mangle_text(key.clone())
  assert(text == "m::5::fn$int", "the emission render must be the fn-owner base + the declared-order args, got: " + text)
  let rendered_args = canonical_generic_arg_text(key.args[0].clone())
  assert(rendered_args == "int", "the first arg render must be the canonical type text, got: " + rendered_args)
end
