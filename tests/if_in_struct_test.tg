use std::fmt

struct TextStyle
  size: Float
  font: Option[String]
  color: String
end

def main() -> Unit
  let label = "test"
  let label_style = TextStyle {
    size: if label.len() > 2 then 18.0 else 24.0,
    font: Option::None,
    color: "red"
  }
  fmt::println("size: " + label_style.size.to_string())
end
