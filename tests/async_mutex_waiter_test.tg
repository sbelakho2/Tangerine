# tests/async_mutex_waiter_test.tg — the AsyncMutex waiter registration:
# contention enqueues the waker ONCE (the waiters queue — the same shape
# the channel waiters use) and returns Pending; the guard's Drop releases
# the lock and wakes the OLDEST waiter (FIFO); the LockFuture's Drop
# removes its own waiter, so a waiter that leaves the queue without
# acquiring lets the guard's Drop wake the NEXT one. Repeated polls never
# append duplicates.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*

@test
def test_async_mutex_waiter_fifo_wake_order() -> Unit
  mut exec = std::async::executor_new()
  exec.set_deterministic(1u64)
  let mutex = std::async::async_mutex_new(0)
  let mut order = Vec::new()
  # the holder: locks, sleeps with the lock HELD across the await, then
  # drops — the release must wake the OLDEST waiter first
  let h1 = exec.spawn(async {
    let guard = mutex.lock().await
    std::async::sleep_millis(1).await
    drop(guard)
  })
  let h2 = exec.spawn(async {
    let guard = mutex.lock().await
    order.push(2)
    drop(guard)
  })
  let h3 = exec.spawn(async {
    let guard = mutex.lock().await
    order.push(3)
    drop(guard)
  })
  exec.run()
  # both waiters acquired, in FIFO order: h2 (enqueued first) before h3
  assert_eq(order.len(), 2)
  assert_eq(order[0], 2)
  assert_eq(order[1], 3)
end

@test
def test_async_mutex_waiter_drop_before_acquire_wakes_next() -> Unit
  let mutex = std::async::async_mutex_new(0)
  let mut order = Vec::new()
  std::async::block_on(async {
    # the holder: locks, sleeps with the lock HELD across the await,
    # then drops
    let h1 = std::async::spawn(async {
      let guard = mutex.lock().await
      std::async::sleep_millis(1).await
      drop(guard)
    })
    let h2 = std::async::spawn(async {
      let guard = mutex.lock().await
      order.push(2)
      drop(guard)
    })
    let h3 = std::async::spawn(async {
      let guard = mutex.lock().await
      order.push(3)
      drop(guard)
    })
    # the canceller runs while h1 still holds the lock and h2/h3 wait:
    # h2's task is cancelled → its LockFuture is dropped → its waiter
    # entry is removed from the queue
    let h2_id = h2.task_id
    let canceller = std::async::spawn(async {
      let _ = std::async::cancel_task(h2_id)
    })
    let _ = h1.await
    let _ = h3.await
    let _ = canceller.await
  })
  # h2 left the queue without acquiring, so h1's release woke h3 — the
  # NEXT waiter — instead
  assert_eq(order.len(), 1)
  assert_eq(order[0], 3)
end
