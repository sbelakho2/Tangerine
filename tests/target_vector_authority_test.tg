# tests/target_vector_authority_test.tg — audit item 34: THE ONE vector
# legality authority's row answers.
#
# Every v128/v256 legality decision of the vector consumers (the LIR
# vector-local shape gate and the explicit __intrinsic_simd_* lowering's
# per-statement gate, plus the direct emitter's NEON/SSE/AVX arms) is
# made by asking ONE target-side question —
# target_desc.vector_support(desc, bits) -> V128 | V256 | Unsupported —
# over the desc's fpu unit (the 128-bit baseline: AdvSimdA64 / Sse2) and
# its isa_features AVX tokens (the 256-bit opt-in). This suite pins the
# authority's rows per canonical/synthetic description, so the class
# data and the fail-closed rules cannot silently drift.

use std::test::*
use std::collections::{Vec}
use tg_compiler::target_desc::{
  TargetDesc, VectorSupport, Fpu, vector_support,
  target_desc_has_vector_128, target_desc_has_vector_256,
  aarch64_desc, x86_64_desc,
  thumbv7em_cortex_m4f_desc, thumbv7em_cortex_m7_desc,
  riscv32imac_desc, riscv64imac_desc
}

# An AVX-advertising x86-64 description (the isa_features opt-in
# documented in target_desc.tg: no canonical instance carries it this
# slice — AVX is per-CPU and never assumed by the baseline).
def avx_style_desc() -> TargetDesc
  var d = x86_64_desc()
  d.name = "x86_64+avx2"
  d.isa_features = Vec::from(["sse2", "avx", "avx2"])
  d
end

# ———————————————————————————————————————————————————————————————
# aarch64 AdvSimd rows: v128 legal, v256/v512 fail closed
# ———————————————————————————————————————————————————————————————

@test
def test_aarch64_vector_rows() -> Unit
  let d = aarch64_desc()
  # The unified v0-v31 AdvSIMD file IS the aarch64 FPU: the 128-bit
  # baseline is advertised.
  assert_true(target_desc_has_vector_128(d))
  assert_true(vector_support(d, 128) == VectorSupport::V128)
  # No AVX token exists on aarch64 (its 256-bit profiles are SVE/SME,
  # not modeled): a 256-bit vector fails closed — never inferred from
  # the 128-bit facility.
  assert_true(!target_desc_has_vector_256(d))
  assert_true(vector_support(d, 256) == VectorSupport::Unsupported)
  # No descriptor models a 512-bit facility, so every 512-bit request
  # fail-closes (the lowering's named rule).
  assert_true(vector_support(d, 512) == VectorSupport::Unsupported)
  assert_true(vector_support(d, 64) == VectorSupport::Unsupported)
  assert_true(vector_support(d, 0) == VectorSupport::Unsupported)
end

# ———————————————————————————————————————————————————————————————
# x86-64 SSE2 rows: v128 legal, v256 fail closed without AVX
# ———————————————————————————————————————————————————————————————

@test
def test_x86_64_sse2_vector_rows() -> Unit
  let d = x86_64_desc()
  # SSE2 is the x86-64 baseline FPU (the desc's fpu unit): v128 is
  # legal.
  assert_true(target_desc_has_vector_128(d))
  assert_true(vector_support(d, 128) == VectorSupport::V128)
  # The baseline deliberately assumes NO AVX (see x86_64_desc in
  # target_desc.tg): 256-bit fails closed.
  assert_true(!target_desc_has_vector_256(d))
  assert_true(vector_support(d, 256) == VectorSupport::Unsupported)
  assert_true(vector_support(d, 512) == VectorSupport::Unsupported)
end

# ———————————————————————————————————————————————————————————————
# The AVX opt-in: the token moves v256 into the legal class (and only
# v256 — v512 stays unmodeled)
# ———————————————————————————————————————————————————————————————

@test
def test_avx_style_desc_differs() -> Unit
  let plain = x86_64_desc()
  let avx = avx_style_desc()
  # The baseline answers Unsupported for 256; the AVX desc answers V256.
  assert_true(vector_support(plain, 256) == VectorSupport::Unsupported)
  assert_true(target_desc_has_vector_256(avx))
  assert_true(vector_support(avx, 256) == VectorSupport::V256)
  # The 128-bit baseline is unchanged by the 256-bit token.
  assert_true(vector_support(avx, 128) == VectorSupport::V128)
  # v512 is not modeled by ANY token — fail closed even on the AVX
  # desc.
  assert_true(vector_support(avx, 512) == VectorSupport::Unsupported)
end

# ———————————————————————————————————————————————————————————————
# The scalar-FPU targets: no vector facility at either width
# ———————————————————————————————————————————————————————————————

@test
def test_scalar_fpu_targets_fail_closed() -> Unit
  # The M-profile FPv4-SP/FPv5-D16 units and the RISC-V F/D units are
  # SCALAR FPUs (FLEN 32/64 — no vector register file): both vector
  # widths fail closed.
  let m4f = thumbv7em_cortex_m4f_desc()
  assert_true(!target_desc_has_vector_128(m4f))
  assert_true(vector_support(m4f, 128) == VectorSupport::Unsupported)
  assert_true(vector_support(m4f, 256) == VectorSupport::Unsupported)

  let m7 = thumbv7em_cortex_m7_desc()
  assert_true(!target_desc_has_vector_128(m7))
  assert_true(vector_support(m7, 128) == VectorSupport::Unsupported)
  assert_true(vector_support(m7, 256) == VectorSupport::Unsupported)

  let rv32 = riscv32imac_desc()
  assert_true(!target_desc_has_vector_128(rv32))
  assert_true(vector_support(rv32, 128) == VectorSupport::Unsupported)
  assert_true(vector_support(rv32, 256) == VectorSupport::Unsupported)

  let rv64 = riscv64imac_desc()
  assert_true(!target_desc_has_vector_128(rv64))
  assert_true(vector_support(rv64, 128) == VectorSupport::Unsupported)
  assert_true(vector_support(rv64, 256) == VectorSupport::Unsupported)
end

# ———————————————————————————————————————————————————————————————
# The fpu/isa_features decomposition: the authority reads BOTH fields,
# never a bare arch name
# ———————————————————————————————————————————————————————————————

@test
def test_authority_reads_fpu_and_isa_tokens() -> Unit
  # A desc whose arch says x86_64 but whose fpu says Sse2: the 128-bit
  # answer follows the fpu field (this is the canonical desc).
  var sse = x86_64_desc()
  sse.fpu = Fpu::Sse2
  assert_true(vector_support(sse, 128) == VectorSupport::V128)

  # Clearing the fpu unit removes the 128-bit advertisement even though
  # the arch name still says x86_64.
  var none = x86_64_desc()
  none.fpu = Fpu::None
  assert_true(!target_desc_has_vector_128(none))
  assert_true(vector_support(none, 128) == VectorSupport::Unsupported)

  # The 256-bit answer follows ONLY the AVX tokens: adding them to an
  # otherwise scalar-FPU desc still answers V256 (the authority is the
  # union of the two documented fields; consumers of the 256-bit class
  # gate their own emission envelope separately).
  var m4f_avx = thumbv7em_cortex_m4f_desc()
  m4f_avx.isa_features = Vec::from(["avx"])
  assert_true(vector_support(m4f_avx, 128) == VectorSupport::Unsupported)
  assert_true(vector_support(m4f_avx, 256) == VectorSupport::V256)
end
