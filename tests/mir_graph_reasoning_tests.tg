# tests/mir_graph_reasoning_tests.tg — third-audit item 20/22 MIR graph
# reasoning lane (dominators, postdominators, loop forest, control
# dependence, reaching definitions, drop paths).
#
# The engines live in tg_compiler/semantic_slice.tg's MIR GRAPH REASONING
# section (mir_dominators / mir_postdominators / mir_loops /
# mir_control_dependence / mir_reaching_defs / mir_drop_paths /
# mir_effect_paths), keyed by the item-16/47 stable ids: blocks by the §1
# StableMirBlockId.stable_key text and statements by the role-derived
# StableMirStatementId role-key text. The self-checking lane rows
# (mir_graph_lane_check) build minimal MirPrograms BY HAND — mirroring
# tests/verifier_projection_tests.tg's construction style — and assert on
# a diamond CFG (dominance + branch control dependence), a loop CFG
# (natural loop + header control dependence), a nested-loop CFG (the loop
# forest parent), a straight-line reaching-def fixture (the in-block KILL
# and the order-sensitive reaching def) and a cross-block fixture (the
# predecessor def through the block IN set), plus the drop-path slice of a
# MirDeinit site.
#
# Run with the repo root as the working directory:
#   tg test tests/mir_graph_reasoning_tests.tg

use std::test::assert

use tg_compiler::semantic_slice::{mir_graph_lane_check}

@test
def test_mir_graph_reasoning_lane() -> Unit
  let rows = mir_graph_lane_check()
  assert(rows.len() == 0, "mir graph reasoning lane mismatches: " + rows.join("; "))
end
