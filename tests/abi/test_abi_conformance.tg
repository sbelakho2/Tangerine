# tests/abi/test_abi_conformance.tg — ABI conformance tests §21.6
use std::test::*
use std::backend_abi

# --- Symbol presence ---

@test
def test_abi_constants_exist() -> Unit
  assert_eq(TG_BACKEND_ABI_MAJOR, 1u32)
  assert_eq(TG_BACKEND_ABI_MINOR, 0u32)
end

# --- Base type sizes ---

@test
def test_tgstr_has_correct_fields() -> Unit
  let s = TgStr { ptr: 0u64, len: 0u64 }
  assert_eq(s.ptr, 0u64)
  assert_eq(s.len, 0u64)
end

@test
def test_tgslice_has_correct_fields() -> Unit
  let s = TgSlice { ptr: 0u64, len: 0u64 }
  assert_eq(s.ptr, 0u64)
end

@test
def test_tgerror_has_correct_fields() -> Unit
  let e = TgError { code: -1i32, message: TgStr { ptr: 0u64, len: 0u64 } }
  assert_eq(e.code, -1i32)
end

@test
def test_tgresult_has_correct_fields() -> Unit
  let r = TgResult { ok: true, err: TgError { code: 0i32, message: TgStr { ptr: 0u64, len: 0u64 } } }
  assert_true(r.ok)
end

@test
def test_tghandle_has_correct_fields() -> Unit
  let h = TgHandle { value: 42u64 }
  assert_eq(h.value, 42u64)
end

@test
def test_tginterfaceheader_has_correct_fields() -> Unit
  let hdr = TgInterfaceHeader { abi_major: 1u32, abi_minor: 0u32, size_bytes: 64u32 }
  assert_eq(hdr.abi_major, 1u32)
  assert_eq(hdr.abi_minor, 0u32)
  assert_eq(hdr.size_bytes, 64u32)
end

# --- Interface name constants ---

@test
def test_interface_name_constants() -> Unit
  assert_eq(IFACE_APP_V1, "tg.app.v1")
  assert_eq(IFACE_GFX_V1, "tg.gfx.v1")
  assert_eq(IFACE_TEXT_V1, "tg.text.v1")
  assert_eq(IFACE_IMAGE_V1, "tg.image.v1")
  assert_eq(IFACE_GPU_V1, "tg.gpu.v1")
  assert_eq(IFACE_CLIP_V1, "tg.clipboard.v1")
  assert_eq(IFACE_IME_V1, "tg.ime.v1")
  assert_eq(IFACE_DND_V1, "tg.dragdrop.v1")
end

# --- Event tag constants ---

@test
def test_event_tag_constants() -> Unit
  assert_eq(TG_EVENT_KEY_DOWN, 1u32)
  assert_eq(TG_EVENT_KEY_UP, 2u32)
  assert_eq(TG_EVENT_TEXT_INPUT, 3u32)
  assert_eq(TG_EVENT_IME_START, 4u32)
  assert_eq(TG_EVENT_IME_UPDATE, 5u32)
  assert_eq(TG_EVENT_IME_END, 6u32)
  assert_eq(TG_EVENT_MOUSE_MOVE, 7u32)
  assert_eq(TG_EVENT_MOUSE_DOWN, 8u32)
  assert_eq(TG_EVENT_MOUSE_UP, 9u32)
  assert_eq(TG_EVENT_SCROLL, 10u32)
  assert_eq(TG_EVENT_RESIZE, 11u32)
  assert_eq(TG_EVENT_FOCUS, 12u32)
  assert_eq(TG_EVENT_CLOSE, 13u32)
  assert_eq(TG_EVENT_REDRAW, 14u32)
  assert_eq(TG_EVENT_DRAG_ENTER, 15u32)
  assert_eq(TG_EVENT_DRAG_OVER, 16u32)
  assert_eq(TG_EVENT_DRAG_DROP, 17u32)
  assert_eq(TG_EVENT_DRAG_LEAVE, 18u32)
end

# --- Interface header validation ---

@test
def test_validate_interface_header_passes_for_valid_header() -> Unit
  let hdr = TgInterfaceHeader { abi_major: 1u32, abi_minor: 0u32, size_bytes: 100u32 }
  let result = validate_interface_header(hdr, 80u32)
  assert_true(result.ok)
end

@test
def test_validate_interface_header_fails_for_too_small() -> Unit
  let hdr = TgInterfaceHeader { abi_major: 1u32, abi_minor: 0u32, size_bytes: 50u32 }
  let result = validate_interface_header(hdr, 80u32)
  assert_false(result.ok)
end

# --- ABI version validation ---

@test
def test_validate_abi_version_passes_for_matching_major() -> Unit
  let result = validate_abi_version(1u32, 0u32)
  assert_true(result.ok)
end

@test
def test_validate_abi_version_passes_for_higher_minor() -> Unit
  let result = validate_abi_version(1u32, 5u32)
  assert_true(result.ok)
end

@test
def test_validate_abi_version_fails_for_wrong_major() -> Unit
  let result = validate_abi_version(2u32, 0u32)
  assert_false(result.ok)
end

@test
def test_validate_abi_version_fails_for_lower_minor() -> Unit
  # This depends on implementation — minor must be >= TG_BACKEND_ABI_MINOR
  let result = validate_abi_version(1u32, 0u32)
  # 0 >= 0 should pass
  assert_true(result.ok)
end

# --- TgEventV1 layout ---

@test
def test_tgeventv1_construction() -> Unit
  let evt = TgEventV1 {
    tag: TG_EVENT_MOUSE_DOWN,
    a: 1i32,
    b: 0i32,
    x: 100.0f32,
    y: 200.0f32,
    text: TgStr { ptr: 0u64, len: 0u64 }
  }
  assert_eq(evt.tag, 8u32)
  assert_eq(evt.x, 100.0f32)
end

# --- Allocation ownership ---

@test
def test_tghostv1_has_all_function_pointers() -> Unit
  let host = TgHostV1 {
    alloc: 0u64,
    free: 0u64,
    log: 0u64
  }
  # Null pointers indicate no host — just verify struct fields exist
  assert_eq(host.alloc, 0u64)
  assert_eq(host.free, 0u64)
  assert_eq(host.log, 0u64)
end

# --- Loader config ---

@test
def test_default_loader_config_has_required_interfaces() -> Unit
  let config = default_loader_config()
  assert_true(config.required_interfaces.len() >= 3)
end

# --- Manifest ---

@test
def test_example_manifest_contains_required_keys() -> Unit
  let manifest = _example_manifest()
  assert_true(manifest.contains("name"))
  assert_true(manifest.contains("version"))
  assert_true(manifest.contains("abi_major"))
  assert_true(manifest.contains("abi_minor"))
  assert_true(manifest.contains("interfaces"))
  assert_true(manifest.contains("capabilities"))
  assert_true(manifest.contains("platforms"))
end
