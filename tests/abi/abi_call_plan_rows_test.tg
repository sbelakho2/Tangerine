# ———————————————————————————————————————————————————————————————
# 10. the enum crossing authority (audit item 29)
# ———————————————————————————————————————————————————————————————

@test
def test_enum_crossing_rows() -> Unit
  mut engine = layout_engine_new(aarch64_target())
  let defs = row_defs()
  layout_engine_register_types(&mut engine, &defs)
  compute_all_layouts(&mut engine)

  # A payloaded TaggedPtr enum's canonical answer is the ONE value word.
  match classify_enum_crossing(&mut engine, aarch64_desc(), AbiFlavor::InternalValue, payload_enum_ty())
  when Result::Ok(c) then
    assert(c == AbiEnumCrossing::ValueWord, "payload enum internal crossing must be the canonical ValueWord")
  when Result::Err(e) then
    panic("payload enum internal crossing failed closed: " + layout_error_to_string(&e))
  end

  # ExternC refuses the compiler-private word.
  match classify_enum_crossing(&mut engine, aarch64_desc(), AbiFlavor::ExternC, payload_enum_ty())
  when Result::Ok(_) then
    panic("payload enum ExternC crossing must fail closed")
  when Result::Err(_) then ()
  end

  # The payload-less enum is the same word in both flavors.
  match classify_enum_crossing(&mut engine, aarch64_desc(), AbiFlavor::InternalValue, unit_enum_ty())
  when Result::Ok(c) then
    assert(c == AbiEnumCrossing::ValueWord, "unit enum internal crossing must be the canonical ValueWord")
  when Result::Err(e) then
    panic("unit enum internal crossing failed closed: " + layout_error_to_string(&e))
  end
  match classify_enum_crossing(&mut engine, aarch64_desc(), AbiFlavor::ExternC, unit_enum_ty())
  when Result::Ok(c) then
    assert(c == AbiEnumCrossing::ValueWord, "unit enum ExternC crossing must be the canonical ValueWord")
  when Result::Err(e) then
    panic("unit enum ExternC crossing failed closed: " + layout_error_to_string(&e))
  end
end

# ———————————————————————————————————————————————————————————————
# 11. the typed FFI surface (third-audit items 42/43) — the word seams
# ———————————————————————————————————————————————————————————————
# The producer's word helpers: the exact mappings the snapshot builder
# applies (ownership_out from the type-properties answer, the failure
# convention from the builtin-Result/lang-item answer, the nullability
# word and the enum-crossing boundary render).

@test
def test_typed_ffi_surface_word_seams() -> Unit
  assert(snapshot_abi_ownership_word(true, false) == "owned", "ownership: owning non-unit return must be owned")
  assert(snapshot_abi_ownership_word(false, true) == "none", "ownership: unit return must be none")
  assert(snapshot_abi_ownership_word(false, false) == "borrowed", "ownership: non-owning non-unit return must be borrowed")

  assert(snapshot_abi_failure_word(false, true) == "trap", "failure: concrete non-Result return must be trap")
  assert(snapshot_abi_failure_word(true, true) == "result", "failure: builtin-Result return must be result")
  assert(snapshot_abi_failure_word(true, false) == "unknown", "failure: undecidable return must be unknown")

  assert(snapshot_abi_nullability_word(true) == "unknown", "nullability: pointer param must be the explicit unknown")
  assert(snapshot_abi_nullability_word(false) == "", "nullability: non-pointer param contributes no word")

  assert(snapshot_abi_enum_crossing_word(AbiEnumCrossing::ValueWord) == "value-word", "crossing ValueWord render")
  assert(snapshot_abi_enum_crossing_word(AbiEnumCrossing::InlineImage) == "inline-image", "crossing InlineImage render")
  assert(snapshot_abi_enum_crossing_word(AbiEnumCrossing::InlineScalar) == "inline-scalar", "crossing InlineScalar render")
end

# ———————————————————————————————————————————————————————————————
# 12. the typed FFI surface (third-audit item 43) — the persisted rows
# and the report mapping, pinned for the audit's signature cases
# ———————————————————————————————————————————————————————————————

def svec(a: String) -> Vec[String] = Vec::from([a.clone()])

def svec2(a: String, b: String) -> Vec[String] = Vec::from([a.clone(), b.clone()])

def surface_target_id() -> StableTargetId
  StableTargetId {
    triple: "aarch64-apple-darwin".to_string(),
    arch: "aarch64".to_string(),
    cpu: "apple-m1".to_string(),
    pointer_width: 8,
    endian: "little".to_string(),
    abi: "lp64".to_string(),
    float_abi: "hard".to_string(),
    isa_features: Vec::new(),
    native_atomic_widths: Vec::new()
  }
end

def surface_symbol(key: String, name: String, path: String) -> SemanticSymbol
  SemanticSymbol {
    stable_id: stable_def_id_digested(key.clone(), path.clone()),
    kind: DefKind::Function,
    name: name,
    module_path: path,
    is_pub: true,
    is_generic: false
  }
end

def surface_snapshot(symbols: Vec[SemanticSymbol], rows: Vec[AbiSurfaceRow]) -> SemanticSnapshot
  var snap = SemanticSnapshot {
    revision: semantic_digest_zero(),
    compiler_version: "test".to_string(),
    target: surface_target_id(),
    public_api_hash: semantic_digest_zero(),
    abi_hash: semantic_digest_zero(),
    unsafe_hash: semantic_digest_zero()
  }
  snap.symbols = symbols
  snap.abi_surfaces = rows
  snap
end

def surface_report(snap: SemanticSnapshot, key: String) -> FfiReport
  match ffi_report_of_symbol(snap, key.clone())
  when Option::Some(r) then r
  when Option::None then panic("ffi report missing for " + key)
  end
end

# One persisted fn surface row with the typed mirror the producer fills.
def surface_fn_row(key: String, args: Vec[String], ret: String, pclasses: Vec[String],
  plocs: Vec[String], ownin: Vec[String], ownout: String, nulls: Vec[String],
  variadic: Bool, exts: Vec[String], conv: String, extern_sym: String,
  failure: String, boundary: String) -> AbiSurfaceRow
  AbiSurfaceRow {
    surface_id: "fn:" + key.clone(),
    symbol_key: key,
    kind: "fn",
    size: -1,
    alignment: -1,
    arg_classes: args,
    ret_class: ret,
    calling_convention: conv,
    external_symbol: extern_sym,
    param_classes: pclasses,
    param_locations: plocs,
    ownership_in: ownin,
    ownership_out: ownout,
    nullability: nulls,
    variadic: variadic,
    extension: exts,
    platform: "aarch64-apple-darwin".to_string(),
    failure_convention: failure,
    thread_safety: "unknown".to_string(),
    taint: "unmodeled".to_string(),
    canonical_boundary: boundary
  }
end

@test
def test_typed_ffi_surface_rows() -> Unit
  var syms: Vec[SemanticSymbol] = Vec::new()
  var rows: Vec[AbiSurfaceRow] = Vec::new()

  # (1) A plain int fn: the compiler's own convention, borrowed scalars,
  # no boundary involvement, the panic failure word.
  let k_add = "test::add#fn(let:int,let:int)->int"
  syms.push(surface_symbol(k_add.clone(), "add", "test"))
  rows.push(surface_fn_row(k_add.clone(), svec2("scalar:8", "scalar:8"), "direct:scalar:8",
    svec2("scalar:8", "scalar:8"), svec2("x0", "x1"), svec2("let", "let"), "borrowed",
    Vec::new(), false, svec2("none", "none"), "tangerine", "", "trap", "n/a"))

  # (2) An extern with a sink (ownership-taking) pointer param.
  let k_consume = "test::consume#fn(let:P[u8])->unit"
  syms.push(surface_symbol(k_consume.clone(), "consume", "test"))
  rows.push(surface_fn_row(k_consume.clone(), svec("scalar:8"), "direct:zero",
    svec("scalar:8"), svec("x0"), svec("sink"), "none", svec("arg0 unknown"),
    false, svec("none"), "C", "consume", "trap", "n/a"))

  # (3) An extern returning an owning String: ownership transfers out.
  let k_make = "test::make_name#fn()->str"
  syms.push(surface_symbol(k_make.clone(), "make_name", "test"))
  rows.push(surface_fn_row(k_make.clone(), Vec::new(), "direct:scalar:8",
    Vec::new(), Vec::new(), Vec::new(), "owned", Vec::new(),
    false, Vec::new(), "C", "make_name", "trap", "n/a"))

  # (4) A printf-style variadic extern: the marker rides the extern record.
  let k_printf = "test::printf#fn(let:P[u8])->int"
  syms.push(surface_symbol(k_printf.clone(), "printf", "test"))
  rows.push(surface_fn_row(k_printf.clone(), svec("scalar:8"), "direct:scalar:8",
    svec("scalar:8"), svec("x0"), svec("let"), "borrowed", svec("arg0 unknown"),
    true, svec("none"), "C", "printf", "trap", "n/a"))

  # (5) An enum-crossing fn: the canonical boundary answer is the authority's
  # ValueWord render.
  let k_cls = "test::classify#fn(let:T[test::UnitEnum])->T[test::UnitEnum]"
  syms.push(surface_symbol(k_cls.clone(), "classify", "test"))
  rows.push(surface_fn_row(k_cls.clone(), svec("scalar:8"), "direct:scalar:8",
    svec("scalar:8"), svec("x0"), svec("let"), "borrowed",
    Vec::new(), false, svec("none"), "tangerine", "", "trap", "value-word"))

  let snap = surface_snapshot(syms, rows)

  let r_add = surface_report(snap.clone(), k_add)
  assert(r_add.calling_convention == "tangerine", "plain int fn: calling convention must be tangerine, got `" + r_add.calling_convention + "`")
  assert(r_add.external_symbol == "", "plain int fn: no external symbol")
  assert(!r_add.variadic, "plain int fn: not variadic")
  assert(r_add.platform == "aarch64-apple-darwin", "plain int fn: platform must be the target triple")
  assert(r_add.canonical_boundary == "n/a", "plain int fn: boundary must be n/a, got `" + r_add.canonical_boundary + "`")
  assert(r_add.failure_convention == "trap", "plain int fn: failure convention must be trap, got `" + r_add.failure_convention + "`")
  assert(r_add.thread_safety == "unknown", "plain int fn: thread safety must be the explicit unknown")
  assert(r_add.taint == "unmodeled", "plain int fn: taint must be unmodeled")
  assert(r_add.arg_locations.join(";") == "scalar:8;scalar:8", "plain int fn: arg locations must read the row classes")
  assert(r_add.return_location == "direct:scalar:8", "plain int fn: return location must read the row ret class")
  assert(r_add.ownership_transfer.len() == 0, "plain int fn: no ownership transfer")
  assert(r_add.nullability.len() == 0, "plain int fn: no pointer params, no nullability rows")

  let r_consume = surface_report(snap.clone(), k_consume)
  assert(r_consume.calling_convention == "C", "sink extern: calling convention must be C, got `" + r_consume.calling_convention + "`")
  assert(r_consume.external_symbol == "consume", "sink extern: external symbol must be the link name")
  assert(r_consume.ownership_transfer.join(";") == "arg0 sink", "sink extern: the sink param must transfer ownership, got `" + r_consume.ownership_transfer.join(";") + "`")
  assert(r_consume.nullability.join(";") == "arg0 unknown", "sink extern: the Ptr param must carry the explicit unknown nullability")
  assert(r_consume.return_location == "direct:zero", "sink extern: unit return must render direct:zero")
  assert(r_consume.failure_convention == "trap", "sink extern: non-Result failure must be trap")

  let r_make = surface_report(snap.clone(), k_make)
  assert(r_make.ownership_transfer.join(";") == "return owned", "owning String extern: the return must transfer ownership, got `" + r_make.ownership_transfer.join(";") + "`")
  assert(r_make.calling_convention == "C", "owning String extern: calling convention must be C")
  assert(r_make.external_symbol == "make_name", "owning String extern: external symbol must be the link name")
  assert(r_make.canonical_boundary == "n/a", "owning String extern: no enum in the signature")

  let r_printf = surface_report(snap.clone(), k_printf)
  assert(r_printf.variadic, "printf-style extern: the variadic flag must be true")
  assert(r_printf.calling_convention == "C", "printf-style extern: calling convention must be C")
  assert(r_printf.external_symbol == "printf", "printf-style extern: external symbol must be the link name")
  assert(r_printf.nullability.join(";") == "arg0 unknown", "printf-style extern: the Ptr param must carry unknown nullability")

  let r_cls = surface_report(snap.clone(), k_cls)
  assert(r_cls.canonical_boundary == "value-word", "enum-crossing fn: boundary must be the ValueWord render, got `" + r_cls.canonical_boundary + "`")
  assert(r_cls.calling_convention == "tangerine", "enum-crossing fn: calling convention must be tangerine")
  assert(r_cls.ownership_transfer.len() == 0, "enum-crossing fn: no ownership transfer")

  # The row TEXT persists every typed pair (the delta/abi_rows_of_snapshot
  # grammar), and abi_rows_of_snapshot returns the five rows.
  let add_text = semantic_abi_surface_row_text(&rows[0])
  assert(add_text.contains("conv=tangerine"), "row text must persist the calling convention")
  assert(add_text.contains("ownin=let|let"), "row text must persist the access conventions")
  assert(add_text.contains("ownout=borrowed"), "row text must persist the return ownership word")
  assert(add_text.contains("variadic=false"), "row text must persist the variadic flag")
  assert(add_text.contains("platform=aarch64-apple-darwin"), "row text must persist the platform")
  assert(add_text.contains("failure=trap"), "row text must persist the failure convention")
  assert(add_text.contains("thread=unknown"), "row text must persist the thread-safety word")
  assert(add_text.contains("taint=unmodeled"), "row text must persist the taint word")
  assert(add_text.contains("boundary=n/a"), "row text must persist the canonical boundary")
  let consume_text = semantic_abi_surface_row_text(&rows[1])
  assert(consume_text.contains("ownin=sink"), "sink row text must persist the access convention")
  assert(consume_text.contains("null=arg0 unknown"), "sink row text must persist the nullability row")
  assert(consume_text.contains("extern=consume"), "sink row text must persist the external symbol")
  let printf_text = semantic_abi_surface_row_text(&rows[3])
  assert(printf_text.contains("variadic=true"), "printf row text must persist the variadic flag")
  let cls_text = semantic_abi_surface_row_text(&rows[4])
  assert(cls_text.contains("boundary=value-word"), "enum row text must persist the boundary word")

  let rendered_rows = abi_rows_of_snapshot(snap.clone())
  assert(rendered_rows.len() == 5, "abi_rows_of_snapshot must return the five persisted rows, got " + rendered_rows.len().to_string())
  var joined = ""
  for r in rendered_rows do
    joined = joined + r + "\n"
  end
  assert(joined.contains("boundary=value-word"), "abi_rows_of_snapshot must carry the boundary word")
  assert(joined.contains("variadic=true"), "abi_rows_of_snapshot must carry the variadic flag")
end
