  let p_pair = row_plan(desc.clone(), lt.clone(), fl, Vec::from([pair16_ty()]), Type::Unit)
  expect_arg(&p_pair, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::Register, "a0", true, 16, "riscv64 internal pair16 arg")
  expect_ret(&p_pair, "sret:pair:8:8", "riscv64 internal pair16 ret")

  let p_payload = row_plan(desc.clone(), lt.clone(), fl, Vec::from([payload_enum_ty()]), Type::Unit)
  expect_arg(&p_payload, 0, AbiValueClass::TaggedPtr(8), AbiLocationKind::Register, "a0", false, 8, "riscv64 internal payload enum arg")
end

# ———————————————————————————————————————————————————————————————
# 6. ExternC — aarch64 (AAPCS64)
# ———————————————————————————————————————————————————————————————

@test
def test_aarch64_extern_c_rows() -> Unit
  let desc = aarch64_desc()
  let lt = aarch64_target()
  let fl = AbiFlavor::ExternC

  # A <=16-byte composite crosses in TWO integer registers, by value.
  let p_pair = row_plan(desc.clone(), lt.clone(), fl, Vec::from([pair16_ty()]), Type::Unit)
  expect_arg(&p_pair, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::RegisterPairGpr, "x0,x1", false, 16, "aarch64 ExternC pair16 arg")
  expect_ret(&p_pair, "direct:pair:8:8", "aarch64 ExternC pair16 ret")

  # The 12-byte @packed struct: the same two-eightbyte class.
  let p_packed = row_plan(desc.clone(), lt.clone(), fl, Vec::from([packed12_ty()]), Type::Unit)
  expect_arg(&p_packed, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::RegisterPairGpr, "x0,x1", false, 12, "aarch64 ExternC packed12 arg")

  # A payloaded enum is not FFI-safe: fail closed.
  assert(row_plan_is_err(desc.clone(), lt.clone(), fl, Vec::from([payload_enum_ty()]), Type::Unit), "aarch64 ExternC payload enum must fail closed")

  # A payload-less enum crosses as its raw tag word.
  let p_unit = row_plan(desc.clone(), lt.clone(), fl, Vec::from([unit_enum_ty()]), Type::Unit)
  expect_arg(&p_unit, 0, AbiValueClass::TaggedPtr(8), AbiLocationKind::Register, "x0", false, 8, "aarch64 ExternC unit enum arg")
  expect_ret(&p_unit, "direct:scalar:8", "aarch64 ExternC unit enum ret")

  # HFA gap (audit P1-13): a two-F64 aggregate is classified by size,
  # so the C plan reports the integer pair (the AAPCS64 HFA answer is
  # d0,d1; the member-type scan is the documented remaining step).
  let p_f64 = row_plan(desc.clone(), lt.clone(), fl, Vec::from([two_f64_ty()]), Type::Unit)
  expect_arg(&p_f64, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::RegisterPairGpr, "x0,x1", false, 16, "aarch64 ExternC two-F64 arg (documented HFA gap)")

  # A two-F32 aggregate fits ONE 8-byte eightbyte.
  let p_f32 = row_plan(desc.clone(), lt.clone(), fl, Vec::from([two_f32_ty()]), Type::Unit)
  expect_arg(&p_f32, 0, AbiValueClass::ScalarInt(8), AbiLocationKind::Register, "x0", false, 8, "aarch64 ExternC two-F32 arg (documented HFA gap)")

  # String is not a C boundary value.
  assert(row_plan_is_err(desc.clone(), lt.clone(), fl, Vec::from([Type::String]), Type::Unit), "aarch64 ExternC String must fail closed")

  # The UnsafeSlice view: two integer registers.
  let p_slice = row_plan(desc.clone(), lt.clone(), fl, Vec::from([unsafe_slice_ty()]), Type::Unit)
  expect_arg(&p_slice, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::RegisterPairGpr, "x0,x1", false, 16, "aarch64 ExternC UnsafeSlice arg")

  # i128: two integer registers.
  let p_i128 = row_plan(desc.clone(), lt.clone(), fl, Vec::from([Type::I128]), Type::Unit)
  expect_arg(&p_i128, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::RegisterPairGpr, "x0,x1", false, 16, "aarch64 ExternC i128 arg")
  expect_ret(&p_i128, "direct:pair:8:8", "aarch64 ExternC i128 ret")

  # Beyond the register pairs the composite goes to the stack by value,
  # not by pointer: four pairs fill x0..x7, so arg index 4 is the first
  # stacked one (the overflow arm re-classes it ByAddress while the
  # location stays a stack offset — the old "memory" render).
  var nine: Vec[Type] = Vec::new()
  var i = 0
  while i < 9 do
    nine.push(pair16_ty())
    i = i + 1
  end
  let p_nine = row_plan(desc.clone(), lt.clone(), fl, nine, Type::Unit)
  expect_arg(&p_nine, 4, AbiValueClass::ByAddress(16), AbiLocationKind::StackOffset, "stack+0", false, 16, "aarch64 ExternC 5th pair arg")
  expect_arg(&p_nine, 8, AbiValueClass::ByAddress(16), AbiLocationKind::StackOffset, "stack+64", false, 16, "aarch64 ExternC 9th pair arg")
end

# ———————————————————————————————————————————————————————————————
# 7. ExternC — x86-64 SysV
# ———————————————————————————————————————————————————————————————

@test
def test_x86_64_extern_c_rows() -> Unit
  let desc = x86_64_desc()
  let lt = x86_64_target()
  let fl = AbiFlavor::ExternC

  let p_pair = row_plan(desc.clone(), lt.clone(), fl, Vec::from([pair16_ty()]), Type::Unit)
  expect_arg(&p_pair, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::RegisterPairGpr, "rdi,rsi", false, 16, "x86_64 ExternC pair16 arg")
  expect_ret(&p_pair, "direct:pair:8:8", "x86_64 ExternC pair16 ret")

  let p_packed = row_plan(desc.clone(), lt.clone(), fl, Vec::from([packed12_ty()]), Type::Unit)
  expect_arg(&p_packed, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::RegisterPairGpr, "rdi,rsi", false, 12, "x86_64 ExternC packed12 arg")

  assert(row_plan_is_err(desc.clone(), lt.clone(), fl, Vec::from([payload_enum_ty()]), Type::Unit), "x86_64 ExternC payload enum must fail closed")
end

