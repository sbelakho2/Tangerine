# tests/abi/abi_call_plan_rows_test.tg — audit items 28 + 29 and
# third-audit item 41: the ABI call-plan rows over the TYPED carriers.
#
# ROW-BASED ASSERTIONS over layout_engine.classify_call_plan — the ONE
# ABI classification authority shared by the direct emitter, LIR, the
# extern dispatch, callbacks and bindgen.  Every row pins the plan's
# decisions for one (target, flavor, signature) against the audit's case
# list:
#   - the 16-byte pair struct (PairInt: "pair:8:8", by-reference internal)
#   - the 12-byte @packed struct (the C-ABI two-eightbyte case)
#   - a payload-carrying registered enum (canonical TaggedPtr word —
#     audit item 29)
#   - a payload-less registered enum (both routes cross the same word)
#   - a two-F64 aggregate and a two-F32 aggregate (the documented P1-13
#     HFA gap: classified by size, so the C plan reports the GP class)
#   - String (not FFI-safe under ExternC)
#   - the raw UnsafeSlice view (the 16-byte ScalarPair image)
#   - i128 (ScalarPair, sret return)
# over the targets aarch64, x86-64, cortex-m4f and riscv64imac, in BOTH
# plan flavors (InternalValue = the compiler's own convention, ExternC =
# the platform C ABI).
#
# (third-audit item 41): the carriers are STRUCTURED VALUES now —
# AbiValueClass / AbiLocation / AbiExtension — and this lane inspects
# them typed (the decision path carries no class-word strings) plus pins
# the report-boundary renders byte-identical to the old vocabulary
# (abi_value_class_word / abi_location_text / abi_extension_word /
# abi_return_text).
#
# The mixed-backend ABI rows (a direct-compiled caller calling an
# LIR-compiled callee) cannot run: every compilation is entirely direct
# or entirely LIR (see lir.tg's audit item 29 note); these rows pin the
# classification layer those routes share.
#
# (third-audit items 42/43): the last two sections pin the persisted
# typed FFI-surface row / FfiReport lane — the word seams the snapshot
# producer uses (ownership / failure / nullability / enum-crossing) and
# the verbatim report mapping for the audit's signature cases (plain int
# fn, extern with a sink param, extern returning an owning String,
# variadic printf-style, enum-crossing fn).
#
# Run with: tg test tests/abi/abi_call_plan_rows_test.tg

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::test::*

use tg_compiler::layout_engine::{
  LayoutEngine, TargetDescriptor,
  aarch64_target, x86_64_target, wasm32_target,
  layout_engine_new, layout_engine_register_types, compute_all_layouts,
  classify_call_plan, AbiCallPlan, AbiFlavor, AbiReturn, AbiEnumCrossing,
  classify_enum_crossing, abi_internal_image_class, layout_error_to_string,
  # (third-audit item 41) the typed carriers, their location
  # constructors and the report-boundary renders.
  AbiValueClass, AbiLocationKind, AbiExtension,
  abi_value_class_word, abi_location_text, abi_extension_word, abi_return_text,
  abi_location_none, abi_location_register, abi_location_pair_gpr,
  abi_location_pair_fp, abi_location_stack
}
use tg_compiler::target_desc::{
  TargetDesc, aarch64_desc, x86_64_desc,
  thumbv7em_cortex_m4f_desc, riscv64imac_desc
}
use tg_compiler::types::{Type, TypeId}
use tg_compiler::mir::{MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef}
use tg_compiler::ast::{layout_attrs_plain}
use tg_compiler::token::{span_dummy}
# (third-audit items 42/43): the persisted typed FFI-surface rows and the
# report that reads them verbatim.
use tg_compiler::semantic_model::{
  SemanticSnapshot, SemanticSymbol, AbiSurfaceRow, StableTargetId,
  semantic_digest_zero, semantic_abi_surface_row_text
}
use tg_compiler::abi_report::{FfiReport, ffi_report_of_symbol, abi_rows_of_snapshot}
use tg_compiler::ids::{DefKind, stable_def_id_digested}
use tg_compiler::semantic_snapshot::{
  snapshot_abi_ownership_word, snapshot_abi_failure_word,
  snapshot_abi_nullability_word, snapshot_abi_enum_crossing_word
}

# ———————————————————————————————————————————————————————————————
# Type-definition fixtures
# ———————————————————————————————————————————————————————————————

struct RowField
  name: String
  ty: Type
end

struct RowVariant
  name: String
  disc: Int
  fields: Vec[Type]
end

def row_field(name: String, ty: Type) -> RowField
  RowField { name: name.to_string(), ty: ty }
end

def row_variant(name: String, disc: Int, fields: Vec[Type]) -> RowVariant
  RowVariant { name: name.to_string(), disc: disc, fields: fields }
end

def row_struct_def(tid: Int, name: String, fields: Vec[RowField], packed: Bool) -> MirTypeDef
  var fds: Vec[MirFieldDef] = Vec::new()
  for f in fields do
    fds.push(MirFieldDef { name: f.name.clone(), ty: f.ty.clone() })
  end
  var attrs = layout_attrs_plain(span_dummy())
  if packed then
    attrs.is_packed = true
  end
  MirTypeDef {
    id: TypeId { id: tid },
    name: name.to_string(),
    kind: MirTypeDefKind::Struct(fds),
    generic_params: Vec::new(),
    layout: attrs
  }
end

def row_enum_def(tid: Int, name: String, variants: Vec[RowVariant]) -> MirTypeDef
  var vds: Vec[MirVariantDef] = Vec::new()
  for v in variants do
    vds.push(MirVariantDef { name: v.name.clone(), discriminant: v.disc, fields: v.fields.clone() })
  end
  MirTypeDef {
    id: TypeId { id: tid },
    name: name.to_string(),
    kind: MirTypeDefKind::Enum(vds),
    generic_params: Vec::new(),
    layout: layout_attrs_plain(span_dummy())
  }
end

# ———————————————————————————————————————————————————————————————
# The fixture type ids (one set for the whole file)
# ———————————————————————————————————————————————————————————————
# Pair16      — struct { a: Int, b: Int }                 (16 bytes)
# Packed12    — @packed struct { a: U32, b: U64 }         (12 bytes, C class)
# PayloadEnum — enum { None, Some(Int) }                  (TaggedPtr, payload)
# UnitEnum    — enum { Off, On }                          (TaggedPtr, no payload)
# TwoF64      — struct { a: F64, b: F64 }                 (16 bytes)
# TwoF32      — struct { a: F32, b: F32 }                 (8 bytes)
# SliceView   — the UnsafeSlice[u8] raw view              (16 bytes)
def row_defs() -> Vec[MirTypeDef]
  var defs: Vec[MirTypeDef] = Vec::new()
  var pair_fields: Vec[RowField] = Vec::new()
  pair_fields.push(row_field("a", Type::Int))
  pair_fields.push(row_field("b", Type::Int))
  defs.push(row_struct_def(1, "Pair16", pair_fields, false))

  var packed_fields: Vec[RowField] = Vec::new()
  packed_fields.push(row_field("a", Type::U32))
  packed_fields.push(row_field("b", Type::U64))
  defs.push(row_struct_def(2, "Packed12", packed_fields, true))

  var payload_variants: Vec[RowVariant] = Vec::new()
  payload_variants.push(row_variant("None", 0, Vec::new()))
  payload_variants.push(row_variant("Some", 1, Vec::from([Type::Int])))
  defs.push(row_enum_def(3, "PayloadEnum", payload_variants))

  var unit_variants: Vec[RowVariant] = Vec::new()
  unit_variants.push(row_variant("Off", 0, Vec::new()))
  unit_variants.push(row_variant("On", 1, Vec::new()))
  defs.push(row_enum_def(4, "UnitEnum", unit_variants))

  var f64_fields: Vec[RowField] = Vec::new()
  f64_fields.push(row_field("a", Type::F64))
  f64_fields.push(row_field("b", Type::F64))
  defs.push(row_struct_def(5, "TwoF64", f64_fields, false))

  var f32_fields: Vec[RowField] = Vec::new()
  f32_fields.push(row_field("a", Type::F32))
  f32_fields.push(row_field("b", Type::F32))
  defs.push(row_struct_def(6, "TwoF32", f32_fields, false))

  # The UnsafeSlice raw view: a registered Opaque builtin with NO
  # MirTypeDef in real compilations; the layout engine keys it by NAME.
  # The fixture registers a placeholder def under that name.
  defs.push(row_struct_def(7, "UnsafeSlice", Vec::new(), false))
  defs
end

def pair16_ty() -> Type = Type::Adt(TypeId { id: 1 }, Vec::new())
def packed12_ty() -> Type = Type::Adt(TypeId { id: 2 }, Vec::new())
def payload_enum_ty() -> Type = Type::Adt(TypeId { id: 3 }, Vec::new())
def unit_enum_ty() -> Type = Type::Adt(TypeId { id: 4 }, Vec::new())
def two_f64_ty() -> Type = Type::Adt(TypeId { id: 5 }, Vec::new())
def two_f32_ty() -> Type = Type::Adt(TypeId { id: 6 }, Vec::new())
def unsafe_slice_ty() -> Type = Type::Adt(TypeId { id: 7 }, Vec::from([Type::U8]))

# ———————————————————————————————————————————————————————————————
# Plan invocation helpers
# ———————————————————————————————————————————————————————————————

def row_plan(desc: TargetDesc, layout_target: TargetDescriptor, flavor: AbiFlavor, params: Vec[Type], ret_ty: Type) -> AbiCallPlan
  mut engine = layout_engine_new(layout_target)
  let defs = row_defs()
  layout_engine_register_types(&mut engine, &defs)
  compute_all_layouts(&mut engine)
  match classify_call_plan(&mut engine, desc, flavor, params, ret_ty.clone(), false)
  when Result::Ok(plan) then plan
  when Result::Err(e) then
    panic("ABI row: classify_call_plan failed closed: " + layout_error_to_string(&e))
  end
end

def row_plan_is_err(desc: TargetDesc, layout_target: TargetDescriptor, flavor: AbiFlavor, params: Vec[Type], ret_ty: Type) -> Bool
  mut engine = layout_engine_new(layout_target)
  let defs = row_defs()
  layout_engine_register_types(&mut engine, &defs)
  compute_all_layouts(&mut engine)
  match classify_call_plan(&mut engine, desc, flavor, params, ret_ty.clone(), false)
  when Result::Ok(_) then false
  when Result::Err(_) then true
  end
end

# ———————————————————————————————————————————————————————————————
# Row assertions (TYPED — third-audit item 41)
# ———————————————————————————————————————————————————————————————

def expect_arg(plan: &AbiCallPlan, idx: Int, value_class: AbiValueClass, location_kind: AbiLocationKind, location_text: String, indirect: Bool, size: Int, what: String) -> Unit
  let p = plan.args[idx]
  assert(p.value_class == value_class, what + ": value class expected `" + abi_value_class_word(&value_class) + "`, got `" + abi_value_class_word(&p.value_class) + "`")
  assert(p.location.kind == location_kind, what + ": location kind expected `" + location_text + "`, got `" + abi_location_text(&p.location) + "`")
  assert(abi_location_text(&p.location) == location_text, what + ": location expected `" + location_text + "`, got `" + abi_location_text(&p.location) + "`")
  assert(p.indirect == indirect, what + ": indirect expected " + indirect.to_string() + ", got " + p.indirect.to_string())
  assert(p.size == size, what + ": size expected " + size.to_string() + ", got " + p.size.to_string())
end

def expect_ret(plan: &AbiCallPlan, class_text: String, what: String) -> Unit
  let text = abi_return_text(plan.ret.clone())
  assert(text == class_text, what + ": return class expected `" + class_text + "`, got `" + text + "`")
end

# ———————————————————————————————————————————————————————————————
# 0. the typed carriers (third-audit item 41): one render row per
# AbiValueClass variant, the location kinds, the extensions and the
# return carrier — every render byte-identical to the old vocabulary.
# ———————————————————————————————————————————————————————————————

@test
def test_value_class_render_rows() -> Unit
  assert(abi_value_class_word(AbiValueClass::Zero) == "zero", "class Zero: zero")
  assert(abi_value_class_word(AbiValueClass::ScalarInt(8)) == "scalar:8", "class ScalarInt: scalar:8")
  assert(abi_value_class_word(AbiValueClass::ScalarFloat(4)) == "scalar:4", "class ScalarFloat: scalar:4")
  assert(abi_value_class_word(AbiValueClass::PairInt(8, 8)) == "pair:8:8", "class PairInt: pair:8:8")
  assert(abi_value_class_word(AbiValueClass::PairFloat(4, 4)) == "pair:4:4", "class PairFloat: pair:4:4")
  assert(abi_value_class_word(AbiValueClass::MixedPair(8, 4)) == "pair:8:4", "class MixedPair: pair:8:4")
  assert(abi_value_class_word(AbiValueClass::Vector(16)) == "vector:16", "class Vector: vector:16")
  assert(abi_value_class_word(AbiValueClass::ByAddress(24)) == "by-address:24", "class ByAddress: by-address:24")
  assert(abi_value_class_word(AbiValueClass::TaggedPtr(8)) == "scalar:8", "class TaggedPtr: scalar:8")
  assert(abi_value_class_word(AbiValueClass::EnumInline(16)) == "by-address:16", "class EnumInline: by-address:16")
end

@test
def test_location_render_rows() -> Unit
  assert(abi_location_text(abi_location_none()) == "none", "location None: none")
  assert(abi_location_text(abi_location_register("x0".to_string())) == "x0", "location Register: x0")
  assert(abi_location_text(abi_location_register("d0".to_string())) == "d0", "location FP register: d0")
  assert(abi_location_text(abi_location_pair_gpr("x0".to_string(), "x1".to_string())) == "x0,x1", "location GPR pair: x0,x1")
  assert(abi_location_text(abi_location_pair_fp("d0".to_string(), "d1".to_string())) == "d0,d1", "location FP pair: d0,d1")
  assert(abi_location_text(abi_location_stack(16)) == "stack+16", "location stack: stack+16")
end

@test
def test_extension_render_rows() -> Unit
  assert(abi_extension_word(AbiExtension::None) == "none", "extension None: none")
  assert(abi_extension_word(AbiExtension::SignExtend) == "sign", "extension SignExtend: sign")
  assert(abi_extension_word(AbiExtension::ZeroExtend) == "zero", "extension ZeroExtend: zero")
  assert(abi_extension_word(AbiExtension::AnyRegister) == "any", "extension AnyRegister: any")
end

@test
def test_return_carrier_rows() -> Unit
  assert(abi_return_text(AbiReturn::VoidT) == "direct:zero", "return VoidT: direct:zero")
  assert(abi_return_text(AbiReturn::GprT(AbiValueClass::ScalarInt(8))) == "direct:scalar:8", "return GprT: direct:scalar:8")
  assert(abi_return_text(AbiReturn::FprT(AbiValueClass::ScalarFloat(8))) == "direct:scalar:8", "return FprT: direct:scalar:8")
  assert(abi_return_text(AbiReturn::GprPairT(AbiValueClass::PairInt(8, 8))) == "direct:pair:8:8", "return GprPairT: direct:pair:8:8")
  assert(abi_return_text(AbiReturn::FprPairT(AbiValueClass::Vector(16))) == "direct:vector:16", "return FprPairT: direct:vector:16")
  assert(abi_return_text(AbiReturn::SRetT(AbiValueClass::ByAddress(24))) == "sret:by-address:24", "return SRetT: sret:by-address:24")
end

# ———————————————————————————————————————————————————————————————
# 1. the shared internal image-class rule (the LIR/direct agreement)
# ———————————————————————————————————————————————————————————————

@test
def test_internal_image_class_rows() -> Unit
  assert(abi_internal_image_class(0) == AbiValueClass::Zero, "image 0: zero")
  assert(abi_internal_image_class(1) == AbiValueClass::ScalarInt(1), "image 1: one word")
  assert(abi_internal_image_class(4) == AbiValueClass::ScalarInt(4), "image 4: one word")
  assert(abi_internal_image_class(8) == AbiValueClass::ScalarInt(8), "image 8: one word")
  assert(abi_internal_image_class(12) == AbiValueClass::PairInt(8, 8), "image 12: pair")
  assert(abi_internal_image_class(16) == AbiValueClass::PairInt(8, 8), "image 16: pair")
  assert(abi_internal_image_class(24) == AbiValueClass::ByAddress(24), "image 24: by-address")
end

# ———————————————————————————————————————————————————————————————
# 2. aarch64 — internal flavor (the direct/LIR compiler convention)
# ———————————————————————————————————————————————————————————————

@test
def test_aarch64_internal_rows() -> Unit
  let desc = aarch64_desc()
  let lt = aarch64_target()
  let fl = AbiFlavor::InternalValue

  # The 16-byte pair struct: ONE general slot carrying the image address,
  # sret return.
  let p_pair = row_plan(desc.clone(), lt.clone(), fl, Vec::from([pair16_ty()]), Type::Unit)
  expect_arg(&p_pair, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::Register, "x0", true, 16, "aarch64 internal pair16 arg")
  expect_ret(&p_pair, "sret:pair:8:8", "aarch64 internal pair16 ret")

  # The 12-byte @packed struct: the C-repr aggregate rule gives the
  # two-slot image, still by reference internally.
  let p_packed = row_plan(desc.clone(), lt.clone(), fl, Vec::from([packed12_ty()]), Type::Unit)
  expect_arg(&p_packed, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::Register, "x0", true, 12, "aarch64 internal packed12 arg")

  # The payloaded enum: the canonical ONE TaggedPtr word (item 29).
  let p_payload = row_plan(desc.clone(), lt.clone(), fl, Vec::from([payload_enum_ty()]), Type::Unit)
  expect_arg(&p_payload, 0, AbiValueClass::TaggedPtr(8), AbiLocationKind::Register, "x0", false, 8, "aarch64 internal payload enum arg")
  expect_ret(&p_payload, "direct:scalar:8", "aarch64 internal payload enum ret")

  # The payload-less enum: the same word BOTH routes use.
  let p_unit = row_plan(desc.clone(), lt.clone(), fl, Vec::from([unit_enum_ty()]), Type::Unit)
  expect_arg(&p_unit, 0, AbiValueClass::TaggedPtr(8), AbiLocationKind::Register, "x0", false, 8, "aarch64 internal unit enum arg")

  # The two-F64 aggregate: 16 bytes -> pair (the HFA gap is documented;
  # the size rule is what both routes implement).
  let p_f64 = row_plan(desc.clone(), lt.clone(), fl, Vec::from([two_f64_ty()]), Type::Unit)
  expect_arg(&p_f64, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::Register, "x0", true, 16, "aarch64 internal two-F64 arg")

  # The two-F32 aggregate: 8 bytes -> ONE word by value.
  let p_f32 = row_plan(desc.clone(), lt.clone(), fl, Vec::from([two_f32_ty()]), Type::Unit)
  expect_arg(&p_f32, 0, AbiValueClass::ScalarInt(8), AbiLocationKind::Register, "x0", false, 8, "aarch64 internal two-F32 arg")

  # String: the one-pointer handle word.
  let p_str = row_plan(desc.clone(), lt.clone(), fl, Vec::from([Type::String]), Type::Unit)
  expect_arg(&p_str, 0, AbiValueClass::ScalarInt(8), AbiLocationKind::Register, "x0", false, 8, "aarch64 internal String arg")

  # The UnsafeSlice raw view: the 16-byte image.
  let p_slice = row_plan(desc.clone(), lt.clone(), fl, Vec::from([unsafe_slice_ty()]), Type::Unit)
  expect_arg(&p_slice, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::Register, "x0", true, 16, "aarch64 internal UnsafeSlice arg")

  # i128: ScalarPair, sret return.
  let p_i128 = row_plan(desc.clone(), lt.clone(), fl, Vec::from([Type::I128]), Type::Unit)
  expect_arg(&p_i128, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::Register, "x0", true, 16, "aarch64 internal i128 arg")
  expect_ret(&p_i128, "sret:pair:8:8", "aarch64 internal i128 ret")

  # The ninth general-class argument overflows to the caller stack.
  var nine: Vec[Type] = Vec::new()
  var i = 0
  while i < 9 do
    nine.push(pair16_ty())
    i = i + 1
  end
  let p_nine = row_plan(desc.clone(), lt.clone(), fl, nine, Type::Unit)
  expect_arg(&p_nine, 8, AbiValueClass::PairInt(8, 8), AbiLocationKind::StackOffset, "stack+0", true, 16, "aarch64 internal 9th pair arg")
  assert(p_nine.stack_arg_bytes == 16, "aarch64 internal 9th pair: stack_arg_bytes expected 16, got " + p_nine.stack_arg_bytes.to_string())
end

# ———————————————————————————————————————————————————————————————
# 3. x86-64 — internal flavor
# ———————————————————————————————————————————————————————————————

@test
def test_x86_64_internal_rows() -> Unit
  let desc = x86_64_desc()
  let lt = x86_64_target()
  let fl = AbiFlavor::InternalValue

  let p_pair = row_plan(desc.clone(), lt.clone(), fl, Vec::from([pair16_ty()]), Type::Unit)
  expect_arg(&p_pair, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::Register, "rdi", true, 16, "x86_64 internal pair16 arg")
  # The plan's internal sret policy is target-independent (the x86-64
  # direct emitter's no-hidden-pointer return is a documented gap).
  expect_ret(&p_pair, "sret:pair:8:8", "x86_64 internal pair16 ret")

  let p_payload = row_plan(desc.clone(), lt.clone(), fl, Vec::from([payload_enum_ty()]), Type::Unit)
  expect_arg(&p_payload, 0, AbiValueClass::TaggedPtr(8), AbiLocationKind::Register, "rdi", false, 8, "x86_64 internal payload enum arg")
end

# ———————————————————————————————————————————————————————————————
# 4. cortex-m4f — internal flavor (r0..r3, 4-byte word model)
# ———————————————————————————————————————————————————————————————

@test
def test_cortex_m_internal_rows() -> Unit
  let desc = thumbv7em_cortex_m4f_desc()
  let lt = wasm32_target()
  let fl = AbiFlavor::InternalValue

  let p_pair = row_plan(desc.clone(), lt.clone(), fl, Vec::from([pair16_ty()]), Type::Unit)
  expect_arg(&p_pair, 0, AbiValueClass::PairInt(8, 8), AbiLocationKind::Register, "r0", true, 16, "cortex-m internal pair16 arg")
  expect_ret(&p_pair, "sret:pair:8:8", "cortex-m internal pair16 ret")

  let p_payload = row_plan(desc.clone(), lt.clone(), fl, Vec::from([payload_enum_ty()]), Type::Unit)
  expect_arg(&p_payload, 0, AbiValueClass::TaggedPtr(4), AbiLocationKind::Register, "r0", false, 4, "cortex-m internal payload enum arg")
end

# ———————————————————————————————————————————————————————————————
