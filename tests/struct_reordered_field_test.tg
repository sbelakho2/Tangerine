use std::io::{print, println}

# Regression test for AggregateKind::Struct field-name -> declared-offset lowering.
#
# The struct is declared in order a, b, c, but the literal below lists its
# fields in a DIFFERENT order (c, a, b). codegen_aggregate must resolve each
# operand to the DECLARED offset of the field it names. A positional fallback
# (operand i -> declared field i) would misplace every field, e.g. c's value
# written into a's slot. Different field sizes (Bool vs Int) make a misplacement
# observable both at offset granularity and at byte granularity.
struct Record
  a: Int
  b: Bool
  c: Int
end

def main() -> Int
  let r = Record { c: 100, a: 7, b: true }
  if r.a == 7 && r.b && r.c == 100 then
    42
  else
    1
  end
end
