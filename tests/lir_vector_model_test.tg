# tests/lir_vector_model_test.tg — audit item 34 (stage 1): the LIR
# VECTOR CLASS's row/structure model.
#
# The explicit-SIMD slice models a vector value as a compact lane
# descriptor (LirVectorLane: elem_kind/lanes/bits) carried by the
# vector-class vreg tables (LirFunction.vector_widths / vector_lanes)
# and by the LirVecOp statement marker. This suite pins the canonical
# constructors, the descriptor validation/name helpers and the marker
# def/use rows (lir_vec_stmt_occ — the shape lir_linearize and the
# verifier consume), so the class data cannot silently drift. The
# TARGET legality rows live in tests/target_vector_authority_test.tg.
#
# Run with: tg test tests/lir_vector_model_test.tg

use std::core::{Option, Unit, Bool, panic}
use std::collections::{Vec}
use std::test::*
use tg_compiler::types::{SimdLane, SimdIntrinsicKind}
use tg_compiler::asm::{
  CodeBuffer, buf_new, A64, A64V,
  a64_neon_bic, a64_neon_cmeq, a64_neon_cmgt, a64_neon_cmge,
  a64_neon_fcmeq, a64_neon_fcmgt, a64_neon_fcmge,
  a64_neon_sshl, a64_neon_ushl, a64_neon_umin, a64_neon_bit, a64_neon_neg,
  a64_neon_shl_imm, a64_neon_sshr_imm, a64_neon_ushr_imm,
  a64_neon_dup_b, a64_neon_dup_d,
  a64_neon_umov_b, a64_neon_umov_s, a64_neon_umov_d,
  a64_neon_ins_b, a64_neon_ins_d,
  a64_neon_sqxtn, a64_neon_sqxtn2, a64_neon_sshll, a64_neon_sshll2
}
use tg_compiler::lir::{
  LirVectorLane, LirVecBinOp, LirVecOp,
  lir_vector_lane_build,
  lir_vector_lane_f32x4, lir_vector_lane_f64x2,
  lir_vector_lane_i8x16, lir_vector_lane_i16x8,
  lir_vector_lane_i32x4, lir_vector_lane_i64x2,
  lir_vector_lane_u8x16, lir_vector_lane_u16x8,
  lir_vector_lane_u32x4, lir_vector_lane_u64x2,
  lir_vector_lane_f32x8, lir_vector_lane_f64x4,
  lir_vector_lane_i8x32, lir_vector_lane_i16x16,
  lir_vector_lane_i32x8, lir_vector_lane_i64x4,
  lir_vector_lane_u8x32, lir_vector_lane_u16x16,
  lir_vector_lane_u32x8, lir_vector_lane_u64x4,
  lir_vector_elem_bits, lir_vector_elem_is_float,
  lir_vector_elem_is_signed, lir_vector_elem_is_unsigned,
  lir_vector_lane_ok, lir_vector_lane_name, lir_vector_lane_is_float,
  lir_vector_lane_of_simd_lane, lir_simd_lane_of_vector_lane,
  lir_vec_binop_intrinsic_kind, lir_vec_binop_of_intrinsic_kind,
  lir_vec_binop_is_compare, lir_vec_shift_form_ok, lir_vec_shift_form_name,
  lir_vector_lane_narrow, lir_vector_lane_widen,
  LirSimdExtKind, lir_simd_ext_op_of, lir_simd_ext_op_name,
  lir_simd_ext_binop_of, lir_simd_ext_shift_form_of,
  lir_vec_stmt_occ
}

# ———————————————————————————————————————————————————————————————
# The canonical constructors: lane/bit rows
# ———————————————————————————————————————————————————————————————

def check_lane(l: LirVectorLane, kind: String, lanes: Int, bits: Int) -> Unit
  assert_true(l.elem_kind == kind)
  assert_true(l.lanes == lanes)
  assert_true(l.bits == bits)
  assert_true(lir_vector_lane_ok(l))
  assert_true(lir_vector_lane_name(l) == (kind + "x" + lanes.to_string()))
end

@test
def test_v128_lane_constructors() -> Unit
  check_lane(lir_vector_lane_f32x4(), "f32", 4, 128)
  check_lane(lir_vector_lane_f64x2(), "f64", 2, 128)
  check_lane(lir_vector_lane_i8x16(), "i8", 16, 128)
  check_lane(lir_vector_lane_i16x8(), "i16", 8, 128)
  check_lane(lir_vector_lane_i32x4(), "i32", 4, 128)
  check_lane(lir_vector_lane_i64x2(), "i64", 2, 128)
  check_lane(lir_vector_lane_u8x16(), "u8", 16, 128)
  check_lane(lir_vector_lane_u16x8(), "u16", 8, 128)
  check_lane(lir_vector_lane_u32x4(), "u32", 4, 128)
  check_lane(lir_vector_lane_u64x2(), "u64", 2, 128)
end

@test
def test_v256_lane_constructors() -> Unit
  check_lane(lir_vector_lane_f32x8(), "f32", 8, 256)
  check_lane(lir_vector_lane_f64x4(), "f64", 4, 256)
  check_lane(lir_vector_lane_i8x32(), "i8", 32, 256)
  check_lane(lir_vector_lane_i16x16(), "i16", 16, 256)
  check_lane(lir_vector_lane_i32x8(), "i32", 8, 256)
  check_lane(lir_vector_lane_i64x4(), "i64", 4, 256)
  check_lane(lir_vector_lane_u8x32(), "u8", 32, 256)
  check_lane(lir_vector_lane_u16x16(), "u16", 16, 256)
  check_lane(lir_vector_lane_u32x8(), "u32", 8, 256)
  check_lane(lir_vector_lane_u64x4(), "u64", 4, 256)
end

@test
def test_lane_builder_and_validation_rows() -> Unit
  # The validating canonical builder.
  let l = lir_vector_lane_build("i16", 8)
  assert_true(l.elem_kind == "i16" && l.lanes == 8 && l.bits == 128)
  # The shape predicate rejects malformed descriptors.
  assert_true(!lir_vector_lane_ok(LirVectorLane { elem_kind: "f32", lanes: 4, bits: 127 }))
  assert_true(!lir_vector_lane_ok(LirVectorLane { elem_kind: "f32", lanes: 4, bits: 129 }))
  assert_true(!lir_vector_lane_ok(LirVectorLane { elem_kind: "f32", lanes: 0, bits: 0 }))
  assert_true(!lir_vector_lane_ok(LirVectorLane { elem_kind: "bogus", lanes: 4, bits: 128 }))
  # The elem-kind predicates.
  assert_true(lir_vector_elem_bits("i8") == 8)
  assert_true(lir_vector_elem_bits("u16") == 16)
  assert_true(lir_vector_elem_bits("i32") == 32)
  assert_true(lir_vector_elem_bits("u64") == 64)
  assert_true(lir_vector_elem_bits("f32") == 32)
  assert_true(lir_vector_elem_bits("f64") == 64)
  assert_true(lir_vector_elem_bits("bogus") == 0)
  assert_true(lir_vector_elem_is_float("f32"))
  assert_true(lir_vector_elem_is_float("f64"))
  assert_true(!lir_vector_elem_is_float("i32"))
  assert_true(lir_vector_elem_is_signed("i8") && lir_vector_elem_is_signed("i16"))
  assert_true(lir_vector_elem_is_signed("i32") && lir_vector_elem_is_signed("i64"))
  assert_true(!lir_vector_elem_is_signed("u32") && !lir_vector_elem_is_signed("f32"))
  assert_true(lir_vector_elem_is_unsigned("u8") && lir_vector_elem_is_unsigned("u16"))
  assert_true(lir_vector_elem_is_unsigned("u32") && lir_vector_elem_is_unsigned("u64"))
  assert_true(!lir_vector_elem_is_unsigned("i32") && !lir_vector_elem_is_unsigned("f64"))
  # The float predicate of a descriptor.
  assert_true(lir_vector_lane_is_float(lir_vector_lane_f64x2()))
  assert_true(!lir_vector_lane_is_float(lir_vector_lane_i64x2()))
end

# ———————————————————————————————————————————————————————————————
# The SimdLane bridge: the 12 intrinsic spellings map, the 512-bit
# spellings do not (no descriptor models a 512-bit facility)
# ———————————————————————————————————————————————————————————————

@test
def test_simd_lane_bridge_rows() -> Unit
  match lir_vector_lane_of_simd_lane(SimdLane::F32x4)
  when Option::Some(l) then assert_true(lir_vector_lane_name(l) == "f32x4")
  when Option::None then panic("F32x4 must map to a descriptor")
  end
  match lir_vector_lane_of_simd_lane(SimdLane::I64x2)
  when Option::Some(l) then assert_true(lir_vector_lane_name(l) == "i64x2")
  when Option::None then panic("I64x2 must map to a descriptor")
  end
  match lir_vector_lane_of_simd_lane(SimdLane::F32x8)
  when Option::Some(l) then assert_true(lir_vector_lane_name(l) == "f32x8")
  when Option::None then panic("F32x8 must map to a descriptor")
  end
  match lir_vector_lane_of_simd_lane(SimdLane::I32x8)
  when Option::Some(l) then assert_true(lir_vector_lane_name(l) == "i32x8")
  when Option::None then panic("I32x8 must map to a descriptor")
  end
  # The 512-bit spellings have no descriptor: the lowering fail-closes
  # on them.
  match lir_vector_lane_of_simd_lane(SimdLane::F32x16)
  when Option::None then ()
  when Option::Some(_) then panic("F32x16 is 512-bit and must not map to a descriptor")
  end
  match lir_vector_lane_of_simd_lane(SimdLane::I64x8)
  when Option::None then ()
  when Option::Some(_) then panic("I64x8 is 512-bit and must not map to a descriptor")
  end
  # The reverse bridge (used by the emitter to reach codegen's NEON
  # tables) round-trips the intrinsic-family descriptors.
  match lir_simd_lane_of_vector_lane(lir_vector_lane_f32x4())
  when Option::Some(s) then
    match s
    when SimdLane::F32x4 then ()
    when _ then panic("f32x4 must map back to SimdLane::F32x4")
    end
  when Option::None then panic("f32x4 must map back to a SimdLane")
  end
  match lir_simd_lane_of_vector_lane(lir_vector_lane_i16x16())
  when Option::Some(s) then
    match s
    when SimdLane::I16x16 then ()
    when _ then panic("i16x16 must map back to SimdLane::I16x16")
    end
  when Option::None then panic("i16x16 must map back to a SimdLane")
  end
  # An unsigned lane kind has no intrinsic spelling this stage.
  match lir_simd_lane_of_vector_lane(lir_vector_lane_u32x4())
  when Option::None then ()
  when Option::Some(_) then panic("u32x4 has no intrinsic lane spelling")
  end
end

# ———————————————————————————————————————————————————————————————
# The binop token bridge
# ———————————————————————————————————————————————————————————————

def check_binop_is(kind: SimdIntrinsicKind, want: LirVecBinOp) -> Unit
  match lir_vec_binop_of_intrinsic_kind(kind)
  when Option::Some(op) then
    if !(op == want) then
      panic("vec binop bridge: intrinsic kind does not map to the expected LIR op token")
    end
  when Option::None then
    panic("vec binop bridge: intrinsic kind must map to a LIR op token")
  end
end

def check_binop_none(kind: SimdIntrinsicKind) -> Unit
  match lir_vec_binop_of_intrinsic_kind(kind)
  when Option::None then ()
  when Option::Some(_) then
    panic("vec binop bridge: intrinsic kind must not map to a LIR op token")
  end
end

@test
def test_vec_binop_bridge_rows() -> Unit
  check_binop_is(SimdIntrinsicKind::SimdAdd, LirVecBinOp::LirVecAdd)
  check_binop_is(SimdIntrinsicKind::SimdSub, LirVecBinOp::LirVecSub)
  check_binop_is(SimdIntrinsicKind::SimdMul, LirVecBinOp::LirVecMul)
  check_binop_is(SimdIntrinsicKind::SimdAnd, LirVecBinOp::LirVecAnd)
  check_binop_is(SimdIntrinsicKind::SimdOr, LirVecBinOp::LirVecOr)
  check_binop_is(SimdIntrinsicKind::SimdXor, LirVecBinOp::LirVecXor)
  # The non-binop kinds have no LIR token (the lowering fails closed on
  # them with a named rule).
  check_binop_none(SimdIntrinsicKind::SimdLoad)
  check_binop_none(SimdIntrinsicKind::SimdStore)
  check_binop_none(SimdIntrinsicKind::SimdShuffle)
  # The emitter's reverse table: the base tokens carry an intrinsic
  # kind; the explicit-extension tokens do not (they emit through the
  # asm.tg AdvSIMD encoders in lir.tg's own arm).
  assert_true(lir_vec_binop_intrinsic_kind(LirVecBinOp::LirVecMul) == Option::Some(SimdIntrinsicKind::SimdMul))
  assert_true(lir_vec_binop_intrinsic_kind(LirVecBinOp::LirVecAnd) == Option::Some(SimdIntrinsicKind::SimdAnd))
  assert_true(lir_vec_binop_intrinsic_kind(LirVecBinOp::LirVecXor) == Option::Some(SimdIntrinsicKind::SimdXor))
  assert_true(lir_vec_binop_intrinsic_kind(LirVecBinOp::LirVecAndNot) == Option::None)
  assert_true(lir_vec_binop_intrinsic_kind(LirVecBinOp::LirVecEq) == Option::None)
  assert_true(lir_vec_binop_intrinsic_kind(LirVecBinOp::LirVecLt) == Option::None)
  assert_true(lir_vec_binop_intrinsic_kind(LirVecBinOp::LirVecGt) == Option::None)
  assert_true(lir_vec_binop_intrinsic_kind(LirVecBinOp::LirVecLe) == Option::None)
  assert_true(lir_vec_binop_intrinsic_kind(LirVecBinOp::LirVecGe) == Option::None)
  # The compare classifier and the shift-form vocabulary.
  assert_true(lir_vec_binop_is_compare(LirVecBinOp::LirVecEq))
  assert_true(lir_vec_binop_is_compare(LirVecBinOp::LirVecGe))
  assert_true(!lir_vec_binop_is_compare(LirVecBinOp::LirVecAdd))
  assert_true(!lir_vec_binop_is_compare(LirVecBinOp::LirVecAndNot))
  assert_true(lir_vec_shift_form_ok(0) && lir_vec_shift_form_ok(1) && lir_vec_shift_form_ok(2))
  assert_true(!lir_vec_shift_form_ok(3) && !lir_vec_shift_form_ok(-1))
  assert_true(lir_vec_shift_form_name(0) == "shl")
  assert_true(lir_vec_shift_form_name(1) == "lsr")
  assert_true(lir_vec_shift_form_name(2) == "asr")
end

# ———————————————————————————————————————————————————————————————
# The explicit-extension router rows (lir_simd_ext_op_of)
# ———————————————————————————————————————————————————————————————

def check_ext_op(name: String, want: LirSimdExtKind) -> Unit
  match lir_simd_ext_op_of(name)
  when Option::Some(k) then
    if k != want then panic("extension router: " + name + " mapped to the wrong kind") end
  when Option::None then panic("extension router: " + name + " must classify")
  end
end

def check_ext_none(name: String) -> Unit
  match lir_simd_ext_op_of(name)
  when Option::None then ()
  when Option::Some(_) then panic("extension router: " + name + " must not classify")
  end
end

@test
def test_simd_ext_router_rows() -> Unit
  # The prefixed and bare spellings classify identically.
  check_ext_op("__intrinsic_simd_andnot_i32x4", LirSimdExtKind::LirSimdExtAndNot)
  check_ext_op("simd_andnot_i32x4", LirSimdExtKind::LirSimdExtAndNot)
  check_ext_op("__intrinsic_simd_eq_i8x16", LirSimdExtKind::LirSimdExtEq)
  check_ext_op("__intrinsic_simd_lt_f32x4", LirSimdExtKind::LirSimdExtLt)
  check_ext_op("__intrinsic_simd_gt_i16x8", LirSimdExtKind::LirSimdExtGt)
  check_ext_op("__intrinsic_simd_le_f64x2", LirSimdExtKind::LirSimdExtLe)
  check_ext_op("__intrinsic_simd_ge_i64x2", LirSimdExtKind::LirSimdExtGe)
  check_ext_op("__intrinsic_simd_shl_imm_i32x4", LirSimdExtKind::LirSimdExtShlImm)
  check_ext_op("__intrinsic_simd_shr_imm_i16x8", LirSimdExtKind::LirSimdExtShrImm)
  check_ext_op("__intrinsic_simd_sar_imm_i64x2", LirSimdExtKind::LirSimdExtSarImm)
  check_ext_op("__intrinsic_simd_shl_i32x4", LirSimdExtKind::LirSimdExtShl)
  check_ext_op("__intrinsic_simd_shr_i8x16", LirSimdExtKind::LirSimdExtShr)
  check_ext_op("__intrinsic_simd_sar_i16x8", LirSimdExtKind::LirSimdExtSar)
  check_ext_op("__intrinsic_simd_splat_i64x2", LirSimdExtKind::LirSimdExtSplat)
  check_ext_op("__intrinsic_simd_extract_i32x4", LirSimdExtKind::LirSimdExtExtract)
  check_ext_op("__intrinsic_simd_insert_i8x16", LirSimdExtKind::LirSimdExtInsert)
  check_ext_op("__intrinsic_simd_pack_i32x4", LirSimdExtKind::LirSimdExtPack)
  check_ext_op("__intrinsic_simd_unpacklo_i16x8", LirSimdExtKind::LirSimdExtUnpackLo)
  check_ext_op("__intrinsic_simd_unpackhi_i8x16", LirSimdExtKind::LirSimdExtUnpackHi)
  # The base router's ops and unknown spellings do not classify here.
  check_ext_none("__intrinsic_simd_add_i32x4")
  check_ext_none("__intrinsic_simd_shuffle_i32x4")
  check_ext_none("__intrinsic_simd_bogus_i32x4")
  check_ext_none("plain_function")
  # The kind -> token bridges.
  assert_true(lir_simd_ext_binop_of(LirSimdExtKind::LirSimdExtAndNot) == Option::Some(LirVecBinOp::LirVecAndNot))
  assert_true(lir_simd_ext_binop_of(LirSimdExtKind::LirSimdExtEq) == Option::Some(LirVecBinOp::LirVecEq))
  assert_true(lir_simd_ext_binop_of(LirSimdExtKind::LirSimdExtGe) == Option::Some(LirVecBinOp::LirVecGe))
  assert_true(lir_simd_ext_binop_of(LirSimdExtKind::LirSimdExtSplat) == Option::None)
  assert_true(lir_simd_ext_shift_form_of(LirSimdExtKind::LirSimdExtShlImm) == Option::Some((0, true)))
  assert_true(lir_simd_ext_shift_form_of(LirSimdExtKind::LirSimdExtShrImm) == Option::Some((1, true)))
  assert_true(lir_simd_ext_shift_form_of(LirSimdExtKind::LirSimdExtSar) == Option::Some((2, false)))
  assert_true(lir_simd_ext_shift_form_of(LirSimdExtKind::LirSimdExtExtract) == Option::None)
  # The op names (diagnostics).
  assert_true(lir_simd_ext_op_name(LirSimdExtKind::LirSimdExtAndNot) == "andnot")
  assert_true(lir_simd_ext_op_name(LirSimdExtKind::LirSimdExtUnpackHi) == "unpackhi")
end

# ———————————————————————————————————————————————————————————————
# The pack/unpack lane-pair derivation rows
# ———————————————————————————————————————————————————————————————

@test
def test_pack_unpack_lane_pair_rows() -> Unit
  # The signed narrow targets.
  match lir_vector_lane_narrow(lir_vector_lane_i32x4())
  when Option::Some(l) then assert_true(lir_vector_lane_name(l) == "i16x8")
  when Option::None then panic("i32x4 must narrow to i16x8")
  end
  match lir_vector_lane_narrow(lir_vector_lane_i16x8())
  when Option::Some(l) then assert_true(lir_vector_lane_name(l) == "i8x16")
  when Option::None then panic("i16x8 must narrow to i8x16")
  end
  match lir_vector_lane_narrow(lir_vector_lane_i8x16())
  when Option::None then ()
  when Option::Some(_) then panic("i8x16 has no packed narrow target")
  end
  match lir_vector_lane_narrow(lir_vector_lane_u32x4())
  when Option::None then ()
  when Option::Some(_) then panic("the packed surface is the signed integer lanes only")
  end
  match lir_vector_lane_narrow(lir_vector_lane_f32x4())
  when Option::None then ()
  when Option::Some(_) then panic("the packed surface is the signed integer lanes only")
  end
  # The signed widen targets.
  match lir_vector_lane_widen(lir_vector_lane_i16x8())
  when Option::Some(l) then assert_true(lir_vector_lane_name(l) == "i32x4")
  when Option::None then panic("i16x8 must widen to i32x4")
  end
  match lir_vector_lane_widen(lir_vector_lane_i8x16())
  when Option::Some(l) then assert_true(lir_vector_lane_name(l) == "i16x8")
  when Option::None then panic("i8x16 must widen to i16x8")
  end
  match lir_vector_lane_widen(lir_vector_lane_i32x4())
  when Option::None then ()
  when Option::Some(_) then panic("i32x4 has no packed widen target")
  end
end

# ———————————————————————————————————————————————————————————————
# The aarch64 AdvSIMD extension encoder word rows (asm.tg)
# ———————————————————————————————————————————————————————————————
# Every expected word is the objdump-pinned little-endian instruction
# word for v0/v1/v2 (or the GP pair the row names) — the offline
# assembler rows the asm.tg comments record.

def neon_word(b: CodeBuffer, off: Int) -> u32
  (b.bytes[off] as u32) |
  ((b.bytes[off + 1] as u32) << 8) |
  ((b.bytes[off + 2] as u32) << 16) |
  ((b.bytes[off + 3] as u32) << 24)
end

def neon_word_check(b: CodeBuffer, off: Int, want: u32, what: String) -> Unit
  if neon_word(b, off) != want then
    panic("aarch64 NEON encoder row `" + what + "` mismatches the assembler-pinned word")
  end
end

@test
def test_a64_neon_ext_encoder_rows() -> Unit
  var b = buf_new()
  var off = 0
  a64_neon_bic(b, A64V::V0, A64V::V1, A64V::V2)
  neon_word_check(b, off, 0x4E621C20, "bic v0.16b,v1.16b,v2.16b")
  off = off + 4
  a64_neon_cmeq(b, A64V::V0, A64V::V1, A64V::V2, 32)
  neon_word_check(b, off, 0x6EA28C20, "cmeq v0.4s,v1.4s,v2.4s")
  off = off + 4
  a64_neon_cmeq(b, A64V::V0, A64V::V1, A64V::V2, 64)
  neon_word_check(b, off, 0x6EE28C20, "cmeq v0.2d,v1.2d,v2.2d")
  off = off + 4
  a64_neon_cmgt(b, A64V::V0, A64V::V1, A64V::V2, 32)
  neon_word_check(b, off, 0x4EA23420, "cmgt v0.4s,v1.4s,v2.4s")
  off = off + 4
  a64_neon_cmge(b, A64V::V0, A64V::V1, A64V::V2, 32)
  neon_word_check(b, off, 0x4EA23C20, "cmge v0.4s,v1.4s,v2.4s")
  off = off + 4
  a64_neon_fcmeq(b, A64V::V0, A64V::V1, A64V::V2, 32)
  neon_word_check(b, off, 0x4E22E420, "fcmeq v0.4s,v1.4s,v2.4s")
  off = off + 4
  a64_neon_fcmgt(b, A64V::V0, A64V::V1, A64V::V2, 64)
  neon_word_check(b, off, 0x6EE2E420, "fcmgt v0.2d,v1.2d,v2.2d")
  off = off + 4
  a64_neon_fcmge(b, A64V::V0, A64V::V1, A64V::V2, 32)
  neon_word_check(b, off, 0x6E22E420, "fcmge v0.4s,v1.4s,v2.4s")
  off = off + 4
  a64_neon_sshl(b, A64V::V0, A64V::V1, A64V::V2, 32)
  neon_word_check(b, off, 0x4EA24420, "sshl v0.4s,v1.4s,v2.4s")
  off = off + 4
  a64_neon_ushl(b, A64V::V0, A64V::V1, A64V::V2, 32)
  neon_word_check(b, off, 0x6EA24420, "ushl v0.4s,v1.4s,v2.4s")
  off = off + 4
  # The unsigned-count clamp building blocks: UMIN (8/16/32-bit lanes)
  # and the 64-bit CMHI + BIT pair (no 64-bit UMIN exists).
  a64_neon_umin(b, A64V::V0, A64V::V1, A64V::V2, 32)
  neon_word_check(b, off, 0x6EA26C20, "umin v0.4s,v1.4s,v2.4s")
  off = off + 4
  a64_neon_umin(b, A64V::V0, A64V::V1, A64V::V2, 16)
  neon_word_check(b, off, 0x6E626C20, "umin v0.8h,v1.8h,v2.8h")
  off = off + 4
  a64_neon_umin(b, A64V::V0, A64V::V1, A64V::V2, 8)
  neon_word_check(b, off, 0x6E226C20, "umin v0.16b,v1.16b,v2.16b")
  off = off + 4
  a64_neon_cmhi(b, A64V::V0, A64V::V1, A64V::V2, 64)
  neon_word_check(b, off, 0x6EE23420, "cmhi v0.2d,v1.2d,v2.2d")
  off = off + 4
  a64_neon_bit(b, A64V::V0, A64V::V1, A64V::V2)
  neon_word_check(b, off, 0x6EA21C20, "bit v0.16b,v1.16b,v2.16b")
  off = off + 4
  a64_neon_neg(b, A64V::V0, A64V::V1, 8)
  neon_word_check(b, off, 0x6E20B820, "neg v0.16b,v1.16b")
  off = off + 4
  a64_neon_shl_imm(b, A64V::V0, A64V::V1, 3, 8)
  neon_word_check(b, off, 0x4F0B5420, "shl v0.16b,v1.16b,#3")
  off = off + 4
  a64_neon_sshr_imm(b, A64V::V0, A64V::V1, 3, 16)
  neon_word_check(b, off, 0x4F1D0420, "sshr v0.8h,v1.8h,#3")
  off = off + 4
  a64_neon_ushr_imm(b, A64V::V0, A64V::V1, 3, 64)
  neon_word_check(b, off, 0x6F7D0420, "ushr v0.2d,v1.2d,#3")
  off = off + 4
  a64_neon_dup_b(b, A64V::V0, A64::X1)
  neon_word_check(b, off, 0x4E010C20, "dup v0.16b,w1")
  off = off + 4
  a64_neon_dup_d(b, A64V::V0, A64::X1)
  neon_word_check(b, off, 0x4E080C20, "dup v0.2d,x1")
  off = off + 4
  a64_neon_umov_b(b, A64::X0, A64V::V1, 3)
  neon_word_check(b, off, 0x0E073C20, "umov w0,v1.b[3]")
  off = off + 4
  a64_neon_umov_s(b, A64::X0, A64V::V1, 3)
  neon_word_check(b, off, 0x0E1C3C20, "umov w0,v1.s[3]")
  off = off + 4
  a64_neon_umov_d(b, A64::X0, A64V::V1, 1)
  neon_word_check(b, off, 0x4E183C20, "umov x0,v1.d[1]")
  off = off + 4
  a64_neon_ins_b(b, A64V::V0, A64::X1, 3)
  neon_word_check(b, off, 0x4E071C20, "ins v0.b[3],w1")
  off = off + 4
  a64_neon_ins_d(b, A64V::V0, A64::X1, 1)
  neon_word_check(b, off, 0x4E181C20, "ins v0.d[1],x1")
  off = off + 4
  a64_neon_sqxtn(b, A64V::V0, A64V::V1, 32)
  neon_word_check(b, off, 0x0E614820, "sqxtn v0.4h,v1.4s")
  off = off + 4
  a64_neon_sqxtn2(b, A64V::V0, A64V::V1, 32)
  neon_word_check(b, off, 0x4E614820, "sqxtn2 v0.8h,v1.4s")
  off = off + 4
  a64_neon_sqxtn(b, A64V::V0, A64V::V1, 16)
  neon_word_check(b, off, 0x0E214820, "sqxtn v0.8b,v1.8h")
  off = off + 4
  a64_neon_sshll(b, A64V::V0, A64V::V1, 16)
  neon_word_check(b, off, 0x0F10A420, "sshll v0.4s,v1.4h,#0")
  off = off + 4
  a64_neon_sshll2(b, A64V::V0, A64V::V1, 16)
  neon_word_check(b, off, 0x4F10A420, "sshll2 v0.4s,v1.8h,#0")
  off = off + 4
  a64_neon_sshll(b, A64V::V0, A64V::V1, 8)
  neon_word_check(b, off, 0x0F08A420, "sshll v0.8h,v1.8b,#0")
  off = off + 4
end

# ———————————————————————————————————————————————————————————————
# The marker def/use rows (lir_vec_stmt_occ)
# ———————————————————————————————————————————————————————————————

def check_occ(vop: LirVecOp, want_defs: Vec[Int], want_uses: Vec[Int]) -> Unit
  var defs: Vec[Int] = Vec::new()
  var uses: Vec[Int] = Vec::new()
  lir_vec_stmt_occ(vop, defs, uses)
  assert_true(defs.len() == want_defs.len())
  assert_true(uses.len() == want_uses.len())
  var i = 0
  while i < defs.len() do
    assert_true(defs[i] == want_defs[i])
    i = i + 1
  end
  var j = 0
  while j < uses.len() do
    assert_true(uses[j] == want_uses[j])
    j = j + 1
  end
end

@test
def test_vec_stmt_occ_rows() -> Unit
  let lane = lir_vector_lane_f32x4()
  # binop: uses a, b then defs dst.
  check_occ(
    LirVecOp::LirVecBinop(LirVecBinOp::LirVecAdd, lane, 30, 31, 32),
    Vec::from([30]), Vec::from([31, 32])
  )
  # load: def dst, use ptr.
  check_occ(LirVecOp::LirVecLoad(lane, 30, 31), Vec::from([30]), Vec::from([31]))
  # store: use src, use ptr (no defs).
  check_occ(LirVecOp::LirVecStore(lane, 30, 31), Vec::new(), Vec::from([30, 31]))
  # move (the whole-image slot copy): use src, def dst.
  check_occ(LirVecOp::LirVecMove(lane, 30, 31), Vec::from([30]), Vec::from([31]))
  # shuffle: uses a, mask then defs dst.
  check_occ(LirVecOp::LirVecShuffle(lane, 30, 31, 32), Vec::from([30]), Vec::from([31, 32]))
  # The explicit-extension markers: the def/use rows.
  check_occ(LirVecOp::LirVecShiftImm(lane, 0, 30, 31, 3), Vec::from([30]), Vec::from([31]))
  check_occ(LirVecOp::LirVecShiftVec(lane, 1, 30, 31, 32), Vec::from([30]), Vec::from([31, 32]))
  check_occ(LirVecOp::LirVecSplat(lane, 30, 31), Vec::from([30]), Vec::from([31]))
  check_occ(LirVecOp::LirVecExtract(lane, 30, 31, 2), Vec::from([30]), Vec::from([31]))
  check_occ(LirVecOp::LirVecInsert(lane, 30, 31, 32, 2), Vec::from([30]), Vec::from([31, 32]))
  let i16 = lir_vector_lane_i16x8()
  let i32 = lir_vector_lane_i32x4()
  check_occ(LirVecOp::LirVecPack(i32, i16, 30, 31, 32), Vec::from([30]), Vec::from([31, 32]))
  check_occ(LirVecOp::LirVecUnpack(i16, i32, 1, 30, 31), Vec::from([30]), Vec::from([31]))
end
