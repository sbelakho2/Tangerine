# tests/semantic_persistent_identity_test.tg — persistent identity
# integration (mono declaration identity + P0-4 member lineage).
#
# Two regressions are pinned here:
#
#   (1) MONO PERSISTENT IDENTITY: under the persistent path (the
#       production session pipeline — session_compile_source builds its
#       mono cache through mono_cache_new_persistent from the pre-mono
#       CallableLineageView) a rename/move recorded as an explicit
#       DeclContinuation keeps the declaration's StableDeclId — and
#       therefore the muted StructuralInstanceId — byte-identical across
#       two compiles; the identity layer's ephemeral-vs-persistent
#       StructuralInstanceId behavior and the member continuity rows are
#       driven by snapshot_lineage_lane_check (tg_compiler/semantic_snapshot.tg).
#   (2) TYPED MEMBER LINEAGE: the "ml" render round-trips through the
#       snapshot text (semantic_snapshot_parse_lane_check).
#   (3) PERSISTENT HIR IDENTITY (P1-2): the pre-lowering HIR stamp runs
#       BEFORE MIR lowering, so an unrelated source/HIR node inserted
#       before an existing call statement (renumbering its parse locator)
#       leaves the call's StableSemanticNodeId — derived from the
#       store-backed FromHir provenance — byte-identical across the two
#       compiles on the same lineage store.
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_persistent_identity_test.tg

use std::core::{Option, Result, Unit}
use std::collections::{Vec}
use std::test::*

use tg_compiler::codegen::{detect_host_target}
use tg_compiler::compiler_core::{default_options}
use tg_compiler::mir::{MirProgram, MirTerminatorKind}
use tg_compiler::semantic_model::{SemanticSnapshot}
use tg_compiler::semantic_server::{session_compile_source}
use tg_compiler::semantic_snapshot::{
  snapshot_lineage_lane_check, semantic_snapshot_parse_lane_check
}
use tg_compiler::stable_ids::{
  stable_lineage_store_new, stable_lineage_store_apply_move, DeclMove,
  stable_semantic_node_id_of_origin, stable_semantic_node_key_text
}

# The digest words of the snapshot symbol row whose declared name matches
# (the row identity the stable declaration stamp roots on).
def pid_symbol_digest(snapshot: SemanticSnapshot, name: String) -> (UInt, UInt)
  for s in snapshot.symbols do
    if s.name == name then
      return (s.stable_id.digest_hi, s.stable_id.digest_lo)
    end
  end
  (0, 0)
end

def pid_missing(d: (UInt, UInt)) -> Bool
  d.0 == 0 && d.1 == 0
end

def pid_source_generic(name: String) -> String
  "def " + name + "[T](x: T) -> T\n" +
  "  x\n" +
  "end\n" +
  "\n" +
  "def main() -> Int\n" +
  "  0\n" +
  "end\n"
end

def pid_compile(source: String, file: String) -> SemanticSnapshot
  let session = match session_compile_source(source, file, detect_host_target())
  when Result::Ok(s) then s
  when Result::Err(e) then panic("pid compile failed (" + file + "): " + e)
  end
  session.snapshot
end

@test
def test_lineage_and_parse_lanes() -> Unit
  let lineage_rows = snapshot_lineage_lane_check()
  assert(lineage_rows.len() == 0,
    "snapshot lineage lane mismatches: " + lineage_rows.join("; "))
  let parse_rows = semantic_snapshot_parse_lane_check()
  assert(parse_rows.len() == 0,
    "snapshot parse lane mismatches: " + parse_rows.join("; "))
end

@test
def test_persistent_rename_keeps_declaration_identity() -> Unit
  var store = stable_lineage_store_new()
  # Compile 1: the pre-mono lineage view stamps `generic` (fresh number).
  let snap_a = match session_compile_source(pid_source_generic("generic".to_string()),
    "pid_a.tg".to_string(), detect_host_target(), default_options(), store.clone())
  when Result::Ok(s) then s.snapshot
  when Result::Err(e) then panic("first compile failed: " + e)
  end
  let before = pid_symbol_digest(snap_a, "generic".to_string())
  assert(!pid_missing(before), "the generic declaration row must be present")
  # Record the explicit rename continuation (the edit engine's DeclMove
  # seam) on the SAME store the first compile stamped.
  let moved = stable_lineage_store_apply_move(&mut store, DeclMove {
    package_key: "".to_string(),
    old_module_path: "".to_string(),
    new_module_path: "".to_string(),
    kind: "Function".to_string(),
    old_name: "generic".to_string(),
    new_name: "renamed".to_string(),
    reason: "rename".to_string()
  })
  assert(moved, "the continuation must be recorded from the stamped store")
  # Compile 2: `renamed` claims the recorded lineage BEFORE mono, so the
  # declaration digest — the StructuralInstanceId's callable preimage — is
  # byte-identical.
  let after = match session_compile_source(pid_source_generic("renamed".to_string()),
    "pid_b.tg".to_string(), detect_host_target(), default_options(), store.clone())
  when Result::Ok(s) then pid_symbol_digest(s.snapshot, "renamed".to_string())
  when Result::Err(e) then panic("second compile failed: " + e)
  end
  assert(!pid_missing(after), "the renamed declaration row must be present")
  assert(before == after,
    "an explicit rename continuation must keep the declaration identity across compiles")
end

@test
def test_rename_without_continuation_rekeys_declaration_identity() -> Unit
  # Two FRESH stores (no persisted continuity): the new spelling is a new
  # declaration — the structural / removed+created behavior the
  # ephemeral path documents at the identity layer.
  let snap_a = pid_compile(pid_source_generic("generic".to_string()), "pid_fresh_a.tg".to_string())
  let snap_b = pid_compile(pid_source_generic("renamed".to_string()), "pid_fresh_b.tg".to_string())
  let before = pid_symbol_digest(snap_a, "generic".to_string())
  let after = pid_symbol_digest(snap_b, "renamed".to_string())
  assert(!pid_missing(before) && !pid_missing(after),
    "both declarations must be present")
  assert(before != after,
    "without a continuation the renamed declaration must re-key (removed+created)")
end

# ———————————————————————————————————————————————————————————————
# (P1-2) PERSISTENT HIR IDENTITY ACROSS AN UNRELATED INSERTION
# ———————————————————————————————————————————————————————————————
# The compiled fixture: pid_hir_host contains ONE call statement to
# pid_hir_callee. `insert` adds an unrelated `let` statement BEFORE it —
# the parse/assign_node_ids pass renumbers the call's locator from one
# build to the next. The call terminator's FromHir provenance must carry
# the store-backed HIR identity (stamped BEFORE lowering), so the
# StableSemanticNodeId derived from it is byte-identical across the two
# compiles on the SAME lineage store.
def pid_hir_source(insert: Bool) -> String
  var body = ""
  if insert then
    body = "  let unrelated_marker = 1\n"
  end
  "def pid_hir_callee(x: Int) -> Int\n" +
  "  x\n" +
  "end\n" +
  "\n" +
  "def pid_hir_host(a: Int) -> Int\n" +
  body +
  "  pid_hir_callee(a)\n" +
  "  0\n" +
  "end\n" +
  "\n" +
  "def main() -> Int\n" +
  "  pid_hir_host(1)\n" +
  "end\n"
end

# The canonical semantic-id texts of every CALL terminator's typed
# provenance, sorted — the cross-build invariant surface. Only call
# terminators are compared: the inserted `let` legitimately adds its own
# (new) statement identity, but no EXISTING call node may re-key.
def pid_semantic_call_texts(mir_opt: Option[MirProgram]) -> Vec[String]
  var out: Vec[String] = Vec::new()
  match mir_opt
  when Option::Some(mir) then
    for f in mir.functions do
      for blk in f.blocks do
        match blk.terminator.kind
        when MirTerminatorKind::MirCall { dest, func, args, success, unwind, intrinsic, tail } then
          match blk.terminator.provenance
          when Option::Some(prov) then
            let sid = stable_semantic_node_id_of_origin(
              f.name.clone(), prov, "call".to_string(), "".to_string(), Vec::new())
            out.push(stable_semantic_node_key_text(sid))
          when Option::None then ()
          end
        when _ then ()
        end
      end
    end
  when Option::None then ()
  end
  out.sort()
  out
end

@test
def test_persistent_hir_identity_survives_unrelated_insertion() -> Unit
  var store = stable_lineage_store_new()
  let session_a = match session_compile_source(pid_hir_source(false),
    "pid_hir_a.tg".to_string(), detect_host_target(), default_options(), store.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then panic("HIR insertion lane compile A failed: " + e)
  end
  let ids_a = pid_semantic_call_texts(session_a.final_mir.clone())
  assert(ids_a.len() > 0,
    "the HIR insertion lane fixture must lower at least one call terminator")
  let session_b = match session_compile_source(pid_hir_source(true),
    "pid_hir_b.tg".to_string(), detect_host_target(), default_options(), store.clone())
  when Result::Ok(s) then s
  when Result::Err(e) then panic("HIR insertion lane compile B failed: " + e)
  end
  let ids_b = pid_semantic_call_texts(session_b.final_mir.clone())
  assert(ids_a.len() == ids_b.len() && ids_a.join("\n") == ids_b.join("\n"),
    "an unrelated source/HIR insertion must not re-key any existing call node's StableSemanticNodeId")
end
