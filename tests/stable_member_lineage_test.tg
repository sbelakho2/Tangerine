# tests/stable_member_lineage_test.tg — the persistent member / binder /
# HIR-node lineage suite (fourth-audit P0-4): tg_compiler/stable_ids.tg's
# MemberLineageId / BinderLineageId / HirNodeLineageId, the v2 lineage
# store's member/binder/HIR sections (stamp / bootstrap / conservative
# rebind / explicit continuation / tombstone / save-load round trip) and
# the StableFieldId / StableVariantId / StableBinderId / StableLocalId /
# StableHirNodeId records that carry them.
#
# The contract under test: identity is (owner, member kind, lineage) /
# (owner function, lineage) / (owner declaration, lineage) — the ordinal
# (member index, binder seq, HIR node seq) is a SNAPSHOT LOCATOR only, so
# inserting an unrelated member/local/node before an existing one never
# re-keys the survivor, and a member rename with conservative evidence (or
# an explicit continuation) keeps its id.
#
# Run with the repo root as the working directory:
#   tg test tests/stable_member_lineage_test.tg

use std::core::{Option}
use std::collections::{Vec}
use std::test::assert

use tg_compiler::stable_ids::{
  stable_lineage_store_new, stable_lineage_store_begin_revision,
  stable_lineage_store_finish_revision, stable_lineage_store_save,
  stable_lineage_store_load,
  stable_decl_id_of_lineage_texts_named, stable_key_digest,
  stable_member_scope_key, stable_binder_scope_key, stable_hir_scope_key,
  stable_field_lineage_stamp, stable_variant_lineage_stamp,
  stable_local_lineage_stamp, stable_hir_node_lineage_stamp,
  stable_field_identity_text, stable_variant_identity_text,
  stable_local_identity_text, stable_hir_node_identity_text,
  stable_lineage_store_member_add_continuation,
  stable_lineage_store_member_get,
  instance_key_of_renders,
  StableDeclId, StructuralInstanceId
}

# The owner declarations of the suite: one struct type, one enum type and
# two functions (distinct persistent lineages with distinct names).
def point_owner() -> StableDeclId
  stable_decl_id_of_lineage_texts_named(
    "main".to_string(), "m".to_string(), 1, "type".to_string(), "m::Point".to_string()
  )
end

def option_owner() -> StableDeclId
  stable_decl_id_of_lineage_texts_named(
    "main".to_string(), "m".to_string(), 2, "type".to_string(), "m::Option".to_string()
  )
end

def f_owner() -> StableDeclId
  stable_decl_id_of_lineage_texts_named(
    "main".to_string(), "m".to_string(), 3, "fn".to_string(), "m::f".to_string()
  )
end

def g_owner() -> StableDeclId
  stable_decl_id_of_lineage_texts_named(
    "main".to_string(), "m".to_string(), 4, "fn".to_string(), "m::g".to_string()
  )
end

# The structural instance owner of a function's locals (the local owner is
# per-instance; P0-6's StructuralInstanceId).
def fn_instance(key: String) -> StructuralInstanceId
  instance_key_of_renders(key, Vec::new())
end

def point_field_scope(name: String) -> String
  stable_member_scope_key("main".to_string(), "m::Point".to_string(), "field".to_string(), name)
end

def option_variant_scope(name: String) -> String
  stable_member_scope_key("main".to_string(), "m::Option".to_string(), "variant".to_string(), name)
end

# P0-4 — INSERT A FIELD BEFORE b: b keeps its id (byte-identical identity
# text and digest words), the inserted field gets a fresh number.
@test
def test_p0_4_field_insertion_keeps_id() -> Unit
  mut store = stable_lineage_store_new()
  let sig_int = stable_key_digest("int".to_string())
  let sig_float = stable_key_digest("float".to_string())

  stable_lineage_store_begin_revision(inout store)
  let live1 = Vec::from([point_field_scope("a".to_string()), point_field_scope("b".to_string())])
  let a1 = stable_field_lineage_stamp(inout store, point_owner(), "m::Point".to_string(), 0, "a".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live1.clone())
  let b1 = stable_field_lineage_stamp(inout store, point_owner(), "m::Point".to_string(), 1, "b".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live1.clone())
  stable_lineage_store_finish_revision(inout store)

  # build 2: insert `n` between a and b — every later index shifts.
  stable_lineage_store_begin_revision(inout store)
  let live2 = Vec::from([
    point_field_scope("a".to_string()),
    point_field_scope("n".to_string()),
    point_field_scope("b".to_string())
  ])
  let a2 = stable_field_lineage_stamp(inout store, point_owner(), "m::Point".to_string(), 0, "a".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live2.clone())
  let n2 = stable_field_lineage_stamp(inout store, point_owner(), "m::Point".to_string(), 1, "n".to_string(), sig_float.hi, sig_float.lo, "float".to_string(), live2.clone())
  let b2 = stable_field_lineage_stamp(inout store, point_owner(), "m::Point".to_string(), 2, "b".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live2.clone())
  stable_lineage_store_finish_revision(inout store)

  assert(stable_field_identity_text(&a1) == stable_field_identity_text(&a2), "inserting a field before b must keep a's id")
  assert(stable_field_identity_text(&b1) == stable_field_identity_text(&b2), "inserting a field before b must keep b's id")
  assert(n2.index == 1 && b2.index == 2, "the member index is the snapshot locator (n at 1, b at 2)")
  assert(stable_field_identity_text(&n2) != stable_field_identity_text(&b1), "the inserted field must get a fresh id")
  assert(b1.digest_hi == b2.digest_hi && b1.digest_lo == b2.digest_lo, "b's digest words must stay byte-identical across the insertion")
end

# P0-4 — INSERT A VARIANT BEFORE V, then RENAME a member: insertion keeps
# V/W's ids; a rename with agreeing signature evidence rebinds (the
# conservative rule), never re-keys.
@test
def test_p0_4_variant_insertion_and_rename_keep_ids() -> Unit
  mut store = stable_lineage_store_new()
  let sig_int = stable_key_digest("int".to_string())
  let sig_str = stable_key_digest("str".to_string())

  # build 1: V, W.
  stable_lineage_store_begin_revision(inout store)
  let live1 = Vec::from([option_variant_scope("V".to_string()), option_variant_scope("W".to_string())])
  let v1 = stable_variant_lineage_stamp(inout store, option_owner(), "m::Option".to_string(), 0, "V".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live1.clone())
  let w1 = stable_variant_lineage_stamp(inout store, option_owner(), "m::Option".to_string(), 1, "W".to_string(), sig_str.hi, sig_str.lo, "str".to_string(), live1.clone())
  stable_lineage_store_finish_revision(inout store)

  # build 2: insert U before V.
  stable_lineage_store_begin_revision(inout store)
  let live2 = Vec::from([
    option_variant_scope("U".to_string()),
    option_variant_scope("V".to_string()),
    option_variant_scope("W".to_string())
  ])
  let u2 = stable_variant_lineage_stamp(inout store, option_owner(), "m::Option".to_string(), 0, "U".to_string(), sig_str.hi, sig_str.lo, "str".to_string(), live2.clone())
  let v2 = stable_variant_lineage_stamp(inout store, option_owner(), "m::Option".to_string(), 1, "V".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live2.clone())
  let w2 = stable_variant_lineage_stamp(inout store, option_owner(), "m::Option".to_string(), 2, "W".to_string(), sig_str.hi, sig_str.lo, "str".to_string(), live2.clone())
  stable_lineage_store_finish_revision(inout store)

  assert(stable_variant_identity_text(&v1) == stable_variant_identity_text(&v2), "inserting a variant before V must keep V's id")
  assert(stable_variant_identity_text(&w1) == stable_variant_identity_text(&w2), "inserting a variant before V must keep W's id")
  assert(stable_variant_identity_text(&u2) != stable_variant_identity_text(&v1), "the inserted variant must get a fresh id")

  # build 3: rename V -> Renamed (same declared type "int"); the old
  # location is NOT live, the signature agrees and the match is unique.
  stable_lineage_store_begin_revision(inout store)
  let live3 = Vec::from([
    option_variant_scope("U".to_string()),
    option_variant_scope("Renamed".to_string()),
    option_variant_scope("W".to_string())
  ])
  let u3 = stable_variant_lineage_stamp(inout store, option_owner(), "m::Option".to_string(), 0, "U".to_string(), sig_str.hi, sig_str.lo, "str".to_string(), live3.clone())
  let renamed3 = stable_variant_lineage_stamp(inout store, option_owner(), "m::Option".to_string(), 1, "Renamed".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live3.clone())
  let w3 = stable_variant_lineage_stamp(inout store, option_owner(), "m::Option".to_string(), 2, "W".to_string(), sig_str.hi, sig_str.lo, "str".to_string(), live3.clone())
  stable_lineage_store_finish_revision(inout store)

  assert(stable_variant_identity_text(&renamed3) == stable_variant_identity_text(&v1), "renaming V must keep its persistent id (conservative rebinding)")
  assert(stable_variant_identity_text(&u3) == stable_variant_identity_text(&u2), "U must stay stable through the rename build")
  assert(stable_variant_identity_text(&w3) == stable_variant_identity_text(&w1), "W must stay stable through the rename build")
end

# P0-4 — EXPLICIT CONTINUATION: even without any signature evidence the
# recorded continuation is authoritative and preserves the id.
@test
def test_p0_4_member_explicit_continuation_keeps_id() -> Unit
  mut store = stable_lineage_store_new()
  let sig_int = stable_key_digest("int".to_string())
  let sig_str = stable_key_digest("str".to_string())

  stable_lineage_store_begin_revision(inout store)
  let live1 = Vec::from([point_field_scope("b".to_string())])
  let b1 = stable_field_lineage_stamp(inout store, point_owner(), "m::Point".to_string(), 0, "b".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live1.clone())
  stable_lineage_store_finish_revision(inout store)

  # The explicit continuation: b's lineage now lives at the location `c`.
  match b1.member_lineage.clone()
  when Option::Some(ml) then
    stable_lineage_store_member_add_continuation(
      inout store,
      ml.lineage,
      point_field_scope("b".to_string()),
      point_field_scope("c".to_string()),
      "rename".to_string()
    )
  when Option::None then
    assert(false, "a store-stamped field must carry its member lineage")
  end

  # build 2: c with a DIFFERENT signature (only the continuation can bind
  # it — the heuristic would be ambiguous or would have to refuse).
  stable_lineage_store_begin_revision(inout store)
  let live2 = Vec::from([point_field_scope("c".to_string())])
  let c2 = stable_field_lineage_stamp(inout store, point_owner(), "m::Point".to_string(), 0, "c".to_string(), sig_str.hi, sig_str.lo, "str".to_string(), live2.clone())
  stable_lineage_store_finish_revision(inout store)

  assert(stable_field_identity_text(&c2) == stable_field_identity_text(&b1), "an explicit continuation must preserve the member id across a rename")
  match c2.member_lineage.clone()
  when Option::Some(_) then ()
  when Option::None then
    assert(false, "the continued member must carry its lineage")
  end
end

# P0-4 — INSERT A LOCAL BEFORE x (per-function numbering): x keeps its id;
# the inserted local gets a fresh number; the SAME name/ordinal in another
# function has an independent lineage.
@test
def test_p0_4_local_insertion_per_function() -> Unit
  mut store = stable_lineage_store_new()
  let sig_int = stable_key_digest("int".to_string())
  let f_inst = fn_instance("m::f".to_string())
  let g_inst = fn_instance("m::g".to_string())

  stable_lineage_store_begin_revision(inout store)
  let f_live1 = Vec::from([
    stable_binder_scope_key("m::f".to_string(), "local".to_string(), "x".to_string()),
    stable_binder_scope_key("m::f".to_string(), "local".to_string(), "y".to_string())
  ])
  let f_x1 = stable_local_lineage_stamp(inout store, f_inst.clone(), f_owner(), "m::f".to_string(), "local".to_string(), 0, "x".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), f_live1.clone())
  let f_y1 = stable_local_lineage_stamp(inout store, f_inst.clone(), f_owner(), "m::f".to_string(), "local".to_string(), 1, "y".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), f_live1.clone())
  let g_x1 = stable_local_lineage_stamp(inout store, g_inst.clone(), g_owner(), "m::g".to_string(), "local".to_string(), 0, "x".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), Vec::new())
  stable_lineage_store_finish_revision(inout store)

  # build 2: insert w before x in f; g is untouched.
  stable_lineage_store_begin_revision(inout store)
  let f_live2 = Vec::from([
    stable_binder_scope_key("m::f".to_string(), "local".to_string(), "w".to_string()),
    stable_binder_scope_key("m::f".to_string(), "local".to_string(), "x".to_string()),
    stable_binder_scope_key("m::f".to_string(), "local".to_string(), "y".to_string())
  ])
  let f_w2 = stable_local_lineage_stamp(inout store, f_inst.clone(), f_owner(), "m::f".to_string(), "local".to_string(), 0, "w".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), f_live2.clone())
  let f_x2 = stable_local_lineage_stamp(inout store, f_inst.clone(), f_owner(), "m::f".to_string(), "local".to_string(), 1, "x".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), f_live2.clone())
  let f_y2 = stable_local_lineage_stamp(inout store, f_inst.clone(), f_owner(), "m::f".to_string(), "local".to_string(), 2, "y".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), f_live2.clone())
  let g_x2 = stable_local_lineage_stamp(inout store, g_inst.clone(), g_owner(), "m::g".to_string(), "local".to_string(), 0, "x".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), Vec::new())
  stable_lineage_store_finish_revision(inout store)

  assert(stable_local_identity_text(&f_x1) == stable_local_identity_text(&f_x2), "inserting a local before x must keep x's id (per-function)")
  assert(stable_local_identity_text(&f_y1) == stable_local_identity_text(&f_y2), "inserting a local before x must keep y's id (per-function)")
  assert(stable_local_identity_text(&f_w2) != stable_local_identity_text(&f_x1), "the inserted local must get a fresh id")
  assert(stable_local_identity_text(&g_x1) == stable_local_identity_text(&g_x2), "g's x must stay stable through f's insertion")
  assert(stable_local_identity_text(&f_x2) != stable_local_identity_text(&g_x1), "the same name/ordinal in another function is an independent local")

  # PER-FUNCTION numbering: both functions' first binder is lineage 1, but
  # the lineages are owner-scoped (distinct owner declarations).
  match f_x2.binder.binder_lineage
  when Option::Some(blf) then
    match g_x2.binder.binder_lineage
    when Option::Some(blg) then
      assert(blf.lineage == blg.lineage, "binder numbering is PER-FUNCTION: both first binders are lineage 1")
      assert(blf.owner_function.digest_hi != blg.owner_function.digest_hi || blf.owner_function.digest_lo != blg.owner_function.digest_lo, "the equal numbers are scoped by distinct owner declarations")
    when Option::None then
      assert(false, "g's x must carry its binder lineage")
    end
  when Option::None then
    assert(false, "f's x must carry its binder lineage")
  end
end

# P0-4 — INSERT AN HIR NODE BEFORE an existing expression: the survivor
# keeps its lineage; the inserted node gets a fresh one. A second owner
# with its own per-owner numbering stays independent and stable.
@test
def test_p0_4_hir_node_insertion_keeps_id() -> Unit
  mut store = stable_lineage_store_new()
  let sig_a = stable_key_digest("exprA".to_string())
  let sig_b = stable_key_digest("exprB".to_string())
  let sig_new = stable_key_digest("exprNew".to_string())
  let owner = f_owner()
  let other_owner = g_owner()
  let live1 = Vec::from([
    stable_hir_scope_key("m::f".to_string(), "exprA".to_string()),
    stable_hir_scope_key("m::f".to_string(), "exprB".to_string()),
    stable_hir_scope_key("m::g".to_string(), "exprA".to_string())
  ])
  let live2 = Vec::from([
    stable_hir_scope_key("m::f".to_string(), "exprNew".to_string()),
    stable_hir_scope_key("m::f".to_string(), "exprA".to_string()),
    stable_hir_scope_key("m::f".to_string(), "exprB".to_string()),
    stable_hir_scope_key("m::g".to_string(), "exprA".to_string())
  ])

  stable_lineage_store_begin_revision(inout store)
  let a1 = stable_hir_node_lineage_stamp(inout store, owner.clone(), "m::f".to_string(), 0, "exprA".to_string(), sig_a.hi, sig_a.lo, "exprA".to_string(), live1.clone())
  let b1 = stable_hir_node_lineage_stamp(inout store, owner.clone(), "m::f".to_string(), 1, "exprB".to_string(), sig_b.hi, sig_b.lo, "exprB".to_string(), live1.clone())
  let g_a1 = stable_hir_node_lineage_stamp(inout store, other_owner.clone(), "m::g".to_string(), 0, "exprA".to_string(), sig_a.hi, sig_a.lo, "exprA".to_string(), live1.clone())
  stable_lineage_store_finish_revision(inout store)

  # build 2: an unrelated node inserted before exprA in f; g untouched.
  stable_lineage_store_begin_revision(inout store)
  let n2 = stable_hir_node_lineage_stamp(inout store, owner.clone(), "m::f".to_string(), 0, "exprNew".to_string(), sig_new.hi, sig_new.lo, "exprNew".to_string(), live2.clone())
  let a2 = stable_hir_node_lineage_stamp(inout store, owner.clone(), "m::f".to_string(), 1, "exprA".to_string(), sig_a.hi, sig_a.lo, "exprA".to_string(), live2.clone())
  let b2 = stable_hir_node_lineage_stamp(inout store, owner.clone(), "m::f".to_string(), 2, "exprB".to_string(), sig_b.hi, sig_b.lo, "exprB".to_string(), live2.clone())
  let g_a2 = stable_hir_node_lineage_stamp(inout store, other_owner.clone(), "m::g".to_string(), 0, "exprA".to_string(), sig_a.hi, sig_a.lo, "exprA".to_string(), live2.clone())
  stable_lineage_store_finish_revision(inout store)

  assert(stable_hir_node_identity_text(&a1) == stable_hir_node_identity_text(&a2), "inserting an HIR node before exprA must keep exprA's id")
  assert(stable_hir_node_identity_text(&b1) == stable_hir_node_identity_text(&b2), "inserting an HIR node before exprA must keep exprB's id")
  assert(n2.node_seq == 0 && a2.node_seq == 1, "the HIR node seq is the snapshot locator")
  assert(stable_hir_node_identity_text(&n2) != stable_hir_node_identity_text(&a1), "the inserted HIR node must get a fresh id")
  assert(stable_hir_node_identity_text(&g_a1) == stable_hir_node_identity_text(&g_a2), "g's exprA must stay stable through f's insertion")
  assert(stable_hir_node_identity_text(&g_a2) != stable_hir_node_identity_text(&a2), "the same anchor in another owner is an independent node")
end

# P0-4 — STORE PERSISTENCE: the v2 text with all four sections non-empty
# round-trips byte-identically, and the loaded store still binds the
# structural keys.
@test
def test_p0_4_store_round_trip() -> Unit
  mut store = stable_lineage_store_new()
  let sig_int = stable_key_digest("int".to_string())
  let owner = point_owner()
  let f = f_owner()
  let f_inst = fn_instance("m::f".to_string())

  stable_lineage_store_begin_revision(inout store)
  let live = Vec::from([
    point_field_scope("a".to_string()),
    stable_binder_scope_key("m::f".to_string(), "local".to_string(), "x".to_string()),
    stable_hir_scope_key("m::f".to_string(), "exprA".to_string())
  ])
  let field_a = stable_field_lineage_stamp(inout store, owner.clone(), "m::Point".to_string(), 0, "a".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live.clone())
  let local_x = stable_local_lineage_stamp(inout store, f_inst.clone(), f.clone(), "m::f".to_string(), "local".to_string(), 0, "x".to_string(), sig_int.hi, sig_int.lo, "int".to_string(), live.clone())
  let hir_a = stable_hir_node_lineage_stamp(inout store, f.clone(), "m::f".to_string(), 0, "exprA".to_string(), sig_int.hi, sig_int.lo, "exprA".to_string(), live.clone())
  stable_lineage_store_finish_revision(inout store)

  let text = stable_lineage_store_save(store.clone())
  assert(text.starts_with("tg-lineage-store v2|"), "the saved store keeps the v2 header")
  assert(text.contains("m|main|m::Point"), "the member section must serialize the member row")
  assert(text.contains("b|m::f"), "the binder section must serialize the binder row")
  assert(text.contains("h|m::f|"), "the HIR section must serialize the HIR row")

  let loaded = stable_lineage_store_load(text.clone())
  let reloaded = stable_lineage_store_save(loaded.clone())
  assert(reloaded == text, "the v2 store text (with member/binder/HIR sections) must round-trip byte-identically")

  # The loaded store still binds the member structural key (owner digest
  # words + kind + name), and the row kept its persistent lineage number.
  let owner_for_lookup = point_owner()
  match stable_lineage_store_member_get(loaded, owner_for_lookup.digest_hi, owner_for_lookup.digest_lo, "field".to_string(), "a".to_string())
  when Option::Some(entry) then
    match field_a.member_lineage
    when Option::Some(ml) then
      assert(entry.lineage == ml.lineage, "the loaded member row must keep the lineage number")
    when Option::None then
      assert(false, "the stamped field must carry its member lineage")
    end
  when Option::None then
    assert(false, "the loaded store must bind the member structural key")
  end
  let _ = local_x
  let _ = hir_a
end
