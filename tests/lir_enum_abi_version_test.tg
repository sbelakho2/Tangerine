# tests/lir_enum_abi_version_test.tg — third-audit item 42: the VERSIONED
# LIR-internal enum ABI (`inline-image-v1`) and its boundary rules.
#
# The LIR route crosses a payloaded tagged-enum under its own by-reference
# inline-image convention (the direct pipeline crosses the canonical
# TaggedPtr value word). This suite pins the version model and the
# machinery that prevents it from silently diverging from the canonical
# representation:
#   - the version accessor / word / parser rows;
#   - the four explicit boundary rules;
#   - the per-function marker attachment (a hand-built MIR function with a
#     payloaded-enum parameter lowers to a LirFunction carrying
#     Some(InlineImageV1) + the evidence bit, and verify_lir passes);
#   - the fail-closed arms: an unversioned crossing, a version without a
#     crossing, and a foreign/unknown object version word;
#   - the export rule: a crossing function's binding is Local (never a
#     public ABI export), a non-crossing function stays Global, and a
#     required export (the OS entry) fails closed.
#
# Run with: tg test tests/lir_enum_abi_version_test.tg

use std::core::{Option, Result, panic}
use std::collections::{Vec, Map, Set}
use std::test::*
use tg_compiler::asm::SymBinding
use tg_compiler::ast::layout_attrs_plain
use tg_compiler::ids::TypeId
use tg_compiler::mir::{
  MirFunction, MirLocal, MirLocalId, MirBlock, MirBlockId, MirTerminator,
  MirTerminatorKind, MirTypeDef, MirTypeDefKind, MirVariantDef
}
use tg_compiler::token::span_dummy
use tg_compiler::types::Type
use tg_compiler::lir::{
  LirFunction, LirVerifyRoute,
  lir_enum_abi_version, lir_enum_abi_version_word, lir_enum_abi_version_of_word,
  lir_enum_abi_rule_lir_call, lir_enum_abi_rule_extern, lir_enum_abi_rule_export,
  lir_enum_abi_rule_objects, lir_enum_abi_boundary_rules, lir_enum_abi_note_label,
  lir_fn_has_payloaded_enum_crossing, lir_fn_enum_abi_marker,
  lir_check_enum_abi_program, lir_check_enum_abi_word,
  lir_fn_export_binding, lir_check_fn_enum_abi_export,
  lower_mir_fn_to_lir_prog, lir_peephole, lir_alloc_registers_a64,
  verify_lir
}

# ———————————————————————————————————————————————————————————————
# The hand-built MIR inputs
# ———————————————————————————————————————————————————————————————

# A PAYLOADED tagged enum: E { A, B(Int) } — tag word + one payload word
# = a 16-byte inline image (the admitted payloaded shape behind the
# inline-image crossing).
def enum_abi_payloaded_def() -> MirTypeDef
  MirTypeDef {
    id: TypeId { id: 200 },
    name: "E".to_string(),
    kind: MirTypeDefKind::Enum(Vec::from([
      MirVariantDef { name: "A".to_string(), discriminant: 0, fields: Vec::new() },
      MirVariantDef { name: "B".to_string(), discriminant: 1, fields: Vec::from([Type::Int]) }
    ])),
    generic_params: Vec::new(),
    layout: layout_attrs_plain(span_dummy())
  }
end

# A PAYLOAD-LESS tagged enum: only the 8-byte tag image — the value-word
# crossing both routes already agree on (it must NOT carry the marker).
def enum_abi_payloadless_def() -> MirTypeDef
  MirTypeDef {
    id: TypeId { id: 201 },
    name: "P".to_string(),
    kind: MirTypeDefKind::Enum(Vec::from([
      MirVariantDef { name: "Only".to_string(), discriminant: 0, fields: Vec::new() }
    ])),
    generic_params: Vec::new(),
    layout: layout_attrs_plain(span_dummy())
  }
end

def enum_abi_type_defs() -> Map[Int, MirTypeDef]
  var defs: Map[Int, MirTypeDef] = Map::new()
  defs.insert(200, enum_abi_payloaded_def())
  defs.insert(201, enum_abi_payloadless_def())
  defs
end

# A one-parameter Unit function: locals[0] is the return place (the MIR
# convention) and the parameter is local 1; a single entry block returns.
def enum_abi_param_fn(name: String, param_ty: Type) -> MirFunction
  let ret_local = MirLocal {
    id: MirLocalId { id: 0 },
    name: "_ret".to_string(),
    ty: Type::Unit,
    is_mut: true,
    span: span_dummy()
  }
  let param = MirLocal {
    id: MirLocalId { id: 1 },
    name: "v".to_string(),
    ty: param_ty,
    is_mut: false,
    span: span_dummy()
  }
  let block0 = MirBlock {
    id: MirBlockId { id: 0 },
    statements: Vec::new(),
    terminator: MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() }
  }
  MirFunction {
    name: name,
    params: Vec::from([param.clone()]),
    ret_type: Type::Unit,
    locals: Vec::from([ret_local, param]),
    blocks: Vec::from([block0]),
    entry_block: MirBlockId { id: 0 },
    is_async: false,
    is_unsafe: false,
    is_extern: false,
    extern_abi: "".to_string(),
    contracts: Vec::new(),
    span: span_dummy()
  }
end

def enum_abi_lower(f: MirFunction, type_defs: Map[Int, MirTypeDef]) -> LirFunction
  match lower_mir_fn_to_lir_prog(f, type_defs, Map::new(), Map::new(), Set::new(), Map::new())
  when Result::Err(e) then panic("enum-ABI test lowering failed: " + e)
  when Result::Ok(lf) then lf
  end
end

def enum_abi_violation_hit(violations: Vec[String], needle: String) -> Bool
  var hit = false
  for v in violations do
    if v.contains(needle) then
      hit = true
    end
  end
  hit
end

def enum_abi_first_violation(violations: Vec[String]) -> String
  if violations.len() > 0 then violations[0] else "" end
end

# ———————————————————————————————————————————————————————————————
# 1. the version accessor / word / parser rows
# ———————————————————————————————————————————————————————————————

@test
def test_enum_abi_version_rows() -> Unit
  let v = lir_enum_abi_version()
  assert(lir_enum_abi_version_word(v) == "inline-image-v1", "the current version must render inline-image-v1")
  match lir_enum_abi_version_of_word("inline-image-v1")
  when Option::Some(parsed) then
    assert(lir_enum_abi_version_word(parsed) == lir_enum_abi_version_word(v), "the inline-image-v1 word must parse to the current version")
  when Option::None then
    panic("the inline-image-v1 word must parse to a version")
  end
  match lir_enum_abi_version_of_word("inline-image-v0")
  when Option::Some(_) then panic("an unknown version word must not parse")
  when Option::None then ()
  end
  match lir_enum_abi_version_of_word("")
  when Option::Some(_) then panic("the empty version word must not parse")
  when Option::None then ()
  end
  assert(lir_enum_abi_note_label() == "tg.abi.enumver", "the object note label must be tg.abi.enumver")
end

# ———————————————————————————————————————————————————————————————
# 2. the four explicit boundary rules
# ———————————————————————————————————————————————————————————————

@test
def test_enum_abi_boundary_rule_rows() -> Unit
  let call_rule = lir_enum_abi_rule_lir_call()
  assert(call_rule.contains("inline-image-v1"), "rule (a) must name the version")
  assert(call_rule.contains("no conversion"), "rule (a) must state no conversion")

  let extern_rule = lir_enum_abi_rule_extern()
  assert(extern_rule.contains("inline-image-v1"), "rule (b) must name the version")
  assert(extern_rule.contains("TaggedPtr"), "rule (b) must name the canonical representation")
  assert(extern_rule.contains("fail"), "rule (b) must fail closed")

  let export_rule = lir_enum_abi_rule_export()
  assert(export_rule.contains("inline-image-v1"), "rule (c) must name the version")
  assert(export_rule.contains("LOCAL"), "rule (c) must state the local export binding")

  let objects_rule = lir_enum_abi_rule_objects()
  assert(objects_rule.contains("tg.abi.enumver"), "rule (d) must name the object note symbol")
  assert(objects_rule.contains("inline-image-v1"), "rule (d) must name the version word")

  let rules = lir_enum_abi_boundary_rules()
  assert(rules.len() == 4, "there are exactly four boundary rules in v1")
end

# ———————————————————————————————————————————————————————————————
# 3. the marker attachment: a hand-built payloaded-enum function lowers
#    with the version marker and passes the verifier
# ———————————————————————————————————————————————————————————————

@test
def test_enum_abi_marker_attachment_rows() -> Unit
  let type_defs = enum_abi_type_defs()
  let payloaded_ty = Type::Adt(TypeId { id: 200 }, Vec::new())

  # The declared-signature scan: payloaded -> marker, payload-less and
  # scalars -> no marker.
  let crosser_f = enum_abi_param_fn("crosser", payloaded_ty.clone())
  assert(lir_fn_has_payloaded_enum_crossing(type_defs, crosser_f), "a payloaded-enum parameter must be a crossing")
  match lir_fn_enum_abi_marker(type_defs, crosser_f)
  when Option::Some(mv) then
    assert(lir_enum_abi_version_word(mv) == "inline-image-v1", "the marker must name the current version")
  when Option::None then
    panic("a payloaded-enum parameter must carry the version marker")
  end

  let plain_f = enum_abi_param_fn("plain", Type::Adt(TypeId { id: 201 }, Vec::new()))
  assert(!lir_fn_has_payloaded_enum_crossing(type_defs, plain_f), "a payload-less enum is not a payloaded crossing")
  match lir_fn_enum_abi_marker(type_defs, plain_f)
  when Option::Some(_) then panic("a payload-less enum must not carry the marker")
  when Option::None then ()
  end

  let int_f = enum_abi_param_fn("scalar", Type::Int)
  match lir_fn_enum_abi_marker(type_defs, int_f)
  when Option::Some(_) then panic("a scalar parameter must not carry the marker")
  when Option::None then ()
  end

  # The lowering attaches the marker + the evidence bit.
  let lf = enum_abi_lower(crosser_f, type_defs)
  assert(lf.enum_abi_crossing, "the lowered crossing function must set the evidence bit")
  match lf.enum_abi_version
  when Option::Some(lv) then
    assert(lir_enum_abi_version_word(lv) == "inline-image-v1", "the lowered marker must name the current version")
  when Option::None then
    panic("the lowered crossing function must carry the version marker")
  end

  # The program-wide uniformity check accepts the matching marker.
  match lir_check_enum_abi_program(lf, lir_enum_abi_version())
  when Result::Err(e) then panic("a matching marker must pass the uniformity check: " + e)
  when Result::Ok(_) then ()
  end

  # The peephole preserves the marker, and the verifier passes the
  # versioned crossing through the real allocation pipeline.
  let peeped = lir_peephole(lf)
  assert(peeped.enum_abi_crossing, "the peephole must preserve the evidence bit")
  match peeped.enum_abi_version
  when Option::Some(_) then ()
  when Option::None then panic("the peephole must preserve the version marker")
  end
  let alloc = lir_alloc_registers_a64(peeped)
  let violations = verify_lir(peeped, alloc, LirVerifyRoute::LirVerifyA64)
  assert(violations.len() == 0, "a versioned crossing must verify clean; first violation: " + enum_abi_first_violation(violations))
end

# ———————————————————————————————————————————————————————————————
# 4. no unversioned crossing: a crossing without a marker fails closed
# ———————————————————————————————————————————————————————————————

@test
def test_enum_abi_unversioned_crossing_fails_closed() -> Unit
  let type_defs = enum_abi_type_defs()
  var lf = enum_abi_lower(enum_abi_param_fn("unversioned", Type::Adt(TypeId { id: 200 }, Vec::new())), type_defs)
  # Hand-strip the marker: the crossing remains, the version is gone —
  # exactly the unversioned state the item forbids.
  lf.enum_abi_version = Option::None
  let alloc = lir_alloc_registers_a64(lf)
  let violations = verify_lir(lf, alloc, LirVerifyRoute::LirVerifyA64)
  assert(enum_abi_violation_hit(violations, "NO enum ABI version"), "the verifier must reject an unversioned crossing; first violation: " + enum_abi_first_violation(violations))

  match lir_check_enum_abi_program(lf, lir_enum_abi_version())
  when Result::Err(e) then
    assert(e.contains("NO enum ABI version"), "the program check must name the unversioned crossing")
  when Result::Ok(_) then
    panic("an unversioned crossing must fail the program check")
  end
end

# ———————————————————————————————————————————————————————————————
# 5. mismatches fail closed: a version without a crossing, and a
#    foreign/unknown object version word
# ———————————————————————————————————————————————————————————————

@test
def test_enum_abi_version_mismatch_fails_closed() -> Unit
  # (i) a versioned marker without a crossing (a stale/foreign marker).
  let type_defs = enum_abi_type_defs()
  var lf = enum_abi_lower(enum_abi_param_fn("stale", Type::Int), type_defs)
  lf.enum_abi_version = Option::Some(lir_enum_abi_version())
  let alloc = lir_alloc_registers_a64(lf)
  let violations = verify_lir(lf, alloc, LirVerifyRoute::LirVerifyA64)
  assert(enum_abi_violation_hit(violations, "no payloaded-enum crossing"), "the verifier must reject a version without a crossing; first violation: " + enum_abi_first_violation(violations))

  # (ii) the object-metadata boundary: a foreign/unknown word is refused
  # (never guessed), a matching word passes.
  match lir_check_enum_abi_word("inline-image-v0", lir_enum_abi_version())
  when Result::Err(e) then
    assert(e.contains("inline-image-v0"), "the refusal must name the foreign word")
  when Result::Ok(_) then
    panic("an unknown object version word must fail closed")
  end
  match lir_check_enum_abi_word("inline-image-v1", lir_enum_abi_version())
  when Result::Err(e) then panic("the current object version word must pass: " + e)
  when Result::Ok(_) then ()
  end
  match lir_check_enum_abi_word("", lir_enum_abi_version())
  when Result::Err(_) then ()
  when Result::Ok(_) then panic("the empty object version word must fail closed")
  end
end

# ———————————————————————————————————————————————————————————————
# 6. the export rule: crossing functions are never public ABI symbols
# ———————————————————————————————————————————————————————————————

@test
def test_enum_abi_export_refusal_rows() -> Unit
  let type_defs = enum_abi_type_defs()
  let payloaded_ty = Type::Adt(TypeId { id: 200 }, Vec::new())
  let crosser = enum_abi_lower(enum_abi_param_fn("internal_crosser", payloaded_ty.clone()), type_defs)
  let scalar = enum_abi_lower(enum_abi_param_fn("public_scalar", Type::Int), type_defs)

  # The writer binding: a crossing function is INTERNAL (Local), a
  # non-crossing function keeps the public Global binding.
  assert(lir_fn_export_binding(crosser) == SymBinding::Local, "a payloaded-enum crossing function must be emitted Local")
  assert(lir_fn_export_binding(scalar) == SymBinding::Global, "a non-crossing function must stay Global")

  # A crossing function that is not the OS entry passes the required-
  # export gate (it is simply emitted Local).
  match lir_check_fn_enum_abi_export(crosser)
  when Result::Err(e) then panic("a non-entry crossing function must pass the export gate: " + e)
  when Result::Ok(_) then ()
  end

  # A REQUIRED export (the OS entry name) fails closed.
  let entry = enum_abi_lower(enum_abi_param_fn("_start", payloaded_ty), type_defs)
  match lir_check_fn_enum_abi_export(entry)
  when Result::Err(e) then
    assert(e.contains("REQUIRED export") && e.contains("inline-image-v1"), "the refusal must name the required export and the version")
  when Result::Ok(_) then
    panic("a payloaded-enum OS entry must fail closed")
  end
end
