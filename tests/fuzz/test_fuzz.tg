# tests/fuzz/test_fuzz.tg — Fuzz/property tests §21.5
use std::test
use std::image
use std::text
use std::geom

# --- Fuzz image decoder with malformed input ---

test "Fuzz: decode_png with empty bytes" do
  let result = image::decode_png([], DecodeOpts {})
  match result
  when Err(e)
    assert(true)  # Should fail gracefully
  when Ok(_)
    assert(false)  # Should not succeed with empty input
  end
end

test "Fuzz: decode_png with random bytes" do
  let garbage: Vec[u8] = [0xDE, 0xAD, 0xBE, 0xEF, 0x00, 0xFF, 0x42, 0x13]
  let result = image::decode_png(garbage, DecodeOpts {})
  match result
  when Err(_)
    assert(true)  # Graceful failure
  when Ok(_)
    assert(false)
  end
end

test "Fuzz: decode_png with truncated PNG signature" do
  # Valid PNG starts with 0x89504E47 but we truncate
  let partial: Vec[u8] = [0x89, 0x50, 0x4E]
  let result = image::decode_png(partial, DecodeOpts {})
  match result
  when Err(_)
    assert(true)
  when Ok(_)
    assert(false)
  end
end

test "Fuzz: decode_png with corrupt IHDR" do
  # Valid PNG signature + invalid IHDR
  let data: Vec[u8] = [
    0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A,  # PNG signature
    0x00, 0x00, 0x00, 0x0D,  # IHDR length
    0x49, 0x48, 0x44, 0x52,  # "IHDR"
    0xFF, 0xFF, 0xFF, 0xFF,  # width = huge
    0xFF, 0xFF, 0xFF, 0xFF,  # height = huge
    0x08, 0x06, 0x00, 0x00, 0x00,  # bit depth, color type, etc
    0x00, 0x00, 0x00, 0x00   # CRC (invalid but shouldn't crash)
  ]
  let result = image::decode_png(data, DecodeOpts {})
  match result
  when Err(_)
    assert(true)  # Should fail, not crash
  when Ok(_)
    # If it "succeeds" with such huge dimensions, that's also acceptable
    # as long as there's no crash/OOM
    assert(true)
  end
end

# --- Fuzz text shaping with invalid input ---

test "Fuzz: shape with very long string" do
  let db = text::font_db_new()
  let long_str = ""
  let i = 0
  while i < 10000
    long_str = long_str + "a"
    i = i + 1
  end
  let opts = ShapingOpts {
    font: FontId { id: 0 },
    size: 16.0,
    direction: Direction::LTR,
    script: "Latn"
  }
  let run = text::shape(long_str, opts)
  assert_eq(run.glyphs.len(), 10000)
end

test "Fuzz: shape with unicode sequences" do
  let db = text::font_db_new()
  let opts = ShapingOpts {
    font: FontId { id: 0 },
    size: 16.0,
    direction: Direction::LTR,
    script: "Latn"
  }
  # Combining marks, emoji sequences
  let inputs = [
    "é",           # precomposed
    "e\u{0301}",   # decomposed combining acute
    "\u{1F600}",   # emoji grinning face
    "\u{200B}",    # zero width space
    "\u{FEFF}",    # BOM
    ""              # empty
  ]
  for input in inputs
    let run = text::shape(input, opts)
    # Should not crash regardless of input
    assert(true)
  end
end

# --- Fuzz event dispatch ---

test "Fuzz: rapid event sequence" do
  use std::ui_toolkit

  let theme = Theme {
    bg: Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 },
    fg: Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    accent: Color { r: 0.2, g: 0.5, b: 1.0, a: 1.0 },
    font_size: 14.0,
    rounding: 4.0,
    spacing: 8.0
  }

  let btn = Button { label: "Test", on_click: fn() {} }
  let ctx = EventCtx { redraw_requested: false, focus_id: None }

  # Rapid press/release/move sequence
  let events = [
    UiEvent::PointerDown(50.0, 50.0),
    UiEvent::PointerMove(51.0, 51.0),
    UiEvent::PointerUp(51.0, 51.0),
    UiEvent::PointerDown(50.0, 50.0),
    UiEvent::PointerUp(50.0, 50.0),
    UiEvent::KeyPress(Key::A),
    UiEvent::TextInput("a")
  ]
  for evt in events
    btn.event(evt, ctx, theme)
  end
  assert(true)  # No crash = pass
end

# --- Property tests for geometry ---

test "Property: rect intersection is commutative" do
  let a = Rect { x: 0.0, y: 0.0, w: 100.0, h: 100.0 }
  let b = Rect { x: 50.0, y: 50.0, w: 100.0, h: 100.0 }

  let i_ab = geom::rect_intersect(a, b)
  let i_ba = geom::rect_intersect(b, a)

  assert_eq(i_ab.x, i_ba.x)
  assert_eq(i_ab.y, i_ba.y)
  assert_eq(i_ab.w, i_ba.w)
  assert_eq(i_ab.h, i_ba.h)
end

test "Property: rect union contains both rects" do
  let a = Rect { x: 0.0, y: 0.0, w: 50.0, h: 50.0 }
  let b = Rect { x: 30.0, y: 30.0, w: 50.0, h: 50.0 }
  let u = geom::rect_union(a, b)
  # Union should contain point (0,0) and point (79,79)
  assert(u.x <= 0.0)
  assert(u.y <= 0.0)
  assert(u.x + u.w >= 80.0)
  assert(u.y + u.h >= 80.0)
end
