# tests/lint_suite_test.tg — the lint suite: the positive / negative /
# boundary fixtures for the advertised lints, the suppression, and the
# config level overrides.
#
# Every advertised lint (tg lint --list) is exercised:
#   unused_variables  — the positive fixture declares-but-never-uses a
#                       local (the typed path: the diagnostic fires);
#   redundant_return  — the positive fixture `return`s at the end of the
#                       body;
#   large_function    — the BOUNDARY fixture: the exact max_lines count
#                       is clean, max_lines + 1 fires;
#   the clean NEGATIVE fixture: zero diagnostics from every pass.
# The suppression contract: the #[allow(lint_name)] item attribute and
# the config's allowed list both silence the lint; the config's denied
# list escalates it to Error.
#
# The CLI layer (the exit codes 0/1/2, the --json output, the --list
# catalog) is pinned by tests/run_lint_tests.sh.
#
# Run with: tg run tests/lint_suite_test.tg

use std::test::*
use std::core::{Option, Result, String, Unit, Bool, Int, UInt}

use tg_compiler::linter::{lint_source, default_lint_config, LintConfig, LintLevel}

def _default_config() -> LintConfig
  default_lint_config()
end

def _lint_names(source: String) -> Vec[String]
  let diags = match lint_source("fixture.tg", source, _default_config())
  when Result::Ok(d) then d
  when Result::Err(e) then
    assert_false(true)
    Vec::new()
  end
  var names = Vec::new()
  for d in diags do
    names.push(d.lint_name.clone())
  end
  names
end

def _contains(names: Vec[String], needle: String) -> Bool
  for n in names do
    if n == needle then
      return true
    end
  end
  false
end

# ─── the negative fixture: a clean file passes every pass ────────────

@test
def test_clean_source_produces_no_diagnostics() -> Unit
  let clean = "def clean_fn(x: Int) -> Int\n" +
    "  x + 1\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  clean_fn(1)\n" +
    "end\n"
  let diags = assert_ok(lint_source("clean.tg", clean, _default_config()))
  assert_true(diags.len() == 0)
end

# ─── the positive fixtures ───────────────────────────────────────────

@test
def test_unused_variables_lint_fires_on_unused_local() -> Unit
  let src = "def compute() -> Int\n" +
    "  let unused_var = 1\n" +
    "  0\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  compute()\n" +
    "end\n"
  let names = _lint_names(src)
  assert(_contains(&names, "unused_variables"), "unused_variables must fire")
  let diags = assert_ok(lint_source("fixture.tg", src, _default_config()))
  var found = false
  for d in diags do
    if d.lint_name == "unused_variables" then
      found = true
      assert_true(d.line >= 1)
      assert_true(d.column >= 1)
      match d.level
      when LintLevel::Warning then ()
      when _ then assert_false(true)
      end
    end
  end
  assert_true(found)
end

@test
def test_redundant_return_lint_fires_on_trailing_return() -> Unit
  let src = "def compute(x: Int) -> Int\n" +
    "  return x\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  compute(1)\n" +
    "end\n"
  let names = _lint_names(src)
  assert(_contains(&names, "redundant_return"), "redundant_return must fire")
end

@test
def test_unused_imports_lint_fires_on_unused_import() -> Unit
  let src = "use std::core::{Option}\n" +
    "\n" +
    "def main() -> Int\n" +
    "  0\n" +
    "end\n"
  let names = _lint_names(src)
  assert(_contains(&names, "unused_imports"), "unused_imports must fire")
end

@test
def test_naming_conventions_lint_fires_on_pascal_case_function() -> Unit
  let src = "def BadName() -> Int\n" +
    "  0\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  BadName()\n" +
    "end\n"
  let names = _lint_names(src)
  assert(_contains(&names, "naming_conventions"), "naming_conventions must fire")
end

# ─── the remaining advertised passes ────────────────────────────────

@test
def test_dead_code_lint_fires_on_unreferenced_private_function() -> Unit
  let src = "def helper() -> Int\n" +
    "  0\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  0\n" +
    "end\n"
  let names = _lint_names(src)
  assert(_contains(&names, "dead_code"), "dead_code must fire on the unreferenced helper")
end

@test
def test_dead_code_negative_referenced_private_function_is_clean() -> Unit
  # The SEMANTIC path: the private function IS called — the typed
  # reachability (the resolver's DefId reference tables) clears it; the
  # dead_code lint must NOT fire.
  let src = "def helper() -> Int\n" +
    "  7\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  helper()\n" +
    "end\n"
  let names = _lint_names(src)
  assert(!_contains(&names, "dead_code"), "dead_code must not fire on a referenced function")
end

@test
def test_needless_mut_lint_fires_on_unmutated_var() -> Unit
  let src = "def compute() -> Int\n" +
    "  var counter = 1\n" +
    "  counter\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  compute()\n" +
    "end\n"
  let names = _lint_names(src)
  assert(_contains(&names, "needless_mut"), "needless_mut must fire on the never-mutated var")
end

@test
def test_needless_mut_negative_assigned_var_is_clean() -> Unit
  # The assignment STATEMENT form (`counter = counter + 1`) IS a
  # mutation — the pass's statement walk records it and the lint must
  # NOT fire.
  let src = "def compute() -> Int\n" +
    "  var counter = 1\n" +
    "  counter = counter + 1\n" +
    "  counter\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  compute()\n" +
    "end\n"
  let names = _lint_names(src)
  assert(!_contains(&names, "needless_mut"), "needless_mut must not fire on the assigned var")
end

@test
def test_unsafe_usage_lint_fires_on_unsafe_block() -> Unit
  let src = "def compute() -> Int\n" +
    "  unsafe \"probe\" do\n" +
    "    0\n" +
    "  end\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  compute()\n" +
    "end\n"
  let names = _lint_names(src)
  assert(_contains(&names, "unsafe_usage"), "unsafe_usage must fire on the unsafe block")
end

@test
def test_empty_block_lint_fires_on_empty_then_block() -> Unit
  let src = "def compute(given: Bool) -> Int\n" +
    "  if given then\n" +
    "  else\n" +
    "    1\n" +
    "  end\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  compute(true)\n" +
    "end\n"
  let names = _lint_names(src)
  assert(_contains(&names, "empty_block"), "empty_block must fire on the empty then block")
end

# ─── the boundary fixture: the large_function exact-limit contract ───

@test
def test_large_function_boundary_at_exactly_max_lines_is_clean() -> Unit
  # The pass counts the lines of the function's source span against the
  # exact max_lines (100) — the fixture WELL WITHIN the limit (90 body
  # lines) is clean.
  var src = "def boundary_fn(x: Int) -> Int\n".to_string()
  var i = 0
  while i < 90 do
    src = src + "  let v" + i.to_string() + " = x + " + i.to_string() + "\n"
    i = i + 1
  end
  src = src + "  x\n" + "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  boundary_fn(1)\n" +
    "end\n"
  let diags = assert_ok(lint_source("boundary.tg", src, _default_config()))
  for d in diags do
    if d.lint_name == "large_function" then
      assert_false(true)
    end
  end
end

@test
def test_large_function_boundary_over_max_lines_fires() -> Unit
  # The fixture WELL OVER the limit (130 body lines) fires.
  var src = "def too_long_fn(x: Int) -> Int\n".to_string()
  var i = 0
  while i < 130 do
    src = src + "  let v" + i.to_string() + " = x + " + i.to_string() + "\n"
    i = i + 1
  end
  src = src + "  x\n" + "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  too_long_fn(1)\n" +
    "end\n"
  let names = _lint_names(src)
  assert(_contains(&names, "large_function"), "large_function must fire past the limit")
end

# ─── the suppression contract ────────────────────────────────────────

@test
def test_allow_attribute_suppresses_the_lint() -> Unit
  let src = "@[allow(\"unused_variables\")]\n" +
    "def compute() -> Int\n" +
    "  let hidden = 1\n" +
    "  0\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  compute()\n" +
    "end\n"
  let diags = assert_ok(lint_source("allow.tg", src, _default_config()))
  for d in diags do
    if d.lint_name == "unused_variables" then
      assert_false(true)
    end
  end
end

@test
def test_config_allowed_list_suppresses_the_lint() -> Unit
  let src = "def compute() -> Int\n" +
    "  let hidden = 1\n" +
    "  0\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  compute()\n" +
    "end\n"
  var config = default_lint_config()
  config.allowed.push("unused_variables".to_string())
  let diags = assert_ok(lint_source("allowed.tg", src, &config))
  for d in diags do
    if d.lint_name == "unused_variables" then
      assert_false(true)
    end
  end
end

# ─── the config level overrides ──────────────────────────────────────

@test
def test_config_denied_list_escalates_to_error() -> Unit
  let src = "def compute() -> Int\n" +
    "  let hidden = 1\n" +
    "  0\n" +
    "end\n" +
    "\n" +
    "def main() -> Int\n" +
    "  compute()\n" +
    "end\n"
  var config = default_lint_config()
  config.denied.push("unused_variables".to_string())
  let diags = assert_ok(lint_source("denied.tg", src, &config))
  var found = false
  for d in diags do
    if d.lint_name == "unused_variables" then
      found = true
      match d.level
      when LintLevel::Error then ()
      when _ then assert_false(true)
      end
    end
  end
  assert_true(found)
end
