# Regression test: collection method receiver on a deeply nested field.
#
# This mirrors the compiler-internal pattern that originally exposed the
# nested field-address projection bug (e.g. `ctx.rodata.labels.keys()` /
# `f.locals.push(...)`): calling Vec methods through a two-level field chain.
# The receiver borrow of `h.bag.items` must resolve to the Vec struct stored
# inside the nested field, not a parent struct.

use std::collections::{Vec}

struct Bag
  items: Vec[Int]
  name: String
end

struct Holder
  bag: Bag
  id: Int
end

def main() -> Int
  mut h = Holder {
    bag: Bag {
      items: Vec::new(),
      name: "bag"
    },
    id: 1
  }
  h.bag.items.push(10)
  h.bag.items.push(32)
  if h.bag.items.len() != 2 then
    return 1
  end
  if h.bag.items[0] != 10 then
    return 2
  end
  if h.bag.items[1] != 32 then
    return 3
  end
  0
end
