use std::io::{print, println}

def int_to_string(n: Int) -> String
  if n == 0 then
    return "0"
  end
  mut val = n
  mut digits = ""
  while val > 0 do
    let d = val - ((val / 10) * 10)
    val = val / 10
    let ch = match d
      when 0 then "0"
      when 1 then "1"
      when 2 then "2"
      when 3 then "3"
      when 4 then "4"
      when 5 then "5"
      when 6 then "6"
      when 7 then "7"
      when 8 then "8"
      when 9 then "9"
      else "?"
    end
    digits = ch + digits
  end
  digits
end

def returns_zero(desc: String, a: Int, b: Int, c: Int, d: Int) -> Int
  print("  test: ")
  print(desc)
  print(" ")
  print(int_to_string(a))
  print(" ")
  print(int_to_string(b))
  print(" ")
  print(int_to_string(c))
  print(" ")
  println(int_to_string(d))
  if a == c then 0 else 1 end
end

def main() -> Int
  println("a")
  println("b")
  println("c")
  println("d")
  println("e")
  println("f")
  mut fails = 0
  println("init: " + int_to_string(fails))
  fails = fails + returns_zero("addition", 8, 3, 8, 5)
  println("after1: " + int_to_string(fails))
  fails = fails + returns_zero("subtract", 58, 42, 58, 100)
  println("after2: " + int_to_string(fails))
  fails
end
