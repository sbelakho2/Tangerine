# tests/test_synthesis_test.tg — audit order item 5 closeout: the
# test-synthesis closed loop. The kernel exposes the typed uncovered-path
# requests (tg_compiler/coverage_graph.tg); the full-library wiring
# (tg_compiler/test_synthesis.tg) promotes them into synthesis requests
# with a deterministic identity/name (the 128-bit stable digest of the
# length-prefixed constraint identity) and calls the pub generator
# (std::test_gen.generate_test_suite) to produce concrete @test sources.
#
# The lane asserts:
#   1. deterministic naming — the same request yields byte-identical
#      names/digests, a different constraint yields a different name;
#   2. the typed request render (the fallback) carries every typed field
#      and the request key, and is NOT an executable test;
#   3. the generator round trip — a request for a function carrying at
#      least one boundary candidate yields kind "generated" with a
#      concrete @test source under the deterministic name; a request for
#      a function the module source does not carry yields kind
#      "request-render" (never a fabricated test);
#   4. the targeted-request promotion skips affected-test rows (they name
#      tests that already exist).
#
# Run with the repo root as the working directory:
#   tg test tests/test_synthesis_test.tg

use std::test::assert

use tg_compiler::coverage_graph::{TargetedTestRequest}
use tg_compiler::test_synthesis::{
  SynthesisRequest,
  synthesis_function_name_of_key, synthesis_identity_digest,
  synthesis_request_key, synthesis_requests_from_targeted, synthesis_test_name,
  render_synthesis_request, render_synthesized_suite,
  synthesize_tests_for_requests
}

# ONE hand-built uncovered-path request (the kernel's typed record shape).
def synthesis_probe_request(function_key: String, target_key: String, constraint: String) -> TargetedTestRequest
  TargetedTestRequest {
    kind: "uncovered-path".to_string(),
    test: "".to_string(),
    symbols: Vec::new(),
    constraint: constraint.clone(),
    edge_kind: "call".to_string(),
    source: function_key.clone(),
    target: target_key.clone()
  }
end

# ONE hand-built affected-test request (not synthesis input).
def synthesis_probe_affected(test_key: String, symbol: String) -> TargetedTestRequest
  TargetedTestRequest {
    kind: "affected-test".to_string(),
    test: test_key.clone(),
    symbols: Vec::from([symbol.clone()]),
    constraint: "".to_string(),
    edge_kind: "".to_string(),
    source: "".to_string(),
    target: "".to_string()
  }
end

def synthesis_probe_constraint() -> String
  "m::h#fn()->unit#B?m::h#fn()->unit|m::k#fn()->unit|0".to_string()
end

# The one-element request vector (push-built: TargetedTestRequest is not
# Copy, so it never rides a Vec::from list literal).
def synthesis_probe_request_vec(function_key: String, target_key: String, constraint: String) -> Vec[TargetedTestRequest]
  var v: Vec[TargetedTestRequest] = Vec::new()
  v.push(synthesis_probe_request(function_key, target_key, constraint))
  v
end

def synthesis_probe_requests() -> Vec[SynthesisRequest]
  synthesis_requests_from_targeted(
    synthesis_probe_request_vec(
      "m::h#fn()->unit".to_string(),
      "m::k#fn()->unit".to_string(),
      synthesis_probe_constraint()),
    "m".to_string())
end

@test
def test_synthesis_name_is_deterministic() -> Unit
  let reqs = synthesis_probe_requests()
  assert(reqs.len() == 1, "expected ONE synthesis request, got " + reqs.len().to_string())
  let a = synthesis_test_name(reqs[0].clone())
  let b = synthesis_test_name(reqs[0].clone())
  assert(a == b, "the deterministic name must be stable across calls")
  assert(a.starts_with("test_uncovered_h_"), "unexpected name shape: " + a)
  let other = synthesis_requests_from_targeted(
    synthesis_probe_request_vec(
      "m::h#fn()->unit".to_string(),
      "m::k#fn()->unit".to_string(),
      "m::h#fn()->unit#B?m::h#fn()->unit|m::j#fn()->unit|0".to_string()),
    "m".to_string())
  assert(synthesis_test_name(other[0].clone()) != a, "a different constraint must yield a different name")
  assert(
    synthesis_identity_digest(
      "call".to_string(), "m::h#fn()->unit".to_string(), "m::k#fn()->unit".to_string(),
      synthesis_probe_constraint()) == reqs[0].identity_digest,
    "the identity digest must be a pure function of the typed fields")
end

@test
def test_synthesis_function_name_of_key() -> Unit
  assert(synthesis_function_name_of_key("m::h#fn()->unit".to_string()) == "h".to_string(),
    "the bare declaration name must drop the module path and signature tail")
  assert(synthesis_function_name_of_key("h".to_string()) == "h".to_string(),
    "a bare name must pass through unchanged")
end

@test
def test_synthesis_request_render_is_not_a_test() -> Unit
  let reqs = synthesis_probe_requests()
  let render = render_synthesis_request(reqs[0].clone())
  assert(render.contains("# synthesis-request"), "the render must be the typed request form")
  assert(render.contains("constraint: " + synthesis_probe_constraint()), "the constraint must ride the render")
  assert(render.contains(synthesis_request_key(reqs[0].clone())), "the request key must ride the render")
  assert(!render.contains("@test"), "a request render must never claim an executable test")
end

@test
def test_synthesis_generator_round_trip() -> Unit
  let source = "def h(x: Int) -> Int\n  x\nend\n"
  let units = synthesize_tests_for_requests(source.to_string(), synthesis_probe_requests())
  assert(units.len() == 1, "expected ONE synthesized unit, got " + units.len().to_string())
  assert(units[0].kind == "generated".to_string(),
    "the generator must serve a function with boundary candidates: " + units[0].kind)
  assert(units[0].source.contains("@test"), "a generated unit must carry a concrete @test source")
  assert(units[0].source.contains(units[0].test_name), "the deterministic name must ride the source")
  assert(units[0].source.contains("constraint: " + synthesis_probe_constraint()),
    "the constraint must ride the generated source header")
end

@test
def test_synthesis_missing_function_renders_request() -> Unit
  let reqs = synthesis_requests_from_targeted(
    synthesis_probe_request_vec(
      "m::missing#fn()->unit".to_string(),
      "m::n#fn()->unit".to_string(),
      "m::missing#fn()->unit#B?m::missing#fn()->unit|m::n#fn()->unit|0".to_string()),
    "m".to_string())
  let units = synthesize_tests_for_requests("def h(x: Int) -> Int\n  x\nend\n".to_string(), reqs)
  assert(units.len() == 1, "expected ONE synthesized unit, got " + units.len().to_string())
  assert(units[0].kind == "request-render".to_string(),
    "a function absent from the source must render as a typed request, got: " + units[0].kind)
  assert(!units[0].source.contains("@test"), "the fallback must never fabricate a test")
end

@test
def test_synthesis_promotion_skips_affected_tests() -> Unit
  var mixed: Vec[TargetedTestRequest] = Vec::new()
  mixed.push(synthesis_probe_affected(
    "m::test_a#fn()->unit|test@attr#test_a".to_string(),
    "m::f#fn()->unit".to_string()))
  mixed.push(synthesis_probe_request(
    "m::h#fn()->unit".to_string(),
    "m::k#fn()->unit".to_string(),
    synthesis_probe_constraint()))
  let promoted = synthesis_requests_from_targeted(mixed, "m".to_string())
  assert(promoted.len() == 1, "affected-test rows must not become synthesis requests")
  assert(promoted[0].function_name == "h".to_string(), "the uncovered-path row must survive")
end

@test
def test_synthesis_suite_render() -> Unit
  let units = synthesize_tests_for_requests(
    "def h(x: Int) -> Int\n  x\nend\n".to_string(), synthesis_probe_requests())
  let text = render_synthesized_suite(units, "m".to_string())
  assert(text.contains("# module: m"), "the suite render must carry the module")
  assert(text.contains("units: 1"), "the suite render must carry the unit count")
end
