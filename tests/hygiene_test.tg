# tests/hygiene_test.tg — the production-root hygiene gate (the
# reviewer's item 29).
#
# The production roots (std/ and tg_compiler/) must contain ONLY the
# canonical sources: no *.fixed / *.bak / *.old / *~ artifacts, and no
# test suites (the canonical *.tg is the production surface; the
# property suites live under tests/ — hash_tests.tg moved here).
#
# Run with: tg run tests/hygiene_test.tg

use std::test::*
use std::core::{Option, Result, String, Unit, Bool}
use std::fs

def is_backup_artifact(name: String) -> Bool
  name.ends_with(".fixed") || name.ends_with(".bak") || name.ends_with(".old") || name.ends_with("~")
end

@test
def test_no_backup_artifacts_in_production_roots() -> Unit
  let roots = ["std", "tg_compiler"]
  for root in roots do
    let entries = assert_ok(fs::read_dir(root.to_string()))
    for entry in entries do
      if is_backup_artifact(entry.name) then
        assert(false, "production-root hygiene violation: " + root + "/" + entry.name + " (no *.fixed / *.bak / *.old / *~ in the production roots)")
      end
    end
  end
end

@test
def test_hash_property_suite_lives_in_tests() -> Unit
  # The hash property suite was moved out of std/ (the production root
  # is the canonical stdlib surface only) into tests/.
  let entries = assert_ok(fs::read_dir("std".to_string()))
  for entry in entries do
    if entry.name == "hash_tests.tg" then
      assert(false, "std/hash_tests.tg must not live in the production std root")
    end
  end
  let test_entries = assert_ok(fs::read_dir("tests".to_string()))
  var found = false
  for entry in test_entries do
    if entry.name == "hash_tests.tg" then
      found = true
    end
  end
  assert_true(found)
end
