# tests/async_semaphore_waiter_test.tg — the AsyncSemaphore's waiter
# registration (reviewer item 7-d): the AcquireFuture holds its
# waiter_id (from the executor's next_waiter_id allocator) — the waiter
# registers ONCE (repeated polls while starved never append a
# duplicate), the acquisition CONSUMES the registration, the Drop
# removes the entry, and the release wakes the OLDEST live waiter.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::async::{Future, Waker, Context, Poll}

# (d) The duplicate-waiter test: two polls of the SAME starved acquire
# future register ONE waiter; the entry carries the future's waiter id;
# the release wakes the waiter (its entry is popped) and the re-poll
# acquires.
@test
def test_semaphore_acquire_duplicate_poll_registers_once() -> Unit
  mut exec = std::async::executor_new()
  let sem = std::async::async_semaphore_new(1)
  let mut holder = sem.acquire()
  let waker = Waker { task_id: 401, executor: exec.inner.clone() }
  let mut cx = Context { waker: waker }

  # the holder takes the single permit (and HOLDS it across the checks)
  match holder.poll(&mut cx)
  when Poll::Ready(permit) then
    # a second future: starved — the first poll registers ONCE, the
    # second poll never appends a duplicate
    let mut fut = sem.acquire()
    match fut.poll(&mut cx)
    when Poll::Pending then ()
    when _ then assert_false(true)
    end
    assert_eq(sem.inner.ptr.as_ref().waiters.len(), 1)
    match fut.poll(&mut cx)
    when Poll::Pending then ()
    when _ then assert_false(true)
    end
    assert_eq(sem.inner.ptr.as_ref().waiters.len(), 1)

    # the registered entry carries the future's waiter id
    match fut.waiter_id
    when Option::Some(id) then
      assert_eq(id, sem.inner.ptr.as_ref().waiters[0].id)
    when Option::None then assert_false(true)
    end

    # the permit's Drop releases: the counter goes back up and the
    # OLDEST waiter is woken (its entry is popped)
    drop(permit)
    assert_eq(sem.inner.ptr.as_ref().counter.load(), 1)
    assert_eq(sem.inner.ptr.as_ref().waiters.len(), 0)

    # the woken future's re-poll acquires
    match fut.poll(&mut cx)
    when Poll::Ready(_) then ()
    when Poll::Pending then assert_false(true)
    end
  when Poll::Pending then assert_false(true)
  end
end

# (d-drop) The starved AcquireFuture's Drop removes its own waiter
# entry, so the release always wakes the OLDEST live waiter.
@test
def test_semaphore_dropped_waiter_removes_entry() -> Unit
  mut exec = std::async::executor_new()
  let sem = std::async::async_semaphore_new(1)
  let mut holder = sem.acquire()
  let waker = Waker { task_id: 402, executor: exec.inner.clone() }
  let mut cx = Context { waker: waker }

  match holder.poll(&mut cx)
  when Poll::Ready(permit) then
    let mut fut = sem.acquire()
    match fut.poll(&mut cx)
    when Poll::Pending then ()
    when _ then assert_false(true)
    end
    assert_eq(sem.inner.ptr.as_ref().waiters.len(), 1)

    # the starved future's Drop removes its own waiter entry
    drop(fut)
    assert_eq(sem.inner.ptr.as_ref().waiters.len(), 0)
    drop(permit)
  when Poll::Pending then assert_false(true)
  end
end

# (d-fifo) The release wakes the OLDEST live waiter (FIFO order): h2
# registers before h3 and acquires first; h2's permit's release then
# wakes h3.
@test
def test_semaphore_release_wakes_oldest_waiter() -> Unit
  let mut order = Vec::new()
  std::async::block_on(async {
    let sem = std::async::async_semaphore_new(1)
    let permit = sem.acquire().await
    let h2 = std::async::spawn(async {
      let _p = sem.acquire().await
      order.push(2)
    })
    let h3 = std::async::spawn(async {
      let _p = sem.acquire().await
      order.push(3)
    })
    # the sleep parks the block_on task so h2 and h3 register their
    # waiters BEFORE the release — the wake path, not the first poll
    std::async::sleep_millis(1).await
    drop(permit)
    let _ = h2.await
    let _ = h3.await
  })
  assert_eq(order.len(), 2)
  assert_eq(order[0], 2)
  assert_eq(order[1], 3)
end
