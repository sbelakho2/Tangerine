# tests/formatter_adversarial/fmt_unicode_idents.tg — the adversarial
# UNICODE-IDENTIFIER format input: Greek, Latin-extended, CJK, and
# combining-mark identifiers (the UCD XID_Start/XID_Continue classes),
# used as function names, parameters, and locals. The NFC-identity rule
# means the ORIGINAL spelling is preserved — a formatter that
# transliterated, dropped a combining mark, or normalized the spelling
# would change the identifier identity and fail the equivalence gate.
use std::core

def π(x: Int) -> Int
  x * 3
end

def λ(f: Int, x: Int) -> Int
  f + x
end

def café(x: Int) -> Int
  x + 1
end

def über(x: Int) -> Int
  x + 2
end

def 変数(x: Int) -> Int
  x + 3
end

def combining(x: Int) -> Int
  let a\u{0301} = x  # 'a' + combining acute — one identifier
  a\u{0301} + 1
end

def main() -> Int
  let π値 = π(1)
  let λ値 = λ(π値, 2)
  let café値 = café(λ値)
  let über値 = über(café値)
  let 変数値 = 変数(über値)
  combining(変数値)
end
