# tests/formatter_adversarial/fmt_string_heavy.tg — the adversarial
# STRING-LITERAL-HEAVY format input: every escape class (\n \t \r \0
# \xNN \u{...}), embedded quotes, apostrophes, astral characters, long
# concatenation chains, and char literals. The formatter must round-trip
# the string VALUES (the parse-tree signature compares the lexed values —
# a formatter that mangled an escape or a quote boundary fails the
# semantic-equivalence gate).
use std::core

def string_heavy() -> Int
  let s0 = "plain"
  let s1 = "tab\there"
  let s2 = "newline\nhere"
  let s3 = "cr\rhere"
  let s4 = "nul\0here"
  let s5 = "hex\x41\x42\x43"
  let s6 = "unicode\u{1F600}\u{00E9}\u{4F60}"
  let s7 = "quote\"inside"
  let s8 = "apostrophe'inside"
  let s9 = "backslash\\here"
  let s10 = "mixed: \t\n\r\0\x7F\u{10FFFF} end"
  let s11 = "double \"quoted\" and 'single' in one"
  let s12 = ""
  let s13 = "astral raw: "
  let joined = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11 + s12 + s13
  let c0 = 'a'
  let c1 = '\n'
  let c2 = '\t'
  let c3 = '\x41'
  let c4 = '\u{03BB}'
  let c5 = '\u{1F600}'
  let long = "a very long string literal that goes on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on"
  (joined.len() + long.len() + c0 as Int + c1 as Int + c2 as Int + c3 as Int + c4 as Int + c5 as Int)
end

def main() -> Int
  string_heavy()
end
