# tests/formatter_adversarial/fmt_comment_dense.tg — the adversarial
# COMMENT-DENSE format input: a line comment after (nearly) every line,
# trailing comments, nested block comments (#| ... |#), a comment between
# the tokens of an expression, and a doc-comment block. The formatter
# must keep every comment (comments carry no tree weight — a formatter
# that drops them passes a tree-only check; the idempotence gate over the
# formatted output pins their retention indirectly: the second format
# must not shift anything).
use std::core

#| A nested block comment: the outer |# must not terminate here.
#| The inner one: #| inner |# is balanced, then the outer continues.
Still inside the outer block comment.
|#

def comment_dense(x: Int, y: Int) -> Int  # the signature line
  # a leading comment on the body
  let a = x + 1  # trailing comment on a declaration
  #| a block comment splitting the statement stream
  a = a + y
  |#
  a = a + (  # a comment INSIDE the parenthesized expression
    2
  )
  if a > 0 then  # the branch comment
    # the then-arm comment
    a = a * 2
  else  # the else-arm comment
    # the else-arm comment, second
    a = a - 1
  end  # the end-token comment
  a
end

### The doc-comment block: the semantic docs that the doc generator reads.
### It must survive the format round-trip byte-for-byte.
def doc_comment_holder() -> Int
  comment_dense(1, 2)  # call-site comment
end

# the file-tail comment
def main() -> Int
  doc_comment_holder()
end
