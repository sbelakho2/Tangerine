use std::io::{print, println}

def apply_op(op: Int, stored: Int, current: Int) -> Int
  match op
  when 1 then stored + current
  when 2 then stored - current
  when 3 then stored * current
  when 4 then
    if current == 0 then
      -999999
    else
      stored / current
    end
  else current
  end
end

def main() -> Int
  let r1 = apply_op(1, 5, 3)
  let r2 = apply_op(2, 100, 42)
  let r3 = apply_op(3, 10, 7)
  let r4 = apply_op(4, 84, 12)
  let r5 = apply_op(4, 42, 0)

  # Use exit code to signal results
  if r1 != 8 then return 1 end
  if r2 != 58 then return 2 end
  if r3 != 70 then return 3 end
  if r4 != 7 then return 4 end
  if r5 != -999999 then return 5 end
  0
end
