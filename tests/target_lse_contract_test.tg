# tests/target_lse_contract_test.tg — the AArch64 LSE requirement is
# explicit target metadata.
#
# The AArch64 RMW family emitted for the atomics (LDADDAL/CASAL/SWPAL —
# codegen's emit_atomic_intrinsic_a64 and the __sync_* lowering) is the
# ARMv8.1 LSE extension, not the ARMv8.0 baseline. The chosen contract is
# the EXPLICIT target requirement: the aarch64 target's metadata
# (AsmTarget.requires_lse — see asm.tg's target feature table and the
# driver's --target documentation) states that LSE is required; the
# ldaxr/stlxr LL/SC fallback is the future portable mode, not the current
# emission. This suite pins the metadata so the contract cannot silently
# drift.

use std::test::*
use tg_compiler::asm::{Arch, OsAbi, asm_target}

@test
def test_aarch64_target_requires_lse() -> Unit
  let t_linux = asm_target(Arch::AArch64, OsAbi::Linux)
  let t_macos = asm_target(Arch::AArch64, OsAbi::MacOS)
  let t_windows = asm_target(Arch::AArch64, OsAbi::Windows)
  assert_true(t_linux.requires_lse)
  assert_true(t_macos.requires_lse)
  assert_true(t_windows.requires_lse)
end

@test
def test_x86_64_target_does_not_require_lse() -> Unit
  # x86-64's LOCKed RMW prefix is baseline: no extension requirement.
  let t_linux = asm_target(Arch::X86_64, OsAbi::Linux)
  let t_macos = asm_target(Arch::X86_64, OsAbi::MacOS)
  let t_windows = asm_target(Arch::X86_64, OsAbi::Windows)
  assert_false(t_linux.requires_lse)
  assert_false(t_macos.requires_lse)
  assert_false(t_windows.requires_lse)
end
