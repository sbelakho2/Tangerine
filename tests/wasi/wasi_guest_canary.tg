## The WASI guest canary (the mandate's wasi row): a wasm32-wasi module
## declaring the preview1 imports (via std::wasi) with a pure exported
## function the conformance lane invokes under wasmtime (when the runtime
## is installed) and the import-section structural validation (the
## fd_read / fd_write / fd_close / proc_exit / args / environ set the
## wasm backend's add_wasi_imports emits for the wasi target).

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::wasi::{Errno, Iovec, ClockId}

## The exported pure function (no wasi call): the instantiation proof —
## wasmtime must resolve the module's wasi imports against its host ABI.
def add(a: Int, b: Int) -> Int
  a + b
end

## The errno surface: the raw code mapping is pure and host-testable.
def errno_name(code: i32) -> String
  match Errno::from_raw(code)
  when Errno::Success then "success"
  when Errno::BadFileDescriptor then "badfd"
  when Errno::NoEntry then "noentry"
  when Errno::PermissionDenied then "permission"
  when Errno::Other(_) then "other"
  end
end

def main() -> Int
  add(40, 2)
end
