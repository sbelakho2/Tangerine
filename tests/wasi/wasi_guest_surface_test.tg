## The WASI guest surface behavioral suite — the pure preview1 surface:
## the errno code mapping and the clock-id raw codes (host-testable
## without a wasm runtime).

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::wasi::{Errno, Iovec, ClockId}
use std::test::*

@test
def test_errno_mapping() -> Unit
  match Errno::from_raw(0)
  when Errno::Success then ()
  when _ then panic("raw 0 must map to Success")
  end
  match Errno::from_raw(8)
  when Errno::BadFileDescriptor then ()
  when _ then panic("raw 8 must map to BadFileDescriptor")
  end
  match Errno::from_raw(2)
  when Errno::NoEntry then ()
  when _ then panic("raw 2 must map to NoEntry")
  end
  match Errno::from_raw(13)
  when Errno::PermissionDenied then ()
  when _ then panic("raw 13 must map to PermissionDenied")
  end
  match Errno::from_raw(99)
  when Errno::Other(code) then
    if code != 99 then panic("raw 99 must carry through the Other payload") end
  when _ then panic("raw 99 must map to Other")
  end
end

@test
def test_clock_id_raw_codes() -> Unit
  if ClockId::Realtime.raw() != 0 then panic("realtime clock id must be 0") end
  if ClockId::Monotonic.raw() != 1 then panic("monotonic clock id must be 1") end
  if ClockId::ProcessCpuTime.raw() != 2 then panic("process cpu clock id must be 2") end
  if ClockId::ThreadCpuTime.raw() != 3 then panic("thread cpu clock id must be 3") end
end

@test
def test_iovec_wire_shape() -> Unit
  ## The iovec is the preview1 {base, len} pair: two 8-byte words.
  var data: [u8; 4] = [1, 2, 3, 4]
  let iov = Iovec::new(&data[0] as Ptr[u8], 4)
  if iov.len != 4 then
    panic("iovec length mismatch")
  end
  if iov.base == Ptr::null() then
    panic("iovec base must be the buffer pointer")
  end
end
