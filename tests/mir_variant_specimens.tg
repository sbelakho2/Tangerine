# tests/mir_variant_specimens.tg — the MIR variant source-level specimens
# (the operations that PRODUCE the mir.tg variants, written as one
# compilable positive program).
#
# The coverage oracle (scripts/check_variant_coverage.sh --domain mir)
# scans THIS file for the fingerprint of each variant's source producer:
# every construct below is the operation the compiler lowers to the
# variant named in the adjacent comment. The unit layer
# (tests/mir_variant_coverage_tests.tg) constructs every variant by hand;
# this file exercises the LOWERING routes from real programs.
#
# Run: tg run tests/mir_variant_specimens.tg  (exits 0)

use std::core::Option
use std::collections::{Vec, Map, Set}

enum Color
  Red
  Green(Int)
end

struct Point
  x: Int
  y: Int
end

# MirMove — `let b = a` moves the owning String into the new binding
# (a MirMove rvalue materializes the moved place).
def move_specimen(owned: String) -> Int
  let moved = owned
  moved.len()
end

# MirRef — the `&place` access marker on a call argument (the only
# internal-ABI reference form).
def observe(x: Int) -> Int
  x
end

def ref_specimen() -> Int
  var counter = 3
  observe(&counter)
end

# MirAggregate — struct literal construction (Struct aggregate).
def aggregate_struct_specimen() -> Int
  let p = Point { x: 1, y: 2 }
  p.x + p.y
end

# MirAggregate — array literal construction (MirArray aggregate).
def aggregate_array_specimen() -> Int
  let items = [1, 2, 3]
  items[0]
end

# MirBinOp — arithmetic / comparison binary operators.
def binop_specimen() -> Int
  let sum = 1 + 2
  let ok = sum == 3
  if ok then sum else 0 end
end

# MirUnOp — prefix negate / logical not / bitwise not.
def unop_specimen(flag: Bool) -> Int
  var x = 5
  let neg = -x
  let inv = !flag
  let bits = ~x
  if inv && bits == 0 - 6 then neg + 1 else 0 end
end

# MirDiscriminant — a match on an enum value reads the discriminant.
def discriminant_specimen(c: Color) -> Int
  match c
  when Color::Red then 1
  when Color::Green(_) then 2
  end
end

# MirLen — `.len()` on a string / collection.
def len_specimen(text: String) -> Int
  text.len()
end

# MirCast — `as` casts.
def cast_specimen() -> Int
  let f = 3.5 as Int
  f
end

# MirRepeat — NO source-level producer in the current lowering: the
# `[v; N]` repeat literal is not lowered (the parser's array literal
# grammar is comma-separated only, and the MIR builder has no repeat
# construction site), so MirRepeat is exercised at the IR level by the
# unit suite (tests/mir_variant_coverage_tests.tg), never claimed from a
# source construct.
#
# MirPhi — a loop's back-edge merge produces phi nodes.
def phi_specimen() -> Int
  mut acc = 0
  loop do
    acc = acc + 1
    if acc >= 5 then break end
  end
  acc
end

# MirGoto — an if branch lowers to a conditional goto.
def goto_specimen(x: Int) -> Int
  if x > 0 then x else 0 - x end
end

# MirReturn — the return terminator.
def return_specimen() -> Int
  return 42
end

# MirSwitchInt — a match on an integer value dispatches by switch.
def switch_specimen(n: Int) -> Int
  match n
  when 0 then 10
  when 1 then 20
  when _ then 30
  end
end

# MirCall — a direct function call.
def called_fn(x: Int) -> Int
  x * 2
end

def call_specimen() -> Int
  called_fn(21)
end

# MirAssert — an array index emits the bounds-check assert.
def assert_specimen(items: Vec[Int]) -> Int
  items[0]
end

# MirAbort — a panic call lowers to the abort terminator.
def abort_specimen(x: Int) -> Int
  if x < 0 then
    panic("negative input")
  end
  x
end

# MirDeinit — a `deinit` method marks the resource destructor path.
struct Resource
  value: Int
end

impl Resource
  def deinit(sink self: Self) -> Unit
    ()
  end
end

def deinit_specimen() -> Int
  let r = Resource { value: 7 }
  r.value
end

# ProjDeref — the raw pointer dereference produces the deref projection.
def deref_specimen(p: Ptr[Int]) -> Int
  let v = *p
  v
end

# Projection::Field — struct field access.
def field_specimen(p: Point) -> Int
  p.x
end

# Projection::Variant — a match arm binding the enum payload (the
# Variant downcast projection).
def variant_specimen(c: Color) -> Int
  match c
  when Color::Green(v) then v
  when _ then 0
  end
end

# Projection::TupleIndex — tuple element access `t.0`.
def tuple_index_specimen() -> Int
  let pair = (7, "seven")
  pair.0
end

# Projection::ProjIndex — a Vec index with a variable index.
def proj_index_specimen(items: Vec[Int], i: Int) -> Int
  items[i]
end

# Projection::ProjConstantIndex — a fixed-array index with a constant.
def proj_constant_index_specimen() -> Int
  let fixed = [9, 8, 7]
  fixed[2]
end

def main() -> Int
  let text = "hello".to_string()
  let total =
    move_specimen(text.clone()) +
    ref_specimen() +
    aggregate_struct_specimen() +
    aggregate_array_specimen() +
    binop_specimen() +
    unop_specimen(true) +
    discriminant_specimen(Color::Red) +
    len_specimen("abc".to_string()) +
    cast_specimen() +
    phi_specimen() +
    goto_specimen(-3) +
    return_specimen() +
    switch_specimen(1) +
    call_specimen() +
    assert_specimen(Vec::from([1])) +
    abort_specimen(1) +
    deinit_specimen() +
    deref_specimen(Ptr::null()) +
    field_specimen(Point { x: 1, y: 2 }) +
    variant_specimen(Color::Green(5)) +
    tuple_index_specimen() +
    proj_index_specimen(Vec::from([2]), 0) +
    proj_constant_index_specimen()
  if total > 0 then 0 else 1 end
end
