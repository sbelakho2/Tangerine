# tests/vararg_promotion_table_test.tg — the audit §26 promotion-table
# unit lane.
#
# The C default argument promotions applied to the EXTRA (anonymous)
# arguments of a variadic extern call (vararg_extra_promoted_type in
# types.tg — the single authority the checker gate and the codegen
# marshalling share):
#   F32 -> F64 (float varargs never pass floats: the single image is
#     widened to the double image at the call boundary);
#   I8/I16 -> I32 (sign-extended), U8/U16 -> I32 (zero-extended —
#     int can represent every u8/u16 value), Bool -> I32 (0/1),
#     Char -> I32 (the 32-bit scalar value);
#   Int/UInt/I32/U32/I64/U64/ISize/USize/F64/Float/pointers -> as-is;
#   everything else (I128/U128, String, aggregates, enums, references,
#     Unit, type vars) -> Option::None (rejected at the call site).
#
# Run with the repo root as the working directory:
#   tg test tests/vararg_promotion_table_test.tg

use std::test::*
use tg_compiler::types::{Type, vararg_extra_promoted_type, vararg_extra_type_allowed}

def promoted_is(ty: Type, want: Type) -> Bool
  match vararg_extra_promoted_type(&ty)
  when Option::Some(got) then got == want
  when Option::None then false
  end
end

def promoted_is_none(ty: Type) -> Bool
  match vararg_extra_promoted_type(&ty)
  when Option::Some(_) then false
  when Option::None then true
  end
end

def allowed_is(ty: Type, want: Bool) -> Bool
  vararg_extra_type_allowed(&ty) == want
end

@test
def test_promotion_table_widening() -> Unit
  assert(promoted_is(Type::F32, Type::F64), "F32 promotes to F64")
  assert(promoted_is(Type::F64, Type::F64), "F64 crosses unchanged")
  assert(promoted_is(Type::Float, Type::Float), "Float crosses unchanged")
end

@test
def test_promotion_table_small_ints() -> Unit
  assert(promoted_is(Type::I8, Type::I32), "I8 promotes to the int width")
  assert(promoted_is(Type::I16, Type::I32), "I16 promotes to the int width")
  assert(promoted_is(Type::U8, Type::I32), "U8 promotes to the int width")
  assert(promoted_is(Type::U16, Type::I32), "U16 promotes to the int width")
  assert(promoted_is(Type::Bool, Type::I32), "Bool promotes to int")
  assert(promoted_is(Type::Char, Type::I32), "Char crosses as an int image")
end

@test
def test_promotion_table_untouched() -> Unit
  assert(promoted_is(Type::Int, Type::Int), "Int untouched")
  assert(promoted_is(Type::UInt, Type::UInt), "UInt untouched")
  assert(promoted_is(Type::I32, Type::I32), "I32 untouched")
  assert(promoted_is(Type::U32, Type::U32), "U32 untouched")
  assert(promoted_is(Type::I64, Type::I64), "I64 untouched")
  assert(promoted_is(Type::U64, Type::U64), "U64 untouched")
  assert(promoted_is(Type::ISize, Type::ISize), "ISize untouched")
  assert(promoted_is(Type::USize, Type::USize), "USize untouched")
  assert(promoted_is(Type::Ptr(Type::U8), Type::Ptr(Type::U8)), "pointers pass as-is")
  assert(promoted_is(Type::PtrMut(Type::I8), Type::PtrMut(Type::I8)), "mut pointers pass as-is")
end

@test
def test_promotion_table_rejections() -> Unit
  assert(promoted_is_none(Type::String), "String has no promotion")
  assert(promoted_is_none(Type::I128), "I128 has no promotion")
  assert(promoted_is_none(Type::U128), "U128 has no promotion")
  assert(promoted_is_none(Type::Unit), "Unit has no promotion")
  assert(promoted_is_none(Type::Never), "Never has no promotion")
end

@test
def test_subset_matches_promotions() -> Unit
  assert(allowed_is(Type::F32, true), "F32 admitted")
  assert(allowed_is(Type::F64, true), "F64 admitted")
  assert(allowed_is(Type::Float, true), "Float admitted")
  assert(allowed_is(Type::I8, true), "I8 admitted")
  assert(allowed_is(Type::I16, true), "I16 admitted")
  assert(allowed_is(Type::U8, true), "U8 admitted")
  assert(allowed_is(Type::U16, true), "U16 admitted")
  assert(allowed_is(Type::Bool, true), "Bool admitted")
  assert(allowed_is(Type::Char, true), "Char admitted")
  assert(allowed_is(Type::Int, true), "Int admitted")
  assert(allowed_is(Type::Ptr(Type::U8), true), "pointers admitted")
  assert(allowed_is(Type::String, false), "String rejected")
  assert(allowed_is(Type::I128, false), "I128 rejected")
  assert(allowed_is(Type::U128, false), "U128 rejected")
  assert(allowed_is(Type::Unit, false), "Unit rejected")
end
