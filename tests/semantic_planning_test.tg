# tests/semantic_planning_test.tg — third-audit item 48 first slice: the
# program-knowledge machinery of tg_compiler/semantic_planning.tg.
#
# The model (the hand-made-delta write/read sets + the typed-graph
# dependents, the EffectResourceSet, the RiskVector counts and the
# documented score thresholds against a §36 budget, the per-call MemoryFacts
# over a MirProgram — including the let/inout/sink call and the
# pointer-argument barrier — and the MergeRisk verdicts) lives in
# tg_compiler/semantic_planning.tg. This suite drives its self-checking lane
# rows; each returns the mismatch rows (empty = the lane verifies).
#
#   semantic_planning_lane_check — W1-W3 (write/read sets), E1 (effect
#     resources), R1-R6 (risk vectors + words), M1-M4 (merge verdicts),
#     F1-F3 (memory facts).
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_planning_test.tg

use std::test::assert

use tg_compiler::semantic_planning::{
  semantic_planning_lane_check
}

@test
def test_semantic_planning_lane() -> Unit
  let rows = semantic_planning_lane_check()
  assert(rows.len() == 0, "semantic planning lane mismatches: " + rows.join("; "))
end
