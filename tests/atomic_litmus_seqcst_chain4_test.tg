# tests/atomic_litmus_seqcst_chain4_test.tg — the 4-THREAD SeqCst
# total-order chain (the strengthened WRC family — the reviewer's
# SeqCst total-order variant).
#
# All operations SeqCst, run over ITERATIONS independent slots:
#   Thread 1: x[s] = 1
#   Thread 2: r1[s] = x[s];  if r1[s] == 1 then y[s] = 1
#   Thread 3: r2[s] = y[s];  if r2[s] == 1 then z[s] = 1
#   Thread 4: r3[s] = z[s];  r4[s] = x[s]
# The forbidden outcome is r1==1 && r2==1 && r3==1 && r4==0: three
# observed writes place the x-write, the y-write and the z-write in the
# single SeqCst total order, and coherence then forces thread 4's x-read
# to observe the x-write. The 3-thread WRC pins the two-link chain; this
# pins the THREE-LINK chain — the total-order property at depth 3.
#
# Each slot s is an independent execution: no cross-slot reset, no
# barriers — the ordering comes from the atomic operations themselves.

use std::core
use std::atomic::{AtomicInt, Ordering}
use std::thread::{spawn}

extern def _tg_mem_alloc(size: UInt) -> Ptr[u8]
extern def _tg_mem_free(ptr: Ptr[u8], size: UInt) -> Unit

const ITERATIONS: Int = 20000

struct Slot
  v: AtomicInt
end

def chain_t1(x: Ptr[Slot]) -> Int
  var i = 0
  while i < ITERATIONS do
    x.offset(i).as_ref().v.store(1, Ordering::SeqCst)
    i = i + 1
  end
  0
end

def chain_t2(x: Ptr[Slot], y: Ptr[Slot], r1: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    let v = x.offset(i).as_ref().v.load(Ordering::SeqCst)
    r1.offset(i).write(v)
    if v == 1 then
      y.offset(i).as_ref().v.store(1, Ordering::SeqCst)
    end
    i = i + 1
  end
  0
end

def chain_t3(y: Ptr[Slot], z: Ptr[Slot], r2: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    let v = y.offset(i).as_ref().v.load(Ordering::SeqCst)
    r2.offset(i).write(v)
    if v == 1 then
      z.offset(i).as_ref().v.store(1, Ordering::SeqCst)
    end
    i = i + 1
  end
  0
end

def chain_t4(z: Ptr[Slot], x: Ptr[Slot], r3: Ptr[Int], r4: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    let a = z.offset(i).as_ref().v.load(Ordering::SeqCst)
    r3.offset(i).write(a)
    let b = x.offset(i).as_ref().v.load(Ordering::SeqCst)
    r4.offset(i).write(b)
    i = i + 1
  end
  0
end

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  let bytes = (ITERATIONS * 8) as UInt
  let xb = _tg_mem_alloc(bytes)
  let yb = _tg_mem_alloc(bytes)
  let zb = _tg_mem_alloc(bytes)
  let r1b = _tg_mem_alloc(bytes)
  let r2b = _tg_mem_alloc(bytes)
  let r3b = _tg_mem_alloc(bytes)
  let r4b = _tg_mem_alloc(bytes)
  if xb.is_null() || yb.is_null() || zb.is_null() ||
     r1b.is_null() || r2b.is_null() || r3b.is_null() || r4b.is_null() then
    println("atomic_litmus_seqcst_chain4: allocation failed")
    return 1
  end
  let x = xb.cast[Slot]()
  let y = yb.cast[Slot]()
  let z = zb.cast[Slot]()
  let r1 = r1b.cast[Int]()
  let r2 = r2b.cast[Int]()
  let r3 = r3b.cast[Int]()
  let r4 = r4b.cast[Int]()

  var i = 0
  while i < ITERATIONS do
    x.offset(i).write(Slot { v: AtomicInt::new(0) })
    y.offset(i).write(Slot { v: AtomicInt::new(0) })
    z.offset(i).write(Slot { v: AtomicInt::new(0) })
    i = i + 1
  end

  let h0 = spawn(move || chain_t1(x))
  let h1 = spawn(move || chain_t2(x, y, r1))
  let h2 = spawn(move || chain_t3(y, z, r2))
  let h3 = spawn(move || chain_t4(z, x, r3, r4))

  match h0.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_seqcst_chain4: worker 0 failed with code " + code.to_string())
      return 10
    end
  when Result::Err(e) then
    println("atomic_litmus_seqcst_chain4: join 0 failed: " + e)
    return 11
  end

  match h1.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_seqcst_chain4: worker 1 failed with code " + code.to_string())
      return 12
    end
  when Result::Err(e) then
    println("atomic_litmus_seqcst_chain4: join 1 failed: " + e)
    return 13
  end

  match h2.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_seqcst_chain4: worker 2 failed with code " + code.to_string())
      return 14
    end
  when Result::Err(e) then
    println("atomic_litmus_seqcst_chain4: join 2 failed: " + e)
    return 15
  end

  match h3.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_seqcst_chain4: worker 3 failed with code " + code.to_string())
      return 16
    end
  when Result::Err(e) then
    println("atomic_litmus_seqcst_chain4: join 3 failed: " + e)
    return 17
  end

  # The forbidden outcome: the three-link chain fired but thread 4's
  # x-read went stale (a total-order / coherence violation).
  var forbidden = 0
  var chain_fired = 0
  i = 0
  while i < ITERATIONS do
    let a = r1.offset(i).read()
    let b = r2.offset(i).read()
    let c = r3.offset(i).read()
    let d = r4.offset(i).read()
    if a == 1 then
      chain_fired = chain_fired + 1
    end
    if a == 1 && b == 1 && c == 1 && d == 0 then
      forbidden = forbidden + 1
    end
    i = i + 1
  end

  _tg_mem_free(xb, bytes)
  _tg_mem_free(yb, bytes)
  _tg_mem_free(zb, bytes)
  _tg_mem_free(r1b, bytes)
  _tg_mem_free(r2b, bytes)
  _tg_mem_free(r3b, bytes)
  _tg_mem_free(r4b, bytes)

  if forbidden != 0 then
    println("atomic_litmus_seqcst_chain4: forbidden r1==1 && r2==1 && r3==1 && r4==0 observed " + forbidden.to_string() + " times of " + ITERATIONS.to_string())
    return 2
  end
  # The vacuous-pass guard: if thread 2 never observed the x-store, the
  # three-link chain never fired and the total order was never tested.
  if chain_fired == 0 then
    println("atomic_litmus_seqcst_chain4: vacuous run — the chain never fired over " + ITERATIONS.to_string() + " slots")
    return 3
  end
  0
end
