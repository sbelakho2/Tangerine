# tests/golden/test_visual_regression.tg — Golden/visual regression tests §21.3
use std::test::*
use std::gfx
use std::geom
use std::image

# --- Canonical golden image generation ---
# Each test renders a deterministic scene with SoftwareCanvas,
# then exports to PNG for visual comparison.
# Baseline images are stored per-platform in tests/golden/baselines/

# Visual diff threshold: 1 LSB tolerance (±1 per channel per pixel)
let TOLERANCE: u8 = 1u8

def pixel_diff(a: u8, b: u8) -> u8
  if a > b then a - b else b - a end
end

def images_match(a: Bitmap, b: Bitmap, tolerance: u8) -> bool
  if a.info.width != b.info.width || a.info.height != b.info.height
    return false
  end
  let i = 0
  while i < a.data.len()
    if pixel_diff(a.data[i], b.data[i]) > tolerance
      return false
    end
    i = i + 1
  end
  true
end

# --- Test: solid fill ---

@test
def test_golden_solid_red_fill_10x10() -> Unit
  let surface = gfx::create_software_surface(10, 10)
  let canvas = surface.begin_frame()
  let red = Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 }
  canvas.clear(red)
  surface.end_frame()
  # Extract pixel buffer and verify all pixels are red
  let bmp = surface.to_bitmap()
  assert_eq(bmp.info.width, 10)
  assert_eq(bmp.info.height, 10)
  # First pixel: R=255, G=0, B=0, A=255
  assert_true(bmp.data[0] >= 254u8)  # R
  assert_true(bmp.data[1] <= 1u8)    # G
  assert_true(bmp.data[2] <= 1u8)    # B
  assert_true(bmp.data[3] >= 254u8)  # A
end

# --- Test: gradient ---

@test
def test_golden_horizontal_linear_gradient() -> Unit
  let surface = gfx::create_software_surface(100, 10)
  let canvas = surface.begin_frame()
  let stops = [
    ColorStop { t: 0.0, color: Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 } },
    ColorStop { t: 1.0, color: Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 } }
  ]
  let start = Vec2 { x: 0.0, y: 0.0 }
  let end_pt = Vec2 { x: 100.0, y: 0.0 }
  let paint = gfx::linear_paint(start, end_pt, stops)
  canvas.fill_rect(Rect { x: 0.0, y: 0.0, w: 100.0, h: 10.0 }, paint)
  surface.end_frame()
  # Left edge should be dark, right edge should be bright
  let bmp = surface.to_bitmap()
  assert_true(bmp.data[0] < 10u8)  # Left R near 0
  let last_idx = (99 * 4)  # Last pixel R channel
  assert_true(bmp.data[last_idx] > 245u8)  # Right R near 255
end

# --- Test: clipping ---

@test
def test_golden_clip_rect_restricts_drawing() -> Unit
  let surface = gfx::create_software_surface(50, 50)
  let canvas = surface.begin_frame()
  let bg = Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  canvas.clear(bg)
  canvas.save()
  canvas.clip_rect(Rect { x: 10.0, y: 10.0, w: 20.0, h: 20.0 })
  let white = gfx::solid_paint(Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 })
  canvas.fill_rect(Rect { x: 0.0, y: 0.0, w: 50.0, h: 50.0 }, white)
  canvas.restore()
  surface.end_frame()
  let bmp = surface.to_bitmap()
  # Pixel at (5,5) should be black (outside clip)
  let idx = (5 * 50 + 5) * 4
  assert_true(bmp.data[idx] < 10u8)
  # Pixel at (15,15) should be white (inside clip)
  let idx2 = (15 * 50 + 15) * 4
  assert_true(bmp.data[idx2] > 245u8)
end

# --- Test: transform ---

@test
def test_golden_translated_rect() -> Unit
  let surface = gfx::create_software_surface(50, 50)
  let canvas = surface.begin_frame()
  let bg = Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  canvas.clear(bg)
  canvas.save()
  canvas.transform(geom::transform_translate(20.0, 20.0))
  let green = gfx::solid_paint(Color { r: 0.0, g: 1.0, b: 0.0, a: 1.0 })
  canvas.fill_rect(Rect { x: 0.0, y: 0.0, w: 10.0, h: 10.0 }, green)
  canvas.restore()
  surface.end_frame()
  let bmp = surface.to_bitmap()
  # Pixel at (25,25) should be green
  let idx = (25 * 50 + 25) * 4
  assert_true(bmp.data[idx + 1] > 245u8)  # G channel
end

# --- Anti-aliasing tolerance ---
# Note: SoftwareCanvas may or may not anti-alias. The tolerance of 1 LSB
# accommodates minor variations. Backend-specific golden images handle
# anti-aliasing differences by storing per-backend baselines.
