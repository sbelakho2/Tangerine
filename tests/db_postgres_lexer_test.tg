# tests/db_postgres_lexer_test.tg — the real driver lexer behind the
# std::db `?` -> $n placeholder translation (reviewer P0-17). The old
# quote-boolean toggle is replaced by the stateful PgLexState machine: the
# single-quoted strings (with the '' doubling), the double-quoted
# identifiers (with the "" doubling), the E'...' escape strings (the
# backslash escapes), the dollar-quoted bodies ($tag$ ... $tag$ — the tag
# is matched exactly), the -- line comments, the /* */ block comments
# (nesting), and the ?| / ?& jsonb operators. A `?` in ANY of those
# regions is data; a lone `?` is rewritten to $1..$n.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::db::{postgres_translate_placeholders}

def check_translation(sql: str, expected: str, expected_params: UInt) -> Unit
  let (out, count) = postgres_translate_placeholders(sql)
  assert_eq(out, expected.to_string())
  assert_eq(count, expected_params)
end

@test
def test_pg_lexer_plain_placeholders() -> Unit
  check_translation("SELECT * FROM t WHERE a = ? AND b = ?", "SELECT * FROM t WHERE a = $1 AND b = $2", 2)
  check_translation("INSERT INTO t (a, b) VALUES (?, ?)", "INSERT INTO t (a, b) VALUES ($1, $2)", 2)
end

@test
def test_pg_lexer_single_quotes() -> Unit
  check_translation("SELECT '?' FROM t WHERE a = ?", "SELECT '?' FROM t WHERE a = $1", 1)
  check_translation("SELECT 'it''s ?' , ?", "SELECT 'it''s ?' , $1", 1)
  check_translation("SELECT '' , ?", "SELECT '' , $1", 1)
end

@test
def test_pg_lexer_double_quotes() -> Unit
  check_translation("SELECT \"?\" FROM \"t?\" WHERE a = ?", "SELECT \"?\" FROM \"t?\" WHERE a = $1", 1)
  check_translation("SELECT \"a\"\"b\" FROM t WHERE x = ?", "SELECT \"a\"\"b\" FROM t WHERE x = $1", 1)
end

@test
def test_pg_lexer_escape_strings() -> Unit
  # E'...': the backslash escapes the quote — the ? stays inside.
  check_translation("SELECT E'\\' ?' , ?", "SELECT E'\\' ?' , $1", 1)
  # The '' doubling works inside E'' too.
  check_translation("SELECT E'it''s ?' , ?", "SELECT E'it''s ?' , $1", 1)
  # The lowercase e prefix.
  check_translation("SELECT e'\\' ?' , ?", "SELECT e'\\' ?' , $1", 1)
end

@test
def test_pg_lexer_dollar_quotes() -> Unit
  check_translation("SELECT $$? $1 ?$$ , ?", "SELECT $$? $1 ?$$ , $1", 1)
  check_translation("SELECT $tag$ ? $1 $tag$, ?", "SELECT $tag$ ? $1 $tag$, $1", 1)
  # The body may itself contain a $tag$ that only shares a prefix — it is
  # body data until the EXACT closing delimiter.
  check_translation("SELECT $t$ $tag$ ? $t$ , ?", "SELECT $t$ $tag$ ? $t$ , $1", 1)
  # A $tag$ inside the body re-opens a NEW dollar quote after the close —
  # everything after it is body data again.
  check_translation("SELECT $b$? $b$ $b$, ?", "SELECT $b$? $b$ $b$, ?", 0)
  # $1 positional markers are data, never dollar-quote openers.
  check_translation("SELECT $1 + ?", "SELECT $1 + $1", 1)
end

@test
def test_pg_lexer_line_comments() -> Unit
  check_translation("SELECT 1 -- ? comment\n, ?", "SELECT 1 -- ? comment\n, $1", 1)
end

@test
def test_pg_lexer_block_comments() -> Unit
  check_translation("SELECT /* ? */ ?, /* /* nested ? */ */ ?", "SELECT /* ? */ $1, /* /* nested ? */ */ $2", 2)
  # An unterminated comment swallows every trailing ?.
  check_translation("SELECT /* ? ?", "SELECT /* ? ?", 0)
end

@test
def test_pg_lexer_jsonb_operators() -> Unit
  check_translation("SELECT j ?| ARRAY['a','b'], j ?& ARRAY['a'], ?", "SELECT j ?| ARRAY['a','b'], j ?& ARRAY['a'], $1", 1)
end

@test
def test_pg_lexer_mixed_corpus() -> Unit
  check_translation(
    "INSERT INTO t VALUES (?, E'\\' ?', $tag$ ? ? $tag$, 'it''s ?', 1) -- ?\n/* ? */ ?",
    "INSERT INTO t VALUES ($1, E'\\' ?', $tag$ ? ? $tag$, 'it''s ?', 1) -- ?\n/* ? */ $2",
    2)
end
