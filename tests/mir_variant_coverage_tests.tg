# tests/mir_variant_coverage_tests.tg — the MIR variant coverage unit suite
# (the explicit unit-test oracle for tg_compiler/mir.tg's variant universe).
#
# The coverage oracle (scripts/check_variant_coverage.sh --domain mir)
# enumerates MirRvalueKind / MirTerminatorKind / Projection from mir.tg and
# attributes every variant to the tests that exercise it. THIS FILE is the
# explicit unit-test layer: every variant below is CONSTRUCTED (a value of
# the variant is built by hand), round-tripped through the compiler's own
# duplicate_* machinery, and its kind identity is ASSERTED through the
# exhaustive kind-name functions — a match arm that is never reached fails
# the suite, so a variant can never be "covered" by a dead match arm.
#
# The source-level companion (tests/mir_variant_specimens.tg) exercises the
# operations that PRODUCE the variants from source programs; the unit layer
# here closes the variants with no reliable source-level producer (the
# MirUnreachable placeholder terminator, the aggregate/closure payload
# shapes, ...) and pins every variant regardless of the lowering route.
#
# Run with the repo root as the working directory:
#   tg test tests/mir_variant_coverage_tests.tg

use std::core::{Option, Result}
use std::collections::Vec
use std::test::assert

use tg_compiler::mir::{
  MirRvalue, MirRvalueKind, MirTerminator, MirTerminatorKind, MirBinOp, MirUnOp,
  CastKind, AggregateKind, Projection, MirOperand, MirOperandKind, MirConstant,
  MirConstantKind, MirCallArg, MirCallValue, AssertMessage, SwitchTarget,
  MirContract, MirContractKind, duplicate_rvalue, duplicate_terminator,
  duplicate_projection, duplicate_aggregate_kind, duplicate_switch_target,
  duplicate_assert_message, duplicate_contract, operand_constant, operand_copy,
  place_local, mir_terminator_kind_name
}
use tg_compiler::ids::{
  MirLocalId, MirBlockId, TypeId, FieldId, VariantId, ClosureId, InstanceId,
  CallableId, DefId, ModuleId, IntrinsicId
}
use tg_compiler::types::{Type, AccessEffect}
use tg_compiler::token::span_dummy

# ———————————————————————————————————————————————————————————————
# Kind-identity functions (exhaustive matches — every arm names the
# variant it handles; the construction tests below call them with a value
# of EVERY variant, so every arm is reached and asserted).
# ———————————————————————————————————————————————————————————————

def mir_rvalue_kind_name(kind: MirRvalueKind) -> String
  match kind
  when MirRvalueKind::MirMove(_) then "MirMove"
  when MirRvalueKind::MirRef(_) then "MirRef"
  when MirRvalueKind::MirAggregate(_, _) then "MirAggregate"
  when MirRvalueKind::MirBinOp(_, _, _) then "MirBinOp"
  when MirRvalueKind::MirUnOp(_, _) then "MirUnOp"
  when MirRvalueKind::MirDiscriminant(_) then "MirDiscriminant"
  when MirRvalueKind::MirLen(_) then "MirLen"
  when MirRvalueKind::MirCast(_, _, _) then "MirCast"
  when MirRvalueKind::MirRepeat(_, _) then "MirRepeat"
  when MirRvalueKind::MirPhi(_) then "MirPhi"
  end
end

def mir_projection_kind_name(proj: Projection) -> String
  match proj
  when Projection::ProjDeref then "ProjDeref"
  when Projection::Field(_) then "Field"
  when Projection::Variant(_) then "Variant"
  when Projection::TupleIndex(_) then "TupleIndex"
  when Projection::ProjIndex(_) then "ProjIndex"
  when Projection::ProjConstantIndex(_) then "ProjConstantIndex"
  end
end

def mir_aggregate_kind_name(kind: AggregateKind) -> String
  match kind
  when AggregateKind::MirArray(_) then "MirArray"
  when AggregateKind::Tuple then "Tuple"
  when AggregateKind::Struct(_, _) then "Struct"
  when AggregateKind::Closure(_) then "Closure"
  when AggregateKind::Generator(_) then "Generator"
  end
end

def mir_assert_message_name(msg: AssertMessage) -> String
  match msg
  when AssertMessage::BoundsCheck(_, _) then "BoundsCheck"
  when AssertMessage::Overflow(_) then "Overflow"
  when AssertMessage::DivisionByZero then "DivisionByZero"
  when AssertMessage::RemainderByZero then "RemainderByZero"
  when AssertMessage::NullPointer then "NullPointer"
  when AssertMessage::ContractViolation(_) then "ContractViolation"
  end
end

# ———————————————————————————————————————————————————————————————
# Small value builders
# ———————————————————————————————————————————————————————————————

def mir_int_operand() -> MirOperand
  operand_constant(MirConstant { kind: MirConstantKind::MirInt(7), ty: Type::Int, instance: Option::None })
end

def mir_bool_operand(value: Bool) -> MirOperand
  operand_constant(MirConstant { kind: MirConstantKind::MirBool(value), ty: Type::Bool, instance: Option::None })
end

def mir_string_operand() -> MirOperand
  operand_constant(MirConstant { kind: MirConstantKind::MirString("s".to_string()), ty: Type::String, instance: Option::None })
end

def mir_place_operand() -> MirOperand
  operand_copy(place_local(MirLocalId { id: 0 }))
end

def mir_instance() -> InstanceId
  InstanceId {
    def: CallableId { def: DefId { module: ModuleId { id: 0 }, index: 0 } },
    substs: Vec::new()
  }
end

def assert_rvalue_identity(expected: String, rvalue: MirRvalue) -> Unit
  let name = mir_rvalue_kind_name(rvalue.kind)
  assert(name == expected, "rvalue kind name: expected " + expected + ", got " + name)
  let dup = duplicate_rvalue(rvalue)
  let dup_name = mir_rvalue_kind_name(dup.kind)
  assert(dup_name == expected, "duplicate_rvalue preserved kind: expected " + expected + ", got " + dup_name)
end

def assert_terminator_identity(expected: String, term: MirTerminator) -> Unit
  let name = mir_terminator_kind_name(term.kind)
  assert(name == expected, "terminator kind name: expected " + expected + ", got " + name)
  let dup = duplicate_terminator(term)
  let dup_name = mir_terminator_kind_name(dup.kind)
  assert(dup_name == expected, "duplicate_terminator preserved kind: expected " + expected + ", got " + dup_name)
end

# ———————————————————————————————————————————————————————————————
# MirRvalueKind — every variant constructed + duplicated + identity-asserted
# ———————————————————————————————————————————————————————————————

@test
def test_rvalue_mir_move() -> Unit
  let rv = MirRvalue { kind: MirRvalueKind::MirMove(mir_string_operand()) }
  assert_rvalue_identity("MirMove", rv)
end

@test
def test_rvalue_mir_ref() -> Unit
  let rv = MirRvalue { kind: MirRvalueKind::MirRef(place_local(MirLocalId { id: 2 })) }
  assert_rvalue_identity("MirRef", rv)
end

@test
def test_rvalue_mir_aggregate_array() -> Unit
  let rv = MirRvalue {
    kind: MirRvalueKind::MirAggregate(
      AggregateKind::MirArray(Type::Int),
      Vec::from([mir_int_operand(), mir_int_operand()]))
  }
  assert_rvalue_identity("MirAggregate", rv)
  assert(mir_aggregate_kind_name(AggregateKind::MirArray(Type::Int)) == "MirArray", "aggregate kind MirArray")
end

@test
def test_rvalue_mir_aggregate_tuple() -> Unit
  let rv = MirRvalue { kind: MirRvalueKind::MirAggregate(AggregateKind::Tuple, Vec::from([mir_int_operand()])) }
  assert_rvalue_identity("MirAggregate", rv)
  assert(mir_aggregate_kind_name(AggregateKind::Tuple) == "Tuple", "aggregate kind Tuple")
end

@test
def test_rvalue_mir_aggregate_struct() -> Unit
  let rv = MirRvalue {
    kind: MirRvalueKind::MirAggregate(
      AggregateKind::Struct(TypeId { id: 100 }, Vec::from(["x".to_string()])),
      Vec::from([mir_int_operand()]))
  }
  assert_rvalue_identity("MirAggregate", rv)
  assert(mir_aggregate_kind_name(AggregateKind::Struct(TypeId { id: 100 }, Vec::new())) == "Struct", "aggregate kind Struct")
end

@test
def test_rvalue_mir_aggregate_closure() -> Unit
  let rv = MirRvalue {
    kind: MirRvalueKind::MirAggregate(AggregateKind::Closure(ClosureId { id: 5 }), Vec::new())
  }
  assert_rvalue_identity("MirAggregate", rv)
  assert(mir_aggregate_kind_name(AggregateKind::Closure(ClosureId { id: 5 })) == "Closure", "aggregate kind Closure")
end

@test
def test_rvalue_mir_aggregate_generator() -> Unit
  let rv = MirRvalue {
    kind: MirRvalueKind::MirAggregate(AggregateKind::Generator(TypeId { id: 101 }), Vec::new())
  }
  assert_rvalue_identity("MirAggregate", rv)
  assert(mir_aggregate_kind_name(AggregateKind::Generator(TypeId { id: 101 })) == "Generator", "aggregate kind Generator")
end

@test
def test_rvalue_mir_binop() -> Unit
  let rv = MirRvalue { kind: MirRvalueKind::MirBinOp(MirBinOp::Add, mir_int_operand(), mir_int_operand()) }
  assert_rvalue_identity("MirBinOp", rv)
end

@test
def test_rvalue_mir_unop() -> Unit
  let rv = MirRvalue { kind: MirRvalueKind::MirUnOp(MirUnOp::Neg, mir_int_operand()) }
  assert_rvalue_identity("MirUnOp", rv)
end

@test
def test_rvalue_mir_discriminant() -> Unit
  let rv = MirRvalue { kind: MirRvalueKind::MirDiscriminant(place_local(MirLocalId { id: 3 })) }
  assert_rvalue_identity("MirDiscriminant", rv)
end

@test
def test_rvalue_mir_len() -> Unit
  let rv = MirRvalue { kind: MirRvalueKind::MirLen(place_local(MirLocalId { id: 4 })) }
  assert_rvalue_identity("MirLen", rv)
end

@test
def test_rvalue_mir_cast() -> Unit
  let rv = MirRvalue { kind: MirRvalueKind::MirCast(CastKind::IntToFloat, mir_int_operand(), Type::Float) }
  assert_rvalue_identity("MirCast", rv)
end

@test
def test_rvalue_mir_repeat() -> Unit
  let rv = MirRvalue { kind: MirRvalueKind::MirRepeat(mir_int_operand(), 4) }
  assert_rvalue_identity("MirRepeat", rv)
end

@test
def test_rvalue_mir_phi() -> Unit
  let rv = MirRvalue {
    kind: MirRvalueKind::MirPhi(Vec::from([
      (MirBlockId { id: 1 }, MirLocalId { id: 2 }),
      (MirBlockId { id: 3 }, MirLocalId { id: 4 })
    ]))
  }
  assert_rvalue_identity("MirPhi", rv)
end

# ———————————————————————————————————————————————————————————————
# MirTerminatorKind — every variant constructed + duplicated + asserted
# ———————————————————————————————————————————————————————————————

@test
def test_terminator_mir_goto() -> Unit
  let t = MirTerminator { kind: MirTerminatorKind::MirGoto(MirBlockId { id: 9 }), span: span_dummy() }
  assert_terminator_identity("MirGoto", t)
end

@test
def test_terminator_mir_return() -> Unit
  let t = MirTerminator { kind: MirTerminatorKind::MirReturn, span: span_dummy() }
  assert_terminator_identity("MirReturn", t)
end

@test
def test_terminator_mir_unreachable() -> Unit
  let t = MirTerminator { kind: MirTerminatorKind::MirUnreachable, span: span_dummy() }
  assert_terminator_identity("MirUnreachable", t)
end

@test
def test_terminator_mir_switch_int() -> Unit
  let targets = Vec::from([
    SwitchTarget { value: 0, target: MirBlockId { id: 5 } },
    SwitchTarget { value: 1, target: MirBlockId { id: 6 } }
  ])
  let t = MirTerminator {
    kind: MirTerminatorKind::MirSwitchInt {
      op: mir_int_operand(),
      targets: targets,
      default_target: MirBlockId { id: 7 }
    },
    span: span_dummy()
  }
  assert_terminator_identity("MirSwitchInt", t)
  let dup_t = duplicate_switch_target(SwitchTarget { value: 3, target: MirBlockId { id: 8 } })
  assert(dup_t.value == 3 && dup_t.target.id == 8, "duplicate_switch_target payload")
end

@test
def test_terminator_mir_call() -> Unit
  let args = Vec::from([
    MirCallArg { effect: AccessEffect::Read, value: MirCallValue::Value(mir_place_operand()) },
    MirCallArg { effect: AccessEffect::Consume, value: MirCallValue::Place(place_local(MirLocalId { id: 6 })) }
  ])
  let t = MirTerminator {
    kind: MirTerminatorKind::MirCall {
      dest: place_local(MirLocalId { id: 1 }),
      func: mir_place_operand(),
      args: args,
      success: MirBlockId { id: 2 },
      unwind: Option::Some(MirBlockId { id: 3 }),
      intrinsic: Option::Some(IntrinsicId::ArrayLen)
    },
    span: span_dummy()
  }
  assert_terminator_identity("MirCall", t)
end

@test
def test_terminator_mir_assert_bounds() -> Unit
  let t = MirTerminator {
    kind: MirTerminatorKind::MirAssert {
      cond: mir_int_operand(),
      expected: true,
      msg: AssertMessage::BoundsCheck(mir_int_operand(), mir_int_operand()),
      target: MirBlockId { id: 4 },
      unwind: Option::None
    },
    span: span_dummy()
  }
  assert_terminator_identity("MirAssert", t)
  let dup_msg = duplicate_assert_message(AssertMessage::BoundsCheck(mir_int_operand(), mir_int_operand()))
  assert(mir_assert_message_name(dup_msg) == "BoundsCheck", "assert message BoundsCheck")
end

@test
def test_terminator_mir_assert_overflow() -> Unit
  let t = MirTerminator {
    kind: MirTerminatorKind::MirAssert {
      cond: mir_bool_operand(true),
      expected: false,
      msg: AssertMessage::Overflow(MirBinOp::Add),
      target: MirBlockId { id: 4 },
      unwind: Option::Some(MirBlockId { id: 5 })
    },
    span: span_dummy()
  }
  assert_terminator_identity("MirAssert", t)
  assert(mir_assert_message_name(AssertMessage::Overflow(MirBinOp::Sub)) == "Overflow", "assert message Overflow")
end

@test
def test_terminator_mir_assert_div_zero() -> Unit
  let t = MirTerminator {
    kind: MirTerminatorKind::MirAssert {
      cond: mir_bool_operand(true),
      expected: true,
      msg: AssertMessage::DivisionByZero,
      target: MirBlockId { id: 4 },
      unwind: Option::None
    },
    span: span_dummy()
  }
  assert_terminator_identity("MirAssert", t)
  assert(mir_assert_message_name(AssertMessage::DivisionByZero) == "DivisionByZero", "assert message DivisionByZero")
  assert(mir_assert_message_name(AssertMessage::RemainderByZero) == "RemainderByZero", "assert message RemainderByZero")
  assert(mir_assert_message_name(AssertMessage::NullPointer) == "NullPointer", "assert message NullPointer")
  assert(mir_assert_message_name(AssertMessage::ContractViolation("m".to_string())) == "ContractViolation", "assert message ContractViolation")
end

@test
def test_terminator_mir_abort() -> Unit
  let t = MirTerminator { kind: MirTerminatorKind::MirAbort, span: span_dummy() }
  assert_terminator_identity("MirAbort", t)
end

@test
def test_terminator_mir_deinit() -> Unit
  let t = MirTerminator {
    kind: MirTerminatorKind::MirDeinit {
      place: place_local(MirLocalId { id: 0 }),
      deinit_fn: mir_instance(),
      target: MirBlockId { id: 1 },
      unwind: Option::None
    },
    span: span_dummy()
  }
  assert_terminator_identity("MirDeinit", t)
end

# ———————————————————————————————————————————————————————————————
# Projection — every variant constructed + duplicated + asserted
# ———————————————————————————————————————————————————————————————

@test
def test_projection_deref() -> Unit
  let p = Projection::ProjDeref
  assert(mir_projection_kind_name(p) == "ProjDeref", "projection ProjDeref")
  let dup = duplicate_projection(p)
  assert(mir_projection_kind_name(dup) == "ProjDeref", "duplicate_projection ProjDeref")
end

@test
def test_projection_field() -> Unit
  let p = Projection::Field(FieldId { owner: TypeId { id: 100 }, index: 1 })
  assert(mir_projection_kind_name(p) == "Field", "projection Field")
  let dup = duplicate_projection(p)
  assert(mir_projection_kind_name(dup) == "Field", "duplicate_projection Field")
  match dup
  when Projection::Field(fid) then
    assert(fid.owner.id == 100 && fid.index == 1, "duplicate_projection Field payload")
  when _ then ()
  end
end

@test
def test_projection_variant() -> Unit
  let p = Projection::Variant(VariantId { owner: TypeId { id: 101 }, index: 0 })
  assert(mir_projection_kind_name(p) == "Variant", "projection Variant")
  let dup = duplicate_projection(p)
  assert(mir_projection_kind_name(dup) == "Variant", "duplicate_projection Variant")
end

@test
def test_projection_tuple_index() -> Unit
  let p = Projection::TupleIndex(2)
  assert(mir_projection_kind_name(p) == "TupleIndex", "projection TupleIndex")
  let dup = duplicate_projection(p)
  assert(mir_projection_kind_name(dup) == "TupleIndex", "duplicate_projection TupleIndex")
  match dup
  when Projection::TupleIndex(idx) then assert(idx == 2, "duplicate_projection TupleIndex payload")
  when _ then ()
  end
end

@test
def test_projection_proj_index() -> Unit
  let p = Projection::ProjIndex(MirLocalId { id: 7 })
  assert(mir_projection_kind_name(p) == "ProjIndex", "projection ProjIndex")
  let dup = duplicate_projection(p)
  assert(mir_projection_kind_name(dup) == "ProjIndex", "duplicate_projection ProjIndex")
  match dup
  when Projection::ProjIndex(id) then assert(id.id == 7, "duplicate_projection ProjIndex payload")
  when _ then ()
  end
end

@test
def test_projection_proj_constant_index() -> Unit
  let p = Projection::ProjConstantIndex(3)
  assert(mir_projection_kind_name(p) == "ProjConstantIndex", "projection ProjConstantIndex")
  let dup = duplicate_projection(p)
  assert(mir_projection_kind_name(dup) == "ProjConstantIndex", "duplicate_projection ProjConstantIndex")
end

# ———————————————————————————————————————————————————————————————
# The agentic payloads (MirContract / MirContractKind) — constructed,
# duplicated, asserted.
# ———————————————————————————————————————————————————————————————

@test
def test_mir_contract_pre() -> Unit
  let c = MirContract {
    kind: MirContractKind::Pre,
    condition: mir_bool_operand(true),
    message: "pre".to_string(),
    span: span_dummy()
  }
  let dup = duplicate_contract(c)
  assert(dup.message == "pre", "duplicate_contract message")
  match dup.kind
  when MirContractKind::Pre then ()
  when _ then assert(false, "duplicate_contract preserved Pre")
  end
end
