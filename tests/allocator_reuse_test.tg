# tests/allocator_reuse_test.tg — Free-list reuse proof.
#
# Direct _tg_mem_alloc/_tg_mem_free pairing at the runtime boundary: after
# alloc(32) -> free, the next alloc(32) must return the SAME block (the
# per-class LIFO free list pops the block that was just linked in), and
# the outstanding-bytes counter must stay flat across the free (free-list
# blocks count as freed at the moment they are linked in).

use std::core

extern def _tg_mem_alloc(size: UInt) -> Ptr[u8]
extern def _tg_mem_free(ptr: Ptr[u8], size: UInt) -> Unit
extern def tg_allocator_outstanding_bytes() -> Int

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  let before = tg_allocator_outstanding_bytes()

  let p1 = _tg_mem_alloc(32 as UInt)
  if p1.is_null() then
    return 1
  end
  # 32 bytes -> class 32: exactly 32 outstanding bytes.
  let mid = tg_allocator_outstanding_bytes()
  if mid != before + 32 then
    println("allocator_reuse: outstanding after alloc = " + mid.to_string() + " expected " + (before + 32).to_string())
    return 2
  end

  _tg_mem_free(p1, 32 as UInt)
  let after_free = tg_allocator_outstanding_bytes()
  if after_free != before then
    println("allocator_reuse: outstanding after free = " + after_free.to_string() + " expected " + before.to_string())
    return 3
  end

  let p2 = _tg_mem_alloc(32 as UInt)
  if p2.is_null() then
    return 4
  end
  # The allocator capacity must be reusable: the free list hands back the
  # exact block that was just freed.
  if p1 as Int != p2 as Int then
    println("allocator_reuse: block not reused (p1=" + (p1 as Int).to_string() + " p2=" + (p2 as Int).to_string() + ")")
    return 5
  end
  let after2 = tg_allocator_outstanding_bytes()
  if after2 != before + 32 then
    println("allocator_reuse: outstanding after reuse = " + after2.to_string() + " expected " + (before + 32).to_string())
    return 6
  end

  _tg_mem_free(p2, 32 as UInt)
  0
end
