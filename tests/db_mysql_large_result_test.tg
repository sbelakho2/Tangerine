# tests/db_mysql_large_result_test.tg — the prepared-statement fetch
# path's LARGE-VALUE handling (reviewer P0-17): the initial 64KiB output
# buffers, the MYSQL_DATA_TRUNCATED detection, the length observation
# (the length cell carries the FULL value length), the buffer resize, and
# the mysql_stmt_fetch_column refetch through the shim. The boundary
# cases: 64KiB-1 (fits the initial buffer), 64KiB (exactly the initial
# buffer — no truncation), 64KiB+1 (the first truncation + refetch),
# 1MiB, and multi-MiB (3MiB); plus the embedded NUL bytes. Every value
# round-trips byte-exact. The SELECTs are parameterized (WHERE id = ?)
# so they run through the prepared-statement fetch path.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::db::{mysql_config_new, mysql_open, Connection, ToSqlParam}

def blob_of(size: UInt, marker: u8) -> Vec[u8]
  var b = Vec::with_capacity(size as Int)
  var i: UInt = 0
  while i < size do
    b.push(marker)
    i = i + 1
  end
  b
end

@test
def test_mysql_large_result_fetch_boundaries() -> Unit
  let cfg = mysql_config_new("127.0.0.1", "root", "root", "test")
  let db = mysql_open(cfg)
  let mut c = assert_ok(db)

  let rc = c.execute("CREATE TABLE kv_big (id INT AUTO_INCREMENT PRIMARY KEY, data LONGBLOB)", &[])
  assert_ok(rc)

  let sizes = Vec::from([65535, 65536, 65537, 1048576, 3145728])
  var expected = Vec::new()
  var id = 1
  for size in sizes do
    let blob = blob_of(size as UInt, (id + 7) as u8)
    let ri = c.execute("INSERT INTO kv_big (data) VALUES (?)", &[Box::new(blob.clone()) as Box[dyn ToSqlParam]])
    assert_ok(ri)
    expected.push(blob)
    id = id + 1
  end

  # The parameterized SELECT runs through the prepared-statement fetch
  # path (the 64KiB initial buffers + the truncation refetch).
  var i = 0
  while i < expected.len() do
    let idv = (i + 1) as i64
    let rows = c.query("SELECT data FROM kv_big WHERE id = ?", &[Box::new(idv) as Box[dyn ToSqlParam]])
    let r = assert_ok(rows)
    assert_eq(r.row_count(), 1)
    let row = r.into_iter().next()
    match row
    when Option::Some(row) then
      let b: Vec[u8] = row.get(0).ok().unwrap_or(Vec::new())
      assert_eq(b.len(), expected[i].len())
      var k = 0
      while k < expected[i].len() do
        assert_eq(b[k], expected[i][k])
        k = k + 1
      end
    when Option::None then
      assert_false(true)
    end
    i = i + 1
  end
end

# The embedded NUL bytes in a >64KiB value: the truncation refetch must
# keep them byte-exact.
@test
def test_mysql_large_result_embedded_nuls() -> Unit
  let cfg = mysql_config_new("127.0.0.1", "root", "root", "test")
  let db = mysql_open(cfg)
  let mut c = assert_ok(db)

  let rc = c.execute("CREATE TABLE kv_nuls (id INT AUTO_INCREMENT PRIMARY KEY, data LONGBLOB)", &[])
  assert_ok(rc)

  var blob = Vec::new()
  var i = 0
  while i < 70000 do
    if i % 2 == 0 then
      blob.push(0 as u8)
    else
      blob.push((i % 251) as u8)
    end
    i = i + 1
  end

  let ri = c.execute("INSERT INTO kv_nuls (data) VALUES (?)", &[Box::new(blob.clone()) as Box[dyn ToSqlParam]])
  assert_ok(ri)

  let rows = c.query("SELECT data FROM kv_nuls WHERE id = ?", &[Box::new(1i64) as Box[dyn ToSqlParam]])
  let r = assert_ok(rows)
  assert_eq(r.row_count(), 1)
  let row = r.into_iter().next()
  match row
  when Option::Some(row) then
    let b: Vec[u8] = row.get(0).ok().unwrap_or(Vec::new())
    assert_eq(b.len(), blob.len())
    var k = 0
    while k < blob.len() do
      assert_eq(b[k], blob[k])
      k = k + 1
    end
  when Option::None then
    assert_false(true)
  end
end
