## The cocoa FFI smoke canary — the real ObjC round trip (macOS host).
## get_nsstring / nsstring_to_string go through objc_getClass /
## sel_registerName / objc_msgSend (the Mach-O import stubs).

use std::core::{Option, Result, Unit, Bool}
use std::cocoa::{get_nsstring, nsstring_to_string, NSString, NSObject}
use std::test::*

@test
def test_cocoa_nsstring_round_trip() -> Unit
  let ns = get_nsstring("tangerine")
  let back = nsstring_to_string(ns)
  if back != "tangerine" then
    panic("cocoa round trip failed: got " + back)
  end
end

@test
def test_cocoa_nsstring_unicode() -> Unit
  let ns = get_nsstring("héllo wörld")
  let back = nsstring_to_string(ns)
  if back != "héllo wörld" then
    panic("cocoa unicode round trip failed: got " + back)
  end
end
