## The platform-only surfaces' smoke suite — the real FFI bindings and
## the pure surface behavior, host-side:
##   - cocoa: the REAL ObjC FFI round trip (objc_getClass /
##     sel_registerName / objc_msgSend via the Mach-O import stubs) —
##     the macOS host smoke;
##   - windows: the pure Win32 surface helpers (the wide-string bridge
##     round trip, the message-box no-op on the non-Windows host);
##   - android: the pure JNI surface (the version constants, the
##     device-density no-op on the non-Android host);
##   - ios: the pure platform helpers (the device-name/version no-ops on
##     the non-iOS host).
## The FFI declarations themselves (the kernel32/user32/objc/JNI extern
## sets) are the compiled bindings — every declared extern is resolved at
## link time against the platform library surface.

use std::core::{Option, Result, Unit, Bool, Int, UInt}
use std::test::*

@test
def test_windows_wide_string_round_trip() -> Unit
  ## The wide-string encode is pure string logic — testable on any host.
  let wide = to_wide_string("hello windows")
  var back = String::new()
  var i = 0
  while i < wide.len() && wide[i] != 0 do
    back.push(wide[i] as Char)
    i = i + 1
  end
  if back != "hello windows" then
    panic("windows wide-string round trip failed: got " + back)
  end
end

@test
def test_windows_version_surface() -> Unit
  ## On the non-Windows host the version helper reports the empty string.
  let v = get_windows_version()
  if v != "" then
    panic("windows version surface must be empty off-Windows")
  end
end

@test
def test_android_density_surface() -> Unit
  ## The non-Android host reports the density no-op.
  let d = get_device_density()
  if d != 1.0 then
    panic("android density surface must be the no-op off-Android")
  end
end

@test
def test_ios_platform_helpers() -> Unit
  if is_ios_device() then
    panic("ios device probe must be false off-iOS")
  end
  let name = get_ios_device_name()
  if name != "" then
    panic("ios device name must be empty off-iOS")
  end
end

@test
def test_cocoa_nsstring_round_trip() -> Unit
  ## The REAL Cocoa FFI smoke (the macOS host): the NSString bridge.
  let ns = get_nsstring("tangerine")
  let back = nsstring_to_string(ns)
  if back != "tangerine" then
    panic("cocoa round trip failed: got " + back)
  end
end

@test
def test_cocoa_nsstring_unicode() -> Unit
  let ns = get_nsstring("héllo wörld")
  let back = nsstring_to_string(ns)
  if back != "héllo wörld" then
    panic("cocoa unicode round trip failed: got " + back)
  end
end
