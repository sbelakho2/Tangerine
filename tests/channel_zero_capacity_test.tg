# tests/channel_zero_capacity_test.tg — the channel(0) rejection
# (reviewer item 16): a zero-capacity bounded channel is rejected with
# the explicit documented error — the real rendezvous semantics are the
# documented future work, and a sender with no buffer slot would deadlock
# the cooperative runtime.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*

# THE REJECTION: channel[Int](0) panics with the explicit capacity
# error instead of silently building the impossible zero-slot channel.
@test
def test_channel_zero_capacity_rejected() -> Unit
  let msg = assert_panics(|| {
    let _ = std::async::channel[Int](0)
  })
  assert_true(msg.contains("capacity"))
  assert_true(msg.contains("0"))
end

# THE POSITIVE CONTROL: the capacity-one channel still constructs (the
# rejection is specific to the zero capacity, never the bounded channel
# itself).
@test
def test_channel_capacity_one_accepted() -> Unit
  let (sender, receiver) = std::async::channel[Int](1)
  let _ = sender
  let _ = receiver
end
