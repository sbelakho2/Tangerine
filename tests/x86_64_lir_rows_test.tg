@test
def test_x86_vector_opcode_table_rows() -> Unit
  let add_i8 = x86_vec_binop_opcode(LirVecBinOp::LirVecAdd, "i8")
  assert_true(add_i8.is_ok())
  match add_i8
  when Result::Ok(pr) then assert_true(pr.0 == 0x66 && pr.1 == 0xFC)
  when Result::Err(_) then ()
  end
  let add_f64 = x86_vec_binop_opcode(LirVecBinOp::LirVecAdd, "f64")
  assert_true(add_f64.is_ok())
  match add_f64
  when Result::Ok(pr) then assert_true(pr.0 == 0x66 && pr.1 == 0x58)
  when Result::Err(_) then ()
  end
  let sub_u32 = x86_vec_binop_opcode(LirVecBinOp::LirVecSub, "u32")
  assert_true(sub_u32.is_ok())
  match sub_u32
  when Result::Ok(pr) then assert_true(pr.0 == 0x66 && pr.1 == 0xFA)
  when Result::Err(_) then ()
  end
  let mul_i16 = x86_vec_binop_opcode(LirVecBinOp::LirVecMul, "i16")
  assert_true(mul_i16.is_ok())
  let mul_f32 = x86_vec_binop_opcode(LirVecBinOp::LirVecMul, "f32")
  assert_true(mul_f32.is_ok())
  assert_true(x86_vec_binop_opcode(LirVecBinOp::LirVecMul, "i8").is_err())
  assert_true(x86_vec_binop_opcode(LirVecBinOp::LirVecMul, "i32").is_err())
  assert_true(x86_vec_binop_opcode(LirVecBinOp::LirVecMul, "i64").is_err())
  let lane128 = LirVectorLane { elem_kind: "i32".to_string(), lanes: 4, bits: 128 }
  assert_true(x86_validate_vec_lane("f", lane128).is_ok())
  let lane256 = LirVectorLane { elem_kind: "i32".to_string(), lanes: 8, bits: 256 }
  assert_true(x86_validate_vec_lane("f", lane256).is_err())
end

@test
def test_x86_atomic_authority_rows() -> Unit
  assert_true(atomic_support(x86_64_desc(), 1, "rmw", "seq_cst") == AtomicSupport::Native)
  assert_true(atomic_support(x86_64_desc(), 2, "rmw", "seq_cst") == AtomicSupport::Native)
  assert_true(atomic_support(x86_64_desc(), 4, "rmw", "seq_cst") == AtomicSupport::Native)
  assert_true(atomic_support(x86_64_desc(), 8, "rmw", "seq_cst") == AtomicSupport::Native)
  assert_true(atomic_support(x86_64_desc(), 16, "rmw", "seq_cst") == AtomicSupport::Unsupported)
  assert_true(x86_validate_atomic_width("f", 1, "x").is_ok())
  assert_true(x86_validate_atomic_width("f", 8, "x").is_ok())
  assert_true(x86_validate_atomic_width("f", 16, "x").is_err())
end

@test
def test_x86_sized_memory_atomic_encoding_rows() -> Unit
  x86_row_check("movzx rax, word [rdi]", x86_movzx_r64_m16(X64::RAX, X64::RDI, 0),
    Vec::from([0x48, 0x0F, 0xB7, 0x07]))
  x86_row_check("mov eax, [rdi]", x86_mov_r32_rm(X64::RAX, X64::RDI, 0),
    Vec::from([0x8B, 0x07]))
  x86_row_check("mov [rdi], al", x86_mov_m8_r8(X64::RDI, 0, X64::RAX),
    Vec::from([0x88, 0x07]))
  x86_row_check("mov [rdi], ax", x86_mov_m16_r16(X64::RDI, 0, X64::RAX),
    Vec::from([0x66, 0x89, 0x07]))
  x86_row_check("mov [rdi], eax", x86_mov_m32_r32(X64::RDI, 0, X64::RAX),
    Vec::from([0x89, 0x07]))
  x86_row_check("movb r10b, [rax]", x86_mov_m8_r8(X64::RAX, 0, X64::R10),
    Vec::from([0x44, 0x88, 0x10]))
  x86_row_check("xchg [rdi], rcx", x86_xchg_rm(8, X64::RDI, 0, X64::RCX),
    Vec::from([0x48, 0x87, 0x0F]))
  x86_row_check("xchg [rdi], cl", x86_xchg_rm(1, X64::RDI, 0, X64::RCX),
    Vec::from([0x86, 0x0F]))
  x86_row_check("lock xadd [rdi], rcx", x86_lock_xadd(8, X64::RDI, 0, X64::RCX),
    Vec::from([0xF0, 0x48, 0x0F, 0xC1, 0x0F]))
  x86_row_check("lock xadd [rdi], ecx", x86_lock_xadd(4, X64::RDI, 0, X64::RCX),
    Vec::from([0xF0, 0x0F, 0xC1, 0x0F]))
  x86_row_check("lock cmpxchg [rdi], rcx", x86_lock_cmpxchg(8, X64::RDI, 0, X64::RCX),
    Vec::from([0xF0, 0x48, 0x0F, 0xB1, 0x0F]))
  x86_row_check("lock cmpxchg [rdi], cl", x86_lock_cmpxchg(1, X64::RDI, 0, X64::RCX),
    Vec::from([0xF0, 0x0F, 0xB0, 0x0F]))
  x86_row_check("mfence", x86_mfence(), Vec::from([0x0F, 0xAE, 0xF0]))
  x86_row_check("mov rax, [rip+0]", x86_mov_rm_rip(X64::RAX),
    Vec::from([0x48, 0x8B, 0x05, 0x00, 0x00, 0x00, 0x00]))
  x86_row_check("and qword [rbp-24], 1", x86_alu_rmi8(4, X64::RBP, -24, 1),
    Vec::from([0x48, 0x83, 0x65, 0xE8, 0x01]))
  x86_row_check("or rax, [rbp-24]", x86_alu_rm(0x0B, X64::RAX, X64::RBP, -24),
    Vec::from([0x48, 0x0B, 0x45, 0xE8]))
  x86_row_check("and rcx, r11", x86_alu_rr_w(8, 0x21, X64::RCX, X64::R11),
    Vec::from([0x4C, 0x21, 0xD9]))
  x86_row_check("and ecx, r11d", x86_alu_rr_w(4, 0x21, X64::RCX, X64::R11),
    Vec::from([0x44, 0x21, 0xD9]))
  x86_row_check("and cx, r11w", x86_alu_rr_w(2, 0x21, X64::RCX, X64::R11),
    Vec::from([0x66, 0x44, 0x21, 0xD9]))
  x86_row_check("and cl, r11b", x86_alu_rr_w(1, 0x21, X64::RCX, X64::R11),
    Vec::from([0x44, 0x20, 0xD9]))
  x86_row_check("or rcx, r11", x86_alu_rr_w(8, 0x09, X64::RCX, X64::R11),
    Vec::from([0x4C, 0x09, 0xD9]))
  x86_row_check("xor rcx, r11", x86_alu_rr_w(8, 0x31, X64::RCX, X64::R11),
    Vec::from([0x4C, 0x31, 0xD9]))
end

@test
def test_x86_fp_register_model_rows() -> Unit
  assert_true(x86_fixed_fp_code(8) == 0)
  assert_true(x86_fixed_fp_code(15) == 7)
  assert_true(x86_fp_phys_of(108) == 8)
  assert_true(x86_fp_scratch() == 15)
  let pool = x86_fp_pool_ids()
  assert_true(pool.len() == 7)
  assert_true(pool[0] == 108)
  assert_true(pool[6] == 114)
end

def x86_row_static_int(name: String, v: Int) -> MirStatic
  MirStatic {
    name: name,
    ty: Type::Int,
    init: Option::Some(MirOperand {
      kind: MirOperandKind::MirConstant(MirConstant {
        kind: MirConstantKind::MirInt(v),
        ty: Type::Int,
        instance: Option::None
      })
    }),
    is_mut: false
  }
end

def x86_row_static_uninit(name: String) -> MirStatic
  MirStatic {
    name: name,
    ty: Type::Int,
    init: Option::None,
    is_mut: false
  }
end

@test
def test_x86_static_emission_rows() -> Unit
  var xe = x86_emit_new()
  let s1 = x86_row_static_int("row_s1", 7)
  let s2 = x86_row_static_uninit("row_s2")
  assert_true(x86_emit_static(xe, s1).is_ok())
  assert_true(x86_emit_static(xe, s2).is_ok())
  assert_true(xe.data.len() == 8)
  assert_true((xe.data[0] as Int) == 7)
  assert_true((xe.data[1] as Int) == 0)
  assert_true(xe.bss_size == 8)
  let datas = x86_collect_datas(xe)
  assert_true(datas.len() == 2)
  assert_true(datas[0].0 == "row_s1" && datas[0].1 == 0 && datas[0].2 == 8 && datas[0].3 == 0)
  assert_true(datas[1].0 == "row_s2" && datas[1].1 == 0 && datas[1].2 == 8 && datas[1].3 == 1)
  let sfloat = MirStatic {
    name: "row_sf".to_string(),
    ty: Type::F64,
    init: Option::None,
    is_mut: false
  }
  assert_true(x86_emit_static(xe, sfloat).is_err())
end

@test
def test_x86_elf_data_section_rows() -> Unit
  let code = Vec::from([0x90])
  let data = Vec::from([1, 2, 3, 4, 5, 6, 7, 8])
  var fns: Vec[(String, Int)] = Vec::new()
  fns.push(("row_fn".to_string(), 0))
  var datas: Vec[(String, Int, Int, Int)] = Vec::new()
  datas.push(("row_st".to_string(), 0, 8, 0))
  let obj = x86_elf64_obj(code, data, fns, datas, 16, Vec::new(), Vec::new())
  assert_true(obj.len() > 128)
  assert_true((obj[0] as Int) == 0x7F && (obj[1] as Int) == 0x45 && (obj[2] as Int) == 0x4C && (obj[3] as Int) == 0x46)
  # e_machine (offset 18) = 62, e_shnum (60) = 6, e_shstrndx (62) = 1.
  assert_true((obj[18] as Int) + ((obj[19] as Int) << 8) == 62)
  assert_true((obj[60] as Int) + ((obj[61] as Int) << 8) == 6)
  assert_true((obj[62] as Int) + ((obj[63] as Int) << 8) == 1)
  # .data starts at align8(64 + code.len()) = 72; the eight bytes appear.
  assert_true((obj[72] as Int) == 1 && (obj[79] as Int) == 8)
end
