  x86_row_check("psubd xmm0, xmm1", x86_psubd_rr(0, 1),
    Vec::from([0x66, 0x0F, 0xFA, 0xC1]))
  x86_row_check("psubq xmm0, xmm1", x86_psubq_rr(0, 1),
