  x86_alu_rr32,
  x86_cvtsi2sd_rr, x86_cvtsi2ss_rr, x86_cvttsd2si_rr, x86_cvttss2si_rr,
  x86_cvtsd2ss_rr, x86_cvtss2sd_rr,
  x86_movq_xmm_r64, x86_movq_r64_xmm, x86_movd_xmm_r32, x86_movd_r32_xmm,
  x86_xorps_rr, x86_xorpd_rr,
  x86_pand_rr, x86_por_rr, x86_pxor_rr,
