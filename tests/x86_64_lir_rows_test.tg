  x86_row_check("addps xmm0, xmm1", x86_addps_rr(0, 1),
    Vec::from([0x0F, 0x58, 0xC1]))
  x86_row_check("addpd xmm0, xmm1", x86_addpd_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x58, 0xC1]))
  x86_row_check("mulps xmm0, xmm1", x86_mulps_rr(0, 1),
    Vec::from([0x0F, 0x59, 0xC1]))
  x86_row_check("mulpd xmm0, xmm1", x86_mulpd_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x59, 0xC1]))
  x86_row_check("subps xmm0, xmm1", x86_subps_rr(0, 1),
    Vec::from([0x0F, 0x5C, 0xC1]))
  x86_row_check("subpd xmm0, xmm1", x86_subpd_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x5C, 0xC1]))
  x86_row_check("movdqu xmm0, [rax]", x86_movdqu_load(0, X64::RAX, 0),
    Vec::from([0xF3, 0x0F, 0x6F, 0x00]))
  x86_row_check("movdqu [rax], xmm0", x86_movdqu_store(X64::RAX, 0, 0),
    Vec::from([0xF3, 0x0F, 0x7F, 0x00]))
  x86_row_check("movdqu xmm0, [rbp-16]", x86_movdqu_load(0, X64::RBP, -16),
    Vec::from([0xF3, 0x0F, 0x6F, 0x45, 0xF0]))
  x86_row_check("pshufb xmm0, xmm1", x86_pshufb_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x38, 0x00, 0xC1]))
end

# The SSE2 lane-class plan rows: every lane class gets a single legacy
# instruction except the 32-bit integer multiply (the PMULUDQ sequence
# on the baseline; PMULLD only under the described sse41 token), and
# the byte/qword multiplies refuse with the named ISA rule.
def x86_row_plan_sse(pl: X86VecBinopPlan) -> (Int, Int)
  match pl
  when X86VecBinopPlan::X86VecSse(prefix, opcode) then (prefix, opcode)
  when _ then panic("expected a single legacy SSE binop plan")
  end
end

@test
def test_x86_vector_opcode_table_rows() -> Unit
  let add_i8 = x86_vec_binop_plan(LirVecBinOp::LirVecAdd, "i8", false)
  assert_true(add_i8.is_ok())
  match add_i8
  when Result::Ok(pl) then
    let pr = x86_row_plan_sse(pl)
    assert_true(pr.0 == 0x66 && pr.1 == 0xFC)
  when Result::Err(_) then ()
  end
  let add_f64 = x86_vec_binop_plan(LirVecBinOp::LirVecAdd, "f64", false)
  assert_true(add_f64.is_ok())
  match add_f64
  when Result::Ok(pl) then
    let pr = x86_row_plan_sse(pl)
    assert_true(pr.0 == 0x66 && pr.1 == 0x58)
  when Result::Err(_) then ()
  end
  let sub_u32 = x86_vec_binop_plan(LirVecBinOp::LirVecSub, "u32", false)
  assert_true(sub_u32.is_ok())
  match sub_u32
  when Result::Ok(pl) then
    let pr = x86_row_plan_sse(pl)
    assert_true(pr.0 == 0x66 && pr.1 == 0xFA)
  when Result::Err(_) then ()
  end
  let mul_i16 = x86_vec_binop_plan(LirVecBinOp::LirVecMul, "i16", false)
  assert_true(mul_i16.is_ok())
  match mul_i16
  when Result::Ok(pl) then
    let pr = x86_row_plan_sse(pl)
    assert_true(pr.0 == 0x66 && pr.1 == 0xD5)
  when Result::Err(_) then ()
  end
  let mul_f32 = x86_vec_binop_plan(LirVecBinOp::LirVecMul, "f32", false)
  assert_true(mul_f32.is_ok())
  match mul_f32
  when Result::Ok(pl) then
    let pr = x86_row_plan_sse(pl)
    assert_true(pr.0 == 0 && pr.1 == 0x59)
  when Result::Err(_) then ()
  end
  # The 32-bit lane multiply: SSE2 sequence on the baseline, PMULLD
  # only when the desc advertises sse41.
  let mul_i32 = x86_vec_binop_plan(LirVecBinOp::LirVecMul, "i32", false)
  assert_true(mul_i32.is_ok())
  match mul_i32
  when Result::Ok(pl) then
    match pl
    when X86VecBinopPlan::X86VecMul32Sse2 then ()
    when _ then panic("i32 mul must plan the SSE2 PMULUDQ sequence")
    end
  when Result::Err(_) then ()
  end
  let mul_u32 = x86_vec_binop_plan(LirVecBinOp::LirVecMul, "u32", true)
  assert_true(mul_u32.is_ok())
  match mul_u32
  when Result::Ok(pl) then
    match pl
    when X86VecBinopPlan::X86VecMul32Sse41 then ()
    when _ then panic("u32 mul with sse41 must plan PMULLD")
    end
  when Result::Err(_) then ()
  end
  # The truly-missing lane classes refuse with the named ISA rule.
  let m8 = x86_vec_binop_plan(LirVecBinOp::LirVecMul, "i8", false)
  assert_true(m8.is_err())
  match m8
  when Result::Err(e) then assert_true(e.contains("PMULLB"))
  when Result::Ok(_) then ()
  end
  let m64 = x86_vec_binop_plan(LirVecBinOp::LirVecMul, "i64", false)
  assert_true(m64.is_err())
  match m64
  when Result::Err(e) then assert_true(e.contains("VPMULLQ"))
  when Result::Ok(_) then ()
  end
  let mx = x86_vec_binop_plan(LirVecBinOp::LirVecAdd, "q7", false)
  assert_true(mx.is_err())
  match mx
  when Result::Err(e) then assert_true(e.contains("canonical vector element kind"))
  when Result::Ok(_) then ()
  end
  let lane128 = LirVectorLane { elem_kind: "i32".to_string(), lanes: 4, bits: 128 }
  assert_true(x86_validate_vec_lane("f", lane128).is_ok())
  let lane256 = LirVectorLane { elem_kind: "i32".to_string(), lanes: 8, bits: 256 }
  assert_true(x86_validate_vec_lane("f", lane256).is_err())
end

# The SSE2 lane-class encoder rows (the matrix the plan and the future
# lane arms are built from; every row is the hand-verified byte string).
@test
def test_x86_sse2_lane_class_encoder_rows() -> Unit
  x86_row_check("pandn xmm0, xmm1", x86_pandn_rr(0, 1),
    Vec::from([0x66, 0x0F, 0xDF, 0xC1]))
  x86_row_check("pcmpeqb xmm0, xmm1", x86_pcmpeqb_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x74, 0xC1]))
  x86_row_check("pcmpeqw xmm0, xmm1", x86_pcmpeqw_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x75, 0xC1]))
  x86_row_check("pcmpeqd xmm0, xmm1", x86_pcmpeqd_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x76, 0xC1]))
  x86_row_check("pcmpeqq xmm0, xmm1 (SSE4.1)", x86_pcmpeqq_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x38, 0x29, 0xC1]))
  x86_row_check("pcmpgtb xmm0, xmm1", x86_pcmpgtb_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x64, 0xC1]))
  x86_row_check("pcmpgtw xmm0, xmm1", x86_pcmpgtw_rr(0, 1),
