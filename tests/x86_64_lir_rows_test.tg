# tests/x86_64_lir_rows_test.tg — audit item 30 stage 1: the x86-64 LIR
# backend's row/structural pinning (NO gate: this suite is a documentation
# + regression pin of the hand-verified encoder bytes, the SysV register
# mapping and the frame arithmetic — it does not compile or execute
# x86-64 programs).
#
# Every byte row below was verified OFFLINE against disassembler output
# (`clang -target x86_64-apple-darwin` + `objdump -d`) and is documented
# in tg_compiler/backend_x86_64.tg's encoder comments; the patterns here
# are the same hand-derived layouts, so a change to any encoder fails a
# row instead of silently drifting the LIR route's machine code.
#
# Run with: tg test tests/x86_64_lir_rows_test.tg

use std::core::{panic}
use std::collections::{Vec, Map}
use std::test::*
use tg_compiler::asm::X64
use tg_compiler::lir::{LirAlloc, LirSeg, LirCond}
use tg_compiler::backend_x86_64::{
  x86_fixed_phys, x86_phys_of, x86_phys_name, x86_phys_is_callee_saved,
  x86_pool_ids, x86_cc_ids, x86_imm32_ok, x86_cc_of, x86_cc_inv,
  x86_saved_regs, x86_frame_total, x86_scratch_disp, x86_align16,
  x86_mov_rr, x86_mov_ri64, x86_mov_rm, x86_mov_mr,
  x86_alu_rr, x86_alu_rm, x86_alu_ri,
  x86_imul_rr, x86_imul_rm, x86_imul_rri,
  x86_cqo, x86_idiv_r, x86_idiv_rm, x86_div_r, x86_div_rm,
  x86_shift_imm, x86_shift_cl, x86_neg_r, x86_not_r,
  x86_setcc, x86_movzx_r64_r8, x86_movsx_r64_r8, x86_movsx_r64_r16,
  x86_movsxd_rr, x86_lea, x86_push_r, x86_pop_r,
  x86_ret, x86_leave, x86_nop, x86_ud2,
  x86_jmp_rel32, x86_jcc_rel32, x86_call_rel32, x86_jmp_rel8, x86_jcc_rel8
}

def x86_row_bytes_eq(a: Vec[u8], b: Vec[u8]) -> Bool
  if a.len() != b.len() then return false end
  var i = 0
  while i < a.len() do
    if a[i] != b[i] then return false end
    i = i + 1
  end
  true
end

def x86_row_check(what: String, actual: Vec[u8], expected: Vec[u8]) -> Unit
  if !x86_row_bytes_eq(actual, expected) then
    panic("x86_64 encoding row `" + what + "` mismatches the hand-verified bytes")
  end
end

def x86_row_alloc(slots: Int, segs: Map[Int, Vec[LirSeg]], cc_used: Vec[Int]) -> LirAlloc
  LirAlloc {
    slots: slots,
    frame_bytes: 16 * (slots + 1),
    segs_of: segs,
    spills: Vec::new(),
    reloads: Vec::new(),
    cc_used: cc_used
  }
end

def x86_row_reg_seg(vreg: Int, phys: Int) -> LirSeg
  LirSeg { start: 0, end: 0, vreg: vreg, phys: phys, slot: -1, needs_reload: false }
end

# ———————————————————————————————————————————————————————————————
# The SysV register mapping rows (vreg 0..5 -> rdi/rsi/rdx/rcx/r8/r9;
# pool 9..14 -> r10/r11/rbx/r12/r13/r14; cc 19 -> r15)
# ———————————————————————————————————————————————————————————————

@test
def test_x86_fixed_argument_register_rows() -> Unit
  assert_true(x86_fixed_phys(0) == X64::RDI)
  assert_true(x86_fixed_phys(1) == X64::RSI)
  assert_true(x86_fixed_phys(2) == X64::RDX)
  assert_true(x86_fixed_phys(3) == X64::RCX)
  assert_true(x86_fixed_phys(4) == X64::R8)
  assert_true(x86_fixed_phys(5) == X64::R9)
  # Fixed ids 6/7 are arguments 7/8 — SysV passes them on the stack and
  # the stage-1 route fails closed; 8..15 are the float file.
  let m6 = assert_panics(|| {
    let _ = x86_fixed_phys(6)
  })
  assert_true(m6.contains("fixed LIR vreg 6"))
  let m8 = assert_panics(|| {
    let _ = x86_fixed_phys(8)
  })
  assert_true(m8.contains("fixed LIR vreg 8"))
end

@test
def test_x86_pool_and_cc_register_rows() -> Unit
  assert_true(x86_phys_of(9) == X64::R10)
  assert_true(x86_phys_of(10) == X64::R11)
  assert_true(x86_phys_of(11) == X64::RBX)
  assert_true(x86_phys_of(12) == X64::R12)
  assert_true(x86_phys_of(13) == X64::R13)
  assert_true(x86_phys_of(14) == X64::R14)
  assert_true(x86_phys_of(19) == X64::R15)
  assert_eq(x86_pool_ids().len(), 6)
  assert_eq(x86_cc_ids().len(), 1)
  assert_eq(x86_cc_ids()[0], 19)
  assert_true(x86_phys_name(9) == "r10")
  assert_true(x86_phys_name(10) == "r11")
  assert_true(x86_phys_name(11) == "rbx")
  assert_true(x86_phys_name(12) == "r12")
  assert_true(x86_phys_name(13) == "r13")
  assert_true(x86_phys_name(14) == "r14")
  assert_true(x86_phys_name(19) == "r15")
  let m = assert_panics(|| {
    let _ = x86_phys_of(20)
  })
  assert_true(m.contains("physical id 20"))
  let m0 = assert_panics(|| {
    let _ = x86_phys_of(0)
  })
  assert_true(m0.contains("physical id 0"))
end

@test
def test_x86_callee_saved_class_rows() -> Unit
  assert_true(!x86_phys_is_callee_saved(9))
  assert_true(!x86_phys_is_callee_saved(10))
  assert_true(x86_phys_is_callee_saved(11))
  assert_true(x86_phys_is_callee_saved(12))
  assert_true(x86_phys_is_callee_saved(13))
  assert_true(x86_phys_is_callee_saved(14))
  assert_true(x86_phys_is_callee_saved(19))
end

@test
def test_x86_saved_register_selection_rows() -> Unit
  # The cc pool's id 19 (r15) rides a call without a spill record: a
  # segment assigned 19 puts r15 in the save list.
  var segs_a: Map[Int, Vec[LirSeg]] = Map::new()
  segs_a.insert(16, Vec::from([x86_row_reg_seg(16, 19)]))
  let alloc_a = x86_row_alloc(1, segs_a, Vec::from([19]))
  let saved_a = x86_saved_regs(alloc_a)
  assert_eq(saved_a.len(), 1)
  assert_true(saved_a[0] == X64::R15)
  # The general pool's rbx/r12..r14 (ids 11..14) are SysV callee-saved
  # even though the allocator books them caller-saved: their assigned
  # segments enter the save list too, in ascending machine order.
  var segs_b: Map[Int, Vec[LirSeg]] = Map::new()
  segs_b.insert(16, Vec::from([x86_row_reg_seg(16, 14)]))
  segs_b.insert(17, Vec::from([x86_row_reg_seg(17, 11)]))
  segs_b.insert(18, Vec::from([x86_row_reg_seg(18, 12)]))
  let alloc_b = x86_row_alloc(2, segs_b, Vec::new())
  let saved_b = x86_saved_regs(alloc_b)
  assert_eq(saved_b.len(), 3)
  assert_true(saved_b[0] == X64::RBX)
  assert_true(saved_b[1] == X64::R12)
  assert_true(saved_b[2] == X64::R14)
  # r10/r11 are caller-saved: no save entry.
  var segs_c: Map[Int, Vec[LirSeg]] = Map::new()
  segs_c.insert(16, Vec::from([x86_row_reg_seg(16, 10)]))
  let alloc_c = x86_row_alloc(1, segs_c, Vec::new())
  assert_eq(x86_saved_regs(alloc_c).len(), 0)
end

# ———————————————————————————————————————————————————————————————
# Frame arithmetic rows (uniform 8-byte slots + one scratch slot)
# ———————————————————————————————————————————————————————————————

@test
def test_x86_frame_rows() -> Unit
  assert_eq(x86_align16(0), 0)
  assert_eq(x86_align16(1), 16)
  assert_eq(x86_align16(16), 16)
  assert_eq(x86_align16(17), 32)
  var no_segs: Map[Int, Vec[LirSeg]] = Map::new()
  # slots = 2, no saves: raw = 2*8 + 8 = 24 -> 32.
  let alloc = x86_row_alloc(2, no_segs, Vec::new())
  assert_eq(x86_frame_total(alloc, 0), 32)
  # One save adds 8 bytes: raw = 32 -> 32 (still 16-aligned).
  assert_eq(x86_frame_total(alloc, 1), 32)
  # Three saves: raw = 16 + 8 + 24 = 48 -> 48.
  assert_eq(x86_frame_total(alloc, 3), 48)
  # Spill slot i = [rbp - 8 - 8*i]; the scratch slot sits just below the
  # last vreg slot.
  assert_eq(x86_scratch_disp(alloc), -24)
end

# ———————————————————————————————————————————————————————————————
# Immediate / condition-code rows
# ———————————————————————————————————————————————————————————————

@test
def test_x86_immediate_and_condition_rows() -> Unit
  assert_true(x86_imm32_ok(0))
  assert_true(x86_imm32_ok(2147483647))
  assert_true(x86_imm32_ok(-2147483648))
  assert_true(!x86_imm32_ok(2147483648))
  assert_true(!x86_imm32_ok(-2147483649))
  assert_eq(x86_cc_of(LirCond::LirEq), 0x4)
  assert_eq(x86_cc_of(LirCond::LirNe), 0x5)
  assert_eq(x86_cc_of(LirCond::LirLt), 0xC)
  assert_eq(x86_cc_of(LirCond::LirLe), 0xE)
  assert_eq(x86_cc_of(LirCond::LirGt), 0xF)
  assert_eq(x86_cc_of(LirCond::LirGe), 0xD)
  assert_eq(x86_cc_of(LirCond::LirUlt), 0x2)
  assert_eq(x86_cc_of(LirCond::LirUle), 0x6)
  assert_eq(x86_cc_of(LirCond::LirUgt), 0x7)
  assert_eq(x86_cc_of(LirCond::LirUge), 0x3)
  assert_true(x86_cc_inv(LirCond::LirEq) == LirCond::LirNe)
  assert_true(x86_cc_inv(LirCond::LirLt) == LirCond::LirGe)
  assert_true(x86_cc_inv(LirCond::LirUge) == LirCond::LirUlt)
end

# ———————————————————————————————————————————————————————————————
# Encoder byte rows (mov / ALU / mul / div)
# ———————————————————————————————————————————————————————————————

@test
def test_x86_mov_encoding_rows() -> Unit
  x86_row_check("mov rcx -> rax", x86_mov_rr(X64::RAX, X64::RCX),
    Vec::from([0x48, 0x89, 0xC8]))
  x86_row_check("mov r9 -> r8", x86_mov_rr(X64::R8, X64::R9),
    Vec::from([0x4D, 0x89, 0xC8]))
  x86_row_check("movabs rax, 0x1122334455667788",
    x86_mov_ri64(X64::RAX, 0x1122334455667788),
    Vec::from([0x48, 0xB8, 0x88, 0x77, 0x66, 0x55, 0x44, 0x33, 0x22, 0x11]))
  x86_row_check("movabs r10, 0x1122334455667788",
    x86_mov_ri64(X64::R10, 0x1122334455667788),
    Vec::from([0x49, 0xBA, 0x88, 0x77, 0x66, 0x55, 0x44, 0x33, 0x22, 0x11]))
  x86_row_check("movabs rax, -1", x86_mov_ri64(X64::RAX, -1),
    Vec::from([0x48, 0xB8, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]))
  x86_row_check("mov rax, [rbp-8]", x86_mov_rm(X64::RAX, X64::RBP, -8),
    Vec::from([0x48, 0x8B, 0x45, 0xF8]))
  x86_row_check("mov r12, [rbp-16]", x86_mov_rm(X64::R12, X64::RBP, -16),
    Vec::from([0x4C, 0x8B, 0x65, 0xF0]))
  x86_row_check("mov r12, [r12+8]", x86_mov_rm(X64::R12, X64::R12, 8),
    Vec::from([0x4D, 0x8B, 0x64, 0x24, 0x08]))
  x86_row_check("mov rax, [r10]", x86_mov_rm(X64::RAX, X64::R10, 0),
    Vec::from([0x49, 0x8B, 0x02]))
  x86_row_check("mov [rbp-8], rax", x86_mov_mr(X64::RBP, -8, X64::RAX),
    Vec::from([0x48, 0x89, 0x45, 0xF8]))
  x86_row_check("mov [rbp-16], r12", x86_mov_mr(X64::RBP, -16, X64::R12),
    Vec::from([0x4C, 0x89, 0x65, 0xF0]))
  x86_row_check("mov [rsp+8], rax", x86_mov_mr(X64::RSP, 8, X64::RAX),
    Vec::from([0x48, 0x89, 0x44, 0x24, 0x08]))
  x86_row_check("mov [rbp-200], rax", x86_mov_mr(X64::RBP, -200, X64::RAX),
    Vec::from([0x48, 0x89, 0x85, 0x38, 0xFF, 0xFF, 0xFF]))
end

@test
def test_x86_alu_encoding_rows() -> Unit
  x86_row_check("add rax, rcx", x86_alu_rr(0x01, X64::RAX, X64::RCX),
    Vec::from([0x48, 0x01, 0xC8]))
  x86_row_check("or rax, rcx", x86_alu_rr(0x09, X64::RAX, X64::RCX),
    Vec::from([0x48, 0x09, 0xC8]))
  x86_row_check("and rax, rcx", x86_alu_rr(0x21, X64::RAX, X64::RCX),
    Vec::from([0x48, 0x21, 0xC8]))
  x86_row_check("sub rax, rcx", x86_alu_rr(0x29, X64::RAX, X64::RCX),
    Vec::from([0x48, 0x29, 0xC8]))
  x86_row_check("xor rax, rcx", x86_alu_rr(0x31, X64::RAX, X64::RCX),
    Vec::from([0x48, 0x31, 0xC8]))
  x86_row_check("cmp rax, rcx", x86_alu_rr(0x39, X64::RAX, X64::RCX),
    Vec::from([0x48, 0x39, 0xC8]))
  x86_row_check("test rax, rcx", x86_alu_rr(0x85, X64::RAX, X64::RCX),
    Vec::from([0x48, 0x85, 0xC8]))
  x86_row_check("xor rdx, rdx", x86_alu_rr(0x31, X64::RDX, X64::RDX),
    Vec::from([0x48, 0x31, 0xD2]))
  x86_row_check("add rax, [rbp-8]", x86_alu_rm(0x03, X64::RAX, X64::RBP, -8),
    Vec::from([0x48, 0x03, 0x45, 0xF8]))
  x86_row_check("sub rax, [rbp-8]", x86_alu_rm(0x2B, X64::RAX, X64::RBP, -8),
    Vec::from([0x48, 0x2B, 0x45, 0xF8]))
  x86_row_check("cmp rax, [rbp-8]", x86_alu_rm(0x3B, X64::RAX, X64::RBP, -8),
    Vec::from([0x48, 0x3B, 0x45, 0xF8]))
  x86_row_check("add rax, imm32 5", x86_alu_ri(0, X64::RAX, 5),
    Vec::from([0x48, 0x81, 0xC0, 0x05, 0x00, 0x00, 0x00]))
  x86_row_check("sub rsp, imm32 16", x86_alu_ri(5, X64::RSP, 16),
    Vec::from([0x48, 0x81, 0xEC, 0x10, 0x00, 0x00, 0x00]))
  x86_row_check("cmp rax, imm32 -1", x86_alu_ri(7, X64::RAX, -1),
    Vec::from([0x48, 0x81, 0xF8, 0xFF, 0xFF, 0xFF, 0xFF]))
  let m = assert_panics(|| {
    let _ = x86_alu_ri(0, X64::RAX, 2147483648)
  })
  assert_true(m.contains("does not fit"))
end

@test
def test_x86_mul_div_encoding_rows() -> Unit
  x86_row_check("imul rax, rcx", x86_imul_rr(X64::RAX, X64::RCX),
    Vec::from([0x48, 0x0F, 0xAF, 0xC1]))
  x86_row_check("imul rax, [rbp-8]", x86_imul_rm(X64::RAX, X64::RBP, -8),
    Vec::from([0x48, 0x0F, 0xAF, 0x45, 0xF8]))
  x86_row_check("imul rax, rax, imm32 7",
    x86_imul_rri(X64::RAX, X64::RAX, 7),
    Vec::from([0x48, 0x69, 0xC0, 0x07, 0x00, 0x00, 0x00]))
  x86_row_check("cqo", x86_cqo(), Vec::from([0x48, 0x99]))
  x86_row_check("idiv rcx", x86_idiv_r(X64::RCX), Vec::from([0x48, 0xF7, 0xF9]))
  x86_row_check("idiv [rbp-8]", x86_idiv_rm(X64::RBP, -8),
    Vec::from([0x48, 0xF7, 0x7D, 0xF8]))
  x86_row_check("div rcx", x86_div_r(X64::RCX), Vec::from([0x48, 0xF7, 0xF1]))
  x86_row_check("div [rbp-8]", x86_div_rm(X64::RBP, -8),
    Vec::from([0x48, 0xF7, 0x75, 0xF8]))
end

@test
def test_x86_shift_unary_bool_encoding_rows() -> Unit
  x86_row_check("shl rax, 3", x86_shift_imm(4, X64::RAX, 3),
    Vec::from([0x48, 0xC1, 0xE0, 0x03]))
  x86_row_check("shr rax, 3", x86_shift_imm(5, X64::RAX, 3),
    Vec::from([0x48, 0xC1, 0xE8, 0x03]))
  x86_row_check("sar rax, 3", x86_shift_imm(7, X64::RAX, 3),
    Vec::from([0x48, 0xC1, 0xF8, 0x03]))
  x86_row_check("shl rax, cl", x86_shift_cl(4, X64::RAX),
    Vec::from([0x48, 0xD3, 0xE0]))
  x86_row_check("shr rax, cl", x86_shift_cl(5, X64::RAX),
    Vec::from([0x48, 0xD3, 0xE8]))
  x86_row_check("sar rax, cl", x86_shift_cl(7, X64::RAX),
    Vec::from([0x48, 0xD3, 0xF8]))
  x86_row_check("neg rax", x86_neg_r(X64::RAX), Vec::from([0x48, 0xF7, 0xD8]))
  x86_row_check("not rax", x86_not_r(X64::RAX), Vec::from([0x48, 0xF7, 0xD0]))
  x86_row_check("sete al", x86_setcc(0x4, X64::RAX),
    Vec::from([0x0F, 0x94, 0xC0]))
  x86_row_check("sete r10b", x86_setcc(0x4, X64::R10),
    Vec::from([0x41, 0x0F, 0x94, 0xC2]))
  x86_row_check("setne dil", x86_setcc(0x5, X64::RDI),
    Vec::from([0x40, 0x0F, 0x95, 0xC7]))
  x86_row_check("movzx rax, al", x86_movzx_r64_r8(X64::RAX, X64::RAX),
    Vec::from([0x48, 0x0F, 0xB6, 0xC0]))
  x86_row_check("movsx rax, al", x86_movsx_r64_r8(X64::RAX, X64::RAX),
    Vec::from([0x48, 0x0F, 0xBE, 0xC0]))
  x86_row_check("movsx rax, ax", x86_movsx_r64_r16(X64::RAX, X64::RAX),
    Vec::from([0x48, 0x0F, 0xBF, 0xC0]))
  x86_row_check("movsxd rax, eax", x86_movsxd_rr(X64::RAX, X64::RAX),
    Vec::from([0x48, 0x63, 0xC0]))
  x86_row_check("lea rax, [rbp-40]", x86_lea(X64::RAX, X64::RBP, -40),
    Vec::from([0x48, 0x8D, 0x45, 0xD8]))
end

@test
def test_x86_frame_branch_encoding_rows() -> Unit
  x86_row_check("push rbp", x86_push_r(X64::RBP), Vec::from([0x55]))
  x86_row_check("push r12", x86_push_r(X64::R12), Vec::from([0x41, 0x54]))
  x86_row_check("pop rbp", x86_pop_r(X64::RBP), Vec::from([0x5D]))
  x86_row_check("ret", x86_ret(), Vec::from([0xC3]))
  x86_row_check("leave", x86_leave(), Vec::from([0xC9]))
  x86_row_check("nop", x86_nop(), Vec::from([0x90]))
  x86_row_check("ud2", x86_ud2(), Vec::from([0x0F, 0x0B]))
  x86_row_check("jmp rel32", x86_jmp_rel32(),
    Vec::from([0xE9, 0x00, 0x00, 0x00, 0x00]))
  x86_row_check("je rel32", x86_jcc_rel32(0x4),
    Vec::from([0x0F, 0x84, 0x00, 0x00, 0x00, 0x00]))
  x86_row_check("jl rel32", x86_jcc_rel32(0xC),
    Vec::from([0x0F, 0x8C, 0x00, 0x00, 0x00, 0x00]))
  x86_row_check("call rel32", x86_call_rel32(),
    Vec::from([0xE8, 0x00, 0x00, 0x00, 0x00]))
  x86_row_check("jmp rel8 -2", x86_jmp_rel8(-2), Vec::from([0xEB, 0xFE]))
  x86_row_check("je rel8 +16", x86_jcc_rel8(0x4, 0x10), Vec::from([0x74, 0x10]))
  x86_row_check("jne rel8 -2", x86_jcc_rel8(0x5, -2), Vec::from([0x75, 0xFE]))
  let m = assert_panics(|| {
    let _ = x86_jmp_rel8(200)
  })
  assert_true(m.contains("does not fit"))
end
