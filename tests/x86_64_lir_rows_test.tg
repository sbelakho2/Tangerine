    Vec::from([0x0F, 0x59, 0xC1]))
  x86_row_check("mulpd xmm0, xmm1", x86_mulpd_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x59, 0xC1]))
  x86_row_check("subps xmm0, xmm1", x86_subps_rr(0, 1),
    Vec::from([0x0F, 0x5C, 0xC1]))
  x86_row_check("subpd xmm0, xmm1", x86_subpd_rr(0, 1),
    Vec::from([0x66, 0x0F, 0x5C, 0xC1]))
  x86_row_check("movdqu xmm0, [rax]", x86_movdqu_load(0, X64::RAX, 0),
    Vec::from([0xF3, 0x0F, 0x6F, 0x00]))
  x86_row_check("movdqu [rax], xmm0", x86_movdqu_store(X64::RAX, 0, 0),
    Vec::from([0xF3, 0x0F, 0x7F, 0x00]))
  x86_row_check("movdqu xmm0, [rbp-16]", x86_movdqu_load(0, X64::RBP, -16),
    Vec::from([0xF3, 0x0F, 0x6F, 0x45, 0xF0]))
