    Vec::from([0x66, 0x0F, 0x3A, 0x16, 0xC0, 0x02]))
  x86_row_check("pinsrd xmm0, eax, 2 (SSE4.1)", x86_pinsrd_xmm_r32(0, X64::RAX, 2),
    Vec::from([0x66, 0x0F, 0x3A, 0x22, 0xC0, 0x02]))
