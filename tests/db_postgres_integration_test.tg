# tests/db_postgres_integration_test.tg — the std::db Postgres driver
# against the CI postgres service container.
#
# The non-SQLite DB lane: PostgresConfig::new() defaults (localhost:5432,
# user postgres, dbname postgres) match the GitHub Actions postgres
# service container; the password comes from the service env. The lane is
# gated behind the service container (ci.yml db-integration-postgres job)
# and preloads libpq into the tg-compiled test process — the same
# DYLD_INSERT_LIBRARIES / DYLD_FORCE_FLAT_NAMESPACE mechanism as the TLS
# shim lane, because the in-house Mach-O linker emits a single
# LC_LOAD_DYLIB and records the PQ* externs as dyld imports.
#
# The assertions mirror the SQLite lane: open -> CREATE TABLE -> INSERT ->
# SELECT through the shared Connection trait / Rows API.

use std::core::{Vec, String, Unit, Result, Option}
use std::test::*
use std::db::{PostgresConfig, Connection, ToSqlParam}

@test
def test_postgres_service_create_insert_select() -> Unit
  let cfg = PostgresConfig::new().password("postgres")
  let db = cfg.connect()
  match db
  when Result::Ok(conn) then
    let mut c = conn

    # Create
    let rc = c.execute("CREATE TABLE kv (id SERIAL PRIMARY KEY, value TEXT)", &[])
    assert_ok(rc)

    # Insert
    let ri = c.execute("INSERT INTO kv (value) VALUES (?)", &[Box::new("hello".to_string()) as Box[dyn ToSqlParam]])
    assert_ok(ri)

    # Select
    let rows = c.query("SELECT value FROM kv", &[])
    let r = assert_ok(rows)
    assert_eq(r.row_count(), 1)

    let row = r.into_iter().next()
    match row
    when Option::Some(row) then
      let v: String = row.get(0).ok().unwrap_or("".to_string())
      assert_eq(v, "hello")
    when Option::None then
      assert_false(true)
    end
  when Result::Err(e) then
    assert_false(true)
  end
end
