use std::io::{print, println}

def check(result: Int, expected: Int) -> Int
  if result == expected then
    println("equal → returning 0")
    0
  else
    println("NOT equal → returning 1")
    1
  end
end

def main() -> Int
  let r1 = check(70, 70)
  print("r1 = ")
  if r1 == 0 then
    println("0")
  else
    println("not 0")
  end
  r1
end
