# tests/perf_lir_view_lane_test.tg — the perf report's LIR/allocator
# view (perf_report_of_lir_alloc / perf_facts_of_lir) lane.
#
# The view fills exactly the surfaces the LIR allocation artifacts
# carry — spills/reloads (the allocator's records), frame bytes, the LIR
# branch terms and the distinct physical registers of the segment maps —
# with MachineActual/"measured" provenance, keeps every MIR-level
# surface None/"unknown" (no fabricated zeros), and leaves the machine
# word count None/"estimate" (no route emitter returns a per-function
# word vector — its entry returns Unit / Result[Unit, String]).
#
# Rows (each returns a mismatch text on failure; the test asserts the
# empty list):
#   L1 the recorded surfaces and their provenance/bound words;
#   L2 the labeled fact rows carry the same records (including the
#      MachineInstructionCount None/"estimate" row);
#   L3 the unrecorded MIR-level surfaces are None/"unknown";
#   L4 instruction_count is None/"estimate"/StaticEstimate.
#
# Run with the repo root as the working directory:
#   tg test tests/perf_lir_view_lane_test.tg

use std::test::assert

use tg_compiler::perf_report::{perf_lir_view_lane_check}

@test
def test_perf_lir_view_lane() -> Unit
  let rows = perf_lir_view_lane_check()
  assert(rows.len() == 0, "perf LIR-view lane mismatches: " + rows.join("; "))
end
