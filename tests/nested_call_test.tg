use std::io::{print, println}

def int_to_str(n: Int) -> String
  match n
  when 0 then "0"
  when 1 then "1"
  when 2 then "2"
  when 3 then "3"
  when 7 then "7"
  when 8 then "8"
  when 42 then "42"
  when 58 then "58"
  when 70 then "70"
  else "?"
  end
end

def test_op(result: Int, expected: Int) -> Int
  print("  result=")
  print(int_to_str(result))
  print(" expected=")
  println(int_to_str(expected))
  if result == expected then 0 else 1 end
end

def add(a: Int, b: Int) -> Int
  a + b
end

def main() -> Int
  mut fails = 0

  fails = fails + test_op(add(5, 3), 8)
  print("fails after 1: ")
  println(int_to_str(fails))

  fails = fails + test_op(add(3, 4), 7)
  print("fails after 2: ")
  println(int_to_str(fails))

  fails
end
