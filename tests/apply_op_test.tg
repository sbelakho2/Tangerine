use std::io::{print, println}

def apply_op(op: Int, stored: Int, current: Int) -> Int
  match op
  when 1 then stored + current
  when 2 then stored - current
  when 3 then stored * current
  when 4 then
    if current == 0 then
      -999999
    else
      stored / current
    end
  else current
  end
end

def int_to_string(n: Int) -> String
  if n == 0 then
    return "0"
  end
  mut val = n
  mut result = ""
  if val < 0 then
    result = "-"
    val = 0 - val
  end
  mut digits = ""
  while val > 0 do
    let digit = val - ((val / 10) * 10)
    val = val / 10
    let ch = match digit
      when 0 then "0"
      when 1 then "1"
      when 2 then "2"
      when 3 then "3"
      when 4 then "4"
      when 5 then "5"
      when 6 then "6"
      when 7 then "7"
      when 8 then "8"
      when 9 then "9"
      else "?"
    end
    digits = ch + digits
  end
  result + digits
end

def main() -> Int
  let r = apply_op(1, 10, 20)
  print("10 + 20 = ")
  println(int_to_string(r))

  let r2 = apply_op(3, 7, 8)
  print("7 * 8 = ")
  println(int_to_string(r2))

  0
end
