# case: struct_pattern_missing_field_pat
# decision: intentional language boundary (REJECT)
# anchor: grammar.md §5 field_pattern = IDENT [ ':' pattern ] — a colon must
#         be followed by a pattern. The seed reports "expected pattern"
#         (parse_single_pattern fallback, stage0_ocaml/src/parser.ml:3348);
#         the kernel records E104. This guards the rewritten comma-less
#         struct-pattern loop (pos/12) from swallowing empty `name:` fields.
struct S
  a: Int
end

def struct_pattern_missing_field_pat(s: S) -> Int
  match s
  when S { a: } then 1
  when _ then 0
  end
end
