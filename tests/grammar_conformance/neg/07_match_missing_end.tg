# case: match_missing_end
# decision: intentional language boundary (REJECT)
# anchor: grammar.md §4.6 match_expr ends with a mandatory `'end'` (unlike
#         the short-form if, whose `end` is optional). The seed's
#         parse_match_expr expects KwEnd (stage0_ocaml/src/parser.ml:2939);
#         the kernel's expect_end does the same. This guards the per-arm end
#         acceptance (pos/01) from absorbing the match's own terminator.
def match_missing_end(x: Int) -> Int
  match x
  when 1 then 10
end
