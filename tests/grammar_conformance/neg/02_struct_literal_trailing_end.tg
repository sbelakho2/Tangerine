# case: struct_literal_trailing_end
# decision: accidental (REJECT)
# anchor: same rule as neg/01. The seed ends the field list when it sees
#         `end` followed by a non-continuation token (here `}`); it consumes
#         the `end` as the seed's end-terminated literal terminator and the
#         stray `}` is a diagnostic. The kernel must not silently read the
#         trailing `end` as another shorthand field.
struct S
  a: Int
end

def struct_literal_trailing_end() -> Int
  S { a: 1 end }
end
