# case: struct_pattern_end
# decision: accidental (REJECT)
# anchor: the seed struct-pattern loop stops at at_kw_end_as_terminator
#         (stage0_ocaml/src/parser.ml:3245-3262); the `end` is consumed as
#         the (unsupported) pattern terminator and the remaining `}` is a
#         diagnostic. The kernel's 155f72d pattern rewrite accepted `end`
#         as a field name; it now stops at the terminator and keeps the
#         diagnostic, matching the seed.
struct S
  a: Int
end

def struct_pattern_end(s: S) -> Int
  match s
  when S { a end } then a
  when _ then 0
  end
end
