# case: array_same_line_no_comma
# decision: intentional leniency boundary (REJECT)
# anchor: grammar.md §4.5 expr_list uses commas, and the seed's lenient
#         continuation requires `source_has_newline` between the elements
#         (stage0_ocaml/src/parser.ml:2216-2222). Same-line elements without
#         a comma are rejected by BOTH parsers; this case is the guard that
#         keeps the newline leniency (pos/09) from silently becoming
#         "commas are optional everywhere".
def array_same_line_no_comma() -> Int
  let xs = [1 2 3]
  xs[0]
end
