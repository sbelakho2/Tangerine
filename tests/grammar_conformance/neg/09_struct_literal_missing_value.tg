# case: struct_literal_missing_value
# decision: intentional language boundary (REJECT)
# anchor: grammar.md §4.5 field_init = IDENT [ ':' expr ] — a colon must be
#         followed by an expression. The seed's parse_struct_literal parses
#         the value after the colon and reports "expected expression"
#         (stage0_ocaml/src/parser.ml:2594-2596); the kernel records E101.
#         Guards the optional-comma literal loop (pos/07, pos/08) from
#         accepting a valueless `name:` field.
struct S
  a: Int
end

def struct_literal_missing_value() -> Int
  let s = S { a: }
  0
end
