# case: or_pattern_empty_alt
# decision: intentional language boundary (REJECT)
# anchor: grammar.md §5 `pattern = single_pattern { '|' single_pattern }`
#         requires a single_pattern on both sides of `|`. The seed reports
#         "expected pattern" at the empty alternative; the kernel mirrors it
#         (parse_single_pattern records E104 and parse_pattern stops). This
#         guards the multi-line or-pattern leniency (pos/11) from accepting
#         dangling separators.
def or_pattern_empty_alt(x: Int) -> Int
  match x
  when 1 | | 2 then 1
  when _ then 0
  end
end
