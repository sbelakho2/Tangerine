#         accepts soft-keyword named fields only in the BRACE form
#         (parse_enum_decl:1070-1078 uses expect_ident); the PARENTHESIZED
#         form tests `at_ident p && kind_at p 1 = Token.Colon`
#         (stage0_ocaml/src/parser.ml:1054-1057), so `V(finally: Int)`
#         fails with "expected type". The kernel's parse_variant_field
#         widening was applying the soft rule to both forms; it now keeps
#         soft names for the brace form and requires IDENT for the paren
#         form, matching the seed. (Brace-form soft names are pinned as a
#         positive by the seed-sourced spelling in pos/06.)
enum E
  V(finally: Int)
end
