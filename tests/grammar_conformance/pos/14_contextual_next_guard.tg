# case: contextual_next_guard
# decision: intentional language (ACCEPT)
# anchor: `next` is both the loop-continue statement and a soft identifier
#         (grammar.md §1.3: "`next` and `continue` are aliases"). The seed
#         treats a bare `next` at a statement boundary as the continue and
#         `next` followed by a value-position token (`=`, `+`, `(`, `.`,
#         ...) as the identifier (stage0_ocaml/src/parser.ml:736-755). The
#         kernel mirrors that boundary rule (at_soft_ident_continuation).
#         `guard` is likewise a contextual keyword: the guard STATEMENT is
#         `guard <cond> else <action>`, while `guard = ...` is the
#         identifier (the seed's soft_ident_kind).
def contextual_next() -> Int
  var i = 0
  loop
    i = i + 1
    if i > 3 then break end
    next
  end
  i
end

def contextual_guard(x: Int) -> Int
  guard x > 0 else return 0
  x
end
