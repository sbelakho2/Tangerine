# case: soft_keyword_expr_idents
# decision: intentional language (ACCEPT)
# anchor: contextual keywords are identifiers in value position when their
#         construct shape does not apply: `next`/`guard`/`copy`/`move`/`end`
#         all have seed soft_ident_kind entries (stage0_ocaml/src/parser.ml:
#         137-212) and the kernel's parse_primary falls back to
#         soft_ident_name for them. The seed lexes `move`/`copy` as plain
#         identifiers, so `copy.provenance` and the call `move(1)` are
#         identifier uses; the kernel's contextual prefix rule must route
#         them to parse_postfix (parser.tg at_prefix_keyword_ident_context).
#         grammar.md §4.1 (precedence 12; `( 'move' | 'copy' ) unary` legacy
#         no-ops) is why the bare prefix `move x` form stays a unary.
struct Provenance
  provenance: Int
end

def move(x: Int) -> Int
  x
end

def soft_keyword_expr_idents(s: Provenance) -> Int
  let copy = s
  let guard = copy.provenance
  guard + move(1)
end
