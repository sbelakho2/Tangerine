# case: kw_end_field_names
# decision: intentional language (ACCEPT)
# anchor: `end` is a soft identifier in name positions. The seed's
#         at_kw_end_as_terminator (stage0_ocaml/src/parser.ml:243-253)
#         distinguishes `end` as a block terminator from `end` used as a
#         name: `end` followed on the same line by `:` / `=` / `.` / `(` is
#         a name, not a terminator. The kernel mirrors the same predicate in
#         parse_struct_decl_kind/parse_enum_decl/... Field names spelled
#         `end` occur in the bootstrap kernel sources (parser.tg decls).
struct Carrier
  end: Int
end

def kw_end_field_names(s: Carrier) -> Int
  let other = Carrier { end: 1 }
  other.end
end
