# case: struct_literal_newline_fields
# decision: bootstrap-accommodation (ACCEPT)
# anchor: same seed rule as pos/07 (the optional comma is not required at
#         all, so the multi-line form without commas parses). The style
#         guide writes the multi-line form WITH commas (style_guide.md
#         "Struct Initialization"), but the seed and the kernel both accept
#         the comma-less spelling; pinned as accommodation.
struct Pair
  a: Int
  b: Int
end

def struct_literal_newline_fields() -> Int
  let p = Pair {
    a: 1
    b: 2
  }
  p.a + p.b
end
