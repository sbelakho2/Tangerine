# case: per_arm_end
# decision: bootstrap-accommodation (ACCEPT)
# anchor: docs/current/grammar.md §4.6 match_arm has no per-arm `end`; the
#         canonical form is one final `end` (RFC 0002). The legacy
#         arm-terminated style closes each arm's block with `end` at the
#         arm column; the seed parser accepts it (stage0_ocaml/src/parser.ml
#         2879-2895 per_arm_end, used at 2933-2936), and the closure still
#         contains 7 such sites (e.g. tg_compiler/codegen.tg:6445), so the
#         kernel mirrors the acceptance. Pinned so neither parser silently
#         drops it before the sources are migrated.
def per_arm_end_style(x: Int) -> Int
  match x
  when 1 then
    10
  end
  when 2 then
    20
  end
end
