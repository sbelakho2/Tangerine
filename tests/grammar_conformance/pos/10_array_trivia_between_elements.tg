# case: array_trivia_between_elements
# decision: intentional leniency (ACCEPT)
# anchor: comments and newlines are trivia in the seed token stream (the
#         lexer drops them), so a newline in the gap between two elements
#         is all the lenient array rule needs — a doc-comment line between
#         the elements parses (stage0_ocaml/src/parser.ml:2216-2222 checks
#         the raw source span for a newline). The kernel probe must skip
#         doc comments AND newlines in any order when looking for that
#         separating newline; this case pins that trivia handling.
def array_trivia_between_elements() -> Int
  let xs = [1
## a doc comment line between elements
2]
  xs[0] + xs[1]
end
