# case: value_position_else
# decision: intentional language (ACCEPT)
# anchor: grammar.md §4.6 makes the if `end` optional in the short form
#         (`if_expr ... [ 'else' block ] [ 'end' ]`). The seed's else rule
#         (stage0_ocaml/src/parser.ml:2747-2805) treats an else branch as a
#         single expression when the following token is a closing
#         delimiter/comma/`}`/the construct's `end`/EOF, or when the next
#         statement sits at a SHALLOWER column. The kernel mirrors this in
#         parse_if_else_value_block; both forms below (argument position,
#         binding position) must parse without a trailing `end`.
def g(x: Int) -> Int
  x
end

def value_position_else(c: Bool) -> Int
  let x = if c then 1 else 2
  g(if c then x + 1 else x - 1)
end
