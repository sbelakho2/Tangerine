# case: array_newline_elements
# decision: intentional leniency (ACCEPT)
# anchor: the seed parser documents this explicitly — "Newline between two
#         token spans in the source (lenient array-element separation,
#         mirroring the reference parser)" (stage0_ocaml/src/parser.ml:
#         124-125) and continues the element loop on `is_expr_start &&
#         source_has_newline` (2216-2222). The kernel mirrors it: an element
#         on a NEW line continues the literal without a comma. Elements on
#         the SAME line still require the comma (neg/05).
def array_newline_elements() -> Int
  let xs = [
    1
    2
    3
  ]
  xs[0] + xs[1] + xs[2]
end
