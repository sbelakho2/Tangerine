# case: struct_pattern_no_comma_rest
# decision: bootstrap-accommodation (ACCEPT)
# anchor: grammar.md §5 field_pattern_list requires commas between fields and
#         has no rest production, but the seed struct-pattern loop only eats
#         an optional comma and explicitly skips `..`
#         (stage0_ocaml/src/parser.ml:3245-3262). The kernel mirrors both.
#         Pinned as accommodation: the canonical spelling uses commas and no
#         `..`; the lenient spelling is accepted until the sources migrate.
struct Triple
  a: Int
  b: Int
  c: Int
end

def struct_pattern_no_comma_rest(t: Triple) -> Int
  match t
  when Triple { a b, .. } then a + b
  when _ then 0
  end
end
