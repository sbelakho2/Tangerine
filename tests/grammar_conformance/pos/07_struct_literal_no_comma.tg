# case: struct_literal_no_comma
# decision: bootstrap-accommodation (ACCEPT)
# anchor: grammar.md §4.5 field_init_list requires a comma between fields
#         (`field_init { ',' field_init } [ ',' ]`). The seed struct-literal
#         loop only EATS an optional comma (stage0_ocaml/src/parser.ml:
#         2586-2600), so same-line `S { a: 1 b: 2 }` parses there; the
#         kernel mirrors the same optional-separator rule. Pinned so a
#         future "tighten to the canonical comma" change is a conscious
#         corpus decision, not an accidental divergence. (Closure sources
#         use newline-separated fields — see pos/08.)
struct Pair
  a: Int
  b: Int
end

def struct_literal_no_comma() -> Int
  let p = Pair { a: 1 b: 2 }
  p.a + p.b
end
