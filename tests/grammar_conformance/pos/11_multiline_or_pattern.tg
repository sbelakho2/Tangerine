# case: multiline_or_pattern
# decision: intentional language (ACCEPT)
# anchor: grammar.md §5 `pattern = single_pattern { '|' single_pattern }`
#         places no line restriction on the `|` separator, and the seed
#         lexer drops newlines entirely (stage0_ocaml/src/parser.ml
#         parse_pattern:3154-3166). The kernel mirrors it by skipping
#         newlines before/after `|` (parse_pattern in parser.tg).
def multiline_or_pattern(x: Int) -> Int
  match x
  when 1
    | 2
    | 3 then x
  when _ then 0
  end
end
