# case: soft_keyword_bindings
# decision: intentional language (ACCEPT)
# anchor: Tangerine keywords are contextual. grammar.md §1.3 documents
#         `super`/`crate` as contextual identifiers and §2.5 documents
#         `deinit` as an accepted method name; the seed lexer/parser keeps a
#         soft-identifier set (stage0_ocaml/src/parser.ml:137-212
#         soft_ident_kind) usable wherever the grammar expects IDENT. The
#         kernel mirrors it via soft_ident_name (parser.tg expect_ident /
#         parse_single_pattern).
#         Boundaries pinned here: a statement may not BEGIN with `end` (the
#         seed's at_kw_end_as_terminator ends the block first, then its item
#         loop discards the leftovers; the kernel diagnoses instead), and
#         the kernel's parse_block_body treats finally/catch/else/when/elsif
#         as block terminators, so those cannot start a statement either
#         (seed-only; recorded in README.md). Every soft-keyword use here
#         sits inside a statement that starts with a non-terminator token.
def soft_keyword_bindings() -> Int
  let end = 1
  let finally = 2
  let next = 3
  let total = finally + next + end
  total
end
