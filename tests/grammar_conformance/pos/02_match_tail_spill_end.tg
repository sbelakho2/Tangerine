# case: top_level_stray_end
# decision: bootstrap-accommodation (ACCEPT)
# anchor: docs/current/grammar.md has no top-level `end` production; the
#         formatter-era match-tail style writes `end  end` (match + def)
#         and the older style leaves a third `end` after the function
#         (std/bench.tg:451, 98 sites / 18 closure files). The seed's
#         parse_program silently advances past any top-level non-item token
#         (stage0_ocaml/src/parser.ml:269-274); the kernel deliberately
#         mirrors only the `end` case. Pinned while the sources still carry
#         the spill; every other unrecognized top-level token remains a
#         kernel diagnostic.
def match_tail_spill(x: Int) -> Int
  match x
  when 1 then 10
  when _ then 20
  end  end
end
