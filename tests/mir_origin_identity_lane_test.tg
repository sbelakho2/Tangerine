# tests/mir_origin_identity_lane_test.tg — fourth-audit P0-7 / P0-8 /
# P1-10 plus the audit-order item 1 closeout: the persistent MIR identity,
# the semantic re-key and the finalized-MIR origin invariant.
#
# The lanes live in the compiler sources:
#   mir_origin_identity_lane_check (mir.tg)           — P0-7 origins survive
#       an unrelated insertion across the O2 optimizer (locators may shift,
#       semantic origins do not); P0-8 PGO v3 round-trips the semantic keys
#       and v2 converts through the current build (failing closed without
#       one); P1-10 tail eligibility resolves the callee structurally — a
#       renamed emission name no longer hides the callee; the finalized-MIR
#       origin check fails closed on an origin-less node.
#   mir_origin_insertion_lane_check (mir.tg)          — P0-7 provenance
#       extension: a lowered CALL terminator B (FromHir-stamped) keeps its
#       stable id and typed provenance when an unrelated origin-less call
#       is inserted before it and the O2 optimizer runs.
#   coverage_semantic_rekey_lane_check (coverage_graph.tg) — P0-8 coverage
#       ids are the control-origin keys; the emission plan's block_keys map
#       (the ids the LIR route carries) carries the same semantic keys; an
#       inserted block leaves the original semantic ids unchanged; an
#       origin-less artifact is reported untracked.
#
# Run with the repo root as the working directory:
#   tg test tests/mir_origin_identity_lane_test.tg

use std::test::assert

use tg_compiler::mir::{
  mir_origin_identity_lane_check,
  mir_origin_insertion_lane_check,
  mir_origin_insertion_lane_optimized_function,
  mir_origin_insertion_lane_key,
  mir_origin_lane_program_artifact, mir_origin_lane_originless_function
}
use tg_compiler::coverage_graph::{
  coverage_semantic_rekey_lane_check, coverage_table_of_mir_function
}
use tg_compiler::semantic_snapshot::{semantic_snapshot_untracked_artifact}
use tg_compiler::semantic_slice::{mir_slice_provenance_lane_check}
use tg_compiler::lir::{
  lower_mir_fn_to_lir_mode, lir_alloc_registers_a64, verify_lir, LirVerifyRoute
}

@test
def test_mir_origin_identity_lane() -> Unit
  let rows = mir_origin_identity_lane_check()
  assert(rows.len() == 0, "MIR origin-identity lane mismatches: " + rows.join("; "))
end

# (P0-7 provenance extension) The semantic-slice derivation lane: the
# FromHir-stamped node keeps its StableSemanticNodeId across the unrelated
# insertion; the origin-derived variant is identical; origin-less input
# answers the untracked marker.
@test
def test_mir_slice_provenance_lane() -> Unit
  let rows = mir_slice_provenance_lane_check()
  assert(rows.len() == 0, "MIR slice-provenance lane mismatches: " + rows.join("; "))
end

# (P0-7 provenance extension) The lowered-insertion row's LIR leg: the
# optimized function — whose call terminator B survived an unrelated call
# insertion at the same lowering role — lowers to LIR cleanly and B's
# stable id is still the same MIR node key at the boundary.
@test
def test_mir_origin_insertion_lane() -> Unit
  let rows = mir_origin_insertion_lane_check()
  assert(rows.len() == 0, "MIR origin-insertion lane mismatches: " + rows.join("; "))
end

@test
def test_mir_origin_insertion_through_lir() -> Unit
  let f = mir_origin_insertion_lane_optimized_function()
  let key = mir_origin_insertion_lane_key(f.clone())
  assert(key.len() > 0, "the lowered call B carries no stable id at the LIR boundary")
  match lower_mir_fn_to_lir_mode(f.clone(), true, true)
  when Result::Err(e) then
    assert(false, "lowering the optimized MIR to LIR failed: " + e)
  when Result::Ok(lf) then
    let alloc = lir_alloc_registers_a64(lf.clone())
    let rows = verify_lir(lf.clone(), alloc, LirVerifyRoute::LirVerifyA64)
    assert(rows.len() == 0, "verify_lir rows after the insertion lane: " + rows.join("; "))
  end
  # The id read back off the SAME function value is unchanged by the LIR
  # lowering (the origin is carried on the MIR node, never re-derived from
  # a locator).
  assert(mir_origin_insertion_lane_key(f) == key,
    "the lowered call B's stable id changed through the LIR boundary")
end

@test
def test_coverage_semantic_rekey_lane() -> Unit
  let rows = coverage_semantic_rekey_lane_check()
  assert(rows.len() == 0, "coverage semantic re-key lane mismatches: " + rows.join("; "))
end

# (audit order item 1 closeout) Origin-less hand-built MIR fed to the
# persistent consumers returns the documented untracked artifact result —
# the snapshot builder's gate and the coverage table builder both reject
# it; neither falls back to "#B<ordinal>" locators.
@test
def test_persistent_apis_reject_originless_artifact() -> Unit
  let artifact = mir_origin_lane_program_artifact(Vec::from([mir_origin_lane_originless_function()]))
  match semantic_snapshot_untracked_artifact(artifact)
  when Option::Some(u) then
    assert(u.api == "semantic-snapshot",
      "snapshot untracked api: " + u.api)
  when Option::None then
    assert(false, "snapshot builder accepted origin-less hand-built MIR")
  end
  match coverage_table_of_mir_function("lane_originless".to_string(), mir_origin_lane_originless_function())
  when Result::Err(u2) then
    assert(u2.api == "coverage-table",
      "coverage untracked api: " + u2.api)
    assert(u2.detail.contains("persistent"),
      "coverage untracked detail: " + u2.detail)
  when Result::Ok(_) then
    assert(false, "coverage table accepted origin-less hand-built MIR")
  end
end
