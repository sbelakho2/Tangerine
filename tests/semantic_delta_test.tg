# tests/semantic_delta_test.tg — the affected-closure lane (audit item 41;
# fourth-audit P0-9 completeness model).
#
# The model lives in tg_compiler/semantic_delta.tg: affected_closure walks
# the snapshot's persisted typed dependency graph families marked available
# by the graph's dependency_completeness table and returns the typed
# AffectedResult { entities, completeness, missing_relations }. A family
# whose producer lacked the data source is REPORTED and never substituted
# by the caller closure. The lane rows are the executable form of that
# contract:
#   L1 — the Call closure (kept §31 semantics) + the unavailable empty
#        families (seed-only, family named, NO fallback) + the propagation
#        kinds.
#   L2 — real layout / TypeUse rows, the graph-less unavailable twin.
#   L3 — Implements complete / partial / unavailable.
#   L4 — ContractReferences complete / unavailable.
#   L5 — TestReferences.
#   L6 — AbiConsumer (pub-fn callers, pub-type surfaces, the non-pub gate).
#   L7-L9 — GenericInstantiation / ConstEvalDependent / DerivedImpl.
#   L10 — a populated-but-EMPTY complete layout family: zero dependents.
#   L11 — an unavailable layout family with call rows present: no caller
#        closure substitution.
#   L12 — mixed kinds: complete Call + unavailable layout = partial.
#
# Run with the repo root as the working directory:
#   tg test tests/semantic_delta_test.tg

use std::test::assert

use tg_compiler::semantic_delta::{
  affected_closure_lane_check, typed_table_delta_lane_check
}

@test
def test_affected_closure_lane() -> Unit
  let rows = affected_closure_lane_check()
  assert(rows.len() == 0, "affected closure lane mismatches: " + rows.join("; "))
end

# (fourth-audit P1-3) the TYPED member/signature delta rows: a
# delimiter-carrying field name whose type changes, a variant payload edit
# and the added variant/typoed method rows are reported by typed
# membership; identical typed tables emit nothing and the typed rows join
# the delta digest.
@test
def test_typed_table_delta_lane() -> Unit
  let rows = typed_table_delta_lane_check()
  assert(rows.len() == 0, "typed table delta lane mismatches: " + rows.join("; "))
end
