# tests/semantic_verified_edit_test.tg — audit order P0-15: the
# authoritative verified-edit transaction.
#
# Module lane: semantic_server.tg's semantic_verified_edit_lane_check
# (the authoritative §31 delta projection, the exact unexpected
# effect/allocation + ABI row rejection, the empty no-op delta agreement,
# the ProvisionalFrontEnd / VerifiedFrontend levels, the proof-gated
# refusal, the rationale records and the canonical render + proof hash).
#
# The full-pipeline test compiles a mini program with session_compile_source
# (the SAME pipeline the transaction runs), resolves a rename against the
# baseline session, applies it through session_apply_verified_edit and pins
# the VerifiedFull record: old/new revisions, delta agreement, budget,
# rationale records, the gated proof and the final proof hash. The mini
# source declares no imports, so the compile is self-contained; run it with
# the repo root as the working directory (the route resolves any declared
# imports relative to the repo).
#
# (audit: verified-edit test execution) The transaction lane here also
# pins the REAL test execution: a transaction whose edited program declares
# an affected @test compiles + runs it through the coverage harness and
# reports Verified with the executed rows (and the executed evidence rides
# the proof patch's affected-tests field); a transaction with no covering
# test reports Unavailable with the documented reason (never a pass); and
# the capturing optimizer's decisions appear in the rationale records.
# The synthesis lane (uncovered created path -> synthesized + executed ->
# covered) is pinned by semantic_server's session_test_execution_lane_check.
#
# Run with:
#   tg test tests/semantic_verified_edit_test.tg

use std::core::{Option, Result, Unit}
use std::collections::{Vec}
use std::test::*

use tg_compiler::change_budget::{ChangeBudget}
use tg_compiler::codegen::{detect_host_target}
use tg_compiler::compiler_core::{default_options}
use tg_compiler::ids::{stable_digest_of, stable_def_id_digest}
use tg_compiler::proof_patch::{
  VerificationLevel, verification_level_word, verification_status_word,
  verification_status_is_verified,
  proof_patch_of_level, verified_proof_patch, verified_compilation_evidence_stages,
  budget_verified_patch, compilation_verified_patch
}
use tg_compiler::semantic_delta::{DeltaStatus, semantic_delta_empty}
use tg_compiler::semantic_edit::{
  SemanticEdit, resolve_edit, edit_error_word, edit_budget_for_plan, edit_plan_regs
}
use tg_compiler::semantic_rationale::{RationaleKind}
use tg_compiler::semantic_server::{
  session_compile_source, session_apply_verified_edit, semantic_verified_edit_lane_check,
  session_test_execution_lane_check, verified_edit_transaction_rows
}

@test
def test_verified_edit_lane() -> Unit
  let bad = semantic_verified_edit_lane_check()
  assert(bad.len() == 0, "verified-edit lane mismatches: " + bad.join("; "))
end

@test
def test_provisional_frontend_cannot_emit_a_verified_proof() -> Unit
  let evidence = verified_compilation_evidence_stages(
    "p0-15-gate".to_string(),
    true, true, true, true, true, false, false, true, true, false, true,
    Vec::new())
  let provisional = proof_patch_of_level(VerificationLevel::ProvisionalFrontEnd,
    &ChangeBudget {}, DeltaStatus::Complete(semantic_delta_empty()), &evidence)
  assert(!verification_status_is_verified(provisional.budget_status),
    "a provisional-level patch must not carry a verified budget status")
  let full = proof_patch_of_level(VerificationLevel::VerifiedFull,
    &ChangeBudget {}, DeltaStatus::Complete(semantic_delta_empty()), &evidence)
  let gate_hash = stable_digest_of("p0-15-gate".to_string())
  # (P0 proof-gating) A VerifiedFull-LEVEL patch is not automatically a
  # verified proof: this patch's post-mono stage is Unavailable (the
  # captured set excludes it), its ABI stage is Failed, and its
  # equivalence status is Unavailable — so EVERY class constructor
  # refuses it.
  assert(verified_proof_patch(VerificationLevel::VerifiedFull, full.clone(),
    gate_hash.clone()).is_none(),
    "a patch with an Unavailable/Failed stage must not construct a verified proof")
  assert(budget_verified_patch(VerificationLevel::VerifiedFull, full.clone(),
    gate_hash.clone()).is_none(), "a partial patch must not construct a budget-verified claim")
  assert(compilation_verified_patch(VerificationLevel::VerifiedFull, full.clone(),
    gate_hash.clone()).is_none(), "a patch with a Failed compiler stage must not construct a compilation-verified claim")
  # The level gate refuses every weaker level.
  assert(verified_proof_patch(VerificationLevel::ProvisionalFrontEnd, full.clone(),
    gate_hash.clone()).is_none(), "the provisional level must be refused")
  assert(verified_proof_patch(VerificationLevel::VerifiedFrontend, full.clone(),
    gate_hash.clone()).is_none(), "the frontend level must be refused")
  # The full transaction lane's own conditional levels are pinned in
  # semantic_verified_edit_lane_check (V3 / V4).
end

@test
def test_verified_edit_full_transaction() -> Unit
  let src = "def f() -> Int\n  1\nend\n"
  let session = match session_compile_source(src.to_string(), "lane.tg".to_string(),
    detect_host_target())
  when Result::Ok(s) then s
  when Result::Err(e) then panic("baseline compile failed: " + e)
  end
  let k_f = "f#fn()->Int".to_string()
  let resolved = match resolve_edit(&session.index, &session.snapshot,
    SemanticEdit::Rename(k_f.clone(), "f2".to_string()))
  when Result::Ok(r) then r
  when Result::Err(e) then panic("verified-edit resolve failed: " + edit_error_word(e))
  end
  let budget = edit_budget_for_plan(edit_plan_regs(resolved.clone()))
  let tx = session_apply_verified_edit(session.clone(),
    SemanticEdit::Rename(k_f.clone(), "f2".to_string()), budget)
  assert(tx.accepted, "the rename must be accepted: " + tx.refusal.clone())
  assert(tx.level == VerificationLevel::VerifiedFull,
    "level: " + verification_level_word(tx.level.clone()))
  assert(tx.applied, "the source rewrite must have re-validated")
  assert(tx.old_revision.len() > 0 && tx.new_revision.len() > 0,
    "both revision renders must be present")
  assert(tx.old_revision != tx.new_revision,
    "a rename must change the finalized snapshot revision")
  assert(tx.delta_agreement,
    "delta agreement: unexpected=[" + tx.unexpected_rows.join(",") + "]")
  assert(tx.budget_result.len() == 0, "budget: " + tx.budget_result.join("; "))
  assert(tx.rationale_records.len() >= 3, "rationale records: " +
    tx.rationale_records.len().to_string())
  assert(tx.proof_hash.hi != 0 || tx.proof_hash.lo != 0, "proof hash must be non-zero")
  # (P0 proof-gating) A rename's §41 equivalence aggregate has no baseline
  # pairing for the old/new names, so the equivalence stage is not proven:
  # the FULL verified proof must NOT wrap. The truthful class is the
  # budget-verified claim (compiler stages + budget).
  assert(tx.verified_proof.is_none(),
    "a rename with unproven equivalence must not construct a verified proof")
  assert(tx.verified_class == "budget-verified",
    "the truthful class word: " + tx.verified_class.clone())
  # The REAL ABI verifier outcome mirrors onto the transaction status and
  # the carried patch (the mini program verifies clean).
  assert(verification_status_word(tx.abi_status) == "verified",
    "abi status must mirror the real verifier: " + verification_status_word(tx.abi_status))
  match tx.proof_patch.clone()
  when Option::Some(p) then
    assert(verification_status_word(p.abi_status) == verification_status_word(tx.abi_status),
      "the patch's abi status must mirror the transaction's")
    assert(budget_verified_patch(tx.level.clone(), p.clone(), tx.proof_hash.clone()).is_some(),
      "the compiler + budget claims must hold")
    assert(verified_proof_patch(tx.level.clone(), p, tx.proof_hash.clone()).is_none(),
      "the full proof must refuse the unproven equivalence stage")
  when Option::None then
    assert(false, "an accepted VerifiedFull transaction must carry its patch")
  end
  assert(tx.new_session.is_some(), "the revised session must be present")
  match tx.actual_delta_status.clone()
  when DeltaStatus::Complete(_) then ()
  when DeltaStatus::Unavailable(reason) then
    assert(false, "the authoritative delta must be Complete: " + reason)
  end
  # (P0 identity continuity) With the DeclMove continuation applied before
  # the snapshot build, the authoritative projection reports ONE
  # signature-changed row at the NEW registration key — not a remove/create
  # pair — and the plan grammar's exact-move matcher keeps the agreement.
  assert(tx.actual_rows.contains(&"entity-signature-changed:f2".to_string()),
    "the authoritative projection must name the renamed declaration as a signature change: " +
    tx.actual_rows.join(","))
  assert(!tx.actual_rows.contains(&"entity-created:f2".to_string()) &&
    !tx.actual_rows.contains(&"entity-removed:f".to_string()),
    "the identity-continued rename must not project as remove/create: " + tx.actual_rows.join(","))
  let rows = verified_edit_transaction_rows(&tx)
  assert(rows.contains(&"level:verified-full".to_string()),
    "the render must claim the full level")
  # (P0 identity continuity) The rename keeps the StableDeclId end-to-end:
  # the DeclMove continuation is applied before the snapshot build, so the
  # renamed declaration's persistent identity digest is byte-identical and
  # the revision store records the rename continuation.
  var old_digest = stable_digest_of("missing".to_string())
  for sym in session.snapshot.symbols do
    if sym.name == "f" then
      old_digest = stable_def_id_digest(&sym.stable_id)
    end
  end
  match tx.new_session.clone()
  when Option::Some(ns) then
    var renamed_kept_id = false
    var renamed_name_seen = false
    for sym in ns.snapshot.symbols do
      if sym.name == "f2" then
        renamed_name_seen = true
        let new_digest = stable_def_id_digest(&sym.stable_id)
        if new_digest.hi == old_digest.hi && new_digest.lo == old_digest.lo then
          renamed_kept_id = true
        end
      end
    end
    assert(renamed_name_seen, "the revised snapshot must carry the renamed declaration")
    assert(renamed_kept_id,
      "the rename must keep the StableDeclId digest (the DeclMove continuation applied before the snapshot build)")
    var rename_continuations = 0
    for c in ns.lineages.continuations do
      if c.reason == "rename" then
        rename_continuations = rename_continuations + 1
      end
    end
    assert(rename_continuations >= 1,
      "the rename's DeclMove continuation must be recorded in the revised store")
  when Option::None then
    assert(false, "the revised session must carry the new snapshot")
  end
  # (audit: verified-edit test execution) The mini source declares no test:
  # the affected set has no covering test, so the transaction reports the
  # honest Unavailable — never a fabricated pass — with the documented
  # reason and no executed rows.
  assert(tx.tests_executed.len() == 0,
    "no test can execute here: " + tx.tests_executed.join("; "))
  assert(verification_status_word(tx.tests_executed_status) == "unavailable",
    "a transaction with no covering test must report Unavailable: " +
      verification_status_word(tx.tests_executed_status))
  assert(tx.tests_executed_reason.starts_with("no affected test".to_string()),
    "the Unavailable reason must be documented: " + tx.tests_executed_reason)
end

# (audit: verified-edit test execution) A transaction whose edited program
# declares an affected @test EXECUTES it through the coverage harness: the
# affected test runs (Verified with the executed rows), its trace is
# ingested into the coverage consequences, and the executed evidence rides
# the proof patch's affected-tests field.
@test
def test_verified_edit_executes_affected_tests() -> Unit
  let src = "def f() -> Int\n  1\nend\n\n@test\ndef test_f() -> Unit\n  let _ = f()\nend\n"
  let session = match session_compile_source(src.to_string(), "lane_exec.tg".to_string(),
    detect_host_target())
  when Result::Ok(s) then s
  when Result::Err(e) then panic("baseline compile failed: " + e)
  end
  let k_f = "f#fn()->Int".to_string()
  let resolved = match resolve_edit(&session.index, &session.snapshot,
    SemanticEdit::Rename(k_f.clone(), "f2".to_string()))
  when Result::Ok(r) then r
  when Result::Err(e) then panic("verified-edit resolve failed: " + edit_error_word(e))
  end
  let budget = edit_budget_for_plan(edit_plan_regs(resolved.clone()))
  let tx = session_apply_verified_edit(session.clone(),
    SemanticEdit::Rename(k_f.clone(), "f2".to_string()), budget)
  assert(tx.accepted, "the rename must be accepted: " + tx.refusal.clone())
  assert(tx.affected_tests.len() > 0,
    "the delta-affected f2 must carry its covering test")
  assert(verification_status_word(tx.tests_executed_status) == "verified",
    "the affected @test must execute and report Verified: " +
      verification_status_word(tx.tests_executed_status) +
      " reason: " + tx.tests_executed_reason)
  assert(tx.tests_executed.len() > 0, "the executed rows must be present")
  var test_f_executed = false
  for row in tx.tests_executed do
    if row.contains("test_f".to_string()) && row.ends_with(":passed".to_string()) then
      test_f_executed = true
    end
  end
  assert(test_f_executed,
    "the affected test_f must really run and pass: " + tx.tests_executed.join("; "))
  assert(tx.coverage_consequences.len() > 0,
    "the ingested trace must feed the coverage consequences")
  match tx.proof_patch.clone()
  when Option::Some(p) then
    var patch_evidence = false
    for row in p.affected_tests do
      if row.starts_with("affected:test_f".to_string()) then
        patch_evidence = true
      end
    end
    assert(patch_evidence,
      "the proof patch's affected-tests field must carry the executed evidence: " +
        p.affected_tests.join("; "))
  when Option::None then
    assert(false, "an accepted VerifiedFull transaction must carry its patch")
  end
end

# (audit: verified-edit test execution) The capturing optimizer: the
# transaction's rationale records carry the OptimizationDecision journal of
# its OWN optimize run (the snapshot route's rationale wiring), so the
# optimizer's accept/reject causality is recorded, not just the final IR.
# The @noinline callee guarantees a deterministic "inline-rejected" row at
# opt level 2 (the declared hard exclusion).
@test
def test_verified_edit_optimizer_decisions_in_rationale() -> Unit
  let src = "@noinline\ndef g() -> Int\n  1\nend\n\ndef f() -> Int\n  g()\nend\n"
  var opts = default_options()
  opts.opt_level = 2
  let session = match session_compile_source(src.to_string(), "lane_opt.tg".to_string(),
    detect_host_target(), opts)
  when Result::Ok(s) then s
  when Result::Err(e) then panic("baseline compile failed: " + e)
  end
  let k_f = "f#fn()->Int".to_string()
  let resolved = match resolve_edit(&session.index, &session.snapshot,
    SemanticEdit::Rename(k_f.clone(), "f2".to_string()))
  when Result::Ok(r) then r
  when Result::Err(e) then panic("verified-edit resolve failed: " + edit_error_word(e))
  end
  let budget = edit_budget_for_plan(edit_plan_regs(resolved.clone()))
  let tx = session_apply_verified_edit(session.clone(),
    SemanticEdit::Rename(k_f.clone(), "f2".to_string()), budget)
  assert(tx.accepted, "the rename must be accepted: " + tx.refusal.clone())
  var optimization_records = 0
  var decision_row = "".to_string()
  for rec in tx.rationale_records do
    if rec.kind == RationaleKind::Optimization then
      optimization_records = optimization_records + 1
      decision_row = rec.decision.clone()
    end
  end
  assert(optimization_records > 0,
    "the capturing optimizer's decisions must be recorded in the rationale")
  assert(decision_row.len() > 0, "an optimization rationale row must name its decision")
end

# (audit: verified-edit test execution) The lane check pins the pure pieces
# (dispatch harness shape, unsupported-target Unavailable) and, on the host
# route, the full synthesis loop: an uncovered created call edge is
# synthesized by the producer driver_synthesize_uncovered_tests wraps,
# compiled + executed through the same coverage harness, and the ingested
# trace re-evaluates the edge to covered.
@test
def test_verified_edit_test_execution_lane() -> Unit
  let bad = session_test_execution_lane_check()
  assert(bad.len() == 0, "test execution lane mismatches: " + bad.join("; "))
end
