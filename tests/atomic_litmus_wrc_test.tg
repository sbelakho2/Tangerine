# tests/atomic_litmus_wrc_test.tg — Write-Read-Coherence (WRC) litmus.
#
# The classic write-read-coherence / SeqCst total-order pattern, run
# over ITERATIONS independent slots, ALL operations SeqCst:
#   Thread 1: x[i] = 1
#   Thread 2: r1[i] = x[i];  if r1[i] == 1 then y[i] = 1
#   Thread 3: r2[i] = y[i];  r3[i] = x[i]
# The forbidden outcome is r1[i] == 1 && r2[i] == 1 && r3[i] == 0:
# r1 reading 1 places the x-write before thread 2's read in the
# single total order, thread 2's y-write follows, r2 reading 1 places
# it before thread 3's y-read, and coherence then forces thread 3's
# x-read to observe the x-write (a read cannot read a value older than
# one already ordered before it in the total order). SeqCst stores that
# are plain MOVs on x86-64 permit r3 == 0 (the thread 3 loads can both
# be served from the store buffers ahead of the stores); the xchg-based
# SeqCst store forbids it.

use std::core
use std::atomic::{AtomicInt, Ordering}
use std::thread::{spawn}

extern def _tg_mem_alloc(size: UInt) -> Ptr[u8]
extern def _tg_mem_free(ptr: Ptr[u8], size: UInt) -> Unit

const ITERATIONS: Int = 20000

struct Slot
  v: AtomicInt
end

def wrc_t1(x: Ptr[Slot]) -> Int
  var i = 0
  while i < ITERATIONS do
    let xp = x.offset(i)
    xp.as_ref().v.store(1, Ordering::SeqCst)
    i = i + 1
  end
  0
end

def wrc_t2(x: Ptr[Slot], y: Ptr[Slot], r1: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    let xp = x.offset(i)
    let v = xp.as_ref().v.load(Ordering::SeqCst)
    let rp = r1.offset(i)
    rp.write(v)
    if v == 1 then
      let yp = y.offset(i)
      yp.as_ref().v.store(1, Ordering::SeqCst)
    end
    i = i + 1
  end
  0
end

def wrc_t3(x: Ptr[Slot], y: Ptr[Slot], r2: Ptr[Int], r3: Ptr[Int]) -> Int
  var i = 0
  while i < ITERATIONS do
    let yp = y.offset(i)
    let a = yp.as_ref().v.load(Ordering::SeqCst)
    let r2p = r2.offset(i)
    r2p.write(a)
    let xp = x.offset(i)
    let b = xp.as_ref().v.load(Ordering::SeqCst)
    let r3p = r3.offset(i)
    r3p.write(b)
    i = i + 1
  end
  0
end

# The @test attribute registers this executable under the strict `tg test`
# runner (canary convention: the file is compiled as-is and run once; the
# process exit code is the test outcome — see tg_compiler/driver.tg
# compile_and_run_file_main).
@test
def main() -> Int
  let bytes = (ITERATIONS * 8) as UInt
  let xb = _tg_mem_alloc(bytes)
  let yb = _tg_mem_alloc(bytes)
  let r1b = _tg_mem_alloc(bytes)
  let r2b = _tg_mem_alloc(bytes)
  let r3b = _tg_mem_alloc(bytes)
  if xb.is_null() || yb.is_null() || r1b.is_null() || r2b.is_null() || r3b.is_null() then
    println("atomic_litmus_wrc: allocation failed")
    return 1
  end
  let x = xb.cast[Slot]()
  let y = yb.cast[Slot]()
  let r1 = r1b.cast[Int]()
  let r2 = r2b.cast[Int]()
  let r3 = r3b.cast[Int]()

  var i = 0
  while i < ITERATIONS do
    x.offset(i).write(Slot { v: AtomicInt::new(0) })
    y.offset(i).write(Slot { v: AtomicInt::new(0) })
    i = i + 1
  end

  let x1 = x
  let x2 = x
  let y2 = y
  let r1p = r1
  let x3 = x
  let y3 = y
  let r2p = r2
  let r3p = r3
  let h0 = spawn(move || wrc_t1(x1))
  let h1 = spawn(move || wrc_t2(x2, y2, r1p))
  let h2 = spawn(move || wrc_t3(x3, y3, r2p, r3p))

  match h0.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_wrc: worker 0 failed with code " + code.to_string())
      return 10
    end
  when Result::Err(e) then
    println("atomic_litmus_wrc: join 0 failed: " + e)
    return 11
  end

  match h1.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_wrc: worker 1 failed with code " + code.to_string())
      return 12
    end
  when Result::Err(e) then
    println("atomic_litmus_wrc: join 1 failed: " + e)
    return 13
  end

  match h2.join()
  when Result::Ok(code) then
    if code != 0 then
      println("atomic_litmus_wrc: worker 2 failed with code " + code.to_string())
      return 14
    end
  when Result::Err(e) then
    println("atomic_litmus_wrc: join 2 failed: " + e)
    return 15
  end

  # The forbidden WRC outcome: both the x-read in thread 2 and the
  # y-read in thread 3 observed the writes, yet thread 3's x-read went
  # stale (a total-order / coherence violation).
  var forbidden = 0
  var chain_fired = 0
  i = 0
  while i < ITERATIONS do
    let a = r1.offset(i).read()
    let b = r2.offset(i).read()
    let c = r3.offset(i).read()
    if a == 1 then
      chain_fired = chain_fired + 1
    end
    if a == 1 && b == 1 && c == 0 then
      forbidden = forbidden + 1
    end
    i = i + 1
  end

  _tg_mem_free(xb, bytes)
  _tg_mem_free(yb, bytes)
  _tg_mem_free(r1b, bytes)
  _tg_mem_free(r2b, bytes)
  _tg_mem_free(r3b, bytes)

  if forbidden != 0 then
    println("atomic_litmus_wrc: forbidden r1==1 && r2==1 && r3==0 observed " + forbidden.to_string() + " times of " + ITERATIONS.to_string())
    return 2
  end
  # The vacuous-pass guard (the statistical bound): if thread 2 never
  # observed thread 1's x-store, the y-write and thread 3's reads never
  # exercised the total order — the litmus must fail, not pass emptily.
  if chain_fired == 0 then
    println("atomic_litmus_wrc: vacuous run — thread 2 observed no x-store over " + ITERATIONS.to_string() + " slots (the chain never fired)")
    return 3
  end
  0
end
